<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 1.1.0.0: writes out\judge-cases.json (+ copy to JudgeCasesPath) for the Judge; replay switch; logic 1.2.0.
         1.0.2.0: SiteIds setting filters the read (empty = every site).
         1.0.1.0: label by Status (1 with FRS id / 2), maintenance window, discard reason, site lat/long from DB.
         1.0.0.0: read-only nightly job. Decided alerts (approved -> PASS, discarded -> SUPPRESSED)
         to one CSV row each, for the Alert Judge to learn from. Not referenced by any web project. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>E7.AlertCaseExtractor</RootNamespace>
    <AssemblyName>E7.AlertCaseExtractor</AssemblyName>
    <Version>1.1.0.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Company>Energy7 Infotech Pvt. Ltd.</Company>
    <Product>E7.AlertCaseExtractor -- decided-alert case extractor for the Alert Judge</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same Newtonsoft.Json version the web project and E7.AiCore use. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The case features and the matching are ONE source file shared with the Judge, never a copy. -->
    <Compile Include="..\..\E7.AiCore\Judge\JudgeCaseBase.cs" Link="Shared\JudgeCaseBase.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="extractor-settings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
