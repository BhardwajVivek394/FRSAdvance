@model  Domain.Stock

<div class="modal bounceIn animated" id="modal-add-dispatch" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-lg">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title">Add Dispatch</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">
                    <div class="col-xl-12">
                        <input type="hidden" id="hdnDispatchStockId" value="@ViewBag.StockId" />
                        <div class="row">
                            <div class="col-xl-6">
                                <label class="control-label">Oprator Name <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(x => x.OpratorName, new { @Class = "form-control" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-xl-6">
                                <label class="control-label">Oprator Phone Number <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(x => x.OpratorPhoneNumber, new { @Class = "form-control" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-xl-6">
                                <label class="control-label">Dispatch Type <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.DropDownListFor(x => x.DispatchType, (IEnumerable<SelectListItem>)ViewBag.DispatchTypeEnumList, new { @Class = "form-control" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-xl-6">
                                <label class="control-label"><span id="lblDispatchTypeText">Train Number</span> <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(x => x.DispatchTypeText, new { @Class = "form-control" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-xl-6">
                                <label class="control-label">Attendent Name <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(x => x.AttendentName, new { @Class = "form-control" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <div class="table-responsive">
                                @if (ViewBag.StockWorksheetMaterials != null)
                                {
                                    var stockMaterials = ViewBag.StockWorksheetMaterials as List<Domain.StockWorksheetMaterial>;
                                    if (stockMaterials != null && stockMaterials.Count > 0)
                                    {
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th>Material Name</th>
                                                    <th class="text-center">Dispatch Quantity</th>
                                                    <th>Location From</th>
                                                    <th>Location To</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbodyDispatch">

                                                @foreach (var stockMaterial in stockMaterials)
                                                {
                                                    if (stockMaterial.DispatchQuantity != null && stockMaterial.DispatchQuantity.Value > 0)
                                                    {
                                                        <tr data-materialid="@stockMaterial.MaterialId" data-stockid="@stockMaterial.StockId">
                                                            <td>@stockMaterial.MaterialName</td>
                                                            <td class="text-center">@stockMaterial.DispatchQuantity</td>
                                                            <td>
                                                                <input type="text" class="form-control" />
                                                                <span class="text-danger"></span>
                                                            </td>
                                                            <td>
                                                                <input type="text" class="form-control" />
                                                                <span class="text-danger"></span>
                                                            </td>
                                                        </tr>
                                                    }

                                                }
                                            </tbody>


                                        </table>

                                    }
                                }

                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="fnSaveDispatch()">Update</button>
                <button class="btn btn-default" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {

        $('#DispatchType').change(function () {

            if ($(this).val() == 1) {
                $('#lblDispatchTypeText').text('Train Number');
            } else if ($(this).val() == 2) {
                $('#lblDispatchTypeText').text('Bus Number');
            } else {
                $('#lblDispatchTypeText').text('Other Number');
            }
          


        });

    });
</script>

