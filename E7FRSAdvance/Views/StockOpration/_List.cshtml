@model Domain.StockLister

<div class="row">
    <div class="col-12">
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th class="text-center">Action</th>
                        <th class="text-center">SR No.</th>
                        <th>Token Number</th>
                        <th>Request By</th>
                        <th>Request Date</th>
                        <th>Dispatch Status</th>
                        <th>Dispatch Date</th>
                        <th class="text-center">Item List</th>
                        <th>Conjunction Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.mStocks != null && Model.mStocks.Count > 0)
                    {
                        int counter = 0;
                        foreach (var item in Model.mStocks)
                        {
                            counter++;
                            <tr>
                                <td class="text-center">
                                    @if (!item.IsDispatch)
                                    {
                                        <a href="@Url.Action("EditStock", new {id = item.Id})"><i class="fa fa-pencil"></i></a>
                                    }
                                </td>
                                <td class="text-center">@counter</td>
                                <td>@item.TokenNumber</td>
                                <td>@item.CreatedName</td>
                                <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>
                                    @if (item.IsDispatch)
                                    {
                                        <b class="text-success">Done</b>
                                    }
                                    else
                                    {
                                        <b class="text-danger">Pending</b>
                                    }
                                </td>
                                <td>
                                    @if (item.IsDispatch)
                                    {
                                        <a href="javascript:void(0)" onclick="fnShowDispatchDetail('@item.Id')">                                         
                                            @if (item.DispatchedDate != null && item.DispatchedDate != DateTime.MinValue)
                                            {
                                                <span>@item.DispatchedDate.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                            }
                                        </a>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="javascript:void(0)" onclick="fnShowMaterial('@item.Id')">@item.MaterialCount</a>
                                </td>
                                <td></td>

                            </tr>
                        }
                    }


                </tbody>
            </table>
        </div>
    </div>

</div>


