@model Domain.StockLister

<div class="row">
    <div class="col-12">
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th class="text-center">SR No.</th>
                        <th>Token Number</th>
                        <th>Request By</th>
                        <th>Request Date</th>
                        <th class="text-center">Item List</th>
                        <th>Audit</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.mStocks != null && Model.mStocks.Count > 0)
                    {
                        int counter = 0;
                        foreach (var item in Model.mStocks)
                        {
                            counter++;
                            <tr>
                                <td class="text-center">@counter</td>
                                <td>@item.TokenNumber</td>
                                <td>@item.CreatedName</td>
                                <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="text-center">
                                    <a href="javascript:void(0)" onclick="fnShowMaterial('@item.Id')">@item.MaterialCount</a>
                                </td>
                                <td>
                                    @if (item.MaterialCount == item.AuditedCount)
                                    {
                                        <b class="text-success">Done</b>
                                    }
                                    else
                                    {
                                        <b class="text-danger">Pending</b>
                                    }
                                </td>

                            </tr>
                        }
                    }


                </tbody>
            </table>
        </div>
    </div>

</div>


