@model Domain.StockLister
@{
    ViewBag.Title = "Stock Opration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Stock Opration</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <a class="btn btn-info" href="@Url.Action("AddStock","StockOpration")" target="_blank">Create</a>
        <a class="btn btn-info" href="@Url.Action("Audit","StockOpration")" target="_blank">Audit</a>
        <a class="btn btn-info" href="@Url.Action("Dispatch","StockOpration")" target="_blank">Dispatch</a>
    </div>
    <div class="card-body">
        @using (Ajax.BeginForm("_List", "StockOpration", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divStockOprationList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmStockOprationList" }))
        {
            <div id="divStockOprationList">
                @Html.Action("_List", Model)
            </div>
        }
    </div>
</div>
<div id="divMaterial"></div>
<div id="divDispatchDetail"></div>
<script>
    function fnShowMaterial(id) {
        $("#loader").show();
        $.ajax({
            url: '/StockOpration/_MaterialList',
            type: 'Post',
            data: '{id:' + id + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divMaterial").empty().append(data);
                $("#modal-material").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnShowDispatchDetail(id) {
        $("#loader").show();
        $.ajax({
            url: '/StockOpration/_DispatchDetail',
            type: 'Post',
            data: '{id:' + id + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divDispatchDetail").empty().append(data);
                $("#modal-dispatch-detail").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }
</script>