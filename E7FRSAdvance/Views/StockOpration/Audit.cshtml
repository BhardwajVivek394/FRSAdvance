@model Domain.StockLister
@{
    ViewBag.Title = "Audit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Audit</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header">
        <h6 class="pull-left">Audit</h6>
        @*<a class="btn btn-primary pull-right" href="@Url.Action("Index")">Back</a>*@
    </div>
    <div class="card-body">
        @using (Ajax.BeginForm("_AuditList", "StockOpration", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divAuditList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmAuditList" }))
        {
            <div id="divAuditList">
                @Html.Action("_AuditList", Model)
            </div>
        }
    </div>
</div>
<div id="divMaterial"></div>
<script>
    function fnShowMaterial(id) {
        $("#loader").show();
        $.ajax({
            url: '/StockOpration/_AuditMaterialList',
            type: 'Post',
            data: '{id:' + id + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divMaterial").empty().append(data);
                $("#modal-audit-material").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }
</script>