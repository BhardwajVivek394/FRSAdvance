@model Domain.Stock

<div class="modal bounceIn animated" id="modal-dispatch-detail" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-lg">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title">Dispatch Detail</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">
                    <div class="col-xl-12">
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <tr>
                                    <td width="200">
                                        <span>Oprator Name</span>
                                    </td>
                                    <td>
                                        <h5> @Model.OpratorName</h5>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span>Oprator Phone Number</span>
                                    </td>
                                    <td>
                                        <h5> @Model.OpratorPhoneNumber</h5>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span>Dispatch Type</span>
                                    </td>
                                    <td>
                                        <h5>@Enum.GetName(typeof(E7FRSAdvance.Utility.Utility.DispatchType), Model.DispatchType)</h5>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span>Dispatch Type Text</span>
                                    </td>
                                    <td>
                                        <h5> @Model.DispatchTypeText</h5>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span>Attendent Name</span>
                                    </td>
                                    <td>
                                        <h5> @Model.AttendentName</h5>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span>Audited By</span>
                                    </td>
                                    <td>
                                        <h5> @Model.AuditedName</h5>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span>Audited Date</span>
                                    </td>
                                    <td>
                                        <h5>
                                            @if (Model.AuditedDate != null && Model.AuditedDate != DateTime.MinValue)
                                            {
                                                <span>@Model.AuditedDate.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                            }
                                        </h5>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span>Dispatch By</span>
                                    </td>
                                    <td>
                                        <h5> @Model.DispatchedName</h5>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <span>Dispatch Date</span>
                                    </td>
                                    <td>
                                        <h5>
                                            @if (Model.DispatchedDate != null && Model.DispatchedDate != DateTime.MinValue)
                                            {
                                                <span>@Model.DispatchedDate.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                            }
                                        </h5>
                                    </td>
                                </tr>
                            </table>

                        </div>

                        <div class="table-responsive mt-3">

                            @if (Model.StockWorksheetMaterials != null && Model.StockWorksheetMaterials.Count > 0)
                            {

                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>Material Name</th>
                                            <th class="text-center">Dispatch Quantity</th>
                                            <th>Location From</th>
                                            <th>Location To</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var stockMaterial in Model.StockWorksheetMaterials)
                                        {
                                            if (stockMaterial.DispatchQuantity != null && stockMaterial.DispatchQuantity.Value > 0)
                                            {
                                                <tr>
                                                    <td>@stockMaterial.MaterialName</td>
                                                    <td class="text-center">@stockMaterial.DispatchQuantity</td>
                                                    <td>
                                                        @stockMaterial.DispatchLocationFrom
                                                    </td>
                                                    <td>
                                                        @stockMaterial.DispatchLocationTo
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>


                            }


                        </div>

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


