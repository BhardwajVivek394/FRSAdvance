@model  List<Domain.StockWorksheetMaterial>

<div class="modal bounceIn animated" id="modal-dispatch-material" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-lg">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title">Material</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">
                    <div class="col-sm-12">
                        <input type="hidden" id="hdnStockId" value="@ViewBag.StockId" />
                        <div class="table-responsive">
                            <table class="table" id="tblStockWorksheetMaterial">
                                <thead>
                                    <tr>
                                        <th class="text-center">SR No.</th>
                                        <th>Name</th>
                                        <th class="text-center">Demand Quantity</th>
                                        <th class="text-center">Audit</th>
                                        <th class="text-center">Dispatch Quantity</th>
                                        <th class="text-center">Dispatch Remark</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model != null && Model.Count > 0)
                                    {
                                        int counter = 0;
                                        foreach (var item in Model)
                                        {
                                            counter++;
                                            <tr class="materialmaintrview" data-id="@item.Id" data-matrialid="@item.MaterialId">
                                                <td class="text-center">@counter</td>
                                                <td>@item.MaterialName</td>
                                                <td class="text-center">
                                                    @item.Quantity
                                                </td>
                                                <td class="text-center">
                                                    @if (item.AuditedBy != null && item.AuditedBy.Value > 0)
                                                    {
                                                        <i class="fa fa-check text-success f-24" aria-hidden="true"></i>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (item.DispatchQuantity > 0)
                                                    {
                                                        <input type="number" class="form-control" value="@item.DispatchQuantity" />

                                                    }
                                                    else
                                                    {
                                                        <input type="number" class="form-control" />
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (!string.IsNullOrEmpty(item.DispatchRemark))
                                                    {

<textarea class="form-control">@item.DispatchRemark</textarea>
                                                    }
                                                    else
                                                    {
                                                        <textarea class="form-control"></textarea>
                                                    }
                                                </td>
                                            </tr>

                                        }
                                    }


                                </tbody>


                            </table>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" onclick="fnUpdateDispatchMaterial()">Update</button>
                <button class="btn btn-default" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>


</script>
