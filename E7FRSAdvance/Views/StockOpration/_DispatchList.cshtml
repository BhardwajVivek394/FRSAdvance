@model Domain.StockLister

<div class="row">
    <div class="col-12">
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th class="text-center">SR No.</th>
                        <th>Token Number</th>
                        <th>Request By</th>
                        <th>Request Date</th>
                        <th class="text-center">Item List</th>
                        <th class="text-center">Dispatch</th>
                        <th class="text-center">Remaining</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.mStocks != null && Model.mStocks.Count > 0)
                    {
                        int counter = 0;
                        foreach (var item in Model.mStocks)
                        {
                            counter++;
                            <tr>
                                <td class="text-center">@counter</td>
                                <td>@item.TokenNumber</td>
                                <td>@item.CreatedName</td>
                                <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td class="text-center">
                                    @if (!item.IsDispatch)
                                    {
                                        <a href="javascript:void(0)" onclick="fnShowMaterial('@item.Id')">@item.MaterialCount</a>
                                    }
                                    else
                                    {
                                        <a href="javascript:void(0)">@item.MaterialCount</a>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (!item.IsDispatch)
                                    {
                                        if (item.DispatchedBy != null && item.DispatchedDate != null)
                                        {
                                            <button type="button" class="btn btn-info" onclick="fnShowAddDispatch('@item.Id')">Add Dispatch</button>
                                        }
                                        else
                                        {
                                            <b class="text-danger">Pending</b>
                                        }
                                    }
                                    else
                                    {
                                        <b class="text-success">Done</b>
                                    }

                                </td>
                                <td class="text-center">
                                    @if (!item.IsDispatch && item.AuditedDate != null && item.AuditedDate.Value != DateTime.MinValue)
                                    {

                                        TimeSpan span = item.AuditedDate.Value.AddHours(48).Subtract(DateTime.Now);
                                        if (Convert.ToInt32(span.Hours) > 15)
                                        {
                                            <h6 class="text-success">@Convert.ToInt32(span.Hours) h @Convert.ToInt32(span.Minutes) m</h6>
                                        }
                                        else if (Convert.ToInt32(span.Hours) > 0 && Convert.ToInt32(span.Hours) < 15)
                                        {
                                            <h6 class="text-warning">@Convert.ToInt32(span.Hours) h @Convert.ToInt32(span.Minutes) m</h6>
                                        }
                                        else
                                        {
                                            <h6 class="text-danger">0 h</h6>
                                        }

                                    }

                                </td>

                            </tr>
                        }
                    }


                </tbody>
            </table>
        </div>
    </div>

</div>



