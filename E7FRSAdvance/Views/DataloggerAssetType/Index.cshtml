<div class="">
    <div class="">

        @using (Ajax.BeginForm("List", "DataloggerAssetType", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divDataloggerAssetTypeList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmGetDataloggerAssetTypeList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divDataloggerAssetTypeList">
                @Html.Action("List")
            </div>
        }


        @using (Ajax.BeginForm("Save", "DataloggerAssetType", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveDataloggerAssetType",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmSaveDataloggerAssetType" }))
        {
            <div id="divSaveDataloggerAssetType">
                @Html.Partial("_Add", new Domain.DataloggerAssetType())
            </div>
        }

        @using (Ajax.BeginForm("SaveAttributes", "DataloggerAssetType", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveAttribute",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",

        }, new { id = "frmSaveAttribute" }))
        {
            <div id="divSaveAttribute">
                @Html.Partial("_AddAttributesPartial", new Domain.DataloggerAttribute())
            </div>
        }

    </div>
</div>


<script>

    function GetAssestAttributes(id, $this) {
        if ($($this).hasClass("fa-plus")) {
            $($this).removeClass("fa-plus").addClass("fa-minus");
           
            $("#loader").show();
            $.ajax({
                url: '/DataloggerAssetType/GetAttributesByAssestId',
                type: 'Post',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                dataType: "html",
                success: function (response) {
                    $("#loader").hide();
                    $("#trAssestAttribute_" + id).after(response);
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        } else {
            $($this).removeClass("fa-minus").addClass("fa-plus");
            $("#trDataloggerAttributeRemove" + id).hide();
        }
    }

    function fnSaveAttributes() {
        if (ValidationAttributes()) {
            $('#frmSaveAttribute').submit();
        }
    }

    function ValidationAttributes() {
        var result = true;

        if ($.trim($("#Title").val()).length == 0) {
            $("#Title").next("span").html("Title is required");
            result = false;
        }
        else {
            $("#Title").next("span").html("");
        }

        return result;
    }

