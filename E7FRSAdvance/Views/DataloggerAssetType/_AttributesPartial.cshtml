@model List<Domain.DataloggerAttribute>

<tr id="trDataloggerAttributeRemove@{@ViewBag.AssetTypeId}">
    <td colspan="8">
        <div class="row p-l-10 p-r-10">
            <div class="col-lg-9">
            </div>
            <div class="col-lg-3">
                <a href="javascript:void(0)" class="btn btn-primary btn-quirk" onclick="AddAttribute('@ViewBag.AssetTypeId')">Add Attribute</a>
            </div>
            <div class="col-lg-12 mt10">
                @if (Model != null && Model.Count > 0)
                {
                    <div>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th colspan="2">Action</th>
                                    <th>Title</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center width60"><a href="javascript:void(0)" data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Edit"><i class="fa fa-edit text-info" onclick="EditAttribute('@item.Id'); return false;"></i></a></td>
                                        <td class="text-center width60"><a href="javascript:void(0)" data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Delete"><i class="fa fa-trash text-danger" onclick="DeleteAttributesById('@item.Id'); return false;"></i></a></td>
                                        <td>@item.Title</td>
                                    </tr>
                                }
                            </tbody>


                        </table>
                    </div>
                }
            </div>
        </div>


    </td>

</tr>

<script>
    function AddAttribute(id) {
          $("#loader").show();
          $.ajax({
              url: '/DataloggerAssetType/AddAttributes',
              type: 'Post',
              data: '{id: ' + id + '}',
              dataType: 'html',
              contentType: 'application/json',
              success: function (data) {
                  $("#loader").hide();
                  $("#divSaveAttribute").empty().append(data);
                  $("#modal-add-attribute").modal('show');
              },
              error: function (response) {
                  $("#loader").hide();
                  CommonNotification("ERROR", "Something went wrong!", "Error");
              }
          });
    }

    function EditAttribute(id) {
        $("#loader").show();
        $.ajax({
            url: '/DataloggerAssetType/EditAttributes',
            type: 'Post',
            data: '{id: ' + id + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divSaveAttribute").empty().append(data);
                $("#modal-add-attribute").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }
</script>