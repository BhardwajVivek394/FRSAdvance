        let currentScale = 1;
        const hammer = new Hammer.Manager(appModel.paper.el);
        hammer.add(new Hammer.Pinch({ enable: true }));

        let initialScale = 1;

        hammer.on('pinchstart', function () {
            initialScale = currentScale;

            wrapper.style.touchAction = 'none';
        });

        hammer.on('pinchmove', function (ev) {
            currentScale = Math.min(3, Math.max(0.1, initialScale * ev.scale));
            appModel.paper.scale(currentScale, currentScale);
        });

