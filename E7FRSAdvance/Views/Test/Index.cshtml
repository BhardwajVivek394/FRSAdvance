        function MQTTConnect() {
            let isSecure = window.location.protocol === "https:";
            client = new Paho.Client(mQTT.MQTTUri, mQTT.MQTTPort, "clientId" + Math.ceil(Math.random() * 10000));
            // set callback handlers

            client.onConnectionLost = onConnectionLost;
            client.onMessageArrived = onMessageArrived;

            // connect the client
            client.connect({
                onSuccess: onConnect,
                useSSL: isSecure,
                userName: mQTT.MQTTUsername,
                password: mQTT.MQTTPassword,
                cleanSession: true
            });
        }

        function onConnect() {
            // Once a connection has been made, make a subscription and send a message.
            if (site != null) {
                client.subscribe(site.MQTTBasePath + 'channel1');

                client.subscribe(site.MQTTBasePath + 'dl/#');
            }
            //for (var i = 0; i < channels.length; i++) {
            //    if (channels[i] != null && channels[i] != "null" && channels[i] != "") {

            //    }
            //}
        }

        function onMessageArrived(message) {
            var parseJson = JSON.parse(message.payloadString);

            if (parseJson != null && parseJson != undefined && parseJson != '') {

                if (message.destinationName.includes("/dl/")) {

                    var parseJson = JSON.parse(message.payloadString);
                    if (parseJson != null && parseJson != undefined && parseJson != '') {
                        var jsonData = parseJson['bits'];
                        if (jsonData != null && jsonData != undefined && jsonData.length > 0) {
                            var jsonArrayString = '';
                            for (var i = 0; i < jsonData.length; i++) {
                                var decimalNumber = decimalToBinary(jsonData[i]);
                                if (decimalNumber != null) {
                                    if (decimalNumber.length != 8) {
                                        decimalNumber = ("00000000" + decimalNumber.toString(2)).substr(-8);
                                    }
                                    const reversedString = decimalNumber.split("").reduce((acc, char) => char + acc, "");

                                    jsonArrayString += reversedString;
                                }
                            }
                            var jsonArray = jsonArrayString.split('');
                            if (jsonArray != null && jsonArray != undefined && jsonArray.length > 0) {
                                try {
                                    if (isDatalogger == true) {

                                        try {
                                           BindCircuitDataLoggerSimulation(message.destinationName, jsonArray);

                                        }
                                        catch (err) {

                                        }
                                    }
                                }
                                catch (err) {

                                }
                            }
                        }
                    }
                } else {

                    var array = parseJson['roles'];
                    var tsarray = parseJson['ts'];
                    if (array != null && array != undefined && array.length > 0) {
                        try {
                            if (circuitassetTypeId == 1) {
                                BindCircuitTrackSimulation(message.destinationName, array);
                            }
                            else if (circuitassetTypeId == 2) {
                                BindCircuitSignalSimulation(message.destinationName, array)
                            }
                        }
                        catch (err) {

                        }
                    }
                }

            }
        }

        function onConnectionLost(responseObject) {
            if (responseObject.errorCode !== 0) {
                console.log("onConnectionLost:" + responseObject.errorMessage);
                //location.reload();
            }
        }


    function BindCircuitTrackSimulation(basePath, data) {

        setTimeout(function () {

            if ($("#circuitDiagramLiveGif").attr("src") != '/assets/images/liveGif.gif') {
                $("#circuitDiagramLiveGif").attr("src", "/assets/images/Live_green.gif");

            }
            var d = new Date();
            var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
            $("#circuitDiagramLiveTimeStamp").html('Last Update: ' + time);

            if (parseJson != null && parseJson != undefined && parseJson != '') {
                $.each(assets, function (id, item) {
                    if (item.Id == parseInt(assetJson.Id)) {
                        if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                            $.each(item.assetAttributes, function (idx, inItem) {
                                var str1 = basePath.toLowerCase();
                                var str2 = "";
                                if (inItem.AssetInfoChannel != null && inItem.AssetInfoChannel != "") {
                                    str2 = inItem.AssetInfoChannel;
                                }
                                if (str2 != null && str2 != "" && str1.indexOf(str2) != -1) {

                                    var infoValue = inItem.AssetInfoValue;
                                    var infoMultiplication = inItem.Multiplication;
                                    if (infoValue != null) {

                                        var dataValue = data[infoValue];
                                        if (infoMultiplication != null) {
                                            $.each(parseJson.cells, function (id, val) {
                                                if ('label' in val.attrs && 'text' in val.attrs.label) {

                                                    var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                                    var v = ((mainData * 100) / 100).toFixed(1);
                                                    if (val.type == "examples.Label") {
                                                        var attrName = inItem.Title;
                                                        var romovebracketAttr = inItem.Title;
                                                        if (inItem.AliasName != null && inItem.AliasName != undefined && inItem.AliasName != '') {
                                                            attrName = inItem.AliasName;
                                                            romovebracketAttr = inItem.AliasName.replace(/\(.*?\)/, '');

                                                        }
                                                        if ($.trim(val.attrs.label.text).startsWith($.trim(romovebracketAttr))) {

                                                            var attrNameStr = $.trim(attrName) + " : " + v;
                                                            val.attrs.label.text = attrNameStr.replaceAll('(', '\n(');
                                                            val.attrs.label.fill = "#222138";
                                                        }
                                                    }

                                                    if ($.trim(val.attrs.label.text) == 'LCBOXFEED') {

                                                        if (cardLines != null && cardLines != undefined && cardLines.length > 0) {
                                                            $(cardLines).each(function (d, data) {
                                                                if (data.AttributeName == 'If mA') {
                                                                    var splitClu = data.ClusterName.split("/");
                                                                    val.attrs.label.text = splitClu[splitClu.length - 1];

                                                                }
                                                            });

                                                        }
                                                    }

                                                    if ($.trim(val.attrs.label.text) == 'LCBOXRELAY') {

                                                        if (cardLines != null && cardLines != undefined && cardLines.length > 0) {
                                                            $(cardLines).each(function (d, data) {
                                                                if (data.AttributeName == 'Ir mA') {
                                                                    var splitClu = data.ClusterName.split("/");
                                                                    val.attrs.label.text = splitClu[splitClu.length - 1];

                                                                }
                                                            });

                                                        }
                                                    }

                                                    if ($.trim(val.attrs.label.text) == 'LKGVAL') {

                                                        var ifmaVal = fnGetLiveData(item, data,'If mA');
                                                        var irmaVal = fnGetLiveData(item, data,'Ir mA');
                                                        var lekageValue = parseFloat(ifmaVal) - parseFloat(irmaVal);
                                                        val.attrs.label.text = ((lekageValue * 100) / 100).toFixed(1);;
                                                    }
                                                }

                                            });
                                        }
                                    }
                                }
                            });
                        }

                        if (attributeJson != null && attributeJson != undefined) {

                            $.each(attributeJson, function (idx, inItem) {

                                $.each(parseJson.cells, function (id, val) {

                                    if ('label' in val.attrs && 'text' in val.attrs.label) {
                                        if (val.type == "examples.Label") {
                                            var attrName = inItem.Title;
                                            if (inItem.AliasName != null && inItem.AliasName != undefined && inItem.AliasName != '') {
                                                attrName = inItem.AliasName;
                                            }
                                            if ($.trim(val.attrs.label.text).startsWith($.trim(attrName))) {
                                                var value = 0;
                                                if (attrName == 'RTC VAR RES(ohm)') {
                                                    var chargeropv = fnGetLiveData(item, data, 'Charger OP V');
                                                    var vfData = fnGetLiveData(item, data, 'Vf');
                                                    var chokeV = fnGetLiveData(item, data, 'Choke V');

                                                    if (chargeropv != null && chargeropv != undefined && vfData != null && vfData != undefined && chokeV != null && chokeV != undefined) {
                                                        var vtrval = parseFloat(chargeropv) - parseFloat(vfData) - parseFloat(chokeV);
                                                        var ifmaVal = fnGetLiveData(item, data, 'If mA');

                                                        var ifA = parseFloat(ifmaVal) / 1000;
                                                        var vtco = parseFloat(vtrval) / parseFloat(ifA);
                                                        value = vtco.toFixed(1);
                                                    }


                                                } else if (attrName == 'VTC VAR RES(V)') {

                                                    var chargeropv = fnGetLiveData(item, data, 'Charger OP V');
                                                    var vfData = fnGetLiveData(item, data, 'Vf');
                                                    var chokeV = fnGetLiveData(item, data, 'Choke V');

                                                    if (chargeropv != null && chargeropv != undefined && vfData != null && vfData != undefined && chokeV != null && chokeV != undefined) {
                                                        var vtrval = parseFloat(chargeropv) - parseFloat(vfData) - parseFloat(chokeV);

                                                        value = vtrval.toFixed(1);

                                                    }

                                                }

                                                val.attrs.label.text = $.trim(attrName) + " :\n" + value;


                                            }
                                        }
                                        else {

                                        }
                                    }

                                });
                            });
                        }
                    }
                });


                //appModel.graph.fromJSON(parseJson);
                const currentTranslate = appModel.paper.translate();
                const currentScale = appModel.paper.scale();
                const paperWidth = appModel.paper.options.width;
                const paperHeight = appModel.paper.options.height;

                appModel.paper.model.fromJSON(parseJson);


                // Restore after next animation frame
                requestAnimationFrame(() => {
                    appModel.paper.translate(currentTranslate.tx, currentTranslate.ty);
                    appModel.paper.scale(currentScale.sx, currentScale.sy);
                    appModel.paper.setDimensions(paperWidth, paperHeight);
                });

                //requestAnimationFrame(() => {
                //    // Optionally add some padding/margin
                //    const padding = 100;

                //    appModel.paper.fitToContent({
                //        allowNewOrigin: 'any',  // Allows negative origin (elements left/top of 0,0)
                //        padding: padding
                //    });

                //    // If using PaperScroller, update its size as well:
                //    if (paperScroller) {
                //        const newSize = paper.getComputedSize();
                //        paperScroller.resize(newSize.width, newSize.height);
                //    }
                //});

            }

        }, 5000);




    }



    function BindCircuitSignalSimulation(basePath, data) {

        var d = new Date();
        var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
        $("#circuitDiagramLiveTimeStamp").html('Last Update: ' + time);


        if ($("#circuitDiagramLiveGif").attr("src") != '/assets/images/liveGif.gif')
        {
            $("#circuitDiagramLiveGif").attr("src", "/assets/images/Live_green.gif");

        }

        setTimeout(function () {
            if (parseJson != null && parseJson != undefined && parseJson != '') {
                $.each(parseJson.cells, function (id, val) {

                    if (val.type == "examples.SingleCircle") {
                        val.attrs.path.fill = "#33334e";

                    }
                });
                appModel.graph.fromJSON(parseJson);

                $.each(assets, function (id, item) {
                    if (item.Id == parseInt(assetJson.Id)) {
                        if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                            $.each(item.assetAttributes, function (idx, inItem) {
                                var str1 = basePath.toLowerCase();
                                var str2 = "";
                                if (inItem.AssetInfoChannel != null && inItem.AssetInfoChannel != "") {
                                    str2 = inItem.AssetInfoChannel;
                                }
                                if (str2 != null && str2 != "" && str1.indexOf(str2) != -1) {

                                    var infoValue = inItem.AssetInfoValue;
                                    var infoMultiplication = inItem.Multiplication;
                                    if (infoValue != null) {

                                        var dataValue = data[infoValue];
                                        if (infoMultiplication != null) {
                                            $.each(parseJson.cells, function (id, val) {
                                                if ('label' in val.attrs && 'text' in val.attrs.label) {

                                                    var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                                    var v = ((mainData * 100) / 100).toFixed(1);
                                                    if (val.type == "examples.Label") {
                                                        var attrName = inItem.Title;
                                                        if (inItem.AliasName != null && inItem.AliasName != undefined && inItem.AliasName != '') {
                                                            attrName = inItem.AliasName;
                                                        }
                                                        if ($.trim(val.attrs.label.text).startsWith($.trim(attrName))) {
                                                            val.attrs.label.text = $.trim(attrName) + " : " + v
                                                            val.attrs.label.fill = "#222138";
                                                        }
                                                    }
                                                }

                                                if (val.type == "examples.Text") {
                                                    if (val.attrs != null && val.attrs.label != null && val.attrs.label != undefined && val.attrs.label.text != null && val.attrs.label.text != undefined) {
                                                        if ($.trim(val.attrs.label.text) == 'SLCBOX') {

                                                            if (cardLines != null && cardLines != undefined && cardLines.length > 0) {
                                                                $(cardLines).each(function (d, data) {
                                                                    if (data.AttributeName == 'RG mA') {
                                                                        var splitClu = data.ClusterName.split("/");
                                                                        val.attrs.label.text = splitClu[splitClu.length - 1];

                                                                    }
                                                                });

                                                            }
                                                        }
                                                    }

                                                }


                                                if (val.type == "examples.SingleCircle") {
                                                    var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                                    var v = ((mainData * 100) / 100).toFixed(1);

                                                    if (val.attrs != null && val.attrs.label != null && val.attrs.label != undefined && val.attrs.label.text != null && val.attrs.label.text != undefined) {
                                                        if (val.attrs.label.text == "RG mA" && inItem.Title == "RG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                                            val.attrs.path.fill = "#FF0E0E";
                                                            //val.attrs.label.fill = "#FF0E0E";

                                                        }
                                                        else if (val.attrs.label.text == "DG mA" && inItem.Title == "DG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                                            val.attrs.path.fill = "#00FF00";
                                                            //val.attrs.label.fill = "#00FF00";

                                                        }
                                                        else if (val.attrs.label.text == "HG mA" && inItem.Title == "HG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                                            val.attrs.path.fill = "#FFBF00";
                                                            //val.attrs.label.fill = "#FFBF00";
                                                        }
                                                        else if (val.attrs.label.text == "HHG mA" && inItem.Title == "HHG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                                            val.attrs.path.fill = "#FFBF00";
                                                            //val.attrs.label.fill = "#FFBF00";

                                                        }
                                                    }

                                                }
                                            });
                                        }
                                    }
                                }
                            });
                        }

                    }

                });

                appModel.graph.fromJSON(parseJson);
            }

        }, 5000);



    }

    function BindCircuitDataLoggerSimulation(basePath, data) {
        //Bind Datalogger Attribute
        if (parseJson != null && parseJson != undefined && parseJson != '') {
