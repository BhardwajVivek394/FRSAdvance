@model Domain.SectionLister
@{
    ViewBag.Title = "Section";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Section</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="">
    <div class="">
        @using (Ajax.BeginForm("SectionList", "Section", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSectionList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "SectionRefreshed"
        }, new { id = "frmGetSectionList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divSectionList">
                @Html.Action("SectionList")
            </div>
        }


        @using (Ajax.BeginForm("SaveSection", "Section", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveSection",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "SectionSaved"
        }, new { id = "frmSaveSection" }))
        {
            <div id="divSaveSection">
                @Html.Partial("_AddSectionPartial", new Domain.Section())
            </div>
        }

    </div>
</div>

<script src="~/Content/PageJS/Section/SectionIndex.js"></script>