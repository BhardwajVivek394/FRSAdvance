
@model Domain.Section


<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-section" tabindex="-1" aria-labelledby="modal-add-section" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content bradius4">
            @Html.HiddenFor(m => Model.Id, new { @id = "hdnSectionId" })

            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Section</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Edit Section</span></h4>
                }
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="">
                                <label class="control-label">Division <span class="text-danger">*</span></label>
                                <div class="mb-3">
                                    @Html.DropDownListFor(m => m.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, new { @class = "form-control", style = "width:100%", id = "divisionAdd", tabindex = 1 })

                                    <span id="spRole" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="">
                                <label class="control-label">Name <span class="text-danger">*</span></label>
                                <div class="mb-3">
                                    @Html.TextBoxFor(m => Model.Name, new { @class = "form-control", tabindex = 2 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <div class="">
                                <label class="control-label">Description <span class="text-danger"></span></label>
                                <div class="mb-3">
                                    @Html.TextAreaFor(m => Model.Description, new { @class = "form-control", tabindex = 3 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="">
                                <label class="control-label"><span>Is Active</span>  @Html.CheckBoxFor(m => Model.IsActive, new { style = "vertical-align:sub" })</label>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close" id="btnClose">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/PageJS/Section/AddSection.js"></script>
<script>
    function fnSave() {
        if (Validate()) {
            debugger
            $("#frmSaveSection").submit();
        }
    }

    function Validate() {
        var result = true;

        if ($.trim($("#Name").val()).length == 0) {
            $("#Name").next("span").html("Name is required");
            result = false;
        }
        else {
            $("#Name").next("span").html("");
        }

        return result;
    }
</script>
