@model Domain.SignalDataLister


<div class="col-12">

    <div class="col-sm-12 col-md-12 col-lg-12">
        <div class="row">
            <div class="col-sm-2 mb-1">
                <label>Asset Name</label>
                <input type="text" class="form-control" id="txtSignalAssetName" />
            </div>
            <div class="col-sm-2 mt-4">
                <button class="btn btn-success" type="button" onclick="fnFilterSignal()">Search</button>
            </div>
        </div>
    </div>


    <div class="card-body " style="padding:15px;">
        <div class="table-responsive">


            @if (Model.SignalDatas != null && Model.SignalDatas.Count > 0)
            {
                <table class="table mb-2" style="border-collapse: separate;border-spacing: 0 15px; ">

                    @foreach (var assetName in Model.SignalDatas.GroupBy(x => x.AssetName).ToList())
                    {
                        string oldString = string.Empty;
                        <thead>
                            <tr class="MainTh">
                                <th width="100"><a href="javascript:void(0)"><i class="fa fa-plus" onclick="fnGetSignalData('@assetName.Key', this)"></i></a></th>
                                <th>@assetName.Key</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="trSignalAsset_@assetName.Key" style="display:none">
                                <td colspan="2">
                                    <div class="tableFixHead">
                                        <table class="table">
                                            @foreach (var item in Model.SignalDatas.Where(x => x.AssetName.Trim().ToLower() == assetName.Key.Trim().ToLower()))
                                            {

                                                var str = new List<string>();
                                                if (Convert.ToDouble(item.RGV) > 0)
                                                {
                                                    str.Add("RG");
                                                }
                                                if (Convert.ToDouble(item.DGV) > 0)
                                                {
                                                    str.Add("DG");
                                                }
                                                if (Convert.ToDouble(item.HGV) > 0)
                                                {
                                                    str.Add("HG");
                                                }

                                                if (str.Count == 1)
                                                {
                                                    var stp = str.FirstOrDefault();


                                                    if (oldString != stp)
                                                    {
                                                        oldString = stp;
                                                        <tr class="bg-primary">
                                                            <th>Date</th>
                                                            <th class="text-white">Aspect Name</th>
                                                            <th class="text-white">Aspect @stp V</th>
                                                            <th class="text-white">Aspect @stp mA</th>
                                                            <th class="text-white">Aspect @stp P</th>
                                                            <th class="text-white">AI_cluster_@stp</th>
                                                            <th class="text-white">AI_status_@stp</th>
                                                        </tr>
                                                    }

                                                    <tr class="SubTh">

                                                        <td>@item.Date</td>
                                                        <td>@item.AssetName</td>
                                                        <td>
                                                            @if (stp == "RG")
                                                            {
                                                                <span>@item.RGV</span>
                                                            }
                                                            else if (stp == "DG")
                                                            {
                                                                <span>@item.DGV</span>
                                                            }
                                                            else if (stp == "HG")
                                                            {
                                                                <span>@item.HGV</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (stp == "RG")
                                                            {
                                                                <span>@item.RGmA</span>
                                                            }
                                                            else if (stp == "DG")
                                                            {
                                                                <span>@item.DGmA</span>
                                                            }
                                                            else if (stp == "HG")
                                                            {
                                                                <span>@item.HGmA</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (stp == "RG")
                                                            {
                                                                <span>@item.RGP</span>
                                                            }
                                                            else if (stp == "DG")
                                                            {
                                                                <span>@item.DGP</span>
                                                            }
                                                            else if (stp == "HG")
                                                            {
                                                                <span>@item.HGP</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (stp == "RG")
                                                            {
                                                                <span>@item.AI_cluster_RG</span>
                                                            }
                                                            else if (stp == "DG")
                                                            {
                                                                <span>@item.AI_cluster_DG</span>
                                                            }
                                                            else if (stp == "HG")
                                                            {
                                                                <span>@item.AI_cluster_HG</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (stp == "RG")
                                                            {
                                                                <span>@item.AI_status_RG</span>
                                                            }
                                                            else if (stp == "DG")
                                                            {
                                                                <span>@item.AI_status_DG</span>
                                                            }
                                                            else if (stp == "HG")
                                                            {
                                                                <span>@item.AI_status_HG</span>
                                                            }
                                                        </td>
                                                    </tr>



                                                }
                                            }
                                        </table>
                                    </div>
                                </td>
                            </tr>
                        </tbody>

                    }
                </table>
            }


        </div>
    </div>
</div>
<script>
    function fnGetSignalData(assetId, $this) {
        if (assetId != null && assetId != undefined && assetId != '') {
            if ($($this).hasClass("fa-plus")) {
                $($this).removeClass("fa-plus").addClass("fa-minus");
                $('.trSignalAsset_' + assetId).show();
            }
            else {
                $($this).removeClass("fa-minus").addClass("fa-plus");
                $('.trSignalAsset_' + assetId).hide();
            }
        }
    }
</script>