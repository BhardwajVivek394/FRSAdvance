
@{
    ViewBag.Title = "Visualization";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .collapsed .icon-class:before {
        content: '>';
    }

    .icon-class:before {
        content: 'v';
    }

    .table > :not(:last-child) > :last-child > * {
        border-bottom-color: #87c7d9 !important;
    }

    .MainTh {
        background-color: #7fcde22e !important;
        border-bottom-color: #87c9db !important;
    }

    .SubTh {
        background-color: #f4f6fc !important;
        border-bottom-color: #87c9db !important;
    }


    .tableFixHead {
        overflow-y: auto;
        height: 750px;
    }

        .tableFixHead thead th {
            position: sticky;
            top: -1px;
        }

    table {
        border-collapse: collapse;
        width: 100%;
    }

    /*th, td {
        padding: 8px 16px;
    }*/

</style>


<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
<script src="~/assets/js/chart/echart/echarts.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Visualization</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="row">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-2 mb-1">
                                <label>Type</label>
                                @Html.DropDownList("TypeId", new List<SelectListItem>
            {
            new SelectListItem{ Text="Select", Value = "" },
            new SelectListItem{ Text="Track", Value = "1" },
               new SelectListItem{ Text="Signal", Value = "2" },
            new SelectListItem{ Text="POINT MACHINE", Value = "3" },
            }, new { @class = "form-control", tabindex = 2 })

                                @*@Html.DropDownList("TypeId", (IEnumerable<SelectListItem>)ViewBag.AssetTypes, new { @class = "form-control", tabindex = 1 })*@
                            </div>

                            <div class="col-sm-4 mb-1 divUpload">
                                <label>Upload</label>
                                <input type="file" accept=".csv" class="form-control" onchange="fnUploadCSV(this)" />
                            </div>
                            <div class="col-sm-4 mb-1 divUpload" style="display:none">
                                <label>Cluster</label>
                                <input type="text" class="form-control" id="txtCluster" />
                            </div>


                            <div id="divSignalCluster" style="display:none">
                                <div class="row">
                                    <div class="col-sm-2 mb-1">
                                        <label>RG Cluster</label>
                                        <input type="text" class="form-control" id="txtRGCluster" />
                                    </div>
                                    <div class="col-sm-2 mb-1">
                                        <label>DG Cluster</label>
                                        <input type="text" class="form-control" id="txtDGCluster" />
                                    </div>
                                    <div class="col-sm-2 mb-1">
                                        <label>HG Cluster</label>
                                        <input type="text" class="form-control" id="txtHGCluster" />
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>
                </div>


            </div>
            <div class="card-body" style="padding:10px !important">
                <div class="row">
                    <div class="col-sm-12">
                        <div id="divPointMachine">
                        </div>

                        @using (Ajax.BeginForm("_TrackDashboard", "AIVisualization", new AjaxOptions()
                        {
                            HttpMethod = "POST",
                            UpdateTargetId = "divTrack",
                            InsertionMode = InsertionMode.Replace,
                            LoadingElementId = "loader"
                        }, new { id = "frmTrack" }))
                        {
                            <div id="divTrack">
                                @*@Url.Action("_TrackDashboard", "AIVisualization",new Domain.TrackDataLister())*@
                            </div>
                        }


                        @using (Ajax.BeginForm("FilterSignal", "AIVisualization", new AjaxOptions()
                        {
                            HttpMethod = "POST",
                            UpdateTargetId = "divSignal",
                            InsertionMode = InsertionMode.Replace,
                            LoadingElementId = "loader"
                        }, new { id = "frmFilterSignal" }))
                        {
                            <div id="divSignal">
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal bounceIn animated" id="modal-graph" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h6 class="modal-title" id="myModalLabel">
                    <span id="line1">52 2021-05-26 17:07:00 <b id="op">Normal Operation:</b></span><br />
                    <span id="line2">- A Max / Average Current: 3.8 / 2.34</span><br />
                    <span id="line3">- A Max / Average Voltage: 118.9 / 116.00</span><br />
                    <span id="line4">- A Operating Time (ms): 3300</span><br />
                    <span id="line5">B Max / Average Current: null / 0.0</span><br />
                    <span id="line6">- B Max / Average Voltage: 0 / 0.00</span><br />
                    <span id="line7">- B Operating Time (ms): 0</span><br />
                </h6>
                <button type="button" style="position:absolute;right:8px;top:8px;" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12 mainclass" id="mainId">
                        <canvas id='basicflot' style='height: 263px'></canvas>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal bounceIn animated" id="modal-pointmachine-graph" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <button type="button" style="position:absolute;right:8px;top:8px;" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12">
                        <input type="hidden" id="hdnPMAssetId" />
                        <div class="row" id="pointmachine-select-mainId">

                        </div>
                    </div>
                    <div class="col-sm-12 mainclass" id="pointmachine-mainId">
                        <canvas id='pointmachine-basicflot'></canvas>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.onbeforeunload = function () {
      
        $.ajax({
            url: "/AIVisualization/RemoveCache",
            type: "POST",
            contentType: 'application/json',
            success: function (data) {
              
            },
            error: function (xhr, error, status) {
            }
        });
    }

    $(document).ready(function () {
        $('#TypeId').change(function () {
            $('.divUpload').show();
            if ($('#TypeId').val() == 1) {
                $('.divUpload').hide();
                $('#frmTrack').submit();
                //$('#divCluster').show();
            }
            else if ($('#TypeId').val() == 2) {
                $('#divSignalCluster').show();
            }
            else {
                $('#divCluster').hide();
                $('#divSignalCluster').hide();
            }
            $('#txtCluster').val('');
            $('#txtRGCluster').val('');
            $('#txtDGCluster').val('');
            $('#txtHGCluster').val('');
        });
    })

    function fnUploadCSV($this) {

        var fileUpload = $($this).get(0);
        var files = fileUpload.files;
        var fileData = new FormData();
        fileData.append(files[0].name, files[0]);
        $("#divTrack").empty()
        $("#divSignal").empty()
        if ($('#TypeId').val() == 2) {
            fnUploadSignal(fileData);
        }
        else if ($('#TypeId').val() == 3) {
            fnUploadPointMachine(fileData);
        }

    }

    function fnUploadTrack(fileData) {
        if ($('#txtCluster').val() != null && $('#txtCluster').val() != undefined && $('#txtCluster').val() != '') {
            fileData.append("cluster", $('#txtCluster').val());
            $("#loader").show();
            $.ajax({
                url: "/AIVisualization/UploadTrackCSV",
                type: "POST",
                contentType: false,
                processData: false,
                data: fileData,
                async: true,
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data != undefined && data != '') {
                        $("#divTrack").empty().append(data);
                    } else {
                        $("#divTrack").empty()
                    }
                },
                error: function (xhr, error, status) {
                    $("#loader").hide();
                    $("#divTrack").empty()
                    CommonNotification("ERROR", "Internal server error.", "Error");
                }
            });
        } else {
            CommonNotification("ERROR", "Cluster is required.", "Error");
        }

    }

    function fnUploadSignal(fileData) {
        var isValid = false;
        if ($('#txtRGCluster').val() != null && $('#txtRGCluster').val() != undefined && $('#txtRGCluster').val() != '') {
            isValid = true;
        }
        if ($('#txtDGCluster').val() != null && $('#txtDGCluster').val() != undefined && $('#txtDGCluster').val() != '') {
            isValid = true;
        }
        if ($('#txtHGCluster').val() != null && $('#txtHGCluster').val() != undefined && $('#txtHGCluster').val() != '') {
            isValid = true;
        }


        if (isValid) {
            fileData.append("ClusterRG", $('#txtRGCluster').val());
            fileData.append("ClusterDG", $('#txtDGCluster').val());
            fileData.append("ClusterHG", $('#txtHGCluster').val());
            $("#loader").show();
            $.ajax({
                url: "/AIVisualization/UploadSignalCSV",
                type: "POST",
                contentType: false,
                processData: false,
                data: fileData,
                async: true,
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data != undefined && data != '') {
                        $("#divTrack").empty().append(data);
                    } else {
                        $("#divTrack").empty()
                    }
                },
                error: function (xhr, error, status) {
                    $("#loader").hide();
                    $("#divTrack").empty()
                    CommonNotification("ERROR", "Internal server error.", "Error");
                }
            });
        } else {
            CommonNotification("ERROR", "Cluster is required.", "Error");
        }


    }

    function fnUploadPointMachine(fileData) {
        $("#loader").show();
        $.ajax({
            url: "/AIVisualization/UploadPointMachineCSV",
            type: "POST",
            contentType: false,
            processData: false,
            data: fileData,
            async: true,
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                if (data != null && data != undefined && data != '') {
                    $("#divPointMachine").empty().append(data);
                } else {
                    $("#divPointMachine").empty()
                }
            },
            error: function (xhr, error, status) {
                $("#loader").hide();
                $("#divPointMachine").empty()
                CommonNotification("ERROR", "Internal server error.", "Error");
            }
        });
    }

    function fnFilterPointMachine() {
        $("#loader").show();
        var searchCriteria = {
            Status_A: $('#drpAStatus').find(":selected").val(),
            Status_B: $('#drpBStatus').find(":selected").val(),
            ClusterA: $('#drpaCluster').find(":selected").val(),
            ClusterB: $('#drpbCluster').find(":selected").val(),
            IsThickWave: $("#chkIsThickWave").is(":checked") ? "true" : "false"
        };

        $.ajax({
            url: "/AIVisualization/FilterPointMachine",
            type: "POST",
            data: '{searchCriteria:' + JSON.stringify(searchCriteria) + '}',
            contentType: 'application/json',
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                if (data != null && data != undefined && data != '') {
                    $("#divPointMachine").empty().append(data);

                    $('#drpAStatus').val(searchCriteria.Status_A);
                    $('#drpBStatus').val(searchCriteria.Status_B);
                    $('#drpaCluster').val(searchCriteria.ClusterA);
                    $('#drpbCluster').val(searchCriteria.ClusterB);



                } else {
                    $("#divPointMachine").empty()
                }
            },
            error: function (xhr, error, status) {
                $("#loader").hide();
                $("#divPointMachine").empty()
                CommonNotification("ERROR", "Internal server error.", "Error");
            }
        });
    }

    function fnFilterTrack() {
        if ($('#txtCluster').val() != null && $('#txtCluster').val() != undefined && $('#txtCluster').val() != '') {
            var searchCriteria = {
                AssetName: $('#txtTrackAssetName').val(),
                AI_Cluster: $('#txtCluster').val()
            };
            $("#loader").show();
            $.ajax({
                url: "/AIVisualization/FilterTrack",
                type: "POST",
                data: '{mSearchCriteria:' + JSON.stringify(searchCriteria) + '}',
                contentType: 'application/json',
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data != undefined && data != '') {
                        $("#divTrack").empty().append(data);
                        $('#txtTrackAssetName').val(searchCriteria.AssetName);
                    } else {
                        $("#divTrack").empty()
                    }
                },
                error: function (xhr, error, status) {
                    $("#loader").hide();
                    $("#divTrack").empty()
                    CommonNotification("ERROR", "Internal server error.", "Error");
                }
            });
        }
        else {
            CommonNotification("ERROR", "Cluster is required.", "Error");
        }

    }

    function fnBindSignatureGragh(data, type, datevalue, direction, name) {
        // $(".mianclass").empty().append("<canvas  id='basicflot' style='height: 263px'></canvas>")
        //  $("#basicflot").empty();
        $("div").remove(".chartjs-size-monitor");
        //$(".chartjs-size-monitor").each(function () {
        //    $(this).remove()
        //})
        var j = JSON.parse(data);
        var acg;
        var bcg;
        var avg;
        var bvg;
        if (j.A_C_AVERAGE != null) {
            acg = parseFloat(j.A_C_AVERAGE).toFixed(2);
        }
        if (j.B_C_AVERAGE != null) {
            bcg = parseFloat(j.B_C_AVERAGE).toFixed(2);
        }
        if (j.A_V_AVERAGE != null) {
