        //  labels: ["January", "February", "March", "April", "May", "June", "July"],


        var pieChartContent = document.getElementById('mainId');
        pieChartContent.innerHTML = '&nbsp;';
        $('#mainId').append('<canvas id="basicflot"style="height: 263px"><canvas>');

        // var canvas = document.getElementById('basicflot');
        var canvas = $("#basicflot").get(0).getContext("2d");
        // var myPieChart = new Chart(ctx).Pie(data, options);

        // do some drawing

        var data = {
