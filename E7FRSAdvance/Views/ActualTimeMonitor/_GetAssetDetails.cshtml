    function GetAlarmStatus(assetId) {

        if (assetId) {
            $.ajax({
                url: '/Site/GetAlarmStatus',
                type: 'Post',
                data: '{assetId:' + assetId + '}',
                contentType: 'application/json',
                success: function (data) {
                    if (data == true) {
                        $(".checkHealth" + assetId).html("<span style='cursor:pointer' onclick='GetLogByAssetId(" + assetId + ")' class='text-danger'>Alarm</span>");
                    }
                    else {
                        $(".checkHealth" + assetId).html("<span class='text-success'>Ok</span>");
                    }
                },
                error: function (response) {
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }
    function GetLogByAssetId(assetId) {

        if (assetId) {
            $.ajax({
                url: '/Site/GetLogByAssetId',
                type: 'Post',
                data: '{assetId:' + assetId + '}',
                contentType: 'application/json',
                dataType:'html',
                success: function (data) {
                    $("#model-div").empty().append(data);
                    $("#modalSmslogs").modal('show');
