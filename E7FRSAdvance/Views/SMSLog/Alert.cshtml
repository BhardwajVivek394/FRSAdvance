@model Domain.SMSLogLister
@{
    ViewBag.Title = "Alert Log";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<div class="">
    <div class="">
        <ol class="breadcrumb breadcrumb-quirk">
            <li><i class="fa fa-home mr5"></i>Home</li>
            <li class="active">Alert Log</li>
        </ol>
        <div class="row">
            <div class="col-sm-12 col-md-12 col-lg-12 people-list ">
                <div class="panel panel-profile list-view bgSkyBlue">
                    <div class="panel-body">
                        <div class="table-responsive" style="max-height: 790px;">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Site Name</th>
                                        <th data-sortcolumn="Message" class="sorting" id="thMessage" onclick="SortList('Message');">Message</th>
                                        <th data-sortcolumn="TimeStamp" class="sorting" id="thTimeStamp" onclick="SortList('TimeStamp');">Time Stamp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.mSMSLogs != null && Model.mSMSLogs.Count > 0)
                                    {
                                        foreach (var item in Model.mSMSLogs)
                                        {
                                            <tr>
                                                <td>@item.SiteName</td>
                                                <td>@item.Message</td>
                                                <td>@item.TimeStamp</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center">
                                                No record found
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <!-- panel -->
        </div>
    </div>
</div>