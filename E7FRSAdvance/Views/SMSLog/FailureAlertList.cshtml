@model Domain.SMSLogLister
@{
    ViewBag.Title = "Alert List View";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/paho-mqtt.js"></script>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Alert List View</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">

        @using (Ajax.BeginForm("_FailureAlertList", "SMSLog", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divFailureAlertList",
            InsertionMode = InsertionMode.Replace
        }, new { id = "frmFailureAlertList" }))
        {
            <div id="divFailureAlertList">
                @Html.Action("_FailureAlertList", Model)
            </div>
        }
    </div>
</div>
<div id="divAssetAttributePartial"></div>

<script>

    setInterval(function () {

        fnSearchFRSAlert();

    }, 30000);
</script>
