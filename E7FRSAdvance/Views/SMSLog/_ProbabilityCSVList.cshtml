@model Domain.ProbabilityLister

<div class="modal bounceIn animated" id="modalProbabilityCSV" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Probability</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">

                    <div class="col-sm-12" id="model-div">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="table-responsive modal-fixed-height">
                                    <table class="table" id="tblsmslogs">
                                        <thead class="bg-primary">
                                            <tr>
                                                <th>
                                                    Site Name
                                                </th>
                                                <th>
                                                    Gear Name
                                                </th>
                                                <th>
                                                    Category
                                                </th>
                                                <th class="text-center">
                                                    Date
                                                </th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Probability != null && Model.Probability.Count > 0)
                                            {
                                                foreach (var item in Model.Probability)
                                                {
                                                    <tr>

                                                        <td>@item.SiteName </td>
                                                        <td>@item.AssetName </td>
                                                        <td>
                                                            @if (item.Category.Contains("TrainMomentLog"))
                                                            {
                                                                <span>
                                                                    @item.Category.Replace("TrainMomentLog", "Prone To Shorting")
                                                                </span>
                                                            }
                                                            else if (item.Category.Contains("GluedLog"))
                                                            {
                                                                <span>
                                                                    @item.Category.Replace("GluedLog", "Glued")
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span>
                                                                    @item.Category

                                                                </span>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @item.TimeStamp
                                                        </td>
                                                    </tr>
                                                }
                                            }

                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>


                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>