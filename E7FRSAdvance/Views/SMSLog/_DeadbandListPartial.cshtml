@model List<Domain.Deadband>


<tr id="trDeadband@(ViewBag.Id)">
    <td colspan="4">
        <div class="row">
            <div class="col-2">
                <select id="drpDeadbandType@(ViewBag.Id)" onchange="fnBindDeadband('@ViewBag.TimeStemp','@ViewBag.Id','@ViewBag.AssetId');" class="form-control">
                    <option value="All">All</option>
                    @if (ViewBag.IsGear == true)
                    {
                        <option value="Gear" selected>Gear</option>
                    }
                    else
                    {
                        <option value="Gear">Gear</option>
                    }
                </select>
            </div>            
        </div>
        <div style="height:200px; overflow-y: scroll;">
            <table class="table">
                <thead>
                    <tr>
                        <th>
                            Asset Name
                        </th>
                        <th>
                            Attribute Name
                        </th>
                        <th>
                            Time Stamp
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @item.AssetName
                                </td>
                                <td>
                                    @item.AttributeName
                                </td>
                                <td>
                                    @item.TimeStamp
                                </td>
                            </tr>
                        }

                    }


                </tbody>
            </table>
        </div>
    </td>
</tr>
