    function fnOpenModal(siteId, assetId, assetTypeId, siteName, assetName) {
        var mSearchCriteria = {};
        const date = new Date();
        const month = date.toLocaleString('default', { month: 'long' });
        mSearchCriteria.SiteId = siteId;
        mSearchCriteria.AssetId = assetId;
        mSearchCriteria.Month = month;

        $("#loader").show();
        $.ajax({
            url: '/SMSLog/Showlap',
            type: 'Post',
            data: JSON.stringify(mSearchCriteria),
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#hdnlapSiteId").val(siteId);
                $("#hdnlapAssetId").val(assetId);
                $("#hdnlapAssetTypeId").val(assetTypeId);
                $("#hdnlapSiteName").val(siteName);
                $("#spModallapHeader").text('Asset - ' + assetName);

                if (data != null) {
                    $("#spnMaintenanceAlertCount").text('(' + data.AlertCount + ')');
                    $("#spnPredictiveAlertCount").text('(' + data.ProbabilityCount + ')');
                }

                $("#modal-lap").modal("show");
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("error", "Something went wrong!");
            }
        });
    }

