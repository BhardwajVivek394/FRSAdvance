@model List<Domain.WorksheetMaterial>

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal fade" id="modal-assign-material" role="dialog" aria-labelledby="modal-assign-material" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader">Assign Material</span></h4>

                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            @if (Model != null && Model.Count > 0)
                            {
                                var mWorksheetStoreMaterials = new List<Domain.WorksheetStoreMaterial>();
                                if (ViewBag.WorksheetStoreMaterials != null)
                                {
                                    mWorksheetStoreMaterials = ViewBag.WorksheetStoreMaterials as List<Domain.WorksheetStoreMaterial>;
                                }
                                foreach (var item in Model)
                                {
                                    <div>
                                        @if (mWorksheetStoreMaterials.Where(x => x.MaterialId == item.Id).Count() > 0)
                                        {
                                            <input type="checkbox" class="clsWorksheetStoreMaterial" value="@item.Id" id="chkWorksheetStoreMaterial@(item.Id)" checked />
                                        }
                                        else
                                        {
                                            <input type="checkbox" class="clsWorksheetStoreMaterial" value="@item.Id" id="chkWorksheetStoreMaterial@(item.Id)" />
                                        }

                                        <label for="chkWorksheetStoreMaterial@(item.Id)">@item.Name</label>
                                    </div>
                                }
                                <div class="row">

                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnAssignMaterial('@ViewBag.DivisionId')">Save</button>
            </div>
        </div>
    </div>
</div>
