@model List<Domain.WorksheetStoreMaterial>


<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th class="text-center">Serial No.</th>
                <th class="text-center">Select</th>
                <th>Material Name</th>
                <th>Requirement</th>
                <th>In Stock</th>
                <th>Demand</th>
                <th>Relocated</th>
                <th>Faulty</th>
                <th>Repaired</th>
                <th>Reimbursed</th>
                <th>Re-Stored</th>
                <th>Unaccounted</th>
            </tr>
        </thead>
        @if (Model != null && Model.Count > 0)
        {
            int counter = 0;
            foreach (var item in Model)
            {
                counter++;

                <tr>
                    <td class="text-center">@counter</td>
                    <td class="text-center">
                        @if (item.IsActive)
                        {
                            <input type="checkbox" onchange="fnUpdateMaterialStatus('@item.Id',this)" checked/>
                        }
                        else
                        {
                            <input type="checkbox" onchange="fnUpdateMaterialStatus('@item.Id',this)" />
                        }
                    </td>
                    <td>
                        @item.MaterialName
                    </td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            }
        }
    </table>
</div>

