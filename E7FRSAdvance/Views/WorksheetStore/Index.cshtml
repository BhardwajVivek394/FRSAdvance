
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Store</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">

    @using (Ajax.BeginForm("List", "WorksheetStore", new AjaxOptions()
    {
        HttpMethod = "POST",
        UpdateTargetId = "divWorksheetStoreList",
        InsertionMode = InsertionMode.Replace,
        LoadingElementId = "loader"
    }, new { id = "frmWorksheetStoreList" }))
    {
        { HtmlHelper.ClientValidationEnabled = false; }
        <div id="divWorksheetStoreList">
            @Html.Action("List")
        </div>
    }
</div>

<div id="divAssignMaterial"></div>

<div id="divAssignMaterialQuantity"></div>

<script>

    function fnShowStore(divisionId, $this) {
        if ($($this).hasClass("fa-angle-up")) {
            $($this).removeClass("fa-angle-up").addClass("fa-angle-down");

            $("#loader").show();
            $.ajax({
                url: '/WorksheetStore/AssignWorksheetStoreMaterial?divisionId=' + divisionId,
                type: 'Get',
                dataType: 'html',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $('.divWorksheetStoreMaterialList' + divisionId).empty().append(data);
                    $('.divWorksheetStoreMaterial' + divisionId).show();

                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });

        } else {
            $($this).removeClass("fa-angle-down").addClass("fa-angle-up");
            $('.divWorksheetStoreMaterial' + divisionId).hide();

        }
    }

    function fnAddStore() {
        $("#loader").show();
        $.ajax({
            url: '/WorksheetStore/Add',
            type: 'Post',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAddWorksheetStore").empty().append(data);
                $("#modal-add-worksheet-store").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }

    function fnGetStore(id) {
        $("#loader").show();
        $.ajax({
            url: '/WorksheetStore/Get',
            type: 'Post',
            data: '{id:' + id + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAddWorksheetStore").empty().append(data);
                $("#modal-add-worksheet-store").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }

    function fnSave() {
        if (Valid()) {
            $('#frmAddWorksheetStore').submit();
        }
    }

    function Valid() {
        var isValid = true;

        if ($.trim($("#Name").val()).length == 0) {
            $("#Name").next("span").html("Name is required");
            isValid = false;
        }
        else {
            $("#Name").next("span").html("");
        }

        return isValid;
    }

    function fnAddMaterial(divisionId) {
        $("#loader").show();
        $.ajax({
            url: '/WorksheetStore/AssignMaterial?divisionId=' + divisionId,
            type: 'Get',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAssignMaterial").empty().append(data);
                $("#modal-assign-material").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }

    function fnAssignMaterial(divisionId) {
        var mWorksheetStoreMaterials = [];
        debugger;
        $('.clsWorksheetStoreMaterial').each(function () {
            if ($(this).prop('checked')) {
                var mWorksheetStoreMaterial = {};
                mWorksheetStoreMaterial.MaterialId = $(this).val();
                mWorksheetStoreMaterial.DivisionId = divisionId;
                mWorksheetStoreMaterials.push(mWorksheetStoreMaterial);
            }
        });

        if (mWorksheetStoreMaterials != null && mWorksheetStoreMaterials != undefined) {
            $("#loader").show();
            $.ajax({
                url: '/WorksheetStore/AssignMaterial',
                type: 'Post',
                data: '{mWorksheetStoreMaterials:' + JSON.stringify(mWorksheetStoreMaterials) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        $('#modal-assign-material').modal('hide');
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            // $('#frmJobCardList').submit();
                        } else {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }

                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });

        }
    }

    function fnAssignMaterialQuantity(divisionId) {
        $("#loader").show();
        $.ajax({
            url: '/WorksheetStore/AssignMaterialQuantity',
            type: 'Post',
            data: '{divisionId:' + divisionId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAssignMaterialQuantity").empty().append(data);
                $("#modal-assign-material-quantity").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }

    function fnUpdateMaterialStatus(id, $this) {
        var mWorksheetStoreMaterial = {};
        mWorksheetStoreMaterial.Id = id;

        if ($($this).prop('checked') == true) {
            mWorksheetStoreMaterial.IsActive = true;
        } else {
            mWorksheetStoreMaterial.IsActive = false;
        }

        if (mWorksheetStoreMaterial != null && mWorksheetStoreMaterial != undefined) {
            $("#loader").show();
            $.ajax({
                url: '/WorksheetStore/UpdateMaterialStatus',
                type: 'Post',
                data: '{mWorksheetStoreMaterial:' + JSON.stringify(mWorksheetStoreMaterial) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();                   

                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });

        }
    }

    function fnAssignSite(divisionId) {

    }
</script>

