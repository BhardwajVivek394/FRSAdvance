@model List<Domain.Division>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                @*<div class="pull-right">
                    <a href="javascript:void(0)" title="Add Store" class="btn btn-primary" onclick="fnAddStore()">Add Store</a>
                </div>*@
            </div>
            <div class="card-body" style="padding:15px;">

                <div class="row">
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <div class="col-12">
                                <div class="card mb-2">
                                    <div class="card-body text-white" style="padding: 15px; font-size: 18px; background-color: #21596880; border-radius: 12px; ">
                                        @item.StoreName
                                        <div class="pull-right">
                                            <a href="javascript:void(0)"><i class="fa fa-angle-up f-30" style="color:#fff;" onclick="fnShowStore('@item.Id',this)"></i></a>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-12 divWorksheetStoreMaterial@(item.Id)" style="display: none; padding: 20px;">
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="pull-right">
                                                <button type="button" class="btn btn-primary" onclick="fnAddMaterial('@item.Id')">Assign Material</button>
                                                <button type="button" class="btn btn-info" onclick="fnAssignMaterialQuantity('@item.Id')">Assign Quantity</button>
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="divWorksheetStoreMaterialList@(item.Id)">

                                            </div>
                                        </div>
                                    </div>
                                 
                                </div>
                            </div>
                        }
                    }

                </div>


            </div>
        </div>
    </div>
</div>

