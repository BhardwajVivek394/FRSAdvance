@model List<Domain.WorksheetStoreMaterial>

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal fade" id="modal-assign-material-quantity" role="dialog" aria-labelledby="modal-assign-material-quantity" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><span>Assign Material Quantity</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-3">
                            <select class="form-control">
                                <option>Select</option>
                                <option>Requirement</option>
                                <option>In Stock</option>
                                <option>Demand</option>
                                <option>Relocated</option>
                                <option>Faulty</option>
                                <option>Repaired</option>
                                <option>Reimbursed</option>
                                <option>Re-Stored</option>
                            </select>
                        </div>
                        <div class="col-sm-3">
                            <input type="text" class="form-control" placeholder="Transfer No." />
                        </div>
                        <div class="col-sm-12">
                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Material Name</th>
                                            <th>Add</th>
                                            <th>Sub</th>
                                            <th>Installed</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model != null && Model.Count > 0)
                                        {

                                            foreach (var item in Model)
                                            {
                                                <tr>
                                                    <td>@item.MaterialName</td>

                                                    <td>
                                                        <input type="number" class="form-control" />
                                                    </td>
                                                    <td>
                                                        <input type="number" class="form-control" />
                                                    </td>
                                                    <td>
                                                        <input type="number" class="form-control" />
                                                    </td>
                                                    <td>
                                                        <select class="form-control">
                                                            <option>Store</option>
                                                        </select>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnAssignMaterial('@ViewBag.StoreId')">Save</button>
            </div>
        </div>
    </div>
</div>

