    function BindRFStatusLive(item) {
        $('.tbodyRFStatus tr').each(function () {
            //$(this).find("td").eq(0).html('');
            var clusterName = $.trim($(this).find("td").eq(2).html());
            if (clusterName != null && clusterName != undefined && clusterName != '') {
                var clsname = item.name.replaceAll('/', '_');
                if (clsname == clusterName) {
                    $(this).find("td").eq(0).html('<img src="/assets/images/Live.png" />');

                } else {
                    //$(this).find("td").eq(0).html('');
                }
            }


        });
    }


    function fnDownloadDivisionReportPDF(divisionId) {
        if (divisionId != null && divisionId != undefined && divisionId != '') {

            window.location.href = "@Url.Action("DownloadDivisionReportPDF")?divisionId=" + divisionId + "&date=" + $("#hdnDivisionDate").val();

        } else {
            CommonNotification("error", "Please select Divisions");
        }

    }

    function fnConvertUTCDate(currentdate) {

        return "" + (currentdate.getUTCMonth() + 1) + "/"
            + currentdate.getUTCDate() + "/"
            + currentdate.getUTCFullYear() + " "
            + currentdate.getUTCHours() + ":"
            + currentdate.getUTCMinutes() + ":"
            + currentdate.getUTCSeconds();
    }
