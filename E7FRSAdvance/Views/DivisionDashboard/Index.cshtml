
@{
    ViewBag.Title = "Division Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="~/assets/js/paho-mqtt.js"></script>
<style>
    .pill-badge-primary1 {
        background-color: White;
    }

    body .mail-body-wrapper ul li {
        padding: 16px;
        display: flex;
        align-items: center;
        cursor: pointer;
        /*border-bottom: 1px solid #bebebe;*/
    }

    .pull-right {
        float: right;
    }

    body .mail-body-wrapper ul li .inbox-message .email-data .badge {
        border-radius: 20px;
    }

    body .mail-body-wrapper ul li .inbox-message {
        display: flex;
        justify-content: space-between;
        width: 100%;
        gap: 16px;
    }

        body .mail-body-wrapper ul li .inbox-message .email-data span {
            font-weight: 500;
            letter-spacing: 0.3;
            display: -webkit-box;
            max-width: 100%;
            margin: 0 auto;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            color: rgba(82, 82, 108, 0.8);
        }

    .tableFixHead {
        overflow: auto;
        height: 100vh;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }
</style>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Division Dashboard</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <div class="col-lg-12">
                        <div class="row">
                            <div class="col-xl-2">
                                <strong style="margin-top:10px;">From Date</strong>
                                <input type="text" class="form-control" id="txtFromDate" />
                            </div>
                            <div class="col-xl-2">
                                <strong style="margin-top:10px;">To Date</strong>
                                <input type="text" class="form-control" id="txtToDate" />
                            </div>
                            <div class="col-xl-2 mt-4">
                                <button type="button" class="btn btn-primary m-l-10" onclick="fnGetDivisionDashboardList()">Search</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="">
                        @using (Ajax.BeginForm("_DivisionDashboardList", "DivisionDashboard", new AjaxOptions()
                        {
                            HttpMethod = "POST",
                            UpdateTargetId = "divDivisionDashboardList",
                            InsertionMode = InsertionMode.Replace,
                            LoadingElementId = "loader"
                        }, new { id = "frmDivisionDashboardList" }))
                        {
                            { HtmlHelper.ClientValidationEnabled = false; }
                            <div id="divDivisionDashboardList">
                                @Html.Action("_DivisionDashboardList")
                            </div>
                        }
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>



<div id="divPreviousDaySMSLog"></div>
<div id="divPreviousDayDivisionReport"></div>
