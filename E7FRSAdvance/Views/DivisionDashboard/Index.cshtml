    $(document).ready(function () {

        $('#txtFromDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#txtToDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#txtFromDate').val('');
        $('#txtToDate').val('');
    });

    function fnGetDivisionDashboardList() {
        var mDivisionLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.FromDate = $('#txtFromDate').val();
        mSearchCriteria.ToDate = $('#txtToDate').val();

        mDivisionLister.SearchCriteria = mSearchCriteria;

        $("#loader").show();
        $.ajax({
            url: '/DivisionDashboard/_DivisionDashboardList',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mDivisionLister),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divDivisionDashboardList").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }
</script>