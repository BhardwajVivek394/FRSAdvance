@model Domain.WatchListLister
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/assets/js/paho-mqtt.js"></script>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">WatchList</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">

        @using (Ajax.BeginForm("_List", "WatchList", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divWatchList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
        }, new { id = "frmWatchList" }))
        {
            <div id="divWatchList">
                @Html.Action("_List", "Watchlist", Model)
            </div>
        }

    </div>
</div>


