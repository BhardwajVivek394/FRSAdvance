
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>


<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Lux Config</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="pull-left">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Sites</strong>
                            </div>
                            <div class="pull-left">
                                @Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 1 })
                            </div>
                            <div class="pull-left" style="margin-left:10px;">
                                <a class="btn btn-dark btn-sm btn-quirk" onclick="AddNumber()" data-bs-original-title="" title=""><span class="fa fa-plus"></span> Add</a>
                            </div>
                            <div class="pull-left" style="margin-left:10px;">
                            </div>
                        </div>

                      
                    </div>

                </div>
                <div class="card-body">
                    <div class="col-sm-12">
                        <div id="divLuxConfig">
                            <table class="table">
                                <tbody id="siteNumberBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="row">

    </div>
</div>
<script>
    $(document).ready(function () {
        $('#SiteId').change(function () {
            GetData();
        });
    });

    function GetData() {
        $("#siteNumberBody").empty();

        if ($('#SiteId').val() != null && $('#SiteId').val() != undefined && $('#SiteId').val() != '' && $('#SiteId').val() != "0") {

            $.ajax({
                url: '/LuxConfig/GetAll',
                type: 'POST',
                data: '{siteId:' + $('#SiteId').val() + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    var rowId = 0;

                    $(data).each(function (data, val) {
                        var temp = '';
                        rowId++;
                        temp += "<tr data-rowId=" + rowId + ">";
                        temp += "<td class='text-center width60' style='vertical-align:middle'>";
                        temp += "<a data-placement='top' data-toggle='tooltip' class='tooltips' data-original-title='Delete' style='cursor: pointer'><i class='fa fa-trash text-danger' onclick='fnDelete(" + val.Id + ")'></i></a>";
                        temp += "</td>";
                        temp += "<td>";
                        temp += "<label>" + val.AssetName + "</label>";
                        temp += "</td>";
                        temp += "<td>";
                        if (val.IsRed) {
                            temp += "<input type='checkbox' class='m-l-10' id='chkRed_" + rowId + "' checked/><label for='chkRed_" + rowId + "'>RG</label>";
                        } else {
                            temp += "<input type='checkbox' class='m-l-10' id='chkRed_" + rowId + "' /><label for='chkRed_" + rowId + "'>RG</label>";
                        }

                        if (val.IsGreen) {
                            temp += "<input type='checkbox' class='m-l-10' id='chkGreen_" + rowId + "' checked/><label for='chkGreen_" + rowId + "'>DG</label>";
                        } else {
                            temp += "<input type='checkbox' class='m-l-10' id='chkGreen_" + rowId + "' /><label for='chkGreen_" + rowId + "'>DG</label>";
                        }

                        if (val.IsYellow) {
                            temp += "<input type='checkbox' class='m-l-10' id='chkYellow_" + rowId + "' checked/><label for='chkYellow_" + rowId + "'>HG</label>";
                        } else {
                            temp += "<input type='checkbox' class='m-l-10' id='chkYellow_" + rowId + "' /><label for='chkYellow_" + rowId + "'>HG</label>";
                        }

                        if (val.IsDoubleYellow) {
                            temp += "<input type='checkbox' class='m-l-10' id='chkDoubleYellow_" + rowId + "' checked/><label for='chkDoubleYellow_" + rowId + "'>HHG</label>";
                        } else {
                            temp += "<input type='checkbox' class='m-l-10' id='chkDoubleYellow_" + rowId + "' /><label for='chkDoubleYellow_" + rowId + "'>HHG</label>";
                        }

                        temp += "</td>";
                        temp += "<td style='width:330px'>";
                        temp += "<input type='text' placeholder='Address' class='form-control' id='txtAddress_" + rowId + "' value=" + val.Address + " />";
                        temp += "</td>";
                        temp += "<td style='width:330px'>";
                        temp += "<input type='text' placeholder='Param value' class='form-control' id='txtParam_" + rowId + "' value=" + val.Param + " />";
                        temp += "</td>";
                        temp += "<td class='text-center width60'>";
                        temp += "<button type='button' onclick='fnUpdateLuxConfig(" + rowId + "," + val.AssetId + ")' class='btn btn-success btn-quirk'>Update</button>";
                        temp += "</td>";
                        temp += "</tr>";
                        $("#siteNumberBody").append(temp);
                    });
                    GetAllAsset();
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

    function GetAllAsset() {
        if ($('#SiteId').val() != null && $('#SiteId').val() != undefined && $('#SiteId').val() != '' && $('#SiteId').val() != "0") {
            $("#loader").show();
            $.ajax({
                url: '/LuxConfig/GetAllAsset',
                type: 'POST',
                data: '{siteId:' + $('#SiteId').val() + ',assetTypeId:@E7FRSAdvance.Utility.Utility.AssetType.SIGNAL.GetHashCode()}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    var drpRec = '';
                    $(".drpAsset").empty();
                    drpRec += '<option value=0>Select Asset</option>';
                    if (data != null && data != undefined && data != undefined) {
                        $(data).each(function (data, val) {
                            drpRec += '<option value=' + val.Id + '>' + val.Name + '</option>';
                        });
                    }
                    $(".drpAsset").append(drpRec);
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

    function fnSaveLuxConfig(rowId) {
        var LuxConfig = {};
        LuxConfig.SiteId = $("#SiteId").val();
        LuxConfig.AssetId = $("#drpAsset_" + rowId).val();

        if ($("#chkRed_" + rowId).prop('checked') == true) {
            LuxConfig.IsRed = true;
        }
        if ($("#chkGreen_" + rowId).prop('checked') == true) {
            LuxConfig.IsGreen = true;
        }
        if ($("#chkYellow_" + rowId).prop('checked') == true) {
            LuxConfig.IsYellow = true;
        }
        if ($("#chkDoubleYellow_" + rowId).prop('checked') == true) {
            LuxConfig.IsDoubleYellow = true;
        }
        LuxConfig.Address = $("#txtAddress_" + rowId).val();
        LuxConfig.Param = $("#txtParam_" + rowId).val();
        if (fnValidLuxConfig(LuxConfig)) {
            $("#loader").show();
            $.ajax({
                url: '/LuxConfig/Save',
                type: 'Post',
                data: '{mLuxConfig:' + JSON.stringify(LuxConfig) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data.Id > 0) {
                        CommonNotification("SUCCESS", "Lux Config has been saved.", "success");
                        GetData();
                    } else {
                        CommonNotification("ERROR", "Internal server error.", "error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
    }

    function fnUpdateLuxConfig(rowId, assetId) {
        var LuxConfig = {};
        LuxConfig.SiteId = $("#SiteId").val();
        LuxConfig.AssetId = assetId;

        if ($("#chkRed_" + rowId).prop('checked') == true) {
            LuxConfig.IsRed = true;
        }
        if ($("#chkGreen_" + rowId).prop('checked') == true) {
            LuxConfig.IsGreen = true;
        }
        if ($("#chkYellow_" + rowId).prop('checked') == true) {
            LuxConfig.IsYellow = true;
        }
        if ($("#chkDoubleYellow_" + rowId).prop('checked') == true) {
            LuxConfig.IsDoubleYellow = true;
        }

        LuxConfig.Address = $("#txtAddress_" + rowId).val();
        LuxConfig.Param = $("#txtParam_" + rowId).val();
        if (fnValidLuxConfig(LuxConfig)) {
            $("#loader").show();
            $.ajax({
                url: '/LuxConfig/Save',
                type: 'Post',
                data: '{mLuxConfig:' + JSON.stringify(LuxConfig) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data.Id > 0) {
                        CommonNotification("SUCCESS", "Lux Config has been saved.", "success");
                        GetData();
                    } else {
                        CommonNotification("ERROR", "Internal server error.", "error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
    }

    function fnValidLuxConfig(LuxConfig) {
        if (LuxConfig.SiteId == null || LuxConfig.SiteId == undefined || LuxConfig.SiteId == '') {
            alert("Site is required");
            return false;
        }

        if (LuxConfig.AssetId == null || LuxConfig.AssetId == undefined || LuxConfig.AssetId == '' || LuxConfig.AssetId == '0') {
            alert("Asset is required");
            return false;
        }

        if (LuxConfig.Address == null || LuxConfig.Address == undefined || LuxConfig.Address == '') {
            alert("Address is required");
            return false;
        }

        if (LuxConfig.Param == null || LuxConfig.Param == undefined || LuxConfig.Param == '') {
            alert("Param is required");
            return false;
        }
        return true;
    }

    function fnGetByAssetName(assetId, $this) {
        if (assetId != null && assetId != undefined && assetId != '') {
            if ($($this).hasClass("fa-plus")) {
                $($this).removeClass("fa-plus").addClass("fa-minus");
                $('.trAsset_' + assetId).show();
            }
            else {
                $($this).removeClass("fa-minus").addClass("fa-plus");
                $('.trAsset_' + assetId).hide();
            }
        }
    }

    function AddNumber() {
        if ($('#SiteId').val() != null && $('#SiteId').val() != undefined && $('#SiteId').val() != '' && $('#SiteId').val() != "0") {
            var rowId = 0;

            $('#siteNumberBody tr').each(function (id, val) {
                if (parseInt($(this).attr("data-rowId")) > rowId) {
                    rowId = parseInt($(this).attr("data-rowId"));
                }
            });

            rowId = parseInt(rowId) + 1;

            var temp = '';
            temp += "<tr data-rowId=" + rowId + ">";
            temp += "<td class='text-center width60' style='vertical-align:middle'>";
            temp += "</td>";
            temp += "<td>";
            temp += "<select class='form-control drpAsset' id='drpAsset_" + rowId +"'></select>";
            temp += "</td>";
            temp += "<td>";
            temp += "<input type='checkbox' class='m-l-10' id='chkRed_" + rowId + "' /><label for='chkRed_" + rowId +"'>RG</label>";
            temp += "<input type='checkbox' class='m-l-10' id='chkGreen_" + rowId + "' /><label for='chkGreen_" + rowId +"'>DG</label>";
            temp += "<input type='checkbox' class='m-l-10' id='chkYellow_" + rowId + "' /><label for='chkYellow_" + rowId +"'>HG</label>";
            temp += "<input type='checkbox' class='m-l-10' id='chkDoubleYellow_" + rowId + "' /><label for='chkDoubleYellow_" + rowId +"'>HHG</label>";
            temp += "</td>";
            temp += "<td style='width:330px'>";
            temp += "<input type='text' placeholder='Address' class='form-control' id='txtAddress_" + rowId +"' />";
            temp += "</td>";
            temp += "<td style='width:330px'>";
            temp += "<input type='text' placeholder='Param value' class='form-control' id='txtParam_" + rowId +"' />";
            temp += "</td>";
            temp += "<td class='text-center width60'>";
            temp += "<button type='button' onclick='fnSaveLuxConfig(" + rowId + ")' class='btn btn-success btn-quirk'>Add</button>";
            temp += "</td>";
            temp += "</tr>";
            $("#siteNumberBody").append(temp);
            GetAllAsset();
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

    function fnDelete(id) {
        if (confirm('Are you sure you want to delete this record?')) {
            $("#loader").show();
            $.ajax({
                url: '/LuxConfig/Delete',
                type: 'POST',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            GetData();
                            CommonNotification("SUCCESS", data.result, "success");
                        }
                        else {
                            CommonNotification("ERROR", data.result, "Error");
                        }
                    } else {
                        CommonNotification("ERROR", "Something went wrong!", "Error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });

        }

    }
</script>

