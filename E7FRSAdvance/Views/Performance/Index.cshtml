
@{
    ViewBag.Title = "Performance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="~/assets/js/chart/echart/echarts.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Performance</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-sm-3">
                            <div class="pull-left">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Sites</strong>
                            </div>
                            <div class="pull-left">
                                @Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites,"Select", new { @class = "form-control", tabindex = 1, onChange = "BindAssetType()" })
                            </div>

                        </div>
                        <div class="col-sm-3">
                            <div class="pull-left">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Asset Type</strong>
                            </div>
                            <div class="pull-left">
                                <select class="form-control" id="AssetTypeId" onchange="GetAssetTypeById(this)">
                                    <option>Select Asset Type</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="pull-left">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Asset</strong>
                            </div>
                            <div class="pull-left">
                                <select class="form-control" id="AssetId" onchange="LoadList()">
                                    <option>Select Asset</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="pull-left">
                                <button type="button" class="btn btn-success" id="btnPointMachineGraph" onclick="LoadPointMachineGraph()" style="display:none">Show Graph</button>

                                <a class="btn btn-success" href="#" onclick="fnDownloadPerformance()">Download</a>
                            </div>
                           
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="divPointMachinePartial" style="display:none">
                    </div>
                    <div class="apache-cotainer" id="area-echart" style="display:none">

                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


<div class="modal bounceIn animated" id="modal-PointMachineGraph" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader"> Point Machine Graph</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div id="pointmachine-chart" style="width:100%">
                </div>
                <div class="apache-cotainer" id="pointmachine-area-echart">

                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    var chart;
    function BindAssetType() {
        if ($("#SiteId").val() != null && $("#SiteId").val() != undefined && $("#SiteId").val() != '' && $("#SiteId").val() != '0') {
            $("#loader").show();
            $.ajax({
                url: '/Performance/GetAssetTypeBySiteId',
                type: 'POST',
                data: '{siteId:' + $("#SiteId").val() + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#AssetTypeId").empty();
                    $("#AssetTypeId").append($("<option></option>").val('0').html('Select Asset Type'));
                    $.each(data, function (key, value) {
                        $("#AssetTypeId").append($("<option></option>").val(value.Id).html(value.Name));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }

    }

    function GetAssetTypeById($this) {
        $("#loader").show();
        LoadList();
        $.ajax({
            url: '/Performance/GetAssetById',
            type: 'Post',
            data: '{assetTypeId:' + $($this).val() + ',siteId:' + $("#SiteId").val() + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#AssetId").empty();
                $("#AssetId").append($("<option></option>").val('0').html('Select Asset'));
                $.each(data, function (key, value) {
                    $("#AssetId").append($("<option></option>").val(value.Id).html(value.Name));
                });
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function LoadList() {
        if ($('#AssetTypeId').val() != null && $('#AssetTypeId').val() != undefined && $('#AssetTypeId').val() != '' && $('#AssetTypeId').val() != '0' && $('#AssetId').val() != null && $('#AssetId').val() != undefined && $('#AssetId').val() != '' && parseInt($('#AssetId').val()) > 0) {
            if ($('#AssetTypeId').val() == "@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()") {
                $('#divPointMachinePartial').show();
                $('#area-echart').hide();
                $('#btnPointMachineGraph').show();
                LoadPointMachineEvent();
            } else {
                $('#divPointMachinePartial').hide();
                $('#btnPointMachineGraph').hide();

                $('#area-echart').show();
                LoadPerformanceList();
            }
        }
       
    }

    function LoadPerformanceList() {
        var mPerformanceLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#SiteId').val();
        mSearchCriteria.AssetTypeId = $('#AssetTypeId').val();
        mSearchCriteria.AssetId = $('#AssetId').val();
        mPerformanceLister.SearchCriteria = mSearchCriteria;
        $.ajax({
            url: '/Performance/_PerformanceLister',
            type: 'Post',
            data: JSON.stringify(mPerformanceLister),
            contentType: 'application/json',
            success: function (data) {
                Demochart(data);
            },
            error: function (response) {
                CommonNotification("error", "Something went wrong!");
            }
        });
    }

    function LoadPointMachineGraph() {
        var mPerformanceLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#SiteId').val();
        mSearchCriteria.AssetTypeId = $('#AssetTypeId').val();
        mSearchCriteria.AssetId = $('#AssetId').val();
        mPerformanceLister.SearchCriteria = mSearchCriteria;

        $.ajax({
            url: '/Performance/_PerformanceLister',
            type: 'Post',
            data: JSON.stringify(mPerformanceLister),
            contentType: 'application/json',
            success: function (data) {
                $('#modal-PointMachineGraph').modal("show");

                PointMachineDemochart(data);

            },
            error: function (response) {
                CommonNotification("error", "Something went wrong!");
            }
        });
    }

    function LoadPointMachineEvent() {
        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#SiteId').val();
        mSearchCriteria.AssetTypeId = $('#AssetTypeId').val();
        mSearchCriteria.Id = $('#AssetId').val();
        mAssetLister.SearchCriteria = mSearchCriteria;
        $("#loader").show();
        $.ajax({
            url: '/Performance/_GetPointMachineEvent',
            type: 'Post',
            data: JSON.stringify(mAssetLister),
            contentType: 'application/json',
            success: function (data) {
                //Demochart(data);
                $("#loader").hide();
                $('#divPointMachinePartial').empty().append(data);
            },
            error: function (response) {
                CommonNotification("error", "Something went wrong!");
            }
        });
    }

    function fnDownloadPerformance() {
        if ($("#AssetTypeId").val() != null && $("#AssetTypeId").val() != '' && $("#AssetTypeId").val() != undefined && $("#AssetTypeId").val() != '0' && $("#SiteId").val() != undefined && $("#SiteId").val() != null && $("#SiteId").val() != '' && $("#SiteId").val() != '0') {
            window.location.href = "/Performance/DownloadPerformance?assetTypeId=" + $("#AssetTypeId").val() + "&siteId=" + $("#SiteId").val();
        } else {
            CommonNotification("ERROR", "Please select asset type and site", "Error");
        }
      
        //$("#loader").show();
        //$.ajax({
        //    url: '/Performance/DownloadPerformance',
        //    type: 'Post',
        //    data: '{assetTypeId:' + $("#AssetTypeId").val() + ',siteId:' + $("#SiteId").val() + '}',
        //    contentType: 'application/json',
        //    success: function (data) {
        //        $("#loader").hide();
        //        //$("#AssetId").empty();
        //        //$("#AssetId").append($("<option></option>").val('0').html('Select Asset'));
        //        //$.each(data, function (key, value) {
        //        //    $("#AssetId").append($("<option></option>").val(value.Id).html(value.Name));
        //        //});
        //    },
        //    error: function (response) {
        //        $("#loader").hide();
        //        CommonNotification("ERROR", "Something went wrong!", "Error");
        //    }
        //});
    }

    function Demochart(data) {
        $('#area-echart').removeAttr("_echarts_instance_");

        var DataSeriaes = [];
        var maxV = 0;
        var legends = [];
        var macLeft = 0;
        if (data.AssetAttributes != null && data.AssetAttributes.length > 0) {
            $.each(data.AssetAttributes, function (ids, val) {
                if (ids == 0) {
                    $("#lblType").text(val.AssetTypeName + " :");
                    $("#lblName").text(val.AssetName)
                }
                var xA = [];
                $.each(val.Data, function (i, j) {
                    xA.push(j);
                });

                legends.push(val.Title)
                var attr = {};
                attr.name = val.Title;
                attr.type = 'line';
                attr.notShowSymbol = true;
                attr.sampling = sampling;
                attr.hoverAnimation = false;

                if (val.Title.indexOf('V') > -1) {
                    attr.yAxisIndex = 1;
                }
                else {
                    attr.yAxisIndex = 0;
                }

                if (val.Title == "TPR V" || val.Title == "DG V" || val.Title == "RG V" || val.Title == "HG V" || val.Title == "HHG V" || val.Title == "Tx1 V" || val.Title == "Tx2 V" || val.Title == "Choke V" || val.Title == "Vr") {

                    $.each(val.Data, function (i, j) {
                        var d = parseInt(j);
                        if (d > maxV) {
                            maxV = d;
                        }
                    });
                }
                //  maxV = maxV + 1;
                attr.data = [];
                var values = [];
                $.each(val.Data, function (i, j) {
                    values.push(j);
                });
                var yLeft = Math.max.apply(Math, values); // 3
                if (yLeft >= macLeft) {
                    macLeft = yLeft;
                }

                attr.data = values;
                DataSeriaes.push(attr);
            });
        }

        var xValue = [];
        $.each(data.DateList, function (ids, val) {
            xValue.push(val);
        });

        var chart = echarts.init(document.getElementById('area-echart'));
        var sampling = 'none';

        chart.setOption({
            //title: {
            //    text: 'Rainfall Flow diagram',
            //    x: 'center'
            //},
            tooltip: {
                trigger: 'axis',               
                axisPointer: {
                    animation: true,
                    type: 'line',
                    lineStyle: {
                        color: '#408829',
                        type: 'dashed'
                    },
                    crossStyle: {
                        color: '#408829'
                    },
                    shadowStyle: {
                        color: 'rgba(200,200,200,0.3)'
                    }
                }
            },
            legend: {
                data: legends,
                x: 'center',

            },
            toolbox: {
                show: true,
                feature: {
                    mark: { show: true },
                    dataView: { show: true, readOnly: false },
                    magicType: { show: true, type: ['line', 'bar'] },
                    restore: { show: true },
                    saveAsImage: { show: true }
                }
            },
            xAxis: [
                {
                    type: 'category',
                    boundaryGap: false,
                    axisLine: { onZero: false },
                    interval: 50,
                    //minInterval:1,
                    //  maxInterval: 3600 * 1000 * 24,
                    data: xValue,
                    // min: "00:00",
                    //  max:"11.59"
                }
            ],
            yAxis: [
                {
                    type: 'value',
                    min: 0,
                    max: macLeft
                },
                {
                    type: 'value',
                    inverse: false,
                    min: -1,
                    max: maxV,
                }
            ],
            color: ["#4bacc6", "#215968", "#717171", "#7366ff", "#cc6600", "#90d474", "#4d4d00", "#00e396", "#00ceba", "#f37995"],

            series: DataSeriaes
        });

        window.onresize = chart.resize;
    }

    function PointMachineDemochart(data) {
        if (chart != null && chart != "" && chart != undefined) {
            chart.dispose();
        }
    
        var DataSeriaes = [];
        var maxV = 0;
        var legends = [];
        var macLeft = 0;
        var yAxisArray = [];
        var lary = [];
        var rary = [];
        if (data.AssetAttributes != null && data.AssetAttributes.length > 0) {
            $.each(data.AssetAttributes, function (ids, val) {
                if (ids == 0) {
                    $("#lblType").text(val.AssetTypeName + " :");
                    $("#lblName").text(val.AssetName)
                }
                var xA = [];
                $.each(val.Data, function (i, j) {
                    xA.push(j);
                });

                legends.push(val.Title)
                var attr = {};
                attr.name = val.Title;
                attr.type = 'line';
                attr.notShowSymbol = true;
                attr.sampling = sampling;
                attr.hoverAnimation = false;
                attr.clip = true;
                if (val.Title.indexOf('V') > -1) {
                    var yaxis = {
                        value: val.Title,
                    };
                    rary.push(yaxis)
                    attr.yAxisIndex = 1;
                }
                else {
                    var yaxis = {
                        value: val.Title,
                    };
                    lary.push(yaxis)
                    attr.yAxisIndex = 0;
                }

                if (val.Title == "TPR V" || val.Title == "DG V" || val.Title == "RG V" || val.Title == "HG V" || val.Title == "HHG V" || val.Title == "Tx1 V" || val.Title == "Tx2 V" || val.Title == "Choke V" || val.Title == "Vr" || val.Title == "Voltage") {

                    $.each(val.Data, function (i, j) {
                        var d = parseInt(j);
                        if (d > maxV) {
                            maxV = d;
                        }
                    });
                }
                attr.data = [];
                var values = [];
                $.each(val.Data, function (i, j) {
                    values.push(j);
                });

                if (val.Title != "TPR V" || val.Title != "DG V" || val.Title != "RG V" || val.Title != "HG V" || val.Title != "HHG V" || val.Title != "Tx1 V" || val.Title != "Tx2 V" || val.Title != "Choke V" || val.Title != "Vr" || val.Title != "Voltage") {
                    var yLeft = Math.max.apply(Math, values); // 3
                    if (yLeft >= macLeft) {
                        macLeft = yLeft;
                    }
                }


                attr.connectNulls = true;
                attr.data = values;
                attr.datasetIndex = ids;
                DataSeriaes.push(attr);

            });
        }

        var xValue = [];
        $.each(data.DateList, function (ids, val) {
            xValue.push(val);
        });

        chart = echarts.init(document.getElementById('pointmachine-area-echart'));

        var sampling = 'none';
        chart.setOption({
            tooltip: {
                trigger: 'axis',
                axisPointer: {
                    type: 'cross',
                    label: {
                        backgroundColor: '#6a7985'
                    }
                }
            },
            legend: {
                data: legends,
                x: 'left'

            },
            toolbox: {
                show: true,
                feature: {
                    mark: { show: true },
                    dataView: { show: true, readOnly: false },
                    magicType: { show: true, type: ['line', 'bar'] },
                    restore: { show: true },
                    saveAsImage: { show: true }
                }
            },
            grid: {
                left: '3%',
                right: '4%',
                bottom: '3%',
                containLabel: true
            },
            xAxis: [
                {
                    type: 'category',
                    boundaryGap: false,
                    axisLine: { onZero: false },
                    interval: 50,
                    data: xValue,
                }
            ],
            yAxis: [
                {
                    type: 'value',
                    min: 0,
                    max: macLeft,
                    data: lary
                },
                {
                    type: 'value',
                    inverse: false,
                    min: -1,
                    max: maxV + 1,
                    data: rary
                }
            ],
            color: ["#4bacc6", "#215968", "#717171", "#7366ff", "#cc6600", "#90d474", "#4d4d00", "#00e396", "#00ceba", "#f37995"],

            series: DataSeriaes
        });
        window.onresize = chart.resize;
    }

</script>
