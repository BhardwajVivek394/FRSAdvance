    <!-- App css-->
    @*<link rel="stylesheet" type="text/css" href="~/assets/css/style.css">*@
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/style-new.css")">
    <link id="color" rel="stylesheet" href="@Url.Content("~/assets/css/color-1.css")" media="screen">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/responsive.css")">
    <link href="@Url.Content("~/assets/js/jquery-ui/jquery-ui.css")" rel="stylesheet" />
    <link href="@Url.Content("~/assets/css/vendors/select2.css")" rel="stylesheet" />
    <style>
        .card-header {
            padding: 15px !important;
        }

        td, th {
            vertical-align: middle;
        }

        .btn {
            padding: .375rem .75rem !important
        }

        .nav-quirk > li.nav-parent > a:after {
            content: '\f107';
            font-family: 'FontAwesome';
            font-size: 16px;
            font-weight: 400;
            color: #bdc3d1;
            position: absolute;
            top: 10px;
            right: 15px;
        }

        .overlay {
            height: 100%;
            width: 100%;
            position: fixed;
            z-index: 999999999999999999999999999999999;
            top: 0;
            left: 0;
            /*background-color: rgb(0,0,0);
                      background-color: rgba(176, 176, 176, 0.9);*/
            overflow-x: hidden;
            transition: 0.5s;
        }

        .overlay-content {
            position: relative;
            top: 35%;
            width: 100%;
            text-align: center;
            margin-top: 30px;
        }

        .headerpanel {
            z-index: 200;
        }

        #loader {
            position: fixed;
            z-index: 9999999;
            left: 50%;
            top: 50%;
            transform: translate(-50%,-50%);
            display: none
        }

        .active1 {
            background-color: #dad6ff !important;
        }

        .width60 {
            width: 50px !important;
        }

        .simplebar-content-wrapper {
            margin-top: 30px;
        }

        .table-hover > tbody > tr:hover {
            background-color: #dad6ff !important;
        }

        .alert-error {
            background-color: RGB(242, 57, 13,0.9);
            color: white;
        }

        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            padding: 4px 4px !important;
            margin-top: 5px !important;
            background-color: #9c93f7 !important;
            border-color: #9c93f7 !important;
            color: #fff;
            margin-right: 6px !important;
        }

        [data-simplebar1] {
            position: relative;
            flex-direction: column;
            flex-wrap: wrap;
            justify-content: flex-start;
            align-content: flex-start;
            align-items: flex-start;
        }

        .simplebar-track1 {
            z-index: 1;
            position: absolute;
            right: 0;
            bottom: 0;
            pointer-events: none;
            overflow: hidden;
        }

            .simplebar-track1.simplebar-vertical1 {
                top: 0;
                width: 11px;
            }

                .simplebar-track1.simplebar-vertical1 .simplebar-scrollbar1:before {
                    top: 2px;
                    bottom: 2px;
                }

        .simplebar-scrollbar1 {
            position: absolute;
            left: 0;
            right: 0;
            min-height: 10px;
        }

            .simplebar-scrollbar1:before {
                position: absolute;
                content: "";
                background: black;
                border-radius: 7px;
                left: 2px;
                right: 2px;
                opacity: 0;
                transition: opacity 0.2s linear;
            }

        @@media (max-width: 1367px) {
            .headerText {
                display: none;
            }
        }
    </style>
    <link href="@Url.Content("~/Content/Custom.css")" rel="stylesheet" />
</head>
<body>
    <div class="loader-box" id="loader">
        <img src="~/Content/images/load-new.gif" height="100" />

        @*<div class="loader-3">
            </div>*@
    </div>

    <div class="tap-top"><i data-feather="chevrons-up"></i></div>
    <!-- tap on tap ends-->
    <!-- page-wrapper Start-->
    <div class="page-wrapper compact-wrapper" id="pageWrapper">
        <!-- Page Header Start-->
        <div class="page-header">
            <div class="header-wrapper row m-0">

                <div class="header-logo-wrapper col-auto p-0">
                    <div class="logo-wrapper">
                        <a href="/site/index">
                            <img class="img-fluid" src="@Url.Content("~/assets/images/logo_black.png")" alt="">
                        </a>
                    </div>
                    <div class="toggle-sidebar"><i class="status_toggle middle sidebar-toggle" data-feather="align-center"></i></div>
                </div>
                <div class="left-header col horizontal-wrapper ps-0">
                    <div class="toggle-sidebar" style="display:block;left:-20px;top:5px;width:30px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-grid status_toggle middle sidebar-toggle">
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7">
                            </rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                        </svg>
                    </div>
                    <div class="row m-l-10 headerText">
                        <div class="col-auto">
                            <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #4bacc6; border-radius: 10px;">Remote Diagnostic </a>
                        </div>
                        <div class="col-auto">
                            <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #215968; border-radius: 10px; margin-left: -15px; ">And</a>
                        </div>
                        <div class="col-auto">
                            <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #4bacc6; border-radius: 10px; margin-left: -15px; ">Predictive Maintenance System </a>
                        </div>
                    </div>
                    @*<ul class="horizontal-menu">
                            <li class="mega-menu outside m-l-10">
                                <a class="nav-link text-white" style="font-size:16px;font-weight:500;background:#4bacc6;">Remote Diagnostic </a>
                            </li>
                            <li class="mega-menu outside m-l-0">
                                <a class="nav-link text-white" style="font-size:16px;font-weight:500;background:#215968">And</a>
                            </li>
                            <li class="mega-menu outside m-l-0">
                                <a class="nav-link text-white" style="font-size:16px;font-weight:500;background:#4bacc6">Predictive Maintenance System </a>
                            </li>
                        </ul>*@
                </div>
                <div class="nav-right col-5 pull-right  right-header p-0">
                    <ul class="nav-menus">
                        @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == (int)E7FRSAdvance.Utility.Utility.Role.Admin || E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping)
                        {
                            <li class="onhover-dropdown">
                                <select class="form-control" onchange="fnOnChangeAnnexure(this)">
                                    @{

                                        var enumlist = (from E7FRSAdvance.Utility.Utility.Annexure e in Enum.GetValues(typeof(E7FRSAdvance.Utility.Utility.Annexure))
                                                        select new
                                                        {
                                                            Id = (int)e,
                                                            Name = e.ToString().Replace("_", " ")
                                                        }).ToList();

                                    }

                                    @foreach (var item in enumlist)
                                    {
                                        if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.AnnexureId.HasValue && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.AnnexureId == item.Id)
                                        {
                                            <option value="@item.Id" selected>@item.Name</option>
                                        }
                                        else
                                        {
                                            <option value="@item.Id">@item.Name</option>
                                        }

                                    }
                                </select>
                            </li>
                        }


                        <li class="maximize"><a style="color:white" href="#!" onclick="javascript:toggleFullScreen()"><i class="fa fa-square-o"></i></a></li>
                        <li class="onhover-dropdown p-0 me-0">
                            <!--profile-nav class removed-->
                            <div class="media profile-media">
                                <i class="fa fa-user" style="margin-top:9px;"></i>
                                <div class="" style=" margin-left: 9px;">
                                    <!--media-body class -->
                                    <span>  Welcome, @E7FRSAdvance.Utility.ClsHttpContent.LoginUser.FirstName </span>
                                    <p class="mb-0 font-roboto" style="line-height: 0; letter-spacing: 0.7px;">@E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleName <i class="middle fa fa-angle-down"></i></p>
                                </div>
                            </div>
                            <ul class="profile-dropdown onhover-show-div" style="width:205px;">
                                <li><a href="@Url.Action("MyProfile","User")"><i data-feather="user"></i><span>My Profile </span></a></li>
                                <li><a href="@Url.Action("ChangePassword","User")"><i data-feather="lock"></i><span>Change Password</span></a></li>
                                <li><a href="@Url.Action("Index", "Login", new {Area=""})"><i data-feather="sign-out"></i><span>Log out</span></a></li>
                            </ul>
                        </li>
                    </ul>
                </div>

            </div>
        </div>
        <!-- Page Header Ends                              -->
        <!-- Page Body Start-->
        <div class="page-body-wrapper">
            <!-- Page Sidebar Start-->
            <div class="sidebar-wrapper">
                <div>
                    <div class="logo-wrapper" style="padding:5px 5px;text-align:left;">
                        <a href="/site/index">
                            <img class="img-fluid for-light" src="@Url.Content("~/assets/images/logo_black.png")" style="width:268px;height:115px;border-radius:10px;">
                            @*<img class="img-fluid for-dark" src="@Url.Content("~/assets/images/Logo.jpeg")" style="max-width:100%;" alt="">*@
                        </a>
                        <div class="back-btn"><i class="fa fa-angle-left"></i></div>
                        @*<div class="toggle-sidebar" style="right:15px;top:50px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-grid status_toggle middle sidebar-toggle">
                                    <rect x="3" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="3" width="7" height="7"></rect>
                                    <rect x="14" y="14" width="7" height="7">
                                    </rect>
                                    <rect x="3" y="14" width="7" height="7"></rect>
                                </svg>
                            </div>*@
                    </div>
                    <div class="logo-icon-wrapper" style="padding:15px 5px;height:80px;width:90px;">
                        <a href="/site/index" data-bs-original-title="" title="">
                            <img class="img-fluid" src="@Url.Content("~/assets/images/logo_black.png")" style="max-width:100%;border-radius:6px;">
                        </a>
                    </div>
                    <nav class="sidebar-main">
                        <div class="left-arrow" id="left-arrow"><i data-feather="arrow-left"></i></div>
                        <div id="sidebar-menu m-t-2">
                            <ul class="sidebar-links" id="simple-bar">
                                <li class='sidebar-list'></li>
                                @{ foreach (var menu in E7FRSAdvance.Utility.ClsHttpContent.Menus)
                                    {
                                        if (menu.Childs.Count() == 0)
                                        {
                                            <li class='sidebar-list @(ViewBag.Title == menu.Main.MenuName ? "active" : " ")'>
                                                <a class="sidebar-link sidebar-title link-nav @(ViewBag.Title == menu.Main.MenuName ? "active1" : " ")" href="@Url.Content("~/"+menu.Main.ControllerName+"/"+menu.Main.ActionName+"")">
                                                    <i class="@menu.Main.IconName"></i>
                                                    <span class="p-l-5"> @menu.Main.MenuName</span>
                                                    @if (menu.Main.MenuName == "Maintenance Report")
                                                    {
                                                        <span class="badge badge-success f-12 pull-right" id="divMenuMaintenanceReport" style="position:unset">0</span>
                                                    }
                                                </a>
                                            </li>
                                        }
                                        else
                                        {
                                            int i = 0;
                                            string activeClass = "";
                                            foreach (var item in menu.Childs)
                                            {
                                                if (item.MenuName.Contains(ViewBag.Title))
                                                {
                                                    activeClass = "active";
                                                }
                                            }

                                            <li class="sidebar-list @activeClass">
                                                <a class="sidebar-link sidebar-title"><i class="@menu.Main.IconName"></i> <span>@menu.Main.MenuName</span></a>
                                                <ul class="sidebar-submenu">
                                                    @foreach (var child in menu.Childs)
                                                    {
                                                        <li class="@(ViewBag.Title == child.MenuName?"active":"&nbsp;")">
                                                            <a href="@Url.Content("~/"+child.ControllerName+"/"+child.ActionName+"")">
                                                                <span> @child.MenuName</span>
                                                                @if (child.MenuName == "Maintenance Report")
                                                                {
                                                                    <span class="badge badge-success f-12 pull-right" id="divMenuMaintenanceReport" style="position:unset">0</span>
                                                                }
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </li>
                                            i++;
                                        }
                                    }
                                }
                                <div class="simplebar1-track1 simplebar1-vertical1" style="visibility: visible;">
                                    <div class="simplebar1-scrollbar1" style="height: 99px; transform: translate3d(0px, 387px, 0px); display: block;"></div>
                                </div>
                            </ul>
                        </div>
                        <div class="right-arrow" id="right-arrow"><i data-feather="arrow-right"></i></div>
                    </nav>
                </div>
            </div>
            <!-- Page Sidebar Ends-->
            <div class="page-body">
                @RenderBody()
            </div>
            <!-- footer start-->
            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12 footer-copyright text-center">
                            <p class="mb-0">Energy7 Terms and Conditions | Copyright © 2021 | Version 3.2</p>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/assets/js/jquery-3.5.1.min.js"></script>
    <!-- Bootstrap js-->
    <script src="~/assets/js/bootstrap/bootstrap.bundle.min.js"></script>
    <!-- feather icon js-->
    <script src="~/assets/js/icons/feather-icon/feather.min.js"></script>
    <script src="~/assets/js/icons/feather-icon/feather-icon.js"></script>
    <script src="~/assets/js/chart/apex-chart/apex-chart.js"></script>
    <!-- scrollbar js-->
    <script src="~/assets/js/scrollbar/simplebar.js"></script>
    <script src="~/assets/js/scrollbar/custom.js"></script>

    <!-- Sidebar jquery-->
    <script src="~/assets/js/config.js"></script>
    <script src="~/Content/lib/jquery-maskedinput/jquery.maskedinput.js"></script>
    <!-- Plugins JS start-->
    <script src="~/assets/js/jquery-confirm/jquery-confirm.min.js"></script>
    <script src="~/assets/js/sidebar-menu.js"></script>
    <script src="~/assets/js/datepicker/date-picker/datepicker.js"></script>
    <script src="~/assets/js/datepicker/date-picker/datepicker.en.js"></script>
    <script src="~/assets/js/datepicker/date-picker/datepicker.custom.js"></script>
    <script src="~/assets/js/time-picker/jquery-clockpicker.min.js"></script>
    <script src="~/assets/js/time-picker/clockpicker.js"></script>
    <script src="~/assets/js/datepicker/daterange-picker/moment.min.js"></script>
    <script src="~/assets/js/datepicker/daterange-picker/daterangepicker.js"></script>
    <script src="~/assets/js/counter/jquery.waypoints.min.js"></script>
    <script src="~/assets/js/counter/jquery.counterup.min.js"></script>
    <script src="~/assets/js/counter/counter-custom.js"></script>
    <script src="~/assets/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="~/assets/js/notify/bootstrap-notify.min.js"></script>
    <script src="~/assets/js/notify/notify-script.js"></script>
    <script src="~/assets/js/popover-custom.js"></script>

    <script src="~/assets/js/tooltip-init.js"></script>
    <script src="~/assets/js/select2/select2.full.min.js"></script>
    <script src="~/assets/js/select2/select2-custom.js"></script>
    <script src="~/assets/js/script.js"></script>
    <script src="~/assets/js/jquery-ui/jquery-ui.js"></script>
    <script src="~/assets/js/html2canvas.js"></script>
    <script src="~/assets/js/chart/chartist/chartist.js"></script>
    <script src="~/assets/js/chart/chartist/chartist-plugin-tooltip.js"></script>
    @*<script src="~/assets/js/chart/morris-chart/morris-script.js"></script>*@

    <script>
        setInterval(function () {

            MakeMeLive();

        }, 10000);


        $('.modal-dialog').draggable({
            handle: ".modal-header"
        });

         function MakeMeLive() {
            $.ajax({
                type: "POST",
                url: '@Url.Content("~/User/MakeSessionLive")',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: true,
                success: function (response) {
                  if (response.Result == "Forbidden") {
                        window.location.href = '@Url.Content("~/Login/Index")';
                    }
                },
                error: function (response) {
                }
            });
        }

        function CommonNotification(type, message) {
            if (type == "error") {
                type = "danger";
            }

            var notify = $.notify(message,
                {
                    type: type.toLowerCase(),
                    allow_dismiss: true,
                    delay: 2000,
                    showProgressbar: true,
                    timer: 300,
                    animate: {
                        enter: 'animated fadeInDown',
                        exit: 'animated fadeOutUp'
                    }
                });
        }

        function fnOnChangeAnnexure($this) {
            if ($($this).val() != null && $($this).val() != undefined && $($this).val() != '' && $($this).val() != "0") {
                window.location.href = '@Url.Action("LoginWithAnnexure", "Login", new { area = "" })' + '?annexureId=' + $($this).val();

            }
        }

        function fnBindAlertCount() {

            var mFRSAlertLister = {};
            var mSearchCriteria = {};
            mSearchCriteria.AlertStatus = 2;

            mFRSAlertLister.SearchCriteria = mSearchCriteria;

            $.ajax({
                url: '/Home/GetActiveAlertCount',
                type: 'Post',
                contentType: 'application/json',
                data: JSON.stringify(mFRSAlertLister),
                success: function (data) {
                    $('#divMenuMaintenanceReport').text(data);
                },
                error: function (response) {
                    //CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });

        }

    </script>
</body>
</html>