@model List<Domain.DivisionImportantLink>

<style>

    .card-imp-container {
        width: 300px;
        height: 430px;
        background: #FFF;
        border-radius: 6px;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        box-shadow: 0px 1px 10px 1px #000;
        overflow: hidden;
        display: inline-block;
    }

    .card-imp-header {
        height: 150px;
        background: #08495e;
    }

    .image-container {
        background: white;
        width: 80px;
        height: 80px;
        border-radius: 50%;
        /*padding: 5px;*/
        transform: translate(110px,100px);
        border: 1px groove;
    }

        .image-container img {
            width: 80px;
            height: 80px;
            border-radius: 50%;
        }

    .card-imp-body {
        height: 290px;
        background: #FFF;
        padding: 20px;
        padding-top: 40px;
        text-align: center;
    }

        .card-imp-body h3 {
            box-sizing: border-box;
            line-height: .6;
            font-weight: lighter;
            font-family: arial;
            margin: 15px 5px;
        }

        .card-imp-body .btn {
            padding: 12px 20px;
            border: 1px solid;
            border-color: #08495e;
            color: black;
            font-size: 12px;
            text-decoration: none;
            font-weight: bold;
            transition: all .3s ease-in;
            font-family: arial;
            display: inline-block;
            margin: 5px 5px;
        }

            .card-imp-body .btn:hover {
                background: #08495e;
                color: #FFF;
                border: 1px solid #08495e;
            }
    .btn-outline-danger:hover, .btn-outline-danger:focus, .btn-outline-danger:active, .btn-outline-danger.active {
        color: white !important;
        background-color: #08495e !important;
        border-color: #08495e !important;
    }
</style>
<div class="modal bounceIn animated" id="modal-IMP" tabindex="-1" aria-labelledby="modal-IMP" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content bradius4">
            <div class="card-imp-container">
                <div class="card-imp-header">
                    <div class="image-container">
                        <img src="~/assets/images/link_img.png" />
                    </div>
                </div>
                <div class="card-imp-body">
                    <div>
                        <h3>Important Link</h3>
                    </div>
                    <div class="d-grid ">
                        @if (Model != null && Model.Count > 0)
                        {
                            int i = 0;
                            foreach (var adc in Model)
                            {
                                <a class="btn btn-lg btn-outline-danger" href="@adc.Link" target="_blank">
                                    <span class="pull-left">@adc.Name</span><i class="fa fa-arrow-right pull-right" aria-hidden="true"></i>
                                </a>
                            }
                        }
                     
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


