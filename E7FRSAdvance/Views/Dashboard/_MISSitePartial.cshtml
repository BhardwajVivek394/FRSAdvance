@model Domain.Site
<style>
    .cardMISPartialheader {
        background-color: #08495e !important;
        color: white !important;
        padding: 30px;
        border-bottom: 1px solid #ecf3fa;
        /* border-top-left-radius: 15px;
        border-top-right-radius: 15px;*/
        position: relative;
    }
</style>

<div class="card">
    <div class="card-header cardMISPartialheader">
        <div class="text-center">
            <h5 style="text-align: center;">
                MIS
            </h5>
        </div>
    </div>
    <div class="card-body" style="padding: 0px !important; border: 1px solid #08495e;height:260px">
        <div class="people-options clearfix p-t-10">
            <div class="pull-left">
                <a href="@System.Configuration.ConfigurationManager.AppSettings.Get("MISBaseUrl")/SitePDF?siteId=@Model.Id" class="btn btn-primary m-l-10" style="font-size: medium;" target="_blank">Design and Drawings</a>
            </div>
            <div class="pull-right">
                <a href="@System.Configuration.ConfigurationManager.AppSettings.Get("MISBaseUrl")/CodalLife?siteId=@Model.Id" class="btn btn-primary m-r-10" style="font-size: medium;" target="_blank">Codal Life</a>
            </div>
        </div>
        <div class="people-options clearfix">

            <div class="text-center">
                <img id="imgSite_@Model.Id" src="~/assets/images/imgGreen.png" height="100" width="100" />
            </div>
            <div class="text-center mt-3">
                @if (Model.TrackCount > 0)
                {
                    <span class="span notification-badge"><a href="javascript:void(0)" style="color:white;" onclick="fnGetSiteSummaryView('@Model.Name','@E7FRSAdvance.Utility.Utility.AssetType.TRACK.GetHashCode()')">T: @Model.TrackCount </a></span>
                }
                @if (Model.PointMachineCount > 0)
                {
                    <span class="span notification-badge"><a href="javascript:void(0)" style="color:white;" onclick="fnGetSiteSummaryView('@Model.Name','@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()')">P: @Model.PointMachineCount </a></span>
                }
                @if (Model.SignalCount > 0)
                {
                    <span class="span notification-badge"><a href="javascript:void(0)" style="color:white;" onclick="fnGetSiteSummaryView('@Model.Name','@E7FRSAdvance.Utility.Utility.AssetType.SIGNAL.GetHashCode()')">S: @Model.SignalCount </a></span>
                }
            </div>
        </div>
        <div class="people-options clearfix text-center">
            <a href="@System.Configuration.ConfigurationManager.AppSettings.Get("MISBaseUrl")/UserSite/GetRosterACKData?siteId=@Model.Id" class="btn btn-warning" target="_blank" style="font-size: medium;">Roster ACK</a>
            <a href="@System.Configuration.ConfigurationManager.AppSettings.Get("MISBaseUrl")/Site/SiteAssetData?siteId=@Model.Id" class="btn btn-primary" target="_blank" style="font-size: medium;">Data Entry</a>
            <a href="@System.Configuration.ConfigurationManager.AppSettings.Get("MISBaseUrl")/UserSite/AssetInfo?siteId=@Model.Id" class="btn btn-warning" target="_blank" style="font-size: medium;">Asset Info</a>

            
        </div>
    </div>

</div>
