@model Domain.SMSLogLister
@{
    List<string> types = new List<string>();
}
<table class="table">
    <thead>
        <tr>
            <th>Station</th>
            @if (Model != null && Model.mSMSLogs != null && Model.mSMSLogs.Count > 0)
            {
                foreach (var item in Model.mSMSLogs.GroupBy(x => x.AssetTypeName).ToList())
                {
                    types.Add(item.Key);
                    <th>@item.Key</th>

                }
            }

        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.mSMSLogs != null && Model.mSMSLogs.Count > 0)
        {
            foreach (var item in Model.mSMSLogs.GroupBy(x => x.SiteName).ToList())
            {
                <tr>
                    <td>@item.Key</td>
                    @foreach (var type in types)
                    {
                        var smsCount = Model.mSMSLogs.Where(x => x.AssetTypeName == type && x.SiteName == item.Key).Count();
                        <td>@smsCount</td>
                    }

                </tr>
            }

        }

    </tbody>
</table>
