@model Domain.Site
@{
    ViewBag.Title = "Index";
    Layout = null;
}

<html>
<head>
    <link href="https://fonts.googleapis.com/css?family=Rubik:400,400i,500,500i,700,700i&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,300i,400,400i,500,500i,700,700i,900&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/font-awesome.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/vendors/icofont.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/vendors/themify.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/vendors/flag-icon.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/vendors/feather-icon.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/vendors/scrollbar.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/vendors/photoswipe.css")">
    <link href="~/assets/js/jquery-confirm/jquery-confirm.min.css" rel="stylesheet" />
    <link href="~/assets/css/vendors/daterange-picker.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/vendors/date-picker.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/vendors/timepicker.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/vendors/bootstrap.css")">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/style-new.css")">
    <link id="color" rel="stylesheet" href="@Url.Content("~/assets/css/color-1.css")" media="screen">
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/responsive.css")">
    <link href="@Url.Content("~/assets/js/jquery-ui/jquery-ui.css")" rel="stylesheet" />
    <link href="@Url.Content("~/assets/css/vendors/select2.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Custom.css")" rel="stylesheet" />

    @*Division View*@
    <link href="~/assets/sip/css/rappid.css" rel="stylesheet" />
    <link href="~/assets/sip/css/theme-picker.css" rel="stylesheet" />
    <link href="~/assets/sip/css/style.dark.css" rel="stylesheet" />
    <link href="~/assets/sip/css/style.material.css" rel="stylesheet" />
    <link href="~/assets/sip/css/style.modern.css" rel="stylesheet" />
    <link href="~/assets/sip/css/diagram.css" rel="stylesheet" />
    <style>
        .div-fixed-height {
            height: 400px;
            overflow-y: auto;
        }

        .card .card-header {
            background-color: #08495e !important;
            color: white !important;
        }

        #loader {
            position: fixed;
            z-index: 9999999;
            left: 50%;
            top: 50%;
            transform: translate(-50%,-50%);
            display: none
        }

        .chatbotImp:hover {
            transform: scale(1.1);
        }
        /*   dl {
            display: inline-block;
        }*/
        .page-wrapper.compact-wrapper .page-header {
            margin-left: 0px !important;
            width: 100% !important;
        }

        .fa-arrow-left {
            color: white;
            font-size: 20px !important;
        }

        .fa-arrow-right {
            color: white;
            font-size: 20px !important;
        }

        .bullets {
        }

            .bullets li {
                list-style-type: circle;
            }

        .joint-toolbar {
            background-color: #08495e !important;
            border: none !important;
        }

        .joint-widget {
            border: none !important;
        }

        .joint-theme-picker {
            position: unset !important;
        }
    </style>
</head>
<body>
    <div class="loader-box" id="loader">
        <img src="~/Content/images/load-new.gif" height="100" />

        @*<div class="loader-3">
            </div>*@
    </div>
    <input type="hidden" id="hdnSearchDivisionId" value="@Model.DivisionId" />
    <div class="page-wrapper compact-wrapper" id="pageWrapper">
        <div class="page-header">
            <div class="header-wrapper row m-0">
                <div class="left-header col horizontal-wrapper ps-0">
                    <div class="row m-l-10">
                        <div class="col-auto">
                            <a href="@Url.Action("Index","Division")">
                                <img src="~/assets/images/back-arrow.png" style="height:40px;margin-top:1px;" />
                            </a>
                        </div>
                        <div class="col-auto">
                            <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #4bacc6; border-radius: 10px;">Energy7  </a>
                        </div>
                        <div class="col-auto">
                            <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #215968; border-radius: 10px; margin-left: -15px; ">RDPMS/MIS </a>
                        </div>
                        <div class="col-auto">
                            <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #4bacc6; border-radius: 10px; margin-left: -15px; ">Console </a>
                        </div>
                    </div>
                </div>
                <div class="nav-right col-4 pull-right right-header p-0">
                    <div class="row">
                        <div class="col-xl-4 col-lg-4"></div>
                        <div class="col-xl-4 col-lg-4">
                            @Html.DropDownList("ZoneId", (IEnumerable<SelectListItem>)ViewBag.Zones, new { @class = "form-control mt-2", tabindex = 1 })
                        </div>
                        <div class="col-xl-4 col-lg-4">
                            @Html.DropDownList("DivisionId", (IEnumerable<SelectListItem>)ViewBag.Divisions, new { @class = "form-control mt-2", tabindex = 1 })
                        </div>
                    </div>

                </div>

            </div>
        </div>


        <div class="page-body-wrapper" style="margin-top:100px;">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-xxl-3">
                        <div class="row">
                            <div class="col-12 notification box-col-6">

                                <div id="SiteAlert" class="carousel slide" data-bs-ride="carousel">
                                    <div class="carousel-inner">
                                        <div class="carousel-item active">
                                            <div class="card height-equal">
                                                <div class="card-header card-no-border">
                                                    <div class="header-top">
                                                        <h5 class="m-0">Site v/s Alerts</h5>
                                                        <div class="card-header-right-icon">
                                                            <a class="siteAlertLeftArrow">
                                                                <i class="fa fa-arrow-left"></i>
                                                            </a>
                                                            <a class="siteAlertRightArrow m-l-10">
                                                                <i class="fa fa-arrow-right"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-body pt-0">
                                                    <div id="site-alert-graph">
                                                        <img src="~/assets/images/loader.gif" height="70" width="70" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="carousel-item">
                                            <div class="card height-equal">
                                                <div class="card-header card-no-border">
                                                    <div class="header-top">
                                                        <h5 class="m-0">Site v/s Predictive Alert</h5>
                                                        <div class="card-header-right-icon">
                                                            <a class="siteAlertLeftArrow">
                                                                <i class="fa fa-arrow-left"></i>
                                                            </a>
                                                            <a class="siteAlertRightArrow m-l-10">
                                                                <i class="fa fa-arrow-right"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-body pt-0">
                                                    <div id="site-predictive-alert-graph">
                                                        <img src="~/assets/images/loader.gif" height="70" width="70" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>


                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header card-no-border">
                                        <div class="header-top">
                                            <h5>Attribute at glance</h5>
                                            <a class="f-light d-flex align-items-center" href="javascript:void(0)" onclick="fnShowAttributeGlance()"><i class="f-w-700 fa fa-search text-white"></i></a>

                                            <a class="f-light d-flex align-items-center" href="javascript:void(0)" onclick="fnShowAttributeGlanceFullScreen()"><i class="f-w-700 fa fa-expand text-white"></i></a>
                                        </div>
                                    </div>
                                    <div class="card-body pt-0">
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div id="attributeGlanceEchart">
                                                    <img src="~/assets/images/loader.gif" height="70" width="70" />
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div id="ac_attributeGlanceEchart">
                                                </div>

                                            </div>
                                            <div class="col-md-12">
                                                <div id="bc_attributeGlanceEchart">
                                                </div>
                                            </div>
                                            <div class="col-md-12">
                                                <div class="carousel slide" data-bs-ride="carousel">
                                                    <div class="carousel-inner" id="CarouselAttributeGlanceEchart">

                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    <div class="col-xxl-7">
                        <div class="row">
                            <div class="col-12 appointment-sec box-col-6">
                                <div class="appointment">
                                    <div class="card">
                                        <div class="card-header card-no-border">
                                            <div>
                                                <div class="row">
                                                    <div class="col-xl-7">
                                                        <h5 class="text-left">Map</h5>
                                                    </div>
                                                    <div class="col-xl-1">
                                                        <a class="f-light d-flex align-items-center" href="javascript:void(0)" onclick="fnShowMapExpand()"><i class="f-w-700 fa fa-expand text-white"></i></a>
                                                    </div>
                                                    <div class="col-xl-4">
                                                        <div class="toolbar-container">
                                                        </div>
                                                    </div>
                                                </div>


                                            </div>
                                        </div>
                                        <div class="card-body pt-0" style="height:600px">
                                            <div id="app">
                                                <div class="app-body">
                                                    <div class="stencil-container" style="display:none"></div>
                                                    <div class="paper-container" style="left:0px;right:0"></div>
                                                    <div class="inspector-container" style="display:none"></div>
                                                    <div class="navigator-container" style="display:none"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-xxl-6">
                                <div class="card papernote-wrap">
                                    <div class="card-header card-no-border">
                                        <div class="header-top">
                                            <h5>MIS Summary</h5><a class="f-light d-flex align-items-center" href="javascript:void(0)" onclick="fnShowExpand('MIS Summary','divMISSummary')"><i class="f-w-700 fa fa-expand text-white"></i></a>
                                        </div>
                                    </div>
                                    <div class="card-body pt-0">
                                        <div id="divMISSummary" class="table-responsive div-fixed-height">
                                            <img src="~/assets/images/loader.gif" height="70" width="70" />
                                        </div>


                                    </div>
                                </div>
                            </div>

                            <div class="col-xxl-6">
                                <div id="alertCarousel" class="carousel slide" data-bs-ride="carousel">
                                    <div class="carousel-inner">
                                        <div class="carousel-item active">
                                            <div class="card papernote-wrap">
                                                <div class="card-header card-no-border">
                                                    <div class="row">
                                                        <div class="col-9">
                                                            <h5>Alert Counts</h5>
                                                        </div>
                                                        <div class="col-1">
                                                            <a class="f-light d-flex align-items-center" href="javascript:void(0)" onclick="fnShowExpand('Alert Counts','divAlertCounts')"><i class="f-w-700 fa fa-expand text-white"></i></a>
                                                        </div>
                                                        <div class="col-1">
                                                            <a class="alertLeftArrow">
                                                                <i class="fa fa-arrow-left"></i>
                                                            </a>
                                                        </div>
                                                        <div class="col-1">
                                                            <a class="alertRightArrow">
                                                                <i class="fa fa-arrow-right"></i>
                                                            </a>
                                                        </div>




                                                    </div>
                                                </div>
                                                <div class="card-body pt-0">
                                                    <div id="divAlertCounts" class="table-responsive div-fixed-height">
                                                        <img src="~/assets/images/loader.gif" height="70" width="70" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="carousel-item">
                                            <div class="card papernote-wrap">
                                                <div class="card-header card-no-border">
                                                    <div class="row">
                                                        <div class="col-9">
                                                            <h5>Asset Counts</h5>
                                                        </div>
                                                        <div class="col-1">
                                                            <a class="f-light d-flex align-items-center" href="javascript:void(0)" onclick="fnShowExpand('Asset Counts','divAssetCounts')"><i class="f-w-700 fa fa-expand text-white"></i></a>
                                                        </div>
                                                        <div class="col-1">
                                                            <a class="alertLeftArrow">
                                                                <i class="fa fa-arrow-left"></i>
                                                            </a>
                                                        </div>
                                                        <div class="col-1">
                                                            <a class="alertRightArrow">
                                                                <i class="fa fa-arrow-right"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-body pt-0">
                                                    <div id="divAssetCounts" class="table-responsive div-fixed-height">
                                                        <img src="~/assets/images/loader.gif" height="70" width="70" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xxl-2">
                        <div class="row">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header card-no-border">
                                        <div class="header-top" style="padding-right:28px;padding-left:28px">
                                            <div class="row">
                                                <div class="col-12 text-center">
                                                    <h5 class="m-0">Number of alerts </h5>
                                                </div>
                                                <div class="col-12 mt-1">
                                                    <h5 class="m-0"> </h5>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-body text-center">
                                        <div class="row">
                                            <div class="col-12">
                                                <select class="form-control" id="drpSelectAlertCount" onchange="fnGetAlertCount()"><option value="Day">Current Day</option><option value="Week">Week</option><option value="Month">Month</option><option value="3Month">3 Month</option></select>
                                            </div>
                                            <div class="col-12 mt-3">
                                                <a href="javascript:void(0)" onclick="fnGetAlertList()">
                                                    <h3 id="monthAlertCount" style="color: #08495e !important">0</h3>
                                                </a>
                                            </div>
                                        </div>



                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header card-no-border">
                                        <div class="header-top">
                                            <h5 class="m-0">Summary of Today</h5>
                                        </div>
                                    </div>
                                    <div class="card-body pt-0" style="height: 450px;">
                                        <div class="row">
                                            <marquee class="col-12" width="60%" height="450px" direction="up" id="divSummaryofToday" behavior="scroll" scrollamount="3" onmouseover="this.stop();" onmouseout="this.start();">

                                            </marquee>
                                            @*<div class="col-12" id="divSummaryofToday">

                                                </div>*@

                                        </div>

                                    </div>
                                </div>
                            </div>


                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header card-no-border">
                                        <div class="header-top">
                                            <img class="img-fluid for-light" src="~/assets/images/logo_black.png" style="width:268px;height:115px;border-radius:10px;">
                                        </div>
                                    </div>

                                    <div class="card-body">
                                        <div class="row">

                                            <div class="col-6">
                                                <a onclick="fnShowImp()">
                                                    <img src="~/assets/images/imp.png" height="80" width="80" />
                                                    <p style="font-size:12px">Important link</p>
                                                </a>
                                            </div>

                                            <div class="col-6">
                                                <a onclick="fnShowChatBot()">
                                                    <img src="~/assets/images/chats.png" height="80" width="80" />
                                                    <p style="font-size:12px;margin-left:16px">ChatBot</p>
                                                </a>
                                            </div>

                                        </div>
                                    </div>



                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
    <div id="divAlertList"></div>
    <div id="divChatBot"></div>
    <div id="divImpList"></div>
    <div id="divUserSiteMISSitePartial"></div>

    <div class="modal bounceIn animated" id="modalExpand" tabindex="-1" role="dialog" data-bs-backdrop="static">
        <div class="modal-dialog modal-width modal-dialog-centered modal-lg">
            <div class="modal-content bradius4">
                <div class="modal-header">
                    <h4 class="modal-title" id="myModalLabel"><span id="spExpandHeader"></span></h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                </div>
                <div class="modal-body">
                    <div id="divExpand">

                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal bounceIn animated" id="modalSearchAttributeGlance" tabindex="-1" role="dialog" data-bs-backdrop="static">
        <div class="modal-dialog modal-width modal-dialog-centered">
            <div class="modal-content bradius4">
                <div class="modal-header">
                    <h4 class="modal-title" id="myModalLabel"><span>Search Attribute Glance</span></h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            <label>Gear</label>
                            @*@Html.DropDownList("drpSearchAssetTypeId", (IEnumerable<SelectListItem>)ViewBag.AssetTypes, "Select", new { @class = "form-control", tabindex = 1 })*@
                            <select id="drpSearchAssetTypeId" name="drpSearchAssetTypeId" class="form-control">
                                <option value="">Select</option>
                                <option value="1">TRACK</option>
                                <option value="2">SIGNAL</option>
                                <option value="3">POINT MACHINE</option>
                            </select>
                        </div>
                        <div class="col-md-12 divAttribute">
                            <label>Attribute</label>
                            <select class="form-control" id="drpSearchAttribute"></select>
                        </div>
                        <div class="col-sm-12 mb15 divoperation" style="display:none;">
                            <label>Select Attribute</label>
                            <select class="form-control" id="selOpration">
                                <option value="sel">Select</option>
                                <option value="Operating Current">Operating Current</option>
                                <option value="Operating Voltage">Operating Voltage</option>
                                <option value="Operating Time">Operating Time</option>
                            </select>
                        </div>
                        <div class="col-sm-12 mb15 divoperationType" style="display:none;">
                            <label>Operation Type</label>
                            <select class="form-control" id="selOperationType">
                                <option value="sel">Select</option>
                                <option value="IRS">IRS</option>
                                <option value="ThickWave">ThickWave</option>
                            </select>
                        </div>
                        <div class="col-md-12 divThreshold" style="display:none">
                            <label>Threshold</label>
                            <input type="text" id="txtSearchThreshold" class="form-control" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" type="button" onclick="fnSearchAttributeGlance()">Search</button>
                    <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal bounceIn animated" id="modalSiteSelectPartial" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-width modal-xl modal-dialog-centered">
            <div class="modal-content bradius4">
                <div class="modal-header">
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeaderSitePartial"></span></h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="hdnSiteSelectId" />
                    @*<canvas id="myCanvasSiteSelect" width="500" height="500">
                        </canvas>*@
                    <div class="row">
                        <div class="col-lg-6">
                            <div id="divSitePartial">
                                @Html.Partial("_SitePartial", new Domain.Site())
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div id="divMISSitePartial">
                                @Html.Partial("_MISSitePartial", new Domain.Site())
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="modal bounceIn animated" id="modalFullAttributeAtGlance" tabindex="-1" role="dialog" data-bs-backdrop="static">
        <div class="modal-dialog modal-width modal-dialog-centered modal-fullscreen">
            <div class="modal-content bradius4">
                <div class="modal-header">
                    <h4 class="modal-title" id="myModalLabel"><span id="spExpandHeader"></span></h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-12">
                            <div id="fullattributeGlanceEchart">

                            </div>
                        </div>
                        <div class="col-md-6">
                            <div id="fullac_attributeGlanceEchart">
                            </div>

                        </div>
                        <div class="col-md-6">
                            <div id="fullbc_attributeGlanceEchart">
                            </div>

                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal bounceIn animated" id="modalMapExpand" tabindex="-1" role="dialog" data-bs-backdrop="static">
        <div class="modal-dialog modal-width modal-dialog-centered modal-fullscreen">
            <div class="modal-content bradius4">
                <div class="modal-header" style="background-color: #08495e !important;color:white;">
                    <h4 class="modal-title" id="myModalLabel"><span>Map</span></h4>
                    @*<div id="MapZoomModal"></div>*@
                    <div class="toolbar-zoom-modal-container">
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
                </div>
                <div class="modal-body">
                    <div id="divMapExpand">
                        <div class="app-body">
                            <div class="stencil-container" style="display:none"></div>
                            <div class="paper-container" style="left:0px;right:0"></div>
                            <div class="inspector-container" style="display:none"></div>
                            <div class="navigator-container" style="display:none"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
                </div>
            </div>
