@model List<Domain.MISSummary>

<div class="table-responsive">
    <table class="table">
        <thead>
            <tr>
                <th>Station</th>
                <th>Maintenance due</th>
                <th>Design and Drawings</th>
                <th>Codal life expiring</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <a onclick="fnShowUserSiteMIS('@item.SiteName'); return false;" href="#">@item.SiteName</a> 
                        </td>
                        <td>0</td>
                        <td><a target="_blank" href="http://energy7.in:97/SitePDF?siteId=@(item.SiteId)">@item.SitePDFCount / @item.CategoryCount</a></td>
                        <td><a target="_blank" href="http://energy7.in:97/CodalLife?siteId=@(item.SiteId)">@item.CodalLifeCount</a></td>
                    </tr>
                }
            }

        </tbody>
    </table>
</div>
