@model Domain.Site

<style>
    .cardSitePartialheader {
        background-color: #08495e !important;
        color: white !important;
        padding: 30px;
        border-bottom: 1px solid #ecf3fa;
       /* border-top-left-radius: 15px;
        border-top-right-radius: 15px;*/
        position: relative;
    }

    .notification-badge {
        position: relative;
        color: #ffffff;
        background-color: #ff4d4f;
        border-radius: 14px;
        padding: 1px 5px;
        font-family: "icofont";
        margin-right: 4px;
        font-size: medium;
    }
</style>
<div class="row">
    <div class="card">
        <div class="card-header cardSitePartialheader">
            <div class="row">
                <div class="col-md-12">
                    <h5 style="text-align: center;">
                        RDPMS
                    </h5>
                </div>

            </div>
        </div>
        <div class="card-body" style="padding: 0px !important; border: 1px solid #08495e">
            <div class="people-options clearfix p-t-10">
                <div class="pull-left">
                    <a href="@Url.Action("SiteAssetData","Site",new { siteId = Model.Id})" class="btn btn-success m-l-10" target="_blank">View</a>
                </div>
                <div class="pull-right">
                    @if (Model.IsDatalogger)
                    {
                        <a class="btn btn-warning" href="@Url.Action("DataLogger","UserSite",new { siteId = Model.Id})">Data Logger</a>
                    }
                    @if (!Model.IsSipView)
                    {
                        <a href="@Url.Action("Sview","Site",new { siteId = Model.Id})" class="btn btn-dark m-r-10" target="_blank">Sip View</a>
                    }
                </div>
            </div>
            <div class="people-options clearfix">
                <div class="text-center">
                    <img id="imgSite_@Model.Id" src="~/assets/images/imgGreen.png" height="100" width="100" />
                </div>
                <div class="text-center mt-3 mb-3">
                    @if (Model.TrackCount > 0)
                    {
                        <span class="span notification-badge"><a href="javascript:void(0)" style="color:white;" onclick="fnGetSiteSummaryView('@Model.Name','@E7FRSAdvance.Utility.Utility.AssetType.TRACK.GetHashCode()')">T: @Model.TrackCount </a></span>
                    }
                    @if (Model.PointMachineCount > 0)
                    {
                        <span class="span notification-badge"><a href="javascript:void(0)" style="color:white;" onclick="fnGetSiteSummaryView('@Model.Name','@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()')">P: @Model.PointMachineCount </a></span>
                    }
                    @if (Model.SignalCount > 0)
                    {
                        <span class="span notification-badge"><a href="javascript:void(0)" style="color:white;" onclick="fnGetSiteSummaryView('@Model.Name','@E7FRSAdvance.Utility.Utility.AssetType.SIGNAL.GetHashCode()')">S: @Model.SignalCount </a></span>
                    }
                </div>
            </div>
            <div class="people-options clearfix text-center  mb-4">
                <a href="@Url.Action("Summary","UserSite",new { siteId = Model.Id})" class="btn btn-primary" target="_blank">Probability</a>
                <a class="btn btn-warning" href="@Url.Action("UserHistory","UserSite",new { siteId = Model.Id})" target="_blank">User History</a>
                <button class="btn btn-primary" type="button" onclick="fnShowPerformance('@Model.Id')">Performance</button>

            </div>
        </div>
    </div>  
    
</div>