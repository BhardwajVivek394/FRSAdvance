
@{
    ViewBag.Title = "FRSAuditWatchlist";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Audit Watchlist</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-lg-12">
                <div class="row">
                    <div class="col-xl-1">
                        <strong class="mt-4">Search</strong>
                    </div>
                    <div class="col-xl-1 col-lg-6">
                        <strong>Zone</strong>
                        @Html.DropDownList("drpZone", (IEnumerable<SelectListItem>)ViewBag.Zones, new { @class = "form-control", tabindex = 1 })
                    </div>
                    <div class="col-xl-2 col-lg-6">
                        <strong>Division</strong>
                        @Html.DropDownList("drpDivision", (IEnumerable<SelectListItem>)ViewBag.Divisions, new { @class = "form-control", tabindex = 2 })
                    </div>
                    <div class="col-xl-2 col-lg-6">
                        <strong>Site</strong>
                        @Html.DropDownList("drpSite", (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 3 })
                    </div>
                    <div class="col-xl-2 col-lg-4 col-md-4">
                        <span>From Date</span>
                        <input type="text" class="form-control" id="txtFromDate" />
                    </div>
                    <div class="col-xl-2 col-lg-4 col-md-4">
                        <span>To Date</span>
                        <input type="text" class="form-control" id="txtToDate" />
                    </div>

                    <div class="col-xl-2 col-lg-2 mt-3">
                        <a class="btn btn-success btn-quirk mt-1" onclick="fnBindAlertWatchlist()" title="Search"><i class="fa fa-search"></i></a>
                        <a class="btn btn-success btn-quirk mt-1" onclick="fnDownloadWatchlist()" title="Download"><i class="fa fa-download"></i></a>

                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="card-body" id="divAlertSummaryList">
    </div>

    <div id="FRSAlertAuditView"></div>
</div>

<script>
    $(document).ready(function () {

        $('#txtFromDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        });

        $('#txtToDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        });
    });

    function fnDownloadWatchlist() {

        var mSearchCriteria = {};

        mSearchCriteria.IssueTypes = [];
        mSearchCriteria.ZoneId = $('#drpZone').val();
        mSearchCriteria.DivisionId = $('#drpDivision').val();
        mSearchCriteria.SiteId = $('#drpSite').val();
        mSearchCriteria.ResolvedStartDate = $('#txtFromDate').val();
        mSearchCriteria.ResolvedEndDate = $('#txtToDate').val();

        var isst = null;
        if (mSearchCriteria.IssueTypes != null && mSearchCriteria.IssueTypes != undefined && mSearchCriteria.IssueTypes != '') {
            isst = mSearchCriteria.IssueTypes;
        }
        window.location.href = "/AlertAnalysis/DownloadFRSAuditWatchlist?SiteId=" + mSearchCriteria.SiteId + "&DivisionId=" + mSearchCriteria.DivisionId + "&StartDate=" + mSearchCriteria.StartDate + "&EndDate=" + mSearchCriteria.EndDate + "&IssueTypes=" + isst + "&IsCheckAlertType=" + mSearchCriteria.IsCheckAlertType + "&Type=" + mSearchCriteria.Type + "&IsAlert=" + mSearchCriteria.IsAlert;
    }

    function fnBindAlertWatchlist() {
       var mSearchCriteria = {};

        mSearchCriteria.IssueTypes = [];
        mSearchCriteria.ZoneId = $('#drpZone').val();
        mSearchCriteria.DivisionId = $('#drpDivision').val();
        mSearchCriteria.SiteId = $('#drpSite').val();
        mSearchCriteria.ResolvedStartDate = $('#txtFromDate').val();
        mSearchCriteria.ResolvedEndDate = $('#txtToDate').val();

        mSearchCriteria.IssueTypes.push('@E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware.GetHashCode()');
        mSearchCriteria.IssueTypes.push('@E7FRSAdvance.Utility.Utility.FRSAlertIssue.Calibration.GetHashCode()');
        mSearchCriteria.IssueTypes.push('@E7FRSAdvance.Utility.Utility.FRSAlertIssue.Wattmon.GetHashCode()');
     
        $("#loader").show();
        $.ajax({
            url: '/AlertAnalysis/_FRSAuditWatchlist',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mSearchCriteria),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divAlertSummaryList").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });

    }

    $("#drpZone").change(function () {
        GetDivisionByZone($(this).val());

    });

    $("#drpDivision").change(function () {
        GetSiteByDivisionId($(this).val());
    });


    function GetDivisionByZone(zoneId) {
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/AlertAnalysis/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpDivision").empty();
                    $("#drpDivision").append($("<option></option>").val('0').html('Select'));
                    $.each(data, function (key, value) {
                        if ($('#drpDivision').val() != '0' && $('#hdnSearchDivisionId').val() == value.Id) {
                            $("#drpDivision").append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $("#drpDivision").append($("<option></option>").val(value.Id).html(value.Name));
                        }
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function GetSiteByDivisionId(divisionId) {
        if (divisionId != null && divisionId != undefined && divisionId != '') {

            $("#loader").show();
            $.ajax({
                url: '/AlertAnalysis/GetSiteByDivisionId',
                type: 'POST',
                data: '{divisionId:' + divisionId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpSite").empty();
                    $("#drpSite").append($("<option></option>").val('0').html('Select'));
                    $.each(data, function (key, value) {
                        if ($('#hdnSearchSiteId').val() != '0' && $('#hdnSearchSiteId').val() == value.Id) {
                            $("#drpSite").append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $("#drpSite").append($("<option></option>").val(value.Id).html(value.Name));
                        }

                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }
</script>
