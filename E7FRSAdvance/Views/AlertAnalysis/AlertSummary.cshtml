@model Domain.SearchCriteria
@{
    ViewBag.Title = "AlertSummary";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Summary</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-lg-12">
                <div class="row">
                    <div class="col-xl-1">
                        <strong class="mt-4">Search</strong>
                    </div>
                    <div class="col-xl-1 col-lg-4 col-md-4">
                        <span>View</span>
                        <select class="form-control" id="drpView">
                            <option value="All">All</option>
                            <option value="Count" selected>Count</option>
                            <option value="Detail">Detail</option>
                            <option value="SiteWise">Site Wise</option>
                            <option value="DateWise">Date Wise</option>
                        </select>
                    </div>
                    <div class="col-xl-9 clsWithOutSiteWise">
                        <div class="row">
                            <div class="col-xl-1 col-lg-4 col-md-4">
                                <span>Zone</span>
                                @Html.DropDownListFor(x => x.ZoneId, (IEnumerable<SelectListItem>)ViewBag.Zones, new { @class = "form-control", @id = "drpZone", tabindex = 1 })
                            </div>
                            <div class="col-xl-2 col-lg-4 col-md-4">
                                <input type="hidden" id="hdnPMClusterDivisionId" value="@Model.DivisionId" />
                                <span>Division</span>
                                @Html.DropDownListFor(x => x.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, new { @class = "form-control", @id = "drpDivision", tabindex = 2 })
                            </div>
                            <div class="col-xl-2 col-lg-4 col-md-4">
                                <span>Site</span>
                                <input type="hidden" id="hdnPMClusterSiteId" value="@Model.SiteId" />
                                @Html.DropDownListFor(x => x.SiteId, (IEnumerable<SelectListItem>)ViewBag.Sites, "All", new { @class = "form-control", @id = "drpSites", tabindex = 3 })
                            </div>
                            <div class="col-xl-2 col-lg-4 col-md-4">
                                <span>From Date</span>
                                <input type="text" class="form-control" id="txtFromDate" />
                            </div>
                            <div class="col-xl-2 col-lg-4 col-md-4">
                                <span>To Date</span>
                                <input type="text" class="form-control" id="txtToDate" />
                            </div>
                            <div class="col-xl-1 col-lg-1">
                                <span>True/False</span>
                                <select id="drpIsAlert" class="form-control">
                                    <option value="All">All</option>
                                    <option value="True">True</option>
                                    <option value="False">False</option>
                                </select>
                            </div>
                            <div class="col-xl-2 col-lg-4 col-md-4" id="divIssueType">
                                <span>Issue Type</span>
                                <select id="drpIssueType" class="js-example-basic-multiple form-control" multiple>
                                    @{
                                        var enumData = from E7FRSAdvance.Utility.Utility.FRSAlertIssue e in Enum.GetValues(typeof(E7FRSAdvance.Utility.Utility.FRSAlertIssue))
                                                       select new
                                                       {
                                                           Id = (int)e,
                                                           Name = e.ToString().Replace("_", " ")
                                                       };
                                    }
                                    @foreach (var item in enumData)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                    </div>
                    <div class="col-xl-4 clsWithOutDateWise" style="display:none">
                        <div class="row">
                            <div class="col-xl-6 col-lg-4 col-md-4">
                                <span>From Date</span>
                                <input type="text" class="form-control" id="txtDateWiseFromDate" />
                            </div>
                            <div class="col-xl-6 col-lg-4 col-md-4">
                                <span>To Date</span>
                                <input type="text" class="form-control" id="txtDateWiseToDate" />
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-2 clsWithOutSiteWiseDateFilter" style="display:none">
                        <div class="row">
                            <div class="col-xl-12">
                                <span>Date</span>
                                <input type="text" class="form-control" id="txtSiteWiseDate" />
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-1 col-lg-1 mt-3">
                        <a class="btn btn-success btn-quirk mt-1" onclick="fnBindAlertSummary()" title="Search Summary"><i class="fa fa-search"></i></a>
                        <a class="btn btn-primary btn-quirk mt-1" onclick="fnDownloadAlertSummary()" title="Download Alert Summary"><i class="fa fa-download"></i></a>

                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="card-body" id="divAlertSummaryList">
    </div>

</div>

<script>
    $(document).ready(function () {
        var minusSeven = new Date()
        minusSeven.setDate(minusSeven.getDate() - 7);

        $('#drpIssueType').select2();

        $('#txtFromDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#txtToDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#txtDateWiseFromDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        }).datepicker("setDate", minusSeven);

        $('#txtDateWiseToDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#txtSiteWiseDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#txtSiteWiseDate').val('');

       /* GetDivisionByZone($("#drpZone").val());*/

        $("#drpZone").change(function () {
            GetDivisionByZone($(this).val());

        });

        $("#drpDivision").change(function () {
            GetSiteByDivisionId($(this).val());
        });

        $("#drpIsAlert").change(function () {
            if ($(this).val() == "True") {
                $('#divIssueType').hide();
            } else {
                $('#divIssueType').show();
            }
        });

        $("#drpView").change(function () {

            if ($(this).val() == "SiteWise") {
                $('.clsWithOutSiteWise').hide();
                $('.clsWithOutDateWise').hide();
                $('.clsWithOutSiteWiseDateFilter').show();
            }
            else if ($(this).val() == "DateWise") {
                $('.clsWithOutSiteWise').hide();
                $('.clsWithOutSiteWiseDateFilter').hide();
                $('.clsWithOutDateWise').show();
            }
            else {
                $('.clsWithOutSiteWise').show();
                $('.clsWithOutDateWise').hide();
                $('.clsWithOutSiteWiseDateFilter').hide();
            }

        });

        fnBindAlertSummary();
    });

    function GetDivisionByZone(zoneId) {
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/PointClustering/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpDivision").empty();
                    $("#drpDivision").append($("<option></option>").val('0').html('All'));
                    $.each(data, function (key, value) {
                        if ($('#hdnSearchDivisionId').val() != '0' && $('#hdnSearchDivisionId').val() == value.Id) {
                            $("#drpDivision").append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $("#drpDivision").append($("<option></option>").val(value.Id).html(value.Name));
                        }
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function GetSiteByDivisionId(divisionId) {
        if (divisionId != null && divisionId != undefined && divisionId != '') {

            $("#loader").show();
            $.ajax({
                url: '/PointClustering/GetSiteByDivisionId',
                type: 'POST',
                data: '{divisionId:' + divisionId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpSites").empty();
                    $("#drpSites").append($("<option></option>").val('0').html('All'));
                    $.each(data, function (key, value) {
                        if ($('#hdnSearchSiteId').val() != '0' && $('#hdnSearchSiteId').val() == value.Id) {
                            $("#drpSites").append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $("#drpSites").append($("<option></option>").val(value.Id).html(value.Name));
                        }

                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function fnBindAlertSummary() {
        if ($('#drpView').val() == "Count") {
            var mSearchCriteria = {};
            mSearchCriteria.ZoneId = $("#drpZone").val();
            mSearchCriteria.SiteId = $('#drpSites').val();
            mSearchCriteria.DivisionId = $('#drpDivision').val();
            mSearchCriteria.StartDate = $('#txtFromDate').val();
            mSearchCriteria.EndDate = $('#txtToDate').val();
            mSearchCriteria.IssueTypes = $('#drpIssueType').val();
            mSearchCriteria.IsCheckAlertType = false;
            if ($('#drpIsAlert').val() == "True") {
                mSearchCriteria.IsAlert = true;
                mSearchCriteria.IsCheckAlertType = true;
            }
            else if ($('#drpIsAlert').val() == "False") {
                mSearchCriteria.IsAlert = false;
                mSearchCriteria.IsCheckAlertType = true;
            }

            $("#loader").show();
            $.ajax({
                url: '/AlertAnalysis/_AlertSummaryCountList',
                type: 'Post',
                contentType: 'application/json',
                data: JSON.stringify(mSearchCriteria),
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    $("#divAlertSummaryList").empty().append(data);
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });

        } else if ($('#drpView').val() == "Detail") {

            var mSearchCriteria = {};
            mSearchCriteria.SiteId = $('#drpSites').val();
            mSearchCriteria.DivisionId = $('#drpDivision').val();
            mSearchCriteria.ZoneId = $("#drpZone").val();
            mSearchCriteria.StartDate = $('#txtFromDate').val();
            mSearchCriteria.EndDate = $('#txtToDate').val();
            mSearchCriteria.IssueTypes = $('#drpIssueType').val();
            mSearchCriteria.IsCheckAlertType = true;
            if ($('#drpIsAlert').val() == "True") {
                mSearchCriteria.IsAlert = true;
            }
            else if ($('#drpIsAlert').val() == "False") {
                mSearchCriteria.IsAlert = false;
            } else if ($('#drpIsAlert').val() == "All") {
                mSearchCriteria.IsCheckAlertType = false;
            }

            $("#loader").show();
            $.ajax({
                url: '/AlertAnalysis/_AlertSummaryDetailList',
                type: 'Post',
                contentType: 'application/json',
                data: JSON.stringify(mSearchCriteria),
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    $("#divAlertSummaryList").empty().append(data);
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else if ($('#drpView').val() == "SiteWise") {

            var mSearchCriteria = {};

            mSearchCriteria.IssueTypes = [];
            mSearchCriteria.IssueTypes.push('@E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware.GetHashCode()');
            mSearchCriteria.IssueTypes.push('@E7FRSAdvance.Utility.Utility.FRSAlertIssue.Calibration.GetHashCode()');
            if ($('#txtSiteWiseDate').val() != null && $('#txtSiteWiseDate').val() != undefined && $('#txtSiteWiseDate').val() != '') {
                //mSearchCriteria.StartDate = $('#txtSiteWiseDate').val();
                mSearchCriteria.EndDate = $('#txtSiteWiseDate').val();
            }


            $("#loader").show();
            $.ajax({
                url: '/AlertAnalysis/_AlertSummarySiteWiseList',
                type: 'Post',
                contentType: 'application/json',
                data: JSON.stringify(mSearchCriteria),
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    $("#divAlertSummaryList").empty().append(data);
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else if ($('#drpView').val() == "DateWise") {

            var mSearchCriteria = {};

            mSearchCriteria.IssueTypes = [];
            mSearchCriteria.IssueTypes.push('@E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware.GetHashCode()');
            mSearchCriteria.IssueTypes.push('@E7FRSAdvance.Utility.Utility.FRSAlertIssue.Calibration.GetHashCode()');
            mSearchCriteria.StartDate = $('#txtDateWiseFromDate').val();
            mSearchCriteria.EndDate = $('#txtDateWiseToDate').val();

            $("#loader").show();
            $.ajax({
                url: '/AlertAnalysis/_AlertSummaryDateWiseList',
                type: 'Post',
                contentType: 'application/json',
                data: JSON.stringify(mSearchCriteria),
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    $("#divAlertSummaryList").empty().append(data);
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function fnDownloadAlertSummary() {
        if ($('#drpView').val() == "Count") {
            var mSearchCriteria = {};
            mSearchCriteria.SiteId = $('#drpSites').val();
            mSearchCriteria.ZoneId = $("#drpZone").val();
            mSearchCriteria.DivisionId = $('#drpDivision').val();
            mSearchCriteria.StartDate = $('#txtFromDate').val();
            mSearchCriteria.EndDate = $('#txtToDate').val();
            mSearchCriteria.IssueTypes = $('#drpIssueType').val();
            mSearchCriteria.Type = "Count";
            mSearchCriteria.IsCheckAlertType = false;
            if ($('#drpIsAlert').val() == "True") {
                mSearchCriteria.IsCheckAlertType = true;
                mSearchCriteria.IsAlert = true;
            }
            else if ($('#drpIsAlert').val() == "False") {
                mSearchCriteria.IsCheckAlertType = true;
                mSearchCriteria.IsAlert = false;
            }

            var isst = null;
            if (mSearchCriteria.IssueTypes != null && mSearchCriteria.IssueTypes != undefined && mSearchCriteria.IssueTypes != '') {
                isst = mSearchCriteria.IssueTypes;
            }
            window.location.href = "/AlertAnalysis/DownloadAlertSummary?SiteId=" + mSearchCriteria.SiteId + "&ZoneId=" + mSearchCriteria.ZoneId + "&DivisionId=" + mSearchCriteria.DivisionId + "&StartDate=" + mSearchCriteria.StartDate + "&EndDate=" + mSearchCriteria.EndDate + "&IssueTypes=" + isst + "&IsCheckAlertType=" + mSearchCriteria.IsCheckAlertType + "&Type=" + mSearchCriteria.Type + "&IsAlert=" + mSearchCriteria.IsAlert;

        } else if ($('#drpView').val() == "Detail") {
            var mSearchCriteria = {};
            mSearchCriteria.SiteId = $('#drpSites').val();
            mSearchCriteria.DivisionId = $('#drpDivision').val();
            mSearchCriteria.ZoneId = $("#drpZone").val();
            mSearchCriteria.StartDate = $('#txtFromDate').val();
            mSearchCriteria.EndDate = $('#txtToDate').val();
            mSearchCriteria.IssueTypes = $('#drpIssueType').val();
            mSearchCriteria.IsCheckAlertType = true;
            mSearchCriteria.Type = "Detail";
            if ($('#drpIsAlert').val() == "True") {
                mSearchCriteria.IsAlert = true;
            }
            else if ($('#drpIsAlert').val() == "False") {
                mSearchCriteria.IsAlert = false;
            }
            else if ($('#drpIsAlert').val() == "All") {
                mSearchCriteria.IsCheckAlertType = false;
            }
            var isst = null;
            if (mSearchCriteria.IssueTypes != null && mSearchCriteria.IssueTypes != undefined && mSearchCriteria.IssueTypes != '') {
                isst = mSearchCriteria.IssueTypes;
            }
            window.location.href = "/AlertAnalysis/DownloadAlertSummary?SiteId=" + mSearchCriteria.SiteId + "&ZoneId=" + mSearchCriteria.ZoneId + "&DivisionId=" + mSearchCriteria.DivisionId + "&StartDate=" + mSearchCriteria.StartDate + "&EndDate=" + mSearchCriteria.EndDate + "&IssueTypes=" + isst + "&IsCheckAlertType=" + mSearchCriteria.IsCheckAlertType + "&Type=" + mSearchCriteria.Type + "&IsAlert=" + mSearchCriteria.IsAlert;

        }
        else if ($('#drpView').val() == "SiteWise") {
            var mSearchCriteria = {};
            mSearchCriteria.Type = "SiteWise";

            if ($('#txtSiteWiseDate').val() != null && $('#txtSiteWiseDate').val() != undefined && $('#txtSiteWiseDate').val() != '') {
                //mSearchCriteria.StartDate = $('#txtSiteWiseDate').val();
                mSearchCriteria.EndDate = $('#txtSiteWiseDate').val();
            }
            window.location.href = "/AlertAnalysis/DownloadAlertSummary?EndDate=" + mSearchCriteria.EndDate + "&Type=" + mSearchCriteria.Type;
        }
        else if ($('#drpView').val() == "DateWise") {
            var mSearchCriteria = {};
            mSearchCriteria.Type = "DateWise";
            mSearchCriteria.StartDate = $('#txtDateWiseFromDate').val();
            mSearchCriteria.EndDate = $('#txtDateWiseToDate').val();

            window.location.href = "/AlertAnalysis/DownloadAlertSummary?StartDate=" + mSearchCriteria.StartDate + "&EndDate=" + mSearchCriteria.EndDate + "&Type=" + mSearchCriteria.Type;
        }
        else {
            var mSearchCriteria = {};
            mSearchCriteria.SiteId = $('#drpSites').val();
            mSearchCriteria.ZoneId = $("#drpZone").val();
            mSearchCriteria.DivisionId = $('#drpDivision').val();
            mSearchCriteria.StartDate = $('#txtFromDate').val();
            mSearchCriteria.EndDate = $('#txtToDate').val();
            mSearchCriteria.IssueTypes = $('#drpIssueType').val();
            mSearchCriteria.Type = "All";
            mSearchCriteria.IsCheckAlertType = false;
            if ($('#drpIsAlert').val() == "True") {
                mSearchCriteria.IsCheckAlertType = true;
                mSearchCriteria.IsAlert = true;
            }
            else if ($('#drpIsAlert').val() == "False") {
                mSearchCriteria.IsCheckAlertType = true;
                mSearchCriteria.IsAlert = false;
            }
            var isst = null;
            if (mSearchCriteria.IssueTypes != null && mSearchCriteria.IssueTypes != undefined && mSearchCriteria.IssueTypes != '') {
                isst = mSearchCriteria.IssueTypes;
            }

            window.location.href = "/AlertAnalysis/DownloadAlertSummary?SiteId=" + mSearchCriteria.SiteId + "&ZoneId=" + mSearchCriteria.ZoneId + "&DivisionId=" + mSearchCriteria.DivisionId + "&StartDate=" + mSearchCriteria.StartDate + "&EndDate=" + mSearchCriteria.EndDate + "&IssueTypes=" + isst + "&IsCheckAlertType=" + mSearchCriteria.IsCheckAlertType + "&Type=" + mSearchCriteria.Type + "&IsAlert=" + mSearchCriteria.IsAlert;

        }


    }

    function fnDeleteFRSAlertAudit(id) {
        if (confirm('Are you sure you want to delete selected record')) {
            $("#loader").show();
            $.ajax({
                url: '/AlertAnalysis/DeleteFRSAlertAudit',
                type: 'Post',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            fnBindAlertSummary();
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "error");
                }
            });
        }

    }
</script>
