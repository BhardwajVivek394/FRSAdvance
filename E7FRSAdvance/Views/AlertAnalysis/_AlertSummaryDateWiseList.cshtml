@model List<Domain.FRSAlertAudit>

@{
    var zones = new List<Domain.Zone>();
    var divisions = new List<Domain.Division>();
    if (ViewBag.Zones != null)
    {
        zones = ViewBag.Zones as List<Domain.Zone>;
    }
    if (ViewBag.Divisions != null)
    {
        divisions = ViewBag.Divisions as List<Domain.Division>;
    }
    var startDate = DateTime.Now;
    var endDate = DateTime.Now;
    if (ViewBag.StartDate != null)
    {
        startDate = Convert.ToDateTime(ViewBag.StartDate);
    }
    if (ViewBag.EndDate != null)
    {
        endDate = Convert.ToDateTime(ViewBag.EndDate);
    }
}



<div class="card">
    <div class="card-header">
        <h6>Zone Wise</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">

                @if (Model != null && Model.Count > 0)
                {
                    var zoneIds = Model.GroupBy(x => x.ZoneId).Select(x => x.Key).ToList();
                    if (zoneIds != null && zoneIds.Count > 0)
                    {
                        <thead class="bg-primary">
                            <tr>
                                <th>Zone</th>

                                @for (DateTime dateTime = Convert.ToDateTime(startDate); dateTime <= Convert.ToDateTime(endDate); dateTime += TimeSpan.FromDays(1))
                                {
                                    <th class="text-center">
                                        <span>@dateTime.ToString("dd/MM/yyyy")</span> <br />
                                        <span>
                                            Hardware
                                        </span>  <br />
                                        <span>C/R/U</span>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var zoneId in zoneIds)
                            {
                                <tr class="table-light">
                                    <td>
                                        @if (zones != null && zones.Count > 0)
                                        {
                                            <span>@zones.Where(x => x.Id == zoneId).Select(x => x.Name).FirstOrDefault()</span>
                                        }
                                    </td>
                                    @for (DateTime dateTime = Convert.ToDateTime(startDate); dateTime <= Convert.ToDateTime(endDate); dateTime += TimeSpan.FromDays(1))
                                    {
                                        var hardwareCount = Model.Where(x => x.ZoneId == zoneId && x.TimeStamp != null && x.TimeStamp.Value.Date == dateTime.Date && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                        var hardwareResolvedCount = Model.Where(x => x.ZoneId == zoneId && x.TimeStamp != null && x.TimeStamp.Value.Date == dateTime.Date && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware && x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                        var hardwareUnResolvedCount = Model.Where(x => x.ZoneId == zoneId && x.TimeStamp != null && x.TimeStamp.Value.Date == dateTime.Date && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware && !x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();

                                        //var calibrationCount = Model.Where(x => x.ZoneId == zoneId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Calibration).Count();
                                        //var calibrationResolvedCount = Model.Where(x => x.ZoneId == zoneId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Calibration && x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                        //var calibrationUnResolvedCount = Model.Where(x => x.ZoneId == zoneId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Calibration && !x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                        //if (hardwareCount > 0 || calibrationCount > 0)
                                        //{
                                        //}
                                        <td class="text-center">@hardwareCount/@hardwareResolvedCount/@hardwareUnResolvedCount</td>
                                    }
                                </tr>


                            }
                        </tbody>

                    }
                }


            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h6>Division Wise</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                @if (Model != null && Model.Count > 0)
                {
                    var divisionIds = Model.GroupBy(x => x.DivisionId).Select(x => x.Key).ToList();
                    if (divisionIds != null && divisionIds.Count > 0)
                    {
                        <thead class="bg-primary">
                            <tr>
                                <th>Division</th>
                                @for (DateTime dateTime = Convert.ToDateTime(startDate); dateTime <= Convert.ToDateTime(endDate); dateTime += TimeSpan.FromDays(1))
                                {
                                    <th class="text-center">
                                        <span>@dateTime.ToString("dd/MM/yyyy")</span> <br />
                                        <span>
                                            Hardware
                                        </span>  <br />
                                        <span>C/R/U</span>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var divisionId in divisionIds)
                            {
                                <tr class="table-light">
                                    <td>
                                        @if (divisions != null && divisions.Count > 0)
                                        {
                                            <span>@divisions.Where(x => x.Id == divisionId).Select(x => x.Name).FirstOrDefault()</span>
                                        }
                                    </td>
                                    @for (DateTime dateTime = Convert.ToDateTime(startDate); dateTime <= Convert.ToDateTime(endDate); dateTime += TimeSpan.FromDays(1))
                                    {
                                        var hardwareCount = Model.Where(x => x.DivisionId == divisionId && x.TimeStamp != null && x.TimeStamp.Value.Date == dateTime.Date && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                        var hardwareResolvedCount = Model.Where(x => x.DivisionId == divisionId && x.TimeStamp != null && x.TimeStamp.Value.Date == dateTime.Date && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware && x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                        var hardwareUnResolvedCount = Model.Where(x => x.DivisionId == divisionId && x.TimeStamp != null && x.TimeStamp.Value.Date == dateTime.Date && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware && !x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();

                                        <td class="text-center">
                                            @hardwareCount/@hardwareResolvedCount/@hardwareUnResolvedCount
                                        </td>
                                    }

                                </tr>



                            }


                        </tbody>

                    }
                }
            </table>
        </div>
    </div>
</div>



