            }
        });
    }

    function fnShowFRSAlertAudit(frsAlertId) {
        $("#loader").show();
        $.ajax({
            url: '/AlertAnalysis/GetFRSAlertAuditBy',
            type: 'POST',
            dataType: 'html',
            data: '{id:' + frsAlertId + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
