                $('#modalFRSAlertAudit').modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnSaveFRSAlertAudit(siteId, assetId, alertInfoId, id) {
        var mFRSAlertAudit = {};
        var isValid = true;
        mFRSAlertAudit.SiteId = siteId
        mFRSAlertAudit.AssetId = assetId
        mFRSAlertAudit.AlertInfoId = alertInfoId;
        mFRSAlertAudit.FRSAlertId = id;
        mFRSAlertAudit.Remark = $('#txtFRSAlertAuditRemark' + assetId + alertInfoId).val();

        mFRSAlertAudit.FRSWatchListAttributes = [];
        var frsAttribute = $('#drpFRSAlertAuditAttribute' + assetId + alertInfoId).val();
        if (frsAttribute != null && frsAttribute.length > 0) {
            $(frsAttribute).each(function (d,val) {
                var attr = {};
                attr.AttributeId = val;
                mFRSAlertAudit.FRSWatchListAttributes.push(attr);
            });
        }

        if ($("#drpFRSAlertAuditType" + assetId + alertInfoId).val() == 'True') {
            mFRSAlertAudit.IsAlert = true;
        } else {
            mFRSAlertAudit.IsAlert = false;
        }
        mFRSAlertAudit.IsOpenClose = true;

        if ($("#chkFRSAlertAuditWorngCausecode" + assetId + alertInfoId).prop('checked') == true) {
            mFRSAlertAudit.WorngCauseCode = true;
        }

        if (mFRSAlertAudit.Remark == null || mFRSAlertAudit.Remark == undefined || mFRSAlertAudit.Remark == '') {
            isValid = false;
            alert("Remark is required")
        }

        if (!mFRSAlertAudit.IsAlert) {

            mFRSAlertAudit.IssueTypeId = $("#drpFRSIssueType" + assetId + alertInfoId).val();
            if (mFRSAlertAudit.IssueTypeId == null || mFRSAlertAudit.IssueTypeId == undefined || mFRSAlertAudit.IssueTypeId == '') {
                isValid = false;
                alert("Issue type not select")
            }
            else {
                if (mFRSAlertAudit.IssueTypeId == '@E7FRSAdvance.Utility.Utility.FRSAlertIssue.Calibration.GetHashCode()' || mFRSAlertAudit.IssueTypeId == '@E7FRSAdvance.Utility.Utility.FRSAlertIssue.Wattmon.GetHashCode()' || mFRSAlertAudit.IssueTypeId == '@E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware.GetHashCode()' || mFRSAlertAudit.IssueTypeId == '@E7FRSAdvance.Utility.Utility.FRSAlertIssue.Validation.GetHashCode()') {

                    if (mFRSAlertAudit.FRSWatchListAttributes != null && mFRSAlertAudit.FRSWatchListAttributes != null && mFRSAlertAudit.FRSWatchListAttributes.length > 0) {

                    } else {
                        if (isValid) {
                            isValid = false;
                            alert("Attribute not select")
                        }

                    }
                }

            }
        }

        if (isValid) {
            $("#loader").show();
            $.ajax({
                url: '/AlertAnalysis/UpdateFRSAlertAnalysisAudit',
                type: 'Post',
                data: '{mFRSAlertAudit:' + JSON.stringify(mFRSAlertAudit) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        $('#modalFRSAlertAudit').modal('hide');
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", "Alert remark has been Update.", "success");

                            if (typeof fnRefreshTestWatchListPartial === "function") {
                                fnRefreshTestWatchListPartial();
                            } else if (typeof fnRefreshSRNumberViewPartial === "function") {
                                fnRefreshSRNumberViewPartial();
                            }
                           
                        } else {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function fnRefreshSRNumberViewPartial() {
        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.ZoneId = $('#drpAlertAnalysisZone').val();
        mSearchCriteria.DivisionId = $('#drpAlertAnalysisDivision').val();
        mSearchCriteria.SiteId = $('#drpAlertAnalysisSite').val();
        mSearchCriteria.FromDate = $('#searchAlertAnalysisFromDate').val();
        mSearchCriteria.ToDate = $('#searchAlertAnalysisToDate').val();
        mSearchCriteria.DistributeUserId = $('#drpAlertAnalysisUser').val();

        var activeTabId = $('.email-tabs .nav-link.active').attr('id');
        if (activeTabId != null && activeTabId != undefined && activeTabId != '') {
            if (activeTabId.includes('TRACK')) {
                mSearchCriteria.CurrentTab = 'TRACK';
            } else if (activeTabId.includes('SIGNAL')) {
                mSearchCriteria.CurrentTab = 'SIGNAL';
            }
            else if (activeTabId.includes('POINTMACHINE')) {
                mSearchCriteria.CurrentTab = 'POINT';
            }

        }
        mAssetLister.SearchCriteria = mSearchCriteria;

        $("#loader").show();
        $.ajax({
            url: '/AlertAnalysis/_SRNumberViewPartial',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();

                $("#SRNumberView").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnGetAssetAttribute(siteName, assetId, assetTypeId) {
        $("#loader").show();
        $.ajax({
            url: '/AssetAttribute/_AssetAttributePartial',
            type: 'Post',
            data: '{siteName:"' + siteName + '",assetId:' + assetId + ',assetTypeId:' + assetTypeId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAssetAttributePartial").empty().append(data);
                $("#modal-assetLister").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("danger", "Something went wrong!");
            }
        });
    }

    function fnShowFRSAlertAuditView(assetId, alertInfoId) {
        $("#loader").show();
        $.ajax({
            url: '/AlertAnalysis/GetFRSAlertAuditViewBy',
            type: 'POST',
            dataType: 'html',
            data: '{assetId:' + assetId + ',alertInfoId:' + alertInfoId + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#FRSAlertAuditView").empty().append(data);
                $('#modalFRSAlertAuditView').modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }
</script>
