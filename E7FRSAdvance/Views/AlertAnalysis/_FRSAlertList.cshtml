@model Domain.FRSAlertLister

<style>
    .tableFixHead {
        overflow: auto;
        height: 100vh;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }

    .email-body .mail-body-wrapper ul li:hover .inbox-message .email-timing {
        display: flex !important;
    }
</style>
@{
}

<div class="row" id="SiteView" style="display:none;">
    <div class="col-12">
        <div class="card-body">
            @if (Model.mFRSAlerts != null && Model.mFRSAlerts.Count > 0)
            {
                var grouByAssetType = Model.mFRSAlerts.GroupBy(x => new { x.AssetType }).Select(x => x.Key.AssetType).ToList();

                foreach (var assetType in grouByAssetType)
                {
                    if (assetType == "POINT MACHINE" || assetType == "SIGNAL" || assetType == "TRACK")
                    {
                        var sites = Model.mFRSAlerts.Where(x => x.AssetType == assetType).GroupBy(x => new { x.SiteName, x.SiteId }).Select(x => new { x.Key.SiteName, x.Key.SiteId }).ToList();
                        var groupAlertName = Model.mFRSAlerts.Where(x => x.AssetType == assetType).GroupBy(x => new { x.CauseCode, x.AlertInfoId }).Select(x => new { x.Key.CauseCode, x.Key.AlertInfoId }).ToList();

                        <div class="row">
                            <div class="col-xl-12">
                                <div class="card">
                                    <div class="card-header">
                                        <div class="col-md-12">
                                            <h6 class="mb-1">@assetType</h6>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        @{var srNo = 1;
                                            var total = 0;}
                                        <div class="table-responsive tableFixHead mb-4" style="max-height: 620px;">
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th class="bg-primary">Sr.No</th>
                                                        <th class="bg-primary">Site</th>
                                                        @foreach (var header in groupAlertName)
                                                        {
                                                            <th class="text-center bg-primary">@header.CauseCode</th>
                                                        }
                                                        <th class="bg-primary">Total</th>
                                                    </tr>
                                                </thead>
                                                <tbody style="max-height:620px; overflow-y:auto;">
                                                    @foreach (var item in sites)
                                                    {
                                                        <tr>
                                                            <td>@srNo</td>
                                                            <td>@item.SiteName</td>
                                                            @foreach (var alrt in groupAlertName)
                                                            {
                                                                var count = Model.mFRSAlerts.Where(x => x.SiteName == item.SiteName && x.AssetType == assetType && x.CauseCode == alrt.CauseCode).Count();

                                                                if (count > 0)
                                                                {
                                                                    <td class="text-center"><a href="javascript:void(0)" onclick="ShowFRSAlertAnalysisDetails('@item.SiteId','@alrt.AlertInfoId')">@count</a></td>
                                                                    total += count;
                                                                }
                                                                else
                                                                {
                                                                    <td class="text-center">0</td>
                                                                }
                                                            }

                                                            <td class="text-center">@total</td>
                                                        </tr>
                                                        total = 0;
                                                        srNo++;
                                                    }

                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>
</div>

<div class="row" id="AlertView" style="display:none;">
    <div class="col-12">
        <div class="card-body">
            @if (Model.mFRSAlerts != null && Model.mFRSAlerts.Count > 0)
            {
                var grouByAssetType = Model.mFRSAlerts.GroupBy(x => new { x.AssetType }).Select(x => x.Key.AssetType).ToList();

                foreach (var assetType in grouByAssetType)
                {
                    if (assetType == "POINT MACHINE" || assetType == "SIGNAL" || assetType == "TRACK")
                    {
                        var sites = Model.mFRSAlerts.Where(x => x.AssetType == assetType).GroupBy(x => new { x.SiteName, x.SiteId }).Select(x => new { x.Key.SiteName, x.Key.SiteId }).ToList();
                        var groupAlertName = Model.mFRSAlerts.Where(x => x.AssetType == assetType).GroupBy(x => new { x.CauseCode, x.AlertInfoId, }).Select(x => new { x.Key.CauseCode, x.Key.AlertInfoId }).ToList();

                        <div class="row">
                            <div class="col-xl-12">
                                <div class="card">
                                    <div class="card-header">
                                        <div class="col-md-12">
                                            <h6 class="mb-1">@assetType</h6>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        @{var srNo = 1;}
                                        <div class="table-responsive tableFixHead mb-4" style="max-height: 220px;">
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th class="bg-primary">Sr.No</th>
                                                        <th class="bg-primary">Alert Name</th>
                                                        <th class="bg-primary th-count">Count</th>
                                                        <th class="bg-primary"></th>
                                                        <th class="bg-primary"></th>
                                                    </tr>
                                                </thead>
                                                <tbody style="max-height:220px; overflow-y:auto;">
                                                    @foreach (var alrt in groupAlertName)
                                                    {
                                                        <tr>
                                                            <td>@srNo</td>
                                                            <td>@alrt.CauseCode</td>
                                                            @{
                                                                var count = Model.mFRSAlerts.Where(x => x.AssetType == assetType && x.CauseCode == alrt.CauseCode).Count();
                                                                var divisionId = Model.mFRSAlerts.Where(x => x.AssetType == assetType && x.CauseCode == alrt.CauseCode).GroupBy(x => x.DivisionId).Select(x => x.Key).FirstOrDefault();
                                                            }
                                                            <td>
                                                                @count

                                                                <input type="hidden" value="@count" />
                                                            </td>
                                                            <td><a href="javascript:void(0)" onclick="ShowAllFRSAlertAnalysisByZone('@alrt.AlertInfoId',this)">Zone</a></td>
                                                            <td><a href="javascript:void(0)" onclick="ShowAllFRSAlertAnalysisByDivision('@alrt.AlertInfoId',this)">Division</a></td>
                                                        </tr>
                                                        srNo++;
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>
</div>

<div class="row" id="SRNumberView">
    @Html.Partial("_SRNumberViewPartial",Model)



</div>

<script>
    $(document).ready(function () {

        $('.th-count').click(function () {
            var table = $(this).parents('table').eq(0)
            var rows = table.find('tr:gt(0)').toArray().sort(comparer($(this).index()))
            this.asc = !this.asc
            if (!this.asc) { rows = rows.reverse() }
            var th = $(this);
            th.siblings().find(".sort-symbol").remove();
            th.find('.sort-symbol').remove();
            th.append(`<span class="sort-symbol">${this.asc ? '▲' : '▼'}</span>`);
            for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
        })
    });
    function comparer(index) {
        return function (a, b) {
            var valA = getCellValue(a, index), valB = getCellValue(b, index)
            return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
        }
    }
    function getCellValue(row, index) {
        return $(row).children('td').eq(index).find('input[type=hidden]').val();
    }
    function ShowFRSAlertAnalysisDetails(siteId, alertInfoId, $this) {
        $("#loader").show();
        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.DivisionId = $('#drpAlertAnalysisDivision').val();
        mSearchCriteria.FromDate = $('#searchAlertAnalysisFromDate').val();
        mSearchCriteria.ToDate = $('#searchAlertAnalysisToDate').val();
        mSearchCriteria.SiteId = siteId;
        mSearchCriteria.AlertInfoId = alertInfoId;
        mAssetLister.SearchCriteria = mSearchCriteria;


        if (siteId != null && siteId != undefined && siteId > 0 && alertInfoId != null && alertInfoId != undefined && alertInfoId > 0) {
            $("#loader").show();
            $.ajax({
                url: '/AlertAnalysis/_EditFRSAlertList',
                type: 'Post',
                dataType: 'html',
                data: JSON.stringify(mAssetLister),
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#divProbabilityAlert").empty().append(data);
                    $("#modalProbabilityAlert").modal('show');
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("error", "Something went wrong!");
                }
            });
        }
    }

    function ShowAllFRSAlertAnalysisByDivision(alertInfoId, $this) {

        $("#loader").show();
        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.DivisionId = $('#drpAlertAnalysisDivision').val();
        mSearchCriteria.FromDate = $('#searchAlertAnalysisFromDate').val();
        mSearchCriteria.ToDate = $('#searchAlertAnalysisToDate').val();
        mSearchCriteria.AlertInfoId = alertInfoId;
        mAssetLister.SearchCriteria = mSearchCriteria;


        if (alertInfoId != null && alertInfoId != undefined && alertInfoId > 0) {
            $("#loader").show();
            $.ajax({
                url: '/AlertAnalysis/_EditAllFRSAlertAnalysisListByDivision',
                type: 'Post',
                dataType: 'html',
                data: JSON.stringify(mAssetLister),
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#divProbabilityAlert").empty().append(data);
                    $("#modalProbabilityAlert").modal('show');
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("error", "Something went wrong!");
                }
            });
        }
    }

    function ShowAllFRSAlertAnalysisByZone(alertInfoId, $this) {
        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.DivisionId = $('#drpAlertAnalysisDivision').val();
        mSearchCriteria.FromDate = $('#searchAlertAnalysisFromDate').val();
        mSearchCriteria.ToDate = $('#searchAlertAnalysisToDate').val();
        mSearchCriteria.AlertInfoId = alertInfoId;
        mAssetLister.SearchCriteria = mSearchCriteria;

        if (alertInfoId != null && alertInfoId != undefined && alertInfoId > 0) {
            $("#loader").show();
            $.ajax({
                url: '/AlertAnalysis/_EditAllFRSAlertAnalysisListByZone',
                type: 'Post',
                dataType: 'html',
                data: JSON.stringify(mAssetLister),
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#divProbabilityAlert").empty().append(data);
                    $("#modalAlertByZone").modal('show');
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("error", "Something went wrong!");
                }
            });
        }
    }


    function fnUpdateFRSTabulationRemark(siteId, assetId, alertInfoId) {
        var mFRSAlertAudit = {};
        var isValid = true;
        mFRSAlertAudit.SiteId = siteId
        mFRSAlertAudit.AssetId = assetId
        mFRSAlertAudit.AlertInfoId = alertInfoId;
        mFRSAlertAudit.Remark = $('#txtAlertRemark' + assetId + alertInfoId).val();

        if ($("#drpAlertType" + assetId + alertInfoId).val() == 'True') {
            mFRSAlertAudit.IsAlert = true;
            mFRSAlertAudit.Remark = '';
        } else {
            mFRSAlertAudit.IsAlert = false;
        }
        mFRSAlertAudit.IsOpenClose = true;


        if (!mFRSAlertAudit.IsAlert && (mFRSAlertAudit.Remark == null || mFRSAlertAudit.Remark == undefined || mFRSAlertAudit.Remark == '')) {
            isValid = false;
            alert('Remark is required!')
        }

        if (isValid) {
            $("#loader").show();
            $.ajax({
                url: '/AlertAnalysis/UpdateFRSAlertAnalysisAudit',
                type: 'Post',
                data: '{mFRSAlertAudit:' + JSON.stringify(mFRSAlertAudit) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        //$('#modalProbabilityAlert').modal('hide');
                        $("#drpAlertType" + assetId + alertInfoId).val('False');
                        $('#txtAlertRemark' + assetId + alertInfoId).removeAttr("disabled");
                        $('#txtAlertRemark' + assetId + alertInfoId).val('')

                        if (data.type == "success") {
                            alert("Alert remark has been Update")
                            //CommonNotification("SUCCESS", data.result, "success");
                        } else {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }


    function fnUpdateAllFRSAlertTabulationRemark() {
        var mAlertAudits = [];
        $('.clsDrpAlertType').each(function () {
            var isValid = true;
            var siteid = $(this).data('siteid');
            var alertTypeId = $(this).data('alerttypeid');
            var assetId = $(this).data('assetid');

            var AlertAudit = {};
            AlertAudit.SiteId = siteid
            AlertAudit.AssetId = assetId
            AlertAudit.AlertId = alertTypeId;
            AlertAudit.Remark = $('#txtAlertRemark' + assetId + alertTypeId).val();

            if ($("#drpAlertType" + assetId + alertTypeId).val() == 'True') {
                AlertAudit.IsAlert = true;
                AlertAudit.Remark = '';
            } else {
                AlertAudit.IsAlert = false;
            }
            AlertAudit.IsOpenClose = true;

            if ($("#drpAlertType" + assetId + alertTypeId).val() == 'False') {
                if (AlertAudit.Remark == null || AlertAudit.Remark == undefined || AlertAudit.Remark == '') {
                    isValid = false;
                }
            }
            if (isValid) {
                mAlertAudits.push(AlertAudit);
            }
        });

        if (mAlertAudits != null && mAlertAudits.length > 0) {
            $("#loader").show();
            $.ajax({
                url: '/Maintenace/UpdateAllTabulationAlertRemark',
                type: 'Post',
                data: '{mAlertAudits:' + JSON.stringify(mAlertAudits) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        $('#modalProbabilityAlert').modal('hide');
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                        } else {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            alert('Select at least one remark.')
        }
    }

    function fnShowFRSAlertInstance(frsAlertId) {
        var mFRSAlertInstance = {};
        mFRSAlertInstance.FRSAlertId = frsAlertId;
        $("#loader").show();
        $.ajax({
            url: '/AlertAnalysis/GetFRSAlertInstance',
            type: 'POST',
            dataType: 'html',
            data: JSON.stringify(mFRSAlertInstance),
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divFRSAlertInstance").empty().append(data);
                $('#modalFRSAlertInstance').modal('show');
            },
            error: function (response) {
                $("#loader").hide();
