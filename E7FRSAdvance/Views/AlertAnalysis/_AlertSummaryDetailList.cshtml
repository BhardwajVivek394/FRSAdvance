@model  List<Domain.FRSAlertAudit>
<style>
    .tableFixHead {
        overflow: auto;
        height: 100vh;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }
</style>

<div class="table-responsive tableFixHead">
    <table class="table">
        <thead>
            <tr>
                <th style="background-color: #215968;color:white;">Station</th>
                <th style="background-color: #215968;color:white;">Asset Type</th>
                <th style="background-color: #215968;color:white;">Asset</th>
                <th style="background-color: #215968;color:white;">Cause code</th>
                <th style="background-color: #215968;color:white;">Alert Message</th>
                <th style="background-color: #215968;color:white;">Alert Timestamp</th>
                <th style="background-color: #215968;color:white;">Remark</th>
                <th style="background-color: #215968;color:white;" class="text-center">True/False</th>
                <th style="background-color: #215968;color:white;">Issue Type</th>
                <th style="background-color: #215968;color:white;">Audit By</th>
                @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode())
                {
                    <th style="background-color: #215968;color:white;">Delete</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Site</td>
                        <td>@item.AssetType</td>
                        <td>@item.Asset</td>
                        <td>@item.CauseCode</td>
                        <td>@item.AlertMessage</td>
                        <td>
                            @if (item.TimeStamp != null && item.TimeStamp.Value != DateTime.MinValue)
                            {
                                <span>
                                    @item.TimeStamp.Value.ToString("dd/MM/yyyy HH:mm:ss")
                                </span>
                            }

                        </td>
                        <td>@item.Remark</td>
                        <td class="text-center">@item.IsAlert</td>
                        <td>
                            @if (item.IssueTypeId != null)
                            {
                                <span>
                                    @((E7FRSAdvance.Utility.Utility.FRSAlertIssue)Enum.ToObject(typeof(E7FRSAdvance.Utility.Utility.FRSAlertIssue), item.IssueTypeId))
                                </span>
                            }
                        </td>
                        <td class="text-center">@item.CreatedName</td>
                        <td class="text-center">
                            @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode())
                            {
                                <a href="javascript:void(0)" onclick="fnDeleteFRSAlertAudit('@item.Id')"><i class="fa fa-trash text-danger"></i></a>
                            }
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
</div>


