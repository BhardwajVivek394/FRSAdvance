
@{
    ViewBag.Title = "Alert Analysis";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="~/assets/js/paho-mqtt.js"></script>
<style>
    .pill-badge-primary1 {
        background-color: White;
    }

    body .mail-body-wrapper ul li {
        padding: 16px;
        display: flex;
        align-items: center;
        cursor: pointer;
        border-bottom: 1px solid #bebebe;
    }

    .pull-right {
        float: right;
    }

    body .mail-body-wrapper ul li .inbox-message .email-data .badge {
        border-radius: 20px;
    }

    body .mail-body-wrapper ul li .inbox-message {
        display: flex;
        justify-content: space-between;
        width: 100%;
        gap: 16px;
    }

        body .mail-body-wrapper ul li .inbox-message .email-data span {
            font-weight: 500;
            letter-spacing: 0.3;
            display: -webkit-box;
            max-width: 100%;
            margin: 0 auto;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            color: rgba(82, 82, 108, 0.8);
        }
</style>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Alert Analysis</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div>
    @using (Ajax.BeginForm("_AlertAnalysis", "AlertAnalysis", new AjaxOptions()
    {
        HttpMethod = "POST",
        UpdateTargetId = "divAlertAnalysisList",
        InsertionMode = InsertionMode.Replace,
        LoadingElementId = "loader"
    }, new { id = "frmAlertAnalysisList" }))
    {
        { HtmlHelper.ClientValidationEnabled = false; }
        <div id="divAlertAnalysisList">
            @Html.Action("_AlertAnalysis")
        </div>
    }
</div>



<div id="divFRSAlertInstance"></div>
<div id="divFRSAlertAudit"></div>
<div id="divAssetAttributePartial"></div>
<div id="FRSAlertAuditView"></div>