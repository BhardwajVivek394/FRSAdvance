@model  List<Domain.FRSAlertAudit>

<div class="modal bounceIn animated" id="modalFRSAlertAuditView" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader">FRS Alert Audit List</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Asset Type</th>
                                <th>Asset</th>
                                <th>Actual Alert Date</th>
                                <th>Audit Date</th>
                                <th>Audit Name</th>
                                <th>Issue Type</th>
                                <th>Remark</th>
                                <th>Railway Remark</th>
                                <th>Resolve By</th>
                                <th>Resolve Date</th>
                                <th>Resolve Remark</th>
                            </tr>
                        </thead>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.AssetType</td>
                                    <td>@item.Asset</td>
                                    <td>
                                        @if (item.TimeStamp != null && item.TimeStamp != DateTime.MinValue)
                                        {
                                            <span>@item.TimeStamp.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                        }
                                    </td>
                                    <td>@item.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td>@item.CreatedName</td>
                                    <td>
                                        @if (item.IssueTypeId != null && item.IssueTypeId.Value > 0)
                                        {
                                            <span>
                                                @((E7FRSAdvance.Utility.Utility.FRSAlertIssue)Enum.ToObject(typeof(E7FRSAdvance.Utility.Utility.FRSAlertIssue), item.IssueTypeId))
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @item.Remark
                                    </td>
                                    <td>
                                        @if (item.IsAlert)
                                        {
                                            <span>@item.RailwayRemark</span>
                                        }
                                    </td>
                                    <td>@item.ResolvedName</td>
                                    <td>
                                        @if (item.ResolvedDate != null && item.ResolvedDate != DateTime.MinValue)
                                        {
                                            <span>@item.ResolvedDate.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                        }

                                    </td>
                                    <td>@item.ResolvedRemark</td>
                                </tr>
                            }
                        }

                    </table>

                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(function () {
        $(".modal-dialog").draggable({
            handle: ".modal-header"
        });
    });
</script>
