@model List<Domain.FRSAlertAudit>

@{
    var zones = new List<Domain.Zone>();
    var divisions = new List<Domain.Division>();
    if (ViewBag.Zones != null)
    {
        zones = ViewBag.Zones as List<Domain.Zone>;
    }
    if (ViewBag.Divisions != null)
    {
        divisions = ViewBag.Divisions as List<Domain.Division>;
    }
}



<div class="card">
    <div class="card-header">
        <h6>Zone Wise</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">

                @if (Model != null && Model.Count > 0)
                {
                    var zoneIds = Model.GroupBy(x => x.ZoneId).Select(x => x.Key).ToList();
                    if (zoneIds != null && zoneIds.Count > 0)
                    {
                        <thead class="bg-primary">
                            <tr>
                                <th>Zone</th>
                                <th class="text-center">HardWare</th>
                                <th class="text-center">HardWare Resolved</th>
                                <th class="text-center">HardWare Pending</th>
                                <th class="text-center">Calibration</th>
                                <th class="text-center">Calibration Resolved</th>
                                <th class="text-center">Calibration Pending</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var zoneId in zoneIds)
                            {
                                var hardwareCount = Model.Where(x => x.ZoneId == zoneId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                var hardwareResolvedCount = Model.Where(x => x.ZoneId == zoneId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware && x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                var hardwareUnResolvedCount = Model.Where(x => x.ZoneId == zoneId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware && !x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();

                                var calibrationCount = Model.Where(x => x.ZoneId == zoneId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Calibration).Count();
                                var calibrationResolvedCount = Model.Where(x => x.ZoneId == zoneId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Calibration && x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                var calibrationUnResolvedCount = Model.Where(x => x.ZoneId == zoneId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Calibration && !x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                if (hardwareCount > 0 || calibrationCount > 0)
                                {
                                    <tr class="table-light">
                                        <td>
                                            @if (zones != null && zones.Count > 0)
                                            {
                                                <span>@zones.Where(x => x.Id == zoneId).Select(x => x.Name).FirstOrDefault()</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @hardwareCount
                                        </td>
                                        <td class="text-center">
                                            @hardwareResolvedCount
                                        </td>
                                        <td class="text-center">
                                            @hardwareUnResolvedCount
                                        </td>
                                        <td class="text-center">
                                            @calibrationCount
                                        </td>
                                        <td class="text-center">
                                            @calibrationResolvedCount
                                        </td>
                                        <td class="text-center">
                                            @calibrationUnResolvedCount
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>

                    }
                }


            </table>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h6>Division Wise</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table">
                @if (Model != null && Model.Count > 0)
                {
                    var divisionIds = Model.GroupBy(x => x.DivisionId).Select(x => x.Key).ToList();
                    if (divisionIds != null && divisionIds.Count > 0)
                    {
                        <thead class="bg-primary">
                            <tr>
                                <th>Division</th>
                                <th class="text-center">HardWare</th>
                                <th class="text-center">HardWare Resolved</th>
                                <th class="text-center">HardWare Pending</th>
                                <th class="text-center">Calibration</th>
                                <th class="text-center">Calibration Resolved</th>
                                <th class="text-center">Calibration Pending</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var divisionId in divisionIds)
                            {
                                var hardwareCount = Model.Where(x => x.DivisionId == divisionId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                var hardwareResolvedCount = Model.Where(x => x.DivisionId == divisionId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware && x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                var hardwareUnResolvedCount = Model.Where(x => x.DivisionId == divisionId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Hardware && !x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();

                                var calibrationCount = Model.Where(x => x.DivisionId == divisionId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Calibration).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                var calibrationResolvedCount = Model.Where(x => x.DivisionId == divisionId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Calibration && x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                var calibrationUnResolvedCount = Model.Where(x => x.DivisionId == divisionId && x.IssueTypeId == (int)E7FRSAdvance.Utility.Utility.FRSAlertIssue.Calibration && !x.IsResolved).GroupBy(x => new { x.AssetId, x.AlertInfoId }).Select(x => x.Key).Count();
                                if (hardwareCount > 0 || calibrationCount > 0)
                                {
                                    <tr class="table-light">
                                        <td>
                                            @if (divisions != null && divisions.Count > 0)
                                            {
                                                <span>@divisions.Where(x => x.Id == divisionId).Select(x => x.Name).FirstOrDefault()</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @hardwareCount
                                        </td>
                                        <td class="text-center">
                                            @hardwareResolvedCount
                                        </td>
                                        <td class="text-center">
                                            @hardwareUnResolvedCount
                                        </td>
                                        <td class="text-center">
                                            @calibrationCount
                                        </td>
                                        <td class="text-center">
                                            @calibrationResolvedCount
                                        </td>
                                        <td class="text-center">
                                            @calibrationUnResolvedCount
                                        </td>
                                    </tr>
                                }
                            }


                        </tbody>

                    }
                }
            </table>
        </div>
    </div>
</div>



