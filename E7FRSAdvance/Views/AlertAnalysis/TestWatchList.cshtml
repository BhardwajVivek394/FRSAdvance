
@{
    ViewBag.Title = "GetTestWatchList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="~/assets/js/paho-mqtt.js"></script>
<style>
    .tableFixHead {
        overflow: auto;
        height: 100vh;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }

    .email-body .mail-body-wrapper ul li:hover .inbox-message .email-timing {
        display: flex !important;
    }
</style>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Test Watch List</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="col-12">
    <div class="card">
        <div class="card-header">
            <div class="row">
                <div class="col-xl-2 col-lg-6">
                    <strong>Site</strong>
                    @Html.DropDownList("drpAlertAnalysisSite", (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 3 })
                </div>
                <div class="col-xl-1 col-lg-6">
                    <strong>From Date</strong>
                    <input class="form-control col-lg-9" id="searchAlertAnalysisFromDate" placeholder="From Date" type="text">
                </div>
                <div class="col-xl-1 col-lg-6">
                    <strong>To Date</strong>
                    <input class="form-control col-lg-9" id="searchAlertAnalysisToDate" placeholder="To Date" type="text">
                </div>

                <div class="col-xl-4 col-lg-6 mt-3">
                    <a class="btn btn-success btn-quirk" onclick="fnRefreshTestWatchListPartial()">Search</a>
                </div>

            </div>
        </div>
        <div class="card-body">
            <div id="divAlertAnalysisList"></div>
        </div>
    </div>

</div>
<div id="divFRSAlertAudit"></div>
<div id="FRSAlertAuditView"></div>
<div id="divFRSAlertInstance"></div>
<div id="divAssetAttributePartial"></div>

<script>

    $(document).ready(function () {
        fnRefreshTestWatchListPartial();

        $('#searchAlertAnalysisFromDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        });

        $('#searchAlertAnalysisToDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        });
    });

    function fnRefreshTestWatchListPartial() {

        $("#loader").show();
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#drpAlertAnalysisSite').val();
        mSearchCriteria.StartDate = $('#searchAlertAnalysisFromDate').val();
        mSearchCriteria.EndDate = $('#searchAlertAnalysisToDate').val();

        $("#loader").show();
        $.ajax({
            url: '/AlertAnalysis/_TestWatchList',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mSearchCriteria),
            dataType: 'html',
            success: function (data) {

                $("#loader").hide();
                $("#divAlertAnalysisList").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });


    }
</script>
