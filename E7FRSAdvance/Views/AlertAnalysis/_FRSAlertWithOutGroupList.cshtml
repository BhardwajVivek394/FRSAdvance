@model Domain.FRSAlertLister

<style>
    .pill-badge-primary1 {
        background-color: White;
    }

    body .mail-body-wrapper ul li {
        padding: 16px;
        display: flex;
        align-items: center;
        cursor: pointer;
        border-bottom: 1px solid #bebebe;
    }

    .pull-right {
        float: right;
    }

    body .mail-body-wrapper ul li .inbox-message .email-data .badge {
        border-radius: 20px;
    }

    body .mail-body-wrapper ul li .inbox-message {
        display: flex;
        justify-content: space-between;
        width: 100%;
        gap: 16px;
    }

        body .mail-body-wrapper ul li .inbox-message .email-data span {
            font-weight: 500;
            letter-spacing: 0.3;
            display: -webkit-box;
            max-width: 100%;
            margin: 0 auto;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            color: rgba(82, 82, 108, 0.8);
        }
</style>

<div class="modal bounceIn animated" id="modalAlertViewList" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Alert Log</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12" id="model-div">
                        <div class="row">
                            <div class="col-sm-12">
                                @if (Model.mFRSAlerts != null && Model.mFRSAlerts.Count > 0)
                                {
                                    <div class="mail-body-wrapper">
                                        <ul id="paginated-list" data-current-page="1" aria-live="polite" class="modal-fixed-height">
                                            @if (Model.mFRSAlerts != null && Model.mFRSAlerts.Count > 0)
                                            {
                                                foreach (var frsAlert in Model.mFRSAlerts)
                                                {
                                                    <li class="inbox-data">
                                                        <div class="inbox-message">
                                                            <div class="email-data">
                                                                <span>
                                                                    @frsAlert.SetAlertMessage
                                                                </span>
                                                                <span>
                                                                    @Html.Raw(frsAlert.Description)
                                                                </span>
                                                                @if (!string.IsNullOrEmpty(frsAlert.ResetAlertMessage))
                                                                {
                                                                    <br />
                                                                    <b>
                                                                        <u>
                                                                            Reset Message
                                                                        </u>
                                                                    </b>
                                                                    <span>
                                                                        @Html.Raw(frsAlert.ResetAlertMessage)
                                                                    </span>
                                                                }
                                                                @if (frsAlert.IsActive)
                                                                {
                                                                    <div class="span badge rounded-pill pill-badge-danger">Active</div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="span badge rounded-pill pill-badge-success">InActive</div>
                                                                }
                                                            </div>
                                                            <div class="email-options">
                                                                <span>@frsAlert.SetTimeStamp.ToString()</span>
                                                            </div>
                                                        </div>
                                                    </li>
                                                }

                                            }
                                        </ul>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>