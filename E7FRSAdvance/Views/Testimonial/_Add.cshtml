@model Domain.Testimonial

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />
@Html.HiddenFor(m => m.Id, new { @id = "hdnId" })
<input type="hidden" value="@Model.AssetId" id="hdnAssetId" />
<input type="hidden" value="@Model.SiteId" id="hdnSiteId" />

<div class="modal fade" id="modal-add-Testimonial" role="dialog" aria-labelledby="modal-add-Testimonial" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Testimonial</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Edit Testimonial</span></h4>
                }
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="form-horizontal">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label">Division <span class="text-danger">*</span></label>
                                    <div class="">
                                        @Html.DropDownListFor(m => m.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, new { @class = "form-control", id = "drpDivision", tabindex = 1 })
                                        <span class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label">Site <span class="text-danger">*</span></label>
                                    <div class="">
                                        @Html.DropDownListFor(m => m.SiteId, (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 2, @id = "drpSite" })
                                        <span class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label">Asset Type <span class="text-danger">*</span></label>
                                    <div class="">
                                        @Html.DropDownListFor(m => m.AssetTypeId, (IEnumerable<SelectListItem>)ViewBag.AssetTypes, "Select", new { @class = "form-control", tabindex = 3, @id = "drpAssetType" })
                                        <span class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <label class="form-label">Asset <span class="text-danger">*</span></label>
                                    <div class="">
                                        <select id="drpAssetId" name="AssetId" class="form-control"></select>
                                        <span class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="mb-3">
                                <label class="form-label">Remark <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextAreaFor(x => x.Remark, new { @class = "form-control" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    @if (Model.Id <= 0)
                    {
                        <div class="col-sm-12">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="mb-3">
                                        <label class="form-label">Upload Image</label>
                                        <div class="">
                                            <input type="file" id="UploadImg" name="UploadImg" accept="image/*" class="form-control" onchange="fnUploadImageFile(this)" multiple>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">

                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12">
                            <div class="mb-3 row" id="divImage">
                                @*@if (Model.TestimonialImages != null && Model.TestimonialImages.Count > 0)
                                    {
                                        foreach (var supportTestimonialImage in Model.TestimonialImages)
                                        {
                                            <div class="col-sm-3">
                                                <img height="100" width="100" src="data:image/png;base64,@supportTestimonialImage.FileBase64" />
                                            </div>
                                        }
                                    }*@
                            </div>
                        </div>
                    }

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()">Save</button>
            </div>
        </div>
    </div>
</div>


<script src="@Url.Content("~/Content/PageJS/Testimonial/Add.js")"></script>
