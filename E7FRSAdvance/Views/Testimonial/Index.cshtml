@model Domain.TestimonialLister
@{
    ViewBag.Title = "Testimonial";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Testimonial</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">
        @using (Ajax.BeginForm("_List", "Testimonial", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divTestimonialList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmTestimonialList" }))
        {
            <div id="divTestimonialList">
                @Html.Action("_List", Model)
            </div>
        }

    </div>
    <div class="">
        @using (Ajax.BeginForm("Create", "Testimonial", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divTestimonialCreate",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmTestimonialCreate" }))
        {
            <div id="divTestimonialCreate">
                @Html.Partial("_Add", new Domain.Testimonial())
            </div>
        }
    </div>
    <div id="divTestimonialViewRemark">

    </div>
    <div id="divTestimonialRemark">

    </div>

    <div id="divTestimonialRailwayRemark">

    </div>
</div>
