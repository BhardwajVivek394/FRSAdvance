@model Domain.TestimonialLister

@Html.HiddenFor(m => m.SearchCriteria.ColumnName, new { id = "hdnColumnName" })
@Html.HiddenFor(m => m.SearchCriteria.SortDirection, new { id = "hdnSortDirection" })

<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />

<div class="container-fluid">
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <div class="people-options clearfix">
                        <div class="row">
                            <div class="col-md-2">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Zone</strong>
                                @Html.DropDownListFor(m => m.SearchCriteria.ZoneId, (IEnumerable<SelectListItem>)ViewBag.Zones, new { @class = "form-control", id = "zoneAdd1", tabindex = 1 })
                            </div>
                            <div class="col-md-2">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Division</strong>
                                <input type="hidden" id="hdnSearchDivisionId" value="@Model.SearchCriteria.DivisionId" />
                                @Html.DropDownListFor(m => m.SearchCriteria.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, new { @class = "form-control", id = "divisions", tabindex = 1 })
                            </div>
                            <div class="col-md-4 mt-4">
                                <a class="btn btn-success btn-quirk" onclick="Search()">Search</a>
                                <a id="btnAddTicket" class="btn btn-primary btn-quirk" onclick="GetById(0)">Add Testimonial</a>
                                <a class="btn btn-primary btn-quirk" onclick="fnDownloadTestimonial()">Download</a>
                                
                            </div>

                            <div class="col-md-4 mt-4">
                                <div class="btn-group pull-right people-pager">
                                    @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
                                    @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
                                </div>

                                <div class="btn-group pull-right">

                                    <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left "></i></button>
                                    <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>

                                </div>
                                @{
                                    int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
                                    if (Model.Testimonials.Count == 0)
                                    {
                                        start = 0;
                                    }
                                    decimal end = Math.Floor(Model.Pager.TotalRecord);
                                    if (Model.Pager.PageSize < Model.Pager.TotalRecord)
                                    {
                                        if (Model.Pager.PageSize == -1)
                                        {
                                            end = Model.Pager.TotalRecord;
                                        }
                                        else
                                        {
                                            end = Model.Pager.PageSize * Model.Pager.CurrentPage;
                                            if (end > Model.Pager.TotalRecord)
                                            {
                                                end = Model.Pager.TotalRecord;
                                            }
                                        }
                                    }
                                }
                                <span class="people-count pull-right" style="margin-top:10px;">Showing <strong>@start - @Math.Floor(end)</strong> of <strong>@Math.Floor(Model.Pager.TotalRecord)</strong> Testimonial </span>
                            </div>

                        </div>

                    </div>
                </div>
                <div class="col-12">
                    <div class="card-body " style="padding:15px;">
                        <div class="table-responsive vh-100">
                            <table class="table">
                                <thead class="bg-primary">
                                    <tr>
                                        <th colspan="2" class="text-center">Action</th>
                                        <th data-sortcolumn="Division" class="sorting" id="thDivision" onclick="SortList('Division');">Division</th>
                                        <th data-sortcolumn="Site" class="sorting" id="thSite" onclick="SortList('Site');">Site</th>
                                        <th data-sortcolumn="AssetType" class="sorting" id="thAssetType" onclick="SortList('AssetType');">Asset Type</th>
                                        <th data-sortcolumn="Asset" class="sorting" id="thAsset" onclick="SortList('Asset');">Asset</th>
                                        <th data-sortcolumn="Remark" class="sorting text-center" id="thRemark" onclick="SortList('Remark');">Remark</th>
                                        <th data-sortcolumn="RailwayRemark" class="sorting text-center" id="thRailwayRemark" onclick="SortList('RailwayRemark');">Railway response</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Testimonials != null && Model.Testimonials.Count > 0)
                                    {
                                        foreach (var item in Model.Testimonials)
                                        {
                                            <tr class="table-light">
                                                <td class="text-center" style="width:50px;">
                                                    <a title="Edit">
                                                        <i class="text-vision fa fa-edit" onclick="GetById('@item.Id')"></i>
                                                    </a>
                                                </td>
                                                <td class="text-center " style="width:50px;">
                                                    <a title="Delete">
                                                        <i class="text-danger fa fa-trash" onclick="DeleteById('@item.Id')"></i>
                                                    </a>

                                                </td>
                                                <td>@item.Division</td>
                                                <td>@item.Site</td>
                                                <td>@item.AssetType</td>
                                                <td>@item.Asset</td>
                                                <td class="text-center">
                                                    <a title="View Remark" href="javascript:void(0)" class="btn btn-info" onclick="fnViewRemark('@item.Id', false); return false;">
                                                        <i class="text-vision fa fa-eye"></i>
                                                    </a>
                                                    <a title="Add Remark" href="javascript:void(0)" class="btn btn-info" onclick="fnShowRemark('@item.Id'); return false;">
                                                        <i class="text-vision fa fa-plus"></i>
                                                    </a>
                                                </td>
                                                <td class="text-center">
                                                    <a title="View Railway response" href="javascript:void(0)" class="btn btn-info" onclick="fnViewRemark('@item.Id', true); return false;">
                                                        <i class="text-vision fa fa-eye"></i>
                                                    </a>
                                                    <a title="Add Railway response" href="javascript:void(0)" class="btn btn-info" onclick="fnShowRailwayRemark('@item.Id'); return false;">
                                                        <i class="text-vision fa fa-plus"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center">
                                                No record found
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/Content/PageJS/Testimonial/List.js")"></script>
<script>
    function fnDownloadTestimonial() {
        if ($('#divisions').val() != null && $('#divisions').val() != undefined && $('#divisions').val() != '0') {
            window.location.href = "@Url.Action("DownloadTestimonial")?divisionId=" + $('#divisions').val();
        } else {
            alert("Please select division");
        }
    }
    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmTestimonialList").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize)
            {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmTestimonialList").submit();
            }
        }
    }
</script>
