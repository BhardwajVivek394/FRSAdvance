@model Domain.Testimonial


<div class="modal fade" id="modal-add-testimonialViewRemark" role="dialog" aria-labelledby="modal-add-testimonialViewRemark" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                @if (ViewBag.IsRailway != null && ViewBag.IsRailway == true)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">View Railway Response</span></h4>
                }
                else
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">View Remark</span></h4>
                }
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="form-horizontal">
                    <div class="col-sm-12">
                        <div class="row">
                            <h6 class="form-label">Remark</h6>
                            @if (ViewBag.IsRailway != null && ViewBag.IsRailway == true)
                            {
                                <div class="">
                                    <label>@Model.RailwayRemark</label>
                                </div>
                            }
                            else
                            {
                                <div class="">
                                    <label>@Model.Remark</label>
                                    <span class="text-danger"></span>
                                </div>
                            }

                        </div>
                    </div>
                    <div class="col-sm-12">
                        @if (Model.TestimonialImages != null && Model.TestimonialImages.Count > 0)
                        {
                            int counter = 0;
                            foreach (var supportTestimonialImage in Model.TestimonialImages)
                            {
                                counter++;
                                <h6 class="form-label">Images @counter</h6>
                                <div class="mb-3 row">
                                    <div class="col-sm-12">
                                        <img style="height:100%;width:100%" src="data:image/png;base64,@supportTestimonialImage.FileBase64" />
                                    </div>
                                </div>
                                <hr />
                            }
                        }

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
            </div>
        </div>
    </div>
</div>



