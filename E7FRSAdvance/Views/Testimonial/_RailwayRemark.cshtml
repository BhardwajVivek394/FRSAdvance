@model Domain.Testimonial

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />
@Html.HiddenFor(m => m.Id, new { @id = "hdnRailwayRemarkId" })

<div class="modal fade" id="modal-add-testimonialRailwayRemark" role="dialog" aria-labelledby="modal-add-testimonialRailwayRemark" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Railway Response</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="form-horizontal">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="mb-3">
                                <h6 class="form-label">Remark <span class="text-danger">*</span></h6>
                                <div class="">
                                    @Html.TextAreaFor(x => x.RailwayRemark, new { @class = "form-control" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="mb-3">
                                    <h6 class="form-label">Upload Image</h6>
                                    <div class="">
                                        <input type="file" id="UploadImg" name="UploadImg" accept="image/*" class="form-control" onchange="fnUploadRailwayRemarkImageFile(this)" multiple>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">

                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="mb-3 row" id="divRailwayRemarkImage">
                            @*@if (Model.TestimonialImages != null && Model.TestimonialImages.Count > 0)
                            {
                                foreach (var supportTestimonialImage in Model.TestimonialImages)
                                {
                                    <div class="col-sm-12">
                                        <img style="height:100%;width:100%" src="data:image/png;base64,@supportTestimonialImage.FileBase64" />
                                    </div>
                                }
                            }*@
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSaveTestimonialRailwayRemark()">Save</button>
            </div>
        </div>
    </div>
</div>


<script src="@Url.Content("~/Content/PageJS/Testimonial/Add.js")"></script>

