@model List<Domain.Datalogger>

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modalDataloggerEventData" tabindex="-1" aria-labelledby="modalDataloggerEventData" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader">Data Logger Event</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="table-responsive">
                                @{
                                    string assetsName = string.Empty;
                                }
                                <table class="table" id="tblDatalogger">
                                    <thead>
                                        <tr>
                                            <th>SR No.</th>
                                            <th>Asset Name</th>
                                            <th>Current Value</th>
                                            <th>Time Stamp</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyJsonView">
                                        @if (Model != null && Model.Count > 0)
                                        {
                                            foreach (var item in Model.OrderByDescending(x => x.Date))
                                            {
                                                <tr>
                                                    <td>@item.SrNo</td>
                                                    <td>@item.AssetName</td>
                                                    <td>
                                                        @if (item.CurrentValue == "Pickup")
                                                        {
                                                            <span class='badge badge-success'>Pickup</span>
                                                        }
                                                        else if (item.CurrentValue == "Drop")
                                                        {
                                                            <span class='badge badge-warning'>DROP</span>
                                                        }

                                                    </td>
                                                    <td>@item.Timestamp</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>

                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal">Close</a>
            </div>
        </div>
    </div>
</div>

