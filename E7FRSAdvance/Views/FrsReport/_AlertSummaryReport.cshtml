@model  Domain.FRSAlertLister

@{
    var frsAlertSummary = Model.mFRSAlerts.ToList();
}
<style>
    td {
        padding: 10px;
    }
</style>
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-1">
                            <strong style="margin-bottom:10px;margin-right:10px;">Search</strong>
                        </div>
                        <div class="row">
                            <div class="col-lg-2 mt-2">
                                <span>Zone</span>
                                @Html.DropDownListFor(x => x.SearchCriteria.ZoneId, (IEnumerable<SelectListItem>)ViewBag.Zones, "All", new { @class = "form-control", tabindex = 1, @id = "drpAlertSummaryZone" })
                            </div>
                            <div class="col-lg-2 mt-2">
                                <span>Division</span>
                                <input type="hidden" id="hdnAlertSummaryDivisionId" value="" />
                                @Html.DropDownListFor(x => x.SearchCriteria.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, "All", new { @class = "form-control", tabindex = 2, @id = "drpAlertSummaryDivision" })
                            </div>
                            <div class="col-lg-2 mt-2">
                                <span>Section</span>
                                @Html.DropDownListFor(x => x.SearchCriteria.SectionId, (IEnumerable<SelectListItem>)ViewBag.Sections, "All", new { @class = "form-control", @id = "drpAlertSummarySection", tabindex = 3 })
                            </div>
                            <div class="col-lg-2 mt-2">
                                <span>Site</span>
                                <input type="hidden" id="hdnAlertSummarySiteId" value="" />
                                @Html.DropDownListFor(x => x.SearchCriteria.SiteId, (IEnumerable<SelectListItem>)ViewBag.Sites, "All", new { @class = "form-control", tabindex = 3, @id = "drpAlertSummarySites" })
                            </div>
                            <div class="col-lg-2 mt-2">
                                <span>Asset Type</span>
                                @Html.DropDownListFor(x => x.SearchCriteria.AssetTypeId, (IEnumerable<SelectListItem>)ViewBag.AssetTypes, "All", new { @class = "form-control", tabindex = 4, @id = "drpAlertSummaryAssetType" })
                            </div>
                            <div class="col-lg-2 mt-2">
                                <span>Asset Number</span>
                                <select id="drpAlertSummaryAssetNumber" class="form-control">
                                    <option value="0">Select</option>
                                </select>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-2 mt-2">
                                <span>From Date</span>
                                <input class="form-control col-lg-9" id="txtAlertSummaryFromDate" placeholder="From Date" type="text" value="@Model.SearchCriteria.FromDate.ToShortDateString()">
                            </div>
                            <div class="col-lg-2 mt-2">
                                <span>To Date</span>
                                <input class="form-control col-lg-9" id="txtAlertSummaryToDate" placeholder="To Date" type="text" value="@Model.SearchCriteria.ToDate.ToShortDateString()">
                            </div>
                            <div class="col-lg-2 mt-2">
                                <span>View</span>
                                @Html.DropDownList("drpAlertSummaryView", new List<SelectListItem>
                                {
                                new SelectListItem { Text = "Table", Value = "1"},
                                new SelectListItem { Text = "Pie", Value = "2"},
                                new SelectListItem { Text = "Bar", Value = "3"}
                                }, new { @class = "form-control" })
                            </div>
                            <div class="col-lg-2 mt-2" id="graphView">
                                <input type="hidden" id="hdnGraphView" value="1" />
                                <span>Group Type</span>
                                @Html.DropDownList("drpAlertSummaryGraphView", new List<SelectListItem>
                                {
                                new SelectListItem { Text = "Asset Type", Value = "1"},
                                new SelectListItem { Text = "Asset Number", Value = "2"}
                                }, "Select", new { @class = "form-control" })
                            </div>
                            <div class="col-lg-2 mt-4">
                                <span style="display:none;">View</span>
                                <a class="btn btn-success btn-quirk" onclick="fnGetAlertSummaryReport()">Search</a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="card-body">
                <div class="row">
                    @*<div class="col-xl-12">
                            <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-primary" onclick="fnGroupAlertSummaryView()" title="Grid View"><i class="fa fa-group"></i></a></span>
                            <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-info" onclick="fnListAlertSummaryView()" title="List View"><i class="fa fa-list"></i></a></span>
                        </div>*@
                    <div class="col-xl-12" id="AlertSummaryListView">
                        <div id="tableView" class="row mt-4">
                            <div class="col-12 mt-2">
                                <div class="table-responsive tableFixHead tblAssetGroup" style="max-height: 620px;">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th style="background-color:#4bacc6;color:white;">Zone</th>
                                                <th style="background-color:#215968;color:white;">Division</th>
                                                <th style="background-color:#404040;color:white;">Section</th>
                                                <th style="background-color:#4bacc6;color:white;">Site</th>
                                                <th style="background-color:#215968;color:white;">Asset Type</th>
                                                <th style="background-color:#404040;color:white;">Asset Number</th>
                                                <th style="background-color:#4bacc6;color:white;" class="text-center">
                                                    Failure Alert Count
                                                </th>
                                                <th style="background-color:#215968;color:white;" class="text-center">Precitive Alert Count</th>
                                                <th style="background-color:#404040;color:white;" class="text-center">Total Count</th>
                                                <th style="background-color: #4bacc6; color: white;" class="text-center">
                                                    % of True feedback for Failure Alert
                                                </th>
                                                <th style="background-color: #215968; color: white;" class="text-center">
                                                    % of True feedback for Predictive Alert
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody style="max-height: 620px;overflow-y:auto;">
                                            @if (Model != null && Model.mFRSAlerts != null && Model.mFRSAlerts.Count > 0)
                                            {
                                                var alertSummaryReport =
                                                Model.mFRSAlerts
                                                .GroupBy(c => new
                                                {
                                                    c.ZoneName,
                                                    c.DivisionName,
                                                    c.SectionName,
                                                    c.SiteName,
                                                    c.AssetType,
                                                    c.AssetName,
                                                })
                                                .Select(gcs => new
                                                {
                                                    gcs.Key.ZoneName,
                                                    gcs.Key.DivisionName,
                                                    gcs.Key.SectionName,
                                                    gcs.Key.SiteName,
                                                    gcs.Key.AssetType,
                                                    gcs.Key.AssetName,
                                                    Count = gcs.Count()
                                                }).ToList();

                                                foreach (var item in alertSummaryReport)
                                                {
                                                    var precount = Model.mFRSAlerts.Where(x => x.SiteName.Trim().ToUpper() == item.SiteName.Trim().ToUpper() && x.AssetName.Trim().ToUpper() == item.AssetName.Trim().ToUpper() && x.AssetType.Trim().ToUpper() == item.AssetType.Trim().ToUpper() && x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive).Count();
                                                    var preackcount = Model.mFRSAlerts.Where(x => x.SiteName.Trim().ToUpper() == item.SiteName.Trim().ToUpper() && x.AssetName.Trim().ToUpper() == item.AssetName.Trim().ToUpper() && x.AssetType.Trim().ToUpper() == item.AssetType.Trim().ToUpper() && x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive && x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True).Count();


                                                    var failcount = Model.mFRSAlerts.Where(x => x.SiteName.Trim().ToUpper() == item.SiteName.Trim().ToUpper() && x.AssetName.Trim().ToUpper() == item.AssetName.Trim().ToUpper() && x.AssetType.Trim().ToUpper() == item.AssetType.Trim().ToUpper() && x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure).Count();
                                                    var failackcount = Model.mFRSAlerts.Where(x => x.SiteName.Trim().ToUpper() == item.SiteName.Trim().ToUpper() && x.AssetName.Trim().ToUpper() == item.AssetName.Trim().ToUpper() && x.AssetType.Trim().ToUpper() == item.AssetType.Trim().ToUpper() && x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure && x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True).Count();
                                                    <tr>
                                                        <td>@item.ZoneName</td>
                                                        <td>@item.DivisionName</td>
                                                        <td>@item.SectionName</td>
                                                        <td>@item.SiteName</td>
                                                        <td>@item.AssetType</td>
                                                        <td>@item.AssetName</td>
                                                        <td class="text-center">@failcount</td>
                                                        <td class="text-center">@precount</td>
                                                        <td class="text-center">@(precount + failcount)</td>
                                                        <td class="text-center">
                                                            @if (failackcount > 0)
                                                            {
                                                                <span>

                                                                    @{

                                                                        var value = Math.Round(((double)failackcount / failcount) * 100);
                                                                    }
                                                                    @value
                                                                </span>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @if (preackcount > 0)
                                                            {
                                                                <span>

                                                                    @{

                                                                        var value = Math.Round(((double)preackcount / precount) * 100);
                                                                    }
                                                                    @value
                                                                </span>
                                                            }

                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>

                                    </table>
                                </div>

                                <div class="table-responsive tableFixHead tblAssetTypeGroup" style="max-height: 620px;display:none">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th style="background-color:#4bacc6;color:white;">Zone</th>
                                                <th style="background-color:#215968;color:white;">Division</th>
                                                <th style="background-color:#404040;color:white;">Section</th>
                                                <th style="background-color:#4bacc6;color:white;">Site</th>
                                                <th style="background-color:#215968;color:white;">Asset Type</th>
                                                <th style="background-color:#4bacc6;color:white;" class="text-center">
                                                    Failure Alert Count
                                                </th>
                                                <th style="background-color:#215968;color:white;" class="text-center">Precitive Alert Count</th>
                                                <th style="background-color:#404040;color:white;" class="text-center">Total Count</th>
                                                <th style="background-color: #4bacc6; color: white;" class="text-center">
                                                    % of True feedback for Failure Alert
                                                </th>
                                                <th style="background-color: #215968; color: white;" class="text-center">
                                                    % of True feedback for Predictive Alert
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody style="max-height: 620px;overflow-y:auto;">
                                            @if (Model != null && Model.mFRSAlerts != null && Model.mFRSAlerts.Count > 0)
                                            {
                                                var alertSummaryReport =
                                                Model.mFRSAlerts
                                                .GroupBy(c => new
                                                {
                                                    c.ZoneName,
                                                    c.DivisionName,
                                                    c.SectionName,
                                                    c.SiteName,
                                                    c.AssetType,
                                                })
                                                .Select(gcs => new
                                                {
                                                    gcs.Key.ZoneName,
                                                    gcs.Key.DivisionName,
                                                    gcs.Key.SectionName,
                                                    gcs.Key.SiteName,
                                                    gcs.Key.AssetType,
                                                    Count = gcs.Count()
                                                }).ToList();

                                                foreach (var item in alertSummaryReport)
                                                {
                                                    var precount = Model.mFRSAlerts.Where(x => x.SiteName.Trim().ToUpper() == item.SiteName.Trim().ToUpper() && x.AssetType.Trim().ToUpper() == item.AssetType.Trim().ToUpper() && x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive).Count();
                                                    var preackcount = Model.mFRSAlerts.Where(x => x.SiteName.Trim().ToUpper() == item.SiteName.Trim().ToUpper() && x.AssetType.Trim().ToUpper() == item.AssetType.Trim().ToUpper() && x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive && x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True).Count();


                                                    var failcount = Model.mFRSAlerts.Where(x => x.SiteName.Trim().ToUpper() == item.SiteName.Trim().ToUpper() && x.AssetType.Trim().ToUpper() == item.AssetType.Trim().ToUpper() && x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure).Count();
                                                    var failackcount = Model.mFRSAlerts.Where(x => x.SiteName.Trim().ToUpper() == item.SiteName.Trim().ToUpper() && x.AssetType.Trim().ToUpper() == item.AssetType.Trim().ToUpper() && x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure && x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True).Count();
                                                    <tr>
                                                        <td>@item.ZoneName</td>
                                                        <td>@item.DivisionName</td>
                                                        <td>@item.SectionName</td>
                                                        <td>@item.SiteName</td>
                                                        <td>@item.AssetType</td>
                                                        <td class="text-center">@failcount</td>
                                                        <td class="text-center">@precount</td>
                                                        <td class="text-center">@(precount + failcount)</td>
                                                        <td class="text-center">
                                                            @if (failackcount > 0)
                                                            {
                                                                <span>

                                                                    @{

                                                                        var value = Math.Round(((double)failackcount / failcount) * 100);
                                                                    }
                                                                    @value
                                                                </span>
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @if (preackcount > 0)
                                                            {
                                                                <span>

                                                                    @{

                                                                        var value = Math.Round(((double)preackcount / precount) * 100);
                                                                    }
                                                                    @value
                                                                </span>
                                                            }

                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>

                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="card" id="pieView" style="display:none;">
                            <div class="card-header">
                                <h5>Pie Chart </h5>
                            </div>
                            <div class="card-body apex-chart">
                                @*<div id="piechart"></div>*@
                                <div id="piechartAssetName">
                                    @*<div class="card">
                                            <div class="card-header">
                                                <h5>Track</h5>
                                            </div>
                                            <div class="card-body"></div>
                                        </div>*@
                                    <div id="piechart_Track" style="display:inline-block"></div>
                                    <div id="piechart_PointMachine" style="display:inline-block"></div>
                                    <div id="piechart_Signal" style="display:inline-block"></div>
                                </div>

                                <div id="piechart_Custom"></div>
                            </div>
                        </div>
                        <div class="card" id="barView" style="display:none;">
                            <div class="card-header">
                                <h5>Bar chart</h5>
                            </div>
                            <div class="card-body">
                                <div id="basic-bar"></div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xl-12 mt-4" id="AlertSummaryGroupView" style="display:none">
                        @if (Model.mFRSAlerts != null && Model.mFRSAlerts.Count > 0)
                        {
                            <div class="container-fluid">
                                <div class="email-wrap email-main-wrapper">
                                    <div class="row">
                                        <div class="col-xxl-12 col-xl-12 box-col-12">
                                            <div class="email-right-aside">
                                                <div class="card email-body email-list">
                                                    <div class="mail-header-wrapper" style="background-color:#215968; color:white; border-top-left-radius: 15px; border-top-right-radius:15px;">
                                                        <div class="col-xl-12">
                                                            <div class="mail-header">
                                                                <div class="form-check form-check-inline">
                                                                    <ul class="email-tabs nav" role="tablist">
                                                                        @foreach (var item in Model.AssetTypes)
                                                                        {
                                                                            <li class="nav-item">
                                                                                @{
                                                                                    var isActive = string.Empty;
                                                                                }

                                                                                @if (item == Model.AssetTypes.FirstOrDefault())
                                                                                {
                                                                                    isActive = "active";
                                                                                }
                                                                                <a class="nav-link @isActive" id="@item.Name.Replace(" ","")" data-bs-toggle="pill" href="#@item.Name.Replace(" ","")-pill-alertSummary-tab" role="tab" aria-controls="@item.Name.Replace(" ","")-pill" aria-selected="false" style="color:white;">
                                                                                    <div>@item.Name</div>
                                                                                    <span class="span badge rounded-pill pill-badge-primary">@frsAlertSummary.Where(x => x.AssetTypeId == item.Id).Count()</span>
                                                                                </a>
                                                                            </li>

                                                                        }
                                                                    </ul>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="tab-content" id="email-pills-tabContent">
                                                        @foreach (var item in Model.AssetTypes)
                                                        {
                                                            var isActive = "";
                                                            if (item == Model.AssetTypes.FirstOrDefault())
                                                            {
                                                                isActive = "show active";
                                                            }

                                                            <div class="tab-pane fade @isActive" id="@item.Name.Replace(" ","")-pill-alertSummary-tab" role="tabpanel" aria-labelledby="@item.Name.Replace(" ","")-pill-tab">
                                                                <div class="mail-body-wrapper">
                                                                    <ul id="paginated-list" data-current-page="1" aria-live="polite">
                                                                        @if (frsAlertSummary != null && frsAlertSummary.Count > 0)
                                                                        {
                                                                            foreach (var site in frsAlertSummary.Where(x => x.AssetTypeId == item.Id).GroupBy(x => new { x.SiteId, x.SiteName }).Select(x => x.Key).ToList())
                                                                            {
                                                                                int smsCount = frsAlertSummary.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId).Count();

                                                                                if (smsCount > 0)
                                                                                {
                                                                                    <li class="inbox-data" style="background-color:#f4f8f8">
                                                                                        <div class="inbox-message">
                                                                                            <div class="email-data">
                                                                                                <span style="float:left;">@site.SiteName &nbsp;</span><span class="span badge rounded-pill1 pill-badge-primary" style="color:white;">@smsCount</span>
                                                                                            </div>
                                                                                            <span class="pull-right">
                                                                                                <a href="#" data-bs-original-title="" title=""><i class="fa fa-angle-up fa-3x" onclick="fnShowAlerSummaryLogSite('@site.SiteId','@item.Name.Replace(" ", "")', this); return false;"></i></a>
                                                                                            </span>
                                                                                        </div>

                                                                                    </li>
                                                                                }

                                                                                foreach (var alert in frsAlertSummary.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId).GroupBy(x => new { x.AlertTypeId, x.CauseCode }).Select(x => x.Key).ToList())
                                                                                {
                                                                                    var smsAlertNameCount = frsAlertSummary.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId && x.CauseCode == alert.CauseCode).Count();

                                                                                    <li class="inbox-data  maintenaceALertSummaryLogBySite_@(site.SiteId)_@(item.Name.Replace(" ",""))" style="display:none">

                                                                                        <div class="mail-body-wrapper" style="width:100%;">
                                                                                            <ul id="paginated-list" data-current-page="1" aria-live="polite">
                                                                                                <li class="inbox-data" style="background-color: #4bacc6;">
                                                                                                    <div class="inbox-message">
                                                                                                        <div class="email-data">
                                                                                                            <span style="float: left; color: white;">@alert.CauseCode  &nbsp;</span><span class="span badge rounded-pill1 pill-badge-primary1" style="color:black;">@smsAlertNameCount</span>
                                                                                                        </div>
                                                                                                        <span class="pull-right">
                                                                                                            <a href="#" data-bs-original-title="" title="" style="color:white"><i class="fa fa-angle-up fa-3x" onclick="fnShowAlertSummaryLogAlertName('@site.SiteId','@E7FRSAdvance.Utility.ExtensionMethod.RemoveSpecialCharactersWithSpace(alert.CauseCode)', this); return false;"></i></a>
                                                                                                        </span>
                                                                                                    </div>
                                                                                                </li>
                                                                                                @foreach (var asset in frsAlertSummary.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId && x.CauseCode == alert.CauseCode).GroupBy(x => new { x.AssetId, x.AssetName }).Select(g => new { g.Key, Count = g.Count() }).OrderByDescending(x => x.Count).Select(x => x.Key).ToList())
                                                                                                {
                                                                                                    var smsAssetCount = frsAlertSummary.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId && x.CauseCode == alert.CauseCode && x.AssetId == asset.AssetId).Count();
                                                                                                    <li class="inbox-data  maintenaceAlertSummaryLogByAletType_@(site.SiteId)_@(E7FRSAdvance.Utility.ExtensionMethod.RemoveSpecialCharactersWithSpace(alert.CauseCode))" style="display:none">
                                                                                                        <ul id="paginated-list" data-current-page="1" aria-live="polite" style="width:100%;">
                                                                                                            <li class="inbox-data" style="background-color: #21596880; ">
                                                                                                                <div class="inbox-message">
                                                                                                                    <div class="email-data">
                                                                                                                        <span style="float: left; color: white;">@asset.AssetName  &nbsp;</span><span class="span badge rounded-pill1 pill-badge-primary1" style="color:black;">@smsAssetCount</span>
                                                                                                                    </div>
                                                                                                                    <span class="pull-right">

                                                                                                                        <a href="#" data-bs-original-title="" title="" style="color:white"><i class="fa fa-angle-up fa-3x" onclick="fnShowAlertSummaryLogAsset('@site.SiteId','@asset.AssetId','@E7FRSAdvance.Utility.ExtensionMethod.RemoveSpecialCharactersWithSpace(alert.CauseCode)', this); return false;"></i></a>
                                                                                                                    </span>

                                                                                                                </div>

                                                                                                            </li>

                                                                                                            @foreach (var smsLog in frsAlertSummary.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId && x.AssetId == asset.AssetId && x.CauseCode == alert.CauseCode).ToList())
                                                                                                            {
                                                                                                                <li class="inbox-data  maintenaceAlertSummaryLogByAsset_@(site.SiteId + "" + asset.AssetId)_@(E7FRSAdvance.Utility.ExtensionMethod.RemoveSpecialCharactersWithSpace(alert.CauseCode))" style="display:none">
                                                                                                                    <div class="inbox-user">
                                                                                                                        <p>@smsLog.SiteName</p>
                                                                                                                    </div>
                                                                                                                    <div class="inbox-message">
                                                                                                                        <div class="email-data">
                                                                                                                            <span>@smsLog.SetAlertMessage</span>
                                                                                                                            <span>@smsLog.Description</span>
                                                                                                                            @if (smsLog.IsActive == true)
                                                                                                                            {
                                                                                                                                <div class="span badge rounded-pill pill-badge-success">Active</div>
                                                                                                                            }
                                                                                                                            else
                                                                                                                            {
                                                                                                                                <div class="span badge rounded-pill pill-badge-danger">InActive</div>
                                                                                                                            }

                                                                                                                        </div>
                                                                                                                        <div class="email-timing"><span>@smsLog.SetTimeStamp.ToString()</span></div>
                                                                                                                    </div>
                                                                                                                </li>

                                                                                                            }

                                                                                                        </ul>

                                                                                                    </li>
                                                                                                }

                                                                                            </ul>

                                                                                        </div>
                                                                                    </li>
                                                                                }
                                                                            }
                                                                        }
                                                                    </ul>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    var chart8;
    var chart2;
    var chart5;
    var chart6;
    var chart7;
    $(document).ready(function () {

        GetDivisionByZone($("#drpAlertSummaryZone").val(), $('#drpAlertSummaryDivision'), $('#hdnAlertSummaryDivisionId'));

        GetSiteByDivisionId($("#drpAlertSummaryDivision").val(), $('#drpAlertSummarySites'), $('#hdnAlertSummarySiteId'));

