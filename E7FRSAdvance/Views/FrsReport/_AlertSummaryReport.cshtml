    function fnView(selectedView) {
        $("#drpAlertSummaryGraphView").val($("#drpAlertSummaryGraphView option:first").val());
        if (selectedView == 1) {
            $("#pieView").hide();
            $("#barView").hide();
            // $("#drpAlertSummaryGraphView").val(1);
            $("#hdnGraphView").val(selectedView);
            $("#tableView").show();
        }
        else if (selectedView == 2) {
            $("#hdnGraphView").val(selectedView);
            $("#graphView").show();
        }
        else if (selectedView == 3) {
            $("#hdnGraphView").val(selectedView);
            $("#graphView").show();
        }
        else if (selectedView == 4) {
            $("#graphView").show();
        }

    }

    function fnGetDarkColor() {
        var allowed = "ABCDEF0123456789", S = "#";

        while (S.length < 7) {
            S += allowed.charAt(Math.floor((Math.random() * 16) + 1));
        }
        return S;
    }

    function fnShowGraphView(selectedGraphView) {
