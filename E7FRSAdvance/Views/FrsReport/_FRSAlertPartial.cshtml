@model Domain.FRSAlert

<tr class="colorCheck_@Model.Id" data-id="@Model.Id">
    <td>1</td>
    <td>@Model.ZoneName</td>
    <td>@Model.DivisionName</td>
    <td>@Model.SectionName</td>
    <td>@Model.SiteName</td>
    <td>
        @if (Model.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure)
        {
            <span>@E7FRSAdvance.Utility.Utility.AlertType.Failure.ToString()</span>
        }
        else if (Model.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive)
        {
            <span>@E7FRSAdvance.Utility.Utility.AlertType.Predictive.ToString()</span>
        }
    </td>
    <td>@Model.AssetType</td>
    <td>@Model.AssetName</td>
    <td>
        @Model.SetTimeStamp.ToString("dd/MM/yyyy HH:mm:ss")
    </td>
    <td>
        @if (Model.ResetTimeStamp != null && Model.ResetTimeStamp.Value != DateTime.MinValue)
        {
            TimeSpan span = Model.ResetTimeStamp.Value.Subtract(Model.SetTimeStamp);
            <span>@Convert.ToInt32(span.Hours):@Convert.ToInt32(span.Minutes)</span>
        }
    </td>
    <td>
        @if (Model.ResetTimeStamp != null && Model.ResetTimeStamp != DateTime.MinValue)
        {
            <span>@Model.ResetTimeStamp.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
        }
    </td>
    <td class="showRemark" id="RemarkId_@Model.Id" onchange="fnAddRemark(this,'@Model.Id')" style="display:none;">
        @if (!string.IsNullOrEmpty(Model.TempRemark))
        {
            @Model.TempRemark
        }
        else
        {
            <textarea rows="4" cols="15" class="form-control textRemark"></textarea>
        }
    </td>
    <td>@Model.CauseCode</td>

    <td>
        @if (Model.IsActive == true)
        {
            <div class="span badge rounded-pill pill-badge-danger">@E7FRSAdvance.Utility.Utility.AlertStatus.Active.ToString()</div>
        }
        else
        {
            <div class="span badge rounded-pill pill-badge-success">@E7FRSAdvance.Utility.Utility.AlertStatus.InActive.ToString()</div>
        }


    </td>

    <td>
        <span>
            @Model.SetAlertMessage
        </span>
        <span>
            @Html.Raw(Model.Description)
        </span>

        @if (!string.IsNullOrEmpty(Model.ResetAlertMessage))
        {
            <br />
            <b>
                <u>
                    Reset Message
                </u>
            </b>
            <span>
                @Html.Raw(Model.ResetAlertMessage)
            </span>
        }
    </td>
    <td class="text-center">
        @if (Model.AlertInstanceCount > 0)
        {
            <div>
                <a class="justify-content-center" href="javascript:void(0)" onclick="fnShowFRSAlertInstance(@Model.Id); return false;" data-bs-original-title="" title="" style="color: black"><img style="width:25px;" src="@Url.Content("~/assets/images/Vector.png")" /></a>
            </div>
        }
        <div>
            <span>@Model.AlertInstanceCount</span>
        </div>
    </td>
    <td>
        <button type="button" class="btn btn-info" onclick="AddRemark('@Model.Id','@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True.GetHashCode()')"
                data-alerttypeid="@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True.GetHashCode()">
            T
        </button>
    </td>
    <td>
        <button type="button" class="btn btn-info" onclick="AddRemark('@Model.Id','@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False.GetHashCode()')" data-alerttypeid="@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False.GetHashCode()">F</button>
    </td>
    <td>
        <button type="button" class="btn btn-info" onclick="fnUpdateAckStatus('@Model.Id','@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.Maintenace.GetHashCode()')" data-alerttypeid="@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.Maintenace.GetHashCode()">M</button>
    </td>
    <td>
        @if (Model.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK && Model.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure)
        {
            <a href="Javascript:void(0)" data-placement="top" data-toggle="tooltip" class="span badge rounded-pill pill-badge-warning" onclick="ShowDebugTrackFail('@Model.Id')">Debug </a>

        }
    </td>
</tr>