@model Domain.FRSAlert

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="model-FRS-Fail-Alert-Debbug" tabindex="-1" aria-labelledby="model-FRS-Fail-Alert-Debbug" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">

                <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader">Alert Debbug - @Model.AssetName</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="table-responsive">
                                <table class="table">
                                    @if (ViewBag.FamilyTracks != null)
                                    {
                                        var mFamilyTracks = ViewBag.FamilyTracks as List<Domain.FamilyTrack>;
                                        List<string> assetName = new List<string>();
                                        assetName.Add(Model.AssetName);
                                        if (mFamilyTracks != null && mFamilyTracks.Count > 0)
                                        {
                                            foreach (var mFamilyTrack in mFamilyTracks)
                                            {
                                                assetName.Add(mFamilyTrack.AssetName);
                                            }
                                        }
                                        <tr>
                                            <th>Family Track</th>
                                            <th>
                                                <a class="btn btn-success" href="Javascript:void(0)" onclick="fnGetDataloggerEventData('@Model.SiteId','@string.Join(",",assetName)','@Model.SetTimeStamp.ToString("d-M-yyyy")')">Event</a>
                                            </th>
                                            <th>
                                                <a href="@Url.Action("DownloadTprReportCsv","SMSLog",new { siteId= Model.SiteId, assetId = Model.AssetId, timeStamp = Model.SetTimeStamp.ToString()})" data-placement="top" data-toggle="tooltip" class="btn btn-info" data-original-title="Debug">Debug Tpr <i class="fa fa-download"></i></a>
                                            </th>
                                        </tr>
                                        foreach (var item in mFamilyTracks)
                                        {
                                            <tr>
                                                <td>
                                                    @item.AssetName
                                                </td>
                                                <td>
                                                    <a class="btn btn-success" href="Javascript:void(0)" onclick="fnGetLiveData('@Model.SiteName','@item.TrackFamilyId','@Model.AssetTypeId')">Live Data</a>
                                                </td>
                                                <td>
                                                </td>
                                            </tr>
                                        }


                                        <tr>
                                            <td>
                                                @Model.AssetName
                                            </td>
                                            <td>
                                                <a class="btn btn-success" href="Javascript:void(0)" onclick="fnGetLiveData('@Model.SiteName','@Model.AssetId','@Model.AssetTypeId')">Live Data</a>
                                            </td>
                                            <td></td>
                                            @*<td>
                                                    <a class="btn btn-success" href="Javascript:void(0)" onclick="fnGetDataloggerEventData('@Model.SiteId','@Model.AssetName','@Model.SetTimeStamp.ToString("d-M-yyyy")')">Event</a>
                                                </td>*@
                                        </tr>
                                    }
                                </table>
                            </div>


                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal">Close</a>
            </div>
        </div>
    </div>
</div>
