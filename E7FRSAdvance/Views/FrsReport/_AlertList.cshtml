    function fnPredictiveAlertsListView() {
        $("#predictiveAlertsListView").show();
        $("#predictiveAlertsgroupView").hide();
    }

    function fnPredictiveAlertsGroupView() {
        $("#predictiveAlertsListView").hide();
        $("#predictiveAlertsgroupView").show();
    }

    function fnShowPredictiveAlertLogSite(siteId, typeName, $this) {

        if (siteId != null && siteId != '' && siteId != undefined && typeName != null && typeName != undefined && typeName != '') {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.predictiveALertLogBySite_' + siteId + '_' + typeName).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.predictiveALertLogBySite_' + siteId + '_' + typeName).hide();
            }
        }
    }

    function fnShowPredictiveAlertLogAsset(siteId, assetId, alertName, $this) {
        if (siteId != null && siteId != '' && siteId != undefined && alertName != null && alertName != undefined && alertName != '') {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.predictiveALertLogByAsset_' + siteId + "" + assetId + '_' + alertName).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.predictiveALertLogByAsset_' + siteId + "" + assetId + '_' + alertName).hide();
            }
        }
    }

    function fnShowPredictiveAlertLogAlertName(siteId, alertName, $this) {
        if (siteId != null && siteId != '' && siteId != undefined && alertName != null && alertName != undefined && alertName != '') {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.predictiveALertLogByAletType_' + siteId + '_' + alertName).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.predictiveALertLogByAletType_' + siteId + '_' + alertName).hide();
            }
        }
    }

    function fnChangeTab(type) {
        $('#allSelectCheckbox').val(type);
    }

    function Delete(id) {
        if (confirm('Are you sure you want to delete selected record')) {
            $("#loader").show();
            $.ajax({
                url: '/FRSReport/DeleteFRSAlertById',
                type: 'Post',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            fnGetAlertLiveStatus();
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "error");
                }
            });
        }

    }

    function fnDeleteSelected() {
        var j = 0;
        var selectedValue = [];
        $("input:checkbox[name=chkFRSAlertDelete]:checked").each(function () {
            selectedValue.push($(this).val());
        });
        if (selectedValue != null && selectedValue != undefined && selectedValue.length > 0) {
            if (confirm('Are you sure you want to delete selected record')) {
                $("#loader").show();
                $.ajax({
                    url: '/FRSReport/DeleteFRSAlertByIds',
                    type: 'Post',
                    data: JSON.stringify(selectedValue),
                    contentType: 'application/json',
                    success: function (data) {
                        $("#loader").hide();
                        if (data != null) {
                            if (data.type == "success") {
                                CommonNotification("SUCCESS", data.result, "success");
                                fnGetAlertLiveStatus();
                            }
                            else if (data.type == "error") {
                                CommonNotification("ERROR", data.result, "error");
                            }
                            else if (data.type == "error") {
                                CommonNotification("ERROR", data.result, "error");
                            }
                        }
                    },
                    error: function (response) {
                        $("#loader").hide();
                        CommonNotification("ERROR", "Something went wrong!", "error");
                    }
                });
            }

        }
        else {
            CommonNotification("ERROR", "Please select any option for delete FRS Alert", "error");
        }
    }

    function fnShowFRSAlertInstance(frsAlertId) {
        var mFRSAlertInstance = {};
        mFRSAlertInstance.FRSAlertId = frsAlertId;
        $("#loader").show();
        $.ajax({
            url: '/FRSReport/GetFRSAlertInstance',
            type: 'POST',
            dataType: 'html',
            data: JSON.stringify(mFRSAlertInstance),
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divFRSAlertInstance").empty().append(data);
                $('#modalFRSAlertInstance').modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnDownloadImage() {
        html2canvas($("#downloadIMG")[0], {
            allowTaint: true,
            scrollX: 0,
            scrollY: -window.scrollY
        }).then((canvas) => {
            const linkSource = canvas.toDataURL();;
            const downloadLink = document.createElement("a");
            const fileName = 'Alert_Screenshot' + '.jpeg';
            downloadLink.href = linkSource;
            downloadLink.download = fileName;
            downloadLink.click();
        });
    }

    function AddRemarkColumn() {
        $(".showRemark").show();
    }

    function fnAddRemark($this, itemId) {
        var remark_val = $($this).children('.textRemark').val();
        if (remark_val != null && remark_val != undefined && remark_val != '') {
            $.ajax({
                url: '/FRSReport/UpdateTempRemark',
                type: 'POST',
                dataType: 'html',
                data: '{Id:' + itemId + ',tempRemark:"' + remark_val + '"}',
                contentType: 'application/json',
                success: function (data) {
                    $("#RemarkId_" + itemId).append('<span>' + remark_val + '</span>');
                    $($this).children('.textRemark').remove();
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            alert("Remark is required")
        }

    }

    function ClearRemarkColumn() {
        $.ajax({
            url: '/FRSReport/ClearTempRemark',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                fnGetAlertLiveStatus();
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function ShowDebugTrackFail(id) {
        if (id != null && id != undefined && id != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRSReport/_DebugTrackFail',
                type: 'POST',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    $('#divFRSFailAlertDebbug').empty().append(data);
                    $('#model-FRS-Fail-Alert-Debbug').modal('show');
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }


</script>