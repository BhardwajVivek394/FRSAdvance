@model Domain.FRSAlertLister

@{
    var failFRSAlert = Model.mFRSAlerts.ToList();
}

@{
    var failFRSAlertCount = Model.mFRSAlerts.Where(x => x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure).Count();
    var predictiveFRSAlertCount = Model.mFRSAlerts.Where(x => x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive).Count();
}
<style>
    .boxGrid {
        display: grid;
        grid-template-columns: auto,auto;
    }

        .boxGrid > div {
            border: 1px solid black;
            font-size: 10px;
            text-align: center;
        }

    .rounded-pill1 {
        border-radius: 55rem !important;
    }

    .pill-badge-primary1 {
        background-color: White;
    }

    td {
        padding: 10px;
        /*  white-space: nowrap;*/
    }

    .custom-popover {
        max-width: 600px;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="row">
                            <div class="col-lg-1">
                                <strong class="mt-4">Search</strong>
                            </div>
                            <div class="col-xl-2 col-lg-3 col-md-6">
                                <span>From Date</span>
                                <input type="text" class="form-control" id="txtAlertLiveStatusFromDate" value="@(Model.SearchCriteria.FromDate != null && Model.SearchCriteria.FromDate != DateTime.MinValue? Model.SearchCriteria.FromDate.ToShortDateString() : "")" />
                            </div>
                            <div class="col-xl-2 col-lg-3 col-md-6">
                                <span>To Date</span>
                                <input type="text" class="form-control" id="txtAlertLiveStatusToDate" value="@(Model.SearchCriteria.ToDate != null && Model.SearchCriteria.ToDate != DateTime.MinValue? Model.SearchCriteria.ToDate.ToShortDateString() : "")" />
                            </div>
                            <div class="col-lg-2 mt-4">
                                <label class="radio-inline">
                                    @if (Model.SearchCriteria.AlertStatus == (int)E7FRSAdvance.Utility.Utility.AlertStatus.Active)
                                    {
                                        <input type="radio" name="SearchCriteria.AlertStatus" checked id="rdActive" value="@((int)E7FRSAdvance.Utility.Utility.AlertStatus.Active)" />
                                    }
                                    else
                                    {
                                        <input type="radio" name="SearchCriteria.AlertStatus" id="rdActive" value="@((int)E7FRSAdvance.Utility.Utility.AlertStatus.Active)" />
                                    }
                                    Active
                                </label>

                                <label class="radio-inline">
                                    @if (Model.SearchCriteria.AlertStatus == (int)E7FRSAdvance.Utility.Utility.AlertStatus.InActive)
                                    {
                                        <input type="radio" name="SearchCriteria.AlertStatus" checked id="rdInActive" value="@((int)E7FRSAdvance.Utility.Utility.AlertStatus.InActive)" />
                                    }
                                    else
                                    {
                                        <input type="radio" name="SearchCriteria.AlertStatus" id="rdInActive" value="@((int)E7FRSAdvance.Utility.Utility.AlertStatus.InActive)" />
                                    }
                                    InActive
                                </label>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xxl-1 col-xl-1 col-lg-4 col-md-4 mt-2">
                                <span>Zone</span>
                                @Html.DropDownListFor(x => x.SearchCriteria.ZoneId, (IEnumerable<SelectListItem>)ViewBag.Zones, "All", new { @class = "form-control", @id = "drpAlertLiveStatusZone", tabindex = 1 })
                            </div>
                            <div class="col-xxl-2 col-xl-2 col-lg-4 col-md-4 mt-2">
                                <input type="hidden" id="hdnAlertLiveStatusDivisionId" value="@Model.SearchCriteria.DivisionId" />
                                <span>Division</span>
                                @Html.DropDownListFor(x => x.SearchCriteria.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, "All", new { @class = "form-control", @id = "drpAlertLiveStatusDivision", tabindex = 2 })
                            </div>
                            <div class="col-xxl-2 col-xl-2 col-lg-4 col-md-4 mt-2">
                                <span>Section</span>
                                @Html.DropDownListFor(x => x.SearchCriteria.SectionId, (IEnumerable<SelectListItem>)ViewBag.Sections, "All", new { @class = "form-control", @id = "drpAlertLiveStatusSection", tabindex = 3 })
                            </div>
                            <div class="col-xxl-2 col-xl-2 col-lg-4 col-md-4 mt-2">
                                <span>Site</span>
                                <input type="hidden" id="hdnAlertLiveStatusSiteId" value="@Model.SearchCriteria.SiteId" />
                                @Html.DropDownListFor(x => x.SearchCriteria.SiteId, (IEnumerable<SelectListItem>)ViewBag.Sites, "All", new { @class = "form-control", @id = "drpAlertLiveStatusSites", tabindex = 3 })
                            </div>
                            <div class="col-xxl-2 col-xl-2 col-lg-4 col-md-4 mt-2">
                                <span>Asset Type</span>
                                @Html.DropDownListFor(x => x.SearchCriteria.AssetTypeId, (IEnumerable<SelectListItem>)ViewBag.AssetTypes, "All", new { @class = "form-control", @id = "drpAlertLiveStatusAssetType", tabindex = 4 })
                            </div>
                            <div class=" col-xxl-1 col-xl-2 col-lg-4 col-md-4 mt-2">
                                <span>Alert Type</span>
                                @Html.DropDownListFor(x => x.SearchCriteria.AlertTypeId, Enum.GetValues(typeof(E7FRSAdvance.Utility.Utility.AlertType)).Cast<E7FRSAdvance.Utility.Utility.AlertType>().Select(x => new SelectListItem { Text = x.ToString(), Value = ((int)x).ToString() }), "All", new { @class = "form-control", tabindex = 6, @id = "drpAlertLiveStatusAlertType" })
                            </div>
                            <div class="col-xxl-2 col-xl-4 col-lg-5 mt-4">
                                <a class="btn btn-success btn-quirk mt-1" onclick="fnGetAlertLiveStatus()"><i class="fa fa-search"></i></a>
                                <a href="@Url.Action("DownloadFRSAlertLiveStatus", "FRSReport")" class="btn btn-primary mt-1"><i class="fa fa-download"></i></a>
                                @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                                {
                                    <a href="javascript:void(0)" class="btn btn-danger btn-quirk mt-1" onclick="fnDeleteSelected()" data-bs-original-title="" title="Delete selected FRS Alert"><i class="fa fa-trash"></i></a>
                                    <a class="justify-content-center" href="javascript:void(0)" onclick="fnDownloadImage(); return false;" data-bs-original-title="" title="" style="color: black"><img class="mt-1" style="width:40px;" src="@Url.Content("~/assets/images/download_image.png")" /></a>
                                    @*<a href="@Url.Action("Debug", "FRSReport")" class="btn btn-info mt-1">Debug</a>*@

                                    <div class="form-check form-switch" style="margin-left:30px;">
                                        @Html.CheckBoxFor(x => x.SearchCriteria.IsAutoRefresh, new { @class = "form-check-input f-24", @id = "switchAutoRefreshMode", @title = "Auto Refresh Mode On/Off" })
                                        @*<input type="checkbox" title="Auto Refresh Mode On/Off" class="form-check-input f-24" id="switchAutoRefreshMode" />*@
                                    </div>
                                }

                            </div>
                        </div>

                    </div>
                </div>

            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-xl-2 col-lg-4 col-md-4 col-sm-4 col-12">
                                <table class="table table-bordered bg-info" style="border:2px;">
                                    <tr>
                                        <td width="10%" style="font-size:15px"><b>Predictive</b></td>
                                        <td width="5%">@predictiveFRSAlertCount</td>
                                    </tr>
                                </table>
                            </div>
                            <div class=" col-xl-2 col-lg-3 col-md-3 col-sm-4 col-12">
                                <table class="table table-bordered bg-danger">
                                    <tr>
                                        <td width="10%" style="font-size:15px"><b>Failure</b></td>
                                        <td width="5%">@failFRSAlertCount</td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-xl-2 col-lg-3 col-md-3 col-sm-2 col-12">
                                <table class="table table-bordered bg-success">
                                    <tr>
                                        <td width="10%" style="font-size:15px"><b>Total</b></td>
                                        <td width="5%">@failFRSAlert.Count</td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="row mt-4">
                            <div class="col-md-12 mt-2">
                                <div class="row">
                                    <div class="col-xl-12">
                                        <span class="pull-left">Last Update:</span>
                                        <span class="pull-left" id="spnAlertLiveStatusUpdateTime"></span>
                                        <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-primary" onclick="fnGroupFailureAlertsView()" title="Grid View"><i class="fa fa-group"></i></a></span>
                                        <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-info" onclick="fnListFailureAlertsView()" title="List View"><i class="fa fa-list"></i></a></span>
                                        @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode())
                                        {
                                            <span class="pull-right" style="margin-right:20px;"><a href="javascript:void(0)" class="btn btn-primary" onclick="ClearRemarkColumn()">Clear Remark</a></span>
                                            <span class="pull-right" style="margin-right:20px;"><a href="javascript:void(0)" class="btn btn-primary" onclick="AddRemarkColumn()">Add Remark</a></span>
                                        }
                                    </div>
                                    <div class="col-xl-12 mt-4" id="failureAlertsListView">
                                        <div class="table-responsive tableFixHead" style="max-height: 620px;">
                                            <table class="table" id="downloadIMG">
                                                <thead>
                                                    <tr>
                                                        <th style="background-color: #4bacc6;color:white;">Sr.No</th>
                                                        <th style="background-color: #215968; color: white;">Zone</th>
                                                        <th style="background-color: #404040; color: white;">Division</th>
                                                        <th style="background-color: #4bacc6; color: white;">Section</th>
                                                        <th style="background-color: #215968; color: white; ">Station</th>
                                                        <th style="background-color: #404040; color: white;">Alert Type</th>
                                                        <th style="background-color: #4bacc6; color: white;">Asset Type</th>
                                                        <th style="background-color: #215968; color: white;">Asset Number</th>
                                                        <th style="background-color: #404040; color: white;">Incidence Date & Time</th>
                                                        <th style="background-color: #4bacc6; color: white;">Duration (h:m)</th>
                                                        <th style="background-color: #215968; color: white;" class="resetTimeStamp">Rectification Date & Time</th>
                                                        <th style="background-color: #4bacc6; display: none; color: white;" class="showRemark">Add Remark</th>
                                                        <th style="background-color: #404040; color: white;">Cause_code</th>
                                                        <th style="background-color: #4bacc6; color: white;" class="text-center">Status</th>
                                                        <th style="background-color: #215968; color: white;">Alert Message</th>
                                                        @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                                                        {
                                                            <th class="text-center" style="background-color: #4bacc6; color: white;">Alert Insight</th>
                                                            <th class="text-center" style="background-color: #215968; color: white;">Alert Instance</th>
                                                            <th style="background-color: #4bacc6; color: white;" colspan="3" class="text-center">Actions required for feedback</th>
                                                        }
                                                        else
                                                        {
                                                            <th style="background-color: #4bacc6; color: white;" colspan="3" class="text-center">Actions required for feedback</th>

                                                        }
                                                        <th style="background-color: #215968; color: white;" class="text-center"></th>
                                                    </tr>
                                                </thead>
                                                <tbody style="max-height: 620px;overflow-y:auto;" id="tbodyAlertLiveStatusChange">
                                                    @if (Model != null && Model.mFRSAlerts != null && failFRSAlert != null && failFRSAlert.Count > 0)
                                                    {
                                                        int counter = 0;
                                                        foreach (var item in failFRSAlert)
                                                        {
                                                            counter++;
                                                            <tr class="colorCheck_@item.Id" data-id="@item.Id">
                                                                <td>@counter</td>
                                                                <td>@item.ZoneName</td>
                                                                <td>@item.DivisionName</td>
                                                                <td>@item.SectionName</td>
                                                                <td>@item.SiteName</td>
                                                                <td>
                                                                    @if (item.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure)
                                                                    {
                                                                        <span>@E7FRSAdvance.Utility.Utility.AlertType.Failure.ToString()</span>
                                                                    }
                                                                    else if (item.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive)
                                                                    {
                                                                        <span>@E7FRSAdvance.Utility.Utility.AlertType.Predictive.ToString()</span>
                                                                    }
                                                                </td>
                                                                <td>@item.AssetType</td>
                                                                <td>@item.AssetName</td>
                                                                <td>
                                                                    @item.SetTimeStamp.ToString("dd/MM/yyyy HH:mm:ss")
                                                                </td>
                                                                <td>
                                                                    @if (item.ResetTimeStamp != null && item.ResetTimeStamp.Value != DateTime.MinValue)
                                                                    {
                                                                        TimeSpan span = item.ResetTimeStamp.Value.Subtract(item.SetTimeStamp);
                                                                        <span>@Convert.ToInt32(span.Hours):@Convert.ToInt32(span.Minutes)</span>
                                                                    }
                                                                </td>
                                                                <td>
                                                                    @if (item.ResetTimeStamp != null && item.ResetTimeStamp != DateTime.MinValue)
                                                                    {
                                                                        <span>@item.ResetTimeStamp.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                                                    }
                                                                </td>
                                                                <td class="showRemark" id="RemarkId_@item.Id" onchange="fnAddRemark(this,'@item.Id')" style="display:none;">
                                                                    @if (!string.IsNullOrEmpty(item.TempRemark))
                                                                    {
                                                                        @item.TempRemark
                                                                    }
                                                                    else
                                                                    {
                                                                        <textarea rows="4" cols="15" class="form-control textRemark"></textarea>
                                                                    }
                                                                </td>
                                                                <td>@item.CauseCode</td>

                                                                <td class="text-center">
                                                                    @if (item.IsActive == true)
                                                                    {
                                                                        <div class="span badge rounded-pill pill-badge-danger">@E7FRSAdvance.Utility.Utility.AlertStatus.Active.ToString()</div>
                                                                    }
                                                                    else
                                                                    {
                                                                        <div class="span badge rounded-pill pill-badge-success">@E7FRSAdvance.Utility.Utility.AlertStatus.InActive.ToString()</div>
                                                                    }

                                                                    @if (item.IsSetWatchList != null && item.IsSetWatchList.Value)
                                                                    {
                                                                        <div>
                                                                            <span class="text-danger">False</span>
                                                                        </div>
                                                                    }
                                                                </td>

                                                                <td>
                                                                    <span>
                                                                        @item.SetAlertMessage
                                                                    </span>
                                                                    <span>
                                                                        @Html.Raw(item.Description)
                                                                    </span>

                                                                    @if (!string.IsNullOrEmpty(item.ResetAlertMessage))
                                                                    {
                                                                        <br />
                                                                        <b>
                                                                            <u>
                                                                                Reset Message
                                                                            </u>
                                                                        </b>
                                                                        <span>
                                                                            @Html.Raw(item.ResetAlertMessage)
                                                                        </span>
                                                                    }
                                                                </td>
                                                                @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                                                                {
                                                                    <td class="text-center">
                                                                        <span>@item.AlertInsight</span>
                                                                    </td>
                                                                    <td class="text-center">
                                                                        @if (item.AlertInstanceCount > 0)
                                                                        {
                                                                            <div>
                                                                                <a class="justify-content-center" href="javascript:void(0)" onclick="fnShowFRSAlertInstance(@item.Id); return false;" data-bs-original-title="" title="" style="color: black"><img style="width:25px;" src="@Url.Content("~/assets/images/Vector.png")" /></a>
                                                                            </div>
                                                                        }
                                                                        <div>
                                                                            <span>@item.AlertInstanceCount</span>
                                                                        </div>

                                                                    </td>

                                                                }

                                                                <td>
                                                                    <button type="button" class="btn btn-info" onclick="AddRemark('@item.Id','@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True.GetHashCode()')"
                                                                            data-alerttypeid="@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True.GetHashCode()">
                                                                        T
                                                                    </button>
                                                                </td>
                                                                <td>
                                                                    <button type="button" class="btn btn-info" onclick="AddRemark('@item.Id','@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False.GetHashCode()')" data-alerttypeid="@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False.GetHashCode()">F</button>
                                                                </td>
                                                                <td>
                                                                    <button type="button" class="btn btn-info" onclick="fnUpdateAckStatus('@item.Id','@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.Maintenace.GetHashCode()')" data-alerttypeid="@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.Maintenace.GetHashCode()">M</button>
                                                                </td>
                                                                <td>
                                                                    @if (item.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK && item.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure)
                                                                    {
                                                                        <a href="Javascript:void(0)" data-placement="top" data-toggle="tooltip" class="span badge rounded-pill pill-badge-warning" onclick="ShowDebugTrackFail('@item.Id')">Debug </a>

                                                                    }
                                                                </td>
                                                            </tr>
                                                        }

                                                    }

                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <div class="col-xl-12 mt-4" id="failureAlertsgroupView" style="display:none">

                                        @if (Model.AssetTypes != null && Model.AssetTypes.Count > 0)
                                        {
                                            <div class="container-fluid">
                                                <div class="email-wrap email-main-wrapper">
                                                    <div class="row">
                                                        <div class="col-xxl-12 col-xl-12 box-col-12">
                                                            <div class="email-right-aside">
                                                                <div class="card email-body email-list">
                                                                    <div class="mail-header-wrapper" style="background-color:#215968; color:white; border-top-left-radius: 15px; border-top-right-radius:15px;">
                                                                        <div class="col-xl-12">
                                                                            <div class="mail-header">
                                                                                <div class="form-check form-check-inline">
                                                                                    <input class="form-check-input checkbox-primary" id="allSelectCheckbox" type="checkbox" value="@Model.AssetTypes.FirstOrDefault().Name.Replace(" ","")">
                                                                                    <label class="form-check-label" for="allSelectCheckbox"></label>
                                                                                    <ul class="email-tabs nav" role="tablist">
                                                                                        @foreach (var item in Model.AssetTypes)
                                                                                        {

                                                                                            <li class="nav-item">
                                                                                                @{
                                                                                                    var isActive = string.Empty;
                                                                                                }

                                                                                                @if (item == Model.AssetTypes.FirstOrDefault())
                                                                                                {
                                                                                                    isActive = "active";
                                                                                                }

                                                                                                <a class="nav-link @isActive" id="@item.Name.Replace(" ","")" data-bs-toggle="pill" href="#@item.Name.Replace(" ","")-pill-failureAlerts-tab" role="tab" aria-controls="@item.Name.Replace(" ","")-pill" aria-selected="false" onclick="fnChangeTab('@item.Name.Replace(" ","")')" style="color:white;">
                                                                                                    <div>@item.Name</div>
                                                                                                    <span class="span badge rounded-pill pill-badge-primary">@failFRSAlert.Where(x => x.AssetTypeId == item.Id).Count()</span>
                                                                                                </a>
                                                                                            </li>

                                                                                        }

                                                                                    </ul>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="tab-content" id="email-pills-tabContent">
                                                                        @foreach (var item in Model.AssetTypes)
                                                                        {
                                                                            var isActive = "";
                                                                            if (item == Model.AssetTypes.FirstOrDefault())
                                                                            {
                                                                                isActive = "show active";
                                                                            }
                                                                            <div class="tab-pane fade @isActive" id="@item.Name.Replace(" ","")-pill-failureAlerts-tab" role="tabpanel" aria-labelledby="@item.Name.Replace(" ","")-pill-tab">
                                                                                <div class="mail-body-wrapper">
                                                                                    <ul id="paginated-list" data-current-page="1" aria-live="polite">
                                                                                        @if (failFRSAlert != null && failFRSAlert.Count > 0)
                                                                                        {
                                                                                            foreach (var site in failFRSAlert.Where(x => x.AssetTypeId == item.Id).GroupBy(x => new { x.SiteId, x.SiteName }).Select(x => x.Key).ToList())
                                                                                            {
                                                                                                int smsCount = failFRSAlert.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId).Count();
                                                                                                if (smsCount > 0)
                                                                                                {
                                                                                                    <li class="inbox-data" style="background-color:#f4f8f8">
                                                                                                        <div class="inbox-message">

                                                                                                            <div class="email-data">
                                                                                                                <span style="float:left;">@site.SiteName &nbsp;</span><span class="span badge rounded-pill1 pill-badge-primary" style="color:white;">@smsCount</span>
                                                                                                            </div>
                                                                                                            <span class="pull-right">
                                                                                                                <a href="#" data-bs-original-title="" title=""><i class="fa fa-angle-up fa-3x" onclick="fnShowFailureAlertLogSite('@site.SiteId','@item.Name.Replace(" ", "")', this); return false;"></i></a>
                                                                                                            </span>
                                                                                                        </div>
                                                                                                    </li>

                                                                                                }


                                                                                                foreach (var alert in failFRSAlert.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId).GroupBy(x => new { x.AlertTypeId, x.CauseCode }).Select(x => x.Key).ToList())
                                                                                                {

                                                                                                    var smsAlertNameCount = failFRSAlert.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId && x.CauseCode == alert.CauseCode).Count();
                                                                                                    <li class="inbox-data  maintenaceALertLogBySite_@(site.SiteId)_@(item.Name.Replace(" ",""))" style="display:none">
                                                                                                        <div class="mail-body-wrapper" style="width:100%;">
                                                                                                            <ul id="paginated-list" data-current-page="1" aria-live="polite">
                                                                                                                <li class="inbox-data" style="background-color: #4bacc6;">
                                                                                                                    <div class="inbox-message">
                                                                                                                        <div class="email-data">
                                                                                                                            <span style="float: left; color: white;">@alert.CauseCode  &nbsp;</span><span class="span badge rounded-pill1 pill-badge-primary1" style="color:black;">@smsAlertNameCount</span>
                                                                                                                        </div>
                                                                                                                        <span class="pull-right">
                                                                                                                            <a href="#" data-bs-original-title="" title="" style="color:white"><i class="fa fa-angle-up fa-3x" onclick="fnShowFailureAlertLogAlertName('@site.SiteId','@E7FRSAdvance.Utility.ExtensionMethod.RemoveSpecialCharactersWithSpace(alert.CauseCode)', this); return false;"></i></a>
                                                                                                                        </span>
                                                                                                                    </div>
                                                                                                                </li>
                                                                                                                @foreach (var asset in failFRSAlert.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId && x.CauseCode == alert.CauseCode).GroupBy(x => new { x.AssetId, x.AssetName }).Select(g => new { g.Key, Count = g.Count() }).OrderByDescending(x => x.Count).Select(x => x.Key).ToList())
