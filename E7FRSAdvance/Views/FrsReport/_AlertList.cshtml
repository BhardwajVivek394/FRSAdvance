                                                                                                                                    </div>
                                                                                                                                    <span class="pull-right">

                                                                                                                                        <a href="#" data-bs-original-title="" title="" style="color:white"><i class="fa fa-angle-up fa-3x" onclick="fnShowFailureAlertLogAsset('@site.SiteId','@asset.AssetId','@E7FRSAdvance.Utility.ExtensionMethod.RemoveSpecialCharactersWithSpace(alert.CauseCode)', this); return false;"></i></a>
                                                                                                                                    </span>
                                                                                                                                </div>
                                                                                                                            </li>

                                                                                                                            @foreach (var fRSAlert in failFRSAlert.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId && x.AssetId == asset.AssetId && x.CauseCode == alert.CauseCode).ToList())
                                                                                                                            {
                                                                                                                                <li class="inbox-data  maintenaceALertLogByAsset_@(site.SiteId + "" + asset.AssetId)_@(E7FRSAdvance.Utility.ExtensionMethod.RemoveSpecialCharactersWithSpace(alert.CauseCode))" style="display:none">
                                                                                                                                    <div class="inbox-user">

                                                                                                                                        <div class="form-check form-check-inline m-0">
                                                                                                                                            <input class="form-check-input checkbox-primary clsSelectAlltype clsSelectCheckbox_@item.Name.Replace(" ","")" id="frsCheckbox" type="checkbox" name="chkFRSAlertDelete" value="@fRSAlert.Id">
                                                                                                                                            <label class="form-check-label" for="emailCheckboxB"></label>
                                                                                                                                        </div>                                                                                                                          <p>@fRSAlert.SiteName</p>
                                                                                                                                    </div>
                                                                                                                                    <div class="inbox-message">
                                                                                                                                        <div class="email-data">
                                                                                                                                            <span>@fRSAlert.SetAlertMessage</span>
                                                                                                                                            <span>@Html.Raw(fRSAlert.Description)</span>
                                                                                                                                            @if (!string.IsNullOrEmpty(fRSAlert.ResetAlertMessage))
                                                                                                                                            {
                                                                                                                                                <b>
                                                                                                                                                    <u>
                                                                                                                                                        Reset Message
                                                                                                                                                    </u>
                                                                                                                                                </b>
                                                                                                                                                <span class="popper" data-bs-trigger="hover" data-bs-toggle="popover">
                                                                                                                                                    @Html.Raw(fRSAlert.ResetAlertMessage)
                                                                                                                                                </span>
                                                                                                                                                <div class="popper-content d-none">@Html.Raw(fRSAlert.ResetAlertMessage)</div>
                                                                                                                                            }
                                                                                                                                            @if (fRSAlert.IsActive == true)
                                                                                                                                            {
                                                                                                                                                <div class="span badge rounded-pill pill-badge-danger">@E7FRSAdvance.Utility.Utility.AlertStatus.Active.ToString()</div>
                                                                                                                                            }
                                                                                                                                            else
                                                                                                                                            {
                                                                                                                                                <div class="span badge rounded-pill pill-badge-success">@E7FRSAdvance.Utility.Utility.AlertStatus.InActive.ToString()</div>
                                                                                                                                            }

                                                                                                                                        </div>
                                                                                                                                        <div class="email-timing"><span>@fRSAlert.SetTimeStamp.ToString("dd/MM/yyyy HH:mm:ss")</span></div>
                                                                                                                                        <div class="email-options">
                                                                                                                                            <table>
                                                                                                                                                <thead>
                                                                                                                                                    <tr>
                                                                                                                                                        <th colspan="5"></th>
                                                                                                                                                    </tr>
                                                                                                                                                </thead>
                                                                                                                                                <tbody>
                                                                                                                                                    <tr class="colorCheck_@fRSAlert.Id">
                                                                                                                                                        <td>
                                                                                                                                                            <button type="button" class="btn btn-info" onclick="AddRemark('@item.Id','@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True.GetHashCode()')"
                                                                                                                                                                    data-alerttypeid="@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True.GetHashCode()">
                                                                                                                                                                T
                                                                                                                                                            </button>
                                                                                                                                                        </td>
                                                                                                                                                        <td>
                                                                                                                                                            <button type="button" class="btn btn-info" onclick="AddRemark('@item.Id','@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False.GetHashCode()')" data-alerttypeid="@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False.GetHashCode()">F</button>
                                                                                                                                                        </td>
                                                                                                                                                        <td>
                                                                                                                                                            <button type="button" class="btn btn-info" onclick="fnUpdateAckStatus('@item.Id','@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.Maintenace.GetHashCode()')" data-alerttypeid="@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.Maintenace.GetHashCode()">M</button>
                                                                                                                                                        </td>

                                                                                                                                                        @if (fRSAlert.AlertInstanceCount > 0)
                                                                                                                                                        {
                                                                                                                                                            <td class="text-center">
                                                                                                                                                                <div>
                                                                                                                                                                    <a class="justify-content-center" href="javascript:void(0)" onclick="fnShowFRSAlertInstance(@fRSAlert.Id); return false;" data-bs-original-title="" title="" style="color: black"><img style="width:25px;" src="@Url.Content("~/assets/images/Vector.png")" /></a>
                                                                                                                                                                </div>

                                                                                                                                                            </td>
                                                                                                                                                        }
                                                                                                                                                        @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode())
                                                                                                                                                        {
                                                                                                                                                            <td>
                                                                                                                                                                <a href="javascript:void(0)" class="btn btn-danger btn-quirk" onclick="Delete(@fRSAlert.Id)" data-bs-original-title="" title="Delete FRS Alert"><i class="fa fa-trash" style="color:white"></i></a>
                                                                                                                                                            </td>
                                                                                                                                                        }
                                                                                                                                                    </tr>
                                                                                                                                                </tbody>
                                                                                                                                            </table>

                                                                                                                                        </div>
                                                                                                                                    </div>
                                                                                                                                </li>
                                                                                                                            }

                                                                                                                        </ul>
                                                                                                                    </li>
                                                                                                                }


                                                                                                            </ul>
                                                                                                        </div>
                                                                                                    </li>

                                                                                                }
                                                                                            }

                                                                                        }
                                                                                    </ul>
                                                                                </div>
                                                                            </div>
                                                                        }

                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal bounceIn animated" id="modelAddRemark" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modalConfirm-dialog">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title">Add Remark</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnAlertRemarkId" />
                <input type="hidden" id="hdnAlertAlertStatusId" />
                <textarea class="form-control" id="txtAlertRemark" rows="3"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnUpdateRemark()">Save</button>
                <a class="btn btn-default" data-bs-dismiss="modal" data-bs-original-title="" title="">Close</a>
            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {

        $('#txtAlertLiveStatusFromDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        });

        $('#txtAlertLiveStatusToDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        });

        GetDivisionByZone($("#drpAlertLiveStatusZone").val(), $('#drpAlertLiveStatusDivision'), $('#hdnAlertLiveStatusDivisionId'));

        GetSiteByDivisionId($("#drpAlertLiveStatusDivision").val(), $('#drpAlertLiveStatusSites'), $('#hdnAlertLiveStatusSiteId'));

        $("#drpAlertLiveStatusZone").change(function () {
            GetDivisionByZone($(this).val(), $('#drpAlertLiveStatusDivision'));

        });

        $("#drpAlertLiveStatusDivision").change(function () {
            GetSiteByDivisionId($(this).val(), $('#drpAlertLiveStatusSites'));
        });

        $('#allSelectCheckbox').change(function () {
            if ($(this).prop('checked') == true) {
                $('.clsSelectCheckbox_' + $(this).val()).prop('checked', true);
            } else {
                $('.clsSelectCheckbox_' + $(this).val()).prop('checked', false);

                $('.clsSelectAlltype').prop('checked', false);
            }
        });

        $('.popper').popover({
            placement: 'top',
            container: 'body',
            html: true,
            content: function () {
                return $(this).next('.popper-content').html();
            },
            template: '<div class="popover custom-popover" role="tooltip"><div class="arrow"></div><h3 class="popover-header"></h3><div class="popover-body"></div></div>'
        });

    });

    function fnUpdateAckStatus(alertId, acknowledgemenStatusId) {

        if (confirm('Are you sure you want to update acknowledgement?')) {
            var mFRSAlert = {};

            mFRSAlert.AcknowledgemenStatusId = acknowledgemenStatusId;
            mFRSAlert.Id = alertId
            $("#loader").show();
            $.ajax({
                url: '/FRSReport/UpdateAcknowledgementStatus',
                type: 'Post',
                contentType: 'application/json',
                data: JSON.stringify(mFRSAlert),
                dataType: 'json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            fnGetAlertLiveStatus();
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }


    function ChangeColor(alertId, element) {
        if ($('.colorCheck_' + alertId).find("btn-primary")) {
            $('.colorChange_' + alertId).removeClass("btn-primary").addClass('btn-info');
        }
        if ($(element).hasClass("btn-info")) {
            $(element).removeClass("btn-info").addClass('btn-primary');
            if ($(element).hasClass("check")) {
                $('.ackbutton_' + alertId).hide();
            }
            else {
                $('.ackbutton_' + alertId).show();
            }

        }
    }


    function fnListFailureAlertsView() {
        $("#failureAlertsListView").show();
        $("#failureAlertsgroupView").hide();
    }

    function fnGroupFailureAlertsView() {
        $("#failureAlertsListView").hide();
        $("#failureAlertsgroupView").show();
    }

    function fnShowFailureAlertLogSite(siteId, typeName, $this) {

        if (siteId != null && siteId != '' && siteId != undefined && typeName != null && typeName != undefined && typeName != '') {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.maintenaceALertLogBySite_' + siteId + '_' + typeName).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.maintenaceALertLogBySite_' + siteId + '_' + typeName).hide();
            }
        }
    }

    function fnShowFailureAlertLogAsset(siteId, assetId, alertName, $this) {
        if (siteId != null && siteId != '' && siteId != undefined && alertName != null && alertName != undefined && alertName != '') {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.maintenaceALertLogByAsset_' + siteId + "" + assetId + '_' + alertName).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.maintenaceALertLogByAsset_' + siteId + "" + assetId + '_' + alertName).hide();
            }
        }
    }

    function fnShowFailureAlertLogAlertName(siteId, alertName, $this) {
        if (siteId != null && siteId != '' && siteId != undefined && alertName != null && alertName != undefined && alertName != '') {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.maintenaceALertLogByAletType_' + siteId + '_' + alertName).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.maintenaceALertLogByAletType_' + siteId + '_' + alertName).hide();
            }
        }
    }

    function AddRemark(id, statusId) {
        if (id != null && id != undefined && id != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRSReport/GetBy',
                type: 'POST',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data.Id > 0) {
                        $('#hdnAlertRemarkId').val(id);
                        $('#txtAlertRemark').val(data.Remark);
                        $('#hdnAlertAlertStatusId').val(statusId);
                    }

                    $('#modelAddRemark').modal('show');
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }

    function fnUpdateRemark() {
        if ($('#txtAlertRemark').val() != null && $('#txtAlertRemark').val() != undefined && $('#txtAlertRemark').val() != '') {
            var mFRSAlert = {};
            mFRSAlert.Id = $('#hdnAlertRemarkId').val();
            mFRSAlert.Remark = $('#txtAlertRemark').val();
            mFRSAlert.AcknowledgemenStatusId = $('#hdnAlertAlertStatusId').val();
            $("#loader").show();
            $.ajax({
                url: '/FRSReport/UpdateRemark',
                type: 'Post',
                contentType: 'application/json',
                data: JSON.stringify(mFRSAlert),
                dataType: 'json',
                success: function (data) {
                    $("#loader").hide();
                    $('#modelAddRemark').modal('hide');
                    fnGetAlertLiveStatus();
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $('#modelAddRemark').modal('hide');
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        } else {
            alert('Remark is required.')
        }


    }

    //function ChangeColor(element) {
    //    debugger
    //    if ($(".colorCheck").find("btn-primary")) {
    //        $(".colorChange").removeClass("btn-primary").addClass('btn-info');
    //    }
