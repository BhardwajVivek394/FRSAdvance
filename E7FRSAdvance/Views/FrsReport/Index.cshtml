        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.ZoneId = $('#drpAlertDetailZone').val();
        mSearchCriteria.DivisionId = $('#drpAlertDetailDivision').val();
        mSearchCriteria.SiteId = $('#drpAlertDetailSites').val();
        mSearchCriteria.AssetTypeId = $('#drpAlertDetailAssetType').val();
        mSearchCriteria.AlertTypeId = $('#drpAlertDetailAlertType').val();
        mSearchCriteria.AssetId = $('#drpAlertDetailAssetNumber').val();
        mSearchCriteria.FromDate = $('#txtAlertDetailFromDate').val();
        mSearchCriteria.ToDate = $('#txtAlertDetailToDate').val();
        mSearchCriteria.SectionId = $('#drpAlertDetailSection').val();
        mSearchCriteria.AlertInfoId = $('#drpAlertDetailCauseCode').val();
        mSearchCriteria.AlertStatus = $('#drpAlertDetailAlertStatus').val();
        mSearchCriteria.AcknowledgemenStatusId = $('#drpAlertDetailAcknowledgemenStatusId').val();

        mAssetLister.SearchCriteria = mSearchCriteria;

        $("#loader").show();
