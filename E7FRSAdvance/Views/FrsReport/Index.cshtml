<script>

    $(document).ready(function () {
        fnGetAlertLiveStatus();


        setInterval(function () {
            if ($('#tabAlertLiveStatus').hasClass("active")) {
                if ($("#switchAutoRefreshMode").prop('checked') == true) {
                    fnGetAlertLiveStatusAutoRefresh();
                }
            }
        }, 30000);

      //  ConnectWebSocket();
    });

    function fnChangeFRSReportType($this) {
        $('.tab-pane').removeClass('active');
        $('.tab-pane').removeClass('show');
        var value = $($this).val();
        if (value == "1") {
            $('#tabAlertLiveStatus').addClass("active");
            $('#tabAlertLiveStatus').addClass("show");
            fnGetAlertLiveStatus();
        }
        else if (value == "2") {
            $('#tabAlertDetailReport').addClass("active");
            $('#tabAlertDetailReport').addClass("show");
            fnGetAlertDetailReport();
        }
        else if (value == "3") {
            $('#tabAlertSummaryReport').addClass("active");
            $('#tabAlertSummaryReport').addClass("show");
            fnGetAlertSummaryReport();
        }
        else if (value == "4") {
            $('#tabAssetDetailReport').addClass("active");
            $('#tabAssetDetailReport').addClass("show");
            fnGetAssetList();
        }

    }

    function fnGetAssetList() {
        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#drpAssetDetailSites').val();
        mSearchCriteria.AssetTypeId = $('#drpAssetDetailAssetType').val();
        mAssetLister.SearchCriteria = mSearchCriteria;

        $("#loader").show();
        $.ajax({
            url: '/FRSReport/_AssetList',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divAssetDetailReport").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnGetAlertLiveStatusAutoRefresh() {
        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#drpAlertLiveStatusSites').val();
        mSearchCriteria.ZoneId = $('#drpAlertLiveStatusZone').val();
        mSearchCriteria.DivisionId = $('#drpAlertLiveStatusDivision').val();
        mSearchCriteria.AssetTypeId = $('#drpAlertLiveStatusAssetType').val();
        mSearchCriteria.AlertTypeId = $('#drpAlertLiveStatusAlertType').val();
        mSearchCriteria.SectionId = $('#drpAlertLiveStatusSection').val();
        mSearchCriteria.FromDate = $('#txtAlertLiveStatusFromDate').val();
        mSearchCriteria.ToDate = $('#txtAlertLiveStatusToDate').val();

        if ($("#switchAutoRefreshMode").prop('checked') == true) {
            mSearchCriteria.IsAutoRefresh = true;
        } else {
            mSearchCriteria.IsAutoRefresh = false;
        }

        var selected = $("input[type='radio'][name='SearchCriteria.AlertStatus']:checked");
        if (selected.length > 0) {
            var selectedVal = selected.val();
            mSearchCriteria.AlertStatus = selectedVal;

        } else {
            mSearchCriteria.AlertStatus = 2;
        }
        mAssetLister.SearchCriteria = mSearchCriteria;

        $.ajax({
            url: '/FRSReport/_AlertList',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            dataType: 'html',
            success: function (data) {
                $("#divAlertLiveStatus").empty().append(data);
                var d = new Date();
                var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
                $("#spnAlertLiveStatusUpdateTime").text(time);
            },
            error: function (response) {
                //CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnGetAlertLiveStatus() {
        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#drpAlertLiveStatusSites').val();
        mSearchCriteria.ZoneId = $('#drpAlertLiveStatusZone').val();
        mSearchCriteria.DivisionId = $('#drpAlertLiveStatusDivision').val();
        mSearchCriteria.AssetTypeId = $('#drpAlertLiveStatusAssetType').val();
        mSearchCriteria.AlertTypeId = $('#drpAlertLiveStatusAlertType').val();
        mSearchCriteria.SectionId = $('#drpAlertLiveStatusSection').val();
        mSearchCriteria.FromDate = $('#txtAlertLiveStatusFromDate').val();
        mSearchCriteria.ToDate = $('#txtAlertLiveStatusToDate').val();
        if ($("#switchAutoRefreshMode").prop('checked') == true) {
            mSearchCriteria.IsAutoRefresh = true;
        } else {
            mSearchCriteria.IsAutoRefresh = false;
        }
        var selected = $("input[type='radio'][name='SearchCriteria.AlertStatus']:checked");
        if (selected.length > 0) {
            var selectedVal = selected.val();
            mSearchCriteria.AlertStatus = selectedVal;

        } else {
            mSearchCriteria.AlertStatus = 2;
        }
        mAssetLister.SearchCriteria = mSearchCriteria;

        $("#loader").show();
        $.ajax({
            url: '/FRSReport/_AlertList',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divAlertLiveStatus").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

