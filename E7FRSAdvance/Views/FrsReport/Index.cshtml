    function GetDivisionByZone(zoneId, $division, $seldivid) {
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRSReport/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $($division).empty();
                    $($division).append($("<option></option>").val('0').html('All'));
                    $.each(data, function (key, value) {
                        if ($($seldivid).val() != '0' && $($seldivid).val() == value.Id) {
                            $($division).append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $($division).append($("<option></option>").val(value.Id).html(value.Name));
                        }
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function GetSiteByDivisionId(divisionId, $drpSiteId, $selsiteid) {
        if (divisionId != null && divisionId != undefined && divisionId != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRSReport/GetSiteByDivisionId',
                type: 'POST',
                data: '{divisionId:' + divisionId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $($drpSiteId).empty();
                    $($drpSiteId).append($("<option></option>").val('0').html('All'));
                    $.each(data, function (key, value) {

                        if ($($selsiteid).val() != '0' && $($selsiteid).val() == value.Id) {
                            $($drpSiteId).append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $($drpSiteId).append($("<option></option>").val(value.Id).html(value.Name));
                        }

                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function BindAssetType(AssetTypeId, SiteId, AssetId) {
        if (AssetTypeId != null && AssetTypeId != undefined && AssetTypeId != '' && SiteId != null && SiteId != undefined && SiteId != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRSReport/GetAssestBy',
                type: 'POST',
                data: '{siteId:' + SiteId + ',assetTypeId:' + AssetTypeId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $(AssetId).empty();
                    $(AssetId).append($("<option></option>").val('0').html('All'));
                    $.each(data, function (key, value) {
                        $(AssetId).append($("<option></option>").val(value.Id).html(value.Name));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }

    function BindAlertInfo(AssetTypeId, selId) {
        if (AssetTypeId != null && AssetTypeId != undefined && AssetTypeId != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRSReport/GetAlertInfo',
                type: 'POST',
                data: '{assetTypeId:' + AssetTypeId + '}',
                contentType: 'application/json',
                success: function (data) {

                    $("#loader").hide();
                    $('#drpAlertDetailCauseCode').empty();
                    $('#drpAlertDetailCauseCode').append($("<option></option>").val('0').html('All'));
                    $.each(data, function (key, value) {
                        if (selId != undefined && selId != '0' && selId == value.Id) {
                            $('#drpAlertDetailCauseCode').append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $('#drpAlertDetailCauseCode').append($("<option></option>").val(value.Id).html(value.Name));
                        }
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }

    function fnGetLiveData(siteName, assetId, assetTypeId) {
        $("#loader").show();
        $.ajax({
            url: '/AssetAttribute/_AssetAttributePartial',
            type: 'Post',
            data: '{siteName:"' + siteName + '",assetId:' + assetId + ',assetTypeId:' + assetTypeId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAssetAttributePartial").empty().append(data);
                $("#modal-assetLister").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("danger", "Something went wrong!");
            }
        });
    }

    function fnGetDataloggerEventData(siteId, assetName, searchDate) {
        var searchCriteria = {};
        searchCriteria.AssetName = assetName;
        searchCriteria.SiteId = siteId;
        //searchCriteria.StartTime = startdate;
        //searchCriteria.EndTime = endTime;
        searchCriteria.SearchDate = searchDate;
        var relayName = [];
        if (assetName != null && assetName != undefined && assetName != '') {
            var splitaname = assetName.split(',');
            if (splitaname != null) {
                $(splitaname).each(function (v, da) {
                    debugger;
                    relayName.push(da);

                });
            }
        }

        searchCriteria.RelayNames = relayName;

        $("#loader").show();
        $.ajax({
            url: '/FRSReport/_DataLoggerEvent',
            type: 'Post',
            dataType: 'html',
            data: JSON.stringify(searchCriteria),
            contentType: 'application/json',
            success: function (data) {
                debugger;
                $("#loader").hide();
                $("#divDataLoggerEventData").empty().append(data);
                $("#modalDataloggerEventData").modal('show');
            },
            error: function (response) {
                CommonNotification("error", "Something went wrong!");
            }
        });


    }

