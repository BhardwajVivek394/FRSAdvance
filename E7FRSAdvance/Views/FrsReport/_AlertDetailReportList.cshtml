<div class="modal bounceIn animated" id="modelShowAlertMessage" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modalConfirm-dialog modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title">Alert Message</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <div id="divShowAlertMessage"></div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" data-bs-original-title="" title="">Close</a>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        GetDivisionByZone($("#drpAlertDetailZone").val(), $('#drpAlertDetailDivision'), $('#hdnAlertDetailDivisionId'));

        GetSiteByDivisionId($("#drpAlertDetailDivision").val(), $('#drpAlertDetailSites'), $('#hdnAlertDetailSiteId'));

        $("#drpAlertDetailZone").change(function () {
            GetDivisionByZone($(this).val(), $('#drpAlertDetailDivision'));
        });

        $("#drpAlertDetailDivision").change(function () {
            GetSiteByDivisionId($(this).val(), $('#drpAlertDetailSites'));
        });

        BindAssetType($('#drpAlertDetailAssetType').val(), $('#drpAlertDetailSites').val(), $('#drpAlertDetailAssetNumber'));


        BindAlertInfo($('#drpAlertDetailAssetType').val(), $('#hdnAlertDetailAlertInfoId').val());

        $('#drpAlertDetailAssetType').change(function () {
            BindAssetType($(this).val(), $('#drpAlertDetailSites').val(), $('#drpAlertDetailAssetNumber'));

            BindAlertInfo($(this).val());
        });

        $('#drpAlertDetailSites').change(function () {
            if ($(this).val() != '0') {
                BindAssetType($('#drpAlertDetailAssetType').val(), $(this).val(), $('#drpAlertDetailAssetNumber'));
            }
        });

        $('#txtAlertDetailFromDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        });

        $('#txtAlertDetailToDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        });
    });


    function fnListFailureAlertDetailView() {
        $("#failureAlertsDetailListView").show();
        $("#failureAlertsDetailGroupView").hide();
    }

    function fnGroupFailureAlertDetailView() {
        $("#failureAlertsDetailListView").hide();
        $("#failureAlertsDetailGroupView").show();
    }

    function fnShowAlertDetailLogSite(siteId, typeName, $this) {

        if (siteId != null && siteId != '' && siteId != undefined && typeName != null && typeName != undefined && typeName != '') {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.maintenaceALertDetailLogBySite_' + siteId + '_' + typeName).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.maintenaceALertDetailLogBySite_' + siteId + '_' + typeName).hide();
            }
        }
    }

    function fnShowAlertDetailLogAsset(siteId, assetId, alertName, $this) {
        if (siteId != null && siteId != '' && siteId != undefined && alertName != null && alertName != undefined && alertName != '') {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.maintenaceAlertDetailLogByAsset_' + siteId + "" + assetId + '_' + alertName).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.maintenaceAlertDetailLogByAsset_' + siteId + "" + assetId + '_' + alertName).hide();
            }
        }
    }

    function fnShowAlertDetailLogAlertName(siteId, alertName, $this) {
        if (siteId != null && siteId != '' && siteId != undefined && alertName != null && alertName != undefined && alertName != '') {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.maintenaceAlertDetailLogByAletType_' + siteId + '_' + alertName).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.maintenaceAlertDetailLogByAletType_' + siteId + '_' + alertName).hide();
            }
        }
    }

    function fnShowAlertMessage(id) {
        if (id != null && id != undefined && id != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRSReport/GetBy',
                type: 'POST',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data.Id > 0) {
                        var txt = '<span>' + data.SetAlertMessage + '</span>';
                        txt += '<span>' + data.Description + '</span>';
                        if (data.ResetAlertMessage != null && data.ResetAlertMessage != undefined && data.ResetAlertMessage != '') {
                            txt += '<br /><b><u>Reset Message</u></b><span>' + data.ResetAlertMessage + '</span>';
                        }
                        $('#divShowAlertMessage').empty().append(txt);
                    }

                    $('#modelShowAlertMessage').modal('show');
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }
</script>