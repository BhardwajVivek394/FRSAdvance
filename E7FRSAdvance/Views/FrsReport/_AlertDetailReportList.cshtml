@model Domain.FRSAlertLister

<style>
    table {
        border-style: none;
    }

    td {
        padding: 10px;
    }

    .causeCode {
        white-space: nowrap;
    }
</style>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-md-12">
                        <div class="col-md-12">
                            <div class="col-md-1">
                                <strong style="margin-bottom:10px;margin-right:10px;">Search</strong>
                            </div>
                            <div class="row">
                                <div class="col-md-2 mt-2">
                                    <span>Zone</span>
                                    @Html.DropDownListFor(x => x.SearchCriteria.ZoneId, (IEnumerable<SelectListItem>)ViewBag.Zones, "All", new { @class = "form-control", @id = "drpAlertDetailZone", tabindex = 1 })
                                </div>
                                <div class="col-md-2 mt-2">
                                    <span>Division</span>
                                    <input type="hidden" id="hdnAlertDetailDivisionId" value="@Model.SearchCriteria.DivisionId" />
                                    @Html.DropDownListFor(x => x.SearchCriteria.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, "All", new { @class = "form-control", @id = "drpAlertDetailDivision", tabindex = 2 })
                                </div>
                                <div class="col-md-2 mt-2">
                                    <span>Section</span>
                                    @Html.DropDownListFor(x => x.SearchCriteria.SectionId, (IEnumerable<SelectListItem>)ViewBag.Sections, "All", new { @class = "form-control", @id = "drpAlertDetailSection", tabindex = 3 })
                                </div>
                                <div class="col-md-2 mt-2">
                                    <span>Site</span>
                                    <input type="hidden" id="hdnAlertDetailSiteId" value="@Model.SearchCriteria.SiteId" />
                                    @Html.DropDownListFor(x => x.SearchCriteria.SiteId, (IEnumerable<SelectListItem>)ViewBag.Sites, "All", new { @class = "form-control", @id = "drpAlertDetailSites", tabindex = 3 })
                                </div>
                                <div class="col-md-2 mt-2">
                                    <span>Asset Type</span>
                                    @Html.DropDownListFor(x => x.SearchCriteria.AssetTypeId, (IEnumerable<SelectListItem>)ViewBag.AssetTypes, "All", new { @class = "form-control", @id = "drpAlertDetailAssetType", tabindex = 4 })
                                </div>
                                <div class="col-md-2 mt-2">
                                    <input type="hidden" id="hdnAlertDetailAssetId" value="@Model.SearchCriteria.AssetId" />
                                    <span>Asset Number</span>
                                    @Html.DropDownListFor(x => x.SearchCriteria.AssetId, Enumerable.Empty<SelectListItem>(), "All", new { @class = "form-control", tabindex = 5, @id = "drpAlertDetailAssetNumber" })
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-2 mt-2">
                                    <span>Alert Type</span>
                                    @Html.DropDownListFor(x => x.SearchCriteria.AlertTypeId, Enum.GetValues(typeof(E7FRSAdvance.Utility.Utility.AlertType)).Cast<E7FRSAdvance.Utility.Utility.AlertType>().Select(x => new SelectListItem { Text = x.ToString(), Value = ((int)x).ToString() }), "All", new { @class = "form-control", tabindex = 6, @id = "drpAlertDetailAlertType" })
                                </div>
                                <div class="col-md-2 mt-2">
                                    <span>Alert status</span>
                                    @Html.DropDownListFor(x => x.SearchCriteria.AlertStatus, Enum.GetValues(typeof(E7FRSAdvance.Utility.Utility.AlertStatus)).Cast<E7FRSAdvance.Utility.Utility.AlertStatus>().Select(x => new SelectListItem { Text = x.ToString(), Value = ((int)x).ToString() }), "All", new { @class = "form-control", tabindex = 7, @id = "drpAlertDetailAlertStatus" })
                                </div>
                                <div class="col-md-2 mt-2">
                                    <span>Cause code</span>
                                    <input type="hidden" id="hdnAlertDetailAlertInfoId" value="@Model.SearchCriteria.AlertInfoId" />
                                    @Html.DropDownListFor(x => x.SearchCriteria.AlertInfoId, (IEnumerable<SelectListItem>)ViewBag.CauseCode, "All", new { @class = "form-control", @id = "drpAlertDetailCauseCode" })
                                </div>
                                <div class="col-md-2 mt-2">
                                    <span>Alert Feedback</span>
                                    @Html.DropDownListFor(x => x.SearchCriteria.AcknowledgemenStatusId, Enum.GetValues(typeof(E7FRSAdvance.Utility.Utility.AcknowledgemenStatus)).Cast<E7FRSAdvance.Utility.Utility.AcknowledgemenStatus>().Select(x => new SelectListItem { Text = x.ToString(), Value = ((int)x).ToString() }), "All", new { @class = "form-control", @id = "drpAlertDetailAcknowledgemenStatusId" })
                                </div>

                                <div class="col-md-2 mt-2">
                                    <span>From Date</span>
                                    <input class="form-control col-lg-9" id="txtAlertDetailFromDate" placeholder="From Date" type="text" value="@Model.SearchCriteria.FromDate.ToShortDateString()">
                                </div>
                                <div class="col-md-2 mt-2">
                                    <span>To Date</span>
                                    <input class="form-control col-lg-9" id="txtAlertDetailToDate" placeholder="To Date" type="text" value="@Model.SearchCriteria.ToDate.ToShortDateString()">
                                </div>
                            </div>
                        </div>

                        <div class="pull-right mt-2">
                            <a class="btn btn-success btn-quirk" onclick="fnGetAlertDetailReport()"><i class="fa fa-search"></i></a>
                            <a href="@Url.Action("DownloadFRSAlertDetail", "FRSReport")" class="btn btn-primary"><i class="fa fa-download"></i></a>
                        </div>
                    </div>
                    <div class="col-12 mt-2">
                        <div class="pull-left">

                            <span class="pull-left" style="margin-right:20px;"><a class="btn btn-sm btn-primary" onclick="fnGroupFailureAlertDetailView()" title="Grid View"><i class="fa fa-group"></i></a></span>
                            <span class="pull-left" style="margin-right:20px;"><a class="btn btn-sm btn-info" onclick="fnListFailureAlertDetailView()" title="List View"><i class="fa fa-list"></i></a></span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-12">
                    <div class="row mt-4">
                        <div class="col-xl-12" id="failureAlertsDetailListView">
                            <div class="table-responsive tableFixHead" style="max-height: 620px;">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th style="background-color:#4bacc6;color:white;">Sr No.</th>
                                            <th style="background-color: #215968; color: white; ">Zone</th>
                                            <th style="background-color: #404040; color: white;">Division</th>
                                            <th style="background-color: #4bacc6; color: white;">Section</th>
                                            <th style="background-color: #215968; color: white;">Station</th>
                                            <th style="background-color: #404040; color: white;">Asset Type</th>
                                            <th style="background-color: #4bacc6; color: white;">Asset Number</th>
                                            <th style="background-color: #215968; color: white;">Alert Type</th>
                                            <th style="background-color: #404040; color: white;">Alert status</th>
                                            <th style="background-color: #4bacc6; color: white;">Cause Code</th>
                                            <th style="background-color: #215968; color: white;">Incidence Date & Time</th>
                                            <th style="background-color: #404040; color: white;">Rectification Date & Time</th>
                                            <th style="background-color: #4bacc6; color: white;">Incidence Duration(h:m)</th>
                                            <th style="background-color: #215968; color: white;">Alert Feedback</th>
                                            <th style="background-color: #404040; color: white;">Alert feedback date & time</th>
                                            <th style="background-color: #4bacc6; color: white;">Maintainer Name</th>
                                            <th style="background-color: #215968; color: white;">Maintainer Designation</th>
                                            <th style="background-color: #404040; color: white;">Maintainer Mobile Number</th>
                                            <th style="background-color: #4bacc6; color: white;">Maintainer Remarks</th>
                                        </tr>
                                    </thead>

                                    <tbody style="max-height: 620px;overflow-y:auto;">
                                        @if (Model != null && Model.mFRSAlerts != null && Model.mFRSAlerts.Count > 0)
                                        {
                                            int counter = 0;
                                            foreach (var item in Model.mFRSAlerts)
                                            {
                                                counter++;
                                                <tr>
                                                    <td>@counter</td>
                                                    <td>@item.ZoneName</td>
                                                    <td>@item.DivisionName</td>
                                                    <td>@item.SectionName</td>
                                                    <td>@item.SiteName</td>
                                                    <td>@item.AssetType</td>
                                                    <td>@item.AssetName</td>
                                                    <td>
                                                        @if (item.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure)
                                                        {
                                                            <span>@E7FRSAdvance.Utility.Utility.AlertType.Failure.ToString()</span>
                                                        }
                                                        else if (item.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive)
                                                        {
                                                            <span>@E7FRSAdvance.Utility.Utility.AlertType.Predictive.ToString()</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (item.IsActive == true)
                                                        {
                                                            <div class="span badge rounded-pill pill-badge-danger">@E7FRSAdvance.Utility.Utility.AlertStatus.Active.ToString()</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="span badge rounded-pill pill-badge-success">@E7FRSAdvance.Utility.Utility.AlertStatus.InActive.ToString()</div>
                                                        }
                                                    </td>
                                                    <td class="causeCode">
                                                        <a href="javascript:void(0)" onclick="fnShowAlertMessage('@item.Id')">@item.CauseCode</a>
                                                    </td>
                                                    <td>@item.SetTimeStamp</td>
                                                    <td>@item.ResetTimeStamp</td>
                                                    <td>
                                                        @if (item.ResetTimeStamp != null && item.ResetTimeStamp.Value != DateTime.MinValue)
                                                        {

                                                            var duration = (item.ResetTimeStamp.Value - item.SetTimeStamp);
                                                            string formattedDuration = Convert.ToInt32(duration.TotalHours) + ":" + Convert.ToInt32(duration.Minutes);

                                                            <span>@formattedDuration</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (item.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True)
                                                        {
                                                            <span>@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True.ToString()</span>
                                                        }
                                                        else if (item.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False)
                                                        {
                                                            <span>@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False.ToString()</span>
                                                        }
                                                        else if (item.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.Maintenace)
                                                        {
                                                            <span>@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.Maintenace.ToString()</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @item.AcknowledgemenTimeStamp
                                                    </td>

                                                    <td>
                                                        @item.MaintainerName
                                                    </td>
                                                    <td>
                                                        @item.MaintainerDesignation
                                                    </td>
                                                    <td>
                                                        @item.MaintainerMobileNumber
                                                    </td>
                                                    <td>
                                                        @item.Remark
                                                    </td>
                                                    @*<td>
                                                            @item.Remark
                                                        </td>*@
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="col-xl-12" id="failureAlertsDetailGroupView" style="display:none">
                            @if (Model.AssetTypes != null && Model.AssetTypes.Count > 0)
                            {
                                <div class="container-fluid">
                                    <div class="email-wrap email-main-wrapper">
                                        <div class="row">
                                            <div class="col-xxl-12 col-xl-12 box-col-12">
                                                <div class="email-right-aside">
                                                    <div class="card email-body email-list">
                                                        <div class="mail-header-wrapper" style="background-color:#215968; color:white; border-top-left-radius: 15px; border-top-right-radius:15px;">
                                                            <div class="col-xl-12">
                                                                <div class="mail-header">
                                                                    <div class="form-check form-check-inline">

                                                                        @*<input class="form-check-input checkbox-primary" id="allSelectCheckbox" type="checkbox" value="@Model.AssetTypes.FirstOrDefault().Name.Replace(" ","")">
                                                                            <label class="form-check-label" for="allSelectCheckbox"></label>*@
                                                                        <ul class="email-tabs nav" role="tablist">
                                                                            @foreach (var item in Model.AssetTypes)
                                                                            {

                                                                                <li class="nav-item">
                                                                                    @{
                                                                                        var isActive = string.Empty;
                                                                                    }

                                                                                    @if (item == Model.AssetTypes.FirstOrDefault())
                                                                                    {
                                                                                        isActive = "active";
                                                                                    }

                                                                                    <a class="nav-link @isActive" id="@item.Name.Replace(" ","")" data-bs-toggle="pill" href="#@item.Name.Replace(" ","")-pill-failureAlerts-tab" role="tab" aria-controls="@item.Name.Replace(" ","")-pill" aria-selected="false" style="color:white;">
                                                                                        <div>@item.Name</div>
                                                                                        <span class="span badge rounded-pill pill-badge-primary">@Model.mFRSAlerts.Where(x => x.AssetTypeId == item.Id).Count()</span>
                                                                                    </a>
                                                                                </li>

                                                                            }

                                                                        </ul>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="tab-content" id="email-pills-tabContent">
                                                            @foreach (var item in Model.AssetTypes)
                                                            {
                                                                var isActive = "";
                                                                if (item == Model.AssetTypes.FirstOrDefault())
                                                                {
                                                                    isActive = "show active";
                                                                }
                                                                <div class="tab-pane fade @isActive" id="@item.Name.Replace(" ","")-pill-failureAlerts-tab" role="tabpanel" aria-labelledby="@item.Name.Replace(" ","")-pill-tab">
                                                                    <div class="mail-body-wrapper">
                                                                        <ul id="paginated-list" data-current-page="1" aria-live="polite">
                                                                            @if (Model.mFRSAlerts != null && Model.mFRSAlerts.Count > 0)
                                                                            {
                                                                                foreach (var site in Model.mFRSAlerts.Where(x => x.AssetTypeId == item.Id).GroupBy(x => new { x.SiteId, x.SiteName }).Select(x => x.Key).ToList())
                                                                                {
                                                                                    int smsCount = Model.mFRSAlerts.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId).Count();
                                                                                    if (smsCount > 0)
                                                                                    {
                                                                                        <li class="inbox-data" style="background-color:#f4f8f8">
                                                                                            <div class="inbox-message">

                                                                                                <div class="email-data">
                                                                                                    <span style="float:left;">@site.SiteName &nbsp;</span><span class="span badge rounded-pill1 pill-badge-primary" style="color:white;">@smsCount</span>
                                                                                                </div>
                                                                                                <span class="pull-right">
                                                                                                    <a href="#" data-bs-original-title="" title=""><i class="fa fa-angle-up fa-3x" onclick="fnShowAlertDetailLogSite('@site.SiteId','@item.Name.Replace(" ", "")', this); return false;"></i></a>
                                                                                                </span>
                                                                                            </div>
                                                                                        </li>
                                                                                    }

                                                                                    foreach (var alert in Model.mFRSAlerts.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId).GroupBy(x => new { x.AlertTypeId, x.CauseCode }).Select(x => x.Key).ToList())
                                                                                    {

                                                                                        var smsAlertNameCount = Model.mFRSAlerts.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId && x.CauseCode == alert.CauseCode).Count();
                                                                                        <li class="inbox-data  maintenaceALertDetailLogBySite_@(site.SiteId)_@(item.Name.Replace(" ",""))" style="display:none">
                                                                                            <div class="mail-body-wrapper" style="width:100%;">
                                                                                                <ul id="paginated-list" data-current-page="1" aria-live="polite">
                                                                                                    <li class="inbox-data" style="background-color: #4bacc6;">
                                                                                                        <div class="inbox-message">
                                                                                                            <div class="email-data">
                                                                                                                <span style="float: left; color: white;">@alert.CauseCode  &nbsp;</span><span class="span badge rounded-pill1 pill-badge-primary1" style="color:black;">@smsAlertNameCount</span>
                                                                                                            </div>
                                                                                                            <span class="pull-right">
                                                                                                                <a href="#" data-bs-original-title="" title="" style="color:white"><i class="fa fa-angle-up fa-3x" onclick="fnShowAlertDetailLogAlertName('@site.SiteId','@E7FRSAdvance.Utility.ExtensionMethod.RemoveSpecialCharactersWithSpace(alert.CauseCode)', this); return false;"></i></a>
                                                                                                            </span>
                                                                                                        </div>
                                                                                                    </li>
                                                                                                    @foreach (var asset in Model.mFRSAlerts.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId && x.CauseCode == alert.CauseCode).GroupBy(x => new { x.AssetId, x.AssetName }).Select(g => new { g.Key, Count = g.Count() }).OrderByDescending(x => x.Count).Select(x => x.Key).ToList())
                                                                                                    {
                                                                                                        var smsAssetCount = Model.mFRSAlerts.Where(x => x.AssetTypeId == item.Id && x.SiteId == site.SiteId && x.CauseCode == alert.CauseCode && x.AssetId == asset.AssetId).Count();
                                                                                                        <li class="inbox-data  maintenaceAlertDetailLogByAletType_@(site.SiteId)_@(E7FRSAdvance.Utility.ExtensionMethod.RemoveSpecialCharactersWithSpace(alert.CauseCode))" style="display:none">
                                                                                                            <ul id="paginated-list" data-current-page="1" aria-live="polite" style="width:100%;">
                                                                                                                <li class="inbox-data" style="background-color: #21596880; ">
                                                                                                                    <div class="inbox-message">
                                                                                                                        <div class="email-data">
                                                                                                                            <span style="float: left; color: white;">@asset.AssetName  &nbsp;</span><span class="span badge rounded-pill1 pill-badge-primary1" style="color:black;">@smsAssetCount</span>
                                                                                                                        </div>
                                                                                                                        <span class="pull-right">

                                                                                                                            <a href="#" data-bs-original-title="" title="" style="color:white"><i class="fa fa-angle-up fa-3x" onclick="fnShowAlertDetailLogAsset('@site.SiteId','@asset.AssetId','@E7FRSAdvance.Utility.ExtensionMethod.RemoveSpecialCharactersWithSpace(alert.CauseCode)', this); return false;"></i></a>
                                                                                                                        </span>
                                                                                                                    </div>
                                                                                                                </li>

                                                                                                                <li class="inbox-data  maintenaceAlertDetailLogByAsset_@(site.SiteId + "" + asset.AssetId)_@(E7FRSAdvance.Utility.ExtensionMethod.RemoveSpecialCharactersWithSpace(alert.CauseCode))" style="display:none">
                                                                                                                    <div class="table-responsive">
                                                                                                                        <table class="table">
                                                                                                                            <thead>
                                                                                                                                <tr>
                                                                                                                                    <th style="background-color:#4bacc6;color:white;">Sr No.</th>
                                                                                                                                    <th style="background-color: #215968; color: white;">Alert Type</th>
                                                                                                                                    <th style="background-color: #215968; color: white;">Alert status</th>
                                                                                                                                    <th style="background-color: #404040; color: white;">Cause Code</th>
                                                                                                                                    <th style="background-color: #4bacc6; color: white;">Incidence Date & Time</th>
                                                                                                                                    <th style="background-color: #215968; color: white;">Rectification Date & Time</th>
                                                                                                                                    <th style="background-color: #404040; color: white;">Incidence Duration(h:m)</th>
                                                                                                                                    <th style="background-color: #4bacc6; color: white;">Alert Feedback</th>
                                                                                                                                    <th style="background-color: #215968; color: white;">Alert feedback date & time</th>
                                                                                                                                    <th style="background-color: #404040; color: white;">Maintainer Name</th>
                                                                                                                                    <th style="background-color: #4bacc6; color: white;">Maintainer Designation</th>
                                                                                                                                    <th style="background-color: #215968; color: white;">Maintainer Mobile Number</th>
                                                                                                                                    <th style="background-color: #404040; color: white;">Maintainer Remarks</th>
                                                                                                                                </tr>
                                                                                                                            </thead>

                                                                                                                            <tbody>
                                                                                                                                @if (Model != null && Model.mFRSAlerts != null && Model.mFRSAlerts.Count > 0)
                                                                                                                                {
                                                                                                                                    int counter = 0;
                                                                                                                                    foreach (var frsalert in Model.mFRSAlerts)
                                                                                                                                    {
                                                                                                                                        counter++;
                                                                                                                                        <tr>
                                                                                                                                            <td>@counter</td>
                                                                                                                                            <td>
                                                                                                                                                @if (frsalert.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure)
                                                                                                                                                {
                                                                                                                                                    <span>@E7FRSAdvance.Utility.Utility.AlertType.Failure.ToString()</span>
                                                                                                                                                }
                                                                                                                                                else if (frsalert.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive)
                                                                                                                                                {
                                                                                                                                                    <span>@E7FRSAdvance.Utility.Utility.AlertType.Predictive.ToString()</span>
                                                                                                                                                }
                                                                                                                                            </td>
                                                                                                                                            <td>
                                                                                                                                                @if (frsalert.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True)
                                                                                                                                                {
                                                                                                                                                    <span>@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True.ToString()</span>
                                                                                                                                                }
                                                                                                                                                else if (frsalert.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False)
                                                                                                                                                {
                                                                                                                                                    <span>@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False.ToString()</span>
                                                                                                                                                }
                                                                                                                                                else if (frsalert.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.Maintenace)
                                                                                                                                                {
                                                                                                                                                    <span>@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.Maintenace.ToString()</span>
                                                                                                                                                }
                                                                                                                                            </td>
                                                                                                                                            <td class="causeCode">
                                                                                                                                                <a href="javascript:void(0)" onclick="fnShowAlertMessage('@item.Id')">@frsalert.CauseCode</a>
                                                                                                                                            </td>
                                                                                                                                            <td>@frsalert.SetTimeStamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                                                                                                                            <td>
                                                                                                                                                @if (frsalert.ResetTimeStamp != null && frsalert.ResetTimeStamp != DateTime.MinValue)
                                                                                                                                                {
                                                                                                                                                    <span>@frsalert.ResetTimeStamp.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                                                                                                                                }
                                                                                                                                            </td>
                                                                                                                                            <td>
                                                                                                                                                @if (frsalert.ResetTimeStamp != null && frsalert.ResetTimeStamp.Value != DateTime.MinValue)
                                                                                                                                                {
                                                                                                                                                    var hours = (frsalert.ResetTimeStamp.Value - frsalert.SetTimeStamp).TotalHours;
                                                                                                                                                    var min = (frsalert.ResetTimeStamp.Value - frsalert.SetTimeStamp).TotalMinutes;
                                                                                                                                                    <span>@Convert.ToInt32(hours):@Convert.ToInt32(min)</span>
                                                                                                                                                }
                                                                                                                                            </td>
                                                                                                                                            <td>
                                                                                                                                                @frsalert.Remark
                                                                                                                                            </td>
                                                                                                                                            <td>
                                                                                                                                                @if (frsalert.AcknowledgemenTimeStamp != null && frsalert.AcknowledgemenTimeStamp != DateTime.MinValue)
                                                                                                                                                {
                                                                                                                                                    <span>@frsalert.AcknowledgemenTimeStamp.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                                                                                                                                }
                                                                                                                                            </td>

                                                                                                                                            <td>
                                                                                                                                                @frsalert.MaintainerName
                                                                                                                                            </td>
                                                                                                                                            <td>
                                                                                                                                                @frsalert.MaintainerDesignation
                                                                                                                                            </td>
                                                                                                                                            <td>
