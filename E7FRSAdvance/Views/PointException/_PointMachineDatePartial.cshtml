@*@model List<Domain.PointMachineData>*@
@model Domain.Asset

@if (Model != null && Model.mPointMachineData != null)
{
    var mPointMachineException = new List<Domain.PointMachineException>();
    if (ViewBag.PointMachineException != null)
    {
        mPointMachineException = ViewBag.PointMachineException as List<Domain.PointMachineException>;
    }
    foreach (var point in Model.mPointMachineData.OrderByDescending(x => x.Date))
    {
        var mPointMachineExceptionA = mPointMachineException.Where(x => x.TsTime == point.Date && x.Type == "A").FirstOrDefault();
        var mPointMachineExceptionB = mPointMachineException.Where(x => x.TsTime == point.Date && x.Type == "B").FirstOrDefault();

        var date = Convert.ToDateTime(point.Date).ToString("MM/dd/yyyy");
        <tr>

            <td>
                @point.Date
            </td>
            <td class="assetname">
                @point.AssetType
            </td>
            <td>
                @point.Direction  Operation
            </td>
            @if (Model.IsSeriesOpration != null && Model.IsSeriesOpration.Value)
            {
                var sumTime = point.PointMachineJson.A_C_TIME + point.PointMachineJson.B_C_TIME;

                <td>
                    @if (point.PointMachineJson.Combine_C_TIME > 0 && point.PointMachineJson.Combine_V_TIME > 0)
                    {
                        <span>(Max/Avg/Time)</span>
                        <span>
                            <a href="#" onclick="fnBindSignatureGraghPointExc('@Json.Encode(point.PointMachineJson)','CC',' @point.Date','@point.Direction','@point.AssetType')">C(@point.PointMachineJson.Combine_C_MAX/@point.PointMachineJson.Combine_C_AVERAGE/@point.PointMachineJson.Combine_C_TIME)</a>
                            <br />
                            <a href="#" onclick="fnBindSignatureGraghPointExc('@Json.Encode(point.PointMachineJson)','CV',' @point.Date','@point.Direction','@point.AssetType')">V(@point.PointMachineJson.Combine_V_MAX/@point.PointMachineJson.Combine_V_AVERAGE/@point.PointMachineJson.Combine_V_TIME)</a>
                        </span>
                    }
                    else
                    {
                        <span>
                            <a href="#" onclick="fnBindSignatureGraghPointExc('@Json.Encode(point.PointMachineJson)','CC',' @point.Date','@point.Direction','@point.AssetType')">C</a>/<a href="#" onclick="fnBindSignatureGraghPointExc('@Json.Encode(point.PointMachineJson)','CV',' @point.Date','@point.Direction','@point.AssetType')">V</a>/<a>T(@sumTime)</a>
                        </span>
                    }

                </td>
            }

            <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.A || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindSignatureGraghPointExc('@Json.Encode(point.PointMachineJson)','AC',' @point.Date','@point.Direction','@point.AssetType')">

                @string.Format("{0:0.00}", point.PointMachineJson.A_C_MAX)   /  @string.Format("{0:0.00}", @point.PointMachineJson.A_C_AVERAGE) (@point.PointMachineJson.A_C_CurveArea)


            </td>
            <td onclick="fnBindSignatureGraghPointExc('@Json.Encode(point.PointMachineJson)','AV',' @point.Date','@point.Direction','@point.AssetType')">
                @point.PointMachineJson.A_V_AVERAGE

            </td>
            <td>
                <span> @point.PointMachineJson.A_C_TIME </span>
            </td>
            <td class="text-center">
                @if (mPointMachineExceptionA != null && mPointMachineExceptionA.Id > 0)
                {
                    <input type="checkbox" class="clspmEventDataCheck-point-exc" data-PointId="@point.TimeStamp.Ticks" data-AssetId="@Model.Id" data-direction="@point.Direction" data-tstime="@point.Date" data-timestamp="@point.TimeStamp" data-type="A" data-pmjson="@string.Join(",", point.PointMachineJson.A_C)" checked />
                    <div id="divEventDataCheckA_@point.TimeStamp.Ticks">
                        <input id="txtEventDataClusterA_@point.TimeStamp.Ticks" type="number" class="form-control mt-2" placeholder="Cluster" value="@mPointMachineExceptionA.Cluster" />
                        <textarea id="txtEventDataRemarkA_@point.TimeStamp.Ticks" class="form-control mt-2" placeholder="Remark">@mPointMachineExceptionA.Remark</textarea>
                    </div>
                }
                else
                {
                    <input type="checkbox" onclick="fnShowEventDataCheck('@point.TimeStamp.Ticks','A',this)" class="clspmEventDataCheck-point-exc" data-PointId="@point.TimeStamp.Ticks" data-AssetId="@Model.Id" data-direction="@point.Direction" data-tstime="@point.Date" data-timestamp="@point.TimeStamp" data-type="A" data-pmjson="@string.Join(",", point.PointMachineJson.A_C)" />
                    <div id="divEventDataCheckA_@point.TimeStamp.Ticks" style="display:none">
                        <input id="txtEventDataClusterA_@point.TimeStamp.Ticks" type="number" class="form-control mt-2" placeholder="Cluster" />
                        <textarea id="txtEventDataRemarkA_@point.TimeStamp.Ticks" class="form-control mt-2" placeholder="Remark"></textarea>
                    </div>
                }


            </td>
            @if (Model.IsHalfPointMachine == null || (Model.IsHalfPointMachine != null && !Model.IsHalfPointMachine.Value))
            {
                <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId  != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.B || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindSignatureGraghPointExc('@Json.Encode(point.PointMachineJson)','BC',' @point.Date','@point.Direction','@point.AssetType')">

                    @string.Format("{0:0.00}", point.PointMachineJson.B_C_MAX)  /  @string.Format("{0:0.00}", @point.PointMachineJson.B_C_AVERAGE) (@point.PointMachineJson.B_C_CurveArea)

                </td>
                <td onclick="fnBindSignatureGraghPointExc('@Json.Encode(point.PointMachineJson)','BV',' @point.Date','@point.Direction','@point.AssetType')">
                    @point.PointMachineJson.B_V_AVERAGE

                </td>
                <td>
                    @point.PointMachineJson.B_C_TIME
                </td>
                <td class="text-center">
                    @if (mPointMachineExceptionB != null && mPointMachineExceptionB.Id > 0)
                    {
                        <input type="checkbox" id="chkEventDatapointB_@point.Id" class="clspmEventDataCheck-point-exc" data-PointId="@point.TimeStamp.Ticks" data-AssetId="@Model.Id" data-direction="@point.Direction" data-tstime="@point.Date" data-timestamp="@point.TimeStamp" data-type="B" data-pmjson="@string.Join(",", point.PointMachineJson.B_C)" checked />
                        <div id="divEventDataCheckB_@point.TimeStamp.Ticks">
                            <input id="txtEventDataClusterB_@point.TimeStamp.Ticks" type="number" class="form-control mt-2" placeholder="Cluster" value="@mPointMachineExceptionB.Cluster" />
                            <textarea id="txtEventDataRemarkB_@point.TimeStamp.Ticks" class="form-control mt-2" placeholder="Remark">@mPointMachineExceptionB.Remark</textarea>
                        </div>
                    }
                    else
                    {
                        <input type="checkbox" id="chkEventDatapointB_@point.Id" onclick="fnShowEventDataCheck('@point.TimeStamp.Ticks','B',this)" class="clspmEventDataCheck-point-exc" data-PointId="@point.TimeStamp.Ticks" data-AssetId="@Model.Id" data-direction="@point.Direction" data-tstime="@point.Date" data-timestamp="@point.TimeStamp" data-type="B" data-pmjson="@string.Join(",", point.PointMachineJson.B_C)" />
                        <div id="divEventDataCheckB_@point.TimeStamp.Ticks" style="display:none;">
                            <input id="txtEventDataClusterB_@point.TimeStamp.Ticks" type="number" class="form-control mt-2" placeholder="Cluster" />
                            <textarea id="txtEventDataRemarkB_@point.TimeStamp.Ticks" class="form-control mt-2" placeholder="Remark"></textarea>
                        </div>
                    }

                </td>
            }

        </tr>
    }
}


