@model Domain.PointMachineExceptionLister

@Html.HiddenFor(m => m.SearchCriteria.ColumnName, new { id = "hdnColumnName" })
@Html.HiddenFor(m => m.SearchCriteria.SortDirection, new { id = "hdnSortDirection" })


<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />
<table class="table">
    <thead class="bg-primary">
        <tr>
            <th colspan="2" class="text-center">Action</th>
            <th data-sortcolumn="TimeStamp" class="sorting" id="thTimeStamp" onclick="SortList('TimeStamp');">TimeStamp</th>
            <th data-sortcolumn="Name" class="sorting" id="thName" onclick="SortList('Name');">Name</th>
            <th data-sortcolumn="Direction" class="sorting" id="thDirection" onclick="SortList('Direction');">Direction</th>
            <th data-sortcolumn="Cluster" class="sorting" id="thCluster" onclick="SortList('Cluster');">Cluster</th>
            <th data-sortcolumn="Remark" class="sorting" id="thRemark" onclick="SortList('Remark');">Remark</th>
            <th data-sortcolumn="IsDivisionPDF" class="sorting" id="thIsDivisionPDF" onclick="SortList('IsDivisionPDF');">Is Division PDF</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.PointMachineExceptions != null && Model.PointMachineExceptions.Count > 0)
        {
            foreach (var item in Model.PointMachineExceptions)
            {
                var arrayData = item.ArrayData.Split(',');
                <tr class="table-light">
                    <td class="text-center" style="width:50px;">
                        <a title="Edit">
                            <i class="text-vision fa fa-edit" onclick="GetById('@item.Id')"></i>
                        </a>
                    </td>
                    <td class="text-center " style="width:50px;">
                        <a title="Delete">
                            <i class="text-danger fa fa-trash" onclick="DeleteById('@item.Id')"></i>
                        </a>

                    </td>

                    <td>@item.TsTime</td>
                    <td>
                        @item.Name
                    </td>
                    <td>
                        <a href="javascript:void(0)" onclick="fnShowPointExceptionGraph('@Json.Encode(arrayData)','@item.Direction')">
                            <span>@item.Direction</span>
                            <span>@item.Type</span>
                        </a>


                    </td>
                    <td>@item.Cluster</td>
                    <td>@item.Remark</td>
                    <td class="">
                        @if (item.IsDivisionPDF)
                        {
                            <input type="checkbox" disabled checked />
                        }
                        else
                        {
                            <input type="checkbox" disabled />
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    No record found
                </td>
            </tr>
        }
    </tbody>
</table>

<script>

    function GetById(id) {
        $("#loader").show();
        $.ajax({
            url: '/PointException/Edit',
            type: 'Post',
            data: '{id:' + id + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divSavePointMachineException").empty().append(data);
                $("#modal-add-pointmachineexception").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnUpdateException() {

        if (IsValidException()) {
            $('#frmSavePointExceptionList').submit();
        }
    }

    function IsValidException() {
        var result = true;

        if ($.trim($("#txtCluster").val()).length == 0) {
            $("#txtCluster").next("span").html("Cluster is required");
            result = false;
        }
        else {
            $("#txtCluster").next("span").html("");
        }

        if ($.trim($("#txtRemark").val()).length == 0) {
            $("#txtRemark").next("span").html("Remark is required");
            result = false;
        }
        else {
            $("#txtRemark").next("span").html("");
        }

        return result;
    }

    function DeleteById(id) {
        if (confirm('Are you sure you want to delete this record?')) {
            $("#loader").show();
            $.ajax({
                url: '/PointException/Delete',
                type: 'Post',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            $("#frmPointExceptionList").submit();
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
    }

    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmPointExceptionList").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize)
            {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmPointExceptionList").submit();
            }
        }
    }
</script>
