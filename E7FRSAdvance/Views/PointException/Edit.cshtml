@model Domain.PointMachineException

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-pointmachineexception" tabindex="-1" aria-labelledby="modal-add-PointMachineException" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content bradius4">
            @Html.HiddenFor(m => Model.Id)
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Point Machine Exception</span></h4>
                }
                else
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader"> Edit Point Machine Exception</span></h4>
                }
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="mb-3">
                                <label class="form-label">Cluster <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => m.Cluster, new { @class = "form-control", tabindex = 1, @id= "txtCluster", @type="number" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Remark <span class="text-danger"></span></label>
                                <div class="">
                                    @Html.TextAreaFor(m => m.Remark, new { @class = "form-control", tabindex = 2, @id = "txtRemark" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="control-label"><span>Is Division PDF</span>  @Html.CheckBoxFor(m => Model.IsDivisionPDF, new { style = "vertical-align:sub" })</label>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnUpdateException()" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        //$("#zoneAdd").select2({ minimumResultsForSearch: Infinity, dropdownParent: $('#modal-add-division'), width: '100%' });

        debugger;
        if ($('#hdnSaveType').val() == 'Success') {

            CommonNotification($("#hdnSaveType").val().toUpperCase(), $("#hdnSaveMessage").val(), $("#hdnSaveType").val());

           // $("#modal-add-pointmachineexception").modal('hide');
            $("#divSavePointMachineException").empty();
            $("body").removeClass("modal-open");
            $("[class*='modal-backdrop']").remove();
            $("#frmPointExceptionList").submit();
            window.history.pushState('', '', "Index");
        }
        else if ($('#hdnSaveType').val() == 'Error') {
            CommonNotification($("#hdnSaveType").val().toUpperCase(), $("#hdnSaveMessage").val(), $("#hdnSaveType").val());

           // $("#modal-add-pointmachineexception").modal('hide');
            $("#divSavePointMachineException").empty();
            $("body").removeClass("modal-open");
            $("[class*='modal-backdrop']").remove();
            window.history.pushState('', '', "Index");
        }
    });

</script>