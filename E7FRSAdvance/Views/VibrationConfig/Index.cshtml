
@{
    ViewBag.Title = "YardConfig";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>


<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Vibration Config</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="pull-left">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Sites</strong>
                            </div>
                            <div class="pull-left">
                                @Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites,"Select", new { @class = "form-control", tabindex = 1 })
                            </div>
                            <div class="pull-left" style="margin-left:10px;">
                                <a class="btn btn-dark btn-sm btn-quirk" onclick="AddNumberVibration()" data-bs-original-title="" title=""><span class="fa fa-plus"></span> Add Vibration</a>
                            </div>
                            <div class="pull-left" style="margin-left:10px;">
                            </div>
                        </div>
                      
                        <div class="col-sm-12">
                            <div id="divVibrationConfig">
                                <table class="table">
                                    <tbody id="siteNumberBody">

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>

    <div class="row">
        
    </div>
</div>
<script>
    $(document).ready(function () {
        $('#SiteId').change(function () {
            GetData();        
        });
    }); 

    function GetData() {
        $("#siteNumberBody").empty();
        if ($('#SiteId').val() != null && $('#SiteId').val() != undefined && $('#SiteId').val() != '' && $('#SiteId').val() != "0") {
            $.ajax({
                url: '/VibrationConfig/GetAllVibrationConfig',
                type: 'POST',
                data: '{siteId:' + $('#SiteId').val() + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    var rowId = 0;

                    $(data).each(function (data, val) {
                        var temp = '';
                        rowId++;
                        temp += "<tr data-rowId=" + rowId + ">";
                        temp += "<td class='text-center width60' style='vertical-align:middle'>";
                        temp += "<a data-placement='top' data-toggle='tooltip' class='tooltips' data-original-title='Delete' style='cursor: pointer'><i class='fa fa-trash text-danger' onclick='fnDelete(" + val.Id + ")'></i></a>";
                        temp += "</td>";
                        temp += "<td>";
                        temp += "<label>" + val.AssetName + "</label>";
                        temp += "</td>";
                        temp += "<td>";
                        temp += "<label>" + val.VibrationType + "</label>";
                        temp += "</td>";
                        temp += "<td style='width:330px'>";
                        temp += "<input type='text' placeholder='Address' class='form-control' id='txtAddress_" + rowId + "' value=" + val.Address + " />";
                        temp += "</td>";
                        temp += "<td style='width:330px'>";
                        temp += "<input type='text' placeholder='Param value' class='form-control' id='txtParam_" + rowId + "' value=" + val.Param + " />";
                        temp += "</td>";
                        temp += "<td class='text-center width60'>";
                        temp += "<button type='button' onclick='fnUpdateVibrationConfig(" + rowId + "," + val.AssetId + "," + val.VibrationTypeId + ")' class='btn btn-success btn-quirk'>Update</button>";
                        temp += "</td>";
                        temp += "</tr>";
                        $("#siteNumberBody").append(temp);
                    });
                    GetAllAsset();
                    GetAllVibrationType();
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }    
    }

    function GetAllAsset() {
        $("#loader").show();
        $.ajax({
            url: '/VibrationConfig/GetAllAsset',
            type: 'POST',
            data: '{siteId:' + $('#SiteId').val() + ',assetTypeId:' + '@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()' + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                var drpRec = '';
                $(".drpAsset").empty();
                drpRec += '<option value=0>Select Asset</option>';
                if (data != null && data != undefined && data != undefined) {
                    $(data).each(function (data, val) {
                        drpRec += '<option value=' + val.Id + '>' + val.Name + '</option>';
                    });
                }
                $(".drpAsset").append(drpRec);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function GetAllVibrationType() {
        $("#loader").show();
        $.ajax({
            url: '/VibrationConfig/GetAllVibrationType',
            type: 'POST',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                var drpRec = '';
                $(".drpVibrationType").empty();
                drpRec += '<option value=0>Select Type</option>';
                if (data != null && data != undefined && data != undefined) {
                    $(data).each(function (data, val) {
                        drpRec += '<option value=' + val.Value + '>' + val.Text + '</option>';
                    });
                }
                $(".drpVibrationType").append(drpRec);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnSaveVibrationConfig(rowId) {
        var VibrationConfig = {};
        VibrationConfig.SiteId = $("#SiteId").val();
        VibrationConfig.AssetId = $("#drpAsset_" + rowId).val();
        VibrationConfig.VibrationTypeId = $("#drpType_" + rowId).val();
        VibrationConfig.Address = $("#txtAddress_" + rowId).val();
        VibrationConfig.Param = $("#txtParam_" + rowId).val();
        if (fnValidVibrationConfig(VibrationConfig)) {
            $("#loader").show();
            $.ajax({
                url: '/VibrationConfig/SaveVibrationConfig',
                type: 'Post',
                data: '{mVibrationConfig:' + JSON.stringify(VibrationConfig) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data.Id > 0) {
                        CommonNotification("SUCCESS", "Vibration Config has been saved.", "success");
                        GetData();
                    } else {
                        CommonNotification("ERROR", "Internal server error.", "error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }    
    }

    function fnUpdateVibrationConfig(rowId, assetId, vibrationTypeId) {
        var VibrationConfig = {};
        VibrationConfig.SiteId = $("#SiteId").val();
        VibrationConfig.AssetId = assetId;
        VibrationConfig.VibrationTypeId = vibrationTypeId;
        VibrationConfig.Address = $("#txtAddress_" + rowId).val();
        VibrationConfig.Param = $("#txtParam_" + rowId).val();
        if (fnValidVibrationConfig(VibrationConfig)) {
            $("#loader").show();
            $.ajax({
                url: '/VibrationConfig/SaveVibrationConfig',
                type: 'Post',
                data: '{mVibrationConfig:' + JSON.stringify(VibrationConfig) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data.Id > 0) {
                        CommonNotification("SUCCESS", "Vibration Config has been saved.", "success");
                        GetData();
                    } else {
                        CommonNotification("ERROR", "Internal server error.", "error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
    }

    function fnValidVibrationConfig(VibrationConfig) {
        if (VibrationConfig.SiteId == null || VibrationConfig.SiteId == undefined || VibrationConfig.SiteId == '') {
            alert("Site is required");
            return false;            
        }

        if (VibrationConfig.AssetId == null || VibrationConfig.AssetId == undefined || VibrationConfig.AssetId == '' || VibrationConfig.AssetId == '0') {
            alert("Asset is required");
            return false;
        }

        if (VibrationConfig.VibrationTypeId == null || VibrationConfig.VibrationTypeId == undefined || VibrationConfig.VibrationTypeId == '' || VibrationConfig.VibrationTypeId == '0') {
            alert("Type is required");
            return false;
        }

        if (VibrationConfig.Address == null || VibrationConfig.Address == undefined || VibrationConfig.Address == '') {
            alert("Address is required");
            return false;
        }

        if (VibrationConfig.Param == null || VibrationConfig.Param == undefined || VibrationConfig.Param == '') {
            alert("Param is required");
            return false;
        }
        return true;
    }

    function fnGetByAssetName(assetId, $this) {
        if (assetId != null && assetId != undefined && assetId != '') {
            if ($($this).hasClass("fa-plus")) {
                $($this).removeClass("fa-plus").addClass("fa-minus");
                $('.trAsset_' + assetId).show();
            }
            else {
                $($this).removeClass("fa-minus").addClass("fa-plus");
                $('.trAsset_' + assetId).hide();
            }
        }
    }

    function AddNumberVibration() {
        if ($('#SiteId').val() != null && $('#SiteId').val() != undefined && $('#SiteId').val() != '' && $('#SiteId').val() != "0") {
            var rowId = 0;

            $('#siteNumberBody tr').each(function (id, val) {
                if (parseInt($(this).attr("data-rowId")) > rowId) {
                    rowId = parseInt($(this).attr("data-rowId"));
                }
            });

            rowId = parseInt(rowId) + 1;

            var temp = '';
            temp += "<tr data-rowId=" + rowId + ">";
            temp += "<td class='text-center width60' style='vertical-align:middle'>";
            temp += "</td>";
            temp += "<td>";
            temp += "<select class='form-control drpAsset' id='drpAsset_" + rowId +"'></select>";
            temp += "</td>";
            temp += "<td>";
            temp += "<select class='form-control drpVibrationType' id='drpType_" + rowId +"'></select>";
            temp += "</td>";
            temp += "<td style='width:330px'>";
            temp += "<input type='text' placeholder='Address' class='form-control' id='txtAddress_" + rowId +"' />";
            temp += "</td>";
            temp += "<td style='width:330px'>";
            temp += "<input type='text' placeholder='Param value' class='form-control' id='txtParam_" + rowId +"' />";
            temp += "</td>";
            temp += "<td class='text-center width60'>";
            temp += "<button type='button' onclick='fnSaveVibrationConfig(" + rowId + ")' class='btn btn-success btn-quirk'>Add</button>";
            temp += "</td>";
            temp += "</tr>";
            $("#siteNumberBody").append(temp);
            GetAllAsset();
            GetAllVibrationType();
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

    function fnDelete(id) {
        if (confirm('Are you sure you want to delete this record?')) {
            $("#loader").show();
            $.ajax({
                url: '/VibrationConfig/Delete',
                type: 'POST',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            GetData();
                            CommonNotification("SUCCESS", data.result, "success");
                        }
                        else {
                            CommonNotification("ERROR", data.result, "Error");
                        }
                    } else {
                        CommonNotification("ERROR", "Something went wrong!", "Error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });

        }    
    
    }
</script>