@model List<Domain.SurveyAttribute>

<div class="modal bounceIn animated" id="modal-add-asset-attribute" tabindex="-1" aria-labelledby="modal-add-asset-attribute" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader"> Assign Attribute</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">

                <table class="table">
                    @if (ViewBag.AssetTypes != null)
                    {
                        bool isDefaultCheck = true;
                        var mAssetTypes = ViewBag.AssetTypes as List<Domain.AssetType>;

                        if (mAssetTypes != null && mAssetTypes.Count > 0)
                        {
                            if (Model.Where(x => x.IsChecked).Count() > 0)
                            {
                                isDefaultCheck = false;
                            }

                            foreach (var mAssetType in mAssetTypes)
                            {
                                var attr = Model.Where(x => x.AssetTypeId == mAssetType.Id).ToList();


                                <tr>
                                    <th>
                                        @if (mAssetType.Id == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.AXLE_COUNTER || mAssetType.Id == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.Bus_Bar || mAssetType.Id == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.UFSBI || mAssetType.Id == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.BHMS)
                                        {
                                            if (attr != null && attr.Count > 0 && attr.Where(x => x.IsChecked).Count() > 0)
                                            {
                                                <input type="checkbox" id="chkSurveyAssetType_@mAssetType.Id" checked />
                                            }
                                            else
                                            {
                                                <input type="checkbox" id="chkSurveyAssetType_@mAssetType.Id" />
                                            }

                                        }
                                        <span>@mAssetType.Name</span>

                                    </th>
                                </tr>


                                <tr>
                                    <td>
                                        <table>
                                            <tr>
                                                @if (attr != null && attr.Count > 0)
                                                {
                                                    foreach (var item in attr)
                                                    {
                                                        if (mAssetType.Id == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.Bus_Bar || mAssetType.Id == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.UFSBI || mAssetType.Id == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.BHMS)
                                                        {
                                                            <td><input type="checkbox" class="chkclsSurveyAttribute" id="chkSurveyAttribute_@item.Id" data-id="@item.Id" data-typeid="@mAssetType.Id" checked disabled /> <label for="chkSurveyAttribute_@item.Id">@item.Title</label></td>
                                                        }
                                                        else if (isDefaultCheck && item.DefaultCheck)
                                                        {
                                                            <td><input type="checkbox" class="chkclsSurveyAttribute" id="chkSurveyAttribute_@item.Id" data-id="@item.Id" data-typeid="@mAssetType.Id" checked /> <label for="chkSurveyAttribute_@item.Id">@item.Title</label></td>
                                                        }
                                                        else if (item.IsChecked)
                                                        {
                                                            <td><input type="checkbox" class="chkclsSurveyAttribute" id="chkSurveyAttribute_@item.Id" data-id="@item.Id" data-typeid="@mAssetType.Id" checked /> <label for="chkSurveyAttribute_@item.Id">@item.Title</label></td>
                                                        }
                                                        else
                                                        {
                                                            <td><input type="checkbox" class="chkclsSurveyAttribute" id="chkSurveyAttribute_@item.Id" data-id="@item.Id" data-typeid="@mAssetType.Id" /> <label for="chkSurveyAttribute_@item.Id">@item.Title</label></td>

                                                        }
                                                    }

                                                }
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            }
                        }
                    }

                </table>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="SaveSurveyInfo()">Save</button>
            </div>
        </div>
    </div>
</div>

<script>


    function SaveSurveyInfo() {

        var mSurveyInfos = [];
        $('.chkclsSurveyAttribute').each(function () {
            var isChecked = true;
            var typeId = $(this).data('typeid');

            if ($('#chkSurveyAssetType_' + typeId) != null && $('#chkSurveyAssetType_' + typeId) != undefined && $('#chkSurveyAssetType_' + typeId).length > 0) {
                if ($('#chkSurveyAssetType_' + typeId).prop('checked') == false) {
                    isChecked = false;
                }
            }
            if ($(this).prop('checked') == true && isChecked) {
                var mSiteSurvey = {};
                mSiteSurvey.SiteId = $("#hdnSiteId").val();
                mSiteSurvey.SurveyAttributeId = $(this).data('id');
                mSurveyInfos.push(mSiteSurvey);

            }
        });

        if (mSurveyInfos != null && mSurveyInfos.length > 0) {
            $("#loader").show();
            $.ajax({
                url: '/SiteSurvey/SaveSurveyInfo',
                type: 'Post',
                data: '{mSurveyInfos:' + JSON.stringify(mSurveyInfos) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data != undefined) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            $('#modal-add-asset-attribute').modal('hide');
                            $("#frmSiteSurveyList").submit();
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }

                    } else {
                        CommonNotification("ERROR", "Internal server error.", "error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
        else {
            $("#modal-add-asset-attribute").modal('hide');
            CommonNotification("ERROR", "Select any one attribute.", "Error");
        }
    }
</script>