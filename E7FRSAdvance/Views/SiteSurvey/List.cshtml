@model Domain.SiteSurveyLister


@Html.HiddenFor(m => m.SearchCriteria.ColumnName, new { id = "hdnColumnName" })
@Html.HiddenFor(m => m.SearchCriteria.SortDirection, new { id = "hdnSortDirection" })

<style>
    .width-100 {
        width: 100px;
    }
</style>

<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />

@Html.HiddenFor(x => x.SearchCriteria.SiteId)
@{
    var mSurveyAttributes = new List<Domain.SurveyAttribute>();
    if (ViewBag.SurveyAttributes != null)
    {
        mSurveyAttributes = ViewBag.SurveyAttributes as List<Domain.SurveyAttribute>;
    }
}

<div class="row">

    <div class="col-xl-10">
        <div class="table-responsive" style="max-height: 620px;">
            <table class="table table-bordered">
                <thead class="bg-primary">
                    <tr>
                        <th width="100"></th>
                        <th><a class="" onclick="fnAdd()"><i class="fa fa-plus f-16 text-white"></i> </a> Sr No.</th>
                        <th>Location Box No.</th>
                        <th>Location Side</th>
                        <th>Distance From RR</th>
                        <th>V/C</th>
                        <th class="text-center">Cluster</th>
                        <th>Conductor</th>
                        <th>TR</th>
                        <th>TF</th>
                        <th>Point Machine</th>
                        <th>Signal</th>
                        @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.AXLE_COUNTER).Count() > 0)
                        {
                            <th>Axle Counter</th>
                        }
                        @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.Bus_Bar).Count() > 0)
                        {
                            <th>Bus Bar</th>
                        }
                        @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.UFSBI).Count() > 0)
                        {
                            <th>UFSBI</th>
                        }
                        @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.BHMS).Count() > 0)
                        {
                            <th>BHMS</th>
                        }
                        <th>FTU BOX</th>
                        <th>Input Cluster Wise</th>
                        <th>CS (0-3A)</th>
                        <th>CS (0-10A)</th>
                        <th>CS (0-600MA-AC)</th>
                        <th>0-10V</th>
                        <th>(0-150V,DC)</th>
                        <th>(0-150V,AC)</th>
                        <th>(0-50V,DC)</th>
                        <th>0-1 V</th>
                        <th>0-100 V</th>
                    </tr>
                </thead>
                <tbody id="tbodySurveyList">
                    <tr class="row-add" style="display:none">
                        <td>
                            <a href="javascript:void(0)" onclick="fnSave()" class="m-r-10"><i class="fa fa-save f-18"></i></a>
                            <a href="javascript:void(0)" onclick="fnEditClose()"><i class="fa fa-close text-danger f-18"></i></a>
                        </td>
                        <td></td>
                        <td><input type="text" placeholder="Location Box No." class="form-control txtLocationBoxNo text-transform-uppercase" /></td>
                        <td><input type="text" placeholder="Location Side" class="form-control txtLocationSide text-transform-uppercase" /></td>
                        <td><input type="text" placeholder="Distance From RR" class="form-control txtDistanceFromRR" /></td>
                        <td>
                            @*<input type="text" class="form-control txtVC" placeholder="V/C" />*@
                        </td>
                        <td class="text-center">
                            <input type="number" class="form-control txtCluster" placeholder="Cluster" />
                        </td>
                        <td></td>
                        <td><textarea class="form-control width-100 txtTR text-transform-uppercase" placeholder="e.g 2T,3T"></textarea></td>
                        <td><textarea class="form-control width-100 txtTF text-transform-uppercase" placeholder="e.g 48T,40T"></textarea></td>
                        <td><textarea class="form-control width-100 txtPointMachine text-transform-uppercase" placeholder="e.g PT131,PT132"></textarea></td>
                        <td><textarea class="form-control width-100 txtSignal text-transform-uppercase" placeholder="e.g S1 RG,S1 HG"></textarea></td>
                        @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.AXLE_COUNTER).Count() > 0)
                        {
                            <td><textarea class="form-control width-100 txtAxleCounter text-transform-uppercase" placeholder="Axle Counter"></textarea></td>
                        }
                        @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.Bus_Bar).Count() > 0)
                        {
                            <td><textarea class="form-control width-100 txtBusBar text-transform-uppercase" placeholder="Bus Bar"></textarea></td>
                        }
                        @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.UFSBI).Count() > 0)
                        {
                            <td><textarea class="form-control width-100 txtUFSBI text-transform-uppercase" placeholder="UFSBI"></textarea></td>
                        }
                        @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.BHMS).Count() > 0)
                        {
                            <td><textarea class="form-control width-100 txtBHMS text-transform-uppercase" placeholder="BHMS"></textarea></td>
                        }
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>

                    </tr>
                    @if (Model.SiteSurveys != null && Model.SiteSurveys.Count > 0)
                    {
                        int srno = 0;
                        int previousCluster = 0;
                        var rowSpan = 1;

                        var clusterGroup = Model.SiteSurveys.GroupBy(x => x.Cluster).Select(x => x.Key).OrderBy(x => x).ToList();
                        foreach (var cluster in clusterGroup)
                        {
                            foreach (var item in Model.SiteSurveys.Where(x => x.Cluster == cluster))
                            {
                                srno++;
                                <tr class="row-edit-@item.Id" style="display:none">
                                    <td>
                                        <a href="javascript:void(0)" onclick="fnUpdate('@item.Id')" class="m-r-10"><i class="fa fa-save f-18"></i></a>
                                        <a href="javascript:void(0)" onclick="fnEditClose()"><i class="fa fa-close text-danger f-18"></i></a>
                                        <input type="hidden" class="txtCluster_@item.Id" value="@item.Cluster" />
                                    </td>
                                    <td>@srno</td>
                                    <td><input type="text" placeholder="Location Box No." class="form-control text-transform-uppercase txtLocationBoxNo_@item.Id" value="@item.LocationBoxNo" /></td>
                                    <td><input type="text" placeholder="Location Side" class="form-control text-transform-uppercase txtLocationSide_@item.Id" value="@item.LocationSide" /></td>
                                    <td><input type="text" placeholder="Distance From RR" class="form-control txtDistanceFromRR_@item.Id" value="@item.DistanceFromRR" /></td>
                                    <td>
                                        @*<input type="text" class="form-control txtVC_@item.Id" placeholder="V/C" value="@item.VC" />*@
                                        <label>@item.VC</label>
                                    </td>
                                    @if (item.Cluster != previousCluster)
                                    {
                                        rowSpan = Model.SiteSurveys.Where(m => m.Cluster == item.Cluster).Count();
                                        <td class="text-center" rowspan="@rowSpan">
                                            <a href="javascript:void(0)" onclick="ShowClusterStatus('@item.Cluster')">
                                                @item.Cluster
                                            </a>
                                        </td>
                                    }
                                    <td>@item.Conductor</td>
                                    <td><textarea class="form-control width-100 text-transform-uppercase txtTR_@item.Id" placeholder="e.g 2T,3T">@item.TR</textarea></td>
                                    <td><textarea class="form-control width-100 text-transform-uppercase txtTF_@item.Id" placeholder="e.g 48T,40T">@item.TF</textarea></td>
                                    <td><textarea class="form-control width-100 text-transform-uppercase txtPointMachine_@item.Id" placeholder="e.g PT131,PT132">@item.PointMachine</textarea></td>
                                    <td><textarea class="form-control width-100 text-transform-uppercase txtSignal_@item.Id" placeholder="e.g S1 RG,S1 HG">@item.Signal</textarea></td>

                                    @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.AXLE_COUNTER).Count() > 0)
                                    {
                                        <td><textarea class="form-control width-100 text-transform-uppercase txtAxleCounter_@item.Id" placeholder="Axle Counter">@item.AxleCounter</textarea></td>
                                    }

                                    @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.Bus_Bar).Count() > 0)
                                    {
                                        <td><textarea class="form-control width-100 text-transform-uppercase txtBusBar_@item.Id" placeholder="Bus Bar">@item.BusBar</textarea></td>
                                    }

                                    @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.UFSBI).Count() > 0)
                                    {
                                        <td><textarea class="form-control width-100 text-transform-uppercase txtUFSBI_@item.Id" placeholder="UFSBI">@item.UFSBI</textarea></td>
                                    }

                                    @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.BHMS).Count() > 0)
                                    {
                                        <td><textarea class="form-control width-100 text-transform-uppercase txtBHMS_@item.Id" placeholder="BHMS">@item.BHMS</textarea></td>
                                    }
                                    <td>@item.FtuBox</td>
                                    <td>@item.InputClusterWise</td>
                                    <td>@item.CS03A</td>
                                    <td>@item.CS10A</td>
                                    <td>@item.CS600A</td>
                                    <td>@item.V10</td>
                                    <td>@item.V150DC</td>
                                    <td>@item.V150AC</td>
                                    <td>@item.V50DC</td>
                                    <td>@item.V1</td>
                                    <td>@item.V100</td>
                                </tr>

                                <tr class="row-view-@item.Id">
                                    <td>
                                        <a href="javascript:void(0)" onclick="fnEdit('@item.Id')" class="m-r-10"><i class="fa fa-pencil f-16"></i></a>
                                        <a href="javascript:void(0)" onclick="fnDelete('@item.Id')"><i class="fa fa-trash text-danger f-16"></i></a>
                                    </td>
                                    <td>@srno</td>
                                    <td>@item.LocationBoxNo</td>
                                    <td>@item.LocationSide</td>
                                    <td>@item.DistanceFromRR</td>
                                    <td class="text-center">@item.VC</td>
                                    @if (item.Cluster != previousCluster)
                                    {
                                        rowSpan = Model.SiteSurveys.Where(m => m.Cluster == item.Cluster).Count();
                                        <td class="text-center" rowspan="@rowSpan">
                                            <a href="javascript:void(0)" onclick="ShowClusterStatus('@item.Cluster')">
                                                @item.Cluster
                                            </a>
                                        </td>
                                    }

                                    <td class="text-center">@item.Conductor</td>
                                    <td>@item.TR</td>
                                    <td>@item.TF</td>
                                    <td>@item.PointMachine</td>
                                    <td>@item.Signal</td>
                                    @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.AXLE_COUNTER).Count() > 0)
                                    {
                                        <td>@item.AxleCounter</td>
                                    }
                                    @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.Bus_Bar).Count() > 0)
                                    {
                                        <td>@item.BusBar</td>
                                    }

                                    @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.UFSBI).Count() > 0)
                                    {
                                        <td>@item.UFSBI</td>
                                    }
                                    @if (mSurveyAttributes != null && mSurveyAttributes.Where(x => x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.SiteSurveyAssetType.BHMS).Count() > 0)
                                    {
                                        <td>@item.BHMS</td>
                                    }
                                    <td>@item.FtuBox</td>
                                    <td>@item.InputClusterWise</td>
                                    <td class="text-center">@item.CS03A</td>
                                    <td class="text-center">@item.CS10A</td>
                                    <td class="text-center">@item.CS600A</td>
                                    <td class="text-center">@item.V10</td>
                                    <td class="text-center">@item.V150DC</td>
                                    <td class="text-center">@item.V150AC</td>
                                    <td class="text-center">@item.V50DC</td>
                                    <td class="text-center">@item.V1</td>
                                    <td class="text-center">@item.V100</td>
                                </tr>
                                { previousCluster = item.Cluster; }

                            }
                        }


                    }

                </tbody>
            </table>
        </div>
    </div>

    @*<div class="col-xl-8 mt-4"></div>*@
    <div class="col-xl-2">
        <table class="table table-bordered">
            <thead class="bg-primary">
                <tr>
                    <th>Cluster Status</th>
                    <th>Count</th>
                </tr>
            </thead>
            @if (Model.mSiteSurveyClusterStatus != null && Model.mSiteSurveyClusterStatus.Count > 0)
            {
                <tbody>
                    @foreach (var item in Model.mSiteSurveyClusterStatus)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Text</td>

                        </tr>
                    }
                </tbody>
            }

        </table>
    </div>
</div>

<script>
    var assetNameRegex = /^[a-zA-Z0-9-/-_ ]+$/;
    function fnAdd() {
        $('.row-add').show();
    }

    function fnEdit(id) {

        $('.row-edit-' + id).show();
        $('.row-view-' + id).hide();

    }

    function fnAdd() {
        $('.row-add').show();
    }

    function fnSave() {
        var mSiteSurvey = {};
        mSiteSurvey.SiteId = $("#hdnSiteId").val();
        mSiteSurvey.LocationBoxNo = $.trim($(".txtLocationBoxNo").val()).toUpperCase();
        mSiteSurvey.LocationSide = $.trim($(".txtLocationSide").val()).toUpperCase();
        mSiteSurvey.DistanceFromRR = $.trim($(".txtDistanceFromRR").val());
        mSiteSurvey.VC = $.trim($(".txtVC").val());
        mSiteSurvey.Cluster = $.trim($(".txtCluster").val());
        mSiteSurvey.TR = $.trim($(".txtTR").val()).toUpperCase();
        mSiteSurvey.TF = $.trim($(".txtTF").val()).toUpperCase();
        mSiteSurvey.PointMachine = $.trim($(".txtPointMachine").val()).toUpperCase();
        mSiteSurvey.Signal = $.trim($(".txtSignal").val()).toUpperCase();
        mSiteSurvey.AxleCounter = $.trim($(".txtAxleCounter").val()).toUpperCase();
        mSiteSurvey.BusBar = $.trim($(".txtBusBar").val()).toUpperCase();
        mSiteSurvey.UFSBI = $.trim($(".txtUFSBI").val()).toUpperCase();
        mSiteSurvey.BHMS = $.trim($(".txtBHMS").val()).toUpperCase();

        if (fnValid(mSiteSurvey)) {
            $("#loader").show();
            $.ajax({
                url: '/SiteSurvey/Save',
                type: 'Post',
                data: '{mSiteSurvey:' + JSON.stringify(mSiteSurvey) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data != undefined) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            $("#frmSiteSurveyList").submit();
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }

                    } else {
                        CommonNotification("ERROR", "Internal server error.", "error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
    }
    function fnEditClose() {
        $("#frmSiteSurveyList").submit();
    }

    function fnUpdate(id) {
        var mSiteSurvey = {};
        mSiteSurvey.Id = id;
        mSiteSurvey.SiteId = $("#hdnSiteId").val();
        mSiteSurvey.LocationBoxNo = $.trim($(".txtLocationBoxNo_" + id).val()).toUpperCase();
        mSiteSurvey.LocationSide = $.trim($(".txtLocationSide_" + id).val()).toUpperCase();
        mSiteSurvey.DistanceFromRR = $.trim($(".txtDistanceFromRR_" + id).val());
        mSiteSurvey.VC = $.trim($(".txtVC_" + id).val());
        mSiteSurvey.Cluster = $.trim($(".txtCluster_" + id).val());
        mSiteSurvey.TR = $.trim($(".txtTR_" + id).val()).toUpperCase();
        mSiteSurvey.TF = $.trim($(".txtTF_" + id).val()).toUpperCase();
        mSiteSurvey.PointMachine = $.trim($(".txtPointMachine_" + id).val()).toUpperCase();
        mSiteSurvey.Signal = $.trim($(".txtSignal_" + id).val()).toUpperCase();;
        mSiteSurvey.AxleCounter = $.trim($(".txtAxleCounter_" + id).val()).toUpperCase();
        mSiteSurvey.BusBar = $.trim($(".txtBusBar_" + id).val()).toUpperCase();
        mSiteSurvey.UFSBI = $.trim($(".txtUFSBI_" + id).val()).toUpperCase();
        mSiteSurvey.BHMS = $.trim($(".txtBHMS_" + id).val()).toUpperCase();

        if (fnValidUpdate(mSiteSurvey)) {
            $("#loader").show();
            $.ajax({
                url: '/SiteSurvey/Save',
                type: 'Post',
                data: '{mSiteSurvey:' + JSON.stringify(mSiteSurvey) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data != undefined) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            $("#frmSiteSurveyList").submit();
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }

                    } else {
                        CommonNotification("ERROR", "Internal server error.", "error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
    }

    function fnValid(mSiteSurvey) {

        if (mSiteSurvey.SiteId == null || mSiteSurvey.SiteId == undefined || mSiteSurvey.SiteId == '') {
            alert("Site is required");
            return false;
        }

        if (mSiteSurvey.LocationBoxNo == null || mSiteSurvey.LocationBoxNo == undefined || mSiteSurvey.LocationBoxNo == '') {
            alert("Location Box No is required");
            return false;
        }

        if (mSiteSurvey.LocationSide == null || mSiteSurvey.LocationSide == undefined || mSiteSurvey.LocationSide == '') {
            alert("Location Side is required");
            return false;
        }

        if (mSiteSurvey.DistanceFromRR == null || mSiteSurvey.DistanceFromRR == undefined || mSiteSurvey.DistanceFromRR == '') {
            alert("Distance From RR is required");
            return false;
        }

        if (mSiteSurvey.Cluster == null || mSiteSurvey.Cluster == undefined || mSiteSurvey.Cluster == '') {
            alert("Cluster is required");
            return false;
        }
        else if (mSiteSurvey.Cluster != null && (parseInt(mSiteSurvey.Cluster) <= 0 || parseInt(mSiteSurvey.Cluster) > 100)) {
            alert("Cluster is not in range");
            return false;
        }

        return true;
    }

    function fnValidUpdate(mSiteSurvey) {

        if (mSiteSurvey.SiteId == null || mSiteSurvey.SiteId == undefined || mSiteSurvey.SiteId == '') {
            alert("Site is required");
            return false;
        }

        if (mSiteSurvey.LocationBoxNo == null || mSiteSurvey.LocationBoxNo == undefined || mSiteSurvey.LocationBoxNo == '') {
            alert("Location Box No is required");
            return false;
        }

        if (mSiteSurvey.LocationSide == null || mSiteSurvey.LocationSide == undefined || mSiteSurvey.LocationSide == '') {
            alert("Location Side is required");
            return false;
        }

        if (mSiteSurvey.DistanceFromRR == null || mSiteSurvey.DistanceFromRR == undefined || mSiteSurvey.DistanceFromRR == '') {
            alert("Distance From RR is required");
            return false;
        }

        return true;
    }

    function fnDelete(id) {
        if (confirm('Are you sure you want to delete this record?')) {
            $("#loader").show();
            $.ajax({
                url: '/SiteSurvey/Delete',
                type: 'Post',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data.type == 'success') {
                        CommonNotification("SUCCESS", data.result, "success");
                        $("#frmSiteSurveyList").submit();
                    } else {
                        CommonNotification("ERROR", "Internal server error.", "error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
    }

    function IsValidAsset() {
        if (!assetNameRegex.test($.trim($("#txtName").val()))) {
            $('#txtName').next('span').html('Invalid asset Name!');
            result = false;
        }
        else {
            $("#txtName").next("span").html("");
        }
    }

    function ShowPointPartial(siteId) {
        $("#loader").show();
        $.ajax({
            url: '/SiteSurvey/_PointPartial',
            type: 'Post',
            data: '{siteId:' + siteId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $('#divPointPartial').empty().append(data);
                $('#modal-add-point-asset').modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function ShowFinalize(siteId) {
        $("#loader").show();
        $.ajax({
            url: '/SiteSurvey/_Finalize',
            type: 'Post',
            data: '{siteId:' + siteId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $('#divFinalizePartial').empty().append(data);
                $('#modal-add-finalize-asset').modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function ShowAssetAttribute(siteId) {
        $("#loader").show();
        $.ajax({
            url: '/SiteSurvey/_AssetAttribute',
            type: 'Post',
            data: '{siteId:' + siteId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $('#divAssetAttributePartial').empty().append(data);
                $('#modal-add-asset-attribute').modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function ShowClusterStatus(cluster) {
        $("#loader").show();
        $.ajax({
            url: '/SiteSurvey/_ClusterStatus',
            type: 'Post',
            data: '{siteId:' + $('#hdnSiteId').val() + ',cluster:' + cluster + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $('#divClusterStatusPartial').empty().append(data);
                $('#modal-add-cluster-status').modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }
</script>
