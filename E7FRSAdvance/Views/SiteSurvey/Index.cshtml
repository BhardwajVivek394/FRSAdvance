@model Domain.SiteSurveyLister
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">Site Survey<a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">@Model.SearchCriteria.SiteName </li>
                </ol>
            </div>
        </div>
    </div>
</div>
<input type="hidden" id="hdnSiteId" value="@Model.SearchCriteria.SiteId" />
<div class="row">
    <div class="card">
        <div class="card-header">
            <div class="pull-left">
                <button class="btn btn-primary" type="button" onclick="ShowPointPartial('@Model.SearchCriteria.SiteId')">Point</button>
            </div>
            <div class="pull-left m-l-10">
                <button class="btn btn-primary" type="button" onclick="ShowAssetAttribute('@Model.SearchCriteria.SiteId')">Asset & Attribute</button>
            </div>
            <div class="pull-left m-l-10">
                <button class="btn btn-primary" type="button" onclick="ShowFinalize('@Model.SearchCriteria.SiteId')">Finalize</button>
            </div>
            <div class="pull-right">
                <span>Start Date</span>
                <input type="text" class="form-control" />
            </div>
        </div>
        <div class="card-body">
            @using (Ajax.BeginForm("List", "SiteSurvey", new AjaxOptions()
            {
                HttpMethod = "POST",
                UpdateTargetId = "divSiteSurveyList",
                InsertionMode = InsertionMode.Replace,
                LoadingElementId = "loader"
            }, new { id = "frmSiteSurveyList" }))
            {
                { HtmlHelper.ClientValidationEnabled = false; }
                <div id="divSiteSurveyList">
                    @Html.Action("List", Model)
                </div>
            }


            @using (Ajax.BeginForm("_PointPartial", "SiteSurvey", new AjaxOptions()
            {
                HttpMethod = "POST",
                UpdateTargetId = "divPointPartial",
                InsertionMode = InsertionMode.Replace,
                LoadingElementId = "loader"
            }, new { id = "frmPointPartialList" }))
            {
                <div id="divPointPartial">
                    @Html.Partial("_PointPartial", new List<Domain.SiteSurvey>())
                </div>
            }


            @using (Ajax.BeginForm("_Finalize", "SiteSurvey", new AjaxOptions()
            {
                HttpMethod = "POST",
                UpdateTargetId = "divFinalizePartial",
                InsertionMode = InsertionMode.Replace,
                LoadingElementId = "loader"
            }, new { id = "frmFinalizeList" }))
            {
                <div id="divFinalizePartial">
                    @*@Html.Partial("_Finalize", new List<Domain.SiteSurvey>())*@
                </div>
            }

            <div id="divAssetAttributePartial">
                @*@Html.Partial("_Finalize", new List<Domain.SiteSurvey>())*@
            </div>

            <div id="divClusterStatusPartial">
                @*@Html.Partial("_Finalize", new List<Domain.SiteSurvey>())*@
            </div>
        </div>
    </div>

</div>

