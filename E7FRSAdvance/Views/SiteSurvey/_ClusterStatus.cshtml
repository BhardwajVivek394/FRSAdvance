@model List<Domain.SiteSurveyClusterStatus>

<div class="modal bounceIn animated" id="modal-add-cluster-status" tabindex="-1" aria-labelledby="modal-add-cluster-status" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span>Set Cluster Status</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <input type="hidden" id="hdnClusterId" value="@ViewBag.Cluster" />
                <table>
                    <tbody id="tbodyclusterstatus">
                        @if (Model != null)
                        {
                            foreach (var siteSurveyClusterStatus in Model)
                            {

                                <tr>
                                    <td>
                                        @if (siteSurveyClusterStatus.IsChecked)
                                        {
                                            if (siteSurveyClusterStatus.StatusTypeId == (int)E7FRSAdvance.Utility.Utility.SurveyClusterStatus.Termination)
                                            {
                                                <input type="checkbox" class="clsClusterstatus" id="chk@(siteSurveyClusterStatus.StatusTypeId)" value="@(siteSurveyClusterStatus.StatusTypeId)" checked disabled />
                                            }
                                            else
                                            {
                                                <input type="checkbox" class="clsClusterstatus" id="chk@(siteSurveyClusterStatus.StatusTypeId)" value="@(siteSurveyClusterStatus.StatusTypeId)" checked />

                                            }
                                        }
                                        else
                                        {
                                            if (siteSurveyClusterStatus.StatusTypeId == (int)E7FRSAdvance.Utility.Utility.SurveyClusterStatus.Termination)
                                            {
                                                <input type="checkbox" class="clsClusterstatus" id="chk@(siteSurveyClusterStatus.StatusTypeId)" value="@(siteSurveyClusterStatus.StatusTypeId)" disabled />
                                            }
                                            else
                                            {
                                                <input type="checkbox" class="clsClusterstatus" id="chk@(siteSurveyClusterStatus.StatusTypeId)" value="@(siteSurveyClusterStatus.StatusTypeId)" />
                                            }
                                        }
                                        <label for="chk@(siteSurveyClusterStatus.StatusTypeId)">@(siteSurveyClusterStatus.Name)</label>
                                    </td>
                                </tr>

                                if (siteSurveyClusterStatus.StatusTypeId == (int)E7FRSAdvance.Utility.Utility.SurveyClusterStatus.Termination)
                                {
                                    <tr>
                                        <td>
                                            <div class="card panel-inverse">

                                                <div class="card-body">
                                                    <div class="row">
                                                        @if (ViewBag.TrackCount != null)
                                                        {
                                                            <div class="col-lg-12">
                                                                <div class="row">
                                                                    <div class="col-2">
                                                                        <label>Track</label>
                                                                    </div>
                                                                    <div class="col-4">
                                                                        <input type="number" class="form-control" id="txtTerminationTrackCount" value="@siteSurveyClusterStatus.TerminationTrackCount" />
                                                                    </div>
                                                                    <div class="col-1">
                                                                        <h5 class="mt-2">/</h5>
                                                                    </div>
                                                                    <div class="col-5">
                                                                        <h5 class="mt-2" id="lblTerminationTrackCount">@ViewBag.TrackCount</h5>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }

                                                        @if (ViewBag.SignalCount != null)
                                                        {
                                                            <div class="col-lg-12 mt-2">
                                                                <div class="row">
                                                                    <div class="col-2">
                                                                        <label>Signal</label>
                                                                    </div>
                                                                    <div class="col-4">
                                                                        <input type="number" class="form-control" id="txtTerminationSignalCount" value="@siteSurveyClusterStatus.TerminationSignalCount" />
                                                                    </div>
                                                                    <div class="col-1">
                                                                        <h5 class="mt-2">/</h5>
                                                                    </div>
                                                                    <div class="col-5">
                                                                        <h5 class="mt-2" id="lblTerminationSignalCount">@ViewBag.SignalCount</h5>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }

                                                        @if (ViewBag.PointCount != null)
                                                        {
                                                            <div class="col-lg-12 mt-2">
                                                                <div class="row">
                                                                    <div class="col-2">
                                                                        <label>Point</label>
                                                                    </div>
                                                                    <div class="col-4">
                                                                        <input type="number" class="form-control" id="txtTerminationPointCount" value="@siteSurveyClusterStatus.TerminationPointCount" />
                                                                    </div>
                                                                    <div class="col-1">
                                                                        <h5 class="mt-2">/</h5>
                                                                    </div>
                                                                    <div class="col-5">
                                                                        <h5 class="mt-2" id="lblTerminationPointCount">@ViewBag.PointCount</h5>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }

                                                    </div>
                                                </div>
                                            </div>



                                        </td>
                                    </tr>
                                }
                            }

                        }
                    </tbody>

                </table>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSaveClusterStatus()">Save</button>
                <a class="btn btn-default" data-bs-dismiss="modal">Close</a>

            </div>
        </div>
    </div>
</div>

<script>

    var termination = '@E7FRSAdvance.Utility.Utility.SurveyClusterStatus.Termination.GetHashCode()';
    function fnSaveClusterStatus() {
        var isValid = true;
        var mSiteSurveyClusterStatus = [];
        $(".clsClusterstatus").each(function () {
            var mClusterStatus = {};
            mClusterStatus.SiteId = $('#hdnSiteId').val();
            mClusterStatus.Cluster = $('#hdnClusterId').val();
            if ($(this).is(":checked")) {
                mClusterStatus.StatusTypeId = $(this).val();
                mClusterStatus.IsChecked = true;
            } else {
                mClusterStatus.StatusTypeId = $(this).val();
                mClusterStatus.IsChecked = false;
            }

            if (mClusterStatus.StatusTypeId == termination) {
                var isAllSetTermination = false;
                if (parseInt($('#lblTerminationTrackCount').html()) > 0) {
                    isAllSetTermination = false;
                    if (parseInt($('#txtTerminationTrackCount').val()) > 0) {
                        if (parseInt($('#lblTerminationTrackCount').html()) > parseInt($('#txtTerminationTrackCount').val())) {
                            mClusterStatus.TerminationTrackCount = $('#txtTerminationTrackCount').val();
                        }
                        else if (parseInt($('#lblTerminationTrackCount').html()) == parseInt($('#txtTerminationTrackCount').val())) {
                            isAllSetTermination = true;
                            mClusterStatus.TerminationTrackCount = $('#txtTerminationTrackCount').val();
                        }
                        else {
                            isValid = false;
                            alert('Track termination is larger then track count.');
                        }
                    }
                   
                }

                if (parseInt($('#lblTerminationPointCount').html()) > 0) {
                    isAllSetTermination = false;
                    if (parseInt($('#txtTerminationPointCount').val()) > 0) {
                        if (parseInt($('#lblTerminationPointCount').html()) > parseInt($('#txtTerminationPointCount').val())) {
                            mClusterStatus.TerminationPointCount = $('#txtTerminationPointCount').val();
                        }
                        else if (parseInt($('#lblTerminationPointCount').html()) == parseInt($('#txtTerminationPointCount').val())) {
                            isAllSetTermination = true;
                            mClusterStatus.TerminationPointCount = $('#txtTerminationPointCount').val();
                        }
                        else {
                            isValid = false;
                            alert('Point termination is larger then point count.');
                        }
                    }
                  
                }

                if (parseInt($('#lblTerminationSignalCount').html()) > 0) {
                    isAllSetTermination = false;
                    if (parseInt($('#txtTerminationSignalCount').val()) > 0) {
                        if (parseInt($('#lblTerminationSignalCount').html()) > parseInt($('#txtTerminationSignalCount').val())) {
                            mClusterStatus.TerminationSignalCount = $('#txtTerminationSignalCount').val();
                        }
                        else if (parseInt($('#lblTerminationSignalCount').html()) == parseInt($('#txtTerminationSignalCount').val())) {
                            isAllSetTermination = true;
                            mClusterStatus.TerminationSignalCount = $('#txtTerminationSignalCount').val();
                        }
                        else {
                            isValid = false;
                            alert('Signal termination is larger then signal count.');
                        }
                    }
                  
                }

                if (isAllSetTermination) {
                    mClusterStatus.IsChecked = true;
                } else {
                    mClusterStatus.IsChecked = false;
                }
            }

            mSiteSurveyClusterStatus.push(mClusterStatus);
        });
        if (mSiteSurveyClusterStatus != null && mSiteSurveyClusterStatus != undefined && mSiteSurveyClusterStatus.length > 0 && isValid) {
            $("#loader").show();
            $.ajax({
                url: '/SiteSurvey/SaveClusterStatus',
                type: 'Post',
                data: '{mSiteSurveyClusterStatus:' + JSON.stringify(mSiteSurveyClusterStatus) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data != undefined) {
                        if (data.type == "success") {
                            $('#modal-add-cluster-status').modal('hide');
                            CommonNotification("SUCCESS", data.result, "success");
                            $("#frmSiteSurveyList").submit();
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }

                    } else {
                        CommonNotification("ERROR", "Internal server error.", "error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            $("#modal-add-point-asset").modal('hide');

        }

    }
</script>