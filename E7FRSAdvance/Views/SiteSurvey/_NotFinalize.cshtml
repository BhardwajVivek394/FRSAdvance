@model Domain.SiteSurveyLister

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-finalize-asset" tabindex="-1" aria-labelledby="modal-add-finalize-asset" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader"> Not Matched Assets</span></h4>

            </div>

            <div class="modal-body">
                @{
                    var trAssets = ViewBag.TRAssets as List<string>;
                    var tfAssets = ViewBag.TFAssets as List<string>;
                }
                <div class="row">
                    <div class="col-lg-6">
                        <table class="table">
                            <tr>
                                <th>TR Not Matched</th>
                            </tr>
                            @if (trAssets != null && trAssets.Count > 0)
                            {
                                foreach (var item in trAssets)
                                {
                                    <tr>
                                        <td>@item</td>
                                    </tr>
                                }

                            }

                        </table>
                    </div>
                    <div class="col-lg-6">
                        <table class="table">
                            <tr>
                                <th>TF Not Matched</th>
                            </tr>
                            @if (tfAssets != null && tfAssets.Count > 0)
                            {
                                foreach (var item in tfAssets)
                                {
                                    <tr>
                                        <td>@item</td>
                                    </tr>
                                }

                            }

                        </table>
                    </div>
                </div>
           
       
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal">Close</a>
            </div>
        </div>
    </div>
</div>


