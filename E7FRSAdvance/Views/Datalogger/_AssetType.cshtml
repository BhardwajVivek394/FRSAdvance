@model List<Domain.DataloggerAssetType>

@if (Model != null && Model.Count > 0)
{

    foreach (var item in Model)
    {
        <div class="btn-group mr5" style="margin:5px">
            <button type="button" onclick="fnBindDatalogger('@item.Id')" class="btn btn-dark">@item.Name</button>
        </div>
    }
}
