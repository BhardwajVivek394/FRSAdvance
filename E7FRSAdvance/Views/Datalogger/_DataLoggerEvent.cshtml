@model List<Domain.Datalogger>

<style>
   


    .clockpicker-popover {
        position: absolute;
        z-index: 1050;
    }
</style>
<div class="modal bounceIn animated" id="modalDataloggerLogs" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel">
                    @if (ViewBag.AssetName != null)
                    {
                        <span id="spHeader">Deadband - @ViewBag.AssetName</span>
                    }
                    else
                    {
                        <span id="spHeader">Deadband</span>
                    }
                </h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">
                    <div class="col-lg-2">
                        <input id="tpDataloggerSearchDate" type="text" class="form-control" />

                    </div>
                    <div class="col-lg-2">
                        <input id="tpDataloggerFrom" type="text" class="form-control" placeholder="From Time" />

                    </div>
                    <div class="col-lg-2">
                        <input id="tpDataloggerTo" type="text" class="form-control" placeholder="To Time" />
                    </div>
                    <div class="col-lg-4">
                        @*<input type="text" class="form-control" id="txtSearchSRNo" placeholder="Sr no" />*@
                        <label>Search SR No and Asset</label>
                        <a href="javascript:void(0)" class="btn btn-success" onclick="fnAddSRNo()"><i class="fa fa-plus"></i></a>
                    </div>
                    <div class="col-sm-2">
                        <a class="btn btn-info" onclick="fnGetSearchEventLog()" href="javascript:void(0)"><i class="fa fa-search"></i></a>
                        <a class="btn btn-success" href="@Url.Action("Downloadcsv", new {siteId=ViewBag.siteId})"><i class="fa fa-download"></i></a>
                    </div>
                    <div class="col-sm-12" id="deadbandDataByDate">
                        @Html.Partial("_EventGraphDeadband", Model)


                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>



<script>
    $("#searchJsonViewText").on("keyup", function () {
        var value = $(this).val().toLowerCase();
        $("#tbodyJsonView tr").filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
    });



    $(document).ready(function () {

        $('#tpDataloggerFrom').clockpicker({
            placement: 'bottom',
            align: 'right',
            autoclose: true,
            'default': '00:00'
        });

        $('#tpDataloggerTo').clockpicker({
            placement: 'bottom',
            align: 'right',
            autoclose: true,
            'default': '00:00'
        });

        $('#tpDataloggerSearchDate').datepicker({
            dateFormat: 'd/m/yy',
            autoClose: true
        }).datepicker("setDate", new Date());
    });
</script>
