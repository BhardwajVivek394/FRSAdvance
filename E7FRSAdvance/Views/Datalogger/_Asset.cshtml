@model Domain.DataloggerAsset

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-asset" tabindex="-1" aria-labelledby="modal-add-asset" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content bradius4">

            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Asset</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Edit Asset</span></h4>
                }
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true">×</button>

            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="">
                                <label class="control-label">Name <span class="text-danger">*</span></label>
                                <div class="mb-3">
                                    @Html.TextBoxFor(m => Model.Name, new { @class = "form-control", tabindex = 2 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12">

                            @if (Model.mDataloggerAttributes != null && Model.mDataloggerAttributes.Count > 0)
                            {
                                <table class="table">
                                    <tr>
                                        <th>Title</th>
                                        <th>SrNo</th>
                                        <th>ContactType</th>
                                    </tr>
                                    @foreach (var mDataloggerAttribute in Model.mDataloggerAttributes)
                                    {
                                        <tr>
                                            <td>@mDataloggerAttribute.Title</td>
                                            <td>@mDataloggerAttribute.SrNo</td>
                                            <td>@mDataloggerAttribute.ContactType</td>
                                        </tr>
                                    }
                                </table>

                            }


                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        if ($('#hdnSaveType').val() == 'Success') {

            CommonNotification($("#hdnSaveType").val().toUpperCase(), $("#hdnSaveMessage").val(), $("#hdnSaveType").val());

            $("[class*='modal-backdrop']").remove();
            $("#frmGetDataloggerAssetTypeList").submit();
            window.history.pushState('', '', "Index");
        }
        else if ($('#hdnSaveType').val() == 'Error') {
            CommonNotification($("#hdnSaveType").val().toUpperCase(), $("#hdnSaveMessage").val(), $("#hdnSaveType").val());

            $("[class*='modal-backdrop']").remove();
            window.history.pushState('', '', "Index");
        }
    });

    function fnSave() {
        if (Validate()) {
            $("#frmSaveDataloggerAssetType").submit();
        }
    }

    function Validate() {
        var result = true;

        if ($.trim($("#Name").val()).length == 0) {
            $("#Name").next("span").html("Name is required");
            result = false;
        }
        else {
            $("#Name").next("span").html("");
        }

        return result;
    }
</script>
