@model List<Domain.DataloggerAsset>


<div>
    <table class="table">
        <thead>
            <tr>
                <th></th>
                <th>SrNo</th>
                <th>Relay Name</th>
                <th>Contact Type</th>
            </tr>
        </thead>
        <tbody id="tblImportRecord">
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    if (item.SrNo > 0)
                    {
                        <tr>
                            <td></td>
                            <td>@item.SrNo</td>
                            <td>@item.RelayName</td>
                            <td>@item.ContactType</td>
                            <td>
                                @item.AssetTypeName
                            </td>
                            
                        </tr>

                     
                    }



                }


            }

        </tbody>

    </table>
</div>



   
