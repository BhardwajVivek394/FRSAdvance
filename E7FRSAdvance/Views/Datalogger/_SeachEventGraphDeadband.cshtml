
<style>
    .ui-autocomplete {
        position: absolute;
        z-index: 1060;
        max-height: 200px;
        overflow-y: auto;
        overflow-x: hidden;
        left: 50.5%;
        top: 20%;
        transform: translateX(-50.5% -20%);
    }
</style>

<div class="modal bounceIn animated" id="modelSearchDataLogger" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modalConfirm-dialog modal-lg">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader">Search</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">
                    <div class="col-lg-6">
                        <div class="row">
                            <div class="col-lg-12">
                                <label>Search SR No.</label>
                            </div>
                            <div class="col-lg-10">
                                <input type="number" class="form-control" id="txtSearchSRNo" />
                            </div>
                            <div class="col-lg-2">
                                <button type="button" class="btn btn-success" onclick="fnAddSearch('txtSearchSRNo','tbodySearchSRNo')"><i class="fa fa-plus"></i></button>
                            </div>
                            <div class="col-lg-12">
                                <table class="table">
                                    <tbody id="tbodySearchSRNo">
                                        @if (ViewBag.SrNumbers != null)
                                        {
                                            foreach (var srNumber in ViewBag.SrNumbers)
                                            {
                                                <tr>
                                                    <td>@srNumber</td>
                                                    <td><button type="button" onclick="fnRemoveSearch(this)" class="btn btn-success"><i class="fa fa-minus"></i></button></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="row">
                            <div class="col-lg-12">
                                <label>Search Asset Name</label>
                            </div>
                            <div class="col-lg-10">
                                <input type="text" class="form-control" id="txtSearchAssetName" />
                            </div>
                            <div class="col-lg-2">
                                <button type="button" class="btn btn-success" onclick="fnAddSearch('txtSearchAssetName','tbodySearchAssetName')"><i class="fa fa-plus"></i></button>
                            </div>
                            <div class="col-lg-12">
                                <table class="table">
                                    <tbody id="tbodySearchAssetName">
                                        @if (ViewBag.RelayNames != null)
                                        {
                                            foreach (var relayName in ViewBag.RelayNames)
                                            {
                                                <tr>
                                                    <td>@relayName</td>
                                                    <td><button type="button" onclick="fnRemoveSearch(this)" class="btn btn-success"><i class="fa fa-minus"></i></button></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>


                    @*<div class="col-lg-6">
                            <div class="row">
                                <div class="col-lg-12">
                                    <label></label>
                                </div>
                                <div class="col-lg-12">
                                    <input type="text" class="form-control" />
                                </div>
                                <div class="col-lg-12">
                                    <table></table>
                                </div>
                            </div>
                        </div>*@
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" onclick="fnGetSearchEventLog()">Search</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () { 
        $("#txtSearchAssetName").autocomplete({
            source: function (request, response) {
                var siteId = $('#SiteId').val();
                var searchCriteria = {};

                searchCriteria.SiteId = siteId;
                searchCriteria.Type = $("#txtSearchAssetName").val();

                if (siteId != null && siteId != undefined && siteId != '' && siteId != '0') {
                    // $("#loader").show();
                    $.ajax({
                        url: '/Datalogger/SearchEvent',
                        type: 'Post',
                        data: JSON.stringify(searchCriteria),
                        contentType: "application/json; charset=utf-8",
                        dataFilter: function (data) { debugger; return data; },
                        success: function (data) {
                            response($.map(data, function (item) {
                                return {
                                    value: item.RelayName
                                }
                            }))
                        },
                        error: function (response) {
                            CommonNotification("error", "Something went wrong!");
                        }
                    });
                }


            },
            minLength: 2 //This is the Char length of inputTextBox    
        });       
    });

</script>

