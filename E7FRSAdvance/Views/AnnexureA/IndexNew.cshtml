        font-size: .775rem;
    }


    .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
        color: #fff;
        background-color: #00a4e0;
        border: none;
    }


    .nav-link {
        color: #00a4e0;
        background-color: white;
        border: none;
    }

        .nav-link:focus, .nav-link:hover {
            color: #0a58ca;
        }


    /* Small devices (landscape phones, 576px and up) */
    @@media (min-width: 576px) {
        .card-header-bg h1 {
            font-size: 1.2rem;
        }

        .four-box span {
            font-size: 12px;
        }
    }

    /* Medium devices (tablets, 768px and up) */
    @@media (min-width: 768px) {
        .four-box span {
            font-size: 14px;
        }

        .btn-group-sm > .btn,
        .btn-sm {
            font-size: .875rem;
        }
    }


    /* It's supposed to look like a tree diagram */
    .tree, .tree ul, .tree li {
        list-style: none;
        margin: 0;
        padding: 0;
        position: relative;
        font-size: 14px;
    }

    .tree {
        margin: 0 0 1em;
        text-align: center;
    }

        .tree, .tree ul {
            display: table;
        }

            .tree ul {
                width: 100%;
            }

            .tree li {
                display: table-cell;
                padding: .5em 0;
                vertical-align: top;
            }
                /* _________ */
                .tree li:before {
                    outline: solid 1px #666;
                    content: "";
                    left: 0;
                    position: absolute;
                    right: 0;
                    top: 0;
                }

                .tree li:first-child:before {
                    left: 50%;
                }

                .tree li:last-child:before {
                    right: 50%;
                }

            .tree code, .tree span {
                border: solid .1em #666;
                border-radius: .2em;
                display: inline-block;
                margin: 0 .2em .5em;
                padding: .2em .5em;
                position: relative;
                background: #fff9f1;
                z-index: 1;
            }
            /* If the tree represents DOM structure */
            .tree code {
                font-family: monaco, Consolas, 'Lucida Console', monospace;
            }

                /* | */
                .tree ul:before,
                .tree code:before,
                .tree span:before {
                    outline: solid 1px #666;
                    content: "";
                    height: .5em;
                    left: 50%;
                    position: absolute;
                }

            .tree ul:before {
                top: -.5em;
            }

            .tree code:before,
            .tree span:before {
                top: -.55em;
            }

            /* The root node doesn't connect upwards */
            .tree > li {
                margin-top: 0;
            }

                .tree > li:before,
                .tree > li:after,
                .tree > li > code:before,
                .tree > li > span:before {
                    outline: none;
                }

    .ulmtop {
        margin-top: -8px !important;
    }

    .linetopul:before {
        outline: none !important;
    }

    .expand-btn {
        cursor: pointer;
        transition: transform 0.3s;
    }

    .nested-table {
        background: #f8f9fa;
        border-radius: 6px;
    }

    /* ✅ Smooth animation for dropdown rows */
    .collapse-row {
        display: none;
        overflow: hidden;
    }

        .collapse-row.show {
            display: table-row;
            animation: slideDown 0.35s ease forwards;
        }

        .collapse-row.hiding {
            animation: slideUp 0.35s ease forwards;
        }

    .td-w {
        width: 50px;
    }
</style>

