    function fnAssetPartial() {

        var siteId = $("#stationId option:selected").attr('data-siteid');
        if (siteId != null && siteId != undefined) {
            $("#loader").show();
            $.ajax({
                url: '/AnnexureA/_AssetPartial',
                type: 'Post',
                data: '{siteId:' + siteId + '}',
                dataType: 'html',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#divTabAsset").empty().append(data);
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }


    }
