        if ($('#stationId').val() != null && $('#stationId').val() != undefined && $('#stationId').val() != '' && $('#stationId').val() != '0') {
            window.location.href = "@Url.Action("DownloadJson")?siteId=" + $('#stationId').find(":selected").data("siteid") + "&" + "sgid=" + stgwi;
        } else {
            CommonNotification("error", "Please select Site");
