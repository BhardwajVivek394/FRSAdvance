@{
    var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    serializer.MaxJsonLength = Int32.MaxValue;
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script>
 // ---- Server data to JS ----
 const ZONES = @Html.Raw(serializer.Serialize(Model.Zones));
 const ASSET_TYPES = @Html.Raw(serializer.Serialize(Model.AssetTypes));
 const PARAM_TYPES = @Html.Raw(serializer.Serialize(Model.ParamTypes));
 const PARAM_REP_HELPERS = @Html.Raw(serializer.Serialize(Model.ParamRepHelpers));

 // ---- Helpers ----
 const clampHexByte = (v) => (v || "").replace(/[^0-9a-fA-F]/g, "").toUpperCase().slice(0,2).padStart(2,"0");
 const toBin8 = (hex) => (parseInt(hex || "00",16) >>> 0).toString(2).padStart(8,"0");
 const toDec = (hex) => { const n = parseInt(hex,16); return isNaN(n) ? 0 : n; };
 const hexJoin = (arr) => arr.map(clampHexByte).join("");
    const copy = async (text) => {
        try
        {
            if (navigator.clipboard && window.isSecureContext) {

                await navigator.clipboard.writeText(text); alert("Copied!");
            } else {
                const textarea = document.createElement("textarea");
                textarea.value = text;
                textarea.style.position = "fixed";   // Avoid scrolling to bottom
                textarea.style.opacity = "0";        // Hide element
                document.body.appendChild(textarea);

                textarea.focus();
                textarea.select();

                const successful = document.execCommand("copy");
                document.body.removeChild(textarea);

                if (successful) {
                    alert("Copied!");
                } else {
                    alert("Copy failed (execCommand not supported).");
                }
            }

        } catch (e) { }
    };

 // ---- DOM ----
 const els = {
   zoneId: document.getElementById("zoneId"),
   divisionId: document.getElementById("divisionId"),
   stationId: document.getElementById("stationId"),
   gwNumId: document.getElementById("gwNumId"),
   stgwiText: document.getElementById("stgwiText"),
   stgwiBadges: document.getElementById("stgwiBadges"),
   stgwiBytesBinDec: document.getElementById("stgwiBytesBinDec"),
   zoneSel: document.getElementById("zoneSel"),
   divSel: document.getElementById("divSel"),
   stationCode: document.getElementById("stationCode"),

   assetTypeId: document.getElementById("assetTypeId"),
   assetNumberId: document.getElementById("assetNumberId"),
   paramTypeId: document.getElementById("paramTypeId"),
   paramRepId: document.getElementById("paramRepId"),
   paramRepHelper: document.getElementById("paramRepHelper"),
   astcCode: document.getElementById("astcCode"),
   pridText: document.getElementById("pridText"),
   pridBadges: document.getElementById("pridBadges"),
   pridBytesBinDec: document.getElementById("pridBytesBinDec"),

   packetJson: document.getElementById("packetJson"),
   copyStgwi: document.getElementById("copyStgwi"),
   copyPrid: document.getElementById("copyPrid"),
   copyJson: document.getElementById("copyJson"),
   copyCsv: document.getElementById("copyCsv"),
    };



 // ---- State (w/ defaults like React version) ----
 const state = {
   zoneId: "00",
   divisionId: "00",
   stationId: "00",
   gwNumId: "00",
   assetTypeId: "00",
   assetNumberId: "00",
   paramTypeId: "00",
   paramRepId: "00",
   zoneCode: "CR",
   divisionCode: "BSL",
   stationCode: "LJN",
 };

 // ---- Load from localStorage ----
    (function load() {

   //     try {
   //  const s = JSON.parse(localStorage.getItem("rdpms_byte_state") || "{}");
   //  Object.assign(state, s);
   //} catch {}
 })();

 // ---- Init inputs ----
 function syncInputsFromState() {
   els.zoneId.value = state.zoneId;
   els.divisionId.value = state.divisionId;
   els.stationId.value = state.stationId;
   els.gwNumId.value = state.gwNumId;

   els.assetTypeId.value = state.assetTypeId;
   els.assetNumberId.value = state.assetNumberId;
   els.paramTypeId.value = state.paramTypeId;
   els.paramRepId.value = state.paramRepId;

   els.stationCode.value = state.stationCode;

   // selects: zone/division helpers
     els.zoneSel.value = state.zoneId;
     rebuildDivisions();
     els.divSel.value = state.divisionId;

     rebuildParameterRepresentation();
     els.paramRepId.value = state.paramRepId;

     var dataCode = $("#divSel").find(":selected").data("rdpms");
     GetSiteByDivisionId(dataCode);
     els.stationId.value = state.stationId;

     var assetTypeCode = $("#assetTypeId").find(":selected").data("rdpms");
     GetAssetByTypeId(assetTypeCode);
     els.assetNumberId.value = state.assetNumberId;

     rebuildParamRepHelper();

     fnBindStationGatewayTable();
     fnBindParameterGatewayTable();
 }

 function persist() {
   try { localStorage.setItem("rdpms_byte_state", JSON.stringify(state)); } catch {}
 }

 // ---- Derived ----
 function currentZone() { return ZONES.find(z => z.Id === state.zoneId); }
 function currentDivision() { return currentZone()?.Divisions.find(d => d.Id === state.divisionId); }
 function currentAssetType() { return ASSET_TYPES.find(a => a.Id === state.assetTypeId); }
 function currentParamType() { return PARAM_TYPES.find(p => p.Id === state.paramTypeId); }

    function rebuildDivisions() {
        const z = currentZone();
        els.divSel.innerHTML = "";

        const opt = document.createElement("option");
        opt.value = '';
        opt.textContent = 'Select';
        els.divSel.appendChild(opt);

        (z?.Divisions || []).forEach(d => {
            const opt = document.createElement("option");
            opt.value = d.Id;
            opt.textContent = `${d.Code} – ${d.Name} (id ${d.Id})`;
            opt.setAttribute("data-rdpms", d.RDPMSId);
            els.divSel.appendChild(opt);
        });
        // set codes
        state.zoneCode = z?.Code || "";
        state.divisionCode = currentDivision()?.Code || "";
    }

    function rebuildParameterRepresentation() {
        const z = currentAssetType();
        els.paramRepId.innerHTML = "";

        const opt = document.createElement("option");
        opt.value = '';
        opt.textContent = 'Select';
        els.paramRepId.appendChild(opt);
        (z?.AssetAttribute || []).forEach(d => {
            const opt = document.createElement("option");
            opt.value = d.Id;
            opt.textContent = `${d.Code} – ${d.Name} (id ${d.Id})`;
            opt.setAttribute("data-rdpms", d.RDPMSId);
            els.paramRepId.appendChild(opt);
        });
        //// set codes
        //state.zoneCode = z?.Code || "";
        //state.divisionCode = currentDivision()?.Code || "";
    }

 function rebuildParamRepHelper() {
   els.paramRepHelper.innerHTML = '<option value="">Helper (optional)</option>';
   const astc = currentAssetType()?.Code || "";
   const list = (PARAM_REP_HELPERS || {})[astc] || [];
   list.forEach(r => {
     const opt = document.createElement("option");
     opt.value = r.Id; opt.textContent = `${r.Id} – ${r.Code} – ${r.Name}`;
     els.paramRepHelper.appendChild(opt);
   });
   els.paramRepHelper.value = list.some(r => r.Id === state.paramRepId) ? state.paramRepId : "";
 }

    function badge(label, hex) {
     hex = clampHexByte(hex);

        $("#lbl" + label).text(hex);

   return `
     <div class="flex items-center gap-2">
       <div class="flex flex-col items-center justify-center gap-1">
         <div class="text-[10px] text-gray-500">${label}</div>
         <div class="w-16 h-10 rounded-lg bg-indigo-50 border border-indigo-200 flex items-center justify-center font-mono text-sm">${hex}</div>
       </div>
     </div>`;
 }

 function renderByteBreakdown(container, arr) {
   container.innerHTML = arr.map(b => `
     <div class="text-xs text-gray-600">
       <div class="font-mono">0x${clampHexByte(b)} → ${toDec(b)} dec</div>
       <div class="font-mono">${toBin8(b)} <span class="text-[10px] text-gray-400">(bin)</span></div>
     </div>
   `).join("");
 }

    function render() {
        // compose
   const stgwiBytes = [state.zoneId, state.divisionId, state.stationId, state.gwNumId];
   const pridBytes  = [state.assetTypeId, state.assetNumberId, state.paramTypeId, state.paramRepId];
   const stgwi = hexJoin(stgwiBytes);
   const prid  = hexJoin(pridBytes);

   // top chips
   els.stgwiText.textContent = stgwi;
   els.pridText.textContent = prid;

   els.stgwiBadges.innerHTML = [
     badge("zone_id", state.zoneId),
     '<div class="text-gray-300">➔</div>',
     badge("division_id", state.divisionId),
     '<div class="text-gray-300">➔</div>',
     badge("station_id", state.stationId),
     '<div class="text-gray-300">➔</div>',
     badge("gw_number_id", state.gwNumId),
   ].join("");

   els.pridBadges.innerHTML = [
     badge("asset_type_id", state.assetTypeId),
     '<div class="text-gray-300">➔</div>',
     badge("asset_number_id", state.assetNumberId),
     '<div class="text-gray-300">➔</div>',
     badge("parameter_type_id", state.paramTypeId),
     '<div class="text-gray-300">➔</div>',
     badge("parameter_representation_id", state.paramRepId),
     ].join("");

   renderByteBreakdown(els.stgwiBytesBinDec, stgwiBytes);
   renderByteBreakdown(els.pridBytesBinDec,  pridBytes);

   // labels
   const ast = currentAssetType();
   els.astcCode.textContent = ast?.Code || "";

   // packet
   const packet = {
     stgwi,
     prid,
     zc: state.zoneCode,
     dc: state.divisionCode,
     sc: state.stationCode,
     astc: ast?.Code || "",
     prt: "20250101120000000",
     prv: (state.paramTypeId === "40") ? 1 : 0.0
   };
     els.packetJson.textContent = JSON.stringify(packet, null, 2);

     fnBindStationGatewayTable();
     fnBindParameterGatewayTable();
 }

 // ---- Wire inputs ----
    function onHexInput(id, key) {
   const el = document.getElementById(id);
   el.addEventListener("input", () => {
     state[key] = clampHexByte(el.value);
     if (key === "zoneId") {
       rebuildDivisions();
     }
     if (key === "divisionId") {
       state.divisionCode = currentDivision()?.Code || "";
     }
     persist(); render();
   });
 }

 onHexInput("zoneId", "zoneId");
 onHexInput("divisionId", "divisionId");
 onHexInput("stationId", "stationId");
 onHexInput("gwNumId", "gwNumId");
 onHexInput("assetNumberId", "assetNumberId");
 onHexInput("paramRepId", "paramRepId");

 els.stationCode.addEventListener("input", () => {
   state.stationCode = els.stationCode.value.toUpperCase().slice(0,5);
   persist(); render();
 });

 els.zoneSel.addEventListener("change", () => {
   state.zoneId = els.zoneSel.value;
   els.zoneId.value = state.zoneId;
   rebuildDivisions();
   state.divisionId = (currentZone()?.Divisions?.[0]?.Id) || "00";
   els.divSel.value = state.divisionId;
   els.divisionId.value = state.divisionId;
   state.zoneCode = currentZone()?.Code || "";
   state.divisionCode = currentDivision()?.Code || "";
   persist(); render();
 });

    els.divSel.addEventListener("change", (e) => {
        state.divisionId = els.divSel.value;
        els.divisionId.value = state.divisionId;
        state.divisionCode = currentDivision()?.Code || "";
        persist(); render();

        const selectedOption = e.target.options[e.target.selectedIndex];
        const dataCode = selectedOption.getAttribute("data-rdpms");
        GetSiteByDivisionId(dataCode);
    });

    els.stationId.addEventListener("change", (e) => {
        const selectedOption = e.target.options[e.target.selectedIndex];
        const dataCode = selectedOption.getAttribute("data-stationcode");

        state.stationCode = dataCode.toUpperCase().slice(0, 5);

        state.stationId = els.stationId.value;

        var assetTypeCode = $("#assetTypeId").find(":selected").data("rdpms");
        GetAssetByTypeId(assetTypeCode);

        persist(); render();


    });

    els.assetTypeId.addEventListener("change", (e) => {
        state.assetTypeId = els.assetTypeId.value;
        rebuildParamRepHelper();

        rebuildParameterRepresentation();

        const selectedOption = e.target.options[e.target.selectedIndex];
        const dataCode = selectedOption.getAttribute("data-rdpms");
        GetAssetByTypeId(dataCode);

        persist(); render();
    });

    els.assetNumberId.addEventListener("change", (e) => {

        state.assetNumberId = els.assetNumberId.value;

        persist(); render();
    });

 els.paramTypeId.addEventListener("change", () => {
   state.paramTypeId = els.paramTypeId.value;
   persist(); render();
 });

 els.paramRepHelper.addEventListener("change", () => {
   const v = els.paramRepHelper.value;
   if (v) {
     state.paramRepId = clampHexByte(v);
     els.paramRepId.value = state.paramRepId;
     persist(); render();
   }
 });

    // Copy buttons
 els.copyStgwi.addEventListener("click", () => copy(els.stgwiText.textContent));
 els.copyPrid.addEventListener("click", () => copy(els.pridText.textContent));
 els.copyJson.addEventListener("click", () => copy(els.packetJson.textContent));
 els.copyCsv.addEventListener("click", () => {
   const csv = `${els.stgwiText.textContent},${els.pridText.textContent}`;
   copy(csv);
 });

    $(document).ready(function () {
        fnAssetPartial();

        $('#stationId').change(function () {
            fnAssetPartial();
        });
    });

 // ---- Boot ----
 (function init() {
   // prefill controls from state
   // set default selected assetType/paramType if not in list
   if (!ASSET_TYPES.some(a => a.Id === state.assetTypeId)) state.assetTypeId = ASSET_TYPES[0]?.Id || "00";
   if (!PARAM_TYPES.some(p => p.Id === state.paramTypeId)) state.paramTypeId = PARAM_TYPES[0]?.Id || "40";

   // set UI
   //syncInputsFromState();

   // reflect controlled selects that are *not* hex inputs
   //els.assetTypeId.value = state.assetTypeId;
     //els.paramTypeId.value = state.paramTypeId;

  // render();
    })();


    function GetSiteByDivisionId(divisionId) {
        if (divisionId != null && divisionId != undefined && divisionId != '') {
            $("#loader").show();
            $.ajax({
                url: '/AnnexureA/GetSiteByDivisionId',
                type: 'POST',
                data: '{divisionId:' + divisionId + '}',
                contentType: 'application/json',
                async: false,
                success: function (data) {
                    $("#loader").hide();

                    if (data != null && data != undefined && data.length > 0) {
                        var strdata = '<option value="">Select</option>';

                        var counter = 0;
                        $.each(data, function (key, value) {
                            var hex = counter.toString(16).toUpperCase().padStart(2, '0');
                            strdata += '<option value="' + hex + '" data-siteid="' + value.Id + '" data-stationcode="' + value.StationCode + '">' + value.Name + '(' + hex + ')' + '</option>';

                            counter++;
                        });

                        $("#stationId").empty().append(strdata);
                        $("#stationId").show();
                        $("#stationCode").hide();


                    } else {
                        $("#stationCode").show();
                        $("#stationId").hide();
                    }
                    //persist(); render();
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        } else {

            $("#stationCode").show();
            $("#stationId").hide();
        }

    }

    function GetAssetByTypeId(typeId) {
        var siteId = $('#stationId').find(":selected").data("siteid");
        if (siteId != null && siteId != undefined && siteId != '' && typeId != null && typeId != undefined && typeId != '') {
            $("#loader").show();
            $.ajax({
                url: '/AnnexureA/GetAssetByTypeId',
                type: 'POST',
                data: '{siteId:' + siteId + ',typeId:' + typeId + '}',
                contentType: 'application/json',
                async: false,
                success: function (data) {
                    $("#loader").hide();

                    if (data != null && data != undefined && data.length > 0) {
                        var strdata = '<option value="">Select</option>';
                        var counter = 0;
                        $.each(data, function (key, value) {
                            var hex = counter.toString(16).toUpperCase().padStart(2, '0');
                            strdata += '<option value="' + hex + '">' + value.AssetName + '(' + hex + ')</option>';
                            counter++;
                        });

                        $("#assetNumberId").empty().append(strdata);
                        //$("#stationId").show();
                        //$("#stationCode").hide();
                    } else {
                        //$("#stationCode").show();
                        //$("#stationId").hide();

                        $("#assetNumberId").empty().append('<option value="">Select</option>');
                    }
                   // persist(); render();
                },
                error: function (response) {
                    $("#loader").hide();
                    $("#assetNumberId").empty().append('<option value="">Select</option>');
                }
            });
        } else {
            $("#assetNumberId").empty().append('<option value="">Select</option>');
        }

    }

    function DownloadJSON() {

