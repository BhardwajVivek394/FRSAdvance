@model List<Domain.RailwayInfo>

@{
    var assetTypes = Model.GroupBy(x => new { x.AssetTypeId, x.AssetType }).Select(x => x.Key).ToList();
}

<div class="col-12 col-md-12 col-lg-6 mt-0">
    <div class="card card-bg p-3 border-0">


        <ul class="nav nav-tabs" id="myTab" role="tablist">

            @if (assetTypes != null && assetTypes.Count > 0)
            {
                bool isFirst = true;
                foreach (var assetType in assetTypes)
                {
                    string str = "";
                    if (isFirst)
                    {
                        str = "active";
                        isFirst = false;
                    }
                    <li class="nav-item" role="presentation">
                        <button class="nav-link @str" data-bs-toggle="tab" data-bs-target="#@assetType.AssetType.Replace(" ","")"
                                type="button" role="tab" aria-controls="home" aria-selected="true">
                            @assetType.AssetType
                        </button>
                    </li>
                }
            }

            @*<li class="nav-item" role="presentation">
                    <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile"
                            type="button" role="tab" aria-controls="profile" aria-selected="false">
                        Point Machine
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact"
                            type="button" role="tab" aria-controls="contact" aria-selected="false">
                        Track
                    </button>
                </li>*@
        </ul>
        <div class="tab-content" id="myTabContent">
            @if (assetTypes != null && assetTypes.Count > 0)
            {

                bool issecond = true;

                foreach (var assetType in assetTypes)
                {
                    string str = "";

                    if (issecond)
                    {
                        str = "show active";
                        issecond = false;
                    }
                    <div class="tab-pane fade @str" id="@assetType.AssetType.Replace(" ","")" role="tabpanel" aria-labelledby="@assetType.AssetType.Replace(" ","")-tab">
                        <div class="card-body p-0">
                            <div class="p-2 bd-table table-responsive">

                                <div class="">
                                    <table class="table m-0">
                                        <thead>
                                            <tr>
                                                <th class="tr-bg td-w"></th>
                                                <th class="tr-bg bg-color" scope="col">Asset Name</th>
                                                <th class="tr-bg" scope="col">Asset Number Code (Smms)</th>
                                                <th class="tr-bg" scope="col">Asset Number Id</th>
                                                <th class="tr-bg" scope="col">Asset Type Code</th>
                                                <th class="tr-bg" scope="col">Smms Code</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <!-- Row 1 -->
                                            @{
                                                var signalData = Model.Where(x => x.AssetTypeId == assetType.AssetTypeId).ToList();

                                            }

                                            @if (signalData != null && signalData.Count > 0)
                                            {
                                                foreach (var item in signalData)
                                                {
                                                    <tr>
                                                        <td class="td-w"><i class="fa fa-plus expand-btn" data-target="#order@(item.AssetId)"></i></td>
                                                        <td>@item.AssetName</td>
                                                        <td>@item.Asnc</td>
                                                        <td>@item.Asni</td>
                                                        <td>@item.Astc</td>
                                                        <td>@item.SmmsAssetCode</td>
                                                    </tr>

                                                    <tr class="collapse-row p-0" id="order@(item.AssetId)">
                                                        <td colspan="6" class="p-0 Nothover">
                                                            <div class="p-2 bd-table innerTable-w">

                                                                <table class="text-start">
                                                                    @if (item.Parameters != null)
                                                                    {
                                                                        <tr>
                                                                            <th class="text-end">Attributes : </th>
                                                                            @*<td class="px-3">RgmA</td>
                                                                                <td class="px-3">DgmA</td>
                                                                                <td class="px-3">RgmV</td>*@

                                                                            @foreach (var parm in item.Parameters)
                                                                            {
                                                                                <td class="px-3">@parm.Attribute</td>
                                                                            }
                                                                        </tr>

                                                                        <tr>
                                                                            <th class="text-end">Parameter Id : </th>
                                                                            @foreach (var parm in item.Parameters)
                                                                            {
                                                                                <td class="px-3"> @parm.Prid</td>
                                                                            }

                                                                            @*<td class="px-3"> 20092</td>
                                                                                <td class="px-3"> 20093</td>
                                                                                <td class="px-3"> 20094</td>*@
                                                                        </tr>
                                                                    }


                                                                </table>

                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }






                                        </tbody>
                                    </table>
                                </div>



                            </div>
                        </div>
                    </div>
                }
            }


        </div>


    </div>
</div>

<script>
    document.querySelectorAll('.expand-btn').forEach(btn => {
        btn.addEventListener('click', function () {
            const target = document.querySelector(this.dataset.target);

            if (!target.classList.contains('show')) {
                // Open
                target.classList.add('show');
                this.classList.replace('fa-plus', 'fa-minus');
            } else {
                // Smooth close
                target.classList.add('hiding');
                this.classList.replace('fa-minus', 'fa-plus');
                setTimeout(() => {
                    target.classList.remove('show', 'hiding');
                }, 350);
            }
        });
    });
</script>