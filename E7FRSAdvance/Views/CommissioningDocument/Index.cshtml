@model List<Domain.CommissioningDocument>
@{
    ViewBag.Title = "Commissioning Document";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Commissioning Document</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="pull-left">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Sites</strong>
                            </div>
                            <div class="pull-left">
                                @Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 1 })
                            </div>

                            <div class="pull-left m-l-10">
                                <button type="button" class="btn btn-success" onclick="DownloadAllFileInZip()">Download All Zip File</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    @if (ViewBag.CommissioningDocuments != null)
                    {
                        var commissioningDocuments = ViewBag.CommissioningDocuments as List<string>;
                        if (commissioningDocuments != null && commissioningDocuments.Count > 0)
                        {
                            <table class="table table-striped">
                                @foreach (var commissioningDocument in commissioningDocuments)
                                {
                                    <tr>
                                        <td>@commissioningDocument</td>
                                        <td width="400">
                                            @if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.NetworkDetails))
                                            {
                                                <input type="file" accept=".pdf" class="form-control" title="Upload @commissioningDocument" id="fileNetworkDetails" />
                                            }
                                            else if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.SiteSurvey))
                                            {
                                                <input type="file" accept=".pdf" class="form-control" id="fileSiteSurvey" />
                                            }
                                            else if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.PannelTestReport))
                                            {
                                                <input type="file" accept=".pdf" class="form-control" id="filePannelTestReport" />
                                            }
                                            else if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.ClusterValidation))
                                            {
                                                <input type="file" accept=".pdf" class="form-control" id="fileClusterValidation" />
                                            }
                                            else if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.RDPMSCommissioningList))
                                            {
                                                <input type="file" accept=".pdf" class="form-control" id="fileRDPMSCommissioningList" />
                                            }
                                            else if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.JointCalibrationReport))
                                            {
                                                <input type="file" accept=".pdf" class="form-control" id="fileJointCalibrationReport" />
                                            }
                                        </td>
                                        <td>
                                            @if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.NetworkDetails))
                                            {
                                                <button type="button" class="btn btn-success" onclick="fnUploadNetworkDetails($('#fileNetworkDetails'))">Upload</button>

                                                if (Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.CommissioningDocument.NetworkDetails).Count() > 0)
                                                {
                                                    <i class="fa fa-cloud-upload f-20"></i>
                                                }
                                            }
                                            else if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.SiteSurvey))
                                            {
                                                <button type="button" class="btn btn-success" onclick="UploadSiteSurvey($('#fileSiteSurvey'))">Upload</button>

                                                if (Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.CommissioningDocument.SiteSurvey).Count() > 0)
                                                {
                                                    <i class="fa fa-cloud-upload f-20"></i>
                                                }
                                                <button type="button" class="btn btn-primary" title="Configuration Site Survey" onclick="ConfigurationSiteSurvey()"><i class="fa fa-pencil"></i></button>

                                            }
                                            else if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.PannelTestReport))
                                            {
                                                <button type="button" class="btn btn-success" onclick="UploadPannelTestReport($('#filePannelTestReport'))">Upload</button>
                                                if (Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.CommissioningDocument.PannelTestReport).Count() > 0)
                                                {
                                                    <i class="fa fa-cloud-upload f-20"></i>
                                                }
                                            }
                                            else if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.ClusterValidation))
                                            {
                                                <button type="button" class="btn btn-success" onclick="UploadClusterValidation($('#fileClusterValidation'))">Upload</button>
                                                if (Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.CommissioningDocument.ClusterValidation).Count() > 0)
                                                {
                                                    <i class="fa fa-cloud-upload f-20"></i>
                                                }
                                            }
                                            else if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.RDPMSCommissioningList))
                                            {
                                                <button type="button" class="btn btn-success" onclick="UploadRDPMSCommissioningList($('#fileRDPMSCommissioningList'))">Upload</button>
                                                if (Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.CommissioningDocument.RDPMSCommissioningList).Count() > 0)
                                                {
                                                    <i class="fa fa-cloud-upload f-20"></i>
                                                }
                                            }
                                            else if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.JointCalibrationReport))
                                            {
                                                <button type="button" class="btn btn-success" onclick="UploadJointCalibrationReport($('#fileJointCalibrationReport'))">Upload</button>
                                                if (Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.CommissioningDocument.JointCalibrationReport).Count() > 0)
                                                {
                                                    <i class="fa fa-cloud-upload f-20"></i>
                                                }
                                            }
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-info" onclick="DownloadDocument('@commissioningDocument.Replace(" ","")')">Download</button>
                                            @if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.PannelTestReport))
                                            {
                                                <a href="javascript:void(0)" class="btn btn-info" title="Download Automated Pannel Test Report" onclick="DownloadPannelTestReportAutomatic()"><i class="fa fa-download"></i></a>
                                            }
                                            else if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.JointCalibrationReport))
                                            {
                                                <a href="javascript:void(0)" class="btn btn-info" title="Download Automated Joint Calibration Report" onclick="DownloadJointCalibrationReportAutomatic()"><i class="fa fa-download"></i></a>
                                            }
                                            else if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.ClusterValidation))
                                            {
                                                <a href="javascript:void(0)" class="btn btn-info" title="Download Automated Joint Calibration Report" onclick="DownloadClusterValidationAutomatic()"><i class="fa fa-download"></i></a>
                                            }
                                            else if (commissioningDocument == E7FRSAdvance.Utility.EnumHelper.GetDisplayName(E7FRSAdvance.Utility.Utility.CommissioningDocument.SiteSurvey))
                                            {
                                                <a href="javascript:void(0)" class="btn btn-info" title="Download Automated Site Survey Report" onclick="DownloadSiteSurveyAutomatic()"><i class="fa fa-download"></i></a>
                                            }
                                        </td>
                                    </tr>
                                }

                            </table>

                        }
                    }
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    $(document).ready(function () {

        $('#SiteId').change(function () {
            window.location.href = "@Url.Action("Index")?siteId=" + $(this).val();
        });

        if ($('#hdnCatListType').val() == 'Success') {
            CommonNotification($("#hdnCatListType").val().toUpperCase(), $("#hdnCatListMessage").val(), $("#hdnCatListType").val());
        }
        else if ($('#hdnCatListType').val() == 'Error') {
            if ($('#hdnCatListMessage').val() == 'Forbidden!') {
                window.location.href = "/Login/Index";
            } else {
                CommonNotification($("#hdnCatListType").val().toUpperCase(), $("#hdnCatListMessage").val(), $("#hdnCatListType").val());
            }
        }
    });

    function DownloadAllFileInZip() {
        if ($('#SiteId').val() != null && $('#SiteId').val() != '' && $('#SiteId').val() != undefined && $('#SiteId').val() != "0") {
            window.location.href = "@Url.Action("DownloadAllFileInZip")?siteId=" + $('#SiteId').val();
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

    function DownloadPannelTestReportAutomatic() {
        if ($('#SiteId').val() != null && $('#SiteId').val() != '' && $('#SiteId').val() != undefined && $('#SiteId').val() != "0") {
            window.location.href = "@Url.Action("DownloadPannelTestReportAutomatic", "CommissioningDocument")?siteId=" + $('#SiteId').val();
        } else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

    function DownloadJointCalibrationReportAutomatic() {
        if ($('#SiteId').val() != null && $('#SiteId').val() != '' && $('#SiteId').val() != undefined && $('#SiteId').val() != "0") {
