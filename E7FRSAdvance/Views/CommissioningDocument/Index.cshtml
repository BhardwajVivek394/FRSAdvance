        } else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

    function DownloadDocument(documentType) {
        if (documentType == "RDPMSManual") {
            window.location.href = "@Url.Action("DownloadRDPMSManual", "CommissioningDocument")";
        }
        else if (documentType == "GeneralCircuitDiagram") {
            window.location.href = "@Url.Action("DownloadGeneralCircuitDiagram", "CommissioningDocument")";
        }
        else if (documentType == "Energy7RDPMSArchitecture") {
            window.location.href = "@Url.Action("DownloadRDPMSArchitecture", "CommissioningDocument")";
        }
        else if (documentType == "RDPMSBooklet") {
            window.location.href = "@Url.Action("DownloadRDPMSBooklet", "CommissioningDocument")";
        }
        else if (documentType == "LabTestReport") {
            window.location.href = "@Url.Action("DownloadLabTestReport", "CommissioningDocument")";
        }
        else if ($('#SiteId').val() != "" && $('#SiteId').val() != null && $('#SiteId').val() != undefined && $('#SiteId').val() != "0") {
            if (documentType == "BitChart") {
                window.location.href = "@Url.Action("DownloadBitChart", "CommissioningDocument")?siteId=" + $('#SiteId').val();
            }
            else if (documentType == "MaterialPositioning") {
                window.location.href = "@Url.Action("DownloadMaterialPositioning", "CommissioningDocument")?siteId=" + $('#SiteId').val();
            }
            else if (documentType == "NetworkDetails") {
                window.location.href = "@Url.Action("DownloadNetworkDetails", "CommissioningDocument")?siteId=" + $('#SiteId').val();
            }
            else if (documentType == "SiteSurvey") {
                window.location.href = "@Url.Action("DownloadSiteSurvey", "CommissioningDocument")?siteId=" + $('#SiteId').val();
            }
            else if (documentType == "PannelTestReport") {
                window.location.href = "@Url.Action("DownloadPannelTestReport", "CommissioningDocument")?siteId=" + $('#SiteId').val();
            }
            else if (documentType == "ClusterValidation") {
                window.location.href = "@Url.Action("DownloadClusterValidation", "CommissioningDocument")?siteId=" + $('#SiteId').val();
            }
            else if (documentType == "RDPMSCommissioningList") {
                window.location.href = "@Url.Action("DownloadRDPMSCommissioningList", "CommissioningDocument")?siteId=" + $('#SiteId').val();
            }
            else if (documentType == "JointCalibrationReport") {
                window.location.href = "@Url.Action("DownloadJointCalibrationReport", "CommissioningDocument")?siteId=" + $('#SiteId').val();
            }
            else if (documentType == "CircuitDrawing") {
                window.location.href = "@Url.Action("DownloadCircuitDrawing", "CommissioningDocument")?siteId=" + $('#SiteId').val();
            }
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

    function fnUploadNetworkDetails($this) {
        if ($('#SiteId').val() != null && $('#SiteId').val() != '' && $('#SiteId').val() != undefined && $('#SiteId').val() != "0") {
            debugger;
            var fileUpload = $($this).get(0);
            var files = fileUpload.files;
            if (files != null && files != undefined && files.length > 0) {
                var fileData = new FormData();
                fileData.append("siteId", $('#SiteId').val());
                fileData.append(files[0].name, files[0]);
                $("#loader").show();
                $.ajax({
                    url: "/CommissioningDocument/UploadNetworkDetails",
                    type: "POST",
                    contentType: false,
                    processData: false,
                    data: fileData,
                    async: true,
                    success: function (data) {
                        $("#loader").hide();
                        if (data != null && data != undefined) {
                            if (data.type == "success") {
                                CommonNotification("SUCCESS", data.result, "success");
                            }
                            else if (data.type == "error") {
                                CommonNotification("ERROR", data.result, "Error");
                            }
                        }
                    },
                    error: function (xhr, error, status) {
                        $("#loader").hide();
                        CommonNotification("ERROR", "Internal server error.", "Error");
                    }
                });
            }
            else {
                CommonNotification("ERROR", "Select Network Details File", "Error");
            }
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

