@model List<Domain.Dto.A10VM>

<div class="a10-list pb-3">
    <div class="d-flex flex-wrap a10-box">
        @foreach (var a10 in Model)
        {
            // C# 5 compatible - explicit null checks
            string firmware = a10.FirmwareVersion != null ? a10.FirmwareVersion  : "";
            string slaveAddress = a10.SlaveAddress != null ? a10.SlaveAddress : "";
            string clusterName = a10.ClusterName != null ? a10.ClusterName : "";
            string modemId = a10.ModemId != null ? a10.ModemId.ToString() : "";
            string modemName = a10.ModemName != null ? a10.ModemName : "";
            string stationName = a10.StationName != null ? a10.StationName : "";
            string divisionName = a10.DivisionName != null ? a10.DivisionName : "";
            string mqttBasePath = a10.MQTTBasePath != null ? a10.MQTTBasePath : "";
            string mqttSubscribe = a10.MqttSubscribe != null ? a10.MqttSubscribe : "";
            string mqttPublish = a10.MqttPublish != null ? a10.MqttPublish : "";
            string lastDataTime = a10.LastDataTime.HasValue ? a10.LastDataTime.Value.ToString("o") : "";
            string firmwareDisplay = a10.FirmwareVersion != null ? a10.FirmwareVersion : "-";
            string statusClass = a10.IsOnline ? "online" : "offline";

<div class="a10-item card card-elevated p-2 mt-2 d-flex flex-row align-items-center gap-2 mw-125"
     data-a10-id="@a10.Id"
     data-a10-number="@a10.ADCNumber"
     data-a10-type="@a10.ADCTypeName"
     data-a10-type-id="@a10.ADCTypeId"
     data-a10-firmware="@firmware"
     data-a10-slave="@slaveAddress"
     data-a10-channels="@a10.ChannelCount"
     data-cluster-id="@a10.ClusterId"
     data-cluster-name="@clusterName"
     data-modem-id="@modemId"
     data-modem-name="@modemName"
     data-site-id="@a10.SiteId"
     data-station-name="@stationName"
     data-division-name="@divisionName"
     data-mqtt-base="@mqttBasePath"
     data-mqtt-subscribe="@mqttSubscribe"
     data-mqtt-publish="@mqttPublish"
     data-tcp-status="@a10.TcpStatus.ToString().ToLower()"
     data-mqtt-status="@a10.MqttStatus.ToString().ToLower()"
     data-last-data="@lastDataTime"
     onclick="selectA10BS(this)">
    <div class="flex-grow-1">
        <div class="fw-semibold small d-flex align-items-center">
            <span class="status-dot @statusClass me-1" style="width: 5px; height: 5px;"></span>
            A10-@a10.ADCNumber
        </div>
        <small class="text-muted font-mono" style="font-size: 0.6rem;">Type: @a10.ADCTypeName</small>
        <small class="text-muted font-mono"> | </small>
        <small class="text-muted font-mono" style="font-size: 0.6rem;">F/W: @firmwareDisplay</small>
    </div>
</div>}
    </div>
</div>

@if (Model.Count == 0)
{
<div class="text-muted small text-center py-3">No A10 devices found</div>}
