@* ============================================================
    SET CONFIG MODAL - Mode & Threshold from Database (Read-Only)
    Uses Paho MQTT JavaScript for direct MQTT communication
    Auto-connects to MQTT when modal opens
    Ports: 8083 (WS) / 8084 (WSS)
    ============================================================ *@

<!-- Paho MQTT JavaScript Library -->
<script src="~/assets/js/paho-mqtt.js"></script>

<!-- Set Config Modal -->
<div class="modal fade" id="setConfigModal" tabindex="-1" aria-labelledby="setConfigModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content set-config-modal">
            <!-- Modal Header -->
            <div class="modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="config-icon">
                        <i class="bi bi-gear-fill"></i>
                    </div>
                    <div>
                        <h5 class="modal-title" id="setConfigModalLabel">ADC Channel Configuration</h5>
                        <small class="scm-text-muted" id="scmConfigContextInfo">Loading...</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-0">
                <!-- Top Action Bar -->
                <div class="config-action-bar p-3">
                    <div class="row align-items-center g-3">
                        <div class="col-auto">
                            <div class="mqtt-status-indicator">
                                <span class="mqtt-dot" id="scmMqttStatusDot"></span>
                                <span class="mqtt-label" id="scmMqttStatusLabel">Disconnected</span>
                            </div>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-outline-secondary btn-sm" onclick="scmReconnectMqtt()" id="scmBtnMqttReconnect" title="Reconnect MQTT">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-warning btn-sm" onclick="scmSendSelectedToDevice()" id="scmBtnSendSelected">
                                <i class="bi bi-send me-1"></i> Send Selected
                            </button>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-info btn-sm" onclick="scmGetSelectedFromDevice()" id="scmBtnGetSelected">
                                <i class="bi bi-download me-1"></i> Get Selected
                            </button>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-danger btn-sm" onclick="scmSendAllToDevice()" id="scmBtnSendAll">
                                <i class="bi bi-lightning me-1"></i> Send All
                            </button>
                        </div>
                        <div class="col-auto">
                            <button class="btn btn-outline-secondary btn-sm" onclick="scmShowCommandLog()">
                                <i class="bi bi-terminal me-1"></i> Log
                            </button>
                        </div>
                        <div class="col-auto ms-auto">
                            <span class="badge bg-info" id="scmSelectedCount">0 selected</span>
                            <span class="badge bg-secondary ms-1" id="scmSendableCount">0 sendable</span>
                        </div>
                    </div>
                    <div class="mode-legend mt-2">
                        <small>Mode: 0=Normal, 1=Normal, 2=Max, 3=Capture, 4=One-shot, 5=Digital | Values from Database | N/A = Not configured</small>
                    </div>
                </div>

                <!-- Loading State -->
                <div id="scmConfigLoading" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-2 small scm-text-muted">Loading configuration from database...</div>
                </div>

                <!-- Config Content -->
                <div id="scmConfigContent" style="display: none;"></div>

                <!-- Error State -->
                <div id="scmConfigError" class="text-center py-5" style="display: none;">
                    <i class="bi bi-exclamation-triangle text-danger fs-1"></i>
                    <div class="mt-2 scm-text-muted" id="scmConfigErrorMsg">Failed to load configuration</div>
                    <button class="btn btn-sm btn-outline-primary mt-2" onclick="scmRetryLoadConfig()">Retry</button>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer">
                <div class="d-flex align-items-center gap-2 me-auto">
                    <span class="badge bg-secondary" id="scmCommandStatus">Ready</span>
                    <small class="scm-text-muted" id="scmLastCommandInfo"></small>
                </div>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Command Log Modal -->
<div class="modal fade" id="scmCommandLogModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content set-config-modal">
            <div class="modal-header">
                <h6 class="modal-title"><i class="bi bi-terminal me-2"></i>Command Log (MQTT Terminal)</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div id="scmCommandLogEntries" style="max-height: 400px; overflow-y: auto;"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-sm btn-outline-secondary" onclick="scmClearCommandLog()">Clear Log</button>
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Channel Info Modal (for Get response) -->
<div class="modal fade" id="scmChannelInfoModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content set-config-modal">
            <div class="modal-header">
                <h6 class="modal-title"><i class="bi bi-info-circle me-2"></i>Channel Configuration (Device)</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="scmChannelInfoContent">
                    <div class="channel-info-grid">
                        <div class="info-item">
                            <span class="info-label">ADC ID:</span>
                            <span class="info-value" id="scmInfoAdcId">-</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Channel:</span>
                            <span class="info-value" id="scmInfoChannel">-</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Mode:</span>
                            <span class="info-value" id="scmInfoMode">-</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Threshold:</span>
                            <span class="info-value" id="scmInfoThreshold">-</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Offset:</span>
                            <span class="info-value" id="scmInfoOffset">-</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Div:</span>
                            <span class="info-value" id="scmInfoDiv">-</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Mul:</span>
                            <span class="info-value" id="scmInfoMul">-</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Timestamp:</span>
                            <span class="info-value" id="scmInfoTimestamp">-</span>
                        </div>
                        <div class="info-item full-width">
                            <span class="info-label">Response:</span>
                            <span class="info-value" id="scmInfoResponse">-</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Dark Theme (Default) */
    .set-config-modal {
        --scm-bg-primary: #0a0f1a;
        --scm-bg-secondary: #111827;
        --scm-bg-tertiary: #1e293b;
        --scm-bg-hover: #2d3a4f;
        --scm-bg-card: #0f172a;
        --scm-border-primary: #1f2937;
        --scm-border-secondary: #334155;
        --scm-text-primary: #e2e8f0;
        --scm-text-secondary: #94a3b8;
        --scm-text-muted: #64748b;
        --scm-text-highlight: #f1f5f9;
        --scm-accent-blue: #3b82f6;
        --scm-accent-cyan: #22d3ee;
        --scm-accent-purple: #a78bfa;
        --scm-accent-yellow: #fbbf24;
        --scm-accent-green: #22c55e;
        --scm-accent-red: #ef4444;
        --scm-accent-orange: #f59e0b;
        --scm-btn-bg: #374151;
        --scm-btn-text: #e2e8f0;
        --scm-btn-hover: #0ea5e9;
        --scm-btn-disabled: #1f2937;
        --scm-badge-blue-bg: rgba(59, 130, 246, 0.2);
        --scm-badge-cyan-bg: rgba(6, 182, 212, 0.2);
        --scm-log-send-bg: #0c1929;
        --scm-log-recv-bg: #091c09;
        --scm-scrollbar-track: #0f172a;
        --scm-scrollbar-thumb: #334155;
        --scm-scrollbar-thumb-hover: #475569;
        --scm-close-filter: invert(1);
        --scm-row-selected: rgba(59, 130, 246, 0.1);
        --scm-row-hover: rgba(59, 130, 246, 0.05);
        --scm-input-bg: #1e293b;
        --scm-input-border: #374151;
    }

        /* Light Theme */
        .set-config-modal.light-theme {
            --scm-bg-primary: #ffffff;
            --scm-bg-secondary: #f8fafc;
            --scm-bg-tertiary: #f1f5f9;
            --scm-bg-hover: #e2e8f0;
            --scm-bg-card: #ffffff;
            --scm-border-primary: #e2e8f0;
            --scm-border-secondary: #cbd5e1;
            --scm-text-primary: #1e293b;
            --scm-text-secondary: #475569;
            --scm-text-muted: #64748b;
            --scm-text-highlight: #0f172a;
            --scm-accent-blue: #2563eb;
            --scm-accent-cyan: #0891b2;
            --scm-accent-purple: #7c3aed;
            --scm-accent-yellow: #b45309;
            --scm-accent-green: #16a34a;
            --scm-accent-red: #dc2626;
            --scm-accent-orange: #ea580c;
            --scm-btn-bg: #e2e8f0;
            --scm-btn-text: #1e293b;
            --scm-btn-hover: #0284c7;
            --scm-btn-disabled: #f1f5f9;
            --scm-badge-blue-bg: rgba(37, 99, 235, 0.15);
            --scm-badge-cyan-bg: rgba(8, 145, 178, 0.15);
            --scm-log-send-bg: #eff6ff;
            --scm-log-recv-bg: #f0fdf4;
            --scm-scrollbar-track: #f1f5f9;
            --scm-scrollbar-thumb: #cbd5e1;
            --scm-scrollbar-thumb-hover: #94a3b8;
            --scm-close-filter: none;
            --scm-row-selected: rgba(37, 99, 235, 0.1);
            --scm-row-hover: rgba(37, 99, 235, 0.05);
            --scm-input-bg: #ffffff;
            --scm-input-border: #cbd5e1;
        }

    /* MQTT Status Indicator */
    .mqtt-status-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        background-color: var(--scm-bg-secondary);
        border-radius: 20px;
        border: 1px solid var(--scm-border-secondary);
    }

    .mqtt-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background-color: var(--scm-accent-red);
    }

        .mqtt-dot.connected {
            background-color: var(--scm-accent-green);
            animation: scmPulse 2s infinite;
        }

        .mqtt-dot.connecting {
            background-color: var(--scm-accent-orange);
            animation: scmBlink 0.5s infinite;
        }

    .mqtt-label {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--scm-text-secondary);
    }

    @@keyframes scmPulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }
    }

    @@keyframes scmBlink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.3;
        }
    }

    /* Modal Base */
    .set-config-modal {
        background-color: var(--scm-bg-primary) !important;
        color: var(--scm-text-primary) !important;
        border: 1px solid var(--scm-border-primary) !important;
    }

        .set-config-modal .modal-header {
            background-color: var(--scm-bg-secondary) !important;
            border-bottom: 1px solid var(--scm-border-primary) !important;
        }

        .set-config-modal .modal-footer {
            background-color: var(--scm-bg-secondary) !important;
            border-top: 1px solid var(--scm-border-primary) !important;
        }

        .set-config-modal .config-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #f97316, #dc2626);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #ffffff !important;
        }

        .set-config-modal .modal-title {
            color: var(--scm-text-primary) !important;
            font-weight: 600;
        }

        .set-config-modal .btn-close {
            filter: var(--scm-close-filter);
        }

        .set-config-modal .scm-text-muted {
            color: var(--scm-text-muted) !important;
        }

    /* Action Bar */
    .config-action-bar {
        background-color: var(--scm-bg-tertiary) !important;
        border-bottom: 1px solid var(--scm-border-secondary) !important;
    }

    .mode-legend {
        font-size: 0.7rem;
        color: var(--scm-text-muted) !important;
    }

        .mode-legend small {
            color: var(--scm-text-muted) !important;
        }

    /* Cluster Card */
    .cluster-card {
        background-color: var(--scm-bg-secondary) !important;
        border: 1px solid var(--scm-border-secondary) !important;
        border-radius: 8px;
        margin: 12px;
        overflow: hidden;
    }

    .cluster-header {
        background-color: var(--scm-bg-tertiary) !important;
        padding: 12px 16px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .cluster-header:hover {
            background-color: var(--scm-bg-hover) !important;
        }

        .cluster-header .cluster-icon {
            width: 36px;
            height: 36px;
            background-color: var(--scm-badge-blue-bg) !important;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--scm-accent-blue) !important;
        }

        .cluster-header .cluster-name {
            font-weight: 600;
            color: var(--scm-text-primary) !important;
        }

        .cluster-header .cluster-info {
            font-size: 0.7rem;
            color: var(--scm-text-muted) !important;
        }

        .cluster-header .arrow {
            color: var(--scm-text-muted) !important;
            transition: transform 0.2s;
        }

            .cluster-header .arrow.expanded {
                transform: rotate(90deg);
            }

        .cluster-header .select-all-btn {
            font-size: 0.65rem;
            padding: 4px 10px;
        }

    /* ADC Card */
    .adc-card {
        background-color: var(--scm-bg-card) !important;
        border: 1px solid var(--scm-border-primary) !important;
        border-radius: 6px;
        margin: 8px 12px;
        overflow: hidden;
    }

    .adc-header {
        background-color: var(--scm-bg-tertiary) !important;
        padding: 10px 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .adc-header:hover {
            background-color: var(--scm-bg-hover) !important;
        }

        .adc-header .adc-icon {
            width: 30px;
            height: 30px;
            background-color: var(--scm-badge-cyan-bg) !important;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--scm-accent-cyan) !important;
            font-size: 0.8rem;
        }

        .adc-header .adc-name {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--scm-text-primary) !important;
        }

        .adc-header .adc-info {
            font-size: 0.65rem;
            color: var(--scm-text-muted) !important;
        }

    /* Pin Table */
    .pin-table-container {
        padding: 12px;
        background-color: var(--scm-bg-primary) !important;
    }

    .pin-table-header {
        display: grid;
        grid-template-columns: 40px 50px 120px 70px 90px 130px;
        gap: 8px;
        padding: 8px 12px;
        font-size: 0.65rem;
        color: var(--scm-text-muted) !important;
        font-weight: 600;
        text-transform: uppercase;
        border-bottom: 1px solid var(--scm-border-secondary) !important;
        background-color: var(--scm-bg-tertiary) !important;
        border-radius: 4px 4px 0 0;
    }

    .pin-row {
        display: grid;
        grid-template-columns: 40px 50px 120px 70px 90px 130px;
        gap: 8px;
        padding: 8px 12px;
        align-items: center;
        border-bottom: 1px solid var(--scm-border-primary) !important;
    }

        .pin-row:hover {
            background-color: var(--scm-row-hover) !important;
        }

        .pin-row.selected {
            background-color: var(--scm-row-selected) !important;
        }

        .pin-row .pin-checkbox {
            width: 16px;
            height: 16px;
            accent-color: var(--scm-accent-blue);
            cursor: pointer;
        }

        .pin-row .pin-num {
            font-weight: 700;
            color: var(--scm-text-highlight) !important;
        }

        .pin-row .pin-attr {
            color: var(--scm-accent-cyan) !important;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .pin-row .pin-mode {
            color: var(--scm-accent-purple) !important;
            font-weight: 600;
            font-size: 0.85rem;
        }

            .pin-row .pin-mode.na {
                color: var(--scm-text-muted) !important;
                font-style: italic;
            }

        .pin-row .pin-thresholdValue {
            color: var(--scm-accent-yellow) !important;
            font-weight: 600;
            font-size: 0.85rem;
        }

        .pin-row .pin-thresholdValue.na {
            color: var(--scm-text-muted) !important;
            font-style: italic;
        }

        .pin-row .btn-group-actions {
            display: flex;
            gap: 4px;
        }

        .pin-row .btn-send, .pin-row .btn-get {
            padding: 4px 8px;
            font-size: 0.6rem;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            min-width: 45px;
        }

        .pin-row .btn-send {
            background-color: var(--scm-btn-bg) !important;
            color: var(--scm-btn-text) !important;
        }

        .pin-row .btn-get {
            background-color: var(--scm-badge-cyan-bg) !important;
            color: var(--scm-accent-cyan) !important;
            border: 1px solid var(--scm-accent-cyan) !important;
        }

        .pin-row .btn-send:hover:not(:disabled) {
            background-color: var(--scm-btn-hover) !important;
            color: #ffffff !important;
        }

        .pin-row .btn-get:hover:not(:disabled) {
            background-color: var(--scm-accent-cyan) !important;
            color: #ffffff !important;
        }

        .pin-row .btn-send:disabled, .pin-row .btn-get:disabled {
            opacity: 0.4;
            cursor: not-allowed;
        }

        .pin-row .btn-send.sending, .pin-row .btn-get.getting {
            background-color: var(--scm-accent-orange) !important;
            color: #ffffff !important;
        }

        .pin-row .btn-send.success, .pin-row .btn-get.success {
            background-color: var(--scm-accent-green) !important;
            color: #ffffff !important;
        }

        .pin-row .btn-send.error, .pin-row .btn-get.error {
            background-color: var(--scm-accent-red) !important;
            color: #ffffff !important;
        }

    /* Channel Info */
    .channel-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

        .channel-info-grid .info-item {
            display: flex;
            flex-direction: column;
            padding: 10px;
            background-color: var(--scm-bg-tertiary);
            border-radius: 6px;
            border: 1px solid var(--scm-border-secondary);
        }

            .channel-info-grid .info-item.full-width {
                grid-column: 1 / -1;
            }

        .channel-info-grid .info-label {
            font-size: 0.7rem;
            color: var(--scm-text-muted);
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .channel-info-grid .info-value {
            font-size: 1rem;
            font-weight: 600;
            color: var(--scm-accent-cyan);
        }

    /* Badges */
    .badge-cluster-count {
        background-color: var(--scm-badge-blue-bg) !important;
        color: var(--scm-accent-blue) !important;
    }

    .badge-adc-count {
        background-color: var(--scm-badge-cyan-bg) !important;
        color: var(--scm-accent-cyan) !important;
    }

    /* Collapse */
    .cluster-content, .adc-content {
        display: none;
    }

        .cluster-content.show, .adc-content.show {
            display: block;
        }

    /* Command Log */
    .command-log-entry {
        padding: 10px 16px;
        border-bottom: 1px solid var(--scm-border-primary) !important;
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 0.75rem;
    }

        .command-log-entry.send {
            background-color: var(--scm-log-send-bg) !important;
        }

        .command-log-entry.recv {
            background-color: var(--scm-log-recv-bg) !important;
        }

        .command-log-entry.error {
            background-color: rgba(239, 68, 68, 0.1) !important;
        }

        .command-log-entry.info {
            background-color: rgba(59, 130, 246, 0.1) !important;
        }

        .command-log-entry .log-badge {
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 0.65rem;
            color: #ffffff !important;
        }

            .command-log-entry .log-badge.send {
                background-color: #1d4ed8 !important;
            }

            .command-log-entry .log-badge.recv {
                background-color: #15803d !important;
            }

            .command-log-entry .log-badge.error {
                background-color: #dc2626 !important;
            }

            .command-log-entry .log-badge.info {
                background-color: #0891b2 !important;
            }

        .command-log-entry .log-topic {
            color: var(--scm-text-muted) !important;
        }

        .command-log-entry .log-timestamp {
            color: var(--scm-text-muted) !important;
        }

        .command-log-entry .log-payload {
            background-color: var(--scm-bg-primary) !important;
            padding: 6px 10px;
            border-radius: 4px;
            color: var(--scm-accent-yellow) !important;
