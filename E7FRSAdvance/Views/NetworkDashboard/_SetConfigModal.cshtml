<script>
    // ============================================================
    // SET CONFIG MODAL - MQTT Configuration
    // Uses Paho MQTT with ports 8083 (WS) / 8883 (WSS)
    // Prefixed with 'scm' to avoid conflicts
    // ============================================================

    var scmData = {
        siteId: null, clusterId: null, adcNumber: null, level: null,
        rawData: [], groupedData: {}, commandLog: [], theme: 'dark', mqttBasePath: null
    };

    // MQTT Config - Matching your existing implementation
    var SCM_MQTT_CONFIG = {
        host: 'energy7.in',
        portWS: 8083,
        portWSS: 8883,
        username: 'energy7.in',
        password: 'k3806557',
        commandTimeout: 10000,
        reconnectDelay: 3000
    };

    var scmMqttClient = null;
    var scmMqttConnected = false;
    var scmMqttConnecting = false;
    var scmSubscribedTopics = {};
    var scmPendingCallbacks = {};

    // ============================================================
    // MQTT CONNECTION
    // ============================================================

    function scmConnectMqtt(callback) {
        if (scmMqttConnected) { if (callback) callback(true); return; }
        if (scmMqttConnecting) {
            var chk = setInterval(function () { if (!scmMqttConnecting) { clearInterval(chk); if (callback) callback(scmMqttConnected); } }, 100);
            return;
        }

        scmMqttConnecting = true;
        scmUpdateMqttStatus('connecting');
        scmLogCommand('INFO', '', 'Connecting to MQTT broker...');

        var isSecure = window.location.protocol === "https:";
        var clientId = "SCM_" + Math.random().toString(36).substring(2, 15) + "_" + Date.now();

        try {
            scmMqttClient = new Paho.Client(mQTT.MQTTUri, mQTT.MQTTPort, clientId);
            scmMqttClient.onConnectionLost = scmOnConnectionLost;
            scmMqttClient.onMessageArrived = scmOnMessageArrived;

            scmMqttClient.connect({
                onSuccess: function () {
                    scmMqttConnected = true; scmMqttConnecting = false;
                    scmUpdateMqttStatus('connected');
                    scmLogCommand('INFO', '', 'Connected successfully');
                    if (callback) callback(true);
                },
                onFailure: function (error) {
                    scmMqttConnected = false; scmMqttConnecting = false;
                    scmUpdateMqttStatus('disconnected');
                    scmLogCommand('ERROR', '', 'Connection failed: ' + error.errorMessage);
                    if (callback) callback(false, error.errorMessage);
                },
                useSSL: isSecure,
                userName: mQTT.MQTTUsername,
                password: mQTT.MQTTPassword,
                cleanSession: true,
                timeout: 30,
                keepAliveInterval: 60
            });
        } catch (e) {
            scmMqttConnecting = false;
            scmUpdateMqttStatus('disconnected');
            scmLogCommand('ERROR', '', 'Connection error: ' + e.message);
            if (callback) callback(false, e.message);
            if (callback) callback(false, e.message);
        }
    }

    //function scmConnectMqtt(callback) {
    //    debugger;
    //    if (scmMqttConnected) { if (callback) callback(true); return; }
    //    if (scmMqttConnecting) {
    //        var chk = setInterval(function () { if (!scmMqttConnecting) { clearInterval(chk); if (callback) callback(scmMqttConnected); } }, 100);
    //        return;
