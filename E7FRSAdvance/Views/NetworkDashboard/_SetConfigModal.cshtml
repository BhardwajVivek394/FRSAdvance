    function scmDisconnectMqtt() {
        if (scmMqttClient && scmMqttConnected) { try { scmMqttClient.disconnect(); } catch (e) { } }
        scmMqttConnected = false; scmMqttConnecting = false; scmSubscribedTopics = {};
        scmUpdateMqttStatus('disconnected');
    }

    function scmReconnectMqtt() {
        scmDisconnectMqtt();
        setTimeout(function () { scmConnectMqtt(); }, 500);
    }

    function scmOnConnectionLost(resp) {
        scmMqttConnected = false; scmSubscribedTopics = {};
        scmUpdateMqttStatus('disconnected');
        if (resp.errorCode !== 0) scmLogCommand('ERROR', '', 'Connection lost: ' + resp.errorMessage);
        for (var k in scmPendingCallbacks) { if (scmPendingCallbacks[k].callback) scmPendingCallbacks[k].callback(false, 'Connection lost'); }
        scmPendingCallbacks = {};
        setTimeout(function () {
            if (!scmMqttConnected && document.getElementById('setConfigModal').classList.contains('show')) {
                scmLogCommand('INFO', '', 'Reconnecting...');
                scmConnectMqtt();
            }
        }, SCM_MQTT_CONFIG.reconnectDelay);
    }

    function scmOnMessageArrived(message) {
        var topic = message.destinationName;
        var payload = message.payloadString;
        scmLogCommand('RECV', topic, payload);

        try {
            var response = JSON.parse(payload);
            var responseId = response.id;
            for (var key in scmPendingCallbacks) {
                var pending = scmPendingCallbacks[key];
                if (pending.responseTopic === topic && pending.expectedId === responseId) {
                    if (scmValidateResponse(response, pending.commandType)) {
                        clearTimeout(pending.timeoutId);
                        delete scmPendingCallbacks[key];
                        if (pending.callback) pending.callback(true, response);
                        return;
                    }
                }
            }
        } catch (e) { scmLogCommand('ERROR', topic, 'Parse error: ' + e.message); }
    }

    function scmValidateResponse(response, commandType) {
        if (!response || response.id === undefined) return false;
        var r = response.response || null;
        if (commandType === 'channel_set') return r === 'channel_set_ok';
        if (commandType === 'channel_get') return r === 'channel_get_ok' || response.mode !== undefined;
        return true;
    }

    function scmUpdateMqttStatus(status) {
        var dot = document.getElementById('scmMqttStatusDot');
        var label = document.getElementById('scmMqttStatusLabel');
        if (!dot || !label) return;
        dot.className = 'mqtt-dot';
        if (status === 'connected') { dot.classList.add('connected'); label.textContent = 'Connected'; }
        else if (status === 'connecting') { dot.classList.add('connecting'); label.textContent = 'Connecting...'; }
        else { label.textContent = 'Disconnected'; }
    }

    function scmSubscribeToTopic(topic, callback) {
        if (scmSubscribedTopics[topic]) { if (callback) callback(true); return; }
        if (!scmMqttConnected || !scmMqttClient) { if (callback) callback(false, 'Not connected'); return; }
        scmMqttClient.subscribe(topic, {
            qos: 1,
            onSuccess: function () { scmSubscribedTopics[topic] = true; if (callback) callback(true); },
            onFailure: function (err) { scmLogCommand('ERROR', topic, 'Subscribe failed'); if (callback) callback(false); }
        });
    }

    function scmPublishMessage(topic, payload) {
        if (!scmMqttConnected || !scmMqttClient) return false;
        try {
            var msg = new Paho.Message(payload);
            msg.destinationName = topic;
            msg.qos = 1;
            scmMqttClient.send(msg);
            scmLogCommand('SEND', topic, payload);
            return true;
        } catch (e) { scmLogCommand('ERROR', topic, 'Publish error'); return false; }
    }

    function scmSendMqttCommand(clusterName, mqttBasePath, command, commandType, callback) {
        if (!scmMqttConnected) {
            scmConnectMqtt(function (connected) {
                if (connected) scmSendMqttCommandInternal(clusterName, mqttBasePath, command, commandType, callback);
                else callback(false, 'Not connected');
            });
            return;
        }
        scmSendMqttCommandInternal(clusterName, mqttBasePath, command, commandType, callback);
    }

    function scmSendMqttCommandInternal(clusterName, mqttBasePath, command, commandType, callback) {
        var basePath = mqttBasePath.replace(/\/+$/, '');
        var cleanCluster = clusterName.replace(/\s+/g, '');
        var responseTopic = basePath + "/" + cleanCluster + "/P";
        var commandTopic = basePath + "/" + cleanCluster + "/S";

        scmSubscribeToTopic(responseTopic, function (success) {
            if (!success) { callback(false, 'Subscribe failed'); return; }
            var cmdStr = JSON.stringify(command);
            var callbackKey = responseTopic + '_' + command.id + '_' + Date.now();
            var timeoutId = setTimeout(function () {
                if (scmPendingCallbacks[callbackKey]) { delete scmPendingCallbacks[callbackKey]; callback(false, 'Timeout'); }
            }, SCM_MQTT_CONFIG.commandTimeout);
            scmPendingCallbacks[callbackKey] = { callback: callback, responseTopic: responseTopic, expectedId: command.id, commandType: commandType, timeoutId: timeoutId };
            if (!scmPublishMessage(commandTopic, cmdStr)) { clearTimeout(timeoutId); delete scmPendingCallbacks[callbackKey]; callback(false, 'Publish failed'); }
        });
    }

    // ============================================================
    // THEME MANAGEMENT (Enhanced - Fixed for all scenarios)
    // ============================================================

    function scmDetectPageTheme() {
        // 1. Check localStorage first - dashboard-theme is your app's key
        var storedTheme = localStorage.getItem('dashboard-theme') ||
            localStorage.getItem('theme') ||
            localStorage.getItem('data-bs-theme') ||
            localStorage.getItem('color-theme') ||
            localStorage.getItem('selectedTheme') ||
            localStorage.getItem('hs_theme');

        if (storedTheme === 'light') return 'light';
        if (storedTheme === 'dark') return 'dark';

        // 2. Check #networkDashboard (your app's main container)
        var dashboard = document.getElementById('networkDashboard');
        if (dashboard) {
            var dashTheme = dashboard.getAttribute('data-theme');
            if (dashTheme === 'light') return 'light';
            if (dashTheme === 'dark') return 'dark';
        }

        // 3. Check document.documentElement (html) classes and attributes
        var html = document.documentElement;
        if (html.classList.contains('light-theme') ||
            html.classList.contains('light') ||
            html.classList.contains('theme-light')) {
            return 'light';
        }
        if (html.getAttribute('data-theme') === 'light' ||
            html.getAttribute('data-bs-theme') === 'light' ||
            html.getAttribute('data-mode') === 'light') {
            return 'light';
        }

        // 4. Check body classes and attributes
        var body = document.body;
        if (body.classList.contains('light-theme') ||
            body.classList.contains('light') ||
            body.classList.contains('theme-light')) {
            return 'light';
        }
        if (body.getAttribute('data-theme') === 'light' ||
            body.getAttribute('data-bs-theme') === 'light' ||
            body.getAttribute('data-mode') === 'light') {
            return 'light';
        }

        // 5. Check CSS variable
        var rootStyle = getComputedStyle(document.documentElement);
        var themeVar = rootStyle.getPropertyValue('--theme-mode') ||
            rootStyle.getPropertyValue('--bs-theme') ||
            rootStyle.getPropertyValue('--color-scheme');
        if (themeVar && themeVar.trim().toLowerCase() === 'light') {
            return 'light';
        }

        // 6. Default to dark
        return 'dark';
    }
    function scmApplyTheme(theme) {
        scmData.theme = theme;
        document.querySelectorAll('.set-config-modal').forEach(function (m) {
            if (theme === 'light') {
                m.classList.add('light-theme');
                m.classList.remove('dark-theme');
            } else {
                m.classList.remove('light-theme');
                m.classList.add('dark-theme');
            }
        });
    }

    function scmSyncTheme() {
        var detectedTheme = scmDetectPageTheme();
        if (detectedTheme !== scmData.theme) {
            scmApplyTheme(detectedTheme);
        }
    }

    function scmSetupThemeObserver() {
        // 1. MutationObserver for DOM attribute changes
        var observerCallback = function (mutations) {
            mutations.forEach(function (mutation) {
                if (mutation.type === 'attributes') {
                    scmSyncTheme();
                }
            });
        };

        var observer = new MutationObserver(observerCallback);
        var observeConfig = {
            attributes: true,
            attributeFilter: ['class', 'data-theme', 'data-bs-theme', 'data-mode', 'data-color-scheme']
        };

        observer.observe(document.documentElement, observeConfig);
        observer.observe(document.body, observeConfig);

        // 2. Listen for localStorage changes (cross-tab sync & some theme systems)
        window.addEventListener('storage', function (e) {
            if (e.key === 'theme' || e.key === 'data-bs-theme' ||
                e.key === 'color-theme' || e.key === 'selectedTheme' || e.key === 'hs_theme') {
                scmSyncTheme();
            }
        });

        // 3. Listen for custom theme events (many libraries dispatch these)
        var themeEventHandler = function () { scmSyncTheme(); };
        window.addEventListener('themeChanged', themeEventHandler);
        window.addEventListener('theme-changed', themeEventHandler);
        window.addEventListener('colorSchemeChange', themeEventHandler);
        document.addEventListener('themeChanged', themeEventHandler);
        document.addEventListener('theme-changed', themeEventHandler);

        // 4. Listen for Bootstrap theme toggle clicks
        document.querySelectorAll('[data-bs-theme-value], [data-theme-toggle], .theme-toggle, .dark-mode-toggle').forEach(function (toggle) {
            toggle.addEventListener('click', function () {
                setTimeout(scmSyncTheme, 50);
                setTimeout(scmSyncTheme, 150);
            });
        });

        // 5. System preference change listener
        if (window.matchMedia) {
            var darkModeQuery = window.matchMedia('(prefers-color-scheme: dark)');
            if (darkModeQuery.addEventListener) {
                darkModeQuery.addEventListener('change', scmSyncTheme);
            } else if (darkModeQuery.addListener) {
                darkModeQuery.addListener(scmSyncTheme);
            }
        }

        // 6. Periodic check as fallback (catches localStorage-only changes)
        setInterval(function () {
            var modal = document.getElementById('setConfigModal');
            if (modal && modal.classList.contains('show')) {
                scmSyncTheme();
            }
        }, 500);
    }

    // ============================================================
    // MODAL FUNCTIONS
    // ============================================================

    function openSetConfigModal(contextName, level, siteId, clusterId, adcNumber, mqttBasePath) {
        debugger;
        var cleanAdcNumber = adcNumber;
        if (adcNumber != null && typeof adcNumber === 'string') cleanAdcNumber = adcNumber.replace('A10-', '').replace('a10-', '');

        scmData.level = level; scmData.siteId = siteId; scmData.clusterId = clusterId; scmData.adcNumber = cleanAdcNumber;
        if (mqttBasePath) scmData.mqttBasePath = mqttBasePath;

        var contextText = '';
        if (level === 'site') contextText = 'Site: ' + contextName + ' (All Clusters & ADCs)';
        else if (level === 'cluster') contextText = 'Cluster: ' + contextName + ' (All ADCs)';
        else if (level === 'adc') contextText = 'ADC-' + adcNumber;
        document.getElementById('scmConfigContextInfo').textContent = contextText;

        // Force theme sync before showing modal
        scmApplyTheme(scmDetectPageTheme());

        var modal = new bootstrap.Modal(document.getElementById('setConfigModal'));
        modal.show();

        // Auto-connect MQTT
        scmConnectMqtt();
        scmLoadConfigData();
    }

    function scmLoadConfigData() {
        document.getElementById('scmConfigLoading').style.display = 'block';
        document.getElementById('scmConfigContent').style.display = 'none';
        document.getElementById('scmConfigError').style.display = 'none';

        $.ajax({
            url: '/NetworkDashboard/SiteId/' + scmData.siteId,
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                if (response && Array.isArray(response) && response.length > 0) {
                    scmData.rawData = response;
                    scmProcessData();
                    scmRenderContent();
                } else {
                    scmShowError('No configuration data found');
                }
            },
            error: function (xhr, status, error) { scmShowError('Error: ' + error); }
        });
    }

    function scmProcessData() {
        scmData.groupedData = {};
        scmData.rawData.forEach(function (item) {
            var clusterId = item.ClusterId, clusterName = item.ClusterName || 'Unknown', adcNumber = item.ADCNumber;

            if (scmData.level === 'cluster' && clusterId != scmData.clusterId) return;
            if (scmData.level === 'adc' && (clusterId != scmData.clusterId || adcNumber != scmData.adcNumber)) return;

            if (!scmData.groupedData[clusterId]) {
                scmData.groupedData[clusterId] = { clusterId: clusterId, clusterName: clusterName, modemId: item.ModemId || '', adcs: {} };
            }
            if (!scmData.groupedData[clusterId].adcs[adcNumber]) {
                scmData.groupedData[clusterId].adcs[adcNumber] = { adcNumber: adcNumber, adcTypeId: item.ADCTypeId, pins: [] };
            }

            var attrName = '';
            if (item.AssetName && item.AttributeName) {
                var attrParts = item.AttributeName.split(' ');
                attrName = item.AssetName + '-' + (attrParts[0] || '');
            }

            var isModeValid = item.Mode !== undefined && item.Mode !== null;
            var isThresholdValid = item.ThresholdValue !== undefined && item.ThresholdValue !== null;
            var canSend = isModeValid && isThresholdValid;

            scmData.groupedData[clusterId].adcs[adcNumber].pins.push({
                pin: item.Pin, attr: attrName, assetTypeName: item.AssetTypeName || '', assetName: item.AssetName || '', attributeName: item.AttributeName || '',
                mode: isModeValid ? item.Mode : 0, thresholdValue: isThresholdValid ? item.ThresholdValue : 100,
                modeDisplay: isModeValid ? item.Mode : 'N/A', thresholdDisplay: isThresholdValid ? item.ThresholdValue : 'N/A',
                canSend: canSend
            });
        });

        // Sort pins
        for (var cId in scmData.groupedData) {
            for (var aNum in scmData.groupedData[cId].adcs) {
                scmData.groupedData[cId].adcs[aNum].pins.sort(function (a, b) { return a.pin - b.pin; });
            }
        }
    }

    function scmShowError(msg) {
        document.getElementById('scmConfigLoading').style.display = 'none';
        document.getElementById('scmConfigContent').style.display = 'none';
        document.getElementById('scmConfigError').style.display = 'block';
        document.getElementById('scmConfigErrorMsg').textContent = msg;
    }

    function scmRetryLoadConfig() { scmLoadConfigData(); }

    function scmRenderContent() {
        document.getElementById('scmConfigLoading').style.display = 'none';
        document.getElementById('scmConfigError').style.display = 'none';
        document.getElementById('scmConfigContent').style.display = 'block';

        var html = '';
        var clusterIds = Object.keys(scmData.groupedData);
        if (clusterIds.length === 0) { html = '<div class="text-center py-5 no-data-text">No data found</div>'; }
        else { clusterIds.forEach(function (cId, i) { html += scmRenderCluster(scmData.groupedData[cId], i); }); }

        document.getElementById('scmConfigContent').innerHTML = html;

        if (scmData.level === 'cluster' || scmData.level === 'adc') {
            setTimeout(function () {
                var fc = document.querySelector('.cluster-content'); if (fc) { fc.classList.add('show'); var a = fc.previousElementSibling.querySelector('.arrow'); if (a) a.classList.add('expanded'); }
                if (scmData.level === 'adc') { var fa = document.querySelector('.adc-content'); if (fa) { fa.classList.add('show'); var aa = fa.previousElementSibling.querySelector('.arrow'); if (aa) aa.classList.add('expanded'); } }
            }, 100);
        }
        scmUpdateSelectedCount();
    }

    function scmRenderCluster(cluster, index) {
        var adcNums = Object.keys(cluster.adcs), adcCount = adcNums.length, pinCount = 0, sendableCount = 0;
        adcNums.forEach(function (an) { var pins = cluster.adcs[an].pins; pinCount += pins.length; pins.forEach(function (p) { if (p.canSend) sendableCount++; }); });

        var html = '<div class="cluster-card" data-cluster-name="' + cluster.clusterName + '">' +
            '<div class="cluster-header" onclick="scmToggleCluster(' + index + ')">' +
            '<input type="checkbox" class="form-check-input cluster-checkbox" onclick="scmToggleClusterSel(' + index + ', event)">' +
            '<div class="cluster-icon"><i class="bi bi-router"></i></div>' +
            '<div class="flex-grow-1"><div class="cluster-name">' + cluster.clusterName + '</div><div class="cluster-info">Modem: ' + cluster.modemId + '</div></div>' +
            '<span class="badge badge-adc-count me-2">' + adcCount + ' ADCs</span>' +
            '<span class="badge badge-cluster-count me-2">' + pinCount + ' Pins (' + sendableCount + ' sendable)</span>' +
            '<button class="btn btn-outline-primary btn-sm select-all-btn" onclick="scmSelectAllCluster(' + index + ', event)">Select All</button>' +
            '<span class="arrow ms-2">▶</span></div>' +
            '<div class="cluster-content" id="scmCluster_' + index + '">';

        adcNums.forEach(function (an, ai) { html += scmRenderAdc(cluster.adcs[an], index, ai, cluster); });
        html += '</div></div>';
        return html;
    }

    function scmRenderAdc(adc, ci, ai, cluster) {
        var pinCount = adc.pins.length, sendableCount = adc.pins.filter(function (p) { return p.canSend; }).length;

        var html = '<div class="adc-card" data-adc-number="' + adc.adcNumber + '">' +
            '<div class="adc-header" onclick="scmToggleAdc(' + ci + ', ' + ai + ')">' +
            '<input type="checkbox" class="form-check-input adc-checkbox" onclick="scmToggleAdcSel(' + ci + ', ' + ai + ', event)">' +
            '<div class="adc-icon"><i class="bi bi-cpu"></i></div>' +
            '<div class="flex-grow-1"><div class="adc-name">ADC-' + adc.adcNumber + '</div><div class="adc-info">Type: ' + (adc.adcTypeId || '-') + '</div></div>' +
            '<span class="badge badge-cluster-count me-2">' + pinCount + ' Pins (' + sendableCount + ' sendable)</span>' +
            '<button class="btn btn-outline-info btn-sm select-all-btn" onclick="scmSelectAllAdc(' + ci + ', ' + ai + ', event)">Select All</button>' +
            '<span class="arrow ms-2">▶</span></div>' +
            '<div class="adc-content" id="scmAdc_' + ci + '_' + ai + '">' +
            '<div class="pin-table-container"><div class="pin-table-header"><div></div><div>PIN</div><div>ATTR</div><div>MODE</div><div>THRESHOLD</div><div>ACTIONS</div></div>';

        adc.pins.forEach(function (pin, pi) { html += scmRenderPin(pin, ci, ai, pi, adc.adcNumber, cluster); });
        html += '</div></div></div>';
        return html;
    }

    function scmRenderPin(pin, ci, ai, pi, adcNum, cluster) {
        
        var pinId = 'scmPin_' + ci + '_' + ai + '_' + pi;
        var sendDis = pin.canSend ? '' : ' disabled title="Mode or Threshold not configured"';
        var modeClass = 'pin-mode' + (pin.modeDisplay === 'N/A' ? ' na' : '');
        var threshClass = 'pin-thresholdValue' + (pin.thresholdDisplay === 'N/A' ? ' na' : '');

        return '<div class="pin-row" id="' + pinId + '" data-pin-number="' + pin.pin + '" data-adc-number="' + adcNum + '" data-cluster-name="' + cluster.clusterName + '" data-mqtt-base="' + (scmData.mqttBasePath || '') + '" data-mode="' + pin.mode + '" data-thresholdValue="' + pin.thresholdValue + '" data-can-send="' + pin.canSend + '">' +
            '<div><input type="checkbox" class="pin-checkbox" onchange="scmPinCheck(this)"></div>' +
            '<div class="pin-num">' + pin.pin + '</div>' +
            '<div class="pin-attr" title="' + pin.assetTypeName + ': ' + pin.assetName + ' - ' + pin.attributeName + '">' + pin.attr + '</div>' +
            '<div class="' + modeClass + '" id="scmMode_' + pinId + '">' + pin.modeDisplay + '</div>' +
            '<div class="' + threshClass + '" id="scmThresh_' + pinId + '">' + pin.thresholdDisplay + '</div>' +
            '<div class="btn-group-actions">' +
            '<button class="btn-send" id="scmBtnSend_' + pinId + '"' + sendDis + ' onclick="scmSendPin(\'' + pinId + '\')">Send</button>' +
            '<button class="btn-get" id="scmBtnGet_' + pinId + '" onclick="scmGetPin(\'' + pinId + '\')">Get</button>' +
            '</div></div>';
    }

    // Toggle & Selection
    function scmToggleCluster(i) { var c = document.getElementById('scmCluster_' + i); c.classList.toggle('show'); c.previousElementSibling.querySelector('.arrow').classList.toggle('expanded'); }
    function scmToggleAdc(ci, ai) { var c = document.getElementById('scmAdc_' + ci + '_' + ai); c.classList.toggle('show'); c.previousElementSibling.querySelector('.arrow').classList.toggle('expanded'); }
    function scmToggleClusterSel(i, e) { e.stopPropagation(); var chk = e.target.checked; var card = e.target.closest('.cluster-card'); card.querySelectorAll('.adc-checkbox').forEach(function (c) { c.checked = chk; }); card.querySelectorAll('.pin-checkbox').forEach(function (c) { c.checked = chk; c.closest('.pin-row').classList.toggle('selected', chk); }); scmUpdateSelectedCount(); }
    function scmToggleAdcSel(ci, ai, e) { e.stopPropagation(); var chk = e.target.checked; e.target.closest('.adc-card').querySelectorAll('.pin-checkbox').forEach(function (c) { c.checked = chk; c.closest('.pin-row').classList.toggle('selected', chk); }); scmUpdateSelectedCount(); }
    function scmPinCheck(cb) { cb.closest('.pin-row').classList.toggle('selected', cb.checked); scmUpdateSelectedCount(); }
    function scmSelectAllCluster(i, e) { e.stopPropagation(); var card = e.target.closest('.cluster-card'); card.querySelector('.cluster-checkbox').checked = true; card.querySelectorAll('.adc-checkbox').forEach(function (c) { c.checked = true; }); card.querySelectorAll('.pin-checkbox').forEach(function (c) { c.checked = true; c.closest('.pin-row').classList.add('selected'); }); scmUpdateSelectedCount(); }
    function scmSelectAllAdc(ci, ai, e) { e.stopPropagation(); var card = e.target.closest('.adc-card'); card.querySelector('.adc-checkbox').checked = true; card.querySelectorAll('.pin-checkbox').forEach(function (c) { c.checked = true; c.closest('.pin-row').classList.add('selected'); }); scmUpdateSelectedCount(); }
    function scmUpdateSelectedCount() {
        var sel = document.querySelectorAll('#scmConfigContent .pin-checkbox:checked').length;
        var sendable = document.querySelectorAll('#scmConfigContent .pin-row[data-can-send="true"]').length;
        document.getElementById('scmSelectedCount').textContent = sel + ' selected';
        document.getElementById('scmSendableCount').textContent = sendable + ' sendable';
    }

    // Send/Get Pin
    function scmSendPin(pinId) {
        
        var row = document.getElementById(pinId), btn = document.getElementById('scmBtnSend_' + pinId);
        if (!scmMqttConnected) { alert('Connecting...'); scmConnectMqtt(function (ok) { if (ok) scmSendPin(pinId); }); return; }
        if (row.getAttribute('data-can-send') !== 'true') { alert('Mode or Threshold not configured'); return; }

        var cmd = { id: parseInt(row.getAttribute('data-adc-number')), channel_set: parseInt(row.getAttribute('data-pin-number')), mode: parseInt(row.getAttribute('data-mode')) || 0, threshold: parseInt(row.getAttribute('data-thresholdValue')) || 0 };
        btn.classList.add('sending'); btn.textContent = '...';

        scmSendMqttCommand(row.getAttribute('data-cluster-name'), row.getAttribute('data-mqtt-base') || scmData.mqttBasePath, cmd, 'channel_set', function (ok) {
            btn.classList.remove('sending'); btn.classList.add(ok ? 'success' : 'error'); btn.textContent = ok ? '✓' : '✗';
            setTimeout(function () { btn.classList.remove('success', 'error'); btn.textContent = 'Send'; }, 2000);
        });
    }

    function scmGetPin(pinId) {
        debugger;
        var row = document.getElementById(pinId), btn = document.getElementById('scmBtnGet_' + pinId);
        if (!scmMqttConnected) { alert('Connecting...'); scmConnectMqtt(function (ok) { if (ok) scmGetPin(pinId); }); return; }

        var cmd = { id: parseInt(row.getAttribute('data-adc-number')), channel_get: parseInt(row.getAttribute('data-pin-number')) };
        btn.classList.add('getting'); btn.textContent = '...';

        scmSendMqttCommand(row.getAttribute('data-cluster-name'), row.getAttribute('data-mqtt-base') || scmData.mqttBasePath, cmd, 'channel_get', function (ok, resp) {
            btn.classList.remove('getting'); btn.classList.add(ok ? 'success' : 'error'); btn.textContent = ok ? '✓' : '✗';
            if (ok && resp) {
                var modeEl = document.getElementById('scmMode_' + pinId), threshEl = document.getElementById('scmThresh_' + pinId);
                if (resp.mode !== undefined && modeEl) { modeEl.textContent = resp.mode; modeEl.classList.remove('na'); row.setAttribute('data-mode', resp.mode); }
                if (resp.thresholdValue !== undefined && threshEl) { threshEl.textContent = resp.thresholdValue; threshEl.classList.remove('na'); row.setAttribute('data-thresholdValue', resp.thresholdValue); }
                scmShowChannelInfo(row.getAttribute('data-adc-number'), row.getAttribute('data-pin-number'), resp);
            }
            setTimeout(function () { btn.classList.remove('success', 'error'); btn.textContent = 'Get'; }, 2000);
        });
    }

    function scmFormatTimestamp(ts) {
        if (!ts) return '-';
        var tsMs = (ts < 1e12) ? ts * 1000 : ts;
        var d = new Date(tsMs);
        if (isNaN(d.getTime())) return 'Invalid (' + ts + ')';
        var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
        return d.getUTCFullYear() + '-' + pad(d.getUTCMonth() + 1) + '-' + pad(d.getUTCDate()) +
            ' ' + pad(d.getUTCHours()) + ':' + pad(d.getUTCMinutes()) + ':' + pad(d.getUTCSeconds());
    }

    function scmShowChannelInfo(adcId, ch, resp) {
        document.getElementById('scmInfoAdcId').textContent = adcId;
        document.getElementById('scmInfoChannel').textContent = ch;
        document.getElementById('scmInfoMode').textContent = resp.mode !== undefined ? resp.mode : '-';
        var threshVal = resp.thresholdValue !== undefined ? resp.thresholdValue : (resp.threshold !== undefined ? resp.threshold : '-');
        document.getElementById('scmInfoThreshold').textContent = threshVal;
        document.getElementById('scmInfoOffset').textContent = resp.offset !== undefined ? resp.offset : '-';
        document.getElementById('scmInfoDiv').textContent = resp.div !== undefined ? resp.div : '-';
        document.getElementById('scmInfoMul').textContent = resp.mul !== undefined ? resp.mul : '-';
        document.getElementById('scmInfoTimestamp').textContent = scmFormatTimestamp(resp.ts);
        document.getElementById('scmInfoResponse').textContent = resp.response || '-';
        scmApplyTheme(scmDetectPageTheme());
        new bootstrap.Modal(document.getElementById('scmChannelInfoModal')).show();
    }

    // Bulk Operations
    function scmSendSelectedToDevice() {
        if (!scmMqttConnected) { alert('Connecting...'); scmConnectMqtt(); return; }
        var rows = []; document.querySelectorAll('#scmConfigContent .pin-checkbox:checked').forEach(function (cb) { var r = cb.closest('.pin-row'); if (r.getAttribute('data-can-send') === 'true') rows.push(r); });
        if (rows.length === 0) { alert('No sendable pins selected'); return; }
        scmBulkSend(rows, 0, 'set');
    }

    function scmGetSelectedFromDevice() {
        if (!scmMqttConnected) { alert('Connecting...'); scmConnectMqtt(); return; }
        var rows = []; document.querySelectorAll('#scmConfigContent .pin-checkbox:checked').forEach(function (cb) { rows.push(cb.closest('.pin-row')); });
        if (rows.length === 0) { alert('No pins selected'); return; }
        scmBulkSend(rows, 0, 'get');
    }

    function scmSendAllToDevice() {
        if (!scmMqttConnected) { alert('Connecting...'); scmConnectMqtt(); return; }
        var rows = []; document.querySelectorAll('#scmConfigContent .pin-row[data-can-send="true"]').forEach(function (r) { rows.push(r); });
        if (rows.length === 0) { alert('No sendable pins'); return; }
        if (!confirm('Send to ' + rows.length + ' pin(s)?')) return;
        scmBulkSend(rows, 0, 'set');
    }

    function scmBulkSend(rows, i, type) {
        
        if (i >= rows.length) { document.getElementById('scmCommandStatus').textContent = 'Done'; document.getElementById('scmCommandStatus').className = 'badge bg-success'; return; }
        document.getElementById('scmCommandStatus').textContent = (type === 'get' ? 'Getting' : 'Sending') + ' ' + (i + 1) + '/' + rows.length;
        document.getElementById('scmCommandStatus').className = 'badge bg-warning';

        var row = rows[i], pinId = row.id, adcNum = row.getAttribute('data-adc-number'), pinNum = row.getAttribute('data-pin-number'), cluster = row.getAttribute('data-cluster-name'), mqttBasePath = row.getAttribute('data-mqtt-base');
        var cmd, cmdType, btn;

        if (type === 'set') {
            cmd = { id: parseInt(adcNum), channel_set: parseInt(pinNum), mode: parseInt(row.getAttribute('data-mode')) || 0, threshold: parseInt(row.getAttribute('data-thresholdValue')) || 0 };
            cmdType = 'channel_set'; btn = document.getElementById('scmBtnSend_' + pinId);
        } else {
            cmd = { id: parseInt(adcNum), channel_get: parseInt(pinNum) };
            cmdType = 'channel_get'; btn = document.getElementById('scmBtnGet_' + pinId);
        }

        if (btn) { btn.classList.add(type === 'set' ? 'sending' : 'getting'); btn.textContent = '...'; }

        scmSendMqttCommand(cluster, mqttBasePath, cmd, cmdType, function (ok, resp) {
            if (btn) {
                btn.classList.remove('sending', 'getting'); btn.classList.add(ok ? 'success' : 'error'); btn.textContent = ok ? '✓' : '✗';
                if (ok && type === 'get' && resp) {
                    var modeEl = document.getElementById('scmMode_' + pinId), threshEl = document.getElementById('scmThresh_' + pinId);
                    if (resp.mode !== undefined && modeEl) { modeEl.textContent = resp.mode; modeEl.classList.remove('na'); }
                    if (resp.thresholdValue !== undefined && threshEl) { threshEl.textContent = resp.thresholdValue; threshEl.classList.remove('na'); }
                }
                setTimeout(function () { btn.classList.remove('success', 'error'); btn.textContent = type === 'set' ? 'Send' : 'Get'; }, 1000);
            }
            setTimeout(function () { scmBulkSend(rows, i + 1, type); }, 200);
        });
    }

    // Log
    function scmLogCommand(type, topic, payload) {
        scmData.commandLog.unshift({ type: type, topic: topic, payload: payload, timestamp: new Date().toLocaleTimeString() });
        if (scmData.commandLog.length > 100) scmData.commandLog.pop();
        var info = document.getElementById('scmLastCommandInfo'); if (info) info.textContent = type + ': ' + (topic ? topic.substr(-30) : (payload || '').substr(0, 30));
        if (document.getElementById('scmCommandLogModal') && document.getElementById('scmCommandLogModal').classList.contains('show')) scmRenderLog();
    }

    function scmRenderLog() {
        var html = '';
        scmData.commandLog.slice(0, 50).forEach(function (e) {
            var badgeText = { 'SEND': '→ TX', 'RECV': '← RX', 'ERROR': '✗ ERR', 'INFO': 'ℹ INFO' }[e.type] || e.type;
            html += '<div class="command-log-entry ' + e.type.toLowerCase() + '"><div class="d-flex justify-content-between"><span class="log-badge ' + e.type.toLowerCase() + '">' + badgeText + '</span><small class="log-timestamp">' + e.timestamp + '</small></div>' + (e.topic ? '<small class="log-topic d-block mt-1">' + e.topic + '</small>' : '') + '<div class="log-payload">' + e.payload + '</div></div>';
        });
        document.getElementById('scmCommandLogEntries').innerHTML = html || '<div class="text-center py-4 no-data-text">No commands yet</div>';
    }

    function scmShowCommandLog() {
        // Force theme sync before showing modal
        scmApplyTheme(scmDetectPageTheme());
        scmRenderLog();
        new bootstrap.Modal(document.getElementById('scmCommandLogModal')).show();
    }
    function scmClearCommandLog() { scmData.commandLog = []; scmRenderLog(); }

    // ============================================================
    // INITIALIZATION
    // ============================================================
    $(document).ready(function () {
        // Initialize theme observer
        scmSetupThemeObserver();

        // Initial theme sync
        scmApplyTheme(scmDetectPageTheme());
    });

    $(window).on('beforeunload', function () { if (scmMqttClient && scmMqttConnected) try { scmMqttClient.disconnect(); } catch (e) { } });
</script>
