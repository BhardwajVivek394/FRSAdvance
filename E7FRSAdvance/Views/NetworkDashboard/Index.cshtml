        setElementValue('modemClusterNameBS', modem.clusterName);
        setElementValue('modemMqttBaseBS', modem.mqttBase);
        setElementValue('modemTcpSendPortBS', modem.tcpSendPort);
        setElementValue('modemTcpRecvPortBS', modem.tcpRecvPort);
