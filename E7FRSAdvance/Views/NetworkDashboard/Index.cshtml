<div class="modal fade" id="mqttBrokerModal" tabindex="-1" aria-labelledby="mqttBrokerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content mqtt-modal-content">

            <!-- Header -->
            <div class="mqtt-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="mqtt-header-icon">
                        <i class="bi bi-broadcast"></i>
                    </div>
                    <div>
                        <h5 class="mqtt-title mb-0">MQTT Broker Console</h5>
                        <div class="mqtt-device-subtitle" id="mqttDeviceSubtitle">
                            <span id="mqttClusterName">-</span> | <span id="mqttDeviceId">-</span>
                        </div>
                    </div>
                    <span class="mqtt-conn-badge" id="mqttConnectionBadge">
                        <span class="mqtt-conn-indicator" id="mqttConnDot"></span>
                        <span id="mqttConnStatus">Disconnected</span>
                    </span>
                </div>
                <button type="button" class="mqtt-close-btn" data-bs-dismiss="modal" aria-label="Close">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="mqtt-body">
                <!-- Top Row: Connection + Device Info -->
                <div class="mqtt-top-row">
                    <!-- Connection Settings -->
                    <div class="mqtt-conn-card">
                        <div class="mqtt-conn-fields">
                            <div class="mqtt-field">
                                <label>Host</label>
                                <input type="text" id="mqttBrokerHost" value="energy7.in" readonly>
                            </div>
                            <div class="mqtt-field mqtt-field-sm">
                                <label>Port</label>
                                <input type="text" id="mqttBrokerPort" value="8083" readonly>
                            </div>
                            <div class="mqtt-field">
                                <label>Username</label>
                                <input type="text" id="mqttBrokerUser" value="energy7.in" readonly>
                            </div>
                            <button type="button" class="mqtt-connect-btn" id="mqttConnectBtn" onclick="toggleMqttBrokerConnection()">
                                <i class="bi bi-plug" id="mqttConnectIcon"></i>
                                <span id="mqttConnectText">Connect</span>
                            </button>
                        </div>
                    </div>

                    <!-- Device Badge -->
                    <div class="mqtt-device-badge" id="mqttDeviceInfo">
                        <div class="mqtt-device-icon-box" id="mqttDeviceIcon">
                            <i class="bi bi-router" id="mqttDeviceIconInner"></i>
                        </div>
                        <div>
                            <div class="mqtt-device-name" id="mqttDeviceName">Device</div>
                            <span class="badge mqtt-type-badge" id="mqttDeviceTypeBadgeInner">MODEM</span>
                        </div>
                    </div>
                </div>

                <!-- Topics Row -->
                <div class="mqtt-topics-row">
                    <!-- Subscribe Topic -->
                    <div class="mqtt-topic-box mqtt-topic-sub">
                        <div class="mqtt-topic-icon">
                            <i class="bi bi-arrow-down-circle-fill"></i>
                        </div>
                        <div class="mqtt-topic-info">
                            <div class="mqtt-topic-label">
                                Subscribe (Receive /P)
                                <span class="mqtt-topic-status" id="mqttSubStatusBadge">
                                    <span class="status-dot" id="mqttSubDot"></span>
                                    <span id="mqttSubStatusText">Not Subscribed</span>
                                </span>
                            </div>
                            <div class="mqtt-topic-path" id="mqttSubTopicValue">-</div>
                        </div>
                        <button type="button" class="mqtt-topic-btn" id="mqttSubscribeBtn" onclick="toggleMqttSubscription()" disabled>
                            <i class="bi bi-broadcast" id="mqttSubBtnIcon"></i>
                            <span id="mqttSubBtnText">Subscribe</span>
                        </button>
                    </div>

                    <!-- Publish Topic -->
                    <div class="mqtt-topic-box mqtt-topic-pub">
                        <div class="mqtt-topic-icon">
                            <i class="bi bi-arrow-up-circle-fill"></i>
                        </div>
                        <div class="mqtt-topic-info">
                            <div class="mqtt-topic-label">
                                Publish (Send /S)
                                <span class="mqtt-topic-status mqtt-pub-ready">
                                    <span class="status-dot" id="mqttPubDot"></span>
                                    <span id="mqttPubStatusText">Ready</span>
                                </span>
                            </div>
                            <div class="mqtt-topic-path" id="mqttPubTopicValue">-</div>
                        </div>
                        <div class="mqtt-publish-input">
                            <input type="text" id="mqttPublishInput" placeholder="Enter command..."
                                   onkeypress="if(event.key==='Enter') publishMqttMessage()">
                            <button type="button" id="mqttPublishBtn" onclick="publishMqttMessage()" disabled>
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Quick Commands (Collapsible) - Modem -->
                <div class="mqtt-quick-section" id="modemQuickCommandsSection" style="display: none;">
                    <div class="mqtt-quick-header" onclick="toggleQuickCommands('modem')">
                        <span><i class="bi bi-lightning-fill me-2"></i>Modem Quick Commands</span>
                        <i class="bi bi-chevron-down" id="modemQuickCmdToggleIcon"></i>
                    </div>
                    <div class="mqtt-quick-body" id="modemQuickCommandsBody">
                        <button type="button" class="mqtt-cmd-btn" onclick="sendModemQuickCommand('ZL+CSQ?')" title="Get Signal Strength">
                            <i class="bi bi-reception-4"></i> Signal
                        </button>
                        <button type="button" class="mqtt-cmd-btn" onclick="sendModemQuickCommand('ZL+RESTART=1')" title="Restart Modem">
                            <i class="bi bi-arrow-clockwise"></i> Restart
                        </button>
                        <button type="button" class="mqtt-cmd-btn" onclick="sendModemQuickCommand('ZLAN+SYSRESTORE=1')" title="Sync Store">
                            <i class="bi bi-save"></i> Sync Store
                        </button>
                        <button type="button" class="mqtt-cmd-btn mqtt-cmd-danger" onclick="sendModemQuickCommand('ZL+ClearOfflStorData=1')" title="Clear Data">
                            <i class="bi bi-trash"></i> Clear Data
                        </button>
                        <button type="button" class="mqtt-cmd-btn" onclick="sendModemQuickCommand('ZL+VER?')" title="Get Version">
                            <i class="bi bi-info-circle"></i> Version
                        </button>
                        <button type="button" class="mqtt-cmd-btn" onclick="sendModemQuickCommand('ZL+IMEI?')" title="Get IMEI">
                            <i class="bi bi-upc-scan"></i> IMEI
                        </button>
                    </div>
                </div>

                <!-- Quick Commands - A10 -->
                <div class="mqtt-quick-section" id="a10QuickCommandsSection" style="display: none;">
                    <div class="mqtt-quick-header" onclick="toggleQuickCommands('a10')">
                        <span><i class="bi bi-lightning-fill me-2"></i>A10 Quick Commands</span>
                        <i class="bi bi-chevron-down" id="a10QuickCmdToggleIcon"></i>
                    </div>
                    <div class="mqtt-quick-body" id="a10QuickCommandsBody">
                        <button type="button" class="mqtt-cmd-btn" onclick="sendA10QuickCommand('time_get')" title="Get Time">
                            <i class="bi bi-clock"></i> Time Get
                        </button>
                        <button type="button" class="mqtt-cmd-btn" onclick="sendA10QuickCommand('fw_get')" title="Get Firmware">
                            <i class="bi bi-cpu"></i> Firmware
                        </button>
                        <button type="button" class="mqtt-cmd-btn" onclick="sendA10QuickCommand('update')" title="Update">
                            <i class="bi bi-arrow-repeat"></i> Update
                        </button>
                        <button type="button" class="mqtt-cmd-btn" onclick="sendA10QuickCommand('channel_get_all')" title="Get Channels">
                            <i class="bi bi-collection"></i> Channels
                        </button>
                        <button type="button" class="mqtt-cmd-btn" onclick="sendA10QuickCommand('event_get', 1)" title="Event Pin 1">
                            <i class="bi bi-list-ul"></i> Event P1
                        </button>
                        <button type="button" class="mqtt-cmd-btn mqtt-cmd-danger" onclick="sendA10QuickCommand('event_clear', 1)" title="Clear Pin 1">
                            <i class="bi bi-eraser"></i> Clear P1
                        </button>
                    </div>
                </div>

                <!-- CONSOLE SECTION - ENHANCED WITH ZOOM & FULLSCREEN -->
                <div class="mqtt-console-section">
                    <div class="mqtt-console-header">
                        <div class="mqtt-console-title">
                            <i class="bi bi-terminal-fill"></i>
                            Message Console
                        </div>
                        <div class="mqtt-console-controls">
                            <span class="mqtt-msg-counter">
                                <span id="mqttMsgCount">0</span> messages
                            </span>

                            <!-- Auto-scroll toggle -->
                            <button type="button" class="mqtt-console-btn" id="btnAutoScroll" onclick="toggleAutoScroll()" title="Toggle Auto-scroll">
                                <i class="bi bi-arrow-down-circle" id="autoScrollIcon"></i>
                            </button>

                            <!-- Expand/Collapse Console -->
                            <button type="button" class="mqtt-console-btn mqtt-expand" id="btnExpandConsole" onclick="toggleConsoleExpand()" title="Expand Console">
                                <i class="bi bi-arrows-expand" id="expandIcon"></i>
                            </button>

                            <!-- Fullscreen -->
                            <button type="button" class="mqtt-console-btn mqtt-fullscreen" id="btnFullscreen" onclick="toggleFullscreen()" title="Fullscreen">
                                <i class="bi bi-fullscreen" id="fullscreenIcon"></i>
                            </button>

                            <!-- Clear Console -->
                            <button type="button" class="mqtt-console-btn mqtt-clear" onclick="clearMqttConsole()" title="Clear Console">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                    <div class="mqtt-console-display" id="mqttBrokerLog">
                        <div class="mqtt-log-entry mqtt-log-system">
                            <span class="log-time">--:--:--</span>
                            <span class="log-badge log-info">INFO</span>
                            <span class="log-message">MQTT Console Ready. Click "Connect" to start.</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="mqtt-footer">
                <div class="mqtt-stats">
                    <div class="mqtt-stat mqtt-stat-in">
                        <i class="bi bi-arrow-down-circle-fill"></i>
                        <span id="mqttInCount">0</span> IN
                    </div>
                    <div class="mqtt-stat mqtt-stat-out">
                        <i class="bi bi-arrow-up-circle-fill"></i>
                        <span id="mqttOutCount">0</span> OUT
                    </div>
                    <div class="mqtt-stat mqtt-stat-err">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span id="mqttErrCount">0</span> ERR
                    </div>
                </div>
                <button type="button" class="mqtt-close-footer-btn" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

