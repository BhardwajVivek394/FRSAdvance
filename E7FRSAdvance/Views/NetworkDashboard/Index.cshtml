    function getSignalInfo(rssi) {
        if (rssi === 99) return { description: 'Unknown', dbm: 'Not detectable' };
        if (rssi === 0) return { description: 'No signal', dbm: '-113 dBm or less' };
        if (rssi === 1) return { description: 'Very weak', dbm: '-111 dBm' };
        if (rssi <= 9) return { description: 'Weak', dbm: '-109 to -95 dBm' };
        if (rssi <= 14) return { description: 'Fair', dbm: '-93 to -85 dBm' };
        if (rssi <= 19) return { description: 'Good', dbm: '-83 to -75 dBm' };
        return { description: 'Excellent', dbm: '-73 dBm or greater' };
    }
    function escapeHtml(text) {
        var div = document.createElement('div');
