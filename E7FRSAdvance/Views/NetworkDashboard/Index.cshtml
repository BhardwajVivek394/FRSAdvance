    // Enhanced log function
    function logMqttBroker(message, type) {
        var log = document.getElementById('mqttBrokerLog');
        if (!log) return;

        var now = new Date();
        var timeStr = now.toLocaleTimeString('en-US', { hour12: false });

        // Map type to badge class and text
        var badgeClass = 'log-info';
        var badgeText = 'INFO';
        switch (type) {
            case 'send':
            case 'out':
                badgeClass = 'log-send';
                badgeText = 'SEND';
                break;
            case 'recv':
            case 'in':
                badgeClass = 'log-recv';
                badgeText = 'RECV';
                break;
            case 'error':
            case 'err':
                badgeClass = 'log-error';
                badgeText = 'ERROR';
                break;
            case 'warn':
            case 'warning':
            case 'sys':
                badgeClass = 'log-warn';
                badgeText = 'SYS';
                break;
            default:
                badgeClass = 'log-info';
                badgeText = 'INFO';
        }

        var entry = document.createElement('div');
        entry.className = 'mqtt-log-entry mqtt-log-' + type;

        // Escape HTML but preserve formatting
        var escapedMsg = escapeHtmlConsole(message);

        // If message has newlines (formatted JSON), preserve them
        if (message && message.indexOf('\n') !== -1) {
            escapedMsg = '<pre style="margin:0;font-family:inherit;background:transparent;padding:0;border:none;color:inherit;font-size:inherit;">' + escapedMsg + '</pre>';
        }

        entry.innerHTML =
            '<span class="log-time">' + timeStr + '</span>' +
            '<span class="log-badge ' + badgeClass + '">' + badgeText + '</span>' +
            '<span class="log-message">' + escapedMsg + '</span>';

        log.appendChild(entry);

        // Update message count
        var countEl = document.getElementById('mqttMsgCount');
        if (countEl) {
            var count = log.querySelectorAll('.mqtt-log-entry').length;
            countEl.textContent = count;
        }

        // Auto scroll if enabled
        scrollConsoleToBottom();

        // Limit log entries to prevent memory issues
        while (log.children.length > 500) {
            log.removeChild(log.firstChild);
        }
    }

    function escapeHtmlConsole(text) {
        if (!text) return '';
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

