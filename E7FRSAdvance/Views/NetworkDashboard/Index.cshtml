    // ================================================================
    // UI UPDATE
    // ================================================================
    function updateMqttBrokerUI() {
        var isConnected = mqttBrokerClient && mqttBrokerClient.isConnected && mqttBrokerClient.isConnected();

        // Update connection indicator
        var connDot = document.getElementById('mqttConnDot');
        var connStatus = document.getElementById('mqttConnStatus');
        var connBadge = document.getElementById('mqttConnectionBadge');

        if (connDot) {
            if (isConnected) {
                connDot.classList.add('connected');
            } else {
                connDot.classList.remove('connected');
            }
        }
        if (connStatus) {
            connStatus.textContent = isConnected ? 'Connected' : 'Disconnected';
        }

        // Update connect button
        var connectBtn = document.getElementById('mqttConnectBtn');
        var connectIcon = document.getElementById('mqttConnectIcon');
        var connectText = document.getElementById('mqttConnectText');

        if (connectBtn) {
            if (isConnected) {
                connectBtn.classList.add('connected');
                if (connectIcon) {
                    connectIcon.classList.remove('bi-plug');
                    connectIcon.classList.add('bi-plug-fill');
                }
                if (connectText) connectText.textContent = 'Disconnect';
            } else {
                connectBtn.classList.remove('connected');
                if (connectIcon) {
                    connectIcon.classList.remove('bi-plug-fill');
                    connectIcon.classList.add('bi-plug');
                }
                if (connectText) connectText.textContent = 'Connect';
            }
        }

        // Update subscribe button
        var subBtn = document.getElementById('mqttSubscribeBtn');
        if (subBtn) {
            subBtn.disabled = !isConnected;
        }

        // Update publish button
        var pubBtn = document.getElementById('mqttPublishBtn');
        if (pubBtn) {
            pubBtn.disabled = !isConnected || !mqttBrokerSubscribed;
        }

        // Update subscribe status
        var subStatusBadge = document.getElementById('mqttSubStatusBadge');
        var subDot = document.getElementById('mqttSubDot');
        var subStatusText = document.getElementById('mqttSubStatusText');
        var subBtnText = document.getElementById('mqttSubBtnText');
        var subBtnIcon = document.getElementById('mqttSubBtnIcon');

        if (mqttBrokerSubscribed) {
            if (subStatusBadge) subStatusBadge.classList.add('subscribed');
            if (subStatusText) subStatusText.textContent = 'Subscribed';
            if (subBtnText) subBtnText.textContent = 'Unsubscribe';
            if (subBtnIcon) {
                subBtnIcon.classList.remove('bi-broadcast');
                subBtnIcon.classList.add('bi-broadcast-pin');
            }
        } else {
            if (subStatusBadge) subStatusBadge.classList.remove('subscribed');
            if (subStatusText) subStatusText.textContent = 'Not Subscribed';
            if (subBtnText) subBtnText.textContent = 'Subscribe';
            if (subBtnIcon) {
                subBtnIcon.classList.remove('bi-broadcast-pin');
                subBtnIcon.classList.add('bi-broadcast');
            }
        }
    }

