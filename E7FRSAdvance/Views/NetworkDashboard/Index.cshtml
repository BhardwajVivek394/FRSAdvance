    // ================================================================
    // MQTT CONNECTION MANAGEMENT
    // ================================================================

    function initMqttConnection(callback) {
        if (mqttConnected && mqttClient) {
            if (callback) callback(true);
            return;
        }

        // Check if mQTT config is available (from ViewBag.MQTTDetail)
        if (typeof mQTT === 'undefined' || !mQTT) {
            console.error('MQTT configuration not available');
            if (callback) callback(false, 'MQTT not configured');
            return;
        }

        try {
            var clientId = "web_cmd_" + Math.ceil(Math.random() * 100000);
            var isSecure = window.location.protocol === "https:";
            var PahoClient;
            if (typeof Paho !== 'undefined') {
                if (typeof Paho.MQTT !== 'undefined' && typeof Paho.MQTT.Client === 'function') {
                    PahoClient = Paho.MQTT.Client;
                } else if (typeof Paho.Client === 'function') {
                    PahoClient = Paho.Client;
                }
            }
            if (!PahoClient) {
                console.error('Paho MQTT library not loaded properly');
                if (callback) callback(false, 'MQTT library not available');
                return;
            }

            mqttClient = new PahoClient(mQTT.MQTTUri, mQTT.MQTTPort, clientId);
            // Set callback handlers
            mqttClient.onConnectionLost = function (responseObject) {
                mqttConnected = false;
                console.log("MQTT Connection Lost:", responseObject.errorMessage);

                // Clear all pending commands on disconnect
                for (var topic in mqttPendingCommands) {
                    var pending = mqttPendingCommands[topic];
                    if (pending.timeoutId) clearTimeout(pending.timeoutId);
                    if (pending.callback) pending.callback(false, 'Connection lost', 0);
                }
                mqttPendingCommands = {};
            };

            mqttClient.onMessageArrived = function (message) {
                handleMqttMessage(message.destinationName, message.payloadString);
            };

            // Connect
            mqttClient.connect({
                onSuccess: function () {
                    mqttConnected = true;
                    console.log('MQTT Connected (Paho)');
                    if (callback) callback(true);
                },
                onFailure: function (err) {
                    mqttConnected = false;
                    console.error('MQTT Connection Failed:', err.errorMessage);
                    if (callback) callback(false, err.errorMessage);
                },
                useSSL: isSecure,
                userName: mQTT.MQTTUsername,
                password: mQTT.MQTTPassword,
                cleanSession: true,
                timeout: 10
            });

        } catch (err) {
            console.error('MQTT Init Error:', err);
            if (callback) callback(false, err.message);
        }
    }

    function handleMqttMessage(topic, messageStr) {
        console.log('MQTT Message on', topic, ':', messageStr);

        // Find pending command for this topic
        var pending = mqttPendingCommands[topic];
        if (pending) {
            // Clear timeout
            if (pending.timeoutId) {
                clearTimeout(pending.timeoutId);
            }

            // Calculate latency
            var latency = Date.now() - pending.sentAt;

            // Call the callback with success
            if (pending.callback) {
                pending.callback(true, messageStr, latency);
            }

            // Unsubscribe from topic
            try {
                mqttClient.unsubscribe(topic);
            } catch (e) {
                console.warn('Unsubscribe error:', e);
            }

            // Remove from pending
            delete mqttPendingCommands[topic];
        }
    }

    function onMqttConnectionLost(responseObject) {
        mqttConnected = false;
        subscribedTopics = {};
        console.log("[MQTT] Connection lost: " + responseObject.errorMessage);
        updateMqttStatusIndicators(false);
        clearAllPendingCommands('Connection lost');

        setTimeout(function () {
            console.log("[MQTT] Attempting reconnection...");
            initMqttConnection();
        }, MQTT_CONFIG.reconnectDelay);
    }

    function onMqttMessageArrived(message) {
        var topic = message.destinationName;
        var payload = message.payloadString;

        console.log("[MQTT] Message - Topic: " + topic + ", Payload: " + payload);

        // Check Modem response
        if (modemPendingCommand != null && topic === modemPendingCommand.responseTopic) {
            if (validateMqttResponse(payload, modemPendingCommand.cmdInfo)) {
                completePendingCommand('modem', true, payload);
            }
        }

        // Check A10 response
        if (a10PendingCommand != null && topic === a10PendingCommand.responseTopic) {
            if (validateMqttResponse(payload, a10PendingCommand.cmdInfo)) {
                completePendingCommand('a10', true, payload);
            }
        }
    }

