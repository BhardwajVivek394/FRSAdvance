         }

         .console.zoomed .console-actions .btn-xs {
             padding: 4px 10px;
             font-size: 0.75rem;
         }

             .console.zoomed .console-actions .btn-xs i {
                 font-size: 0.85rem;
             }

     /* Dark theme adjustments for zoomed console */
     [data-theme="dark"] .console.zoomed {
         background: #0a0a14;
         border: 1px solid #333;
     }

         [data-theme="dark"] .console.zoomed .console-header {
