    function ensureZoomOverlay() {
        var overlay = document.getElementById('consoleZoomOverlay');
        if (!overlay) {
            overlay = document.createElement('div');
            overlay.id = 'consoleZoomOverlay';
            overlay.className = 'console-zoom-overlay';
            overlay.onclick = function () {
                // Close whichever console is zoomed
                if (isModemConsoleZoomed) toggleModemConsoleZoom();
                if (isA10ConsoleZoomed) toggleA10ConsoleZoom();
            };
            document.body.appendChild(overlay);
        }
        return overlay;
    }

    // ============================================================
    // MODEM CONSOLE FUNCTIONS
    // ============================================================

    /**
     * Clear the modem console
     */
    function clearModemConsole() {
        var consoleEl = document.getElementById('modemConsoleBS');
        if (consoleEl) {
            consoleEl.innerHTML = '<div class="console-line info">// Console cleared at ' + getCurrentTime() + '</div>';
            updateModemConsoleInfo('Console cleared');
            setTimeout(function () { updateModemConsoleInfo('Ready'); }, 2000);
        }
    }

    /**
     * Toggle modem console zoom/fullscreen mode
     */
    function toggleModemConsoleZoom() {
        var consoleContainer = document.getElementById('modemConsoleContainer');
        var zoomIcon = document.getElementById('consoleZoomIcon');
        var overlay = ensureZoomOverlay();

        isModemConsoleZoomed = !isModemConsoleZoomed;

        if (isModemConsoleZoomed) {
            // Enter fullscreen
            consoleContainer.classList.add('zoomed');
            overlay.classList.add('show');
            zoomIcon.classList.remove('bi-arrows-fullscreen');
            zoomIcon.classList.add('bi-fullscreen-exit');
            document.body.style.overflow = 'hidden';

            setTimeout(function () {
                document.getElementById('modemInputBS').focus();
            }, 100);

            updateModemConsoleInfo('Fullscreen mode - Press ESC to exit');
        } else {
            // Exit fullscreen
            consoleContainer.classList.remove('zoomed');
            overlay.classList.remove('show');
            zoomIcon.classList.remove('bi-fullscreen-exit');
            zoomIcon.classList.add('bi-arrows-fullscreen');
            document.body.style.overflow = '';

            updateModemConsoleInfo('Ready');
        }
    }

    /**
     * Update modem console info text
     */
    function updateModemConsoleInfo(message) {
        var infoEl = document.getElementById('modemConsoleInfoBS');
        if (infoEl) {
            infoEl.textContent = message;
        }
    }

    // ============================================================
    // A10 CONSOLE FUNCTIONS
    // ============================================================

    /**
     * Clear the A10 console
     */
    function clearA10Console() {
        var consoleEl = document.getElementById('a10ConsoleBS');
        if (consoleEl) {
            consoleEl.innerHTML = '<div class="console-line info">// Console cleared at ' + getCurrentTime() + '</div>';
            updateA10ConsoleInfo('Console cleared');
            setTimeout(function () { updateA10ConsoleInfo('Ready'); }, 2000);
        }
    }

    /**
     * Toggle A10 console zoom/fullscreen mode
     */
    function toggleA10ConsoleZoom() {
        var consoleContainer = document.getElementById('a10ConsoleContainer');
        var zoomIcon = document.getElementById('a10ConsoleZoomIcon');
        var overlay = ensureZoomOverlay();

        isA10ConsoleZoomed = !isA10ConsoleZoomed;

        if (isA10ConsoleZoomed) {
            // Enter fullscreen
            consoleContainer.classList.add('zoomed');
            overlay.classList.add('show');
            zoomIcon.classList.remove('bi-arrows-fullscreen');
            zoomIcon.classList.add('bi-fullscreen-exit');
            document.body.style.overflow = 'hidden';

            setTimeout(function () {
                document.getElementById('a10InputBS').focus();
            }, 100);

            updateA10ConsoleInfo('Fullscreen mode - Press ESC to exit');
        } else {
            // Exit fullscreen
            consoleContainer.classList.remove('zoomed');
            overlay.classList.remove('show');
            zoomIcon.classList.remove('bi-fullscreen-exit');
            zoomIcon.classList.add('bi-arrows-fullscreen');
            document.body.style.overflow = '';

            updateA10ConsoleInfo('Ready');
        }
    }

    /**
     * Update A10 console info text
     */
    function updateA10ConsoleInfo(message) {
        var infoEl = document.getElementById('a10ConsoleInfoBS');
        if (infoEl) {
            infoEl.textContent = message;
        }
    }
    function buildTcpPort(siteId, clusterNo, offset) {
        if (!siteId || siteId <= 0 || !clusterNo || clusterNo <= 0) return 0;

        var siteStr = String(siteId);
        var clusterStr = String(clusterNo + offset).padStart(2, '0');

        // Combine: "14" + "02" = "1402",  "14" + "32" = "1432"
        return parseInt(siteStr + clusterStr);
    }
    // ============================================================
    // KEYBOARD HANDLER - ESC to exit fullscreen
    // ============================================================
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            if (isModemConsoleZoomed) toggleModemConsoleZoom();
            if (isA10ConsoleZoomed) toggleA10ConsoleZoom();
        }
    });
</script>
