<div class="network-dashboard" id="networkDashboard" data-theme="light">
    <nav class="navbar navbar-expand-lg py-2">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center gap-2" href="#">
                <div class="bg-primary rounded d-flex align-items-center justify-content-center" style="width: 32px; height: 32px; color: #fff;">E7</div>
                <span class="fw-bold brand-text">Energy7</span>
            </a>
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 d-flex align-items-center gap-2">
                    <span class="status-dot online status-dot-pulse"></span>LIVE
                </span>
                <span class="text-secondary font-mono small" id="clock">--:--:--</span>

                <!-- Theme Toggle Button -->
                <button class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1"
                        id="themeToggleBtn"
                        onclick="toggleTheme()"
                        title="Toggle Theme">
                    <i class="bi bi-sun-fill" id="themeIconLight" style="display: none;"></i>
                    <i class="bi bi-moon-fill" id="themeIconDark"></i>
                </button>

                <a href="@Url.Action("Index", "NetworkDashboard")" class="btn btn-primary btn-sm"><i class="bi bi-arrow-clockwise me-1"></i> Refresh</a>
            </div>
        </div>
    </nav>

    <div class="main-content d-flex">
        <aside class="sidebar d-none d-lg-block">
            <div class="p-3 border-bottom">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-transparent border-secondary">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text"
                           id="sidebarSearch"
                           class="form-control bg-transparent border-secondary text-muted"
                           placeholder="Search zone, division, station..."
                           autocomplete="off">
                    <button class="btn btn-outline-secondary border-secondary"
                            type="button"
                            onclick="clearSidebarSearch()"
                            title="Clear">
                        <i class="bi bi-x text-muted"></i>
                    </button>
                </div>
            </div>
            <div class="p-2" id="sidebarTreeContainer">
                <div class="text-uppercase text-muted small fw-semibold px-2 py-2" style="font-size:0.65rem;">
                    Zone / Division / Station
                </div>

                <div id="originalTree">
                    @if (Model.Zones != null && Model.Zones.Count > 0)
                    {
                        foreach (var zone in Model.Zones)
                        {
                            int stationCount = 0;
                            if (zone.Divisions != null)
                            {
                                foreach (var div in zone.Divisions)
                                {
                                    if (div.Sites != null) { stationCount = stationCount + div.Sites.Count; }
                                }
                            }
                            <div class="tree-item d-flex align-items-center gap-2"
                                 data-type="zone"
                                 data-zone-name="@zone.Name"
                                 onclick="toggleTreeBS(this, null, null, @zone.Id)">
                                <i class="bi bi-chevron-right small text-muted tree-toggle"></i>
                                <i class="bi bi-globe-americas text-info"></i>
                                <span class="flex-grow-1 small">@zone.Name</span>
                                <span class="badge bg-secondary rounded-pill" style="font-size:0.6rem;">@stationCount</span>
                            </div>
                            <div class="tree-children">
                                @if (zone.Divisions != null)
                                {
                                    foreach (var division in zone.Divisions)
                                    {
                                        int divSiteCount = 0;
                                        if (division.Sites != null) { divSiteCount = division.Sites.Count; }
                                        <div class="tree-item d-flex align-items-center gap-2 ps-3"
                                             data-type="division"
                                             data-division-name="@division.Name"
                                             onclick="toggleTreeBS(this, null, @division.Id, null)">
                                            <i class="bi bi-chevron-right small text-muted tree-toggle"></i>
                                            <i class="bi bi-building text-primary"></i>
                                            <span class="flex-grow-1 small">@division.Name</span>
                                            <span class="badge bg-secondary rounded-pill" style="font-size:0.6rem;">@divSiteCount</span>
                                        </div>
                                        <div class="tree-children">
                                            @if (division.Sites != null)
                                            {
                                                foreach (var site in division.Sites)
                                                {
                                                    <div class="tree-item d-flex align-items-center gap-2 ps-5"
                                                         data-type="site"
                                                         data-site-name="@site.Name"
                                                         onclick="toggleTreeBS(this, @site.Id, null, null)">
                                                        <i class="bi bi-buildings text-warning"></i>
                                                        <span class="flex-grow-1 small">@site.Name</span>
                                                    </div>}
                                            }
                                        </div>}
                                }
                            </div> }
                    }
                    else
                    {
                        <div class="text-muted small px-2">No zones available</div>}
                </div>
            </div>
        </aside>

        <div class="flex-grow-1 d-flex flex-column">
