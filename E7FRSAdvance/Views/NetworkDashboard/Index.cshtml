    function formatDateForApi(dateValue) {
        // Convert YYYY-MM-DD to DD-MM-YYYY
        if (!dateValue) return '';
        var parts = dateValue.split('-');
        if (parts.length === 3) {
            return parts[2] + '-' + parts[1] + '-' + parts[0];
        }
        return '';
    }

    function loadModemHistory() {
        if (!selectedModemId) {
            console.log('No modem selected');
            return;
        }

        var fromDateInput = document.getElementById('modemHistoryFromDate');
        var toDateInput = document.getElementById('modemHistoryToDate');

        var fromDate = formatDateForApi(fromDateInput ? fromDateInput.value : '');
        var toDate = formatDateForApi(toDateInput ? toDateInput.value : '');

        // Fallback to today if dates are empty
        if (!fromDate || !toDate) {
            var today = new Date();
            var day = ('0' + today.getDate()).slice(-2);
            var month = ('0' + (today.getMonth() + 1)).slice(-2);
            var year = today.getFullYear();
            var todayFormatted = day + '-' + month + '-' + year;
            fromDate = fromDate || todayFormatted;
            toDate = toDate || todayFormatted;
        }

