    function loadDashboardCounts() {
        $.ajax({
            url: '/NetworkDashboard/GetDashboardCounts',
            type: 'GET',
            success: function (data) {
                setStatValue('statTotalModems', data.TotalModems);
                setStatValue('statV1Online', data.V1MqttOnline);
                setStatValue('statV1Total', data.TotalVersion1);
                setStatValue('statV2Online', data.V2MqttOnline);
                setStatValue('statV2Total', data.TotalVersion2);
                setStatValue('statTotalA10', data.TotalA10Count);
                setStatValue('statTcpA10Online', data.TCPA10OnlineCount);
                setStatValue('statTcpA10Total', data.TCPA10Count);
                setStatValue('statMqttA10Online', data.MQTTA10OnlineCount);
                setStatValue('statMqttA10Total', data.MQTTA10Count);
            },
            error: function () {
                // Show dashes on failure so user knows something went wrong
                ['statTotalModems', 'statV1Online', 'statV1Total', 'statV2Online',
                    'statV2Total', 'statTotalA10', 'statTcpA10Online', 'statTcpA10Total',
                    'statMqttA10Online', 'statMqttA10Total'].forEach(function (id) {
                        setStatValue(id, '-');
                    });
            }
        });
    }

    function setStatValue(id, value) {
        var el = document.getElementById(id);
        if (el) el.innerHTML = (value !== undefined && value !== null) ? value : '-';
    }
    document.addEventListener('DOMContentLoaded', function () {
        var modemTabLinks = document.querySelectorAll('#modemTabs .nav-link');
        for (var i = 0; i < modemTabLinks.length; i++) {
            modemTabLinks[i].addEventListener('shown.bs.tab', function (e) {
                var tabId = e.target.getAttribute('href').replace('#', '');
                currentModemTab = tabId;
                loadTabData(tabId);
            });
        }

        var modemInput = document.getElementById('modemInputBS');
        if (modemInput) {
            modemInput.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    sendModemConsoleBS();
                }
            });
        }

        var a10Input = document.getElementById('a10InputBS');
        if (a10Input) {
            a10Input.addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    sendA10ConsoleBS();
                }
            });
        }

        var defaultSiteId = 81;
        loadDevicePanel(defaultSiteId, null, null);
        loadDashboardCounts();
    });

    function loadTabData(tabId) {
        if (!selectedModemId) {
            console.warn("No modem selected");
            return;
        }

        switch (tabId) {
            case 'modemStatus':
                break;
            case 'modemA10List':
                loadA10Status();
                break;
            case 'modemHistory':
                loadModemHistory();
                break;
            case 'modemCommand':
                break;
        }
    }

    function loadCurrentTabData() {
        var activeTab = document.querySelector('#modemTabs .nav-link.active');

        if (activeTab) {
            var tabId = activeTab.getAttribute('href').replace('#', '');
            currentModemTab = tabId;
            loadTabData(tabId);
        }
    }

    // ================================================================
    // SECTION 8: DATA LOADING FUNCTIONS
    // ================================================================

    function loadModemStatus() {
        if (!selectedModemId) return;

        var container = document.getElementById('modemStatusContainer');
        if (container) {
            container.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div> Loading...</div>';
        }

        $.ajax({
            url: '/NetworkDashboard/ModemStatus',
            type: 'GET',
            data: { modemId: selectedModemId },
            success: function (html) {
                $('#modemStatusContainer').html(html);
            },
            error: function (xhr) {
                $('#modemStatusContainer').html('<div class="text-danger small text-center py-3">Error loading status</div>');
                console.error("Error loading status:", xhr.responseText);
            }
        });
    }

    function loadA10Status() {
        if (!selectedModemId) return;

        var container = document.getElementById('modemA10StatusContainer');
        if (container) {
            container.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div> Loading...</div>';
        }
        var cacheKey = currentModem.clusterId;
        if (tabDataCache.a10Status[cacheKey]) {
            $('#modemA10StatusContainer').html(tabDataCache.a10Status[cacheKey]);
            return;
        }
        $.ajax({
            url: '/NetworkDashboard/A10StatusModemWise',
            type: 'GET',
            data: { clusterId: currentModem.clusterId },
            success: function (html) {
                $('#modemA10StatusContainer').html(html);
                tabDataCache.a10Status[cacheKey] = html;

            },
            error: function (xhr) {
                $('#modemA10StatusContainer').html('<div class="text-danger small text-center py-3">Error loading A10 list</div>');
                console.error("Error loading A10 list:", xhr.responseText);
            }
        });
    }

    function loadA10(el, clusterId) {
        var container = $(el).closest('.modem-row').find('.a10-container');

        if (container.children().length > 0) {
            container.slideToggle();
            $(el).toggleClass('rotate');
            return;
        }

        $.get('/NetworkDashboard/LoadA10ByCluster', { clusterId: clusterId })
            .done(function (html) {
                container.html(html).slideDown();
                $(el).addClass('rotate');
            })
            .fail(function (xhr) {
                console.error("Failed to load A10:", xhr.responseText);
            });
    }

