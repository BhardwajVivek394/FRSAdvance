    function sendA10Command(cmdJson) {
        if (!currentA10) {
            logA10Console('error', 'No A10 selected');
            return;
        }

        if (currentA10.modemVersion === '1') {
            logA10Console('error', 'A10 commands not available for V1 Modem');
            return;
        }

        logA10Console('cmd', '[MQTT] > ' + cmdJson);

        if (a10CmdPending) {
            logA10Console('error', 'Command in progress...');
            return;
        }

        a10CmdPending = true;

        var consoleInfo = document.getElementById('a10ConsoleInfoBS');
        if (consoleInfo) {
            consoleInfo.innerHTML = '<span class="text-warning">Sending...</span>';
        }

        sendMqttCommandInternal('a10', currentModem.mqttBase, currentModem.clusterName, cmdJson,
            function (success, data, pending) {
                a10CmdPending = false;
                var latency = pending ? (Date.now() - pending.sentAt) : 0;
                var commandType = pending && pending.cmdInfo ? pending.cmdInfo.commandType : 'unknown';

                if (success && data) {
                    try {
                        var json = JSON.parse(data);
                        var formattedResponse = formatA10Response(json, commandType);
                        logA10Console('response', formattedResponse, latency);

                        if (consoleInfo) {
                            consoleInfo.innerHTML = '<span class="text-success">OK</span> <span class="text-muted">(' + latency + 'ms)</span>';
                        }
                    } catch (e) {
                        logA10Console('response', data, latency);
                    }
                } else {
                    logA10Console('error', data || 'No response (timeout)');
                    if (consoleInfo) {
                        consoleInfo.innerHTML = '<span class="text-danger">Timeout</span>';
                    }
                }
            }
        );

        var tab = document.querySelector('a[href="#a10Command"]');
        if (tab) {
            bootstrap.Tab.getOrCreateInstance(tab).show();
        }
    }

