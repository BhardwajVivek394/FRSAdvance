                    <div id="modemDetailBS">
                        <div class="p-3 border-bottom" id="modemHeaderBS" style="display: none;">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <div class="bg-v2 rounded d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;"><i class="bi bi-router text-v1"></i></div>
                                <h5 class="mb-0 card-value" id="modemNameBS">Modem-001</h5>
                                <span class="badge badge-v2" id="modemVersionBadgeBS">MODEM V2</span>
                            </div>
                            <small class="text-muted"><i class="bi bi-geo-alt me-1"></i><span id="modemLocationBS">Station / Division / Zone</span></small>
                            <div class="mt-2" id="modemProtocolInfoBS"><span class="protocol-indicator protocol-tcp">TCP</span></div>
                        </div>
                        <input type="hidden" id="modemIdBS" value="" />
                        <input type="hidden" id="modemVersionBS" value="2" />
                        <input type="hidden" id="modemClusterIdBS" value="" />
                        <input type="hidden" id="modemClusterNameBS" value="" />
                        <input type="hidden" id="modemMqttBaseBS" value="" />
                        <input type="hidden" id="modemTcpSendPortBS" value="" />
                        <input type="hidden" id="modemTcpRecvPortBS" value="" />
                        <ul class="nav nav-pills nav-fill p-2 border-bottom" id="modemTabs" style="display: none;">
                            <li class="nav-item"><a class="nav-link active" data-bs-toggle="pill" href="#modemStatus">Status</a></li>
                            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#modemA10List">A10 List</a></li>
                            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#modemHistory">History</a></li>
                            <li class="nav-item"><a class="nav-link" data-bs-toggle="pill" href="#modemCommand">Command</a></li>
                        </ul>
                        <div class="tab-content p-3" id="modemTabContent" style="display: none;">
                            <div class="tab-pane fade show active" id="modemStatus"><div id="modemStatusContainer"><div class="text-muted small p-2">Select a modem to view status</div></div></div>
                            <div class="tab-pane fade" id="modemA10List"><div id="modemA10StatusContainer"><div class="text-muted small p-2">Select a modem to view A10 list</div></div></div>
                            <div class="tab-pane fade" id="modemHistory">

                                <!-- History Container -->
                                <div id="modemHistoryContainer">
                                    <div class="text-muted small text-center py-4">
                                        <i class="bi bi-clock-history d-block fs-4 mb-2"></i>
                                        Select a modem to view history
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="modemCommand">
                                <div id="modemProtocolSelectorBS" class="mb-3" style="display: none;">
                                    <label class="form-label small text-muted mb-1">Select Protocol</label>
                                    <select class="form-select form-select-sm" id="modemProtocolSelectBS" onchange="onModemProtocolChange()">
                                        <option value="tcp">TCP</option>
                                        <option value="mqtt">MQTT</option>
                                    </select>
                                </div>
                                <div id="modemCmdsV1BS">
