    function renderModemSignalChart(data) {
        var showTcp = document.getElementById('chkModemTcp').checked;
        var showMqtt = document.getElementById('chkModemMqtt').checked;

        var tcpData = [], mqttData = [];
        var tcpSum = 0, mqttSum = 0;

        for (var i = 0; i < data.length; i++) {
            var item = data[i];
            var ts = item.TimeStamp || item.Timestamp || item.timeStamp;
            var typeId = item.TypeId || item.typeId;
            var signal = parseInt(item.SignalStrength) || 0;

            if (signal === 0) continue;

            var dt = new Date(ts);
            if (typeId === 1) {
                tcpData.push({ x: dt, y: signal });
                tcpSum += signal;
            } else if (typeId === 2) {
                mqttData.push({ x: dt, y: signal });
                mqttSum += signal;
            }
        }

        tcpData.sort(function (a, b) { return a.x - b.x; });
        mqttData.sort(function (a, b) { return a.x - b.x; });

        var statsHtml = '';
        if (showTcp && tcpData.length > 0) {
            statsHtml += '<span class="stat"><span class="dot tcp"></span>TCP: ' + Math.round(tcpSum / tcpData.length) + ' dBm avg</span>';
        }
        if (showMqtt && mqttData.length > 0) {
            statsHtml += '<span class="stat"><span class="dot mqtt"></span>MQTT: ' + Math.round(mqttSum / mqttData.length) + ' dBm avg</span>';
        }
        document.getElementById('modemGraphStats').innerHTML = statsHtml;

        if ((showTcp && tcpData.length === 0) && (showMqtt && mqttData.length === 0)) {
            document.getElementById('modemSignalChart').style.display = 'none';
            document.getElementById('modemGraphEmpty').style.display = 'flex';
            return;
        }

        if (modemChartInstance) {
            modemChartInstance.destroy();
        }

        var datasets = [];
        if (showTcp && tcpData.length > 0) {
            datasets.push({
                label: 'TCP Signal',
                data: tcpData,
                borderColor: '#3b82f6',
                backgroundColor: 'rgba(59,130,246,0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.3,
                pointRadius: 2,
                pointHoverRadius: 5
            });
        }
        if (showMqtt && mqttData.length > 0) {
            datasets.push({
                label: 'MQTT Signal',
                data: mqttData,
                borderColor: '#22c55e',
                backgroundColor: 'rgba(34,197,94,0.1)',
                borderWidth: 2,
                fill: true,
                tension: 0.3,
                pointRadius: 2,
                pointHoverRadius: 5
            });
        }

        var theme = getChartThemeColors();

        var ctx = document.getElementById('modemSignalChart').getContext('2d');
        modemChartInstance = new Chart(ctx, {
            type: 'line',
            data: { datasets: datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
