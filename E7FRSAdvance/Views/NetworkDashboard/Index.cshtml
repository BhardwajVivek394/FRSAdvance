    // ================================================================
    // MQTT CONNECTION MANAGEMENT
    // ================================================================
    function mqttConnect(callback) {
        if (mqttConnected) {
            if (callback) callback(true);
            return;
        }

        if (mqttConnecting) {
            var checkInterval = setInterval(function () {
                if (!mqttConnecting) {
                    clearInterval(checkInterval);
                    if (callback) callback(mqttConnected);
                }
            }, 100);
            return;
        }

        mqttConnecting = true;
        log('Connecting to ' + mQTT.MQTTUri + '...', 'sys');

        var isSecure = window.location.protocol === "https:";
        var port = mQTT.MQTTPort;
        var clientId = "Web_" + Math.random().toString(36).substring(2, 10) + "_" + Date.now();

        console.log("[MQTT] Connecting - Host:", mQTT.MQTTUri, "Port:", port, "SSL:", isSecure);

        try {
            mqttClient = new Paho.Client(mQTT.MQTTUri, port, clientId);
            mqttClient.onConnectionLost = onMqttConnectionLost;
            mqttClient.onMessageArrived = onMqttMessageArrived;

            mqttClient.connect({
                onSuccess: function () {
                    mqttConnected = true;
                    mqttConnecting = false;
                    log('Connected', 'sys');
                    console.log("[MQTT] Connected successfully");
                    updateUI();
                    if (callback) callback(true);
                },
                onFailure: function (error) {
                    mqttConnected = false;
                    mqttConnecting = false;
                    log('Connection failed: ' + error.errorMessage, 'err');
                    console.error("[MQTT] Connection failed:", error.errorMessage);
                    showConsole();
                    updateUI();
                    if (callback) callback(false, error.errorMessage);
                },
                useSSL: isSecure,
                userName: mQTT.MQTTUsername,
                password: mQTT.MQTTPassword,
                cleanSession: true,
                timeout: 30,
                keepAliveInterval: 60
            });
        } catch (e) {
            mqttConnecting = false;
            log('Error: ' + e.message, 'err');
            console.error("[MQTT] Connection error:", e.message);
            showConsole();
            if (callback) callback(false, e.message);
        }
    }

    function onMqttConnectionLost(responseObject) {
        mqttConnected = false;
        mqttSubscribed = false;
        subscribedTopics = {};

        log('Disconnected: ' + responseObject.errorMessage, 'err');
        console.log("[MQTT] Connection lost:", responseObject.errorMessage);
        updateUI();

        // Auto-reconnect
        setTimeout(function () {
            log('Reconnecting...', 'sys');
            mqttConnect();
        }, MQTT_CONFIG.reconnectDelay);
    }

    function onMqttMessageArrived(message) {
        var topic = message.destinationName;
        var payload = message.payloadString;

        console.log("[MQTT] IN - Topic:", topic);
        console.log("[MQTT] IN - Payload:", payload);

        log('← ' + payload, 'in');
        showConsole();

        // Try to parse and log JSON nicely
        try {
            var json = JSON.parse(payload);
            console.log("[MQTT] Parsed:", json);
        } catch (e) { }
    }

    // ================================================================
    // SUBSCRIBE / PUBLISH
    // ================================================================
    function mqttSubscribe() {
        var topic = getMqttTopics().sub;
        if (!topic || topic === '-') {
            log('No subscribe topic', 'err');
            showConsole();
            return;
        }

        if (!mqttConnected) {
            mqttConnect(function (success) {
                if (success) mqttSubscribe();
            });
            return;
        }

        if (mqttSubscribed && subscribedTopics[topic]) {
            // Unsubscribe
            mqttClient.unsubscribe(topic, {
                onSuccess: function () {
                    delete subscribedTopics[topic];
                    mqttSubscribed = false;
                    log('Unsubscribed: ' + topic, 'sys');
                    updateUI();
                },
                onFailure: function (err) {
                    log('Unsubscribe failed', 'err');
                }
            });
        } else {
            // Subscribe
            mqttClient.subscribe(topic, {
                qos: 1,
                onSuccess: function () {
                    subscribedTopics[topic] = true;
                    mqttSubscribed = true;
                    log('Subscribed: ' + topic, 'sys');
                    updateUI();
                },
                onFailure: function (err) {
                    log('Subscribe failed: ' + err.errorMessage, 'err');
                }
            });
        }
        showConsole();
    }

    function mqttPublishClick() {
        var topic = getMqttTopics().pub;
        if (!topic || topic === '-') {
            log('No publish topic', 'err');
            showConsole();
            return;
        }
        document.getElementById('mqttCommandInput').focus();
        showConsole();
    }

    function sendMqttCommand() {
        var input = document.getElementById('mqttCommandInput');
        var cmd = input.value.trim();
        if (!cmd) return;

        var topic = getMqttTopics().pub;
        if (!topic || topic === '-') {
            log('No publish topic', 'err');
            return;
        }

        if (!mqttConnected) {
            mqttConnect(function (success) {
                if (success) sendMqttCommand();
            });
            return;
        }

        try {
            var message = new Paho.Message(cmd);
            message.destinationName = topic;
            message.qos = 1;
            message.retained = false;

            mqttClient.send(message);
            log('→ ' + cmd, 'out');
            console.log("[MQTT] OUT - Topic:", topic, "Msg:", cmd);
            input.value = '';
            showConsole();

            // Auto-subscribe to get response
            if (!mqttSubscribed) {
                var subTopic = getMqttTopics().sub;
                if (subTopic && subTopic !== '-') {
                    mqttClient.subscribe(subTopic, {
                        qos: 1,
                        onSuccess: function () {
                            subscribedTopics[subTopic] = true;
                            mqttSubscribed = true;
                            updateUI();
                        }
                    });
                }
            }
        } catch (e) {
            log('Send error: ' + e.message, 'err');
        }
    }

