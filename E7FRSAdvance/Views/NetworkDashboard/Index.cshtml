    var pendingA10CmdBS = null;
    var pinModalBS = null;
    var timeSetModalBS = null;

    var noPinCommands = ['time_get', 'fw_get', 'update', 'channel_get_all'];
    var pinCommands = ['event_get', 'event_clear', 'channel_get'];

    $(document).ready(function () {
        initA10Modals();
