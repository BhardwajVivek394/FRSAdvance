        var theme = savedTheme || 'light';
        applyTheme(theme);
    }

    function toggleTheme() {
        var dashboard = document.getElementById('networkDashboard');
        var currentTheme = dashboard.getAttribute('data-theme');
        var newTheme = currentTheme === 'light' ? 'dark' : 'light';
        dashboard.classList.add('theme-transition');
        applyTheme(newTheme);
        document.body.setAttribute('data-theme', newTheme);

        // ADD THIS: Dispatch custom event for modals to listen
        window.dispatchEvent(new CustomEvent('themeChanged', { detail: { theme: newTheme } }));
        document.dispatchEvent(new CustomEvent('themeChanged', { detail: { theme: newTheme } }));

        setTimeout(function () {
            dashboard.classList.remove('theme-transition');
        }, 300);
    }

    function applyTheme(theme) {
        var dashboard = document.getElementById('networkDashboard');
        var lightIcon = document.getElementById('themeIconLight');
        var darkIcon = document.getElementById('themeIconDark');

        dashboard.setAttribute('data-theme', theme);
        localStorage.setItem('dashboard-theme', theme);

        if (theme === 'dark') {
            lightIcon.style.display = 'inline';
            darkIcon.style.display = 'none';
        } else {
            lightIcon.style.display = 'none';
            darkIcon.style.display = 'inline';
        }

        logThemeChange(theme);
    }

