    // ================================================================
    // SECTION 12: MODEM COMMANDS - TCP
    // ================================================================

    function sendModemCmdTCP(cmd) {
        if (!selectedModemId) {
            logConsole('error', 'No modem selected');
            return;
        }

        logConsole('cmd', '[TCP] > ' + cmd);

        if (cmdPending) {
            logConsole('error', 'Command in progress...');
            return;
        }

        cmdPending = true;
        var sentAt = Date.now();

        var request = {
            modemId: selectedModemId,
            command: cmd,
            tcpInfo: currentModem
        };
        fetch('/Modem/SendTcpCommand', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            //    body: 'modemId=' + encodeURIComponent(selectedModemId) + '&command=' + encodeURIComponent(cmd) + '&command=' + encodeURIComponent(cmd)
            body: JSON.stringify(request)
        })
            .then(function (response) {
                return response.json();
            })
            .then(function (result) {
                var latency = Date.now() - sentAt;
                if (result.success && result.data) {
                    logConsole('response', result.data, latency);
                } else {
                    logConsole('error', result.error || 'No response (timeout)');
                }
            })
            .catch(function (err) {
                logConsole('error', 'TCP Failed: ' + err.message);
            })
            .finally(function () {
                cmdPending = false;
            });

        var tab = document.querySelector('a[href="#modemCommand"]');
        if (tab) {
            bootstrap.Tab.getOrCreateInstance(tab).show();
        }
    }

