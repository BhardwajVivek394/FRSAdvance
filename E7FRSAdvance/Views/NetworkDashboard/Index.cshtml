        console.log('Total A10 items found:', totalA10Count);

        for (var i = 0; i < allA10Items.length; i++) {
            var a10 = allA10Items[i];

            var tcpStr = a10.getAttribute('data-tcp-status');
            var mqttStr = a10.getAttribute('data-mqtt-status');

            var tcpStatus = (tcpStr === 'true' || tcpStr === 'True');
            var mqttStatus = (mqttStr === 'true' || mqttStr === 'True');

            var shouldShow = false;

            // CORRECTED LOGIC: Online = ANY one is true, Offline = BOTH are false
            if (currentA10Filter === 'All') {
                shouldShow = true;
            } else if (currentA10Filter === 'Online') {
                // Online = TCP OR MQTT is true (any one)
                shouldShow = (tcpStatus || mqttStatus);
            } else if (currentA10Filter === 'Offline') {
                // Offline = BOTH TCP AND MQTT are false
                shouldShow = (!tcpStatus && !mqttStatus);
            }

            // Apply display style - FORCE the style
            if (shouldShow) {
                a10.style.cssText = '';  // Clear all inline styles
                a10.classList.remove('d-none');
                a10.removeAttribute('hidden');
                visibleA10Count++;
            } else {
                a10.style.cssText = 'display: none !important';
                a10.classList.add('d-none');
            }
        }

        console.log('Visible A10 count:', visibleA10Count);

        // Update A10 count in header
        var a10CountEl = document.getElementById('visibleA10Count');
        if (a10CountEl) {
            a10CountEl.textContent = visibleA10Count;
        }

        // Handle no A10 messages in each container
        handleNoA10Messages();
    }

