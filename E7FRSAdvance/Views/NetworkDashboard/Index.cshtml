    function extractHistoryDataFromHtml() {
        var container = document.getElementById('modemHistoryContainer');
        if (!container) return;

        modemHistoryData = [];
        var rows = container.querySelectorAll('tbody tr');

        rows.forEach(function (row) {
            var protocol = row.getAttribute('data-protocol');

            // If no data-protocol, try to detect from content
            if (!protocol) {
                var rowText = row.textContent.toLowerCase();
                if (rowText.includes('mqtt')) {
                    protocol = 'mqtt';
                } else if (rowText.includes('tcp')) {
                    protocol = 'tcp';
                } else {
                    protocol = 'unknown';
                }
                // Set the attribute for future filtering
                row.setAttribute('data-protocol', protocol);
            }

            modemHistoryData.push({
                element: row,
                normalizedProtocol: protocol
            });
        });
    }

