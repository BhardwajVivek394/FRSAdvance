    function onA10Select(el) {
        var items = document.querySelectorAll('.a10-item');
        for (var i = 0; i < items.length; i++) {
            items[i].classList.remove('active');
        }
        el.classList.add('active');

        var parentModemVersion = currentModem ? currentModem.version : '2';

        currentA10 = {
            id: el.getAttribute('data-a10-id'),
            number: el.getAttribute('data-a10-number'),
            type: el.getAttribute('data-a10-type'),
            typeId: el.getAttribute('data-a10-type-id'),
            firmware: el.getAttribute('data-a10-firmware') || '-',
            slave: el.getAttribute('data-a10-slave'),
            channels: el.getAttribute('data-a10-channels') || '0',
            clusterId: el.getAttribute('data-cluster-id'),
            clusterName: el.getAttribute('data-cluster-name') || (currentModem ? currentModem.clusterName : ''),
            modemId: el.getAttribute('data-modem-id') || (currentModem ? currentModem.modemId : ''),
            modemName: el.getAttribute('data-modem-name') || (currentModem ? currentModem.modemName : ''),
            modemVersion: parentModemVersion,
            siteId: el.getAttribute('data-site-id'),
            stationName: el.getAttribute('data-station-name') || (currentModem ? currentModem.stationName : ''),
            divisionName: el.getAttribute('data-division-name') || (currentModem ? currentModem.divisionName : ''),
            mqttBase: el.getAttribute('data-mqtt-base') || (currentModem ? currentModem.mqttBase : ''),
            tcpStatus: el.getAttribute('data-tcp-status') === 'true',
            mqttStatus: el.getAttribute('data-mqtt-status') === 'true',
            lastData: el.getAttribute('data-last-data'),
            mqttSubscribe: el.getAttribute('data-mqtt-subscribe'),
            mqttPublish: el.getAttribute('data-mqtt-publish')
        };
        setSelectedA10ForGraph(currentA10.clusterId, currentA10.id);
        bindA10Details(currentA10);
        setupA10CommandUI(parentModemVersion);

        document.getElementById('modemDetailBS').style.display = 'none';
        document.getElementById('a10DetailBS').style.display = 'block';

        var statusTab = document.querySelector('#a10Tabs .nav-link[href="#a10Status"]');
        if (statusTab) {
            bootstrap.Tab.getOrCreateInstance(statusTab).show();
        }

        var consoleEl = document.getElementById('a10ConsoleBS');
        if (consoleEl) {
            if (parentModemVersion === '1') {
                consoleEl.innerHTML = '<div class="console-line info">// A10-' + currentA10.number + ' (Parent: V1 - No MQTT Commands)</div>';
            } else {
                consoleEl.innerHTML = '<div class="console-line info">// A10-' + currentA10.number + ' ready (MQTT)</div>';
            }
        }

        var consoleDot = document.getElementById('a10ConsoleDotBS');
        if (consoleDot) {
            if (currentA10.tcpStatus || currentA10.mqttStatus) {
                consoleDot.className = 'text-success';
            } else {
                consoleDot.className = 'text-danger';
            }
        }
    }

