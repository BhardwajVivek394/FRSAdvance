    function getProxyHost() {
        const host = window.location.hostname;

        // Local / development
        if (
            host === 'localhost' ||
            host === '127.0.0.1' ||
            host.endsWith('.local')
        ) {
            return 'proxy.energy7.org';
        }

        // Live public server (energy7.in on any port)
        if (host === 'energy7.in' || host.endsWith('.energy7.in')) {
            return 'proxy.energy7.org';
        }

        // Internal network access (via internal IP)
        return '172.31.25.106';
    }


    function onModemSelect(el, modemId) {
        tabDataCache = { modemStatus: {}, a10Status: {}, history: {} };
        var clusterName = el.getAttribute('data-cluster-name') || '';
        var mqttBase = el.getAttribute('data-mqtt-base') || '';
        var clusterNo = extractClusterNo(clusterName);
        var cleanClusterName = clusterName.replace(/\s/g, '');
        var subscribeTopic = mqttBase ? (mqttBase + cleanClusterName + '/S') : '';
        var publishTopic = mqttBase ? (mqttBase + cleanClusterName + '/P') : '';
        //var tcpReceive = clusterNo > 0 ? 'proxy.energy7.org:' + (1400 + clusterNo) : '-';
        //var tcpSend = clusterNo > 0 ? 'proxy.energy7.org:' + (1430 + clusterNo) : '-';

        var proxyHost = getProxyHost();
        var tcpReceivePort = buildTcpPort(selectedSiteId, clusterNo, 0);
        var tcpSendPort = buildTcpPort(selectedSiteId, clusterNo, 30);

        var tcpReceive = tcpReceivePort ? proxyHost + ':' + tcpReceivePort : '-';
        var tcpSend = tcpSendPort ? proxyHost + ':' + tcpSendPort : '-';
        //var tcpReceive = clusterNo > 0 ? proxyHost + ':' + (1400 + clusterNo) : '-';
        //var tcpSend = clusterNo > 0 ? proxyHost + ':' + (1430 + clusterNo) : '-';

        currentModem = {
            modemId: el.getAttribute('data-modem-id'),
            modemName: el.getAttribute('data-modem-name'),
            version: el.getAttribute('data-modem-version') || '2',
            clusterId: el.getAttribute('data-cluster-id'),
            clusterName: clusterName,
            clusterNo: clusterNo,
            stationName: el.getAttribute('data-station-name'),
            divisionName: el.getAttribute('data-division-name'),
            zoneName: el.getAttribute('data-zone-name'),
            mqttBase: mqttBase,
            tcpSendPort: tcpSend,
            tcpRecvPort: tcpReceive,
            subscribeTopic: subscribeTopic,
            publishTopic: publishTopic,
            tcpStatus: el.getAttribute('data-tcp-status') === 'true',
            mqttStatus: el.getAttribute('data-mqtt-status') === 'true',
            simNumber: el.getAttribute('data-sim-number') || '-',
            signal: el.getAttribute('data-signal')
        };

        selectedModemId = modemId;

        bindModemDetails(currentModem);
        renderModemStatus(currentModem, el);
        setupModemCommandUI(currentModem.version);

        document.getElementById('a10DetailBS').style.display = 'none';
        document.getElementById('modemDetailBS').style.display = 'block';

        var consoleEl = document.getElementById('modemConsoleBS');
        if (consoleEl) {
            var versionInfo = currentModem.version === '1' ? 'V1 - TCP Only' : 'V2 - TCP/MQTT';
            consoleEl.innerHTML = '<div class="console-line info">// ' + currentModem.modemName + ' ready (' + versionInfo + ')</div>';
        }

        loadCurrentTabData();
        showModemDetail();
    }

    function extractClusterNo(clusterName) {
        if (!clusterName) return 0;
        var cleanName = clusterName.replace(/\s/g, '').toLowerCase();
        var match = cleanName.match(/cluster_?(\d+)/i);
        if (match && match[1]) {
            return parseInt(match[1], 10);
        }
        return 0;
    }

