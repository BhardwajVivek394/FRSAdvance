    function formatDateForApi(date) {
        const day = String(date.getDate()).padStart(2, '0');
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const year = date.getFullYear();
        return `${day}-${month}-${year}`;
    }

    function formatDuration(seconds) {
        if (!seconds || isNaN(seconds) || seconds <= 0) return '0s';
        seconds = Math.round(seconds);
        if (seconds < 60) return `${seconds}s`;
        const hours = Math.floor(seconds / 3600);
        const minutes = Math.floor((seconds % 3600) / 60);
        if (hours > 0) return `${hours}h ${minutes}m`;
        return `${minutes}m`;
    }

    function formatPercentage(value) {
        if (!value || isNaN(value)) return '0.0%';
        return `${value.toFixed(1)}%`;
    }

    // ========== CALCULATION ==========

    function calculateUptimeStats(historyData) {
        if (!historyData || historyData.length === 0) {
            return { totalSeconds: 0, uptimeSeconds: 0, downtimeSeconds: 0, uptimePercentage: 0, dataPoints: 0 };
        }

        const sorted = historyData.slice().sort((a, b) => new Date(a.TimeStamp) - new Date(b.TimeStamp));
        const firstTime = new Date(sorted[0].TimeStamp);
        const lastTime = new Date(sorted[sorted.length - 1].TimeStamp);
        const now = new Date();

        let totalSeconds = Math.max(60, Math.floor((now - firstTime) / 1000));
        let uptimeSeconds = 0;
        let downtimeSeconds = 0;
        const GAP_THRESHOLD = 5 * 60 * 1000;

        for (let i = 1; i < sorted.length; i++) {
            const gap = new Date(sorted[i].TimeStamp) - new Date(sorted[i - 1].TimeStamp);
            const gapSec = Math.floor(gap / 1000);

            if (gap <= GAP_THRESHOLD) {
                uptimeSeconds += gapSec;
            } else {
                uptimeSeconds += 60;
                downtimeSeconds += Math.max(0, gapSec - 60);
            }
        }

        const sinceLastRecord = Math.floor((now - lastTime) / 1000);
        if (sinceLastRecord <= 300) {
            uptimeSeconds += sinceLastRecord;
        } else {
            downtimeSeconds += sinceLastRecord;
        }

        totalSeconds = Math.max(totalSeconds, uptimeSeconds + downtimeSeconds);
        const uptimePercentage = totalSeconds > 0 ? Math.min(100, (uptimeSeconds / totalSeconds) * 100) : 0;

        return { totalSeconds, uptimeSeconds, downtimeSeconds, uptimePercentage, dataPoints: sorted.length };
    }

    // ========== API CALL ==========

    function fetchA10History(clusterId, a10Id, modemId) {
        return new Promise((resolve) => {
            const today = formatDateForApi(new Date());
            const url = `${API_URL}?clusterId=${clusterId}&a10Id=${a10Id}&ModemId=${modemId || ''}&fromDate=${today}&toDate=${today}`;

            $.ajax({
                url: url,
                type: 'GET',
                dataType: 'json',
                timeout: 15000,
                success: function (response) {
                    let data = [];
                    if (Array.isArray(response)) {
                        data = response;
                    } else if (response && response.Success && response.Data) {
                        data = response.Data;
                    }
                    resolve({ clusterId, a10Id, data });
                },
                error: function () {
                    resolve({ clusterId, a10Id, data: [] });
                }
            });
        });
    }

    // ========== UI UPDATES ==========

    function updateA10UI(a10Id, stats) {
