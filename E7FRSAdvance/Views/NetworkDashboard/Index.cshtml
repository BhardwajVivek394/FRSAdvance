    function formatA10Response(json, cmdType) {
        var output = '';

        if (json.id !== undefined) {
            output += 'ID: ' + json.id + '\n';
        }

        if (json.ts !== undefined) {
            var timestamp = json.ts;
            var date = new Date(timestamp * 1000);

            var day = ('0' + date.getUTCDate()).slice(-2);
            var month = ('0' + (date.getUTCMonth() + 1)).slice(-2);
            var year = date.getUTCFullYear();
            var hours = ('0' + date.getUTCHours()).slice(-2);
            var minutes = ('0' + date.getUTCMinutes()).slice(-2);
            var seconds = ('0' + date.getUTCSeconds()).slice(-2);

            var formattedDate = day + '/' + month + '/' + year + ', ' + hours + ':' + minutes + ':' + seconds + ' GMT';
            output += 'Timestamp: ' + timestamp + ' (' + formattedDate + ')\n';
        }

        if (json.response !== undefined) {
            output += 'Response: ' + json.response + '\n';
        }

        if (json.ver !== undefined) {
            output += 'Firmware Version: ' + json.ver + '\n';
        }

        if (json.mode !== undefined) {
            output += 'Mode: ' + json.mode + '\n';
        }

        if (json.offset !== undefined) {
            output += 'Offset: ' + json.offset + '\n';
        }

        if (json.div !== undefined) {
            output += 'Divisor: ' + json.div + '\n';
        }

        if (json.mul !== undefined) {
            output += 'Multiplier: ' + json.mul + '\n';
        }

        if (json.threshold !== undefined) {
            output += 'Threshold: ' + json.threshold + '\n';
        }

        if (json.channel !== undefined) {
            output += 'Channel: ' + json.channel + '\n';
        }

        if (json.type !== undefined) {
            output += 'Type: ' + json.type + '\n';
        }

        if (json.run_ms !== undefined) {
            output += 'Run Time: ' + json.run_ms + 'ms\n';
        }

        if (json.channels !== undefined) {
            output += 'Channels: ' + JSON.stringify(json.channels, null, 2) + '\n';
        }

        if (json.values !== undefined) {
            if (Array.isArray(json.values) && json.values.length > 20) {
                output += 'Values: [' + json.values.length + ' items]\n';
                output += '  First 10: ' + json.values.slice(0, 10).join(', ') + '...\n';
            } else {
                output += 'Values: ' + JSON.stringify(json.values) + '\n';
            }
        }

        if (output === '') {
            output = JSON.stringify(json, null, 2);
        }

        return output.trim();
    }

