    function initA10Modals() {
        var pinModalEl = document.getElementById('pinModalBS');
        if (pinModalEl) {
            pinModalBS = new bootstrap.Modal(pinModalEl);

            document.getElementById('pinConfirmBtnBS').addEventListener('click', function () {
                var pin = parseInt(document.getElementById('a10PinInputBS').value) || 1;
                pinModalBS.hide();
                executeA10CmdBS(pendingA10CmdBS, pin);
            });

            document.getElementById('a10PinInputBS').addEventListener('keypress', function (e) {
                if (e.key === 'Enter') {
                    document.getElementById('pinConfirmBtnBS').click();
                }
            });
        }

        var timeSetModalEl = document.getElementById('timeSetModalBS');
        if (timeSetModalEl) {
            timeSetModalBS = new bootstrap.Modal(timeSetModalEl);

            document.getElementById('timeSetConfirmBtnBS').addEventListener('click', function () {
                sendTimeSetCommand();
            });

            document.getElementById('a10DateInputBS').addEventListener('change', updateEpochPreview);
            document.getElementById('a10TimeInputBS').addEventListener('change', updateEpochPreview);
        }
    }

    function sendA10CmdBS(cmdType) {
        if (!currentA10) {
            logA10Console('error', 'No A10 selected');
            return;
        }

        if (currentA10.modemVersion === '1') {
            logA10Console('error', 'A10 commands not available for V1 Modem');
            return;
        }

        if (cmdType === 'channel_set') {
            showChannelSetModal();
            return;
        }

        if (cmdType === 'time_set') {
            showTimeSetModal();
            return;
        }

        if (noPinCommands.indexOf(cmdType) !== -1) {
            executeA10CmdBS(cmdType, 1);
            return;
        }

        if (pinCommands.indexOf(cmdType) !== -1) {
            if (!pinModalBS) {
                logA10Console('error', 'PIN modal not found');
                return;
            }
            pendingA10CmdBS = cmdType;
            document.getElementById('a10PinInputBS').value = '1';
            pinModalBS.show();
            return;
        }

        executeA10CmdBS(cmdType, 1);
    }

    function showTimeSetModal() {
        if (!timeSetModalBS) {
            logA10Console('error', 'Time set modal not found');
            return;
        }

        setCurrentTimeBS();
        timeSetModalBS.show();
    }

    function setCurrentTimeBS() {
        var now = new Date();

        var year = now.getFullYear();
        var month = ('0' + (now.getMonth() + 1)).slice(-2);
        var day = ('0' + now.getDate()).slice(-2);
        var dateStr = year + '-' + month + '-' + day;

        var hours = ('0' + now.getHours()).slice(-2);
        var minutes = ('0' + now.getMinutes()).slice(-2);
        var timeStr = hours + ':' + minutes;

        document.getElementById('a10DateInputBS').value = dateStr;
        document.getElementById('a10TimeInputBS').value = timeStr;

        updateEpochPreview();
    }

    function updateEpochPreview() {
        var dateVal = document.getElementById('a10DateInputBS').value;
        var timeVal = document.getElementById('a10TimeInputBS').value;

        var previewEl = document.getElementById('epochPreviewBS');

        if (!dateVal || !timeVal) {
            previewEl.textContent = 'Epoch: --';
            return;
        }

        var dateTime = new Date(dateVal + 'T' + timeVal);
        var epoch = Math.floor(dateTime.getTime() / 1000);

        previewEl.textContent = 'Epoch: ' + epoch;
    }

    function sendTimeSetCommand() {
        var dateVal = document.getElementById('a10DateInputBS').value;
        var timeVal = document.getElementById('a10TimeInputBS').value;

        if (!dateVal || !timeVal) {
            logA10Console('error', 'Please select date and time');
            return;
        }

        var dateTime = new Date(dateVal + 'T' + timeVal);
        var epoch = Math.floor(dateTime.getTime() / 1000);

        timeSetModalBS.hide();

        var cmd = {
            id: parseInt(currentA10.id) || 1,
            time_set: epoch
        };

        logA10Console('info', 'Setting time to: ' + dateTime.toLocaleString() + ' (Epoch: ' + epoch + ')');
        sendA10Command(JSON.stringify(cmd));
    }

    function executeA10CmdBS(cmdType, value) {
        var cmd = {
            id: parseInt(currentA10.id) || 1
        };

        switch (cmdType) {
            case 'time_get':
                cmd.time_get = value;
                break;
            case 'fw_get':
                cmd.fw_get = value;
                break;
            case 'event_get':
                cmd.event_get = value;
                break;
            case 'event_clear':
                cmd.event_clear = value;
                break;
            case 'channel_get':
                cmd.channel_get = value;
                break;
            case 'channel_get_all':
                cmd.channel_get_all = value;
                break;
            case 'update':
                cmd.update = value;
                break;
            default:
                cmd[cmdType] = value;
        }

        sendA10Command(JSON.stringify(cmd));
    }


