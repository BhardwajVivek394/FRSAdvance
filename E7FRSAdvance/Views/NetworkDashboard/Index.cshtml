    function clearAllPendingCommands(reason) {
        if (modemPendingCommand) {
            completePendingCommand('modem', false, reason);
        }
        if (a10PendingCommand) {
            completePendingCommand('a10', false, reason);
        }
    }

    function completePendingCommand(type, success, data) {
        if (type === 'modem') {
            if (modemCommandTimeout) {
                clearTimeout(modemCommandTimeout);
                modemCommandTimeout = null;
            }
            if (modemCommandCallback) {
                var cb = modemCommandCallback;
                var pending = modemPendingCommand;
                modemCommandCallback = null;
                modemPendingCommand = null;
                cb(success, data, pending);
            } else {
                modemPendingCommand = null;
            }
        } else if (type === 'a10') {
            if (a10CommandTimeout) {
                clearTimeout(a10CommandTimeout);
                a10CommandTimeout = null;
            }
            if (a10CommandCallback) {
                var cb2 = a10CommandCallback;
                var pending2 = a10PendingCommand;
                a10CommandCallback = null;
                a10PendingCommand = null;
                cb2(success, data, pending2);
            } else {
                a10PendingCommand = null;
            }
        }
    }

    // ================================================================
    // COMMAND PARSING
    // ================================================================

    function parseCommandInfo(command) {
        if (!command || typeof command !== 'string') {
            return null;
        }

        var trimmed = command.trim();

        // AT command (not JSON)
        if (trimmed.charAt(0) !== '{') {
            return {
                isJson: false,
                commandType: 'modem_at',
                rawCommand: command
            };
        }

        // JSON command (A10)
        try {
            var json = JSON.parse(command);
            var info = {
                isJson: true,
                id: 0,
                commandType: 'unknown',
                expectedResponse: null,
                rawCommand: command
            };

            if (json.id !== undefined) {
                info.id = parseInt(json.id);
            } else {
                return null;
            }

            // Time Commands
            if (json.time_get !== undefined) {
                info.commandType = 'time_get';
                info.expectedResponse = 'time_get_ok';
            } else if (json.time_set !== undefined) {
                info.commandType = 'time_set';
                info.expectedResponse = 'time_set_ok';
            } else if (json.fw_get !== undefined) {
                info.commandType = 'fw_get';
                info.expectedResponse = 'fw_get_ok';
            }
            // Event Commands
            else if (json.event_get !== undefined) {
                info.commandType = 'event_get';
                info.expectedResponse = 'event';
            } else if (json.event_clear !== undefined) {
                info.commandType = 'event_clear';
                info.expectedResponse = 'event_clear_ok';
            }
            // Channel Commands
            else if (json.channel_get !== undefined) {
                info.commandType = 'channel_get';
                info.expectedResponse = 'channel_get_ok';
            } else if (json.channel_get_all !== undefined) {
                info.commandType = 'channel_get_all';
                info.expectedResponse = 'channel_get_ok';
            } else if (json.channel_set !== undefined) {
                info.commandType = 'channel_set';
                info.expectedResponse = 'channel_set_ok';
            }
            // Update Command
            else if (json.update !== undefined) {
                info.commandType = 'update';
                info.expectedResponse = 'update';
            }

            return info;
        } catch (e) {
            console.log("[MQTT] Parse error: " + e.message);
            return null;
        }
    }

    // ================================================================
    // RESPONSE VALIDATION
    // ================================================================

    function validateMqttResponse(responseJson, cmdInfo) {
        if (!cmdInfo || !cmdInfo.isJson) {
            return responseJson && responseJson.length > 0;
        }

        try {
            var json = JSON.parse(responseJson);

            if (json.id === undefined) {
                return false;
            }

            if (parseInt(json.id) !== cmdInfo.id) {
                return false;
            }

            var responseField = json.response || null;

            switch (cmdInfo.commandType) {
                case 'time_get':
                    return responseField === 'time_get_ok' || json.ts !== undefined;

                case 'time_set':
                    return responseField === 'time_set_ok';

                case 'fw_get':
                    return responseField === 'fw_get_ok' || json.ver !== undefined;

                case 'event_get':
                    return json.values !== undefined || json.event !== undefined || json.ts !== undefined || json.channel !== undefined;

                case 'event_clear':
                    return responseField === 'event_clear_ok' || json.event_clear_ok !== undefined;

                case 'channel_get':
                    return responseField === 'channel_get_ok' || json.mode !== undefined;

                case 'channel_get_all':
                    return responseField === 'channel_get_ok' || json.channels !== undefined;

                case 'channel_set':
                    return responseField === 'channel_set_ok';

                case 'update':
                    return json.ts !== undefined || json.update_ok !== undefined || responseField !== null || json.type !== undefined;

                default:
                    return true;
            }
        } catch (e) {
            return false;
        }
    }

    // ================================================================
    // TOPIC SUBSCRIPTION
    // ================================================================

    function subscribeToTopic(topic, callback) {
        if (subscribedTopics[topic]) {
            if (callback) callback(true);
            return;
        }

        mqttClient.subscribe(topic, {
            qos: 1,
            onSuccess: function () {
                subscribedTopics[topic] = true;
                console.log("[MQTT] Subscribed: " + topic);
                if (callback) callback(true);
            },
            onFailure: function (err) {
                console.log("[MQTT] Subscribe failed: " + err.errorMessage);
                if (callback) callback(false, err.errorMessage);
            }
        });
    }

    // ================================================================
    // CORE SEND FUNCTION
    // ================================================================

    function sendMqttCommandInternal(type, mqttBasePath, clusterName, command, callback) {
        if (!mqttBasePath) {
            if (callback) callback(false, 'MQTT path not configured', 0);
            return;
        }

        if (!clusterName) {
            if (callback) callback(false, 'Cluster name not configured', 0);
            return;
        }

        // Build topics
        var basePath = mqttBasePath.replace(/\/+$/, '');
        var cleanClusterName = clusterName.replace(/\s+/g, '');
        var responseTopic = basePath + "/" + cleanClusterName + "/P";  // Subscribe for response
        var commandTopic = basePath + "/" + cleanClusterName + "/S";   // Publish command

        var sentAt = Date.now();

        // Store pending command
        var pendingCmd = {
            command: command,
            responseTopic: responseTopic,
            commandTopic: commandTopic,
            sentAt: sentAt,
            callback: callback,
            timeoutId: null
        };

        // Connect if not connected
        if (!mqttConnected || !mqttClient) {
            initMqttConnection(function (connected, error) {
                if (connected) {
                    executeMqttSendPaho(pendingCmd);
                } else {
                    if (callback) callback(false, 'MQTT connection failed: ' + (error || 'Unknown'), 0);
                }
            });
            return;
        }

        executeMqttSendPaho(pendingCmd);
    }

    function executeMqttSendPaho(pendingCmd) {
        var responseTopic = pendingCmd.responseTopic;
        var commandTopic = pendingCmd.commandTopic;
        var command = pendingCmd.command;
        var callback = pendingCmd.callback;

        // Store in pending commands BEFORE subscribing
        mqttPendingCommands[responseTopic] = pendingCmd;

        try {
            // Subscribe to response topic
            mqttClient.subscribe(responseTopic, {
                qos: 0,
                onSuccess: function () {
                    console.log('MQTT Subscribed to:', responseTopic);

                    try {
                        // Send message directly using send(topic, payload, qos, retained)
                        mqttClient.send(commandTopic, command, 0, false);
                        console.log('MQTT Published to:', commandTopic, 'Command:', command);

                        // Set timeout for response
                        pendingCmd.timeoutId = setTimeout(function () {
                            // Timeout - no response received
                            try {
                                mqttClient.unsubscribe(responseTopic);
                            } catch (e) { }
                            delete mqttPendingCommands[responseTopic];
                            if (callback) callback(false, 'Timeout - No response', Date.now() - pendingCmd.sentAt);
                        }, MQTT_TIMEOUT);

                    } catch (pubErr) {
                        console.error('MQTT Publish Error:', pubErr);
                        try { mqttClient.unsubscribe(responseTopic); } catch (e) { }
                        delete mqttPendingCommands[responseTopic];
                        if (callback) callback(false, 'Publish failed: ' + pubErr.message, 0);
                    }
                },
                onFailure: function (err) {
                    console.error('MQTT Subscribe Error:', err);
                    delete mqttPendingCommands[responseTopic];
                    if (callback) callback(false, 'Subscribe failed: ' + err.errorMessage, 0);
                }
            });

        } catch (err) {
            console.error('MQTT Error:', err);
            delete mqttPendingCommands[responseTopic];
            if (callback) callback(false, 'MQTT error: ' + err.message, 0);
        }
    }
