        var protocolFilter = document.getElementById('modemHistoryProtocolFilter');
        if (protocolFilter) {
            protocolFilter.value = 'all';
        }

        $.ajax({
            url: '/NetworkDashboard/ModemHistory',
            type: 'GET',
            data: {
                clusterId: clusterId,
                fromDate: fromDate,
                toDate: toDate
            },
            success: function (response) {
                // If API returns JSON data
                if (typeof response === 'object') {
                    modemHistoryData = response.data || response;
                    // Normalize protocol field for each record
                    modemHistoryData = normalizeHistoryData(modemHistoryData);
                    renderModemHistory(modemHistoryData);
                } else {
                    // If API returns HTML directly
                    $('#modemHistoryContainer').html(response);
                    // Extract data from the rendered HTML for filtering
                    extractHistoryDataFromHtml();
                }
            },
            error: function (xhr) {
                $('#modemHistoryContainer').html('<div class="text-danger small text-center py-3"><i class="bi bi-exclamation-circle me-1"></i>Error loading history</div>');
                console.error("Error loading history:", xhr.responseText);
            }
        });
    }

    // Normalize data to ensure consistent protocol field
    function normalizeHistoryData(data) {
        if (!Array.isArray(data)) return [];

        return data.map(function (item) {
            // Detect protocol from various possible fields
            var protocol = detectProtocol(item);
            return Object.assign({}, item, { normalizedProtocol: protocol });
        });
    }

    // Detect protocol from various possible field names
    function detectProtocol(item) {
        // Check explicit protocol fields first
        var possibleFields = ['protocol', 'connectionType', 'type', 'Protocol', 'ConnectionType', 'Type'];

        for (var i = 0; i < possibleFields.length; i++) {
            var field = possibleFields[i];
            if (item[field]) {
                var value = item[field].toString().toLowerCase().trim();
                if (value === 'mqtt' || value.includes('mqtt')) return 'mqtt';
                if (value === 'tcp' || value.includes('tcp')) return 'tcp';
            }
        }

        // Check in details/message fields for protocol mentions
        var textFields = ['details', 'message', 'Details', 'Message', 'description', 'Description'];
        for (var j = 0; j < textFields.length; j++) {
            var textField = textFields[j];
            if (item[textField]) {
                var text = item[textField].toString().toLowerCase();
                if (text.includes('mqtt')) return 'mqtt';
                if (text.includes('tcp')) return 'tcp';
            }
        }

        return 'unknown';
    }

    function renderModemHistory(data, currentFilter) {
        var container = document.getElementById('modemHistoryContainer');
        if (!container) return;

        currentFilter = currentFilter || 'all';

        if (!data || data.length === 0) {
            var message = currentFilter === 'all'
                ? 'No history found for the selected date range'
                : 'No ' + currentFilter.toUpperCase() + ' records found';
            container.innerHTML = '<div class="text-muted small text-center py-3"><i class="bi bi-inbox me-1"></i>' + message + '</div>';
            return;
        }

        // Build HTML table
        var html = '<div class="table-responsive"><table class="table table-sm table-hover mb-2">';
        html += '<thead class="table-light"><tr>';
        html += '<th style="width: 160px;">Date/Time</th>';
        html += '<th style="width: 90px;">Protocol</th>';
        html += '<th style="width: 100px;">Status</th>';
        html += '<th>Details</th>';
        html += '</tr></thead>';
        html += '<tbody>';

        data.forEach(function (item) {
            var protocol = item.normalizedProtocol || detectProtocol(item);
            var displayProtocol = item.protocol || item.connectionType || item.type || protocol;

            var protocolBadge;
            if (protocol === 'mqtt') {
                protocolBadge = '<span class="badge bg-success">MQTT</span>';
            } else if (protocol === 'tcp') {
                protocolBadge = '<span class="badge bg-info">TCP</span>';
            } else {
                protocolBadge = '<span class="badge bg-secondary">' + displayProtocol.toUpperCase() + '</span>';
            }

            html += '<tr data-protocol="' + protocol + '">';
            html += '<td class="text-nowrap">' + (item.dateTime || item.timestamp || item.DateTime || item.Timestamp || '') + '</td>';
            html += '<td>' + protocolBadge + '</td>';
            html += '<td>' + (item.status || item.Status || '') + '</td>';
            html += '<td class="text-truncate" style="max-width: 200px;" title="' + escapeHtml(item.details || item.message || item.Details || item.Message || '') + '">' + (item.details || item.message || item.Details || item.Message || '') + '</td>';
            html += '</tr>';
        });

        html += '</tbody></table></div>';

        // Footer with count and filter info
        html += '<div class="d-flex justify-content-between align-items-center text-muted small">';
        html += '<span>Showing: <strong id="historyRecordCount">' + data.length + '</strong> records<span id="historyFilterInfo"></span></span>';

        // Show total if filtered
        if (currentFilter !== 'all' && modemHistoryData.length !== data.length) {
            html += '<span class="text-secondary">Total: ' + modemHistoryData.length + '</span>';
        }
        html += '</div>';

        container.innerHTML = html;
    }

