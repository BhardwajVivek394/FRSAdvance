    function initSidebarSearch() {
        var searchInput = document.getElementById("sidebarSearch");

        if (!searchInput) {
            console.log('Search input not found');
            return;
        }

        //searchInput.addEventListener("input", function () {
        //    var value = this.value.toLowerCase().trim();
        //    performSidebarSearch(value);
        //});
        var searchDebounceTimer = null;
        searchInput.addEventListener("input", function () {
            var value = this.value.toLowerCase().trim();
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(function () {
                performSidebarSearch(value);
            }, 300);
        });
    }

    function performSidebarSearch(searchValue) {
        var container = document.getElementById("sidebarTreeContainer");
        var originalTree = document.getElementById("originalTree");

        var existingResults = container.querySelector(".search-results-section");
        if (existingResults) {
            existingResults.remove();
        }

        var existingNoResults = container.querySelector(".no-search-results");
        if (existingNoResults) {
            existingNoResults.remove();
        }

        var headerDiv = container.querySelector(".text-uppercase");

        if (searchValue === "") {
            if (originalTree) {
                originalTree.style.display = "block";
            }
            var treeItems = document.querySelectorAll(".tree-item");
            var treeChildren = document.querySelectorAll(".tree-children");
            for (var i = 0; i < treeItems.length; i++) {
                treeItems[i].removeAttribute("style");
            }
            for (var j = 0; j < treeChildren.length; j++) {
                treeChildren[j].classList.remove("show");
                treeChildren[j].removeAttribute("style");
            }
            return;
        }

        if (originalTree) {
            originalTree.style.display = "none";
        }

        var treeItems = document.querySelectorAll(".tree-item");
        var matchedZones = [];
        var matchedDivisions = [];
        var matchedSites = [];

        for (var m = 0; m < treeItems.length; m++) {
            var item = treeItems[m];
            var itemType = item.getAttribute("data-type");
            var itemName = getItemName(item);

            if (itemName.toLowerCase().indexOf(searchValue) !== -1) {
                var matchData = {
                    name: itemName,
                    type: itemType,
                    element: item,
                    path: getItemPath(item, itemType)
                };

                if (itemType === "zone") {
                    matchedZones.push(matchData);
                } else if (itemType === "division") {
                    matchedDivisions.push(matchData);
                } else if (itemType === "site") {
                    matchedSites.push(matchData);
                }
            }
        }

        var totalMatches = matchedZones.length + matchedDivisions.length + matchedSites.length;

        if (totalMatches === 0) {
            var noResultsDiv = document.createElement("div");
            noResultsDiv.className = "no-search-results text-center py-4";
            noResultsDiv.innerHTML = '<i class="bi bi-search fs-4 d-block mb-2 opacity-50"></i>' +
                '<div class="small text-muted">No results found for</div>' +
                '<div class="small card-value">"' + escapeHtml(searchValue) + '"</div>';
            if (headerDiv) {
                headerDiv.insertAdjacentElement("afterend", noResultsDiv);
            }
            return;
        }

        var resultsSection = document.createElement("div");
        resultsSection.className = "search-results-section";

        var resultsHeader = '<div class="search-results-header px-2 py-2 mb-1">' +
            '<span class="small text-muted">Found </span>' +
            '<span class="small text-success fw-semibold">' + totalMatches + ' results</span>' +
            '<span class="small text-muted"> for "' + escapeHtml(searchValue) + '"</span>' +
            '</div>';

        resultsSection.innerHTML = resultsHeader;

        if (matchedZones.length > 0) {
            var zoneSection = createResultSection("Zones", matchedZones, "bi-globe-americas", "text-info", searchValue);
            resultsSection.appendChild(zoneSection);
        }

        if (matchedDivisions.length > 0) {
            var divisionSection = createResultSection("Divisions", matchedDivisions, "bi-building", "text-primary", searchValue);
            resultsSection.appendChild(divisionSection);
        }

        if (matchedSites.length > 0) {
            var siteSection = createResultSection("Stations", matchedSites, "bi-buildings", "text-warning", searchValue);
            resultsSection.appendChild(siteSection);
        }

        if (headerDiv) {
            headerDiv.insertAdjacentElement("afterend", resultsSection);
        }
    }

    function createResultSection(title, items, iconClass, colorClass, searchValue) {
        var section = document.createElement("div");
        section.className = "search-result-group mb-2";

        var html = '<div class="search-result-title px-2 py-1">' +
            '<span class="small text-muted text-uppercase" style="font-size: 0.6rem;">' + title + ' (' + items.length + ')</span>' +
            '</div>';

        for (var i = 0; i < items.length; i++) {
            var item = items[i];
            var pathHtml = item.path ? '<div class="small text-muted" style="font-size: 0.65rem;">' + escapeHtml(item.path) + '</div>' : '';

            html += '<div class="search-result-item d-flex align-items-center gap-2 px-2 py-2" ' +
                'onclick="onSearchResultClick(this)" ' +
                'data-type="' + item.type + '" ' +
                'data-name="' + escapeHtml(item.name) + '">' +
                '<i class="bi ' + iconClass + ' ' + colorClass + '"></i>' +
                '<div class="flex-grow-1">' +
                '<div class="small card-value">' + highlightMatch(item.name, searchValue) + '</div>' +
                pathHtml +
                '</div>' +
                '<i class="bi bi-chevron-right small text-muted"></i>' +
                '</div>';
        }

        section.innerHTML = html;
        return section;
    }

    function getItemName(item) {
        var itemType = item.getAttribute("data-type");

        if (itemType === "zone") {
            return item.getAttribute("data-zone-name") || "";
        } else if (itemType === "division") {
            return item.getAttribute("data-division-name") || "";
        } else if (itemType === "site") {
            return item.getAttribute("data-site-name") || "";
        }

        var span = item.querySelector("span.flex-grow-1");
        return span ? span.innerText.trim() : "";
    }

    function getItemPath(item, itemType) {
        if (itemType === "zone") {
            return "";
        }

        var path = [];
        var parent = item.parentElement;

        while (parent) {
            if (parent.classList.contains("tree-children")) {
                var parentItem = parent.previousElementSibling;
                if (parentItem && parentItem.classList.contains("tree-item")) {
                    var parentName = getItemName(parentItem);
                    if (parentName) {
                        path.unshift(parentName);
                    }
                }
            }
            parent = parent.parentElement;

            if (parent && (parent.classList.contains("sidebar") || parent.id === "sidebarTreeContainer" || parent.id === "originalTree")) {
                break;
            }
        }

        return path.length > 0 ? path.join(" / ") : "";
    }

    function highlightMatch(text, searchValue) {
        if (!searchValue) return escapeHtml(text);

        var lowerText = text.toLowerCase();
        var lowerSearch = searchValue.toLowerCase();
        var index = lowerText.indexOf(lowerSearch);

        if (index === -1) return escapeHtml(text);

        var before = text.substring(0, index);
        var match = text.substring(index, index + searchValue.length);
        var after = text.substring(index + searchValue.length);

        return escapeHtml(before) + '<span class="search-highlight">' + escapeHtml(match) + '</span>' + escapeHtml(after);
    }

    function onSearchResultClick(element) {
        var name = element.getAttribute("data-name");
        var type = element.getAttribute("data-type");

        clearSidebarSearch();

        var treeItems = document.querySelectorAll(".tree-item");

        for (var i = 0; i < treeItems.length; i++) {
            var item = treeItems[i];
            var itemName = getItemName(item);
            var itemType = item.getAttribute("data-type");

            if (itemName === name && itemType === type) {
                showParentChain(item);

                item.classList.add("search-selected");

                setTimeout(function () {
                    item.scrollIntoView({ behavior: "smooth", block: "center" });
                }, 100);

                item.click();

                setTimeout(function () {
                    item.classList.remove("search-selected");
                }, 2000);

                break;
            }
        }
    }

    function showParentChain(element) {
        var parent = element.parentElement;

        while (parent) {
            if (parent.classList.contains("tree-children")) {
                parent.classList.add("show");

                var parentItem = parent.previousElementSibling;
                if (parentItem && parentItem.classList.contains("tree-item")) {
                    parentItem.classList.add("expanded");

                    var toggleIcon = parentItem.querySelector(".tree-toggle");
                    if (toggleIcon) {
                        toggleIcon.classList.remove("bi-chevron-right");
                        toggleIcon.classList.add("bi-chevron-down");
                    }
                }
            }

            parent = parent.parentElement;

            if (parent && parent.classList.contains("sidebar")) {
                break;
            }
        }
    }

