    function handleNoResultsMessage(container, visibleCount, totalCount, filterValue) {
        var noResultsMsg = container.querySelector('.no-filter-results');

        if (visibleCount === 0 && totalCount > 0) {
            // Show no results message
            if (!noResultsMsg) {
                noResultsMsg = document.createElement('div');
                noResultsMsg.className = 'no-filter-results small text-center py-3';
                noResultsMsg.innerHTML = '<i class="bi bi-funnel opacity-50 d-block mb-2" style="font-size: 1.5rem;"></i><span>No records for "' + filterValue.toUpperCase() + '" filter</span>';
                container.appendChild(noResultsMsg);
            } else {
                noResultsMsg.querySelector('span').textContent = 'No records for "' + filterValue.toUpperCase() + '" filter';
                noResultsMsg.style.display = '';
            }
        } else if (noResultsMsg) {
            noResultsMsg.style.display = 'none';
        }
    }

    // Call this after loading modem history partial view via AJAX
    function updateModemConsoleInfo() {
        var infoEl = document.getElementById('modemConsoleInfoBS');
        if (!infoEl || !currentModem) return;

        if (selectedModemProtocol === 'tcp') {
            infoEl.textContent = 'TCP: Port ' + (currentModem.tcpSendPort || '5000') + '→' + (currentModem.tcpRecvPort || '5001');
        } else {
            var clusterName = currentModem.clusterName || '';
            clusterName = clusterName.replace(/\s/g, '');
            infoEl.textContent = 'MQTT: ' + clusterName;
        }
    }

