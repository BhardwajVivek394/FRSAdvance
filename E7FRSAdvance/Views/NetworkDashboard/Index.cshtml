    // ================================================================
    // MQTT CONNECTION MANAGEMENT
    // ================================================================
    function toggleMqttBrokerConnection() {
        if (mqttBrokerConnected) {
            disconnectMqttBroker();
        } else {
            connectMqttBroker();
        }
    }

    function connectMqttBroker() {
        if (mqttBrokerConnecting || mqttBrokerConnected) return;
        mqttBrokerConnecting = true;
        updateMqttBrokerUI();

        // Detect protocol and select correct port
        var isSecure = window.location.protocol === "https:";
        var port = mQTT.MQTTPort;
        var protocol = isSecure ? 'wss' : 'ws';

        logMqttBroker('Connecting to ' + mQTT.MQTTUri + ':' + port + ' (' + protocol + ')...', 'sys');

        var clientId = "MqttBroker_" + mqttBrokerDeviceType + "_" + Math.random().toString(36).substring(2, 10) + "_" + Date.now();
        console.log("[MQTT Broker] Connecting - Host:", mQTT.MQTTUri, "Port:", port, "SSL:", isSecure, "ClientID:", clientId);

        try {
            mqttBrokerClient = new Paho.Client(mQTT.MQTTUri, port, clientId);
            mqttBrokerClient.onConnectionLost = onMqttBrokerConnectionLost;
            mqttBrokerClient.onMessageArrived = onMqttBrokerMessageArrived;
            mqttBrokerClient.connect({
                onSuccess: onMqttBrokerConnected,
                onFailure: onMqttBrokerConnectFailure,
                useSSL: isSecure,
                userName: mQTT.MQTTUsername,
                password: mQTT.MQTTPassword,
                cleanSession: true,
                timeout: 30,
                keepAliveInterval: 60
            });
        } catch (e) {
            mqttBrokerConnecting = false;
            logMqttBroker('Connection error: ' + e.message, 'err');
            console.error("[MQTT Broker] Connection error:", e);
            mqttBrokerErrCount++;
            updateMqttBrokerUI();
        }
    }

    function onMqttBrokerConnected() {
        mqttBrokerConnected = true;
        mqttBrokerConnecting = false;
        var isSecure = window.location.protocol === "https:";
        var port = isSecure ? mQTT.PortWSS : mQTT.PortWS;
        logMqttBroker('✓ Connected to ' + mQTT.MQTTUri + ':' + port, 'sys');
        logMqttBroker('Click "Subscribe" to start receiving messages, or enter a command to publish.', 'info');
        console.log("[MQTT Broker] Connected successfully");
        updateMqttBrokerUI();
    }
    function onMqttBrokerConnectFailure(error) {
        mqttBrokerConnected = false;
        mqttBrokerConnecting = false;
        logMqttBroker('✗ Connection failed: ' + error.errorMessage, 'err');
        console.error("[MQTT Broker] Connection failed:", error.errorMessage);
        mqttBrokerErrCount++;
        updateMqttBrokerUI();
    }
    function onMqttBrokerConnectionLost(responseObject) {
        mqttBrokerConnected = false;
        mqttBrokerSubscribed = false;
        logMqttBroker('✗ Connection lost: ' + responseObject.errorMessage, 'err');
        console.log("[MQTT Broker] Connection lost:", responseObject.errorMessage);
        mqttBrokerErrCount++;
        updateMqttBrokerUI();

        // Auto-reconnect after delay
        setTimeout(function () {
            if (!mqttBrokerConnected && !mqttBrokerConnecting) {
                logMqttBroker('Attempting to reconnect...', 'sys');
                connectMqttBroker();
            }
        }, mQTT.ReconnectDelay || 5000);
    }
    function disconnectMqttBroker() {
        if (mqttBrokerClient && mqttBrokerConnected) {
            try {
                mqttBrokerClient.disconnect();
                logMqttBroker('Disconnected by user', 'sys');
            } catch (e) {
                console.error("[MQTT Broker] Disconnect error:", e);
            }
        }
        mqttBrokerConnected = false;
        mqttBrokerSubscribed = false;
        updateMqttBrokerUI();
    }
    // ================================================================
    // MESSAGE HANDLING - Receives messages from /P topic
    // ================================================================
    function onMqttBrokerMessageArrived(message) {
        var topic = message.destinationName;
        var payload = message.payloadString;

        console.log("[MQTT Broker] IN - Topic:", topic);
        console.log("[MQTT Broker] IN - Payload:", payload);

        mqttBrokerInCount++;
        mqttBrokerMsgCount++;

        // Try to format JSON nicely
        var displayPayload = payload;
        try {
            var json = JSON.parse(payload);

            // For A10, format the response nicely
            if (mqttBrokerDeviceType === 'a10') {
                displayPayload = formatA10ResponseForConsole(json);
            } else {
                displayPayload = JSON.stringify(json, null, 2);
            }
        } catch (e) {
            // Not JSON, use as-is (modem AT command responses)
        }

        var topicShort = topic.split('/').pop();
        logMqttBroker('← [' + topicShort + '] ' + displayPayload, 'in');
        updateMqttBrokerUI();
    }

    function formatA10ResponseForConsole(json) {
        var lines = [];

        if (json.id !== undefined) {
            lines.push('ID: ' + json.id);
        }

        if (json.response !== undefined) {
            lines.push('Response: ' + json.response);
        }

        if (json.ts !== undefined) {
            var date = new Date(json.ts * 1000);
            lines.push('Timestamp: ' + json.ts + ' (' + date.toLocaleString() + ')');
        }

        if (json.ver !== undefined) {
            lines.push('Firmware: ' + json.ver);
        }

        if (json.mode !== undefined) {
            lines.push('Mode: ' + json.mode);
        }

        if (json.threshold !== undefined) {
            lines.push('Threshold: ' + json.threshold);
        }

        if (json.mul !== undefined) {
            lines.push('Multiplier: ' + json.mul);
        }

        if (json.div !== undefined) {
            lines.push('Divisor: ' + json.div);
        }

        if (json.offset !== undefined) {
            lines.push('Offset: ' + json.offset);
        }

        if (json.channels !== undefined) {
            lines.push('Channels: ' + JSON.stringify(json.channels));
        }

        if (json.values !== undefined) {
            if (Array.isArray(json.values) && json.values.length > 10) {
                lines.push('Values: [' + json.values.length + ' items]');
                lines.push('  First 5: ' + json.values.slice(0, 5).join(', ') + '...');
            } else {
                lines.push('Values: ' + JSON.stringify(json.values));
            }
        }

        if (lines.length === 0) {
            return JSON.stringify(json, null, 2);
        }

        return lines.join('\n');
    }

    // ================================================================
    // SUBSCRIBE / UNSUBSCRIBE - Uses /P topic (topicToSubscribe)
    // ================================================================
    function toggleMqttSubscription() {
        if (!mqttBrokerConnected) {
            logMqttBroker('Not connected. Please connect first.', 'err');
            return;
        }

        if (!mqttBrokerTopics.topicToSubscribe) {
            logMqttBroker('No subscribe topic configured', 'err');
            return;
        }

        if (mqttBrokerSubscribed) {
            unsubscribeMqttBroker();
        } else {
            subscribeMqttBroker();
        }
    }

    function subscribeMqttBroker() {
        var topic = mqttBrokerTopics.topicToSubscribe;  // /P topic

        logMqttBroker('Subscribing to: ' + topic + '...', 'sys');

        mqttBrokerClient.subscribe(topic, {
            qos: 1,
            onSuccess: function () {
                mqttBrokerSubscribed = true;
                logMqttBroker('✓ Subscribed to: ' + topic, 'sys');
                logMqttBroker('Now listening for incoming messages...', 'info');
                updateMqttBrokerUI();
            },
            onFailure: function (err) {
                logMqttBroker('✗ Subscribe failed: ' + err.errorMessage, 'err');
                mqttBrokerErrCount++;
                updateMqttBrokerUI();
            }
        });
    }

    function unsubscribeMqttBroker() {
        var topic = mqttBrokerTopics.topicToSubscribe;  // /P topic

        mqttBrokerClient.unsubscribe(topic, {
            onSuccess: function () {
                mqttBrokerSubscribed = false;
                logMqttBroker('Unsubscribed from: ' + topic, 'sys');
                updateMqttBrokerUI();
            },
            onFailure: function (err) {
                logMqttBroker('Unsubscribe failed: ' + err.errorMessage, 'err');
                mqttBrokerErrCount++;
                updateMqttBrokerUI();
            }
        });
    }

    // ================================================================
    // PUBLISH - Uses /S topic (topicToPublish)
    // ================================================================
    function publishMqttMessage() {
        var input = document.getElementById('mqttPublishInput');
        var msg = input.value.trim();

        if (!msg) {
            logMqttBroker('Please enter a message/command to publish', 'err');
            return;
        }

        if (!mqttBrokerConnected) {
            logMqttBroker('Not connected. Please connect first.', 'err');
            return;
        }

        if (!mqttBrokerTopics.topicToPublish) {
            logMqttBroker('No publish topic configured', 'err');
            return;
        }

        try {
            var message = new Paho.Message(msg);
            message.destinationName = mqttBrokerTopics.topicToPublish;  // /S topic
            message.qos = 1;
            message.retained = false;

            mqttBrokerClient.send(message);

            mqttBrokerOutCount++;
            mqttBrokerMsgCount++;

            var topicShort = mqttBrokerTopics.topicToPublish.split('/').pop();
            logMqttBroker('→ [' + topicShort + '] ' + msg, 'out');
            console.log("[MQTT Broker] OUT - Topic:", mqttBrokerTopics.topicToPublish, "Msg:", msg);

            input.value = '';
            updateMqttBrokerUI();

            // Auto-subscribe to receive response if not already subscribed
            if (!mqttBrokerSubscribed && mqttBrokerTopics.topicToSubscribe) {
                logMqttBroker('Auto-subscribing to receive response...', 'sys');
                subscribeMqttBroker();
            }
        } catch (e) {
            logMqttBroker('Publish error: ' + e.message, 'err');
            mqttBrokerErrCount++;
            updateMqttBrokerUI();
        }
    }

    // ================================================================
    // MODEM QUICK COMMANDS - Publishes to /S topic
    // ================================================================
    function sendModemQuickCommand(cmd) {
        if (!mqttBrokerConnected) {
            logMqttBroker('Not connected. Please connect first.', 'err');
            return;
        }

        document.getElementById('mqttPublishInput').value = cmd;
        publishMqttMessage();
    }

    // ================================================================
    // A10 QUICK COMMANDS - Publishes JSON to /S topic
    // ================================================================
    function sendA10QuickCommand(cmdType, value) {
        if (!mqttBrokerConnected) {
            logMqttBroker('Not connected. Please connect first.', 'err');
            return;
        }

        var cmd = {
            id: mqttBrokerDeviceId
        };

        switch (cmdType) {
            case 'time_get':
                cmd.time_get = 1;
                break;
            case 'fw_get':
                cmd.fw_get = 1;
                break;
            case 'update':
                cmd.update = 1;
                break;
            case 'channel_get_all':
                cmd.channel_get_all = 1;
                break;
            case 'event_get':
                cmd.event_get = value || 1;
                break;
            case 'event_clear':
                cmd.event_clear = value || 1;
                break;
            default:
                cmd[cmdType] = value || 1;
        }

        var cmdStr = JSON.stringify(cmd);
        document.getElementById('mqttPublishInput').value = cmdStr;
        publishMqttMessage();
    }

