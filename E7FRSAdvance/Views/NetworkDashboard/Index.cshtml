    function executeMqttSend(type, pendingCmd, callback) {
        if (type === 'modem') {
            modemPendingCommand = pendingCmd;
            modemCommandCallback = callback;
        } else if (type === 'a10') {
            a10PendingCommand = pendingCmd;
            a10CommandCallback = callback;
        }

        subscribeToTopic(pendingCmd.responseTopic, function (success, error) {
            if (!success) {
                completePendingCommand(type, false, 'Subscribe failed: ' + error);
                return;
            }

            try {
                var message = new Paho.Message(pendingCmd.command);
                message.destinationName = pendingCmd.commandTopic;
                message.qos = 1;

                mqttClient.send(message);
                console.log("[MQTT] Published: " + pendingCmd.commandTopic + " -> " + pendingCmd.command);

                var timeoutId = setTimeout(function () {
                    completePendingCommand(type, false, 'Command timeout (no response)');
                }, MQTT_CONFIG.commandTimeout);

                if (type === 'modem') {
                    modemCommandTimeout = timeoutId;
                } else if (type === 'a10') {
                    a10CommandTimeout = timeoutId;
                }
            } catch (e) {
                completePendingCommand(type, false, 'Publish failed: ' + e.message);
            }
        });
    }

    // ================================================================
    // MODEM MQTT COMMAND (Replaces server call)
    // ================================================================


    function sendModemCmdMQTT(cmd) {
        if (!selectedModemId) {
            logConsole('error', 'No modem selected');
            return;
        }

        if (!currentModem) {
            logConsole('error', 'Modem data not loaded');
            return;
        }

        if (!currentModem.mqttBase) {
            logConsole('error', 'MQTT base path not configured');
            return;
        }

        // Use modemName if clusterName is null (from API)
        var clusterForMqtt = currentModem.clusterName || currentModem.modemName;
        if (!clusterForMqtt) {
            logConsole('error', 'Cluster/Modem name not configured');
            return;
        }

        logConsole('cmd', '[MQTT] > ' + cmd);

        if (cmdPending) {
            logConsole('error', 'Command in progress...');
            return;
        }

        cmdPending = true;
        var consoleInfo = document.getElementById('modemConsoleInfoBS');

        if (consoleInfo) {
            consoleInfo.innerHTML = '<span class="text-warning">Sending...</span>';
        }

        sendMqttCommandInternal('modem', currentModem.mqttBase, clusterForMqtt, cmd,
            function (success, data, latency) {
                cmdPending = false;

                if (success && data) {
                    try {
                        var json = JSON.parse(data);
                        logConsole('response', JSON.stringify(json, null, 2), latency);

                        // Show signal info if present
                        if (json.CSQ) {
                            var csqParts = json.CSQ.split(',');
                            var rssi = parseInt(csqParts[0]);
                            var signalInfo = getSignalInfo(rssi);
                            logConsole('info', '// Signal: ' + signalInfo.description + ' (' + signalInfo.dbm + ')');
                        }
