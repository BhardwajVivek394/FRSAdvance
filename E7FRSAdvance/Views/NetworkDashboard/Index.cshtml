    function sendA10Command(cmdJson) {
        if (!currentA10) {
            logA10Console('error', 'No A10 selected');
            return;
        }

        if (currentA10.modemVersion === '1') {
            logA10Console('error', 'A10 commands not available for V1 Modem');
            return;
        }

        var mqttBase = currentA10.mqttBase || (currentModem ? currentModem.mqttBase : null);
        var clusterName = currentA10.clusterName || (currentModem ? currentModem.clusterName : null) || (currentModem ? currentModem.modemName : null);

        if (!mqttBase) {
            logA10Console('error', 'MQTT base path not configured');
            return;
        }

        if (!clusterName) {
            logA10Console('error', 'Cluster name not configured');
            return;
        }

        logA10Console('cmd', '[MQTT] > ' + cmdJson);

        if (a10CmdPending) {
            logA10Console('error', 'Command in progress...');
            return;
        }

        a10CmdPending = true;
        var consoleStatus = document.getElementById('a10ConsoleStatusBS');

        if (consoleStatus) {
            consoleStatus.innerHTML = '<span class="text-warning">Sending...</span>';
        }

        sendMqttCommandInternal('a10', mqttBase, clusterName, cmdJson,
            function (success, data, latency) {
                a10CmdPending = false;

                if (success && data) {
                    try {
                        var json = JSON.parse(data);
                        logA10Console('response', JSON.stringify(json, null, 2), latency);
                    } catch (e) {
                        logA10Console('response', data, latency);
                    }

                    if (consoleStatus) {
                        consoleStatus.innerHTML = '<span class="text-success">OK</span> <span class="text-muted">(' + latency + 'ms)</span>';
                    }
                } else {
                    logA10Console('error', data || 'No response (timeout)');
                    if (consoleStatus) {
                        consoleStatus.innerHTML = '<span class="text-danger">Timeout</span>';
                    }
                }
            }
        );

        var tab = document.querySelector('a[href="#a10Command"]');
        if (tab) bootstrap.Tab.getOrCreateInstance(tab).show();
    }

