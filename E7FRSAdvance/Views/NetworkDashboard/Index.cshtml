    function loadDevicePanel(siteId, divisionId, zoneId) {

        // ── Device panel (only when a site is selected) ──────────────
        if (siteId) {
            selectedSiteId = parseInt(siteId) || 0;
            $('.device-panel').html(getDevicePanelSkeletonLoader());

            $.get('/NetworkDashboard/LoadDevices', { siteId: siteId })
                .done(function (data) {
                    $('.device-panel').html(data);
                })
                .fail(function (xhr) {
                    console.error("Error loading devices:", xhr.responseText);
                    $('.device-panel').html(getDevicePanelError());
                });


        }

        // ── Header — skip if same params are already loaded ──────────
        var newParams = {
            zoneId: zoneId || null,
            divisionId: divisionId || null,
            siteId: siteId || null
        };

        var isSame = (
            newParams.zoneId === lastHeaderParams.zoneId &&
            newParams.divisionId === lastHeaderParams.divisionId &&
            newParams.siteId === lastHeaderParams.siteId
        );

        if (isSame || headerLoading) return;   // nothing changed — skip the call

        headerLoading = true;
        lastHeaderParams = newParams;

        $('#filteredHeader').html(getDashboardHeaderSkeletonLoader());

        $.ajax({
            url: '/NetworkDashboard/DashboardHeader',
            type: 'GET',
            data: {
                zoneId: zoneId || null,
                divisionId: divisionId || null,
                siteId: siteId || null
            },
            success: function (data) {
                $('#filteredHeader').html(data);
                headerLoading = false;
            },
            error: function (xhr) {
                console.error("Error loading header:", xhr.responseText);
                $('#filteredHeader').html(getDashboardHeaderError());
                headerLoading = false;
            }
        });
    }

