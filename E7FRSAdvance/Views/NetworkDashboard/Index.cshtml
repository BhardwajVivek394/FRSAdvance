    // Apply Modem Filter
    function applyModemFilter() {
        var modemRows = document.querySelectorAll('.modem-row');
        var visibleModemCount = 0;

        for (var i = 0; i < modemRows.length; i++) {
            var row = modemRows[i];
            var modemHeader = row.querySelector('.modem-header');
            if (!modemHeader) continue;

            // Get modem TCP and MQTT status
            var modemTcpStatus = modemHeader.getAttribute('data-tcp-status') === 'true';
            var modemMqttStatus = modemHeader.getAttribute('data-mqtt-status') === 'true';

            var shouldShowModem = false;

            // CORRECTED LOGIC: Online = ANY one is true, Offline = BOTH are false
            if (currentModemFilter === 'All') {
                shouldShowModem = true;
            } else if (currentModemFilter === 'Online') {
                // Online = TCP OR MQTT is true (any one)
                shouldShowModem = (modemTcpStatus || modemMqttStatus);
            } else if (currentModemFilter === 'Offline') {
                // Offline = BOTH TCP AND MQTT are false
                shouldShowModem = (!modemTcpStatus && !modemMqttStatus);
            }

            if (shouldShowModem) {
                row.style.display = '';
                visibleModemCount++;
            } else {
                row.style.display = 'none';
            }
        }

        // Update modem count
        var modemCountEl = document.getElementById('visibleModemCount');
        if (modemCountEl) {
            modemCountEl.textContent = visibleModemCount;
        }

        // Handle no modems message
        handleNoModemsMessage();

        // Also update A10 count based on visible modems
        updateA10Count();
    }

