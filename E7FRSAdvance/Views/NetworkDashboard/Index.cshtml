    // ============================================================
    // LOAD A10 HISTORY - Server side
    // ============================================================
    function loadA10History() {
        var selectedA10Id = currentA10 ? currentA10.id : null;
        if (!selectedA10Id) {
            $('#a10HistoryListBS').html('<div class="no-data-msg small text-center py-2">Select an A10 to view history</div>');
            updateA10HistoryCounts(0, 0);
            return;
        }

        // Get date values
        var fromDateEl = document.getElementById('a10HistoryFromDate');
        var toDateEl = document.getElementById('a10HistoryToDate');
        var fromDate = fromDateEl ? fromDateEl.value : '';
        var toDate = toDateEl ? toDateEl.value : '';

        // Format dates for API (DD-MM-YYYY)
        var fromFormatted = formatA10DateForApi(fromDate);
        var toFormatted = formatA10DateForApi(toDate);

        console.log('[A10 History] Loading - A10Id:', selectedA10Id, 'From:', fromFormatted, 'To:', toFormatted);

        $('#a10HistoryListBS').html('<div class="no-data-msg small text-center py-2"><i class="fas fa-spinner fa-spin"></i> Loading...</div>');

        // Reset protocol filter
        var protocolFilter = document.getElementById('a10HistoryProtocolFilter');
        if (protocolFilter) protocolFilter.value = 'all';

        var filterInfo = document.getElementById('a10FilterInfo');
        if (filterInfo) filterInfo.textContent = '';

        $.ajax({
            url: '/NetworkDashboard/GetA10History',
            type: 'GET',
            data: {
                clusterId: currentA10.clusterId,
                a10Id: selectedA10Id,
                ModemId: currentA10.modemId,
                fromDate: fromFormatted,
                toDate: toFormatted
            },
            dataType: 'json',
            success: function (response) {
                if (response.Success) {
                    var rawData = response.Data || [];
                    // Process data to fill gaps (offline detection)
                    var processedData = processA10HistoryWithGaps(rawData, fromDate, toDate);
                    a10HistoryData = processedData;
                    renderA10History(processedData);
                } else {
                    $('#a10HistoryListBS').html('<div class="text-danger small text-center py-2">' + response.Message + '</div>');
                    updateA10HistoryCounts(0, 0);
                }
            },
            error: function (xhr, status, error) {
                console.error('[A10 History] Error:', error);
                $('#a10HistoryListBS').html('<div class="text-danger small text-center py-2">Failed to load history</div>');
                updateA10HistoryCounts(0, 0);
            }
        });
    }

    // Reload function for button click
    function reloadA10History() {
        loadA10History();
    }

    // ============================================================
    // PROCESS A10 HISTORY - Fill gaps with offline entries
    // TypeId = 1 → TCP (data present = online)
    // TypeId = 2 → MQTT (data present = online)
    // Gap in data = Offline (carry forward protocol)
    // ============================================================
    function processA10HistoryWithGaps(rawData, fromDateStr, toDateStr) {
        if (!rawData || rawData.length === 0) {
            return [];
        }

        // Sort by timestamp ascending
        var sortedData = rawData.slice().sort(function (a, b) {
            return new Date(a.TimeStamp) - new Date(b.TimeStamp);
        });

        var gapThresholdMs = A10_GAP_THRESHOLD_MINUTES * 60 * 1000;
        var displayList = [];

        // Calculate time boundaries
        var startOfDay = new Date(fromDateStr + 'T00:00:00');
        var endOfDay = new Date(toDateStr + 'T23:59:59');
        var now = new Date();
        var effectiveEnd = endOfDay > now ? now : endOfDay;

        // Get first known protocol
        var firstKnownProtocol = sortedData[0].TypeId;

        // Check for gap at start of day
        var firstTimestamp = new Date(sortedData[0].TimeStamp);
        if ((firstTimestamp - startOfDay) > gapThresholdMs) {
            // Add offline entry at start with first known protocol
            displayList.push({
                TimeStamp: startOfDay.toISOString(),
                TypeId: firstKnownProtocol,
                isOnline: false,
                isSynthetic: true
            });
        }

        // Process each data point and detect gaps
        for (var i = 0; i < sortedData.length; i++) {
            var current = sortedData[i];
            var currentTime = new Date(current.TimeStamp);

            if (i > 0) {
                var prev = sortedData[i - 1];
                var prevTime = new Date(prev.TimeStamp);
                var gap = currentTime - prevTime;

                // If gap exceeds threshold, insert offline entry
                if (gap > gapThresholdMs) {
                    // Use previous entry's protocol for the offline gap
                    var gapProtocol = prev.TypeId > 0 ? prev.TypeId : current.TypeId;

                    displayList.push({
                        TimeStamp: new Date(prevTime.getTime() + 60000).toISOString(), // 1 min after prev
                        TypeId: gapProtocol,
                        isOnline: false,
                        isSynthetic: true
                    });
                }
            }

            // Add current entry as ONLINE (data exists = online)
            displayList.push({
                TimeStamp: current.TimeStamp,
                TypeId: current.TypeId,
                isOnline: true,
                isSynthetic: false,
                originalData: current
            });
        }

        // Check for gap at end (from last data point to now/end of day)
        var lastTimestamp = new Date(sortedData[sortedData.length - 1].TimeStamp);
        if ((effectiveEnd - lastTimestamp) > gapThresholdMs) {
            // Add offline entry after last data point
            var lastProtocol = sortedData[sortedData.length - 1].TypeId;
            displayList.push({
                TimeStamp: new Date(lastTimestamp.getTime() + 60000).toISOString(),
                TypeId: lastProtocol,
                isOnline: false,
                isSynthetic: true
            });
        }

        console.log('[A10 History] Processed', sortedData.length, 'raw records into', displayList.length, 'display records');
        return displayList;
    }

    // ============================================================
    // RENDER A10 HISTORY
    // ============================================================
    function renderA10History(historyData) {
        var container = $('#a10HistoryListBS');

        if (!historyData || historyData.length === 0) {
            container.html('<div class="no-data-msg small text-center py-2">No history available for selected date range</div>');
            updateA10HistoryCounts(0, 0);
            return;
        }

        // Sort by timestamp descending (newest first)
        historyData.sort(function (a, b) {
            return new Date(b.TimeStamp) - new Date(a.TimeStamp);
        });

        var html = '';
        for (var i = 0; i < historyData.length; i++) {
            var item = historyData[i];
            var isOnline = item.isOnline === true;
            var isTcp = item.TypeId === 1;
            var isMqtt = item.TypeId === 2;

            var statusDotClass = isOnline ? 'online' : 'offline';
            var cardClass = isOnline ? '' : 'offline-card';

            // Badge class - show protocol (TCP/MQTT), different style for online/offline
            var badgeClass = '';
            var badgeText = '';

            if (isTcp) {
                badgeClass = isOnline ? 'protocol-tcp' : 'protocol-tcp-offline';
                badgeText = 'TCP';
            } else if (isMqtt) {
                badgeClass = isOnline ? 'protocol-mqtt' : 'protocol-mqtt-offline';
                badgeText = 'MQTT';
            } else {
                badgeClass = 'bg-secondary bg-opacity-25';
                badgeText = '—';
            }

            var statusClass = isOnline ? 'text-success' : 'text-danger';
            var statusText = isOnline ? 'Online' : 'Offline';
            var formattedTime = formatHistoryTimestamp(item.TimeStamp);
            var dataProtocol = isTcp ? 'tcp' : (isMqtt ? 'mqtt' : 'offline');

            html += '<div class="card card-elevated p-2 d-flex flex-row align-items-center gap-2 status-card ' + cardClass + '" data-protocol="' + dataProtocol + '">';
            html += '<span class="status-dot ' + statusDotClass + '"></span>';
            html += '<span class="badge ' + badgeClass + '" style="font-size: 0.55rem;">' + badgeText + '</span>';
            html += '<span class="small ' + statusClass + '">' + statusText + '</span>';
            html += '<span class="flex-grow-1 text-end font-mono text-muted" style="font-size: 0.6rem;">' + formattedTime + '</span>';
            html += '</div>';
        }

        container.html(html);
        updateA10HistoryCounts(historyData.length, historyData.length);
    }

    // ============================================================
    // FILTER A10 HISTORY BY PROTOCOL - Client side
    // ============================================================
    function filterA10HistoryByProtocol() {
        var filterElement = document.getElementById('a10HistoryProtocolFilter');
        if (!filterElement) return;

        var filterValue = filterElement.value.toLowerCase();
        console.log('[A10 Filter] Filtering by:', filterValue);

        var container = document.getElementById('a10HistoryListBS');
        if (!container) return;

        var cards = container.querySelectorAll('.status-card');
        var visibleCount = 0;
        var totalCount = cards.length;

        for (var i = 0; i < cards.length; i++) {
            var card = cards[i];
            var protocol = (card.getAttribute('data-protocol') || '').toLowerCase();
            var shouldShow = (filterValue === 'all' || filterValue === protocol);

            if (shouldShow) {
                card.classList.add('d-flex');
                card.classList.remove('d-none');
                card.style.display = '';
                visibleCount++;
            } else {
                card.classList.remove('d-flex');
                card.classList.add('d-none');
                card.style.display = 'none';
            }
        }

        console.log('[A10 Filter] Visible:', visibleCount, '/', totalCount);

        // Update counts
        updateA10HistoryCounts(visibleCount, totalCount);

        // Update filter info
        var filterInfo = document.getElementById('a10FilterInfo');
        if (filterInfo) {
            filterInfo.textContent = (filterValue !== 'all') ? '(Filtered: ' + filterValue.toUpperCase() + ')' : '';
        }

        // Show no results message
        var existingMsg = container.querySelector('.a10-no-filter-results');
        if (existingMsg) existingMsg.remove();

        if (visibleCount === 0 && totalCount > 0) {
            var noResultsDiv = document.createElement('div');
            noResultsDiv.className = 'a10-no-filter-results small text-center py-3';
            noResultsDiv.innerHTML = '<i class="bi bi-funnel opacity-50 d-block mb-2" style="font-size: 1.5rem;"></i><span>No ' + filterValue.toUpperCase() + ' records found</span>';
            container.appendChild(noResultsDiv);
        }
    }

