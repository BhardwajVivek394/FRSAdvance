    function resetMqttBrokerStats() {
        var inCount = document.getElementById('mqttInCount');
        var outCount = document.getElementById('mqttOutCount');
        var errCount = document.getElementById('mqttErrCount');

        if (inCount) inCount.textContent = '0';
        if (outCount) outCount.textContent = '0';
