                            <div class="text-muted" style="font-size: 0.6rem;">A10</div>
                        </div>
                    </div>
                    <div class="card card-elevated px-3 py-2 d-flex flex-row align-items-center gap-2">
                        <span class="fs-5 text-tcp fw-bold">TCP</span>
                        <div>
                            <div class="fw-bold text-success">
                                <span id="statTcpA10Online">
                                    <span class="skeleton-box" style="width:20px;height:14px;display:inline-block;"></span>
                                </span>
                                <span class="text-muted fw-normal" style="font-size: 0.6rem;">Online</span>
                            </div>
                            <div class="fw-bold card-value">
                                <span id="statTcpA10Total">
                                    <span class="skeleton-box" style="width:20px;height:14px;display:inline-block;"></span>
                                </span>
                                <span class="text-muted fw-normal" style="font-size: 0.6rem;">Total</span>
                            </div>
                        </div>
                    </div>
                    <div class="card card-elevated px-3 py-2 d-flex flex-row align-items-center gap-2">
                        <span class="fs-5 text-mqtt fw-bold">MQTT</span>
                        <div>
                            <div class="fw-bold text-success">
                                <span id="statMqttA10Online">
                                    <span class="skeleton-box" style="width:20px;height:14px;display:inline-block;"></span>
                                </span>
                                <span class="text-muted fw-normal" style="font-size: 0.6rem;">Online</span>
                            </div>
                            <div class="fw-bold card-value">
                                <span id="statMqttA10Total">
                                    <span class="skeleton-box" style="width:20px;height:14px;display:inline-block;"></span>
                                </span>
                                <span class="text-muted fw-normal" style="font-size: 0.6rem;">Total</span>
                            </div>
                        </div>
                    </div>
                </div>
