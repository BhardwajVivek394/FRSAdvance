        });

        const avgUp = count > 0 ? totalUp / count : 0;
        const avgDown = count > 0 ? totalDown / count : 0;
        const avgTime = count > 0 ? totalTime / count : 0;
        const avgPct = avgTime > 0 ? (avgUp / avgTime) * 100 : 0;

        const html = `
                <div class="site-uptime-stats d-flex align-items-center gap-2 text-center">
