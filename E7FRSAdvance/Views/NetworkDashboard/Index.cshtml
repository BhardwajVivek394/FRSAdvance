    // ========== MAIN FUNCTION - CALL THIS ON SITE CLICK ==========

    async function loadSiteUptime() {
        console.log('[Uptime] Loading uptime for current site...');

        // Clear previous stats
        Object.keys(clusterStats).forEach(k => delete clusterStats[k]);
        Object.keys(a10Stats).forEach(k => delete a10Stats[k]);

        // Show loading indicators
        showLoading();

        const $items = $('.a10-item');
        if ($items.length === 0) {
            console.log('[Uptime] No A10 devices found');
            return;
        }

        console.log(`[Uptime] Found ${$items.length} A10 devices, fetching data...`);

        const clusters = new Set();
        const promises = [];

        $items.each(function () {
            const $el = $(this);
            const a10Id = $el.data('a10-id');
            const clusterId = $el.data('cluster-id');
            const modemId = $el.data('modem-id') || '';

            if (a10Id && clusterId) {
                promises.push(
                    fetchA10History(clusterId, a10Id, modemId).then(result => {
                        const stats = calculateUptimeStats(result.data);
                        updateA10UI(a10Id, stats);
                        clusters.add(clusterId);
                    })
                );
            }
        });

        await Promise.all(promises);
        clusters.forEach(id => updateClusterUI(id));
        console.log(`[Uptime] Completed! Processed ${promises.length} A10 devices`);
    }

    // Return public API
    return {
        load: loadSiteUptime,
        getA10Stats: function (id) { return a10Stats[id]; },
        getClusterStats: function (id) { return clusterStats[id]; }
    };

