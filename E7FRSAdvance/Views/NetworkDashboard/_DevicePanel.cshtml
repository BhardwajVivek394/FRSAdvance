@* ============================================================
    UPDATED DEVICE PANEL - With Cluster View & Asset View Toggle
    Fixed Uptime/Downtime Calculation
    ============================================================ *@

@model Domain.Dto.StationDeviceVM
@{ // Get first modem's mqttBasePath for site-level config
    string siteMqttBasePath = "rdpms";
    if (Model.Modems != null && Model.Modems.Any())
    {
        var firstModem = Model.Modems.FirstOrDefault();
        if (firstModem != null && firstModem.MqttBasePath != null)
        {
            siteMqttBasePath = firstModem.MqttBasePath;
        }
    }

    // Calculate site-level A10 counts
    int siteTotalA10 = 0;
    int siteOnlineA10 = 0;
    int siteOfflineA10 = 0;
    if (Model.Modems != null)
    {
        foreach (var m in Model.Modems)
        {
            if (m.A10List != null)
            {
                siteTotalA10 += m.A10List.Count;
                siteOnlineA10 += m.A10List.Count(a => a.TcpStatus && a.MqttStatus);
            }
        }
        siteOfflineA10 = siteTotalA10 - siteOnlineA10;
    } }

<div class="device-panel flex-grow-1 p-3">
    <!-- Panel Header with View Toggle -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="mb-0 panel-title">
            <i class="bi bi-geo-alt me-2"></i>@Model.SiteName - Devices
        </h6>
        <div class="d-flex gap-3 align-items-center">
            <!-- View Toggle -->
            <div class="d-flex align-items-center gap-2">
                <small class="filter-label">View:</small>
                <div class="btn-group btn-group-sm" id="viewToggleGroup">
                    <button class="btn btn-outline-primary active" onclick="switchView('cluster', this)" id="btnClusterView">
                        <i class="bi bi-diagram-3 me-1"></i>Cluster
                    </button>
                    <button class="btn btn-outline-primary" onclick="switchView('asset', this)" id="btnAssetView">
                        <i class="bi bi-box-seam me-1"></i>Asset
                    </button>
                </div>
            </div>

            <!-- Cluster View Filters (shown in cluster view) -->
            <div class="cluster-view-filters d-flex gap-3" id="clusterViewFilters">
                <!-- Modem Filter -->
                <div class="d-flex align-items-center gap-2">
                    <small class="filter-label">Modems:</small>
                    <div class="btn-group btn-group-sm" id="modemFilterGroup">
                        <button class="btn btn-outline-secondary active" onclick="filterModems('All', this)">All</button>
                        <button class="btn btn-outline-secondary" onclick="filterModems('Online', this)">Online</button>
                        <button class="btn btn-outline-secondary" onclick="filterModems('Offline', this)">Offline</button>
                    </div>
                </div>
                <!-- A10 Filter -->
                <div class="d-flex align-items-center gap-2">
                    <small class="filter-label">A10:</small>
                    <div class="btn-group btn-group-sm" id="a10FilterGroup">
                        <button class="btn btn-outline-secondary active" onclick="filterA10s('All', this)">All</button>
                        <button class="btn btn-outline-secondary" onclick="filterA10s('Online', this)">Online</button>
                        <button class="btn btn-outline-secondary" onclick="filterA10s('Offline', this)">Offline</button>
                    </div>
                </div>
            </div>

            <!-- Asset View Filters (shown in asset view) -->
            <div class="asset-view-filters d-flex gap-3" id="assetViewFilters" style="display: none;">
                <div class="d-flex align-items-center gap-2">
                    <small class="filter-label">Asset Type:</small>
                    <select class="form-select form-select-sm" id="assetTypeDropdown" style="min-width: 180px;" onchange="onAssetTypeChange(this)">
                        <option value="">-- Select Asset Type --</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Station Card Header (Common for both views) -->
    <div class="card station-card mb-3">
        <div class="card-header card-elevated d-flex align-items-center gap-3">
            <div class="bg-primary bg-opacity-25 rounded d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                <i class="bi bi-buildings fs-5 text-primary"></i>
            </div>
            <div class="flex-grow-1">
                <h6 class="mb-0 station-name">@Model.SiteName</h6>
                <small class="station-location">@Model.DivisionName / @Model.ZoneDescription</small>
            </div>
            <div class="d-flex gap-4 text-center">
                <div>
                    <div class="fw-bold text-v2" id="visibleModemCount">@Model.Modems.Count()</div>
                    <small class="count-label">Modems</small>
                </div>
                <div class="site-a10-stats">
                    <div class="d-flex align-items-center justify-content-center gap-1">
                        <span class="fw-bold text-a10" id="visibleA10Count">@siteTotalA10</span>
                        <span class="a10-sub-count">
                            (<span class="@(siteOnlineA10 == 0 ? "text-muted" : "text-success")">@siteOnlineA10</span>/<span class="@(siteOfflineA10 == 0 ? "text-muted" : "text-danger")">@siteOfflineA10</span>)
                        </span>
                    </div>
                    <small class="count-label">A10</small>
                </div>
                <!-- Site Uptime Stats Placeholder -->
                <div class="site-uptime-placeholder" id="siteUptimeStats">
                    <div class="uptime-loading">Loading...</div>
                </div>
            </div>

            @*<button class="btn btn-sm btn-outline-warning set-config-btn"
                        onclick="openSetConfigModal('site', @Model.SiteId, null, null, '@Model.SiteName', '@siteMqttBasePath'); event.stopPropagation();"
                        title="Configure all ADCs in this site">
                    <i class="bi bi-gear me-1"></i> Set Config
                </button>*@
            <button class="btn btn-sm btn-outline-warning set-config-btn"
                    data-context="@Model.SiteName"
                    data-level="site"
                    data-site-id="@Model.SiteId"
                    data-cluster-id=""
                    data-adc-number=""
                    data-mqtt-base="@siteMqttBasePath"
                    onclick="openSetConfigFromData(this); event.stopPropagation();"
                    title="Configure all ADCs in this site">
                <i class="bi bi-gear me-1"></i> Set Config
            </button>

        </div>

        <!-- ============================================================
             CLUSTER VIEW CONTENT
             ============================================================ -->
        <div class="card-body p-0" id="clusterViewContent">
            @if (Model.Modems != null && Model.Modems.Any())
            {
                foreach (var modem in Model.Modems)
                {
                    string modemId = modem.ModemId != null ? modem.ModemId : "";
                    string modemName = modem.ModemName != null ? modem.ModemName : "";
                    string clusterName = modem.ClusterName != null ? modem.ClusterName : "";
                    string siteName = modem.SiteName != null ? modem.SiteName : "";
                    string divisionName = modem.DivisionName != null ? modem.DivisionName : "";
                    string zoneName = modem.ZoneName != null ? modem.ZoneName : "";
                    string mqttBasePath = modem.MqttBasePath != null ? modem.MqttBasePath : "";
                    string simNumber = modem.SimNumber != null ? modem.SimNumber : "-";
                    decimal? signalStrength = modem.SignalStrength;

                    int totalA10Count = modem.A10List != null ? modem.A10List.Count : 0;
                    int onlineA10Count = modem.A10List != null ? modem.A10List.Count(a => a.TcpStatus && a.MqttStatus) : 0;
                    int offlineA10Count = totalA10Count - onlineA10Count;

                    string subscribeTopic = modem.SubscribeTopic != null ? modem.SubscribeTopic : "";
                    string publishTopic = modem.PublishTopic != null ? modem.PublishTopic : "";
                    bool isFullyOnline = modem.TcpStatus && modem.MqttStatus;
                    string onlineStatus = isFullyOnline ? "online" : "offline";

                    <div class="modem-row">
                        <div class="modem-header d-flex align-items-center gap-2 p-3"
                             data-modem-version="@modem.Version"
                             data-cluster-id="@modem.ClusterId"
                             data-station-name="@siteName"
                             data-division-name="@divisionName"
                             data-zone-name="@zoneName"
                             data-mqtt-base="@mqttBasePath"
                             data-signal="@signalStrength"
                             data-modem-id="@modem.ModemId"
                             data-modem-name="@modemName"
                             data-cluster-name="@clusterName"
                             data-sim-number="@simNumber"
                             data-tcp-status="@modem.TcpStatus.ToString().ToLower()"
                             data-mqtt-status="@modem.MqttStatus.ToString().ToLower()"
                             data-subscribe-topic="@subscribeTopic"
                             data-publish-topic="@publishTopic"
                             data-status="@onlineStatus"
                             data-a10-total="@totalA10Count"
                             data-a10-online="@onlineA10Count"
                             data-a10-offline="@offlineA10Count"
                             onclick="toggleA10List('@modem.ClusterId','@modem.ModemId', this)"
                             style="cursor: pointer;">

                            <i class="bi bi-chevron-right toggle-icon modem-toggle" id="toggle-icon-@modem.ClusterId"></i>

                            <div class="bg-v@(modem.Version) rounded d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                <i class="bi bi-router text-v1"></i>
                            </div>

                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-semibold modem-name">@clusterName</span>
                                    <span class="badge badge-v@(modem.Version)" style="font-size: 0.55rem;">v@(modem.Version)</span>
                                </div>
                                <small class="modem-info font-mono">
                                    Modem Id: @modemId | Modem Name: @modemName | Signal: @signalStrength
                                </small>
                            </div>

                            <!-- A10 Count Display -->
                            <div class="a10-count-group d-flex align-items-center gap-1 me-2">
                                <div class="a10-count-box text-center" title="Total A10 Devices">
                                    <div class="a10-count-value fw-bold @(totalA10Count == 0 ? "text-muted" : "")">@totalA10Count</div>
                                    <div class="a10-count-label">A10</div>
                                </div>
                                <div class="a10-count-divider"></div>
                                <div class="a10-count-box a10-online text-center" title="Online A10 Devices">
                                    <div class="a10-count-value fw-bold @(onlineA10Count == 0 ? "zero-count" : "")">@onlineA10Count</div>
                                    <div class="a10-count-label">
                                        <span class="status-dot online me-1" style="width: 5px; height: 5px;"></span>On
                                    </div>
                                </div>
                                <div class="a10-count-box a10-offline text-center" title="Offline A10 Devices">
                                    <div class="a10-count-value fw-bold @(offlineA10Count == 0 ? "zero-count" : "")">@offlineA10Count</div>
                                    <div class="a10-count-label">
                                        <span class="status-dot offline me-1" style="width: 5px; height: 5px;"></span>Off
                                    </div>
                                </div>
                            </div>

                            <!-- Cluster Uptime Stats Placeholder -->
                            <div class="cluster-uptime-placeholder" id="clusterUptime_@modem.ClusterId">
                                <span class="uptime-loading">
                                    <small style="font-size: 0.6rem;">...</small>
                                </span>
                            </div>

                            <div class="d-flex align-items-center gap-2">
                                <div class="d-flex gap-2">
                                    <span class="badge @(modem.TcpStatus ? "bg-primary" : "bg-danger") bg-opacity-25 @(modem.TcpStatus ? "text-tcp" : "text-danger") small">
                                        <span class="status-dot @(modem.TcpStatus ? "online" : "offline") me-1" style="width:5px; height:5px;"></span>
                                        TCP
                                    </span>
                                    <span class="badge @(modem.MqttStatus ? "bg-success" : "bg-danger") bg-opacity-25 @(modem.MqttStatus ? "text-mqtt" : "text-danger") small">
                                        <span class="status-dot @(modem.MqttStatus ? "online" : "offline") me-1" style="width:5px; height:5px;"></span>
                                        MQTT
                                    </span>
                                </div>

                                @*<button class="btn btn-sm btn-outline-info set-config-btn"
                                            onclick="openSetConfigModal('cluster', @Model.SiteId, @modem.ClusterId, null, '@clusterName','@siteMqttBasePath'); event.stopPropagation();"
                                            title="Configure all ADCs in @clusterName">
                                        <i class="bi bi-gear"></i>
                                    </button>*@
                                <button class="btn btn-sm btn-outline-info set-config-btn"
                                        data-context="@clusterName"
                                        data-level="cluster"
                                        data-site-id="@Model.SiteId"
                                        data-cluster-id="@modem.ClusterId"
                                        data-adc-number=""
                                        data-mqtt-base="@siteMqttBasePath"
                                        onclick="openSetConfigFromData(this); event.stopPropagation();"
                                        title="Configure all ADCs in @clusterName">
                                    <i class="bi bi-gear"></i>
                                </button>
                            </div>
                        </div>

                        <!-- A10 List Container -->
                        <div class="a10-container" id="a10Container_@modem.ClusterId" style="display: none;">
                            @if (modem.A10List != null && modem.A10List.Count > 0)
                            {
                                <div class="a10-list pb-3">
                                    <div class="d-flex flex-wrap a10-box p-3" style="gap: 8px;">
                                        @foreach (var a10 in modem.A10List)
                                        {
                                            string firmware = a10.FirmwareVersion != null ? a10.FirmwareVersion : "";
                                            string slaveAddress = a10.SlaveAddress != null ? a10.SlaveAddress : "";
                                            string a10ClusterName = a10.ClusterName != null ? a10.ClusterName : clusterName;
                                            string a10ModemId = a10.ModemId != null ? a10.ModemId.ToString() : modem.ModemId;
                                            string a10ModemName = a10.ModemName != null ? a10.ModemName : modemName;
                                            string a10StationName = a10.StationName != null ? a10.StationName : siteName;
                                            string a10DivisionName = a10.DivisionName != null ? a10.DivisionName : divisionName;
                                            string a10MqttBasePath = a10.MQTTBasePath != null ? a10.MQTTBasePath : mqttBasePath;
                                            string mqttSubscribe = a10.MqttSubscribe != null ? a10.MqttSubscribe : "";
                                            string mqttPublish = a10.MqttPublish != null ? a10.MqttPublish : "";
                                            string lastDataTime = a10.LastDataTime.HasValue ? a10.LastDataTime.Value.ToString("o") : "";
                                            string firmwareDisplay = a10.FirmwareVersion != null ? a10.FirmwareVersion : "-";
                                            string adcTypeName = a10.ADCTypeName != null ? a10.ADCTypeName : "-";
                                            bool isA10Online = a10.TcpStatus && a10.MqttStatus;
                                            string statusClass = isA10Online ? "online" : "offline";

                                            <div class="a10-item card card-elevated p-2 d-flex flex-row align-items-center gap-2 mw-125"
                                                 data-a10-id="@a10.Id"
                                                 data-a10-number="@a10.ADCNumber"
                                                 data-a10-type="@adcTypeName"
                                                 data-a10-type-id="@a10.ADCTypeId"
                                                 data-a10-firmware="@firmware"
                                                 data-a10-slave="@slaveAddress"
                                                 data-a10-channels="@a10.ChannelCount"
                                                 data-cluster-id="@modem.ClusterId"
                                                 data-cluster-name="@a10ClusterName"
                                                 data-modem-id="@a10ModemId"
                                                 data-modem-name="@a10ModemName"
                                                 data-site-id="@Model.SiteId"
                                                 data-station-name="@a10StationName"
                                                 data-division-name="@a10DivisionName"
                                                 data-mqtt-base="@a10MqttBasePath"
                                                 data-mqtt-subscribe="@mqttSubscribe"
                                                 data-mqtt-publish="@mqttPublish"
                                                 data-tcp-status="@a10.TcpStatus.ToString().ToLower()"
                                                 data-mqtt-status="@a10.MqttStatus.ToString().ToLower()"
                                                 data-last-data="@lastDataTime"
                                                 onclick="selectA10BS(this); event.stopPropagation();">

                                                <div class="flex-grow-1">
                                                    <div class="fw-semibold small d-flex align-items-center a10-name">
                                                        <span class="status-dot @statusClass me-1" style="width: 5px; height: 5px;"></span>
                                                        A10-@a10.Id
                                                        <span class="badge @(a10.TcpStatus ? "bg-primary" : "bg-danger") bg-opacity-25 @(a10.TcpStatus ? "text-tcp" : "text-danger") small" style="margin-left: 10px;">
                                                            <span class="status-dot @(a10.TcpStatus ? "online" : "offline") me-1" style="width:5px; height:5px;"></span>
                                                            TCP
                                                        </span>
                                                        <span class="badge @(a10.MqttStatus ? "bg-success" : "bg-danger") bg-opacity-25 @(a10.MqttStatus ? "text-mqtt" : "text-danger") small" style="margin-left: 10px;">
                                                            <span class="status-dot @(a10.MqttStatus ? "online" : "offline") me-1" style="width:5px; height:5px;"></span>
                                                            MQTT
                                                        </span>
                                                        @*<button class="btn btn-xs btn-outline-cyan set-config-btn-a10 ms-2"
                                                                    onclick="openSetConfigModal('adc', @Model.SiteId, @modem.ClusterId, @a10.ADCNumber, 'A10-@a10.Id','@siteMqttBasePath'); event.stopPropagation();"
                                                                    title="Configure A10-@a10.Id">
                                                                <i class="bi bi-gear" style="font-size: 0.6rem;"></i>
                                                            </button>*@
                                                        <button class="btn btn-xs btn-outline-cyan set-config-btn-a10 ms-2"
                                                                data-context="A10-@a10.Id"
                                                                data-level="adc"
                                                                data-site-id="@Model.SiteId"
                                                                data-cluster-id="@modem.ClusterId"
                                                                data-adc-number="@a10.Id"
                                                                data-mqtt-base="@siteMqttBasePath"
                                                                onclick="openSetConfigFromData(this); event.stopPropagation();"
                                                                title="Configure A10-@a10.Id">
                                                            <i class="bi bi-gear" style="font-size: 0.6rem;"></i>
                                                        </button>
                                                    </div>
                                                    <small class="a10-info font-mono">Type: @a10.ADCTypeName | F/W: @firmwareDisplay</small>
                                                </div>
                                            </div>}
                                    </div>
                                </div> }
                            else
                            {
                                <div class="no-devices-msg small text-center py-3">No A10 devices found</div>}
                        </div>
                    </div> }
            }
            else
            {
                <div class="no-devices-msg small text-center py-4">No modems found for this station</div>}
        </div>

        <!-- ============================================================
             ASSET VIEW CONTENT
             ============================================================ -->
        <div class="card-body p-0" id="assetViewContent" style="display: none;">
            <!-- Loading State -->
            <div id="assetViewLoading" class="text-center py-5" style="display: none;">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <div class="mt-2 text-muted small">Loading assets...</div>
            </div>

            <!-- Placeholder when no asset type selected -->
            <div id="assetViewPlaceholder" class="text-center py-5">
                <i class="bi bi-box-seam text-muted" style="font-size: 3rem;"></i>
                <div class="mt-2 text-muted">Select an Asset Type to view assets</div>
            </div>

            <!-- Asset List Container -->
            <div id="assetListContainer" style="display: none;">
                <!-- Will be populated by JavaScript -->
            </div>
        </div>
    </div>
</div>

<!-- ============================================================
     ADC MQTT BROKER MODAL (For Asset View) - Similar to A10 Index.cshtml
     ============================================================ -->
<div class="modal bounceIn animated" id="adcMqttModal" tabindex="-1" role="dialog" data-bs-backdrop="static" aria-labelledby="adcMqttModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header" style="background-color: #0e5068; color: white;">
                <h5 class="modal-title" id="adcMqttModalLabel">
                    <i class="bi bi-broadcast me-2"></i>ADC MQTT Broker Console
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- ADC Info Card -->
                <div class="card mb-3" style="border-left: 4px solid #0e5068;">
                    <div class="card-body py-2" style="background-color: #f8f9fa;">
                        <div class="row">
                            <div class="col-md-3">
                                <small class="text-muted">ADC Number</small>
                                <div class="fw-bold" id="adcModalNumber">-</div>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Cluster</small>
                                <div class="fw-bold" id="adcModalCluster">-</div>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Modem ID</small>
                                <div class="fw-bold" id="adcModalModem">-</div>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Pin</small>
                                <div class="fw-bold" id="adcModalPin">-</div>
                            </div>
                        </div>
                        <div class="row mt-2">
                            <div class="col-md-3">
                                <small class="text-muted">Asset</small>
                                <div class="fw-bold" id="adcModalAsset">-</div>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Attribute</small>
                                <div class="fw-bold" id="adcModalAttribute">-</div>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Location</small>
                                <div class="fw-bold" id="adcModalLocation">-</div>
                            </div>
                            <div class="col-md-3">
                                <small class="text-muted">Card</small>
                                <div class="fw-bold" id="adcModalCard">-</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Connection Section -->
                <div class="card mb-3">
                    <div class="card-header py-2" style="background-color: #215968; color: white;">
                        <i class="bi bi-plug me-2"></i>Connection
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-5">
                                <label class="form-label small fw-bold">Subscribe Topic (Receive)</label>
                                <input type="text" class="form-control form-control-sm font-mono" id="adcMqttSubscribeTopic" readonly style="background-color: #e9f7ef;">
                            </div>
                            <div class="col-md-5">
                                <label class="form-label small fw-bold">Publish Topic (Send)</label>
                                <input type="text" class="form-control form-control-sm font-mono" id="adcMqttPublishTopic" readonly style="background-color: #fef9e7;">
                            </div>
                            <div class="col-md-2 d-flex align-items-end gap-2">
                                <button class="btn btn-success btn-sm flex-grow-1" id="btnAdcMqttConnect" onclick="adcMqttConnect()">
                                    <i class="bi bi-plug me-1"></i>Connect
                                </button>
                                <button class="btn btn-danger btn-sm flex-grow-1" id="btnAdcMqttDisconnect" onclick="adcMqttDisconnect()" style="display: none;">
                                    <i class="bi bi-x-circle me-1"></i>Disconnect
                                </button>
                            </div>
                        </div>
                        <div class="mt-2">
                            <span class="badge bg-secondary" id="adcMqttConnectionStatus">
                                <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Disconnected
                            </span>
                            <small class="text-muted ms-2" id="adcMqttLastUpdate">Last Update: --</small>
                        </div>
                    </div>
                </div>

                <!-- Command Panel -->
                <div class="card mb-3">
                    <div class="card-header py-2" style="background-color: #4bacc6; color: white;">
                        <i class="bi bi-terminal me-2"></i>Command Panel
                    </div>
                    <div class="card-body">
                        <!-- Quick Commands Row 1 -->
                        <div class="mb-2">
                            <label class="form-label small fw-bold">Quick Commands - Configuration</label>
                            <div class="d-flex flex-wrap gap-2">
                                <button class="btn btn-outline-primary btn-sm" onclick="adcSendQuickCommand('GETCONFIG')" title="Get ADC Configuration">
                                    <i class="bi bi-download me-1"></i>Get Config
                                </button>
                                <button class="btn btn-outline-warning btn-sm" onclick="openSetConfigFromMqttModal()" title="Set ADC Configuration">
                                    <i class="bi bi-gear me-1"></i>Set Config
                                </button>
                                <button class="btn btn-outline-info btn-sm" onclick="adcSendQuickCommand('GETSTATUS')" title="Get Status">
                                    <i class="bi bi-info-circle me-1"></i>Get Status
                                </button>
