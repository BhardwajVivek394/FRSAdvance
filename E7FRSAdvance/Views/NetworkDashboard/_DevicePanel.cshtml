    function fetchModemHistory(clusterId) {
        return new Promise(function(resolve, reject) {
            var today = formatDateForApi(new Date());
            var url = CONFIG.modemHistoryBaseUrl + '?clusterId=' + clusterId + '&fromDate=' + today + '&toDate=' + today;

            console.log('[UptimeCalculator] Fetching cluster: ' + url);

            $.ajax({
                url: url,
                type: 'GET',
                dataType: 'json',
                success: function (response) {
                    var data = [];
                    if (Array.isArray(response)) {
                        data = response;
                    } else if (response && response.Success && response.Data) {
                        data = response.Data;
                    } else if (response && response.data) {
                        data = response.data;
                    }
                    console.log('[UptimeCalculator] Cluster ' + clusterId + ': ' + data.length + ' records');
                    resolve({ clusterId: clusterId, data: data });
                },
                error: function (xhr, status, error) {
                    console.warn('[UptimeCalculator] Failed for cluster ' + clusterId + ':', error);
                    resolve({ clusterId: clusterId, data: [] });
                }
            });
        });
    }

