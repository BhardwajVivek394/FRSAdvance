    function calculateA10UptimeStats(historyData) {
        // TCP: val = ResponseTime  (same field renderA10Chart uses for TypeId=1)
        var tcp = calcGapBased(
            (historyData || []).filter(function (r) { return parseInt(r.TypeId, 10) === 1; }),
            function (r) { return parseInt(r.ResponseTime, 10) || 0; }
        );

        // MQTT: val = Uptime  (same field renderA10Chart uses for TypeId=2)
        var mqtt = calcGapBased(
            (historyData || []).filter(function (r) { return parseInt(r.TypeId, 10) === 2; }),
            function (r) { return parseInt(r.Uptime, 10) || 0; }
        );

        // Combined: union of both valid record sets
        var combined = calcGapBased(
            historyData || [],
            function (r) {
                return parseInt(r.TypeId, 10) === 1
                    ? (parseInt(r.ResponseTime, 10) || 0)
                    : (parseInt(r.Uptime, 10) || 0);
            }
        );

        return { tcp: tcp, mqtt: mqtt, combined: combined };
    }
