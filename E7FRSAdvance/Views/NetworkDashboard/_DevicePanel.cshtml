    // ============================================================
    // UI UPDATE FUNCTIONS - CLUSTER LEVEL
    // ============================================================

    function updateClusterUptimeUI(clusterId, stats) {
        var tcp = stats.tcp;
        var mqtt = stats.mqtt;

        function pctBadge(pct) {
            if (pct <= 0) return 'cluster-pct-zero';
            if (pct >= 90) return 'cluster-pct-good';
            if (pct >= 50) return 'cluster-pct-warn';
            return 'cluster-pct-bad';
        }

        function clusterBlock(label, dotColor, s) {
            var upPct = Math.min(100, Math.max(0, s.uptimePercentage));
            var dwnPct = Math.min(100, Math.max(0, s.downtimePercentage));
            var upCol = upPct === 0 ? 'text-muted' : 'cluster-up-color';
            var dwnCol = dwnPct === 0 ? 'text-muted' : 'cluster-dwn-color';

            return '<div class="cluster-uptime-block" ' +
                'title="' + label + '\nUptime:   ' + formatDuration(s.uptimeSeconds) + ' (' + upPct.toFixed(1) + '%)\n' +
                'Downtime: ' + formatDuration(s.downtimeSeconds) + ' (' + dwnPct.toFixed(1) + '%)">' +

                // Row 1: dot + name + % badge
                '<div class="cluster-uptime-header">' +
                '<span style="width:6px;height:6px;border-radius:50%;background:' + dotColor + ';display:inline-block;flex-shrink:0;"></span>' +
                '<span class="cluster-proto-name">' + label + '</span>' +
                '<span class="cluster-pct-badge ' + pctBadge(upPct) + '">' + Math.round(upPct) + '%</span>' +
                '</div>' +

                // Row 2: ↑ uptime / ↓ downtime
                '<div class="cluster-uptime-durations">' +
                '<span class="cluster-dur-up ' + upCol + '">&#8593;' + formatDurationShort(s.uptimeSeconds) + '</span>' +
                '<span class="cluster-dur-sep">/</span>' +
                '<span class="cluster-dur-down ' + dwnCol + '">&#8595;' + formatDurationShort(s.downtimeSeconds) + '</span>' +
                '</div>' +
                '</div>';
        }

        var html =
            '<div class="cluster-uptime-stats me-2" id="clusterUptime_' + clusterId + '" ' +
            'title="Today\'s uptime — Cluster ' + clusterId + '">' +
            clusterBlock('TCP', '#0d6efd', tcp) +
            clusterBlock('MQTT', '#198754', mqtt) +
            '</div>';

        var $ph = $('#clusterUptime_' + clusterId);
        if ($ph.length) { $ph.replaceWith(html); }
        clusterStats[clusterId] = stats;
    }

    // ============================================================
    // UI UPDATE FUNCTIONS - SITE LEVEL
    // ============================================================

    function updateSiteUptimeUI() {
        var clusterIds = Object.keys(clusterStats);
        if (clusterIds.length === 0) return;

        var totalTcpUptime = 0, totalTcpDowntime = 0;
        var totalMqttUptime = 0, totalMqttDowntime = 0;
        var totalSeconds = 0;
        var validClusterCount = 0;

        clusterIds.forEach(function (clusterId) {
            var stats = clusterStats[clusterId];
            if (stats && stats.tcp && stats.mqtt) {
                totalTcpUptime += stats.tcp.uptimeSeconds;
                totalTcpDowntime += stats.tcp.downtimeSeconds;
                totalMqttUptime += stats.mqtt.uptimeSeconds;
                totalMqttDowntime += stats.mqtt.downtimeSeconds;
                totalSeconds += stats.tcp.totalSeconds;
                validClusterCount++;
            }
        });

        var avgTcpUptime = validClusterCount > 0 ? totalTcpUptime / validClusterCount : 0;
        var avgTcpDowntime = validClusterCount > 0 ? totalTcpDowntime / validClusterCount : 0;
        var avgMqttUptime = validClusterCount > 0 ? totalMqttUptime / validClusterCount : 0;
        var avgMqttDowntime = validClusterCount > 0 ? totalMqttDowntime / validClusterCount : 0;

        var overallTcpPercentage = totalSeconds > 0 ? (totalTcpUptime / totalSeconds) * 100 : 0;
        var overallMqttPercentage = totalSeconds > 0 ? (totalMqttUptime / totalSeconds) * 100 : 0;

        var tcpUptimeClass = avgTcpUptime === 0 ? 'text-muted' : 'text-primary';
        var tcpDowntimeClass = avgTcpDowntime === 0 ? 'text-muted' : 'text-danger';
        var mqttUptimeClass = avgMqttUptime === 0 ? 'text-muted' : 'text-success';
        var mqttDowntimeClass = avgMqttDowntime === 0 ? 'text-muted' : 'text-danger';

        var html = '<div class="site-uptime-stats d-flex align-items-center gap-2 text-center" id="siteUptimeStats">' +
            // TCP Stats
            '<div class="site-uptime-box" title="Average TCP Uptime/Downtime across all clusters">' +
            '<div class="d-flex align-items-center justify-content-center gap-1">' +
            '<span class="fw-bold ' + tcpUptimeClass + '">' + formatDurationShort(avgTcpUptime) + '</span>' +
            '<span class="text-muted">/</span>' +
            '<span class="fw-bold ' + tcpDowntimeClass + '">' + formatDurationShort(avgTcpDowntime) + '</span>' +
            '</div>' +
            '<small class="count-label">TCP (' + formatPercentageShort(overallTcpPercentage) + ')</small>' +
            '</div>' +
            // MQTT Stats
            '<div class="site-uptime-box" title="Average MQTT Uptime/Downtime across all clusters">' +
            '<div class="d-flex align-items-center justify-content-center gap-1">' +
            '<span class="fw-bold ' + mqttUptimeClass + '">' + formatDurationShort(avgMqttUptime) + '</span>' +
            '<span class="text-muted">/</span>' +
            '<span class="fw-bold ' + mqttDowntimeClass + '">' + formatDurationShort(avgMqttDowntime) + '</span>' +
            '</div>' +
            '<small class="count-label">MQTT (' + formatPercentageShort(overallMqttPercentage) + ')</small>' +
            '</div>' +
            '</div>';

        var placeholder = $('#siteUptimeStats');
        if (placeholder.length > 0) {
            placeholder.replaceWith(html);
        }

        console.log('[UptimeCalculator] Site Stats - Clusters: ' + validClusterCount +
            ', TCP Uptime: ' + formatDuration(totalTcpUptime) + ' (' + overallTcpPercentage.toFixed(1) + '%)' +
            ', MQTT Uptime: ' + formatDuration(totalMqttUptime) + ' (' + overallMqttPercentage.toFixed(1) + '%)');
    }

    // ============================================================
    // UI UPDATE FUNCTIONS - A10 LEVEL
    // ============================================================

    function updateA10UptimeUI(a10Id, stats) {
        var tcp = stats.tcp;
        var mqtt = stats.mqtt;

        var a10Item = $('.a10-item[data-a10-id="' + a10Id + '"]');
        if (a10Item.length === 0) return;
        a10Item.find('.a10-uptime-indicator').remove();

        function pctClass(pct) {
            if (pct <= 0) return 'a10-pct-zero';
            if (pct >= 90) return 'a10-pct-good';
            if (pct >= 50) return 'a10-pct-warn';
            return 'a10-pct-bad';
        }

        function a10Block(label, dotColor, s) {
            var upPct = Math.min(100, Math.max(0, s.uptimePercentage));
            var dwnPct = Math.min(100, Math.max(0, s.downtimePercentage));
            var upCol = upPct === 0 ? 'text-muted' : 'a10-up-color';
            var dwnCol = dwnPct === 0 ? 'text-muted' : 'a10-dwn-color';

            return '<div class="a10-uptime-block" ' +
                'title="' + label + '\nUptime:   ' + formatDuration(s.uptimeSeconds) + ' (' + upPct.toFixed(1) + '%)\n' +
                'Downtime: ' + formatDuration(s.downtimeSeconds) + ' (' + dwnPct.toFixed(1) + '%)">' +

                // Row 1: dot + protocol name + bold %
                '<div class="a10-uptime-header">' +
                '<span style="width:6px;height:6px;border-radius:50%;background:' + dotColor + ';display:inline-block;flex-shrink:0;"></span>' +
                '<span class="a10-proto-name">' + label + '</span>' +
                '<span class="a10-pct ' + pctClass(upPct) + '">' + Math.round(upPct) + '%</span>' +
                '</div>' +

                // Row 2: ↑ uptime / ↓ downtime durations
                '<div class="a10-uptime-durations">' +
                '<span class="a10-dur-up ' + upCol + '">&#8593;' + formatDurationShort(s.uptimeSeconds) + '</span>' +
                '<span class="a10-dur-sep">/</span>' +
                '<span class="a10-dur-down ' + dwnCol + '">&#8595;' + formatDurationShort(s.downtimeSeconds) + '</span>' +
                '</div>' +
                '</div>';
        }

        var html = '<div class="a10-uptime-indicator">' +
            a10Block('TCP', '#0d6efd', tcp) +
            a10Block('MQTT', '#198754', mqtt) +
            '</div>';

        a10Item.find('.a10-info').after(html);
        a10Stats[a10Id] = stats;
    }

    // ============================================================
    // PROCESS FUNCTIONS
    // ============================================================

    function processAllClusters() {
        var modemHeaders = $('.modem-header');
        if (modemHeaders.length === 0) return;

        var clusterIds = [];
        modemHeaders.each(function() {
            var clusterId = $(this).data('cluster-id');
            if (clusterId && clusterIds.indexOf(clusterId) === -1) {
                clusterIds.push(clusterId);
            }
        });

        console.log('[UptimeCalculator] Processing ' + clusterIds.length + ' clusters');

        var promises = clusterIds.map(function(clusterId) {
            return fetchModemHistory(clusterId).then(function(result) {
                // Use MODEM calculation (with SignalStrength check)
                var stats = calculateModemUptimeStats(result.data);
                updateClusterUptimeUI(clusterId, stats);
                return { clusterId: clusterId, stats: stats };
            }).catch(function(error) {
                console.error('[UptimeCalculator] Error processing cluster ' + clusterId + ':', error);
                return { clusterId: clusterId, stats: null };
            });
        });

        Promise.all(promises).then(function() {
            updateSiteUptimeUI();
        });
    }

    function processExpandedA10s(clusterId) {
        var container = $('#a10Container_' + clusterId);
        if (container.length === 0 || !container.is(':visible')) return;

        var a10Items = container.find('.a10-item');
        var a10List = [];

        a10Items.each(function() {
            var a10Id = $(this).data('a10-id');
            if (a10Id && !a10Stats[a10Id]) {
                a10List.push({ a10Id: a10Id, clusterId: clusterId });
            }
        });

        if (a10List.length === 0) return;

        console.log('[UptimeCalculator] Processing ' + a10List.length + ' A10s for cluster ' + clusterId);

        // Process A10s one by one with small delay to avoid overwhelming server
        var index = 0;
        function processNext() {
            if (index >= a10List.length) return;

            var item = a10List[index];
            fetchA10History(item.a10Id, item.clusterId).then(function(result) {
                // Use A10 calculation (record presence check, no SignalStrength)
                var stats = calculateA10UptimeStats(result.data);
                updateA10UptimeUI(result.a10Id, stats);
                index++;
                setTimeout(processNext, 100); // Small delay between requests
            }).catch(function(error) {
                console.error('[UptimeCalculator] Error processing A10 ' + item.a10Id + ':', error);
                index++;
                setTimeout(processNext, 100);
            });
        }

        processNext();
    }
    var GAP_THRESHOLD_MS = 10 * 60 * 1000; // 10 min — covers 5-min polling with buffer

    function calcGapBased(records, valFn) {
        var now = new Date();
        var startOfDay = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0, 0);
        var totalMs = now - startOfDay;

        var empty = {
            totalSeconds: Math.round(totalMs / 1000),
            uptimeSeconds: 0,
            downtimeSeconds: Math.round(totalMs / 1000),
            uptimePercentage: 0,
            downtimePercentage: 100,
            dataPoints: 0,
            hasData: false
        };

        // Apply same val>0 filter the graph uses
        var valid = (records || []).filter(function (r) {
            return valFn(r) > 0;
        }).sort(function (a, b) {
            return new Date(a.TimeStamp) - new Date(b.TimeStamp);
        });

        if (valid.length === 0) return empty;

        var downtimeMs = 0;

        // Gap from midnight to first valid record
        var firstMs = new Date(valid[0].TimeStamp) - startOfDay;
        if (firstMs > GAP_THRESHOLD_MS) downtimeMs += firstMs;

        // Gaps between consecutive valid records
        for (var i = 1; i < valid.length; i++) {
            var gap = new Date(valid[i].TimeStamp) - new Date(valid[i - 1].TimeStamp);
            if (gap > GAP_THRESHOLD_MS) downtimeMs += gap;
        }

        // Gap from last valid record to now
        var tailMs = now - new Date(valid[valid.length - 1].TimeStamp);
        if (tailMs > GAP_THRESHOLD_MS) downtimeMs += tailMs;

        downtimeMs = Math.min(downtimeMs, totalMs);
        var uptimeMs = Math.max(0, totalMs - downtimeMs);

        return {
            totalSeconds: Math.round(totalMs / 1000),
            uptimeSeconds: Math.round(uptimeMs / 1000),
            downtimeSeconds: Math.round(downtimeMs / 1000),
            uptimePercentage: Math.min(100, (uptimeMs / totalMs) * 100),
            downtimePercentage: Math.min(100, (downtimeMs / totalMs) * 100),
            dataPoints: valid.length,
            hasData: true
        };
    }
    // ============================================================
    // INITIALIZATION
    // ============================================================

    function init() {
        if ($('.device-panel').length === 0) {
            setTimeout(init, 500);
            return;
        }

        console.log('[UptimeCalculator] Initializing...');

        // Process clusters first
        processAllClusters();

        // Set up periodic refresh
        setInterval(processAllClusters, CONFIG.pollIntervalMs);

        // Listen for A10 container expansion to load A10 stats on-demand
        $(document).on('click', '.modem-header', function() {
            var clusterId = $(this).data('cluster-id');
            // Delay to let the container expand
            setTimeout(function() {
                processExpandedA10s(clusterId);
            }, 300);
        });
    }

    // Expose public API
    window.A10UptimeCalculator = {
        refresh: processAllClusters,
        refreshClusterA10s: processExpandedA10s,
        getClusterStats: function(clusterId) { return clusterStats[clusterId]; },
        getA10Stats: function(a10Id) { return a10Stats[a10Id]; },
        getAllClusterStats: function() { return clusterStats; },
        getAllA10Stats: function() { return a10Stats; }
    };

    $(document).ready(function() {
        setTimeout(init, 500);

        $('#adcMqttModal').on('hidden.bs.modal', function () {
            adcMqttDisconnect();
            currentAdcData = null;
        });

        $(document).on('keypress', '#adcCustomCommand', function(e) {
            if (e.which === 13) {
                e.preventDefault();
                adcSendCustomCommand();
            }
        });
    });
})();
</script>
