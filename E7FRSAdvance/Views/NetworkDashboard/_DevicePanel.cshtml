</style>

@Html.Partial("_SetConfigModal")

<script>
    // ============================================================
    // GLOBAL VARIABLES
    // ============================================================
    var currentSiteId = @Model.SiteId;
    var currentSiteMqttBasePath = '@siteMqttBasePath';
    var currentView = 'cluster';
    var assetTypesLoaded = false;
    var adcMqttClient = null;
    var currentAdcData = null;
    var UPTIME_GAP_THRESHOLD_MS = 10 * 60 * 1000;
    // ============================================================
    // VIEW TOGGLE FUNCTIONS
    // ============================================================
    function switchView(view, btn) {
        currentView = view;

        // Update button states
        $('#viewToggleGroup .btn').removeClass('active');
        $(btn).addClass('active');

        if (view === 'cluster') {
            $('#clusterViewFilters').show();
            $('#assetViewFilters').hide();
            $('#clusterViewContent').show();
            $('#assetViewContent').hide();
        } else {
            $('#clusterViewFilters').hide();
            $('#assetViewFilters').show();
            $('#clusterViewContent').hide();
            $('#assetViewContent').show();

            // Load asset types if not already loaded
            if (!assetTypesLoaded) {
                loadAssetTypes();
            }
        }
    }

    // ============================================================
    // ASSET VIEW FUNCTIONS
    // ============================================================
    function loadAssetTypes() {
        var url = '@Url.Action("GetAssetTypeBySiteId", "NetworkDashboard")' + '?siteId=' + currentSiteId;

        $.ajax({
            url: url,
            type: 'GET',
            dataType: 'json',
            success: function(response) {
                var dropdown = $('#assetTypeDropdown');
                dropdown.empty();
                dropdown.append('<option value="">-- Select Asset Type --</option>');

                if (Array.isArray(response)) {
                    response.forEach(function(item) {
                        dropdown.append('<option value="' + item.Id + '">' + item.Name + '</option>');
                    });
                }

                assetTypesLoaded = true;
                console.log('[AssetView] Loaded ' + response.length + ' asset types');
            },
            error: function(xhr, status, error) {
                console.error('[AssetView] Failed to load asset types:', error);
                showNotification('Failed to load asset types', 'error');
            }
        });
    }

    function onAssetTypeChange(select) {
        var assetTypeId = $(select).val();

        if (!assetTypeId) {
            $('#assetViewPlaceholder').show();
            $('#assetViewLoading').hide();
            $('#assetListContainer').hide();
            return;
        }

        loadAssetsByType(assetTypeId);
    }

    function loadAssetsByType(assetTypeId) {
        $('#assetViewPlaceholder').hide();
        $('#assetViewLoading').show();
        $('#assetListContainer').hide();

        var url = '@Url.Action("GetYardConfigByAssetTypeJson", "NetworkDashboard")' +
                  '?siteId=' + currentSiteId + '&assetTypeId=' + assetTypeId;

        $.ajax({
            url: url,
            type: 'GET',
            dataType: 'json',
            success: function(response) {
                $('#assetViewLoading').hide();

                var data = [];
                if (response && response.Success && response.Data) {
                    data = response.Data;
                } else if (Array.isArray(response)) {
                    data = response;
                }

                if (data.length > 0) {
                    renderAssetView(data);
                    $('#assetListContainer').show();
                } else {
                    $('#assetListContainer').html('<div class="text-center py-4 text-muted">No assets found for this type</div>').show();
                }
            },
            error: function(xhr, status, error) {
                $('#assetViewLoading').hide();
                $('#assetListContainer').html('<div class="text-center py-4 text-danger">Failed to load assets</div>').show();
                console.error('[AssetView] Failed to load assets:', error);
            }
        });
    }

    function renderAssetView(data) {
        // Group by AssetName
        var assetGroups = {};
        data.forEach(function(item) {
            var assetName = item.AssetName || 'Unknown';
            if (!assetGroups[assetName]) {
                assetGroups[assetName] = {
                    assetId: item.AssetId,
                    assetTypeName: item.AssetTypeName,
                    attributes: {}
                };
            }

            // Group by AttributeName within each asset
            var attrName = item.AttributeName || 'Unknown';
            if (!assetGroups[assetName].attributes[attrName]) {
                assetGroups[assetName].attributes[attrName] = {
                    attributeId: item.AttributeId,
                    adcs: []
                };
            }

            // Add ADC info
            assetGroups[assetName].attributes[attrName].adcs.push({
                id: item.Id,
                adcId: item.ADCId,
                adcNumber: item.ADCNumber,
                pin: item.Pin,
                clusterId: item.ClusterId,
                clusterName: item.ClusterName,
                modemId: item.ModemId,
                siteId: item.SiteId,
                cardName: item.CardName,
                locationName: item.LocationName,
                assetName: assetName,
                attributeName: attrName,
                multiplication: item.Multiplication,
                thresholdValue: item.ThresholdValue
            });
        });

        // Build HTML
        var html = '<div class="asset-view-list p-3">';

        Object.keys(assetGroups).sort().forEach(function(assetName) {
            var asset = assetGroups[assetName];
            var assetId = 'asset_' + assetName.replace(/[^a-zA-Z0-9]/g, '_');

            html += '<div class="asset-group">';
            html += '<div class="asset-header d-flex align-items-center gap-2" onclick="toggleAssetGroup(\'' + assetId + '\', this)">';
            html += '<i class="bi bi-chevron-right toggle-icon"></i>';
            html += '<i class="bi bi-box-seam text-primary"></i>';
            html += '<span class="fw-semibold">' + assetName + '</span>';
            html += '<span class="badge bg-secondary bg-opacity-25 text-secondary small ms-2">' + asset.assetTypeName + '</span>';
            html += '<span class="badge bg-info bg-opacity-25 text-info small ms-auto">' + Object.keys(asset.attributes).length + ' Attributes</span>';
            html += '</div>';

            html += '<div class="asset-content" id="' + assetId + '" style="display: none;">';

            Object.keys(asset.attributes).forEach(function(attrName) {
                var attr = asset.attributes[attrName];
                var attrId = assetId + '_attr_' + attrName.replace(/[^a-zA-Z0-9]/g, '_');

                html += '<div class="attribute-group">';
                html += '<div class="attribute-header d-flex align-items-center gap-2" onclick="toggleAttributeGroup(\'' + attrId + '\', this)">';
                html += '<i class="bi bi-chevron-right toggle-icon" style="font-size: 0.7rem;"></i>';
                html += '<i class="bi bi-speedometer2 text-success" style="font-size: 0.85rem;"></i>';
                html += '<span class="small fw-medium">' + attrName + '</span>';
                html += '<span class="badge bg-primary bg-opacity-10 text-primary small ms-auto">' + attr.adcs.length + ' ADCs</span>';
                html += '</div>';

                html += '<div class="adc-list" id="' + attrId + '" style="display: none;">';
                attr.adcs.forEach(function(adc) {
                    html += '<div class="adc-item" onclick="openAdcMqttModal(' + JSON.stringify(adc).replace(/"/g, '&quot;') + ')">';
                    html += '<i class="bi bi-cpu text-warning"></i>';
                    html += '<span class="adc-number">ADC-' + adc.adcNumber + '</span>';
                    html += '<span class="adc-pin">Pin ' + adc.pin + '</span>';
                    html += '<span class="badge bg-dark bg-opacity-10 small">' + (adc.clusterName || '-') + '</span>';
                    html += '</div>';
                });
                html += '</div>';

                html += '</div>';
            });

            html += '</div>';
            html += '</div>';
        });

        html += '</div>';

        $('#assetListContainer').html(html);
    }

    function toggleAssetGroup(assetId, header) {
        var content = $('#' + assetId);
        var isExpanded = content.is(':visible');

        if (isExpanded) {
            content.slideUp(200);
            $(header).removeClass('expanded');
        } else {
            content.slideDown(200);
            $(header).addClass('expanded');
        }
    }

    function toggleAttributeGroup(attrId, header) {
        var content = $('#' + attrId);
        var isExpanded = content.is(':visible');

        if (isExpanded) {
            content.slideUp(200);
            $(header).removeClass('expanded');
        } else {
            content.slideDown(200);
            $(header).addClass('expanded');
        }
    }

    // ============================================================
    // ADC MQTT MODAL FUNCTIONS
    // ============================================================
    function openAdcMqttModal(adcData) {
        currentAdcData = adcData;

        // Disconnect any existing MQTT connection when opening new modal
        if (adcMqttClient != null) {
            try {
                adcMqttClient.disconnect();
            } catch (e) {
                // Ignore
            }
            adcMqttClient = null;
        }

        // Populate modal info - all fields
        $('#adcModalNumber').text('ADC-' + adcData.adcNumber);
        $('#adcModalCluster').text(adcData.clusterName || '-');
        $('#adcModalModem').text(adcData.modemId || '-');
        $('#adcModalPin').text(adcData.pin || '-');
        $('#adcModalAsset').text(adcData.assetName || '-');
        $('#adcModalAttribute').text(adcData.attributeName || '-');
        $('#adcModalLocation').text(adcData.locationName || '-');
        $('#adcModalCard').text(adcData.cardName || '-');

        // Build MQTT topics using the site's base path
        var basePath = currentSiteMqttBasePath || 'rdpms';
        var clusterNameClean = (adcData.clusterName || '').replace(/\s+/g, '');
        var subscribeTopic = basePath + clusterNameClean + '/P';
        var publishTopic = basePath + clusterNameClean + '/S';

        $('#adcMqttSubscribeTopic').val(subscribeTopic);
        $('#adcMqttPublishTopic').val(publishTopic);

        // Reset connection status
        $('#adcMqttConnectionStatus').removeClass('bg-success bg-danger bg-warning').addClass('bg-secondary').html('<i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Disconnected');
        $('#btnAdcMqttConnect').show();
        $('#btnAdcMqttDisconnect').hide();
        $('#adcMqttLastUpdate').text('Last Update: --');

        // Clear log
        $('#adcMqttLogContainer').html('<div class="p-2 text-muted text-center" style="color: #6c757d !important;">Waiting for connection...</div>');

        // Clear custom command input
        $('#adcCustomCommand').val('');

        // Show modal
        var modal = new bootstrap.Modal(document.getElementById('adcMqttModal'));
        modal.show();
    }

    function adcMqttConnect() {
        if (!currentAdcData) return;

        var subscribeTopic = $('#adcMqttSubscribeTopic').val();

        try {
            // Disconnect existing connection if any
            if (adcMqttClient != null) {
                try {
                    adcMqttClient.disconnect();
                } catch (e) {
                    // Ignore disconnect errors
                }
            }

            // Check if MQTT config is available
            if (typeof mQTT === 'undefined' || mQTT == null) {
                addAdcMqttLog('error', 'MQTT configuration not available');
                return;
            }

            // Detect if running on HTTPS
            var isSecure = window.location.protocol === "https:";

            // Create unique client ID
            var clientId = "adcConsole_" + Math.ceil(Math.random() * 10000);

            // Create Paho MQTT Client
            adcMqttClient = new Paho.Client(mQTT.MQTTUri, mQTT.MQTTPort, clientId);

            // Set callback handlers
            adcMqttClient.onConnectionLost = function(responseObject) {
                console.log('[ADC MQTT] Connection lost:', responseObject.errorMessage);
                $('#adcMqttConnectionStatus').removeClass('bg-success bg-warning').addClass('bg-danger').html('<i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Disconnected');
                $('#btnAdcMqttConnect').show();
                $('#btnAdcMqttDisconnect').hide();
                addAdcMqttLog('error', 'Connection lost: ' + responseObject.errorMessage);
            };

            adcMqttClient.onMessageArrived = function(message) {
                console.log('[ADC MQTT] Message received:', message.payloadString);
                addAdcMqttLog('received', message.payloadString);
            };

            // Update status
            $('#adcMqttConnectionStatus').removeClass('bg-secondary bg-danger').addClass('bg-warning').html('<i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Connecting...');
            addAdcMqttLog('info', 'Connecting to ' + mQTT.MQTTUri + ':' + mQTT.MQTTPort + ' (SSL: ' + isSecure + ')');

            // Connect with SSL support
            adcMqttClient.connect({
                onSuccess: function() {
                    console.log('[ADC MQTT] Connected successfully');
                    $('#adcMqttConnectionStatus').removeClass('bg-secondary bg-danger bg-warning').addClass('bg-success').html('<i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Connected');
                    $('#btnAdcMqttConnect').hide();
                    $('#btnAdcMqttDisconnect').show();
                    addAdcMqttLog('info', 'Connected successfully');

                    // Subscribe to topic
                    adcMqttClient.subscribe(subscribeTopic);
                    addAdcMqttLog('info', 'Subscribed to: ' + subscribeTopic);
                },
                onFailure: function(error) {
                    console.error('[ADC MQTT] Connection failed:', error);
                    $('#adcMqttConnectionStatus').removeClass('bg-success bg-warning').addClass('bg-danger').html('<i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Failed');
                    $('#btnAdcMqttConnect').show();
                    $('#btnAdcMqttDisconnect').hide();
                    addAdcMqttLog('error', 'Connection failed: ' + (error.errorMessage || 'Unknown error'));
                },
                useSSL: isSecure,
                userName: mQTT.MQTTUsername,
                password: mQTT.MQTTPassword,
                cleanSession: true,
                timeout: 10
            });

        } catch (e) {
            console.error('[ADC MQTT] Error:', e);
            addAdcMqttLog('error', 'Error: ' + e.message);
            $('#adcMqttConnectionStatus').removeClass('bg-success bg-warning').addClass('bg-danger').html('<i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Error');
        }
    }

    function adcMqttDisconnect() {
        if (adcMqttClient != null) {
            try {
                adcMqttClient.disconnect();
                addAdcMqttLog('info', 'Disconnected');
            } catch (e) {
                console.log('[ADC MQTT] Disconnect error:', e);
            }
        }
        adcMqttClient = null;
        $('#adcMqttConnectionStatus').removeClass('bg-success bg-warning bg-danger').addClass('bg-secondary').html('<i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Disconnected');
        $('#btnAdcMqttConnect').show();
        $('#btnAdcMqttDisconnect').hide();
    }

    function adcMqttSendCommand(command) {
        if (adcMqttClient == null) {
            showNotification('Please connect to MQTT first', 'warning');
            return;
        }

        var publishTopic = $('#adcMqttPublishTopic').val();
        var payload = command;

        try {
            var message = new Paho.Message(payload);
            message.destinationName = publishTopic;
            adcMqttClient.send(message);
            addAdcMqttLog('sent', 'Topic: ' + publishTopic + ' | Payload: ' + payload);
        } catch (e) {
            console.error('[ADC MQTT] Send error:', e);
            addAdcMqttLog('error', 'Send failed: ' + e.message);
            showNotification('Failed to send command', 'error');
        }
    }

    function adcSendQuickCommand(command) {
        if (adcMqttClient == null) {
            showNotification('Please connect to MQTT first', 'warning');
            return;
        }

        var publishTopic = $('#adcMqttPublishTopic').val();
        var adcNumber = currentAdcData ? currentAdcData.adcNumber : '';
        var payload = command;
        if (adcNumber) {
            payload = command + ',' + adcNumber;
        }

        try {
            var message = new Paho.Message(payload);
            message.destinationName = publishTopic;
            adcMqttClient.send(message);
            addAdcMqttLog('sent', payload);
            updateLastUpdateTime();
        } catch (e) {
            console.error('[ADC MQTT] Send error:', e);
            addAdcMqttLog('error', 'Send failed: ' + e.message);
            showNotification('Failed to send command', 'error');
        }
    }

    function adcSendCustomCommand() {
        var customCommand = $('#adcCustomCommand').val().trim();

        if (!customCommand) {
            showNotification('Please enter a command', 'warning');
            return;
        }

        if (adcMqttClient == null) {
            showNotification('Please connect to MQTT first', 'warning');
            return;
        }

        var publishTopic = $('#adcMqttPublishTopic').val();

        try {
            var message = new Paho.Message(customCommand);
            message.destinationName = publishTopic;
            adcMqttClient.send(message);
            addAdcMqttLog('sent', customCommand);
            updateLastUpdateTime();
            $('#adcCustomCommand').val('');
        } catch (e) {
            console.error('[ADC MQTT] Send error:', e);
            addAdcMqttLog('error', 'Send failed: ' + e.message);
            showNotification('Failed to send command', 'error');
        }
    }

    function updateLastUpdateTime() {
        var now = new Date();
        var timeStr = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0') + ':' + String(now.getSeconds()).padStart(2, '0');
        $('#adcMqttLastUpdate').text('Last Update: ' + timeStr);
    }

    function copyAdcMqttLog() {
        var container = $('#adcMqttLogContainer');
        var logText = '';

        container.find('.log-entry').each(function() {
            var time = $(this).find('.log-time').text();
            var msg = $(this).find('span:last').text();
            logText += '[' + time + '] ' + msg + '\n';
        });

        if (logText) {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(logText).then(function() {
                    showNotification('Log copied to clipboard', 'success');
                });
            } else {
                var textArea = document.createElement('textarea');
                textArea.value = logText;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
                showNotification('Log copied to clipboard', 'success');
            }
        } else {
            showNotification('No log entries to copy', 'warning');
        }
    }

    function addAdcMqttLog(type, message) {
        var container = $('#adcMqttLogContainer');
        container.find('.text-muted.text-center').remove();

        var now = new Date();
        var time = String(now.getHours()).padStart(2, '0') + ':' +
                   String(now.getMinutes()).padStart(2, '0') + ':' +
                   String(now.getSeconds()).padStart(2, '0');

        var bgColor = '';
        var icon = 'info-circle';
        var iconColor = '#17a2b8';

        if (type === 'sent') {
            bgColor = 'rgba(40, 167, 69, 0.2)';
            icon = 'arrow-up-circle-fill';
            iconColor = '#28a745';
        } else if (type === 'received') {
            bgColor = 'rgba(0, 123, 255, 0.2)';
            icon = 'arrow-down-circle-fill';
            iconColor = '#007bff';
            updateLastUpdateTime();
        } else if (type === 'error') {
            bgColor = 'rgba(220, 53, 69, 0.2)';
            icon = 'exclamation-triangle-fill';
            iconColor = '#dc3545';
        } else {
            bgColor = 'rgba(108, 117, 125, 0.1)';
            icon = 'info-circle-fill';
            iconColor = '#6c757d';
        }

        var html = '<div class="log-entry" style="padding: 6px 10px; border-bottom: 1px solid #333; background: ' + bgColor + ';">';
        html += '<span class="log-time" style="color: #888; margin-right: 10px; font-size: 0.75rem;">[' + time + ']</span>';
        html += '<i class="bi bi-' + icon + ' me-2" style="color: ' + iconColor + ';"></i>';
        html += '<span style="color: #e0e0e0; word-break: break-all;">' + escapeHtml(message) + '</span>';
        html += '</div>';

        container.append(html);
        container.scrollTop(container[0].scrollHeight);
    }

    function clearAdcMqttLog() {
        $('#adcMqttLogContainer').html('<div class="p-2 text-center" style="color: #6c757d;">Log cleared</div>');
    }

    function openSetConfigFromMqttModal() {
        if (!currentAdcData) return;
        var mqttModal = bootstrap.Modal.getInstance(document.getElementById('adcMqttModal'));
        if (mqttModal) mqttModal.hide();
        //openSetConfigModal('adc', currentAdcData.siteId, currentAdcData.clusterId, currentAdcData.adcNumber,
        //                  'ADC-' + currentAdcData.adcNumber, currentSiteMqttBasePath);
        openSetConfigModal('ADC-' + currentAdcData.adcNumber, 'adc', currentAdcData.siteId, currentAdcData.clusterId, currentAdcData.adcNumber, currentSiteMqttBasePath);

    }

    function escapeHtml(text) {
        var div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function showNotification(message, type) {
        if (typeof CommonNotification === 'function') {
            CommonNotification(message, type);
        } else {
            alert(message);
        }
    }
