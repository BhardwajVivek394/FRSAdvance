    /* ── CLUSTER UPTIME WIDGET — bifurcated TCP + MQTT ── */
    .cluster-uptime-stats {
        display: inline-flex;
        align-items: stretch;
        border-radius: 7px;
        border: 1px solid var(--border-color, rgba(0,0,0,0.1));
        overflow: hidden;
        background: var(--card-bg, rgba(0,0,0,0.03));
        white-space: nowrap;
    }

    /* Each protocol block */
    .cluster-uptime-block {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 3px 10px;
        min-width: 68px;
    }

        .cluster-uptime-block + .cluster-uptime-block {
