@model Domain.Dto.DashboardPageVM

@{
    int errorTotal = 0;
}

<div class="dashboard-header border-bottom p-2 d-flex gap-5 flex-wrap">
    <!-- STATIONS -->
    <div class="card header-card px-3 py-2 d-flex flex-row align-items-center gap-2">
        <i class="bi bi-buildings fs-5 text-primary"></i>
        <div>
            <div class="fw-bold header-value">@Model.TotalStations</div>
            <div class="header-label">STATIONS</div>
        </div>
    </div>

    <!-- MODEMS GROUP -->
    <div class="d-flex gap-2 flex-wrap">
        <!-- Total Modems -->
        <div class="card header-card px-3 py-2 d-flex flex-row align-items-center gap-2">
            <i class="bi bi-router fs-5 text-v1"></i>
            <div>
                <div class="fw-bold header-value">@Model.TotalModems</div>
                <div class="header-label">MODEMS</div>
            </div>
        </div>

        <!-- V1 -->
        <div class="card header-card px-3 py-2 d-flex flex-row align-items-center gap-2">
            <span class="fs-5 fw-bold text-v1">V1</span>
            <div>
                <div class="fw-bold text-success">
                    @Model.V1MqttOnline
                    <span class="fw-normal header-label-inline">Online</span>
                </div>
                <div class="fw-bold header-value">
                    @Model.TotalVersion1
                    <span class="fw-normal header-label-inline">Total</span>
                </div>
            </div>
        </div>

        <!-- V2 -->
        <div class="card header-card px-3 py-2 d-flex flex-row align-items-center gap-2">
            <span class="fs-5 fw-bold text-a10">V2</span>
            <div>
                <div class="fw-bold text-success">
                    @Model.V2MqttOnline
                    <span class="fw-normal header-label-inline">Online</span>
                </div>
                <div class="fw-bold header-value">
                    @Model.TotalVersion2
                    <span class="fw-normal header-label-inline">Total</span>
                </div>
            </div>
        </div>


        @*<div class="card card-elevated px-3 py-2 d-flex flex-row align-items-center gap-2">
            <i class="bi bi-x-circle fs-5 text-danger"></i>
            <div><div class="fw-bold text-danger">@Model.ModemErrorCount</div><div class="text-muted" style="font-size: 0.6rem;">Error</div></div>
        </div>*@
    </div>

    <!-- A10 GROUP -->
    <div class="d-flex gap-2 flex-wrap">
        <!-- Total A10 -->
        <div class="card header-card px-3 py-2 d-flex flex-row align-items-center gap-2">
            <i class="bi bi-broadcast fs-5 text-v2"></i>
            <div>
                <div class="fw-bold header-value">@Model.TotalA10Count</div>
                <div class="header-label">A10</div>
            </div>
        </div>

        <!-- TCP -->
        <div class="card header-card px-3 py-2 d-flex flex-row align-items-center gap-2">
            <span class="fs-5 fw-bold text-tcp">TCP</span>
            <div>
                <div class="fw-bold text-success">
                    @Model.TCPA10OnlineCount
                    <span class="fw-normal header-label-inline">Online</span>
                </div>
                <div class="fw-bold header-value">
                    @Model.TCPA10Count
                    <span class="fw-normal header-label-inline">Total</span>
                </div>
            </div>
        </div>

        <!-- MQTT -->
        <div class="card header-card px-3 py-2 d-flex flex-row align-items-center gap-2">
            <span class="fs-5 fw-bold text-mqtt">MQTT</span>
            <div>
                <div class="fw-bold text-success">
                    @Model.MQTTA10OnlineCount
                    <span class="fw-normal header-label-inline">Online</span>
                </div>
                <div class="fw-bold header-value">
                    @Model.MQTTA10Count
                    <span class="fw-normal header-label-inline">Total</span>
                </div>
            </div>
        </div>

        <!-- Error -->
        @*<div class="card header-card px-3 py-2 d-flex flex-row align-items-center gap-2">
            <i class="bi bi-x-circle fs-5 text-danger"></i>
            <div>
                <div class="fw-bold text-danger">@Model.TCPErrorCount</div>
                <div class="header-label">Error</div>
            </div>
        </div>*@
    </div>
</div>

<style>
    /* ============================================================
       DASHBOARD HEADER - THEME AWARE STYLES
       ============================================================ */

    /* Header Container */
    .dashboard-header {
        background-color: var(--card-bg);
        border-color: var(--border-color) !important;
        transition: background-color 0.3s ease;
    }

        /* Header Card */
        .dashboard-header .header-card {
            background-color: var(--card-elevated-bg) !important;
            border: 1px solid var(--border-light) !important;
            box-shadow: var(--shadow);
            transition: background-color 0.3s ease, border-color 0.3s ease;
        }

        /* Header Value (Bold numbers) */
        .dashboard-header .header-value {
            color: var(--body-color);
        }

        /* Header Label (Small text below) */
        .dashboard-header .header-label {
            font-size: 0.6rem;
            color: var(--muted-color);
        }

        /* Inline Label (Small text next to numbers) */
        .dashboard-header .header-label-inline {
            font-size: 0.6rem;
            color: var(--muted-color);
        }

        /* Color Classes - Using CSS Variables */
        .dashboard-header .text-v1 {
            color: var(--v1-color) !important;
        }

        .dashboard-header .text-v2 {
            color: var(--v2-color) !important;
        }

        .dashboard-header .text-a10 {
            color: var(--a10-color) !important;
        }

        .dashboard-header .text-tcp {
            color: var(--tcp-color) !important;
        }

        .dashboard-header .text-mqtt {
            color: var(--mqtt-color) !important;
        }
</style>