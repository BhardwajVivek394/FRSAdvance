<!-- A10 Detail Panel (Hidden by default, shown on A10 click) -->
<div id="a10DetailBS" style="display: none;">

    <!-- Header -->
    <div class="p-3 border-bottom">
        <div class="d-flex align-items-center gap-2 mb-2">
            <div class="bg-a10 rounded d-flex align-items-center justify-content-center"
                 style="width: 36px; height: 36px;">
                <i class="bi bi-gear text-a10"></i>
            </div>
            <h5 class="mb-0" id="a10NameBS">A10-001</h5>
            <span class="badge badge-a10">A10 DEVICE</span>
        </div>
        <small class="text-muted">
            <i class="bi bi-geo-alt me-1"></i><span id="a10LocationBS">Modem-001 / Station-01 / Division-A</span>
        </small>
    </div>

    <!-- Hidden fields for commands -->
    <input type="hidden" id="a10IdBS" value="" />
    <input type="hidden" id="a10ModemIdBS" value="" />
    <input type="hidden" id="a10ClusterNameBS" value="" />
    <input type="hidden" id="a10MqttBaseBS" value="" />

    <!-- Tab Navigation -->
    <ul class="nav nav-pills nav-fill p-2 border-bottom" id="a10Tabs">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="pill" href="#a10Status">Status</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="pill" href="#a10History">History</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="pill" href="#a10Command">Command</a>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content p-3">

        <!-- ========================================== -->
        <!-- STATUS TAB -->
        <!-- ========================================== -->
        <div class="tab-pane fade show active" id="a10Status">

            <h6 class="text-uppercase text-muted small mb-2" style="font-size: 0.65rem;">Connection Status</h6>
            <div class="row g-2 mb-3">
                <!-- TCP Status -->
                <div class="col-6">
                    <div class="card card-elevated p-2">
                        <small class="text-muted" style="font-size: 0.6rem;">Modbus TCP</small>
                        <div class="fw-semibold small d-flex align-items-center gap-1">
                            <span class="status-dot offline" id="a10TcpStatusDotBS"></span>
                            <span id="a10TcpStatusBS">Offline</span>
                        </div>
                    </div>
                </div>
                <!-- MQTT Status -->
                <div class="col-6">
                    <div class="card card-elevated p-2">
                        <small class="text-muted" style="font-size: 0.6rem;">MQTT Periodic</small>
                        <div class="fw-semibold small d-flex align-items-center gap-1">
                            <span class="status-dot offline" id="a10MqttStatusDotBS"></span>
                            <span id="a10MqttStatusBS">Disconnected</span>
                        </div>
                    </div>
                </div>
                <!-- Type -->
                <div class="col-6">
                    <div class="card card-elevated p-2">
                        <small class="text-muted" style="font-size: 0.6rem;">Type</small>
                        <div class="fw-semibold small" id="a10TypeBS">-</div>
                    </div>
                </div>
                <!-- Firmware -->
                <div class="col-6">
                    <div class="card card-elevated p-2">
                        <small class="text-muted" style="font-size: 0.6rem;">Firmware</small>
                        <div class="fw-semibold small" id="a10FirmwareBS">-</div>
                    </div>
                </div>
                <!-- Slave Address -->
                <div class="col-6">
                    <div class="card card-elevated p-2">
                        <small class="text-muted" style="font-size: 0.6rem;">Slave Address</small>
                        <div class="fw-semibold small" id="a10SlaveBS">-</div>
                    </div>
                </div>
                <!-- Channels -->
                @*<div class="col-6">
                        <div class="card card-elevated p-2">
                            <small class="text-muted" style="font-size: 0.6rem;">Channels</small>
                            <div class="fw-semibold small" id="a10ChannelsBS">-</div>
                        </div>
                    </div>*@
                <!-- Parent Modem -->
                <div class="col-6">
                    <div class="card card-elevated p-2">
                        <small class="text-muted" style="font-size: 0.6rem;">Parent Modem</small>
                        <div class="fw-semibold small text-v2" id="a10ParentModemBS">-</div>
                    </div>
                </div>
                <!-- Last Data -->
                <div class="col-6">
                    <div class="card card-elevated p-2">
                        <small class="text-muted" style="font-size: 0.6rem;">Last Data</small>
                        <div class="fw-semibold small" id="a10LastDataBS">-</div>
                    </div>
                </div>
            </div>

            <h6 class="text-uppercase text-muted small mb-2" style="font-size: 0.65rem;">MQTT Paths</h6>
            <div class="row g-2">
                <!-- Subscribe Topic -->
                <div class="col-6">
                    <div class="card card-elevated p-2">
                        <small class="text-muted" style="font-size: 0.55rem;">Subscribe (Response)</small>
                        <div class="font-mono text-mqtt" style="font-size: 0.6rem;" id="a10SubTopicBS">-</div>
                    </div>
                </div>
                <!-- Publish Topic -->
                <div class="col-6">
                    <div class="card card-elevated p-2">
                        <small class="text-muted" style="font-size: 0.55rem;">Publish (Command)</small>
                        <div class="font-mono text-mqtt" style="font-size: 0.6rem;" id="a10PubTopicBS">-</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- HISTORY TAB -->
        <!-- ========================================== -->
        <div class="tab-pane fade" id="a10History">

            <h6 class="text-uppercase text-muted small mb-2" style="font-size: 0.65rem;">Status History</h6>

            <!-- History List Container -->
            <div class="d-flex flex-column gap-2" id="a10HistoryListBS">
                <div class="text-muted small text-center py-3">Select an A10 to view history</div>
            </div>

            <!-- Refresh Button -->
            <div class="mt-3 text-center">
                <button class="btn btn-outline-secondary btn-sm" onclick="loadA10History(document.getElementById('a10IdBS').value)">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh History
                </button>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- COMMAND TAB -->
        <!-- ========================================== -->
        <div class="tab-pane fade" id="a10Command">

            <h6 class="text-uppercase text-muted small mb-2" style="font-size: 0.65rem;">A10 Commands</h6>

            <!-- Command Buttons -->
            <div class="row g-2 mb-3">
                <!-- Event Get -->
                <div class="col-6">
                    <button class="btn btn-outline-secondary btn-sm w-100 text-start" onclick="sendA10CmdBS('event_get')">
                        <i class="bi bi-list-ul me-1"></i>Event Get
                        <small class="d-block font-mono text-muted" style="font-size: 0.5rem;">{"id":1,"event_get":1}</small>
                    </button>
                </div>
                <!-- Event Clear -->
                <div class="col-6">
                    <button class="btn btn-outline-secondary btn-sm w-100 text-start" onclick="sendA10CmdBS('event_clear')">
                        <i class="bi bi-trash me-1"></i>Event Clear
                        <small class="d-block font-mono text-muted" style="font-size: 0.5rem;">{"id":1,"event_clear":0}</small>
                    </button>
                </div>
                <!-- Channel Get -->
                <div class="col-6">
                    <button class="btn btn-outline-secondary btn-sm w-100 text-start" onclick="sendA10CmdBS('channel_get')">
                        <i class="bi bi-diagram-3 me-1"></i>Channel Get
                        <small class="d-block font-mono text-muted" style="font-size: 0.5rem;">{"id":1,"channel_get":1}</small>
                    </button>
                </div>
                <!-- Channel Get All -->
                <div class="col-6">
                    <button class="btn btn-outline-secondary btn-sm w-100 text-start" onclick="sendA10CmdBS('channel_get_all')">
                        <i class="bi bi-collection me-1"></i>Get All
                        <small class="d-block font-mono text-muted" style="font-size: 0.5rem;">{"id":1,"channel_get_all":1}</small>
                    </button>
                </div>
                <!-- Get Update -->
                <div class="col-6">
                    <button class="btn btn-outline-secondary btn-sm w-100 text-start" onclick="sendA10CmdBS('update')">
                        <i class="bi bi-arrow-repeat me-1"></i>Get Update
                        <small class="d-block font-mono text-muted" style="font-size: 0.5rem;">{"id":1,"update":1}</small>
                    </button>
                </div>
                <!-- Channel Set -->
                <div class="col-6">
                    <button class="btn btn-outline-secondary btn-sm w-100 text-start" onclick="sendA10CmdBS('channel_set')">
                        <i class="bi bi-gear me-1"></i>Channel Set
                        <small class="d-block font-mono text-muted" style="font-size: 0.5rem;">{"id":1,"channel_set":...}</small>
                    </button>
                </div>
            </div>

            <!-- Console -->
            <h6 class="text-uppercase text-muted small mb-2" style="font-size: 0.65rem;">Console</h6>
            <div class="console">
                <!-- Console Header -->
                <div class="console-header d-flex justify-content-between align-items-center p-2">
                    <span class="small fw-semibold">
                        <span class="text-danger" id="a10ConsoleDotBS">●</span> A10 Terminal
                    </span>
                    <small class="text-muted" id="a10ConsoleStatusBS">MQTT</small>
                </div>
                <!-- Console Body -->
                <div class="console-body p-2" id="a10ConsoleBS">
                    <div class="console-line info">// Select an A10 device</div>
                </div>
                <!-- Console Input -->
                <div class="d-flex border-top">
                    <span class="p-2 text-primary font-mono">&gt;</span>
                    <input type="text"
                           class="console-input flex-grow-1 p-2"
                           id="a10InputBS"
                           placeholder='{"id":1,"command":...}'>
                    <button class="btn btn-primary btn-sm rounded-0" onclick="sendA10ConsoleBS()">Send</button>
                </div>
            </div>
        </div>

    </div>
</div>