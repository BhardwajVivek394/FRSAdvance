@model Domain.Dto.ModemStatusVM

@if (Model == null)
{
<div class="text-muted small text-center py-3">No status data available</div> }
            else
            {
                // C# 5 compatible - explicit null checks
                string tcpStatusClass = Model.TCPStatus == "Online" ? "text-success" : "text-danger";
                string mqttStatusClass = Model.MQTTStatus == "Online" ? "text-success" : "text-danger";
                bool hasTcpSignal = !string.IsNullOrEmpty(Model.TCPSignalStrength);
                bool hasMqttSignal = !string.IsNullOrEmpty(Model.MQTTSignalStrength);

<div class="row g-2">
    <div class="col-6">
        <div class="card card-elevated p-2">
            <small class="text-muted">TCP Status</small>
            <div class="fw-semibold @tcpStatusClass">
                @Model.TCPStatus
                @if (hasTcpSignal)
                {
<span class="small ms-2 text-muted">(@Model.TCPSignalStrength)</span>}
            </div>
        </div>
    </div>
    <div class="col-6">
        <div class="card card-elevated p-2">
            <small class="text-muted">MQTT Status</small>
            <div class="fw-semibold @mqttStatusClass">
                @Model.MQTTStatus
                @if (hasMqttSignal)
                {
<span class="small ms-2 text-muted">(@Model.MQTTSignalStrength)</span>}
            </div>
        </div>
    </div>
    <div class="col-6">
        <div class="card card-elevated p-2">
            <small class="text-muted">Connected A10</small>
            <div class="fw-semibold text-a10">@Model.ADCCount</div>
        </div>
    </div>
    <div class="col-6">
        <div class="card card-elevated p-2">
            <small class="text-muted">SIM</small>
            <div class="fw-semibold">@Model.SimNumber</div>
        </div>
    </div>
</div>

                <h6 class="text-uppercase text-muted small mb-2 mt-3" style="font-size: 0.65rem; letter-spacing: 0.05em;">TCP Ports</h6>
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <div class="card card-elevated p-2">
                                            <small class="text-muted" style="font-size: 0.55rem;">Command Port (Send)</small>
                                            <div class="font-mono small text-tcp">@Model.TCPSend</div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="card card-elevated p-2">
                                            <small class="text-muted" style="font-size: 0.55rem;">Response Port (Recv)</small>
                                            <div class="font-mono small text-tcp">@Model.TCPReceive</div>
                                        </div>
                                    </div>
                                </div>

                                                <h6 class="text-uppercase text-muted small mb-2" style="font-size: 0.65rem; letter-spacing: 0.05em;">MQTT Paths</h6>
                                                                <div class="row g-2">
                                                                    <div class="col-6">
                                                                        <div class="card card-elevated p-2">
                                                                            <small class="text-muted" style="font-size: 0.55rem;">Subscribe (Send)</small>
                                                                            <div class="font-mono text-mqtt" style="font-size: 0.65rem;">@Model.SubscribeTopic</div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-6">
                                                                        <div class="card card-elevated p-2">
                                                                            <small class="text-muted" style="font-size: 0.55rem;">Publish (Recv)</small>
                                                                            <div class="font-mono text-mqtt" style="font-size: 0.65rem;">@Model.PublishTopic</div>
                                                                        </div>
                                                                    </div>
                                                                </div>}
