@using System.Linq
@model List<Domain.Dto.ModemHistoryVM>
@{ int clusterId = ViewBag.ClusterId != null ? (int)ViewBag.ClusterId : 0;
    string fromDate = ViewBag.FromDate != null ? ViewBag.FromDate.ToString() : DateTime.Now.AddDays(-7).ToString("yyyy-MM-dd");
    string toDate = ViewBag.ToDate != null ? ViewBag.ToDate.ToString() : DateTime.Now.ToString("yyyy-MM-dd"); }

<div class="modem-history-panel" data-cluster-id="@clusterId">
    <!-- Header with Graph Button -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="section-title mb-0">Status History</h6>
        <button type="button" class="btn btn-graph-unified" id="btnModemGraph" onclick="openModemGraphModal(@clusterId)">
            <i class="bi bi-graph-up"></i> View Graph
        </button>
    </div>

    <!-- Filter Controls -->
    <div class="history-filters mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small text-muted mb-1">From</label>
                <input type="date" class="form-control form-control-sm" id="modemHistoryFromDate" value="@fromDate" style="width: 130px;">
            </div>
            <div class="col-auto">
                <label class="form-label small text-muted mb-1">To</label>
                <input type="date" class="form-control form-control-sm" id="modemHistoryToDate" value="@toDate" style="width: 130px;">
            </div>
            <div class="col-auto">
                <label class="form-label small text-muted mb-1">Protocol</label>
                <select class="form-select form-select-sm" id="modemHistoryProtocolFilter" style="width: 100px;" onchange="filterHistoryByProtocol()">
                    <option value="all">All</option>
                    <option value="tcp">TCP</option>
                    <option value="mqtt">MQTT</option>
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary btn-sm" type="button" onclick="reloadModemHistory()" title="Load History">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- Record Count -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="text-muted">
            Showing: <strong id="visibleHistoryCount">@(Model != null ? Model.Count : 0)</strong>
            of <strong id="totalHistoryCount">@(Model != null ? Model.Count : 0)</strong> records
        </small>
        <small class="text-muted" id="filterInfo"></small>
    </div>

    <!-- History List -->
    <div class="d-flex flex-column gap-2 history-list-scroll" id="modemHistoryListBS">
        @if (Model == null || Model.Count == 0)
        {
            <div class="no-history-msg small text-center py-3">
                <i class="bi bi-inbox opacity-50 d-block mb-2" style="font-size: 1.5rem;"></i>
                No history found for selected date range
            </div> }
        else
        {
            var sortedData = Model.OrderBy(x => x.TimeStamp).ToList();
            int gapThresholdMinutes = 5;

            // Create list using Tuple for C# 5 compatibility
            // Item1=TimeStamp, Item2=TypeId, Item3=SignalStrength, Item4=DisplayTypeId
            var displayList = new List<Tuple<DateTime, int, string, int>>();

            DateTime startOfDay = sortedData.First().TimeStamp.Date;
            DateTime endOfDay = DateTime.Now < startOfDay.AddDays(1) ? DateTime.Now : startOfDay.AddDays(1).AddMinutes(-1);

            // Determine the first known protocol for start-of-day gap
            int firstKnownProtocol = sortedData.First().TypeId;

            // Check for gap at start of day
            if ((sortedData.First().TimeStamp - startOfDay).TotalMinutes > gapThresholdMinutes)
            {
                // Use the first known protocol for the offline entry
                displayList.Add(Tuple.Create(startOfDay, 0, "0", firstKnownProtocol));
            }

            for (int i = 0; i < sortedData.Count; i++)
            {
                var current = sortedData[i];

                if (i > 0)
                {
                    var prev = sortedData[i - 1];
                    var gapMinutes = (current.TimeStamp - prev.TimeStamp).TotalMinutes;

                    if (gapMinutes > gapThresholdMinutes)
                    {
                        // Use the PREVIOUS entry's protocol for the offline gap
                        int gapProtocol = prev.TypeId > 0 ? prev.TypeId : current.TypeId;
                        displayList.Add(Tuple.Create(prev.TimeStamp.AddMinutes(1), 0, "0", gapProtocol));
                    }
                }

                // Add current entry with its own protocol
                displayList.Add(Tuple.Create(current.TimeStamp, current.TypeId, current.SignalStrength, current.TypeId));
            }

            // Check for gap at end of day
            if ((endOfDay - sortedData.Last().TimeStamp).TotalMinutes > gapThresholdMinutes)
            {
                // Use the last known protocol
                int lastProtocol = sortedData.Last().TypeId;
                displayList.Add(Tuple.Create(sortedData.Last().TimeStamp.AddMinutes(1), 0, "0", lastProtocol));
            }

            // Display in reverse chronological order (newest first)
            foreach (var item in displayList.OrderByDescending(x => x.Item1))
            {
                // Extract tuple values: Item1=TimeStamp, Item2=TypeId, Item3=SignalStrength, Item4=DisplayTypeId
                DateTime itemTimeStamp = item.Item1;
                string itemSignalStrength = item.Item3;
                int itemDisplayTypeId = item.Item4;

                int signalVal = 0;
                //bool hasSignal = !string.IsNullOrEmpty(itemSignalStrength) && int.TryParse(itemSignalStrength, out signalVal);
                //bool isOnline = hasSignal && signalVal > 0;

                double tempVal = 0;
                bool hasSignal = !string.IsNullOrEmpty(itemSignalStrength)
                                 && double.TryParse(itemSignalStrength, out tempVal);

                if (hasSignal)
                {
                    signalVal = (int)tempVal;
                }

                bool isOnline = hasSignal && signalVal > 0;

                // Use DisplayTypeId for badge (carries forward protocol even for offline gaps)
                bool isTcp = itemDisplayTypeId == 1;
                bool isMqtt = itemDisplayTypeId == 2;

                string statusText = isOnline ? "Online" : "Offline";
                string statusClass = isOnline ? "status-online" : "status-offline";
                string dotClass = isOnline ? "online" : "offline";
                string timeStr = itemTimeStamp.ToString("dd-MM HH:mm");
                string dataProtocol = isTcp ? "tcp" : (isMqtt ? "mqtt" : "offline");
                string cardClass = isOnline ? "" : "offline-card";
                string timestampAttr = itemTimeStamp.ToString("yyyy-MM-ddTHH:mm:ss");

                // Compute badge class and text
                string badgeClass = "protocol-offline";
                string badgeText = "—";

                if (isTcp)
                {
                    badgeClass = isOnline ? "protocol-tcp" : "protocol-tcp-offline";
                    badgeText = "TCP";
                }
                else if (isMqtt)
                {
                    badgeClass = isOnline ? "protocol-mqtt" : "protocol-mqtt-offline";
                    badgeText = "MQTT";
                }

                <div class="history-card card card-elevated p-2 d-flex flex-row align-items-center gap-2 @cardClass"
                     data-protocol="@dataProtocol"
                     data-timestamp="@timestampAttr">
                    <span class="status-dot @dotClass"></span>
                    <span class="badge protocol-badge @badgeClass">@badgeText</span>
                    <span class="small status-text @statusClass">@statusText</span>
                    @if (isOnline)
                    {
                        <span class="signal-badge"><i class="bi bi-reception-4"></i> @itemSignalStrength dBm</span>}
                    <span class="flex-grow-1 text-end font-mono timestamp">@timeStr</span>
                </div>}
        }
    </div>
</div>

<!-- Graph Modal -->
<div class="modal fade graph-modal" id="modemGraphModal" tabindex="-1" aria-labelledby="modemGraphModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modemGraphModalLabel"><i class="bi bi-graph-up"></i> Modem Signal Strength</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="device-info-box">
                    <div class="device-icon"><i class="bi bi-router"></i></div>
                    <div class="device-details">
                        <div class="device-name">Modem Signal History</div>
                        <div class="device-meta">Cluster ID: <strong id="modemGraphClusterId">@clusterId</strong></div>
                    </div>
                </div>
                <div class="quick-dates">
                    <button type="button" class="btn active" onclick="setModemQuickDate('today', this)">Today</button>
                    <button type="button" class="btn" onclick="setModemQuickDate('yesterday', this)">Yesterday</button>
                    <button type="button" class="btn" onclick="setModemQuickDate('7days', this)">Last 7 Days</button>
                    <button type="button" class="btn" onclick="setModemQuickDate('30days', this)">Last 30 Days</button>
                </div>
                <div class="row mb-3">
                    <div class="col-6">
                        <div class="date-input-group">
                            <label>From</label>
                            <input type="date" id="modemGraphFromDate" class="form-control">
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="date-input-group">
                            <label>To</label>
                            <input type="date" id="modemGraphToDate" class="form-control">
                        </div>
                    </div>
                </div>
                <div class="protocol-checks">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chkModemTcp" checked onchange="if(modemChartInstance) loadModemGraph()">
                        <label class="form-check-label" for="chkModemTcp"><span class="legend-dot tcp"></span> TCP Signal</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="chkModemMqtt" checked onchange="if(modemChartInstance) loadModemGraph()">
                        <label class="form-check-label" for="chkModemMqtt"><span class="legend-dot mqtt"></span> Modem (MQTT)</label>
                    </div>
                </div>
                <button type="button" class="btn btn-load-graph" id="btnLoadModemGraph" onclick="loadModemGraph()">
                    <i class="bi bi-graph-up"></i> Generate Graph
                </button>
                <div class="graph-container" id="modemGraphBox" style="display: none;">
                    <div class="graph-header"><span class="graph-title"><i class="bi bi-activity"></i> Signal Strength Over Time</span></div>
                    <div class="graph-stats-container" id="modemGraphStats"></div>
                    <div class="graph-body">
                        <div class="graph-loader" id="modemGraphLoader"><div class="spinner-border text-primary" role="status"></div><span>Loading graph data...</span></div>
                        <div class="graph-empty" id="modemGraphEmpty" style="display: none;"><i class="bi bi-inbox"></i><span>No data available for selected range</span></div>
                        <canvas id="modemSignalChart" height="280" style="display: none;"></canvas>
                    </div>
                    <div class="graph-legend">
                        <div class="legend-item"><span class="legend-line tcp"></span> TCP Online</div>
                        <div class="legend-item"><span class="legend-line mqtt"></span> Modem Online</div>
                        <div class="legend-item"><span class="legend-line offline"></span> Offline</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .modem-history-panel .history-filters {
        background: var(--card-elevated-bg);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 0.75rem;
    }

        .modem-history-panel .history-filters .form-label {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .modem-history-panel .history-filters .form-control, .modem-history-panel .history-filters .form-select {
            font-size: 0.8rem;
        }

    .modem-history-panel .section-title {
        font-size: 0.65rem;
        text-transform: uppercase;
        color: var(--muted-color);
        letter-spacing: 0.05em;
    }

    .modem-history-panel .history-list-scroll {
        max-height: 350px;
        overflow-y: auto;
        padding-right: 0.25rem;
    }

        .modem-history-panel .history-list-scroll::-webkit-scrollbar {
            width: 6px;
        }

        .modem-history-panel .history-list-scroll::-webkit-scrollbar-track {
            background: var(--border-light);
            border-radius: 3px;
        }

        .modem-history-panel .history-list-scroll::-webkit-scrollbar-thumb {
            background: var(--muted-color);
            border-radius: 3px;
        }

    .modem-history-panel .no-history-msg {
        color: var(--muted-color);
    }

    .modem-history-panel .history-card {
        background: var(--card-elevated-bg) !important;
        border: 1px solid var(--border-light) !important;
        transition: all 0.15s ease;
    }

        .modem-history-panel .history-card:hover {
            background: var(--hover-bg) !important;
            border-color: var(--border-color) !important;
            transform: translateX(2px);
        }

    .modem-history-panel .protocol-badge {
        font-size: 0.55rem;
        font-weight: 600;
        padding: 0.25em 0.5em;
        border-radius: 4px;
        min-width: 32px;
        text-align: center;
    }

        /* TCP Online - Blue solid */
        .modem-history-panel .protocol-badge.protocol-tcp {
            background-color: rgba(59, 130, 246, 0.15) !important;
            color: #3b82f6 !important;
        }
        /* TCP Offline - Blue with dashed border */
        .modem-history-panel .protocol-badge.protocol-tcp-offline {
            background-color: rgba(59, 130, 246, 0.08) !important;
            color: #3b82f6 !important;
            border: 1px dashed rgba(59, 130, 246, 0.5) !important;
        }

        /* MQTT Online - Green solid */
        .modem-history-panel .protocol-badge.protocol-mqtt {
            background-color: rgba(34, 197, 94, 0.15) !important;
            color: #22c55e !important;
        }
        /* MQTT Offline - Green with dashed border */
        .modem-history-panel .protocol-badge.protocol-mqtt-offline {
            background-color: rgba(34, 197, 94, 0.08) !important;
            color: #22c55e !important;
            border: 1px dashed rgba(34, 197, 94, 0.5) !important;
        }

        /* Unknown protocol fallback */
        .modem-history-panel .protocol-badge.protocol-offline {
            background-color: rgba(107, 114, 128, 0.15) !important;
            color: #6b7280 !important;
        }

    .modem-history-panel .status-text.status-online {
        color: #22c55e;
        font-weight: 500;
    }

    .modem-history-panel .status-text.status-offline {
        color: #ef4444;
        font-weight: 500;
    }

    .modem-history-panel .signal-badge {
        font-size: 0.6rem;
        color: var(--muted-color);
        background: var(--card-elevated-bg);
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        border: 1px solid var(--border-light);
    }

    .modem-history-panel .timestamp {
        font-size: 0.6rem;
        color: var(--muted-color);
    }

    .modem-history-panel .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        flex-shrink: 0;
    }

        .modem-history-panel .status-dot.online {
            background: #22c55e;
            box-shadow: 0 0 6px #22c55e;
        }

        .modem-history-panel .status-dot.offline {
            background: #ef4444;
        }

    .modem-history-panel .history-card.offline-card {
        background: rgba(239, 68, 68, 0.05) !important;
        border-color: rgba(239, 68, 68, 0.2) !important;
    }

        .modem-history-panel .history-card.offline-card:hover {
            background: rgba(239, 68, 68, 0.1) !important;
            border-color: rgba(239, 68, 68, 0.3) !important;
        }

    [data-theme="dark"] .modem-history-panel .history-card.offline-card {
        background: rgba(239, 68, 68, 0.1) !important;
        border-color: rgba(239, 68, 68, 0.25) !important;
    }

    .modem-history-panel .no-filter-results {
        color: var(--muted-color);
        background: var(--card-elevated-bg);
        border: 1px dashed var(--border-light);
        border-radius: 8px;
        margin-top: 0.5rem;
    }

    .btn-graph-unified {
        background: linear-gradient(135deg, #8b5cf6 0%, #6366f1 100%);
        border: none;
        color: #fff;
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.4rem 0.85rem;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        box-shadow: 0 2px 8px rgba(139, 92, 246, 0.3);
        transition: all 0.2s ease;
    }

        .btn-graph-unified:hover {
            background: linear-gradient(135deg, #7c3aed 0%, #4f46e5 100%);
            color: #fff;
            transform: translateY(-1px);
        }

    .graph-modal .modal-content {
        background: var(--modal-bg) !important;
        border: 1px solid var(--border-color) !important;
        border-radius: 16px;
        overflow: hidden;
    }

    .graph-modal .modal-header {
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        color: #fff !important;
        border-bottom: none;
        padding: 1.25rem 1.5rem;
    }

        .graph-modal .modal-header .modal-title {
