            color: #fff !important;
        }

        .graph-modal .modal-header .btn-close {
            filter: brightness(0) invert(1) !important;
            opacity: 0.8;
        }

    .graph-modal .modal-body {
        padding: 1.5rem;
        background: var(--modal-bg);
    }

    .graph-modal .device-info-box {
        background: var(--card-elevated-bg);
        border: 1px solid var(--border-light);
        border-radius: 12px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

        .graph-modal .device-info-box .device-icon {
            width: 48px;
            height: 48px;
            background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.25rem;
        }

        .graph-modal .device-info-box .device-name {
            font-weight: 600;
            color: var(--body-color);
            font-size: 1rem;
        }

        .graph-modal .device-info-box .device-meta {
            font-size: 0.75rem;
            color: var(--muted-color);
        }

    .graph-modal .quick-dates {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

        .graph-modal .quick-dates .btn {
            font-size: 0.7rem;
            font-weight: 500;
            padding: 0.35rem 0.75rem;
            border-radius: 6px;
            background: var(--card-elevated-bg);
            border: 1px solid var(--border-light);
            color: var(--body-color);
        }

            .graph-modal .quick-dates .btn.active {
                background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
                border-color: transparent;
                color: #fff;
            }

    .graph-modal .date-input-group {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .graph-modal .date-input-group label {
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--muted-color);
            min-width: 50px;
        }

        .graph-modal .date-input-group input[type="date"] {
            flex: 1;
            font-size: 0.8rem;
            padding: 0.5rem 0.75rem;
            border-radius: 8px;
            background: var(--input-bg) !important;
            border: 1px solid var(--input-border) !important;
            color: var(--input-color) !important;
        }

    .graph-modal .protocol-checks {
        display: flex;
        gap: 1.5rem;
        margin-bottom: 1rem;
        padding: 0.75rem 1rem;
        background: var(--card-elevated-bg);
        border-radius: 8px;
        border: 1px solid var(--border-light);
    }

        .graph-modal .protocol-checks .form-check {
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .graph-modal .protocol-checks .legend-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
        }

            .graph-modal .protocol-checks .legend-dot.tcp {
                background: #3b82f6;
            }

            .graph-modal .protocol-checks .legend-dot.mqtt {
                background: #22c55e;
            }

    .graph-modal .btn-load-graph {
        width: 100%;
        padding: 0.75rem;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 10px;
        background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
        border: none;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
    }

    .graph-modal .graph-container {
        background: var(--card-elevated-bg);
        border: 1px solid var(--border-light);
        border-radius: 12px;
        overflow: hidden;
    }

    .graph-modal .graph-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 1.15rem;
        background: linear-gradient(135deg, rgba(249, 115, 22, 0.1) 0%, rgba(234, 88, 12, 0.1) 100%);
        border-bottom: 1px solid var(--border-light);
    }

        .graph-modal .graph-header .graph-title {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--body-color);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

            .graph-modal .graph-header .graph-title i {
                color: #f97316;
            }

    .graph-modal .graph-stats-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 0.85rem 1.15rem;
        background: var(--card-bg, #f8fafc);
        border-bottom: 1px solid var(--border-light);
    }

    .graph-modal .stat-group {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.5rem 0.85rem;
        background: var(--card-elevated-bg);
        border-radius: 8px;
        border: 1px solid var(--border-light);
        flex: 1;
        min-width: 180px;
    }

        .graph-modal .stat-group .stat-icon {
            width: 32px;
            height: 32px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .graph-modal .stat-group.tcp .stat-icon {
            background: rgba(59, 130, 246, 0.15);
            color: #3b82f6;
        }

        .graph-modal .stat-group.mqtt .stat-icon {
            background: rgba(34, 197, 94, 0.15);
            color: #22c55e;
        }

        .graph-modal .stat-group .stat-label {
            font-size: 0.7rem;
            font-weight: 600;
            color: var(--muted-color);
            text-transform: uppercase;
        }

        .graph-modal .stat-group .stat-value {
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--body-color);
        }

        .graph-modal .stat-group .stat-uptime {
            padding: 0.2rem 0.5rem;
            border-radius: 6px;
            font-size: 0.7rem;
            font-weight: 600;
        }

            .graph-modal .stat-group .stat-uptime.good {
                background: rgba(34, 197, 94, 0.15);
                color: #16a34a;
            }

            .graph-modal .stat-group .stat-uptime.warning {
                background: rgba(245, 158, 11, 0.15);
                color: #d97706;
            }

            .graph-modal .stat-group .stat-uptime.poor {
                background: rgba(239, 68, 68, 0.15);
                color: #dc2626;
            }

    .graph-modal .graph-legend {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        padding: 0.75rem;
        background: var(--card-bg, #f8fafc);
        border-top: 1px solid var(--border-light);
    }

    .graph-modal .legend-item {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.75rem;
        color: var(--muted-color);
    }

    .graph-modal .legend-line {
        width: 20px;
        height: 3px;
        border-radius: 2px;
    }

        .graph-modal .legend-line.tcp {
            background: #3b82f6;
        }

        .graph-modal .legend-line.mqtt {
            background: #22c55e;
        }

        .graph-modal .legend-line.offline {
            background: #ef4444;
        }

    .graph-modal .graph-body {
        padding: 1.25rem;
        min-height: 320px;
        position: relative;
    }

    .graph-modal .graph-loader, .graph-modal .graph-empty {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.75rem;
        color: var(--muted-color);
    }

        .graph-modal .graph-empty i {
            font-size: 2.5rem;
            opacity: 0.4;
        }
</style>

<script>
    var currentModemClusterId = @clusterId;
    var modemChartInstance = null;
    var modemTcpData = [];
    var modemMqttData = [];

    // ============================================================
    // Initialize date change listeners when DOM is ready
    // ============================================================
    (function() {
        // Wait for DOM to be ready
        function initDateListeners() {
            var fromDateEl = document.getElementById('modemHistoryFromDate');
            var toDateEl = document.getElementById('modemHistoryToDate');

            if (fromDateEl) {
                fromDateEl.addEventListener('change', function() {
                    console.log('[History] From date changed to:', this.value);
                    reloadModemHistory();
                });
            }

            if (toDateEl) {
                toDateEl.addEventListener('change', function() {
                    console.log('[History] To date changed to:', this.value);
                    reloadModemHistory();
                });
            }

            console.log('[History] Date listeners initialized');
        }

        // Try to init immediately, or wait for DOM
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initDateListeners);
        } else {
            // Small delay to ensure elements exist
            setTimeout(initDateListeners, 100);
        }
    })();

    // ============================================================
    // FILTER - Client side
    // ============================================================
    function filterHistoryByProtocol() {
        var filterElement = document.getElementById('modemHistoryProtocolFilter');
        if (!filterElement) return;

        var filterValue = filterElement.value.toLowerCase();
        console.log('[Filter] Filtering by:', filterValue);

        var container = document.getElementById('modemHistoryListBS');
        if (!container) return;

        var cards = container.querySelectorAll('.history-card');
        var visibleCount = 0;
        var totalCount = cards.length;

        for (var i = 0; i < cards.length; i++) {
            var card = cards[i];
            var protocol = (card.getAttribute('data-protocol') || '').toLowerCase();
            var shouldShow = (filterValue === 'all' || filterValue === protocol);

            if (shouldShow) {
                card.classList.add('d-flex');
                card.classList.remove('d-none');
                card.style.display = '';
                visibleCount++;
            } else {
                card.classList.remove('d-flex');
                card.classList.add('d-none');
                card.style.display = 'none';
            }
        }

        console.log('[Filter] Visible:', visibleCount, '/', totalCount);

        var visibleCountEl = document.getElementById('visibleHistoryCount');
        if (visibleCountEl) visibleCountEl.textContent = visibleCount;

        var filterInfo = document.getElementById('filterInfo');
        if (filterInfo) filterInfo.textContent = (filterValue !== 'all') ? '(Filtered: ' + filterValue.toUpperCase() + ')' : '';

        var existingMsg = container.querySelector('.no-filter-results');
        if (existingMsg) existingMsg.remove();

        if (visibleCount === 0 && totalCount > 0) {
            var noResultsDiv = document.createElement('div');
            noResultsDiv.className = 'no-filter-results small text-center py-3';
            noResultsDiv.innerHTML = '<i class="bi bi-funnel opacity-50 d-block mb-2" style="font-size: 1.5rem;"></i><span>No ' + filterValue.toUpperCase() + ' records found</span>';
            container.appendChild(noResultsDiv);
        }
    }

    // ============================================================
    // RELOAD HISTORY - Server side (hits API)
    // ============================================================
    function reloadModemHistory() {
        var fromDateEl = document.getElementById('modemHistoryFromDate');
        var toDateEl = document.getElementById('modemHistoryToDate');

        if (!fromDateEl || !toDateEl) {
            console.error('[History] Date inputs not found');
            return;
        }

        var fromDate = fromDateEl.value;
        var toDate = toDateEl.value;

        if (!fromDate || !toDate) {
            console.log('[History] Missing date value, skipping reload');
            return;
        }

        // Get cluster ID from multiple sources
        var clusterId = currentModemClusterId;

        if (!clusterId || clusterId === 0) {
            var panel = document.querySelector('.modem-history-panel');
            if (panel) {
                clusterId = parseInt(panel.getAttribute('data-cluster-id')) || 0;
            }
        }

        if (!clusterId || clusterId === 0) {
            if (typeof currentModem !== 'undefined' && currentModem && currentModem.clusterId) {
                clusterId = currentModem.clusterId;
            }
        }

        if (!clusterId || clusterId === 0) {
            console.error('[History] No cluster ID available!');
            alert('Error: No modem selected.');
            return;
        }

        // Format dates for API (DD-MM-YYYY)
        var fromFormatted = formatDateForApi(fromDate);
        var toFormatted = formatDateForApi(toDate);

        console.log('[History] *** CALLING API ***');
        console.log('[History] ClusterId:', clusterId);
        console.log('[History] From:', fromDate, '->', fromFormatted);
        console.log('[History] To:', toDate, '->', toFormatted);

        // Show loading state
        var listContainer = document.getElementById('modemHistoryListBS');
        if (listContainer) {
            listContainer.innerHTML = '<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div><div class="small text-muted mt-2">Loading history...</div></div>';
        }

        // Reset protocol filter
        var protocolFilter = document.getElementById('modemHistoryProtocolFilter');
        if (protocolFilter) protocolFilter.value = 'all';

        var filterInfo = document.getElementById('filterInfo');
        if (filterInfo) filterInfo.textContent = '';

        // Make AJAX call to server
        $.ajax({
            url: '/NetworkDashboard/ModemHistory',
            type: 'GET',
            data: {
                clusterId: clusterId,
                fromDate: fromFormatted,
                toDate: toFormatted
            },
            success: function(html) {
                console.log('[History] API call successful!');

                // Parse the response to extract just the list content
                var temp = document.createElement('div');
                temp.innerHTML = html;

                // Update the list container
                var newList = temp.querySelector('#modemHistoryListBS');
                var oldList = document.getElementById('modemHistoryListBS');

                if (newList && oldList) {
                    oldList.innerHTML = newList.innerHTML;
                    console.log('[History] List updated');
                } else {
                    // Fallback: update entire panel
                    var container = document.getElementById('modemHistoryContainer');
                    if (container) {
                        container.innerHTML = html;
                    }
                }

                // Update record counts
                var newVisibleCount = temp.querySelector('#visibleHistoryCount');
                var newTotalCount = temp.querySelector('#totalHistoryCount');

                if (newVisibleCount) {
                    var vc = document.getElementById('visibleHistoryCount');
                    if (vc) vc.textContent = newVisibleCount.textContent;
                }
                if (newTotalCount) {
                    var tc = document.getElementById('totalHistoryCount');
                    if (tc) tc.textContent = newTotalCount.textContent;
                }

                // IMPORTANT: Keep the dates as user selected (don't let server override)
                setTimeout(function() {
                    var fromEl = document.getElementById('modemHistoryFromDate');
                    var toEl = document.getElementById('modemHistoryToDate');
                    if (fromEl && fromEl.value !== fromDate) {
                        fromEl.value = fromDate;
                        console.log('[History] Restored fromDate:', fromDate);
                    }
                    if (toEl && toEl.value !== toDate) {
                        toEl.value = toDate;
                        console.log('[History] Restored toDate:', toDate);
                    }
                }, 50);
            },
            error: function(xhr, status, error) {
                console.error('[History] API Error:', status, error);
                console.error('[History] Response:', xhr.responseText);

                var listContainer = document.getElementById('modemHistoryListBS');
                if (listContainer) {
                    listContainer.innerHTML = '<div class="text-danger small text-center py-3"><i class="bi bi-exclamation-circle me-1"></i>Error loading history: ' + error + '</div>';
                }
            }
        });
    }

    // Helper: Format date from YYYY-MM-DD to DD-MM-YYYY
    function formatDateForApi(dateStr) {
        if (!dateStr) return '';
        var parts = dateStr.split('-');
        if (parts.length === 3) {
            return parts[2] + '-' + parts[1] + '-' + parts[0];
        }
        return dateStr;
    }

    // ============================================================
    // GRAPH FUNCTIONS
    // ============================================================
    function formatModemDateApi(dateStr) {
        var d = new Date(dateStr);
        return String(d.getDate()).padStart(2, '0') + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + d.getFullYear();
    }

    function getModemToday() { return new Date().toISOString().split('T')[0]; }

    function setModemQuickDate(range, btn) {
        var buttons = document.querySelectorAll('#modemGraphModal .quick-dates .btn');
        buttons.forEach(function(b) { b.classList.remove('active'); });
        btn.classList.add('active');
        var today = new Date(); var from = new Date();
        if (range === 'today') { from = today; }
        else if (range === 'yesterday') { from.setDate(today.getDate() - 1); today = new Date(from); }
        else if (range === '7days') { from.setDate(today.getDate() - 7); }
        else if (range === '30days') { from.setDate(today.getDate() - 30); }
        document.getElementById('modemGraphFromDate').value = from.toISOString().split('T')[0];
        document.getElementById('modemGraphToDate').value = today.toISOString().split('T')[0];
    }

    function openModemGraphModal(clusterId) {
        if (clusterId) currentModemClusterId = clusterId;
        document.getElementById('modemGraphClusterId').textContent = currentModemClusterId;
        var today = getModemToday();
        document.getElementById('modemGraphFromDate').value = today;
        document.getElementById('modemGraphToDate').value = today;
        document.getElementById('chkModemTcp').checked = true;
        document.getElementById('chkModemMqtt').checked = true;
        document.getElementById('modemGraphBox').style.display = 'none';
        var buttons = document.querySelectorAll('#modemGraphModal .quick-dates .btn');
        buttons.forEach(function(b, i) { b.classList.toggle('active', i === 0); });
        new bootstrap.Modal(document.getElementById('modemGraphModal')).show();
    }

    function loadModemGraph() {
        var fromDate = document.getElementById('modemGraphFromDate').value;
        var toDate = document.getElementById('modemGraphToDate').value;
        if (!fromDate || !toDate) { alert('Please select date range'); return; }
        var url = '/NetworkDashboard/GetModemHistoryForGraph?clusterId=' + currentModemClusterId + '&fromDate=' + formatModemDateApi(fromDate) + '&toDate=' + formatModemDateApi(toDate);
        document.getElementById('modemGraphBox').style.display = 'block';
        document.getElementById('modemGraphLoader').style.display = 'flex';
        document.getElementById('modemGraphEmpty').style.display = 'none';
        document.getElementById('modemSignalChart').style.display = 'none';
        document.getElementById('modemGraphStats').innerHTML = '';
        document.getElementById('btnLoadModemGraph').disabled = true;
        fetch(url).then(function(res) { return res.json(); }).then(function(data) {
            document.getElementById('modemGraphLoader').style.display = 'none';
            document.getElementById('btnLoadModemGraph').disabled = false;
            if (!data || data.length === 0 || data.Success === false) { document.getElementById('modemGraphEmpty').style.display = 'flex'; return; }
            document.getElementById('modemSignalChart').style.display = 'block';
            renderModemSignalChart(data, fromDate, toDate);
        }).catch(function(err) {
            console.error('Modem graph error:', err);
            document.getElementById('modemGraphLoader').style.display = 'none';
            document.getElementById('modemGraphEmpty').style.display = 'flex';
            document.getElementById('btnLoadModemGraph').disabled = false;
        });
    }

    function fillTimeGaps(dataArray, fromDate, toDate, gapThresholdMinutes) {
        if (dataArray.length === 0) return [];
        gapThresholdMinutes = gapThresholdMinutes || 5;
        var gapThresholdMs = gapThresholdMinutes * 60 * 1000;
        dataArray.sort(function(a, b) { return a.x - b.x; });
        var filledData = [];
        var startTime = new Date(fromDate + 'T00:00:00').getTime();
        var endTime = new Date(toDate + 'T23:59:59').getTime();
        var now = new Date().getTime();
        var effectiveEnd = Math.min(endTime, now);
        if (dataArray[0].x.getTime() > startTime + gapThresholdMs) {
            filledData.push({ x: new Date(startTime), y: 0, status: 'offline' });
            filledData.push({ x: new Date(dataArray[0].x.getTime() - 1000), y: 0, status: 'offline' });
        }
        for (var i = 0; i < dataArray.length; i++) {
            var current = dataArray[i];
            if (i > 0) {
                var prev = dataArray[i - 1];
                var gap = current.x.getTime() - prev.x.getTime();
                if (gap > gapThresholdMs) {
                    filledData.push({ x: new Date(prev.x.getTime() + 1000), y: 0, status: 'offline' });
                    filledData.push({ x: new Date(current.x.getTime() - 1000), y: 0, status: 'offline' });
                }
            }
            filledData.push({ x: current.x, y: current.y, status: 'online' });
        }
        var lastPoint = dataArray[dataArray.length - 1];
        if (lastPoint.x.getTime() < effectiveEnd - gapThresholdMs) {
            filledData.push({ x: new Date(lastPoint.x.getTime() + 1000), y: 0, status: 'offline' });
            filledData.push({ x: new Date(effectiveEnd), y: 0, status: 'offline' });
        }
        return filledData;
    }

    function calculateOnlineStats(filledData, fromDate, toDate) {
        if (filledData.length === 0) return { onlinePercent: 0, avgSignal: 0, dataPoints: 0 };
        var onlinePoints = filledData.filter(function(p) { return p.status === 'online'; });
        var totalSignal = onlinePoints.reduce(function(sum, p) { return sum + p.y; }, 0);
        var avgSignal = onlinePoints.length > 0 ? Math.round(totalSignal / onlinePoints.length) : 0;
        var totalOnlineTime = 0; var lastOnlineStart = null;
        filledData.forEach(function(point) {
            if (point.status === 'online' && lastOnlineStart === null) { lastOnlineStart = point.x.getTime(); }
            else if (point.status === 'offline' && lastOnlineStart !== null) { totalOnlineTime += point.x.getTime() - lastOnlineStart; lastOnlineStart = null; }
        });
        if (lastOnlineStart !== null) { totalOnlineTime += filledData[filledData.length - 1].x.getTime() - lastOnlineStart; }
        var startTime = new Date(fromDate + 'T00:00:00').getTime();
        var endTime = Math.min(new Date(toDate + 'T23:59:59').getTime(), new Date().getTime());
        var totalTime = endTime - startTime;
        var onlinePercent = totalTime > 0 ? Math.round((totalOnlineTime / totalTime) * 100) : 0;
        return { onlinePercent: Math.min(onlinePercent, 100), avgSignal: avgSignal, dataPoints: onlinePoints.length };
    }

    function renderModemSignalChart(data, fromDate, toDate) {
        var showTcp = document.getElementById('chkModemTcp').checked;
        var showMqtt = document.getElementById('chkModemMqtt').checked;
        var tcpRawData = [], mqttRawData = [];
        data.forEach(function(item) {
            var ts = item.TimeStamp || item.Timestamp || item.timeStamp;
            var typeId = item.TypeId || item.typeId;
            var signal = parseInt(item.SignalStrength) || 0;
            if (signal <= 0) return;
            var dt = new Date(ts);
            if (typeId === 1) tcpRawData.push({ x: dt, y: signal });
            else if (typeId === 2) mqttRawData.push({ x: dt, y: signal });
        });
        modemTcpData = fillTimeGaps(tcpRawData, fromDate, toDate, 5);
        modemMqttData = fillTimeGaps(mqttRawData, fromDate, toDate, 5);
        var tcpStats = calculateOnlineStats(modemTcpData, fromDate, toDate);
        var mqttStats = calculateOnlineStats(modemMqttData, fromDate, toDate);
        var statsHtml = '';
        if (showTcp) {
            var tcpClass = tcpStats.onlinePercent >= 80 ? 'good' : (tcpStats.onlinePercent >= 50 ? 'warning' : 'poor');
            statsHtml += '<div class="stat-group tcp"><div class="stat-icon"><i class="bi bi-hdd-network"></i></div><div class="stat-info"><div class="stat-label">TCP Signal</div><div class="stat-value">' + tcpStats.avgSignal + ' dBm avg</div></div><span class="stat-uptime ' + tcpClass + '">' + tcpStats.onlinePercent + '% online</span></div>';
        }
        if (showMqtt) {
            var mqttClass = mqttStats.onlinePercent >= 80 ? 'good' : (mqttStats.onlinePercent >= 50 ? 'warning' : 'poor');
            statsHtml += '<div class="stat-group mqtt"><div class="stat-icon"><i class="bi bi-router"></i></div><div class="stat-info"><div class="stat-label">Modem (MQTT)</div><div class="stat-value">' + mqttStats.avgSignal + ' dBm avg</div></div><span class="stat-uptime ' + mqttClass + '">' + mqttStats.onlinePercent + '% online</span></div>';
        }
        document.getElementById('modemGraphStats').innerHTML = statsHtml;
        var hasTcpData = showTcp && modemTcpData.length > 0;
        var hasMqttData = showMqtt && modemMqttData.length > 0;
        if (!hasTcpData && !hasMqttData) { document.getElementById('modemSignalChart').style.display = 'none'; document.getElementById('modemGraphEmpty').style.display = 'flex'; return; }
        if (modemChartInstance) modemChartInstance.destroy();
        var datasets = [];
        if (hasTcpData) {
            datasets.push({ label: 'TCP Signal', data: modemTcpData.map(function(p) { return { x: p.x, y: p.y }; }), borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.1)', borderWidth: 2, fill: true, tension: 0, pointRadius: 1, pointHoverRadius: 6, segment: { borderColor: function(ctx) { return (ctx.p0.parsed.y === 0 || ctx.p1.parsed.y === 0) ? '#ef4444' : '#3b82f6'; }, backgroundColor: function(ctx) { return (ctx.p0.parsed.y === 0 || ctx.p1.parsed.y === 0) ? 'rgba(239,68,68,0.1)' : 'rgba(59,130,246,0.1)'; } } });
        }
        if (hasMqttData) {
            datasets.push({ label: 'Modem Signal (MQTT)', data: modemMqttData.map(function(p) { return { x: p.x, y: p.y }; }), borderColor: '#22c55e', backgroundColor: 'rgba(34,197,94,0.1)', borderWidth: 2, fill: true, tension: 0, pointRadius: 1, pointHoverRadius: 6, segment: { borderColor: function(ctx) { return (ctx.p0.parsed.y === 0 || ctx.p1.parsed.y === 0) ? '#ef4444' : '#22c55e'; }, backgroundColor: function(ctx) { return (ctx.p0.parsed.y === 0 || ctx.p1.parsed.y === 0) ? 'rgba(239,68,68,0.1)' : 'rgba(34,197,94,0.1)'; } } });
        }
        var dashboard = document.getElementById('networkDashboard');
        var isDark = dashboard && dashboard.getAttribute('data-theme') === 'dark';
        var gridColor = isDark ? 'rgba(255,255,255,0.1)' : 'rgba(0,0,0,0.1)';
        var textColor = isDark ? '#94a3b8' : '#64748b';
        var ctx = document.getElementById('modemSignalChart').getContext('2d');
        modemChartInstance = new Chart(ctx, {
            type: 'line', data: { datasets: datasets },
            options: {
                responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },
                plugins: { legend: { display: false }, tooltip: { callbacks: { title: function(ctx) { return new Date(ctx[0].parsed.x).toLocaleString(); }, label: function(ctx) { var v = ctx.parsed.y; return ctx.dataset.label + ': ' + (v === 0 ? 'OFFLINE' : v + ' dBm (Online)'); } } } },
                scales: {
                    x: { type: 'time', time: { unit: 'minute', displayFormats: { minute: 'HH:mm', hour: 'HH:mm', day: 'dd MMM' } }, title: { display: true, text: 'Time', color: textColor }, grid: { color: gridColor }, ticks: { color: textColor, maxRotation: 45 } },
                    y: { type: 'linear', title: { display: true, text: 'Signal (dBm)', color: textColor }, grid: { color: gridColor }, ticks: { color: textColor, callback: function(v) { return v === 0 ? 'Offline' : v + ' dBm'; } }, min: 0, suggestedMax: 35 }
                }
            }
        });
    }
</script>
