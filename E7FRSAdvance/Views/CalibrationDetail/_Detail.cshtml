@model List<Domain.CalibrationDetail>

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-show-detail" tabindex="-1" aria-labelledby="modal-show-detail" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">

                <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Show Calibration Detail</span></h4>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true">×</button>

            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <table class="table">
                                <tr>
                                    <th>Multiplication</th>
                                    <th>User Name</th>
                                    <th>Created Date</th>
                                </tr>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.Multiplication</td>
                                        <td>@item.UserName</td>
                                        <td>@item.CreatedDate.ToString()</td>
                                    </tr>
                                }

                            </table>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
            </div>
        </div>
    </div>
</div>

