    function fnShowDetail(assetId, assetAttributeId) {
        $("#loader").show();
        $.ajax({
            url: '/CalibrationDetail/_Detail',
            type: 'Post',
            data: '{assetId:' + assetId + ',assetAttributeId:' + assetAttributeId + ',date:"' + $("#searchFromDate").val() +'"}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divDetail").empty().append(data);
                $("#modal-show-detail").modal("show");

            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }
