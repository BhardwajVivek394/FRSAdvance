@model Domain.UserClass

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-userClass" tabindex="-1" role="dialog" aria-labelledby="modal-add-userClass" data-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            @Html.HiddenFor(m => Model.Id, new { @id = "hdnUserClassId" })
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add User class</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Edit User class</span></h4>
                }
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">

                            <div class="">
                                <label class="control-label">Name <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.ClassName, new { @class = "form-control", tabindex = 1 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="">
                                <label class="control-label">Delay In Minutes <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.DelayInMinutes, new { @class = "form-control", tabindex = 2 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <div class="">
                                <label class="control-label">Description <span class="text-danger"></span></label>
                                <div class="">
                                    @Html.TextAreaFor(m => Model.Description, new { @class = "form-control", tabindex = 3 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/PageJS/UserClass/AddUserClass.js"></script>