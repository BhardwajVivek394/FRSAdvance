@model Domain.UserClassLister

@{
    ViewBag.Title = "User Class";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">User class</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">

        @using (Ajax.BeginForm("UserClassList", "UserClass", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divUserClassList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "UserClassRefreshed"
        }, new { id = "frmGetUserClassList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divUserClassList">
                @Html.Action("UserClassList")
            </div>
        }

        @using (Ajax.BeginForm("SaveUserClass", "UserClass", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveUserClass",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "UserClassSaved"
        }, new { id = "frmSaveUserClass" }))
        {
            <div id="divSaveUserClass">
                @Html.Partial("_AddUserClassPartial", new Domain.UserClass())
            </div>
        }
    </div>
</div>
<script src="~/Content/PageJS/UserClass/UserClassIndex.js"></script>