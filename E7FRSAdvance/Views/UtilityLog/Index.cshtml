@model List<Domain.UtilityLog>

@{
    ViewBag.Title = "Utility Log";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .collapsed .icon-class:before {
        content: '>';
    }

    .icon-class:before {
        content: 'v';
    }
    .table > :not(:last-child) > :last-child > * {
        border-bottom-color: #87c7d9 !important;
    }
    .MainTh {
        background-color: #7fcde22e !important;
        border-bottom-color: #87c9db !important;
    }
    .SubTh {
        background-color: #f4f6fc !important;
        border-bottom-color: #87c9db !important;
    }
</style>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">UtilityLog</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs border-tab nav-primary" id="info-tab" role="tablist">
                    <li class="nav-item" onclick="fnAlert()">
                        <a class="nav-link active" id="Alert-tab" data-bs-toggle="tab" href="#Alert" role="tab" aria-controls="Alert" aria-selected="true" data-bs-original-title="" title="">
                            <i class="fa fa-home"></i>Alert
                        </a>
                    </li>
                    <li class="nav-item" onclick="fnPLCLog()">
                        <a class="nav-link" id="SaveJson-tab" data-bs-toggle="tab" href="#PLCLog" role="tab" aria-controls="PLCLog" aria-selected="false" data-bs-original-title="" title="">
                            <i class="fa fa-gear"></i>PLC Log
                        </a>
                    </li>
                    <li class="nav-item" onclick="fnPointMachine()">
                        <a class="nav-link" id="SaveJson-tab" data-bs-toggle="tab" href="#PointMachine" role="tab" aria-controls="PointMachine" aria-selected="false" data-bs-original-title="" title="">
                            <i class="fa fa-gear"></i>Point Machine
                        </a>
                    </li>
                    <li class="nav-item" onclick="fnSavjson()">
                        <a class="nav-link" id="SaveJson-tab" data-bs-toggle="tab" href="#SaveJson" role="tab" aria-controls="SaveJson" aria-selected="false" data-bs-original-title="" title="">
                            <i class="fa fa-gear"></i>Save Json
                        </a>
                    </li>
                    <li class="nav-item" onclick="fnOther()">
                        <a class="nav-link" id="Other-tab" data-bs-toggle="tab" href="#Other" role="tab" aria-controls="SignalConfig" aria-selected="false" data-bs-original-title="" title="">
                            <i class="fa fa-signal"></i>Other
                        </a>
                    </li>

                </ul>
                <!-- Tab panes -->
                <div class="tab-content">

                    <div class="tab-pane fade active show" id="Alert" role="tabpanel" aria-labelledby="Alert-tab">
                        @using (Ajax.BeginForm("_UtilityAlert", "UtilityLog", new AjaxOptions() { UpdateTargetId = "divAlert", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmAlert", enctype = "multipart/form-data" }))
                        {
                            <input type="hidden" value="FRSAlert" name="utilityType" />
                            <div id="divAlert">
                                @Html.Action("_UtilityAlert", new { utilityType = "FRSAlert" })
                            </div>
                        }
                    </div>
                    <div class="tab-pane fade" role="tabpanel" aria-labelledby="PLCLog-tab" id="PLCLog">
                        @using (Ajax.BeginForm("_PLCLog", "UtilityLog", new AjaxOptions() { UpdateTargetId = "divPLCLog", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmPLCLog", enctype = "multipart/form-data" }))
                        {
                            <input type="hidden" value="PLCLog" name="utilityType" />
                            <div id="divPLCLog">
                                @Html.Action("_PLCLog", new { utilityType = "PLCLog" })
                            </div>
                        }
                    </div>

                    <div class="tab-pane fade" role="tabpanel" aria-labelledby="PointMachine-tab" id="PointMachine">
                        @using (Ajax.BeginForm("_PointMachine", "UtilityLog", new AjaxOptions() { UpdateTargetId = "divPointMachine", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmPointMachine", enctype = "multipart/form-data" }))
                        {
                            <input type="hidden" value="PointMachine" name="utilityType" />
                            <div id="divPointMachine">
                                @Html.Action("_PointMachine", new { utilityType = "PointMachine" })
                            </div>
                        }
                    </div>

                    <div class="tab-pane fade" role="tabpanel" aria-labelledby="SaveJson-tab" id="SaveJson">
                        @using (Ajax.BeginForm("_UtilitySaveJson", "UtilityLog", new AjaxOptions() { UpdateTargetId = "divSaveJson", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmSaveJson", enctype = "multipart/form-data" }))
                        {
                            <input type="hidden" value="SaveJson" name="utilityType" />
                            <div id="divSaveJson">

                            </div>
                        }
                    </div>
                    <div class="tab-pane fade" role="tabpanel" aria-labelledby="Other-tab" id="Other">
                        @using (Ajax.BeginForm("_UtilityOther", "UtilityLog", new AjaxOptions() { UpdateTargetId = "divOther", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmOther", enctype = "multipart/form-data" }))
                        {
                            <input type="hidden" value="Other" name="utilityType" />
                            <div id="divOther">

                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>

    </div>


</div>
<script>
    function fnAlert() {
        $("#frmAlert").submit();
    }
    function fnSavjson() {
        $("#frmSaveJson").submit();
    }
    function fnOther() {
        $("#frmOther").submit();
    }
    function fnPLCLog() {
        $("#frmPLCLog").submit();
    }
    function fnPointMachine() {
        $("#frmPointMachine").submit();
    }


    function GetPLCDivisionByZone() {
        var zoneId = $('#plcZone').val();
        $(".plcTblZone").show();
        $(".plcTblDivision").show();
        $(".plcArrowIcon").removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
        $("#plcDivisions").empty();
        $("#plcDivisions").append($("<option></option>").val('').html('Select Divison'));
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/Site/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $(".plcTblZone").hide();
                    $("#plcTblZone_" + zoneId).show();   
                   
                    $.each(data, function (key, value) {
                        $("#plcDivisions").append($("<option></option>").val(value.Id).html(value.Name));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function GetPLCDivision() {
        var zoneId = $('#plcZone').val();
        $(".plcTblZone").show();
        $(".plcTblDivision").show();
        $(".plcArrowIcon").removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
        var divisionId = $('#plcDivisions').val();
        if (zoneId != null && zoneId != undefined && zoneId != '' && divisionId != null && divisionId != undefined && divisionId != '') {
            $(".plcTblZone").hide();
            $("#plcTblZone_" + zoneId).show();

            $(".plcTblDivision").hide();
            $("#plcTblDivision_" + divisionId).show();


        }
    }

    function fnShowPLCDivision(zoneId, $this) {
        if (zoneId != null && zoneId != '' && zoneId != undefined) {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.plcTblDivisionByZone_' + zoneId).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.plcTblDivisionByZone_' + zoneId).hide();
            }
        }
    }

    function GetPMDivisionByZone() {
        var zoneId = $('#pmZone').val();
        $(".pmTblZone").show();
        $(".pmTblDivision").show();
        $("#pmDivisions").empty();
        $(".pmArrowIcon").removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
        $("#pmDivisions").append($("<option></option>").val('').html('Select Divison'));
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/Site/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $(".pmTblZone").hide();
                    $("#pmTblZone_" + zoneId).show();
                  
                    $.each(data, function (key, value) {
                        $("#pmDivisions").append($("<option></option>").val(value.Id).html(value.Name));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function GetPMDivision() {
        var zoneId = $('#pmZone').val();
        $(".pmTblZone").show();
        $(".pmTblDivision").show();
        $(".pmArrowIcon").removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
        var divisionId = $('#pmDivisions').val();
        if (zoneId != null && zoneId != undefined && zoneId != '' && divisionId != null && divisionId != undefined && divisionId != '') {
            $(".pmTblZone").hide();
            $("#pmTblZone_" + zoneId).show();

            $(".pmTblDivision").hide();
            $("#pmTblDivision_" + divisionId).show();
        }
    }

    function fnShowPMDivision(zoneId, $this) {
        if (zoneId != null && zoneId != '' && zoneId != undefined) {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.pmTblDivisionByZone_' + zoneId).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.pmTblDivisionByZone_' + zoneId).hide();
            }
        }
    }

    function fnShowUtilityLogDivision(zoneId, $this) {
        if (zoneId != null && zoneId != '' && zoneId != undefined) {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.utilityLogDivisionByZone_' + zoneId).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.utilityLogDivisionByZone_' + zoneId).hide();
            }
        }
    }

    function fnShowUtilityLogSite(divisionId, $this) {
        if (divisionId != null && divisionId != '' && divisionId != undefined) {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.utilityLogSiteByDivision_' + divisionId).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.utilityLogSiteByDivision_' + divisionId).hide();
            }
        }
    }
</script>

