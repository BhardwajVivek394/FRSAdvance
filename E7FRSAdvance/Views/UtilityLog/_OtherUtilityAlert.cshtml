@model List<Domain.UtilityLog>



<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-body " style="padding:15px;">
                <div class="table-responsive" style="">
                    <table class="table">
                        <thead class="bg-primary">
                            <tr>

                                <th>Site Name</th>
                                <th>Utility Type</th>
                                <th>Utility Name</th>
                                <th>Time Stamp</th>
                                <th>Is Active</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model.GroupBy(x => x.SiteName).ToList())
                                {
                                    foreach (var val in item.ToList())
                                    {
                                        <tr class="table-light">
                                            <td>@val.SiteName</td>
                                            <td>@val.UtilityType</td>
                                            <td>@val.UtilityName</td>
                                            <td>@val.TimeStamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td>
                                                @if (DateTime.Now.Subtract(val.TimeStamp).Minutes > 5)
                                                {
                                                    <span class="span badge rounded-pill pill-badge-danger">InActive</span>
                                                }
                                                else
                                                {
                                                    <span class="span badge rounded-pill pill-badge-success">Active</span>
                                                }
                                            </td>
                                        </tr>
                                    }

                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center">
                                        No record found
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>

