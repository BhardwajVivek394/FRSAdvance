<script>
    var app = null;
    var parseJson = null;
    $(document).ready(function () {
        debugger;
        $('#drpDivision').change(function () {
            window.location.href = "Index?divisionId=" + $(this).val();
            //$('#frmGetAssetDetails').submit();
        });
        app = new App.MainView({ el: '#app' });
        themePicker = new App.ThemePicker({ mainView: app });
        themePicker.render().$el.appendTo(document.body);


        app.paper.on('cell:pointerdown', function (ele) {
            if ('label' in ele.model.attributes.attrs && 'text' in ele.model.attributes.attrs.label) {
                if (ele.model.attributes.attrs.label.text != undefined && ele.model.attributes.attrs.label.text != "") {
                    debugger;
                    var sitename = ele.model.attributes.attrs.label.text;
                    if (sitename != null && sitename != '' && sitename != undefined) {
                        $("#loader").show();
                        $.ajax({
                            url: '/DivisionView/GetSite',
                            type: 'Post',
                            data: '{siteName:"' + sitename + '"}',
                            success: function (data) {
                                $("#loader").hide();
                                $("#hdnSiteSelectId").val(sitename);
                                $("#modalSiteSelectPartial").modal('show');

                                var c = document.getElementById("myCanvasSiteSelect");
                                var ctx = c.getContext("2d");
                                ctx.moveTo(0, 200);
                                ctx.strokeStyle = 'white';
                                ctx.lineTo(250, 200);
                                ctx.stroke();

                                ctx.moveTo(0, 200);
                                ctx.lineTo(250, 50);
                                ctx.stroke();

                                ctx.moveTo(0, 200);
                                ctx.lineTo(250, 350);
                                ctx.stroke();

                                //ctx.fillStyle = "#f5cc7f";
                                //ctx.beginPath();
                                //ctx.shadowColor = 'white';
                                //ctx.strokeStyle = "rgba(0,0,0,1)";
                                //ctx.shadowBlur = 15;
                                //ctx.shadowOffsetX = 0;
                                //ctx.shadowOffsetY = 0;
                                //ctx.arc(300, 200, 50, 0, 2 * Math.PI, true);
                                //ctx.closePath();
                                //ctx.fill();

                                //ctx.fillStyle = "#f5cc7f";
                                //ctx.beginPath();
                                //ctx.arc(300, 350, 50, 0, 2 * Math.PI);
                                //ctx.closePath();
                                //ctx.fill();

                                //ctx.fillStyle = "#f5cc7f";
                                //ctx.beginPath();
                                //ctx.arc(300, 50, 50, 0, 2 * Math.PI);
                                //ctx.closePath();
                                //ctx.fill();

                                const circle = new Path2D();
                                circle.arc(300, 200, 50, 0, 2 * Math.PI, true);
                                ctx.fillStyle = "#f5cc7f";
                                ctx.beginPath();
                                ctx.shadowColor = 'white';
                                ctx.strokeStyle = "rgba(0,0,0,1)";
                                ctx.shadowBlur = 15;
                                ctx.shadowOffsetX = 0;
                                ctx.shadowOffsetY = 0;
                                ctx.arc(300, 200, 50, 0, 2 * Math.PI, true);
                                ctx.closePath();
                                ctx.fill(circle);

                                const circletwo = new Path2D();
                                circletwo.arc(300, 350, 50, 0, 2 * Math.PI);
                                ctx.fillStyle = "#f5cc7f";
                                ctx.beginPath();
                                ctx.closePath();
                                ctx.fill(circletwo);

                                const circlethree = new Path2D();
                                circlethree.arc(300, 50, 50, 0, 2 * Math.PI);
                                ctx.fillStyle = "#f5cc7f";
                                ctx.beginPath();
                                ctx.closePath();
                                ctx.fill(circlethree);

                                //const circlefour = new Path2D();
                                //circlefour.arc(20, 200, 50, 0, 2 * Math.PI);
                                //ctx.fillStyle = "#f5cc7f";
                                //ctx.beginPath();
                                //ctx.closePath();
                                //ctx.fill(circlefour);

                                ctx.font = "15px Arial";
                                ctx.fillStyle = "black";
                                ctx.fillText("RDPMS", 270, 50);

                                ctx.font = "15px Arial";
                                ctx.fillText("MIS", 275, 200);

                                ctx.font = "15px Arial";
                                ctx.fillText("Data", 280, 350);

                                c.addEventListener('click', function (event) {

                                    if (ctx.isPointInPath(circle, event.offsetX, event.offsetY)) {
                                        GetMISSitePartial();
                                    }
                                    if (ctx.isPointInPath(circlethree, event.offsetX, event.offsetY)) {
                                        GetSitePartial()
                                    }
                                }, false);
                            },
                            error: function (response) {
                                /*CommonNotification("ERROR", "Something went wrong!", "Error");*/
                            }
                        });
                    }

                }
            }

        });


        GetSipView();

    });

    function handleMouseDown(event) {
        // get canvasXY of click
        debugger;
        var canvasOffset = document.querySelector("myCanvasSiteSelect");
        let rect = canvasOffset.getBoundingClientRect();
        let x = event.clientX - rect.left;
        let y = event.clientY - rect.top;
        console.log("Coordinate x: " + x,
            "Coordinate y: " + y);
    }

    function GetSitePartial() {
        $("#loader").show();
        $.ajax({
            url: '/DivisionView/_SitePartial',
            type: 'Post',
            data: '{siteName:"' + $("#hdnSiteSelectId").val() + '"}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divSitePartial").empty().append(data);
                $("#modalSitePartial").modal('show');
            },
            error: function (response) {
                //CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function GetMISSitePartial() {
        $("#loader").show();
        $.ajax({
            url: '/DivisionView/_MISSitePartial',
            type: 'Post',
            data: '{siteName:"' + $("#hdnSiteSelectId").val() + '"}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divMISSitePartial").empty().append(data);
                $("#modalMISSitePartial").modal('show');
            },
            error: function (response) {
                //CommonNotification("ERROR", "Something went wrong!", "Error");
            }
