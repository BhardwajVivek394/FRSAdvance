<style>

    #app {
        height: 800px
    }

    .card-fullscreen {
        z-index: 99;
        position: fixed;
        width: 100% !important;
        height: 100% !important;
        top: 0;
        right: 0;
        left: 0;
        bottom: 0;
        background-color: white;
    }

    .joint-paper-background, .joint-paper-grid, .joint-paper > svg {
        background-color: #010300;
    }

    .handle {
        display: none !important;
    }

    .site {
        background-color: black;
        color: white;
        padding: 20px 20px 40px;
    }

    .circle {
        border: 2px solid Whitesmoke;
        border-radius: 50%;
        height: 100px;
        width: 100px;
        text-align: right;
    }

    .card .card-header-sitelist {
        background-color: #08495e !important;
        color: white !important;
    }

    .cardRed {
        box-shadow: 1px 1px 5px 1px #ff4d4f !important;
    }

        .cardRed:hover {
            box-shadow: 2px 2px 15px 2px #ff4d4f !important;
        }

    .cardGreen {
        box-shadow: 1px 1px 5px 1px #51bb25 !important;
    }

        .cardGreen:hover {
            box-shadow: 2px 2px 15px 2px #51bb25 !important;
        }

    .card-body {
        padding: 25px !important;
    }

    .card-footer {
        padding: 25px !important;
    }

    .modal-backdrop {
        opacity: 0.5 !important;
    }

    .paper-container {
        background-color:black;
    }
</style>
<div class="container-fluid">

    <input type="hidden" id="hdnId" value="0" />
    <input type="hidden" id="hdnDivisionId" value="@Model.Id" />
    <br />
    <div class="card">
        <div class="card-body">
            <div id="app" class="card-fullscreen">
                <div class="app-header">
                    <div class="app-title" style="background-color:white;">

                        @Html.DropDownListFor(m => m.Id, (IEnumerable<SelectListItem>)ViewBag.Division, new { @class = "form-control", tabindex = 1, @id = "drpDivision" })
                    </div>
                    <div class="toolbar-container"></div>
                </div>
                <div class="site mt-2">
                    <div class="pull-left">
                        <img src="~/assets/images/cmenu.png" />
                    </div>
                    <div class="row">
                        <div class="col-auto">
                            <a class="nav-link text-white" style="font-size:16px;font-weight:500;background:#4bacc6; border-radius:10px;">Remote Diagnostic </a>
                        </div>
                        <div class="col-auto" style="margin-left:-15px;">
                            <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #215968; border-radius: 10px;">And</a>
                        </div>
                        <div class="col-auto" style="margin-left:-15px;">
                            <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #484640; border-radius: 10px;">Predictive Maintenance System </a>
                        </div>
                        <div class="col-auto" style="margin-left:-15px;">
                            <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #4bacc6; border-radius: 10px;">
                                Division Name: @Model.Name
                            </a>
                        </div>
                        <div class="col-auto" style="margin-left:-15px;">
                            <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #484640; border-radius: 10px;">Division View </a>
                        </div>
                    </div>
                  
                </div>
                <div class="app-body ">
                    <div class="stencil-container" style="display:none"></div>
                    <div class="paper-container" style="left:0px;right:0"></div>
                    <div class="inspector-container" style="display:none"></div>
                    <div class="navigator-container" style="display:none"></div>
                </div>
            </div>
        </div>
    </div>


</div>
