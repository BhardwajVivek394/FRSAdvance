    function BindAlertSimulation() {
        var smsLog = {};
        $.ajax({
            url: '/SMSLog/GetTodayActiveAlerts',
            type: 'Post',
            data: '{mSmsLog:' + JSON.stringify(smsLog) + '}',
            contentType: 'application/json',
            success: function (data) {
                $.each(parseJson.cells, function (id, val) {
                    if (val.type == "examples.site") {
                        /*  val.attrs.label.fill = "#228B22";*/

                        if (data != null && data.mSMSLogs != null && data.mSMSLogs.length > 0) {
                            $.each(data.mSMSLogs, function (id, smsLog) {
                                if ($.trim(val.attrs.label.text) == $.trim(smsLog.SiteName)) {
                                    val.attrs.circle1.fill = "#ff0000";
                                    val.attrs.circle1.stroke = "#ff0000";

                                }
                            });
                        }

                    }
                });
                app.graph.fromJSON(parseJson);


            },
            error: function (response) {
                $("#loader").hide();
                //CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });

    }

