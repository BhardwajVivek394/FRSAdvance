@model Domain.Site

<div class="modal bounceIn animated" id="modalMISSitePartial" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-body" style="padding:0px !important">
                <div class="row">
                    <div class="col-12" style="padding:0px !important">
                        <div class="card cardGreen" id="divSite_@Model.Id" data-sitename="@Model.Name" style=" height: 92%;">
                            <div class="card-header card-header-sitelist">
                                <div class="people-options clearfix">
                                    <div class="text-center">
                                        <h5 style="text-align: center;">
                                            @Model.Name
                                        </h5>
                                    </div>
                                    @*<button type="button" class="btn-close pull-right" data-bs-dismiss="modal" aria-hidden="true"></button>*@
                                </div>
                            </div>
                            <div style=" margin-bottom: -16px;">

                            </div>
                            <div class="card-body">
                                <div class="people-options clearfix">
                                    <div class="text-center">
                                        <img id="imgSite_@Model.Id" src="~/assets/images/imgGreen.png" height="100" width="100" />
                                    </div>
                                    <div class="text-center mt-3">
                                        @if (Model.TrackCount > 0)
                                        {
                                            <span class="span notification-badge"><a href="javascript:void(0)" style="color:white;" onclick="fnGetSiteSummaryView('@Model.Name','@E7FRSAdvance.Utility.Utility.AssetType.TRACK.GetHashCode()')">T: @Model.TrackCount </a></span>
                                        }
                                        @if (Model.PointMachineCount > 0)
                                        {
                                            <span class="span notification-badge"><a href="javascript:void(0)" style="color:white;" onclick="fnGetSiteSummaryView('@Model.Name','@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()')">P: @Model.PointMachineCount </a></span>
                                        }
                                        @if (Model.SignalCount > 0)
                                        {
                                            <span class="span notification-badge"><a href="javascript:void(0)" style="color:white;" onclick="fnGetSiteSummaryView('@Model.Name','@E7FRSAdvance.Utility.Utility.AssetType.SIGNAL.GetHashCode()')">S: @Model.SignalCount </a></span>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer">
                                <div class="people-options clearfix text-center">
                                    <a href="@System.Configuration.ConfigurationManager.AppSettings.Get("MISBaseUrl")/UserSite/GetRosterACKData?siteId=@Model.Id" class="btn btn-warning" style="font-size: medium;">Roster ACK</a>
                                    <a href="@System.Configuration.ConfigurationManager.AppSettings.Get("MISBaseUrl")/Site/SiteAssetData?siteId=@Model.Id" class="btn btn-primary" style="font-size: medium;">Data Entry</a>
                                    <a href="@System.Configuration.ConfigurationManager.AppSettings.Get("MISBaseUrl")/UserSite/AssetInfo?siteId=@Model.Id" class="btn btn-warning" style="font-size: medium;">Asset Info</a>

                                    <a href="@System.Configuration.ConfigurationManager.AppSettings.Get("MISBaseUrl")/SitePDF?siteId=@Model.Id" class="btn btn-primary" style="font-size: medium;">Site PDF</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>
