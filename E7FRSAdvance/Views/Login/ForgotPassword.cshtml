                    <br />
                }
            </div>
        </div>*@<!-- panel -->

    <div class="loader-box" id="load">
        <div class="loader-3"></div>
    </div>
    <div class="">
        <div class="row m-0">
            <div class="col-12 p-0">
                <div class="login-card">
                    <div>
                        <div>
                            <a class="logo text-center">
                                <img class="img-fluid for-light" src="@Url.Content("~/assets/images/logo.jpg")" style="max-width:100%;height:130px;" alt="looginpage">
                                <img class="img-fluid for-dark" src="@Url.Content("~/assets/images/logo.jpg")" alt="looginpage">
                            </a>
                        </div>
                        <div class="login-main">
                            @using (Html.BeginForm("ForgotPassword", "Login", FormMethod.Post, new { @id = "frmLogin", @class = "theme-form" }))
                            {
                                <h4> Forgot Password</h4>
                                <div class="form-group">
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                                        @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", placeholder = "Email address" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.EmailAddress, "", new { @class = "text-danger" })
                                </div>
                                <div class="form-group mb-0">
                                    <div class="text-end mt-3">
                                        <button type="submit" class="btn btn-primary btn-block w-100">Forgot Password</button>
                                    </div>
                                </div>
                                <p class="mt-4 mb-0"><a href="/Login/Index" class="ms-2"><< Back to Login</a></p>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <script src="~/assets/js/jquery-3.5.1.min.js"></script>
    <!-- Bootstrap js-->
    <script src="~/assets/js/bootstrap/bootstrap.bundle.min.js"></script>
    <!-- feather icon js-->
    <script src="~/assets/js/icons/feather-icon/feather.min.js"></script>
    <script src="~/assets/js/icons/feather-icon/feather-icon.js"></script>
    <!-- scrollbar js-->
    <!-- Sidebar jquery-->
    <script src="~/assets/js/config.js"></script>
    <script src="~/assets/js/notify/bootstrap-notify.min.js"></script>
    <script src="~/assets/js/notify/notify-script.js"></script>
    <!-- Plugins JS start-->
    <!-- Plugins JS Ends-->
    <!-- Theme js-->
    <script src="~/assets/js/script.js"></script>
    <script>

        if ('@ViewBag.Error' != "") {
            CommonNotify("danger", '@ViewBag.Error');
        }

        if ('@ViewBag.Success' != "") {
            CommonNotify("success", '@ViewBag.Success');
            $("#EmailAddress").val('');
        }

        function CommonNotify(type, message) {
            var notify = $.notify(message,
                {
                    type: type,
                    allow_dismiss: true,
                    delay: 2000,
                    showProgressbar: true,
                    timer: 300,
                    animate: {
                        enter: 'animated fadeInDown',
                        exit: 'animated fadeOutUp'
                    }
                });
        }
    </script>
</body>
</html>