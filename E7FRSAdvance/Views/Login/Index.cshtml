@model Domain.Login
@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login | Energy7</title>

    <link href="https://fonts.googleapis.com/css?family=Rubik:400,400i,500,500i,700,700i&amp;display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,300i,400,400i,500,500i,700,700i,900&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="~/assets/css/font-awesome.css">
    <!-- ico-font-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/vendors/icofont.css">
    <!-- Themify icon-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/vendors/themify.css">
    <!-- Flag icon-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/vendors/flag-icon.css">
    <!-- Feather icon-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/vendors/feather-icon.css">
    <!-- Plugins css start-->
    <!-- Plugins css Ends-->
    <!-- Bootstrap css-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/vendors/bootstrap.css">
    <!-- App css-->
    <link rel="stylesheet" type="text/css" href="~/assets/css/style.css">
    <link id="color" rel="stylesheet" href="~/assets/css/color-1.css" media="screen">
    <!-- Responsive css-->
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/responsive.css")">
    <link href="@Url.Content("~/Content/Custom.css")" rel="stylesheet" />
    <style>
        body {
            background-image: url('../../assets/images/login_bg.png');
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-size: 100% 100%;
        }

        #load {
            position: fixed;
            z-index: 9999999;
            left: 50%;
            top: 50%;
            transform: translate(-50%,-50%);
            display: none
        }

        * a {
            color: #00A4E0 !important;
        }
        .checkbox:checked:before {
            background-color: #00A4E0 !important;
        }
    </style>
</head>
<body>
    <div class="loader-box" id="load">
        <div class="loader-3"></div>
    </div>
    <div class="">
        <div class="row m-0">
            <div class="col-12 p-0">
                <div class="login-card">
                    <div>
                        <div>
                            <a class="logo text-center">

                                <img class="img-fluid for-light" src="@Url.Content("~/assets/images/logo_black.png")" style="max-width:100%;height:130px;" alt="looginpage">
                                <img class="img-fluid for-dark" src="@Url.Content("~/assets/images/logo_black.png")" alt="looginpage">
                            </a>
                        </div>
                        <div class="login-main">
                            @using (Html.BeginForm("Index", "Login", FormMethod.Post, new { @id = "frmLogin", @class = "theme-form" }))
                            {
                                <h4 style="color: #00A4E0;">Login</h4>
                                <p>Enter your email & password to login</p>
                                <div class="form-group">
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                                        @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", placeholder = "Email address" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.EmailAddress, "", new { @class = "text-danger" })
                                </div>
                                <div class="form-group">
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fa fa-key"></i></span>
                                        @Html.TextBoxFor(m => m.Password, new { @class = "form-control", type = "password", placeholder = "Password" })
                                    </div>
                                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                                </div>

                                @*<div><a href="/Login/ForgotPassword" class="forgot font-12 text-vision">Forgot password?</a></div>*@
                                <div class="form-group mb-0">
                                    <label class="d-block " style="padding-top:10px;" for="chk-ani">
                                        <input class="checkbox_animated" id="chk-ani" type="checkbox" checked="" data-bs-original-title="" title="">                                               Remember password
                                    </label>
                                    <a href="@Url.Content("~/Login/ForgotPassword")" class="forgot text-vision link">Forgot password?</a>
                                    <div class="text-end mt-3">
                                        <button type="submit" class="btn btn-primary btn-block w-100">Log In</button>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/assets/js/jquery-3.5.1.min.js"></script>
    <!-- Bootstrap js-->
    <script src="~/assets/js/bootstrap/bootstrap.bundle.min.js"></script>
    <!-- feather icon js-->
    <script src="~/assets/js/icons/feather-icon/feather.min.js"></script>
    <script src="~/assets/js/icons/feather-icon/feather-icon.js"></script>
    <!-- scrollbar js-->
    <!-- Sidebar jquery-->
    <script src="~/assets/js/config.js"></script>
    <!-- Plugins JS start-->
    <!-- Plugins JS Ends-->
    <script src="~/assets/js/notify/bootstrap-notify.min.js"></script>
    <script src="~/assets/js/notify/notify-script.js"></script>
    <!-- Theme js-->
    <script src="~/assets/js/script.js"></script>


    <script>

        if ('@ViewBag.Error' != "") {
            CommonNotify("danger", '@ViewBag.Error');
        }

        $(document).ready(function () {

            window.onbeforeunload = function () {
                $("#load").show();
            }

    });

    function CommonNotify(type, message) {
    var notify = $.notify(message,
    {
    type: type,
    allow_dismiss: true,
    delay: 2000,
    showProgressbar: true,
    timer: 300,
    animate: {
    enter: 'animated fadeInDown',
    exit: 'animated fadeOutUp'
    }
    });
    }
    </script>
</body>
</html>