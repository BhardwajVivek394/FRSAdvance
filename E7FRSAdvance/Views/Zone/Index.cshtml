@model Domain.ZoneLister

@{
    ViewBag.Title = "Zone";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Zone</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">
        @using (Ajax.BeginForm("ZoneList", "Zone", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divZoneList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "ZoneRefreshed"
        }, new { id = "frmGetZoneList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divZoneList">
                @Html.Action("ZoneList")
            </div>
        }


        @using (Ajax.BeginForm("SaveZone", "Zone", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveZone",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "ZoneSaved"
        }, new { id = "frmSaveZone" }))
        {
            <div id="divSaveZone">
                @Html.Partial("_AddZonePartial", new Domain.Zone())
            </div>
        }

    </div>
</div>
<script src="~/Content/PageJS/Zone/ZoneIndex.js"></script>