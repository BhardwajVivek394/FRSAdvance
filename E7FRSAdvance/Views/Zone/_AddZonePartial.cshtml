@model Domain.Zone

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal fade" id="modal-add-zone"  role="dialog" aria-labelledby="modal-add-zone" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
                @Html.HiddenFor(m => Model.Id, new { @id = "hdnZoneId" })
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Zone</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Edit Zone</span></h4>
                }
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
                <div class="modal-body">
                    <div class="form-horizontal">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="mb-3">
                                    <label class="form-label">Name <span class="text-danger">*</span></label>
                                    <div class="">
                                        @Html.TextBoxFor(m => Model.Name, new { @class = "form-control", tabindex = 1 })
                                        <span class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Description <span class="text-danger"></span></label>
                                    <div class="">
                                        @Html.TextAreaFor(m => Model.Description, new { @class = "form-control", tabindex = 2 })
                                        <span class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="">
                                    <label class="control-label">FRS Zone</label>
                                    <div class="mb-3">
                                        @Html.DropDownListFor(m => m.RepresentationCode, (IEnumerable<SelectListItem>)ViewBag.FRSZones,"Select", new { @class = "form-control", style = "width:100%", tabindex = 1 })
                                        <span id="spRole" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="control-label"><span>IsActive</span>  @Html.CheckBoxFor(m => Model.IsActive, new { style = "vertical-align:sub" })</label>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
                <div class="modal-footer">
                    <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close" >Close</a>
                    <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()" id="btnSave">Save</button>
                </div>
        </div>
    </div>
</div>

<script src="~/Content/PageJS/Zone/AddZone.js"></script>