@model Domain.MaintainerUser

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-maintainer-user" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            @Html.HiddenFor(m => Model.Id, new { @id = "hdnMaintainerUserId" })
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Maintainer User</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader">Edit Maintainer User</span></h4>
                }
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">

                            <div class="mb-3">
                                <label class="control-label">First Name <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.FirstName, new { @class = "form-control", tabindex = 1 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="control-label">LastName <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.LastName, new { @class = "form-control", tabindex = 3 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="control-label">Phone Number  <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.PhoneNumber, new { @class = "form-control", tabindex = 5 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnMaintainerSave()">Save</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        if ($('#hdnSaveType').val() == 'Success') {

            CommonNotification($("#hdnSaveType").val().toUpperCase(), $("#hdnSaveMessage").val(), $("#hdnSaveType").val());

            $("[class*='modal-backdrop']").remove();
            $("#frmGetMaintainerUserList").submit();
            window.history.pushState('', '', "Index");
        }
        else if ($('#hdnSaveType').val() == 'Error') {
            CommonNotification($("#hdnSaveType").val().toUpperCase(), $("#hdnSaveMessage").val(), $("#hdnSaveType").val());

            $("[class*='modal-backdrop']").remove();
            window.history.pushState('', '', "Index");
        }
    });

    function fnMaintainerSave() {
        if (Validate()) {
            $("#frmSaveMaintainerUser").submit();
        }
    }

    function Validate() {
        var result = true;
        if ($.trim($("#FirstName").val()).length == 0) {
            $("#FirstName").next("span").html("First Name is required");
            result = false;
        }
        else {
            $("#FirstName").next("span").html("");
        }
        if ($.trim($("#LastName").val()).length == 0) {
            $("#LastName").next("span").html("Last Name is required");
            result = false;
        }
        else {
            $("#LastName").next("span").html("");
        }

        if ($.trim($("#PhoneNumber").val()).length == 0) {
            $("#PhoneNumber").next("span").html("Phone number is required");
            result = false;
        }
        else {
            $("#PhoneNumber").next("span").html("");
        }

        return result;
    }
</script>
