@model Domain.MaintainerUserLister

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <div class="people-options clearfix">
                    <div class="pull-left">
                        @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == (int)E7FRSAdvance.Utility.Utility.Role.Admin)
                        {
                            <a class="btn btn-primary btn-quirk" onclick="GetMaintainerUserById(0)">Add</a>
                        }
                    </div>

                    <div class="pull-left m-l-5"> </div>

                    <div class="btn-group pull-right people-pager">
                        @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
                        @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpUserPageSize" })
                    </div>

                    <div class="btn-group pull-right people-pager">
                        <button type="button" class="btn btn-outline-dark" onclick="GetMaintainerUserPagerButtonClick('Previous')"><i class="fa fa-chevron-left "></i></button>
                        <button type="button" class="btn btn-outline-dark" onclick="GetMaintainerUserPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>
                    </div>

                    @{
                        int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
                        if (Model.MaintainerUsers.Count == 0)
                        {
                            start = 0;
                        }
                        decimal end = Math.Floor(Model.Pager.TotalRecord);
                        if (Model.Pager.PageSize < Model.Pager.TotalRecord)
                        {
                            if (Model.Pager.PageSize == -1)
                            {
                                end = Model.Pager.TotalRecord;
                            }
                            else
                            {
                                end = Model.Pager.PageSize * Model.Pager.CurrentPage;
                                if (end > Model.Pager.TotalRecord)
                                {
                                    end = Model.Pager.TotalRecord;
                                }
                            }
                        }
                    }
                    <span class="people-count pull-right" style="margin-top:10px;">Showing <strong>@start - @Math.Floor(end)</strong> of <strong>@Math.Floor(Model.Pager.TotalRecord)</strong> Users</span>
                </div>
            </div>

            <div class="card-body " style="padding:15px;">
                <div class="table-responsive" style="max-height: 620px;">
                    <table class="table">
                        <thead class="bg-primary">
                            <tr>
                                <th colspan="2" class="text-center">Action</th>

                                <th data-sortcolumn="FirstName" class="sorting" id="thFirstName" onclick="SortList('FirstName');">First Name</th>
                                <th data-sortcolumn="LastName" class="sorting" id="thLastName" onclick="SortList('LastName');">Last Name</th>
                                <th data-sortcolumn="PhoneNumber" class="sorting" id="thPhoneNumber" onclick="SortList('PhoneNumber');">PhoneNumber</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.MaintainerUsers != null && Model.MaintainerUsers.Count > 0)
                            {
                                foreach (var item in Model.MaintainerUsers)
                                {
                                    <tr class="table-light">
                                        <td class="text-center">
                                            <a href="#" data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Edit">
                                                <i class="fa fa-edit text-vision" onclick="GetMaintainerUserById('@item.Id')"></i>
                                            </a>
                                            
                                        </td>
                                        <td class="text-center">
                                            <a href="#" data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Delete">
                                                <i class="fa fa-trash text-danger" onclick="DeleteById('@item.Id')"></i>
                                            </a>
                                        </td>
                                        <td>@item.FirstName</td>
                                        <td>@item.LastName</td>
                                        <td>@item.PhoneNumber</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">
                                        No record found
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $('.drpSearch').change(function (e) {
            $("#hdnSkip").val('0');
            $("#frmGetMaintainerUserList").submit();
        });
    });

    function GetMaintainerUserById(id) {
        $("#loader").show();
        $.ajax({
            url: '/MaintainerUser/GetMaintainerUserById',
            type: 'Post',
            data: '{id:' + id + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divSaveMaintainerUser").empty().append(data);
                $("#modal-add-maintainer-user").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function DeleteById(id) {
        if (confirm('Are you sure you want to delete this record?')) {
            $("#loader").show();
            $.ajax({
                url: '/MaintainerUser/Delete',
                type: 'Post',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            $("#frmGetMaintainerUserList").submit();
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
    }

    function GetMaintainerUserPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmGetMaintainerUserList").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize) {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmGetMaintainerUserList").submit();
            }
        }
    }
</script>
