@model Domain.MaintainerUserLister
@{
    ViewBag.Title = "Maintainer Users";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Maintaner User</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body" style="padding:15px;">
                @using (Ajax.BeginForm("MaintainerUserList", "MaintainerUser", new AjaxOptions()
                {
                    HttpMethod = "POST",
                    UpdateTargetId = "divMaintainerUserList",
                    InsertionMode = InsertionMode.Replace,
                    LoadingElementId = "loader",
                }, new { id = "frmGetMaintainerUserList" }))
                {
                    { HtmlHelper.ClientValidationEnabled = false; }
                    <div id="divMaintainerUserList">
                        @Html.Action("MaintainerUserList")
                    </div>
                }
            </div>
        </div>
    </div>
</div>


<div class="">
    <div>
        @using (Ajax.BeginForm("Create", "MaintainerUser", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveMaintainerUser",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
        }, new { id = "frmSaveMaintainerUser" }))
        {
            <div id="divSaveMaintainerUser">
                @Html.Partial("_AddMaintainerUser", new Domain.MaintainerUser())
            </div>
        }

    </div>
</div>