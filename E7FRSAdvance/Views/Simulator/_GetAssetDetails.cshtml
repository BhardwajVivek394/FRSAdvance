    function stringToBool(val) {
        return (val + '').toLowerCase() === 'true';
    }

    function decimalToBinary(num) {
        let binary = "";
        while (num > 0) {
            let digit = num % 2;
            binary = "" + digit + binary;
            num = parseInt(num / 2);
        }
        return binary.padStart(8, '0');
    }

    function BinaryToDecimal(num) {
        return num.split('').reverse().reduce(function (x, y, i) {
            return (y === '1') ? x + Math.pow(2, i) : x;
        }, 0);
    }

    function fnConvertUTCDate(currentdate) {

        return "" + (currentdate.getUTCMonth() + 1) + "/"
            + currentdate.getUTCDate() + "/"
            + currentdate.getUTCFullYear() + " "
            + currentdate.getUTCHours() + ":"
            + currentdate.getUTCMinutes() + ":"
            + currentdate.getUTCSeconds();
    }

    function fnPointEventFile() {
        $("#loader").show();
        var fileUpload = $('#fileUploadPointEvent').get(0);
        var files = fileUpload.files;
        if (files != null && files != undefined && files.length > 0) {
            var fileData = new FormData();
            fileData.append("siteId", $('#hdnsiteId').val());
            fileData.append(files[0].name, files[0]);

            $.ajax({
                url: "/Simulator/UploadPointEventFile",
                type: "POST",
                contentType: false,
                processData: false,
                data: fileData,
                async: true,
                success: function (data) {
                    $("#loader").hide();

                    if (data != null && data != undefined && data.type == 'success') {
                        CommonNotification("SUCCESS", data.result, "success");
                    }
                    else {
                        CommonNotification("ERROR", data.result, "Error");
                    }
                },
                error: function (xhr, error, status) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "Error");
                }
            });
        }
        else {
            CommonNotification("ERROR", "Please select file", "Error");
        }
    }

