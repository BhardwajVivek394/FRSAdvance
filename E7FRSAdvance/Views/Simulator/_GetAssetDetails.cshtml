    function fnUploadPointEventFileData() {
        var mPointMachineDatas = [];
        var mUploadFile = {};
        mUploadFile.SiteId = $('#hdnsiteId').val();
        var d = new Date();
        debugger;
        var isValid = true;
        if ($('#drpPointAlertAlias').val() == null || $('#drpPointAlertAlias').val() == undefined || $('#drpPointAlertAlias').val() == '') {
            alert('Json not configure')
            isValid = false;
        }

        if ($('#drpPointAsset :selected').text() == null || $('#drpPointAsset :selected').text() == undefined || $('#drpPointAsset :selected').text() == '') {
            alert('Asset is required')
            isValid = false;
        }

        if ($('#drpPointDirection :selected').text() == null || $('#drpPointDirection :selected').text() == undefined || $('#drpPointDirection :selected').text() == '') {
            alert('Direction is required')
            isValid = false;
        }
        var mPointMachineData = {};
        mPointMachineData.ArrayData = $('#drpPointAlertAlias').val();
        mPointMachineData.AssetName = $('#drpPointAsset :selected').text();
        mPointMachineData.Direction = $('#drpPointDirection :selected').text();
        mPointMachineData.TimeStamp = d;

        if ($('#drpPointAlertAlias :selected').text().includes("Current")) {
            mPointMachineData.Direction = mPointMachineData.Direction + " " + "C";
        }
        else if ($('#drpPointAlertAlias :selected').text().includes("Voltage")) {
            mPointMachineData.Direction = mPointMachineData.Direction + " " + "V";
        } else {
            mPointMachineData.Direction = mPointMachineData.Direction + " " + "C";
        }

        mPointMachineDatas.push(mPointMachineData);

        mUploadFile.mPointMachineDatas = mPointMachineDatas;
        if (isValid) {
            $("#loader").show();
            $.ajax({
                url: '/Simulator/UploadPointEventFileData',
                type: 'Post',
                data: '{mUploadFile:' + JSON.stringify(mUploadFile) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $('#modal-add-point-function').modal('hide');
                    $("#loader").hide();
                    if (data != null && data != undefined && data.type == 'success') {
                        CommonNotification("SUCCESS", data.result, "success");
                    }
                    else {
                        CommonNotification("ERROR", data.result, "Error");
                    }
                },
                error: function (xhr, error, status) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "Error");
                }
            });
        }

    }

    function fnSaveDefaultValue() {
        var defaultValues = [];

        $('.txtUploadAttributeData').each(function () {
            var value = $(this).val();
            if (value != null && value != undefined && value != '') {
                var mDefaultValue = {};
                mDefaultValue.SiteId = $('#hdnsiteId').val();
                mDefaultValue.AssetId = $(this).data('assetid');
                mDefaultValue.AttributeId = $(this).data('attributeid');
                mDefaultValue.Value = value;
                defaultValues.push(mDefaultValue);
            }
        });

        $('.txtDataloggerUploadAttributeData').each(function () {
            var value = $(this).val();
            if (value != null && value != undefined && value != '') {
                var mDefaultValue = {};
                mDefaultValue.SiteId = $('#hdnsiteId').val();
                mDefaultValue.AssetId = $(this).data('assetid');
                mDefaultValue.DataLoggerAttributeId = $(this).data('dataloggerattributeid');
                mDefaultValue.Value = value;
                defaultValues.push(mDefaultValue);
            }
        });
        $("#loader").show();
        $.ajax({
            url: '/Simulator/SaveDefaultValue',
            type: 'Post',
            data: '{defaultValues:' + JSON.stringify(defaultValues) + '}',
            contentType: 'application/json',
            success: function (data) {
                debugger;
                $("#loader").hide();
                if (data != null && data != undefined && data.type == 'success') {
                    CommonNotification("SUCCESS", data.result, "success");
                    $('#modal-add-alert-function').modal('hide');
                }
                else {
                    CommonNotification("ERROR", data.result, "Error");
                }
            },
            error: function (xhr, error, status) {
                CommonNotification("ERROR", "Internal server error.", "Error");
            }
        });
    }


</script>
