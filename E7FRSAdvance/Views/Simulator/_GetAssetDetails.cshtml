    function fnPublishMessage() {
        let isSecure = window.location.protocol === "https:";
        client = new Paho.Client(mQTT.MQTTUri, mQTT.MQTTPort, "clientId" + Math.ceil(Math.random() * 10000));
        // set callback handlers

        //client.send("mytopic", "myvalue", 1, true);


        client.onConnectionLost = onConnectionLost;
        client.onMessageArrived = onMessageArrived;

        // connect the client
        client.connect({
            onSuccess: onConnect,
            useSSL: isSecure,
            userName: mQTT.MQTTUsername,
            password: mQTT.MQTTPassword,
            cleanSession: true
        });
    }


    function ClearText() {
        $(".txtUploadAttributeData").each(function () {
            $(this).val('');
        });
    }

    function onConnect() {
        // Once a connection has been made, make a subscription and send a message.
        var counter = 1;
        var rdpmschannel = mQQTPath + "channel1";
        var dlchannel = mQQTPath + "dl/" + "channel1";
       // client.subscribe(mQQTPath);
        setInterval(function () {
            var realtimeValues = [];
            var tsData = [];
            let values = [];
            $('.txtUploadAttributeData').each(function () {
                var value = $(this).data('value');
                if (value != null && value != undefined && value != '') {
                    values.push(parseInt(value));
                }
            });

            for (var i = 0; i <= values.length; i++) {
                //var val = values[i];
                var newtxtstr = '0.0';
                $('.txtUploadAttributeData').each(function () {
                    var newvalue = $(this).data('value');
                    var txtvalue = $(this).val();

                    if (newvalue != null && newvalue != undefined && newvalue != '' && newvalue == i && txtvalue != null && txtvalue != undefined && txtvalue != '') {
                        newtxtstr = txtvalue;
                        return false;
                    }

                });

                var d = new Date();

                tsData.push(parseInt(d.getTime()));
                realtimeValues.push(newtxtstr);
            }
           // var strRealtimeValues = realtimeValues.join(",")
            var jsonstr = {};
            jsonstr.ts = tsData;
            jsonstr.roles = realtimeValues;


            var jsonstringify = JSON.stringify(jsonstr);

            client.publish(rdpmschannel, jsonstringify, 1, true);

            //var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
            //$("#c" + i).html(time);
        }, 5000)


        // Published Datalogger
        setInterval(function () {
            var realtimeValues = [];
            let values = [];
            $('.txtDataloggerUploadAttributeData').each(function () {
                var value = $(this).data('value');
                if (value != null && value != undefined && value != '') {
                    values.push(parseInt(value));
                }
            });
            debugger;
            for (var i = 0; i <= values.length; i++) {
                //var val = values[i];
                var newtxtstr = '0';
                $('.txtDataloggerUploadAttributeData').each(function () {
                    var newvalue = $(this).data('value');
                    var txtvalue = $(this).val();
                    if (newvalue != null && newvalue != undefined && newvalue != '') {
                        newvalue = parseInt(newvalue) - 1;
                    }

                    if (newvalue != null && newvalue != undefined && newvalue != '' && newvalue == i && txtvalue != null && txtvalue != undefined && txtvalue != '') {
                        newtxtstr = txtvalue;
                        return false;
                    }
                });

                //if (isDataLoggerJsonReverse == "True") {
                //    if (parseInt(newtxtstr) == 0)
                //        newtxtstr = 1;
                //    else if (parseInt(newtxtstr) == 1)
                //        newtxtstr = 0;
                //}

                realtimeValues.push(newtxtstr);
            }

            debugger;

            //  var strRealtimeValues = realtimeValues.join(",")
            var chunkSize = 8;
            let binaryvalues = [];
            for (let i = 0; i < realtimeValues.length; i += chunkSize) {
                const chunk = realtimeValues.slice(i, i + chunkSize);
                let text = chunk.join("");
                if (text.length != 8) {

                    for (var decl = 0; decl <= 9 - text.length; decl++) {
                        text += "0";
                    }

                }
                var convertBinaryValue = BinaryToDecimal(text);
                binaryvalues.push(convertBinaryValue);

                // do whatever
            }
            var d = new Date();
            var jsonstr = {};
            jsonstr.ts = d;
            jsonstr.bits = binaryvalues;

            var jsonstringify = JSON.stringify(jsonstr);
            var dlJsonString = {}
            dlJsonString.LastModifiedDate = d;
            dlJsonString.JsonString = JSON.stringify(binaryvalues);
            dlJsonStrings.push(dlJsonString);
            client.publish(dlchannel, jsonstringify, 1, true);

            if (counter == 10) {
                counter = 1;
                fnUploadDataLoggerEventFile();
            }
            counter++;
        }, 5000)


        //for (var i = 0; i < channels.length; i++) {
        //    if (channels[i] != null && channels[i] != "null" && channels[i] != "") {
        //        client.subscribe(mQQTPath + channels[i].toLowerCase());

        //        client.subscribe(mQQTPath + 'dl/#');
        //    }
        //}
