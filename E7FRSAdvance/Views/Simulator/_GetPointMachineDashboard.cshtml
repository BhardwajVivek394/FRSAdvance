@model Domain.AssetLister
<style>
    .popover {
        width: 100%;
    }

    .popover-content {
        color: black;
    }

    .point-dot-container {
        display: flex;
        gap: 20px;
    }

    .point-dot {
        display: flex;
        align-items: center;
        gap: 3px;
    }

    .point-dot-one .circle {
        width: 20px;
        height: 20px;
        background-color: #dc8b33;
        border-radius: 50%;
    }

    .point-dot-two .circle {
        width: 20px;
        height: 20px;
        background-color: #00A4E0;
        border-radius: 50%;
    }

    @@media only screen and (max-width: 1200px) {
        .panel-body {
        }
    }
</style>
<div class="people-options clearfix">
    <div class="pull-left" style="display:inline-flex;">
        <div class="input-group " style="margin-left:20px;">
            @Html.TextBoxFor(x => x.SearchCriteria.AssetName, new { @class = "form-control btn-pill asset-search", @placeholder = "Search point machine" })
        </div>
    </div>
    @*<div class="btn-group pull-right people-pager">
            @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
            @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
        </div>
        <div class="btn-group pull-right people-pager">
            <button type="button" class="btn btn-default" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left"></i></button>
            <button type="button" class="btn btn-default" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>
        </div>*@
    @{
        int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
        if (Model.mAssets.Count == 0)
        {
            start = 0;
        }
        decimal end = Math.Floor(Model.Pager.TotalRecord);
        if (Model.Pager.PageSize < Model.Pager.TotalRecord)
        {
            if (Model.Pager.PageSize == -1)
            {
                end = Model.Pager.TotalRecord;
            }
            else
            {
                end = Model.Pager.PageSize * Model.Pager.CurrentPage;
                if (end > Model.Pager.TotalRecord)
                {
                    end = Model.Pager.TotalRecord;
                }
            }
        }
    }
    <span class="people-count pull-right">Showing <strong>@Model.mAssets.Count</strong> Assets</span>
</div>

<div class="card">

    <div class="card-body" style="padding:15px;">
        <div class="row">
            <div class="col-sm-2 mb-1">
                <label>From Date</label>
                <input type="text" name="SearchCriteria.StartDate" class="datepicker-here form-control digits from-date" id="txtFromDate" value="@Model.SearchCriteria.StartDate" data-language="en" data-bs-original-title="" title="" />
            </div>
            <div class="col-sm-2 mb-1">
                <label>To Date</label>
                <input type="text" name="SearchCriteria.EndDate" class="datepicker-here form-control digits to-date" id="txtToDate" value="@Model.SearchCriteria.EndDate" data-language="en" data-bs-original-title="" title="" />
            </div>
            @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == (int)E7FRSAdvance.Utility.Utility.Role.User)
            {
                <div class="col-sm-1 mb-1">
                    @Html.CheckBoxFor(x => x.SearchCriteria.IsPointMachineDebug)
                    <label class="m-l-5 mt-4" for="SearchCriteria_IsPointMachineDebug">debug</label>
                </div>
            }

            <div class="col-sm-2 mb-1 mt-4">
                <a href="javascript:void(0)" class="btn btn-success" onclick="Search()"><i class="fa fa-search"></i></a>
                <a href="javascript:void(0)" class="btn btn-primary" onclick="DownloadPointMachineData()" title="Download Report"><i class="fa fa-download"></i></a>
                <a href="javascript:void(0)" class="btn btn-info" onclick="DownloadPointMachineEventData()" title="Download Event"><i class="fa fa-download"></i></a>
            </div>
            <div class="col-sm-1 mb-1 mt-4">

                @Html.DropDownListFor(model => model.SearchCriteria.TakePointMachineData,
                new List<SelectListItem> {
                     new SelectListItem { Value = "0" , Text = "All" },
                     new SelectListItem { Value = "2" , Text = "2" },
                     new SelectListItem { Value = "4" , Text = "4" }
                  },
                new { @class = "form-control", style = "display: none;" })
            </div>
            <div class="col-sm-4 mb-1 mt-4">
                @*<a href="javascript:void(0)" title="Normal Current" onclick="fnBindMultipleSignatureEventGraghBySite('@Model.SearchCriteria.SiteId', 'Normal', 'C');return false;">NC</a> | <a href="javascript:void(0)" onclick="fnBindMultipleSignatureEventGraghBySite('@Model.SearchCriteria.SiteId', 'Normal', 'V');return false;" title="Normal Voltage">NV</a> | <a href="javascript:void(0)" onclick="fnBindMultipleSignatureEventGraghBySite('@Model.SearchCriteria.SiteId','Reverse','C');return false;" title="Reverse Current">RC</a> | <a href="javascript:void(0)" onclick="fnBindMultipleSignatureEventGraghBySite('@Model.SearchCriteria.SiteId','Reverse','V');return false;" title="Reverse Voltage">RV</a>
                    <br />*@

                @if (Model.mAssets != null && Model.mAssets.Where(x => x.IsSeriesOpration != null && x.IsSeriesOpration.Value).Count() > 0)
                {
                    <a href="javascript:void(0)" class="btn btn-default" title="Normal Current" onclick="fnBindMultipleSignatureEventGraghBySite('@Model.SearchCriteria.SiteId', 'Normal', 'C');return false;">NC</a>
                    <span>|</span>
                    <a href="javascript:void(0)" class="btn btn-default" onclick="fnBindMultipleSignatureEventGraghBySite('@Model.SearchCriteria.SiteId', 'Normal', 'V');return false;" title="Normal Voltage">NV</a>
                    <span>|</span>
                    <a href="javascript:void(0)" class="btn btn-default" onclick="fnBindMultipleSignatureEventGraghBySite('@Model.SearchCriteria.SiteId','Reverse','C');return false;" title="Reverse Current">RC</a>
                    <span>|</span>
                    <a href="javascript:void(0)" class="btn btn-default" onclick="fnBindMultipleSignatureEventGraghBySite('@Model.SearchCriteria.SiteId','Reverse','V');return false;" title="Reverse Voltage">RV</a>
                    @*<span>|</span>
                        <a class="btn btn-default" title="Combine Normal" href="javascript:void(0)" onclick="fnShowMultipleGraphBySite('@Model.SearchCriteria.SiteId','CC','Normal')">CN</a>
                        <span>|</span>
                        <a class="btn btn-default" title="Combine Reverse" href="javascript:void(0)" onclick="fnShowMultipleGraphBySite('@Model.SearchCriteria.SiteId','CC','Reverse')">CR</a>*@
                }
                <span>|</span>
                <a class="btn btn-default" title="A Normal" href="javascript:void(0);" onclick="fnShowMultipleGraphBySite('@Model.SearchCriteria.SiteId','AC','Normal')">AN</a>
                <span>|</span>
                <a class="btn btn-default" title="A Reverse" href="javascript:void(0)" onclick="fnShowMultipleGraphBySite('@Model.SearchCriteria.SiteId','AC','Reverse')">AR</a>
                <span>|</span>
                <a class="btn btn-default" title="B Normal" href="javascript:void(0)" onclick="fnShowMultipleGraphBySite('@Model.SearchCriteria.SiteId','BC','Normal')">BN</a>
                <span>|</span>
                <a class="btn btn-default" title="B Reverse" href="javascript:void(0)" onclick="fnShowMultipleGraphBySite('@Model.SearchCriteria.SiteId','BC','Reverse')">BR</a>
            </div>
        </div>
        @if (Model.mAssets != null && Model.mAssets.Count > 0)
        {
            foreach (var item in Model.mAssets)
            {
                int cnt = item.AssetTypeName.Length + item.Name.Length;

                var vibration = item.assetAttributes.Where(x => x.Title.Contains("Vibration")).ToList();
                bool isVibration = false;
                if (vibration != null && vibration.Count > 0)
                {
                    isVibration = true;
                }
                string aEnd = string.Empty;
                string bEnd = string.Empty;
                string aVibration = string.Empty;
                string bVibration = string.Empty;
                string displacement1 = string.Empty;
                if (item.assetAttributes != null && item.assetAttributes.Count > 0)
                {
                    var mAEnd = item.assetAttributes.Where(x => x.Title == "A End - NWKR" || x.Title == "A End - RWKR").ToList();
                    if (mAEnd != null && mAEnd.Count > 0)
                    {
                        var mDisplacement1 = item.assetAttributes.Where(x => x.Title.Contains("Displacement1")).ToList();
                        if (mDisplacement1 != null && mDisplacement1.Count > 0)
                        {
                            mAEnd.AddRange(mDisplacement1);
                        }

                        var mDisplacement2 = item.assetAttributes.Where(x => x.Title.Contains("Displacement2")).ToList();
                        if (mDisplacement2 != null && mDisplacement2.Count > 0)
                        {
                            mAEnd.AddRange(mDisplacement2);
                        }
                        aEnd = Newtonsoft.Json.JsonConvert.SerializeObject(mAEnd);
                    }
                    var mBEnd = item.assetAttributes.Where(x => x.Title == "B End - NWKR" || x.Title == "B End - RWKR").ToList();
                    if (mBEnd != null && mBEnd.Count > 0)
                    {
                        bEnd = Newtonsoft.Json.JsonConvert.SerializeObject(mBEnd);
                    }
                    var mAVibration = item.assetAttributes.Where(x => x.Title.Contains("Vibration A")).ToList();
                    if (mAVibration != null && mAVibration.Count > 0)
                    {
                        aVibration = Newtonsoft.Json.JsonConvert.SerializeObject(mAVibration);
                    }
                    var mBVibration = item.assetAttributes.Where(x => x.Title.Contains("Vibration B")).ToList();
                    if (mBVibration != null && mBVibration.Count > 0)
                    {
                        bVibration = Newtonsoft.Json.JsonConvert.SerializeObject(mBVibration);
                    }

                }

                <div class="col-sm-12 col-md-12 col-lg-12">
                    <div class="card">
                        <div class="col-xl-12 news box-col-12">
                            <div class="card card-border">
                                <div class="bg-secondary" style="padding:0;border-top-left-radius:15px;border-top-right-radius:15px;">
                                    <div class="" style="width:95%;float:left;padding:5px;border-top-left-radius:15px;">
                                        <h6 style="margin-left:10px">
                                            <a target="_blank" class="text-white" href="@item.HttpMisLink"> @item.AssetTypeName : @item.Name</a>
                                        </h6>
                                        <span style="margin-left:11px;">Index Score: @item.IndexScore</span>
                                    </div>
                                    <div class="text-center bg-dark" style="width:5%;float:left;padding:2px 0px;border-top-right-radius:15px;line-height:1.3;height:58px">

                                        @if (item.UnderMaintence == true)
                                        {
                                            <div class="text-center"> <i class="fa fa-bell-slash fa fa-das" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i></div>
                                        }
                                        else
                                        {
                                            <div class="text-center">
                                                <i class="fa fa-bell" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i>
                                            </div>
                                        }
                                        @*<a onclick="fnGetAssetGraph('@item.SiteId','@item.Id')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer"> Graph </a>*@
                                        <a href="javascript:void(0)" onclick="fnGetSmsLog('@item.Id')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer">Event log</a>
                                    </div>

                                </div>
                                <div class="card-body" style="padding:10px;margin-bottom:-15px">
                                    <div class="row">
                                        <div class="col-sm-6 mb10 mt20 text-left">
                                            <div class="point-dot-container">
                                                @if (item.IsThickWave != null && item.IsThickWave.Value)
                                                {
                                                    if (item.ThickWaveTypeId != null && (item.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.A || item.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both))
                                                    {
                                                        <div class="point-dot point-dot-two">
                                                            <div class="circle"></div>
                                                            @if (!string.IsNullOrEmpty(item.AliasDirectionA))
                                                            {
                                                                <div class="text"> PT-@item.AliasDirectionA TWS</div>
                                                            }
                                                            else
                                                            {
                                                                <div class="text">@(item.Name.Contains("PT")? item.Name : "PT-" + item.Name)A TWS</div>
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="point-dot point-dot-one">
                                                            <div class="circle"></div>
                                                            @if (!string.IsNullOrEmpty(item.AliasDirectionA))
                                                            {
                                                                <div class="text"> PT-@item.AliasDirectionA IRS</div>
                                                            }
                                                            else
                                                            {
                                                                <div class="text"> @(item.Name.Contains("PT")? item.Name : "PT-" + item.Name)A IRS</div>
                                                            }
                                                        </div>
                                                    }

                                                    if (item.IsHalfPointMachine == null || (item.IsHalfPointMachine != null && !item.IsHalfPointMachine.Value))
                                                    {
                                                        if (item.ThickWaveTypeId != null && (item.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.B || item.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both))
                                                        {
                                                            <div class="point-dot point-dot-two">
                                                                <div class="circle"></div>
                                                                @if (!string.IsNullOrEmpty(item.AliasDirectionB))
                                                                {
                                                                    <div class="text">PT-@item.AliasDirectionB TWS</div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="text">@(item.Name.Contains("PT")? item.Name : "PT-" + item.Name)B TWS</div>
                                                                }

                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="point-dot point-dot-one">
                                                                <div class="circle"></div>
                                                                @if (!string.IsNullOrEmpty(item.AliasDirectionB))
                                                                {
                                                                    <div class="text">PT-@item.AliasDirectionB IRS</div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="text">@(item.Name.Contains("PT")? item.Name : "PT-" + item.Name)B IRS</div>
                                                                }
                                                            </div>
                                                        }
                                                    }

                                                }
                                                else
                                                {
                                                    <div class="point-dot point-dot-one">
                                                        <div class="circle"></div>
                                                        @if (!string.IsNullOrEmpty(item.AliasDirectionA))
                                                        {
                                                            <div class="text"> PT-@item.AliasDirectionA IRS</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="text"> @(item.Name.Contains("PT")? item.Name : "PT-" + item.Name)A IRS</div>
                                                        }
                                                    </div>

                                                    if (item.IsHalfPointMachine == null || (item.IsHalfPointMachine != null && !item.IsHalfPointMachine.Value))
                                                    {
                                                        <div class="point-dot point-dot-one">
                                                            <div class="circle"></div>
                                                            @if (!string.IsNullOrEmpty(item.AliasDirectionB))
                                                            {
                                                                <div class="text"> PT-@item.AliasDirectionB IRS</div>
                                                            }
                                                            else
                                                            {
                                                                <div class="text"> @(item.Name.Contains("PT")? item.Name : "PT-" + item.Name)B IRS</div>
                                                            }
                                                        </div>
                                                    }

                                                }




                                            </div>
                                        </div>
                                        <div class="col-sm-6 mb10 mt20 text-right">
                                            <a href="javascript:void(0)" style="margin-bottom:10px;float:right;" class="btn btn-primary" onclick="DownloadPointData(@item.Id)">Download</a>
                                        </div>
                                    </div>


                                    <div class="table-responsive width100p tblAssetData">
                                        <table class="table table-bordered table-striped">
                                            <thead>
                                                <tr>
                                                    <th class="hdnAssetNameTD@(item.Id)">@item.Name</th>
                                                    @if (item.IsHalfPointMachine == null || (item.IsHalfPointMachine != null && !item.IsHalfPointMachine.Value))
                                                    {
                                                        if (!string.IsNullOrEmpty(item.AliasDirectionA))
                                                        {
                                                            <th @(item.ISDisplacement != null && item.ISDisplacement.Value && item.MachineA != null && item.MachineA.Value > 0 ? "colspan=2" : "")><a href="javascript:void(0)" onclick="fnShowPointMachineGraph('@item.SiteId', '@item.Id', '@aEnd'); return false;"> Direction:@item.AliasDirectionA</a></th>
                                                        }
                                                        else
                                                        {
                                                            <th @(item.ISDisplacement != null && item.ISDisplacement.Value && item.MachineA != null && item.MachineA.Value > 0 ? "colspan=2" : "")><a href="javascript:void(0)" onclick="fnShowPointMachineGraph('@item.SiteId','@item.Id','@aEnd'); return false;">Direction:A</a></th>
                                                        }

                                                        if (!string.IsNullOrEmpty(item.AliasDirectionB))
                                                        {
                                                            <th @(item.ISDisplacement != null && item.ISDisplacement.Value && item.MachineB != null && item.MachineB.Value > 0 ? "colspan=2" : "")><a href="javascript:void(0)" onclick="fnShowPointMachineGraph('@item.SiteId','@item.Id','@bEnd'); return false;"> Direction:@item.AliasDirectionB</a></th>
                                                        }
                                                        else
                                                        {
                                                            <th @(item.ISDisplacement != null && item.ISDisplacement.Value && item.MachineB != null && item.MachineB.Value > 0 ? "colspan=2" : "")><a href="javascript:void(0)" onclick="fnShowPointMachineGraph('@item.SiteId','@item.Id','@bEnd'); return false;"> Direction:B</a></th>
                                                        }

                                                        if (isVibration)
                                                        {
                                                            <th><a href="javascript:void(0)" onclick="fnShowPointMachineGraph('@item.SiteId','@item.Id','@aVibration'); return false;"> VibrationA(x/y/z)</a></th>
                                                            <th><a href="javascript:void(0)" onclick="fnShowPointMachineGraph('@item.SiteId','@item.Id','@bVibration'); return false;"> VibrationB(x/y/z)</a></th>
                                                        }
                                                        <th></th>
                                                    }
                                                    else
                                                    {
                                                        <th><a href="javascript:void(0)" onclick="fnShowPointMachineGraph('@item.SiteId','@item.Id','@aEnd'); return false;">Direction</a></th>
                                                        <th></th>
                                                        if (isVibration)
                                                        {
                                                            <th></th>
                                                            <th></th>
                                                        }
                                                    }

                                                </tr>
                                            </thead>
                                            <tbody id="tblAttributeData@(item.Id)" class="tblAttributes">
                                                <tr>
                                                    <td>
                                                    </td>
                                                    <td>
                                                        @if (item.ISDisplacement != null && item.ISDisplacement.Value && item.MachineA != null && item.MachineA.Value > 0)
                                                        {
                                                            <div class="row">
                                                                <div class="col-md-12 text-center">
                                                                    <b><u>Relay Room</u></b>
                                                                </div>
                                                            </div>
                                                        }
                                                        <div id="diectionA@(item.Id)"></div>
                                                    </td>
                                                    @if (item.ISDisplacement != null && item.ISDisplacement.Value && item.MachineA != null && item.MachineA.Value > 0)
                                                    {
                                                        <td>
                                                            <div class="row">
                                                                <div class="col-md-12 text-center">
                                                                    <b><u>Field</u></b>
                                                                </div>
                                                            </div>
                                                            <div id="DisplacementA@(item.Id)"></div>
                                                        </td>
                                                    }
                                                    <td>
                                                        @if (item.ISDisplacement != null && item.ISDisplacement.Value && item.MachineB != null && item.MachineB.Value > 0)
                                                        {
                                                            <div class="row">
                                                                <div class="col-md-12 text-center">
                                                                    <b><u>Relay Room</u></b>
                                                                </div>
                                                            </div>
                                                        }
                                                        <div id="diectionB@(item.Id)"></div>
                                                    </td>
                                                    @if (item.ISDisplacement != null && item.ISDisplacement.Value && item.MachineB != null && item.MachineB.Value > 0)
                                                    {
                                                        <td>
                                                            <div class="row">
                                                                <div class="col-md-12 text-center">
                                                                    <b><u>Field</u></b>
                                                                </div>
                                                            </div>
                                                            <div id="DisplacementB@(item.Id)"></div>
                                                        </td>
                                                    }
                                                    @if (isVibration)
                                                    {
                                                        var VibA = vibration.Where(x => x.Title.ToLower().Contains("Vibration A".ToLower())).ToList();
                                                        var VibB = vibration.Where(x => x.Title.ToLower().Contains("Vibration B".ToLower())).ToList();
                                                        int a = 1;
                                                        int b = 1;
                                                        <td id="vibrationA@(item.Id)">

                                                            @foreach (var assetAttribute in VibA)
                                                            {
                                                                if (VibA.Count == a)
                                                                {
                                                                    <span id="hdnAttributeData@(assetAttribute.Id)@(item.Id)">
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span id="hdnAttributeData@(assetAttribute.Id)@(item.Id)">
                                                                    </span><span> | </span>
                                                                }
                                                                a++;
                                                            }

                                                        </td>
                                                        <td id="vibrationB@(item.Id)">
                                                            @foreach (var assetAttribute in VibB)
                                                            {
                                                                if (VibB.Count == b)
                                                                {
                                                                    <span id="hdnAttributeData@(assetAttribute.Id)@(item.Id)">
                                                                    </span>
                                                                }
                                                                else
                                                                {
                                                                    <span id="hdnAttributeData@(assetAttribute.Id)@(item.Id)">
                                                                    </span><span> | </span>
                                                                }
                                                                b++;
                                                            }
                                                        </td>
                                                    }
                                                    <td>
                                                        <a href="javascript:void(0)" onclick="fnShowPMExtraColumn(this, '@item.Id'); return false;">See more columns</a>
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="table-responsive width100p tblAssetData m-b-20" style="overflow:auto;max-height:420px;">

                                        <table class="table table-bordered table-striped" id="tblPoint@(item.Id)">
                                            <thead>
                                                <tr>
                                                    <th>Date</th>
                                                    <th>Name</th>
                                                    <th>Direction</th>
                                                    @if (item.IsSeriesOpration != null && item.IsSeriesOpration.Value)
                                                    {
                                                        <th>New Combine<br /><a href="javascript:void(0)" title="Normal Current" onclick="fnBindMultipleSignatureEventGragh('@item.Id', 'Normal', 'C');return false;">NC</a> | <a href="javascript:void(0)" onclick="fnBindMultipleSignatureEventGragh('@item.Id', 'Normal', 'V');return false;" title="Normal Voltage">NV</a> | <a href="javascript:void(0)" onclick="fnBindMultipleSignatureEventGragh('@item.Id','Reverse','C');return false;" title="Reverse Current">RC</a> | <a href="javascript:void(0)" onclick="fnBindMultipleSignatureEventGragh('@item.Id','Reverse','V');return false;" title="Reverse Voltage">RV</a></th>

                                                        <th>Combine <br /> <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id', 'Normal', 'CC');return false;">N</a> | <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Reverse','CC');return false;">R</a></th>
                                                    }

                                                    @if (item.IsHalfPointMachine == null || (item.IsHalfPointMachine != null && !item.IsHalfPointMachine.Value))
                                                    {

                                                        <th>A Current(Max/Avg) <br /><a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id', 'Normal', 'AC');return false;">N</a> | <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Reverse','AC');return false;">R</a> | <a title="Normal Presentation" href="javascript:void(0)" onclick="fnShowPointmachineGif('@item.Id','Normal','AC');return false;">NP</a> | <a title="Reverse Presentation" href="javascript:void(0)" onclick="fnShowPointmachineGif('@item.Id','Reverse','AC');return false;">RP</a> | <a href="javascript:void(0)" title="Normal Current Graph" onclick="fnShowPMNormalCurrentGraph('@item.Id','AC');return false;">N-CG</a> | <a href="javascript:void(0)" title="Reverse Current Graph" onclick="fnShowPMReverseCurrentGraph('@item.Id','AC');return false;">R-CG</a></th>
                                                        <th>A Voltage <br /><a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Normal','AV');return false;">N</a> | <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Reverse','AV');return false;">R</a></th>
                                                        <th>A Time (ms)</th>
                                                    }
                                                    else
                                                    {
                                                        <th>Current(Max/Avg) <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id', 'Normal', 'AC');return false;">N</a> | <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Reverse','AC');return false;">R</a> | <a href="javascript:void(0)" onclick="fnShowPointmachineGif('@item.Id','Normal','AC');return false;">NP</a> | <a href="javascript:void(0)" onclick="fnShowPointmachineGif('@item.Id','Reverse','AC');return false;">RP</a> | <a href="javascript:void(0)" title="Normal Current Graph" onclick="fnShowPMNormalCurrentGraph('@item.Id','AC');return false;">N-CG</a> | <a href="javascript:void(0)" title="Reverse Current Graph" onclick="fnShowPMReverseCurrentGraph('@item.Id','AC');return false;">R-CG</a></th>
                                                        <th>Voltage</th>
                                                        <th>Time (ms)</th>
                                                    }


                                                    @if (item.IsHalfPointMachine == null || (item.IsHalfPointMachine != null && !item.IsHalfPointMachine.Value))
                                                    {
                                                        <th>B Current(Max/Avg) <br /><a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Normal','BC');return false;">N</a> | <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Reverse','BC');return false;">R</a> | <a href="javascript:void(0)" title="Normal Current Graph" onclick="fnShowPMNormalCurrentGraph('@item.Id','BC');return false;">N-CG</a> | <a href="javascript:void(0)" title="Reverse Current Graph" onclick="fnShowPMReverseCurrentGraph('@item.Id','AC');return false;">R-CG</a></th>
                                                        <th>B Voltage <br /><a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Normal','BV');return false;">N</a> | <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Reverse','BV');return false;">R</a></th>
                                                        <th>B Time (ms)</th>

                                                    }

                                                    @if (item.IsHalfPointMachine == null || (item.IsHalfPointMachine != null && !item.IsHalfPointMachine.Value))
                                                    {

                                                        <th class="PMExtraColumn_@item.Id display-none" width="120">Cluster A</th>
                                                        <th class="PMExtraColumn_@item.Id display-none">Deviation A</th>
                                                    }
                                                    else
                                                    {
                                                        <th class="PMExtraColumn_@item.Id display-none" width="120">Cluster</th>
                                                        <th class="PMExtraColumn_@item.Id display-none">Deviation</th>
                                                    }

                                                    @if (item.IsHalfPointMachine == null || (item.IsHalfPointMachine != null && !item.IsHalfPointMachine.Value))
                                                    {
                                                        <th class="PMExtraColumn_@item.Id display-none" width="120">Cluster B</th>
                                                        <th class="PMExtraColumn_@item.Id display-none">Deviation B</th>
                                                    }


                                                </tr>
                                            </thead>
                                            <tbody class="fbody@(item.Id)">
                                                @Html.Partial("_PointMachineDatePartial", item)
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p style="font-size:15px">No record found!</p>
        }



    </div>
</div>
@{
