                        html = "<div class='row'><div class='col-md-4'><span class='badge  badge-warning'>REVERSE</span></div>";
                    }
                    else if (parseFloat(aDisplacement1) >= 110) {
                        html = "<div class='row'><div class='col-md-4'> <span class='badge  badge-success'>NORMAL</span></div>";
                    }
                    else if (parseFloat(aDisplacement1) > 6 && parseFloat(aDisplacement1) < 110) {
                        html = "<div class='row'><div class='col-md-4'><span class='badge  badge-danger'>Point Not Set</span></div>";
