                                    bERL = v;
                                }

                                if (item.ISDisplacement != null && item.ISDisplacement == true) {
                                    if (inItem.Title == "Displacement1") {
                                        var disMainData = parseFloat(dataValue) * 1;
                                        aDisplacement1 = (parseFloat(infoMultiplication) - disMainData).toFixed(2);
                                    }
                                    if (inItem.Title == "Displacement2") {
                                        var disMainData = parseFloat(dataValue) * 1;
                                        aDisplacement2 = (parseFloat(infoMultiplication) - disMainData).toFixed(2);
                                    }
                                }
                                if (inItem.Title == "Vibration A end - X Axis") {
                                    var vibData = parseFloat(dataValue) * 1;
                                    $(id).html((vibData - parseFloat(infoMultiplication)).toFixed(2));
                                }
                                if (inItem.Title == "Vibration A end - Y Axis") {
                                    var vibData = parseFloat(dataValue) * 1;
                                    $(id).html((vibData - parseFloat(infoMultiplication)).toFixed(2));
                                }
                                if (inItem.Title == "Vibration A end - Z Axis") {
                                    var vibData = parseFloat(dataValue) * 1;
                                    $(id).html((vibData - parseFloat(infoMultiplication)).toFixed(2));
                                }
