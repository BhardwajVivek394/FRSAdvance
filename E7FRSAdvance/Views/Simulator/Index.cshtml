<div id="divPointFunction"></div>
<div id="divAlertFunction"></div>
<script>
    $(document).ready(function () {

        if ($('#hdnCatListType').val() == 'Success') {
            CommonNotification($("#hdnCatListType").val().toUpperCase(), $("#hdnCatListMessage").val(), $("#hdnCatListType").val());
        }
        else if ($('#hdnCatListType').val() == 'Error') {
            if ($('#hdnCatListMessage').val() == 'Forbidden!') {
                window.location.href = "/Login/Index";
            } else {
                CommonNotification($("#hdnCatListType").val().toUpperCase(), $("#hdnCatListMessage").val(), $("#hdnCatListType").val());
            }
        }
        //$("#frmAssetDetails").submit();
        $("#btn-download").click(function () {
            var canvas = $("#basicflot").get(0);
            var dataURL = canvas.toDataURL('image/jpeg');
            $("#btn-download").attr("href", dataURL);
        });
        $('#txtRange').daterangepicker();
        $('#txtRange').on('apply.daterangepicker', function (ev, picker) {
            $(this).val(picker.startDate.format('MM/DD/YYYY') + ' - ' + picker.endDate.format('MM/DD/YYYY'));
            $('#tpFrom').val('00:00');
            $("#tpTo").val('23:59');
            fnCustomerDateRangeValue(picker.startDate.format('MM/DD/YYYY'), picker.endDate.format('MM/DD/YYYY'));
        });

        $('#txtRange').on('cancel.daterangepicker', function (ev, picker) {
            $(this).val('');
            $("#sd").val('');
            $("#ed").val('');
        });


        $('#tpFrom').clockpicker({
            placement: 'bottom',
            align: 'right',
            autoclose: true,
            'default': '00:00'
        });

        $('#tpFrom').change(function () {

            if ($('#tpFrom').val() != "" && $('#tpFrom').val() != null && $('#tpTo').val() != "" && $('#tpTo').val() != null) {
                fnChange();
                //$(".applyBtn").removeAttr("disabled")
                //$(".applyBtn").click();
            }
        });

        $('#tpTo').clockpicker({
            placement: 'bottom',
            align: 'right',
            autoclose: true,
            'default': '00:00'
        });

        $('#tpTo').change(function () {
            if ($('#tpFrom').val() != "" && $('#tpFrom').val() != null && $('#tpTo').val() != "" && $('#tpTo').val() != null) {
                fnChange();
                //$(".applyBtn").removeAttr("disabled")
                //$(".applyBtn").click();
            }
        });

        SearchAsset()
    });

    function SearchAsset() {
        if (this.client && this.client.isConnected()) {
            try {
                this.client.disconnect();
            } catch (err) {
            }
        }
        $("#hdnSkip").val('0');
        $(".asset-search").val("");
        $("#frmAssetDetails").submit();
    }
</script>
