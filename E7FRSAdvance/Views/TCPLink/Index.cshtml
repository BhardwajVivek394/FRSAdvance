
@{
    ViewBag.Title = "TCP Link";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">TCP Link</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div>

    @using (Ajax.BeginForm("_List", "TCPLink", new AjaxOptions()
    {
        HttpMethod = "POST",
        UpdateTargetId = "divTCPLink",
        InsertionMode = InsertionMode.Replace,
        LoadingElementId = "loader",
    }, new { id = "frmTCPLink" }))
    {
        <div id="divTCPLink">
            @Html.Action("_List")

        </div>
    }
</div>

