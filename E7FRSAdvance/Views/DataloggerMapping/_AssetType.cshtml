@model Domain.RailwayAsset

@if (Model != null && Model.info != null && Model.info.Count > 0)
{
    var dsdsd = Model.info.GroupBy(x => x.smms_asset_number).Select(x => x.Key).ToList();

    var groupedInfo = Model.info
           .GroupBy(i => i.additional_info
               .FirstOrDefault(ai => ai.key == "menulabel").value);

    foreach (var item in groupedInfo)
    {
        @*<div class="btn-group mr5" style="margin:5px">
            <button type="button"  class="btn btn-dark">@item.Name</button>
        </div>*@

        <div class="btn-group mr5" style="margin:5px">
            <button type="button" onclick="fnBindDataloggerForMapping('@item.Key')" class="btn btn-dark">@item.Key</button>
        </div>
    }
}
