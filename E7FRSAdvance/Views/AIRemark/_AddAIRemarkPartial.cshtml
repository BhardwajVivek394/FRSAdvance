@model Domain.AIRemark

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

@Html.HiddenFor(m => m.Id)
<div class="modal fade" id="modal-add-AIRemark" role="dialog" aria-labelledby="modal-add-AIRemark" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Remark</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Edit Remark</span></h4>
                }
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="mb-3">
                                <label class="form-label">Asset Type <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.DropDownListFor(m => m.AssetTypeId, (IEnumerable<SelectListItem>)ViewBag.AssetTypes, new { @class = "form-control", tabindex = 1 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Cluster <span class="text-danger">*</span></label>
                                <div class="">
                                    <select id="ClusterId" name="ClusterId" class="form-control">
                                        @for (int i = 1; i <= 50; i++)
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    </select>
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Remark <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => m.Remark, new { @class = "form-control", tabindex = 2 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()">Save</button>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/Content/PageJS/AIRemark/AddAIRemark.js")"></script>