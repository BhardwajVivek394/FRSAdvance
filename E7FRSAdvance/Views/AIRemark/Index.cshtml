@model Domain.AIRemarkLister
@{
    ViewBag.Title = "AIRemark";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Remark</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">
        @using (Ajax.BeginForm("AIRemarkList", "AIRemark", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divAIRemarkList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmGetAIRemarkList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divAIRemarkList">
                @Html.Action("AIRemarkList")
            </div>
        }

        @using (Ajax.BeginForm("SaveAIRemark", "AIRemark", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveAIRemark",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
        }, new { id = "frmSaveAIRemark" }))
        {
            <div id="divSaveAIRemark">
                @Html.Partial("_AddAIRemarkPartial", new Domain.AIRemark())
            </div>
        }
    </div>
</div>

