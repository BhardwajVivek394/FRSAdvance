        </div>
    </div>

</div>
<div class="modal bounceIn animated" id="modal-add-asset" tabindex="-1" role="dialog" data-bs-backdrop="static" aria-labelledby="modal-add-asset" style="overflow-y:hidden">
    <div class="modal-dialog  modal-lg">
        <div class="modal-content bradius4">

            <div class="modal-header">
                <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"></span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSaveAsset()">Save</button>
            </div>
        </div>
    </div>
</div>

