<div class="container-fluid">

    <input type="hidden" id="hdnId" value="0" />
    <input type="hidden" id="hdnassetTypeId" value="@ViewBag.AssetTypeId" />
    <input type="hidden" id="hdndlAssetTypeId" value="@ViewBag.DlAssetTypeId" />
    <button class="btn btn-success" onclick="SaveCircuitDiagramCreator()" id="save">Save</button>

    <div id="app" style="height:800px">
        <div class="app-header">
