@model Domain.AssetAttribute

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

@using System.ComponentModel.DataAnnotations;
@using System.Linq;
@using System.Reflection;


<div class="modal bounceIn animated" id="modal-add-attribute" tabindex="-1" aria-labelledby="modal-add-attribute" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content bradius4">
            @Html.HiddenFor(m => Model.Id, new { @id = "hdnAssetAttributeId" })
            @Html.HiddenFor(m => Model.AssetTypeId, new { @id = "hdnAssetTypeId1" })
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Asset Attribute / Info</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Edit Asset Attribute / Info</span></h4>
                }
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <input type="hidden" id="hdnalert" value="False" />

                    <!-- Title - Full Width -->
                    <div class="row">
                        <div class="col-md-12">
                            <div>
                                <label class="control-label">Title <span class="text-danger">*</span></label>
                                @Html.TextBoxFor(m => Model.Title, new { @class = "form-control", tabindex = 1 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Min and Max - Side by Side -->
                    <div class="row">
                        <div class="col-md-6">
                            <div>
                                <label class="control-label">Min</label>
                                @Html.TextBoxFor(m => Model.MinValue, new { @class = "form-control", tabindex = 2 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div>
                                <label class="control-label">Max</label>
                                @Html.TextBoxFor(m => Model.MaxValue, new { @class = "form-control", tabindex = 3 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Default Multiplication and Pannel Test Value - Side by Side -->
                    <div class="row">
                        <div class="col-md-6">
                            <div>
                                <label class="control-label">Default Multiplication</label>
                                @Html.TextBoxFor(m => Model.DefaultMultiplication, new { @class = "form-control", tabindex = 4, @type = "Number" })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div>
                                <label class="control-label">Pannel Test Value</label>
                                @Html.TextBoxFor(m => Model.PannelTestValue, new { @class = "form-control", tabindex = 5, @type = "Number" })
                            </div>
                        </div>
                    </div>

                    <!-- Min Threshold and Max Threshold - Side by Side (Hidden) -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3 min-th" style="display:none;">
                                <label class="control-label">Min Threshold</label>
                                @Html.TextBoxFor(m => Model.MinThreshold, new { @class = "form-control", tabindex = 6 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3 max-th" style="display:none;">
                                <label class="control-label">Max Threshold</label>
                                @Html.TextBoxFor(m => Model.MaxThreshold, new { @class = "form-control", tabindex = 7 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- ZeroOffset and Alias Name - Side by Side -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3 zero-th" style="display:none;">
                                <label class="control-label">ZeroOffset</label>
                                @Html.TextBoxFor(m => Model.ZeroOffset, new { @class = "form-control", tabindex = 8 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div>
                                <label class="control-label">Alias Name</label>
                                @Html.TextBoxFor(m => Model.AliasName, new { @class = "form-control", tabindex = 9 })
                            </div>
                        </div>
                    </div>

                    <!-- Sequence and Type - Side by Side -->
                    <div class="row">
                        <div class="col-md-6">
                            <div>
                                <label class="control-label">Sequence</label>
                                @Html.TextBoxFor(m => Model.Sequence, new { @class = "form-control", tabindex = 10, @type = "Number" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div>
                                <label class="control-label">Type</label>
                                @{
                                    var enumData = (from E7FRSAdvance.Utility.Utility.ValueType e in Enum.GetValues(typeof(E7FRSAdvance.Utility.Utility.ValueType))
                                                    select new
                                                    {
                                                        Id = (int)e,
                                                        Name = e.ToString().Replace("_", " ")
                                                    }).ToList();
                                }
                                <select class="form-control" id="drpValueType" onchange="GetSensorTypeById(this)">
                                    @if (enumData != null)
                                    {
                                        <option value="">Select</option>
                                        foreach (var item in enumData)
                                        {
                                            if (Model.ValueType != null && Model.ValueType.Value == item.Id)
                                            {
                                                <option value="@item.Id" selected>@item.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@item.Id">@item.Name</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Sensor Type and Attribute Type - Side by Side -->
                    <div class="row">
                        <div class="col-md-6">
                            <div>
                                <label class="control-label">Sensor Type</label>
                                <select class="form-control" id="drpSensorType">
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            @if (Model.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL)
                            {
                                <div>
                                    <label class="control-label">Attribute Type</label>
                                    @{
                                        var enumAttributeType = (from E7FRSAdvance.Utility.Utility.AttributeType e in Enum.GetValues(typeof(E7FRSAdvance.Utility.Utility.AttributeType))
                                                                 let displayAttr = e.GetType()
                                                                                     .GetField(e.ToString())
                                                                                     .GetCustomAttribute<DisplayAttribute>()
                                                                 select new
                                                                 {
                                                                     Id = (int)e,
                                                                     Name = e.ToString().Replace("_", " "),
                                                                     DisplayName = displayAttr.Name ?? e.ToString()
                                                                 }).ToList();
                                    }
                                    <select class="form-control" id="drpAttributeType">
                                        @if (enumAttributeType != null)
                                        {
                                            <option value="">Select</option>
                                            foreach (var item in enumAttributeType)
                                            {
                                                if (Model.Type != null && Model.Type.Value == item.Id)
                                                {
                                                    <option data-code="@item.DisplayName" value="@item.Id" selected>@item.Name</option>
                                                }
                                                else
                                                {
                                                    <option data-code="@item.DisplayName" value="@item.Id">@item.Name</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- FRS Attribute and FRS Unit - Side by Side -->
                    @{
                        var paramTypes = E7FRSAdvance.Utility.ExtensionMethod.BuildParamTypes();
                    }
                    <div class="row">
                        <div class="col-md-6">
                            <div>
                                <label class="control-label">FRS Attribute</label>
                                <select class="form-control" id="drpRepresentationCode">
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div>
                                <label class="control-label">FRS Unit</label>
                                <select class="form-control" id="drpParameterRepresentationCode">
                                    <option value="">Select</option>
                                    @if (paramTypes != null && paramTypes.Count > 0)
                                    {
                                        foreach (var paramType in paramTypes)
                                        {
                                            if (Model.ParameterRepresentationCode == paramType.Id)
                                            {
                                                <option value="@paramType.Id" selected>@paramType.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@paramType.Id">@paramType.Name</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- ZeroOffset and Alias Name - Side by Side -->
                    <div class="row">
                        <div class="col-md-6">
                            <div>
                                <label class="control-label">Mode</label>
                                @Html.TextBoxFor(m => Model.Mode, new { @class = "form-control", @id = "txtMode", @type = "Number", tabindex = 8 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div>
                                <label class="control-label">Threshold Value</label>
                                @Html.TextBoxFor(m => Model.ThresholdValue, new { @class = "form-control", @id = "txtThresholdValue", @type = "Number", tabindex = 9 })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div>
                                <label class="control-label">Absolute</label>
                                @Html.TextBoxFor(m => Model.Absolute, new { @class = "form-control", @id = "txtAbsolute", @type = "Number", tabindex = 8 })
                                <span class="text-danger"></span>
                            </div>
                        </div>

                    </div>

                    <!-- Is Digital and Is Derived - Side by Side -->
                    <div class="row">
                        <div class="col-md-6">
                            <div>
                                <label class="control-label"><span>Is Digital</span> @Html.CheckBox("IsDigital", new { style = "vertical-align:sub" })</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div>
                                <label class="control-label"><span>Is Derived</span> @Html.CheckBox("IsDerived", new { style = "vertical-align:sub" })</label>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSaveAttributes()">Save</button>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        GetSensorTypeById($('#drpValueType'), '@Model.SensorType');

        if ($('#drpAttributeType').val() != null && $('#drpAttributeType').val() != undefined && $('#drpAttributeType').val() != '') {
            GetFRSAttributeByType($('#drpAttributeType').find(":selected").data("code"));
        } else {
            GetFRSAttributeByType('@Model.AssetTypeRepresentationCode');
        }

        $('#drpAttributeType').change(function () {

            var code = $(this).find(":selected").data("code");
            if (code != null && code != undefined && code != '') {
                GetFRSAttributeByType(code);
            }
        });

    });

    function GetFRSAttributeByType(code) {
        if (code != null && code != undefined && code != '') {
            $("#loader").show();
            $.ajax({
                url: '/AssetType/GetFRSAttribute',
                type: 'POST',
                data: '{code:"' + code + '"}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpRepresentationCode").empty();
                    $("#drpRepresentationCode").append($("<option></option>").val('0').html('Select'));
                    $.each(data, function (key, value) {
                        $("#drpRepresentationCode").append($("<option></option>").val(value.Id).html(value.Name));
                    });

                    $("#drpRepresentationCode").val('@Model.RepresentationCode');
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }
</script>