@model Domain.AssetType

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-assetType" tabindex="-1" aria-labelledby="modal-add-assetType" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content bradius4">
            @Html.HiddenFor(m => Model.Id, new { @id = "hdnAssetTypeId" })
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Asset Type</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Edit Asset Type</span></h4>
                }
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true">×</button>

            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="">
                                <label class="control-label">Name <span class="text-danger">*</span></label>
                                <div class="mb-3">
                                    @Html.TextBoxFor(m => Model.Name, new { @class = "form-control", tabindex = 2 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mt10">
                                <label class="control-label">X <span class="text-danger">*</span></label>
                                <div class="mb-3">
                                    @Html.TextBox("X", Model.X, new { @class = "form-control", tabindex = 3 })
                                </div>
                            </div>
                            <div class="mt10">
                                <label class="control-label">Y <span class="text-danger">*</span></label>
                                <div class="mb-3">
                                    @Html.TextBox("Y", Model.Y, new { @class = "form-control", tabindex = 4 })
                                </div>
                            </div>
                            <div class="mt10" style="display:none">
                                <label class="control-label">Z <span class="text-danger">*</span></label>
                                <div class="mb-3">
                                    @Html.TextBox("Z", Model.Z, new { @class = "form-control", tabindex = 5 })
                                </div>
                            </div>
                            <div class="mt10">
                                <label class="control-label">FRS Asset Type</label>
                                <div class="mb-3">
                                    @Html.DropDownListFor(x => x.RepresentationCode, (IEnumerable<SelectListItem>)ViewBag.AssetType, "Select", new { @class = "form-control", tabindex = 6 })
                                </div>
                            </div>
                            <div class="mt10">
                                <div class="col-sm-3">
                                    <label class="control-label"><span>Is Active</span>  @Html.CheckBoxFor(m => Model.IsActive, new { style = "vertical-align:sub" })</label>
                                </div>
                            </div>
                            <div class="mt10">
                                <div class="col-sm-3">
                                    <label class="control-label"><span>Is ListView</span>  @Html.CheckBox("IsListView", Model.IsListView ?? false, new { style = "vertical-align:sub" })</label>
                                </div>
                            </div>
                            <div class="mt10">
                                <div class="col-sm-3">
                                    <label class="control-label"><span>Is Basic Alert</span>  @Html.CheckBox("IsBasicAlert", Model.IsBasicAlert ?? false, new { style = "vertical-align:sub" })</label>
                                </div>
                            </div>                             
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/PageJS/AssetType/AddAssetType.js"></script>