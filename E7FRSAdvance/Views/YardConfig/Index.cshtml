    function fnGetAssetAttribute(assetId, assetTypeId) {
        var siteName = $("#SiteId option:selected").text();
        $("#loader").show();
        $.ajax({
            url: '/AssetAttribute/_AssetAttributePartial',
            type: 'Post',
            data: '{siteName:"' + siteName + '",assetId:' + assetId + ',assetTypeId:' + assetTypeId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAssetAttributePartial").empty().append(data);
                $("#modal-assetLister").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("danger", "Something went wrong!");
            }
        });
    }

    function fnUpdateCardLine(id, $this) {
        $("#loader").show();
        var mCardLine = {};
        mCardLine.Id = id;

        if ($($this).val() == "ClusterValidation") {
            if ($($this).prop('checked') == true) {
                mCardLine.ClusterValidation = true;
            } else {
                mCardLine.ClusterValidation = false;
            }
        }

        if ($($this).val() == "JointCalibration") {
            if ($($this).prop('checked') == true) {
                mCardLine.JointCalibration = true;
            } else {
                mCardLine.JointCalibration = false;
            }
        }

        $.ajax({
            url: '/YardConfig/UpdateCardLine',
            type: 'Post',
            data: '{mCardLine:' + JSON.stringify(mCardLine) + '}',
            contentType: 'application/json',
            success: function (mCluster) {
                $("#loader").hide();

            },
            error: function (response) {
                $("#loader").hide();
            }
        });
    }

    function fnEditCardLineCircuit(id) {
        $("#loader").show();
        $.ajax({
            url: '/YardConfig/EditCardLineCircuit',
            type: 'Post',
            data: '{id:' + id + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divCardLineCircuitPartial").empty().append(data);
                $("#modal-add-cardline-circuit").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("danger", "Something went wrong!");
            }
        });
    }

    function fnUpdateCardLineCircuit(id, assetId) {
        var mCardLine = {};
        mCardLine.Id = id;
        mCardLine.AssetId = assetId;
        mCardLine.LocationName = $('#txtLocationName').val();
        mCardLine.RowNumber = $('#txtRowNumber').val();
        mCardLine.TerminalNumberPositive = $('#txtTerminalNumberPositive').val();
        mCardLine.TerminalNumberNegative = $('#txtTerminalNumberNegative').val();
        mCardLine.CurrentSequenceNumber = $('#txtCurrentSequenceNumber').val();

        if (ValidateCardLineCircuit()) {
            $("#loader").show();
            $.ajax({
                url: '/YardConfig/UpdateCardLineCircuit',
                type: 'Post',
                data: '{mCardLine:' + JSON.stringify(mCardLine) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $('#modal-add-cardline-circuit').modal('hide');
                    if (data != null && data != undefined) {
                        if (data.type == 'success') {
                            CommonNotification("SUCCESS", data.result, "success");
                        }
                        else if (data.type == 'error') {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $('#modal-add-cardline-circuit').modal('hide');
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }


    }

