    function fnShowUploadCertificateHTTP(clusterId) {
        $('#hdnCertificateHTTPClusterId').val(clusterId);
        $('#fileInputCertificateHTTP').val('');
        $('#modelUploadCertificateHTTP').modal('show');
    }

    function fnSaveCertificateHTTP($this) {
        if ($('#hdnCertificateHTTPClusterId').val() != null && $('#hdnCertificateHTTPClusterId').val() != undefined && $('#hdnCertificateHTTPClusterId').val() != '' && $('#hdnCertificateHTTPClusterId').val() != "0") {
            var fileUpload = $($this).get(0);
            var files = fileUpload.files;
            var fileData = new FormData();
            fileData.append("clusterId", $('#hdnCertificateHTTPClusterId').val());
            fileData.append(files[0].name, files[0]);
            $("#loader").show();

            $.ajax({
                url: "/YardConfig/UploadCertificateHTTP",
                type: "POST",
                contentType: false,
                processData: false,
                data: fileData,
                async: true,
                success: function (data) {

                    $("#loader").hide();
                    $("#modelUploadCertificateHTTP").modal('hide');
                    if (data != null && data != undefined) {
                        if (data.type == 'success') {
                            CommonNotification("SUCCESS", data.result, "success");
                        }
                        else if (data.type == 'error') {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (xhr, error, status) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "Error");
                }
            });
        }
        else {
            CommonNotification("ERROR", "Please select cluster", "Error");
        }
    }

    function DownloadWireguardServer(clusterId) {

        if ($("#SiteId").val() != null && $("#SiteId").val() != undefined && $("#SiteId").val() != '' && $("#SiteId").val() != '0') {
            window.location.href = "@Url.Action("DownloadWireguardServer")?siteId=" + $("#SiteId").val() + '&clusterId=' + clusterId;
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }
</script>