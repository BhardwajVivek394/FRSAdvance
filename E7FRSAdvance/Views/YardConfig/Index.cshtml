        //    $("#txtTerminalNumberNegative").next("span").html("Row Number Negative is required");
        //    result = false;
        //}
        //else {
        //    $("#txtTerminalNumberNegative").next("span").html("");
        //}

        //if ($.trim($("#txtTerminalNumberPositive").val()).length == 0) {
