
@{
    ViewBag.Title = "YardConfig";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/paho-mqtt.js"></script>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>


<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Yard Config</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="row">
                                <div class="col-lg-2">
                                    <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Sites</strong>
                                    @Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 1 })
                                </div>
                                <div class="col-lg-2">
                                    <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Type</strong>
                                    @Html.DropDownList("TypeId", new List<SelectListItem>
                                    {
                                    new SelectListItem{ Text="By Cluster", Value = "1" },
                                    new SelectListItem{ Text="By Asset", Value = "2" },
                                    }, new { @class = "form-control", tabindex = 2 })
                                </div>
                                <div class="col-lg-2" id="divAssetType" style="display:none">
                                    <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Asset Type</strong>
                                    <select id="AssetTypeId" class="form-control">
                                        <option value="0">Select Asset Type</option>
                                    </select>
                                </div>
                                <div class="col-lg-6">
                                    <button type="button" class="btn btn-success mt-4" onclick="fnSearchYardConfig()">Search</button>
                                    <button type="button" class="btn btn-success mt-4" onclick="fnDownloadYardConfig()">Download</button>
                                    <button type="button" class="btn btn-success mt-4" onclick="fnDownloadMisssingWebConfig()">Misssing Web Config</button>
                                    <button type="button" class="btn btn-success mt-4" onclick="fnDownloadMisssingClusterConfig()">Misssing Cluster Config</button>
                                    <button type="button" class="btn btn-success mt-4" onclick="fnDownloadMaterialPositioning()">Material Positioning</button>
                                    <button type="button" class="btn btn-success mt-4" onclick="DownloadMaterialPositioningSensorWise()">Material Positioning New</button>


                                    @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                                    {
                                        <a class="btn btn-success mt-4" href="@Url.Action("Create")">Create</a>
                                        <button type="button" class="btn btn-success mt-4" onclick="DownloadCertificateGenerator()">Certificate</button>
                                    }
                                </div>

                            </div>

                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-12">
                            <div id="divYardConfig">
                            </div>

                            <div id="divYardConfigByAsset">
                            </div>
                        </div>
                    </div>
                    <div id="divAssetAttributePartial">
                        @*@Html.Partial("_AssetAttributePartial", new Domain.AssetLister())*@
                    </div>
                </div>

            </div>

        </div>
    </div>

</div>

@using (Ajax.BeginForm("SaveZone", "Zone", new AjaxOptions()
{
    HttpMethod = "POST",
    UpdateTargetId = "divCardLineCircuitPartial",
    InsertionMode = InsertionMode.Replace,
    LoadingElementId = "loader"
}, new { id = "frmSaveZone" }))
{
    <div id="divCardLineCircuitPartial">
    </div>
}

<div class="modal bounceIn animated" id="modelUploadCertificateHTTP" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modalConfirm-dialog">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader">Upload Certificate HTTP</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-2">
                        File
                    </div>
                    <div class="col-12">
                        <input type="hidden" id="hdnCertificateHTTPClusterId"/>
                        <input type="file" id="fileInputCertificateHTTP" class="form-control" accept=".txt" onchange="fnSaveCertificateHTTP(this)" />
                    </div>
                </div>

            </div>
            @*<div class="modal-footer">
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSaveCertificateHTTP()">Save</button>
            </div>*@
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#SiteId").change(function () {
            if ($("#TypeId").val() == 2) {
                BindAssetType();
            }
        });


        $("#TypeId").change(function () {
            if ($(this).val() == 1) {
                $("#AssetTypeId").empty();
                $("#divAssetType").hide();
            }
            else if ($(this).val() == 2) {
                BindAssetType();
                $("#divAssetType").show();
            }
        });
    });

    function BindAssetType() {
        if ($("#SiteId").val() != null && $("#SiteId").val() != undefined && $("#SiteId").val() != '' && $("#SiteId").val() != '0') {
            $("#loader").show();
            $.ajax({
                url: '/YardConfig/GetAssetTypeBySiteId',
                type: 'POST',
                data: '{siteId:' + $("#SiteId").val() + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#AssetTypeId").empty();
                    $("#AssetTypeId").append($("<option></option>").val('0').html('Select Asset Type'));
                    $.each(data, function (key, value) {
                        $("#AssetTypeId").append($("<option></option>").val(value.Id).html(value.Name));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }

    }

    function fnSearchYardConfig() {
        if ($("#SiteId").val() != null && $("#SiteId").val() != undefined && $("#SiteId").val() != '' && $("#SiteId").val() != '0') {

            if ($("#TypeId").val() == 1) {
                $("#loader").show();
                $.ajax({
                    url: '/YardConfig/GetYardConfig',
                    type: 'POST',
                    data: '{siteId:' + $('#SiteId').val() + '}',
                    contentType: 'application/json',
                    success: function (data) {
                        $("#loader").hide();
                        $("#divYardConfigByAsset").empty();
                        $("#divYardConfig").empty().append(data);
                    },
                    error: function (response) {
                        $("#loader").hide();
                        CommonNotification("ERROR", "Something went wrong!", "Error");
                    }
                });
            } if ($("#TypeId").val() == 2) {
                if ($("#AssetTypeId").val() != null && $("#AssetTypeId").val() != undefined && $("#AssetTypeId").val() != '' && $("#AssetTypeId").val() != '0') {
                    $("#loader").show();
                    $.ajax({
                        url: '/YardConfig/GetYardConfigByAssetType',
                        type: 'POST',
                        data: '{siteId:' + $('#SiteId').val() + ',assetTypeId:' + $('#AssetTypeId').val() + '}',
                        contentType: 'application/json',
                        success: function (data) {
                            $("#loader").hide();
                            $("#divYardConfig").empty();
                            $("#divYardConfigByAsset").empty().append(data);
                        },
                        error: function (response) {
                            $("#loader").hide();
                            CommonNotification("ERROR", "Something went wrong!", "Error");
                        }
                    });
                }
                else {
                    CommonNotification("ERROR", "Please select Asset Type", "Error");
                }
            }

        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }

    }

    function fnGetByClusterName(clusterId, $this) {
        if (clusterId != null && clusterId != undefined && clusterId != '') {
            if ($($this).hasClass("fa-plus")) {
                $($this).removeClass("fa-plus").addClass("fa-minus");
                $('.trCluster_' + clusterId).show();
            }
            else {
                $($this).removeClass("fa-minus").addClass("fa-plus");
                $('.trCluster_' + clusterId).hide();
            }
        }
    }

    function fnGetByAssetName(assetId, $this) {
        if (assetId != null && assetId != undefined && assetId != '') {
            if ($($this).hasClass("fa-plus")) {
                $($this).removeClass("fa-plus").addClass("fa-minus");
                $('.trAsset_' + assetId).show();
            }
            else {
                $($this).removeClass("fa-minus").addClass("fa-plus");
                $('.trAsset_' + assetId).hide();
            }
        }
    }

    function fnDownloadYardConfig() {
        if ($("#SiteId").val() != null && $("#SiteId").val() != undefined && $("#SiteId").val() != '' && $("#SiteId").val() != '0') {
            if ($("#TypeId").val() == 1) {
                window.location.href = "@Url.Action("DownloadYardConfig")?siteId=" + $("#SiteId").val();
            }
            if ($("#TypeId").val() == 2) {
                if ($("#AssetTypeId").val() != null && $("#AssetTypeId").val() != undefined && $("#AssetTypeId").val() != '' && $("#AssetTypeId").val() != '0') {
                    window.location.href = "@Url.Action("DownloadYardConfigByAssetType")?siteId=" + $("#SiteId").val() + "&assetTypeId=" + $("#AssetTypeId").val();
                } else {
                    CommonNotification("ERROR", "Please select Asset Type", "Error");
                }
            }
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

