@model List<Domain.CardLine>



@if (Model != null && Model.Count > 0)
{
    var assetGroup = Model.GroupBy(x => x.AssetId).ToList();

    <div class="card-body">
        <div class="table-responsive vh-100">
            <table class="table">
                <thead class="bg-primary">
                    <tr>
                        <th></th>
                        <th>Asset Name</th>
                    </tr>
                </thead>
                @foreach (var asset in assetGroup)
                {
                    var attributeNameGroup = Model.Where(x => x.AttributeName != null).GroupBy(x => x.AttributeName).ToList();
                    <tbody>
                        <tr>
                            <td><i class="fa fa-plus" onclick="fnGetByAssetName('@asset.FirstOrDefault().AssetId',this)"></i></td>
                            <td class="font-weight-bold">
                                <a href="#" onclick="fnGetAssetAttribute('@asset.FirstOrDefault().AssetId','@asset.FirstOrDefault().AssetTypeId')"> @asset.FirstOrDefault().AssetName</a>
                            </td>
                        </tr>
                        <tr style="display:none" class="trAsset_@asset.FirstOrDefault().AssetId">
                            <td colspan="2">
                                <table class="table">
                                    <thead class="bg-primary">
                                        <tr>
                                            <th></th>
                                            @foreach (var attributeName in attributeNameGroup)
                                            {
                                                <th>@attributeName.Key</th>
                                            }
                                        </tr>

                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><b>Cluster</b></td>
                                            @foreach (var attributeName in attributeNameGroup)
                                            {
                                                foreach (var item in Model.Where(x => x.AssetId == asset.Key && x.AttributeName != null && x.AttributeName.Trim().ToUpper() == attributeName.Key.Trim().ToUpper()))
                                                {
                                                    <td>@item.ClusterName</td>
                                                }
                                                if (Model.Where(x => x.AssetId == asset.Key && x.AttributeName != null && x.AttributeName.Trim().ToUpper() == attributeName.Key.Trim().ToUpper()).Count() <= 0)
                                                {
                                                    <td></td>
                                                }
                                            }
                                        </tr>

                                        <tr>
                                            <td><b>Card</b></td>
                                            @foreach (var attributeName in attributeNameGroup)
                                            {
                                                foreach (var item in Model.Where(x => x.AssetId == asset.Key && x.AttributeName != null && x.AttributeName.Trim().ToUpper() == attributeName.Key.Trim().ToUpper()))
                                                {
                                                    <td>@item.CardName (@item.Number)</td>
                                                }
                                                if (Model.Where(x => x.AssetId == asset.Key && x.AttributeName != null && x.AttributeName.Trim().ToUpper() == attributeName.Key.Trim().ToUpper()).Count() <= 0)
                                                {
                                                    <td></td>
                                                }
                                            }
                                        </tr>
                                        <tr>
                                            <td><b>ADC</b></td>
                                            @foreach (var attributeName in attributeNameGroup)
                                            {
                                                foreach (var item in Model.Where(x => x.AssetId == asset.Key && x.AttributeName != null && x.AttributeName.Trim().ToUpper() == attributeName.Key.Trim().ToUpper()))
                                                {
                                                    <td>
                                                        ADC @item.SequenceNumber<br />
                                                        (@item.ADCNumber)
                                                    </td>
                                                }
                                                if (Model.Where(x => x.AssetId == asset.Key && x.AttributeName != null && x.AttributeName.Trim().ToUpper() == attributeName.Key.Trim().ToUpper()).Count() <= 0)
                                                {
                                                    <td></td>
                                                }
                                            }
                                        </tr>
                                        <tr>
                                            <td><b>Pin</b></td>
                                            @foreach (var attributeName in attributeNameGroup)
                                            {
                                                foreach (var item in Model.Where(x => x.AssetId == asset.Key && x.AttributeName != null && x.AttributeName.Trim().ToUpper() == attributeName.Key.Trim().ToUpper()))
                                                {
                                                    <td>
                                                        @item.Pin
                                                    </td>

                                                }
                                                if (Model.Where(x => x.AssetId == asset.Key && x.AttributeName != null && x.AttributeName.Trim().ToUpper() == attributeName.Key.Trim().ToUpper()).Count() <= 0)
                                                {
                                                    <td></td>
                                                }
                                            }
                                        </tr>
                                        <tr>
                                            <td><b>Role</b></td>
                                            @foreach (var attributeName in attributeNameGroup)
                                            {
                                                foreach (var item in Model.Where(x => x.AssetId == asset.Key && x.AttributeName != null && x.AttributeName.Trim().ToUpper() == attributeName.Key.Trim().ToUpper()))
                                                {
                                                    <td>
                                                        @item.Role
                                                    </td>

                                                }
                                                if (Model.Where(x => x.AssetId == asset.Key && x.AttributeName != null && x.AttributeName.Trim().ToUpper() == attributeName.Key.Trim().ToUpper()).Count() <= 0)
                                                {
                                                    <td></td>
                                                }
                                            }
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>

                    </tbody>



                }
            </table>

        </div>
    </div>
}

