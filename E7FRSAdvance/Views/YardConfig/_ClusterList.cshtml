@model List<Domain.Cluster>



<div class="table-responsive vh-100">
    <table class="table">
        <thead class="bg-primary">
            <tr>
                <th>Name</th>
                <th colspan="3" class="text-center">Action</th>

            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    <tr class="table-light">

                        <td>@item.Name</td>
                        <td class="text-center" style="width:50px;">
                            <a title="Edit Cluster">
                                <i class="text-vision fa fa-edit" onclick="fnEditCluster('@item.Id')"></i>
                            </a>
                        </td>
                        <td class="text-center" style="width:50px;">
                            <a title="Edit Card">
                                <i class="text-vision fa fa-id-card-o" onclick="fnEditCard('@item.Id')"></i>
                            </a>
                        </td>
                        <td class="text-center " style="width:50px;">
                            <a title="Delete">
                                <i class="text-danger fa fa-trash" onclick="fnDeleteCluster('@item.Id')"></i>
                            </a>

                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">
                        No record found
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
