@model List<Domain.CardLine>

@{
    int counter = 0;
}
<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />
<style>
    .card-header-cardline {
        background-color: #0e2b42 !important;
        padding-top: 10px !important;
        padding-bottom: 3px !important;
        padding-left: 30px !important;
        color: white !important;
        text-align: center;
        font-size: x-large;
        border-radius: 15px;
    }

    .card-body-cardline {
        /* padding: 15px !important;*/
        background-color: whitesmoke !important;
        border-bottom-left-radius: 15px;
        border-bottom-right-radius: 15px;
    }

    .card-border {
        border: 1px solid #0e2b42;
    }

    .drpclAssetType {
        height: 52px !important;
    }
    .drpclAsset {
        height: 52px !important;
    }
    .drpclAssetAttribute {
        height: 52px !important;
    }
    .drpclpin {
        height: 52px !important;
    }
    .drpcladc {
        height: 52px !important;
    }
</style>
<input type="hidden" id="clCardId" value="@ViewBag.cardId" />
<div class="modal bounceIn animated" id="modal-add-cardline" tabindex="-1" aria-labelledby="modal-add-cardline" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> @ViewBag.cardName</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">
                    @if (Model != null)
                    {

                        foreach (var item in Model)
                        {
                            counter++;
                            <input type="hidden" id="clCardLineId_@counter" value="@item.Id" /><div class="col-md-12">
                                <div class="card card-border">
                                    <div class="card-header card-header-cardline">@counter</div>
                                    <div class="card-body card-body-cardline">
                                        <div class="row">
                                            <div class="col-md-6 mt-1">
                                                <label>Asset Type</label>
                                                <select class="form-control drpclAssetType" data-id="@counter" id="drpAssetType_@counter">
                                                    <option>Select</option>
                                                    @if (item.AssetTypes != null && item.AssetTypes.Count > 0)
                                                    {
                                                        foreach (var assetType in item.AssetTypes)
                                                        {
                                                            if (item.AssetTypeId == assetType.Id)
                                                            {
                                                                <option value="@assetType.Id" selected>@assetType.Name</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@assetType.Id">@assetType.Name</option>
                                                            }
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-6 mt-2">
                                                <label>Asset</label>
                                                <select class="form-control drpclAsset" id="drpAsset_@counter">
                                                    <option>Select</option>
                                                    @if (item.Assets != null && item.Assets.Count > 0)
                                                    {
                                                        foreach (var asset in item.Assets)
                                                        {
                                                            if (item.AssetId != null && item.AssetId == asset.Id)
                                                            {
                                                                <option value="@asset.Id" selected>@asset.Name</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@asset.Id">@asset.Name</option>
                                                            }
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-6 mt-2">
                                                <label>Asset Attribute</label>
                                                <select class="form-control drpclAssetAttribute" id="drpAssetAttribute_@counter">
                                                    <option>Select</option>
                                                    @if (item.AssetAttributes != null && item.AssetAttributes.Count > 0)
                                                    {
                                                        foreach (var attribute in item.AssetAttributes)
                                                        {
                                                            if (item.AttributeId != null && item.AttributeId == attribute.Id)
                                                            {
                                                                <option value="@attribute.Id" selected>@attribute.Title</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@attribute.Id">@attribute.Title</option>
                                                            }
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-6 mt-2">
                                                <label>Pin</label>
                                                <select class="form-control drpclpin" id="drpPin_@counter">
                                                    <option>Select</option>
                                                    @for (int i = 1; i <= 10; i++)
                                                    {
                                                        if (item.Pin != null && item.Pin == i)
                                                        {
                                                            <option value="@i" selected>@i</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@i">@i</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-6 mt-2">
                                                <label>ADC</label>
                                                <select class="form-control drpcladc" id="drpADC_@counter">
                                                    <option>Select</option>
                                                    @if (item.mADCs != null && item.mADCs.Count > 0)
                                                    {
                                                        foreach (var mADC in item.mADCs)
                                                        {
                                                            if (item.ADCId != null && item.ADCId == mADC.Id)
                                                            {
                                                                <option value="@mADC.Id" selected>ADC@(mADC.SequenceNumber) (@mADC.ADCNumber)</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="@mADC.Id">ADC@(mADC.SequenceNumber) @mADC.ADCNumber</option>
                                                            }
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-6 pt-5">
                                               <a onclick="fnResetCardLine('@counter')" title="Reset"><i class="fa fa-refresh f-20"></i></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        }
                    }
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-info ls-1-2" onclick="fnResetAllCardLine()">Reset All</button>
                <button type="button" class="btn btn-primary ls-1-2" onclick="CreateCardLine()">Save</button>
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close" id="btnClose">Close</a>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('.drpclAsset').each(function () {
            $(this).select2({
                dropdownParent: $(this).parent(),
            });
        });

        $('.drpclAssetType').change(function () {
            var counterId = $(this).data("id");
            var assetTypeId = $(this).val();

            //Bind Asset
            if (counterId != null && counterId != undefined && counterId != '' && assetTypeId != null && assetTypeId != undefined && assetTypeId != '') {
                $("#loader").show();
                $.ajax({
                    url: '/YardConfig/GetAllAssest',
                    type: 'Post',
                    data: '{siteId:' + $("#drpSiteId").val() + ',assetTypeId:' + assetTypeId + '}',
                    contentType: 'application/json',
                    success: function (data) {
                        $("#loader").hide();
                        if (data != null && data.length > 0) {
                            var html = "";
                            html += "<option>Select</option>";
                            $.each(data, function (id, val) {
                                html += "<option value=" + val.Id + ">" + val.Name + "</option>";
                            });
                            $("#drpAsset_" + counterId).empty().append(html);
                        }
                    },
                    error: function (response) {
                        $("#loader").hide();
                        CommonNotification("ERROR", "Something went wrong!", "Error");
                    }
                });
            }


            //Bind AssetAttribute
            if (counterId != null && counterId != undefined && counterId != '' && assetTypeId != null && assetTypeId != undefined && assetTypeId != '') {
                $("#loader").show();
                $.ajax({
                    url: '/YardConfig/GetAssetAttribute',
                    type: 'Post',
                    data: '{assetTypeId:' + assetTypeId + '}',
                    contentType: 'application/json',
                    success: function (data) {
                        $("#loader").hide();
                        if (data != null && data.length > 0) {
                            var html = "";
                            html += "<option>Select</option>";
                            $.each(data, function (id, val) {
                                html += "<option value=" + val.Id + ">" + val.Title + "</option>";
                            });
                            $("#drpAssetAttribute_" + counterId).empty().append(html);
                        }
                    },
                    error: function (response) {
                        $("#loader").hide();
                        CommonNotification("ERROR", "Something went wrong!", "Error");
                    }
                });
            }

        });
    });

    function CreateCardLine() {
        var mCardLines = [];
        var count = parseInt('@counter');
        for (var i = 1; i <= count; i++) {
            var assetTypeId = $("#drpAssetType_" + i).val();
            var assetId = $("#drpAsset_" + i).val();
            var attributeId = $("#drpAssetAttribute_" + i).val();
            var pin = $("#drpPin_" + i).val();
            var adcId = $("#drpADC_" + i).val();
            var mCardLine = {};
            mCardLine.Id = $("#clCardLineId_" + i).val();
            mCardLine.CardId = $("#clCardId").val();
            mCardLine.Number = i;
            mCardLine.AssetTypeId = assetTypeId;
            mCardLine.AssetId = assetId;
            mCardLine.AttributeId = attributeId;
            mCardLine.ADCId = adcId;
            mCardLine.Pin = pin;
            mCardLines.push(mCardLine);
        }
        if (mCardLines != null && mCardLines.length > 0) {

            $("#loader").show();
            $.ajax({
                url: '/YardConfig/CreateCardLine',
                type: 'Post',
                data: '{mCardLines:' + JSON.stringify(mCardLines) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data.type == "error") {
                        alert("Error:" + data.result);

                    } else {
                        alert('Card has been updated.');

                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function fnResetCardLine(i) {
        $("#drpAssetType_" + i).prop("selectedIndex", 0);

        $("#drpAsset_" + i).select2().prop("selectedIndex", 0).trigger('change');
        $("#drpAsset_" + i).find('option').not(':first').remove();

        $("#drpAssetAttribute_" + i).prop("selectedIndex", 0);
        $("#drpAssetAttribute_" + i).find('option').not(':first').remove();

        $("#drpPin_" + i).prop("selectedIndex", 0);
        $("#drpADC_" + i).prop("selectedIndex", 0);
    }


    function fnResetAllCardLine() {
        var count = parseInt('@counter');
        for (var i = 1; i <= count; i++) {
            $("#drpAssetType_" + i).prop("selectedIndex", 0);

            $("#drpAsset_" + i).select2().prop("selectedIndex", 0).trigger('change');
            $("#drpAsset_" + i).find('option').not(':first').remove();

            $("#drpAssetAttribute_" + i).prop("selectedIndex", 0);
            $("#drpAssetAttribute_" + i).find('option').not(':first').remove();

            $("#drpPin_" + i).prop("selectedIndex", 0);
            $("#drpADC_" + i).prop("selectedIndex", 0);
        }      
    }
</script>

