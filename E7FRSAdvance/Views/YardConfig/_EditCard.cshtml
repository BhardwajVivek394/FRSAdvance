@model List<Domain.Card>

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />


<div class="modal bounceIn animated" id="modal-add-card" tabindex="-1" aria-labelledby="modal-add-card" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> @ViewBag.ClusterName</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    @if (Model != null)
                    {
                        foreach (var item in Model)
                        {
                            <div class="col-2">
                                <button type="button" class="btn btn-primary ls-1-2 mt-2" id="btnSave" onclick="fnEditCardLine('@item.ClusterId','@item.Id','@item.CardName')">@item.CardName</button>
                            </div>
                        }
                        if (ViewBag.ADCs != null && ViewBag.ADCs.Count > 0)
                        {
                            foreach (var mADC in ViewBag.ADCs as List<Domain.ADC>)
                            {
                                <div class="col-2">
                                    <button type="button" class="btn btn-primary ls-1-2 mt-2" id="btnSave">ADC@(mADC.SequenceNumber) (@mADC.ADCNumber)</button>
                                </div>
                            }
                        }
                    }
                </div>

            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close" id="btnClose">Close</a>
            </div>
        </div>
    </div>
</div>

