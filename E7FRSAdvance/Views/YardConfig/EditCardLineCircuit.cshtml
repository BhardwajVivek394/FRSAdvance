@model Domain.CardLine

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-cardline-circuit" tabindex="-1" aria-labelledby="modal-add-cardline-circuit" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content bradius4">

            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Station Circuit</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            @Html.HiddenFor(x => x.Id)
                            <div class="row">
                                <label class="control-label col-4">Cluster Name: </label>
                                <div class="col-8">
                                    <b>@Model.ClusterName</b>
                                </div>
                            </div>
                            <div class="row">
                                <label class="control-label col-4">Asset Name: </label>
                                <div class="col-8">
                                    <b>@Model.AssetName</b>
                                </div>
                            </div>
                            <div class="row">
                                <label class="control-label col-4">Attribute Name: </label>
                                <div class="col-8">
                                    <b>@Model.AttributeName</b>
                                </div>
                            </div>
                            <div class="">
                                <label class="control-label">Location Name <span class="text-danger">*</span></label>
                                <div class="mb-3">
                                    @Html.TextBoxFor(m => m.LocationName, new { @class = "form-control", @id = "txtLocationName", tabindex = 1 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="">
                                <label class="control-label">Row Number</label>
                                <div class="mb-3">
                                    @Html.TextBoxFor(m => m.RowNumber, new { @class = "form-control", @id = "txtRowNumber", tabindex = 2 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            @if (Model.AttributeName.ToLower().Contains("ma") || (Model.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE && Model.AttributeName.ToLower().Contains("-c")))
                            {
                                <input type="hidden" value="" id="txtTerminalNumberNegative" />
                            }
                            else
                            {
                                <div class="">
                                    <label class="control-label">Terminal Number Negative</label>
                                    <div class="mb-3">
                                        @Html.TextBoxFor(m => m.TerminalNumberNegative, new { @class = "form-control", @id = "txtTerminalNumberNegative", @type = "number", tabindex = 3 })
                                        <span class="text-danger"></span>
                                    </div>
                                </div>
                            }

                            <div class="">
                                <label class="control-label">Terminal Number Positive</label>
                                <div class="mb-3">
                                    @Html.TextBoxFor(m => m.TerminalNumberPositive, new { @class = "form-control", @id = "txtTerminalNumberPositive", @type = "number", tabindex = 3 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            @if (Model.AttributeName.ToLower().Contains("ma") || (Model.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE && Model.AttributeName.ToLower().Contains("-c")))
                            {
                                <div class="">
                                    <label class="control-label">Current Sequence Number</label>
                                    <div class="mb-3">
                                        @Html.TextBoxFor(m => m.CurrentSequenceNumber, new { @class = "form-control", @id = "txtCurrentSequenceNumber", @type = "number", tabindex = 4 })
                                        <span class="text-danger"></span>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnUpdateCardLineCircuit('@Model.Id','@Model.AssetId')" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        if ($('#hdnSaveType').val() == 'Success') {

            CommonNotification($("#hdnSaveType").val().toUpperCase(), $("#hdnSaveMessage").val(), $("#hdnSaveType").val());

            $("[class*='modal-backdrop']").remove();
            $("#frmGetDataloggerAssetTypeList").submit();
            window.history.pushState('', '', "Index");
        }
        else if ($('#hdnSaveType').val() == 'Error') {
            CommonNotification($("#hdnSaveType").val().toUpperCase(), $("#hdnSaveMessage").val(), $("#hdnSaveType").val());

            $("[class*='modal-backdrop']").remove();
            window.history.pushState('', '', "Index");
        }
    });

    function fnSave() {
        if (Validate()) {
            $("#frmSaveDataloggerAssetType").submit();
        }
    }

    function Validate() {
        var result = true;

        if ($.trim($("#Name").val()).length == 0) {
            $("#Name").next("span").html("Name is required");
            result = false;
        }
        else {
            $("#Name").next("span").html("");
        }

        return result;
    }
</script>

