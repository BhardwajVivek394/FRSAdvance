@model Domain.CertificateLister


@Html.HiddenFor(m => m.SearchCriteria.ColumnName, new { id = "hdnColumnName" })
@Html.HiddenFor(m => m.SearchCriteria.SortDirection, new { id = "hdnSortDirection" })


<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />

<div class="container-fluid">
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <div class="people-options clearfix">
                        <div class="pull-left">
                            <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Site</strong>
                        </div>
                        <div class="pull-left">
                            @Html.DropDownListFor(m => m.SearchCriteria.SiteId, (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 1 })
                            @*@Html.DropDownList("PerformanceSiteId", (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 1 })*@
                        </div>
                        <div class="pull-left">
                            <a class="btn btn-success btn-quirk" onclick="fnSearch()" style="margin-left:10px;">Search</a>
                        </div>

                        <div class="btn-group pull-right people-pager">
                            @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
                            @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
                        </div>
                        <div class="btn-group pull-right people-pager">
                            <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left "></i></button>
                            <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>
                        </div>
                        @{
                            int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
                            if (Model.Certificates.Count == 0)
                            {
                                start = 0;
                            }
                            decimal end = Math.Floor(Model.Pager.TotalRecord);
                            if (Model.Pager.PageSize < Model.Pager.TotalRecord)
                            {
                                if (Model.Pager.PageSize == -1)
                                {
                                    end = Model.Pager.TotalRecord;
                                }
                                else
                                {
                                    end = Model.Pager.PageSize * Model.Pager.CurrentPage;
                                    if (end > Model.Pager.TotalRecord)
                                    {
                                        end = Model.Pager.TotalRecord;
                                    }
                                }
                            }
                        }
                        <span class="people-count pull-right" style="margin-top:10px;">Showing <strong>@start - @Math.Floor(end)</strong> of <strong>@Math.Floor(Model.Pager.TotalRecord)</strong> Asset Types</span>
                    </div>

                </div>
                <div class="card-body" style="padding:15px;">
                    <div class="table-responsive">
                        <table class="table">
                            <thead class="bg-primary">
                                <tr>
                                    <th class="sorting">Device</th>
                                    <th class="sorting">Certificate Type</th>
                                    <th class="sorting">CN</th>
                                    <th class="sorting">Status</th>
                                    <th class="sorting">Validity</th>
                                    <th class="sorting">Generated By</th>
                                    <th class="sorting">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Certificates.Count > 0)
                                {
                                    foreach (var item in Model.Certificates)
                                    {
                                        <tr class="table-light">
                                            <td>@item.DeviceId</td>
                                            <td>Custom CA</td>
                                            <td>@item.DeviceId</td>
                                            <td class="col-status">
                                                <div class="status active" title="Active">
                                                    <span class="icon" aria-hidden="true">
                                                        <!-- check icon -->
                                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="dot" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                                            <path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                                        </svg>
                                                    </span>
                                                    <span>Active</span>
                                                </div>
                                            </td>
                                            <td>@item.NotBefore.ToShortDateString() → @item.NotAfter.ToShortDateString()</td>
                                            <td>@item.GeneratedName</td>
                                            <td>
                                                <a class="btn btn-info" href="javascript:void(0)" onclick="fnShowAudit('@item.Id')">View Audit</a>
                                                <a class="btn btn-info" href="@Url.Action("CertificateDownload", new {certificateId = item.Id})">Download</a>
                                                <a class="btn btn-info" href="javascript:void(0)" onclick="fnRevokeCertificate('@item.Id')">Revoke</a>

                                            </td>
                                        </tr>
                                    }
                                }

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<script>
    function fnSearch() {
        $("#frmCertificateList").submit();
    }

    $(document).ready(function () {

        $('#drpPageSize').change(function (e) {
            $("#hdnSkip").val('0');
            $("#frmCertificateList").submit();
        });
    });

    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmCertificateList").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize) {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmCertificateList").submit();
            }
        }
    }
</script>

<script>
 
</script>
