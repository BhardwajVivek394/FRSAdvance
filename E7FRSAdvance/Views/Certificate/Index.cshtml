
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    .cn {
        color: #374151;
        font-weight: 500;
        font-size: 14px;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        font-size: 13px;
        color: #111827;
    }

        .status .icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            box-shadow: 0 0 0 4px rgba(0,0,0,0.00);
        }

        .status.active .icon {
            background: rgba(16,185,129,0.12);
        }

        .status.active .dot {
            color: var(--green);
        }

        .status.revoked .icon {
            background: rgba(239,68,68,0.08);
        }

        .status.revoked .dot {
            color: var(--red);
        }

        .status.expired .icon {
            background: rgba(156,163,175,0.06);
        }

        .status.expired .dot {
            color: var(--gray);
        }

    .validity {
        color: #374151;
        font-size: 13px;
        line-height: 1.3;
        white-space: pre-line;
    }

    .actions a {
        margin-right: 12px;
        text-decoration: none;
        color: #0f172a;
        font-weight: 500;
        font-size: 13px;
    }

         small helper: bracket style like screenshot 
        .actions a::before {
            content: "[";
            color: var(--muted);
            margin-right: 2px;
            font-weight: 400;
        }

        .actions a::after {
            content: "]";
            color: var(--muted);
            margin-left: 2px;
            font-weight: 400;
        }

    .hr {
        height: 1px;
        background: var(--line);
        margin: 18px 0 0;
        border-radius: 1px;
    }

  
</style>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Certificate</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">

        @using (Ajax.BeginForm("List", "Certificate", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divCertificateList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmCertificateList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divCertificateList">
                @Html.Action("List")
            </div>
        }

    </div>
</div>



<div id="divCertificateAudit">

</div>

<script>

    function fnShowAudit(id) {

        $("#loader").show();
        $.ajax({
            url: '/Certificate/_CertificateAudit',
            type: 'Post',
            contentType: 'application/json',
            data: '{certificateId:' + id + '}',
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divCertificateAudit").empty().append(data);
                $("#modal-add-certificate-audit").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnDownloadCertificate(id) {

        if ($('#drpRailwayDivision').val() != null && $('#drpRailwayDivision').val() != undefined && $('#drpRailwayDivision').val() != '' && $('#drpRailwayDivision').val() != '0') {

            window.location.href = "@Url.Action("DownloadRailwayReportPDF")?divisionId=" + $('#drpRailwayDivision').val() + "&siteId=" + $('#drpRailwaySite').val() + "&startdate=" + $("#searchRailwayFromDate").val() + "&endDate=" + $("#searchRailwayToDate").val();

        } else {
            CommonNotification("error", "Please select Divisions");
        }
    }
</script>