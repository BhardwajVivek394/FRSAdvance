@model List<Domain.CertificateAudit>


<div class="modal bounceIn animated" id="modal-add-certificate-audit" tabindex="-1" aria-labelledby="modal-add-certificate-audit" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader"> Certificate Audit</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <table class="table">
                        @if (Model != null)
                        {
                            <tr>
                                <th>Download By</th>
                                <th>Revoke By</th>
                                <th>Download Date</th>
                            </tr>
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.DownloadName</td>
                                    <td></td>
                                    <td>@item.DownloadAt</td>
                                </tr>
                            }
                        }

                    </table>

                </div>

            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
            </div>
        </div>
    </div>
</div>


