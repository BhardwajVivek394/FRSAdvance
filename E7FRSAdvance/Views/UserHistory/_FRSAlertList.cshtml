@model Domain.FRSAlertLister
@{
    string siteName = string.Empty;
    if (Model != null && Model.mFRSAlerts.Count > 0)
    {
        siteName = Model.mFRSAlerts.Select(x => x.SiteName).FirstOrDefault();
    }
}

<div class="modal bounceIn animated" id="modal-view-FRSAlertList" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span>FRS Alert List - @siteName</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="tablemodalFixHead">
                    @if (Model != null)
                    {
                        <table class="table">
                            <thead>
                                <tr>
                                    <th style="background-color: #215968; color: white;">Asset Type</th>
                                    <th style="background-color: #215968; color: white;">Asset</th>
                                    <th style="background-color: #215968; color: white;">Cause Code</th>
                                    <th style="background-color: #215968; color: white;">Message</th>
                                    @if (ViewBag.SiteBenefitId == null)
                                    {
                                        <th style="background-color: #215968; color: white;"></th>
                                    }


                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.mFRSAlerts != null && Model.mFRSAlerts.Count > 0)
                                {
                                    foreach (var item in Model.mFRSAlerts)
                                    {
                                        <tr>
                                            <td>@item.AssetType</td>
                                            <td>@item.AssetName</td>
                                            <td>
                                                @item.CauseCode
                                            </td>
                                            <td>
                                                <span>
                                                    @item.SetAlertMessage
                                                </span>
                                                <span>
                                                    @Html.Raw(item.Description)
                                                </span>
                                                <br />
                                                @if (item.IsActive == true)
                                                {
                                                    <div class="span badge rounded-pill pill-badge-danger">@E7FRSAdvance.Utility.Utility.AlertStatus.Active.ToString()</div>
                                                }
                                                else
                                                {
                                                    <div class="span badge rounded-pill pill-badge-success">@E7FRSAdvance.Utility.Utility.AlertStatus.InActive.ToString()</div>
                                                }

                                                @if (DateTime.Now != null && DateTime.Now != DateTime.MinValue)
                                                {

                                                }

                                            </td>
                                            @if (ViewBag.SiteBenefitId == null)
                                            {
                                                <td>
                                                    <input type="checkbox" class="chkBenefitFRSAlertList" value="@item.Id" />
                                                </td>
                                            }

                                        </tr>
                                    }
                                }

                            </tbody>
                        </table>

                    }
                </div>

            </div>
            <div class="modal-footer">
                @if (ViewBag.SiteBenefitId == null)
                {
                    <a class="btn btn-primary" href="javascript:void(0)" onclick="fnUpdateFRSAlertForBenefit()">Add In Benefit</a>
                }
                <button class="btn btn-default" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>



