@model Domain.User

<div class="modal bounceIn animated" id="modal-user-data" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">User Details</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">

                        <div class="col-sm-6">
                            <label class="control-label">First Name</label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.FirstName, new { @class = "form-control", @readonly = "readonly", tabindex = 1 })
                                <span class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <label class="control-label">Last Name</label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.LastName, new { @class = "form-control", @readonly = "readonly", tabindex = 5 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">Email address</label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.EmailAddress, new { @class = "form-control", @readonly = "readonly", tabindex = 2 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">Phone Number</label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.PhoneNumber, new { @class = "form-control", @readonly = "readonly", tabindex = 3 })
                                <span class="text-danger"></span>
                            </div>
                        </div>



                        <div class="col-sm-6">
                            <label class="control-label">Designation</label>
                            <div class="">
                                @Html.TextBoxFor(m => m.Designation, new { @class = "form-control", @readonly = "readonly", tabindex = 8 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">User Class</label>
                            <div class="">
                                @Html.DropDownListFor(m => m.UserClassId, (IEnumerable<SelectListItem>)ViewBag.UserClass, "Select", new { @class = "form-control", @disabled = "disabled", style = "width:100%", tabindex = 9 })
                                <span class="text-danger"></span>
                            </div>
                        </div>

                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal">Close</a>
            </div>
        </div>
    </div>
</div>