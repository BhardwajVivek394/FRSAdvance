@model Domain.SiteBenefit

<input type="hidden" id="hdnSaveBenefitType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveBenefitMessage" value="@ViewBag.Message" />

<div class="modal fade" id="modal-User-SiteBenefit" role="dialog" aria-labelledby="modal-User-SiteBenefit" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            @Html.HiddenFor(m => Model.Id)
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Site Benefit</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="mb-3">
                                <label class="form-label">Site <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.DropDownListFor(m => m.SiteId, (IEnumerable<SelectListItem>
                                        )ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 1, @id = "drpSiteBenefitSite" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-12">
                            <div class="mb-3">
                                <label class="form-label">Type  <span class="text-danger">*</span></label>
                                <div class="">
                                    <select class="form-control" id="drpSiteBenefitTypeId" name="TypeId">
                                        <option value="">Select</option>
                                        <option value="1">Mannual</option>
                                        <option value="2">RDPMS</option>
                                    </select>
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-12" id="divSiteBenefitRemark" style="display:none">
                            <div class="mb-3">
                                <label class="form-label">Remark  <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextAreaFor(m => m.Remark, new { @class = "form-control", tabindex = 3, @id = "txtSiteBenefitRemark" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12" id="divSiteFRSTimeStamp" style="display:none">
                            <div class="mb-3">
                                <label class="form-label">Date  <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => m.RDPMSTimeStamp, new { @class = "form-control", tabindex = 3, @id = "txtSiteBenefitTimeStamp" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div id="divSelectedBenefitAlertList">
                               
                                <a class="btn btn-success pull-right" onclick="fnShowFRSAlertList()">Add Benefit Alert</a>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSaveSiteBenefit()">Save</button>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {

        $('#txtSiteBenefitTimeStamp').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        if ($('#hdnSaveBenefitType').val() == 'Success') {

            CommonNotification($("#hdnSaveBenefitType").val().toLowerCase(), $("#hdnSaveBenefitMessage").val());

            $("[class*='modal-backdrop fade show']").remove();
            $("#frmSiteList").submit();
            window.history.pushState('', '', "Index");
        }
        else if ($('#hdnSaveBenefitType').val() == 'Error') {
            CommonNotification($("#hdnSaveBenefitType").val().toLowerCase(), $("#hdnSaveBenefitMessage").val());

            $("[class*='modal-backdrop fade show']").remove();
            window.history.pushState('', '', "Index");
        }

        $('#drpSiteBenefitTypeId').change(function () {

            if ($(this).val() == 1) {
                $('#divSiteBenefitRemark').show();
                $('#divSiteFRSTimeStamp').hide();
            } else if ($(this).val() == 2) {
                $('#divSiteBenefitRemark').hide();
                $('#divSiteFRSTimeStamp').show();
            }

        });

    });

    function fnSaveSiteBenefit() {
        if (ValidateSiteBenefit()) {
            var result = true;
            var model = {};
            model.Id = $("#Id").val();
            model.SiteId = $("#drpSiteBenefitSite").val();
            model.TypeId = $("#drpSiteBenefitTypeId").val();


            if (model.TypeId == 1) {
                model.Remark = $("#txtSiteBenefitRemark").val();
                if (model.Remark == null || model.Remark == undefined || model.Remark == '') {
                    result = false;
                    $("#txtSiteBenefitRemark").next("span").html("Type is required");
                }

            } else if (model.TypeId == 2) {
                model.RDPMSTimeStamp = $("#txtSiteBenefitTimeStamp").val();
                if (model.RDPMSTimeStamp == null || model.RDPMSTimeStamp == undefined || model.RDPMSTimeStamp == '') {
                    result = false;
                    $("#txtSiteBenefitTimeStamp").next("span").html("TimeStamp is required");
                }

                var frsAlertIds = [];
                $('.hdnselectBenefitFRSAlertList').each(function () {
                    frsAlertIds.push($(this).val());
                });
                model.FRSAlertIds = frsAlertIds;
            }

            if (result) {
                $("#loader").show();
                $.ajax({
                    type: 'POST',
                    url: '/UserHistory/SaveSiteBenefit',
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    data: '{mSiteBenefit:' + JSON.stringify(model) + '}',
                    contentType: 'application/json',
                    success: function (data) {
                        debugger;
                        $("#loader").hide();
                        $("#modal-User-SiteBenefit").modal('hide');
                        if (data.type == 'success') {
                            CommonNotification("SUCCESS", data.result, "success");
                            $("#frmSiteList").submit();
                        } else {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    },
                    error: function (response) {
                        $("#loader").hide();
                        CommonNotification("ERROR", "Internal server error.", "error");
                    }
                });
            }

        }
    }
    function ValidateSiteBenefit() {
        var result = true;

        if ($.trim($("#drpSiteBenefitSite").val()).length == 0) {
            $("#drpSiteBenefitSite").next("span").html("Site is required");
            result = false;
        }
        else {
            $("#drpSiteBenefitSite").next("span").html("");
        }


        if ($.trim($("#drpSiteBenefitTypeId").val()).length == 0) {
            $("#drpSiteBenefitTypeId").next("span").html("Type is required");
            result = false;
        }
        else {
            $("#drpSiteBenefitTypeId").next("span").html("");
        }

        return result;
    }
</script>

