        }, new { id = "frmSiteList" }))
        {
            <div id="divSiteList">
                @Html.Action("SiteList", "UserHistory", Model)
            </div>
        }

    </div>
    <div class="">

        @using (Ajax.BeginForm("SaveUserTraining", "UserHistory", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divAddUserTraining",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
        }, new { id = "frmAddUserTraining" }))
        {
            <div id="divAddUserTraining">
