@model Domain.AppAccessLister

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal fade" id="modal-User-History-Details" role="dialog" aria-labelledby="modal-User-History-Details" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">User History Details</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body modal-fixed-height">
                @if (Model != null && Model.mAppAccess != null && Model.mAppAccess.Count > 0)
                {
                    <div class="card">
                        <div class="card-header">
                            <h6>Mobile History</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table">
                                    <tr>
                                        <th>Start Time</th>
                                        <th>End Time</th>
                                        <th class="text-center">Duration(Min)</th>
                                    </tr>
                                    @foreach (var item in Model.mAppAccess.OrderByDescending(x => x.StartTime))
                                    {
                                        <tr>
                                            <td>@item.StartTime</td>
                                            <td>@item.EndTime</td>
                                            <td class="text-center">@item.Duration</td>
                                        </tr>
                                    }

                                </table>
                            </div>
                        </div>
                    </div>


                }

                @if (ViewBag.WebLoginHistory != null)
                {
                    var mLoginHistories = ViewBag.WebLoginHistory as List<Domain.LoginHistory>;
                    if (mLoginHistories != null && mLoginHistories.Count > 0)
                    {
                        <div class="card">
                            <div class="card-header">
                                <h6>Web History</h6>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table">
                                        <tr>
                                            <th>Start Time</th>
                                            <th>End Time</th>
                                            <th class="text-center">Duration(Min)</th>
                                        </tr>
                                        @foreach (var item in mLoginHistories)
                                        {
                                            <tr>
                                                <td>@item.LogInTime</td>
                                                <td>@item.LogOutTime</td>
                                                <td class="text-center">@item.Duration</td>
                                            </tr>
                                        }

                                    </table>
                                </div>
                            </div>
                        </div>
                    }


                }

            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
            </div>
        </div>
    </div>
</div>

