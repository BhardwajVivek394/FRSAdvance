@model Domain.SiteTraining

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal fade" id="modal-add-User-Training" role="dialog" aria-labelledby="modal-add-User-Training" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            @Html.HiddenFor(m => Model.Id, new { @id = "hdnClusterCategoryId" })
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Site Training</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="mb-3">
                                <label class="form-label">Site <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.DropDownListFor(m => m.SiteId, (IEnumerable<SelectListItem>
                                        )ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 1 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-12">
                            <div class="mb-3">
                                <label class="form-label">TimeStamp  <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => m.TimeStamp, new { @class = "form-control", tabindex = 2, @id = "txtTimeStamp" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()">Save</button>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        debugger;
        if ($('#hdnSaveType').val() == 'Success') {

            CommonNotification($("#hdnSaveType").val().toLowerCase(), $("#hdnSaveMessage").val());

            $("[class*='modal-backdrop fade show']").remove();
            $("#frmSiteList").submit();
            window.history.pushState('', '', "Index");
        }
        else if ($('#hdnSaveType').val() == 'Error') {
            CommonNotification($("#hdnSaveType").val().toLowerCase(), $("#hdnSaveMessage").val());

            $("[class*='modal-backdrop fade show']").remove();
            window.history.pushState('', '', "Index");
        }

        $("#AssetTypeId").val('@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()');

        $('#txtTimeStamp').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        }).datepicker("setDate", new Date());
    });

    function ClusterCategorySaved() {
        $("#loader").hide();
        $("#modal-add-ClusterCategory").hide();
    }

    function fnSave() {
        if (Validate()) {
            $("#frmAddUserTraining").submit();
        }
    }
    function Validate() {
        var result = true;

        if ($.trim($("#SiteId").val()).length == 0) {
            $("#SiteId").next("span").html("Site is required");
            result = false;
        }
        else {
            $("#SiteId").next("span").html("");
        }

        if ($.trim($("#txtTimeStamp").val()).length == 0) {
            $("#txtTimeStamp").next("span").html("Time Stamp is required");
            result = false;
        }
        else {
            $("#txtTimeStamp").next("span").html("");
        }


        return result;
    }
</script>
