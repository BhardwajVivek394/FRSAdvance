@model Domain.ChatBotFalseAnswerLister

@Html.HiddenFor(m => m.SearchCriteria.ColumnName, new { id = "hdnColumnName" })
@Html.HiddenFor(m => m.SearchCriteria.SortDirection, new { id = "hdnSortDirection" })

<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />

<div class="container-fluid">
    <div class="row">
        <div class="col-xl-10">
            <div class="card">
                <div class="card-header">
                    <div class="people-options clearfix">
                        <div class="btn-group pull-right people-pager">
                            @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
                            @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
                        </div>

                        <div class="btn-group pull-right">

                            <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left "></i></button>
                            <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>

                        </div>
                        @{
                            int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
                            if (Model.ChatBotFalseAnswers.Count == 0)
                            {
                                start = 0;
                            }
                            decimal end = Math.Floor(Model.Pager.TotalRecord);
                            if (Model.Pager.PageSize < Model.Pager.TotalRecord)
                            {
                                if (Model.Pager.PageSize == -1)
                                {
                                    end = Model.Pager.TotalRecord;
                                }
                                else
                                {
                                    end = Model.Pager.PageSize * Model.Pager.CurrentPage;
                                    if (end > Model.Pager.TotalRecord)
                                    {
                                        end = Model.Pager.TotalRecord;
                                    }
                                }
                            }
                        }
                    <span class="people-count pull-right" style="margin-top:10px;">Showing <strong>@start - @Math.Floor(end)</strong> of <strong>@Math.Floor(Model.Pager.TotalRecord)</strong>  ChatBot False Answer</span>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card-body " style="padding:15px;">
                        <div class="table-responsive" style="max-height: 620px;">
                            <table class="table">
                                <thead class="bg-primary">
                                    <tr>
                                        <th class="text-center">Action</th>
                                        <th data-sortcolumn="Question" class="sorting" id="thQuestion" onclick="SortList('Question');">Question</th>
                                        <th data-sortcolumn="Answer" class="sorting" id="thAnswer" onclick="SortList('Answer');">Answer</th>
                                        <th data-sortcolumn="UserName" class="sorting" id="thUserName" onclick="SortList('UserName');">User Name</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.ChatBotFalseAnswers != null && Model.ChatBotFalseAnswers.Count > 0)
                                    {
                                        foreach (var item in Model.ChatBotFalseAnswers)
                                        {
                                            <tr class="table-light">
                                                <td class="text-center " style="width:50px;">
                                                    <a title="Delete">
                                                        <i class="text-danger fa fa-trash" onclick="DeleteById('@item.Id')"></i>
                                                    </a>
                                                </td>
                                                <td>@item.Question</td>
                                                <td>@item.Answer</td>
                                                <td>@item.UserName</td>
                                                @*<td class="">
                                                        @if (item.IsActive)
                                                        {
                                                            <span class="span badge rounded-pill pill-badge-success">Active</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="span badge rounded-pill pill-badge-yellow">In Active</span>
                                                        }
                                                    </td>*@
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center">
                                                No record found
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 xl-40">
            <div class="row">
                <div class="col-xl-12 default-according style-1 faq-accordion job-accordion">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <a class="btn btn-link">Search</a>
                            </h5>
                        </div>
                        <div class="card-body filter-cards-view animate-chk">
                            <div class="form-group mb-4">
                                <label class="control-label center-block">Name:</label>
                                @Html.TextBoxFor(m => m.SearchCriteria.UserName, new { @class = "form-control", type = "text", id = "txtSearchName" })
                            </div>
                            <div class="form-group">
                                <div class="row">
                                    <div class="col-sm-6">
                                        <a class="btn btn-success" onclick="Search()">Search</a>
                                    </div>
                                    <div class="col-sm-6">
                                        <a class="btn btn-default btn-quirk btn-block" onclick="Clear()">Clear</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*<script src="@Url.Content("~/Content/PageJS/Remark/RemarkList.js")"></script>*@

<script>
    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmGetRemarkList").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize)
            {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmGetRemarkList").submit();
            }
        }
    }

    function DeleteById(id) {
        if (confirm('Are you sure you want to delete this record?')) {
            $("#loader").show();
            $.ajax({
                url: '/ChatBotRemark/Delete',
                type: 'Post',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            $("#frmChatBotRemarkList").submit();
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
    }
</script>


