@model List<Domain.SmsTriggerSetting>
<div class="row">
    <div class="col-sm-12 text-right">
        <a id="btnSignalAddNumber" class="btn btn-success btn-sm btn-quirk" onclick="AddSignalNumberRow()"><span class="fa fa-plus"></span> Add Number</a>
    </div>
</div>
<div class="row mt10">
    <div class="col-sm-12">
        <div class="table-responsive" style="max-height: 620px;">
            <table class="table table-bordered">
                <tbody id="siteSmstrigger">
                   @foreach (var item in Model)
                   {
                    <tr>
                        <td>@item.AlertName</td>

                        
                        <td>
                            @if (item.SmsFrequency > 0)
                            {
                                <input type="text" id="txtSf@(item.AlertId)" class="form-control" value="@item.SmsFrequency" />
                            }
                            else
                            {
                                <input type="text" id="txt@(item.AlertId)" class="form-control" />
                            }
                        <td>
                            @if (item.SmsLimit > 0)
                            {
                                <input type="text" id="txtSL@(item.AlertId)" class="form-control" value="@item.SmsLimit" />
                            }
                            else
                            {
                                <input type="text" id="txtSL@(item.AlertId)" class="form-control" />
                            }
                        </td>
                        <td style="width:100px;">
                            <a class="btn btn-success">Save</a>
                        </td>
                    </tr>
                   }
                </tbody>
            </table>
        </div>
    </div>
</div>
