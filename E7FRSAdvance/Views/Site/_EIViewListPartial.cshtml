<style>
    .table-striped > tbody > tr:nth-child(odd) > td,
    .table-striped > tbody > tr:nth-child(odd) > th {
        background-color: #F1EFFF;
    }

    .selectedRow td {
        background-color: #EAE8FF;
    }
    body{
        overflow-y:hidden!important;
    }
</style>

<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />

<div class="row" id="full-screen">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <div class="people-options clearfix">
                    <div class="pull-left">
                        <label>From Date</label>
                        @Html.TextBoxFor(m => m.SearchCriteria.FromDate, new { @class = "form-control", id = "ei-from-date", tabindex = 1 })

                        @*<input type="text" id="ei-from-date" name="SearchCriteria.FromDate" class="form-control" tabindex="1" />*@
                    </div>
                    <div class="pull-left" style="margin-left:10px;">
                        <label>From Time</label>
                        <input type="text" id="tpFrom" name="SearchCriteria.FromTime" class="form-control" value="@Model.SearchCriteria.FromTime" tabindex="2" />

                    </div>
                    <div class="pull-left" style="margin-left:10px;">
                        <label>To Date</label>
                        @Html.TextBoxFor(m => m.SearchCriteria.ToDate, new { @class = "form-control", id = "ei-to-date", tabindex = 3 })
                        @*<input type="text" id="ei-to-date" name="SearchCriteria.ToDate" class="form-control" tabindex="1" />*@
                    </div>
                    <div class="pull-left" style="margin-left:10px;">
                        <label>To Time</label>
                        <input type="text" id="tpTo" name="SearchCriteria.ToTime" class="form-control" value="@Model.SearchCriteria.ToTime" tabindex="4" />
                    </div>
                    <div class="pull-left" style="margin-left:10px;">
                        <label>Search here</label>
                        @Html.TextBoxFor(m => m.SearchCriteria.SearchText, new { @class = "form-control", id = "ei-SearchText", tabindex = 5 })
                    </div>
                    <div class="pull-left" style="margin-left:10px;">
                        <button type="button" class="btn btn-primary mt-4" onclick="fnSearch()">Search</button>
                        <a class="btn btn-primary mt-4" onclick="DownloadEIViewCsvFile()" data-bs-original-title="" title="">Download</a>
                    </div>
                    <div class="btn-group pull-right people-pager">
                        @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
                        @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
                    </div>
                    <div class="btn-group pull-right people-pager">
                        <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left "></i></button>
                        <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>
                    </div>
                    @{
                        int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
                        if (Model.COSConfigs.Count == 0)
                        {
                            start = 0;
                        }
                        decimal end = Math.Floor(Model.Pager.TotalRecord);
                        if (Model.Pager.PageSize < Model.Pager.TotalRecord)
                        {
                            if (Model.Pager.PageSize == -1)
                            {
                                end = Model.Pager.TotalRecord;
                            }
                            else
                            {
                                end = Model.Pager.PageSize * Model.Pager.CurrentPage;
                                if (end > Model.Pager.TotalRecord)
                                {
                                    end = Model.Pager.TotalRecord;
                                }
                            }
                        }
                    }
                  
                    <span class="people-count pull-right" style="margin-top:10px;">Showing <strong>@start - @Math.Floor(end)</strong> of <strong>@Math.Floor(Model.Pager.TotalRecord)</strong> EI View</span>
                </div>
            </div>
            <div class="card-body " style="padding:15px;">
                <div class="table-responsive" style="max-height: 720px;">
                    <table class="table table-striped" id="tblEIView">
                        <thead class="bg-primary">
                            <tr>
                                <th data-sortcolumn="MNEMONIC" class="sorting" id="thMNEMONIC" onclick="SortList('MNEMONIC');">MNEMONIC</th>
                                <th data-sortcolumn="STRING" class="sorting" id="thSTRING" onclick="SortList('STRING');">STRING</th>
                                <th data-sortcolumn="WT_DATE" class="sorting" id="thWT_DATE" onclick="SortList('WT_DATE');">WT DATE</th>
                                <th data-sortcolumn="VALUE" class="sorting" id="thVALUE" onclick="SortList('VALUE');" style="width:100px">VALUE</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.COSConfigs != null && Model.COSConfigs.Count > 0)
                            {
                                foreach (var item in Model.COSConfigs)
                                {
                                    <tr class="table-light selectedRow">
                                        <td>@item.MNEMONIC</td>
                                        <td>@item.STRING</td>
                                        <td>@item.WT_DATE</td>
                                        <td>@item.VALUE</td>
                                    </tr>

                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center">
                                        No record found
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
