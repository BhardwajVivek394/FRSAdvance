@model Domain.RouteTrackLister

@if (Model.RouteTracks != null && Model.RouteTracks.Count > 0)
{
    int i = 1;
    foreach (var item in Model.RouteTracks)
    {
        <tr data-rowId="@i">
            <input type="hidden" id="hdnRouteTrack@(i)" value="@item.Id" />
            <td class="text-center width60" style="vertical-align:middle">
                <a data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Delete" style="cursor:pointer"><i class="glyphicon glyphicon-trash text-danger" onclick="DeleteRouteTrackById('@item.Id', '@item.RouteId', this)"></i></a>
            </td>
            <td style="width:250px">
                <select name="AssetId" class="routeTracks" id="drpRouteTrack@(i)@(item.RouteId)">
                    @if (Model.SearchCriteria.Assets != null && Model.SearchCriteria.Assets.Count > 0)
                    {
                        foreach (var asset in Model.SearchCriteria.Assets)
                        {
                            if (item.AssetId == asset.Id)
                            {
                                <option value="@asset.Id" selected>@asset.Name</option>
                            }
                            else
                            {
                                <option value="@asset.Id">@asset.Name</option>
                            }
                        }
                    }
                </select>
            </td>
            <td>
                <input type="text" id="sequenceNumber@(i)@(item.RouteId)" class="form-control sequenceNumber" value="@item.SequenceNumber" placeholder="Sequence number" />
            </td>
            <td class="text-center width60">
                <button type="button" onclick="fnSaveRouteTrack('@i', '@item.RouteId')" class="btn btn-success btn-quirk">Add</button>
            </td>
        </tr>
        i++;
    }
}
