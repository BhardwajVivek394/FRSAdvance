@model Domain.SitePointMachine
<div class="row mt10">
    <div class="col-sm-12">
        <div class="row">
            @Html.HiddenFor(m => m.Id, new { id = "hdnPointMachineId" })
            <div class="col-sm-6">
                <label class="control-label">APIPath <span class="text-danger">*</span></label>
                <div class="">
                    @Html.TextBoxFor(m => Model.APIPath, new { @class = "form-control", tabindex = 1 })
                    <span class="text-danger"></span>
                </div>
            </div>

            <div class="col-sm-6">
                <label class="control-label">User Id <span class="text-danger">*</span></label>
                <div class="">
                    @Html.TextBoxFor(m => Model.UserId, new { @class = "form-control", tabindex = 2 })
                    <span class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-6">
                <label class="control-label">Dashboard Id <span class="text-danger">*</span></label>
                <div class="">
                    @Html.TextBoxFor(m => Model.DashboardId, new { @class = "form-control", tabindex = 3 })
                    <span class="text-danger"></span>
                </div>
            </div>
            <div class="col-sm-6">
                <label class="control-label">Device Id <span class="text-danger">*</span></label>
                <div class="">
                    @Html.TextBoxFor(m => Model.DeviceId, new { @class = "form-control", tabindex = 4 })
                    <span class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-sm-12 text-end mt-3">
                <button class="btn btn-primary btn-quirk" onclick="fnSavePointMachine()"> Save</button>
            </div>
        </div>
    </div>
</div>
<script>
    function fnSavePointMachine() {
        var SitePointMachine = {};
        SitePointMachine.Id = $("#hdnPointMachineId").val();
        SitePointMachine.SiteId = $("#hdnSiteId").val();
        SitePointMachine.APIPath = $("#APIPath").val();
        SitePointMachine.UserId = $("#UserId").val();
        SitePointMachine.DashboardId = $("#DashboardId").val();
        SitePointMachine.DeviceId = $("#DeviceId").val();
        if (SitePointMachine.APIPath == null || SitePointMachine.APIPath == undefined || SitePointMachine.APIPath == "") {
            CommonNotification("danger", "Please enter API path!");
        } else if (SitePointMachine.UserId == null || SitePointMachine.UserId == undefined || SitePointMachine.UserId == "") {
            CommonNotification("danger", "Please enter user Id!");
        } else if (SitePointMachine.DashboardId == null || SitePointMachine.DashboardId == undefined || SitePointMachine.DashboardId == "") {
            CommonNotification("danger", "Please enter dashboard Id!", "error");
        } else if (SitePointMachine.DeviceId == null || SitePointMachine.DeviceId == undefined || SitePointMachine.DeviceId == "") {
            CommonNotification("danger", "Please enter device Id!");
        } else {
            $.ajax({
                url: '/Site/SavePointMachine',
                type: 'Post',
                data: '{mSitePointMachine:' + JSON.stringify(SitePointMachine) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data === true) {
                        CommonNotification("success", "Point machine has been saved.");
                        $("#frmPointMachine").submit();
                    } else {
                        CommonNotification("danger", "Internal server error.");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("danger", "Internal server error.");
                }
            });
        }
    }
</script>