@model Domain.Site
@{
    ViewBag.Title = "Edit Site";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Sites</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="row">
        <div class="col-lg-12 people-list">
            <div class="people-options clearfix">
                <div class="pull-right">
                    <a href="@Url.Action("Index","Site")" class="btn btn-outline-dark btn-quirk">Back</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-2"></div>
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body" style="padding:15px;">
                    <div class="row">
                        @Html.HiddenFor(m => m.Id)
                        <div class="col-sm-6">
                            <label class="control-label">Zone <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.DropDownListFor(m => m.ZoneId, (IEnumerable<SelectListItem>)ViewBag.Zones, new { @class = "form-control", style = "width:100%", id = "zoneAdd1", tabindex = 1 })
                                <span id="spZone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <label class="control-label">Division <span class="text-danger">*</span></label>
                            <div class="">
                                <select name="DivisionId" class="form-control" id="drpDivision" tabindex="2">
                                </select>
                                <span id="division" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <label class="control-label">Name <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.Name, new { @class = "form-control", tabindex = 3 })
                                <span class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <label class="control-label">MQTT Base Path <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.MQTTBasePath, new { @class = "form-control", tabindex = 4 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <label class="control-label">MQTT No. of Channels <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.MQTTNoOfChannels, new { @class = "form-control", tabindex = 5 })
                                <span class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <label class="control-label">MQTT Active Threshold <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.MQTTActiveChannel, new { @class = "form-control", tabindex = 6 })
                                <span class="text-danger"></span>
                            </div>
                        </div>

                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <label class="control-label">Mac Id <span class="text-danger"></span></label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.MACId, new { @class = "form-control", tabindex = 7 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">Description <span class="text-danger"></span></label>
                            <div class="">
                                @Html.TextAreaFor(m => Model.Description, new { @class = "form-control", tabindex = 8 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <label class="control-label">Sms Frequency <span class="text-danger"></span></label>
                            <div class="">
                                @Html.TextBox("SmsFrequency", Model.SmsFrequency, new { @class = "form-control" })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">Sms Limit <span class="text-danger"></span></label>
                            <div class="">
                                @Html.TextBox("SmsLimit", Model.SmsLimit, new { @class = "form-control" })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <label class="control-label">Statin Code <span class="text-danger"></span></label>
                            <div class="">
                                @Html.TextBox("StationCode", Model.StationCode, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">PLC Log<span class="text-danger"></span></label>
                            <div class="">
                                @Html.DropDownListFor(m => m.PLCLogId, ViewBag.PLCLogEnumList as SelectList, new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <label class="control-label">Charger Delay(Min) <span class="text-danger"></span></label>
                            <div class="">
                                @Html.TextBox("ChargerDelay", Model.ChargerDelay, new { @class = "form-control", @Type = "Number" })
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">Reboot Total <span class="text-danger"></span></label>
                            <div class="">
                                @Html.TextBoxFor(m => m.RebootTotal, new { @class = "form-control", @Type = "Number" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <label class="control-label">Reboot Day <span class="text-danger"></span></label>
                            <div class="">
                                @Html.TextBoxFor(m => m.RebootDay, new { @class = "form-control", @Type = "Number" })
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">Reboot Daynum <span class="text-danger"></span></label>
                            <div class="">
                                @Html.TextBoxFor(m => m.RebootDaynum, new { @class = "form-control", @Type = "Number" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <label class="control-label">Router Id</label>
                            <div class="">
                                @Html.TextBoxFor(m => m.RouterId, new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">Mobile Number</label>
                            <div class="">
                                @Html.TextBoxFor(m => m.MobileNumber, new { @class = "form-control", @Type = "Number" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <label class="control-label">Modem Type</label>
                            <div class="">
                                @Html.DropDownList("ModemType", EnumHelper.GetSelectList(typeof(E7FRSAdvance.Utility.Utility.ModemType)), "Select", new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="col-sm-6" id="divSingleModamType" style="display:none">
                            <div class="row">
                                <div class="col-sm-10">
                                    <label class="control-label">Single Modam Type</label>
                                    <div class="">
                                        @Html.DropDownList("SingleModamType", EnumHelper.GetSelectList(typeof(E7FRSAdvance.Utility.Utility.SingleModamType)), "Select", new { @class = "form-control" })
                                    </div>
                                </div>
                                <div class="col-sm-2" id="divBtnSinglePartial" style="display:none">
                                    <a class="btn btn-success mt-4" href="javascript:void(0)" onclick="fnShowSingleModamTypeAsset('@Model.Id')"><i class="fa fa-eye"></i></a>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <label class="control-label">Section</label>
                            <div class="">
                                @Html.DropDownListFor(m => m.SectionId, (IEnumerable<SelectListItem>)ViewBag.Sections, "Select", new { @class = "form-control" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6 mt-4">
                            <label class="control-label">
                                <span>Is Setup Local Site</span>
                                @Html.CheckBox("IsSetupLocalSite", Model.IsSetupLocalSite)
                            </label>
                        </div>
                        <div class="col-sm-6 mt-4">
                            <label class="control-label">
                                <span>Is HttPost</span>
                                @Html.CheckBox("IsHttpPost", Model.IsHttpPost)
                            </label>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-sm-6">
                            <label class="control-label"><span>Is Active</span>  @Html.CheckBoxFor(m => Model.IsActive, new { style = "vertical-align:sub" })</label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is EI Enable</span>
                                @Html.CheckBox("IsEIEnable", Model.IsEIEnable)
                            </label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is Test</span>
                                @Html.CheckBox("IsTest", Model.IsTest)
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is None RE</span>
                                @Html.CheckBox("IsNoneRE", Model.IsNoneRE)
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is Under Devlopment</span>
                                @Html.CheckBox("IsUnderDevlopment", Model.IsUnderDevlopment)
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is Analytics</span>
                                @Html.CheckBox("IsAnalytics", Model.IsAnalytics)
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is TestUser</span>
                                @Html.CheckBox("IsTestUser", Model.IsTestUser)
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is Earth Fault Push Notification</span>
                                @Html.CheckBox("IsEarthFaultPushNotification", Model.IsEarthFaultPushNotification)
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is Cutting Relay Voltage</span>
                                @Html.CheckBox("IsCuttingRelayVoltage", Model.IsCuttingRelayVoltage)
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is Summary</span>
                                @Html.CheckBox("IsSummary", Model.IsSummary)
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is Series Opration</span>
                                @Html.CheckBox("IsSeriesOpration", Model.IsSeriesOpration)
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is Point Detection 50v</span>
                                @Html.CheckBox("IsPointDetection50v", Model.IsPointDetection50v)
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <div class="row">
                                <div class="col-6">
                                    <label class="control-label">
                                        <span>Is Data Logger</span>
                                        @Html.CheckBox("IsDataLogger", Model.IsDatalogger)
                                    </label>
                                </div>
                                <div class="col-6" style="display:none" id="divDLVersion">
                                    <label class="control-label">
                                        @*<span>DL Version</span>*@

                                        @{
                                            var enumData = from E7FRSAdvance.Utility.Utility.DataloggerVersion e in Enum.GetValues(typeof(E7FRSAdvance.Utility.Utility.DataloggerVersion))
                                                           select new
                                                           {
                                                               Id = (int)e,
                                                               Name = e.ToString().Replace("_", " ")
                                                           };

                                            if (enumData != null && enumData.Count() > 0)
                                            {
                                                foreach (var item in enumData)
                                                {
                                                    var displayName = E7FRSAdvance.Utility.EnumHelper.GetDisplayNameById<E7FRSAdvance.Utility.Utility.DataloggerVersion>(item.Id);
                                                    if (Model.DataLoggerVersion == item.Id)
                                                    {
                                                        <input type="radio" value="@item.Id" name="radioDLVersion" id="radioDLVersion@(item.Id)" checked />
                                                    }
                                                    else
                                                    {
                                                        <input type="radio" value="@item.Id" name="radioDLVersion" id="radioDLVersion@(item.Id)" />
                                                    }
                                                    <label for="radioDLVersion@(item.Id)">@displayName</label>
                                                    <br />
                                                }
                                            }
                                        }
                                    </label>
                                </div>
                            </div>

                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is Data Logger Json Reverse</span>
                                @Html.CheckBox("IsDataLoggerJsonReverse", Model.IsDataLoggerJsonReverse)
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is Combine Point Machine</span>
                                @Html.CheckBox("IsCombinePointMachine", Model.IsCombinePointMachine)
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is FRS Alert</span>
                                @Html.CheckBox("IsFRSAlert", Model.IsFRSAlert)
                            </label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">
                                <span>Is Siemens Point</span>
                                @Html.CheckBox("IsSiemensPoint", Model.IsSiemensPoint)
                            </label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-12" style="text-align: right;margin-top: 20px;padding-right: 10px;">
                            <button type="button" class="btn btn-primary btn-quirk" onclick="fnSaveSite()">Save</button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-sm-2"></div>
    </div>

    <div class="row">
        <div class="col-sm-2"></div>
        <div class="col-lg-8">
            <div class="card">
                <div class="card-body" style="padding:15px;">
                    <!-- Nav tabs -->
                    <ul class="nav nav-tabs border-tab nav-primary" id="info-tab" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="Numbers-tab" data-bs-toggle="tab" href="#Numbers" role="tab" aria-controls="Numbers" aria-selected="true" data-bs-original-title="" title="">
                                <i class="fa fa-home"></i>Numbers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="PointMachine-tab" data-bs-toggle="tab" href="#PointMachine" role="tab" aria-controls="PointMachine" aria-selected="false" data-bs-original-title="" title="">
                                <i class="fa fa-gear"></i>Device LastAccessTime Config
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="SignalConfig-tab" data-bs-toggle="tab" href="#SignalConfig" role="tab" aria-controls="SignalConfig" aria-selected="false" data-bs-original-title="" title="">
                                <i class="fa fa-signal"></i>Signal Config
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="MacConfig-tab" data-bs-toggle="tab" href="#MacConfig" role="tab" aria-controls="MacConfig" aria-selected="false" data-bs-original-title="" title="">
                                <i class="fa fa-magic"></i>Mac Id Detail
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="SiteTemperature-tab" data-bs-toggle="tab" href="#SiteTemperature" role="tab" aria-controls="SiteTemperature" aria-selected="false" data-bs-original-title="" title="">
                                <i class="fa fa-magic"></i>Site Temperature
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="Test-tab" data-bs-toggle="tab" href="#tabTestConfig" role="tab" aria-controls="TestConfig" aria-selected="false" data-bs-original-title="" title="" style="display:none">
                                <i class="fa fa-bell"></i>Test
                            </a>
                        </li>
                    </ul>
                    <!-- Tab panes -->
                    <div class="tab-content">

                        <div class="tab-pane fade active show" id="Numbers" role="tabpanel" aria-labelledby="Numbers-tab">
                            <input type="hidden" id="hdnSiteId" value="@Model.Id" />
                            <div class="">
                                @using (Ajax.BeginForm("_AddNumbers", "Site", new { siteId = Model.Id }, new AjaxOptions() { UpdateTargetId = "divNumbers", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmNumbers", enctype = "multipart/form-data" }))
                                {
                                    <div id="divNumbers">
                                        @Html.Action("_AddNumbers", new { siteId = Model.Id })
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="tab-pane fade" role="tabpanel" aria-labelledby="PointMachine-tab" id="PointMachine">
                            <input type="hidden" id="hdnSiteId" value="@Model.Id" />
                            <div class="">
                                @using (Ajax.BeginForm("_GetAssignSiteUser", "Site", new { siteId = Model.Id }, new AjaxOptions() { UpdateTargetId = "divPointMachine", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmDeviceTime", enctype = "multipart/form-data" }))
                                {
                                    <div id="divRoute">
                                        @Html.Action("_GetAssignSiteUser", new { siteId = Model.Id })
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="tab-pane fade" role="tabpanel" aria-labelledby="SignalConfig-tab" id="SignalConfig">
                            <input type="hidden" id="hdnSiteIdSignal" value="@Model.Id" />
                            <div class="">
                                @using (Ajax.BeginForm("_AddSignalNumber", "Site", new { siteId = Model.Id }, new AjaxOptions() { UpdateTargetId = "divSignal", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmSignalConfig", enctype = "multipart/form-data" }))
                                {
                                    <div id="divSignal">
                                        @Html.Action("_AddSignalNumber", new { siteId = Model.Id })
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="tab-pane fade" role="tabpanel" aria-labelledby="MacConfig-tab" id="MacConfig">
                            <input type="hidden" id="hdnSiteIdSmsSignal" value="@Model.Id" />
                            <div class="">
                                @using (Ajax.BeginForm("GetChannelConfig", "Site", new { siteId = Model.Id }, new AjaxOptions() { UpdateTargetId = "divsmsTrigger", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmSmsTriggerConfig", enctype = "multipart/form-data" }))
                                {
                                    <div id="divsmsTrigger">
                                        @Html.Action("GetChannelConfig", new { siteId = Model.Id })
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="tab-pane fade" role="tabpanel" aria-labelledby="MacConfig-tab" id="MacConfig">
                            <input type="hidden" id="hdnSiteIdSmsSignal" value="@Model.Id" />
                            <div class="">
                                @using (Ajax.BeginForm("GetChannelConfig", "Site", new { siteId = Model.Id }, new AjaxOptions() { UpdateTargetId = "divsmsTrigger", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmSmsTriggerConfig", enctype = "multipart/form-data" }))
                                {
                                    <div id="divsmsTrigger">
                                        @Html.Action("GetChannelConfig", new { siteId = Model.Id })
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="tab-pane fade" role="tabpanel" aria-labelledby="SiteTemperature-tab" id="SiteTemperature">
                            <input type="hidden" id="hdnSiteTemperature" value="@Model.Id" />
                            <div class="">
                                @using (Ajax.BeginForm("GetSiteTemperature", "Site", new { siteId = Model.Id }, new AjaxOptions() { UpdateTargetId = "divsmsTrigger", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmSmsTriggerConfig", enctype = "multipart/form-data" }))
                                {
                                    <div id="divsmsTrigger">
                                        @Html.Action("GetSiteTemperature", new { siteId = Model.Id })
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="tab-pane fade" role="tabpanel" aria-labelledby="Test-tab" id="tabTestConfig">
                            <input type="hidden" id="hdnSiteId" value="@Model.Id" />
                            <div class="">
                                @using (Ajax.BeginForm("_GetAssignTestSiteUser", "Site", new { siteId = Model.Id }, new AjaxOptions() { UpdateTargetId = "divTest", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmTestConfig", enctype = "multipart/form-data" }))
                                {
                                    <div id="divTestConfig">
                                        @Html.Action("_GetAssignTestSiteUser", new { siteId = Model.Id })
                                    </div>
                                }
                            </div>
                        </div>

                    </div>

                </div>
            </div>
        </div>
        <div class="col-sm-2"></div>
    </div>
</div>

<div class="modal bounceIn animated" id="modalSingleModamTypeAsset" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modalConfirm-dialog">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader">Single Modam Asset</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row" id="divSingleModamAsset"></div>
            </div>
        </div>
    </div>
</div>

<script>
    var modemTypeSingle = '@E7FRSAdvance.Utility.Utility.ModemType.Single.GetHashCode()';
    var singleModamTypePartial = '@E7FRSAdvance.Utility.Utility.SingleModamType.Partial.GetHashCode()';
    $(document).ready(function () {

      //  $("#zoneAdd1").select2({ minimumResultsForSearch: Infinity, width: '100%' });
      //  $("#drpDivision").select2({ minimumResultsForSearch: Infinity, width: '100%' });

       // $('#MQTTNoOfChannels').mask('00');
     //   $('#MQTTActiveChannel').mask('00');

        GetDivision('@Model.ZoneId');

        $("#zoneAdd1").change(function () {
            var zoneId = $(this).children("option:selected").val();
            GetDivision(zoneId);
        });

        if ($("#IsDataLogger").prop("checked")) {
            $('#divDLVersion').show();
        } else {
            $('#divDLVersion').hide();
        }

        $("#IsDataLogger").change(function () {

            if ($(this).prop("checked")) {
                $('#divDLVersion').show();
            } else {
                $('#divDLVersion').hide();
            }
        });

        $("#IsTest").change(function () {
            if ($(this).prop('checked') == true) {
                $("#Test-tab").show();
                $("#tabTestConfig").show();
            } else{
                $("#Test-tab").hide();
                $("#tabTestConfig").hide();
            }
        });

        if ($("#ModemType").val() == modemTypeSingle) {
            $('#divSingleModamType').show();
        } else {
            $('#divSingleModamType').hide();
        }

        $("#ModemType").change(function () {
            var val = $(this).val();
            if (val == modemTypeSingle) {
                $('#divSingleModamType').show();
            } else {
                $('#divSingleModamType').hide();
            }

        });

        $('#SingleModamType').change(function () {
            var val = $(this).val();
            if (val == singleModamTypePartial) {
                $('#divBtnSinglePartial').show();
            } else {
                $('#divBtnSinglePartial').hide();
            }
        });

        if ($("#SingleModamType").val() == singleModamTypePartial) {
            $('#divBtnSinglePartial').show();
        } else {
            $('#divBtnSinglePartial').hide();
        }

        if ($("#IsTest").prop('checked') == true) {
            $("#Test-tab").show();
            $("#tabTestConfig").show();
        } else {
            $("#Test-tab").hide();
            $("#tabTestConfig").hide();
        }

    });

    function GetDivision(zoneId) {
        $("#loader").show();
        $.ajax({
            type: 'POST',
            url: '/Site/GetDivisionByZoneId',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: '{zoneId:' + zoneId + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                var temp = '';
                if (data != null) {
                    temp += '<option value="' + 0 + '">Select Division</option>';
                    $.each(data, function (key, value) {
                        temp += '<option value="' + value.Id + '">' + value.Name + '</option>';
                    });
                }
                $("#drpDivision").empty().append(temp);
                $("#drpDivision").val('@Model.DivisionId').trigger('change');
                $("#loader").hide();
            },
            error: function (response) {
                $("#loader").hide();
            }
        });
    }

    function fnSaveSite() {
        if (Validate()) {
            var model = {};
            model.Id = $("#Id").val();
            model.ZoneId = $("#zoneAdd1").val();
            model.DivisionId = $("#drpDivision").val();
            model.SectionId = $("#SectionId").val();
            model.Name = $("#Name").val();
            model.MQTTBasePath = $("#MQTTBasePath").val();
            model.MQTTNoOfChannels = $("#MQTTNoOfChannels").val();
            model.MQTTActiveChannel = $("#MQTTActiveChannel").val();
            model.Description = $("#Description").val();
            model.MACId = $("#MACId").val();
            model.SmsFrequency = $("#SmsFrequency").val();
            model.SmsLimit = $("#SmsLimit").val();
            model.StationCode = $("#StationCode").val();
            model.RebootTotal = $("#RebootTotal").val();
            model.RebootDay = $("#RebootDay").val();
            model.RebootDaynum = $("#RebootDaynum").val();
            model.RouterId = $("#RouterId").val();
            model.MobileNumber = $("#MobileNumber").val();
            model.IsHttpPost = $("#IsHttpPost").is(":checked");
            model.IsSetupLocalSite = $("#IsSetupLocalSite").is(":checked");
            model.IsEIEnable = $("#IsEIEnable").is(":checked");
            model.IsTest = $("#IsTest").is(":checked");
            model.IsNoneRE = $("#IsNoneRE").is(":checked");
            model.IsUnderDevlopment = $("#IsUnderDevlopment").is(":checked");
            model.IsAnalytics = $("#IsAnalytics").is(":checked");
            model.IsEarthFaultPushNotification = $("#IsEarthFaultPushNotification").is(":checked");
            model.ChargerDelay = $("#ChargerDelay").val();
            model.IsTestUser = $("#IsTestUser").is(":checked");
            model.IsCuttingRelayVoltage = $("#IsCuttingRelayVoltage").is(":checked");
            model.IsSummary = $("#IsSummary").is(":checked");
            model.IsSeriesOpration = $("#IsSeriesOpration").is(":checked");
            model.IsPointDetection50v = $("#IsPointDetection50v").is(":checked");
            model.IsDataLogger = $("#IsDataLogger").is(":checked");//Data Logger
            model.IsDataLoggerJsonReverse = $("#IsDataLoggerJsonReverse").is(":checked");//Data Logger
            model.ModemType = $("#ModemType").val();
            if (model.ModemType == modemTypeSingle) {
                model.SingleModamType = $('#SingleModamType').val();
            }
            if (model.IsDataLogger) {
                model.DataLoggerVersion = $('input[name="radioDLVersion"]:checked').val();
            }
            else {
                model.DataLoggerVersion = null;
            }
            model.IsCombinePointMachine = $("#IsCombinePointMachine").is(":checked");
            model.IsFRSAlert = $("#IsFRSAlert").is(":checked");
            model.IsSiemensPoint = $("#IsSiemensPoint").is(":checked");
            
            if ($("#PLCLogId").val() != '0') {
                model.PLCLogId = $("#PLCLogId").val();
            }

            if ($('#IsActive').is(":checked")) {
                model.IsActive = true;
            } else {
                model.IsActive = false;
            }



            $("#loader").show();
            $.ajax({
                type: 'POST',
                url: '/Site/UpdateSite',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                data: '{mSite:' + JSON.stringify(model) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data.IsSuccess === true) {
                        CommonNotification("SUCCESS", "Site has been updated.", "success");
                        $("#frmGetSiteList").submit();
                    } else {
                        CommonNotification("ERROR", "Error occured while updating site!", "error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                }
            });
        }
    }

    function Validate() {
        var result = true;

        if ($.trim($("#Name").val()).length == 0) {
            $("#Name").next("span").html("Name is required");
            result = false;
        }
        else {
            $("#Name").next("span").html("");
        }

        if ($.trim($("#MQTTBasePath").val()).length == 0) {
            $("#MQTTBasePath").next("span").html("MQTT Base path is required");
            result = false;
        }
        else {
            $("#MQTTBasePath").next("span").html("");
        }

        if ($.trim($("#MQTTNoOfChannels").val()).length == 0) {
            $("#MQTTNoOfChannels").next("span").html("MQTT number of channels is required");
            result = false;
        } else if ($("#MQTTNoOfChannels").val() < 0) {
            $("#MQTTNoOfChannels").next("span").html("Please enter channels more than 0.");
            result = false;
        }
        else {
            $("#MQTTNoOfChannels").next("span").html("");
        }

        if ($.trim($("#MQTTActiveChannel").val()).length == 0) {
            $("#MQTTActiveChannel").next("span").html("MQTT active channels is required");
            result = false;
        } else if ($("#MQTTActiveChannel").val() <= 0) {
            $("#MQTTActiveChannel").next("span").html("Please enter active channels more than 0.");
            result = false;
        }
        else {
            $("#MQTTActiveChannel").next("span").html("");
        }

        if ($("#zoneAdd1").val() == 0 || $("#zoneAdd1").val() == undefined) {
            $("#spZone").html("Zone is required");
            result = false;
        }
        else {
            $("#spZone").html("");
        }

        if ($("#drpDivision").val() == 0 || $("#drpDivision").val() == undefined) {
            $("#division").html("Division is required");
            result = false;
        }
        else {
            $("#division").html("");
        }

        if ($.trim($("#MACId").val()).length == 0) {
            $("#MACId").next("span").html("Mac Id is required");
            result = false;
        }
        else {
            $("#MACId").next("span").html("");
        }
        return result;
    }

    function fnShowSingleModamTypeAsset(siteId) {
        $("#loader").show();
        $.ajax({
            url: '/Site/GetAllAssest',
            type: 'Post',
            data: '{siteId:' + siteId + ',assetTypeId:' + 3 +'}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                if (data != null && data.length > 0) {
                    var tblstr = '<table class="table">';
                    tblstr += '<tr><th>Point Machine Name</th><th></th></tr>';

                    $(data).each(function (d, val) {
                        tblstr += '<tr>';
                        tblstr += '<td>' + val.Name + '</td>';
                        debugger;

                        if (val.IsSingleModamPartial != null && val.IsSingleModamPartial != '' && val.IsSingleModamPartial == true) {
                            tblstr += '<td><input type="checkbox" onChange="fnUpdateSingleModamTypeAsset(' + val.Id + ',this)" checked/></td>';
                        } else {
                            tblstr += '<td><input type="checkbox" onChange="fnUpdateSingleModamTypeAsset(' + val.Id + ',this)" /></td>';
                        }

                        tblstr += '</tr>';
                    });
                    tblstr += '</div>';

                    $('#divSingleModamAsset').empty().append(tblstr);
                    $("#modalSingleModamTypeAsset").modal('show');
                }
            },
            error: function (response) {
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnUpdateSingleModamTypeAsset(id, $this) {
        var model = {};
        model.Id = id;
        if ($($this).prop('checked') == true) {
            model.IsSingleModamPartial = true;
        }
        else {
            model.IsSingleModamPartial = false;
        }


        $("#loader").show();
        $.ajax({
            type: 'POST',
            url: '/Site/UpdateSingleModamPartial',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: '{mAsset:' + JSON.stringify(model) + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
            },
            error: function (response) {
                $("#loader").hide();
            }
        });

    }

</script>
