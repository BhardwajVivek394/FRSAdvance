    function BindSignalDataLoggerAttribute(data) {
        //Bind Datalogger Attribute
        $.each(json.mAssets, function (id, item) {

            var htmlBuilder = '';

            const mMainAssetInfoDataloggers = item.mAssetInfoDataloggers.filter(alert => alert.Type == 1);
            if (mMainAssetInfoDataloggers != null && mMainAssetInfoDataloggers.length > 0) {

                var attrpickupCount = 0;
                var attrCount = 0;
                $.each(mMainAssetInfoDataloggers, function (idx, inItem) {
                    attrCount++;
                    if (inItem.Value != null && inItem.Value != '') {
                        var dataValue = data[inItem.Value - 1];
                        if (dataValue != null) {

                            var id = ".DLAttribute" + item.Id + inItem.DataloggerAttributeId;
                            var divId = ".divDLAttribute" + item.Id + inItem.DataloggerAttributeId;

                            if (isDataLoggerJsonReverse == "True") {
                                if (parseInt(dataValue) == 0)
                                    dataValue = 1;
                                else if (parseInt(dataValue) == 1)
                                    dataValue = 0;
                            }
                            if (inItem.ContactType != null && inItem.ContactType != undefined && inItem.ContactType.toLowerCase() == 'front') {
                                if (parseInt(dataValue) == 1) {
                                    attrpickupCount++;
                                    $(id).html("<span class='badge bg-g shine-button'>Pickup</span>");

                                    htmlBuilder +=
                                        "<div class='row'>" +
                                        "<div class='col-8'><h6>" + inItem.DataloggerAssetName + "</h6></div>" +
                                        "<div class='col-4'><div><span class='badge bg-g shine-button'>Pickup</span></div></div>" +
                                        "</div>";

                                    if (attrpickupCount <= 2) {
                                        $(divId).show();
                                    }
                                    else {
                                        $(divId).hide();
                                    }
                                }
                                else if (parseInt(dataValue) == 0) {
                                    $(id).html("<span class='badge bg-y shine-button'>Drop</span>");

                                    htmlBuilder +=
                                        "<div class='row'>" +
                                        "<div class='col-8'><h6>" + inItem.DataloggerAssetName + "</h6></div>" +
                                        "<div class='col-4'><div><span class='badge bg-y shine-button'>Drop</span></div></div>" +
                                        "</div>";


                                    if ((mMainAssetInfoDataloggers.length == attrCount && attrpickupCount < 2) || ((mMainAssetInfoDataloggers.length - 1) == attrCount && attrpickupCount == 0)) {
                                        $(divId).show();
                                    } else {
                                        $(divId).hide();
                                    }
                                }
                            } else if (inItem.ContactType != null && inItem.ContactType != undefined && inItem.ContactType.toLowerCase() == 'back') {
                                if (parseInt(dataValue) == 1) {
                                    $(id).html("<span class='badge bg-y shine-button'>Drop</span>");
                                    htmlBuilder +=
                                        "<div class='row'>" +
                                        "<div class='col-8'><h6>" + inItem.DataloggerAssetName + "</h6></div>" +
                                        "<div class='col-4'><div><span class='badge bg-y shine-button'>Drop</span></div></div>" +
                                        "</div>";

                                    if ((mMainAssetInfoDataloggers.length == attrCount && attrpickupCount < 2) || ((mMainAssetInfoDataloggers.length - 1) == attrCount && attrpickupCount == 0)) {
                                        $(divId).show();
                                    } else {
                                        $(divId).hide();
                                    }
                                }
                                else if (parseInt(dataValue) == 0) {
                                    $(id).html("<span class='badge bg-g shine-button'>Pickup</span>");

                                    htmlBuilder +=
                                        "<div class='row'>" +
                                        "<div class='col-8'><h6>" + inItem.DataloggerAssetName + "</h6></div>" +
                                        "<div class='col-4'><div><span class='badge bg-g shine-button'>Pickup</span></div></div>" +
                                        "</div>";

                                    attrpickupCount++;

                                    if (attrpickupCount <= 2) {
                                        $(divId).show();
                                    } else {
                                        $(divId).hide();
                                    }
                                }
                            }
                        }
                    }

                });
            }

            const mShuntAssetInfoDataloggers = item.mAssetInfoDataloggers.filter(alert => alert.Type == 2);
            if (mShuntAssetInfoDataloggers != null && mShuntAssetInfoDataloggers.length > 0) {

                var attrpickupCount = 0;
                var attrCount = 0;
