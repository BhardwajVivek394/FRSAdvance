            @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
            @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
        </div>
        <div class="btn-group pull-right people-pager">
            <button type="button" class="btn btn-default" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left"></i></button>
            <button type="button" class="btn btn-default" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>
        </div>*@
    @{
        int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
        if (Model.mAssets.Count == 0)
        {
            start = 0;
        }
        decimal end = Math.Floor(Model.Pager.TotalRecord);
        if (Model.Pager.PageSize < Model.Pager.TotalRecord)
        {
            if (Model.Pager.PageSize == -1)
            {
                end = Model.Pager.TotalRecord;
            }
            else
            {
                end = Model.Pager.PageSize * Model.Pager.CurrentPage;
                if (end > Model.Pager.TotalRecord)
                {
                    end = Model.Pager.TotalRecord;
                }
            }
        }
    }
    <span class="people-count pull-right">Showing <strong>@Model.mAssets.Count</strong> Assets</span>
    @if (Model.SearchCriteria.IsListView == true)
    {

        <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-info" onclick="fnListView()" title="List View"><i class="fa fa-list"></i></a></span>
        <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-primary" onclick="fnGridView()" title="Grid View"><i class="fa fa-th-large"></i></a></span>
    }
</div>

<div class="card gridView">
    <div class="card-body" style="padding:15px;">
        <div class="row">
            @if (Model.mAssets != null && Model.mAssets.Count > 0)
            {
                List<Domain.Asset> astall = new List<Domain.Asset>();
                var assdsdsets = Model.mAssets.Where(x => !x.Name.ToLower().Contains("sh") && !x.Name.ToLower().Contains("co-")).ToList();
                if (assdsdsets != null)
                {
                    foreach (var assd in assdsdsets)
                    {
                        int countll = 0;
                        if (assd.assetAttributes.Where(x => x.Title.Contains("HHG")).Count() > 0)
                        {
                            countll++;
                        }
                        if (assd.assetAttributes.Where(x => x.Title.Contains("DG")).Count() > 0)
                        {
                            countll++;
                        }
                        if (assd.assetAttributes.Where(x => x.Title.Contains("HG")).Count() > 0)
                        {
                            countll++;
                        }
                        if (assd.assetAttributes.Where(x => x.Title.Contains("RG")).Count() > 0)
                        {
                            countll++;
                        }
                        var rootCount = assd.assetAttributes.Where(x => x.Title.Contains("CUG") || x.Title.Contains("BUG") || x.Title.Contains("AUG") || x.Title.Contains("DUG") || x.Title.Contains("EUG")).Count();
                        if (rootCount > 0)
                        {
                            countll += 10;
                        }

                        string numbersOnly = System.Text.RegularExpressions.Regex.Replace(assd.Name, @"\D", "");
                        if (!string.IsNullOrEmpty(numbersOnly))
                        {
                            var collSignal = Model.mAssets.Where(x => x.Name.Trim().ToLower() == "co-" + numbersOnly || x.Name.Trim().ToLower() == "c" + numbersOnly).FirstOrDefault();
                            if (collSignal != null && collSignal.Id > 0)
                            {
                                countll += 5;
                            }
                            else if (assd.assetAttributes != null && assd.assetAttributes.Where(x => x.Type == (int)E7FRSAdvance.Utility.Utility.AttributeType.Calling).Count() > 0)
                            {
                                countll += 5;
                            }
                        }

                        assd.AttributeCount = countll;
                        astall.Add(assd);
                    }
                }



                var grpCount = astall.GroupBy(x => x.AttributeCount).Select(x => x.Key).OrderBy(x => x).ToList();
                foreach (var count in grpCount)
                {
                    <div class="col-xl-12  box-col-12">
                        <div class="row">
                            @foreach (var asset in astall.Where(x => x.AttributeCount == count).ToList())
                            {

                                bool haveCollingOnSignal = false;
                                int collingonId = 0;
                                int cnt = asset.AssetTypeName.Length + asset.Name.Length;
                                string numbersOnly = System.Text.RegularExpressions.Regex.Replace(asset.Name, @"\D", "");
                                if (!string.IsNullOrEmpty(numbersOnly))
                                {
                                    var collSignal = Model.mAssets.Where(x => x.Name.Trim().ToLower() == "co-" + numbersOnly || x.Name.Trim().ToLower() == "c" + numbersOnly).FirstOrDefault();
                                    if (collSignal != null && collSignal.Id > 0)
                                    {
                                        haveCollingOnSignal = true;
                                        collingonId = collSignal.Id;
                                    }
                                }

                                <div class="col-xl-3 xl-50  box-col-6 divSignal@(asset.Id)" style="display:none">
                                    <div class="card card-border">
                                        <div class="bg-secondary" style="padding:0;border-top-left-radius:15px;border-top-right-radius:15px;">
                                            <div class="" style="width:80%;float:left;padding:10px;border-top-left-radius:15px;">
                                                <h6 style="margin-left:12px;">
                                                    <a target="_blank" class="text-white" href="@asset.HttpMisLink" onclick="fnShowPointCircuitDiagram('@asset.AssetTypeId','@asset.Id')"> @asset.AssetTypeName : @asset.Name</a>
                                                    <br />
                                                    <span>Index Score: @asset.IndexScore</span>
                                                    <a style="float: right; cursor: pointer; margin-top:-14px" onclick="fnShowAspectData(@asset.Id)">Aspects</a>
                                                    @if (asset.assetAttributes.Where(x => x.Title.EndsWith(")")).Count() > 0)
                                                    {
                                                        <br />
                                                        <a style="float: right; cursor: pointer; margin-top:-14px" onclick="fnShowLuxSignal(@asset.Id)">LUX</a>
                                                    }
                                                    @if (asset.assetAttributes.Where(x => x.IsDigital != null && x.IsDigital.Value).Count() > 0)
                                                    {
                                                        <br />
                                                        <a style="float: right; cursor: pointer; margin-top:-14px" onclick="fnShowDigitalSignal(@asset.Id)">Cutting Relay</a>
                                                    }

                                                </h6>
                                            </div>
                                            <div class="text-center bg-dark" style="width:20%;float:left;padding:2px 0px;border-top-right-radius:15px;line-height:1.3;height:66px">
                                                @if (asset.UnderMaintence == true)
                                                {
                                                    <div class="text-center"> <i class="fa fa-bell-slash" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@asset.Id', this)" data-id="@asset.Id"></i></div>
                                                }
                                                else
                                                {
                                                    <div class="text-center">
                                                        <i class="fa fa-bell" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@asset.Id', this)" data-id="@asset.Id"></i>
                                                    </div>
                                                }
                                                <a onclick="fnGetAssetGraph('@asset.SiteId','@asset.Id')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer"> Graph </a>
                                                <a onclick="fnGetSmsLog('@asset.Id')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer">Event log</a>
                                            </div>

                                        </div>
                                        <div class="card-body" style="padding:5px;">
                                            @{
                                                //var rootCount = asset.assetAttributes.Where(x => x.Title.Contains("CUG") || x.Title.Contains("BUG") || x.Title.Contains("AUG") || x.Title.Contains("DUG")).Count();
                                                var rootCount = asset.assetAttributes.Where(x => x.Title.Contains("CUG") || x.Title.Contains("BUG") || x.Title.Contains("AUG") || x.Title.Contains("DUG") || x.Title.Contains("EUG")).Select(x => { 
                                                    if (x.Title.Contains("CUG")) return "CUG"; if (x.Title.Contains("BUG")) return "BUG"; if (x.Title.Contains("AUG")) return "AUG"; if (x.Title.Contains("DUG")) return "DUG"; if (x.Title.Contains("EUG")) return "EUG"; return string.Empty; 
                                                }).Distinct().Count();
                                            }
                                            <div class="sizeDiv">
                                              
                                                <div class="routeSignal" style="margin-top:@(rootCount > 0 ? "11em !important" : "")">
                                                    @if (asset.assetAttributes != null && rootCount > 0)
                                                    {
                                                        int routeCounter = 0;
                                                        <div class="centerSignal">
                                                            <div class="white-center light-off divSignalRootMiddle@(asset.Id)"></div>
                                                        </div>
                                                        if (asset.assetAttributes != null && asset.assetAttributes.Where(x => x.Title.Contains("CUG")).Count() > 0)
                                                        {
                                                            routeCounter++;
                                                            <div class="Signal @(rootCount == 1 ? "SignalSigle" : "")">
                                                                <span class="cug">CUG</span>
                                                                <div class="white-always light-off divSignalCUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalCUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalCUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalCUG@(asset.Id)"></div>
                                                            </div>
                                                        }


                                                        if (asset.assetAttributes != null && asset.assetAttributes.Where(x => x.Title.Contains("BUG")).Count() > 0)
                                                        {
                                                            routeCounter++;
                                                            <div class="Signal @(rootCount == 1 ? "SignalSigle" : "")">
                                                                <span class="bug" style="transform:@(routeCounter > 2 ? "rotate(183deg) !important" : "")">BUG</span>
                                                                <div class="white-always light-off divSignalBUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalBUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalBUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalBUG@(asset.Id)"></div>
                                                            </div>
                                                        }

                                                        if (asset.assetAttributes != null && asset.assetAttributes.Where(x => x.Title.Contains("AUG")).Count() > 0)
                                                        {
                                                            routeCounter++;
                                                            <div class="Signal @(rootCount == 1 ? "SignalSigle" : "")">
                                                                <span class="aug" style="transform:@(routeCounter > 2 ? "rotate(183deg) !important" : "")">AUG</span>
                                                                <div class="white-always light-off divSignalAUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalAUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalAUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalAUG@(asset.Id)"></div>
                                                            </div>
                                                        }

                                                        if (asset.assetAttributes != null && asset.assetAttributes.Where(x => x.Title.Contains("DUG")).Count() > 0)
                                                        {
                                                            routeCounter++;
                                                            <div class="Signal @(rootCount == 1 ? "SignalSigle" : "")">
                                                                <span class="dug" style="transform:@(routeCounter > 2 ? "rotate(183deg) !important" : "")">DUG</span>
                                                                <div class="white-always light-off divSignalDUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalDUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalDUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalDUG@(asset.Id)"></div>
                                                            </div>
                                                        }

                                                        if (asset.assetAttributes != null && asset.assetAttributes.Where(x => x.Title.Contains("EUG")).Count() > 0)
                                                        {
                                                            routeCounter++;
                                                            <div class="Signal @(rootCount == 1 ? "SignalSigle" : "")">
                                                                <span class="eug">EUG</span>
                                                                <div class="white-always light-off divSignalEUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalEUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalEUG@(asset.Id)"></div>
                                                                <div class="white-always light-off divSignalEUG@(asset.Id)"></div>
                                                            </div>
                                                        }

                                                    }

                                                    @if (asset.assetAttributes != null && asset.assetAttributes.Where(x => x.Title.Contains("HHG")).Count() > 0)
                                                    {
                                                        <div class="yellow light-off" id="divSignalHHG@(asset.Id)"></div>
                                                    }
                                                    @if (asset.assetAttributes != null && asset.assetAttributes.Where(x => x.Title.Contains("DG")).Count() > 0)
                                                    {
                                                        <div class="green light-off" id="divSignalDG@(asset.Id)"></div>
                                                    }
                                                    @if (asset.assetAttributes != null && asset.assetAttributes.Where(x => x.Title.Contains("HG")).Count() > 0)
                                                    {
                                                        <div class="yellow light-off" id="divSignalHG@(asset.Id)"></div>
                                                    }
                                                    @if (asset.assetAttributes != null && asset.assetAttributes.Where(x => x.Title.Contains("RG")).Count() > 0)
                                                    {
                                                        <div class="red light-off" id="divSignalRG@(asset.Id)"></div>
                                                    }
                                                </div>

                                                @if (haveCollingOnSignal)
                                                {
                                                    <div class="routeSignal2">
                                                        <div class="yellow light-off divCallingSignalMainAsset@(@asset.Id)" id="divCallingSignalRG@(collingonId)" data-assetid="@asset.Id" data-mainid="@collingonId"></div>
                                                        <span>C</span>
                                                    </div>
                                                }
