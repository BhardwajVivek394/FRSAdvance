    function fnCheckAttrExists(assetAttributes, basePath, title) {
        var isExists = false;
        if (assetAttributes != null && assetAttributes.length > 0) {
            $.each(assetAttributes, function (idx, inItem) {
                var str1 = basePath.toLowerCase();
                var str2 = "";
                if (inItem.AssetInfoChannel != null && inItem.AssetInfoChannel != "") {
                    str2 = inItem.AssetInfoChannel;
                }
                if (str1.indexOf(str2) != -1) {
                    if (inItem.Title.includes(title)) {
                        isExists = true;
                    }
                }
            });
        }

        return isExists;
    }


    function GetSingleValue(assetAttributes, basePath, data, title) {
        var mainDataValue = 0;
        if (assetAttributes != null && assetAttributes.length > 0) {
            $.each(assetAttributes, function (idx, inItem) {

                var str1 = basePath.toLowerCase();
                var str2 = "";
                if (inItem.AssetInfoChannel != null && inItem.AssetInfoChannel != "") {
                    str2 = inItem.AssetInfoChannel;
                }

                if (str1.indexOf(str2) != -1) {
                    var infoValue = inItem.AssetInfoValue;
                    if (infoValue != null) {
                        var dataValue = data[infoValue];
                        if (inItem.Title.includes(title)) {

                            var mainData = parseFloat(inItem.Multiplication) * parseFloat(dataValue);
                            mainDataValue = ((mainData * 100) / 100).toFixed(1);
                        }

                    }
                }


            });
        }

        return mainDataValue;
    }


    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmAssetDetails").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize)
            {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmAssetDetails").submit();
            }
        }
    }

