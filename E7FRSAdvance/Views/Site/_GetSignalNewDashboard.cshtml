    function fnShowAspectData(assetId) {
        $("#loader").show();
        $.ajax({
            url: '/Site/GetSignalAspectData',
            type: 'Post',
            data: '{assetId:' + assetId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#model-div-alert").empty().append(data);
                $("#modalalertlogs").modal('show');
            },
            error: function (response) {
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnShowDigitalSignal(assetId) {
        var assetTypeId = '@E7FRSAdvance.Utility.Utility.AssetType.SIGNAL.GetHashCode()';
        $("#loader").show();
        $.ajax({
            url: '/Site/GetDigitalSignalAttribute',
            type: 'Post',
            data: '{assetTypeId:' + assetTypeId + ',assetId:' + assetId + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $('#modelDigitalSignal').find('.modal-body').empty();
                var value = '<table class="table table-bordered table-striped">';
                if (data != null && data != undefined && data.length > 0) {
                    $(data).each(function (val, attribute) {
                        var gateContectTypeClassName = 'hdndigital' + assetId + '-' + attribute.Id;
                        value += '<tr>';
                        value += '<td style="width:50%">' + attribute.Title +'</td>';
                        value += '<td class="' + gateContectTypeClassName + '" style="width:50%"></td>';
                        value += '</tr>';
                    });
                }
                value += '<table>';

                $('#modelDigitalSignal').find('.modal-body').append(value);
                $("#modelDigitalSignal").modal('show');
            },
            error: function (response) {
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }


    function fnChangeDisplayMode($this) {

        if ($($this).prop('checked') == true) {
            if (json.mAssets != null && json.mAssets != undefined) {
                $.each(json.mAssets, function (id, item) {
                    $(".divSignal" + item.Id).show();
                });
            }
        }
        else {
            if (json.mAssets != null && json.mAssets != undefined) {
                $.each(json.mAssets, function (id, item) {
                    $(".divSignal" + item.Id).hide();
                });
            }
        }


    }

