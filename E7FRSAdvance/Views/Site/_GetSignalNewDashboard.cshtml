    .centerSignal {
        background: #222;
        background-image: radial-gradient(#444, #000);
        content: "";
        width: 50px;
        height: 50px;
        margin: 0 auto;
        position: absolute;
        top: -50px;
        border-radius: 50%;
        border: solid 2px #333;
        z-index: 1;
        margin: 0px auto;
    }

    .Signal {
        background: #222;
        border: solid 2px #333;
        width: 120px;
