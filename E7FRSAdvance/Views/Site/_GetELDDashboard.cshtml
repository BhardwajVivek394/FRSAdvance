    function fnGetELDEventlog(siteId, assetId, assetName, startDate, endDate) {
        var mELDEventlogLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = siteId;
        mSearchCriteria.AssetId = assetId;
        mSearchCriteria.AssetName = assetName;
        if (startDate != null && startDate != undefined && startDate != '') {
            mSearchCriteria.StartDate = startDate;
        }

        if (endDate != null && endDate != undefined && endDate != '') {
            mSearchCriteria.EndDate = endDate;
        }

        mELDEventlogLister.SearchCriteria = mSearchCriteria;
      
        $("#loader").show();
        $.ajax({
            url: '/Site/GetELDEventlog',
            type: 'Post',
            data: JSON.stringify(mELDEventlogLister),
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                 $("#modalELDEventlog").modal('hide');
                $("#model-div-ELDEventlog").empty().append(data);
                $("#modalELDEventlog").modal('show');
            },
            error: function (response) {
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

