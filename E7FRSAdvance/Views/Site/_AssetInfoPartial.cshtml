@model List<Domain.AssetAttribute>
<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="row">
    <div class="col-sm-12">
        <div class="table-responsive" style="max-height: 500px;">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Asset Info</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.AssetInfoValue</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center">
                                No record found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>