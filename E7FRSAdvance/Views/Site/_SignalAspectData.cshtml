@model Domain.Asset

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body" style="padding:15px;">
                <!-- Nav tabs -->
                <ul class="nav nav-tabs border-tab nav-primary" id="info-tab" role="tablist">
                    @if (Model.assetAttributes != null && Model.assetAttributes.Count > 0)
                    {
                        int i = 0;
                        foreach (var item in Model.assetAttributes)
                        {
                            if (item.Title != "Last Updated")
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(i==0?"active":"")" id="Tab-@(i)" data-bs-toggle="tab" href="#aTab-@(i)" role="tab" aria-controls="@(i)" aria-selected="true" data-bs-original-title="" title="">
                                        <i class="fa fa-home"></i>@item.Title
                                    </a>
                                </li>
                                i++;
                            }

                        }
                    }

                </ul>
                <!-- Tab panes -->
                <div class="tab-content">
                    @if (Model.assetAttributes != null && Model.assetAttributes.Count > 0)
                    {
                        int i = 0;
                        foreach (var item in Model.assetAttributes)
                        {
                            if (item.Title != "Last Updated")
                            {
                                <div class="tab-pane fade @(i==0?"active show":"")" id="aTab-@(i)" role="tabpanel" aria-labelledby="Tab-@(i)">
                                    <div class="table-responsive" style="max-height: 620px;">
                                        <table class="table" >
                                            <tbody>
                                                @if (item.Dates != null && item.Dates.Count > 0)
                                                {
                                                    int j = 0;
                                                    foreach (var date in item.Dates)
                                                    {
                                                        <tr>
                                                            <td>@date</td>
                                                            <td>@item.Datas[j]</td>
                                                        </tr>
                                                        j++;
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                i++;
                            }

                        }
                    }

                </div>

            </div>
        </div>
    </div>
</div>
