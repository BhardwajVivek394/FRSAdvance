@model Domain.DataloggerAsset

<div class="modal bounceIn animated" id="modelRDPMSMapDataloggerAsset" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modalConfirm-dialog">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title">
                    <span id="spHeader"></span>
                    <span id="spDataloggerAssetHeader">@Model.Name</span>
                </h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <table class="table table-bordered table-striped">
                    @if (Model != null && Model.mDataloggerAttributes != null)
                    {
                        foreach (var item in Model.mDataloggerAttributes)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td class="hdnMapDataloggerAttributeData@(item.Id)@(Model.Id)"></td>
                            </tr>
                        }

                    }

                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
        </div>
    </div>
</div>

<script>
    var dataloggerClient = null;
    var dataloggerMQTT = null;
    var jsonDataloggerAssetData = "";
    jsonDataloggerAssetData = @Html.Raw(Json.Encode(Model));

    function fnBindRDPMSMapDataloggerAssetData(data) {

        if (jsonDataloggerAssetData.mDataloggerAttributes != null && jsonDataloggerAssetData.mDataloggerAttributes.length > 0) {
            $.each(jsonDataloggerAssetData.mDataloggerAttributes, function (idx, inItem) {
                if (inItem.SrNo != null) {
                    var dataValue = data[inItem.SrNo];
                    if (dataValue != null) {
                        var id = ".hdnMapDataloggerAttributeData" + inItem.Id + jsonDataloggerAssetData.Id;


                        if (inItem.ContactType != null && inItem.ContactType != undefined && inItem.ContactType.toLowerCase() == 'front') {
                            if (parseInt(dataValue) == 1) {
                                $(id).html("<span class='badge badge-success'>Pickup</span>");
                            }
                            else if (parseInt(dataValue) == 0) {
                                $(id).html("<span class='badge badge-warning'>DROP</span>");
                            }
                        } else if (inItem.ContactType != null && inItem.ContactType != undefined && inItem.ContactType.toLowerCase() == 'back') {
                            if (parseInt(dataValue) == 1) {
                                $(id).html("<span class='badge badge-warning'>DROP</span>");

                            }
                            else if (parseInt(dataValue) == 0) {

                                $(id).html("<span class='badge badge-success'>Pickup</span>");
                            }
                        }


                    }
                    else {
                    }
                }
            });
        }
    }
</script>