@model Domain.Site

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-site" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-width">
        <div class="modal-content bradius4">
            @Html.HiddenFor(m => Model.Id, new { @id = "hdnSiteId" })
            <input type="hidden" value="@Model.DivisionId" id="hdnDivisionId" />
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Site</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Edit Site</span></h4>
                }
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="">
                                <label class="control-label">Zone <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.DropDownListFor(m => m.ZoneId, (IEnumerable<SelectListItem>)ViewBag.Zones, new { @class = "form-control", id = "zoneAdd", tabindex = 1 })
                                    <span id="spRole" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="">
                                <label class="control-label">Division <span class="text-danger">*</span></label>
                                <select name="DivisionId" class="form-control" id="drpDivision" tabindex="2">
                                </select>
                                <span id="devisionId" class="text-danger"></span>
                            </div>

                            <div class="">
                                <label class="control-label">Name <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.Name, new { @class = "form-control", tabindex = 2 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <div class="">
                                <label class="control-label">Description <span class="text-danger"></span></label>
                                <div class="">
                                    @Html.TextAreaFor(m => Model.Description, new { @class = "form-control", tabindex = 3 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <div class="">
                                <label class="control-label">MQTT Base Path <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.MQTTBasePath, new { @class = "form-control", tabindex = 4 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <div class="">
                                <label class="control-label">MQTT No. of Channels <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.MQTTNoOfChannels, new { @class = "form-control m-input digits", tabindex = 5 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <div class="">
                                <label class="control-label">MQTT Active Threshold <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.MQTTActiveChannel, new { @class = "form-control m-input digits", tabindex = 6 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <div class="">
                                <label class="control-label">Mac Id <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.MACId, new { @class = "form-control", tabindex = 7 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <div class="">
                                <label class="control-label"><span>Is Active</span>  @Html.CheckBoxFor(m => Model.IsActive, new { style = "vertical-align:sub" })</label>
                            </div>

                            <div class="">
                                <label class="control-label"><span>Is Setup Local Site</span> @Html.CheckBox("IsSetupLocalSite", Model.IsSetupLocalSite)</label>
                            </div>

                            <div class="">
                                <label class="control-label"><span>Is EI Enable</span> @Html.CheckBox("IsEIEnable", Model.IsEIEnable)</label>
                            </div>
                            <div class="">
                                <label class="control-label"><span>Is Under Devlopment</span> @Html.CheckBox("IsUnderDevlopment", Model.IsUnderDevlopment)</label>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/PageJS/Site/AddSite.js"></script>