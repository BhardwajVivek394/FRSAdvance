@model Domain.WatchListLister
@{
    int counter = 0;
}

<div class="modal bounceIn animated" id="modal-edit-WatchList" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Watch List</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">

                @if (Model != null && Model.WatchLists != null)
                {
                    <table class="table">
                        <tr>
                            <th>AssetType</th>
                            <th>Asset</th>
                            <th>Attribute</th>
                            <th>Cluster</th>
                            <th>Card</th>
                            <th>ADC</th>
                            <th>Pin</th>
                            <th>Value</th>
                            <th>Date</th>
                            <th width="100">Status</th>
                            <th width="200">Issue</th>
                            <th width="200">Remark</th>
                        </tr>
                        @foreach (var item in Model.WatchLists)
                        {
                            counter++;
                            <tr class="cls-edit-watchlist" data-Id="@item.Id" data-SiteId="@item.SiteId" data-AssetTypeId="@item.AssetTypeId" data-AttributeId="@item.AttributeId" data-AssetId="@item.AssetId" data-Created-Date="@item.CreatedDate">
                                <td>@item.AssetTypeName</td>
                                <td>@item.AssetName</td>
                                <td>@item.AttributeName</td>
                                <td>@item.ClusterName</td>
                                <td>@item.CardName</td>
                                <td>@item.ADCName</td>
                                <td>@item.Pin</td>
                                <td>@item.AttributeValue</td>
                                <td>@item.CreatedDate</td>
                                <td>
                                    <select class="form-control" id="optionwatchstatus">
                                        <option value="">Select Status</option>
                                        <option value="Ok">Ok</option>
                                        <option value="Pending">Pending</option>
                                    </select>
                                </td>
                                <td>
                                    <select class="form-control clsOptionWatchIssue" data-counter="@counter">
                                        <option value="">Select Issue</option>
                                        <option value="Flus Blown">Flus Blown</option>
                                        <option value="(0-3)Sensor faulty">(0-3)Sensor faulty</option>
                                        <option value="(0-10)Sensor faulty">(0-10)Sensor faulty</option>
                                        <option value="(0-600)Sensor faulty">(0-600)Sensor faulty</option>
                                        <option value="A10 faulty">A10 faulty</option>
                                        <option value="mint card led faulty">mint card led faulty</option>
                                        <option value="current card faulty">current card faulty</option>
                                        <option value="power supply card faulty">power supply card faulty</option>
                                        <option value="hub port faulty">hub port faulty</option>
                                        <option value="converter port faulty">converter port faulty</option>
                                        <option value="internet issue">internet issue</option>
                                        <option value="anteena issue">anteena issue</option>
                                        <option value="spare used by railway">spare used by railway</option>
                                        <option value="alteration done by railway">alteration done by railway</option>
                                        <option value="calibration issue">calibration issue</option>
                                        <option value="DC isolation faulty">DC isolation faulty</option>
                                        <option value="AC isolation faulty">AC isolation faulty</option>
                                        <option value="No Issue">No Issue</option>
                                        <option value="Other">Other</option>
                                    </select>
                                    <input type="text" class="form-control mt-2 clsWatchOtherIssue" id="txtWatchotherIssue@(counter)" placeholder="Other Issue" style="display:none" />
                                </td>
                                <td>
                                    <textarea class="form-control" id="txtWatchlistRemark"></textarea>
                                </td>
                            </tr>
                        }

                    </table>

                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-success" onclick="UpdateWatchListData()">Save</button>
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('.clsOptionWatchIssue').change(function () {
            var counter = $(this).data('counter')
            if ($(this).val() == 'Other') {
                $('#txtWatchotherIssue' + counter).show();
            } else {
                $('#txtWatchotherIssue' + counter).val('');
                $('#txtWatchotherIssue' + counter).hide();
            }
        });
    });
</script>