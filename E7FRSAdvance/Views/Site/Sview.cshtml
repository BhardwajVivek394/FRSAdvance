    function fnMaintenaceModeOff($this) {
        $.each(json.mAssets, function (id, item) {
            $.each(parseJson.cells, function (id, val) {
                if ('label' in val.attrs && 'text' in val.attrs.label) {

                    if (val.type == "examples.Track" || val.type == "examples.Track1" || val.type == "examples.Track2" || val.type == "examples.Track5" || val.type == "examples.Track6") {
                        if (val.attrs.label.text == item.Name) {
                            if ('path' in val.attrs) {
                                if (item.IndexScore < 7) {
                                    val.attrs.path.stroke = "#3c4260";
                                    val.attrs.label.fill = "#d7d7d7";
                                    val.attrs.label.fontSize = "20";
                                }
                            }
                        }
                    }
                    if (val.type == "examples.Track3" || val.type == "examples.Track4") {
                        if (val.attrs.label.text == item.Name) {
                            if ('path' in val.attrs) {
                                if (item.IndexScore < 7) {
                                    val.attrs.label.fill = "#d7d7d7";
                                    val.attrs.label.fontSize = "20";
                                }
                            }
                        }
                    }

                    if (val.type == "examples.PointMachine" || val.type == "examples.PointMachine1") {

                        var pName = $.trim(item.Name.toLowerCase().replace("point", ""));

                        if (val.attrs.label.text == pName) {
                            if ('body' in val.attrs) {
                                if (item.IndexScore < 7) {
                                    val.attrs.body.stroke = "#3c4260";
                                    val.attrs.label.fill = "#d7d7d7";
                                    val.attrs.label.fontSize = "20";
                                }
                            }
                        }
                    }

                    if (val.type.indexOf("examples.Post") != -1) {

                        var sName = val.attrs.label.text.split(" ")[0];

                        if (sName == item.Name) {
                            if ('circle1' in val.attrs) {
                                if (item.IndexScore < 7) {
                                    val.attrs.label.fill = "#d7d7d7";
                                    val.attrs.label.fontSize = "20";
                                }
                            }
                        }
                    }
                }
            });
        });
        clearInterval(clearTime);
    }

    function fnGetActiveAlerts(item) {
        var smsLog = {};
        smsLog.SiteId = $("#hdnSiteId").val();
        smsLog.AssetTypeId = 0;
        smsLog.AssetId = item.Id;
        $.ajax({
            url: '/SMSLog/GetActiveAlerts',
            type: 'Post',
            data: '{mSmsLog:' + JSON.stringify(smsLog) + '}',
            dataType:'html',
            contentType: 'application/json',
            success: function (data) {
                $("#alertLog").empty().append(data);
                $("#alertLog-tab").addClass("bg-success")
                $("#alertLog-tab").removeClass("bg-danger")
                $("#alertLog table tbody tr").each(function () {
                    if ($.trim($(this).find("td").eq(0).html()) == "No record found") {
                        $("#alertLog-tab").addClass("bg-success").removeClass("bg-danger");
                    }
                    else {
                        $("#alertLog-tab").removeClass("bg-success").addClass("bg-danger");
                    }
                });

            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });

    }

