    function fnTrimDynamicValue(symbolLabel) {
        var assetName = "";
        if ($.trim(symbolLabel) != null && $.trim(symbolLabel) != undefined && $.trim(symbolLabel) != "") {
            var symbolArray = $.trim(symbolLabel).split(" || ");
            if (symbolArray.length > 2) {
                assetName = symbolArray[1];
            } else if (symbolArray.length > 1) {
                if ($.isNumeric(symbolArray[0])) {
                    assetName = symbolArray[1];
                } else if ($.isNumeric(symbolArray[1])) {
                    assetName = symbolArray[0];
                }
            } else {
                assetName = symbolLabel;
            }
        }
        return assetName;
    }

