    function onConnect() {

        for (var i = 0; i < channels.length; i++) {
            if (channels[i] != null && channels[i] != "null" && channels[i] != "") {
                client.subscribe(mQQTPath + channels[i].toLowerCase());
            }
        }
    }

    // called when the client loses its connection
    function onConnectionLost(responseObject) {
        if (responseObject.errorCode !== 0) {
            console.log("onConnectionLost:" + responseObject.errorMessage);
        }
        client.connect({
            onSuccess: onConnect,
            userName: "wattmon",
            password: "wattmon_2018",
            cleanSession: true
        });
    }

    // called when a message arrives
    function onMessageArrived(message) {

        var channeldata = message.payloadString.split(',');
        if (objectList.AssetTypeName != null && $.trim(objectList.AssetTypeName.toLocaleLowerCase()) == "Gate".toLocaleLowerCase()) {
            GateBindData(message.destinationName, channeldata)
        }
        else if (objectList.AssetTypeName != null && $.trim(objectList.AssetTypeName.toLocaleLowerCase()) == "Signal".toLocaleLowerCase()) {
            SignalBindData(message.destinationName, channeldata)
        }
        else if (objectList.AssetTypeName != null && $.trim(objectList.AssetTypeName.toLocaleLowerCase()) == "POINT MACHINE".toLocaleLowerCase()) {

            PointMachineBindData(message.destinationName, channeldata);
        }
        else {
            BindData(message.destinationName, channeldata);
        }
    }

