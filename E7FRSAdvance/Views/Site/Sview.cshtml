@model Domain.AssetLister
@{
    ViewBag.Title = "SipView1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/assets/sip/css/rappid.css" rel="stylesheet" />
<link href="~/assets/sip/css/style.css" rel="stylesheet" />
<link href="~/assets/sip/css/theme-picker.css" rel="stylesheet" />
<link href="~/assets/sip/css/style.dark.css" rel="stylesheet" />
<link href="~/assets/sip/css/style.material.css" rel="stylesheet" />
<link href="~/assets/sip/css/style.modern.css" rel="stylesheet" />
<script src="~/assets/js/paho-mqtt.js"></script>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="~/assets/js/chart/echart/echarts.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
<style>

    #app {
        height: 800px
    }

    .card-fullscreen {
        z-index: 99;
        position: fixed;
        width: 100% !important;
        height: 100% !important;
        top: 0;
        right: 0;
        left: 0;
        bottom: 0;
        background-color: white;
    }

    .joint-paper-background, .joint-paper-grid, .joint-paper > svg {
        background-color: #010300
    }

    .handle {
        display: none !important;
    }

    .site {
        background-color: black;
        color: white;
        padding: 20px 20px 40px;
    }
</style>
<div class="container-fluid">

    <input type="hidden" id="hdnId" value="0" />
    <input type="hidden" id="hdnSiteId" value="@Model.SearchCriteria.SiteId" />
    <br />
    <div id="app" class="card-fullscreen">
        <div class="app-header">
            <div class="app-title" style="background-color:white;">
                <button class="btn btn-dark" onclick="fnReset(this)">Reset</button>
            </div>
            <div class="toolbar-container"></div>
        </div>
        <div class="site mt-2">
            <div class="pull-left">
                <img src="~/assets/images/cmenu.png" />
            </div>
            <div class="row">
                <div class="col-auto">
                    <a class="nav-link text-white" style="font-size:16px;font-weight:500;background:#4bacc6; border-radius:10px;">Remote Diagnostic </a>
                </div>
                <div class="col-auto" style="margin-left:-15px;">
                    <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #215968; border-radius: 10px;">And</a>
                </div>
                <div class="col-auto" style="margin-left:-15px;">
                    <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #484640; border-radius: 10px;">Predictive Maintenance System </a>
                </div>
                <div class="col-auto" style="margin-left:-15px;">
                    <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #4bacc6; border-radius: 10px;">
                        Site Name: @Model.mAssets[0].SiteName
                    </a>
                </div>
                <div class="col-sm-3" style="background-color:#0e0e26">
                    <a class="nav-link text-white">
                        <div class="media mb-2">
                            <label class="col-form-label m-r-10">Simulation mode</label>
                            <div class="media-body text-end icon-state">
                                <label class="switch">
                                    <input type="checkbox" id="chMaintenceMode"><span class="switch-state bg-primary"></span>
                                </label>
                            </div>
                            <label class="col-form-label m-l-10">Maintenace mode</label>
                        </div>
                    </a>
                </div>
            </div>
            <div class="row m-t-15">
                <div class="col-auto">
                    <a class="nav-link text-white" style="font-size: 16px; font-weight: 500; background: #404040; border-radius: 10px;">
                        <div>
                            Last Update:
                            @for (int i = 0; i < Model.SearchCriteria.ChannelList.Count; i++)
                            {
                                if (i == (Model.SearchCriteria.ChannelList.Count - 1))
                                {
                                    <span>@(i+1):</span>
                                    <span id="c@(i)"></span>
                                }
                                else
                                {
                                    <span>@(i+1):</span>
                                    <span id="c@(i)"></span><span> || </span>
                                }

                            }
                        </div>
                    </a>
                </div>
                <div class="col-auto">
                    <a class="nav-link text-white" id="gear-flash" style="font-size: 16px; font-weight: 500; background: #215968; border-radius: 10px; ">
                        Gear flashing :Active alerts
                    </a>
                </div>
                <div class="col-auto">
                    <a class="nav-link" id="roster-flash" style="font-size:16px;font-weight:600;background:#000;color:white;border:2px solid #7366ff">
                        Name Flashing :In current roster
                    </a>
                </div>
            </div>
        </div>
        <div class="app-body ">
            <div class="stencil-container" style="display:none"></div>
            <div class="paper-container" style="left:0px;right:0"></div>
            <div class="inspector-container" style="display:none"></div>
            <div class="navigator-container" style="display:none"></div>
        </div>
    </div>

</div>
@{
    var track = Model.mAssets.Where(x => x.AssetTypeName.Trim().ToLower() == "TRACK".Trim().ToLower()).ToList();
    var signal = Model.mAssets.Where(x => x.AssetTypeName.Trim().ToLower() == "SIGNAL".Trim().ToLower()).ToList();
    var point = Model.mAssets.Where(x => x.AssetTypeName.Trim().ToLower() == "POINT MACHINE".Trim().ToLower()).ToList();
    var gate = Model.mAssets.Where(x => x.AssetTypeName.Trim().ToLower() == "GATE".Trim().ToLower()).ToList();
    var axcounter = Model.mAssets.Where(x => x.AssetTypeName.Trim().ToLower() == "AXLE COUNTER".Trim().ToLower()).ToList();
    var busBar = Model.mAssets.Where(x => x.AssetTypeName.Trim().ToLower() == "Bus Bar".Trim().ToLower()).ToList();
}
<div class="modal bounceIn animated" id="modal-add-asset" tabindex="-1" role="dialog" data-bs-backdrop="static" aria-labelledby="modal-add-asset" style="overflow-y:hidden">
    <div class="modal-dialog" style="max-width:98%;">
        <div class="modal-content bradius4 modal-lg" style="max-width:98%;">

            <div class="modal-header">
                <h5 class="modal-title isEdit " style="width:400px;" id="myModalLabel"><span id="spHeader"></span></h5>
                <h6 class="btn btn-primary" id="prevM"></h6>
                <h6 class="btn btn-success" id="nextM" style="margin-left:10px;"></h6>
                <button type="button" style="position:absolute;right:80px;" id="indexScore"></button>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12">
                        <ul class="nav nav-tabs" id="myTab" role="tablist">
                            <li class="nav-item"><a class="nav-link active" id="home-tab" data-bs-toggle="tab" href="#home" role="tab" aria-controls="home" aria-selected="true">Live</a></li>
                            <li class="nav-item"><a class="nav-link" id="profile-tabs" data-bs-toggle="tab" href="#profile" role="tab" aria-controls="profile" aria-selected="false">Alert Analytics</a></li>
                            <li class="nav-item">
                                <a class="nav-link" id="contact-tab"
                                   data-bs-toggle="tab" href="#contact" role="tab" aria-controls="contact" aria-selected="false" onclick="fnGetGraph()">Graph</a>
                            </li>
                            <li class="nav-item"><a class="nav-link" id="event-tab" data-bs-toggle="tab" href="#event" role="tab" aria-controls="event" aria-selected="false">Event Log</a></li>
                            <li class="nav-item"><a class="nav-link text-white" id="alertLog-tab" data-bs-toggle="tab" href="#alertLog" role="tab" aria-controls="alertLog" aria-selected="false">Alarm</a></li>
                            <li class="nav-item error-code" style="display:none"><a class="nav-link" id="error-tab" data-bs-toggle="tab" href="#error" role="tab" aria-controls="error" aria-selected="false">Error Code</a></li>
                        </ul>
                        <div class="tab-content" id="myTabContent">
                            <div class="tab-pane fade active show" id="home" role="tabpanel" aria-labelledby="home-tab" style="margin-top:10px;">
                                <div class="row">
                                    <div class="col-sm-12" id="divT">
                                        <div class="card card-border ">
                                            <div class="card-header bg-primary">
                                                <h6 id="assetName" style="float:left">
                                                </h6>
                                                <div id="bell-icon" class="text-center bg-dark" style="border-top-right-radius: 15px;position:absolute;right:0;height:100%;line-height:4;width:50px;top:0">
                                                </div>
                                            </div>
                                            <div class="card-body" style="padding:5px;">
                                                <div class="tblAssetData">
                                                    <table class="table table-striped">
                                                        <tbody id="tblAttributeData31" class="tblAttributes tblAttributeData">
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-12" id="divP" style="display:none;max-height:600px;overflow-y:auto">

                                    </div>
                                </div>

                            </div>
                            <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab" style="margin-top:10px;">
                                <div class="row">
                                    <div class="col-sm-2">
                                        <label>From Date</label>
                                    </div>
                                    <div class="col-sm-4">

                                        <div class="input-group">
                                            <input type="text" class="datepicker-here form-control digits" data-language="en" id="alert-from-date">
                                            <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                                        </div>

                                    </div>
                                    <div class="col-sm-2">
                                        <label>To Date</label>
                                    </div>
                                    <div class="col-sm-4">
                                        <div class="input-group">
                                            <input type="text" class="datepicker-here form-control digits" data-language="en" id="alert-to-date">
                                            <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                                        </div>
                                    </div>

                                </div>
                                <div class="row" id="assetCount" style="margin-top:10px;">

                                </div>
                            </div>
                            <div class="tab-pane fade" id="contact" role="tabpanel" aria-labelledby="contact-tab" style="margin-top:10px;">
                                <div class="row">
                                    <div class="col-sm-12">
                                        <div class="pull-right" style="display:inline-flex;">
                                            <input type="hidden" id="hdnAssetId" value="0" />
                                            <input type="hidden" id="hdnSiteId" value="0" />
                                            <input type="hidden" id="selDatabase" value="MQTT" />
                                            <div class="btn-group btn-bar-rad">
                                                <button class="btn btn-outline-primary db1 active" id="mqtt" onclick="fnDBChanges(this,'MQTT')" data-name="MQTT" type="button">MQTT Db</button>
                                                <button class="btn btn-outline-primary db1" id="http" onclick="fnDBChanges(this,'HTTP')" data-name="HTTP" type="button">PLC LOG</button>
                                            </div>
                                            <div class="input-group mt20" id="fTime" style="width:200px;">
                                                <input id="tpFrom" type="text" class="form-control" />
                                                <span class="input-group-text"><i class="fa fa-calendar-times-o"></i></span>
                                            </div>
                                            <div class="input-group mt20" id="tTime" style="width:200px;">
                                                <input id="tpTo" type="text" class="form-control" />
                                                <span class="input-group-text"><i class="fa fa-calendar-times-o"></i></span>
                                            </div>
                                            <div class="theme-form">

                                                <div>
                                                    <input class="form-control" type="text" id="txtRange" name="daterange">
                                                </div>
                                            </div>
                                            <select class="form-control" style="width:200px;margin-right:10px;" id="sel" onchange="fnChange()">
                                                <option value="0">Today</option>
                                                <option value="-1">Yesterday</option>
                                                <option value="-7">Last 7 Day</option>
                                                <option value="-30">Last 30 Day</option>
                                                <option value="1">This Month</option>
                                                <option value="-60">Last Month</option>
                                            </select>
                                            @*<a  style="line-height:2;" class="text-white btn  btn btn-success" onclick="fnSearchGraph()">Search</a>*@

                                            <a id="btn-download-csv" onclick="GetDownloadCsv()" style="line-height:2;" title="download csv" class="text-white btn btn-dark m-r-10 "><i class="fa fa-upload"></i></a>
                                            <a id="btn-download" style="line-height:2;" href="#" class="text-white btn  btn btn-dark" download=""><i class="fa fa-camera"></i></a>

                                        </div>


                                    </div>
                                    <div class="col-sm-12">
                                        <div class="apache-cotainer" id="area-echart" style="margin-top:60px;">

                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="tab-pane fade" id="event" role="tabpanel" aria-labelledby="event-tab" style="margin-top:10px;">
                                <div id="eventlog">

                                </div>
                            </div>
                            <div id="alertLog" class="tab-pane fade" role="tabpanel" aria-labelledby="alertLog-tab" style="margin-top:10px;">

                            </div>
                            <div class="tab-pane fade error-code" id="error" role="tabpanel" aria-labelledby="error-tab" style="margin-top:10px;">
                                <div class="row">
                                    <div class="col-sm-3 mb10">
                                        <label>From Date</label>
                                        <input type="text" class="form-control" data-language="en" id="txtFromDate" />
                                    </div>
                                    <div class="col-sm-3 mb10">
                                        <label>To Date</label>
                                        <input type="text" class="form-control" data-language="en" id="txtToDate" />
                                    </div>
                                    <div class="col-sm-3 mb10 m-t-30">
                                        <a class="btn btn-success" onclick="Search()">Search</a>
                                    </div>
                                    <div class="col-sm-12" id="errorcode">

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<div class="modal bounceIn animated" id="modalSmslogs" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">SMS Log</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12 text-end mb-2">
                        <a class="btn btn-outline-dark-2x" onclick="DownloadChildCsvFile()">Download</a>
                    </div>
                    <div class="col-sm-12" id="model-div">

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

