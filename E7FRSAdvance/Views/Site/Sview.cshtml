    function BindBusBarSimulation(basePath, data) {
        $.each(bJosn, function (id, item) {
            if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                var acValue = 0;
                var dcValue = 0;
                $.each(item.assetAttributes, function (idx, inItem) {
                    var str1 = basePath.toLowerCase();
                    var str2 = "";
                    if (inItem.AssetInfoChannel != null && inItem.AssetInfoChannel != "") {
                        str2 = inItem.AssetInfoChannel;
                    }
                    if (str2 != null && str2 != "" && str1.indexOf(str2) != -1) {
                        var infoValue = inItem.AssetInfoValue;
                        if (infoValue != null) {
                            if (infoValue == 95 || infoValue == 112 || infoValue == 258) {
                                var infoMultiplication = inItem.Multiplication;
                                var dataValue = data[infoValue];
                                if (infoMultiplication != null) {
                                    var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                    var v = (Math.round(mainData * 100) / 100).toFixed(1);
                                    if (inItem.Title == "24 V") {
                                        dcValue = v;
                                    } else if (inItem.Title == "110V") {
                                        acValue = v;
                                    }
                                } else {
                                    var v = (Math.round(dataValue * 100) / 100).toFixed(1)
                                    if (inItem.Title == "24 V") {
                                        dcValue = v;
                                    } else if (inItem.Title == "110V") {
                                        acValue = v;
                                    }
                                }

                                $.each(parseJson.cells, function (id, val) {
                                    if ('label' in val.attrs && 'text' in val.attrs.label) {
                                        if (val.type == "examples.BusBar") {
                                            if ($.trim(fnTrimDynamicValue(val.attrs.label.text)) == $.trim(item.Name)) {
                                                if (acValue > 0 && dcValue > 0) {
                                                    val.attrs.label.text = dcValue + " || " + $.trim(item.Name) + " || " + acValue + "v";
                                                } else if (dcValue > 0 && acValue <= 0) {
                                                    val.attrs.label.text = dcValue + " || " + $.trim(item.Name)
                                                }
                                                else if (dcValue <= 0 && acValue > 0) {
                                                    val.attrs.label.text = $.trim(item.Name) + " || " + acValue + "v";
                                                }

                                                if (acValue < 110 && acValue > 0) {
                                                    val.attrs.label.fill = "#ff0000";
                                                }
                                                else {
                                                    val.attrs.label.fill = "#ffffff";
                                                }

                                                if (dcValue < 20 && dcValue > 0) {
                                                    val.attrs.label.fill = "#ff0000";
                                                }
                                                else {
                                                    val.attrs.label.fill = "#ffffff";
                                                }
                                            }
                                        }
                                    }
                                });
                            }


                        }
                    }
                });
            }
        });

        app.graph.fromJSON(parseJson);
    }

