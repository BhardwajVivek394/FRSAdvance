    function GetSipView() {
        $.ajax({
            url: '/Site/GetSipView',
            type: 'Post',
            data: '{siteId:' + $("#hdnSiteId").val() + '}',
            contentType: 'application/json',
            success: function (data) {
                if (data != null && data.Id > 0) {
                    parseJson = JSON.parse(data.SipView1);
                    app.graph.fromJSON(parseJson);
                    loadColor();

                    setTimeout(function () {
                        MqqtConnectSimulation();
                    },3000);
                }
                else {
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            },
            error: function (response) {
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function BindAssetData(item) {

        $(".tblAttributeData").empty();
        var html = "";
        $.each(item.assetAttributes, function (id, val) {

            if (item.AssetTypeName.toLocaleLowerCase() == "SIGNAL".toLocaleLowerCase()) {
                if (id == 0) {
                    html += "<tr>";
                    html += "<td id='signal" + item.Id + "' colspan='2' class='text-center'></td>";
                    html += "</tr>";
                    html += "<tr>";
                    html += "<td class='signalC" + item.Id + "'></td>";
                    html += "<td class='signalV" + item.Id + "'></td>";
                    html += "</tr>";
                }
            }
            else {
                html += "<tr>";
                html += "<td style='width:50%'>" + val.Title + "</td>";
                var atId = "hdnAttributeData" + val.Id + "" + item.Id;
                html += "<td style='width:50%' class=" + atId + "></td>";
                html += "</tr>";
            }
        });

        if (item.AssetTypeName.toLocaleLowerCase() == "Track".toLocaleLowerCase()) {
            html += "<tr>";
            html += "<td style='width:50%'> Index Score</td>";

            if (item.IndexScore < 7) {
                html += "<td style='width:50%' class='text-danger'>" + item.IndexScore + "</td>";
            }
            else {
                html += "<td style='width:50%'>" + item.IndexScore + "</td>";
            }

            html += "</tr>";

            html += "<tr class='leakge'>";
            html += "<td style='width:50%'>Leakage</td>";
            var lId = "lekage" + item.Id;
            html += "<td style='width:50%' class='lekage" + lId + "'></td>";
            html += "</tr>";

            html += "<tr >";
            html += "<td style='width:50%'>HEALTH</td>";
            var checkHealth = "checkHealth" + item.Id +" tdHealth";
            html += "<td style='width:50%' data-id=" + item.Id + " class=" + checkHealth + ">";
            if (item.IsAlarm)
              {
                html += "<span style='cursor:pointer' onclick='GetLogByAssetId(" + item.Id + ")' class='text-danger'>Alarm</span>";
               }
               else
              {
                html += "<span class='text-success'>Ok</span>";
            }
            html+="</td> ";
            html += "</tr>";

        }
        if (item.AssetTypeName.toLocaleLowerCase() == "Gate".toLocaleLowerCase()) {
            html += "<tr>";
            html += "<td style='width:50%'> Index Score</td>";

            if (item.IndexScore < 7) {
                html += "<td style='width:50%' class='text-danger'>" + item.IndexScore + "</td>";
            }
            else {
                html += "<td style='width:50%'>" + item.IndexScore + "</td>";
            }
        }
        if (item.AssetTypeName.toLocaleLowerCase() == "AXLE COUNTER".toLocaleLowerCase()) {
            $(".error-code").show();

            var now = new Date();
                 var day = ("0" + now.getDate()).slice(-2);
                                var month = ("0" + (now.getMonth() + 1)).slice(-2);
                                var today = (month) + "/" + (day) + "/" + now.getFullYear();



            $('#txtFromDate').val(today)
            $('#txtToDate').val(today);
            fnGetErrorcode(item.Id);
        }
        $(".tblAttributeData").append(html);

        MqqtConnect();
    }

    function BindPointMachineAsset(item) {

