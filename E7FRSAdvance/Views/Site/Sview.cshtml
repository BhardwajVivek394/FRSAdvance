@{
    var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    serializer.MaxJsonLength = Int32.MaxValue;
}
<script>
    var app = null;
    var json = null;
    var objectList = null;
    var client = null;
    var client1 = null;
    var mQQTPath = "";
    var channels = [];
    var isGraphLoad = false;
    var parseJson = null;

    var tJosn = null;
    var sJosn = null;
    var pJosn = null;
    var gJosn = null;
    var aJosn = null;
    var bJosn = null;
    var clearTime;
    var activeAlerts = null;
    var mQTT = null;
    var fontcolor = [

        '#ff0000',
        '#fff'
    ];
    var color = [

        '#7366ff',
        '#a927f9',
        '#4bacc6',
        '#215968',
        '#b75d32',
        '#31d0c6'
    ];
    $(document).ready(function () {

        json = @Html.Raw(serializer.Serialize(Model));

        tJosn = @Html.Raw(serializer.Serialize(track));
        sJosn = @Html.Raw(serializer.Serialize(signal));
        pJosn = @Html.Raw(serializer.Serialize(point));
        gJosn = @Html.Raw(serializer.Serialize(gate));
        aJosn = @Html.Raw(serializer.Serialize(axcounter));
        bJosn = @Html.Raw(serializer.Serialize(busBar));

        mQTT=@Html.Raw(serializer.Serialize(Model.MQTTDetail));

        if (json.SearchCriteria.MQTTPaths != null && json.SearchCriteria.MQTTPaths.length > 0)
            mQQTPath = json.SearchCriteria.MQTTPaths[0];

        if (json.SearchCriteria.ChannelList != null && json.SearchCriteria.ChannelList.length > 0) {
            channels = json.SearchCriteria.ChannelList;
        }

        joint.setTheme('modern');
        app = new App.MainView({ el: '#app' });
        themePicker = new App.ThemePicker({ mainView: app });
        themePicker.render().$el.appendTo(document.body);
        //window.addEventListener('load', function () {
        //    app.graph.fromJSON(JSON.parse(App.config.sampleGraphs.emergencyProcedure));
        //});

        $("#chMaintenceMode").click(function () {

            if ($(this).is(":checked")) {
                fnMaintenaceMode();
            }
            else {
                //location.reload();
                fnMaintenaceModeOff();
            }
        });

        $(".toolbar-container .joint-toolbar-group").each(function () {

            if ($(this).attr("data-group") == "zoom") {

            }
            else {
                $(this).remove();
            }
        })

        GetSipView();


        app.paper.on('cell:pointerdown', function (ele) {
            $(".joint-free-transform,.handles").remove();
            $(".resize").hide().remove();
            $(".no-rotation").hide().remove();
            $(".rotate").hide().remove();

            $("#assetName").empty();
            $(".tblAttributeData").empty();
            $("#eventlog").empty();
            $("#assetCount").empty();
            $("#errorcode").empty();
            $(".error-code").hide();
            $("#divT").show();
            $("#divP").hide();
            $('[href="#home"]').tab('show');
            $("#alertLog-tab").removeClass("bg-success")
            $("#alertLog-tab").removeClass("bg-dander")
            if (chart != null && chart != "" && chart != undefined) {
                chart.dispose();
            }
            objectList = null;
            if ('label' in ele.model.attributes.attrs && 'text' in ele.model.attributes.attrs.label) {
                if (ele.model.attributes.attrs.label.text != undefined && ele.model.attributes.attrs.label.text != "") {
                    $("#selDatabase").val("MQTT");
                    $("#mqtt").addClass("active");
                    $("#http").removeClass("active");
                    $.each(json.mAssets, function (id, item) {

                        if ($.trim(item.AssetTypeName.toLocaleLowerCase()) == "SIGNAL".toLocaleLowerCase()) {

                            if ($.trim(ele.model.attributes.attrs.label.text).toLocaleLowerCase().indexOf($.trim(item.Name).toLocaleLowerCase()) != -1) {
                                objectList = item;
                                $("#spHeader").text(item.AssetTypeName + "-" + item.Name);
                                $("#assetName").text(item.AssetTypeName + "-" + item.Name);
                                if (item.IndexScore < 7) {
                                    $("#indexScore").html("Index-score: " + item.IndexScore).addClass("btn btn-danger").removeClass("btn-success");
                                }
                                else {
                                    $("#indexScore").html("Index-score: " + item.IndexScore).addClass("btn btn-success").removeClass("btn-danger");
                                }
                                if (item.UnderMaintence != null && item.UnderMaintence == true) {
                                    $("#bell-icon").html('<div class="text-center" > <i class="fa fa-bell-slash" onclick="fnUnderMaintenance(' + item.Id + ', this)" data-id=' + item.Id + ' style="font-size:16px;cursor:pointer;"></i></div>');
                                }
                                else {
                                    $("#bell-icon").html('<div class="text-center" > <i class="fa fa-bell" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance(' + item.Id + ', this)" data-id=' + item.Id + '></i></div>');

                                }
                                isGraphLoad = false;
                                BindAssetData(item)
                                fnGetRosterHistory(item.Id);
                                fnGetSmsLog(item.Id);

                                var now = new Date();
                                var day = ("0" + now.getDate()).slice(-2);
                                var month = ("0" + (now.getMonth() + 1)).slice(-2);
                                var today = (month) + "/" + (day) + "/" + now.getFullYear();

                                var monthp = ("0" + (now.getMonth())).slice(-2);

                                var pretoday = (month) + "/" + (day) + "/" + now.getFullYear();

                                $("#alert-from-date").val(pretoday);
                                $("#alert-to-date").val(today);

                                fnGetAlertCountByAsset(item.AssetTypeId, item.Name, item.Id);
                                $('#tpTo').val('23:59');
                                $('#tpFrom').val('00:00');

                                //GetGraph(new Date().toLocaleDateString(), new Date().toLocaleDateString());
