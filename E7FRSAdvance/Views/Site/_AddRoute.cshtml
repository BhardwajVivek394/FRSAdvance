@model Domain.RouteSiteLister
<div class="row">
    <div class="col-sm-12 text-right">
        <a id="btnAddRoute" class="btn btn-success btn-sm btn-quirk" onclick="AddRow()"><span class="fa fa-plus"></span> Add Route</a>
    </div>
</div>
<div class="row mt10">
    <div class="col-sm-12">
        <div class="table-responsive" style="max-height: 620px;">
            <table class="table table-bordered">
                <tbody id="routeBody">
                    @if (Model.RouteSites != null && Model.RouteSites.Count > 0)
                    {
                        int i = 1;
                        foreach (var item in Model.RouteSites)
                        {
                            <tr data-rowId="@i">
                                <input type="hidden" id="hdnRoute@(i)" value="@item.Id" />
                                <td class="text-center width60" style="vertical-align:middle">
                                    <a style="cursor:pointer"><i class="fa fa-plus text-vision RouteTracks" data-Id="@item.Id" onclick="GetRouteTracks('@item.Id',this)"></i></a>
                                </td>
                                <td class="text-center width60" style="vertical-align:middle">
                                    <a data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Delete" style="cursor:pointer"><i class="glyphicon glyphicon-trash text-danger" onclick="DeleteRouteById('@item.Id', this)"></i></a>
                                </td>
                                <td>
                                    <input type="text" id="routeName@(i)" class="form-control" value="@item.RouteName" placeholder="Route Name" />
                                </td>
                                @*<td>
                                        <select id="routeTrack@(i)" class="form-control routeTrack" style="width: 100%" data-placeholder="Choose Track..." multiple>
                                            @if (Model.SearchCriteria.Assets != null && Model.SearchCriteria.Assets.Count > 0)
                                            {
                                                foreach (var asset in Model.SearchCriteria.Assets)
                                                {
                                                    if (item.RouteTracks.Where(x => x.AssetId == asset.Id).Count() > 0)
                                                    {
                                                        <option value="@asset.Id" selected>@asset.Name</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@asset.Id">@asset.Name</option>
                                                    }
                                                }
                                            }
                                        </select>
                                    </td>*@
                                <td class="text-center width60">
                                    <button type="button" onclick="fnSaveRoute('@i')" class="btn btn-success btn-quirk">Add</button>
                                </td>
                            </tr>
                            <tr id="trRouteTracks@(item.Id)" style="display:none;">
                            </tr>
                            i++;
                        }
                    }
                    else
                    {
                        <tr data-rowId="0">
                            <input type="hidden" id="hdnRoute0" value="0" />
                            <td class="text-center width60" style="vertical-align:middle">
                                <a style="cursor:pointer"><i class="fa fa-plus text-vision RouteTracks" data-Id="0" onclick="GetRouteTracks('0',this)"></i></a>
                            </td>
                            <td class="text-center width60" style="vertical-align:middle">
                                <a data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Delete" style="cursor:pointer"><i class="glyphicon glyphicon-trash text-danger" onclick="DeleteRouteById('0',this)"></i></a>
                            </td>
                            <td>
                                <input type="text" id="routeName0" class="form-control" placeholder="Route Name" />
                            </td>
                            @*<td>
                                    <select id="routeTrack0" class="form-control routeTrack" style="width: 100%" data-placeholder="Choose Track..." multiple>
                                        @if (Model.SearchCriteria.Assets != null && Model.SearchCriteria.Assets.Count > 0)
                                        {
                                            foreach (var item in Model.SearchCriteria.Assets)
                                            {
                                                <option value="@item.Id">@item.Name</option>
                                            }
                                        }
                                    </select>
                                </td>*@
                            <td class="text-center width60">
                                <button type="button" onclick="fnSaveRoute('0')" class="btn btn-success btn-quirk">Add</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
