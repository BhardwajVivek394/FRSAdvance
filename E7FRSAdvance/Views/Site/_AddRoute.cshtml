        //            temp += "<a data-placement='top' data-toggle='tooltip' class='tooltips' data-original-title='Delete' style='cursor: pointer'><i class='glyphicon glyphicon-trash text-danger' onclick='DeleteRouteById(" + 0 + ",this)'></i></a>";
        //            temp += "</td>";
        //            temp += "<td style='width:250px'><input type='text' id='routeName" + rowId + "' class='form-control' placeholder='Route Name' /></td>";
        //            temp += "<td>";
        //            temp += "<select id='routeTrack" + rowId + "' class='form-control routeTrack' style='width:100%' data-placeholder='Choose Track...' multiple>";
        //            $.each(data, function (id, val) {
        //                temp += "<option value=" + val.Id + ">" + val.Name + "</option>";
        //            });
