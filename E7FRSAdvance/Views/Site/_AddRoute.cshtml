    function fnSaveRoute(rowId) {
        var RouteSite = {};
        RouteSite.Id = $("#hdnRoute" + rowId).val();
        RouteSite.SiteId = $("#hdnSiteId").val();
        RouteSite.RouteName = $("#routeName" + rowId).val();
        //RouteSite.RouteTrack = $("#routeTrack" + rowId).val();
        if (RouteSite.RouteName == null || RouteSite.RouteName == undefined || RouteSite.RouteName == "") {
            CommonNotification("ERROR", "Please enter route name!", "error");
        } else {
            $.ajax({
                url: '/Site/SaveRouteSite',
                type: 'Post',
                data: '{mRouteSite:' + JSON.stringify(RouteSite) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data === true) {
                        CommonNotification("SUCCESS", "Route site has been saved.", "success");
                        $("#frmRoute").submit();
                    } else {
                        CommonNotification("ERROR", "Internal server error.", "error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
    }

