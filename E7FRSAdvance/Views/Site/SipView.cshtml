                                    $("#trSignal" + item.Id).show();
                                }
                                if (inItem.Title.indexOf("RG V") != -1) {

                                    rgv = v;
                                    if ($.trim($("#signal" + item.Id + "").html()).length > 0 && $.trim($("#signal" + item.Id + "").html()).indexOf("SR-1.jpg") != -1) {
                                        $(".signalV" + item.Id + "").html("V :" + v + " v");
                                    }
                                }
                                if (inItem.Title.indexOf("DG mA") != -1 && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
