<script>
    var parseJson = null;
    var isInteractive = false;
    var appModel = null;
    var pointMachineEventTime = '';
    appModel = new App.MainView({ el: '#divMapExpand' });
    var circuitjson = @Html.Raw(Json.Encode(Model));
    var assetJson = JSON.parse('@Html.Raw(Json.Encode(ViewBag.Asset))');
    var attributeJson = JSON.parse('@Html.Raw(Json.Encode(ViewBag.AssetAttributes))');
    var cardLines = JSON.parse('@Html.Raw(Json.Encode(mCardLines))');

    var pointMachineDataJsonN = JSON.parse('@Html.Raw(Json.Encode(mPointMachineJsonN))');
    var pointMachineDataJsonR = JSON.parse('@Html.Raw(Json.Encode(mPointMachineJsonR))');
    var pointScale20 = '@E7FRSAdvance.Utility.Utility.PMScale.Scale_20.GetHashCode()';
    var pointScale100 = '@E7FRSAdvance.Utility.Utility.PMScale.Scale_100.GetHashCode()';
    $(document).on('hidden.bs.modal', '.modal', function () {
        // Check if any other modal is still visible
        if ($('.modal.show').length > 0) {
            $('body').addClass('modal-open');
        }
    });         

    $(document).ready(function () {
        joint.setTheme('modern');
        parseJson = JSON.parse(circuitjson.CircuitDiagram);
        appModel.graph.fromJSON(parseJson);

        $("input[name=zoom-slider]").val(20);
        $("input[name=zoom-slider]").trigger('change');

        appModel.paper.on('cell:pointerup', function (cellView) {
            // We don't want a Halo for links.
            if (cellView.model instanceof joint.dia.Link) return;
            var halo = new joint.ui.Halo({ cellView: cellView });
            halo.remove();
        });

        appModel.paper.on('cell:pointerup', function (cellView) {
            // We don't want to transform links.
            if (cellView.model instanceof joint.dia.Link) return;

            var freeTransform = new joint.ui.FreeTransform({ cellView: cellView });
            freeTransform.remove();
        });

        appModel.paper.on('cell:pointerclick', function (cellView) {

            if ('label' in cellView.model.attributes.attrs && 'text' in cellView.model.attributes.attrs.label) {
                if (cellView.model.attributes.attrs.label.text != undefined && cellView.model.attributes.attrs.label.text != "")
                {
                    if ($.trim(cellView.model.attributes.attrs.label.text).startsWith('(A)NW V') || $.trim(cellView.model.attributes.attrs.label.text).startsWith('(A)RW V')) {
                        fnShowSignatureGraghCircuit(assetJson.Id, 'AV');
                    }
                    else if ($.trim(cellView.model.attributes.attrs.label.text).startsWith('(A)NW C') || $.trim(cellView.model.attributes.attrs.label.text).startsWith($.trim('(A)RW C'))) {
                        fnShowSignatureGraghCircuit(assetJson.Id, 'AC');
                    }
                    else if ($.trim(cellView.model.attributes.attrs.label.text).startsWith('(B)NW V') || $.trim(cellView.model.attributes.attrs.label.text).startsWith('(B)RW V')) {
                        fnShowSignatureGraghCircuit(assetJson.Id, 'BV');
                    }
                    else if ($.trim(cellView.model.attributes.attrs.label.text).startsWith('(B)NW C') || $.trim(cellView.model.attributes.attrs.label.text).startsWith($.trim('(B)RW C'))) {
                        fnShowSignatureGraghCircuit(assetJson.Id, 'BC');
                    }
                }

            }

        });

    //    const svg = $('.paper-container').find('svg');
    //    let defs = svg.find('defs');
    //    if (defs.length === 0) {
    //        defs = $('<defs></defs>').appendTo(svg);
    //    }
    //    defs.append(`
    // <filter id="dropShadow" x="-20%" y="-20%" width="140%" height="140%">
    //    <feDropShadow dx="2" dy="2" stdDeviation="3" flood-color="black" flood-opacity="0.4" />
    //</filter>`);


        if ($('#modalAssetTypeCircuitDiagram').hasClass('show')) {

            fnGetPointMachineData('@asset.Id');
        }

        setTimeout(() => {

            var assetTypeId = $('#hdnCircuitDiagramAssetTypeId').val();
            if (assetTypeId == 2 || assetTypeId == 3) {
               // $(".paper-scroller-background").css("width", "1550px");
                let paper = $('.paper-scroller-background').find('div:eq(0)');
                paper.css("left", "0px");
                paper.css("top", "0px");
                paper.css("width", "1550px");


                let height = paper.height();
                let width = paper.width();

                $(".paper-scroller-background").css("width", width + "px");
                $(".paper-scroller-background").css("height", height + "px");

            } else {
                let paper = $('.paper-scroller-background').find('div:eq(1)');

                let height = paper.height();
                let width = paper.width();

                $(".paper-scroller-background").css("width", width + "px");
                $(".paper-scroller-background").css("height", height + "px");

                $('.joint-paper-scroller .joint-theme-default').scrollLeft(0);
            }
        }, 500);


        setInterval(function () {
            if ($('#modalAssetTypeCircuitDiagram').hasClass('show')) {
                fnGetFRSAlertList();

            }
        }, 10000);

        let pointIntervalId = setInterval(function () {
            if ($('#modalAssetTypeCircuitDiagram').hasClass('show')) {

                fnGetPointMachineData('@asset.Id');
            }
        }, 20000);

        $('#btnCircuitClose').click(function () {
            clearInterval(pointIntervalId);
        });
    });

    function fnShowSignatureGraghCircuit($this) {
        var lastdate = new Date();
        var firstDay = new Date();
        var assetId = assetJson.Id;
        var type = $($this).data('type');
        var eventTime = $($this).data('time');
        //alert('Hello')
        //var lastDay = new Date(date.getFullYear(), date.getMonth() + 1, 0);
        $("#loader").show();
        $.ajax({
            url: '/Site/GetPointMachineCurrentGraph',
            type: 'Post',
            data: '{assetId:' + assetJson.Id + ',startDate:"' + firstDay.toLocaleDateString() + '",endDate:"' + lastdate.toLocaleDateString() + '"}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                if (data != null) {
                    $(data).each(function (d, val) {
                        if (val.Date != '' && val.Date.includes(eventTime)) {

                            if (type == "AV" || type == "BV") {
                                fnBindSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                            } else {
                                if (type.includes('A')) {
                                    if (val.Direction.toLowerCase() == "normal" && assetJson.MachineAReverseScale == pointScale20) {
                                        fnBindCombineSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                                    }
                                    else if (val.Direction.toLowerCase() == "reverse" && assetJson.MachineAReverseScale == pointScale20) {
                                        fnBindCombineSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                                    } else {
                                        fnBindSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                                    }
                                } else {
                                    if (val.Direction.toLowerCase() == "normal" && assetJson.MachineBReverseScale == pointScale20) {
                                        fnBindCombineSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                                    }
                                    else if (val.Direction.toLowerCase() == "reverse" && assetJson.MachineBReverseScale == pointScale20) {
                                        fnBindCombineSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                                    } else {
                                        fnBindSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                                    }
                                }


                            }
                        }

                    });

                    //$('#modal-graph').on('show.bs.modal', function () {
                    //    let zIndex = 1050 + ($('.modal:visible').length * 10);
                    //    $(this).css('z-index', zIndex);
                    //    setTimeout(function () {
                    //        $('.modal-backdrop').not('.stacked').first().css('z-index', zIndex - 1).addClass('stacked');
                    //    }, 0);
                    //});
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }

    function BindCircuitTrackSimulation(basePath, data) {

        setTimeout(function () {

            if ($("#circuitDiagramLiveGif").attr("src") != '/assets/images/liveGif.gif') {
                $("#circuitDiagramLiveGif").attr("src", "/assets/images/Live_green.gif");

            }
            var d = new Date();
            var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
            $("#circuitDiagramLiveTimeStamp").html('Last Update: ' + time);


            if (parseJson != null && parseJson != undefined && parseJson != '') {
                $.each(json.mAssets, function (id, item) {
                    if (item.Id == parseInt(assetJson.Id)) {
                        if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                            $.each(item.assetAttributes, function (idx, inItem) {
                                var str1 = basePath.toLowerCase();
                                var str2 = "";
                                if (inItem.AssetInfoChannel != null && inItem.AssetInfoChannel != "") {
                                    str2 = inItem.AssetInfoChannel;
                                }
                                if (str2 != null && str2 != "" && str1.indexOf(str2) != -1) {

                                    var infoValue = inItem.AssetInfoValue;
                                    var infoMultiplication = inItem.Multiplication;
                                    if (infoValue != null) {

                                        var dataValue = data[infoValue];
                                        if (infoMultiplication != null) {
                                            $.each(parseJson.cells, function (id, val) {
                                                if ('label' in val.attrs && 'text' in val.attrs.label) {

                                                    var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                                    var v = ((mainData * 100) / 100).toFixed(1);
                                                    if (val.type == "examples.Label") {
                                                        var attrName = inItem.Title;
                                                        var romovebracketAttr = inItem.Title;
                                                        if (inItem.AliasName != null && inItem.AliasName != undefined && inItem.AliasName != '') {
                                                            attrName = inItem.AliasName;
                                                            romovebracketAttr = inItem.AliasName.replace(/\(.*?\)/, '');

                                                        }
                                                        if ($.trim(val.attrs.label.text).startsWith($.trim(romovebracketAttr))) {

                                                            var attrNameStr = $.trim(attrName) + " : " + v;
                                                            val.attrs.label.text = attrNameStr.replaceAll('(', '\n(');
                                                            val.attrs.label.fill = "#222138";
                                                        }
                                                    }

                                                    if ($.trim(val.attrs.label.text) == 'LCBOXFEED') {

                                                        if (cardLines != null && cardLines != undefined && cardLines.length > 0) {
                                                            $(cardLines).each(function (d, data) {
                                                                if (data.AttributeName == 'If mA') {
                                                                    var splitClu = data.ClusterName.split("/");
                                                                    val.attrs.label.text = splitClu[splitClu.length - 1];

                                                                }
                                                            });

                                                        }
                                                    }

                                                    if ($.trim(val.attrs.label.text) == 'LCBOXRELAY') {

                                                        if (cardLines != null && cardLines != undefined && cardLines.length > 0) {
                                                            $(cardLines).each(function (d, data) {
                                                                if (data.AttributeName == 'Ir mA') {
                                                                    var splitClu = data.ClusterName.split("/");
                                                                    val.attrs.label.text = splitClu[splitClu.length - 1];

                                                                }
                                                            });

                                                        }
                                                    }

                                                    if ($.trim(val.attrs.label.text) == 'LKGVAL') {
                                                        var lekageValue = $('.lekage' + item.Id).text();
                                                        val.attrs.label.text = lekageValue;
                                                    }
                                                }

                                            });
                                        }
                                    }
                                }
                            });
                        }

                        if (attributeJson != null && attributeJson != undefined) {

                            $.each(attributeJson, function (idx, inItem) {

                                $.each(parseJson.cells, function (id, val) {

                                    if ('label' in val.attrs && 'text' in val.attrs.label) {
                                        if (val.type == "examples.Label") {
                                            var attrName = inItem.Title;
                                            if (inItem.AliasName != null && inItem.AliasName != undefined && inItem.AliasName != '') {
                                                attrName = inItem.AliasName;
                                            }
                                            if ($.trim(val.attrs.label.text).startsWith($.trim(attrName))) {
                                                var value = 0;
                                                if (attrName == 'RTC VAR RES(ohm)') {
                                                    value = $('.RTCVARRES' + item.Id).text();

                                                } else if (attrName == 'VTC VAR RES(V)') {
                                                    value = $('.VTCVARRES' + item.Id).text();
                                                }

                                                val.attrs.label.text = $.trim(attrName) + " :\n" + value;


                                            }
                                        }
                                        else {

                                        }
                                    }

                                });
                            });
                        }
                    }
                });

                appModel.graph.fromJSON(parseJson);
            }

        }, 5000);




    }

    function BindCircuitSignalSimulation(basePath, data) {

        var d = new Date();
        var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
        $("#circuitDiagramLiveTimeStamp").html('Last Update: ' + time);


        if ($("#circuitDiagramLiveGif").attr("src") != '/assets/images/liveGif.gif')
        {
            $("#circuitDiagramLiveGif").attr("src", "/assets/images/Live_green.gif");

        }

        setTimeout(function () {
            if (parseJson != null && parseJson != undefined && parseJson != '') {
                $.each(parseJson.cells, function (id, val) {

                    if (val.type == "examples.SingleCircle") {
                        val.attrs.path.fill = "#33334e";

                    }
                });
                appModel.graph.fromJSON(parseJson);

                $.each(json.mAssets, function (id, item) {
                    if (item.Id == parseInt(assetJson.Id)) {
                        if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                            $.each(item.assetAttributes, function (idx, inItem) {
                                var str1 = basePath.toLowerCase();
                                var str2 = "";
                                if (inItem.AssetInfoChannel != null && inItem.AssetInfoChannel != "") {
                                    str2 = inItem.AssetInfoChannel;
                                }
                                if (str2 != null && str2 != "" && str1.indexOf(str2) != -1) {

                                    var infoValue = inItem.AssetInfoValue;
                                    var infoMultiplication = inItem.Multiplication;
                                    if (infoValue != null) {

                                        var dataValue = data[infoValue];
                                        if (infoMultiplication != null) {
                                            $.each(parseJson.cells, function (id, val) {
                                                if ('label' in val.attrs && 'text' in val.attrs.label) {

                                                    var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                                    var v = ((mainData * 100) / 100).toFixed(1);
                                                    if (val.type == "examples.Label") {
                                                        var attrName = inItem.Title;
                                                        if (inItem.AliasName != null && inItem.AliasName != undefined && inItem.AliasName != '') {
                                                            attrName = inItem.AliasName;
                                                        }
                                                        if ($.trim(val.attrs.label.text).startsWith($.trim(attrName))) {
                                                            val.attrs.label.text = $.trim(attrName) + " : " + v
                                                            val.attrs.label.fill = "#222138";
                                                        }
                                                    }
                                                }

                                                if (val.type == "examples.Text") {
                                                    if (val.attrs != null && val.attrs.label != null && val.attrs.label != undefined && val.attrs.label.text != null && val.attrs.label.text != undefined) {
                                                        if ($.trim(val.attrs.label.text) == 'SLCBOX') {

                                                            if (cardLines != null && cardLines != undefined && cardLines.length > 0) {
                                                                $(cardLines).each(function (d, data) {
                                                                    if (data.AttributeName == 'RG mA') {
                                                                        var splitClu = data.ClusterName.split("/");
                                                                        val.attrs.label.text = splitClu[splitClu.length - 1];

                                                                    }
                                                                });

                                                            }
                                                        }
                                                    }

                                                }


                                                if (val.type == "examples.SingleCircle") {
                                                    var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                                    var v = ((mainData * 100) / 100).toFixed(1);

                                                    if (val.attrs != null && val.attrs.label != null && val.attrs.label != undefined && val.attrs.label.text != null && val.attrs.label.text != undefined) {
                                                        if (val.attrs.label.text == "RG mA" && inItem.Title == "RG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                                            val.attrs.path.fill = "#FF0E0E";
                                                            //val.attrs.label.fill = "#FF0E0E";

                                                        }
                                                        else if (val.attrs.label.text == "DG mA" && inItem.Title == "DG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                                            val.attrs.path.fill = "#00FF00";
                                                            //val.attrs.label.fill = "#00FF00";

                                                        }
                                                        else if (val.attrs.label.text == "HG mA" && inItem.Title == "HG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                                            val.attrs.path.fill = "#FFBF00";
                                                            //val.attrs.label.fill = "#FFBF00";
                                                        }
                                                        else if (val.attrs.label.text == "HHG mA" && inItem.Title == "HHG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                                            val.attrs.path.fill = "#FFBF00";
                                                            //val.attrs.label.fill = "#FFBF00";

                                                        }
                                                    }

                                                }
                                            });
                                        }
                                    }
                                }
                            });
                        }

                    }

                });

                appModel.graph.fromJSON(parseJson);
            }

        }, 5000);



    }

    function BindCircuitDataLoggerSimulation(basePath, data) {
        //Bind Datalogger Attribute
        if (parseJson != null && parseJson != undefined && parseJson != '') {
            $.each(json.mAssets, function (id, item) {
                if (item.Id == parseInt(assetJson.Id)) {
