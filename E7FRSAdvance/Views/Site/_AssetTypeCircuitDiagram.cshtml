@model Domain.AssetTypeCircuitDiagram

@{

    var asset = ViewBag.Asset as Domain.Asset;
    var mPointMachineJsonN = new Domain.PointMachineJson();
    var mPointMachineJsonR = new Domain.PointMachineJson();
    var mCardLines = new List<Domain.CardLine>();
    if (ViewBag.PointMachineDataN != null)
    {
        mPointMachineJsonN = ViewBag.PointMachineDataN as Domain.PointMachineJson;
    }
    if (ViewBag.PointMachineDataR != null)
    {
        mPointMachineJsonR = ViewBag.PointMachineDataR as Domain.PointMachineJson;
    }
    if (ViewBag.CardLine != null)
    {
        mCardLines = ViewBag.CardLine as List<Domain.CardLine>;
    }
}

