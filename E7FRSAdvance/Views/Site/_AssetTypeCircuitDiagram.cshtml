    function fnGetPointMachineData(assetId) {

        var pointMachineData = {};
        pointMachineData.AssetId = assetId;
        pointMachineData.StartDate = new Date();
        pointMachineData.EndDate = new Date();

        $.ajax({
            url: '/Site/GetPointMachineData',
            type: 'Post',
            data: '{pointMachineData:' + JSON.stringify(pointMachineData) + '}',
            contentType: 'application/json',
            success: function (data) {
                if (data != null && data.length > 0) {

                    if (data.length > 2) {
                        const lastThree = data.slice(0, 3);
                        var str = '';
                        if (lastThree) {
                            str += '<tr><th style="padding:5px;background-color: #085885; color: white;">Date</th><th style="padding:5px;background-color: #085885; color: white;">Direction</th><th style="padding:5px;background-color: #085885; color: white;" class="text-center">A <br /> Current</th><th style="padding:5px;background-color: #085885; color: white;" class="text-center">A <br /> Voltage</th><th style="background-color: #085885; color: white;">A <br /> Time</th><th style="background-color: #085885; color: white; padding:5px;" class="text-center">B <br /> Current</th><th style="background-color: #085885; color: white;padding:5px;" class="text-center">B <br /> Voltage</th><th style="background-color: #085885; color: white;padding:5px;">B<br />Time</th></tr>';
                            $(lastThree).each(function (d, val) {
                                str += '<tr>';
                                str += '<td style="padding:5px">' + val.Date +'</td>';
                                str += '<td>' + val.Direction + '</td>';
                                str += "<td style='padding:5px' class='text-center'><a onclick='fnShowSignatureGraghCircuit(this)' data-type='AC' data-time='" + val.Date +"'>" + val.PointMachineJson.A_C_MAX + "</a></td>";
                                str += "<td style='padding:5px' class='text-center'><a onclick='fnShowSignatureGraghCircuit(this)' data-type='AV' data-time='" + val.Date + "'>" + val.PointMachineJson.A_V_AVERAGE + "</a></td>";
                                str += '<td>' + val.PointMachineJson.A_C_TIME + '</td>';
                                str += "<td style='padding:5px' class='text-center'><a onclick='fnShowSignatureGraghCircuit(this)' data-type='BC' data-time='" + val.Date + "'>" + val.PointMachineJson.B_C_MAX + "</a></td>";
                                str += "<td style='padding:5px' class='text-center'><a onclick='fnShowSignatureGraghCircuit(this)' data-type='BV' data-time='" + val.Date + "'>" + val.PointMachineJson.B_V_AVERAGE + "</a></td>";
                                str += '<td style="padding:5px">' + val.PointMachineJson.B_C_TIME + '</td>';
                                str += '</tr>';
                            });
                        }

                        $('#dataTableCircuit').empty().append(str);

                    }
              

                    const PointMachineDataR = data
                        .filter(x => x.Direction === "Reverse")[0]; // Get the first item (same as FirstOrDefault)

                    if (PointMachineDataR != null && PointMachineDataR.PointMachineJson != null) {
                        pointMachineDataJsonR = PointMachineDataR.PointMachineJson;

                        pointMachineEventTime = PointMachineDataR.Date.split(" ")[1];
                    }

                    const PointMachineDataN = data
                        .filter(x => x.Direction === "Normal")[0]; // Get the first item (same as FirstOrDefault)

                    if (PointMachineDataN != null && PointMachineDataN.PointMachineJson != null) {
                        pointMachineDataJsonN = PointMachineDataN.PointMachineJson;

                        pointMachineEventTime = PointMachineDataN.Date.split(" ")[1];
                    }
                }

            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });

    }

