    // ── Run analysis ───────────────────────────────────────────────
    function ptRunAnalysis() {
        var fromVal = $('#ptFromDt').val();
        var toVal = $('#ptToDt').val();

        // Validate dates
        if (!fromVal || !toVal) {
            CommonNotification('ERROR', 'Please select both From and To date/time.', 'error');
            return;
        }
        if (new Date(fromVal).getTime() >= new Date(toVal).getTime()) {
            CommonNotification('ERROR', 'From date must be earlier than To date.', 'error');
            return;
        }

        // Read threshold — single WARN window
        var warnInput = parseFloat($('#ptWarnSec').val());
        if (isNaN(warnInput) || warnInput < 1) { warnInput = 10; $('#ptWarnSec').val(10); }

        PT.WARN_SEC = warnInput;
        ptUpdateLegend();

        // Convert dates to API format
        PT.startFmt = _ptToApiDate(fromVal, true);
        PT.endFmt = _ptToApiDate(toVal, false);
        PT.startMs = _ptToMs(fromVal);
        PT.endMs = _ptToMs(toVal);

        if (!PT.startFmt || !PT.startMs) {
            CommonNotification('ERROR', 'Invalid date/time values.', 'error');
            return;
        }

        // Reset per-run data (NOT attrMap/dlMap — those are stable per asset type)
        PT.data = {};
        PT.assets = _ptGetAssets();

        // Update header UI
        $('#ptRangeBadge').text(_ptFmtDtLocal(fromVal) + ' → ' + _ptFmtDtLocal(toVal));
        $('#ptHdrSub').text('Warn window: ' + PT.WARN_SEC + 's  |  Clock: TimestampDevice');
        $('#ptStatStrip,#ptTabBar,#ptFooterBar').hide();
        $('#ptExportBtn').hide();

        _ptShowLoading('Fetching data…', 0);
        $('#ptRunBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Running…');

        if (!PT.assets.length) {
            _ptShowEmpty('No assets found.<br>Browse to any asset type (Track, Signal, Point Machine…) — assets are collected automatically as you switch between types. Then run again.');
            $('#ptRunBtn').prop('disabled', false).html('<i class="fa fa-play mr-1"></i> Run Analysis');
            return;
        }

        var atTypeId = $.trim($('#hdnassetTypeId').val());
        var siteId = $.trim($('#hdnsiteId').val());

        // Don't reset attrByType cache (names don't change)
        // but DO reset attrReady so merged map gets rebuilt for this run's types
        PT.attrReady = false;
        PT.attrMap = {};

        _ptLoadNames(atTypeId, function () {
            _ptLoadDLNames(siteId, function () {
                _ptFetch(0);
            });
        });
    }

