    // Fallback: scrape asset type tabs already rendered in the page
    function _ptLoadAssetTypesFromDOM(sel) {
        var types = [], seen = {};
        $('[onclick*="fnSearchDeviceTimeDashboard"]').each(function () {
            var oc = $(this).attr('onclick') || '';
            var m = oc.match(/fnSearchDeviceTimeDashboard\s*\(\s*(\d+)\s*,\s*['"]([^'"]+)['"]/);
            if (m && !seen[m[1]]) { seen[m[1]] = true; types.push({ Id: m[1], Name: m[2] }); }
        });
        if (!types.length) {
            var curId = $.trim($('#hdnassetTypeId').val());
            var curName = $.trim($('#hdAssetTypeName').val());
