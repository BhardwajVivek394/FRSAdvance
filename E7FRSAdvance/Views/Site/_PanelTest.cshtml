    function _ptPopulateTypeDropdown(sel, data) {
        PT._typesLoaded = true;   // mark as done — won't reload until page refresh
        sel.empty().prop('disabled', false);
        sel.append('<option value="">— All Asset Types —</option>');
        data.sort(function (a, b) {
            var an = (a.Name || a.name || '').toLowerCase();
            var bn = (b.Name || b.name || '').toLowerCase();
            if (an.indexOf('track') >= 0 && bn.indexOf('track') < 0) return -1;
            if (bn.indexOf('track') >= 0 && an.indexOf('track') < 0) return 1;
            return an.localeCompare(bn);
        });
        $.each(data, function (k, t) {
            var id = String(t.Id || t.id || t.AssetTypeId || '');
            var name = t.Name || t.name || t.AssetTypeName || ('Type ' + id);
            sel.append('<option value="' + _esc(id) + '">' + _esc(name) + '</option>');
        });
        // Auto-select type currently visible on page
        var curId = $.trim($('#hdnassetTypeId').val());
        var siteId2 = $.trim($('#hdnsiteId').val());
        if (curId) {
            sel.val(curId);
            // Trigger asset load for the auto-selected type
            if (PT._typesFetched[String(curId)]) {
                var cached2 = Object.values(PT.allKnownAssets).filter(function (a) {
                    return a.assetTypeId === String(curId);
                });
                _ptPopulateAssetMultiSelect(cached2);
            } else {
                _ptFetchAssetsByType(siteId2, curId, function (assets) {
                    _ptPopulateAssetMultiSelect(assets);
                });
            }
        }
    }

