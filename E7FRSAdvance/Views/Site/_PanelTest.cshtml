<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<script>
    //  PANEL TEST — Fixed: thresholds, quick-range, matrix layout
    // ╚═══════════════════════════════════════════════════════════╝

    var PT = {
        API: 'http://proxy.energy7.org:8083/api/HistoryValue',
        WARN_SEC: 10,   // warn — no RDPMS value found within this window after DL event
        PRE_WIN: 5,    // seconds BEFORE T_DL that still counts as a valid response (pre-response)
        attrMap: {},   // attrId → display name (cached per type)
        attrByType: {},  // typeId → { map, ready } — names cached per asset type
        attrReady: false,
        dlMap: {},   // role → DL relay name (cached)
        dlReady: false,
        data: {},   // assetId → { asset, raw, analysis, err }
        assets: [],
        allKnownAssets: {}, // assetId → { assetId, assetName, assetType, assetTypeId } — accumulated across all type switches
        _typesLoaded: false,   // true once dropdown has been populated for this session
        _typesFetched: {},      // assetTypeId → true once GetAssestBy has been called
        _selectedAssets: {},      // assetId → true/false from the multi-select widget
        startMs: 0,
        endMs: 0,
        startFmt: '',
        endFmt: ''
    };

    // ── Accumulate assets automatically as user switches types ────
    // A MutationObserver watches #divAssetDetails and captures every
    // divAssetXXX that appears, regardless of the currently selected type.
    (function () {
        function _harvestAssets() {
            var typeName = $.trim($('#hdAssetTypeName').val()) || 'Unknown';
            var typeId = $.trim($('#hdnassetTypeId').val()) || '0';
            $('[id^="divAsset"]').each(function () {
                var rawId = this.id.replace('divAsset', '');
                if (!rawId || isNaN(rawId)) return;
                if (PT.allKnownAssets[rawId]) return; // already captured
                var $e = $(this);
                var name = $e.attr('data-asset-name') ||
                    $e.find('[class*="assetName"],[class*="asset-name"]').first().text().trim() ||
                    $e.find('h6,h5').first().text().trim() || ('Asset ' + rawId);
                name = $.trim(name).replace(/\s+/g, ' ').substring(0, 80);
                PT.allKnownAssets[rawId] = {
                    assetId: rawId,
                    assetName: name,
                    assetType: typeName,
                    assetTypeId: typeId
                };
            });
        }

        // Harvest immediately (for assets already in DOM at load time)
        $(document).ready(function () {
            setTimeout(_harvestAssets, 500);
        });

        // Watch for AJAX-loaded asset changes
        var _ptObserver = null;
        $(document).ready(function () {
            var target = document.getElementById('divAssetDetails');
            if (!target) return;
            _ptObserver = new MutationObserver(function () {
                // Small delay so Razor-rendered partial has fully inserted
                setTimeout(function () {
                    _harvestAssets();
                    // NOTE: do NOT call _ptLoadAssetTypes() here.
                    // The observer fires on every live data update (MQTT/WS).
                    // Asset types are stable — loaded once in fnOpenPanelTest.
                }, 200);
            });
            _ptObserver.observe(target, { childList: true, subtree: true });
        });
    }());

    // ── Date / time helpers ───────────────────────────────────────
    function _ptNow() { return new Date(); }

    // JS Date → "YYYY-MM-DDTHH:MM"  for datetime-local input
    function _ptLocalIso(d) {
        var p = function (n) { return String(n).padStart(2, '0'); };
        return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate())
            + 'T' + p(d.getHours()) + ':' + p(d.getMinutes());
    }

    // "YYYY-MM-DDTHH:MM" → "DDMMYYYY_HHmmss"  for HistoryValue API
    function _ptToApiDate(localVal, isStart) {
        if (!localVal) return null;
        var d = new Date(localVal);
        if (isNaN(d.getTime())) return null;
        if (!isStart) d.setSeconds(59); else d.setSeconds(0);
        var p = function (n) { return String(n).padStart(2, '0'); };
        return p(d.getDate()) + p(d.getMonth() + 1) + d.getFullYear()
            + '_' + p(d.getHours()) + p(d.getMinutes()) + p(d.getSeconds());
    }

    // "YYYY-MM-DDTHH:MM" → epoch ms
    function _ptToMs(localVal) {
        var d = new Date(localVal);
        return isNaN(d.getTime()) ? 0 : d.getTime();
    }

    // "YYYY-MM-DDTHH:MM" → "DD/MM/YYYY HH:MM"
    function _ptFmtDtLocal(localVal) {
        var d = new Date(localVal);
        if (isNaN(d.getTime())) return localVal;
        var p = function (n) { return String(n).padStart(2, '0'); };
        return p(d.getDate()) + '/' + p(d.getMonth() + 1) + '/' + d.getFullYear()
            + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
    }

    // ── Live legend update when threshold inputs change ────────────
    function ptUpdateLegend() {
        var w = parseFloat($('#ptWarnSec').val()) || 10;
        if (w < 1) { w = 1; $('#ptWarnSec').val(1); }
        $('#ptLegWarn').text(w);
        $('#ptLegWin').text(w);
        $('#ptLegPre').text(PT.PRE_WIN);
        PT.WARN_SEC = w;
    }

    // ── Quick range preset ─────────────────────────────────────────
    // NOTE: we do NOT reset the dropdown after applying —
    //       the selected option stays visible so user knows what's active.
    //       Manual date edit clears it back to "-- Custom --" via oninput.
    function ptApplyQuickRange() {
        var h = parseInt($('#ptQuickRange').val());
        if (!h) return;
        var now = _ptNow();
        var from = new Date(now.getTime() - h * 3600 * 1000);
        $('#ptFromDt').val(_ptLocalIso(from));
        $('#ptToDt').val(_ptLocalIso(now));
        // intentionally leave the dropdown showing the selected option
    }

    // ── Open panel test popup ─────────────────────────────────────
    function fnOpenPanelTest() {
        var now = _ptNow();
        var from = $.trim($('#txtWatchlistFromDate').val());

        // ToDate always = current datetime
        $('#ptToDt').val(_ptLocalIso(now));

        // FromDate = watchlist date (if parseable) else now − 2 h
        var fromDt = from ? new Date(_ptLegacyDateMs(from, true)) : null;
        if (!fromDt || isNaN(fromDt.getTime())) fromDt = new Date(now.getTime() - 2 * 3600 * 1000);
        $('#ptFromDt').val(_ptLocalIso(fromDt));

        // Restore/init threshold inputs
        $('#ptWarnSec').val(PT.WARN_SEC);
        $('#ptQuickRange').val('');
        ptUpdateLegend();

        // Show popup
        $('#ptOverlay').addClass('pt-vis');
        $('#ptPopup').addClass('pt-vis');
        $('#ptDetailPopup').removeClass('pt-vis');

        // Reset result UI
        $('#ptStatStrip,#ptTabBar,#ptFooterBar').hide();
        $('#ptExportBtn').hide();
        $('#ptTotals,#ptRangeBadge').text('');
        $('#ptHdrSub').text('Select a date range and click Run Analysis');

        // Reset asset multi-select
        ptResetAssetMultiSelect();

        // Load asset types dropdown from server by siteId
        // Reset flag so types reload if popup was closed and reopened
        // (handles edge case where user navigated to different site in same tab)
        var currentSiteId = $.trim($('#hdnsiteId').val());
        if (PT._lastSiteId && PT._lastSiteId !== currentSiteId) {
            PT._typesLoaded = false;
            PT._typesFetched = {};
            PT.allKnownAssets = {};
        }
        PT._lastSiteId = currentSiteId;

        _ptLoadAssetTypes();
        _ptShowIdle();
    }

    // ── Asset Type + Asset loading (FRS25 pattern) ────────────────
    //
    //  Step 1: fnOpenPanelTest calls _ptLoadAssetTypes()
    //          POST /FRS25/Telemetry/GetAssetTypeBy  { siteId }
    //          → populates #ptAssetTypeId dropdown
    //
    //  Step 2: user changes #ptAssetTypeId → ptOnAssetTypeChange()
    //          POST /FRS25/Telemetry/GetAssestBy  { siteId, assetTypeId }
    //          → accumulates assets into PT.allKnownAssets
    // ────────────────────────────────────────────────────────────────

    function _ptLoadAssetTypes() {
        // Only load once per session — asset types don't change while on the page
        if (PT._typesLoaded) return;

        var siteId = $.trim($('#hdnsiteId').val());
        var sel = $('#ptAssetTypeId');
        if (!siteId || siteId === '' || siteId === '0') {
            _ptLoadAssetTypesFromDOM(sel);
            return;
        }
        sel.html('<option value="">— loading… —</option>').prop('disabled', true);

        $.ajax({
            url: '/Site/GetAssetTypeBySiteId',
            type: 'POST',
            data: JSON.stringify({ siteId: siteId }),
            contentType: 'application/json',
            dataType: 'json',
            success: function (data) {
                if (data && data.length > 0) {
                    _ptPopulateTypeDropdown(sel, data);
                } else {
                    _ptLoadAssetTypesFromDOM(sel);
                }
            },
            error: function () {
                _ptLoadAssetTypesFromDOM(sel);
            }
        });
    }

    // Called from onchange="ptOnAssetTypeChange()" on the dropdown
    // Called when Asset Type dropdown changes
    function ptOnAssetTypeChange() {
        var siteId = $.trim($('#hdnsiteId').val());
        var assetTypeId = $.trim($('#ptAssetTypeId').val());

        // Reset asset multi-select
        ptResetAssetMultiSelect();

        if (!siteId || siteId === '' || siteId === '0') return;

        if (!assetTypeId || assetTypeId === '' || assetTypeId === '0') {
            // "All types" selected — populate from all known assets
            _ptPopulateAssetMultiSelect(Object.values(PT.allKnownAssets));
            return;
        }

        // Check cache first
        if (PT._typesFetched[String(assetTypeId)]) {
            var cached = Object.values(PT.allKnownAssets).filter(function (a) {
                return a.assetTypeId === String(assetTypeId);
            });
            _ptPopulateAssetMultiSelect(cached);
            return;
        }

        // Fetch from server
        _ptFetchAssetsByType(siteId, assetTypeId, function (assets) {
            _ptPopulateAssetMultiSelect(assets);
        });
    }

    // POST /FRS25/Telemetry/GetAssestBy — fetches assets for a type
    function _ptFetchAssetsByType(siteId, assetTypeId, cb) {
        if (!siteId || siteId === '' || siteId === '0') return;
        if (!assetTypeId || assetTypeId === '' || assetTypeId === '0') return;

        // Show loading state
        $('#ptAssetMsList').html('<div class="pt-ms-item loading">&#9203; Loading assets…</div>');
        $('#ptAssetMsWrap').addClass('open');
        $('#ptAssetMsDropdown').show();

        $.ajax({
            url: '/Site/GetAssestBy',
            type: 'POST',
            data: JSON.stringify({ siteId: siteId, assetTypeId: assetTypeId }),
            contentType: 'application/json',
            dataType: 'json',
            success: function (d) {
                PT._typesFetched[String(assetTypeId)] = true;
                var typeName = $('#ptAssetTypeId option:selected').text() || 'Unknown';
                var assets = [];
                if (d && d.length > 0) {
                    $.each(d, function (k, v) {
                        var id = String(v.Id || v.id || '');
                        var name = v.Name || v.name || ('Asset ' + id);
                        if (!id) return;
                        // Add to allKnownAssets cache
                        if (!PT.allKnownAssets[id]) {
                            PT.allKnownAssets[id] = {
                                assetId: id, assetName: name,
                                assetType: typeName, assetTypeId: String(assetTypeId)
                            };
                        }
                        assets.push({ assetId: id, assetName: name, assetTypeId: String(assetTypeId) });
                    });
                }
                if (cb) cb(assets);
            },
            error: function () {
                $('#ptAssetMsList').html('<div class="pt-ms-empty">Failed to load assets</div>');
                if (cb) cb([]);
            }
        });
    }

    // ── Asset multi-select widget ─────────────────────────────────

    // Initialise / reset the asset list
    function ptResetAssetMultiSelect() {
        PT._selectedAssets = {};   // assetId → true
        $('#ptAssetMsList').html('<div class="pt-ms-empty">Select an Asset Type first</div>');
        $('#ptAssetMsLabel').text('All Assets');
        $('#ptAssetSelCount').text('(all)');
        $('#ptAssetMsSearch').val('');
        _ptCloseAssetDropdown();
    }

    // Populate the list from an array of { assetId, assetName }
    function _ptPopulateAssetMultiSelect(assets) {
        var list = $('#ptAssetMsList');
        list.empty();

        if (!assets || !assets.length) {
            list.html('<div class="pt-ms-empty">No assets found for this type</div>');
            return;
        }

        // Sort by name
        assets.sort(function (a, b) { return (a.assetName || '').localeCompare(b.assetName || ''); });

        // Render checkboxes — all selected by default
        assets.forEach(function (a) {
            var id = a.assetId;
            var name = a.assetName;
            var isChk = PT._selectedAssets[id] !== false;   // default: selected
            if (PT._selectedAssets[id] === undefined) PT._selectedAssets[id] = true;

            var row = $('<div class="pt-ms-item" data-id="' + id + '" data-name="' + _esc(name) + '">' +
                '<input type="checkbox" id="ptAC_' + id + '" ' + (isChk ? 'checked' : '') + '>' +
                '<label for="ptAC_' + id + '">' + _esc(name) + '</label>' +
                '</div>');

            row.find('input').on('change', function () {
                PT._selectedAssets[id] = this.checked;
                ptUpdateAssetSelLabel();
            });
            list.append(row);
        });

        ptUpdateAssetSelLabel();

        // Auto-open dropdown so user sees the populated list
        $('#ptAssetMsWrap').addClass('open');
