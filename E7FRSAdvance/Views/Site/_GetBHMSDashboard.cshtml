@model Domain.AssetLister
<style>
    .popover {
        width: 100%;
    }

    .popover-content {
        color: black;
    }

    @@media only screen and (max-width: 1200px) {
        .panel-body {
        }
    }

    .tableFixHead {
        overflow: auto;
        height: 100vh;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }

    .progress {
        height: 30px;
        font-size: 18px;
    }

    .progress-bar-animated {
        color: black !important;
    }
</style>
@{
    var bgColor = new string[] { "#215968", "#404040", "#4bacc6" };
}
<div class="people-options clearfix" style="padding:4px">
    <div class="pull-left " style="display:inline-flex">
        <div class="input-group " style="margin-left:20px;">
            @Html.TextBoxFor(x => x.SearchCriteria.AssetName, new { @class = "form-control btn-pill asset-search", @placeholder = "Search " })
        </div>
    </div>
    <div class="btn-group pull-right people-pager">


        @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
        @*@Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })*@
    </div>

    @if (Model.SearchCriteria.IsListView == true)
    {
        <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-info" onclick="fnListView()" title="List View"><i class="fa fa-list"></i></a></span>
        <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-primary" onclick="fnGridView()" title="Grid View"><i class="fa fa-th-large"></i></a></span>
    }



</div>

<div class="card " id="gridView">
    <div class="card-body" style="padding:15px;">
        <div class="row" id="divAsset">
            @if (Model.mAssets != null && Model.mAssets.Count > 0)
            {

                foreach (var asset in Model.mAssets)
                {
                    int skip = 0;
                    int loopCounter = 0;
                    <div class="col-12 xl-50 news box-col-12 text-center">
                        <div class="card mb-2">
                            <div class="card-header bg-primary text-white">
                                @if (asset.assetAttributes != null && asset.assetAttributes.Count > 0)
                                {
                                    var assetAttribute = asset.assetAttributes.Where(x => x.Title == "VTotal").FirstOrDefault();
                                    if (assetAttribute != null && assetAttribute.Id > 0)
                                    {
                                        <h5>
                                            V Total : <span id="spnVTotal" class="hdnAttributeData@(assetAttribute.Id)@(asset.Id)"></span>
                                        </h5>
                                        if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsCalibration)
                                        {
                                            <a class="text-white"><i class="fa fa-pencil" onclick="fnAddCalibration('@asset.Id','@assetAttribute.Id','@assetAttribute.Multiplication','@asset.Name','@assetAttribute.Title',$('#spnVTotal').text())"></i></a>
                                        }
                                    }

                                }

                            </div>
                            <div class="card-body">
                                <div class="row">
                                    @{
                                        if (asset.assetAttributes != null && asset.assetAttributes.Count > 0)
                                        {
                                            loopCounter = asset.assetAttributes.Count / 11;
                                        }
                                    }

                                    @for (int i = 0; i < loopCounter; i++)
                                    {
                                        <div class="col-xl-2 xl-50 news box-col-6">
                                            <div class="card card-border">
                                                <div class="bg-secondary main-header" style="padding:0;border-top-left-radius:15px;border-top-right-radius:15px;">
                                                    <div class="" style="width:80%;float:left;padding:10px;border-top-left-radius:15px;">
                                                        <h6 style="margin-left:12px;">
                                                            <a target="_blank" class="text-white" href="@asset.HttpMisLink"> @asset.AssetTypeName : @asset.Name</a>

                                                        </h6>
                                                    </div>
                                                    <div class="text-center bg-dark" style="width:20%;float:left;padding:2px 0px;border-top-right-radius:15px;line-height:1.3;height:50px;">

                                                        @if (asset.UnderMaintence == true)
                                                        {
                                                            <div class="text-center"> <i class="fa fa-bell-slash" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@asset.Id', this)" data-id="@asset.Id"></i></div>
                                                        }
                                                        else
                                                        {
                                                            <div class="text-center">
                                                                <i class="fa fa-bell" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@asset.Id', this)" data-id="@asset.Id"></i>
                                                            </div>
                                                        }
                                                        <a onclick="fnGetAssetGraph('@asset.SiteId', '@asset.Id', '@Json.Encode(asset.mFamilyTracks)')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer"> Graph </a>
                                                        <a onclick="fnGetSmsLog('@asset.Id')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer">Event log</a>
                                                    </div>

                                                </div>
                                                <div class="card-body gridBody" style="padding:5px;">
                                                    <div class="table-responsive width100p tblAssetData">

                                                        <table class="table table-striped">
                                                            <tbody id="tblAttributeData@(asset.Id)" class="tblAttributes tblAttributeData@(asset.Id)" data-id="@asset.Id">
                                                                @if (asset.assetAttributes != null && asset.assetAttributes.Count > 0)
                                                                {
                                                                    foreach (var assetAttribute in asset.assetAttributes.Skip(skip).Take(11))
                                                                    {
                                                                        skip++;
                                                                        <tr>
                                                                            <td style="width:50%">
                                                                                @assetAttribute.Title
                                                                            </td>
                                                                            <td style="width:50%" class="hdnAttributeData@(assetAttribute.Id)@(asset.Id)">
                                                                                @assetAttribute.AttributeData
                                                                            </td>
                                                                            @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsCalibration)
                                                                            {
                                                                                <td style="width:50%">
                                                                                    <a class=""><i class="fa fa-pencil" onclick="fnAddCalibration('@asset.Id','@assetAttribute.Id','@assetAttribute.Multiplication','@asset.Name','@assetAttribute.Title')"></i></a>
                                                                                </td>
                                                                            }
                                                                            else
                                                                            {
                                                                                <td></td>
                                                                            }
                                                                        </tr>
                                                                    }


                                                                }
                                                                else
                                                                {
                                                                    <tr>
                                                                        <td class="text-center" colspan="3">No attributes found!</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    }
                                </div>
                             

                            </div>
                        </div>
                    </div>
                }

            }
            else
            {
                <p style="font-size:15px">No record found!</p>
            }
        </div>
    </div>
</div>

