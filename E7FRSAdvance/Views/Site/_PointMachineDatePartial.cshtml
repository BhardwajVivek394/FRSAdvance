@*@model List<Domain.PointMachineData>*@
@model Domain.Asset

@if (Model != null && Model.mPointMachineData != null)
{
    foreach (var point in Model.mPointMachineData.OrderByDescending(x => x.Date))
    {
        //var date = Convert.ToDateTime(point.Date).ToString("MM/dd/yyyy");
        string tableHtml = "";

        string directionDL = string.Empty;
        string dlTime = string.Empty;
        if (point.Direction.Contains("Normal"))
        {
            directionDL = "NWCR";
        }
        else if (point.Direction.Contains("Reverse"))
        {
            directionDL = "RWCR";
        }


        if (ViewBag.Datalogger != null)
        {
            var dbTime = Convert.ToDateTime(point.Date);
            var mDataloggers = ViewBag.Datalogger as List<Domain.Datalogger>;
            if (mDataloggers != null && mDataloggers.Count > 0)
            {
                var mdlInfo = Model.mAssetInfoDataloggers.Where(x => x.DataloggerAttribute.EndsWith(directionDL)).FirstOrDefault();
                if (mdlInfo != null && mdlInfo.Id > 0)
                {

                    var dldata = mDataloggers.Where(x => x.SrNo == Convert.ToInt32(mdlInfo.Value) && x.Date > dbTime.AddSeconds(-5) && x.Date < dbTime.AddSeconds(5)).FirstOrDefault();
                    if (dldata != null && dldata.SrNo > 0)
                    {
                        dlTime = dldata.Date.ToString("yyyy-MM-dd HH:mm:ss");
                    }
                }

            }
        }
        try
        {

            if (!string.IsNullOrEmpty(point.ChannelLog))
            {
                Dictionary<string, Domain.PointMachineChannelLog> result =
Newtonsoft.Json.JsonConvert.DeserializeObject<Dictionary<string, Domain.PointMachineChannelLog>>(point.ChannelLog);
                if (result != null && result.Count > 0)
                {
                    var aC = result["A_C"];
                    string statusAC = aC.s;
                    string failureFTPAC = aC.F ?? "-";
                    string failureClusterAC = aC.C ?? "-";
                    string failureMQTTAC = aC.M ?? "-";

                    var bC = result["B_C"];
                    string statusBC = bC.s;
                    string failureFTPBC = bC.F ?? "-";
                    string failureClusterBC = bC.C ?? "-";
                    string failureMQTTBC = bC.M ?? "-";

                    var aV = result["A_V"];
                    string statusAV = aV.s;
                    string failureFTPAV = aV.F ?? "-";
                    string failureClusterAV = aV.C ?? "-";
                    string failureMQTTAV = aV.M ?? "-";

                    var bV = result["B_V"];
                    string statusBV = bV.s;
                    string failureFTPBV = bV.F ?? "-";
                    string failureClusterBV = bV.C ?? "-";
                    string failureMQTTBV = bV.M ?? "-";

                    tableHtml += "<div>";
                    tableHtml += "<table class='table table-bordered table-sm'>";

                    tableHtml += "<th class='f-14'>Type</th>";
                    tableHtml += "<th class='f-14'>AC</th>";
                    tableHtml += "<th class='f-14'>AV</th>";
                    tableHtml += "<th class='f-14'>BC</th>";
                    tableHtml += "<th class='f-14'>BV</th>";
                    tableHtml += "</tr>";

                    tableHtml += "<tr>";
                    tableHtml += "<th class='f-14'>Cluster</th>";

                    tableHtml += "<td class='f-14 " + (statusAC == "C" ? "textgreencolor" : "") + "'>" + System.Web.HttpUtility.HtmlEncode(failureClusterAC) + "</td>";
                    tableHtml += "<td class='f-14 " + (statusAV == "C" ? "textgreencolor" : "") + "'>" + System.Web.HttpUtility.HtmlEncode(failureClusterAV) + "</td>";
                    tableHtml += "<td class='f-14 " + (statusBC == "C" ? "textgreencolor" : "") + "'>" + System.Web.HttpUtility.HtmlEncode(failureClusterBC) + "</td>";
                    tableHtml += "<td class='f-14 " + (statusBV == "C" ? "textgreencolor" : "") + "'>" + System.Web.HttpUtility.HtmlEncode(failureClusterBV) + "</td>";
                    tableHtml += "</tr>";

                    tableHtml += "<tr>";
                    tableHtml += "<th class='f-14'>MQTT</th>";
                    tableHtml += "<td class='f-14 " + (statusAC == "M" ? "textgreencolor" : "") + "'>" + System.Web.HttpUtility.HtmlEncode(failureMQTTAC) + "</td>";
                    tableHtml += "<td class='f-14 " + (statusAV == "M" ? "textgreencolor" : "") + "'>" + System.Web.HttpUtility.HtmlEncode(failureMQTTAV) + "</td>";
                    tableHtml += "<td class='f-14 " + (statusBC == "M" ? "textgreencolor" : "") + "'>" + System.Web.HttpUtility.HtmlEncode(failureMQTTBC) + "</td>";
                    tableHtml += "<td class='f-14 " + (statusBV == "M" ? "textgreencolor" : "") + "'>" + System.Web.HttpUtility.HtmlEncode(failureMQTTBV) + "</td>";
                    tableHtml += "</tr>";

                    tableHtml += "<tr>";
                    tableHtml += "<th class='f-14'>FTP</th>";
                    tableHtml += "<td class='f-14 " + (statusAC == "F" ? "textgreencolor" : "") + "'>" + System.Web.HttpUtility.HtmlEncode(failureFTPAC) + "</td>";
                    tableHtml += "<td class='f-14 " + (statusAV == "F" ? "textgreencolor" : "") + "'>" + System.Web.HttpUtility.HtmlEncode(failureFTPAV) + "</td>";
                    tableHtml += "<td class='f-14 " + (statusBC == "F" ? "textgreencolor" : "") + "'>" + System.Web.HttpUtility.HtmlEncode(failureFTPBC) + "</td>";
                    tableHtml += "<td class='f-14 " + (statusBV == "F" ? "textgreencolor" : "") + "'>" + System.Web.HttpUtility.HtmlEncode(failureFTPBV) + "</td>";
                    tableHtml += "</tr>";

                    tableHtml += "</table>";
                    tableHtml += "</div>";
                }

            }

        }
        catch (Exception)
        {

        }


        <tr>
            <td>
                <div class="row">
                    <div class="col-9">
                        @point.Date
                        @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                        {
                            if (!string.IsNullOrEmpty(tableHtml))
                            {
                                <i class="fa fa-info-circle f-18" aria-hidden="true" data-bs-trigger="hover" data-container="body" data-bs-toggle="popover" data-bs-html="true" data-bs-placement="top" data-bs-original-title="Date : @point.TsTime | Direction : @point.Direction | DLTime: @dlTime" data-bs-content="@tableHtml"></i>
                            }
                            else
                            {
                                <i class="fa fa-info-circle f-18" aria-hidden="true" data-bs-trigger="hover" data-container="body" data-bs-toggle="popover" data-bs-html="true" data-bs-placement="top" data-bs-original-title="Point Operation" data-bs-content="<p>Operation Time: @point.Date</p><p>Update Time: @point.TimeStamp.ToString("yyyy-MM-dd HH:mm:ss")</p><p>Type: @point.SaveType</p>"></i>
                            }
                        }
                    </div>
                    <div class="col-3">
                        @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                        {
                            double seconds = (int)(point.TimeStamp - Convert.ToDateTime(point.Date)).TotalSeconds;
                            if (point.SaveType == "Cluster")
                            {
                                <span>CS-@seconds</span>
                            }
                            else if (point.SaveType == "MQTT")
                            {
                                <span>MS-@seconds</span>
                            }
                            else if (point.SaveType == "FTP")
                            {
                                <span>FS-@seconds</span>
                            }

                        }
                    </div>
                </div>

            </td>
            <td class="assetname">
                @point.AssetType
            </td>
            <td>
                @point.Direction  Operation
            </td>
            @if (Model.IsSeriesOpration != null && Model.IsSeriesOpration.Value)
            {
                var sumTime = point.PointMachineJson.A_C_TIME + point.PointMachineJson.B_C_TIME;
                <td>
                    <a onclick="fnBindSignatureEventGragh('@point.AssetId', '@point.Direction', '@point.Date', 'C'); return false;" href="javascript:void(0)">C</a>/
                    <a onclick="fnBindSignatureEventGragh('@point.AssetId', '@point.Direction', '@point.Date', 'V'); return false;" href="javascript:void(0)">V</a>

                </td>

                <td>
                    @if ((point.PointMachineJson.Combine_C_TIME > 0 && point.PointMachineJson.Combine_V_TIME > 0) || (point.PointMachineJson.IsCombineOperation_A && point.PointMachineJson.IsCombineOperation_B))
                    {
                        <span>(Max/Avg/Time)</span>
                        <span>
                            <a href="javascript:void(0)" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CC', ' @point.Date', '@point.Direction', '@point.AssetType', '@point.AssetId'); return false;">C(@point.PointMachineJson.Combine_C_MAX/@point.PointMachineJson.Combine_C_AVERAGE/@point.PointMachineJson.Combine_C_TIME)</a>
                            <br />
                            <a href="javascript:void(0)" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CV', ' @point.Date', '@point.Direction', '@point.AssetType', '@point.AssetId'); return false;">V(@point.PointMachineJson.Combine_V_MAX/@point.PointMachineJson.Combine_V_AVERAGE/@point.PointMachineJson.Combine_V_TIME)</a>
                        </span>
                    }
                    else if (point.Direction.ToLower() == "normal" && (Model.MachineAScale == (int)E7FRSAdvance.Utility.Utility.PMScale.Scale_20 || Model.MachineBScale == (int)E7FRSAdvance.Utility.Utility.PMScale.Scale_20))
                    {
                        <span>
                            <a href="javascript:void(0)" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','CC',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">C</a>/<a href="#" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CV', ' @point.Date', '@point.Direction', '@point.AssetType', '@point.AssetId'); return false;">V</a>/<a>T(@sumTime)</a>
                        </span>
                    }
                    else if (point.Direction.ToLower() == "reverse" && (Model.MachineAReverseScale == (int)E7FRSAdvance.Utility.Utility.PMScale.Scale_20 || Model.MachineBReverseScale == (int)E7FRSAdvance.Utility.Utility.PMScale.Scale_20))
                    {
                        <span>
                            <a href="javascript:void(0)" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','CC',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">C</a>/<a href="#" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CV', ' @point.Date', '@point.Direction', '@point.AssetType', '@point.AssetId'); return false;">V</a>/<a>T(@sumTime)</a>
                        </span>
                    }
                    else
                    {
                        <span>
                            <a href="javascript:void(0)" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','CC',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">C</a>/<a href="#" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CV', ' @point.Date', '@point.Direction', '@point.AssetType', '@point.AssetId'); return false;">V</a>/<a>T(@sumTime)</a>
                        </span>
                    }

                </td>
            }

            @if ((point.PointMachineJson.Combine_C_TIME > 0 && point.PointMachineJson.Combine_V_TIME > 0) || (point.PointMachineJson.IsCombineOperation_A && point.PointMachineJson.IsCombineOperation_B))
            {
                <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.A || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','AC',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">

                    @string.Format("{0:0.00}", point.PointMachineJson.A_C_MAX)   /  @string.Format("{0:0.00}", @point.PointMachineJson.A_C_AVERAGE) (@Math.Round(point.PointMachineJson.A_C_CurveArea, 2))

                    @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                    {
                        if (point.PointMachineJson.A_CTypeId != null && point.PointMachineJson.A_CTypeId > 0)
                        {
                            var str = E7FRSAdvance.Utility.EnumHelper.GetDisplayNameById<E7FRSAdvance.Utility.Utility.PointMachineEventUpdateType>(point.PointMachineJson.A_CTypeId.Value);
                            <span class="text-black-50">- @str</span>
                        }
                    }
                </td>
            }
            else if (point.PointMachineJson.Combine_A_C_TIME > 0 || point.PointMachineJson.IsCombineOperation_A)
            {
                <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.A || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','AC',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">

                    @string.Format("{0:0.00}", point.PointMachineJson.A_C_MAX)   /  @string.Format("{0:0.00}", @point.PointMachineJson.A_C_AVERAGE) (@Math.Round(point.PointMachineJson.A_C_CurveArea, 2))
                    @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                    {
                        if (point.PointMachineJson.A_CTypeId != null && point.PointMachineJson.A_CTypeId > 0)
                        {
                            var str = E7FRSAdvance.Utility.EnumHelper.GetDisplayNameById<E7FRSAdvance.Utility.Utility.PointMachineEventUpdateType>(point.PointMachineJson.A_CTypeId.Value);
                            <span class="text-black-50">- @str</span>
                        }
                    }

                    <br />
                    <span style="color:black !important">(Max/Avg/Time)</span> <br />
                    <span>
                        <a href="javascript:void(0)" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CC', ' @point.Date', '@point.Direction', '@point.AssetType', '@point.AssetId'); return false;">C(@point.PointMachineJson.Combine_A_C_MAX/@point.PointMachineJson.Combine_A_C_AVERAGE/@point.PointMachineJson.Combine_A_C_TIME)</a>
                        <br />
                        <a href="javascript:void(0)" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CV', ' @point.Date', '@point.Direction', '@point.AssetType', '@point.AssetId'); return false;">V(@point.PointMachineJson.Combine_A_V_MAX/@point.PointMachineJson.Combine_A_V_AVERAGE/@point.PointMachineJson.Combine_A_V_TIME)</a>
                    </span>


                </td>
            }
            else if (point.Direction.ToLower() == "normal" && Model.MachineAScale == (int)E7FRSAdvance.Utility.Utility.PMScale.Scale_20)
            {
                <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.A || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','AC',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">
                    @string.Format("{0:0.00}", point.PointMachineJson.A_C_MAX)   /  @string.Format("{0:0.00}", @point.PointMachineJson.A_C_AVERAGE) (@Math.Round(point.PointMachineJson.A_C_CurveArea, 2))
                    @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                    {
                        if (point.PointMachineJson.A_CTypeId != null && point.PointMachineJson.A_CTypeId > 0)
                        {
                            var str = E7FRSAdvance.Utility.EnumHelper.GetDisplayNameById<E7FRSAdvance.Utility.Utility.PointMachineEventUpdateType>(point.PointMachineJson.A_CTypeId.Value);
                            <span class="text-black-50">- @str</span>
                        }
                    }
                </td>
            }
            else if (point.Direction.ToLower() == "reverse" && Model.MachineAReverseScale == (int)E7FRSAdvance.Utility.Utility.PMScale.Scale_20)
            {
                <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.A || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','AC',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">
                    @string.Format("{0:0.00}", point.PointMachineJson.A_C_MAX)   /  @string.Format("{0:0.00}", @point.PointMachineJson.A_C_AVERAGE) (@Math.Round(point.PointMachineJson.A_C_CurveArea, 2))
                    @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                    {
                        if (point.PointMachineJson.A_CTypeId != null && point.PointMachineJson.A_CTypeId > 0)
                        {
                            var str = E7FRSAdvance.Utility.EnumHelper.GetDisplayNameById<E7FRSAdvance.Utility.Utility.PointMachineEventUpdateType>(point.PointMachineJson.A_CTypeId.Value);
                            <span class="text-black-50">- @str</span>
                        }
                    }
                </td>
            }
            else
            {
                <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.A || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','AC',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">
                    @string.Format("{0:0.00}", point.PointMachineJson.A_C_MAX)   /  @string.Format("{0:0.00}", @point.PointMachineJson.A_C_AVERAGE) (@Math.Round(point.PointMachineJson.A_C_CurveArea, 2))

                    @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                    {
                        if (point.PointMachineJson.A_CTypeId != null && point.PointMachineJson.A_CTypeId > 0)
                        {
                            var str = E7FRSAdvance.Utility.EnumHelper.GetDisplayNameById<E7FRSAdvance.Utility.Utility.PointMachineEventUpdateType>(point.PointMachineJson.A_CTypeId.Value);
                            <span class="text-black-50">- @str</span>
                        }
                    }
                </td>
            }

            @if (point.Direction.ToLower() == "normal" && Model.MachineAScale == (int)E7FRSAdvance.Utility.Utility.PMScale.Scale_20)
            {
                <td onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','AV',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">
                    @point.PointMachineJson.A_V_AVERAGE

                    @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                    {
                        if (point.PointMachineJson.A_VTypeId != null && point.PointMachineJson.A_VTypeId > 0)
                        {
                            var str = E7FRSAdvance.Utility.EnumHelper.GetDisplayNameById<E7FRSAdvance.Utility.Utility.PointMachineEventUpdateType>(point.PointMachineJson.A_VTypeId.Value);
                            <span class="text-black-50">- @str</span>
                        }
                    }

                </td>
            }
            else if (point.Direction.ToLower() == "reverse" && Model.MachineAReverseScale == (int)E7FRSAdvance.Utility.Utility.PMScale.Scale_20)
            {
                <td onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','AV',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">
                    @point.PointMachineJson.A_V_AVERAGE

                    @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                    {
                        if (point.PointMachineJson.A_VTypeId != null && point.PointMachineJson.A_VTypeId > 0)
                        {
                            var str = E7FRSAdvance.Utility.EnumHelper.GetDisplayNameById<E7FRSAdvance.Utility.Utility.PointMachineEventUpdateType>(point.PointMachineJson.A_VTypeId.Value);
                            <span class="text-black-50">- @str</span>
                        }
                    }
                </td>
            }
            else
            {
                <td onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','AV',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">
                    @point.PointMachineJson.A_V_AVERAGE
                    @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                    {
                        if (point.PointMachineJson.A_VTypeId != null && point.PointMachineJson.A_VTypeId > 0)
                        {
                            var str = E7FRSAdvance.Utility.EnumHelper.GetDisplayNameById<E7FRSAdvance.Utility.Utility.PointMachineEventUpdateType>(point.PointMachineJson.A_VTypeId.Value);
                            <span class="text-black-50">- @str</span>
                        }
                    }
                </td>
            }

            <td>
                <span> @point.PointMachineJson.A_C_TIME </span>
            </td>

            @if (Model.IsHalfPointMachine == null || (Model.IsHalfPointMachine != null && !Model.IsHalfPointMachine.Value))
            {
                if ((point.PointMachineJson.Combine_C_TIME > 0 && point.PointMachineJson.Combine_V_TIME > 0) || (point.PointMachineJson.IsCombineOperation_A && point.PointMachineJson.IsCombineOperation_B))
                {
                    <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId  != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.B || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','BC',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">

                        @string.Format("{0:0.00}", point.PointMachineJson.B_C_MAX)  /  @string.Format("{0:0.00}", @point.PointMachineJson.B_C_AVERAGE) (@Math.Round(point.PointMachineJson.B_C_CurveArea, 2))
