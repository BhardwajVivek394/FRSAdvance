@model Domain.Site
<style>
    .popover {
        width: 100%;
    }

    .popover-content {
        color: black;
    }

    @@media only screen and (max-width: 1200px) {
        .panel-body {
        }
    }

    .tableFixHead {
        overflow: auto;
        height: 100vh;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }

    .progress {
        height: 30px;
        font-size: 18px;
    }

    .progress-bar-animated {
        color: black !important;
    }
</style>
@{
    var bgColor = new string[] { "#215968", "#404040", "#4bacc6" };

}
<div class="people-options clearfix" style="padding:4px">
    <div class="pull-left " style="display:inline-flex">
        <div class="input-group " style="margin-left:20px;">
            @*@Html.TextBoxFor(x => x.SearchCriteria.AssetName, new { @class = "form-control btn-pill asset-search", @placeholder = "Search " })*@
        </div>
    </div>

    <span class="people-count pull-right">Showing <strong id="strDeviceAssetCount"></strong> Assets</span>
    <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-info" onclick="fnListView()" title="List View"><i class="fa fa-list"></i></a></span>
    <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-primary" onclick="fnGridView()" title="Grid View"><i class="fa fa-th-large"></i></a></span>



</div>

<div class="card " id="gridView">
    <div class="card-body" style="padding:15px;">
        <div class="row" id="divAsset">
           
        </div>
    </div>
</div>

    <div class="card" id="listView" style="display:none;">
        <div class="card-header">
            Device Time
        </div>
        <div class="card-body listBody" style="padding:15px;">
            <div class="">
                <div class="">
                    <div class="tableFixHead">
                        <table class="table">
                            <thead class="bg-primary">
                                <tr>
                                    <th style="background-color:#4bacc6;color:white;">
                                        Device Time
                                    </th>
                                    <th style="background-color:#215968;color:white;">
                                        Last Access time
                                    </th>
                                    <th style="background-color:#404040;color:white;">
                                        A10 id
                                    </th>

                                    <th style="background-color:#404040;color:white;width:150px;" colspan="2"></th>
                                </tr>
                            </thead>
                            <tbody class="vh-100" id="tbodyAssetList">
                             
                            </tbody>
                        </table>
                    </div>

                </div>

            </div>
        </div>
    </div>

<script>
    (function ($) {
        $.fn.focusTextToEnd = function () {
            this.focus();
            var $thisVal = this.val();
            this.val('').val($thisVal);
            return this;
        }
    }(jQuery));
    var pmchart;
    var isMultipleAssets = true;
    var json = "";
    var client = null;
    var mQQTPath = "";
    var mQTT = null;
    $(document).ready(function () {
        $("#c0").html('');
        debugger;
     //   $('.dropDownList').select2({ minimumResultsForSearch: Infinity });
         json = @Html.Raw(Json.Encode(Model));

         mQTT =@Html.Raw(Json.Encode(ViewBag.MQTTDetail));

   
        if (json.MQTTBasePath != null && json.MQTTBasePath != '')
            mQQTPath = json.MQTTBasePath;

       
        let isSecure = window.location.protocol === "https:";
        client = new Paho.Client(mQTT.MQTTUri, mQTT.MQTTPort, "clientId" + Math.ceil(Math.random() * 10000));
        // set callback handlers

        client.onConnectionLost = onConnectionLost;
        client.onMessageArrived = onMessageArrived;

        // connect the client
        client.connect({
            onSuccess: onConnect,
            useSSL: isSecure,
            userName: mQTT.MQTTUsername,
            password: mQTT.MQTTPassword,
            cleanSession: true
        });

        //setInterval(function () {
        //    $(".tdHealth").each(function () {
        //        GetAlarmStatus($(this).attr("data-Id"));
        //    })
        //}, 60000)

    });
    function onConnect() {

        client.subscribe(mQQTPath + 'a10');
    }

    // called when the client loses its connection
    function onConnectionLost(responseObject) {
        if (responseObject.errorCode !== 0) {
            console.log("onConnectionLost:" + responseObject.errorMessage);
            //location.reload();
        }
            client.connect({
                onSuccess: onConnect,
                userName: "wattmon",
                password: "wattmon_2018",
                cleanSession: true
            });
    }

    // called when a message arrives
    function onMessageArrived(message) {
        if (message.payloadString.includes("devices")) {
            var parseJson = JSON.parse(message.payloadString);
            if (parseJson != null && parseJson != undefined && parseJson != '') {
                var array = parseJson['devices'];
                if (array != null && array != undefined && array.length > 0) {
                    BindDeviceTimeData(message.destinationName, array);
                }
            }
        }

        var d = new Date();
        var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
        $("#c0").html(time);

    }

    function parseJSON(data) {
        return window.JSON && window.JSON.parse ? window.JSON.parse(data) : (new Function("return " + data))();
    }

    function BindDeviceTimeData(basePath, data) {

        var table = '';
        var tablelistview = '';
        var counter = 0;
        $(data).each(function (id, item) {
            counter++;
           
            var seconds = parseFloat(item.last_response); 
           
            if (parseInt(item.id) > 0) {
                table += `
<div class="col-xl-3 xl-50 news box-col-6">
    <div class="card card-border">
        <div class="bg-secondary main-header" style="padding:0;border-top-left-radius:15px;border-top-right-radius:15px;">
            <div class="" style="width:80%;float:left;padding:10px;border-top-left-radius:15px;">
                <h6 style="margin-left:12px;">
                    <a target="_blank" class="text-white"> Device Time : `+ item.name + `</a>
                </h6>
            </div>
            <div class="text-center bg-dark" style="width: 20%; float: left; padding: 2px 0px; border-top-right-radius: 15px; line-height: 1.3; height: 59.5938px; display: grid;">
                <a onclick="fnShowA10Graph(` + item.id + `)" style="color:white;text-transform:capitalize;font-size:12px;display:flow-root;cursor:pointer;margin-top: 18px;"> Graph </a>
            </div>
        </div>
        <div class="card-body gridBody" style="padding:5px;">
            <div class="table-responsive width100p tblAssetData">
                <table class="table table-striped">
                    <tbody>
                        <tr class="gridassetAttribute_LastAccesstime">
                            <td style="width:50%">Last Access time</td>
                            <td style="width:50%">` + seconds + `</td>
                        </tr>
                        <tr class="gridassetAttribute_A10id">
                            <td style="width:50%">A10 id</td>
                            <td style="width:50%">` + item.id + `</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
`;

                tablelistview += `
<tr data-id="` + item.id + `">
    <td fault-line">
        <a target="_blank"> `+ item.name + `</a>
        <a href="javascript:void(0)" onclick="fnAddManualWatchList(` + item.id + `)"><i class="fa fa-plus"></i></a>
    </td>
    <td>
          ` + seconds + `
    </td>
    <td>
          ` + item.id + `
    </td>
    <td>
        <a onclick="fnShowA10Graph(` + item.id + `)" style="text-transform:capitalize;cursor:pointer;"> Graph </a>
    </td>

</tr>
`;


            }

        });

        $('#divAsset').empty().append(table);
        $('#tbodyAssetList').empty().append(tablelistview);

        $('#strDeviceAssetCount').text(counter);
    }

    function fnGridView() {
        $("#listView").hide();
        $("#gridView").show();
    }
    function fnListView() {
        $("#listView").show();
        $("#gridView").hide();
    }
    function fnSearch() {
        $("#frmAssetDetails").submit();
    }

    function fnShowA10Graph(a10Id) {
        var siteId = $('#hdnsiteId').val();
        var date = $('#searchDeviceDate').val();
        if (a10Id == null || a10Id == undefined || a10Id == '') {
            a10Id = $('#hdnDeviceA10Id').val();
        } else {
            $('#hdnDeviceA10Id').val(a10Id)

        }

        if (siteId != null && siteId != undefined && siteId != '0') {
            $("#loader").show();
            $.ajax({
                url: '/Site/GetA10Graph',
                data: '{siteId:' + siteId + ',date:"' + date + '",a10Id:"' + a10Id + '"}',
                type: 'POST',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    var DataSeriaes = [];
                    var DataColor = [];
                    var maxV = 0;
                    var legends = [];
                    var macLeft = 0;
                    var lary = [];
                    var xValue = [];

                    if (data != null) {
                        $.each(data, function (index, value) {
                            legends.push(index);
                            var lineColor = fnGetDarkColor();
                            DataColor.push(lineColor);
                            if (data != null && data != undefined && data != '') {

                                var attr = {};
                                attr.name = index;
                                attr.type = 'line';
                                attr.notShowSymbol = true;
                                attr.sampling = sampling;
                                attr.hoverAnimation = false;
                                attr.clip = true;

                                attr.data = [];
                                var values = [];
                                $.each(value, function (index2, value2) {

                                    const d = new Date(value2.timestamp);
                                    var dateString = d.getDate() + "-" + (d.getMonth() + 1) + " " + d.getHours() + ":" + d.getMinutes() + "";

                                    if ($.inArray(dateString, xValue) != -1) {
                                    } else {
                                        xValue.push(dateString);
                                    }
                                    values.push(parseFloat(value2.last_response).toFixed(2));
                                });
                                $.each(values, function (i, j) {
                                    var d = parseFloat(j);
                                    if (d > maxV) {
                                        maxV = d;
                                    }
                                });

                                var yLeft = Math.max.apply(Math, values); // 3
                                if (yLeft >= macLeft) {
                                    macLeft = yLeft;
                                }

                                attr.connectNulls = true;
                                attr.data = values;
                                attr.datasetIndex = 0;
                                DataSeriaes.push(attr);

                            }

                        });

                        $("#modal-a10-graph").modal("show");

                        if (pmchart != null && pmchart != "" && pmchart != undefined) {
                            pmchart.dispose();
                        }
                        pmchart = echarts.init(document.getElementById('area-current-graph-echart'));
                        var sampling = 'none';
                        pmchart.setOption({
                            tooltip: {
                                trigger: 'axis',
                                axisPointer: {
                                    type: 'cross',
                                    label: {
                                        backgroundColor: '#6a7985'
                                    }
                                }
                            },
                            legend: {
                                data: legends,
                                x: 'left'

                            },
                            toolbox: {
                                show: true,
                                feature: {
                                    mark: { show: true },
                                    dataView: { show: true, readOnly: false },
                                    magicType: { show: true, type: ['line', 'bar'] },
                                    restore: { show: true },
                                    saveAsImage: { show: true }
                                }
                            },
                            grid: {
                                left: '3%',
                                right: '4%',
                                bottom: '3%',
                                containLabel: true
                            },
                            xAxis: [
                                {
                                    type: 'category',
                                    boundaryGap: false,
                                    axisLine: { onZero: false },
                                    interval: 50,
                                    data: xValue,
                                }
                            ],
                            yAxis: [
                                {
                                    type: 'value',
                                    min: 0,
                                    max: macLeft,
                                    data: lary
                                }
                            ],
                            height: 250,
                            dataZoom: [{
                                type: 'slider',
                                height: 40,
                                start: 0,
                                end: 100,
                                bottom: 0
                            }],
                            color: DataColor,

                            series: DataSeriaes
                        });


                        window.onresize = pmchart.resize;
                    }

                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

</script>