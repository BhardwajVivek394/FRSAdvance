@model Domain.AssetLister
<style>
    .popover {
        width: 100%;
    }

    .popover-content {
        color: black;
    }

    @@media only screen and (max-width: 1200px) {
        .panel-body {
        }
    }
</style>
@{
    var bgColor = new string[] { "#215968", "#404040", "#4bacc6" };
}
<div class="people-options clearfix">
    <div class="pull-left" style="display:inline-flex">

        <div class="input-group " style="margin-left:20px;">
            @Html.TextBoxFor(x => x.SearchCriteria.AssetName, new { @class = "form-control btn-pill asset-search", @placeholder = "Search gate" })
        </div>
    </div>
    @*<div class="btn-group pull-right people-pager">
            @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
            @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
        </div>
        <div class="btn-group pull-right people-pager">
            <button type="button" class="btn btn-default" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left"></i></button>
            <button type="button" class="btn btn-default" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>
        </div>*@
    @{
        int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
        if (Model.mAssets.Count == 0)
        {
            start = 0;
        }
        decimal end = Math.Floor(Model.Pager.TotalRecord);
        if (Model.Pager.PageSize < Model.Pager.TotalRecord)
        {
            if (Model.Pager.PageSize == -1)
            {
                end = Model.Pager.TotalRecord;
            }
            else
            {
                end = Model.Pager.PageSize * Model.Pager.CurrentPage;
                if (end > Model.Pager.TotalRecord)
                {
                    end = Model.Pager.TotalRecord;
                }
            }
        }
    }

    <span class="people-count pull-right">Showing <strong>@Model.mAssets.Count</strong> Assets</span>
    @if (Model.SearchCriteria.IsListView == true)
    {

        <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-info" onclick="fnListView()" title="List View"><i class="fa fa-list"></i></a></span>
        <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-primary" onclick="fnGridView()" title="Grid View"><i class="fa fa-th-large"></i></a></span>
    }
</div>

<div class="card" id="gridView">
    <div class="card-body row" style="padding:15px;">
        @if (Model.mAssets != null && Model.mAssets.Count > 0)
        {
            foreach (var item in Model.mAssets)
            {
                int cnt = item.AssetTypeName.Length + item.Name.Length;
                <div class="col-xl-3 xl-50 news box-col-6">
                    <div class="card card-border">
                        <div class="bg-secondary" style="padding:0;border-top-left-radius:15px;border-top-right-radius:15px;">
                            <div class="" style="width:80%;float:left;padding:10px;border-top-left-radius:15px;">
                                <h6>
                                    <a target="_blank" class="text-white" href="@item.HttpMisLink"> @item.AssetTypeName : @item.Name</a>
                                </h6>
                            </div>
                            <div class="text-center bg-dark" style="width:20%;float:left;padding:2px 0px;border-top-right-radius:15px;line-height:1.3;height:50px">

                                @if (item.UnderMaintence == true)
                                {
                                    <div class="text-center">
                                        <i class="fa fa-bell-slash" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center">
                                        <i class="fa fa-bell" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i>
                                    </div>
                                }
                                <a onclick="fnGetAssetGraph('@item.SiteId','@item.Id')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer"> Graph </a>
                                <a onclick="fnGetSmsLog('@item.Id')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer">Event log</a>
                            </div>

                        </div>
                        @*<div class="card-header bg-primary">
                                <h6>
                                    @item.AssetTypeName : @item.Name
                                    @if (item.UnderMaintence != null && item.UnderMaintence == true)
                                    {
                                        <i class="fa fa-bell-slash pull-right" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i>
                                    }
                                    else
                                    {
                                        <i class="fa fa-bell pull-right" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i>
                                    }
                                    <span><a target="_blank" href="@Url.Action("Alert","SMSLog",new { assetId=item.Id})" style="color:white;text-transform:capitalize;font-size:10px;">Sms Log</a></span>
                                </h6>
                            </div>*@
                        <div class="card-body" style="padding:5px;">
                            <div class="table-responsive width100p tblAssetData">
                                <table class="table table-bordered table-striped">
                                    <tbody id="tblAttributeData@(item.Id)" class="tblAttributes">
                                        @if (item.assetAttributes != null && item.assetAttributes.Count > 0)
                                        {
                                            foreach (var assetAttribute in item.assetAttributes)
                                            {
                                                if (!string.IsNullOrEmpty(assetAttribute.AssetInfoChannel) && !string.IsNullOrWhiteSpace(assetAttribute.AssetInfoChannel))
                                                {
                                                    <tr>
                                                        <td style="width:50%">@assetAttribute.Title</td>
                                                        <td style="width:50%" class="hdnAttributeData@(assetAttribute.Id)@(item.Id)">@assetAttribute.AttributeData</td>
                                                        @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsCalibration)
                                                        {
                                                            <td style="width:50%">
                                                           <a class=""><i class="fa fa-pencil" onclick="fnAddCalibration('@item.Id','@assetAttribute.Id','@assetAttribute.Multiplication','@item.Name','@assetAttribute.Title')"></i></a>
                                                            </td>
                                                        }
                                                        else
                                                        {
                                                            <td></td>
                                                        }
                                                    </tr>
                                                }

                                            }
                                            <tr>
                                                <td style="width:50%">
                                                    Index Score

                                                </td>
                                                <td style="width:50%" class="@(item.IndexScore<7?"text-danger":"")">
                                                    @item.IndexScore
                                                </td>
                                                <td></td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td class="text-center" colspan="3">No attributes found!</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <p style="font-size:15px">No record found!</p>
        }
    </div>
</div>

@if (Model.SearchCriteria.IsListView == true)
{
    <div class="card" id="listView" style="display:none;">
        <div class="card-header">
            Track
        </div>
        <div class="card-body listBody" style="padding:15px;">
            <div class="">
                <div class="">
                    <div class="tableFixHead">
                        <table class="table">
                            <thead class="bg-primary">
                                @if (Model.mAssets != null && Model.mAssets.Count > 0)
                                {
                                    int i = 0;
                                    int j = 0;
                                    foreach (var item in Model.mAssets)
                                    {
                                        if (item.assetAttributes != null && item.assetAttributes.Count > 0 && i == 0)
                                        {
                                            <tr>
                                                <th style="background-color:#4bacc6;color:white;">
                                                    @item.AssetTypeName
                                                </th>
                                                @foreach (var assetAttribute in item.assetAttributes)
                                                {
                                                    if (!string.IsNullOrEmpty(assetAttribute.AssetInfoChannel) && !string.IsNullOrWhiteSpace(assetAttribute.AssetInfoChannel))
                                                    {
                                                        if (assetAttribute.Title.Contains("Last Update"))
                                                        {
                                                            <th style="background-color:@bgColor[j];color:white;width:120px;">
                                                                @assetAttribute.Title
                                                            </th>
                                                        }
                                                        else
                                                        {
                                                            <th style="background-color:@bgColor[j];color:white;">
                                                                @assetAttribute.Title
                                                            </th>
                                                        }
                                                        if (j == 2)
                                                        { j = 0; }
                                                        else
                                                        { j++; }
                                                    }

                                                }
                                                <th style="background-color:#215968;color:white;width:80px;">Index Score</th>
                                                @if (Model.SearchCriteria.AssetTypeName.ToLower() == "Track".ToLower())
                                                {

                                                    <th style="background-color:#404040;color:white;width:80px;">Leakge</th>
                                                    <th style="background-color:#404040;color:white;width:50px;">HEALTH </th>
                                                    <th style="background-color:#215968;color:white;width:50px;">TRACK O/C </th>
                                                }

                                                <th style="background-color:#404040;color:white;width:150px;" colspan="3"></th>
                                            </tr>
                                        }
                                        i++;
                                    }

                                }

                            </thead>
                            <tbody style="max-height: 620px;overflow-y:auto;">
                                @if (Model.mAssets != null && Model.mAssets.Count > 0)
                                {

                                    foreach (var item in Model.mAssets)
                                    {
                                        if (item.assetAttributes != null && item.assetAttributes.Count > 0)
                                        {
                                           
                                            <tr>
                                                <td class="hdnAssetNameTD@(item.Id)">
                                                    <a href="@item.HttpMisLink" target="_blank"> @item.Name</a>
                                                </td>
                                                @foreach (var assetAttribute in item.assetAttributes)
                                                {
                                                    if (!string.IsNullOrEmpty(assetAttribute.AssetInfoChannel) && !string.IsNullOrWhiteSpace(assetAttribute.AssetInfoChannel))
                                                    {
                                                        <td class="hdnAttributeData@(assetAttribute.Id)@(item.Id)">
                                                            @assetAttribute.AttributeData
                                                        </td>
                                                    }
                                                }
                                                <td class="@(item.IndexScore < 7 ? "text-danger" : "")">
                                                    @item.IndexScore
                                                </td>

                                                @if (Model.SearchCriteria.AssetTypeName.ToLower() == "Track".ToLower())
                                                {
                                                    <td class="leakge">
                                                    </td>
                                                    <td data-id="@item.Id" class="checkHealth@(item.Id)">
                                                        @if (item.IsAlarm)
                                                        {
                                                            <span style='cursor:pointer' onclick="GetLogByAssetId(@item.Id)" class="text-danger">Alarm</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-success">Ok</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="text-success trackoc@(item.Id)">C</span>
                                                    </td>
                                                    <td style="">
                                                        @if (item.UnderMaintence == true)
                                                        {
                                                            <div class="text-center"> <i class="fa fa-bell-slash" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i></div>
                                                        }
                                                        else
                                                        {
                                                            <div class="text-center">
                                                                <i class="fa fa-bell" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i>
                                                            </div>
                                                        }
                                                    </td>
                                                }

                                                <td>
                                                    <a onclick="fnGetAssetGraph('@item.SiteId','@item.Id')" style="text-transform:capitalize;cursor:pointer;"> Graph </a>
                                                </td>
                                                <td>
                                                    <a onclick="fnGetSmsLog('@item.Id')" style="text-transform:capitalize;cursor:pointer">Event log</a>
                                                </td>
                                            </tr>
                                        }
                                    }

                                }
                            </tbody>
                        </table>
                    </div>

                </div>

            </div>
        </div>
    </div>
}
<script>
    var isSiteKeeping = stringToBool('@E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping');
    var json = "";
    var client = null;
    var mQQTPath = "";
    var channels = [];
    (function ($) {
        $.fn.focusTextToEnd = function () {
            this.focus();
            var $thisVal = this.val();
            this.val('').val($thisVal);
            return this;
        }
    }(jQuery));
    $(document).ready(function () {
        $(".asset-search").keyup(function (e) {
            setTimeout(function () {
                $("#frmAssetDetails").submit();
            }, 3000)
        });
        $('[data-toggle="popover"]').popover();

        $("#lblAssetType").html($("#AssetName" + $("#hdnassetTypeId").val()).val());
        $(".asset-search").focusTextToEnd();
       // $('#Pager').select2({ minimumResultsForSearch: Infinity });

      //  $('#drpPageSize').select2({ minimumResultsForSearch: Infinity });

        $('#drpPageSize').change(function (e) {
            $("#hdnSkip").val('0');
            //$("#hdndateValue").val();
            //$("#hdnassetTypeId").val();
            $("#frmAssetDetails").submit();
        });
       // $('.dropDownList').select2({ minimumResultsForSearch: Infinity });
        json = @Html.Raw(Json.Encode(Model));
           mQTT=@Html.Raw(Json.Encode(Model.MQTTDetail));
        if (json.SearchCriteria.MQTTPaths != null && json.SearchCriteria.MQTTPaths.length > 0)
            mQQTPath = json.SearchCriteria.MQTTPaths[0];

        if (json.SearchCriteria.ChannelList != null && json.SearchCriteria.ChannelList.length > 0) {
            channels = json.SearchCriteria.ChannelList;
        }
        for (var i = 0; i < channels.length; i++) {
            $("#c" + i).html('');
        }
        ///Create a client instance
        let isSecure = window.location.protocol === "https:";
        client = new Paho.Client(mQTT.MQTTUri, mQTT.MQTTPort, "clientId" + Math.ceil(Math.random() * 10000));
        // set callback handlers

        client.onConnectionLost = onConnectionLost;
        client.onMessageArrived = onMessageArrived;

        // connect the client
        client.connect({
            onSuccess: onConnect,
            useSSL: isSecure,
            userName: mQTT.MQTTUsername,
            password: mQTT.MQTTPassword,
            cleanSession: true
        });

        if (isSiteKeeping || admin == '@E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode()') {
            fnGetWatchList();
        }
    });
    function onConnect() {

        // Once a connection has been made, make a subscription and send a message.
        for (var i = 0; i < channels.length; i++) {
            if (channels[i] != null && channels[i] != "") {
                client.subscribe(mQQTPath + channels[i].toLowerCase());
            }
        }
    }

    // called when the client loses its connection
    function onConnectionLost(responseObject) {
        if (responseObject.errorCode !== 0) {
            //location.reload();
            console.log("onConnectionLost:" + responseObject.errorMessage);
        }
            client.connect({
                onSuccess: onConnect,
                userName: "wattmon",
                password: "wattmon_2018",
                cleanSession: true
            });
    }

    // called when a message arrives
    function onMessageArrived(message) {
        if (message.payloadString.includes("roles") && message.payloadString.includes("ts")) {
            var parseJson = JSON.parse(message.payloadString);
            if (parseJson != null && parseJson != undefined && parseJson != '') {
                var array = parseJson['roles'];
                if (array != null && array != undefined && array.length > 0) {
                    BindGateData(message.destinationName, array);
                }
            }
        } else {
            var channeldata = message.payloadString.split(',');
            BindGateData(message.destinationName, channeldata);
        }

        for (var i = 0; i < channels.length; i++) {
            if (channels[i] != null && channels[i] != "null" && channels[i] != "") {
                var name = mQQTPath.toLowerCase() + channels[i].toLowerCase();
                if (message.destinationName.toLowerCase() == name.toLowerCase()) {
                    var d = new Date();
                    var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
                    $("#c" + i).html(time);
                }
            }
        }
    }

    function BindGateData(basePath, data) {

        $.each(json.mAssets, function (id, item) {

            if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                $.each(item.assetAttributes, function (idx, inItem) {
                    var str1 = basePath.toLowerCase();
                    if (inItem.AssetInfoChannel != null && inItem.AssetInfoChannel != undefined && inItem.AssetInfoChannel != '') {
                        var str2 = inItem.AssetInfoChannel.toLowerCase()
                        if (str1.indexOf(str2) != -1) {

                            var infoValue = inItem.AssetInfoValue;
                            var infoMultiplication = inItem.Multiplication;
                            if (infoValue != null) {
                                var dataValue = data[infoValue];
                                var id = ".hdnAttributeData" + inItem.Id + item.Id;


                                if (infoMultiplication != null) {

                                    var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                    var v = (Math.round(mainData * 100) / 100).toFixed(1);
                                    if (isNumeric(inItem.Title)) {
                                        $(id).html(v);

                                    } else {
                                        if (inItem.GateContectTypeId != null && inItem.GateContectTypeId != undefined && inItem.GateContectTypeId == 1) {
                                            if (v > 4.5) {
                                                $(id).html("<span class='badge badge-success'>Pickup</span>");
                                            }
                                            if (v < 4.5) {
                                                $(id).html("<span class='badge badge-warning'>DROP</span>");
                                            }
                                        } else if (inItem.GateContectTypeId != null && inItem.GateContectTypeId != undefined && inItem.GateContectTypeId == 2) {
                                            if (v > 4.5) {
                                                $(id).html("<span class='badge badge-warning'>DROP</span>");
                                            }
                                            if (v < 4.5) {
                                                $(id).html("<span class='badge badge-success'>Pickup</span>");
                                            }
                                        } else if (inItem.GateContectTypeId != null && inItem.GateContectTypeId != undefined && inItem.GateContectTypeId == 3) {
                                            $(id).html(v);
                                        }
                                    }

                                }
                                else {
                                    if (isNumeric(inItem.Title)) {
                                        $(id).html('');
                                    } else {
                                        if (inItem.GateContectTypeId != null && inItem.GateContectTypeId != undefined && inItem.GateContectTypeId == 1) {
                                            if (v > 4.5) {
                                                $(id).html("<span class='badge badge-success'>Pickup</span>");
                                            }
                                            if (v < 4.5) {
                                                $(id).html("<span class='badge badge-warning'>DROP</span>");
                                            }
                                        } else if (inItem.GateContectTypeId != null && inItem.GateContectTypeId != undefined && inItem.GateContectTypeId == 2) {
                                            if (v > 4.5) {
                                                $(id).html("<span class='badge badge-warning'>DROP</span>");
                                            }
                                            if (v < 4.5) {
                                                $(id).html("<span class='badge badge-success'>Pickup</span>");
                                            }
                                        } else if (inItem.GateContectTypeId != null && inItem.GateContectTypeId != undefined && inItem.GateContectTypeId == 3) {
                                            $(id).html(v);
                                        }
                                    }


                                    //var v = (Math.round(dataValue * 100) / 100).toFixed(1)
                                    //if (v > 4.5) {
                                    //    $(id).html("<span class='badge badge-success'>Pickup</span>");
                                    //}
                                    //if (v < 4.5) {
                                    //    $(id).html("<span class='badge badge-warning'>DROP</span>");
                                    //}
                                }
                            }
                        }
                    }

                });
            }
        });
    }


    function GetMQTTData(basePath, channel) {

        if (assetTypeId > 0 && siteId > 0) {
            $.ajax({
                url: '/Site/GetMQTTData',
                type: 'Post',
                data: '{basePath:"' + basePath + '",channel:"' + channel.toLowerCase() + '"}',
                contentType: 'application/json',
                success: function (data) {
                    if (data!=""&&data != null && data.length > 0) {

                    }
                },
                error: function (response) {
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }

    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmAssetDetails").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize)
            {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmAssetDetails").submit();
            }
        }
    }
    function fnGridView() {
        $("#listView").hide();
        $("#gridView").show();
    }
    function fnListView() {
        $("#listView").show();
        $("#gridView").hide();
    }

    function isNumeric(str) {
        return /[0-9]/.test(str);
    }
</script>