@model List<Domain.PointMachineEvent>

<table class="table table-bordered">
    <thead>
        <tr>
            <th style="background-color: #215968; color: white;">Asset Name</th>
            <th style="background-color: #215968; color: white;">Type</th>
            <th style="background-color: #215968; color: white;">Direction</th>
            <th style="background-color: #215968; color: white;">Voltage Count</th>
            <th style="background-color: #215968; color: white;">Current Count</th>
            <th style="background-color: #215968; color: white;">Time Of Opration</th>
            <th style="background-color: #215968; color: white;" data-sortcolumn="TimeStamp" class="sorting" id="thTimeStamp" onclick="SortList('TimeStamp');">Operation Time</th>
            <th style="background-color: #215968; color: white;" data-sortcolumn="TimeStamp" class="sorting" id="thTimeStamp" onclick="SortList('TimeStamp');">Capture Time</th>
            <th style="background-color: #215968; color: white;" data-sortcolumn="TimeStamp" class="sorting" id="thTimeStamp" onclick="SortList('TimeStamp');">Update Time</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count() > 0)
        {
            var oldTime = DateTime.Now;
            foreach (var item in Model)
            {

                <tr class="table-light">
                    <td>@item.AssetName</td>
                    <td>@item.Type</td>
                    <td>
                        @item.Direction
                    </td>
                    <td>
                        @item.VoltageCount
                    </td>
                    <td>
                        @item.CurrentCount
                    </td>
                    <td>
                        @item.TimeOfOpration
                    </td>
                    <td>@item.OperationTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>@item.CaptureTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>@item.UpdateTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                </tr>

            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center">
                    No record found
                </td>
            </tr>
        }
    </tbody>
</table>
