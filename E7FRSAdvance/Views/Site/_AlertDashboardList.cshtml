@model Domain.AlertsLister


@Html.HiddenFor(x=>x.SearchCriteria.AssetId)
<div class="card-body" style="padding:10px;">
    @if (Model.Asset != null)
    {

        <div class="card-header bg-primary">
            <h4 class="">
                @Model.Asset.AssetTypeName : @Model.Asset.Name
            </h4>
        </div>
        <div class="card-body" style="padding:5px;margin-bottom:-15px">
            <div class="row">
                <div class="col-sm-3 mb10">
                    <label>From Date</label>
                    <input type="text" class="form-control" name="SearchCriteria.FromDate" value="@Model.SearchCriteria.FromDate.ToString("MM/dd/yyyy")" data-language="en" id="txtFromDate" />
                </div>
                <div class="col-sm-3 mb10">
                    <label>To Date</label>
                    <input type="text" class="form-control" name="SearchCriteria.ToDate" value="@Model.SearchCriteria.ToDate.ToString("MM/dd/yyyy")" data-language="en" id="txtToDate" />
                </div>
                <div class="col-sm-3 mb10 m-t-30">
                    <a class="btn btn-success" onclick="Search()">Search</a>
                    <a class="btn btn-default" onclick="Clear()">Clear</a>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead class="bg-primary">
                        <tr>
                            <th style="width:300px;" scope="col">Date</th>
                            <th scope="col">Alert</th>
                        </tr>
                    </thead>
                    <tbody class="fbody">
                        @if (Model.alertMessages != null && Model.alertMessages.Count > 0)
                        {
                            foreach (var item in Model.alertMessages.OrderByDescending(x => x.alert_date).ToList())
                            {

                                var date = Convert.ToDateTime(item.alert_date).ToString("MM/dd/yyyy");

                                <tr>
                                    <td style="display:none">@date</td>
                                    <td style="width:300px;">
                                        <span> @item.alert_date</span><br />
                                    </td>
                                    <td>
                                        @item.alert_message
                                    </td>
                                </tr>

                            }
                        }
                        else
                        {
                            <tr>
                                <td class="text-center" colspan="4">No Record found!</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>

    }
</div>
<script>
     $(document).ready(function () {
        $('#txtFromDate').datepicker();
        $('#txtToDate').datepicker();
    });
</script>