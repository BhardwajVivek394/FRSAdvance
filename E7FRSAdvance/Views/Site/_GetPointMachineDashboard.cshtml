    function fnShowPointMachineData() {
        var start = new Date($('#txtFromDate').val());
        var end = new Date($('#txtToDate').val());
        var days = new Date(end - start) / (1000 * 60 * 60 * 24);
        if (Math.round(days) >= 1) {
            $('#SearchCriteria_TakePointMachineData').show();
        } else {
            $("#SearchCriteria_TakePointMachineData").val($("#SearchCriteria_TakePointMachineData option:first").val());
            $('#SearchCriteria_TakePointMachineData').hide();
        }
    }

    function onConnect() {
        // Once a connection has been made, make a subscription and send a message.
        for (var i = 0; i < channels.length; i++) {
            if (channels[i] != null && channels[i] != "") {
                client.subscribe(mQQTPath + channels[i]);

                client.subscribe(mQQTPath + 'dl/#');
            }
        }
    }

    // called when the client loses its connection
    function onConnectionLost(responseObject) {
        if (responseObject.errorCode !== 0) {
            console.log("onConnectionLost:" + responseObject.errorMessage);
            //location.reload();
        }
            client.connect({
                onSuccess: onConnect,
                userName: "wattmon",
                password: "wattmon_2018",
                cleanSession: true
            });
    }

    // called when a message arrives
    function onMessageArrived(message) {
        if (message.payloadString.includes("roles") && message.payloadString.includes("ts")) {
            var parseJson = JSON.parse(message.payloadString);
            if (parseJson != null && parseJson != undefined && parseJson != '') {
                var array = parseJson['roles'];
                if (array != null && array != undefined && array.length > 0) {
                    BindPointMachineData(message.destinationName, array);

                    try {
                        BindCircuitPointSimulation(message.destinationName, array);

                    }
                    catch (err) {

                    }
                }
            }
        }
        if (message.destinationName.includes("/dl/")) {

            var parseJson = JSON.parse(message.payloadString);
            if (parseJson != null && parseJson != undefined && parseJson != '') {
                var jsonData = parseJson['bits'];
                var tsTime = parseJson['ts'];
                if (tsTime != null) {
                    let timeOnly = tsTime.split(" ")[0];
                    $('#spnDLLastUpdate').text(timeOnly);
                }
                if (jsonData != null && jsonData != undefined && jsonData.length > 0) {
                    var jsonArrayString = '';
                    for (var i = 0; i < jsonData.length; i++) {
                        var decimalNumber = decimalToBinary(jsonData[i]);
                        if (decimalNumber != null) {
                            if (decimalNumber.length != 8) {
                                decimalNumber = ("00000000" + decimalNumber.toString(2)).substr(-8);
                            }
                            const reversedString = decimalNumber.split("").reduce((acc, char) => char + acc, "");

                            jsonArrayString += reversedString;
                        }
                    }
                    var jsonArray = jsonArrayString.split('');
                    if (jsonArray != null && jsonArray != undefined && jsonArray.length > 0) {
                        try {
                            if (isDatalogger == "True") {

                                BindPointDataLoggerAttribute(jsonArray);
                                try {
                                    BindCircuitDataLoggerSimulation(message.destinationName, jsonArray);
                                }
                                catch (err) {

                                }
                            }
                        }
                        catch (err) {

                        }
                    }
                }
            }
        }
        else {
            var channeldata = message.payloadString.split(',');
            BindPointMachineData(message.destinationName, channeldata);
        }


        for (var i = 0; i < channels.length; i++) {
            if (channels[i] != null && channels[i] != "null" && channels[i] != "") {

                var name = mQQTPath.toLowerCase() + channels[i].toLowerCase();
                if (message.destinationName.toLowerCase() == name.toLowerCase()) {
                    var d = new Date();
                    var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
                    $("#c" + i).html(time);
                }
            }
        }
    }

