    function BindPointEventLogData(assetId) {
        var pointMachineData = {};

        pointMachineData.AssetId = assetId;

        if ($("#txtFromDate").val() != "") {
            pointMachineData.StartDate = $("#txtFromDate").val();
        }
        else {
            pointMachineData.StartDate = new Date();
        }

        if ($("#txtToDate").val() != "") {
            pointMachineData.EndDate = $("#txtToDate").val();
        }
        else {
            pointMachineData.EndDate = new Date();
        }
        $("#loader").show();
        $.ajax({
            url: '/Site/BindPointEventLogData',
            type: 'Post',
            data: '{pointMachineData:' + JSON.stringify(pointMachineData) + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divPointEventLogData").empty().append(data);
                $('#modal-Point-Event-LogData').modal('show');
            },
            error: function (response) {
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnSearchPointEventLogData(assetId) {
        var pointMachineData = {};

        pointMachineData.AssetId = assetId;
        pointMachineData.StartDate = $("#txtEventLogFromDate").val();
        pointMachineData.EndDate = $("#txtEventLogToDate").val();

        $("#loader").show();
        $.ajax({
            url: '/Site/_BindPointEventLogDataPartial',
            type: 'Post',
            data: '{pointMachineData:' + JSON.stringify(pointMachineData) + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divmodalPointEventLogData").empty().append(data);
            },
            error: function (response) {
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }
