    function fnGetDarkColor() {
        var allowed = "ABCDEF0123456789", S = "#";

        while (S.length < 7) {
            S += allowed.charAt(Math.floor((Math.random() * 16) + 1));
        }
        return S;
    }

    function fnAddCalibration(assetId, attributeId, multiplication, assetName, attributeName, currentMultiplication) {
        $("#loader").show();
        $.ajax({
            url: '/Site/GetMultiplication',
            type: 'Post',
            data: '{assetId:' + assetId + ',attributeId:' + attributeId + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $('#spn-cal-errorMeassege').text('');
                $('#txt-cal-Multiplication').val('');
                $('#hdn-cal-currentMultiplication').val('');
                $('#spn-cal-currentMultiplication').text('');
                $('#spn-cal-a10Multiplication').text('');
                $('#spn-cal-realtimeMultiplication').text('');
                $('#hdn-cal-assetAttributeId').val(attributeId);
                $('#hdn-cal-multiplication').val(multiplication);
                $('#hdn-cal-currentMultiplication').val(currentMultiplication);
                $('#hdn-cal-assetId').val(assetId);
                $('#spn-cal-assetName').text('(' + assetName + ')');
                $('#spn-cal-attributeName').text('(' + attributeName + ')');

