    function stringToBool(val) {
        return (val + '').toLowerCase() === 'true';
    }

    function TryParseFloat(str, defaultValue) {
        var retValue = defaultValue;
        if (str !== null) {
            if (str.length > 0) {
                if (!isNaN(str)) {
                    retValue = parseFloat(str);
                }
            }
        }
        return retValue;
    }

