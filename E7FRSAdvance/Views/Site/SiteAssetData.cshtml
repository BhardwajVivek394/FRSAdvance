@model Domain.Site
@{
    ViewBag.Title = "Site Asset Data";
}


<script src="~/assets/js/paho-mqtt.js"></script>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<style>
    .card-border {
        border: 1px solid #E6E9ED;
    }

    .daterangepicker.ltr {
        z-index: 99999999;
    }

    .color-box {
        height: 20px;
        width: 20px;
    }

    #imgPointClusterImage {
        width: 300px;
        transform-origin: center center;
        transition: transform 0.05s ease;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(1);
        user-select: none;
        -webkit-user-drag: none;
    }

    .zoom-image-container {
        width: 100%;
        height: 100vh;
        background: #f0f0f0;
        overflow: hidden;
        position: relative;
        cursor: grab;
    }

    .tablemodalFixHead {
        overflow: auto;
        height: 70vh;
    }

        .tablemodalFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }
</style>
<div id="divAssetTypeCircuitDiagram"></div>
<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />
<div class="container-fluid">
    <div class="page-title p-b-0">
        <div class="row">
            <div class="col-6">
                <label style='font-size:18px;margin-top:7px;font-weight:bold'>Site:</label>
                <label style='font-size:16px;margin-top:7px'> @Model.Name's - Dashboard</label>
            </div>
            <div class="col-6">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Site Dashboard</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="row">
        @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping)
        {
            <div class="col-12">
                <div class="card mb-2">
                    <div class="card-header">
                        <h5>Watchlist Search</h5>
                    </div>
                    <div class="card-body">
                        <div class="row mt-2 mb-2">
                            <div class="col-xl-2 col-lg-2 col-md-3 col-sm-3">
                                <span>FromDate</span>
                                <input class="form-control" id="txtWatchlistFromDate" placeholder="From Date" type="text" value="">
                            </div>
                            <div class="col-xl-2 col-lg-2 col-md-3 col-sm-3">
                                <span>ToDate</span>
                                <input class="form-control" id="txtWatchlistToDate" placeholder="To Date" type="text" value="">
                            </div>
                            <div class="col-xl-6 col-lg-6 col-md-6 col-sm-6">
                                <button type="button" class="btn btn-info mt-3" onclick="fnGetWatchList()">Search</button>
                                <button type="button" class="btn btn-success mt-3" onclick="fnDownloadWatchList()">Download</button>
                                <button type="button" class="btn btn-primary mt-3" onclick="fnUpdateWatchlistRegenerate()"><i class="fa fa-refresh"></i></button>
                                <button type="button" class="btn btn-warning mt-3 ml-1" onclick="fnOpenPanelTest()" style="font-weight:600;"><i class="fa fa-tasks mr-1"></i> Panel Test</button>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="col-12" id="divDeviceTime">
            <div class="card mb-2">
                <div class="card-body text-white" style="padding: 15px; font-size: 18px; background-color: #0e5068; border-radius: 12px; " id="divchannel">
                    <div class="row">
                        <div class="col-12 col-lg-4 col-sm-6 col-md-4">
                            Last Update:
                            @for (int i = 0; i < Model.MQTTNoOfChannels; i++)
                            {
                                if (i == (Model.MQTTNoOfChannels - 1))
                                {
                                    <span>@(i+1):</span>
                                    <span id="c@(i)"></span>
                                }
                                else
                                {
                                    <span>@(i+1):</span>
                                    <span id="c@(i)"></span><span> || </span>
                                }
                            }
                        </div>
                        <div class="col-12 col-lg-8 col-sm-6 col-md-8">
                            @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsCalibration)
                            {
                                <div class="row">
                                    <div class="col-12">
                                        <div class="pull-right">
                                            <button type="button" class="btn btn-primary  mb-2" onclick="fnProcessPannelTest(this)">Start Pannel Test</button>
                                            @if (Model.CalibrationStartDate == null && Model.CalibrationEndDate == null)
                                            {
                                                <button type="button" class="btn btn-primary mb-2" onclick="fnProcessCalibration('@Model.Id','Start')">Start Joint Calibration</button>

                                            }
                                            else if (Model.CalibrationStartDate != null && Model.CalibrationStartDate != DateTime.MinValue && Model.CalibrationEndDate != null && Model.CalibrationEndDate != DateTime.MinValue)
                                            {

                                                <button type="button" class="btn btn-primary mb-2" onclick="fnProcessCalibration('@Model.Id','Start')">Start Joint Calibration</button>

                                            }
                                            else if (Model.CalibrationStartDate != null && Model.CalibrationStartDate != DateTime.MinValue)
                                            {
                                                <button type="button" class="btn btn-danger mb-2" onclick="fnProcessCalibration('@Model.Id','Stop')">Stop Joint Calibration</button>

                                            }
                                            <button type="button" class="btn btn-primary  mb-2" onclick="fnProcessClusterValidation('@Model.Id')">Cluster Validation</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (Model.IsDatalogger)
                        {
                            <div class="col-12 col-lg-4 col-sm-6 col-md-4">
                                DL Last Update:
                                <span id="spnDLLastUpdate"></span>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="row" style="margin-bottom:10px">
                    <div class="col-sm-12">
                        <div class="col-sm-4">
                            @if (Model.IsHttpPost != null && Model.IsHttpPost == true)
                            {
                                <input type="hidden" id="hdnIsHttPost" value="true" />
                            }
                            else
                            {
                                <input type="hidden" id="hdnIsHttPost" value="false" />
                            }
                            <input type="hidden" id="hdnNoOfChannel" value="@Model.MQTTNoOfChannels" />
                        </div>
                        <div class="col-sm-8">

                            @using (Ajax.BeginForm("_GetAssetType", "Site", new AjaxOptions() { UpdateTargetId = "divAssetType", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmAssetType", enctype = "multipart/form-data" }))
                            {
                                <div id="divLeftInfo">
                                    @Html.Action("_GetAssetType", new { siteId = Model.Id })
                                </div>
                            }

                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12">
                        @using (Ajax.BeginForm("_GetAssetDetails", "Site", new AjaxOptions() { UpdateTargetId = "divAssetDetails", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmAssetDetails" }))
                        {
                            if (Model.IsCuttingRelayVoltage != null && Model.IsCuttingRelayVoltage.Value)
                            {
                                <input type="checkbox" id="chkIsCuttingRelayVoltage" checked hidden />
                            }
                            else
                            {
                                <input type="checkbox" id="chkIsCuttingRelayVoltage" hidden />
                            }
                            <input type="hidden" id="hdndlAssetTypeId" value="6" />
                            <input type="hidden" name="SearchCriteria.SiteId" id="hdnsiteId" value="@Model.Id" />

                            <input type="hidden" name="SearchCriteria.AssetTypeId" id="hdnassetTypeId" />
                            <input type="hidden" name="SearchCriteria.AssetTypeName" id="hdAssetTypeName" />
                            <div class="people-list p-2" id="divAssetDetails">
                            </div>
                        }

                        @*@using (Ajax.BeginForm("_GetAllAssetLister", "Site", new AjaxOptions() { UpdateTargetId = "divAssetDetails", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { @id = "frmAssetDetails" }))
                            {
                                    <input type="hidden" name="SearchCriteria.SiteId" id="hdnsiteId" value="@Model.Id" />
                                    <input type="hidden" name="SearchCriteria.AssetTypeId" id="hdnassetTypeId" />
                                    <input type="hidden" name="SearchCriteria.AssetTypeName" id="hdAssetTypeName" />
                                    <div class="people-list" id="divAssetDetails">
                                    </div>
                            }*@
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



