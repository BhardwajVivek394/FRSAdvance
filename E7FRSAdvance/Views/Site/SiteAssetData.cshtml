        mAsset.Id = $("#hdnAssetId").val();
        mAsset.SiteId = $("#hdnSiteId").val();
        mAsset.StartDate = sd;
        mAsset.EndDate = ed;
        mAsset.StartTime = $("#tpFrom").val();
        mAsset.EndTime = $("#tpTo").val();
        mAsset.IsReadHttpPost = false;
        mAsset.IsLocal = false;
        if ($("#selDatabase").val() == "HTTP") {
            mAsset.IsReadHttpPost = true;
        }
        if ($("#selDatabase").val() == "Local") {
            mAsset.IsLocal = true;
        }

        $("#loader").show();
        $.ajax({
            url: '/Site/GetReportActualTime',
            type: 'Post',
            data: '{asset:' + JSON.stringify(mAsset) + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                var showDate = "";
                var str = '<table class="table">';
                if (data != null && data.assetAttributes != null) {
                    if (sd == ed) {
                        showDate = sd;
                    }
                    else {
                        showDate = sd + "-" + ed;
                    }

                    str += '<tr>';
                    str += '<th>Time<th>';
                    $(data.assetAttributes).each(function (val, attr) {
                        str += '<th>' + attr.Title + ' (Actual Time,Change Time) <th>';

                    });
                    str += '</tr>';


                    for (var i = 0; i < data.DateList.length; i++) {
                        if (tstime != null && data.DateList[i] == tstime) {
                            str += '<tr>';

                            str += '<td>' + data.DateList[i] + '<td>';
                            $(data.assetAttributes).each(function (val, attr) {
                                str += '<td>' + attr.Data[i] + '<td>';

                            });
                            str += '</tr>';
                        }

                    }

                }
                str += '</table>';
                if (sd == ed) {
