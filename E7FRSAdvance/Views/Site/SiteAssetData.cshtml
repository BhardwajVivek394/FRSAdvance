            $('#imgPannelTestScreenshot').attr('src', canvas.toDataURL());
            $('#modal-show-pannel-test-screenshot').modal('show');

            var mPannelTest = {};
            mPannelTest.FileBase64 = canvas.toDataURL();
            mPannelTest.AssetId = assetId;

            $.ajax({
                url: '/Site/CreatePannelTest',
                type: 'POST',
                data: JSON.stringify(mPannelTest),
                contentType: 'application/json',
                success: function (resultData) {
                },
                error: function (err) {
                    $('#loader').hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });

        });
    }

    function ShowLocationAsset(siteId, assetTypeId, assetId, notMatchedArray) {
        clearInterval(intervalProcessStartPannel);
        $("#loader").show();
        $.ajax({
            url: '/Site/GetLocationAsset',
            type: 'Post',
            data: '{siteId:' + siteId + ',assetTypeId:' + assetTypeId + ',assetId:' + assetId +'}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                var tableItem = '<table class="table">';
                tableItem += '<tr><th>Asset</th><th>Cluster</th><th>Attribute</th><th>Value</th></tr>';
                if (data != null && data != undefined && data != '') {

                    $(notMatchedArray).each(function (v, d) {

                        var filtered = $.grep(data, function (el) {
                            return el.AttributeName.replaceAll(/\s/g, '').toLowerCase().includes(d);
                        });

                        if (filtered != null && filtered != undefined) {
                            $(filtered).each(function (v, filteredval) {
                                tableItem += '<tr>';
                                if (filteredval.AssetId == assetId) {
                                    tableItem += '<td><b>' + filteredval.AssetName + '</b></td>';
                                } else {
                                    tableItem += '<td>' + filteredval.AssetName + '</td>';
                                }

                                tableItem += '<td>' + filteredval.ClusterName + '</td>';
                                tableItem += '<td>' + filteredval.AttributeName + '</td>';
                                tableItem += '<td class="hdnAttributeData' + filteredval.AttributeId + filteredval.AssetId + '"></td>';
                                tableItem += '</tr>';
                            });
                        }

                    });


                }

                tableItem += '</table>';
                $('#divLocationAsset').empty().append(tableItem);
                $('#modal-show-pannel-test-not-matched-attribute').modal('show');

            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

