    function formatDateActualTime(dateString) {
        const date = new Date(dateString);
        const day = date.getDate();
        const month = date.getMonth() + 1;
        const year = date.getFullYear();

        return `${month}/${day}/${year}`;
    }

    function fnShowGraphActualTime(tstime) {
        var sd;
        var ed;

        var d = new Date()
        var date = d.toLocaleDateString();
        var dsd = $("#txtRange").val();

        if (dsd != null && dsd != '') {
            var [start, end] = dsd.split('-');
            var startDate = formatDateActualTime(start)
            var endDate = formatDateActualTime(end)
            if (startDate != date) {
                sd = startDate;
                ed = endDate;
            }
            else {
                if ($("#sel").val() == "0") {
                    var d = new Date()
                    sd = d.toLocaleDateString();
                    ed = d.toLocaleDateString();
                }
                if ($("#sel").val() == "-1") {
                    var d = new Date()
                    d.setDate(d.getDate() - 1);
                    sd = d.toLocaleDateString();
                    ed = d.toLocaleDateString();
                }
                if ($("#sel").val() == "-7") {
                    var d = new Date()
                    d.setDate(d.getDate() - 7);
                    sd = d.toLocaleDateString();
                    ed = new Date().toLocaleDateString();
                }
                if ($("#sel").val() == "-30") {
                    var d = new Date()
                    d.setDate(d.getDate() - 30);
                    sd = d.toLocaleDateString();
                    ed = new Date().toLocaleDateString();
                }
                if ($("#sel").val() == "1") {
                    var d = new Date()
                    var day = d.getDay();

                    d.setDate(d.getDate() - day);
                    sd = d.toLocaleDateString();
                    d.setDate(d.getDate() + 30)
                    ed = d.toLocaleDateString();
                }
                if ($("#sel").val() == "-60") {
                    var d = new Date()
                    var day = d.getDay();
                    d.setDate(d.getDate() - day);
                    sd = d.toLocaleDateString();
                    d.setDate(d.getDate() - 30)
                    ed = d.toLocaleDateString();
                }
            }
        }

