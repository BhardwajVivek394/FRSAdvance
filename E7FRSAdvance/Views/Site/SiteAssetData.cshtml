    function fnShowPointClusterImage(assetId, type, timeStamp) {
        var mSearchCriteria = {};
        mSearchCriteria.AssetId = assetId;
        mSearchCriteria.SearchDate = timeStamp;
        mSearchCriteria.Type = type;

        $("#loader").show();
        $.ajax({
            url: '/Site/GetPointClusterImage',
            type: 'Post',
            data: '{mSearchCriteria:' + JSON.stringify(mSearchCriteria) + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                if (data != null && data != undefined && data != '') {
                    $('#imgPointClusterImage').attr('src', '');
                    $('#imgPointClusterImage').attr('src', 'data:image/png;base64,' + data);
                    $('#modal-point-cluster-image').modal('show');


                    let scale = 1;
                    const zoomStep = 0.1;
                    const minScale = 0.3;
                    const maxScale = 5;

                    let isDragging = false;
                    let lastX, lastY;
                    let img = $('#imgPointClusterImage');
                    let posX = 0, posY = 0;

                    // Zoom on mouse wheel
                    $('.zoom-image-container').on('wheel', function (e) {
                        e.preventDefault();
                        if (e.originalEvent.deltaY < 0) {
                            scale = Math.min(scale + zoomStep, maxScale);
                        } else {
                            scale = Math.max(scale - zoomStep, minScale);
                        }

                        img.css('transform', `translate(${posX}px, ${posY}px) scale(${scale})`);
                    });

                    // Drag logic
                    $('.zoom-image-container').on('mousedown', function (e) {
                        isDragging = true;
                        lastX = e.clientX;
                        lastY = e.clientY;
                        $(this).css('cursor', 'grabbing');
                    });

                    $(document).on('mousemove', function (e) {
                        if (isDragging) {
                            let dx = e.clientX - lastX;
                            let dy = e.clientY - lastY;
                            lastX = e.clientX;
                            lastY = e.clientY;

                            posX += dx;
                            posY += dy;

                            img.css('transform', `translate(${posX}px, ${posY}px) scale(${scale})`);
                        }
                    });

                    $(document).on('mouseup', function () {
                        isDragging = false;
                        $('.zoom-image-container').css('cursor', 'grab');
                    });
                } else {
                    CommonNotification("ERROR", "Image Not Found!", "Error");
                }

            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }
