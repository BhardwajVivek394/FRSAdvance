            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });

    }

    function fnUpdateCalibration() {
        var attributeId = $('#hdn-cal-assetAttributeId').val();
        var multiplication = $('#hdn-cal-multiplication').val();
        var assetId = $('#hdn-cal-assetId').val();
        var newVal = $('#txt-cal-Multiplication').val();
        var currentMultiplication = $('#hdn-cal-currentMultiplication').val();
        if (currentMultiplication == null && currentMultiplication == undefined || currentMultiplication == '') {
            currentMultiplication = $('.hdnAttributeData' + attributeId + assetId + ':first').text();
        }
        if (attributeId != null && attributeId != undefined && attributeId != '' && assetId != null && assetId != undefined && assetId != '' && multiplication != null && multiplication != undefined && multiplication != '' && newVal != null && newVal != undefined && newVal != '' && currentMultiplication != null && currentMultiplication != undefined && currentMultiplication != '') {
            var mAssetInfo = {};
            mAssetInfo.AssetId = assetId;
            mAssetInfo.AssetAttributeId = attributeId;
            mAssetInfo.Multiplication = ((parseFloat(multiplication) / parseFloat(currentMultiplication)) * parseFloat(newVal));
            mAssetInfo.RailwayMultiplication = parseFloat(newVal);
            mAssetInfo.RealTimeValue = (parseFloat(currentMultiplication) / parseFloat(multiplication));
            mAssetInfo.RDPMSMultiplication = parseFloat(multiplication);

            $("#loader").show();
            $.ajax({
                url: '/Site/UpdateCalibration',
                type: 'Post',
                data: JSON.stringify(mAssetInfo),
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $('#hdn-cal-assetAttributeId').val('');
                    $('#txt-cal-Multiplication').val('');
                    $('#txt-cal-assetId').val('');
                    if (data != null && data.multiplication != null && json != null && json != undefined && json.mAssets != null && json.mAssets != undefined) {

                        $(json.mAssets).each(function (val, asset) {

                            if (asset.Id == assetId) {

                                if (asset.assetAttributes != null && asset.assetAttributes != undefined) {

                                    $(asset.assetAttributes).each(function (val, attr) {
                                        if (attr.Id == attributeId && attr.Multiplication != null) {
                                            debugger;
                                            attr.Multiplication = data.multiplication;

                                        }
                                    });

                                }
                            }


                        });

                    }
                    if (data != null) {
                        if (data.type == "success") {
                            $('#txtsuccessfulmessage').text(data.result);
                            $('#modal-successful-message').modal('show');
                            //$("#frmAssetDetails").submit();
                        }
                        else if (data.type == "error") {
                            /*CommonNotification("ERROR", data.result, "error");*/

                            $('#txterrormessage').text(data.result);
                            $('#modal-error-message').modal('show');

                        }
                        else if (data.type == "error") {
                            /*CommonNotification("ERROR", data.result, "error");*/
                            $('#txterrormessage').text(data.result);
                            $('#modal-error-message').modal('show');

                        }

                        $('#model-Add-Calibration').modal('hide');

                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    $('#hdn-cal-assetAttributeId').val('');
                    $('#txt-cal-Multiplication').val('');
                    $('#txt-cal-assetId').val('');
                    $('#txterrormessage').text("Something went wrong!");
                    $('#modal-error-message').modal('show');
                }
            });
        }

    }

