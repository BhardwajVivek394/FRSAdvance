    function fnProcessPannelTest($this) {
        var btnText = $($this).text();
        if (btnText.includes("Start")) {
            $($this).removeClass("btn-primary").addClass("btn-danger");
            $($this).text('Stop Pannel Test');


            $("#loader").show();
            $.ajax({
                url: '/Site/GetAssetAttributesBy',
                type: 'Post',
                data: '{assetTypeId:' + $('#hdnassetTypeId').val() + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    var ifmAPannelVal = null;
                    var irmAPannelVal = null;
                    var vfPannelVal = null;
                    var vrPannelVal = null;
                    var tprPannelVal = null;
                    var chokePannelVal = null;
                    if (data != null && data != undefined && data.length > 0) {
                        $(data).each(function (a, attribute) {
                            if (attribute.Title == 'If mA') {
                                ifmAPannelVal = attribute.PannelTestValue;
                            }
                            else if (attribute.Title == 'Ir mA') {
                                irmAPannelVal = attribute.PannelTestValue;
                            }
                            else if (attribute.Title == 'Vf') {
                                vfPannelVal = attribute.PannelTestValue;
                            }
                            else if (attribute.Title == 'Vr') {
                                vrPannelVal = attribute.PannelTestValue;
                            }
                            else if (attribute.Title == 'Choke V') {
                                chokePannelVal = attribute.PannelTestValue;
                            }
                            else if (attribute.Title == 'TPR V') {
                                tprPannelVal = attribute.PannelTestValue;
                            }
                        });

                    }

                    if (ifmAPannelVal != null && ifmAPannelVal != undefined && irmAPannelVal != null && irmAPannelVal != undefined && vrPannelVal != null && vrPannelVal != undefined && tprPannelVal != null && tprPannelVal != undefined && (vfPannelVal != null && vfPannelVal != undefined || chokePannelVal != null && chokePannelVal != undefined)) {

                        $('.btnPannelTestProcess').each(function () {
                            var ifmA = null;
                            var irmA = null;
                            var vf = null;
                            var vr = null;
                            var tpr = null;
                            var choke = null;

                            var assetId = $(this).data('assetid');
                            if (assetId != null && assetId != undefined && assetId != '') {
                                $('#tblAttributeData' + assetId + ' > tr').each(function () {
                                    var attribute = $(this).find("td").eq(0).text().trim();
                                    var attributeValue = $(this).find("td").eq(1).text().trim();
                                    if (attribute == 'If mA') {
                                        ifmA = attributeValue;
                                    }
                                    else if (attribute == 'Ir mA') {
                                        irmA = attributeValue;
                                    }
                                    else if (attribute == 'Vf') {
                                        vf = attributeValue;
                                    }
                                    else if (attribute == 'Vr') {
                                        vr = attributeValue;
                                    }
                                    else if (attribute == 'Choke V') {
                                        choke = attributeValue;
                                    }
                                    else if (attribute == 'TPR V') {
                                        tpr = attributeValue;
                                    }

                                });
                            }

                            var isShow = true;
                            if (ifmA == null || irmA == null || vr == null || tpr == null) {
                                isShow = false;
                            }
                            else if (TryParseFloat(ifmA, 0) <= 0 || TryParseFloat(irmA, 0) <= 0 || TryParseFloat(vr, 0) <= 0 || TryParseFloat(tpr, 0) <= 0) {
                                isShow = false;
                            }
                            if ((vf != null && vf != undefined && vf != '' && TryParseFloat(vf, 0) <= 0) || (choke != null && choke != undefined && choke != '' && TryParseFloat(choke, 0) <= 0)) {
                                isShow = false;
                            }
                            else if (parseFloat(ifmA) > ifmAPannelVal && parseFloat(irmA) < irmAPannelVal && parseFloat(vr) < vrPannelVal && parseFloat(tpr) < tprPannelVal) {
                                if ((vf != null && vf != undefined && vf != '' && parseFloat(vf) < vfPannelVal) || (choke != null && choke != undefined && choke != '' && parseFloat(choke) > chokePannelVal)) {
                                    isShow = false;
                                }
                            }

                            if (isShow) {
                                $(this).show();
                            }
                        });
                    }
                    else {
                        CommonNotification("ERROR", "Pannel Test Value not configure!", "Error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });





        }
        else {
            $($this).removeClass("btn-danger").addClass("btn-primary");
            $($this).text('Start Pannel Test');
            $('.btnPannelTestProcess').hide();
        }
    }

    function fnProcessStartPannelTest($this, assetId) {
        var ifmA = null;
        var irmA = null;
        var vf = null;
        var vr = null;
        var tpr = null;
        var choke = null;
        var notMatchedCounter = 0;

        if ($($this).attr("title").includes("Start")) {
            $($this).attr("title", "Stop Pannel Test");
            $($this).attr("src", "/assets/images/stop_circle_icon.png");
            $("#loader").show();
            $.ajax({
                url: '/Site/GetAssetAttributesBy',
                type: 'Post',
                data: '{assetTypeId:' + $('#hdnassetTypeId').val() + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    var ifmAPannelVal = null;
                    var irmAPannelVal = null;
                    var vfPannelVal = null;
                    var vrPannelVal = null;
                    var tprPannelVal = null;
                    var chokePannelVal = null;
                    if (data != null && data != undefined && data.length > 0) {
                        $(data).each(function (a, attribute) {
                            if (attribute.Title == 'If mA') {
                                ifmAPannelVal = attribute.PannelTestValue;
                            }
                            else if (attribute.Title == 'Ir mA') {
                                irmAPannelVal = attribute.PannelTestValue;
                            }
                            else if (attribute.Title == 'Vf') {
                                vfPannelVal = attribute.PannelTestValue;
                            }
                            else if (attribute.Title == 'Vr') {
                                vrPannelVal = attribute.PannelTestValue;
                            }
                            else if (attribute.Title == 'Choke V') {
                                chokePannelVal = attribute.PannelTestValue;
                            }
                            else if (attribute.Title == 'TPR V') {
                                tprPannelVal = attribute.PannelTestValue;
                            }
                        });

                    }

                    if (ifmAPannelVal != null && ifmAPannelVal != undefined && irmAPannelVal != null && irmAPannelVal != undefined && vrPannelVal != null && vrPannelVal != undefined && tprPannelVal != null && tprPannelVal != undefined && (vfPannelVal != null && vfPannelVal != undefined || chokePannelVal != null && chokePannelVal != undefined)) {
                        intervalProcessStartPannel = setInterval(function () {

                            $('#tblAttributeData' + assetId + ' > tr').each(function () {
                                var attribute = $(this).find("td").eq(0).text().trim();
                                var attributeValue = $(this).find("td").eq(1).text().trim();
                                if (attribute == 'If mA') {
                                    ifmA = attributeValue;
                                }
                                else if (attribute == 'Ir mA') {
                                    irmA = attributeValue;
                                }
                                else if (attribute == 'Vf') {
                                    vf = attributeValue;
                                }
                                else if (attribute == 'Vr') {
                                    vr = attributeValue;
                                }
                                else if (attribute == 'Choke V') {
                                    choke = attributeValue;
                                }
                                else if (attribute == 'TPR V') {
                                    tpr = attributeValue;
                                }

                            });
                            var notMatchedArray = [];
                            if (TryParseFloat(ifmA, 0) <= parseFloat(ifmAPannelVal, 0)) {
                                notMatchedArray.push('ifma');
                            }
                            if (TryParseFloat(irmA, 0) >= parseFloat(irmAPannelVal, 0)) {
                                notMatchedArray.push('irma');
                            }
                            if (TryParseFloat(vr, 0) >= parseFloat(vrPannelVal, 0)) {
                                notMatchedArray.push('vr');
                            }
                            if (TryParseFloat(tpr, 0) >= parseFloat(tprPannelVal, 0)) {
                                notMatchedArray.push('tpr');
                            }
                            if (vf != null && vf != undefined && vf != '' && TryParseFloat(vf, 0) >= parseFloat(vfPannelVal, 0)) {
                                notMatchedArray.push('vf');
                            }
                            if (choke != null && choke != undefined && choke != '' && TryParseFloat(choke, 0) <= parseFloat(chokePannelVal, 0)) {
                                notMatchedArray.push('choke');
                            }

                            if (notMatchedArray != null && notMatchedArray != undefined && notMatchedArray.length > 0) {
                                notMatchedCounter++;
                                if (notMatchedCounter > 2) {
                                    $($this).attr("title", "Start Pannel Test");
                                    $($this).attr("src", "/assets/images/play_circle_icon.png");
                                    ShowLocationAsset($('#hdnsiteId').val(), $('#hdnassetTypeId').val(), assetId, notMatchedArray);
                                }
                            }
                            else {
                                $($this).attr("title", "Start Pannel Test");
                                $($this).attr("src", "/assets/images/play_circle_icon.png");
                                GenerateScreenshotPDF(assetId);

                            }
                        }, 10000);
                    }
                    else {
                        CommonNotification("ERROR", "Pannel Test Value not configure!", "Error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });

        }
        else {
            $($this).attr("title", "Start Pannel Test");
            $($this).attr("src", "/assets/images/play_circle_icon.png");
            CommonNotification("ERROR", "Train moment not found!", "error");
            clearInterval(intervalProcessStartPannel);

        }



    }

    function GenerateScreenshotPDF(assetId) {
        clearInterval(intervalProcessStartPannel);

        html2canvas($("#divAsset" + assetId)[0], {
            allowTaint: true,
            scrollX: 0,
            scrollY: -window.scrollY
