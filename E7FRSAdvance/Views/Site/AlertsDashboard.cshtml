@model Domain.AlertsLister
@{
    ViewBag.Title = "Alert Data";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="row" style="margin-bottom:10px">
    <div class="col-sm-12">
        <div class="card">

            @using (Ajax.BeginForm("AlertsList", "Site", new AjaxOptions()
            {
                HttpMethod = "POST",
                UpdateTargetId = "divSiteList",
                InsertionMode = InsertionMode.Replace,
                LoadingElementId = "loader",
            }, new { id = "frmAlertMessage" }))
            {
                <div id="divSiteList">
                    @Html.Action("AlertsList", Model)
                </div>
            }
        </div>
    </div>
</div>


<script>
   

    function Search() {
        $("#frmAlertMessage").submit();
        var from = stringToDate($("#txtFromDate").val());
        var to = stringToDate($("#txtToDate").val());

        $(".fbody tr").each(function () {
            var row = $(this);
            var date = stringToDate($.trim(row.find("td").eq(0).text()));

            //show all rows by default
            var show = true;

            //if from date is valid and row date is less than from date, hide the row
            if (from && date < from)
                show = false;

            //if to date is valid and row date is greater than to date, hide the row
            if (to && date > to)
                show = false;

            if (show)
                row.show();
            else
                row.hide();
        });
    }
    function Clear() {
        location.reload();
    }
    function stringToDate(s) {
        var ret = NaN;
        var parts = s.split("/");
        date = new Date(parts[2], parts[0], parts[1]);
        if (!isNaN(date.getTime())) {
            ret = date;
        }
        return ret;
    }
    function stringtableToDate(s) {
        var ret = NaN;
        var parts = s.split("-");
        date = new Date(parts[2], parts[0], parts[1]);
        if (!isNaN(date.getTime())) {
            ret = date;
        }
        return ret;
    }

</script>

