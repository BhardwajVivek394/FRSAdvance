<style>
    .card-header {
        padding: 15px !important;
    }

    td, th {
        vertical-align: middle;
    }

    .btn {
        padding: .375rem .75rem !important
    }

    .nav-quirk > li.nav-parent > a:after {
        content: '\f107';
        font-family: 'FontAwesome';
        font-size: 16px;
        font-weight: 400;
        color: #bdc3d1;
        position: absolute;
        top: 10px;
        right: 15px;
    }


    .overlay {
        height: 100%;
        width: 100%;
        position: fixed;
        z-index: 999999999999999999999999999999999;
        top: 0;
        left: 0;
        /*background-color: rgb(0,0,0);
                      background-color: rgba(176, 176, 176, 0.9);*/
        overflow-x: hidden;
        transition: 0.5s;
    }

    .overlay-content {
        position: relative;
        top: 35%;
        width: 100%;
        text-align: center;
        margin-top: 30px;
    }

    .headerpanel {
        z-index: 200;
    }

    #loader {
        position: fixed;
        z-index: 9999999;
        left: 50%;
        top: 50%;
        transform: translate(-50%,-50%);
        display: none
    }

    .active1 {
        background-color: #dad6ff !important;
    }

    .width60 {
        width: 50px !important;
    }

    .simplebar-content-wrapper {
        margin-top: 30px;
    }

    .table-hover > tbody > tr:hover {
        background-color: #dad6ff !important;
    }
</style>

<div class="loader-box" id="loader">
    <div class="loader-3"></div>
</div>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>


<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body" style="padding:15px;">
                <div class="tab-content mt-0">
                    <div class="tab-pane fade active show" id="eiview">

                        @using (Ajax.BeginForm("_EIViewListPartial", "Site", new AjaxOptions()
                        {
                            HttpMethod = "POST",
                            UpdateTargetId = "divEIViewList",
                            InsertionMode = InsertionMode.Replace,
                            LoadingElementId = "loader",
                            OnSuccess = "EIViewRefreshed"
                        }, new { id = "frmEIViewList" }))
                        {
                            { HtmlHelper.ClientValidationEnabled = false; }
                            @Html.HiddenFor(x => x.SearchCriteria.SiteId)
                            <div id="divEIViewList">
                                @Html.Action("_EIViewListPartial", Model)
                            </div>
                        }

                    </div>

                </div>
            </div>
        </div>

    </div>
</div>

