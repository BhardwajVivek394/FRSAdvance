@model Domain.SiteLister

@{
    ViewBag.Title = "Sites";
}

<style>
    .delete {
        position: absolute;
        right: 18px;
        color: white;
        font-size: 13px;
        cursor: pointer;
        top:20px;
    }

    .edit {
        position: absolute;
        right: 45px;
        color: white;
        font-size: 13px;
        cursor: pointer;
        top: 20px;
    }
</style>
<script src="~/assets/js/paho-mqtt.js"></script>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Sites</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">
        @using (Ajax.BeginForm("SiteList", "Site", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSiteList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "SiteRefreshed"
        }, new { id = "frmGetSiteList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divSiteList">
                @Html.Action("SiteList")
            </div>
        }

        @using (Ajax.BeginForm("SaveSite", "Site", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveSite",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "SiteSaved"
        }, new { id = "frmSaveSite" }))
        {
            <div id="divSaveSite">
                @Html.Partial("_AddSitePartial", new Domain.Site())
            </div>
        }


        <div id="divSaveAsset">
            @Html.Partial("_AddAssetPartial", new Domain.Asset())
        </div>
    </div>
</div>
<div class="modal bounceIn animated" id="modal-add-errocode" tabindex="-1" role="dialog" data-backdrop="static" style="overflow-y:hidden">
    <div class="modal-dialog modal-width modalWidth" style="width:300px">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader">Error Code</span></h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12  mb15">
                        <input type="hidden" id="errId" value="0" />
                        <input type="hidden" id="action" value="add" />
                        <label>ErrorCode Word</label>
                        <input type="text" class="form-control" id="txtErrocode" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-dismiss="modal" id="btnClose">Close</a>
                <button type="button" class="btn btn-success ls-1-2" onclick="fnErrCodeSaveAsset()">Save</button>
            </div>
        </div>
    </div>
</div>



<script src="~/Content/PageJS/Site/SiteIndex.js"></script>
