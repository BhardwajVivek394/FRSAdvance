@model List<Domain.AssetType>

@{
    var bgColor = new string[] { "#4bacc6", "#215968", "#404040", "#4bacc6", "#215968" };
}
@if (Model != null && Model.Count > 0)
{
    int i = 0;
    bool istemp = false;
    foreach (var item in Model)
    {
        if (i == 5)
        {
            i = 2;
        }
        if (item.Id == (int)E7FRSAdvance.Utility.Utility.AssetType.Device_Time)
        {
            <div class='btn-group mr5 assetTypes' style='margin:5px' data-id="@item.Id" data-name="@item.Name" onclick="fnSearchDeviceTimeDashboard('@item.Id','@item.Name')">
                <input type="hidden" value="@item.Name" id="AssetName@(item.Id)" />
                <button type='button' style="border-radius:15px;background-color:@bgColor[i];" class='btn text-white'>@item.Name</button>
            </div>
        }
        else if (!istemp && (item.Id == (int)E7FRSAdvance.Utility.Utility.AssetType.Temperature || item.Id == (int)E7FRSAdvance.Utility.Utility.AssetType.Humidity))
        {
            <div class='btn-group mr5 assetTypes' style='margin:5px' data-id="@E7FRSAdvance.Utility.Utility.AssetType.Temperature.GetHashCode()" data-name="@E7FRSAdvance.Utility.Utility.AssetType.Temperature.ToString()" onclick="SearchAsset('@E7FRSAdvance.Utility.Utility.AssetType.Temperature.GetHashCode()','@E7FRSAdvance.Utility.Utility.AssetType.Temperature.ToString()')">
                <input type="hidden" value="@E7FRSAdvance.Utility.Utility.AssetType.Temperature.ToString()" id="AssetName@(@E7FRSAdvance.Utility.Utility.AssetType.Temperature.GetHashCode())" />
                <button type='button' style="border-radius:15px;background-color:@bgColor[i];" class='btn text-white'>Temperature & Humidity</button>
            </div>
            istemp = true;
        }
        else if(item.Id != (int)E7FRSAdvance.Utility.Utility.AssetType.Temperature && item.Id != (int)E7FRSAdvance.Utility.Utility.AssetType.Humidity)
        {
            <div class='btn-group mr5 assetTypes' style='margin:5px' data-id="@item.Id" data-name="@item.Name" onclick="SearchAsset('@item.Id','@item.Name')">
                <input type="hidden" value="@item.Name" id="AssetName@(item.Id)" />
                <button type='button' style="border-radius:15px;background-color:@bgColor[i];" class='btn text-white'>@item.Name</button>
            </div>
        }


        if (i == 0)
        {
            <script>
                $(document).ready(function () {
                    $("#hdnassetTypeId").val('@item.Id');
                    $("#hdAssetTypeName").val('@item.Name');
    })
            </script>
        }
        i++;
    }
}

<script>
    $(document).ready(function () {
        var isclick = false;
        $(".assetTypes").each(function () {

            if (!isclick) {
                if ($(this).attr("data-name").toLocaleLowerCase() == 'track') {
                    $("#hdnassetTypeId").val($(this).attr("data-id"));
                    $("#hdAssetTypeName").val($(this).attr("data-name"));
                    $("#frmAssetDetails").submit();
                    isclick = true;
                }
            }


        });
        if (!isclick) {
            $(".assetTypes :first").click();
        }

    });
</script>