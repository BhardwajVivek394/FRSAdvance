@model List<Domain.Datalogger>

@{
    string assetsName = string.Empty;
}

<table class="table">
    <thead>
        <tr>
            <th style="background-color: #215968; color: white;">SR No.</th>
            <th style="background-color: #215968; color: white;">Asset</th>
            <th style="background-color: #215968; color: white;">Attribute</th>
            <th style="background-color: #215968; color: white;">Current Value</th>
            <th style="background-color: #215968; color: white;">Time Stamp</th>
            <th style="background-color: #215968; color: white;">Update Time</th>
            <th style="background-color: #215968; color: white;">Type</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model.OrderByDescending(x => x.Date))
            {
                <tr>
                    <td>@item.SrNo</td>
                    <td>@item.AssetName</td>
                    <td>@item.AttributeName</td>
                    <td>
                        @if (item.CurrentValue == "Pickup")
                        {
                            <span class='badge badge-success'>Pickup</span>
                        }
                        else if (item.CurrentValue == "Drop")
                        {
                            <span class='badge badge-warning'>DROP</span>
                        }

                    </td>
                    <td>@item.Timestamp</td>
                    <td>@item.CurrentDate.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                    <td>@item.Type</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">
                    No record found
                </td>
            </tr>
        }
    </tbody>

</table>


