    function fnGetEarthFaultSignal(siteId, assetTypeId) {
        $("#loader").show();
        var assetId = $("#hdnAssetId").val();
        $.ajax({
            url: '/Site/GetAssets',
            type: 'POST',
            data: '{siteId:' + siteId + ',assetTypeId:' + assetTypeId + ',assetId:' + assetId + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                var str = "";
                $("#divEarthFaultSignal").empty();
                $.each(data, function (key, value) {
                    str += "  ";
                    if (value.IsChecked) {
                        str += "<input type='checkbox' id='chk_" + value.Id + "' value='" + value.Id + "' name='chkEarthFaultSignal' checked/>";
                    } else {
                        str += "<input type='checkbox' id='chk_" + value.Id + "' value='" + value.Id + "' name='chkEarthFaultSignal'/>";
                    }

                    str += " <label for='chk_" + value.Id + "'>" + value.Name + "</label>";
                });
                $("#divEarthFaultSignal").append(str);


            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

