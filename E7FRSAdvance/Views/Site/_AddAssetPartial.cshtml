@model Domain.Asset

<style>
    @@media(max-width:800px) {
        .modalWidth {
            width: 600px;
        }
    }

    .nav-tabs .nav-link {
        background-color: #d9edf7 !important;
        color: #306F90;
    }

        .nav-tabs .nav-link.active {
            background-color: white !important;
            border-color: #bce8f1 #bce8f1 #fff;
            color: #306F90;
        }

    .nav-tabs {
        background-color: #d9edf7; /* Light Blue bar background */
    }

    .tab-content {
        border: 1px solid #bce8f1;
        border-top: none;
        background-color: #fff;
        padding: 15px;
        min-height: 200px; /* Just for demo */
    }

    .signal-box {
        border: 1px solid #dee2e6;
        border-radius: 0.375rem;
        padding: 10px;
        min-width: 150px;
    }

    .signal-header {
        font-weight: bold;
        margin-bottom: 5px;
    }

    .badge-counter {
        margin-left: 6px;
    }
</style>

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-asset" tabindex="-1" role="dialog" data-bs-backdrop="static" aria-labelledby="modal-add-asset" style="overflow-y:hidden">
    <div class="modal-dialog  modal-xl">
        <div class="modal-content bradius4">
            <input type="hidden" id="hdnName" value="@Model.AssetTypeName" />
            @Html.HiddenFor(m => Model.Id, new { @id = "hdnAssetId" })
            @Html.HiddenFor(m => Model.AssetTypeId, new { @id = "hdnAssetTypeId1" })
            @Html.HiddenFor(m => Model.SiteId, new { @id = "hdnSiteId1" })
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Asset</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader">Edit Asset</span></h4>
                }
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body modal-fixed-height">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-4">
                            <label class="control-label">Name <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.Name, new { @class = "form-control", tabindex = 1, id = "txtName" })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <label class="control-label">Http Link </label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.HttpMisLink, new { @class = "form-control", id = "txtHttpLink" })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        @if (Model.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK)
                        {
                            <div class="col-sm-2">
                                <label class="control-label">Number Of Cell </label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.NumberOfCell, new { @class = "form-control", id = "txtNumberOfCell" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        }
                        <div class="col-sm-2">
                            <label class="control-label mt-4"><span>Is Active</span>  @Html.CheckBoxFor(m => Model.IsActive, new { style = "vertical-align:sub", tabindex = 2, id = "chkIsActive" })</label>
                        </div>
                        @if (Model.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL)
                        {
                            <div class="col-sm-2">
                                <label class="control-label mt-4"><span>Is Temperature</span>  @Html.CheckBox("IsTemperature", new { style = "vertical-align:sub", tabindex = 3, id = "chkIsTemperature" })</label>
                            </div>
                        }

                        @if (Model.AssetTypeName == "Earth Fault")
                        {
                            <div class="col-sm-2" id="refVal">
                                <label class="control-label">Reference Value</label>
                                <div class="">
                                    @Html.TextBox("ReferenceValue", Model.ReferenceValue, new { @class = "form-control", id = "txtReferenceValue" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        }
                        @if (Model.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.BHMS)
                        {
                            <div class="col-sm-2">
                                <label class="control-label">Type</label>
                                <div class="">
                                    @Html.DropDownList("BHMSTypeId", EnumHelper.GetSelectList(typeof(E7FRSAdvance.Utility.Utility.BHMSType)), new { @class = "form-control", id = "drpBHMSType" })
                                    @*<select class="form-control">
                        <option id="@E7FRSAdvance.Utility.Utility.BHMSType.Direct.GetHashCode()">Direct</option>
                        <option id="@E7FRSAdvance.Utility.Utility.BHMSType.Cumulative.GetHashCode()">Cumulative</option>
                    </select>*@
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        }
                        @if (Model.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.IPS)
                        {
                            <div class="col-sm-2">
                                <label class="control-label">Type</label>
                                <div class="">

                                    @Html.DropDownListFor(
    model => model.IPSTypeId,
    new SelectList(E7FRSAdvance.Utility.EnumHelper.GetEnumSelectList<E7FRSAdvance.Utility.Utility.IPSType>(), "Value", "Text"), "Select",
    new { @class = "form-control", id = "drpIPSTypeId" }
)

                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        }

                        <div class="col-sm-12">


                            @if (Model.siteAttributeDatasList != null && Model.siteAttributeDatasList.Count > 0 && Model.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL)
                            {
                                <div class="row">
                                    @*<div class="col-sm-2">
                        <label class="control-label"><span>Is Active</span>  @Html.CheckBoxFor(m => Model.IsActive, new { style = "vertical-align:sub", tabindex = 2, id = "chkIsActive" })</label>
                    </div>
                    <div class="col-sm-2">
                        <label class="control-label"><span>Is Temperature</span>  @Html.CheckBox("IsTemperature", new { style = "vertical-align:sub", tabindex = 3, id = "chkIsTemperature" })</label>
                    </div>*@

                                    @{
                                        var enumAttriuteType = (from E7FRSAdvance.Utility.Utility.AttributeType e in Enum.GetValues(typeof(E7FRSAdvance.Utility.Utility.AttributeType))
                                                                select new
                                                                {
                                                                    Id = (int)e,
                                                                    Name = e.ToString().Replace("_", " ")
                                                                }).ToList();
                                    }

                                    @foreach (var attrType in enumAttriuteType)
                                    {

                                        var istypeChk = false;
                                        foreach (var siteattr in Model.siteAttributeDatasList)
                                        {
                                            if (ViewBag.AssetAttributes != null)
                                            {
                                                var attrs = ViewBag.AssetAttributes as List<Domain.AssetAttribute>;
                                                if (attrs != null)
                                                {
                                                    var attr = attrs.Where(x => (x.Title.StartsWith(siteattr))).FirstOrDefault();
                                                    if (attr != null && attr.Id > 0 && attr.Type != null && attr.Type == attrType.Id)
                                                    {
                                                        var isChecked = Model.assetAttributes.Where(x => (x.Title.StartsWith(siteattr) && x.IsSuccess)).Count() > 0 ? true : false;
                                                        if (isChecked)
                                                        {
                                                            istypeChk = true;
                                                            break;
                                                        }

                                                    }

                                                }


                                            }




                                        }


                                        <div class="col-sm-2">
                                            <div class="form-check signal-header">
                                                @if (istypeChk)
                                                {
                                                    <input class="form-check-input mainSignalTypes" type="checkbox" id="mainSignal@(attrType.Id)" data-attrid="@(attrType.Id)" onchange="fnChangeSignalType(this)" checked>
                                                }
                                                else
                                                {
                                                    <input class="form-check-input mainSignalTypes" type="checkbox" id="mainSignal@(attrType.Id)" data-attrid="@(attrType.Id)" onchange="fnChangeSignalType(this)">
                                                }
                                                <label class="form-check-label" for="mainSignal@(attrType.Id)">@attrType.Name</label>
                                            </div>
                                            <div class="signal-box">

                                                <div>
                                                    @foreach (var siteattr in Model.siteAttributeDatasList)
                                                    {
                                                        if (ViewBag.AssetAttributes != null)
                                                        {
                                                            var attrs = ViewBag.AssetAttributes as List<Domain.AssetAttribute>;
                                                            if (attrs != null)
                                                            {
                                                                var attr = attrs.Where(x => (x.Title.StartsWith(siteattr))).FirstOrDefault();
                                                                if (attr != null && attr.Id > 0 && attr.Type != null && attr.Type == attrType.Id)
                                                                {
                                                                    var isChecked = Model.assetAttributes.Where(x => (x.Title.StartsWith(siteattr) && x.IsSuccess)).Count() > 0 ? true : false;
                                                                    <div class="form-check">
                                                                        <input class="form-check-input chkAttribute" data-id="@siteattr" data-attributeid="@attrType.Id" type="checkbox" id="chkAttribute_@siteattr" @(isChecked == true ? "checked" : "") onclick="GetAttributes()">

                                                                        <label class="form-check-label" for="@siteattr">@siteattr</label>
                                                                    </div>
                                                                }

                                                            }
                                                        }
                                                    }

                                                    @*<div class="form-check"><input class="form-check-input" type="checkbox" id="hg"><label class="form-check-label" for="hg">HG</label></div>
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="dg"><label class="form-check-label" for="dg">DG</label></div>
                                    <div class="form-check"><input class="form-check-input" type="checkbox" id="hhg"><label class="form-check-label" for="hhg">HHG</label></div>*@
                                                </div>
                                            </div>
                                        </div>
                                    }




                                    @*@foreach (var item in Model.siteAttributeDatasList)
                    {
                        if (!item.Contains("Last") && !item.Contains("Zero"))
                        {
                            var isChecked = Model.assetAttributes.Where(x => (x.Title.StartsWith(item) && x.IsSuccess)).Count() > 0 ? true : false;

                            if (item == "LUX")
                            {
                                isChecked = Model.assetAttributes.Where(x => (x.Title.EndsWith(")") && x.IsSuccess)).Count() > 0 ? true : false;

                            }

                            <div class="col-sm-2 @(item.StartsWith("UG") ? "divUG" : "")" style="display:@(item.StartsWith("UG") ? "none" : "block");">
                                <label class="control-label">
                                    <span>@item</span>
                                    @if (item == "Root")
                                    {
                                        <input style="cursor:pointer;vertical-align:sub" type="checkbox" data-id="@item" id="chkAttributeRoot" @(isChecked == true ? "checked" : "") onclick="fnCheckIsUG(this)" />
                                    }
                                    else
                                    {
                                        <input style="cursor:pointer;vertical-align:sub" class="chkAttribute" type="checkbox" data-id="@item" id="chkAttribute_@item" @(isChecked == true ? "checked" : "") onclick="GetAttributes()" />
                                    }
                                </label>
                            </div>
                        }

                    }*@
                                </div>
                            }
                            else if (Model.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE)
                            {
                                <div class="row">

                                    @foreach (var item in Model.siteAttributeDatasList)
                                    {
                                        bool isChecked = false;
                                        if (item.ToLower() == "Vibration".ToLower())
                                        {
                                            isChecked = Model.assetAttributes.Where(x => x.Title.StartsWith(item) && x.IsSuccess).Count() > 0 ? true : false;
                                        }
                                        else
                                        {
                                            isChecked = Model.assetAttributes.Where(x => (x.Title.StartsWith("A End") || x.Title.StartsWith("B End")) && x.IsSuccess).Count() > 0 ? true : false;
                                        }
                                        <div class="col-sm-2">
                                            <label class="control-label">
                                                <span>@item</span>
                                                <input style="cursor:pointer;vertical-align:sub" class="chkAttribute" type="checkbox" data-id="@item" id="chkAttribute('@item')" @(isChecked == true ? "checked" : "") onclick="GetAttributes1()" />
                                            </label>
                                        </div>
                                    }
                                    <div class="col-sm-2">
                                        <label class="control-label">
                                            <span>Parallel  Alert</span>
                                            <input type="checkbox" id="chkAlertParrallel" checked style="vertical-align:sub;" onclick="fnParrallelAlert(this)" />
                                        </label>
                                    </div>
                                    <div class="col-sm-2">
                                        <label class="control-label">
                                            <span>Series Alert</span>
                                            <input type="checkbox" id="chkAlertSeries" style="vertical-align:sub;" onclick="fnSeriesAlert(this)" />
                                        </label>
                                    </div>
                                    <div class="col-sm-2">
                                        <label class="control-label">
                                            <span>Is Half Point Machine</span>
                                            @if (Model.IsHalfPointMachine != null)
                                            {
                                                @Html.CheckBoxFor(m => Model.IsHalfPointMachine.Value, new { style = "vertical-align:sub", id = "chkHalfPointMachine" })

                                            }
                                            else
                                            {
                                                <input type="checkbox" id="chkHalfPointMachine" style="vertical-align:sub;" />
                                            }
                                        </label>
                                    </div>
                                    <div class="col-sm-2">
                                        <label class="control-label">
                                            <span>Is Thick Wave</span>
                                            @if (Model.IsThickWave != null)
                                            {
                                                @Html.CheckBoxFor(m => Model.IsThickWave.Value, new { style = "vertical-align:sub", id = "chkIsThickWave" })

                                            }
                                            else
                                            {
                                                <input type="checkbox" id="chkIsThickWave" style="vertical-align:sub;" />
                                            }
                                        </label>
                                    </div>
                                    <div class="col-sm-3">
                                        <label class="control-label">
                                            <span>Is Series Opration</span>
                                            @if (Model.IsSeriesOpration != null)
                                            {
                                                @Html.CheckBoxFor(m => Model.IsSeriesOpration.Value, new { style = "vertical-align:sub", id = "chkIsSeriesOpration" })

                                            }
                                            else
                                            {
                                                <input type="checkbox" id="chkIsSeriesOpration" style="vertical-align:sub;" />
                                            }
                                        </label>
                                    </div>
                                    <div class="col-sm-3">
                                        <label class="control-label">
                                            <span>Is Displacement</span>
                                            @if (Model.ISDisplacement != null && Model.ISDisplacement.Value)
                                            {
                                                <input type="checkbox" class="chkAttribute" id="chkISDisplacement" style="vertical-align:sub;" onclick="GetAttributes1()" data-id="Displacement" checked />

                                            }
                                            else
                                            {
                                                <input type="checkbox" class="chkAttribute" id="chkISDisplacement" style="vertical-align:sub;" onclick="GetAttributes1()" data-id="Displacement" />
                                            }

                                        </label>
                                    </div>
                                    <div class="col-sm-12">
                                        <div class="row">
                                            <div class="col-sm-3" id="divThickWaveTypeId">
                                                <label class="control-label">
                                                    <span>Thick Wave Type</span>
                                                    @Html.DropDownList("ThickWaveTypeId", EnumHelper.GetSelectList(typeof(E7FRSAdvance.Utility.Utility.ThickWaveType)), new { @class = "form-control" })

                                                </label>

                                            </div>
                                            <div class="col-sm-9" id="divSeriesOprationTypeId">
                                                <label class="control-label">
                                                    <span>Series Opration Type</span>
                                                    @Html.DropDownList("SeriesOprationTypeId", EnumHelper.GetSelectList(typeof(E7FRSAdvance.Utility.Utility.SeriesOprationType)), new { @class = "form-control" })

                                                </label>

                                                <label class="control-label">
                                                    <span>Direction A</span>
                                                    @Html.TextBoxFor(m => Model.AliasDirectionA, new { @class = "form-control", id = "txtAliasDirectionA", @style = "Width:150px", @placeHolder = "Direction A" })
                                                </label>
                                                <label class="control-label">
                                                    <span>Direction B</span>
                                                    @Html.TextBoxFor(m => Model.AliasDirectionB, new { @class = "form-control", id = "txtAliasDirectionB", @style = "Width:150px", @placeHolder = "Direction B" })

                                                </label>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="col-sm-12" id="divDisplacement">
                                        <div class="row">
                                            <div class="col-sm-2">
                                                <label class="control-label">
                                                    <span>Machine A</span>
                                                    @Html.DropDownList("MachineA", EnumHelper.GetSelectList(typeof(E7FRSAdvance.Utility.Utility.DisplacementType)), new { @class = "form-control" })

                                                </label>

                                            </div>
                                            <div class="col-sm-2">
                                                <label class="control-label">
                                                    <span>Machine B</span>
                                                    @Html.DropDownList("MachineB", EnumHelper.GetSelectList(typeof(E7FRSAdvance.Utility.Utility.DisplacementType)), new { @class = "form-control" })

                                                </label>

                                            </div>

                                        </div>

                                    </div>
                                </div>
                                <div class="profile-right-body mt10">

                                    <ul class="nav nav-tabs" id="info-tab" role="tablist">
                                        <li class="nav-item">
                                            <button class="nav-link active" data-bs-target="#Config" data-bs-toggle="tab" role="tab" aria-controls="Numbers" aria-selected="true" data-bs-original-title="" title="">
                                                <strong>Config</strong>
                                            </button>
                                        </li>
                                        <li class="nav-item">
                                            <button class="nav-link" data-bs-target="#Alerts" data-bs-toggle="tab" role="tab" aria-controls="Alerts" aria-selected="true" data-bs-original-title="" title=""><strong>Alerts</strong></button>
                                        </li>
                                        <li class="nav-item" style="display:none;">
                                            <button class="nav-link" data-bs-target="#AlertsSeries" data-bs-toggle="tab" role="tab" aria-controls="AlertsSeriess" aria-selected="true" data-bs-original-title="" title=""><strong>Series Alerts</strong></button>
                                        </li>
                                        <li class="nav-item">
                                            <button class="nav-link" data-bs-target="#VibrationAlerts" data-bs-toggle="tab" role="tab" aria-controls="VibrationAlerts" aria-selected="true" data-bs-original-title="" title=""><strong>Vibration Alerts</strong></button>
                                        </li>
                                        @if (Model.IsDatalogger)
                                        {
                                            <li class="nav-item">
                                                <button class="nav-link" data-bs-target="#DataLoggerConfig" data-bs-toggle="tab" role="tab" aria-controls="DataLoggerConfig" aria-selected="true" data-bs-original-title="" title=""><strong>DL Config</strong></button>
                                            </li>
                                        }
                                        <li class="nav-item">
                                            <button class="nav-link" data-bs-target="#FRSAlerts" data-bs-toggle="tab" role="tab" aria-controls="FRSAlertsConfig" aria-selected="true" data-bs-original-title="" title=""><strong>FRS Alerts</strong></button>
                                        </li>
                                        <li class="nav-item">
                                            <button class="nav-link" data-bs-target="#AlertInfoActivation" data-bs-toggle="tab" role="tab" aria-controls="AlertInfoActivation" aria-selected="true" data-bs-original-title="" title=""><strong>Cause Code Activation</strong></button>
                                        </li>
                                    </ul>
                                    <!-- Tab panes -->
                                    <div class="tab-content">
                                        <div class="tab-pane fade active show" id="Config" style="padding:0px">
                                            <div class="table-responsive" style="max-height: 400px;">
                                                <table class="table mt20">
                                                    <thead>
                                                        <tr>
                                                            <th>Attributes</th>
                                                            <th>Channels</th>
                                                            <th>Value</th>
                                                            <th>Multiplication</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="tbodyAttr">
                                                        @if (Model.assetAttributes != null && Model.assetAttributes.Count > 0)
                                                        {
                                                            foreach (var item in Model.assetAttributes)
                                                            {
                                                                <tr>
                                                                    <td style="vertical-align:middle">
                                                                        @item.Title
                                                                        <input type="text" class="form-control" value="@item.HttpPostName" />
                                                                    </td>
                                                                    <td style="vertical-align:middle">
                                                                        @if (item.Title == "Name" || item.Title == "Widget#")
                                                                        {
                                                                            <select class="form-control drpChannel" id="channel@(item.Id)" disabled>
                                                                                <option value="">Select Channel</option>
                                                                            </select>
                                                                        }
                                                                        else
                                                                        {
                                                                            <select class="form-control drpChannel" id="channel@(item.Id)">
                                                                                <option value="">Select Channel</option>
                                                                                @for (int i = 1; i <= Model.MQTTNoOfChannels; i++)
                                                                                {
                                                                                    string channel = "Channel" + i;
                                                                                    if (item.AssetInfoChannel != null && item.AssetInfoChannel == channel)
                                                                                    {
                                                                                        <option value="Channel@(i)" selected>Channel @i</option>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <option value="Channel@(i)">Channel @i</option>
                                                                                    }
                                                                                }
                                                                            </select>
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        @if (item.AssetInfoValue != null && item.AssetInfoValue != "")
                                                                        {
                                                                            <input type="text" data-id="@item.Id" class="form-control" value="@item.AssetInfoValue" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <input type="text" data-id="@item.Id" class="form-control" />
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        @if (item.Multiplication.HasValue)
                                                                        {
                                                                            <input type="text" data-id="@item.Id" class="form-control multiplication" value="@item.Multiplication.Value" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <input type="text" data-id="@item.Id" class="form-control multiplication" />
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <tr>
                                                                <td colspan="4" class="text-center">
                                                                    No record found!
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                        <div class="tab-pane fade" id="Alerts" style="padding:0px;margin-top:20px;">
                                            <div class="table-responsive" style="max-height: 400px;">
                                                <table class="table mt20">
                                                    <thead>
                                                        <tr>
                                                            <th></th>
                                                            <th>Alert Name</th>
                                                            <th>Operators</th>
                                                            <th>Value A</th>
                                                            <th>Value B</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="tbodyOperators">
                                                        @if (Model.mAlerts != null && Model.mAlerts.Count > 0)
                                                        {
                                                            foreach (var item in Model.mAlerts.Where(x => x.AlertType != null && x.AlertType == "Parallel").ToList())
                                                            {
                                                                <tr>
                                                                    <td style="vertical-align:middle">
                                                                        @if (item.IsActive)
                                                                        {
                                                                            <input style="cursor:pointer;vertical-align:sub" class="chkAlert" type="checkbox" data-id="@item.Id" id="chkAlert('@item.Id')" checked />
                                                                        }
                                                                        else
                                                                        {
                                                                            <input style="cursor:pointer;vertical-align:sub" class="chkAlert" type="checkbox" data-id="@item.Id" id="chkAlert('@item.Id')" />
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        @if (!string.IsNullOrEmpty(item.AlertName))
                                                                        {
                                                                            <input type="text" data-id="@item.Id" class="form-control" value="@item.AlertName" readonly />
                                                                        }
                                                                        else
                                                                        {
                                                                            <input type="text" data-id="@item.Id" class="form-control" readonly />
                                                                        }
                                                                    </td>
                                                                    <td style="vertical-align:middle">
                                                                        <select class="form-control drpOperators" id="operators@(item.Id)">
                                                                            <option value="">Select Operator</option>
                                                                            @foreach (var operators in Model.mOperators)
                                                                            {
                                                                                if (item.OperatorId == operators.Id)
                                                                                {
                                                                                    <option value="@operators.Id" selected>@operators.Value</option>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <option value="@operators.Id">@operators.Value</option>
                                                                                }
