    function fnChangeSignalType($this) {

        var shunt = '@E7FRSAdvance.Utility.Utility.AttributeType.Shunt.GetHashCode()';
        var main = '@E7FRSAdvance.Utility.Utility.AttributeType.Main.GetHashCode()';
        var calling = '@E7FRSAdvance.Utility.Utility.AttributeType.Calling.GetHashCode()';
        var route = '@E7FRSAdvance.Utility.Utility.AttributeType.Route.GetHashCode()';

        $('.mainSignalTypes').each(function () {

            var attrid = $($this).data('attrid');
            if ($(this).prop('checked') == true) {

                debugger;
                if (attrid == main) {
                    $('#mainSignal' + shunt).prop('checked', false);
                }
                else if (attrid == calling) {
                    $('#mainSignal' + shunt).prop('checked', false);
                }
                else if (attrid == route) {
