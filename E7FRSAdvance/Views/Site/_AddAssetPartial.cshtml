            $("#AdjacentTypeId_" + id).val("0");
            $("#AdjacentTypeId_" + id).prop('disabled', true);
        }
    }

    function fnShowAlertInfo(id, $this) {
        if (id != null && id != '' && id != undefined) {
            if ($($this).hasClass("fa fa-plus")) {
                $($this).removeClass("fa fa-plus").addClass("fa fa-minus");
                $('.trFrsAlert_' + id).show();
            } else {
                $($this).removeClass("fa fa-minus").addClass("fa fa-plus");
                $('.trFrsAlert_' + id).hide();
            }
        }
