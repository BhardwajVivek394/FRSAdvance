<script>
    $(document).ready(function () {
        $('#drpDataloggerSearchAttribute').select2();

        $('#txtDataloggerSearchDate').datepicker({
            dateFormat: 'd/m/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#txtPointEventSearchDate').datepicker({
            dateFormat: 'd/m/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#txtDataloggerSearchDate').change(function () {
            fnSearchEventDataLoggerGraph();
        });

        $('#txtPointEventSearchDate').change(function () {
            fnSearchPointEvent();
        });
    })

    function fnSearchEventDataLoggerGraph() {
        var siteId = '@Model.SiteId';
        var attrSrNo = $('#drpDataloggerSearchAttribute').val();
        var searchCriteria = {};
        searchCriteria.SearchDate = $('#txtDataloggerSearchDate').val();
        searchCriteria.AssetId = '@Model.Id';
        searchCriteria.SiteId = siteId;

        searchCriteria.SrNumbers = [];
        if (attrSrNo != null && attrSrNo != undefined && attrSrNo != '') {
            $(attrSrNo).each(function (att, val) {
                searchCriteria.SrNumbers.push(val);
            });
        }

        if (siteId != null && siteId != undefined && siteId != '' && siteId != '0') {
            $("#loader").show();
            $.ajax({
                url: '/Site/_EventDataLoggerGraph',
                type: 'Post',
                dataType: 'html',
                data: JSON.stringify(searchCriteria),
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#divSearchDataloggerEvent").empty().append(data);
                },
                error: function (response) {
                    CommonNotification("error", "Something went wrong!");
                }
            });
        }
    }

    function fnSearchPointEvent() {
        var siteId = '@Model.SiteId';
        var searchCriteria = {};
        searchCriteria.SearchDate = $('#txtPointEventSearchDate').val();
        searchCriteria.AssetId = '@Model.Id';
        searchCriteria.SiteId = siteId;


        if (siteId != null && siteId != undefined && siteId != '' && siteId != '0') {
            $("#loader").show();
            $.ajax({
                url: '/Site/_PointMachineEvent',
                type: 'Post',
                dataType: 'html',
                data: JSON.stringify(searchCriteria),
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#divSearchPointEvent").empty().append(data);
                },
                error: function (response) {
                    CommonNotification("error", "Something went wrong!");
                }
            });
        }
    }


</script>
