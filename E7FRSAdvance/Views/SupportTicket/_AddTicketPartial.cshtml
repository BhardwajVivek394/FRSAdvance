@model Domain.SupportTicket

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />
@Html.HiddenFor(m => m.Id, new { @id = "hdnId" })

<div class="modal fade" id="modal-add-ticket" role="dialog" aria-labelledby="modal-add-ticket" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Ticket</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Edit Ticket</span></h4>
                }
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="mb-3">
                                <label class="form-label">Title <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control", tabindex = 1 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Description <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control", tabindex = 2 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Request Date</label>
                                <div class="">
                                    @Html.TextBoxFor(m => m.RequestDate, new { @class = "form-control", tabindex = 3, disabled = "disabled" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Upload Image</label>
                                <div class="">

                                    <input type="file" id="UploadImg" name="UploadImg" accept="image/*" class="form-control" onchange="fnUploadImageFile(this)" multiple>
                                    @*@Html.EditorFor(m => Model., new { htmlAttributes = new { @class = "input-file form-control", type = "file", name = "file" } })*@
                                </div>
                            </div>
                            <div class="mb-3" id="divImage">
                                @if (Model.SupportTicketImages != null && Model.SupportTicketImages.Count > 0)
                                {
                                    foreach (var supportTicketImage in Model.SupportTicketImages)
                                    {
                                        <img height="100" width="100" src="@supportTicketImage.ImagePath" />
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()">Save</button>
            </div>
        </div>
    </div>
</div>

<script src="@Url.Content("~/Content/PageJS/SupportTicket/AddTicket.js")"></script>