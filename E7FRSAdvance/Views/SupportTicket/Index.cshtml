@model Domain.SupportTicketLister
@{
    ViewBag.Title = "SupportTicket";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Support Ticket</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">
        @using (Ajax.BeginForm("TicketList", "SupportTicket", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divTicketList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmGetTicketList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divTicketList">
                @Html.Action("TicketList")
            </div>
        }

        @using (Ajax.BeginForm("SaveTicket", "SupportTicket", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveTicket",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
        }, new { id = "frmSaveTicket" }))
        {
            <div id="divSaveTicket">
                @Html.Partial("_AddTicketPartial", new Domain.SupportTicket())
            </div>
        }
    </div>
</div>

