
<div class="container-fluid">
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <div class="row mt-3">
                        <div class="col-sm-2 mb15">
                            <label>Site</label>
                            @Html.DropDownList("ProbabilitySiteId", (IEnumerable<SelectListItem>)ViewBag.Sites, "Select Site", new { @class = "form-control", tabindex = 1 })
                        </div>
                        <div class="col-sm-2 mb-1">
                            <label>From Date</label>
                            <input type="text" class="datepicker-here form-control digits from-date" id="txtdpFromDate" data-language="en" />
                        </div>
                        <div class="col-sm-2 mb-1">
                            <label>To Date</label>
                            <input type="text" class="datepicker-here form-control digits to-date" id="txtdpToDate" data-language="en" />
                        </div>
                        <div class="col-sm-2 mb15">
                            <button type="button" class="btn btn-success" onclick="DownloadProbability()">Download</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('#txtdpFromDate').datepicker({
            dateFormat: 'mm/dd/yy',
            autoClose: true
        });

        $('#txtdpToDate').datepicker({
            dateFormat: 'mm/dd/yy',
            autoClose: true
        });
    });
    function DownloadProbability() {
        if ($('#ProbabilitySiteId').val() == null || $('#ProbabilitySiteId').val() == undefined || $('#ProbabilitySiteId').val() == "" || $('#ProbabilitySiteId').val() == "0") {
             CommonNotification("ERROR", "Please select site", "Error");
        }
        else if ($('#txtdpFromDate').val() == null || $('#txtdpFromDate').val() == undefined || $('#txtdpFromDate').val() == "") {
            CommonNotification("ERROR", "FromDate is required", "Error");
        }
        else if ($('#txtdpToDate').val() == null || $('#txtdpToDate').val() == undefined || $('#txtdpToDate').val() == "") {
            CommonNotification("ERROR", "ToDate is required", "Error");
        }
        else {
             window.location.href = "@Url.Action("DownloadProbability")?siteId=" + $('#ProbabilitySiteId').val() + "&startDate=" + $("#txtdpFromDate").val() + "&endDate=" + $("#txtdpToDate").val();
        }


    }
</script>