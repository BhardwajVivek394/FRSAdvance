<script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
<script src="~/assets/js/chart/echart/echarts.js"></script>
<script>

    $(window).on("load", function () {
        $('#txtSearchTimeStamp').datepicker({
            dateFormat: 'mm/dd/yy',
            autoClose: true
        });
    });

    $(document).ready(function () {
        fnGetRFStatus()
    });

    function fnChangeSiteKeepingType($this) {
        $('.tab-pane').removeClass('active');
        $('.tab-pane').removeClass('show');
        var value = $($this).val();
        if (value == "RFStatus") {
            $('#tabRFStatus').addClass("active");
            $('#tabRFStatus').addClass("show");
            fnGetRFStatus();
        } else if (value == "SiteStatus") {
            $('#tabSiteStatus').addClass("active");
            $('#tabSiteStatus').addClass("show");
            fnGetSiteStatus();
        }
        else if (value == "WatchList") {
            $('#tabWatchList').addClass("active");
            $('#tabWatchList').addClass("show");
            fnGetWatchList();
        }
        else if (value == "TrainRunningMoment") {
            $('#tabTrainRunningMoment').addClass("active");
            $('#tabTrainRunningMoment').addClass("show");
            fnGetTrainRunningMoment();
        }
        else if (value == "GluedLogData") {
            $('#tabGluedLogData').addClass("active");
            $('#tabGluedLogData').addClass("show");
            fnGetGluedLogData();
        }
        else if (value == "PointMachineSignature") {
            $('#tabPointMachineSignature').addClass("active");
            $('#tabPointMachineSignature').addClass("show");
            fnGetPointMachineSignature();
        }
        else if (value == "IndexLog") {
            $('#tabIndexAlertLog').addClass("active");
            $('#tabIndexAlertLog').addClass("show");
            fnGetIndexLog();
        }
        else if (value == "Signal") {
            $('#tabSignalMoment').addClass("active");
            $('#tabSignalMoment').addClass("show");
            fnGetSignal();
        }
        else if (value == "TPR") {
            $('#tabTPR').addClass("active");
            $('#tabTPR').addClass("show");
            fnGetTPR();
        }
        else if (value == "PointIndication") {
            $('#tabPointIndication').addClass("active");
            $('#tabPointIndication').addClass("show");
            fnGetPointIndication();
        } else if (value == "DownloadProbability") {
            $('#tabDownloadProbability').addClass("active");
            $('#tabDownloadProbability').addClass("show");
            fnGetDownloadProbability();
        }
    }

    function fnGetRFStatus() {
        $("#loader").show();
        $.ajax({
            url: '/SiteKeeping/_RFStatus',
            type: 'Post',
            contentType: 'application/json',
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divRFStatus").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

