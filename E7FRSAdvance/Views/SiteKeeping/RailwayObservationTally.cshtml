@model Domain.DivisionReportModelLister

@{
    ViewBag.Title = "RailwayObservationTally";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Railway Observation Tally</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">
        @using (Ajax.BeginForm("_RailwayObservationTally", "SiteKeeping", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divRailwayObservationTallyList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmGetRailwayObservationTallyList" }))
        {
            <div id="divRailwayObservationTallyList">
                @Html.Action("_RailwayObservationTally", "SiteKeeping", Model)
            </div>
        }
    </div>
</div>



