
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Job Card Master</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">

    @using (Ajax.BeginForm("_JobCardMasterList", "JobCardMaster", new AjaxOptions()
    {
        HttpMethod = "POST",
        UpdateTargetId = "divJobCardList",
        InsertionMode = InsertionMode.Replace,
        LoadingElementId = "loader"
    }, new { id = "frmJobCardList" }))
    {
        { HtmlHelper.ClientValidationEnabled = false; }
        <div id="divJobCardList">
            @Html.Action("_JobCardMasterList")
        </div>
    }
</div>

<div id="divSingleJobCard"></div>
<div id="divSiteKeepingOverallTargets"></div>
<div id="divJobCardStatus"></div>

