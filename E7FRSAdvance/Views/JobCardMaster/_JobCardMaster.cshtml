@model Domain.JobCardLister

@if (Model != null && Model.mJobCards != null && Model.mJobCards.Count > 0)
{
    foreach (var jobCard in Model.mJobCards)
    {
        <div id="divJobCardList">
            <div class="jobcard-viewable-@jobCard.Id">
                <div class="card">
                    <div class="card-header bg-secondary collapseView_@jobCard.Id" style="border-radius:15px;">
                        <div class="text-left">
                            <div class="row">
                                <div class="col-md-11 mb-3">
                                    <h4>Job Card</h4>
                                </div>
                                <div class="col-md-1 mb-3">
                                    @if (jobCard.mJobCardOverallTargets != null && jobCard.mJobCardOverallTargets.Count > 0 && jobCard.mJobCardOverallTargets.Count == jobCard.mJobCardOverallTargets.Where(x => x.IsResolved).Count())
                                    {
                                        if (jobCard.IsLock)
                                        {
                                            <img class="pull-right" src="@Url.Content("~/assets/images/JobCard/Lock_green.png")" />
                                        }
                                        else
                                        {
                                            if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode())
                                            {
                                                <img class="pull-right" src="@Url.Content("~/assets/images/JobCard/Unlock_Yellow.png")" />
                                            }
                                            else
                                            {
                                                <img class="pull-right" src="@Url.Content("~/assets/images/JobCard/Unlock_Yellow.png")" />
                                            }
                                        }

                                    }
                                    else
                                    {
                                        <img class="pull-right" src="@Url.Content("~/assets/images/JobCard/Unlock_blue.png")" />
                                    }
                                </div>
                            </div>
                        </div>
                        <div>

                            <div class="row">
                                <div class="col-md-6">
                                    <h4>@(jobCard.StationCode)@(jobCard.CreatedDate.ToString("ddMMyy"))</h4>
                                </div>
                                <div class="col-md-6">
                                    <h6 class="pull-right">Created on - @(jobCard.CreatedDate.ToString("dd/MM/yy"))</h6>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class=" cardView_@jobCard.Id">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-12">
                                    <h5 class="text-left">Dates</h5>
                                </div>
                                <div class="col-12 mt-3">
                                    @if (jobCard.mJobCardDescriptions != null && jobCard.mJobCardDescriptions.Count > 0)
                                    {
                                        var last = jobCard.mJobCardDescriptions.GroupBy(x => x.CreatedDate.Date).Select(x => x.Key).Max();
                                        foreach (var jd in jobCard.mJobCardDescriptions.GroupBy(x => x.CreatedDate.Date))
                                        {
                                            <a class="@(jd.Key.Equals(last)?"btn btn-info":"btn btn-primary") clsbtnSearchDates@(jobCard.Id)" onclick="fnGetJobCardDescription('@jobCard.Id','@jd.Key.ToShortDateString().Replace("/","-")')">@jd.Key.ToShortDateString()</a>
                                        }
                                    }
                                </div>
                                <hr class="mt-3" />
                                <div class="col-lg-6">
                                    <div class="row">
                                        <div class="col-12">
                                            <h5 class="text-left">
                                                Site Keeping Users
                                            </h5>
                                        </div>
                                        <div class="col-12 mt-3">
                                            @if (jobCard.mJobCardUsers != null && jobCard.mJobCardUsers.Count > 0)
                                            {
                                                foreach (var jd in jobCard.mJobCardUsers)
                                                {
                                                    <a class="btn btn-success m-1">@jd.Name</a>

                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="row">
                                        <div class="col-12">
                                            <h5 class="text-left">
                                                Maintainer Users
                                            </h5>
                                        </div>
                                        <div class="col-12 mt-3">
                                            @if (jobCard.mJobCardMaintainerUsers != null && jobCard.mJobCardMaintainerUsers.Count > 0)
                                            {
                                                foreach (var jd in jobCard.mJobCardMaintainerUsers)
                                                {
                                                    <a class="btn btn-success m-1">@jd.Name</a>

                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                                <hr class="mt-3" />
                                <div class="col-lg-12">
                                    <div class="row">
                                        <div class="col-12">
                                            <h5 class="pull-left">
                                                Overall Targets

                                                @if (jobCard.mJobCardOverallTargets != null && jobCard.mJobCardOverallTargets.Count > 0)
                                                {
                                                    <a class="m-l-10" onclick="fnSiteKeepingOverallTargets('@jobCard.Id')"><i class="fa fa-eye f-20"></i></a>

                                                }
                                            </h5>
                                            <h5 class="pull-right">
                                                @jobCard.mJobCardOverallTargets.Where(x => x.IsResolved).Count()/@jobCard.mJobCardOverallTargets.Count()

                                            </h5>
                                        </div>
                                    </div>
                                </div>
                                <hr class="mt-3" />
                                <div class="col-lg-12">
                                    <div class="row">
                                        <div class="col-12">
                                            <div class="row">
                                                <div class="col-lg-6 mb-4">
                                                    <div class="row">
                                                        <div class="col-12">
                                                            <h5 class="text-left">
                                                                Daily Work
                                                            </h5>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-lg-6 mb-4">
                                                    <div class="row">
                                                        <div class="col-12">
                                                            <h5 class="text-left">
                                                                Remark
                                                            </h5>
                                                        </div>
                                                    </div>
                                                </div>
                                                @if (jobCard.mJobCardDescriptions != null && jobCard.mJobCardDescriptions.Count > 0)
                                                {
                                                    <div class="viewJobCardDescription_@jobCard.Id">
                                                        @{var maxDate = jobCard.mJobCardDescriptions.Max(x => x.CreatedDate);}
                                                        @foreach (var jobCardDescription in jobCard.mJobCardDescriptions.Where(x => x.CreatedDate.Date == maxDate.Date))
                                                        {
                                                            <div class="col-12">
                                                                <div class="card jobCardDescription">
                                                                    <div class="card-body">
                                                                        <div class="row">
                                                                            <div class="col-md-5">
                                                                                <span class="spnDailywork_@jobCard.Id">
                                                                                    @jobCardDescription.DailyWork
                                                                                </span>
                                                                            </div>
                                                                            <div class="col-md-1">
                                                                                <div class="vertical-line"></div>
                                                                            </div>
                                                                            @if (string.IsNullOrEmpty(jobCardDescription.Remark) && maxDate.Date == DateTime.Now.Date)
                                                                            {
                                                                                <div class="col-md-6">
                                                                                    <h5>

                                                                                        <a href="javascript:void(0)" title="Update Remark" onclick="fnAddRemark(@jobCardDescription.Id)">
                                                                                            Update Remark
                                                                                        </a>
                                                                                    </h5>
                                                                                </div>


                                                                            }
                                                                            else
                                                                            {
                                                                                <div class="col-md-6">
                                                                                    <span class="spnRemark_@jobCard.Id">
                                                                                        @jobCardDescription.Remark
                                                                                    </span>
                                                                                </div>

                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}



<script>
    @*$(document).ready(function () {
        $(".collapseView_@Model.Id").click(function (e) {

            if (e.target.tagName === 'A') return;
            if (e.target.tagName === 'IMG') return;

           $(".cardView_@jobCard.Id").collapse('toggle');
        });

    });*@

    function fnGetJobCardDescription(jobCardId, date) {
        if (date == null || date == undefined || date == '') {
            $('.clsbtnSearchDates' + jobCardId).each(function (v, value) {
                if ($(this).hasClass('btn-info')) {
                    date = $(this).text().replaceAll("/", "-");
                }
            });
        }
        $("#loader").show();
        $.ajax({
            url: '/JobCard/GetJobCardDescription',
            type: 'Post',
            data: '{jobCardId:' + jobCardId + ',date:"' + date + '"}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                if (data != null) {
                    $('.viewJobCardDescription_' + jobCardId).empty();

                    $.each(data, function (index, item) {
                        var remarkHtml = item.Remark ? `
                     <span class="spnRemark_${item.JobCardId}">
                       ${item.Remark}
                     </span>` : '';

                        var cardHtml = `<div class="col-12">
                           <div class="card jobCardDescription">
                               <div class="card-body">
                                   <div class="row">
                                       <div class="col-md-5">
                                           <span class="spnDailywork_${jobCardId}">
                                             ${item.DailyWork}
                                           </span>
                                       </div>
                                       <div class="col-md-1">
                                           <div class="vertical-line"></div>
                                       </div>
                                       <div class="col-md-6">
                                           <span class="spnRemark_${jobCardId}">
                                              ${remarkHtml}
                                           </span>
                                       </div>
                                   </div>
                               </div>
                           </div>
                       </div>`;

                        $('.viewJobCardDescription_' + jobCardId).append(cardHtml);
                        // $('.spnRemark_' + jobCardId).text(item.Remark);
                        // $('.spnDailywork_' + jobCardId).text(item.DailyWork);
                    });

                    $('.clsbtnSearchDates' + jobCardId).each(function (v, value) {
                        var txtVal = $(this).text();
                        if (txtVal == date.replaceAll("-", "/")) {
                            if ($(this).hasClass("btn-primary")) {
                                $(this).removeClass("btn-primary").addClass("btn-info");
                            }
                        } else {
                            $(this).removeClass("btn-info").addClass("btn-primary");
                        }
                    });
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnSiteKeepingOverallTargets(jobCardId) {
        $("#loader").show();

        $.ajax({
            url: '/JobCardMaster/_SiteKeepingOverallTargets',
            type: 'Post',
            data: '{jobCardId:' + jobCardId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divSiteKeepingOverallTargets").empty().append(data);
                $("#modal-siteKeeping-overall-targets").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }

</script>
