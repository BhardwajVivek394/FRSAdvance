
@model List<Domain.JobCardOverallTarget>

@{
    int counter = 1;
}
<div class="modal fade" id="modal-siteKeeping-overall-targets" role="dialog" aria-labelledby="modal-siteKeeping-overall-targets" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span>Overall Targets</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="form-horizontal">
                    <div class="row">
                        @if (Model != null && Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.LinkIssue).Count() > 0)
                        {
                            <div class="col-sm-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Link Issue</h5>
                                    </div>
                                    <div class="card-body">
                                        <table class="table">
                                            <thead class="bg-primary">
                                                <tr>
                                                    <th>Sr no.</th>
                                                    <th>DeviceName</th>
                                                    <th>A10Id</th>
                                                    <th>LastAccesstime</th>
                                                    <th>TimeStamp</th>
                                                    <th></th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody class="tbodyOverallSitekippingRFStatus@(ViewBag.JobCardId)">
                                                @foreach (var item in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.LinkIssue).ToList())
                                                {
                                                    <tr class="table-light">
                                                        <td>@counter</td>
                                                        <td>@item.Cluster</td>
                                                        <td>@item.ADCId</td>
                                                        <td>@item.LastAccesstime</td>
                                                        <td>
                                                            @*@item.TimeStamp.ToString()*@
                                                        </td>
                                                        <td>
                                                            @if (item.IsResolved)
                                                            {
                                                                @*<input type="checkbox" class="clsoveralltargetsUpdateStatus" data-id="@item.Id" checked disabled />*@
                                                                <i class="fa fa-check text-success f-24" aria-hidden="true"></i>
                                                            }
                                                           
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(item.Remark))
                                                            {
                                                                @*<span>@item.Remark</span>*@

                                                                <a href="javascript:void(0)" data-bs-toggle="popover" title="Remark" data-bs-content="@item.Remark"><i class="fa fa-info-circle" aria-hidden="true"></i></a>
                                                            }
                                                        </td>
                                                    </tr>
                                                    counter++;
                                                }
                                            </tbody>
                                        </table>

                                    </div>
                                </div>

                            </div>
                        }


                        @if (Model != null && Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.WatchLists).Count() > 0)
                        {
                            <div class="col-sm-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Watchlist</h5>
                                    </div>
                                    <div class="card-body">
                                        <table class="table">
                                            <thead class="bg-primary">
                                                <tr>
                                                    <th>Sr no.</th>
                                                    <th>AssetType</th>
                                                    <th>Asset</th>
                                                    <th>Attribute</th>
                                                    <th>Cluster</th>
                                                    <th>Card</th>
                                                    <th>ADC</th>
                                                    <th>Pin</th>
                                                    <th>Value</th>
                                                    <th>Date</th>
                                                    <th></th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody class="tbodyOverallSitekippingWatchLists@(ViewBag.JobCardId)">
                                                @foreach (var item in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.WatchLists).ToList())
                                                {
                                                    <tr class="table-light" data-id="@item.Id">
                                                        <td>@counter</td>
                                                        <td>@item.AssetTypeName</td>
                                                        <td>@item.AssetName</td>
                                                        <td>@item.AttributeName</td>
                                                        <td>@item.Cluster</td>
                                                        <td>@item.Card</td>
                                                        <td>@item.ADCId</td>
                                                        <td>@item.Pin</td>
                                                        <td>@item.Value</td>
                                                        <td>@item.TimeStamp</td>
                                                        <td>
                                                            @if (item.IsResolved)
                                                            {
                                                                @*<input type="checkbox" class="clsoveralltargetsUpdateStatus" data-id="@item.Id" checked disabled />*@
                                                                <i class="fa fa-check text-success f-24" aria-hidden="true"></i>
                                                            }
                                                          
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(item.Remark))
                                                            {
                                                                <a href="javascript:void(0)" data-bs-toggle="popover" title="Remark" data-bs-content="@item.Remark"><i class="fa fa-info-circle" aria-hidden="true"></i></a>
                                                            }
                                                        </td>
                                                    </tr>
                                                    counter++;
                                                }
                                            </tbody>
                                        </table>

                                    </div>
                                </div>

                            </div>
                        }


                        @if (Model != null && Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.Last30DayAlert).Count() > 0)
                        {
                            <div class="col-sm-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Alert</h5>
                                    </div>
                                    <div class="card-body">
                                        <table class="table">
                                            <thead class="bg-primary">
                                                <tr>
                                                    <th>Sr no.</th>
                                                    <th>Asset Type</th>
                                                    <th>Asset</th>
                                                    <th>Message</th>
                                                    <th>Date</th>
                                                    <th></th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody class="tbodyLast30SitekippingAlert@(ViewBag.JobCardId)">
                                                @foreach (var item in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.Last30DayAlert).ToList())
                                                {
                                                    <tr class="table-light" data-id="@item.Id">
                                                        <td>@counter</td>
                                                        <td>@item.AssetTypeName</td>
                                                        <td>@item.AssetName</td>
                                                        <td>@item.Message</td>
                                                        <td>@item.TimeStamp</td>
                                                        <td>
                                                            @if (item.IsResolved)
                                                            {
                                                                @*<input type="checkbox" class="clsoveralltargetsUpdateStatus" data-id="@item.Id" checked disabled />*@
                                                                <i class="fa fa-check text-success f-24" aria-hidden="true"></i>
                                                            }
                                                          
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(item.Remark))
                                                            {
                                                                <a href="javascript:void(0)" data-bs-toggle="popover" title="Remark" data-bs-content="@item.Remark"><i class="fa fa-info-circle" aria-hidden="true"></i></a>
                                                            }
                                                        </td>
                                                    </tr>
                                                    counter++;
                                                }
                                            </tbody>
                                        </table>

                                    </div>
                                </div>

                            </div>
                        }

                        @if (Model != null && Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.Manually).Count() > 0)
                        {
                            <div class="col-sm-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Manually</h5>
                                    </div>
                                    <div class="card-body">
                                        <table class="table">
                                            <thead class="bg-primary">
                                                <tr>
                                                    <th>Sr no.</th>
                                                    <th>Issue Type</th>
                                                    <th>Asset Type</th>
                                                    <th>Asset</th>
                                                    <th>Attribute</th>
                                                    <th>Message</th>
                                                    <th>TimeStamp</th>
                                                    <th></th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody class="tbodyManuallySitekipping@(ViewBag.JobCardId)">
                                                @foreach (var item in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.Manually).ToList())
                                                {
                                                    <tr class="table-light" data-id="@item.Id">
                                                        <td>@counter</td>
                                                        <td>@item.IssueType</td>
                                                        <td>@item.AssetTypeName</td>
                                                        <td>@item.AssetName</td>
                                                        <td>@item.AttributeName</td>
                                                        <td>@item.Message</td>
                                                        <td>@item.TimeStamp.ToString()</td>
                                                        <td>
                                                            @if (item.IsResolved)
                                                            {
                                                                @*<input type="checkbox" class="clsoveralltargetsUpdateStatus" data-id="@item.Id" checked disabled />*@
                                                                <i class="fa fa-check text-success f-24" aria-hidden="true"></i>
                                                            }
                                                           
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(item.Remark))
                                                            {
                                                                <a href="javascript:void(0)" data-bs-toggle="popover" title="Remark" data-bs-content="@item.Remark"><i class="fa fa-info-circle" aria-hidden="true"></i></a>
                                                            }
                                                        </td>
                                                    </tr>
                                                    counter++;
                                                }
                                            </tbody>
                                        </table>

                                    </div>
                                </div>

                            </div>
                        }

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                @*<button type="button" class="btn btn-primary ls-1-2">Save</button>*@        
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('[data-bs-toggle="popover"]').popover();
    });
</script>