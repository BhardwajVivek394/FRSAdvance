@model Domain.SiteLister
@{
    ViewBag.Title = "Maintenance Tabulation";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<style>
    .modal-body {
        height: 60vh;
        overflow-y: auto;
    }

    .table > :not(:last-child) > :last-child > * {
        border-bottom-color: #87c7d9 !important;
    }

    .MainTh {
        background-color: #7fcde22e !important;
        border-bottom-color: #87c9db !important;
    }

    .SubTh {
        background-color: #f4f6fc !important;
        border-bottom-color: #87c9db !important;
    }
</style>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Maintenace Tabulation</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12 col-md-12 col-lg-12 people-list">
        <div class="card-body " style="padding:15px;">

            <div class="table-responsive">
                <table class="table">
                    @if (ViewBag.Zones != null && ViewBag.Divisions != null)
                    {
                        foreach (var zone in ViewBag.Zones.Items as List<Domain.Zone>)
                        {
                            if (zone.Id != 0)
                            {
                                var devision = ViewBag.Divisions.Items as List<Domain.Division>;
                                <thead>
                                    <tr class="MainTh">
                                        <th>
                                            <span>
                                                @zone.Name
                                            </span>
                                            <span class="pull-right">
                                                <a href="#"><i class="fa fa-angle-up fa-3x" onclick="fnShowMaintenaceLogDivision('@zone.Id', this); return false;"></i></a>
                                            </span>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            @foreach (var division in devision.Where(x => x.ZoneId == zone.Id))
                                            {
                                                <table class="table maintenaceLogDivisionByZone_@zone.Id" style="display:none">
                                                    <thead>
                                                        <tr class="SubTh">
                                                            <th>
                                                                <span>
                                                                    @division.Name
                                                                </span>
                                                                <span class="pull-right">
                                                                    <a href="#"><i style="color: #a189f2;" class="fa fa-angle-up fa-3x" onclick="fnShowMaintenaceLogSite('@division.Id', this); return false;"></i></a>
                                                                </span>
                                                            </th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>
                                                                <table class="table maintenaceLogBySite_@division.Id" style="display:none">
                                                                    <thead class="bg-primary">
                                                                        <tr>
                                                                            <th>Site Name</th>
                                                                            @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                                                                            {
                                                                                <th>Status</th>
                                                                                <th class="text-center">RF</th>
                                                                                <th class="text-center">Watch List</th>
                                                                                <th class="text-center">Point Machine Signature</th>
                                                                            }
                                                                            <th class="text-center">Glued</th>
                                                                            <th class="text-center">Index Log</th>
                                                                            <th class="text-center">Probability</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @if (Model.mSites != null && Model.mSites.Count > 0)
                                                                        {
                                                                            foreach (var item in Model.mSites.Where(x => x.ZoneId == zone.Id && x.DivisionId == division.Id))
                                                                            {
                                                                                <tr class="table-light sites" data-Id="@item.Id">
                                                                                    <td>
                                                                                        <div class="row">
                                                                                            <div class="col-12">
                                                                                                @item.Name
                                                                                            </div>

                                                                                        </div>
                                                                                    </td>
                                                                                    @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                                                                                    {
                                                                                        <td class="text-center">
                                                                                            <div class="col-4" id="siteMQQTChannelDown_@item.Id"></div>
                                                                                        </td>
                                                                                        <td class="text-center">
                                                                                            <a href="javascript:void(0);" class="clsRFCount f-18" id="RFCount@(item.Id)" onclick="fnShowRF('@item.Id')">
                                                                                                <img src="@Url.Content("~/assets/images/loader.gif")" height="30" width="30" />
                                                                                            </a>
                                                                                        </td>
                                                                                        <td class="text-center">
                                                                                            <a href="javascript:void(0);" class="clsWatchListCount f-18" id="WatchListCount@(item.Id)" onclick="fnShowWatchlist('@item.Id')">
                                                                                                <img src="@Url.Content("~/assets/images/loader.gif")" height="30" width="30" />
                                                                                            </a>
                                                                                        </td>
                                                                                        <td class="text-center">
                                                                                            <a href="javascript:void(0);" class="clsPointMachineSignatureCount f-18" id="PointMachineSignatureCount@(item.Id)" onclick="fnShowPointMachineSignature('@item.Id')">
                                                                                                <img src="@Url.Content("~/assets/images/loader.gif")" height="30" width="30" />
                                                                                            </a>
                                                                                        </td>
                                                                                    }

                                                                                    <td class="text-center">
                                                                                        <a href="javascript:void(0);" class="clsGluedCount f-18" id="GluedCount@(item.Id)" onclick="fnShowGlued('@item.Id')">
                                                                                            <img src="@Url.Content("~/assets/images/loader.gif")" height="30" width="30" />
                                                                                        </a>
                                                                                    </td>


                                                                                    <td class="text-center">
                                                                                        <a href="javascript:void(0);" class="clsIndexLogCount f-18" id="IndexLogCount@(item.Id)" onclick="fnShowIndexlog('@item.Id')">
                                                                                            <img src="@Url.Content("~/assets/images/loader.gif")" height="30" width="30" />
                                                                                        </a>
                                                                                    </td>
                                                                                    <td>
                                                                                        @*<a href="javascript.void(0);" id="RFCount@(item.Id)">0</a>*@
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        }
                                                                        else
                                                                        {
                                                                            <tr>
                                                                                <td colspan="8" class="text-center">
                                                                                    No record found
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            }

                                        </td>
                                    </tr>
                                </tbody>

                            }

                        }

                    }
                </table>
            </div>
        </div>

    </div>
    <!-- panel -->

</div>



<!--RF model-->
<div class="modal fade" id="modal-RF" role="dialog" aria-labelledby="modal-RF" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader">  RF</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>DeviceName</th>
                            <th>LastAccesstime</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyRF">
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
            </div>
        </div>
    </div>
</div>

<!--WatchList model-->
<div class="modal fade" id="modal-WatchList" role="dialog" aria-labelledby="modal-WatchList" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader">Watch List</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Asset Name</th>
                            <th>Count</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyWatchList">
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
            </div>
        </div>
    </div>
</div>

<!--Glued-->
<div class="modal fade" id="modal-Glued" role="dialog" aria-labelledby="modal-Glued" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader"> Glued</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Asset Name</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyGlued">
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
            </div>
        </div>
    </div>
</div>

<!--PointMachineSignature-->
<div class="modal fade" id="modal-PointMachineSignature" role="dialog" aria-labelledby="modal-Glued" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader"> Point Machine Signature</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Asset Name</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyPointMachineSignature">
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
            </div>
        </div>
    </div>
</div>

<!--Index Log-->
<div class="modal fade" id="modal-IndexLog" role="dialog" aria-labelledby="modal-IndexLog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader"> Index Log</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Asset Name</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyIndexLog">
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
            </div>
        </div>
    </div>
</div>

<script>
    var siteIds = [];
    $(document).ready(function () {
        $('.sites').each(function () {
            siteIds.push(parseInt($(this).data('id')));
        });

        fnGetRFStatus();
        fnGetWatchList();
        fnGetGluedLogData();
        fnGetIndexLog();
        fnGetPointMachineSignature();
        fnAllSiteCheckChannelDown();

        //setInterval(function () {
        //    fnAllSiteCheckChannelDown();

        //}, 30000);

        $('#modal-RF').on('hidden.bs.modal', function () {
            $('#tbodyRF tr').each(function () {
                if (!$(this).hasClass('d-none')) {
                    $(this).addClass('d-none');
                }
            });
        });

        $('#modal-WatchList').on('hidden.bs.modal', function () {
            $('.trWatchList').each(function () {
                $(this).hide();
            });

            $('.clsbtnshowSubWatchList').each(function () {
                var assetId = $(this).attr('data-assetId');
                if (!$(this).hasClass("fa-plus")) {
                    $(this).removeClass("fa-minus").addClass("fa-plus");
                    $('.trSubWatchList' + assetId).hide();
                }
            });
        });

        $('#modal-Glued').on('hidden.bs.modal', function () {
            $('#tbodyGlued tr').each(function () {
                if (!$(this).hasClass('d-none')) {
                    $(this).addClass('d-none');
                }
            });
        });

        $('#modal-PointMachineSignature').on('hidden.bs.modal', function () {
            $('#tbodyPointMachineSignature tr').each(function () {
                if (!$(this).hasClass('d-none')) {
                    $(this).addClass('d-none');
                }
            });
        });

        $('#modal-IndexLog').on('hidden.bs.modal', function () {
            $('#tbodyIndexLog tr').each(function () {
                if (!$(this).hasClass('d-none')) {
                    $(this).addClass('d-none');
                }
            });
        });

    });

    function fnShowMaintenaceLogDivision(zoneId, $this) {
        if (zoneId != null && zoneId != '' && zoneId != undefined) {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.maintenaceLogDivisionByZone_' + zoneId).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.maintenaceLogDivisionByZone_' + zoneId).hide();
            }
        }
    }

    function fnShowMaintenaceLogSite(divisionId, $this) {
        if (divisionId != null && divisionId != '' && divisionId != undefined) {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.maintenaceLogBySite_' + divisionId).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.maintenaceLogBySite_' + divisionId).hide();
            }
        }
    }

    function fnShowRF(siteId) {
        if (parseInt($('#RFCount' + siteId).text()) > 0) {
            $('.trRF' + siteId).removeClass('d-none');
            $('#modal-RF').modal("show");
        }
    }

    function fnShowWatchlist(siteId) {
        if (parseInt($('#WatchListCount' + siteId).text()) > 0) {
            $('.trWatchList' + siteId).show();
            $('#modal-WatchList').modal("show");
        }
    }

    function fnShowGlued(siteId) {
        if (parseInt($('#GluedCount' + siteId).text()) > 0) {
            $('.trGlued' + siteId).removeClass('d-none');
            $('#modal-Glued').modal("show");
        }
    }

    function fnShowPointMachineSignature(siteId) {
        if (parseInt($('#PointMachineSignatureCount' + siteId).text()) > 0) {
            $('.trPointMachineSignature' + siteId).removeClass('d-none');
            $('#modal-PointMachineSignature').modal("show");
        }
    }

    function fnShowIndexlog(siteId) {
        if (parseInt($('#IndexLogCount' + siteId).text()) > 0) {
            $('.trIndexLog' + siteId).removeClass('d-none');
            $('#modal-IndexLog').modal("show");
        }
    }

    function GetShowSubWatchList(assetId, $this) {
        if (assetId != null && assetId != undefined && assetId != '') {
            if ($($this).hasClass("fa-plus")) {
                $($this).removeClass("fa-plus").addClass("fa-minus");
                $('.trSubWatchList' + assetId).show();
            }
            else {
                $($this).removeClass("fa-minus").addClass("fa-plus");
                $('.trSubWatchList' + assetId).hide();
            }
        }
    }

    function fnGetRFStatus() {
        $.ajax({
            url: '/MaintenanceTabulation/_RFStatus',
            type: 'Post',
            contentType: 'application/json',
            success: function (data) {
                $('.clsRFCount').text('0');
                if (data != null && data != undefined && data.mRFStatus != null && data.mRFStatus != undefined && data.mRFStatus.length > 0) {
                    var tbody = '';
                    $(data.mRFStatus).each(function (val, rfstatus) {
                        var count = 0;
                        if ($('#RFCount' + rfstatus.SiteId).text() != null && $('#RFCount' + rfstatus.SiteId).text() != undefined && $('#RFCount' + rfstatus.SiteId).text() != '') {
                            count = parseInt($('#RFCount' + rfstatus.SiteId).text());
                            count++;
                        }
                        $('#RFCount' + rfstatus.SiteId).text(count);

                        //Bind RF model table
                        tbody += '<tr class="trRF' + rfstatus.SiteId + ' d-none">';
                        tbody += '<td>' + rfstatus.DeviceName + '</td>';
                        tbody += '<td>' + rfstatus.LastAccesstime + '</td>';
                        tbody += '</tr>';
                    });
                    $('#tbodyRF').empty().append(tbody);

                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnGetWatchList() {

        $.ajax({
            url: '/MaintenanceTabulation/_WatchList',
            type: 'Post',
            contentType: 'application/json',
            success: function (data) {
                $('.clsWatchListCount').text('0');
                if (data != null && data != undefined && data.WatchLists != null && data.WatchLists != undefined && data.WatchLists.length > 0) {
                    var tbody = '';
                    var assetIds = [];

                    $(data.WatchLists).each(function (val, watchList) {
                        var count = 0;
                        if ($('#WatchListCount' + watchList.SiteId).text() != null && $('#WatchListCount' + watchList.SiteId).text() != undefined && $('#WatchListCount' + watchList.SiteId).text() != '') {
                            count = parseInt($('#WatchListCount' + watchList.SiteId).text());
                            count++;
                        }
                        $('#WatchListCount' + watchList.SiteId).text(count);

                        //Bind WatchList model table
                        if ($.inArray(watchList.AssetId, assetIds) !== -1) {
                        } else {
                            var length = data.WatchLists.filter(d => d.AssetId == watchList.AssetId).length;
                            tbody += '<tr class="trWatchList trWatchList' + watchList.SiteId + '" style="display:none">';
                            tbody += '<td><a href="javascript:void(0)" data-bs-original-title="" title=""><i class="fa fa-plus clsbtnshowSubWatchList"  onclick="GetShowSubWatchList(' + watchList.AssetId + ',this)" data-assetId=' + watchList.AssetId +'></i></a></td>';
                            tbody += '<td>' + watchList.AssetName +'</td>';
                            tbody += '<td>' + length + '</td>';
                            tbody += '</tr>';
                            tbody += '<tr class="trSubWatchList' + watchList.AssetId + '" style="display:none">';
                            tbody += '<td colspan="4">';
                            tbody += '<table class="table">';
                            $(data.WatchLists).each(function (val, subWatchList) {
                                if (watchList.AssetId == subWatchList.AssetId) {
                                    var d = parseDate(subWatchList.TimeStamp);
                                    var date = d.getDate() + "/" + d.getMonth() + "/" + d.getFullYear() + ' ' + d.getHours() + ':' + d.getMinutes() + ':' + d.getSeconds();

                                    tbody += '<tr>';
                                    tbody += '<td>' + subWatchList.AssetTypeName + '</td>';
                                    tbody += '<td>' + subWatchList.AttributeName + '</td>';
                                    tbody += '<td>' + date + '</td>';
                                    tbody += '</tr>';
                                }
                            });
                            tbody += '</table>';
                            tbody += '</td>';
                            tbody += '</tr>';
                            assetIds.push(watchList.AssetId);
                        }

                    });
                    $('#tbodyWatchList').empty().append(tbody);
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnGetGluedLogData() {

        $.ajax({
            url: '/MaintenanceTabulation/_GluedLogDataLister',
            type: 'Post',
            contentType: 'application/json',
            success: function (data) {
                $('.clsGluedCount').text('0');
                if (data != null && data != undefined && data.Assets != null && data.Assets != undefined && data.Assets.length > 0) {
                    var tbody = '';
                    $(data.Assets).each(function (val, gluedAsset) {
                        var count = 0;
                        if ($('#GluedCount' + gluedAsset.SiteId).text() != null && $('#GluedCount' + gluedAsset.SiteId).text() != undefined && $('#GluedCount' + gluedAsset.SiteId).text() != '') {
                            count = parseInt($('#GluedCount' + gluedAsset.SiteId).text());
                            count++;
                        }
                        $('#GluedCount' + gluedAsset.SiteId).text(count);

                        //Bind Glued model table
                        tbody += '<tr class="trGlued' + gluedAsset.SiteId + ' d-none">';
                        tbody += '<td>' + gluedAsset.Name + '</td>';
                        tbody += '</tr>';
                    });
                    $('#tbodyGlued').empty().append(tbody);
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnGetPointMachineSignature() {
        $.ajax({
            url: '/MaintenanceTabulation/_PointMachineSignatureLister',
            type: 'Post',
            contentType: 'application/json',
            async: false,
            success: function (data) {
                $('.clsPointMachineSignatureCount').text('0');
                if (data != null && data != undefined && data.Assets != null && data.Assets != undefined && data.Assets.length > 0) {
                    var tbody = '';
                    $(data.Assets).each(function (val, pmAsset) {
                        var count = 0;
                        if ($('#PointMachineSignatureCount' + pmAsset.SiteId).text() != null && $('#PointMachineSignatureCount' + pmAsset.SiteId).text() != undefined && $('#PointMachineSignatureCount' + pmAsset.SiteId).text() != '') {
                            count = parseInt($('#PointMachineSignatureCount' + pmAsset.SiteId).text());
                            count++;
                        }
                        $('#PointMachineSignatureCount' + pmAsset.SiteId).text(count);

                        //Bind RF model table
                        tbody += '<tr class="trPointMachineSignature' + pmAsset.SiteId + ' d-none">';
                        tbody += '<td>' + pmAsset.Name + '</td>';
                        tbody += '</tr>';
                    });
                    $('#tbodyPointMachineSignature').empty().append(tbody);
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });

    }

    function fnGetIndexLog() {
        $.ajax({
            url: '/MaintenanceTabulation/_IndexAlertLogLister',
            type: 'Post',
            contentType: 'application/json',
            success: function (data) {
                $('.clsIndexLogCount').text('0');
                if (data != null && data != undefined && data.IndexAlertLogs != null && data.IndexAlertLogs != undefined && data.IndexAlertLogs.length > 0) {
                    var tbody = '';
                    $(data.IndexAlertLogs).each(function (val, indexAlertLog) {
                        var count = 0;
                        if ($('#IndexLogCount' + indexAlertLog.SiteId).text() != null && $('#IndexLogCount' + indexAlertLog.SiteId).text() != undefined && $('#IndexLogCount' + indexAlertLog.SiteId).text() != '') {
                            count = parseInt($('#IndexLogCount' + indexAlertLog.SiteId).text());
                            count++;
                        }
                        $('#IndexLogCount' + indexAlertLog.SiteId).text(count);

                        //Bind IndexLog model table
                        tbody += '<tr class="trIndexLog' + indexAlertLog.SiteId + ' d-none">'
                        tbody += '<td>' + indexAlertLog.AssetName + '</td>';
                        tbody += '<td>' + indexAlertLog.Remarks + '</td>';
                        tbody += '</tr>'
                    });
                    $('#tbodyIndexLog').empty().append(tbody);
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnTrainRunningMomentList() {
        var mTrainRunningMomentLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = '@ViewBag.SiteId';
        mSearchCriteria.TimeStamp = $('#txtSearchTimeStamp').val();
        mTrainRunningMomentLister.SearchCriteria = mSearchCriteria;
        $.ajax({
            url: '/UserSite/_TrainRunningMoment',
            type: 'Post',
            dataType: 'html',
            data: JSON.stringify(mTrainRunningMomentLister),
            contentType: 'application/json',
            success: function (data) {
                $("#divTrainRunningMomentData").empty().append(data);
            },
            error: function (response) {
                CommonNotification("error", "Something went wrong!");
            }
        });
    }

    function fnAllSiteCheckChannelDown() {
        if (siteIds != null && siteIds != undefined && siteIds.length > 0) {

            $.ajax({
                url: '/Site/CheckChannelIsDownBySiteId',
                type: 'Post',
                data: JSON.stringify(siteIds),
                contentType: 'application/json',
                success: function (data) {
                    if (data != "" && data != null && data.length > 0) {
                        $.each(data, function (id, site) {
                            if (site.ChannelConfigs != null && site.ChannelConfigs.length > 0) {
                                var html = "";
                                var htmlChannel = "";
                                var count = 0;
                                var siteDown = true;
                                $.each(site.ChannelConfigs, function (i, ch) {
                                    if ($("#ch" + site.Id).attr("data-http") == "True") {
                                        html += "<p>N/A</p>"
                                        htmlChannel += "<p>" + ch.Channel + " - " + ch.MacId + "</p>";
                                    }
                                    else {
                                        if (ch.IsDown == false) {
                                            htmlChannel += '<p>' + ch.Channel + ' - ' + ch.MacId + '</p> <p><span class="span badge rounded-pill pill-badge-success">' + ch.TimeStamp + '</span></p>';
                                            //html += '<p><span class="span badge rounded-pill pill-badge-success">' + ch.TimeStamp + '</span></p>';
                                        }
                                        else {
                                            siteDown = false;
                                            count = count + 1;
                                            htmlChannel += '<p>' + ch.Channel + ' - ' + ch.MacId + '</p> <p><span class="span badge rounded-pill pill-badge-secondary">Down</span> </p>';
                                            //  html += '<p><span class="span badge rounded-pill pill-badge-secondary">Down</span> </p>';
                                        }
                                    }


                                });
                                if (siteDown) {
                                    $('#siteMQQTChannelDown_' + site.Id).empty();
                                    $('#siteMQQTChannelDown_' + site.Id).append("<h5><i class='fa fa-check-circle text-success' aria-hidden='true'></i></h5>");
                                } else {
                                    $('#siteMQQTChannelDown_' + site.Id).empty();
                                    $('#siteMQQTChannelDown_' + site.Id).append("<h5><i class='fa fa-exclamation-triangle text-danger' aria-hidden='true' data-bs-trigger='hover' data-container='body' data-bs-toggle='popover' data-bs-html='true' data-bs-placement='top' data-bs-original-title='Rf Down' data-bs-content='" + htmlChannel + "' ></i></h5>");
                                }

                            }
                        });
                        $('[data-bs-toggle="popover"]').popover();
                    }
                },
                error: function (response) {
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function parseDate(date) {
        return new Date(parseInt(/-?\d+/.exec(date)[0]))
    }
</script>