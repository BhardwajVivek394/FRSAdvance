
@{
    ViewBag.Title = "Visualization";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Visualization</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-2 mb-1">
                                <label>Type</label>
                                @Html.DropDownList("TypeId", new List<SelectListItem>
    {
    new SelectListItem{ Text="POINT MACHINE", Value = "1" },
    }, new { @class = "form-control", tabindex = 2 })
                            </div>

                            <div class="col-sm-4 mb-1">
                                <label>Upload</label>
                                <input type="file"  accept=".csv" class="form-control" />
                            </div>
                        </div>



                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12">
                        <div id="divPointMachine">
                        </div>
                    </div>
                </div>
            </div>

        </div>


    </div>

</div>

<script>

    function fnUploadExportAutINI($this) {
        $("#loader").show();
        var fileUpload = $($this).get(0);
        var files = fileUpload.files;
        var fileData = new FormData();
        fileData.append(files[0].name, files[0]);

        $.ajax({
            url: "/AISection/UploadAutINI",
            type: "POST",
            contentType: false,
            processData: false,
            data: fileData,
            async: true,
            success: function (data) {
                $("#loader").hide();
                if (data != null && data != undefined && data != '') {
                    $("#hdnAutcalFileName").val(data);
                }
            },
            error: function (xhr, error, status) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "Error");
            }
        });
    }
</script>