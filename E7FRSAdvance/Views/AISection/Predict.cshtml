
@{
    ViewBag.Title = "Predict";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
<script src="~/assets/js/chart/echart/echarts.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Predict</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-2 mb-1">
                                <label>Type</label>
                                @Html.DropDownList("TypeId", new List<SelectListItem>
    {
       new SelectListItem{ Text = "POINT MACHINE", Value = "1" },
    }, new { @class = "form-control", tabindex = 2 })
                            </div>

                            <div class="col-sm-2 mb-1">
                                <label>Sites</label>
                                @Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites,"Select", new { @class = "form-control", tabindex = 1 })
                            </div>
                            <div class="col-sm-2 mb-1">
                                <label>From Date</label>
                                <input type="text" class="datepicker-here form-control digits from-date" id="txtFromDate" data-language="en" />
                            </div>
                            <div class="col-sm-2 mb-1">
                                <label>To Date</label>
                                <input type="text" class="datepicker-here form-control digits to-date" id="txtToDate" data-language="en" />
                            </div>
                            <div class="col-sm-2 mb-1 mt-4">
                                <button type="button" class="btn btn-success" onclick="fnSearch()">Search</button>
                            </div>
                        </div>



                    </div>
                </div>

                <div class="row">
                    <div class="col-sm-12">
                        <div id="divPointMachine">
                        </div>
                    </div>
                </div>
            </div>

        </div>


    </div>

</div>

<div class="modal bounceIn animated" id="modal-graph" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h6 class="modal-title" id="myModalLabel">
                    <span id="line1">52 2021-05-26 17:07:00 <b id="op">Normal Operation:</b></span><br />
                    <span id="line2">- A Max / Average Current: 3.8 / 2.34</span><br />
                    <span id="line3">- A Max / Average Voltage: 118.9 / 116.00</span><br />
                    <span id="line4">- A Operating Time (ms): 3300</span><br />
                    <span id="line5">B Max / Average Current: null / 0.0</span><br />
                    <span id="line6">- B Max / Average Voltage: 0 / 0.00</span><br />
                    <span id="line7">- B Operating Time (ms): 0</span><br />
                </h6>
                <button type="button" style="position:absolute;right:8px;top:8px;" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12 mainclass" id="mainId">
                        <canvas id='basicflot' style='height: 263px'></canvas>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal bounceIn animated" id="modal-pointmachine-graph" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <button type="button" style="position:absolute;right:8px;top:8px;" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="row" id="pointmachine-select-mainId">

                        </div>
                    </div>
                    <div class="col-sm-12 mainclass" id="pointmachine-mainId">
                        <canvas id='pointmachine-basicflot'></canvas>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    function fnSearch() {
        var mPointMachineDataLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $("#SiteId").val();
        mSearchCriteria.AssetTypeId = 3;
        mSearchCriteria.StartDate = $("#txtFromDate").val();
        mSearchCriteria.EndDate = $("#txtToDate").val();
        mPointMachineDataLister.SearchCriteria = mSearchCriteria;

        $("#loader").show();
        $.ajax({
            url: '/AISection/GetPrediction',
            type: 'Post',
            data: '{mPointMachineDataLister:' + JSON.stringify(mPointMachineDataLister) + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divPointMachine").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnBindSignatureGragh(data, type, datevalue, direction, name) {
        // $(".mianclass").empty().append("<canvas  id='basicflot' style='height: 263px'></canvas>")
        //  $("#basicflot").empty();
        $("div").remove(".chartjs-size-monitor");
        //$(".chartjs-size-monitor").each(function () {
        //    $(this).remove()
        //})
        var j = JSON.parse(data);
        var acg;
        var bcg;
        var avg;
        var bvg;
