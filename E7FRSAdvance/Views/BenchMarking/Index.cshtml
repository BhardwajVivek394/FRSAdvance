</div>

<div id="divpmEventPartial">
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
<script src="~/assets/js/chart/echart/echarts.js"></script>
<script>
    var chart;
    $(document).ready(function () {
        $("#AssetTypeId").change(function () {
            BindAssetType();
        });
        $("#SiteId").change(function () {
            BindAssetType();
        });

    });

    function fnGetPointMachineEvent() {
        if ($("#SiteId").val() != null && $("#SiteId").val() != undefined && $("#SiteId").val() != '' && $("#SiteId").val() != '0' && $("#AssetId").val() != null && $("#AssetId").val() != undefined && $("#AssetId").val() != '' && $("#AssetId").val() != '0') {

            $("#loader").show();
            $.ajax({
                url: '/BenchMarking/GetPointMachineEvent',
                type: 'Post',
                data: '{assetId:' + $("#AssetId").val() + '}',
                contentType: 'application/json',
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    $("#divpmEventPartial").empty().append(data);
                    $("#model-benchmarking-pointmachine-eventgraph").modal("show");
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        } else {
            CommonNotification("ERROR", "Select Site and Asset", "Error");
        }
    }

    function fnDBChanges($this, db) {
        $(".db1").removeClass("active");
        $($this).addClass("active");
        if (db == "MQTT") {
            $('#area-echart-dataview').hide();
            $('#area-echart').show();
        } else {
            $('#area-echart').hide();
            $('#area-echart-dataview').show();
        }
    }

    function BindAssetType() {
        if ($("#SiteId").val() != null && $("#SiteId").val() != undefined && $("#SiteId").val() != '' && $("#SiteId").val() != '0' && $("#AssetTypeId").val() != null && $("#AssetTypeId").val() != undefined && $("#AssetTypeId").val() != '' && $("#AssetTypeId").val() != '0') {
            $("#loader").show();
            $.ajax({
                url: '/BenchMarking/GetAssestBy',
                type: 'POST',
                data: '{siteId:' + $("#SiteId").val() + ',assetTypeId:' + $("#AssetTypeId").val() + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#AssetId").empty();
                    $("#AssetId").append($("<option></option>").val('0').html('Select Asset'));
                    $.each(data, function (key, value) {
                        $("#AssetId").append($("<option></option>").val(value.Id).html(value.Name));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            //  CommonNotification("ERROR", "Please select site and asset type", "Error");
        }

    }

    function GetGraph(sd, ed) {
        var mAsset = {};
        mAsset.Id = $("#AssetId").val();
        mAsset.SiteId = $("#SiteId").val();
        mAsset.StartDate = sd;
        mAsset.EndDate = ed;

        if (chart != null && chart != "" && chart != undefined) {
            chart.dispose();
        }
        mAsset.IsReadHttpPost = false;
        mAsset.IsLocal = false;
        if ($("#SiteId").val() != null && $("#SiteId").val() != undefined && $("#SiteId").val() != '' && $("#SiteId").val() != '0' && $("#AssetId").val() != null && $("#AssetId").val() != undefined && $("#AssetId").val() != '' && $("#AssetId").val() != '0') {
            $("#loader").show();
            $.ajax({
                url: '/BenchMarking/GetReportData',
                type: 'Post',
                data: '{asset:' + JSON.stringify(mAsset) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        $('#searchDate').datepicker({
                            dateFormat: 'm/d/yy',
                            autoClose: true
                        }).datepicker("setDate", new Date());
                        fnDBChanges($('#mqtt'), 'MQTT')
                        $("#asset-graph").modal("show");

                        Demochart(data)
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            CommonNotification("ERROR", "Select Site and Asset", "Error");
        }

    }

    function GetBenchmarkingGraph() {
        var mBenchMarkingLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $("#SiteId").val();
        mSearchCriteria.AssetId = $("#AssetId").val();

        mBenchMarkingLister.SearchCriteria = mSearchCriteria;
        if ($("#SiteId").val() != null && $("#SiteId").val() != undefined && $("#SiteId").val() != '' && $("#SiteId").val() != '0' && $("#AssetId").val() != null && $("#AssetId").val() != undefined && $("#AssetId").val() != '' && $("#AssetId").val() != '0') {

            $("#loader").show();
            $.ajax({
                url: '/BenchMarking/GetGraph',
                type: 'Post',
                data: '{mBenchMarkingLister:' + JSON.stringify(mBenchMarkingLister) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#model-benchmarking-graph").modal("show");
                    BindBenchmarkingChart(data);
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        } else {
            CommonNotification("ERROR", "Select Site and Asset", "Error");
        }
    }

    function BindBenchmarkingChart(data) {
        if (chart != null && chart != "" && chart != undefined) {
            chart.dispose();
        }
        var DataSeriaes = [];
        var maxV = 0;
        var legends = [];
        var macLeft = 0;
        var yAxisArray = [];
        var lary = [];
        var rary = [];

        if (data.assetAttributes != null && data.assetAttributes.length > 0) {
            $.each(data.assetAttributes, function (ids, val) {
                if (ids == 0) {
                    $("#lblType").text(val.AssetTypeName + " :");
                    $("#lblAssetName").text(val.AssetName)
                }
                var xA = [];
                $.each(val.Data, function (i, j) {
                    xA.push(j);
                });

                legends.push(val.Title)
                var attr = {};
                attr.name = val.Title;
                attr.type = 'line';
                attr.notShowSymbol = true;
                attr.sampling = sampling;
                attr.hoverAnimation = false;
                attr.clip = true;
                if (val.Title.indexOf('V') > -1) {
                    var yaxis = {
                        value: val.Title,
                    };
                    rary.push(yaxis)
                    attr.yAxisIndex = 1;
                }
                else {
                    var yaxis = {
                        value: val.Title,
                    };
                    lary.push(yaxis)
                    attr.yAxisIndex = 0;
                }

                if (val.Title == "TPR V" || val.Title == "DG V" || val.Title == "RG V" || val.Title == "HG V" || val.Title == "HHG V" || val.Title == "Tx1 V" || val.Title == "Tx2 V" || val.Title == "Choke V" || val.Title == "Vr" || val.Title == "Voltage") {

                    $.each(val.Data, function (i, j) {
                        var d = parseInt(j);
                        if (d > maxV) {
                            maxV = d;
                        }
                    });
                }
                attr.data = [];
                var values = [];
                $.each(val.Data, function (i, j) {
                    values.push(j);
                });

                if (val.Title != "TPR V" || val.Title != "DG V" || val.Title != "RG V" || val.Title != "HG V" || val.Title != "HHG V" || val.Title != "Tx1 V" || val.Title != "Tx2 V" || val.Title != "Choke V" || val.Title != "Vr" || val.Title != "Voltage") {
                    var yLeft = Math.max.apply(Math, values); // 3
                    if (yLeft >= macLeft) {
                        macLeft = yLeft;
                    }
                }


                attr.connectNulls = true;
                attr.data = values;
                attr.datasetIndex = ids;
                DataSeriaes.push(attr);

            });
        }

        var xValue = [];
        $.each(data.DateList, function (ids, val) {
            xValue.push(val);
        });

        BindTable(data);

        chart = echarts.init(document.getElementById('area-benchmarking-echart'));
        var sampling = 'none';
        chart.setOption({
            //title: {
            //    text: 'Rainfall Flow diagram',
            //    x: 'center'
            //},
            tooltip: {
                trigger: 'axis',
                axisPointer: {
                    type: 'cross',
                    label: {
                        backgroundColor: '#6a7985'
                    }
                }
            },
            legend: {
                data: legends,
                x: 'left'

            },
            toolbox: {
                show: true,
                feature: {
                    mark: { show: true },
                    dataView: { show: true, readOnly: false },
                    magicType: { show: true, type: ['line', 'bar'] },
                    restore: { show: true },
                    saveAsImage: { show: true }
                }
            },
            grid: {
                left: '3%',
                right: '4%',
                bottom: '3%',
                containLabel: true
            },
            xAxis: [
                {
                    type: 'category',
                    boundaryGap: false,
                    axisLine: { onZero: false },
                    interval: 50,
                    //minInterval:1,
                    //  maxInterval: 3600 * 1000 * 24,
                    data: xValue,
                    // min: "00:00",
                    //  max:"11.59"
                }
            ],
            //yAxis: yAxisArray,
            yAxis: [
                {
                    type: 'value',
                    min: 0,
                    max: macLeft,
                    data: lary
                },
                {
                    type: 'value',
                    inverse: false,
                    min: -1,
                    max: maxV + 1,
                    data: rary
                }
            ],
            height: 250,
            dataZoom: [{
                type: 'slider',
                height: 40,
                start: 0,
                end: 100,
                bottom: 0
            }],
            color: ["#4bacc6", "#215968", "#717171", "#7366ff", "#cc6600", "#90d474", "#4d4d00", "#00e396", "#00ceba", "#f37995"],

            series: DataSeriaes
        });

        window.onresize = chart.resize;
    }

    function fnFilterGraph() {
        var mAsset = {};
        mAsset.Id = $("#AssetId").val();
        mAsset.SiteId = $("#SiteId").val();
        mAsset.StartDate = $('#searchDate').val();
        mAsset.EndDate = $('#searchDate').val();

        mAsset.StartTime = $("#tpFrom").val();
        mAsset.EndTime = $("#tpTo").val();
        if (chart != null && chart != "" && chart != undefined) {
            chart.dispose();
        }
        mAsset.IsReadHttpPost = false;
        mAsset.IsLocal = false;

        $("#loader").show();
        $.ajax({
            url: '/BenchMarking/GetReportData',
            type: 'Post',
            data: '{asset:' + JSON.stringify(mAsset) + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                if (data != null) {
                    Demochart(data)
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

