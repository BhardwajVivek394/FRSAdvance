
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Benchmarking</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="pull-left">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Sites</strong>
                            </div>
                            <div class="pull-left">
                                @Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 1 })
                            </div>
                            <div class="pull-left">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Asset Type</strong>
                            </div>
                            <div class="pull-left">
                                @Html.DropDownList("AssetTypeId", (IEnumerable<SelectListItem>)ViewBag.AssetTypes, "Select", new { @class = "form-control", tabindex = 1 })
                            </div>
                            <div class="pull-left">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Asset</strong>
                            </div>
                            <div class="pull-left">
                                <select id="AssetId" class="form-control">
                                    <option value="0">Select</option>
                                </select>
                            </div>
                            <div class="pull-left m-l-10">
                                <button type="button" class="btn btn-info" title="Search Benchmarking" onclick="GetBenchMarkingList()"><i class="fa fa-search"></i></button>
                            </div>
                            <div class="pull-left m-l-10">
                                <button type="button" class="btn btn-success" title="Add Benchmarking" onclick="GetGraph('@DateTime.Now.ToShortDateString()','@DateTime.Now.ToShortDateString()')"><i class="fa fa-plus"></i></button>
                            </div>
                            <div class="pull-left m-l-10">
                                <button type="button" class="btn btn-dark" title="Add PointMachine Event Benchmarking" onclick="GetPointMachineEvent()"><i class="fa fa-plus"></i></button>
                            </div>
                            <div class="pull-left m-l-10">
                                <button type="button" class="btn btn-warning" title="Benchmarking Graph" onclick="GetBenchmarkingGraph('@DateTime.Now.ToShortDateString()','@DateTime.Now.ToShortDateString()')"><i class="fa fa-eye"></i></button>
                            </div>


                        </div>
                    </div>

                </div>
                <div class="card-body">
                    <div id="divAssetAttributePartial">
                    </div>
                    <div id="divPointMachineEventPartial" style="display:none">
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>


<div class="modal bounceIn animated" id="asset-graph" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span>Graph</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-6">
                        <div class="pull-left">
                            <label style="margin-top:7px;font-weight:bold">Asset:</label>
                            <label style="margin-top:7px" id="lblName"></label>
                        </div>

                    </div>
                    <div class="col-sm-6">
                        <div id="divFamilyTrack" style="display:inline-flex;">
                            <input type="hidden" id="familyTrack" value="Select Asset" />
                        </div>
                    </div>
                    <div class="col-lg-12">

                        <div class="card" style="width:100%;">
                            <div class="card-header">

                                <div class="pull-left">
                                    <input type="hidden" id="selDatabase" value="MQTT" />
                                    <div class="btn-group btn-bar-rad">
                                        <button class="btn btn-outline-primary db1 active" id="mqtt" onclick="fnDBChanges(this,'MQTT')" data-name="MQTT" type="button">MQTT Db</button>
                                        <button class="btn btn-outline-primary db1" id="http" onclick="fnDBChanges(this,'BenchMarking')" data-name="HTTP" type="button">Select Bench Marking</button>

                                    </div>
                                </div>
                                <div class="pull-right" style="display:inline-flex;">
                                    <input type="text" class="form-control" id="searchDate" onchange="fnFilterGraph()" />
                                </div>
                            </div>

                            <div id="chart" style="width:100%">
                            </div>
                            <div class="apache-cotainer" id="area-echart">

                            </div>
                            <div id="area-echart-dataview" style="display:none;height:500px;overflow-y:auto;">
                                <table class="table">
                                    <thead id="area-echart-thead"></thead>
                                    <tbody id="area-echart-tbody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-primary" onclick="fnSaveBenchMarking()">Save</button>
                <button class="btn btn-default" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<div class="modal bounceIn animated" id="model-benchmarking-graph" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span>Graph</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-6">
                        <div class="pull-left">
                            <label style="margin-top:7px;font-weight:bold">Asset:</label>
                            <label style="margin-top:7px" id="lblAssetName"></label>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="card" style="width:100%;">
                            @*<div id="chart" style="width:100%">
                                </div>*@
                            <div class="apache-cotainer" id="area-benchmarking-echart">

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<div class="modal bounceIn animated" id="modal-pointmachine-graph" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h6 class="modal-title" id="myModalLabel">
                    <span id="line1">52 2021-05-26 17:07:00 <b id="op">Normal Operation:</b></span><br />
                    <span id="line2">- A Max / Average Current: 3.8 / 2.34</span><br />
                    <span id="line3">- A Max / Average Voltage: 118.9 / 116.00</span><br />
                    <span id="line4">- A Operating Time (ms): 3300</span><br />
                    <span id="line5">B Max / Average Current: null / 0.0</span><br />
                    <span id="line6">- B Max / Average Voltage: 0 / 0.00</span><br />
                    <span id="line7">- B Operating Time (ms): 0</span><br />
                </h6>
                <button type="button" style="position:absolute;right:8px;top:8px;" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12 mainclass" id="mainId">
                        <canvas id='basicflot' style='height: 263px'></canvas>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
