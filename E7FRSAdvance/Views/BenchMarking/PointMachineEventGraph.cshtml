@model Domain.Asset

<div class="modal bounceIn animated" id="model-benchmarking-pointmachine-eventgraph" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span>Graph</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-6">
                        <div class="pull-left">
                            <label style="margin-top:7px;font-weight:bold">Asset:</label>
                            <label style="margin-top:7px" id="lblAssetName"></label>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <div class="card" style="width:100%;">
                            <table class="table table-bordered table-striped" id="tblPoint@(Model.Id)">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Name</th>
                                        <th>Direction</th>

                                        @if (Model.IsHalfPointMachine == null || (Model.IsHalfPointMachine != null && !Model.IsHalfPointMachine.Value))
                                        {

                                            <th>A Current(Max/Avg) <br /></th>
                                            <th>A Voltage <br /></th>
                                            <th>A Time (ms)</th>
                                        }
                                        else
                                        {
                                            <th>Current(Max/Avg)</th>
                                            <th>Voltage</th>
                                            <th>Time (ms)</th>
                                        }


                                        @if (Model.IsHalfPointMachine == null || (Model.IsHalfPointMachine != null && !Model.IsHalfPointMachine.Value))
                                        {
                                            <th>B Current(Max/Avg) <br /></th>
                                            <th>B Voltage <br /></th>
                                            <th>B Time (ms)</th>
                                        }
                                        <th>Is Primary</th>
                                        <th>Delete</th>
                                    </tr>
                                </thead>
                                <tbody class="fbody@(Model.Id)">
                                    @if (Model != null && Model.BenchMarkingPointMachines != null)
                                    {
                                        foreach (var point in Model.BenchMarkingPointMachines.OrderByDescending(x => x.TimeStamp))
                                        {
                                            var date = Convert.ToDateTime(point.TsTime).ToString("MM/dd/yyyy");
                                            <tr>
                                                <td>
                                                    @point.TsTime
                                                </td>
                                                <td class="assetname">
                                                    @Model.Name
                                                </td>
                                                <td>
                                                    @point.Direction  Operation
                                                </td>


                                                <td style="cursor:pointer;color:#dc8b33;" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','AC',' @point.TsTime','@point.Direction','@point.AssetType')">

                                                    @string.Format("{0:0.00}", point.PointMachineJson.A_C_MAX)   /  @string.Format("{0:0.00}", @point.PointMachineJson.A_C_AVERAGE) (@point.PointMachineJson.A_C_CurveArea)


                                                </td>
                                                <td onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','AV',' @point.TsTime','@point.Direction','@point.AssetType')">
                                                    @point.PointMachineJson.A_V_AVERAGE

                                                </td>
                                                <td>
                                                    <span> @point.PointMachineJson.A_C_TIME </span>
                                                </td>
                                                @if (Model.IsHalfPointMachine == null || (Model.IsHalfPointMachine != null && !Model.IsHalfPointMachine.Value))
                                                {
                                                    <td style="cursor:pointer;color:#dc8b33;" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','BC',' @point.TsTime','@point.Direction','@point.AssetType')">

                                                        @string.Format("{0:0.00}", point.PointMachineJson.B_C_MAX)  /  @string.Format("{0:0.00}", @point.PointMachineJson.B_C_AVERAGE) (@point.PointMachineJson.B_C_CurveArea)

                                                    </td>
                                                    <td onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','BV',' @point.TsTime','@point.Direction','@point.AssetType')">
                                                        @point.PointMachineJson.B_V_AVERAGE

                                                    </td>
                                                    <td>
                                                        @point.PointMachineJson.B_C_TIME
                                                    </td>

                                                }
                                                <td>
                                                    @if (point.IsPrimary)
                                                    {
                                                        <input type="checkbox" onchange="fnUpdatePointMachineBenchMarking('@point.TsTime','@point.Direction',this)" checked>
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" onchange="fnUpdatePointMachineBenchMarking('@point.TsTime','@point.Direction',this)">
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    <a href="#" onclick="fnDeletePointMachineBenchMarking('@point.Id')"><i class="fa fa-trash text-danger f-16"></i></a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
