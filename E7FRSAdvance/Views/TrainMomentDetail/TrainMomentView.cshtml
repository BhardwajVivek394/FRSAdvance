@model List<Domain.TrainMoment>

<div class="modal bounceIn animated" id="modal-line-Train-Moment" tabindex="-1" aria-labelledby="modal-line-Train-Moment" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span>Train Moment</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="table-responsive">
                                <table class="table">
                                    @if (Model != null && Model.Count > 0)
                                    {
                                        <tr>
                                            <th>Unique Id</th>
                                            <th>Train Number</th>
                                            <th>Entry Time</th>
                                            <th>Exit Time</th>
                                            <th>Line</th>
                                            <th>Verify</th>
                                            <th>Timestamp</th>
                                            <th></th>
                                        </tr>
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <span id="spnUniqueIdDetail@(item.Id)">@item.UniqueId</span>
                                                </td>

                                                <td>
                                                    <div class="row">
                                                        <div class="col-12">
                                                            @if (!string.IsNullOrEmpty(item.TrainNumber))
                                                            {
                                                                <span>
                                                                    @item.TrainNumber
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <input type="text" class="form-control" id="txtTrainNumberDetail@(item.Id)" />
                                                            }
                                                        </div>
                                                    </div>

                                                </td>
                                                <td>@item.EntryTime</td>
                                                <td>@item.ExitTime</td>
                                                <td>
                                                    @if (item.LineTypeId == 1)
                                                    {
                                                        <span>Up</span>
                                                    }
                                                    else if (item.LineTypeId == 2)
                                                    {
                                                        <span>Down</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (item.IsVerify)
                                                    {
                                                        <span>Correct</span>
                                                    }
                                                    else
                                                    {
                                                        <span>In Correct</span>
                                                    }
                                                </td>
                                                <td>
                                                    @item.CreatedDate
                                                </td>
                                                <td>
                                                    @if (string.IsNullOrEmpty(item.TrainNumber))
                                                    {
                                                        <button type="button" class="btn btn-success" onclick="fnUpdateTrainNumber('@item.Id','@item.SiteId')"><i class="fa fa-save"></i></button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }

                                </table>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
            </div>
        </div>
    </div>
</div>

