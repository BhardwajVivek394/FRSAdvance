@model List<Domain.Asset>

<div class="modal bounceIn animated" id="modal-line-track-asset" tabindex="-1" aria-labelledby="modal-line-track-asset" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span>Assets</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="table-responsive">
                                <table class="table">
                                    @if (Model != null && Model.Count > 0)
                                    {
                                        <tr>
                                            <th>Name</th>
                                            <th>TPR</th>
                                        </tr>
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.Name</td>
                                                <td></td>
                                            </tr>
                                        }
                                    }

                                </table>
                            </div>


                        </div>

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
            </div>
        </div>
    </div>
</div>
