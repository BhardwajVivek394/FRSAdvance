    function GetTrainMomentLatestDataAutomatic() {

        $.ajax({
            url: '/TrainMomentDetail/GetTrainMomentLatestData',
            type: 'Post',
            contentType: 'application/json',
            success: function (data) {
                if (data != null && data != undefined) {

                    var stlr = 75;
                    var dga = 78;
                    var bagl = 79;
                    var gjh = 80;
                    $('.tdUpLineTrain' + dga).empty();
                    $('.tdUpLineTrain' + bagl).empty();
                    $('.tdUpLineTrain' + gjh).empty();


                    $('.tdDownLineTrain' + bagl).empty();
                    $('.tdDownLineTrain' + dga).empty();
                    $('.tdDownLineTrain' + stlr).empty();
                    $(data).each(function (d, val) {
                        //UP
                        if (val.LineTypeId == 1) {

                            if (val.SiteId == stlr) {
                                //STLR
                                $('.trUpLineTrain' + dga).show();
                                var trainName = '';
                                if (val.TrainNumber != null && val.TrainNumber != undefined && val.TrainNumber != '') {
                                    trainName = val.TrainNumber;
                                }
                                else if (val.UniqueId != null && val.UniqueId != undefined && val.UniqueId != '') {
                                    trainName = val.UniqueId;
                                }
                                var message = '<span>' + trainName + ' train is coming shortly, Departure on ' + val.ExitTime + ' from Sitalpur (STLR) station.</span><hr />';
                                $('.tdUpLineTrain' + dga).append(message);

                            } else if (val.SiteId == dga) {
                                //DGA
                                var trainName = '';
                                if (val.TrainNumber != null && val.TrainNumber != undefined && val.TrainNumber != '') {
                                    trainName = val.TrainNumber;
                                }
                                else if (val.UniqueId != null && val.UniqueId != undefined && val.UniqueId != '') {
                                    trainName = val.UniqueId;
                                }
                                $('.trUpLineTrain' + bagl).show();
                                var message = '<span>' + trainName + ' train is coming shortly, Departure on ' + val.ExitTime + ' from DIGHWARA (DGA) station.</span><hr />';
                                $('.tdUpLineTrain' + bagl).append(message);

                            }
                            else if (val.SiteId == bagl) {
                                //BAGL
                                var trainName = '';
                                if (val.TrainNumber != null && val.TrainNumber != undefined && val.TrainNumber != '') {
                                    trainName = val.TrainNumber;
                                }
                                else if (val.UniqueId != null && val.UniqueId != undefined && val.UniqueId != '') {
                                    trainName = val.UniqueId;
                                }
                                $('.trUpLineTrain' + gjh).show();
                                var message = '<span>' + trainName + ' train is coming shortly, Departure on ' + val.ExitTime + ' from BARAGOPAL (BAGL) station.</span><hr />';
                                $('.tdUpLineTrain' + gjh).append(message);
                            }

                        } else if (val.LineTypeId == 2) {
                            if (val.SiteId == gjh) {
                                //STLR
                                if (val.TrainNumber != null && val.TrainNumber != undefined && val.TrainNumber != '') {
                                    trainName = val.TrainNumber;
                                }
                                else if (val.UniqueId != null && val.UniqueId != undefined && val.UniqueId != '') {
                                    trainName = val.UniqueId;
                                }
                                $('.trDownLineTrain' + bagl).show();
                                var message = '<span>' + trainName + ' train is coming shortly, Departure on ' + val.ExitTime + ' from GOLDINGANJ (GJH) station.</span><hr />';
                                $('.tdDownLineTrain' + bagl).append(message);

                            } else if (val.SiteId == bagl) {
                                //bagl
                                if (val.TrainNumber != null && val.TrainNumber != undefined && val.TrainNumber != '') {
                                    trainName = val.TrainNumber;
                                }
                                else if (val.UniqueId != null && val.UniqueId != undefined && val.UniqueId != '') {
                                    trainName = val.UniqueId;
                                }
                                $('.trDownLineTrain' + dga).show();
                                var message = '<span>' + trainName + ' train is coming shortly, Departure on ' + val.ExitTime + ' from BARAGOPAL (BAGL) station.</span><hr />';
                                $('.tdDownLineTrain' + dga).append(message);

                            }
                            else if (val.SiteId == dga) {
                                //BAGL
                                if (val.TrainNumber != null && val.TrainNumber != undefined && val.TrainNumber != '') {
                                    trainName = val.TrainNumber;
                                }
                                else if (val.UniqueId != null && val.UniqueId != undefined && val.UniqueId != '') {
                                    trainName = val.UniqueId;
                                }
                                $('.trDownLineTrain' + stlr).show();
                                var message = '<span>' + trainName + ' train is coming shortly, Departure on ' + val.ExitTime + ' from DIGHWARA (DGA) station.</span><hr />';
                                $('.tdDownLineTrain' + stlr).append(message);
                            }
                        }

                    });
                }

            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function Valid(mTrainMoment) {
        var isValid = true;

        if (mTrainMoment.EntryTime == null || mTrainMoment.EntryTime == undefined || mTrainMoment.EntryTime == '') {
            alert('Entry Time not set');
            isValid = false;
        }
        else if (mTrainMoment.ExitTime == null || mTrainMoment.ExitTime == undefined || mTrainMoment.ExitTime == '') {
            alert('Exit Time not set');
            isValid = false;
        }
        else if (mTrainMoment.TrainNumber == null || mTrainMoment.TrainNumber == undefined || mTrainMoment.TrainNumber == '') {
            alert('Train Number is required.');
            isValid = false;
        }


        return isValid;
    }

