    function fnUpdateTrainNumber(id, siteId) {
        debugger;

        var mTrainMoment = {};
        mTrainMoment.Id = id;
        mTrainMoment.TrainNumber = $('#txtTrainNumberDetail' + id).val();
        mTrainMoment.UniqueId = $('#spnUniqueIdDetail' + id).text();

        if (ValidTrainNumber(mTrainMoment)) {
            $("#loader").show();
            $.ajax({
                url: '/TrainMomentDetail/UpdateTrainMomentDetail',
                type: 'Post',
                contentType: 'application/json',
                data: JSON.stringify(mTrainMoment),
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        alert(data.result);
                        $('#modal-line-Train-Moment').modal('hide');
                        GetTrainMomentView(siteId);
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    alert("Something went wrong!");
                }
            })
        }


    }

    function ValidTrainNumber(mTrainMoment) {
        var isValid = true;

        if (mTrainMoment.TrainNumber == null || mTrainMoment.TrainNumber == undefined || mTrainMoment.TrainNumber == '') {
            alert('Train Number is required.');
            isValid = false;
        }


        return isValid;
    }
