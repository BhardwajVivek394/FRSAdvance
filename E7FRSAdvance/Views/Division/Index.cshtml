@model Domain.DivisionLister

@{
    ViewBag.Title = "Division";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Division</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">
        @using (Ajax.BeginForm("DivisionList", "Division", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divDivisionList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "DivisionRefreshed"
        }, new { id = "frmGetDivisionList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divDivisionList">
                @Html.Action("DivisionList")
            </div>
        }


        @using (Ajax.BeginForm("SaveDivision", "Division", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveDivision",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "DivisionSaved"
        }, new { id = "frmSaveDivision" }))
        {
            <div id="divSaveDivision">
                @Html.Partial("_AddDivisionPartial", new Domain.Division())
            </div>
        }

        @using (Ajax.BeginForm("SaveDivisionImportantLink", "Division", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divDivisionImportantLink",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
        }, new { id = "frmGetDivisionImportantLink" }))
        {
            <div id="divDivisionImportantLink">
                @Html.Partial("_AddDivisionLinkPartial", new List<Domain.DivisionImportantLink>())
            </div>
        }
    </div>
</div>
<script src="~/Content/PageJS/Division/DivisionIndex.js"></script>