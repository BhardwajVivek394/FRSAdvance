@model Domain.DivisionLister


@Html.HiddenFor(m => m.SearchCriteria.ColumnName, new { id = "hdnColumnName" })
@Html.HiddenFor(m => m.SearchCriteria.SortDirection, new { id = "hdnSortDirection" })


<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />
<div class="container-fluid">
    <div class="row">
        <div class="col-xl-10">
            <div class="card">
                <div class="card-header">
                    <div class="people-options clearfix">
                        <div class="pull-left">
                            <a id="btnAddDivision" class="btn btn-primary btn-quirk" data-bs-toggle="modal" data-bs-target="#modal-add-division">Add Division</a>
                        </div>
                        <div class="btn-group pull-right people-pager">
                            @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
                            @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
                        </div>
                        <div class="btn-group pull-right people-pager">
                            <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left "></i></button>
                            <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>
                        </div>
                        @{
                            int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
                            if (Model.mDivisions.Count == 0)
                            {
                                start = 0;
                            }
                            decimal end = Math.Floor(Model.Pager.TotalRecord);
                            if (Model.Pager.PageSize < Model.Pager.TotalRecord)
                            {
                                if (Model.Pager.PageSize == -1)
                                {
                                    end = Model.Pager.TotalRecord;
                                }
                                else
                                {
                                    end = Model.Pager.PageSize * Model.Pager.CurrentPage;
                                    if (end > Model.Pager.TotalRecord)
                                    {
                                        end = Model.Pager.TotalRecord;
                                    }
                                }
                            }
                        }
                        <span class="people-count pull-right" style="margin-top:10px;">Showing <strong>@start - @Math.Floor(end)</strong> of <strong>@Math.Floor(Model.Pager.TotalRecord)</strong> Divisions</span>
                    </div>
                </div>
                <div class="card-body" style="padding:15px;">
                    <div class="table-responsive vh-100">
                        <table class="table">
                            <thead class="bg-primary">
                                <tr>
                                    <th colspan="4" class="text-center">Action</th>
                                    <th data-sortcolumn="Name" class="sorting" id="thName" onclick="SortList('Name');">Name</th>
                                    <th data-sortcolumn="Name" class="sorting" id="thName">Zone Name</th>
                                    <th data-sortcolumn="Description" class="sorting" id="thDescription" onclick="SortList('Description');">Description</th>
                                    <th data-sortcolumn="IsActive" class="sorting" id="thIsActive" onclick="SortList('IsActive');" style="width:100px">Active?</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.mDivisions != null && Model.mDivisions.Count > 0)
                                {
                                    foreach (var item in Model.mDivisions)
                                    {
                                        <tr class="table-light">
                                            <td class="text-center" style="width:50px;">
                                                <a href="@Url.Action("DivisionLayout",new {divisionId =item.Id})" data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Edit"><i class="fa fa-diamond"></i></a>
                                            </td>
                                            <td class="text-center" style="width:50px;">
                                                <a href="javascript:void(0)" data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Edit"><i class="fa fa-edit text-vision" onclick="GetDivisionById('@item.Id')"></i></a>
                                            </td>
                                            <td class="text-center width60" style="width:50px;">
                                                <a href="javascript:void(0)" data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Delete"><i class="fa fa-trash text-danger" onclick="DeleteDivisionById('@item.Id')"></i></a>
                                            </td>
                                            <td class="text-center width60" style="width:50px;">
                                                <a href="javascript:void(0)" data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Delete"><i class="fa fa-link text-vision" onclick="AddDivisionLink('@item.Id')"></i></a>
                                            </td>
                                            <td>@item.Name</td>
                                            <td>@item.ZoneName</td>
                                            <td>@item.Description</td>
                                            <td class="">
                                                @if (item.IsActive)
                                                {
                                                    <span class="span badge rounded-pill pill-badge-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="span badge rounded-pill pill-badge-yellow">In Active</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center">
                                            No record found
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

        </div>
        <div class="col-xl-2 xl-40">
            <div class="row">
                <div class="col-xl-12 default-according style-1 faq-accordion job-accordion">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <a class="btn btn-link">Search Division</a>
                            </h5>
                        </div>
                        <div class="card-body filter-cards-view animate-chk">
                            <div class="form-group  mb-3">
                                <label class="control-label center-block">Name:</label>
                                @Html.TextBoxFor(m => m.SearchCriteria.Name, new { @class = "form-control", type = "text", id = "txtSearchName" })
                            </div>
                            <div class="form-group">
                                <div class="row">
                                    <div class="col-sm-6">
                                        <a class="btn btn-success" onclick="Search()">Search</a>
                                    </div>
                                    <div class="col-sm-6">
                                        <a class="btn btn-default btn-quirk btn-block" onclick="Clear()">Clear</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script src="~/Content/PageJS/Division/DivisionList.js"></script>
<script>
    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmGetDivisionList").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize)
            {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmGetDivisionList").submit();
            }
        }
    }
</script>
