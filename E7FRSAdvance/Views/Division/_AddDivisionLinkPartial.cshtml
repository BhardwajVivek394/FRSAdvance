@model List<Domain.DivisionImportantLink>

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-division-important-link" tabindex="-1" aria-labelledby="modal-add-division-important-link" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Division Important Link</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <label class="control-label">Add Link <a onclick="fnAddDivisionLink()" class="btn btn-xs btn-primary"><i class="fa fa-plus"></i></a></label>
                        </div>
                        <div class="col-sm-12">
                            <table class="table">
                                <tbody id="tbodyDivisionImportantLink">
                                    @if (Model != null && Model.Count > 0)
                                    {
                                        int i = 0;
                                        foreach (var divImp in Model)
                                        {
                                            i++;
                                            <tr>
                                                <td><label>Link @i</label></td>
                                                <td><input type="text" class="form-control txtLinkName" placeholder="Enter Link Name" value="@divImp.Name" data-main-id="@divImp.Id" data-new-Id="@i"/></td>
                                                <td><input type="text" class="form-control txtLink" placeholder="Enter Link" value="@divImp.Link" /></td>
                                                <td><button type="Button" onclick="fnDeleteImportantLink('@divImp.Id')" class="btn btn-xs btn-primary"><i class="fa fa-minus"></i></button></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close" id="btnClose">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSaveImportantLink('@ViewBag.DivisionId')" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>