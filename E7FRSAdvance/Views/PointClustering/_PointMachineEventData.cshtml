@model Domain.Asset

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal fade" id="modal-show-PointMachineEvent" role="dialog" aria-labelledby="modal-show-PointMachineEvent" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Point Machine Data - @Model.Name</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Name</th>
                                <th>Direction</th>
                                @if (Model.IsSeriesOpration != null && Model.IsSeriesOpration.Value)
                                {
                                    @*<th>New Combine </th>*@
                                    <th>Combine </th>
                                }


                                @if (Model.mPointMachineData.Where(x => x.PointMachineJson.ClusterA.StartsWith(ViewBag.Clusters)).Count() > 0)
                                {
                                    if (Model.IsHalfPointMachine == null || (Model.IsHalfPointMachine != null && !Model.IsHalfPointMachine.Value))
                                    {

                                        <th>A Current(Max/Avg)  </th>
                                        <th>A Voltage </th>
                                        <th>A Time (ms)</th>
                                        <th width="120">Cluster A</th>
                                    }
                                    else
                                    {
                                        <th>Current(Max/Avg) </th>
                                        <th>Voltage</th>
                                        <th>Time (ms)</th>
                                        <th width="120">Cluster A</th>
                                    }
                                }


                                @if (Model.mPointMachineData.Where(x => x.PointMachineJson.ClusterB.StartsWith(ViewBag.Clusters)).Count() > 0)
                                {
                                    if (Model.IsHalfPointMachine == null || (Model.IsHalfPointMachine != null && !Model.IsHalfPointMachine.Value))
                                    {
                                        <th>B Current(Max/Avg)</th>

                                        <th>B Voltage</th>

                                        <th>B Time (ms)</th>

                                        <th width="120">Cluster B</th>

                                    }
                                }



                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.mPointMachineData != null)
                            {
                                foreach (var point in Model.mPointMachineData.OrderByDescending(x => x.Date))
                                {
                                    var date = Convert.ToDateTime(point.Date).ToString("MM/dd/yyyy");
                                    <tr>

                                        <td>
                                            @point.Date
                                        </td>
                                        <td class="assetname">
                                            @point.AssetName
                                        </td>
                                        <td>
                                            @point.Direction  Operation
                                        </td>
                                        @if (Model.IsSeriesOpration != null && Model.IsSeriesOpration.Value)
                                        {
                                            var sumTime = point.PointMachineJson.A_C_TIME + point.PointMachineJson.B_C_TIME;


                                            <td>
                                                @if ((point.PointMachineJson.Combine_C_TIME > 0 && point.PointMachineJson.Combine_V_TIME > 0) || (point.PointMachineJson.IsCombineOperation_A && point.PointMachineJson.IsCombineOperation_B))
                                                {
                                                    <span>(Max/Avg/Time)</span>
                                                    <span>
                                                        <a href="javascript:void(0)" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CC', ' @point.Date', '@point.Direction', '@point.AssetType', '@point.AssetId'); return false;">C(@point.PointMachineJson.Combine_C_MAX/@point.PointMachineJson.Combine_C_AVERAGE/@point.PointMachineJson.Combine_C_TIME)</a>
                                                        <br />
                                                        <a href="javascript:void(0)" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CV', ' @point.Date', '@point.Direction', '@point.AssetType', '@point.AssetId'); return false;">V(@point.PointMachineJson.Combine_V_MAX/@point.PointMachineJson.Combine_V_AVERAGE/@point.PointMachineJson.Combine_V_TIME)</a>
                                                    </span>
                                                }
                                                else if (Model.MachineAScale == (int)E7FRSAdvance.Utility.Utility.PMScale.Scale_20 || Model.MachineBScale == (int)E7FRSAdvance.Utility.Utility.PMScale.Scale_20)
                                                {
                                                    <span>
                                                        <a href="javascript:void(0)" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','CC',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">C</a>/<a href="#" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CV', ' @point.Date', '@point.Direction', '@point.AssetType', '@ViewBag.Clusters'); return false;">V</a>/<a>T(@sumTime)</a>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>
                                                        <a href="javascript:void(0)" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','CC',' @point.Date','@point.Direction','@point.AssetType','@point.AssetId')">C</a>/<a href="#" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CV', ' @point.Date', '@point.Direction', '@point.AssetType', '@ViewBag.Clusters'); return false;">V</a>/<a>T(@sumTime)</a>
                                                    </span>
                                                }

                                            </td>
                                        }


                                        @if (Model.mPointMachineData.Where(x => x.PointMachineJson.ClusterA.StartsWith(ViewBag.Clusters)).Count() > 0)
                                        {
                                            if ((point.PointMachineJson.Combine_C_TIME > 0 && point.PointMachineJson.Combine_V_TIME > 0) || (point.PointMachineJson.IsCombineOperation_A && point.PointMachineJson.IsCombineOperation_B))
                                            {
                                                <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.A || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','AC',' @point.Date','@point.Direction','@point.AssetType','@ViewBag.Clusters')">

                                                    @string.Format("{0:0.00}", point.PointMachineJson.A_C_MAX)   /  @string.Format("{0:0.00}", @point.PointMachineJson.A_C_AVERAGE) (@point.PointMachineJson.A_C_CurveArea)
                                                </td>
                                            }
                                            else if (point.PointMachineJson.Combine_A_C_TIME > 0 || point.PointMachineJson.IsCombineOperation_A)
                                            {
                                                <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.A || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','AC',' @point.Date','@point.Direction','@point.AssetType','@ViewBag.Clusters')">

                                                    @string.Format("{0:0.00}", point.PointMachineJson.A_C_MAX)   /  @string.Format("{0:0.00}", @point.PointMachineJson.A_C_AVERAGE) (@point.PointMachineJson.A_C_CurveArea)


                                                    <br />
                                                    <span style="color:black !important">(Max/Avg/Time)</span> <br />
                                                    <span>
                                                        <a href="javascript:void(0)" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CC', ' @point.Date', '@point.Direction', '@point.AssetType', '@point.AssetId'); return false;">C(@point.PointMachineJson.Combine_A_C_MAX/@point.PointMachineJson.Combine_A_C_AVERAGE/@point.PointMachineJson.Combine_A_C_TIME)</a>
                                                        <br />
                                                        <a href="javascript:void(0)" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CV', ' @point.Date', '@point.Direction', '@point.AssetType', '@point.AssetId'); return false;">V(@point.PointMachineJson.Combine_A_V_MAX/@point.PointMachineJson.Combine_A_V_AVERAGE/@point.PointMachineJson.Combine_A_V_TIME)</a>
                                                    </span>


                                                </td>
                                            }
                                            else if (Model.MachineAScale == (int)E7FRSAdvance.Utility.Utility.PMScale.Scale_20)
                                            {
                                                <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.A || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','AC',' @point.Date','@point.Direction','@point.AssetType','@ViewBag.Clusters')">

                                                    @string.Format("{0:0.00}", point.PointMachineJson.A_C_MAX)   /  @string.Format("{0:0.00}", @point.PointMachineJson.A_C_AVERAGE) (@point.PointMachineJson.A_C_CurveArea)
                                                </td>
                                            }
                                            else
                                            {
                                                <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.A || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','AC',' @point.Date','@point.Direction','@point.AssetType','@ViewBag.Clusters')">

                                                    @string.Format("{0:0.00}", point.PointMachineJson.A_C_MAX)   /  @string.Format("{0:0.00}", @point.PointMachineJson.A_C_AVERAGE) (@point.PointMachineJson.A_C_CurveArea)
                                                </td>
                                            }
                                            <td onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','AV',' @point.Date','@point.Direction','@point.AssetType','@ViewBag.Clusters')">
                                                @point.PointMachineJson.A_V_AVERAGE

                                            </td>

                                            <td>
                                                <span> @point.PointMachineJson.A_C_TIME </span>
                                            </td>
                                            <td class="PMExtraColumn_@Model.Id">
                                                <span> @point.PointMachineJson.ClusterA </span>
                                            </td>
                                        }


                                        @if (Model.mPointMachineData.Where(x => x.PointMachineJson.ClusterB.StartsWith(ViewBag.Clusters)).Count() > 0)
                                        {
                                            if (Model.IsHalfPointMachine == null || (Model.IsHalfPointMachine != null && !Model.IsHalfPointMachine.Value))
                                            {
                                                if ((point.PointMachineJson.Combine_C_TIME > 0 && point.PointMachineJson.Combine_V_TIME > 0) || (point.PointMachineJson.IsCombineOperation_A && point.PointMachineJson.IsCombineOperation_B))
                                                {
                                                    <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId  != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.B || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','BC',' @point.Date','@point.Direction','@point.AssetType','@ViewBag.Clusters')">

                                                        @string.Format("{0:0.00}", point.PointMachineJson.B_C_MAX)  /  @string.Format("{0:0.00}", @point.PointMachineJson.B_C_AVERAGE) (@point.PointMachineJson.B_C_CurveArea)

                                                    </td>
                                                }
                                                else if (point.PointMachineJson.Combine_B_C_TIME > 0 || point.PointMachineJson.IsCombineOperation_B)
                                                {
                                                    <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId  != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.B || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','BC',' @point.Date','@point.Direction','@point.AssetType','@ViewBag.Clusters')">

                                                        @string.Format("{0:0.00}", point.PointMachineJson.B_C_MAX)  /  @string.Format("{0:0.00}", @point.PointMachineJson.B_C_AVERAGE) (@point.PointMachineJson.B_C_CurveArea)


                                                        <br />
                                                        <span style="color:black !important">(Max/Avg/Time)</span> <br />
                                                        <span>
                                                            <a href="javascript:void(0)" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CC', ' @point.Date', '@point.Direction', '@point.AssetType', '@point.AssetId'); return false;">C(@point.PointMachineJson.Combine_B_C_MAX/@point.PointMachineJson.Combine_B_C_AVERAGE/@point.PointMachineJson.Combine_B_C_TIME)</a>
                                                            <br />
                                                            <a href="javascript:void(0)" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)', 'CV', ' @point.Date', '@point.Direction', '@point.AssetType', '@point.AssetId'); return false;">V(@point.PointMachineJson.Combine_B_V_MAX/@point.PointMachineJson.Combine_B_V_AVERAGE/@point.PointMachineJson.Combine_B_V_TIME)</a>
                                                        </span>
                                                    </td>
                                                }
                                                else if (Model.MachineBScale == (int)E7FRSAdvance.Utility.Utility.PMScale.Scale_20)
                                                {
                                                    <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId  != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.B || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindCombineSignatureGragh('@Json.Encode(point.PointMachineJson)','BC',' @point.Date','@point.Direction','@point.AssetType','@ViewBag.Clusters')">

                                                        @string.Format("{0:0.00}", point.PointMachineJson.B_C_MAX)  /  @string.Format("{0:0.00}", @point.PointMachineJson.B_C_AVERAGE) (@point.PointMachineJson.B_C_CurveArea)

                                                    </td>
                                                }
                                                else
                                                {
                                                    <td style="cursor:pointer;color:@(Model.IsThickWave != null && Model.ThickWaveTypeId  != null && Model.IsThickWave.Value && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.B || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both) ? "#00A4E0" : "#dc8b33");" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','BC',' @point.Date','@point.Direction','@point.AssetType','@ViewBag.Clusters')">

                                                        @string.Format("{0:0.00}", point.PointMachineJson.B_C_MAX)  /  @string.Format("{0:0.00}", @point.PointMachineJson.B_C_AVERAGE) (@point.PointMachineJson.B_C_CurveArea)

                                                    </td>
                                                }

                                                <td onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','BV',' @point.Date','@point.Direction','@point.AssetType','@ViewBag.Clusters')">
                                                    @point.PointMachineJson.B_V_AVERAGE

                                                </td>
                                                <td>
                                                    @point.PointMachineJson.B_C_TIME
                                                </td>
                                                <td class="PMExtraColumn_@Model.Id">
                                                    <span> @point.PointMachineJson.ClusterB </span>
                                                </td>
                                            }

                                        }


                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
            </div>
        </div>
    </div>
</div>


<script>
</script>
