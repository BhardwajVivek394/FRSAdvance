        $('#modal-graph').modal({
            backdrop: false,
            keyboard: false
        });
        $("#modal-graph").modal("show");
        fnShowAIClusters(cluster);

    }

    function fnShowAIClusters(cluster) {
        if (cluster != null && cluster != undefined && cluster != '') {
            $.ajax({
                url: '/PointClustering/GetAIClusters',
                type: 'Post',
                data: '{cluster:"' + cluster + '"}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data != undefined && data.ImageBase64 != null && data.ImageBase64 != '') {
                        $("#imgClusterGraph").attr("src", "data:image/png;base64," + data.ImageBase64);

                        $('#modal-cluster-image-graph').modal({
                            backdrop: false,
                            keyboard: false
                        });
                        $("#modal-cluster-image-graph").modal("show");
                    }

                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }

    }

    function GetDivisionByZone(zoneId) {
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/PointClustering/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpDivision").empty();
                    $("#drpDivision").append($("<option></option>").val('0').html('Select'));
                    $.each(data, function (key, value) {
                        if ($('#hdnSearchDivisionId').val() != '0' && $('#hdnSearchDivisionId').val() == value.Id) {
                            $("#drpDivision").append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $("#drpDivision").append($("<option></option>").val(value.Id).html(value.Name));
                        }
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function GetSiteByDivisionId(divisionId) {
        if (divisionId != null && divisionId != undefined && divisionId != '') {

            $("#loader").show();
            $.ajax({
                url: '/PointClustering/GetSiteByDivisionId',
                type: 'POST',
                data: '{divisionId:' + divisionId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpSites").empty();
                    $("#drpSites").append($("<option></option>").val('0').html('Select'));
                    $.each(data, function (key, value) {
                        if ($('#hdnSearchSiteId').val() != '0' && $('#hdnSearchSiteId').val() == value.Id) {
                            $("#drpSites").append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $("#drpSites").append($("<option></option>").val(value.Id).html(value.Name));
                        }

                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }
</script>