@model Domain.SearchCriteria

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@2.9.4/dist/Chart.min.js"></script>
<script src="~/assets/js/chart/echart/echarts.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Point Clustering</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-lg-12">
                <div class="row">
                    <div class="col-xl-1">
                        <strong class="mt-4">Search</strong>
                    </div>
                    <div class="col-xl-2 col-lg-2 col-md-6">
                        <span>Type</span>
                        <select class="form-control" id="drpType">
                            <option value="ByAsset">By Asset</option>
                            <option value="ByCluster">By Cluster</option>
                        </select>
                    </div>
                    <div class="col-xl-1 col-lg-1 col-md-4">
                        <span>Zone</span>
                        @Html.DropDownListFor(x => x.ZoneId, (IEnumerable<SelectListItem>)ViewBag.Zones, "Select", new { @class = "form-control", @id = "drpZone", tabindex = 1 })
                    </div>
                    <div class="col-xl-1 col-lg-1 col-md-4">
                        <input type="hidden" id="hdnPMClusterDivisionId" value="@Model.DivisionId" />
                        <span>Division</span>
                        @Html.DropDownListFor(x => x.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, "Select", new { @class = "form-control", @id = "drpDivision", tabindex = 2 })
                    </div>
                    <div class="col-xl-2 col-lg-2 col-md-4">
                        <span>Site</span>
                        <input type="hidden" id="hdnPMClusterSiteId" value="@Model.SiteId" />
                        @Html.DropDownListFor(x => x.SiteId, (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", @id = "drpSites", tabindex = 3 })
                    </div>
                    <div class="col-xl-1 col-lg-1 col-md-6">
                        <span>From Date</span>
                        <input type="text" class="form-control" id="txtFromDate" />
                    </div>
                    <div class="col-xl-1 col-lg-1 col-md-6">
                        <span>To Date</span>
                        <input type="text" class="form-control" id="txtToDate" />
                    </div>

                    <div class="col-xl-3 col-lg-5 mt-3">
                        <a class="btn btn-success btn-quirk mt-1" onclick="fnGetPointClustering()" title="Search Point Data"><i class="fa fa-search"></i></a>
                        <a class="btn btn-info btn-quirk mt-1" onclick="fnAddCluster()" title="Add Cluster">Add Cluster</a>
                        <a class="btn btn-primary btn-quirk mt-1" onclick="fnViewCluster()" title="View Cluster">View Cluster</a>

                    </div>
                </div>
            </div>
        </div>

    </div>
    <div class="card-body">

        @using (Ajax.BeginForm("_AIClustersList", "PointClustering", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divAIClusteringList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmAIClusteringList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divAIClusteringList" style="display:none">
                @Html.Action("_AIClustersList")
            </div>
        }
        <div id="divPointClusteringList">
        </div>
        <div id="divPointMachineEventData">
        </div>

        @using (Ajax.BeginForm("Save", "PointClustering", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveAICluster",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "ClusterCategorySaved"
        }, new { id = "frmSaveAICluster" }))
        {

            <div id="divSaveAICluster">
                @Html.Partial("_AddAIClusters", new Domain.AIClusters())
            </div>
        }


    </div>

</div>
<div class="modal bounceIn animated" id="modal-graph" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-lg" style="margin-right: auto; margin-left: 5%;">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h6 class="modal-title" id="myModalLabel">
                    <span id="line1">52 2021-05-26 17:07:00 <b id="op">Normal Operation:</b></span><br />
                    <span id="line2">- A Max / Average Current: 3.8 / 2.34</span><br />
                    <span id="line3">- A Max / Average Voltage: 118.9 / 116.00</span><br />
                    <span id="line4">- A Operating Time (ms): 3300</span><br />
                    <span id="line5">B Max / Average Current: null / 0.0</span><br />
                    <span id="line6">- B Max / Average Voltage: 0 / 0.00</span><br />
                    <span id="line7">- B Operating Time (ms): 0</span><br />
                </h6>
                <button type="button" style="position:absolute;right:8px;top:8px;" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-12 mainclass" id="mainId">
                        <canvas id='basicflot' style='height: 263px'></canvas>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="modal bounceIn animated" id="modal-cluster-image-graph" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-lg" style="margin-left: auto; margin-right: 5%;">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h6 class="modal-title" id="myModalLabel">
                    <span>Cluster Image</span>

                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <img id="imgClusterGraph" />
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>


<script>
    var chart;
    $(document).ready(function () {

        $('#txtFromDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#txtToDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        }).datepicker("setDate", new Date());


        GetDivisionByZone($("#drpZone").val());

        $("#drpZone").change(function () {
            GetDivisionByZone($(this).val());

        });

        $("#drpDivision").change(function () {
            GetSiteByDivisionId($(this).val());
        });
    });

    function fnViewCluster() {
        $('#divPointClusteringList').hide();
        $('#divAIClusteringList').show();

    }

    function fnGetPointClustering() {
        $('#divPointClusteringList').show();
        $('#divAIClusteringList').hide();
        if ($('#drpType').val() == "ByCluster") {
            var mSearchCriteria = {};
            mSearchCriteria.SiteId = $('#drpSites').val();
            mSearchCriteria.StartDate = $('#txtFromDate').val();
            mSearchCriteria.EndDate = $('#txtToDate').val();
            mSearchCriteria.Type = $('#drpType').val();
            $("#loader").show();
            $.ajax({
                url: '/PointClustering/_ListByCluster',
                type: 'Post',
                contentType: 'application/json',
                data: JSON.stringify(mSearchCriteria),
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    $("#divPointClusteringList").empty().append(data);
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });

        } else if ($('#drpType').val() == "ByAsset") {
            if ($('#drpSites').val() != null && $('#drpSites').val() != undefined && $('#drpSites').val() != '') {
                var mSearchCriteria = {};
                mSearchCriteria.SiteId = $('#drpSites').val();
                mSearchCriteria.StartDate = $('#txtFromDate').val();
                mSearchCriteria.EndDate = $('#txtToDate').val();
                mSearchCriteria.Type = $('#drpType').val();
                $("#loader").show();
                $.ajax({
                    url: '/PointClustering/_List',
                    type: 'Post',
                    contentType: 'application/json',
                    data: JSON.stringify(mSearchCriteria),
                    dataType: 'html',
                    success: function (data) {
                        $("#loader").hide();
                        $("#divPointClusteringList").empty().append(data);
                    },
                    error: function (response) {
                        $("#loader").hide();
                        CommonNotification("ERROR", "Something went wrong!", "Error");
                    }
                });

            } else {
                CommonNotification("ERROR", "Please select site", "Error");
            }
        }
    

    }

    function fnShowPointMachineEventData(siteId, assetId, clusters) {
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = siteId;
        mSearchCriteria.AssetId = assetId;
        mSearchCriteria.Clusters = clusters;
        mSearchCriteria.StartDate = $('#txtFromDate').val();
        mSearchCriteria.EndDate = $('#txtToDate').val();

        $("#loader").show();
        $.ajax({
            url: '/PointClustering/_PointMachineEventData',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mSearchCriteria),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divPointMachineEventData").empty().append(data);
                $('#modal-show-PointMachineEvent').modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnAddCluster() {
        $("#loader").show();
        $.ajax({
            url: '/PointClustering/_AddAIClusters',
            type: 'Post',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divSaveAICluster").empty().append(data);
                $("#modal-add-AIClusters").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnBindSignatureGragh(data, type, datevalue, direction, name, cluster) {
        // $(".mianclass").empty().append("<canvas  id='basicflot' style='height: 263px'></canvas>")
        //  $("#basicflot").empty();
        $("div").remove(".chartjs-size-monitor");
        //$(".chartjs-size-monitor").each(function () {
        //    $(this).remove()
        //})
        var j = JSON.parse(data);
        var acg;
        var bcg;
        var avg;
        var bvg;
        if (j.A_C_AVERAGE != null) {
            acg = parseFloat(j.A_C_AVERAGE).toFixed(2);
        }
        if (j.B_C_AVERAGE != null) {
            bcg = parseFloat(j.B_C_AVERAGE).toFixed(2);
        }
        if (j.A_V_AVERAGE != null) {
            avg = parseFloat(j.A_V_AVERAGE).toFixed(2);
        }
        if (j.B_V_AVERAGE != null) {
            bvg = parseFloat(j.B_V_AVERAGE).toFixed(2);
        }

        $("#line1").empty().text(name + " " + datevalue);
        $("#op").text(direction + " Operation");
        $("#line2").empty().text("- A Max / Average Current:" + j.A_C_MAX + "/" + acg);
        $("#line3").empty().text("-  Average Voltage:" + avg);
        $("#line4").empty().text("- A Operating Time (ms):" + j.A_C_TIME);
        $("#line5").empty().text("- B Max / Average Current:" + j.B_C_MAX + "/" + bcg);
        $("#line6").empty().text("- Average Voltage:" + bvg);
        $("#line7").empty().text("- B Operating Time (ms):" + j.B_C_TIME);

        // var ctx = document.getElementById("basicflot").getContext("2d");
        var array = [];
        var labels = "";
        var total = 0;
        if (type == "CC") {
            labels = "Combine C";
            $.each(j.A_C, function (id, val) {
                if (val != null && val != undefined && val != '') {
                    var num = parseInt(val);
                    total += num;
                    array.push(val);
                }
            });

            $.each(j.B_C, function (id, val) {
                if (val != null && val != undefined && val != '') {
                    var num = parseInt(val);
                    total += num;
                    array.push(val);
                }
            });
        }

        if (type == "CV") {
            labels = "Combine V";
            $.each(j.A_V, function (id, val) {
                if (val != null && val != undefined && val != '') {
                    var num = parseInt(val);
                    total += num;
                    array.push(val);
                }
            });

            $.each(j.B_V, function (id, val) {
                if (val != null && val != undefined && val != '') {
                    var num = parseInt(val);
                    total += num;
                    array.push(val);
                }
            });
        }

        if (type == "AC") {
            labels = "A End Current";
            $.each(j.A_C, function (id, val) {
                if (val != null && val != undefined && val != '') {
                    var num = parseInt(val);
                    total += num;
                    array.push(val);
                }
            });
        }
        if (type == "BC") {
            labels = "B End Current";
            $.each(j.B_C, function (id, val) {
                if (val != null && val != undefined && val != '') {
                    var num = parseInt(val);
                    total += num;
                    array.push(val);
                }

            });
        }
        if (type == "AV") {
            labels = "A End Voltage";
            $.each(j.A_V, function (id, val) {
                if (val != null && val != undefined && val != '') {
                    var num = parseInt(val);
                    total += num;
                    array.push(val);
                }
            });
        }
        if (type == "BV") {
            labels = "B End Voltage";
            $.each(j.B_V, function (id, val) {
                if (val != null && val != undefined && val != '') {
                    var num = parseInt(val);
                    total += num;
                    array.push(val);
                }
            });
        }

        var marker = total / array.length;
        var time = j.A_C_TIME;
        var len = parseInt(j.A_C_TIME) / parseInt(1000);
        var loop = parseInt(array.length / 2) + 1;

        var label = [];

        for (var i = 0; i <= array.length; i++) {
            var xVal = (i) * (100);
            label.push(xVal);
        }

        var pieChartContent = document.getElementById('mainId');
        pieChartContent.innerHTML = '&nbsp;';
        $('#mainId').append('<canvas id="basicflot"style="height: 263px"><canvas>');

        // var canvas = document.getElementById('basicflot');
        var canvas = $("#basicflot").get(0).getContext("2d");
        // var myPieChart = new Chart(ctx).Pie(data, options);

        var newdataset = {
            label: labels,
            fill: false,
            lineTension: 0.1,
            backgroundColor: "rgba(75,192,192,0.4)",
            borderColor: "rgba(75,192,192,1)",
            borderCapStyle: 'butt',
            borderDash: [],
            borderDashOffset: 0.0,
            borderJoinStyle: 'miter',
            pointBorderColor: "rgba(75,192,192,1)",
            pointBackgroundColor: "#fff",
            pointBorderWidth: 0.5,
            pointHoverRadius: 5,
            pointHoverBackgroundColor: "rgba(75,192,192,1)",
            pointHoverBorderColor: "rgba(220,220,220,1)",
            pointHoverBorderWidth: 1,
            pointRadius: 5,
            pointHitRadius: 10,
            data: array,
            markLine: {
                data: [{
                    type: 'average',
                    name: '???'
                }]
            }
        };

        var data = {
            labels: label,
            datasets: [
                {
                    label: labels,
                    fill: false,
                    lineTension: 0.1,
                    backgroundColor: "rgba(75,192,192,0.4)",
                    borderColor: "rgba(75,192,192,1)",
                    borderCapStyle: 'butt',
                    borderDash: [],
                    borderDashOffset: 0.0,
                    borderJoinStyle: 'miter',
                    pointBorderColor: "rgba(75,192,192,1)",
                    pointBackgroundColor: "#fff",
                    pointBorderWidth: 0.5,
                    pointHoverRadius: 5,
                    pointHoverBackgroundColor: "rgba(75,192,192,1)",
                    pointHoverBorderColor: "rgba(220,220,220,1)",
                    pointHoverBorderWidth: 1,
                    pointRadius: 5,
                    pointHitRadius: 10,
                    data: array,
                    markLine: {
                        data: [{
                            type: 'average',
                            name: '???'
                        }]
                    }
                }
            ]
        };

        var option = {
            showLines: true,
            plugins: {
                zoom: {
                    pan: {
                        enabled: true,
                        mode: 'x',
                        threshold: 10
                    },
                    zoom: {
                        enabled: true,
                        mode: 'x',
                        sensitivity: -20,
                        wheel: {
                            enabled: true,
                            speed: -20
                        },
                    }
                }
            }
        };
        var myLineChart = Chart.Line(canvas, {
            data: data,
            options: option
        });


        $('#modal-graph').modal({
            backdrop: false,
            keyboard: false
        });
        $("#modal-graph").modal("show");
        fnShowAIClusters(cluster);
    }

