@model List<Domain.WorksheetMaterial>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">


            </div>
            <div class="card-body" style="padding:15px;">

                <div class="row">

                    <div class="col-12">
                        <div class="card mb-2">
                            <div class="card-body text-white" style="padding: 15px; font-size: 18px; background-color: #21596880; border-radius: 12px; ">
                                Energy 7

                                <div class="pull-right">
                                    <a href="javascript:void(0)" title="Add Material"><i class="fa fa-plus f-20" style="color:#fff;" onclick="fnAddMaterial('@E7FRSAdvance.Utility.Utility.WorksheetMaterial.E7.GetHashCode()')"></i></a>
                                    <a href="javascript:void(0)"><i class="fa fa-angle-up f-30" style="color:#fff;" onclick="fnShowMaterial('E7Material',this)"></i></a>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12 divE7Material" style="display: none; padding: 20px;">
                            @if (Model != null && Model.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th width="100"></th>
                                                <th width="100"></th>
                                                <th>
                                                    Name
                                                </th>
                                            </tr>

                                        </thead>
                                        <tbody>
                                            @foreach (var iteme7 in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.WorksheetMaterial.E7))
                                            {

                                                <tr>
                                                    <td>
                                                        <a href="javascript:void(0)" onclick="fnGetMaterial('@iteme7.Id')"><i class="fa fa-pencil"></i></a>
                                                    </td>
                                                    <td>
                                                        <a href="javascript:void(0)" onclick="fnDelete('@iteme7.Id')"><i class="fa fa-trash"></i> </a>
                                                    </td>
                                                    <td>@iteme7.Name</td>
                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>


                            }


                        </div>
                    </div>

                    <div class="col-12">
                        <div class="card mb-2">
                            <div class="card-body text-white" style="padding: 15px; font-size: 18px; background-color: #21596880; border-radius: 12px; ">
                                Railway

                                <div class="pull-right">
                                    <a href="javascript:void(0)"><i class="fa fa-plus f-20" style="color:#fff;" onclick="fnAddMaterial('@E7FRSAdvance.Utility.Utility.WorksheetMaterial.Railway.GetHashCode()')"></i></a>
                                    <a href="javascript:void(0)"><i class="fa fa-angle-up f-30" style="color:#fff;" onclick="fnShowMaterial('RailwayMaterial',this)"></i></a>
                                </div>
                            </div>
                        </div>


                        <div class="col-lg-12 divRailwayMaterial" style="display: none; padding: 20px;">
                            @if (Model != null && Model.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th width="100"></th>
                                                <th width="100"></th>
                                                <th>
                                                    Name
                                                </th>
                                            </tr>

                                        </thead>
                                        <tbody>
                                            @foreach (var itemRailway in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.WorksheetMaterial.Railway))
                                            {
                                                <tr>
                                                    <td>
                                                        <a href="javascript:void(0)" onclick="fnGetMaterial('@itemRailway.Id')"><i class="fa fa-pencil"></i></a>
                                                    </td>
                                                    <td>
                                                        <a href="javascript:void(0)" onclick="fnDelete('@itemRailway.Id')"><i class="fa fa-trash"></i> </a>
                                                    </td>
                                                    <td>@itemRailway.Name</td>
                                                </tr>
                                            }

                                        </tbody>
                                    </table>

                                </div>


                            }

                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>
</div>
<script>

    function fnShowMaterial(datetick, $this) {
        if ($($this).hasClass("fa-angle-up")) {
            $($this).removeClass("fa-angle-up").addClass("fa-angle-down");

            $('.div' + datetick).show();

        } else {
            $($this).removeClass("fa-angle-down").addClass("fa-angle-up");
            $('.div' + datetick).hide();

        }
    }


    function fnAddMaterial(typeId) {
        $("#loader").show();
        $.ajax({
            url: '/WorksheetMaterial/Add',
            type: 'Post',
            data: '{typeId:' + typeId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAddWorksheetMaterial").empty().append(data);
                $("#modal-add-worksheet-material").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }

    function fnGetMaterial(id) {
        $("#loader").show();
        $.ajax({
            url: '/WorksheetMaterial/Get',
            type: 'Post',
            data: '{id:' + id + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAddWorksheetMaterial").empty().append(data);
                $("#modal-add-worksheet-material").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }

    function fnSave() {

        if (Valid()) {
            $('#frmAddWorksheetMaterial').submit();
        }
    }

    function Valid() {
        var isValid = true;

        if ($.trim($("#Name").val()).length == 0) {
            $("#Name").next("span").html("Name is required");
            isValid = false;
        }
        else {
            $("#Name").next("span").html("");
        }

        return isValid;
    }

    function fnDelete(id) {
        if (confirm('Are you sure you want to delete this record?')) {
            $("#loader").show();
            $.ajax({
                url: '/WorksheetMaterial/Delete',
                type: 'Post',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data.type == "success") {
                        CommonNotification("SUCCESS", data.result, "success");
                        $("#frmWorksheetMaterialList").submit();
                    } else {
                        CommonNotification("ERROR", data.result, "error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }
</script>