
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Material</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">

    @using (Ajax.BeginForm("List", "WorksheetMaterial", new AjaxOptions()
    {
        HttpMethod = "POST",
        UpdateTargetId = "divWorksheetMaterialList",
        InsertionMode = InsertionMode.Replace,
        LoadingElementId = "loader"
    }, new { id = "frmWorksheetMaterialList" }))
    {
        { HtmlHelper.ClientValidationEnabled = false; }
        <div id="divWorksheetMaterialList">
            @Html.Action("List")
        </div>
    }
</div>

<div>

    @using (Ajax.BeginForm("Create", "WorksheetMaterial", new AjaxOptions()
    {
        HttpMethod = "POST",
        UpdateTargetId = "divAddWorksheetMaterial",
        InsertionMode = InsertionMode.Replace,
        LoadingElementId = "loader"
    }, new { id = "frmAddWorksheetMaterial" }))
    {
        <div id="divAddWorksheetMaterial">
            @Html.Partial("Add", new Domain.WorksheetMaterial())

        </div>
    }
</div>

