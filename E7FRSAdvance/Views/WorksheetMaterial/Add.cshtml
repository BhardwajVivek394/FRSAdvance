@model Domain.WorksheetMaterial

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-worksheet-material" tabindex="-1" aria-labelledby="modal-add-worksheet-material" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content bradius4">
            @Html.HiddenFor(m => m.Id, new { @id = "hdnAssetTypeId" })
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title"><span id="spHeader">Add Material</span></h4>
                }
                else
                {
                    <h4 class="modal-title"><span id="spHeader"> Edit Material</span></h4>
                }
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true">×</button>

            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            @Html.HiddenFor(x => x.TypeId)
                            <div class="">
                                <label class="control-label">Name <span class="text-danger">*</span></label>
                                <div class="mb-3">
                                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", tabindex = 2 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        //$("#zoneAdd").select2({ minimumResultsForSearch: Infinity, dropdownParent: $('#modal-add-division'), width: '100%' });

        if ($('#hdnSaveType').val() == 'Success') {

            CommonNotification($("#hdnSaveType").val().toUpperCase(), $("#hdnSaveMessage").val(), $("#hdnSaveType").val());

            $("[class*='modal-backdrop']").remove();
            $("#frmWorksheetMaterialList").submit();
           // window.history.pushState('', '', "Index");
        }
        else if ($('#hdnSaveType').val() == 'Error') {
            CommonNotification($("#hdnSaveType").val().toUpperCase(), $("#hdnSaveMessage").val(), $("#hdnSaveType").val());

            $("[class*='modal-backdrop']").remove();
            //window.history.pushState('', '', "Index");
        }
    });
</script>