<script>
    var mqttjson = "";
    $(document).ready(function () {

        mqttjson = @Html.Raw(Json.Encode(ViewBag.mMQTTDetail));

        fnMQTTConnectionDiscovery(mqttjson);

    });


    function fnMQTTConnectionDiscovery(mQTT) {
        //mQQTPath = $('#drpSite option:selected').attr('data-mqtt-base-path');
        let isSecure = window.location.protocol === "https:";
        client = new Paho.Client(mQTT.MQTTUri, mQTT.MQTTPort, "clientId" + Math.ceil(Math.random() * 10000));
        // set callback handlers

        client.onConnectionLost = onConnectionLost;
        client.onMessageArrived = onMessageArrivedDiscovery;

        // connect the client
        client.connect({
            onSuccess: onConnectDiscovery,
            useSSL: isSecure,
            userName: mQTT.MQTTUsername,
            password: mQTT.MQTTPassword,
            cleanSession: true
        });
    }

    function onConnectDiscovery() {
        // Once a connection has been made, make a subscription and send a message.
        var sgwId = $('#drpSiteDiscovery option:selected').attr('data-station-gatewayid');
        if (sgwId != null && sgwId != undefined && sgwId != '') {
            client.subscribe("discovery/" + sgwId + "/ENERG7");
            client.subscribe("discovery/ENERG7/" + sgwId);
            client.subscribe("cmd/ENERG7/" + sgwId);
            client.subscribe("cmd/" + sgwId + "/ENERG7");
        }

    }

    function onMessageArrivedDiscovery(message) {
        debugger;
        if (message.destinationName.includes("discovery")) {
            try {
                var parseJson = JSON.parse(message.payloadString);

               // let flat = flatten(data);


                $('#discoveryRequestJson').text(JSON.stringify(parseJson, null, 2));
                $('#discoveryRequestOnStartJson').text(JSON.stringify(parseJson, null, 2));

            } catch (e) {

            }
        } else if (message.destinationName.includes("cmd/ENERG7")) {

            try {
                var parseJson = JSON.parse(message.payloadString);
                if (parseJson != null && parseJson != undefined) {
                    if (parseJson.cmd.toUpperCase() == "IMAGE") {
                        $('#discoveryCMDImageRecvJson').text(JSON.stringify(parseJson, null, 2));
                        $('#discoveryCMDImageJson').text(JSON.stringify(parseJson, null, 2));
                    }
                    else if (parseJson.cmd.toUpperCase() == "INFO") {
                        $('#discoveryCMDInfoRecvJson').text(JSON.stringify(parseJson, null, 2));
                        $('#discoveryCMDInfoSMMSAssetJson').text(JSON.stringify(parseJson, null, 2));
                    }
                    else if (parseJson.cmd.toUpperCase() == "TIME_SYNC") {
                        $('#discoveryCMDTimeSYNCJson').text(JSON.stringify(parseJson, null, 2));
                        $('#discoveryCMDTimeSYNCAssetListJson').text(JSON.stringify(parseJson, null, 2));
                    }
                }

            } catch (e) {

            }
        } else if (message.destinationName.includes("cmd/")) {

            try {
                var parseJson = JSON.parse(message.payloadString);
                if (parseJson != null && parseJson != undefined) {


                    if (parseJson.cmd.toUpperCase() == "IMAGE") {
                        $('#discoveryCMDImageRespJson').text(JSON.stringify(parseJson, null, 2));
                        $('#discoveryCMDImageRespRecvJson').text(JSON.stringify(parseJson, null, 2));
                    }
                    else if (parseJson.cmd.toUpperCase() == "INFO") {
                        $('#discoveryCMDInfoRespJson').text(JSON.stringify(parseJson, null, 2));
                        $('#discoveryCMDInfoRespRecvJson').text(JSON.stringify(parseJson, null, 2));
                    }
                    else if (parseJson.cmd.toUpperCase() == "TIME_SYNC") {
                        $('#discoveryCMDTimeSYNCRespJson').text(JSON.stringify(parseJson, null, 2));
                        $('#discoveryCMDTimeSYNCRespRecvJson').text(JSON.stringify(parseJson, null, 2));
                    }
                }
            } catch (e) {

            }
        }


    }

    function flatten(obj, parentKey = '', result = {}) {
        for (let key in obj) {
            if (!obj.hasOwnProperty(key)) continue;

            let newKey = parentKey ? parentKey + "." + key : key;

            if (typeof obj[key] === "object" && obj[key] !== null) {
                flatten(obj[key], newKey, result);
            } else {
                result[newKey] = obj[key];
            }
        }
        return result;
    }

   // let flat = flatten(data);

   // $("#targetDiv").html("<pre>" + JSON.stringify(flat, null, 2) + "</pre>");

    function copyJson(btn, id) {
        debugger;
        var preTag = btn.parentElement.querySelector("pre");
        var textArea = document.createElement("textarea");
        textArea.value = $('#' + id).text();
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand("copy");
        document.body.removeChild(textArea);

        btn.textContent = "Copied!";
        setTimeout(function () {
            btn.textContent = "Copy";
        }, 2000);
    }
</script>