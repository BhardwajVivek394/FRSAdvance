@model Domain.RailwayAsset


@if (Model != null && Model.info != null && Model.info.Count > 0)
{
    foreach (var item in Model.info)
    {
        string section = string.Empty;
        string lbl = string.Empty;
        string make = string.Empty;
        string installationDate = string.Empty;
        string manufadate = string.Empty;
        string warrantyExDate = string.Empty;
        string LATITUDE = string.Empty;
        string LONGITUDE = string.Empty;

        if (item.additional_info != null && item.additional_info.Count > 0)
        {
            section = item.additional_info.Where(x => x.key == "sectioncode").Select(x => x.value).FirstOrDefault();
            lbl = item.additional_info.Where(x => x.key == "menulabel").Select(x => x.value).FirstOrDefault();
            make = item.additional_info.Where(x => x.key == "make").Select(x => x.value).FirstOrDefault();
            installationDate = item.additional_info.Where(x => x.key == "date_of_installation").Select(x => x.value).FirstOrDefault();
            manufadate = item.additional_info.Where(x => x.key == "date_of_manufacture").Select(x => x.value).FirstOrDefault();
            warrantyExDate = item.additional_info.Where(x => x.key == "warranty_exp_date").Select(x => x.value).FirstOrDefault();
            warrantyExDate = item.additional_info.Where(x => x.key == "latitude").Select(x => x.value).FirstOrDefault();
            warrantyExDate = item.additional_info.Where(x => x.key == "longitude").Select(x => x.value).FirstOrDefault();
        }

        <div class="col-md-4 footList">
            <h5>Asset No: @item.smms_asset_number</h5>
            <ul>
                <li>ASSET CODE: @item.smms_asset_code</li>
                <li>TYPE: @item.smms_asset_code</li>
                <li>SECTION: @(section)</li>
                <li>LABEL: @(lbl)</li>
                <li>MAKE: -@(make)</li>
                <li>INSTALLATION DATE: @(installationDate)</li>
                <li>MANUFACTURE DATE: @(manufadate)</li>
                <li>WARRANTY EXPIRY: @(warrantyExDate)</li>
                <li>LATITUDE: @(LATITUDE)</li>
                <li>LONGITUDE:  @(LONGITUDE)</li>
            </ul>
        </div>

    }
}
