
<div class="row mt-4 mb-2">
    <div class="d-md-flex gap">
        @Html.DropDownList("ZoneId", (IEnumerable<SelectListItem>)ViewBag.Zones, "Zone", new { @class = "form-select mb-2 mb-md-0 drpZone", tabindex = 1, id = "drpSMMSZone" })
        <select class="form-select mb-2 mb-md-0 drpDivision" id="drpSMMSDivision">
            @if (ViewBag.Divisions != null)
            {
                <option value="">Division</option>
                foreach (var division in ViewBag.Divisions as List<Domain.Division>)
                {
                    <option value="@division.Id" data-code="@division.DivisionCode">@division.Name</option>
                }
            }

        </select>
        <select class="form-select mb-2 mb-md-0 drpSite" id="drpSMMSSite">
            @if (ViewBag.Sites != null)
            {
                <option value="">Site</option>
                foreach (var site in ViewBag.Sites as List<Domain.Site>)
                {
                    <option value="@site.Id" data-code="@site.StationCode" data-mqtt-base-path="@site.MQTTBasePath">@site.Name</option>
                }
            }

        </select>
        @*@Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites, "Site", new { @class = "form-select mb-2 mb-md-0", id = "drpSite", tabindex = 3 })*@
        @Html.DropDownList("drpSMMSAssetType", (IEnumerable<SelectListItem>)ViewBag.AssetTypes, "Asset Type", new { @class = "form-select mb-2 mb-md-0 drpAssetType", tabindex = 4 })

        <select class="form-select mb-2 mb-md-0 drpAsset" aria-label="Default select example" id="drpSMMSSAsset">
            <option value="">Asset</option>
        </select>
        <button class="btn btn-primary w-100 w-md-auto" type="button" onclick="fnBindRequestJson()">Get Asset Telemetr</button>

    </div>
</div>

<div class="row mt-4 mb-2">
    <div class="col-12">
        <h4>Asset Data Array</h4>
    </div>
</div>

<div class="row justify-content-between">

    <div class="col-12 col-md-12 col-lg-5">
        <div class="card card-bg p-3 border-0">
            <h5>Request Json</h5>
            <div class="card-body px-2">
                <div class="code-json">
                    <pre id="requestJson" style="font-family: Consolas, monospace; font-size: 14px; color: #00a4e0; white-space: pre-wrap; background-color: #f7f8f9 "></pre>
                </div>
            </div>
        </div>
    </div>


    <div class="col-12 col-md-12 col-lg-5">

        @*<div class="progress mb-2">
                <div class="progress-bar progress-bar-striped bg-warning" role="progressbar" style="width: 75%" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
            </div>*@
        <div class="card card-bg p-3 border-0">
            <h5>Response Json</h5>
            <div class="card-body px-2">
                <div class="code-json">
                    <pre id="responseJson" style="font-family: Consolas, monospace; font-size: 14px; color: #00a4e0; white-space: pre-wrap; background-color: #f7f8f9 "></pre>

                </div>
            </div>
        </div>
    </div>


</div>