    function SendMQTTRequest() {


        $.ajax({
            url: '/AnnexureB/GetMQTTDetailList',
            type: 'POST',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();

                var mQTT = data;
                let isSecure = window.location.protocol === "https:";
                sendclient = new Paho.Client(
                    mQTT.MQTTUri,
                    Number(mQTT.MQTTPort),
                    "clientId" + Math.ceil(Math.random() * 10000)
                );

                sendclient.onConnectionLost = onConnectionLost;
                sendclient.onMessageArrived = onMessageArrived;

                sendclient.connect({
                    onSuccess: onConnectSend,
                    useSSL: isSecure,
                    userName: mQTT.MQTTUsername,
                    password: mQTT.MQTTPassword,
                    cleanSession: true
                });


            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });



    }

    function onConnectSend() {
        let jsonpayload = $('#txtCommandArea').val();
        debugger;

        // Parse into JSON
        var sgwid = $('#drpCommandSites option:selected').attr('data-station-gatewayid');
        var destination = "cmd/ENERG7/" + sgwid;
        if ($('#drpCommandType').val() == 'discovery') {
            destination = "discovery/ENERG7/" + sgwid;
        }

        var cleanedStr = jsonpayload.replace(/[""]/g, '"');
        var jsonpay = JSON.parse(cleanedStr);
       // var dsdsd = JSON.stringify(jsonpay);
        let msg = new Paho.Message(JSON.stringify(jsonpay));
        msg.destinationName = destination;
        msg.qos = 0;
        msg.retained = false;

        sendclient.send(msg);

        $('#txtCommandReceived').text(destination);
        //  $('#jsonCommandReceived').text(JSON.stringify(jsonpayload));

        debugger;
        var ssd = JSON.parse(jsonpayload);
        $('#jsonCommandReceived').html(JSON.stringify(ssd, null, 2));

        $('#txtCommandPublished').text(destination);
        $('#jsonCommandPublished').text(JSON.stringify(ssd, null, 2));
    }

