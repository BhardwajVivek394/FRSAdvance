@{
    ViewBag.Title = "Annexure B";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    .main {
        background-color: #fff;
        border: 1px solid #ccc;
        padding: 35px;
        margin: 15px;
    }


    .nav-pills .nav-link.active, .nav-pills .show > .nav-link {
        color: #fff;
        background-color: #00a4e0;
        border: none;
    }

    .nav-link {
        color: #272727;
        border: none;
        background-color: white;
    }

        .nav-link:focus, .nav-link:hover {
            color: #00a4e0;
        }


    .btn-primary {
        color: #fff;
        background-color: #00a4e0;
        border-color: #00a4e0;
        white-space: nowrap;
    }

        .btn-primary:hover {
            color: #fff;
            background-color: #028ec1;
            border-color: #028ec1;
        }

    .gap {
        gap: 8px;
    }


    .card-bg {
        background-color: #f7f8f9;
        border-radius: 10px;
    }


    .gray-bg {
        background-color: #edf0fa;
        border-radius: 20px;
        padding: 20px;
    }

    .card-bg-blue {
        background-color: #6686ff;
        border-radius: 10px;
    }

        .card-bg-blue h5 {
            color: #fff;
        }

        .card-bg-blue .card-body code {
            color: #fff !important;
        }

    .card-bg-gray {
        background-color: #d6defd;
        border-radius: 10px;
    }


        .card-bg-gray h5 {
            color: #010d14;
        }

        .card-bg-gray .card-body code {
            color: #090909 !important;
        }

    .w-200 {
        width: 200px;
    }


    .card-header-bg {
        background-color: transparent;
        border-color: #d7d7d7;
        padding: .8rem 1rem;
    }


        .card-header-bg h1 {
            font-size: 1.2rem;
        }


    .code-json code {
        font-size: 12px;
        color: #00a4e0;
    }

    .card-header {
        border-bottom: 1px solid rgba(0, 0, 0, .125);
    }


    .asset-section {
        background-color: #f7f8f9;
        border-radius: 10px;
        padding: 20px;
    }

    .footList ul {
        padding-left: 0px;
    }

        .footList ul li {
            list-style: none;
            font-size: 14px;
            color: #272727;
        }


    .grid-container {
        display: grid;
        grid-template-columns: 1fr 1fr; /* do equal columns */
        gap: 20px;
        box-sizing: border-box;
    }

    .left {
        padding: 20px;
        border-radius: 10px;
        width: 100%;
    }

    .right {
        padding: 20px;
        border-radius: 10px;
        width: 100%;
        margin-left: auto;
    }

    .grid-container .gray-acco .accordion-button {
        background-color: #edf0fa;
        box-shadow: none;
        padding: 5px;
        color: #101010;
        font-weight: 500;
    }


    .grid-container .green-acco .accordion-button {
        background-color: #edfaed;
        box-shadow: none;
        padding: 5px;
        color: #101010;
        font-weight: 500;
    }

    .grid-container .gray-acco .accordion-body {
        background-color: #edf0fa;
    }

    .grid-container .green-acco .accordion-body {
        background-color: #edfaed;
    }


    .grid-container .accordion-item {
        border: none;
    }


    .bg-gray {
        background-color: #edf0fa;
    }

    .bg-light-green {
        background-color: #edfaed;
    }

    .bg-light-gray {
        background-color: #edf0fa;
    }

    .grid-container .accordion-button {
        font-size: 25px;
    }

        .grid-container .accordion-button img {
            width: 65px;
        }

    .seeMore a {
        font-size: 14px;
        color: #272727;
    }


    .grid-container .accordion-body code, .modal-body code {
        color: #4e4e4e;
    }


    /* Move the icon to the left */
    .left-iocn-style .accordion-button {
        display: flex;
        justify-content: flex-end; /* pushes text to the right */
        text-align: right;
    }

        /* Swap icon position */
        .left-iocn-style .accordion-button::after {
            order: -1; /* move icon before text */
            margin-right: auto; /* push icon to the left */
            margin-left: 1rem; /* add spacing between icon and text */
        }

    .accordion-button:not(.collapsed)::before {
        background-image: url(/images/arrow.svg);
        transform: rotate(0deg);
    }

    .accordion-button:not(.collapsed)::after {
        background-image: url(/images/arrow.svg);
        transform: rotate(0deg);
    }

    .icon-rotate {
        transform: rotate(180deg);
    }

    .left-list .list-group {
        border-radius: 0;
    }

        .left-list .list-group .list-group-item {
            border: none;
            margin-bottom: 10px;
            border-radius: 8px;
            background-color: #51c2d6;
            color: #fff;
        }



    .left-list .text-muted {
        color: #fff !important;
        font-size: 12px;
    }

    .left-list .list-group-item.active {
        z-index: 2;
        color: #fff;
        background-color: #00a4e0;
        border-color: #00a4e0;
    }
</style>
