<script>
    var json = "";
    var responseDatajson = null;
    var client = null;
    var mQQTPath = "";
    var channels = [];
    var mQTT = null;
    var sendclient = null;

    $(document).on("change", ".drpZone", function () {
        GetDivisionByZone($(this).val());
    });

    $(document).on("change", ".drpDivision", function () {
        GetSiteByDivisionId($(this).val());
    });

    $(document).on("change", ".drpSite", function () {

        debugger;
        var selectedValue = $(this).val();
        $('.drpSite').val(selectedValue);

        BindAssetDropdown();

        fnBindDiscovery($('#drpSiteDiscovery'));

        fnBindParameter();
    });

    $(document).on("change", ".drpAssetType", function () {

        BindAssetDropdown();
    });

    $(document).ready(function () {
        fnChangeSMMSType($('#ssmsType'));
    });

    function fnMQTTConnection(mQTT) {
        mQQTPath = $('#drpSMMSSite option:selected').attr('data-mqtt-base-path');
        let isSecure = window.location.protocol === "https:";
        client = new Paho.Client(mQTT.MQTTUri, mQTT.MQTTPort, "clientId" + Math.ceil(Math.random() * 10000));
        // set callback handlers

        client.onConnectionLost = onConnectionLost;
        client.onMessageArrived = onMessageArrived;

        // connect the client
        client.connect({
            onSuccess: onConnect,
            useSSL: isSecure,
            userName: mQTT.MQTTUsername,
            password: mQTT.MQTTPassword,
            cleanSession: true
        });
    }

    function onConnect() {
        // Once a connection has been made, make a subscription and send a message.

        client.subscribe(mQQTPath + 'channel1');

    }

    // called when the client loses its connection
    function onConnectionLost(responseObject) {
        if (responseObject.errorCode !== 0) {
            console.log("onConnectionLost:" + responseObject.errorMessage);
            //location.reload();
        }
        client.connect({
            onSuccess: onConnect,
            userName: "wattmon",
            password: "wattmon_2018",
            cleanSession: true
        });
    }

    // called when a message arrives
    function onMessageArrived(message) {

        if (message.payloadString.includes("roles") && message.payloadString.includes("ts")) {
            var parseJson = JSON.parse(message.payloadString);
            if (parseJson != null && parseJson != undefined && parseJson != '') {
                var array = parseJson['roles'];
                var tsarray = parseJson['ts'];
                if (array != null && array != undefined && array.length > 0) {
                    fnBindData(message.destinationName, array, tsarray);
                }
            }
        }
        else {
            var channeldata = message.payloadString.split(',');
            fnBindData(message.destinationName, channeldata);
        }

    }

    function fnGetUnique26() {

        const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
        let result = '';
        const array = new Uint8Array(26);
        crypto.getRandomValues(array);
        array.forEach(num => result += chars[num % chars.length]);
        return result;
    }

    function fnBindRequestJson() {
        debugger;
        var siteId = $('#drpSMMSSite').val();
        var assetId = $('#drpSMMSSAsset').val();
        if (siteId != null && siteId != undefined && siteId != '' && assetId != null && assetId != undefined && assetId != '') {
            $("#loader").show();
            $.ajax({
                url: '/AnnexureB/GetAssetData',
                type: 'POST',
                data: '{siteId:' + siteId + ',assetId:' + assetId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    responseDatajson = data;
                    var strprid = [];
                    if (data != null && data.Parameters != null) {
                        $(data.Parameters).each(function (d, val) {
                            strprid.push(val.Prid);
                        });
                    }

                    // packet
                    const packet = {
                        rqi: fnGetUnique26(),
                        vcc: "XYZ",
                        zc: $('#drpSMMSZone option:selected').text(),
                        dc: $('#drpSMMSDivision option:selected').attr('data-code'),
                        sc: $('#drpSMMSSite option:selected').attr('data-code'),
                        smms_asset_code: data.SmmsAssetCode,
                        prid: strprid
                    };

                    $('#requestJson').text(JSON.stringify(packet, null, 2));


                    fnBindResponseJson(data);


                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        } else {
            CommonNotification("ERROR", "Select site and asset", "Error");
        }
    }

    function fnGetMqttData() {
        debugger;
        $.ajax({
            url: '/AnnexureB/GetMQTTDetailList',
            type: 'POST',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();

                fnMQTTConnection(data);

            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnBindResponseJson(data) {
        const resi = fnGetUnique26();
        const vcc = "XYZ";
        const zc = $('#drpSMMSZone option:selected').text();
        const dc = $('#drpSMMSDivision option:selected').attr('data-code');
        const sc = $('#drpSMMSSite option:selected').attr('data-code');

        // Example telemetry data
        const smmsAssetCode = data.SmmsAssetCode;
        const parameters = [];

        if (data != null && data.Parameters != null) {
            $(data.Parameters).each(function (d, val) {

                var parm = {};
                parm.prid = val.Prid;
                parm.prv = "";
                parm.prt = "";

                parameters.push(parm);
            });
        }

        const packet = {
            resi: resi,
            vcc: vcc,
            zc: zc,
            dc: dc,
            sc: sc,
            telemetry_data: [
                {
                    smms_asset_code: smmsAssetCode,
                    parameters: parameters
                }
            ]
        };

        $('#responseJson').text(JSON.stringify(packet, null, 2));

        fnGetMqttData();
        fnGetAssetById();
    }

    function GetDivisionByZone(zoneId) {
        debugger;
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/AnnexureB/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $(".drpDivision").empty();
                    $(".drpDivision").append($("<option></option>").val('0').html('Divison'));
                    $.each(data, function (key, value) {
                        $(".drpDivision").append($("<option></option>").val(value.Id).html(value.Name).attr("data-code", value.DivisionCode));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }

    function BindAssetDropdown() {
        if ($("#drpSMMSSite").val() != null && $("#drpSMMSSite").val() != undefined && $("#drpSMMSSite").val() != '' && $("#drpSMMSSite").val() != '0' && $("#drpSMMSAssetType").val() != null && $("#drpSMMSAssetType").val() != undefined && $("#drpSMMSAssetType").val() != '' && $("#drpSMMSAssetType").val() != '0') {

            $("#loader").show();
            $.ajax({
                url: '/AnnexureB/GetAssestBy',
                type: 'POST',
                data: '{siteId:' + $("#drpSMMSSite").val() + ',assetTypeId:' + $("#drpSMMSAssetType").val() + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $(".drpAsset").empty();
                    $(".drpAsset").append($("<option></option>").val('0').html('Asset'));
                    $.each(data, function (key, value) {
                        $(".drpAsset").append($("<option></option>").val(value.Id).html(value.Name).attr("data-railwayassetcode", value.RailwayAssetcode));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            //  CommonNotification("ERROR", "Please select site and asset type", "Error");
        }

    }

    function GetSiteByDivisionId(divisionId) {
        if (divisionId != null && divisionId != undefined && divisionId != '') {
            $("#loader").show();
            $.ajax({
                url: '/AnnexureB/GetSiteByDivisionId',
                type: 'POST',
                data: '{divisionId:' + divisionId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $(".drpSite").empty();
                    $(".drpSite").append($("<option></option>").val('0').html('Select'));
                    $.each(data, function (key, value) {
                        $(".drpSite").append($("<option></option>").val(value.Id).html(value.Name).attr("data-code", value.StationCode).attr("data-mqtt-base-path", value.MQTTBasePath).attr("data-station-gatewayid", value.StationGatewayId));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function fnBindData(basePath, data, tsarray, roletsArray) {

        var assetId = $('.drpAsset').val();
        var item = json;
        if (item.Id == assetId && responseDatajson != null) {

            const resi = fnGetUnique26();
            const vcc = "XYZ";
            const zc = $('.drpZone option:selected').text();
            const dc = $('.drpDivision option:selected').attr('data-code');
            const sc = $('.drpSite option:selected').attr('data-code');

            // Example telemetry data

            if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                const parameters = [];

                if (responseDatajson != null && responseDatajson.Parameters != null) {
                    $(responseDatajson.Parameters).each(function (d, val) {
                        var livevalue = 0;
                        var liveTimestamp = '';

                        const inItem = item.assetAttributes.filter(alert => alert.Id == val.AttributeId)[0];
                        var str1 = basePath.toLowerCase();
                        if (inItem.AssetInfoChannel != null) {
                            var str2 = inItem.AssetInfoChannel.toLowerCase();
                            if (str1.indexOf(str2) != -1) {

                                var infoValue = inItem.AssetInfoValue;
                                var infoMultiplication = inItem.Multiplication;
                                if (infoValue != null && infoMultiplication != null && infoMultiplication != undefined) {
                                    var dataValue = data[infoValue];
                                    var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                    livevalue = (Math.round(mainData * 100) / 100).toFixed(1);

                                    if (tsarray != null && tsarray != undefined && tsarray.length > 0) {
                                        var dVal = tsarray[infoValue];

                                        var currentDate = new Date();
                                        var dateObj = new Date(dVal * 1000);

                                        let dt = new Date(fnConvertUTCDate(dateObj));
                                        liveTimestamp = FormatCustom(dt);
                                        // var mqttDate = new Date(fullDate);


                                    }
                                }
                            }
                        }


                        var parm = {};
                        parm.prid = val.Prid;
                        parm.prv = livevalue;
                        parm.prt = liveTimestamp;
                        parameters.push(parm);
                    });
                }

                const smmsAssetCode = responseDatajson.SmmsAssetCode;

                const packet = {
                    resi: resi,
                    vcc: vcc,
                    zc: zc,
                    dc: dc,
                    sc: sc,
                    telemetry_data: [
                        {
                            smms_asset_code: smmsAssetCode,
                            parameters: parameters
                        }
                    ]
                };

                $('#responseJson').text(JSON.stringify(packet, null, 2));
            }
        }
    }

