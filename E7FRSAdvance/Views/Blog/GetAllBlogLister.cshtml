@model Domain.BlogLister

<head>
    @*<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
        <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.3/jquery.min.js"></script>
        <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>*@
</head>
<style>
    #cardBlog:hover {
        box-shadow: 2px 2px 15px 2px #c3a5ead9;
    }
</style>
<div class="container-fluid">
    <div class="row">
        @if (Model.Blogs != null)
        {
            foreach (var items in Model.Blogs)
            {
                int i = 0;
                <div class="col-xl-6">
                    <div class="card" id="cardBlog" style="height:700px;width:700px;">
                        <div class="card-header">
                            <div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel">

                                <!-- Indicators -->
                                <ol class="carousel-indicators">
                                    @foreach (var blogImage in items.BlogImages)
                                    {
                                        var IstItem = items.BlogImages.First();

                                        if (blogImage.Equals(IstItem))
                                        {
                                            <li data-target="#carouselExampleIndicators" data-slide-to="@i" class="active"></li>
                                        }
                                        else
                                        {
                                            <li data-target="#carouselExampleIndicators" data-slide-to="@i"></li>

                                        }
                                        i++;
                                    }

                                </ol>

                                <!-- Wrapper for slides -->
                                <div class="carousel-inner">

                                    @foreach (var blogImage in items.BlogImages)
                                    {
                                        var IstItem = items.BlogImages.First();

                                        if (blogImage.Equals(IstItem))
                                        {
                                            <div class="carousel-item active">
                                                <img src="@blogImage.ImagePath" alt="Image" style="height: 500px; width: 700px;">
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="carousel-item">
                                                <img src="@blogImage.ImagePath" alt="Image" style="height: 500px; width: 700px">
                                            </div>
                                        }

                                    }

                                </div>

                                @*Left and right controls*@
                                @*<button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                </button>*@
                            </div>
                        </div>

                        <div class="card-body" style="height: 100px; width: 700px;">
                            <div class="people-options clearfix">
                                <div class="text-center">
                                    <h6><i>@items.Title</i><b></b></h6>
                                </div>
                                <div class="text-left">
                                    <h6>@items.Description</h6>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer" style="height:50px; width: 700px;">
                            <div>
                                <div class="pull-left">
                                    <i class="icofont icofont-heart-alt" style="color:red"></i>
                                </div>
                                <div class="pull-right">
                                    <i class="icofont icofont-ui-chat" style="color:blue"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

    </div>
</div>

