@model Domain.Asset

@if (Model != null && Model.assetAttributes != null && Model.assetAttributes.Count > 0)
{
    <table class="table">
        <tr>
            <th>Site</th>
            <th>Date</th>
            <th>Asset Type</th>
            <th>Asset</th>
            @foreach (var assetAttribute in Model.assetAttributes)
            {
                <th>@assetAttribute.Title</th>
            }
        </tr>
        @if (Model.siteAttributeDatasList != null)
        {
            int counter = 0;
            foreach (var row in Model.DateList)
            {

                <tr>
                    <td>@Model.SiteName</td>
                    <td>@row</td>
                    <td>@Model.AssetTypeName</td>
                    <td>@Model.AssetName</td>
                    @foreach (var assetAttribute in Model.assetAttributes)
                    {
                        <td> @assetAttribute.Data[counter]</td>
                    }
                </tr>
                counter++;
            }
        }

    </table>


}
