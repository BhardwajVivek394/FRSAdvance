                //if (val.AcknowledgemenTimeStamp != null) {

                //}
                //if (val.AcknowledgemenStatusId == acktrue) {
                //    lbl += '<td>True</td>';
                //}
                //else if (val.AcknowledgemenStatusId == ackfalse) {
                //    lbl += '<td>False</td>';
