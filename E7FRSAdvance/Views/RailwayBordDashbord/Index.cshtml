                    </div>

                    <!-- Input and Button -->
                    <div class="d-flex mt-4">
                        <input type="text" class="ask-box" placeholder="Ask anything...">
                        <button class="custom-btn ms-2">Accussy inks</button>
                    </div>
                </div>
