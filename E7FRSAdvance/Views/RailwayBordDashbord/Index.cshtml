<div class="container-fluid">
    <div class="row">
        <div class="col-xxl-3 col-xl-6 col-md-12 box-col-6 widget-grid">
            <div class="card  background-container">
                <div class="card-header card-no-border">
                    <h5>Asset Count + Health Status</h5>
                </div>
                <div class="card-body pt-1">
                    <div id="asset-health-count" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            <div class="carousel-item active text-center">
                                <div class="row">
                                    <div class="col-12">
                                        <div id="predictive-assettype" style="max-height:500px"></div>
                                    </div>
                                    <div class="col-12 text-left">
                                        <h6>Predictive</h6>
                                    </div>
                                    <div class="col-12 mt-1">
                                        <div class="row">
                                            <div class="col-1"></div>
                                            <div class="col-6">
                                                <div class="legend-label"><div class="legend-box" style="background-color: #0c457d;"></div> Point: </div>
                                                <div class="legend-label"><div class="legend-box" style="background-color: #0ea7b5;"></div> Signal: </div>
                                                <div class="legend-label"><div class="legend-box" style="background-color: #e8702a;"></div> Track: </div>

                                            </div>
                                            <div class="col-4">
                                                <div class="legend-label"><h5 id="spnPointPredictiveAssetHealth"></h5></div>
                                                <div class="legend-label"><h5 id="spnSignalPredictiveAssetHealth"></h5></div>
                                                <div class="legend-label"><h5 id="spnTrackPredictiveAssetHealth"></h5></div>
                                            </div>
                                            <div class="col-1"></div>
                                        </div>
                                    </div>
                                </div>



                            </div>
                            <div class="carousel-item text-center">
                                <div class="row">


                                    <div class="col-12">
                                        <div id="fail-assettype" style="max-height:500px"></div>
                                    </div>
                                    <div class="col-12">
                                        <h6>Fail</h6>
                                    </div>
                                    <div class="col-12 mt-1">
                                        <div class="row">
                                            <div class="col-1"></div>
                                            <div class="col-6">
                                                <div class="legend-label"><div class="legend-box" style="background-color: #0c457d;"></div> Point: </div>
                                                <div class="legend-label"><div class="legend-box" style="background-color: #0ea7b5;"></div> Signal: </div>
                                                <div class="legend-label"><div class="legend-box" style="background-color: #e8702a;"></div> Track: </div>

                                            </div>
                                            <div class="col-4">
                                                <div class="legend-label"><h5 id="spnPointFailAssetHealth"></h5></div>
                                                <div class="legend-label"><h5 id="spnSignalFailAssetHealth"></h5></div>
                                                <div class="legend-label"><h5 id="spnTrackFailAssetHealth"></h5></div>
                                            </div>
                                            <div class="col-1"></div>
                                        </div>
                                    </div>
                                </div>



                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xxl-3 col-xl-6 col-md-12 box-col-12 widget-grid">
            <div class="card height-equal">
                <div class="card-header card-no-border">
                    <div class="header-top">
                        <h5>Accuracy & Performance</h5>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-xl-12 text-center">
                            <div id="accuracyPerformancePiechart" style="max-height:500px"></div>
                        </div>
                    </div>

                    <div class="mt-4 small-text">
                        <div id="divAccuracyPerformance">
                        </div>
                        <div class="dot-line"></div>
                        <div class="text-muted small mt-2">S 35 failure predicted 2 hours before field detection</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xxl-6 col-xl-12 col-md-12 box-col-12 widget-grid">
            <div class="card height-equal">
                <div class="card-header card-no-border" style="padding-right:20px !important">
                    <div class="row">
                        <div class="col-8">
                            <h5 class="m-0">Current Alert Count & Type</h5>
                        </div>
                        @*<div class="col-3">
                            <h6 id="lblTypeAlertCountType" class="mt-2 p-r-10" style="text-align:right">Active</h6>
                        </div>
                        <div class="col-1">
                            <div class="form-check form-switch">
                                <input type="checkbox" id="switchAlertCountType" class="form-check-input f-24" onchange="fnChangeAlertMode(this)" checked />
                            </div>
                        </div>*@
                    </div>
                    <div class="header-top">


                    </div>
                </div>
                <div class="card-body pt-0">
                    <div class="row text-center mb-4">
                        <!-- Predictive -->
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">Predictive</h6>
                            <div class="d-flex justify-content-around">
                                <a href="javascript:void(0)" class="bg-dark text-white rounded px-predictive py-2" onclick="fnGetAssetAlertCount('@E7FRSAdvance.Utility.Utility.AssetType.TRACK.GetHashCode()','@E7FRSAdvance.Utility.Utility.AlertType.Predictive.GetHashCode()')">
                                    <div>Track</div>
                                    <div class="fw-bold fs-5">
                                        <span class="highlight-green" id="spnCurrentTrackPredictiveAlert">0</span>
                                    </div>
                                </a>
                                <a href="javascript:void(0)" class="bg-dark text-white rounded px-predictive py-2" onclick="fnGetAssetAlertCount('@E7FRSAdvance.Utility.Utility.AssetType.SIGNAL.GetHashCode()','@E7FRSAdvance.Utility.Utility.AlertType.Predictive.GetHashCode()')">
                                    <div>Signal</div>
                                    <div class="fw-bold fs-5">
                                        <span class="highlight-green" id="spnCurrentSignalPredictiveAlert">0</span>
                                    </div>
                                </a>
                                <a href="javascript:void(0)" class="bg-dark text-white rounded px-predictive py-2" onclick="fnGetAssetAlertCount('@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()','@E7FRSAdvance.Utility.Utility.AlertType.Predictive.GetHashCode()')">
                                    <div>Point</div>
                                    <div class="fw-bold fs-5">
                                        <span class="highlight-green" id="spnCurrentPointPredictiveAlert">0</span>
                                    </div>
                                </a>
                            </div>
                        </div>

                        <!-- Fail -->
                        <div class="col-md-6">
                            <h6 class="text-muted mb-2">Fail</h6>
                            <div class="d-flex justify-content-around">
                                <a href="javascript:void(0)" class="bg-dark text-white rounded px-fail py-2" onclick="fnGetAssetAlertCount('@E7FRSAdvance.Utility.Utility.AssetType.TRACK.GetHashCode()','@E7FRSAdvance.Utility.Utility.AlertType.Failure.GetHashCode()')">
                                    <div>Track</div>
                                    <div class="fw-bold fs-5">
                                        <span class="highlight-green" id="spnCurrentTrackFailAlert">0</span>
                                    </div>
                                </a>
                                <a href="javascript:void(0)" class="bg-dark text-white rounded px-fail py-2" onclick="fnGetAssetAlertCount('@E7FRSAdvance.Utility.Utility.AssetType.SIGNAL.GetHashCode()','@E7FRSAdvance.Utility.Utility.AlertType.Failure.GetHashCode()')">
                                    <div>Signal</div>
                                    <div class="fw-bold fs-5">
                                        <span class="highlight-green" id="spnCurrentSignalFailAlert">0</span>
                                    </div>
                                </a>
                                <a href="javascript:void(0)" class="bg-dark text-white rounded px-fail py-2" onclick="fnGetAssetAlertCount('@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()','@E7FRSAdvance.Utility.Utility.AlertType.Failure.GetHashCode()')">
                                    <div>Point</div>
                                    <div class="fw-bold fs-5">
                                        <span class="highlight-green" id="spnCurrentPointFailAlert">0</span>
                                    </div>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Table -->
                    <div class="table-responsive">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Division</th>
                                    <th>Station</th>
                                    <th>Cause Code</th>
                                    <th>Message</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyCurrentAlertList">
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xxl-3 col-xl-6 col-md-12 box-col-6 widget-grid">
            <div class="card">
                <div class="card-header card-no-border">
                    <div class="header-top">
                        <h5 class="m-0">Energy7 Intelligence</h5>
                        <div class="card-header-right-icon">
                            <a class="f-light d-flex align-items-center" href="javascript:void(0)" onclick="fnShowChatModel()"><i class="f-w-700 fa fa-expand"></i></a>
                        </div>
                    </div>
                </div>
                <div class="card-body pt-4">
                    <div id="div-chat-bind">
                        <div class="chat-message bot">
                            <div class="avatar">
                                <img src="~/assets/images/E7 AI.png" />
                            </div>
                            <div class="message">Hi @E7FRSAdvance.Utility.ClsHttpContent.LoginUser.FirstName👋 <br /> I’m E7 AI, your assistant for rail insights. <br /> Ask me anything...</div>
                        </div>
                    </div>
                    <div class="input-group">
                        <input type="text" class="form-control" id="txtChatMessage" placeholder="Ask anything..." />
                        <span class="input-group-text" id="btnChatMessage">
                            <i class="fa fa-location-arrow"></i>
                        </span>
                    </div>
                </div>

            </div>
        </div>
        <div class="col-xxl-9 col-xl-6 col-md-12 box-col-6 widget-grid">
            <div class="card">
                <div class="card-header card-no-border">
                    <div class="header-top">
                        <h5 class="m-0">ANOMALY DETECTION</h5>
                        <div class="card-header-right-icon">
                        </div>
                    </div>
                </div>
                <div class="card-body pt-0">


                    <div id="anomaly-detection-bar" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <div id="anomaly-detection-bar-track"></div>
                            </div>
                            <div class="carousel-item">
                                <div id="anomaly-detection-bar-signal"></div>
                            </div>
                            <div class="carousel-item">
                                <div id="anomaly-detection-bar-point"></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-xxl-3 col-xl-6 col-lg-6 box-col-6 widget-grid">
            <div class="card">
                <div class="card-header card-no-border">
                    <h5>MIS Section</h5>
                </div>
                <div class="card-body pt-2">
                    <div class="download-row">
                        <div><i class="bi bi-check-circle me-2 text-success"></i> Track Circuit Layout - East Division</div>
                        <button class="gradient-btn">Download</button>
                    </div>

                    <div class="download-row">
                        <div><i class="bi bi-check-circle me-2 text-success"></i> Signal Wiring Diagram - S123</div>
                        <button class="gradient-btn">Download</button>
                    </div>

                    <div class="download-row">
                        <div><i class="bi bi-check-circle me-2 text-success"></i> Signal Wiring Diagram - S123</div>
                        <button class="gradient-btn">Download</button>
                    </div>

                    <!-- Final large download button -->
                    <button class="gradient-btn gradient-btn-large">Download</button>
                </div>
            </div>
        </div>

        <div class="col-xxl-3 col-xl-6 col-lg-6 box-col-6 widget-grid">
            <div class="card height-equal">
                <div class="card-header card-no-border">
                    <div class="header-top">
                        <h5>Links</h5>
                    </div>
                </div>
                <div class="card-body pt-2">
                    <div class="row g-3">
                        <div class="col-4">
                            <div class="link-card">
                                <i class="fa-regular fa fa-file"></i>
                                <div>Assets Report</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="link-card link-card-analytics">
                                <i class="fa-solid fa fa-bar-chart"></i>
                                <div>Analytics</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="link-card">
                                <i class="fa-solid fa fa-cog"></i>
                                <div>Maintenance Log</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="link-card">
                                <i class="fa-regular fa fa-file-pdf-o"></i>
                                <div>PDF Viewer</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="link-card">
                                <i class="fa-solid fa fa-line-chart"></i>
                                <div>Trend</div>
