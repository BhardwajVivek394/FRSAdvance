        </div>

        <div class="col-xxl-3 col-xl-6 col-lg-6 box-col-6 widget-grid">
            <div class="card height-equal" style="min-height: 452.344px;">
                <div class="card-header card-no-border ">
                    <div class="header-top">
                        <h5 class="m-0">User History</h5>
                        <div class="card-header-right-icon">
                        </div>
                    </div>
                </div>
                <div class="card-body pt-0">
                    <div id="donut-color-chart-morris-user-history"></div>
                </div>
            </div>
        </div>

        <div class="col-xxl-3 col-xl-6 col-lg-6 box-col-6 widget-grid">
            <div class="appointment">
                <div class="card">
                    <div class="card-header card-no-border">
                        <div class="header-top">
                            <h5 class="m-0">RTU Status</h5>
                            <div class="card-header-right-icon">
                            </div>
                        </div>
                    </div>
                    <div class="card-body pt-0">
                        <div class="status-card">
                            <!-- Icon & Count -->
                            <div class="mb-2">
                                <i class="bi bi-display fs-3 text-secondary"></i>
                            </div>
                            <h2 class="fw-bold mb-3">68</h2>

