    function fnBindAlert() {
        $.ajax({
            url: '/RailwayBordDashbord/GetMessageList',
            type: 'POST',
            contentType: 'application/json',
            async: false,
            success: function (data) {
                var txt = '';
                if (data != null && data.length > 0) {
                    $(data).each(function (d, val) {
                        if (val.MessageType == 'Question') {
                            txt += '<div class="chat-message user"><div class="avatar" style="background-color:#00b7ff"><img src="/assets/images/profile-circle.png"/></div><div class="message">' + val.Message + '</div></div>';

                        } else {
                            txt += '<div class="chat-message bot"><div class="avatar"><img src="/assets/images/E7 AI.png"/></div><div class="message">' + val.Message + '<br />';
                            if (val.Files != null && val.Files.length > 0) {
                                $(val.Files).each(function (v, file) {
                                    txt += '<a href="/RailwayBordDashbord/GetPDFDownload?fileName=' + file.Name + '&filePath=' + file.Path + '&fileType=' + file.Type + '">' + file.Name + '</a>';

                                });
                            }
                            txt += '</div></div>';
                        }

                    });

                }

                $('#div-chat-bind').empty().append(txt);

                $('#div-chat-bind').animate({
                    scrollTop: $('#div-chat-bind')[0].scrollHeight
                }, 300);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
