                    colors: [
                        CubaAdminConfig.primary,
                        CubaAdminConfig.secondary,
                        "#f8d62b",
                        "#51bb25",
                    ],
                    formatter: function (a) {
                        return a + "";
                    },
                });

            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnBindUserHistory() {

        var mUserLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#drpSite').val();
        mSearchCriteria.ZoneId = $('#drpDivisionZones').val();
        mSearchCriteria.DivisionId = $('#drpDivisions').val();
        mUserLister.SearchCriteria = mSearchCriteria;

        $.ajax({
            url: '/RailwayBordDashbord/GetUserHistory',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(mUserLister),
            success: function (data) {

                var responseuserhistory = [];
                var colors = [];
                if (data != null && data.length > 0) {

                    const alertsPredictiveGre = data.filter(alert => alert.Duration > 10).length;

                    const alertsPredictiveLess = data.filter(alert => alert.Duration < 10).length;

                    const alertsPredictiveZero = data.filter(alert => alert.Duration <= 0).length;

                    var count = parseInt(alertsPredictiveGre);
                    var lbl1 = {};
                    lbl1.value = count
                    lbl1.label = 'Greter10';
                    responseuserhistory.push(lbl1);
                    colors.push(fnGetDarkColor());

                    var count = parseInt(alertsPredictiveLess);
                    var lbl2 = {};
                    lbl2.value = count
                    lbl2.label = 'Less10';
                    responseuserhistory.push(lbl2);
                    colors.push(fnGetDarkColor());

                    var lbl3 = {};
                    lbl3.value = parseInt(alertsPredictiveZero)
                    lbl3.label = 'Zero';
                    responseuserhistory.push(lbl3);
                    colors.push(fnGetDarkColor());


                }


                Morris.Donut({
                    element: "donut-color-chart-morris-user-history",
                    data: responseuserhistory,
                    backgroundColor: "transparent",
                    labelColor: "#d2615c",
                    colors: [
                        "#2c6b6b",
                        "#f5a623",
                        "#d2615c",
                        "#0d1530",
                    ],
                    formatter: function (a) {
                        return a + "";
                    },
                });
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });



    }

    function fnBindAnomalyCluster(mFRSAlerts) {

        var trackCategories = [];
        var trackvalues = [];

        var signalCategories = [];
        var signalvalues = [];

        var pointCategories = [];
        var pointvalues = [];

        if (mFRSAlerts != null && mFRSAlerts != undefined && mFRSAlerts.length > 0) {


            // Group by AssetTypeId
            const criticalAlertsT = mFRSAlerts.filter(alert => alert.AssetTypeId == trackAssetType);
            if (criticalAlertsT != null && criticalAlertsT != undefined && criticalAlertsT.length > 0) {
                $("#anomaly-detection-bar-track").empty();
                const groupedAlerts = criticalAlertsT.reduce((acc, alert) => {
                    const key = alert.CauseCode;
                    if (!acc[key]) {
                        acc[key] = [];
                    }
                    acc[key].push(alert);
                    return acc;
                }, {});

                $.each(groupedAlerts, function (key, val) {
                    trackCategories.push(key);
                    trackvalues.push(val.length);
                });


                var optionsTrack = {
                    chart: {
                        height: 350,
                        type: "bar",
                        toolbar: {
                            show: false,
                        },
                    },
                    plotOptions: {
                        bar: {
                            horizontal: true,
                        },
                    },
                    dataLabels: {
                        enabled: false,
                    },
                    series: [
                        {
                            name: "Count",
                            data: trackvalues,
                        },
                    ],
                    xaxis: {
                        categories: trackCategories,
                    },
                    colors: [
                        "#5bc0eb",
                    ],
                };
                var trackchart = new ApexCharts(document.querySelector("#anomaly-detection-bar-track"), optionsTrack);
                trackchart.render();
            }

            const criticalAlertsS = mFRSAlerts.filter(alert => alert.AssetTypeId == signalAssetType);
            if (criticalAlertsS != null && criticalAlertsS != undefined && criticalAlertsS.length > 0) {
                const groupedSignalAlerts = criticalAlertsS.reduce((acc, alert) => {
                    const key = alert.CauseCode;
