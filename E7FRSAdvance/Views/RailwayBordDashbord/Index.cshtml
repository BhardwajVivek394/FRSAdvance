
@{
    ViewBag.Title = "RDPMS Dashbord";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="~/assets/js/chart/morris-chart/morris.js"></script>
<script src="~/assets/js/chart/morris-chart/raphael.js"></script>
<script src="~/assets/js/chart/apex-chart/apex-chart.js"></script>
<script src="~/assets/js/chart/apex-chart/stock-prices.js"></script>
<script src="~/assets/js/chart/apex-chart/moment.min.js"></script>
<style>
    .clockpicker-popover {
        position: absolute;
        z-index: 1050;
    }

    #flot-categories {
        width: 100%;
        height: 400px; /* Make sure this is not 0 */
    }

    .widget-grid {
        margin-top: 10px !important;
        margin-bottom: 10px !important;
    }

    .card {
        flex: 1 1 300px;
        display: flex;
        flex-direction: column;
        height: 100%; /* Ensures it expands */
    }

    .card-title {
        font-size: 1.1rem;
        font-weight: bold;
    }

    .highlight-green {
        color: #24B46B;
        font-weight: bold;
        font-size: 24px;
    }

    .highlight-red {
        color: #E05252;
        font-weight: bold;
    }

    .small-box {
        border: 1px solid #ddd;
        border-radius: 10px;
        padding: 5px 10px;
        /* margin: 5px;*/
        text-align: center;
    }

    .table td, .table th {
        vertical-align: middle;
    }

    .badge-box {
        background-color: #D9F2E6;
        padding: 5px 10px;
        border-radius: 8px;
        font-weight: bold;
    }

    .mis-section {
        max-width: 400px;
        border: 1px solid #ccc;
        border-radius: 15px;
        padding: 20px;
        font-size: 0.95rem;
    }

    .download-row {
        border: 1px solid #ddd;
        border-radius: 12px;
        padding: 12px 15px;
        margin-bottom: 12px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .gradient-btn {
        background: linear-gradient(to right, #9B4DFF, #DB2CEA);
        color: white;
        border: none;
        border-radius: 8px;
        padding: 5px 12px;
        font-size: 0.8rem;
    }

    .gradient-btn-large {
        width: 100%;
        font-size: 1.1rem;
        font-weight: bold;
        margin-top: 15px;
        padding: 10px;
        border-radius: 10px;
    }

    .text-dark-blue {
        color: #1E1E3F;
        font-weight: 500;
    }

    .status-card {
        border: none;
        border-radius: 12px;
        padding: 20px;
        text-align: center;
        font-size: 0.9rem;
    }

    .progress-bar-pink {
        background-color: #D44BFF;
    }

    .progress-bar-cyan {
        background-color: #00CFFF;
    }

    .status-label {
        font-size: 0.75rem;
        color: #888;
        text-transform: uppercase;
    }

    .status-value {
        font-weight: bold;
        font-size: 1rem;
    }

    .dot {
        height: 10px;
        width: 10px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 6px;
    }

    .dot-blue {
        background-color: #1C7ED6;
    }

    .dot-orange {
        background-color: #FFA500;
    }

    .circle-chart {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: conic-gradient(#b180ff 0% 92.5%, #eee 92.5% 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: bold;
        color: #3a3a3a;
        margin: 0 auto;
    }

    .chart-box {
        height: 100px;
        background: #f8f9fa;
        border-radius: 6px;
    }

    .small-text {
        font-size: 13px;
    }

    .dot-line {
        border-bottom: 1px dashed #aaa;
        margin: 6px 0;
    }

    .chat-message {
        display: flex;
        padding: 12px 0px;
        align-items: flex-start;
    }

        .chat-message .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: #092c3f;
            color: white;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            background-repeat: no-repeat;
        }



        .chat-message .message {
            padding: 12px 16px;
            border-radius: 12px;
            max-width: 70%;
            font-size: 14px;
        }

        .chat-message.bot .message {
            background-color: #062b43;
            color: white;
        }

        .chat-message.user {
            justify-content: flex-end;
        }

            .chat-message.user .avatar {
                order: 2;
                margin-left: 12px;
                margin-right: 0;
            }

            .chat-message.user .message {
                background-color: #00b7ff;
                color: white;
            }

    .chat-input {
        display: flex;
        padding: 12px;
        border-top: 1px solid #ccc;
        background-color: #fff;
    }

        .chat-input input {
            flex: 1;
            padding: 10px 14px;
            border: 1px solid #ccc;
            border-radius: 20px 0 0 20px;
            outline: none;
            font-size: 14px;
        }

    #div-chat-bind {
        height: 300px;
        overflow-y: auto;
    }

    .px-predictive {
        height: 85px !important;
        width: 110px !important;
        background: #082F45 !important;
    }

    .px-fail {
        height: 85px !important;
        width: 110px !important;
        background: #215968 !important;
    }

    .legend-label {
        display: flex;
        align-items: center;
        margin-bottom: 6px;
        font-size: medium;
    }

    .legend-box {
        width: 12px;
        height: 12px;
        margin-right: 8px;
    }

    .form-switch .form-check-input:checked {
        background-color: #37C46B !important;
        border-color: #37C46B !important;
    }

    .form-switch .form-check-input:focus {
        box-shadow: none !important;
    }


    .tablemodalFixHead {
        overflow: auto;
        height: 70vh;
    }

        .tablemodalFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }

    .link-card {
        background-color: #f8f9fa;
        border-radius: 12px;
        padding: 15px;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .link-card:hover {
            background-color: #e9ecef;
        }

        .link-card i {
            font-size: 30px;
            margin-bottom: 10px;
        }

    .ask-box {
        border: 1px solid #ccc;
        border-radius: 8px;
        padding: 8px 12px;
        flex: 1;
    }

    .custom-btn {
        border: 1px solid red;
        color: red;
        background: none;
        border-radius: 8px;
        padding: 8px 12px;
    }

        .custom-btn:hover {
            background-color: red;
            color: white;
        }
</style>


<div class="container-fluid pt-5">
    <div class="card">
        <div class="row g-2 mb-3 mt-3 m-l-10">
            <div class="row">
                <div class="col-xl-2">
                    @Html.DropDownList("drpDivisionZones", ViewBag.Zones as SelectList, "All", new { @class = "form-control" })
                </div>
                <div class="col-xl-2">
                    @Html.DropDownList("drpDivisions", ViewBag.Divisions as SelectList, "All", new { @class = "form-control" })
                </div>
                <div class="col-xl-2">
                    @Html.DropDownList("drpSite", (IEnumerable<SelectListItem>)ViewBag.Sites, "All", new { @class = "form-control" })

                </div>
                <div class="col-xl-2">
                    <button type="button" class="btn btn-success" onclick="fnSearchAllGraph()">Search</button>
                </div>
            </div>
        </div>
    </div>
</div>
