    function fnBindAssetAndAlertCount(mFRSAlerts, assetData) {

        var responsepredictive = [];
        var responsefail = [];

        var totalPointPredictiveAlerts = 0;
        var totalPointFailAlerts = 0;
        var totalPointAssets = 0;

        var totalSignalPredictiveAlerts = 0;
        var totalSignalFailAlerts = 0;
        var totalSignalAssets = 0;

        var totalTrackPredictiveAlerts = 0;
        var totalTrackFailAlerts = 0;
        var totalTrackAssets = 0;

        if (assetData != null && assetData != undefined && assetData.length > 0) {
            totalPointAssets = assetData.find(asset => asset.AssetTypeId == pointAssetType)?.Count || 0;
        }
        const alertsPredictiveP = mFRSAlerts.filter(alert => alert.AssetTypeId == pointAssetType && alert.AlertTypeId == alertPredictive);
        const countByAssetPointPredictive = alertsPredictiveP.reduce((acc, alert) => {
            acc[alert.AssetId] = (acc[alert.AssetId] || 0) + 1;
            return acc;
        }, {});
        $.each(countByAssetPointPredictive, function () {
            totalPointPredictiveAlerts++;
        });
        var lbl = {};
        lbl.value = totalPointPredictiveAlerts;
        lbl.label = 'Point';
        lbl.AssetCount = totalPointAssets;
        responsepredictive.push(lbl);
        $('#spnPointPredictiveAssetHealth').text(totalPointPredictiveAlerts + "/" + totalPointAssets);

        const alertsFailP = mFRSAlerts.filter(alert => alert.AssetTypeId == pointAssetType && alert.AlertTypeId == alertFail);
        if (alertsFailP != null && alertsFailP != undefined) {
            const countByPointAssetFail = alertsFailP.reduce((acc, alert) => {
                acc[alert.AssetId] = (acc[alert.AssetId] || 0) + 1;
                return acc;
            }, {});
            $.each(countByPointAssetFail, function () {
                totalPointFailAlerts++;
            });

            var lbl = {};
            lbl.value = totalPointFailAlerts;
            lbl.label = 'Point'
            lbl.AssetCount = totalPointAssets;
            responsefail.push(lbl);
            $('#spnPointFailAssetHealth').text(totalPointFailAlerts + "/" + totalPointAssets);
        }




        if (assetData != null && assetData != undefined && assetData.length > 0) {

            totalSignalAssets = assetData.find(asset => asset.AssetTypeId == signalAssetType)?.Count || 0;
        }
        const alertsPredictiveS = mFRSAlerts.filter(alert => alert.AssetTypeId == signalAssetType && alert.AlertTypeId == alertPredictive);
        const countBySignalAssetPredictive = alertsPredictiveS.reduce((acc, alert) => {
            acc[alert.AssetId] = (acc[alert.AssetId] || 0) + 1;
            return acc;
        }, {});
        $.each(countBySignalAssetPredictive, function () {
            totalSignalPredictiveAlerts++;
        });
        var lbl = {};
        lbl.value = totalSignalPredictiveAlerts++;
        lbl.label = 'Signal';
        lbl.AssetCount = totalSignalAssets;
        responsepredictive.push(lbl);
        $('#spnSignalPredictiveAssetHealth').text(totalSignalPredictiveAlerts + "/" + totalSignalAssets);


        const alertsFailS = mFRSAlerts.filter(alert => alert.AssetTypeId == signalAssetType && alert.AlertTypeId == alertFail);
        if (alertsFailS != null && alertsFailS != undefined) {
            const countBySignalAssetFail = alertsFailS.reduce((acc, alert) => {
                acc[alert.AssetId] = (acc[alert.AssetId] || 0) + 1;
                return acc;
            }, {});
            $.each(countBySignalAssetFail, function () {
                totalSignalFailAlerts++;
            });
            var lbl = {};
            lbl.value = totalSignalFailAlerts;
            lbl.label = 'Signal'
            lbl.AssetCount = totalSignalAssets;
            responsefail.push(lbl);
            $('#spnSignalFailAssetHealth').text(totalSignalFailAlerts + "/" + totalSignalAssets);
        }



        if (assetData != null && assetData != undefined && assetData.length > 0) {

            totalTrackAssets = assetData.find(asset => asset.AssetTypeId == trackAssetType)?.Count || 0;
        }
        const alertsPredictiveT = mFRSAlerts.filter(alert => alert.AssetTypeId == trackAssetType && alert.AlertTypeId == alertPredictive);
        const countByTrackAssetPredictive = alertsPredictiveT.reduce((acc, alert) => {
            acc[alert.AssetId] = (acc[alert.AssetId] || 0) + 1;
            return acc;
        }, {});
        $.each(countByTrackAssetPredictive, function () {
            totalTrackPredictiveAlerts++;
        });
        var lbl = {};
        lbl.value = totalTrackPredictiveAlerts++;
        lbl.label = 'Track';
        lbl.AssetCount = totalTrackAssets;
        responsepredictive.push(lbl);
        $('#spnTrackPredictiveAssetHealth').text(totalTrackPredictiveAlerts + "/" + totalTrackAssets);

        const alertsFailT = mFRSAlerts.filter(alert => alert.AssetTypeId == trackAssetType && alert.AlertTypeId == alertFail);
        if (alertsFailT != null && alertsFailT != undefined) {
            const countByTrackAssetFail = alertsFailT.reduce((acc, alert) => {
                acc[alert.AssetId] = (acc[alert.AssetId] || 0) + 1;
                return acc;
            }, {});
            $.each(countByTrackAssetFail, function () {
                totalTrackFailAlerts++;
            });
            var lbl = {};
            lbl.value = totalTrackFailAlerts;
            lbl.label = 'Track'
            lbl.AssetCount = totalTrackAssets;
            responsefail.push(lbl);
            $('#spnTrackFailAssetHealth').text(totalTrackFailAlerts + "/" + totalTrackAssets);
        }


        $("#predictive-assettype").empty();
        $("#fail-assettype").empty();

        $('#asset-health-count').on('slid.bs.carousel', function (e) {
            if ($('#predictive-assettype').is(':visible') && $('#predictive-assettype').children().length === 0) {

                Morris.Donut({
                    element: "predictive-assettype",
                    data: responsepredictive,
                    backgroundColor: "transparent",
                    labelColor: "#0d1530",
                    colors: [
                        "#0C457D",
                        "#0EA7B5",
                        "#E8702A",
                    ],
                    formatter: function (value, data) {
                        return value + '/' + data.AssetCount;
                    },
                });

            }

            if ($('#fail-assettype').is(':visible') && $('#fail-assettype').children().length === 0) {

                Morris.Donut({
                    element: "fail-assettype",
                    data: responsefail,
                    backgroundColor: "transparent",
                    labelColor: "#0d1530",
                    colors: [
                        "#0C457D",
                        "#0EA7B5",
                        "#E8702A",
                    ],
                    formatter: function (value, data) {
                        return value + '/' + data.AssetCount;
                    }
                });

            }
        });
    }

    function fnBindAccuracyPerformanceCount(mFRSAlerts) {
        var seriesArray = [];
        var lblArray = [];
        var lblstr = '';
        if (mFRSAlerts != null && mFRSAlerts != undefined) {
            lblstr += '<div class="row mb-1">';

            const alertackT = mFRSAlerts.filter(alert => alert.AcknowledgemenStatusId == acktrue);
            if (alertackT != null) {
                seriesArray.push(alertackT.length);
                lblArray.push("True");

                lblstr += '<div class="col-6 text-muted">True</div>';
                lblstr += '<div class="col-6 text-end fw-bold">' + alertackT.length + '</div>';
            }

            const alertackF = mFRSAlerts.filter(alert => alert.AcknowledgemenStatusId == ackfalse);
            if (alertackF != null) {
                seriesArray.push(alertackF.length);
                lblArray.push("False");

                lblstr += '<div class="col-6 text-muted">False</div>';
                lblstr += '<div class="col-6 text-end fw-bold">' + alertackF.length + '</div>';
            }

            const alermaintenace = mFRSAlerts.filter(alert => alert.AcknowledgemenStatusId == ackmaintenace);
            if (alermaintenace != null) {
                seriesArray.push(alermaintenace.length);
                lblArray.push("Maintenace");

                lblstr += '<div class="col-6 text-muted">Maintenace</div>';
                lblstr += '<div class="col-6 text-end fw-bold">' + alermaintenace.length + '</div>';
            }
            lblstr += '</div>';
        }

        $('#divAccuracyPerformance').empty().append(lblstr);


        var options8 = {
            chart: {
                width: 325,
                type: "pie",
                events: {
                    dataPointSelection: function (event, chartContext, config) {
                        var label = options8.labels[config.dataPointIndex];
                        var value = options8.series[config.dataPointIndex];
                        fnGetFRSAcknowledgementAlert(label);
                    }
                }
            },
            labels: lblArray,
            series: seriesArray,
            responsive: [
                {
                    breakpoint: 480,
                    options: {
                        chart: {
                            width: 200,
                        },
                        legend: {
                            show: false,
                        },
                    },
                },
            ],
            legend: {
                show: false,
            },
            colors: [
                "#8A38F5",
                "#29A3DF",
                "#00cfff",
            ],
        };

        var chart8 = new ApexCharts(document.querySelector("#accuracyPerformancePiechart"), options8);

        chart8.render();
    }

    function fnGetAssetAlertCount(assetTypeId, alertTypeId) {
        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#drpSite').val();
        mSearchCriteria.ZoneId = $('#drpDivisionZones').val();
        mSearchCriteria.DivisionId = $('#drpDivisions').val();
        mSearchCriteria.AssetTypeId = assetTypeId;
        mSearchCriteria.AlertTypeId = alertTypeId;
        mSearchCriteria.AlertStatus = 2;

        mAssetLister.SearchCriteria = mSearchCriteria;
        $("#loader").show();
        $.ajax({
            url: '/RailwayBordDashbord/_FRSAlert',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divAssetAlertCount").empty().append(data);
                $("#modalFRSAlert").modal('show');
            },
            error: function (response) {
                //CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });

    }

    function fnGetFRSAcknowledgementAlert(AcknowledgemenStatus) {
        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#drpSite').val();
        mSearchCriteria.ZoneId = $('#drpDivisionZones').val();
        mSearchCriteria.DivisionId = $('#drpDivisions').val();
        if (AcknowledgemenStatus == 'Maintenace') {
            mSearchCriteria.AcknowledgemenStatusId = 4;
        }
        if (AcknowledgemenStatus == 'True') {
            mSearchCriteria.AcknowledgemenStatusId = 2;
        }
        if (AcknowledgemenStatus == 'False') {
            mSearchCriteria.AcknowledgemenStatusId = 3;
        }

        mAssetLister.SearchCriteria = mSearchCriteria;

        $.ajax({
            url: '/RailwayBordDashbord/_FRSAcknowledgementAlert',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divAssetAlertCount").empty().append(data);
                $("#modalFRSAlert").modal('show');
            },
            error: function (response) {
                //CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });

    }

    function BindListAlerts() {
        $.ajax({
            url: '/RailwayBordDashbord/GetListAlerts',
            type: 'POST',
            contentType: 'application/json',
            success: function (data) {
                var response = [];
                if (data.Status == "success") {
                    $.each(JSON.parse(data.Record), function (key, val) {
                        var lbl = {};
                        lbl.value = val.Count
                        lbl.label = val.AssetType
                        response.push(lbl);
                    });
                }

                Morris.Donut({
                    element: "flotd-categories",
                    data: response,
                    backgroundColor: "rgba(68, 102, 242, 0.5)",
