                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function fnGetDarkColor() {
        var allowed = "ABCDEF0123456789", S = "#";

        while (S.length < 7) {
            S += allowed.charAt(Math.floor((Math.random() * 16) + 1));
        }
        return S;
    }

    function fnChangeAlertMode($this) {

        if ($($this).is(":checked")) {
            $('#lblTypeAlertCountType').text('Active');
        } else {
            $('#lblTypeAlertCountType').text('InActive');
        }

    }
