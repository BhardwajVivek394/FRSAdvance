                            show: false,
                        },
                    },
                    plotOptions: {
                        bar: {
                            horizontal: true,
                        },
                    },
                    dataLabels: {
                        enabled: false,
                    },
                    series: [
                        {
                            name: "Count",
                            data: signalvalues,
                        },
                    ],
                    xaxis: {
                        categories: signalCategories,
                    },
                    colors: ["#c177b1"],
                };
                var signalchart = new ApexCharts(document.querySelector("#anomaly-detection-bar-signal"), optionsSignal);
                signalchart.render();
            }


            const criticalAlertsP = mFRSAlerts.filter(alert => alert.AssetTypeId == pointAssetType);
            if (criticalAlertsP != null && criticalAlertsP != undefined && criticalAlertsP.length > 0) {
                const groupedPointAlerts = criticalAlertsP.reduce((acc, alert) => {
                    const key = alert.CauseCode;
                    if (!acc[key]) {
                        acc[key] = [];
                    }
                    acc[key].push(alert);
                    return acc;
                }, {});

                $.each(groupedPointAlerts, function (key, val) {
                    pointCategories.push(key);
                    pointvalues.push(val.length);
                });

                $("#anomaly-detection-bar-point").empty();
                var optionsPoint = {
                    chart: {
                        height: 350,
                        type: "bar",
                        toolbar: {
                            show: false,
                        },
                    },
                    plotOptions: {
                        bar: {
                            horizontal: true,
                        },
                    },
                    dataLabels: {
                        enabled: false,
                    },
                    series: [
                        {
                            name: "Count",
                            data: pointvalues,
                        },
                    ],
                    xaxis: {
                        categories: pointCategories,
                    },
                    colors: ["#f5a623"],
                };
                var pointchart = new ApexCharts(document.querySelector("#anomaly-detection-bar-point"), optionsPoint);
