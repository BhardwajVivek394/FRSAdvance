@model Domain.FRSAlertLister

<div class="modal bounceIn animated" id="modalFRSAlert" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">FRS Alert</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">
                    <div class="col-12">
                        <div class="table-responsive tablemodalFixHead">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th style="background-color: #215968; color: white;">Site Name</th>
                                        <th style="background-color: #215968; color: white;">Asset Type</th>
                                        <th style="background-color: #215968; color: white;">Asset Name</th>
                                        <th style="background-color: #215968; color: white;">Incidence Date</th>
                                        <th style="background-color: #215968; color: white;">Cause Code</th>
                                        <th style="background-color: #215968; color: white;">Alert Message</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.mFRSAlerts)
                                    {
                                        <tr>
                                            <td>@item.SiteName</td>
                                            <td>@item.AssetType</td>
                                            <td>@item.AssetName</td>
                                            <td>@item.SetTimeStamp</td>
                                            <td>@item.CauseCode</td>
                                            <td>@item.SetAlertMessage</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

