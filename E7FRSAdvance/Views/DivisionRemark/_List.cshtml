@model Domain.DivisionRemarkLister

@Html.HiddenFor(m => m.SearchCriteria.ColumnName, new { id = "hdnColumnName" })
@Html.HiddenFor(m => m.SearchCriteria.SortDirection, new { id = "hdnSortDirection" })

<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />

<div class="container-fluid">
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <div class="people-options clearfix">
                        <div class="row">
                            <div class="col-md-2">
                                <a class="btn btn-primary btn-quirk" onclick="GetById(0)">Add Division Remark</a>
                            </div>
                            <div class="col-md-2">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Zone</strong>
                                @Html.DropDownListFor(m => m.SearchCriteria.ZoneId, (IEnumerable<SelectListItem>)ViewBag.Zones, new { @class = "form-control", id = "SearchZone", tabindex = 1 })
                            </div>
                            <div class="col-md-2">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Division</strong>
                                @Html.DropDownListFor(m => m.SearchCriteria.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, new { @class = "form-control", id = "SearchDivision", tabindex = 1 })
                            </div>
                            <div class="col-md-6">
                                <div class="btn-group pull-right people-pager">
                                    @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
                                    @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
                                </div>

                                <div class="btn-group pull-right">

                                    <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left "></i></button>
                                    <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>

                                </div>
                                @{
                                    int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
                                    if (Model.DivisionRemarks.Count == 0)
                                    {
                                        start = 0;
                                    }
                                    decimal end = Math.Floor(Model.Pager.TotalRecord);
                                    if (Model.Pager.PageSize < Model.Pager.TotalRecord)
                                    {
                                        if (Model.Pager.PageSize == -1)
                                        {
                                            end = Model.Pager.TotalRecord;
                                        }
                                        else
                                        {
                                            end = Model.Pager.PageSize * Model.Pager.CurrentPage;
                                            if (end > Model.Pager.TotalRecord)
                                            {
                                                end = Model.Pager.TotalRecord;
                                            }
                                        }
                                    }
                                }
                                <span class="people-count pull-right" style="margin-top:10px;">Showing <strong>@start - @Math.Floor(end)</strong> of <strong>@Math.Floor(Model.Pager.TotalRecord)</strong> Division Remarks</span>
                            </div>
                        </div>


                    </div>
                </div>
                <div class="col-12">
                    <div class="card-body " style="padding:15px;">
                        <div class="table-responsive" style="max-height: 620px;">
                            <table class="table">
                                <thead class="bg-primary">
                                    <tr>
                                        <th colspan="2" class="text-center">Action</th>
                                        <th data-sortcolumn="Name" class="sorting" id="thName" onclick="SortList('Name');">Division Name</th>
                                        <th data-sortcolumn="Name" class="sorting" id="thName" onclick="SortList('Name');">Site Name</th>
                                        <th data-sortcolumn="Name" class="sorting" id="thName">Asset Type</th>
                                        <th data-sortcolumn="AssetName" class="sorting" id="thAssetName" onclick="SortList('AssetName');">Asset Name</th>
                                        <th data-sortcolumn="Cause" class="sorting" id="thCause" onclick="SortList('Cause');">Cause</th>
                                        <th data-sortcolumn="OperationType" class="sorting" id="thOperationType" onclick="SortList('OperationType');">Operation Type</th>
                                        <th data-sortcolumn="Remark" class="sorting" id="thRemark" onclick="SortList('Remark');">Remark</th>
                                        <th data-sortcolumn="IsActive" class="sorting" id="thIsActive" onclick="SortList('IsActive');" style="width:100px">Active?</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.DivisionRemarks != null && Model.DivisionRemarks.Count > 0)
                                    {
                                        foreach (var item in Model.DivisionRemarks)
                                        {
                                            <tr class="table-light">
                                                <td class="text-center" style="width:50px;">
                                                    <a title="Edit">
                                                        <i class="text-vision fa fa-edit" onclick="GetById('@item.Id')"></i>
                                                    </a>
                                                </td>
                                                <td class="text-center " style="width:50px;">
                                                    <a title="Delete">
                                                        <i class="text-danger fa fa-trash" onclick="fnDelete('@item.Id')"></i>
                                                    </a>
                                                </td>
                                                <td>@item.DivisionName</td>
                                                <td>@item.SiteName</td>
                                                <td>@item.AssetType</td>
                                                <td>@item.AssetName</td>
                                                <td>@item.CauseCode</td>
                                                <td>
                                                    @if (item.OperationTypeId == (int)E7FRSAdvance.Utility.Utility.OperationType.Exclude)
                                                    {
                                                        <span data-bs-toggle="popover" data-bs-content="@item.CreatedDate.ToString()" data-bs-placement="right">@E7FRSAdvance.Utility.Utility.OperationType.Exclude.ToString()</span>
                                                    }
                                                    else if (item.OperationTypeId == (int)E7FRSAdvance.Utility.Utility.OperationType.Include)
                                                    {
                                                        <span>@E7FRSAdvance.Utility.Utility.OperationType.Include.ToString()</span>
                                                    }
                                                    else if (item.OperationTypeId == (int)E7FRSAdvance.Utility.Utility.OperationType.IncludeApp)
                                                    {
                                                        <span>@E7FRSAdvance.Utility.Utility.OperationType.IncludeApp.ToString()</span>
                                                    }
                                                    else if (item.OperationTypeId == (int)E7FRSAdvance.Utility.Utility.OperationType.ExcludeApp)
                                                    {
                                                        <span>@E7FRSAdvance.Utility.Utility.OperationType.ExcludeApp.ToString()</span>
                                                    }
                                                </td>
                                                <td>@item.Remark</td>
                                                <td class="">
                                                    @if (item.IsActive)
                                                    {
                                                        <span class="span badge rounded-pill pill-badge-success">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="span badge rounded-pill pill-badge-yellow">In Active</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="9" class="text-center">
                                                No record found
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@*<script src="@Url.Content("~/Content/PageJS/Learning/LearningList.js")"></script>*@

<script>
    $(document).ready(function () {
        $("[data-bs-toggle='popover']").popover();

        $('#drpPageSize').change(function (e) {
            $("#hdnSkip").val('0');
            $("#frmDivisionRemarkList").submit();
        });

        $('#SearchDivision').change(function (e) {
            $("#hdnSkip").val('0');
            $("#frmDivisionRemarkList").submit();
        });

        $("#SearchZone").change(function () {
            GetDivisionByZone($(this).val());
        });
    });

    function fnDelete(id) {
        if (confirm('Are you sure you want to delete this record?')) {
            $("#loader").show();
            $.ajax({
                url: '/DivisionRemark/Delete',
                type: 'Post',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            $("#frmDivisionRemarkList").submit();
                            CommonNotification("SUCCESS", data.result, "success");
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
    }

    function GetDivisionByZone(zoneId) {
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/Site/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#SearchDivision").empty();
                    $("#SearchDivision").append($("<option></option>").val('0').html('Select Divison'));
                    $.each(data, function (key, value) {
                        //if ($('#hdnSearchDivisionId').val() != '0' && $('#hdnSearchDivisionId').val() == value.Id) {
                        //    $("#SearchDivision").append($("<option selected></option>").val(value.Id).html(value.Name));
                        //} else {
                        //    $("#SearchDivision").append($("<option></option>").val(value.Id).html(value.Name));
                        //}
                        $("#SearchDivision").append($("<option></option>").val(value.Id).html(value.Name));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }
    function GetById(id) {
        $("#loader").show();
        $.ajax({
            url: '/DivisionRemark/_Add',
            type: 'Post',
            data: '{id:' + id + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divSaveDivisionRemark").empty().append(data);
                $("#modal-add-division-remark").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmDivisionRemarkList").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize)
            {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmDivisionRemarkList").submit();
            }
        }
    }
</script>

