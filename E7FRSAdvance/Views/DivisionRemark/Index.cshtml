@model Domain.DivisionRemark
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Division Remark</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="">
    <div class="">
        @using (Ajax.BeginForm("List", "DivisionRemark", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divDivisionRemarkList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmDivisionRemarkList" }))
        {
            <div id="divDivisionRemarkList">
                @Html.Action("List")
            </div>
        }

        @using (Ajax.BeginForm("Save", "DivisionRemark", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveDivisionRemark",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmSaveDivisionRemark" }))
        {
            <div id="divSaveDivisionRemark">
                @Html.Partial("_Add", new Domain.DivisionRemark())
            </div>
        }

    </div>
</div>

