@model Domain.DivisionRemark

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal fade" id="modal-add-division-remark" role="dialog" aria-labelledby="modal-add-division-remark" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            @Html.HiddenFor(m => Model.Id)
            @Html.HiddenFor(m => Model.ImageBase64, new { @id = "hdnImageBase64" })
            @if (Model.AssetId != null)
            {
                <input type="hidden" value="@Model.AssetId.Value" id="hdnAssetId" />
            }

            <input type="hidden" value="@Model.SiteId" id="hdnSiteId" />
            <input type="hidden" value="@Model.AlertInfoId" id="hdnAlertInfoId" />
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Division Remark</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Edit Division Remark</span></h4>
                }
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="form-group mb-3">
                                <strong>Divisions</strong>
                                @Html.DropDownListFor(m => m.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, new { @class = "form-control", tabindex = 1 })
                                <span class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3">
                                <strong>Sites</strong>
                                @Html.DropDownListFor(m => m.SiteId, (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 2 })
                                <span class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3">
                                <strong>Asset Type</strong>
                                @Html.DropDownListFor(m => m.AssetTypeId, (IEnumerable<SelectListItem>)ViewBag.AssetTypes, "Select", new { @class = "form-control", tabindex = 3 })
                                <span class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3">
                                <strong>Asset</strong>
                                <select id="AssetId" name="AssetId" class="form-control" tabindex="4">
                                    <option value="0">Select</option>
                                </select>
                                <span class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3">
                                <strong>Cause</strong>
                                <select class="form-control" id="AlertInfoId" name="AlertInfoId"></select>
                                <span class="text-danger"></span>
                            </div>
                            <div class="form-group mb-3">
                                @Html.RadioButtonFor(x => x.IsActive, "True")<strong>Active</strong>
                                @Html.RadioButtonFor(x => x.IsActive, "False")<strong>In Active</strong>
                            </div>
                            <div class="form-group mb-3">
                                <strong>Operation Type</strong>
                                @Html.DropDownListFor(x => x.OperationTypeId, ViewBag.OperationType as SelectList, "Select", new { @class = "form-control", tabindex = 6 })
                                <span class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <strong>Remark</strong>
                                @Html.TextAreaFor(x => x.Remark, new { @class = "form-control", tabindex = 7 })

                            </div>
                            <div class="form-group mb-3 divUploadPMImage" style="display:none">
                                <strong>Upload Image</strong>
                                <input type="file" id="UploadImg" name="UploadImg" accept="image/*" class="form-control" onchange="fnUploadImageFile(this)">
                            </div>
                            <div class="col-sm-12" id="divImage">
                                @if (!string.IsNullOrEmpty(Model.ImageBase64))
                                {
                                    <img height="100" width="100" src="data:image/png;base64,@Model.ImageBase64" />
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSaveDivisionRemark()">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {

        if ($('#hdnSaveType').val() == 'Success') {

            CommonNotification($("#hdnSaveType").val().toUpperCase(), $("#hdnSaveMessage").val(), $("#hdnSaveType").val());

            $("[class*='modal-backdrop']").remove();
            $("#frmDivisionRemarkList").submit();
            window.history.pushState('', '', "Index");
        }
        else if ($('#hdnSaveType').val() == 'Error') {
            CommonNotification($("#hdnSaveType").val().toUpperCase(), $("#hdnSaveMessage").val(), $("#hdnSaveType").val());

            $("[class*='modal-backdrop']").remove();
            window.history.pushState('', '', "Index");
        }

        BindAssetType();
        GetSiteByDivision($("#DivisionId").val());



        $("#AssetTypeId").change(function () {
            BindAssetType();
            if ($(this).val() == "@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()") {
                $('.divUploadPMImage').show();
            } else {
                $('.divUploadPMImage').hide();
                $('#hdnImageBase64').val('');
                $('#divImage').empty();
            }
        });

        if ($("#AssetTypeId").val() == "@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()") {
            $('.divUploadPMImage').show();
        } else {
            $('.divUploadPMImage').hide();
            $('#hdnImageBase64').val('');
            $('#divImage').empty();
        }

        $("#SiteId").change(function () {
            BindAssetType();
        });


        $("#DivisionId").change(function () {
            GetSiteByDivision($(this).val());
        });
    });

    function fnUploadImageFile($this) {
        var counter = 0;
        $("#loader").show();
        var files = $($this).get(0).files;
        var fileData = new FormData();
        for (var i = 0; i < files.length; i++) {
            fileData.append(files[i].name, files[i]);
        }

        $.ajax({
            url: "/DivisionRemark/UploadFile",
            type: "POST",
            contentType: false,
            processData: false,
            data: fileData,
            async: true,
            success: function (data) {
                $("#loader").hide();
                var imageBase64 = '';
                if (data != null && data != undefined && data != '') {
                    imageBase64 += "<input type='hidden' id='hdnBas64_" + counter + "' class='hdnImageBase64' value='" + data.ImageBase64 + "' data-fileextension='" + data.ImageExtension + "' />";
                    imageBase64 += "<img height='100' width='100' id='imgBas64_" + counter + "' src='data:image/png;base64," + data.ImageBase64 + "'/>";

                    $('#hdnImageBase64').val(data.ImageBase64);
                    //$('#hdnImageExtension').val(data.ImageExtension);
                }
                $('#divImage').empty().append(imageBase64);
            },
            error: function (xhr, error, status) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "Error");
            }
        });
    }

    function fnSaveDivisionRemark() {
        if (IsValid()) {
            $('#frmSaveDivisionRemark').submit();
        }
    }

    function IsValid() {
        var result = true;

        if ($("#DivisionId").val() == 0 || $("#DivisionId").val() == null || $("#DivisionId").val() == undefined || $("#DivisionId").val() == '') {
            $("#DivisionId").next().text("Division is required.");
            result = false;
        }
        else {
            $("#DivisionId").next().text("");
        }

        if ($("#SiteId").val() == 0 || $("#SiteId").val() == null || $("#SiteId").val() == undefined || $("#SiteId").val() == '') {
            $("#SiteId").next().text("Site is required.");
            result = false;
        }
        else {
            $("#SiteId").next().text("");
        }

        if ($("#AssetTypeId").val() == 0 || $("#AssetTypeId").val() == null || $("#AssetTypeId").val() == undefined || $("#AssetTypeId").val() == '') {
            $("#AssetTypeId").next().text("Asset Type is required.");
            result = false;
        }
        else {
            $("#AssetTypeId").next().text("");
        }

        if ((!$("#AssetId").val() || $("#AssetId").val() == "0") &&
            (!$("#AlertInfoId").val() || $("#AlertInfoId").val() == "0")) {
            $("#AssetId").next().text("Select Asset or Cause.");
            result = false;
        } else {
            $("#AssetId").next().text("");
            result = true;
        }


        if ($("#OperationTypeId").val() == 0 || $("#OperationTypeId").val() == null || $("#OperationTypeId").val() == undefined || $("#OperationTypeId").val() == '') {
            $("#OperationTypeId").next().text("Operation Type is required.");
            result = false;
        }
        else {
            $("#OperationTypeId").next().text("");
        }

        return result;
    }


    function GetSiteByDivision(divisionId) {
        if (divisionId != null && divisionId != undefined && divisionId != '') {
            $("#loader").show();
            $.ajax({
                url: '/DivisionRemark/GetSitesBy',
                type: 'POST',
                data: '{divisionId:' + divisionId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#SiteId").empty();
                    $("#SiteId").append($("<option></option>").val('0').html('Select Site'));
                    $.each(data, function (key, value) {
                        if ($('#hdnSiteId').val() != '0' && $('#hdnSiteId').val() == value.Id) {
                            $("#SiteId").append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $("#SiteId").append($("<option></option>").val(value.Id).html(value.Name));
                        }
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function BindAssetType() {
        if ($("#SiteId").val() != null && $("#SiteId").val() != undefined && $("#SiteId").val() != '' && $("#SiteId").val() != '0' && $("#AssetTypeId").val() != null && $("#AssetTypeId").val() != undefined && $("#AssetTypeId").val() != '' && $("#AssetTypeId").val() != '0') {
            $("#loader").show();
            $.ajax({
                url: '/BenchMarking/GetAssestBy',
                type: 'POST',
                data: '{siteId:' + $("#SiteId").val() + ',assetTypeId:' + $("#AssetTypeId").val() + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#AssetId").empty();
                    $("#AssetId").append($("<option></option>").val('').html('Select Asset'));
                    $.each(data, function (key, value) {

                        if ($('#hdnAssetId').val() != '0' && $('#hdnAssetId').val() == value.Id) {
                            $("#AssetId").append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $("#AssetId").append($("<option></option>").val(value.Id).html(value.Name));
                        }
                    });

                    BindAlertInfo();
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            //  CommonNotification("ERROR", "Please select site and asset type", "Error");
        }

    }

    function BindAlertInfo() {
        var AssetTypeId = $("#AssetTypeId").val();
        var selId = $("#hdnAlertInfoId").val();
        if (AssetTypeId != null && AssetTypeId != undefined && AssetTypeId != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRSReport/GetAlertInfo',
                type: 'POST',
                data: '{assetTypeId:' + AssetTypeId + '}',
                contentType: 'application/json',
                success: function (data) {

                    $("#loader").hide();
                    $('#AlertInfoId').empty();
                    $('#AlertInfoId').append($("<option></option>").val('').html('Select'));
                    $.each(data, function (key, value) {
                        if (selId != undefined && selId != '0' && selId == value.Id) {
                            $('#AlertInfoId').append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $('#AlertInfoId').append($("<option></option>").val(value.Id).html(value.Name));
                        }
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }

</script>