@model Domain.ClusterCategory

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal fade" id="modal-add-ClusterCategory" role="dialog" aria-labelledby="modal-add-ClusterCategory" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            @Html.HiddenFor(m => Model.Id, new { @id = "hdnClusterCategoryId" })
            @Html.HiddenFor(m => Model.ImageBase64, new { @id = "hdnImageBase64" })
            @Html.HiddenFor(m => Model.ImageExtension, new { @id = "hdnImageExtension" })
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Cluster Category</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Edit Cluster Category</span></h4>
                }
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label">Asset Type <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.DropDownListFor(m => m.AssetTypeId, (IEnumerable<SelectListItem>
                                        )ViewBag.AssetTypes, "Select", new { @class = "form-control", tabindex = 1 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label">Clasification Type <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.DropDownListFor(m => m.ClasificationTypeId, (IEnumerable<SelectListItem>
                                        )ViewBag.ClasificationTypes, "Select", new { @class = "form-control", tabindex = 1 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="col-sm-3">
                            <div class="mb-3">
                                <label class="form-label">Cluster  <span class="text-danger">*</span></label>
                                <div class="">
                                    <select name="Cluster" id="Cluster" class="form-control">
                                        @for (int i = 0; i <= 24; i++)
                                        {
                                            if (Model.Cluster == i)
                                            {
                                                <option value="@i" selected>@i</option>
                                            }
                                            else
                                            {
                                                <option value="@i">@i</option>
                                            }
                                        }
                                    </select>
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="mb-3">
                                <label class="form-label">Sub Cluster <span class="text-danger">*</span></label>
                                <div class="">
                                    <select name="SubCluster" id="SubCluster" class="form-control">
                                        @for (int i = 0; i <= 29; i++)
                                        {
                                            if (Model.SubCluster == i)
                                            {
                                                <option value="@i" selected>@i</option>
                                            }
                                            else
                                            {
                                                <option value="@i">@i</option>
                                            }
                                        }
                                    </select>
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label">Status <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.DropDownListFor(m => m.StatusId, (IEnumerable<SelectListItem>
                                        )ViewBag.Status, "Select", new { @class = "form-control", tabindex = 1 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label">Remark <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => m.Remark, new { @class = "form-control", tabindex = 2 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label">Percentage <span class="text-danger">*</span></label>
                                <div class="">
                                    @Html.TextBoxFor(m => m.Percentage, new { @class = "form-control", tabindex = 2, @type = "Number" })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6" id="divPointMachineType" style="display:none">
                            <div class="mb-3">
                                <label class="form-label">PointMachine Type <span class="text-danger"></span></label>
                                <div class="">
                                    @Html.DropDownListFor(m => m.PointMachineTypeId, (IEnumerable<SelectListItem>
                                        )ViewBag.PointMachineTypes, "Select", new { @class = "form-control", tabindex = 1 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="mb-3">
                                <label class="form-label">Upload Image</label>
                                <div class="">
                                    <input type="file" id="UploadImg" name="UploadImg" accept="image/*" class="form-control" onchange="fnUploadImageFile(this)">
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="mb-3">
                                <label class="form-label" for="IsDivisionPDF">Is Division PDF</label>
                                <div class="">
                                    @Html.CheckBoxFor(m => m.IsDivisionPDF)
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="mb-3">
                                <label class="form-label" for="IsUnderObservation">Is Under Observation</label>
                                <div class="">
                                    @Html.CheckBoxFor(m => m.IsUnderObservation)
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-12" id="divImage">
                            @if (!string.IsNullOrEmpty(Model.ImageBase64))
                            {
                                <img height="100" width="100" src="data:image/png;base64,@Model.ImageBase64" />
                            }
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()" id="btnSaveClusterCategory">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    function fnUploadImageFile($this) {
        var counter = 0;
        $("#loader").show();
        var files = $($this).get(0).files;
        var fileData = new FormData();
        for (var i = 0; i < files.length; i++) {
            fileData.append(files[i].name, files[i]);
        }

        $.ajax({
            url: "/ClusterCategory/UploadFile",
            type: "POST",
            contentType: false,
            processData: false,
            data: fileData,
            async: true,
            success: function (data) {
                $("#loader").hide();
                var imageBase64 = '';
                //$('#divImage').empty();
                if (data != null && data != undefined && data != '') {
                    imageBase64 += "<input type='hidden' id='hdnBas64_" + counter + "' class='hdnImageBase64' value='" + data.ImageBase64 + "' data-fileextension='" + data.ImageExtension + "' />";
                    imageBase64 += "<img height='100' width='100' id='imgBas64_" + counter + "' src='data:image/png;base64," + data.ImageBase64 + "'/>";

                    $('#hdnImageBase64').val(data.ImageBase64);
                    $('#hdnImageExtension').val(data.ImageExtension);
                }
                $('#divImage').empty().append(imageBase64);
            },
            error: function (xhr, error, status) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "Error");
            }
        });
    }

    $(document).ready(function () {
        debugger;
        if ($('#hdnSaveType').val() == 'Success') {

            CommonNotification($("#hdnSaveType").val().toLowerCase(), $("#hdnSaveMessage").val());

            $("[class*='modal-backdrop fade show']").remove();
            $("#frmClusterCategoryList").submit();
            window.history.pushState('', '', "Index");
        }
        else if ($('#hdnSaveType').val() == 'Error') {
            CommonNotification($("#hdnSaveType").val().toLowerCase(), $("#hdnSaveMessage").val());

            $("[class*='modal-backdrop fade show']").remove();
            window.history.pushState('', '', "Index");
        }

        if ($("#AssetTypeId").val() == '@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()') {
            $('#divPointMachineType').show();
        } else {
            $('#divPointMachineType').hide();
            $('#PointMachineTypeId').val(0);
        }

        $("#AssetTypeId").change(function () {
            if ($(this).val() == '@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()') {
                $('#divPointMachineType').show();
            } else {
                $('#divPointMachineType').hide();
                $('#PointMachineTypeId').val(0);
            }
        });
    });

