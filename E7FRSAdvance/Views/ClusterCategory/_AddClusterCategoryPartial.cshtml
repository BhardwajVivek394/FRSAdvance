    function Validate() {
        var result = true;

        if ($.trim($("#Cluster").val()).length == 0) {
            $("#Cluster").next("span").html("Cluster is required");
            result = false;
        }
        else {
            $("#Cluster").next("span").html("");
        }

        if ($.trim($("#SubCluster").val()).length == 0) {
            $("#SubCluster").next("span").html("Sub Cluster is required");
            result = false;
        }
        else {
            $("#SubCluster").next("span").html("");
        }

        if ($.trim($("#Remark").val()).length == 0) {
            $("#Remark").next("span").html("Alias Name is required");
            result = false;
        }
        else {
            $("#Remark").next("span").html("");
        }

        if ($.trim($("#AssetTypeId").val()).length == 0 || $("#AssetTypeId").val() == "0") {
            $("#AssetTypeId").next("span").html("Asset Type is required");
            result = false;
        }
        else {
            $("#AssetTypeId").next("span").html("");
        }


        if ($.trim($("#ClasificationTypeId").val()).length == 0 || $("#ClasificationTypeId").val() == "0") {
            $("#ClasificationTypeId").next("span").html("Clasification Type is required");
            result = false;
        }
        else {
            $("#ClasificationTypeId").next("span").html("");
        }


        if ($.trim($("#StatusId").val()).length == 0 || $("#StatusId").val() == "0") {
            $("#StatusId").next("span").html("Status is required");
            result = false;
        }
        else {
            $("#StatusId").next("span").html("");
        }

        return result;
    }
