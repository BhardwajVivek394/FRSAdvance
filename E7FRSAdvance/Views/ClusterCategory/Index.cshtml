@model Domain.ClusterCategoryLister
@{
    ViewBag.Title = "ChatBotUrl";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">ClusterCategory</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="">
    <div class="">
        @using (Ajax.BeginForm("List", "ClusterCategory", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divClusterCategoryList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmClusterCategoryList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divClusterCategoryList">
                @Html.Action("List")
            </div>
        }

        @using (Ajax.BeginForm("Save", "ClusterCategory", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveClusterCategory",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "ClusterCategorySaved"
        }, new { id = "frmSaveClusterCategory" }))
        {
            <div id="divSaveClusterCategory">
                @Html.Partial("_AddClusterCategoryPartial", new Domain.ClusterCategory())
            </div>
        }

    </div>
</div>

<input type="text" id="imagename" value="" />