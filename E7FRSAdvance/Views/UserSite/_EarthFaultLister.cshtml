@model List<Domain.Asset>

<div class="row">
    <div class="col-12">
        @if (Model != null && Model.Count > 0)
        {
            foreach (var asset in Model)
            {
                <button class="btn btn-info btn-lg m-r-10 m-b-10" type="button">@asset.Name</button>
            }

        }
    </div>
</div>

<script>
     $(document).ready(function () {
        if ('@Model.Count' <= 0) {
            $('#minDivEarthFault').hide();
        } else {
            $('#EarthFaultCount').text('(@Model.Count)');
            $('#minDivEarthFault').show();
        }
    });
</script>