@model Domain.SMSLogLister

@{
    int count = 0;
}

<div class="row">
    <div class="col-12">
        @if (Model != null && Model.mSMSLogs != null && Model.mSMSLogs.Count > 0)
        {
            var mainTrack = Model.mSMSLogs.GroupBy(x => new { x.AssetName, x.AssetId });
            if (mainTrack != null)
            {
                foreach (var assetId in mainTrack)
                {
                    var assetTypeId = Model.mSMSLogs.Where(x => x.AssetId == assetId.Key.AssetId).Select(x => x.AssetTypeId).FirstOrDefault();
                    count++;
                    <button class="btn btn-info btn-lg m-r-10 m-b-10" type="button" onclick="fnShow@{@Model.SearchCriteria.AlertName}('@assetId.Key.AssetId','@assetId.Key.AssetName','@assetTypeId')">@assetId.Key.AssetName</button>
                }
            }
        }
    </div>
</div>

<div class="modal fade bd-example-modal-lg" id="modal-add-@Model.SearchCriteria.AlertName" tabindex="-1" role="dialog" aria-labelledby="modal-add-IndexAlertLogs" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title isEdit" id="myModalLabel"><span> @Model.SearchCriteria.AlertName - </span><span id="spHeader_@Model.SearchCriteria.AlertName"></span></h4>
                @*<button type="button" class="btn btn-warning" id="btn@(Model.SearchCriteria.AlertName)RealTime">Real Time Data</button>*@
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            @if (Model != null && Model.mSMSLogs != null && Model.mSMSLogs.Count > 0)
                            {
                                var mainTrack = Model.mSMSLogs.GroupBy(x => new { x.AssetName, x.AssetId });
                                if (mainTrack != null)
                                {
                                    <div class="row justify-content-around">
                                        @foreach (var item in mainTrack)
                                        {
                                            <div class="table-responsive cls_@Model.SearchCriteria.AlertName" id="@{@Model.SearchCriteria.AlertName}Data_@item.Key.AssetId" style="display:none">
                                                @foreach (var indexAlertLog in Model.mSMSLogs.Where(x => x.AssetId == item.Key.AssetId))
                                                {
                                                    <div class="clsDivIndexAlertLogs">
                                                        <span>@indexAlertLog.TimeStamp.ToLongTimeString()</span>
                                                        <span>@indexAlertLog.AlertName</span>
                                                    </div>

                                                }
                                            </div>
                                        }


                                    </div>

                                }

                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        if ('@Model.mSMSLogs.Count' <= 0) {
            $("#minDiv@{@Model.SearchCriteria.AlertName}").hide();
        }else {
            $('#@{@Model.SearchCriteria.AlertName}Count').text('(@count)');
            $("#minDiv@{@Model.SearchCriteria.AlertName}").show();
        }
    });
    function fnShow@{@Model.SearchCriteria.AlertName}(assetId, assetName, assetTypeId) {
        $(".cls_@Model.SearchCriteria.AlertName").hide();
        $("#@{@Model.SearchCriteria.AlertName}Data_" + assetId).show();
        $("#spHeader_@Model.SearchCriteria.AlertName").text(assetName);
        @*$("#btn@(Model.SearchCriteria.AlertName)RealTime").attr('onClick', 'fnGetAssetAttribute(' + assetId + ',' + assetTypeId + ')');*@
        $("#modal-add-@Model.SearchCriteria.AlertName").modal("show");
    }
</script>

