@model Domain.DataloggerAssetLister

<div class="modal bounceIn animated" id="modalDataloggerJsonView" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-lg">
        <div class="modal-content bradius4 modal-xl">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel">

                    Json View - <span id="spnJsonViewLastUpdate"></span>
                </h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">
                    <div class="col-9">

                    </div>
                    <div class="col-3">
                        <input type="text" id="searchJsonViewText" class="form-control" placeholder="Search Text" />

                    </div>
                    <div class="col-12">
                        @if (Model != null && Model.DataloggerAssets != null && Model.DataloggerAssets.Count > 0)
                        {
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>SR No.</th>
                                        <th>Asset Type</th>
                                        <th>Asset Name</th>
                                        <th>Contact Type</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyJsonView">
                                    @*@foreach (var asset in Model.DataloggerAssets)
                    {
                        foreach (var attribute in asset.mDataloggerAttributes)
                        {
                            <tr id="tr_@attribute.SrNo">
                                <td>@attribute.SrNo</td>
                                <td>@asset.Name @attribute.Title</td>
                                <td>@attribute.ContactType</td>
                                <td class="hdnAttributeJsonViewData@(attribute.Id)@(asset.Id)"></td>
                            </tr>
                        }

                    }*@

                                </tbody>

                            </table>

                        }
                    </div>
                </div>
           
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    $("#searchJsonViewText").on("keyup", function () {
        var value = $(this).val().toLowerCase();
        $("#tbodyJsonView tr").filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
    });
</script>
