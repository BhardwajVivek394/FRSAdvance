@model Domain.PerformanceLister

<div class="modal bounceIn animated" id="modal-Performances" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Performances</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">

                    <div class="col-sm-12">
                        @if (Model != null && Model.Performances != null && Model.Performances.Count > 0)
                        {
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Attribute</th>
                                        <th>Variation</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var performance in Model.Performances)
                                    {
                                        <tr>
                                            <td>@performance.AssetName</td>
                                            <td>@performance.Category</td>
                                            <td>@performance.Value</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        }


                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>



