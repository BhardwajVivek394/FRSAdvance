@model Domain.AppAccessLister
@{
    ViewBag.Title = "UserHistory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .clsDivIndexAlertLogs {
        padding: 14px 16px;
        border: 1px solid #ccc;
        border-radius: 4px;
        background-color: #259dab;
        color: white;
    }
    .card-header {
        background-color: #0e2b42 !important;
        padding-top: 10px !important;
        padding-bottom: 10px !important;
        color: white !important;
    }

    .card .card-body {
        padding: 15px !important;
    }

    .modal-header {
        background-color: #0e2b42 !important;
        color: white !important;
    }

    .rowTable {
        display: flex !important;
    }

    .columnTable {
        float: left !important;
        width: 100% !important;
        padding: 5px !important;
    }

    .rowTable::after {
        content: "" !important;
        clear: both !important;
        display: table !important;
    }
</style>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-2">
                <a class="btn btn-info btn-lg" href="@Url.Action("Index")">Back</a>
            </div>
            <div class="col-6 text-center">
                <h5>@ViewBag.SiteName</h5>
            </div>

            <div class="col-2">
                @Html.TextBoxFor(x => x.SearchCriteria.StartTime, new { @class= "form-control",  @placeholder = "Select a date" })
            </div>
            <div class="col-2">
                @Html.TextBoxFor(x => x.SearchCriteria.EndTime, new { @class = "form-control" , @placeholder = "Select a date" })
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="page-title">
        <div class="row" id="minDivAxleCounter">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-12 text-center">
                                <h5>Total Duration : <span id="spnTotalDuration"></span> (min) </h5>
                            </div>
                        </div>
                    </div>
                    <div class="card-body divappendAxleCounter">
                        <div class="">
                            @using (Ajax.BeginForm("_UserHistoryLister", "UserSite", new AjaxOptions()
                            {
                                HttpMethod = "POST",
                                UpdateTargetId = "divUserHistoryList",
                                InsertionMode = InsertionMode.Replace,
                                LoadingElementId = "loader",
                            }, new { id = "frmGetUserHistoryList" }))
                            {
                                @Html.HiddenFor(x => x.SearchCriteria.StartTime, new { @id= "hdnStartTime" })
                                @Html.HiddenFor(x => x.SearchCriteria.EndTime, new { @id= "hdnEndTime" })
                                @Html.HiddenFor(x => x.SearchCriteria.SiteId)
                                { HtmlHelper.ClientValidationEnabled = false; }
                                <div id="divUserHistoryList">
                                    @Html.Action("_UserHistoryLister", Model)
                                </div>
                            }



                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('#SearchCriteria_StartTime').datepicker({
            dateFormat: 'mm/dd/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#SearchCriteria_EndTime').datepicker({
            dateFormat: 'mm/dd/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#SearchCriteria_StartTime').change(function () {
            $('#hdnStartTime').val($('#SearchCriteria_StartTime').val());
            $('#hdnEndTime').val($('#SearchCriteria_EndTime').val());

            $('#frmGetUserHistoryList').submit();
        });

        $('#SearchCriteria_EndTime').change(function () {
            $('#hdnStartTime').val($('#SearchCriteria_StartTime').val());
            $('#hdnEndTime').val($('#SearchCriteria_EndTime').val());

            $('#frmGetUserHistoryList').submit();

        });

        $('#SearchCriteria_StartTime').val('');
        $('#SearchCriteria_EndTime').val('');
    });
</script>
