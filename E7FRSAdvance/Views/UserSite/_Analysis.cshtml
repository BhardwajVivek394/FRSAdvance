@model List<Domain.AnalyticsLog>

<style>
    #grad1 {
        background-color: #ffd800;
        background-image: linear-gradient(to bottom right, #ffd800, #00A4E0);
    }
</style>

<div class="modal fade bd-example-modal-lg" id="modal-add-AnalyticsLog" tabindex="-1" role="dialog" aria-labelledby="modal-add-userClass" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Blocks</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            @if (Model != null && Model.Count > 0)
                            {
                                <div class="row justify-content-around">
                                    @foreach (var item in Model)
                                    {
                                        <div class="col-xl-2 ml-auto me-1 pt-4 pb-3 mb-3 rounded-3" id="grad1" onclick="fnsignaturelog('@item.BlockName.Trim().Replace(" ","")')">
                                            <p class="text-center h3 text-white">@item.BlockLines.Count</p>
                                            <p class="text-center h6 text-white">@item.BlockName</p>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                @*<button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()" id="btnSave">Save</button>*@
            </div>

            <!-- Modal -->


        </div>
    </div>
</div>

<div class="modal fade bd-example-modal-lg" id="modal-add-SignatureLog" tabindex="-1" role="dialog" aria-labelledby="modal-add-userClass" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Signature Logs</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            @if (Model != null && Model.Count > 0)
                            {
                                <div class="row justify-content-around">
                                    @foreach (var item in Model)
                                    {
                                        <div class="table-responsive clsBlockTable" id="Block_@item.BlockName.Trim().Replace(" ","")" style="display:none">
                                            <table class="table table-striped">
                                                <thead style="background-color:#042C43;">
                                                    <tr>
                                                        <th class="text-white">Seq No.</th>
                                                        <th class="text-white">Message</th>
                                                        <th class="text-white">Assets</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var blockLine in item.BlockLines)
                                                    {
                                                        var splitBlockLine = blockLine.Split('~');
                                                        if (splitBlockLine.Length > 0)
                                                        {
                                                            string filePath = string.Empty;
                                                            if (splitBlockLine.Length > 3)
                                                            {
                                                                filePath = System.Configuration.ConfigurationManager.AppSettings.Get("FileBaseUrl") + splitBlockLine[3];
                                                            }
                                                            <tr>
                                                                <td>@splitBlockLine[0]</td>
                                                                <td>@splitBlockLine[1]</td>
                                                                <td>
                                                                    @if (!string.IsNullOrEmpty(filePath))
                                                                    {
                                                                        <a href="@filePath" target="_blank">@splitBlockLine[2]</a>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span>@splitBlockLine[2]</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }

                                                    }

                                                </tbody>
                                            </table>
                                        </div>
                                    }


                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                @*<button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()" id="btnSave">Save</button>*@
            </div>

            <!-- Modal -->


        </div>
    </div>
</div>


<script type="text/javascript">
    function fnsignaturelog(blockName) {
        $(".clsBlockTable").hide();
        $("#Block_" + blockName).show();
        $("#modal-add-SignatureLog").modal("show");
    }
</script>