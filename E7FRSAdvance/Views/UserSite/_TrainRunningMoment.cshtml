@model Domain.TrainRunningMomentLister
@{
    int count = 0;
    var mAssets = new List<Domain.Asset>();
}
<div class="row divTrainRunningMomentLister">
    <div class="col-12">
        @*@if (Model != null && Model.TrainRunningMoments != null && Model.TrainRunningMoments.Count > 0)
            {
                var mainTrack = Model.TrainRunningMoments.GroupBy(x => new { x.AssetName, x.AssetId });
                if (mainTrack != null)
                {
                    foreach (var assetId in mainTrack)
                    {
                        count++;
                        <button class="btn btn-info btn-lg m-r-10 m-b-10" type="button" onclick="fnShowTrainRunningMoment('@assetId.Key.AssetId','@assetId.Key.AssetName')">@assetId.Key.AssetName</button>
                    }
                }
            }*@

        @if (ViewBag.Asset != null)
        {
            mAssets = ViewBag.Asset as List<Domain.Asset>;
            if (mAssets != null && mAssets.Count > 0)
            {
                foreach (var asset in mAssets)
                {
                    count++;
                    <button class="btn btn-info btn-lg m-r-10 m-b-10" type="button" onclick="fnShowTrainRunningMoment('@asset.Id','@asset.Name')">@asset.Name</button>
                }
            }
        }
    </div>
</div>

<div class="modal fade bd-example-modal-lg" id="modal-add-TrainRunningMoment" tabindex="-1" role="dialog" aria-labelledby="modal-add-TrainRunningMoment" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title isEdit" id="myModalLabel"><span> TrainMoment - </span><span id="spTrainRunningMoment"></span></h4>
                <button type="button" class="btn btn-warning" id="btnTrainRunningMomentRealTime">Real Time Data</button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            @if (Model != null && Model.TrainRunningMoments != null && Model.TrainRunningMoments.Count > 0)
                            {
                                var mainTrack = Model.TrainRunningMoments.GroupBy(x => new { x.AssetName, x.AssetId });
                                if (mainTrack != null)
                                {
                                    <div class="row justify-content-around">
                                        @foreach (var item in mainTrack)
                                        {
                                            <div class="table-responsive clsTrainRunningMoment" id="TrainRunningMoment_@item.Key.AssetId" style="display: none; height: 500px; overflow-y: scroll;">
                                                <table class="table">
                                                    <thead style="background-color:#042C43;">
                                                        <tr>
                                                            <th class="text-white">TimeStamp</th>
                                                            <th class="text-white">Leakage</th>
                                                            <th class="text-white">Vr</th>
                                                            <th class="text-white">Tpr</th>
                                                            <th class="text-white">Block</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var trainRunningMoments in Model.TrainRunningMoments.Where(x => x.AssetId == item.Key.AssetId))
                                                        {
                                                            string colorClass = string.Empty;
                                                            if (trainRunningMoments.LokedRecord == "1")
                                                            {
                                                                if (trainRunningMoments.Tpr > 1)
                                                                {
                                                                    colorClass = "tblYellow";
                                                                }
                                                                else
                                                                {
                                                                    colorClass = "tblRed";
                                                                }
                                                            }

                                                            <tr>
                                                                <td class="@colorClass">@trainRunningMoments.TimeStamp.ToLongTimeString()</td>
                                                                <td class="@colorClass">@trainRunningMoments.Leakage</td>
                                                                <td class="@colorClass">@trainRunningMoments.Vr</td>
                                                                <td class="@colorClass">@trainRunningMoments.Tpr</td>
                                                                <td class="@colorClass">@trainRunningMoments.BlockId</td>
                                                            </tr>

                                                        }

                                                    </tbody>
                                                </table>
                                            </div>
                                        }


                                    </div>

                                }

                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        if ('@Model.TrainRunningMoments.Count' <= 0 || '@mAssets.Count' <= 0) {
            $('#mainDivTrainRunningMoment').hide();
        } else {
            $('#TrainRunningMomentCount').text('(@count)');
            $('#mainDivTrainRunningMoment').show();
        }
    });

    function fnShowTrainRunningMoment(assetId, assetName) {
        $(".clsTrainRunningMoment").hide();
        $("#TrainRunningMoment_" + assetId).show();
        $("#spTrainRunningMoment").text(assetName);
        $("#btnTrainRunningMomentRealTime").attr('onClick', 'fnGetAssetAttribute(' + assetId + ',' + "@E7FRSAdvance.Utility.Utility.AssetType.TRACK.GetHashCode()" + ')');
        $("#modal-add-TrainRunningMoment").modal("show");
    }
</script>