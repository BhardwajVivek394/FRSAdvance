@model System.Data.DataTable
<div class="modal bounceIn animated" id="modalProbabilityMain" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                @if (ViewBag.Week != null)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Week @ViewBag.Week</span></h4>
                }
                else
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Probability</span></h4>
                }
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="table modal-fixed-height">
                        @if (Model != null && Model.Columns != null && Model.Rows != null && Model.Rows.Count > 0)
                        {
                            <table class="table sortable">
                                <thead class="bg-primary">
                                    <tr>
                                        @for (int i = 0; i < Model.Columns.Count; i++)
                                        {
                                            <th>
                                                @Model.Columns[i].ColumnName
                                            </th>
                                        }

                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.Rows.Count; i++)
                                    {
                                        <tr>
                                            @for (int j = 0; j < Model.Columns.Count; j++)
                                            {
                                                if (Model.Columns.Count > j && Model.Columns[j].ColumnName == "loss" && Model.Rows[i][j].ToString() != string.Empty)
                                                {
                                                    decimal lossval = 0m;
                                                    decimal.TryParse(Model.Rows[i][j].ToString(), out lossval);
                                                    <td>
                                                        @Math.Round(lossval, 2,MidpointRounding.ToEven)
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>@Model.Rows[i][j].ToString()</td>
                                                }
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>
