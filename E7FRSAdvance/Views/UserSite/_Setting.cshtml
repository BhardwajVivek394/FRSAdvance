@model Domain.HooterSetting

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal fade" id="modal-setting" role="dialog" aria-labelledby="modal-setting" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered" role="document">
        <div class="modal-content">
            @*@Html.HiddenFor(m => Model.Id, new { @id = "hdnLearningId" })*@
            <div class="modal-header">
                <h5>Settings</h5>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <div class="mb-3">
                                <label class="form-label">Scan frequency(sec)</label>
                                <div class="">
                                    @Html.TextBoxFor(m => m.DataInterval, new { @class = "form-control", tabindex = 1 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Past time spent(min)</label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.LastMinuteData, new { @class = "form-control", tabindex = 2 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Audition Duration(value per play 3 time)</label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.AudioDuration, new { @class = "form-control", tabindex = 3 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Reminder Frequency(second)</label>
                                <div class="">
                                    @Html.TextBoxFor(m => Model.ReminderFrequency, new { @class = "form-control", tabindex = 4 })
                                    <span class="text-danger"></span>
                                </div>
                            </div>
                            @Html.HiddenFor(x => x.AlertSound, new { id = "hdnAlertSound" })
                            <div class="mb-3">
                                <label class="form-label">Alert Sound</label>
                                <div class="media-body icon-state">
                                    <label class="switch">
                                        @if (Model.AlertSound == true)
                                        {
                                            <input type="checkbox" onchange="fnChangeSwitch(this)" checked />
                                            <span class="switch-state" style="display:block;"></span>
                                        }
                                        else
                                        {
                                            <input type="checkbox" onchange="fnChangeSwitch(this)" />
                                            <span class="switch-state" style="display:block;"></span>
                                        }
                                    </label>
                                </div>
                            </div>
                            <div class="mb-3 modal-footer">
                                <div style="margin-right: 182px;">
                                    <button type="button" class="btn btn-info" onclick="SaveHooterSetting()"><h5 class="center">Save</h5></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>

    $(document).ready(function () {
        if ($('#hdnSaveType').val() == 'Success') {
            $("[class*='modal-backdrop']").remove();
            $("body").removeClass("modal-open");
            $("body").css("padding-right", "0");
            $("#frmGetSiteList").submit();
        }
        else if ($('#hdnSaveType').val() == 'Error') {
            $("[class*='modal-backdrop']").remove();

            $("body").removeClass("modal-open");
            $("body").css("padding-right", "0");
            window.history.pushState('', '', "Index");
        }
    });

    function fnChangeSwitch($this) {
        if ($($this).prop('checked') == true) {
            $('#hdnAlertSound').val(true);
        } else {
            $('#hdnAlertSound').val(false);
        }

    }

    function SaveHooterSetting() {
        $("#frmHooterSetting").submit();
    }


</script>