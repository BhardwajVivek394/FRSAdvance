    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmAssetDetails").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize)
            {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmAssetDetails").submit();
            }
        }
    }
    function fnGridView() {
        $("#listView").hide();
        $("#gridView").show();
    }
    function fnListView() {
        $("#listView").show();
        $("#gridView").hide();
    }
    function fnSearch() {
        $("#frmAssetDetails").submit();
    }

    function GetAlarmStatus(assetId) {

        if (assetId) {
            $.ajax({
                url: '/Site/GetAlarmStatus',
                type: 'Post',
                data: '{assetId:' + assetId + '}',
                contentType: 'application/json',
                success: function (data) {
                    if (data == true) {
                        $(".checkHealth" + assetId).html("<span style='cursor:pointer' onclick='GetLogByAssetId(" + assetId + ")' class='text-danger'>Alarm</span>");
                    }
                    else {
                        $(".checkHealth" + assetId).html("<span class='text-success'>Ok</span>");
                    }
                },
                error: function (response) {
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }
    function GetLogByAssetId(assetId) {

        if (assetId) {
            $.ajax({
                url: '/Site/GetLogByAssetId',
                type: 'Post',
                data: '{assetId:' + assetId + '}',
                contentType: 'application/json',
                dataType:'html',
                success: function (data) {
                    $("#model-div").empty().append(data);
                    $("#modalSmslogs").modal('show');
                },
                error: function (response) {
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }

    function fnGetHttpPostData() {
        var asset = {};
        asset.SiteId = $("#hdnsiteId").val();
        asset.AssetTypeId = $("#hdnassetTypeId").val();
        $.ajax({
            url: '/Site/GetHttpPostData',
            type: 'Post',
            data: '{mAsset:' + JSON.stringify(asset) + '}',
            contentType: 'application/json',
            success: function (data) {

                $.each(data, function (id, item) {

                    $.each(item.assetAttributes, function (idx, inItem) {
                        var id = ".hdnAttributeData" + inItem.Id + item.Id;
                        $(id).html(parseFloat( inItem.AssetInfoValue).toFixed(2));
                        if (idx == 0) {
                            $("#divchannel").empty().append(" Last Update: <span>" + item.StartTime + "</span>")
                        }
                    });
                });
            },
            error: function (response) {
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function stringToBool(val) {
        return (val + '').toLowerCase() === 'true';
    }

    function Hex2Bin(hex) {
        return (parseInt(hex, 16).toString(2)).padStart(8, '0');
    }

    function decimalToBinary(num) {
        let binary = "";
        while (num > 0) {
            let digit = num % 2;
            binary = "" + digit + binary;
            num = parseInt(num / 2);
        }
        return binary.padStart(8, '0');
    }

    function decimalToBinaryNew(num) {
       var str = "";
        while (num > 0) {
            if ((num & 1) == 1) // 1
                str += '1';
            else // 0
                str += '0';
            num >>= 1; // Right Shift by 1
        }
        return str.padStart(8, '0');
    }

