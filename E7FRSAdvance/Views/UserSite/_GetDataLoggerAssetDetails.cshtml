    function onConnect() {
        // Once a connection has been made, make a subscription and send a message.
        client.subscribe(mQQTPath + 'dl/#');
    }

    // called when the client loses its connection
    function onConnectionLost(responseObject) {
        if (responseObject.errorCode !== 0) {
            console.log("onConnectionLost:" + responseObject.errorMessage);
            //location.reload();
        }
            client.connect({
                onSuccess: onConnect,
                userName: "wattmon",
                password: "wattmon_2018",
                cleanSession: true
            });
    }

    // called when a message arrives
    function onMessageArrived(message) {
        var parseJson = JSON.parse(message.payloadString);
        if (parseJson != null && parseJson != undefined && parseJson != '') {
            var jsonData = parseJson['bits'];
            if (jsonData != null && jsonData != undefined && jsonData.length > 0) {
                //var channeldata = message.payloadString.split(',');
                var jsonArrayString = '';
                for (var i = 0; i < jsonData.length; i++) {   
                    var decimalNumber = decimalToBinary(jsonData[i]);
                    if (decimalNumber != null) {
                        if (decimalNumber.length != 8) {
                            decimalNumber = ("00000000" + decimalNumber.toString(2)).substr(-8)
                        }

                        const reversedString = decimalNumber.split("").reduce((acc, char) => char + acc, "");
                       // let number = parseInt(decimalNumber, 10);
                        jsonArrayString += reversedString;
                    }
                }
                var jsonArray = jsonArrayString.split('');
                if (jsonArray != null && jsonArray != undefined && jsonArray.length > 0) {
                    BindData(jsonArray);
                    BindJsonData(jsonArray);
                }

                
            }

        }


        var d = new Date();
        var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
        $("#spnLastUpdate").html(time);
        $("#spnJsonViewLastUpdate").html(time);

        //for (var i = 0; i < channels.length; i++) {
        //    if (channels[i] != null && channels[i] != "null" && channels[i] != "") {
        //        var name = mQQTPath.toLowerCase() + channels[i].toLowerCase();
        //        if (message.destinationName.toLowerCase() == name.toLowerCase()) {
        //            var d = new Date();
        //            var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
        //            $("#c" + i).html(time);
        //        }
        //    }
        //}
    }

    function BindData(data) {
        $.each(json.DataloggerAssets, function (id, item) {
            if (item.mDataloggerAttributes != null && item.mDataloggerAttributes.length > 0) {
                $.each(item.mDataloggerAttributes, function (idx, inItem) {
                    if (inItem.SrNo != null) {

                        var dataValue = data[inItem.SrNo - 1];
                        if (dataValue != null) {
                            var id = ".hdnAttributeData" + inItem.Id + item.Id;
                            //var jsonId = ".hdnAttributeJsonViewData" + inItem.Id + item.Id;
                           

                            if (inItem.ContactType != null && inItem.ContactType != undefined && inItem.ContactType.toLowerCase() == 'front') {
                                if (parseInt(dataValue) == 0) {
                                    $(id).html("<span class='badge badge-warning'>DROP</span>");
                                }
                                else if (parseInt(dataValue) == 1) {
                                    $(id).html("<span class='badge badge-success'>Pickup</span>");                                  
                                }
                            } else if (inItem.ContactType != null && inItem.ContactType != undefined && inItem.ContactType.toLowerCase() == 'back') {
                                if (parseInt(dataValue) == 0) {
                                    $(id).html("<span class='badge badge-success'>Pickup</span>");
                                }
                                else if (parseInt(dataValue) == 1) {
                                    $(id).html("<span class='badge badge-warning'>DROP</span>");
                                }
                            }


                        }
                        else {
                        }
                    }
                });
            }


        });
    }

    function BindJsonData(jsonArray) {
        var htmlTable = '';

        for (var srNumber = 1; srNumber < jsonArray.length; srNumber++) {
            var values = $('#tbodyJsonView').find("tr#tr_" + srNumber + "").attr('id');
            if (values != null && values != undefined && values != '') {
                $('#tbodyJsonView').find("tr#tr_" + srNumber + " td:eq(4)").text(jsonArray[srNumber]);
                continue;

            }
            var assetJson = {};
            $.each(json.DataloggerAssets, function (id, item) {
                if (item.mDataloggerAttributes != null && item.mDataloggerAttributes.length > 0) {
                    $.each(item.mDataloggerAttributes, function (idx, inItem) {
                        var newSrNo = inItem.SrNo - 1;
                        if (inItem.SrNo != null && inItem.SrNo == srNumber) {
                            if (srNumber == 1609) {
                                debugger;

                            }
                            var dataValue = jsonArray[newSrNo];
                            if (dataValue != null) {
                                assetJson.SRNo = inItem.SrNo;
                                assetJson.AssetName = item.Name + " " + inItem.Title;
                                assetJson.ContactType = inItem.ContactType;
                                assetJson.AssetTypeName = item.AssetTypeName;
                               

                                return false;
                            }
                        }
                    });
                }

                if (assetJson != null && assetJson != undefined && assetJson.AssetName != null && assetJson.AssetName != undefined) {
                    return false;
                }

            });

            if (assetJson != null && assetJson != undefined && assetJson.AssetName != null && assetJson.AssetName != undefined) {
                htmlTable += '<tr id="tr_' + srNumber + '">';
                htmlTable += '<td>' + srNumber + '</td>';
                htmlTable += '<td>' + assetJson.AssetTypeName +'</td>'
                htmlTable += '<td>' + assetJson.AssetName + '</td>';
                htmlTable += '<td>' + assetJson.ContactType + '</td>';

                htmlTable += '<td>' + jsonArray[srNumber - 1] + '</td>';

                htmlTable += '</tr>';
            } else {
                htmlTable += '<tr id="tr_' + srNumber + '">';
                htmlTable += '<td>' + srNumber + '</td>';
                htmlTable += '<td></td>';
                htmlTable += '<td></td>';
                htmlTable += '<td></td>';

                htmlTable += '<td>' + jsonArray[srNumber - 1] +'</td>';           
                htmlTable += '</tr>';
            }
            
        }
       
        $('#tbodyJsonView').append(htmlTable);
    }

