@model Domain.DataloggerAssetLister
<style>
    .popover {
        width: 100%;
    }

    .popover-content {
        color: black;
    }

    @@media only screen and (max-width: 1200px) {
        .panel-body {
        }
    }

    .tableFixHead {
        overflow: auto;
        height: 100vh;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }

    .progress {
        height: 30px;
        font-size: 18px;
    }

    .progress-bar-animated {
        color: black !important;
    }
</style>
@{
    var bgColor = new string[] { "#215968", "#404040", "#4bacc6" };

}
<div class="people-options clearfix" style="padding:4px">
    <div class="pull-left " style="display:inline-flex">
        <div class="input-group " style="margin-left:20px;">
            @Html.TextBoxFor(x => x.SearchCriteria.Name, new { @class = "form-control btn-pill asset-search", @placeholder = "Search " })
        </div>
    </div>
    @*<div class="btn-group pull-right people-pager">


            @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
            @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
        </div>
        <div class="btn-group pull-right people-pager">
            <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left"></i></button>
            <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>
        </div>*@
    @{
        int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
        if (Model.DataloggerAssets.Count == 0)
        {
            start = 0;
        }
        decimal end = Math.Floor(Model.Pager.TotalRecord);
        if (Model.Pager.PageSize < Model.Pager.TotalRecord)
        {
            if (Model.Pager.PageSize == -1)
            {
                end = Model.Pager.TotalRecord;
            }
            else
            {
                end = Model.Pager.PageSize * Model.Pager.CurrentPage;
                if (end > Model.Pager.TotalRecord)
                {
                    end = Model.Pager.TotalRecord;
                }
            }
        }
    }
    <span class="people-count pull-right">Showing <strong>@Model.DataloggerAssets.Count</strong> Assets</span>

    <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-info" onclick="fnListView()" title="List View"><i class="fa fa-list"></i></a></span>
    <span class="pull-right" style="margin-right:20px;"><a class="btn btn-sm btn-primary" onclick="fnGridView()" title="Grid View"><i class="fa fa-th-large"></i></a></span>




</div>

<div class="card " id="gridView">
    <div class="card-body" style="padding:15px;">
        <div class="row" id="divAsset">
            @if (Model.DataloggerAssets != null && Model.DataloggerAssets.Count > 0)
            {
                foreach (var item in Model.DataloggerAssets)
                {
                    //if (item.DaAssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK)
                    //{
                    //    item.assetAttributes = item.assetAttributes.OrderBy(x => x.Sequence).ToList();
                    //}

                    //int cnt = item.AssetTypeName.Length + item.Name.Length;

                    //var isErrorCode = false;
                    //if (item.mErrorCodeIdentifier != null && item.mErrorCodeIdentifier.Id > 0)
                    //{
                    //    isErrorCode = true;
                    //}


                    <div class="col-xl-3 xl-50 news box-col-6">
                        <div class="card card-border">
                            <div class="bg-secondary main-header" style="padding:0;border-top-left-radius:15px;border-top-right-radius:15px;">
                                <div class="" style="width:80%;float:left;padding:10px;border-top-left-radius:15px;">
                                    <h6 style="margin-left:12px;">
                                        <a target="_blank" class="text-white"> @item.AssetTypeName : @item.Name</a>

                                    </h6>
                                </div>
                                <div class="text-center bg-dark" style="width: 20%; float: left; padding: 2px 0px; border-top-right-radius: 15px; line-height: 1.3; height: 50px;">

                                    <a onclick="fnGetAssetGraph('@item.SiteId', '@item.Id')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer"> Graph </a>
                                    <a onclick="fnGetAssetEventLog('@item.SiteId','@item.Id','')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer">Event log</a>
                                </div>

                            </div>
                            <div class="card-body gridBody" style="padding:5px;">
                                <div class="table-responsive width100p tblAssetData">

                                    <table class="table table-striped">
                                        <tbody id="tblAttributeData@(item.Id)" class="tblAttributes tblAttributeData@(item.Id)" data-id="@item.Id">
                                            @if (item.mDataloggerAttributes != null && item.mDataloggerAttributes.Count > 0)
                                            {
                                                foreach (var assetAttribute in item.mDataloggerAttributes)
                                                {

                                                    <tr class="gridassetAttribute_@assetAttribute.Title.Replace(" ","")">
                                                        <td style="width:50%">

                                                            @if (assetAttribute.Title.Contains("+ve"))
                                                            {
                                                                <span style="color:darkorange;font-weight:900;font-size:18px;">  @assetAttribute.Title</span>
                                                            }
                                                            else if (assetAttribute.Title.Contains("-ve"))
                                                            {
                                                                <span style="color: black; font-weight: 900; font-size: 18px;">  @assetAttribute.Title</span>
                                                            }
                                                            else
                                                            {
                                                                @assetAttribute.Title
                                                            }



                                                        </td>
                                                        <td style="width:50%" class="hdnAttributeData@(assetAttribute.Id)@(item.Id) fault-line">
                                                        </td>

                                                    </tr>
                                                }

                                            }
                                            else
                                            {
                                                <tr>
                                                    <td class="text-center" colspan="3">No attributes found!</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            }
            else
            {
                <p style="font-size:15px">No record found!</p>
            }
        </div>
    </div>
</div>


<div class="card" id="listView" style="display:none;">
    <div class="card-header">
        @Model.SearchCriteria.AssetTypeName
    </div>
    <div class="card-body listBody" style="padding:15px;">
        <div class="">
            <div class="">
                <div class="tableFixHead">
                    <table class="table">
                        <thead class="bg-primary">

                            @{
                                List<Domain.DataloggerAttribute> mAssetAttribute = new List<Domain.DataloggerAttribute>();
                                foreach (var item in Model.DataloggerAssets)
                                {
                                    foreach (var assetAttribute in item.mDataloggerAttributes)
                                    {
                                        if (mAssetAttribute.Where(x => x.Title == assetAttribute.Title).Count() == 0)
                                        {
                                            mAssetAttribute.Add(assetAttribute);
                                        }
                                    }
                                }
                            }

                            @if (Model.DataloggerAssets != null && Model.DataloggerAssets.Count > 0)
                            {
                                int i = 0;
                                int j = 0;
                                foreach (var item in Model.DataloggerAssets)
                                {
                                    if (item.mDataloggerAttributes != null && item.mDataloggerAttributes.Count > 0 && i == 0)
                                    {
                                        i++;
                                        <tr>
                                            <th style="background-color:#4bacc6;color:white;">
                                                @item.AssetTypeName
                                            </th>
                                            @foreach (var assetAttribute in mAssetAttribute)
                                            {


                                                if (assetAttribute.Title.Contains("Last Update"))
                                                {
                                                    <th style="background-color:@bgColor[j];color:white;width:120px;">

                                                        @assetAttribute.Title
                                                    </th>
                                                }
                                                else
                                                {
                                                    string bgcolor = bgColor[j];
                                                    if (assetAttribute.Title.Contains("+ve"))
                                                    {
                                                        bgcolor = "darkorange";
                                                    }
                                                    if (assetAttribute.Title.Contains("-ve"))
                                                    {
                                                        bgcolor = "Black";
                                                    }
                                                    <th style="background-color:@bgcolor;color:white;">
                                                        @assetAttribute.Title
                                                    </th>
                                                }
                                                if (j == 2)
                                                { j = 0; }
                                                else
                                                { j++; }
                                            }

                                            <th style="background-color:#404040;color:white;width:150px;" colspan="2"></th>
                                        </tr>
                                    }

                                }

                            }

                        </thead>
                        <tbody style="max-height: 620px;overflow-y:auto;" id="tbodyAssetList">
                            @if (Model.DataloggerAssets != null && Model.DataloggerAssets.Count > 0)
                            {

                                foreach (var item in Model.DataloggerAssets)
                                {
                                    if (item.mDataloggerAttributes != null && item.mDataloggerAttributes.Count > 0)
                                    {

                                        <tr data-id="@item.Id">
                                            <td>
                                                <a> @item.Name</a>
                                            </td>
                                            @foreach (var attribute in mAssetAttribute)
                                            {


                                                var attItem = item.mDataloggerAttributes.Where(x => x.Title == attribute.Title).FirstOrDefault();

                                                if (attItem != null)
                                                {
                                                    <td class="hdnAttributeData@(attItem.Id)@(item.Id) list@(attribute.Title.Replace(" ",""))">
                                                    </td>
                                                }
                                                else
                                                {
                                                    <td>
                                                    </td>
                                                }

                                            }

                                            <td>
                                                <a onclick="fnGetAssetGraph('@item.SiteId','@item.Id')" style="text-transform:capitalize;cursor:pointer;"> Graph </a>
                                            </td>
                                            <td>
                                                <a onclick="fnGetAssetEventLog('@item.SiteId','@item.Id', false)" style="text-transform:capitalize;cursor:pointer">Event log</a>
                                            </td>
                                        </tr>
                                    }
                                }

                            }
                        </tbody>
                    </table>
                </div>

            </div>

        </div>
    </div>
</div>

