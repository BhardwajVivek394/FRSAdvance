    function fnGetAssetEventLog(siteId, assetId, isDeadband) {
        var strDate = '';
        if ($('#searchDataloggerDate').val() != null && $('#searchDataloggerDate').val() != undefined) {
            strDate = $('#searchDataloggerDate').val();
        }
        $("#loader").show();
        $.ajax({
            url: '/UserSite/_DataloggerAsset',
            type: 'Post',
            dataType: 'html',
            data: '{siteId:' + siteId + ',assetId:' + assetId + ',searchDate:"' + strDate + '"}',
            contentType: 'application/json',
            success: function (data) {
                var deadbandTable = $($.parseHTML(data)).find("#deadbandDataByDate").html();
                debugger;
                $("#loader").hide();
                if (isDeadband) {
                    $("#deadbandDataByDate").empty().append(deadbandTable);
                }
                else {
                   // $("#modalDataloggerLogs").modal('hide');
                    $("#divDataLogger").empty().append(data);
                    $("#modalDataloggerLogs").modal('show');
                }
            },
            error: function (response) {
                CommonNotification("error", "Something went wrong!");
            }
        });
    }
</script>


