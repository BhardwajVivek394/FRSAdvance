<div id="divDataLogger"></div>
<div id="divDataLoggerJsonView"></div>
<script>
    function SearchAsset(id, name) {          
        if (this.client && this.client.isConnected()) {
            try {
                this.client.disconnect();
            } catch (err) {
            }
        }
        $("#hdnassetTypeId").val(id);
        $("#hdAssetTypeName").val(name);
        //$("#lblAssetType").text($("#AssetName" + id).val());
        $("#hdnSkip").val('0');
        $(".asset-search").val("");
        $("#frmAssetDetails").submit();
    }

    function fnGetEventLog(siteId) {
        var strDate = '';
        if ($('#searchDataloggerDate').val() != null && $('#searchDataloggerDate').val() != undefined) {
            strDate = $('#searchDataloggerDate').val();
        }
        $("#loader").show();
        $.ajax({
            url: '/UserSite/_DataLogger',
            type: 'Post',
            dataType: 'html',
            data: '{siteId:' + siteId + ',assetTypeId:' + $("#hdnassetTypeId").val() + ',searchDate:"' + strDate +'"}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#modalDataloggerLogs").modal('hide');
                $("#divDataLogger").empty().append(data);
                $("#modalDataloggerLogs").modal('show');
            },
            error: function (response) {
                CommonNotification("error", "Something went wrong!");
            }
        });
    }

    function fnGetJsonView(siteId) {
        $("#loader").show();
        $.ajax({
            url: '/UserSite/_DataLoggerJsonView',
            type: 'Post',
            dataType: 'html',
            data: '{siteId:' + siteId + ',assetTypeId:' + $("#hdnassetTypeId").val() + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divDataLoggerJsonView").empty().append(data);
                $("#modalDataloggerJsonView").modal('show');
            },
            error: function (response) {
                CommonNotification("error", "Something went wrong!");
            }
        });
    }

