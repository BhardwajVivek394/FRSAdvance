@model List<Domain.Datalogger>


<table class="table" id="tblDatalogger">
    <thead>
        <tr>
            <th>SR No.</th>
            <th>Asset Name</th>
            <th>Current Value</th>
            <th>Time Stamp</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model.GroupBy(x => new { x.Date, x.SrNo, x.AssetName, x.CurrentValue, x.Timestamp }).Select(x => x.Key).OrderByDescending(x => x.Date))
            {
                <tr>
                    <td>@item.SrNo</td>
                    <td>@item.AssetName</td>
                    <td>
                        @if (item.CurrentValue == "Pickup")
                        {
                            <span class='badge badge-success'>Pickup</span>
                        }
                        else if (item.CurrentValue == "Drop")
                        {
                            <span class='badge badge-warning'>DROP</span>
                        }

                    </td>
                    <td>@item.Timestamp.ToString()</td>
                </tr>
            }
        }
    </tbody>

</table>
