
@{
    ViewBag.Title = "Maintenace Operation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/paho-mqtt.js"></script>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<style>
    .zheng_status_online {
        background-color: rgba(103, 194, 58, .1);
        border-color: rgba(103, 194, 58, .2);
        height: 100%;
        color: #67c23a;
        display: inline-block;
        padding: 0 10px;
        height: 32px;
        line-height: 28px;
        font-size: 12px;
        border-radius: 4px;
    }

    .zheng_status_offline {
        background-color: hsla(0, 87%, 69%, .1);
        border-color: hsla(0, 87%, 69%, .2);
        color: #f56c6c;
        height: 100%;
        display: inline-block;
        padding: 0 10px;
        height: 32px;
        line-height: 28px;
        font-size: 12px;
        border-radius: 4px;
    }

    /*Alert and predictive*/
    .pill-badge-primary1 {
        background-color: White;
    }

    body .mail-body-wrapper ul li {
        padding: 16px;
        display: flex;
        align-items: center;
        cursor: pointer;
        /*border-bottom: 1px solid #bebebe;*/
    }

    .pull-right {
        float: right;
    }

    body .mail-body-wrapper ul li .inbox-message .email-data .badge {
        border-radius: 20px;
    }

    body .mail-body-wrapper ul li .inbox-message {
        display: flex;
        justify-content: space-between;
        width: 100%;
        gap: 16px;
    }

        body .mail-body-wrapper ul li .inbox-message .email-data span {
            font-weight: 500;
            letter-spacing: 0.3;
            display: -webkit-box;
            max-width: 100%;
            margin: 0 auto;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            color: rgba(82, 82, 108, 0.8);
        }

    .tableFixHead {
        overflow: auto;
        height: 100vh;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }


    .tablemodalFixHead {
        overflow: auto;
        height: 70vh;
    }

        .tablemodalFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }
</style>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Operations</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">
        @using (Ajax.BeginForm("_List", "MaintenaceOperation", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divMaintenaceOperationList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmMaintenaceOperationList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divMaintenaceOperationList">
                @Html.Action("_List")
            </div>
        }
    </div>

   

    <div id="divCombineWatchlist"></div>
    <div id="divPreviousDaySMSLog"></div>
    <div id="divViewWatchListDetail"></div>
    <div id="divViewRFStatusDetail"></div>
    <div id="divRebootTotal"></div>
    <div id="divPreviousDayDivisionReport"></div>
    <div id="divExcludeSite"></div>
    <div id="divViewFRSAlertWatchListDetail"></div>
    <div id="divAssetAttributePartial"></div>
    <div id="divWatchListFRSAlertInstance"></div>
    <div id="divWatchListInstance"></div>
    <div id="divCombineWatchListHistory"></div>

</div>

