@model Domain.Site
@{
    ViewBag.Title = "CombineWatchlistClear";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .yesno-red {
        background-color: #fff0f0;
        border: 1px solid #ff4848;
        color: #ff4848;
        width: 50px;
        height: 20px;
        font-size: 11px;
        display: block;
        text-align: center;
        border-radius: 40px;
    }

    .yesno-green {
        background-color: #effef5;
        border: 1px solid #08b759;
        color: #08b759;
        width: 50px;
        height: 20px;
        font-size: 11px;
        display: block;
        text-align: center;
        border-radius: 40px;
    }
</style>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-6">
                <label style="font-size:18px;margin-top:7px;font-weight:bold">Site:</label>
                <label style="font-size:16px;margin-top:7px"> @Model.Name </label>
            </div>
            <div class="col-6">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#" data-bs-original-title="" title=""> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Pending</li>
                </ol>
            </div>
        </div>
    </div>
</div>
@Html.HiddenFor(x => x.Id, new { @id = "hdnSiteId" })

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-xl-1">
                <strong class="mt-4">Search</strong>
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4">
                <span>From Date</span>
                <input type="text" class="form-control" id="txtFromDate">
            </div>
            <div class="col-xl-2 col-lg-4 col-md-4">
                <span>To Date</span>
                <input type="text" class="form-control" id="txtToDate">
            </div>

            <div class="col-xl-1 col-lg-1 mt-3">
                <a class="btn btn-success btn-quirk mt-1" onclick="fnSearch()" title=""><i class="fa fa-search"></i></a>
                <a class="btn btn-info btn-quirk mt-1" onclick="fnDownload()" title=""><i class="fa fa-download"></i></a>
            </div>
        </div>
    </div>

    <div class="card-body" id="divCombineWatchlistPendingPartial">

    </div>
</div>

<div class="modal bounceIn animated" id="model-Force-Resolved" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modalConfirm-dialog ">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader">Force Resolved</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="form-horizontal ">
                    <div class="col-sm-12">
                        <input type="hidden" id="hdnForceResolvedId"/>
                        <div class="mb-3">
                            <label class="form-label">Remark</label>
                            <div class="">
                                <textarea class="form-control" id="txtForceResolvedRemark"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label">Upload Image</label>
                            <div class="">
                                <input type="file" id="UploadImg" name="UploadImg" accept="image/*" class="form-control" onchange="fnUploadForceImageFile(this)" multiple="">
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-12" id="divForceImage">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnUpdateForceResolved()">Save</button>
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#txtFromDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#txtToDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#txtFromDate').val('');
        $('#txtToDate').val('');

        fnSearch();
    });

    function fnSearch() {

        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#hdnSiteId').val();
        mSearchCriteria.StartDate = $('#txtFromDate').val();
        mSearchCriteria.EndDate = $('#txtToDate').val();
        $("#loader").show();
        $.ajax({
            url: '/MaintenaceOperation/_CombineWatchlistPendingPartial',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mSearchCriteria),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divCombineWatchlistPendingPartial").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnShowCombineWatchlist(id) {

        $('#hdnForceResolvedId').val(id);
        $('#txtForceResolvedRemark').val('');
        $('#divForceImage').empty();
        $('#model-Force-Resolved').modal('show');
    }

    function fnUploadForceImageFile($this) {
        var counter = 0;
                                
        var files = $($this).get(0).files;
        var fileData = new FormData();
        for (var i = 0; i < files.length; i++) {
            fileData.append(files[i].name, files[i]);
        }

        $("#loader").show();
        $.ajax({
            url: "/MaintenaceOperation/UploadForceFile",
            type: "POST",
            contentType: false,
            processData: false,
            data: fileData,
            async: true,
            success: function (data) {
                $("#loader").hide();
                var imageBase64 = '';
                if (data != null && data != undefined && data != '') {
                    imageBase64 += "<input type='hidden' id='hdnForceResolvedRemarkBas64' value='" + data.FileBase64 + "' data-fileextension='" + data.FileExtension + "' />";
                    imageBase64 += "<img style='height:100%;width:100%' src='data:image/png;base64," + data.FileBase64 + "'/>";
                }                                                                                                                                                           

                $('#divForceImage').empty().append(imageBase64);
            },
            error: function (xhr, error, status) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "Error");
            }
        });
    }

    function fnUpdateForceResolved() {
        var isValid = true;
        var mCombineOverallTarget = {};
        mCombineOverallTarget.Id = $('#hdnForceResolvedId').val();
        mCombineOverallTarget.FileBase64 = $('#hdnForceResolvedRemarkBas64').val();
        mCombineOverallTarget.ForceResolvedRemark = $('#txtForceResolvedRemark').val();
        mCombineOverallTarget.FileExtension = $('#hdnForceResolvedRemarkBas64').data('fileextension');

        if (mCombineOverallTarget.ForceResolvedRemark == null || mCombineOverallTarget.ForceResolvedRemark == '' || mCombineOverallTarget.ForceResolvedRemark == undefined) {
            isValid = false;
            alert('Remark is required');
        }
        else if (mCombineOverallTarget.FileBase64 == null || mCombineOverallTarget.FileBase64 == '' || mCombineOverallTarget.FileBase64 == undefined) {
            isValid = false;

            alert('Image is required');
        }

        if (isValid) {
            $("#loader").show();
            $.ajax({
                url: '/MaintenaceOperation/UpdateForceFile',
                type: 'Post',
                data: JSON.stringify(mCombineOverallTarget),
                contentType: 'application/json',
                success: function (data) {
                   
                    $("#loader").hide();
                    if (data != null) {
                        alert(data.result);
                        $('#model-Force-Resolved').modal('hide');
                        fnSearch();

                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
       

    }

    function fnDownload() {

        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#hdnSiteId').val();
        mSearchCriteria.StartDate = $('#txtFromDate').val();
        mSearchCriteria.EndDate = $('#txtToDate').val();
        window.location.href = "/MaintenaceOperation/DownloadPendingCombineWatchlist?SiteId=" + mSearchCriteria.SiteId + "&StartDate=" + mSearchCriteria.StartDate + "&EndDate=" + mSearchCriteria.EndDate;

    }
</script>