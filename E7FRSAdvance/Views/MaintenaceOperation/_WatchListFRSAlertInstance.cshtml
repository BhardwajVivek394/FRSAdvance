@model  List<Domain.FRSAlertInstance>

<div class="modal bounceIn animated" id="modal-WatchList-FRSAlert-Instance" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Alert Instance</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Sr no.</th>
                                        <th>Message</th>
                                        <th>Time Stamp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{var srNo = 1;}
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@srNo</td>
                                            <td>
                                                @item.Message
                                                <span>@Html.Raw(@item.Description)</span>
                                            </td>
                                            <td>@item.TimeStamp</td>
                                        </tr>
                                        srNo++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>
<script>
    $(function () {
        $(".modal-dialog").draggable({
            handle: ".modal-header"
        });
    });
</script>