@model List<Domain.SiteReboot>

<div class="modal bounceIn animated" id="modal-SiteReboot" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Previous day Reboot Total</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="row">
                            <div class="col-sm-12">
                                <table class="table">
                                    <tr>
                                        <th>Reboot Time</th>
                                    </tr>
                                    @if (Model != null && Model.Count > 0)
                                    {
                                        foreach (var item in Model.GroupBy(x => x.TimeStamp).Select(x => x.Key).OrderBy(x => x).ToList())
                                        {
                                            <tr>
                                                <td>@item</td>
                                            </tr>
                                        }

                                    }


                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

