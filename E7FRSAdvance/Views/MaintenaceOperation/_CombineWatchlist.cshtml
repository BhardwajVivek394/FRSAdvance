    function fnValidateCombineWatch(siteId, assetId, attributeId, assetTypeId, type, cause, id, clsterId, counter, $this) {
        var isValid = true;
        var mCombineOverallTarget = {};
        mCombineOverallTarget.SiteId = siteId
        mCombineOverallTarget.AssetId = assetId
        mCombineOverallTarget.AttributeId = attributeId;
        mCombineOverallTarget.AssetTypeId = assetTypeId;
        mCombineOverallTarget.Type = type;
        mCombineOverallTarget.Cause = cause;
        if (type == 'WatchList') {
            mCombineOverallTarget.WatchListId = id;
            mCombineOverallTarget.TypeId = '@E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.WatchLists.GetHashCode()';
        }
        if (type == 'FRSWatchList') {
            mCombineOverallTarget.FRSWatchListId = id;
            mCombineOverallTarget.TypeId = '@E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.FRSWatchList.GetHashCode()';
        }


        var drpReplaced = $('#drpReplaced' + clsterId + counter).val();
        mCombineOverallTarget.IssueType = $('#drpIssueType' + clsterId + counter).val();
        mCombineOverallTarget.Reason = $('#txtReson' + clsterId + counter).val();
        mCombineOverallTarget.MatrialCode = $('#txtCode' + clsterId + counter).val();
        mCombineOverallTarget.MaintainerUserId = $('#drpMaintainerUsers' + clsterId + counter).val();
        if (drpReplaced == "Yes") {
            if (mCombineOverallTarget.MatrialCode == null || mCombineOverallTarget.MatrialCode == undefined || mCombineOverallTarget.MatrialCode == '') {
                isValid = false;
                alert('Code is required');
            }
            else if (mCombineOverallTarget.IssueType == null || mCombineOverallTarget.IssueType == undefined || mCombineOverallTarget.IssueType == '') {
                isValid = false;
                alert('Issue Type is required');
            }
        }

        if (mCombineOverallTarget.Reason == null || mCombineOverallTarget.Reason == undefined || mCombineOverallTarget.Reason == '') {
            isValid = false;
            alert('Reason is required');
        }
        else if (mCombineOverallTarget.MaintainerUserId == null || mCombineOverallTarget.MaintainerUserId == undefined || mCombineOverallTarget.MaintainerUserId == '') {
            isValid = false;
            alert('Ground Staff is required');
        }

        if (isValid) {
            $("#loader").show();
            $.ajax({
                url: '/MaintenaceOperation/CheckCombineWatchlist',
                type: 'Post',
                data: '{mCombineOverallTarget:' + JSON.stringify(mCombineOverallTarget) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {

                        var type = '';
                        var msg = '';
                        $(data).each(function (t, data) {
                            if (data.Key == "type") {
                                type = data.Value
                            }
                            else if (data.Key == "result") {
                                msg = data.Value
                            }
                        });
                        if (type == "success") {
                            //$($this).next().addClass("text-success");
                            //$($this).next().removeClass("text-danger");
                            //$($this).next().text(msg);
                            alert(msg);
                            $($this).attr("src", "/assets/images/validateIcon2.png");
                            $($this).removeAttr('onclick');
                        }
                        else if (type == "pending") {
                            //$($this).next().addClass("text-success");
                            //$($this).next().removeClass("text-danger");
                            //$($this).next().text(msg);
                            alert(msg);
                            $($this).attr("src", "/assets/images/Warning.png");
                            $($this).removeAttr('onclick');
                        }
                        else if (type == "error") {
                            //$($this).next().removeClass("text-success");
                            //$($this).next().addClass("text-danger");
                            alert(msg);
                            // $($this).next().text(msg);
                        }
                        else {
                            alert("Logic not set");
                        }

                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

