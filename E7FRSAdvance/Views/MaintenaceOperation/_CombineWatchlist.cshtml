                                                                    }
                                                                    else
                                                                    {
                                                                        <img src="~/assets/images/Warning.png" />
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <img src="~/assets/images/validateIcon1.png" onclick="fnValidateCombineWatch('@ViewBag.SiteId','@item.AssetId','@item.AttributeId','@item.AssetTypeId','@item.GeneratedFrom','@item.Cause','@item.Id','@idCluster','@listcounter', this)" />
                                                                }
                                                                <span class="f-12"></span>
                                                            </td>
                                                            <td class="text-center">
                                                                <img src="~/assets/images/historyIcon.png" onclick="fnShowCombineWatchListHistory('@item.AssetId','@item.AttributeId','@item.ADCName')" />
                                                            </td>

                                                        </tr>
                                                    }

                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="15"></td>
                                                </tr>
                                            }

                                        </tbody>
                                    </table>

                                    <table class="table table-lg" id="table-combine">
                                        <thead>
                                            <tr>
                                                <th class="tr-bg" scope="col">S. No</th>
                                                <th class="tr-bg" scope="col">ID</th>
                                                <th class="tr-bg" scope="col">Cluster</th>
                                                <th class="tr-bg" scope="col">Status</th>
                                                <th class="tr-bg" scope="col">TCP</th>
                                                <th class="tr-bg" scope="col">A10 Type</th>
                                                <th class="tr-bg" scope="col">Modem</th>
                                                <th class="tr-bg" scope="col">Modem Number</th>
                                                <th class="tr-bg" scope="col">Connector status</th>
                                                <th class="tr-bg" scope="col">Replaced</th>
                                                <th class="tr-bg" scope="col">Reason</th>
                                                <th class="tr-bg" scope="col">Code</th>
                                                <th class="tr-bg" scope="col">Ground Staff</th>
                                                <th class="tr-bg" scope="col">Validate</th>
                                                <th class="tr-bg" scope="col">History</th>
                                            </tr>
