                                                <th width="3%" class="tr-bg" scope="col">Reason</th>
                                                <th width="3%" class="tr-bg" scope="col">Code</th>
                                                <th width="3%" class="tr-bg" scope="col">Ground Staff</th>
                                                <th width="3%" class="tr-bg text-center" scope="col">Validate</th>
