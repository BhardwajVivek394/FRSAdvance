                                                            }
                                                        </td>
                                                        <td>
                                                            <img src="~/assets/images/historyIcon.png" onclick="fnShowCombineLiskIssueHistory('@a10Status.id','@ViewBag.SiteId')"/>
                                                        </td>

                                                    </tr>

                                                }
                                            }
                                            else
                                            {
