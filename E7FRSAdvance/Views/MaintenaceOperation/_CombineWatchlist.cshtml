                                                                        }
                                                                    }
                                                                }
                                                            </select>
                                                        </td>

                                                        <td>
                                                            @if (a10Status.IsResolved != null)
                                                            {
                                                                if (a10Status.IsResolved.Value)
                                                                {
                                                                    <img src="~/assets/images/validateIcon2.png" />
                                                                }
                                                                else
                                                                {
                                                                    <img src="~/assets/images/Warning.png" />
                                                                }
                                                            }
                                                            else
                                                            {
