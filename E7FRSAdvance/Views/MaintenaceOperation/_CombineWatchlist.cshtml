@model Domain.Site

@{
    var clusters = new List<string>();
    var watchLists = new List<Domain.WatchList>();
    var mA10Status = new List<Domain.A10Status>();
    if (ViewBag.WatchLists != null)
    {
        watchLists = ViewBag.WatchLists as List<Domain.WatchList>;
        foreach (var watchList in watchLists)
        {
            if (!string.IsNullOrEmpty(watchList.ClusterName) && !clusters.Any(s => watchList.ClusterName.Contains(s)))
            {
                clusters.Add(watchList.ClusterName);
            }
        }
    }

    if (ViewBag.RFStatus != null)
    {
        mA10Status = ViewBag.RFStatus as List<Domain.A10Status>;
        if (mA10Status != null && mA10Status.Count > 0)
        {
            foreach (var a10Status in mA10Status)
            {
                string pattern = @"(_\d)$";
                string resulta10 = System.Text.RegularExpressions.Regex.Replace(a10Status.name, pattern, string.Empty);


                if (!string.IsNullOrEmpty(resulta10) && !clusters.Contains(resulta10))
                {
                    clusters.Add(resulta10);
                }


            }
        }
    }
}

<style>
