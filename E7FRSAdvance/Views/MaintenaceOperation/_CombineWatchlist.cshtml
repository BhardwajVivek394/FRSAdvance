<div class="modal fade" id="modal-combine-watchlist" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content">
            <div class="modal-header" style="padding: 15px 34px">

                <h5 class="modal-title" id="exampleModalLabel">
                    <span id="spHeader">@Model.Name</span>
                    <select class="form-select form-select-sm rounded-0 ww-100" onchange="fnChangeCombineWatchlistType(this,'@ViewBag.SiteId')">
                        @if (ViewBag.Type != null && ViewBag.Type == "List")
                        {
                            <option>Cluster Wise</option>
                            <option value="List" selected>List</option>
                            <option value="AssetType">Asset Type</option>
                        }
                        else if (ViewBag.Type != null && ViewBag.Type == "AssetType")
                        {
                            <option>Cluster Wise</option>
                            <option value="List">List</option>
                            <option value="AssetType" selected>Asset Type</option>
                        }
                        else
                        {
                            <option selected>Cluster Wise</option>
                            <option value="List">List</option>
                            <option value="AssetType">Asset Type</option>
                        }
                    </select>
                </h5>

                <h5 class="modal-title ms-auto" id="exampleModalToggleLabel">                     
                    <a href="@Url.Action("DownloadCombineWatchlist", new {SiteId = ViewBag.SiteId})" class="btn btn-primary" target="_blank">Download</a>
                    <a href="@Url.Action("CombineWatchlistPending", new {SiteId = ViewBag.SiteId})" class="btn btn-success" target="_blank">Pending</a>
                    <a href="@Url.Action("CombineWatchlistClear", new {SiteId = ViewBag.SiteId})" class="btn btn-info" target="_blank">Clear</a>
                    <span class="dateText">Creation @System.DateTime.Now.ToShortDateString()</span>
                    / @E7FRSAdvance.Utility.ClsHttpContent.LoginUser.FirstName @E7FRSAdvance.Utility.ClsHttpContent.LoginUser.LastName
                </h5>
                <button type="button" class="btn-close ml-12" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <div class="row">

                            <div class="col-12 mb-3">
                                @if (clusters != null && clusters.Count > 0)
                                {
                                    int watchlistTotalCount = 0;
                                    int mannualWatchlistTotalCount = 0;
                                    int frsWatchlistTotalCount = 0;
                                    int linkIssueTotalCount = 0;

                                    if (watchLists != null && watchLists.Count() > 0)
                                    {
                                        watchlistTotalCount = watchLists.Where(x => x.ClusterName != null && x.GeneratedFrom == "WatchList").Count();
                                        frsWatchlistTotalCount = watchLists.Where(x => x.ClusterName != null && x.GeneratedFrom == "FRSWatchList").Count();
                                        mannualWatchlistTotalCount = watchLists.Where(x => x.ClusterName != null && x.GeneratedFrom == "Mannual").Count();
                                        linkIssueTotalCount = mA10Status.Count();
                                    }
                                    <span class="pull-right">Watchlist - @watchlistTotalCount | FRS Watchlist - @frsWatchlistTotalCount | Mannual Watchlist - @mannualWatchlistTotalCount | Link Issue - @linkIssueTotalCount </span>
                                }
                            </div>

                            @if (ViewBag.Type != null && ViewBag.Type == "List")
                            {
