    function fnShowADCLinkIssue(siteId, cluster) {
        $("#loader").show();
        $.ajax({
            url: '/MaintenaceOperation/GetA10ADCLinkIssue',
            type: 'Post',
            data: '{siteId:' + siteId + ',clusterName:"' + cluster +'"}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();

                var productData = fnGetA10Product(siteId);
                var table = '<table class="table">';
                table += '<tr>';
                table += '<thead class="bg-primary">';
                table += '<th style="background-color:#215968;color:white;">id</th>';
                table += '<th style="background-color:#215968;color:white;">name</th>';
                table += '<th style="background-color:#215968;color:white;">last_response</th>';
                table += '<th style="background-color:#215968;color:white;" class="text-center">exceptions</th>';
                table += '<th style="background-color:#215968;color:white;" class="text-center">poll_time</th>';
                table += '<th style="background-color:#215968;color:white;" class="text-center">params</th>';
                table += '<th style="background-color:#215968;color:white;" class="text-center">type</th>';

                table += '<th style="background-color:#215968;color:white;" class="text-center">Modem Status</th>';
                table += '<th style="background-color:#215968;color:white;" class="text-center">Modem Id</th>';
                table += '<th style="background-color:#215968;color:white;" class="text-center">Modem Name</th>';
                table += '<th style="background-color:#215968;color:white;" class="text-center">Sim Number</th>';
                table += '<th style="background-color:#215968;color:white;" class="text-center">F/W Version</th>';
                table += '<th style="background-color:#215968;color:white;" class="text-center">Connector Status</th>';

                table += '</tr>';
                table += '</thead>';
                table += '<tbody>';
                var time = '';
                var currentDate = new Date();
                $(data).each(function (id, item) {
                    table += '<tr>';
                    table += '<td>' + item.id + '</td>';
                    table += '<td>' + item.name + '</td>';


                    if (item.last_response < 0) {
                        table += '<td class="text-danger">' + item.last_response + '</td>';
                    }
                    else if (item.last_response <= 15) {
                        table += '<td class="text-success">' + item.last_response + '</td>';
                    } else if (item.last_response > 15 && item.last_response < 50) {
                        table += '<td class="text-warning">' + item.last_response + '</td>';
                    } else if (item.last_response > 50) {
                        table += '<td class="text-danger">' + item.last_response + '</td>';
                    }

                    table += '<td class="text-center">' + item.exceptions + '</td>';
                    table += '<td class="text-center">' + item.poll_time + '</td>';

                    table += '<td class="text-center">' + item.paramsvalue + '</td>';
                    if (item.type != null && item.type != undefined && item.type != '') {
                        table += '<td class="text-center">' + item.type + '</td>';
                    } else {
                        table += '<td class="text-center"></td>';
                    }

                    var isInclude = false;
                    if (productData != null && productData.length > 0) {
                        $(productData).each(function (d, val) {

                            if (item.name.indexOf(val.ClusterName) != -1) {
                                isInclude = true;
                                if (val.Status != null) {
                                    if (val.Status == true) {
                                        table += '<td class="text-center"><span class="zheng_status_online" onclick="fnGetProductStatus(' + val.DeviceID + ')">online</span></td>';
                                    } else if (val.Status == false) {
                                        table += '<td class="text-center"><span class="zheng_status_offline" onclick="fnGetProductStatus(' + val.DeviceID + ')">offline</span></td>';
                                    }
                                } else {
                                    table += '<td class="text-center"></td>';
                                }
                                table += '<td class="text-center">' + val.DeviceID + '</td>';
                                table += '<td class="text-center">' + val.Name + '</td>';

                                if (val.SimNumber != null && val.SimNumber != undefined) {
                                    table += '<td class="text-center">' + val.SimNumber + '</td>';
                                } else {
                                    table += '<td class="text-center"></td>';
                                }

                                table += '<td class="text-center">' + val.Firmwareversion + '</td>';
                                if (val.ConnectorStatus != null && val.ConnectorStatus != undefined) {
                                    table += '<td class="text-center">' + val.ConnectorStatus + '</td>';
                                } else {
                                    table += '<td class="text-center"></td>';
                                }

                                return false;
                            }

                        });

                    }
                    if (!isInclude) {
                        table += '<td class="text-center"></td>';
                        table += '<td class="text-center"></td>';
                        table += '<td class="text-center"></td>';
