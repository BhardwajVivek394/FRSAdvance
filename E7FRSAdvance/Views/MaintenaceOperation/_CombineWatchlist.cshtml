                                                            }
                                                            else
                                                            {
                                                                <input type="text" class="form-control textareaK" id="txtCode@(idCluster)@(listcounter)">
                                                            }
                                                        </td>


                                                        <td>
                                                            <select class="form-select form-select-sm rounded-0 ww-100" id="drpMaintainerUsers@(idCluster)@(listcounter)" aria-label=".form-select-sm example">
                                                                <option value="">Select</option>
                                                                @if (ViewBag.MaintainerUsers != null)
                                                                {
                                                                    foreach (var maintainerUsers in ViewBag.MaintainerUsers as List<Domain.MaintainerUser>)
                                                                    {
                                                                        if (a10Status.MaintainerUserId != null && a10Status.MaintainerUserId == maintainerUsers.Id)
                                                                        {
                                                                            <option value="@maintainerUsers.Id" selected>@maintainerUsers.FirstName @maintainerUsers.LastName</option>
                                                                        }
                                                                        else
                                                                        {
