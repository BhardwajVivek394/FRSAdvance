                                            @if (clusters != null && clusters.Count > 0)
                                            {
                                                var assetTypes = watchLists.Where(x => x.ClusterName != null).GroupBy(x => new { x.AssetTypeId, x.AssetTypeName }).Select(x => x.Key).ToList();
