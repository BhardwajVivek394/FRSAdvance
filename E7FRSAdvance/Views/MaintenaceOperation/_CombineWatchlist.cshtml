                                                                            {
                                                                                <option value="@maintainerUsers.Id" selected>@maintainerUsers.FirstName @maintainerUsers.LastName</option>
                                                                            }
                                                                            else
                                                                            {
                                                                                <option value="@maintainerUsers.Id">@maintainerUsers.FirstName @maintainerUsers.LastName</option>
                                                                            }
                                                                        }
                                                                    }
                                                                </select>
                                                            </td>

                                                            <td class="text-center">
                                                                @if (item.IsResolved != null)
                                                                {
