    function fnShowCombineWatchListHistory(assetId, attributeId, a10Id) {
        var mSearchCriteria = {};
        mSearchCriteria.AssetId = assetId;
        mSearchCriteria.SiteId = '@ViewBag.SiteId';
        mSearchCriteria.AssetAttributeId = attributeId;
        mSearchCriteria.A10Id = a10Id;

        $("#loader").show();
        $.ajax({
            url: '/MaintenaceOperation/_CombineWatchListHistory',
            type: 'Post',
            data: JSON.stringify(mSearchCriteria),
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divCombineWatchListHistory").empty().append(data);
                $('#modal-combine-WatchList-history').modal('show');

            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

