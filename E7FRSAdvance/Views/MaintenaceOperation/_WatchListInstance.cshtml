@model  List<Domain.WatchList>

@{ 
    int counter = 0;
}

<div class="modal bounceIn animated" id="modal-WatchList-Instance" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Alert Instance</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">
                    <div class="col-12">
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th style="background-color: #215968;color:white;">Asset Type</th>
                                        <th style="background-color: #215968;color:white;">Asset</th>
                                        <th style="background-color: #215968;color:white;">Attribute</th>
                                        <th style="background-color: #215968;color:white;">Cluster</th>
                                        <th style="background-color: #215968;color:white;">Card</th>
                                        <th style="background-color: #215968;color:white;">ADC</th>
                                        <th style="background-color: #215968;color:white;">Pin</th>
                                        <th style="background-color: #215968;color:white;">Value</th>
                                        <th style="background-color: #215968;color:white;">Date</th>
                                        <th style="background-color: #215968;color:white;">Status</th>
                                        <th style="background-color: #215968;color:white;">Cause</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (var item in Model)
                                    {
                                        counter++;
                                        <tr class="cls-edit-watchlist" data-SiteId="@item.SiteId" data-AssetTypeId="@item.AssetTypeId" data-AttributeId="@item.AttributeId" data-AssetId="@item.AssetId" data-Created-Date="@item.CreatedDate">
                                            <td>@item.AssetTypeName</td>
                                            <td>@item.AssetName</td>
                                            <td>@item.AttributeName</td>
                                            <td>@item.ClusterName</td>
                                            <td>@item.CardName</td>
                                            <td>@item.ADCName</td>
                                            <td>@item.Pin</td>
                                            <td>@item.AttributeValue</td>
                                            <td>@item.CreatedDate</td>
                                            <td>@item.Status</td>
                                            <td>@item.Cause</td>


                                        </tr>
                                    }


                                </tbody>


                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>
<script>
    $(function () {
        $(".modal-dialog").draggable({
            handle: ".modal-header"
        });
    });
</script>
