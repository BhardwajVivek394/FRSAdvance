@model  List<Domain.SiteMaintenaceOperation>

<div class="modal bounceIn animated" id="modal-Exclude-Site" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-sm">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title">Include Site</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">
                    <div class="col-sm-12">

                        <div class="row">
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <div class="col-sm-12">
                                        <a href="javascript:void(0)" onclick="fnIncludeSite('@item.SiteId')"><i class="fa fa-plus"></i></a>
                                        <label>@item.SiteName</label>

                                    </div>
                                }
                            }

                        </div>


                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    function fnIncludeSite(siteId) {
        $("#loader").show();

        $.ajax({
            url: '/MaintenaceOperation/IncludeSite',
            type: 'Post',
            data: '{siteId:' + siteId + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                if (data != null) {
                    $('#modal-Exclude-Site').modal("hide");
                    CommonNotification("SUCCESS", data.result, "success");
                    $('#frmMaintenaceOperationList').submit();
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }
</script>