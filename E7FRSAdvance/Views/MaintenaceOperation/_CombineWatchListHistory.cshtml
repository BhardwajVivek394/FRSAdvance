@model Domain.SearchCriteria
@{
    bool recordNotFound = true;
}

<div class="modal bounceIn animated" id="modal-combine-WatchList-history" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Combine History</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">

                <div class="row">
                    <div class="col-12">
                        <a class="btn btn-success" href="javascript:void(0)" onclick="fnDownloadCombineHistory('@Model.SiteId','@Model.AssetId','@Model.AssetAttributeId','@Model.A10Id')">
                            <i class="fa fa-download"></i>
                        </a>
                    </div>
                    @if (ViewBag.CalibrationDetail != null)
                    {
                        var mCalibrationDetails = ViewBag.CalibrationDetail as List<Domain.CalibrationDetail>;
                        if (mCalibrationDetails != null && mCalibrationDetails.Count > 0)
                        {
                            recordNotFound = false;
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Calibration Detail</h5>
                                    </div>
                                    <div class="card-body">

                                        <table class="table">
                                            <thead class="bg-primary">
                                                <tr>
                                                    <th>RAILWAY</th>
                                                    <th>RDPMS</th>
                                                    <th>CALIBRATED</th>
                                                    <th>User Name</th>
                                                    <th>Created Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var cDetail in mCalibrationDetails)
                                                {
                                                    <tr>
                                                        <td>@cDetail.RailwayMultiplication</td>
                                                        <td>
                                                            <span><b>Val:</b> @(cDetail.RDPMSMultiplication * cDetail.RealTimeValue)</span> <br />
                                                            <span><b>Mul:</b> @(cDetail.RDPMSMultiplication)</span>
                                                        </td>
                                                        <td>
                                                            <span><b>Val:</b> @(cDetail.Multiplication * cDetail.RealTimeValue)</span><br />
                                                            <span><b>Mul:</b> @(cDetail.Multiplication)</span>
                                                        </td>
                                                        <td>@cDetail.UserName</td>
                                                        <td>@cDetail.CreatedDate.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                                                    </tr>
                                                }

                                            </tbody>

                                        </table>
                                    </div>
                                </div>

                            </div>
                        }

                    }


                    @if (ViewBag.CombineOverallTargets != null)
                    {
                        var mCombineOverallTargets = ViewBag.CombineOverallTargets as List<Domain.CombineOverallTarget>;
                        if (mCombineOverallTargets != null && mCombineOverallTargets.Count > 0)
                        {
                            recordNotFound = false;
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>WatchList</h5>
                                    </div>
                                    <div class="card-body">

                                        <table class="table">
                                            <thead class="bg-primary">
                                                <tr>
                                                    <th>Asset Type</th>
                                                    <th>Asset</th>
                                                    <th>Attribute</th>
                                                    <th>Validate Date</th>
                                                    <th>Validate Name</th>
                                                    <th>Resolved Date</th>
                                                    <th>Issue Type</th>
                                                    <th>Reason</th>
                                                    <th>Code</th>
                                                </tr>
                                            </thead>
                                            <tbody>

                                                @foreach (var item in mCombineOverallTargets)
                                                {
                                                    <tr class="table-light" data-id="@item.Id">
                                                        <td>@item.AssetTypeName</td>
                                                        <td>@item.AssetName</td>
                                                        <td>@item.AttributeName</td>
                                                        <td>@item.TimeStamp.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                                                        <td>@item.CreateName</td>
                                                        <td>
                                                            @if (item.ResolvedDate != null && @item.ResolvedDate.Value != DateTime.MinValue)
                                                            {
                                                                <span>@item.ResolvedDate.Value.ToString("dd/MM/yyyy hh:mm:ss tt")</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            <span>@item.IssueType</span>
                                                        </td>
                                                        <td>
                                                            @item.Reason
                                                        </td>
                                                        <td>
                                                            @item.MatrialCode
                                                        </td>

                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                            </div>
                        }

                    }


                    @if (ViewBag.CombineLiskIssueOverallTargets != null)
                    {
                        var mLiskIssueOverallTargets = ViewBag.CombineLiskIssueOverallTargets as List<Domain.CombineOverallTarget>;
                        if (mLiskIssueOverallTargets != null && mLiskIssueOverallTargets.Count > 0)
                        {
                            recordNotFound = false;
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Link Issue</h5>
                                    </div>
                                    <div class="card-body">
                                        <table class="table">
                                            <thead class="bg-primary">
                                                <tr>
                                                    <th>A10Id</th>
                                                    <th>Cluster</th>
                                                    <th>Modem</th>
                                                    <th>Modem Number</th>
                                                    <th>Connector status</th>
                                                    <th>Reason</th>
                                                    <th>Code</th>
                                                    <th>Validate Date</th>
                                                    <th>Validate Name</th>
                                                    <th>Resolved Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in mLiskIssueOverallTargets)
                                                {
                                                    <tr>
                                                        <td>@item.A10Id</td>
                                                        <td>@item.ClusterName</td>
                                                        <td>
                                                            @if (item.mProduct != null && item.mProduct.Status != null)
                                                            {
                                                                if (item.mProduct.Status.Value)
                                                                {
                                                                    <span class="yesno-green">online</span>
                                                                }
                                                                else
                                                                {
                                                                    <span class="yesno-red">offline</span>
                                                                }
                                                            }

                                                        </td>
                                                        <td>
                                                            @if (item.mProduct != null && item.mProduct.DeviceID != null)
                                                            {
                                                                <span>@item.mProduct.DeviceID</span>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (item.mProduct != null)
                                                            {
                                                                if (!string.IsNullOrEmpty(item.mProduct.ConnectorStatus))
                                                                {
                                                                    if (item.mProduct.ConnectorStatus.Trim().ToLower() == "yes")
                                                                    {
                                                                        <span class="yesno-green">@item.mProduct.ConnectorStatus</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="yesno-red">@item.mProduct.ConnectorStatus</span>
                                                                    }
                                                                }
                                                            }
                                                        </td>
                                                        <td>
                                                            @item.Reason
                                                        </td>
                                                        <td>
                                                            @item.MatrialCode
                                                        </td>
                                                        <td>
                                                            @item.TimeStamp.ToString("dd/MM/yyyy hh:mm:ss tt")
                                                        </td>
                                                        <td>
                                                            @item.CreateName
                                                        </td>

                                                        <td>
                                                            @if (item.ResolvedDate != null && item.ResolvedDate.Value != DateTime.MinValue)
                                                            {
                                                                <span>@item.ResolvedDate.Value.ToString("dd/MM/yyyy hh:mm:ss tt")</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }


                    }

                    @if (recordNotFound)
                    {
                        <div class="text-center">
                            <h6>Record Not Found</h6>
                        </div>
                    }
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
