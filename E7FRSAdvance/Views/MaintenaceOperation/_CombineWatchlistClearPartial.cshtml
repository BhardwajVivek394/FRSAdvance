@model List<Domain.CombineOverallTarget>

@{
    int counter = 1;
}

<div class="row">

    @if (Model != null && Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.LinkIssue).Count() > 0)
    {
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h5>Link Issue</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead class="bg-primary">
                            <tr>
                                <th>Sr no.</th>
                                <th>A10Id</th>
                                <th>Cluster</th>
                                <th>Modem</th>
                                <th>Modem Number</th>
                                <th>Connector status</th>
                                <th>Reason</th>
                                <th>Code</th>
                                <th>Resolved Date</th>
                                <th>Validate Date</th>
                                <th>Validate Name</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.LinkIssue).ToList())
                            {
                                <tr class="table-light" data-id="@item.Id">
                                    <td>@counter</td>
                                    <td>@item.A10Id</td>
                                    <td>@item.ClusterName</td>
                                    <td>
                                        @if (item.mProduct != null && item.mProduct.Status != null)
                                        {
                                            if (item.mProduct.Status.Value)
                                            {
                                                <span class="yesno-green">online</span>
                                            }
                                            else
                                            {
                                                <span class="yesno-red">offline</span>
                                            }
                                        }

                                    </td>
                                    <td>
                                        @if (item.mProduct != null && item.mProduct.DeviceID != null)
                                        {
                                            <span>@item.mProduct.DeviceID</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.mProduct != null)
                                        {
                                            if (!string.IsNullOrEmpty(item.mProduct.ConnectorStatus))
                                            {
                                                if (item.mProduct.ConnectorStatus.Trim().ToLower() == "yes")
                                                {
                                                    <span class="yesno-green">@item.mProduct.ConnectorStatus</span>
                                                }
                                                else
                                                {
                                                    <span class="yesno-red">@item.mProduct.ConnectorStatus</span>
                                                }
                                            }
                                        }
                                    </td>
                                    <td>
                                        @item.Reason
                                    </td>
                                    <td>
                                        @item.MatrialCode
                                    </td>
                                    <td>
                                        @if (item.ResolvedDate != null && item.ResolvedDate.Value != DateTime.MinValue)
                                        {
                                            <span>@item.ResolvedDate.Value.ToString("dd/MM/yyyy hh:mm:ss tt")</span>
                                        }
                                    </td>
                                    <td>
                                        @item.TimeStamp.ToString("dd/MM/yyyy hh:mm:ss tt")
                                    </td>
                                    <td>
                                        @item.CreateName
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ForceResolvedRemark))
                                        {
                                            <a title="Show Force Resolved Remark" onclick="fnShowCombineOverallTarget('@item.Id')">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                        }
                                    </td>

                                </tr>
                                counter++;
                            }
                        </tbody>
                    </table>

                </div>
            </div>

        </div>
    }


    @if (Model != null && Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.WatchLists).Count() > 0)
    {
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h5>Watchlist</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead class="bg-primary">
                            <tr>
                                <th>Sr no.</th>
                                <th>Asset Type</th>
                                <th>Asset</th>
                                <th>Attribute</th>
                                <th>Cluster</th>
                                <th>Card</th>
                                <th>ADC</th>
                                <th>Pin</th>
                                <th>Value</th>
                                <th>Resolved Date</th>
                                <th>Validate Date</th>
                                <th>Validate Name</th>
                                <th>Issue Type</th>
                                <th>Reason</th>
                                <th>Code</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.WatchLists).ToList())
                            {
                                <tr class="table-light" data-id="@item.Id">
                                    <td>@counter</td>
                                    <td>@item.AssetTypeName</td>
                                    <td>@item.AssetName</td>
                                    <td>@item.AttributeName</td>
                                    <td>@item.Cluster</td>
                                    <td>@item.Card</td>
                                    <td>@item.ADCId</td>
                                    <td>@item.Pin</td>
                                    <td>@item.Value</td>
                                    <td>
                                        @if (item.ResolvedDate != null && item.ResolvedDate.Value != DateTime.MinValue)
                                        {
                                            <span>@item.ResolvedDate.Value.ToString("dd/MM/yyyy hh:mm:ss tt")</span>
                                        }
                                    </td>
                                    <td>@item.TimeStamp.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                                    <td>@item.CreateName</td>
                                    <td>
                                        <span>@item.IssueType</span>
                                    </td>
                                    <td>
                                        @item.Reason

                                    </td>
                                    <td>
                                        @item.MatrialCode
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ForceResolvedRemark))
                                        {
                                            <a title="Show Force Resolved Remark" onclick="fnShowCombineOverallTarget('@item.Id')">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                        }

                                    </td>

                                </tr>
                                counter++;
                            }
                        </tbody>
                    </table>

                </div>
            </div>

        </div>
    }


    @if (Model != null && Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.FRSWatchList).Count() > 0)
    {
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h5>FRS Watch List</h5>
                </div>
                <div class="card-body">
                    <table class="table">
                        <thead class="bg-primary">
                            <tr>
                                <th>Sr no.</th>
                                <th>Asset Type</th>
                                <th>Asset</th>
                                <th>Attribute</th>
                                <th>Cause Code</th>
                                <th>Description</th>
                                <th>Resolved Date</th>
                                <th>Validate Date</th>
                                <th>Validate Name</th>
                                <th>Issue Type</th>
                                <th>Reason</th>
                                <th>Code</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.FRSWatchList).ToList())
                            {
                                <tr class="table-light" data-id="@item.Id">
                                    <td>@counter</td>
                                    <td>@item.AssetTypeName</td>
                                    <td>@item.AssetName</td>
                                    <td>@item.AttributeName</td>
                                    <td>@item.CauseCode</td>
                                    <td>@item.Description</td>
                                    <td>
                                        @if (item.ResolvedDate != null && item.ResolvedDate.Value != DateTime.MinValue)
                                        {
                                            <span>@item.ResolvedDate.Value.ToString("dd/MM/yyyy hh:mm:ss tt")</span>
                                        }
                                    </td>
                                    <td>@item.TimeStamp.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                                    <td>@item.CreateName</td>
                                    <td>
                                        <span>@item.IssueType</span>
                                    </td>
                                    <td>
                                        @item.Reason
                                    </td>
                                    <td>
                                        @item.MatrialCode
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ForceResolvedRemark))
                                        {
                                            <a title="Show Force Resolved Remark" onclick="fnShowCombineOverallTarget('@item.Id')">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                        }

                                    </td>


                                </tr>
                                counter++;
                            }
                        </tbody>
                    </table>

                </div>
            </div>

        </div>
    }


</div>
