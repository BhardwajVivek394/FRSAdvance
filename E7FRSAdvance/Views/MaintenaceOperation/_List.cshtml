<script src="~/assets/js/chart/echart/echarts.js"></script>

<script>
    var mQQTPaths = [];
    var sites = [];
    var mQTT = null;
    var pmchart;
    var productData = [];
    $(document).ready(function () {

        $('#searchA10Date').datepicker({
            dateFormat: 'd/m/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('[data-bs-toggle="popover"]').popover();

        GetDivisionByZone($("#zoneAdd1").val());

        $("#zoneAdd1").change(function () {
            GetDivisionByZone($(this).val());

            //$("#frmMaintenaceOperationList").submit();
        });

        $('.th-count').click(function () {
            var table = $(this).parents('table').eq(0)
            var rows = table.find('tr:gt(0)').toArray().sort(comparer($(this).index()))
            this.asc = !this.asc
            if (!this.asc) { rows = rows.reverse() }
            var th = $(this);
            th.siblings().find(".sort-symbol").remove();
            th.find('.sort-symbol').remove();
            th.append(`<span class="sort-symbol">${this.asc ? '▲' : '▼'}</span>`);
            for (var i = 0; i < rows.length; i++) { table.append(rows[i]) }
        })

        json = @Html.Raw(Json.Encode(Model));

        mQTT = @Html.Raw(Json.Encode(ViewBag.MQTTDetail));

        if (json != null && json.mMaintenaceOperations != null && json.mMaintenaceOperations != undefined) {
            $(json.mMaintenaceOperations).each(function (v, text) {
                mQQTPaths.push(text.MQTTBasePath);
                sites.push(text.SiteName);
            });

        }

        let isSecure = window.location.protocol === "https:";
        client = new Paho.Client(mQTT.MQTTUri, mQTT.MQTTPort, "clientId" + Math.ceil(Math.random() * 10000));

        client.onConnectionLost = onConnectionLost;
        client.onMessageArrived = onMessageArrived;

        client.connect({
            onSuccess: onConnect,
            useSSL: isSecure,
            userName: mQTT.MQTTUsername,
            password: mQTT.MQTTPassword,
            cleanSession: true
        });
    });

    function onConnect() {
        // Once a connection has been made, make a subscription and send a message.
        //client.subscribe('/WR/Mumbai/Surat/a10');
        for (var i = 0; i < mQQTPaths.length; i++) {
            if (mQQTPaths[i] != null && mQQTPaths[i] != "null" && mQQTPaths[i] != "") {
                client.subscribe(mQQTPaths[i] + 'a10');

            }
        }
    }

    // called when the client loses its connection
    function onConnectionLost(responseObject) {
        if (responseObject.errorCode !== 0) {
            console.log("onConnectionLost:" + responseObject.errorMessage);
            //location.reload();
        }
        client.connect({
            onSuccess: onConnect,
            userName: "wattmon",
            password: "wattmon_2018",
            cleanSession: true
        });
    }

    // called when a message arrives
    function onMessageArrived(message) {
        if (message.payloadString.includes("devices")) {
            var parseJson = JSON.parse(message.payloadString);
            if (parseJson != null && parseJson != undefined && parseJson != '') {
                var array = parseJson['devices'];
                if (array != null && array != undefined && array.length > 0) {
                    BindA10Data(message.destinationName, array);
                }
            }
        }

        //var d = new Date();
        //var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
        //$("#c0").html(time);

    }

    function BindA10Data(basePath, data) {
        if (data != null && data.length > 0) {
            var count = 0;
            var table = '<table class="table">';
            table += '<tr>';
            table += '<thead class="bg-primary">';
            table += '<th style="background-color:#215968;color:white;">id</th>';
            table += '<th style="background-color:#215968;color:white;">name</th>';
            table += '<th style="background-color:#215968;color:white;">last_response</th>';
            table += '<th style="background-color:#215968;color:white;" class="text-center">status</th>';
            table += '<th style="background-color:#215968;color:white;" class="text-center">exceptions</th>';
            table += '<th style="background-color:#215968;color:white;" class="text-center">poll_time</th>';
            table += '<th style="background-color:#215968;color:white;" class="text-center">params</th>';
            table += '<th style="background-color:#215968;color:white;" class="text-center">type</th>';

            table += '<th style="background-color:#215968;color:white;" class="text-center">Modem Status</th>';
            table += '<th style="background-color:#215968;color:white;" class="text-center">Modem Id</th>';
            table += '<th style="background-color:#215968;color:white;" class="text-center">Modem Name</th>';
            table += '<th style="background-color:#215968;color:white;" class="text-center">Sim Number</th>';
            table += '<th style="background-color:#215968;color:white;" class="text-center">F/W Version</th>';
            table += '<th style="background-color:#215968;color:white;" class="text-center">Connector Status</th>';

            table += '</tr>';
            table += '</thead>';
            table += '<tbody>';

            $(data).each(function (id, item) {

                var seconds = parseFloat(item.last_response);       
               
                if (parseInt(item.id) > 0 && (seconds > 50 || seconds < 0)) {
                    count++;

                    table += '<tr>';
                    table += '<td>' + item.id + '</td>';
                    table += '<td>' + item.name + '</td>';
                    table += '<td class="text-danger" onclick="fnShowA10Graph(' + item.id + ')">' + seconds + '</td>';
                    table += '<td class="text-danger text-center">Error</td>';
                    table += '<td class="text-center">' + item.exceptions + '</td>';
                    table += '<td class="text-center">' + item.poll_time + '</td>';


                    var param = parseInt(item.params);
                    var minusparam = param - 1;
                    if (param == 0) {
                        table += '<td class="text-center">Wm1</td>';
                    } else if (param == 1) {
                        table += '<td class="text-center">Wm2</td>';
                    } else if (param > 1) {
                        table += '<td class="text-center">TCP' + minusparam + '</td>';
                    }

                    if (item.type != null && item.type != undefined && item.type != '') {
                        table += '<td class="text-center">' + item.type + '</td>';
                    } else {
                        table += '<td class="text-center"></td>';
                    }


                    var isInclude = false;
                    if (productData != null && productData.length > 0) {
                        $(productData).each(function (d, val) {
                            if (item.name.indexOf(val.ClusterName) != -1) {
                                isInclude = true;
                                if (val.Status != null) {
                                    if (val.Status == true) {
                                        table += '<td class="text-center"><span class="zheng_status_online" onclick="fnGetProductStatus(' + val.DeviceID +')">online</span></td>';
                                    } else if (val.Status == false) {
                                        table += '<td class="text-center"><span class="zheng_status_offline" onclick="fnGetProductStatus(' + val.DeviceID +')">offline</span></td>';
                                    }
                                } else {
                                    table += '<td class="text-center"></td>';
                                }
                                table += '<td class="text-center">' + val.DeviceID + '</td>';
                                table += '<td class="text-center">' + val.Name + '</td>';
                                if (val.SimNumber != null && val.SimNumber != undefined) {
                                    table += '<td class="text-center">' + val.SimNumber + '</td>';
                                } else {
                                    table += '<td class="text-center"></td>';
                                }
                                table += '<td class="text-center">' + val.Firmwareversion + '</td>';
                                if (val.ConnectorStatus != null && val.ConnectorStatus != undefined) {
                                    table += '<td class="text-center">' + val.ConnectorStatus + '</td>';
                                } else {
                                    table += '<td class="text-center"></td>';
                                }



                                return false;
                            }

                        });

                    }
                    if (!isInclude) {
                        table += '<td class="text-center"></td>';
                        table += '<td class="text-center"></td>';
                        table += '<td class="text-center"></td>';
                        table += '<td class="text-center"></td>';
                        table += '<td class="text-center"></td>';
                        table += '<td class="text-center"></td>';
                    }

                    table += '</tr>';

                    BindRFStatusLive(item);
                }
            });

            table += '</tbody>';
            table += '</table>';

            if ($('#divModalA10Status_' + basePath.replaceAll(" ", "").replaceAll("/", "")).length > 0) {
                $('#divModalA10Status_' + basePath.replaceAll(" ", "").replaceAll("/", "")).empty().append(table);

                var d = new Date();
                var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
                $("#A10StatusheaderTime").html(time);
            }
            $('#spnLinkIssue_' + basePath.replaceAll(" ", "").replaceAll("/", "")).text(count);
            $('#hdnLinkIssue_' + basePath.replaceAll(" ", "").replaceAll("/", "")).val(count);


        }

    }

    function BindRFStatusLive(item) {
        $('.tbodyRFStatus tr').each(function () {
            //$(this).find("td").eq(0).html('');
            var clusterName = $.trim($(this).find("td").eq(2).html());
            if (clusterName != null && clusterName != undefined && clusterName != '') {
                var clsname = item.name.replaceAll('/', '_');
                if (clsname == clusterName) {
                    $(this).find("td").eq(0).html('<img src="/assets/images/Live.png" />');

                } else {
                    //$(this).find("td").eq(0).html('');
                }
            }


        });
    }

    function fnSearch() {
        $("#frmMaintenaceOperationList").submit();
    }

    function fnLoadAlert(siteId) {
        var mSMSLogLister = {};
        var searchCriteria = {};

        searchCriteria.SiteId = siteId;
        mSMSLogLister.SearchCriteria = searchCriteria;

        $("#loader").show();
        $.ajax({
            url: "/MaintenaceOperation/_AlertList",
            type: "POST",
            data: '{mSMSLogLister:' + JSON.stringify(mSMSLogLister) + '}',
            contentType: 'application/json',
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divPreviousDaySMSLog").empty().append(data);
                $("#modalProbabilityAlert").modal("show");

            },
            error: function (xhr, error, status) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "Error");
            }
        });


    }

    function fnLoadLast30Alert(siteId) {
        var mSMSLogLister = {};
        var searchCriteria = {};

        searchCriteria.SiteId = siteId;
        mSMSLogLister.SearchCriteria = searchCriteria;

        $("#loader").show();
        $.ajax({
            url: "/MaintenaceOperation/_Last30AlertList",
            type: "POST",
            data: '{mSMSLogLister:' + JSON.stringify(mSMSLogLister) + '}',
