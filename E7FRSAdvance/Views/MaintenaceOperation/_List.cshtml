        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title">A10 Status - <span id="A10Statusheader"></span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div>
                    <h5>
                        Last Update :  <span id="A10StatusheaderTime"></span>
                    </h5>

                </div>
                <div id="divModalA10Status" class="mt-2 tablemodalFixHead table-responsive">

                </div>
            </div>
