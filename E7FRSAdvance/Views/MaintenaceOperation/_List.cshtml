    function fnGetDarkColor() {
        var allowed = "ABCDEF0123456789", S = "#";

        while (S.length < 7) {
            S += allowed.charAt(Math.floor((Math.random() * 16) + 1));
        }
        return S;
    }

    function parseJsonDate(jsonDateString) {
        return moment(jsonDateString).format("HH:MM:SS").toUpperCase();
    }

    function parseDate(dateString) {
        if (!dateString) return new Date(0);

        var [date, time] = dateString.split(' ');
        if (!time) {
            time = "00:00:00";
        }
        var [month, day, year] = date.split('/');
        var [hours, minutes, seconds] = time.split(':');
        if (isNaN(month) || isNaN(day) || isNaN(year) || isNaN(hours) || isNaN(minutes) || isNaN(seconds)) {
            return new Date(0);
        }
        return new Date(year, month - 1, day, hours, minutes, seconds);
    }

    function sortTable(columnIndex) {
        var table = $("#myTable");
        var rows = table.find("tbody tr").get();
        var isAscending = table.hasClass("ascending");
        rows.sort(function (a, b) {
            var dateA = parseDate($(a).find("td").eq(columnIndex).text().trim());
            var dateB = parseDate($(b).find("td").eq(columnIndex).text().trim());
            return isAscending ? dateA - dateB : dateB - dateA;
        });
        $.each(rows, function (index, row) {
            table.find("tbody").append(row);
        });


        table.toggleClass("ascending", !isAscending);
    }

    function comparer(index) {
        return function (a, b) {
            var valA = getCellValue(a, index), valB = getCellValue(b, index)
            return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
        }
    }

    function getCellValue(row, index)
    {
        return $(row).children('td').eq(index).find('input[type=hidden]').val();
    }

