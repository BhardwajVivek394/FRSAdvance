                        <input type="hidden" class="form-control" id="hdnA10Id" />
                        <input type="hidden" class="form-control" id="hdnA10SiteId" />
                    </div>
                    <div class="col-lg-10">
                        <button type="button" class="btn btn-success pull-left mt-4" onclick="fnShowA10Graph()">Search</button>

