    function fnUpdateTabulationRemark(siteId, assetId, alertId) {
        var AlertAudit = {};
        var isValid = true;
        AlertAudit.SiteId = siteId
        AlertAudit.AssetId = assetId
        AlertAudit.AlertId = alertId;
        AlertAudit.Remark = $('#txtAlertRemark' + assetId + alertId).val();
        if ($("#drpAlertType" + assetId + alertId).val() == 'True') {
            AlertAudit.IsAlert = true;
            AlertAudit.Remark = '';
        } else {
            AlertAudit.IsAlert = false;
        }
        AlertAudit.IsOpenClose = true;


        if (!AlertAudit.IsAlert && (AlertAudit.Remark == null || AlertAudit.Remark == undefined || AlertAudit.Remark == '')) {
            isValid = false;
            alert('Remark is required!')
        }

        if (isValid) {
            $("#loader").show();
            $.ajax({
                url: '/Maintenace/UpdateTabulationAlertRemark',
                type: 'Post',
                data: '{mAlertAudit:' + JSON.stringify(AlertAudit) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            //CommonNotification("SUCCESS", data.result, "success");
                            $('#txtAlertRemark' + assetId + alertId).val('')
                            alert(data.result)
                        } else {
                            alert(data.result)
                            //CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function fnUpdateAllTabulationRemark() {
        var mAlertAudits = [];
        $('.clsDrpAlertType').each(function () {
            var isValid = true;
            var siteid = $(this).data('siteid');
            var alertTypeId = $(this).data('alerttypeid');
            var assetId = $(this).data('assetid');

            var AlertAudit = {};
            AlertAudit.SiteId = siteid
            AlertAudit.AssetId = assetId
            AlertAudit.AlertId = alertTypeId;
            AlertAudit.Remark = $('#txtAlertRemark' + assetId + alertTypeId).val();

            if ($("#drpAlertType" + assetId + alertTypeId).val() == 'True') {
                AlertAudit.IsAlert = true;
                AlertAudit.Remark = '';
            } else {
                AlertAudit.IsAlert = false;
            }
            AlertAudit.IsOpenClose = true;

            if ($("#drpAlertType" + assetId + alertTypeId).val() == 'False') {
                if (AlertAudit.Remark == null || AlertAudit.Remark == undefined || AlertAudit.Remark == '') {
                    isValid = false;
                }
            }
            if (isValid) {
                mAlertAudits.push(AlertAudit);
            }
        });

        if (mAlertAudits != null && mAlertAudits.length > 0) {
            $("#loader").show();
            $.ajax({
                url: '/Maintenace/UpdateAllTabulationAlertRemark',
                type: 'Post',
                data: '{mAlertAudits:' + JSON.stringify(mAlertAudits) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        $('#modalProbabilityAlert').modal('hide');
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                        } else {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            alert('Select at least one remark.')
        }
    }

