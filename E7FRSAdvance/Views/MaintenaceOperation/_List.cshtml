@model Domain.MaintenaceOperationLister

<div class="container-fluid">
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-xl-12">
                            <div class="row">
                                <div class="col-lg-2">
                                    <strong style="margin-top:10px;">Zone</strong>
                                    @Html.DropDownListFor(m => m.SearchCriteria.ZoneId, (IEnumerable<SelectListItem>)ViewBag.Zones, new { @class = "form-control", id = "zoneAdd1", tabindex = 1 })
                                </div>
                                <div class="col-lg-2">
                                    <strong style="margin-top:10px;">Division</strong>
                                    <input type="hidden" id="hdnSearchDivisionId" value="@Model.SearchCriteria.DivisionId" />
                                    @Html.DropDownListFor(m => m.SearchCriteria.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, new { @class = "form-control", id = "divisions", tabindex = 1 })
                                </div>
                                <div class="col-lg-8">
                                    <a class="btn btn-success btn-quirk mt-4" onclick="fnSearch()">Search</a>
                                    <a class="btn btn-success btn-quirk mt-4" onclick="fnGetExcludeSite()">Include Site</a>
                                    <a class="btn btn-info btn-quirk mt-4" href="@Url.Action("Index","JobCardMaster")" target="_blank">Job Card</a>
                                    @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode())
                                    {
                                        <a class="btn btn-info btn-quirk mt-4" href="@Url.Action("QualityAssurance","JobCard")" target="_blank">Q/A</a>
                                    }
                                    <a class="btn btn-info btn-quirk mt-4" href="@Url.Action("Index","DivisionDashboard")" target="_blank">Division Dashboard</a>
                                    <a class="btn btn-info btn-quirk mt-4" href="@Url.Action("Index","AlertAnalysis")" target="_blank">Alert Analysis</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive tableFixHead">
                        <table id="myTable" class="table">
                            <thead>
                                <tr>
                                    <th style="background-color:#215968;color:white;"></th>
                                    <th style="background-color:#215968;color:white;"></th>
                                    <th style="background-color:#215968;color:white;"></th>
                                    <th style="background-color:#215968;color:white;"></th>
                                    <th style="background-color:#4bacc6;color:white;" class="th-count">Site Name</th>
                                    <th style="background-color:#215968;color:white;" class="th-count">Status</th>
                                    <th style="background-color:#4bacc6;color:white;" onclick="sortTable(6)">Point Last Update</th>
                                    <th style="background-color:#215968;color:white;" onclick="sortTable(7)">MqttLog</th>
                                    <th style="background-color:#4bacc6;color:white;" onclick="sortTable(8)">PLClog</th>
                                    <th style="background-color:#215968;color:white;" width="300">A10 Cal</th>
                                    <th style="background-color:#4bacc6;color:white;" width="300">Backup</th>
                                    <th style="background-color: #215968; color: white; " class="th-count text-center">A10 Status</th>
                                    <th style="background-color: #4bacc6; color: white;" class="th-count text-center">Watchlist</th>
                                    <th style="background-color: #215968; color: white;" class="th-count text-center">Manually Watchlist</th>
                                    <th style="background-color: #4bacc6; color: white;" class="th-count text-center">FRS Watchlist</th>
                                    <th style="background-color: #215968; color: white;" class="th-count text-center">FRS True Alert</th>
                                    <th style="background-color: #4bacc6; color: white;" class="th-count text-center">Previous day alert count</th>
                                    <th style="background-color: #215968; color: white;" class="th-count text-center">Previous day Reboot Total</th>
                                    <th style="background-color: #4bacc6; color: white;" class="th-count text-center">Previous Day Division Count</th>
                                    <th style="background-color: #215968; color: white;" class="text-center">User Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.mMaintenaceOperations != null && Model.mMaintenaceOperations.Count > 0)
                                {
                                    foreach (var item in Model.mMaintenaceOperations)
                                    {
                                        <tr>
                                            <td>
                                                <a href="javascript:void(0)" title="Exclude" onclick="fnExcludeSite('@item.SiteId')"><i class="fa fa-minus"></i></a>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Index", "JobCard", new {siteId = item.SiteId})" title="Job Card" target="_blank"><i class="fa fa-file"></i></a>
                                            </td>
                                            <td>
                                                <img src="~/assets/images/combine.jpg" height="20" title="Combine Watchlist" onclick="fnShowCombineWatchlist('@item.SiteId')"/>
                                                @*<a href="javascript:void(0)" title="Combine Watchlist" onclick="fnShowCombineWatchlist('@item.SiteId')"><i class="fa fa-file text-info"></i></a>*@
                                            </td>
                                            <td>
                                                @if (item.JobCardStatus == 1)
                                                {
                                                    <img src="@Url.Content("~/assets/images/JobCard/Lock_green.png")" style="height:18px" />
                                                }
                                                else if (item.JobCardStatus == 2)
                                                {
                                                    <img src="@Url.Content("~/assets/images/JobCard/Unlock_Yellow.png")" style="height: 18px" />
                                                }
                                                else if (item.JobCardStatus == 3)
                                                {
                                                    <img src="@Url.Content("~/assets/images/JobCard/Unlock_blue.png")" style="height: 18px" />
                                                }
                                            </td>
                                            <td>
                                                <span>
                                                    @if (!string.IsNullOrEmpty(item.MacId))
                                                    {
                                                        <a href="http://energy7.org:7001/@(item.MacId)/" target="_blank">@item.SiteName</a>
                                                    }
                                                    else
                                                    {
                                                        @item.SiteName
                                                    }
                                                </span>
                                                @if (!string.IsNullOrEmpty(item.RouterId) || !string.IsNullOrEmpty(item.MobileNumber))
                                                {
                                                    <h5><i class="fa fa-info-circle" aria-hidden="true" data-bs-trigger="hover" data-container="body" data-bs-toggle="popover" data-bs-html="true" data-bs-placement="top" data-bs-original-title="Site Data" data-bs-content="<p>Router: @item.RouterId</p><p>MobileNumber: @item.MobileNumber</p>"></i></h5>
                                                }
                                                <input type="hidden" value="@item.SiteName" />
                                            </td>

                                            <td>
                                                @if (item.SiteStatus)
                                                {
                                                    @*<span>Active</span>*@
                                                    <h5><i class="fa fa-check-circle text-success" aria-hidden="true"></i></h5>
                                                    <input type="hidden" value="1" />
                                                }
                                                else
                                                {
                                                    <h5><i class="fa fa-exclamation-triangle text-danger" aria-hidden="true" data-bs-trigger="hover" data-container="body" data-bs-toggle="popover" data-bs-html="true" data-bs-placement="top" data-bs-original-title="Rf Down"></i></h5>
                                                    <input type="hidden" value="0" />
                                                }
                                            </td>
                                            <td>
                                                @if (item.PointLastUpdate != null && item.PointLastUpdate != DateTime.MinValue)
                                                {
                                                    <span>@item.PointLastUpdate.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                                }

                                            </td>


                                            <td>
                                                @if (item.MqttLog != null && item.MqttLog != DateTime.MinValue)
                                                {
                                                    <span>@item.MqttLog.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                                }

                                            </td>
                                            <td>
                                                @if (item.PLClog != null && item.PLClog != DateTime.MinValue)
                                                {
                                                    <span>@item.PLClog.ToString("dd/MM/yyyy HH:mm:ss")</span>
                                                }
                                            </td>
                                            <td>
                                                @item.A10CalibrationLastUpdate
                                            </td>
                                            <td>
                                                @item.A10BackupLastUpdate
                                            </td>
                                            @*<td class="text-center">
            <a href="javascript:void(0)" onclick="fnShowRFStatus('@item.SiteId')">@item.LinkIssueCount</a>
            <input type="hidden" value="@item.LinkIssueCount" />
        </td>*@
                                            <td class="text-center">
                                                <a id="spnLinkIssue_@(item.MQTTBasePath.Replace(" ","").Replace("/",""))a10" href="javascript:void(0)" onclick="fnShowA10Status('@(item.MQTTBasePath.Replace(" ","").Replace("/",""))','@item.SiteName','@item.SiteId')"></a>
                                                <input type="hidden" id="hdnLinkIssue_@(item.MQTTBasePath.Replace(" ","").Replace("/",""))a10" />
                                            </td>
                                            <td class="text-center">
                                                <a href="javascript:void(0)" onclick="fnShowWatchList('@item.SiteId')">
                                                    @item.WatchlistCount
                                                </a>
                                                <input type="hidden" value="@item.WatchlistCount" />
                                            </td>
                                            <td class="text-center">
                                                <a href="javascript:void(0)" onclick="fnShowUserWatchList('@item.SiteId')">
                                                    @item.WatchlistUserCount
                                                </a>
                                                <input type="hidden" value="@item.WatchlistUserCount" />
                                            </td>
                                            <td class="text-center">
                                                <a href="javascript:void(0)" onclick="fnShowFRSWatchList('@item.SiteId')">
                                                    @item.FRSWatchListCount
                                                </a>
                                                <input type="hidden" value="@item.FRSWatchListCount" />
                                            </td>
                                            <td class="text-center">
                                                <a href="javascript:void(0)" onclick="fnShowFRSWatchTrueList('@item.SiteId')">
                                                    @item.FRSWatchListTrueCount
                                                </a>
                                                <input type="hidden" value="@item.FRSWatchListTrueCount" />
                                            </td>
                                            <td class="text-center">
                                                <a href="javascript:void(0)" onclick="fnLoadAlert('@item.SiteId')">
                                                    @item.PreviousDayAlertCount
                                                </a>
                                                <input type="hidden" value="@item.PreviousDayAlertCount" />
                                            </td>
                                            <td class="text-center">
                                                <a href="javascript:void(0)" onclick="fnShowRebootTotal('@item.SiteId')">
                                                    @item.PreviousDayRebootTotal
                                                </a>
                                                <input type="hidden" value="@item.PreviousDayRebootTotal" />
                                            </td>
                                            <td class="text-center">
                                                <a href="javascript:void(0)" onclick="fnShowPreviousDayDivisionCount('@item.DivisionId','@item.SiteId')">
                                                    @item.PreviousDayDivisionCount
                                                </a>
                                                <input type="hidden" value="@item.PreviousDayDivisionCount" />
                                            </td>
                                            @*<td class="text-center">@item.Past30DaysDivisonPDFCount</td>*@
                                            <td class="text-center"></td>
                                        </tr>
                                    }
                                }

                            </tbody>


                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

