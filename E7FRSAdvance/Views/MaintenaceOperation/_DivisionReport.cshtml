@model Domain.DivisionReportModelLister

<div class="modal bounceIn animated" id="modal-division-report-model" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Division Report</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="row">
                    <div class="col-sm-12">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Time Stamp</th>
                                    <th>Asset Type</th>
                                    <th>Asset</th>
                                    <th>Threshold Violations</th>
                                    <th>UnderAIModels</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.DivisionReportModels != null && Model.DivisionReportModels.Count() > 0)
                                {
                                    foreach (var item in Model.DivisionReportModels)
                                    {
                                        <tr>
                                            <td>@item.TimeStamp</td>
                                            <td>@item.AssetTypeName</td>
                                            <td>@item.AssetName</td>
                                            <td>@item.ThresholdViolations</td>
                                            <td>@item.UnderAIModels</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>


            </div>
            <div class="modal-footer">
                <button class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</button>
            </div>
        </div>
    </div>
</div>


