


<div class="modal bounceIn animated" id="modelAddRemark" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modalConfirm-dialog">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title">Add Remark</h4>

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>

            <div class="modal-body">
                <textarea class="form-control mt-3 txtRemark_@ViewBag.jobCardDescriptionId" rows="7"></textarea>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSaveJobCardDescriptionRemark(@ViewBag.jobCardDescriptionId)">Save</button>
            </div>
        </div>
    </div>
</div>
