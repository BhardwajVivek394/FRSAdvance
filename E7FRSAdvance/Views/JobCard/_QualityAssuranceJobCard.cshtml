@model List<Domain.JobCardOverallTarget>

@{
    int counter = 1;
}

<div class="card-body">
    <div class="row">
        @if (Model != null && Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.LinkIssue).Count() > 0)
        {
            <div class="col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h5>Link Issue</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table">
                                <thead class="bg-primary">
                                    <tr>
                                        <th>Sr no.</th>
                                        <th>DeviceName</th>
                                        <th>A10Id</th>
                                        <th>LastAccesstime</th>
                                        <th>TimeStamp</th>
                                        <th>Select to resolved</th>
                                        <th width="200"></th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody class="tbodyOverallSitekippingRFStatus@(ViewBag.JobCardId)">
                                    @foreach (var item in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.LinkIssue).ToList())
                                    {
                                        <tr class="table-light">
                                            <td>@counter</td>
                                            <td>@item.ClusterName</td>
                                            <td>@item.A10Id</td>
                                            <td></td>
                                            <td>@item.TimeStamp.ToString()</td>
                                            <td class="text-center">
                                                <input type="checkbox" class="chkResolvedTarget" data-id="@item.Id" id="chkResolved_@item.Id" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" placeholder="Remark" id="txtResolved_@item.Id" />
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-primary" id="btnResolved_@item.Id" onclick="fnQualityAssuranceUpdate('@item.Id','@item.JobCardId','@item.ResolvedDate.Value.Date.Ticks')">Update</button>
                                            </td>
                                            <td>
                                                @if (item.mJobCardOverallTargetRemarks != null && item.mJobCardOverallTargetRemarks.Count > 0)
                                                {
                                                    <a href="javascript:void(0)" onclick="fnQualityAssuranceShowRemark('@item.Id')">Show Remark</a>
                                                }
                                            </td>
                                        </tr>
                                        counter++;
                                    }
                                </tbody>
                            </table>
                        </div>


                    </div>
                </div>

            </div>
        }


        @if (Model != null && Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.WatchLists).Count() > 0)
        {
            <div class="col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h5>Watchlist</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table">
                                <thead class="bg-primary">
                                    <tr>
                                        <th>Sr no.</th>
                                        <th>AssetType</th>
                                        <th>Asset</th>
                                        <th>Attribute</th>
                                        <th>Value</th>
                                        <th>Date</th>
                                        <th class="text-center">Select to resolved</th>
                                        <th width="200"></th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody class="tbodyOverallSitekippingWatchLists@(ViewBag.JobCardId)">
                                    @foreach (var item in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.WatchLists).ToList())
                                    {
                                        <tr class="table-light">
                                            <td>@counter</td>
                                            <td>@item.AssetTypeName</td>
                                            <td>
                                                <a href="javascript:void(0)" onclick="fnGetLiveData('@item.SiteName','@item.AssetId','@item.AssetTypeId')">@item.AssetName</a>
                                            </td>
                                            <td>@item.AttributeName</td>
                                            <td>@item.Value</td>
                                            <td>@item.TimeStamp</td>
                                            <td class="text-center">
                                                @if (item.IsAdminResolved != null && item.IsAdminResolved.Value)
                                                {
                                                    <input type="checkbox" class="chkResolvedTarget" data-id="@item.Id" id="chkResolved_@item.Id" checked />
                                                }
                                                else
                                                {
                                                    <input type="checkbox" class="chkResolvedTarget" data-id="@item.Id" id="chkResolved_@item.Id" />
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsAdminResolved != null && item.IsAdminResolved.Value)
                                                {
                                                    <input type="text" class="form-control" placeholder="Remark" id="txtResolved_@item.Id" disabled />

                                                }
                                                else
                                                {
                                                    <input type="text" class="form-control" placeholder="Remark" id="txtResolved_@item.Id" />
                                                }

                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-primary" id="btnResolved_@item.Id" onclick="fnQualityAssuranceUpdate('@item.Id','@item.JobCardId','@item.ResolvedDate.Value.Date.Ticks')">Update</button>
                                            </td>
                                            <td>
                                                @if (item.mJobCardOverallTargetRemarks != null && item.mJobCardOverallTargetRemarks.Count > 0)
                                                {
                                                    <a href="javascript:void(0)" onclick="fnQualityAssuranceShowRemark('@item.Id')">Show Remark</a>
                                                }
                                            </td>
                                        </tr>
                                        counter++;
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>

            </div>
        }


        @if (Model != null && Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.FRSWatchList).Count() > 0)
        {
            <div class="col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h5>FRS Watch List</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table">
                                <thead class="bg-primary">
                                    <tr>
                                        <th>Sr no.</th>
                                        <th>Asset Type</th>
                                        <th>Asset</th>
                                        <th>Cause Code</th>
                                        <th>Date</th>
                                        <th class="text-center">Select to resolved</th>
                                        <th></th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody class="tbodyLast30SitekippingAlert@(ViewBag.JobCardId)">
                                    @foreach (var item in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.FRSWatchList).ToList())
                                    {
                                        <tr class="table-light">
                                            <td>@counter</td>
                                            <td>@item.AssetTypeName</td>
                                            <td>
                                                <a href="javascript:void(0)" onclick="fnGetLiveData('@item.SiteName','@item.AssetId','@item.AssetTypeId')">@item.AssetName</a>
                                            </td>
                                            <td>@item.CauseCode</td>
                                            <td>@item.TimeStamp</td>
                                            <td class="text-center">
                                                @if (item.IsAdminResolved != null && item.IsAdminResolved.Value)
                                                {
                                                    <input type="checkbox" class="chkResolvedTarget" data-id="@item.Id" id="chkResolved_@item.Id" checked />
                                                }
                                                else
                                                {
                                                    <input type="checkbox" class="chkResolvedTarget" data-id="@item.Id" id="chkResolved_@item.Id" />
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsAdminResolved != null && item.IsAdminResolved.Value)
                                                {
                                                    <input type="text" class="form-control" placeholder="Remark" id="txtResolved_@item.Id" disabled />
                                                }
                                                else
                                                {
                                                    <input type="text" class="form-control" placeholder="Remark" id="txtResolved_@item.Id" />
                                                }

                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-primary" id="btnResolved_@item.Id" onclick="fnQualityAssuranceUpdate('@item.Id','@item.JobCardId','@item.ResolvedDate.Value.Date.Ticks')">Update</button>
                                            </td>
                                            <td>
                                                @if (item.mJobCardOverallTargetRemarks != null && item.mJobCardOverallTargetRemarks.Count > 0)
                                                {
                                                    <a href="javascript:void(0)" onclick="fnQualityAssuranceShowRemark('@item.Id')">Show Remark</a>
                                                }
                                            </td>
                                        </tr>
                                        counter++;
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>

            </div>
        }

        @if (Model != null && Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.Manually).Count() > 0)
        {
            <div class="col-sm-12">
                <div class="card">
                    <div class="card-header">
                        <h5>Manually</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table">
                                <thead class="bg-primary">
                                    <tr>
                                        <th>Sr no.</th>
                                        <th>Issue Type</th>
                                        <th>Asset Type</th>
                                        <th>Asset</th>
                                        <th>Attribute</th>
                                        <th>Problem</th>
                                        <th>TimeStamp</th>
                                        <th class="text-center">Select to resolved</th>
                                        <th width="200"></th>
                                        <th></th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody class="tbodyManuallySitekipping@(ViewBag.JobCardId)">
                                    @foreach (var item in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.Manually).ToList())
                                    {
                                        <tr class="table-light">
                                            <td>@counter</td>
                                            <td>@item.IssueType</td>
                                            <td>@item.AssetTypeName</td>
                                            <td>
                                                <a href="javascript:void(0)" onclick="fnGetLiveData('@item.SiteName','@item.AssetId','@item.AssetTypeId')">@item.AssetName</a>
                                            </td>
                                            <td>@item.AttributeName</td>
                                            <td>@item.Message</td>
                                            <td>@item.TimeStamp.ToString()</td>
                                            <td class="text-center">
                                                @if (item.IsAdminResolved != null && item.IsAdminResolved.Value)
                                                {
                                                    <input type="checkbox" class="chkResolvedTarget" data-id="@item.Id" id="chkResolved_@item.Id" checked />
                                                }
                                                else
                                                {
                                                    <input type="checkbox" class="chkResolvedTarget" data-id="@item.Id" id="chkResolved_@item.Id" />
                                                }
                                            </td>
                                            <td>
                                                @if (item.IsAdminResolved != null && item.IsAdminResolved.Value)
                                                {
                                                    <input type="text" class="form-control" placeholder="Remark" id="txtResolved_@item.Id" disabled />
                                                }
                                                else
                                                {
                                                    <input type="text" class="form-control" placeholder="Remark" id="txtResolved_@item.Id" />
                                                }

                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-primary" id="btnResolved_@item.Id" onclick="fnQualityAssuranceUpdate('@item.Id','@item.JobCardId','@item.ResolvedDate.Value.Date.Ticks')">Update</button>
                                            </td>
                                            <td>
                                                @if (item.mJobCardOverallTargetRemarks != null && item.mJobCardOverallTargetRemarks.Count > 0)
                                                {
                                                    <a href="javascript:void(0)" onclick="fnQualityAssuranceShowRemark('@item.Id')">Show Remark</a>
                                                }
                                            </td>
                                        </tr>
                                        counter++;
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>
                </div>

            </div>
        }

    </div>
</div>


<script>
    $(document).ready(function () {
        $('.chkResolvedTarget').click(function () {
            var dataId = $(this).data('id');
            if ($('#chkResolved_' + dataId).prop('checked') == false) {
                //do something
                $('#txtResolved_' + dataId).val('');

                $('#txtResolved_' + dataId).removeAttr("disabled");
                // $('#btnResolved_' + dataId).removeAttr("disabled");

            } else {
                $('#txtResolved_' + dataId).val('');

                $('#txtResolved_' + dataId).attr("disabled", "disabled");
                // $('#btnResolved_' + dataId).attr("disabled", "disabled");
            }
        });
    });

</script>

