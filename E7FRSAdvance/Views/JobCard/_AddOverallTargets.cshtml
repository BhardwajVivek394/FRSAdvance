                                        </li>
                                    </ul>
                                </div>
                            </li>

                        </ul>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSaveJobCardOverall('@ViewBag.JobCardId')">Save</button>
            </div>
        </div>
    </div>
</div>


<script>

    function fnOverallManuallyDelete($this) {

        $($this).closest('tr').remove();
    }

    function fnShowOverallType(Type, $this) {
        if (Type != null && Type != '' && Type != undefined) {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.maintenace' + Type).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.maintenace' + Type).hide();
            }
        }
    }

    function fnShowWatchListGroup(AssetTypeId, $this) {
        if (AssetTypeId != null && AssetTypeId != '' && AssetTypeId != undefined) {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.' + AssetTypeId).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.' + AssetTypeId).hide();
            }
        }
    }
</script>