                                                    {
                                                        var mRFStatus = ViewBag.RFStatus as List<Domain.A10Status>;
                                                        <table class="table">
                                                            <thead class="bg-primary">
                                                                <tr>
                                                                    <th>A10Id</th>
                                                                    <th>DeviceName</th>
                                                                    <th>LastAccesstime</th>
                                                                    <th class="text-center">Select to add</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody class="tbodyOverallRFStatus@(ViewBag.JobCardId)">
                                                                @if (mRFStatus != null && mRFStatus.Count > 0)
                                                                {
                                                                    var a10Ids = mRFStatus.GroupBy(x => x.id).Select(x => x.Key).ToList();
                                                                    if (a10Ids != null && a10Ids.Count > 0)
                                                                    {
                                                                        foreach (var a10Id in a10Ids)
                                                                        {
                                                                            foreach (var item in mRFStatus.Where(x => x.id == a10Id).Take(1))
                                                                            {
                                                                                <tr class="table-light" data-a10id="@item.id">

                                                                                    <td>@item.id</td>
                                                                                    <td>@item.name</td>
                                                                                    <td>
                                                                                        @item.last_response
                                                                                    </td>
                                                                                    <td class="text-center">
                                                                                        <input type="checkbox" checked />
                                                                                    </td>
                                                                                </tr>


                                                                            }
                                                                        }
                                                                    }

                                                                }
                                                                else
                                                                {
                                                                    <tr>
                                                                        <td colspan="6" class="text-center">
                                                                            No record found
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>

                                                    }
                                                    else
                                                    {
                                                        <table class="table">
                                                            <tr>
                                                                <td class="text-center">
                                                                    No record found
                                                                </td>
