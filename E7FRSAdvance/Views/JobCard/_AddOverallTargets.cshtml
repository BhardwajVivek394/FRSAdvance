                                            <span style="float:left; color:white;">Link Issue  &nbsp;</span>
                                        </div>
                                        <span class="pull-right">
                                            <a href="#" data-bs-original-title="" title="" style="color:white"><i class="fa fa-angle-up fa-3x" onclick="fnShowOverallType('LinkIssue', this); return false;"></i></a>
                                        </span>
                                    </div>
                                </li>

                                <li class="inbox-data maintenaceLinkIssue" style="margin-top: 10px; display: none;">
