<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />


<style>
    /*Alert and predictive*/
    .pill-badge-primary1 {
        background-color: White;
    }

    body .mail-body-wrapper ul li {
        padding: 16px;
        display: flex;
        align-items: center;
        cursor: pointer;
        border-bottom: 1px solid #bebebe;
    }

    .pull-right {
        float: right;
    }

    body .mail-body-wrapper ul li .inbox-message .email-data .badge {
        border-radius: 20px;
    }

    body .mail-body-wrapper ul li .inbox-message {
        display: flex;
        justify-content: space-between;
        width: 100%;
        gap: 16px;
    }

        body .mail-body-wrapper ul li .inbox-message .email-data span {
            font-weight: 500;
            letter-spacing: 0.3;
            display: -webkit-box;
            max-width: 100%;
            margin: 0 auto;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            color: rgba(82, 82, 108, 0.8);
        }
</style>

<div class="modal fade" id="modal-overall-targets" role="dialog" aria-labelledby="modal-overall-targets" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Overall Targets</span></h4>

