    function fnGetJobCardDescriptionEdit(jobCardId, date) {
        var todayDate = new Date();
        var formattedDate = `${todayDate.getMonth() + 1}-${todayDate.getDate()}-${todayDate.getFullYear()}`;

        if (date == null || date == undefined || date == '') {
            $('.clsbtnSearchDates' + jobCardId).each(function (v, value) {
                if ($(this).hasClass('btn-info')) {
                    date = $(this).text().replaceAll("/", "-");
                }
            });
        }
        $("#loader").show();
        $.ajax({
            url: '/JobCard/GetJobCardDescription',
            type: 'Post',
            data: '{jobCardId:' + jobCardId + ',date:"' + date + '"}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                if (data != null) {
                    //if (date != null && date != undefined && date != formattedDate) {
                    //    $(".addDailyWork").hide()
                    //}
                    //else {
                    //    $(".addDailyWork").show()
                    //}
                    $('.editJobCardDescription_' + jobCardId).empty();

                    $.each(data, function (index, item) {
                        var remarkHtml = item.Remark ? `
                            <span class="spnRemark_${item.JobCardId}">
                               ${item.Remark}
                            </span>` : '';

                        var cardHtml = `
                            <div class="col-12">
                                 <div class="card jobCardDescription">
                                     <div class="card-body">
                                         <div class="row">
                                             <div class="col-md-5">
                                                 <span class="spnDailywork_${item.JobCardId}">
                                                     ${item.DailyWork}
                                                 </span>
                                             </div>
                                             <div class="col-md-1">
                                                  <div class="vertical-line">
                                                  </div>
                                             </div>
                                               ${item.Remark != null || date != formattedDate ?
                                `<div class="col-md-6">
                                                         <span class="spnRemark_${item.JobCardId}">
                                                             ${remarkHtml}
                                                         </span>
                                                    </div>` :
                                `<div class="col-md-6 addRemark">
                                                          <h5>
                                                             <a href="javascript:void(0)" title="Add Remark" onclick="fnAddRemark                                    (${item.Id})">
                                                                 <i class="fa fa-pencil f-20"></i>
                                                              </a>
                                                          </h5>
                                                   </div>`
                            }
                                          </div>
                                      </div>
                                  </div>
                              </div>
                          `;
                        $('.editJobCardDescription_' + jobCardId).append(cardHtml);
                        // $('.spnRemark_' + jobCardId).text(item.Remark);
                        // $('.spnDailywork_' + jobCardId).text(item.DailyWork);
                    });

                    $('.clsbtnSearchDates' + jobCardId).each(function (v, value) {

                        var txtVal = $(this).text();
                        if (txtVal == date.replaceAll("-", "/")) {
                            if ($(this).hasClass("btn-primary")) {
                                $(this).removeClass("btn-primary").addClass("btn-info");
                            }
                        } else {
                            $(this).removeClass("btn-info").addClass("btn-primary");
                        }
                    });
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

