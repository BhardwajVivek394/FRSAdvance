                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        //if (fnValidJobCardDescription(mJobCardDescription))
        //}

    }

    function fnSaveJobCardDescriptionRemark(jobCardDescriptionId) {
        var mJobCardDescription = {};
        mJobCardDescription.Id = jobCardDescriptionId;
        mJobCardDescription.Remark = $('.txtRemark_' + jobCardDescriptionId).val();

        if (fnValidRemark(mJobCardDescription)) {
            $("#loader").show();
            $.ajax({
                url: '/JobCard/UpdateJobCardDescriptionRemark',
                type: 'Post',
                data: '{mJobCardDescription:' + JSON.stringify(mJobCardDescription) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            $('#frmJobCardList').submit();
                            $("#modelAddRemark").modal('hide');
                        } else {
                            CommonNotification("ERROR", data.result, "error");
                        }
