                        }
                    }

                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });

        }
    }

    function BindAssetType($this, rowId) {
        if ($("#hdnSiteId").val() != null && $("#hdnSiteId").val() != undefined && $("#hdnSiteId").val() != '' && $("#hdnSiteId").val() != '0') {
            $("#loader").show();
            $.ajax({
                url: '/JobCard/GetAssestBy',
                type: 'POST',
                data: '{siteId:' + $("#hdnSiteId").val() + ',assetTypeId:' + $($this).val() + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpOverallAssetId" + rowId).empty();
                    $("#drpOverallAssetId" + rowId).append($("<option></option>").val('0').html('Select Asset'));
                    $.each(data, function (key, value) {
                        $("#drpOverallAssetId" + rowId).append($("<option></option>").val(value.Id).html(value.Name));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            //  CommonNotification("ERROR", "Please select site and asset type", "Error");
        }
        BindAssetAttribute($this, rowId);
    }

