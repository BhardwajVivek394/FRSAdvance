@model Domain.Site
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-6">
                <label style="font-size:18px;margin-top:7px;font-weight:bold">Site:</label>
                <label style="font-size:16px;margin-top:7px"> @Model.Name </label>
            </div>
            <div class="col-6">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#" data-bs-original-title="" title=""> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Job Card</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <input type="hidden" id="hdnSiteId" value="@Model.Id" />
        <div class="col-lg-12">
            <div class="card">
                @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode())
                {
                    <div class="card-header">
                        <button class="btn btn-success" onclick="fnAddCard()">Add Card</button>
                    </div>
                }

                <div class="card-body">

                    @using (Ajax.BeginForm("List", "JobCard", new AjaxOptions()
                    {
                        HttpMethod = "POST",
                        UpdateTargetId = "divJobCardList",
                        InsertionMode = InsertionMode.Replace,
                        LoadingElementId = "loader"
                    }, new { id = "frmJobCardList" }))
                    {
                        {
                            HtmlHelper.ClientValidationEnabled = false;
                        }
                        <input type="hidden" name="SearchCriteria.SiteId" value="@Model.Id" />
                        <div id="divJobCardList">
                            @Html.Action("List", new Domain.JobCardLister() { SearchCriteria = new Domain.JobCard() { SiteId = Model.Id, Id = ViewBag.JobCardId } })
                        </div>
                    }


                </div>
            </div>


        </div>
    </div>
</div>

<div class="modal bounceIn animated" id="modelPauseWorkRemark" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modalConfirm-dialog">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title">Add Remark</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="hdnPauseWorkJobCardId" />
                <input type="hidden" id="hdnPauseWorkTypeId" />
                <textarea id="txtPauseWorkRemark" class="form-control" placeholder="Remark" rows="5"></textarea>
                <span class="text-danger"></span>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnUpdatePauseWork()">Save</button>
            </div>
        </div>
    </div>
</div>

<div id="divAssignSiteKeepingUser"></div>
<div id="divAssignMaintainerUser"></div>
<div id="divOverallTargets"></div>
<div id="divSiteKeepingOverallTargets"></div>
<div id="divJobCardSummary"></div>
<div id="divJobCardMaterial"></div>
<div id="divJobCardDailyWork"></div>
<div id="divJobCardRemark"></div>
<div id="divoveralltargetremark"></div>
<script>
    var overallLinkIssue = "@E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.LinkIssue.GetHashCode()";
    var overallwatchLists = "@E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.WatchLists.GetHashCode()";
    var overalllast30DayAlert = "@E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.FRSWatchList.GetHashCode()";
    var overallmanually = "@E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.Manually.GetHashCode()";

    function fnAddCard() {
        var mJobCard = {};
        mJobCard.SiteId = $("#hdnSiteId").val();
        mJobCard.IsLock = false;


        if (mJobCard != null && mJobCard != undefined) {
            $("#loader").show();
            $.ajax({
                url: '/JobCard/Create',
                type: 'Post',
                data: '{mJobCard:' + JSON.stringify(mJobCard) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            $('#frmJobCardList').submit();
                        } else {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }

                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });

        }
        else {
            $("#asset-graph").modal("hide");
            CommonNotification("ERROR", "Please select Benchmarking", "Error");
        }
    }

    function fnAssignUser(jobCardId) {
        $("#loader").show();
        $.ajax({
            url: '/JobCard/_AssignSiteKeepingUser',
            type: 'Post',
            data: '{jobCardId:' + jobCardId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAssignSiteKeepingUser").empty().append(data);
                $("#modal-assign-siteKeeping-user").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }

    function fnShowAssignMaintainerUser(jobCardId) {
        $("#loader").show();
        $.ajax({
            url: '/JobCard/_AssignMaintainerUser',
            type: 'Post',
            data: '{jobCardId:' + jobCardId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAssignMaintainerUser").empty().append(data);
                $("#modal-assign-maintainer-user").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }

    function fnOverallTargets(siteId, jobCardId) {
        $("#loader").show();

        $.ajax({
            url: '/JobCard/_AddOverallTargets',
            type: 'Post',
            data: '{siteId:' + siteId + ',jobCardId:' + jobCardId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divOverallTargets").empty().append(data);
                $("#modal-overall-targets").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }

    function fnEdit(jobCardId) {

        $('.jobcard-editable-' + jobCardId).show();
        $('.jobcard-viewable-' + jobCardId).hide();

        fnGetJobCardDescriptionEdit(jobCardId)
    }

    function fnCancel(jobCardId) {

        $('.jobcard-editable-' + jobCardId).hide();
        $('.jobcard-viewable-' + jobCardId).show();

        fnGetJobCardDescription(jobCardId)
    }

    function fnSaveJobCardDescription(jobCardId) {
        var mJobCardDescription = {};
        mJobCardDescription.JobCardId = jobCardId;
        mJobCardDescription.DailyWork = $('.txtDailywork_' + jobCardId).val();


        if (fnValidJobCardDescription(mJobCardDescription)) {
            $("#loader").show();
            $.ajax({
                url: '/JobCard/CreateJobCardDescription',
                type: 'Post',
                data: '{mJobCardDescription:' + JSON.stringify(mJobCardDescription) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            $('#frmJobCardList').submit();
                        } else {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }

                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });

        }

    }

    function fnValidJobCardDescription(mJobCardDescription) {
        if (mJobCardDescription.DailyWork == null || mJobCardDescription.DailyWork == undefined || mJobCardDescription.DailyWork == '') {
            alert("Daily Work is required.");
            return false;
        }

        //if (mJobCardDescription.Remark == null || mJobCardDescription.Remark == undefined || mJobCardDescription.Remark == '') {
        //    alert("Remark is required.");
        //    return false;
        //}

        return true;
    }

    function fnSaveJobCardOverall(jobCardId) {
        var mJobCardOverallTargets = [];

        $(".tbodyOverallRFStatus" + jobCardId + " tr").each(function () {
            var chkRFStatus = $(this).find("td").eq(3).children("input").prop("checked")
            if (chkRFStatus) {
                var mJobCardOverallTarget = {};
                mJobCardOverallTarget.JobCardId = jobCardId;
                mJobCardOverallTarget.TypeId = overallLinkIssue;
                mJobCardOverallTarget.A10Id = $(this).data("a10id");
                mJobCardOverallTarget.ClusterName = $.trim($(this).find("td").eq(1).html());
                mJobCardOverallTarget.SiteId = $('#hdnSiteId').val();
                mJobCardOverallTargets.push(mJobCardOverallTarget);
            }

        });


        $(".tbodyOverallWatchLists" + jobCardId + " tr").each(function () {
            var chkWatchList = $(this).find("td").eq(11).children("input").prop("checked")
            if (chkWatchList) {
                var mJobCardOverallTarget = {};
                mJobCardOverallTarget.JobCardId = jobCardId;
                mJobCardOverallTarget.TypeId = overallwatchLists;
                mJobCardOverallTarget.WatchListId = $.trim($(this).data('id'));
                mJobCardOverallTarget.SiteId = $('#hdnSiteId').val();
                mJobCardOverallTargets.push(mJobCardOverallTarget);
            }

        });


        $(".tbodyFRSWatchList" + jobCardId + " tr").each(function () {
            var chkFRSWatchList = $(this).find("td").eq(4).children("input").prop("checked")
            if (chkFRSWatchList) {
                var mJobCardOverallTarget = {};
                mJobCardOverallTarget.JobCardId = jobCardId;
                mJobCardOverallTarget.TypeId = overalllast30DayAlert;
                mJobCardOverallTarget.SiteId = $('#hdnSiteId').val();
                mJobCardOverallTarget.FRSWatchListId = $.trim($(this).data('id'));

                mJobCardOverallTargets.push(mJobCardOverallTarget);
            }

        });


        $(".tbodyManuallyProblem" + jobCardId + " tr").each(function () {
            var mJobCardOverallTarget = {};
            mJobCardOverallTarget.JobCardId = jobCardId;
            mJobCardOverallTarget.TypeId = overallmanually;
            mJobCardOverallTarget.SiteId = $('#hdnSiteId').val();

            mJobCardOverallTarget.IssueType = $.trim($(this).find("td").eq(0).children("input").val());
            if (mJobCardOverallTarget.IssueType == null || mJobCardOverallTarget.IssueType == undefined || mJobCardOverallTarget.IssueType == '') {

                mJobCardOverallTarget.IssueType = $.trim($(this).find("td").eq(0).children("select").children("option:selected").text());
            }

            mJobCardOverallTarget.AssetTypeId = $.trim($(this).find("td").eq(1).children("select").children("option:selected").val());
            mJobCardOverallTarget.AssetId = $.trim($(this).find("td").eq(2).children("select").children("option:selected").val());
            mJobCardOverallTarget.AttributeId = $.trim($(this).find("td").eq(3).children("select").children("option:selected").val());
            mJobCardOverallTarget.Message = $.trim($(this).find("td").eq(4).children("input").val());
            mJobCardOverallTarget.TimeStamp = new Date();

            if (mJobCardOverallTarget.IssueType != null && mJobCardOverallTarget.IssueType != undefined && mJobCardOverallTarget.IssueType != '') {
                if (mJobCardOverallTarget.AssetTypeId != null && mJobCardOverallTarget.AssetTypeId != undefined && mJobCardOverallTarget.AssetTypeId != '0') {
                    if (mJobCardOverallTarget.AssetId != null && mJobCardOverallTarget.AssetId != undefined && mJobCardOverallTarget.AssetId != '0') {
                        if (mJobCardOverallTarget.AttributeId != null && mJobCardOverallTarget.AttributeId != undefined && mJobCardOverallTarget.AttributeId != '0') {
                            mJobCardOverallTargets.push(mJobCardOverallTarget);
                        }
                    }
                }
            }

        });

        if (mJobCardOverallTargets != null && mJobCardOverallTargets != undefined && mJobCardOverallTargets.length > 0) {
            $("#loader").show();
            $.ajax({
                url: '/JobCard/CreateJobCardOverall',
                type: 'Post',
                data: '{mJobCardOverallTargets:' + JSON.stringify(mJobCardOverallTargets) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        $('#modal-overall-targets').modal('hide');
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                        } else {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }

                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });

        } else {
            alert('Select any one overall target.');
        }

    }

    function fnAddManuallyProblem(jobCardId) {
        var sp = $('#AssetTypeId').html();
        var drpIssueTypes = $('#drpIssueType').html();
        var tblstr = '';
        var val = 0;
        $(".tbodyManuallyProblem" + jobCardId + " tr").each(function () {
            val = $(this).data("val");

        });

        val = val + 1;
        tblstr += ' <tr data-val="' + val + '">';

        tblstr += '<td><select class="form-control">' + drpIssueTypes + '</select></td>';
       // tblstr += '<td><input type="text" placeholder="Issue Type" class="form-control" /></td>';
        tblstr += '<td><select class="form-control" id="AssetTypeId" name="AssetTypeId" onchange="BindAssetType(this,' + val +')" tabindex="1">' + sp +'</select></td>';
        tblstr += '<td><select id="drpOverallAssetId' + val + '" class="form-control"><option value="0">Select Asset</option></select></td>';
        tblstr += '<td><select id="drpOverallAttributeId' + val + '" class="form-control"><option value="0">Select Attribute</option></select></td>';
       /* tblstr += '<td><input type="text" placeholder="Problem" class="form-control" />';*/
        tblstr += ' <td><a class="text-danger" onclick="fnOverallManuallyDelete(this)"><i class="fa fa-close" style="font-size:24px"></i></a></td>';
        tblstr += ' </tr>';

        $('.tbodyManuallyProblem' + jobCardId).append(tblstr);
    }

    function fnUpdateJobCardOverall(jobCardId) {
        var mJobCardOverallTargets = [];

        var isValid = true;
      
        var patternCode = /^[A-Za-z]{2}\d+$/;
        $(".tbodyOverallSitekippingRFStatus" + jobCardId + " tr").each(function () {
            var checkRFStatus = $(this).find("td").eq(8).children("input").prop("checked")
            if (checkRFStatus) {
                var mJobCardOverallTarget = {};
                mJobCardOverallTarget.JobCardId = jobCardId;
                mJobCardOverallTarget.TypeId = overallLinkIssue;
                mJobCardOverallTarget.Id = $(this).data("id");
                mJobCardOverallTarget.IsResolved = true;
                mJobCardOverallTarget.SiteId = $('#hdnSiteId').val();

                mJobCardOverallTarget.IssueType = $(this).find("td").eq(5).children("select").children("option:selected").val();
                mJobCardOverallTarget.Reason = $(this).find("td").eq(6).children("textarea").val();
                mJobCardOverallTarget.MatrialCode = $(this).find("td").eq(7).children("input").val();

                if (mJobCardOverallTarget.MatrialCode != null && mJobCardOverallTarget.MatrialCode != undefined && mJobCardOverallTarget.MatrialCode != '') {
                   
                    if (isValid && !patternCode.test(mJobCardOverallTarget.MatrialCode)) {
                        alert("Code must start with two letters followed by numbers (e.g., RH1000)");
                        isValid = false;
                    } 
                }

                

                mJobCardOverallTargets.push(mJobCardOverallTarget);
            }

        });


        $(".tbodyOverallSitekippingWatchLists" + jobCardId + " tr").each(function () {

            var isWatchLists = $(this).find("td").eq(13).children("input").prop("checked");
            if (isWatchLists) {

                var mJobCardOverallTarget = {};
                mJobCardOverallTarget.JobCardId = jobCardId;
                mJobCardOverallTarget.TypeId = overallwatchLists;
                mJobCardOverallTarget.Id = $(this).data("id");
                mJobCardOverallTarget.IsResolved = true;

                mJobCardOverallTarget.IssueType = $(this).find("td").eq(10).children("select").children("option:selected").val();
                mJobCardOverallTarget.Reason = $(this).find("td").eq(11).children("textarea").val();
                mJobCardOverallTarget.MatrialCode = $(this).find("td").eq(12).children("input").val();
                if (mJobCardOverallTarget.MatrialCode != null && mJobCardOverallTarget.MatrialCode != undefined && mJobCardOverallTarget.MatrialCode != '') {                 
                    if (isValid && !patternCode.test(mJobCardOverallTarget.MatrialCode)) {
                        alert("Code must start with two letters followed by numbers (e.g., RH1000)");
                        isValid = false;
                    } 
                }
               

                mJobCardOverallTargets.push(mJobCardOverallTarget);
            }

        });


        $(".tbodyFRSWatchListAlert" + jobCardId + " tr").each(function () {

            var checkFRSWatchList = $(this).find("td").eq(9).children("input").prop("checked")
            if (checkFRSWatchList) {

                var mJobCardOverallTarget = {};
                mJobCardOverallTarget.JobCardId = jobCardId;
                mJobCardOverallTarget.TypeId = overalllast30DayAlert;
                mJobCardOverallTarget.Id = $(this).data("id");
                mJobCardOverallTarget.IsResolved = true;

                mJobCardOverallTarget.IssueType = $(this).find("td").eq(6).children("select").children("option:selected").val();
                mJobCardOverallTarget.Reason = $(this).find("td").eq(7).children("textarea").val();
                mJobCardOverallTarget.MatrialCode = $(this).find("td").eq(8).children("input").val();

                if (mJobCardOverallTarget.MatrialCode != null && mJobCardOverallTarget.MatrialCode != undefined && mJobCardOverallTarget.MatrialCode != '') {                   
                    if (isValid && !patternCode.test(mJobCardOverallTarget.MatrialCode)) {
                        alert("Code must start with two letters followed by numbers (e.g., RH1000)");
                        isValid = false;
                    } 
                }
                
                mJobCardOverallTargets.push(mJobCardOverallTarget);
            }

        });


        $(".tbodyManuallySitekipping" + jobCardId + " tr").each(function () {

            var chkManually = $(this).find("td").eq(8).children("input").prop("checked")
            if (chkManually) {

                var mJobCardOverallTarget = {};
                mJobCardOverallTarget.JobCardId = jobCardId;
                mJobCardOverallTarget.TypeId = overallmanually;
                mJobCardOverallTarget.Id = $(this).data("id");
                mJobCardOverallTarget.IsResolved = true;

                mJobCardOverallTarget.IssueType = $(this).find("td").eq(5).children("select").children("option:selected").val();
                mJobCardOverallTarget.Reason = $(this).find("td").eq(6).children("textarea").val();
                mJobCardOverallTarget.MatrialCode = $(this).find("td").eq(7).children("input").val();
                if (mJobCardOverallTarget.MatrialCode != null && mJobCardOverallTarget.MatrialCode != undefined && mJobCardOverallTarget.MatrialCode != '') {                  
                    if (isValid && !patternCode.test(mJobCardOverallTarget.MatrialCode)) {
                        alert("Code must start with two letters followed by numbers (e.g., RH1000)");
                        isValid = false;
                    } 
                }
                mJobCardOverallTargets.push(mJobCardOverallTarget);
            }

        });

        if (mJobCardOverallTargets != null && mJobCardOverallTargets != undefined && mJobCardOverallTargets.length > 0) {
            if (isValid) {
                $("#loader").show();
                $.ajax({
                    url: '/JobCard/UpdateJobCardOverall',
                    type: 'Post',
                    data: '{mJobCardOverallTargets:' + JSON.stringify(mJobCardOverallTargets) + '}',
                    contentType: 'application/json',
                    success: function (data) {
                        $("#loader").hide();
                        if (data != null) {
                            $('#modal-siteKeeping-overall-targets').modal('hide');
                            if (data.type == "success") {
                                CommonNotification("SUCCESS", data.result, "success");
                                //$('#frmJobCardList').submit();
                            } else {
                                CommonNotification("ERROR", data.result, "error");
                            }
                        }

                    },
                    error: function (response) {
                        $("#loader").hide();
                        CommonNotification("ERROR", "Something went wrong!", "Error");
                    }
                });
            }
           

        }
        else {
            alert('Select any one overall target.')
        }
    }

    function fnSiteKeepingOverallTargets(jobCardId) {
        $("#loader").show();

        $.ajax({
            url: '/JobCard/_SiteKeepingOverallTargets',
            type: 'Post',
            data: '{jobCardId:' + jobCardId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divSiteKeepingOverallTargets").empty().append(data);
                $("#modal-siteKeeping-overall-targets").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }


    function fnGetJobCardDescription(jobCardId, date) {
        if (date == null || date == undefined || date == '') {
            $('.clsbtnSearchDates' + jobCardId).each(function (v, value) {
                if ($(this).hasClass('btn-info')) {
                    date = $(this).text().replaceAll("/", "-");
                }
            });
        }
        $("#loader").show();
        $.ajax({
            url: '/JobCard/GetJobCardDescription',
            type: 'Post',
            data: '{jobCardId:' + jobCardId + ',date:"' + date + '"}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                if (data != null) {
                    $('.viewJobCardDescription_' + jobCardId).empty();

                    $.each(data, function (index, item) {
                        var remarkHtml = item.Remark ? `
                         <span class="spnRemark_${item.JobCardId}">
                           ${item.Remark}
                         </span>` : '';

                        var cardHtml = `<div class="col-12">
                               <div class="card jobCardDescription">
                                   <div class="card-body">
                                       <div class="row">
                                           <div class="col-md-5">
                                               <span class="spnDailywork_${jobCardId}">
                                                 ${item.DailyWork}
                                               </span>
                                           </div>
                                           <div class="col-md-1">
                                               <div class="vertical-line"></div>
                                           </div>
                                           <div class="col-md-6">
                                               <span class="spnRemark_${jobCardId}">
                                                  ${remarkHtml}
                                               </span>
                                           </div>
                                       </div>
                                   </div>
                               </div>
                           </div>`;

                        $('.viewJobCardDescription_' + jobCardId).append(cardHtml);
                        // $('.spnRemark_' + jobCardId).text(item.Remark);
                        // $('.spnDailywork_' + jobCardId).text(item.DailyWork);
                    });

                    $('.clsbtnSearchDates' + jobCardId).each(function (v, value) {
                        var txtVal = $(this).text();
                        if (txtVal == date.replaceAll("-", "/")) {
                            if ($(this).hasClass("btn-primary")) {
                                $(this).removeClass("btn-primary").addClass("btn-info");
                            }
                        } else {
                            $(this).removeClass("btn-info").addClass("btn-primary");
                        }
                    });
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

