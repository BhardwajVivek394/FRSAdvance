    function fnSaveJobCardMaterial(jobCardId) {
        var mJobCardMaterials = [];

        $('.tbodyJobCardMaterial' + jobCardId + ' tr').each(function () {


            var chkinput = $(this).find("td").eq(3).children("input");
            var id = $.trim($(this).find("td").eq(0).html());
            var mJobCardMaterial = {};
            if (id != null && id != undefined) {
                mJobCardMaterial.Id = id;
            }
            mJobCardMaterial.JobCardId = jobCardId;
            mJobCardMaterial.Name = $.trim($(this).find("td").eq(1).children("input").val());
            mJobCardMaterial.Quantity = $.trim($(this).find("td").eq(2).children("input").val());

            if ($(chkinput).prop('checked') == true) {
                //do something
                mJobCardMaterial.IsArrived = true
            } else {
                mJobCardMaterial.IsArrived = false;
            }
            mJobCardMaterials.push(mJobCardMaterial);
        });

        if (mJobCardMaterials != null && mJobCardMaterials != undefined) {
            $("#loader").show();
            $.ajax({
                url: '/JobCard/SaveJobCardMaterial',
                type: 'Post',
                data: '{mJobCardMaterials:' + JSON.stringify(mJobCardMaterials) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        $("#modal-jobcard-material").modal('hide');
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            //$('#frmJobCardList').submit();
                        } else {
