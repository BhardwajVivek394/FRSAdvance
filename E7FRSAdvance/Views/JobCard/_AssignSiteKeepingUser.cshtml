@model List<Domain.User>

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal fade" id="modal-assign-siteKeeping-user" role="dialog" aria-labelledby="modal-assign-siteKeeping-user" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Assign SiteKeeping User</span></h4>

                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            @if (Model != null && Model.Count > 0)
                            {
                                var mJobCardUsers = new List<Domain.JobCardUser>();
                                if (ViewBag.JobCardUser != null)
                                {
                                    mJobCardUsers = ViewBag.JobCardUser as List<Domain.JobCardUser>;
                                }
                                foreach (var item in Model)
                                {
                                    <div>
                                        @if (mJobCardUsers.Where(x => x.UserId == item.Id).Count() > 0)
                                        {
                                            <input type="checkbox" class="clsSitekippingUser" value="@item.Id" id="chkSitekippingUser@(item.Id)" checked/>
                                        }
                                        else
                                        {
                                            <input type="checkbox" class="clsSitekippingUser" value="@item.Id" id="chkSitekippingUser@(item.Id)" />
                                        }

                                        <label for="chkSitekippingUser@(item.Id)">@item.FirstName @item.LastName</label>
                                    </div>
                                }
                                <div class="row">

                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnAssignSiteKeepingUser('@ViewBag.JobCardId')">Save</button>
            </div>
        </div>
    </div>
</div>
