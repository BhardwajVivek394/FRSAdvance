                                            </thead>
                                            <tbody class="tbodyOverallSitekippingWatchLists@(ViewBag.JobCardId)">
                                                @foreach (var item in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.WatchLists).ToList())
                                                {
                                                    <tr class="table-light" data-id="@item.Id">
                                                        <td>@counter</td>
                                                        <td>@item.AssetTypeName</td>
                                                        <td>@item.AssetName</td>
                                                        <td>@item.AttributeName</td>
                                                        <td>@item.Cluster</td>
                                                        <td>@item.Card</td>
                                                        <td>@item.ADCId</td>
                                                        <td>@item.Pin</td>
                                                        <td>@item.Value</td>
                                                        <td>@item.TimeStamp</td>
                                                        <td>
                                                            <select class="form-control" style="width:200px">
                                                                <option value="">Select Issue Type</option>
                                                                @if (ViewBag.WatchIssues != null)
                                                                {
                                                                    foreach (var watchIssue in ViewBag.WatchIssues as List<string>)
                                                                    {
                                                                        if (item.IssueType == watchIssue)
                                                                        {
                                                                            <option value="@watchIssue" selected>@watchIssue</option>
