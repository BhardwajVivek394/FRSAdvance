@model List<Domain.JobCardOverallTarget>

@{
    int counter = 1;
}
<div class="modal fade" id="modal-siteKeeping-overall-targets" role="dialog" aria-labelledby="modal-siteKeeping-overall-targets" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span>Overall Targets</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="form-horizontal">
                    <div class="row">
                        @if (Model != null && Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.LinkIssue).Count() > 0)
                        {
                            <div class="col-sm-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5>Link Issue</h5>
                                    </div>
                                    <div class="card-body">
                                        <table class="table">
                                            <thead class="bg-primary">
                                                <tr>
                                                    <th>Sr no.</th>
                                                    <th>A10Id</th>
                                                    <th>Cluster Name</th>
                                                    <th>LastAccesstime</th>
                                                    <th>TimeStamp</th>
                                                    <th>Issue Type</th>
                                                    <th>Reason</th>
                                                    <th>Code</th>
                                                    <th class="text-center">Select to resolved</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody class="tbodyOverallSitekippingRFStatus@(ViewBag.JobCardId)">
                                                @foreach (var item in Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.LinkIssue).ToList())
                                                {
                                                    <tr class="table-light" data-id="@item.Id">
                                                        <td>@counter</td>
                                                        <td>@item.A10Id</td>
                                                        <td>@item.ClusterName</td>
                                                        <td></td>
                                                        <td>
                                                        </td>
                                                        <td>
                                                            <select class="form-control" style="width:200px">
                                                                <option value="">Select Issue Type</option>
                                                                @if (ViewBag.WatchIssues != null)
                                                                {
                                                                    foreach (var watchIssue in ViewBag.WatchIssues as List<string>)
                                                                    {
                                                                        if (item.IssueType == watchIssue)
                                                                        {
                                                                            <option value="@watchIssue" selected>@watchIssue</option>
                                                                        }
                                                                        else
                                                                        {
                                                                            <option value="@watchIssue">@watchIssue</option>
                                                                        }
                                                                    }
                                                                }
                                                            </select>
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(item.Reason))
                                                            {
                                                                <textarea class="form-control" style="width:100px">@item.Reason</textarea>
                                                            }
                                                            else
                                                            {
                                                                <textarea class="form-control" style="width:100px"></textarea>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(item.MatrialCode))
                                                            {
                                                                <input type="text" class="form-control" style="width:100px" value="@item.MatrialCode" />
                                                            }
                                                            else
                                                            {
                                                                <input type="text" class="form-control" style="width:100px" />
                                                            }
                                                        </td>

                                                        <td class="text-center">
                                                            @if (item.IsResolved)
                                                            {
                                                                @*<input type="checkbox" class="clsoveralltargetsUpdateStatus" data-id="@item.Id" checked disabled />*@
                                                                <i class="fa fa-check text-success f-24" aria-hidden="true"></i>
                                                            }
                                                            else
                                                            {
                                                                <input type="checkbox" class="clsoveralltargetsUpdateStatus" data-id="@item.Id" />
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (item.IsAdminResolved != null && !item.IsAdminResolved.Value)
                                                            {
                                                                <a href="javascript:void(0)" onclick="fnQualityAssuranceShowRemark('@item.Id')"><i class="fa fa-info-circle f-20" aria-hidden="true"></i></a>
                                                            }
                                                        </td>
                                                    </tr>
                                                    counter++;
                                                }
                                            </tbody>
                                        </table>

                                    </div>
                                </div>

                            </div>
                        }


                        @if (Model != null && Model.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.JobCardOverallTargetType.WatchLists).Count() > 0)
