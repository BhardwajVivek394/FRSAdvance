            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                @*<button type="button" class="btn btn-primary ls-1-2">Save</button>*@
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnUpdateJobCardOverall('@ViewBag.JobCardId')">Save</button>
