                                                <tr>
                                                    <th>Sr no.</th>
                                                    <th>AssetType</th>
                                                    <th>Asset</th>
                                                    <th>Attribute</th>
                                                    <th>Cluster</th>
                                                    <th>Card</th>
                                                    <th>ADC</th>
                                                    <th>Pin</th>
                                                    <th>Value</th>
                                                    <th>Date</th>
                                                    <th>Issue Type</th>
                                                    <th>Reason</th>
                                                    <th>Code</th>
