                                                                            <option value="@watchIssue">@watchIssue</option>
                                                                        }
                                                                    }
                                                                }
                                                            </select>
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(item.Reason))
                                                            {
                                                                <textarea class="form-control" style="width:100px">@item.Reason</textarea>
                                                            }
                                                            else
                                                            {
                                                                <textarea class="form-control" style="width:100px"></textarea>
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (!string.IsNullOrEmpty(item.MatrialCode))
                                                            {
                                                                <input type="text" class="form-control" style="width:100px" value="@item.MatrialCode" />
                                                            }
                                                            else
                                                            {
                                                                <input type="text" class="form-control" style="width:100px" />
                                                            }
                                                        </td>
                                                        <td class="text-center">
                                                            @if (item.IsResolved)
                                                            {
                                                                <i class="fa fa-check text-success f-24" aria-hidden="true"></i>
                                                            }
                                                            else
                                                            {
                                                                <input type="checkbox" class="clsoveralltargetsUpdateStatus" data-id="@item.Id" />
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (item.IsAdminResolved != null && !item.IsAdminResolved.Value)
                                                            {
                                                                <a href="javascript:void(0)" onclick="fnQualityAssuranceShowRemark('@item.Id')"><i class="fa fa-info-circle f-20" aria-hidden="true"></i></a>
                                                            }
                                                        </td>
                                                    </tr>
                                                    counter++;
                                                }
                                            </tbody>
                                        </table>

                                    </div>
                                </div>

                            </div>
                        }


