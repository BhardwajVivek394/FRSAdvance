@model List<Domain.JobCardMaterial>

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal fade" id="modal-jobcard-material" role="dialog" aria-labelledby="modal-jobcard-material" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Job Card Material</span></h4>

                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body modal-fixed-height">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-12">
                            <button type="button" class="btn btn-success" onclick="fnAddJobCardMaterial('@ViewBag.JobCardId')"><i class="fa fa-plus"></i></button>
                            <table class="table">


                                <tbody class="tbodyJobCardMaterial@(ViewBag.JobCardId)">
                                    @if (Model != null && Model.Count > 0)
                                    {
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td style="display:none">@item.Id</td>
                                                <td><input type="text" placeholder="Material Name" class="form-control" value="@item.Name" /></td>
                                                <td><input type="number" placeholder="Qty" class="form-control" value="@item.Quantity" /></td>
                                                <td>
                                                    @if (item.IsArrived)
                                                    {
                                                        <input type="checkbox" checked/>
                                                    }
                                                    else
                                                    {
                                                        <input type="checkbox" />
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>

                            </table>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSaveJobCardMaterial('@ViewBag.JobCardId')">Save</button>
            </div>
        </div>
    </div>
</div>

