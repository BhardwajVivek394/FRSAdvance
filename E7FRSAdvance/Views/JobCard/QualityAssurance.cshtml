
@{
    ViewBag.Title = "QualityAssurance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="~/assets/js/paho-mqtt.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Quality Assurance</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div id="divQualityAssuranceJobCard"></div>
<div class="row">

    @using (Ajax.BeginForm("QualityAssuranceList", "JobCard", new AjaxOptions()
    {
        HttpMethod = "POST",
        UpdateTargetId = "divQualityAssuranceList",
        InsertionMode = InsertionMode.Replace,
        LoadingElementId = "loader"
    }, new { id = "frmQualityAssuranceList" }))
    {
        { HtmlHelper.ClientValidationEnabled = false; }
        <div id="divQualityAssuranceList">
            @Html.Action("QualityAssuranceList")
        </div>
    }
</div>

<div id="divAssetAttributePartial"></div>

<div id="divoveralltargetremark"></div>

<script>

    function fnGetLiveData(siteName, assetId, assetTypeId) {
        $("#loader").show();
        $.ajax({
            url: '/AssetAttribute/_AssetAttributePartial',
            type: 'Post',
            data: '{siteName:"' + siteName + '",assetId:' + assetId + ',assetTypeId:' + assetTypeId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAssetAttributePartial").empty().append(data);
                $("#modal-assetLister").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("danger", "Something went wrong!");
            }
        });
    }


    function fnQualityAssuranceShowRemark(jobCardOverallTargetId) {
        $("#loader").show();
        $.ajax({
            url: '/JobCard/GetQualityAssuranceRemarks',
            type: 'Post',
            data: '{jobCardOverallTargetId:' + jobCardOverallTargetId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divoveralltargetremark").empty().append(data);
                $("#modal-jobcard-overall-target-remark").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("danger", "Something went wrong!");
            }
        });
    }



</script>


