@model Domain.User
@{
    ViewBag.Title = "My Profile";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="~/assets/js/notify/bootstrap-notify.min.js"></script>
<script src="~/assets/js/notify/notify-script.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12 text-right">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#">  <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">My Profile</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h5>My Profile</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-3"></div>
                        <div class="col-sm-6">
                            <div class="panel">
                                <div class="panel-body">
                                    <input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
                                    <input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />
                                    @using (Html.BeginForm("MyProfile", "User", FormMethod.Post, new { @class = "form-horizontal" }))
                                    {
                                        @Html.HiddenFor(m => m.Id);
                                        @Html.HiddenFor(m => m.RoleId);
                                        @Html.HiddenFor(m => m.IsActive);
                                        <div class="form-group mb-3">
                                            <label class="col-sm-3 form-label">First Name: <span class="text-danger">*</span></label>
                                            <div class="col-sm-8">
                                                @Html.TextBoxFor(m => m.FirstName, new { @class = "form-control", type = "text", tabindex = 1 })
                                            </div>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label class="col-sm-3 form-label">Last Name: <span class="text-danger">*</span></label>
                                            <div class="col-sm-8">
                                                @Html.TextBoxFor(m => m.LastName, new { @class = "form-control", type = "text", tabindex = 2 })
                                            </div>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label class="col-sm-3 form-label">Email address: <span class="text-danger">*</span></label>
                                            <div class="col-sm-8">
                                                @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", type = "text", @readonly = "readonly" })
                                            </div>
                                        </div>

                                        <div class="form-group mb-3">
                                            <label class="col-sm-3 form-label">Phone number: <span class="text-danger">*</span></label>
                                            <div class="col-sm-8">
                                                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", type = "text", tabindex = 3 })
                                            </div>
                                        </div>
                                        <div class="form-footer mt-4">
                                            <button type="submit" class="btn btn-primary">Save</button>
                                        </div>

                                    }
                                </div><!-- panel-body -->
                            </div>
                        </div>
                        <div class="col-sm-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    if ('@ViewBag.Success' != "") {
        CommonNotification("success", '@ViewBag.Success');
        //ClearChangePasswordControl();
    }

    if ('@ViewBag.Error' != "") {
        CommonNotification("danger", '@ViewBag.Error');
    }

    $(document).ready(function () {
        if ($('#hdnCatListType').val() == 'Success') {
            CommonNotification($("#hdnSaveType").val().toLowerCase(), $("#hdnCatListMessage").val());
        }
        else if ($('#hdnCatListType').val() == 'Error') {
            if ($('#hdnCatListMessage').val() == 'Forbidden!') {
                window.location.href = "/Login/Index";
            } else {
                CommonNotification($("#hdnSaveType").val().toLowerCase(), $("#hdnCatListMessage").val());
            }
        }
    });

    function CommonNotification(type, message) {
        if (type == "error") {
            type = "danger";
        }
        var notify = $.notify(message,
            {
                type: type,
                allow_dismiss: true,
                delay: 2000,
                showProgressbar: true,
                timer: 300,
                animate: {
                    enter: 'animated fadeInDown',
                    exit: 'animated fadeOutUp'
                }
            });
    }
</script>