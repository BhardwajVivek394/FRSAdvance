@model Domain.ChangePassword
@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="~/assets/js/notify/bootstrap-notify.min.js"></script>
<script src="~/assets/js/notify/notify-script.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12 text-right">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#">  <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Change Password</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h5>Change Password</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-sm-3"></div>
                        <div class="col-sm-6">
                            <input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
                            <input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />
                            @using (Html.BeginForm("ChangePassword", "User", FormMethod.Post, new { @class = "form-horizontal" }))
                            {
                                @Html.HiddenFor(m => m.Id);
                                <div class="form-group mb-3">
                                    <label class="col-sm-3 control-label">Old Password: <span class="text-danger">*</span></label>
                                    <div class="col-sm-8">
                                        @Html.TextBoxFor(m => m.OldPassword, new { @class = "form-control", type = "password" })
                                        @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-group mb-3">
                                    <label class="col-sm-3 control-label">New Password: <span class="text-danger">*</span></label>
                                    <div class="col-sm-8">
                                        @Html.TextBoxFor(m => m.NewPassword, new { @class = "form-control", type = "password" })
                                        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })

                                    </div>
                                </div>
                                <div class="form-group mb-3">
                                    <label class="col-sm-3 control-label">Confirm Password: <span class="text-danger">*</span></label>
                                    <div class="col-sm-8">
                                        @Html.TextBoxFor(m => m.ConfirmPassword, new { @class = "form-control", type = "password" })
                                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                                <div class="form-footer mt-4">
                                    <button type="submit" class="btn btn-primary">Save</button>
                                </div>
                               
                            }
                        </div><!-- panel-body -->

                        <div class="col-sm-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>

    if ('@ViewBag.Success' != "") {
        CommonNotification("success", '@ViewBag.Success');
        ClearChangePasswordControl();
    }

    if ('@ViewBag.Error' != "") {
        CommonNotification("danger", '@ViewBag.Error');
    }

    $(document).ready(function () {
        if ($('#hdnCatListType').val() == 'Success') {
            CommonNotification($("#hdnSaveType").val().toLowerCase(), $("#hdnCatListMessage").val());
        }
        else if ($('#hdnCatListType').val() == 'Error') {
            if ($('#hdnCatListMessage').val() == 'Forbidden!') {
                window.location.href = "/Login/Index";
            } else {
                CommonNotification($("#hdnSaveType").val().toLowerCase(), $("#hdnCatListMessage").val());
            }
        }
    });

    function CommonNotification(type, message) {
        if (type == "error") {
            type = "danger";
        }
        var notify = $.notify(message,
            {
                type: type,
                allow_dismiss: true,
                delay: 2000,
                showProgressbar: true,
                timer: 300,
                animate: {
                    enter: 'animated fadeInDown',
                    exit: 'animated fadeOutUp'
                }
            });
    }

    function ClearChangePasswordControl() {
        $('#OldPassword').val('');
        $('#NewPassword').val('');
        $('#ConfirmPassword').val('');
    }
</script>
