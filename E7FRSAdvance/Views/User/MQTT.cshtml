@model Domain.MQTTDetailList
@{
    ViewBag.Title = "MQTT Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="~/assets/js/notify/bootstrap-notify.min.js"></script>
<script src="~/assets/js/notify/notify-script.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12 text-right">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#">  <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">MQTT Detail</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <h5>MQTT Detail</h5>
                </div>
                <div class="card-body">
                    <div class="row">

                        <div class="col-sm-6">
                            <h5>Web</h5>
                            @using (Ajax.BeginForm("MQTT", "User", new AjaxOptions()
                            {
                                HttpMethod = "POST",
                                UpdateTargetId = "divUserList",
                                InsertionMode = InsertionMode.Replace,
                                LoadingElementId = "loader",
                            }, new { @class = "form-horizontal", @id = "fmWeb" }))
                            {
                                { HtmlHelper.ClientValidationEnabled = false; }
                                <div id="divUserList">
                                    @Html.Partial("_AddMQTTWeb", Model)
                                </div>
                            }

                        </div><!-- panel-body -->

                        <div class="col-sm-6">
                            <h5>Utility</h5>

                            @using (Ajax.BeginForm("MQTT1", "User", new AjaxOptions()
                            {
                                HttpMethod = "POST",
                                UpdateTargetId = "divUserList1",
                                InsertionMode = InsertionMode.Replace,
                                LoadingElementId = "loader",
                            }, new { @class = "form-horizontal", @id = "frmUtility" }))
                            {
                                { HtmlHelper.ClientValidationEnabled = false; }
                                <div id="divUserList1">
                                    @Html.Partial("_AddMQTTUtility", Model)

                                </div>
                            }



                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>

    if ('@ViewBag.Success' != "") {
        CommonNotification("success", '@ViewBag.Success');
        ClearChangePasswordControl();
    }

    if ('@ViewBag.Error' != "") {
        CommonNotification("danger", '@ViewBag.Error');
    }
    function fnSaveWeb() {
        $("#fmWeb").submit();
    }
    function fnSavefrmUtility() {
        $("#frmUtility").submit();
    }

    function CommonNotification(type, message) {
        if (type == "error") {
            type = "danger";
        }
        var notify = $.notify(message,
            {
                type: type,
                allow_dismiss: true,
                delay: 2000,
                showProgressbar: true,
                timer: 300,
                animate: {
                    enter: 'animated fadeInDown',
                    exit: 'animated fadeOutUp'
                }
            });
    }


</script>
