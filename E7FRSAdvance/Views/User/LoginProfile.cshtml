@model Domain.LoginMacAddressLister
@{
    ViewBag.Title = "Login Profile";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Login Profile</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body" style="padding:15px;">
                <ul class="nav nav-tabs border-tab nav-primary mb-0" id="info-tab" role="tablist">
                    <li class="nav-item active" onclick="fnGetApproved(0,'divMacAddressList')"><a class="nav-link active" href="#pending" data-bs-toggle="tab"><strong>Pending</strong></a></li>
                    <li class="nav-item" onclick="fnGetApproved(1,'divMacAddressList1')"><a a class="nav-link" href="#approved" data-bs-toggle="tab"><strong>Approved </strong></a></li>
                    <li class="nav-item" onclick="fnLoadBlockMAC()"><a a class="nav-link" href="#blacklistMAC" data-bs-toggle="tab"><strong>Blacklist MAC</strong></a></li>
                </ul>

                <div class="tab-content mt-0">
                    <div class="tab-pane fade active show" id="pending">

                        @using (Ajax.BeginForm("LoginMacAddressList", "User", new AjaxOptions()
                        {
                            HttpMethod = "POST",
                            UpdateTargetId = "divMacAddressList",
                            InsertionMode = InsertionMode.Replace,
                            LoadingElementId = "loader",
                        }, new { id = "frmLoginMacAddress" }))
                        {
                            { HtmlHelper.ClientValidationEnabled = false; }
                            <div id="divMacAddressList">

                            </div>
                        }
                    </div>

                    <div class="tab-pane fade" id="approved">
                        @using (Ajax.BeginForm("LoginMacAddressList", "User", new AjaxOptions()
                        {
                            HttpMethod = "POST",
                            UpdateTargetId = "divMacAddressList1",
                            InsertionMode = InsertionMode.Replace,
                            LoadingElementId = "loader",
                        }, new { id = "frmLoginMacAddress1" }))
                        {
                            { HtmlHelper.ClientValidationEnabled = false; }
                            <div id="divMacAddressList1">

                            </div>
                        }

                    </div>

                    <div class="tab-pane fade" id="blacklistMAC">

                        @using (Ajax.BeginForm("_BlockMACList", "User", new AjaxOptions()
                        {
                            HttpMethod = "POST",
                            UpdateTargetId = "divBlockMACList",
                            InsertionMode = InsertionMode.Replace,
                            LoadingElementId = "loader",
                        }, new { id = "frmGetBlockMACList" }))
                        {
                            <div id="divBlockMACList">
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<script>
    $(document).ready(function () {
        $('#drpPageSize').change(function (e) {
            $("#hdnSkip").val('0');
            $("#frmLoginMacAddress").submit();
        });
        fnGetApproved(0, 'divMacAddressList');
    });
    function UpdateMacAddress(id, isapprove) {
        $("#loader").show();
        $.ajax({
            url: '/User/UpdateMacAddress',
            type: 'Post',
            data: '{id:' + id + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                if (data == true) {
                    CommonNotification("SUCCESS", "Device Approved!", "success");
                    $("#frmLoginMacAddress").submit();
                }
                else {
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function DeleteMacAddressById(id, isapprove) {
        $("#loader").show();
        $.ajax({
            url: '/User/DeleteMacAddressById',
            type: 'Post',
            data: '{id:' + id + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                if (data == true) {
                    CommonNotification("SUCCESS", "Device has been deleted!", "success");
                    if (isapprove == "true") {
                        $("#frmLoginMacAddress1").submit();
                    }
                    else {
                        $("#frmLoginMacAddress").submit();
                    }
                }
                else {
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }
    function fnGetApproved(id, divId) {

        $("#divMacAddressList1").empty();
        $("#divMacAddressList").empty();

        $("#loader").show();
        var isApproved = false;
        if (id == 1) {
            isApproved = true;
        }
        $.ajax({
            url: '/User/GetLoginProfile',
            type: 'Post',
            data: '{isApproved:' + isApproved + '}',
            contentType: 'application/json',
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();

                $("#" + divId).empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnLoadBlockMAC() {
        $('#frmGetBlockMACList').submit();
    }
</script>

