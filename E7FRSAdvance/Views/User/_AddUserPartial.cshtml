@model Domain.User

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-user" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            @Html.HiddenFor(m => Model.Id, new { @id = "hdnUserId" })
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add User</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader">Edit User</span></h4>
                }
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">

                        <div class="col-sm-6">
                            <label class="control-label">First Name <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.FirstName, new { @class = "form-control", tabindex = 1 })
                                <span class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <label class="control-label">Email address <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.EmailAddress, new { @class = "form-control", tabindex = 2 })
                                <span class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <label class="control-label">Phone Number  <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.PhoneNumber, new { @class = "form-control", tabindex = 3 })
                                <span class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <label class="control-label">User Level <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.DropDownListFor(m => m.UserLevelId, (IEnumerable<SelectListItem>)ViewBag.Levels, new { @class = "form-control", style = "width:100%", id = "levelAdd", tabindex = 4 })
                                <span id="spRole" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">Last Name <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.LastName, new { @class = "form-control", tabindex = 5 })
                                <span class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <label class="control-label">Password <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.TextBoxFor(m => Model.Password, new { @class = "form-control", tabindex = 6, type = "password" })
                                <span class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <label class="control-label">Role <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.DropDownListFor(m => m.RoleId, (IEnumerable<SelectListItem>)ViewBag.Roles, new { @class = "form-control", style = "width:100%", id = "roleAdd", tabindex = 7 })
                                <span id="spRole" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">Designation</label>
                            <div class="">
                                @Html.TextBoxFor(m => m.Designation, new { @class = "form-control", tabindex = 8 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">Max Desktop Device</label>
                            <div class="">
                                @Html.TextBoxFor(m => m.MaxDesktopDevice, new { @class = "form-control", tabindex = 9, @type = "number" })
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">Max Mobile Device</label>
                            <div class="">
                                @Html.TextBoxFor(m => m.MaxMobileDevice, new { @class = "form-control", tabindex = 10, @type = "number" })
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">User Class <span class="text-danger">*</span></label>
                            <div class="">
                                @Html.DropDownListFor(m => m.UserClassId, (IEnumerable<SelectListItem>)ViewBag.UserClass, "Select", new { @class = "form-control", style = "width:100%", tabindex = 9 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label">Calibration Percentage</label>
                            <div class="">
                                @Html.TextBoxFor(m => m.CalibrationPercentage, new { @class = "form-control", @type="number", tabindex = 9 })
                                <span class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label"><span>Is Active</span>  @Html.CheckBoxFor(m => Model.IsActive, new { style = "vertical-align:sub" })</label>
                        </div>

                        <div class="col-sm-6">
                            <label class="control-label"><span>Is YardConfig</span> @Html.CheckBox("IsYardConfig", new { style = "vertical-align:sub" }) </label>
                        </div>

                        <div class="col-sm-6">
                            <label class="control-label"><span>Is Calibration</span>  @Html.CheckBox("IsCalibration", new { style = "vertical-align:sub" })</label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label"><span>Is ChatBot Upload</span>  @Html.CheckBox("IsChatBotUpload", new { style = "vertical-align:sub" })</label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label"><span>Is High End Alert</span>  @Html.CheckBox("IsHighEndAlert", new { style = "vertical-align:sub" })</label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label"><span>Is MyDaily</span>  @Html.CheckBox("IsMyDaily", new { style = "vertical-align:sub" })</label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label"><span>Is Site Keeping</span>  @Html.CheckBox("IsSiteKeeping", new { style = "vertical-align:sub" })</label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label"><span>Is Test User</span>  @Html.CheckBox("IsTestUser", new { style = "vertical-align:sub" })</label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label"><span>Is Assign Alert</span>  @Html.CheckBox("IsAssignAlert", new { style = "vertical-align:sub" })</label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label"><span>Is Audit</span>  @Html.CheckBox("IsAudit", new { style = "vertical-align:sub" })</label>
                        </div>
                        <div class="col-sm-6">
                            <label class="control-label"><span>Is Admin</span>  @Html.CheckBox("IsConfiguration", new { style = "vertical-align:sub" })</label>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()" disabled="disabled" id="btnSave">Save</button>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/PageJS/User/AddUser.js"></script>