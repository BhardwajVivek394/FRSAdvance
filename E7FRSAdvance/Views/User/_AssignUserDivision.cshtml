@model List<Domain.UserDivision>

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-assign-user-division" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Assign User Division</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        @if (ViewBag.Division != null)
                        {
                            var mDivisions = ViewBag.Division as List<Domain.Division>;
                            if (mDivisions != null && mDivisions.Count > 0)
                            {
                                foreach (var mDivision in mDivisions)
                                {
                                    <div class="col-sm-6">
                                        @if (Model.Where(x => x.DivisionId == mDivision.Id).Count() > 0)
                                        {
                                            <input type="checkbox" id="chkUserDivision_@mDivision.Id" onclick="fnSaveUserDivision('@ViewBag.UserId','@mDivision.Id',this)" checked /><label for="chkUserDivision_@mDivision.Id" class="m-l-10">@mDivision.Name</label>
                                        }
                                        else
                                        {
                                            <input type="checkbox" id="chkUserDivision_@mDivision.Id"  onclick="fnSaveUserDivision('@ViewBag.UserId','@mDivision.Id',this)"/><label for="chkUserDivision_@mDivision.Id" class="m-l-10">@mDivision.Name</label>
                                        }
                                    </div>
                                }
                            }

                        }
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal">Close</a>
            </div>
        </div>
    </div>
</div>