@model Domain.RoleLister

@{
    ViewBag.Title = "Role";

}
<script src="~/Content/lib/jquery/jquery.js"></script>
<div class="">
    <div class="">
        <ol class="breadcrumb breadcrumb-quirk">
            <li><i class="fa fa-home mr5"></i>Home</li>
            <li class="active">Role</li>
        </ol>

        @using (Ajax.BeginForm("RoleList", "User", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divRoleList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "RoleRefreshed"
        }, new { id = "frmGetRoleList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divRoleList">
                @Html.Action("RoleList")
            </div>
        }


        @using (Ajax.BeginForm("SaveRole", "User", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveRole",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "RoleSaved"
        }, new { id = "frmSaveRole" }))
        {
            <div id="divSaveRole">
                @Html.Partial("_AddRolePartial", new Domain.Role())
            </div>
        }

    </div>
</div>

<script src="~/Content/PageJS/Role/RoleIndex.js"></script>