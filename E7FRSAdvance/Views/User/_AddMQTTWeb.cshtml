@model Domain.MQTTDetailList 
@Html.HiddenFor(m => m.mQTTDetailWeb.Id)
@Html.HiddenFor(m => m.mQTTDetailWeb.Type, new { id = "hdnType" })
<div class="form-group mb-3">
    <label class="col-sm-3 control-label">MQTT Ip: <span class="text-danger">*</span></label>
    <div class="col-sm-8">
        @Html.TextBoxFor(m => m.mQTTDetailWeb.MQTTUri, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.mQTTDetailWeb.MQTTUri, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group mb-3">
    <label class="col-sm-3 control-label">MQTT Username: <span class="text-danger">*</span></label>
    <div class="col-sm-8">
        @Html.TextBoxFor(m => m.mQTTDetailWeb.MQTTUsername, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.mQTTDetailWeb.MQTTUsername, "", new { @class = "text-danger" })

    </div>
</div>
<div class="form-group mb-3">
    <label class="col-sm-3 control-label">MQTT Password: <span class="text-danger">*</span></label>
    <div class="col-sm-8">
        @Html.TextBoxFor(m => m.mQTTDetailWeb.MQTTPassword, new { @class = "form-control", type = "password" })
        @Html.ValidationMessageFor(m => m.mQTTDetailWeb.MQTTPassword, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-group mb-3">
    <label class="col-sm-3 control-label">MQTT Pot: <span class="text-danger">*</span></label>
    <div class="col-sm-8">
        @Html.TextBoxFor(m => m.mQTTDetailWeb.MQTTPort, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.mQTTDetailWeb.MQTTPort, "", new { @class = "text-danger" })
    </div>
</div>
<div class="form-footer mt-4">
    <a class="btn btn-primary text-white" onclick="fnSaveWeb()">Save</a>
</div>
<script>

    if ('@ViewBag.Success' != "") {
        CommonNotification("success", '@ViewBag.Success');
        ClearChangePasswordControl();
    }

    if ('@ViewBag.Error' != "") {
        CommonNotification("danger", '@ViewBag.Error');
    }

</script>