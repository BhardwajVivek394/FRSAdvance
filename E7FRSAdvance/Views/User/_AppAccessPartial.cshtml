@model Domain.AppAccessLister

<div class="modal bounceIn animated" id="modal-AppAccess" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader">User History</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-sm-6">
                            <input type="hidden" id="hdnAppAccessUserId" />
                            <input type="text" id="txtAppAccessRange" class="form-control" />
                        </div>
                        <div class="col-sm-6">
                           <button id="btnAppAccessDownload" onclick="fnAppAccessDownload()" class="btn btn-success">Download</button>
                        </div>
                        <div class="col-sm-12">
                            <div style="height:500px;overflow-y: scroll;">
                                <table class="table" id="tblAppAccessByUser">
                                    <thead>
                                        <tr>
                                            <th>Start Time</th>
                                            <th>End Time</th>
                                            <th>Duration</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyAppAccessRangeByUser">
                                    </tbody>
                                </table>
                                <table class="table" id="tblAppAccessBySites">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Duration(Min)</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tbodyAppAccessRangeBySite">
                                    </tbody>
                                </table>
                            </div>


                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        $('#txtAppAccessRange').daterangepicker();
        $('#txtAppAccessRange').on('apply.daterangepicker', function (ev, picker) {
            if ($('#hdnAppAccessUserId').val() != null && $('#hdnAppAccessUserId').val() != undefined && $('#hdnAppAccessUserId').val() != '') {
                fnGetAppAccessByUser($('#hdnAppAccessUserId').val(), picker.startDate._d.toLocaleDateString(), picker.endDate._d.toLocaleDateString());
            }
            else {
                fnGetAppAccessBySite(picker.startDate._d.toLocaleDateString(), picker.endDate._d.toLocaleDateString());
            }
        });

        $('#txtAppAccessRange').on('cancel.daterangepicker', function (ev, picker) {
            $(this).val('');
            $("#sd").val('');
            $("#ed").val('');
        });
    });
</script>