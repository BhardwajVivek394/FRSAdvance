@model Domain.Role

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal bounceIn animated" id="modal-add-role" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-width">
        <div class="modal-content bradius4">
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader"> Add Role</span></h4>
                }
                else
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader"> Edit Role</span></h4>
                }
                <button type="button" class="btn-close" data-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    @Html.HiddenFor(m => Model.Id)

                    <div class="form-group mb-3">
                        <label class="col-sm-3 control-label">Title <span class="text-danger">*</span></label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(m => Model.Title, new { @class = "form-control", tabindex = 1 })
                            <span class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="col-sm-3 control-label">Description </label>
                        <div class="col-sm-8">
                            @Html.TextBoxFor(m => Model.Description, new { @class = "form-control", tabindex = 1 })
                            <span class="text-danger"></span>
                        </div>
                    </div>
                  
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                <a class="btn btn-primary ls-1-2" onclick="fnSave()">Save</a>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/PageJS/Role/AddRole.js"></script>