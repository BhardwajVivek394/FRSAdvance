@model Domain.UserLister

@{
    ViewBag.Title = "Users";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">User</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body" style="padding:15px;">
                <ul class="nav nav-tabs border-tab nav-primary mb-0" id="info-tab" role="tablist">
                    <li class="nav-item active"><a class="nav-link active" href="#user" onclick="fnLoadUsers()" data-bs-toggle="tab"><strong>Users</strong></a></li>
                    <li class="nav-item"><a a class="nav-link" href="#loginhistory" onclick="fnLoadLoginHistory()" data-bs-toggle="tab"><strong>Login Histroy</strong></a></li>
                    <li class="nav-item"><a a class="nav-link" href="#blockip" onclick="fnLoadBlockIP()" data-bs-toggle="tab"><strong>Blacklist IP</strong></a></li>

                </ul>
                <div class="tab-content mt-0">
                    <div class="tab-pane fade active show" id="user">

                        @using (Ajax.BeginForm("UserList", "User", new AjaxOptions()
                        {
                            HttpMethod = "POST",
                            UpdateTargetId = "divUserList",
                            InsertionMode = InsertionMode.Replace,
                            LoadingElementId = "loader",
                            OnSuccess = "UserRefreshed"
                        }, new { id = "frmGetUserList" }))
                        {
                            { HtmlHelper.ClientValidationEnabled = false; }
                            <div id="divUserList">
                                @Html.Action("UserList")
                            </div>
                        }

                    </div>

                    <div class="tab-pane fade" id="loginhistory">



                        @using (Ajax.BeginForm("LoginHistory", "User", new AjaxOptions()
                        {
                            HttpMethod = "POST",
                            UpdateTargetId = "divLoginHistory",
                            InsertionMode = InsertionMode.Replace,
                            LoadingElementId = "loader",
                        }, new { id = "fnGetLoginHistory" }))
                        {
                            { HtmlHelper.ClientValidationEnabled = false; }
                            <br />


                            <div id="divLoginHistory">
                                @*@Html.Action("LoginHistory")*@

                            </div>
                        }
                    </div>

                    <div class="tab-pane fade" id="blockip">

                        @using (Ajax.BeginForm("BlockIpList", "User", new AjaxOptions()
                        {
                            HttpMethod = "POST",
                            UpdateTargetId = "divBlockIpList",
                            InsertionMode = InsertionMode.Replace,
                            LoadingElementId = "loader",
                        }, new { id = "fnGetBlockIpList" }))
                        {
                            { HtmlHelper.ClientValidationEnabled = false; }
                            <br />
                            <div id="divBlockIpList">
                                @*@Html.Action("BlockIpList")*@
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="">
    <div>
        @using (Ajax.BeginForm("SaveUser", "User", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveUser",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "UserSaved"
        }, new { id = "frmSaveUser" }))
        {
            <div id="divSaveUser">
                @Html.Partial("_AddUserPartial", new Domain.User())
            </div>
        }

    </div>
</div>

<div class="">
    <div>
        @using (Ajax.BeginForm("_AppAccessPartial", "User", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divAppAccess",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmAppAccess" }))
        {
            <div id="divAppAccess">
                @Html.Partial("_AppAccessPartial", new Domain.AppAccessLister())
            </div>
        }

    </div>
</div>

<div id="divAssignUserDivision"></div>

<div class="modal bounceIn animated" id="modal-add-ipaddress" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-width">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel">Add Ip Address</h4>
                <button type="button" class="btn-close" data-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="form-group mb-3">
                        <label class="col-sm-3 control-label">Ip Address <span class="text-danger">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="txtIpAddress" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal">Close</a>
                <a class="btn btn-primary ls-1-2" onclick="fnBlockIpSave()">Save</a>
            </div>
        </div>
    </div>
</div>

<a id="downloadcsv"></a>

<script src="~/Content/PageJS/User/UserIndex.js"></script>