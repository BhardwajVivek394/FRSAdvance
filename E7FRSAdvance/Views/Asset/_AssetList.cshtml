@model Domain.AssetLister

<div class="row">
    <div class="col-12">
        <div class="table-responsive">
            <table class="table table-bordered">
                @foreach (var item in Model.mAssets.GroupBy(x => new { x.SiteId, x.SiteName }).Select(x => x.Key).ToList())
                {
                    if (Model.mAssets.Where(x => x.SiteId == item.SiteId && (x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK || x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE || x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL)).Count() > 0)
                    {
                        <tr>
                            <th rowspan="3" width="50">@item.SiteName</th>
                            <th>Track</th>
                            <td>
                                @{
                                    int trackCount = Model.mAssets.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK).Count();
                                }
                                @if (trackCount > 15)
                                {
                                    int div = trackCount / 15;
                                    int skip = 0;
                                    for (int i = 0; i <= div; i++)
                                    {
                                        <div class="btn-group mt-1">

                                            @foreach (var asset in Model.mAssets.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK).Skip(skip).Take(15))
                                            {
                                                <button type="button" class="btn btn-info" onclick="fnUpdateAsset('@asset.Id','@asset.Name')">@asset.Name</button>

                                            }
                                        </div>
                                        <br />
                                        skip += 15;
                                    }
                                }
                                else
                                {
                                    <div class="btn-group">

                                        @foreach (var asset in Model.mAssets.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK))
                                        {
                                            <button type="button" class="btn btn-info" onclick="fnUpdateAsset('@asset.Id','@asset.Name')">@asset.Name</button>

                                        }
                                    </div>
                                }


                            </td>

                        </tr>
                        <tr>
                            <th>Point</th>
                            <td>
                                @{
                                    int pointCount = Model.mAssets.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE).Count();
                                }
                                @if (pointCount > 15)
                                {
                                    int div = pointCount / 15;
                                    int skip = 0;
                                    for (int i = 0; i <= div; i++)
                                    {
                                        <div class="btn-group mt-1">

                                            @foreach (var asset in Model.mAssets.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE).Skip(skip).Take(15))
                                            {
                                                <button type="button" class="btn btn-info" onclick="fnUpdateAsset('@asset.Id','@asset.Name')">@asset.Name</button>

                                            }
                                        </div>
                                        <br />
                                        skip += 15;
                                    }
                                }
                                else
                                {
                                    <div class="btn-group">

                                        @foreach (var asset in Model.mAssets.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE))
                                        {
                                            <button type="button" class="btn btn-info" onclick="fnUpdateAsset('@asset.Id','@asset.Name')">@asset.Name</button>

                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Signal</th>
                            <td>
                                @{
                                    int signalCount = Model.mAssets.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL).Count();
                                }
                                @if (signalCount > 15)
                                {
                                    int div = signalCount / 15;
                                    int skip = 0;
                                    for (int i = 0; i <= div; i++)
                                    {
                                        <div class="btn-group mt-1">

                                            @foreach (var asset in Model.mAssets.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL).Skip(skip).Take(15))
                                            {
                                                <button type="button" class="btn btn-info" onclick="fnUpdateAsset('@asset.Id','@asset.Name')">@asset.Name</button>

                                            }
                                        </div>
                                        <br />
                                        skip += 15;
                                    }
                                }
                                else
                                {
                                    <div class="btn-group">

                                        @foreach (var asset in Model.mAssets.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL))
                                        {
                                            <button type="button" class="btn btn-info" onclick="fnUpdateAsset('@asset.Id','@asset.Name')">@asset.Name</button>

                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }

                }


            </table>
        </div>
    </div>

</div>



