@model Domain.SearchCriteria
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<style>
    .tableFixHead {
        overflow: auto;
        height: 100vh;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }
</style>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Inactive FRS Alert and Assets</li>
                </ol>
            </div>
        </div>
    </div>
</div>


<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-lg-12">
                <div class="row">
                    <div class="col-xl-1">
                        <strong class="mt-4">Search</strong>
                    </div>
                    <div class="col-xl-1 col-lg-4 col-md-4">
                        <span>Zone</span>
                        @Html.DropDownListFor(x => x.ZoneId, (IEnumerable<SelectListItem>)ViewBag.Zones, new { @class = "form-control", @id = "drpZone", tabindex = 1 })
                    </div>
                    <div class="col-xl-1 col-lg-4 col-md-4">
                        <input type="hidden" id="hdnPMClusterDivisionId" value="@Model.DivisionId" />
                        <span>Division</span>
                        @Html.DropDownListFor(x => x.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, new { @class = "form-control", @id = "drpDivision", tabindex = 2 })
                    </div>
                    <div class="col-xl-2 col-lg-4 col-md-4">
                        <span>Site</span>
                        <input type="hidden" id="hdnPMClusterSiteId" value="@Model.SiteId" />
                        @Html.DropDownListFor(x => x.SiteId, (IEnumerable<SelectListItem>)ViewBag.Sites, "All", new { @class = "form-control", @id = "drpSites", tabindex = 3 })
                    </div>
                    <div class="col-xl-2 col-lg-4 col-md-4">
                        <span>Type</span>
                        <select class="form-control" id="drpType">
                            <option value="All">All</option>
                            <option value="Asset">Asset</option>
                            <option value="Cause">Cause Code</option>
                        </select>
                    </div>
                    <div class="col-xl-1 col-lg-1 mt-3">
                        <a class="btn btn-success btn-quirk mt-1" href="javascript:void(0)" onclick="fnSearch()" title="Search"><i class="fa fa-search"></i></a>

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div id="divAlertAssetCauseCode"></div>
    </div>

</div>


<script>

    $(document).ready(function () {
        $("#drpZone").change(function () {
            GetDivisionByZone($(this).val());

        });

        $("#drpDivision").change(function () {
            GetSiteByDivisionId($(this).val());
        });

        fnSearch();
    });

    function fnSearch() {

        if ($('#drpType').val() == "Asset") {
            fnGetInActiveAssets();
        }
        else if ($('#drpType').val() == "Cause") {
            fnGetInActiveCauseCode();
        } else if ($('#drpType').val() == "All") {
            fnGetInActiveAssetsAndCauseCode();
        }

    }

    function fnGetInActiveAssets() {
        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#drpSites').val();
        mSearchCriteria.DivisionId = $('#drpDivision').val();
        mSearchCriteria.ZoneId = $('#drpZone').val();
        mAssetLister.SearchCriteria = mSearchCriteria;

        $("#loader").show();
        $.ajax({
            url: '/Asset/_AssetList',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divAlertAssetCauseCode").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnGetInActiveCauseCode() {
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#drpSites').val();
        mSearchCriteria.DivisionId = $('#drpDivision').val();
        mSearchCriteria.ZoneId = $('#drpZone').val();

        $("#loader").show();
        $.ajax({
            url: '/Asset/_AlertInfoActivationList',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mSearchCriteria),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divAlertAssetCauseCode").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnGetInActiveAssetsAndCauseCode() {
        var mSiteLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.Id = $('#drpSites').val();
        mSearchCriteria.DivisionId = $('#drpDivision').val();
        mSearchCriteria.ZoneId = $('#drpZone').val();
        mSiteLister.SearchCriteria = mSearchCriteria;

        $("#loader").show();
        $.ajax({
            url: '/Asset/SiteList',
            type: 'Post',
            contentType: 'application/json',
            data: JSON.stringify(mSiteLister),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divAlertAssetCauseCode").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnUpdateAsset(id, name) {

        var mAsset = {};
        mAsset.Id = id;
        mAsset.IsActive = true;
        mAsset.UpdateStatus = true;

        if (confirm('Are you sure you want to active asset ' + name + '?')) {
            $("#loader").show();
            $.ajax({
                url: '/Asset/UpdateAsset',
                type: 'Post',
                contentType: 'application/json',
                data: JSON.stringify(mAsset),
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            fnGetInActiveAssets();
                        } else {
                            CommonNotification("ERROR", data.result, "Error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function fnUpdateAlertInfoActivation(id) {

        var mAsset = {};
        mAsset.Id = id;
        mAsset.IsActive = true;
        mAsset.UpdateStatus = true;

        if (confirm('Are you sure you want to active this cause code?')) {
            $("#loader").show();
            $.ajax({
                url: '/Asset/UpdateAlertInfoActivation',
                type: 'Post',
                contentType: 'application/json',
                data: JSON.stringify(mAsset),
                success: function (data) {
                    $("#loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            fnGetInActiveCauseCode();
                        } else {
                            CommonNotification("ERROR", data.result, "Error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }


    function GetDivisionByZone(zoneId) {
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/Asset/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpDivision").empty();
                    $("#drpDivision").append($("<option></option>").val('0').html('Select'));
                    $.each(data, function (key, value) {
                        if ($('#hdnSearchDivisionId').val() != '0' && $('#hdnSearchDivisionId').val() == value.Id) {
                            $("#drpDivision").append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $("#drpDivision").append($("<option></option>").val(value.Id).html(value.Name));
                        }
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function GetSiteByDivisionId(divisionId) {
        if (divisionId != null && divisionId != undefined && divisionId != '') {

            $("#loader").show();
            $.ajax({
                url: '/Asset/GetSiteByDivisionId',
                type: 'POST',
                data: '{divisionId:' + divisionId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpSites").empty();
                    $("#drpSites").append($("<option></option>").val('0').html('Select'));
                    $.each(data, function (key, value) {
                        if ($('#hdnSearchSiteId').val() != '0' && $('#hdnSearchSiteId').val() == value.Id) {
                            $("#drpSites").append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $("#drpSites").append($("<option></option>").val(value.Id).html(value.Name));
                        }

                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }
</script>