@model List<Domain.AlertInfoActivation>

<div class="row">
    <div class="col-12">
        <div class="table-responsive">
            <table class="table table-bordered">
                @foreach (var item in Model.GroupBy(x => new { x.SiteId, x.Site }).Select(x => x.Key).ToList())
                {
                    <tr>
                        <th rowspan="2" width="10%">@item.Site</th>
                        <th width="30%"><b>Track</b></th>
                        <th width="30%"><b>Point</b></th>
                        <th width="30%"><b>Signal</b></th>
                    </tr>
                    <tr>
                        <td>
                            <div class="row">
                                @foreach (var cause in Model.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK).GroupBy(x => x.CauseCode))
                                {
                                    <div class="col-xl-6 col-lg-6">
                                        <div class="card mb-1">
                                            <div class="card-header text-center" style="padding: 10px !important">
                                                <b>
                                                    @cause.Key
                                                </b>
                                            </div>
                                            <div class="card-body" style="padding: 15px !important">

                                                    @foreach (var asset in Model.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK && x.CauseCode.Trim().ToUpper() == cause.Key.Trim().ToUpper()))
                                                    {
                                                        <button type="button" class="btn btn-info mr-3 mt-1" onclick="fnUpdateAlertInfoActivation('@asset.Id')">@asset.Asset</button>

                                                    }
                                               
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="row">
                                @foreach (var cause in Model.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE).GroupBy(x => x.CauseCode))
                                {
                                    <div class="col-xl-6 col-lg-6">
                                        <div class="card mb-1">
                                            <div class="card-header text-center" style="padding: 10px !important">
                                                <b>
                                                    @cause.Key
                                                </b>
                                            </div>
                                            <div class="card-body" style="padding: 15px !important">

                                                @foreach (var asset in Model.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE && x.CauseCode.Trim().ToUpper() == cause.Key.Trim().ToUpper()))
                                                {
                                                    <button type="button" class="btn btn-info mr-3 mt-1" onclick="fnUpdateAlertInfoActivation('@asset.Id')">@asset.Asset</button>
                                                }

                                            </div>
                                        </div>
                                    </div>

                                }
                            </div>
                        </td>
                        <td>
                            <div class="row">
                                @foreach (var cause in Model.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL).GroupBy(x => x.CauseCode))
                                {
                                    <div class="col-xl-6 col-lg-6">
                                        <div class="card mb-1">
                                            <div class="card-header text-center" style="padding: 10px !important">
                                                <b>
                                                    @cause.Key
                                                </b>
                                            </div>
                                            <div class="card-body" style="padding: 15px !important">
                                                @foreach (var asset in Model.Where(x => x.SiteId == item.SiteId && x.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL && x.CauseCode.Trim().ToUpper() == cause.Key.Trim().ToUpper()))
                                                {
                                                    <button type="button" class="btn btn-info mr-3 mt-1" onclick="fnUpdateAlertInfoActivation('@asset.Id')">@asset.Asset</button>

                                                }

                                            </div>
                                        </div>
                                    </div>

                                }
                            </div>
                        </td>
                    </tr>

                }


            </table>
        </div>
    </div>

</div>




