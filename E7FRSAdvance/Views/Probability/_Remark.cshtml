@model Domain.Probability

<div class="modal bounceIn animated" id="modal-probability-remark" tabindex="-1" aria-labelledby="modal-probability-remark" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content bradius4">

            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Alert Remark</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="right-sidebar-Chats">
                    <div class="msger">
                        <div class="msger-chat">
                            @if (Model.ProbabilityRemarks != null && Model.ProbabilityRemarks.Count > 0)
                            {
                                foreach (var remark in Model.ProbabilityRemarks)
                                {
                                    if (remark.UserId == E7FRSAdvance.Utility.ClsHttpContent.LoginUser.Id)
                                    {
                                        <div class="msg right-msg">
                                            <div class="msg-bubble">
                                                <div class="msg-info">
                                                    <div class="msg-info-name">@remark.UserName</div>
                                                </div>
                                                <div class="msg-text">@remark.Remark</div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="msg left-msg">
                                            <div class="msg-bubble">
                                                <div class="msg-info">
                                                    <div class="msg-info-name">@remark.UserName</div>
                                                </div>
                                                <div class="msg-text">@remark.Remark</div>
                                            </div>
                                        </div>
                                    }
                                }
                            }


                        </div>
                        <div class="msger-inputarea">
                            <input class="msger-input two uk-textarea" type="text" placeholder="Type Message here.." id="txtFailureAlertRemark">
                            @*<button class="msger-send-btn" type="button" onclick="fnChangeRemark('@Model.SiteId','@Model.AssetId','@Model.AlertId','@Model.TimeStamp.ToString()')"><i class="fa fa-location-arrow"></i></button>*@
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
