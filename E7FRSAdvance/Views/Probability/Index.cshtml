@model Domain.ProbabilityLister
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Predictive Alert</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">

        @using (Ajax.BeginForm("_List", "Probability", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divProbabilityList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
        }, new { id = "frmProbabilityList" }))
        {
            <div id="divProbabilityList">
                @Html.Action("_List", Model)
            </div>
        }
        <div id="divProbabilityRemark">
            @Html.Partial("_Remark", new Domain.Probability())
        </div>

    </div>
</div>

