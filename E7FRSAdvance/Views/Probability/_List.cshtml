@model Domain.ProbabilityLister

@Html.HiddenFor(m => m.SearchCriteria.ColumnName, new { id = "hdnColumnName" })
@Html.HiddenFor(m => m.SearchCriteria.SortDirection, new { id = "hdnSortDirection" })

<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />


<div class="container-fluid">
    <div class="email-wrap email-main-wrapper">
        <div class="row">
            <div class="col-xxl-12 col-xl-12 box-col-12">
                <div class="email-right-aside">
                    <div class="card email-body email-list">
                        <div class="mail-header-wrapper">
                            <div class="row">
                                <div class="col-xl-12">
                                    <div class="mail-body">
                                        <div class="row p-4">
                                            <div class="col-sm-2">
                                                <div class="form-group mb-2">
                                                    <label class="control-label center-block">Divisions:</label>
                                                    @Html.DropDownListFor(m => m.SearchCriteria.DivisionId, ViewBag.Divisions as SelectList, new { @class = "form-control", tabindex = 1 })
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <div class="form-group mb-2">
                                                    <label class="control-label center-block">Site:</label>
                                                    <select class="form-control" id="selSearchSiteName" name="SearchCriteria.SiteId">
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <div class="form-group mb-2">
                                                    <label class="control-label center-block">Gear:</label>
                                                    <select class="form-control" name="SearchCriteria.AssetTypeId" id="drpSerchAssetTypeId">
                                                        <option value="0">All</option>
                                                        @if (Model.AssetTypes != null && Model.AssetTypes.Count > 0)
                                                        {
                                                            foreach (var item in Model.AssetTypes)
                                                            {
                                                                <option @(Model.SearchCriteria.AssetTypeId == item.Id ? "selected" : "") value="@item.Id">@item.Name</option>

                                                            }
                                                        }

                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <div class="form-group mb-2">

                                                    <label class="control-label center-block">Asset:</label>
                                                    <select class="form-control" name="SearchCriteria.AssetId" id="drpSerchAssetId">
                                                        <option value="0">All</option>
                                                        @if (Model.Assets != null && Model.Assets.Count > 0)
                                                        {
                                                            foreach (var item in Model.Assets)
                                                            {
                                                                <option @(Model.SearchCriteria.AssetId == item.Id ? "selected" : "") value="@item.Id" data-AssetTypeId="@item.AssetTypeId">@item.Name</option>

                                                            }
                                                        }

                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <div class="form-group mb-2">
                                                    <label class="control-label center-block">From Date:</label>
                                                    @Html.TextBoxFor(m => m.SearchCriteria.StartDate, "{0:d}", new { id = "txtFromDate", @class = "form-control" })
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <div class="form-group mb-3">
                                                    <label class="control-label center-block">To Date:</label>
                                                    @Html.TextBoxFor(m => m.SearchCriteria.EndDate, "{0:d}", new { id = "txtToDate", @class = "form-control" })
                                                </div>
                                            </div>
                                            <div class="col-sm-2">
                                                <div class="form-group mb-2">
                                                    <label class="control-label center-block">Validity :</label>
                                                    <br />
                                                    @Html.HiddenFor(x => x.SearchCriteria.Validity)
                                                    @if (Model.SearchCriteria.Validity != null)
                                                    {
                                                        <label class="radio-inline">

                                                            @if (Model.SearchCriteria.Validity == true)
                                                            {
                                                                <input type="radio" name="filter" checked id="rdActive" value="1" />
                                                            }
                                                            else
                                                            {
                                                                <input type="radio" name="filter" id="rdActive" value="1" />
                                                            }
                                                            True
                                                        </label>
                                                        <label class="radio-inline">
                                                            @if (Model.SearchCriteria.Validity == false)
                                                            {
                                                                <input type="radio" name="filter" checked id="rdInActive" value="0" />
                                                            }
                                                            else
                                                            {
                                                                <input type="radio" name="filter" id="rdInActive" value="0" />
                                                            }
                                                            False
                                                        </label>
                                                    }

                                                </div>
                                            </div>

                                            <div class="col-sm-3">
                                                <a class="btn btn-success btn-quirk" onclick="fnSearchProbability()" data-bs-original-title="" title="Search"><i class="fa fa-search"></i></a>
                                                <a class="btn btn-primary btn-quirk" href="@Url.Action("DownloadProbability")" data-bs-original-title="" title="Download csv"><i class="fa fa-download"></i></a>
                                                <a href="#" class="btn btn-danger btn-quirk" onclick="fnDeleteSelected()" data-bs-original-title="" title="Delete selected alert log"><i class="fa fa-trash"></i></a>

                                            </div>
                                            @*<div class="col-sm-1">
                                                    <a class="btn btn-primary btn-quirk" href="@Url.Action("DownloadProbability")" data-bs-original-title="" title="">Download</a>
                                                </div>*@
                                        </div>
                                    </div>
                                </div>
                                @if (Model.AssetTypes != null && Model.AssetTypes.Count > 0)
                                {
                                    <div class="col-xl-12" style="background-color: #215968; height: 45px;">
                                        <div class="mail-header">
                                            <div class="form-check form-check-inline">
                                                <input class="form-check-input checkbox-primary" id="allSelectCheckbox" type="checkbox" value="@Model.AssetTypes.FirstOrDefault().Name.Replace(" ","")">
                                                <ul class="email-tabs nav" role="tablist">
                                                    @if (Model.AssetTypes != null && Model.AssetTypes.Count > 0)
                                                    {
                                                        foreach (var item in Model.AssetTypes)
                                                        {

                                                            <li class="nav-item">
                                                                @{
                                                                    var isActive = string.Empty;
                                                                }

                                                                @if (item == Model.AssetTypes.FirstOrDefault())
                                                                {
                                                                    isActive = "active";
                                                                }

                                                                <a class="nav-link @isActive" id="@item.Name.Replace(" ","")-pill-tab" data-bs-toggle="pill" href="#@item.Name.Replace(" ","")-pill" role="tab" aria-controls="@item.Name.Replace(" ","")-pill" aria-selected="false" style="color:white;" onclick="fnChangeTab('@item.Name.Replace(" ","")')">
                                                                    <div>@item.Name</div>
                                                                    <span class="span badge rounded-pill pill-badge-primary">@Model.Probability.Where(x => x.AssetTypeId == item.Id).Count()</span>
                                                                </a>
                                                            </li>

                                                        }
                                                    }


                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                        </div>
                        <div class="tab-content" id="email-pills-tabContent">
                            @if (Model.AssetTypes != null && Model.AssetTypes.Count > 0)
                            {
                                foreach (var assetType in Model.AssetTypes)
                                {
                                    var isActive = "";
                                    if (assetType == Model.AssetTypes.FirstOrDefault())
                                    {
                                        isActive = "show active";
                                    }
                                    <div class="tab-pane fade @isActive" id="@assetType.Name.Replace(" ","")-pill" role="tabpanel" aria-labelledby="@assetType.Name.Replace(" ","")-pill-tab">
                                        <div class="mail-body-wrapper">
                                            <ul id="paginated-list" data-current-page="1" aria-live="polite">
                                                @foreach (var site in Model.Probability.Where(x => x.AssetTypeId == assetType.Id).GroupBy(x => new { x.SiteId, x.SiteName }).Select(x => x.Key).ToList())
                                                {
                                                    var probabilityCount = Model.Probability.Where(x => x.AssetTypeId == assetType.Id && x.SiteId == site.SiteId).Count();
                                                    <li class="inbox-data" style="background-color:#f4f8f8">
                                                        <div class="inbox-message">

                                                            <div class="email-data">
                                                                <span style="float:left;">@site.SiteName &nbsp;</span><span class="span badge rounded-pill1 pill-badge-primary" style="color:white;">@probabilityCount</span>
                                                            </div>
                                                            <span class="pull-right">
                                                                <a href="#" data-bs-original-title="" title=""><i class="fa fa-angle-up fa-3x" onclick="fnShowProbabilitySite('@site.SiteId',this); return false;"></i></a>
                                                            </span>
                                                        </div>
                                                    </li>

                                                    <li class="inbox-data  probabilitySite_@(site.SiteId)" style="display:none">
                                                        <table class="table">
                                                            <thead class="bg-primary">
                                                                <tr>
                                                                    <th></th>
                                                                    <th data-sortcolumn="TimeStamp" class="sorting" id="thTimeStamp" onclick="SortList('TimeStamp');">Date</th>
                                                                    <th data-sortcolumn="SiteName" class="sorting" id="thSiteName" onclick="SortList('SiteName');">SiteName</th>
                                                                    <th data-sortcolumn="AssetName" class="sorting" id="thAssetName" onclick="SortList('AssetName');">Gear Name</th>
                                                                    <th data-sortcolumn="Category" class="sorting" id="thCategory" onclick="SortList('Category');">Category</th>
                                                                    <th data-sortcolumn="Validity" class="sorting text-center" id="thValidity" onclick="SortList('Validity');">Validity</th>
                                                                    <th data-sortcolumn="Remark" class="sorting text-center" id="thRemark" onclick="SortList('Remark');">Remark</th>
                                                                    <th data-sortcolumn="Delete" class="sorting text-center" id="thDelete">Delete</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>


                                                                @foreach (var item in Model.Probability.Where(x => x.AssetTypeId == assetType.Id && x.SiteId == site.SiteId))
                                                                {

                                                                    <tr class="table-light">
                                                                        <td>
                                                                            <input class="form-check-input checkbox-primary clsSelectAlltype clsSelectCheckbox_@item.AssetTypeName.Replace(" ","")" id="smsCheckbox" type="checkbox" name="chkProbabilityDelete" data-assetid="@item.AssetId" data-siteid="@item.SiteId" data-timestamp="@item.TimeStamp" data-category="@item.CategoryAlias">
                                                                        </td>
                                                                        <td>
                                                                            @if (item.TimeStamp != null && item.TimeStamp != DateTime.MinValue)
                                                                            {
                                                                                <span>@item.TimeStamp.ToString()</span>
                                                                            }
                                                                        </td>
                                                                        <td>@item.SiteName</td>
                                                                        <td>@item.AssetName</td>
                                                                        <td>
                                                                            @if (item.Category.Contains("TrainMomentLog"))
                                                                            {
                                                                                <span>
                                                                                    @item.Category.Replace("TrainMomentLog", "Prone To Shorting")
                                                                                </span>
                                                                            }
                                                                            else if (item.Category.Contains("GluedLog"))
                                                                            {
                                                                                <span>
                                                                                    @item.Category.Replace("GluedLog", "Glued")
                                                                                </span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span>
                                                                                    @item.Category
                                                                                </span>
                                                                            }
                                                                        </td>
                                                                        <td class="text-center">
                                                                            <label class="form-check form-switch" style="margin-left:100px">
                                                                                @if (item.Validity != null && item.Validity.Value)
                                                                                {
                                                                                    <input type="checkbox" class="form-check-input f-20" onchange="fnChangeValidity(this,'@item.AssetId','@item.SiteId','@item.TimeStamp.ToString()','@item.CategoryAlias')" checked />
                                                                                }
                                                                                else
                                                                                {
                                                                                    <input type="checkbox" class="form-check-input f-20" onchange="fnChangeValidity(this,'@item.AssetId','@item.SiteId','@item.TimeStamp.ToString()','@item.CategoryAlias')" />
                                                                                }
                                                                            </label>
                                                                        </td>
                                                                        <td class="text-center">
                                                                            <i class="fa fa-comment f-20" title="Remarks" onclick="fnGetRemark('@item.SiteId','@item.AssetId','@item.TimeStamp.ToString()','@item.CategoryAlias')" aria-hidden="true"></i>
                                                                        </td>
                                                                        <td class="text-center">
                                                                            <i class="fa fa-trash-o trash-3 f-20" title="Remarks" onclick="fnDeleteProbability('@item.SiteId','@item.AssetId','@item.TimeStamp.ToString()','@item.CategoryAlias')" aria-hidden="true"></i>
                                                                        </td>
                                                                    </tr>

                                                                }


                                                            </tbody>

                                                        </table>
                                                    </li>
                                                }

                                            </ul>

                                        </div>
                                    </div>
                                }
                            }


                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#drpPageSize').change(function (e) {
            $("#hdnSkip").val('0');
            $("#frmProbabilityList").submit();
        });

          $('#txtFromDate').datepicker({
            dateFormat: 'mm/dd/yy',
            autoClose: true
        });

        if ($('#txtFromDate').val() == "@DateTime.MinValue") {
            $('#txtFromDate').val('');
        }


        $('#txtToDate').datepicker({
            dateFormat: 'mm/dd/yy',
            autoClose: true
        });

        if ($('#txtToDate').val() == "@DateTime.MinValue") {
            $('#txtToDate').val('');
        }

        GetAllSite($('#SearchCriteria_DivisionId').val(),'@Model.SearchCriteria.SiteId');
        $('#SearchCriteria_DivisionId').change(function () {
            GetAllSite($(this).val(),'@Model.SearchCriteria.SiteId');
        });

        $('#allSelectCheckbox').change(function () {
            if ($(this).prop('checked') == true) {
                $('.clsSelectCheckbox_' + $(this).val()).prop('checked', true);
            } else {
                $('.clsSelectCheckbox_' + $(this).val()).prop('checked', false);

                $('.clsSelectAlltype').prop('checked', false);
            }
        })
    });

    function fnChangeTab(type) {
        $('#allSelectCheckbox').val(type);
    }

    function GetRemarks($this, id) {
        if ($($this).hasClass("fa-plus")) {
            $($this).removeClass("fa-plus").addClass("fa-minus");
            $("#trSMSLogRemark" + id).show();
        } else {
            $($this).removeClass("fa-minus").addClass("fa-plus");
            $("#trSMSLogRemark" + id).hide();
        }
    }

    function fnChangeValidity($this, assetId, siteId, timeStamp, category) {
        var mProbability = {};
        mProbability.AssetId = assetId;
        mProbability.SiteId = siteId;
        mProbability.TimeStamp = timeStamp;
        mProbability.Category = category;
        if ($($this).prop('checked') == true) {
            mProbability.Validity = true;
        }
        else {
            mProbability.Validity = false;
        }
        $("#loader").show();
        $.ajax({
            url: '/Probability/UpdateProbability',
            type: 'Post',
            data: '{mProbability:' + JSON.stringify(mProbability) + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnDeleteProbability(siteId, assetId, timeStamp, category) {
        var mProbability = {};
        mProbability.SiteId = siteId;
        mProbability.AssetId = assetId;
        mProbability.TimeStamp = timeStamp;
        mProbability.Category = category;
        if (confirm('Are you sure you want to delete this record?')) {
            $("#loader").show();
            $.ajax({
                url: '/Probability/DeleteProbability',
                type: 'Post',
                data: '{mProbability:' + JSON.stringify(mProbability) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data != undefined && data != '') {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            $('#frmProbabilityList').submit();
                        }
                        else if (data.type == "error")
                        {
                            CommonNotification("ERROR", data.result, "Error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }

    function fnDeleteSelected() {
        var j = 0;
        var selectedValue = [];
        $("input:checkbox[name=chkProbabilityDelete]:checked").each(function () {
            var mProbability = {};
            mProbability.SiteId = $(this).data('siteid');
            mProbability.AssetId = $(this).data('assetid');
            mProbability.TimeStamp = $(this).data('timestamp');
            mProbability.Category = $(this).data('category');
            selectedValue.push(mProbability);
        });
        if (selectedValue != null && selectedValue != undefined && selectedValue.length > 0) {
            if (confirm('Are you sure you want to delete selected record')) {
                $("#loader").show();
                $.ajax({
                    url: '/Probability/DeleteAllProbability',
                    type: 'Post',
                    data: '{mProbabilities:' + JSON.stringify(selectedValue) + '}',
                    contentType: 'application/json',
                    success: function (data) {
                        $("#loader").hide();
                        $('#frmProbabilityList').submit();
                    },
                    error: function (response) {
                        $("#loader").hide();
                        CommonNotification("ERROR", "Something went wrong!", "Error");
                    }
                });

            }

        } else {
            CommonNotification("ERROR", "Please select any option for delete alert log", "error");
        }
    }

    function fnChangeRemark(siteId, assetId, timeStamp, category) {
        if ($('#txtProbabilityRemark').val() != null && $('#txtProbabilityRemark').val() != undefined && $('#txtProbabilityRemark').val() != '') {
            var mProbability = {};
            mProbability.AssetId = assetId;
            mProbability.SiteId = siteId;
            mProbability.TimeStamp = timeStamp;
            mProbability.Category = category;
            mProbability.ValidityRemark = $('#txtProbabilityRemark').val();

            $.ajax({
                url: '/Probability/UpdateProbability',
                type: 'Post',
                data: '{mProbability:' + JSON.stringify(mProbability) + '}',
                contentType: 'application/json',
                success: function (data) {

                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        } else {


        }

    }

    function fnGetRemark(siteId, assetId, timeStamp, category) {
        var mProbability = {};
        mProbability.AssetId = assetId;
        mProbability.SiteId = siteId;
        mProbability.TimeStamp = timeStamp;
        mProbability.Category = category;
        $("#loader").show();
        $.ajax({
            url: '/Probability/GetRemark',
            type: 'Post',
            data: '{mProbability:' + JSON.stringify(mProbability) + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divProbabilityRemark").empty().append(data);
                $('#modal-probability-remark').show("model")
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });

    }

    function fnGetCluster(assetTypeId, $this) {
        if (assetTypeId != null && assetTypeId != undefined && assetTypeId != '') {
            if ($($this).hasClass("fa-plus")) {
                $($this).removeClass("fa-plus").addClass("fa-minus");
                $('.trAsset_' + assetTypeId).show();
            }
            else {
                $($this).removeClass("fa-minus").addClass("fa-plus");
                $('.trAsset_' + assetTypeId).hide();
            }
        }
    }

    function fnSearchProbability() {
        $("#hdnSkip").val(0);

        var filterType = $('input[name="filter"]:checked').val();
        if (filterType == "0") {
            $("#SearchCriteria_Validity").val(false);
        } else if (filterType == "1") {
            $("#SearchCriteria_Validity").val(true);
        }

        $("#frmProbabilityList").submit();
    }

    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmProbabilityList").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize)
            {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmProbabilityList").submit();
            }
        }
    }

    function GetAllSite(divisionId, hdnSiteId) {
        $("#selSearchSiteName").empty();
        if (divisionId != null && divisionId != undefined && divisionId != '' && parseInt(divisionId) > 0) {
            $("#loader").show();
            $.ajax({
                url: '/Probability/GetSitesBy',
                type: 'Post',
                data: '{divisionId:' + divisionId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data.length > 0) {
                        var html = "";
                        html += "<option value='0'>All</option>";
                        $.each(data, function (id, val) {
                            if (hdnSiteId == val.Id) {
                                html += "<option value=" + val.Id + " selected>" + val.Name + "</option>";
                            }
                            else {
                                html += "<option value=" + val.Id + ">" + val.Name + "</option>";
                            }

                        });
                        $("#selSearchSiteName").append(html);
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            GetSite(hdnSiteId);
        }

    }

    function GetSite(hdnSiteId) {
        $("#selSearchSiteName").empty();
        $("#loader").hide();
        $.ajax({
            url: '/Probability/GetAllSites',
            type: 'Post',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                if (data != null && data.length > 0) {
                    var html = "";
                    html += "<option value='0'>All</option>";
                    $.each(data, function (id, val) {
                        if (hdnSiteId == val.Id) {
                            html += "<option value=" + val.Id + " selected>" + val.Name + "</option>";
                        }
                        else {
                            html += "<option value=" + val.Id + ">" + val.Name + "</option>";
                        }

                    });
                    $("#selSearchSiteName").append(html);
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }


    function fnShowProbabilitySite(siteId, $this) {
        if (siteId != null && siteId != '' && siteId != undefined) {
            if ($($this).hasClass("fa fa-angle-up")) {
                $($this).removeClass("fa fa-angle-up").addClass("fa fa-angle-down");
                $('.probabilitySite_' + siteId).show();
            } else {
                $($this).removeClass("fa fa-angle-down").addClass("fa fa-angle-up");
                $('.probabilitySite_' + siteId).hide();
            }
        }
    }
</script>
