@model Domain.ChatBotUrlLister
@{
    ViewBag.Title = "ChatBotUrl";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">ChatBotUrl</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="">
    <div class="">
        @using (Ajax.BeginForm("List", "ChatBotUrl", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divChatBotUrlList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmChatBotUrlList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divChatBotUrlList">
                @Html.Action("List")
            </div>
        }
    </div>
</div>