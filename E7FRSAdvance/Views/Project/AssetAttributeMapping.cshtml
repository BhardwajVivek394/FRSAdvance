@model Domain.Project

@if (ViewBag.AssetTypes != null)
{
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="card-header">
                    <h5>Assign Attribute</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table">
                            @if (ViewBag.AssetTypes != null)
                            {
                                var mAssetTypes = ViewBag.AssetTypes as List<Domain.AssetType>;
                                if (mAssetTypes != null && mAssetTypes.Count > 0)
                                {
                                    foreach (var item in mAssetTypes)
                                    {
                                        if (item.Id == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK || item.Id == (int)E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE || item.Id == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL)
                                        {
                                            <tr>
                                                <td>
                                                    <a class="fa fa-plus" onclick="GetAssestAttributes('@Model.Id','@item.Id',this)"></a>
                                                </td>
                                                <td>@item.Name</td>
                                            </tr>
                                            <tr id="trAssestTypes@(item.Id)" style="display:none;">
                                            </tr>
                                        }

                                    }

                                }
                            }
                        </table>
                    </div>
                </div>
            </div>
          
        </div>
    </div>

}
