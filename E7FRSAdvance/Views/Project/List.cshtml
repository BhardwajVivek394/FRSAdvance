@model List<Domain.Project>

<div class="row">
    <div class="col-xl-12">
        <div class="card">
            <div class="card-header">
                <div class="pull-right">
                    <a href="javascript:void(0)" title="Add Project" class="btn btn-primary" onclick="fnAddProject()">Add Project</a>
                </div>
            </div>
            <div class="card-body" style="padding:15px;">

                <div class="row">
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <div class="col-12">
                                <div class="card mb-2">
                                    <div class="card-body text-white" style="padding: 15px; font-size: 18px; background-color: #21596880; border-radius: 12px; ">
                                        @item.Name
                                        <div class="pull-right">
                                            <a href="javascript:void(0)" data-bs-original-title="Edit Project"><i class="fa fa-pencil" style="font-size:25px; margin-right:2px; color: #fff;" onclick="fnEditProject('@item.Id')"></i></a>
                                            <a href="javascript:void(0)"><i class="fa fa-angle-up f-30" style="color:#fff;" onclick="fnShowProject('@item.Id',this)"></i></a>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-lg-12 divProject_@(item.Id)" style="display: none; padding: 20px;">
                                    
                                </div>
                          </div>                      
                        }
                    }

                </div>

            </div>
        </div>
    </div>
</div>