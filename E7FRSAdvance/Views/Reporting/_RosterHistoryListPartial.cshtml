@model Domain.RosterHistoryLister
@if (Model != null && Model.RosterHistories.Count > 0)
{
    <div class="row">
            <div class="col-sm-12 mb-3">
                <div class="text-end">
                    <a class="btn btn-primary" onclick="fnCreateRoster()">Save</a>
                </div>
            </div>
        </div>
}
<div class="table-responsive" style="max-height: 620px;">
    <table class="table table-sm">
        <thead class="table-dark">
            <tr>
                <th style="width:200px;">Day</th>
                <th style="width:180px; text-align:left">Gear </th>
                <th style="width:200px;">Condition</th>
                <th style="width:100px;">Status </th>
                <th>Remark</th>
            </tr>
        </thead>
        <tbody id="tbodyHistoryList">
            @if (Model != null && Model.RosterHistories.Count > 0)
            {
                foreach (var item in Model.RosterHistories.OrderBy(x => x.AssignDate).ToList())
                {
                    <tr data-id="@item.Id" data-date="@item.AssignDate.ToShortDateString()" data-assetId="@item.AssetId" data-siteId="@item.SiteId" data-rosterId="@item.RosterId">
                        <td>@item.AssignDate.ToShortDateString()</td>
                        <td>@item.AssetTypeName > @item.Name</td>
                        <td>@item.MaintenanceInput</td>
                        <td style="width:104px;" class="text-center" >
                            @if (item.Status.Contains("Open"))
                            {
                                <input type="checkbox" class="chkRoster" />
                            }
                            else
                            {
                                <input type="checkbox" checked class="chkRoster" />
                            }

                        </td>
                        <td style="width:200px;">
                            <input type="text" style="height:34px;" placeholder="Remark" value="@item.Remark" class="form-control" />
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">
                        No record found
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>