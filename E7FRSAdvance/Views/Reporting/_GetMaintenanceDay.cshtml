@model List<DateTime>

@if (Model != null && Model.Count > 0)
{
    <div class="row">
        <div class="col-sm-12 mb-3 mt-2">
            <div class="text-right">
                <a class="btn btn-primary" onclick="fnScheduleMaintenenace()">Schedule Maintenenace</a>
            </div>
        </div>
    </div>

}

<div class="table-responsive" style="max-height:700px;">
    <table class="table">
        <thead class="table-dark">
            <tr>
                <th style="width:200px;">Day</th>
                <th style="width:40px; text-align:center">Rest</th>
            </tr>
        </thead>
        <tbody id="tblRooster">
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.ToString("dd")  @item.ToString("MMM"), @item.ToString("yy") (@item.ToString("dddd"))
                    </td>
                    <td style="text-align:center">
                        <input type="checkbox" class="schedule" value="@item.ToShortDateString()" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

