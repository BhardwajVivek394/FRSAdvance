@model List<Domain.MaintenanceSchedule>

@if (Model != null && Model.Count > 0)
{
    @*<div class="row">
            <div class="col-sm-12 mb10">
                <div class="text-right">
                    <a class="btn btn-primary" onclick="fnCreateRoster()">Save</a>
                </div>
            </div>
        </div>*@
    <div class="alert alert-success">
        <strong>Success!</strong> Roster has been created. You can edit roster in Roster History tab.
    </div>

}

<div class="table-responsive" style="max-height:700px;">
    <table class="table table-xs">
        <thead class="table-dark">
            <tr>
                <th style="width:200px;">Day</th>
                <th style="width:180px; text-align:left">Track</th>
                <th>Condition</th>
                @*<th style="width:100px;">Attended </th>*@
                @*<th style="width:200px;">Remark</th>*@
            </tr>
        </thead>
        <tbody id="tblRooster">
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @item.ScheduleDate.ToString("dd")  @item.ScheduleDate.ToString("MMM"), @item.ScheduleDate.ToString("yy") (@item.ScheduleDate.ToString("dddd"))
                    </td>

                    <td style="text-align:left;padding:0px;" class="" colspan="4">

                        <table class="table table-bordered" style="margin-bottom:0px;">
                            @foreach (var report in item.maintenanceInputs)
                            {
                                <tr class="roster-table">
                                    <td style="width:180px;">@report.AssetTypeName  >  @report.Name</td>
                                    <td>
                                        @report.MaintenenceInput
                                    </td>
                                    @*<td style="width:104px;"  class="text-center" data-date="@item.ScheduleDate.ToShortDateString()" data-assetId="@report.AssetId" data-siteId="@report.SiteId">
                                        <input type="checkbox" class="chkRoster" readonly />
                                    </td>*@
                                    @*<td style="width:200px;">
                                        <input type="text" style="height:34px;" placeholder="Remark" class="form-control" />
                                    </td>*@
                                </tr>
                            }
                        </table>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
