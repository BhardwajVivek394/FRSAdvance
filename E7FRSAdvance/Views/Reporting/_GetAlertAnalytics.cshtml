@model Domain.AnalyticsLister
<style>
    .tdwith1 {
        min-width: 100px;
        height: 25px;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 100px;
    }
   .table1 {
        border-collapse: collapse;
        overflow-x: scroll;
        display: block;
    }
    .tableFixHead {
        overflow-y: auto;
        height: 100vh;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }
    .table th, .table td {
        padding: 10px;
    }
</style>

<div class="tableFixHead">
    <table class="table table-bordered" id="tblAnalytics">
        <thead class="table-dark" style="">
            <tr>
                <th  class="text-center" id="typename">

                </th>
                @foreach (var item in Model.mAlerts)
                {
                    <th  class="tdwith">@item.AlertName</th>
                }
                <th style="min-width:70px;">Sum</th>
            </tr>
        </thead>
        <tbody >
            @if (Model != null && Model.Analytics.Count > 0)
            {
                foreach (var item in Model.Analytics)
                {
            <tr>
                <td class="text-center tdwith" style="">
                    @item.AssetName
                </td>
                @{ int count = 0;}
                @foreach (var data in item.mAlertValues)
                {
                    if (data.TotalCount > 0)
                    {
                        <td class="tdwith" onclick="fnGetAlertWiseCount('@data.Id','@item.AssetId')">@data.TotalCount</td>
                    }
                    else
                    {
                        <td class="tdwith" >@data.TotalCount</td>
                    }
                    if (data.Id > 0)
                    {
                        count += data.TotalCount;
                    }

                }
                <td style="min-width:70px;" style="width:100%">@count</td>
            </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" class="text-center">
                        No record found
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<script>
    $(document).ready(function () {
        $("#divDownalod").show();
        $("#typename").html($("#hdnAssetType").val())
    })
</script>

