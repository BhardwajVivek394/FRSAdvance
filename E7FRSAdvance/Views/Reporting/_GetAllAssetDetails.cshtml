@model List<Domain.Asset>

<div class="row">
    <div class="col-sm-12" id="byasset">
        <div class="table-responsive" style="max-height: 620px;">
            <table class="table table-xs">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">
                            <label class="ckbox ckbox-primary">
                                <input style="cursor:pointer;margin:5px" type="checkbox" id="checkAllAsset" />
                            </label>
                        </th>
                        <th>Name</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center width60">
                                    <label class="ckbox ckbox-primary">
                                        <input style="cursor:pointer;margin:5px" class="assets" type="checkbox" data-id="@item.Id" data-attributeid="@item.AttributeId" data-siteId="@item.SiteId" id="chkSite('@item.Id')"  data-assetTypeId="@item.AssetTypeId"/>
                                    </label>
                                </td>
                                <td>

                                    <span data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Asset Type">@item.AssetTypeName</span> >
                                    <span data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Asset">@item.Name</span>
                                    @*<span data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Attribute">@item.AttributeName</span>*@
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center">
                                No record found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-sm-4" id="byAttribute" style="display:none;">
        <div class="col">
            <label>Attributes</label>
            <div class="m-t-15 m-checkbox-inline" id="divAttributes">
                @*@if (Model[0].assetAttributes != null && Model[0].assetAttributes.Count > 0)
                {
                    foreach (var item in Model[0].assetAttributes)
                    {
                        <div class="form-check form-check-inline checkbox checkbox-primary mb-0">
                            <input class="form-check-input attribute-check" data-attId="@item.Id" id="att@(item.Id)" type="checkbox" data-bs-original-title="" title="">
                            <label class="form-check-label" for="att@(item.Id)">@item.Title</label>
                        </div>
                    }
                }*@

            </div>
        </div>
    </div>
</div>

<div class="row" style="margin-top:10px;margin-bottom:10px">
    <div class="col-sm-3 ">
        <div class="input-group mb-3">
            <input class="datepicker-here form-control digits" autocomplete="off" type="text" data-language="en" data-bs-original-title="" title="" id="datepickerStart">
            <span class="input-group-text"><i class="fa fa-calendar"></i></span>
        </div>
        <div class="input-group mt20" id="fTime">
            <input id="tpFrom" type="text" class="form-control" />
            <span class="input-group-text"><i class="fa fa-calendar-times-o"></i></span>
        </div>
    </div>
    <div class="col-sm-3 mb-3">
        <div class="input-group mb-3">
            <input class="datepicker-here form-control digits" autocomplete="off" type="text" data-language="en" data-bs-original-title="" title="" id="datepickerEnd">
            <span class="input-group-text"><i class="fa fa-calendar"></i></span>
        </div>
        <div class="input-group mt20" id="tTime">
            <input id="tpTo" type="text" class="form-control" />
            <span class="input-group-text"><i class="fa fa-calendar-times-o"></i></span>
        </div>
    </div>
    <div class="col-sm-3 mb-3">
        <input type="hidden" id="selDatabase" value="MQTT" />
        <div class="btn-group btn-bar-rad">
            <button class="btn btn-outline-primary db1 active" onclick="fnLogDataBase(this,'MQTT')" data-name="MQTT" type="button">MQTT Db</button>
            <button class="btn btn-outline-primary db1" onclick="fnLogDataBase(this,'HTTP')" data-name="HTTP" type="button">PLC LOG</button>
            <button class="btn btn-outline-primary db1" onclick="fnLogDataBase(this,'Local')" id="btnLocalDB" data-name="Local" type="button">Local Db</button>
        </div>

    </div>
</div>
<span class="text-danger" id="dateValidate"></span>
<hr />

<div class="row">
    <div class="col-sm-12">
        <a id="btnCSVReport" class="btn btn-quirk" style="background:#449d44;color:white;" onclick="GenerateReport('CSV')">Generate CSV Report</a>
        <a id="btnReport" class="btn btn-dark btn-quirk" style="margin-left:10px" onclick="GenerateReport('Report')">View Report</a>
    </div>
</div>
<script src="~/Content/PageJS/Reporting/ReportingList.js"></script>
<script>
    $(document).ready(function () {
        var issetuplocalsite = $("#siteLog").find(':selected').attr('data-issetuplocalsite');
        if (issetuplocalsite != null && issetuplocalsite != undefined && issetuplocalsite != '' && issetuplocalsite == 'True') {
            $('#btnLocalDB').show();
        } else {
            $('#btnLocalDB').hide();
        }
    });
</script>