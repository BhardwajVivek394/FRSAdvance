@model List<Domain.SMSLog>


<div class="row">
    <div class="col-sm-12">
        <div class="table-responsive" style="max-height: 620px;">
            <table class="table" id="tblsmslogs">
                <thead class="table-dark">
                    <tr>
                        <th style="width:100px;">
                            Action
                        </th>
                        <th>
                            Message
                        </th>
                        <th class="text-center">DateTime</th>

                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr id="tr@(@item.Id)">

                                <td class="text-center width60"><a href="#" data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Delete"><i class="fa fa-trash text-danger" onclick="DeleteSMSLofById('@item.Id')"></i></a></td>

                                <td>@item.Message</td>
                                <td class="text-center">
                                    @item.TimeStamp.ToString("dd/MM/yyyy HH:mm")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center">
                                No record found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


