@model List<Domain.AssetType>


<label style='font-size:16px;margin-top:7px'> Asset(s)</label>
<div class="panel panel-profile list-view bgSkyBlue">
    <div class="row">
        <div class="cols-sm-12">
            @if (Model != null && Model.Count > 0)
            {
                <div class="">
                    @foreach (var item in Model)
                    {


                        <div class='btn-group mr5' style='margin:5px' onclick="SearchSite('@item.Id')">
                            <input type="hidden" value="@item.Name" id="lblAssetName@(item.Id)" />
                            <button type='button' class='btn btn-primary'>@item.Name</button>

                        </div>
                    }
                </div>
            }
            else
            {
                <p style="font-size:15px">No record found!</p>
            }
        </div>
        <div class="col-sm-12 mt20">
            <div id="divAssetDetails">

            </div>
        </div>
    </div>
</div>