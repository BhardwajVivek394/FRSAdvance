                    var html = "";
                    html += "<tr>";
                    html += "<th class='width100'>Date</th>";
                    html += "<th class='width100'>Asset Type</th>";
                    html += "<th class='width100'>Asset Name</th>";
                    headers = data;
                    if (data.assetAttributes != null && data.assetAttributes.length > 0) {
                        $.each(data.assetAttributes, function (ids, val) {
                            html += "<th>";
                            html += val.Title;
                            html += "</th>";
                        });
                        html += "</tr>";
                        $("#tblHeader").empty().append(html);
                        GetReportData();
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

