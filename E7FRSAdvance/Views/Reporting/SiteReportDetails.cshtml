        function periodTime() {
            $("#loader").show();
            $("#txtWait").html("Please wait.. We are preparing header.")
            $("#modalMessage").modal('show');
            $.ajax({
                url: '/Reporting/GetTime',
                type: 'Post',
                contentType: 'application/json',
                success: function (data) {
                    var html = "";
                    if (data != null) {
                        html += "<label style='font-size:16px;color:white;margin-top:7px'> Site data for period of " + data.StartDate + " to " + data.EndDate + "</label>";
                        $("#periodTime").empty().append(html);
                        GetHeader();
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        var headers;
