@model Domain.SiteLister




<div class="row">
    <div class="col-sm-4">
        <label style='font-size:16px;color:black;'> Sites</label>
        <input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
        <input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />
        <select id="siteLog" class="form-control" onchange="GetAllAsset(this)">
            <option value="0">Select site</option>
            @if (Model.mSites != null && Model.mSites.Count > 0)
            {
                foreach (var item in Model.mSites)
                {
                    <option value="@item.Id" data-isSetupLocalSite="@item.IsSetupLocalSite">@item.Name</option>
                }
            }
        </select>
