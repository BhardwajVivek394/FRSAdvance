    <div class="col-sm-6">
        <label style='font-size:16px;color:black;'>Search Log</label>
        <div class="col">
            <div class="m-t-15 m-checkbox-inline custom-radio-ml">
                <div class="form-check form-check-inline radio radio-primary">
                    <input class="form-check-input" id="radioinline1" checked type="radio" name="radio1" data-bs-original-title="" title="">
