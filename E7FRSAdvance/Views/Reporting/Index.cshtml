@model List<Domain.Site>

@{
    ViewBag.Title = "Analytics";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<style>
    .card-fullscreen {
        display: block;
        z-index: 9999999;
        position: fixed;
        width: 100% !important;
        height: 100% !important;
        top: 0;
        right: 0;
        left: 0;
        bottom: 0;
        overflow: hidden;
        background-color: white;
    }
