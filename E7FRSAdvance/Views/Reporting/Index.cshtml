        if (atName == "If mA" || atName == "Ir mA" || atName == "Charger mA" || atName == "Leakage" || atName == "RG mA" || atName == "DG mA" || atName == "HG mA" || atName == "HHG mA" || atName == "A10 id") {
            unit = 'mA';
        }
        if (atName == "Vr" || atName == "Choke V" || atName == "TPR V" || atName == "RG V" || atName == "DG V" || atName == "HG V" || atName == "HHG V" || atName == 'Rx1 mV' || atName == 'Rx1 mV' || atName == "Tx1 V" || atName == "Tx2 V" || atName == "Supply Voltage" || atName == "Modem V") {
            unit = 'V';
        }
        if (atName == "Last Update Feed End( sec ago)" || atName == "Last Update Relay End( sec ago)" || atName == "Last Access (Sec)" || atName == "Last Access" || atName == "Last Access time") {
            unit = 'sec';
        }


        var dataSeries = [];
        var arrayData = {};
        arrayData.Name = $("#selAttribute").val();
        var list = [];
        $.each(d.mAssetInfos, function (i, j) {

            if (parseInt(j.Value) >= 0) {
                list.push(j.Value)
            }
            else {
                list.push(0)
            }
            // dataSeries.push(j.Value)
            if (parseInt(j.Value) > count) {
                count = parseInt(j.Value);
            }
            if (parseInt(j.Value) < min) {
                min = parseInt(j.Value);
            }
        });
        arrayData.data = list;
        dataSeries.push(arrayData);
        var options3 = {
            chart: {
                height: 300,
                type: 'bar',
                toolbar: {
                    show: false
                }
            },
            plotOptions: {
                bar: {
                    horizontal: false,
                    endingShape: 'rounded',
                },
            },
            dataLabels: {
                enabled: false
            },
            stroke: {
                show: true,
                width: 2,
                colors: ['transparent']
            },
            series: dataSeries,
            xaxis: {
                categories: labess,
            },
            yaxis: {
                min: min,
                max: count + 1,
                floating: false,
                labels: {
                    style: {
                        color: '#404040',
                        fontWeight: 800
                    },
                    formatter: function (value) {
                        return value.toFixed(2);
                    }
                },
            },

            tooltip: {
                y: {
                    formatter: function (val, d) {
                        return val + " " + unit;
                    }
                }
            },
            legend: {
                show: false,
            },
            labels: {
                style: {
                    color: '#404040',
                    fontWeight: 800
                },
                formatter: function (value) {
                    return value.toFixed(2);
                }
            },
            colors: ["#4bacc6", "#404040", "#215968", "#0e95fb"]
        }
        var chart3 = new ApexCharts(
            document.querySelector("#bar-polar"),
            options3
        );

        chart3.render();
        $(".apexcharts-xaxis-label").attr("fill", "#4bacc6");
        $(".apexcharts-xaxis-label").attr("font-weight", "bold");
        $(".apexcharts-xaxis-label").attr("font-size", "14px");
    }

