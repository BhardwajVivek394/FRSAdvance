@*<script src="~/assets/js/paho-mqtt.js"></script>*@

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Reporting</li>
                </ol>
            </div>
        </div>
    </div>
</div>


