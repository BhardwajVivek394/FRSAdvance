        $.ajax({
            url: '/Reporting/GetPointMachineDateRange',
            type: 'Post',
            data: '{assetId:' + $("#selPoint").val() + ',range:"' + $("#selRange").val() + '",type:"' + type + '",assetTypeId:' + $("#selAllGear").val() + ',siteId:' + $("#selGraphSite").val() + ',operation:"' + $("#selOpration").val() + '",sd:"' + $("#sd").val() + '",ed:"' + $("#ed").val() + '"}',
