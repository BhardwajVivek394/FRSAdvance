<script>
    var json = "";
    var client = null;
    var mQQTPath = "";
    var channels = [];
    var liveData = "";

    $(document).ready(function () {
        $('#txtRange').daterangepicker();

        $('#txtRange').on('apply.daterangepicker', function (ev, picker) {
            $(this).val(picker.startDate.format('MM/DD/YYYY') + ' - ' + picker.endDate.format('MM/DD/YYYY'));
            fnCustomerDateRangeValue(picker.startDate.format('MM/DD/YYYY'), picker.endDate.format('MM/DD/YYYY'));
        });

        $('#txtRange').on('cancel.daterangepicker', function (ev, picker) {
            $(this).val('');
