@model List<Domain.AssetType>



<div class="panel panel-profile list-view bgSkyBlue">
    <div class="">
        <div class="cols-sm-12">
            <h6>Gear Type</h6>
        </div>
        <div class="col-sm-12">
            @if (Model != null && Model.Count > 0)
            {
                <div class="">
                    @foreach (var item in Model)
                    {
                        <div class='btn-group mr5' style='margin:5px' onclick="fnGetAlertCountByAsset('@item.Id','@item.Name')">
                            <input type="hidden" value="@item.Name" />
                            <button type='button' class='btn btn-primary'>@item.Name</button>
                            <button type='button' class='btn btn-primary'>
                                <span>@item.TotalCount</span>
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="font-size:15px">No record found!</p>
            }
        </div>
    </div>
</div>