@model List<Domain.AssetType>

<div class="people-list">
    <div class="people-options clearfix">
        <div class="pull-left">
            <label style='font-size:16px;color:white;margin-top:7px'> Asset(s)</label>
        </div>
    </div>
</div>

<div class="">
    <div class="row">
        <div class="cols-sm-12">
            @if (Model != null && Model.Count > 0)
            {
                <div class="pull-right">
                    @foreach (var item in Model)
                    {
                        <div class='btn-group mr5' style='margin:5px' onclick="MaintenanceSearchSite('@item.Id')">
                            <input type="hidden" value="@item.Name" id="lblMainAssetName@(item.Id)" />
                            <button type='button' class='btn btn-primary'>@item.Name</button>
                          
                        </div>
                    }
                </div>
            }
            else
            {
                <p style="font-size:15px">No record found!</p>
            }
        </div>
        <div class="col-sm-12 mt20">
            <div id="divMaintenanceAssetDetails">
            </div>
        </div>
    </div>
</div>