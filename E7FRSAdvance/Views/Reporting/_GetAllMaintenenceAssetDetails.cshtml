@model List<Domain.MaintenanceInput>


@if (Model != null && Model.Count > 0)
{
    <div class="row">
        <div class="col-sm-12 mb-3">
            <div class="text-end">
                <a class="btn btn-primary" onclick="SaveMaintencesInput()">Save Maintenenace</a>
            </div>
        </div>
    </div>
  
}
<div class="row">
    <div class="col-sm-12">
        <div class="table-responsive" style="max-height: 620px;">
            <table class="table">
                <thead class="table-dark">
                    <tr>
                        <th style="width:200px;">Name</th>
                        <th style="width:230px;">Index Score</th>
                        <th>Maintenance Input</th>
                    </tr>
                </thead>
                <tbody id="tblMaintenceInput">
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr data-id="@item.Id" data-attributeid="@item.AttributeId" data-siteId="@item.SiteId">
                                @*<td class="text-center width60">
                                    <label class="ckbox ckbox-primary">
                                        <input style="cursor:pointer;margin:5px" class="assets" type="checkbox" data-id="@item.Id" data-attributeid="@item.AttributeId" data-siteId="@item.SiteId" id="chkSite('@item.Id')" />
                                    </label>
                                </td>*@
                                <td>
                                    <span data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Site">@item.SiteName</span> >
                                    <span data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Asset Type">@item.AssetTypeName</span> >
                                    <span data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Asset">@item.Name</span>
                                    @*<span data-placement="top" data-toggle="tooltip" class="tooltips" data-original-title="Attribute">@item.AttributeName</span>*@
                                </td>
                                <td>
                                    @if (item.IndexScore != null)
                                    {<input type="number" class="form-control" value="@item.IndexScore" data-id="@item.Id" data-attributeid="@item.AttributeId" data-siteId="@item.SiteId" id="txtIndexScore@(item.Id)" />

                                    }
                                    else
                                    {
                                        <input type="number" class="form-control" data-id="@item.Id" data-attributeid="@item.AttributeId" data-siteId="@item.SiteId" id="txtIndexScore@(item.Id)" />
                                    }

                                </td>
                                <td>
                                    <textarea class="form-control" data-id="@item.Id" rows="1" cols="1" data-attributeid="@item.AttributeId" data-siteId="@item.SiteId" id="txtInput@(item.Id)">@item.MaintenenceInput</textarea>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center">
                                No record found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
    
