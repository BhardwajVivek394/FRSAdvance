@model List<Domain.Roster>

@{ 
    int i = 0;
}
<div class="table-responsive" style="max-height: 620px;">
    <table class="table table-sm">
        <thead class="table-dark">
            <tr>
                <th style="width:100px">SNo#</th>
                <th>Generate Date </th>
                <th style="width:65px">Status</th>
                <th colspan="3" style="width:70px" class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model.OrderByDescending(x => x.CreatedDate).ToList())
                {
                    if (item.IsRoster)
                    {
                        <tr>

                            <td>@item.Id</td>
                            <td class="text-left width60 @(i==0?"Fisrttd":"")">
                                <span style="cursor:pointer"> @item.CreatedDate.ToString("dd/MM/yyyy")</span>
                            </td>
                            <td>
                                @if (item.Status.Contains("Open"))
                                {
                                    <span>Open</span>
                                }
                                else
                                {
                                    <span>Closed</span>
                                }
                            </td>
                            <td class="text-center" style="width:14px;padding:5px;vertical-align:middle">
                                <a title="Edit" class="text-white btn btn-primary" onclick="fnGetHistory(@item.Id)"><i class="fa fa-pencil"></i></a>
                            </td>
                            <td class="text-center" style="width:14px;padding:5px;vertical-align:middle">
                                <a title="Delete" class="text-white btn btn-danger" onclick="fnDeleteRoster(@item.Id)"><i class="fa fa-trash"></i></a>
                            </td>
                            <td class="text-center" style="width:14px;padding:5px;vertical-align:middle">
                                <a title="Download Pdf" class="btn btn-info text-white" href="@Url.Action("GeneratePdf","Reporting",new {siteId=item.SiteId,rosterId=item.Id })"><i class="fa fa-download"></i></a>
                            </td>

                        </tr>
                        i = i + 1;
                    }

                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center">
                        No record found
                    </td>
                </tr>
            }
            @if (i== 0)
            {
                <tr>
                    <td colspan="4" class="text-center">
                        No record found
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@*onclick="fnDownlaodPdf(@item.Id)"*@
@if (i== 0)
{
    <script>
        $(document).ready(function () {
            $(".Fisrttd").click();
        });
    </script>
}


