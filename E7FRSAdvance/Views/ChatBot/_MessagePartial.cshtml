@model  System.IO.Stream

<div class="msg left-msg">
    <div class="msg-img1">
    </div>
    <div class="msg-bubble1">
        <div class="msg-info">                         
            
            <div class="msg-info-name">test</div>
            <i class="fa fa-pencil" onclick="fnGetRemark('')"></i>
        </div>
        <div class="msg-chat-text" style="margin-left:9px;">

            @using (var reader = new System.IO.StreamReader(Model))
            {
                string line;
                while ((line = reader.ReadLine()) != null)
                {
                    // Process each line (each word in this case)
                    //Console.WriteLine(line);
                    <span>@line</span>
                }
            }
        </div>
    </div>
</div>