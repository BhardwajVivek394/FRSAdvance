
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    #divChatBotePartial {
        height: 600px;
        overflow-y: auto;
    }

    #ChatBox {
        background-repeat: no-repeat;
    }

    .msg-img1 {
        width: 50px;
        height: 50px;
        margin-right: 10px;
        background: #ddd;
        background-repeat: no-repeat;
        background-position: center;
        background-size: cover;
        border-radius: 50%;
    }

    .right-msg .msg-img1 {
        margin: 0 0 0 10px;
        background-image: url(/assets/images/small-logo.png) !important;
        width: 40px;
        height: 40px;
        margin-bottom: 20px;
    }

    .left-msg .msg-img1 {
        background-image: url(/assets/images/small-logo.png) !important;
        width: 40px;
        height: 40px;
        margin-bottom: 20px;
    }


    .msg-bubble1 {
        float: left;
        width: 500px;
        height: auto;
        background-color: #cccc;
        border: 1px solid #000000;
        padding: 20px 15px;
        border-radius: 40px;
        border-color: #cccc
    }

    .msg-bubble2 {
        float: left;
        width: 500px;
        height: auto;
        background-color: #00a4e0;
        border: 1px solid #000000;
        padding: 20px 15px;
        border-radius: 40px;
        border-color: #00a4e0
    }

    .msg-info-name {
        margin-right: 10px;
        font-weight: bolder;
        margin-left: 10px;
        font-size: large;
    }


    .msg-info-name-right {
        margin-right: 10px;
        font-weight: bolder;
        margin-left: 10px;
        font-size: large;
        color: white;
    }

    .msger-input1 {
        flex: 1;
        box-shadow: 2px 2px 15px 2px #ccc;
    }

    .msger-inputarea1 {
        display: flex;
        padding: 10px;
        border-top: 0px solid var(--chart-dashed-border);
        align-items: center;
    }

        .msger-inputarea1 .dropdown-toggle::after {
            content: unset;
        }

        .msger-inputarea1 .dropdown-toggle .dropdown-menu {
            inset: unset !important;
        }

        .msger-inputarea1 .dropdown-form {
            position: relative;
        }

            .msger-inputarea1 .dropdown-form i {
                font-size: 16px;
                font-weight: 900;
                color: var(--theme-deafult);
                cursor: pointer;
                padding: 0;
            }

            .msger-inputarea1 .dropdown-form .chat-icon {
                position: absolute;
                left: 0 !important;
                bottom: 22px !important;
                background: transparent;
                box-shadow: unset;
            }

    [dir=rtl] .msger-inputarea1 .dropdown-form .chat-icon {
        left: unset;
        right: 0;
    }

    .msger-inputarea1 .dropdown-form .chat-icon div {
        width: 47px;
        height: 47px;
        border-radius: 50%;
        background-color: var(--white);
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0;
        opacity: 1;
    }

        .msger-inputarea1 .dropdown-form .chat-icon div svg {
            width: 42px;
            height: 42px;
            cursor: pointer;
        }

        .msger-inputarea1 .dropdown-form .chat-icon div:nth-child(1) svg {
            fill: var(--chart-text-color);
            stroke: none;
        }

        .msger-inputarea1 .dropdown-form .chat-icon div:nth-child(2) svg {
            stroke: var(--chart-text-color);
            fill: none;
        }

        .msger-inputarea1 .dropdown-form .chat-icon div:hover {
            background-color: var(--theme-deafult);
            opacity: 1;
        }

            .msger-inputarea1 .dropdown-form .chat-icon div:hover:nth-child(1) svg {
                fill: var(--white);
            }

            .msger-inputarea1 .dropdown-form .chat-icon div:hover:nth-child(2) svg {
                stroke: var(--white);
            }

    .msger-inputarea1 .msger-send-btn i {
        color: var(--white);
    }

    .msger-inputarea1 * {
        padding: 10px;
        border: none;
        border-radius: 3px;
        font-size: 1em;
    }

    :root {
        --code-color: darkred;
        --code-bg-color: #f6f6f6;
        --code-font-size: 14px;
        --code-line-height: 1.4;
        --scroll-bar-color: #c5c5c5;
        --scroll-bar-bg-color: #f6f6f6;
    }

    ::-webkit-scrollbar-corner {
        background: rgba(0,0,0,0.5);
    }

    * {
        scrollbar-width: thin;
        scrollbar-color: var(--scroll-bar-color) var(--scroll-bar-bg-color);
    }

        /* Works on Chrome, Edge, and Safari */
        *::-webkit-scrollbar {
            width: 12px;
            height: 12px;
        }

        *::-webkit-scrollbar-track {
            background: var(--scroll-bar-bg-color);
        }

        *::-webkit-scrollbar-thumb {
            background-color: var(--scroll-bar-color);
            border-radius: 20px;
            border: 3px solid var(--scroll-bar-bg-color);
        }
</style>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Chat Bot</li>
                </ol>
            </div>
        </div>
    </div>
</div>


<div class="card" id="ChatBox">
    <div class="card-body">
        <div id="divChatBotePartial">
            @Html.Action("List", "ChatBot")
        </div>
        <div class="right-sidebar-Chats mt-5">
            <div class="msger">
                <div class="msger-inputarea1">
                    <input class="msger-input1 two uk-textarea" type="text" placeholder="Type Message here.." id="txtMessage">
                    <div>
                        <select name="drpfileType" id="drpfileType" class="form-control">
                            <option value="PDF">Pdf</option>
                            <option value="CSV">Csv</option>
                        </select>
                    </div>
                    <button class="msger-send-btn" type="button" onclick="fnGetMessage()"><i class="fa fa-location-arrow"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

@using (Ajax.BeginForm("SaveRemark", "ChatBot", new AjaxOptions()
{
    HttpMethod = "POST",
    UpdateTargetId = "divSaveRemark",
    InsertionMode = InsertionMode.Replace,
    LoadingElementId = "loader",
}, new { id = "frmSaveRemark" }))
{
    <div id="divSaveRemark">
        <div class="modal fade" id="modal-add-Remark" role="dialog" aria-labelledby="modal-add-Remark" aria-hidden="true" data-bs-backdrop="static">
            <div class="modal-dialog modal-dialog-centered" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Remark</span></h4>
                        <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
                    </div>
                    <div class="modal-body">
                        <div class="form-horizontal">
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="mb-3">
                                        <input type="hidden" id="RemarkQuestion" name="Question" />
                                        <label class="form-label">Remark <span class="text-danger">*</span></label>
                                        <div>
                                            @*<input class="form-control" type="text" id="Remark" name="Remark">*@
                                            <textarea class="form-control" id="Remark" name="Remark" rows="4" cols="56"></textarea>
                                            <span class="text-danger"></span>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <a class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</a>
                        <button type="button" class="btn btn-primary ls-1-2" onclick="fnSaveRemark()">Save</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
}

<script>
    var counter = 0;
    var wordCounter = 0;
    $(document).ready(function () {
        $("#txtMessage").keyup(function (event) {
            if (event.keyCode === 13) {
                fnGetMessage();
            }
        });
    });

    function fnBindMessage() {
        var msg = $("#txtMessage").val();
        var fileType = $("#drpfileType").val();
        $("#txtMessage").val('');
        $.ajax({
            url: '/ChatBot/BindMainMessage',
            type: 'Post',
            data: '{message:"' + msg + '"}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#divChatBotePartial").empty().append(data);
                $.ajax({
                    url: '/ChatBot/GetMessageList',
                    type: 'Post',
                    data: '{message:"' + msg + '",fileType:"' + fileType + '"}',
                    contentType: 'application/json',
                    success: function (listdata) {
                        counter++;
                        $("#loader").hide();
                        var html = '';
                        html += '<div class="msg left-msg">';
                        html += '<div class="msg-img1">';
                        html += ' </div>';
                        html += '<div class="msg-bubble1">';
                        html += '<div class="msg-info"><div class="msg-info-name">ChatBot</div></div>';
                        html += '<div class="msg-chat-text-' + counter + '" style="margin-left:9px;"></div>';
                        html += '</div>';
                        $("#divChatBotePartial").append(html);
                        if (listdata != null && listdata != undefined && listdata != '') {
                            wordCounter = 0;

                            fnDisplayMessage(listdata, $('.msg-chat-text-' + counter), 1, listdata.length)
                        }
                    },
                    error: function (response) {
                        $("#loader").hide();
                        CommonNotification("danger", "Something went wrong!");
                    }
                });

            },
            error: function (response) {
                CommonNotification("danger", "Something went wrong!");
            }
        });
    }

    function fnDisplayMessage(text, elem, delay, length) {
        if (!elem) {
            elem = $("body");
        }
        if (!delay) {
            delay = 300;
        }
        wordCounter++;
        if (wordCounter >= length) {

            $.ajax({
                url: '/ChatBot/BindMainMessage',
                type: 'Post',
                dataType: 'html',
                contentType: 'application/json',
                success: function (data) {
                    $("#divChatBotePartial").empty().append(data);

                },
                error: function (response) {
                    CommonNotification("danger", "Something went wrong!");
                }
            });

        }
        else {
            if (text.length > 0) {
                //append first character 
                elem.append(text[0]);
                setTimeout(
                    function () {
                        $('#divChatBotePartial').scrollTop($('#divChatBotePartial')[0].scrollHeight);
                        fnDisplayMessage(text.slice(1), elem, delay, length);
                    }, delay
                );

            }
        }
       
    }

    function fnGetMessage() {
        fnBindMessage();
        $("#loader").show();
    }

    function fnLoadMessage() {
        $.ajax({
            url: '/ChatBot/BindMainMessage',
            type: 'Post',
            data: '{message:""}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#divChatBotePartial").empty().append(data);
               

            },
            error: function (response) {
                CommonNotification("danger", "Something went wrong!");
            }
        });
    }

    function fnGetRemark(question) {
        $('#RemarkQuestion').val(question);
        $('#Remark').val('');
        $("#modal-add-Remark").modal('show');

    }

    function fnSaveRemark() {
        if (Validate()) {
            var mChatBotRemark = {}
            mChatBotRemark.Question = $('#RemarkQuestion').val();
            mChatBotRemark.Remark = $('#Remark').val();

            $.ajax({
                url: '/ChatBot/SaveRemark',
                type: 'Post',
                data: '{mChatBotRemark:' + JSON.stringify(mChatBotRemark) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data.type == "success") {
                        $("#modal-add-Remark").modal('hide');
                        CommonNotification("SUCCESS", data.result, "success");
                    } else {
                        CommonNotification("ERROR", data.result, "error");
                    }
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", response.result, "error");
                }
            });

            /* $("#frmSaveRemark").submit();*/
        }
    }

    function Validate() {
        var result = true;

        if ($.trim($("#Remark").val()).length == 0) {
            $("#Remark").next("span").html("Remark is required!");
            result = false;
        }
        else {
            $("#Remark").next("span").html("");
        }
        return result;
    }

    function AddTextByDelay(text, elem, delay) {
        if (!elem) {
            elem = $("body");
        }
        if (!delay) {
            delay = 300;
        }
        if (text.length > 0) {
            //append first character 
            elem.append(text[0]);
            setTimeout(
                function () {
                    //Slice text by 1 character and call function again                
                    addTextByDelay(text.slice(1), elem, delay);
                }, delay
            );
        }
    }
</script>