
@{
    ViewBag.Title = "Upload";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Issuing body</li>
                </ol>
            </div>
        </div>
    </div>
</div>


<div class="container-fluid">
    <div class="card">
        <div class="card-header">
            <div class="row p-4">
                @*<div class="col-sm-2">
                        <div class="form-group mb-2">
                            <label class="control-label center-block">PDF:</label>
                            <select class="form-control drpPDF">
                            </select>
                        </div>
                    </div>*@
                <div class="col-sm-2">
                    <div class="form-group mb-2">
                        <label class="control-label center-block">Search Criteria:</label>
                        <select class="form-control drpSearchCriteria">
                            <option value="">Select</option>
                            <option value="1">Zone</option>
                            <option value="2">Division</option>
                            <option value="3">RDSO</option>
                            <option value="4">Railway bord</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-2 clsSearchCriteria" style="display:none">
                    <div class="form-group mb-2 clsZone" style="display:none">
                        <label class="control-label center-block">Zone:</label>
                        @Html.DropDownList("ZoneId", (IEnumerable<SelectListItem>)ViewBag.Zones, new { @class = "form-control", tabindex = 1 })
                    </div>

                    <div class="form-group mb-2 clsDivision" style="display:none">
                        <label class="control-label center-block">Division:</label>
                        @Html.DropDownList("DivisionId", (IEnumerable<SelectListItem>)ViewBag.Divisions, new { @class = "form-control", tabindex = 1 })
                    </div>
                </div>
                <div class="col-sm-3 clsUplaodFile" style="display:none;">
                    <label class="control-label center-block">Select Uoload File:</label>
                    <input type="file" class="form-control" onchange="fnUploadPDF(this)" multiple="multiple" />
                </div>
                <div class="col-sm-2 mt-4 clsGoogleSheet" style="display:none;">
                    <button type="button" class="btn btn-info" onclick="fnShowUploadUrl()">Add Url/Google Sheet</button>
                </div>
                <div class="col-sm-2 pt-4">
                    <a class="btn btn-success btn-quirk" onclick="fnSearchReport()" data-bs-original-title="" title="Search"><i class="fa fa-search"></i></a>
                </div>

            </div>
        </div>
        <div class="card-body">
            <div id="divUploadPDFList"></div>
        </div>
    </div>

</div>

<div class="modal bounceIn animated" id="model-UploadUrl-Sheet" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modalConfirm-dialog">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader">Add Url/Google Sheet</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <div class="row">

                    <div class="col-md-12">
                        <textarea class="form-control" id="txtChatBotUrl"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnUploadUrl()">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        //$('#SearchCriteria_Month').select2({
        //    dropdownParent: $('#myModal')
        //});


        $('.drpSearchCriteria').change(function () {
            $('.clsSearchCriteria').show();
            $('.clsUplaodFile').hide();
            $('.clsGoogleSheet').hide();
            if ($(this).val() == "1") {
                $('.clsZone').show();
                $('.clsDivision').hide();
                $('.clsSite').hide();
                $('#DivisionId').val("0");
            }
            else if ($(this).val() == "2") {
                $('.clsDivision').show();
                $('.clsZone').hide();
                $('.clsSite').hide();
                $('#ZoneId').val("0");
            }
            else if ($(this).val() == "3" || $(this).val() == "4") {
                $('.clsSearchCriteria').hide();
                $('.clsUplaodFile').show();
                $('.clsGoogleSheet').show();
                $('.clsDivision').hide();
                $('.clsZone').hide();
                $('#ZoneId').val("0");
                $('#DivisionId').val("0");
            }
            else {
                $('.clsSearchCriteria').hide();
                $('#ZoneId').val("0");
                $('#DivisionId').val("0");
            }
        });

        $('.clsZone').change(function () {
            $('.clsUplaodFile').hide();
            $('.clsGoogleSheet').hide();
            if ($('#ZoneId').val() == "0") {
                $('.clsUplaodFile').hide();
                $('.clsGoogleSheet').hide();
            }
            else {
                $('.clsUplaodFile').show();
                $('.clsGoogleSheet').show();
            }
        });

        $('.clsDivision').change(function () {
            $('.clsUplaodFile').hide();
            $('.clsGoogleSheet').hide();
            if ($('#DivisionId').val() == "0") {
                $('.clsUplaodFile').hide();
                $('.clsGoogleSheet').hide();
            }
            else {
                $('.clsUplaodFile').show();
                $('.clsGoogleSheet').show();
            }
        });

    });

    function fnSearchReport() {
        var mChatBot = {};
        if ($('.drpSearchCriteria').val() == "1") {
            mChatBot.ZoneId = $('#ZoneId').val();
            mChatBot.SearchId = $('.drpSearchCriteria').val();
        }
        else if ($('.drpSearchCriteria').val() == "2") {
            mChatBot.DivisionId = $('#DivisionId').val();
            mChatBot.SearchId = $('.drpSearchCriteria').val();
        }
        else {
            mChatBot.SearchId = $('.drpSearchCriteria').val();
        }

        $("#loader").show();
        $.ajax({
            url: "/ChatBot/_PDFList",
            type: "POST",
            data: '{mChatBot:' + JSON.stringify(mChatBot) + '}',
            contentType: 'application/json',
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                if (data != null && data != undefined && data != '') {
                    $("#divUploadPDFList").empty().append(data);
                } else {
                    $("#divUploadPDFList").empty()
                }
            },
            error: function (xhr, error, status) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "Error");
            }
        });

    }

    function fnUploadPDF($this) {

        var isValid = true;
        if ($('.drpSearchCriteria').val() == null || $('.drpSearchCriteria').val() == undefined || $('.drpSearchCriteria').val() == '') {
            CommonNotification("ERROR", "Select Search Criteria.", "Error");
            isValid = false;
        }
        else {
            if ($('.drpSearchCriteria').val() == "1") {
                if ($('#ZoneId').val() == null || $('#ZoneId').val() == undefined || $('#ZoneId').val() == '' || $('#ZoneId').val() == '0') {
                    CommonNotification("ERROR", "Zone is required.", "Error");
                    isValid = false;
                }
            }
            else if ($('.drpSearchCriteria').val() == "2") {
                if ($('#DivisionId').val() == null || $('#DivisionId').val() == undefined || $('#DivisionId').val() == '' || $('#DivisionId').val() == '0') {
                    CommonNotification("ERROR", "Division is required.", "Error");
                    isValid = false;
                }
            }
        }

        if (isValid) {
            var fileUpload = $($this).get(0);
            var files = fileUpload.files;
            var fileLength = files.length;
            var html = '<table class="table">';
            html += "<tr>";
            html += "<th>PDF Name</th>";
            html += "<th>Status</th>";
            html += "</tr>";
            var count = 0;
            for (var i = 0; i < files.length; i++) {
                var fileData = new FormData();
                fileData.append("SearchId", $('.drpSearchCriteria').val());
                fileData.append("ZoneId", $('#ZoneId').val());
                fileData.append("DivisionId", $('#DivisionId').val());
                fileData.append(files[i].name, files[i]);
                
                $("#loader").show();
                $.ajax({
                    url: "/ChatBot/UploadPDF",
                    type: "POST",
                    contentType: false,
                    processData: false,
                    data: fileData,
                    async: true,
                    success: function (data) {
                        if (data != null) {
                            html += "<tr>";
                            html += "<td>" + files[count].name +"</td>";
                            html += "<td>" + data.result +"</td>";
                            html += "</tr>";
                            count++;
                            if (fileLength == count) {
                                $("#loader").hide();
                                html += "</table>";
                                $("#divUploadPDFList").empty().append(html);

                            }

                        } 

                    },
                    error: function (xhr, error, status) {
                        
                        count++;
                    }
                });
            }

        }


    }

    function fnUploadUrl() {

        var isValid = true;

        if ($('.drpSearchCriteria').val() == null || $('.drpSearchCriteria').val() == undefined || $('.drpSearchCriteria').val() == '') {
            alert("Select Search Criteria.");
            isValid = false;
        }
        else {
            if ($('.drpSearchCriteria').val() == "1") {
                if ($('#ZoneId').val() == null || $('#ZoneId').val() == undefined || $('#ZoneId').val() == '' || $('#ZoneId').val() == '0') {
                    alert("Zone is required.");
                    isValid = false;
                }
            }
            else if ($('.drpSearchCriteria').val() == "2") {
                if ($('#DivisionId').val() == null || $('#DivisionId').val() == undefined || $('#DivisionId').val() == '' || $('#DivisionId').val() == '0') {
                    alert("Division is required.");
                    isValid = false;
                }
            }

            if ($('#txtChatBotUrl').val() == null || $('#txtChatBotUrl').val() == undefined || $('#txtChatBotUrl').val() == '') {
                alert("Url is required.");
                isValid = false;
            }
        }

        var mChatBotUrl = {};
        mChatBotUrl.SearchId = $('.drpSearchCriteria').val();
        mChatBotUrl.ZoneId = $('#ZoneId').val();
        mChatBotUrl.DivisionId = $('#DivisionId').val();
        mChatBotUrl.Url = $('#txtChatBotUrl').val();
        mChatBotUrl.IsApprove = false;
        if (isValid) {
            $.ajax({
                url: "/ChatBot/UploadUrl",
                type: "POST",
                data: mChatBotUrl,
                success: function (data) {
                    $("#loader").hide();
                    $("#model-UploadUrl-Sheet").modal("hide");
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                        } else {
                            CommonNotification("ERROR", data.result, "Error");
                        }
                    } else {
                        CommonNotification("ERROR", "Internal server error.", "Error");
                    }
                },
                error: function (xhr, error, status) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "Error");
                }
            });

        }


    }

    function fnShowUploadUrl() {
        $("#model-UploadUrl-Sheet").modal("show");
    }
</script>

