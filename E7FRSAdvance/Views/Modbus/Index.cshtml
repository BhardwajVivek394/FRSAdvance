                            }
                            else if (data.type == "error") {
                                alert(data.result);
                            }
                            else if (data.type == "error") {
                                alert(data.result);
                            }

                        }
                    },
                    error: function (response) {
                        $("#loader").hide();
                        alert("Something went wrong!");
                    }
                });
            }


        }


    }

