@model Domain.LearningLister
@{
    ViewBag.Title = "Learning";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Learning</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">
        @using (Ajax.BeginForm("LearningList", "Learning", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divLearningList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader"
        }, new { id = "frmGetLearningList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divLearningList">
                @Html.Action("LearningList")
            </div>
        }

        @using (Ajax.BeginForm("SaveLearning", "Learning", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveLearning",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "LearningSaved"
        }, new { id = "frmSaveLearning" }))
        {
            <div id="divSaveLearning">
                @Html.Partial("_AddLearningPartial", new Domain.Learning())
            </div>
        }

    </div>
</div>
