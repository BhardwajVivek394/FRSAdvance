    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmAssetDetails").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize)
            {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmAssetDetails").submit();
            }
        }
    }
    function fnGridView() {
        $("#listView").hide();
        $("#gridView").show();
    }
    function fnListView() {
        $("#listView").show();
        $("#gridView").hide();
    }
    function fnSearch() {
        $("#frmAssetDetails").submit();
    }

    function fnShowAspectData(assetId) {
        $("#loader").show();
        $.ajax({
            url: '/Site/GetSignalAspectData',
            type: 'Post',
            data: '{assetId:' + assetId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#model-div-alert").empty().append(data);
                $("#modalalertlogs").modal('show');
            },
            error: function (response) {
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function stringToBool(val) {
        return (val + '').toLowerCase() === 'true';
    }
