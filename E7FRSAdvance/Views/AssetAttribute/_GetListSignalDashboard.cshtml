                                                                    <span class="spnsignalUGAV@(item.Id)"></span>
                                                                </div>
                                                                <div>
                                                                    <span class="spnsignalUGBC@(item.Id)"></span>
                                                                    <span class="spnsignalUGBV@(item.Id)"></span>
                                                                </div>
                                                                <div>
                                                                    <span class="spnsignalUGCC@(item.Id)"></span>
                                                                    <span class="spnsignalUGCV@(item.Id)"></span>
                                                                </div>
                                                                <div>
                                                                    <span class="spnsignalUGDC@(item.Id)"></span>
                                                                    <span class="spnsignalUGDV@(item.Id)"></span>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td class="signalC@(item.Id)"> </td>
                                                            <td class="signalV@(item.Id)"> </td>
                                                        </tr>
                                                        <tr>
                                                            <td class="signalHHGC@(item.Id)"> </td>
                                                            <td class="signalHHGV@(item.Id)"> </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>


                                        </div>
                                    </div>
                                </div>
                            }
                            foreach (var item in Model.mAssets.Where(x => x.Name.ToLower().Contains("sh")).ToList())
                            {
                                int cnt = item.AssetTypeName.Length + item.Name.Length;
                                <div class="col-xl-12 xl-50 news box-col-12" id="divSignal@(item.Id)" style="display:none">
                                    <div class="card card-border">
                                        @*<div class="card-header bg-primary">
                            <h6 class="panel-title">
                                @item.AssetTypeName : @item.Name
                            </h6>
                        </div>*@
                                        <div class="bg-primary" style="padding:0;border-top-left-radius:15px;border-top-right-radius:15px;">
                                            <div class="" style="width:80%;float:left;padding:1px;border-top-left-radius:15px;">
                                                <h6 style="margin-left:12px;">
                                                    <a target="_blank" class="text-white" href="@item.HttpMisLink"> @item.AssetTypeName : @item.Name</a>
                                                    <br />
                                                    <span>Index Score: @item.IndexScore</span>
                                                    <a style="float: right; cursor: pointer; margin-top: -14px" onclick="fnShowAspectData(@item.Id)">Aspects</a>
                                                </h6>
                                            </div>
                                            <div class="text-center bg-dark" style="width:20%;float:left;padding:2px 0px;border-top-right-radius:15px;line-height:1.3;height:50px">
                                                @if (item.UnderMaintence == true)
                                                {
                                                    <div class="text-center"> <i class="fa fa-bell-slash" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i></div>
                                                }
                                                else
                                                {
                                                    <div class="text-center">
                                                        <i class="fa fa-bell" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i>
                                                    </div>
                                                }
                                                <a onclick="fnGetAssetGraph('@item.SiteId','@item.Id')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer"> Graph </a>
                                                <a onclick="fnGetSmsLog('@item.Id')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer">Event log</a>
                                            </div>

                                        </div>
                                        <div class="card-body" style="padding:5px;">
                                            <div class="row col-sm-12">
                                                <div class="table-responsive width100p tblAssetData">
                                                    <table class="table table-bordered table-striped">
                                                        <tbody id="tblAttributeData@(item.Id)" class="tblAttributes">
                                                            <tr>
                                                                <td id="signal@(item.Id)" class='text-center'>
                                                                </td>
                                                                <td>
                                                                    <div>
                                                                        <span class="spnsignalUGAC@(item.Id)"></span>
                                                                        <span class="spnsignalUGAV@(item.Id)"></span>
                                                                    </div>
                                                                    <div>
                                                                        <span class="spnsignalUGBC@(item.Id)"></span>
                                                                        <span class="spnsignalUGBV@(item.Id)"></span>
                                                                    </div>
                                                                    <div>
                                                                        <span class="spnsignalUGCC@(item.Id)"></span>
                                                                        <span class="spnsignalUGCV@(item.Id)"></span>
                                                                    </div>
                                                                    <div>
                                                                        <span class="spnsignalUGDC@(item.Id)"></span>
                                                                        <span class="spnsignalUGDV@(item.Id)"></span>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="signalC@(item.Id)"> </td>
                                                                <td class="signalV@(item.Id)"> </td>
                                                            </tr>
                                                            <tr>
                                                                <td class="signalHHGC@(item.Id)"> </td>
                                                                <td class="signalHHGV@(item.Id)"> </td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>



                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p style="font-size:15px">No record found!</p>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<script>
      var isCalibration = stringToBool('@E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsCalibration');
    var json = "";
    var client = null;
    var mQQTPath = "";
    var channels = [];
    var rgC = 0;
    var rgv = 0;
    var dgC = 0;
    var dgv = 0;
    var hgC = 0;
    var hgv = 0;
    var hhgC = 0;
    var hhgv = 0;

    var onAC = 0;
    var offAC = 0;
    var onAV = 0;
    var offAV = 0;


    var ugAC = 0;
    var ugAv = 0;
    var ugBC = 0;
    var ugBv = 0;
    var ugCC = 0;
    var ugCv = 0;
    var ugDC = 0;
    var ugDv = 0;

    (function ($) {
        $.fn.focusTextToEnd = function () {
            this.focus();
            var $thisVal = this.val();
            this.val('').val($thisVal);
            return this;
        }
    }(jQuery));
    $(document).ready(function () {
        $(".asset-search").keyup(function (e) {
            $("#frmAssetDetails").submit();
        });
        $('[data-toggle="popover"]').popover();

        $("#lblAssetType").html($("#AssetName" + $("#hdnassetTypeId").val()).val());
        $(".asset-search").focusTextToEnd();


        $('#drpPageSize').change(function (e) {
            $("#hdnSkip").val('0');
            //$("#hdndateValue").val();
            //$("#hdnassetTypeId").val();
            $("#frmAssetDetails").submit();
        });

       // $('.dropDownList').select2({ minimumResultsForSearch: Infinity });
        json = @Html.Raw(Json.Encode(Model));

        if (json.SearchCriteria.MQTTPaths != null && json.SearchCriteria.MQTTPaths.length > 0)
            mQQTPath = json.SearchCriteria.MQTTPaths[0];

        if (json.SearchCriteria.ChannelList != null && json.SearchCriteria.ChannelList.length > 0) {
            channels = json.SearchCriteria.ChannelList;
        }
        for (var i = 0; i < channels.length; i++) {
                    $("#c" + i).html('');
        }
          mQTT=@Html.Raw(Json.Encode(Model.MQTTDetail));

        let isSecure = window.location.protocol === "https:";
        client = new Paho.Client(mQTT.MQTTUri, mQTT.MQTTPort, "clientId" + Math.ceil(Math.random() * 10000));
        // set callback handlers

        client.onConnectionLost = onConnectionLost;
        client.onMessageArrived = onMessageArrivedSignal;

        // connect the client
        client.connect({
            onSuccess: onConnect,
            useSSL: isSecure,
            userName: mQTT.MQTTUsername,
            password: mQTT.MQTTPassword,
            cleanSession: true
        });


    });
    function onConnect() {
        // Once a connection has been made, make a subscription and send a message.
        for (var i = 0; i < channels.length; i++) {
            if (channels[i] != null && channels[i] != "") {
                client.subscribe(mQQTPath + channels[i]);
            }
        }
    }

    // called when the client loses its connection
    function onConnectionLost(responseObject) {
        if (responseObject != null && responseObject.errorCode !== 0) {
            console.log("onConnectionLost:" + responseObject.errorMessage);
            //location.reload();
        }
            client.connect({
                onSuccess: onConnect,
                userName: "wattmon",
                password: "wattmon_2018",
                cleanSession: true
            });
    }

    // called when a message arrives
    function onMessageArrivedSignal(message) {
        if (message.payloadString.includes("roles") && message.payloadString.includes("ts")) {
            var parseJson = JSON.parse(message.payloadString);
            if (parseJson != null && parseJson != undefined && parseJson != '') {
                var array = parseJson['roles'];
                if (array != null && array != undefined && array.length > 0) {
                    BindDataSignal(message.destinationName, array);
                }
            }
        } else {
            var channeldata = message.payloadString.split(',');
            BindDataSignal(message.destinationName, channeldata);
        }
      

        for (var i = 0; i < channels.length; i++) {
            if (channels[i] != null && channels[i] != "null" && channels[i] != "") {

                var name = mQQTPath.toLowerCase() + channels[i].toLowerCase();
                if (message.destinationName.toLowerCase() == name.toLowerCase()) {
                    var d = new Date();
                    var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
                    $("#c" + i).html(time);
                }
            }
        }
    }


    function BindDataSignal(basePath, data) {
        $.each(json.mAssets, function (id, item) {
            rgC = 0;
            rgv = 0;
            dgC = 0;
            dgv = 0;
            hgC = 0;
            hgv = 0;
            hhgC = 0;
            hhgv = 0;

            onAC = 0;
            offAC = 0;
            onAV = 0;
            offAV = 0;

            if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                $.each(item.assetAttributes, function (idx, inItem) {
                    var str1 = basePath.toLowerCase();
                    var str2 = "";
                    if (inItem.AssetInfoChannel != null && inItem.AssetInfoChannel != "") {
                        str2 = inItem.AssetInfoChannel;
                    }
                    if (str1.indexOf(str2) != -1) {
                        var infoValue = inItem.AssetInfoValue;
                        var infoMultiplication = inItem.Multiplication;
                        if (infoValue != null) {

                            var dataValue = data[infoValue];

                            var id = ".hdnAttributeData" + item.Id;
                            if (infoMultiplication != null) {
                                var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                var v = ((mainData * 100) / 100).toFixed(1);                              
                                if (parseFloat(v) <= 0) {
                                    v = '0.0';
                                }

                                if (inItem.Title == "RG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {

                                    rgC = v;
                                    $("#signal" + item.Id + "").html("<img style='height:150px;' src='/Content/images/SR-1.jpg' />");
                                    if (isCalibration != null && isCalibration != undefined && isCalibration) {
                                        $(".signalC" + item.Id + "").html('C :' + v + ' ma <a href="javascript:void(0)"><i class="fa fa-pencil" onclick="fnAddCalibration(\'' + item.Id + '\',\'' + inItem.Id + '\',\'' + inItem.Multiplication + '\',\'' + item.Name + '\',\'' + inItem.Title + '\',\'' + v + '\');"></i></a>');
                                    } else {
                                        $(".signalC" + item.Id + "").html("C :" + v + " ma");
                                    }
                                    $(".signalC1" + item.Id + "").html(v);
                                    $(id).html(inItem.Title);
                                    $("#divSignal" + item.Id).show();
                                    $("#trSignal" + item.Id).show();

                                }
                                else if (inItem.Title == "DG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                    dgC = v;
                                    $("#signal" + item.Id + "").html("<img style='height:150px;' src='/Content/images/SG-1.jpg' />");
                                   /* $(".signalC" + item.Id + "").html("C :" + v + " ma");*/

                                    if (isCalibration != null && isCalibration != undefined && isCalibration) {
                                        $(".signalC" + item.Id + "").html('C :' + v + ' ma <a href="javascript:void(0)"><i class="fa fa-pencil" onclick="fnAddCalibration(\'' + item.Id + '\',\'' + inItem.Id + '\',\'' + inItem.Multiplication + '\',\'' + item.Name + '\',\'' + inItem.Title + '\',\'' + v + '\');"></i></a>');
                                    } else {
                                        $(".signalC" + item.Id + "").html("C :" + v + " ma");
                                    }
                                    $(".signalC1" + item.Id + "").html(v);
                                    $(id).html(inItem.Title);
                                    $("#divSignal" + item.Id).show();
                                    $("#trSignal" + item.Id).show();

                                }
                                else if (inItem.Title == "UG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                    dgC = v;
                                    $(".spnsignalUGC" + item.Id + "").html("UG C/V:" + v + " ma");

                                }
                                else if (inItem.Title == "UGA mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                    ugAC = v;
                                    $(".spnsignalUGAC" + item.Id + "").html("UGA C/V:" + v + " ma");
                                }
                                else if (inItem.Title == "UGB mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                    ugBC = v;
                                    $(".spnsignalUGBC" + item.Id + "").html("UGB C/V:" + v + " ma");

                                }
                                else if (inItem.Title == "UGC mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                    ugCC = v;
                                    $(".spnsignalUGCC" + item.Id + "").html("UGC C/V:" + v + " ma");

                                }
                                else if (inItem.Title == "UGD mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                    ugDC = v;
                                    $(".spnsignalUGDC" + item.Id + "").html("UGD C/V:" + v + " ma");
                                }
                                else if (inItem.Title == "HG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                    hgC = v;
                                    if ($.trim($("#signal" + item.Id + "").html()).indexOf("SYY-1.jpg") == -1) {
                                        $("#signal" + item.Id + "").html("<img style='height:150px;' src='/Content/images/SY-1.jpg' />");
                                    }
                                   
                                    if (isCalibration != null && isCalibration != undefined && isCalibration) {
                                        $(".signalC" + item.Id + "").html('HG C :' + v + ' ma <a href="javascript:void(0)"><i class="fa fa-pencil" onclick="fnAddCalibration(\'' + item.Id + '\',\'' + inItem.Id + '\',\'' + inItem.Multiplication + '\',\'' + item.Name + '\',\'' + inItem.Title + '\',\'' + v + '\');"></i></a>');
                                    } else {
                                        $(".signalC" + item.Id + "").html("HG C :" + v + " ma");
                                    }

                                    $(".signalC1" + item.Id + "").html(v + " " + "<span id='spnhhgC" + item.Id + "' style='font-weight:unset'></span>");
                                    $(id).html(inItem.Title);
                                    $("#divSignal" + item.Id).show();
                                    $("#trSignal" + item.Id).show();

                                }
                                else if (inItem.Title == "HHG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                    if (parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                        hhgC = v;
                                        $("#signal" + item.Id + "").html("<img style='height:150px;' title='SY-1.jpg' src='/Content/images/SYY-1.jpg' />");
                                        if (isCalibration != null && isCalibration != undefined && isCalibration) {
                                            $(".signalHHGC" + item.Id + "").html('HHG C :' + hhgC + ' ma <a href="javascript:void(0)"><i class="fa fa-pencil" onclick="fnAddCalibration(\'' + item.Id + '\',\'' + inItem.Id + '\',\'' + inItem.Multiplication + '\',\'' + item.Name + '\',\'' + inItem.Title + '\',\'' + hhgC + '\');"></i></a>');
                                        } else {
                                            $(".signalHHGC" + item.Id + "").html("HHG C : " + hhgC + " ma");
                                        }

                                        $("#spnhhgC" + item.Id + "").html("HHG mA: " + v);

                                        $(id).html(inItem.Title);
                                        $("#divSignal" + item.Id).show();
                                        $("#trSignal" + item.Id).show();
                                    } else {
                                        $(".signalHHGC" + item.Id + "").html('');
                                    }
                                    
                                }
                                else if (inItem.Title == "On Aspect mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue) && item.Name.toLowerCase().includes('sh')) {
                                    onAC = v;
                                    if ($.trim($("#signal" + item.Id + "").html()).indexOf("SYY-1.jpg") == -1) {
                                        $("#signal" + item.Id + "").html("<a class='linkImg'><img style='height:150px;' src='/Content/images/SY-1.jpg' /></a>");
                                    }
                                    if (isCalibration != null && isCalibration != undefined && isCalibration) {
                                        $(".signalC" + item.Id + "").html('On Aspect C :' + v + ' ma <a href="javascript:void(0)"><i class="fa fa-pencil" onclick="fnAddCalibration(\'' + item.Id + '\',\'' + inItem.Id + '\',\'' + inItem.Multiplication + '\',\'' + item.Name + '\',\'' + inItem.Title + '\',\'' + v + '\');"></i></a>');
                                    } else {
                                        $(".signalC" + item.Id + "").html("On Aspect C :" + v + " ma");
                                    }

                                    $(".signalC1" + item.Id + "").html(v + " " + "<span id='spnhhgC" + item.Id + "' style='font-weight:unset'></span>");
                                    $(id).html(inItem.Title);
                                    $("#divSignal" + item.Id).show();
                                    $("#trSignal" + item.Id).show();
                                }
                                else if (inItem.Title == "Off Aspect mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue) && item.Name.toLowerCase().includes('sh')) {

                                    offAC = v;
                                    $("#signal" + item.Id + "").html("<a class='linkImg'><img style='height:150px;' src='/Content/images/SR-1.jpg' /></a>");
                                    if (isCalibration != null && isCalibration != undefined && isCalibration) {
                                        $(".signalC" + item.Id + "").html('Off Aspect C :' + v + ' ma <a href="javascript:void(0)"><i class="fa fa-pencil" onclick="fnAddCalibration(\'' + item.Id + '\',\'' + inItem.Id + '\',\'' + inItem.Multiplication + '\',\'' + item.Name + '\',\'' + inItem.Title + '\',\'' + v + '\');"></i></a>');
                                    } else {
                                        $(".signalC" + item.Id + "").html("Off Aspect C :" + v + " ma");
                                    }
                                    $(".signalC1" + item.Id + "").html(v);
                                    $(id).html(inItem.Title);
                                    $("#divSignal" + item.Id).show();
                                    $("#trSignal" + item.Id).show();
                                }


                                if (inItem.Title == "RG V") {
                                    if ($.trim($("#signal" + item.Id + "").html()).length > 0 && $.trim($("#signal" + item.Id + "").html()).indexOf("SR-1.jpg") != -1) {

                                        if (isCalibration != null && isCalibration != undefined && isCalibration) {
                                            $(".signalV" + item.Id + "").html('V :' + v + ' v <a href="javascript:void(0)"><i class="fa fa-pencil" onclick="fnAddCalibration(\'' + item.Id + '\',\'' + inItem.Id + '\',\'' + inItem.Multiplication + '\',\'' + item.Name + '\',\'' + inItem.Title + '\',\'' + v + '\');"></i></a>');
                                        } else {
                                            $(".signalV" + item.Id + "").html("V :" + v + " v");
                                        }

                                        $(".signalV1" + item.Id + "").html(v);
                                    }
                                }
                                else if (inItem.Title == "DG V") {
                                    dgv = v;
                                    if ($.trim($("#signal" + item.Id + "").html()).length > 0 && $.trim($("#signal" + item.Id + "").html()).indexOf("SG-1.jpg")!=-1) {

                                        if (isCalibration != null && isCalibration != undefined && isCalibration) {
                                            $(".signalV" + item.Id + "").html('V :' + v + ' v <a href="javascript:void(0)"><i class="fa fa-pencil" onclick="fnAddCalibration(\'' + item.Id + '\',\'' + inItem.Id + '\',\'' + inItem.Multiplication + '\',\'' + item.Name + '\',\'' + inItem.Title + '\',\'' + v + '\');"></i></a>');
                                        } else {
                                            $(".signalV" + item.Id + "").html("V :" + v + " v");
                                        }

                                        $(".signalV1" + item.Id + "").html(v);
                                    }

                                }
                                else if (inItem.Title == "HG V") {
