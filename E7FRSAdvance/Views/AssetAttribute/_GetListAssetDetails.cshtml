@model Domain.AssetLister

@{ 
    string[] feedEnd = { "If mA", "Choke V", "Charger mA", "Charger V", "Charger O", "Last Update Feed End( sec ago)", "Vf", "Charger OP V" };
    string[] relayEnd = { "Vr", "Ir mA", "TPR V", "Last Update Relay End", "TR V (Relay)", "TPR V (Loc)", "Last Update Relay End( sec ago)" };

}
<div class="modal bounceIn animated" id="modal-assetLister" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Asset</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        @if (Model.mAssets != null && Model.mAssets.Count > 0)
                        {
                            if (Model.SearchCriteria.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK && Model.Site != null && Model.Site.IsDatalogger)
                            {
                                Model.mAssets = Model.mAssets.Where(x => x.assetAttributes != null).OrderByDescending(x => x.assetAttributes.Count()).ToList();
                            }
                            foreach (var item in Model.mAssets)
                            {
                                if (item.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK)
                                {
                                    item.assetAttributes = item.assetAttributes.OrderBy(x => x.Sequence).ToList();
                                }

                                int cnt = item.AssetTypeName.Length + item.Name.Length;

                                var isErrorCode = false;
                                if (item.mErrorCodeIdentifier != null && item.mErrorCodeIdentifier.Id > 0)
                                {
                                    isErrorCode = true;
                                }


                                <div class="col-xl-12">
                                    <div class="card card-border">
                                        <div class="bg-secondary main-header" style="padding:0;border-top-left-radius:15px;border-top-right-radius:15px;">
                                            <div class="" style="width:80%;float:left;padding:10px;border-top-left-radius:15px;">
                                                <h6 style="margin-left:12px;">
                                                    <a target="_blank" class="text-white" href="@item.HttpMisLink"> @item.AssetTypeName : @item.Name</a>

                                                    @if (item.DataloggerAssetId > 0)
                                                    {
                                                        <a href="javascript:void(0)" onclick="fnShowRDPMSMapAsset('@item.Id')" class="pull-right text-white">DL</a>
                                                    }

                                                    @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsCalibration)
                                                    {
                                                        <a class="btnPannelTestProcess" data-assetid="@item.Id" href="Javascript:void(0)" style="display:none">
                                                            <img height="20" src="~/assets/images/play_circle_icon.png" title="Start Pannel Test" onclick="fnProcessStartPannelTest(this, '@item.Id')" />
                                                        </a>
                                                    }
                                                </h6>


                                                @if (Model.SearchCriteria.AssetTypeName.ToLower() == "Earth Fault".ToLower())
                                                {
                                                    @*<br />*@
                                                    <span style="margin-left:11px;">Index Score: @item.IndexScore</span>
                                                }

                                            </div>
                                            <div class="text-center bg-dark" style="width:20%;float:left;padding:2px 0px;border-top-right-radius:15px;line-height:1.3;height:@(isErrorCode?"60px":"50px");">

                                                @if (item.UnderMaintence == true)
                                                {
                                                    <div class="text-center"> <i class="fa fa-bell-slash" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i></div>
                                                }
                                                else
                                                {
                                                    <div class="text-center">
                                                        <i class="fa fa-bell" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i>
                                                    </div>
                                                }
                                                <a onclick="fnGetAssetGraph('@item.SiteId', '@item.Id', '@Json.Encode(item.mFamilyTracks)')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer"> Graph </a>
                                                <a onclick="fnGetSmsLog('@item.Id')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer">Event log</a>

                                            </div>

                                        </div>
                                        <div class="card-body gridBody" style="padding:5px;">
                                            <div class="table-responsive width100p tblAssetData">

                                                <table class="table">
                                                    <tbody id="tblAttributeData@(item.Id)" class="tblAttributes tblAttributeData@(item.Id)" data-id="@item.Id">
                                                        @if (item.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK)
                                                        {
                                                            if (item.assetAttributes != null && item.assetAttributes.Count > 0)
                                                            {

                                                                foreach (var assetAttribute in item.assetAttributes.OrderBy(x => x.Sequence))
                                                                {
                                                                    string backgroundColor = "#ffffff";
                                                                    if (feedEnd.Contains(assetAttribute.Title))
                                                                    {
                                                                        backgroundColor = "#9ac2e54f";
                                                                    }
                                                                    else if (relayEnd.Contains(assetAttribute.Title))
                                                                    {
                                                                        backgroundColor = "#97bbe324";
                                                                    }

                                                                    <tr class="gridassetAttribute_@assetAttribute.Title.Replace(" ","").Replace("(","").Replace(")","").Replace("/","")" style="background-color:@backgroundColor">
                                                                        <td style="width:50%">
                                                                            @if (!string.IsNullOrEmpty(assetAttribute.AliasName) && !string.IsNullOrWhiteSpace(assetAttribute.AliasName))
                                                                            {
                                                                                <span> @assetAttribute.AliasName</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                <span> @assetAttribute.Title</span>
                                                                            }



                                                                        </td>
                                                                        <td style="width:50%" class="hdnAttributeData@(assetAttribute.Id)@(item.Id)">
                                                                            @assetAttribute.AttributeData
                                                                        </td>
                                                                        @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsCalibration)
                                                                        {
                                                                            <td style="width:50%">
                                                                                <a class=""><i class="fa fa-pencil" onclick="fnAddCalibration('@item.Id','@assetAttribute.Id','@assetAttribute.Multiplication','@item.Name','@assetAttribute.Title')"></i></a>
                                                                            </td>
                                                                        }
                                                                        else
                                                                        {
                                                                            <td></td>
                                                                        }

                                                                    </tr>
                                                                }

                                                                <tr class="leakge">
                                                                    <td style="width:50%">
                                                                        Leakage

                                                                    </td>
                                                                    <td style="width:50%" class="lekage@(item.Id)">
                                                                    </td>
                                                                    <td></td>
                                                                </tr>
                                                            }

                                                            if (ViewBag.DerivedAttributes != null && Model.SearchCriteria.SiteId == 83)
                                                            {
                                                                var derivedAttribute = ViewBag.DerivedAttributes as List<Domain.AssetAttribute>;
                                                                foreach (var attribute in derivedAttribute.OrderBy(x => x.Sequence))
                                                                {
                                                                    bool isValid = false;
                                                                    var idTitle = attribute.Title.Replace(" ", "");
                                                                    if (idTitle == "ITCBATTCHARG" && item.assetAttributes.Where(x => x.Title == "Charger mA" || x.Title == "If mA").Count() > 0)
                                                                    {
                                                                        isValid = true;
                                                                    }
                                                                    else if (idTitle == "VTCVARRES" && item.assetAttributes.Where(x => x.Title.Contains("Charger OP")).Count() > 0 && item.assetAttributes.Where(x => x.Title == "Choke V").Count() > 0)
                                                                    {
                                                                        isValid = true;
                                                                    }
                                                                    else if (idTitle == "RTCCHFEEDEND" && item.assetAttributes.Where(x => x.Title == "Choke V").Count() > 0 && item.assetAttributes.Where(x => x.Title == "If mA").Count() > 0)
                                                                    {
                                                                        isValid = true;
                                                                    }
                                                                    else if (idTitle == "RTCVARRES" && item.assetAttributes.Where(x => x.Title == "If mA").Count() > 0)
                                                                    {
                                                                        isValid = true;
                                                                    }
                                                                    else if (idTitle == "VTCCHRELAYEND" && item.assetAttributes.Where(x => x.Title == "Vr").Count() > 0 && item.assetAttributes.Where(x => x.Title.Contains("TR V")).Count() > 0)
                                                                    {
                                                                        isValid = true;
                                                                    }
                                                                    else if (idTitle == "RTCCHRELAYEND" && item.assetAttributes.Where(x => x.Title == "Choke V").Count() > 0 && item.assetAttributes.Where(x => x.Title == "Ir mA").Count() > 0)
                                                                    {
                                                                        isValid = true;
                                                                    }
                                                                    else if (idTitle == "RRAIL" && item.assetAttributes.Where(x => x.Title == "Vr").Count() > 0 && item.assetAttributes.Where(x => x.Title.Contains("TR V")).Count() > 0)
                                                                    {
                                                                        isValid = true;
                                                                    }
                                                                    if (isValid)
                                                                    {
                                                                        <tr class="@idTitle">
                                                                            <td style="width:50%">
                                                                                @*ITC BATT CHARG*@
                                                                                @if (!string.IsNullOrEmpty(attribute.AliasName) && !string.IsNullOrWhiteSpace(attribute.AliasName))
                                                                                {
                                                                                    <span>@attribute.AliasName</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span>@attribute.Title</span>
                                                                                }
                                                                            </td>
                                                                            <td style="width:50%" class="@(idTitle)@(item.Id)">
                                                                            </td>
                                                                            <td></td>
                                                                        </tr>
                                                                    }

                                                                }
                                                            }

                                                            if (item.mAssetInfoDataloggers != null && item.mAssetInfoDataloggers.Count > 0 && Model.Site != null && Model.Site.IsDatalogger)
                                                            {
                                                                foreach (var assetInfo in item.mAssetInfoDataloggers)
                                                                {
                                                                    <tr>
                                                                        <td style="width:50%">
                                                                            @assetInfo.DataloggerAttribute
                                                                        </td>
                                                                        <td style="width:50%" class="DLAttribute@(item.Id)@(assetInfo.DataloggerAttributeId)">
                                                                        </td>
                                                                        <td></td>
                                                                    </tr>
                                                                }
                                                            }

                                                            if (item.assetAttributes != null && item.assetAttributes.Count > 0)
                                                            {

                                                                <tr>
                                                                    <td style="width:50%">
                                                                        Index Score

                                                                    </td>
                                                                    <td style="width:50%" class="@(item.IndexScore<7?"text-danger":"")">
                                                                        @item.IndexScore
                                                                    </td>
                                                                    <td></td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="width:50%">
                                                                        HEALTH

                                                                    </td>
                                                                    <td style="width:50%" data-id="@item.Id" class="checkHealth@(item.Id) tdHealth">
                                                                        @if (item.IsAlarm)
                                                                        {
                                                                            <span style='cursor:pointer' onclick="GetLogByAssetId(@item.Id)" class="text-danger">Alarm</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-success">Ok</span>
                                                                        }
                                                                    </td>
                                                                    <td></td>
                                                                </tr>
                                                                <tr>
                                                                    <td style="width:50%">
                                                                        TRACK O/C
                                                                    </td>
                                                                    <td style="width:50%" data-id="@item.Id">
                                                                        <span class="text-success trackoc@(item.Id)">C</span>
                                                                    </td>
                                                                    <td></td>
                                                                </tr>

                                                            }

                                                        }
                                                        else
                                                        {
                                                            if (item.assetAttributes != null && item.assetAttributes.Count > 0)
                                                            {
                                                                foreach (var assetAttribute in item.assetAttributes)
                                                                {
                                                                    <tr class="gridassetAttribute_@assetAttribute.Title.Replace(" ","").Replace("(","").Replace(")","").Replace("/","")">
                                                                        <td style="width:50%">

                                                                            @if (assetAttribute.Title.Contains("+ve"))
                                                                            {
                                                                                <span style="color:darkorange;font-weight:900;font-size:18px;">  @assetAttribute.Title</span>
                                                                            }
                                                                            else if (assetAttribute.Title.Contains("-ve"))
                                                                            {
                                                                                <span style="color: black; font-weight: 900; font-size: 18px;">  @assetAttribute.Title</span>
                                                                            }
                                                                            else
                                                                            {
                                                                                if (!string.IsNullOrEmpty(assetAttribute.AliasName) && !string.IsNullOrWhiteSpace(assetAttribute.AliasName))
                                                                                {
                                                                                    <span> @assetAttribute.AliasName</span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span> @assetAttribute.Title</span>
                                                                                }

                                                                            }

                                                                        </td>
                                                                        @if (Model.SearchCriteria.AssetTypeName.ToLower() == "Earth Fault".ToLower())
                                                                        {

                                                                            if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode())
                                                                            {
                                                                                <td style="width:50%" class="hdnAttributeData@(assetAttribute.Id)@(item.Id) fault-line">
                                                                                    @assetAttribute.AttributeData
                                                                                </td>
                                                                            }
                                                                            if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode())
                                                                            {
                                                                                <td style="width:50%" class="hdnAttributeData@(assetAttribute.Id)@(item.Id) fault-line">
                                                                                    @assetAttribute.AttributeData
                                                                                </td>
                                                                            }
                                                                        }
                                                                        else
                                                                        {
                                                                            <td style="width:50%" class="hdnAttributeData@(assetAttribute.Id)@(item.Id)">
                                                                                @assetAttribute.AttributeData
                                                                            </td>
                                                                        }

                                                                        @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsCalibration)
                                                                        {
                                                                            <td style="width:50%">
                                                                                <a class=""><i class="fa fa-pencil" onclick="fnAddCalibration('@item.Id','@assetAttribute.Id','@assetAttribute.Multiplication','@item.Name','@assetAttribute.Title')"></i></a>
                                                                            </td>
                                                                        }
                                                                        else
                                                                        {
                                                                            <td></td>
                                                                        }

                                                                    </tr>
                                                                }

                                                            }
                                                            else
                                                            {
                                                                <tr>
                                                                    <td class="text-center" colspan="3">No attributes found!</td>
                                                                </tr>
                                                            }
                                                        }


                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            }
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
@{
    string type = string.Empty;
    if (Model != null && Model.mAssets.Count > 0)
    {
        type = Model.mAssets[0].AssetTypeName;
    }
}

<script>
    var json = "";
    var mQQTPath = "";
    var client = null;
    var values = '@type';
        var admin = '@E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId';
    var isDatalogger = '@Model.Site.IsDatalogger';
      var isDataLoggerJsonReverse = '@Model.Site.IsDataLoggerJsonReverse';
    $(document).ready(function () {
        json = @Html.Raw(Json.Encode(Model));
        mQTT =@Html.Raw(Json.Encode(Model.MQTTDetail));

        if (json.SearchCriteria.MQTTPaths != null && json.SearchCriteria.MQTTPaths.length > 0)
            mQQTPath = json.SearchCriteria.MQTTPaths[0];

        if (json.SearchCriteria.ChannelList != null && json.SearchCriteria.ChannelList.length > 0) {
            channels = json.SearchCriteria.ChannelList;
        }

        if (mQTT != null && mQTT != undefined && mQTT.MQTTUri != null && mQTT.MQTTUri != undefined && mQTT.MQTTUri != '') {
            let isSecure = window.location.protocol === "https:";
            client = new Paho.Client(mQTT.MQTTUri, mQTT.MQTTPort, "clientId" + Math.ceil(Math.random() * 10000));
            // set callback handlers

            client.onConnectionLost = onConnectionLost;
            client.onMessageArrived = onMessageArrived;

            // connect the client
            client.connect({
                onSuccess: onConnect,
                useSSL: isSecure,
                userName: mQTT.MQTTUsername,
                password: mQTT.MQTTPassword,
                cleanSession: true
            });

            setInterval(function () {
                $(".gridBody").each(function (i, j) {
                    var ifMa = $.trim($(this).find('table').children('tbody').find('tr.gridassetAttribute_IfmA').find("td:eq(1)").html());
                    var irMa = $.trim($(this).find('table').children('tbody').find('tr.gridassetAttribute_IrmA').find("td:eq(1)").html());

                    var chargermA = $.trim($(this).find('table').children('tbody').find('tr.gridassetAttribute_ChargermA').find("td:eq(1)").html());
                    var vrv = $.trim($(this).find('table').children('tbody').find('tr.gridassetAttribute_Vr').find("td:eq(1)").html());
                    var trv = $.trim($(this).find('table').children('tbody').find('tr.gridassetAttribute_TRVRelay').find("td:eq(1)").html());
                    var chargeropv = $.trim($(this).find('table').children('tbody').find('tr.gridassetAttribute_ChargerOPV').find("td:eq(1)").html());
                    var vfData = $.trim($(this).find('table').children('tbody').find('tr.gridassetAttribute_Vf').find("td:eq(1)").html());
                    var chokeV = $.trim($(this).find('table').children('tbody').find('tr.gridassetAttribute_ChokeV').find("td:eq(1)").html());
                    var id = $(this).find('table').children('tbody').attr("data-id");
                    var tpr = $.trim($(this).find('table').children('tbody').children('tr:first').find("td:eq(5)").html());
                    if (ifMa != null && irMa != null) {

                        if (isNaN($.trim(ifMa.replace(/\n/g, ''))) || ifMa == "")
                            ifMa = 0;
                        if (isNaN($.trim(irMa.replace(/\n/g, ''))) || irMa == "")
                            irMa = 0;

                        var lekage = parseFloat(ifMa) - parseFloat(irMa);
                        if (lekage > 150) {

                            $(this).find('table').children('tbody').children('tr').each(function (ele, ids) {

                                if ($(ids).hasClass('leakge')) {

                                    $(ids).find("td:eq(1)").addClass('text-danger').html(lekage.toFixed(1));
                                }
                            });
                        }
                        else {

                            $(this).find('table').children('tbody').children('tr').each(function (ele, ids) {

                                if ($(ids).hasClass('leakge')) {

                                    $(ids).find("td:eq(1)").removeClass('text-danger').html(lekage.toFixed(1));
                                }
                            });
                        }

                        var vtrval = 0;
                        $(this).find('table').children('tbody').children('tr').each(function (ele, ids) {
                            //ITC BATT CHARG
                            if (chargermA != null && chargermA != undefined && chargermA != '' && ifMa != null && ifMa != undefined && ifMa != '') {
                                var ibc = parseFloat(chargermA) - parseFloat(ifMa);
                                if ($(ids).hasClass('ITCBATTCHARG')) {
                                    $(ids).find("td:eq(1)").html(ibc.toFixed(1));
                                }
                            }

                            //VTC VAR RES
                            if (chargeropv != null && chargeropv != undefined && chargeropv != '' && vfData != null && vfData != undefined && vfData != '' && chokeV != null && chokeV != undefined && chokeV != '') {
                                var vtco = parseFloat(chargeropv) - parseFloat(vfData) - parseFloat(chokeV);
                                if ($(ids).hasClass('VTCVARRES')) {
                                    vtrval = vtco.toFixed(1);
                                    $(ids).find("td:eq(1)").html(vtco.toFixed(1));
                                }
                            }

                            //RTC CH FEED END
                            if (chokeV != null && chokeV != undefined && chokeV != '' && ifMa != null && ifMa != undefined && ifMa != '') {
                                var ifA = parseFloat(ifMa) / 1000;
                                var vtco = parseFloat(chokeV) / parseFloat(ifA);
                                if ($(ids).hasClass('RTCCHFEEDEND')) {
                                    $(ids).find("td:eq(1)").html(vtco.toFixed(1));
                                }
                            }

                            //RTC VAR RES
                            if (vtrval != null && vtrval != undefined && ifMa != null && ifMa != undefined && ifMa != '') {
                                var ifA = parseFloat(ifMa) / 1000;
                                var vtco = parseFloat(vtrval) / parseFloat(ifA);
                                if ($(ids).hasClass('RTCVARRES')) {
                                    $(ids).find("td:eq(1)").html(vtco.toFixed(1));
                                }
                            }


                            //VTC CH RELAY END
                            if (vrv != null && vrv != undefined && vrv != '' && trv != null && trv != undefined && trv != '') {

                                var vtco = parseFloat(vrv) - parseFloat(trv);
                                if ($(ids).hasClass('VTCCHRELAYEND')) {
                                    $(ids).find("td:eq(1)").html(vtco.toFixed(1));
                                }
                            }


                            //RTC CH RELAY END
                            if (chokeV != null && chokeV != undefined && chokeV != '' && irMa != null && irMa != undefined && irMa != '') {
                                var irA = parseFloat(irMa) / 1000;
                                var vtco = parseFloat(chokeV) / parseFloat(irA);
                                if ($(ids).hasClass('RTCCHRELAYEND')) {
                                    $(ids).find("td:eq(1)").html(vtco.toFixed(1));
                                }
                            }

                            //RRAIL
                            if (vrv != null && vrv != undefined && vrv != '' && trv != null && trv != undefined && trv != '') {

                                var vtco = (parseFloat(vrv) - parseFloat(trv)) / lekage;
                                if ($(ids).hasClass('RRAIL')) {
                                    $(ids).find("td:eq(1)").html(vtco.toFixed(1));
                                }
                            }

                        });

                        if ($(".trackoc" + id).html() == "O" && parseInt(tpr) > 1) {

                            $(".lekage" + id).removeClass("text-danger");
                        }
                    }
                });
                $(".listBody").each(function (i, j) {
                    $(this).find('table').children('tbody').children('tr').each(function (n, ji) {
                        var ifMa = $.trim($(ji).find('td:eq(1)').html());
                        var irMa = $.trim($(ji).find("td:eq(2)").html());
                        var irMa = $.trim($(ji).find("td:eq(2)").html());

                        var id = $(this).attr("data-id");
                        var tpr = $.trim($(ji).find("td:eq(3)").html());

                        if (ifMa != null && irMa != null) {

                            if (isNaN($.trim(ifMa.replace(/\n/g, ''))) || ifMa == "")
                                ifMa = 0;
                            if (isNaN($.trim(irMa.replace(/\n/g, ''))) || irMa == "")
                                irMa = 0;

                            var lekage = parseFloat(ifMa) - parseFloat(irMa);
                            if (lekage > 150) {

                                $(ji).children('td').each(function (ele, ids) {

                                    if ($(this).hasClass('leakge')) {

                                        $(this).addClass('text-danger').html(lekage.toFixed(1));
                                    }
                                });


                                // $(ji).find("td:eq(10)").addClass('text-danger').html(lekage.toFixed(1));
                            }
                            else {
                                $(ji).children('td').each(function (ele, ids) {
                                    if ($(this).hasClass('leakge')) {
                                        $(this).removeClass('text-danger').html(lekage.toFixed(1));
                                    }
                                });

                                // $(ji).find("td:eq(10)").removeClass('text-danger').html(lekage.toFixed(1));
                            }

                            if ($.trim($(ji).find("td:eq(12)").text()) == "O" && parseInt(tpr) > 1) {

                                $(ji).find("td:eq(10)").removeClass("text-danger");
                            }
                        }
                    })
                });
            }, 4000)

            setInterval(function () {
                $(".tdHealth").each(function () {
                    GetAlarmStatus($(this).attr("data-Id"));
                })
            }, 60000)
        }

    });

    function onConnect() {
        // Once a connection has been made, make a subscription and send a message.
        for (var i = 0; i < channels.length; i++) {
            if (channels[i] != null && channels[i] != "null" && channels[i] != "") {
                client.subscribe(mQQTPath + channels[i].toLowerCase());

                client.subscribe(mQQTPath + 'dl/#');
            }
        }
    }

    function onConnectionLost(responseObject) {
        if (responseObject != null && responseObject.errorCode !== 0) {
            console.log("onConnectionLost:" + responseObject.errorMessage);
            //location.reload();
        }
        client.connect({
            onSuccess: onConnect,
            userName: "wattmon",
            password: "wattmon_2018",
            cleanSession: true
        });
    }

    $(document).on('hide.bs.modal', '#modal-assetLister', function () {
        if (client && client.isConnected()) {
            try {
                client.disconnect();
            } catch (err) {
            }
