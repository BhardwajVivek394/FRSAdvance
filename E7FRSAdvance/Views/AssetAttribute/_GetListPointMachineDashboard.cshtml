@model Domain.AssetLister

<div class="modal bounceIn animated" id="modal-assetLister" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Asset</span></h4>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close" data-bs-original-title="" title=""></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="card">
                            <div class="card-header">
                                <div class="row">
                                    <div class="col-sm-2 mb-1">
                                        <label>From Date</label>
                                        <input type="text" name="SearchCriteria.StartDate" class="datepicker-here form-control digits" id="txtattrPmFromDate" value="@Model.SearchCriteria.StartDate" data-language="en" data-bs-original-title="" title="" />
                                    </div>
                                    <div class="col-sm-2 mb-1">
                                        <label>To Date</label>
                                        <input type="text" name="SearchCriteria.EndDate" class="datepicker-here form-control digits to-date" id="txtattrPmToDate" value="@Model.SearchCriteria.EndDate" data-language="en" data-bs-original-title="" title="" />
                                    </div>
                                    <div class="col-sm-2 mb-1 mt-4">
                                        <a class="btn btn-success" onclick="fnSearchGetAssetAttribute('@Model.SearchCriteria.SiteName','@Model.mAssets.Select(x => x.Id).FirstOrDefault()','@Model.SearchCriteria.AssetTypeId',$('#txtattrPmFromDate').val(),$('#txtattrPmToDate').val())"><i class="fa fa-search"></i></a>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body" style="padding:15px;">
                                @if (Model.mAssets != null && Model.mAssets.Count > 0)
                                {
                                    foreach (var item in Model.mAssets)
                                    {
                                        int cnt = item.AssetTypeName.Length + item.Name.Length;

                                        var vibration = item.assetAttributes.Where(x => x.Title.Contains("Vibration")).ToList();
                                        bool isVibration = false;
                                        if (vibration != null && vibration.Count > 0)
                                        {
                                            isVibration = true;
                                        }
                                        string aEnd = string.Empty;
                                        string bEnd = string.Empty;
                                        string aVibration = string.Empty;
                                        string bVibration = string.Empty;
                                        if (item.assetAttributes != null && item.assetAttributes.Count > 0)
                                        {
                                            var mAEnd = item.assetAttributes.Where(x => x.Title == "A End - NWKR" || x.Title == "A End - RWKR" || x.Title == "A End - NWKR (Loc)" || x.Title == "A End - RWKR (Loc)").ToList();
                                            if (mAEnd != null && mAEnd.Count > 0)
                                            {
                                                aEnd = Newtonsoft.Json.JsonConvert.SerializeObject(mAEnd);
                                            }
                                            var mBEnd = item.assetAttributes.Where(x => x.Title == "B End - NWKR" || x.Title == "B End - RWKR" || x.Title == "B End - NWKR (Loc)" || x.Title == "B End - RWKR (Loc)").ToList();
                                            if (mBEnd != null && mBEnd.Count > 0)
                                            {
                                                bEnd = Newtonsoft.Json.JsonConvert.SerializeObject(mBEnd);
                                            }
                                            var mAVibration = item.assetAttributes.Where(x => x.Title.Contains("Vibration A")).ToList();
                                            if (mAVibration != null && mAVibration.Count > 0)
                                            {
                                                aVibration = Newtonsoft.Json.JsonConvert.SerializeObject(mAVibration);
                                            }
                                            var mBVibration = item.assetAttributes.Where(x => x.Title.Contains("Vibration B")).ToList();
                                            if (mBVibration != null && mBVibration.Count > 0)
                                            {
                                                bVibration = Newtonsoft.Json.JsonConvert.SerializeObject(mBVibration);
                                            }
                                        }

                                        <div class="col-sm-12 col-md-12 col-lg-12">
                                            <div class="card">
                                                <div class="col-xl-12 news box-col-12">
                                                    <div class="card card-border">
                                                        <div class="bg-primary" style="padding:0;border-top-left-radius:15px;border-top-right-radius:15px;">
                                                            <div class="" style="width:95%;float:left;padding:0px;border-top-left-radius:15px;">
                                                                <h6 style="margin-left:10px">
                                                                    <a target="_blank" class="text-white" href="@item.HttpMisLink"> @item.AssetTypeName : @item.Name</a>
                                                                </h6>
                                                                <span style="margin-left:11px;">Index Score: @item.IndexScore</span>
                                                            </div>
                                                            <div class="text-center bg-dark" style="width:5%;float:left;padding:2px 0px;border-top-right-radius:15px;line-height:1.3;height:50px">

                                                                @if (item.UnderMaintence == true)
                                                                {
                                                                    <div class="text-center"> <i class="fa fa-bell-slash fa fa-das" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i></div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="text-center">
                                                                        <i class="fa fa-bell" style="font-size:16px;cursor:pointer;" onclick="fnUnderMaintenance('@item.Id', this)" data-id="@item.Id"></i>
                                                                    </div>
                                                                }
                                                                @*<a onclick="fnGetAssetGraph('@item.SiteId','@item.Id')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer"> Graph </a>*@
                                                                <a onclick="fnGetSmsLog('@item.Id')" style="color:white;text-transform:capitalize;font-size:10px;display:flow-root;cursor:pointer">Event log</a>
                                                            </div>

                                                        </div>
                                                        <div class="card-body" style="padding:10px;margin-bottom:-15px">
                                                            <div class="row">
                                                                <div class="col-sm-12 mb10 mt20 text-right">
                                                                    <a style="margin-bottom:10px;float:right;" class="btn btn-primary" onclick="DownloadPointData(@item.Id)">Download</a>
                                                                </div>
                                                            </div>


                                                            <div class="table-responsive width100p tblAssetData">
                                                                <table class="table table-bordered table-striped">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>@item.Name</th>
                                                                            @if (item.IsHalfPointMachine == null || (item.IsHalfPointMachine != null && !item.IsHalfPointMachine.Value))
                                                                            {
                                                                                if (!string.IsNullOrEmpty(item.AliasDirectionA))
                                                                                {
                                                                                    <th><a href="javascript:;" onclick="fnShowPointMachineGraph('@item.SiteId', '@item.Id', '@aEnd'); return false;"> Direction:@item.AliasDirectionA</a></th>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <th><a href="javascript:;" onclick="fnShowPointMachineGraph('@item.SiteId','@item.Id','@aEnd'); return false;">Direction:A</a></th>
                                                                                }
                                                                                if (!string.IsNullOrEmpty(item.AliasDirectionB))
                                                                                {
                                                                                    <th><a href="javascript:;" onclick="fnShowPointMachineGraph('@item.SiteId','@item.Id','@bEnd'); return false;"> Direction:@item.AliasDirectionB</a></th>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <th><a href="javascript:;" onclick="fnShowPointMachineGraph('@item.SiteId','@item.Id','@bEnd'); return false;"> Direction:B</a></th>
                                                                                }
                                                                                if (isVibration)
                                                                                {
                                                                                    <th><a href="javascript:;" onclick="fnShowPointMachineGraph('@item.SiteId','@item.Id','@aVibration'); return false;"> VibrationA(x/y/z)</a></th>
                                                                                    <th><a href="javascript:;" onclick="fnShowPointMachineGraph('@item.SiteId','@item.Id','@bVibration'); return false;"> VibrationB(x/y/z)</a></th>
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                <th><a href="javascript:;" onclick="fnShowPointMachineGraph('@item.SiteId','@item.Id','@aEnd'); return false;">Direction</a></th>
                                                                                <th></th>
                                                                                if (isVibration)
                                                                                {
                                                                                    <th></th>
                                                                                    <th></th>
                                                                                }
                                                                            }

                                                                        </tr>
                                                                    </thead>
                                                                    <tbody id="tblAttributeData@(item.Id)" class="tblAttributes">
                                                                        <tr>
                                                                            <td>
                                                                            </td>
                                                                            <td id="diectionA@(item.Id)">
                                                                            </td>
                                                                            <td id="diectionB@(item.Id)">
                                                                            </td>
                                                                            @if (isVibration)
                                                                            {
                                                                                var VibA = vibration.Where(x => x.Title.ToLower().Contains("Vibration A".ToLower())).ToList();
                                                                                var VibB = vibration.Where(x => x.Title.ToLower().Contains("Vibration B".ToLower())).ToList();
                                                                                int a = 1;
                                                                                int b = 1;
                                                                                <td id="vibrationA@(item.Id)">

                                                                                    @foreach (var assetAttribute in VibA)
                                                                                    {
                                                                                        if (VibA.Count == a)
                                                                                        {
                                                                                            <span id="hdnAttributeData@(assetAttribute.Id)@(item.Id)">
                                                                                            </span>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <span id="hdnAttributeData@(assetAttribute.Id)@(item.Id)">
                                                                                            </span><span> | </span>
                                                                                        }
                                                                                        a++;
                                                                                    }

                                                                                </td>
                                                                                <td id="vibrationB@(item.Id)">
                                                                                    @foreach (var assetAttribute in VibB)
                                                                                    {
                                                                                        if (VibB.Count == b)
                                                                                        {
                                                                                            <span id="hdnAttributeData@(assetAttribute.Id)@(item.Id)">
                                                                                            </span>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <span id="hdnAttributeData@(assetAttribute.Id)@(item.Id)">
                                                                                            </span><span> | </span>
                                                                                        }
                                                                                        b++;
                                                                                    }
                                                                                </td>
                                                                            }

                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                            <div class="table-responsive width100p tblAssetData m-b-20" style="overflow:auto;max-height:420px;">

                                                                <table class="table table-bordered table-striped" id="tblPoint@(item.Id)">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Date</th>
                                                                            <th>Name</th>
                                                                            <th>Direction</th>
                                                                            @if (item.IsSeriesOpration != null && item.IsSeriesOpration.Value)
                                                                            {
                                                                                <th>New Combine<br /><a href="javascript:void(0)" title="Normal Current" onclick="fnBindMultipleSignatureEventGragh('@item.Id', 'Normal', 'C');return false;">NC</a> | <a href="javascript:void(0)" onclick="fnBindMultipleSignatureEventGragh('@item.Id', 'Normal', 'V');return false;" title="Normal Voltage">NV</a> | <a href="javascript:void(0)" onclick="fnBindMultipleSignatureEventGragh('@item.Id','Reverse','C');return false;" title="Reverse Current">RC</a> | <a href="javascript:void(0)" onclick="fnBindMultipleSignatureEventGragh('@item.Id','Reverse','V');return false;" title="Reverse Voltage">RV</a></th>

                                                                                <th>Combine <br /> <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id', 'Normal', 'CC');return false;">N</a> | <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Reverse','CC');return false;">R</a></th>
                                                                            }

                                                                            @if (item.IsHalfPointMachine == null || (item.IsHalfPointMachine != null && !item.IsHalfPointMachine.Value))
                                                                            {

                                                                                <th>A Current(Max/Avg) <br /><a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id', 'Normal', 'AC');return false;">N</a> | <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Reverse','AC');return false;">R</a> | <a title="Normal Presentation" href="javascript:void(0)" onclick="fnShowPointmachineGif('@item.Id','Normal','AC');return false;">NP</a> | <a title="Reverse Presentation" href="javascript:void(0)" onclick="fnShowPointmachineGif('@item.Id','Reverse','AC');return false;">RP</a> | <a href="javascript:void(0)" title="Normal Current Graph" onclick="fnShowPMNormalCurrentGraph('@item.Id','AC');return false;">N-CG</a> | <a href="javascript:void(0)" title="Reverse Current Graph" onclick="fnShowPMReverseCurrentGraph('@item.Id','AC');return false;">R-CG</a></th>
                                                                                <th>A Voltage <br /><a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Normal','AV');return false;">N</a> | <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Reverse','AV');return false;">R</a></th>
                                                                                <th>A Time (ms)</th>
                                                                            }
                                                                            else
                                                                            {
                                                                                <th>Current(Max/Avg) <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id', 'Normal', 'AC');return false;">N</a> | <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Reverse','AC');return false;">R</a> | <a href="javascript:void(0)" onclick="fnShowPointmachineGif('@item.Id','Normal','AC');return false;">NP</a> | <a href="javascript:void(0)" onclick="fnShowPointmachineGif('@item.Id','Reverse','AC');return false;">RP</a> | <a href="javascript:void(0)" title="Normal Current Graph" onclick="fnShowPMNormalCurrentGraph('@item.Id','AC');return false;">N-CG</a> | <a href="javascript:void(0)" title="Reverse Current Graph" onclick="fnShowPMReverseCurrentGraph('@item.Id','AC');return false;">R-CG</a></th>
                                                                                <th>Voltage</th>
                                                                                <th>Time (ms)</th>
                                                                            }


                                                                            @if (item.IsHalfPointMachine == null || (item.IsHalfPointMachine != null && !item.IsHalfPointMachine.Value))
                                                                            {
                                                                                <th>B Current(Max/Avg) <br /><a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Normal','BC');return false;">N</a> | <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Reverse','BC');return false;">R</a> | <a href="javascript:void(0)" title="Normal Current Graph" onclick="fnShowPMNormalCurrentGraph('@item.Id','BC');return false;">N-CG</a> | <a href="javascript:void(0)" title="Reverse Current Graph" onclick="fnShowPMReverseCurrentGraph('@item.Id','AC');return false;">R-CG</a></th>
                                                                                <th>B Voltage <br /><a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Normal','BV');return false;">N</a> | <a href="javascript:void(0)" onclick="fnShowMultipleGraph('@item.Id','Reverse','BV');return false;">R</a></th>
                                                                                <th>B Time (ms)</th>

                                                                            }

                                                                            @if (item.IsHalfPointMachine == null || (item.IsHalfPointMachine != null && !item.IsHalfPointMachine.Value))
                                                                            {

                                                                                <th class="PMExtraColumn_@item.Id display-none" width="120">Cluster A</th>
                                                                                <th class="PMExtraColumn_@item.Id display-none">Deviation A</th>
                                                                            }
                                                                            else
                                                                            {
                                                                                <th class="PMExtraColumn_@item.Id display-none" width="120">Cluster</th>
                                                                                <th class="PMExtraColumn_@item.Id display-none">Deviation</th>
                                                                            }

                                                                            @if (item.IsHalfPointMachine == null || (item.IsHalfPointMachine != null && !item.IsHalfPointMachine.Value))
                                                                            {
                                                                                <th class="PMExtraColumn_@item.Id display-none" width="120">Cluster B</th>
                                                                                <th class="PMExtraColumn_@item.Id display-none">Deviation B</th>
                                                                            }


                                                                        </tr>
                                                                    </thead>
                                                                    <tbody class="fbody@(item.Id)">
                                                                        @Html.Partial("_PointMachineDatePartial", item)
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <p style="font-size:15px">No record found!</p>
                                }



                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@{
    var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    serializer.MaxJsonLength = Int32.MaxValue;
    var jsonModel = serializer.Serialize(Model);
}

<script>
    var json = "";
    var client = null;
    var mQQTPath = "";
    var channels = [];
    var aEN = 0;
    var aER = 0;
    var bEN = 0;
    var bER = 0;
    var isCalibration = stringToBool('@E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsCalibration');

    (function ($) {
        $.fn.focusTextToEnd = function () {
            this.focus();
            var $thisVal = this.val();
            this.val('').val($thisVal);
            return this;
        }
    }(jQuery));
    $(document).ready(function () {
        $(".asset-search").keyup(function (e) {
            setTimeout(function () {
                $("#frmAssetDetails").submit();
            }, 3000)
        });
        $('[data-toggle="popover"]').popover();

        $("#lblAssetType").html($("#AssetName" + $("#hdnassetTypeId").val()).val());
        $(".asset-search").focusTextToEnd();
     //   $('#Pager').select2({ minimumResultsForSearch: Infinity });

     //   $('#drpPageSize').select2({ minimumResultsForSearch: Infinity });

        $('#drpPageSize').change(function (e) {
            $("#hdnSkip").val('0');
            //$("#hdndateValue").val();
            //$("#hdnassetTypeId").val();
            $("#frmAssetDetails").submit();
        });
        $('#txtattrPmFromDate').datepicker();
        $('#txtattrPmToDate').datepicker();


        //$('#txtFromDate').change(function () {
        //    fnShowPointMachineData();
        //});

        //$('#txtToDate').change(function () {
        //    fnShowPointMachineData();
        //});
        //fnShowPointMachineData();

      //  $('.dropDownList').select2({ minimumResultsForSearch: Infinity });
        json = @Html.Raw(jsonModel);
          mQTT=@Html.Raw(Json.Encode(Model.MQTTDetail));
        if (json.SearchCriteria.MQTTPaths != null && json.SearchCriteria.MQTTPaths.length > 0)
            mQQTPath = json.SearchCriteria.MQTTPaths[0];

        if (json.SearchCriteria.ChannelList != null && json.SearchCriteria.ChannelList.length > 0) {
            channels = json.SearchCriteria.ChannelList;
        }
        for (var i = 0; i < channels.length; i++) {
            $("#c" + i).html('');
        }
        ///Create a client instance
        //$scope.client = new Paho.Client('mqtt.wattmon.com', 8083, "clientId");
        let isSecure = window.location.protocol === "https:";
        client = new Paho.Client(mQTT.MQTTUri, mQTT.MQTTPort, "clientId" + Math.ceil(Math.random() * 10000));
        // set callback handlers

        client.onConnectionLost = onConnectionLost;
        client.onMessageArrived = onMessageArrivedPointMachine;

        // connect the client
        client.connect({
            onSuccess: onConnect,
            useSSL: isSecure,
            userName: mQTT.MQTTUsername,
            password: mQTT.MQTTPassword,
            cleanSession: true
        });

    });

    function fnAttrSearchPointMachine() {

    }

    function fnShowPointMachineData() {
        var start = new Date($('#txtFromDate').val());
        var end = new Date($('#txtToDate').val());
        var days = new Date(end - start) / (1000 * 60 * 60 * 24);
        if (Math.round(days) >= 1) {
            $('#SearchCriteria_TakePointMachineData').show();
        } else {
            $("#SearchCriteria_TakePointMachineData").val($("#SearchCriteria_TakePointMachineData option:first").val());
            $('#SearchCriteria_TakePointMachineData').hide();
        }
    }

    function onConnect() {
        // Once a connection has been made, make a subscription and send a message.
        for (var i = 0; i < channels.length; i++) {
            console.log(channels[i])
            if (channels[i] != null && channels[i] != "") {
                client.subscribe(mQQTPath + channels[i]);
            }
        }
    }

    // called when the client loses its connection
    function onConnectionLost(responseObject) {
        if (responseObject != null && responseObject.errorCode !== 0) {
            console.log("onConnectionLost:" + responseObject.errorMessage);
            //location.reload();
        }
            client.connect({
                onSuccess: onConnect,
                userName: "wattmon",
                password: "wattmon_2018",
                cleanSession: true
            });
    }

    // called when a message arrives
    function onMessageArrivedPointMachine(message) {
        if (message.payloadString.includes("roles") && message.payloadString.includes("ts")) {
            var parseJson = JSON.parse(message.payloadString);
            if (parseJson != null && parseJson != undefined && parseJson != '') {
                var array = parseJson['roles'];
                if (array != null && array != undefined && array.length > 0) {
                    BindDataPointMachine(message.destinationName, array);
                }
            }
        } else {
            var channeldata = message.payloadString.split(',');
            BindDataPointMachine(message.destinationName, channeldata);
        }
       

        for (var i = 0; i < channels.length; i++) {
            if (channels[i] != null && channels[i] != "null" && channels[i] != "") {

                var name = mQQTPath.toLowerCase() + channels[i].toLowerCase();
                if (message.destinationName.toLowerCase() == name.toLowerCase()) {
                    var d = new Date();
                    var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
                    $("#c" + i).html(time);
                }
            }
        }
    }

    function BindDataPointMachine(basePath, data) {
        $.each(json.mAssets, function (id, item) {

            var aENAttr = {};
            var aERAttr = {};
            var bENAttr = {};
            var bERAttr = {};

            var aENLAttr = {};
            var aERLAttr = {};
            var bENLAttr = {};
            var bERLAttr = {};


            aEN = 0;
            aER = 0;
            bEN = 0;
            bER = 0;

            if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                $.each(item.assetAttributes, function (idx, inItem) {

                    var str1 = basePath.toLowerCase();
                    var str2 = "";
                    if (inItem.AssetInfoChannel != null && inItem.AssetInfoChannel != "") {
                        str2 = inItem.AssetInfoChannel.toLowerCase();
                    }
                    if (str1.indexOf(str2) != -1) {

                        var infoValue = inItem.AssetInfoValue;
                        var infoMultiplication = inItem.Multiplication;
                        if (infoValue != null) {
                            var dataValue = data[infoValue];
                            var id = "#hdnAttributeData" + inItem.Id + item.Id;
                            if (infoMultiplication != null) {
                                var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                var v = (Math.round(mainData * 100) / 100).toFixed(1);
                                if (inItem.Title == "A End - NWKR") {
                                    aEN = v;

                                    aENAttr.AssetId = item.Id;
                                    aENAttr.AttributeId = inItem.Id;
                                    aENAttr.Multiplication = inItem.Multiplication;
                                    aENAttr.AssetName = item.Name;
                                    aENAttr.AttributeName = inItem.Title;
                                    aENAttr.CurrentMultiplication = aEN;
                                }
                                else if (inItem.Title == "A End - RWKR") {
                                    aER = v;

                                    aERAttr.AssetId = item.Id;
                                    aERAttr.AttributeId = inItem.Id;
                                    aERAttr.Multiplication = inItem.Multiplication;
                                    aERAttr.AssetName = item.Name;
                                    aERAttr.AttributeName = inItem.Title;
                                    aERAttr.CurrentMultiplication = aER;
                                }

                                if (inItem.Title == "B End - NWKR") {
                                    bEN = v;

                                    bENAttr.AssetId = item.Id;
                                    bENAttr.AttributeId = inItem.Id;
                                    bENAttr.Multiplication = inItem.Multiplication;
                                    bENAttr.AssetName = item.Name;
                                    bENAttr.AttributeName = inItem.Title;
                                    bENAttr.CurrentMultiplication = bEN;
                                }

                                if (inItem.Title == "B End - RWKR") {
                                    bER = v;

                                    bERAttr.AssetId = item.Id;
                                    bERAttr.AttributeId = inItem.Id;
                                    bERAttr.Multiplication = inItem.Multiplication;
                                    bERAttr.AssetName = item.Name;
                                    bERAttr.AttributeName = inItem.Title;
                                    bERAttr.CurrentMultiplication = bER;
                                }

                                if (inItem.Title == "A End - NWKR (Loc)") {
                                    aENL = v;

                                    aENLAttr.AssetId = item.Id;
                                    aENLAttr.AttributeId = inItem.Id;
                                    aENLAttr.Multiplication = inItem.Multiplication;
                                    aENLAttr.AssetName = item.Name;
                                    aENLAttr.AttributeName = inItem.Title;
                                    aENLAttr.CurrentMultiplication = aENL;
