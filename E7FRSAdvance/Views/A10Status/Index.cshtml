        //var arrow = isAscending ? "↓" : "↑";
        //header.append('<span class="sort-indicator" style="font-size: 20px; margin-left: 10px;">' + arrow + '</span>');
    }

    function comparer(index) {
        return function (a, b) {
            var valA = getCellValue(a, index), valB = getCellValue(b, index)
            return $.isNumeric(valA) && $.isNumeric(valB) ? valA - valB : valA.toString().localeCompare(valB)
        }
    }

    function getCellValue(row, index) { return $(row).children('td').eq(index).text() }

    function fnGraph(a10Id) {
        var siteId = $('#hdnSearchSiteId').val();
        var date = $('#searchDate').val();
        if (a10Id == null || a10Id == undefined || a10Id == '') {
            a10Id = $('#hdnA10Id').val();
        } else {
            $('#hdnA10Id').val(a10Id)

        }

        if (siteId != null && siteId != undefined && siteId != '0') {
            $("#loader").show();
            $.ajax({
                url: '/A10Status/GetGraph',
                data: '{siteId:' + siteId + ',date:"' + date + '",a10Id:"' + a10Id + '"}',
                type: 'POST',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    var DataSeriaes = [];
                    var DataColor = [];
                    var maxV = 0;
                    var legends = [];
                    var macLeft = 0;
                    var lary = [];
                    var xValue = [];

                    if (data != null) {
                        $.each(data, function (index, value) {
                            legends.push(index);
                            var lineColor = fnGetDarkColor();
                            DataColor.push(lineColor);
                            if (data != null && data != undefined && data != '') {

                                var attr = {};
                                attr.name = index;
                                attr.type = 'line';
                                attr.notShowSymbol = true;
                                attr.sampling = sampling;
                                attr.hoverAnimation = false;
                                attr.clip = true;

                                attr.data = [];
                                var values = [];
                                $.each(value, function (index2, value2) {

                                    const d = new Date(value2.timestamp);
                                    var dateString = d.getDate() + "-" + (d.getMonth() + 1) + " " + d.getHours() + ":" + d.getMinutes() + "";

                                    if ($.inArray(dateString, xValue) != -1) {
                                    } else {
                                        xValue.push(dateString);
                                    }
                                    values.push(parseFloat(value2.last_response).toFixed(2));
                                });
                                $.each(values, function (i, j) {
                                    var d = parseFloat(j);
                                    if (d > maxV) {
                                        maxV = d;
                                    }
                                });

                                var yLeft = Math.max.apply(Math, values); // 3
                                if (yLeft >= macLeft) {
                                    macLeft = yLeft;
                                }

                                attr.connectNulls = true;
                                attr.data = values;
                                attr.datasetIndex = 0;
                                DataSeriaes.push(attr);

                            }

                        });

                        $("#modal-graph").modal("show");

                        if (pmchart != null && pmchart != "" && pmchart != undefined) {
                            pmchart.dispose();
                        }
                        pmchart = echarts.init(document.getElementById('area-current-graph-echart'));
                        var sampling = 'none';
                        pmchart.setOption({
                            tooltip: {
                                trigger: 'axis',
                                axisPointer: {
                                    type: 'cross',
                                    label: {
                                        backgroundColor: '#6a7985'
                                    }
                                }
                            },
                            legend: {
                                data: legends,
                                x: 'left'

                            },
                            toolbox: {
                                show: true,
                                feature: {
                                    mark: { show: true },
                                    dataView: { show: true, readOnly: false },
                                    magicType: { show: true, type: ['line', 'bar'] },
                                    restore: { show: true },
                                    saveAsImage: { show: true }
                                }
                            },
                            grid: {
                                left: '3%',
                                right: '4%',
                                bottom: '3%',
                                containLabel: true
                            },
                            xAxis: [
                                {
                                    type: 'category',
                                    boundaryGap: false,
                                    axisLine: { onZero: false },
                                    interval: 50,
                                    data: xValue,
                                }
                            ],
                            yAxis: [
                                {
                                    type: 'value',
                                    min: 0,
                                    max: macLeft,
                                    data: lary
                                }
                            ],
                            height: 250,
                            dataZoom: [{
                                type: 'slider',
                                height: 40,
                                start: 0,
                                end: 100,
                                bottom: 0
                            }],
                            color: DataColor,

                            series: DataSeriaes
                        });


                        window.onresize = pmchart.resize;
                    }

                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

    function fnGetDarkColor() {
        var allowed = "ABCDEF0123456789", S = "#";

        while (S.length < 7) {
            S += allowed.charAt(Math.floor((Math.random() * 16) + 1));
        }
        return S;
    }

