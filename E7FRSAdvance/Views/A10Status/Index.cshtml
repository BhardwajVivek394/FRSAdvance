                                height: 40,
                                start: 0,
                                end: 100,
                                bottom: 0
                            }],
                            color: DataColor,

                            series: DataSeriaes
                        });


                        window.onresize = pmchart.resize;
                    }

                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

    function fnDownLoad() {
        if ($('#hdnSearchSiteId').val() != null && $('#hdnSearchSiteId').val() != undefined && $('#hdnSearchSiteId').val() != '' && $('#hdnSearchSiteId').val() != "0") {
            if ($('#hdnA10Id').val() != null && $('#hdnA10Id').val() != undefined && $('#hdnA10Id').val() != '0') {
                window.location.href = "@Url.Action("Download", "A10Status")?siteId=" + $('#hdnSearchSiteId').val() + "&date=" + $('#searchDate').val() + "&a10Id=" + $("#hdnA10Id").val();
            } else {

                window.location.href = "@Url.Action("Download", "A10Status")?siteId=" + $('#hdnSearchSiteId').val() + "&date=" + $('#searchDate').val();
            }
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }


</script>