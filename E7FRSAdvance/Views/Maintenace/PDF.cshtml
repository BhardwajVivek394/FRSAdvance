                                        </div>
                                        <div class="col-sm-2">
                                            <a class="btn btn-success btn-quirk mt-4" onclick="fnDownloadTrueAuditAlertPDF()">Download</a>
                                        </div>

                                    </div>
                                </td>
                            </tr>
                        }


