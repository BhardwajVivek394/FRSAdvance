
@{
    ViewBag.Title = "MaintenacePDF";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Maintenace PDF</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <table class="table table-striped">
                        @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode() || (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode() && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping))
                        {
                            <tr>
                                <td>
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <h5>Download Status</h5>
                                        </div>
                                        <div class="col-sm-3">
                                            <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Date</strong>
                                            <input type="text" class="form-control" id="searchDate" />

                                        </div>
                                        <div class="col-sm-3">
                                            <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Select PDF</strong>
                                            <select class="form-control" id="drpPDF">
                                                <option value="SiteStatus">Site Status</option>
                                                <option value="RFStatus">RF Status</option>
                                                <option value="PointMachineStatus">Point Machine Status</option>
                                                <option value="PreviousDaysAlert">Previous Days Alert</option>
                                                <option value="UtilityLogsStatus">Utility Logs Status</option>
                                                <option value="Reboot">Reboot</option>
                                                <option value="SiteSummary">Site Summary</option>
                                            </select>
                                        </div>
                                        <div class="col-sm-2">
                                            <a class="btn btn-success btn-quirk mt-4" onclick="fnGeneratePDF()">Download</a>
                                        </div>

                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <h5>Download Portfolio</h5>
                                        </div>
                                        <div class="col-sm-3">
                                            <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Date</strong>
                                            <input type="text" class="form-control" id="searchPortfolioDate" />
                                        </div>
                                        <div class="col-sm-3">
                                            <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Backend Portfolio</strong>
                                            <select class="form-control" id="drpBackendPortfolioUser">
                                                @if (ViewBag.Users != null)
                                                {
                                                    <option value="">Select User</option>
                                                    var mUsers = ViewBag.Users as List<Domain.User>;
                                                    if (mUsers != null && mUsers.Count > 0)
                                                    {
                                                        foreach (var mUser in mUsers)
                                                        {
                                                            <option value="@mUser.Id">@mUser.FirstName @mUser.LastName</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="col-sm-2">
                                            <a class="btn btn-success btn-quirk mt-4" onclick="fnGeneratePortfolioCSV()">Download</a>
                                            <a class="btn btn-info btn-quirk mt-4" onclick="fnPortfolioAlertAudit()">Alert Audit</a>
                                        </div>

                                    </div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <h5>Download AI Status</h5>
                                        </div>
                                        <div class="col-sm-3">
                                            <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Select Year</strong>
                                            @Html.DropDownList("Year", ViewBag.Years as SelectList, "Select Year", new { @class = "form-control", @id = "ProbabilityYear" })
                                        </div>
                                        <div class="col-sm-3">
                                            <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Select Month</strong>
                                            @Html.DropDownList("Month", ViewBag.Months as SelectList, "Select Month", new { @class = "form-control", @id = "ProbabilityMonth" })
                                        </div>
                                        <div class="col-sm-2">
                                            <a class="btn btn-success btn-quirk mt-4" onclick="fnDownloadProbabilityStatusPDF()">Download</a>
                                            @*<a href="javascript:void(0)" onclick="fnGeneratePDF()" id="aLinkDownloadTemplate"><i class="fa fa-download"></i> Download</a>*@
                                        </div>

                                    </div>
                                </td>
                            </tr>



                            <tr>
                                <td>
                                    <div class="row">
                                        <div class="col-sm-4">
                                            <h5>Download Division PDF New</h5>
                                        </div>
                                        <div class="col-sm-2">
                                            <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Zone</strong>
                                            @Html.DropDownList("drpNewDivisionZones", ViewBag.Zones as SelectList, new { @class = "form-control" })
                                        </div>
                                        <div class="col-sm-2">
                                            <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Division</strong>
                                            @Html.DropDownList("drpNewDivisions", ViewBag.Divisions as SelectList, new { @class = "form-control" })
                                        </div>
                                        <div class="col-sm-2">
                                            <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Date</strong>
                                            <input type="text" class="form-control" id="searchNewDivisionDate" />
                                        </div>
                                        <div class="col-sm-2">
                                            <a class="btn btn-success btn-quirk mt-4" onclick="fnDownloadNewDivisionReportPDF()">Download</a>
                                            <a class="btn btn-primary btn-quirk mt-4" title="Regenerate" onclick="fnRegenerateNewDivisionReportPDF()"><i class="fa fa-refresh"></i></a>
                                            <a class="btn btn-info btn-quirk mt-4" title="Division Report Last Update Time" onclick="fnNewDivisionReportLastTime()"><i class="fa fa-clock-o"></i></a>
                                        </div>

                                    </div>
                                </td>
                            </tr>
                        }


                        <tr>
                            <td>
                                <div class="row">
                                    <div class="col-sm-4">
                                        <h5>Download Division PDF</h5>
                                    </div>
                                    <div class="col-sm-2">
                                        <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Zone</strong>
                                        @Html.DropDownList("drpDivisionZones", ViewBag.Zones as SelectList, new { @class = "form-control" })
                                    </div>
                                    <div class="col-sm-2">
                                        <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Division</strong>
                                        @Html.DropDownList("drpDivisions", ViewBag.Divisions as SelectList, new { @class = "form-control" })
                                    </div>
                                    <div class="col-sm-2">
                                        <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Date</strong>
                                        <input type="text" class="form-control" id="searchDivisionDate" />
                                    </div>
                                    <div class="col-sm-2">
                                        <a class="btn btn-success btn-quirk mt-4" onclick="fnDownloadDivisionReportPDF()">Download</a>
                                        <a class="btn btn-primary btn-quirk mt-4" title="Regenerate" onclick="fnRegenerateDivisionReportPDF()"><i class="fa fa-refresh"></i></a>
                                        <a class="btn btn-default btn-quirk mt-4" title="Regenerate Without Point Machine" onclick="fnRegenerateDivisionReportPDFWithoutPM()"><i class="fa fa-refresh"></i></a>
                                        <a class="btn btn-info btn-quirk mt-4" title="Division Report Last Update Time" onclick="fnDivisionReportLastTime()"><i class="fa fa-clock-o"></i></a>
                                    </div>

                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <div class="row">
                                    <div class="col-sm-4">
                                        <h5>Download User Report</h5>
                                    </div>
                                    <div class="col-sm-2">
                                        <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Zone</strong>
                                        @Html.DropDownList("drpUserZones", ViewBag.Zones as SelectList, new { @class = "form-control" })
                                    </div>
                                    <div class="col-sm-2">
                                        <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Division</strong>
                                        @Html.DropDownList("drpUserDivisions", ViewBag.Divisions as SelectList, new { @class = "form-control" })
                                    </div>
                                    <div class="col-sm-2">
                                        <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Date</strong>
                                        <input type="text" class="form-control" id="searchUserDivisionDate" />
                                    </div>
                                    <div class="col-sm-2">
                                        <a class="btn btn-success btn-quirk mt-4" onclick="fnDownloadUserReportPDF()">Download</a>
                                    </div>

                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td>
                                <div class="row">
                                    <div class="col-sm-4">
                                        <h5>Download Performance Report</h5>
                                    </div>
                                    <div class="col-sm-2">
                                        <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Division</strong>
                                        @Html.DropDownList("drpPerformanceDivisions", ViewBag.Divisions as SelectList, new { @class = "form-control" })
                                    </div>
                                    <div class="col-sm-2">
                                        <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Site</strong>
                                        @Html.DropDownList("PerformanceSiteId", (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 1 })
                                    </div>
                                    <div class="col-sm-2">
                                        <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Date</strong>
                                        <input type="text" class="form-control" id="searchPerformanceDate" />
                                    </div>
                                    <div class="col-sm-2">
                                        <a class="btn btn-success btn-quirk mt-4" onclick="fnDownloadPerformanceReportPDF()">Download</a>
                                    </div>

                                </div>
                            </td>
                        </tr>

                        <tr>
                            <td>
