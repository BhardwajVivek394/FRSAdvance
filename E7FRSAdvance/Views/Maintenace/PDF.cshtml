            box.style.display = "none";
            callback(true);
        };

        document.getElementById("confirmNo").onclick = function () {
            box.style.display = "none";
            callback(false);
        };
    }

    function GetNewDivisionByZone(zoneId) {
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/Site/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpNewDivisions").empty();
                    $("#drpNewDivisions").append($("<option></option>").val('0').html('Select Divison'));
                    $.each(data, function (key, value) {
                        $("#drpNewDivisions").append($("<option></option>").val(value.Id).html(value.Name));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function fnDownloadFRSAlertInstance() {
        if ($('#drpFFRSAlertInstanceSites').val() != null && $('#drpFFRSAlertInstanceSites').val() != undefined && $('#drpFFRSAlertInstanceSites').val() != '' && $('#drpFFRSAlertInstanceSites').val() != '0') {

            window.location.href = "@Url.Action("DownloadFRSAlertWithInstancePDF")?siteId=" + $('#drpFFRSAlertInstanceSites').val() + "&startdate=" + $("#searchFRSAlertInstanceFromDate").val() + "&endDate=" + $("#searchFRSAlertInstanceToDate").val();

        } else {
            CommonNotification("error", "Please select site");
        }
    }
</script>