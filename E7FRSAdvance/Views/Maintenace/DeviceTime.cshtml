@model Domain.AssetLister

@{
    ViewBag.Title = "DeviceTime";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/paho-mqtt.js"></script>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Device Time</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">
        @using (Ajax.BeginForm("_DeviceTimeDetails", "Maintenace", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divAssetDetailsList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
        }, new { id = "frmGetAssetDetails" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divAssetDetailsList">

                @Html.Action("_DeviceTimeDetails", Model)
            </div>
        }
    </div>
</div>

