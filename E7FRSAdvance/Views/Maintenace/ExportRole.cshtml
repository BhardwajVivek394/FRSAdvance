
@{
    ViewBag.Title = "ExportRole";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Export Role</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="row" style="margin-bottom:10px;margin-top:10px">
                    <div class="col-sm-12">
                        <div class="people-options clearfix" style="padding:4px">
                            <div class="pull-left">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Sites</strong>
                            </div>
                            <div class="pull-left">
                                @Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites, new { @class = "form-control", tabindex = 1 })
                            </div>
                            <div class="pull-left m-l-10 m-t-10"  >
                                @*<input type="checkbox" id="chkUpdateToWebAlso" /><label for="chkUpdateToWebAlso"></label>*@

                                <label class="control-label"><span>Update To Web Also</span>
                                 <input type="checkbox" id="chkUpdateToWebAlso" style="vertical-align:sub" /></label>
                            </div>
                            <div class="pull-right">
                                <a href="#" onclick="fnDownLoad()" id="aLinkDownloadTemplate"><i class="fa fa-download"></i> Download Template Sheet</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>

    function fnDownLoad() {
        if ($('#SiteId').val() != "0") {
            window.location.href = "@Url.Action("GetExportRole", "Maintenace")?siteId=" + $('#SiteId').val() + "&updateToWeb=" + $("#chkUpdateToWebAlso").prop('checked');
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }
</script>