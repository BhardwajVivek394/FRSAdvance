
@{
    ViewBag.Title = "SiteKeeping";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/paho-mqtt.js"></script>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>


<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Site Keeping</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-sm-12">
                            <ul class="nav nav-tabs border-tab nav-primary mb-0" id="info-tab" role="tablist">
                                <li class="nav-item active" onclick="fnGetRFStatus()"><a class="nav-link active" href="#tabRFStatus" data-bs-toggle="tab" data-bs-original-title="" title=""><strong>RF Status</strong></a></li>
                                <li class="nav-item" onclick="fnGetSiteStatus()"><a a="" class="nav-link" href="#tabSiteStatus" data-bs-toggle="tab" data-bs-original-title="" title=""><strong>Site Status</strong></a></li>
                            </ul>

                            <div class="tab-content mt-0">
                                <div class="tab-pane fade active show" id="tabRFStatus">

                                    @using (Ajax.BeginForm("_RFStatus", "Maintenace", new AjaxOptions()
                                    {
                                        HttpMethod = "POST",
                                        UpdateTargetId = "divRFStatus",
                                        InsertionMode = InsertionMode.Replace,
                                        LoadingElementId = "loader",
                                    }, new { id = "frmRFStatus" }))
                                    {
                                        { HtmlHelper.ClientValidationEnabled = false; }
                                        <div id="divRFStatus">
                                            @*@Url.Action("_RFStatus")*@
                                       
                                        </div>
                                    }
                                </div>

                                <div class="tab-pane fade" id="tabSiteStatus">
                                    @using (Ajax.BeginForm("_SiteStatus", "Maintenace", new AjaxOptions()
                                    {
                                        HttpMethod = "POST",
                                        UpdateTargetId = "divSiteStatus",
                                        InsertionMode = InsertionMode.Replace,
                                        LoadingElementId = "loader",
                                    }, new { id = "frmSiteStatus" }))
                                    {
                                        { HtmlHelper.ClientValidationEnabled = false; }
                                        <div id="divSiteStatus">
                                            @*@Url.Action("", "Maintenace")*@
                                        </div>
                                    }

                                </div>
                            </div>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>

</div>

<script>

    $(window).on("load", function () {
        $('#txtSearchTimeStamp').datepicker({
            dateFormat: 'mm/dd/yy',
            autoClose: true
        });
    });

    $(document).ready(function () {
        fnGetRFStatus()
    });

    function fnGetRFStatus() {

        $.ajax({
            url: '/Maintenace/_RFStatus',
            type: 'Post',
            contentType: 'application/json',
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divRFStatus").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnGetSiteStatus() {

        $.ajax({
            url: '/Maintenace/_SiteStatus',
            type: 'Post',
            contentType: 'application/json',
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divSiteStatus").empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }
</script>