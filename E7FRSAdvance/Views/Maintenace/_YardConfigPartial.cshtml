@model List<Domain.CardLine>

@if (Model != null && Model.Count > 0)
{
    var ClusterNameGroup = Model.GroupBy(x => x.ClusterName).ToList();

    <div class="card-body">
        <div class="table-responsive" style="max-height: 620px;">
            <table class="table">
                <thead class="bg-primary">
                    <tr>
                        <th></th>
                        <th>Cluster</th>
                    </tr>

                </thead>
                <tbody>
                    @if (ClusterNameGroup != null && ClusterNameGroup.Count > 0)
                    {
                        foreach (var clusterName in ClusterNameGroup)
                        {
                            <tr>
                                <td><i class="fa fa-plus" onclick="fnGetByClusterName('@clusterName.FirstOrDefault().ClusterId',this)"></i></td>
                                <td class="font-weight-bold">
                                    @clusterName.Key
                                </td>
                            </tr>
                            <tr class="trCluster_@clusterName.FirstOrDefault().ClusterId" style="display:none">
                                <td colspan="2">
                                    <table class="table">
                                        <thead class="bg-primary">
                                            <tr>
                                                <th></th>
                                                <th>Cluster</th>
                                                <th>Type</th>
                                                <th>Asset</th>
                                                <th>Attribute</th>
                                                <th>ADC</th>
                                                <th>Pin</th>
                                                <th>Role</th>
                                            </tr>

                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.Where(x => x.ClusterName.Trim().ToUpper() == clusterName.Key.Trim().ToUpper()).GroupBy(x => x.CardName).Select(x => x.Key).ToList())
                                            {
                                                foreach (var cardLine in Model.Where(x => x.ClusterName.Trim().ToUpper() == clusterName.Key.Trim().ToUpper() && x.CardName == item).OrderBy(x => x.Pin).ToList())
                                                {
                                                    <tr>
                                                        <td>@cardLine.Number</td>
                                                        <td>@cardLine.CardName</td>
                                                        <td>@cardLine.AssetTypeName</td>
                                                        <td><a href="#" onclick="fnGetAssetAttribute('@cardLine.AssetId','@cardLine.AssetTypeId')">@cardLine.AssetName</a></td>
                                                        <td>@cardLine.AttributeName</td>
                                                        <td>
                                                            @if (cardLine.ADCNumber != null)
                                                            {
                                                                <span>
                                                                    ADC @cardLine.SequenceNumber<br />
                                                                    (@cardLine.ADCNumber)
                                                                </span>
                                                            }

                                                        </td>
                                                        <td>@cardLine.Pin</td>
                                                        <td>@cardLine.Role</td>
                                                    </tr>
                                                }

                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>


                        }
                    }

                </tbody>
            </table>
        </div>
    </div>
}

