@model  List<Domain.DeviceINI>

<div class="modal bounceIn animated" id="modelCompareDevice" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog  modal-lg">
        <div class="modal-content bradius4">

            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader">Compare Device.INI</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <div style="height:600px; overflow-y: scroll;">
                    <table class="table">
                        <thead>
                            <tr>
                                <td>
                                </td>
                                <td>
                                    Role
                                </td>
                                <td>
                                    Address
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var sectionVal in Model.GroupBy(x => x.Section))
                                {
                                    <tr>
                                        <td>
                                            <a href="#">
                                                <i class="fa fa-plus text-vision SitesDetails" onclick="GetDeviceINIByRole('@sectionVal.Key',this)"></i>
                                            </a>
                                        </td>
                                        <td>
                                            @sectionVal.Key
                                        </td>
                                        <td>
                                            @sectionVal.FirstOrDefault().Address
                                        </td>
                                    </tr>
                                    <tr id="tr_@sectionVal.Key" style="display:none">
                                        <td colspan="3">
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th></th>
                                                        <th>
                                                            Web
                                                        </th>
                                                        <th>
                                                            Plc
                                                        </th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var item in Model.Where(x => x.Section == sectionVal.Key).ToList())
                                                    {

                                                        <tr>
                                                            <td>
                                                                @if (item.AssetInfoId > 0)
                                                                {
                                                                    <input type="checkbox" class="chkUpdateDevice" id="chkDevice_@item.Key" data-plc="@item.Value" data-assetinfoid="@item.AssetInfoId" />
                                                                }
                                                            </td>
                                                            <td>
                                                                @if (!string.IsNullOrEmpty(item.WebValue))
                                                                {
                                                                    <span>@item.Key=@item.WebValue</span>
                                                                }                                                               
                                                            </td>
                                                            <td>
                                                                <span>@item.Key=@item.Value</span>

                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>

                                            </table>
                                        </td>


                                    </tr>
                                }

                            }


                        </tbody>
                    </table>
                </div>

            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnUpdateDeviceINI()">Save</button>
            </div>
        </div>
    </div>
</div>

<script>

    function GetDeviceINIByRole(sectionVal, $this) {
        if ($($this).hasClass("fa-plus")) {
            $($this).removeClass("fa-plus").addClass("fa-minus");
            $('#tr_' + sectionVal).show();
        } else {
            $($this).removeClass("fa-minus").addClass("fa-plus");
            $('#tr_' + sectionVal).hide();
        }

    }
</script>