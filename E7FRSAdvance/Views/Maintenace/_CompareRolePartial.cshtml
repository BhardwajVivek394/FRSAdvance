@model List<Domain.CompareRoleINI>

<div class="modal bounceIn animated" id="modelCompareRole" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog  modal-lg">
        <div class="modal-content bradius4">

            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader">Compare Role</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-body">
                <div style="height:600px; overflow-y: scroll;">
                    <table class="table">
                        <thead>
                            <tr>
                                <td></td>
                                <td>
                                    Role
                                </td>
                                <td>
                                    Web
                                </td>
                                <td>
                                    Plc
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.Web))
                                            {
                                                <input type="checkbox" class="chkUpdateRole" id="chk_@item.Role" value="@item.Role" data-plc="@item.Plc" />
                                            }
                                        </td>
                                        <td>
                                            @item.Role
                                        </td>
                                        <td>
                                            @item.Web
                                        </td>
                                        <td>
                                            @item.Plc
                                        </td>
                                    </tr>
                                }

                            }


                        </tbody>
                    </table>
                </div>

            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnUpdateRole()">Save</button>
            </div>
        </div>
    </div>
</div>