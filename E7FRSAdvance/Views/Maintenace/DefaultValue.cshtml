
@{
    ViewBag.Title = "DefaultValue";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Default Value</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="pull-left">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Sites</strong>
                            </div>
                            <div class="pull-left">
                                @Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 1 })
                            </div>
                            <div class="pull-left">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Asset Type</strong>
                            </div>
                            <div class="pull-left">
                                <select id="AssetTypeId" class="form-control" onchange="GetAssetTypeById(this)">
                                    <option>Select Asset Type</option>
                                </select>
                            </div>
                            <div class="pull-left m-l-10" id="divIsMapRG" style="display:none">
                                <input type="checkbox" id="chkIsMapRG">
                                <label for="chkIsMapRG">Is Map RG</label>
                            </div>
                            <div class="pull-left m-l-10">
                                <button type="button" class="btn btn-success" onclick="fnSaveAssetShowModel()">Apply</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    @{
                        var enumAttriuteType = (from E7FRSAdvance.Utility.Utility.AttributeType e in Enum.GetValues(typeof(E7FRSAdvance.Utility.Utility.AttributeType))
                                                select new
                                                {
                                                    Id = (int)e,
                                                    Name = e.ToString().Replace("_", " ")
                                                }).ToList();
                    }

                    <div id="divAttributeType" style="display:none">
                        @foreach (var enumAttriute in enumAttriuteType)
                        {
                            <div class="form-check">
                                <input class="form-check-input chkAttributeType" id="chkAttributeType@(enumAttriute.Id)" data-id="@enumAttriute.Id" type="checkbox" onchange="fnChangeAttributeType()">

                                <label class="form-check-label" for="chkAttributeType@(enumAttriute.Id)">@enumAttriute.Name</label>
                            </div>
                        }
                    </div>
                  
                    <div id="divAddAsset">

                        @Html.Partial("_AddAssetPartial", new Domain.Asset())
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>


<div class="modal bounceIn animated" id="modelConfirmDefaultValue" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modalConfirm-dialog">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spHeader">Confirm Default Value</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>

            </div>
            <div class="modal-footer">
                <button type="button" id="btnOverride" class="btn btn-primary ls-1-2" onclick="fnSaveAsset(true)">Override</button>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSaveAsset(false)">Blank</button>
            </div>
        </div>
    </div>
</div>

<script>
    var signalType = '@E7FRSAdvance.Utility.Utility.AssetType.SIGNAL.GetHashCode()';
    $(document).ready(function () {

        $("#SiteId").change(function () {
            if ($(this).val() != null && $(this).val() != undefined && $(this).val() != '' && $(this).val() != "0") {
                $("#loader").show();
                $.ajax({
                    url: '/Maintenace/GetAssetTypeBySiteId',
                    type: 'POST',
                    data: '{siteId:' + $(this).val() + '}',

                    contentType: 'application/json',
                    success: function (data) {
                        $("#loader").hide();
                        $("#AssetTypeId").empty();
                        $("#AssetTypeId").append($("<option></option>").val('0').html('Select Asset Type'));
                        $.each(data, function (key, value) {
                            //if ($('#hdnSearchDivisionId').val() != '0' && $('#hdnSearchDivisionId').val() == value.Id) {
                            //    $("#divisions").append($("<option selected></option>").val(value.Id).html(value.Name));
                            //} else {
                            //    $("#divisions").append($("<option></option>").val(value.Id).html(value.Name));
                            //}

                            $("#AssetTypeId").append($("<option></option>").val(value.Id).html(value.Name));
                        });
                    },
                    error: function (response) {
                        $("#loader").hide();
                        CommonNotification("ERROR", "Something went wrong!", "Error");
                    }
                });
            }

        });

    });

    function fnChangeAttributeType() {

        GetAssetTypeById($('#AssetTypeId'));
    }

    function GetAssetTypeById($this) {
        $("#loader").show();
        if ($($this).val() == '2') {
            $('#divIsMapRG').show();
        }
        else {
            $('#divIsMapRG').hide();
            $('#chkIsMapRG').removeAttr('checked');
        }


        if ($('#SiteId').val() != null && $('#SiteId').val() != undefined && $('#SiteId').val() != '' && $('#SiteId').val() != "0") {
            var typeIds = [];
            var mSearchCriteria = {};
            mSearchCriteria.AssetTypeId = $($this).val();
            mSearchCriteria.SiteId = $("#SiteId").val();

            if (mSearchCriteria.AssetTypeId == signalType) {
                $('#divAttributeType').show();
            } else {
                $('#divAttributeType').hide();
            }
            $('.chkAttributeType').each(function () {
                if (mSearchCriteria.AssetTypeId == signalType) {
                    if ($(this).prop('checked') == true) {
                        typeIds.push($(this).data('id'));
                    }
                } else {
                    $(this).prop('checked', false);
                }
                
            });
            debugger;
            mSearchCriteria.AssetTypeIds = typeIds;

            $.ajax({
                url: '/Maintenace/GetAssetById',
                type: 'Post',
              //  data: '{assetTypeId:' + $($this).val() + ',siteId:' + $("#SiteId").val() + '}',
                data: '{searchCriteria:' + JSON.stringify(mSearchCriteria) + '}',
                dataType: 'html',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#divAddAsset").empty().append(data);
                    //$("#modal-add-assetType").modal('show');
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

    function fnSaveAssetShowModel() {

        if ($("#SiteId").val() == null || $("#SiteId").val() == undefined || $("#SiteId").val() == '' || $("#SiteId").val() == "0") {
            CommonNotification("ERROR", "Please select Site", "error");
        }
        else if ($("#AssetTypeId").val() == null || $("#AssetTypeId").val() == undefined || $("#AssetTypeId").val() == '' || $("#AssetTypeId").val() == "0") {
            CommonNotification("ERROR", "Please select Asset Type", "error");
        }
        else {

            $("#modelConfirmDefaultValue").modal("show");
        }
    }
</script>