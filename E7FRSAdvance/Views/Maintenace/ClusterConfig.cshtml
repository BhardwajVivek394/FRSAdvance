

@{
    ViewBag.Title = "ClusterConfig";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Cluster Config</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <div class="card">
                <div class="card-header">
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="pull-left">
                                <strong style="margin-top:10px;margin-right:10px;margin-left:10px;">Sites</strong>
                            </div>
                            <div class="pull-left">
                                @*@Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites,"Select", new { @class = "form-control", tabindex = 1 })*@
                                @if (ViewBag.Sites != null)
                                {
                                    <select class="form-control" id="SiteId">
                                        <option value="0">Select</option>
                                        @foreach (var item in ViewBag.Sites as List<Domain.Site>)
                                        {
                                            <option value="@item.Id" data-ModemType="@item.ModemType">@item.Name</option>
                                        }
                                    </select>
                                }
                            </div>
                            <div class="pull-left m-l-10">
                                <button type="button" class="btn btn-success" onclick="CreateClusterConfig()">Apply</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body vh-100" style="overflow: hidden;">
                    <div class="table-responsive" style="height: 100%; overflow-y: scroll;">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Cluster</th>
                                    <th>Param</th>
                                    <th id="MqttPath" style="display:none;">MQTT Path</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyCluster"></tbody>
                        </table>
                    </div>



                </div>
            </div>
        </div>
    </div>

</div>

<script>
    var modemTypeDual = '@E7FRSAdvance.Utility.Utility.ModemType.Dual.GetHashCode()';

    $(document).ready(function () {
        $("#SiteId").change(function () {
            var siteId = $(this).val();

            if (siteId != null && siteId != undefined && siteId != '' && siteId != "0") {
                $("#loader").show();
                $.ajax({
                    url: '/Maintenace/GetCluster',
                    type: 'Post',
                    data: '{siteId:' + siteId + '}',
                    contentType: 'application/json',
                    success: function (data) {
                        $("#loader").hide();
                        var val = '';
                        if (data != null && data != undefined && data != '') {
                            var isdualModal = $("#SiteId").find(":selected").attr('data-ModemType');
                            if (isdualModal == modemTypeDual) {
                                $.each(data, function (key, value) {
                                    val += "<tr>";
                                    val += "<td>" + value + "</td>";
                                    val += "<td><input type='number' class='form-control txtParam' id='txt_" + value + "' /></td>"
                                    val += "<td><input type='text' class='form-control' id='txtMqtt_" + value + "' /></td>"
                                    val += "</tr>";
                                });
                                $("#MqttPath").show();
                            }
                            else {
                                $.each(data, function (key, value) {
                                    val += "<tr>";
                                    val += "<td>" + value + "</td>";
                                    val += "<td><input type='number' class='form-control txtParam' id='txt_" + value + "' /></td>"
                                    val += "</tr>";
                                });
                                $("#MqttPath").hide();
                            }
                            $("#tbodyCluster").empty().append(val);
                            GetClusterConfig(siteId);

                        }


                    },
                    error: function (response) {
                        $("#loader").hide();
                        CommonNotification("ERROR", "Something went wrong!", "Error");
                    }
                });
            } else {
                $("#tbodyCluster").empty();
            }

        });

    });

    function CreateClusterConfig() {
        if ($("#SiteId").val() != null && $("#SiteId").val() != undefined && $("#SiteId").val() != '0') {
            if ($('#tbodyCluster > tr').length > 0) {

                var value = $('.txtParam').filter(function () {
                    return this.value != '';
                });
                if (value.length > 0) {
                    if (confirm('Are you sure you want to update this param value?')) {
                        var i = 0;
                        $("#loader").show();
                        $('#tbodyCluster > tr').each(function () {
                            var mClusterConfig = {};
                            mClusterConfig.SiteId = $("#SiteId").val();
                            mClusterConfig.ClusterName = $(this).find("td").eq(0).html();
                            mClusterConfig.Param = $(this).find("td").eq(1).children("input").val();
                            mClusterConfig.MqttPath = $(this).find("td").eq(2).children("input").val();
                            if (mClusterConfig.ClusterName != null && mClusterConfig.Param != null && mClusterConfig.ClusterName != undefined && mClusterConfig.Param != undefined && mClusterConfig.ClusterName != '' && mClusterConfig.Param != '') {

                                $.ajax({
                                    url: '/Maintenace/CreateClusterConfig',
                                    type: 'Post',
                                    data: '{mClusterConfig:' + JSON.stringify(mClusterConfig) + '}',
                                    contentType: 'application/json',
                                    success: function (data) {
                                        i++;
                                        if (i == value.length) {
                                            $("#loader").hide();
                                            CommonNotification("SUCCESS", "Param add in cluster.", "success");
                                        }
                                    },
                                    error: function (response) {
                                        $("#loader").hide();
                                        CommonNotification("ERROR", "Something went wrong!", "Error");
                                    }
                                });
                            }



                        });
                    }

                } else {
                    CommonNotification("ERROR", "Enter param value", "Error");
                }

            } else {
                CommonNotification("ERROR", "Cluster not found", "Error");

            }

        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }

    }

    function GetClusterConfig(siteId) {

        $.ajax({
            url: '/Maintenace/GetClusterConfig',
            type: 'Post',
            data: '{siteId:' + siteId + '}',
            contentType: 'application/json',
            success: function (data) {
                if (data != null && data != undefined && data != '') {
                    $.each(data, function (key, value) {
                        $('#txt_' + value.ClusterName).val(value.Param);
                        $('#txtMqtt_' + value.ClusterName).val(value.MqttPath);
                    });
                }

            },
            error: function (response) {
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });

        return null;
    }
</script>
