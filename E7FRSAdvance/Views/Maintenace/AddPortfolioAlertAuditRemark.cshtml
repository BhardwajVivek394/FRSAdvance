@model Domain.AlertAudit

<div class="modal bounceIn animated" id="modalPortfolioAlertRemark" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                @if (Model != null && Model.Id > 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span>Portfolio Remark - @Model.Site</span></h4>
                }
                else
                {
                    <h4 class="modal-title" id="myModalLabel"><span>Portfolio Remark</span></h4>
                }

                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <label>Remark</label>
                        @Html.TextAreaFor(x => x.PortfolioRemark, new { @class = "form-control", @id = "txtPortfolioRemark" })
                    </div>
                    <div class="col-12">
                        <label>Status</label>
                        <select class="form-control" id="drpAlertAuditStatus">
                            @if (Model.IsOpenClose)
                            {
                                <option value="Open" selected>Open</option>
                                <option value="Close">Close</option>
                            }
                            else
                            {
                                <option value="Open">Open</option>
                                <option value="Close" selected>Close</option>
                            }

                        </select>

                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-success" type="button" onclick="fnUpdatePortfolioAlertAudit('@Model.Id')">Save</button>
                <button class="btn btn-default" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


