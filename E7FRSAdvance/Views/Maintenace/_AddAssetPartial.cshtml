@model Domain.Asset

<div class="col-sm-12">
    <input type="hidden" id="hdnName" value="@Model.AssetTypeName" />
    @Html.HiddenFor(m => Model.Id, new { @id = "hdnAssetId" })
    @Html.HiddenFor(m => Model.AssetTypeId, new { @id = "hdnAssetTypeId1" })
    @Html.HiddenFor(m => Model.SiteId, new { @id = "hdnSiteId1" })


    @if (Model.AssetTypeId == 3)
    {
        <div class="profile-right-body mt10">

            <ul class="nav nav-tabs border-tab nav-primary" id="info-tab" role="tablist">
                <li class="nav-item active">
                    <a class="nav-link active" href="#Config" data-bs-toggle="tab" role="tab" aria-controls="Numbers" aria-selected="true" data-bs-original-title="" title="">
                        <strong>Config</strong>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#Alerts" data-bs-toggle="tab" role="tab" aria-controls="Alerts" aria-selected="true" data-bs-original-title="" title=""><strong>Alerts</strong></a>
                </li>
                <li class="nav-item" style="display:none;">
                    <a class="nav-link" href="#AlertsSeries" data-bs-toggle="tab" role="tab" aria-controls="AlertsSeriess" aria-selected="true" data-bs-original-title="" title=""><strong>Series Alerts</strong></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#VibrationAlerts" data-bs-toggle="tab" role="tab" aria-controls="VibrationAlerts" aria-selected="true" data-bs-original-title="" title=""><strong>Vibration Alerts</strong></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#FRSAlerts" data-bs-toggle="tab" role="tab" aria-controls="FRSAlertsConfig" aria-selected="true" data-bs-original-title="" title=""><strong>FRS Alerts</strong></a>
                </li>

            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div class="tab-pane fade active show" id="Config" style="padding:0px">
                    <div class="table-responsive" style="max-height: 600px;">
                        <table class="table mt20">
                            <thead>
                                <tr>
                                    <th>Attributes</th>
                                    <th>Channels</th>
                                    <th>Value</th>
                                    <th>Multiplication</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyAttr">
                                @if (Model.assetAttributes != null && Model.assetAttributes.Count > 0)
                                {
                                    foreach (var item in Model.assetAttributes)
                                    {
                                        <tr>
                                            <td style="vertical-align:middle">
                                                @item.Title
                                                <input type="text" class="form-control" value="@item.HttpPostName" disabled />
                                            </td>
                                            <td style="vertical-align:middle">
                                                @if (item.Title == "Name" || item.Title == "Widget#")
                                                {
                                                    <select class="form-control drpChannel" id="channel@(item.Id)" disabled>
                                                        <option value="">Select Channel</option>
                                                    </select>
                                                }
                                                else
                                                {
                                                    <select class="form-control drpChannel" id="channel@(item.Id)" disabled>
                                                        <option value="">Select Channel</option>
                                                        @for (int i = 1; i <= Model.MQTTNoOfChannels; i++)
                                                        {
                                                            string channel = "Channel" + i;
                                                            if (item.AssetInfoChannel != null && item.AssetInfoChannel == channel)
                                                            {
                                                                <option value="Channel@(i)" selected>Channel @i</option>
                                                            }
                                                            else
                                                            {
                                                                <option value="Channel@(i)">Channel @i</option>
                                                            }
                                                        }
                                                    </select>
                                                }
                                            </td>
                                            <td>
                                                @if (item.AssetInfoValue != null && item.AssetInfoValue != "")
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" value="@item.AssetInfoValue" disabled />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" disabled />
                                                }
                                            </td>
                                            <td>


                                                @if (item.DefaultMultiplication.HasValue && item.DefaultMultiplication.Value > 0)
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control multiplication" value="@item.DefaultMultiplication.Value" />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control multiplication" />
                                                }
                                            </td>

                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            No record found!
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="Alerts" style="padding:0px;margin-top:20px;">
                    <div class="table-responsive" style="max-height: 600px;">
                        <table class="table mt20">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Alert Name</th>
                                    <th>Operators</th>
                                    <th>Value</th>
                                    <th>Thick Wave Value</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyOperators">
                                @if (Model.mAlerts != null && Model.mAlerts.Count > 0)
                                {
                                    foreach (var item in Model.mAlerts.Where(x => x.AlertType != null && x.AlertType == "Parallel").ToList())
                                    {
                                        if (item.AlertName == "Over Current")
                                        {
                                            item.AlertValue = "3";
                                            item.AlertThickWaveValue = "4";
                                            item.OperatorId = 4;
                                        }
                                        else if (item.AlertName == "Under Voltage")
                                        {
                                            item.AlertValue = "90";
                                            item.AlertThickWaveValue = "90";
                                            item.OperatorId = 2;
                                        }
                                        else if (item.AlertName == "Operating Time")
                                        {
                                            item.AlertValue = "4000";
                                            item.AlertThickWaveValue = "5000";
                                            item.OperatorId = 4;
                                        }
                                        else if (item.AlertName == "Under Current")
                                        {
                                            item.AlertValue = "0.8";
                                            item.AlertThickWaveValue = "0.8";
                                            item.OperatorId = 2;
                                        }
                                        else if (item.AlertName == "Fail")
                                        {
                                            item.AlertValue = "1.2";
                                            item.AlertThickWaveValue = "1.2";
                                            item.OperatorId = 4;
                                        }
                                        else if (item.AlertName == "Increase In Average Current")
                                        {
                                            item.AlertValue = "20";
                                            item.AlertThickWaveValue = "20";
                                            item.OperatorId = 4;
                                        }
                                        else if (item.AlertName == "Increase in time of operation")
                                        {
                                            item.AlertValue = "20";
                                            item.AlertThickWaveValue = "20";
                                            item.OperatorId = 4;
                                        }
                                        else if (item.AlertName == "Detection Voltage")
                                        {
                                            item.AlertValue = "2";
                                            item.AlertThickWaveValue = "2";
                                            item.OperatorId = 2;
                                        }
                                        else if (item.AlertName == "Signature")
                                        {
                                            item.AlertValue = "2";
                                            item.AlertThickWaveValue = "2";
                                            item.OperatorId = 4;
                                        }

                                        <tr>
                                            <td style="vertical-align:middle">
                                                @if (item.IsActive)
                                                {
                                                    <input style="cursor:pointer;vertical-align:sub" class="chkAlert" type="checkbox" data-id="@item.Id" id="chkAlert('@item.Id')" checked />
                                                }
                                                else
                                                {
                                                    <input style="cursor:pointer;vertical-align:sub" class="chkAlert" type="checkbox" data-id="@item.Id" id="chkAlert('@item.Id')" checked />
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.AlertName))
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" value="@item.AlertName" readonly />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" readonly />
                                                }
                                            </td>
                                            <td style="vertical-align:middle">
                                                <select class="form-control drpOperators" id="operators@(item.Id)">
                                                    <option value="">Select Operator</option>
                                                    @foreach (var operators in Model.mOperators)
                                                    {
                                                        if (item.OperatorId == operators.Id)
                                                        {
                                                            <option value="@operators.Id" selected>@operators.Value</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@operators.Id">@operators.Value</option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                            <td style="width:100px">
                                                @if (!string.IsNullOrEmpty(item.AlertValue))
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" value="@item.AlertValue" />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" />
                                                }
                                            </td>
                                            <td style="width:100px">
                                                @if (!string.IsNullOrEmpty(item.AlertThickWaveValue))
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" value="@item.AlertThickWaveValue" />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" />
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            No record found!
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="AlertsSeries" style="padding:0px;margin-top:20px;">
                    <div class="table-responsive" style="max-height: 600px;">
                        <table class="table mt20">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Alert Name</th>
                                    <th>Operators</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyOperators">
                                @if (Model.mAlerts != null && Model.mAlerts.Count > 0)
                                {
                                    foreach (var item in Model.mAlerts.Where(x => x.AlertType != null && x.AlertType == "Series").ToList())
                                    {
                                        <tr>
                                            <td style="vertical-align:middle">
                                                @if (item.IsActive)
                                                {
                                                    <input style="cursor:pointer;vertical-align:sub" class="chkAlert" type="checkbox" data-id="@item.Id" id="chkAlert('@item.Id')" checked />
                                                }
                                                else
                                                {
                                                    <input style="cursor:pointer;vertical-align:sub" class="chkAlert" type="checkbox" data-id="@item.Id" id="chkAlert('@item.Id')" />
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.AlertName))
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" value="@item.AlertName" readonly />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" readonly />
                                                }
                                            </td>
                                            <td style="vertical-align:middle">
                                                <select class="form-control drpOperators" id="operators@(item.Id)">
                                                    <option value="">Select Operator</option>
                                                    @foreach (var operators in Model.mOperators)
                                                    {
                                                        if (item.OperatorId == operators.Id)
                                                        {
                                                            <option value="@operators.Id" selected>@operators.Value</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@operators.Id">@operators.Value</option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                            <td style="width:100px">
                                                @if (!string.IsNullOrEmpty(item.AlertValue))
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" value="@item.AlertValue" />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" />
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            No record found!
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="VibrationAlerts" style="padding:0px;margin-top:20px;">
                    <div class="table-responsive vh-100">
                        <table class="table mt20">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Alert Name</th>
                                    <th>Operators</th>
                                    <th>Min A</th>
                                    <th>Max A</th>
                                    <th>Min B</th>
                                    <th>Max B</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyVibrationOperators">
                                @if (Model.mAlerts != null && Model.mAlerts.Count > 0)
                                {
                                    foreach (var item in Model.mAlerts.Where(x => x.AlertType != null && x.AlertType == "Vibration").ToList())
                                    {
                                        <tr>
                                            <td style="vertical-align:middle">
                                                @if (item.IsActive)
                                                {
                                                    <input style="cursor:pointer;vertical-align:sub" class="chkAlert" type="checkbox" data-id="@item.Id" id="chkAlert('@item.Id')" checked />
                                                }
                                                else
                                                {
                                                    <input style="cursor:pointer;vertical-align:sub" class="chkAlert" type="checkbox" data-id="@item.Id" id="chkAlert('@item.Id')" />
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(item.AlertName))
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" value="@item.AlertName" readonly />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" readonly />
                                                }
                                            </td>
                                            <td style="vertical-align:middle">
                                                <select class="form-control drpOperators" id="operators@(item.Id)">
                                                    <option value="">Select Operator</option>
                                                    @foreach (var operators in Model.mOperators)
                                                    {
                                                        if (item.OperatorId == operators.Id)
                                                        {
                                                            <option value="@operators.Id" selected>@operators.Value</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@operators.Id">@operators.Value</option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                            <td style="width:100px">
                                                @if (!string.IsNullOrEmpty(item.AlertValue))
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" value="@item.AlertValue" />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" />
                                                }
                                            </td>
                                            <td style="width:100px">
                                                @if (!string.IsNullOrEmpty(item.MaxValueA))
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" value="@item.MaxValueA" />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" />
                                                }
                                            </td>
                                            <td style="width:100px">
                                                @if (!string.IsNullOrEmpty(item.AlertValueB))
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" value="@item.AlertValueB" />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" />
                                                }
                                            </td>
                                            <td style="width:100px">
                                                @if (!string.IsNullOrEmpty(item.MaxValueB))
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" value="@item.MaxValueB" />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" />
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center">
                                            No record found!
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>


                <div class="tab-pane fade" id="FRSAlerts" style="padding:0px;margin-top:20px;">
                    <div class="table-responsive vh-100">
                        <table class="table mt20">
                            <thead>
                                <tr>
                                    <th>ATTRIBUTES</th>
                                    <th>Max Safe Value</th>
                                    <th>Average Value</th>
                                    <th>Min Safe Value</th>
                                    <th>Min Fail Value</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyFRSAlert">
                                @if (ViewBag.AssetAttributes != null)
                                {
                                    var assetAttributes = ViewBag.AssetAttributes as List<Domain.AssetAttribute>;
                                    foreach (var item in assetAttributes)
                                    {
                                        string MaxSafeValue = string.Empty;
                                        string AverageValue = string.Empty;
                                        string MinSafeValue = string.Empty;
                                        string MinFailValue = string.Empty;

                                        if (item.Title == "A End - NWKR" || item.Title == "B End - NWKR")
                                        {
                                            MaxSafeValue = "";
                                            AverageValue = "24";
                                            MinSafeValue = "20";
                                            MinFailValue = "18";
                                        }
                                        else if (item.Title == "A End - RWKR" || item.Title == "B End - RWKR")
                                        {
                                            MaxSafeValue = "";
                                            AverageValue = "24";
                                            MinSafeValue = "20";
                                            MinFailValue = "18";
                                        }
                                        else if (item.Title == "A End - NW-V" || item.Title == "B End - NW-V")
                                        {
                                            MaxSafeValue = "";
                                            AverageValue = "110";
                                            MinSafeValue = "90";
                                            MinFailValue = "80";
                                        }
                                        else if (item.Title == "A End - RW-V" || item.Title == "B End - RW-V")
                                        {
                                            MaxSafeValue = "";
                                            AverageValue = "110";
                                            MinSafeValue = "90";
                                            MinFailValue = "80";
                                        }
                                        else if (item.Title == "A End - NW-C" || item.Title == "B End - NW-C")
                                        {
                                            MaxSafeValue = "4.5";
                                            AverageValue = "2";
                                            MinSafeValue = "1.2";
                                            MinFailValue = "0.8";
                                        }
                                        else if (item.Title == "A End - RW-C" || item.Title == "B End - RW-C")
                                        {
                                            MaxSafeValue = "4.5";
                                            AverageValue = "2";
                                            MinSafeValue = "1.2";
                                            MinFailValue = "0.8";
                                        }
                                        else if (item.Title == "A End - NW-T" || item.Title == "B End - NW-T")
                                        {
                                            MaxSafeValue = "9";
                                            AverageValue = "6";
                                            MinSafeValue = "3";
                                            MinFailValue = "";
                                        }
                                        else if (item.Title == "A End - RW-T" || item.Title == "B End - RW-T")
                                        {
                                            MaxSafeValue = "9";
                                            AverageValue = "6";
                                            MinSafeValue = "3";
                                            MinFailValue = "";
                                        }
                                        else if (item.Title == "A End - NWKR (Loc)" || item.Title == "B End - NWKR (Loc)")
                                        {
                                            MaxSafeValue = "";
                                            AverageValue = "28.8";
                                            MinSafeValue = "23";
                                            MinFailValue = "21.6";
                                        }
                                        else if (item.Title == "A End - RWKR (Loc)" || item.Title == "B End - RWKR (Loc)")
                                        {
                                            MaxSafeValue = "";
                                            AverageValue = "28.8";
                                            MinSafeValue = "23";
                                            MinFailValue = "21.6";
                                        }
                                        <tr>
                                            <td>
                                                <input type="hidden" value="@item.Id" />
                                                @item.Title
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@MaxSafeValue" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@AverageValue" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@MinSafeValue" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@MinFailValue" />
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center">
                                            No record found!
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    }
    else if (Model.AssetTypeId == 2)
    {
        <div class="profile-right-body mt20">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs border-tab nav-primary" id="info-tab" role="tablist">
                <li class="nav-item active"><a class="nav-link" href="#Config" data-bs-toggle="tab"><strong>Config</strong></a></li>
                <li class="nav-item"><a class="nav-link" href="#Alerts" data-bs-toggle="tab"><strong>Alerts</strong></a></li>
                <li class="nav-item"><a class="nav-link" href="#DefaultConfig" data-bs-toggle="tab"><strong>Default Config</strong></a></li>
                <li class="nav-item"><a class="nav-link" href="#FRSAlerts" data-bs-toggle="tab"><strong>FRS Alerts</strong></a></li>

            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div class="tab-pane fade active show" id="Config" style="padding:0px;margin-top:20px;">
                    <div class="table-responsive mt10" style="max-height: 550px;" id="tblSignal">
                        <table class="table mt20">
                            <thead>
                                <tr>
                                    <th>ATTRIBUTES</th>
                                    <th>CHANNELS</th>
                                    <th>VALUE</th>
                                    <th>MULTIPLICATION</th>
                                    <th style="display:none"></th>
                                </tr>
                            </thead>
                            <tbody id="tbodySignalAttr">
                                @if (Model.assetAttributes != null && Model.assetAttributes.Count > 0)
                                {
                                    foreach (var item in Model.assetAttributes)
                                    {
                                        <tr>
                                            <td style="vertical-align:middle">@item.Title  <input type="text" class="form-control" value="@item.HttpPostName" disabled /></td>
                                            <td style="vertical-align:middle">
                                                <select class="form-control drpChannel" id="channel@(item.Id)" disabled>
                                                    <option value="">Select Channel</option>
                                                    @for (int i = 1; i <= Model.MQTTNoOfChannels; i++)
                                                    {
                                                        string channel = "Channel" + i;
                                                        if (item.AssetInfoChannel != null && item.AssetInfoChannel == channel)
                                                        {
                                                            <option value="Channel@(i)" selected>Channel @i</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="Channel@(i)">Channel @i</option>
                                                        }
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                @if (item.AssetInfoValue != null && item.AssetInfoValue != "")
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" value="@item.AssetInfoValue" disabled />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" disabled />
                                                }
                                            </td>
                                            <td>

                                                @if (item.DefaultMultiplication != null && item.DefaultMultiplication != null)
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" value="@item.DefaultMultiplication" />
                                                }
                                                else
                                                {
                                                    <input type="text" data-id="@item.Id" class="form-control" />
                                                }

                                            </td>
                                            <td style="display:none"></td>
                                        </tr>
                                    }
                                }

                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade " id="Alerts" style="padding:0px;margin-top:20px;">
                    <div class="table-responsive" style="max-height: 600px;">
                        <table class="table mt20">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Alert Name</th>
                                    <th>Operators</th>
                                    <th>Value</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyOperators">
                                @if (Model.mAlerts != null && Model.mAlerts.Count > 0)
                                {
                                    foreach (var item in Model.mAlerts)
                                    {
