                    assetInfo.AverageValue = $(this).find("td").eq(2).children("input").val();
                    assetInfo.MinSafeValue = $(this).find("td").eq(3).children("input").val();
                    assetInfo.MinFailValue = $(this).find("td").eq(4).children("input").val();
                    if (assetInfo.MaxSafeValue == '' && assetInfo.AverageValue == '' && assetInfo.MinSafeValue == '' && assetInfo.MinFailValue == '') {

                    } else {
