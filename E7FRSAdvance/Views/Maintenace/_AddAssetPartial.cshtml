                                        else if (item.Title == "VTC RELAY END")
                                        {
                                            MaxSafeValue = "";
                                            AverageValue = "";
                                            MinSafeValue = "";
                                            MinFailValue = "";
                                        }
                                        else if (item.Title == "Ir mA")
                                        {
                                            MaxSafeValue = "400";
                                            AverageValue = "350";
                                            MinSafeValue = "210";
                                            MinFailValue = "200";
                                        }
                                        else if (item.Title == "Vr")
                                        {
                                            MaxSafeValue = "4.2";
                                            AverageValue = "3.5";
                                            MinSafeValue = "2.1";
                                            MinFailValue = "";
                                        }
                                        else if (item.Title == "TR V (Relay)")
                                        {
                                            MaxSafeValue = "4.2";
                                            AverageValue = "3.5";
                                            MinSafeValue = "2.1";
                                            MinFailValue = "";
                                        }
                                        else if (item.Title == "TPR V (Loc)")
                                        {
                                            MaxSafeValue = "";
                                            AverageValue = "25";
                                            MinSafeValue = "23";
                                            MinFailValue = "21";
                                        }
                                        <tr>
                                            <td>
                                                <input type="hidden" value="@item.Id" />
                                                @item.Title
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@MaxSafeValue" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@AverageValue" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@MinSafeValue" />
                                            </td>
                                            <td>
                                                <input type="text" class="form-control" value="@MinFailValue" />
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center">
                                            No record found!
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    }



