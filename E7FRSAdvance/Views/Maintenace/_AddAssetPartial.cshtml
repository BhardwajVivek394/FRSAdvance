            }
            if ($('#refVal').length) {
                Asset.ReferenceValue = $("#txtReferenceValue").val();
            }

            if ($("#hdnName").val().toLowerCase().trim() == "signal".toLowerCase().trim()) {

                var AssetInfos = [];
