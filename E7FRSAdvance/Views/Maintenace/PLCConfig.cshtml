    function fnUpdateADCType(cardLineId) {
        if ($('#SiteId').val() != null && $('#SiteId').val() != undefined && $('#SiteId').val() != '' && $('#SiteId').val() != "0") {

            if (cardLineId != null && cardLineId != undefined && cardLineId != '') {
                if (confirm('Are you sure you want to Update ADC Type?')) {
                    $("#loader").show();
                    var mCardLine = {};
                    mCardLine.SiteId = $('#SiteId').val();
                    mCardLine.Id = cardLineId;
                    mCardLine.ADCId = $('#drpChangeADCType' + cardLineId).val();

                    $.ajax({
                        url: '/Maintenace/UpdateADCType',
                        data: '{mCardLine:' + JSON.stringify(mCardLine) + '}',
                        contentType: 'application/json',
                        type: 'POST',
                        success: function (data) {
                            $("#loader").hide();
                            if (data != null && data != undefined && data.type == 'success') {
                                alert(data.result);
                            }
                            else {
                                alert(data.result);
                            }
                        },
                        error: function (response) {
                            $("#loader").hide();
                            alert("Something went wrong!");
                        }
                    });
                }
            }


        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

