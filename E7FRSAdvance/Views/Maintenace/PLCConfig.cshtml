    function fnConfirmDeviceTime() {
        $("#modelConfirmDeviceTime").modal("show");
    }

    function fnCreateDeviceTime(isOverride) {
        if ($('#SiteId').val() != null && $('#SiteId').val() != undefined && $('#SiteId').val() != '' && $('#SiteId').val() != "0") {
            var value = $('#roles_hidden_field').val();
            if (value != null && value != '' && value != undefined) {
                if (confirm('Are you sure you want to create device time asset')) {
                    value = JSON.parse(value);

                    var mDeviceTime = {
                        SiteId: $('#SiteId').val(),
                        IsOverride: isOverride,
                        Roles: value
                    };

                    $("#loader").show();
                    $.ajax({
                        url: '/Maintenace/CreateDeviceTime',
                        type: 'Post',
                        //data: '{siteId:' + $('#SiteId').val() + ',isOverride:' + isOverride + '}',
                        data: JSON.stringify(mDeviceTime),
                        contentType: 'application/json',
                        success: function (data) {
                            $("#modelConfirmDeviceTime").modal("hide");
                            $("#loader").hide();
                            if (data != null && data != undefined && data.type != null && data.type == 'success') {
                                CommonNotification("SUCCESS", "DeviceTime is Create", "success");
                            }
                            else {
                                CommonNotification("ERROR", "internal server error.", "Error");
                            }
                        },
                        error: function (response) {
                            $("#loader").hide();
                            $("#modelConfirmDeviceTime").modal("hide");
                            CommonNotification("ERROR", "Something went wrong!", "Error");
                        }
                    });
                }
            } else {
                CommonNotification("ERROR", "Please select roles.ini file", "Error");
            }

        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

    function fnCompareRoleINI($this) {
        $("#loader").show();
        if ($('#SiteId').val() != null && $('#SiteId').val() != undefined && $('#SiteId').val() != '' && $('#SiteId').val() != "0") {
            var fileUpload = $($this).get(0);
            var files = fileUpload.files;
            var fileData = new FormData();
            fileData.append("siteId", $('#SiteId').val());
            fileData.append(files[0].name, files[0]);
            $.ajax({
                url: "/Maintenace/CompareRoleINI",
                type: "POST",
                contentType: false,
                processData: false,
                data: fileData,
                async: true,
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data != undefined && data != '') {
                        $("#divCompareRoleList").empty().append(data);
                        $("#modelCompareRole").modal('show');
                    }
                },
                error: function (xhr, error, status) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "Error");
                }
            });
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

    function fnUpdateRole() {
        if ($('#SiteId').val() != null && $('#SiteId').val() != undefined && $('#SiteId').val() != '' && $('#SiteId').val() != "0") {
            var i = 0;
            var length = $('.chkUpdateRole:checked').length;
            $(".chkUpdateRole").each(function () {
                if ($(this).prop('checked') == true) {
                    var dataStr = {
                        SiteId: $('#SiteId').val(),
                        Role: $(this).val(),
                        Plc: $(this).data('plc')
                    };

                    $("#loader").show();
                    $.ajax({
                        url: '/Maintenace/UpdateCompareRole',
                        type: 'Post',
                        data: JSON.stringify(dataStr),
                        contentType: 'application/json',
                        success: function (data) {
                            $("#loader").hide();

                            i = i + 1;
                            if (length == i) {
                                CommonNotification("SUCCESS", "Role Update successfully.", "success");
                            }
                        },
                        error: function (response) {
                            $("#loader").hide();
                            CommonNotification("ERROR", "Something went wrong!", "Error");
                        }
                    });
                    //do something
                }
            });
        }
        else {
            CommonNotification("ERROR", "Please select site", "Error");
        }
    }

