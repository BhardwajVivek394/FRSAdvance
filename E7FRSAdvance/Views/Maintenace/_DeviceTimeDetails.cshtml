<div class="modal bounceIn animated" id="asset-graph" tabindex="-1" role="dialog" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title"><span>Graph</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-6">
                        <div class="pull-left">
                            <label style="margin-top:7px;font-weight:bold">Asset:</label>
                            <label style="margin-top:7px" id="lblName"></label>
                        </div>

                    </div>
                    <div class="col-sm-6">
                        <div id="divFamilyTrack" style="display:inline-flex;">
                            <input type="hidden" id="familyTrack" value="Select Asset" />
                            <button class="btn btn-success" onclick="fnNormal()">Normal</button>
                            <button class="btn btn-primary m-l-10" onclick="fnChangeLeakgeGraph()">Leakage Comparison</button>
                            @*<select class="form-control" style="display:inline-flex;" onchange="fnChangeLeakgeGraph()" id="familyTrack">
                                </select>*@
                        </div>
                    </div>
                    <div class="col-lg-12">

                        <div class="card" style="width:100%;">
                            <div class="card-header">

                                <div class="pull-left">
                                    <input type="hidden" id="selDatabase" value="MQTT" />
                                    <div class="btn-group btn-bar-rad">
                                        <button class="btn btn-outline-primary db1 active" id="mqtt" onclick="fnDBChanges(this,'MQTT')" data-name="MQTT" type="button">MQTT Db</button>
                                        <button class="btn btn-outline-primary db1" id="http" onclick="fnDBChanges(this,'HTTP')" data-name="HTTP" type="button">PLC LOG</button>
                                    </div>
                                    @*<select class="form-control" id="selDatabase" onchange="fnDBChanges()">
                                            <option>Select Database</option>
                                            <option value="MQQT">MQQT Db</option>
                                            <option value="HTTP">HTTP Db</option>
                                        </select>*@

                                </div>
                                <div class="pull-right" style="display:inline-flex;">
                                    <input type="hidden" id="hdnAssetId" value="0" />
                                    <input type="hidden" id="hdnSiteId" value="0" />
                                    @*<input type="text" name="dates" style="width:400px;height:28px;margin-right:10px;" class="form-control" placeholder="mm/dd/yyyy" id="datepicker">*@
                                    <div class="input-group mt20" id="fTime" style="width:200px;">
                                        <input id="tpFrom" type="text" class="form-control" />
                                        <span class="input-group-text"><i class="fa fa-calendar-times-o"></i></span>
                                    </div>
                                    <div class="input-group mt20" id="tTime" style="width:200px;">
                                        <input id="tpTo" type="text" class="form-control" />
