    function ChartGraph(data) {

        var color = ["#4bacc6", "#215968", "#404040", "#7366ff", "#f73164", "#90d474", "#fceda2", "#00e396", "#00ceba", "#f37995"];

        var colorB = ["rgba(75, 172, 198, 0.1)", "rgba(33, 89, 104, 0.1)", "rgba(64, 64, 64, 0.1)", "rgba(115, 102, 255, 0.1)", "rgba(247, 49, 100, 0.1)", "rgba(144, 212, 116, 0.1)", "rgba(252, 237, 162, 0.1)", "rgba(0, 227, 150, 0.1)", "rgba(0, 206, 186, 0.1)", "rgba(243, 121, 149, 0.1)", "rgba(150, 188, 715,0.1)", "rgba(150, 188, 715,0.1)", "rgba(150, 188, 715,0.1)", "rgba(150, 188, 715,0.1)"];

        var DataSeriaes = [];
        var maxV = 0;

        if (data.assetAttributes != null && data.assetAttributes.length > 0) {
            $.each(data.assetAttributes, function (ids, val) {
                if (ids == 0) {
                    $("#lblType").text(val.AssetTypeName + " :");
                    $("#lblName").text(val.AssetName)
                }
                var attr = {};
                attr.label = val.Title;
                attr.Fill = true;
                //var backColor = [];
                //for (var i = 0; i < data.assetAttributes.length; i++) {
                //    backColor.push(colorB[ids]);
                //}
                attr.backgroundColor = colorB[ids];
                attr.fillColor = colorB[ids];
                attr.strokeColor = colorB[ids];
                attr.pointColor = color[ids];
                attr.lineTension = 0.1;
                attr.borderColor = color[ids];
                attr.borderCapStyle = 'butt';
                attr.borderDashOffset = 0.5;
                attr.borderJoinStyle = 'miter';
                attr.pointBorderColor = color[ids];
                attr.pointBackgroundColor = "#fff";
                attr.pointBorderWidth = 2;
                attr.pointHoverRadius = 2;
                attr.pointHoverBackgroundColor = color[ids];
                attr.pointHoverBorderColor = color[ids];
                attr.pointHoverBorderWidth = 2;
                attr.pointRadius = 2;
                attr.pointHitRadius = 2;
                if (ids % 2 == 0) {
                    attr.yAxisID = 'A';
                }
                else {
                    attr.yAxisID = 'B';
                }

                if (val.Title == "TPR V" || val.Title == "DG V" || val.Title == "RG V" || val.Title == "HG V" || val.Title == "HHG V" || val.Title == "Tx1 V" || val.Title == "Tx2 V") {

                    $.each(val.Data, function (i, j) {
                        var d = parseInt(j);
                        if (d > maxV) {
                            maxV = d;
                        }
                    });
                }
                //  maxV = maxV + 1;
                attr.data = [];
                var values = [];
                $.each(val.Data, function (i, j) {
                    values.push(j);
                });
                attr.data = values;
                DataSeriaes.push(attr);
            });
        }

        var xValue = [];
        $.each(data.DateList, function (ids, val) {
            xValue.push(val);
        });


        var pieChartContent = document.getElementById('area-echart');
        pieChartContent.innerHTML = '&nbsp;';
        $('#area-echart').append('<canvas id="basicflot" style="height:350px;width:100%;"><canvas>');

        // var canvas = document.getElementById('basicflot');
        var ctx = $("#basicflot").get(0).getContext("2d");
        ctx.height = 1200;
        var myChart = new Chart(ctx, {
            type: "line",
            data: {
                datasets: DataSeriaes,
                labels: xValue
            },
            options: {
                tooltips: {
                    mode: 'index',
                    intersect: false,
                },
                legend: {
                    position: 'bottom',
                },

                //scaleUse2Y: true,
                showLines: true,
                responsive: false,
                aspectRatio: 1,
                maintainAspectRatio: false,
                scales: {

                    yAxes: [{
                        id: 'A',
                        type: 'linear',
                        position: 'left',
                        stacked: true,
                        display: true,
                        scaleLabel: {
                            display: true,
                        }
                    }, {
                        id: 'B',
                        type: 'linear',
                        position: 'right',
                        stacked: true,
                        display: true,
                        scaleLabel: {
