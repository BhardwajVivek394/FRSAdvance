            <div class="modal-header">
                <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Alert Log</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    @*<div class="col-sm-12 text-end mb-2">
                            <a class="btn btn-outline-dark-2x" onclick="DownloadChildCsvFile()">Download</a>
                        </div>*@
                    <div class="col-sm-12" id="model-div-alert">

                    </div>
