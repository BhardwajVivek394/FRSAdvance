                'Asset health for PM07'
            ];

            function renderWelcome() {
                const el = document.createElement('div');
                el.className = 'e7-welcome';
                el.id = 'e7WelcomeBlock';
                el.innerHTML = `
                  <div class="e7-welcome-hero">
                    <div class="e7-welcome-eyebrow">Railway asset intelligence</div>
                    <h3>Operational answers from your RDPMS data</h3>
                    <p>Ask about live values, active alerts, device timestamps, recent history, asset health and site-level status across tracks, signals and point machines.</p>
                    <div class="e7-welcome-security">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
