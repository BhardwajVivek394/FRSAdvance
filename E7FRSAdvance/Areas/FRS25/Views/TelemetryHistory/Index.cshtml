    // ===== MULTI-SELECT HELPERS =====
    function toggleDD(id, btn) {
        if (openDropdown === id) { closeDD(); return; }
        closeDD();
        var $dd = $('#' + id);
        var rect = btn.getBoundingClientRect();
        $dd.css({ top: rect.bottom + 4, left: rect.left });
        $dd.addClass('open');
        $(btn).addClass('active');
        $('#backdrop').addClass('show');
        openDropdown = id;
        setTimeout(function () { var $s = $dd.find('.ms-dropdown-search input'); if ($s.length) $s.focus(); }, 100);
    }

    function closeDD() {
        if (openDropdown) {
            var $dd = $('#' + openDropdown);
            $dd.find('.ms-dropdown-search input').val('');
            $dd.find('.ms-dropdown-item, .ms-dropdown-item-single').removeClass('hidden');
            $dd.find('.ms-dropdown-no-results').removeClass('show');
            $dd.find('.ms-dropdown-item').each(function () {
                var origText = $(this).data('text');
                if (origText) $(this).find('span').text(origText);
            });
            $dd.removeClass('open');
            $('.select-btn').removeClass('active');
            $('#backdrop').removeClass('show');
            openDropdown = null;
        }
    }

    function msSelectAll(type, checked) {
        var listId = (type === 'site') ? 'listSite' : 'listAsset';
        $('#' + listId + ' .ms-dropdown-item').each(function () {
            $(this).find('.cb-' + type).prop('checked', checked);
            $(this).toggleClass('checked', checked);
        });
        msUpdateText(type);
    }

    function msUpdateSelectAllState(type) {
        var listId = (type === 'site') ? 'listSite' : 'listAsset';
        var chkAllId = (type === 'site') ? 'chkAllSite' : 'chkAllAsset';
        var $allItems = $('#' + listId + ' .ms-dropdown-item');
        var totalAll = $allItems.length;
        var checkedAll = $allItems.find('.cb-' + type + ':checked').length;
        $('#' + chkAllId).prop('checked', totalAll > 0 && totalAll === checkedAll);
    }

    function msUpdateText(type) {
        var $checked = $('.cb-' + type + ':checked');
        var count = $checked.length;
        var text = 'All';
        if (count === 1) {
            text = $checked.first().closest('.ms-dropdown-item').data('text') || $checked.first().closest('.ms-dropdown-item').find('span').text();
        } else if (count > 1) {
            text = count + ' selected';
        }
        var txtId = (type === 'site') ? 'txtSite' : 'txtAsset';
        $('#' + txtId).text(text);
        msUpdateSelectAllState(type);
        if (type === 'asset') updateGraphOptionState();
    }

    function msGetValues(type) {
        var vals = [];
        $('.cb-' + type + ':checked').each(function () { vals.push($(this).val()); });
        return vals;
    }

    function updateGraphOptionState() {
        var count = msGetValues('asset').length;
        var $graphItem = $('#ddViewType .ms-dropdown-item-single[data-value="Graph"]');
        if (count > 1) {
            // Disable Graph option
            $graphItem.addClass('disabled');
            // If Graph is currently selected, auto-switch to Table
            if (selectedViewType === 'Graph') {
                selectedViewType = 'Table';
                $('#txtViewType').text('Table');
                $('#ddViewType .ms-dropdown-item-single').removeClass('checked');
                $('#ddViewType .ms-dropdown-item-single[data-value="Table"]').addClass('checked');
                if (lastAssetResults && lastAssetResults.length > 0) renderByViewType(lastAssetResults);
            }
        } else {
            // Re-enable Graph option
            $graphItem.removeClass('disabled');
        }
    }

    function filterMsDropdown(type, searchText) {
        var ddId = (type === 'site') ? 'ddSite' : 'ddAsset';
        var $dropdown = $('#' + ddId);
        var $items = $dropdown.find('.ms-dropdown-item');
        var $noResults = $dropdown.find('.ms-dropdown-no-results');
        var search = searchText.toLowerCase().trim();
        var visibleCount = 0;

        $items.each(function () {
            var $item = $(this);
            var text = ($item.data('text') || $item.find('span').text()).toLowerCase();
            if (search === '' || text.indexOf(search) > -1) {
                $item.removeClass('hidden');
                visibleCount++;
                if (search !== '') {
                    var originalText = $item.data('text') || $item.find('span').text();
                    var regex = new RegExp('(' + escapeRegex(searchText) + ')', 'gi');
                    $item.find('span').html(originalText.replace(regex, '<mark>$1</mark>'));
                } else {
                    var origText = $item.data('text');
                    if (origText) $item.find('span').text(origText);
                }
            } else {
                $item.addClass('hidden');
            }
        });
        $noResults.toggleClass('show', visibleCount === 0 && search !== '');
    }

    function escapeRegex(string) { return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

    // ===== DATE HELPERS =====
    function formatDateForInput(date) {
        var y = date.getFullYear();
        var m = ('0' + (date.getMonth() + 1)).slice(-2);
        var d = ('0' + date.getDate()).slice(-2);
        return y + '-' + m + '-' + d;
    }

    function formatTimeForInput(date) {
        return ('0' + date.getHours()).slice(-2) + ':' + ('0' + date.getMinutes()).slice(-2);
    }

    function formatDateTimeForAPI(dateStr, timeStr) {
        if (!dateStr) return '';
        var parts = dateStr.split('-');
        var timeParts = (timeStr || '00:00').split(':');
        return parts[2] + parts[1] + parts[0] + '_' + ('0' + timeParts[0]).slice(-2) + ('0' + timeParts[1]).slice(-2) + ('0' + new Date().getSeconds()).slice(-2);
    }

    function formatTimestamp(date) {
        var dd = ('0' + date.getDate()).slice(-2);
        var mm = ('0' + (date.getMonth() + 1)).slice(-2);
        var yyyy = date.getFullYear();
        var hh = ('0' + date.getHours()).slice(-2);
        var mi = ('0' + date.getMinutes()).slice(-2);
        var ss = ('0' + date.getSeconds()).slice(-2);
        return dd + '/' + mm + '/' + yyyy + ' ' + hh + ':' + mi + ':' + ss;
    }

    function formatTimestampShort(date) {
        return ('0' + date.getDate()).slice(-2) + '/' + ('0' + (date.getMonth() + 1)).slice(-2) + ' ' + ('0' + date.getHours()).slice(-2) + ':' + ('0' + date.getMinutes()).slice(-2);
    }

    function formatDateDDMMYYYY(date) {
        var day = String(date.getDate()).padStart(2, '0');
        var month = String(date.getMonth() + 1).padStart(2, '0');
        var year = date.getFullYear();
        return day + '/' + month + '/' + year;
    }

    function formatDateTimeDDMMYYYY(date) {
        var day = String(date.getDate()).padStart(2, '0');
        var month = String(date.getMonth() + 1).padStart(2, '0');
        var year = date.getFullYear();
        var hours = date.getHours();
        var minutes = String(date.getMinutes()).padStart(2, '0');
        var seconds = String(date.getSeconds()).padStart(2, '0');
        var ampm = hours >= 12 ? 'PM' : 'AM';
        hours = hours % 12; hours = hours ? hours : 12;
        return day + '/' + month + '/' + year + ', ' + String(hours).padStart(2, '0') + ':' + minutes + ':' + seconds + ' ' + ampm;
    }

    function convertDateToddmmyyyy(dateStr) {
        if (!dateStr) return '';
        var parts = dateStr.split('-');
        if (parts.length === 3) return parts[2] + '/' + parts[1] + '/' + parts[0];
        return dateStr;
    }

