        //        nameTextStyle: { fontSize: 11, fontWeight: 'bold', color: '#2563eb', padding: [0, 0, 0, 50] },
        //        axisLabel: { fontSize: 10, color: '#2563eb', formatter: '{value}' },
        //        axisLine: { show: true, lineStyle: { color: '#2563eb', width: 1.5 } },
        //        axisTick: { show: true, lineStyle: { color: '#2563eb' } },
        //        splitLine: { show: !hasMA, lineStyle: { color: 'rgba(37,99,235,.07)', type: 'dashed', width: 1 } },
        //        offset: 0, show: hasV
        //    },
        //    {
        //        type: 'value', min: -0.2, max: 1.6, name: '0/1', nameLocation: 'end',
        //        nameTextStyle: { fontSize: 11, fontWeight: 'bold', color: '#7c3aed', padding: [0, 0, 0, 40] },
        //        axisLabel: {
        //            fontSize: 10, color: '#7c3aed', interval: 0,
        //            formatter: function (v) { return v === 0 ? '0' : v === 1 ? '1' : ''; }
        //        },
        //        axisLine: { show: true, lineStyle: { color: '#7c3aed', width: 1.5 } },
        //        axisTick: { show: true, lineStyle: { color: '#7c3aed' } },
        //        splitLine: { show: false },
        //        offset: hasV ? 62 : 0, minInterval: 1, show: hasBin
        //    }
        //];


        // Combined scale for all analog series (mA + V). One unified left axis &mdash; same as live graph.
        var combinedMaxRaw = Math.max(maxMA || 0, maxV || 0);
        var combinedMax = combinedMaxRaw > 0 ? parseFloat((combinedMaxRaw * 1.18).toFixed(2)) : 'dataMax';
        var hasAnalog = hasMA || hasV;

        var yAxes = [
            {
                type: 'value', min: 0, max: combinedMax,
                position: 'left', offset: 0, name: '',
                axisLabel: { fontSize: 10, color: 'rgba(255,255,255,0.45)', formatter: '{value}' },
                axisLine: { show: hasAnalog, lineStyle: { color: 'rgba(255,255,255,0.15)', width: 1 } },
                axisTick: { show: hasAnalog, lineStyle: { color: 'rgba(255,255,255,0.12)' } },
                splitLine: { show: true, lineStyle: { color: 'rgba(255,255,255,0.05)', type: 'dashed', width: 1 } },
                show: hasAnalog
            },
            {
                type: 'value', min: 0, max: combinedMax,
                position: 'left', offset: 0, name: '',
                axisLabel: { show: false }, axisLine: { show: false },
                axisTick: { show: false }, splitLine: { show: false },
                show: false
            },
            {
                type: 'value', min: -0.2, max: 1.6,
                position: 'right', offset: 0,
                name: '0/1', nameLocation: 'end',
