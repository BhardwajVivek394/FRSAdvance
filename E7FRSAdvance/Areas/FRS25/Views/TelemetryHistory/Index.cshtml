    function getRangeClass(attrId, numericValue) {
        var r = ATTRIBUTE_RANGES[attrId];
        if (!r) return '';
        var v = parseFloat(numericValue);
        if (!isFinite(v)) return '';

        if (r.fail !== null && v < r.fail) return 'range-critical';
        if (r.max !== null && v > r.max) return 'range-critical';
        if (r.min !== null && v < r.min) return 'range-warn';
        if (r.avg !== null) {
            if (v <= r.avg) return 'range-ok';
            return 'range-high';
        }
        return 'range-ok';
    }

