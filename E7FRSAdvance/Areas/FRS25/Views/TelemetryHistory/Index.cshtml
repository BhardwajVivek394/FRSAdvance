    function _hgDrawECharts(parsed, colorMap, multiAsset) {
        if (historyEChart) { historyEChart.dispose(); historyEChart = null; }
        var el = document.getElementById('hgChartDiv');
        if (!el) return;
        historyEChart = echarts.init(el, null, { renderer: 'canvas' });

        // Pull the selected datetime range from the filter inputs so the
        // chart window matches the table window. Scoped inside this
        // function so it doesn't rely on renderChart's closure.
        var selectedRange = getSelectedRange();

        // Sorted union of all timestamps in ms
        var sortedTs = parsed.timestamps.map(function (d) { return d.getTime(); });
        sortedTs.sort(function (a, b) { return a - b; });

        var sr = [], ci = 0;
        var maxMA = 0, maxV = 0;
        var hasMA = false, hasV = false, hasBin = false;
        var binSeriesSet = {}, seriesDataMap = {};

        var iterCols = (_hgAllCols && _hgAllCols.length) ? _hgAllCols : parsed.columns;

        // Pre-compute derived values per (assetId, ts) when derived cols exist
        var derivedCache = {};
        if (_hgDerivedCols && _hgDerivedCols.length) {
            var assetsSeen = {};
            _hgDerivedCols.forEach(function (dc) { assetsSeen[dc.assetId] = true; });
            Object.keys(assetsSeen).forEach(function (aid) {
                parsed.timestamps.forEach(function (ts) {
                    derivedCache[aid + '|' + ts.getTime()] =
                        calculateDerivedForRow(parsed.attributeData, parsed.columns, aid, ts);
                });
            });
        }

        iterCols.forEach(function (col) {
            if (chartHiddenSeries[col.compositeKey]) return;

            var entries;
            if (col.isDerived) {
                entries = [];
                parsed.timestamps.forEach(function (ts) {
                    var d = derivedCache[col.assetId + '|' + ts.getTime()];
                    if (d && d[col.attrId] !== undefined && !isNaN(d[col.attrId])) {
                        entries.push({ ts: ts, value: d[col.attrId] });
                    }
                });
            } else {
                entries = parsed.attributeData[col.compositeKey] || [];
            }
            if (!entries.length) return;

            // Build valueMap {ms → float}
            var valueMap = {}, allVals = [];
            entries.forEach(function (e) {
                var ms = e.ts.getTime();
                var v = parseFloat(e.value);
                if (!isNaN(v)) { valueMap[ms] = v; allVals.push(v); }
            });
            if (!Object.keys(valueMap).length) return;

            // Binary detection: DataLogger AND all values are 0 or 1
            var allBinary = allVals.length > 0 && allVals.every(function (v) { return v === 0 || v === 1; });
            var isBin = col.isDataLogger && allBinary;
            var nl = col.displayName.toLowerCase();
            //var isMA = !isBin && (nl.indexOf('ma') > -1 || nl.indexOf('mv') > -1);
            var isMA = !isBin && (nl.indexOf('ma') > -1 || nl.indexOf('mv') > -1 || nl.indexOf('current') > -1);

            var co = colorMap[col.compositeKey] || _hgGC[ci % _hgGC.length];

            // Carry-forward across union timestamps &mdash; same pattern as live graph
            //var points = [], actualPts = [], lastVal = null;
            //sortedTs.forEach(function (ts) {
            //    if (valueMap[ts] !== undefined) { lastVal = valueMap[ts]; actualPts.push([ts, lastVal]); }
            //    if (lastVal === null) return;
            //    points.push({
            //        value: [ts, lastVal],
            //        symbol: (valueMap[ts] !== undefined && !isBin) ? 'circle' : 'none',
            //        symbolSize: (valueMap[ts] !== undefined && !isBin) ? 3 : 0
            //    });
            //});
            //if (!points.length) return;
            // Carry-forward across union timestamps &mdash; plot by category index so points are evenly spaced
            //var points = [], actualPts = [], lastVal = null;
            //sortedTs.forEach(function (ts, idx) {
            //    if (valueMap[ts] !== undefined) { lastVal = valueMap[ts]; actualPts.push([ts, lastVal]); }
            //    if (lastVal === null) { points.push(null); return; }
            //    points.push({
            //        value: lastVal,
            //        symbol: (valueMap[ts] !== undefined && !isBin) ? 'circle' : 'none',
            //        symbolSize: (valueMap[ts] !== undefined && !isBin) ? 3 : 0
            //    });
            //});
            //if (!actualPts.length) return;

            // Carry-forward across union timestamps &mdash; plot by category index so points are evenly spaced.
            // For display: clamp negatives to 0 (don't dip below axis). Store raw value separately for tooltip.
            // Also back-fill: once the first real value arrives, retro-fill earlier slots with it so
            // the chart shows a continuous line from the very start (no blank space at left edge).
            var points = [], actualPts = [], lastVal = null, firstIdx = -1;
            sortedTs.forEach(function (ts, idx) {
                if (valueMap[ts] !== undefined) {
                    lastVal = valueMap[ts];
                    actualPts.push([ts, lastVal]);
                    if (firstIdx < 0) firstIdx = idx;
                }
                if (lastVal === null) { points.push(null); return; }
                var plotVal = (!isBin && lastVal < 0) ? 0 : lastVal;
                points.push({
                    value: plotVal,
                    rawVal: lastVal,
                    symbol: (valueMap[ts] !== undefined && !isBin) ? 'circle' : 'none',
                    symbolSize: (valueMap[ts] !== undefined && !isBin) ? 3 : 0
                });
            });
            if (!actualPts.length) return;

            // Back-fill leading nulls with the first real value (no left-edge blank space)
            if (firstIdx > 0) {
                var firstVal = actualPts[0][1];
                var firstPlot = (!isBin && firstVal < 0) ? 0 : firstVal;
                for (var bi = 0; bi < firstIdx; bi++) {
                    points[bi] = { value: firstPlot, rawVal: firstVal, symbol: 'none', symbolSize: 0 };
                }
            }

            var serMax = actualPts.length ? Math.max.apply(null, actualPts.map(function (p) { return p[1]; })) : 0;
            if (!isBin) {
                if (isMA && serMax > maxMA) maxMA = serMax;
                if (!isMA && serMax > maxV) maxV = serMax;
            }
            if (isBin) hasBin = true; else if (isMA) hasMA = true; else hasV = true;

            //var sName = multiAsset ? (col.displayName + ' [' + col.assetName + ']') : col.displayName;
            //if (isBin) { binSeriesSet[sName] = true; sName = '[R] ' + sName; }
            //seriesDataMap[sName] = actualPts;
            // Prefix group (A End / B End) for PM columns so names are unique
            // (otherwise A End "Op. Current (A)" and B End "Op. Current (A)" collide in seriesDataMap)
            var _grpPrefix = '';
            if (col.group === 'A') _grpPrefix = 'A End - ';
            else if (col.group === 'B') _grpPrefix = 'B End - ';

            var _baseName = _grpPrefix + col.displayName;
            var sName = multiAsset ? (_baseName + ' [' + col.assetName + ']') : _baseName;
            if (isBin) { binSeriesSet[sName] = true; sName = '[R] ' + sName; }
            seriesDataMap[sName] = actualPts;
            ci++;

            //sr.push({
            //    name: sName, type: 'line', smooth: false, step: 'end',
            //    connectNulls: true, showSymbol: true, clip: false,
            //    yAxisIndex: isBin ? 2 : (isMA ? 0 : 1),
            //    lineStyle: { width: isBin ? 2 : 1.6, color: co, type: 'solid' },
            //    itemStyle: { color: co },
            //    data: points
            //});
            sr.push({
                name: sName, type: 'line', smooth: false, step: 'end',
                connectNulls: true, showSymbol: true, clip: false,
                yAxisIndex: isBin ? 2 : (isMA ? 0 : 1),
                lineStyle: { width: isBin ? 2 : 1.4, color: co, type: 'solid', opacity: 0.85 },
                itemStyle: { color: co },
                emphasis: { focus: 'none', lineStyle: { opacity: 0.85 } },
                blur: { lineStyle: { opacity: 0.85 }, itemStyle: { opacity: 1 } },
                data: points
            });
        });

        if (!sr.length) {
            historyEChart.dispose(); historyEChart = null;
            $('#hgChartDiv').html('<div style="display:flex;align-items:center;justify-content:center;height:100%;color:rgba(255,255,255,0.35);font-size:13px;">' +
                '<i class="fas fa-chart-line" style="margin-right:8px;opacity:.3;font-size:20px;"></i>All series hidden</div>');
            return;
        }

        //var gridRight = 15 + (hasV ? 60 : 0) + (hasBin ? 65 : 0);
        //var yAxes = [
        //    {
        //        type: 'value', min: 0, max: maxMA > 0 ? parseFloat((maxMA * 1.18).toFixed(1)) : 'dataMax',
        //        name: 'mA', nameLocation: 'end',
        //        nameTextStyle: { fontSize: 11, fontWeight: 'bold', color: '#dc2626', padding: [0, 50, 0, 0] },
        //        axisLabel: { fontSize: 10, color: '#dc2626', formatter: '{value}' },
        //        axisLine: { show: true, lineStyle: { color: '#dc2626', width: 1.5 } },
        //        axisTick: { show: true, lineStyle: { color: '#dc2626' } },
        //        splitLine: { show: true, lineStyle: { color: 'rgba(220,38,38,.07)', type: 'dashed', width: 1 } },
        //        show: hasMA
        //    },
        //    {
        //        type: 'value', min: 0, max: maxV > 0 ? parseFloat((maxV * 1.18).toFixed(1)) : 'dataMax',
