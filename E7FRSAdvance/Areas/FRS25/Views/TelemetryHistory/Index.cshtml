    // ── Render one page of a specific asset's table ─────────────────────────
    function renderAssetTablePage(assetIdx, page) {
        var cache = thCaches[assetIdx];
        if (!cache) return;

        thCurrentPages[assetIdx] = page;
        var totalRows = cache.allTimestamps.length;
        var totalPages = Math.ceil(totalRows / TH_PAGE_SIZE) || 1;
        var startIdx = (page - 1) * TH_PAGE_SIZE;
        var endIdx = Math.min(startIdx + TH_PAGE_SIZE, totalRows);

        var assetGroups = cache.assetGroups;
        var columns = cache.columns;
        var attributeData = cache.attributeData;
        var isTrack = cache.isTrack;

        var selectedAssetTypeRow = $('#drpAssetType option:selected').text().trim().toUpperCase();
        var isPMRow = (selectedAssetTypeRow === 'POINT MACHINE' || selectedAssetTypeRow === 'POINT_MACHINE');

        var h = [];
        for (var r = startIdx; r < endIdx; r++) {
            var rowTs = cache.allTimestamps[r];
            h.push('<tr>');
            h.push('<td>' + formatTimestamp(rowTs) + '</td>');

            var cells = cache.displayGrid[r];
            var currentAssetIdx = 0;
            var colsInCurrentAsset = 0;
            var pendingDLCells = [];

            for (var c = 0; c < cells.length; c++) {
                var col = columns[c];
                var groupCount = assetGroups[currentAssetIdx] ? assetGroups[currentAssetIdx].attrCount : 999;

                // PM: inject Direction cell at the start of each asset group
                if (isPMRow && colsInCurrentAsset === 0) {
                    var aId = assetGroups[currentAssetIdx] ? assetGroups[currentAssetIdx].assetId : null;
                    var assetColsForDir = columns.filter(function (col2) { return col2.assetId === aId; });
                    var dirLabel = getPMDirection(assetColsForDir, attributeData, rowTs);
                    var dirColor = dirLabel.indexOf('Reverse') !== -1 ? '#b45309' : '#1d4ed8';
                    h.push('<td style="color:' + dirColor + ';font-weight:600;white-space:nowrap;text-align:center;">' + dirLabel + '</td>');
                }

                var cell = cells[c];
                var cellHtml;
                if (col && col.missing) {
                    cellHtml = '<td style="color:#aaa;text-align:center;">-</td>';
                } else {
                    cellHtml = (cell.cls ? '<td class="' + cell.cls + '">' : '<td>') + cell.html + '</td>';
                }

                // Defer DataLogger cells &mdash; emit AFTER derived cells (at the very end)
                if (col && col.isDataLogger) {
                    pendingDLCells.push(cellHtml);
                } else {
                    h.push(cellHtml);
                }

                colsInCurrentAsset++;
                if (colsInCurrentAsset >= groupCount) {
                    if (isTrack) {
                        var aid = assetGroups[currentAssetIdx].assetId;
                        var derived = calculateDerivedForRow(attributeData, columns, aid, rowTs);
                        h.push(getDerivedCellsHtml(derived));
                    }
                    // Now emit deferred DataLogger cells AFTER derived cells
                    for (var d = 0; d < pendingDLCells.length; d++) h.push(pendingDLCells[d]);
                    pendingDLCells = [];
                    currentAssetIdx++;
                    colsInCurrentAsset = 0;
                }
            }
            h.push('</tr>');
        }

        $('#tblHistoryBody_' + assetIdx).html(h.join(''));

        // Per-asset pagination
        var showingFrom = startIdx + 1;
        var showingTo = endIdx;
        $('#showingRecords_' + assetIdx).text('Showing ' + showingFrom + ' to ' + showingTo + ' of ' + totalRows + ' records');

        var pHtml = '';
        pHtml += '<li class="page-item ' + (page <= 1 ? 'disabled' : '') + '">'
            + '<a class="page-link" href="javascript:void(0);" onclick="renderAssetTablePage(' + assetIdx + ',' + (page - 1) + ')">'
            + '<i class="fas fa-chevron-left"></i> Previous</a></li>';

        var startPage = Math.max(1, page - 2);
        var endPage = Math.min(totalPages, startPage + 4);
        if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);

        for (var p = startPage; p <= endPage; p++) {
            pHtml += '<li class="page-item ' + (p === page ? 'active' : '') + '">'
                + '<a class="page-link" href="javascript:void(0);" onclick="renderAssetTablePage(' + assetIdx + ',' + p + ')">' + p + '</a></li>';
        }
        pHtml += '<li class="page-item ' + (page >= totalPages ? 'disabled' : '') + '">'
            + '<a class="page-link" href="javascript:void(0);" onclick="renderAssetTablePage(' + assetIdx + ',' + (page + 1) + ')">'
            + 'Next <i class="fas fa-chevron-right"></i></a></li>';

        $('#paginationUl_' + assetIdx).html(pHtml);
        $('#pagination_' + assetIdx).show();
    }

    // PM AttributeId base codes (per documentation: FinalAttributeId = BaseCode + DataTypeOffset)
    var PM_NORMAL_BASES = [1000, 2000, 3000, 4000]; // AC/AV/BC/BV Normal
    var PM_REVERSE_BASES = [6000, 7000, 8000, 9000]; // AC/AV/BC/BV Reverse
    var PM_NORMAL_IND_IDS = [25, 576, 27, 578];      // NWKR voltage (Indication tab)
    var PM_REVERSE_IND_IDS = [26, 577, 28, 579];     // RWKR voltage (Indication tab)

    // Exact timestamp match only &mdash; no carry-forward
    // Critical for direction detection: only the attr that FIRED at this operation counts
    function getExactValueForTimestamp(entries, targetTs) {
        if (!entries || entries.length === 0) return null;
        var targetTime = targetTs.getTime();
        for (var i = 0; i < entries.length; i++) {
            if (entries[i].ts.getTime() === targetTime) return entries[i].value;
        }
        return null;
    }

    function getPMDirection(columns, attributeData, rowTs) {
        if (pmViewMode === 'operational') {
            var hasNormalOp = false, hasReverseOp = false;
            var PM_NR_MAP = { 1002: 6002, 2002: 7002, 1005: 6005, 3002: 8002, 4002: 9002, 3005: 8005 };

            for (var c = 0; c < columns.length; c++) {
                var col = columns[c];
                if (!col || !col.compositeKey || col.isDataLogger || col.missing) continue;

                // ── EXACT match only &mdash; carry-forward causes previous operation's
                //    direction to bleed into the next row and corrupt detection ──
                var val = getExactValueForTimestamp(attributeData[col.compositeKey], rowTs);

                if (val !== null) {
                    // Determine direction purely from AttributeId BaseCode
                    var aid = col.attrId;
                    if ((aid >= 1000 && aid < 5000)) hasNormalOp = true;   // 1xxx/2xxx/3xxx/4xxx
                    if ((aid >= 6000 && aid < 10000)) hasReverseOp = true; // 6xxx/7xxx/8xxx/9xxx
                }

                // For Normal-mapped columns (PM_OP_COL_ORDER only has Normal IDs),
                // also check the Reverse counterpart key with exact match
                if (!hasReverseOp && PM_NR_MAP[col.attrId]) {
                    var _rvKey = col.assetId + '_' + PM_NR_MAP[col.attrId] + '_pointmachine';
                    var _rvVal = getExactValueForTimestamp(attributeData[_rvKey], rowTs);
                    if (_rvVal !== null) hasReverseOp = true;
                }
            }

            if (hasReverseOp && !hasNormalOp) return 'Reverse';
            if (hasNormalOp) return 'Normal';
            return 'Point Operating';

            //}
            //else {
            //    // Indication: carry-forward is correct here (RDPMS periodic voltage)
            //    var hasNormalInd = false, hasReverseInd = false;
            //    for (var c = 0; c < columns.length; c++) {
            //        var col = columns[c];
            //        if (!col || !col.compositeKey || col.isDataLogger || col.missing) continue;
            //        var val = getValueForTimestamp(attributeData[col.compositeKey], rowTs);
            //        if (val === null) continue;
            //        var num = parseFloat(val);
            //        if (isNaN(num) || num === 0) continue;
            //        if (PM_NORMAL_IND_IDS.indexOf(col.attrId) !== -1) hasNormalInd = true;
            //        if (PM_REVERSE_IND_IDS.indexOf(col.attrId) !== -1) hasReverseInd = true;
            //    }
            //    if (hasNormalInd && !hasReverseInd) return 'Normal';
            //    if (hasReverseInd && !hasNormalInd) return 'Reverse';
            //    if (hasNormalInd) return 'Normal';
            //    return '-';
            //}

        } else {
            var PM_NORMAL_IND_IDS = [25, 27];
            var PM_REVERSE_IND_IDS = [26, 28];
            // Indication: direction derived from NWKR / RWKR voltage thresholds.
            //   NWKR (A End = 25, B End = 27) > 4.5  → Normal operation
            //   RWKR (A End = 26, B End = 28) > 4.5  → Reverse operation
            // Uses carry-forward (RDPMS periodic voltage) for the row timestamp.
            var PM_IND_THRESHOLD = 4.5;
            var hasNormalInd = false, hasReverseInd = false;
            for (var c = 0; c < columns.length; c++) {
                debugger;
                var col = columns[c];
                if (!col || !col.compositeKey || col.isDataLogger || col.missing) continue;
                var val = getValueForTimestamp(attributeData[col.compositeKey], rowTs);
                if (val === null) continue;
                var num = parseFloat(val);
                if (isNaN(num)) continue;
                if (num > PM_IND_THRESHOLD) {
                    if (PM_NORMAL_IND_IDS.indexOf(col.attrId) !== -1) hasNormalInd = true;
                    if (PM_REVERSE_IND_IDS.indexOf(col.attrId) !== -1) hasReverseInd = true;
                }
            }
            // Priority: if Normal indication is present → Normal; else if Reverse → Reverse; else '-'
            if (hasNormalInd && !hasReverseInd) return 'Normal';
            if (hasReverseInd && !hasNormalInd) return 'Reverse';
            if (hasNormalInd && hasReverseInd) return 'Normal';  // both picked up &mdash; Normal wins
            return 'Point Operating';
        }


    }
    // ===== PAGINATION - MATCHING SCREENSHOT STYLE =====
    function fnRenderPagination(currentPage, totalPages, totalRows, from, to) {
        $('#showingRecords').text('Showing ' + from + ' to ' + to + ' of ' + totalRows + ' records');

        var html = '';

        // Previous button
        html += '<li class="page-item ' + (currentPage <= 1 ? 'disabled' : '') + '">';
        html += '<a class="page-link" href="javascript:void(0);" onclick="' + (currentPage > 1 ? 'renderTablePage(' + (currentPage - 1) + ')' : '') + '">';
        html += '<i class="fas fa-chevron-left"></i> Previous</a></li>';

        var startPage = 1, endPage = totalPages, maxVisiblePages = 5;

        if (totalPages > maxVisiblePages) {
            if (currentPage <= 3) {
                startPage = 1;
                endPage = maxVisiblePages - 1;
            } else if (currentPage >= totalPages - 2) {
                startPage = totalPages - maxVisiblePages + 2;
                endPage = totalPages;
            } else {
                startPage = currentPage - 1;
                endPage = currentPage + 1;
            }
        }

        // First page
        if (startPage > 1) {
            html += '<li class="page-item"><a class="page-link" href="javascript:void(0);" onclick="renderTablePage(1)">1</a></li>';
            if (startPage > 2) {
                html += '<li class="page-item disabled"><a class="page-link">...</a></li>';
            }
        }

        // Page numbers
        for (var i = startPage; i <= endPage; i++) {
            html += '<li class="page-item ' + (i === currentPage ? 'active' : '') + '">';
            html += '<a class="page-link" href="javascript:void(0);" onclick="renderTablePage(' + i + ')">' + i + '</a></li>';
        }

        // Last page
        if (endPage < totalPages) {
            if (endPage < totalPages - 1) {
                html += '<li class="page-item disabled"><a class="page-link">...</a></li>';
            }
            html += '<li class="page-item"><a class="page-link" href="javascript:void(0);" onclick="renderTablePage(' + totalPages + ')">' + totalPages + '</a></li>';
        }

        // Next button
        html += '<li class="page-item ' + (currentPage >= totalPages ? 'disabled' : '') + '">';
        html += '<a class="page-link" href="javascript:void(0);" onclick="' + (currentPage < totalPages ? 'renderTablePage(' + (currentPage + 1) + ')' : '') + '">';
        html += 'Next <i class="fas fa-chevron-right"></i></a></li>';

        $('#paginationUl').html(html);
        $('#divPagination').show();
    }

    function getValueForTimestamp(entries, targetTs) {
        if (!entries || entries.length === 0) return null;
        var targetTime = targetTs.getTime();
        var bestValue = null;
        for (var i = 0; i < entries.length; i++) {
            var entryTime = entries[i].ts.getTime();
            if (entryTime === targetTime) return entries[i].value;
            if (entryTime <= targetTime) bestValue = entries[i].value;
            else break;
        }
        return bestValue;
    }

