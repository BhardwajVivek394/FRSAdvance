    function getAttrValByTitle(attrValues, titleName) {
        if (!attrValues || !titleName) return 0;

        var searchName = titleName.toLowerCase().trim();

        // 1. Direct exact match (case-insensitive)
        for (var key in attrValues) {
            if (key.toLowerCase().trim() === searchName) {
                console.log('[Derived] Found exact match: "' + titleName + '" → "' + key + '" = ' + attrValues[key]);
                return parseFloat(attrValues[key]) || 0;
            }
        }

        // 2. Partial match - key contains search or vice versa
        for (var key in attrValues) {
            var lowerKey = key.toLowerCase();
            if (lowerKey.indexOf(searchName) > -1 || searchName.indexOf(lowerKey) > -1) {
                console.log('[Derived] Found partial match: "' + titleName + '" → "' + key + '" = ' + attrValues[key]);
                return parseFloat(attrValues[key]) || 0;
            }
        }

        // 3. Keyword match - split into words and match
        var keywords = searchName.replace(/[^a-z0-9]/g, ' ').split(' ').filter(function (k) { return k.length > 1; });
        for (var key in attrValues) {
            var lowerKey = key.toLowerCase();
            var matchCount = 0;
            for (var i = 0; i < keywords.length; i++) {
                if (lowerKey.indexOf(keywords[i]) > -1) matchCount++;
            }
            if (keywords.length > 0 && matchCount >= Math.ceil(keywords.length * 0.5)) {
                console.log('[Derived] Found keyword match: "' + titleName + '" → "' + key + '" = ' + attrValues[key]);
                return parseFloat(attrValues[key]) || 0;
            }
        }

        console.log('[Derived] No match found for: "' + titleName + '" in keys:', Object.keys(attrValues));
        return 0;
    }

    // Main calculation function - expects attrValues keyed by TITLE
    function calculateDerivedValues(attrValues) {
        console.log('[Derived] Calculating with attrValues:', attrValues);

        // Get values using Title names
        var chargerMa = getAttrValByTitle(attrValues, 'Charger mA');
        var ifMa = getAttrValByTitle(attrValues, 'If mA');
        var irMa = getAttrValByTitle(attrValues, 'Ir mA');
        var chargerOpV = getAttrValByTitle(attrValues, 'Charger OP V');
        var vf = getAttrValByTitle(attrValues, 'Vf');
        var trVRelay = getAttrValByTitle(attrValues, 'Vr');
        var chokeV = getAttrValByTitle(attrValues, 'Choke V');

        console.log('[Derived] Resolved: Charger mA=' + chargerMa + ', If mA=' + ifMa + ', Ir mA=' + irMa + ', Charger OP V=' + chargerOpV + ', Vf=' + vf + ', Choke V=' + chokeV);

        var derived = {};

        // 1. ITC BATT CHARG (mA) = Charger mA - If mA
        derived.itcBattCharg = chargerMa - ifMa;

        // 2. VTC VAR RES (V) = Charger OP V - Vf - Choke V
        derived.vtcVarRes = chargerOpV - vf - chokeV;

        // 3. RTC CH FEED END (Ω) = Choke V / If mA × 1000
        derived.rtcChFeedEnd = ifMa !== 0 ? (chokeV / ifMa) * 1000 : 0;

        // 4. RTC VAR RES (Ω) = VTC VAR RES / If mA × 1000
        derived.rtcVarRes = ifMa !== 0 ? (derived.vtcVarRes / ifMa) * 1000 : 0;

        // 5. VTC TR (V) = Ir mA × TR Res (1.4Ω) / 1000
        derived.vtcTr = (irMa * TR_RES) / 1000;

        // 6. IBALST (mA) = If mA - Ir mA
        derived.ibalst = ifMa - irMa;

        // 7. RRAIL (Ω) = 2×(Vf - VTC TR) / (If + Ir) × 1000
        var ifPlusIr = ifMa + irMa;
        //derived.rrail = ifPlusIr !== 0 ? (2 * (vf - derived.vtcTr) / ifPlusIr) * 1000 : 0;
        derived.rrail = ifPlusIr !== 0 ? (2 * (vf - trVRelay) / (ifPlusIr / 1000)) : 0;

        console.log('[Derived] Calculated:', derived);
        return derived;
    }

    // FIXED: Build attrValues using TITLE as key (for calculations)
    function calculateDerivedForRow(attributeData, columns, assetId, rowTs) {
        var attrValues = {};

        for (var c = 0; c < columns.length; c++) {
            var col = columns[c];
            if (col.assetId != assetId) continue;

            //var compositeKey = col.assetId + '_' + col.attrId;
            var compositeKey = col.compositeKey || (col.assetId + '_' + col.attrId);
            var rawValue = getValueForTimestamp(attributeData[compositeKey], rowTs);

            if (rawValue !== null) {
                // KEY FIX: Use TITLE as key (not AliasName) for calculations
                var attrTitle = getAttrTitle(col.attrId);
                attrValues[attrTitle] = parseFloat(rawValue);
            }
        }

        return calculateDerivedValues(attrValues);
    }

