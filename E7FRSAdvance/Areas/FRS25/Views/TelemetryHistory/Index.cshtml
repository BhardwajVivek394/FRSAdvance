@{ ViewBag.Title = "Telemetry History";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml"; }

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/echarts/5.4.3/echarts.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<style>
    /* ══════════════════════════════════════════════════════
       TELEMETRY HISTORY &mdash; Aurora Theme
       All site-wide tokens come from aurora CSS.
       Only page-specific rules live here.
    ══════════════════════════════════════════════════════ */

    /* Toast notification (aurora-styled) */
    .toast-container {
        position: fixed;
        top: 80px;
        right: 20px;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        gap: 10px;
        pointer-events: none;
    }

    .toast-notification {
        pointer-events: auto;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        min-width: 300px;
        max-width: 380px;
        padding: 14px 16px;
        border-radius: 14px;
        background: rgba(10,15,36,0.97);
        backdrop-filter: blur(24px) saturate(160%);
        -webkit-backdrop-filter: blur(24px) saturate(160%);
        border: 1px solid rgba(255,255,255,0.10);
        box-shadow: 0 12px 40px rgba(0,0,0,0.45);
        animation: thToastIn .38s cubic-bezier(0.16,1,0.3,1);
        position: relative;
        overflow: hidden;
    }

        .toast-notification::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px;
            border-radius: 3px 0 0 3px;
        }

        .toast-notification.toast-success::before {
            background: #34d399;
        }

        .toast-notification.toast-error::before {
            background: #fb7185;
        }

        .toast-notification.toast-warning::before {
            background: #fbbf24;
        }

        .toast-notification.toast-info::before {
            background: #22d3ee;
        }

        .toast-notification.hiding {
            animation: thToastOut .28s ease-in forwards;
        }

    @@keyframes thToastIn {
        from {
            transform: translateX(110%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes thToastOut {
        from {
            transform: translateX(0);
            opacity: 1;
        }

        to {
            transform: translateX(110%);
            opacity: 0;
        }
    }

    .toast-icon {
        width: 36px;
        height: 36px;
        min-width: 36px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    .toast-success .toast-icon {
        background: rgba(52,211,153,0.14);
        color: #34d399;
    }

    .toast-error .toast-icon {
        background: rgba(251,113,133,0.14);
        color: #fb7185;
    }

    .toast-warning .toast-icon {
        background: rgba(251,191,36,0.14);
        color: #fbbf24;
    }

    .toast-info .toast-icon {
        background: rgba(34,211,238,0.14);
        color: #22d3ee;
    }

    .toast-body {
        flex: 1;
        padding-right: 18px;
    }

    .toast-title {
        font-weight: 700;
        font-size: 13px;
        color: rgba(255,255,255,0.96);
        margin-bottom: 2px;
        line-height: 1.3;
    }

    .toast-message {
        font-size: 12px;
        color: rgba(255,255,255,0.55);
        line-height: 1.4;
    }

    .toast-close {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 22px;
        height: 22px;
        background: rgba(255,255,255,0.08);
        border: none;
        border-radius: 5px;
        font-size: 13px;
        cursor: pointer;
        color: rgba(255,255,255,0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .15s;
        padding: 0;
        line-height: 1;
    }

        .toast-close:hover {
            background: rgba(255,255,255,0.15);
            color: #fff;
        }

    .toast-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 2px;
        border-radius: 0 0 0 14px;
        animation: progressShrink 4s linear forwards;
    }

    .toast-success .toast-progress {
        background: #34d399;
    }

    .toast-error .toast-progress {
        background: #fb7185;
    }

    .toast-warning .toast-progress {
        background: #fbbf24;
    }

    .toast-info .toast-progress {
        background: #22d3ee;
    }

    @@keyframes progressShrink {
        from {
            width: 100%;
        }

        to {
            width: 0%;
        }
    }

    /* History table */
    .history-table-wrapper {
        max-height: 60vh;
        overflow: auto;
        border-radius: 10px;
    }

    .history-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
        font-family: 'JetBrains Mono',monospace;
    }

        .history-table thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background: rgba(15,25,55,0.97);
            color: rgba(255,255,255,0.90);
            padding: 9px 12px;
            text-align: center;
            font-weight: 600;
            font-size: 11px;
            border-bottom: 2px solid rgba(34,211,238,0.30);
            white-space: nowrap;
            backdrop-filter: blur(12px);
        }

        .history-table thead tr:first-child th {
            position: sticky;
            top: 0;
            z-index: 12;
        }

        .history-table thead tr:nth-child(2) th {
            position: sticky;
            top: 38px;
            z-index: 11;
        }

        .history-table thead tr:nth-child(3) th {
            position: sticky;
            top: 76px;
            z-index: 10;
        }

        .history-table thead tr:first-child th:first-child {
            position: sticky;
            left: 0;
            top: 0;
            z-index: 25;
            min-width: 160px;
            box-shadow: 2px 0 4px rgba(0,0,0,0.15);
        }

        .history-table tbody tr {
            border-bottom: 1px solid rgba(255,255,255,0.04);
            transition: background .12s;
        }

            .history-table tbody tr:hover td {
                background: rgba(34,211,238,0.07) !important;
            }

                .history-table tbody tr:hover td:first-child {
                    background: rgba(34,211,238,0.12) !important;
                }

            .history-table tbody tr:nth-child(even) td {
                background: rgba(255, 255, 255, 0.015);
            }

                .history-table tbody tr:nth-child(even) td:first-child {
                    background: rgba(255,255,255,0.03);
                }

        .history-table tbody td {
            padding: 7px 10px;
            text-align: center;
            color: rgba(255,255,255,0.72);
            white-space: nowrap;
            border: 1px solid rgba(255,255,255,0.04);
        }

            .history-table tbody td:first-child {
                position: sticky;
                left: 0;
                z-index: 5;
                background: rgba(10,15,36,0.97);
                color: rgba(255,255,255,0.90);
                font-weight: 600;
                text-align: left;
                min-width: 160px;
                box-shadow: 2px 0 4px rgba(0,0,0,0.15);
            }

            .history-table tbody td.val-changed {
                color: #34d399 !important;
                font-weight: 600;
            }

            .history-table tbody td.val-unchanged {
                color: rgba(255, 255, 255, 0.45) !important;
            }
        .history-table thead th.derived-col {
            background: rgba(20, 28, 48, 0.97) !important;
            color: rgba(255, 255, 255, 0.55) !important;
            font-style: italic;
            font-weight: 500;
            border-left: 1px solid rgba(255, 255, 255, 0.10) !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
        }

        .history-table tbody td.derived-val {
            background: transparent !important;
            color: rgba(255, 255, 255, 0.55) !important;
            font-weight: 400;
            border-left: 1px solid rgba(255, 255, 255, 0.05);
        }

    .dl-pickup {
        color: #34d399 !important;
        font-weight: 700;
    }

    .dl-drop {
        color: #fb7185 !important;
        font-weight: 700;
    }

    /* Asset table block */
    .asset-table-block {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 14px;
        overflow: hidden;
        margin-bottom: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.25);
    }

        .asset-table-block .history-table-wrapper {
            border: none;
            border-radius: 0;
            max-height: 55vh;
        }

    /* Multi-select dropdown */
    .select-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 38px;
        padding: 0 11px;
        border-radius: 8px;
        background: var(--at-g1,rgba(255,255,255,0.04));
        border: 1px solid var(--at-edge,rgba(255,255,255,0.10));
        color: var(--at-t1,rgba(255,255,255,0.96));
        font-size: 12.5px;
        font-weight: 500;
        cursor: pointer;
        min-width: 130px;
        transition: all .18s;
        user-select: none;
    }

        .select-btn:hover {
            background: rgba(255,255,255,0.08);
            border-color: #22d3ee;
        }

        .select-btn.active {
            border-color: #22d3ee;
        }

        .select-btn .text {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .select-btn i {
            font-size: 9px;
            color: rgba(255,255,255,0.45);
            flex-shrink: 0;
        }

    .filter-dropdown {
        position: fixed;
        background: rgba(8,14,36,0.97);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 12px;
        box-shadow: 0 20px 48px rgba(0,0,0,0.55);
        min-width: 240px;
        max-width: 310px;
        z-index: 9999;
        display: none;
        backdrop-filter: blur(24px);
        overflow: hidden;
        flex-direction: column;
    }

        .filter-dropdown.open {
            display: flex;
        }

    .ms-dropdown-search {
        padding: 8px 10px;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        flex-shrink: 0;
    }

        .ms-dropdown-search input {
            width: 100%;
            border: 1px solid rgba(255,255,255,0.10);
            border-radius: 6px;
            padding: 7px 10px;
            font-size: 12px;
            outline: none;
            background: rgba(255,255,255,0.07);
            color: rgba(255,255,255,0.96);
        }

            .ms-dropdown-search input:focus {
                border-color: #22d3ee;
            }

            .ms-dropdown-search input::placeholder {
                color: rgba(255,255,255,0.30);
            }

    .ms-dropdown-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        background: rgba(255,255,255,0.04);
        border-bottom: 1px solid rgba(255,255,255,0.06);
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.55);
        flex-shrink: 0;
    }

        .ms-dropdown-header label {
            cursor: pointer;
            margin: 0;
        }

        .ms-dropdown-header input[type="checkbox"] {
            width: 16px;
            height: 16px;
            cursor: pointer;
            accent-color: #22d3ee;
        }

    .ms-dropdown-list {
        max-height: 240px;
        overflow-y: auto;
    }

    .ms-dropdown-item {
        display: flex;
        align-items: center;
        padding: 9px 12px;
        gap: 9px;
        cursor: pointer;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        transition: background .12s;
    }

        .ms-dropdown-item:last-child {
            border-bottom: none;
        }

        .ms-dropdown-item:hover {
            background: rgba(34,211,238,0.08);
        }

        .ms-dropdown-item.checked {
            background: rgba(34,211,238,0.10);
        }

        .ms-dropdown-item.hidden {
            display: none;
        }

        .ms-dropdown-item input[type="checkbox"] {
            width: 16px;
            height: 16px;
            cursor: pointer;
            accent-color: #22d3ee;
            flex-shrink: 0;
            pointer-events: auto;
        }

        .ms-dropdown-item span {
            font-size: 13px;
            color: rgba(255,255,255,0.75);
        }

        .ms-dropdown-item.checked span {
            color: #22d3ee;
            font-weight: 600;
        }

        .ms-dropdown-item span mark {
            background: rgba(34,211,238,0.22);
            color: #22d3ee;
            padding: 0;
            border-radius: 2px;
        }

    .ms-dropdown-empty, .ms-dropdown-no-results {
        padding: 20px;
        text-align: center;
        color: rgba(255,255,255,0.35);
        font-size: 13px;
    }

    .ms-dropdown-no-results {
        display: none;
    }

        .ms-dropdown-no-results.show {
            display: block;
        }

    .ms-dropdown-item-single {
        display: flex;
        align-items: center;
        padding: 9px 12px;
        gap: 9px;
        cursor: pointer;
        border-bottom: 1px solid rgba(255,255,255,0.04);
        transition: background .12s;
    }

        .ms-dropdown-item-single:last-child {
            border-bottom: none;
        }

        .ms-dropdown-item-single:hover {
            background: rgba(34,211,238,0.08);
        }

        .ms-dropdown-item-single.checked {
            background: rgba(34,211,238,0.12);
        }

            .ms-dropdown-item-single.checked span, .ms-dropdown-item-single.checked i {
                color: #22d3ee !important;
                font-weight: 600;
            }

        .ms-dropdown-item-single span {
            font-size: 13px;
            color: rgba(255,255,255,0.72);
        }

        .ms-dropdown-item-single i {
            width: 18px;
            text-align: center;
            font-size: 13px;
            color: rgba(255,255,255,0.45);
        }

        .ms-dropdown-item-single.disabled {
            opacity: .35;
            cursor: not-allowed;
            pointer-events: none;
        }

    .dropdown-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9998;
        display: none;
    }

        .dropdown-backdrop.show {
            display: block;
        }

    /* Filter container */
    #filterContainer {
        display: flex !important;
        flex-wrap: wrap !important;
        align-items: flex-end !important;
        gap: 8px;
        padding-bottom: 4px;
    }

        #filterContainer > div {
            flex: 0 0 auto;
            width: auto !important;
            min-width: 0;
        }

            #filterContainer > div > span {
                font-size: 11.5px;
                font-weight: 600;
                color: rgba(255,255,255,0.55);
                display: block;
                margin-bottom: 4px;
            }

        #filterContainer .form-control, #filterContainer .select-btn {
            font-size: 12.5px;
            height: 38px;
        }

        #filterContainer #drpZones, #filterContainer #drpDivisions, #filterContainer #drpSite {
            min-width: 90px;
            max-width: 120px;
        }

        #filterContainer input[type="date"] {
            min-width: 130px;
        }

        #filterContainer input[type="time"] {
            min-width: 100px;
        }

    /* Info bar */
    .table-border {
        padding: 0 !important;
        border: none !important;
    }

        .table-border .info-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
        }

    #dataInfo {
        font-size: 12px;
        color: rgba(255,255,255,0.55);
        font-family: 'JetBrains Mono',monospace;
    }

    /* PM view toggle */
    #pmViewToggle {
        display: none;
        align-items: center;
        gap: 4px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 8px;
        padding: 3px;
    }

    .pm-toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        background: transparent;
        color: rgba(255,255,255,0.55);
        transition: all .18s;
        white-space: nowrap;
    }

        .pm-toggle-btn i {
            font-size: 11px;
        }

        .pm-toggle-btn.active {
            background: rgba(34,211,238,0.18);
            color: #22d3ee;
            box-shadow: 0 0 10px rgba(34,211,238,0.15);
        }

        .pm-toggle-btn:not(.active):hover {
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.85);
        }

    /* Pagination */
    .showing-records {
        font-size: 12px;
        color: rgba(255,255,255,0.42);
        font-family: 'JetBrains Mono',monospace;
    }

    .pagination {
        display: flex;
        gap: 4px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .page-link {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.65);
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 6px;
        text-decoration: none;
        transition: all .18s;
        min-width: 34px;
        height: 32px;
        font-family: 'JetBrains Mono',monospace;
    }

        .page-link:hover {
            background: rgba(34,211,238,0.12);
            border-color: rgba(34,211,238,0.30);
            color: #22d3ee;
            text-decoration: none;
        }

    .page-item.active .page-link {
        background: rgba(34,211,238,0.20);
        color: #22d3ee;
        border-color: rgba(34,211,238,0.45);
        box-shadow: 0 0 10px rgba(34,211,238,0.15);
    }

    .page-item.disabled .page-link {
        opacity: .28;
        cursor: not-allowed;
        pointer-events: none;
    }

    .page-link i {
        font-size: 10px;
    }

    /* Chart container */
    .chart-container {
        padding: 20px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        margin: 12px 0;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .chart-title {
        font-size: 15px;
        font-weight: 700;
        color: rgba(255,255,255,0.90);
        margin: 0;
        font-family: 'Bricolage Grotesque',sans-serif;
    }

    .chart-wrapper {
        position: relative;
        height: 450px;
        width: 100%;
    }

    .no-data-box {
        height: 380px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,0.35);
        font-size: 15px;
        gap: 10px;
    }

        .no-data-box i {
            font-size: 42px;
            color: rgba(255,255,255,0.18);
        }

    /* History chart panel */
    .hAttrRow {
        display: flex;
        align-items: center;
        padding: 2px 4px;
        border-radius: 5px;
        cursor: pointer;
        gap: 5px;
        transition: background .12s;
        user-select: none;
        margin-bottom: 1px;
    }

        .hAttrRow:hover {
            background: rgba(34,211,238,0.08);
        }

        .hAttrRow input[type=checkbox] {
            cursor: pointer;
            width: 13px;
            height: 13px;
            accent-color: #22d3ee;
            flex-shrink: 0;
            margin: 0;
        }

    .hAttrDot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex-shrink: 0;
        display: inline-block;
    }

    .hAttrName {
        font-size: 11.5px;
        color: rgba(255,255,255,0.72);
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-weight: 500;
    }

    .hAttrVal {
        font-size: 11px;
        font-weight: 700;
        flex-shrink: 0;
        min-width: 34px;
        text-align: right;
        font-family: 'JetBrains Mono',monospace;
        color: rgba(255,255,255,0.90);
    }

    .hSelAll, .hg-sel-btn {
        background: rgba(255,255,255,0.06);
        color: rgba(255,255,255,0.70);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 5px;
        padding: 2px 8px;
        font-size: 10px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 3px;
        transition: all .18s;
    }

        .hSelAll:hover, .hg-sel-btn:hover {
            background: rgba(34,211,238,0.12);
            border-color: rgba(34,211,238,0.30);
            color: #22d3ee;
        }

    .hfb {
        background: rgba(255,255,255,0.06);
        color: rgba(255,255,255,0.55);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 5px;
        padding: 3px 9px;
        font-size: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all .18s;
    }

        .hfb:hover {
            background: rgba(255,255,255,0.10);
            color: rgba(255,255,255,0.85);
        }

        .hfb.active-hfb {
            background: rgba(34,211,238,0.18);
            color: #22d3ee;
            border-color: rgba(34,211,238,0.35);
        }

    .htool {
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 5px;
        padding: 3px 10px;
        margin-left: 5px;
        cursor: pointer;
        color: rgba(255,255,255,0.65);
        font-size: 10px;
        font-weight: 600;
        transition: all .18s;
    }

        .htool:hover {
            background: rgba(34,211,238,0.12);
            color: #22d3ee;
        }

    .hg-qzoom-group {
        display: flex;
        gap: 3px;
        background: rgba(255,255,255,0.06);
        border-radius: 5px;
        padding: 2px;
    }

