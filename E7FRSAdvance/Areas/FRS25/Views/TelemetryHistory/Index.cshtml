    //// Get Title for calculations
    //function getAttrTitle(attrId) {
    //    var attr = assetAttributeMap[attrId] || assetAttributeMap[String(attrId)];
    //    if (attr) return attr.title || attr.alias || ('Attr ' + attrId);
    //    return 'Attr ' + attrId;
    //}


    var PM_BASE_CODES = {
        1000: { attr: 'AC', dir: 'N' },
        2000: { attr: 'AV', dir: 'N' },
        3000: { attr: 'BC', dir: 'N' },
        4000: { attr: 'BV', dir: 'N' },
        6000: { attr: 'AC', dir: 'R' },
        7000: { attr: 'AV', dir: 'R' },
        8000: { attr: 'BC', dir: 'R' },
        9000: { attr: 'BV', dir: 'R' }
    };
    var PM_DATA_TYPE_OFFSETS = {
        1: 'Array',
        2: 'Avg',
        3: 'Min',
        4: 'Max',
        5: 'OpTime',
        6: 'Count'
    };

    function getPointMachineAttrLabel(attrId) {
        var id = parseInt(attrId, 10);
        if (isNaN(id)) return null;
        var base = Math.floor(id / 1000) * 1000;
        var offset = id % 1000;
        var bc = PM_BASE_CODES[base];
        var dt = PM_DATA_TYPE_OFFSETS[offset];
        if (bc && dt) {
            return bc.attr + ' ' + dt + ' (' + bc.dir + ')';
        }
        return null;
    }

    function getAttrDisplayName(attrId, isDataLogger) {
        if (isDataLogger) {
            var dlName = DATALOGGER_RELAY_MAP[attrId] || DATALOGGER_RELAY_MAP[String(attrId)];
            if (dlName) return dlName;
            return 'DL-' + attrId;
        }
        var attr = assetAttributeMap[attrId] || assetAttributeMap[String(attrId)];
        if (attr) return attr.alias || attr.title || getPointMachineAttrLabel(attrId) || ('Attr ' + attrId);
        return getPointMachineAttrLabel(attrId) || ('Attr ' + attrId);
    }

    function getAttrAlias(attrId) {
        var attr = assetAttributeMap[attrId] || assetAttributeMap[String(attrId)];
        if (attr) return attr.alias || attr.title || getPointMachineAttrLabel(attrId) || ('Attr ' + attrId);
        return getPointMachineAttrLabel(attrId) || ('Attr ' + attrId);
    }

