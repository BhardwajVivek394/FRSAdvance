    function parseChartData(assetResults) {
        // Match parseTableData's behavior: split same attrId by DataType into separate slots
        // so PointMachine / RDPMS / DataLogger streams don't overwrite each other.
        var _pmSelType = $('#drpAssetType option:selected').text().trim().toUpperCase();
        var _isPMChart = (_pmSelType === 'POINT MACHINE' || _pmSelType === 'POINT_MACHINE');
        var _isPMOpChart = _isPMChart && pmViewMode === 'operational';
        var _isPMIndChart = _isPMChart && pmViewMode === 'indication';

        var allTimestampsSet = {};
        var columns = [];
        var attributeData = {};

        assetResults.forEach(function (assetObj) {
            var aId = assetObj.assetId;
            var aName = assetObj.assetName;

            // Group entries by (attrId, DataType) &mdash; one column per distinct pair
            // Structure: bucketMap[attrId][dtKey] = { entries, detectedType }
            var bucketMap = {};

            (assetObj.attributes || []).forEach(function (attr) {
                var attrId = attr.AttributeId;
                var values = attr.Values;
                for (var key in values) {
                    if (!values.hasOwnProperty(key)) continue;
                    var entry = values[key];
                    if (!entry || !entry.Timestamp) continue;
                    var tsDate = new Date(entry.Timestamp.TimestampDevice);
                    if (tsDate.getFullYear() <= 1) continue;

                    var _entryDT = entry.DataType || 'RDPMS';

                    // PM Operational: only PointMachine & DataLogger streams
                    // PM Indication:  only RDPMS (periodic)
                    // All others:     everything
                    var _keep = true;
                    if (_isPMOpChart) _keep = (_entryDT === 'PointMachine' || _entryDT === 'DataLogger');
                    if (_isPMIndChart) _keep = (_entryDT === 'RDPMS' || _entryDT === '');
                    if (!_keep) continue;

                    var dtKey = (_entryDT || 'RDPMS').toLowerCase();
                    if (!bucketMap[attrId]) bucketMap[attrId] = {};
                    if (!bucketMap[attrId][dtKey]) bucketMap[attrId][dtKey] = { entries: [], detectedType: _entryDT };

                    bucketMap[attrId][dtKey].entries.push({ ts: tsDate, value: entry.Value });
                    allTimestampsSet[tsDate.getTime()] = tsDate;
                }
            });

            // Emit one column per (attrId, dtKey) bucket
            Object.keys(bucketMap).forEach(function (attrIdStr) {
                var attrId = parseInt(attrIdStr, 10);
                var dtKeys = bucketMap[attrId];
                Object.keys(dtKeys).forEach(function (dtKey) {
                    var bucket = dtKeys[dtKey];
                    bucket.entries.sort(function (a, b) { return a.ts.getTime() - b.ts.getTime(); });

                    var compositeKey = aId + '_' + attrId + '_' + dtKey;
                    attributeData[compositeKey] = bucket.entries;

                    var isDataLogger = (bucket.detectedType || '').toLowerCase() === 'datalogger';
                    var displayName = getAttrDisplayName(attrId, isDataLogger);
                    columns.push({
                        assetId: aId,
                        assetName: aName,
                        attrId: attrId,
                        compositeKey: compositeKey,
                        isDataLogger: isDataLogger,
                        displayName: displayName
                    });
                });
            });
        });

        var allTimestamps = [];
        for (var key in allTimestampsSet) allTimestamps.push(allTimestampsSet[key]);
        allTimestamps.sort(function (a, b) { return a.getTime() - b.getTime(); });

        columns.sort(function (a, b) {
            if (a.assetName !== b.assetName) return a.assetName.localeCompare(b.assetName);
            return a.attrId - b.attrId;
        });

        return { timestamps: allTimestamps, columns: columns, attributeData: attributeData };
    }

