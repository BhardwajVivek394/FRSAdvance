    // ===== DOWNLOAD FUNCTIONS =====
    function getReportFilterValues() {
        var zoneName = $('#drpZones option:selected').text() || 'All';
        var divisionName = $('#drpDivisions option:selected').text() || 'All';
        var stationName = $('#drpSite option:selected').text() || 'All';
        var assetTypeName = $('#drpAssetType option:selected').text() || 'All';
        if (!$('#drpZones').val() || $('#drpZones').val() === '0') zoneName = 'All';
        if (!$('#drpDivisions').val() || $('#drpDivisions').val() === '0') divisionName = 'All';
        if (!$('#drpSite').val() || $('#drpSite').val() === '') stationName = 'All';
        if (!$('#drpAssetType').val() || $('#drpAssetType').val() === '0') assetTypeName = 'All';
        return { zone: zoneName, division: divisionName, station: stationName, vendorName: 'Energy7', assetType: assetTypeName };
    }

    function fnDownloadExcel() {
        var cache = (thCaches && thCaches.length > 0) ? thCaches[0] : thCache;
        if (selectedViewType !== 'Table' || !cache) { showWarning('Please search with Table view first.', 'Download'); return; }
        try {
            $("#loader").show();
            var filterValues = getReportFilterValues();
            var workbook = new ExcelJS.Workbook();
            workbook.creator = 'RDPMS';
            workbook.created = new Date();
            var worksheet = workbook.addWorksheet('Telemetry History');

            var fixedColCount = 7;
            var derivedColCount = cache.isTrack ? DERIVED_COLUMNS.length : 0;
            var totalColCount = fixedColCount + cache.columns.length + (cache.isTrack ? derivedColCount * cache.assetGroups.length : 0);

            var titleRow = worksheet.addRow(['Telemetry History Report']);
            titleRow.height = 30;
            worksheet.mergeCells(1, 1, 1, totalColCount);
            titleRow.getCell(1).fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF4338CA' } };
            titleRow.getCell(1).font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 16 };
            titleRow.getCell(1).alignment = { vertical: 'middle', horizontal: 'center' };

            var periodRow = worksheet.addRow(['Period: ' + convertDateToddmmyyyy($('#txtFromDate').val()) + ' ' + $('#txtFromTime').val() + ' to ' + convertDateToddmmyyyy($('#txtToDate').val()) + ' ' + $('#txtToTime').val() + ' | Generated: ' + formatDateTimeDDMMYYYY(new Date())]);
            periodRow.height = 20;
            worksheet.mergeCells(2, 1, 2, totalColCount);
            periodRow.getCell(1).font = { italic: true, size: 10, color: { argb: 'FF64748B' } };
            periodRow.getCell(1).alignment = { horizontal: 'center' };

            worksheet.addRow([]);

            var assetNames = [];
            cache.assetGroups.forEach(function (g) { assetNames.push(g.assetName); });

            var hdr1 = ['Zone', 'Division', 'Station', 'Vendor Name', 'Asset Type', 'Asset Number', 'Date & Time'];
            cache.assetGroups.forEach(function (g) {
                var colCount = g.attrCount + (cache.isTrack ? derivedColCount : 0);
                hdr1.push(g.assetName);
                for (var i = 1; i < colCount; i++) hdr1.push('');
            });
            var hdrRow1 = worksheet.addRow(hdr1);
            hdrRow1.eachCell(function (cell) {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1E3A5F' } };
                cell.font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11 };
                cell.alignment = { vertical: 'middle', horizontal: 'center' };
            });

            var hdr2 = ['', '', '', '', '', '', ''];
            cache.assetGroups.forEach(function (g) {
                for (var c = 0; c < cache.columns.length; c++) {
                    var col = cache.columns[c];
                    if (col.assetId === g.assetId) {
                        // FIXED: Use displayName which has relay name for DataLogger
                        var name = col.displayName || getAttrAlias(col.attrId);
                        if (col.isDataLogger) name += ' (Relay)';
                        hdr2.push(name);
                    }
                }
                if (cache.isTrack) { DERIVED_COLUMNS.forEach(function (dc) { hdr2.push(dc.name); }); }
            });
            var hdrRow2 = worksheet.addRow(hdr2);
            hdrRow2.eachCell(function (cell) {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1E3A5F' } };
                cell.font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 10 };
                cell.alignment = { vertical: 'middle', horizontal: 'center' };
            });

            for (var col = 1; col <= 7; col++) { worksheet.mergeCells(4, col, 5, col); }

            for (var r = 0; r < cache.allTimestamps.length; r++) {
                var rowData = [filterValues.zone, filterValues.division, filterValues.station, filterValues.vendorName, filterValues.assetType, assetNames.join(', '), formatTimestamp(cache.allTimestamps[r])];
                var cells = cache.displayGrid[r];
                var currentAssetIdx = 0, colsInCurrentAsset = 0;

                for (var c = 0; c < cells.length; c++) {
                    rowData.push(cells[c].html.replace(/<[^>]*>/g, ''));
                    colsInCurrentAsset++;
                    if (colsInCurrentAsset >= cache.assetGroups[currentAssetIdx].attrCount) {
                        if (cache.isTrack) {
                            var assetId = cache.assetGroups[currentAssetIdx].assetId;
                            var derived = calculateDerivedForRow(cache.attributeData, cache.columns, assetId, cache.allTimestamps[r]);
                            rowData.push(formatDerivedValue(derived.itcBattCharg));
                            rowData.push(formatDerivedValue(derived.vtcVarRes));
                            rowData.push(formatDerivedValue(derived.rtcChFeedEnd));
                            rowData.push(formatDerivedValue(derived.rtcVarRes));
                            rowData.push(formatDerivedValue(derived.vtcTr));
                            rowData.push(formatDerivedValue(derived.ibalst));
                            rowData.push(formatDerivedValue(derived.rrail));
                        }
                        currentAssetIdx++;
                        colsInCurrentAsset = 0;
                    }
                }
                var excelRow = worksheet.addRow(rowData);
                excelRow.eachCell(function (cell) { cell.alignment = { vertical: 'middle', horizontal: 'center' }; });
            }

            var fileName = 'TelemetryHistory_' + formatDateDDMMYYYY(new Date()).replace(/\//g, '-') + '.xlsx';
            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), fileName);
                $("#loader").hide();
                showSuccess('Excel downloaded.', 'Download Complete');
            });
        } catch (error) { $("#loader").hide(); console.error(error); showError('Failed to download Excel.', 'Download Error'); }
    }

    function fnDownloadCSV() {
