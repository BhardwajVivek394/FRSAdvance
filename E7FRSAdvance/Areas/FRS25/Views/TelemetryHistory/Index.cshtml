        align-items: flex-start;
        position: relative;
    }

    .chart-wrapper {
        flex: 1;
        min-width: 0;
        position: relative;
        height: 450px;
    }

    .chart-side-tooltip {
        width: 210px;
        min-width: 190px;
        max-width: 230px;
        flex-shrink: 0;
        background: rgba(10,15,36,0.97);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255,255,255,0.10);
        border-radius: 10px;
        padding: 10px 12px;
        font-size: 12px;
        height: 450px;
        overflow-y: auto;
        box-shadow: 0 4px 24px rgba(0,0,0,0.40);
        display: flex;
        flex-direction: column;
    }

    .side-tooltip-title {
        font-size: 10px;
        font-weight: 700;
        color: rgba(255,255,255,0.35);
        text-transform: uppercase;
        letter-spacing: .6px;
        margin-bottom: 8px;
        padding-bottom: 6px;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        flex-shrink: 0;
    }

    .side-tooltip-time {
        font-size: 11.5px;
        font-weight: 700;
        color: #22d3ee;
        margin-bottom: 8px;
        padding: 4px 8px;
        background: rgba(34,211,238,0.08);
        border-radius: 6px;
        flex-shrink: 0;
        font-family: 'JetBrains Mono',monospace;
    }

    .side-tooltip-items {
        flex: 1;
        overflow-y: auto;
    }

    .side-tooltip-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }

        .side-tooltip-item:last-child {
            border-bottom: none;
        }

        .side-tooltip-item .st-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .side-tooltip-item .st-label {
            flex: 1;
            color: rgba(255,255,255,0.52);
            font-size: 10.5px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .side-tooltip-item .st-value {
            font-weight: 700;
            color: rgba(255,255,255,0.90);
            font-size: 11.5px;
            white-space: nowrap;
            font-family: 'JetBrains Mono',monospace;
        }

    .side-tooltip-empty {
        color: rgba(255,255,255,0.28);
        font-size: 12px;
        text-align: center;
        padding: 20px 0;
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Chart attr filter */
    .chart-attr-filter {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        padding: 10px 14px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.07);
        border-radius: 10px;
        margin-bottom: 10px;
    }

    .chart-attr-filter-label {
        font-size: 10px;
        font-weight: 700;
        color: rgba(255,255,255,0.40);
        text-transform: uppercase;
        letter-spacing: .6px;
        align-self: center;
        margin-right: 4px;
        white-space: nowrap;
    }

    .attr-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        border: 1.5px solid transparent;
        transition: all .18s;
        user-select: none;
        white-space: nowrap;
    }

        .attr-chip .attr-chip-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .attr-chip.active {
            opacity: 1;
        }

        .attr-chip.inactive {
            opacity: .38;
            text-decoration: line-through;
            filter: grayscale(.5);
        }

        .attr-chip:hover {
