    // ── Build ordered columns per asset, matching exact Excel column sequence ──
    // Loops over each assetGroup and builds the colOrder for EACH asset separately,
    // so multiple assets each get their own complete set of ordered columns.
    //
    // LABEL RESOLUTION:
    //   - def.fixedLabel === true  -> use def.label verbatim (hardcoded)
    //   - def.fixedLabel === false -> look up AttributeName via GetUserAssetInfo
    //                                 (RoleType + Role/AssetAttributeId match against
    //                                  the history API's AttributeId), fall back to
    //                                 def.label if the API has no matching entry.
    function buildPMOrderedColumns(rawColumns, colOrder, firstAssetId, assetGroups) {
        if (!assetGroups || assetGroups.length === 0) {
            assetGroups = [{ assetId: firstAssetId, assetName: '' }];
        }

        // Identify which view is being built (by colOrder identity)
        var isOpView = (colOrder === PM_OP_COL_ORDER);

        var ordered = [];
        assetGroups.forEach(function (group) {
            var aId = group.assetId;
            var aName = group.assetName;
            var assetRaw = rawColumns.filter(function (c) { return c.assetId === aId; });

            // ---- (1) Curated entries from colOrder ---------------------------
            var emittedKeys = {}; // track (attrId + isDataLogger) already emitted
            colOrder.forEach(function (def) {
                var match = null;
                for (var i = 0; i < assetRaw.length; i++) {
                    var c = assetRaw[i];
                    if (c.attrId === def.attrId && c.isDataLogger === def.isDataLogger) {
                        match = c;
                        break;
                    }
                }

                var resolvedName;
                if (def.fixedLabel === true) {
                    resolvedName = def.label;
                } else {
                    var apiName = getAssetInfoAttrName(aId, def.attrId, def.isDataLogger);
                    resolvedName = apiName || def.label;
                }

                ordered.push({
                    attrId: def.attrId,
                    compositeKey: match ? match.compositeKey : null,
                    isDataLogger: def.isDataLogger,
                    displayName: resolvedName,
                    assetId: aId,
                    assetName: aName,
                    group: def.group || null,
                    missing: !match
                });
                emittedKeys[def.attrId + '_' + (def.isDataLogger ? 'd' : 'c')] = true;
            });

            // ---- (2) OPERATIONAL view: append every DL column from history ---
            if (isOpView) {
                var dlRaw = assetRaw
                    .filter(function (c) {
                        return c.isDataLogger
                            && !emittedKeys[c.attrId + '_d']
                            && isAttrAllowedForAsset(aId, c.attrId, true);
                    })
                    .sort(function (a, b) { return a.attrId - b.attrId; });

                dlRaw.forEach(function (c) {
                    var apiName = getAssetInfoAttrName(aId, c.attrId, true);
                    ordered.push({
                        attrId: c.attrId,
                        compositeKey: c.compositeKey,
                        isDataLogger: true,
                        displayName: apiName || ('DL-' + c.attrId),
                        assetId: aId,
                        assetName: aName,
                        group: 'DL',
                        missing: false
                    });
                });
            }
        });
        return ordered;
    }

