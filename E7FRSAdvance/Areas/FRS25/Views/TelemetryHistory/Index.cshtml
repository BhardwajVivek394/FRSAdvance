    var ASSET_NUMBERS_CACHE = {};      // key "siteId|assetTypeId" -> array
    var _assetNumbersXHR = null;       // last AJAX so we can abort
    var _lastAssetKey = '';

    function debounceAssetNumbers() {
        if (debounceTimer) clearTimeout(debounceTimer);
        // 120ms is enough to coalesce paired dropdown changes without feeling laggy
        debounceTimer = setTimeout(loadAssetNumbers, 120);

    }

    function _renderAssetList(data) {
        var $list = $('#listAsset');
        if (!data || data.length === 0) {
            $list.html('<div class="ms-dropdown-empty">No assets found</div>');
            return;
        }
        // Build once in a detached fragment — far cheaper than innerHTML on large lists
        var frag = document.createDocumentFragment();
        for (var i = 0; i < data.length; i++) {
            var item = data[i];
            var row = document.createElement('div');
            row.className = 'ms-dropdown-item';
            row.setAttribute('data-value', item.Id);
            row.setAttribute('data-text', item.Name);
            row.innerHTML =
                '<input type="checkbox" class="cb-asset" value="' + item.Id + '">' +
                '<span>' + item.Name + '</span>';
            frag.appendChild(row);
        }
        $list.empty()[0].appendChild(frag);
    }


    function loadAssetNumbers() {
        var siteId = $('#drpSite').val();
        var assetTypeId = $('#drpAssetType').val();

        $('#chkAllAsset').prop('checked', false);
        $('#txtAsset').text('All');

        if (!siteId || siteId === '0' || siteId === '' ||
            !assetTypeId || assetTypeId === '0' || assetTypeId === '') {
            $('#listAsset').html('<div class="ms-dropdown-empty">Select Station &amp; Asset Type first</div>');
            return;
        }

        var key = siteId + '|' + assetTypeId;
        _lastAssetKey = key;

        // 1) Cache hit → instant render
        if (ASSET_NUMBERS_CACHE[key]) {
            _renderAssetList(ASSET_NUMBERS_CACHE[key]);
            return;
        }

        // 2) Abort any older request still in flight
        if (_assetNumbersXHR && _assetNumbersXHR.readyState !== 4) {
            try { _assetNumbersXHR.abort(); } catch (e) { }
        }

        $('#listAsset').html('<div class="ms-dropdown-empty">Loading...</div>');

        _assetNumbersXHR = $.ajax({
            url: '/FRS25/TelemetryHistory/GetAssestBy',
            type: 'GET',
            data: { siteId: siteId, assetTypeId: assetTypeId },
            cache: true,            // let the browser cache GETs
            success: function (data) {
                // Stale-response guard: user may have changed selection again
                if (_lastAssetKey !== key) return;
                if (data && data.length > 0) {
                    data.sort(function (a, b) { return (a.Name || '').localeCompare(b.Name || ''); });
                    ASSET_NUMBERS_CACHE[key] = data;
                }
                _renderAssetList(data);
            },
            error: function (xhr, status) {
                if (status === 'abort') return;
                $('#listAsset').html('<div class="ms-dropdown-empty">Error loading assets</div>');
            }
        });
    }
