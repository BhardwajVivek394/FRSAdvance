    /* ══ History card view ══ */
    .th-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(320px,1fr));
        gap: 14px;
        padding: 4px 0;
    }

    .th-asset-card {
        position: relative;
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(24px) saturate(160%);
        -webkit-backdrop-filter: blur(24px) saturate(160%);
        border: 1px solid rgba(255,255,255,0.09);
        border-radius: 16px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.30), 0 1px 0 rgba(255,255,255,0.07) inset;
        overflow: hidden;
        transition: transform .18s, box-shadow .18s, border-color .18s;
    }

        .th-asset-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 14px;
            right: 14px;
            height: 1px;
            background: linear-gradient(90deg,transparent,var(--th-accent,#22d3ee),transparent);
            opacity: .6;
        }

        .th-asset-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 40px rgba(0,0,0,0.38);
            border-color: rgba(34,211,238,0.22);
        }

        .th-asset-card[data-state="ok"] {
            --th-accent: #34d399;
        }

        .th-asset-card[data-state="warn"] {
            --th-accent: #fbbf24;
        }

        .th-asset-card[data-state="bad"] {
            --th-accent: #fb7185;
        }

        .th-asset-card[data-state="info"] {
            --th-accent: #22d3ee;
        }

