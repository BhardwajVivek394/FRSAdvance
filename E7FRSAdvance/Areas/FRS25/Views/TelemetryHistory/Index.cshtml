    function _clearLoaderProgress() {
        $('#loader-progress').remove();
    }

    function onAllHistoryLoaded(assetResults, hasError) {
        _clearLoaderProgress();
        $("#loader").hide();


        if (hasError && assetResults.length === 0) {
            $('#divTelemetryHistory').html('<div class="text-center text-danger p-5"><i class="fas fa-exclamation-triangle fa-3x mb-3"></i><br/>Failed to load data.</div>');
            $('#divChartContainer').hide();
            $('#divPagination').hide();
            showError('Failed to fetch history data.', 'API Error');
            lastAssetResults = null;
            return;
        }

        if (assetResults.length > 0) {
            lastAssetResults = assetResults;
            renderByViewType(assetResults);
            $('#downloadContainer').show();
            var totalAttrs = 0;
            assetResults.forEach(function (a) { totalAttrs += a.attributes.length; });
            showSuccess('History data loaded. ' + assetResults.length + ' asset(s), ' + totalAttrs + ' attribute(s).', 'Data Loaded');
        } else {
            lastAssetResults = null;
            $('#divTelemetryHistory').html('<div class="text-center text-muted p-5"><i class="fas fa-inbox fa-3x mb-3"></i><br/>No history data found.</div>');
            $('#divChartContainer').hide();
            $('#divPagination').hide();
            $('#downloadContainer').hide();
            showWarning('No data found for the selected date range.', 'No Data');
        }
    }

    // Compute the user-selected datetime range from the filter inputs.
    // Returns { startMs, endMs } or null if dates are missing.
    // Compute the user-selected datetime range from the filter inputs.
    // Returns { startMs, endMs } or null if dates are missing.
    function getSelectedRange() {
        var fromDate = $('#txtFromDate').val();
        var fromTime = $('#txtFromTime').val() || '00:00';
        var toDate = $('#txtToDate').val();
        var toTime = $('#txtToTime').val() || '23:59';
        if (!fromDate || !toDate) return null;

        var fd = fromDate.split('-');
        var td = toDate.split('-');
        var ft = fromTime.split(':');
        var tt = toTime.split(':');

        var start = new Date(parseInt(fd[0]), parseInt(fd[1]) - 1, parseInt(fd[2]),
            parseInt(ft[0]) || 0, parseInt(ft[1]) || 0, 0, 0);
        var end = new Date(parseInt(td[0]), parseInt(td[1]) - 1, parseInt(td[2]),
            parseInt(tt[0]) || 23, parseInt(tt[1]) || 59, 59, 999);
        if (isNaN(start.getTime()) || isNaN(end.getTime())) return null;
        return { startMs: start.getTime(), endMs: end.getTime() };
    }
    // Datetime range from filter inputs &mdash; {startMs, endMs} or null.
    function getSelectedRange() {
        var fromDate = $('#txtFromDate').val();
        var fromTime = $('#txtFromTime').val() || '00:00';
        var toDate = $('#txtToDate').val();
        var toTime = $('#txtToTime').val() || '23:59';
        if (!fromDate || !toDate) return null;

        var fd = fromDate.split('-');
        var td = toDate.split('-');
        var ft = fromTime.split(':');
        var tt = toTime.split(':');

        var start = new Date(
            parseInt(fd[0]), parseInt(fd[1]) - 1, parseInt(fd[2]),
            parseInt(ft[0]) || 0, parseInt(ft[1]) || 0, 0, 0
        );
        var end = new Date(
            parseInt(td[0]), parseInt(td[1]) - 1, parseInt(td[2]),
            parseInt(tt[0]) || 23, parseInt(tt[1]) || 59, 59, 999
        );
        if (isNaN(start.getTime()) || isNaN(end.getTime())) return null;
        return { startMs: start.getTime(), endMs: end.getTime() };
    }

    function renderByViewType(assetResults) {
        if (telemetryChart != null) { telemetryChart.destroy(); telemetryChart = null; }
        if (historyEChart != null) { historyEChart.dispose(); historyEChart = null; }

        // Show PM toggle only when POINT MACHINE + Table view
        var selectedAssetTypeName = $('#drpAssetType option:selected').text().trim().toUpperCase();
        var isPM = (selectedAssetTypeName === 'POINT MACHINE' || selectedAssetTypeName === 'POINT_MACHINE');
        if (isPM && selectedViewType === 'Table') {
            $('#pmViewToggle').css('display', 'flex');
        } else {
            $('#pmViewToggle').hide();
            // Reset to operational when leaving PM or switching to chart
            pmViewMode = 'operational';
            $('#btnPmOperational').addClass('active');
            $('#btnPmIndication').removeClass('active');
        }

        if (selectedViewType === 'Table') {
            $('#divTelemetryHistory').show();
            $('#divChartContainer').hide();
            renderHistoryTable(assetResults);
        } else {
            $('#divTelemetryHistory').hide();
            $('#divPagination').hide();
            $('#divChartContainer').show();
            renderChart(assetResults, selectedViewType, getSelectedRange());
        }
    }

    // ===== RENDER HISTORY TABLE =====
    // For multiple assets: renders one independent table per asset
    function renderHistoryTable(assetResults) {
        // Reset per-asset cache array
        thCaches = [];
        thCurrentPages = [];

        var anyData = false;
        var html = '';

        assetResults.forEach(function (assetObj, idx) {
            var cache = parseTableData([assetObj]);  // one asset at a time
            thCaches.push(cache);
            thCurrentPages.push(1);

            if (cache.allTimestamps.length === 0) {
                html += '<div class="text-center text-muted p-3" style="border:1px solid #e2e8f0;border-radius:8px;margin-bottom:16px;">'
                    + '<i class="fas fa-inbox" style="font-size:24px;margin-bottom:8px;display:block;"></i>'
                    + 'No data found for <strong>' + (assetObj.assetName || ('Asset ' + assetObj.assetId)) + '</strong></div>';
                return;
            }

            anyData = true;
            var totalPages = Math.ceil(cache.allTimestamps.length / TH_PAGE_SIZE) || 1;
            var totalRows = cache.allTimestamps.length;

            html += '<div class="asset-table-block" id="assetBlock_' + idx + '" style="margin-bottom:24px;">';
            html += '<div class="history-table-wrapper">';
            html += '<table class="history-table" id="tblHistory_' + idx + '" style="width:auto;min-width:100%;">';
            html += buildThead(cache);
            html += '<tbody id="tblHistoryBody_' + idx + '"></tbody>';
            html += '</table></div>';
            // Per-asset pagination
            html += '<div class="px-2 pb-2 pt-1" id="pagination_' + idx + '">';
            html += '<div class="d-flex justify-content-between align-items-center flex-wrap">';
            html += '<div class="showing-records" id="showingRecords_' + idx + '">Showing 1 to '
                + Math.min(TH_PAGE_SIZE, totalRows) + ' of ' + totalRows + ' records</div>';
            html += '<nav><ul class="pagination" id="paginationUl_' + idx + '"></ul></nav>';
            html += '</div></div></div>';
        });

        if (!anyData) {
            $('#divTelemetryHistory').html('<div class="text-center text-muted p-5"><i class="fas fa-inbox fa-3x mb-3"></i><br/>No valid timestamp data found.</div>');
            $('#divPagination').hide();
            return;
        }

        $('#divPagination').hide();  // hide global pagination (each table has its own)
        $('#divTelemetryHistory').html(html);

        // Render first page of each asset table
        assetResults.forEach(function (assetObj, idx) {
            if (thCaches[idx] && thCaches[idx].allTimestamps.length > 0) {
                renderAssetTablePage(idx, 1);
            }
        });
    }

    function parseTableData(assetResults) {
        var allTimestampsSet = {};
        var attributeData = {};
        var attrDataType = {};
        var columns = [];
        var assetGroups = [];

        // PM-specific: which DataType to collect timestamps from
        var _pmTypeCheck = $('#drpAssetType option:selected').text().trim().toUpperCase();
        var _isPM = (_pmTypeCheck === 'POINT MACHINE' || _pmTypeCheck === 'POINT_MACHINE');
        var _isPMOp = _isPM && pmViewMode === 'operational';
        var _isPMInd = _isPM && pmViewMode === 'indication';

        // Normal → Reverse attrId pairs for Operational value fallback
        var PM_NORMAL_TO_REVERSE = { 1002: 6002, 2002: 7002, 1005: 6005, 3002: 8002, 4002: 9002, 3005: 8005 };

        // Op.Current cols: also fetch Max to display "Max / Avg"
        // 1002(A Avg)→1004(A NormalMax) / 6004(A ReverseMax)
        // 3002(B Avg)→3004(B NormalMax) / 8004(B ReverseMax)
        var PM_CURRENT_NORMAL_MAX = { 1002: 1004, 3002: 3004 };
        var PM_CURRENT_REVERSE_MAX = { 1002: 6004, 3002: 8004 };

        var PM_VOLTAGE_NORMAL_MAX = { 2002: 2004, 4002: 4004 };
        var PM_VOLTAGE_REVERSE_MAX = { 2002: 7004, 4002: 9004 };
        assetResults.forEach(function (assetObj) {
            var aId = assetObj.assetId;
            var aName = assetObj.assetName;
            var attrs = assetObj.attributes || [];
            var attrIdsForAsset = [];

            //attrs.forEach(function (attr) {
            //    var attrId = attr.AttributeId;
            //    var compositeKey = aId + '_' + attrId;
            //    var entries = [];
            //    var detectedType = '';
            //    var values = attr.Values;
            //    for (var key in values) {
            //        if (values.hasOwnProperty(key)) {
            //            var entry = values[key];
            //            var tsDate = new Date(entry.Timestamp.TimestampDevice);
            //            if (tsDate.getFullYear() <= 1) continue;
            //            allTimestampsSet[tsDate.getTime()] = tsDate;
            //            entries.push({ ts: tsDate, value: entry.Value });
            //            if (!detectedType && entry.DataType) detectedType = entry.DataType;
            //        }
            //    }
            //    entries.sort(function (a, b) { return a.ts.getTime() - b.ts.getTime(); });
            //    attributeData[compositeKey] = entries;
            //    attrDataType[compositeKey] = detectedType || '';
            //    attrIdsForAsset.push(attrId);
            //});

            ////attrIdsForAsset.sort(function (a, b) { return a - b; });
            ////attrIdsForAsset.forEach(function (attrId) {
            ////    var ck = aId + '_' + attrId;
            ////    var isDataLogger = (attrDataType[ck] || '').toLowerCase() === 'datalogger';
            ////    // FIXED: Use relay name for DataLogger (same as Live page)
            ////    var displayName = getAttrDisplayName(attrId, isDataLogger);
            ////    columns.push({ assetId: aId, assetName: aName, attrId: attrId, isDataLogger: isDataLogger, displayName: displayName });
            ////});
            ////assetGroups.push({ assetId: aId, assetName: aName, attrCount: attrIdsForAsset.length });
            //attrIdsForAsset.sort(function (a, b) { return a - b; });

            //// Deduplicate: two DataLogger attributes can resolve to the same relay name
            //// (e.g. both map to "TPR" via DATALOGGER_RELAY_MAP). Keep only the first occurrence.
            //var seenNames = {};
            //var filteredAttrs = [];
            //attrIdsForAsset.forEach(function (attrId) {
            //    var ck = aId + '_' + attrId;
            //    var isDataLogger = (attrDataType[ck] || '').toLowerCase() === 'datalogger';
            //    var displayName = getAttrDisplayName(attrId, isDataLogger);
            //    if (isDataLogger && seenNames[displayName]) return; // skip duplicate relay name
            //    if (isDataLogger) seenNames[displayName] = true;
            //    filteredAttrs.push({ attrId: attrId, isDataLogger: isDataLogger, displayName: displayName });
            //});

            //filteredAttrs.forEach(function (item) {
            //    columns.push({ assetId: aId, assetName: aName, attrId: item.attrId, isDataLogger: item.isDataLogger, displayName: item.displayName });
            //});
            //assetGroups.push({ assetId: aId, assetName: aName, attrCount: filteredAttrs.length });
            attrs.forEach(function (attr) {
                var attrId = attr.AttributeId;
                var entries = [];
                var detectedType = '';
                var values = attr.Values;
                for (var key in values) {
                    if (values.hasOwnProperty(key)) {
                        var entry = values[key];
                        if (!entry || !entry.Timestamp) continue;
                        var tsDate = new Date(entry.Timestamp.TimestampDevice);
                        if (tsDate.getFullYear() <= 1) continue;
                        // PM Operational: only operation event timestamps (PointMachine DataType)
                        // PM Indication:  only RDPMS periodic timestamps
                        // All others:     all timestamps
                        var _entryDT = entry.DataType || 'RDPMS';
                        var _addTs = true;
                        if (_isPMOp) _addTs = (_entryDT === 'PointMachine');
                        if (_isPMInd) _addTs = (_entryDT === 'RDPMS' || _entryDT === '');
                        if (_addTs) allTimestampsSet[tsDate.getTime()] = tsDate;
                        entries.push({ ts: tsDate, value: entry.Value });
                        if (!detectedType && entry.DataType) detectedType = entry.DataType;
                    }
                }
                entries.sort(function (a, b) { return a.ts.getTime() - b.ts.getTime(); });

                // compositeKey includes DataType so attrId=5/RDPMS and attrId=5/DataLogger
                // each get their own slot &mdash; neither overwrites the other
                var dtKey = (detectedType || 'RDPMS').toLowerCase();
                var compositeKey = aId + '_' + attrId + '_' + dtKey;
                attributeData[compositeKey] = entries;
                attrDataType[compositeKey] = detectedType || '';
                attrIdsForAsset.push({ attrId: attrId, compositeKey: compositeKey, detectedType: detectedType });
            });

            attrIdsForAsset.sort(function (a, b) { return a.attrId - b.attrId; });

            //var seenNames = {};
            //var filteredAttrs = [];
            //attrIdsForAsset.forEach(function (item) {
            //    var isDataLogger = (item.detectedType || '').toLowerCase() === 'datalogger';
            //    var displayName = getAttrDisplayName(item.attrId, isDataLogger);
            //var seenNames = {};
            //var filteredAttrs = [];
            //// Scope name resolution to THIS asset so multi-asset tables
            //// pull AttributeName from the right AssetInfo bucket (cached
            //// from the last GetUserAssetInfo call on site change).
            //CURRENT_DISPLAY_ASSET_ID = aId;
            //attrIdsForAsset.forEach(function (item) {
            //    var isDataLogger = (item.detectedType || '').toLowerCase() === 'datalogger';
            //    var displayName = getAttrDisplayName(item.attrId, isDataLogger);
            //    // For DataLogger: deduplicate by attrId (not displayName) so Combined-NWKR/RWKR/NWCR/RWCR
            //    // each get their own slot regardless of what name the relay map returns
            //    var dlDeupKey = isDataLogger ? ('DL_ATID_' + item.attrId) : null;
            //    if (isDataLogger && seenNames[dlDeupKey]) return;
            //    if (isDataLogger) seenNames[dlDeupKey] = true;
            //    filteredAttrs.push({ attrId: item.attrId, compositeKey: item.compositeKey, isDataLogger: isDataLogger, displayName: displayName });
            //});
            var seenNames = {};
            var filteredAttrs = [];
            // Scope name resolution to THIS asset so multi-asset tables
            // pull AttributeName from the right AssetInfo bucket (cached
            // from the last GetUserAssetInfo call on site change).
            CURRENT_DISPLAY_ASSET_ID = aId;
            attrIdsForAsset.forEach(function (item) {
                var isDataLogger = (item.detectedType || '').toLowerCase() === 'datalogger';

                // Whitelist: drop attributes that aren't defined for THIS asset
                // in GetUserAssetInfo. This is what prevents 'Attr NNNN'
                // placeholder columns from ever rendering.
                if (!isAttrAllowedForAsset(aId, item.attrId, isDataLogger)) {
                    return;
                }

                var displayName = getAttrDisplayName(item.attrId, isDataLogger);
                // For DataLogger: deduplicate by attrId (not displayName) so Combined-NWKR/RWKR/NWCR/RWCR
                // each get their own slot regardless of what name the relay map returns
                var dlDeupKey = isDataLogger ? ('DL_ATID_' + item.attrId) : null;
                if (isDataLogger && seenNames[dlDeupKey]) return;
                if (isDataLogger) seenNames[dlDeupKey] = true;
                filteredAttrs.push({ attrId: item.attrId, compositeKey: item.compositeKey, isDataLogger: isDataLogger, displayName: displayName });
            });
            // Always show DataLogger columns last within each asset group
            filteredAttrs.sort(function (a, b) {
                if (a.isDataLogger === b.isDataLogger) return 0;
                return a.isDataLogger ? 1 : -1;
            });

            filteredAttrs.forEach(function (item) {
                columns.push({ assetId: aId, assetName: aName, attrId: item.attrId, compositeKey: item.compositeKey, isDataLogger: item.isDataLogger, displayName: item.displayName });
            });
            assetGroups.push({ assetId: aId, assetName: aName, attrCount: filteredAttrs.length });
            CURRENT_DISPLAY_ASSET_ID = null;
        });

        // ===== POINT MACHINE VIEW MODE FILTER & REORDER =====
        var selectedAssetTypePM = $('#drpAssetType option:selected').text().trim().toUpperCase();
        if (selectedAssetTypePM === 'POINT MACHINE' || selectedAssetTypePM === 'POINT_MACHINE') {
            var colOrder = (pmViewMode === 'operational') ? PM_OP_COL_ORDER : PM_IND_COL_ORDER;
            // Pass ALL assetGroups so every asset gets its own ordered column block
            columns = buildPMOrderedColumns(columns, colOrder, null, assetGroups);
            // Recount attrCount per group after reorder
            assetGroups.forEach(function (g) {
                g.attrCount = columns.filter(function (c) { return c.assetId === g.assetId; }).length;
            });
        }
        // ===== END POINT MACHINE VIEW MODE FILTER =====

        // ===== TRACK ATTRIBUTE REORDER =====
        // For Track asset type, reorder columns to match TRACK_ATTR_ORDER sequence.
        // Unrecognised columns are appended after the ordered set.
        if (isTrackAssetType()) {
            var trackOrdered = [];
            var trackRemaining = columns.slice(); // shallow copy

            TRACK_ATTR_ORDER.forEach(function (targetName) {
                var tLower = targetName.toLowerCase().trim();
                for (var ti = 0; ti < trackRemaining.length; ti++) {
                    var colName = (trackRemaining[ti].displayName || '').toLowerCase().trim();
                    if (colName === tLower) {
                        trackOrdered.push(trackRemaining[ti]);
                        trackRemaining.splice(ti, 1);
                        return;
                    }
                }
                // partial match fallback
                for (var ti2 = 0; ti2 < trackRemaining.length; ti2++) {
                    var colName2 = (trackRemaining[ti2].displayName || '').toLowerCase().trim();
                    if (colName2.indexOf(tLower) > -1 || tLower.indexOf(colName2) > -1) {
                        trackOrdered.push(trackRemaining[ti2]);
                        trackRemaining.splice(ti2, 1);
                        return;
                    }
                }
            });

            // Append any remaining columns (not in TRACK_ATTR_ORDER) at the end
            trackRemaining.forEach(function (c) { trackOrdered.push(c); });
            columns = trackOrdered;

            // Recount attrCount per asset group after reorder
            assetGroups.forEach(function (g) {
                g.attrCount = columns.filter(function (c) { return c.assetId === g.assetId; }).length;
            });
        }
        // ===== END TRACK ATTRIBUTE REORDER =====

        //var allTimestamps = [];
        //for (var key in allTimestampsSet) allTimestamps.push(allTimestampsSet[key]);
        //allTimestamps.sort(function (a, b) { return b.getTime() - a.getTime(); });

        //var displayGrid = new Array(allTimestamps.length);

        var allTimestamps = [];
        for (var key in allTimestampsSet) allTimestamps.push(allTimestampsSet[key]);
        if (_isPMOp) {
            // Step 1: Determine direction of each timestamp from PM attr ranges
            var tsDirectionMap = {};
            var tsSortedAsc = allTimestamps.slice().sort(function (a, b) { return a.getTime() - b.getTime(); });

            tsSortedAsc.forEach(function (ts) {
                var tsMs = ts.getTime();
                var hasNormal = false, hasReverse = false;
                for (var ck in attributeData) {
                    if (ck.indexOf('_pointmachine') === -1) continue;
                    var parts = ck.split('_');
                    if (parts.length < 3) continue;
                    var aid = parseInt(parts[1]);
                    if (isNaN(aid)) continue;
                    var ents = attributeData[ck];
                    for (var ei = 0; ei < ents.length; ei++) {
                        if (ents[ei].ts.getTime() === tsMs) {
                            if (aid >= 1000 && aid < 6000) hasNormal = true;
                            if (aid >= 6000 && aid < 10000) hasReverse = true;
                            break;
                        }
                    }
                    if (hasNormal && hasReverse) break;
                }
                if (hasReverse && !hasNormal) tsDirectionMap[tsMs] = 'Reverse';
                else if (hasNormal && !hasReverse) tsDirectionMap[tsMs] = 'Normal';
                else tsDirectionMap[tsMs] = 'Unknown';
            });

            // Step 2: Build merge map &mdash; consecutive same-direction → earliest = representative
            var tsMergeMap = {}; // childMs -> repTs
            var _prevDir = null, _prevTsMs = null, _repTs = null;
            var PM_MERGE_WINDOW_MS = 120 * 1000; // safety: don't merge if gap > 2 min

            tsSortedAsc.forEach(function (ts) {
                var tsMs = ts.getTime();
                var dir = tsDirectionMap[tsMs];
                if (dir === 'Unknown') {
                    tsMergeMap[tsMs] = ts;
                    _prevDir = null; _prevTsMs = null; _repTs = null;
                    return;
                }
                var gap = (_prevTsMs !== null) ? (tsMs - _prevTsMs) : Infinity;
                if (dir !== _prevDir || gap > PM_MERGE_WINDOW_MS) {
                    _repTs = ts; // start new group, this ts is the representative
                }
                tsMergeMap[tsMs] = _repTs;
                _prevDir = dir;
                _prevTsMs = tsMs;
            });

            // Step 3: Remap attributeData entries (PointMachine only) to representative ts
            for (var ck in attributeData) {
                if (ck.indexOf('_pointmachine') === -1) continue;
                var ents = attributeData[ck];
                var changed = false;
                for (var ei = 0; ei < ents.length; ei++) {
                    var rep = tsMergeMap[ents[ei].ts.getTime()];
                    if (rep && rep.getTime() !== ents[ei].ts.getTime()) {
                        ents[ei] = { ts: rep, value: ents[ei].value };
                        changed = true;
                    }
                }
                if (changed) {
                    ents.sort(function (a, b) { return a.ts.getTime() - b.ts.getTime(); });
                    // Deduplicate: keep FIRST value per timestamp (representative's own data)
                    var deduped = [];
                    for (var di = 0; di < ents.length; di++) {
                        if (deduped.length === 0 || ents[di].ts.getTime() !== deduped[deduped.length - 1].ts.getTime()) {
                            deduped.push(ents[di]);
                        }
                    }
                    attributeData[ck] = deduped;
                }
            }

            // Step 4: Rebuild allTimestamps with only representative timestamps
            var _newTsSet = {};
            for (var ms in tsMergeMap) { var r = tsMergeMap[ms]; _newTsSet[r.getTime()] = r; }
            allTimestamps = [];
            for (var _k in _newTsSet) allTimestamps.push(_newTsSet[_k]);
            allTimestamps.sort(function (a, b) { return b.getTime() - a.getTime(); });
        }
        // ===== LAST-CHANGE ROW LOGIC =====
        var searchStartDate = null;
        var fromDateVal = $('#txtFromDate').val();
        var fromTimeVal = $('#txtFromTime').val() || '00:00';
        if (fromDateVal) {
            var dp = fromDateVal.split('-');
            var tp = fromTimeVal.split(':');
            searchStartDate = new Date(parseInt(dp[0]), parseInt(dp[1]) - 1, parseInt(dp[2]),
                parseInt(tp[0]), parseInt(tp[1]), 0, 0);
        }

        if (searchStartDate) {
            var startMs = searchStartDate.getTime();
            var preStartTs = [];
            var inRangeTs = [];
            allTimestamps.forEach(function (ts) {
                if (ts.getTime() < startMs) preStartTs.push(ts);
                else inRangeTs.push(ts);
            });

            if (preStartTs.length > 0) {
                var lastPreStartTs = preStartTs[0];
                var syntheticTs = new Date(startMs);
                syntheticTs._originalTs = lastPreStartTs;
                syntheticTs._isStartRow = true;

                for (var ck in attributeData) {
                    var entries = attributeData[ck];
                    var carryVal = null;
                    for (var ei = 0; ei < entries.length; ei++) {
                        if (entries[ei].ts.getTime() <= lastPreStartTs.getTime()) carryVal = entries[ei].value;
                        else break;
                    }
                    if (carryVal !== null) {
                        var alreadyExists = false;
                        for (var ei2 = 0; ei2 < entries.length; ei2++) {
                            if (entries[ei2].ts.getTime() === startMs) { alreadyExists = true; break; }
                        }
                        if (!alreadyExists) {
                            entries.push({ ts: syntheticTs, value: carryVal });
                            entries.sort(function (a, b) { return a.ts.getTime() - b.ts.getTime(); });
                        }
                    }
                }

                allTimestamps = [syntheticTs].concat(inRangeTs);
                allTimestamps.sort(function (a, b) { return b.getTime() - a.getTime(); });
            }
        }
        // ===== END LAST-CHANGE ROW LOGIC =====

        var displayGrid = new Array(allTimestamps.length);
        var prevRowValues = {};
        var changedCount = 0, unchangedCount = 0;

        for (var r = allTimestamps.length - 1; r >= 0; r--) {
            var rowTs = allTimestamps[r];
            var rowCells = [];
            for (var c = 0; c < columns.length; c++) {
                var col = columns[c];
                //var compositeKey = col.assetId + '_' + col.attrId;
                //var rawValue = getValueForTimestamp(attributeData[compositeKey], rowTs);
                var compositeKey = col.compositeKey;
                var rawValue;
                var _resolvedIsReverse = false;  // tracks if Reverse attrId resolved the value

                var _useExact = _isPMOp
                    && !col.isDataLogger
                    && PM_NORMAL_TO_REVERSE.hasOwnProperty(col.attrId);

                if (_useExact) {
                    // Exact match for Normal attrId (1002/2002/1005/3002/4002/3005)
                    rawValue = getExactValueForTimestamp(attributeData[compositeKey], rowTs);

                    // No exact match on Normal → check Reverse counterpart (6002/7002 etc.)
                    if (rawValue === null) {
                        var _revAttrId = PM_NORMAL_TO_REVERSE[col.attrId];
                        var _revKey = col.assetId + '_' + _revAttrId + '_pointmachine';
                        rawValue = getExactValueForTimestamp(attributeData[_revKey], rowTs);
                        if (rawValue !== null) _resolvedIsReverse = true;
                    }
                } else {
                    // Carry-forward for: RDPMS indication (25,26,576,577),
                    // DataLogger (221,222,225,226), Indication tab, Track, Signal
                    rawValue = getValueForTimestamp(attributeData[compositeKey], rowTs);
                }

                // Op.Current cols (1002, 3002): also fetch Max for "Max / Avg" display
                //var _pmMaxVal = null;
                //if (_useExact && PM_CURRENT_NORMAL_MAX.hasOwnProperty(col.attrId)) {
                //    var _maxAttrId = _resolvedIsReverse
                //        ? PM_CURRENT_REVERSE_MAX[col.attrId]   // Reverse op → use 6004 / 8004
                //        : PM_CURRENT_NORMAL_MAX[col.attrId];   // Normal op  → use 1004 / 3004
                //    var _maxKey = col.assetId + '_' + _maxAttrId + '_pointmachine';
                //    _pmMaxVal = getExactValueForTimestamp(attributeData[_maxKey], rowTs);
                //}

                var _pmMaxVal = null;
                var _isCurrentCol = PM_CURRENT_NORMAL_MAX.hasOwnProperty(col.attrId);
                var _isVoltageCol = PM_VOLTAGE_NORMAL_MAX.hasOwnProperty(col.attrId);
                if (_useExact && (_isCurrentCol || _isVoltageCol)) {
                    var _normalMaxId = _isCurrentCol ? PM_CURRENT_NORMAL_MAX[col.attrId] : PM_VOLTAGE_NORMAL_MAX[col.attrId];
                    var _reverseMaxId = _isCurrentCol ? PM_CURRENT_REVERSE_MAX[col.attrId] : PM_VOLTAGE_REVERSE_MAX[col.attrId];
                    if (_resolvedIsReverse) {
                        // Avg found on reverse side → use reverse max directly
                        _pmMaxVal = getExactValueForTimestamp(attributeData[col.assetId + '_' + _reverseMaxId + '_pointmachine'], rowTs);
                    } else {
                        // Try normal max first; if missing, fall back to reverse max
                        // (device sometimes sends only reverse max attrs when avg is absent)
                        _pmMaxVal = getExactValueForTimestamp(attributeData[col.assetId + '_' + _normalMaxId + '_pointmachine'], rowTs);
                        if (_pmMaxVal === null) {
                            _pmMaxVal = getExactValueForTimestamp(attributeData[col.assetId + '_' + _reverseMaxId + '_pointmachine'], rowTs);
                        }
                    }
                }
                var displayVal = '', cellClass = '', cellContent = '';
                if (col.isDataLogger) {
                    var _dlName = col.displayName || '';
                    if (rawValue !== null) {
                        var numVal = parseFloat(rawValue);
                        if (numVal === 1) { displayVal = _dlName + ': Pickup'; cellContent = '<span class="dl-pickup">' + (_isPM ? 'Pickup' : _dlName + ': Pickup') + '</span>'; }
                        else if (numVal === 0) { displayVal = _dlName + ': Drop'; cellContent = '<span class="dl-drop">' + (_isPM ? 'Drop' : _dlName + ': Drop') + '</span>'; }
                        else { displayVal = numVal.toFixed(3); cellContent = displayVal; }
                    } else { displayVal = '-'; cellContent = '-'; }
                } else {
                    if (_pmMaxVal !== null) {
                        // Op.Current: "Max / Avg" format matching reference screenshot
                        var _maxStr = parseFloat(_pmMaxVal).toFixed(3);
                        var _avgStr = (rawValue !== null) ? parseFloat(rawValue).toFixed(3) : '-';
                        displayVal = _maxStr + ' / ' + _avgStr;
                        if (_isCurrentCol) {
                            cellContent = '<span style="display:block;white-space:nowrap;">'
                                + '<span>' + _maxStr + '</span>'
                                + '<span> / </span>'
                                + '<span>' + _avgStr + '</span>'
                                + '</span>';
                        } else {
                            cellContent = _avgStr;
                        }
                    } else {
                        displayVal = (rawValue !== null ? parseFloat(rawValue).toFixed(3) : '-');
                        cellContent = displayVal;
                    }
                }

                if (prevRowValues[compositeKey] !== undefined && displayVal !== '-') {
                    if (displayVal !== prevRowValues[compositeKey] && prevRowValues[compositeKey] !== '-') {
                        cellClass = 'val-changed'; changedCount++;
                    } else if (displayVal === prevRowValues[compositeKey]) {
                        cellClass = 'val-unchanged'; unchangedCount++;
                    }
                }
                prevRowValues[compositeKey] = displayVal;

                // ── Apply Excel range-based color class (skip DataLogger and PM Max/Avg compound cells) ──
                if (!col.isDataLogger && rawValue !== null && _pmMaxVal === null) {
                    var rangeCls = getRangeClass(col.attrId, rawValue);
                    if (rangeCls) {
                        cellClass = (cellClass ? cellClass + ' ' : '') + rangeCls;
                    }
                }

                rowCells.push({ cls: cellClass, html: cellContent });
            }
            displayGrid[r] = rowCells;
        }

        return {
            columns: columns, assetGroups: assetGroups,
            allTimestamps: allTimestamps, attributeData: attributeData,
            displayGrid: displayGrid,
            changedCount: changedCount, unchangedCount: unchangedCount,
            isTrack: isTrackAssetType()
        };
    }

    function buildThead(cache) {
        var columns = cache.columns;
        var assetGroups = cache.assetGroups;
        var isTrack = cache.isTrack;
        var derivedColCount = isTrack ? DERIVED_COLUMNS.length : 0;
        // Track uses a distinct teal header; other types use the primary theme colour
        var themeColors = isTrack ? ['rgba(13,148,136,0.90)'] : ['var(--primary)'];
        var bg = themeColors[0];

        // ── Point Machine: custom 3-row header matching Excel ───────────
        var selectedAssetTypeHdr = $('#drpAssetType option:selected').text().trim().toUpperCase();
        var isPMHdr = (selectedAssetTypeHdr === 'POINT MACHINE' || selectedAssetTypeHdr === 'POINT_MACHINE');

        if (isPMHdr && pmViewMode === 'operational') {
            return buildPMOperationalThead(columns, assetGroups, bg);
        }
        if (isPMHdr && pmViewMode === 'indication') {
            return buildPMIndicationThead(columns, assetGroups, bg);
        }

        // ── Default generic 2-row header ─────────────────────────────────
        var h = ['<thead>'];
        h.push('<tr>');
        h.push('<th rowspan="2" style="vertical-align:middle;width:160px;min-width:160px;max-width:160px;">Date &amp; Time</th>');
        assetGroups.forEach(function (group, idx) {
            var gbg = themeColors[idx % themeColors.length];
            var totalColspan = group.attrCount + derivedColCount;
            h.push('<th colspan="' + totalColspan + '" class="th-asset-group" style="text-align:center;">');
            h.push('<i class="fas fa-cube" style="margin-right:5px; opacity:0.7;"></i>' + group.assetName);
            h.push('</th>');
        });
        h.push('</tr><tr>');
        var currentAssetIdx = 0, colsInCurrentAsset = 0;
        var pendingDLHeaders = [];
        columns.forEach(function (col, colIdx) {
            var groupIdx = 0, count = 0;
            for (var g = 0; g < assetGroups.length; g++) {
                count += assetGroups[g].attrCount;
                if (colIdx < count) { groupIdx = g; break; }
            }
            var cbg = themeColors[groupIdx % themeColors.length];
            var displayName = col.displayName || getAttrAlias(col.attrId);
            if (col.isDataLogger) {
                // Defer DataLogger header &mdash; emit it AFTER derived columns (at the very end)
                var dlHtml = '<th class="datalogger-col th-attr" title="' + displayName + ' (Role ID:' + col.attrId + ', DataLogger)">Data Logger</th>';
                pendingDLHeaders.push(dlHtml);
            } else {
                h.push('<th class="th-attr" title="' + displayName + ' (ID:' + col.attrId + ')">');
                h.push(formatAliasName(displayName) + '</th>');
            }
            colsInCurrentAsset++;
            if (colsInCurrentAsset >= assetGroups[currentAssetIdx].attrCount) {
                if (isTrack) h.push(getDerivedHeadersHtml('rgba(234,88,12,0.85)'));
                // Now emit deferred DataLogger headers AFTER derived columns
                for (var d = 0; d < pendingDLHeaders.length; d++) h.push(pendingDLHeaders[d]);
                pendingDLHeaders = [];
                currentAssetIdx++; colsInCurrentAsset = 0;
            }
        });
        h.push('</tr></thead>');
        return h.join('');
    }

    // ── PM Operational thead &mdash; matches Excel Table 1 exactly ────────────────
    // Row1(top=0):  Full-width asset+title
    // Row2(top=38): Date&Time(rowspan2) | Direction(rowspan2) | A End(colspan5) | B End(colspan5) | NWKR(rowspan2)..RWCR(rowspan2)
    // Row3(top=76): [D&T rowspan] [Dir rowspan] Current|Voltage|Time|LocInd|IndoorInd (×2 for A and B) [DL rowspans]
    function buildPMOperationalThead(columns, assetGroups, bg) {
        // Layered palette &mdash; goes from deeper at the top (title) to
        // lighter at the sub-column level. A End and B End sides get
        // distinct hues (indigo vs teal) so the two groups are
        // visually separable without being aggressive.
        var C_TITLE = 'background:rgba(30,41,59,0.95);color:rgba(255,255,255,0.85);font-weight:500;letter-spacing:0.5px;';   // slate-800 title
        var C_DT = 'background:rgba(15,22,40,0.97);color:rgba(255,255,255,0.85);border-right:1px solid rgba(255,255,255,0.08);font-weight:500;'; // Date & Time rail
        var C_DIR = 'background:rgba(20,28,48,0.97);color:rgba(255,255,255,0.78);font-weight:500;';                          // Direction rail
        var C_A = 'background:rgba(20,28,48,0.97);color:rgba(255,255,255,0.78);border-left:1px solid rgba(255,255,255,0.10);font-weight:500;letter-spacing:0.3px;'; // A End band
        var C_A_SUB = 'background:rgba(20,28,48,0.97);color:rgba(255,255,255,0.65);border-bottom:1px solid rgba(255,255,255,0.06);font-weight:500;'; // A End sub
        var C_B = 'background:rgba(20,28,48,0.97);color:rgba(255,255,255,0.78);border-left:1px solid rgba(255,255,255,0.10);font-weight:500;letter-spacing:0.3px;'; // B End band
        var C_B_SUB = 'background:rgba(20,28,48,0.97);color:rgba(255,255,255,0.65);border-bottom:1px solid rgba(255,255,255,0.06);font-weight:500;'; // B End sub
        var C_DL = 'background:rgba(20,28,48,0.97);color:rgba(255,255,255,0.55);border-left:1px solid rgba(255,255,255,0.10);font-weight:500;font-style:italic;';   // DL column (recedes)

        var T1 = 'top:0px !important;position:sticky;z-index:12;';
        var T2 = 'top:38px !important;position:sticky;z-index:11;';
        var T3 = 'top:76px !important;position:sticky;z-index:10;';
        var T2_DT = 'top:38px !important;position:sticky;left:0;z-index:22;';

        var A_IDS = [1002, 2002, 1005, 25, 26];
        var B_IDS = [3002, 4002, 3005, 576, 577];
        var DL_IDS = [225, 226, 221, 222];

        // Calculate total colspan across all assets
        var totalCols = 1; // Date & Time
        assetGroups.forEach(function (g) {
            totalCols += 1; // Direction per asset
            var aCols = columns.filter(function (c) { return c.assetId === g.assetId && A_IDS.indexOf(c.attrId) !== -1; });
            var bCols = columns.filter(function (c) { return c.assetId === g.assetId && B_IDS.indexOf(c.attrId) !== -1; });
            var dCols = columns.filter(function (c) { return c.assetId === g.assetId && c.isDataLogger; });
            totalCols += (aCols.length || 5) + (bCols.length || 5) + dCols.length;
        });

        var h = ['<thead>'];

        // ── Row 1: asset name headers (one per asset group) ─────────────────
        h.push('<tr>');
        h.push('<th rowspan="3" style="' + T1 + T2_DT.replace('top:38px', 'top:0px') + C_DT
            + 'vertical-align:middle;min-width:160px;text-align:center;font-weight:700;">'
            + 'Date &amp; Time</th>');
        assetGroups.forEach(function (g) {
            var aCols = columns.filter(function (c) { return c.assetId === g.assetId && A_IDS.indexOf(c.attrId) !== -1; });
            var bCols = columns.filter(function (c) { return c.assetId === g.assetId && B_IDS.indexOf(c.attrId) !== -1; });
            var dCols = columns.filter(function (c) { return c.assetId === g.assetId && c.isDataLogger; });
            var aSpan = aCols.length || 5;
            var bSpan = bCols.length || 5;
            var assetSpan = 1 + aSpan + bSpan + dCols.length; // Direction + A + B + DL
            h.push('<th colspan="' + assetSpan + '" style="' + T1 + C_TITLE
                + 'text-align:center;font-size:13px;'
                + 'border-bottom:1px solid rgba(255,255,255,0.10);padding:8px 12px;">'
                + '<i class="fas fa-cog" style="margin-right:6px;opacity:0.55;"></i>'
                + g.assetName + ' &mdash; Operational Historical Data</th>');
        });
        h.push('</tr>');

        // ── Row 2: Direction(rowspan2) | A End | B End | DL(rowspan2) per asset ──
        h.push('<tr>');
        assetGroups.forEach(function (g) {
            var aCols = columns.filter(function (c) { return c.assetId === g.assetId && A_IDS.indexOf(c.attrId) !== -1; });
            var bCols = columns.filter(function (c) { return c.assetId === g.assetId && B_IDS.indexOf(c.attrId) !== -1; });
            var dCols = columns.filter(function (c) { return c.assetId === g.assetId && c.isDataLogger; });
            var aSpan = aCols.length || 5;
            var bSpan = bCols.length || 5;

            h.push('<th rowspan="2" style="' + T2 + C_DIR
                + 'vertical-align:middle;min-width:100px;text-align:center;font-weight:700;">'
                + 'Direction</th>');
            if (aSpan > 0) {
                h.push('<th colspan="' + aSpan + '" style="' + T2 + C_A
                    + 'text-align:center;font-size:12.5px;'
                    + 'border-bottom:1px solid rgba(255,255,255,0.08);">A End</th>');
            }
            if (bSpan > 0) {
                h.push('<th colspan="' + bSpan + '" style="' + T2 + C_B
                    + 'text-align:center;font-size:12.5px;'
                    + 'border-bottom:1px solid rgba(255,255,255,0.08);">B End</th>');
            }
            dCols.forEach(function (col) {
                h.push('<th rowspan="2" style="' + T2 + C_DL
                    + 'vertical-align:middle;text-align:center;'
                    + 'font-size:12px;font-weight:700;min-width:110px;">'
                    + col.displayName + '</th>');
            });
        });
        h.push('</tr>');

        // ── Row 3: sub-column names under A End and B End per asset ──────────
        h.push('<tr>');
        assetGroups.forEach(function (g) {
            var aCols = columns.filter(function (c) { return c.assetId === g.assetId && A_IDS.indexOf(c.attrId) !== -1; });
            var bCols = columns.filter(function (c) { return c.assetId === g.assetId && B_IDS.indexOf(c.attrId) !== -1; });
            //aCols.forEach(function (col) {
            //    h.push('<th style="' + T3 + C_A_SUB
            //        + 'font-size:11px;font-weight:600;text-align:center;min-width:110px;">'
            //        + col.displayName + '</th>');
            //});
            //bCols.forEach(function (col) {
            //    h.push('<th style="' + T3 + C_B_SUB
            //        + 'font-size:11px;font-weight:600;text-align:center;min-width:110px;">'
            //        + col.displayName + '</th>');
            //});
            aCols.forEach(function (col) {
                var _sub = (col.attrId === 1002)
                    ? '<br><span style="font-size:10px;font-weight:400;opacity:0.8;">(Max / Avg)</span>'
                    : '';
                h.push('<th style="' + T3 + C_A_SUB
                    + 'font-size:11px;font-weight:600;text-align:center;min-width:110px;">'
                    + col.displayName + _sub + '</th>');
            });
            bCols.forEach(function (col) {
                var _sub = (col.attrId === 3002)
                    ? '<br><span style="font-size:9px;font-weight:400;opacity:0.8;">(Max / Avg)</span>'
                    : '';
                h.push('<th style="' + T3 + C_B_SUB
                    + 'font-size:11px;font-weight:600;text-align:center;min-width:110px;">'
                    + col.displayName + _sub + '</th>');
            });
        });
        h.push('</tr>');

        h.push('</thead>');
        return h.join('');
    }

    function buildPMIndicationThead(columns, assetGroups, bg) {
        var C_TITLE = 'background:rgba(30,41,59,0.95);color:rgba(255,255,255,0.85);font-weight:500;letter-spacing:0.5px;';
        var C_DT = 'background:rgba(15,22,40,0.97);color:rgba(255,255,255,0.85);border-right:1px solid rgba(255,255,255,0.08);font-weight:500;';
        var C_DIR = 'background:rgba(20,28,48,0.97);color:rgba(255,255,255,0.78);font-weight:500;';
        var C_COL = 'background:rgba(20,28,48,0.97);color:rgba(255,255,255,0.78);border-bottom:1px solid rgba(255,255,255,0.06);font-weight:500;';
        var T1 = 'top:0px !important;position:sticky;z-index:12;';
        var T2 = 'top:38px !important;position:sticky;z-index:11;';
        var T2_DT = 'top:38px !important;position:sticky;left:0;z-index:22;';

        var h = ['<thead>'];

        // ── Row 1: Date&Time(rowspan2) + one asset-name header per asset ─────
        h.push('<tr>');
        h.push('<th rowspan="2" style="' + T1.replace('top:0px', 'top:0px') + T2_DT.replace('top:38px', 'top:0px') + C_DT
            + 'vertical-align:middle;min-width:160px;text-align:center;font-weight:700;">'
            + 'Date &amp; Time</th>');
        assetGroups.forEach(function (g) {
            var gCols = columns.filter(function (c) { return c.assetId === g.assetId; });
            var span = 1 + gCols.length; // Direction + data cols
            h.push('<th colspan="' + span + '" style="' + T1 + C_TITLE
                + 'text-align:center;font-size:13px;'
                + 'border-bottom:1px solid rgba(255,255,255,0.10);padding:8px 12px;">'
                + '<i class="fas fa-signal" style="margin-right:6px;opacity:0.55;"></i>'
                + g.assetName + ' &mdash; Indication Historical Data</th>');
        });
        h.push('</tr>');

        // ── Row 2: Direction + individual column headers per asset ───────────
        h.push('<tr>');
        assetGroups.forEach(function (g) {
            var gCols = columns.filter(function (c) { return c.assetId === g.assetId; });
            h.push('<th style="' + T2 + C_DIR
                + 'min-width:90px;text-align:center;font-weight:700;">Direction</th>');
            gCols.forEach(function (col) {
                var name = col.displayName || PM_INDICATION_DISPLAY_NAMES[col.attrId] || ('Attr ' + col.attrId);
                h.push('<th style="' + T2 + C_COL
                    + 'font-size:12px;font-weight:600;text-align:center;min-width:120px;">'
                    + name + '</th>');
            });
        });
        h.push('</tr>');

        h.push('</thead>');
        return h.join('');
    }

    function renderTablePage(page) {
        // Legacy single-table path &mdash; delegate to renderAssetTablePage(0, page)
        if (thCaches && thCaches.length > 0) { renderAssetTablePage(0, page); return; }
        if (!thCache) return;
        thCurrentPage = page;
        var totalRows = thCache.allTimestamps.length;
        thTotalPages = Math.ceil(totalRows / TH_PAGE_SIZE) || 1;

        var startIdx = (page - 1) * TH_PAGE_SIZE;
        var endIdx = Math.min(startIdx + TH_PAGE_SIZE, totalRows);
        var isTrack = thCache.isTrack;
        var assetGroups = thCache.assetGroups;
        var columns = thCache.columns;
        var attributeData = thCache.attributeData;

        var selectedAssetTypeRow = $('#drpAssetType option:selected').text().trim().toUpperCase();
        var isPMRow = (selectedAssetTypeRow === 'POINT MACHINE' || selectedAssetTypeRow === 'POINT_MACHINE');

        var h = [];
        for (var r = startIdx; r < endIdx; r++) {
            var rowTs = thCache.allTimestamps[r];
            h.push('<tr>');
            h.push('<td>' + formatTimestamp(rowTs) + '</td>');

            var cells = thCache.displayGrid[r];
            var currentAssetIdx = 0;
            var colsInCurrentAsset = 0;
            var pendingDLCells = [];

            for (var c = 0; c < cells.length; c++) {
                var col = columns[c];
                var groupCount = assetGroups[currentAssetIdx] ? assetGroups[currentAssetIdx].attrCount : 999;

                // PM: inject Direction cell at the START of each asset group
                if (isPMRow && colsInCurrentAsset === 0) {
                    var assetColsForDir = columns.filter(function (col2) { return col2.assetId === (assetGroups[currentAssetIdx] ? assetGroups[currentAssetIdx].assetId : null); });
                    var dirLabel = getPMDirection(assetColsForDir, attributeData, rowTs);
                    var dirColor = dirLabel.indexOf('Reverse') !== -1 ? '#b45309' : '#1d4ed8';
                    h.push('<td style="color:' + dirColor + ';font-weight:600;white-space:nowrap;">' + dirLabel + '</td>');
                }

                var cell = cells[c];
                var cellHtml;
                if (col && col.missing) {
                    cellHtml = '<td style="color:#aaa;text-align:center;">-</td>';
                } else {
                    cellHtml = (cell.cls ? '<td class="' + cell.cls + '">' : '<td>') + cell.html + '</td>';
                }

                // Defer DataLogger cells &mdash; emit AFTER derived cells (at the very end)
                if (col && col.isDataLogger) {
                    pendingDLCells.push(cellHtml);
                } else {
                    h.push(cellHtml);
                }

                colsInCurrentAsset++;
                if (colsInCurrentAsset >= groupCount) {
                    if (isTrack) {
                        var assetId = assetGroups[currentAssetIdx].assetId;
                        var derived = calculateDerivedForRow(attributeData, columns, assetId, rowTs);
                        h.push(getDerivedCellsHtml(derived));
                    }
                    // Now emit deferred DataLogger cells AFTER derived cells
                    for (var d = 0; d < pendingDLCells.length; d++) h.push(pendingDLCells[d]);
                    pendingDLCells = [];
                    currentAssetIdx++;
                    colsInCurrentAsset = 0;
                }
            }
            h.push('</tr>');
        }
        $('#tblHistoryBody').html(h.join(''));

        fnRenderPagination(page, thTotalPages, totalRows, startIdx + 1, endIdx);

        var infoHtml = '<span class="text-muted" style="font-size:12px;"><i class="fas fa-table text-primary"></i> ';
        infoHtml += thCache.assetGroups.length + ' asset(s) · ' + thCache.columns.length + ' attribute(s)';
        if (thCache.isTrack) infoHtml += ' · <span style="color:#0369a1;"><i class="fas fa-calculator"></i> ' + DERIVED_COLUMNS.length + ' derived</span>';
        infoHtml += ' · ' + totalRows + ' row(s)';
