<script>

    // ===== TOAST NOTIFICATION SYSTEM =====
    function showToast(type, title, message, duration) {
        duration = duration || 4000;
        var icons = { success: '<i class="fas fa-check"></i>', error: '<i class="fas fa-times"></i>', warning: '<i class="fas fa-exclamation-triangle"></i>', info: '<i class="fas fa-info-circle"></i>' };
        var toastId = 'toast_' + Date.now();
        var toastHtml = '<div class="toast-notification toast-' + type + '" id="' + toastId + '"><div class="toast-icon">' + icons[type] + '</div><div class="toast-body"><div class="toast-title">' + title + '</div><div class="toast-message">' + message + '</div></div><button type="button" class="toast-close" onclick="closeToast(\'' + toastId + '\')">×</button><div class="toast-progress"></div></div>';
        $('#toastContainer').append(toastHtml);
        setTimeout(function () { closeToast(toastId); }, duration);
    }

    function closeToast(toastId) {
        var $toast = $('#' + toastId);
        if ($toast.length && !$toast.hasClass('hiding')) {
            $toast.addClass('hiding');
            setTimeout(function () { $toast.remove(); }, 300);
        }
    }

    function showSuccess(message, title) { showToast('success', title || 'Success', message); }
    function showError(message, title) { showToast('error', title || 'Error', message); }
    function showWarning(message, title) { showToast('warning', title || 'Warning', message); }
    function showInfo(message, title) { showToast('info', title || 'Information', message); }

    // ==========================================================================
    // GLOBALS
    // ==========================================================================
    var openDropdown = null;
    var debounceTimer = null;
    var selectedViewType = 'Table';
    var telemetryChart = null;
    var historyEChart = null;
    var _hgRenderFn = null;
    var lastAssetResults = null;
    var chartColors = ['#6366f1', '#8b5cf6', '#ec4899', '#f43f5e', '#f97316', '#eab308', '#22c55e', '#14b8a6', '#06b6d4', '#3b82f6', '#a855f7', '#d946ef', '#f59e0b', '#84cc16', '#0ea5e9', '#e11d48', '#7c3aed', '#059669', '#dc2626', '#2563eb'];

    // Pagination
    var TH_PAGE_SIZE = 50;
    var thCurrentPage = 1;   // kept for legacy/chart use
    var thTotalPages = 1;
    var thCache = null;       // kept for legacy use
    var thCaches = [];        // one cache per asset (multi-asset)
    var thCurrentPages = [];  // current page per asset

    // Point Machine view mode: 'operational' | 'indication'
    var pmViewMode = 'operational';

    // ==========================================================================
    // ASSET ATTRIBUTE MAPS - STORES BOTH TITLE AND ALIASNAME
    // ==========================================================================
    var assetAttributeMap = {};       // attrId → { title: "Charger mA", alias: "ITC TFC O/P(mA)" }
    var titleToAttrIdMap = {};        // "charger ma" → attrId (lowercase for lookup)
    var assetAttributeLoaded = false;

    // ==========================================================================
    // DATALOGGER RELAY NAME MAPPING (Same as Live page)
    // ==========================================================================
    var DATALOGGER_RELAY_MAP = {};
    var dataloggerNamesLoaded = false;     // tracks if map is ready for current site
    var dataloggerNamesLoadedForSite = null; // which siteId was last loaded

    // Fetch DataloggerAttribute names for a given siteId and build lookup map
    function loadDataloggerNames(siteId, callback) {
        if (!siteId || siteId === '' || siteId === '0') {
            DATALOGGER_RELAY_MAP = {};
            dataloggerNamesLoaded = true;
            dataloggerNamesLoadedForSite = null;
            if (callback) callback();
            return;
        }

        // Use cached result if same site
        if (dataloggerNamesLoadedForSite === siteId && dataloggerNamesLoaded) {
            if (callback) callback();
            return;
        }

        $.ajax({
            url: '/FRS25/TelemetryHistory/GetUserAssetInfoDatalogger?siteId=' + siteId,
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                DATALOGGER_RELAY_MAP = {};
                if (data && Array.isArray(data) && data.length > 0) {
                    data.forEach(function (item) {
                        var role = item.Role;
                        var attrName = item.DataloggerAttribute;
                        if (role !== undefined && role !== null && attrName) {
                            DATALOGGER_RELAY_MAP[role] = attrName;
                            DATALOGGER_RELAY_MAP[parseInt(role, 10)] = attrName;
                        }
                    });
                }
                dataloggerNamesLoaded = true;
                dataloggerNamesLoadedForSite = siteId;
                if (callback) callback();
            },
            error: function () {
                DATALOGGER_RELAY_MAP = {};
                dataloggerNamesLoaded = true;
                dataloggerNamesLoadedForSite = siteId;
                if (callback) callback();
            }
        });
    }




    // ==========================================================================
    // ASSET INFO MAP (GetUserAssetInfo/SiteId/{siteId})
    // ==========================================================================
    // Drives the dynamic AttributeName bindings for Point Machine columns
    // that are NOT part of the fixed hardcoded set of 10 operational labels.
    //
    // Response entries are expected to contain:
    //   AssetId, RoleType ('c' = indication / non-datalogger,
    //                      'd' = datalogger),
    //   Role             (use this to match AttributeId from history API
    //                     when RoleType = 'd'),
    //   AssetAttributeId (use this to match AttributeId from history API
    //                     when RoleType = 'c'),
    //   AttributeName    (display label shown in the table header)
    //
    // Backend proxy expected at:
    //   /FRS25/TelemetryHistory/GetUserAssetInfo?siteId={siteId}
    // which should forward to
    //   http://energy7.in:90/api/AssetInfo/GetUserAssetInfo/SiteId/{siteId}
    // ==========================================================================
    var ASSET_INFO_MAP = {};              // assetId -> [{ RoleType, Role, AssetAttributeId, AttributeName }, ...]
    var assetInfoLoaded = false;
    var assetInfoLoadedForSite = null;

    function loadAssetInfoBySite(siteId, callback) {
        if (!siteId || siteId === '' || siteId === '0') {
            ASSET_INFO_MAP = {};
            assetInfoLoaded = true;
            assetInfoLoadedForSite = null;
            if (callback) callback();
            return;
        }

        // Cache: same site, already loaded -> skip
        if (assetInfoLoadedForSite === siteId && assetInfoLoaded) {
            if (callback) callback();
            return;
        }

        $.ajax({
            url: '/FRS25/TelemetryHistory/GetUserAssetInfo?siteId=' + siteId,
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                ASSET_INFO_MAP = {};
                var data = response;
                if (response && !Array.isArray(response)) {
                    data = response.Data || response.data || response.Result || response.result || response;
                }
                if (data && Array.isArray(data) && data.length > 0) {
                    data.forEach(function (item) {
                        if (!item) return;
                        var aId = item.AssetId !== undefined ? item.AssetId : item.assetId;
                        if (aId === undefined || aId === null) return;

                        var roleType = (item.RoleType !== undefined ? item.RoleType : item.roleType);
                        roleType = (roleType || '').toString().toLowerCase().trim();

                        var role = (item.Role !== undefined ? item.Role : item.role);
                        var assetAttrId = (item.AssetAttributeId !== undefined ? item.AssetAttributeId : item.assetAttributeId);
                        var attrName = (item.AttributeName !== undefined ? item.AttributeName : item.attributeName) || '';

                        var key = String(aId);
                        if (!ASSET_INFO_MAP[key]) ASSET_INFO_MAP[key] = [];
                        ASSET_INFO_MAP[key].push({
                            RoleType: roleType,
                            Role: role,
                            AssetAttributeId: assetAttrId,
                            AttributeName: attrName
                        });
                    });
                    console.log('[AssetInfo] Loaded asset info for ' +
                        Object.keys(ASSET_INFO_MAP).length + ' asset(s), siteId=' + siteId);
                }
                assetInfoLoaded = true;
                assetInfoLoadedForSite = siteId;
                if (callback) callback();
            },
            error: function (xhr, status, error) {
                console.warn('[AssetInfo] Failed to load GetUserAssetInfo:', status, error);
                ASSET_INFO_MAP = {};
                assetInfoLoaded = true;
                assetInfoLoadedForSite = siteId;
                if (callback) callback();
            }
        });
    }

    // Lookup a single entry for (assetId, attrId, isDataLogger)
    //   isDataLogger = true  -> find RoleType='d' and Role === attrId
    //   isDataLogger = false -> find RoleType='c' and AssetAttributeId === attrId
    function getAssetInfoAttrEntry(assetId, attrId, isDataLogger) {
        if (assetId === undefined || assetId === null) return null;
        var list = ASSET_INFO_MAP[String(assetId)] || ASSET_INFO_MAP[assetId];
        if (!list || list.length === 0) return null;
        var aid = parseInt(attrId, 10);
        if (isNaN(aid)) return null;
        for (var i = 0; i < list.length; i++) {
            var entry = list[i];
            if (!entry) continue;
            if (isDataLogger) {
                if (entry.RoleType === 'd' && parseInt(entry.Role, 10) === aid) return entry;
            } else {
                if (entry.RoleType === 'c' && parseInt(entry.AssetAttributeId, 10) === aid) return entry;
            }
        }
        return null;
    }

    // Get AttributeName for a given (assetId, attrId, isDataLogger).
    // Returns null when no match in ASSET_INFO_MAP -> callers must fall back.
    function getAssetInfoAttrName(assetId, attrId, isDataLogger) {
        var entry = getAssetInfoAttrEntry(assetId, attrId, isDataLogger);
        if (!entry) return null;
        var nm = (entry.AttributeName || '').toString().trim();
        return nm || null;
    }

    function isAttrAllowedForAsset(assetId, attrId, isDataLogger) {
        return true;
    }

    // Load asset attributes from API - stores BOTH Title and AliasName








    // Load asset attributes from API - stores BOTH Title and AliasName
    function loadAssetAttributes(callback) {
        $.ajax({
            url: '/FRS25/TelemetryHistory/GetAssetAttributes',
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                var data = response;
                if (response && !Array.isArray(response)) {
                    data = response.Data || response.data || response.Result || response.result || response;
                }
                if (data && Array.isArray(data) && data.length > 0) {
                    data.forEach(function (item) {
                        var id = item.Id || item.id || item.AttributeId || item.attributeId;
                        var title = item.Title || item.title || item.Name || item.name || item.AttributeName || item.attributeName || '';
                        var alias = item.AliasName || item.aliasName || item.Alias || item.alias || '';

                        if (id !== undefined && id !== null) {
                            // Store both Title and AliasName
                            assetAttributeMap[id] = {
                                title: title,
                                alias: alias || title  // fallback to title if no alias
                            };

                            // Build reverse lookup: title (lowercase) → attrId
                            if (title) {
                                titleToAttrIdMap[title.toLowerCase().trim()] = id;
                            }
                        }
                    });
                    assetAttributeLoaded = true;
                    console.log('[AssetAttr] Loaded ' + Object.keys(assetAttributeMap).length + ' attributes');
                    console.log('[AssetAttr] Sample:', JSON.stringify(assetAttributeMap).substring(0, 500));
                }
                if (callback) callback();
            },
            error: function (xhr, status, error) {
                console.warn('[AssetAttr] Failed to load:', status, error);
                if (callback) callback();
            }
        });
    }

    // Get AliasName for display in table headers
    // FIXED: Get display name - uses relay names for DataLogger (same as Live page)
