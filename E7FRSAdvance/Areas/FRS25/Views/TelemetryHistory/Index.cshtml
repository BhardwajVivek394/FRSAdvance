    // ══════════════════════════════════════════════════
    // TELEMETRY HISTORY CARD VIEW
    // Shows latest reading for each asset as a glass card
    // ══════════════════════════════════════════════════
    function renderHistoryCards(assetResults) {
        if (!assetResults || assetResults.length === 0) {
            $('#divTelemetryHistory').html('<div style="padding:40px;text-align:center;color:rgba(255,255,255,0.35);"><i class="fas fa-inbox" style="font-size:32px;display:block;margin-bottom:12px;opacity:.4;"></i>No data found.</div>');
            return;
        }

        var html = '<div class="th-cards-grid">';

        assetResults.forEach(function (assetObj) {
            var cache = parseTableData([assetObj]);
            var assetName = assetObj.assetName || ('Asset ' + assetObj.assetId);
            var totalRows = cache.allTimestamps.length;

            if (totalRows === 0) {
                html += '<div class="th-asset-card" data-state="info">';
                html += '<div class="th-card-head"><div><div class="th-card-name">' + assetName + '</div><div class="th-card-sub">No data in range</div></div></div>';
                html += '</div>';
                return;
            }

            // Latest row = index 0 (sorted descending)
            var latestTs = cache.allTimestamps[0];
            var latestCells = cache.displayGrid[0];
            var columns = cache.columns;

            // Determine state from changed values
            var changedCols = 0;
            latestCells.forEach(function (c) { if (c.cls === 'val-changed') changedCols++; });
            var state = changedCols > 0 ? 'warn' : 'info';

            html += '<div class="th-asset-card" data-state="' + state + '">';

            // Card head
            var rowCountBadge = '<span class="th-card-badge">' + totalRows + ' row' + (totalRows !== 1 ? 's' : '') + '</span>';
            html += '<div class="th-card-head">';
            html += '<div><div class="th-card-name">' + assetName + '</div>';
            html += '<div class="th-card-sub"><i class="fas fa-clock" style="margin-right:3px;"></i>' + formatTimestamp(latestTs) + '</div></div>';
            html += rowCountBadge + '</div>';

            // Attribute grid (show up to 12 attrs, non-derived)
            var displayed = 0;
            var maxDisplay = 12;
            html += '<div class="th-attr-grid">';
            for (var i = 0; i < columns.length && displayed < maxDisplay; i++) {
                var col = columns[i];
                if (col.isDataLogger) continue; // show DL in footer pills
                var cell = latestCells[i];
                if (!cell) continue;
                var label = (col.displayName || 'Attr').substring(0, 18);
                var val = cell.html || '&mdash;';
                // Strip HTML tags for plain display
                var plainVal = val.replace(/<[^>]+>/g, '');
                html += '<div>';
                html += '<span class="th-attr-lbl">' + label + '</span>';
                html += '<span class="th-attr-val' + (cell.cls === 'val-changed' ? ' changed' : '') + '">' + plainVal + '</span>';
                html += '</div>';
                displayed++;
            }
            if (displayed === 0) {
                html += '<div style="grid-column:1/-1;padding:14px;text-align:center;color:rgba(255,255,255,0.28);font-size:11px;">No attribute data</div>';
            }
            html += '</div>';

            // Card footer: DL badges + timestamp
            var dlPills = '';
            for (var j = 0; j < columns.length; j++) {
                var col2 = columns[j];
                if (!col2.isDataLogger) continue;
                var cell2 = latestCells[j];
                if (!cell2 || !cell2.html || cell2.html === '-') continue;
                var isDrop = cell2.html.indexOf('drop') > -1 || cell2.html.indexOf('Drop') > -1;
                var ic = isDrop ? 'fa-arrow-down' : 'fa-arrow-up';
                var pillColor = isDrop ? 'rgba(251,113,133,0.14)' : 'rgba(52,211,153,0.14)';
                var textColor = isDrop ? '#fb7185' : '#34d399';
                var borderColor = isDrop ? 'rgba(251,113,133,0.28)' : 'rgba(52,211,153,0.28)';
                var name = (col2.displayName || '').substring(0, 16);
                dlPills += '<span style="display:inline-flex;align-items:center;gap:4px;padding:2px 7px;border-radius:999px;font-size:10px;font-weight:700;background:' + pillColor + ';border:1px solid ' + borderColor + ';color:' + textColor + ';font-family:JetBrains Mono,monospace;">';
                dlPills += '<i class="fas ' + ic + '" style="font-size:8px;"></i>' + name + '</span>';
            }
            html += '<div class="th-card-foot">';
            html += '<div style="display:flex;flex-wrap:wrap;gap:4px;flex:1;">' + dlPills + '</div>';
            html += '<div class="th-ts">' + totalRows + ' records</div>';
            html += '</div>';

            html += '</div>'; // th-asset-card
        });

        html += '</div>';
        $('#divTelemetryHistory').html(html);
        $('#divPagination').hide();
    }

    // Override renderByViewType to handle Cards view
    var _origRenderByViewType = window.renderByViewType;
    window.renderByViewType = function (assetResults) {
        if (selectedViewType === 'Cards') {
