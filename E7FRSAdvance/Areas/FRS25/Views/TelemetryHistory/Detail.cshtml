@{ ViewBag.Title = "Telemetry History";
                Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml"; }
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="~/assets/js/paho-mqtt.js"></script>

<style>
    /* ══ TELEMETRY HISTORY DETAIL — Energy7 theme ══
       Every colour reads the --e7-* tokens (e7-energy7-theme.css), which
       switch between the light and dark schemes, so each rule is written once.
       #e7Body-prefixed rules beat aurora-telemetry.css / aurora-bridge.css. */

    /* Aurora tokens → theme tokens (this page only) */
    #e7Body {
        --at-brand: var(--e7-accent);
        --at-brand-deep: var(--e7-accent-ink);
        --at-brand-glow: transparent;
        --at-violet: var(--e7-c2);
        --at-ok: var(--e7-green);
        --at-warn: var(--e7-amber);
        --at-bad: var(--e7-red);
        --at-info: var(--e7-c2);
        --at-g1: var(--e7-surface-2);
        --at-g2: var(--e7-surface);
        --at-g3: var(--e7-surface-3);
        --at-g4: var(--e7-border);
        --at-edge: var(--e7-border);
        --at-edge-s: var(--e7-border-2);
        --at-t1: var(--e7-heading);
        --at-t2: var(--e7-text-2);
        --at-t3: var(--e7-text-3);
        --at-t4: var(--e7-text-4);
    }

    /* Page header */
    #e7Body .e7-body .at-page-header { color: var(--e7-heading) !important; }
    #e7Body .e7-body .at-page-eyebrow { color: var(--e7-accent); }
    #e7Body .e7-body .at-page-eyebrow::before { background: linear-gradient(90deg, var(--e7-accent), transparent); }

    #e7Body .e7-body .at-page-title {
        background: none;
        -webkit-background-clip: border-box;
        background-clip: border-box;
        -webkit-text-fill-color: var(--e7-heading);
        color: var(--e7-heading);
    }

    #e7Body .e7-body .at-page-sub { color: var(--e7-text-3); }

    /* Filter bar */
    #e7Body .e7-body .at-filter-bar {
        background: var(--e7-surface) !important;
        border: 1px solid var(--e7-border) !important;
        box-shadow: var(--e7-shadow-soft);
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
    }

    #e7Body .e7-body .at-filter-label { color: var(--e7-heading); }
    #e7Body .e7-body .at-filter-label i { color: var(--e7-accent); }
    #e7Body .e7-body .at-filter-sep { background: var(--e7-border); }
    #e7Body .e7-body .at-field > span { color: var(--e7-text-3); }
    #e7Body .e7-body .at-field-select::after { color: var(--e7-text-3); }

    #e7Body .e7-body .at-field select {
        background-color: var(--e7-surface-2) !important;
        border: 1px solid var(--e7-border-2) !important;
        color: var(--e7-text) !important;
        color-scheme: light;
    }

    html:not([data-aurora="light"]) #e7Body .e7-body .at-field select { color-scheme: dark; }

    #e7Body .e7-body .at-field select:hover {
        background-color: var(--e7-surface-3) !important;
        border-color: var(--e7-accent) !important;
    }

    #e7Body .e7-body .at-field select:focus {
        outline: none;
        background-color: var(--e7-surface) !important;
        border-color: var(--e7-accent) !important;
        box-shadow: 0 0 0 3px var(--e7-accent-soft) !important;
    }

    /* aurora-bridge.css paints dark-scheme option lists navy with !important */
    #e7Body .e7-body select option {
        background-color: var(--e7-surface) !important;
        color: var(--e7-text) !important;
    }

    /* Buttons */
    #e7Body .e7-body .at-btn {
        background: var(--e7-surface-2) !important;
        border: 1px solid var(--e7-border-2) !important;
        color: var(--e7-text) !important;
        box-shadow: none;
    }

    #e7Body .e7-body .at-btn:hover {
        background: var(--e7-surface-3) !important;
        border-color: var(--e7-accent) !important;
        color: var(--e7-heading) !important;
    }

    #e7Body .e7-body .at-btn-primary,
    #e7Body .e7-body .at-btn-primary:hover {
        background: linear-gradient(120deg, var(--e7-ask-from), var(--e7-ask-to)) !important;
        border-color: transparent !important;
        color: #fff !important;
    }

    /* Results card */
    #e7Body .e7-body .at-table-card {
        background: var(--e7-surface) !important;
        border: 1px solid var(--e7-border) !important;
        box-shadow: var(--e7-shadow-card);
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
    }

    #e7Body .e7-body .at-table-card-head {
        background: transparent !important;
        border-bottom: 1px solid var(--e7-border) !important;
    }

    #e7Body .e7-body .at-table-card-title { color: var(--e7-heading); }

    #e7Body .e7-body .at-t-icon {
        background: var(--e7-accent-soft);
        border-color: transparent;
        color: var(--e7-accent);
        box-shadow: none;
    }

    #tablePager {
        text-align: right;
        padding: 8px 16px;
    }

    #e7Body .at-row-count {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        font-weight: 700;
        font-family: 'JetBrains Mono',monospace;
        padding: 3px 10px;
        border-radius: 999px;
        background: var(--e7-accent-soft) !important;
        border: 1px solid transparent !important;
        color: var(--e7-accent-ink) !important;
    }

    /* Date pill */
    #e7Body .at-date-pill {
        display: flex;
        align-items: center;
        height: 38px;
        background: var(--e7-surface-2) !important;
        border: 1px solid var(--e7-border-2) !important;
        border-radius: 8px;
        overflow: hidden;
    }

        #e7Body .e7-body .at-date-pill input {
            height: 100%;
            background: transparent !important;
            border: none !important;
            outline: none;
            box-shadow: none !important;
            color: var(--e7-text) !important;
            font-size: 12.5px;
            padding: 0 10px;
            font-family: 'JetBrains Mono',monospace;
            min-width: 0;
        }

            #e7Body .e7-body .at-date-pill input::placeholder {
                color: var(--e7-text-4) !important;
            }

        #e7Body .at-date-pill .at-sep {
            color: var(--e7-text-4);
            font-size: 12px;
            flex-shrink: 0;
            user-select: none;
        }

        #e7Body .at-date-pill:focus-within {
            border-color: var(--e7-accent) !important;
            box-shadow: 0 0 0 3px var(--e7-accent-soft);
        }

    /* Result table */
    #listView .history-table-wrapper {
        overflow-x: auto;
        overflow-y: auto;
        max-height: 62vh;
    }

    #listView table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
        font-family: 'JetBrains Mono',monospace;
    }

        #e7Body #listView table thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background: var(--e7-surface-2);
            color: var(--e7-text-2);
            padding: 9px 12px;
            text-align: center;
            font-weight: 600;
            font-size: 11.5px;
            border-bottom: 1px solid var(--e7-border-2);
            white-space: nowrap;
        }

        #e7Body #listView table tbody tr {
            border-bottom: 1px solid var(--e7-border);
            transition: background .12s;
            background-color: var(--e7-surface) !important;
        }

            #e7Body #listView table tbody tr:nth-child(even) {
                background-color: var(--e7-surface-2) !important;
            }

            #e7Body #listView table tbody tr:hover {
                background-color: var(--e7-surface-3) !important;
            }

        #e7Body #listView table tbody td {
            padding: 7px 10px;
            text-align: center;
            color: var(--e7-text) !important;
            white-space: nowrap;
        }

            #e7Body #listView table tbody td:first-child {
                color: var(--e7-heading) !important;
                font-weight: 600;
                text-align: left;
            }

            #e7Body #listView table tbody td.val-changed {
                color: var(--e7-green) !important;
                font-weight: 700;
            }

            #e7Body #listView table tbody td.val-unchanged {
                color: var(--e7-text-3) !important;
            }

        #e7Body #listView table thead th.derived-col {
            background: var(--e7-violet-soft) !important;
            color: var(--e7-violet);
            border-left: 2px solid var(--e7-border-2);
        }

        #e7Body #listView table tbody td.derived-val {
            background: var(--e7-violet-soft);
            color: var(--e7-violet) !important;
            font-weight: 500;
            border-left: 1px solid var(--e7-border);
        }

    .dl-pickup {
        color: var(--e7-green) !important;
        font-weight: 700;
    }

    .dl-drop {
        color: var(--e7-red) !important;
        font-weight: 700;
    }

    /* Pagination */
    #tablePager .pagination {
        display: flex;
        gap: 4px;
        margin: 0;
        padding: 0;
        list-style: none;
        justify-content: flex-end;
    }

    #e7Body #tablePager .page-link {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 600;
        color: var(--e7-text-2) !important;
        background: var(--e7-surface) !important;
        border: 1px solid var(--e7-border-2) !important;
        border-radius: 6px;
        text-decoration: none;
        transition: all .18s;
        min-width: 34px;
        height: 32px;
        font-family: 'JetBrains Mono',monospace;
    }

        #e7Body #tablePager .page-link:hover {
            background: var(--e7-accent-soft) !important;
            border-color: var(--e7-accent) !important;
            color: var(--e7-accent-ink) !important;
        }

    #e7Body #tablePager .page-item.active .page-link {
        background: var(--e7-accent) !important;
        color: #fff !important;
        border-color: var(--e7-accent) !important;
    }

    #tablePager .page-item.disabled .page-link {
        opacity: .30;
        cursor: not-allowed;
        pointer-events: none;
    }
</style>

@* PAGE HEADER *@
<div class="at-page-header">
    <div>
        <div class="at-page-eyebrow"><i class="fas fa-history"></i> RDPMS &middot; Telemetry</div>
        <h1 class="at-page-title">Telemetry History</h1>
        <p class="at-page-sub">Historical asset readings with date-range search</p>
    </div>
</div>

@* FILTER BAR *@
<div class="at-filter-bar">
    <span class="at-filter-label"><i class="fas fa-filter"></i> Filters</span>
    <div class="at-filter-sep"></div>
    <div class="at-field at-field-select">
        <span>Zone</span>
        @Html.DropDownList("ZoneId", (IEnumerable<SelectListItem>)ViewBag.Zones, "All", new { @class = "form-control", @id = "drpZones", tabindex = 1 })
    </div>
    <div class="at-field at-field-select">
        <span>Division</span>
        @Html.DropDownList("DivisionId", (IEnumerable<SelectListItem>)ViewBag.Divisions, "All", new { @class = "form-control", @id = "drpDivisions", tabindex = 2 })
    </div>
    <div class="at-field at-field-select">
        <span>Site</span>
        @Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites, "All", new { @class = "form-control", @id = "drpSite", tabindex = 3 })
    </div>
    <div class="at-field at-field-select">
        <span>Asset Type</span>
        @Html.DropDownList("AssetTypeId", (IEnumerable<SelectListItem>)ViewBag.AssetTypes, "All", new { @class = "form-control", @id = "drpAssetType", tabindex = 4 })
    </div>
    <div class="at-field at-field-select">
        <span>Asset No.</span>
        <select class="form-control" id="drpAsset"></select>
    </div>
    <div class="at-filter-sep"></div>
    <div class="at-field at-field-date">
        <span>From</span>
        <div class="at-date-pill">
            <input type="text" id="txtFromDate" placeholder="Date" tabindex="5" />
            <span class="at-sep">&middot;</span>
            <input type="text" id="txtFromTime" placeholder="00:00" tabindex="6" style="width:72px;" />
        </div>
    </div>
    <div class="at-field at-field-date">
        <span>To</span>
        <div class="at-date-pill">
            <input type="text" id="txtToDate" placeholder="Date" tabindex="7" />
            <span class="at-sep">&middot;</span>
            <input type="text" id="txtToTime" placeholder="00:00" tabindex="8" style="width:72px;" />
        </div>
    </div>
    <div class="at-filter-sep"></div>
    <button type="button" class="at-btn at-btn-primary" onclick="fnSearchView()" style="align-self:flex-end;margin-bottom:0;">
        <i class="fas fa-search"></i> Search
    </button>
    <div id="downloadContainer" style="display:none;align-self:flex-end;">
        <button class="at-btn at-btn-sm" id="btn2" title="Export">
            <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                <path d='M4 16.004V17a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1M12 4.5v11m3.5-3.5L12 15.5 8.5 12' />
            </svg>
            Export
        </button>
    </div>
</div>

@* RESULTS CARD *@
<div class="at-table-card">
    <div class="at-table-card-head">
        <div class="at-table-card-title">
            <span class="at-t-icon"><i class="fas fa-history"></i></span>
            Historical Readings
        </div>
        <div class="at-table-card-actions">
            <span class="at-row-count" id="atHistRowCount" style="display:none;">—</span>
            <div id="tablePager"></div>
        </div>
    </div>
    <div class="at-table-scroll">
        <div id="listView"></div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#txtFromDate').datepicker({ dateFormat: 'm/d/yy', autoClose: true });
        $('#txtToDate').datepicker({ dateFormat: 'm/d/yy', autoClose: true });
        $('#txtFromTime').clockpicker({ placement: 'bottom', align: 'right', autoclose: true, 'default': '00:00' });
        $('#txtToTime').clockpicker({ placement: 'bottom', align: 'right', autoclose: true, 'default': '00:00' });
        $('#drpZones').change(function () { GetDivisionByZone($(this).val()); });
        $('#drpDivisions').change(function () { GetByDivisionId($(this).val()); });
        $('#drpAssetType').change(function () { GetByAssest($('#drpSite').val(), $(this).val()); });
    });

    function GetDivisionByZone(zoneId) {
        if (!zoneId) return;
        $("#loader").show();
        $.ajax({
            url: '/FRS25/Telemetry/GetDivisionByZoneId', type: 'POST', data: '{zoneId:' + zoneId + '}', contentType: 'application/json',
            success: function (data) { $("#loader").hide(); $("#drpDivisions").empty().append($("<option></option>").val('0').html('All')); $.each(data, function (k, v) { $("#drpDivisions").append($("<option></option>").val(v.Id).html(v.Name)); }); },
            error: function () { $("#loader").hide(); CommonNotification("ERROR", "Something went wrong!", "Error"); }
        });
    }
    function GetByDivisionId(divisionId) {
        if (!divisionId) return;
        $("#loader").show();
        $.ajax({
            url: '/FRS25/Telemetry/GetSiteByDivisionId', type: 'POST', data: '{divisionId:' + divisionId + '}', contentType: 'application/json',
            success: function (data) { $("#loader").hide(); $("#drpSite").empty().append($("<option></option>").val('0').html('All')); $.each(data, function (k, v) { $("#drpSite").append($("<option></option>").val(v.Id).html(v.Name)); }); },
            error: function () { $("#loader").hide(); CommonNotification("ERROR", "Something went wrong!", "Error"); }
        });
    }
    function GetByAssest(siteId, assetTypeId) {
        if (!siteId || !assetTypeId) return;
        $("#loader").show();
        $.ajax({
            url: '/FRS25/Telemetry/GetAssestBy', type: 'POST', data: '{siteId:' + siteId + ',assetTypeId:' + assetTypeId + '}', contentType: 'application/json',
            success: function (data) { $("#loader").hide(); $("#drpAsset").empty().append($("<option></option>").val('0').html('All')); $.each(data, function (k, v) { $("#drpAsset").append($("<option></option>").val(v.Id).html(v.Name)); }); },
            error: function () { $("#loader").hide(); CommonNotification("ERROR", "Something went wrong!", "Error"); }
        });
    }

    function fnSearchView() {
        var isValid = true;
        var mAsset = {};
        mAsset.Id = $('#drpAsset').val(); mAsset.SiteId = $('#drpSite').val();
        mAsset.AssetTypeId = $('#drpAssetType').val();
        mAsset.StartDate = $('#txtFromDate').val(); mAsset.EndDate = $('#txtToDate').val();
        mAsset.StartTime = $('#txtFromTime').val(); mAsset.EndTime = $('#txtToTime').val();
        mAsset.IsReadHttpPost = false;
        if (!mAsset.SiteId) { isValid = false; alert('Please select a site'); }
        else if (!mAsset.AssetTypeId) { isValid = false; alert('Please select an asset type'); }
        else if (!mAsset.Id) { isValid = false; alert('Please select an asset'); }
        else if (!mAsset.StartDate) { isValid = false; alert('Please select From Date'); }
        else if (!mAsset.EndDate) { isValid = false; alert('Please select To Date'); }
        if (isValid) {
            $("#loader").show();
            $.ajax({
                url: '/FRS25/Telemetry/_DetailList', type: 'Post',
                data: '{asset:' + JSON.stringify(mAsset) + '}', contentType: 'application/json', dataType: 'html',
                success: function (data) {
                    $("#loader").hide(); $('#listView').empty().append(data); $('#downloadContainer').show();
                    var rows = $('#listView table tbody tr').length;
                    if (rows > 0) { $('#atHistRowCount').text(rows + ' record' + (rows !== 1 ? 's' : '')).show(); }
                },
                error: function () { $("#loader").hide(); CommonNotification("ERROR", "Something went wrong!", "Error"); }
            });
        }
    }
    function fnBindTable() {
        var m = { SearchCriteria: { SiteId: $('#drpSite').val(), Id: $('#drpAsset').val(), AssetTypeId: $('#drpAssetType').val() } };
        $.ajax({
            url: '/FRS25/Telemetry/_Table', type: 'POST', contentType: 'application/json', data: JSON.stringify(m),
            success: function (data) { $('#divTelemetryLive').empty().append(data); },
            error: function () { $("#loader").hide(); CommonNotification("ERROR", "Something went wrong!", "Error"); }
        });
    }
    function fnBindYard() {
        var m = { SiteId: $('#drpSite').val(), Id: $('#drpAsset').val(), AssetTypeId: $('#drpAssetType').val() };
        $.ajax({
            url: '/FRS25/Telemetry/_Yard', type: 'POST', contentType: 'application/json', data: JSON.stringify(m),
            success: function (data) { $('#divTelemetryLive').empty().append(data); },
            error: function () { $("#loader").hide(); CommonNotification("ERROR", "Something went wrong!", "Error"); }
        });
    }
</script>
