    /* ========================================================================
     ANALYSIS  CALM READABLE REDESIGN
     Softer palette, generous spacing, plain-language storytelling.
     ======================================================================== */
    #eldApp {
        --calm-ink: #2b3a52; /* soft charcoal for body copy */
        --calm-ink-soft: #6b7890; /* muted secondary text */
        --calm-line: #e8edf6; /* very light divider */
        --calm-surface: #ffffff;
        --calm-tint: #f6f8fc; /* soft panel wash */
        --calm-blue: #3f74e0;
        --calm-blue-wash: #eef3fe;
        --calm-green: #2f9e6a; /* softened restore green */
        --calm-green-wash: #edf8f2;
        --calm-red: #d6607a; /* muted rose instead of harsh red */
        --calm-red-wash: #fdf0f3;
        --calm-amber: #c58a3a; /* warm ochre instead of alarm orange */
        --calm-amber-wash: #fbf5ea;
        --calm-shadow: 0 1px 2px rgba(30,45,80,.04), 0 8px 24px rgba(30,45,80,.05);
        --calm-shadow-sm: 0 1px 2px rgba(30,45,80,.05);
    }

        #eldApp .an-wrap {
            color: var(--calm-ink);
            animation: anFade .4s ease
        }

    @@keyframes anFade {
        from {
            opacity: 0;
            transform: translateY(4px)
        }

        to {
            opacity: 1;
            transform: none
        }
    }

    /* Story hero  the plain-language headline */
    #eldApp .an-hero {
        background: var(--calm-surface);
        border: 1px solid var(--calm-line);
        border-radius: 18px;
        padding: 26px 28px;
