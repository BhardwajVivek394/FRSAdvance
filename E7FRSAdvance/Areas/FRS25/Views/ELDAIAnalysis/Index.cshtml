@{
    ViewBag.Title = "ELD AI Analysis";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}

<meta charset="utf-8">
<script>
(function(){
    var PROXY = '@Url.Action("Proxy", "ELDAIAnalysis", new { area = "FRS25" })';

    function rewriteUrl(url) {
        if (typeof url === 'string' && (url.startsWith('/api/eld') || url.startsWith('/api/sip') || url.startsWith('/eld/'))) {
            var raw = url.substr(1);
            var qi = raw.indexOf('?');
            var path = qi >= 0 ? raw.substr(0, qi) : raw;
            var qs = qi >= 0 ? '&' + raw.substr(qi + 1) : '';
            return PROXY + '?p=' + path + qs;
        }
        return url;
    }

    // Intercept fetch()
    var _fetch = window.fetch;
    window.fetch = function(url, opts) {
        return _fetch.call(this, rewriteUrl(url), opts);
    };

    // Intercept jQuery ajax (sip.js may use $.get/$.ajax)
    // FRS advance: the FRS25 layout loads jQuery AFTER the page body, so patch it once it exists.
    function patchJq() {
        if (!window.jQuery || window.jQuery.__eldProxyPatched) return;
        var _ajax = jQuery.ajax;
        jQuery.ajax = function(urlOrSettings, settings) {
            if (typeof urlOrSettings === 'string') {
                urlOrSettings = rewriteUrl(urlOrSettings);
            } else if (urlOrSettings && urlOrSettings.url) {
                urlOrSettings.url = rewriteUrl(urlOrSettings.url);
            }
            return _ajax.call(this, urlOrSettings, settings);
        };
        jQuery.__eldProxyPatched = true;
    }
    patchJq();
    document.addEventListener('DOMContentLoaded', patchJq);

    // Intercept XMLHttpRequest (fallback)
    var _open = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function(method, url) {
        arguments[1] = rewriteUrl(url);
        return _open.apply(this, arguments);
    };
})();
</script>
<link href="~/Areas/FRS25/assets/css/sip.css" rel="stylesheet" />
<style>

    #eldApp {
        --bg: #f4f6fb;
        --panel: #ffffff;
        --panel2: #f7f9fd;
        --line: #e3e8f2;
        --txt: #1b2436;
        --mut: #6b7890;
        --up: #159a58;
        --down: #e03e52;
        --warn: #c9781a;
        --accent: #2f6fed;
        --chip: #eef2fb;
        --alert: #e03e52;
    }

        #eldApp * {
            box-sizing: border-box
        }

    #eldApp {
        margin: 0;
        background: var(--bg);
        color: var(--txt);
        font: 14px/1.5 system-ui,Segoe UI,Roboto,sans-serif
    }

        #eldApp header {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 13px 22px;
            border-bottom: 1px solid var(--line);
            background: var(--panel);
            position: sticky;
            top: 0;
            z-index: 5;
            box-shadow: 0 1px 3px rgba(20,30,60,.04)
        }

            #eldApp header h1 {
                font-size: 17px;
                margin: 0;
                font-weight: 680
            }

        #eldApp .spacer {
            flex: 1
        }

        #eldApp .live {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 12px;
            color: var(--mut)
        }

            #eldApp .live .pulse {
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: var(--up);
                animation: pulse 1.8s infinite
            }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(21,154,88,.5)
        }

        70% {
            box-shadow: 0 0 0 7px rgba(21,154,88,0)
        }

        100% {
            box-shadow: 0 0 0 0 rgba(21,154,88,0)
        }
    }

    #eldApp button {
        font: inherit;
        cursor: pointer;
        border: 1px solid var(--line);
        background: var(--chip);
        color: var(--txt);
        border-radius: 8px;
        padding: 7px 12px
    }

        #eldApp button:hover {
            border-color: var(--accent);
            color: var(--accent)
        }

        #eldApp button.primary {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff
        }

            #eldApp button.primary:hover {
                filter: brightness(1.05);
                color: #fff
            }

    #eldApp .layout {
        display: grid;
        grid-template-columns: 1fr 300px;
        gap: 18px;
        padding: 18px 22px;
        max-width: 1500px;
        margin: 0 auto
    }

    @@media(max-width:980px) {
        #eldApp .layout {
            grid-template-columns: 1fr
        }
    }

    /* attention banner */
    #eldApp .attn {
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 16px;
        border: 1px solid var(--line);
        background: var(--panel)
    }

        #eldApp .attn.has {
            border-color: var(--alert);
            background: linear-gradient(0deg,#fff, #fff6f7)
        }

        #eldApp .attn.clear {
            border-color: var(--up)
        }

        #eldApp .attn h2 {
            margin: 0 0 10px
        }

        #eldApp .attn .clearmsg {
            color: var(--up);
            font-weight: 600
        }

    #eldApp .attnrow {
        display: flex;
        flex-wrap: wrap;
        gap: 8px
    }

    #eldApp .achip {
        display: flex;
        flex-direction: column;
        gap: 1px;
        border: 1px solid var(--line);
        border-radius: 9px;
        padding: 8px 11px;
        cursor: pointer;
        background: var(--panel);
        min-width: 150px
    }

        #eldApp .achip:hover {
            box-shadow: 0 3px 10px rgba(30,50,90,.10)
        }

        #eldApp .achip.alert {
            border-left: 4px solid var(--alert)
        }

        #eldApp .achip.down {
            border-left: 4px solid var(--warn)
        }

        #eldApp .achip .a1 {
            font-weight: 700;
            font-size: 13px
        }

        #eldApp .achip .a2 {
            font-size: 11px;
            color: var(--mut)
        }

        #eldApp .achip .atag {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .03em
        }

        #eldApp .achip.alert .atag {
            color: var(--alert)
        }

        #eldApp .achip.down .atag {
            color: var(--warn)
        }

    /* filter chips */
    #eldApp .chips {
        display: flex;
        gap: 8px;
        margin-bottom: 14px;
        flex-wrap: wrap
    }

    #eldApp .chip {
        font-size: 12px;
        padding: 6px 12px;
        border-radius: 20px;
        border: 1px solid var(--line);
        background: var(--panel);
        cursor: pointer;
        color: var(--mut)
    }

        #eldApp .chip.on {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
            font-weight: 600
        }

    #eldApp h2 {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--mut);
        margin: 0 0 10px
    }

    #eldApp .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(250px,1fr));
        gap: 14px
    }

    #eldApp .card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 14px;
        cursor: pointer;
        transition: box-shadow .15s,border-color .15s
    }

        #eldApp .card:hover {
            box-shadow: 0 4px 16px rgba(30,50,90,.10);
            border-color: #c9d4ea
        }

        #eldApp .card.trip {
            border-color: var(--warn)
        }

        #eldApp .card.alert {
            border-color: var(--alert);
            box-shadow: 0 0 0 1px var(--alert) inset
        }

        #eldApp .card .top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 8px
        }

    #eldApp .sitetag {
        font-size: 10px;
        font-weight: 700;
        color: var(--mut);
        background: var(--chip);
        padding: 2px 8px;
        border-radius: 20px;
        text-transform: uppercase;
        letter-spacing: .04em
    }

    #eldApp .card .supply {
        font-weight: 750;
        font-size: 13px;
        color: #111826;
        margin-top: 6px
    }

    #eldApp .card .name {
        font-weight: 600;
        font-size: 13px;
        color: var(--accent)
    }

    #eldApp .card .id {
        color: var(--mut);
        font-size: 11px
    }

    #eldApp .badge {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 20px;
        white-space: nowrap
    }

        #eldApp .badge.up {
            background: rgba(21,154,88,.12);
            color: var(--up)
        }

        #eldApp .badge.down {
            background: rgba(224,62,82,.11);
            color: var(--down)
        }

        #eldApp .badge.unk {
            background: var(--chip);
            color: var(--mut)
        }

    #eldApp .outcome {
        margin-top: 10px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 700;
        padding: 4px 11px;
        border-radius: 8px
    }

        #eldApp .outcome.Normal {
            background: rgba(21,154,88,.10);
            color: var(--up)
        }

        #eldApp .outcome.Explained {
            background: rgba(201,120,26,.12);
            color: var(--warn)
        }

        #eldApp .outcome.ALERT {
            background: rgba(224,62,82,.12);
            color: var(--alert)
        }

        #eldApp .outcome.pending {
            background: var(--chip);
            color: var(--mut)
        }

    #eldApp .card .chk {
        margin-top: 8px;
        font-size: 11px;
        color: var(--accent)
    }

    #eldApp .row {
        display: flex;
        justify-content: space-between;
        margin-top: 8px;
        color: var(--mut);
        font-size: 12px
    }

        #eldApp .row b {
            color: var(--txt);
            font-weight: 600
        }

    #eldApp .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px
    }

        #eldApp .dot.on {
            background: var(--up)
        }

        #eldApp .dot.off {
            background: var(--down)
        }

    /* sidebar */
    #eldApp .side {
        display: flex;
        flex-direction: column;
        gap: 16px
    }

    #eldApp .sitebox {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 10px
    }

    #eldApp .siteitem {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 9px 10px;
        border-radius: 9px;
        cursor: pointer
    }

        #eldApp .siteitem:hover {
            background: var(--panel2)
        }

        #eldApp .siteitem.on {
            background: var(--chip);
            outline: 1px solid var(--accent)
        }

        #eldApp .siteitem .snm {
            font-weight: 650
        }

        #eldApp .siteitem .sc {
            margin-left: auto;
            display: flex;
            gap: 5px
        }

    #eldApp .pillc {
        font-size: 10px;
        font-weight: 800;
        padding: 2px 7px;
        border-radius: 20px
    }

        #eldApp .pillc.a {
            background: rgba(224,62,82,.13);
            color: var(--alert)
        }

        #eldApp .pillc.d {
            background: rgba(201,120,26,.14);
            color: var(--warn)
        }

        #eldApp .pillc.t {
            background: var(--chip);
            color: var(--mut)
        }

        #eldApp .pillc.chg {
            background: rgba(224,62,82,.13);
            color: var(--down)
        }

        #eldApp .pillc.ok {
            background: rgba(21,154,88,.13);
            color: var(--up)
        }

    #eldApp .events {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 6px;
        max-height: 46vh;
        overflow: auto
    }

    #eldApp .ev {
        display: flex;
        gap: 9px;
        align-items: center;
        padding: 8px
    }

        #eldApp .ev + .ev {
            border-top: 1px solid var(--line)
        }

        #eldApp .ev .k {
            font-size: 10px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 20px
        }

            #eldApp .ev .k.trip {
                background: rgba(224,62,82,.11);
                color: var(--down)
            }

            #eldApp .ev .k.restore {
                background: rgba(21,154,88,.12);
                color: var(--up)
            }

        #eldApp .ev .t {
            color: var(--mut);
            font-size: 10px;
            margin-left: auto;
            white-space: nowrap
        }

    #eldApp .muted {
        color: var(--mut)
    }

    /* modal */
    #eldApp .ov {
        position: fixed;
        inset: 0;
        background: rgba(20,30,55,.35);
        display: none;
        align-items: flex-start;
        justify-content: center;
        padding: 34px 16px;
        z-index: 20;
        overflow: auto
    }

        #eldApp .ov.show {
            display: flex
        }

    #eldApp .modal {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 14px;
        width: min(940px,100%);
        padding: 20px;
        box-shadow: 0 20px 60px rgba(20,30,60,.25)
    }

        #eldApp .modal .hd {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px
        }

            #eldApp .modal .hd .id {
                color: var(--mut);
                font-size: 12px
            }

    #eldApp .kv {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        margin: 10px 0 4px;
        font-size: 13px
    }

    #eldApp .check {
        font-size: 12px;
        color: var(--accent);
        background: rgba(47,111,237,.07);
        border: 1px solid rgba(47,111,237,.18);
        border-radius: 8px;
        padding: 6px 10px;
        margin: 6px 0
    }

    #eldApp .verdict {
        border-radius: 10px;
        padding: 14px;
        margin: 14px 0;
        background: var(--panel2);
        border: 1px solid var(--line)
    }

        #eldApp .verdict .vtag {
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .05em
        }

        #eldApp .verdict.explained {
            border-color: var(--warn)
        }

            #eldApp .verdict.explained .vtag {
                color: var(--warn)
            }

        #eldApp .verdict.alert {
            border-color: var(--alert)
        }

            #eldApp .verdict.alert .vtag {
                color: var(--alert)
            }

        #eldApp .verdict.normal {
            border-color: var(--up)
        }

            #eldApp .verdict.normal .vtag {
                color: var(--up)
            }

        #eldApp .verdict.neutral .vtag {
            color: var(--mut)
        }

    #eldApp .gear {
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 10px 12px;
        margin-bottom: 8px;
        background: var(--panel)
    }

        #eldApp .gear.hit {
            border-color: var(--down)
        }

        #eldApp .gear .gname {
            font-weight: 650
        }

    #eldApp .gtype {
        font-size: 11px;
        color: var(--mut);
        background: var(--chip);
        padding: 1px 7px;
        border-radius: 6px;
        margin-left: 6px
    }

    #eldApp table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 6px;
        font-size: 12px
    }

    #eldApp th, #eldApp td {
        text-align: left;
        padding: 4px 8px;
        border-bottom: 1px solid var(--line)
    }

    #eldApp th {
        color: var(--mut);
        font-weight: 600
    }

    #eldApp .drop {
        color: var(--down);
        font-weight: 700
    }

    #eldApp pre {
        white-space: pre-wrap;
        background: var(--panel2);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 10px;
        font-size: 12px;
        color: var(--mut)
    }

    #eldApp .loading {
        color: var(--mut);
        padding: 26px;
        text-align: center
    }

    #eldApp input[type=datetime-local], #eldApp input[type=number] {
        background: var(--panel);
        border: 1px solid var(--line);
        color: var(--txt);
        border-radius: 7px;
        padding: 6px 8px;
        font: inherit
    }

    #eldApp label.f {
        font-size: 12px;
        color: var(--mut);
        display: flex;
        flex-direction: column;
        gap: 4px
    }

    #eldApp .controls {
        display: flex;
        gap: 12px;
        align-items: flex-end;
        flex-wrap: wrap;
        margin: 14px 0;
        padding: 12px;
        background: var(--panel2);
        border: 1px solid var(--line);
        border-radius: 10px
    }

    #eldApp .vals {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        margin-top: 6px
    }

    #eldApp .pill {
        font-size: 11px;
        background: var(--chip);
        border-radius: 6px;
        padding: 2px 7px;
        color: var(--txt);
        font-variant-numeric: tabular-nums
    }

        #eldApp .pill.z {
            background: rgba(224,62,82,.10);
            color: var(--down)
        }
        /* change that happened IN the window (the drop that explains the trip) = red */
        #eldApp .pill.chg {
            background: rgba(224,62,82,.16);
            color: var(--down);
            font-weight: 700
        }
        /* already down before the window (pre-existing, not the cause) = amber */
        #eldApp .pill.pre {
            background: rgba(201,120,26,.14);
            color: var(--warn)
        }
    /* one attribute per ROW: name left, its timestamped values right */
    #eldApp .attrow {
        display: flex;
        gap: 12px;
        align-items: baseline;
        padding: 6px 0;
        border-top: 1px solid var(--line)
    }

        #eldApp .attrow:first-child {
            border-top: none
        }

        #eldApp .attrow .aname {
            flex: 0 0 190px;
            font-size: 12px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap
        }

        #eldApp .attrow .vals {
            margin-top: 0;
            flex: 1 1 auto;
            min-width: 0
        }

    #eldApp .gear.chg {
        border-color: var(--down)
    }

    #eldApp .gear.pre {
        border-color: var(--warn)
    }
    /* nav tabs & logs */
    #eldApp .nav-tabs {
        display: flex;
        gap: 6px;
        margin-left: 14px
    }

    #eldApp .nav-btn {
        font-size: 13px;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: var(--panel);
        color: var(--mut);
        cursor: pointer
    }

        #eldApp .nav-btn.active {
            background: var(--accent);
            color: #fff;
            border-color: var(--accent)
        }

    #eldApp .log-card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 14px
    }

        #eldApp .log-card.DOWN {
            border-left: 4px solid #e6a700
        }
        /* yellow = down */
        #eldApp .log-card.UP {
            border-left: 4px solid var(--up)
        }
    /* green = up */
    #eldApp .log-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        flex-wrap: wrap;
        gap: 8px
    }

    #eldApp .log-title {
        font-weight: 700;
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 8px
    }

    #eldApp .log-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
        font-size: 12px
    }

        #eldApp .log-table th, #eldApp .log-table td {
            padding: 8px 10px;
            border-bottom: 1px solid var(--line);
            text-align: left;
            vertical-align: top
        }

        #eldApp .log-table th {
            background: var(--panel2);
            color: var(--mut)
        }

    #eldApp select {
        background: var(--panel);
        border: 1px solid var(--line);
        color: var(--txt);
        border-radius: 7px;
        padding: 6px 8px;
        font: inherit
    }

    /* Verbose Loader Styles */
    #eldApp .verbose-loader-card {
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 22px 24px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.06);
        margin-bottom: 24px;
    }

    #eldApp .vloader-hd {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    #eldApp .vloader-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        #eldApp .vloader-title h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
        }

    #eldApp .spinner-ring {
        width: 20px;
        height: 20px;
        border: 3px solid rgba(47,111,237,0.2);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        100% {
            transform: rotate(360deg);
        }
    }

    #eldApp .vloader-pct {
        font-size: 24px;
        font-weight: 800;
        color: var(--accent);
        font-variant-numeric: tabular-nums;
    }

    #eldApp .vprogress-track {
        height: 12px;
        background: var(--chip);
        border-radius: 6px;
        overflow: hidden;
        margin-bottom: 20px;
    }

    #eldApp .vprogress-fill {
        height: 100%;
        background: linear-gradient(90deg, #2f6fed, #159a58);
        width: 0%;
        transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 6px;
    }

    #eldApp .vstats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 12px;
        margin-bottom: 20px;
    }

    #eldApp .vstat-box {
        background: var(--panel2);
        border: 1px solid var(--line);
        border-radius: 8px;
        padding: 10px 14px;
    }

        #eldApp .vstat-box .lbl {
            font-size: 11px;
            color: var(--mut);
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        #eldApp .vstat-box .val {
            font-size: 14px;
            font-weight: 700;
            color: var(--txt);
            margin-top: 2px;
        }

