              style="padding:9px 12px; border:1px solid var(--accent); border-radius:8px; background:var(--panel2); color:var(--txt); font-size:13.5px; font-weight:700; cursor:pointer; min-width:130px">
        <option value="">All Sites</option>
      </select>
    </label>
    <div style="display:flex; gap:8px">
      <button class="nav-btn active" id="mapFilterAllBtn" onclick="filterMappingCategory('all')">All Assets</button>
      <button class="nav-btn" id="mapFilterTrackBtn" onclick="filterMappingCategory('TRACK')">Track</button>
      <button class="nav-btn" id="mapFilterSigBtn" onclick="filterMappingCategory('SIGNAL')">Signal</button>
      <button class="nav-btn" id="mapFilterPointBtn" onclick="filterMappingCategory('POINT MACHINE')">Point Machine</button>
      <button class="nav-btn" id="mapFilterIpsBtn" onclick="filterMappingCategory('IPS')">IPS</button>
    </div>
    <div style="display:flex; gap:6px; margin-left:auto">
      <button class="an-ghost" onclick="setAllMappingCards(true)">Expand all</button>
      <button class="an-ghost" onclick="setAllMappingCards(false)">Collapse all</button>
    </div>
  </div>

  <!-- Dynamic Cards Container (Only THIS container is re-rendered when filtering) -->
  <div id="mappingCardsContainer">
    <div class="loading">Loading authoritative ELD asset & attribute mapping inventory&#8230;</div>
  </div>
</div>

<!-- detail + analysis modal -->
<div class="ov" id="ov">
  <div class="modal">
    <div class="hd">
      <div><span id="mTitle" style="font-weight:700;font-size:16px"></span>
        <span class="id" id="mSub"></span></div>
      <button onclick="closeModal()">&#10005; Close</button>
    </div>
    <div id="mDetail"><div class="loading">Loading detail&#8230;</div></div>
    <div id="mBody"></div>
  </div>
</div>

<!-- &#9472;&#9472; SIP View (yard-diagram replay) &#8212; populated by sip.js &#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472;&#9472; -->
<div id="sipView" style="display:none"></div>

</div>
<script>
    var ELD_ENDPOINTS = {
        list: '@Url.Action("GetList", "ELDAIAnalysis", new { area = "FRS25" })',
        sites: '@Url.Action("GetSites", "ELDAIAnalysis", new { area = "FRS25" })',
        state: '@Url.Action("GetState", "ELDAIAnalysis", new { area = "FRS25" })',
        detail: '@Url.Action("GetDetail", "ELDAIAnalysis", new { area = "FRS25" })',
        analyze: '@Url.Action("PostAnalyze", "ELDAIAnalysis", new { area = "FRS25" })',
        logs: '@Url.Action("GetLogs", "ELDAIAnalysis", new { area = "FRS25" })',
        historyAnalysis: '@Url.Action("GetHistoryAnalysis", "ELDAIAnalysis", new { area = "FRS25" })',
        mappingOverview: '@Url.Action("GetMappingOverview", "ELDAIAnalysis", new { area = "FRS25" })',
        health: '@Url.Action("GetHealth", "ELDAIAnalysis", new { area = "FRS25" })',
        aiSummary: '@Url.Action("PostAiSummary", "ELDAIAnalysis", new { area = "FRS25" })',
        logsRebuild: '@Url.Action("PostLogsRebuild", "ELDAIAnalysis", new { area = "FRS25" })',
    };
</script>
<script>
const _$ = s => typeof s === "string" ? document.querySelector(s) : s;
// Env-driven (injected by the server from config.SHOW_ASSET_ID). Default OFF \u2192 asset ids hidden everywhere.
const SHOW_ASSET_ID = (typeof window.SHOW_ASSET_ID !== 'undefined') ? !!window.SHOW_ASSET_ID : false;
let CURRENT = null;
let SITE_FILTER = null;      // null = all sites
let STATUS_FILTER = 'all';   // all | alert | down | normal
let ELDS = [];
let MAPPING_OK = true;

function badge(t){
  if(t===true)  return '<span class="badge down">\u25cf DOWN</span>';
  if(t===false) return '<span class="badge up">\u25cf UP</span>';
  return '<span class="badge unk">\u25cb \u2014</span>';
}
function fmtTime(s){ if(!s) return '\u2014'; try{return new Date(s).toLocaleString();}catch{return s;} }
function isZero(v){ return typeof v==='number' && Math.abs(v)<0.05; }
function ocClass(w){ return (w==='ALERT'||w==='Explained'||w==='Normal')?w:'pending'; }

async function loadList(){
  try{
    const r = await fetch(ELD_ENDPOINTS.list); const d = await r.json();
    ELDS = d.elds; MAPPING_OK = d.mapping_ok !== false;
    render();
  }catch(err){ _$('#eldGrid').innerHTML = `<div class="loading">List error: ${err}</div>`; }
}

async function loadSites(){
  try{
    const r = await fetch(ELD_ENDPOINTS.sites); const d = await r.json();
    ALL_SITES = d.sites || [];
    populateLogFilters();
    populateAnalysisFilters();
    // Red/green summary from the live ELD list (new taxonomy): changed vs ok
    const sm = es => { const ch = es.filter(e => (e.changed_count||0) > 0).length; return {total: es.length, changed: ch, ok: es.length - ch}; };
    const pills = s => `<span class="pillc t">${s.total}</span>${s.changed?`<span class="pillc chg">${s.changed} changed</span>`:''}${s.ok?`<span class="pillc ok">${s.ok} ok</span>`:''}`;
    let html = `<div class="siteitem ${SITE_FILTER===null?'on':''}" onclick="setSite(null)">
        <span class="snm">All sites</span><span class="sc">${pills(sm(ELDS))}</span></div>`;
    html += ALL_SITES.map(s=>`
      <div class="siteitem ${SITE_FILTER===s.id?'on':''}" onclick="setSite(${s.id})">
        <span class="snm">${s.name}</span>
        <span class="sc">${pills(sm(ELDS.filter(e=>String(e.site_id)===String(s.id))))}</span></div>`).join('');
    _$('#siteBox').innerHTML = html;
  }catch(err){}
}

async function loadEvents(){
  try{
    const r = await fetch(ELD_ENDPOINTS.state); const d = await r.json();
    if(!d.events.length) return;
    _$('#events').innerHTML = d.events.map(ev=>`
      <div class="ev">
        <span class="k ${ev.kind}">${ev.kind.toUpperCase()}</span>
        <span>${ev.eld_name||'ELD '+ev.eld_id}<br><span class="muted" style="font-size:10px">${ev.site_name||''}</span></span>
        <span class="t">${fmtTime(ev.timestamp)}</span>
      </div>`).join('');
  }catch(err){}
}

function setSite(id){ SITE_FILTER = id; loadSites(); render(); }
function setStatus(f){ STATUS_FILTER = f;
  document.querySelectorAll('.chip').forEach(c=>c.classList.toggle('on', c.dataset.f===f));
  render(); }

// Colour = CHANGE, not up/down. red = an attribute changed (up or down) \u00b7 green = no change \u00b7
// grey = no map. Direction (up/down) is shown ONLY by the arrow / filter chips.
function healthCat(e){
  if((e.changed_count || 0) > 0) return 'fault';   // red \u2014 attribute(s) changed
  if(e.outcome === 'No map')      return 'unknown'; // grey \u2014 nothing mapped
  return 'normal';                                  // green \u2014 no change
}

// One compact tile inside a status-board group. Arrow = up/down; health colour = left edge;
// gear-change tiles carry a count badge. Click \u2192 live detail.
function boardTile(e){
  const isDown = (e.down !== undefined && e.down !== null) ? e.down : e.tripped;
  const name = e.eld_name || e.supply_name || ('ELD '+e.eld_id);
  const supply = e.supply_name || '';
  const site = e.site_name || '';
  const nch = e.changed_count || 0;
  // Left border: red = changed \u00b7 green = up \u00b7 yellow = down \u00b7 grey = no map.
  const bcls = nch > 0 ? 'b-chg' : (e.outcome === 'No map' ? 'b-nomap' : (isDown ? 'b-down' : 'b-up'));
  const tag = (nch > 0) ? `<span class="bt-tag">${nch} attribute${nch===1?'':'s'} changed</span>` : '';
  const arrow = isDown ? '\u25bc' : '\u25b2';
  return `<div class="btile ${bcls}" onclick="openModal(${e.eld_id})" title="${name} \u2014 click for live detail">
      <div class="bt-top">
        <span class="bt-arrow ${isDown?'down':'up'}">${arrow}</span>
        <span class="bt-name">${name}</span>
        ${site?`<span class="sitetag">${site}</span>`:''}
      </div>
      ${tag?`<div class="bt-tagrow">${tag}</div>`:''}
      ${supply?`<div class="bt-sub">${supply}</div>`:''}
    </div>`;
}

function render(){
  const attn = _$('#attn');
  if(!MAPPING_OK && !ELDS.length){
    attn.className = 'attn has';
    attn.innerHTML = `<h2>Mapping unavailable</h2>
      <div style="color:var(--alert);font-weight:600">\u2715 Could not load ELD mapping from the mapping API.</div>
      <div class="muted" style="margin-top:6px">This host can't reach the mapping/historian service. Open
      <b><a href="' + ELD_ENDPOINTS.health + '" target="_blank">/api/eld/health</a></b> to see exactly what's failing
      (mapping API, historian, credentials).</div>`;
    _$('#eldGrid').innerHTML = '';
    return;
  }
  let list = ELDS.slice();
  if(SITE_FILTER!==null) list = list.filter(e=>e.site_id===SITE_FILTER);

  // Needs attention = ELDs where one or more ATTRIBUTES changed (up or down), most-changed first.
  const issues = list.filter(e => (e.changed_count||0) > 0)
    .sort((a,b)=> (b.changed_count||0) - (a.changed_count||0));
  if(issues.length){
    attn.className = 'attn has';
    attn.innerHTML = `<h2>Needs attention (${issues.length})</h2><div class="attnrow">${
      issues.map(e=>{
        const n = e.changed_count || 1;
        return `<div class="achip down" onclick="openModal(${e.eld_id})">
        <span class="atag">${n} attribute${n===1?'':'s'} changed</span>
        <span class="a1">${e.eld_name||e.supply_name}</span>
        <span class="a2">${e.site_name}${e.supply_name?(' \u00b7 '+e.supply_name):''}${SHOW_ASSET_ID?(' \u00b7 id '+e.eld_id):''}</span></div>`;
      }).join('')}</div>`;
  }else{
    attn.className = 'attn clear';
    attn.innerHTML = `<h2>Needs attention</h2><div class="clearmsg">\u2713 All clear${SITE_FILTER!==null?' for this site':''} \u2014 no ELD issues.</div>`;
  }

  // \u2500\u2500 Status board: grouped by CHANGE (not up/down). up/down = arrow + the Down/Up chips. \u2500\u2500
  const isDownE = e => ((e.down!=null) ? e.down : e.tripped);
  const groupOf = e => {
    if((e.changed_count || 0) > 0) return 'change';   // an attribute changed (up or down)
    if(e.outcome === 'No map')     return 'nomap';    // nothing mapped
    return 'nochange';                                // no change in the last window
  };
  const GROUPS = [
    {key:'change',    label:'Attributes changed', cls:'g-red',   desc:'One or more attributes changed at the last transition \u2014 up or down'},
    {key:'nochange',  label:'No change',          cls:'g-green', desc:'No attribute changed in the last window'},
    {key:'nomap',     label:'No map',             cls:'g-grey',  desc:'Nothing mapped to this ELD'},
  ];
  // Chips filter the ELD set (by change or by up/down state); the board then groups by change.
  let flist = list;
  if(STATUS_FILTER === 'change')      flist = list.filter(e => (e.changed_count||0) > 0);
  else if(STATUS_FILTER === 'down')   flist = list.filter(e => isDownE(e));
  else if(STATUS_FILTER === 'healthy')flist = list.filter(e => !isDownE(e));
  const showGroups = ['change','nochange','nomap'];

  const buckets = {};
  flist.forEach(e => { const g = groupOf(e); (buckets[g] = buckets[g] || []).push(e); });

  let boardHtml = GROUPS
    .filter(G => showGroups.includes(G.key) && (buckets[G.key]||[]).length)
    .map(G => {
      const items = buckets[G.key];
      return `<section class="board-grp ${G.cls}">
        <div class="bg-head">
          <span class="bg-dot"></span>
          <span class="bg-title">${G.label}</span>
          <span class="bg-count">${items.length}</span>
          <span class="bg-desc">${G.desc}</span>
        </div>
        <div class="bg-grid">${items.map(boardTile).join('')}</div>
      </section>`;
    }).join('');
  if(!boardHtml) boardHtml = `<div class="loading">No ELDs match this filter.</div>`;
  const gridEl = _$('#eldGrid');
  gridEl.className = 'board';
  gridEl.innerHTML = boardHtml;
}

// \u2500\u2500 modal \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
async function openModal(id){
  CURRENT = id;
  // Loading placeholder must NOT leak the asset id when SHOW_ASSET_ID is off.
  _$('#mTitle').textContent = SHOW_ASSET_ID ? ('ELD ' + id) : 'Loading detail\u2026';
  _$('#mSub').textContent = '';
  _$('#mDetail').innerHTML = '<div class="loading">Loading live detail\u2026</div>';
  _$('#mBody').innerHTML = '';
  _$('#ov').classList.add('show');
  try{
    const r = await fetch(`${ELD_ENDPOINTS.detail}?id=${id}`); const d = await r.json();
    _$('#mTitle').textContent = d.eld_name || d.supply_name || (SHOW_ASSET_ID ? ('ELD '+id) : 'ELD detail');
    _$('#mSub').textContent = `\u00b7 ${d.site_name||''}${d.supply_name?(' \u00b7 '+d.supply_name):''}${SHOW_ASSET_ID?(' \u00b7 id '+id):''}`;
    renderDetail(d);
  }catch(err){ _$('#mDetail').innerHTML = `<div class="loading">Detail error: ${err}</div>`; }
}
function closeModal(){ _$('#ov').classList.remove('show'); CURRENT=null; }

function tOnly(s){ if(!s) return ''; try{return new Date(s).toLocaleTimeString();}catch{return s;} }
function numFmt(v){ return (typeof v==='number')?(Math.round(v*1000)/1000):v; }

function renderDetail(d){
  const gears = d.gears.map(g=>{
    const thr = g.down_threshold;
    // ANY change in the window (drop, restore, OR a transient dip) \u2192 RED. Direction \u2260 good/bad.
    const gChanged = g.changed || g.justifies || g.restored;
    const gbadge = gChanged ? '<span class="badge down">changed in window</span>'
                 : '<span class="badge up">no change in window</span>';
    const attrs = (g.attributes||[]).map(a=>{
      const aChanged = a.changed || a.justifies || a.restored;
      const abadge = aChanged ? '<span class="badge down">changed here</span>' : '';
      const pts = (a.series||[]).map(p=>{
        return `<span class="pill ${aChanged ? 'chg' : ''}">${tOnly(p.ts)} \u00b7 <b>${numFmt(p.value)}</b></span>`;
      }).join('');
      return `<div class="attrow"><div class="aname">${a.name} ${abadge}</div>
        <div class="vals">${pts||'<span class="muted">\u2014</span>'}</div></div>`;
    }).join('');
    const gcls = gChanged ? 'chg' : '';
    return `<div class="gear ${gcls}"><div class="gname">${g.asset_name}<span class="gtype">${g.asset_type}</span> ${gbadge}</div>
      ${attrs||'<div class="muted">no relevant readings in this window</div>'}</div>`;
  }).join('');
  const isDown = (d.down !== undefined && d.down !== null) ? d.down : d.tripped;

  // Power supply (the ELD's OWN reading from historian) \u2014 shown as the FIRST card in the
  // effected-gears section below. RED = the value actually CHANGED in the window (not just down).
  const ps = d.power_supply;
  let psCard = '';
  if(ps){
    const s = ps.series || [];
    const psAttrs = ps.attributes || [];
    const first = s.length ? numFmt(s[0].value) : null;
    const psChanged = psAttrs.some(a => a.changed === true);
    const psbadge = psChanged ? '<span class="badge down">changed here</span>'
                              : '<span class="badge up">steady in window</span>';
    const psRows = psAttrs.length ? psAttrs.map(a=>{
      const aSeries = a.series || [];
      const aChanged = aSeries.length > 1 && aSeries.some(p => numFmt(p.value) !== numFmt(aSeries[0].value));
      const pts = aSeries.length
        ? aSeries.map(p => `<span class="pill ${aChanged?'chg':''}">${tOnly(p.ts)} \u00b7 <b>${numFmt(p.value)}</b></span>`).join('')
        : `<span class="pill">${a.end_value==null?'\u2014':numFmt(a.end_value)}</span>`;
      return `<div class="attrow"><div class="aname">${a.name} ${aChanged?'<span class="badge down">changed here</span>':''}</div><div class="vals">${pts}</div></div>`;
    }).join('') : `<div class="attrow"><div class="aname">Supply reading</div><div class="vals">${s.length ? s.map(p => `<span class="pill ${psChanged?'chg':''}">${tOnly(p.ts)} \u00b7 <b>${numFmt(p.value)}</b></span>`).join('') : `<span class="pill">${ps.value==null?'\u2014':numFmt(ps.value)}</span>`}</div></div>`;
    psCard = `<div class="gear ${psChanged?'chg':''} ps-card"><div class="gname">${ps.name||ps.asset_name}<span class="gtype ps">POWER SUPPLY (IPS)</span> ${psbadge}</div>
      ${psRows}</div>`;
  }

  // The one number that matters \u2014 attributes that CHANGED in this window (matches the board badge).
  const changedInWin = (d.outcome && d.outcome.changes) ? d.outcome.changes.length : 0;

  _$('#mDetail').innerHTML = `
    <div class="kv">
      <span>Last reading (WebSocket): <b>${d.reading==null?'\u2014':d.reading}</b></span>
      <span>State: ${badge(isDown)}</span>
      <span class="muted">device time ${fmtTime(d.reading_ts || d.last_update)}</span>
    </div>
    <div class="kv" style="margin-top:6px">
      <span><b style="color:${changedInWin?'var(--down)':'var(--up)'}">${changedInWin}</b> attribute${changedInWin===1?'':'s'} changed in this window</span>
    </div>
    ${d.check?`<div class="check">Power check: <b>${d.check}</b></div>`:''}
    <h2 style="margin-top:14px">Power supply &amp; affected assets \u2014 readings around the event (${d.gear_count})</h2>
    <div class="muted" style="margin:-6px 0 10px;font-size:12px;line-height:1.5">
      Window: <b>${Math.round((d.before_min||0)*60)} sec before \u2192 ${Math.round((d.after_min||0)*60)} sec after</b> the event (event at ${fmtTime(d.pivot)}). Every reading in the window is shown, so multiple values on a row means it changed.
      <span class="pill chg" style="font-size:10px">red</span> = value actually changed within the window.
    </div>
    ${psCard}${gears || '<div class="muted">No mapped assets.</div>'}`;
}

async function runAnalysis(){
  if(CURRENT===null) return;
  _$('#mBody').innerHTML = '<div class="loading">Fetching gear history & asking AI\u2026</div>';
  const preSec = _$('#mPreSec') ? parseFloat(_$('#mPreSec').value || '120') : 120;
  const postSec = _$('#mPostSec') ? parseFloat(_$('#mPostSec').value || '5') : 5;
  const w = preSec / 60;
  const pv = _$('#mPivot').value;
  let url = `${ELD_ENDPOINTS.analyze}?id=${CURRENT}&window_min=${w}&pre_sec=${preSec}&post_sec=${postSec}`;
  if(pv) url += `&pivot=${encodeURIComponent(new Date(pv).toISOString())}`;
  try{
    const r = await fetch(url,{method:'POST'});
    if(!r.ok) throw new Error(await r.text());
    renderAnalysis(await r.json());
  }catch(err){ _$('#mBody').innerHTML = `<div class="loading">Error: ${err.message||err}</div>`; }
}

function attrTable(list){
  if(!list.length) return '';
  return `<table><tr><th>Attribute</th><th>Before</th><th>After</th><th>%</th></tr>${
    list.map(a=>`<tr><td>${a.name} <span class="muted">[${a.data_type}]</span></td>
      <td>${a.before}</td><td class="${a.dropped?'drop':''}">${a.after}</td>
      <td>${a.pct===null?'\u2014':a.pct+'%'}</td></tr>`).join('')}</table>`;
}

function renderAnalysis(d){
  const ai = d.ai||{}; const st = ai.verdict || d.status || '';
  const vc = st==='ALERT'?'alert':st==='Explained'?'explained':st==='Normal'?'normal':'neutral';
  const hit = d.gears.filter(g=>g.affected);
  const rest = d.gears.filter(g=>!g.affected);
  const eldIsDown = (d.eld_down !== undefined && d.eld_down !== null) ? d.eld_down : d.eld_tripped;
  let html = `
    <div class="verdict ${vc}">
      <span class="vtag">${st||'\u2014'}</span>
      <div style="margin-top:6px">${ai.summary||''}</div>
      ${ai.recommendation?`<div style="margin-top:8px" class="muted">\u25b6 ${ai.recommendation}</div>`:''}
    </div>
    <div class="row" style="margin:0 0 4px">
      <span>ELD reading: <b>${d.eld_reading} (${eldIsDown?'DOWN':'UP'})</b></span>
      <span class="muted">pivot ${fmtTime(d.pivot)} \u00b7 window \u00b1${d.window_min}m</span>
    </div>
    ${d.check?`<div class="check" style="margin:0 0 12px">Power check: <b>${d.check}</b></div>`:''}
    <h2>Gears currently down (${hit.length}/${d.gear_count})</h2>`;
  if(!hit.length) html += `<div class="muted" style="margin-bottom:12px">Every fed gear is currently energised/healthy.</div>`;
  html += hit.map(g=>`<div class="gear hit"><div class="gname">${g.asset_name}<span class="gtype">${g.asset_type}</span> <span class="drop">DOWN now</span></div>${
    g.dropped.length?attrTable(g.dropped):'<div class="muted" style="margin-top:4px">de-energised now \u2014 no sample change captured in this window</div>'}</div>`).join('');
  if(rest.length){
    html += `<details style="margin-top:8px"><summary class="muted">Healthy gears (${rest.length})</summary>${
      rest.map(g=>`<div class="gear"><span class="gname">${g.asset_name}</span><span class="gtype">${g.asset_type}</span> <span class="muted">\u2014 energised</span></div>`).join('')}</details>`;
  }
  html += `<details style="margin-top:12px"><summary class="muted">Raw evidence sent to AI</summary><pre>${d.evidence}</pre></details>`;
  _$('#mBody').innerHTML = html;
}

async function loadLatestInsightHero(){
  try {
    const r = await fetch(`${ELD_ENDPOINTS.logs}?hours=168`);
    const d = await r.json();
    const logs = d.logs || [];
    const heroEl = _$('#latestInsightHero');
    if(!heroEl) return;

    if(!logs.length){
      heroEl.style.display = 'block';
      heroEl.innerHTML = `
        <div style="background:var(--panel);border:1px solid var(--up);border-radius:12px;padding:14px 18px;display:flex;align-items:center;justify-content:space-between;">
          <div style="display:flex;align-items:center;gap:12px">
            <span style="font-size:22px"></span>
            <div>
              <div style="font-weight:700;font-size:14px;color:var(--up)">System Diagnostic Status: All Clear Across All Sites</div>
              <div class="muted" style="font-size:12px">No ELD trips or gear equipment drops recorded in recent telemetry logs.</div>
            </div>
          </div>
          <button class="chip" onclick="switchTab('analysis')">View Full History</button>
        </div>
      `;
      return;
    }

    const latest = logs[0];
    const isDown = latest.state === 'DOWN';
    const hasChanges = latest.changes && latest.changes.length > 0;

    let causeTitle = '';
    let causeDesc = '';
    let bgStyle = '';
    let borderStyle = '';
    let icon = '';

    if(isDown && hasChanges){
      icon = '';
      causeTitle = 'GEAR-LINKED EQUIPMENT FAULT DETECTED';
      const c = latest.changes[0];
      causeDesc = `External equipment drop on <b>${c.asset}</b> (${c.attribute}: <code>${c.from} \u2192 ${c.to}</code>). Connected gear lost power.`;
      bgStyle = 'linear-gradient(135deg, rgba(239,68,68,0.08), rgba(239,68,68,0.02))';
      borderStyle = '1px solid #fca5a5';
    } else if(isDown && !hasChanges){
      icon = '';
      causeTitle = 'ISOLATED INTERNAL ELD SENSOR TRIP';
      causeDesc = `Internal sensor trip on <b>${latest.eld_name}</b>. All connected gear attributes remained healthy (No equipment failure).`;
      bgStyle = 'linear-gradient(135deg, rgba(245,158,11,0.08), rgba(245,158,11,0.02))';
      borderStyle = '1px solid #fde68a';
    } else {
      icon = '';
      causeTitle = 'EQUIPMENT / ELD RESTORED TO NORMAL';
      causeDesc = `Power supply restored on <b>${latest.eld_name}</b>.`;
      bgStyle = 'linear-gradient(135deg, rgba(34,197,94,0.08), rgba(34,197,94,0.02))';
      borderStyle = '1px solid #86efac';
    }

    heroEl.style.display = 'block';
    heroEl.innerHTML = `
      <div style="background:${bgStyle};border:${borderStyle};border-radius:12px;padding:16px 20px;box-shadow:0 4px 16px rgba(0,0,0,0.03);">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:10px">
          <div>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
              <span style="font-size:18px">${icon}</span>
              <span style="font-size:11px;font-weight:800;letter-spacing:0.06em;text-transform:uppercase;color:var(--txt)">
                LATEST ASSET DIAGNOSTIC INSIGHT (AUTO-LOADED \u00b7 ALL SITES & ASSETS)
              </span>
              <span class="sitetag">${latest.site_name || 'Site'}</span>
              <span class="muted" style="font-size:11px">\u00b7 ${fmtTime(latest.timestamp)}</span>
            </div>
            <div style="font-size:15px;font-weight:700;margin:4px 0 2px;color:var(--txt)">
              ${latest.eld_name || ('ELD '+latest.eld_id)}: ${causeTitle}
            </div>
            <div style="font-size:13px;color:var(--txt);margin-top:4px">
              ${causeDesc}
            </div>
          </div>
          <div style="display:flex;gap:8px">
            <button class="primary" style="font-size:12px;padding:7px 14px" onclick="openModal(${latest.eld_id})">Inspect Asset</button>
            <button style="font-size:12px;padding:7px 14px" onclick="switchTab('analysis')">All Insights</button>
          </div>
        </div>
      </div>
    `;
  } catch(e){
    console.error("Hero insight load error:", e);
  }
}

let ALL_SITES = [];
let CURRENT_TAB = 'analysis';

function switchTab(tab){
  CURRENT_TAB = tab;
  _$('#tabMonitorBtn').classList.toggle('active', tab==='monitor');
  _$('#tabLogsBtn').classList.toggle('active', tab==='logs');
  _$('#tabAnalysisBtn').classList.toggle('active', tab==='analysis');
  _$('#tabMappingBtn').classList.toggle('active', tab==='mapping');
  _$('#tabSipBtn').classList.toggle('active', tab==='sip');

  _$('#monitorView').style.display = tab==='monitor' ? 'grid' : 'none';
  _$('#logsView').style.display = tab==='logs' ? 'block' : 'none';
  _$('#analysisView').style.display = tab==='analysis' ? 'block' : 'none';
  _$('#mappingView').style.display = tab==='mapping' ? 'block' : 'none';
  _$('#sipView').style.display = tab==='sip' ? 'block' : 'none';

  if(tab==='sip'){
    if(window.SIP) SIP.init();
  } else if(tab==='logs'){
    populateLogFilters();
    loadLogs();
  } else if(tab==='analysis'){
    populateAnalysisFilters();
    if(!CURRENT_ANALYSIS_EVENTS.length){
      loadHistoryAnalysis();
    }
  } else if(tab==='mapping'){
    loadMappingOverviewTab();
  }
}

function populateLogFilters(){
  setLogDateDefaults();
  const siteSel = _$('#logSiteSelect');
  if(siteSel && ALL_SITES.length){
    const curr = siteSel.value;
    const opts = '<option value="">All Sites</option>' + ALL_SITES.map(s=>`<option value="${s.id}">${s.name}</option>`).join('');
    if(siteSel.innerHTML !== opts){
      siteSel.innerHTML = opts;
      if(curr && Array.from(siteSel.options).some(o => o.value === String(curr))){
        siteSel.value = curr;
      }
    }
  }
}

function onLogSiteChange(){
  const siteId = _$('#logSiteSelect').value;
  const eldSel = _$('#logEldSelect');
  const currEld = eldSel.value;
  let filteredElds = ELDS;
  if(siteId) filteredElds = ELDS.filter(e=>String(e.site_id)===String(siteId));
  const opts = '<option value="">All ELDs</option>' + filteredElds.map(e=>`<option value="${e.eld_id}">${e.eld_name || ('ELD '+e.eld_id)}${e.supply_name ? ' \u2014 '+e.supply_name : ''} (${e.site_name||''})</option>`).join('');
  if(eldSel.innerHTML !== opts){
    eldSel.innerHTML = opts;
    if(currEld && Array.from(eldSel.options).some(o => o.value === String(currEld))){
      eldSel.value = currEld;
    }
  }
  loadLogs();
}

function populateAnalysisFilters(){
  const siteSel = _$('#anSiteSelect');
  if(siteSel && ALL_SITES.length){
    const currSite = siteSel.value;
    const siteOpts = '<option value="">All Sites</option>' + ALL_SITES.map(s=>`<option value="${s.id}">${s.name}</option>`).join('');
    if(siteSel.innerHTML !== siteOpts){
      siteSel.innerHTML = siteOpts;
      if(currSite && Array.from(siteSel.options).some(o => o.value === String(currSite))){
        siteSel.value = currSite;
      }
    }
  }
  const fromEl = _$('#anFromDate');
  const toEl = _$('#anToDate');
  if(!fromEl.value){
    const now = new Date();
    const past = new Date(now.getTime() - 150*24*60*60*1000); // Default 5 months lookback
    const toLocalISO = dt => new Date(dt.getTime() - dt.getTimezoneOffset()*60000).toISOString().slice(0, 16);
    let savedWindow = null;
    try { savedWindow = JSON.parse(localStorage.getItem('ELD_AI_WINDOW') || 'null'); } catch(e) {}
    fromEl.value = savedWindow && savedWindow.start ? savedWindow.start : toLocalISO(past);
    toEl.value = savedWindow && savedWindow.end ? savedWindow.end : toLocalISO(now);
  }
}

function onAnSiteChange(preserveEld = false){
  const siteId = _$('#anSiteSelect') ? _$('#anSiteSelect').value : '';
  const eldSel = _$('#anEldSelect');
  if(!eldSel) return;
  const currentEld = preserveEld ? eldSel.value : '';

  let filteredElds = ELDS;
  if(siteId) filteredElds = ELDS.filter(e=>String(e.site_id)===String(siteId));
  const optsHtml = '<option value="">All ELDs</option>' + filteredElds.map(e=>`<option value="${e.eld_id}">${e.eld_name || ('ELD '+e.eld_id)}${e.supply_name ? ' \u2014 '+e.supply_name : ''} (${e.site_name||''})</option>`).join('');
  if(eldSel.innerHTML !== optsHtml){
    eldSel.innerHTML = optsHtml;
    if(currentEld && Array.from(eldSel.options).some(o => o.value === String(currentEld))){
      eldSel.value = currentEld;
    }
  }
  filterHistoryAnalysisView();
}

function onAnEldChange(){
  filterHistoryAnalysisView();
}

let CURRENT_ANALYSIS_EVENTS = [];
let ANALYSIS_MATRIX_OPEN = new Set();
let PER_ELD_CACHE = {}; // Key: ELD + start date + end day + pre/post window
try {
  const savedCache = localStorage.getItem('ELD_PER_ELD_CACHE');
  if(savedCache) PER_ELD_CACHE = JSON.parse(savedCache);
} catch(e){}

function savePerEldCache(){
  try {
    localStorage.setItem('ELD_PER_ELD_CACHE', JSON.stringify(PER_ELD_CACHE));
  } catch(e){}
}

let IS_ANALYSIS_FETCHING = false; // Lock to prevent background timers from interrupting progress loader screen

function analysisCacheKey(eld, fromVal, toVal, preSec, postSec){
  // The default end time is "now", so key it by day; Refresh explicitly bypasses this cache.
  const stableTo = toVal ? toVal.slice(0, 10) : '';
  return `ips-v2__${eld.eld_id}__${fromVal}__${stableTo}__${preSec}__${postSec}`;
}

async function loadHistoryAnalysis(){
  if(IS_ANALYSIS_FETCHING) return;
  IS_ANALYSIS_FETCHING = true;

  try {
    const container = _$('#analysisContainer');
    const siteId = _$('#anSiteSelect').value;
    const eldId = _$('#anEldSelect').value;
    const fromVal = _$('#anFromDate').value;
    const toVal = _$('#anToDate').value;
    const preSec = _$('#anPreSec') ? parseFloat(_$('#anPreSec').value || '120') : 120;
    const postSec = _$('#anPostSec') ? parseFloat(_$('#anPostSec').value || '5') : 5;
    const bypassCache = _$('#anBypassCache') ? _$('#anBypassCache').checked : false;

    if(bypassCache){
      PER_ELD_CACHE = {}; // Purge browser cache to guarantee fresh API fetch
      savePerEldCache();
    }

    let eldsToFetch = [];
    if(eldId){
      eldsToFetch = ELDS.filter(e => String(e.eld_id) === String(eldId));
    } else if(siteId){
      eldsToFetch = ELDS.filter(e => String(e.site_id) === String(siteId));
    } else {
      eldsToFetch = [...ELDS];
    }

    if(!eldsToFetch.length){
      if(!ELDS.length){
        container.innerHTML = '<div class="loading">Loading ELD asset inventory\u2026</div>';
        return;
      }
      container.innerHTML = '<div class="loading">No ELDs match the selected filter criteria.</div>';
      return;
    }

    // Check if ALL requested ELDs are already in PER_ELD_CACHE
    let allCached = true;
    let cachedMergedEvents = [];
    let lastCachedTime = '';

    for(const e of eldsToFetch){
      const ek = analysisCacheKey(e, fromVal, toVal, preSec, postSec);
      if(!bypassCache && PER_ELD_CACHE[ek]){
        cachedMergedEvents.push(...PER_ELD_CACHE[ek].events);
        if(!lastCachedTime) lastCachedTime = PER_ELD_CACHE[ek].time;
      } else {
        allCached = false;
        break;
      }
    }

    // If ALL requested ELDs are cached, instant 0ms load!
    if(allCached && !bypassCache){
      cachedMergedEvents.sort((a,b) => (b.timestamp||'').localeCompare(a.timestamp||''));
      CURRENT_ANALYSIS_EVENTS = cachedMergedEvents;
      IS_ANALYSIS_FETCHING = false; // release guard BEFORE rendering, else filterHistoryAnalysisView() bails early and leaves the "Loading\u2026" placeholder
      filterHistoryAnalysisView();
      const cacheNotice = document.createElement('div');
      cacheNotice.style.cssText = 'background:rgba(47,111,237,0.06);border:1px solid rgba(47,111,237,0.25);border-radius:8px;padding:10px 14px;font-size:12.5px;font-weight:600;color:var(--accent);margin-bottom:16px;display:flex;align-items:center;justify-content:space-between';
      cacheNotice.innerHTML = `<span>Loaded from local per-ELD cache (Saved at ${lastCachedTime}). Use <b>Refresh</b> to re-query live telemetry from historian.</span>`;
      if(container && container.firstChild){
        container.insertBefore(cacheNotice, container.firstChild);
      }
      return;
    }

    // Render Real-time Execution Progress Loader for un-cached or forced refresh
    container.innerHTML = `
      <div style="background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:24px;margin-bottom:24px;box-shadow:0 2px 12px rgba(0,0,0,0.03)">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
          <div style="display:flex;align-items:center;gap:10px">
            <div class="spinner-ring" id="vloaderSpinner"></div>
            <h3 id="vloaderTitle" style="margin:0;font-size:16px;font-weight:700;color:var(--txt)">Analyzing ELDs & Merging Diagnostic Results...</h3>
          </div>
          <div id="vloaderPct" style="font-size:24px;font-weight:800;color:var(--accent)">0%</div>
        </div>

        <div class="vprogress-track" style="height:10px;background:var(--chip);border-radius:5px;overflow:hidden;margin-bottom:18px">
          <div class="vprogress-fill" id="vloaderBar" style="height:100%;background:linear-gradient(90deg, var(--accent), #159a58);width:0%;transition:width 0.3s"></div>
        </div>

        <div style="display:grid;grid-template-columns:repeat(auto-fit, minmax(150px, 1fr));gap:12px;margin-bottom:20px">
          <div style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px 14px">
            <div class="muted" style="font-size:11px;font-weight:700;text-transform:uppercase">ELDs Progress</div>
            <div id="vstatElds" style="font-size:15px;font-weight:700;color:var(--txt);margin-top:2px">0 / ${eldsToFetch.length} ELDs</div>
          </div>
          <div style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px 14px">
            <div class="muted" style="font-size:11px;font-weight:700;text-transform:uppercase">Active ELD</div>
            <div id="vstatActive" style="font-size:15px;font-weight:700;color:var(--accent);margin-top:2px">\u2014</div>
          </div>
          <div style="background:rgba(21,154,88,0.06);border:1px solid rgba(21,154,88,0.25);border-radius:8px;padding:10px 14px">
            <div style="font-size:11px;font-weight:700;text-transform:uppercase;color:var(--up)">Total Merged Events</div>
            <div id="vstatEvents" style="font-size:15px;font-weight:800;color:var(--up);margin-top:2px">0</div>
          </div>
          <div style="background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:10px 14px">
            <div class="muted" style="font-size:11px;font-weight:700;text-transform:uppercase">Pipeline Status</div>
            <div id="vstatStatus" style="font-size:13px;font-weight:700;color:var(--txt);margin-top:2px">Starting...</div>
          </div>
        </div>

        <div style="background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:14px">
          <div style="font-size:13px;font-weight:700;color:var(--txt);margin-bottom:10px">
            ELD-Wise Execution Pipeline & Results Merging:
          </div>
          <div id="veldsGrid" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(220px, 1fr));gap:8px">
            ${eldsToFetch.map(e => `
              <div id="veld-${e.eld_id}" style="background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:8px 12px;display:flex;align-items:center;justify-content:space-between">
                <div>
                  <div style="font-weight:700;font-size:12.5px;color:var(--txt)">${e.eld_name || ('ELD '+e.eld_id)}</div>
                  <div class="muted" style="font-size:11px">${e.site_name||'Site'}</div>
                </div>
                <span class="vbadge" style="background:var(--chip);color:var(--mut);padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700">\u23f3 QUEUED</span>
              </div>
            `).join('')}
          </div>
        </div>
      </div>
    `;

    let allMergedEvents = [];
    const startIso = fromVal ? new Date(fromVal).toISOString() : '';
    const endIso = toVal ? new Date(toVal).toISOString() : '';

    for(let i = 0; i < eldsToFetch.length; i++){
      const e = eldsToFetch[i];
      const ek = analysisCacheKey(e, fromVal, toVal, preSec, postSec);
      const itemEl = document.getElementById(`veld-${e.eld_id}`);

      // If this individual ELD is already cached and not bypassCache, reuse it!
      if(!bypassCache && PER_ELD_CACHE[ek]){
        const cachedEvs = PER_ELD_CACHE[ek].events || [];
        allMergedEvents.push(...cachedEvs);
        if(itemEl){
          itemEl.querySelector('.vbadge').outerHTML = `<span class="vbadge" style="background:rgba(47,111,237,0.1);color:var(--accent);border:1px solid rgba(47,111,237,0.3);padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700">CACHED (${cachedEvs.length} ev)</span>`;
        }
      } else {
        if(itemEl){
          itemEl.querySelector('.vbadge').outerHTML = `<span class="vbadge" style="background:rgba(47,111,237,0.1);color:var(--accent);border:1px solid rgba(47,111,237,0.3);padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700">ANALYZING...</span>`;
        }

        if(_$('#vstatActive')) _$('#vstatActive').textContent = e.eld_name || ('ELD '+e.eld_id);
        if(_$('#vstatStatus')) _$('#vstatStatus').textContent = `Querying ${e.eld_name || ('ELD '+e.eld_id)}...`;

        try {
          let fetchUrl = `${ELD_ENDPOINTS.historyAnalysis}?eld_id=${e.eld_id}&pre_sec=${preSec}&post_sec=${postSec}&`;
          if(startIso) fetchUrl += `start_date=${encodeURIComponent(startIso)}&`;
          if(endIso) fetchUrl += `end_date=${encodeURIComponent(endIso)}&`;
          if(bypassCache) fetchUrl += `force_refresh=true&`;

          const res = await fetch(fetchUrl);
          if(res.ok){
            const data = await res.json();
            const evs = data.events || [];
            const isCachedOnDisk = data.is_cached === true;
            allMergedEvents.push(...evs);
            PER_ELD_CACHE[ek] = {
              events: evs,
              time: new Date().toLocaleTimeString()
            };
            savePerEldCache();

            if(itemEl){
              if(isCachedOnDisk){
                itemEl.querySelector('.vbadge').outerHTML = `<span class="vbadge" style="background:rgba(47,111,237,0.12);color:var(--accent);border:1px solid rgba(47,111,237,0.35);padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700">RESUMED (${evs.length} ev)</span>`;
              } else {
                itemEl.querySelector('.vbadge').outerHTML = `<span class="vbadge" style="background:rgba(21,154,88,0.1);color:var(--up);border:1px solid rgba(21,154,88,0.3);padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700">OK (${evs.length} events)</span>`;
              }
            }
          }
        } catch(err){
          console.error(`Error querying ELD ${e.eld_id}:`, err);
          if(itemEl){
            itemEl.querySelector('.vbadge').outerHTML = `<span class="vbadge" style="background:rgba(224,62,82,0.1);color:var(--down);padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700">\u2715 ERROR</span>`;
          }
        }
      }

      const pct = Math.round(((i + 1) / eldsToFetch.length) * 100);
      if(_$('#vloaderPct')) _$('#vloaderPct').textContent = `${pct}%`;
      if(_$('#vloaderBar')) _$('#vloaderBar').style.width = `${pct}%`;
      if(_$('#vstatElds')) _$('#vstatElds').textContent = `${i + 1} / ${eldsToFetch.length} ELDs`;
      if(_$('#vstatEvents')) _$('#vstatEvents').textContent = `${allMergedEvents.length}`;

      if(bypassCache || !PER_ELD_CACHE[ek]){
        await new Promise(r => setTimeout(r, 60)); // Smooth visual pacing for live progress animation
      }
    }

    // Sort merged events by timestamp descending
    allMergedEvents.sort((a,b) => (b.timestamp||'').localeCompare(a.timestamp||''));
    CURRENT_ANALYSIS_EVENTS = allMergedEvents;
  } finally {
    IS_ANALYSIS_FETCHING = false;
  }

  filterHistoryAnalysisView();
}

let CURRENT_ANALYSIS_VIEW_MODE = 'eld';

function setAnalysisViewMode(mode){
  CURRENT_ANALYSIS_VIEW_MODE = mode;
  const eldBtn = _$('#viewEldWiseBtn');
  const ptBtn = _$('#viewPointWiseBtn');

  if(eldBtn) eldBtn.classList.toggle('on', mode === 'eld');
  if(ptBtn) ptBtn.classList.toggle('on', mode === 'point');

  filterHistoryAnalysisView();
}

function scrollToEventCard(eldId, timestamp){
  const sanitizedTs = (timestamp || '').replace(/[^a-zA-Z0-9]/g, '_');
  const cardId = `event_card_${eldId}_${sanitizedTs}`;
  const el = document.getElementById(cardId);
  if(el){
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    el.style.transition = 'all 0.3s ease';
    el.style.boxShadow = '0 0 0 4px var(--accent), 0 8px 24px rgba(47,111,237,0.35)';
    el.style.transform = 'scale(1.01)';
    setTimeout(() => {
      el.style.boxShadow = '';
      el.style.transform = '';
    }, 2200);
  }
}

function toggleAnalysisMatrix(eldId){
  const key = String(eldId);
  if(ANALYSIS_MATRIX_OPEN.has(key)) ANALYSIS_MATRIX_OPEN.delete(key);
  else ANALYSIS_MATRIX_OPEN.add(key);
  const card = document.getElementById(`anMatrix-${key}`);
  if(card){
    const open = ANALYSIS_MATRIX_OPEN.has(key);
    card.classList.toggle('open', open);
    const hint = card.querySelector('.an-matrix-hint');
    if(hint) hint.textContent = open ? 'click to close' : 'click to open';
  }
}

function filterHistoryAnalysisView(){
  if(IS_ANALYSIS_FETCHING) return; // Prevent overwriting active progress loader screen!

  const siteFilter = _$('#anSiteSelect') ? _$('#anSiteSelect').value : '';
  const eldFilter = _$('#anEldSelect') ? _$('#anEldSelect').value : '';
  const linkFilter = _$('#anLinkSelect') ? _$('#anLinkSelect').value : 'all';

  let filtered = CURRENT_ANALYSIS_EVENTS || [];

  if(siteFilter){
    filtered = filtered.filter(e => String(e.site_id) === String(siteFilter));
  }
  if(eldFilter){
    filtered = filtered.filter(e => String(e.eld_id) === String(eldFilter));
  }
  if(linkFilter === 'linked'){
    filtered = filtered.filter(eventHasExternalChanges);
  } else if(linkFilter === 'unlinked'){
    filtered = filtered.filter(e => !eventHasExternalChanges(e) && e.state === 'DOWN');
  }

  renderHistoryAnalysis(filtered, filtered);
}

function renderTimelineEventDetail(e){
  if(!e){
    return `<div class="tl-event-detail"><div class="ed-empty">Select a timeline circle to see its changed attributes and timestamped values.</div></div>`;
  }

  const changes = (e.changes || []).filter(c => {
    if(c.asset_type !== 'TRACK') return true;
    return !(Math.abs(c.from) > 1.5 || Math.abs(c.to) > 1.5);
  });
  const hasIpsChange = (e.changes || []).some(c => c.is_power_supply);
  const stateLabel = eventHasExternalChanges(e) ? 'Attribute changed'
    : (hasIpsChange ? `IPS-only change \u00b7 ${e.state === 'UP' ? 'UP' : 'DOWN'}` : (e.state === 'UP' ? 'Came back up' : 'Down, unchanged'));
  const assetGroups = {};
  changes.forEach(c => {
    const key = `${c.asset}__${c.asset_type}`;
    if(!assetGroups[key]) assetGroups[key] = {asset: c.asset, type: c.asset_type, attrs: []};
    assetGroups[key].attrs.push(c);
  });

  const meaning = [];
  Object.values(assetGroups).forEach(group => {
    if(group.type === 'POINT MACHINE'){
      meaning.push(`<div class="ed-meaning-item"><b>Point ${group.asset}:</b> ${pointMachineTransition(group.attrs)}</div>`);
    }
    if(group.type === 'TRACK'){
      const tpr = group.attrs.find(c => /\bTPR\b/i.test(c.attribute || ''));
      if(tpr) meaning.push(`<div class="ed-meaning-item"><b>Track ${group.asset}:</b> ${trackMovementText(tpr)}</div>`);
    }
    if(group.type === 'SIGNAL'){
      const signalText = signalAspectText(group.attrs);
      if(signalText) meaning.push(`<div class="ed-meaning-item"><b>Signal ${group.asset}:</b> ${signalText}</div>`);
    }
  });

  const assetsHtml = Object.values(assetGroups).map(group => `
    <div class="ed-asset">
      <div class="ed-name">${group.asset} <span class="an-tag">${group.type || ''}</span></div>
      ${group.type === 'POINT MACHINE' ? `<div class="ed-point-state">${pointMachineTransition(group.attrs)}</div>` : ''}
      ${group.attrs.map(c => {
        const values = Object.entries(c.values || {});
        const valuesHtml = values.length
          ? values.map(([ts, value]) => `<span class="ed-value">${tOnly(ts)} <b>${numFmt(value)}</b></span>`).join('')
          : `<span class="ed-value">${c.from ?? '\u2014'} \u2192 <b>${c.to ?? '\u2014'}</b></span>`;
        return `<div class="ed-attr"><b>${c.attribute}</b> <span class="muted">${c.from ?? '\u2014'} \u2192 ${c.to ?? '\u2014'}</span><div class="ed-values">${valuesHtml}</div></div>`;
      }).join('')}
    </div>
  `).join('');

  return `
    <div class="tl-event-detail">
      <div class="ed-head">
        <div class="ed-title">Current focus \u00b7 event #${NODE_GRAPH_EVENTS.indexOf(e) + 1} \u00b7 ${stateLabel}</div>
        <div class="ed-time">${fmtTime(e.timestamp)} \u00b7 reading ${e.value ?? '\u2014'}</div>
      </div>
      ${meaning.length ? `<div class="ed-meaning">${meaning.join('')}</div>` : ''}
      <div class="ed-grid">${assetsHtml || '<div class="ed-empty">No attribute changes were captured for this event.</div>'}</div>
    </div>`;
}

function trackMovementText(change){
  const state = value => Number(value) === 1 ? 'Train present' : Number(value) === 0 ? 'No train' : 'Unknown';
  return `${state(change.from)} \u2192 ${state(change.to)} (TPR ${change.from ?? '\u2014'} \u2192 ${change.to ?? '\u2014'})`;
}

function signalAspectText(changes){
  const labels = {RECR: 'Red', HECR: 'Yellow', HHECR: 'Double Yellow', DECR: 'Green'};
  const before = changes.find(c => labels[(c.attribute || '').toUpperCase()] && Number(c.from) === 1);
  const after = changes.find(c => labels[(c.attribute || '').toUpperCase()] && Number(c.to) === 1);
  const beforeLabel = before ? labels[before.attribute.toUpperCase()] : null;
  const afterLabel = after ? labels[after.attribute.toUpperCase()] : null;
  if(beforeLabel && afterLabel) return `${beforeLabel} \u2192 ${afterLabel}`;
  if(afterLabel) return `Signal became ${afterLabel}`;
  if(beforeLabel) return `Signal left ${beforeLabel}`;

  const shunt = changes.find(c => /SH[-_]/i.test(c.attribute || ''));
  if(shunt) return `${Number(shunt.to) === 1 ? 'Shunt ON' : 'Shunt OFF'} (${shunt.attribute})`;
  return 'CR relay changed';
}

function pointMachineTransition(changes){
  const sequence = pointMachineSequence(changes);
  if(sequence.length > 1) return `Point operation: ${sequence.join(' \u2192 ')}`;
  const normalize = value => {
    const n = Number(value);
    return Number.isFinite(n) ? (Math.abs(n) >= 5 ? 1 : 0) : null;
  };
  const states = {normal: null, reverse: null};
  changes.forEach(c => {
    const name = (c.attribute || '').toUpperCase();
    const from = normalize(c.from), to = normalize(c.to);
    if(name.includes('NWKR')) states.normal = {from, to};
    if(name.includes('RWKR')) states.reverse = {from, to};
  });
  // NWKR and RWKR are two independent proofs: NWKR picked up (\u224828V) = point detected Normal,
  // RWKR picked up = point detected Reverse. A detection DROPPING (28V \u2192 0V) only proves the
  // point left that position \u2014 it never proves it reached the other one. "Normal \u2192 Reverse" is
  // written only when the Reverse detection itself picks up (0V \u2192 \u224828V), and vice versa.
  const before = states.normal && states.normal.from === 1 ? 'Normal'
    : states.reverse && states.reverse.from === 1 ? 'Reverse' : null;
  const after = states.normal && states.normal.to === 1 ? 'Normal'
    : states.reverse && states.reverse.to === 1 ? 'Reverse' : null;
  if(before && after && before !== after) return `Point position: ${before} \u2192 ${after}`;
  if(before && after && before === after) return `Point position: stayed ${before}`;
  const opposite = position => position === 'Normal' ? 'Reverse' : 'Normal';
  const relayOf = position => position === 'Normal' ? 'NWKR' : 'RWKR';
  if(before && !after){
    return `Point position: ${before} \u2192 off ${before} (${relayOf(before)} dropped to 0; `
      + `${relayOf(opposite(before))} never picked up, so ${opposite(before)} is not confirmed)`;
  }
  if(!before && after){
    return `Point position: detected ${after} (${relayOf(after)} picked up from 0 \u2014 `
      + `no ${opposite(after)} detection before it)`;
  }
  const changed = changes.find(c => /(?:NWKR|RWKR)/i.test(c.attribute || ''));
  if(changed){
    const from = normalize(changed.from), to = normalize(changed.to);
    const position = /RWKR/i.test(changed.attribute || '') ? 'Reverse' : 'Normal';
    if(from === 1 && to === 0){
      return `Point position: ${position} \u2192 off ${position} (${relayOf(position)} dropped to 0; `
        + `no ${relayOf(opposite(position))} pick-up, so ${opposite(position)} is not confirmed)`;
    }
    if(from === 0 && to === 1) return `Point position: detected ${position} (${relayOf(position)} picked up)`;
  }
  return 'Point position: NWKR/RWKR indication changed';
}

function pointMachineSequence(changes){
  const normalize = value => {
    const n = Number(value);
    return Number.isFinite(n) ? (Math.abs(n) >= 5 ? 1 : 0) : null;
  };
  const samples = [];
  const state = {normal: null, reverse: null};
  changes.forEach(c => {
    const name = (c.attribute || '').toUpperCase();
    const kind = name.includes('NWKR') ? 'normal' : name.includes('RWKR') ? 'reverse' : null;
    if(!kind) return;
    const initial = normalize(c.from);
    if(initial !== null) state[kind] = initial;
    Object.entries(c.values || {}).forEach(([timestamp, value]) => {
      samples.push({timestamp, kind, value: normalize(value)});
    });
  });
  const position = () => state.normal === 1 ? 'Normal' : state.reverse === 1 ? 'Reverse' : null;
  const sequence = [];
  const initialPosition = position();
  if(initialPosition) sequence.push(initialPosition);
  samples.sort((a, b) => (a.timestamp || '').localeCompare(b.timestamp || ''));
  samples.forEach(sample => {
    if(sample.value === null) return;
    state[sample.kind] = sample.value;
    const current = position();
    if(current && sequence[sequence.length - 1] !== current) sequence.push(current);
  });
  // Both detections down at the end means the point is off-position / still operating \u2014
  // don't leave the sequence sitting on a position it has already left.
  if(sequence.length > 1 && !position()) sequence.push('no detection (off-position)');
  return sequence;
}

let NODE_GRAPH_EVENTS = [];
let SELECTED_NODE_KEYS = new Set(); // Persistent set of selected `${eld_id}__${timestamp}__${state}`
let CURRENT_TIMELINE_ELD_KEY = null; // Scope key to track active ELD selection
let ACTIVE_TIMELINE_EVENT_KEY = null; // The one event whose full timestamped values are shown below
let INCLUDE_POWER_SUPPLY_IN_COMMON = false;

function getEventNodeKey(e){
  return `${e.eld_id}__${e.timestamp}__${e.state}`;
}

function eventHasExternalChanges(e){
  return (e.changes || []).some(c => !c.is_power_supply);
}

function defaultCommonEventKeys(events){
  const counts = {};
  events.filter(e => e.state === 'DOWN').forEach(e => {
    const seen = new Set();
    (e.changes || []).forEach(c => {
      if(c.is_power_supply) return;
      const key = `${c.asset}__${c.attribute}`;
      if(!seen.has(key)) counts[key] = (counts[key] || 0) + 1;
      seen.add(key);
    });
  });
  const max = Math.max(0, ...Object.values(counts));
  if(!max) return new Set();
  const commonKeys = new Set(Object.keys(counts).filter(key => counts[key] === max));
  return new Set(events
    .filter(e => e.state === 'DOWN' && (e.changes || []).some(c => !c.is_power_supply && commonKeys.has(`${c.asset}__${c.attribute}`)))
    .map(getEventNodeKey));
}

function initNodeGraphTimeline(events){
  NODE_GRAPH_EVENTS = events || [];

  const eldFilter = _$('#anEldSelect') ? _$('#anEldSelect').value : '';
  const uniqueEldIds = Array.from(new Set(NODE_GRAPH_EVENTS.map(e => e.eld_id)));
  const uniqueEldCount = uniqueEldIds.length;

  // Render ONLY when a single ELD is selected via dropdown (#anEldSelect) or when uniqueEldCount === 1
  if(!eldFilter && uniqueEldCount > 1){
    CURRENT_TIMELINE_ELD_KEY = null;
    SELECTED_NODE_KEYS.clear();
    ACTIVE_TIMELINE_EVENT_KEY = null;
    const container = document.getElementById('nodeGraphTimelineContainer');
    if(container) container.innerHTML = '';
    return;
  }

  if(!NODE_GRAPH_EVENTS.length){
    CURRENT_TIMELINE_ELD_KEY = null;
    SELECTED_NODE_KEYS.clear();
    ACTIVE_TIMELINE_EVENT_KEY = null;
    renderNodeGraphTimeline();
    return;
  }

  const activeEldKey = eldFilter || (uniqueEldIds.length === 1 ? String(uniqueEldIds[0]) : 'all');

  // ONLY initialize default selections if the user has navigated to a DIFFERENT ELD scope!
  if(CURRENT_TIMELINE_ELD_KEY !== activeEldKey){
    CURRENT_TIMELINE_ELD_KEY = activeEldKey;
    SELECTED_NODE_KEYS.clear();
    // Default to the drops sharing the most common external attribute.
    defaultCommonEventKeys(NODE_GRAPH_EVENTS).forEach(key => SELECTED_NODE_KEYS.add(key));
    ACTIVE_TIMELINE_EVENT_KEY = null;
    const firstSelected = NODE_GRAPH_EVENTS.find(e => SELECTED_NODE_KEYS.has(getEventNodeKey(e)));
    ACTIVE_TIMELINE_EVENT_KEY = firstSelected ? getEventNodeKey(firstSelected) : getEventNodeKey(NODE_GRAPH_EVENTS[0]);
  }

  renderNodeGraphTimeline();
}

function toggleNodeSelection(idx){
  const ev = NODE_GRAPH_EVENTS[idx];
  if(!ev) return;
  const key = getEventNodeKey(ev);
  ACTIVE_TIMELINE_EVENT_KEY = key;
  if(SELECTED_NODE_KEYS.has(key)){
    SELECTED_NODE_KEYS.delete(key);
  } else {
    SELECTED_NODE_KEYS.add(key);
  }
  renderNodeGraphTimeline();
}

function selectAllNodes(select = true){
  if(select){
    NODE_GRAPH_EVENTS.forEach(e => SELECTED_NODE_KEYS.add(getEventNodeKey(e)));
    if(!ACTIVE_TIMELINE_EVENT_KEY && NODE_GRAPH_EVENTS.length){
      ACTIVE_TIMELINE_EVENT_KEY = getEventNodeKey(NODE_GRAPH_EVENTS[0]);
    }
  } else {
    SELECTED_NODE_KEYS.clear();
    ACTIVE_TIMELINE_EVENT_KEY = null;
  }
  renderNodeGraphTimeline();
}

function selectLinkedNodesOnly(){
  SELECTED_NODE_KEYS.clear();
  NODE_GRAPH_EVENTS.forEach(e => {
    if(eventHasExternalChanges(e)){
      SELECTED_NODE_KEYS.add(getEventNodeKey(e));
    }
  });
  const firstSelected = NODE_GRAPH_EVENTS.find(e => SELECTED_NODE_KEYS.has(getEventNodeKey(e)));
  ACTIVE_TIMELINE_EVENT_KEY = firstSelected ? getEventNodeKey(firstSelected) : null;
  renderNodeGraphTimeline();
}

function setIncludePowerSupplyInCommon(include){
  INCLUDE_POWER_SUPPLY_IN_COMMON = !!include;
  renderNodeGraphTimeline();
}

function renderNodeGraphTimeline(){
  const container = document.getElementById('nodeGraphTimelineContainer');
  if(!container) return;
  const eldFilter = _$('#anEldSelect') ? _$('#anEldSelect').value : '';
  const uniqueEldCount = new Set(NODE_GRAPH_EVENTS.map(e => e.eld_id)).size;

  if(!eldFilter && uniqueEldCount > 1){
    container.innerHTML = '';
    return;
  }

  if(!NODE_GRAPH_EVENTS.length){
    container.innerHTML = `<div style="padding:16px;text-align:center;color:var(--calm-ink-soft)">Nothing to compare yet \u2014 no transitions in this window.</div>`;
    return;
  }

  // 1. Render ONE horizontal timeline \u2014 a single line with nodes sitting ABOVE (came
  //    back up) or BELOW (went down) it, time under each, hover for detail, click to pick.
  //    Laid out oldest \u2192 newest left-to-right; idx stays tied to NODE_GRAPH_EVENTS order.
  const TL_GAP = 82, TL_PAD = 50;
  const order = NODE_GRAPH_EVENTS.map((e, idx) => idx)
    .sort((a, b) => (NODE_GRAPH_EVENTS[a].timestamp || '').localeCompare(NODE_GRAPH_EVENTS[b].timestamp || ''));
  const trackW = TL_PAD * 2 + Math.max(0, order.length - 1) * TL_GAP;

  const nodesHtml = order.map((idx, pos) => {
    const e = NODE_GRAPH_EVENTS[idx];
    const isSelected = SELECTED_NODE_KEYS.has(getEventNodeKey(e));
    const isActive = ACTIVE_TIMELINE_EVENT_KEY === getEventNodeKey(e);
    const isDown = e.state === 'DOWN';
    const hasChanges = (e.changes || []).length > 0;
    const hasExternalChanges = eventHasExternalChanges(e);
    const hasIpsChange = (e.changes || []).some(c => c.is_power_supply);

    // External attribute changes are red; IPS-only changes retain their UP/DOWN color.
    const stClass = hasExternalChanges ? 'st-gear'
      : (hasIpsChange ? (isDown ? 'st-ips-down' : 'st-ips-up') : (isDown ? 'st-sensor' : 'st-up'));
    const ud = isDown ? 'down' : 'up';
    const x = TL_PAD + pos * TL_GAP;

    return `
       <div class="tl-node ${ud}${isSelected ? ' sel' : ''}${isActive ? ' active' : ''}" style="left:${x}px"
           onclick="toggleNodeSelection(${idx})"
         ondblclick="event.stopPropagation(); openEventSnapshotModal(${idx})">
        <div class="tl-time"><b>#${idx + 1}</b><br>${tOnly(e.timestamp)}</div>
        <div class="tl-stem"></div>
        <button type="button" class="tl-dot ${stClass}" aria-label="transition ${idx + 1}"></button>
      </div>
    `;
  }).join('');

  // 2. Compute Common Attribute Intersection across SELECTED_NODE_KEYS
  const selectedIndices = [];
  NODE_GRAPH_EVENTS.forEach((e, idx) => {
    if(SELECTED_NODE_KEYS.has(getEventNodeKey(e))){
      selectedIndices.push(idx);
    }
  });

  const selectedCount = selectedIndices.length;
  const activeEvent = NODE_GRAPH_EVENTS.find(e => getEventNodeKey(e) === ACTIVE_TIMELINE_EVENT_KEY);
  const activeDetailHtml = renderTimelineEventDetail(activeEvent);
  let intersectionHtml = '';

  if(selectedCount === 0){
    intersectionHtml = `
      <div style="padding:16px;text-align:center;color:var(--calm-ink-soft);font-size:13px">
        <b style="color:var(--calm-ink)">Pick a few drops above</b> and we\u2019ll tell you what they had in common \u2014 the equipment that changed in every one of them.
      </div>
    `;
  } else {
    const attrCounts = {};
    const attrDetails = {};
    const attrNodeNumbers = {};

    selectedIndices.forEach(idx => {
      const ev = NODE_GRAPH_EVENTS[idx];
      const evChanges = ev.changes || [];
      const seenInThisEvent = new Set();
      const nodeNum = idx + 1;

      evChanges.filter(c => INCLUDE_POWER_SUPPLY_IN_COMMON || !c.is_power_supply).forEach(c => {
        if(c.asset_type === 'TRACK' && (Math.abs(c.from) > 1.5 || Math.abs(c.to) > 1.5)) return;
        const key = `${c.asset} \u00b7 ${c.attribute}`;
        seenInThisEvent.add(key);

        if(!attrDetails[key]){
          attrDetails[key] = {
            asset: c.asset,
            attr: c.attribute,
            type: c.asset_type
          };
        }
      });

      seenInThisEvent.forEach(key => {
        attrCounts[key] = (attrCounts[key] || 0) + 1;
        if(!attrNodeNumbers[key]) attrNodeNumbers[key] = [];
        attrNodeNumbers[key].push(`Node #${nodeNum}`);
      });
    });

    const common100Keys = Object.keys(attrCounts).filter(k => attrCounts[k] === selectedCount);
    const partialKeys = Object.keys(attrCounts).filter(k => attrCounts[k] < selectedCount)
      .sort((a,b) => attrCounts[b] - attrCounts[a]);

    // Headline: the single most-justifiable cause for the current selection \u2014 the attribute
    // that changed in the most of the picked drops. This is the answer to "what did I select?".
    const rankedKeys = Object.keys(attrCounts).sort((a,b) => attrCounts[b] - attrCounts[a]);
    const topKey = rankedKeys[0];
    let heroHtml = '';
    if(topKey){
      const d = attrDetails[topKey];
      const cnt = attrCounts[topKey];
      const pct = ((cnt / selectedCount) * 100).toFixed(0);
      const full = cnt === selectedCount;
      heroHtml = `
        <div class="jf-hero ${full ? 'full' : 'partial'}">
          <div class="jf-lead">${full ? 'Most justifiable cause' : 'Best-matching cause'}</div>
          <div class="jf-attr">${d.asset} \u00b7 ${d.attr} <span class="jf-type">${d.type||''}</span></div>
          <div class="jf-sub">${selectedCount === 1
            ? 'This is the equipment that changed in the drop you picked.'
            : `Changed in <b>${cnt} of ${selectedCount}</b> selected drops \u00b7 <b>${pct}%</b>${full ? ' \u2014 every single one of them.' : '. Pick fewer / linked drops to sharpen the match.'}`}</div>
        </div>`;
    } else {
      heroHtml = `
        <div class="jf-hero partial">
          <div class="jf-lead">No equipment change captured</div>
          <div class="jf-sub">The ${selectedCount === 1 ? 'drop you picked was' : `${selectedCount} drops you picked were`} sensor-only \u2014 the ELD tripped on its own, no fed equipment moved.</div>
        </div>`;
    }

    let commonSectionHtml = '';

    if(common100Keys.length > 0){
      commonSectionHtml = `
        <div style="background:var(--calm-green-wash);border:1px solid #cfeadd;border-radius:12px;padding:14px 16px;margin-bottom:10px">
          <div style="font-size:13px;font-weight:700;color:var(--calm-green);margin-bottom:10px">
            ${selectedCount === 1
              ? 'This drop involved the following equipment:'
              : `The same equipment changed in <b>all ${selectedCount}</b> of the drops you picked:`}
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:8px">
            ${common100Keys.map(k => {
              const d = attrDetails[k];
              const nodesStr = attrNodeNumbers[k] ? attrNodeNumbers[k].join(', ') : '';
              return `
                <div style="background:var(--calm-surface);border:1px solid #cfeadd;border-radius:10px;padding:10px 14px;box-shadow:var(--calm-shadow-sm)">
                  <div style="font-size:13.5px;font-weight:750;color:var(--calm-ink)">${d.asset} \u00b7 ${d.attr}</div>
                  <div style="font-size:11.5px;font-weight:600;color:var(--calm-green);margin-top:3px">
                    ${selectedCount === 1 ? 'Changed in this drop' : `Present in every one of the ${selectedCount} selected drops`}
                  </div>
                  <div style="font-size:11px;color:var(--calm-ink-soft);margin-top:4px">seen in ${nodesStr}</div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    } else {
      commonSectionHtml = `
        <div style="background:var(--calm-amber-wash);border:1px solid #eddcbe;border-radius:12px;padding:12px 16px;margin-bottom:10px;font-size:13px;color:var(--calm-amber);font-weight:600">
          No single piece of equipment changed in all ${selectedCount} of these drops. Here\u2019s what showed up most often across them:
        </div>
      `;
    }

    let partialSectionHtml = '';
    if(partialKeys.length > 0){
      partialSectionHtml = `
        <div style="margin-top:10px">
          <div style="font-size:12.5px;font-weight:650;color:var(--calm-ink);margin-bottom:8px">
            How often each one showed up across your selection:
          </div>
          <div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));gap:8px">
            ${partialKeys.map(k => {
              const d = attrDetails[k];
              const cnt = attrCounts[k];
              const pct = ((cnt / selectedCount) * 100).toFixed(0);
              const nodesStr = attrNodeNumbers[k] ? attrNodeNumbers[k].join(', ') : '';
              return `
                <div style="background:var(--calm-tint);border:1px solid var(--calm-line);border-radius:10px;padding:10px 12px;display:flex;justify-content:space-between;align-items:center;gap:8px">
                  <div>
                    <div style="font-size:12.5px;font-weight:700;color:var(--calm-ink)">${d.asset} \u00b7 ${d.attr}</div>
                    <div style="font-size:10.5px;color:var(--calm-ink-soft);margin-top:2px">${d.type} \u00b7 ${nodesStr}</div>
                  </div>
                  <span style="background:var(--calm-surface);border:1px solid var(--calm-line);color:var(--calm-ink);padding:4px 9px;border-radius:20px;font-size:11px;font-weight:700;white-space:nowrap">
                    ${cnt} of ${selectedCount} \u00b7 ${pct}%
                  </span>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    }

    intersectionHtml = `
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;border-bottom:1px solid var(--calm-line);padding-bottom:10px;gap:10px;flex-wrap:wrap">
        <div style="font-size:13.5px;font-weight:750;color:var(--calm-ink)">
          ${selectedCount === 1 ? 'What changed in this drop' : `What these ${selectedCount} drops have in common`}
          <span style="color:var(--calm-ink-soft);font-weight:500">\u00b7 #${selectedIndices.map(i=>i+1).join(', ')}</span>
        </div>
        <button onclick="selectAllNodes(false)" class="an-ghost">Clear selection</button>
      </div>

      ${heroHtml}
      ${commonSectionHtml}
      ${partialSectionHtml}
    `;
  }

  // Preserve the horizontal scroll position across re-render (clicking a node rebuilds
  // this container, which would otherwise snap the timeline back to the first node).
  const prevScrollEl = container.querySelector('.tl-scroll');
  const prevScrollLeft = prevScrollEl ? prevScrollEl.scrollLeft : 0;

  container.innerHTML = `
    <div class="an-tl">
      <div class="tl-head">
        <div>
          <div class="tl-title">Timeline \u2014 every up &amp; down for this ELD</div>
          <div class="tl-desc">
            Each dot is one moment this ELD changed state \u2014 <b>above</b> the line it came back up, <b>below</b> it went down.
            <b>Click</b> a dot to select it and see every changed attribute with all timestamped values below.
          </div>
        </div>
        <div class="tl-btns">
          <span class="tl-btns-label">Filter</span>
          <span class="tl-selection-status">Selected: ${selectedCount} \u00b7 Focus: ${activeEvent ? '#' + (NODE_GRAPH_EVENTS.indexOf(activeEvent) + 1) : '\u2014'}</span>
          <button onclick="selectAllNodes(true)" class="an-ghost" title="Select every event on this timeline"><span class="tl-btn-ico">\u2611</span>Select all (${NODE_GRAPH_EVENTS.length})</button>
          <button onclick="selectLinkedNodesOnly()" class="an-ghost" title="Keep only the drops where fed equipment lost power"><span class="tl-btn-ico">\u26a1</span>Only power-loss drops</button>
          <button onclick="selectAllNodes(false)" class="an-ghost" title="Clear the current selection"><span class="tl-btn-ico">\u2715</span>Clear</button>
          <label class="tl-include-ps"><input type="checkbox" ${INCLUDE_POWER_SUPPLY_IN_COMMON ? 'checked' : ''} onchange="setIncludePowerSupplyInCommon(this.checked)"/> Include power supply</label>
        </div>
      </div>

      <div class="tl-legend">
        <span><i class="dot st-up"></i>Came back up</span>
        <span><i class="dot st-gear"></i>Attribute changed</span>
        <span><i class="dot st-sensor"></i>Down, unchanged (sensor)</span>
        <span><i class="dot st-ips-down"></i>IPS-only change</span>
        <span><i class="dot selq"></i>Selected</span>
      </div>

      <div class="tl-scroll">
        <div class="tl-track" style="width:${trackW}px">
          <div class="tl-axis"></div>
          ${nodesHtml}
        </div>
      </div>

      ${activeDetailHtml}

      <div class="tl-analysis">
        ${intersectionHtml}
      </div>
    </div>
  `;

  // Restore the timeline's horizontal scroll so selecting a node keeps your place.
  const newScrollEl = container.querySelector('.tl-scroll');
  if(newScrollEl && prevScrollLeft) newScrollEl.scrollLeft = prevScrollLeft;
}

// Shared rich tooltip for timeline dots \u2014 hover a node to see its detail without clicking.
function showTlTip(idx, ev){
  const e = NODE_GRAPH_EVENTS[idx];
  if(!e) return;
  let tip = document.getElementById('tlTip');
  if(!tip){
    tip = document.createElement('div');
    tip.id = 'tlTip';
    tip.className = 'tl-tip';
    document.body.appendChild(tip);
  }
  const isDown = e.state === 'DOWN';
  const hasChanges = e.changes && e.changes.length > 0;
  const stateLabel = isDown ? (hasChanges ? 'Power-loss drop' : 'Sensor-only drop') : 'Came back up';
  const selected = SELECTED_NODE_KEYS.has(getEventNodeKey(e));
  let chips = '<div class="tt-none">nothing changed \u2014 sensor tripped on its own</div>';
  if(hasChanges){
    chips = e.changes
      .filter(c => !(c.asset_type === 'TRACK' && (Math.abs(c.from) > 1.5 || Math.abs(c.to) > 1.5)))
      .map(c => `<div class="tt-chg"><b>${c.asset} \u00b7 ${c.attribute}</b><br>${c.from} \u2192 ${c.to}</div>`)
      .join('') || '<div class="tt-none">nothing changed</div>';
  }
  tip.innerHTML = `
    <div class="tt-h">#${idx + 1} \u00b7 ${stateLabel}</div>
    <div class="tt-t">${fmtTime(e.timestamp)}</div>
    ${chips}
    <div class="tt-hint">${selected ? '\u2713 selected \u2014 click to remove' : 'click to add to selection'} \u00b7 double-click for full reading</div>`;
  tip.style.display = 'block';
  const tw = tip.offsetWidth, th = tip.offsetHeight;
  let x = ev.clientX - tw / 2;
  x = Math.max(8, Math.min(x, window.innerWidth - tw - 8));
  let y = ev.clientY - th - 14;
  if(y < 8) y = ev.clientY + 18;
  tip.style.left = x + 'px';
  tip.style.top = y + 'px';
}

function hideTlTip(){
  const tip = document.getElementById('tlTip');
  if(tip) tip.style.display = 'none';
}

async function openEventSnapshotModal(idx){
  const ev = NODE_GRAPH_EVENTS[idx];
  if(!ev) return;

  const eid = ev.eld_id;
  const preSec = _$('#anPreSec') ? _$('#anPreSec').value : 120;
  const postSec = _$('#anPostSec') ? _$('#anPostSec').value : 5;

  _$('#mTitle').textContent = `Full Telemetry Snapshot \u2014 Event #${idx + 1} (${ev.eld_name || ('ELD '+eid)})`;
  _$('#mSub').textContent = `${ev.site_name || 'Station'} \u00b7 ${ev.state} Trip at ${fmtTime(ev.timestamp)}`;

  const isDown = ev.state === 'DOWN';
  const hasChanges = ev.changes && ev.changes.length > 0;
  const stateBadge = isDown ? (hasChanges ? '<span class="badge down">TRIP (LINKED)</span>' : '<span class="badge warn">TRIP (SENSOR)</span>') : '<span class="badge up">RESTORE (UP)</span>';

  _$('#mDetail').innerHTML = `
    <div style="background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:12px 16px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
      <div style="display:flex;align-items:center;gap:10px">
        ${stateBadge}
        <span style="font-weight:800;font-size:13.5px;color:var(--txt)">${ev.eld_name || ('ELD '+eid)}</span>
        <span class="sitetag">${ev.site_name}</span>
      </div>
      <div style="font-size:12px;font-weight:700;color:var(--txt)">
        Device Timestamp: <span style="color:var(--accent);font-weight:800">${fmtTime(ev.timestamp)}</span>
      </div>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin:14px 0 8px">
      <div>
        <h4 style="margin:0;font-size:14px;font-weight:800;color:var(--txt)">
          Complete Gear Attributes Telemetry Snapshot
        </h4>
        <div class="muted" style="font-size:11.5px;margin-top:2px">
          Includes both dropped attributes and <b>unchanged healthy attribute readings</b> at event timestamp
        </div>
      </div>
      <span style="font-size:11px;font-weight:700;background:var(--chip);padding:3px 8px;border-radius:6px">
        Window: -${preSec}s to +${postSec}s
      </span>
    </div>

    <div id="snapshotTableContainer" style="margin-top:10px"><div class="loading">Fetching complete attribute snapshot...</div></div>
  `;

  _$('#mBody').innerHTML = '';
  _$('#ov').classList.add('show');

  try {
    const r = await fetch(`${ELD_ENDPOINTS.detail}?id=${eid}&pre_sec=${preSec}&post_sec=${postSec}`);
    const detailData = await r.json();

    const changedMap = {};
    (ev.changes || []).forEach(c => {
      changedMap[`${c.asset}__${c.attribute}`] = c;
    });

    let snapshotRows = [];
    const snapshotAssets = (detailData.gears || []).map(g => ({
      asset_name: g.asset_name,
      asset_type: g.asset_type,
      attributes: g.attributes || [],
    }));
    // IPS is a mapped asset too, but its readings are returned in the
    // dedicated power_supply block so it can also power the event card.
    if(detailData.power_supply && detailData.power_supply.attributes){
      snapshotAssets.push({
        asset_name: detailData.power_supply.asset_name || detailData.power_supply.name,
        asset_type: 'IPS',
        attributes: detailData.power_supply.attributes,
      });
    }
    snapshotAssets.forEach(g => {
      (g.attributes || []).forEach(a => {
        const key = `${g.asset_name}__${a.name}`;
        const changeObj = changedMap[key] || (g.asset_type === 'IPS'
          ? (ev.changes || []).find(c => c.is_power_supply && c.attribute === a.name)
          : null);
        const isChanged = !!changeObj;
        const points = (a.series || []).filter(p => p && p.ts != null && p.value != null);
        const pointDisplay = points.length
          ? points.map(p => `<div style="line-height:1.7"><b style="color:#10b981">${numFmt(p.value)}</b> <span style="color:var(--mut);font-size:10.5px">(${tOnly(p.ts)})</span></div>`).join('')
          : `<b style="color:#10b981">${a.end_value == null ? '\u2014' : numFmt(a.end_value)}</b>`;

        const statusBadge = isChanged 
          ? `<span style="background:rgba(239,68,68,0.12);color:#ef4444;border:1px solid rgba(239,68,68,0.3);padding:2px 8px;border-radius:4px;font-size:10.5px;font-weight:800">DROPPED / CHANGED</span>` 
          : `<span style="background:rgba(16,185,129,0.12);color:#10b981;border:1px solid rgba(16,185,129,0.3);padding:2px 8px;border-radius:4px;font-size:10.5px;font-weight:800">UNCHANGED / HEALTHY</span>`;

        const valDisplay = pointDisplay;

        snapshotRows.push(`
          <tr style="border-bottom:1px solid var(--line)">
            <td style="padding:8px 10px;font-weight:700;color:var(--txt)">${g.asset_name}</td>
            <td style="padding:8px 10px"><span class="gtype">${g.asset_type}</span></td>
            <td style="padding:8px 10px;font-weight:700">${a.name}</td>
            <td style="padding:8px 10px">${statusBadge}</td>
            <td style="padding:8px 10px;font-size:12px">${valDisplay}</td>
          </tr>
        `);
      });
    });

    const snapshotHtml = `
      <table class="log-table" style="width:100%;border-collapse:collapse;margin:0">
        <thead>
          <tr style="background:var(--panel2)">
            <th style="padding:8px 10px;font-size:12px">Asset Name</th>
            <th style="padding:8px 10px;font-size:12px">Gear Type</th>
            <th style="padding:8px 10px;font-size:12px">Attribute Name</th>
            <th style="padding:8px 10px;font-size:12px">Event Status</th>
            <th style="padding:8px 10px;font-size:12px">Value Reading at Event</th>
          </tr>
        </thead>
        <tbody>
          ${snapshotRows.join('') || '<tr><td colspan="5" class="muted" style="text-align:center;padding:14px">No mapped attributes available for snapshot.</td></tr>'}
        </tbody>
      </table>
    `;

    const snapshotContainer = document.getElementById('snapshotTableContainer');
    if(snapshotContainer) snapshotContainer.innerHTML = snapshotHtml;

  } catch(err) {
    const snapshotContainer = document.getElementById('snapshotTableContainer');
    if(snapshotContainer) snapshotContainer.innerHTML = `<div class="loading">Snapshot error: ${err}</div>`;
  }
}

function renderHistoryAnalysis(events, totalEvents = events){
  const container = _$('#analysisContainer');
  if(!events.length){
    container.innerHTML = '<div class="loading">No state transitions found for the selected criteria and filter.</div>';
    return;
  }

  // Filter DOWN and UP events
  const downEvents = totalEvents.filter(e => e.state === 'DOWN');
  const upEvents = totalEvents.filter(e => e.state === 'UP');
  const totalDown = downEvents.length;
  const totalUp = upEvents.length;

  const hasExternalChanges = e => (e.changes || []).some(c => !c.is_power_supply);
  const corrDownEvents = downEvents.filter(hasExternalChanges);
  const isoDownEvents = downEvents.filter(e => !hasExternalChanges(e));

  const corrDownPct = totalDown > 0 ? ((corrDownEvents.length / totalDown) * 100).toFixed(1) : '0.0';
  const isoDownPct = totalDown > 0 ? ((isoDownEvents.length / totalDown) * 100).toFixed(1) : '0.0';

  // 1. Group Events & Changes ELD-Wise (Both UP and DOWN)
  const eldGroups = {};

  totalEvents.forEach(e => {
    const eid = e.eld_id;
    if(!eldGroups[eid]){
      eldGroups[eid] = {
        eld_id: eid,
        eld_name: e.eld_name || ('ELD ' + eid),
        supply_name: e.supply_name || '',
        site_name: e.site_name || '',
        totalTransitions: 0,
        downCount: 0,
        upCount: 0,
        linkedDownCount: 0,
        attrMap: {},
        isoDownCount: 0,
        isoUpCount: 0
      };
    }

    const group = eldGroups[eid];
    group.totalTransitions++;
    if(e.state === 'DOWN') group.downCount++;
    else if(e.state === 'UP') group.upCount++;

    const changes = e.changes || [];
    const externalChanges = changes.filter(c => !c.is_power_supply);
    if(e.state === 'DOWN' && externalChanges.length) group.linkedDownCount++;
    if(!externalChanges.length){
      if(e.state === 'DOWN') group.isoDownCount++;
      else group.isoUpCount++;
    } else {
      changes.forEach(c => {
        // Exclude analog voltage series masquerading as TPR (e.g. 26.68V) for TRACK assets
        if(c.asset_type === 'TRACK' && (Math.abs(c.from) > 1.5 || Math.abs(c.to) > 1.5)) return;

        const akey = `${c.asset}__${c.attribute}`;
        if(!group.attrMap[akey]){
          group.attrMap[akey] = {
            asset: c.asset,
            attr: c.attribute,
            type: c.asset_type,
            totalChanges: 0,
            downChanges: 0,
            upChanges: 0,
            occurrences: []
          };
        }
        group.attrMap[akey].totalChanges++;
        if(e.state === 'DOWN') group.attrMap[akey].downChanges++;
        else if(e.state === 'UP') group.attrMap[akey].upChanges++;

        group.attrMap[akey].occurrences.push({
          state: e.state,
          timestamp: e.timestamp,
          from: c.from,
          to: c.to
        });
      });
    }
  });

  // 1.5. Build Point Groups for AI Executive Summary & Point-Wise View (Station/Site-Scoped)
  const pointGroups = {};
  totalEvents.forEach(e => {
    const eid = e.eld_id;
    const siteName = e.site_name || 'Station';
    const changes = e.changes || [];

    changes.forEach(c => {
      if(c.asset_type === 'TRACK' && (Math.abs(c.from) > 1.5 || Math.abs(c.to) > 1.5)) return;

      // Scope asset key strictly by station site so points on different stations (e.g. Sakhun vs Gahlota) do not collide
      const akey = `${siteName}__${c.asset}__${c.attribute}`;
      if(!pointGroups[akey]){
        pointGroups[akey] = {
          site_name: siteName,
          asset: c.asset,
          attr: c.attribute,
          type: c.asset_type,
          totalChanges: 0,
          downChanges: 0,
          upChanges: 0,
          affectedElds: {}
        };
      }

      const pg = pointGroups[akey];
      pg.totalChanges++;
      if(e.state === 'DOWN') pg.downChanges++;
      else if(e.state === 'UP') pg.upChanges++;

      if(!pg.affectedElds[eid]){
        pg.affectedElds[eid] = {
          eld_id: eid,
          eld_name: e.eld_name || ('ELD ' + eid),
          supply_name: e.supply_name || '',
          site_name: siteName,
          totalChangesOnEld: 0,
          downChangesOnEld: 0,
          upChangesOnEld: 0,
          occurrences: []
        };
      }

      const aEld = pg.affectedElds[eid];
      aEld.totalChangesOnEld++;
      if(e.state === 'DOWN') aEld.downChangesOnEld++;
      else if(e.state === 'UP') aEld.upChangesOnEld++;

      aEld.occurrences.push({
        state: e.state,
        timestamp: e.timestamp,
        from: c.from,
        to: c.to
      });
    });
  });

  // Analysis summary data across selected ELD(s)
  const totalEldsCount = Object.keys(eldGroups).length;
  const totalEventsCount = totalEvents.length;
  const gearCount = corrDownEvents.length;
  const isoCount = isoDownEvents.length;

  const pl = n => (n === 1 ? '' : 's');
  // At-a-glance tiles
  const statsHtml = `
    <div class="an-stats">
      <div class="an-stat ink"><div class="k">State changes</div><div class="v">${totalEventsCount}<span class="u">total</span></div></div>
      <div class="an-stat red"><div class="k">Went down</div><div class="v">${totalDown}<span class="u">drop${pl(totalDown)}</span></div></div>
      <div class="an-stat green"><div class="k">Came back up</div><div class="v">${totalUp}<span class="u">restore${pl(totalUp)}</span></div></div>
      <div class="an-stat red"><div class="k">Equipment-linked</div><div class="v">${gearCount}<span class="u">${corrDownPct}% of drops</span></div></div>
      <div class="an-stat blue"><div class="k">Units watched</div><div class="v">${totalEldsCount}<span class="u">ELDs</span></div></div>
    </div>`;

  const matrixHeading = CURRENT_ANALYSIS_VIEW_MODE === 'point'
    ? `<div class="an-sec-h"><h3>What each piece of equipment did</h3><div class="desc">Grouped by equipment attribute, showing every ELD it touched</div></div>`
    : `<div class="an-sec-h"><h3>How each ELD unit behaved</h3><div class="desc">Which equipment changed around each trip, and exactly when</div></div>`;

  // Each visible ELD gets its own AI history panel. This keeps four ELDs' timelines
  // separate while still analysing every drop/restore in the selected date window.
  const aiPanelHtml = Object.values(eldGroups).map(group => `
    <div class="ai-panel" id="aiSummaryPanel-${group.eld_id}">
      <div class="ai-head">
        <div>
          <div class="ai-title">${group.eld_name} <span class="ai-sub">\u00b7 ${group.site_name || 'Site'}</span></div>
          <div class="ai-desc">AI diagnosis for this ELD only \u00b7 all ${group.totalTransitions} transitions in the selected window</div>
        </div>
        <div class="ai-controls">
          <button class="primary ai-run" id="aiRunBtn-${group.eld_id}" onclick="runAiSummary('${group.eld_id}')" title="Analyse ${group.eld_name} with AI">
            <span class="ai-button-force"><input type="checkbox" id="aiForceRefresh-${group.eld_id}" onclick="event.stopPropagation()"/> Refresh</span>
            <span>\u25b6 Run AI analysis</span>
          </button>
        </div>
      </div>
      <div id="aiSummaryResult-${group.eld_id}" class="ai-result"></div>
    </div>`).join('');

  // Node timeline (single-ELD only) + section heading for the matrix that follows
  let combinedAnalyticsHtml = `
    ${statsHtml}
    ${aiPanelHtml}
    <div id="nodeGraphTimelineContainer"></div>
    ${matrixHeading}`;

  // 2. Build Per-ELD Matrix Tables
  const sortedEldGroups = Object.values(eldGroups).sort((a,b) => b.totalTransitions - a.totalTransitions);

  let eldMatrixHtml = sortedEldGroups.map(group => {
    const matrixKey = String(group.eld_id);
    const matrixOpen = ANALYSIS_MATRIX_OPEN.has(matrixKey);
    const sortedAttrs = Object.values(group.attrMap).sort((a,b) => b.totalChanges - a.totalChanges);
    const maxFreq = sortedAttrs.length > 0 ? sortedAttrs[0].totalChanges : 0;

    let topAttrNotice = '';
    if(sortedAttrs.length > 0){
      const topItems = sortedAttrs.filter(a => a.totalChanges === maxFreq);
      const names = topItems.map(a => `${a.asset} \u2014 ${a.attr}`).join(', ');
      topAttrNotice = `
        <div style="background:var(--calm-red-wash);border:1px solid #f3d4dc;padding:7px 13px;border-radius:20px;font-size:12px;color:var(--calm-ink);display:flex;align-items:center;gap:8px">
          <span style="color:var(--calm-ink-soft)">Most often:</span>
          <b>${names}</b>
          <span class="an-pill-lead">${maxFreq}\u00d7</span>
        </div>
      `;
    }

    let rowsHtml = '';
    if(sortedAttrs.length === 0){
      rowsHtml = `
        <tr>
          <td colspan="4" style="padding:18px;text-align:center;color:var(--calm-ink-soft);font-size:13px">
            No equipment fault behind any of these trips \u2014 all ${group.totalTransitions} were the ELD\u2019s own sensor.
          </td>
        </tr>
      `;
    } else {
      rowsHtml = sortedAttrs.map(item => {
        const isTop = item.totalChanges === maxFreq;
        const pct = ((item.totalChanges / group.totalTransitions) * 100).toFixed(0);
        const eid = group.eld_id;
        const occPills = item.occurrences.map(occ => {
          const isDown = occ.state === 'DOWN';
          return `
            <span onclick="scrollToEventCard('${eid}', '${occ.timestamp}')"
                  title="Jump to this transition below"
                  class="an-chip-time ${isDown ? 'down' : 'up'}">
              ${isDown ? 'down' : 'up'} \u00b7 ${fmtTime(occ.timestamp)}
            </span>`;
        }).join('');

        return `
          <tr class="${isTop ? 'hot' : ''}">
            <td style="font-size:13px">
              <b>${item.asset} \u2014 ${item.attr}</b>
              <span class="an-tag" style="margin-left:6px">${item.type}</span>
              ${isTop ? '<span class="an-pill-lead" style="margin-left:6px">most changed</span>' : ''}
            </td>
            <td style="white-space:nowrap">
              <b style="font-size:16px;color:${isTop ? 'var(--calm-red)' : 'var(--calm-ink)'}">${item.totalChanges}\u00d7</b>
              <div style="font-size:11px;color:var(--calm-ink-soft)">${pct}% of activity</div>
            </td>
            <td style="white-space:nowrap;font-size:12px">
              <div style="color:var(--calm-red);font-weight:650">${item.downChanges} on a drop</div>
              <div style="color:var(--calm-green);font-weight:650">${item.upChanges} on a restore</div>
            </td>
            <td><div style="display:flex;flex-wrap:wrap;gap:2px">${occPills}</div></td>
          </tr>
        `;
      }).join('');
    }

    return `
      <div class="an-card an-matrix-card${matrixOpen ? ' open' : ''}" id="anMatrix-${matrixKey}">
        <div class="c-head an-matrix-head" onclick="toggleAnalysisMatrix('${matrixKey}')">
          <div>
            <div class="c-head-main" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
              <span class="an-matrix-chevron">\u25b6</span>
              <span class="c-title">${group.eld_name}</span>
              ${group.supply_name ? `<span class="an-tag site">${group.supply_name}</span>` : ''}
              <span class="an-tag">${group.site_name}</span>
            </div>
            <div class="c-meta">
              <b>${group.totalTransitions}</b> state changes \u00b7
              <span style="color:var(--calm-red);font-weight:650">${group.downCount} down</span> \u00b7
                <span style="color:var(--calm-green);font-weight:650">${group.upCount} back up</span> \u00b7
              <span style="color:var(--calm-red);font-weight:650">${group.linkedDownCount} equipment-linked</span>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:8px">
            ${topAttrNotice}
            <span class="an-matrix-hint">${matrixOpen ? 'click to close' : 'click to open'}</span>
          </div>
        </div>

        <div class="an-matrix-body" style="overflow-x:auto">
        <table class="an-tbl">
          <thead>
            <tr>
              <th>What changed</th>
              <th>How often</th>
              <th>On drops / restores</th>
              <th>When (tap to jump)</th>
            </tr>
          </thead>
          <tbody>${rowsHtml}</tbody>
        </table>
        </div>
      </div>
    `;
  }).join('');

  // 3. Build Point / Asset-Wise Matrix HTML (Grouped by Asset Attribute across ELDs)
  let pointMatrixHtml = '';
  if(CURRENT_ANALYSIS_VIEW_MODE === 'point'){
    const sortedPointGroups = Object.values(pointGroups).sort((a, b) => {
      const numEldsA = Object.keys(a.affectedElds).length;
      const numEldsB = Object.keys(b.affectedElds).length;
      if(numEldsB !== numEldsA) return numEldsB - numEldsA;
      return b.totalChanges - a.totalChanges;
    });

    if(!sortedPointGroups.length){
      pointMatrixHtml = `
        <div class="an-card" style="text-align:center;color:var(--calm-ink-soft)">
          No equipment was involved in any of these trips \u2014 every drop was the ELD\u2019s own sensor.
        </div>
      `;
    } else {
      pointMatrixHtml = sortedPointGroups.map(pg => {
        const affectedEldList = Object.values(pg.affectedElds).sort((a,b) => b.totalChangesOnEld - a.totalChangesOnEld);
        const numElds = affectedEldList.length;
        const isMultiEld = numElds > 1;

        let eldRowsHtml = affectedEldList.map(aEld => {
          const groupEldInfo = eldGroups[aEld.eld_id] || { totalTransitions: 1, downCount: 0, upCount: 0 };
          const eldPct = ((aEld.totalChangesOnEld / groupEldInfo.totalTransitions) * 100).toFixed(1);
          const eldDownPct = groupEldInfo.downCount > 0 ? ((aEld.downChangesOnEld / groupEldInfo.downCount) * 100).toFixed(1) : '0.0';
          const eldUpPct = groupEldInfo.upCount > 0 ? ((aEld.upChangesOnEld / groupEldInfo.upCount) * 100).toFixed(1) : '0.0';

          const eid = aEld.eld_id;
          const occPills = aEld.occurrences.map(occ => {
            const isDown = occ.state === 'DOWN';
            return `
              <span onclick="scrollToEventCard('${eid}', '${occ.timestamp}')"
                    title="Jump to this transition below"
                    class="an-chip-time ${isDown ? 'down' : 'up'}">
                ${isDown ? 'down' : 'up'} \u00b7 ${fmtTime(occ.timestamp)}
              </span>`;
          }).join('');

          return `
            <tr>
              <td style="font-size:13px">
                <b>${aEld.eld_name}</b>
                ${aEld.supply_name ? `<span class="an-tag site" style="margin-left:6px">${aEld.supply_name}</span>` : ''}
                <span class="an-tag" style="margin-left:6px">${aEld.site_name}</span>
              </td>
              <td style="white-space:nowrap">
                <b style="font-size:16px;color:var(--calm-blue)">${aEld.totalChangesOnEld}\u00d7</b>
                <div style="font-size:11px;color:var(--calm-ink-soft)">${eldPct}% of its activity</div>
              </td>
              <td style="white-space:nowrap;font-size:12px">
                <div style="color:var(--calm-red);font-weight:650">${aEld.downChangesOnEld} on a drop</div>
                <div style="color:var(--calm-green);font-weight:650">${aEld.upChangesOnEld} on a restore</div>
              </td>
              <td><div style="display:flex;flex-wrap:wrap;gap:2px">${occPills}</div></td>
            </tr>
          `;
        }).join('');

        return `
          <div class="an-card" style="${isMultiEld ? 'border-left:4px solid var(--calm-red)' : ''}">
            <div class="c-head">
              <div>
                <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                  <span class="c-title">${pg.asset} \u2014 ${pg.attr}</span>
                  <span class="an-tag site">${pg.site_name}</span>
                  <span class="an-tag">${pg.type}</span>
                  ${isMultiEld
                    ? `<span class="an-pill-lead">touched ${numElds} ELDs</span>`
                    : `<span class="an-tag">one ELD only</span>`}
                </div>
                <div class="c-meta">
                  Changed <b>${pg.totalChanges}</b> times across the system \u00b7
                  <span style="color:var(--calm-red);font-weight:650">${pg.downChanges} on drops</span> \u00b7
                  <span style="color:var(--calm-green);font-weight:650">${pg.upChanges} on restores</span>
                </div>
              </div>
            </div>

            <div style="overflow-x:auto">
            <table class="an-tbl">
              <thead>
                <tr>
                  <th>ELD affected</th>
                  <th>Times here</th>
                  <th>On drops / restores</th>
                  <th>When (tap to jump)</th>
                </tr>
              </thead>
              <tbody>${eldRowsHtml}</tbody>
            </table>
            </div>
          </div>
        `;
      }).join('');
    }
  }

  const cardsHtml = events.map(l => {
    const isDown = l.state === 'DOWN';
    const hasChanges = l.changes && l.changes.some(c => !c.is_power_supply);
    const sanitizedTs = (l.timestamp || '').replace(/[^a-zA-Z0-9]/g, '_');
    const cardId = `event_card_${l.eld_id}_${sanitizedTs}`;

    const statePill = isDown
      ? '<span class="an-state-pill down">\u25cf Went down</span>'
      : '<span class="an-state-pill up">\u25cf Came back up</span>';
    const verdict = !isDown
      ? '<span class="an-verdict up">recovered</span>'
      : (hasChanges
        ? `<span class="an-verdict gear">equipment lost power \u00b7 ${l.changes.length} change${l.changes.length===1?'':'s'}</span>`
        : '<span class="an-verdict sensor">sensor tripped on its own</span>');
    const cardClass = isDown ? (hasChanges ? 'down' : 'down sensor') : 'up';

    let changesHtml = '';
    if(hasChanges){
      const validChanges = l.changes.filter(c => !(c.asset_type === 'TRACK' && (Math.abs(c.from) > 1.5 || Math.abs(c.to) > 1.5)));
      const rows = validChanges.map(c => {
        const valEntries = Object.entries(c.values || {}).map(([t, v]) =>
          `<span class="pill ${isDown ? 'chg' : 'up'}">${tOnly(t)} \u00b7 <b>${numFmt(v)}</b></span>`
        ).join(' ');

        return `<tr>
          <td><b>${c.asset}</b> <span class="an-tag">${c.asset_type}</span></td>
          <td><b>${c.attribute}</b></td>
          <td><code>${c.from} \u2192 ${c.to}</code></td>
          <td><div class="vals">${valEntries || '\u2014'}</div></td>
        </tr>`;
      }).join('');

      changesHtml = `<div style="overflow-x:auto;margin-top:10px"><table class="an-tbl">
        <thead>
          <tr>
            <th>Equipment</th>
            <th>What changed</th>
            <th>Went from \u2192 to</th>
            <th>Readings around the moment</th>
          </tr>
        </thead>
        <tbody>${rows}</tbody>
      </table></div>`;
    }

    return `<div id="${cardId}" class="an-ev ${cardClass}">
      <div class="e-head">
        <div class="e-title">
          <span class="an-tag site">${l.site_name || 'Site'}</span>
          <span>${l.eld_name || ('ELD ' + l.eld_id)}</span>
          ${statePill}
          ${verdict}
        </div>
        <div class="e-when">${fmtTime(l.timestamp)} \u00b7 reading ${l.value ?? '\u2014'}</div>
      </div>
      ${changesHtml}
    </div>`;
  }).join('');

  const eventsHeading = `<div class="an-sec-h"><h3>Every transition, one by one</h3><div class="desc">Newest first \u00b7 the raw drops and restores behind the story above</div></div>`;
  container.innerHTML = `<div class="an-wrap">` + combinedAnalyticsHtml + (CURRENT_ANALYSIS_VIEW_MODE === 'point' ? pointMatrixHtml : eldMatrixHtml) + eventsHeading + cardsHtml + `</div>`;
  initNodeGraphTimeline(events);
  // AI analysis starts only when the user presses Run AI analysis.
}

// \u2500\u2500 AI root-cause analysis per ELD (cached; force-refresh) \u2500\u2500
function runAiSummary(eldId){
  const force = _$(`#aiForceRefresh-${eldId}`) ? _$(`#aiForceRefresh-${eldId}`).checked : false;
  fetchAiSummary(eldId, force, false);
}
async function fetchAiSummary(eldId, force, cacheOnly){
  const res = _$(`#aiSummaryResult-${eldId}`);
  if(!res) return;
  let evs = (CURRENT_ANALYSIS_EVENTS || []).filter(e => String(e.eld_id) === String(eldId));
  if(!evs.length){ res.innerHTML = ''; return; }
  const e0 = evs[0];
  const btn = _$(`#aiRunBtn-${eldId}`);
  if(!cacheOnly){
    res.innerHTML = `<div class="loading">Generating AI analysis\u2026</div>`;
    if(btn){ btn.disabled = true; btn.textContent = 'Analyzing\u2026'; }
  }
  const preSec = _$('#anPreSec') ? parseFloat(_$('#anPreSec').value || '120') : 120;
  const postSec = _$('#anPostSec') ? parseFloat(_$('#anPostSec').value || '5') : 5;
  const fromVal = _$('#anFromDate') ? _$('#anFromDate').value : '';
  const toVal = _$('#anToDate') ? _$('#anToDate').value : '';
  try { localStorage.setItem('ELD_AI_WINDOW', JSON.stringify({start: fromVal, end: toVal})); } catch(e) {}
  try{
    const r = await fetch(ELD_ENDPOINTS.aiSummary, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        eld_id: e0.eld_id, eld_name: e0.eld_name, site_name: e0.site_name, supply_name: e0.supply_name,
        window: {start: fromVal, end: toVal, pre: preSec, post: postSec},
        events: evs, force_refresh: !!force, cache_only: !!cacheOnly
      })
    });
    const d = await r.json();
    if(cacheOnly && (!d.ai || d.cache_miss)){ res.innerHTML = ''; return; }
    renderAiSummary(d, eldId);
  }catch(err){
    if(!cacheOnly) res.innerHTML = `<div class="loading">AI error: ${err.message||err}</div>`;
  }finally{
    if(btn){
      btn.disabled = false;
      btn.innerHTML = `<span class="ai-button-force"><input type="checkbox" id="aiForceRefresh-${eldId}" onclick="event.stopPropagation()" ${force ? 'checked' : ''}/> Refresh</span><span>\u25b6 Run AI analysis</span>`;
    }
  }
}

function renderAiSummary(d, eldId){
  const res = _$(`#aiSummaryResult-${eldId}`);
  if(!res) return;
  const ai = d.ai || {};
  const stats = d.stats || {};
  const timeline = (stats.important_event_story || []).slice(-8);
  const timelineHtml = timeline.length ? `
    <div class="ai-timeline"><div class="ai-timeline-title">Important instances</div>${timeline.map(item => `
      <div class="ai-timeline-row"><span class="ai-dot ${item.state==='DOWN'?'down':'up'}"></span>
        <span>${fmtTime(item.timestamp)} \u00b7 <b>${item.changes && item.changes.length ? item.changes.join('; ') : 'No equipment change captured'}</b></span>
        <span class="ai-timeline-state ${item.state==='DOWN'?'down':'up'}">ELD ${item.state==='DOWN'?'drop':'restore'}</span>
      </div>`).join('')}</div>` : '';
  res.innerHTML = `
    <div class="ai-card">
      ${ai.headline_insight ? `<div class="ai-insight"><b>Likely story:</b> ${ai.headline_insight}</div>` : ''}
      ${ai.summary ? `<div class="ai-summary">${ai.summary}</div>` : ''}
      ${timelineHtml}
      ${(ai.key_findings || []).length ? `<ul class="ai-findings">${ai.key_findings.slice(0,3).map(f => `<li>${f}</li>`).join('')}</ul>` : ''}
      ${ai.recommendation ? `<div class="ai-reco">Next check: ${ai.recommendation}</div>` : ''}
    </div>`;
}

function setLogDateDefaults(){
  const fromEl = _$('#logFromDate'), toEl = _$('#logToDate');
  const toLocalISO = dt => new Date(dt.getTime() - dt.getTimezoneOffset()*60000).toISOString().slice(0,16);
  if(fromEl && !fromEl.value) fromEl.value = '2026-03-01T00:00';   // rebuild baseline
  if(toEl && !toEl.value) toEl.value = toLocalISO(new Date());
}

async function loadLogs(){
  const container = _$('#logsContainer');
  const siteId = _$('#logSiteSelect').value;
  const eldId = _$('#logEldSelect').value;
  const state = _$('#logStateSelect').value;
  const fromVal = _$('#logFromDate') ? _$('#logFromDate').value : '';
  const toVal = _$('#logToDate') ? _$('#logToDate').value : '';

  let url = ELD_ENDPOINTS.logs + '?';
  if(siteId) url += `site_id=${siteId}&`;
  if(eldId) url += `eld_id=${eldId}&`;
  if(state) url += `state=${state}&`;
  if(fromVal) url += `start_date=${encodeURIComponent(new Date(fromVal).toISOString())}&`;
  if(toVal) url += `end_date=${encodeURIComponent(new Date(toVal).toISOString())}&`;

  try{
    const r = await fetch(url); const d = await r.json();
    renderLogs(d.logs || []);
  }catch(err){ container.innerHTML = `<div class="loading">Error loading logs: ${err}</div>`; }
}

// Hard refresh: wipe all logs and rebuild UP/DOWN transitions from 1 March 2026 with each ELD's
// own device timestamps (fixes the old wrong-timestamp entries). Live logging continues after.
async function rebuildLogs(){
  if(!confirm('This DELETES all current transition logs and rebuilds them from 1 March 2026 using each ELD\'s own device timestamps.\n\nContinue?')) return;
  const container = _$('#logsContainer');
  container.innerHTML = '<div class="loading">Hard refresh \u2014 deleting old logs & rebuilding transitions from 1 March 2026\u2026</div>';
  try{
    const r = await fetch(ELD_ENDPOINTS.logsRebuild, {method:'POST'});
    const d = await r.json();
    if(!r.ok) throw new Error(d.detail || 'rebuild failed');
    const fromEl = _$('#logFromDate'); if(fromEl) fromEl.value = '2026-03-01T00:00';
    await loadLogs();
    container.insertAdjacentHTML('afterbegin', `<div style="background:rgba(21,154,88,.08);border:1px solid rgba(21,154,88,.3);border-radius:8px;padding:10px 14px;margin-bottom:12px;font-size:13px;font-weight:600;color:var(--up)">\u2713 Rebuilt \u2014 cleared ${d.cleared} old logs, added ${d.added} transitions from ${d.elds_scanned} ELDs (since 1 Mar 2026).</div>`);
  }catch(err){ container.innerHTML = `<div class="loading">Rebuild error: ${err.message||err}</div>`; }
}

function renderLogs(logs){
  const container = _$('#logsContainer');
  if(!logs.length){
    container.innerHTML = '<div class="loading">No transition logs for this time range / filter.</div>';
    return;
  }

  container.innerHTML = logs.map(l => {
    const isDown = l.state === 'DOWN';
    const stateBadge = isDown
      ? '<span class="badge" style="background:rgba(230,167,0,.15);color:#9a7000">\u25bc DOWN</span>'
      : '<span class="badge up">\u25b2 UP</span>';

    let changesHtml = '';
    if(l.changes && l.changes.length){
      const rows = l.changes.map(c => {
        const valEntries = Object.entries(c.values || {}).map(([t, v]) =>
          `<span class="pill ${isDown ? 'chg' : 'up'}">${tOnly(t)} \u00b7 <b>${numFmt(v)}</b></span>`
        ).join(' ');

        return `<tr>
          <td><b>${c.asset}</b></td>
          <td><span class="gtype">${c.asset_type}</span></td>
          <td>${c.attribute}</td>
          <td><code>${c.from} \u2192 ${c.to}</code></td>
          <td><div class="vals">${valEntries || '\u2014'}</div></td>
        </tr>`;
      }).join('');

      changesHtml = `<table class="log-table">
        <thead>
          <tr>
            <th>Asset</th>
            <th>Type</th>
            <th>Attribute</th>
            <th>Transition</th>
            <th>Timestamped Readings (Key: Value)</th>
          </tr>
        </thead>
        <tbody>${rows}</tbody>
      </table>`;
    } else {
      changesHtml = '<div class="muted" style="margin-top:8px;font-size:12px">Transition only \u2014 open the Analysis tab for attribute-level change detail.</div>';
    }

    return `<div class="log-card ${l.state}">
      <div class="log-header">
        <div class="log-title">
          <span class="sitetag">${l.site_name || 'Site'}</span>
          <span>${l.eld_name || ('ELD ' + l.eld_id)}</span>
          ${stateBadge}
        </div>
        <div class="muted" style="font-size:12px">
          <b>${fmtTime(l.timestamp)}</b> (ELD Value: ${l.value ?? '\u2014'})
        </div>
      </div>
      ${changesHtml}
    </div>`;
  }).join('');
}

let CURRENT_MAPPING_CATEGORY = 'all';
let MAPPING_OVERVIEW_DATA = null;

async function loadMappingOverviewTab(force = false){
  const container = _$('#mappingCardsContainer');
  if(!MAPPING_OVERVIEW_DATA || force){
    container.innerHTML = '<div class="loading">Loading authoritative ELD asset & attribute mapping inventory\u2026</div>';
    try {
      const res = await fetch(ELD_ENDPOINTS.mappingOverview);
      MAPPING_OVERVIEW_DATA = await res.json();
    } catch(err) {
      container.innerHTML = `<div class="loading">Error loading mapping inventory: ${err}</div>`;
      return;
    }
  }
  renderMappingCardsOnly();
}

function filterMappingCategory(cat){
  CURRENT_MAPPING_CATEGORY = cat;
  ['all', 'TRACK', 'SIGNAL', 'POINT MACHINE'].forEach(c => {
    const btnId = c==='all' ? '#mapFilterAllBtn' : c==='TRACK' ? '#mapFilterTrackBtn' : c==='SIGNAL' ? '#mapFilterSigBtn' : '#mapFilterPointBtn';
    const el = _$(btnId);
    if(el){
      if(c === cat){
        el.classList.add('active');
        el.style.background = 'var(--accent)';
        el.style.color = '#fff';
      } else {
        el.classList.remove('active');
        el.style.background = 'var(--panel)';
        el.style.color = 'var(--mut)';
      }
    }
  });
  renderMappingCardsOnly();
}

function renderMappingCardsOnly(){
  if(!MAPPING_OVERVIEW_DATA) return;

  const elds = MAPPING_OVERVIEW_DATA.elds || [];
  const container = _$('#mappingCardsContainer');
  const searchInput = _$('#mapSearchInput');
  const searchVal = (searchInput ? searchInput.value : '').toLowerCase().trim();

  // Populate the Site dropdown from the distinct station/site names present (once, non-destructive)
  const siteSel = _$('#mapSiteSelect');
  if(siteSel){
    const siteNames = Array.from(new Set(elds.map(e => e.site_name).filter(Boolean))).sort();
    const opts = '<option value="">All Sites</option>' + siteNames.map(s => `<option value="${s}">${s}</option>`).join('');
    if(siteSel.innerHTML !== opts){
      const curr = siteSel.value;
      siteSel.innerHTML = opts;
      if(curr && siteNames.includes(curr)) siteSel.value = curr;
    }
  }
  const siteVal = siteSel ? siteSel.value : '';

  let filteredElds = elds;

  // Filter by selected station / site
  if(siteVal){
    filteredElds = filteredElds.filter(e => (e.site_name || '') === siteVal);
  }

  // Filter by search text
  if(searchVal){
    filteredElds = filteredElds.filter(e => 
      (e.eld_name||'').toLowerCase().includes(searchVal) ||
      (e.site_name||'').toLowerCase().includes(searchVal) ||
      (e.supply_name||'').toLowerCase().includes(searchVal) ||
      (e.gears||[]).some(g => (g.asset_name||'').toLowerCase().includes(searchVal) || (g.asset_type||'').toLowerCase().includes(searchVal))
    );
  }

  // Filter by gear category
  if(CURRENT_MAPPING_CATEGORY !== 'all'){
    filteredElds = filteredElds.map(e => {
      const matchingGears = (e.gears||[]).filter(g => (g.asset_type||'').toUpperCase() === CURRENT_MAPPING_CATEGORY);
      return { ...e, gears: matchingGears, gear_count: matchingGears.length };
    }).filter(e => e.gears.length > 0);
  }

  // KPIs reflect the active filter so counts stay honest when narrowing to one site/asset
  const anyFilter = !!(siteVal || searchVal || CURRENT_MAPPING_CATEGORY !== 'all');
  const totalEldsCount = anyFilter
    ? filteredElds.length
    : (MAPPING_OVERVIEW_DATA.count_elds || elds.length);
  const totalGearsCount = anyFilter
    ? filteredElds.reduce((sum, e) => sum + ((e.gears || []).length), 0)
    : (MAPPING_OVERVIEW_DATA.count_mapped_gears || elds.reduce((sum, e) => sum + (e.gear_count || 0), 0));

  if(_$('#mapKpiElds')) _$('#mapKpiElds').textContent = `${totalEldsCount} ELDs`;
  if(_$('#mapKpiGears')) _$('#mapKpiGears').textContent = `${totalGearsCount} Gears`;

  if(!filteredElds.length){
    container.innerHTML = '<div class="loading" style="background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:30px">No ELDs or mapped assets match your search/category filter.</div>';
    return;
  }

  let html = filteredElds.map(e => {
    const gears = e.gears || [];
    const gearRows = gears.map(g => {
      const attrs = g.attributes_under_consideration || [];
      const attrPills = attrs.map(a => `<span class="map-attr">${a}</span>`).join('') || '<span class="muted">Generic evaluation</span>';

      return `
        <tr>
          <td style="font-weight:700;color:var(--txt)">
            ${g.asset_name}
            ${SHOW_ASSET_ID ? `<div style="font-size:10.5px;color:var(--mut);font-weight:500">Asset ID: ${g.asset_id}</div>` : ''}
          </td>
          <td><span class="gtype">${g.asset_type}</span></td>
          <td>
            <div>${attrPills}</div>
            ${g.threshold_min_up ? `<div class="map-thr">Min UP Threshold: ${g.threshold_min_up}</div>` : ''}
          </td>
          <td style="font-size:11.5px;color:var(--mut)">
            ${g.rule_description || 'Evaluated for power loss during ELD trips'}
          </td>
        </tr>
      `;
    }).join('');

    const cid = e.eld_id;
    const isOpen = MAPPING_OPEN.has(String(cid));
    return `
      <div class="map-card${isOpen ? ' open' : ''}" id="mapcard_${cid}">
        <div class="map-head" onclick="toggleMappingCard('${cid}')">
          <div class="mh-left">
            <span class="map-chev">\u25b6</span>
            <h4 class="map-name">${e.eld_name || ('ELD '+e.eld_id)}</h4>
            ${e.supply_name ? `<span class="map-supply">${e.supply_name}</span>` : ''}
            <span class="sitetag">${e.site_name || 'Station'}</span>
          </div>
          <span class="map-count">${gears.length} Mapped Asset${gears.length!==1?'s':''} <span class="map-chev-hint">${isOpen ? 'click to close' : 'click to open'}</span></span>
        </div>
        <div class="map-body">
          ${e.check_label ? `<div class="map-crit"><b>Evaluated Criteria:</b> ${e.check_label}</div>` : ''}
          <div style="overflow-x:auto">
            <table class="map-tbl">
              <thead>
                <tr>
                  <th>Mapped Asset Name</th>
                  <th>Gear Type</th>
                  <th>Attributes Under Consideration</th>
                  <th>Evaluation Rule & Threshold</th>
                </tr>
              </thead>
              <tbody>
                ${gearRows || '<tr><td colspan="4" class="muted" style="padding:12px;text-align:center">No assets mapped to this ELD.</td></tr>'}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    `;
  }).join('');

  container.innerHTML = html;
}

let MAPPING_OPEN = new Set(); // eld_ids whose mapping card is expanded \u2014 survives re-render/filter

function toggleMappingCard(id){
  const card = document.getElementById('mapcard_' + id);
  if(!card) return;
  const opened = card.classList.toggle('open');
  const hint = card.querySelector('.map-chev-hint');
  if(hint) hint.textContent = opened ? 'click to close' : 'click to open';
  if(opened) MAPPING_OPEN.add(String(id)); else MAPPING_OPEN.delete(String(id));
}

function setAllMappingCards(open){
  document.querySelectorAll('.map-card').forEach(card => {
    const id = card.id.replace('mapcard_', '');
    card.classList.toggle('open', open);
    const hint = card.querySelector('.map-chev-hint');
    if(hint) hint.textContent = open ? 'click to close' : 'click to open';
    if(open) MAPPING_OPEN.add(String(id)); else MAPPING_OPEN.delete(String(id));
  });
}

