        }

            #eldApp .an-hero .eyebrow .dot {
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--calm-blue)
            }

        #eldApp .an-hero .lede {
            font-size: 21px;
            line-height: 1.5;
            font-weight: 500;
            color: var(--calm-ink);
            letter-spacing: -.01em;
            max-width: 70ch
        }

            #eldApp .an-hero .lede b {
                font-weight: 750
            }

            #eldApp .an-hero .lede .n-red {
                color: var(--calm-red);
                font-weight: 750
            }

            #eldApp .an-hero .lede .n-green {
                color: var(--calm-green);
                font-weight: 750
            }

            #eldApp .an-hero .lede .n-blue {
                color: var(--calm-blue);
                font-weight: 750
            }

            #eldApp .an-hero .lede .n-amber {
                color: var(--calm-amber);
                font-weight: 750
            }

        #eldApp .an-hero .sub {
            margin-top: 14px;
            font-size: 13px;
            color: var(--calm-ink-soft);
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap
