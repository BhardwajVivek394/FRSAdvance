                <section class="content">
                    <div id="emptyState2" class="empty-state">Select a site, fetch point machines, then click one to analyze.</div>
                    <div id="loading" class="loader" style="display:none;"><span class="spinner"></span><div style="margin-top:10px;">Analyzing&hellip;</div></div>
                    <div id="results" style="display:none;"></div>
                </section>
            </div>

            <script>
                (function () {
                    // Shared file:// fallback is computed once, at the top level, outside every
                    // IIFE (see window.__PM_API_BASE near the top of this document) - reused here
                    // instead of redoing the detection independently in this app's own closure.
                    // endpoints injected

                    const S = { sites: [], assets: [], currentSiteId: null, selectedAsset: null };

                    async function loadSites() {
                        try {
                            const r = await fetch(PM2_ENDPOINTS.sites);
                            S.sites = await r.json();
                            const sel = document.getElementById('siteSelect2');
                            sel.innerHTML = '<option value="">-- Select Site --</option>' +
                                S.sites.map(s => `<option value="${s.SiteId}">${s.SiteName} (${s.SiteId})</option>`).join('');
                        } catch (e) {
                            document.getElementById('siteSelect2').innerHTML = '<option>Failed to load sites</option>';
                        }
                    }

                    function waveChipsFor(pm) {
                        if (pm.unresolved) return '<span class="wave-chip unresolved">wave type unresolved</span>';
                        if (pm.mixed) return `<span class="wave-chip mixed">A=${pm.aWave} / B=${pm.bWave}</span>`;
                        const w = pm.aWave || pm.bWave;
                        return `<span class="wave-chip ${w.toLowerCase()}">${w}</span>`;
                    }

                    async function fetchAssets() {
                        const siteId = document.getElementById('siteSelect2').value;
                        if (!siteId) { alert('Select a site first'); return; }
                        S.currentSiteId = siteId;
                        const btn = document.getElementById('fetchPmBtn2');
                        btn.disabled = true;
                        const originalLabel = btn.textContent;
                        btn.textContent = 'Fetching\u2026';
                        document.getElementById('pmList2').innerHTML = '<div style="text-align:center; padding:24px 0;"><span class="spinner"></span><div style="margin-top:8px; color:var(--muted); font-size:12px;">Fetching point machines\u2026</div></div>';
                        try {
                            const r = await fetch(`${PM2_ENDPOINTS.assets}?SiteId=${encodeURIComponent(siteId)}`);
                            S.assets = await r.json();
                            document.getElementById('pmCount2').textContent = `(${S.assets.length})`;
                            const list = document.getElementById('pmList2');
                            list.innerHTML = S.assets.map((pm, i) => `
                                                                    <div class="pm-item" onclick="selectAsset(${i})" id="pm-${i}">
                                                                        <div class="pm-name">${pm.assetName}</div>
                                                                        ${waveChipsFor(pm)}
                                                                    </div>`).join('');
                            document.getElementById('custom-pm-select2').innerHTML = '<option value="">-- Select --</option>' +
                                S.assets.map((pm, i) => `<option value="${i}">${pm.assetName}</option>`).join('');
                            document.getElementById('quick-pm-select2').innerHTML = '<option value="">-- Select --</option>' +
                                S.assets.map((pm, i) => `<option value="${i}">${pm.assetName}</option>`).join('');
                        } catch (e) {
                            document.getElementById('pmList2').innerHTML = '';
                            alert('Failed to fetch point machines: ' + e.message);
                        }
                        btn.disabled = false;
                        btn.textContent = originalLabel;
                    }

                    // Renders {verdict, points, recommendation} as a scannable bullet list -
                    // same contract/shape as the other 3 modules' AI summary.
                    function renderSummaryBullets(data) {
                        if (!data || typeof data !== 'object' || Array.isArray(data)) {
                            return `<span>${escapeHtml(data || 'No summary returned.')}</span>`;
                        }
                        const points = Array.isArray(data.points) ? data.points : [];
                        const bullets = points.map(p => `<li style="margin-bottom:4px;">${escapeHtml(p)}</li>`).join('');
                        return `<div style="font-weight:800; font-size:14px; margin-bottom:6px;">${escapeHtml(data.verdict)}</div>`
                            + (bullets ? `<ul style="margin:0 0 6px 18px; padding:0;">${bullets}</ul>` : '')
                            + (data.recommendation ? `<div style="margin-top:4px;"><b>Recommendation:</b> ${escapeHtml(data.recommendation)}</div>` : '');
                    }

                    function escapeHtml(s) {
                        const d = document.createElement('div');
                        d.textContent = s == null ? '' : String(s);
                        return d.innerHTML;
                    }

                    async function selectAsset(idx) {
                        document.querySelectorAll('.pm-item').forEach(el => el.classList.remove('active'));
                        document.getElementById(`pm-${idx}`).classList.add('active');
                        const pm = S.assets[idx];
                        S.selectedAsset = pm;
                        S.selectedIdx = idx;
                        const pmSelect = document.getElementById('custom-pm-select2');
                        if (pmSelect) pmSelect.value = String(idx);
                        const quickSelect = document.getElementById('quick-pm-select2');
                        if (quickSelect) quickSelect.value = String(idx);
                        updateCompactSidebar2();
                        const sidebarEl2 = document.querySelector('#model2-wrap .sidebar');
                        if (sidebarEl2 && !sidebarEl2.classList.contains('collapsed')) toggleSidebar2(true);
                        await runAnalyze(pm, false);
                    }

                    let currentAnalysisMode2 = 'quick';   // 'quick' or 'custom'

                    function switchAnalysisMode2(mode) {
                        currentAnalysisMode2 = mode;
                        document.getElementById('mode-quick-btn2').classList.toggle('active', mode === 'quick');
                        document.getElementById('mode-custom-btn2').classList.toggle('active', mode === 'custom');
                        document.getElementById('custom-date-panel2').style.display = mode === 'custom' ? 'block' : 'none';
                        document.getElementById('pm-list-section2').style.display = mode === 'custom' ? 'none' : 'block';
                        updateCompactSidebar2();
                        if (mode === 'custom') {
                            const today = new Date().toISOString().split('T')[0];
                            const past30 = new Date(); past30.setDate(past30.getDate() - 30);
                            const fromInput = document.getElementById('custom-from-date2');
                            const toInput = document.getElementById('custom-to-date2');
                            if (!toInput.value) toInput.value = today;
                            if (!fromInput.value) fromInput.value = past30.toISOString().split('T')[0];
                            toInput.max = today; fromInput.max = today;
                            validateDateRange2();
                        }
                    }

                    function getCustomRange2() {
                        const fromVal = document.getElementById('custom-from-date2').value;
                        const toVal = document.getElementById('custom-to-date2').value;
                        if (!fromVal || !toVal) return null;
                        const fromTime = (document.getElementById('custom-from-time2').value || '00:00:00');
                        const toTime = (document.getElementById('custom-to-time2').value || '23:59:59');
                        const fullFromTime = fromTime.length === 5 ? fromTime + ':00' : fromTime;
                        const fullToTime = toTime.length === 5 ? toTime + ':00' : toTime;
                        return {
                            startDate: new Date(`${fromVal}T${fullFromTime}`),
                            endDate: new Date(`${toVal}T${fullToTime}`),
                        };
                    }

                    function validateDateRange2() {
                        const errorEl = document.getElementById('date-range-error2');
                        const applyBtn = document.getElementById('apply-custom-dates-btn2');
                        const range = getCustomRange2();
                        if (!range) { errorEl.style.display = 'none'; applyBtn.disabled = true; return false; }
                        const diffDays = (range.endDate - range.startDate) / (1000 * 60 * 60 * 24);
                        if (diffDays < 0) {
                            errorEl.innerHTML = '\u26a0\ufe0f <b>Invalid range:</b> "To" cannot be before "From".';
                            errorEl.style.display = 'block'; applyBtn.disabled = true; return false;
                        }
                        if (diffDays > 90) {
                            errorEl.innerHTML = `\u26a0\ufe0f <b>Limit exceeded:</b> selected range (${diffDays.toFixed(1)} days) exceeds the 90-day max.`;
                            errorEl.style.display = 'block'; applyBtn.disabled = true; return false;
                        }
                        errorEl.style.display = 'none'; applyBtn.disabled = false; return true;
                    }

                    function applyCustomDates2() {
                        const idx = document.getElementById('custom-pm-select2').value;
                        if (idx === '') { alert('Select a point machine first.'); return; }
                        if (!validateDateRange2()) return;
                        const pm = S.assets[idx];
                        S.selectedAsset = pm;
                        S.selectedIdx = idx;
                        document.querySelectorAll('.pm-item').forEach(el => el.classList.remove('active'));
                        const el = document.getElementById(`pm-${idx}`);
                        if (el) el.classList.add('active');
                        const quickSelect = document.getElementById('quick-pm-select2');
                        if (quickSelect) quickSelect.value = String(idx);
                        updateCompactSidebar2();
                        const sidebarEl2b = document.querySelector('#model2-wrap .sidebar');
                        if (sidebarEl2b && !sidebarEl2b.classList.contains('collapsed')) toggleSidebar2(true);
                        runAnalyze(pm, true);
                    }

                    async function runAnalyze(pm, forceLive) {
                        document.getElementById('emptyState2').style.display = 'none';
                        document.getElementById('results').style.display = 'none';

                        let rangeParams = '';
                        if (currentAnalysisMode2 === 'custom') {
                            if (!validateDateRange2()) {
                                document.getElementById('emptyState2').style.display = 'block';
                                document.getElementById('emptyState2').textContent = 'Pick a valid custom date range first.';
                                return;
                            }
                            const range = getCustomRange2();
                            const fmt = d => d.toISOString().slice(0, 19);
                            rangeParams = `&StartDate=${encodeURIComponent(fmt(range.startDate))}&EndDate=${encodeURIComponent(fmt(range.endDate))}`;
                            S.lastRangeLabel = `${range.startDate.toLocaleDateString()} \u2192 ${range.endDate.toLocaleDateString()} (custom)`;
                            forceLive = true;
                        } else {
                            S.lastRangeLabel = 'last 30 days';
                        }

                        document.getElementById('loading').style.display = 'block';

                        try {
                            const siteObj = (S.sites || []).find(s => String(s.SiteId) === String(S.currentSiteId));
                            const siteName = (siteObj && siteObj.SiteName) || '';
                            const url = `${PM2_ENDPOINTS.analyze}?SiteId=${encodeURIComponent(S.currentSiteId)}&AssetId=${encodeURIComponent(pm.assetId)}&WindowDays=30`
                                + `&AssetName=${encodeURIComponent(pm.assetName)}&SiteName=${encodeURIComponent(siteName)}`
                                + (forceLive ? '&ForceLive=true' : '')
                                + rangeParams;
                            const r = await fetch(url);
                            const data = await r.json();
                            if (!r.ok) throw new Error(data.detail || `HTTP ${r.status}`);
                            S.lastData = data;
                            renderResults(pm, data);
                        } catch (e) {
                            document.getElementById('loading').style.display = 'none';
                            document.getElementById('results').style.display = 'block';
                            document.getElementById('results').innerHTML = `<div class="banner warn">Analysis failed: ${escapeHtml(e.message)}</div>`;
                        }
                    }

                    function updateCurrentAsset() {
                        if (S.selectedAsset) runAnalyze(S.selectedAsset, true);
                    }

                    function sideSummary(ops) {
                        const counts = { NORMAL: 0, WATCH: 0, ALERT: 0, FAULT: 0, INVALID: 0 };
                        const conditions = {};
                        ops.forEach(o => {
                            const c = o.confirmed || (o.grade === 'INVALID' ? 'INVALID' : null);
                            if (c && counts[c] !== undefined) counts[c]++;
                            if (o.condition && o.condition !== '-') {
                                o.condition.split('+').forEach(cond => { conditions[cond] = (conditions[cond] || 0) + 1; });
                            }
                        });
                        return { counts, conditions, total: ops.length };
                    }

                    // What each detector condition means - see pm_operation2/files.../ADDING_EXCEPTION_TYPES.md
                    // and SCHEME_UPDATE_REFERENCES.md. "calib" notes how solid the threshold is.
                    const CONDITION_INFO = {
                        'END-FRICTION': { text: 'Friction right at the end of the stroke - current dips after the initial rush, then rises again sharply just before cut-off (a late secondary peak). Calibrated from 13 real SSE-confirmed strokes (end_rise 1.59-2.71).', calib: 'Calibrated (SSE sheet, n=13)' },
                        'CREEPING': { text: 'Same late-rise signature as END-FRICTION, but stretched out gradually instead of sharp - a slow, dragging finish rather than a quick friction spike. Often points to binding or a mechanism that needs lubrication rather than acute damage.', calib: 'Calibrated (SSE sheet, n=13)' },
                        'OBSTRUCTION': { text: 'Current stays pegged near maximum for most of an unusually long stroke - the classic signature of something physically blocking the switch from completing its throw.', calib: 'Provisional (reference panels only, not yet SSE-confirmed)' },
                        'SLAGGING': { text: 'The running current floor is elevated well above this specific machine\'s own normal history - relative only, so a machine that has always run a bit high is not flagged as newly slagging.', calib: 'Provisional (no SSE sheet yet)' },
                        'SIGNATURE-CHANGE': { text: 'The overall shape of the stroke has drifted from this machine\'s own median shape, even though no single number crosses a hard threshold - catches gradual degradation that looks fine machine-by-machine but reads differently over time.', calib: 'Provisional (no SSE sheet yet)' },
                    };

                    function renderSideCard(label, side, sideKey) {
                        if (!side.wave_type) {
                            return `<div class="card"><div class="card-title">${label}</div><div style="color:var(--muted); font-size:13px;">Wave type unresolved for this side - cannot analyze.</div></div>`;
                        }
                        if (!side.ops.length) {
                            return `<div class="card"><div class="card-title">${label} \u00b7 ${side.wave_type}</div><div style="color:var(--muted); font-size:13px;">No operations in this window.</div></div>`;
                        }
                        const s = sideSummary(side.ops);
                        const pct = n => s.total ? Math.round(n / s.total * 1000) / 10 : 0;
                        const stat = (val, lbl, cls) => `<div class="stat"><div class="v ${cls || ''}">${val}</div><div class="l">${lbl}</div></div>`;
                        const condChips = Object.entries(s.conditions).sort((a, b) => b[1] - a[1])
                            .map(([name, count]) => `<span class="cond-chip" style="cursor:pointer;" onclick="showConditionExplain('${sideKey}', '${name}', '${label}')" title="Click to see what this means">${escapeHtml(name)} <b>${count}</b></span>`).join('');

                        return `<div class="card">
                                                                <div class="card-title"><span>${label} \u00b7 ${side.wave_type}</span><span>${s.total} ops</span></div>
                                                                <div class="stat-row">
                                                                    ${stat(s.counts.NORMAL, 'Normal', 'grade-NORMAL')}
                                                                    ${stat(s.counts.WATCH, 'Watch', 'grade-WATCH')}
                                                                    ${stat(s.counts.ALERT, 'Alert', 'grade-ALERT')}
                                                                    ${stat(s.counts.FAULT, 'Fault', 'grade-FAULT')}
                                                                </div>
                                                                <div style="font-size:11px; color:var(--muted); margin-bottom:6px; text-transform:uppercase; font-weight:700;">Conditions detected</div>
                                                                <div>${condChips || '<span style="color:var(--muted); font-size:12px;">None</span>'}</div>
                                                            </div>`;
                    }

                    // Plotly's click event gives (curveNumber, pointNumber) - pointNumber only
                    // indexes the points actually PLOTTED in that trace (ops with no grade are
                    // skipped), so we keep a side-channel array of which op each plotted point
                    // came from, aligned 1:1 with the trace's x/y arrays.
                    const TIMELINE_OPS = { a: [], b: [] };
                    const TIMELINE_TRACE_INDEX = { a: null, b: null };

                    function timelineTrace(ops, yVal, label, side) {
                        const colorFor = g => ({ NORMAL: '#16a34a', WATCH: '#ca8a04', ALERT: '#ea580c', FAULT: '#dc2626' }[g] || '#94a3b8');
                        const x = [], y = [], colors = [], text = [], sizes = [];
                        TIMELINE_OPS[side] = [];
                        ops.forEach(o => {
                            if (!o.time) return;
                            const grade = o.confirmed || (o.grade === 'INVALID' ? null : o.grade);
                            if (!grade) return;
                            x.push(o.time);
                            y.push(yVal);
                            colors.push(colorFor(grade));
                            sizes.push(grade === 'NORMAL' ? 6 : 9);
                            const cond = o.condition && o.condition !== '-' ? `<br>Condition: <b>${o.condition}</b>` : '';
                            const ft = o.fault_type ? `<br>Fault type: <b>${o.fault_type}</b>` : '';
                            text.push(`<b>${label}</b> \u00b7 ${new Date(o.time).toLocaleString()}<br>Grade: <b>${grade}</b>${cond}${ft}<br><i>Click for current/voltage</i>`);
                            TIMELINE_OPS[side].push(o);
                        });
                        return {
                            x, y, text, mode: 'markers', type: 'scatter', name: label,
                            marker: { color: colors, size: sizes, line: { width: 1, color: '#fff' } },
                            hovertemplate: '%{text}<extra></extra>'
                        };
                    }

                    function renderTimeline(dataA, dataB) {
                        CURRENT_HIGHLIGHT = null;
                        const traces = [];
                        TIMELINE_TRACE_INDEX.a = null; TIMELINE_TRACE_INDEX.b = null;
                        if (dataA.ops.length) { traces.push(timelineTrace(dataA.ops, 2, 'A', 'a')); TIMELINE_TRACE_INDEX.a = traces.length - 1; }
                        if (dataB.ops.length) { traces.push(timelineTrace(dataB.ops, 1, 'B', 'b')); TIMELINE_TRACE_INDEX.b = traces.length - 1; }
                        if (!traces.length) return;
                        const layout = {
                            height: 260, margin: { l: 50, r: 20, t: 10, b: 40 },
                            xaxis: { type: 'date' },
                            yaxis: { tickmode: 'array', tickvals: [1, 2], ticktext: ['B', 'A'], range: [0.5, 2.5] },
                            showlegend: false, hovermode: 'closest',
                        };
                        const el = document.getElementById('timeline');
                        Plotly.newPlot(el, traces, layout, { responsive: true, displaylogo: false });
                        el.removeAllListeners && el.removeAllListeners('plotly_click');
                        el.on('plotly_click', (ev) => {
                            const pt = ev.points && ev.points[0];
                            if (!pt) return;
                            const side = Object.keys(TIMELINE_TRACE_INDEX).find(k => TIMELINE_TRACE_INDEX[k] === pt.curveNumber);
                            const op = side && TIMELINE_OPS[side] && TIMELINE_OPS[side][pt.pointNumber];
                            if (op) renderDetail(op, side === 'a' ? 'Machine A' : 'Machine B');
                        });
                    }

                    // Highlights every point matching condName on the given side's timeline row -
                    // enlarges + outlines matches, fades everything else on that same row, so a
                    // condition's distribution over time is visible at a glance instead of having
                    // to hunt for it among a hundred other dots.
                    function highlightCondition(sideKey, condName) {
                        const idx = TIMELINE_TRACE_INDEX[sideKey];
                        if (idx == null) return;
                        const ops = TIMELINE_OPS[sideKey];
                        const sizes = [], lineWidths = [], lineColors = [], opacities = [];
                        ops.forEach(o => {
                            const match = !!(o.condition && o.condition.split('+').includes(condName));
                            const grade = o.confirmed || (o.grade === 'INVALID' ? null : o.grade);
                            sizes.push(match ? 15 : (grade === 'NORMAL' ? 6 : 9));
                            lineWidths.push(match ? 3 : 1);
                            lineColors.push(match ? '#000000' : '#ffffff');
                            opacities.push(match ? 1 : 0.18);
                        });
                        Plotly.restyle('timeline', {
                            'marker.size': [sizes],
                            'marker.line.width': [lineWidths],
                            'marker.line.color': [lineColors],
                            'marker.opacity': [opacities],
                        }, [idx]);
                    }

                    // Restores a side's timeline row to its normal (no-highlight) marker style.
                    function clearHighlight(sideKey) {
                        const idx = TIMELINE_TRACE_INDEX[sideKey];
                        if (idx == null) return;
                        const ops = TIMELINE_OPS[sideKey];
                        const sizes = [], opacities = [];
                        ops.forEach(o => {
                            const grade = o.confirmed || (o.grade === 'INVALID' ? null : o.grade);
                            sizes.push(grade === 'NORMAL' ? 6 : 9);
                            opacities.push(1);
                        });
                        Plotly.restyle('timeline', {
                            'marker.size': [sizes],
                            'marker.line.width': [Array(ops.length).fill(1)],
                            'marker.line.color': [Array(ops.length).fill('#ffffff')],
                            'marker.opacity': [opacities],
                        }, [idx]);
                    }

                    function lineChart(divId, values, color, title) {
                        Plotly.newPlot(divId, [{
                            y: values, mode: 'lines', line: { color, width: 1.6 }, fill: 'tozeroy',
                            fillcolor: color + '18',
                        }], {
                            height: 180, margin: { l: 40, r: 10, t: 24, b: 24 },
                            title: { text: title, font: { size: 11 } },
                            xaxis: { showgrid: false }, yaxis: { zeroline: false },
                        }, { responsive: true, displaylogo: false });
                    }

                    function renderDetail(op, label) {
                        const box = document.getElementById('detailBox');
                        box.style.display = 'block';
                        document.getElementById('detailTitle').textContent =
                            `${label} \u00b7 ${new Date(op.time).toLocaleString()} \u00b7 ${op.confirmed || op.grade}` +
                            (op.condition && op.condition !== '-' ? ` \u00b7 ${op.condition}` : '') +
                            (op.fault_type && op.fault_type !== op.condition ? ` \u00b7 ${op.fault_type}` : '');
                        document.getElementById('detailNotes').textContent = op.cond_notes || '';
                        lineChart('detailCurrentChart', op.current || [], '#d97706', 'Current (A)');
                        lineChart('detailVoltageChart', op.voltage || [], '#0d9488', 'Voltage (V)');
                        box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }

                    let CURRENT_HIGHLIGHT = null;  // {side, cond} of the currently-selected chip, or null

                    function showConditionExplain(sideKey, condName, label) {
                        // Clicking the already-selected chip again deselects it.
                        if (CURRENT_HIGHLIGHT && CURRENT_HIGHLIGHT.side === sideKey && CURRENT_HIGHLIGHT.cond === condName) {
                            clearHighlight(sideKey);
                            CURRENT_HIGHLIGHT = null;
                            document.getElementById('explainBox').style.display = 'none';
                            return;
                        }
                        if (CURRENT_HIGHLIGHT && CURRENT_HIGHLIGHT.side !== sideKey) clearHighlight(CURRENT_HIGHLIGHT.side);
                        CURRENT_HIGHLIGHT = { side: sideKey, cond: condName };
                        highlightCondition(sideKey, condName);
                        const ops = (S.lastData && S.lastData[sideKey] && S.lastData[sideKey].ops) || [];
                        const example = ops.find(o => o.condition && o.condition.split('+').includes(condName) && o.current && o.current.length);
                        const ideal = ops.find(o => o.confirmed === 'NORMAL' && o.current && o.current.length);

                        const box = document.getElementById('explainBox');
                        box.style.display = 'block';
                        const info = CONDITION_INFO[condName] || { text: 'No description available.', calib: '' };
                        document.getElementById('explainTitle').textContent = `${condName} \u2014 ${label}`;
                        document.getElementById('explainText').innerHTML =
                            `${escapeHtml(info.text)}` + (info.calib ? `<div style="margin-top:6px; font-style:italic; color:var(--muted);">${escapeHtml(info.calib)}</div>` : '');

                        const row = (divId, title, op) => {
                            if (!op) return `<div style="flex:1; min-width:260px; color:var(--muted); font-size:12px;">${escapeHtml(title)}: no example available in this window.</div>`;
                            return `<div style="flex:1; min-width:260px;">
                                                                    <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--muted); margin-bottom:4px;">${escapeHtml(title)} \u00b7 ${new Date(op.time).toLocaleString()}</div>
                                                                    <div id="${divId}"></div>
                                                                </div>`;
                        };
                        document.getElementById('explainPlots').innerHTML =
                            row('explainIdealChart', 'Ideal (Normal)', ideal) + row('explainExampleChart', `This condition (${condName})`, example);
                        if (ideal) lineChart('explainIdealChart', ideal.current, '#16a34a', 'Ideal - Current (A)');
                        if (example) lineChart('explainExampleChart', example.current, '#dc2626', `${condName} - Current (A)`);
                        box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }

                    function renderResults(pm, data) {
                        document.getElementById('loading').style.display = 'none';
                        const el = document.getElementById('results');
                        el.style.display = 'block';

                        let banner = '';
                        if (pm.mixed) {
                            banner = `<div class="banner warn">This asset has DIFFERENT wave types per side: A=${pm.aWave}, B=${pm.bWave}. Each side is scored with its own correct model.</div>`;
                        }

                        const updatedLabel = data.generated_at
                            ? (data._from_cache ? 'Cached result \u00b7 ' : 'Live result \u00b7 ') + new Date(data.generated_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short' }) + ' IST'
                            : '';

                        el.innerHTML = `
                                                                <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:4px;">
                                                                    <div>
                                                                        <h2 style="margin:0 0 4px;">${escapeHtml(pm.assetName)}</h2>
                                                                        <div style="color:var(--muted); font-size:12px;">${escapeHtml(S.lastRangeLabel || 'last 30 days')}</div>
                                                                        <div style="color:var(--muted); font-size:11px; margin-top:2px;">${updatedLabel}</div>
                                                                    </div>
                                                                    <button class="btn" style="width:auto; padding:8px 14px;" onclick="updateCurrentAsset()" title="Ignore cache, re-fetch and re-analyze right now">Update Results</button>
                                                                </div>
                                                                ${banner}
                                                                <div id="aiSummaryBox" class="card" style="display:none; background:linear-gradient(135deg, var(--accent-muted), rgba(147,51,234,0.06)); border-color:var(--accent);">
                                                                    <div class="card-title" style="color:var(--accent);">AI Summary</div>
                                                                    <div id="aiSummaryText2" style="font-size:13.5px; line-height:1.6;"></div>
                                                                </div>
                                                                <div class="card">
                                                                    <div class="card-title"><span>Timeline</span><span style="font-weight:500; text-transform:none;">Click a point for current/voltage \u00b7 click a condition chip below to highlight it here</span></div>
                                                                    <div id="timeline"></div>
                                                                </div>
                                                                <div id="detailBox" class="card" style="display:none;">
                                                                    <div class="card-title"><span id="detailTitle">Operation detail</span></div>
                                                                    <div id="detailNotes" style="font-size:12px; color:var(--muted); margin-bottom:10px;"></div>
                                                                    <div style="display:flex; gap:14px; flex-wrap:wrap;">
                                                                        <div style="flex:1; min-width:280px;" id="detailCurrentChart"></div>
                                                                        <div style="flex:1; min-width:280px;" id="detailVoltageChart"></div>
                                                                    </div>
                                                                </div>
                                                                <div style="display:flex; gap:16px; flex-wrap:wrap;">
                                                                    <div style="flex:1; min-width:320px;">${renderSideCard('Machine A', data.a, 'a')}</div>
                                                                    <div style="flex:1; min-width:320px;">${renderSideCard('Machine B', data.b, 'b')}</div>
                                                                </div>
                                                                <div id="explainBox" class="card" style="display:none;">
                                                                    <div class="card-title"><span id="explainTitle">Condition</span></div>
                                                                    <div id="explainText" style="font-size:13px; line-height:1.5; margin-bottom:12px;"></div>
                                                                    <div id="explainPlots" style="display:flex; gap:14px; flex-wrap:wrap;"></div>
                                                                </div>
                                                            `;
                        renderTimeline(data.a, data.b);

                        if (data.ai_summary) {
                            document.getElementById('aiSummaryBox').style.display = 'block';
                            document.getElementById('aiSummaryText2').innerHTML = renderSummaryBullets(data.ai_summary);
                        }
                    }

                    // Inline HTML "on*=" attribute handlers (both the static one in the markup,
                    // onclick="fetchAssets()", and the ones generated dynamically via innerHTML,
                    // e.g. onclick="selectAsset(2)") always execute in the GLOBAL scope, never
                    // inside this IIFE's closure - so every function they call has to be
                    // explicitly exposed on window, or the browser throws "<fn> is not defined"
                    // the moment the attribute fires.
                    window.fetchAssets = fetchAssets;
                    window.selectAsset = selectAsset;
                    window.updateCurrentAsset = updateCurrentAsset;
                    window.switchAnalysisMode2 = switchAnalysisMode2;
                    window.toggleSidebar2 = toggleSidebar2;

                    function toggleSidebar2(forceCollapsed) {
                        const sidebar = document.querySelector('#model2-wrap .sidebar');
                        const toggleBtn = document.getElementById('sidebar-toggle-btn2');
                        if (!sidebar) return;
                        const isCollapsed = typeof forceCollapsed === 'boolean'
                            ? (sidebar.classList.toggle('collapsed', forceCollapsed), forceCollapsed)
                            : sidebar.classList.toggle('collapsed');
                        if (toggleBtn) {
                            toggleBtn.title = isCollapsed ? 'Expand Sidebar' : 'Collapse Sidebar';
                            toggleBtn.classList.toggle('collapsed-active', isCollapsed);
                        }
                        setSidebarCssWidth('model2-wrap', isCollapsed ? 64 : getSavedSidebarWidth());
                        setTimeout(() => window.dispatchEvent(new Event('resize')), 300);
                    }

                    function updateCompactSidebar2() {
                        const quickIcon = document.getElementById('compact-mode-quick2');
                        const customIcon = document.getElementById('compact-mode-custom2');
                        if (quickIcon && customIcon) {
                            const isCustom = currentAnalysisMode2 === 'custom';
                            quickIcon.style.display = isCustom ? 'none' : 'block';
                            customIcon.style.display = isCustom ? 'block' : 'none';
                        }
                        const badge = document.getElementById('compact-pm-badge2');
                        if (badge) {
                            const pm = S.selectedAsset;
                            setCompactBadgeText(badge, pm && pm.assetName);
                            badge.title = pm ? pm.assetName : 'No point machine selected';
                        }
                    }
                    window.validateDateRange2 = validateDateRange2;
                    window.applyCustomDates2 = applyCustomDates2;
                    window.showConditionExplain = showConditionExplain;
                    window.__pmState2 = S;

                    loadSites();
                })();
            </script>
        </div>
    }


    <div id="model3-wrap" class="pm-combined-section @(!ViewBag.IsSiteKeeping ? "active" : "")" data-theme="light">


        <header>
            <div class="header-sidebar-slot">
