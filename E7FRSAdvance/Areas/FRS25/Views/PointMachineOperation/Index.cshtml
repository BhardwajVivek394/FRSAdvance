                    <svg id="themeIcon3" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
                </button>
            </div>
        </header>

        <div class="main">
            <aside class="sidebar">
                <div class="sidebar-compact" title="Click to expand">
                    <div class="compact-icon-btn" title="Analysis window">
                        <svg id="compact-mode-quick3" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                        <svg id="compact-mode-custom3" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M8 14h4v4H8z"></path></svg>
                    </div>
                    <div class="compact-icon-btn compact-pm-badge" id="compact-pm-badge3" title="No point machine selected">&ndash;</div>
                </div>
                <div class="sidebar-full">
                    <div style="display:flex; background:var(--bg-primary); border:1px solid var(--border); border-radius:10px; padding:3px; margin-bottom:14px;">
                        <button id="mode-quick-btn3" class="mode-tab-btn active" onclick="switchAnalysisMode3('quick')">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                            <span>30-Day</span>
                        </button>
                        <button id="mode-custom-btn3" class="mode-tab-btn" onclick="switchAnalysisMode3('custom')">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M8 14h4v4H8z"></path></svg>
                            <span>Custom</span>
                        </button>
                    </div>
                    <div class="form-row">
                        <label>Site</label>
                        <select id="siteSelect3" onchange="this.value && fetchPointMachines3()"><option value="">Loading sites&hellip;</option></select>
                    </div>
                    <button class="btn primary" id="fetchPmBtn3" onclick="fetchPointMachines3()" style="display:none;">Fetch Point Machines</button>

                    <div id="custom-date-panel3" style="display:none; background:rgba(0,164,224,0.04); border:1px solid rgba(0,164,224,0.2); border-radius:10px; padding:10px 12px; margin-top:14px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                            <span style="font-size:12.5px; font-weight:700; color:var(--text-primary);">Custom Date Range</span>
                            <span style="font-size:10px; font-weight:700; color:var(--accent); background:rgba(0,164,224,0.12); padding:2px 6px; border-radius:12px;">Max 90 Days</span>
                        </div>
                        <label style="font-size:10.5px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:3px;">Point Machine</label>
                        <select id="custom-pm-select3" style="font-size:11.5px; padding:5px 7px; width:100%; margin-bottom:8px;">
                            <option value="">-- Select --</option>
                        </select>
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
                            <div>
                                <label style="font-size:10.5px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:3px;">From Date</label>
                                <input type="date" id="custom-from-date3" style="font-size:11.5px; padding:5px 7px; width:100%; margin-bottom:6px;" onchange="validateDateRange3()">
                                <label style="font-size:10.5px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:3px;">From Time</label>
                                <input type="time" id="custom-from-time3" value="00:00:00" step="1" style="font-size:11.5px; padding:5px 7px; width:100%;" onchange="validateDateRange3()">
                            </div>
                            <div>
                                <label style="font-size:10.5px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:3px;">To Date</label>
                                <input type="date" id="custom-to-date3" style="font-size:11.5px; padding:5px 7px; width:100%; margin-bottom:6px;" onchange="validateDateRange3()">
                                <label style="font-size:10.5px; font-weight:700; color:var(--text-muted); display:block; margin-bottom:3px;">To Time</label>
                                <input type="time" id="custom-to-time3" value="23:59:59" step="1" style="font-size:11.5px; padding:5px 7px; width:100%;" onchange="validateDateRange3()">
                            </div>
                        </div>
                        <div id="date-range-error3" style="display:none; font-size:11px; font-weight:600; color:#dc2626; margin-top:8px; background:rgba(220,38,38,0.08); border:1px solid rgba(220,38,38,0.25); padding:6px 8px; border-radius:6px;"></div>
                        <button class="btn primary" id="apply-custom-dates-btn3" style="margin-top:8px;" onclick="applyCustomDates3()" disabled>Analyze This Range</button>
                    </div>

                    <div class="form-row" id="pm-list-section3" style="margin-top:18px;">
                        <label>Point Machines <span id="pmCount3" style="color:var(--accent);"></span></label>
                        <select id="quick-pm-select3" style="font-size:11.5px; padding:5px 7px; width:100%; margin-bottom:8px;" onchange="if (this.value !== '') selectAsset3(Number(this.value))">
                            <option value="">-- Select --</option>
                        </select>
                        <div id="pmList3" style="display:none;"></div>
                    </div>
                </div>
            </aside>

            <section class="content">
                <div id="emptyState3" class="empty-state">Select a site, fetch point machines, then click one to analyze the last 30 days.</div>
                <div id="loading3" class="loader" style="display:none;"><span class="spinner"></span><div id="loading-text3" style="margin-top:10px;">Analyzing&hellip;</div></div>
                <div id="results3" style="display:none;"></div>
            </section>
        </div>

        <div id="toast3" class="toast"></div>


        <script>
            (function () {
                // endpoints injected

                const S = { sites: [], pointMachines: [], currentSiteId: null, selectedAsset: null, lastData: null, theme: localStorage.getItem('pm3-theme') || 'light' };
                const WINDOW_DAYS = 30;
                const TOP_FAULTS_N = 5;

                // Fixed color per family (not assigned dynamically) so the SAME family always
                // gets the SAME color across every asset - same principle as PMv1's
                // FAULT_COLORS. Skips green (Normal) and grey (No Data/Incomplete).
                const FAMILY_COLORS = {
                    '20 MOTOR-ELECTRICAL': '#2563eb', '30 UNLOCK-CLAMP-RELEASE': '#f59e0b',
                    '40 MOVEMENT-RESISTANCE': '#ca8a04', '50 TRANSMISSION-GEAR-BEARING': '#0d9488',
                    '60 OBSTRUCTION-STALL-CLUTCH': '#dc2626', '70 LOCK-CLAMP': '#7c3aed',
                    '80 DETECTION-MISMATCH': '#4338ca', '90 ROD-GROUND-CONNECTION': '#c026d3',
                    '99 ABNORMAL-UNKNOWN': '#1e293b', 'Unclassified': '#e11d48',
                };

                const FAMILY_INFO = {
                    '20 MOTOR-ELECTRICAL': 'Oscillatory / irregular current - inconsistent startup or operation-to-operation instability. Reported as SUSPECTED only: at 20ms sampling the Nyquist limit is 25Hz, so genuine brush/commutator ripple is not directly observable.',
                    '30 UNLOCK-CLAMP-RELEASE': 'Abnormal load specifically in the first ~20% of the stroke (unlock / clamp-release region), while the rest of the operation looks normal.',
                    '40 MOVEMENT-RESISTANCE': 'General elevated current through the movement (throw) phase - the stroke still completes, but pulls more current throughout than this machine normally does. Classic friction / lubrication-loss signature.',
                    '50 TRANSMISSION-GEAR-BEARING': 'A gradual rising ramp late in the stroke (not a sharp end-only spike) - matches the field-documented "end-friction" pattern from gear/bearing wear.',
                    '60 OBSTRUCTION-STALL-CLUTCH': 'Current pegged at a flat-topped high ceiling for an unusually long duration - the classic signature of something physically blocking the throw, or a slipping/mis-set clutch.',
                    '70 LOCK-CLAMP': 'A sharp current rise concentrated right at the very end of the stroke (lock / clamp engagement), not a gradual ramp.',
                    '80 DETECTION-MISMATCH': 'The current signature itself looks unremarkable - this label comes from the operation being marked "Out of Correspondence" or "Delayed Cut-off", detection-relay issues, not current-visible faults.',
                    '90 ROD-GROUND-CONNECTION': 'Ground-connection rod mechanical issue. No current examples in the training set yet - reserved for future confirmed cases.',
                    '99 ABNORMAL-UNKNOWN': 'Something is clearly wrong (the binary head is confident), but the waveform does not match any of the other 8 families clearly enough to name one. A genuinely learned class, not a manually-injected fallback.',
                    'Unclassified': 'Abnormal with no family returned by the model (unexpected - should not normally happen).',
                };


                // Global multi-select filter (same model as PMv1's MH.activeFilters) - clicking
                // a family chip under EITHER machine filters BOTH rows of the timeline, not
                // just that machine's own row.
                const activeFilters = new Set();

                function toast(msg, type) {
                    const el = document.getElementById('toast3');
                    el.textContent = msg;
                    el.className = 'toast show' + (type === 'error' ? ' error' : '');
                    setTimeout(() => el.classList.remove('show'), 3000);
                }

                function escapeHtml(s) {
                    const d = document.createElement('div');
                    d.textContent = s == null ? '' : String(s);
                    return d.innerHTML;
                }

                function applyTheme() {
                    document.getElementById('model3-wrap').setAttribute('data-theme', S.theme);
                    document.getElementById('themeIcon3').innerHTML = S.theme === 'dark'
                        ? '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>'
                        : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
                    if (S.lastData) renderTimeline(S.lastData.ops);
                }

                async function loadSites() {
                    try {
                        const r = await fetch(PM3_ENDPOINTS.sites);
                        S.sites = await r.json();
                        S.sites.sort((a, b) => (a.SiteName || '').localeCompare(b.SiteName || ''));
                        const sel = document.getElementById('siteSelect3');
                        sel.innerHTML = '<option value="">-- Select Site --</option>' +
                            S.sites.map(s => `<option value="${s.SiteId}">${escapeHtml(s.SiteName)} (${s.SiteId})</option>`).join('');
                    } catch (e) {
                        document.getElementById('siteSelect3').innerHTML = '<option>Failed to load sites</option>';
                    }
                }

                function waveChipsFor(pm) {
                    if (pm.mixedWaveType) return `<span class="wave-chip mixed">A=${pm.aWaveType || '?'} / B=${pm.bWaveType || '?'}</span>`;
                    const w = pm.aWaveType || pm.bWaveType;
                    if (!w) return '<span class="wave-chip unresolved">wave type unresolved</span>';
                    return `<span class="wave-chip ${w.toLowerCase()}">${w}</span>`;
                }

                async function fetchPointMachines3() {
                    const siteId = document.getElementById('siteSelect3').value;
                    if (!siteId) { toast('Select a site first', 'error'); return; }
                    S.currentSiteId = siteId;
                    const btn = document.getElementById('fetchPmBtn3');
                    btn.disabled = true;
                    const originalLabel = btn.textContent;
                    btn.textContent = 'Fetching\u2026';
                    document.getElementById('pmList3').innerHTML = '<div style="text-align:center; padding:24px 0;"><span class="spinner"></span><div style="margin-top:8px; color:var(--text-muted); font-size:12px;">Fetching point machines\u2026</div></div>';
                    try {
                        const r = await fetch(`${PM3_ENDPOINTS.liveValue}?SiteId=${encodeURIComponent(siteId)}`);
                        if (!r.ok) throw new Error(`HTTP ${r.status}`);
                        const tags = await r.json();
                        if (!Array.isArray(tags)) throw new Error('Unexpected response shape');

                        const assets = new Map();
                        tags.forEach(t => {
                            if (String(t.AssetTypeId) !== '3') return;
                            const assetId = t.AssetId;
                            if (!assets.has(assetId)) {
                                assets.set(assetId, { assetId, assetName: t.AssetName || `Asset ${assetId}` });
                            }
                        });
                        S.pointMachines = Array.from(assets.values());

                        const wr = await fetch(`${PM3_ENDPOINTS.assetWaveType}?SiteId=${encodeURIComponent(siteId)}`);
                        if (wr.ok) {
                            const meta = await wr.json();
                            const byId = new Map(meta.map(m => [String(m.AssetId), m]));
                            S.pointMachines.forEach(pm => {
                                const m = byId.get(String(pm.assetId));
                                pm.aWaveType = m ? m.AWaveType : null;
                                pm.bWaveType = m ? m.BWaveType : null;
                                pm.mixedWaveType = !!(m && m.Mixed);
                            });
                        }

                        renderPmList();
                        toast(`${S.pointMachines.length} point machine assets found`, 'success');
                    } catch (e) {
                        document.getElementById('pmList3').innerHTML = '';
                        toast('Fetch failed: ' + e.message, 'error');
                    }
                    btn.disabled = false;
                    btn.textContent = originalLabel;
                }

                function renderPmList() {
                    document.getElementById('pmCount3').textContent = `(${S.pointMachines.length})`;
                    const list = document.getElementById('pmList3');
                    list.innerHTML = S.pointMachines.map((pm, i) => `
                                                        <div class="pm-item" onclick="selectAsset3(${i})" id="pm3-${i}">
                                                            <div class="pm-name">${escapeHtml(pm.assetName)}</div>
                                                            ${waveChipsFor(pm)}
                                                        </div>`).join('');
                    document.getElementById('custom-pm-select3').innerHTML = '<option value="">-- Select --</option>' +
                        S.pointMachines.map((pm, i) => `<option value="${i}">${escapeHtml(pm.assetName)}</option>`).join('');
                    document.getElementById('quick-pm-select3').innerHTML = '<option value="">-- Select --</option>' +
                        S.pointMachines.map((pm, i) => `<option value="${i}">${escapeHtml(pm.assetName)}</option>`).join('');
                }

                async function selectAsset3(idx) {
                    document.getElementById('model3-wrap').querySelectorAll('.pm-item').forEach(el => el.classList.remove('active'));
                    document.getElementById(`pm3-${idx}`).classList.add('active');
                    const pm = S.pointMachines[idx];
                    S.selectedAsset = pm;
                    activeFilters.clear();
                    const pmSelect = document.getElementById('custom-pm-select3');
                    if (pmSelect) pmSelect.value = String(idx);
                    const quickSelect = document.getElementById('quick-pm-select3');
                    if (quickSelect) quickSelect.value = String(idx);
                    updateCompactSidebar3();
                    // Reclaim the space back for the results once a machine is picked - the
                    // full site/PM form has done its job, so auto-shrink to the icon rail
                    // (only if the user had it open; already-collapsed stays collapsed).
                    const sidebarEl = document.querySelector('#model3-wrap .sidebar');
                    if (sidebarEl && !sidebarEl.classList.contains('collapsed')) toggleSidebar3(true);
                    await runAnalyze(pm, false);
                }

                function parseArrayValue(raw) {
                    if (raw == null) return [];
                    if (Array.isArray(raw)) {
                        if (raw.length === 1 && typeof raw[0] === 'string') return parseArrayValue(raw[0]);
                        return raw.map(Number).filter(n => !isNaN(n));
                    }
                    if (typeof raw === 'string') {
                        try { return parseArrayValue(JSON.parse(raw)); } catch (e) { return []; }
                    }
                    return [];
                }

                function extractAbArrays(rec) {
                    let pmj = rec.PointMachineJson;
                    if (typeof pmj === 'string') { try { pmj = JSON.parse(pmj); } catch (e) { pmj = null; } }
                    if (Array.isArray(pmj)) pmj = pmj[0];
                    if (!pmj || typeof pmj !== 'object') return null;
                    return {
                        aCur: parseArrayValue(pmj.A_C), aVolt: parseArrayValue(pmj.A_V),
                        bCur: parseArrayValue(pmj.B_C), bVolt: parseArrayValue(pmj.B_V),
                    };
                }

                function sideHasData(cur) {
                    return Array.isArray(cur) && cur.length >= 5 && cur.some(v => v !== 0);
                }

                async function predictBatch(wave, items) {
                    if (!items.length) return [];
                    const r = await fetch(PM3_ENDPOINTS.predict, {
                        method: 'POST', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ wave, items }),
                    });
                    if (!r.ok) throw new Error(`predict HTTP ${r.status}`);
                    const data = await r.json();
                    return data.predictions || [];
                }

                async function fetchAndComputeOps(siteId, pm, refTime, customStart) {
                    const start = customStart || new Date(refTime.getTime() - WINDOW_DAYS * 24 * 3600 * 1000);
                    const fmt = d => d.toISOString().slice(0, 19);
                    const url = `${PM3_ENDPOINTS.pmData}?SiteId=${encodeURIComponent(siteId)}&AssetId=${encodeURIComponent(pm.assetId)}`
                        + `&StartDate=${encodeURIComponent(fmt(start))}&EndDate=${encodeURIComponent(fmt(refTime))}`;
                    const r = await fetch(url);
                    if (!r.ok) throw new Error(`HTTP ${r.status}`);
                    const records = await r.json();
                    if (!Array.isArray(records)) throw new Error('Unexpected response shape');

                    const own = records.filter(rec => String(rec.AssetId) === String(pm.assetId));
                    const rows = own
                        .map(rec => ({ rec, time: new Date(rec.TimeStamp || rec.TsTime || 0) }))
                        .filter(x => !isNaN(x.time.getTime()) && x.time <= refTime)
                        .sort((a, b) => a.time - b.time);

                    if (!rows.length) return { ops: [], start };

                    const ops = rows.map(({ rec, time }) => {
                        const a = extractAbArrays(rec) || { aCur: [], aVolt: [], bCur: [], bVolt: [] };
                        return { time, ...a, direction: rec.Direction || null, aPrediction: null, bPrediction: null };
                    });

                    for (const side of ['a', 'b']) {
                        const wave = side === 'a' ? pm.aWaveType : pm.bWaveType;
                        const curKey = side === 'a' ? 'aCur' : 'bCur';
                        const voltKey = side === 'a' ? 'aVolt' : 'bVolt';
                        const predKey = side === 'a' ? 'aPrediction' : 'bPrediction';
                        const items = [], targets = [];
                        const endLetter = side === 'a' ? 'A' : 'B';
                        ops.forEach(o => {
                            if (wave && sideHasData(o[curKey])) {
                                items.push({
                                    current: o[curKey], voltage: o[voltKey], direction: o.direction,
                                    asset_id: pm.assetId, end: endLetter
                                });
                                targets.push(o);
                            }
                            else o[predKey] = wave
                                ? { status: 'nodata', label: 'No Data', types: [] }
                                : { status: 'error', label: null, types: [], error: 'wave type unresolved' };
                        });
                        if (items.length) {
                            const preds = await predictBatch(wave, items);
                            preds.forEach((p, i) => { targets[i][predKey] = p; });
                        }
                    }
                    return { ops, start };
                }

                function isIncompleteEvidence(p) {
                    return !!p && (p.truncated === true || p.beyond_trained_window === true || p.type_trusted === false);
                }

                // PDF report - server-rendered (see /pm_operation_combined/pdf in
                // pm_operation/app.py): a headless browser loads this exact page, deep-
                // links into Model 3 for this exact asset, and prints it, so the PDF is
                // pixel-identical to the live page (real HTML/CSS - colors, badges, every
                // Class Timeline tile - not a client-side screenshot) AND its text stays
                // real/selectable/copyable (a screenshot-based PDF would turn all of that
                // into one flat, uncopyable image). fetch()+blob (not a plain navigation)
                // so this button can show a "working" state and report a clear error if
                // generation fails server-side.
                // Instant client-side PDF, same approach V4 already uses (jsPDF, no server
                // round trip at all - a prior server-rendered /pm_operation_combined/pdf
                // endpoint broke silently behind a reverse proxy that forwarded the page
                // view but not that sibling path). Every visual element V3's PDF has always
                // shown is already a real Plotly chart rendered into this page's own DOM
                // by renderFaultCharts()/the per-machine timeline/renderClassTimeline()/
                // renderOpTiles() - captured here via Plotly.toImage() (identical technique
                // to V4's own exportPm4Pdf4) and placed into the jsPDF doc in the exact
                // section order the old print-CSS layout used, so the format doesn't change
                // even though the charts themselves are no longer hand-rebuilt from scratch.
                async function exportPdf3(btn) {
                    if (!S.selectedAsset || !S.lastData) { alert('Select a machine first.'); return; }
                    if (!window.jspdf || !window.jspdf.jsPDF) { alert('PDF library not loaded \u2014 please reload the page.'); return; }
                    const origHtml = btn ? btn.innerHTML : '';
                    if (btn) { btn.disabled = true; btn.style.opacity = '0.7'; btn.style.cursor = 'wait'; btn.innerHTML = 'Generating PDF\u2026'; }
                    try {
                        // Forces isPdfExport true so renderFaultCharts()/the per-machine
                        // timeline/class-timeline+tile-strips all populate in the DOM -
                        // exactly what window.print() relied on too, just consumed as an
                        // image source here instead of via the browser's print engine.
                        window.__forcePdfPrint3 = true;
                        await renderResults(S.selectedAsset, S.lastData);
                        await new Promise(r => setTimeout(r, 400)); // let the freshly (re)rendered charts - including every tile's own tiny Plotly plot - finish painting

                        const { jsPDF } = window.jspdf;
                        const doc = new jsPDF({ unit: 'pt', format: 'a4' });
                        const pageW = doc.internal.pageSize.getWidth();
                        const pageH = doc.internal.pageSize.getHeight();
                        const M = 36;
                        const contentW = pageW - 2 * M;
                        let y = M;
                        const ensure = h => { if (y + h > pageH - M - 20) { doc.addPage(); y = M; } };
                        const cleanTxt3 = txt => String(txt || '').replace(/\u2192/g, 'to').replace(/\u2013|\u2014/g, '-').replace(/\u2022/g, '-');

                        // Captures an already-rendered Plotly div as a PNG - returns null
                        // (silently skipped by every call site) rather than throwing, so one
                        // slow/missing tile plot never aborts the whole export.
                        const capturePlot = async (divId, w, h) => {
                            const el = document.getElementById(divId);
                            if (!el || !el.data) return null;
                            try { return await Plotly.toImage(el, { format: 'png', width: w, height: h }); }
                            catch (e) { return null; }
                        };

                        const pm = S.selectedAsset;
                        const data = S.lastData;

                        // \u2500\u2500 1. HEADER BANNER (matches the live page's own title block:
                        // "Point Machine Operation \u2014 V3" / asset name / date-range label /
                        // cached-or-live "updated" label - no site name, since the live
                        // header doesn't show one either) \u2500\u2500
                        const rangeLabel = S.lastRangeLabel || `last ${WINDOW_DAYS} days`;
                        const updatedLabel3 = (data.fromCache ? 'Cached result' : 'Live result') + ' \u00b7 window '
                            + data.start.toLocaleDateString('en-IN') + ' \u2192 ' + data.end.toLocaleDateString('en-IN');
                        const metaStr = cleanTxt3(`Asset: ${pm.assetName}   |   ${rangeLabel}   |   ${updatedLabel3}   |   Generated: ${new Date().toLocaleString('en-IN')}`);
                        doc.setFontSize(8.5); doc.setFont('helvetica', 'normal');
                        const metaLines = doc.splitTextToSize(metaStr, contentW - 28);
                        const bannerH = 24 + metaLines.length * 11;
                        doc.setFillColor(15, 23, 42);
                        doc.roundedRect(M, y, contentW, bannerH, 5, 5, 'F');
                        doc.setFontSize(15); doc.setFont('helvetica', 'bold'); doc.setTextColor(255, 255, 255);
                        doc.text('POINT MACHINE OPERATION \u2014 V3 REPORT', M + 14, y + 20);
                        doc.setFontSize(8.5); doc.setFont('helvetica', 'normal'); doc.setTextColor(148, 163, 184);
                        metaLines.forEach((ln, li) => doc.text(ln, M + 14, y + 34 + li * 11));
                        y += bannerH + 10;

                        // \u2500\u2500 2. AI SUMMARY (same verdict/points/recommendation shape V4's
                        // own PDF reads from data.ai_summary - see renderAiSummary() above,
                        // which now also persists S.lastAiSummary for this) \u2500\u2500
                        if (S.lastAiSummary) {
                            const sumObj = S.lastAiSummary;
                            ensure(60);
                            doc.setFillColor(243, 232, 255); doc.setDrawColor(216, 180, 254);
                            doc.roundedRect(M, y, contentW, 20, 3, 3, 'FD');
                            doc.setFontSize(9.5); doc.setFont('helvetica', 'bold'); doc.setTextColor(109, 40, 217);
                            doc.text('AI Diagnostic Summary & Verdict', M + 10, y + 14);
                            y += 26;
                            if (sumObj.verdict) {
                                doc.setFontSize(10); doc.setFont('helvetica', 'bold'); doc.setTextColor(30, 41, 59);
                                doc.text(cleanTxt3(`Verdict: ${sumObj.verdict}`), M + 4, y);
                                y += 14;
                            }
                            if (Array.isArray(sumObj.points) && sumObj.points.length) {
                                doc.setFontSize(8.5); doc.setFont('helvetica', 'normal'); doc.setTextColor(51, 65, 85);
                                sumObj.points.forEach(pt => {
                                    const lines = doc.splitTextToSize(cleanTxt3(pt), contentW - 20);
                                    ensure(lines.length * 11);
                                    lines.forEach((ln, li) => { doc.text(li === 0 ? '\u2022 ' + ln : '  ' + ln, M + 10, y); y += 11; });
                                });
                                y += 4;
                            }
                            if (sumObj.recommendation) {
                                const lines = doc.splitTextToSize(cleanTxt3(`Recommendation: ${sumObj.recommendation}`), contentW - 16);
                                ensure(lines.length * 11);
                                doc.setFontSize(8.5); doc.setFont('helvetica', 'bold'); doc.setTextColor(15, 23, 42);
                                lines.forEach(ln => { doc.text(ln, M + 10, y); y += 11; });
                                y += 6;
                            }
                            y += 10;
                        }

                        // \u2500\u2500 3-6. PER-MACHINE SECTIONS - "all of A, then all of B", each on
                        // its own page, matching the current sideExtra3-driven layout order
                        // exactly: stats -> fault condition charts -> Timeline -> Class
                        // Timeline -> tile strips (Normal/Forward, then Reverse) \u2500\u2500
                        const sidesInfo3 = [['Machine A', data.a, 'A'], ['Machine B', data.b, 'B']];
                        for (let si = 0; si < sidesInfo3.length; si++) {
                            const [label, st, SIDE] = sidesInfo3[si];
                            if (si > 0) { doc.addPage(); y = M; }
                            if (!st || !st.wave) continue;

                            const totalAll = st.total + st.missing + st.incomplete;
                            const pct3 = n => totalAll ? Math.round(n / totalAll * 1000) / 10 : 0;
                            const good3 = st.total - st.bad;

                            // \u2500\u2500 per-machine header + trend chips \u2500\u2500
                            ensure(30);
                            doc.setFillColor(15, 23, 42);
                            doc.roundedRect(M, y, contentW, 22, 3, 3, 'F');
                            doc.setFontSize(10.5); doc.setFont('helvetica', 'bold'); doc.setTextColor(255, 255, 255);
                            doc.text(cleanTxt3(`${label} \u00b7 ${st.wave}`), M + 10, y + 15);
                            doc.setFontSize(9); doc.setFont('helvetica', 'normal'); doc.setTextColor(200, 200, 210);
                            doc.text(`${pct3(good3)}% healthy`, M + contentW - 10, y + 15, { align: 'right' });
                            y += 32;

                            if (st.states && Object.keys(st.states).length) {
                                doc.setFontSize(8.5); doc.setFont('helvetica', 'bold'); doc.setTextColor(71, 85, 105);
                                const trendTxt = Object.entries(st.states).map(([dir, s]) => {
                                    const rising = s.rising ? ` (throw-time +${s.durationTrend}%/100 ops)` : '';
                                    return `dir-${dir}: ${s.state}${rising}`;
                                }).join('     ');
                                doc.text(cleanTxt3(trendTxt), M + 4, y);
                                y += 16;
                            }

                            // \u2500\u2500 stat tiles as a compact table row \u2500\u2500
                            if (typeof doc.autoTable === 'function') {
                                doc.autoTable({
                                    startY: y, margin: { left: M, right: M },
                                    head: [['Operations', 'Good', 'Bad', 'No Data', 'Incomplete Evidence']],
                                    body: [[String(totalAll), pct3(good3) + '%', pct3(st.bad) + '%', pct3(st.missing) + '%', pct3(st.incomplete) + '%']],
                                    theme: 'striped',
                                    headStyles: { fillColor: [30, 41, 59], textColor: [255, 255, 255], fontStyle: 'bold', fontSize: 8 },
                                    bodyStyles: { textColor: [51, 65, 85], fontSize: 9, cellPadding: 5, halign: 'center' },
                                });
                                y = doc.lastAutoTable.finalY + 10;
                            }

                            // \u2500\u2500 fault-family text (chips, condensed to plain text) \u2500\u2500
                            const sortedFaults3 = Object.entries(st.familyCount || {}).sort((a, b) => b[1] - a[1]);
                            ensure(20);
                            doc.setFontSize(8); doc.setFont('helvetica', 'bold'); doc.setTextColor(30, 41, 59);
                            doc.text('Fault families (% of abnormal):', M + 4, y);
                            y += 12;
                            if (sortedFaults3.length) {
                                doc.setFont('helvetica', 'normal'); doc.setTextColor(71, 85, 105);
                                const chipText = sortedFaults3.map(([name, count]) => {
                                    const p = st.bad ? Math.round(count / st.bad * 1000) / 10 : 0;
                                    return `${name} ${count} (${p}%)`;
                                }).join('     ');
                                const lines = doc.splitTextToSize(cleanTxt3(chipText), contentW - 8);
                                ensure(lines.length * 11);
                                lines.forEach(ln => { doc.text(ln, M + 4, y); y += 11; });
                            } else {
                                doc.setFont('helvetica', 'normal'); doc.setTextColor(22, 163, 74);
                                doc.text('No faults', M + 4, y); y += 11;
                            }
                            y += 8;

                            // \u2500\u2500 fault condition charts (one per detected subclass - same
                            // sort order renderFaultCharts() used to build faultChart{SIDE}_{i}
                            // div ids, so the index here lines up with the right chart) \u2500\u2500
                            for (let i = 0; i < sortedFaults3.length; i++) {
                                const [condName, count] = sortedFaults3[i];
                                const chartW = 650, chartH = 220;
                                const png = await capturePlot(`faultChart${SIDE}_${i}`, chartW, chartH);
                                if (!png) continue;
                                const imgH = contentW * chartH / chartW;
                                ensure(imgH + 20);
                                doc.setFontSize(9); doc.setFont('helvetica', 'bold'); doc.setTextColor(30, 41, 59);
                                doc.text(cleanTxt3(`${condName} - All ${count} Occurrences (red) vs Healthy (green)`), M + 4, y);
                                y += 12;
                                doc.addImage(png, 'PNG', M, y, contentW, imgH);
                                doc.setDrawColor(226, 232, 240); doc.setLineWidth(0.5); doc.rect(M, y, contentW, imgH);
                                y += imgH + 14;
                            }

                            // \u2500\u2500 per-machine Timeline \u2500\u2500
                            {
                                const png = await capturePlot(`timeline${SIDE}3`, 1000, 200);
                                if (png) {
                                    const imgH = contentW * 200 / 1000;
                                    ensure(imgH + 20);
                                    doc.setFontSize(9); doc.setFont('helvetica', 'bold'); doc.setTextColor(30, 41, 59);
                                    doc.text(`${label} - Timeline`, M + 4, y);
                                    y += 12;
                                    doc.addImage(png, 'PNG', M, y, contentW, imgH);
                                    doc.setDrawColor(226, 232, 240); doc.setLineWidth(0.5); doc.rect(M, y, contentW, imgH);
                                    y += imgH + 16;
                                }
                            }

                            // \u2500\u2500 Class Timeline band chart \u2500\u2500
                            {
                                const png = await capturePlot(`classTimeline${SIDE}3`, 1000, 90);
                                if (png) {
                                    const imgH = contentW * 90 / 1000;
                                    ensure(imgH + 20);
                                    doc.setFontSize(9); doc.setFont('helvetica', 'bold'); doc.setTextColor(30, 41, 59);
                                    doc.text(`${label} - Class Timeline`, M + 4, y);
                                    y += 12;
                                    doc.addImage(png, 'PNG', M, y, contentW, imgH);
                                    doc.setDrawColor(226, 232, 240); doc.setLineWidth(0.5); doc.rect(M, y, contentW, imgH);
                                    y += imgH + 16;
                                }
                            }

                            // \u2500\u2500 tile strips (Normal/Forward, then Reverse) - each op's own
                            // tiny current-waveform sparkline, laid out in a wrapping grid
                            // instead of the live page's horizontal scroll (mirrors the
                            // print CSS rule that already flex-wraps .class-strip for
                            // print, since a static PDF page can't scroll either) \u2500\u2500
                            for (const [dirLabel, stripId] of [['Normal (Forward)', `classStrip${SIDE}_fwd3`], ['Reverse', `classStrip${SIDE}_rev3`]]) {
                                const stripEl = document.getElementById(stripId);
                                if (!stripEl) continue;
                                const tiles = Array.from(stripEl.querySelectorAll('.class-tile'));
                                if (!tiles.length) continue;

                                ensure(20);
                                doc.setFontSize(8.5); doc.setFont('helvetica', 'bold'); doc.setTextColor(71, 85, 105);
                                doc.text(`${label} - ${dirLabel}`, M + 4, y);
                                y += 12;

                                const perRow = 6, gap = 6;
                                const tileW = (contentW - gap * (perRow - 1)) / perRow;
                                const tileImgH = tileW * 50 / 140;
                                const labelH = 9, timeH = 9;
                                const rowH = labelH + tileImgH + timeH + 6;

                                for (let i = 0; i < tiles.length; i++) {
                                    const col = i % perRow;
                                    if (col === 0) ensure(rowH);
                                    const xPos = M + col * (tileW + gap);
                                    const tile = tiles[i];
                                    const plotDiv = tile.querySelector('.class-tile-plot');
                                    const labelDiv = tile.querySelector('.class-tile-label');
                                    const timeDiv = tile.querySelector('.class-tile-time');
                                    const png = plotDiv ? await capturePlot(plotDiv.id, 140, 50) : null;

                                    if (labelDiv) {
                                        doc.setFontSize(6.5); doc.setFont('helvetica', 'bold'); doc.setTextColor(60, 60, 60);
                                        const lbl = doc.splitTextToSize(cleanTxt3(labelDiv.textContent), tileW)[0] || '';
                                        doc.text(lbl, xPos, y + labelH - 1);
                                    }
                                    if (png) doc.addImage(png, 'PNG', xPos, y + labelH, tileW, tileImgH);
                                    if (timeDiv) {
                                        doc.setFontSize(6); doc.setFont('helvetica', 'normal'); doc.setTextColor(120, 120, 120);
                                        doc.text(cleanTxt3(timeDiv.textContent), xPos, y + labelH + tileImgH + timeH);
                                    }
                                    if (col === perRow - 1 || i === tiles.length - 1) y += rowH;
                                }
                                y += 8;
                            }
                        }

                        const safeAsset3 = (pm.assetName || 'asset').replace(/[\\/:*?"<>|]+/g, ' ').trim();
                        doc.save(`point machine v3 ${safeAsset3}.pdf`);

                        window.__forcePdfPrint3 = false;
                        await renderResults(S.selectedAsset, S.lastData);
                    } catch (e) {
                        window.__forcePdfPrint3 = false;
                        try { await renderResults(S.selectedAsset, S.lastData); } catch (e2) { }
                        alert('PDF generation failed: ' + e.message);
                    } finally {
                        if (btn) { btn.disabled = false; btn.style.opacity = '1'; btn.style.cursor = 'pointer'; btn.innerHTML = origHtml; }
                    }
                }

                // Same denominator rule as cache_refresh.py's _compute_side_stats - total
                // EXCLUDES incomplete ops (beyond the trained 6s window) from good%/bad%, so
                // cached and live percentages can never diverge on this rule.
                // \u2500\u2500 Predictive TREND/STATE (ported from V4's per-direction "states" concept
                // - see pm_operation4/pm_health.py's machine_trend()/health_state()). V4's
                // rules engine trends several named per-op numeric features (i_run, end_rise,
                // work...); V3 is a trained classifier with no such per-op feature vector
                // exposed, so there's nothing to port 1:1. The one continuous, physically-
                // meaningful per-op number V3 DOES carry is duration_s (throw time) - the
                // same "throw_time" feature V4 already trends (see V4's FEATURE_LABELS:
                // "throw_time: stroke took longer") - so that's the degradation signal used
                // here. Severity uses recent bad% as a stand-in for V4's WATCH/ALERT/FAULT
                // grade tiers, which V3 has no equivalent of (only Normal/Abnormal per
                // stroke). Same INTENT as V4 (is it getting worse, not just is it bad right
                // now), computed client-side since V3's whole analytics pipeline already
                // works this way (unlike V4, whose states are computed server-side/cached).
                const RISING_PCT3 = 15.0;      // +15% per 100 ops = meaningfully worsening, same threshold V4 uses
                const BAD_PCT_SEVERE3 = 20;    // 20%+ abnormal this window = "already bad", same order V4's ALERT+ implies

                function isReverseDir3(direction) {
                    return !!(direction && String(direction).toLowerCase().startsWith('rev'));
                }

                // % change in average throw-time between the first half and second half of
                // this direction's ops, normalized to "per 100 ops" - same units as V4's
                // machine_trend() so the two models' trend numbers mean the same thing.
                function computeDurationTrend3(ops, predKey) {
                    const durations = [];
                    ops.forEach(o => {
                        const p = o[predKey];
                        if (p && p.status === 'success' && typeof p.duration_s === 'number') durations.push(p.duration_s);
                    });
                    if (durations.length < 10) return null;   // not enough data to trust a trend
                    const mid = Math.floor(durations.length / 2);
                    const firstAvg = durations.slice(0, mid).reduce((a, b) => a + b, 0) / mid;
                    const secondAvg = durations.slice(mid).reduce((a, b) => a + b, 0) / (durations.length - mid);
                    if (!firstAvg) return null;
                    const pctChange = (secondAvg - firstAvg) / firstAvg * 100;
                    return Math.round(pctChange / durations.length * 100 * 10) / 10;
                }

                function computeDirectionState3(ops, predKey) {
                    let total = 0, bad = 0;
                    ops.forEach(o => {
                        const p = o[predKey];
                        if (!p || p.status !== 'success') return;
                        total++;
                        if (p.label === 'Abnormal') bad++;
                    });
                    const badPct = total ? (bad / total * 100) : 0;
                    const durationTrend = computeDurationTrend3(ops, predKey);
                    const rising = durationTrend !== null && durationTrend >= RISING_PCT3;
                    let state;
                    if (badPct >= BAD_PCT_SEVERE3 && rising) state = 'URGENT';
                    else if (badPct >= BAD_PCT_SEVERE3) state = 'MAINTAIN-SOON';
                    else if (badPct > 0 || rising) state = 'WATCH';
                    else state = 'NORMAL';
                    return { state, badPct: Math.round(badPct * 10) / 10, durationTrend, rising, n: total };
                }

                function computeSideStats(ops, side) {
                    const predKey = side === 'a' ? 'aPrediction' : 'bPrediction';
                    let total = 0, bad = 0, missing = 0, incomplete = 0;
                    const familyCount = {};
                    ops.forEach(o => {
                        const p = o[predKey];
                        if (!p) return;
                        if (p.status === 'nodata') { missing++; return; }
                        if (isIncompleteEvidence(p)) { incomplete++; return; }
                        if (p.status !== 'success') return;
                        total++;
                        if (p.label === 'Abnormal') {
                            bad++;
                            const types = p.types || [];
                            const fam = types.length ? types[0].type : 'Unclassified';
                            familyCount[fam] = (familyCount[fam] || 0) + 1;
                        }
                    });

                    const states = {};
                    ['Normal', 'Reverse'].forEach(dirLabel => {
                        const dirOps = ops.filter(o => isReverseDir3(o.direction) === (dirLabel === 'Reverse'));
                        if (dirOps.length) states[dirLabel] = computeDirectionState3(dirOps, predKey);
                    });

                    return { total, bad, missing, incomplete, familyCount, states };
                }

                let currentAnalysisMode3 = 'quick';   // 'quick' or 'custom'

                function switchAnalysisMode3(mode) {
                    currentAnalysisMode3 = mode;
                    document.getElementById('mode-quick-btn3').classList.toggle('active', mode === 'quick');
                    document.getElementById('mode-custom-btn3').classList.toggle('active', mode === 'custom');
                    document.getElementById('custom-date-panel3').style.display = mode === 'custom' ? 'block' : 'none';
                    document.getElementById('pm-list-section3').style.display = mode === 'custom' ? 'none' : 'block';
                    updateCompactSidebar3();
                    if (mode === 'custom') {
                        const today = new Date().toISOString().split('T')[0];
                        const past30 = new Date(); past30.setDate(past30.getDate() - 30);
                        const fromInput = document.getElementById('custom-from-date3');
                        const toInput = document.getElementById('custom-to-date3');
                        if (!toInput.value) toInput.value = today;
                        if (!fromInput.value) fromInput.value = past30.toISOString().split('T')[0];
                        toInput.max = today; fromInput.max = today;
                        validateDateRange3();
                    }
                }

                function getCustomRange3() {
                    const fromVal = document.getElementById('custom-from-date3').value;
                    const toVal = document.getElementById('custom-to-date3').value;
                    if (!fromVal || !toVal) return null;
                    const fromTime = (document.getElementById('custom-from-time3').value || '00:00:00');
                    const toTime = (document.getElementById('custom-to-time3').value || '23:59:59');
                    const fullFromTime = fromTime.length === 5 ? fromTime + ':00' : fromTime;
                    const fullToTime = toTime.length === 5 ? toTime + ':00' : toTime;
                    return {
                        startDate: new Date(`${fromVal}T${fullFromTime}`),
                        endDate: new Date(`${toVal}T${fullToTime}`),
                    };
                }

                function validateDateRange3() {
                    const errorEl = document.getElementById('date-range-error3');
                    const applyBtn = document.getElementById('apply-custom-dates-btn3');
                    const range = getCustomRange3();
                    if (!range) { errorEl.style.display = 'none'; applyBtn.disabled = true; return false; }
                    const diffDays = (range.endDate - range.startDate) / (1000 * 60 * 60 * 24);
                    if (diffDays < 0) {
                        errorEl.innerHTML = '\u26a0\ufe0f <b>Invalid range:</b> "To" cannot be before "From".';
                        errorEl.style.display = 'block'; applyBtn.disabled = true; return false;
                    }
                    if (diffDays > 90) {
                        errorEl.innerHTML = `\u26a0\ufe0f <b>Limit exceeded:</b> selected range (${diffDays.toFixed(1)} days) exceeds the 90-day max.`;
                        errorEl.style.display = 'block'; applyBtn.disabled = true; return false;
                    }
                    errorEl.style.display = 'none'; applyBtn.disabled = false; return true;
                }

                function applyCustomDates3() {
                    const idx = document.getElementById('custom-pm-select3').value;
                    if (idx === '') { alert('Select a point machine first.'); return; }
                    if (!validateDateRange3()) return;
                    const pm = S.pointMachines[idx];
                    S.selectedAsset = pm;
                    activeFilters.clear();
                    document.getElementById('model3-wrap').querySelectorAll('.pm-item').forEach(el => el.classList.remove('active'));
                    const el = document.getElementById(`pm3-${idx}`);
                    if (el) el.classList.add('active');
                    const quickSelect = document.getElementById('quick-pm-select3');
                    if (quickSelect) quickSelect.value = String(idx);
                    updateCompactSidebar3();
                    const sidebarEl3 = document.querySelector('#model3-wrap .sidebar');
                    if (sidebarEl3 && !sidebarEl3.classList.contains('collapsed')) toggleSidebar3(true);
                    runAnalyze(pm, true);
                }

                async function runAnalyze(pm, forceLive) {
                    document.getElementById('emptyState3').style.display = 'none';
                    document.getElementById('results3').style.display = 'none';

                    let customStart = null, refTime = new Date(), rangeLabel = `last ${WINDOW_DAYS} days`;
                    if (currentAnalysisMode3 === 'custom') {
                        if (!validateDateRange3()) {
                            document.getElementById('emptyState3').style.display = 'block';
                            document.getElementById('emptyState3').textContent = 'Pick a valid custom date range first.';
                            return;
                        }
                        const range = getCustomRange3();
                        customStart = range.startDate;
                        refTime = range.endDate;
                        rangeLabel = `${range.startDate.toLocaleDateString()} \u2192 ${range.endDate.toLocaleDateString()} (custom)`;
                        forceLive = true;
                    }
                    S.lastRangeLabel = rangeLabel;

                    document.getElementById('loading-text3').textContent = forceLive ? 'Analyzing\u2026' : 'Loading from cache\u2026';
                    document.getElementById('loading3').style.display = 'flex';

                    try {
                        let ops = null, start = null, fromCache = false, cachedAiSummary = null;

                        if (!forceLive) {
                            try {
                                const cr = await fetch(`${PM3_ENDPOINTS.monthlyCache}?SiteId=${encodeURIComponent(S.currentSiteId)}&AssetId=${encodeURIComponent(pm.assetId)}`);
                                if (cr.ok) {
                                    const cached = await cr.json();
                                    if (cached && Array.isArray(cached.ops)) {
                                        ops = cached.ops.map(o => ({ ...o, time: new Date(o.time) }));
                                        start = new Date(cached.window_start);
                                        cachedAiSummary = cached.ai_summary || null;
                                        fromCache = true;
                                    }
                                }
                            } catch (e) { /* fall through to live */ }
                        }

                        if (!ops) {
                            document.getElementById('loading-text3').textContent = currentAnalysisMode3 === 'custom' ? 'Fetching selected date range\u2026' : 'Fetching last 30 days of operations\u2026';
                            const r = await fetchAndComputeOps(S.currentSiteId, pm, refTime, customStart);
                            ops = r.ops; start = r.start;
                        }

                        if (!ops.length) {
                            document.getElementById('loading3').style.display = 'none';
                            document.getElementById('emptyState3').style.display = 'block';
                            document.getElementById('emptyState3').textContent = currentAnalysisMode3 === 'custom'
                                ? 'No operations found for this asset in the selected date range.'
                                : 'No operations found for this asset in the last 30 days.';
                            return;
                        }

                        const siteObj = S.sites.find(s => String(s.SiteId) === String(S.currentSiteId));
                        const data = {
                            ops, start, end: refTime, fromCache,
                            a: { ...computeSideStats(ops, 'a'), wave: pm.aWaveType },
                            b: { ...computeSideStats(ops, 'b'), wave: pm.bWaveType },
                        };
                        S.lastData = data;
                        const fmtRangeDate3 = d => d.toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' });
                        S.lastRangeLabel = `${fmtRangeDate3(start)} to ${fmtRangeDate3(refTime)}${currentAnalysisMode3 === 'custom' ? ' (custom)' : ''}`;
                        await renderResults(pm, data);

                        if (!fromCache && currentAnalysisMode3 !== 'custom') {
                            fetch(PM3_ENDPOINTS.monthlyCachePost, {
                                method: 'POST', headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    site_id: Number(S.currentSiteId), site_name: (siteObj && siteObj.SiteName) || null,
                                    asset_id: pm.assetId, asset_name: pm.assetName,
                                    wave_type_a: pm.aWaveType, wave_type_b: pm.bWaveType,
                                    window_start: start.toISOString(), window_end: refTime.toISOString(),
                                    ops: ops.map(o => ({ ...o, time: o.time.toISOString() })),
                                    ai_summary: null,
                                }),
                            }).catch(() => { });
                            fetchAiSummary(pm, data, siteObj);
                        } else if (cachedAiSummary) {
                            renderAiSummary(cachedAiSummary);
                        } else {
                            fetchAiSummary(pm, data, siteObj);
                        }
                    } catch (e) {
                        document.getElementById('loading3').style.display = 'none';
                        document.getElementById('results3').style.display = 'block';
                        document.getElementById('results3').innerHTML = `<div class="banner warn">Analysis failed: ${escapeHtml(e.message)}</div>`;
                    }
                }

                function updateCurrentAsset3() {
                    if (S.selectedAsset) runAnalyze(S.selectedAsset, true);
                }

                // ==================== MACHINE BLOCK (PMv1 machineBlock() port) ====================

                function toggleFaultFilter3(name) {
                    if (activeFilters.has(name)) activeFilters.delete(name);
                    else activeFilters.add(name);
                    renderResults(S.selectedAsset, S.lastData);
                }

                function tile(val, lbl, color) {
                    return `<div style="flex:1; min-width:90px; background:var(--bg-tertiary); border:1px solid var(--border); border-radius:10px; padding:12px; text-align:center;">
                                                        <div style="font-size:22px; font-weight:800; color:${color};">${val}</div>
                                                        <div style="font-size:10px; color:var(--text-muted); text-transform:uppercase; font-weight:700; letter-spacing:0.4px; margin-top:3px;">${lbl}</div></div>`;
                }

                function machineBlock(label, st, sideKey) {
                    const totalAll = st.total + st.missing + st.incomplete;
                    const good = st.total - st.bad;
                    const pct = n => totalAll ? Math.round(n / totalAll * 1000) / 10 : 0;

                    const sortedFaults = Object.keys(st.familyCount).sort((a, b) => st.familyCount[b] - st.familyCount[a]);
                    const topFaults = sortedFaults.slice(0, TOP_FAULTS_N);
                    const faultChips = topFaults.map(name => {
                        const c = st.familyCount[name];
                        const p = st.bad ? Math.round(c / st.bad * 1000) / 10 : 0;
                        const color = FAMILY_COLORS[name] || 'var(--abnormal)';
                        const isActive = activeFilters.size === 0 || activeFilters.has(name);
                        const border = isActive ? `2px solid ${color}` : `2px solid transparent`;
                        const opacity = isActive ? '1' : '0.4';
                        return `<span onclick="toggleFaultFilter3('${name.replace(/'/g, "\\'")}')" style="display:inline-flex; align-items:center; gap:6px; background:${color}20; color:${color}; border:${border}; border-radius:16px; padding:4px 12px; font-size:12px; font-weight:600; cursor:pointer; opacity:${opacity}; transition:opacity 0.15s, border-color 0.15s; user-select:none;">
                                                            ${escapeHtml(name)} <b>${c}</b> <span style="opacity:0.8;">(${p}%)</span></span>`;
                    }).join('');

                    const healthColor = pct(st.bad) >= 20 ? 'var(--abnormal)' : pct(st.bad) > 0 ? 'var(--current-color)' : 'var(--normal)';
                    if (!st.wave) {
                        return `<div style="flex:1; min-width:340px; background:var(--bg-card); border:1px solid var(--border); border-radius:12px; padding:16px;">
                                                            <div style="font-size:15px; font-weight:800;">${escapeHtml(label)}</div>
                                                            <div style="color:var(--text-muted); font-size:13px; margin-top:8px;">Wave type unresolved for this side - cannot predict.</div></div>`;
                    }

                    // Predictive per-direction trend/state - same NORMAL/WATCH/MAINTAIN-SOON/
                    // URGENT vocabulary V4's watchlist uses (see computeDirectionState3 above
                    // for what "trend" means here, since V3 has no per-op numeric features
                    // to trend the way V4 does).
                    const stateColors3 = { URGENT: '#dc2626', 'MAINTAIN-SOON': '#ea580c', WATCH: '#ca8a04', NORMAL: '#16a34a' };
                    const stateLine3 = (st.states && Object.keys(st.states).length)
                        ? `<div style="margin-bottom:10px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                                                             <span style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted);">Trend</span>` +
                        Object.entries(st.states).map(([dir, s]) => {
                            const col = stateColors3[s.state] || '#94a3b8';
                            const trendTxt = s.rising ? ` \u00b7 throw-time +${s.durationTrend}%/100 ops` : '';
                            return `<span style="font-size:12px; font-weight:700; padding:4px 10px; border-radius:14px; background:${col}1a; color:${col}; border:1px solid ${col}55;" title="${s.badPct}% abnormal over ${s.n} ops">dir-${escapeHtml(dir)}: ${escapeHtml(s.state)}${trendTxt}</span>`;
                        }).join('') + `</div>`
                        : '';

                    return `<div style="flex:1; min-width:340px; background:var(--bg-card); border:1px solid var(--border); border-radius:12px; padding:16px;">
                                                        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;">
                                                            <span style="font-size:15px; font-weight:800; color:var(--text-primary);">${escapeHtml(label)} \u00b7 ${st.wave}</span>
                                                            <span style="font-size:12px; font-weight:700; color:${healthColor};">${pct(good)}% healthy</span>
                                                        </div>
                                                        ${stateLine3}
                                                        <div style="display:flex; gap:10px; flex-wrap:wrap;">
                                                            ${tile(totalAll, 'Operations', 'var(--text-primary)')}
                                                            ${tile(pct(good) + '%', 'Good', 'var(--normal)')}
                                                            ${tile(pct(st.bad) + '%', 'Bad', 'var(--abnormal)')}
                                                            ${tile(pct(st.missing) + '%', 'No Data', 'var(--text-muted)')}
                                                            ${tile(pct(st.incomplete) + '%', 'Incomplete Evidence', 'var(--text-secondary)')}
                                                        </div>
                                                        <div style="margin-top:12px;">
                                                            <div style="font-size:10px; color:var(--text-muted); text-transform:uppercase; font-weight:700; letter-spacing:0.4px; margin-bottom:8px;">Fault families (% of abnormal)</div>
                                                            ${faultChips || '<span style="font-size:12px; color:var(--normal); font-weight:600;">No faults \ud83c\udf89</span>'}
                                                        </div>
                                                        ${sortedFaults.length ? `<div id="faultCharts${sideKey}" style="margin-top:12px;"></div>` : ''}
                                                    </div>`;
                }

                function resampleTo(arr, n) {
                    if (!arr || arr.length < 2) return arr || [];
                    const out = [];
                    for (let i = 0; i < n; i++) {
                        const t = i * (arr.length - 1) / (n - 1);
                        const lo = Math.floor(t), hi = Math.ceil(t), frac = t - lo;
                        out.push(arr[lo] * (1 - frac) + arr[hi] * frac);
                    }
                    return out;
                }

                // One waveform chart PER detected abnormality subclass, per side - overlays a
                // healthy (non-abnormal) stroke against an example stroke exhibiting that
                // subclass, so the report shows WHERE in the stroke each subclass actually
                // manifests (a bare count-per-subclass bar loses that "where"; this doesn't).
                async function renderFaultCharts(data) {
                    // PDF-export-only: these per-condition waveform charts are meant for the
                    // printed report, not the live page, so skip rendering them entirely
                    // during normal interactive browsing. True either when the server's PDF
                    // pipeline drives this page (autoload=1) or when the user's own browser
                    // is mid-export via exportPdf3()'s window.print() (window.__forcePdfPrint3).
                    const isPdfExport = window.__forcePdfPrint3 === true || new URLSearchParams(window.location.search).get('autoload') === '1';
                    if (!isPdfExport) return;
                    for (const [sideKey, predSide, sd] of [['A', 'a', data.a], ['B', 'b', data.b]]) {
                        const container = document.getElementById(`faultCharts${sideKey}`);
                        if (!container || !sd || !sd.familyCount) continue;
                        const sorted = Object.entries(sd.familyCount).sort((a, b) => b[1] - a[1]);
                        if (!sorted.length) continue;

                        const predKey = predSide === 'a' ? 'aPrediction' : 'bPrediction';
                        const curKey = predSide === 'a' ? 'aCur' : 'bCur';
                        const ops = data.ops || [];
                        const ideal = ops.find(o => {
                            const p = o[predKey];
                            return p && p.status === 'success' && p.label !== 'Abnormal' && o[curKey] && o[curKey].length;
                        });
                        if (!ideal) { container.innerHTML = ''; continue; }

                        container.innerHTML = sorted.map(([name, count], i) =>
                            `<div style="font-size:11px; font-weight:700; color:var(--text-muted); margin:10px 0 4px;">${escapeHtml(name)} - All ${count} Occurrences (red) vs Healthy (green)</div>
                                                             <div id="faultChart${sideKey}_${i}"></div>`
                        ).join('');

                        // Rendered one chart at a time (awaited in sequence), not all at
                        // once - each of these can carry dozens of overlaid traces, and
                        // firing every Plotly.newPlot in the same tick overloads the
                        // server-side PDF-export browser, which is why some charts used to
                        // come out blank/unfinished in the printed report.
                        for (let i = 0; i < sorted.length; i++) {
                            const [condName, count] = sorted[i];
                            const occurrences = ops.filter(o => {
                                const p = o[predKey];
                                return p && p.label === 'Abnormal' && p.types && p.types.length && p.types[0].type === condName && o[curKey] && o[curKey].length;
                            });
                            const divId = `faultChart${sideKey}_${i}`;
                            if (!occurrences.length) continue;
                            const xs = arr => arr.map((_, oi) => oi * 20);   // historian polls every 20 ms (50 Hz)
                            const traces = occurrences.map((o, oi) => ({
                                x: xs(o[curKey]), y: o[curKey], mode: 'lines',
                                name: `${condName} #${oi + 1}`, showlegend: false,
                                line: { color: '#dc2626', width: 1.5 }, opacity: 0.45,
                            }));
                            traces.push({ x: xs(ideal[curKey]), y: ideal[curKey], mode: 'lines', name: 'Healthy (normal)', line: { color: '#16a34a', width: 2.5 } });
                            await Plotly.newPlot(divId, traces, {
                                height: 220, margin: { l: 46, r: 14, t: 10, b: 34 },
                                xaxis: { showgrid: false, title: { text: 'time (ms)', font: { size: 10 } } },
                                yaxis: { zeroline: false, title: { text: 'Current (A)', font: { size: 10 } }, gridcolor: '#eef2f6' },
                                showlegend: false,
                            }, { responsive: true, displaylogo: false });
                        }
                    }
                }

                // ==================== TIMELINE (PMv1 makeTrace() port - diamond/circle/triangle) ====================

                // Extracted from renderTimeline() so a single side's trace can also be built
                // standalone (PDF-export's per-machine Timeline chart, see
                // renderTimelineSide3 below) without duplicating this scoring/coloring logic.
                function buildTimelineTrace3(ops, side, yVal, label, active) {
                    const NORMAL = getComputedStyle(document.documentElement).getPropertyValue('--normal').trim() || '#16a34a';
                    const ABNORMAL_Y_OFFSET = 0.06;
                    const predKey = side === 'a' ? 'aPrediction' : 'bPrediction';
                    const points = [];
                    ops.forEach(o => {
                        const p = o[predKey];
                        if (!p) return;
                        let color, tip, size = 9, symbol = 'circle', yPoint = yVal, layer = 0;
                        const tstr = o.time.toLocaleString();
                        const dirLine = o.direction ? `<br>Direction: <b>${o.direction}</b>` : '';
                        // No-data and incomplete-evidence ops are excluded from the
                        // timeline entirely (not just under an active family filter) -
                        // they carry no real classification signal, so plotting them
                        // just adds grey/amber noise to the color line.
                        if (p.status === 'nodata') {
                            return;
                        } else if (p.status !== 'success') {
                            return;
                        } else if (isIncompleteEvidence(p)) {
                            return;
                        } else if (p.label === 'Abnormal') {
                            const types = p.types || [];
                            const mainFault = types.length ? types[0].type : 'Unclassified';
                            if (active.size > 0 && !active.has(mainFault)) return;
                            color = FAMILY_COLORS[mainFault] || '#ef4444';
                            size = 10; symbol = 'diamond'; yPoint = yVal + ABNORMAL_Y_OFFSET;
                            tip = `<b>${label}</b> \u00b7 ${tstr}<br>Family: <b>${escapeHtml(mainFault)}</b><br>Confidence: ${p.confidence}%${dirLine}<br><i>Click for current waveform</i>`;
                        } else {
                            if (active.size > 0) return;
                            color = NORMAL; layer = 1;
                            tip = `<b>${label}</b> \u00b7 ${tstr}<br>Status: Normal<br>Confidence: ${p.confidence}%${dirLine}<br><i>Click for current waveform</i>`;
                        }
                        points.push({ op: o, x: o.time, y: yPoint, color, text: tip, size, symbol, layer });
                    });
                    points.sort((p1, p2) => p1.layer - p2.layer);
                    TIMELINE_POINTS[side] = points;
                    TIMELINE_ORDER[side] = points.map((_, i) => i).sort((ia, ib) => points[ia].x - points[ib].x);
                    return {
                        x: points.map(p => p.x), y: points.map(p => p.y), text: points.map(p => p.text),
                        mode: 'markers', type: 'scatter', name: label,
                        marker: { color: points.map(p => p.color), symbol: points.map(p => p.symbol), size: points.map(p => p.size), line: { width: 1, color: '#fff' } },
                        hovertemplate: '%{text}<extra></extra>',
                    };
                }

                function renderTimeline(ops) {
                    const traces = [buildTimelineTrace3(ops, 'a', 2, 'A', activeFilters), buildTimelineTrace3(ops, 'b', 1, 'B', activeFilters)];
                    const layout = {
                        height: 260, margin: { l: 50, r: 20, t: 10, b: 40 },
                        xaxis: { type: 'date' },
                        yaxis: { tickmode: 'array', tickvals: [1, 2], ticktext: ['B', 'A'], range: [0.5, 2.5] },
                        showlegend: false, hovermode: 'closest',
                        paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
                        font: { color: getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim() },
                    };
                    const el = document.getElementById('timeline3');
                    Plotly.newPlot(el, traces, layout, { responsive: true, displaylogo: false });
                    el.removeAllListeners && el.removeAllListeners('plotly_click');
                    el.on('plotly_click', (ev) => {
                        const pt = ev.points && ev.points[0];
                        if (!pt) return;
                        const side = pt.curveNumber === 0 ? 'a' : 'b';
                        const item = TIMELINE_POINTS[side][pt.pointNumber];
                        if (item) renderDetail(item, side === 'a' ? 'Machine A' : 'Machine B', side);
                    });
                }

                // PDF-export-only: a single-machine version of the Timeline chart above (one
                // row instead of two), so Machine A's and Machine B's timelines can each sit
                // inside that machine's own section of the report instead of one shared
                // combined chart. Not used during normal interactive browsing.
                function renderTimelineSide3(ops, side, label, divId) {
                    const el = document.getElementById(divId);
                    if (!el) return;
                    const trace = buildTimelineTrace3(ops, side, 1, label, activeFilters);
                    const layout = {
                        height: 200, margin: { l: 50, r: 20, t: 10, b: 40 },
                        xaxis: { type: 'date' },
                        yaxis: { tickmode: 'array', tickvals: [1], ticktext: [label], range: [0.5, 1.5] },
                        showlegend: false, hovermode: 'closest',
                        paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
                        font: { color: getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim() },
                    };
                    Plotly.newPlot(el, [trace], layout, { responsive: true, displaylogo: false });
                }

                // \u2500\u2500 CLASS TIMELINE - pmcluster.html's "consecutive-same-code merges into one
                // band" view, but grouped by THIS model's own Normal/family classification
                // instead of the historian's pre-baked cluster codes, and split by direction
                // (fwd/rev use different models) into 4 independent groups. Purely additive -
                // sits below the existing dot timeline, shares TIMELINE_POINTS (built by
                // renderTimeline above, called first in renderResults) so clicking a band
                // reuses the exact same renderDetail()/Prev-Next flow as the dot timeline.
                function classifyOp(p, GREY, AMBER, NORMAL_C) {
                    if (!p || p.status === 'error') return null;
                    // No-data and incomplete-evidence ops are excluded from the Class
                    // Timeline entirely (bands and tile-strips alike), same as the dot
                    // timeline above - null here means "not part of any band".
                    if (p.status === 'nodata') return null;
                    if (isIncompleteEvidence(p)) return null;
                    if (p.label === 'Abnormal') {
                        const fam = (p.types && p.types[0]) ? p.types[0].type : 'Unclassified';
                        return { cls: fam, color: FAMILY_COLORS[fam] || '#ef4444', label: fam };
                    }
                    return { cls: 'Normal', color: NORMAL_C, label: 'Normal' };
                }

                function isReverseDirection(direction) {
                    return !!(direction && String(direction).toLowerCase().startsWith('rev'));
                }

                // One combined band-timeline per MACHINE (mixes fwd+rev chronologically -
                // a quick visual overview). The two tile-strips underneath stay split by
                // direction (fwd/rev are different models/populations, worth keeping
                // visually separate) but are ALIGNED column-for-column to the combined
                // band's own slots: since a combined-band boundary fires on ANY class
                // change (either direction), every op inside one combined slot - fwd or
                // rev - is guaranteed the same class, so slicing each direction's ops by
                // those same slot boundaries can never disagree on label, only on how many
                // (if any) ops that direction had there. A direction with zero ops in a
                // slot renders an empty placeholder tile instead of just omitting the
                // column, so column N always means the same time-slot in both strips -
                // this is also what keeps the two strips' scrollbars in sync (equal tile
                // count -> equal scrollable width).
                function renderClassBands(ops) {
                    const GREY = getComputedStyle(document.documentElement).getPropertyValue('--text-muted').trim() || '#8b90ac';
                    const AMBER = '#d97706';
                    const NORMAL_C = getComputedStyle(document.documentElement).getPropertyValue('--normal').trim() || '#16a34a';
                    const xEndAll = ops.length ? ops[ops.length - 1].time : null;

                    ['a', 'b'].forEach(side => {
                        const predKey = side === 'a' ? 'aPrediction' : 'bPrediction';
                        const upper = side.toUpperCase();

                        const allBands = computeClassBands(ops, side, GREY, AMBER, NORMAL_C, xEndAll);
                        renderClassTimeline(allBands, side, side + '_all', `classTimeline${upper}3`);

                        const fwdOps = ops.filter(o => !isReverseDirection(o.direction));
                        const revOps = ops.filter(o => isReverseDirection(o.direction));
                        renderOpTiles(`classStrip${upper}_fwd3`, fwdOps, side, predKey, side + '_fwd');
                        renderOpTiles(`classStrip${upper}_rev3`, revOps, side, predKey, side + '_rev');

                        linkScroll(`classStrip${upper}_fwd3`, `classStrip${upper}_rev3`);
                    });
                }

                // Groups strips into consecutive-same-class bands (pure data, no rendering) -
                // shared by both the combined per-machine timeline (fed ALL ops) and each
                // direction's own strip (fed just that direction's ops).
                function computeClassBands(ops, side, GREY, AMBER, NORMAL_C, xEnd) {
                    const predKey = side === 'a' ? 'aPrediction' : 'bPrediction';
                    const active = activeFilters;
                    const items = [];
                    ops.forEach(o => {
                        const c = classifyOp(o[predKey], GREY, AMBER, NORMAL_C);
                        if (!c) return;
                        // Same filter semantics as the dot timeline above: an active family
                        // filter hides everything except matching-family Abnormal points.
                        if (active.size > 0 && (c.cls === 'Normal' || !active.has(c.cls))) return;
                        items.push({ op: o, x: o.time, cls: c.cls, color: c.color, label: c.label });
                    });
                    const bands = [];
                    items.forEach(it => {
                        const last = bands[bands.length - 1];
                        if (last && last.cls === it.cls) last.items.push(it);
                        else bands.push({ cls: it.cls, color: it.color, label: it.label, items: [it] });
                    });
                    // x1 fixed once at build time (not recomputed from neighbours later) so
                    // highlightClassBand() can restyle just the border/size without needing
                    // xEnd or the sibling-band lookup again.
                    bands.forEach((b, i) => {
                        b.x1 = (i + 1 < bands.length) ? bands[i + 1].items[0].x : (xEnd || b.items[b.items.length - 1].x);
                    });
                    return bands;
                }

                const CLASS_GROUPS = {};   // groupKey ('a_all'/'a_fwd'/'a_rev'/'b_all'/...) -> {bands, side, timelineElId, stripElId}

                function renderClassTimeline(bands, side, groupKey, timelineElId) {
                    CLASS_GROUPS[groupKey] = { bands, side, timelineElId, stripElId: null };
                    const el = document.getElementById(timelineElId);
                    if (!el) return;
                    const gridColor = getComputedStyle(document.documentElement).getPropertyValue('--border').trim();
                    const fontColor = getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim();
                    const hoverX = bands.map(b => b.items[0].x);
                    const hoverText = bands.map(b => `<b>${escapeHtml(b.label)}</b> \u00b7 ${b.items.length} op${b.items.length > 1 ? 's' : ''}<br>${b.items[0].x.toLocaleString()}`);
                    const data = [{
                        x: hoverX, y: hoverX.map(() => 1), text: hoverText, mode: 'markers', type: 'scatter',
                        marker: { color: bands.map(b => b.color), size: 12, opacity: 0.01 },
                        hovertemplate: '%{text}<extra></extra>',
                    }];
                    const layout = {
                        height: 70, margin: { l: 10, r: 10, t: 4, b: 20 },
                        paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
                        font: { color: fontColor, size: 10 }, shapes: buildClassShapes(bands, -1),
                        xaxis: { type: 'date', gridcolor: gridColor },
                        yaxis: { visible: false, range: [0, 2], fixedrange: true },
                        showlegend: false, hovermode: 'closest',
                    };
                    Plotly.newPlot(el, data, layout, { responsive: true, displaylogo: false });
                    el.removeAllListeners && el.removeAllListeners('plotly_click');
                    el.on('plotly_click', (ev) => {
                        const pt = ev.points && ev.points[0];
                        if (!pt) return;
                        selectClassBand(groupKey, pt.pointNumber);
                    });
                }

                // Every operation gets its OWN small current-waveform plot for a direction
                // (Normal Forward / Reverse) - no aggregation into bands, laid out side by
                // side in one scrollable row (no-data/incomplete/error already excluded by
                // classifyOp - never even reaches this array). groupKey ('a_fwd'/'a_rev'/
                // 'b_fwd'/'b_rev') -> OP_GROUPS entry, separate from CLASS_GROUPS (which
                // now only holds the top combined band-timelines, '_all' suffix).
                const OP_GROUPS = {};

                function renderOpTiles(elId, ops, side, predKey, groupKey) {
                    const GREY = getComputedStyle(document.documentElement).getPropertyValue('--text-muted').trim() || '#8b90ac';
                    const AMBER = '#d97706';
                    const NORMAL_C = getComputedStyle(document.documentElement).getPropertyValue('--normal').trim() || '#16a34a';
                    const container = document.getElementById(elId);
                    if (!container) return;

                    const curKey = side === 'a' ? 'aCur' : 'bCur';
                    const items = [];
                    ops.forEach(o => {
                        const c = classifyOp(o[predKey], GREY, AMBER, NORMAL_C);
                        if (!c) return;   // no-data/incomplete/error - excluded entirely, never plotted at all
                        items.push({ op: o, x: o.time, color: c.color, label: c.label });
                    });
                    OP_GROUPS[groupKey] = { side, elId, items };

                    if (!items.length) {
                        container.innerHTML = '<div style="font-size:12px; color:var(--text-muted); padding:10px;">No data.</div>';
                        return;
                    }

                    const tileTime3 = t => t.toLocaleDateString('en-IN', { day: '2-digit', month: 'short' }) + ' ' + t.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
                    container.innerHTML = items.map((it, i) =>
                        `<div class="class-tile" data-idx="${i}">
                                                            <div class="class-tile-label" style="color:${it.color};">${escapeHtml(it.label)}</div>
                                                            <div id="${elId}-plot-${i}" class="class-tile-plot"></div>
                                                            <div class="class-tile-time">${tileTime3(it.x)}</div>
                                                        </div>`
                    ).join('');
                    items.forEach((it, i) => {
                        Plotly.newPlot(`${elId}-plot-${i}`, [{
                            y: it.op[curKey] || [], mode: 'lines', type: 'scatter',
                            line: { color: it.color, width: 1.4 }, hoverinfo: 'skip',
                        }], {
                            height: 50, margin: { l: 0, r: 0, t: 0, b: 0 },
                            xaxis: { visible: false }, yaxis: { visible: false },
                            paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)', showlegend: false,
                        }, { staticPlot: true, responsive: false });
                        const tile = container.querySelector(`[data-idx="${i}"]`);
                        if (tile) tile.onclick = () => {
                            const tp = TIMELINE_POINTS[side].find(t => t.op === it.op);
                            if (tp) renderDetail(tp, side === 'a' ? 'Machine A' : 'Machine B', side);
                            // Also highlight the matching band on the TOP combined timeline -
                            // the reverse of selectClassBand (band click -> tile scroll).
                            const bandIdx = findBandIndexForTime(side + '_all', it.x);
                            if (bandIdx >= 0) highlightClassBand(side + '_all', bandIdx);
                        };
                    });
                }

                // Finds which band in a CLASS_GROUPS entry a given timestamp falls inside -
                // used by a tile click to highlight the matching band on the top timeline.
                function findBandIndexForTime(groupKey, time) {
                    const g = CLASS_GROUPS[groupKey];
                    if (!g) return -1;
                    return g.bands.findIndex(b => time >= b.items[0].x && time < b.x1);
                }

                // Scrolls a direction's tile row to whichever of its ops falls inside
                // [start, end) - used when a top-band is clicked, so both direction rows
                // jump to the same time window. A no-op if this direction has no op in
                // that band's time range (nothing to scroll to).
                function scrollDirectionToTime(groupKey, start, end) {
                    const g = OP_GROUPS[groupKey];
                    if (!g) return;
                    const idx = g.items.findIndex(it => it.x >= start && it.x < end);
                    if (idx < 0) return;
                    const el = document.getElementById(g.elId);
                    if (!el) return;
                    const tile = el.children[idx];
                    if (!tile) return;
                    SUPPRESS_LINK_SYNC3 = true;
                    tile.scrollIntoView({ inline: 'center', block: 'nearest' });
                    setTimeout(() => { SUPPRESS_LINK_SYNC3 = false; }, 150);
                }

                // Bidirectional: scrolling either strip mirrors the same scrollLeft onto its
                // sibling. Re-attached on every render (the strips are rebuilt from
                // innerHTML each time) - a `syncing` guard stops the mirrored scroll from
                // re-triggering its own listener and looping.
                // true while an explicit click-driven scroll-to-tile is in flight
                // (scrollStripToIndex below) - suppresses the proportional continuous-sync
                // handlers here so they don't immediately override the precise index-target
                // position with an approximate percentage-based one.
                let SUPPRESS_LINK_SYNC3 = false;

                // Forward/Reverse strips can have different tile counts now (empty "no ops
                // here" placeholders are no longer rendered - see renderClassStrip), so a
                // literal scrollLeft mirror no longer lines up the same time-slot on both
                // sides. Proportional sync instead: both strips always sit at the same
                // PERCENTAGE of their own scrollable width - not tile-exact, but keeps both
                // strips in the same rough region of the time range regardless of how many
                // gaps either side has.
                function linkScroll(elId1, elId2) {
                    const el1 = document.getElementById(elId1);
                    const el2 = document.getElementById(elId2);
                    if (!el1 || !el2) return;
                    let syncing = false;
                    const sync = (src, dst) => {
                        if (syncing || SUPPRESS_LINK_SYNC3) return;
                        syncing = true;
                        const maxSrc = src.scrollWidth - src.clientWidth;
                        const maxDst = dst.scrollWidth - dst.clientWidth;
                        dst.scrollLeft = maxSrc > 0 ? (src.scrollLeft / maxSrc) * maxDst : 0;
                        syncing = false;
                    };
                    el1.onscroll = () => sync(el1, el2);
                    el2.onscroll = () => sync(el2, el1);
                }

                // One rect per band; the SELECTED band gets a visible border, extends
                // slightly taller/wider than the rest, and draws above its neighbours -
                // same "currently viewing" idea as the dot timeline's highlightTimelinePoint.
                function buildClassShapes(bands, selectedIdx) {
                    const accent = getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#000';
                    return bands.map((b, i) => {
                        const sel = i === selectedIdx;
                        return {
                            type: 'rect', xref: 'x', yref: 'y',
                            x0: b.items[0].x, x1: b.x1,
                            y0: sel ? 0.1 : 0.3, y1: sel ? 1.9 : 1.7,
                            fillcolor: b.color, line: { width: sel ? 3 : 0, color: sel ? accent : b.color },
                            layer: sel ? 'above' : 'below',
                        };
                    });
                }

                function highlightClassBand(groupKey, idx) {
                    const g = CLASS_GROUPS[groupKey];
                    if (!g) return;
                    const el2 = document.getElementById(g.timelineElId);
                    if (el2 && el2.data) Plotly.relayout(el2, { shapes: buildClassShapes(g.bands, idx) });
                }

                function selectClassBand(groupKey, idx) {
                    const g = CLASS_GROUPS[groupKey];
                    if (!g) return;
                    const band = (g.bands || [])[idx];
                    if (!band || !band.items.length) return;
                    highlightClassBand(g.side + '_all', idx);
                    // Point at that same time window in BOTH direction dot-plots by scrolling
                    // to whichever of their points falls inside it - not a page-level scroll
                    // down to the detail plot, just bringing the matching point into view in
                    // each plot (a no-op for a direction with nothing in that window).
                    scrollDirectionToTime(g.side + '_fwd', band.items[0].x, band.x1);
                    scrollDirectionToTime(g.side + '_rev', band.items[0].x, band.x1);
                    const repOp = band.items[0].op;
                    const tp = TIMELINE_POINTS[g.side].find(p => p.op === repOp);
                    if (tp) renderDetail(tp, g.side === 'a' ? 'Machine A' : 'Machine B', g.side);
                }

                const TIMELINE_POINTS = { a: [], b: [] };
                // TIMELINE_ORDER[side] holds TIMELINE_POINTS[side] INDEXES sorted by time -
                // the points array itself is sorted by draw layer (so abnormal/nodata dots
                // paint over normal ones), not chronologically, so Prev/Next needs its own
                // time-ordered lookup instead of just walking the array in place.
                const TIMELINE_ORDER = { a: [], b: [] };
                let CURRENT_DETAIL3 = null;

                function lineChart(divId, values, color, title) {
                    const gridColor = getComputedStyle(document.documentElement).getPropertyValue('--border').trim();
                    const fontColor = getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim();
                    Plotly.newPlot(divId, [{
                        y: values, mode: 'lines', line: { color, width: 1.6 }, fill: 'tozeroy', fillcolor: color + '18',
                    }], {
                        height: 180, margin: { l: 40, r: 10, t: 24, b: 24 },
                        title: { text: title, font: { size: 11, color: fontColor } },
                        xaxis: { showgrid: false, color: fontColor }, yaxis: { zeroline: false, gridcolor: gridColor, color: fontColor },
                        paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)', font: { color: fontColor },
                    }, { responsive: true, displaylogo: false });
                }

                function renderDetail(item, label, sideKey) {
                    const box = document.getElementById('detailBox3');
                    box.style.display = 'block';
                    const { op, symbol } = item;
                    const p = sideKey === 'a' ? op.aPrediction : op.bPrediction;
                    const grade = symbol === 'diamond' ? 'ABNORMAL' : symbol === 'triangle-up' ? 'INCOMPLETE' : (p.status === 'nodata' ? 'NO DATA' : 'NORMAL');
                    const fam = (p.types && p.types[0]) ? ` \u00b7 ${p.types[0].type}` : '';
                    const idx = TIMELINE_POINTS[sideKey].indexOf(item);
                    const order = TIMELINE_ORDER[sideKey] || [];
                    const orderPos = order.indexOf(idx);
                    document.getElementById('detailTitle3').textContent = `${label} \u00b7 ${new Date(op.time).toLocaleString()} \u00b7 ${grade}${fam}`;
                    document.getElementById('detailPrevBtn3').disabled = orderPos <= 0;
                    document.getElementById('detailNextBtn3').disabled = orderPos < 0 || orderPos >= order.length - 1;
                    document.getElementById('detailNotes3').textContent = (p.confidence != null
                        ? `Confidence: ${p.confidence}%` + (p.type_trusted === false ? ' \u00b7 duration beyond the trained 6s window - type not trusted' : '') : '')
                        + (order.length > 1 ? `  \u00b7  ${orderPos + 1} / ${order.length}  \u00b7  use \u2190 \u2192 to browse` : '');
                    const curKey = sideKey === 'a' ? 'aCur' : 'bCur';
                    const voltKey = sideKey === 'a' ? 'aVolt' : 'bVolt';
                    lineChart('detailCurrentChart3', op[curKey] || [], getComputedStyle(document.documentElement).getPropertyValue('--current-color').trim(), 'Current (A) - fed to the model');
                    lineChart('detailVoltageChart3', op[voltKey] || [], getComputedStyle(document.documentElement).getPropertyValue('--text-muted').trim(), 'Voltage (V) - measured only, NOT used by the current-only model');
                    CURRENT_DETAIL3 = { sideKey, orderPos, item };
                    highlightTimelinePoint3(sideKey, idx);
                    // No auto-scroll - the detail box updates in place, user scrolls to it
                    // themselves if/when they want to see it.
                }

                function highlightTimelinePoint3(sideKey, idx) {
                    const el = document.getElementById('timeline3');
                    if (!el || !el.data) return;
                    const traceIdx = sideKey === 'a' ? 0 : 1;
                    const n = (TIMELINE_POINTS[sideKey] || []).length;
                    const accent = getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#000';
                    const widths = new Array(n).fill(1);
                    const lineColors = new Array(n).fill('#fff');
                    const sizes = TIMELINE_POINTS[sideKey].map(p => p.size);
                    if (idx != null && idx >= 0 && idx < n) {
                        widths[idx] = 3;
                        lineColors[idx] = accent;
                        sizes[idx] = sizes[idx] + 5;
                    }
                    Plotly.restyle(el, { 'marker.line.width': [widths], 'marker.line.color': [lineColors], 'marker.size': [sizes] }, [traceIdx]);
                }

                function navigateDetail3(delta) {
                    if (!CURRENT_DETAIL3) return;
                    const { sideKey, orderPos } = CURRENT_DETAIL3;
                    const order = TIMELINE_ORDER[sideKey] || [];
                    const newPos = orderPos + delta;
                    if (newPos < 0 || newPos >= order.length) return;
                    const idx = order[newPos];
                    const item = TIMELINE_POINTS[sideKey][idx];
                    if (!item) return;
                    renderDetail(item, sideKey === 'a' ? 'Machine A' : 'Machine B', sideKey);
                }

                // \u2500\u2500 FEEDBACK MODAL - same idea as developers.html's inline Feedback panel
                // (draw optional + required note, POSTed to /api/predict3/feedback), just
                // packaged behind a "Give Feedback" button + popup instead of always-visible
                // inline, since the combined page is meant to stay closer to the plain
                // operational dashboard.html look.
                let SHAPE_HISTORY3 = [[]];
                let SHAPE_HISTORY_POS3 = 0;
                let RESTORING_SHAPES3 = false;

                function lineChartDrawable3(divId, values, color, title) {
                    const gridColor = getComputedStyle(document.documentElement).getPropertyValue('--border').trim();
                    const fontColor = getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim();
                    SHAPE_HISTORY3 = [[]];
                    SHAPE_HISTORY_POS3 = 0;
                    Plotly.newPlot(divId, [{
                        y: values, mode: 'lines', line: { color, width: 1.6 }, fill: 'tozeroy', fillcolor: color + '18',
                    }], {
                        height: 220, margin: { l: 40, r: 10, t: 24, b: 24 },
                        title: { text: title, font: { size: 11, color: fontColor } },
                        xaxis: { showgrid: false, color: fontColor }, yaxis: { zeroline: false, gridcolor: gridColor, color: fontColor },
                        paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)', font: { color: fontColor },
                        shapes: [], newshape: { line: { color: '#dc2626', width: 2 } },
                        // Default interaction mode is drawing a rectangle, not zoom/pan - so
                        // a plain click-drag marks a region right away, no need to click a
                        // toolbar button first. Only rect/circle are offered (no freehand/
                        // line) - simple shapes are enough to point at a region and easier
                        // to read back later than an arbitrary scribble.
                        dragmode: 'drawrect',
                    }, {
                        responsive: true, displaylogo: false, displayModeBar: true,
                        modeBarButtonsToAdd: ['drawrect', 'drawcircle', 'eraseshape'],
                    }).then(gd => {
                        updateShapeHistoryButtons3();
                        gd.removeAllListeners && gd.removeAllListeners('plotly_relayout');
                        gd.on('plotly_relayout', () => {
                            if (RESTORING_SHAPES3) return;
                            const current = JSON.stringify(gd.layout.shapes || []);
                            if (current === JSON.stringify(SHAPE_HISTORY3[SHAPE_HISTORY_POS3] || [])) return;
                            SHAPE_HISTORY3 = SHAPE_HISTORY3.slice(0, SHAPE_HISTORY_POS3 + 1);
                            SHAPE_HISTORY3.push(JSON.parse(current));
                            SHAPE_HISTORY_POS3 = SHAPE_HISTORY3.length - 1;
                            updateShapeHistoryButtons3();
                        });
                    });
                }

                function updateShapeHistoryButtons3() {
                    const u = document.getElementById('shapeUndoBtn3');
                    const r = document.getElementById('shapeRedoBtn3');
                    if (u) u.disabled = SHAPE_HISTORY_POS3 <= 0;
                    if (r) r.disabled = SHAPE_HISTORY_POS3 >= SHAPE_HISTORY3.length - 1;
                }

                function undoShape3() {
                    if (SHAPE_HISTORY_POS3 <= 0) return;
                    SHAPE_HISTORY_POS3--;
                    applyShapeHistory3();
                }

                function redoShape3() {
                    if (SHAPE_HISTORY_POS3 >= SHAPE_HISTORY3.length - 1) return;
                    SHAPE_HISTORY_POS3++;
                    applyShapeHistory3();
                }

                function applyShapeHistory3() {
                    const chartEl = document.getElementById('feedbackModalChart3');
                    if (!chartEl) return;
                    RESTORING_SHAPES3 = true;
                    Plotly.relayout(chartEl, { shapes: SHAPE_HISTORY3[SHAPE_HISTORY_POS3] }).then(() => {
                        RESTORING_SHAPES3 = false;
                        updateShapeHistoryButtons3();
                    });
                }

                function onFeedbackLabelChange3() {
                    const isAbnormal = document.getElementById('feedbackLabel3').value === 'Abnormal';
                    document.getElementById('feedbackFamily3').style.display = isAbnormal ? 'inline-block' : 'none';
                }

                function openFeedbackModal3() {
                    if (!CURRENT_DETAIL3 || !CURRENT_DETAIL3.item) return;
                    const { sideKey, item } = CURRENT_DETAIL3;
                    const { op } = item;
                    const p = sideKey === 'a' ? op.aPrediction : op.bPrediction;
                    const curKey = sideKey === 'a' ? 'aCur' : 'bCur';
                    document.getElementById('feedbackNote3').value = '';
                    document.getElementById('feedbackStatus3').textContent = '';
                    document.getElementById('feedbackStatus3').style.color = 'var(--text-muted)';
                    document.getElementById('feedbackModal3').style.display = 'flex';
                    const famSel = document.getElementById('feedbackFamily3');
                    famSel.innerHTML = Object.keys(FAMILY_INFO)
                        .filter(k => /^\d/.test(k))
                        .map(k => `<option value="${escapeHtml(k.split(' ')[0])}">${escapeHtml(k)}</option>`).join('');
                    // Default to the OPPOSITE of what the model currently says - a
                    // correction is almost always "the model got this one wrong".
                    document.getElementById('feedbackLabel3').value = (p && p.label === 'Abnormal') ? 'Normal' : 'Abnormal';
                    onFeedbackLabelChange3();
                    lineChartDrawable3('feedbackModalChart3', op[curKey] || [], getComputedStyle(document.documentElement).getPropertyValue('--current-color').trim(), 'Current (A) - fed to the model');
                }

                function closeFeedbackModal3() {
                    document.getElementById('feedbackModal3').style.display = 'none';
                }

                async function submitFeedback3() {
                    if (!CURRENT_DETAIL3 || !CURRENT_DETAIL3.item) return;
                    const noteEl = document.getElementById('feedbackNote3');
                    const statusEl = document.getElementById('feedbackStatus3');
                    const note = noteEl.value.trim();
                    if (!note) {
                        statusEl.style.color = 'var(--abnormal)';
                        statusEl.textContent = 'Feedback message is required.';
                        noteEl.focus();
                        return;
                    }
                    const { sideKey, item } = CURRENT_DETAIL3;
                    const { op } = item;
                    const p = sideKey === 'a' ? op.aPrediction : op.bPrediction;
                    const pm = S.selectedAsset;
                    const siteObj = S.sites.find(s => String(s.SiteId) === String(S.currentSiteId));
                    const curKey = sideKey === 'a' ? 'aCur' : 'bCur';
                    const voltKey = sideKey === 'a' ? 'aVolt' : 'bVolt';
                    const wave = sideKey === 'a' ? pm.aWaveType : pm.bWaveType;
                    const chartEl = document.getElementById('feedbackModalChart3');
                    const shapes = (chartEl && chartEl.layout && chartEl.layout.shapes) ? chartEl.layout.shapes : [];
                    const correctedLabel = document.getElementById('feedbackLabel3').value;
                    const correctedFamily = correctedLabel === 'Abnormal' ? document.getElementById('feedbackFamily3').value : null;
                    statusEl.style.color = 'var(--text-muted)';
                    statusEl.textContent = 'Saving\u2026';
                    try {
                        const r = await fetch(PM3_ENDPOINTS.predictFeedback, {
                            method: 'POST', headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                site_id: S.currentSiteId ? Number(S.currentSiteId) : null,
                                site_name: (siteObj && siteObj.SiteName) || null,
                                asset_id: pm.assetId, asset_name: pm.assetName,
                                wave: wave || null, direction: op.direction || null,
                                end: sideKey === 'a' ? 'A' : 'B', time: new Date(op.time).toISOString(),
                                current: op[curKey] || [], voltage: op[voltKey] || [],
                                model_label: p.label || null,
                                model_confidence: p.confidence != null ? p.confidence : null,
                                model_family: (p.types && p.types[0]) ? p.types[0].type : null,
                                drawn_shapes: shapes, corrected_label: correctedLabel, corrected_family: correctedFamily, note,
                            }),
                        });
                        if (!r.ok) throw new Error(`HTTP ${r.status}`);
                        const data = await r.json();
                        statusEl.style.color = 'var(--normal)';
                        statusEl.textContent = `Saved - ${data.total_feedback} feedback item(s) logged for the next retrain.`;
                        toast('Feedback saved', 'success');
                    } catch (e) {
                        statusEl.style.color = 'var(--abnormal)';
                        statusEl.textContent = 'Failed to save: ' + e.message;
                        toast('Failed to save feedback', 'error');
                    }
                }

                function renderFaultLegend() {
                    const el = document.getElementById('faultLegend3');
                    if (!el || el.dataset.filled === '1') return;
                    el.innerHTML = Object.keys(FAMILY_INFO).map(name =>
                        `<div class="legend-line"><b style="color:var(--text-primary);">${escapeHtml(name)}</b> \u2014 ${escapeHtml(FAMILY_INFO[name])}</div>`).join('');
                    el.dataset.filled = '1';
                }

                function renderSummaryBullets(data) {
                    if (!data || typeof data !== 'object' || Array.isArray(data)) {
                        return `<span>${escapeHtml(data || 'No summary returned.')}</span>`;
                    }
                    const points = Array.isArray(data.points) ? data.points : [];
                    const bullets = points.map(p => `<li style="margin-bottom:4px;">${escapeHtml(p)}</li>`).join('');
                    return `<div style="font-weight:800; font-size:14px; margin-bottom:6px;">${escapeHtml(data.verdict)}</div>`
                        + (bullets ? `<ul style="margin:0 0 6px 18px; padding:0;">${bullets}</ul>` : '')
                        + (data.recommendation ? `<div style="margin-top:4px;"><b>Recommendation:</b> ${escapeHtml(data.recommendation)}</div>` : '');
                }

                function renderAiSummary(summary) {
                    if (!summary) return;
                    const box = document.getElementById('aiSummaryBox3');
                    if (!box) return;
                    box.style.display = 'block';
                    document.getElementById('aiSummaryText3').innerHTML = renderSummaryBullets(summary);
                    // Kept as structured data (not just the rendered HTML) so exportPdf3 can
                    // write it as real jsPDF text (verdict/points/recommendation), the same
                    // shape V4's own PDF export already reads from data.ai_summary.
                    S.lastAiSummary = summary;
                }

                function weeklyTrend(ops, side, windowStart, windowEnd) {
                    const predKey = side === 'a' ? 'aPrediction' : 'bPrediction';
                    const buckets = [];
                    let cur = new Date(windowStart);
                    while (cur < windowEnd) {
                        const next = new Date(Math.min(cur.getTime() + 7 * 24 * 3600 * 1000, windowEnd.getTime()));
                        buckets.push({ start: new Date(cur), end: new Date(next), total: 0, bad: 0, incomplete: 0 });
                        cur = next;
                    }
                    ops.forEach(o => {
                        const p = o[predKey];
                        if (!p || p.status !== 'success') return;
                        const b = buckets.find(bk => o.time >= bk.start && o.time < bk.end);
                        if (!b) return;
                        if (isIncompleteEvidence(p)) { b.incomplete++; return; }
                        b.total++;
                        if (p.label === 'Abnormal') b.bad++;
                    });
                    return buckets.filter(b => b.total + b.incomplete > 0).map(b => ({
                        period: `${b.start.toISOString().slice(0, 10)} to ${b.end.toISOString().slice(0, 10)}`,
                        badPct: b.total ? Math.round(b.bad / b.total * 1000) / 10 : 0,
                        total: b.total, incompletePct: (b.total + b.incomplete) ? Math.round(b.incomplete / (b.total + b.incomplete) * 1000) / 10 : 0,
                    }));
                }

                async function fetchAiSummary(pm, data, siteObj) {
                    try {
                        const machine = (side, label) => {
                            const st = data[side];
                            const totalAll = st.total + st.missing + st.incomplete;
                            const pct = n => totalAll ? Math.round(n / totalAll * 1000) / 10 : 0;
                            return {
                                label, wave: st.wave, totalOps: totalAll,
                                goodPct: pct(st.total - st.bad), badPct: pct(st.bad), noDataPct: pct(st.missing),
                                incompleteEvidencePct: pct(st.incomplete),
                                currentFaultPct: pct(st.bad), voltageFaultPct: 0,
                                topFaults: Object.entries(st.familyCount).sort((a, b) => b[1] - a[1]).slice(0, 5).map(([type, count]) => ({ type, count })),
                                trend: weeklyTrend(data.ops, side, data.start, data.end),
                            };
                        };
                        const r = await fetch(PM3_ENDPOINTS.aiSummary, {
                            method: 'POST', headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                assetName: pm.assetName, siteName: (siteObj && siteObj.SiteName) || null,
                                windowStart: data.start.toISOString(), windowEnd: data.end.toISOString(),
                                machines: [machine('a', 'Machine A'), machine('b', 'Machine B')],
                            }),
                        });
                        if (!r.ok) return;
                        const summary = await r.json();
                        renderAiSummary(summary);
                    } catch (e) { /* AI summary is best-effort - never block the rest of the page on it */ }
                }

                async function renderResults(pm, data) {
                    document.getElementById('loading3').style.display = 'none';
                    const el = document.getElementById('results3');
                    el.style.display = 'block';

                    const updatedLabel = (data.fromCache ? 'Cached result' : 'Live result') + ' \u00b7 window '
                        + data.start.toLocaleDateString() + ' \u2192 ' + data.end.toLocaleDateString();
                    const keepAi = el.querySelector('#aiSummaryBox3')?.style.display === 'block' ? el.querySelector('#aiSummaryText3').innerHTML : null;

                    // PDF export only: stack Machine A's whole block above Machine B's,
                    // full width, instead of the normal side-by-side columns - the fault
                    // charts embedded in each block need real width to stay readable, and
                    // the printed report has no reason to conserve horizontal space the way
                    // the live page's two-column layout does. Interactive browsing is
                    // untouched - true only when the server's PDF pipeline drives this page
                    // (autoload=1) or exportPdf3()'s own window.print() flow is active.
                    const isPdfExport = window.__forcePdfPrint3 === true || new URLSearchParams(window.location.search).get('autoload') === '1';
                    const machinesLayout = isPdfExport ? 'flex-direction:column;' : 'flex-wrap:wrap;';

                    // PDF export only: Machine A's Timeline + Class Timeline sit right after
                    // Machine A's own block, and likewise for B - "all of A, then all of B",
                    // same section order this report has always used, just grouped by
                    // machine instead of by section type. Normal browsing keeps the single
                    // shared Timeline/Class Timeline cards (both machines combined) exactly
                    // as before - the classTimeline*3/classStrip*3 div ids only exist in ONE
                    // of these two branches at a time, never both, so there's no id clash.
                    const sideExtra3 = (label, sideKey) => !isPdfExport ? '' : `
                                                        <div class="card">
                                                            <div class="card-title"><span>${label} - Timeline</span><span style="font-weight:500; text-transform:none;">Click a point for its current waveform</span></div>
                                                            <div id="timeline${sideKey.toUpperCase()}3"></div>
                                                        </div>
                                                        <div class="card">
                                                            <div class="card-title"><span>${label} - Class Timeline</span><span style="font-weight:500; text-transform:none;">Consecutive same-class operations merged into one band (fwd+rev combined); tile-strips below stay split by direction</span></div>
                                                            <div id="classTimeline${sideKey.toUpperCase()}3"></div>
                                                            <div class="class-side-label" style="font-size:11px; font-weight:600; margin-top:6px;">Normal (Forward)</div>
                                                            <div id="classStrip${sideKey.toUpperCase()}_fwd3" class="class-strip"></div>
                                                            <div class="class-side-label" style="font-size:11px; font-weight:600;">Reverse</div>
                                                            <div id="classStrip${sideKey.toUpperCase()}_rev3" class="class-strip"></div>
                                                        </div>`;
                    const combinedTimelineSection3 = isPdfExport ? `<div id="timeline3" style="display:none;"></div>` : `
                                                        <div class="card">
                                                            <div class="card-title"><span>Timeline</span><span style="font-weight:500; text-transform:none;">Click a point for its current waveform \u00b7 click a family chip above to filter (multi-select)</span></div>
                                                            <div id="timeline3"></div>
                                                        </div>`;
                    const combinedClassTimelineSection3 = isPdfExport ? '' : `
                                                        <div class="card">
                                                            <div class="card-title"><span>Class Timeline</span><span style="font-weight:500; text-transform:none;">Consecutive same-class operations merged into one band, like pmcluster's view - one band per machine (fwd+rev combined), tile-strips below stay split by direction (different models) - click a band or tile for its waveform</span></div>
                                                            <div class="class-side-label">Machine A</div>
                                                            <div id="classTimelineA3"></div>
                                                            <div class="class-side-label" style="font-size:11px; font-weight:600; margin-top:6px;">Normal (Forward)</div>
                                                            <div id="classStripA_fwd3" class="class-strip"></div>
                                                            <div class="class-side-label" style="font-size:11px; font-weight:600;">Reverse</div>
                                                            <div id="classStripA_rev3" class="class-strip"></div>
                                                            <div class="class-side-label" style="margin-top:16px;">Machine B</div>
                                                            <div id="classTimelineB3"></div>
                                                            <div class="class-side-label" style="font-size:11px; font-weight:600; margin-top:6px;">Normal (Forward)</div>
                                                            <div id="classStripB_fwd3" class="class-strip"></div>
                                                            <div class="class-side-label" style="font-size:11px; font-weight:600;">Reverse</div>
                                                            <div id="classStripB_rev3" class="class-strip"></div>
                                                        </div>`;

                    el.innerHTML = `
                                                        <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:4px;">
                                                            <div>
                                                                <div style="color:var(--accent); font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:0.5px; margin-bottom:2px;">Point Machine Operation \u2014 V3</div>
                                                                <h2 style="margin:0 0 4px;">${escapeHtml(pm.assetName)}</h2>
                                                                <div style="color:var(--text-muted); font-size:12px;">${escapeHtml(S.lastRangeLabel || `last ${WINDOW_DAYS} days`)}</div>
                                                                <div style="color:var(--text-muted); font-size:11px; margin-top:2px;">${updatedLabel}</div>
                                                            </div>
                                                            <div style="display:flex; gap:8px;">
                                                                <button class="btn" style="width:auto; padding:8px 16px; border-radius:8px;" onclick="updateCurrentAsset3()" title="Ignore cache, re-fetch and re-predict right now">Update Results</button>
                                                                <button class="btn primary" style="width:auto; padding:8px 16px; border-radius:8px;" onclick="exportPdf3(this)" title="Download a PDF report - straight to your Downloads, no server round trip">Export to PDF</button>
                                                            </div>
                                                        </div>
                                                        <div id="aiSummaryBox3" class="card" style="display:${keepAi ? 'block' : 'none'}; background:var(--accent-muted); border-color:var(--accent);">
                                                            <div class="card-title" style="color:var(--accent);">AI Summary</div>
                                                            <div id="aiSummaryText3" style="font-size:13.5px; line-height:1.6; color:var(--text-primary);">${keepAi || ''}</div>
                                                        </div>
                                                        <div style="display:flex; gap:16px; ${machinesLayout}">
                                                            <div style="flex:1; min-width:340px;">
                                                                ${machineBlock('Machine A', data.a, 'A')}
                                                                ${sideExtra3('Machine A', 'a')}
                                                            </div>
                                                            <div style="flex:1; min-width:340px; ${isPdfExport ? 'break-before: page; page-break-before: always;' : ''}">
                                                                ${machineBlock('Machine B', data.b, 'B')}
                                                                ${sideExtra3('Machine B', 'b')}
                                                            </div>
                                                        </div>
                                                        ${combinedTimelineSection3}
                                                        ${combinedClassTimelineSection3}
                                                        <div id="detailBox3" class="card" style="display:none;">
                                                            <div class="card-title" style="justify-content:flex-start; align-items:center; gap:2px;">
                                                                <button id="detailPrevBtn3" class="icon-btn" style="width:24px; height:24px; flex:0 0 auto;" onclick="navigateDetail3(-1)" title="Previous operation (\u2190)">&#8249;</button>
                                                                <button id="detailNextBtn3" class="icon-btn" style="width:24px; height:24px; flex:0 0 auto; margin-right:8px;" onclick="navigateDetail3(1)" title="Next operation (\u2192)">&#8250;</button>
                                                                <span id="detailTitle3">Operation detail</span>
                                                            </div>
                                                            <div id="detailNotes3" style="font-size:12px; color:var(--text-muted); margin-bottom:10px;"></div>
                                                            <div style="display:flex; gap:14px; flex-wrap:wrap;">
                                                                <div style="flex:1; min-width:280px;" id="detailCurrentChart3"></div>
                                                                <div style="flex:1; min-width:280px;" id="detailVoltageChart3"></div>
                                                            </div>
                                                            <div style="margin-top:10px;">
                                                                <button class="btn" style="width:auto; padding:7px 14px;" onclick="openFeedbackModal3()">\u26a0 Give Feedback</button>
                                                            </div>
                                                        </div>
                                                        <div id="feedbackModal3" class="feedback-modal-overlay" style="display:none;" onclick="if(event.target===this) closeFeedbackModal3()">
                                                            <div class="feedback-modal-box">
                                                                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                                                                    <div style="font-weight:800; font-size:14px;">Feedback</div>
                                                                    <button class="icon-btn" style="width:28px; height:28px;" onclick="closeFeedbackModal3()" title="Close">&#10005;</button>
                                                                </div>
                                                                <div style="font-weight:700; font-size:13px; margin-bottom:6px;">Highlight your region</div>
                                                                <div id="feedbackModalChart3" class="feedback-draw-chart" style="height:220px;"></div>
                                                                <div style="font-size:11px; color:var(--text-muted); margin:8px 0;">Draw a rectangle or circle around the region that looks wrong (optional) - use the toolbar (top-right) to switch shape or erase.</div>
                                                                <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">
                                                                    <button id="shapeUndoBtn3" class="btn" style="width:auto; padding:5px 10px; margin-top:0;" onclick="undoShape3()" title="Undo last drawing change" disabled>\u21b6 Undo</button>
                                                                    <button id="shapeRedoBtn3" class="btn" style="width:auto; padding:5px 10px; margin-top:0;" onclick="redoShape3()" title="Redo" disabled>\u21b7 Redo</button>
                                                                </div>
                                                                <div style="margin-bottom:10px;">
                                                                    <label style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.4px; color:var(--text-muted); display:block; margin-bottom:6px;">This operation is actually:</label>
                                                                    <select id="feedbackLabel3" onchange="onFeedbackLabelChange3()" style="width:auto; display:inline-block; margin-right:8px;">
                                                                        <option value="Normal">Normal</option>
                                                                        <option value="Abnormal">Abnormal</option>
                                                                    </select>
