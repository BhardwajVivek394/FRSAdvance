                                            <input class="form-control" id="monthlyRefTime" type="datetime-local">
                                        </div>
                                        <div style="flex:0 0 auto; display:flex; align-items:flex-end; gap:8px;">
                                            <button class="btn btn-primary" id="monthlyUpdateBtn" onclick="analyzeMonthlyHealth(true)" title="Always re-fetches and re-analyzes right now, ignoring any cache">
                                                <svg viewBox="0 0 24 24"><path d="M3 3v18h18M7 14l4-4 3 3 5-6" /></svg>
                                                Fetch &amp; Compute
                                            </button>
                                        </div>
                                    </div>

                                    <div id="monthlyLoading" style="display:none; text-align:center; padding:40px 20px;">
                                        <span class="spinner" style="width:28px; height:28px;"></span>
                                        <div id="monthlyLoadingText" style="margin-top:12px; color:var(--text-secondary); font-weight:600;">Predicting&hellip; please wait</div>
                                    </div>

                                    <div id="monthlyResults" style="display:none;">
                                        <div style="display:flex; justify-content:flex-end; gap:8px; margin-bottom:10px;">
                                            <button class="btn" id="monthlyExportJsonBtn" onclick="exportMonthlyJson()" title="Download this machine's monthly health summary as JSON">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                                                Export JSON
                                            </button>
                                            <button class="btn" id="monthlyExportPdfBtn" onclick="exportMonthlyPdf(this)" title="Download a full PDF report with the health timeline chart">
                                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="9" y1="15" x2="15" y2="15" /></svg>
                                                Export PDF
                                            </button>
                                        </div>
                                        <div id="aiSummaryCard" style="display:none; margin-bottom:12px; padding:12px 14px; background:var(--accent-muted); border-left:3px solid var(--accent); border-radius:0 8px 8px 0;">
                                            <div style="font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:0.4px; color:var(--accent); margin-bottom:6px;">AI Summary</div>
                                            <div id="aiSummaryText" style="font-size:12.5px; line-height:1.6; color:var(--text-primary); white-space:pre-line;"></div>
                                        </div>

                                        <div id="monthlySummary"></div>

                                        <div id="monthlyTimeline" style="width:100%; min-height:260px; margin-top:12px;"></div>

                                        <details style="margin-top:10px; font-size:12px;">
                                            <summary style="cursor:pointer; color:var(--text-secondary); font-weight:700;">Fault types &mdash; what they mean</summary>
                                            <div id="faultLegend" style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:6px 20px; margin-top:10px; color:var(--text-secondary);"></div>
                                        </details>

                                        <div id="monthlyDetail" style="display:none; margin-top:14px;"></div>
                                    </div>

                                    <div id="monthlyEmpty" style="color:var(--text-muted); font-size:13px; padding:8px 0;">
                                        Select a Point machine and wave type, then click "Analyze Last 30 Days".
                                    </div>
                                </div>

                            </div>
                        </div>
                    </section>
                </div>
            </div>

            <div class="toast-box" id="toastBox"></div>

            <script>
                (function () {
                    // Shared file:// fallback is computed once, at the top level, outside every
                    // IIFE (see window.__PM_API_BASE near the top of this document) - reused here
                    // instead of redoing the detection independently in this app's own closure.
                    // endpoints injected

                    const S = {
                        theme: localStorage.getItem('pm-theme') || 'light',
                        waveType: 'Both',
                        sites: [],
                        pointMachines: [],       // [{assetId, assetName, tags: [...], currentTag, voltageTag}]
                        selectedAsset: null,
                        charts: {},
                        recentReadings: [],  // [{time, aCur, aVolt, bCur, bVolt, aPrediction, bPrediction}], most recent first
                        // Which reading (idx) and which signal(s) are currently expanded inline, per table.
                        inlineSelection: { A: { idx: null, current: false, voltage: false }, B: { idx: null, current: false, voltage: false } }
                    };

                    function getActiveWaveTypes() {
                        if (S.waveType === 'Both') {
                            // Ground truth: Asset.IsThickWave/ThickWaveTypeId, fetched per-asset in
                            // fetchPointMachines() via /api/asset-wavetype (a direct DB read - every
                            // REST endpoint we tried returns this field as null regardless of its
                            // real value). Two assets named e.g. "107" and "108" are frequently
                            // separate Asset rows with independently set IsThickWave, so this is
                            // never assumed shared across a naming pair - AND the A-end/B-end of
                            // the SAME asset can themselves be different wave types
                            // (Asset.ThickWaveTypeId: 1=A-TWS/B-IRS, 2=B-TWS/A-IRS, 3=Both-TWS),
                            // so each side is resolved (and modeled) independently instead of one
                            // shared value for the whole asset.
                            //
                            // NEVER default to a guessed wave type here - this used to fall back to
                            // 'TWS' whenever the lookup hadn't resolved yet, and since the TWS model
                            // is always loaded, every caller's "is a model loaded?" check passed and
                            // silently scored IRS strokes with the TWS model. Confirmed in production:
                            // every prediction on declared-IRS assets came back wave_type "TWS".
                            // Returning null instead forces every caller to explicitly refuse to
                            // predict rather than guess.
                            const pm = S.selectedAsset;
                            return { a: (pm && pm.aWaveType) || null, b: (pm && pm.bWaveType) || null };
                        }
                        // Manual TWS/IRS override forces BOTH sides onto the same model (useful for
                        // testing/comparison) - per-side ground truth only applies under "Both".
                        return { a: S.waveType, b: S.waveType };
                    }

                    // Human-readable badge text for a {a,b} wave-type pair - shows "A:TWS / B:IRS"
                    // when the two sides genuinely differ, instead of implying one shared type.
                    function waveTypesLabel(waves) {
                        if (!waves.a && !waves.b) return 'Unknown';
                        if (waves.a === waves.b) return waves.a || 'Unknown';
                        return `A:${waves.a || '?'} / B:${waves.b || '?'}`;
                    }

                    // Which of TWS/IRS models are actually needed for a {a,b} pair, and whether
                    // every needed one is loaded in modelBundle.
                    function neededWaves(waves) { return [...new Set([waves.a, waves.b].filter(Boolean))]; }
                    function modelsReadyFor(waves) {
                        const need = neededWaves(waves);
                        return need.length > 0 && need.every(w => !!modelBundle[w]);
                    }

                    document.addEventListener('DOMContentLoaded', async () => {
                        applyTheme();
                        document.getElementById('themeBtn').onclick = () => {
                            S.theme = S.theme === 'dark' ? 'light' : 'dark';
                            localStorage.setItem('pm-theme', S.theme);
                            applyTheme();
                        };
                        initModels();
                        loadSites();
                    });

                    function applyTheme() {
                        // Scoped CSS lives under #model1-wrap (see [data-theme="dark"] in the
                        // merged stylesheet, prefixed to "#model1-wrap[data-theme=\"dark\"]"), so
                        // the attribute is set on that wrapper div instead of document.body.
                        document.getElementById('model1-wrap').setAttribute('data-theme', S.theme);
                        document.getElementById('themeIcon').innerHTML = S.theme === 'dark'
                            ? '<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>'
                            : '<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>';
                    }

                    function toast(msg, type) {
                        const t = document.createElement('div');
                        t.className = `toast ${type || ''}`;
                        t.textContent = msg;
                        document.getElementById('toastBox').appendChild(t);
                        setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 200); }, 2600);
                    }

                    // Re-run predictions for already-loaded recent readings against the newly
                    // selected wave type's model, so the readings table doesn't keep showing
                    // stale labels computed under the previous TWS/IRS/Both selection.
                    async function recomputeRecentReadingsPredictions() {
                        if (!S.recentReadings.length) return;
                        const waves = getActiveWaveTypes();
                        if (modelLoaded && modelsReadyFor(waves)) {
                            try { await applyPredictionsToReadings(waves); }
                            catch (e) { console.error('Recompute predictions failed for new wave type', e); }
                        } else {
                            S.recentReadings.forEach(r => { r.aPrediction = null; r.bPrediction = null; });
                        }
                        renderReadingsTable();
                    }

                    function getPredictUrl() { return ''; }

                    // ==================== HISTORIAN CONNECTION ====================
                    // The browser never talks to the Historian directly - every call here goes
                    // through our own /api/historian/* proxy, so the Historian host/port is
                    // never shipped to the frontend at all.

                    async function loadSites() {
                        const url = PM_ENDPOINTS.sites;
                        try {
                            const r = await fetch(url);
                            if (!r.ok) throw new Error(`HTTP ${r.status}`);
                            const sites = await r.json();
                            S.sites = sites;
                            const select = document.getElementById('siteSelect');
                            select.innerHTML = '<option value="">-- Select Site --</option>';
                            sites.sort((a, b) => (a.SiteName || '').localeCompare(b.SiteName || ''));
                            sites.forEach(s => {
                                const opt = document.createElement('option');
                                opt.value = s.SiteId;
                                opt.textContent = `${s.SiteName} (${s.SiteId})`;
                                select.appendChild(opt);
                            });
                            setHistorianStatus('ok', `Historian: connected (${sites.length} sites)`);
                            toast(`${sites.length} sites loaded`, 'success');
                        } catch (e) {
                            setHistorianStatus('err', 'Historian: connection failed');
                            toast('Load sites failed: ' + e.message, 'error');
                        }
                    }

                    function onSiteChange() {
                        if (document.getElementById('siteSelect').value) fetchPointMachines();
                    }

                    function toggleSidebar(forceCollapsed) {
                        const sidebar = document.querySelector('#model1-wrap .sidebar');
                        const toggleBtn = document.getElementById('sidebar-toggle-btn');
                        if (!sidebar) return;
                        const isCollapsed = typeof forceCollapsed === 'boolean'
                            ? (sidebar.classList.toggle('collapsed', forceCollapsed), forceCollapsed)
                            : sidebar.classList.toggle('collapsed');
                        if (toggleBtn) {
                            toggleBtn.title = isCollapsed ? 'Expand Sidebar' : 'Collapse Sidebar';
                            toggleBtn.classList.toggle('collapsed-active', isCollapsed);
                        }
                        setSidebarCssWidth('model1-wrap', isCollapsed ? 64 : getSavedSidebarWidth());
                        setTimeout(() => window.dispatchEvent(new Event('resize')), 300);
                    }

                    function updateCompactSidebar1() {
                        const quickIcon = document.getElementById('compact-mode-quick1');
                        const customIcon = document.getElementById('compact-mode-custom1');
                        if (quickIcon && customIcon) {
                            const isCustom = currentAnalysisMode === 'custom';
                            quickIcon.style.display = isCustom ? 'none' : 'block';
                            customIcon.style.display = isCustom ? 'block' : 'none';
                        }
                        const badge = document.getElementById('compact-pm-badge1');
                        if (badge) {
                            const pm = S.selectedAsset;
                            setCompactBadgeText(badge, pm && pm.assetName);
                            badge.title = pm ? pm.assetName : 'No point machine selected';
                        }
                    }

                    // No header indicator for this anymore (Historian connectivity is implied by
                    // whether Fetch Point Machines/loadSites succeed - toast() already surfaces
                    // failures) - kept as a no-op so existing call sites don't need to change.
                    function setHistorianStatus(state, text) { }

                    function setPredictStatus(state, text) {
                        const dot = document.getElementById('predictDot');
                        dot.className = 'status-dot' + (state === 'ok' ? ' ok' : state === 'err' ? ' err' : '');
                        document.getElementById('predictStatusText').textContent = text;
                    }

                    async function fetchPointMachines() {
                        const siteId = document.getElementById('siteSelect').value;
                        if (!siteId) return toast('Select a site first', 'error');
                        S.currentSiteId = siteId;

                        const btn = document.getElementById('fetchPmBtn');
                        btn.disabled = true;
                        const pmTypeId = '3';
                        document.getElementById('pmList').innerHTML = '<div style="text-align:center; padding:24px 0;"><span class="spinner"></span><div style="margin-top:8px; color:var(--text-secondary); font-size:12px;">Fetching point machines\u2026</div></div>';

                        try {
                            const url = `${PM_ENDPOINTS.liveValue}?SiteId=${encodeURIComponent(siteId)}`;
                            const r = await fetch(url);
                            if (!r.ok) throw new Error(`HTTP ${r.status}`);
                            const tags = await r.json();
                            if (!Array.isArray(tags)) throw new Error('Unexpected response shape');

                            // Filter to Point Machine asset type, group by AssetId
                            const assets = new Map();
                            tags.forEach(t => {
                                if (String(t.AssetTypeId) !== pmTypeId) return;
                                const assetName = t.AssetName || `Asset ${t.AssetId}`;
                                const assetId = t.AssetId;
                                if (!assets.has(assetId)) {
                                    assets.set(assetId, { assetId, assetName, tags: [] });
                                }
                                assets.get(assetId).tags.push(t);
                            });

                            S.pointMachines = Array.from(assets.values());

                            renderPmList();
                            setHistorianStatus('ok', `Historian: connected (${S.pointMachines.length} point machines)`);
                            toast(`${S.pointMachines.length} point machine assets found`, 'success');

                            loadAssetWaveTypes(siteId);
                        } catch (e) {
                            document.getElementById('pmList').innerHTML = '';
                            setHistorianStatus('err', 'Historian: fetch failed');
                            toast('Fetch failed: ' + e.message, 'error');
                        }
                        btn.disabled = false;
                    }

                    // Ground truth for TWS/IRS per asset: Asset.IsThickWave/ThickWaveTypeId, via
                    // /api/asset-wavetype (a direct DB read - see ../../app.py for why the REST APIs
                    // can't be used for this). Two assets named e.g. "107" and "108" can be entirely
                    // separate Asset rows with independently set IsThickWave, so this is looked up
                    // per AssetId, never shared - and the endpoint now resolves EACH SIDE (A/B) of
                    // one asset separately too, since ThickWaveTypeId can make them differ.
                    async function loadAssetWaveTypes(siteId) {
                        try {
                            const r = await fetch(`${PM_ENDPOINTS.assetWaveType}?SiteId=${encodeURIComponent(siteId)}`);
                            if (!r.ok) throw new Error(`HTTP ${r.status}`);
                            const meta = await r.json();
                            const byId = new Map(meta.map(m => [String(m.AssetId), m]));
                            S.pointMachines.forEach(pm => {
                                const m = byId.get(String(pm.assetId));
                                pm.aWaveType = m ? m.AWaveType : null;
                                pm.bWaveType = m ? m.BWaveType : null;
                                pm.mixedWaveType = !!(m && m.Mixed);
                            });
                        } catch (e) {
                            console.error('Failed to load asset-wavetype metadata', e);
                            S.pointMachines.forEach(pm => { pm.aWaveType = null; pm.bWaveType = null; pm.mixedWaveType = false; });
                        }
                        renderPmList();
                        if (S.waveType === 'Both') {
                            onWaveModelSwitch(getActiveWaveTypes());
                            recomputeRecentReadingsPredictions();
                        }
                    }

                    function renderPmList() {
                        const list = document.getElementById('pmList');

                        // Rebuilding these options wipes whatever was selected, so re-derive the
                        // selection from S.selectedAsset every time - otherwise an async re-render
                        // (e.g. wave-type resolution finishing after the user already picked a
                        // machine) silently resets the dropdown back to blank.
                        const selectedIdx = S.selectedAsset ? S.pointMachines.indexOf(S.selectedAsset) : -1;
                        const pmSelect = document.getElementById('mh-custom-pm-select');
                        if (pmSelect) {
                            pmSelect.innerHTML = '<option value="">-- Select --</option>' +
                                S.pointMachines.map((pm, i) => `<option value="${i}">${pm.assetName}</option>`).join('');
                            if (selectedIdx >= 0) pmSelect.value = String(selectedIdx);
                        }
                        const quickSelect = document.getElementById('quick-pm-select');
                        if (quickSelect) {
                            quickSelect.innerHTML = '<option value="">-- Select --</option>' +
                                S.pointMachines.map((pm, i) => `<option value="${i}">${pm.assetName}</option>`).join('');
                            if (selectedIdx >= 0) quickSelect.value = String(selectedIdx);
                        }

                        // Filters by the real per-asset ground truth (Asset.IsThickWave/ThickWaveTypeId,
                        // via /api/asset-wavetype) - not by name matching, which we confirmed doesn't
                        // reliably encode wave type (e.g. "0118-DL-23276" tells you nothing). An asset
                        // whose A/B sides differ (mixedWaveType) matches EITHER the TWS or IRS filter,
                        // since it genuinely has a machine of each type on it. Assets whose wave-type
                        // lookup hasn't resolved yet (undefined) or failed (null on both sides) only
                        // show under "Both", since we can't say which filter they belong in.
                        const filtered = S.pointMachines.filter(pm => {
                            if (S.waveType === 'Both') return true;
                            return pm.aWaveType === S.waveType || pm.bWaveType === S.waveType;
                        });

                        document.getElementById('pmCount').textContent = filtered.length;

                        if (S.pointMachines.length === 0) {
                            list.innerHTML = '<div class="empty-msg">No Point Machine assets found for this site with the current AssetTypeId filter.</div>';
                            return;
                        }

                        if (filtered.length === 0) {
                            const stillLoading = S.pointMachines.some(pm => pm.aWaveType === undefined);
                            list.innerHTML = `<div class="empty-msg">${stillLoading ? 'Loading wave-type info...' : `No assets match the "${S.waveType}" filter.`}</div>`;
                            return;
                        }

                        list.innerHTML = filtered.map((pm) => {
                            const originalIndex = S.pointMachines.indexOf(pm);
                            let waveChip;
                            if (pm.mixedWaveType) {
                                waveChip = `<span class="pm-chip ready" style="background:#fef3c7; color:#92400e;" title="This asset has DIFFERENT wave types per side">A:${pm.aWaveType} / B:${pm.bWaveType}</span>`;
                            } else if (pm.aWaveType || pm.bWaveType) {
                                waveChip = `<span class="pm-chip ready" style="background:var(--accent-muted); color:var(--accent);">${pm.aWaveType || pm.bWaveType}</span>`;
                            } else if (pm.aWaveType === null && pm.bWaveType === null) {
                                waveChip = `<span class="pm-chip missing">wave type unknown</span>`;
                            } else {
                                waveChip = '';
                            }
                            return `<div class="pm-item ${S.selectedAsset && S.selectedAsset.assetId === pm.assetId ? 'active' : ''}" onclick="selectPointMachine(${originalIndex})">
                                                                    <div class="pm-name">${pm.assetName}</div>
                                                                    <div class="pm-meta">${pm.tags.length} tags</div>
                                                                    <div class="pm-tags">
                                                                        ${waveChip}
                                                                    </div>
                                                                </div>`;
                        }).join('');
                    }

                    function selectPointMachine(idx) {
                        S.selectedAsset = S.pointMachines[idx];
                        renderPmList();
                        const pmSelect = document.getElementById('mh-custom-pm-select');
                        if (pmSelect) pmSelect.value = String(idx);
                        const quickSelect = document.getElementById('quick-pm-select');
                        if (quickSelect) quickSelect.value = String(idx);
                        document.getElementById('emptyState').style.display = 'none';
                        document.getElementById('mainView').style.display = 'flex';
                        document.getElementById('assetTitle').textContent = S.selectedAsset.assetName;
                        document.getElementById('assetBreadcrumb').textContent = S.selectedAsset.assetName;
                        document.getElementById('assetSub').style.display = 'none';
                        // Badge must reflect THIS asset's actual model wave type(s) (from
                        // Asset.IsThickWave/ThickWaveTypeId, per side), not just the last wave-type
                        // filter button clicked - it was previously only updated by setWaveType(),
                        // so it kept showing a stale/placeholder value after switching assets while
                        // the "Both" filter was active.
                        document.getElementById('waveBadge').textContent = waveTypesLabel(getActiveWaveTypes());
                        if (S.waveType === 'Both') onWaveModelSwitch(getActiveWaveTypes());
                        resetReadingsRefTime();
                        document.getElementById('abStrokeCard').style.display = 'none'; // stale data from the previous asset
                        // New asset \u2014 clear old monthly analysis and immediately auto-analyze
                        // (user does not need to click "Analyze Last 30 Days" again).
                        document.getElementById('monthlyResults').style.display = 'none';
                        document.getElementById('monthlyDetail').style.display = 'none';
                        document.getElementById('aiSummaryCard').style.display = 'none';
                        document.getElementById('monthlyHealthSub').textContent = 'Last 30 days';
                        updateCompactSidebar1();
                        const sidebarEl1 = document.querySelector('#model1-wrap .sidebar');
                        if (sidebarEl1 && !sidebarEl1.classList.contains('collapsed')) toggleSidebar(true);
                        analyzeMonthlyHealth();
                    }

                    function resetReadingsRefTime() {
                        const el = document.getElementById('readingsRefTime');
                        if (el && !el.value) el.value = toLocalISO(new Date());
                        const mel = document.getElementById('monthlyRefTime');
                        if (mel && !mel.value) mel.value = toLocalISO(new Date());
                    }

                    function toLocalISO(d) { return new Date(d - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16); }

                    function parseArrayValue(raw) {
                        if (raw == null) return [];
                        if (Array.isArray(raw)) {
                            // Some records wrap the field like ["[11.3,32.0,...,0.0,]\r\n"] \u2014
                            // a single string which itself is a bracketed CSV. Unwrap and parse it.
                            if (raw.length === 1 && typeof raw[0] === 'string') return parseArrayValue(raw[0]);
                            // NaN filter necessary: otherwise NaN -> JSON null -> backend List[float] throws 422.
                            return raw.map(Number).filter(Number.isFinite);
                        }
                        if (typeof raw === 'string') {
                            // Clean up surrounding [ ], stray CR/LF, and trailing comma.
                            let s = raw.trim();
                            if (s.startsWith('[')) s = s.slice(1);
                            if (s.endsWith(']')) s = s.slice(0, -1);
                            s = s.replace(/[\r\n]+/g, '');
                            // Real format from this Historian: comma-separated numbers ("0,1.5,3.8,...")
                            if (s.includes(',')) {
                                return s.split(',').map(v => parseFloat(v)).filter(Number.isFinite);
                            }
                            // Fallback: JSON array string, warna single number.
                            try {
                                const parsed = JSON.parse(raw);
                                return Array.isArray(parsed) ? parsed.map(Number).filter(Number.isFinite) : [];
                            } catch (e) {
                                const n = parseFloat(s);
                                return Number.isFinite(n) ? [n] : [];
                            }
                        }
                        return [];
                    }

                    // Combined-asset names follow "<prefix><numA>/<numB><suffix>" (e.g. "107/108",
                    // "PT-101/102", "PT 107/108") - split on that to label the A/B columns with
                    // their real machine numbers instead of the generic "A"/"B". Falls back to
                    // "A"/"B" for names that don't follow this pattern (e.g. "PT101A/B", or plain
                    // single-machine names like "54") - those are still genuinely a single unit.
                    function getAbLabels(pm) {
                        const name = (pm && pm.assetName) || '';
                        const m = name.match(/^(.*?)(\d+)\s*\/\s*(\d+)([^/]*)$/);
                        if (m) {
                            const [, prefix, numA, numB, suffix] = m;
                            return { labelA: `${prefix}${numA}${suffix}`.trim(), labelB: `${prefix}${numB}${suffix}`.trim() };
                        }
                        return { labelA: 'A', labelB: 'B' };
                    }

                    // ==================== A/B STROKE (two separate machines under one Asset) ====================
                    // "107" and "108" (or "A End"/"B End") are frequently two independent physical
                    // point machines whose data is polled together under one AssetId. The generic
                    // LiveValue/HistoryValue tag groups (numeric ids 1-9) carry no A/B labeling, so
                    // this reads PointMachineData/GetBy's PointMachineJson directly, which splits
                    // stroke arrays into A_C/A_V (side A) and B_C/B_V (side B) per record.
                    // Loads the A/B stroke split into the card. Only ever called from an explicit
                    // user action (the per-reading "Plot" button, or the card's own "Refresh"
                    // button) - never automatically on selection, so nothing plots itself without
                    // a click. targetTime is optional: omit it for "closest to now" (the Refresh
                    // button's behavior), or pass a specific reading's timestamp to show that
                    // reading's A/B split instead (the per-row "Plot" button's behavior).
                    function extractAbArrays(rec) {
                        let pmj = rec.PointMachineJson;
                        if (typeof pmj === 'string') { try { pmj = JSON.parse(pmj); } catch (e) { pmj = null; } }
                        if (Array.isArray(pmj)) pmj = pmj[0];
                        if (!pmj || typeof pmj !== 'object') return null;
                        return {
                            aCur: parseArrayValue(pmj.A_C), aVolt: parseArrayValue(pmj.A_V),
                            bCur: parseArrayValue(pmj.B_C), bVolt: parseArrayValue(pmj.B_V)
                        };
                    }

                    // Renders already-known A/B stroke data into the card - no fetch. Used by
                    // loadAbStroke() (its "Load latest" button) after it fetches the latest record.
                    // signalType: 'both' (default), 'current', or 'voltage' - controls which of the
                    // two chart rows per side are visible. The prediction badges always use both
                    // signals regardless (the model needs current+voltage together), only the
                    // charts themselves get filtered down to what the user actually clicked.
                    function renderAbCard(time, arrays, signalType) {
                        const pm = S.selectedAsset;
                        const card = document.getElementById('abStrokeCard');
                        if (!pm || !arrays) { card.style.display = 'none'; return; }
                        const { aCur, aVolt, bCur, bVolt } = arrays;
                        const mode = signalType || 'both';

                        card.style.display = 'flex';
                        const { labelA, labelB } = getAbLabels(pm);
                        document.getElementById('abALabel').textContent = labelA;
                        document.getElementById('abBLabel').textContent = labelB;
                        const timeLabel = time ? (time instanceof Date ? time.toLocaleString() : String(time)) : '--';
                        document.getElementById('abBTime').textContent = timeLabel;
                        document.getElementById('abATime').textContent = timeLabel;

                        const showCurrent = mode !== 'voltage';
                        const showVoltage = mode !== 'current';
                        document.getElementById('abBCurrentBox').style.display = showCurrent ? 'block' : 'none';
                        document.getElementById('abACurrentBox').style.display = showCurrent ? 'block' : 'none';
                        document.getElementById('abBVoltageBox').style.display = showVoltage ? 'block' : 'none';
                        document.getElementById('abAVoltageBox').style.display = showVoltage ? 'block' : 'none';

                        const dk = S.theme === 'dark';
                        const grid = dk ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
                        const txt = dk ? '#a0aab5' : '#4a5060';
                        const curColor = getComputedStyle(document.getElementById('model1-wrap')).getPropertyValue('--current-color').trim();
                        const voltColor = getComputedStyle(document.getElementById('model1-wrap')).getPropertyValue('--voltage-color').trim();

                        if (showCurrent) {
                            // Plotly area chart (14-Aug-2026), same visual style/toolbar as Model
                            // 2's lineChart() - kept as its OWN function (plotCurrentM1, below) so
                            // Model 2's lineChart() stays completely untouched, per its own name.
                            plotCurrentM1('abBCurrentChart', bCur, `${labelB} - Current (A)`, 150);
                            plotCurrentM1('abACurrentChart', aCur, `${labelA} - Current (A)`, 150);
                        }
                        if (showVoltage) {
                            plotCurrentM1('abBVoltageChart', bVolt, `${labelB} - Voltage (V)`, 150, '#0d9488');
                            plotCurrentM1('abAVoltageChart', aVolt, `${labelA} - Voltage (V)`, 150, '#0d9488');
                        }

                        // A and B can be DIFFERENT wave types (Asset.ThickWaveTypeId picks which
                        // side is TWS) - see getActiveWaveTypes()/loadAssetWaveTypes() - so each
                        // side is predicted against its own model, not one shared model for both.
                        const waves = getActiveWaveTypes();
                        setAbPredBadge('A', null);
                        setAbPredBadge('B', null);
                        if (modelLoaded && waves.a && modelBundle[waves.a]) {
                            predictBatch(waves.a, [{ current: aCur, voltage: aVolt }])
                                .then(preds => setAbPredBadge('A', (aCur.length || aVolt.length) ? preds[0] : null))
                                .catch(e => console.error('A badge prediction failed', e));
                        }
                        if (modelLoaded && waves.b && modelBundle[waves.b]) {
                            predictBatch(waves.b, [{ current: bCur, voltage: bVolt }])
                                .then(preds => setAbPredBadge('B', (bCur.length || bVolt.length) ? preds[0] : null))
                                .catch(e => console.error('B badge prediction failed', e));
                        }
                    }

                    async function loadAbStroke(targetTime) {
                        const pm = S.selectedAsset;
                        const card = document.getElementById('abStrokeCard');
                        if (!pm || !S.currentSiteId) { card.style.display = 'none'; return; }
                        const target = targetTime instanceof Date ? targetTime : new Date();

                        try {
                            const start = new Date(target.getTime() - 7 * 24 * 3600 * 1000);
                            const end = new Date(target.getTime() + 24 * 3600 * 1000);
                            const fmt = d => d.toISOString().slice(0, 19);
                            const url = `${PM_ENDPOINTS.pmData}?SiteId=${encodeURIComponent(S.currentSiteId)}&AssetId=${encodeURIComponent(pm.assetId)}`
                                + `&StartDate=${encodeURIComponent(fmt(start))}&EndDate=${encodeURIComponent(fmt(end))}`;
                            const r = await fetch(url);
                            if (!r.ok) throw new Error(`HTTP ${r.status}`);
                            const records = await r.json();
                            if (!Array.isArray(records) || !records.length) {
                                card.style.display = 'none';
                                toast('No PointMachineData records found for this asset/time', 'error');
                                return;
                            }

                            // The live API doesn't reliably filter its response to just this AssetId
                            // (confirmed - it can return ONLY neighboring assets' records under this
                            // AssetId's query), so filter strictly and refuse rather than plot the
                            // wrong machine's data.
                            const own = records.filter(rec => String(rec.AssetId) === String(pm.assetId));
                            if (!own.length) {
                                card.style.display = 'none';
                                toast('No PointMachineData records tagged with this AssetId in range (live API duplicate-payload bug, or genuinely no data)', 'error');
                                return;
                            }
                            // Closest record to the target time, not just the most recent overall -
                            // matters when plotting an older reading rather than "now".
                            own.sort((a, b) =>
                                Math.abs(new Date(a.TimeStamp || a.TsTime || 0) - target) - Math.abs(new Date(b.TimeStamp || b.TsTime || 0) - target));
                            const rec = own[0];

                            const arrays = extractAbArrays(rec);
                            if (!arrays) { card.style.display = 'none'; return; }
                            renderAbCard(rec.TimeStamp || rec.TsTime, arrays, 'both');
                        } catch (e) {
                            console.error('Could not load A/B stroke', e);
                            card.style.display = 'none';
                        }
                    }

                    function setAbPredBadge(side, result) {
                        const badge = document.getElementById(`ab${side}PredBadge`);
                        const label = document.getElementById(`ab${side}PredLabel`);
                        if (!result) { badge.className = 'pred-badge pending'; label.textContent = 'No stroke data'; return; }
                        const isAbnormal = result.label === 'Abnormal';
                        badge.className = 'pred-badge ' + (isAbnormal ? 'abnormal' : 'normal');
                        label.textContent = `${result.label} (${result.confidence}%)`;
                    }

                    // ==================== RECENT READINGS (last 10, up to a reference time) ====================
                    // Sourced from PointMachineData/GetBy (via /api/pmdata) rather than the generic
                    // Historian tag history - that's the only source that splits a stroke into its
                    // A and B sides (PointMachineJson's A_C/A_V vs B_C/B_V), which combined assets
                    // like "107/108" need to show as genuinely separate machines, not one channel.

                    function setReadingsLoadingState(html) {
                        document.getElementById('readingsBodyA').innerHTML = html;
                        document.getElementById('readingsBodyB').innerHTML = html;
                    }

                    async function loadRecentReadings() {
                        const pm = S.selectedAsset;
                        if (!pm) return;
                        const { labelA, labelB } = getAbLabels(pm);
                        document.getElementById('readingsTagsLabel').textContent = `${labelA} / ${labelB}`;
                        document.getElementById('readingsLabelA').textContent = labelA;
                        document.getElementById('readingsLabelB').textContent = labelB;

                        const refInput = document.getElementById('readingsRefTime').value;
                        const refTime = refInput ? new Date(refInput) : new Date();

                        setReadingsLoadingState(`<tr><td colspan="7" style="text-align:center;"><span class="spinner"></span> Loading...</td></tr>`);

                        try {
                            const start = new Date(refTime.getTime() - 60 * 24 * 3600 * 1000); // look back up to 60 days
                            const fmt = d => d.toISOString().slice(0, 19);
                            const url = `${PM_ENDPOINTS.pmData}?SiteId=${encodeURIComponent(S.currentSiteId)}&AssetId=${encodeURIComponent(pm.assetId)}`
                                + `&StartDate=${encodeURIComponent(fmt(start))}&EndDate=${encodeURIComponent(fmt(refTime))}`;
                            const r = await fetch(url);
                            if (!r.ok) throw new Error(`HTTP ${r.status}`);
                            const records = await r.json();
                            if (!Array.isArray(records)) throw new Error('Unexpected response shape');

                            // The live API doesn't reliably filter its response to just this AssetId
                            // (confirmed - it can return ONLY neighboring assets' records under this
                            // AssetId's query), so filter strictly and refuse rather than show the
                            // wrong machine's readings.
                            const own = records.filter(rec => String(rec.AssetId) === String(pm.assetId));
                            const pick = own
                                .map(rec => ({ rec, time: new Date(rec.TimeStamp || rec.TsTime || 0) }))
                                .filter(x => !isNaN(x.time.getTime()) && x.time <= refTime)
                                .sort((a, b) => b.time - a.time)
                                .slice(0, 10);

                            S.inlineSelection.A = { idx: null, current: false, voltage: false };
                            S.inlineSelection.B = { idx: null, current: false, voltage: false };
                            if (!pick.length) {
                                setReadingsLoadingState(`<tr><td colspan="7" style="color:var(--text-muted); text-align:center;">No historical readings found for this asset up to that time</td></tr>`);
                                S.recentReadings = [];
                                return;
                            }

                            const activeWaves = getActiveWaveTypes();
                            S.recentReadings = pick.map(({ rec, time }) => {
                                const arrays = extractAbArrays(rec) || { aCur: [], aVolt: [], bCur: [], bVolt: [] };
                                return { time, ...arrays, aPrediction: null, bPrediction: null };
                            });

                            renderReadingsTable();  // show rows immediately; predictions fill in next
                            if (modelLoaded && modelsReadyFor(activeWaves)) {
                                try {
                                    await applyPredictionsToReadings(activeWaves);
                                    renderReadingsTable();
                                    toast(`Loaded ${S.recentReadings.length} readings`, 'success');
                                } catch (e) {
                                    console.error('Batch prediction failed for readings', e);
                                    toast(`Loaded ${S.recentReadings.length} readings, but prediction failed: ${e.message}`, 'error');
                                }
                            } else {
                                toast(`Loaded ${S.recentReadings.length} readings, but no model is loaded for ${waveTypesLabel(activeWaves)} yet - conditions will show as pending`, 'error');
                            }
                        } catch (e) {
                            setReadingsLoadingState(`<tr><td colspan="7" style="color:var(--abnormal); text-align:center;">Failed to load: ${e.message}</td></tr>`);
                            toast('Could not load recent readings: ' + e.message, 'error');
                        }
                    }

                    function predictionCell(p) {
                        if (!p) return { label: '<span style="color:var(--text-muted);">pending</span>', confidence: '--', sub: '--' };
                        const badgeClass = p.label === 'Abnormal' ? 'abnormal' : 'normal';
                        const label = `<span class="hist-badge ${badgeClass}">${p.label}</span>`;
                        const confidence = `${p.confidence}%`;
                        let sub = '--';
                        if (p.label === 'Abnormal') {
                            const typeChips = (p.types || []).map(t => `<span class="fault-chip" style="font-size:9px; padding:2px 7px;">${t.type}</span>`).join(' ');
                            sub = `<span class="fault-chip" style="font-size:9px; padding:2px 7px; background:var(--bg-tertiary); color:var(--text-secondary);">${p.component || 'C'}</span> ${typeChips}`;
                        }
                        return { label, confidence, sub };
                    }

                    function avgValue(arr) {
                        return (arr && arr.length) ? arr.reduce((sum, v) => sum + v, 0) / arr.length : null;
                    }

                    function signalCell(idx, value, signalType, side, unit, decimals) {
                        if (value == null) return '<span style="color:var(--text-muted);">--</span>';
                        const sel = S.inlineSelection[side];
                        const active = sel.idx === idx && sel[signalType];
                        return `<a href="#" class="signal-link${active ? ' active' : ''}" onclick="toggleSignal(${idx}, '${side}', '${signalType}'); return false;">${value.toFixed(decimals)}${unit}</a>`;
                    }

                    function renderReadingsTable() {
                        if (!S.recentReadings.length) {
                            setReadingsLoadingState(`<tr><td colspan="7" style="color:var(--text-muted); text-align:center;">No readings loaded yet</td></tr>`);
                            return;
                        }
                        const row = (i, time, p, cur, volt, side) => {
                            const c = predictionCell(p);
                            return `<tr>
                                                                    <td>${i + 1}</td>
                                                                    <td>${time.toLocaleString()}</td>
                                                                    <td>${c.label}</td>
                                                                    <td>${c.confidence}</td>
                                                                    <td>${c.sub}</td>
                                                                    <td>${signalCell(i, avgValue(cur), 'current', side, 'A', 2)}</td>
                                                                    <td>${signalCell(i, avgValue(volt), 'voltage', side, 'V', 1)}</td>
                                                                </tr>`;
                        };
                        document.getElementById('readingsBodyA').innerHTML = S.recentReadings.map((r, i) => row(i, r.time, r.aPrediction, r.aCur, r.aVolt, 'A')).join('');
                        document.getElementById('readingsBodyB').innerHTML = S.recentReadings.map((r, i) => row(i, r.time, r.bPrediction, r.bCur, r.bVolt, 'B')).join('');

                        // The table body was just rebuilt from scratch, so re-insert any inline
                        // chart row that was already open before this re-render (e.g. from a
                        // wave-type switch triggering recomputeRecentReadingsPredictions()).
                        ['A', 'B'].forEach(side => {
                            const sel = S.inlineSelection[side];
                            if (sel.idx != null && (sel.current || sel.voltage)) renderInlineChartRow(side, sel.idx, sel);
                        });
                    }

                    // Clicking Current/Voltage expands a chart directly under the clicked row,
                    // instead of jumping to the shared Stroke A/B card further down the page.
                    // Clicking a signal already selected on the active row toggles it off; if both
                    // current and voltage end up selected for the same row, both stack together
                    // (current on top, voltage below) rather than one replacing the other.
                    // Switching to a different row resets the selection to just what was clicked.
                    function toggleSignal(idx, side, signalType) {
                        const sel = S.inlineSelection[side];
                        if (sel.idx !== idx) {
                            clearRowHighlight(side, sel.idx);
                            sel.idx = idx;
                            sel.current = false;
                            sel.voltage = false;
                        }
                        sel[signalType] = !sel[signalType];
                        applyRowHighlight(side, idx, sel);
                        renderInlineChartRow(side, idx, sel);
                    }

                    function getDataRow(side, idx) {
                        return document.querySelectorAll(`#readingsBody${side} tr:not(.inline-chart-row)`)[idx];
                    }

                    function clearRowHighlight(side, idx) {
                        const tr = idx != null ? getDataRow(side, idx) : null;
                        if (!tr) return;
                        tr.querySelectorAll('.signal-link').forEach(a => a.classList.remove('active'));
                    }

                    function applyRowHighlight(side, idx, sel) {
                        const tr = getDataRow(side, idx);
                        if (!tr) return;
                        const curLink = tr.querySelector('td:nth-child(6) a.signal-link');
                        const voltLink = tr.querySelector('td:nth-child(7) a.signal-link');
                        if (curLink) curLink.classList.toggle('active', sel.current);
                        if (voltLink) voltLink.classList.toggle('active', sel.voltage);
                    }

                    function renderInlineChartRow(side, idx, sel) {
                        const tbody = document.getElementById(`readingsBody${side}`);
                        const existing = tbody.querySelector('.inline-chart-row');
                        if (existing) existing.remove();
                        if (!sel.current && !sel.voltage) { sel.idx = null; return; }

                        const tr = getDataRow(side, idx);
                        const r = S.recentReadings[idx];
                        if (!tr || !r) return;

                        let inner = '';
                        if (sel.current) inner += `<div class="chart-box" style="height:140px;"><canvas id="inlineChart${side}Current"></canvas></div>`;
                        if (sel.voltage) inner += `<div class="chart-box" style="height:140px; margin-top:${sel.current ? '10px' : '0'};"><canvas id="inlineChart${side}Voltage"></canvas></div>`;
                        tr.insertAdjacentHTML('afterend', `<tr class="inline-chart-row" data-idx="${idx}"><td colspan="7">${inner}</td></tr>`);

                        const dk = S.theme === 'dark';
                        const grid = dk ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
                        const txt = dk ? '#a0aab5' : '#4a5060';
                        if (sel.current) {
                            const color = getComputedStyle(document.getElementById('model1-wrap')).getPropertyValue('--current-color').trim();
                            drawChart(`inlineChart${side}Current`, `inline${side}Current`, side === 'A' ? r.aCur : r.bCur, 8, color, grid, txt);
                        }
                        if (sel.voltage) {
                            const color = getComputedStyle(document.getElementById('model1-wrap')).getPropertyValue('--voltage-color').trim();
                            drawChart(`inlineChart${side}Voltage`, `inline${side}Voltage`, side === 'A' ? r.aVolt : r.bVolt, 150, color, grid, txt);
                        }
                    }

                    // ==================== CHARTS ====================

                    // Model 1's own Plotly area-chart helper (14-Aug-2026) - separate from Model
                    // 2's lineChart() (defined later in this file) so Model 2 stays byte-for-byte
                    // unchanged. Target must be a <div>, not a <canvas>. color defaults to the
                    // current-signal orange since that was this function's only use at first;
                    // voltage calls pass '#0d9488' explicitly (display only - the model never
                    // sees voltage).
                    function plotCurrentM1(divId, values, title, height, color) {
                        color = color || '#d97706';
                        Plotly.newPlot(divId, [{
                            y: values, mode: 'lines', line: { color, width: 1.6 }, fill: 'tozeroy',
                            fillcolor: color + '18',
                        }], {
                            height: height || 180, margin: { l: 40, r: 10, t: 24, b: 24 },
                            title: { text: title, font: { size: 11 } },
                            xaxis: { showgrid: false }, yaxis: { zeroline: false },
                        }, { responsive: true, displaylogo: false });
                    }

                    function drawChart(canvasId, key, data, yMax, color, grid, txt) {
                        if (S.charts[key]) { S.charts[key].destroy(); S.charts[key] = null; }
                        const ctx = document.getElementById(canvasId).getContext('2d');
                        S.charts[key] = new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: data.map((_, i) => i * 20),
                                datasets: [{
                                    data, borderColor: color, borderWidth: 2, pointRadius: 0, tension: 0.15,
                                    fill: true, backgroundColor: color + '22'
                                }]
                            },
                            options: {
                                responsive: true, maintainAspectRatio: false,
                                plugins: { legend: { display: false } },
                                scales: {
                                    x: { grid: { display: false }, ticks: { color: txt, font: { size: 8 }, maxTicksLimit: 10 }, title: { display: true, text: 'ms', color: txt, font: { size: 9 } } },
                                    y: { min: 0, max: yMax, grid: { color: grid }, ticks: { color: txt, font: { size: 8 } } }
                                }
                            }
                        });
                    }

                    // ==================== MONTHLY HEALTH TIMELINE ====================
                    // Whole-month (not live) health view: fetch all operations for the last 30 days,
                    // predict each one using the model, and in a time-series
                    // show green(Normal)/red(Abnormal) markers. Hover -> fault, click -> waveform.
                    const MH = { ops: [], waveA: null, waveB: null, faultColors: {}, activeFilters: new Set(), labelA: '', labelB: '', xStart: null, xEnd: null };

                    function plotlyTheme() {
                        const dk = S.theme === 'dark';
                        return {
                            transparent: 'rgba(0,0,0,0)',
                            grid: dk ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)',
                            font: dk ? '#a7abc7' : '#565b76',
                        };
                    }

                    // Cache-first, then live fetch+predict for ONE asset - shared by the single-
                    // asset "Get/Update Results" flow (analyzeMonthlyHealth) and the whole-site
                    // JSON export (exportSiteJson), which needs the exact same logic per asset.
                    // waves: {a,b} - each side's wave type, since A and B can genuinely differ
                    // (Asset.ThickWaveTypeId) and are never assumed to share one model.
                    async function fetchAndComputeOps(siteId, pm, waves, refTime, forceLive, onProgress, customStart) {
                        let ops = null, cachedAiSummary = null, fromCache = false;
                        let start = customStart || new Date(refTime.getTime() - 30 * 24 * 3600 * 1000);

                        // Fast path: nightly-precomputed predictions for this asset (see
                        // point_machine_operation/cache_refresh.py). Skips the live /api/pmdata
                        // fetch AND the predict loop entirely when the cache is fresh and was
                        // built for the currently-selected wave type on BOTH sides. Falls through
                        // to the live path below on any miss/mismatch/staleness \u2014 never blocks on
                        // this check. "Update Results" always skips this and forces a fresh live run.
                        if (!forceLive) {
                            if (onProgress) onProgress('Checking local cache\u2026');
                            try {
                                const cacheUrl = `${PM_ENDPOINTS.monthlyCache}?SiteId=${encodeURIComponent(siteId)}&AssetId=${encodeURIComponent(pm.assetId)}`;
                                const cr = await fetch(cacheUrl);
                                if (cr.ok) {
                                    const cached = await cr.json();
                                    if (cached && cached.wave_type_a === waves.a && cached.wave_type_b === waves.b && Array.isArray(cached.ops)) {
                                        ops = cached.ops.map(o => ({ ...o, time: new Date(o.time) }));
                                        start = new Date(cached.window_start);
                                        cachedAiSummary = cached.ai_summary || null;
                                        fromCache = true;
                                    }
                                }
                            } catch (e) {
                                console.warn('Monthly health cache check failed, falling back to live fetch:', e.message);
                            }
                        }

                        if (!ops) {
                            if (onProgress) onProgress('Fetching last 30 days of operations\u2026');
                            const fmt = d => d.toISOString().slice(0, 19);
                            const url = `${PM_ENDPOINTS.pmData}?SiteId=${encodeURIComponent(siteId)}&AssetId=${encodeURIComponent(pm.assetId)}`
                                + `&StartDate=${encodeURIComponent(fmt(start))}&EndDate=${encodeURIComponent(fmt(refTime))}`;
                            const r = await fetch(url);
                            if (!r.ok) throw new Error(`HTTP ${r.status}`);
                            const records = await r.json();
                            if (!Array.isArray(records)) throw new Error('Unexpected response shape');

                            // Live API isn't guaranteed to filter by AssetId - it can return ONLY
                            // neighboring assets' records under this AssetId's query, so filter
                            // strictly (same as readings/A-B stroke) and refuse rather than score
                            // the wrong machine's data as this asset's health.
                            const own = records.filter(rec => String(rec.AssetId) === String(pm.assetId));
                            const rows = own
                                .map(rec => ({ rec, time: new Date(rec.TimeStamp || rec.TsTime || 0) }))
                                .filter(x => !isNaN(x.time.getTime()) && x.time <= refTime)
                                .sort((a, b) => a.time - b.time);   // oldest -> newest (time axis)

                            if (!rows.length) return { ops: [], start, fromCache: false, cachedAiSummary: null };

                            ops = rows.map(({ rec, time }) => {
                                const a = extractAbArrays(rec) || { aCur: [], aVolt: [], bCur: [], bVolt: [] };
                                // Direction ("Normal" or "Reverse") comes straight from the record - one
                                // operation moves both A and B sides together, so it's not per-side.
                                return { time, ...a, direction: rec.Direction || null, aPrediction: null, bPrediction: null };
                            });

                            // Build per-side batches, each against its OWN wave type's model - the
                            // two sides can be different wave types (Asset.ThickWaveTypeId), so this
                            // used to be one flat batch scored with a single shared wave. Operations
                            // with missing/empty signal are NOT predicted (the model would turn them
                            // into garbage "Abnormal") \u2014 marked 'nodata' (grey), excluded from good/bad.
                            // A side whose wave type is unresolved is marked 'error' instead of guessed.
                            const itemsA = [], itemsB = [];
                            ops.forEach(o => {
                                if (waves.a && sideHasData(o.aCur, o.aVolt)) itemsA.push([o, { current: o.aCur, voltage: o.aVolt }]);
                                else o.aPrediction = waves.a
                                    ? { status: 'nodata', label: 'No Data', component: null, confidence: 0, types: [] }
                                    : { status: 'error', label: null, component: null, confidence: 0, types: [], error: 'wave type unresolved for side A' };
                                if (waves.b && sideHasData(o.bCur, o.bVolt)) itemsB.push([o, { current: o.bCur, voltage: o.bVolt }]);
                                else o.bPrediction = waves.b
                                    ? { status: 'nodata', label: 'No Data', component: null, confidence: 0, types: [] }
                                    : { status: 'error', label: null, component: null, confidence: 0, types: [], error: 'wave type unresolved for side B' };
                            });

                            // Chunked prediction \u2014 so "Predicting\u2026 please wait (X/Y)" progress remains visible.
                            // Larger chunks = fewer HTTP round-trips = faster (a busy machine can have 800+ ops).
                            const CHUNK = 120;
                            const total = itemsA.length + itemsB.length;
                            let done = 0;
                            for (const [side, wave, list] of [['a', waves.a, itemsA], ['b', waves.b, itemsB]]) {
                                for (let i = 0; i < list.length; i += CHUNK) {
                                    const slice = list.slice(i, i + CHUNK);
                                    if (onProgress) onProgress(`Predicting\u2026 please wait (${done + slice.length}/${total} operations)`);
                                    const preds = await predictBatch(wave, slice.map(([, it]) => it));
                                    preds.forEach((p, j) => { slice[j][0][`${side}Prediction`] = p; });
                                    done += slice.length;
                                }
                            }
                        }

                        return { ops, start, fromCache, cachedAiSummary };
                    }

                    let currentAnalysisMode = 'quick';   // 'quick' or 'custom'

                    function switchAnalysisMode(mode) {
                        currentAnalysisMode = mode;
                        document.getElementById('mh-mode-quick-btn').classList.toggle('active', mode === 'quick');
                        document.getElementById('mh-mode-custom-btn').classList.toggle('active', mode === 'custom');
                        document.getElementById('mh-quick-row').style.display = mode === 'quick' ? 'flex' : 'none';
                        document.getElementById('mh-custom-panel').style.display = mode === 'custom' ? 'block' : 'none';
                        document.getElementById('pm-list-section').style.display = mode === 'custom' ? 'none' : 'flex';
                        updateCompactSidebar1();
                        if (mode === 'custom') {
                            const today = new Date().toISOString().split('T')[0];
                            const past30 = new Date(); past30.setDate(past30.getDate() - 30);
                            const fromInput = document.getElementById('mh-custom-from-date');
                            const toInput = document.getElementById('mh-custom-to-date');
                            if (!toInput.value) toInput.value = today;
                            if (!fromInput.value) fromInput.value = past30.toISOString().split('T')[0];
                            toInput.max = today; fromInput.max = today;
                            validateDateRange();
                        }
                    }

                    function getCustomRange() {
                        const fromVal = document.getElementById('mh-custom-from-date').value;
                        const toVal = document.getElementById('mh-custom-to-date').value;
                        if (!fromVal || !toVal) return null;
                        const fromTime = (document.getElementById('mh-custom-from-time').value || '00:00:00');
                        const toTime = (document.getElementById('mh-custom-to-time').value || '23:59:59');
                        const fullFromTime = fromTime.length === 5 ? fromTime + ':00' : fromTime;
                        const fullToTime = toTime.length === 5 ? toTime + ':00' : toTime;
                        return {
                            startDate: new Date(`${fromVal}T${fullFromTime}`),
                            endDate: new Date(`${toVal}T${fullToTime}`),
                        };
                    }

                    function validateDateRange() {
                        const errorEl = document.getElementById('mh-date-range-error');
                        const applyBtn = document.getElementById('mh-apply-custom-dates-btn');
                        const range = getCustomRange();
                        if (!range) { errorEl.style.display = 'none'; applyBtn.disabled = true; return false; }
                        const diffDays = (range.endDate - range.startDate) / (1000 * 60 * 60 * 24);
                        if (diffDays < 0) {
                            errorEl.innerHTML = '\u26a0\ufe0f <b>Invalid range:</b> "To" cannot be before "From".';
                            errorEl.style.display = 'block'; applyBtn.disabled = true; return false;
                        }
                        if (diffDays > 90) {
                            errorEl.innerHTML = `\u26a0\ufe0f <b>Limit exceeded:</b> selected range (${diffDays.toFixed(1)} days) exceeds the 90-day max.`;
                            errorEl.style.display = 'block'; applyBtn.disabled = true; return false;
                        }
                        errorEl.style.display = 'none'; applyBtn.disabled = false; return true;
                    }

                    function applyCustomDates() {
                        const idx = document.getElementById('mh-custom-pm-select').value;
                        if (idx === '') { toast('Select a point machine first', 'error'); return; }
                        if (!validateDateRange()) return;
                        S.selectedAsset = S.pointMachines[Number(idx)];
                        renderPmList();
                        document.getElementById('mh-custom-pm-select').value = idx;
                        const quickSelect = document.getElementById('quick-pm-select');
                        if (quickSelect) quickSelect.value = idx;
                        document.getElementById('emptyState').style.display = 'none';
                        document.getElementById('mainView').style.display = 'flex';
                        document.getElementById('assetTitle').textContent = S.selectedAsset.assetName;
                        document.getElementById('assetBreadcrumb').textContent = S.selectedAsset.assetName;
                        document.getElementById('assetSub').style.display = 'none';
                        document.getElementById('waveBadge').textContent = waveTypesLabel(getActiveWaveTypes());
                        if (S.waveType === 'Both') onWaveModelSwitch(getActiveWaveTypes());
                        resetReadingsRefTime();
                        document.getElementById('abStrokeCard').style.display = 'none';
                        document.getElementById('monthlyResults').style.display = 'none';
                        document.getElementById('monthlyDetail').style.display = 'none';
                        document.getElementById('aiSummaryCard').style.display = 'none';
                        updateCompactSidebar1();
                        const sidebarEl1b = document.querySelector('#model1-wrap .sidebar');
                        if (sidebarEl1b && !sidebarEl1b.classList.contains('collapsed')) toggleSidebar(true);
                        analyzeMonthlyHealth(true);
                    }

                    async function analyzeMonthlyHealth(forceLive) {
                        const pm = S.selectedAsset;
                        if (!pm) { toast('Please select a point machine first', 'error'); return; }
                        const waves = getActiveWaveTypes();
                        if (!waves.a && !waves.b) { toast('Wave type unresolved for this asset - cannot analyze', 'error'); return; }
                        if (!modelLoaded || !modelsReadyFor(waves)) { toast(`No model loaded for ${waveTypesLabel(waves)}`, 'error'); return; }

                        let customStart = null, refTime;
                        if (currentAnalysisMode === 'custom') {
                            if (!validateDateRange()) { toast('Pick a valid custom date range first', 'error'); return; }
                            const range = getCustomRange();
                            customStart = range.startDate;
                            refTime = range.endDate;
                            forceLive = true;
                        } else {
                            const refInput = document.getElementById('monthlyRefTime').value;
                            refTime = refInput ? new Date(refInput) : new Date();
                        }

                        const loading = document.getElementById('monthlyLoading');
                        const loadingText = document.getElementById('monthlyLoadingText');
                        const empty = document.getElementById('monthlyEmpty');
                        const results = document.getElementById('monthlyResults');
                        const btns = [document.getElementById('monthlyUpdateBtn')];

                        empty.style.display = 'none';
                        results.style.display = 'none';
                        document.getElementById('aiSummaryCard').style.display = 'none';
                        loading.style.display = 'block';
                        btns.forEach(b => { b.disabled = true; b.style.opacity = '0.6'; });

                        try {
                            const { ops, start, fromCache, cachedAiSummary } = await fetchAndComputeOps(
                                S.currentSiteId, pm, waves, refTime, forceLive,
                                (msg) => { loadingText.textContent = msg; }, customStart
                            );

                            if (!ops.length) {
                                loading.style.display = 'none';
                                empty.style.display = 'block';
                                empty.textContent = currentAnalysisMode === 'custom'
                                    ? 'No operations found for this asset in the selected date range.'
                                    : 'No operations found for this asset in the last 30 days.';
                                return;
                            }

                            MH.ops = ops; MH.waveA = waves.a; MH.waveB = waves.b;

                            // Fixed color per fault type (see FAULT_COLORS) - same fault always
                            // looks the same color, and every hue is clearly distinguishable.
                            MH.faultColors = FAULT_COLORS;

                            const { labelA, labelB } = getAbLabels(pm);
                            MH.labelA = labelA; MH.labelB = labelB;
                            MH.xStart = start; MH.xEnd = refTime;
                            MH.activeFilters.clear();
                            document.getElementById('monthlyHealthSub').textContent =
                                `${ops.length} operations \u00b7 ${start.toLocaleDateString()} \u2192 ${refTime.toLocaleDateString()}`;

                            loading.style.display = 'none';
                            results.style.display = 'block';
                            document.getElementById('monthlyDetail').style.display = 'none';
                            renderHealthSummary(ops, labelA, labelB);
                            renderHealthTimeline();
                            const aiSummary = await generateAiSummary(cachedAiSummary);
                            MH.lastAiSummary = aiSummary;  // for Export JSON/PDF

                            // Live computation (forced, or a cache-miss fallback) - persist it into
                            // the same cache file so the next "Get Results" click sees this run.
                            // Never for a custom range - a one-off historical query must not
                            // overwrite the cache the default quick view depends on.
                            if (!fromCache && currentAnalysisMode !== 'custom') {
                                writeMonthlyHealthCache(pm, waves, start, refTime, aiSummary);
                            }
                        } catch (e) {
                            loading.style.display = 'none';
                            empty.style.display = 'block';
                            empty.textContent = 'Failed: ' + e.message;
                            toast('Monthly analysis failed: ' + e.message, 'error');
                        } finally {
                            btns.forEach(b => { b.disabled = false; b.style.opacity = '1'; });
                        }
                    }


                    function toggleFaultFilter(name) {
                        if (MH.activeFilters.has(name)) {
                            MH.activeFilters.delete(name);
                        } else {
                            MH.activeFilters.add(name);
                        }
                        renderHealthTimeline();
                        // Re-render summary to update chip active states
                        const stA = computeSideStats(MH.ops, 'a');
                        const stB = computeSideStats(MH.ops, 'b');
                        document.getElementById('monthlySummary').innerHTML =
                            `<div style="display:flex; gap:16px; flex-wrap:wrap;">
                                                                    ${machineBlock(MH.labelA, stA)}
                                                                    ${machineBlock(MH.labelB, stB)}
                                                                </div>`;
                    }

                    // PT495 and PT496 are TWO DIFFERENT machines (side A / B) \u2014 do not combine stats,
                    // each machine has its own block: operations, good/bad %, current/voltage fault %,
                    // and top faults (sorted).
                    const TOP_FAULTS_N = 5;

                    // Fault-type explanations (same set for both TWS and IRS \u2014 like model TYPE_MAP).
                    const FAULT_INFO = {
                        'Obstruction': 'Something physically blocks the switch \u2014 current stays high and the stroke cannot complete.',
                        'Slip': 'The point fails to lock/seat properly at the end of its travel.',
                        'Jamming': 'Mechanical jam mid-stroke \u2014 movement resists and current spikes.',
                        'Sluggish': 'Operation is slower than normal \u2014 the stroke takes longer to finish.',
                        'Stall': 'The motor stalls \u2014 the operation does not complete.',
                        'Pumping': 'Repeated back-and-forth / oscillating movement instead of one clean stroke.',
                        'Friction': 'Excess friction throughout the stroke \u2014 current stays elevated end to end.',
                        'Out of Corresp.': 'Out of correspondence \u2014 point not detected in the commanded position.',
                        'Delayed Cut-off': 'Motor cut-off happens later than expected at the end of the stroke.',
                        'Progressive Load': 'Load rises progressively during the stroke \u2014 current climbs steadily.',
                        'Other': "An anomaly that doesn't match the defined fault patterns.",
                        'Unclassified': 'Flagged abnormal by the detector, but no specific fault type was identified confidently.',
                    };

                    // Fixed color per fault type (not assigned dynamically by first-seen order) so
                    // the SAME fault always gets the SAME color across every asset, and hues are
                    // spread around the color wheel (skipping green - reserved for Normal - and
                    // the blue-grey used for No Data) so no two fault types look alike.
                    const FAULT_COLORS = {
                        'Obstruction': '#dc2626',          // red
                        'Slip': '#ea580c',                 // red-orange
                        'Jamming': '#f59e0b',              // orange
                        'Sluggish': '#ca8a04',             // gold
                        'Stall': '#0d9488',                // teal
                        'Pumping': '#0891b2',              // cyan
                        'Friction': '#2563eb',             // blue
                        'Out of Corresp.': '#4338ca',      // blue-violet
                        'Delayed Cut-off': '#7c3aed',      // violet
                        'Progressive Load': '#c026d3',     // magenta
                        'Other': '#e11d48',                // rose
                        'Unclassified': '#1e293b',         // charcoal
                    };

                    function renderFaultLegend() {
                        const el = document.getElementById('faultLegend');
                        if (!el || el.dataset.filled === '1') return;
                        el.innerHTML = Object.keys(FAULT_INFO).map(name =>
                            `<div><b style="color:var(--text-primary);">${name}</b> \u2014 ${FAULT_INFO[name]}</div>`).join('');
                        el.dataset.filled = '1';
                    }

                    // Is a signal (current or voltage) valid or missing/empty (all-zero or too small)?
                    function hasSignal(a) {
                        a = a || [];
                        if (a.length < 5) return false;
                        let mx = 0;
                        for (const v of a) { const n = Math.abs(+v) || 0; if (n > mx) mx = n; }
                        return mx > 0.01;
                    }

                    // Side data is valid only when BOTH CURRENT and VOLTAGE exist \u2014 the model stacks both.
                    // If either is missing, prediction is unreliable. Show it as 'no-data' (grey).
                    function sideHasData(cur, volt) {
                        return hasSignal(cur) && hasSignal(volt);
                    }

                    function computeSideStats(ops, side) {
                        let total = 0, bad = 0, curBad = 0, voltBad = 0, missing = 0;
                        const faultCount = {};
                        ops.forEach(o => {
                            const p = side === 'a' ? o.aPrediction : o.bPrediction;
                            if (!p) return;
                            if (p.status === 'nodata') { missing++; return; }   // missing = good/bad se bahar
                            if (p.status !== 'success') return;
                            total++;
                            if (p.label === 'Abnormal') {
                                bad++;
                                const comp = p.component || '';
                                if (comp.includes('C')) curBad++;   // "C" ya "V-C" \u2014 current side involved
                                if (comp.includes('V')) voltBad++;   // "V" ya "V-C" \u2014 voltage side involved
                                // Binary head says "Abnormal" but no specific fault-type crosses 0.5
                                // -> "Unclassified" (so Bad% and fault list match).
                                const ts = p.types || [];
                                if (ts.length) ts.forEach(t => { faultCount[t.type] = (faultCount[t.type] || 0) + 1; });
                                else faultCount['Unclassified'] = (faultCount['Unclassified'] || 0) + 1;
                            }
                        });
                        return { total, bad, curBad, voltBad, missing, faultCount };
                    }

                    function machineBlock(label, st) {
                        const totalAll = st.total + st.missing;   // valid + missing = saare operations
                        const good = st.total - st.bad;
                        // Good/Bad/No-Data sab total-all ka % \u2014 teeno milke 100% (missing bhi count me).
                        const pct = n => totalAll ? Math.round(n / totalAll * 1000) / 10 : 0;

                        const tile = (val, lbl, color) => `<div style="flex:1; min-width:90px; background:var(--bg-tertiary); border:1px solid var(--border); border-radius:10px; padding:12px; text-align:center;">
                                                                <div style="font-size:22px; font-weight:800; color:${color};">${val}</div>
                                                                <div style="font-size:10px; color:var(--text-muted); text-transform:uppercase; font-weight:700; letter-spacing:0.4px; margin-top:3px;">${lbl}</div></div>`;

                        const sideBar = (lbl, n, color) => {
                            const p = pct(n);
                            return `<div style="margin-top:8px;">
                                                                    <div style="display:flex; justify-content:space-between; font-size:12px; font-weight:600; margin-bottom:4px;">
                                                                        <span style="color:var(--text-secondary);">${lbl}</span><span style="color:${color};">${p}% (${n})</span></div>
                                                                    <div style="height:7px; background:var(--bg-tertiary); border-radius:5px; overflow:hidden;">
                                                                        <div style="height:100%; width:${p}%; background:${color};"></div></div></div>`;
                        };

                        const sortedFaults = Object.keys(st.faultCount).sort((a, b) => st.faultCount[b] - st.faultCount[a]);
                        const topFaults = sortedFaults.slice(0, TOP_FAULTS_N);
                        const faultChips = topFaults.map(name => {
                            const c = st.faultCount[name];
                            const p = st.bad ? Math.round(c / st.bad * 1000) / 10 : 0;
                            const color = MH.faultColors[name] || 'var(--abnormal)';
                            const isActive = MH.activeFilters.size === 0 || MH.activeFilters.has(name);
                            // Always 2px border \u2014 use transparent when inactive so size never changes
                            const border = isActive ? `2px solid ${color}` : `2px solid transparent`;
                            const opacity = isActive ? '1' : '0.4';
                            return `<span onclick="toggleFaultFilter('${name.replace(/'/g, "\\'")}')" style="display:inline-flex; align-items:center; gap:6px; background:${color}20; color:${color}; border:${border}; border-radius:16px; padding:4px 12px; font-size:12px; font-weight:600; cursor:pointer; opacity:${opacity}; transition:opacity 0.15s, border-color 0.15s; user-select:none;">
                                                                    ${name} <b>${c}</b> <span style="opacity:0.8;">(${p}%)</span></span>`;
                        }).join('');

                        const healthColor = pct(st.bad) >= 20 ? 'var(--abnormal)' : pct(st.bad) > 0 ? 'var(--current-color)' : 'var(--normal)';

                        return `<div style="flex:1; min-width:340px; background:var(--bg-card); border:1px solid var(--border); border-radius:12px; padding:16px;">
                                                                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;">
                                                                    <span style="font-size:15px; font-weight:800; color:var(--text-primary);">${label}</span>
                                                                    <span style="font-size:12px; font-weight:700; color:${healthColor};">${pct(good)}% healthy</span>
                                                                </div>
                                                                <div style="display:flex; gap:10px; flex-wrap:wrap;">
                                                                    ${tile(totalAll, 'Operations', 'var(--text-primary)')}
                                                                    ${tile(pct(good) + '%', 'Good', 'var(--normal)')}
                                                                    ${tile(pct(st.bad) + '%', 'Bad', 'var(--abnormal)')}
                                                                    ${tile(pct(st.missing) + '%', 'No Data', 'var(--text-muted)')}
                                                                </div>
                                                                <div style="margin-top:12px;">
                                                                    <div style="font-size:10px; color:var(--text-muted); text-transform:uppercase; font-weight:700; letter-spacing:0.4px;">Fault side (% of ops)</div>
                                                                    ${sideBar('\u26a1 Current-side', st.curBad, 'var(--current-color)')}
                                                                </div>
                                                                <div style="margin-top:12px;">
                                                                    <div style="font-size:10px; color:var(--text-muted); text-transform:uppercase; font-weight:700; letter-spacing:0.4px; margin-bottom:8px;">Top faults (% of abnormal)</div>
                                                                    ${faultChips || '<span style="font-size:12px; color:var(--normal); font-weight:600;">No faults \ud83c\udf89</span>'}
                                                                </div>
                                                            </div>`;
                    }

                    function renderHealthSummary(ops, labelA, labelB) {
                        const stA = computeSideStats(ops, 'a');
                        const stB = computeSideStats(ops, 'b');
                        document.getElementById('monthlySummary').innerHTML =
                            `<div style="display:flex; gap:16px; flex-wrap:wrap;">
                                                                    ${machineBlock(labelA, stA)}
                                                                    ${machineBlock(labelB, stB)}
                                                                </div>`;
                        renderFaultLegend();
                    }

                    function renderHealthTimeline(ops, labelA, labelB, xStart, xEnd) {
                        // Allow calling with no args \u2014 use stored MH values for re-renders (filter toggle)
                        ops = ops || MH.ops;
                        labelA = labelA || MH.labelA;
                        labelB = labelB || MH.labelB;
                        xStart = xStart || MH.xStart;
                        xEnd = xEnd || MH.xEnd;

                        const th = plotlyTheme();
                        const cs = getComputedStyle(document.getElementById('model1-wrap'));
                        const NORMAL = cs.getPropertyValue('--normal').trim() || '#16a34a';
                        const GREY = cs.getPropertyValue('--text-muted').trim() || '#8b90ac';
                        const active = MH.activeFilters;  // empty Set = show all

                        // Abnormal points nudge slightly above the row's baseline and render as
                        // diamonds (Normal/No-data stay circles at the baseline) - just enough
                        // separation (~25% of the marker) to keep both visible when an abnormal
                        // op lands at nearly the same timestamp as a normal one, while still
                        // mostly overlapping the row so it doesn't read as a second data row.
                        const ABNORMAL_Y_OFFSET = 0.06;

                        function makeTrace(side, yVal, label) {
                            const points = [];
                            ops.forEach(o => {
                                const p = side === 'a' ? o.aPrediction : o.bPrediction;
                                if (!p) return;
                                let color, tip, size = 9, symbol = 'circle', yPoint = yVal, layer = 0;
                                const tstr = o.time.toLocaleString();
                                // Direction ("Normal"/"Reverse") comes straight from the record - which way
                                // the point machine threw for this operation, not related to the A/B side.
                                const dirLine = o.direction ? `<br>Direction: <b>${o.direction}</b>` : '';

                                if (p.status === 'nodata') {
                                    if (active.size > 0) return;   // hide no-data when filtering
                                    color = GREY;
                                    tip = `<b>${label}</b> \u00b7 ${tstr}<br>Status: No data (signal missing)${dirLine}`;
                                } else if (p.status !== 'success') {
                                    return;
                                } else if (p.label === 'Abnormal') {
                                    let mainFault = 'Unclassified';
                                    if (p.types && p.types.length > 0) mainFault = p.types[0].type;
                                    // Filter chips (see computeSideStats) count EVERY fault type that crossed
                                    // the confidence threshold, not just the top-ranked one - so matching must
                                    // check the whole types list, not just mainFault, or a fault that's real but
                                    // not #1-ranked for this op would show a nonzero chip count with zero dots.
                                    if (active.size > 0) {
                                        const opFaults = (p.types && p.types.length) ? p.types.map(t => t.type) : ['Unclassified'];
                                        if (!opFaults.some(t => active.has(t))) return;
                                    }
                                    color = MH.faultColors[mainFault] || cs.getPropertyValue('--abnormal').trim() || '#ef4444';
                                    size = 10;
                                    symbol = 'diamond';
                                    yPoint = yVal + ABNORMAL_Y_OFFSET;
                                    const faults = (p.types || []).map(t => `${t.type} (${t.confidence}%)`).join(', ') || '\u2014';
                                    tip = `<b>${label}</b> \u00b7 ${tstr}<br>Fault: <b>${mainFault}</b><br>Component: ${p.component || '\u2014'}<br>All: ${faults}<br>Confidence: ${p.confidence}%${dirLine}`;
                                } else {
                                    if (active.size > 0) return;   // hide normal dots when filtering
                                    color = NORMAL;
                                    layer = 1;  // normal draws last (on top) - abnormal/no-data sit behind it
                                    tip = `<b>${label}</b> \u00b7 ${tstr}<br>Status: Normal<br>Confidence: ${p.confidence}%${dirLine}`;
                                }

                                points.push({ x: o.time, y: yPoint, color, text: tip, size, symbol, layer });
                            });

                            // Stable-sort by layer (not by time) so Normal circles always paint on
                            // top of Abnormal/No-data at the same/close timestamp - only the ~25%
                            // sliver of the diamond that pokes above the circle stays visible.
                            points.sort((p1, p2) => p1.layer - p2.layer);

                            const x = points.map(p => p.x), y = points.map(p => p.y), text = points.map(p => p.text);
                            const colors = points.map(p => p.color), sizes = points.map(p => p.size), symbols = points.map(p => p.symbol);
                            return {
                                x, y, text,
                                mode: 'markers', type: 'scatter', name: label,
                                marker: { color: colors, symbol: symbols, size: sizes, line: { width: 1, color: th.grid } },
                                hovertemplate: '%{text}<extra></extra>',
                            };
                        }

                        const data = [makeTrace('a', 2, labelA), makeTrace('b', 1, labelB)];
                        const layout = {
                            height: 260,
                            margin: { l: 90, r: 20, t: 10, b: 40 },
                            paper_bgcolor: th.transparent, plot_bgcolor: th.transparent,
                            font: { color: th.font, size: 11 },
                            xaxis: { type: 'date', gridcolor: th.grid, range: xStart && xEnd ? [xStart, xEnd] : undefined },
                            yaxis: { tickmode: 'array', tickvals: [1, 2], ticktext: [labelB, labelA], range: [0.5, 2.5], gridcolor: th.grid },
                            showlegend: false, hovermode: 'closest',
                        };

                        const el = document.getElementById('monthlyTimeline');
                        Plotly.newPlot(el, data, layout, { responsive: true, displaylogo: false });

                        el.removeAllListeners && el.removeAllListeners('plotly_click');
                        el.on('plotly_click', (ev) => {
                            const pt = ev.points && ev.points[0];
                            if (!pt) return;
                            const side = pt.curveNumber === 0 ? 'a' : 'b';
                            const t = +new Date(pt.x);
                            let best = null;
                            ops.forEach(o => { const d = Math.abs(+o.time - t); if (!best || d < best.d) best = { o, d }; });
                            if (best) showMonthlyDetail(best.o, side, side === 'a' ? labelA : labelB);
                        });
                    }

                    // ==================== AI SUMMARY (server-side Claude call) ====================
                    // Sends only the already-computed aggregate stats below (good/bad %, fault-side
                    // split, top faults, weekly trend) to /api/pm-ai-summary - never raw current/
                    // voltage arrays - which calls Claude server-side (API key never reaches the browser).

                    // Splits the analyzed window into ~weekly buckets and computes bad% per bucket,
                    // so the model can call out whether faults are trending up/down/flat.
                    function computeWeeklyTrend(ops, side, xStart, xEnd) {
                        if (!xStart || !xEnd) return [];
                        const bucketMs = 7 * 24 * 3600 * 1000;
                        const buckets = [];
                        for (let t = +xStart; t < +xEnd; t += bucketMs) {
                            const bStart = new Date(t), bEnd = new Date(Math.min(t + bucketMs, +xEnd));
                            const inBucket = ops.filter(o => o.time >= bStart && o.time < bEnd);
                            const st = computeSideStats(inBucket, side);
                            const totalAll = st.total + st.missing;
                            const badPct = totalAll ? Math.round(st.bad / totalAll * 1000) / 10 : 0;
                            buckets.push({ period: `${bStart.toLocaleDateString()}-${bEnd.toLocaleDateString()}`, badPct, total: totalAll });
                        }
                        return buckets;
                    }

                    function machineAiPayload(label, st, side, wave) {
                        const totalAll = st.total + st.missing;
                        const pct = n => totalAll ? Math.round(n / totalAll * 1000) / 10 : 0;
                        const topFaults = Object.keys(st.faultCount)
                            .sort((a, b) => st.faultCount[b] - st.faultCount[a])
                            .slice(0, TOP_FAULTS_N)
                            .map(name => ({ type: name, count: st.faultCount[name] }));
                        return {
                            label,
                            wave: wave || null,
                            totalOps: totalAll,
                            goodPct: pct(st.total - st.bad),
                            badPct: pct(st.bad),
                            noDataPct: pct(st.missing),
                            currentFaultPct: pct(st.curBad),
                            voltageFaultPct: pct(st.voltBad),
                            topFaults,
                            trend: computeWeeklyTrend(MH.ops, side, MH.xStart, MH.xEnd)
                        };
                    }

                    function escapeHtml(s) {
                        const d = document.createElement('div');
                        d.textContent = s == null ? '' : String(s);
                        return d.innerHTML;
                    }

                    // Renders {verdict, points, recommendation} as a scannable bullet list. Falls
                    // back to plain text if an older/unstructured summary shape is ever passed in.
                    function renderSummaryBullets(data) {
                        if (!data || typeof data !== 'object' || Array.isArray(data)) {
                            return `<span>${escapeHtml(data || 'No summary returned.')}</span>`;
                        }
                        const points = Array.isArray(data.points) ? data.points : [];
                        const bullets = points.map(p => `<li style="margin-bottom:4px;">${escapeHtml(p)}</li>`).join('');
                        return (
                            `<div style="font-weight:800; font-size:13.5px; margin-bottom:6px;">${escapeHtml(data.verdict)}</div>`
                            + (bullets ? `<ul style="margin:0 0 6px 18px; padding:0;">${bullets}</ul>` : '')
                            + (data.recommendation
                                ? `<div style="margin-top:4px;"><b>Recommendation:</b> ${escapeHtml(data.recommendation)}</div>`
                                : '')
                        );
                    }

                    // Returns the {verdict,points,recommendation} object it rendered (cached or
                    // freshly generated), or null on failure - callers use this to write a live
                    // result through to the local cache (see analyzeMonthlyHealth).
                    async function generateAiSummary(cachedSummary) {
                        const box = document.getElementById('aiSummaryCard');
                        const textEl = document.getElementById('aiSummaryText');
                        if (!MH.ops.length) { box.style.display = 'none'; return null; }
                        box.style.display = 'block';

                        // Nightly cache already ran this exact prompt for this asset (see
                        // point_machine_operation/cache_refresh.py) - use it instantly instead of
                        // re-calling Claude live for the same data.
                        if (cachedSummary) {
                            textEl.innerHTML = renderSummaryBullets(cachedSummary);
                            return cachedSummary;
                        }

                        textEl.innerHTML = '<span class="spinner"></span> Generating AI summary...';

                        const stA = computeSideStats(MH.ops, 'a');
                        const stB = computeSideStats(MH.ops, 'b');
                        const siteObj = (S.sites || []).find(s => String(s.SiteId) === String(S.currentSiteId));
                        const payload = {
                            assetName: (S.selectedAsset && S.selectedAsset.assetName) || null,
                            siteName: (siteObj && siteObj.SiteName) || null,
                            windowStart: MH.xStart ? MH.xStart.toISOString() : null,
                            windowEnd: MH.xEnd ? MH.xEnd.toISOString() : null,
                            // Machine A/Machine B carry their OWN wave (see machineAiPayload) - they
                            // can genuinely differ (Asset.ThickWaveTypeId), so there's no single
                            // shared waveType for the whole asset anymore.
                            machines: [machineAiPayload(MH.labelA, stA, 'a', MH.waveA), machineAiPayload(MH.labelB, stB, 'b', MH.waveB)]
                        };

                        try {
                            const r = await fetch(PM_ENDPOINTS.aiSummary, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(payload)
                            });
                            const data = await r.json();
                            if (!r.ok) throw new Error(data.error || `HTTP ${r.status}`);
                            textEl.innerHTML = renderSummaryBullets(data);
                            return data;
                        } catch (e) {
                            textEl.innerHTML = `<span style="color:var(--text-muted);">AI summary unavailable: ${e.message}</span>`;
                            return null;
                        }
                    }

                    // After an "Update Results" (or a "Get Results" that fell back to live), write
                    // the fresh ops+AI-summary into the SAME cache file cache_refresh.py builds
                    // nightly - so the next "Get Results" click reflects this run, not a stale one.
                    async function writeMonthlyHealthCache(pm, waves, start, refTime, aiSummary) {
                        try {
                            const siteObj = (S.sites || []).find(s => String(s.SiteId) === String(S.currentSiteId));
                            await fetch(PM_ENDPOINTS.monthlyCachePost, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({
                                    site_id: S.currentSiteId,
                                    site_name: (siteObj && siteObj.SiteName) || null,
                                    asset_id: pm.assetId,
                                    asset_name: pm.assetName,
                                    wave_type_a: waves.a,
                                    wave_type_b: waves.b,
                                    window_start: start.toISOString(),
                                    window_end: refTime.toISOString(),
                                    ops: MH.ops,
                                    ai_summary: aiSummary,
                                })
                            });
                        } catch (e) {
                            console.warn('Monthly health cache write-through failed:', e.message);
                        }
                    }

                    // \u2500\u2500 EXPORT WHOLE SITE (every point machine, all operations + predictions) \u2500\u2500
                    // Cache-first per asset (same as a single "Get Results" click) - only assets
                    // with no fresh cache get a live fetch+predict, so a re-export of an already-
                    // warm site is fast. Skips assets whose wave type couldn't be resolved
                    // (can't pick a model for them) and lists them separately in the output.
                    async function exportSiteJson() {
                        if (!S.pointMachines.length) { alert('Select a site with point machines first.'); return; }
                        const siteId = S.currentSiteId;
                        const siteObj = (S.sites || []).find(s => String(s.SiteId) === String(siteId));
                        const btn = document.getElementById('exportSiteJsonBtn');
                        const origHtml = btn.innerHTML;
                        btn.disabled = true;

                        const refTime = new Date();
                        const assets = [], skipped = [];
                        const total = S.pointMachines.length;

                        try {
                            // Refresh wave types right before exporting rather than trusting
                            // whatever resolved back when "Fetch Point Machines" was clicked - the
                            // DB lookup behind /api/asset-wavetype has been seen to time out
                            // transiently, and a stale null here would wrongly skip every asset.
                            if (S.pointMachines.some(pm => pm.aWaveType == null && pm.bWaveType == null)) {
                                btn.innerHTML = 'Refreshing wave types\u2026';
                                await loadAssetWaveTypes(siteId);
                            }

                            for (let i = 0; i < total; i++) {
                                const pm = S.pointMachines[i];
                                btn.innerHTML = `Exporting ${i + 1}/${total} (${pm.assetName})\u2026`;
                                const waves = { a: pm.aWaveType || null, b: pm.bWaveType || null };
                                if (!waves.a && !waves.b) {
                                    skipped.push({ asset_id: pm.assetId, asset_name: pm.assetName, reason: 'wave type unknown - no model to predict with' });
                                    continue;
                                }
                                try {
                                    const { ops, start, fromCache, cachedAiSummary } = await fetchAndComputeOps(siteId, pm, waves, refTime, false, null);
                                    if (!ops.length) {
                                        skipped.push({ asset_id: pm.assetId, asset_name: pm.assetName, reason: 'no operations in the last 30 days' });
                                        continue;
                                    }
                                    if (!fromCache) writeMonthlyHealthCache(pm, waves, start, refTime, null);
                                    assets.push({
                                        asset_id: pm.assetId,
                                        asset_name: pm.assetName,
                                        wave_type_a: waves.a,
                                        wave_type_b: waves.b,
                                        window_start: start.toISOString(),
                                        window_end: refTime.toISOString(),
                                        ai_summary: cachedAiSummary || null,
                                        operations: ops.map(o => ({
                                            time: o.time.toISOString(),
                                            direction: o.direction || null,
                                            aCur: o.aCur, aVolt: o.aVolt, aPrediction: o.aPrediction,
                                            bCur: o.bCur, bVolt: o.bVolt, bPrediction: o.bPrediction,
                                        })),
                                    });
                                } catch (e) {
                                    skipped.push({ asset_id: pm.assetId, asset_name: pm.assetName, reason: e.message });
                                }
                            }

                            const exportObj = {
                                export_meta: {
                                    exported_at: new Date().toISOString(),
                                    site_id: siteId ?? null,
                                    site_name: (siteObj && siteObj.SiteName) || null,
                                    asset_count: assets.length,
                                    skipped_count: skipped.length,
                                },
                                assets,
                                skipped,
                            };

                            const blob = new Blob([JSON.stringify(exportObj, null, 2)], { type: 'application/json' });
                            const url = URL.createObjectURL(blob);
                            const a = document.createElement('a');
                            const safeSite = ((siteObj && siteObj.SiteName) || 'site').replace(/[\\/:*?"<>|]+/g, ' ').trim();
                            a.href = url;
                            a.download = `point machine site export ${safeSite}.json`;
                            document.body.appendChild(a);
                            a.click();
                            document.body.removeChild(a);
                            URL.revokeObjectURL(url);
                            toast(`Exported ${assets.length}/${total} point machines${skipped.length ? `, ${skipped.length} skipped` : ''}`, 'success');
                        } catch (e) {
                            alert('Site export failed: ' + e.message);
                        } finally {
                            btn.disabled = false;
                            btn.innerHTML = origHtml;
                        }
                    }

                    // \u2500\u2500 EXPORT JSON / PDF (same pattern as Track Leakage's export buttons) \u2500\u2500\u2500\u2500\u2500\u2500
                    function exportMonthlyJson() {
                        if (!MH.ops.length) { alert('No results to export. Click "Fetch & Compute" first.'); return; }
                        const pm = S.selectedAsset;
                        const siteObj = (S.sites || []).find(s => String(s.SiteId) === String(S.currentSiteId));
                        const stA = computeSideStats(MH.ops, 'a');
                        const stB = computeSideStats(MH.ops, 'b');

                        const exportObj = {
                            export_meta: {
                                exported_at: new Date().toISOString(),
                                site_id: S.currentSiteId ?? null,
                                site_name: (siteObj && siteObj.SiteName) || null,
                                asset_id: pm ? pm.assetId : null,
                                asset_name: pm ? pm.assetName : null,
                                wave_type_a: MH.waveA,
                                wave_type_b: MH.waveB,
                                window_start: MH.xStart ? MH.xStart.toISOString() : null,
                                window_end: MH.xEnd ? MH.xEnd.toISOString() : null,
                            },
                            ai_summary: MH.lastAiSummary || null,
                            machines: [
                                machineAiPayload(MH.labelA, stA, 'a', MH.waveA),
                                machineAiPayload(MH.labelB, stB, 'b', MH.waveB),
                            ],
                            // Every single operation in the window, with its raw current/voltage
                            // signal and prediction on both sides - the full detail behind the
                            // summary stats above, not just the aggregates.
                            operations: MH.ops.map(o => ({
                                time: o.time.toISOString(),
                                direction: o.direction || null,
                                aCur: o.aCur, aVolt: o.aVolt, aPrediction: o.aPrediction,
                                bCur: o.bCur, bVolt: o.bVolt, bPrediction: o.bPrediction,
                            })),
                        };

                        const blob = new Blob([JSON.stringify(exportObj, null, 2)], { type: 'application/json' });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        const safeAsset = (pm ? pm.assetName : 'asset').replace(/[\\/:*?"<>|]+/g, ' ').trim();
                        a.href = url;
                        a.download = `point machine health ${safeAsset}.json`;
                        document.body.appendChild(a);
                        a.click();
                        document.body.removeChild(a);
                        URL.revokeObjectURL(url);
                    }

                    // Full PDF report (client-side) \u2014 text + the Monthly Health Timeline chart as
                    // an image, straight off the live Plotly div. No server call.
                    async function exportMonthlyPdf(btn) {
                        if (!MH.ops.length) { alert('No results to export. Click "Fetch & Compute" first.'); return; }
                        if (!window.jspdf || !window.jspdf.jsPDF) { alert('PDF library not loaded \u2014 please reload the page.'); return; }
                        const pm = S.selectedAsset;
                        const siteObj = (S.sites || []).find(s => String(s.SiteId) === String(S.currentSiteId));

                        const origHtml = btn ? btn.innerHTML : '';
                        if (btn) { btn.disabled = true; btn.style.opacity = '0.7'; btn.style.cursor = 'wait'; btn.innerHTML = 'Generating PDF\u2026'; }

                        try {
                            const { jsPDF } = window.jspdf;
                            const doc = new jsPDF({ unit: 'pt', format: 'a4' });
                            const pageW = doc.internal.pageSize.getWidth();
                            const pageH = doc.internal.pageSize.getHeight();
                            const M = 40, contentW = pageW - 2 * M;
                            let y = M;
                            const ensure = h => { if (y + h > pageH - M) { doc.addPage(); y = M; } };
                            function line(txt, size, style, color, gap) {
                                doc.setFontSize(size); doc.setFont('helvetica', style || 'normal');
                                doc.setTextColor(...(color || [30, 34, 51]));
                                doc.splitTextToSize(String(txt), contentW).forEach(ln => { ensure(size + 4); doc.text(ln, M, y); y += size + 4; });
                                if (gap) y += gap;
                            }

                            line('Point Machine Operation Report', 20, 'bold', [15, 23, 42], 2);
                            line(`Asset: ${pm ? pm.assetName : '\u2014'}     Site: ${(siteObj && siteObj.SiteName) || '\u2014'}     Wave: ${waveTypesLabel({ a: MH.waveA, b: MH.waveB })}`, 10, 'normal', [100, 116, 139]);
                            const winStr = (MH.xStart && MH.xEnd) ? `${MH.xStart.toLocaleDateString()} to ${MH.xEnd.toLocaleDateString()}` : '-';
                            line(`Window: ${winStr}     Generated: ${new Date().toLocaleString()}`, 10, 'normal', [100, 116, 139], 8);

                            if (MH.lastAiSummary && (MH.lastAiSummary.verdict || (MH.lastAiSummary.points || []).length)) {
                                const s = MH.lastAiSummary;
                                line('AI Summary', 12, 'bold', [30, 34, 51], 2);
                                if (s.verdict) line(s.verdict, 11, 'bold', [79, 70, 229], 4);
                                (s.points || []).forEach(p => line('\u2022  ' + p, 10, 'normal', [60, 65, 85], 0));
                                if (s.recommendation) line('Recommendation: ' + s.recommendation, 10, 'bold', [16, 150, 90], 4);
                                y += 4;
                            }

                            const stA = computeSideStats(MH.ops, 'a');
                            const stB = computeSideStats(MH.ops, 'b');
                            [[MH.labelA, stA], [MH.labelB, stB]].forEach(([label, st]) => {
                                const totalAll = st.total + st.missing;
                                const pct = n => totalAll ? Math.round(n / totalAll * 1000) / 10 : 0;
                                ensure(60);
                                doc.setDrawColor(226, 232, 240); doc.line(M, y, pageW - M, y); y += 14;
                                line(label, 14, 'bold', [15, 23, 42], 2);
                                line(`Operations: ${totalAll}   Good: ${pct(st.total - st.bad)}%   Bad: ${pct(st.bad)}%   No Data: ${pct(st.missing)}%`, 10, 'normal', [30, 34, 51], 2);
                                line(`Fault side \u2014 Current: ${pct(st.curBad)}%`, 10, 'normal', [30, 34, 51], 4);
                                const sortedFaults = Object.keys(st.faultCount).sort((a, b) => st.faultCount[b] - st.faultCount[a]).slice(0, TOP_FAULTS_N);
                                if (sortedFaults.length) {
                                    line('Top faults: ' + sortedFaults.map(f => `${f} ${st.faultCount[f]} (${st.bad ? Math.round(st.faultCount[f] / st.bad * 1000) / 10 : 0}%)`).join('   |   '), 9, 'normal', [90, 100, 120], 4);
                                }
                            });

                            try {
                                const el = document.getElementById('monthlyTimeline');
                                const png = await Plotly.toImage(el, { format: 'png', width: 1000, height: 320 });
                                const imgH = contentW * 320 / 1000;
                                ensure(imgH + 20);
                                line('Monthly Health Timeline', 11, 'bold', [100, 116, 139], 4);
                                doc.addImage(png, 'PNG', M, y, contentW, imgH); y += imgH + 10;
                            } catch (e) { /* skip the chart if it fails to render */ }

                            const safeAsset = (pm ? pm.assetName : 'asset').replace(/[\\/:*?"<>|]+/g, ' ').trim();
                            doc.save(`point machine health ${safeAsset}.pdf`);
                        } catch (e) {
                            alert('PDF generation failed: ' + e.message);
                        } finally {
                            if (btn) { btn.disabled = false; btn.style.opacity = '1'; btn.style.cursor = 'pointer'; btn.innerHTML = origHtml; }
                        }
                    }

                    function showMonthlyDetail(op, side, label) {
                        const p = side === 'a' ? op.aPrediction : op.bPrediction;
                        const cur = side === 'a' ? op.aCur : op.bCur;
                        const volt = side === 'a' ? op.aVolt : op.bVolt;
                        const det = document.getElementById('monthlyDetail');
                        const badgeClass = (p && p.label === 'Abnormal') ? 'abnormal' : 'normal';
                        // No specific type on Abnormal -> "Unclassified" (matches summary chip).
                        const typeList = ((p && p.types) || []).map(t => `${t.type} (${t.confidence}%)`);
                        const faults = typeList.length ? typeList.join(', ')
                            : (p && p.label === 'Abnormal' ? 'Unclassified' : 'None');

                        det.style.display = 'block';
                        // Direction ("Normal"/"Reverse") comes straight from the record - which way the
                        // point machine threw for this operation, not related to the A/B side.
                        if (p && p.status === 'nodata') {
                            det.innerHTML = `
                                                                    <div class="card-title"><span>${label} \u00b7 ${op.time.toLocaleString()}</span>
                                                                        <span style="background:var(--bg-tertiary); color:var(--text-muted); border:1px solid var(--border); border-radius:6px; padding:2px 10px; font-size:11px; font-weight:700;">NO DATA</span></div>
                                                                    <div style="font-size:13px; color:var(--text-muted); margin-top:8px;">Signal data for this operation is missing (current/voltage record empty) \u2014 therefore no prediction was made.</div>`;
                            det.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                            return;
                        }
                        det.innerHTML = `
                                                                <div class="card-title"><span>${label} \u00b7 ${op.time.toLocaleString()}</span>
                                                                    <span class="hist-badge ${badgeClass}">${p ? p.label : 'pending'}</span></div>
                                                                <div style="font-size:12px; color:var(--text-secondary); margin:6px 0 10px;">
                                                                    Component: <b>${(p && p.component) || '\u2014'}</b> \u00b7 Confidence: <b>${p ? p.confidence : '--'}%</b> \u00b7 Fault: <b>${faults}</b> \u00b7 Direction: <b>${op.direction || '\u2014'}</b></div>
                                                                <div style="display:flex; gap:12px; flex-wrap:wrap;">
                                                                    <div class="chart-box" style="height:230px; width:50%; min-width:320px; flex:1;"><div id="mhDetailCurrent" style="width:100%; height:100%;"></div></div>
                                                                    <div class="chart-box" style="height:230px; width:50%; min-width:320px; flex:1;"><div id="mhDetailVoltage" style="width:100%; height:100%;"></div></div>
                                                                </div>`;

                        // Plotly area charts (14-Aug-2026), same look as Model 2's charts - toolbar
                        // (zoom/pan/camera/reset) included. Voltage is shown here for reference
                        // ONLY - the model is current-only and never sees it.
                        plotCurrentM1('mhDetailCurrent', cur, 'Current (A)', 230);
                        plotCurrentM1('mhDetailVoltage', volt, 'Voltage (V)', 230, '#0d9488');
                        det.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    }

                    // ==================== PREDICTION ====================
                    // ACTIVE MODEL = PyTorch (SignalModel), run SERVER-SIDE via /api/predict
                    // (see predictBatch below). The client-side XGBoost tree evaluator that used
                    // to live in this file (runModelPrediction / extractFeatures / evalTree /
                    // f32 / FEATURE_NAMES / predictBinaryLike / predictMultiClass) is now DEAD
                    // CODE - nothing calls it. Left in place only for reference; safe to delete.

                    const FEATURE_NAMES = ["duration", "max_current", "avg_current", "min_current", "inrush_current", "plateau_current", "end_current", "current_std", "current_pegged_ratio", "avg_voltage", "min_voltage", "inrush_min_v", "plateau_std_v", "voltage_recovery"];

                    let modelBundle = { TWS: null, IRS: null };
                    let modelLoaded = false;

                    async function initModels() {
                        setPredictStatus('pending', 'Loading models...');
                        try {
                            const [twsRes, irsRes] = await Promise.all([
                                fetch(`${PM_ENDPOINTS.modelJson}?waveType=TWS`).then(r => r.ok ? r.json() : null),
                                fetch(`${PM_ENDPOINTS.modelJson}?waveType=IRS`).then(r => r.ok ? r.json() : null)
                            ]);
                            modelBundle.TWS = twsRes;
                            modelBundle.IRS = irsRes;
                        } catch (e) {
                            console.error('Model status check failed:', e);
                            modelBundle.TWS = null;
                            modelBundle.IRS = null;
                        }
                        onWaveModelSwitch(getActiveWaveTypes());
                    }

                    // Client-side XGBoost tree evaluator inference
                    async function predictBatch(waveType, items) {
                        const model = modelBundle[waveType];
                        if (!model) {
                            return items.map(() => ({
                                status: 'error',
                                wave_type: waveType,
                                label: null,
                                confidence: 0,
                                component: null,
                                types: [],
                                error: `Model not loaded for ${waveType}`
                            }));
                        }
                        // Using 20.0 as default polling, can be adjusted if needed
                        return items.map(item => runModelPrediction(model, item.current, item.voltage, 20.0));
                    }

                    // Batch-predict every loaded reading, each side (A/B) against its OWN wave
                    // type's model - the two sides can differ (Asset.ThickWaveTypeId), so this
                    // takes a {a,b} pair instead of one shared waveType applied to both.
                    async function applyPredictionsToReadings(waves) {
                        const itemsA = [], itemsB = [];
                        S.recentReadings.forEach(r => {
                            r.aPrediction = null; r.bPrediction = null;
                            if (waves.a && (r.aCur.length || r.aVolt.length)) itemsA.push([r, { current: r.aCur, voltage: r.aVolt }]);
                            if (waves.b && (r.bCur.length || r.bVolt.length)) itemsB.push([r, { current: r.bCur, voltage: r.bVolt }]);
                        });
                        if (itemsA.length) {
                            const preds = await predictBatch(waves.a, itemsA.map(([, it]) => it));
                            preds.forEach((p, i) => { itemsA[i][0].aPrediction = p; });
                        }
                        if (itemsB.length) {
                            const preds = await predictBatch(waves.b, itemsB.map(([, it]) => it));
                            preds.forEach((p, i) => { itemsB[i][0].bPrediction = p; });
                        }
                    }

                    // waves: {a,b} - the wave type actually needed for each side of the current
                    // asset (or the manually-forced override, same value on both sides).
                    function onWaveModelSwitch(waves) {
                        modelLoaded = true;  // initModels() has already run its fetch attempt by now
                        // No point machine picked yet (e.g. page just loaded) - this is the normal
                        // empty state, not a real "unresolved" error. Only say "unresolved" once an
                        // actual asset is selected and ITS wave type genuinely can't be resolved.
                        if (!S.selectedAsset) {
                            setPredictStatus('pending', 'Select a point machine to check model status');
                            return;
                        }
                        const need = neededWaves(waves);
                        if (!need.length) {
                            setPredictStatus('err', 'Wave type unresolved for this asset - cannot predict');
                            return;
                        }
                        const missing = need.filter(w => !modelBundle[w]);
                        if (!missing.length) {
                            setPredictStatus('ok', `Model${need.length > 1 ? 's' : ''} ready (${need.join(' & ')})`);
                        } else {
                            setPredictStatus('err', `No model loaded for ${missing.join(', ')}`);
                        }
                    }

                    function extractFeatures(current, voltage, polling) {
                        polling = polling || 20.0;
                        const cur = (current && current.length) ? current.map(Number) : [0];
                        const volt = (voltage && voltage.length) ? voltage.map(Number) : [0];
                        const n = Math.max(cur.length, volt.length);
                        const duration = n * polling / 1000.0;

                        const maxOf = a => Math.max(...a);
                        const minOf = a => Math.min(...a);
                        const meanOf = a => a.reduce((s, v) => s + v, 0) / a.length;
                        const stdOf = a => { const m = meanOf(a); return Math.sqrt(meanOf(a.map(v => (v - m) * (v - m)))); };
                        const medianOf = a => { const s = [...a].sort((x, y) => x - y); const mid = Math.floor(s.length / 2); return s.length % 2 ? s[mid] : (s[mid - 1] + s[mid]) / 2; };

                        const max_current = maxOf(cur);
                        const avg_current = meanOf(cur);
                        const min_current = minOf(cur);

                        const inrushEnd = Math.max(3, Math.floor(cur.length * 0.15));
                        const inrush_current = maxOf(cur.slice(0, inrushEnd));

                        const pStart = Math.floor(cur.length * 0.20), pEnd = Math.floor(cur.length * 0.85);
                        const plateauSlice = pEnd > pStart ? cur.slice(pStart, pEnd) : cur;
                        const plateau_current = plateauSlice.length ? medianOf(plateauSlice) : avg_current;

                        const endSlice = cur.length > 10 ? cur.slice(Math.floor(cur.length * 0.90)) : cur;
                        const end_current = endSlice.length ? maxOf(endSlice) : 0.0;

                        const current_std = stdOf(cur);
                        const peggedTol = max_current > 0 ? 0.1 * max_current : 0.1;
                        const peggedCount = cur.filter(v => Math.abs(v - max_current) <= peggedTol).length;
                        const current_pegged_ratio = cur.length ? peggedCount / cur.length : 0.0;

                        const avg_voltage = meanOf(volt);
                        const min_voltage = minOf(volt);

                        const vInrushEnd = Math.max(3, Math.floor(volt.length * 0.20));
                        const inrushSlice = volt.length > 1 ? volt.slice(1, vInrushEnd) : volt;
                        const inrush_min_v = inrushSlice.length ? minOf(inrushSlice) : min_voltage;

                        const vpStart = Math.floor(volt.length * 0.20), vpEnd = Math.floor(volt.length * 0.85);
                        const vPlateau = vpEnd > vpStart ? volt.slice(vpStart, vpEnd) : volt;
                        const plateau_std_v = vPlateau.length > 1 ? stdOf(vPlateau) : 0.0;
                        const plateau_mean_v = vPlateau.length ? meanOf(vPlateau) : avg_voltage;

                        const voltage_recovery = plateau_mean_v - inrush_min_v;

                        return { duration, max_current, avg_current, min_current, inrush_current, plateau_current, end_current, current_std, current_pegged_ratio, avg_voltage, min_voltage, inrush_min_v, plateau_std_v, voltage_recovery };
                    }

                    function featuresToVector(feat) { return FEATURE_NAMES.map(k => feat[k]); }

                    // float32 rounding, matching XGBoost's internal training/inference precision.
                    // Without this, a feature value can compare on the wrong side of a split
                    // threshold near a boundary - this was the actual bug behind an earlier
                    // ~5% prediction mismatch during validation, not a math error in the formula.
                    function f32(x) { return Math.fround(x); }

                    function evalTree(node, fv) {
                        while (!('leaf' in node)) {
                            const idx = parseInt(node.split.slice(1), 10);
                            const fval = f32(fv[idx]);
                            const cond = f32(node.split_condition);
                            const next = fval < cond ? node.yes : node.no;
                            node = node.children.find(c => c.nodeid === next);
                        }
                        return node.leaf;
                    }

                    function sigmoid(x) { return 1.0 / (1.0 + Math.exp(-x)); }
                    function logit(p) { return Math.log(p / (1 - p)); }
                    function softmax(v) {
                        const m = Math.max(...v);
                        const ex = v.map(x => Math.exp(x - m));
                        const s = ex.reduce((a, b) => a + b, 0);
                        return ex.map(e => e / s);
                    }

                    // binary:logistic heads (the binary Normal/Abnormal gate, and each one-vs-rest
                    // fault-type head) - base_score is stored as a PROBABILITY (always 0.5 here),
                    // converted to a margin via logit() before adding to the summed tree leaves.
                    function predictBinaryLike(head, fv) {
                        const margin0 = logit(head.base_score);
                        const margin = margin0 + head.trees.reduce((s, t) => s + evalTree(t, fv), 0);
                        return sigmoid(margin);
                    }

                    // multi:softprob head (the C/V/V-C component classifier) - base_score is
                    // already a per-class margin bias here, added directly before softmax.
                    // Trees are grouped round-robin by class: tree i belongs to class i % num_class.
                    function predictMultiClass(head, fv) {
                        const nc = head.num_class;
                        const margins = head.base_score.slice();
                        head.trees.forEach((t, i) => { margins[i % nc] += evalTree(t, fv); });
                        return softmax(margins);
                    }

                    function runModelPrediction(modelJson, current, voltage, polling) {
                        const feat = extractFeatures(current, voltage, polling);
                        const fv = featuresToVector(feat);

                        const probAbnormal = predictBinaryLike(modelJson.binary, fv);
                        const isAbnormal = probAbnormal >= 0.5;

                        const result = {
                            status: 'success',
                            wave_type: modelJson.wave,
                            label: isAbnormal ? 'Abnormal' : 'Normal',
                            confidence: Math.round((isAbnormal ? probAbnormal : 1 - probAbnormal) * 1000) / 10,
                            component: null,
                            types: [],
                            features: feat,
                        };
                        if (!isAbnormal) return result;

                        if (modelJson.component) {
                            const probs = predictMultiClass(modelJson.component, fv);
                            const best = probs.indexOf(Math.max(...probs));
                            result.component = modelJson.component.classes[best];
                        } else {
                            result.component = 'C';
                        }

                        const fired = [];
                        Object.entries(modelJson.types || {}).forEach(([name, head]) => {
                            const p = predictBinaryLike(head, fv);
                            if (p > 0.5) fired.push({ type: name, confidence: Math.round(p * 1000) / 10 });
                        });
                        fired.sort((a, b) => b.confidence - a.confidence);
                        result.types = fired;

                        return result;
                    }

                    // Inline HTML "on*=" attribute handlers (both the static ones in the markup,
                    // e.g. onchange="onSiteChange()", and the ones generated dynamically via
                    // innerHTML, e.g. onclick="selectPointMachine(3)") always execute in the
                    // GLOBAL scope, never inside this IIFE's closure - so every function they
                    // call has to be explicitly exposed on window, or the browser throws
                    // "<fn> is not defined" the moment the attribute fires.
                    window.onSiteChange = onSiteChange;
                    window.toggleSidebar = toggleSidebar;
                    window.loadSites = loadSites;
                    window.fetchPointMachines = fetchPointMachines;
                    window.selectPointMachine = selectPointMachine;
                    window.loadAbStroke = loadAbStroke;
                    window.toggleSignal = toggleSignal;
                    window.analyzeMonthlyHealth = analyzeMonthlyHealth;
                    window.switchAnalysisMode = switchAnalysisMode;
                    window.validateDateRange = validateDateRange;
                    window.applyCustomDates = applyCustomDates;
                    window.toggleFaultFilter = toggleFaultFilter;
                    window.exportSiteJson = exportSiteJson;
                    window.exportMonthlyJson = exportMonthlyJson;
                    window.exportMonthlyPdf = exportMonthlyPdf;

                    // Read-only state ref so the top-level pmSwitch() (outside this IIFE) can
                    // carry the selected point machine over when the user switches model tabs.
                    window.__pmState1 = S;

                })();
            </script>
        </div><!-- /#model1-wrap -->

        <div id="model2-wrap" class="pm-combined-section">

