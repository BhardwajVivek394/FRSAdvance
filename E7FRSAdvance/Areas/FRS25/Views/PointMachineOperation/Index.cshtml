        <script>
            (function () {
                // endpoints injected

                const S4 = { sites: [], assets: [], currentSiteId: null, selectedAsset: null };

                async function loadSites4() {
                    try {
                        const r = await fetch(PM4_ENDPOINTS.sites);
                        S4.sites = await r.json();
                        const sel = document.getElementById('siteSelect4');
                        sel.innerHTML = '<option value="">-- Select Site --</option>' +
                            S4.sites.map(s => `<option value="${s.SiteId}">${s.SiteName} (${s.SiteId})</option>`).join('');
                    } catch (e) {
                        document.getElementById('siteSelect4').innerHTML = '<option>Failed to load sites</option>';
                    }
                }

                function waveChipsFor4(pm) {
                    if (pm.unresolved) return '<span class="wave-chip unresolved">wave type unresolved</span>';
                    if (pm.mixed) return `<span class="wave-chip mixed">A=${pm.aWave} / B=${pm.bWave}</span>`;
                    const w = pm.aWave || pm.bWave;
                    return `<span class="wave-chip ${w.toLowerCase()}">${w}</span>`;
                }

                async function fetchAssets4() {
                    const siteId = document.getElementById('siteSelect4').value;
                    if (!siteId) { alert('Select a site first'); return; }
                    S4.currentSiteId = siteId;
                    const btn = document.getElementById('fetchPmBtn4');
                    btn.disabled = true;
                    const originalLabel = btn.textContent;
                    btn.textContent = 'Fetching\u2026';
                    document.getElementById('pmList4').innerHTML = '<div style="text-align:center; padding:24px 0;"><span class="spinner"></span><div style="margin-top:8px; color:var(--text-muted); font-size:12px;">Fetching point machines\u2026</div></div>';
                    try {
                        const r = await fetch(`${PM4_ENDPOINTS.assets}?SiteId=${encodeURIComponent(siteId)}`);
                        S4.assets = await r.json();
                        document.getElementById('pmCount4').textContent = `(${S4.assets.length})`;
                        const list = document.getElementById('pmList4');
                        list.innerHTML = S4.assets.map((pm, i) => `
                                                        <div class="pm-item" onclick="selectAsset4(${i})" id="pm4-${i}">
                                                            <div class="pm-name">${pm.assetName}</div>
                                                            ${waveChipsFor4(pm)}
                                                        </div>`).join('');
                        document.getElementById('custom-pm-select4').innerHTML = '<option value="">-- Select --</option>' +
                            S4.assets.map((pm, i) => `<option value="${i}">${pm.assetName}</option>`).join('');
                        document.getElementById('quick-pm-select4').innerHTML = '<option value="">-- Select --</option>' +
                            S4.assets.map((pm, i) => `<option value="${i}">${pm.assetName}</option>`).join('');
                        document.getElementById('watchlistBtn4').style.display = 'block';
                        await renderWatchlist4();   // land on the ranked watchlist after fetching
                    } catch (e) {
                        document.getElementById('pmList4').innerHTML = '';
                        alert('Failed to fetch point machines: ' + e.message);
                    }
                    btn.disabled = false;
                    btn.textContent = originalLabel;
                }

                // Division watchlist: every analyzed machine (per A/B side) ranked by failure
                // risk. This is the Palakkad headline view - "which machines to inspect first".
                const STATE_COLORS4 = { URGENT: '#dc2626', 'MAINTAIN-SOON': '#ea580c', WATCH: '#ca8a04', NORMAL: '#16a34a', LEARNING: '#94a3b8' };

                async function renderWatchlist4(forceLive = false) {
                    const wl = document.getElementById('watchlist4');
                    document.getElementById('emptyState4').style.display = 'none';
                    document.getElementById('results4').style.display = 'none';
                    document.querySelectorAll('#model4-wrap .pm-item').forEach(el => el.classList.remove('active'));
                    wl.style.display = 'block';
                    wl.innerHTML = `<div class="card"><div class="card-title">Station Watchlist</div><div style="color:var(--text-muted);">${forceLive ? 'Rebuilding' : 'Loading'} \u2014 ranking machines by failure risk\u2026</div></div>`;
                    try {
                        const r = await fetch(`${PM4_ENDPOINTS.watchlist}?SiteId=${encodeURIComponent(S4.currentSiteId)}${forceLive ? '&ForceLive=true' : ''}`);
                        const data = await r.json();
                        const machines = data.machines || [];
                        const idxById = {}, nameById = {};
                        S4.assets.forEach((a, i) => { idxById[a.assetId] = i; nameById[a.assetId] = a.assetName; });
                        const rows = machines.map(m => {
                            const col = STATE_COLORS4[m.state] || '#94a3b8';
                            const idx = idxById[m.assetId];
                            const risers = (m.rising || []).map(f => `${TREND_LABELS4[f] || f} +${m.trends[f]}%/100 ops`).join(', ') || '\u2014';
                            const nm = nameById[m.assetId] || ('Asset ' + m.assetId);
                            const click = idx != null ? `onclick="selectAsset4(${idx})" style="cursor:pointer;"` : 'style="opacity:0.6;"';
                            return `<tr ${click}>
                                                            <td style="padding:8px 10px;"><b>${escapeHtml4(nm)}</b> \u00b7 Machine ${escapeHtml4(m.side)}</td>
                                                            <td style="padding:8px 10px;"><span style="font-weight:700; padding:3px 9px; border-radius:12px; background:${col}1a; color:${col}; border:1px solid ${col}55;">${escapeHtml4(m.state)}</span></td>
                                                            <td style="padding:8px 10px; color:var(--text-muted);">${escapeHtml4(m.wave)} \u00b7 dir-${escapeHtml4(m.worstDirection)}</td>
                                                            <td style="padding:8px 10px; color:#dc2626; font-weight:700; text-align:center;">${m.counts.FAULT || 0}</td>
                                                            <td style="padding:8px 10px; color:#ea580c; text-align:center;">${m.counts.ALERT || 0}</td>
                                                            <td style="padding:8px 10px; font-size:12px;">${escapeHtml4(risers)}</td>
                                                        </tr>`;
                        }).join('');
                        const gen = data.generated_at ? new Date(data.generated_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) : '';
                        const src = data._from_cache ? 'cached' : 'freshly built';
                        wl.innerHTML = `<div class="card">
                                                        <div class="card-title"><span>Station Watchlist \u2014 ${machines.length} machines</span><span style="font-weight:500; text-transform:none;">${src}${gen ? ' \u00b7 ' + gen : ''} \u00b7 <a href="#" onclick="renderWatchlist4(true);return false;" style="color:var(--accent); font-weight:700;">\u21bb Rebuild now</a></span></div>
                                                        <div style="overflow-x:auto;"><table style="width:100%; border-collapse:collapse; font-size:13px;">
                                                          <thead><tr style="text-align:left; color:var(--text-muted); font-size:11px; text-transform:uppercase; border-bottom:2px solid var(--border);">
                                                            <th style="padding:8px 10px;">Machine</th><th style="padding:8px 10px;">State</th><th style="padding:8px 10px;">Type \u00b7 worst dir</th>
                                                            <th style="padding:8px 10px; text-align:center;">Fault</th><th style="padding:8px 10px; text-align:center;">Alert</th><th style="padding:8px 10px;">Worsening trend</th></tr></thead>
                                                          <tbody>${rows || '<tr><td colspan="6" style="padding:14px; color:var(--text-muted);">No analyzed machines cached yet. Click a machine in the sidebar to analyze it, then it appears here.</td></tr>'}</tbody>
                                                        </table></div>
                                                        <div style="margin-top:8px; font-size:11px; color:var(--text-muted);">Re-graded from each machine's last-fetched data with the current engine. Open a machine and hit \u201cUpdate Results\u201d for a live refresh.</div>
                                                    </div>`;
                    } catch (e) {
                        wl.innerHTML = `<div class="card"><div class="banner warn">Watchlist failed: ${escapeHtml4(e.message)}</div></div>`;
                    }
                }

                // Renders {verdict, points, recommendation} as a scannable bullet list -
                // same contract/shape as the other 3 modules' AI summary.
                function renderSummaryBullets4(data) {
                    if (!data || typeof data !== 'object' || Array.isArray(data)) {
                        return `<span>${escapeHtml4(data || 'No summary returned.')}</span>`;
                    }
                    const points = Array.isArray(data.points) ? data.points : [];
                    const bullets = points.map(p => `<li style="margin-bottom:4px;">${escapeHtml4(p)}</li>`).join('');
                    return `<div style="font-weight:800; font-size:14px; margin-bottom:6px;">${escapeHtml4(data.verdict)}</div>`
                        + (bullets ? `<ul style="margin:0 0 6px 18px; padding:0;">${bullets}</ul>` : '')
                        + (data.recommendation ? `<div style="margin-top:4px;"><b>Recommendation:</b> ${escapeHtml4(data.recommendation)}</div>` : '');
                }

                function escapeHtml4(s) {
                    const d = document.createElement('div');
                    d.textContent = s == null ? '' : String(s);
                    return d.innerHTML;
                }

                async function selectAsset4(idx) {
                    document.querySelectorAll('#model4-wrap .pm-item').forEach(el => el.classList.remove('active'));
                    document.getElementById(`pm4-${idx}`).classList.add('active');
                    const pm = S4.assets[idx];
                    S4.selectedAsset = pm;
                    S4.selectedIdx = idx;
                    const pmSelect = document.getElementById('custom-pm-select4');
                    if (pmSelect) pmSelect.value = String(idx);
                    const quickSelect = document.getElementById('quick-pm-select4');
                    if (quickSelect) quickSelect.value = String(idx);
                    updateCompactSidebar4();
                    const sidebarEl4 = document.querySelector('#model4-wrap .sidebar');
                    if (sidebarEl4 && !sidebarEl4.classList.contains('collapsed')) toggleSidebar4(true);
                    await runAnalyze4(pm, false);
                }

                let currentAnalysisMode4 = 'quick';   // 'quick' or 'custom'

                function switchAnalysisMode4(mode) {
                    currentAnalysisMode4 = mode;
                    document.getElementById('mode-quick-btn4').classList.toggle('active', mode === 'quick');
                    document.getElementById('mode-custom-btn4').classList.toggle('active', mode === 'custom');
                    document.getElementById('custom-date-panel4').style.display = mode === 'custom' ? 'block' : 'none';
                    document.getElementById('pm-list-section4').style.display = mode === 'custom' ? 'none' : 'block';
                    updateCompactSidebar4();
                    if (mode === 'custom') {
                        const today = new Date().toISOString().split('T')[0];
                        const past30 = new Date(); past30.setDate(past30.getDate() - 30);
                        const fromInput = document.getElementById('custom-from-date4');
                        const toInput = document.getElementById('custom-to-date4');
                        if (!toInput.value) toInput.value = today;
                        if (!fromInput.value) fromInput.value = past30.toISOString().split('T')[0];
                        toInput.max = today; fromInput.max = today;
                        validateDateRange4();
                    }
                }

                function getCustomRange4() {
                    const fromVal = document.getElementById('custom-from-date4').value;
                    const toVal = document.getElementById('custom-to-date4').value;
                    if (!fromVal || !toVal) return null;
                    const fromTime = (document.getElementById('custom-from-time4').value || '00:00:00');
                    const toTime = (document.getElementById('custom-to-time4').value || '23:59:59');
                    const fullFromTime = fromTime.length === 5 ? fromTime + ':00' : fromTime;
                    const fullToTime = toTime.length === 5 ? toTime + ':00' : toTime;
                    return {
                        startDate: new Date(`${fromVal}T${fullFromTime}`),
                        endDate: new Date(`${toVal}T${fullToTime}`),
                    };
                }

                function validateDateRange4() {
                    const errorEl = document.getElementById('date-range-error4');
                    const applyBtn = document.getElementById('apply-custom-dates-btn4');
                    const range = getCustomRange4();
                    if (!range) { errorEl.style.display = 'none'; applyBtn.disabled = true; return false; }
                    const diffDays = (range.endDate - range.startDate) / (1000 * 60 * 60 * 24);
                    if (diffDays < 0) {
                        errorEl.innerHTML = '\u26a0\ufe0f <b>Invalid range:</b> "To" cannot be before "From".';
                        errorEl.style.display = 'block'; applyBtn.disabled = true; return false;
                    }
                    if (diffDays > 90) {
                        errorEl.innerHTML = `\u26a0\ufe0f <b>Limit exceeded:</b> selected range (${diffDays.toFixed(1)} days) exceeds the 90-day max.`;
                        errorEl.style.display = 'block'; applyBtn.disabled = true; return false;
                    }
                    errorEl.style.display = 'none'; applyBtn.disabled = false; return true;
                }

                function applyCustomDates4() {
                    const idx = document.getElementById('custom-pm-select4').value;
                    if (idx === '') { alert('Select a point machine first.'); return; }
                    if (!validateDateRange4()) return;
                    const pm = S4.assets[idx];
                    S4.selectedAsset = pm;
                    S4.selectedIdx = idx;
                    document.querySelectorAll('#model4-wrap .pm-item').forEach(el => el.classList.remove('active'));
                    const el = document.getElementById(`pm4-${idx}`);
                    if (el) el.classList.add('active');
                    const quickSelect = document.getElementById('quick-pm-select4');
                    if (quickSelect) quickSelect.value = String(idx);
                    updateCompactSidebar4();
                    const sidebarEl4b = document.querySelector('#model4-wrap .sidebar');
                    if (sidebarEl4b && !sidebarEl4b.classList.contains('collapsed')) toggleSidebar4(true);
                    runAnalyze4(pm, true);
                }

                async function runAnalyze4(pm, forceLive) {
                    document.getElementById('emptyState4').style.display = 'none';
                    document.getElementById('watchlist4').style.display = 'none';
                    document.getElementById('results4').style.display = 'none';

                    let rangeParams = '';
                    if (currentAnalysisMode4 === 'custom') {
                        if (!validateDateRange4()) {
                            document.getElementById('emptyState4').style.display = 'block';
                            document.getElementById('emptyState4').textContent = 'Pick a valid custom date range first.';
                            return;
                        }
                        const range = getCustomRange4();
                        const fmt = d => d.toISOString().slice(0, 19);
                        rangeParams = `&StartDate=${encodeURIComponent(fmt(range.startDate))}&EndDate=${encodeURIComponent(fmt(range.endDate))}`;
                        S4.lastRangeLabel = `${range.startDate.toLocaleDateString()} \u2192 ${range.endDate.toLocaleDateString()} (custom)`;
                        forceLive = true;
                    } else {
                        S4.lastRangeLabel = 'last 30 days';
                    }

                    document.getElementById('loading-text4').textContent = forceLive ? 'Analyzing\u2026' : 'Loading from cache\u2026';
                    document.getElementById('loading4').style.display = 'flex';

                    try {
                        const siteObj = (S4.sites || []).find(s => String(s.SiteId) === String(S4.currentSiteId));
                        const siteName = (siteObj && siteObj.SiteName) || '';
                        const url = `${PM4_ENDPOINTS.analyze}?SiteId=${encodeURIComponent(S4.currentSiteId)}&AssetId=${encodeURIComponent(pm.assetId)}&WindowDays=30`
                            + `&AssetName=${encodeURIComponent(pm.assetName)}&SiteName=${encodeURIComponent(siteName)}`
                            + (forceLive ? '&ForceLive=true' : '')
                            + rangeParams;
                        const r = await fetch(url);
                        const data = await r.json();
                        if (!r.ok) throw new Error(data.detail || `HTTP ${r.status}`);
                        S4.lastData = data;
                        renderResults4(pm, data);
                    } catch (e) {
                        document.getElementById('loading4').style.display = 'none';
                        document.getElementById('results4').style.display = 'block';
                        document.getElementById('results4').innerHTML = `<div class="banner warn">Analysis failed: ${escapeHtml4(e.message)}</div>`;
                    }
                }

                function updateCurrentAsset4() {
                    if (S4.selectedAsset) runAnalyze4(S4.selectedAsset, true);
                }

                // Human-readable labels for the current-only validity gate reasons.
                const FILTER_LABELS4 = {
                    no_data: 'Too few samples', too_short: 'Stroke too short',
                    no_load: 'No load (current too low)', sensor_garbage: 'Sensor garbage (current out of range)',
                };

                function sideSummary4(ops) {
                    const counts = { NORMAL: 0, WATCH: 0, ALERT: 0, FAULT: 0, INVALID: 0 };
                    const conditions = {};
                    const filtered = {};   // gate reason -> count, for the INVALID (not-scored) ops
                    ops.forEach(o => {
                        const c = o.confirmed || (o.grade === 'INVALID' ? 'INVALID' : null);
                        if (c && counts[c] !== undefined) counts[c]++;
                        if (o.grade === 'INVALID') {
                            const reason = o.reason || 'unknown';
                            filtered[reason] = (filtered[reason] || 0) + 1;
                        }
                        if (o.condition && o.condition !== '-') {
                            o.condition.split('+').forEach(cond => { conditions[cond] = (conditions[cond] || 0) + 1; });
                        }
                    });
                    return { counts, conditions, filtered, total: ops.length };
                }

                // Plain-English names for the raw feature keys, so "Grade drivers: rise_span,
                // late_peak_pos" reads as something a maintainer actually understands.
                const FEATURE_LABELS4 = {
                    throw_time: 'stroke took longer', i_inrush: 'startup current spike', i_run: 'higher running current',
                    i_trough: 'higher lowest-current', i_late_peak: 'bigger late current peak',
                    end_rise: 'current rises at the end', end_rise_amps: 'size of the end-rise',
                    late_peak_pos: 'late peak in an unusual place', rise_span: 'end-rise lasts unusually long',
                    pegged: 'current stuck near max', i_tail: 'current at cut-off', work: 'more energy used per stroke',
                    ripple: 'current less steady', shape_dist: 'overall shape has drifted', novelty_z: 'AI flagged an unusual shape',
                };
                function humanizeDrivers4(reason) {
                    if (!reason) return '';
                    return reason.split(',').map(f => FEATURE_LABELS4[f.trim()] || f.trim()).join(', ');
                }

                // Short plain-English names for the trend-chip drivers (shown on the STATE
                // chips, e.g. "running current +22%/100 ops" instead of "i_run +21.9%/100").
                const TREND_LABELS4 = {
                    i_run: 'running current', i_trough: 'lowest current',
                    end_rise: 'end-of-stroke rise', work: 'energy per stroke',
                };

                // Plain-English meaning of every grade / state, shown as a legend so users know
                // what NORMAL / WATCH / MAINTAIN-SOON / URGENT actually mean.
                const GRADE_INFO4 = {
                    NORMAL: 'Healthy \u2014 matches this machine\'s own normal.',
                    WATCH: 'Slightly off on one reading \u2014 logged, not urgent.',
                    ALERT: 'Clearly deviating on two or more readings vs its own history.',
                    FAULT: 'Strongly deviating / crossed a hard limit on this stroke.',
                    'MAINTAIN-SOON': 'Has bad strokes but is stable (not getting worse) \u2014 fix on the next maintenance round.',
                    URGENT: 'Has bad strokes AND is measurably getting worse \u2014 inspect soon.',
                };

                // What each detector condition means - see pm_operation2/files.../ADDING_EXCEPTION_TYPES.md
                // and SCHEME_UPDATE_REFERENCES.md. "calib" notes how solid the threshold is.
                const CONDITION_INFO4 = {
                    'END-FRICTION': { text: 'Friction right at the end of the stroke - current dips after the initial rush, then rises again sharply just before cut-off (a late secondary peak). Calibrated from 13 real SSE-confirmed strokes (end_rise 1.59-2.71).', calib: 'Calibrated (SSE sheet, n=13)' },
                    'CREEPING': { text: 'Same late-rise signature as END-FRICTION, but stretched out gradually instead of sharp - a slow, dragging finish rather than a quick friction spike. Often points to binding or a mechanism that needs lubrication rather than acute damage.', calib: 'Calibrated (SSE sheet, n=13)' },
                    'OBSTRUCTION': { text: 'Current stays pegged near maximum for most of an unusually long stroke - the classic signature of something physically blocking the switch from completing its throw.', calib: 'Provisional (reference panels only, not yet SSE-confirmed)' },
                    'SLAGGING': { text: 'The running current floor is elevated well above this specific machine\'s own normal history - relative only, so a machine that has always run a bit high is not flagged as newly slagging.', calib: 'Provisional (no SSE sheet yet)' },
                    'SIGNATURE-CHANGE': { text: 'The overall shape of the stroke has drifted from this machine\'s own median shape, even though no single number crosses a hard threshold - catches gradual degradation that looks fine machine-by-machine but reads differently over time.', calib: 'Provisional (no SSE sheet yet)' },
                    'UNUSUAL-SHAPE': { text: 'An AI model that has seen thousands of healthy strokes says this stroke\'s shape does not look like a healthy one - even if it matches no named fault. This is how problems the fixed rules were never told about still get caught.', calib: 'AI model (learns healthy shapes), fleet-trained' },
                };

                // Where on the overlaid graph to look for each condition, in plain words - so a
                // small difference (e.g. SLAGGING) is not just visible but explained.
                const CONDITION_LOOK4 = {
                    'END-FRICTION': 'the very end (right side) \u2014 the red line jumps up into a late bump the green one does not have.',
                    'CREEPING': 'the late part \u2014 the red line drifts upward gradually instead of staying flat like the green.',
                    'OBSTRUCTION': 'the middle plateau \u2014 the red line stays pegged near its maximum far longer than the green.',
                    'SLAGGING': 'the running floor (the low middle dip) \u2014 the red line sits noticeably HIGHER than the green, i.e. the motor pulls more current throughout the stroke.',
                    'SIGNATURE-CHANGE': 'the overall shape \u2014 the red line departs from the green in a way no single feature explains.',
                    'UNUSUAL-SHAPE': 'the overall shape \u2014 wherever the red line and green line diverge is what the AI found unusual.',
                };

                // Approximate [start%, end%] of stroke progress (0-100, matching the 100-point
                // resampled x-axis) where each condition's signature actually shows up -
                // mirrors CONDITION_LOOK4's own wording. Conditions with no single localized
                // region (a whole-shape difference) are omitted - no band is drawn for those.
                const CONDITION_REGION4 = {
                    'END-FRICTION': [82, 100],
                    'CREEPING': [60, 92],
                    'OBSTRUCTION': [32, 68],
                    'SLAGGING': [20, 80],
                };

                function renderSideCard4(label, side, sideKey) {
                    if (!side.wave_type) {
                        return `<div class="card"><div class="card-title">${label}</div><div style="color:var(--text-muted); font-size:13px;">Wave type unresolved for this side - cannot analyze.</div></div>`;
                    }
                    if (!side.ops.length) {
                        return `<div class="card"><div class="card-title">${label} \u00b7 ${side.wave_type}</div><div style="color:var(--text-muted); font-size:13px;">No operations in this window.</div></div>`;
                    }
                    const s = sideSummary4(side.ops);
                    const stat = (val, lbl, cls, grade) => `<div class="stat" onclick="toggleGradeHighlight4('${sideKey}', '${grade}')" style="cursor:pointer;" title="Click to highlight ${lbl} operations in the timeline (click again to clear)"><div class="v ${cls || ''}">${val}</div><div class="l">${lbl}</div></div>`;
                    const condChips = Object.entries(s.conditions).sort((a, b) => b[1] - a[1])
                        .map(([name, count]) => `<span class="cond-chip" style="cursor:pointer;" onclick="showConditionExplain4('${sideKey}', '${name}', '${label}')" title="Click to see what this means">${escapeHtml4(name)} <b>${count}</b></span>`).join('');

                    // Filtered (INVALID) ops: shown explicitly so it is clear WHY some strokes
                    // were not scored (not silently dropped). Voltage is never a reason here -
                    // the gate is current-only.
                    const filteredTotal = Object.values(s.filtered).reduce((a, b) => a + b, 0);
                    const filteredLine = filteredTotal
                        ? `<div style="font-size:11px; color:var(--text-muted); margin-bottom:8px;">
                                                         <b>${filteredTotal}</b> filtered (not scored): ` +
                        Object.entries(s.filtered).sort((a, b) => b[1] - a[1])
                            .map(([r, c]) => `${escapeHtml4(FILTER_LABELS4[r] || r)} <b>${c}</b>`).join(' \u00b7 ') +
                        `</div>`
                        : '';

                    // Predictive per-direction state (Phase 2): trend + worst grade ->
                    // NORMAL / WATCH / MAINTAIN-SOON / URGENT. This is the "failure coming?"
                    // verdict, distinct from any single stroke's grade.
                    const stateColors = { URGENT: '#dc2626', 'MAINTAIN-SOON': '#ea580c', WATCH: '#ca8a04', NORMAL: '#16a34a', LEARNING: '#94a3b8' };
                    const stateLine = (side.states && Object.keys(side.states).length)
                        ? `<div style="margin-bottom:10px; display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                                                         <span style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted);">State</span>` +
                        Object.entries(side.states).map(([dir, st]) => {
                            const col = stateColors[st.state] || '#94a3b8';
                            const risers = (st.rising && st.rising.length)
                                ? ' \u00b7 ' + st.rising.map(f => `${TREND_LABELS4[f] || f} ${st.trends[f] > 0 ? '+' : ''}${st.trends[f]}%/100 ops`).join(', ') : '';
                            return `<span style="font-size:12px; font-weight:700; padding:4px 10px; border-radius:14px; background:${col}1a; color:${col}; border:1px solid ${col}55;" title="worst grade ${escapeHtml4(st.worst_confirmed)} over ${st.n} ops">dir-${escapeHtml4(dir)}: ${escapeHtml4(st.state)}${escapeHtml4(risers)}</span>`;
                        }).join('') + `</div>`
                        : '';

                    return `<div class="card">
                                                    <div class="card-title"><span>${label} \u00b7 ${side.wave_type}</span><span>${s.total} ops</span></div>
                                                    ${stateLine}
                                                    <div class="stat-row">
                                                        ${stat(s.counts.NORMAL, 'Normal', 'grade-NORMAL', 'NORMAL')}
                                                        ${stat(s.counts.WATCH, 'Watch', 'grade-WATCH', 'WATCH')}
                                                        ${stat(s.counts.ALERT, 'Alert', 'grade-ALERT', 'ALERT')}
                                                        ${stat(s.counts.FAULT, 'Fault', 'grade-FAULT', 'FAULT')}
                                                    </div>
                                                    ${filteredLine}
                                                    <div style="font-size:11px; color:var(--text-muted); margin-bottom:6px; text-transform:uppercase; font-weight:700;">Conditions detected</div>
                                                    <div>${condChips || '<span style="color:var(--text-muted); font-size:12px;">None</span>'}</div>
                                                </div>`;
                }

                // Plotly's click event gives (curveNumber, pointNumber) - pointNumber only
                // indexes the points actually PLOTTED in that trace (ops with no grade are
                // skipped), so we keep a side-channel array of which op each plotted point
                // came from, aligned 1:1 with the trace's x/y arrays.
                const TIMELINE_OPS4 = { a: [], b: [] };
                const TIMELINE_TRACE_INDEX4 = { a: null, b: null };

                function timelineTrace4(ops, yVal, label, side) {
                    const colorFor = g => ({ NORMAL: '#16a34a', WATCH: '#ca8a04', ALERT: '#ea580c', FAULT: '#dc2626' }[g] || '#94a3b8');
                    const x = [], y = [], colors = [], text = [], sizes = [];
                    TIMELINE_OPS4[side] = [];
                    ops.forEach(o => {
                        if (!o.time) return;
                        const grade = o.confirmed || (o.grade === 'INVALID' ? null : o.grade);
                        if (!grade) return;
                        x.push(o.time);
                        y.push(yVal);
                        colors.push(colorFor(grade));
                        sizes.push(grade === 'NORMAL' ? 6 : 9);
                        const cond = o.condition && o.condition !== '-' ? `<br>Condition: <b>${o.condition}</b>` : '';
                        const ft = o.fault_type ? `<br>Fault type: <b>${o.fault_type}</b>` : '';
                        const dirh = o.direction ? `<br>Direction: <b>dir-${o.direction}</b>` : '';
                        text.push(`<b>${label}</b> \u00b7 ${new Date(o.time).toLocaleString()}${dirh}<br>Grade: <b>${grade}</b>${cond}${ft}<br><i>Click for current/voltage</i>`);
                        TIMELINE_OPS4[side].push(o);
                    });
                    return {
                        x, y, text, mode: 'markers', type: 'scatter', name: label,
                        marker: { color: colors, size: sizes, line: { width: 1, color: '#fff' } },
                        hovertemplate: '%{text}<extra></extra>'
                    };
                }

                function renderTimeline4(dataA, dataB) {
                    CURRENT_HIGHLIGHT4 = null;
                    const traces = [];
                    TIMELINE_TRACE_INDEX4.a = null; TIMELINE_TRACE_INDEX4.b = null;
                    if (dataA.ops.length) { traces.push(timelineTrace4(dataA.ops, 2, 'A', 'a')); TIMELINE_TRACE_INDEX4.a = traces.length - 1; }
                    if (dataB.ops.length) { traces.push(timelineTrace4(dataB.ops, 1, 'B', 'b')); TIMELINE_TRACE_INDEX4.b = traces.length - 1; }
                    if (!traces.length) return;
                    const layout = {
                        height: 260, margin: { l: 50, r: 20, t: 10, b: 40 },
                        xaxis: { type: 'date' },
                        yaxis: { tickmode: 'array', tickvals: [1, 2], ticktext: ['B', 'A'], range: [0.5, 2.5] },
                        showlegend: false, hovermode: 'closest',
                    };
                    const el = document.getElementById('timeline4');
                    Plotly.newPlot(el, traces, layout, { responsive: true, displaylogo: false });
                    el.removeAllListeners && el.removeAllListeners('plotly_click');
                    el.on('plotly_click', (ev) => {
                        const pt = ev.points && ev.points[0];
                        if (!pt) return;
                        const side = Object.keys(TIMELINE_TRACE_INDEX4).find(k => TIMELINE_TRACE_INDEX4[k] === pt.curveNumber);
                        const op = side && TIMELINE_OPS4[side] && TIMELINE_OPS4[side][pt.pointNumber];
                        if (op) renderDetail4(op, side === 'a' ? 'Machine A' : 'Machine B', side);
                    });
                }

                // \u2500\u2500 MEASUREMENT TREND - plots the ACTUAL measurement (feature) over time, not
                // just the discrete grade. A feature climbing (e.g. running current 2.2A ->
                // 2.8A) is the real degradation curve; the grade is only a threshold on top.
                // Pick any of the 13 measurements; dots are coloured by that stroke's grade;
                // the dotted line is this machine's own median ("normal") so drift is
                // visible. Per direction. Ported from pm_operation4/static/index.html.
                const GRADE_DOT4 = { NORMAL: '#16a34a', WATCH: '#ca8a04', ALERT: '#ea580c', FAULT: '#dc2626', LEARNING: '#94a3b8' };
                const TREND_FEATS4 = ['i_run', 'i_trough', 'end_rise', 'end_rise_amps', 'work', 'pegged', 'ripple', 'shape_dist', 'throw_time', 'i_inrush', 'i_late_peak', 'late_peak_pos', 'rise_span'];
                let TREND_FEATURE4 = 'i_run';
                let _trendData4 = null;

                function renderTrendLines4(dataA, dataB) {
                    _trendData4 = { a: dataA, b: dataB };
                    const box = document.getElementById('trendBox4');
                    if (!box) return;
                    const hasFeat = [dataA, dataB].some(sd => sd && sd.ops && sd.ops.some(o => o.features));
                    if (!hasFeat) {
                        box.innerHTML = `<div style="color:var(--text-muted); font-size:13px;">Measurement values aren't in this cached result yet \u2014 hit <b>"Update Results"</b> to load the feature trends.</div>`;
                        return;
                    }
                    const opts = TREND_FEATS4.map(f => `<option value="${f}" ${f === TREND_FEATURE4 ? 'selected' : ''}>${escapeHtml4(FEATURE_LABELS4[f] || f)} (${f})</option>`).join('');
                    box.innerHTML = `
                                                    <div style="margin-bottom:12px;">
                                                      <label style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-right:8px;">Measurement</label>
                                                      <select id="trendFeatSel4" onchange="onTrendFeatureChange4(this.value)" style="width:auto; display:inline-block; padding:6px 10px; border:1px solid var(--border); border-radius:var(--radius); font-size:13px; background:var(--bg-tertiary); color:var(--text-primary);">${opts}</select>
                                                    </div>
                                                    <div id="trendCharts4"></div>`;
                    drawTrendCharts4();
                }

                // The <select> above fires onchange in GLOBAL scope (inline HTML attributes
                // always do), but TREND_FEATURE4 is a `let` scoped to this IIFE - assigning
                // to it directly from inline JS would silently create an unrelated global
                // instead of updating the binding drawTrendCharts4() actually reads, and the
                // dropdown would visibly change while the chart never did. Routing through
                // this function (itself exposed on window, see the bottom of this IIFE)
                // keeps the mutation inside the closure where it belongs.
                function onTrendFeatureChange4(value) {
                    TREND_FEATURE4 = value;
                    drawTrendCharts4();
                }

                function drawTrendCharts4() {
                    if (!_trendData4) return;
                    const charts = document.getElementById('trendCharts4');
                    const sides = [['Machine A', _trendData4.a], ['Machine B', _trendData4.b]];
                    let html = '';
                    const toPlot = [];
                    sides.forEach(([label, sd], si) => {
                        if (!sd || !sd.ops || !sd.ops.length) return;
                        const sideKey = si === 0 ? 'a' : 'b';
                        const byDir = {};
                        sd.ops.forEach(o => {
                            if (!o.time || !o.features) return;
                            const v = o.features[TREND_FEATURE4];
                            if (v == null || !isFinite(v)) return;
                            const d = o.direction || '?';
                            (byDir[d] = byDir[d] || []).push({ op: o, v: +v });   // keep full op so a click can open its graph
                        });
                        const dirs = Object.keys(byDir).sort();
                        if (!dirs.length) return;
                        html += `<div style="font-weight:700; margin:${si ? '18px' : '2px'} 0 6px;">${escapeHtml4(label)} \u00b7 ${escapeHtml4(sd.wave_type || '')}</div>
                                                             <div style="display:flex; gap:14px; flex-wrap:wrap;">`;
                        dirs.forEach(dir => {
                            const id = `ft4-${si}-${dir}`;
                            html += `<div style="flex:1; min-width:320px;">
                                                                   <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:4px;">dir-${escapeHtml4(dir)} \u00b7 ${byDir[dir].length} ops</div>
                                                                   <div id="${id}"></div></div>`;
                            toPlot.push({ id, pts: byDir[dir], label, sideKey });
                        });
                        html += `</div>`;
                    });
                    charts.innerHTML = html || '<div style="color:var(--text-muted); font-size:12px;">No data for this measurement.</div>';
                    toPlot.forEach(p => plotFeatureTrend4(p.id, p.pts, p.label, p.sideKey));
                }

                function plotFeatureTrend4(divId, pts, sideLabel, sideKey) {
                    const x = pts.map(p => p.op.time), y = pts.map(p => p.v);
                    const colors = pts.map(p => GRADE_DOT4[p.op.confirmed || p.op.grade] || '#94a3b8');
                    const sorted = [...y].sort((a, b) => a - b);
                    const med = sorted.length ? sorted[Math.floor(sorted.length / 2)] : 0;   // this machine's own "normal"
                    const ylabel = FEATURE_LABELS4[TREND_FEATURE4] || TREND_FEATURE4;
                    const el = document.getElementById(divId);
                    if (!el) return;
                    Plotly.newPlot(el, [{
                        x, y, mode: 'lines+markers', type: 'scatter',
                        line: { color: '#00a4e0', width: 1.5 },
                        marker: { color: colors, size: 7, line: { width: 1, color: '#fff' } },
                        hovertemplate: '%{x|%d %b %H:%M}<br>' + ylabel + ': <b>%{y:.3f}</b><br><i>Click for current/voltage</i><extra></extra>',
                    }], {
                        height: 200, margin: { l: 54, r: 14, t: 8, b: 28 },
                        yaxis: { title: { text: ylabel, font: { size: 10 } }, gridcolor: 'var(--border)', zeroline: false },
                        xaxis: { type: 'date', showgrid: false },
                        showlegend: false, hovermode: 'closest',
                        shapes: [{ type: 'line', xref: 'paper', x0: 0, x1: 1, y0: med, y1: med, line: { color: '#94a3b8', width: 1, dash: 'dot' } }],
                    }, { responsive: true, displaylogo: false });
                    el.removeAllListeners && el.removeAllListeners('plotly_click');
                    // Click a trend point -> open that operation's current/voltage in section D
                    // (same as clicking a Timeline dot).
                    el.on('plotly_click', (ev) => {
                        const pt = ev.points && ev.points[0];
                        if (!pt) return;
                        const p = pts[pt.pointNumber];
                        if (p && p.op) renderDetail4(p.op, sideLabel, sideKey);
                    });
                }

                // Highlights every point matching condName on the given side's timeline row -
                // enlarges + outlines matches, fades everything else on that same row, so a
                // condition's distribution over time is visible at a glance instead of having
                // to hunt for it among a hundred other dots.
                function highlightCondition4(sideKey, condName) {
                    const idx = TIMELINE_TRACE_INDEX4[sideKey];
                    if (idx == null) return;
                    const ops = TIMELINE_OPS4[sideKey];
                    const sizes = [], lineWidths = [], lineColors = [], opacities = [];
                    ops.forEach(o => {
                        const match = !!(o.condition && o.condition.split('+').includes(condName));
                        const grade = o.confirmed || (o.grade === 'INVALID' ? null : o.grade);
                        sizes.push(match ? 15 : (grade === 'NORMAL' ? 6 : 9));
                        lineWidths.push(match ? 3 : 1);
                        lineColors.push(match ? '#000000' : '#ffffff');
                        opacities.push(match ? 1 : 0.18);
                    });
                    Plotly.restyle('timeline4', {
                        'marker.size': [sizes],
                        'marker.line.width': [lineWidths],
                        'marker.line.color': [lineColors],
                        'marker.opacity': [opacities],
                    }, [idx]);
                }

                // Restores a side's timeline row to its normal (no-highlight) marker style.
                function clearHighlight4(sideKey) {
                    const idx = TIMELINE_TRACE_INDEX4[sideKey];
                    if (idx == null) return;
                    const ops = TIMELINE_OPS4[sideKey];
                    const sizes = [], opacities = [];
                    ops.forEach(o => {
                        const grade = o.confirmed || (o.grade === 'INVALID' ? null : o.grade);
                        sizes.push(grade === 'NORMAL' ? 6 : 9);
                        opacities.push(1);
                    });
                    Plotly.restyle('timeline4', {
                        'marker.size': [sizes],
                        'marker.line.width': [Array(ops.length).fill(1)],
                        'marker.line.color': [Array(ops.length).fill('#ffffff')],
                        'marker.opacity': [opacities],
                    }, [idx]);
                }

                // Linear-resample an array to n points, so two strokes of different lengths can
                // be overlaid aligned by stroke progress (0-100%) instead of raw sample index.
                function resampleTo4(arr, n) {
                    if (!arr || arr.length < 2) return arr || [];
                    const out = [];
                    for (let i = 0; i < n; i++) {
                        const t = i * (arr.length - 1) / (n - 1);
                        const lo = Math.floor(t), hi = Math.ceil(t), frac = t - lo;
                        out.push(arr[lo] * (1 - frac) + arr[hi] * frac);
                    }
                    return out;
                }

                // Overlay a healthy stroke (green) and a condition example (red) on ONE axis so
                // small differences (e.g. an elevated running floor in SLAGGING) are visible as
                // a gap between the lines, instead of two look-alike side-by-side charts.
                function overlayChart4(divId, idealArr, exampleArr, title, condName) {
                    const n = 100;
                    const idealRs = resampleTo4(idealArr, n), exampleRs = resampleTo4(exampleArr, n);
                    const region = condName && CONDITION_REGION4[condName];
                    const shapes = [], annotations = [];
                    if (region) {
                        shapes.push({ type: 'rect', xref: 'x', yref: 'paper', x0: region[0], x1: region[1], y0: 0, y1: 1, fillcolor: 'rgba(220,38,38,0.12)', line: { width: 0 } });
                        const peakIdx = Math.round((region[0] + region[1]) / 2);
                        annotations.push({
                            x: peakIdx, y: Math.max(idealRs[peakIdx] ?? 0, exampleRs[peakIdx] ?? 0),
                            xref: 'x', yref: 'y', text: '\u26a0 Look here', showarrow: true, arrowhead: 3, ax: 0, ay: -30,
                            font: { size: 10, color: '#dc2626' },
                        });
                    }
                    Plotly.newPlot(divId, [
                        { y: idealRs, mode: 'lines', name: 'Healthy (normal)', line: { color: '#16a34a', width: 2 } },
                        { y: exampleRs, mode: 'lines', name: 'This condition', line: { color: '#dc2626', width: 2 } },
                    ], {
                        height: 260, margin: { l: 42, r: 12, t: 30, b: 34 },
                        title: { text: title, font: { size: 12 } },
                        xaxis: { showgrid: false, title: { text: 'stroke progress (0\u2013100%)', font: { size: 10 } } },
                        yaxis: { zeroline: false, title: { text: 'Current (A)', font: { size: 10 } } },
                        legend: { orientation: 'h', y: 1.18, x: 0, font: { size: 11 } },
                        shapes, annotations,
                    }, { responsive: true, displaylogo: false });
                }

                // Highlight every point of a given GRADE on a side's timeline row (mirrors
                // highlightCondition4, but matches the confirmed grade instead of a condition).
                function highlightGrade4(sideKey, grade) {
                    const idx = TIMELINE_TRACE_INDEX4[sideKey];
                    if (idx == null) return;
                    const ops = TIMELINE_OPS4[sideKey];
                    const sizes = [], lineWidths = [], lineColors = [], opacities = [];
                    ops.forEach(o => {
                        const g = o.confirmed || (o.grade === 'INVALID' ? null : o.grade);
                        const match = (g === grade);
                        sizes.push(match ? 15 : (g === 'NORMAL' ? 6 : 9));
                        lineWidths.push(match ? 3 : 1);
                        lineColors.push(match ? '#000000' : '#ffffff');
                        opacities.push(match ? 1 : 0.15);
                    });
                    Plotly.restyle('timeline4', {
                        'marker.size': [sizes], 'marker.line.width': [lineWidths],
                        'marker.line.color': [lineColors], 'marker.opacity': [opacities],
                    }, [idx]);
                }

                // Click a NORMAL/WATCH/ALERT/FAULT stat box to highlight those operations in the
                // timeline; click the same box again to clear. Shares CURRENT_HIGHLIGHT4 with the
                // condition chips so only one highlight is active at a time.
                function toggleGradeHighlight4(sideKey, grade) {
                    if (CURRENT_HIGHLIGHT4 && CURRENT_HIGHLIGHT4.side === sideKey && CURRENT_HIGHLIGHT4.grade === grade) {
                        clearHighlight4(sideKey);
                        CURRENT_HIGHLIGHT4 = null;
                        return;
                    }
                    if (CURRENT_HIGHLIGHT4 && CURRENT_HIGHLIGHT4.side !== sideKey) clearHighlight4(CURRENT_HIGHLIGHT4.side);
                    CURRENT_HIGHLIGHT4 = { side: sideKey, grade };
                    highlightGrade4(sideKey, grade);
                }

                const SAMPLE_MS4 = 20;   // historian polls every 20 ms (50 Hz)

                function lineChart4(divId, values, color, title) {
                    const xs = (values || []).map((_, i) => i * SAMPLE_MS4);   // x-axis in milliseconds
                    Plotly.newPlot(divId, [{
                        x: xs, y: values, mode: 'lines', line: { color, width: 1.6 }, fill: 'tozeroy',
                        fillcolor: color + '18',
                    }], {
                        height: 180, margin: { l: 40, r: 10, t: 24, b: 34 },
                        title: { text: title, font: { size: 11 } },
                        xaxis: { showgrid: false, title: { text: 'time (ms)', font: { size: 10 } } },
                        yaxis: { zeroline: false },
                    }, { responsive: true, displaylogo: false });
                }

                let SELECTED4 = null;  // {op, side, label} of the operation shown in the detail panel

                function renderDetail4(op, label, side) {
                    SELECTED4 = { op, side, label };
                    const box = document.getElementById('detailBox4');
                    box.style.display = 'block';
                    // Direction shown as "dir-Normal" / "dir-Reverse" so it can never be
                    // mistaken for the NORMAL grade. N->R and R->N are graded separately.
                    const dir = op.direction ? ` \u00b7 dir-${escapeHtml4(op.direction)}` : '';
                    document.getElementById('detailTitle4').innerHTML =
                        `${escapeHtml4(label)}${dir} \u00b7 ${new Date(op.time).toLocaleString()} \u00b7 ${escapeHtml4(op.confirmed || op.grade || '')}` +
                        (op.condition && op.condition !== '-' ? ` \u00b7 ${escapeHtml4(op.condition)}` : '') +
                        (op.fault_type && op.fault_type !== op.condition ? ` \u00b7 ${escapeHtml4(op.fault_type)}` : '');
                    // Show BOTH the detector note AND the actual grade drivers, in plain English.
                    // The grade often comes from the z-engine (readings drifting vs the machine's
                    // own history), NOT the detector condition - without this a FAULT looked
                    // identical to a NORMAL with the same end_rise.
                    const parts = [];
                    if (op.cond_notes) parts.push(escapeHtml4(op.cond_notes));
                    if (op.reason) parts.push(`<b>Why this grade:</b> ${escapeHtml4(humanizeDrivers4(op.reason))} <span style="color:var(--text-muted)">\u2014 the readings that differ most from this machine's own normal history.</span>`);
                    // When the shown (confirmed) grade differs from this stroke's OWN grade, the
                    // difference comes from persistence (nearby operations), not this stroke -
                    // say so explicitly so an individually-clean stroke marked FAULT isn't a mystery.
                    if (op.confirmed && op.grade && op.confirmed !== op.grade) {
                        parts.push(`<span style="color:var(--text-muted)">On its own this operation reads <b>${escapeHtml4(op.grade)}</b>; it is shown as <b>${escapeHtml4(op.confirmed)}</b> because nearby operations (within a few days) were worse \u2014 a run of them is needed before the machine is called bad.</span>`);
                    }
                    document.getElementById('detailNotes4').innerHTML =
                        parts.join('<br>') || '<span style="color:var(--text-muted)">Matched a detector signature only \u2014 no per-machine deviation drivers.</span>';
                    lineChart4('detailCurrentChart4', op.current || [], '#d97706', 'Current (A)');
                    lineChart4('detailVoltageChart4', op.voltage || [], '#0d9488', 'Voltage (V)');
                    renderFeedback4();
                    // No auto-scroll - the detail box updates in place, user scrolls to it
                    // themselves if/when they want to see it (same convention as Model 3).
                }

                // Technician feedback form inside the detail panel. Every label is stored with
                // the operation anchor + the engine's call, so we can later measure the engine
                // and train a single global model on machine-relative features.
                function renderFeedback4() {
                    const box = document.getElementById('feedbackBox4');
                    const el = document.getElementById('feedbackArea4');
                    if (!el || !box) return;
                    box.style.display = 'block';
                    const op = SELECTED4 ? SELECTED4.op : null;
                    const opLabel = op ? `${SELECTED4.label} \u00b7 dir-${escapeHtml4(op.direction || '?')} \u00b7 ${new Date(op.time).toLocaleString()}` : '';
                    el.innerHTML = `
                                                  <div style="font-size:12px; color:var(--text-muted); margin-bottom:8px;">For: <b>${opLabel}</b> \u2014 engine says <b>${escapeHtml4(op ? (op.confirmed || op.grade || '') : '')}</b>. Is this correct?</div>
                                                  <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                                                    <button class="btn" style="width:auto; padding:7px 12px; background:var(--normal); border:none; color:#fff;" onclick="submitFeedback4('agree')">\u2713 Engine is correct</button>
                                                    <button class="btn" style="width:auto; padding:7px 12px;" onclick="submitFeedback4('false_positive')">\u2717 Actually Normal</button>
                                                    <button class="btn" style="width:auto; padding:7px 12px;" onclick="submitFeedback4('missed_fault')">\u26a0 Fault was missed</button>
                                                    <input id="fbLabel4" placeholder="Correct fault type (optional)" style="flex:1; min-width:160px; padding:7px 9px; border:1px solid var(--border); border-radius:8px; font-size:13px;">
                                                  </div>
                                                  <input id="fbNote4" placeholder="Field finding / note (optional)" style="width:100%; margin-top:8px; padding:7px 9px; border:1px solid var(--border); border-radius:8px; font-size:13px;">
                                                  <div style="display:flex; gap:10px; align-items:center; margin-top:8px;">
                                                    <button class="btn" style="width:auto; padding:6px 10px; background:transparent; color:var(--text-muted); border:1px solid var(--border);" onclick="clearFeedback4()" title="Remove any feedback previously saved for this operation">\u21ba Clear my feedback for this operation</button>
                                                    <div id="fbStatus4" style="font-size:12px; color:var(--text-muted);"></div>
                                                  </div>
                                                `;
                }

                function _feedbackAnchor4() {
                    if (!SELECTED4 || !S4.selectedAsset) return null;
                    const { op, side } = SELECTED4;
                    return {
                        site_id: S4.currentSiteId, asset_id: S4.selectedAsset.assetId,
                        asset_name: S4.selectedAsset.assetName, side, op_time: op.time,
                    };
                }

                async function submitFeedback4(verdict) {
                    const anchor = _feedbackAnchor4();
                    if (!anchor) return;
                    const { op, side } = SELECTED4;
                    const wave = (S4.lastData && S4.lastData[side] && S4.lastData[side].wave_type) || null;
                    const status = document.getElementById('fbStatus4');
                    status.textContent = 'Saving\u2026';
                    try {
                        const r = await fetch(PM4_ENDPOINTS.feedback, {
                            method: 'POST', headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                ...anchor, wave_type: wave, direction: op.direction,
                                engine_grade: op.grade, engine_confirmed: op.confirmed,
                                engine_condition: op.condition, engine_reason: op.reason,
                                verdict,
                                correct_label: (document.getElementById('fbLabel4') || {}).value || null,
                                note: (document.getElementById('fbNote4') || {}).value || null,
                            }),
                        });
                        const j = await r.json();
                        if (r.ok && j.ok) status.innerHTML = `\u2713 Saved. Labels collected so far: <b>${j.total_labels ?? '?'}</b>. Thank you!`;
                        else status.textContent = 'Save failed.';
                    } catch (e) { status.textContent = 'Save failed: ' + e; }
                }

                async function clearFeedback4() {
                    const anchor = _feedbackAnchor4();
                    if (!anchor) return;
                    const status = document.getElementById('fbStatus4');
                    status.textContent = 'Clearing\u2026';
                    try {
                        const r = await fetch(PM4_ENDPOINTS.feedbackClear, {
                            method: 'POST', headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ site_id: anchor.site_id, asset_id: anchor.asset_id, side: anchor.side, op_time: anchor.op_time }),
                        });
                        const j = await r.json();
                        if (r.ok && j.ok) status.innerHTML = `\u21ba Cleared ${j.removed} record(s). Labels remaining: <b>${j.total_labels ?? '?'}</b>.`;
                        else status.textContent = 'Clear failed.';
                    } catch (e) { status.textContent = 'Clear failed: ' + e; }
                }

                let CURRENT_HIGHLIGHT4 = null;  // {side, cond} of the currently-selected chip, or null

                function showConditionExplain4(sideKey, condName, label) {
                    // Clicking the already-selected chip again deselects it.
                    if (CURRENT_HIGHLIGHT4 && CURRENT_HIGHLIGHT4.side === sideKey && CURRENT_HIGHLIGHT4.cond === condName) {
                        clearHighlight4(sideKey);
                        CURRENT_HIGHLIGHT4 = null;
                        renderLabelsLegend4();   // restore the static legend instead of hiding section (e)
                        return;
                    }
                    if (CURRENT_HIGHLIGHT4 && CURRENT_HIGHLIGHT4.side !== sideKey) clearHighlight4(CURRENT_HIGHLIGHT4.side);
                    CURRENT_HIGHLIGHT4 = { side: sideKey, cond: condName };
                    highlightCondition4(sideKey, condName);
                    const ops = (S4.lastData && S4.lastData[sideKey] && S4.lastData[sideKey].ops) || [];
                    const example = ops.find(o => o.condition && o.condition.split('+').includes(condName) && o.current && o.current.length);
                    const ideal = ops.find(o => o.confirmed === 'NORMAL' && o.current && o.current.length);

                    const box = document.getElementById('explainBox4');
                    box.style.display = 'block';
                    const info = CONDITION_INFO4[condName] || { text: 'No description available.', calib: '' };
                    document.getElementById('explainTitle4').textContent = `${condName} \u2014 ${label}`;
                    document.getElementById('explainText4').innerHTML =
                        `${escapeHtml4(info.text)}` + (info.calib ? `<div style="margin-top:6px; font-style:italic; color:var(--text-muted);">${escapeHtml4(info.calib)}</div>` : '');

                    const look = CONDITION_LOOK4[condName] || '';
                    if (ideal && example) {
                        document.getElementById('explainPlots4').innerHTML = `
                                                        <div style="flex:1; min-width:340px;">
                                                            <div style="font-size:11px; font-weight:700; text-transform:uppercase; color:var(--text-muted); margin-bottom:4px;">
                                                                Healthy (${new Date(ideal.time).toLocaleDateString()}) vs ${escapeHtml4(condName)} (${new Date(example.time).toLocaleDateString()}) \u2014 overlaid, aligned by stroke progress
                                                            </div>
                                                            <div id="explainOverlayChart4"></div>
                                                            ${look ? `<div style="font-size:12.5px; margin-top:8px; padding:8px 10px; background:var(--accent-muted); border-radius:8px;"><b>\ud83d\udc41 What to look at:</b> ${escapeHtml4(look)}</div>` : ''}
                                                            ${example.cond_notes ? `<div style="font-size:12px; color:var(--text-muted); margin-top:6px;">Measured: ${escapeHtml4(example.cond_notes)}</div>` : ''}
                                                        </div>`;
                        overlayChart4('explainOverlayChart4', ideal.current, example.current, `Healthy (green) vs ${condName} (red)`, condName);
                    } else {
                        document.getElementById('explainPlots4').innerHTML =
                            `<div style="color:var(--text-muted); font-size:12px;">Not enough examples in this window to draw a healthy-vs-${escapeHtml4(condName)} comparison.</div>`;
                    }
                }

                function renderResults4(pm, data) {
                    document.getElementById('loading4').style.display = 'none';
                    const el = document.getElementById('results4');
                    el.style.display = 'block';

                    let banner = '';
                    if (pm.mixed) {
                        banner = `<div class="banner warn">This asset has DIFFERENT wave types per side: A=${pm.aWave}, B=${pm.bWave}. Each side is scored with its own correct model.</div>`;
                    }

                    const updatedLabel = data.generated_at
                        ? (data._from_cache ? 'Cached result \u00b7 ' : 'Live result \u00b7 ') + new Date(data.generated_at).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'medium', timeStyle: 'short' }) + ' IST'
                        : '';

                    el.innerHTML = `
                                                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:4px;">
                                                        <div>
                                                            <h2 style="margin:0 0 4px;">${escapeHtml4(pm.assetName)}</h2>
                                                            <div style="color:var(--text-muted); font-size:12px;">${escapeHtml4(S4.lastRangeLabel || 'last 30 days')}</div>
                                                            <div style="color:var(--text-muted); font-size:11px; margin-top:2px;">${updatedLabel}</div>
                                                        </div>
                                                        <div style="display:flex; gap:8px;">
                                                            <button class="btn" style="width:auto; padding:8px 16px; border-radius:8px;" onclick="updateCurrentAsset4()" title="Ignore cache, re-fetch and re-analyze right now">Update Results</button>
                                                            <button class="btn primary" style="width:auto; padding:8px 16px; border-radius:8px;" onclick="exportPm4Pdf4(this)" title="Export asset analysis and charts to PDF">Export to PDF</button>
                                                        </div>
                                                    </div>
                                                    ${banner}
                                                    <!-- (a) SUMMARY -->
                                                    <div id="aiSummaryBox4" class="card" style="display:none; background:linear-gradient(135deg, var(--accent-muted), rgba(147,51,234,0.06)); border-color:var(--accent);">
                                                        <div class="card-title" style="color:var(--accent);">A \u00b7 AI Summary</div>
                                                        <div id="aiSummaryText4" style="font-size:13.5px; line-height:1.6;"></div>
                                                    </div>
                                                    <!-- (b) ANALYTICS -->
                                                    <div class="card-title" style="margin-top:4px;">B \u00b7 Analytics</div>
                                                    <div style="display:flex; gap:16px; flex-wrap:wrap;">
                                                        <div style="flex:1; min-width:320px;">${renderSideCard4('Machine A', data.a, 'a')}</div>
                                                        <div style="flex:1; min-width:320px;">${renderSideCard4('Machine B', data.b, 'b')}</div>
                                                    </div>
                                                    <!-- (c) TIMELINE -->
                                                    <div class="card">
                                                        <div class="card-title"><span>C \u00b7 Timeline</span><span style="font-weight:500; text-transform:none;">Click a point for its graph \u00b7 click a grade box or condition chip above to highlight those here</span></div>
                                                        <div id="timeline4"></div>
                                                    </div>
                                                    <!-- (c2) MEASUREMENT TREND: the actual feature value over time, per direction -->
                                                    <div class="card">
                                                        <div class="card-title"><span>C\u2082 \u00b7 Measurement trend</span><span style="font-weight:500; text-transform:none;">pick a measurement \u00b7 rising = degrading \u00b7 dotted line = this machine's normal \u00b7 click a point for its current/voltage graph</span></div>
                                                        <div id="trendBox4"></div>
                                                    </div>
                                                    <!-- (d) GRAPH: current/voltage of the clicked operation -->
                                                    <div id="detailBox4" class="card" style="display:none;">
                                                        <div class="card-title"><span id="detailTitle4">D \u00b7 Operation graph</span></div>
                                                        <div id="detailNotes4" style="font-size:12px; color:var(--text-muted); margin-bottom:10px;"></div>
                                                        <div style="display:flex; gap:14px; flex-wrap:wrap;">
                                                            <div style="flex:1; min-width:280px;" id="detailCurrentChart4"></div>
                                                            <div style="flex:1; min-width:280px;" id="detailVoltageChart4"></div>
                                                        </div>
                                                    </div>
                                                    <!-- (e) LABELS DESCRIPTION -->
                                                    <div id="explainBox4" class="card">
                                                        <div class="card-title"><span id="explainTitle4">E \u00b7 What the labels mean</span></div>
                                                        <div id="explainText4" style="font-size:13px; line-height:1.5; margin-bottom:12px;"></div>
                                                        <div id="explainPlots4" style="display:flex; gap:14px; flex-wrap:wrap;"></div>
                                                    </div>
                                                    <!-- (f) FEEDBACK -->
                                                    <div id="feedbackBox4" class="card" style="display:none;">
                                                        <div class="card-title">F \u00b7 Technician feedback</div>
                                                        <div id="feedbackArea4"></div>
                                                    </div>
                                                `;
                    renderTimeline4(data.a, data.b);
                    renderTrendLines4(data.a, data.b);
                    renderLabelsLegend4();

                    if (data.ai_summary) {
                        document.getElementById('aiSummaryBox4').style.display = 'block';
                        document.getElementById('aiSummaryText4').innerHTML = renderSummaryBullets4(data.ai_summary);
                    }
                }

                // Static legend for section (e): what every grade/state and condition means,
                // so a maintainer never has to guess. Replaced by a specific compare view when
                // a condition chip is clicked (showConditionExplain4), restored on demand.
                function renderLabelsLegend4() {
                    const el = document.getElementById('explainText4');
                    const plots = document.getElementById('explainPlots4');
                    const title = document.getElementById('explainTitle4');
                    if (!el) return;
                    if (title) title.textContent = 'E \u00b7 What the labels mean';
                    if (plots) plots.innerHTML = '';
                    const grades = Object.entries(GRADE_INFO4).map(([k, v]) =>
                        `<div style="margin-bottom:4px;"><b>${escapeHtml4(k)}</b> \u2014 ${escapeHtml4(v)}</div>`).join('');
                    const conds = Object.entries(CONDITION_INFO4).map(([k, v]) =>
                        `<div style="margin-bottom:4px;"><b>${escapeHtml4(k)}</b> \u2014 ${escapeHtml4(v.text)}</div>`).join('');
                    el.innerHTML =
                        `<div style="display:flex; gap:24px; flex-wrap:wrap;">
                                                       <div style="flex:1; min-width:280px;"><div style="font-weight:700; text-transform:uppercase; font-size:11px; color:var(--text-muted); margin-bottom:6px;">Grades &amp; states</div>${grades}</div>
                                                       <div style="flex:1; min-width:280px;"><div style="font-weight:700; text-transform:uppercase; font-size:11px; color:var(--text-muted); margin-bottom:6px;">Conditions</div>${conds}</div>
                                                     </div>
                                                     <div style="margin-top:8px; color:var(--text-muted); font-size:12px;">Tip: click a condition chip in Analytics to compare a real example of it against a healthy stroke.</div>`;
                }

                // Full PDF report - ported verbatim from pm_operation4/static/index.html's
                // exportPm4Pdf (client-side jsPDF + jspdf-autotable; charts embedded as
                // PNGs via Plotly.toImage()), with every shared identifier switched to
                // this IIFE's own "4"-suffixed name (sideSummary4, CONDITION_INFO4,
                // GRADE_DOT4, FEATURE_LABELS4, humanizeDrivers4, SELECTED4, _trendData4,
                // escapeHtml4, timeline4/detailCurrentChart4/detailVoltageChart4 element
                // ids) so it reads this tab's own data instead of a different model's.
                async function exportPm4Pdf4(btn) {
                    if (!S4.selectedAsset || !S4.lastData) {
                        alert('Please select and analyze a point machine first.');
                        return;
                    }
                    if (!window.jspdf || !window.jspdf.jsPDF) {
                        alert('PDF library not loaded \u2014 please reload the page.');
                        return;
                    }

                    const origHtml = btn ? btn.innerHTML : '';
                    if (btn) { btn.disabled = true; btn.style.opacity = '0.7'; btn.style.cursor = 'wait'; btn.innerHTML = 'Generating PDF\u2026'; }

                    try {
                        const { jsPDF } = window.jspdf;
                        const doc = new jsPDF({ unit: 'pt', format: 'a4' });
                        const pageW = doc.internal.pageSize.getWidth();
                        const pageH = doc.internal.pageSize.getHeight();
                        const M = 36;
                        const contentW = pageW - 2 * M;
                        let y = M;

                        const ensure = h => {
                            if (y + h > pageH - M - 20) {
                                doc.addPage();
                                y = M;
                            }
                        };

                        const cleanTxt = txt => String(txt || '').replace(/\u2192/g, 'to').replace(/\u2013|\u2014/g, '-');

                        const pm = S4.selectedAsset;
                        const data = S4.lastData;
                        const siteObj = (S4.sites || []).find(s => String(s.SiteId) === String(S4.currentSiteId));
                        const siteName = (siteObj && siteObj.SiteName) || S4.currentSiteId || '';

                        // \u2500\u2500 1. HEADER BANNER \u2500\u2500
                        // Short DD/MM/YYYY instead of a verbose locale string (e.g. "8 Aug
                        // 2026") - keeps the meta line from running long enough to force
                        // extra wrapped lines in the banner.
                        const fmtWindowDate4 = d => {
                            const dt = new Date(d);
                            const pad = n => String(n).padStart(2, '0');
                            const datePart = `${pad(dt.getDate())}/${pad(dt.getMonth() + 1)}/${dt.getFullYear()}`;
                            const timePart = dt.toLocaleTimeString('en-IN', { hour: 'numeric', minute: '2-digit', hour12: true });
                            return `${datePart}, ${timePart}`;
                        };
                        const allOpsForWindow4 = [...((data.a && data.a.ops) || []), ...((data.b && data.b.ops) || [])];
                        const opTimesForWindow4 = allOpsForWindow4.map(o => o.time).filter(Boolean).sort();
                        const windowLabel4 = opTimesForWindow4.length
                            ? `${fmtWindowDate4(opTimesForWindow4[0])} to ${fmtWindowDate4(opTimesForWindow4[opTimesForWindow4.length - 1])}`
                            : (S4.lastRangeLabel || 'last 30 days');
                        const metaStr = cleanTxt(`Asset: ${pm.assetName} (ID: ${pm.assetId})   |   Site: ${siteName}   |   Window: ${windowLabel4}   |   Generated: ${new Date().toLocaleString('en-IN')}`);
                        doc.setFontSize(8.5); doc.setFont('helvetica', 'normal');
                        // The date-range window text can run long enough to overflow the
                        // fixed-height banner - wrap it and grow the banner to fit instead
                        // of letting it spill out past the rounded box.
                        const metaLines4 = doc.splitTextToSize(metaStr, contentW - 28);
                        const bannerH4 = 24 + metaLines4.length * 11;

                        doc.setFillColor(15, 23, 42); // Dark Navy #0f172a
                        doc.roundedRect(M, y, contentW, bannerH4, 5, 5, 'F');

                        doc.setFontSize(15); doc.setFont('helvetica', 'bold'); doc.setTextColor(255, 255, 255);
                        doc.text('POINT MACHINE OPERATION V4 REPORT', M + 14, y + 20);

                        doc.setFontSize(8.5); doc.setFont('helvetica', 'normal'); doc.setTextColor(148, 163, 184);
                        metaLines4.forEach((ln, li) => doc.text(ln, M + 14, y + 34 + li * 11));
                        y += bannerH4 + 10;

                        // \u2500\u2500 2. AI SUMMARY \u2500\u2500
                        if (data.ai_summary) {
                            ensure(60);
                            doc.setFillColor(243, 232, 255); doc.setDrawColor(216, 180, 254);
                            doc.roundedRect(M, y, contentW, 20, 3, 3, 'FD');
                            doc.setFontSize(9.5); doc.setFont('helvetica', 'bold'); doc.setTextColor(109, 40, 217);
                            doc.text('AI Diagnostic Summary & Verdict', M + 10, y + 14);
                            y += 26;

                            const sumObj = data.ai_summary;
                            if (typeof sumObj === 'object' && sumObj !== null) {
                                if (sumObj.verdict) {
                                    doc.setFontSize(10); doc.setFont('helvetica', 'bold'); doc.setTextColor(30, 41, 59);
                                    doc.text(cleanTxt(`Verdict: ${sumObj.verdict}`), M + 4, y);
                                    y += 14;
                                }
                                if (Array.isArray(sumObj.points) && sumObj.points.length) {
                                    doc.setFontSize(8.5); doc.setFont('helvetica', 'normal'); doc.setTextColor(51, 65, 85);
                                    sumObj.points.forEach(pt => {
                                        const lines = doc.splitTextToSize(cleanTxt(pt), contentW - 20);
                                        ensure(lines.length * 11);
                                        lines.forEach((ln, li) => {
                                            doc.text(li === 0 ? '\u2022 ' + ln : '  ' + ln, M + 10, y);
                                            y += 11;
                                        });
                                    });
                                    y += 4;
                                }
                                if (sumObj.recommendation) {
                                    const lines = doc.splitTextToSize(cleanTxt(`Recommendation: ${sumObj.recommendation}`), contentW - 16);
                                    ensure(lines.length * 11);
                                    doc.setFontSize(8.5); doc.setFont('helvetica', 'bold'); doc.setTextColor(15, 23, 42);
                                    lines.forEach(ln => { doc.text(ln, M + 10, y); y += 11; });
                                    y += 6;
                                }
                            } else {
                                const lines = doc.splitTextToSize(cleanTxt(sumObj), contentW - 16);
                                ensure(lines.length * 11);
                                doc.setFontSize(8.5); doc.setFont('helvetica', 'normal'); doc.setTextColor(51, 65, 85);
                                lines.forEach(ln => { doc.text(ln, M + 10, y); y += 11; });
                                y += 6;
                            }
                            y += 10;
                        }

                        // \u2500\u2500 3. MACHINE A & B ANALYTICS TABLE \u2500\u2500
                        ensure(80);
                        doc.setFontSize(10); doc.setFont('helvetica', 'bold'); doc.setTextColor(15, 23, 42);
                        doc.text('Machine A & B Performance Summary', M + 4, y);
                        y += 14;

                        const sideHead = [['Machine Side', 'Wave Model', 'Total Ops', 'Normal', 'Watch', 'Alert', 'Fault', 'Invalid', 'Directional State']];
                        const sides = [
                            ['Machine A', data.a, 'a'],
                            ['Machine B', data.b, 'b']
                        ];
                        const sideRows = sides.map(([name, sd]) => {
                            if (!sd || !sd.ops) return [name, 'N/A', '0', '0', '0', '0', '0', '0', 'N/A'];
                            const s = sideSummary4(sd.ops);
                            const stStr = sd.states ? Object.entries(sd.states).map(([d, st]) => `dir-${d}: ${st.state}`).join(', ') : 'N/A';
                            const invCount = Object.values(s.filtered || {}).reduce((a, b) => a + b, 0);
                            return [
                                name,
                                cleanTxt(sd.wave_type || 'Unresolved'),
                                String(s.total),
                                String(s.counts.NORMAL || 0),
                                String(s.counts.WATCH || 0),
                                String(s.counts.ALERT || 0),
                                String(s.counts.FAULT || 0),
                                String(invCount),
                                cleanTxt(stStr)
                            ];
                        });

                        if (typeof doc.autoTable === 'function') {
                            doc.autoTable({
                                startY: y,
                                margin: { left: M, right: M },
                                head: sideHead,
                                body: sideRows,
                                theme: 'striped',
                                headStyles: { fillColor: [30, 41, 59], textColor: [255, 255, 255], fontStyle: 'bold', fontSize: 8 },
                                bodyStyles: { textColor: [51, 65, 85], fontSize: 8, cellPadding: 4 },
                                alternateRowStyles: { fillColor: [248, 250, 252] },
                                columnStyles: {
                                    0: { cellWidth: 70, fontStyle: 'bold' },
                                    1: { cellWidth: 60 },
                                    2: { cellWidth: 45, halign: 'center' },
                                    3: { cellWidth: 45, halign: 'center' },
                                    4: { cellWidth: 45, halign: 'center' },
                                    5: { cellWidth: 45, halign: 'center' },
                                    6: { cellWidth: 45, halign: 'center' },
                                    7: { cellWidth: 45, halign: 'center' },
                                    8: { halign: 'left' }
                                }
                            });
                            y = doc.lastAutoTable.finalY + 14;
                        }

                        // \u2500\u2500 4-6. PER-MACHINE SECTIONS (everything about Machine A - abnormality
                        // charts, fault text, timeline, trend charts, flagged ops - fully before
                        // Machine B's identical set of sections, so a two-column layout never
                        // squeezes both machines' charts into the same page) \u2500\u2500
                        function makeTrendFig(opsList, featKey, ylabel) {
                            const pts = [];
                            opsList.forEach(o => {
                                if (!o.time || !o.features) return;
                                const v = o.features[featKey];
                                if (v == null || !isFinite(v)) return;
                                pts.push({ time: o.time, v: +v, grade: o.confirmed || o.grade });
                            });
                            if (!pts.length) return null;

                            const x = pts.map(p => p.time);
                            const y = pts.map(p => p.v);
                            const colors = pts.map(p => (GRADE_DOT4[p.grade] || '#94a3b8'));
                            const sorted = [...y].sort((a, b) => a - b);
                            const med = sorted.length ? sorted[Math.floor(sorted.length / 2)] : 0;

                            return {
                                fig: {
                                    data: [{
                                        x, y, mode: 'lines+markers', type: 'scatter',
                                        line: { color: '#00a4e0', width: 1.5 },
                                        marker: { color: colors, size: 7, line: { width: 1, color: '#fff' } }
                                    }],
                                    layout: {
                                        height: 220, margin: { l: 54, r: 14, t: 10, b: 28 },
                                        yaxis: { title: { text: ylabel, font: { size: 10 } }, gridcolor: '#eef2f6', zeroline: false },
                                        xaxis: { type: 'date', showgrid: false },
                                        showlegend: false,
                                        shapes: [{ type: 'line', xref: 'paper', x0: 0, x1: 1, y0: med, y1: med, line: { color: '#94a3b8', width: 1, dash: 'dot' } }]
                                    }
                                },
                                count: pts.length
                            };
                        }

                        const CORE_TRENDS = [
                            { key: 'i_run', name: 'Higher Running Current (i_run)', desc: 'Detects motor load, mechanical tightness & slagging' },
                            { key: 'end_rise', name: 'End-of-Stroke Rise (end_rise)', desc: 'Detects end friction & creeping signature' },
                            { key: 'throw_time', name: 'Stroke Duration (throw_time)', desc: 'Measures operation speed & potential binding' },
                            { key: 'work', name: 'Energy Consumed (work)', desc: 'Total energy used per stroke (A x s)' }
                        ];

                        for (let sideIdx = 0; sideIdx < sides.length; sideIdx++) {
                            const [sideName, sd, sideKey] = sides[sideIdx];
                            if (!sd || !sd.ops) continue;
                            if (sideIdx > 0) { doc.addPage(); y = M; }

                            // \u2500\u2500 4. ABNORMALITY-SUBCLASS ALL-OCCURRENCES CHARTS (this side) \u2500\u2500
                            // Group each op under its PRIMARY condition only - detect()'s own
                            // severity-rank sort (pm_health.py) already puts the strongest-
                            // matching condition first in the "+"-joined string, so an op
                            // exhibiting e.g. "SLAGGING+UNUSUAL-SHAPE" counts/plots under
                            // whichever of the two it fits more strongly, never both -
                            // otherwise the same reading would double-count across charts.
                            const byCondition = {};
                            sd.ops.forEach(o => {
                                if (!o.condition || o.condition === '-' || !o.current || !o.current.length) return;
                                const primary = o.condition.split('+')[0];
                                (byCondition[primary] = byCondition[primary] || []).push(o);
                            });
                            const condEntries = Object.entries(byCondition).sort((a, b) => b[1].length - a[1].length);
                            const ideal = sd.ops.find(o => o.confirmed === 'NORMAL' && o.current && o.current.length);
                            const chartW = 650, chartH = 280;
                            const xs = arr => arr.map((_, i) => i * SAMPLE_MS4);

                            for (const [condName, occurrences] of condEntries) {
                                const count = occurrences.length;

                                const traces = occurrences.map((o, i) => ({
                                    x: xs(o.current), y: o.current, mode: 'lines',
                                    name: `${condName} #${i + 1}`, showlegend: false,
                                    line: { color: '#dc2626', width: 1.5 }, opacity: 0.45,
                                }));
                                if (ideal) {
                                    traces.push({ x: xs(ideal.current), y: ideal.current, mode: 'lines', name: 'Healthy (normal)', line: { color: '#16a34a', width: 2.5 } });
                                }
                                const fig = {
                                    data: traces,
                                    layout: {
                                        width: chartW, height: chartH,
                                        margin: { l: 46, r: 14, t: 10, b: 40 },
                                        xaxis: { showgrid: false, title: { text: 'time (ms)', font: { size: 10 } } },
                                        yaxis: { zeroline: false, title: { text: 'Current (A)', font: { size: 10 } }, gridcolor: '#eef2f6' },
                                        showlegend: false,
                                        font: { size: 10 },
                                    }
                                };
                                try {
                                    const png = await Plotly.toImage(fig, { format: 'png', width: chartW, height: chartH });
                                    const imgH = contentW * chartH / chartW;
                                    ensure(imgH + 26);
                                    doc.setFontSize(9); doc.setFont('helvetica', 'bold'); doc.setTextColor(30, 41, 59);
                                    doc.text(cleanTxt(`${sideName} - ${condName} - All ${count} Occurrences (red) vs Healthy (green)`), M + 4, y);
                                    y += 12;
                                    doc.addImage(png, 'PNG', M, y, contentW, imgH);
                                    doc.setDrawColor(226, 232, 240); doc.setLineWidth(0.5); doc.rect(M, y, contentW, imgH);
                                    y += imgH + 14;
                                } catch (e) { console.error(`All-occurrences chart export failed for ${sideName}/${condName}:`, e); }
                            }

                            // \u2500\u2500 5. DETECTED FAULT CONDITIONS TEXT (this side) \u2500\u2500
                            if (condEntries.length) {
                                ensure(40);
                                doc.setFontSize(9); doc.setFont('helvetica', 'bold'); doc.setTextColor(30, 41, 59);
                                doc.text(`${sideName} - Detected Fault Conditions:`, M + 4, y);
                                y += 12;

                                condEntries.forEach(([condName, occurrences]) => {
                                    const cInfo = CONDITION_INFO4[condName] ? CONDITION_INFO4[condName].text : '';
                                    const lineStr = cleanTxt(`\u2022 ${sideName} - ${condName} (${occurrences.length} ops): ${cInfo}`);
                                    const lines = doc.splitTextToSize(lineStr, contentW - 16);
                                    ensure(lines.length * 10 + 2);
                                    doc.setFontSize(8); doc.setFont('helvetica', 'normal'); doc.setTextColor(71, 85, 105);
                                    lines.forEach((ln, li) => {
                                        doc.text(ln, M + 10, y);
                                        y += 10;
                                    });
                                });
                                y += 8;
                            }

                            // \u2500\u2500 6. TIMELINE CHART (this side only) \u2500\u2500
                            if (sd.ops.length) {
                                try {
                                    const trace = timelineTrace4(sd.ops, 1, sideName, sideKey);
                                    const png = await Plotly.toImage({ data: [trace], layout: { width: 1000, height: 260, margin: { l: 46, r: 14, t: 10, b: 40 }, yaxis: { tickmode: 'array', tickvals: [1], ticktext: [sideKey.toUpperCase()], range: [0.5, 1.5] }, showlegend: false } }, { format: 'png', width: 1000, height: 260 });
                                    const imgH = contentW * 260 / 1000;
                                    ensure(imgH + 20);
                                    doc.setFontSize(9); doc.setFont('helvetica', 'bold'); doc.setTextColor(30, 41, 59);
                                    doc.text(`${sideName} - Timeline of Operations (30 Days)`, M + 4, y);
                                    y += 12;
                                    doc.addImage(png, 'PNG', M, y, contentW, imgH);
                                    doc.setDrawColor(226, 232, 240); doc.setLineWidth(0.5); doc.rect(M, y, contentW, imgH);
                                    y += imgH + 16;
                                } catch (e) { console.error(`Timeline export failed for ${sideName}:`, e); }
                            }

                            // \u2500\u2500 7. MEASUREMENT TREND CHARTS (this side, 4 core parameters) \u2500\u2500
                            if (sd.ops.some(o => o.features)) {
                                const halfW = (contentW - 12) / 2;
                                const chartH2 = halfW * 200 / 380;

                                for (let ti = 0; ti < CORE_TRENDS.length; ti++) {
                                    const tInfo = CORE_TRENDS[ti];
                                    const ylabel = FEATURE_LABELS4[tInfo.key] || tInfo.key;

                                    const byDirOps = {};
                                    sd.ops.forEach(o => {
                                        if (!o.time || !o.features) return;
                                        const v = o.features[tInfo.key];
                                        if (v == null || !isFinite(v)) return;
                                        const d = o.direction || '?';
                                        (byDirOps[d] = byDirOps[d] || []).push(o);
                                    });
                                    const dirs = Object.keys(byDirOps).sort();
                                    if (!dirs.length) continue;

                                    ensure(60);
                                    doc.setFillColor(238, 242, 255); doc.setDrawColor(99, 102, 241); doc.setLineWidth(1);
                                    doc.roundedRect(M, y, contentW, 26, 4, 4, 'FD');
                                    doc.setFontSize(9); doc.setFont('helvetica', 'bold'); doc.setTextColor(30, 27, 75);
                                    doc.text(cleanTxt(`${sideName} - MEASUREMENT TREND ${ti + 1}/4: ${tInfo.name.toUpperCase()}`), M + 10, y + 16);
                                    doc.setFontSize(8); doc.setFont('helvetica', 'bold'); doc.setTextColor(79, 70, 229);
                                    doc.text(cleanTxt(`- ${tInfo.desc}`), pageW - M - 10, y + 16, { align: 'right' });
                                    y += 34;

                                    ensure(chartH2 + 28);
                                    for (let di = 0; di < dirs.length; di++) {
                                        const dir = dirs[di];
                                        const resObj = makeTrendFig(byDirOps[dir], tInfo.key, ylabel);
                                        if (!resObj) continue;

                                        const isSecondCol = (di % 2 === 1);
                                        const xPos = isSecondCol ? (M + halfW + 12) : M;

                                        doc.setFontSize(7.5); doc.setFont('helvetica', 'bold'); doc.setTextColor(100, 116, 139);
                                        doc.text(cleanTxt(`DIR-${dir.toUpperCase()} \u00b7 ${resObj.count} OPS`), xPos + 2, y);

                                        try {
                                            const png = await Plotly.toImage(resObj.fig, { format: 'png', width: 650, height: 340 });
                                            doc.addImage(png, 'PNG', xPos, y + 4, halfW, chartH2);
                                            doc.setDrawColor(226, 232, 240); doc.setLineWidth(0.5);
                                            doc.rect(xPos, y + 4, halfW, chartH2);
                                        } catch (e) { console.error('Trend image export failed:', e); }

                                        if (isSecondCol || di === dirs.length - 1) y += chartH2 + 16;
                                    }
                                    y += 6;
                                }
                            }

                            // \u2500\u2500 8. FLAGGED OPERATIONS (ALERT / FAULT), this side \u2500\u2500
                            const flaggedOps = sd.ops.filter(op => {
                                const g = op.confirmed || op.grade;
                                return g === 'ALERT' || g === 'FAULT';
                            });
                            if (flaggedOps.length) {
                                ensure(50);
                                doc.setFontSize(9); doc.setFont('helvetica', 'bold'); doc.setTextColor(220, 38, 38);
                                doc.text(`${sideName} - Flagged Strokes / Anomaly Details (${flaggedOps.length}):`, M + 4, y);
                                y += 12;

                                const flagHead = [['Timestamp', 'Dir', 'Grade', 'Condition', 'Primary Reason']];
                                const flagRows = flaggedOps.slice(0, 15).map(op => [
                                    new Date(op.time).toLocaleString('en-IN', { dateStyle: 'short', timeStyle: 'short' }),
                                    `dir-${op.direction || '?'}`,
                                    op.confirmed || op.grade || '\u2014',
                                    cleanTxt(op.condition || '\u2014'),
                                    cleanTxt(humanizeDrivers4(op.reason) || op.cond_notes || '\u2014')
                                ]);

                                if (typeof doc.autoTable === 'function') {
                                    doc.autoTable({
                                        startY: y,
                                        margin: { left: M, right: M },
                                        head: flagHead,
                                        body: flagRows,
                                        theme: 'striped',
                                        headStyles: { fillColor: [185, 28, 28], textColor: [255, 255, 255], fontStyle: 'bold', fontSize: 7.5 },
                                        bodyStyles: { textColor: [51, 65, 85], fontSize: 7.5, cellPadding: 3.5 },
                                        alternateRowStyles: { fillColor: [254, 242, 242] },
                                        columnStyles: {
                                            0: { cellWidth: 95 },
                                            1: { cellWidth: 45, halign: 'center' },
                                            2: { cellWidth: 55, halign: 'center', fontStyle: 'bold' },
                                            3: { cellWidth: 110 },
                                            4: { halign: 'left' }
                                        }
                                    });
                                    y = doc.lastAutoTable.finalY + 12;
                                }
                            }

                            y += 10;
                        }

                        // \u2500\u2500 9. CURRENT / VOLTAGE DETAIL CHARTS IF DISPLAYED \u2500\u2500
                        const curEl = document.getElementById('detailCurrentChart4');
                        const volEl = document.getElementById('detailVoltageChart4');
                        if (curEl && curEl.layout && SELECTED4 && SELECTED4.op) {
                            ensure(160);
                            doc.setFontSize(9); doc.setFont('helvetica', 'bold'); doc.setTextColor(30, 41, 59);
                            doc.text(cleanTxt(`Selected Operation Waveform (${SELECTED4.label} \u00b7 dir-${SELECTED4.op.direction || '?'})`), M + 4, y);
                            y += 12;

                            const halfW = (contentW - 10) / 2;
                            try {
                                const pngCur = await Plotly.toImage(curEl, { format: 'png', width: 600, height: 350 });
                                doc.addImage(pngCur, 'PNG', M, y, halfW, halfW * 350 / 600);
                                doc.rect(M, y, halfW, halfW * 350 / 600);
                            } catch (e) { }

                            if (volEl && volEl.layout) {
                                try {
                                    const pngVol = await Plotly.toImage(volEl, { format: 'png', width: 600, height: 350 });
                                    doc.addImage(pngVol, 'PNG', M + halfW + 10, y, halfW, halfW * 350 / 600);
                                    doc.rect(M + halfW + 10, y, halfW, halfW * 350 / 600);
                                } catch (e) { }
                            }
                            y += (halfW * 350 / 600) + 16;
                        }

                        // \u2500\u2500 8. PAGE NUMBERS AND FOOTER \u2500\u2500
                        const pageCount = doc.getNumberOfPages();
                        for (let i = 1; i <= pageCount; i++) {
                            doc.setPage(i);
                            doc.setDrawColor(226, 232, 240); doc.setLineWidth(0.5);
                            doc.line(M, pageH - 22, pageW - M, pageH - 22);

                            doc.setFontSize(7.5); doc.setFont('helvetica', 'normal'); doc.setTextColor(148, 163, 184);
                            doc.text('Energy7 Predictive Maintenance \u2014 Point Machine V4 Analytics', M, pageH - 10);
                            doc.text(`Page ${i} of ${pageCount}`, pageW - M, pageH - 10, { align: 'right' });
                        }

                        const safeAsset = (pm.assetName || 'asset').replace(/[\\/:*?"<>|]+/g, ' ').trim();
                        doc.save(`pm4 report ${safeAsset}.pdf`);
                    } catch (e) {
                        alert('PDF generation failed: ' + e.message);
                    } finally {
                        if (btn) { btn.disabled = false; btn.style.opacity = '1'; btn.style.cursor = 'pointer'; btn.innerHTML = origHtml; }
                    }
                }

                // Exposed on window - onclick="..." attributes in the HTML above fire in
                // global scope, not this IIFE's lexical scope. Names carry a "4" suffix so
                // they cannot collide with Model 1/2/3's own window exposures.
                window.fetchAssets4 = fetchAssets4;
                window.toggleSidebar4 = toggleSidebar4;

                function toggleSidebar4(forceCollapsed) {
                    const sidebar = document.querySelector('#model4-wrap .sidebar');
                    const toggleBtn = document.getElementById('sidebar-toggle-btn4');
                    if (!sidebar) return;
                    const isCollapsed = typeof forceCollapsed === 'boolean'
                        ? (sidebar.classList.toggle('collapsed', forceCollapsed), forceCollapsed)
                        : sidebar.classList.toggle('collapsed');
                    if (toggleBtn) {
                        toggleBtn.title = isCollapsed ? 'Expand Sidebar' : 'Collapse Sidebar';
                        toggleBtn.classList.toggle('collapsed-active', isCollapsed);
                    }
                    setSidebarCssWidth('model4-wrap', isCollapsed ? 64 : getSavedSidebarWidth());
                    setTimeout(() => window.dispatchEvent(new Event('resize')), 300);
                }

                function updateCompactSidebar4() {
                    const quickIcon = document.getElementById('compact-mode-quick4');
                    const customIcon = document.getElementById('compact-mode-custom4');
                    if (quickIcon && customIcon) {
                        const isCustom = currentAnalysisMode4 === 'custom';
                        quickIcon.style.display = isCustom ? 'none' : 'block';
                        customIcon.style.display = isCustom ? 'block' : 'none';
                    }
                    const badge = document.getElementById('compact-pm-badge4');
                    if (badge) {
                        const pm = S4.selectedAsset;
                        setCompactBadgeText(badge, pm && pm.assetName);
                        badge.title = pm ? pm.assetName : 'No point machine selected';
                    }
                }
                window.selectAsset4 = selectAsset4;
                window.renderWatchlist4 = renderWatchlist4;
                window.updateCurrentAsset4 = updateCurrentAsset4;
                window.switchAnalysisMode4 = switchAnalysisMode4;
                window.validateDateRange4 = validateDateRange4;
                window.applyCustomDates4 = applyCustomDates4;
                window.onTrendFeatureChange4 = onTrendFeatureChange4;
                window.toggleGradeHighlight4 = toggleGradeHighlight4;
                window.showConditionExplain4 = showConditionExplain4;
                window.submitFeedback4 = submitFeedback4;
                window.clearFeedback4 = clearFeedback4;
                window.exportPm4Pdf4 = exportPm4Pdf4;
                window.__pmState4 = S4;

                loadSites4();
            })();
        </script>
    </div><!-- /#model4-wrap -->

    <script>
        // \u2500\u2500 Cramped-host layout fixes (see 2026-09-08 request: this file gets
        // embedded inside the Energy7 shell, which has its own left nav "drawer" -
        // stacking our own 300px sidebar on top of that leaves almost no room for
        // charts). We can't touch the host shell, so this narrows our own sidebar,
        // auto-collapses it when we detect we're cramped, and lets the user
        // drag-resize it back open if they want it. True top-level (not inside any
        // model's IIFE) since it has to reach all four sidebars uniformly. \u2500\u2500
        (function () {
            const SIDEBAR_MIN = 180, SIDEBAR_MAX = 420, SIDEBAR_DEFAULT = 200;
            const WIDTH_KEY = 'pm-combined-sidebar-width';

            function applyWidth(sidebar, px) {
                sidebar.style.flexBasis = px + 'px';
                sidebar.style.width = px + 'px';
                const wrap = sidebar.closest('.pm-combined-section');
                if (wrap) wrap.style.setProperty('--sidebar-w', px + 'px');
            }

            function setupResizer(sidebar) {
                if (!sidebar || sidebar.dataset.pmResizer) return;
                sidebar.dataset.pmResizer = '1';

                const saved = parseInt(localStorage.getItem(WIDTH_KEY), 10);
                const initial = (saved >= SIDEBAR_MIN && saved <= SIDEBAR_MAX) ? saved : SIDEBAR_DEFAULT;
                applyWidth(sidebar, initial);

                const handle = document.createElement('div');
                handle.className = 'pm-sidebar-resizer';
                handle.title = 'Drag to resize sidebar';
                sidebar.insertAdjacentElement('afterend', handle);

                let dragging = false, startX = 0, startWidth = 0;
                const clientX = e => (e.touches ? e.touches[0].clientX : e.clientX);
                const onDown = e => {
                    if (sidebar.classList.contains('collapsed')) return;
                    dragging = true;
                    startX = clientX(e);
                    startWidth = sidebar.getBoundingClientRect().width;
                    document.body.style.cursor = 'col-resize';
                    document.body.style.userSelect = 'none';
                    e.preventDefault();
                };
                const onMove = e => {
                    if (!dragging) return;
                    const next = Math.max(SIDEBAR_MIN, Math.min(SIDEBAR_MAX, startWidth + (clientX(e) - startX)));
                    applyWidth(sidebar, next);
                };
                const onUp = () => {
                    if (!dragging) return;
                    dragging = false;
                    document.body.style.cursor = '';
                    document.body.style.userSelect = '';
                    localStorage.setItem(WIDTH_KEY, Math.round(sidebar.getBoundingClientRect().width));
                    window.dispatchEvent(new Event('resize'));
                };
                handle.addEventListener('mousedown', onDown);
                handle.addEventListener('touchstart', onDown, { passive: false });
                window.addEventListener('mousemove', onMove);
                window.addEventListener('touchmove', onMove, { passive: false });
                window.addEventListener('mouseup', onUp);
                window.addEventListener('touchend', onUp);
            }

            // Each model's real toggleSidebar[N]() (window-exposed by its own IIFE)
            // already handles the collapse CSS class AND that model's icon/active
            // button state together - reuse it instead of duplicating that logic,
            // so an auto-collapsed sidebar looks identical to a manually-collapsed
            // one and the toggle button still expands it correctly afterwards.
            function autoCollapseIfCramped() {
                const embedded = (() => { try { return window.self !== window.top; } catch (e) { return true; } })();
                const narrow = window.innerWidth < 1300;
                if (!embedded && !narrow) return;
                ['toggleSidebar', 'toggleSidebar2', 'toggleSidebar3', 'toggleSidebar4'].forEach(fn => {
                    try { if (typeof window[fn] === 'function') window[fn](); } catch (e) { }
                });
            }

            function init() {
                document.querySelectorAll('#model1-wrap .sidebar, #model2-wrap .sidebar, #model3-wrap .sidebar, #model4-wrap .sidebar')
                    .forEach(setupResizer);
                autoCollapseIfCramped();
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();

        document.addEventListener('DOMContentLoaded', function () {
            var hasModel1 = document.getElementById('model1-wrap');
            if (!hasModel1) {
                pmSwitch(3); // Model 1 નથી → Model 3 active કરો
            }
        });
    </script>
</body>
</div>
