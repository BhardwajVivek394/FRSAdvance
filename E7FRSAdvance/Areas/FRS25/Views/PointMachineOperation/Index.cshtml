                                                                </div>
                                                                <textarea id="feedbackNote3" placeholder="What's wrong with this operation? (required)" style="width:100%; padding:8px; border:1px solid var(--border); border-radius:var(--radius); background:var(--bg-card); color:var(--text-primary); font-size:12px; min-height:60px;"></textarea>
                                                                <div style="margin-top:8px; display:flex; gap:10px; align-items:center;">
                                                                    <button class="btn primary" style="width:auto; padding:7px 14px;" onclick="submitFeedback3()">Save Feedback</button>
                                                                    <span id="feedbackStatus3" style="font-size:11px; color:var(--text-muted);"></span>
