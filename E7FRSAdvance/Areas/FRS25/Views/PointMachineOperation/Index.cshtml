<body>
    <script>
        // API base is configurable for deployments where this HTML is hosted on a
        // different server from FastAPI. Set ?pmApiBase=https://api.example.com once
        // (or localStorage.pmApiBase) to target that API; an empty setting preserves
        // the normal same-origin behaviour. All four embedded models share this base.
        const pmApiBaseParam = new URLSearchParams(window.location.search).get('pmApiBase');
        const pmApiBaseSaved = localStorage.getItem('pmApiBase');
        const pmApiBaseConfigured = pmApiBaseParam || pmApiBaseSaved || window.PM_API_BASE || '';
        if (pmApiBaseParam) localStorage.setItem('pmApiBase', pmApiBaseParam);
        // endpoints via PM/PM2/PM3/PM4_ENDPOINTS

        // Shared, TRUE top-level switch-bar handler (mirrors pm_operation.html's
        // pmSwitch(model)) - NOT inside either app's IIFE, since it's called from
        // onclick="pmSwitch(1)"/"pmSwitch(2)" attributes below. Both wrapper
        // sections stay mounted in the DOM at all times; only which one is
        // visible (via the "active" class) changes, so switching back and forth
        // never resets either app's state.
        // Per-model hooks used to carry the selected point machine across tabs
        // (see pmSwitch below) - each model exposes a read-only state ref
        // (window.__pmStateN) plus its existing site-fetch/asset-select functions,
        // so switching tabs re-selects the same physical asset instead of landing
        // on that model's empty/default screen.
        // Fills the collapsed-rail's tiny machine badge without ever truncating a
        // character off the name (asset names are "NNN/NNN" - slicing to a fixed
        // character count used to cut the last digit) - splits on "/" and stacks
        // the two halves on separate lines instead. Uses DOM nodes, not innerHTML,
        // since the name comes from historian data, not something we've sanitized.
        function setCompactBadgeText(el, name) {
            el.innerHTML = '';
            if (!name) { el.textContent = '\u2013'; return; }
            String(name).split('/').forEach((part, i) => {
                if (i > 0) el.appendChild(document.createElement('br'));
                el.appendChild(document.createTextNode(part));
            });
        }

        // Single source of truth for "how wide should the sidebar be when it's not
        // collapsed" - read by both the drag-resizer and every toggleSidebarN() so
        // expanding after a collapse restores whatever width the user last dragged
        // it to (falling back to the 200px default), instead of a hardcoded value.
        const SIDEBAR_WIDTH_KEY = 'pm-combined-sidebar-width';
        function getSavedSidebarWidth() {
            const saved = parseInt(localStorage.getItem(SIDEBAR_WIDTH_KEY), 10);
            return (saved >= 180 && saved <= 420) ? saved : 200;
        }

        // The header row is split into a sidebar-width slot (holding the collapse
        // toggle) and a content slot (badge/title) - see the per-model header
        // markup. Both need to track the SAME width as the actual sidebar body so
        // the header visually shifts in lockstep as the drawer resizes/collapses;
        // a CSS custom property on the model's wrapper div is the one value both
        // the header slot's CSS (width: var(--sidebar-w)) and this call site share.
        function setSidebarCssWidth(wrapId, px) {
            const wrap = document.getElementById(wrapId);
            if (wrap) wrap.style.setProperty('--sidebar-w', px + 'px');
        }

        const PM_MODEL_CONFIG = {
            1: { siteSelectId: 'siteSelect', fetchFn: 'fetchPointMachines', selectFn: 'selectPointMachine', assetsKey: 'pointMachines', getState: () => window.__pmState1 },
            2: { siteSelectId: 'siteSelect2', fetchFn: 'fetchAssets', selectFn: 'selectAsset', assetsKey: 'assets', getState: () => window.__pmState2 },
            3: { siteSelectId: 'siteSelect3', fetchFn: 'fetchPointMachines3', selectFn: 'selectAsset3', assetsKey: 'pointMachines', getState: () => window.__pmState3 },
            4: { siteSelectId: 'siteSelect4', fetchFn: 'fetchAssets4', selectFn: 'selectAsset4', assetsKey: 'assets', getState: () => window.__pmState4 },
        };

        async function pmCarrySelectedAsset(model, carry) {
            const cfg = PM_MODEL_CONFIG[model];
            if (!cfg || !carry || !carry.assetId) return;
            const st = cfg.getState();
            if (!st) return;

            // Already showing this exact asset (e.g. bounced back to a tab you never
            // left the data on) - nothing to do.
            if (st.selectedAsset && String(st.selectedAsset.assetId) === String(carry.assetId)
                && String(st.currentSiteId) === String(carry.siteId)) return;

            const siteSelect = document.getElementById(cfg.siteSelectId);
            if (!siteSelect) return;

            // Site lists load async on first paint - give a not-yet-populated
            // dropdown a brief moment before giving up.
            for (let i = 0; i < 10 && siteSelect.options.length <= 1; i++) {
                await new Promise(r => setTimeout(r, 200));
            }
            const hasSite = Array.from(siteSelect.options).some(o => String(o.value) === String(carry.siteId));
            if (!hasSite) return; // this model doesn't serve that site - leave it as-is

            if (String(siteSelect.value) !== String(carry.siteId)) {
                siteSelect.value = String(carry.siteId);
            }
            await window[cfg.fetchFn]();

            const assets = st[cfg.assetsKey] || [];
            let idx = assets.findIndex(a => String(a.assetId) === String(carry.assetId));
            if (idx < 0 && carry.assetName) idx = assets.findIndex(a => a.assetName === carry.assetName);
            if (idx >= 0) await window[cfg.selectFn](idx);
        }

        async function pmSwitch(model) {
            const sections = {
                1: document.getElementById('model1-wrap'),
                2: document.getElementById('model2-wrap'),
                3: document.getElementById('model3-wrap'),
                4: document.getElementById('model4-wrap')
            };
            const buttons = {
                1: document.getElementById('btn-model-1'),
                2: document.getElementById('btn-model-2'),
                3: document.getElementById('btn-model-3'),
                4: document.getElementById('btn-model-4')
            };
            Object.keys(sections).forEach(k => {
                if (sections[k]) sections[k].classList.remove('active');
                if (buttons[k]) buttons[k].classList.remove('active');
            });
            if (sections[model]) sections[model].classList.add('active');
            if (buttons[model]) buttons[model].classList.add('active');
        }

        // Single click handler drives BOTH directions of the drawer, so there is
        // only ever one decision made per click (no separate expand-handler and
        // collapse-handler fighting over the same event, which previously expanded
        // then immediately re-collapsed in the same click):
        //  - collapsed + click anywhere in the rail -> expand
        //  - expanded + click on blank/non-interactive space in it, or anywhere
        //    else on the page -> collapse
        //  - a real control (select/input/button/link) inside it, or the header's
        //    own toggle button, is left completely alone either way.
        const SIDEBAR_TOGGLE_FN = { 1: 'toggleSidebar', 2: 'toggleSidebar2', 3: 'toggleSidebar3', 4: 'toggleSidebar4' };
        function isInteractiveEl(el, boundary) {
            while (el && el !== boundary) {
                if (['SELECT', 'INPUT', 'BUTTON', 'A', 'TEXTAREA'].includes(el.tagName) || el.hasAttribute('onclick')) return true;
                el = el.parentElement;
            }
            return false;
        }
        document.addEventListener('click', (e) => {
            const switchBar = document.getElementById('pm-switch-bar');
            if (switchBar && switchBar.contains(e.target)) return; // switching tabs shouldn't collapse the tab you're switching to

            const activeKey = Object.keys(SIDEBAR_TOGGLE_FN).find(k => {
                const el = document.getElementById(`model${k}-wrap`);
                return el && el.classList.contains('active');
            });
            if (!activeKey) return;
            const wrapId = `model${activeKey}-wrap`;
            const sidebar = document.querySelector(`#${wrapId} .sidebar`);
            if (!sidebar) return;

            const headerSlot = document.querySelector(`#${wrapId} .header-sidebar-slot`);
            if (headerSlot && headerSlot.contains(e.target)) return; // toggle button's own onclick handles this

            const fn = window[SIDEBAR_TOGGLE_FN[activeKey]];
            if (typeof fn !== 'function') return;

            if (sidebar.classList.contains('collapsed')) {
                if (sidebar.contains(e.target)) fn(false);
                return;
            }

            if (sidebar.contains(e.target) && isInteractiveEl(e.target, sidebar)) return; // real control - let it work normally
            fn(true);
        });
    </script>

    <style>
        /* FRS Advance: 617's aurora-bridge.css forces day/night colours on labels, form controls and
           .card with !important. Keep each model's own palette (its CSS variables follow the model's
           own light/dark toggle); the id selectors out-rank the bridge rules. */
        body #model1-wrap label, body #model3-wrap label, body #model4-wrap label { color: var(--text-muted) !important; }
        body #model1-wrap select, body #model1-wrap textarea, body #model1-wrap .form-control,
        body #model3-wrap select, body #model3-wrap textarea, body #model3-wrap .form-control,
        body #model4-wrap select, body #model4-wrap textarea, body #model4-wrap .form-control,
        body #model1-wrap input:not([type=checkbox]):not([type=radio]):not([type=range]):not([type=color]):not([type=file]):not([type=button]):not([type=submit]),
        body #model3-wrap input:not([type=checkbox]):not([type=radio]):not([type=range]):not([type=color]):not([type=file]):not([type=button]):not([type=submit]),
        body #model4-wrap input:not([type=checkbox]):not([type=radio]):not([type=range]):not([type=color]):not([type=file]):not([type=button]):not([type=submit]) {
            background-color: var(--bg-primary, var(--bg-card, #fff)) !important; color: var(--text-primary) !important; border-color: var(--border) !important;
        }
        body #model1-wrap select option, body #model3-wrap select option, body #model4-wrap select option { background: var(--bg-card, #fff) !important; color: var(--text-primary) !important; }
        body #model1-wrap .card, body #model3-wrap .card, body #model4-wrap .card { background: var(--bg-card) !important; color: var(--text-primary) !important; border-color: var(--border) !important; -webkit-backdrop-filter: none; backdrop-filter: none; }
        body #model2-wrap label { color: var(--muted) !important; }
        body #model2-wrap select, body #model2-wrap textarea, body #model2-wrap .form-control,
        body #model2-wrap input:not([type=checkbox]):not([type=radio]):not([type=range]):not([type=color]):not([type=file]):not([type=button]):not([type=submit]) {
            background-color: var(--surface) !important; color: var(--text) !important; border-color: var(--border) !important;
        }
        body #model2-wrap select option { background: var(--surface) !important; color: var(--text) !important; }
        body #model2-wrap .card { background: var(--surface) !important; color: var(--text) !important; border-color: var(--border) !important; -webkit-backdrop-filter: none; backdrop-filter: none; }
        body #model1-wrap .card-header, body #model1-wrap .card-body, body #model2-wrap .card-header, body #model2-wrap .card-body,
        body #model3-wrap .card-header, body #model3-wrap .card-body, body #model4-wrap .card-header, body #model4-wrap .card-body { color: inherit !important; }
    </style>

