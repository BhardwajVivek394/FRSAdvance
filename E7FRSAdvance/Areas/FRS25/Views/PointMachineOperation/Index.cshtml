                                    <label style="font-size:10.5px; font-weight:700; color:var(--muted); display:block; margin-bottom:3px;">From Time</label>
                                    <input type="time" id="custom-from-time2" value="00:00:00" step="1" style="font-size:11.5px; padding:5px 7px; width:100%;" onchange="validateDateRange2()">
                                </div>
                                <div>
                                    <label style="font-size:10.5px; font-weight:700; color:var(--muted); display:block; margin-bottom:3px;">To Date</label>
                                    <input type="date" id="custom-to-date2" style="font-size:11.5px; padding:5px 7px; width:100%; margin-bottom:6px;" onchange="validateDateRange2()">
                                    <label style="font-size:10.5px; font-weight:700; color:var(--muted); display:block; margin-bottom:3px;">To Time</label>
                                    <input type="time" id="custom-to-time2" value="23:59:59" step="1" style="font-size:11.5px; padding:5px 7px; width:100%;" onchange="validateDateRange2()">
                                </div>
                            </div>
                            <div id="date-range-error2" style="display:none; font-size:11px; font-weight:600; color:#dc2626; margin-top:8px; background:rgba(220,38,38,0.08); border:1px solid rgba(220,38,38,0.25); padding:6px 8px; border-radius:6px;"></div>
                            <button class="btn primary" id="apply-custom-dates-btn2" style="margin-top:8px;" onclick="applyCustomDates2()" disabled>Analyze This Range</button>
                        </div>

                        <div class="form-row" id="pm-list-section2" style="margin-top:18px;">
                            <label>Point Machines <span id="pmCount2" style="color:var(--accent);"></span></label>
                            <select id="quick-pm-select2" style="font-size:11.5px; padding:5px 7px; width:100%; margin-bottom:8px;" onchange="if (this.value !== '') selectAsset(Number(this.value))">
                                <option value="">-- Select --</option>
                            </select>
                            <div id="pmList2" style="display:none;"></div>
