                                                            <div class="card-title">Fault families \u2014 what they mean</div>
                                                            <div id="faultLegend3"></div>
                                                        </div>
                                                    `;
                    renderTimeline(data.ops);
                    renderClassBands(data.ops);
                    if (isPdfExport) {
                        renderTimelineSide3(data.ops, 'a', 'Machine A', 'timelineA3');
                        renderTimelineSide3(data.ops, 'b', 'Machine B', 'timelineB3');
                    }
                    renderFaultLegend();
                    await renderFaultCharts(data);
                }

                document.addEventListener('DOMContentLoaded', () => {
                    applyTheme();
                    document.getElementById('themeBtn3').onclick = () => {
                        S.theme = S.theme === 'dark' ? 'light' : 'dark';
                        localStorage.setItem('pm3-theme', S.theme);
                        applyTheme();
                    };
                    loadSites().then(autoLoadFromUrl3);
                });

                // Deep-link auto-load (?model=3&SiteId=&AssetId=&autoload=1) - drives this
                // exact tab to a specific asset's results without any manual clicking. The
                // ONLY consumer today is the server-side PDF export (see /pm_operation_
                // combined/pdf in pm_operation/app.py): it navigates a headless browser
                // here, waits for window.__pdfReady3, then prints - so the exported PDF is
                // pixel-identical to what a user would see (real HTML/CSS, selectable
                // text), not a client-side screenshot/rasterization.
                async function autoLoadFromUrl3() {
                    const params = new URLSearchParams(window.location.search);
                    if (params.get('model') !== '3' || !params.get('autoload')) return;
                    pmSwitch(3);
                    const siteId = params.get('SiteId'), assetId = params.get('AssetId');
                    if (!siteId || !assetId) { window.__pdfReady3 = true; return; }
                    try {
                        document.getElementById('siteSelect3').value = siteId;
                        S.currentSiteId = siteId;
                        await fetchPointMachines3();
                        const idx = S.pointMachines.findIndex(a => String(a.assetId) === String(assetId));
                        if (idx >= 0) await selectAsset3(idx);
                        const start = Date.now();
                        while (Date.now() - start < 8000 && document.getElementById('aiSummaryBox3').style.display !== 'block') {
                            await new Promise(r => setTimeout(r, 300));
                        }
                        await new Promise(r => setTimeout(r, 3000));   // let the ~100+ Plotly tile charts finish painting
                    } finally {
                        window.__pdfReady3 = true;   // set even on failure - the server-side waiter must not hang forever
                    }
                }

                // Guarded on #model3-wrap.active so Prev/Next arrow keys only fire while the
                // Model 3 tab is the one on screen - CURRENT_DETAIL3 alone isn't enough since
                // it stays set (last-viewed operation) even after switching to Model 1/2.
                document.addEventListener('keydown', (e) => {
                    if (!CURRENT_DETAIL3) return;
                    const wrap = document.getElementById('model3-wrap');
                    if (!wrap || !wrap.classList.contains('active')) return;
                    const tag = (document.activeElement && document.activeElement.tagName) || '';
                    if (tag === 'INPUT' || tag === 'SELECT' || tag === 'TEXTAREA') return;
                    if (e.key === 'ArrowRight') { e.preventDefault(); navigateDetail3(1); }
                    else if (e.key === 'ArrowLeft') { e.preventDefault(); navigateDetail3(-1); }
                });

                // Exposed on window - onclick="..." attributes in the HTML above fire in
                // global scope, not this IIFE's lexical scope. Names carry a "3" suffix
                // specifically so they cannot collide with Model 1's/Model 2's own
                // window.fetchAssets/selectAsset/updateCurrentAsset exposures below.
                window.fetchPointMachines3 = fetchPointMachines3;
                window.toggleSidebar3 = toggleSidebar3;

                function toggleSidebar3(forceCollapsed) {
                    const sidebar = document.querySelector('#model3-wrap .sidebar');
                    const toggleBtn = document.getElementById('sidebar-toggle-btn3');
                    if (!sidebar) return;
                    const isCollapsed = typeof forceCollapsed === 'boolean'
                        ? (sidebar.classList.toggle('collapsed', forceCollapsed), forceCollapsed)
                        : sidebar.classList.toggle('collapsed');
                    if (toggleBtn) {
                        toggleBtn.title = isCollapsed ? 'Expand Sidebar' : 'Collapse Sidebar';
                        toggleBtn.classList.toggle('collapsed-active', isCollapsed);
                    }
                    setSidebarCssWidth('model3-wrap', isCollapsed ? 64 : getSavedSidebarWidth());
                    setTimeout(() => window.dispatchEvent(new Event('resize')), 300);
                }

                // Keeps the collapsed-rail icon (mode + selected machine) in sync so it's
                // meaningful even while the full form is hidden - called from
                // switchAnalysisMode3()/selectAsset3() whenever either changes.
                function updateCompactSidebar3() {
                    const quickIcon = document.getElementById('compact-mode-quick3');
                    const customIcon = document.getElementById('compact-mode-custom3');
                    if (quickIcon && customIcon) {
                        const isCustom = currentAnalysisMode3 === 'custom';
                        quickIcon.style.display = isCustom ? 'none' : 'block';
                        customIcon.style.display = isCustom ? 'block' : 'none';
                    }
                    const badge = document.getElementById('compact-pm-badge3');
                    if (badge) {
                        const pm = S.selectedAsset;
                        setCompactBadgeText(badge, pm && pm.assetName);
                        badge.title = pm ? pm.assetName : 'No point machine selected';
                    }
                }
                window.selectAsset3 = selectAsset3;
                window.toggleFaultFilter3 = toggleFaultFilter3;
                window.updateCurrentAsset3 = updateCurrentAsset3;
                window.switchAnalysisMode3 = switchAnalysisMode3;
                window.validateDateRange3 = validateDateRange3;
                window.applyCustomDates3 = applyCustomDates3;
                window.exportPdf3 = exportPdf3;
                window.navigateDetail3 = navigateDetail3;
                window.openFeedbackModal3 = openFeedbackModal3;
                window.onFeedbackLabelChange3 = onFeedbackLabelChange3;
                window.closeFeedbackModal3 = closeFeedbackModal3;
                window.submitFeedback3 = submitFeedback3;
                window.undoShape3 = undoShape3;
                window.redoShape3 = redoShape3;
                window.__pmState3 = S;
                // loadSites() already runs inside this script's own DOMContentLoaded
                // listener (see the tail of v3_script.txt) - no extra call needed here.
            })();
        </script>
    </div><!-- /#model3-wrap -->

