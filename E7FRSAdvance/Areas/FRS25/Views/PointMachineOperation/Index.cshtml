                                <span style="font-size:10px; font-weight:700; color:var(--accent); background:rgba(0,164,224,0.12); padding:2px 6px; border-radius:12px;">Max 90 Days</span>
                            </div>
                            <label style="font-size:10.5px; font-weight:700; color:var(--muted); display:block; margin-bottom:3px;">Point Machine</label>
                            <select id="custom-pm-select2" style="font-size:11.5px; padding:5px 7px; width:100%; margin-bottom:8px;">
                                <option value="">-- Select --</option>
                            </select>
