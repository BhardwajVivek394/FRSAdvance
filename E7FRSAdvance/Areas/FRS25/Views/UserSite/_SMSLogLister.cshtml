
<div class="modal fade bd-example-modal-lg" id="modal-add-smslogs" tabindex="-1" role="dialog" aria-labelledby="modal-add-smslogs" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title isEdit" id="myModalLabel"><span> logs</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-12">
                            <div class="tab-content mt-4">
                                @{
                                    var mFRSAlerts = new List<Domain.FRSAlert>();
                                    if (ViewBag.OldFRSAlerts != null)
                                    {
                                        mFRSAlerts = ViewBag.OldFRSAlerts as List<Domain.FRSAlert>;

                                    }
                                }
                                <div class="col-sm-12">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Alert Type</th>
                                                <th>Asset Type</th>
                                                <th>Asset</th>
                                                <th>Cause_code</th>
                                                <th>Message</th>
                                                <th>Incidence Date & Time</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodySMSLogs">
                                            @if (mFRSAlerts != null && mFRSAlerts.Count > 0)
                                            {
                                                foreach (var frsalert in mFRSAlerts.OrderByDescending(x => x.SetTimeStamp))
                                                {
                                                    <tr>
                                                        <td>
                                                            @if (frsalert.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure)
                                                            {
                                                                <span>@E7FRSAdvance.Utility.Utility.AlertType.Failure.ToString()</span>
                                                            }
                                                            else if (frsalert.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive)
                                                            {
                                                                <span>@E7FRSAdvance.Utility.Utility.AlertType.Predictive.ToString()</span>
                                                            }
                                                        </td>
                                                        <td>@frsalert.AssetType</td>
                                                        <td>@frsalert.AssetName</td>
                                                        <td>@frsalert.CauseCode</td>
                                                        <td>@frsalert.SetAlertMessage</td>
                                                        <td>
                                                            @frsalert.SetTimeStamp
                                                        </td>
                                                        <td>
                                                            <button type="button" class="btn btn-warning" onclick="fnGetAssetAttribute($('#divSite_@(frsalert.SiteId)').data('sitename'),'@frsalert.AssetId','@frsalert.AssetTypeId')">Real Time Data</button>
                                                            @*<button type="button" class="btn btn-warning">Real Time Data</button>*@
                                                        </td>
                                                    </tr>
                                                }

                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>


                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
            </div>
        </div>
    </div>
</div>
