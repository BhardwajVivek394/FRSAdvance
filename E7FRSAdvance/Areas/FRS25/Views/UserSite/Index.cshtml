@model Domain.SiteLister
@{ ViewBag.Title = "RDPMS — Station Board"; }
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box
    }

    :root {
        --bg: #080a12;
        --surface: #121826;
        --surface-2: #172033;
        --surface-3: #1e2840;
        --line: rgba(255,255,255,.07);
        --line-2: rgba(255,255,255,.11);
        --line-3: rgba(255,255,255,.16);
        --text: #eaeff6;
        --text-2: #9fabc1;
        --text-3: #6c778d;
        --text-4: #4d586f;
        --accent: #7c83f2;
        --accent2: #a78bfa;
        --node-l: #8ea2f7;
        --node-c: #5fc6cf;
        --ok: #34d399;
        --ok-soft: rgba(52,211,153,.13);
        --ok-line: rgba(52,211,153,.30);
        --ok-glow: rgba(52,211,153,.5);
        --warn: #f5b544;
        --warn-soft: rgba(245,181,68,.13);
        --warn-line: rgba(245,181,68,.32);
        --warn-glow: rgba(245,181,68,.5);
        --alert: #fb6f84;
        --alert-soft: rgba(251,111,132,.13);
        --alert-line: rgba(251,111,132,.34);
        --alert-glow: rgba(251,111,132,.55);
        --pred: #7aa2f7;
        --mono: 'IBM Plex Mono',ui-monospace,'SF Mono',Menlo,monospace
    }

    html, body {
        min-height: 100%
    }

    body {
        font-family: 'Inter',system-ui,sans-serif;
        color: var(--text);
        background: var(--bg);
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        letter-spacing: -.011em
    }

    .bg-aura {
        position: fixed;
        inset: 0;
        z-index: -2;
        pointer-events: none;
        background: radial-gradient(680px 480px at 84% -8%,rgba(124,131,242,.18),transparent 60%),radial-gradient(640px 520px at 4% 0%,rgba(56,189,248,.10),transparent 56%),radial-gradient(900px 760px at 50% 112%,rgba(167,139,250,.12),transparent 60%),linear-gradient(180deg,#0a0c16,#070910)
    }

    .bg-grain {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: .55;
        background-image: radial-gradient(rgba(255,255,255,.024) 1px,transparent 1px);
        background-size: 26px 26px
    }

    .bg-vignette {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: radial-gradient(135% 95% at 50% -5%,transparent 58%,rgba(0,0,0,.5))
    }

    ::-webkit-scrollbar {
        width: 8px;
        height: 8px
    }

    ::-webkit-scrollbar-track {
        background: transparent
    }

    ::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,.10);
        border-radius: 4px
    }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255,255,255,.2)
        }

    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 13px 24px;
        border-bottom: 1px solid var(--line);
        background: linear-gradient(180deg,rgba(16,21,33,.9),rgba(11,14,22,.82));
        backdrop-filter: blur(20px) saturate(140%);
        -webkit-backdrop-filter: blur(20px) saturate(140%);
        position: sticky;
        top: 0;
        z-index: 50;
        box-shadow: 0 1px 0 rgba(255,255,255,.04),0 8px 24px -16px rgba(0,0,0,.8)
    }

    .topbar-logo {
        display: flex;
        align-items: center;
        gap: 12px
    }

        .topbar-logo .icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: linear-gradient(140deg,#8b91f7,#6366f1 55%,#4f46e5);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15.5px;
            font-weight: 700;
            color: #fff;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.35),0 4px 14px -4px rgba(99,102,241,.7)
        }

        .topbar-logo .title {
            font-size: 16.5px;
            font-weight: 640;
            color: var(--text)
        }

        .topbar-logo .sub {
            font-size: 13px;
            color: var(--text-3);
            margin-top: 1px
        }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 9px
    }

    .pill {
        display: flex;
        align-items: center;
        gap: 7px;
        border-radius: 9px;
        padding: 7px 12px;
        font-size: 14px;
        font-weight: 530;
        color: var(--text-2);
        background: linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.018)) padding-box,linear-gradient(180deg,rgba(255,255,255,.12),rgba(255,255,255,.03)) border-box;
        border: 1px solid transparent
    }

    .sound-ctl {
        position: relative
    }

    .sound-toggle {
        cursor: pointer;
        gap: 7px;
        transition: .15s
    }

        .sound-toggle:hover {
            color: var(--text)
        }

        .sound-toggle.muted {
            color: var(--text-3)
        }

        .sound-toggle .caret {
            font-size: 10.5px;
            color: var(--text-3);
            transition: transform .2s;
            margin-left: 1px
        }

        .sound-toggle.open .caret {
            transform: rotate(180deg)
        }

    .sound-pop {
        position: absolute;
        top: calc(100% + 9px);
        right: 0;
        width: 286px;
        z-index: 200;
        padding: 13px;
        border-radius: 14px;
        background: linear-gradient(180deg,rgba(22,28,44,.99),rgba(13,17,27,.99)) padding-box,linear-gradient(180deg,rgba(255,255,255,.18),rgba(255,255,255,.04)) border-box;
        border: 1px solid transparent;
        box-shadow: 0 28px 64px -22px rgba(0,0,0,.92),inset 0 1px 0 rgba(255,255,255,.06);
        opacity: 0;
        transform: translateY(-7px) scale(.98);
        transform-origin: top right;
        pointer-events: none;
        transition: opacity .18s,transform .18s
    }

        .sound-pop.open {
            opacity: 1;
            transform: none;
            pointer-events: auto
        }

    .sp-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 11px
    }

    .sp-title {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--text-2)
    }

    .sp-switch {
        position: relative;
        width: 38px;
        height: 21px;
        border-radius: 20px;
        background: var(--surface-3);
        border: 1px solid var(--line-2);
        cursor: pointer;
        transition: background .2s;
        flex-shrink: 0
    }

        .sp-switch.on {
            background: linear-gradient(90deg,#10b981,#34d399);
            border-color: transparent;
            box-shadow: 0 0 12px -2px var(--ok-glow)
        }

        .sp-switch::after {
            content: "";
            position: absolute;
            top: 2px;
            left: 2px;
            width: 15px;
            height: 15px;
            border-radius: 50%;
            background: #fff;
            transition: left .2s;
            box-shadow: 0 1px 3px rgba(0,0,0,.5)
        }

        .sp-switch.on::after {
            left: 19px
        }

    .sp-list {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin-bottom: 11px
    }

    .sp-opt {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 7px 8px;
        border-radius: 9px;
        cursor: pointer;
        border: 1px solid transparent;
        transition: background .15s,border-color .15s
    }

        .sp-opt:hover {
            background: rgba(255,255,255,.04)
        }

        .sp-opt.sel {
            background: rgba(124,131,242,.15);
            border-color: rgba(124,131,242,.35)
        }

    .sp-play {
        width: 26px;
        height: 26px;
        border-radius: 7px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: var(--text-2);
        background: linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));
        border: 1px solid var(--line-2);
        transition: .15s
    }

        .sp-play:hover {
            color: var(--accent2);
            border-color: rgba(124,131,242,.5)
        }

        .sp-play svg {
            width: 12px;
            height: 12px;
            fill: currentColor;
            stroke: none
        }

    .sp-opt-meta {
        flex: 1;
        min-width: 0
    }

    .sp-opt-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--text)
    }

    .sp-opt-desc {
        font-size: 12px;
        color: var(--text-3);
        margin-top: 1px
    }

    .sp-check {
        width: 18px;
        height: 18px;
        flex-shrink: 0;
        color: var(--accent2);
        opacity: 0;
        transition: opacity .15s
    }

    .sp-opt.sel .sp-check {
        opacity: 1
    }

    .sp-check svg {
        width: 16px;
        height: 16px;
        fill: none;
        stroke: currentColor;
        stroke-width: 2.4;
        stroke-linecap: round;
        stroke-linejoin: round
    }

    .sp-vol {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 2px
    }

    .sp-vol-ico {
        color: var(--text-3);
        display: flex
    }

        .sp-vol-ico svg {
            width: 15px;
            height: 15px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round
        }

    .sp-vol input[type=range] {
        -webkit-appearance: none;
        appearance: none;
        flex: 1;
        height: 4px;
        border-radius: 3px;
        background: var(--surface-3);
        outline: none;
        cursor: pointer
    }

        .sp-vol input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: var(--accent);
            cursor: pointer;
            box-shadow: 0 0 8px rgba(124,131,242,.7);
            border: 2px solid #0c1019
        }

    .sp-note {
        font-size: 11px;
        color: var(--text-4);
        margin-top: 10px;
        line-height: 1.5;
        border-top: 1px solid var(--line);
        padding-top: 9px
    }

    .clock {
        font-family: var(--mono);
        color: var(--text-2);
        font-size: 14px
    }

    .user-chip {
        gap: 9px
    }

    .user-avatar {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: linear-gradient(140deg,#34d399,#0d9488);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #06251c;
        font-size: 14px;
        font-weight: 700;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.3)
    }

    .user-name {
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
        line-height: 1.2
    }

    .user-role {
        font-size: 12px;
        color: var(--text-3)
    }

    .content {
        padding: 22px 24px;
        max-width: 1680px;
        margin: 0 auto
    }

    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        align-items: center;
        margin-bottom: 22px
    }

    .filter-group {
        display: flex;
        gap: 8px;
        align-items: center
    }

        .filter-group label {
            font-size: 13px;
            color: var(--text-3);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .05em
        }

    .filter-value {
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
        padding: 7px 13px;
        border-radius: 8px;
        background: linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.02)) padding-box,linear-gradient(180deg,rgba(255,255,255,.12),rgba(255,255,255,.03)) border-box;
        border: 1px solid transparent;
        -webkit-appearance: none;
        appearance: none;
        outline: none
    }

        .filter-value option {
            background: #121826;
            color: var(--text)
        }

    .btn-search {
        border: none;
        border-radius: 8px;
        padding: 8px 18px;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        background: linear-gradient(140deg,#8b91f7,#6366f1);
        color: #fff;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.3),0 4px 14px -4px rgba(99,102,241,.5);
        transition: transform .2s,box-shadow .2s;
        letter-spacing: .03em
    }

        .btn-search:hover {
            transform: translateY(-1px);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.4),0 8px 20px -4px rgba(99,102,241,.5)
        }

    .summary-cards {
        margin-left: auto;
        display: flex;
        gap: 11px
    }

    .summary-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        border-radius: 13px;
        padding: 12px 16px;
        min-width: 130px;
        overflow: hidden;
        background: linear-gradient(180deg,rgba(26,33,51,.85),rgba(16,21,33,.85)) padding-box,linear-gradient(180deg,rgba(255,255,255,.14),rgba(255,255,255,.03)) border-box;
        border: 1px solid transparent;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.05),0 10px 28px -18px rgba(0,0,0,.8);
        transition: transform .2s
    }

        .summary-card:hover {
            transform: translateY(-2px)
        }

        .summary-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 3px
        }

        .summary-card.failure::before {
            background: linear-gradient(180deg,var(--alert),transparent);
            box-shadow: 0 0 14px var(--alert-glow)
        }

        .summary-card.predictive::before {
            background: linear-gradient(180deg,var(--pred),transparent);
            box-shadow: 0 0 14px rgba(122,162,247,.5)
        }

        .summary-card.sc-active::before {
            background: linear-gradient(180deg,var(--ok),transparent);
            box-shadow: 0 0 14px var(--ok-glow)
        }

    .sc-meta {
        display: flex;
        flex-direction: column;
        flex: 1
    }

    .summary-card .num {
        font-size: 25px;
        font-weight: 730;
        font-variant-numeric: tabular-nums;
        letter-spacing: -.03em;
        line-height: 1
    }

    .summary-card.failure .num {
        color: #ffafbb
    }

    .summary-card.predictive .num {
        color: #a8c2fc
    }

    .summary-card.sc-active .num {
        color: #74e3bd
    }

    .summary-card .lbl {
        font-size: 11px;
        color: var(--text-3);
        letter-spacing: .04em;
        text-transform: uppercase;
        margin-top: 5px;
        font-weight: 600
    }

    @@media(max-width:620px) {
        .grid {
            grid-template-columns: 1fr
        }

        .summary-cards {
            margin-left: 0;
            width: 100%;
            flex-wrap: wrap
        }

        .topbar {
            flex-wrap: wrap;
            gap: 10px
        }

        .topbar-right {
            flex-wrap: wrap
        }
    }

    @@media(prefers-reduced-motion:reduce) {
        *, *::before, *::after {
            animation-duration: .001ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .001ms !important
        }
    }
</style>

<div class="bg-aura"></div><div class="bg-grain"></div><div class="bg-vignette"></div>

<div class="topbar">
    <div class="topbar-logo"><div class="icon">E7</div><div><div class="title">Remote Diagnostic &amp; Predictive Maintenance</div><div class="sub">RDPMS v4.2 · Network Operations Console</div></div></div>
    <div class="topbar-right">
        <div class="sound-ctl" id="sound-ctl"><div class="pill sound-toggle" id="sound-toggle">🔔 <span id="sound-label">Alarms</span><span class="caret">▾</span></div><div class="sound-pop" id="sound-pop"></div></div>
        <div class="pill clock" id="clock"></div>
        <div class="pill user-chip">
            <div class="user-avatar">@(E7FRSAdvance.Utility.ClsHttpContent.LoginUser.Name != null ? E7FRSAdvance.Utility.ClsHttpContent.LoginUser.Name.Substring(0,1).ToUpper() : "U")</div>
            <div><div class="user-name">@E7FRSAdvance.Utility.ClsHttpContent.LoginUser.Name</div><div class="user-role">@E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleName</div></div>
        </div>
    </div>
</div>

<div>
    @using (Ajax.BeginForm("SiteList", "UserSite", new AjaxOptions() { HttpMethod = "POST", UpdateTargetId = "divSiteList", InsertionMode = InsertionMode.Replace, LoadingElementId = "loader" }, new { id = "frmGetSiteList" }))
    {
        { HtmlHelper.ClientValidationEnabled = false; }
        @Html.HiddenFor(m => m.SearchCriteria.ColumnName, new { id = "hdnColumnName" })
        @Html.HiddenFor(m => m.SearchCriteria.SortDirection, new { id = "hdnSortDirection" })
        <div class="filter-bar">
            <div class="filter-group"><label>Zone</label>@Html.DropDownListFor(m => m.SearchCriteria.ZoneId, (IEnumerable<SelectListItem>)ViewBag.Zones, new { @class = "filter-value", id = "zoneAdd1", tabindex = 1 })</div>
            <div class="filter-group"><label>Division</label><input type="hidden" id="hdnSearchDivisionId" value="@Model.SearchCriteria.DivisionId" />@Html.DropDownListFor(m => m.SearchCriteria.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, new { @class = "filter-value", id = "divisions", tabindex = 1 })</div>
            <div class="filter-group"><button type="button" class="btn-search" onclick="Search()">Search</button></div>
            <div class="summary-cards" id="summary-cards"></div>
        </div>
        <div id="divSiteList">@Html.Action("SiteList", Model)</div>
    }
    <div id="divSetting"></div>
</div>

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script>

    var isSecure = window.location.protocol === 'https:';
    var APP_CONFIG = isSecure ? {
        ProxyBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["ProxyBaseUrlSSL"]',
        WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrlSSL"]',
        WebSocketAuthToken: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketAuthToken"]'
    } : {
        ProxyBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["ProxyBaseUrl"]',
        WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrl"]',
        WebSocketAuth: null
    };

    function updateClock() { document.getElementById('clock').textContent = new Date().toLocaleTimeString('en-IN', { hour12: false }); }
    updateClock(); setInterval(updateClock, 1000);

    // ===== Sound system =====
    var soundOn = true, audioCtx = null, masterGain = null, alarmVol = 0.72, currentAlarm = 'klaxon';
    function ensureCtx() { if (!audioCtx) { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); masterGain = audioCtx.createGain(); masterGain.gain.value = alarmVol; masterGain.connect(audioCtx.destination); } if (audioCtx.state === 'suspended') audioCtx.resume(); }
    function tone(type, freq, t, dur, peak, opts) { opts = opts || {}; var o = audioCtx.createOscillator(), g = audioCtx.createGain(); o.type = type; o.frequency.setValueAtTime(freq, t); if (opts.sweepTo) o.frequency.exponentialRampToValueAtTime(opts.sweepTo, t + (opts.sweepDur || dur)); var atk = opts.atk != null ? opts.atk : 0.006; g.gain.setValueAtTime(0.0001, t); g.gain.exponentialRampToValueAtTime(peak, t + atk); if (opts.hold) g.gain.setValueAtTime(peak, t + dur - 0.04); g.gain.exponentialRampToValueAtTime(0.0001, t + dur); if (opts.lp) { var lp = audioCtx.createBiquadFilter(); lp.type = 'lowpass'; lp.frequency.value = opts.lp; o.connect(lp); lp.connect(g); } else { o.connect(g); } g.connect(masterGain); o.start(t); o.stop(t + dur + 0.03); }
    var ALARMS = {
        klaxon: { name: 'Klaxon', desc: 'Two-tone alarm horn', fn: function (t) { var tn = [392, 294]; for (var i = 0; i < 6; i++) { tone('sawtooth', tn[i % 2], t, .30, .55, { hold: true }); tone('square', tn[i % 2] / 2, t, .30, .20, { hold: true }); t += .32; } } },
        siren: { name: 'Emergency Siren', desc: 'Rising / falling sweep', fn: function (t) { for (var i = 0; i < 3; i++) { tone('sawtooth', 440, t, .5, .5, { sweepTo: 920, sweepDur: .5, hold: true, lp: 2400 }); tone('sawtooth', 920, t + .5, .5, .5, { sweepTo: 440, sweepDur: .5, hold: true, lp: 2400 }); t += 1.0; } } },
        pulse: { name: 'Critical Beep', desc: 'Sharp repeating beeps', fn: function (t) { for (var i = 0; i < 8; i++) { tone('square', 1046, t, .10, .5, { hold: true }); t += .16; } } },
        sonar: { name: 'Sonar Ping', desc: 'Descending pings', fn: function (t) { for (var i = 0; i < 4; i++) { tone('sine', 1500, t, .5, .6, { sweepTo: 680 }); t += .55; } } },
        buzzer: { name: 'Buzzer', desc: 'Harsh dissonant buzz', fn: function (t) { for (var i = 0; i < 3; i++) { tone('sawtooth', 180, t, .42, .4, { hold: true }); tone('sawtooth', 187, t, .42, .4, { hold: true }); t += .55; } } },
        chime: { name: 'Soft Chime', desc: 'Gentle escalating tones', fn: function (t) { [659.25, 830.61, 987.77, 659.25].forEach(function (f, i) { tone('sine', f, t + i * .22, .42, .32); }); } }
    };
    function previewAlarm(id) { ensureCtx(); (ALARMS[id] || ALARMS.klaxon).fn(audioCtx.currentTime + 0.03); }
    function playAlarm(id) { if (!soundOn) return; ensureCtx(); (ALARMS[id] || ALARMS.klaxon).fn(audioCtx.currentTime + 0.03); }
    var _lastSoundTime = 0, SOUND_COOLDOWN = 10000;
    function playSoundCooldown() { var now = Date.now(); if (now - _lastSoundTime < SOUND_COOLDOWN) return; _lastSoundTime = now; playAlarm(currentAlarm); }
    function announceAlerts() { if (soundOn && document.querySelectorAll('.station-card.has-alert').length > 0) playSoundCooldown(); }

    // Sound popover
    (function () {
        var ctl = document.getElementById('sound-ctl'), toggle = document.getElementById('sound-toggle'), pop = document.getElementById('sound-pop'), label = document.getElementById('sound-label');
        var playSvg = '<svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>', checkSvg = '<svg viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></svg>', spkSvg = '<svg viewBox="0 0 24 24"><path d="M4 9v6h4l5 5V4L8 9H4z"/><path d="M16 8.5a4 4 0 010 7"/></svg>';
        var optsHtml = Object.keys(ALARMS).map(function (id) { return '<div class="sp-opt' + (id === currentAlarm ? ' sel' : '') + '" data-id="' + id + '"><button class="sp-play" data-play="' + id + '" title="Preview">' + playSvg + '</button><div class="sp-opt-meta"><div class="sp-opt-name">' + ALARMS[id].name + '</div><div class="sp-opt-desc">' + ALARMS[id].desc + '</div></div><span class="sp-check">' + checkSvg + '</span></div>'; }).join('');
        pop.innerHTML = '<div class="sp-head"><span class="sp-title">Alarm Sound</span><div class="sp-switch' + (soundOn ? ' on' : '') + '" id="sp-switch" role="switch"></div></div><div class="sp-list">' + optsHtml + '</div><div class="sp-vol"><span class="sp-vol-ico">' + spkSvg + '</span><input type="range" id="sp-vol" min="0" max="100" value="' + Math.round(alarmVol * 100) + '"></div><div class="sp-note">Sounds when any station alarm is active.</div>';
        function setLabel() { toggle.firstChild.textContent = (soundOn ? '\uD83D\uDD14 ' : '\uD83D\uDD15 '); label.textContent = soundOn ? 'Alarms' : 'Muted'; toggle.classList.toggle('muted', !soundOn); } setLabel();
        function openPop(o) { pop.classList.toggle('open', o); toggle.classList.toggle('open', o); }
        toggle.addEventListener('click', function (e) { e.stopPropagation(); ensureCtx(); openPop(!pop.classList.contains('open')); });
        document.addEventListener('click', function (e) { if (!ctl.contains(e.target)) openPop(false); });
        var sw = pop.querySelector('#sp-switch'); sw.addEventListener('click', function (e) { e.stopPropagation(); soundOn = !soundOn; sw.classList.toggle('on', soundOn); setLabel(); if (soundOn) previewAlarm(currentAlarm); });
        pop.querySelectorAll('.sp-opt').forEach(function (el) { el.addEventListener('click', function (e) { if (e.target.closest('.sp-play')) return; currentAlarm = el.dataset.id; pop.querySelectorAll('.sp-opt').forEach(function (x) { x.classList.toggle('sel', x === el); }); previewAlarm(currentAlarm); }); });
        pop.querySelectorAll('.sp-play').forEach(function (btn) { btn.addEventListener('click', function (e) { e.stopPropagation(); previewAlarm(btn.dataset.play); }); });
        var vol = pop.querySelector('#sp-vol'); vol.addEventListener('input', function () { alarmVol = (+vol.value) / 100; if (masterGain) masterGain.gain.value = alarmVol; }); vol.addEventListener('change', function () { previewAlarm(currentAlarm); });
    })();
    var firstGesture = false; window.addEventListener('click', function () { if (!firstGesture) { firstGesture = true; ensureCtx(); } }, { once: true });

    // ===== WebSocket =====
    var WS_URL = window.APP_CONFIG.WebSocketBaseUrl + '/subscribe/alertEvents';
    if (isSecure && APP_CONFIG.WebSocketAuthToken) {
        WS_URL += (WS_URL.indexOf('?') > -1 ? '&' : '?') + 'token=' + encodeURIComponent(APP_CONFIG.WebSocketAuthToken);
    }
    ws = null, wsReconnectDelay = 3000, wsReconnectTimer = null;
    window.wsAlertStore = {};
    function wsConnect() {
        if (ws && (ws.readyState === WebSocket.OPEN || ws.readyState === WebSocket.CONNECTING)) return; try {
            ws = new WebSocket(WS_URL);
            ws.onopen = function () { wsReconnectDelay = 3000; };
            ws.onmessage = function (event) {
                try
                {

                    var batch = JSON.parse(event.data); if (batch.MessageType === 'Batch' && batch.Messages)
                        for (var i = 0; i < batch.Messages.length; i++) {

                            handleWsAlert(JSON.parse(batch.Messages[i]));
                        }
                } catch (e) { }
            }; ws.onclose = function (ex)
            {
                scheduleReconnect();
            };
            ws.onerror = function (ex)
            {
                ws.close();
            };
        } catch (e) { scheduleReconnect(); }
    }
    function scheduleReconnect() { clearTimeout(wsReconnectTimer); wsReconnectTimer = setTimeout(function () { wsConnect(); wsReconnectDelay = Math.min(wsReconnectDelay * 1.5, 30000); }, wsReconnectDelay); }
    function handleWsAlert(alert) {
        console.log(alert);
        if (!alert || !alert.SiteId) return; var siteId = alert.SiteId; if (!window.wsAlertStore[siteId]) window.wsAlertStore[siteId] = [];
        if (alert.AlertAction === 'SET') {
            var mergedMsg = (alert.AlertType || 'Alert') + ' Alert: ' + (alert.AssetName || '');
            if (alert.CauseCode) mergedMsg += ', "' + alert.CauseCode + '"';
            if (alert.Evaluation && alert.Evaluation.TriggeringAttribute)
            {
                var ta = alert.Evaluation.TriggeringAttribute; mergedMsg += ', ' + (ta.AttrName || '') + '=' + (ta.Value != null ? parseFloat(ta.Value).toFixed(2) : '') + (ta.Threshold != null ? ' (Thr:' + parseFloat(ta.Threshold).toFixed(2) + ', ' + (ta.Comparison || '') + ')' : '');
            }
            window.wsAlertStore[siteId].unshift({ AssetId: alert.AssetId || 0, AssetName: alert.AssetName || '', AlertType: alert.AlertType || 'Predictive', CauseCode: alert.CauseCode || '', Message: mergedMsg, Time: alert.Time || '', TimestampDevice: alert.TimestampDevice || '', AlertAction: 'SET', Status: 'Active' }); if (window.wsAlertStore[siteId].length > 10) window.wsAlertStore[siteId] = window.wsAlertStore[siteId].slice(0, 10);
            if (typeof setCardAlert === 'function')
            {
                var $c = $('#divSite_' + siteId); if ($c.length > 0 && !$c.hasClass('has-alert')) setCardAlert(siteId, true);
            }
            if (typeof renderNowSlide === 'function')
                renderNowSlide(siteId); if (soundOn) playSoundCooldown();
            if (typeof updateSummaryCards === 'function')
                updateSummaryCards();
        } else if (alert.AlertAction === 'RESET') {
            var store = window.wsAlertStore[siteId]; for (var j = 0; j < store.length; j++) { if (store[j].AssetName === alert.AssetName && store[j].Status === 'Active') { store[j].Status = 'Cleared'; store[j].AlertAction = 'RESET'; break; } }
            var hasActive = store.some(function (a) { return a.Status === 'Active'; }); if (!hasActive && typeof setCardAlert === 'function') setCardAlert(siteId, false);
            if (typeof renderNowSlide === 'function') renderNowSlide(siteId); if (typeof updateSummaryCards === 'function') updateSummaryCards();
        }
    }

    // ===== Init =====
    function Search() {
        $('#frmGetSiteList').submit();
    }
    function GetDivisionByZone(zoneId) { if (!zoneId) return; $.ajax({ url: '/FRS25/UserSite/GetDivisionByZoneId', type: 'POST', data: '{zoneId:' + zoneId + '}', contentType: 'application/json', success: function (data) { $('#divisions').empty().append($('<option>').val('0').html('Select Division')); $.each(data, function (k, v) { var sel = $('#hdnSearchDivisionId').val() == v.Id ? ' selected' : ''; $('#divisions').append($('<option' + sel + '>').val(v.Id).html(v.Name)); }); } }); }
    $(document).ready(function () { wsConnect(); GetDivisionByZone($('#zoneAdd1').val()); $('#zoneAdd1').change(function () { GetDivisionByZone($(this).val()); }); setInterval(announceAlerts, 30000); });
</script>
