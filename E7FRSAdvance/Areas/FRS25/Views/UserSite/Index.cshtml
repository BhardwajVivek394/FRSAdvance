@model Domain.SiteLister

@{
    ViewBag.Title = "Siren Command";
}

<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<style>
    /* ============================================
       SIREN COMMAND — DARK INDUSTRIAL THEME
       ============================================ */
    :root {
        --sc-bg-deep: #060a14;
        --sc-bg-card: #0c1222;
        --sc-bg-surface: #111a2e;
        --sc-border: rgba(255,255,255,0.06);
        --sc-border-alert: rgba(239,68,68,0.2);
        --sc-red: #ef4444;
        --sc-red-dim: rgba(239,68,68,0.12);
        --sc-red-glow: rgba(239,68,68,0.35);
        --sc-green: #22c55e;
        --sc-green-dim: rgba(34,197,94,0.12);
        --sc-green-glow: rgba(34,197,94,0.35);
        --sc-amber: #f59e0b;
        --sc-amber-dim: rgba(245,158,11,0.12);
        --sc-text: #e2e8f0;
        --sc-text-dim: #64748b;
        --sc-text-muted: #475569;
        --sc-font-mono: 'IBM Plex Mono', 'Courier New', monospace;
        --sc-font-body: 'DM Sans', system-ui, sans-serif;
    }

    .sc-page {
        font-family: var(--sc-font-body);
        background: linear-gradient(165deg, var(--sc-bg-deep) 0%, #0d1425 40%, #111827 100%);
        min-height: 100vh;
        color: var(--sc-text);
        position: relative;
    }

        .sc-page::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            pointer-events: none;
            z-index: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
        }

        .sc-page > * {
            position: relative;
            z-index: 1;
        }

    /* --- HEADER --- */
    .sc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 24px;
        border-bottom: 1px solid var(--sc-border-alert);
        background: rgba(10,14,26,0.75);
        backdrop-filter: blur(14px);
        flex-wrap: wrap;
        gap: 12px;
    }

    .sc-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .sc-logo-mark {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: var(--sc-red-dim);
        border: 1px solid rgba(239,68,68,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sc-header-title {
        margin: 0;
        font-size: 15px;
        font-weight: 800;
        letter-spacing: 2px;
        color: #f8fafc;
        font-family: var(--sc-font-mono);
    }

    .sc-header-sub {
        margin: 0;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.8px;
        color: var(--sc-text-dim);
        text-transform: uppercase;
    }

    .sc-header-right {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .sc-stat-chip {
        display: flex;
        align-items: center;
        gap: 7px;
        background: rgba(255,255,255,0.035);
        border: 1px solid var(--sc-border);
        border-radius: 8px;
        padding: 6px 14px;
        font-family: var(--sc-font-mono);
        font-size: 12px;
        font-weight: 600;
        color: #94a3b8;
    }

    .sc-dot-live {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        background: var(--sc-red);
        box-shadow: 0 0 8px var(--sc-red-glow);
        animation: sc-pulse 1.5s infinite;
    }

    .sc-dot-safe {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        display: inline-block;
        background: var(--sc-green);
        box-shadow: 0 0 8px rgba(34,197,94,0.5);
    }

    @@keyframes sc-pulse {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.5;
            transform: scale(1.3);
        }
    }

    @@keyframes sc-glow-breathe-red {
        0%, 100% {
            box-shadow: 0 0 30px rgba(239,68,68,0.15);
        }

        50% {
            box-shadow: 0 0 60px rgba(239,68,68,0.4);
        }
    }

    @@keyframes sc-glow-breathe-green {
        0%, 100% {
            box-shadow: 0 0 20px rgba(34,197,94,0.1);
        }

        50% {
            box-shadow: 0 0 40px rgba(34,197,94,0.25);
        }
    }

    @@keyframes sc-fade-up {
        from {
            transform: translateY(12px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    /* --- FILTER BAR --- */
    .sc-filter-bar {
        display: flex;
        gap: 12px;
        align-items: flex-end;
        flex-wrap: wrap;
        padding: 14px 24px;
        background: rgba(15,23,42,0.4);
        border-bottom: 1px solid var(--sc-border);
    }

        .sc-filter-bar label {
            font-size: 10px;
            font-weight: 700;
            color: var(--sc-text-dim);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 3px;
            display: block;
        }

        .sc-filter-bar select, .sc-filter-bar .form-control {
            background: rgba(15,23,41,0.7) !important;
            border: 1px solid rgba(99,179,237,0.2) !important;
            color: #e6edf6 !important;
            border-radius: 8px;
            height: 38px;
            font-size: 13px;
            min-width: 180px;
            padding: 0 12px;
        }

            .sc-filter-bar select:focus, .sc-filter-bar .form-control:focus {
                border-color: var(--sc-red) !important;
                box-shadow: 0 0 0 3px rgba(239,68,68,0.12) !important;
                outline: none;
            }

        .sc-filter-bar .btn-search {
            height: 38px;
            padding: 0 22px;
            border-radius: 8px;
            border: none;
            background: linear-gradient(135deg, var(--sc-red), #dc2626);
            color: #fff;
            font-weight: 700;
            font-size: 12px;
            letter-spacing: 0.5px;
            cursor: pointer;
            transition: all 0.2s;
        }

            .sc-filter-bar .btn-search:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 20px rgba(239,68,68,0.35);
            }

    /* --- SIREN STAGE --- */
    .sc-siren-stage {
        padding: 40px 20px 24px;
        text-align: center;
        position: relative;
        min-height: 280px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        transition: background 0.5s;
    }

        .sc-siren-stage.sc-bg-alert {
            background: radial-gradient(ellipse at 50% 20%, rgba(239,68,68,0.06) 0%, transparent 65%);
        }

        .sc-siren-stage.sc-bg-safe {
            background: radial-gradient(ellipse at 50% 20%, rgba(34,197,94,0.04) 0%, transparent 65%);
        }

    /* Nav arrows */
    .sc-nav-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 5;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        color: #94a3b8;
        cursor: pointer;
        font-size: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s;
        backdrop-filter: blur(6px);
    }

        .sc-nav-arrow:hover {
            background: rgba(239,68,68,0.12);
            border-color: rgba(239,68,68,0.3);
            color: #fca5a5;
        }

        .sc-nav-arrow.sc-left {
            left: 16px;
        }

        .sc-nav-arrow.sc-right {
            right: 16px;
        }

        .sc-nav-arrow:disabled {
            opacity: 0.2;
            cursor: default;
            pointer-events: none;
        }

    /* Siren image wrapper */
    .sc-siren-display {
        margin: 0 auto;
        border-radius: 50%;
        transition: opacity 0.3s;
    }

        .sc-siren-display img {
            height: 130px;
            width: 130px;
            transition: transform 0.15s;
        }

        .sc-siren-display.sc-alert-glow {
            animation: sc-glow-breathe-red 2s infinite;
            cursor: pointer;
        }

        .sc-siren-display.sc-safe-glow {
            animation: sc-glow-breathe-green 3s infinite;
        }

        .sc-siren-display.sc-alert-glow img:hover {
            transform: scale(1.06);
        }

    /* Site name */
    .sc-site-name {
        margin: 10px 0 4px;
        font-size: 22px;
        font-weight: 800;
        letter-spacing: 0.3px;
        color: #f8fafc;
    }

        .sc-site-name.sc-name-alert {
            text-shadow: 0 0 24px rgba(239,68,68,0.3);
        }

        .sc-site-name.sc-name-safe {
            text-shadow: 0 0 16px rgba(34,197,94,0.2);
        }

    /* Status tag under name */
    .sc-status-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-family: var(--sc-font-mono);
        font-size: 11px;
        font-weight: 700;
        padding: 4px 14px;
        border-radius: 20px;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

        .sc-status-tag.sc-tag-alert {
            background: var(--sc-red-dim);
            border: 1px solid rgba(239,68,68,0.35);
            color: #fca5a5;
        }

        .sc-status-tag.sc-tag-safe {
            background: var(--sc-green-dim);
            border: 1px solid rgba(34,197,94,0.3);
            color: #6ee7b7;
        }

    /* Asset badges */
    .sc-asset-badges {
        display: flex;
        gap: 8px;
        justify-content: center;
        margin-top: 6px;
    }

    .sc-asset-badge {
        font-family: var(--sc-font-mono);
        font-size: 11px;
        font-weight: 700;
        padding: 3px 11px;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.15s;
    }

        .sc-asset-badge.sc-badge-red {
            background: var(--sc-red-dim);
            border: 1px solid rgba(239,68,68,0.3);
            color: #fca5a5;
        }

        .sc-asset-badge.sc-badge-green {
            background: var(--sc-green-dim);
            border: 1px solid rgba(34,197,94,0.25);
            color: #6ee7b7;
        }

        .sc-asset-badge:hover {
            transform: translateY(-1px);
        }

    /* Dot indicators */
    .sc-dots {
        display: flex;
        gap: 8px;
        justify-content: center;
        margin-top: 18px;
        flex-wrap: wrap;
    }

    .sc-dot-ind {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.18);
        cursor: pointer;
        transition: all 0.2s;
        padding: 0;
    }

        .sc-dot-ind.active-red {
            background: var(--sc-red);
            border-color: var(--sc-red);
            box-shadow: 0 0 10px var(--sc-red-glow);
            transform: scale(1.25);
        }

        .sc-dot-ind.active-green {
            background: var(--sc-green);
            border-color: var(--sc-green);
            box-shadow: 0 0 10px var(--sc-green-glow);
            transform: scale(1.25);
        }

        .sc-dot-ind.has-alert {
            background: rgba(239,68,68,0.4);
            border-color: rgba(239,68,68,0.5);
        }

    /* Site name strip */
    .sc-site-strip {
        display: flex;
        gap: 18px;
        justify-content: center;
        margin-top: 10px;
        flex-wrap: wrap;
    }

    .sc-strip-item {
        font-family: var(--sc-font-mono);
        font-size: 11px;
        font-weight: 500;
        color: var(--sc-text-muted);
        cursor: pointer;
        transition: all 0.2s;
        padding: 2px 0;
        border: none;
        background: none;
    }

        .sc-strip-item.active {
            font-weight: 700;
        }

        .sc-strip-item.active-red {
            color: #fca5a5;
        }

        .sc-strip-item.active-green {
            color: #6ee7b7;
        }

        .sc-strip-item:hover {
            color: #94a3b8;
        }

    /* Site action buttons */
    .sc-site-actions {
        display: flex;
        gap: 10px;
        justify-content: center;
        margin-top: 14px;
        flex-wrap: wrap;
    }

        .sc-site-actions .btn {
            font-family: var(--sc-font-mono);
            font-size: 11px;
            font-weight: 600;
            padding: 7px 18px;
            border-radius: 8px;
            border: 1px solid var(--sc-border);
            background: rgba(255,255,255,0.035);
            color: #94a3b8;
            cursor: pointer;
            transition: all 0.15s;
            text-decoration: none;
        }

            .sc-site-actions .btn:hover {
                background: rgba(255,255,255,0.07);
                color: #e2e8f0;
                transform: translateY(-1px);
            }

    /* --- ALERT PANEL --- */
    .sc-alert-panel {
        margin: 0 20px 24px;
        border-radius: 16px;
        background: rgba(15,23,42,0.55);
        border: 1px solid var(--sc-border-alert);
        backdrop-filter: blur(8px);
        overflow: hidden;
    }

    .sc-alert-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        padding: 14px 22px;
        border-bottom: 1px solid var(--sc-border);
        background: linear-gradient(135deg, rgba(239,68,68,0.05) 0%, rgba(251,191,36,0.03) 100%);
    }

    .sc-alert-panel-title {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        color: #f8fafc;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sc-alert-count-badge {
        font-family: var(--sc-font-mono);
        font-size: 11px;
        font-weight: 700;
        padding: 4px 13px;
        border-radius: 20px;
        background: var(--sc-red-dim);
        color: #fca5a5;
    }

    .sc-alert-list {
        padding: 14px 18px;
        max-height: 450px;
        overflow-y: auto;
    }

        .sc-alert-list::-webkit-scrollbar {
            width: 6px;
        }

        .sc-alert-list::-webkit-scrollbar-track {
            background: rgba(255,255,255,0.02);
            border-radius: 3px;
        }

        .sc-alert-list::-webkit-scrollbar-thumb {
            background: rgba(239,68,68,0.2);
            border-radius: 3px;
        }

    .sc-no-alerts-panel {
        text-align: center;
        padding: 36px 20px;
        color: var(--sc-text-muted);
        font-size: 13px;
    }

        .sc-no-alerts-panel i {
            font-size: 28px;
            color: var(--sc-green);
            margin-bottom: 10px;
            display: block;
        }

    /* Alert card */
    .sc-alert-card {
        background: rgba(255,255,255,0.018);
        border: 1px solid var(--sc-border);
        border-radius: 12px;
        margin-bottom: 12px;
        overflow: hidden;
        transition: border-color 0.2s;
        animation: sc-fade-up 0.35s ease-out both;
    }

        .sc-alert-card:hover {
            border-color: rgba(239,68,68,0.25);
        }

    .sc-alert-card-top {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding: 10px 14px;
        border-bottom: 1px solid rgba(255,255,255,0.03);
        background: rgba(255,255,255,0.012);
    }

    .sc-badge-type {
        font-family: var(--sc-font-mono);
        font-size: 10px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 6px;
        border: 1px solid;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

        .sc-badge-type.failure {
            background: rgba(239,68,68,0.15);
            border-color: rgba(239,68,68,0.4);
            color: #fca5a5;
        }

        .sc-badge-type.predictive {
            background: var(--sc-amber-dim);
            border-color: rgba(245,158,11,0.35);
            color: #fcd34d;
        }

    .sc-badge-cause {
        font-family: var(--sc-font-mono);
        font-size: 10px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 6px;
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.03);
        color: #94a3b8;
    }

    .sc-alert-time {
        font-family: var(--sc-font-mono);
        font-size: 11px;
        color: var(--sc-text-dim);
        margin-left: auto;
        white-space: nowrap;
    }

    .sc-alert-card-body {
        display: flex;
        gap: 18px;
        padding: 10px 14px;
        flex-wrap: wrap;
    }

    .sc-alert-field {
        flex: 1 1 0;
        min-width: 100px;
    }

    .sc-alert-field-label {
        display: block;
        font-size: 9px;
        font-weight: 700;
        color: var(--sc-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 2px;
        font-family: var(--sc-font-mono);
    }

    .sc-alert-field-value {
        font-size: 12px;
        font-weight: 500;
        color: #cbd5e1;
    }

    .sc-alert-card-actions {
        display: flex;
        gap: 8px;
        padding: 8px 14px 12px;
    }

    .sc-btn-realtime {
        font-family: var(--sc-font-mono);
        font-size: 11px;
        font-weight: 600;
        padding: 6px 16px;
        border-radius: 7px;
        cursor: pointer;
        transition: all 0.15s;
        background: var(--sc-red-dim);
        border: 1px solid rgba(239,68,68,0.3);
        color: #fca5a5;
    }

        .sc-btn-realtime:hover {
            background: rgba(239,68,68,0.22);
            transform: translateY(-1px);
        }

    .sc-btn-secondary {
        font-family: var(--sc-font-mono);
        font-size: 11px;
        font-weight: 600;
        padding: 6px 16px;
        border-radius: 7px;
        cursor: pointer;
        transition: all 0.15s;
        background: rgba(255,255,255,0.035);
        border: 1px solid var(--sc-border);
        color: #94a3b8;
    }

        .sc-btn-secondary:hover {
            background: rgba(255,255,255,0.07);
        }

    /* --- Slide counter (e.g. 2 / 6) --- */
    .sc-slide-counter {
        font-family: var(--sc-font-mono);
        font-size: 12px;
        font-weight: 600;
        color: var(--sc-text-dim);
        margin-top: 8px;
    }

        .sc-slide-counter .sc-current-num {
            color: #f8fafc;
            font-size: 16px;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .sc-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .sc-siren-stage {
            padding: 28px 54px 20px;
        }

        .sc-nav-arrow {
            width: 38px;
            height: 38px;
        }

            .sc-nav-arrow.sc-left {
                left: 6px;
            }

            .sc-nav-arrow.sc-right {
                right: 6px;
            }

        .sc-alert-panel {
            margin: 0 10px 16px;
        }

        .sc-site-name {
            font-size: 18px;
        }
    }
</style>

<script src="~/assets/js/paho-mqtt.js"></script>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<audio id="alarm-ring">
    <source src="~/Content/Audio/soundAlert.wav" />
</audio>

<div class="sc-page">

    <!-- ============ HEADER ============ -->
    <header class="sc-header">
        <div class="sc-header-left">
            <div class="sc-logo-mark">
                <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
                    <circle cx="11" cy="11" r="9" stroke="#ef4444" stroke-width="2" />
                    <circle cx="11" cy="11" r="4" fill="#ef4444">
                        <animate attributeName="r" values="3;5;3" dur="2s" repeatCount="indefinite" />
                    </circle>
                </svg>
            </div>
            <div>
                <h1 class="sc-header-title">SIREN COMMAND</h1>
                <p class="sc-header-sub">Real-time Alert Monitoring</p>
            </div>
        </div>
        <div class="sc-header-right">
            <div class="sc-stat-chip">
                <span class="sc-dot-safe" id="spnHeaderDot"></span>
                <span id="spnAlertSiteCount">0 Active Sites</span>
            </div>
            <div class="sc-stat-chip">
                <span id="spnTotalAlertCount" style="color:#fca5a5;">0 Alerts</span>
            </div>
            <div class="sc-stat-chip">
                <span id="spnTotalSiteCount" style="color:#6ee7b7;">0 Total Sites</span>
            </div>
        </div>
    </header>

    <!-- ============ FILTER BAR ============ -->
    @using (Ajax.BeginForm("SiteList", "UserSite", new AjaxOptions()
    {
        HttpMethod = "POST",
        UpdateTargetId = "divSiteList",
        InsertionMode = InsertionMode.Replace,
        LoadingElementId = "loader",
    }, new { id = "frmGetSiteList" }))
    {
        { HtmlHelper.ClientValidationEnabled = false; }

        <div class="sc-filter-bar">
            <div>
                <label>Zone</label>
                @Html.DropDownListFor(m => m.SearchCriteria.ZoneId,
                         (IEnumerable<SelectListItem>)ViewBag.Zones,
                         new { @class = "form-control", id = "zoneAdd1", tabindex = 1 })
            </div>
            <div>
                <label>Division</label>
                <input type="hidden" id="hdnSearchDivisionId" value="@Model.SearchCriteria.DivisionId" />
                @Html.DropDownListFor(m => m.SearchCriteria.DivisionId,
                         (IEnumerable<SelectListItem>)ViewBag.Divisions,
                         new { @class = "form-control", id = "divisions", tabindex = 1 })
            </div>
            <div>
                <label>&nbsp;</label>
                <button class="btn-search" type="button" onclick="Search()">Search</button>
            </div>
        </div>

        @Html.HiddenFor(m => m.SearchCriteria.ColumnName, new { id = "hdnColumnName" })
        @Html.HiddenFor(m => m.SearchCriteria.SortDirection, new { id = "hdnSortDirection" })
    }

    <!-- ============ SIREN STAGE (partial renders here) ============ -->
    <div id="divSiteList">
        @Html.Action("SiteList", Model)
    </div>

    <!-- ============ MODALS & HIDDEN SECTIONS ============ -->
    <div id="divSMSLogLister">
        @Html.Partial("_SMSLogLister", new Domain.SMSLogLister())
    </div>
    <div id="divSummaryView"></div>
    <div id="divPerformanceList"></div>
    <div id="divLoadAnalysis">
        @Html.Partial("_Analysis", new List<Domain.AnalyticsLog>())
    </div>
    <div id="divAssetAttributePartial"></div>

</div>

<script>
    function fnGetAssetAttribute(siteName, assetId, assetTypeId) {
        $("#loader").show();
        $.ajax({
            url: '/AssetAttribute/_AssetAttributePartial',
            type: 'Post',
            data: '{siteName:"' + siteName + '",assetId:' + assetId + ',assetTypeId:' + assetTypeId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAssetAttributePartial").empty().append(data);
                $("#modal-assetLister").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("danger", "Something went wrong!");
            }
        });
    }

    function Search() { $("#frmGetSiteList").submit(); }

    function GetDivisionByZone(zoneId) {
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRS25/UserSite/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#divisions").empty();
                    $("#divisions").append($("<option></option>").val('0').html('Select Division'));
                    $.each(data, function (key, value) {
                        if ($('#hdnSearchDivisionId').val() != '0' && $('#hdnSearchDivisionId').val() == value.Id) {
                            $("#divisions").append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $("#divisions").append($("<option></option>").val(value.Id).html(value.Name));
                        }
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }

    $(document).ready(function () {
        GetDivisionByZone($("#zoneAdd1").val());
        $("#zoneAdd1").change(function () { GetDivisionByZone($(this).val()); });
    });
</script>
