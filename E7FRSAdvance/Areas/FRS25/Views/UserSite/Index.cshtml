@model Domain.SiteLister

@{
    ViewBag.Title = "RDPMS — Station Board";
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    :root {
        --glass: rgba(255,255,255,.07);
        --glass-strong: rgba(255,255,255,.12);
        --glass-border: rgba(255,255,255,.18);
        --glass-border-soft: rgba(255,255,255,.10);
        --txt: #f1f5f9;
        --txt-dim: #aeb9cc;
        --txt-faint: #7e8aa3;
        --blur: 22px;
    }

    html, body {
        min-height: 100%;
    }

    body {
        font-family: 'Inter', system-ui, sans-serif;
        color: var(--txt);
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
        background: linear-gradient(135deg, #0b1024 0%, #121a38 45%, #0a1530 100%);
    }

    /* floating ambient colour blobs */
    .bg-aura {
        position: fixed;
        inset: 0;
        z-index: -2;
        overflow: hidden;
        pointer-events: none;
    }

        .bg-aura span {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: .45;
            animation: drift 22s ease-in-out infinite;
        }

        .bg-aura .a1 {
            width: 520px;
            height: 520px;
            background: #4f46e5;
            top: -140px;
            left: -90px;
        }

        .bg-aura .a2 {
            width: 560px;
            height: 560px;
            background: #0891b2;
            top: 42%;
            right: -160px;
            animation-delay: -6s;
        }

        .bg-aura .a3 {
            width: 440px;
            height: 440px;
            background: #7c3aed;
            bottom: -180px;
            left: 28%;
            animation-delay: -11s;
        }

        .bg-aura .a4 {
            width: 320px;
            height: 320px;
            background: #0ea5e9;
            top: 8%;
            left: 56%;
            opacity: .25;
            animation-delay: -3s;
        }

    @@keyframes drift {
        0%, 100% {
            transform: translate(0,0) scale(1);
        }

        33% {
            transform: translate(50px,34px) scale(1.1);
        }

        66% {
            transform: translate(-36px,24px) scale(.93);
        }
    }

    .bg-grain {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        opacity: .04;
        background-image: radial-gradient(rgba(255,255,255,.6) 1px, transparent 1px);
        background-size: 3px 3px;
    }

    .bg-vignette {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background: radial-gradient(130% 100% at 50% 0%, transparent 55%, rgba(3,7,18,.55) 100%);
    }

    ::-webkit-scrollbar {
        width: 6px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,.18);
        border-radius: 3px;
    }

    .glass {
        background: var(--glass);
        backdrop-filter: blur(var(--blur)) saturate(160%);
        -webkit-backdrop-filter: blur(var(--blur)) saturate(160%);
        border: 1px solid var(--glass-border-soft);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.22), inset 0 -1px 1px rgba(0,0,0,.2), 0 10px 30px rgba(0,0,0,.35);
    }

    /* ===== Animations ===== */
    @@keyframes blink {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .25;
        }
    }

    @@keyframes pulse-text {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .5;
        }
    }

    @@keyframes board-shake {
        0%, 100% {
            transform: translateX(0) rotate(0);
        }

        20% {
            transform: translateX(-2px) rotate(-.4deg);
        }

        40% {
            transform: translateX(2px) rotate(.4deg);
        }

        60% {
            transform: translateX(-1px) rotate(-.2deg);
        }

        80% {
            transform: translateX(1px) rotate(.2deg);
        }
    }

    @@keyframes flag-wave {
        0%, 100% {
            transform: rotate(-3deg);
        }

        50% {
            transform: rotate(4deg);
        }
    }

    @@keyframes tech-bob {
        0%, 100% {
            transform: translateY(0) rotate(0);
        }

        50% {
            transform: translateY(1px) rotate(-1.2deg);
        }
    }

    @@keyframes tech-bob-alert {
        0%, 100% {
            transform: translateY(0) rotate(0);
        }

        25% {
            transform: translateY(-1px) rotate(1deg);
        }

        75% {
            transform: translateY(1px) rotate(-1.5deg);
        }
    }

    @@keyframes work-arm {
        0%, 100% {
            transform: rotate(0);
        }

        50% {
            transform: rotate(7deg);
        }
    }

    @@keyframes work-arm-alert {
        0%, 100% {
            transform: rotate(0);
        }

        30% {
            transform: rotate(-9deg);
        }

        60% {
            transform: rotate(5deg);
        }
    }

    @@keyframes flag-raise {
        0%, 100% {
            transform: rotate(-4deg) translateY(0);
        }

        50% {
            transform: rotate(6deg) translateY(-1.5px);
        }
    }

    @@keyframes spark {
        0% {
            opacity: 0;
            transform: scale(.4);
        }

        40% {
            opacity: 1;
            transform: scale(1);
        }

        100% {
            opacity: 0;
            transform: scale(1.5);
        }
    }

    @@keyframes card-in {
        0% {
            opacity: 0;
            transform: translateY(22px) scale(.97);
        }

        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @@keyframes sheen-sweep {
        0% {
            transform: translateX(-120%) skewX(-18deg);
        }

        100% {
            transform: translateX(220%) skewX(-18deg);
        }
    }

    @@keyframes glow-red {
        0%, 100% {
            box-shadow: inset 0 1px 0 rgba(255,255,255,.22),0 0 18px rgba(239,68,68,.22),0 10px 30px rgba(0,0,0,.35);
        }

        50% {
            box-shadow: inset 0 1px 0 rgba(255,255,255,.22),0 0 40px rgba(239,68,68,.5),0 10px 30px rgba(0,0,0,.35);
        }
    }

    @@keyframes bar-shimmer {
        0% {
            background-position: -200% 0;
        }

        100% {
            background-position: 200% 0;
        }
    }

    @@keyframes rail-move {
        0% {
            background-position: 0 0;
        }

        100% {
            background-position: 40px 0;
        }
    }

    @@keyframes wave-move {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    @@keyframes shine-drift {
        0%, 100% {
            transform: translateX(0);
        }

        50% {
            transform: translateX(160%);
        }
    }

    @@keyframes ring {
        0% {
            transform: scale(.6);
            opacity: .9;
        }

        100% {
            transform: scale(1.6);
            opacity: 0;
        }
    }

    /* ===== Top Bar ===== */
    .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 24px;
        margin: 14px 18px 0;
        border-radius: 18px;
        background: var(--glass);
        backdrop-filter: blur(var(--blur)) saturate(160%);
        -webkit-backdrop-filter: blur(var(--blur)) saturate(160%);
        border: 1px solid var(--glass-border-soft);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.25), 0 8px 24px rgba(0,0,0,.3);
        position: sticky;
        top: 14px;
        z-index: 50;
    }

    .topbar-logo {
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .topbar-logo .icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg,rgba(129,140,248,.9),rgba(99,102,241,.8));
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 800;
            color: #fff;
            box-shadow: inset 0 1px 0 rgba(255,255,255,.5),0 4px 12px rgba(99,102,241,.4);
        }

        .topbar-logo .title {
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            letter-spacing: .3px;
        }

        .topbar-logo .sub {
            font-size: 10px;
            color: var(--txt-dim);
        }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .pill {
        display: flex;
        align-items: center;
        gap: 7px;
        border-radius: 12px;
        padding: 7px 13px;
        font-size: 11px;
        font-weight: 600;
        background: var(--glass);
        border: 1px solid var(--glass-border);
        backdrop-filter: blur(10px);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.2);
    }

    .sound-toggle {
        cursor: pointer;
        color: #fde68a;
        transition: .2s;
    }

        .sound-toggle:hover {
            background: var(--glass-strong);
        }

        .sound-toggle.muted {
            color: var(--txt-faint);
        }

    .clock {
        font-family: monospace;
        color: #dbe4ff;
    }

    .pill-settings {
        cursor: pointer;
        color: var(--txt-dim);
        transition: .2s;
    }

        .pill-settings:hover {
            background: var(--glass-strong);
            color: #fff;
        }

    .user-chip {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .user-avatar {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: linear-gradient(135deg,#34d399,#059669);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.4);
    }

    .user-name {
        font-size: 11px;
        font-weight: 600;
        color: var(--txt);
    }

    .user-role {
        font-size: 9px;
        color: var(--txt-faint);
    }

    .content {
        padding: 18px;
    }

    /* ===== Filters ===== */
    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        align-items: center;
        margin-bottom: 20px;
        padding: 12px 16px;
        border-radius: 16px;
        background: var(--glass);
        backdrop-filter: blur(var(--blur)) saturate(160%);
        -webkit-backdrop-filter: blur(var(--blur)) saturate(160%);
        border: 1px solid var(--glass-border-soft);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.18),0 8px 24px rgba(0,0,0,.25);
    }

    .filter-group {
        display: flex;
        gap: 10px;
        align-items: center;
    }

        .filter-group label {
            font-size: 11px;
            color: var(--txt-dim);
            font-weight: 600;
        }

    .filter-value {
        background: var(--glass);
        border: 1px solid var(--glass-border);
        border-radius: 10px;
        padding: 7px 14px;
        color: #dbe4ff;
        font-size: 12px;
        font-weight: 600;
        min-width: 140px;
        backdrop-filter: blur(8px);
        -webkit-appearance: none;
        appearance: none;
        outline: none;
    }

        .filter-value option {
            background: #121a38;
            color: #dbe4ff;
        }

    .btn-search {
        border: none;
        border-radius: 10px;
        padding: 8px 20px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        background: linear-gradient(135deg, rgba(129,140,248,.7), rgba(99,102,241,.6));
        color: #fff;
        backdrop-filter: blur(8px);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 4px 12px rgba(99,102,241,.3);
        transition: transform .2s, box-shadow .2s;
        letter-spacing: .5px;
    }

        .btn-search:hover {
            transform: translateY(-1px);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.4), 0 8px 20px rgba(99,102,241,.4);
        }

    .summary-cards {
        margin-left: auto;
        display: flex;
        gap: 12px;
    }

    .summary-card {
        border-radius: 14px;
        padding: 10px 18px;
        text-align: center;
        min-width: 100px;
        backdrop-filter: blur(12px);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.18);
        transition: transform .25s, box-shadow .25s;
    }

        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.25), 0 8px 20px rgba(0,0,0,.3);
        }

        .summary-card.failure {
            background: rgba(225,29,72,.10);
            border: 1px solid rgba(251,113,133,.30);
        }

        .summary-card.predictive {
            background: rgba(99,179,237,.10);
            border: 1px solid rgba(99,179,237,.28);
        }

        .summary-card.sc-active {
            background: rgba(16,185,129,.10);
            border: 1px solid rgba(52,211,153,.30);
        }

        .summary-card .num {
            font-size: 23px;
            font-weight: 800;
            font-variant-numeric: tabular-nums;
            letter-spacing: -.5px;
        }

        .summary-card.failure .num {
            color: #fb7185;
        }

        .summary-card.predictive .num {
            color: #8ecbf5;
        }

        .summary-card.sc-active .num {
            color: #34d399;
        }

        .summary-card .lbl {
            font-size: 8.5px;
            color: var(--txt-dim);
            letter-spacing: .8px;
            text-transform: uppercase;
            margin-top: 2px;
        }

    @@media(max-width:1024px) {
        .filter-bar {
            flex-direction: column;
            align-items: flex-start;
        }

        .summary-cards {
            margin-left: 0;
            width: 100%;
            justify-content: space-between;
        }

        .topbar {
            flex-wrap: wrap;
            gap: 10px;
        }

        .topbar-right {
            flex-wrap: wrap;
        }
    }

    @@media(prefers-reduced-motion:reduce) {
        *, *::before, *::after {
            animation-duration: .001ms !important;
            animation-iteration-count: 1 !important;
            transition-duration: .001ms !important;
        }

        .bg-aura span {
            animation: none !important;
        }
    }
</style>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Roboto+Condensed:wght@700&display=swap" rel="stylesheet">

<!-- Background layers -->
<div class="bg-aura"><span class="a1"></span><span class="a2"></span><span class="a3"></span><span class="a4"></span></div>
<div class="bg-grain"></div>
<div class="bg-vignette"></div>

<!-- Top Bar -->
<div class="topbar">
    <div class="topbar-logo">
        <div class="icon">E7</div>
        <div>
            <div class="title">Remote Diagnostic &amp; Predictive Maintenance</div>
            <div class="sub">RDPMS v4.2 · Station Board · Liquid Glass</div>
        </div>
    </div>
    <div class="topbar-right">
        <div class="pill pill-settings" onclick="OpenSettings()">⚙ <span>Settings</span></div>
        <div class="pill sound-toggle" id="sound-toggle">🔔 <span id="sound-label">Sound ON</span></div>
        <div class="pill clock" id="clock"></div>
        <div class="pill user-chip">
            <div class="user-avatar">@(E7FRSAdvance.Utility.ClsHttpContent.LoginUser.Name != null ? E7FRSAdvance.Utility.ClsHttpContent.LoginUser.Name.Substring(0, 1).ToUpper() : "U")</div>
            <div>
                <div class="user-name">@E7FRSAdvance.Utility.ClsHttpContent.LoginUser.Name</div>
                <div class="user-role">@E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleName</div>
            </div>
        </div>
    </div>
</div>

<div class="content">
    @using (Ajax.BeginForm("SiteList", "UserSite", new AjaxOptions()
    {
        HttpMethod = "POST",
        UpdateTargetId = "divSiteList",
        InsertionMode = InsertionMode.Replace,
        LoadingElementId = "loader",
    }, new { id = "frmGetSiteList" }))
    {
        { HtmlHelper.ClientValidationEnabled = false; }

        @Html.HiddenFor(m => m.SearchCriteria.ColumnName, new { id = "hdnColumnName" })
        @Html.HiddenFor(m => m.SearchCriteria.SortDirection, new { id = "hdnSortDirection" })

        <!-- Filter Bar -->
        <div class="filter-bar">
            <div class="filter-group">
                <label>Zone</label>
                @Html.DropDownListFor(m => m.SearchCriteria.ZoneId, (IEnumerable<SelectListItem>)ViewBag.Zones, new { @class = "filter-value", id = "zoneAdd1", tabindex = 1 })
            </div>
            <div class="filter-group">
                <label>Division</label>
                <input type="hidden" id="hdnSearchDivisionId" value="@Model.SearchCriteria.DivisionId" />
                @Html.DropDownListFor(m => m.SearchCriteria.DivisionId, (IEnumerable<SelectListItem>)ViewBag.Divisions, new { @class = "filter-value", id = "divisions", tabindex = 1 })
            </div>
            <div class="filter-group">
                <button type="button" class="btn-search" onclick="Search()">Search</button>
            </div>
            <div class="summary-cards" id="summary-cards"></div>
        </div>

        <div id="divSiteList">
            @Html.Action("SiteList", Model)
        </div>
    }

    <div id="divLoadAnalysis">
        @Html.Partial("_Analysis", new List<Domain.AnalyticsLog>())
    </div>

    @using (Ajax.BeginForm("_Setting", "UserSite", new AjaxOptions()
    {
        HttpMethod = "POST",
        UpdateTargetId = "divSetting",
        InsertionMode = InsertionMode.Replace,
        LoadingElementId = "loader",
    }, new { id = "frmHooterSetting" }))
    {
        { HtmlHelper.ClientValidationEnabled = false; }
        <div id="divSetting">
            @Html.Partial("_Setting", new Domain.HooterSetting())
        </div>
    }

    <div id="divSMSLogLister">
        @Html.Partial("_SMSLogLister", new Domain.SMSLogLister())
    </div>
    <div id="divSummaryView"></div>
    <div id="divPerformanceList"></div>
</div>

<div id="divAssetAttributePartial"></div>

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script>
    // ===== Clock =====
    function updateClock() {
        document.getElementById('clock').textContent = new Date().toLocaleTimeString('en-IN', { hour12: false });
    }
    updateClock();
    setInterval(updateClock, 1000);

    // ===== WebAudio Sound System (replaces WAV) =====
    var soundOn = true, audioCtx = null;

    function ensureCtx() {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();
    }

    function playStationJingle() {
        if (!soundOn) return;
        ensureCtx();
        [{ f: 659.25, t: 0 }, { f: 830.61, t: .22 }, { f: 987.77, t: .44 }, { f: 659.25, t: .66 }].forEach(function (n) {
            var o = audioCtx.createOscillator(), g = audioCtx.createGain();
            o.type = 'sine'; o.frequency.value = n.f;
            var st = audioCtx.currentTime + n.t;
            g.gain.setValueAtTime(0, st);
            g.gain.linearRampToValueAtTime(.25, st + .03);
            g.gain.exponentialRampToValueAtTime(.001, st + .42);
            o.connect(g).connect(audioCtx.destination);
            o.start(st); o.stop(st + .45);
        });
    }

    function playAlertHorn() {
        if (!soundOn) return;
        ensureCtx();
        [{ f: 440, t: 0 }, { f: 587.33, t: .25 }].forEach(function (n) {
            var o = audioCtx.createOscillator(), g = audioCtx.createGain();
            o.type = 'sawtooth'; o.frequency.value = n.f;
            var st = audioCtx.currentTime + n.t;
            g.gain.setValueAtTime(0, st);
            g.gain.linearRampToValueAtTime(.18, st + .02);
            g.gain.exponentialRampToValueAtTime(.001, st + .55);
            var lp = audioCtx.createBiquadFilter();
            lp.type = 'lowpass'; lp.frequency.value = 1200;
            o.connect(lp).connect(g).connect(audioCtx.destination);
            o.start(st); o.stop(st + .6);
        });
    }

    // Sound toggle
    var toggleBtn = document.getElementById('sound-toggle');
    var soundLabel = document.getElementById('sound-label');
    toggleBtn.addEventListener('click', function () {
        soundOn = !soundOn;
        if (soundOn) {
            ensureCtx();
            toggleBtn.classList.remove('muted');
            toggleBtn.childNodes[0].textContent = '🔔 ';
            soundLabel.textContent = 'Sound ON';
            playStationJingle();
        } else {
            toggleBtn.classList.add('muted');
            toggleBtn.childNodes[0].textContent = '🔕 ';
            soundLabel.textContent = 'Sound OFF';
        }
    });

    function announceAlerts() {
        if (document.querySelectorAll('.station-card.has-alert').length > 0 && soundOn) {
            playStationJingle();
            setTimeout(playAlertHorn, 1000);
        }
    }

    // First gesture to unlock AudioContext
    var firstGesture = false;
    window.addEventListener('click', function () {
        if (!firstGesture) { firstGesture = true; ensureCtx(); announceAlerts(); }
    }, { once: true });

    // ===== Settings Modal =====
    function OpenSettings() {
        $("#loader").show();
        $.ajax({
            url: '/FRS25/UserSite/Setting',
            type: 'Get',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divSetting").empty().append(data);
                $("#modal-setting").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnGetAssetAttribute(siteName, assetId, assetTypeId) {
        $("#loader").show();
        $.ajax({
            url: '/AssetAttribute/_AssetAttributePartial',
            type: 'Post',
            data: '{siteName:"' + siteName + '",assetId:' + assetId + ',assetTypeId:' + assetTypeId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAssetAttributePartial").empty().append(data);
                $("#modal-assetLister").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("danger", "Something went wrong!");
            }
        });
    }

    function Search() {
        $("#frmGetSiteList").submit();
    }

    function GetDivisionByZone(zoneId) {
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRS25/UserSite/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#divisions").empty();
                    $("#divisions").append($("<option></option>").val('0').html('Select Divison'));
                    $.each(data, function (key, value) {
                        if ($('#hdnSearchDivisionId').val() != '0' && $('#hdnSearchDivisionId').val() == value.Id) {
                            $("#divisions").append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $("#divisions").append($("<option></option>").val(value.Id).html(value.Name));
                        }
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }

    $(document).ready(function () {
        GetDivisionByZone($("#zoneAdd1").val());
        $("#zoneAdd1").change(function () {
            GetDivisionByZone($(this).val());
        });
    });
</script>
