    function fnDownloadPDF() {
        html2canvas($("#mainDivProbability")[0], {
            allowTaint: true,
            scrollX: 0,
            scrollY: -window.scrollY
        }).then((canvas) => {
            var mSummary = {};
            mSummary.FileExtension = '.jpeg';
            mSummary.ImageBase64 = canvas.toDataURL();
            mSummary.Date = $('#txtSearchTimeStamp').val();
            mSummary.SiteName = '@ViewBag.SiteName';

           // window.location.href = "UserSite/GenerateSummaryPdf?base64=" + canvas.toDataURL();
            $("#loader").show();
            $.ajax({
                url: '/UserSite/GenerateSummaryPdf',
                type: 'POST',
                data: JSON.stringify(mSummary),
                contentType: 'application/json',
                success: function (resultData) {
                    $("#loader").hide();
                    if (resultData != null && resultData != undefined && resultData != '') {
                        const linkSource = `data:application/pdf;base64,${resultData}`;
                        const downloadLink = document.createElement("a");
                        const fileName = '@ViewBag.SiteName' + '.pdf';
                        downloadLink.href = linkSource;
                        downloadLink.download = fileName;
                        downloadLink.click();

                        //if (resultData.isSuccess == true) {
                        //    CommonNotification("success", resultData.message);
                        //} else {
                        //    CommonNotification("error", resultData.message);
                       // }
                    }
                },
                error: function (err) {
                    $('#loader').hide();
                    CommonNotification(err.responseText, "danger");
                }
            });
        });
    }

