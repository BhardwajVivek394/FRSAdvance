        <ul class="nav nav-tabs border-tab nav-primary" id="info-tab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="Alert-tab" data-bs-toggle="tab" href="#Predictive-Alert" role="tab" aria-controls="Predictive-Alert" aria-selected="true" data-bs-original-title="" title="">
                    Predictive Alert
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="Alert-tab" data-bs-toggle="tab" href="#Failure-Alert" onclick="LoadFailureAlertList()" role="tab" aria-controls="Failure-Alert" aria-selected="true" data-bs-original-title="" title="">
                    Maintenance Alert
                </a>
            </li>
            <li>
                <a class="nav-link" id="Consolidated-tab" data-bs-toggle="tab" href="#Consolidated" role="tab" onclick="fnLoadConsolidated()" aria-controls="Consolidated" aria-selected="true" data-bs-original-title="" title="">
                    Consolidated
                </a>
            </li>
            <li>
                <a class="nav-link" id="Probability-tab" data-bs-toggle="tab" href="#Probability" onclick="LoadProbabilityList('@((int)E7FRSAdvance.Utility.Utility.AssetType.TRACK)')" role="tab" aria-controls="Probability" aria-selected="true" data-bs-original-title="" title="">
                    Probability
                </a>
            </li>
            <li>
                <a class="nav-link" id="Performance-tab" data-bs-toggle="tab" href="#Performance" role="tab" aria-controls="Performance" aria-selected="true" data-bs-original-title="" title="">
                    Performance
                </a>
            </li>
        </ul>
