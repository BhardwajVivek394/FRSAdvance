    function DownloadProbabilityList() {
        var drpAssetTypes = $('#drpAssetTypeList').val();
        var AssetTypeIds = [];
        if (drpAssetTypes != null && drpAssetTypes != undefined && drpAssetTypes != '') {
            var splitAssetType = drpAssetTypes.split(",");
            if (splitAssetType != null && splitAssetType.length > 0) {
                $(splitAssetType).each(function (dat,value) {
                    AssetTypeIds.push(value);
                });
            }
            var mSearchCriteria = {};
            mSearchCriteria.SiteId = '@ViewBag.SiteId';
            mSearchCriteria.Month = $('#ProbabilityMonth').val();
            mSearchCriteria.Year = $('#ProbabilityYear').val();
            mSearchCriteria.AssetTypeIds = AssetTypeIds;
            $("#loader").show();
            $.ajax({
                url: '/UserSite/DownloadProbabilityList',
                type: 'Post',
                data: JSON.stringify(mSearchCriteria),
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    const linkSource = `data:application/pdf;base64,${data}`;
                    const downloadLink = document.createElement("a");
                    const fileName = "Probability.pdf";
                    downloadLink.href = linkSource;
                    downloadLink.download = fileName;
                    downloadLink.click();
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("error", "Something went wrong!");
                }
            });
        }

    }

