<script type="text/javascript">
    $(document).ready(function () {
        $('#txtSearchTimeStamp').datepicker({
            dateFormat: 'mm/dd/yy',
            autoClose: true
        });

        $('#txtFailureAlertSearchTimeStamp').datepicker({
            dateFormat: 'mm/dd/yy',
            autoClose: true
        });



        LoadGluedLogDataList();
        LoadTrainRunningMomentList();
