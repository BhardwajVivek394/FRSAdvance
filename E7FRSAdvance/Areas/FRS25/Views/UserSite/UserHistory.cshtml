    function fnLoadConsolidated() {
        const date = new Date();  // 2009-11-10
        const month = date.toLocaleString('default', { month: 'long' });
        const year = date.getFullYear();

        var mConsolidatedLister = {};
        var searchCriteria = {};
        searchCriteria.Year = $('#Consolidated_Year').val();
        searchCriteria.Month = $('#SearchCriteria_Month').val();
        searchCriteria.SiteId =  '@ViewBag.SiteId';
        mConsolidatedLister.SearchCriteria = searchCriteria;
        if (searchCriteria.Month == null || searchCriteria.Month == undefined || searchCriteria.Month.length <= 0) {
            searchCriteria.Month = month;
            $('#SearchCriteria_Month').select2().val(month).trigger('change');
        }
        if (searchCriteria.Year == null || searchCriteria.Year == undefined || searchCriteria.Year.length <= 0) {
            searchCriteria.Year = year;
            $('#Consolidated_Year').val(year).trigger('change');
        }

        if (searchCriteria.Month != null && searchCriteria.Month != undefined && searchCriteria.Month.length > 0) {
            $("#loader").show();
            $.ajax({
                url: "/UserSite/_ConsolidatedLister",
                type: "POST",
                data: '{mConsolidatedLister:' + JSON.stringify(mConsolidatedLister) + '}',
                contentType: 'application/json',
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data != undefined && data != '') {
                        $("#divConsolidatedReport").empty().append(data);
                    } else {
                        $("#divConsolidatedReport").empty()
                    }
                },
                error: function (xhr, error, status) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "Error");
                }
            });
        } else {
            CommonNotification("ERROR", "Please select month.", "Error");
        }

    }

