@model Domain.Site
@{
    ViewBag.Title = "UserHistory";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}


<style>
    .card-header-summary {
        background-color: #0e2b42 !important;
        padding-top: 10px !important;
        padding-bottom: 3px !important;
        padding-left: 30px !important;
        color: white !important;
    }

    .card .card-body {
        padding: 15px !important;
    }

    .clsDivIndexAlertLogs {
        padding: 6px 12px;
        border: 1px solid #ccc; /* THIS */
        border-radius: 4px; /* THIS */
    }

    .tblYellow {
        background-color: #E6AD5C !important;
        color: white !important;
    }

    .tblRed {
        background-color: #ff4d4f !important;
        color: white !important;
    }

    .tblGreen {
        background-color: #247F52 !important;
        color: white !important;
    }

    .nav-item {
        padding-top: 10px;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        padding: 4px 4px !important;
        margin-top: 5px !important;
        background-color: #4bacc6 !important;
        border-color: #4bacc6 !important;
        color: #fff;
        margin-right: 6px !important;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
        color: white;
        cursor: pointer;
        display: inline-block;
        font-weight: bold;
        margin-right: 2px;
    }


    /*Alert and predictive*/
    .pill-badge-primary1 {
        background-color: White;
    }

    body .mail-body-wrapper ul li {
        padding: 16px;
        display: flex;
        align-items: center;
        cursor: pointer;
        border-bottom: 1px solid #bebebe;
    }

    .pull-right {
        float: right;
    }

    body .mail-body-wrapper ul li .inbox-message .email-data .badge {
        border-radius: 20px;
    }

    body .mail-body-wrapper ul li .inbox-message {
        display: flex;
        justify-content: space-between;
        width: 100%;
        gap: 16px;
    }

        body .mail-body-wrapper ul li .inbox-message .email-data span {
            font-weight: 500;
            letter-spacing: 0.3;
            display: -webkit-box;
            max-width: 100%;
            margin: 0 auto;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            color: rgba(82, 82, 108, 0.8);
        }
</style>
<script src="~/assets/js/paho-mqtt.js"></script>
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-2">
                <a class="btn btn-info btn-lg" href="@Url.Action("Index")">Back</a>

            </div>
            <div class="col-8 text-center">
                <h5>@ViewBag.SiteName</h5>
            </div>

        </div>
    </div>
</div>

<div class="col-lg-12">
