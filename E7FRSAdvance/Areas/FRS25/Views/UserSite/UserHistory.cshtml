@model Domain.AppAccessLister
@{
    ViewBag.Title = "UserHistory";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}

<style>
    /* ============================================
       USER HISTORY — AURORA THEME
       ============================================ */

    .uh-page {
        padding: 0 4px;
    }

    /* --- Top Header Bar --- */
    .uh-header {
        background: linear-gradient(135deg, rgba(14, 43, 66, 0.85) 0%, rgba(20, 30, 60, 0.7) 100%);
        border: 1px solid rgba(99, 179, 237, 0.15);
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 18px;
        backdrop-filter: blur(10px);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25);
    }

    .uh-header-row {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .uh-back-btn {
        background: linear-gradient(135deg, #259dab, #1d7a85);
        color: #fff !important;
        border: none;
        height: 42px;
        padding: 0 18px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
        cursor: pointer;
        white-space: nowrap;
    }

        .uh-back-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(37, 157, 171, 0.4);
            color: #fff !important;
            text-decoration: none;
        }

        .uh-back-btn i {
            font-size: 12px;
        }

    .uh-site-title {
        flex: 1;
        text-align: center;
        min-width: 200px;
    }

        .uh-site-title h5 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
            color: #fff;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

            .uh-site-title h5 .uh-loc-icon {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                background: rgba(99, 179, 237, 0.18);
                color: #79c1f5;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
            }

    /* --- Date Filter Pills --- */
    .uh-date-group {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .uh-date-field {
        position: relative;
    }

        .uh-date-field input.form-control {
            background: rgba(15, 23, 41, 0.6) !important;
            border: 1px solid rgba(99, 179, 237, 0.25) !important;
            color: #e6edf6 !important;
            height: 42px;
            border-radius: 10px;
            padding: 0 14px 0 38px;
            font-size: 13px;
            min-width: 170px;
        }

            .uh-date-field input.form-control::placeholder {
                color: rgba(230, 237, 246, 0.5);
            }

            .uh-date-field input.form-control:focus {
                border-color: #259dab !important;
                box-shadow: 0 0 0 3px rgba(37, 157, 171, 0.15) !important;
                outline: none;
            }

        .uh-date-field .uh-date-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #79c1f5;
            font-size: 13px;
            pointer-events: none;
        }

        .uh-date-field .uh-date-label {
            position: absolute;
            top: -8px;
            left: 12px;
            background: #0e2b42;
            padding: 0 6px;
            font-size: 10px;
            font-weight: 600;
            color: rgba(230, 237, 246, 0.6);
            letter-spacing: 0.6px;
            text-transform: uppercase;
        }

    /* --- Stats Summary Card --- */
    .uh-stats-card {
        background: linear-gradient(135deg, rgba(14, 43, 66, 0.7) 0%, rgba(30, 20, 60, 0.5) 100%);
        border: 1px solid rgba(99, 179, 237, 0.2);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
    }

    .uh-stats-header {
        background: linear-gradient(135deg, #0e2b42 0%, #1a3a5a 50%, #2a1f4a 100%);
        padding: 18px 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        border-bottom: 1px solid rgba(99, 179, 237, 0.15);
    }

    .uh-stat-block {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .uh-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(37, 157, 171, 0.25), rgba(99, 179, 237, 0.15));
        border: 1px solid rgba(99, 179, 237, 0.3);
        color: #79c1f5;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .uh-stat-text {
        display: flex;
        flex-direction: column;
    }

        .uh-stat-text .lbl {
            font-size: 11px;
            font-weight: 600;
            color: rgba(230, 237, 246, 0.55);
            letter-spacing: 0.6px;
            text-transform: uppercase;
            margin-bottom: 2px;
        }

        .uh-stat-text .val {
            font-size: 22px;
            font-weight: 700;
            color: #fff;
            line-height: 1;
        }

            .uh-stat-text .val .unit {
                font-size: 13px;
                font-weight: 500;
                color: rgba(230, 237, 246, 0.6);
                margin-left: 4px;
            }

    .uh-stats-body {
        padding: 22px;
    }

    /* Empty state */
    .uh-empty {
        text-align: center;
        padding: 60px 20px;
        color: rgba(230, 237, 246, 0.5);
    }

        .uh-empty .uh-empty-icon {
            width: 70px;
            height: 70px;
            border-radius: 50%;
            background: rgba(99, 179, 237, 0.1);
            color: #79c1f5;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            margin-bottom: 16px;
        }

        .uh-empty h5 {
            color: #e6edf6;
            margin: 0 0 6px;
            font-size: 17px;
            font-weight: 600;
        }

        .uh-empty p {
            margin: 0;
            font-size: 13px;
        }

    /* --- Override default card --- */
    .uh-stats-card .card-header,
    .uh-stats-card .card-body {
        background: transparent !important;
        border: none !important;
        padding: 0 !important;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .uh-header-row {
            flex-direction: column;
            align-items: stretch;
        }

        .uh-site-title {
            text-align: left;
        }

        .uh-stats-header {
            flex-direction: column;
            gap: 14px;
        }
    }
</style>

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid uh-page">

    <!-- ============ TOP HEADER ============ -->
    <div class="uh-header">
        <div class="uh-header-row">
            <a class="uh-back-btn" href="@Url.Action("Index")">
                <i class="fa fa-arrow-left"></i> Back to Sites
            </a>

            <div class="uh-site-title">
                <h5>
                    <span class="uh-loc-icon"><i class="fa fa-map-marker-alt"></i></span>
                    <span>@ViewBag.SiteName</span>
                </h5>
            </div>

            <div class="uh-date-group">
                <div class="uh-date-field">
                    <span class="uh-date-label">From</span>
                    <i class="fa fa-calendar-alt uh-date-icon"></i>
                    @Html.TextBoxFor(x => x.SearchCriteria.StartTime, new { @class = "form-control", @placeholder = "Select date" })
                </div>
                <div class="uh-date-field">
                    <span class="uh-date-label">To</span>
                    <i class="fa fa-calendar-alt uh-date-icon"></i>
                    @Html.TextBoxFor(x => x.SearchCriteria.EndTime, new { @class = "form-control", @placeholder = "Select date" })
                </div>
            </div>
        </div>
    </div>

    <!-- ============ STATS CARD ============ -->
    <div class="row" id="minDivAxleCounter">
        <div class="col-12">
            <div class="uh-stats-card">

                <!-- Stats Header -->
                <div class="uh-stats-header">
                    <div class="uh-stat-block">
                        <span class="uh-stat-icon"><i class="fa fa-clock"></i></span>
                        <div class="uh-stat-text">
                            <span class="lbl">Total Duration</span>
                            <span class="val"><span id="spnTotalDuration">0</span><span class="unit">min</span></span>
                        </div>
                    </div>
                </div>

                <!-- Stats Body -->
                <div class="uh-stats-body divappendAxleCounter">
                    @using (Ajax.BeginForm("_UserHistoryLister", "UserSite", new AjaxOptions()
                    {
                        HttpMethod = "POST",
                        UpdateTargetId = "divUserHistoryList",
                        InsertionMode = InsertionMode.Replace,
                        LoadingElementId = "loader",
                    }, new { id = "frmGetUserHistoryList" }))
                    {
                        @Html.HiddenFor(x => x.SearchCriteria.StartTime, new { @id = "hdnStartTime" })
                        @Html.HiddenFor(x => x.SearchCriteria.EndTime, new { @id = "hdnEndTime" })
                        @Html.HiddenFor(x => x.SearchCriteria.SiteId)
                        { HtmlHelper.ClientValidationEnabled = false; }
                        <div id="divUserHistoryList">
                            @Html.Action("_UserHistoryLister", Model)
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#SearchCriteria_StartTime').datepicker({
            dateFormat: 'mm/dd/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#SearchCriteria_EndTime').datepicker({
            dateFormat: 'mm/dd/yy',
            autoClose: true
        }).datepicker("setDate", new Date());

        $('#SearchCriteria_StartTime').change(function () {
            $('#hdnStartTime').val($('#SearchCriteria_StartTime').val());
            $('#hdnEndTime').val($('#SearchCriteria_EndTime').val());
            $('#frmGetUserHistoryList').submit();
        });

        $('#SearchCriteria_EndTime').change(function () {
            $('#hdnStartTime').val($('#SearchCriteria_StartTime').val());
            $('#hdnEndTime').val($('#SearchCriteria_EndTime').val());
            $('#frmGetUserHistoryList').submit();
        });

        $('#SearchCriteria_StartTime').val('');
        $('#SearchCriteria_EndTime').val('');
    });
</script>
