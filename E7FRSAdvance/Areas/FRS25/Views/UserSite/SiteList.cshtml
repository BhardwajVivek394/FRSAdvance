@model Domain.SiteLister
<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(430px,1fr));
        gap: 22px;
        align-items: start
    }

    .station-card {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: linear-gradient(180deg,rgba(28,35,55,.9),rgba(16,21,34,.92)) padding-box,linear-gradient(180deg,rgba(255,255,255,.16),rgba(255,255,255,.035) 42%,rgba(255,255,255,.07)) border-box;
        border: 1px solid transparent;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.06),0 1px 1px rgba(0,0,0,.5),0 22px 46px -26px rgba(0,0,0,.85);
        transition: transform .25s cubic-bezier(.2,.7,.3,1),box-shadow .25s,border-color .25s
    }

        .station-card > * {
            position: relative;
            z-index: 1
        }

        .station-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            z-index: 5;
            background: linear-gradient(90deg,transparent,var(--ok) 30%,var(--ok) 70%,transparent);
            opacity: .95
        }

        .station-card.has-alert::before {
            background: linear-gradient(90deg,transparent,var(--alert) 30%,var(--alert) 70%,transparent)
        }

        .station-card::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            border-radius: 16px;
            background: radial-gradient(130% 64% at 50% -12%,rgba(255,255,255,.07),transparent 56%)
        }

        .station-card:hover {
            transform: translateY(-3px);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.08),0 1px 1px rgba(0,0,0,.5),0 32px 60px -26px rgba(0,0,0,.9)
        }

        .station-card.has-alert {
            box-shadow: inset 0 1px 0 rgba(255,255,255,.06),0 1px 1px rgba(0,0,0,.5),0 22px 46px -26px rgba(0,0,0,.85),0 0 54px -18px var(--alert-glow)
        }

        .station-card.enter {
            animation: fade-up .55s cubic-bezier(.2,.7,.3,1) backwards
        }

    @@keyframes fade-up {
        from {
            opacity: 0;
            transform: translateY(12px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes soft-pulse {
        0%, 100% {
            box-shadow: 0 0 0 3px var(--alert-soft),0 0 10px var(--alert-glow)
        }

        50% {
            box-shadow: 0 0 0 6px rgba(251,111,132,.05),0 0 16px var(--alert-glow)
        }
    }

    .card-head {
        padding: 18px 20px 16px;
        border-bottom: 1px solid var(--line)
    }

    .ch-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px
    }

    .ch-id {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0
    }

    .ch-mark {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));
        border: 1px solid var(--line-2);
        color: var(--text-2)
    }

        .ch-mark svg {
            width: 22px;
            height: 22px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round
        }

    .station-card.has-alert .ch-mark {
        color: var(--alert);
        border-color: var(--alert-line);
        background: var(--alert-soft);
        box-shadow: 0 0 16px -6px var(--alert-glow)
    }

    .station-card:not(.has-alert) .ch-mark {
        color: var(--ok);
        border-color: var(--ok-line);
        background: var(--ok-soft);
        box-shadow: 0 0 16px -6px var(--ok-glow)
    }

    .ch-name {
        font-size: 20px;
        font-weight: 680;
        letter-spacing: -.02em;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.18
    }

    .ch-sub {
        font-size: 13px;
        color: var(--text-3);
        margin-top: 2px
    }

    .ch-right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0
    }

    .ch-code {
        font-family: var(--mono);
        font-size: 13px;
        font-weight: 600;
        color: var(--text-2);
        padding: 4px 9px;
        border-radius: 7px;
        background: linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));
        border: 1px solid var(--line-2)
    }

    .status-line {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-top: 13px
    }

        .status-line .lamp {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            flex-shrink: 0
        }

        .status-line.ok .lamp {
            background: var(--ok);
            box-shadow: 0 0 0 3px var(--ok-soft),0 0 10px var(--ok-glow)
        }

        .status-line.alert .lamp {
            background: var(--alert);
            box-shadow: 0 0 0 3px var(--alert-soft),0 0 10px var(--alert-glow);
            animation: soft-pulse 1.9s ease-in-out infinite
        }

        .status-line .txt {
            font-size: 13px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase
        }

        .status-line.ok .txt {
            color: var(--ok)
        }

        .status-line.alert .txt {
            color: var(--alert)
        }

    .live-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .09em;
        color: #86e6c4;
        background: var(--ok-soft);
        border: 1px solid var(--ok-line);
        padding: 2px 7px 2px 6px;
        border-radius: 20px
    }

        .live-chip .ld {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--ok);
            animation: live-ping 1.8s ease-out infinite
        }

    @@keyframes live-ping {
        0% {
            box-shadow: 0 0 0 0 rgba(52,211,153,.55)
        }

        70%, 100% {
            box-shadow: 0 0 0 5px rgba(52,211,153,0)
        }
    }

    .status-line .badge {
        margin-left: auto;
        font-size: 12px;
        font-weight: 600;
        color: var(--text-3);
        padding: 3px 10px;
        border-radius: 20px;
        background: linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.02));
        border: 1px solid var(--line)
    }

    .card-nav {
        display: flex;
        padding: 0 16px;
        border-bottom: 1px solid var(--line)
    }

        .card-nav .seg {
            display: flex;
            width: 100%
        }

        .card-nav button {
            flex: 1;
            position: relative;
            background: transparent;
            border: none;
            padding: 12px 4px;
            cursor: pointer;
            color: var(--text-3);
            font-size: 12.5px;
            font-weight: 600;
            font-family: inherit;
            transition: color .18s;
            white-space: nowrap
        }

            .card-nav button:hover {
                color: var(--text-2)
            }

            .card-nav button.active {
                color: var(--text)
            }

                .card-nav button.active::after {
                    content: "";
                    position: absolute;
                    left: 10%;
                    right: 10%;
                    bottom: -1px;
                    height: 2px;
                    border-radius: 2px;
                    background: linear-gradient(90deg,var(--accent),var(--accent2));
                    box-shadow: 0 0 10px rgba(124,131,242,.65)
                }

    .station-card.has-alert .card-nav button.active::after {
        background: linear-gradient(90deg,#fb6f84,#fb9aa8);
        box-shadow: 0 0 10px var(--alert-glow)
    }

    .slide-viewport {
        position: relative;
        overflow: hidden;
        height: 280px;
        transition: height .35s cubic-bezier(.4,0,.2,1)
    }

    .slide-track {
        display: flex;
        align-items: flex-start;
        transition: transform .42s cubic-bezier(.4,0,.2,1)
    }

    .slide {
        min-width: 100%;
        padding: 18px 20px
    }

    .alert-info-box, .perf-card, .history-item, .tele {
        background: linear-gradient(180deg,rgba(255,255,255,.052),rgba(255,255,255,.018)) padding-box,linear-gradient(180deg,rgba(255,255,255,.13),rgba(255,255,255,.03)) border-box;
        border: 1px solid transparent;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.05)
    }

    .now-slide {
        display: flex;
        flex-direction: column;
        gap: 13px
    }

    .tele {
        border-radius: 12px;
        padding: 14px 15px
    }

    .tele-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px
    }

    .tele-lbl {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--text-3)
    }

    .tele-chart {
        position: relative;
        height: 130px
    }

    .spark {
        display: block;
        width: 100%
    }

    .tele-chart .spark {
        height: 130px
    }

    .tele-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 14px;
        margin-top: 10px;
        font-size: 11px;
        color: var(--text-3);
        font-family: var(--mono)
    }

    .tele-leg-item {
        display: inline-flex;
        align-items: center;
        gap: 6px
    }

        .tele-leg-item i {
            width: 9px;
            height: 9px;
            border-radius: 2px;
            display: inline-block;
            flex-shrink: 0
        }

    .tele-empty {
        color: var(--text-4);
        font-size: 11px;
        text-align: center;
        padding: 10px 0
    }

    .now-heading {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-3);
        text-transform: uppercase;
        letter-spacing: .1em
    }

    .alert-info-box {
        border-radius: 12px;
        padding: 14px
    }

        .alert-info-box.failure-border {
            box-shadow: inset 0 1px 0 rgba(255,255,255,.05),inset 0 0 0 1px var(--alert-line),0 0 28px -16px var(--alert-glow)
        }

        .alert-info-box.predictive-border {
            box-shadow: inset 0 1px 0 rgba(255,255,255,.05),inset 0 0 0 1px rgba(122,162,247,.3)
        }

    .ab-top {
        display: flex;
        gap: 6px;
        align-items: center
    }

    .alert-type-badge {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 6px;
        letter-spacing: .04em;
        text-transform: uppercase
    }

        .alert-type-badge.failure {
            background: linear-gradient(180deg,rgba(251,111,132,.24),rgba(251,111,132,.12));
            color: #ffb3c0;
            box-shadow: inset 0 0 0 1px rgba(251,111,132,.32),0 0 12px -4px var(--alert-glow)
        }

        .alert-type-badge.predictive {
            background: linear-gradient(180deg,rgba(122,162,247,.22),rgba(122,162,247,.1));
            color: #a8c2fc;
            box-shadow: inset 0 0 0 1px rgba(122,162,247,.3)
        }

    .alert-status-badge {
        font-size: 11px;
        font-weight: 600;
        padding: 3px 9px;
        border-radius: 6px;
        letter-spacing: .03em;
        text-transform: uppercase
    }

        .alert-status-badge.active-st {
            background: var(--ok-soft);
            color: #74e3bd;
            box-shadow: inset 0 0 0 1px var(--ok-line)
        }

        .alert-status-badge.cleared-st {
            background: rgba(255,255,255,.05);
            color: var(--text-3);
            box-shadow: inset 0 0 0 1px var(--line)
        }

    .alert-asset-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 12px 0 5px
    }

    .alert-asset {
        color: var(--text);
        font-size: 16.5px;
        font-weight: 640;
        letter-spacing: -.01em
    }

    .alert-cause {
        color: #f8c970;
        font-size: 12.5px;
        font-family: var(--mono);
        background: var(--warn-soft);
        display: inline-block;
        padding: 3px 8px;
        border-radius: 5px;
        margin-bottom: 11px;
        box-shadow: inset 0 0 0 1px var(--warn-line)
    }

    .alert-msg {
        color: var(--text-3);
        font-size: 11px;
        line-height: 1.4;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden
    }

    .alert-meta {
        display: flex;
        gap: 16px;
        color: var(--text-3);
        font-size: 12.5px;
        font-family: var(--mono)
    }

        .alert-meta .dur {
            color: #f8c970
        }

    .alert-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: var(--ok);
        font-size: 13px;
        font-weight: 600;
        min-height: 120px
    }

    .timeline-title {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-3);
        margin-bottom: 13px;
        text-transform: uppercase;
        letter-spacing: .1em
    }

    .timeline {
        position: relative;
        padding-left: 15px
    }

    .timeline-line {
        position: absolute;
        left: 4px;
        top: 4px;
        bottom: 4px;
        width: 1.5px;
        background: linear-gradient(180deg,var(--line-3),transparent)
    }

    .timeline-item {
        position: relative;
        margin-bottom: 14px;
        padding-left: 14px
    }

        .timeline-item:last-child {
            margin-bottom: 0
        }

    .timeline-dot {
        position: absolute;
        left: -12px;
        top: 4px;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        border: 2px solid #141a28
    }

        .timeline-dot.failure {
            background: var(--alert);
            box-shadow: 0 0 8px -1px var(--alert-glow)
        }

        .timeline-dot.predictive {
            background: var(--pred);
            box-shadow: 0 0 8px -1px rgba(122,162,247,.6)
        }

    .timeline-head {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 3px;
        flex-wrap: wrap
    }

    .timeline-type {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em
    }

        .timeline-type.failure {
            color: #ffb3c0
        }

        .timeline-type.predictive {
            color: #a8c2fc
        }

    .timeline-time {
        font-size: 12px;
        color: var(--text-4);
        font-family: var(--mono)
    }

    .timeline-st {
        font-size: 10px;
        padding: 1px 6px;
        border-radius: 4px;
        margin-left: auto;
        font-weight: 600;
        text-transform: uppercase
    }

        .timeline-st.active-st {
            background: var(--ok-soft);
            color: #74e3bd
        }

        .timeline-st.cleared-st {
            background: rgba(255,255,255,.05);
            color: var(--text-3)
        }

    .timeline-asset {
        color: var(--text-2);
        font-size: 13.5px;
        font-weight: 540
    }

    .timeline-cause {
        color: #e0aa58;
        font-size: 12px;
        font-family: var(--mono);
        opacity: .9;
        margin-top: 1px
    }

    .perf-slide {
        display: flex;
        flex-direction: column;
        gap: 12px
    }

    .perf-heading {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-3);
        text-transform: uppercase;
        letter-spacing: .1em
    }

    .perf-card {
        border-radius: 12px;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 14px
    }

    .perf-ring-wrap {
        position: relative;
        width: 48px;
        height: 48px;
        flex-shrink: 0
    }

    .perf-ring-bg {
        fill: none;
        stroke: var(--line-3);
        stroke-width: 4
    }

    .perf-ring-fill {
        fill: none;
        stroke-width: 4;
        stroke-linecap: round;
        transition: stroke-dashoffset 1.2s;
        filter: drop-shadow(0 0 4px currentColor)
    }

    .perf-ring-val {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 730
    }

    .perf-detail {
        flex: 1;
        min-width: 0
    }

    .perf-label {
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 7px
    }

    .perf-bar-track {
        height: 6px;
        background: var(--surface-3);
        border-radius: 3px;
        overflow: hidden
    }

    .perf-bar-fill {
        height: 100%;
        border-radius: 3px;
        transition: width 1.2s
    }

        .perf-bar-fill.failure-bar {
            background: linear-gradient(90deg,#e5566d,#fb6f84);
            box-shadow: 0 0 10px -2px var(--alert-glow)
        }

        .perf-bar-fill.predictive-bar {
            background: linear-gradient(90deg,#5d86e8,#7aa2f7);
            box-shadow: 0 0 10px -2px rgba(122,162,247,.6)
        }

        .perf-bar-fill.coverage-bar {
            background: linear-gradient(90deg,#1faf80,#34d399);
            box-shadow: 0 0 10px -2px var(--ok-glow)
        }

    .perf-sub {
        display: flex;
        justify-content: space-between;
        margin-top: 5px;
        font-size: 10.5px;
        color: var(--text-4)
    }

    .history-title {
        font-size: 12px;
        font-weight: 700;
        color: var(--text-3);
        margin-bottom: 13px;
        text-transform: uppercase;
        letter-spacing: .1em
    }

    .history-item {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 9px 11px;
        margin-bottom: 7px;
        border-radius: 10px
    }

        .history-item:last-child {
            margin-bottom: 0
        }

    .history-avatar {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: linear-gradient(140deg,rgba(124,131,242,.3),rgba(124,131,242,.12));
        border: 1px solid rgba(124,131,242,.28);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #c3cbfb;
        font-size: 13px;
        font-weight: 600;
        flex-shrink: 0
    }

    .history-info {
        flex: 1;
        min-width: 0
    }

    .history-user {
        color: var(--text);
        font-size: 13.5px;
        font-weight: 600
    }

    .history-action {
        color: var(--text-3);
        font-size: 12.5px;
        margin-top: 1px
    }

    .history-time {
        color: var(--text-4);
        font-size: 11px;
        flex-shrink: 0;
        text-align: right;
        line-height: 1.4;
        font-family: var(--mono)
    }

    .health-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-4);
        font-size: 13px;
        font-weight: 600;
        min-height: 120px
    }

    /* ===== Health scan-grid (ported from design mockup) ===== */
    .health-slide {
        height: auto;
        display: flex;
        flex-direction: column;
        gap: 12px
    }

    .hg-wrap {
        border-radius: 12px;
        overflow: hidden;
        background: linear-gradient(180deg,rgba(255,255,255,.052),rgba(255,255,255,.018)) padding-box,linear-gradient(180deg,rgba(255,255,255,.13),rgba(255,255,255,.03)) border-box;
        border: 1px solid transparent;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.05)
    }

    .hgrid {
        display: grid;
        grid-template-columns: minmax(0,1fr) auto auto auto
    }

    .hg-row {
        display: contents
    }

    .hg-h {
        display: flex;
        align-items: center;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--text-3);
        padding: 10px 12px;
        border-bottom: 1px solid var(--line);
        background: linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.01))
    }

        .hg-h.svc {
            justify-content: flex-start
        }

        .hg-h.nd {
            justify-content: center;
            gap: 5px
        }

            .hg-h.nd.local {
                color: var(--node-l)
            }

            .hg-h.nd.cloud {
                color: var(--node-c)
            }

            .hg-h.nd .nh-ico {
                font-size: 12px
            }

        .hg-h.last {
            justify-content: flex-end;
            color: var(--text-4)
        }

    .hg-c {
        display: flex;
        align-items: center;
        padding: 9px 12px;
        border-bottom: 1px solid var(--line)
    }

    .hg-row:last-child .hg-c {
        border-bottom: 0
    }

    .hg-c.svc {
        justify-content: flex-start;
        gap: 9px;
        font-size: 14px;
        font-weight: 600;
        color: var(--text);
        min-width: 0
    }

        .hg-c.svc .s-ico {
            font-size: 17px;
            line-height: 1;
            flex-shrink: 0;
            opacity: .92
        }

        .hg-c.svc .s-name {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis
        }

    .hg-c.nd {
        justify-content: center;
        gap: 7px
    }

    .hg-c.last {
        justify-content: flex-end;
        font-size: 12px;
        font-weight: 500;
        color: var(--text-4);
        font-family: var(--mono);
        white-space: nowrap
    }

    .hg-row:hover .hg-c {
        background: rgba(255,255,255,.03)
    }

    .st {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 27px;
        height: 24px;
        border-radius: 6px;
