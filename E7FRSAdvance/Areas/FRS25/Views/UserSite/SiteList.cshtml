@model Domain.SiteLister
<style>
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(372px,1fr));
        gap: 18px;
        align-items: start
    }

    .station-card {
        position: relative;
        border-radius: 16px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background: linear-gradient(180deg,rgba(28,35,55,.9),rgba(16,21,34,.92)) padding-box,linear-gradient(180deg,rgba(255,255,255,.16),rgba(255,255,255,.035) 42%,rgba(255,255,255,.07)) border-box;
        border: 1px solid transparent;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.06),0 1px 1px rgba(0,0,0,.5),0 22px 46px -26px rgba(0,0,0,.85);
        transition: transform .25s cubic-bezier(.2,.7,.3,1),box-shadow .25s,border-color .25s
    }

        .station-card > * {
            position: relative;
            z-index: 1
        }

        .station-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            z-index: 5;
            background: linear-gradient(90deg,transparent,var(--ok) 30%,var(--ok) 70%,transparent);
            opacity: .95
        }

        .station-card.has-alert::before {
            background: linear-gradient(90deg,transparent,var(--alert) 30%,var(--alert) 70%,transparent)
        }

        .station-card::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            border-radius: 16px;
            background: radial-gradient(130% 64% at 50% -12%,rgba(255,255,255,.07),transparent 56%)
        }

        .station-card:hover {
            transform: translateY(-3px);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.08),0 1px 1px rgba(0,0,0,.5),0 32px 60px -26px rgba(0,0,0,.9)
        }

        .station-card.has-alert {
            box-shadow: inset 0 1px 0 rgba(255,255,255,.06),0 1px 1px rgba(0,0,0,.5),0 22px 46px -26px rgba(0,0,0,.85),0 0 54px -18px var(--alert-glow)
        }

        .station-card.enter {
            animation: fade-up .55s cubic-bezier(.2,.7,.3,1) backwards
        }

    @@keyframes fade-up {
        from {
            opacity: 0;
            transform: translateY(12px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }

    @@keyframes soft-pulse {
        0%, 100% {
            box-shadow: 0 0 0 3px var(--alert-soft),0 0 10px var(--alert-glow)
        }

        50% {
            box-shadow: 0 0 0 6px rgba(251,111,132,.05),0 0 16px var(--alert-glow)
        }
    }

    .card-head {
        padding: 16px 18px 14px;
        border-bottom: 1px solid var(--line)
    }

    .ch-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px
    }

    .ch-id {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0
    }

    .ch-mark {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));
        border: 1px solid var(--line-2);
        color: var(--text-2)
    }

        .ch-mark svg {
            width: 20px;
            height: 20px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.7;
            stroke-linecap: round;
            stroke-linejoin: round
        }

    .station-card.has-alert .ch-mark {
        color: var(--alert);
        border-color: var(--alert-line);
        background: var(--alert-soft);
        box-shadow: 0 0 16px -6px var(--alert-glow)
    }

    .station-card:not(.has-alert) .ch-mark {
        color: var(--ok);
        border-color: var(--ok-line);
        background: var(--ok-soft);
        box-shadow: 0 0 16px -6px var(--ok-glow)
    }

    .ch-name {
        font-size: 17px;
        font-weight: 680;
        letter-spacing: -.02em;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.18
    }

    .ch-sub {
        font-size: 11px;
        color: var(--text-3);
        margin-top: 2px
    }

    .ch-right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0
    }

    .ch-code {
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 600;
        color: var(--text-2);
        padding: 4px 9px;
        border-radius: 7px;
        background: linear-gradient(180deg,rgba(255,255,255,.06),rgba(255,255,255,.02));
        border: 1px solid var(--line-2)
    }

    .status-line {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-top: 13px
    }

        .status-line .lamp {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            flex-shrink: 0
        }

        .status-line.ok .lamp {
            background: var(--ok);
            box-shadow: 0 0 0 3px var(--ok-soft),0 0 10px var(--ok-glow)
        }

        .status-line.alert .lamp {
            background: var(--alert);
            box-shadow: 0 0 0 3px var(--alert-soft),0 0 10px var(--alert-glow);
            animation: soft-pulse 1.9s ease-in-out infinite
        }

        .status-line .txt {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase
        }

        .status-line.ok .txt {
            color: var(--ok)
        }

        .status-line.alert .txt {
            color: var(--alert)
        }

    .live-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 8.5px;
        font-weight: 700;
        letter-spacing: .09em;
        color: #86e6c4;
        background: var(--ok-soft);
        border: 1px solid var(--ok-line);
        padding: 2px 7px 2px 6px;
        border-radius: 20px
    }

        .live-chip .ld {
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--ok);
            animation: live-ping 1.8s ease-out infinite
        }

    @@keyframes live-ping {
        0% {
            box-shadow: 0 0 0 0 rgba(52,211,153,.55)
        }

        70%, 100% {
            box-shadow: 0 0 0 5px rgba(52,211,153,0)
        }
    }

    .status-line .badge {
        margin-left: auto;
        font-size: 10px;
        font-weight: 600;
        color: var(--text-3);
        padding: 3px 10px;
        border-radius: 20px;
        background: linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.02));
        border: 1px solid var(--line)
    }

    .card-nav {
        display: flex;
        padding: 0 16px;
        border-bottom: 1px solid var(--line)
    }

        .card-nav .seg {
            display: flex;
            width: 100%
        }

        .card-nav button {
            flex: 1;
            position: relative;
            background: transparent;
            border: none;
            padding: 12px 4px;
            cursor: pointer;
            color: var(--text-3);
            font-size: 10.5px;
            font-weight: 600;
            font-family: inherit;
            transition: color .18s;
            white-space: nowrap
        }

            .card-nav button:hover {
                color: var(--text-2)
            }

            .card-nav button.active {
                color: var(--text)
            }

                .card-nav button.active::after {
                    content: "";
                    position: absolute;
                    left: 10%;
                    right: 10%;
                    bottom: -1px;
                    height: 2px;
                    border-radius: 2px;
                    background: linear-gradient(90deg,var(--accent),var(--accent2));
                    box-shadow: 0 0 10px rgba(124,131,242,.65)
                }

    .station-card.has-alert .card-nav button.active::after {
        background: linear-gradient(90deg,#fb6f84,#fb9aa8);
        box-shadow: 0 0 10px var(--alert-glow)
    }

    .slide-viewport {
        position: relative;
        overflow: hidden;
        height: 280px;
        transition: height .35s cubic-bezier(.4,0,.2,1)
    }

    .slide-track {
        display: flex;
        align-items: flex-start;
        transition: transform .42s cubic-bezier(.4,0,.2,1)
    }

    .slide {
        min-width: 100%;
        padding: 16px 18px
    }

    .alert-info-box, .perf-card, .history-item {
        background: linear-gradient(180deg,rgba(255,255,255,.052),rgba(255,255,255,.018)) padding-box,linear-gradient(180deg,rgba(255,255,255,.13),rgba(255,255,255,.03)) border-box;
        border: 1px solid transparent;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.05)
    }

    .now-slide {
        display: flex;
        flex-direction: column;
        gap: 11px
    }

    .now-heading {
        font-size: 10px;
        font-weight: 700;
        color: var(--text-3);
        text-transform: uppercase;
        letter-spacing: .1em
    }

    .alert-info-box {
        border-radius: 12px;
        padding: 14px
    }

        .alert-info-box.failure-border {
            box-shadow: inset 0 1px 0 rgba(255,255,255,.05),inset 0 0 0 1px var(--alert-line),0 0 28px -16px var(--alert-glow)
        }

        .alert-info-box.predictive-border {
            box-shadow: inset 0 1px 0 rgba(255,255,255,.05),inset 0 0 0 1px rgba(122,162,247,.3)
        }

    .ab-top {
        display: flex;
        gap: 6px;
        align-items: center
    }

    .alert-type-badge {
        font-size: 9.5px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 6px;
        letter-spacing: .04em;
        text-transform: uppercase
    }

        .alert-type-badge.failure {
            background: linear-gradient(180deg,rgba(251,111,132,.24),rgba(251,111,132,.12));
            color: #ffb3c0;
            box-shadow: inset 0 0 0 1px rgba(251,111,132,.32),0 0 12px -4px var(--alert-glow)
        }

        .alert-type-badge.predictive {
            background: linear-gradient(180deg,rgba(122,162,247,.22),rgba(122,162,247,.1));
            color: #a8c2fc;
            box-shadow: inset 0 0 0 1px rgba(122,162,247,.3)
        }

    .alert-status-badge {
        font-size: 9.5px;
        font-weight: 600;
        padding: 3px 9px;
        border-radius: 6px;
        letter-spacing: .03em;
        text-transform: uppercase
    }

        .alert-status-badge.active-st {
            background: var(--ok-soft);
            color: #74e3bd;
            box-shadow: inset 0 0 0 1px var(--ok-line)
        }

        .alert-status-badge.cleared-st {
            background: rgba(255,255,255,.05);
            color: var(--text-3);
            box-shadow: inset 0 0 0 1px var(--line)
        }

    .alert-asset-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 12px 0 5px
    }

    .alert-asset {
        color: var(--text);
        font-size: 14px;
        font-weight: 640;
        letter-spacing: -.01em
    }

    .alert-cause {
        color: #f8c970;
        font-size: 10.5px;
        font-family: var(--mono);
        background: var(--warn-soft);
        display: inline-block;
        padding: 3px 8px;
        border-radius: 5px;
        margin-bottom: 11px;
        box-shadow: inset 0 0 0 1px var(--warn-line)
    }

    .alert-msg {
        color: var(--text-3);
        font-size: 9.5px;
        line-height: 1.4;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden
    }

    .alert-meta {
        display: flex;
        gap: 16px;
        color: var(--text-3);
        font-size: 10.5px;
        font-family: var(--mono)
    }

        .alert-meta .dur {
            color: #f8c970
        }

    .alert-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: var(--ok);
        font-size: 11px;
        font-weight: 600;
        min-height: 120px
    }

    .timeline-title {
        font-size: 10px;
        font-weight: 700;
        color: var(--text-3);
        margin-bottom: 13px;
        text-transform: uppercase;
        letter-spacing: .1em
    }

    .timeline {
        position: relative;
        padding-left: 15px
    }

    .timeline-line {
        position: absolute;
        left: 4px;
        top: 4px;
        bottom: 4px;
        width: 1.5px;
        background: linear-gradient(180deg,var(--line-3),transparent)
    }

    .timeline-item {
        position: relative;
        margin-bottom: 14px;
        padding-left: 14px
    }

        .timeline-item:last-child {
            margin-bottom: 0
        }

    .timeline-dot {
        position: absolute;
        left: -12px;
        top: 4px;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        border: 2px solid #141a28
    }

        .timeline-dot.failure {
            background: var(--alert);
            box-shadow: 0 0 8px -1px var(--alert-glow)
        }

        .timeline-dot.predictive {
            background: var(--pred);
            box-shadow: 0 0 8px -1px rgba(122,162,247,.6)
        }

    .timeline-head {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 3px;
        flex-wrap: wrap
    }

    .timeline-type {
        font-size: 9.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em
    }

        .timeline-type.failure {
            color: #ffb3c0
        }

        .timeline-type.predictive {
            color: #a8c2fc
        }

    .timeline-time {
        font-size: 10px;
        color: var(--text-4);
        font-family: var(--mono)
    }

    .timeline-st {
        font-size: 8.5px;
        padding: 1px 6px;
        border-radius: 4px;
        margin-left: auto;
        font-weight: 600;
        text-transform: uppercase
    }

        .timeline-st.active-st {
            background: var(--ok-soft);
            color: #74e3bd
        }

        .timeline-st.cleared-st {
            background: rgba(255,255,255,.05);
            color: var(--text-3)
        }

    .timeline-asset {
        color: var(--text-2);
        font-size: 11.5px;
        font-weight: 540
    }

    .timeline-cause {
        color: #e0aa58;
        font-size: 10px;
        font-family: var(--mono);
        opacity: .9;
        margin-top: 1px
    }

    .perf-slide {
        display: flex;
        flex-direction: column;
        gap: 12px
    }

    .perf-heading {
        font-size: 10px;
        font-weight: 700;
        color: var(--text-3);
        text-transform: uppercase;
        letter-spacing: .1em
    }

    .perf-card {
        border-radius: 12px;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 14px
    }

    .perf-ring-wrap {
        position: relative;
        width: 48px;
        height: 48px;
        flex-shrink: 0
    }

    .perf-ring-bg {
        fill: none;
        stroke: var(--line-3);
        stroke-width: 4
    }

    .perf-ring-fill {
        fill: none;
        stroke-width: 4;
        stroke-linecap: round;
        transition: stroke-dashoffset 1.2s;
        filter: drop-shadow(0 0 4px currentColor)
    }

    .perf-ring-val {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 730
    }

    .perf-detail {
        flex: 1;
        min-width: 0
    }

    .perf-label {
        font-size: 11px;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 7px
    }

    .perf-bar-track {
        height: 6px;
        background: var(--surface-3);
        border-radius: 3px;
        overflow: hidden
    }

    .perf-bar-fill {
        height: 100%;
        border-radius: 3px;
        transition: width 1.2s
    }

        .perf-bar-fill.failure-bar {
            background: linear-gradient(90deg,#e5566d,#fb6f84);
            box-shadow: 0 0 10px -2px var(--alert-glow)
        }

        .perf-bar-fill.predictive-bar {
            background: linear-gradient(90deg,#5d86e8,#7aa2f7);
            box-shadow: 0 0 10px -2px rgba(122,162,247,.6)
        }

        .perf-bar-fill.coverage-bar {
            background: linear-gradient(90deg,#1faf80,#34d399);
            box-shadow: 0 0 10px -2px var(--ok-glow)
        }

    .perf-sub {
        display: flex;
        justify-content: space-between;
        margin-top: 5px;
        font-size: 9px;
        color: var(--text-4)
    }

    .history-title {
        font-size: 10px;
        font-weight: 700;
        color: var(--text-3);
        margin-bottom: 13px;
        text-transform: uppercase;
        letter-spacing: .1em
    }

    .history-item {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 9px 11px;
        margin-bottom: 7px;
        border-radius: 10px
    }

        .history-item:last-child {
            margin-bottom: 0
        }

    .history-avatar {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: linear-gradient(140deg,rgba(124,131,242,.3),rgba(124,131,242,.12));
        border: 1px solid rgba(124,131,242,.28);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #c3cbfb;
        font-size: 11px;
        font-weight: 600;
        flex-shrink: 0
    }

    .history-info {
        flex: 1;
        min-width: 0
    }

    .history-user {
        color: var(--text);
        font-size: 11.5px;
        font-weight: 600
    }

    .history-action {
        color: var(--text-3);
        font-size: 10.5px;
        margin-top: 1px
    }

    .history-time {
        color: var(--text-4);
        font-size: 9.5px;
        flex-shrink: 0;
        text-align: right;
        line-height: 1.4;
        font-family: var(--mono)
    }

    .health-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--text-4);
        font-size: 11px;
        font-weight: 600;
        min-height: 120px
    }
</style>
<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />
<div class="grid" id="station-grid">
    @if (Model.mSites != null && Model.mSites.Count > 0)
    {
        var idx = 0; foreach (var item in Model.mSites)
        {
            var siteCode = item.Name != null && item.Name.Length >= 4 ? item.Name.Substring(0, 4).ToUpper() : (item.Name ?? "").ToUpper();
            <div class="station-card enter" id="divSite_@item.Id" data-siteid="@item.Id" data-sitename="@item.Name" style="animation-delay:@(idx*0.09)s">
                <div class="card-head">
                    <div class="ch-top">
                        <div class="ch-id">
                            <div class="ch-mark"><svg viewBox="0 0 24 24"><circle cx="12" cy="8.5" r="1.8" /><path d="M12 10.3V20" /><path d="M9 20l3-3 3 3" /><path d="M8.4 5.6a4.6 4.6 0 000 6M15.6 5.6a4.6 4.6 0 010 6" /></svg></div>
                            <div><div class="ch-name">@item.Name</div><div class="ch-sub">RDPMS · E7FRS</div></div>
                        </div>
                        <div class="ch-right"><div class="ch-code">@siteCode</div></div>
                    </div>
                    <div class="status-line ok" id="statusLine_@item.Id">
                        <span class="lamp"></span>
                        <span class="txt" id="statusTxt_@item.Id">Operational</span>
                        <span class="live-chip"><span class="ld"></span>LIVE</span>
                        <span class="badge" id="statusBadge_@item.Id">All clear</span>
                    </div>
                </div>
                <div class="card-nav">
                    <div class="seg">
                        <button type="button" class="active" data-idx="0">Now</button>
                        <button type="button" data-idx="1">Timeline</button>
                        <button type="button" data-idx="2">Performance</button>
                        <button type="button" data-idx="3">Users</button>
                        <button type="button" data-idx="4">Health</button>
                    </div>
                </div>
                <div class="slide-viewport">
                    <div class="slide-track">
                        <div class="slide"><div class="now-slide" id="nowSlide_@item.Id"><div class="now-heading" id="nowHeading_@item.Id">Last Event</div><div id="nowContent_@item.Id"><div class="alert-empty"><span style="font-size:22px">✓</span><span>No alerts received</span></div></div></div></div>
                        <div class="slide"><div id="timelineContent_@item.Id"><div class="alert-empty"><span>Loading timeline…</span></div></div></div>
                        <div class="slide"><div id="performanceContent_@item.Id"><div class="alert-empty"><span>Loading performance…</span></div></div></div>
                        <div class="slide"><div id="usersContent_@item.Id"><div class="alert-empty"><span>Loading users…</span></div></div></div>
                        <div class="slide"><div class="health-empty">Health monitoring — coming soon</div></div>
                    </div>
                </div>
            </div>
            idx++;
        }
    }
</div>
@{var serializer = new System.Web.Script.Serialization.JavaScriptSerializer(); serializer.MaxJsonLength = Int32.MaxValue;}
<script>
var json=@Html.Raw(serializer.Serialize(Model));
var dataInterval=parseFloat('@Model.HooterSetting.DataInterval')||30000;

// ===== Tab nav (manual only, no auto-cycling, dynamic height) =====
function setCardHeight(card){var vp=card.querySelector('.slide-viewport'),track=card.querySelector('.slide-track');if(!vp||!track)return;var sl=track.children[card._cur||0];if(sl)vp.style.height=sl.offsetHeight+'px';}
function fitAllCards(){document.querySelectorAll('.station-card').forEach(setCardHeight);}

$(document).ready(function(){
  if($('#hdnCatListType').val()=='Error'){if($('#hdnCatListMessage').val()=='Forbidden!')window.location.href='/Login/Index';}

  // Tab navigation — manual only, pause on hover
  $('.station-card').each(function(){
    var card=this,track=$(card).find('.slide-track')[0],btns=card.querySelectorAll('.card-nav button');
    card._cur=0;
    function goTo(i){card._cur=i;track.style.transform='translateX(-'+i*100+'%)';btns.forEach(function(b,j){b.classList.toggle('active',j===i);});setCardHeight(card);}
    btns.forEach(function(b){b.addEventListener('click',function(){goTo(parseInt(b.dataset.idx));});});
    goTo(0);
    // Load slide data
    var siteId=$(card).data('siteid');
    fnLoadSlideData(siteId);
  });

  fitAllCards();setTimeout(fitAllCards,300);
  $(window).on('resize',fitAllCards);

  updateSummaryCards();
  fnAllSiteCheckChannelDown();
  setInterval(fnAllSiteCheckChannelDown,dataInterval);
});

// ===== Render Now Slide =====
function renderNowSlide(siteId){
  var store=(window.wsAlertStore&&window.wsAlertStore[siteId])?window.wsAlertStore[siteId]:[];
  var $c=$('#nowContent_'+siteId),$h=$('#nowHeading_'+siteId);
  var active=null;for(var i=0;i<store.length;i++){if(store[i].Status==='Active'){active=store[i];break;}}
  var a=active||store[0];
  if(!a){$h.text('Last Event');$c.html('<div class="alert-empty"><span style="font-size:22px">✓</span><span>No alerts received</span></div>');return;}
  var isA=(a.Status==='Active'),isF=(a.AlertType==='Failure');
  $h.text(isA?'Active Alert':'Last Event');
  var ts='';if(a.Time||a.TimestampDevice){var d=new Date(a.TimestampDevice||a.Time);if(!isNaN(d))ts=('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':'+('0'+d.getSeconds()).slice(-2);}
  var dur='';if(isA&&a.Time){var ms=Date.now()-new Date(a.Time).getTime();if(ms>0){var hh=Math.floor(ms/36e5),mm=Math.floor(ms%36e5/6e4),ss=Math.floor(ms%6e4/1e3);dur=('0'+hh).slice(-2)+':'+('0'+mm).slice(-2)+':'+('0'+ss).slice(-2);}}
  var cnt=0;for(var j=0;j<store.length;j++)if(store[j].Status==='Active')cnt++;
  $('#statusBadge_'+siteId).text(cnt>0?cnt+' active':'All clear');
  var msg=a.Message||'';
  $c.html('<div class="alert-info-box '+(isF?'failure-border':'predictive-border')+'">'+
    '<div class="ab-top"><span class="alert-type-badge '+(isF?'failure':'predictive')+'">'+a.AlertType+'</span><span class="alert-status-badge '+(isA?'active-st':'cleared-st')+'">'+(isA?'Active':'Cleared')+'</span></div>'+
    '<div class="alert-asset-row"><div class="alert-asset">'+a.AssetName+'</div></div>'+
    (msg?'<div class="alert-msg">'+msg+'</div>':'')+
    '<div class="alert-cause">'+a.CauseCode+'</div>'+
    '<div class="alert-meta"><span>Started '+ts+'</span>'+(dur?'<span class="dur">Duration '+dur+'</span>':'')+'</div></div>');
  setTimeout(fitAllCards,50);
}

// ===== Render Timeline =====
function renderTimelineSlide(siteId,alerts){
  var $c=$('#timelineContent_'+siteId);
  if(!alerts||!alerts.length){$c.html('<div class="alert-empty"><span>No timeline data</span></div>');return;}
  var items='';$.each(alerts,function(i,a){var isF=(a.AlertType==='Failure'||a.AlertTypeId===1),cls=isF?'failure':'predictive',st=a.Status||(a.ResetTimeStamp?'Cleared':'Active');
    var time='',date='',ts=a.Time||a.TimestampDevice||a.SetTimeStamp;if(ts){var d=new Date(ts);if(!isNaN(d)){time=('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);date=('0'+d.getDate()).slice(-2)+' '+['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()];}}
    items+='<div class="timeline-item"><div class="timeline-dot '+cls+'"></div><div class="timeline-head"><span class="timeline-type '+cls+'">'+(isF?'Failure':'Predictive')+'</span><span class="timeline-time">'+time+' · '+date+'</span><span class="timeline-st '+(st==='Active'?'active-st':'cleared-st')+'">'+st+'</span></div><div class="timeline-asset">'+(a.AssetName||'')+'</div><div class="timeline-cause">'+(a.CauseCode||a.PossibleCause||'')+'</div></div>';
  });
  $c.html('<div class="timeline-title">Alert Timeline</div><div class="timeline"><div class="timeline-line"></div>'+items+'</div>');setTimeout(fitAllCards,50);
}

// ===== Render Performance =====
function perfRingSVG(v,color){var r=17,c=2*Math.PI*r,off=c-(c*v/100);return '<svg viewBox="0 0 44 44" width="44" height="44" style="transform:rotate(-90deg)"><circle cx="22" cy="22" r="'+r+'" class="perf-ring-bg"/><circle cx="22" cy="22" r="'+r+'" class="perf-ring-fill" stroke="'+color+'" stroke-dasharray="'+c+'" stroke-dashoffset="'+off+'"/></svg>';}
function renderPerformanceSlide(siteId,perf){
  var $c=$('#performanceContent_'+siteId);if(!perf){$c.html('<div class="alert-empty"><span>No performance data</span></div>');return;}
  var m=[{l:'Failure Alert Accuracy',d:'(True+Partial) / Total Failure',v:perf.FailureAccuracy||0,c:'#f87171',b:'failure-bar'},{l:'Predictive Alert Accuracy',d:'(True+Partial) / Total Predictive',v:perf.PredictiveAccuracy||0,c:'#a78bfa',b:'predictive-bar'},{l:'RDPMS Failure Coverage',d:'RDPMS Alerts / Actual Failures',v:perf.RdpmsCoverage||0,c:'#34d399',b:'coverage-bar'}];
  var html='<div class="perf-slide"><div class="perf-heading">Performance</div>';
  $.each(m,function(i,x){html+='<div class="perf-card"><div class="perf-ring-wrap">'+perfRingSVG(x.v,x.c)+'<div class="perf-ring-val" style="color:'+x.c+'">'+Math.round(x.v)+'%</div></div><div class="perf-detail"><div class="perf-label">'+x.l+'</div><div class="perf-bar-track"><div class="perf-bar-fill '+x.b+'" style="width:'+x.v+'%"></div></div><div class="perf-sub"><span>'+x.d+'</span></div></div></div>';});
  $c.html(html+'</div>');setTimeout(fitAllCards,50);
}

// ===== Render Users =====
function renderUsersSlide(siteId,users){
  var $c=$('#usersContent_'+siteId);if(!users||!users.length){$c.html('<div class="alert-empty"><span>No user data</span></div>');return;}
  var items='';$.each(users,function(i,h){var nm=h.UserName||h.Name||'User',parts=nm.trim().split(' '),ini=parts.length>=2?parts[0][0]+parts[parts.length-1][0]:nm.substring(0,2);ini=ini.toUpperCase();var dur=h.Duration||0;
    items+='<div class="history-item"><div class="history-avatar">'+ini+'</div><div class="history-info"><div class="history-user">'+nm+'</div><div class="history-action">Total: '+dur+' min</div></div><div class="history-time">'+dur+' min</div></div>';
  });$c.html('<div class="history-title">User History</div>'+items);setTimeout(fitAllCards,50);
}

// ===== Load slide data =====
function fnLoadSlideData(siteId){
  $.ajax({url:'/FRS25/UserSite/GetTimelineAlerts',type:'Post',data:{siteId:siteId},success:function(d){renderTimelineSlide(siteId,d);}});
  $.ajax({url:'/FRS25/UserSite/GetPerformanceData',type:'Post',data:{siteId:siteId},success:function(d){renderPerformanceSlide(siteId,d);}});
  $.ajax({url:'/FRS25/UserSite/GetUserHistoryData',type:'Post',data:{siteId:siteId},success:function(d){renderUsersSlide(siteId,d);}});
}

// ===== Summary Cards =====
function updateSummaryCards(){
  var tot=0,sirens=0;$('.station-card').each(function(){if($(this).hasClass('has-alert'))sirens++;});
  if(json&&json.mSites)$.each(json.mSites,function(i,s){tot+=(s.TrackCount||0)+(s.PointMachineCount||0)+(s.SignalCount||0);});
  $('#summary-cards').html(
    '<div class="summary-card failure"><div class="sc-meta"><div class="num">'+tot+'</div><div class="lbl">Total Alerts</div></div></div>'+
    '<div class="summary-card predictive"><div class="sc-meta"><div class="num">'+document.querySelectorAll('.station-card').length+'</div><div class="lbl">Sites</div></div></div>'+
    '<div class="summary-card sc-active"><div class="sc-meta"><div class="num">'+sirens+'</div><div class="lbl">Active Sirens</div></div></div>');
}

// ===== Set card alert state =====
function setCardAlert(siteId,isAlert){
  var $card=$('#divSite_'+siteId),$sl=$('#statusLine_'+siteId);
  if(isAlert){$card.addClass('has-alert');$sl.removeClass('ok').addClass('alert');$('#statusTxt_'+siteId).text('Alert Active');renderNowSlide(siteId);
  }else{$card.removeClass('has-alert');$sl.removeClass('alert').addClass('ok');$('#statusTxt_'+siteId).text('Operational');$('#statusBadge_'+siteId).text('All clear');renderNowSlide(siteId);}
}

// ===== Polling =====
var _isPolling=false;
function fnAllSiteCheckChannelDown(){
  if(_isPolling)return;_isPolling=true;
  var siteIds=[];if(json&&json.mSites)$.each(json.mSites,function(i,s){siteIds.push(s.Id);});
  $.ajax({url:'/FRS25/UserSite/GetSMSLogList',type:'Post',data:JSON.stringify(siteIds),contentType:'application/json',
    success:function(smsSiteIds){$('#loader').hide();var hasNew=false;
      $('.station-card').each(function(){var sid=$(this).data('siteid'),was=$(this).hasClass('has-alert'),now=smsSiteIds&&smsSiteIds.indexOf(sid)>-1;
        var wsA=false;if(window.wsAlertStore&&window.wsAlertStore[sid])for(var k=0;k<window.wsAlertStore[sid].length;k++)if(window.wsAlertStore[sid][k].Status==='Active'){wsA=true;break;}
        if((now||wsA)&&!was){setCardAlert(sid,true);hasNew=true;}else if(!now&&!wsA&&was){setCardAlert(sid,false);}
      });
      if(smsSiteIds&&smsSiteIds.length>0)$.each(smsSiteIds,function(i,sid){$('#statusBadge_'+sid).text(smsSiteIds.length+' active');});
      if(hasNew&&typeof playSoundCooldown==='function'&&soundOn)playSoundCooldown();
      updateSummaryCards();
    },error:function(){$('#loader').hide();},complete:function(){_isPolling=false;}});
}
</script>
