@model Domain.SiteLister

@{
    var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    serializer.MaxJsonLength = Int32.MaxValue;
}

<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />

<!-- ============================
     HIDDEN SITE DATA (JS reads this)
     ============================ -->
@if (Model.mSites != null && Model.mSites.Count > 0)
{
    foreach (var item in Model.mSites)
    {
        <input type="hidden" class="hdnSiteData"
               data-id="@item.Id"
               data-name="@item.Name"
               data-track="@item.TrackCount"
               data-pm="@item.PointMachineCount"
               data-signal="@item.SignalCount"
               data-datalogger="@(item.IsDatalogger ? "true" : "false")"
               data-sipview="@(item.IsSipView ? "true" : "false")" />
    }
}

<!-- ============ SIREN STAGE ============ -->
<div class="sc-siren-stage sc-bg-safe" id="divSirenStage">

    <!-- Nav arrows -->
    <button class="sc-nav-arrow sc-left" id="btnPrevSite" onclick="fnSliderNav(-1)" style="display:none;">
        <i class="fa fa-chevron-left"></i>
    </button>
    <button class="sc-nav-arrow sc-right" id="btnNextSite" onclick="fnSliderNav(1)" style="display:none;">
        <i class="fa fa-chevron-right"></i>
    </button>

    <!-- SIREN + SITE INFO (JS renders here) -->
    <div id="divSirenContent"></div>

    <!-- SLIDE COUNTER  e.g. 2 / 6 -->
    <div class="sc-slide-counter" id="divSlideCounter" style="display:none;"></div>

    <!-- DOT INDICATORS -->
    <div class="sc-dots" id="divDotIndicators" style="display:none;"></div>

    <!-- SITE NAME STRIP -->
    <div class="sc-site-strip" id="divSiteStrip" style="display:none;"></div>
</div>

<!-- ============ ALERT DETAIL PANEL (only visible when current site has alerts) ============ -->
<div class="sc-alert-panel" id="divAlertPanel" style="display:none;">
    <div class="sc-alert-panel-head">
        <h3 class="sc-alert-panel-title">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="flex-shrink:0;">
                <path d="M8 1L15 14H1L8 1Z" stroke="#fbbf24" stroke-width="1.5" stroke-linejoin="round" />
                <line x1="8" y1="6" x2="8" y2="9.5" stroke="#fbbf24" stroke-width="1.5" stroke-linecap="round" />
                <circle cx="8" cy="11.5" r="0.75" fill="#fbbf24" />
            </svg>
            Active Alerts — <span id="spnAlertPanelSiteName"></span>
        </h3>
        <span class="sc-alert-count-badge" id="spnAlertPanelCount">0 alerts</span>
    </div>
    <div class="sc-alert-list" id="divAlertList"></div>
</div>

<!-- ============ NO-ALERT INFO PANEL (visible when current site is clear) ============ -->
<div class="sc-alert-panel" id="divNoAlertPanel" style="display:none;">
    <div class="sc-no-alerts-panel">
        <i class="fa fa-check-circle"></i>
        <div><strong id="spnNoAlertSiteName"></strong> — No active alerts</div>
        <div style="margin-top:4px; color:#475569;">This site is operating normally. Alerts will appear here when detected.</div>
    </div>
</div>

<!-- ============ SMS LOG MODAL ============ -->
<div class="modal fade bd-example-modal-lg" id="modal-add-smslogs" tabindex="-1" role="dialog"
     aria-labelledby="modal-add-smslogs" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-xl modal-width modal-dialog-centered">
        <div class="modal-content bradius4">
            <div class="modal-header">
                <h4 class="modal-title isEdit" id="myModalLabel"><span>Alert Logs</span></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-hidden="true"></button>
            </div>
            <div class="modal-body">
                <div class="form-horizontal">
                    <div class="row">
                        <div class="col-12">
                            <div class="tab-content mt-4">
                                @{
                                    var mFRSAlerts = new List<Domain.FRSAlert>();
                                    if (ViewBag.OldFRSAlerts != null)
                                    {
                                        mFRSAlerts = ViewBag.OldFRSAlerts as List<Domain.FRSAlert>;
                                    }
                                }
                                <div class="col-sm-12">
                                    <table class="table">
                                        <thead>
                                            <tr>
                                                <th>Alert Type</th>
                                                <th>Asset Type</th>
                                                <th>Asset</th>
                                                <th>Cause Code</th>
                                                <th>Message</th>
                                                <th>Time</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodySMSLogs">
                                            @if (mFRSAlerts != null && mFRSAlerts.Count > 0)
                                            {
                                                foreach (var frsalert in mFRSAlerts.OrderByDescending(x => x.SetTimeStamp))
                                                {
                                                    <tr>
                                                        <td>
                                                            @if (frsalert.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure)
                                                            {<span>@E7FRSAdvance.Utility.Utility.AlertType.Failure.ToString()</span> }
                                                        else if (frsalert.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive)
                                                        { <span>@E7FRSAdvance.Utility.Utility.AlertType.Predictive.ToString()</span>}
                                                        </td>
                                                        <td>@frsalert.AssetType</td>
                                                        <td>@frsalert.AssetName</td>
                                                        <td>@frsalert.CauseCode</td>
                                                        <td>@frsalert.SetAlertMessage</td>
                                                        <td>@frsalert.SetTimeStamp</td>
                                                        <td>
                                                            <button type="button" class="btn btn-warning"
                                                                    onclick="fnGetAssetAttribute(fnGetSiteName(@frsalert.SiteId),'@frsalert.AssetId','@frsalert.AssetTypeId')">
                                                                Real Time Data
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <a class="btn btn-default" data-bs-dismiss="modal" id="btnClose">Close</a>
            </div>
        </div>
    </div>
</div>


<script>
    /* ===================================================
       SIREN COMMAND — ALL-SITE SLIDER + LIVE ALERTS
       =================================================== */

    // ── Build site registry from server-rendered hidden inputs ──
    var allSiteIds = [];      // ordered list of ALL site IDs
    var siteRegistry = {};    // { siteId: { Id, Name, TrackCount, ... } }

    $('.hdnSiteData').each(function () {
        var $el = $(this);
        var id = parseInt($el.data('id'));
        allSiteIds.push(id);
        siteRegistry[id] = {
            Id:                id,
            Name:              $el.data('name'),
            TrackCount:        parseInt($el.data('track')) || 0,
            PointMachineCount: parseInt($el.data('pm')) || 0,
            SignalCount:       parseInt($el.data('signal')) || 0,
            IsDatalogger:      $el.data('datalogger') === 'true',
            IsSipView:         $el.data('sipview') === 'true'
        };
    });

    // ── Alert state ──
    var activeAlerts = {};        // { siteId: [ alertObj, ... ] }
    var currentSliderIndex = 0;   // index into allSiteIds[]

    // ── Init ──
    $(document).ready(function () {
        if ($('#hdnCatListType').val() == 'Success') {
            CommonNotification($("#hdnCatListType").val().toUpperCase(), $("#hdnCatListMessage").val(), $("#hdnCatListType").val());
        } else if ($('#hdnCatListType').val() == 'Error') {
            if ($('#hdnCatListMessage').val() == 'Forbidden!') {
                window.location.href = "/Login/Index";
            } else {
                CommonNotification($("#hdnCatListType").val().toUpperCase(), $("#hdnCatListMessage").val(), $("#hdnCatListType").val());
            }
        }

        fnRenderView();
        fnConnectAlertSocket();

        // Swipe support
        var touchStartX = null;
        $('#divSirenStage').on('touchstart', function (e) {
            touchStartX = e.originalEvent.touches[0].clientX;
        }).on('touchend', function (e) {
            if (touchStartX === null) return;
            var diff = e.originalEvent.changedTouches[0].clientX - touchStartX;
            if (Math.abs(diff) > 50) fnSliderNav(diff < 0 ? 1 : -1);
            touchStartX = null;
        });

        // Keyboard arrows
        $(document).on('keydown', function (e) {
            if (e.key === 'ArrowLeft')  fnSliderNav(-1);
            if (e.key === 'ArrowRight') fnSliderNav(1);
        });
    });


    // ══════════════════════════════════
    //  WEBSOCKET
    // ══════════════════════════════════
    var alertSocket = null;

    function fnConnectAlertSocket() {
        try {
            alertSocket = new WebSocket('ws://proxy.energy7.org:8081/subscribe/alertEvents');

            alertSocket.onopen = function () { console.log('Alert WebSocket connected'); };

            alertSocket.onmessage = function (evt) { fnHandleAlertBatch(evt.data); };

            alertSocket.onclose = function () {
                console.warn('Alert WebSocket closed. Reconnecting in 5s...');
                setTimeout(fnConnectAlertSocket, 5000);
            };

            alertSocket.onerror = function (err) {
                console.error('Alert WebSocket error', err);
                try { alertSocket.close(); } catch (e) { }
            };
        } catch (e) {
            console.error('WebSocket connect failed', e);
            setTimeout(fnConnectAlertSocket, 5000);
        }
    }

    function fnHandleAlertBatch(raw) {
        var batch;
        try { batch = JSON.parse(raw); }
        catch (e) { console.error('Bad batch payload', e); return; }

        if (!batch || batch.Topic !== 'alertEvents' || !batch.Messages) return;

        var newAlertReceived = false;

        $.each(batch.Messages, function (idx, msgStr) {
            var alert;
            try { alert = JSON.parse(msgStr); }
            catch (e) { console.error('Bad message JSON', e); return; }

            var siteId = alert.SiteId;
            var action = (alert.AlertAction || '').toUpperCase();

            // Skip sites not in our registry
            if (!siteRegistry[siteId]) return;

            if (action === 'SET') {
                fnAddAlert(siteId, alert);
                newAlertReceived = true;
            } else if (action === 'RESET') {
                fnRemoveAlert(siteId, alert);
            }
        });

        // Play sound
        if (newAlertReceived && '@Model.HooterSetting.AlertSound' == 'True') {
            var myaudio = document.getElementById("alarm-ring");
            var audioDuration = parseInt('@Model.HooterSetting.AudioDuration');
            fnLoadAudio(myaudio, audioDuration, '@Model.HooterSetting.ReminderFrequency');
        }
    }

    function fnAddAlert(siteId, alert) {
        if (!activeAlerts[siteId]) activeAlerts[siteId] = [];

        var key = alert.AssetId + '|' + alert.CauseCode;
        var exists = activeAlerts[siteId].some(function (a) {
            return (a.AssetId + '|' + a.CauseCode) === key;
        });
        if (!exists) {
            alert._key = key;
            alert._ts = new Date().toLocaleString();
            activeAlerts[siteId].push(alert);
        }
        fnRenderView();
    }

    function fnRemoveAlert(siteId, alert) {
        if (!activeAlerts[siteId]) return;

        var key = alert.AssetId + '|' + alert.CauseCode;
        activeAlerts[siteId] = activeAlerts[siteId].filter(function (a) {
            return (a.AssetId + '|' + a.CauseCode) !== key;
        });

        if (activeAlerts[siteId].length === 0) {
            delete activeAlerts[siteId];
        }
        fnRenderView();
    }

    // Helper: count how many sites currently have alerts
    function fnAlertSiteCount() {
        var count = 0;
        for (var sid in activeAlerts) {
            if (activeAlerts[sid] && activeAlerts[sid].length > 0) count++;
        }
        return count;
    }

    // Helper: total alert count
    function fnTotalAlertCount() {
        var count = 0;
        for (var sid in activeAlerts) { count += activeAlerts[sid].length; }
        return count;
    }

    // Helper: does this site have alerts?
    function fnSiteHasAlert(siteId) {
        return activeAlerts[siteId] && activeAlerts[siteId].length > 0;
    }


    // ══════════════════════════════════
    //  SLIDER NAVIGATION
    // ══════════════════════════════════
    function fnSliderNav(dir) {
        if (allSiteIds.length <= 1) return;

        var newIdx = currentSliderIndex + dir;
        // Wrap around
        if (newIdx < 0) newIdx = allSiteIds.length - 1;
        if (newIdx >= allSiteIds.length) newIdx = 0;

        // Fade out → switch → fade in
        var $content = $('#divSirenContent');
        $content.css({ opacity: 0, transition: 'opacity 0.15s' });

        setTimeout(function () {
            currentSliderIndex = newIdx;
            fnRenderView();
            $content.css({ opacity: 1 });
        }, 160);
    }

    function fnJumpToSite(idx) {
        if (idx === currentSliderIndex) return;
        var $content = $('#divSirenContent');
        $content.css({ opacity: 0, transition: 'opacity 0.15s' });
        setTimeout(function () {
            currentSliderIndex = idx;
            fnRenderView();
            $content.css({ opacity: 1 });
        }, 160);
    }


    // ══════════════════════════════════
    //  RENDER — MAIN VIEW BUILDER
    // ══════════════════════════════════
    function fnRenderView() {
        var $stage   = $('#divSirenStage');
        var $content = $('#divSirenContent');
        var $dots    = $('#divDotIndicators');
        var $strip   = $('#divSiteStrip');
        var $counter = $('#divSlideCounter');
        var $alertPanel   = $('#divAlertPanel');
        var $noAlertPanel = $('#divNoAlertPanel');
        var $alertList    = $('#divAlertList');

        var totalSites     = allSiteIds.length;
        var alertingSites  = fnAlertSiteCount();
        var totalAlerts    = fnTotalAlertCount();

        // ── Update header stats ──
        $('#spnAlertSiteCount').text(alertingSites + ' Active Site' + (alertingSites !== 1 ? 's' : ''));
        $('#spnTotalAlertCount').text(totalAlerts + ' Alert' + (totalAlerts !== 1 ? 's' : ''));
        $('#spnTotalSiteCount').text(totalSites + ' Total Site' + (totalSites !== 1 ? 's' : ''));

        if (alertingSites > 0) {
            $('#spnHeaderDot').removeClass('sc-dot-safe').addClass('sc-dot-live');
        } else {
            $('#spnHeaderDot').removeClass('sc-dot-live').addClass('sc-dot-safe');
        }

        // ── No sites at all ──
        if (totalSites === 0) {
            $content.html('<div class="sc-no-alerts-panel"><i class="fa fa-database"></i><div>No sites found. Adjust your Zone / Division filter.</div></div>');
            $('#btnPrevSite, #btnNextSite').hide();
            $dots.hide(); $strip.hide(); $counter.hide();
            $alertPanel.hide(); $noAlertPanel.hide();
            return;
        }

        // ── Current site ──
        var safeIdx = Math.min(currentSliderIndex, totalSites - 1);
        if (safeIdx < 0) safeIdx = 0;
        currentSliderIndex = safeIdx;

        var siteId    = allSiteIds[safeIdx];
        var site      = siteRegistry[siteId];
        var hasAlert  = fnSiteHasAlert(siteId);
        var siteAlerts = hasAlert ? activeAlerts[siteId] : [];

        if (!site) return;

        // Stage background
        $stage.toggleClass('sc-bg-alert', hasAlert).toggleClass('sc-bg-safe', !hasAlert);

        // ── Show/hide arrows ──
        if (totalSites > 1) {
            $('#btnPrevSite, #btnNextSite').show();
        } else {
            $('#btnPrevSite, #btnNextSite').hide();
        }

        // ══════════════════════
        //  SIREN CONTENT
        // ══════════════════════
        var html = '';

        // Siren image
        if (hasAlert) {
            html += '<div class="sc-siren-display sc-alert-glow" onclick="fnShowSMSLog(' + siteId + ')">';
            html += '<img src="/assets/images/gifDangerAlarm.gif" height="130" width="130" />';
            html += '</div>';
        } else {
            html += '<div class="sc-siren-display sc-safe-glow">';
            html += '<img src="/assets/images/imgGreen.png" height="130" width="130" />';
            html += '</div>';
        }

        // Site name
        var nameClass = hasAlert ? 'sc-name-alert' : 'sc-name-safe';
        html += '<h2 class="sc-site-name ' + nameClass + '">' + site.Name + '</h2>';

        // Status tag
        if (hasAlert) {
            html += '<span class="sc-status-tag sc-tag-alert"><span class="sc-dot-live"></span> ' + siteAlerts.length + ' Alert' + (siteAlerts.length !== 1 ? 's' : '') + ' Active</span>';
        } else {
            html += '<span class="sc-status-tag sc-tag-safe"><span class="sc-dot-safe"></span> System Normal</span>';
        }

        // Asset badges
        var badgeClass = hasAlert ? 'sc-badge-red' : 'sc-badge-green';
        html += '<div class="sc-asset-badges">';
        if (site.TrackCount > 0) {
            html += '<span class="sc-asset-badge ' + badgeClass + '" onclick="fnGetSiteSummaryView(\'' + site.Name + '\',\'' + @E7FRSAdvance.Utility.Utility.AssetType.TRACK.GetHashCode() + '\')">T: ' + site.TrackCount + '</span>';
        }
        if (site.PointMachineCount > 0) {
            html += '<span class="sc-asset-badge ' + badgeClass + '" onclick="fnGetSiteSummaryView(\'' + site.Name + '\',\'' + @E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode() + '\')">P: ' + site.PointMachineCount + '</span>';
        }
        if (site.SignalCount > 0) {
            html += '<span class="sc-asset-badge ' + badgeClass + '" onclick="fnGetSiteSummaryView(\'' + site.Name + '\',\'' + @E7FRSAdvance.Utility.Utility.AssetType.SIGNAL.GetHashCode() + '\')">S: ' + site.SignalCount + '</span>';
        }
        html += '</div>';

        // Site action buttons
        html += '<div class="sc-site-actions">';
        html += '<a class="btn" href="/FRS25/Alerts/Index">View Alerts</a>';
        html += '<a class="btn" href="/FRS25/UserSite/Summary?siteId=' + siteId + '">Probability</a>';
        html += '<a class="btn" href="/FRS25/UserSite/UserHistory?siteId=' + siteId + '">User History</a>';
        html += '<button class="btn" onclick="fnShowPerformance(' + siteId + ')">Performance</button>';
        if (site.IsDatalogger) {
            html += '<a class="btn" href="/UserSite/DataLogger?siteId=' + siteId + '">Data Logger</a>';
        }
        if (!site.IsSipView) {
            html += '<a class="btn" href="/Site/Sview?siteId=' + siteId + '">Sip View</a>';
        }
        html += '</div>';

        $content.html(html);

        // ── Slide counter: 2 / 6 ──
        if (totalSites > 1) {
            $counter.html('<span class="sc-current-num">' + (safeIdx + 1) + '</span> / ' + totalSites).show();
        } else {
            $counter.hide();
        }

        // ══════════════════════
        //  DOT INDICATORS
        // ══════════════════════
        if (totalSites > 1) {
            var dotHtml = '';
            for (var di = 0; di < totalSites; di++) {
                var dotSiteId = allSiteIds[di];
                var dotHasAlert = fnSiteHasAlert(dotSiteId);
                var dotCls = '';

                if (di === safeIdx) {
                    dotCls = dotHasAlert ? 'active-red' : 'active-green';
                } else if (dotHasAlert) {
                    dotCls = 'has-alert';
                }

                dotHtml += '<button class="sc-dot-ind ' + dotCls + '" onclick="fnJumpToSite(' + di + ')" title="' + siteRegistry[dotSiteId].Name + '"></button>';
            }
            $dots.html(dotHtml).show();

            // Site name strip
            var stripHtml = '';
            for (var si = 0; si < totalSites; si++) {
                var stripSiteId = allSiteIds[si];
                var stripAlert = fnSiteHasAlert(stripSiteId);
                var stripCls = '';

                if (si === safeIdx) {
                    stripCls = 'active ' + (stripAlert ? 'active-red' : 'active-green');
                }

                stripHtml += '<button class="sc-strip-item ' + stripCls + '" onclick="fnJumpToSite(' + si + ')">' + siteRegistry[stripSiteId].Name + '</button>';
            }
            $strip.html(stripHtml).show();
        } else {
            $dots.hide();
            $strip.hide();
        }

        // ══════════════════════
        //  ALERT DETAIL PANEL
        // ══════════════════════
        if (hasAlert) {
            $noAlertPanel.hide();
            $alertPanel.show();
            $('#spnAlertPanelSiteName').text(site.Name);
            $('#spnAlertPanelCount').text(siteAlerts.length + ' alert' + (siteAlerts.length !== 1 ? 's' : ''));

            var listHtml = '';
            for (var ai = 0; ai < siteAlerts.length; ai++) {
                var a = siteAlerts[ai];
                var isFailure = (a.AlertType === 'Failure' || a.AlertTypeId === @((int)E7FRSAdvance.Utility.Utility.AlertType.Failure));
                var typeCls   = isFailure ? 'failure' : 'predictive';
                var typeLabel = isFailure ? 'Failure' : 'Predictive';

                listHtml += '<div class="sc-alert-card" style="animation-delay:' + (ai * 0.06) + 's;">';

                // Top: badges + time
                listHtml += '<div class="sc-alert-card-top">';
                listHtml += '<span class="sc-badge-type ' + typeCls + '">' + typeLabel + '</span>';
                listHtml += '<span class="sc-badge-cause">' + (a.CauseCode || 'N/A') + '</span>';
                listHtml += '<span class="sc-alert-time">' + (a._ts || a.SetTimeStamp || '') + '</span>';
                listHtml += '</div>';

                // Body: fields
                listHtml += '<div class="sc-alert-card-body">';
                listHtml += '<div class="sc-alert-field"><span class="sc-alert-field-label">Asset Type</span><span class="sc-alert-field-value">' + (a.AssetType || '-') + '</span></div>';
                listHtml += '<div class="sc-alert-field"><span class="sc-alert-field-label">Asset</span><span class="sc-alert-field-value">' + (a.AssetName || 'Asset-' + a.AssetId) + '</span></div>';
                listHtml += '<div class="sc-alert-field" style="flex:2 1 0;"><span class="sc-alert-field-label">Message</span><span class="sc-alert-field-value">' + (a.SetAlertMessage || a.Message || '-') + '</span></div>';
                listHtml += '</div>';

                // Actions
                listHtml += '<div class="sc-alert-card-actions">';
                listHtml += '<button class="sc-btn-realtime" onclick="fnGetAssetAttribute(\'' + site.Name + '\',' + a.AssetId + ',' + (a.AssetTypeId || 0) + ')">Real Time Data</button>';
                listHtml += '<button class="sc-btn-secondary" onclick="fnShowSMSLog(' + siteId + ')">View Logs</button>';
                listHtml += '</div>';

                listHtml += '</div>';
            }
            $alertList.html(listHtml);
        } else {
            // No alerts for this site → show "all clear" panel
            $alertPanel.hide();
            $noAlertPanel.show();
            $('#spnNoAlertSiteName').text(site.Name);
        }
    }


    // ══════════════════════════════════
    //  HELPER FUNCTIONS
    // ══════════════════════════════════
    function fnGetSiteName(siteId) {
        var s = siteRegistry[siteId];
        return s ? s.Name : '';
    }

    function fnShowSMSLog(siteId) {
        $("#loader").show();
        $.ajax({
            url: '/FRS25/UserSite/_SMSLogLister',
            type: 'Post',
            data: '{siteId:' + siteId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divSMSLogLister").empty().append(data);
                $("#modal-add-smslogs").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("danger", "Something went wrong!");
            }
        });
    }

    function fnShowPerformance(siteId) {
        var mPerformanceLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = siteId;
        mPerformanceLister.SearchCriteria = mSearchCriteria;

        $("#loader").show();
        $.ajax({
            url: '/FRS25/UserSite/_PerformanceLister',
            type: 'Post',
            data: JSON.stringify(mPerformanceLister),
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divPerformanceList").empty().append(data);
                $("#modal-Performances").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function fnGetSiteSummaryView(siteName, assetTypeId) {
        var assetGroup = {};
        assetGroup.SiteName = siteName;
        assetGroup.AssetTypeId = assetTypeId;
        $("#loader").show();
        $.ajax({
            url: "/FRS25/PerformanceLister/UserSite/_SummaryView",
            type: "POST",
            data: '{assetGroup:' + JSON.stringify(assetGroup) + '}',
            contentType: 'application/json',
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divSummaryView").empty().append(data);
                $("#modalSummaryView").modal("show");
            },
            error: function (xhr, error, status) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "Error");
            }
        });
    }

    // ── Audio ──
    function fnPlaySound(target, RepeatCount) {
        var fnSoundRepeat = function () {
            RepeatCount--;
            target.currentTime = 0;
            if (RepeatCount > 0 && fnAlertSiteCount() > 0)
                target.play();
            else
                target.removeEventListener('ended', fnSoundRepeat);
        }
        target.addEventListener('ended', fnSoundRepeat);
        target.play();
    }

    function fnLoadAudio(audio, numberOfTimes, delay) {
        var alertCount = fnAlertSiteCount();
        if (alertCount > 0) {
            fnPlaySound(audio, numberOfTimes * alertCount);
        }
        var interval = setInterval(function () {
            var ac = fnAlertSiteCount();
            if (ac > 0) {
                fnPlaySound(audio, numberOfTimes * ac);
            } else {
                audio.pause();
                clearInterval(interval);
            }
        }, delay);
    }

    // ── Paging ──
    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmGetSiteList").submit();
            }
        } else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize) {
                var skip = @Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmGetSiteList").submit();
            }
        }
    }
</script>
