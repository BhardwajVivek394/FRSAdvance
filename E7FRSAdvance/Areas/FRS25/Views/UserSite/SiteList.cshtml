@{var serializer = new System.Web.Script.Serialization.JavaScriptSerializer(); serializer.MaxJsonLength = Int32.MaxValue;}
<script>
var json=@Html.Raw(serializer.Serialize(Model));
var dataInterval=parseFloat('@Model.HooterSetting.DataInterval')||30000;

// ===== Tab nav (manual only, no auto-cycling, dynamic height) =====
function setCardHeight(card){var vp=card.querySelector('.slide-viewport'),track=card.querySelector('.slide-track');if(!vp||!track)return;var sl=track.children[card._cur||0];if(sl)vp.style.height=sl.offsetHeight+'px';}
function fitAllCards(){document.querySelectorAll('.station-card').forEach(setCardHeight);}

$(document).ready(function(){
  if($('#hdnCatListType').val()=='Error'){if($('#hdnCatListMessage').val()=='Forbidden!')window.location.href='/Login/Index';}

  // Tab navigation — manual only, pause on hover
  $('.station-card').each(function(){
    var card=this,track=$(card).find('.slide-track')[0],btns=card.querySelectorAll('.card-nav button');
    card._cur=0;
    function goTo(i){card._cur=i;track.style.transform='translateX(-'+i*100+'%)';btns.forEach(function(b,j){b.classList.toggle('active',j===i);});setCardHeight(card);}
    btns.forEach(function(b){b.addEventListener('click',function(){goTo(parseInt(b.dataset.idx));});});
    goTo(0);
    // Load slide data
    var siteId=$(card).data('siteid');
    fnLoadSlideData(siteId);
  });

  fitAllCards();setTimeout(fitAllCards,300);
  $(window).on('resize',fitAllCards);

  updateSummaryCards();
  fnAllSiteCheckChannelDown();
  setInterval(fnAllSiteCheckChannelDown,dataInterval);
});

// ===== Render Now Slide =====
function renderNowSlide(siteId){
  var store=(window.wsAlertStore&&window.wsAlertStore[siteId])?window.wsAlertStore[siteId]:[];
  var $c=$('#nowContent_'+siteId),$h=$('#nowHeading_'+siteId);
  var active=null;for(var i=0;i<store.length;i++){if(store[i].Status==='Active'){active=store[i];break;}}
  var a=active||store[0];
  if(!a){$h.text('Last Event');$c.html('<div class="alert-empty"><span style="font-size:22px">✓</span><span>No alerts received</span></div>');return;}
  var isA=(a.Status==='Active'),isF=(a.AlertType==='Failure');
  $h.text(isA?'Active Alert':'Last Event');
  var ts='';if(a.Time||a.TimestampDevice){var d=new Date(a.TimestampDevice||a.Time);if(!isNaN(d))ts=('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)+':'+('0'+d.getSeconds()).slice(-2);}
  var dur='';if(isA&&a.Time){var ms=Date.now()-new Date(a.Time).getTime();if(ms>0){var hh=Math.floor(ms/36e5),mm=Math.floor(ms%36e5/6e4),ss=Math.floor(ms%6e4/1e3);dur=('0'+hh).slice(-2)+':'+('0'+mm).slice(-2)+':'+('0'+ss).slice(-2);}}
  var cnt=0;for(var j=0;j<store.length;j++)if(store[j].Status==='Active')cnt++;
  $('#statusBadge_'+siteId).text(cnt>0?cnt+' active':'All clear');
  var msg=a.Message||'';
  $c.html('<div class="alert-info-box '+(isF?'failure-border':'predictive-border')+'">'+
    '<div class="ab-top"><span class="alert-type-badge '+(isF?'failure':'predictive')+'">'+a.AlertType+'</span><span class="alert-status-badge '+(isA?'active-st':'cleared-st')+'">'+(isA?'Active':'Cleared')+'</span></div>'+
    '<div class="alert-asset-row"><div class="alert-asset">'+a.AssetName+'</div></div>'+
    (msg?'<div class="alert-msg">'+msg+'</div>':'')+
    '<div class="alert-cause">'+a.CauseCode+'</div>'+
    '<div class="alert-meta"><span>Started '+ts+'</span>'+(dur?'<span class="dur">Duration '+dur+'</span>':'')+'</div></div>'+
    '<div class="tele" id="teleBox_'+siteId+'"><div class="tele-empty">Loading telemetry…</div></div>');
  setTimeout(fitAllCards,50);
  loadTelemetry(siteId, a.AssetId||0, a.CauseCode||'', a.Id||0);
}

// ===== Telemetry multi-series chart (same color palette as the rest of the theme) =====
// Cycles through existing CSS accent colors so a new attribute never introduces an
// off-palette color: pred(blue) -> alert(pink) -> ok(green) -> warn(amber) -> node-c(cyan) -> accent2(violet)
var TELE_COLORS=['#7aa2f7','#fb6f84','#34d399','#f5b544','#5fc6cf','#a78bfa'];
function fmtClockLabel(ts){
  var d=new Date(ts); if(isNaN(d)) return '';
  var h=d.getHours(), m=d.getMinutes(), ap=h>=12?'PM':'AM', hh=h%12; if(hh===0)hh=12;
  return hh+':'+('0'+m).slice(-2)+' '+ap;
}
function teleNiceStep(maxVal){
  if(!maxVal||maxVal<=0) return 1;
  var raw=maxVal/5, mag=Math.pow(10,Math.floor(Math.log10(raw))), norm=raw/mag;
  var step=norm<1.5?1:norm<3?2:norm<7?5:10;
  return step*mag;
}
function multiSeriesChartSVG(series,w,h){
  w=w||300;h=h||130;
  var padL=32,padR=6,padT=6,padB=18,plotW=w-padL-padR,plotH=h-padT-padB;
  var allVals=[]; series.forEach(function(s){(s.Values||[]).forEach(function(v){ if(v!=null&&!isNaN(v)) allVals.push(v); });});
  if(!allVals.length) return '';
  var maxV=Math.max.apply(null,allVals), minV=Math.min(0,Math.min.apply(null,allVals));
  var step=teleNiceStep(maxV||1), top=Math.ceil((maxV||1)/step)*step; if(top<=minV) top=minV+step;
  var n=Math.max.apply(null,series.map(function(s){return (s.Values||[]).length;}));
  function X(i){ return padL+(n<=1?0:(i/(n-1))*plotW); }
  function Y(v){ return padT+(1-((v-minV)/((top-minV)||1)))*plotH; }

  var grid='', gridCount=Math.max(1,Math.round((top-minV)/step));
  for(var g=0;g<=gridCount;g++){
    var val=minV+g*step, y=Y(val);
    grid+='<line x1="'+padL+'" y1="'+y.toFixed(1)+'" x2="'+(w-padR)+'" y2="'+y.toFixed(1)+'" stroke="rgba(255,255,255,.08)" stroke-width="1"/>';
    grid+='<text x="'+(padL-6)+'" y="'+(y+3).toFixed(1)+'" text-anchor="end" font-size="9" fill="#6c778d" font-family="var(--mono)">'+Math.round(val)+'</text>';
  }
  var xlabels='', tickCount=Math.min(5,n);
  for(var t=0;t<tickCount;t++){
    var idx=Math.round(t*(n-1)/((tickCount-1)||1));
    var lbl=(series[0].Labels&&series[0].Labels[idx])?series[0].Labels[idx]:'';
    xlabels+='<text x="'+X(idx).toFixed(1)+'" y="'+(h-4)+'" text-anchor="middle" font-size="9" fill="#6c778d" font-family="var(--mono)">'+lbl+'</text>';
  }
  var lines='';
  series.forEach(function(s,si){
    var color=TELE_COLORS[si%TELE_COLORS.length], vals=s.Values||[];
    if(vals.length<2) return;
    var pts=[]; for(var i=0;i<vals.length;i++){ if(vals[i]!=null&&!isNaN(vals[i])) pts.push(X(i).toFixed(1)+','+Y(vals[i]).toFixed(1)); }
    if(pts.length<2) return;
    lines+='<polyline points="'+pts.join(' ')+'" fill="none" stroke="'+color+'" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>';
    var lastV=vals[vals.length-1];
    lines+='<circle cx="'+X(vals.length-1).toFixed(1)+'" cy="'+Y(lastV).toFixed(1)+'" r="2.6" fill="'+color+'"/>';
  });
  return '<svg class="spark" viewBox="0 0 '+w+' '+h+'" preserveAspectRatio="none">'+grid+lines+xlabels+'</svg>';
}
function teleLegendHTML(series){
  return series.map(function(s,i){
    var color=TELE_COLORS[i%TELE_COLORS.length];
    return '<span class="tele-leg-item"><i style="background:'+color+'"></i>'+s.Name+(s.Unit?(' ('+s.Unit+')'):'')+'</span>';
  }).join('');
}
var _teleReqSeq={};
function loadTelemetry(siteId, assetId, cause, frsAlertId){
  var $box=$('#teleBox_'+siteId);
  if(!$box.length) return;
  if(!assetId){ $box.html('<div class="tele-empty">No telemetry available</div>'); return; }
  var seq=(_teleReqSeq[siteId]=(_teleReqSeq[siteId]||0)+1);
  $.ajax({
    url:'/FRS25/UserSite/GetAssetTelemetry', type:'Post', data:{siteId:siteId, assetId:assetId, frsAlertId:frsAlertId||0},
    success:function(d){
      if(seq!==_teleReqSeq[siteId]) return; // a newer request superseded this one
      var $b=$('#teleBox_'+siteId); if(!$b.length) return;
      var series=(d&&d.Series)?d.Series.filter(function(s){return s.Values&&s.Values.length>1;}):[];
      if(!series.length){ $b.html('<div class="tele-empty">No telemetry data</div>'); return; }
      var chart=multiSeriesChartSVG(series,300,130);
      if(!chart){ $b.html('<div class="tele-empty">No telemetry data</div>'); return; }
      var rangeLbl=(d&&d.RangeLabel)?d.RangeLabel:'24h';
      $b.html('<div class="tele-head"><span class="tele-lbl">Asset Telemetry &middot; '+rangeLbl+'</span></div>'+
        '<div class="tele-chart">'+chart+'</div>'+
        '<div class="tele-legend">'+teleLegendHTML(series)+'</div>');
      setTimeout(fitAllCards,50);
    },
    error:function(){ if(seq===_teleReqSeq[siteId]){ var $b=$('#teleBox_'+siteId); if($b.length) $b.html('<div class="tele-empty">Telemetry unavailable</div>'); } }
  });
}

// ===== Health tab (ported from design mockup) =====
const SVC_DEFS=[
  {key:'DataRecv',label:'Data Receiver',icon:'\uD83D\uDCE5'},
  {key:'Datalogger',label:'Datalogger',icon:'\uD83D\uDCE1'},
  {key:'Alert',label:'Alert',icon:'\u26A1'},
  {key:'Debouncer',label:'Debouncer',icon:'\uD83D\uDD00'},
  {key:'Point',label:'Point Machine',icon:'\uD83D\uDD27'},
  {key:'EdgeX',label:'EdgeX',icon:'\uD83D\uDEF0'},
  {key:'Reminder',label:'Reminder',icon:'\u23F0'}
];
const SVC_NODES={DataRecv:['local','cloud'],Datalogger:['local'],Alert:['local','cloud'],Debouncer:['local','cloud'],Point:['local','cloud'],EdgeX:['local','cloud'],Reminder:['cloud']};
const HW_DEFS=[
  {key:'sensors',label:'Sensors',icon:'<svg viewBox="0 0 24 24"><path d="M12 2a4 4 0 014 4v4a4 4 0 01-8 0V6a4 4 0 014-4z"/><path d="M6 10v1a6 6 0 0012 0v-1"/><path d="M12 17v5"/><path d="M8 22h8"/></svg>'},
  {key:'iot',label:'IoT',icon:'<svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h.01M15 9h.01M9 15h.01M15 15h.01"/><path d="M12 9v6M9 12h6"/></svg>'},
  {key:'network',label:'Network',icon:'<svg viewBox="0 0 24 24"><rect x="9" y="2" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="16" y="16" width="6" height="6" rx="1"/><path d="M12 8v4M5 16v-2a2 2 0 012-2h10a2 2 0 012 2v2"/></svg>'}
];
const EYE_SVG='<svg viewBox="0 0 24 24"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/></svg>';
const MQ_SVG='<svg viewBox="0 0 24 24"><path d="M5 12.5a7 7 0 0114 0"/><path d="M8.5 15a3.6 3.6 0 016.9 0"/><circle cx="12" cy="18.5" r="1.3" fill="currentColor" stroke="none"/></svg>';
const HIST_SVG='<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>';
const WRENCH_SVG='<svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>';

function fmtAgo(iso){
  if(!iso) return null;
  var ms=Date.now()-new Date(iso).getTime();
  if(isNaN(ms)||ms<0) ms=0;
  var sec=Math.floor(ms/1000);
  if(sec<60) return sec+'s ago';
  var m=Math.floor(sec/60); sec=sec%60;
  if(m<60) return m+'m '+sec+'s ago';
  var h=Math.floor(m/60); m=m%60;
  if(h<24) return h+'h '+m+'m ago';
  var d=Math.floor(h/24); h=h%24;
  return d+'d '+h+'h ago';
}
function agoIso(sec){ return (sec==null||sec===undefined)?null:new Date(Date.now()-sec*1000).toISOString(); }

function statusCell(sdata,nodes,nd){
  if(nodes.indexOf(nd)<0) return '<div class="hg-c nd"><span class="hg-absent">\u2014</span></div>';
  var d=sdata[nd]||{sh:'u',mq:'u'};
  return '<div class="hg-c nd">'+
    '<span class="st '+(d.sh||'u')+'" title="Health \u00B7 '+nd+'">'+EYE_SVG+'</span>'+
    '<span class="st '+(d.mq||'u')+'" title="MQTT \u00B7 '+nd+'">'+MQ_SVG+'</span></div>';
}

function renderHealthSlide(siteId,H){
  var $c=$('#healthContent_'+siteId);
  if(!H){ $c.html('<div class="alert-empty"><span>No health data</span></div>'); return; }
  H=H||{}; H.Svc=H.Svc||{}; H.Hardware=H.Hardware||{};
  var rows=SVC_DEFS.map(function(def){
    var nodes=SVC_NODES[def.key]||['local','cloud'];
    var sdata=H.Svc[def.key]||{};
    var ago=null; nodes.forEach(function(nd){var a=(sdata[nd]||{}).ago; if(a!=null&&(ago==null||a<ago)) ago=a;});
    var iso=agoIso(ago);
    var last=iso?('<span class="svc-last-ts" data-iso="'+iso+'">'+fmtAgo(iso)+'</span>'):'\u2014';
    return '<div class="hg-row">'+
      '<div class="hg-c svc"><span class="s-ico">'+def.icon+'</span><span class="s-name">'+def.label+'</span></div>'+
      statusCell(sdata,nodes,'local')+statusCell(sdata,nodes,'cloud')+
      '<div class="hg-c last">'+last+'</div></div>';
  }).join('');
  var grid='<div class="hg-wrap"><div class="hgrid">'+
    '<div class="hg-h svc">Service</div>'+
    '<div class="hg-h nd local"><span class="nh-ico">\uD83D\uDCBB</span>Local</div>'+
    '<div class="hg-h nd cloud"><span class="nh-ico">\u2601</span>Cloud</div>'+
    '<div class="hg-h last">Last</div>'+rows+'</div></div>';
  var legend='<div class="hg-legend">'+
    '<span class="lg">'+EYE_SVG+'Health</span>'+
    '<span class="lg">'+MQ_SVG+'MQTT</span>'+
    '<span class="lg"><i class="dot g"></i>OK</span>'+
    '<span class="lg"><i class="dot a"></i>Warn</span>'+
    '<span class="lg"><i class="dot r"></i>Fail</span></div>';
  var hw=H.Hardware||{};
  function hwChip(def){
    var d=hw[def.key]||{}; var total=+d.total||0, bad;
    if(def.key==='sensors') bad=+d.bad||0; else bad=total-(d.online!=null?+d.online:total);
    if(total>0&&bad>0) return '<div class="hwc issue" title="'+def.label+': '+bad+' of '+total+' need attention">'+def.icon+bad+'<span class="frac">/'+total+'</span></div>';
    if(total>0) return '<div class="hwc ok" title="'+def.label+': all '+total+' healthy">'+def.icon+total+'</div>';
    return '<div class="hwc ok">'+def.icon+'\u2014</div>';
  }
  var fixes=+(H.Fixes||0);
  var strip='<div class="hd-strip"><span class="lbl">HW</span>'+
    HW_DEFS.map(hwChip).join('')+'<div class="hd-sp"></div>'+
    '<button type="button" class="hist-btn" title="Watch History \u2014 Modem / A10 / Sensors">'+HIST_SVG+'</button>'+
    '<button type="button" class="wrench-btn '+(fixes?'has-act':'')+'" title="'+(fixes?(fixes+' fix action'+(fixes!==1?'s':'')):'Fix Actions')+'">'+WRENCH_SVG+'</button></div>';
  $c.html('<div class="health-slide">'+grid+legend+strip+'</div>');
  setTimeout(fitAllCards,50);
}

// ===== Render Timeline =====
function renderTimelineSlide(siteId,alerts){
  var $c=$('#timelineContent_'+siteId);
  if(!alerts||!alerts.length){$c.html('<div class="alert-empty"><span>No timeline data</span></div>');return;}
  var items='';$.each(alerts,function(i,a){var isF=(a.AlertType==='Failure'||a.AlertTypeId===1),cls=isF?'failure':'predictive',st=a.Status||(a.ResetTimeStamp?'Cleared':'Active');
    var time='',date='',ts=a.Time||a.TimestampDevice||a.SetTimeStamp;if(ts){var d=new Date(ts);if(!isNaN(d)){time=('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);date=('0'+d.getDate()).slice(-2)+' '+['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()];}}
    items+='<div class="timeline-item"><div class="timeline-dot '+cls+'"></div><div class="timeline-head"><span class="timeline-type '+cls+'">'+(isF?'Failure':'Predictive')+'</span><span class="timeline-time">'+time+' · '+date+'</span><span class="timeline-st '+(st==='Active'?'active-st':'cleared-st')+'">'+st+'</span></div><div class="timeline-asset">'+(a.AssetName||'')+'</div><div class="timeline-cause">'+(a.CauseCode||a.PossibleCause||'')+'</div></div>';
  });
  $c.html('<div class="timeline-title">Alert Timeline</div><div class="timeline"><div class="timeline-line"></div>'+items+'</div>');setTimeout(fitAllCards,50);
}

// ===== Render Performance =====
function perfRingSVG(v,color){var r=17,c=2*Math.PI*r,off=c-(c*v/100);return '<svg viewBox="0 0 44 44" width="44" height="44" style="transform:rotate(-90deg)"><circle cx="22" cy="22" r="'+r+'" class="perf-ring-bg"/><circle cx="22" cy="22" r="'+r+'" class="perf-ring-fill" stroke="'+color+'" stroke-dasharray="'+c+'" stroke-dashoffset="'+off+'"/></svg>';}
function renderPerformanceSlide(siteId,perf){
  var $c=$('#performanceContent_'+siteId);if(!perf){$c.html('<div class="alert-empty"><span>No performance data</span></div>');return;}
  var m=[{l:'Failure Alert Accuracy',d:'(True+Partial) / Total Failure',v:perf.FailureAccuracy||0,c:'#f87171',b:'failure-bar'},{l:'Predictive Alert Accuracy',d:'(True+Partial) / Total Predictive',v:perf.PredictiveAccuracy||0,c:'#a78bfa',b:'predictive-bar'},{l:'RDPMS Failure Coverage',d:'RDPMS Alerts / Actual Failures',v:perf.RdpmsCoverage||0,c:'#34d399',b:'coverage-bar'}];
  var html='<div class="perf-slide"><div class="perf-heading">Performance</div>';
  $.each(m,function(i,x){html+='<div class="perf-card"><div class="perf-ring-wrap">'+perfRingSVG(x.v,x.c)+'<div class="perf-ring-val" style="color:'+x.c+'">'+Math.round(x.v)+'%</div></div><div class="perf-detail"><div class="perf-label">'+x.l+'</div><div class="perf-bar-track"><div class="perf-bar-fill '+x.b+'" style="width:'+x.v+'%"></div></div><div class="perf-sub"><span>'+x.d+'</span></div></div></div>';});
  $c.html(html+'</div>');setTimeout(fitAllCards,50);
}

// ===== Render Users =====
function renderUsersSlide(siteId,users){
  var $c=$('#usersContent_'+siteId);if(!users||!users.length){$c.html('<div class="alert-empty"><span>No user data</span></div>');return;}
  var items='';$.each(users,function(i,h){var nm=h.UserName||h.Name||'User',parts=nm.trim().split(' '),ini=parts.length>=2?parts[0][0]+parts[parts.length-1][0]:nm.substring(0,2);ini=ini.toUpperCase();var dur=h.Duration||0;
    items+='<div class="history-item"><div class="history-avatar">'+ini+'</div><div class="history-info"><div class="history-user">'+nm+'</div><div class="history-action">Total: '+dur+' min</div></div><div class="history-time">'+dur+' min</div></div>';
  });$c.html('<div class="history-title">User History</div>'+items);setTimeout(fitAllCards,50);
}

// ===== Load slide data =====
function fnLoadSlideData(siteId){
  $.ajax({url:'/FRS25/UserSite/GetTimelineAlerts',type:'Post',data:{siteId:siteId},success:function(d){renderTimelineSlide(siteId,d);}});
  $.ajax({url:'/FRS25/UserSite/GetPerformanceData',type:'Post',data:{siteId:siteId},success:function(d){renderPerformanceSlide(siteId,d);}});
  $.ajax({url:'/FRS25/UserSite/GetUserHistoryData',type:'Post',data:{siteId:siteId},success:function(d){renderUsersSlide(siteId,d);}});
  $.ajax({url:'/FRS25/UserSite/GetSiteHealth',type:'Post',data:{siteId:siteId},success:function(d){
    d=d||{Fixes:0,Hardware:{},Svc:{}};
    window.healthCacheHw=window.healthCacheHw||{};
    window.healthCacheHw[siteId]={Fixes:d.Fixes,Hardware:d.Hardware};
    // Live MQTT data (see Index.cshtml) takes precedence over the REST snapshot
    // once at least one health packet has arrived for this site.
    if(window.siteHealthStore&&window.siteHealthStore[siteId]&&typeof window.hBuildSvcForSite==='function'){
      d.Svc=window.hBuildSvcForSite(siteId);
    }
    renderHealthSlide(siteId,d);
  },error:function(){renderHealthSlide(siteId,null);}});
}

// ===== Summary Cards =====
    function updateSummaryCards() {
        var tot = 0, sirens = 0; $('.station-card').each(function () { if ($(this).hasClass('has-alert')) sirens++; });
        if (json && json.mSites) $.each(json.mSites, function (i, s) { tot += (s.TrackCount || 0) + (s.PointMachineCount || 0) + (s.SignalCount || 0); });
        $('#summary-cards').html(
            '<div class="summary-card failure"><div class="sc-meta"><div class="num">' + tot + '</div><div class="lbl">Total Alerts</div></div></div>' +
            '<div class="summary-card predictive"><div class="sc-meta"><div class="num">' + document.querySelectorAll('.station-card').length + '</div><div class="lbl">Sites</div></div></div>' +
            '<div class="summary-card sc-active"><div class="sc-meta"><div class="num">' + sirens + '</div><div class="lbl">Active Sirens</div></div></div>');
    }

// ===== Set card alert state =====
    function setCardAlert(siteId, isAlert) {
        var $card = $('#divSite_' + siteId), $sl = $('#statusLine_' + siteId);
        if (isAlert) {
            $card.addClass('has-alert'); $sl.removeClass('ok').addClass('alert'); $('#statusTxt_' + siteId).text('Alert Active'); renderNowSlide(siteId);
        } else { $card.removeClass('has-alert'); $sl.removeClass('alert').addClass('ok'); $('#statusTxt_' + siteId).text('Operational'); $('#statusBadge_' + siteId).text('All clear'); renderNowSlide(siteId); }
    }

// ===== Polling =====
var _isPolling=false;
function fnAllSiteCheckChannelDown(){
  if(_isPolling)return;_isPolling=true;
  var siteIds=[];if(json&&json.mSites)$.each(json.mSites,function(i,s){siteIds.push(s.Id);});
    $.ajax({
        url: '/FRS25/UserSite/GetSMSLogList', type: 'Post', data: JSON.stringify(siteIds), contentType: 'application/json',
        success: function (smsAlerts) {
            $('#loader').hide(); var hasNew = false;

            // Merge full alert objects into wsAlertStore so renderNowSlide/telemetry have real data
            var touchedSites = {};
            if (smsAlerts && smsAlerts.length) {
                $.each(smsAlerts, function (i, a) {
                    var sid = a.SiteId;
                    if (!window.wsAlertStore[sid]) window.wsAlertStore[sid] = [];
                    var already = window.wsAlertStore[sid].some(function (x) { return x.Id === a.Id; });
                    if (!already) {
                        var isActive = !a.ResetTimeStamp;
                        var msg = a.SetAlertMessage || ((a.AlertType || 'Alert') + ' Alert: ' + (a.AssetName || ''));
                        if (a.CauseCode) msg += ', "' + a.CauseCode + '"';
                        window.wsAlertStore[sid].unshift({
                            Id: a.Id, AssetId: a.AssetId || 0,
                            AssetName: a.AssetName || '', AlertType: a.AlertType || 'Predictive', CauseCode: a.CauseCode || '',
                            Message: msg, Time: a.SetTimeStamp || '', TimestampDevice: a.SetTimeStamp || '',
                            AlertAction: isActive ? 'SET' : 'RESET', Status: isActive ? 'Active' : 'Cleared'
                        });
                        if (window.wsAlertStore[sid].length > 10) window.wsAlertStore[sid] = window.wsAlertStore[sid].slice(0, 10);
                    }
                    touchedSites[sid] = true;
                });
            }

            $('.station-card').each(function () {
                var sid = $(this).data('siteid'), was = $(this).hasClass('has-alert');
                var storeArr = window.wsAlertStore[sid] || [];
                var now = storeArr.some(function (a) { return a.Status === 'Active'; });
                if (now && !was) {
                    setCardAlert(sid, true); hasNew = true;
                } else if (!now && was) {
                    setCardAlert(sid, false);
                } else if (touchedSites[sid]) {
                    renderNowSlide(sid);
                }
            });

            updateSummaryCards();
            if (hasNew && typeof playSoundCooldown === 'function' && soundOn) playSoundCooldown();
        }, error: function () { $('#loader').hide(); }, complete: function () { _isPolling = false; }
    });
}

</script>
