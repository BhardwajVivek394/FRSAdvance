@model Domain.SiteLister

<style>
    /* ===== Grid ===== */
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 22px;
        align-items: start;
    }

    /* ===== Station Card ===== */
    .station-card {
        position: relative;
        border-radius: 24px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform .35s cubic-bezier(.2,.7,.3,1), box-shadow .4s, border-color .5s;
        background: linear-gradient(165deg, rgba(255,255,255,.10), rgba(255,255,255,.045));
        backdrop-filter: blur(22px) saturate(170%);
        -webkit-backdrop-filter: blur(22px) saturate(170%);
        border: 1px solid rgba(255,255,255,.10);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.28), inset 0 -1px 1px rgba(0,0,0,.25), 0 12px 34px rgba(0,0,0,.4);
    }

        .station-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 42%;
            pointer-events: none;
            z-index: 0;
            background: linear-gradient(180deg, rgba(255,255,255,.10), rgba(255,255,255,0));
        }

        .station-card > * {
            position: relative;
            z-index: 1;
        }

        .station-card .sheen-sweep {
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            width: 45%;
            z-index: 2;
            pointer-events: none;
            opacity: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,.16), transparent);
        }

        .station-card:hover .sheen-sweep {
            opacity: 1;
            animation: sheen-sweep .85s ease-out;
        }

        .station-card:hover {
            transform: translateY(-6px) scale(1.01);
            box-shadow: inset 0 1px 0 rgba(255,255,255,.32), 0 24px 50px rgba(0,0,0,.55);
        }

        .station-card.has-alert {
            border-color: rgba(248,113,113,.4);
            animation: glow-red 2s ease-in-out infinite;
        }

        .station-card.enter {
            animation: card-in .6s cubic-bezier(.2,.7,.3,1) backwards;
        }

    /* ===== Station Board ===== */
    .board-text {
        flex: 1;
        min-width: 0;
        text-align: center;
    }

    .board-name {
        font-family: 'Roboto Condensed', 'Inter', sans-serif;
        font-weight: 700;
        font-size: 20px;
        letter-spacing: 2px;
        line-height: 1;
        text-transform: uppercase;
        color: #fff;
        text-shadow: 0 1px 2px rgba(0,0,0,.5), 0 0 16px rgba(255,255,255,.25);
    }

    .board-sub {
        font-size: 8.5px;
        color: rgba(255,255,255,.7);
        font-weight: 700;
        letter-spacing: 2.5px;
        margin-top: 4px;
        text-shadow: 0 1px 2px rgba(0,0,0,.4);
    }

    .board-code {
        flex-shrink: 0;
        background: rgba(255,255,255,.18);
        color: #fff;
        font-size: 10px;
        font-weight: 800;
        padding: 4px 9px;
        border-radius: 7px;
        letter-spacing: 1px;
        border: 1px solid rgba(255,255,255,.3);
        text-shadow: 0 1px 2px rgba(0,0,0,.3);
    }

    .master {
        width: 58px;
        height: 66px;
        flex-shrink: 0;
    }

        .master svg {
            width: 58px;
            height: 66px;
            display: block;
        }

    /* ===== Liquid Pool ===== */
    .station-board-wrap {
        position: relative;
        padding: 18px 18px 22px;
        margin: 6px 14px 0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.14), 0 6px 20px rgba(0,0,0,.35);
    }

        .station-board-wrap.ok {
            background: linear-gradient(180deg, rgba(6,78,59,.35), rgba(6,40,30,.5));
        }

        .station-board-wrap.alert {
            background: linear-gradient(180deg, rgba(120,20,50,.35), rgba(70,10,30,.5));
        }

    .liquid-pool {
        position: absolute;
        inset: 0;
        z-index: 0;
        overflow: hidden;
        border-radius: 18px;
    }

        .liquid-pool .w-back, .liquid-pool .w-mid, .liquid-pool .w-front {
            position: absolute;
            inset: 0;
        }

            .liquid-pool .w-back svg, .liquid-pool .w-mid svg, .liquid-pool .w-front svg {
                position: absolute;
                inset: 0;
                width: 200%;
                height: 100%;
                display: block;
            }

        .liquid-pool .w-back {
            opacity: .5;
        }

        .liquid-pool .w-mid {
            opacity: .7;
        }

        .liquid-pool .w-front {
            opacity: .92;
        }

        .liquid-pool.alert .w-back svg {
            animation: wave-move 5s linear infinite;
        }

        .liquid-pool.alert .w-mid svg {
            animation: wave-move 3.2s linear infinite reverse;
        }

        .liquid-pool.alert .w-front svg {
            animation: wave-move 2.1s linear infinite;
        }

        .liquid-pool.ok .w-back svg {
            animation: wave-move 9s linear infinite;
        }

        .liquid-pool.ok .w-mid svg {
            animation: wave-move 6.5s linear infinite reverse;
        }

        .liquid-pool.ok .w-front svg {
            animation: wave-move 4.6s linear infinite;
        }

        .liquid-pool::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 2;
            pointer-events: none;
            border-radius: 18px;
            background: linear-gradient(180deg, rgba(255,255,255,.28), rgba(255,255,255,.05) 30%, transparent 55%), radial-gradient(80% 50% at 25% 0%, rgba(255,255,255,.22), transparent 60%);
        }

        .liquid-pool::after {
            content: "";
            position: absolute;
            top: 0;
            left: -30%;
            width: 50%;
            height: 100%;
            z-index: 2;
            pointer-events: none;
            background: linear-gradient(100deg, transparent, rgba(255,255,255,.14), transparent);
            animation: shine-drift 7s ease-in-out infinite;
        }

    .station-board {
        position: relative;
        z-index: 1;
        border-radius: 14px;
        padding: 12px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        background: linear-gradient(180deg, rgba(15,23,42,.42), rgba(8,14,30,.5));
        backdrop-filter: blur(10px) saturate(150%);
        -webkit-backdrop-filter: blur(10px) saturate(150%);
        border: 1px solid rgba(255,255,255,.20);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.3), 0 6px 18px rgba(0,0,0,.4);
    }

    .station-card.has-alert .station-board {
        animation: board-shake .6s ease-in-out infinite;
        border-color: rgba(255,255,255,.26);
    }

    /* ===== Status Line ===== */
    .status-line {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 10px 14px 4px;
    }

        .status-line .lamp {
            position: relative;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
            background: #fff;
        }

            .status-line .lamp::after {
                content: "";
                position: absolute;
                inset: -5px;
                border-radius: 50%;
                border: 1.5px solid rgba(255,255,255,.5);
            }

        .status-line.alert .lamp {
            background: #fb7185;
            box-shadow: 0 0 12px 2px rgba(251,113,133,.85);
            animation: blink 1s infinite;
        }

            .status-line.alert .lamp::after {
                animation: ring 1.4s ease-out infinite;
                border-color: rgba(251,113,133,.7);
            }

        .status-line.ok .lamp {
            background: #34d399;
            box-shadow: 0 0 12px 2px rgba(52,211,153,.8);
        }

            .status-line.ok .lamp::after {
                border-color: rgba(52,211,153,.5);
            }

        .status-line .txt {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .status-line.alert .txt {
            color: #fda4af;
            text-shadow: 0 0 12px rgba(251,113,133,.4);
        }

        .status-line.ok .txt {
            color: #6ee7b7;
            text-shadow: 0 0 12px rgba(52,211,153,.35);
        }

        .status-line .badge {
            font-size: 9px;
            font-weight: 700;
            color: var(--txt-dim);
            background: rgba(255,255,255,.06);
            padding: 3px 9px;
            border-radius: 20px;
            margin-left: 1px;
            border: 1px solid rgba(255,255,255,.10);
        }

    /* rail divider */
    .rail {
        height: 6px;
        margin: 2px 14px 0;
        background-image: repeating-linear-gradient(90deg, rgba(255,255,255,.35) 0 6px, transparent 6px 20px);
        background-size: 40px 6px;
        opacity: .4;
    }

    .station-card.has-alert .rail {
        animation: rail-move 1.2s linear infinite;
        opacity: .6;
    }

    /* ===== Slides ===== */
    .slide-viewport {
        height: 210px;
        position: relative;
        overflow: hidden;
    }

    .slide-track {
        display: flex;
        height: 100%;
        transition: transform .45s cubic-bezier(.4,0,.2,1);
    }

    .slide {
        min-width: 100%;
        height: 100%;
        padding: 14px 16px 8px;
    }

    .card-nav {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2px;
        padding: 10px 12px 11px;
        border-top: 1px solid rgba(255,255,255,.10);
    }

        .card-nav .seg {
            display: flex;
            gap: 2px;
            padding: 3px;
            border-radius: 11px;
            background: rgba(0,0,0,.18);
            border: 1px solid rgba(255,255,255,.10);
        }

        .card-nav button {
            background: transparent;
            border: none;
            border-radius: 8px;
            padding: 5px 12px;
            cursor: pointer;
            color: var(--txt-faint);
            font-size: 9px;
            font-weight: 700;
            transition: color .25s, background .25s;
            letter-spacing: .6px;
            font-family: inherit;
        }

            .card-nav button:hover {
                color: #cdddff;
            }

            .card-nav button.active-nav {
                background: linear-gradient(180deg, rgba(129,140,248,.45), rgba(129,140,248,.22));
                color: #fff;
                box-shadow: inset 0 1px 0 rgba(255,255,255,.35), 0 2px 8px rgba(99,102,241,.35);
            }

    .progress-bar {
        height: 3px;
        background: rgba(255,255,255,.06);
    }

    .progress-fill {
        height: 100%;
        transition: width .45s cubic-bezier(.4,0,.2,1);
        border-radius: 0 2px 2px 0;
    }

        .progress-fill.alert {
            background: linear-gradient(90deg, #e11d48, #fb7185);
            box-shadow: 0 0 10px rgba(225,29,72,.6);
        }

        .progress-fill.normal {
            background: linear-gradient(90deg, #6366f1, #818cf8);
            box-shadow: 0 0 10px rgba(99,102,241,.55);
        }

    /* Now slide */
    .now-slide {
        display: flex;
        flex-direction: column;
        gap: 10px;
        height: 100%;
        justify-content: center;
    }

    .now-heading {
        font-size: 10px;
        font-weight: 700;
        color: var(--txt-dim);
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    .alert-info-box {
        width: 100%;
        border-radius: 12px;
        padding: 12px 14px;
        background: rgba(255,255,255,.07);
        backdrop-filter: blur(10px);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.15);
    }

        .alert-info-box.failure-border {
            border: 1px solid rgba(255,99,99,.30);
        }

        .alert-info-box.predictive-border {
            border: 1px solid rgba(99,179,237,.30);
        }

    .alert-type-badge {
        font-size: 9px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 6px;
        display: inline-block;
    }

        .alert-type-badge.failure {
            background: rgba(255,77,77,.18);
            color: #ff8585;
        }

        .alert-type-badge.predictive {
            background: rgba(99,179,237,.18);
            color: #8ecbf5;
        }

    .alert-status-badge {
        font-size: 9px;
        padding: 2px 8px;
        border-radius: 6px;
        display: inline-block;
        margin-left: 6px;
    }

        .alert-status-badge.active-st {
            background: rgba(34,197,94,.15);
            color: #5fdd92;
        }

        .alert-status-badge.cleared-st {
            background: rgba(148,163,184,.12);
            color: var(--txt-faint);
        }

    .alert-asset {
        color: #f8fafc;
        font-size: 13px;
        font-weight: 600;
        margin: 7px 0 3px;
    }

    .alert-cause {
        color: #fbbf24;
        font-size: 10px;
        font-family: monospace;
        background: rgba(251,191,36,.12);
        display: inline-block;
        padding: 2px 7px;
        border-radius: 5px;
        margin-bottom: 8px;
    }

    .alert-meta {
        display: flex;
        gap: 14px;
        color: var(--txt-dim);
        font-size: 10px;
    }

        .alert-meta .dur {
            color: #fcd34d;
        }

    /* Alert list in Now slide */
    .alert-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        overflow-y: auto;
        max-height: 170px;
        padding-right: 4px;
    }

        .alert-list::-webkit-scrollbar {
            width: 3px;
        }

        .alert-list::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,.15);
            border-radius: 2px;
        }

    .alert-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        color: #6ee7b7;
        font-size: 11px;
        font-weight: 600;
        height: 140px;
    }

    .alert-card {
        border-radius: 10px;
        padding: 9px 12px;
        cursor: pointer;
        background: rgba(255,255,255,.05);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.08);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.10);
        transition: background .2s, border-color .2s;
    }

        .alert-card:hover {
            background: rgba(255,255,255,.09);
            border-color: rgba(255,255,255,.16);
        }

        .alert-card .ac-top {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 4px;
        }

        .alert-card .ac-badge {
            font-size: 8px;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

            .alert-card .ac-badge.failure {
                background: rgba(255,77,77,.18);
                color: #ff8585;
            }

            .alert-card .ac-badge.predictive {
                background: rgba(99,179,237,.18);
                color: #8ecbf5;
            }

        .alert-card .ac-asset {
            color: #f1f5f9;
            font-size: 11px;
            font-weight: 600;
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .alert-card .ac-time {
            font-size: 9px;
            color: var(--txt-faint);
            font-family: monospace;
        }

        .alert-card .ac-msg {
            font-size: 9.5px;
            color: var(--txt-dim);
            line-height: 1.35;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .alert-card .ac-cause {
            font-size: 9px;
            color: #fbbf24;
            font-family: monospace;
            margin-top: 3px;
            background: rgba(251,191,36,.08);
            display: inline-block;
            padding: 1px 6px;
            border-radius: 4px;
        }

    /* Placeholder for upcoming slides */
    .placeholder-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: var(--txt-faint);
        font-size: 11px;
        font-weight: 600;
        height: 150px;
        border-radius: 12px;
        border: 1px dashed rgba(255,255,255,.12);
        background: rgba(255,255,255,.03);
    }

    @@media(max-width:1024px) {
        .grid {
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        }
    }

    @@media(max-width:768px) {
        .grid {
            grid-template-columns: 1fr;
        }
    }

    .card-nav button:focus-visible, .sound-toggle:focus-visible {
        outline: 2px solid #a5b4fc;
        outline-offset: 2px;
    }
</style>

<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />

<div class="grid" id="station-grid">
    @if (Model.mSites != null && Model.mSites.Count > 0)
    {
        var idx = 0;
        foreach (var item in Model.mSites)
        {
            var hasAlert = false; // will be set dynamically via JS polling
            var alertCount = item.TrackCount + item.SignalCount + item.PointMachineCount;
            var siteCode = item.Name != null && item.Name.Length >= 4 ? item.Name.Substring(0, 4).ToUpper() : (item.Name ?? "").ToUpper();

            <div class="station-card enter" id="divSite_@item.Id" data-siteid="@item.Id" data-sitename="@item.Name" style="animation-delay: @(idx * 0.09)s;">
                <div class="sheen-sweep"></div>

                <!-- Station Board with Liquid Pool -->
                <div class="station-board-wrap ok" id="boardWrap_@item.Id">
                    <div class="liquid-pool ok" id="liquidPool_@item.Id">
                        <!-- Green wave (ok state) — JS will swap to red on alert -->
                        <div class="w-back">
                            <svg viewBox="0 0 400 90" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                                <defs><linearGradient id="lb-ok-@item.Id" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#047857" /><stop offset="100%" stop-color="#053d2c" /></linearGradient></defs>
                                <path d="M0,42 C50,30 100,54 150,42 C200,30 250,54 300,42 C350,30 400,54 400,42 L400,90 L0,90 Z" fill="url(#lb-ok-@item.Id)" />
                            </svg>
                        </div>
                        <div class="w-mid">
                            <svg viewBox="0 0 400 90" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                                <defs><linearGradient id="lm-ok-@item.Id" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#059669" /><stop offset="100%" stop-color="#047857" /></linearGradient></defs>
                                <path d="M0,54 C44,44 88,64 132,54 C176,44 220,64 264,54 C308,44 352,64 400,54 L400,90 L0,90 Z" fill="url(#lm-ok-@item.Id)" />
                            </svg>
                        </div>
                        <div class="w-front">
                            <svg viewBox="0 0 400 90" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                                <defs><linearGradient id="lf-ok-@item.Id" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#10b981" /><stop offset="100%" stop-color="#059669" /></linearGradient></defs>
                                <path d="M0,66 C40,58 80,74 120,66 C160,58 200,74 240,66 C280,58 320,74 360,66 C380,62 400,70 400,66 L400,90 L0,90 Z" fill="url(#lf-ok-@item.Id)" />
                                <path d="M0,66 C40,58 80,74 120,66 C160,58 200,74 240,66 C280,58 320,74 360,66 C380,62 400,70 400,66" fill="none" stroke="#a7f3d0" stroke-width="1.5" opacity=".75" />
                            </svg>
                        </div>
                    </div>
                    <div class="station-board">
                        <div class="master" id="master_@item.Id">
                            <!-- Station Master SVG (ok state) — JS will swap on alert -->
                        </div>
                        <div class="board-text">
                            <div class="board-name">@item.Name</div>
                            <div class="board-sub">RDPMS · E7FRS</div>
                        </div>
                        <div class="board-code">@siteCode</div>
                    </div>
                </div>

                <!-- Status Line -->
                <div class="status-line ok" id="statusLine_@item.Id">
                    <span class="lamp"></span>
                    <span class="txt" id="statusTxt_@item.Id">All Clear</span>
                    <span class="badge" id="statusBadge_@item.Id">0 active</span>
                </div>

                <!-- Rail Divider -->
                <div class="rail"></div>

                <!-- Slides -->
                <div class="slide-viewport">
                    <div class="slide-track">
                        <!-- Slide 1: Now — Last 4 FRS Alerts -->
                        <div class="slide">
                            <div class="now-slide" id="nowSlide_@item.Id">
                                <div class="now-heading">Recent Alerts</div>
                                <div class="alert-list" id="alertList_@item.Id">
                                    <div class="alert-empty">
                                        <span style="font-size:22px;">✓</span>
                                        <span>No active alerts</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Slide 2: Timeline (placeholder — data coming soon) -->
                        <div class="slide">
                            <div class="now-slide" id="timelineSlide_@item.Id">
                                <div class="now-heading">Timeline</div>
                                <div class="placeholder-box" id="timelineContent_@item.Id">
                                    <span style="font-size:18px;">📅</span>
                                    <span>Timeline data coming soon</span>
                                </div>
                            </div>
                        </div>

                        <!-- Slide 3: Performance (placeholder — data coming soon) -->
                        <div class="slide">
                            <div class="now-slide" id="performanceSlide_@item.Id">
                                <div class="now-heading">Performance</div>
                                <div class="placeholder-box" id="performanceContent_@item.Id">
                                    <span style="font-size:18px;">📊</span>
                                    <span>Performance data coming soon</span>
                                </div>
                            </div>
                        </div>

                        <!-- Slide 4: Users (placeholder — data coming soon) -->
                        <div class="slide">
                            <div class="now-slide" id="usersSlide_@item.Id">
                                <div class="now-heading">Users</div>
                                <div class="placeholder-box" id="usersContent_@item.Id">
                                    <span style="font-size:18px;">👤</span>
                                    <span>User data coming soon</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Card Nav -->
                <div class="card-nav">
                    <div class="seg">
                        <button class="active-nav" data-idx="0">Now</button>
                        <button data-idx="1">Timeline</button>
                        <button data-idx="2">Performance</button>
                        <button data-idx="3">Users</button>
                    </div>
                </div>
                <div class="progress-bar"><div class="progress-fill normal" style="width:25%"></div></div>
            </div>

            idx++;
        }
    }
</div>

@{
    var serializer = new System.Web.Script.Serialization.JavaScriptSerializer();
    serializer.MaxJsonLength = Int32.MaxValue;
}

<script>
    var json = @Html.Raw(serializer.Serialize(Model));
    var dataInterval = parseFloat('@Model.HooterSetting.DataInterval') || 30000;
    var reminderFrequency = parseFloat('@Model.HooterSetting.ReminderFrequency') || 30000;

    // ===== Station Master SVG Generator =====
    function stationMasterSVG(isAlert) {
        var flag = isAlert ? '#ef4444' : '#22c55e';
        var flagDark = isAlert ? '#b91c1c' : '#15803d';
        var glow = isAlert ? 'rgba(239,68,68,.6)' : 'rgba(34,197,94,.55)';
        var jTop = isAlert ? '#f87171' : '#4ade80';
        var jMid = isAlert ? '#ef4444' : '#22c55e';
        var jBot = isAlert ? '#b91c1c' : '#15803d';
        var lTop = isAlert ? '#dc2626' : '#16a34a';
        var lBot = isAlert ? '#991b1b' : '#166534';
        var a = isAlert ? 1 : 0;
        var bobAnim = isAlert ? 'tech-bob-alert .9s ease-in-out infinite' : 'tech-bob 3.2s ease-in-out infinite';
        var armAnim = isAlert ? 'work-arm-alert .7s ease-in-out infinite' : 'work-arm 2.4s ease-in-out infinite';
        var flagAnim = isAlert ? 'flag-raise .55s ease-in-out infinite' : 'flag-raise 2.6s ease-in-out infinite';
        var sparkA = isAlert ? 'spark .7s ease-out infinite' : 'spark 2.4s ease-out infinite';
        var flagWave = isAlert ? '.5s' : '2.4s';
        var uid = Math.random().toString(36).substr(2, 6);

        return '<svg viewBox="0 0 64 72" xmlns="http://www.w3.org/2000/svg">' +
            '<defs>' +
            '<linearGradient id="hv-' + uid + '" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="' + jTop + '"/><stop offset="55%" stop-color="' + jMid + '"/><stop offset="100%" stop-color="' + jBot + '"/></linearGradient>' +
            '<linearGradient id="hvleg-' + uid + '" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="' + lTop + '"/><stop offset="100%" stop-color="' + lBot + '"/></linearGradient>' +
            '<linearGradient id="helm-' + uid + '" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#ffffff"/><stop offset="100%" stop-color="#d4dae0"/></linearGradient>' +
            '<filter id="fgl-' + uid + '" x="-60%" y="-60%" width="220%" height="220%"><feDropShadow dx="0" dy="0" stdDeviation="1.4" flood-color="' + glow + '"/></filter>' +
            '</defs>' +
            '<ellipse cx="34" cy="69" rx="22" ry="3.2" fill="#000" opacity=".3"/>' +
            '<path d="M30,52 Q44,50 50,56 Q52,62 46,64 L30,64 Q26,58 30,52 Z" fill="url(#hvleg-' + uid + ')"/>' +
            '<rect x="33" y="58" width="15" height="2.4" rx="1.2" fill="#e8eef3" opacity=".85"/>' +
            '<path d="M22,46 Q20,56 24,64 L33,64 Q34,55 31,48 Z" fill="url(#hvleg-' + uid + ')"/>' +
            '<rect x="22.5" y="57" width="10" height="2.4" rx="1.2" fill="#e8eef3" opacity=".85"/>' +
            '<path d="M21,63 Q19,67 24,67 L33,67 L33,63 Z" fill="#15171c"/>' +
            '<ellipse cx="46" cy="64.5" rx="6" ry="2.6" fill="#15171c"/>' +
            '<g style="transform-origin:34px 50px;animation:' + bobAnim + '">' +
            '<path d="M22,30 Q34,25 46,31 Q49,40 47,50 Q40,54 30,53 Q22,52 20,46 Q19,37 22,30 Z" fill="url(#hv-' + uid + ')"/>' +
            '<path d="M22,30 Q34,25 46,31 Q44,34 40,33 Q34,30 28,33 Q24,34 22,30 Z" fill="#1b1d22"/>' +
            '<path d="M21,44 Q34,47 47,44 L46.5,47 Q34,50 21.5,47 Z" fill="#eef4f8" opacity=".92"/>' +
            '<path d="M24,38 Q34,40 44,38 L43.7,40 Q34,42 24.3,40 Z" fill="#eef4f8" opacity=".55"/>' +
            '<line x1="34" y1="31" x2="33" y2="52" stroke="#1b1d22" stroke-width="1" opacity=".5"/>' +
            '<rect x="31.5" y="22" width="5" height="5" rx="2" fill="#e0a87e"/>' +
            '<path d="M28.5,16 Q34,13.5 39.5,16 Q41,20 39.5,23.5 Q37.5,26.5 34,26.5 Q30.5,26.5 28.5,23.5 Q27,20 28.5,16 Z" fill="#e8b48a"/>' +
            '<ellipse cx="39" cy="20.5" rx="1.3" ry="2" fill="#d99c72"/>' +
            '<path d="M26,16.5 Q34,6 42,16.5 Q42.5,18 40.5,18.2 L27.5,18.2 Q25.5,18 26,16.5 Z" fill="url(#helm-' + uid + ')"/>' +
            '<rect x="26" y="17.6" width="16" height="2.2" rx="1.1" fill="#eef2f5"/>' +
            '<path d="M34,7.5 L34,16" stroke="#c2c9cf" stroke-width="1" opacity=".7"/>' +
            '<path d="M30,9 Q34,7 38,9" stroke="#c2c9cf" stroke-width=".8" fill="none" opacity=".6"/>' +
            '<ellipse cx="31" cy="12" rx="2" ry="3" fill="#fff" opacity=".5"/>' +
            '<g style="transform-origin:24px 32px;animation:' + flagAnim + '">' +
            '<path d="M24,33 Q17,24 13,13 L16,12 Q21,23 28,31 Z" fill="url(#hv-' + uid + ')"/>' +
            '<path d="M18,20 L21,18.6 L22.6,21.5 L19.6,23 Z" fill="#eef4f8" opacity=".85"/>' +
            '<circle cx="14.5" cy="13" r="2.4" fill="#e8b48a"/>' +
            '<g style="transform-origin:13px 9px;animation:flag-wave ' + flagWave + ' ease-in-out infinite" filter="url(#fgl-' + uid + ')">' +
            '<line x1="13" y1="5" x2="13" y2="14" stroke="#1a1208" stroke-width="2" stroke-linecap="round"/>' +
            '<path d="M13,5 Q21,3 29,6 Q21,10 13,12 Z" fill="' + flag + '" stroke="' + flagDark + '" stroke-width=".5"/>' +
            '</g></g>' +
            '<g style="transform-origin:45px 33px;animation:' + armAnim + '">' +
            '<path d="M45,33 Q52,38 50,48 L46.5,48 Q47.5,39 42,35 Z" fill="url(#hv-' + uid + ')"/>' +
            '<path d="M47.5,40 L50.5,39 L51,42 L48,43 Z" fill="#eef4f8" opacity=".7"/>' +
            '<circle cx="49" cy="48.5" r="2.3" fill="#e8b48a"/>' +
            '<g style="transform-origin:50px 50px;animation:' + sparkA + '">' +
            '<circle cx="50" cy="50" r="1.6" fill="#fde68a"/>' +
            '<line x1="50" y1="46.5" x2="50" y2="48" stroke="#fde68a" stroke-width="1" stroke-linecap="round"/>' +
            '<line x1="53.5" y1="50" x2="52" y2="50" stroke="#fde68a" stroke-width="1" stroke-linecap="round"/>' +
            '<line x1="52.4" y1="47.6" x2="51.5" y2="48.5" stroke="#fde68a" stroke-width="1" stroke-linecap="round"/>' +
            '</g></g></g></svg>';
    }

    // ===== Liquid Wave SVG Generator =====
    function waveSVG(isAlert, siteId) {
        var deep = isAlert ? '#7f1031' : '#053d2c';
        var mid = isAlert ? '#be123c' : '#047857';
        var body = isAlert ? '#e11d48' : '#059669';
        var light = isAlert ? '#fb7185' : '#10b981';
        var crest = isAlert ? '#fecdd3' : '#a7f3d0';

        var back = '<svg viewBox="0 0 400 90" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">' +
            '<defs><linearGradient id="lb-' + siteId + '" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="' + mid + '"/><stop offset="100%" stop-color="' + deep + '"/></linearGradient></defs>' +
            '<path d="M0,42 C50,30 100,54 150,42 C200,30 250,54 300,42 C350,30 400,54 400,42 L400,90 L0,90 Z" fill="url(#lb-' + siteId + ')"/></svg>';

        var midL = '<svg viewBox="0 0 400 90" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">' +
            '<defs><linearGradient id="lm-' + siteId + '" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="' + body + '"/><stop offset="100%" stop-color="' + mid + '"/></linearGradient></defs>' +
            '<path d="M0,54 C44,44 88,64 132,54 C176,44 220,64 264,54 C308,44 352,64 400,54 L400,90 L0,90 Z" fill="url(#lm-' + siteId + ')"/></svg>';

        var front = '<svg viewBox="0 0 400 90" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">' +
            '<defs><linearGradient id="lf-' + siteId + '" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="' + light + '"/><stop offset="100%" stop-color="' + body + '"/></linearGradient></defs>' +
            '<path d="M0,66 C40,58 80,74 120,66 C160,58 200,74 240,66 C280,58 320,74 360,66 C380,62 400,70 400,66 L400,90 L0,90 Z" fill="url(#lf-' + siteId + ')"/>' +
            '<path d="M0,66 C40,58 80,74 120,66 C160,58 200,74 240,66 C280,58 320,74 360,66 C380,62 400,70 400,66" fill="none" stroke="' + crest + '" stroke-width="1.5" opacity=".75"/></svg>';

        return '<div class="w-back">' + back + '</div><div class="w-mid">' + midL + '</div><div class="w-front">' + front + '</div>';
    }

    // ===== Initialize all station masters + slide nav =====
    $(document).ready(function () {

        // Notification handling
        if ($('#hdnCatListType').val() == 'Success') {
            CommonNotification($("#hdnCatListType").val().toUpperCase(), $("#hdnCatListMessage").val(), $("#hdnCatListType").val());
        } else if ($('#hdnCatListType').val() == 'Error') {
            if ($('#hdnCatListMessage').val() == 'Forbidden!') {
                window.location.href = "/Login/Index";
            } else {
                CommonNotification($("#hdnCatListType").val().toUpperCase(), $("#hdnCatListMessage").val(), $("#hdnCatListType").val());
            }
        }

        // Render station masters (all start as OK)
        $('.station-card').each(function () {
            var siteId = $(this).data('siteid');
            $('#master_' + siteId).html(stationMasterSVG(false));
        });

        // Slide navigation for each card
        $('.station-card').each(function () {
            var card = this;
            var $track = $(card).find('.slide-track');
            var $btns = $(card).find('.card-nav button');
            var $fill = $(card).find('.progress-fill');
            var current = 0, paused = false, pauseTimeout;

            function goTo(i) {
                current = i;
                $track.css('transform', 'translateX(-' + (i * 100) + '%)');
                $btns.removeClass('active-nav');
                $btns.eq(i).addClass('active-nav');
                $fill.css('width', (((i + 1) / 4) * 100) + '%');
            }

            $btns.on('click', function () {
                goTo(parseInt($(this).data('idx')));
                paused = true;
                clearTimeout(pauseTimeout);
                pauseTimeout = setTimeout(function () { paused = false; }, 12000);
            });

            setInterval(function () { if (!paused) goTo((current + 1) % 4); }, 6000);
        });

        // Update summary cards
        updateSummaryCards();

        // Start polling for alerts
        fnAllSiteCheckChannelDown();
        setInterval(function () {
            fnAllSiteCheckChannelDown();
        }, dataInterval);

        // Periodic sound announcements
        setInterval(function () {
            if (typeof announceAlerts === 'function') announceAlerts();
        }, reminderFrequency);
    });

    // ===== Render Alert Cards in Now slide =====
    function renderAlertCards(siteId, alerts) {
        var $list = $('#alertList_' + siteId);
        if (!alerts || alerts.length === 0) {
            $list.html('<div class="alert-empty"><span style="font-size:22px;">✓</span><span>No active alerts</span></div>');
            return;
        }
        // Show last 4 alerts
        var last4 = alerts.slice(-4).reverse();
        var html = '';
        $.each(last4, function (i, a) {
            var isFailure = (a.AlertTypeId === 1);
            var badgeClass = isFailure ? 'failure' : 'predictive';
            var badgeText = isFailure ? 'FAILURE' : 'PREDICTIVE';
            var time = '';
            if (a.SetTimeStamp) {
                var d = new Date(a.SetTimeStamp);
                time = ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2) +
                       ' · ' + ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth() + 1)).slice(-2);
            }
            var msg = a.SetAlertMessage || a.Description || '';
            var cause = a.PossibleCause || '';
            var asset = a.AssetName || '';

            html += '<div class="alert-card">' +
                '<div class="ac-top">' +
                    '<span class="ac-badge ' + badgeClass + '">' + badgeText + '</span>' +
                    '<span class="ac-asset" title="' + asset + '">' + asset + '</span>' +
                    '<span class="ac-time">' + time + '</span>' +
                '</div>' +
                '<div class="ac-msg">' + msg + '</div>' +
                (cause ? '<div class="ac-cause">' + cause + '</div>' : '') +
            '</div>';
        });
        $list.html(html);
    }

    // ===== Fetch FRS Alerts for a site =====
    function fnFetchAlerts(siteId) {
        $.ajax({
            url: '/FRS25/UserSite/GetFRSAlertsBySite',
            type: 'Post',
            data: { siteId: siteId },
            success: function (alerts) {
                renderAlertCards(siteId, alerts);
            },
            error: function () {
                // Silently fail — keep existing content
            }
        });
    }

    // ===== Update Summary Cards =====
    function updateSummaryCards() {
        var totalFailure = 0, activeSirens = 0;
        $('.station-card').each(function () {
            if ($(this).hasClass('has-alert')) activeSirens++;
        });

        if (json && json.mSites) {
            $.each(json.mSites, function (i, site) {
                totalFailure += (site.TrackCount || 0) + (site.PointMachineCount || 0) + (site.SignalCount || 0);
            });
        }

        $('#summary-cards').html(
            '<div class="summary-card failure"><div class="num">' + totalFailure + '</div><div class="lbl">Total Alerts</div></div>' +
            '<div class="summary-card predictive"><div class="num">' + document.querySelectorAll('.station-card').length + '</div><div class="lbl">Sites</div></div>' +
            '<div class="summary-card sc-active"><div class="num">' + activeSirens + '</div><div class="lbl">Active Sirens</div></div>'
        );
    }

    // ===== Set card to ALERT state (only called on state TRANSITION) =====
    function setCardAlert(siteId, isAlert) {
        var $card = $('#divSite_' + siteId);
        var $boardWrap = $('#boardWrap_' + siteId);
        var $liquidPool = $('#liquidPool_' + siteId);
        var $statusLine = $('#statusLine_' + siteId);
        var $master = $('#master_' + siteId);
        var $progressFill = $card.find('.progress-fill');

        if (isAlert) {
            $card.addClass('has-alert');
            $boardWrap.removeClass('ok').addClass('alert');
            $liquidPool.removeClass('ok').addClass('alert');
            $liquidPool.html(waveSVG(true, siteId));
            $statusLine.removeClass('ok').addClass('alert');
            $('#statusTxt_' + siteId).text('Alert Active');
            $master.html(stationMasterSVG(true));
            $progressFill.removeClass('normal').addClass('alert');
            // Fetch alert details only once on transition
            fnFetchAlerts(siteId);
        } else {
            $card.removeClass('has-alert');
            $boardWrap.removeClass('alert').addClass('ok');
            $liquidPool.removeClass('alert').addClass('ok');
            $liquidPool.html(waveSVG(false, siteId));
            $statusLine.removeClass('alert').addClass('ok');
            $('#statusTxt_' + siteId).text('All Clear');
            $('#statusBadge_' + siteId).text('0 active');
            $master.html(stationMasterSVG(false));
            $progressFill.removeClass('alert').addClass('normal');
            renderAlertCards(siteId, []);
        }
    }

    // ===== Polling: Check alerts for all sites =====
    var _isPolling = false;

    function fnAllSiteCheckChannelDown() {
        // Prevent overlapping calls
        if (_isPolling) return;
        _isPolling = true;

        var siteIds = [];
        if (json && json.mSites) {
            $.each(json.mSites, function (id, item) {
                siteIds.push(item.Id);
            });
        }

        $.ajax({
            url: '/FRS25/UserSite/GetSMSLogList',
            type: 'Post',
            data: JSON.stringify(siteIds),
            contentType: 'application/json',
            success: function (smsSiteIds) {
                $("#loader").hide();
                var hasNewAlert = false;

                $('.station-card').each(function () {
                    var sid = $(this).data('siteid');
                    var wasAlert = $(this).hasClass('has-alert');
                    var isNowAlert = smsSiteIds && smsSiteIds.indexOf(sid) > -1;

                    // Only act on STATE CHANGES — don't touch cards that haven't changed
                    if (isNowAlert && !wasAlert) {
                        setCardAlert(sid, true);
                        hasNewAlert = true;
                    } else if (!isNowAlert && wasAlert) {
                        setCardAlert(sid, false);
                    }
                    // If still alerting (wasAlert && isNowAlert) — do nothing, card stays red
                });

                // Update badge counts for alerting sites
                if (smsSiteIds && smsSiteIds.length > 0) {
                    $.each(smsSiteIds, function (i, sid) {
                        $('#statusBadge_' + sid).text(smsSiteIds.length + ' active');
                    });
                }

                // Play sound ONLY when a NEW alert appears (not every poll)
                if (hasNewAlert && typeof playStationJingle === 'function' && typeof soundOn !== 'undefined' && soundOn) {
                    playStationJingle();
                    setTimeout(function () { if (typeof playAlertHorn === 'function') playAlertHorn(); }, 1000);
                }

                updateSummaryCards();
            },
            error: function () {
                $("#loader").hide();
            },
            complete: function () {
                // Release lock after request finishes (success or error)
                _isPolling = false;
            }
        });
    }
</script>
