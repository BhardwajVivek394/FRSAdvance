// ── Helpers ───────────────────────────────────────────────
function tryParseJson(str) {
  try { return JSON.parse(str); } catch(e) { return { raw: str }; }
}

function syntaxHighlightJson(json) {
  if (!json) return '';
  json = json.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  return json.replace(
    /("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g,
    function(match) {
      var cls = 'frs-json-num';
      if (/^"/.test(match)) {
        if (/:$/.test(match)) cls = 'frs-json-key';
        else cls = 'frs-json-str';
      } else if (/true|false/.test(match)) cls = 'frs-json-bool';
      else if (/null/.test(match)) cls = 'frs-json-null';
      return '<span class="' + cls + '">' + match + '</span>';
    }
  );
}


