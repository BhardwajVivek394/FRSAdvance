function escHtml(s) { if(!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function sanitizeMsg(s) {
  if (!s) return '';
  return escHtml(s).replace(/&lt;b&gt;/gi,'<b>').replace(/&lt;\/b&gt;/gi,'</b>');
}
function escJs(s) { if(!s) return ''; return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'"); }
function parseDMYDate(str) {
  var p=str.split(' '),d=p[0].split('/'),t=(p[1]||'00:00:00').split(':');
  return new Date(+d[2],+d[1]-1,+d[0],+t[0],+t[1],+t[2]).getTime();
}
function pad2(n) { return n<10?'0'+n:''+n; }
function fnShowAlertMessage(id) {
  var msg=$('#spnAlertmsg'+id).text().replace(/\n/g,'')+'<br>'+($('#spnAlertDescription'+id).html()||'').replace(/\n/g,'');
  var reset=$('#spnResetAlertmsg'+id).html();
  if(reset&&reset.trim()) msg+='<br><b>Reset Message</b><br>'+reset.replace(/\n/g,'');
  $('#spnAlertMessage').html(msg.replace(/\n/g,'<br>')); $('#modelShowAlertMessage').modal('show');
}

