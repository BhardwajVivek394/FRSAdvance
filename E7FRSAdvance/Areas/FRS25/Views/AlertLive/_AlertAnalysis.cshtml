// ── ② MQTT GRAPH ──────────────────────────────────────────
    // ── ② MQTT GRAPH — ECharts (same CSV source as Telemetry) ─
    var _mqttChart = null;

    function loadMqttTab(r) {
        var cid = 'frsDbgMqttContent';
        var startDate = formatDateTimeMinusForAPI(r.incDate, 30);
        var endDate = formatDateTimeAddForAPI(r.incDate, 30);

        document.getElementById(cid).innerHTML =
            '<div class="frs-tab-loading"><i class="fas fa-circle-notch spin"></i><p>Loading MQTT graph…</p></div>';

        $.ajax({
            url: '/FRS25/AlertLive/GetMQTTHistoryGraphData',
            type: 'POST',
            data: {
                siteId: r.siteId,
                assetId: r.assetId,
                startDate: startDate.toISOString(),
                endDate: endDate.toISOString()
            },
            dataType: 'json',
            success: function (csv) {
                if (!csv || csv.trim() === '') {
                    document.getElementById(cid).innerHTML =
                        '<div class="frs-tab-empty">' +
                        '<i class="fas fa-chart-line" style="font-size:28px;display:block;margin-bottom:8px;color:#cbd5e1"></i>' +
                        'No MQTT graph data available.</div>';
                    return;
                }
                renderMqttEChart(cid, csv, r);
            },
            error: function (xhr) {
                document.getElementById(cid).innerHTML =
                    '<div class="frs-tab-error">' +
                    '<i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>' +
                    'Failed to load MQTT graph data (HTTP ' + xhr.status + ').</div>';
            }
        });
    }

    function renderMqttEChart(cid, csv, r) {
        // ── 1. Parse CSV ──────────────────────────────────────────

        var lines = csv.trim().split('\n').filter(function (line) {
            return line.trim() !== '';
        });
        if (lines.length < 2) {
            document.getElementById(cid).innerHTML =
                '<div class="frs-tab-empty">No rows in MQTT data.</div>';
            return;
        }

        var headers = lines[0].split(',').map(function (h) { return h.trim(); });
        if (headers[headers.length - 1] === '') headers.pop();

        var dataStartIdx = 3; // skip Site Name, Date, Asset Type
        var xValues = [];
        var seriesMap = {};

        headers.slice(dataStartIdx).forEach(function (h) { seriesMap[h] = []; });

        for (var i = 1; i < lines.length; i++) {
            var cols = lines[i].split(',');
            if (cols[cols.length - 1].trim() === '') cols.pop();

            var rawDate = (cols[1] || '').trim();
            var parts = rawDate.split(' ');
            var timeLabel = parts.length >= 2 ? parts[1] + (parts[2] ? ' ' + parts[2] : '') : rawDate;
            xValues.push(timeLabel);

            headers.slice(dataStartIdx).forEach(function (h, hi) {
                var val = parseFloat((cols[dataStartIdx + hi] || '').trim());
                seriesMap[h].push(isNaN(val) ? null : val);
            });
        }

        // ── 2. Build series with dual axis ───────────────────────
        var colors = [
            '#4bacc6', '#e74c3c', '#2ecc71', '#f39c12', '#9b59b6',
            '#1abc9c', '#e67e22', '#3498db', '#e91e63', '#00bcd4', '#ff5722'
        ];

        var series = [];
        var legends = [];
        var laryMax = 0;
        var raryMax = 0;
        var colorIdx = 0;

        headers.slice(dataStartIdx).forEach(function (colName) {
            var values = seriesMap[colName];
            var hasV = colName.indexOf('V') > -1;
            var axisIdx = hasV ? 1 : 0;

            var colMax = Math.max.apply(null, values.filter(function (v) { return v !== null; }).concat([0]));
            if (axisIdx === 0 && colMax > laryMax) laryMax = colMax;
            if (axisIdx === 1 && colMax > raryMax) raryMax = colMax;

            legends.push(colName);
            series.push({
                name: colName,
                type: 'line',
                smooth: false,
                symbol: 'none',
                connectNulls: true,
                yAxisIndex: axisIdx,
                lineStyle: { width: 1.5 },
                itemStyle: { color: colors[colorIdx % colors.length] },
                color: colors[colorIdx % colors.length],
                data: values
            });
            colorIdx++;
        });

        // ── 3. Build container HTML ───────────────────────────────
        document.getElementById(cid).innerHTML =
            '<div style="padding:4px 0 8px;">' +
            '<div style="font-size:11px;color:#64748b;margin-bottom:6px;">' +
            '<i class="fas fa-chart-line" style="margin-right:4px;color:#0077cc"></i>' +
            'Asset: <b>' + escHtml(r.assetNo || ('Asset ' + r.assetId)) + '</b>' +
            ' &nbsp;|&nbsp; Station: <b>' + escHtml(r.station || '') + '</b>' +
            ' &nbsp;|&nbsp; ' + xValues.length + ' data points' +
            '</div>' +
            '<div id="frsDbgMqttChart" style="width:100%;height:340px;"></div>' +
            '<div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">' +
            '<button class="frs-btn-debug" id="mqttBtnAll" ' +
            'style="background:#0077cc;color:#fff;border-color:#0077cc" ' +
            'onclick="mqttChartFilter(\'all\')">All Series</button>' +
            '<button class="frs-btn-debug" id="mqttBtnMA" onclick="mqttChartFilter(\'ma\')">' +
            '<i class="fas fa-bolt"></i> mA Only</button>' +
            '<button class="frs-btn-debug" id="mqttBtnV"  onclick="mqttChartFilter(\'v\')">' +
            '<i class="fas fa-wave-square"></i> Voltage Only</button>' +
            '</div>' +
            '</div>';

        // ── 4. Init ECharts ───────────────────────────────────────
        if (_mqttChart) {
            try { _mqttChart.dispose(); } catch (e) { }
            _mqttChart = null;
        }

        function initMqttChart() {
            var dom = document.getElementById('frsDbgMqttChart');
            if (!dom) return;

            _mqttChart = echarts.init(dom, null, { renderer: 'canvas' });
            window._mqttSeriesAll = series; // keep for filter

            _mqttChart.setOption({
                backgroundColor: 'transparent',
                tooltip: {
                    trigger: 'axis',
                    confine: true,
                    axisPointer: {
                        type: 'cross',
                        label: { backgroundColor: '#1e293b' }
                    },
                    formatter: function (params) {
                        var html = '<div style="font-size:11px;min-width:180px;">' +
                            '<div style="font-weight:700;color:#1e293b;margin-bottom:5px;' +
                            'padding-bottom:4px;border-bottom:1px solid #e2e8f0">' +
                            params[0].axisValue + '</div>';
                        params.forEach(function (p) {
                            if (p.value === null) return;
                            html +=
                                '<div style="display:flex;justify-content:space-between;gap:16px;margin:2px 0">' +
                                '<span>' + p.marker + p.seriesName + '</span>' +
                                '<span style="font-weight:700;font-family:monospace">' + p.value + '</span>' +
                                '</div>';
                        });
                        return html + '</div>';
                    }
                },
                legend: {
                    data: legends,
                    type: 'scroll',
                    top: 0,
                    left: 0,
                    right: 40,
                    textStyle: { fontSize: 10, color: '#475569' },
                    itemWidth: 12,
                    itemHeight: 8,
                    pageTextStyle: { color: '#6b7280' }
                },
                toolbox: {
                    right: 4,
                    top: 0,
                    feature: {
                        dataZoom: { yAxisIndex: 'none', title: { zoom: 'Zoom', back: 'Undo' } },
                        restore: { title: 'Restore' },
                        saveAsImage: { title: 'Save PNG' }
                    }
                },
                grid: {
                    top: 50,
                    left: 60,
                    right: 60,
                    bottom: 60,
                    containLabel: false
                },
                xAxis: [{
                    type: 'category',
                    boundaryGap: false,
                    data: xValues,
                    axisLine: { lineStyle: { color: '#d1dce8' } },
                    axisLabel: {
                        fontSize: 9,
                        color: '#6b7280',
                        rotate: 30,
                        interval: Math.max(0, Math.floor(xValues.length / 12) - 1)
                    },
                    splitLine: { show: false }
                }],
                yAxis: [
                    {
                        // LEFT — mA
                        type: 'value',
                        name: 'mA',
                        nameTextStyle: { fontSize: 10, color: '#475569', padding: [0, 0, 0, -30] },
                        min: 0,
                        max: Math.ceil(laryMax * 1.05) || 1500,
                        axisLine: { lineStyle: { color: '#d1dce8' } },
                        axisLabel: { fontSize: 9, color: '#475569' },
                        splitLine: { lineStyle: { color: '#f1f5f9', type: 'dashed' } }
                    },
                    {
                        // RIGHT — Voltage
                        type: 'value',
                        name: 'V',
                        nameTextStyle: { fontSize: 10, color: '#475569', padding: [0, -20, 0, 0] },
                        min: 0,
                        max: Math.ceil(raryMax * 1.1) || 120,
                        axisLine: { lineStyle: { color: '#d1dce8' } },
                        axisLabel: { fontSize: 9, color: '#475569' },
                        splitLine: { show: false }
                    }
                ],
                dataZoom: [
                    {
                        type: 'slider',
                        bottom: 4,
                        height: 22,
                        start: 0,
                        end: 100,
                        fillerColor: 'rgba(0,119,204,0.08)',
                        borderColor: '#d1dce8',
                        handleStyle: { color: '#0077cc' },
                        textStyle: { color: '#6b7280', fontSize: 9 }
                    },
                    { type: 'inside', start: 0, end: 100 }
                ],
                color: colors,
                series: series
            });

            setTimeout(function () {
                if (_mqttChart) _mqttChart.resize();
            }, 100);
        }

        if (typeof echarts !== 'undefined') {
            initMqttChart();
        } else {
            var s = document.createElement('script');
            s.src = 'https://cdnjs.cloudflare.com/ajax/libs/echarts/5.4.3/echarts.min.js';
            s.onload = function () { initMqttChart(); };
            document.head.appendChild(s);
        }
    }

    // ── MQTT filter buttons ───────────────────────────────────
    function mqttChartFilter(type) {
        if (!_mqttChart || !window._mqttSeriesAll) return;

        var btnMap = { all: 'mqttBtnAll', ma: 'mqttBtnMA', v: 'mqttBtnV' };
        Object.keys(btnMap).forEach(function (k) {
            var el = document.getElementById(btnMap[k]);
            if (!el) return;
            var active = (k === type);
            el.style.background = active ? '#0077cc' : '';
            el.style.color = active ? '#fff' : '';
            el.style.borderColor = active ? '#0077cc' : '';
        });

        var filtered = window._mqttSeriesAll.filter(function (s) {
            if (type === 'all') return true;
            var hasV = s.name.indexOf('V') > -1;
            return type === 'v' ? hasV : !hasV;
        });

        _mqttChart.setOption({ series: filtered }, { replaceMerge: ['series'] });
    }

    // ── ③ DATALOGGER LOG ──────────────────────────────────────
    function loadDataloggerTab(r) {
        var cid = 'frsDbgDataloggerContent';
        var startDate = formatDateTimeMinusForAPI(r.incDate, 30);
        var endDate = formatDateTimeAddForAPI(r.incDate, 30);

        document.getElementById(cid).innerHTML =
            '<div class="frs-tab-loading"><i class="fas fa-circle-notch spin"></i><p>Loading datalogger data…</p></div>';

        $.ajax({
            url: '/FRS25/AlertLive/GeDataLoggerJSONData',
            type: 'POST',
            data: {
                siteId: r.siteId,
                assetId: r.assetId,
                startDate: startDate.toISOString(),
                endDate: endDate.toISOString()
            },
            success: function (data) {
                if (!data || (Array.isArray(data) && data.length === 0)) {
                    document.getElementById(cid).innerHTML =
                        '<div class="frs-tab-empty">' +
                        '<i class="fas fa-database" style="font-size:28px;display:block;margin-bottom:8px;color:#cbd5e1"></i>' +
                        'No datalogger log entries.</div>';
                    return;
                }

                var rows = Array.isArray(data) ? data : (data.logs || data.Logs || data.data || [data]);

                // ── Sort by Timestamp DESCENDING ──────────────────────────
                rows.sort(function (a, b) {
                    var tsA = new Date(a.Timestamp || a.timestamp || 0);
                    var tsB = new Date(b.Timestamp || b.timestamp || 0);
                    return tsB.getTime() - tsA.getTime();
                });

                if (!rows || rows.length === 0) {
                    document.getElementById(cid).innerHTML =
                        '<div class="frs-tab-empty">' +
                        '<i class="fas fa-database" style="font-size:28px;display:block;margin-bottom:8px;color:#cbd5e1"></i>' +
                        'No datalogger log entries.</div>';
                    return;
                }

                // ── Build table ────────────────────────────────
                var html =
                    '<div style="overflow-x:auto;">' +
                    '<div style="font-size:11px;color:#64748b;margin-bottom:8px;padding:4px 0;">' +
                    '<i class="fas fa-database" style="margin-right:4px;color:#0077cc"></i>' +
                    'Asset: <b>' + escHtml(r.assetNo || '') + '</b>' +
                    ' &nbsp;|&nbsp; Station: <b>' + escHtml(r.station || '') + '</b>' +
                    ' &nbsp;|&nbsp; <b>' + rows.length + '</b> records' +
                    '</div>' +

                    // ── inline styles scoped to this table ──
                    '<style>' +
                    '#dlTable { width:100%; border-collapse:collapse; font-size:12px; }' +
                    '#dlTable thead tr { background:#1a6b64; }' +
                    '#dlTable thead th { padding:10px 12px; text-align:left; font-size:11px; font-weight:700; color:#fff; white-space:nowrap; letter-spacing:.04em; }' +
                    '#dlTable tbody tr { border-bottom:1px solid #e5edf5; transition:background .12s; }' +
                    '#dlTable tbody tr:hover { background:#f0f7ff; }' +
                    '#dlTable tbody td { padding:9px 12px; white-space:nowrap; color:#1e293b; font-size:12px; }' +
                    '.dl-badge { display:inline-block; padding:3px 10px; border-radius:4px; font-size:11px; font-weight:700; letter-spacing:.04em; }' +
                    '.dl-pickup { background:#16a34a; color:#fff; }' +
                    '.dl-drop   { background:#f59e0b; color:#fff; }' +
                    '.dl-other  { background:#64748b; color:#fff; }' +
                    '</style>' +

                    '<table id="dlTable">' +
                    '<thead><tr>' +
                    '<th>SR No.</th>' +
                    '<th>Asset</th>' +
                    '<th>Attribute</th>' +
                    '<th>Current Value</th>' +
                    '<th>Time Stamp</th>' +
                    '<th>Update Time</th>' +
                    '</tr></thead>' +
                    '<tbody>';

                rows.forEach(function (row) {
                    // ── Current Value badge ──
                    var rawVal = (row.CurrentValue || row.currentValue || '').toString().trim();
                    var valHtml = '';
                    var valLow = rawVal.toLowerCase();

                    if (valLow === '1' || valLow === 'pickup') {
                        valHtml = '<span class="dl-badge dl-pickup">Pickup</span>';
                    } else if (valLow === '0' || valLow === 'drop') {
                        valHtml = '<span class="dl-badge dl-drop">DROP</span>';
                    } else if (rawVal !== '') {
                        valHtml = '<span class="dl-badge dl-other">' + escHtml(rawVal) + '</span>';
                    } else {
                        valHtml = '<span style="color:#94a3b8">—</span>';
                    }

                    // ── Timestamp (full with ms) ──
                    var ts = row.Timestamp || row.timestamp || '';
                    var updTime = row.CurrentDate || row.currentDate || row.Date || row.date || '';
                    // ── Fix ASP.NET /Date(ms)/ format ──────────────────────
                    if (updTime && typeof updTime === 'string' && updTime.indexOf('/Date(') > -1) {
                        var ms = parseInt(updTime.replace('/Date(', '').replace(')/', ''));
                        if (!isNaN(ms)) updTime = new Date(ms);
                    }

                    // Format UpdateTime: show only date + HH:MM
                    var updFormatted = '';
                    if (updTime) {
                        try {
                            var d = new Date(updTime);
                            if (!isNaN(d.getTime())) {
                                var day = pad2(d.getDate());
                                var mon = pad2(d.getMonth() + 1);
                                var yr = d.getFullYear();
                                var hh = pad2(d.getHours());
                                var mm = pad2(d.getMinutes());
                                var ampm = d.getHours() >= 12 ? 'PM' : 'AM';
                                var hr12 = d.getHours() % 12 || 12;
                                var ss = pad2(d.getSeconds());
                                updFormatted = day + '/' + mon + '/' + yr + ' ' + pad2(hr12) + ':' + mm + ':' + ss + ' ' + ampm;
                            } else {
                                updFormatted = escHtml(String(updTime));
                            }
                        } catch (e) { updFormatted = escHtml(String(updTime)); }
                    }

                    html +=
                        '<tr>' +
                        '<td style="font-family:monospace;color:#6b7280">' + escHtml(String(row.SrNo || row.srNo || '')) + '</td>' +
                        '<td style="font-weight:600">' + escHtml(row.AssetName || row.assetName || '-') + '</td>' +
                        '<td style="color:#475569">' + escHtml(row.AttributeName || row.attributeName || '-') + '</td>' +
                        '<td>' + valHtml + '</td>' +
                        '<td style="font-family:monospace;font-size:11px;color:#475569">' + escHtml(String(ts)) + '</td>' +
                        '<td style="font-family:monospace;font-size:11px;color:#475569">' + updFormatted + '</td>' +
                        '</tr>';
                });

                html += '</tbody></table></div>';
                document.getElementById(cid).innerHTML = html;
            },
            error: function (xhr) {
                document.getElementById(cid).innerHTML =
                    '<div class="frs-tab-error">' +
                    '<i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>' +
                    'Failed to load datalogger log (HTTP ' + xhr.status + ').</div>';
            }
        });
    }

