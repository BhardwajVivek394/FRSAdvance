    // ── Build light-theme card grid from object ───────────────
    function buildJsonBoxGrid(obj) {
        if (!obj || typeof obj !== 'object') return '';

        var triggerVal = null;
        var flatKeys = [];
        var sectionKeys = {};

        var attributesArr = null;

        Object.keys(obj).forEach(function (k) {
            var v = obj[k];
            if (k === 'Trigger' && v && typeof v === 'object') {
                triggerVal = v;
            } else if (k === 'Attributes' && Array.isArray(v)) {
                attributesArr = v;
            } else if (v !== null && typeof v === 'object' && !Array.isArray(v)) {
                sectionKeys[k] = v;
            } else {
                flatKeys.push(k);
            }
        });

        var html = '';

        // ── ① Flat key/value cards ────────────────────────────
        if (flatKeys.length > 0) {
            html += '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px;">';
            flatKeys.forEach(function (k) {
                html += buildSingleBox(k, obj[k]);
            });
            html += '</div>';
        }

        // ── ② Trigger section ─────────────────────────────────
        if (triggerVal) {
            html +=
                '<div style="margin-bottom:12px;">' +
                '<div style="font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;' +
                'color:#6b7280;margin-bottom:8px;display:flex;align-items:center;gap:6px;">' +
                '<i class="fas fa-bolt" style="color:#d97706"></i>TRIGGERING CONDITION' +
                '</div>' +
                '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">' +
                buildSingleBox('Cause Code', triggerVal.CauseCode || '-') +
                buildSingleBox('Attribute', triggerVal.Attribute || '-') +
                buildSingleBox('Value', triggerVal.Value !== undefined ? triggerVal.Value : '-') +
                buildSingleBox('Threshold (LD1)', triggerVal.Threshold !== undefined ? triggerVal.Threshold : '-') +
                buildSingleBox('Comparison',
                    (triggerVal.Value || '') + ' ' +
                    (triggerVal.Comparison || '') + ' ' +
                    (triggerVal.Threshold || '')) +
                buildSingleBox('Threshold Type',
                    triggerVal.IsLowerThreshold ? 'Lower (LD1)' : 'Upper',
                    triggerVal.IsLowerThreshold ? 'fail' : 'ok') +
                '</div>' +
                '</div>';
        }

        // ── ③ Attributes array table ──────────────────────────
        if (attributesArr && attributesArr.length > 0) {
            html +=
                '<div style="margin-bottom:12px;">' +
                '<div style="font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;' +
                'color:#6b7280;margin-bottom:8px;display:flex;align-items:center;gap:6px;">' +
                '<i class="fas fa-list" style="color:#0077cc"></i>ATTRIBUTES' +
                ' <span style="font-weight:400;color:#94a3b8">(' + attributesArr.length + ' items)</span>' +
                '</div>' +
                '<div style="overflow-x:auto;border:1px solid #e2e8f0;border-radius:8px;">' +
                '<table style="width:100%;border-collapse:collapse;font-size:11px;">' +
                '<thead>' +
                '<tr style="background:#1e3a5f;">' +
                '<th style="padding:8px 10px;color:#fff;font-size:10px;font-weight:700;letter-spacing:.06em;text-align:left;white-space:nowrap;border-right:1px solid #2d5a8e;">ID</th>' +
                '<th style="padding:8px 10px;color:#fff;font-size:10px;font-weight:700;letter-spacing:.06em;text-align:left;white-space:nowrap;border-right:1px solid #2d5a8e;">Attribute Name</th>' +
                '<th style="padding:8px 10px;color:#fff;font-size:10px;font-weight:700;letter-spacing:.06em;text-align:left;white-space:nowrap;border-right:1px solid #2d5a8e;">Value</th>' +
                '<th style="padding:8px 10px;color:#fff;font-size:10px;font-weight:700;letter-spacing:.06em;text-align:left;white-space:nowrap;border-right:1px solid #2d5a8e;">Timestamp</th>' +
                '<th style="padding:8px 10px;color:#fff;font-size:10px;font-weight:700;letter-spacing:.06em;text-align:left;white-space:nowrap;border-right:1px solid #2d5a8e;">EdgeX Time</th>' +
                '<th style="padding:8px 10px;color:#fff;font-size:10px;font-weight:700;letter-spacing:.06em;text-align:left;white-space:nowrap;border-right:1px solid #2d5a8e;">Source</th>' +
                '<th style="padding:8px 10px;color:#fff;font-size:10px;font-weight:700;letter-spacing:.06em;text-align:left;white-space:nowrap;">Fresh</th>' +
                '</tr>' +
                '</thead>' +
                '<tbody>';

            attributesArr.forEach(function (attr, idx) {
                var bg = idx % 2 === 0 ? '#fff' : '#f8fafc';

                // Format timestamps
                function fmtTs(ts) {
                    if (!ts) return '<span style="color:#94a3b8">—</span>';
                    try {
                        var d = new Date(ts);
                        if (isNaN(d.getTime())) return escHtml(ts);
                        return '<span style="font-family:monospace;font-size:10px;color:#475569">' +
                            pad2(d.getDate()) + '/' + pad2(d.getMonth() + 1) + '/' + d.getFullYear() +
                            '<br>' + pad2(d.getHours()) + ':' + pad2(d.getMinutes()) + ':' + pad2(d.getSeconds()) +
                            '</span>';
                    } catch (e) { return escHtml(ts); }
                }

                // Value coloring
                var rawVal = attr.value !== null && attr.value !== undefined ? String(attr.value) : null;
                var valHtml = '';

                if (rawVal === null || rawVal === 'null') {
                    valHtml = '<span style="color:#94a3b8;font-style:italic">null</span>';
                } else if (rawVal.toLowerCase() === 'pickup') {
                    valHtml = '<span style="background:#16a34a;color:#fff;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700;">Pickup</span>';
                } else if (rawVal.toLowerCase() === 'drop') {
                    valHtml = '<span style="background:#f59e0b;color:#fff;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700;">DROP</span>';
                } else {
                    var num = parseFloat(rawVal);
                    var isDL = (attr.dataSource || '').toString().toUpperCase() === 'DL';
                    if (!isNaN(num)) {
                        if (isDL && num === 1) {
                            // DL source + value 1/1.0 → Pickup
                            valHtml = '<span style="background:#16a34a;color:#fff;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700;">Pickup</span>';
                        } else if (isDL && num === 0) {
                            // DL source + value 0/0.0 → DROP
                            valHtml = '<span style="background:#f59e0b;color:#fff;padding:2px 8px;border-radius:4px;font-size:10px;font-weight:700;">DROP</span>';
                        } else {
                            // Non-DL source or decimal → show as number
                            var numColor = num < 0 ? '#dc2626' : '#0077cc';
                            var decVal = Number.isInteger(num) ? String(num) : num.toString();
                            valHtml = '<span style="font-family:monospace;font-weight:700;color:' + numColor + '">' + escHtml(decVal) + '</span>';
                        }
                    } else {
                        valHtml = '<span style="font-weight:600;color:#1e293b;">' + escHtml(rawVal) + '</span>';
                    }
                }

                // Fresh badge
                var freshHtml = attr.isFresh
                    ? '<span style="background:#dcfce7;color:#166534;border:1px solid #86efac;padding:2px 7px;border-radius:4px;font-size:10px;font-weight:700;">Yes</span>'
                    : '<span style="background:#f1f5f9;color:#64748b;border:1px solid #cbd5e1;padding:2px 7px;border-radius:4px;font-size:10px;font-weight:700;">No</span>';

                // Source badge
                var srcColor = (attr.source || '').toLowerCase() === 'websocket' ? '#0369a1' : '#475569';
                var srcBg = (attr.source || '').toLowerCase() === 'websocket' ? '#e0f2fe' : '#f1f5f9';
                var srcBorder = (attr.source || '').toLowerCase() === 'websocket' ? '#bae6fd' : '#cbd5e1';
                var srcHtml = attr.source
                    ? '<span style="background:' + srcBg + ';color:' + srcColor + ';border:1px solid ' + srcBorder + ';' +
                    'padding:2px 7px;border-radius:4px;font-size:10px;font-weight:600;">' + escHtml(attr.source) + '</span>'
                    : '<span style="color:#94a3b8">—</span>';

                var tdBase = 'padding:8px 10px;border-bottom:1px solid #e5edf5;border-right:1px solid #f1f5f9;vertical-align:middle;';

                html +=
                    '<tr style="background:' + bg + '">' +
                    '<td style="' + tdBase + 'font-family:monospace;color:#6b7280;font-size:10px;">' + escHtml(String(attr.attributeId || '')) + '</td>' +
                    '<td style="' + tdBase + 'font-weight:600;color:#1e293b;white-space:nowrap;">' + escHtml(attr.attributeName || '-') + '</td>' +
                    '<td style="' + tdBase + '">' + valHtml + '</td>' +
                    '<td style="' + tdBase + '">' + fmtTs(attr.timestamp) + '</td>' +
                    '<td style="' + tdBase + '">' + fmtTs(attr.timestampEdgeX) + '</td>' +
                    '<td style="' + tdBase + '">' + srcHtml + '</td>' +
                    '<td style="padding:8px 10px;border-bottom:1px solid #e5edf5;vertical-align:middle;">' + freshHtml + '</td>' +
                    '</tr>';
            });

            html += '</tbody></table></div></div>';
        }

        // ── ③ Other nested objects ────────────────────────────
        Object.keys(sectionKeys).forEach(function (sk) {
            var sub = sectionKeys[sk];
            html +=
                '<div style="margin-bottom:12px;">' +
                '<div style="font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;' +
                'color:#6b7280;margin-bottom:8px;">' + escHtml(sk) + '</div>' +
                '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;">';
            Object.keys(sub).forEach(function (subK) {
                html += buildSingleBox(subK, sub[subK]);
            });
            html += '</div></div>';
        });

        return html;
    }

    // ── Single light-theme box card ───────────────────────────
    function buildSingleBox(label, val, hint) {
        var displayVal = '';

        if (val === null || val === undefined) {
            displayVal = '<span style="color:#94a3b8;font-style:italic">null</span>';

        } else if (typeof val === 'boolean') {
            displayVal = val
                ? '<span style="color:#16a34a;font-weight:700">true</span>'
                : '<span style="color:#dc2626;font-weight:700">false</span>';

        } else if (typeof val === 'number') {
            var numColor = val < 0 ? '#dc2626' : '#0077cc';
            displayVal = '<span style="color:' + numColor + ';font-weight:700;font-family:monospace">' +
                escHtml(String(val)) + '</span>';

        } else if (typeof val === 'string' && val.match(/^\d{4}-\d{2}-\d{2}T/)) {
            try {
                var d = new Date(val);
                var ds = pad2(d.getDate()) + '/' + pad2(d.getMonth() + 1) + '/' + d.getFullYear() +
                    ' ' + pad2(d.getHours()) + ':' + pad2(d.getMinutes()) + ':' + pad2(d.getSeconds());
                displayVal = '<span style="color:#7c3aed;font-size:11px;font-family:monospace">' + escHtml(ds) + '</span>';
            } catch (e) {
                displayVal = '<span style="color:#7c3aed">' + escHtml(String(val)) + '</span>';
            }

        } else {
            // hint = 'fail' → red, 'ok' → green, default → dark
            var strColor = hint === 'fail' ? '#dc2626'
                : hint === 'ok' ? '#16a34a'
                    : '#1e293b';
            displayVal = '<span style="color:' + strColor + ';font-weight:600">' +
                escHtml(String(val)) + '</span>';
        }

        return (
            '<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;' +
            'padding:10px 12px;display:flex;flex-direction:column;gap:5px;">' +
            '<div style="font-size:9px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;' +
            'color:#94a3b8;">' + escHtml(String(label)) + '</div>' +
            '<div style="font-size:13px;line-height:1.3;word-break:break-all;">' + displayVal + '</div>' +
            '</div>'
        );
    }

    // ── Build a two-column key/value card from parsed JSON obj ─
    function buildJsonCard(obj) {
        if (!obj || typeof obj !== 'object') {
            return '<div class="frs-json-wrap"><pre>' + syntaxHighlightJson(JSON.stringify(obj, null, 2)) + '</pre></div>';
        }

        var html =
            '<div style="border:1px solid #e2e8f0;border-radius:8px;overflow:hidden;">' +
            '<table style="width:100%;border-collapse:collapse;font-size:11px;">';

        Object.keys(obj).forEach(function (key, idx) {
            var val = obj[key];
            var isEven = idx % 2 === 0;
            var bgColor = isEven ? '#f8fafc' : '#fff';

            // Special rendering
            var valHtml = '';

            if (key === 'Trigger' && val !== null && typeof val === 'object') {
                // Render Trigger block as a nested mini-card
                valHtml = buildTriggerBadge(val);
            } else if (val === null || val === undefined) {
                valHtml = '<span style="color:#94a3b8;font-style:italic">null</span>';
            } else if (typeof val === 'boolean') {
                valHtml = val
                    ? '<span style="background:#dcfce7;color:#166534;border:1px solid #86efac;' +
                    'padding:2px 8px;border-radius:4px;font-weight:700;font-size:10px;">true</span>'
                    : '<span style="background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;' +
                    'padding:2px 8px;border-radius:4px;font-weight:700;font-size:10px;">false</span>';
            } else if (typeof val === 'number') {
                valHtml = '<span style="font-family:monospace;font-weight:600;color:#0077cc">' +
                    escHtml(String(val)) + '</span>';
            } else if (typeof val === 'string' && val.match(/^\d{4}-\d{2}-\d{2}T/)) {
                // ISO date
                valHtml = '<span style="font-family:monospace;color:#7c3aed">' + escHtml(val) + '</span>';
            } else {
                valHtml = '<span style="color:#1e293b">' + escHtml(String(val)) + '</span>';
            }

            html +=
                '<tr style="background:' + bgColor + ';border-bottom:1px solid #e5edf5;">' +
                '<td style="padding:7px 12px;width:38%;font-weight:600;color:#475569;' +
                'font-size:10px;letter-spacing:.04em;border-right:1px solid #e5edf5;' +
                'white-space:nowrap;vertical-align:top;">' +
                escHtml(key) +
                '</td>' +
                '<td style="padding:7px 12px;vertical-align:top;">' + valHtml + '</td>' +
                '</tr>';
        });

        html += '</table></div>';
        return html;
    }

    // ── Render Trigger object as a styled badge block ──────────
    function buildTriggerBadge(trigger) {
        if (!trigger) return '<span style="color:#94a3b8;font-style:italic">null</span>';
        return (
            '<div style="background:#fffbeb;border:1px solid #fde68a;border-radius:6px;' +
            'padding:8px 12px;display:inline-flex;flex-wrap:wrap;gap:8px;align-items:center;">' +

            // Cause Code
            '<span style="background:#1e293b;color:#f8fafc;padding:3px 9px;' +
            'border-radius:4px;font-size:10px;font-weight:700;">' +
            escHtml(trigger.CauseCode || '-') +
            '</span>' +

            // Attribute
            '<span style="background:#e0f2fe;color:#0369a1;padding:3px 9px;' +
            'border-radius:4px;font-size:10px;font-weight:600;">' +
            '<i class="fas fa-tag" style="margin-right:3px;font-size:9px"></i>' +
            escHtml(trigger.Attribute || '-') +
            '</span>' +

            // Comparison expression: Value Comparison Threshold
            '<span style="font-family:monospace;font-size:11px;font-weight:700;color:#b45309;">' +
            escHtml(String(trigger.Value || '')) + ' ' +
            escHtml(trigger.Comparison || '') + ' ' +
            escHtml(String(trigger.Threshold || '')) +
            '</span>' +

            // IsLowerThreshold flag
            '<span style="background:' + (trigger.IsLowerThreshold ? '#fee2e2' : '#f0fdf4') + ';' +
            'color:' + (trigger.IsLowerThreshold ? '#991b1b' : '#166534') + ';' +
            'border:1px solid ' + (trigger.IsLowerThreshold ? '#fca5a5' : '#86efac') + ';' +
            'padding:2px 8px;border-radius:4px;font-size:10px;font-weight:600;">' +
            (trigger.IsLowerThreshold ? 'Lower Threshold' : 'Upper Threshold') +
            '</span>' +

            '</div>'
        );
    }

    // ── Count top-level keys in an object ─────────────────────
    function countKeys(obj) {
        if (!obj || typeof obj !== 'object') return '0 fields';
        return Object.keys(obj).length + ' fields';
    }

    // ── ⑥ DEBUG TPR — Telemetry Table (AssetTypeId=1 & Failure only) ──
    function loadDebugtprTab(r) {
        var cid = 'frsDbgDebugtprContent';
        // ── Guard: only show for AssetTypeId=1 AND Failure ────────
        // r.assetTypeId must equal 1 AND r.alertType must be 'Failure'
        var assetTypeId = parseInt(r.assetTypeId || r.AssetTypeId || 0);
        var alertType = (r.alertType || '').toString().trim();

        if (assetTypeId !== 1 || alertType !== 'Failure') {
            document.getElementById(cid).innerHTML =
                '<div class="frs-tab-empty">' +
                '<i class="fas fa-broadcast-tower" style="font-size:28px;display:block;margin-bottom:10px;color:#cbd5e1"></i>' +
                '<div style="font-weight:600;color:#94a3b8;margin-bottom:6px;">Not Applicable</div>' +
                '<div style="font-size:11px;color:#b0bec5">' +
                'Debug TPR is only available for<br>' +
                '<b>Asset Type ID = 1</b> and <b>Alert Type = Failure</b>.<br><br>' +
                'Current record: AssetTypeId = <b>' + (r.assetTypeId || '-') + '</b>' +
                ' &nbsp;|&nbsp; Alert Type = <b>' + alertType + '</b>' +
                '</div>' +
                '</div>';
            return;
        }

        // ── Load telemetry CSV & render as HTML table ──────────────
        var startDate = formatDateTimeMinusForAPI(r.incDate, 30);
        var endDate = formatDateTimeAddForAPI(r.incDate, 30);

        document.getElementById(cid).innerHTML =
            '<div class="frs-tab-loading"><i class="fas fa-circle-notch spin"></i><p>Loading TPR telemetry data…</p></div>';

        $.ajax({
            url: '/FRS25/AlertLive/GetTPRJSONData',
            type: 'POST',
            data: {
                siteId: r.siteId,
                assetId: r.assetId,
                startDate: startDate.toISOString(),
                endDate: endDate.toISOString()
            },
            dataType: 'json',
            success: function (csv) {
                if (!csv || csv.trim() === '') {
                    document.getElementById(cid).innerHTML =
                        '<div class="frs-tab-empty">' +
                        '<i class="fas fa-broadcast-tower" style="font-size:28px;display:block;margin-bottom:8px;color:#cbd5e1"></i>' +
                        'No TPR telemetry data available.</div>';
                    return;
                }

                var lines = csv.trim().split('\n').filter(function (l) { return l.trim() !== ''; });
                if (lines.length < 2) {
                    document.getElementById(cid).innerHTML =
                        '<div class="frs-tab-empty">No rows in TPR telemetry data.</div>';
                    return;
                }

                var headers = lines[0].split(',').map(function (h) { return h.trim(); });
                if (headers[headers.length - 1] === '') headers.pop();

                // ── Parse rows into array ──────────────────────────────
                var dataRows = [];
                for (var i = 1; i < lines.length; i++) {
                    var cols = lines[i].split(',');
                    if (cols[cols.length - 1].trim() === '') cols.pop();
                    dataRows.push(cols);
                }

                // ── ① Sort by Date (col index 1) DESCENDING ───────────
                dataRows.sort(function (a, b) {
                    return new Date((b[1] || '').trim()) - new Date((a[1] || '').trim());
                });

                // ── ② Build col widths ─────────────────────────────────
                var colWidths = headers.map(function (h, ci) {
                    if (ci === 1) return 165;
                    if (ci === 0 || ci === 2) return 85;
                    return 90;
                });
                var totalW = colWidths.reduce(function (a, b) { return a + b; }, 0);

                // ── ③ Colgroup HTML ────────────────────────────────────
                var colGroupHtml = '<colgroup>';
                colWidths.forEach(function (w) {
                    colGroupHtml += '<col style="width:' + w + 'px;min-width:' + w + 'px">';
                });
                colGroupHtml += '</colgroup>';

                // ── ④ Fixed header table ───────────────────────────────
                var thStyle = [
                    'background:#1e3a5f',
                    'color:#fff',
                    'padding:9px 10px',
                    'font-size:10px',
                    'font-weight:700',
                    'letter-spacing:.06em',
                    'text-transform:uppercase',
                    'white-space:normal',
                    'overflow:hidden',
                    'text-overflow:ellipsis',
                    'max-width:140px',
                    'word-break:break-word',
                    'border-right:1px solid #2d5a8e',
                    'border-bottom:2px solid #dc2626',
                    'text-align:left'
                ].join(';');

                var headerHtml = '<thead><tr>';
                headers.forEach(function (h) {
                    headerHtml += '<th style="' + thStyle + '" title="' + escHtml(h.trim()) + '">' + escHtml(h) + '</th>';
                });
                headerHtml += '</tr></thead>';

                // ── ⑤ Body rows ────────────────────────────────────────
                var bodyHtml = '<tbody>';
                dataRows.forEach(function (cols, ri) {
                    bodyHtml += '<tr style="background:' + (ri % 2 === 0 ? '#fff' : '#f8fafc') + '">';
                    cols.forEach(function (col, ci) {
                        var val = col.trim();
                        var valLow = val.toLowerCase();
                        var tdStyle = 'padding:7px 10px;border-bottom:1px solid #e5edf5;border-right:1px solid #f1f5f9;font-size:11px;white-space:nowrap;';
                        var cellHtml = '';

                        if (valLow === 'pickup') {
                            cellHtml = '<span style="display:inline-block;padding:3px 10px;border-radius:4px;' +
                                'font-size:11px;font-weight:700;letter-spacing:.04em;' +
                                'background:#16a34a;color:#fff;">Pickup</span>';

                        } else if (valLow === 'drop') {
                            cellHtml = '<span style="display:inline-block;padding:3px 10px;border-radius:4px;' +
                                'font-size:11px;font-weight:700;letter-spacing:.04em;' +
                                'background:#f59e0b;color:#fff;">DROP</span>';

                        } else {
                            if (ci >= 3) {
                                var num = parseFloat(val);
                                if (!isNaN(num)) {
                                    tdStyle += num === 0
                                        ? 'color:#94a3b8;font-family:monospace;'
                                        : 'font-family:monospace;font-weight:500;color:#1e293b;';
                                }
                            } else if (ci === 1) {
                                tdStyle += 'font-family:monospace;font-size:10px;color:#475569;';
                            } else if (ci === 0 || ci === 2) {
                                tdStyle += 'color:#6b7280;font-size:10px;';
                            }
                            cellHtml = escHtml(val);
                        }

                        bodyHtml += '<td style="' + tdStyle + '">' + cellHtml + '</td>';
                    });
                    bodyHtml += '</tr>';
                });
                bodyHtml += '</tbody>';

                // ── ⑥ Assemble final HTML ──────────────────────────────
                var html =
                    // Info bar
                    '<div style="font-size:11px;color:#64748b;margin-bottom:8px;padding:4px 0;display:flex;align-items:center;gap:12px;flex-wrap:wrap;">' +
                    '<span><i class="fas fa-broadcast-tower" style="margin-right:4px;color:#0077cc"></i>' +
                    'Asset: <b>' + escHtml(r.assetNo || ('Asset ' + r.assetId)) + '</b></span>' +
                    '<span>Station: <b>' + escHtml(r.station || '') + '</b></span>' +
                    '<span><b>' + dataRows.length + '</b> records</span>' +
                    '<span style="color:#16a34a;font-weight:600">' +
                    '<i class="fas fa-sort-amount-down" style="margin-right:3px"></i>Latest first' +
                    '</span>' +
                    // TPR·FAILURE badge
                    '<span style="display:inline-flex;align-items:center;gap:5px;background:#fee2e2;' +
                    'border:1px solid #fca5a5;border-radius:6px;padding:2px 10px;">' +
                    '<i class="fas fa-exclamation-triangle" style="color:#dc2626;font-size:10px"></i>' +
                    '<span style="color:#991b1b;font-weight:700;font-size:10px;letter-spacing:.06em">TPR · FAILURE</span>' +
                    '</span>' +
                    '</div>' +

                    // Outer container
                    '<div style="border:1px solid #d1dce8;border-radius:8px;overflow:hidden;">' +

                    // FIXED HEADER (no vertical scroll)
                    '<div id="tprHeaderScroll" style="overflow:hidden;background:#1e3a5f;">' +
                    '<table style="width:' + totalW + 'px;border-collapse:collapse;table-layout:fixed;">' +
                    colGroupHtml +
                    headerHtml +
                    '</table>' +
                    '</div>' +

                    // SCROLLABLE BODY
                    '<div id="tprBodyScroll" style="overflow-y:auto;overflow-x:auto;max-height:390px;"' +
                    ' onscroll="syncTprScroll(this)">' +
                    '<table style="width:' + totalW + 'px;border-collapse:collapse;table-layout:fixed;">' +
                    colGroupHtml +
                    bodyHtml +
                    '</table>' +
                    '</div>' +

                    '</div>';

                document.getElementById(cid).innerHTML = html;

                // ── Apply fullscreen height if already in fullscreen ──
                var overlay = document.getElementById('frsDebugOverlay');
                if (overlay && overlay.classList.contains('fullscreen')) {
                    setTimeout(function () {
                        var tprBody = document.getElementById('tprBodyScroll');
                        if (tprBody) tprBody.style.maxHeight = (window.innerHeight - 240) + 'px';
                    }, 50);
                }
            },
            error: function (xhr) {
                document.getElementById(cid).innerHTML =
                    '<div class="frs-tab-error">' +
                    '<i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>' +
                    'Failed to load TPR telemetry data (HTTP ' + xhr.status + ').</div>';
            }
        });
    }

    function syncTprScroll(bodyEl) {
        var headerDiv = document.getElementById('tprHeaderScroll');
