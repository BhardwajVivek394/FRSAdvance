  btn.disabled=true; btn.innerHTML='<i class="fas fa-circle-notch fa-spin"></i> Generating\u2026';
  progress.style.display='block'; bar.style.width='10%';
  function loadScript(src,cb){ if(document.querySelector('script[src="'+src+'"]')){cb();return;} var s=document.createElement('script'); s.src=src; s.onload=function(){cb();}; s.onerror=function(){cb(new Error('Failed: '+src));}; document.head.appendChild(s); }
  loadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js',function(e1){
    if(e1){resetPdfBtn(btn,progress);alert('Could not load jsPDF.');return;}
    bar.style.width='40%'; setTimeout(function(){_buildTextPdf(btn,progress,bar);},60);
  });
}
function _buildTextPdf(btn,progress,bar){
  try{
    var jsPDF=(window.jspdf&&window.jspdf.jsPDF)||window.jsPDF;
    var pdf=new jsPDF({orientation:'landscape',unit:'mm',format:'a4'});
    var pageW=pdf.internal.pageSize.getWidth(),pageH=pdf.internal.pageSize.getHeight(),now=new Date(),margin=8;
    bar.style.width='55%';
    function p2(n){return n<10?'0'+n:''+n;}
    var dateStr=p2(now.getDate())+'/'+p2(now.getMonth()+1)+'/'+now.getFullYear()+'  '+p2(now.getHours())+':'+p2(now.getMinutes());
    function stripHtml(str){if(!str)return '';return String(str).replace(/<br\s*\/?>/gi,' | ').replace(/<b>(.*?)<\/b>/gi,'$1').replace(/<[^>]+>/g,'').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&amp;/g,'&').replace(/&quot;/g,'"').replace(/&#39;/g,"'").replace(/\s+/g,' ').trim();}
    function wrapText(str,colW,fontSize){if(!str)return[''];str=stripHtml(String(str)).replace(/\r?\n/g,' ').trim();pdf.setFontSize(fontSize);return pdf.splitTextToSize(str,colW);}
    function parseBoldSegments(str){if(!str)return[{text:'',bold:false}];var cleaned=String(str).replace(/<br\s*\/?>/gi,' | ').replace(/<(?!\/?(b)>)[^>]+>/gi,'').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&amp;/g,'&').replace(/&quot;/g,'"').replace(/&#39;/g,"'").replace(/\s+/g,' ').trim();var segs=[],re=/<b>([\s\S]*?)<\/b>/gi,last=0,m;while((m=re.exec(cleaned))!==null){if(m.index>last)segs.push({text:cleaned.slice(last,m.index),bold:false});segs.push({text:m[1],bold:true});last=m.index+m[0].length;}if(last<cleaned.length)segs.push({text:cleaned.slice(last),bold:false});return segs.length?segs:[{text:cleaned,bold:false}];}
    function wrapMixedLines(segments,colW,fontSize){var lines=[[]],lineW=0;segments.forEach(function(seg){if(!seg.text)return;pdf.setFont('helvetica',seg.bold?'bold':'normal');pdf.setFontSize(fontSize);var words=seg.text.split(/(\s+)/);words.forEach(function(token){if(!token)return;var tw=pdf.getTextWidth(token);if(lineW+tw>colW&&lineW>0&&token.trim()!==''){lines.push([]);lineW=0;}lines[lines.length-1].push({text:token,bold:seg.bold});lineW+=tw;if(/\n/.test(token)){lines.push([]);lineW=0;}});});return lines;}
    function renderMixedLines(lineSegs,x,startY,maxLines,lH){var count=Math.min(lineSegs.length,maxLines);for(var li=0;li<count;li++){var cx=x,isLast=li===maxLines-1&&lineSegs.length>maxLines,segs=lineSegs[li];for(var si=0;si<segs.length;si++){var seg=segs[si];pdf.setFont('helvetica',seg.bold?'bold':'normal');var txt=seg.text;if(isLast&&si===segs.length-1)txt=txt.trimEnd()+'\u2026';pdf.text(txt,cx,startY+cellPadY+lH*(li+1)-0.5);cx+=pdf.getTextWidth(txt);}}return count;}
    var cols=[{key:'idx',hdr:'Sr',w:7},{key:'zone',hdr:'Zone',w:12},{key:'division',hdr:'Division',w:20},{key:'station',hdr:'Station',w:20},{key:'alertType',hdr:'Type',w:16},{key:'assetType',hdr:'Asset Type',w:20},{key:'assetNo',hdr:'Asset No.',w:14},{key:'incDate',hdr:'Inc. Date',w:24},{key:'duration',hdr:'Duration',w:18},{key:'rectDate',hdr:'Rect. Date',w:24},{key:'causeCode',hdr:'Cause Code',w:24},{key:'setMsg',hdr:'Message',w:41},{key:'desc',hdr:'Description',w:41}];
    var xPos=[],cx=margin;for(var ci=0;ci<cols.length;ci++){xPos.push(cx);cx+=cols[ci].w;}
    var usableW=cx-margin,headerH=14,rowFontSz=6.5,hdrFontSz=6.8,lineH=3.8,cellPadY=1.5,minRowH=lineH+cellPadY*2,tblStartY=headerH+4,currentY=tblStartY,pageNum=1;
    function drawPageHeader(){pdf.setFillColor(0,119,204);pdf.rect(0,0,pageW,headerH-1,'F');pdf.setTextColor(255,255,255);pdf.setFontSize(10);pdf.setFont('helvetica','bold');pdf.text('Alert Analysis Report',margin,9);pdf.setFontSize(7.5);pdf.setFont('helvetica','normal');pdf.text(dateStr+'   Page '+pageNum,pageW-margin,9,{align:'right'});var bY=11.5,pred=_allRows.filter(function(r){return r.alertType==='Predictive';}).length,fail=_allRows.filter(function(r){return r.alertType==='Failure';}).length,badges=[{label:'Total',val:_allRows.length,bg:[22,163,74]},{label:'Predictive',val:pred,bg:[217,119,6]},{label:'Failure',val:fail,bg:[220,38,38]}],bX=margin;badges.forEach(function(b){var txt=b.label+': '+b.val.toLocaleString();pdf.setFontSize(6.5);pdf.setFont('helvetica','bold');var tw=pdf.getTextWidth(txt)+4;pdf.setFillColor(b.bg[0],b.bg[1],b.bg[2]);pdf.roundedRect(bX,bY-2.2,tw,3.5,0.8,0.8,'F');pdf.setTextColor(255,255,255);pdf.text(txt,bX+2,bY);bX+=tw+2;});}
    function drawColHeaders(){pdf.setFillColor(232,240,248);pdf.rect(margin,currentY,usableW,minRowH+1,'F');pdf.setDrawColor(209,220,232);pdf.rect(margin,currentY,usableW,minRowH+1,'S');pdf.setTextColor(107,114,128);pdf.setFontSize(hdrFontSz);pdf.setFont('helvetica','bold');for(var ci=0;ci<cols.length;ci++){pdf.text(cols[ci].hdr,xPos[ci]+1,currentY+cellPadY+lineH-0.5);}currentY+=minRowH+1;}
    function addPage(){pdf.addPage();pageNum++;drawPageHeader();currentY=tblStartY;drawColHeaders();}
    function drawRow(rowData,ri,isAlt){pdf.setFontSize(rowFontSz);pdf.setFont('helvetica','normal');var cellLines=[],mixedLines={},maxLines=1;for(var ci=0;ci<cols.length;ci++){var colKey=cols[ci].key;if(colKey==='setMsg'||colKey==='desc'){var rawVal=rowData[colKey]||'',segs=parseBoldSegments(rawVal),mlines=wrapMixedLines(segs,cols[ci].w-2,rowFontSz);if(mlines.length>4)mlines=mlines.slice(0,4);mixedLines[ci]=mlines;cellLines.push(null);if(mlines.length>maxLines)maxLines=mlines.length;}else{var val=rowData[colKey]||'',lines=wrapText(String(val),cols[ci].w-2,rowFontSz);if(lines.length>4){lines=lines.slice(0,4);lines[3]+='\u2026';}cellLines.push(lines);if(lines.length>maxLines)maxLines=lines.length;}}var rowH=maxLines*lineH+cellPadY*2;if(currentY+rowH>pageH-8){addPage();}if(isAlt){pdf.setFillColor(248,250,252);pdf.rect(margin,currentY,usableW,rowH,'F');}pdf.setDrawColor(229,237,245);pdf.line(margin,currentY+rowH,margin+usableW,currentY+rowH);pdf.setFontSize(rowFontSz);for(var ci=0;ci<cols.length;ci++){var col=cols[ci];if(col.key==='setMsg'||col.key==='desc'){pdf.setTextColor(71,85,105);renderMixedLines(mixedLines[ci],xPos[ci]+1,currentY,4,lineH);}else{var lines=cellLines[ci];if(col.key==='alertType'){var ip=rowData.alertType==='Predictive';pdf.setTextColor(ip?146:153,ip?64:27,ip?14:27);pdf.setFont('helvetica','bold');}else if(col.key==='causeCode'){pdf.setTextColor(0,119,204);pdf.setFont('helvetica','bold');}else if(col.key==='idx'){pdf.setTextColor(107,114,128);pdf.setFont('helvetica','normal');}else{pdf.setTextColor(30,41,59);pdf.setFont('helvetica','normal');}for(var li=0;li<lines.length;li++){pdf.text(lines[li],xPos[ci]+1,currentY+cellPadY+lineH*(li+1)-0.5);}}}currentY+=rowH;}
    bar.style.width='65%'; drawPageHeader(); drawColHeaders();
    for(var ri=0;ri<_allRows.length;ri++){var r=_allRows[ri];drawRow({idx:ri+1,zone:r.zone||'',division:r.division||'',station:r.station||'',alertType:r.alertType||'',assetType:r.assetType||'',assetNo:r.assetNo||'',incDate:r.incDate||'',duration:r.duration||'-',rectDate:r.rectDate||'-',causeCode:r.causeCode||'',setMsg:r.setMsg||'',desc:r.desc||''},ri,ri%2===1);if(ri%50===0)bar.style.width=Math.min(90,65+Math.floor((ri/_allRows.length)*25))+'%';}
    pdf.setDrawColor(209,220,232); pdf.rect(margin,tblStartY,usableW,currentY-tblStartY,'S');
    var totalPages=pdf.internal.getNumberOfPages();for(var pi=1;pi<=totalPages;pi++){pdf.setPage(pi);pdf.setFontSize(6.5);pdf.setTextColor(160,160,160);pdf.setFont('helvetica','normal');pdf.text('FRS Alert Analysis  \u00b7  Total Records: '+_allRows.length+'  \u00b7  Page '+pi+' of '+totalPages,pageW/2,pageH-3,{align:'center'});}
    bar.style.width='95%';
    var fname='AlertAnalysis_'+now.getFullYear()+p2(now.getMonth()+1)+p2(now.getDate())+'_'+p2(now.getHours())+p2(now.getMinutes())+'.pdf';
    pdf.save(fname); bar.style.width='100%'; setTimeout(function(){resetPdfBtn(btn,progress);},500);
  }catch(err){console.error('PDF error:',err);resetPdfBtn(btn,progress);alert('PDF generation failed: '+err.message);}
}
function resetPdfBtn(btn,progress){btn.disabled=false;btn.innerHTML='<i class="fas fa-file-pdf"></i> Download PDF';progress.style.display='none';document.getElementById('frsPdfProgressBar').style.width='0%';}

