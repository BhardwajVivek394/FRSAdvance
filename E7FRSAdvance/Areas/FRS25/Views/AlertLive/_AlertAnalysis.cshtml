    // ── Protocol dropdown change → load A10 number list ───────
    function onNetProtocolChange(sel) {
        var protocol = sel.value;
        var typeVal = document.getElementById('netTypeSelect')
            ? document.getElementById('netTypeSelect').value : '';
        var numberList = document.getElementById('netNumberList');
        var graphArea = document.getElementById('netGraphArea');
        var spinner = document.getElementById('netFilterSpinner');
        var r = window._netCurrentRow;

        if (graphArea) graphArea.innerHTML = '';
        if (numberList) numberList.innerHTML = '';

        if (!protocol || !typeVal || !r) return;

        // Show spinner
        if (spinner) spinner.style.display = 'flex';

        $.ajax({
            url: '/FRS25/AlertLive/GetNetworkNumberList',
            type: 'POST',
            data: {
                siteId: r.siteId,
                assetId: r.assetId,
                type: typeVal,
                protocol: protocol
            },
            success: function (data) {
                if (spinner) spinner.style.display = 'none';

                var items = Array.isArray(data) ? data : (data.items || data.data || data.list || []);

                if (!items || items.length === 0) {
                    if (numberList) numberList.innerHTML =
                        '<div class="frs-tab-empty" style="padding:20px;">' +
                        '<i class="fas fa-list" style="font-size:24px;display:block;margin-bottom:8px;color:#cbd5e1"></i>' +
                        'No ' + escHtml(typeVal) + ' numbers found for <b>' + escHtml(protocol) + '</b>.</div>';
                    return;
                }

                // Build number list as clickable cards
                var listHtml =
                    '<div style="margin-bottom:8px;font-size:10px;font-weight:700;color:#64748b;' +
                    'letter-spacing:.08em;text-transform:uppercase;">' +
                    '<i class="fas fa-list" style="margin-right:4px;color:#0077cc"></i>' +
                    escHtml(typeVal) + ' Numbers &nbsp;·&nbsp; ' + escHtml(protocol) +
                    ' <span style="color:#94a3b8;font-weight:400">(' + items.length + ' found)</span>' +
                    '</div>' +
                    '<div style="display:flex;flex-wrap:wrap;gap:8px;">';

                items.forEach(function (item) {
                    // Support both string and object response
                    var num = typeof item === 'object'
                        ? (item.Number || item.number || item.Name || item.name || item.Id || item.id || JSON.stringify(item))
                        : String(item);
                    var display = typeof item === 'object'
                        ? (item.DisplayName || item.displayName || num)
                        : num;
                    var status = typeof item === 'object'
                        ? (item.Status || item.status || '')
                        : '';

                    var statusDot = '';
                    if (status) {
                        var dotColor = status.toLowerCase() === 'online' ? '#16a34a' :
                            status.toLowerCase() === 'offline' ? '#dc2626' : '#94a3b8';
                        statusDot = '<span style="display:inline-block;width:7px;height:7px;border-radius:50%;' +
                            'background:' + dotColor + ';margin-right:5px;vertical-align:middle;"></span>';
                    }

                    listHtml +=
                        '<div class="frs-net-num-card" ' +
                    'onclick="onNetNumberClick(this,\'' + escJs(num) + '\',\'' + escJs(typeVal) + '\',\'' + escJs(protocol) + '\',\'' + escJs(item.ClusterId) + '\')" ' +
                        'style="display:inline-flex;align-items:center;gap:4px;' +
                        'background:#fff;border:1px solid #d1dce8;border-radius:7px;' +
                        'padding:7px 14px;cursor:pointer;font-size:12px;font-weight:600;' +
                        'color:#1e293b;transition:all .15s;user-select:none;">' +
                        statusDot +
                        escHtml(display) +
                        '</div>';
                });

                listHtml += '</div>';

                if (numberList) numberList.innerHTML = listHtml;
            },
            error: function (xhr) {
                if (spinner) spinner.style.display = 'none';
                if (numberList) numberList.innerHTML =
                    '<div class="frs-tab-error">' +
                    '<i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>' +
                    'Failed to load numbers (HTTP ' + xhr.status + ').</div>';
