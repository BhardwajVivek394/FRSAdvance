                    <div class="frs-tab-loading">
                        <i class="fas fa-circle-notch spin"></i>
                        <p>Loading TPR data…</p>
                    </div>
                </div>
            </div>

            <!-- ⑦ NETWORK -->
            <div class="frs-debug-panel" id="frsDbgPanel_network">
                <div id="frsDbgNetworkContent">
                    <div class="frs-tab-loading">
                        <i class="fas fa-circle-notch spin"></i>
                        <p>Loading network data…</p>
                    </div>
                </div>
            </div>

        </div><!-- /.frs-debug-body -->

        <div class="frs-debug-foot">
            <button class="frs-btn-close" onclick="closeDebugPopup()"><i class="fas fa-times"></i> Close</button>
        </div>
    </div>
</div>

<script>
// ════════════════════════════════════════════════════════════
//  DATA
// ════════════════════════════════════════════════════════════
var _allRows      = @Html.Raw(rowsJson);
var _causeSummary = @Html.Raw(causeSummaryJson);
window._alertCurrentSkip = 0;

// ════════════════════════════════════════════════════════════
//  CHIP / CAUSE PANEL
// ════════════════════════════════════════════════════════════
var _activeChip = null;

function onChipClick(chipEl) {
  if (_activeChip === chipEl) { closeCausePanel(); return; }
  if (_activeChip) _activeChip.classList.remove('active');
  chipEl.classList.add('active');
  _activeChip = chipEl;
  showCausePanel(chipEl.dataset.asset, chipEl.dataset.card);
}
function closeCausePanel() {
  document.getElementById('frsCausePanel').style.display = 'none';
  if (_activeChip) { _activeChip.classList.remove('active'); _activeChip = null; }
}
function showCausePanel(assetType, cardType) {
  var lblMap = { total:'Total', predictive:'Predictive', failure:'Failure' };
  document.getElementById('frsCpTitle').textContent = assetType + '  ·  ' + lblMap[cardType] + ' — Cause Code Breakdown';
  var codes  = _causeSummary[assetType] || [];
  var keyMap = { predictive:'pred', failure:'fail', total:'total' };
  var key    = keyMap[cardType] || 'total';
  var maxVal = Math.max.apply(null, codes.map(function(c){ return c[key]; }).concat([1]));
  var grid   = document.getElementById('frsCauseGrid');
  grid.innerHTML = '';
  codes.forEach(function(c) {
    var val  = c[key];
    var pct  = Math.round((val/maxVal)*100);
    var item = document.createElement('div');
    item.className = 'frs-cause-item';
    item.innerHTML =
      '<div class="frs-ci-name">'  + escHtml(c.code) + '</div>' +
      '<div class="frs-ci-count">' + val.toLocaleString() + '</div>' +
      '<div class="frs-ci-bar"><div class="frs-ci-fill" style="width:'+pct+'%"></div></div>' +
      '<div class="frs-ci-hint"><i class="fas fa-mouse-pointer"></i> click for details</div>';
    item.addEventListener('click', function(){ openCauseModal(c.code); });
    grid.appendChild(item);
  });
  document.getElementById('frsCausePanel').style.display = 'block';
}

// ════════════════════════════════════════════════════════════
//  CAUSE CODE DETAIL MODAL  — with AssetNo grouping + Debug
// ════════════════════════════════════════════════════════════
    function openCauseModal(causeCode) {
        if (typeof closeDD === 'function') { try { closeDD(); } catch (e) { } }
        document.querySelectorAll('.filter-dropdown').forEach(function (el) {
            el.classList.remove('open'); el.style.display = 'none';
        });
        var bd = document.getElementById('backdrop');
        if (bd) { bd.classList.remove('show'); bd.style.display = 'none'; }

        var overlay = document.getElementById('frsCauseModal');
        if (overlay.parentNode !== document.body) {
            document.body.appendChild(overlay);
            if (!overlay._closeListenerAdded) {
                overlay.addEventListener('click', function (e) {
                    if (e.target === overlay) closeCauseModal();
                });
                overlay._closeListenerAdded = true;
            }
        }

        var matching = _allRows.filter(function (r) { return r.causeCode === causeCode; });
        var total = matching.length;
        var pred = matching.filter(function (r) { return r.alertType === 'Predictive'; }).length;
        var fail = total - pred;

        document.getElementById('frsMdTitle').textContent = causeCode;
        document.getElementById('frsMdStats').innerHTML =
            '<div class="frs-ms tot"><div class="frs-ms-lbl">Total</div><div class="frs-ms-val">' + total.toLocaleString() + '</div></div>' +
            '<div class="frs-ms prd"><div class="frs-ms-lbl">Predictive</div><div class="frs-ms-val">' + pred.toLocaleString() + '</div></div>' +
            '<div class="frs-ms fal"><div class="frs-ms-lbl">Failure</div><div class="frs-ms-val">' + fail.toLocaleString() + '</div></div>';

        // Asset type breakdown
        var bkdn = {};
        matching.forEach(function (r) { bkdn[r.assetType] = (bkdn[r.assetType] || 0) + 1; });
        var bkdnArr = Object.keys(bkdn).map(function (k) { return { asset: k, count: bkdn[k] }; }).sort(function (a, b) { return b.count - a.count; });
        var maxB = Math.max.apply(null, bkdnArr.map(function (b) { return b.count; }).concat([1]));
        document.getElementById('frsMdBreakdown').innerHTML = bkdnArr.map(function (b) {
            var pct = Math.round((b.count / maxB) * 100);
            return '<div class="frs-bkdn-row">' +
                '<div class="frs-bkdn-lbl">' + escHtml(b.asset) + '</div>' +
                '<div class="frs-bkdn-bar-wrap"><div class="frs-bkdn-bar" style="width:' + pct + '%"></div></div>' +
                '<div class="frs-bkdn-count">' + b.count.toLocaleString() + '</div></div>';
        }).join('');

        // ── Group by Asset No ──────────────────────────────────────
        var display = matching.slice(0, 200);
        document.getElementById('frsMdRecCount').textContent =
            '(showing ' + display.length + ' of ' + total + ')';

        // Build groups: { assetNo: [rows] }
        var groups = {}, groupOrder = [];
        display.forEach(function (r) {
            var key = r.assetNo || '-';
            if (!groups[key]) { groups[key] = []; groupOrder.push(key); }
            groups[key].push(r);
        });

        var rowIdx = 0;
        var html = '';
        groupOrder.forEach(function (assetNo) {
            var rows = groups[assetNo];
            var groupId = 'grp_' + assetNo.replace(/[^a-zA-Z0-9]/g, '_') + '_' + rowIdx;

            // ── Group header row ──
            html += '<tr class="frs-group-row" onclick="toggleGroup(\'' + groupId + '\')">' +
                '<td colspan="10">' +
                '<span class="frs-group-toggle open" id="tog_' + groupId + '">\u25B6</span>' +
                '<strong>' + escHtml(assetNo) + '</strong>' +
                '<span class="frs-group-badge">' + rows.length + '</span>' +
                '</td>' +
                '</tr>';

            // ── Detail rows ──
            rows.forEach(function (r, i) {
                var badgeCls = r.alertType === 'Predictive' ? 'frs-badge-pred' : 'frs-badge-fail';
                // Store row data for debug popup
                var dataAttr = 'data-idx="' + rowIdx + '"';
                _debugRows[rowIdx] = r;
                html += '<tr class="frs-detail-row" data-group="' + groupId + '">' +
                    '<td style="font-family:monospace;color:#6b7280;padding-left:22px">' + (rowIdx + 1) + '</td>' +
                    '<td>' + escHtml(r.zone) + '</td>' +
                    '<td>' + escHtml(r.division) + '</td>' +
                    '<td>' + escHtml(r.station) + '</td>' +
                    '<td><span class="frs-badge ' + badgeCls + '">' + r.alertType + '</span></td>' +
                    '<td style="font-weight:600">' + escHtml(r.assetType) + '</td>' +
                    '<td style="font-family:monospace;color:#475569">' + r.incDate + '</td>' +
                    '<td style="font-family:monospace;color:#6b7280">' + r.duration + '</td>' +
                    '<td style="color:#475569;max-width:200px;white-space:normal">' +
                    sanitizeMsg(r.setMsg) +
                    (r.desc ? '<br><span style="color:#64748b">' + sanitizeMsg(r.desc) + '</span>' : '') +
                    '</td>' +
                    '<td>' +
                    '<button class="frs-btn-debug" ' + dataAttr + ' onclick="openDebugPopup(' + rowIdx + ');event.stopPropagation()">' +
                    '<i class="fas fa-bug"></i> Debug' +
                    '</button>' +
                    '</td>' +
                    '</tr>';
                rowIdx++;
            });
        });

        document.getElementById('frsMdRows').innerHTML = html;
        overlay.classList.add('open');
        document.body.style.overflow = 'hidden';
    }

// Toggle group expand/collapse
    function toggleGroup(groupId) {
        var rows = document.querySelectorAll('[data-group="' + groupId + '"]');
        var toggle = document.getElementById('tog_' + groupId);
        var isOpen = toggle.classList.contains('open');
        rows.forEach(function (r) { r.classList.toggle('hidden', isOpen); });
        toggle.classList.toggle('open', !isOpen);
    }

    // ── Toggle fullscreen for debug popup ─────────────────────
    function toggleDebugFullscreen() {
        var overlay = document.getElementById('frsDebugOverlay');
        var icon = document.getElementById('frsDbgFullscreenIcon');
        var box = overlay ? overlay.querySelector('.frs-debug-box') : null;

        if (!overlay) return;

        var isFullscreen = overlay.classList.contains('fullscreen');

        if (isFullscreen) {
            // ── Exit fullscreen ──────────────────────────────
            overlay.classList.remove('fullscreen');
            if (icon) {
                icon.classList.remove('fa-compress');
                icon.classList.add('fa-expand');
            }
            if (box) {
                box.style.width = '';
                box.style.height = '';
                box.style.maxWidth = '';
                box.style.maxHeight = '';
            }

            // ── Restore table heights ────────────────────────
            var teleBody = document.getElementById('teleBodyScroll');
            var tprBody = document.getElementById('tprBodyScroll');
            if (teleBody) teleBody.style.maxHeight = '390px';
            if (tprBody) tprBody.style.maxHeight = '390px';

            [teleHeader, tprHeader, teleBodyEl, tprBodyEl].forEach(function (el) {
                if (el) {
                    var parent = el.parentElement;
                    if (parent) parent.style.minWidth = '0';
                }
            });

        } else {
            // ── Enter fullscreen ─────────────────────────────
            overlay.classList.add('fullscreen');
            if (icon) {
                icon.classList.remove('fa-expand');
                icon.classList.add('fa-compress');
            }

            // ── Expand table heights ─────────────────────────
            setTimeout(function () {
                var teleBody = document.getElementById('teleBodyScroll');
                var tprBody = document.getElementById('tprBodyScroll');
                var newH = (window.innerHeight - 240) + 'px';
                if (teleBody) teleBody.style.maxHeight = newH;
                if (tprBody) tprBody.style.maxHeight = newH;

                // ── Expand outer container divs to full width ──
                var teleHeader = document.getElementById('teleHeaderTable');
                var tprHeader = document.getElementById('tprHeaderScroll');
                var teleBodyEl = document.getElementById('teleBodyScroll');
                var tprBodyEl = document.getElementById('tprBodyScroll');

                [teleHeader, tprHeader, teleBodyEl, tprBodyEl].forEach(function (el) {
                    if (el) {
                        // find parent container div and remove fixed width
                        var parent = el.parentElement;
                        if (parent) parent.style.minWidth = '0';
                    }
                });
            }, 50);
        }

        // ── Resize ECharts ────────────────────────────────────
        setTimeout(function () {
            if (window._mqttChart) { try { window._mqttChart.resize(); } catch (e) { } }
            if (window._netChart) { try { window._netChart.resize(); } catch (e) { } }
        }, 100);
    }

    function closeCauseModal() {
        document.getElementById('frsCauseModal').classList.remove('open');
        document.body.style.overflow = '';
        var bd = document.getElementById('backdrop');
        if (bd) { bd.style.display = ''; }
    }
    document.getElementById('frsCauseModal').addEventListener('click', function (e) {
        if (e.target === this) closeCauseModal();
    });

// ════════════════════════════════════════════════════════════
//  DEBUG POPUP — 4 tabs with AJAX
// ════════════════════════════════════════════════════════════
var _debugRows   = {};   // populated when cause modal opens
var _dbgCurrent  = null; // current row data
var _dbgLoaded   = {};   // { tabKey: true } — tracks which tabs have loaded for current row

    function openDebugPopup(idx) {
        var r = _debugRows[idx];
        if (!r) return;
        _dbgCurrent = r;
        _dbgLoaded = {};  // reset loaded state for new row

        // Move to body (above cause modal z-index)
        var overlay = document.getElementById('frsDebugOverlay');
        if (overlay.parentNode !== document.body) {
            document.body.appendChild(overlay);
            if (!overlay._closeListenerAdded) {
                overlay.addEventListener('click', function (e) {
                    if (e.target === overlay) closeDebugPopup();
                });
                overlay._closeListenerAdded = true;
            }
        }

        // ── Populate Info tab ──────────────────────────────────
        document.getElementById('frsDbgSub').textContent =
            r.assetNo + '  ·  ' + r.assetType + '  ·  ' + r.causeCode;

        document.getElementById('frsDbgGrid').innerHTML =
            dbgCard('Zone', r.zone) +
            dbgCard('Division', r.division) +
            dbgCard('Station', r.station) +
            dbgCard('Alert Type', r.alertType) +
            dbgCard('Asset Type', r.assetType) +
            dbgCard('Asset No.', r.assetNo) +
            dbgCard('Cause Code', r.causeCode) +
            dbgCard('Incidence', r.incDate) +
            dbgCard('Duration', r.duration) +
            dbgCard('Rectification', r.rectDate);

        var msgBox = document.getElementById('frsDbgMsgBox');
        if (r.setMsg) { document.getElementById('frsDbgMsg').innerHTML = sanitizeMsg(r.setMsg); msgBox.style.display = 'block'; }
        else { msgBox.style.display = 'none'; }

        var descBox = document.getElementById('frsDbgDescBox');
        if (r.desc) { document.getElementById('frsDbgDesc').innerHTML = sanitizeMsg(r.desc); descBox.style.display = 'block'; }
        else { descBox.style.display = 'none'; }

        var resetBox = document.getElementById('frsDbgResetBox');
        if (r.resetMsg) { document.getElementById('frsDbgReset').innerHTML = sanitizeMsg(r.resetMsg); resetBox.style.display = 'block'; }
        else { resetBox.style.display = 'none'; }

        resetTabPanel('telemetry', '<div class="frs-tab-loading"><i class="fas fa-circle-notch spin"></i><p>Loading telemetry data\u2026</p></div>');

        resetTabPanel('mqtt', '<div class="frs-tab-loading"><i class="fas fa-circle-notch spin"></i><p>Loading MQTT graph data\u2026</p></div>');

        resetTabPanel('datalogger', '<div class="frs-tab-loading"><i class="fas fa-circle-notch spin"></i><p>Loading datalogger log\u2026</p></div>');

        // resetTabPanel('alertjson', '<div class="frs-tab-loading"><i class="fas fa-circle-notch spin"></i><p>Loading alert JSON\u2026</p></div>');

        resetTabPanel('debugtpr', '<div class="frs-tab-loading"><i class="fas fa-circle-notch spin"></i><p>Loading debug tpr\u2026</p></div>');

        resetTabPanel('network', '<div class="frs-tab-loading"><i class="fas fa-circle-notch spin"></i><p>Loading network data\u2026</p></div>');

        switchDbgTab('info', document.querySelector('.frs-debug-tab[data-tab="info"]'));


        overlay.classList.add('open');
    }

    function dbgCard(lbl, val) {
        return '<div class="frs-debug-card">' +
            '<div class="frs-debug-card-lbl">' + lbl + '</div>' +
            '<div class="frs-debug-card-val">' + escHtml(val || '-') + '</div>' +
            '</div>';
    }

    function resetTabPanel(tabKey, html) {
        var el = document.getElementById('frsDbgPanel_' + tabKey);
        if (el) {
            var inner = el.querySelector('[id^="frsDbg"]') || el.firstElementChild;
            // find the content div by id pattern
            var cid = 'frsDbg' + tabKey.charAt(0).toUpperCase() + tabKey.slice(1) + 'Content';
            var cdiv = document.getElementById(cid);
            if (cdiv) cdiv.innerHTML = html;
            else el.innerHTML = html;
        }
    }

// ── Tab switcher ──────────────────────────────────────────
function switchDbgTab(tabKey, btnEl) {
  // Update tab buttons
  document.querySelectorAll('.frs-debug-tab').forEach(function(b){ b.classList.remove('active'); });
  if (btnEl) btnEl.classList.add('active');

  // Update panels
  document.querySelectorAll('.frs-debug-panel').forEach(function(p){ p.classList.remove('active'); });
  var panel = document.getElementById('frsDbgPanel_' + tabKey);
  if (panel) panel.classList.add('active');

  // Load data on first visit
  if (tabKey !== 'info' && !_dbgLoaded[tabKey] && _dbgCurrent) {
    _dbgLoaded[tabKey] = true;
    loadDebugTab(tabKey, _dbgCurrent);
  }
}

// ── AJAX loader for each tab ──────────────────────────────
function loadDebugTab(tabKey, r) {
    var handlers = {
        telemetry: loadTelemetryTab,
        mqtt: loadMqttTab,
        datalogger: loadDataloggerTab,
        alertjson: loadAlertJsonTab,
        debugtpr: loadDebugtprTab,
        network: loadNetworkTab  
    };
  if (handlers[tabKey]) handlers[tabKey](r);
}

    // ── ① TELEMETRY LIVE — HTML Table from CSV ────────────────
    function loadTelemetryTab(r) {
        var cid = 'frsDbgTelemetryContent';
        var startDate = formatDateTimeMinusForAPI(r.incDate, 30);
        var endDate = formatDateTimeAddForAPI(r.incDate, 30);

        document.getElementById(cid).innerHTML =
            '<div class="frs-tab-loading"><i class="fas fa-circle-notch spin"></i><p>Loading telemetry data…</p></div>';

        $.ajax({
            url: '/FRS25/AlertLive/GetTelemetryHistoryData',
            type: 'POST',
            data: {
                frsAlertId: r.id,
                siteId: r.siteId,
                assetId: r.assetId,
                startDate: startDate.toISOString(),
                endDate: endDate.toISOString()
            },
            dataType: 'json',
            success: function (csv) {
                if (!csv || csv.trim() === '') {
                    document.getElementById(cid).innerHTML =
                        '<div class="frs-tab-empty">' +
                        '<i class="fas fa-satellite-dish" style="font-size:28px;display:block;margin-bottom:8px;color:#cbd5e1"></i>' +
                        'No telemetry data available.</div>';
                    return;
                }

                var lines = csv.trim().split('\n').filter(function (l) { return l.trim() !== ''; });
                if (lines.length < 2) {
                    document.getElementById(cid).innerHTML = '<div class="frs-tab-empty">No rows in telemetry data.</div>';
                    return;
                }

                var headers = lines[0].split(',').map(function (h) { return h.trim(); });
                if (headers[headers.length - 1] === '') headers.pop();

                // ── Parse rows into array ──────────────────────────────
                var dataRows = [];
                for (var i = 1; i < lines.length; i++) {
                    var cols = lines[i].split(',');
                    if (cols[cols.length - 1].trim() === '') cols.pop();
                    dataRows.push(cols);
                }

                // ── ① Sort by Date (col index 1) DESCENDING ───────────
                dataRows.sort(function (a, b) {
                    return new Date((b[1] || '').trim()) - new Date((a[1] || '').trim());
                });

                // ── ② Build col widths array ───────────────────────────
                var colWidths = headers.map(function (h, ci) {
                    if (ci === 1) return 170;   // Date column
                    if (ci === 0) return 90;    // Site Name
                    if (ci === 2) return 140;   // Asset Type
                    return 90;
                });
                var totalW = colWidths.reduce(function (a, b) { return a + b; }, 0);

                // ── ③ Build colgroup HTML ──────────────────────────────
                var colGroupHtml = '<colgroup>';
                colWidths.forEach(function (w) { colGroupHtml += '<col style="width:' + w + 'px;min-width:' + w + 'px">'; });
                colGroupHtml += '</colgroup>';

                // ── ④ FIXED HEADER TABLE ───────────────────────────────
                var thStyle = [
                    'background:#1e3a5f',
                    'color:#fff',
                    'padding:9px 10px',
                    'font-size:10px',
                    'font-weight:700',
                    'letter-spacing:.06em',
                    'text-transform:uppercase',
                    'white-space:normal',
                    'overflow:hidden',
                    'text-overflow:ellipsis',
                    'max-width:140px',
                    'word-break:break-word',
                    'border-right:1px solid #2d5a8e',
                    'border-bottom:2px solid #0077cc',
                    'text-align:left'
                ].join(';');

                var headerHtml = '<thead><tr>';
                headers.forEach(function (h) {
                  // headerHtml += '<th style="' + thStyle + '">' + escHtml(h) + '</th>';

                    let updatedH = h.replace(r.assetNo, '');  // replace all occurrences
                    headerHtml += '<th style="' + thStyle + '" title="' + escHtml(updatedH.trim()) + '">' + escHtml(updatedH) + '</th>';
                });
                headerHtml += '</tr></thead>';

                // ── ⑤ BODY ROWS ───────────────────────────────────────
                var bodyHtml = '<tbody>';
                dataRows.forEach(function (cols, ri) {
                    bodyHtml += '<tr style="background:' + (ri % 2 === 0 ? '#fff' : '#f8fafc') + '">';
                    cols.forEach(function (col, ci) {
                        var val = col.trim();
                        var valLow = val.toLowerCase();
                        var tdStyle = 'padding:7px 10px;border-bottom:1px solid #e5edf5;border-right:1px solid #f1f5f9;font-size:11px;white-space:nowrap;';
                        var cellHtml = '';

                        if (valLow === 'pickup') {
                            cellHtml = '<span style="display:inline-block;padding:3px 10px;border-radius:4px;' +
                                'font-size:11px;font-weight:700;letter-spacing:.04em;' +
                                'background:#16a34a;color:#fff;">Pickup</span>';

                        } else if (valLow === 'drop') {
                            cellHtml = '<span style="display:inline-block;padding:3px 10px;border-radius:4px;' +
                                'font-size:11px;font-weight:700;letter-spacing:.04em;' +
                                'background:#f59e0b;color:#fff;">DROP</span>';

                        } else {
                            if (ci >= 3) {
                                var num = parseFloat(val);
                                if (!isNaN(num)) {
                                    tdStyle += num === 0
                                        ? 'color:#94a3b8;font-family:monospace;'
                                        : 'font-family:monospace;font-weight:500;color:#1e293b;';
                                }
                            } else if (ci === 1) {
                                tdStyle += 'font-family:monospace;font-size:10px;color:#475569;';
                            } else if (ci === 0 || ci === 2) {
                                tdStyle += 'color:#6b7280;font-size:10px;';
                            }
                            cellHtml = escHtml(val);
                        }

                        bodyHtml += '<td style="' + tdStyle + '">' + cellHtml + '</td>';
                    });
                    bodyHtml += '</tr>';
                });
                bodyHtml += '</tbody>';

                // ── ⑥ Assemble final HTML ──────────────────────────────
                var html =
                    // Info bar
                    '<div style="font-size:11px;color:#64748b;margin-bottom:8px;padding:4px 0;">' +
                    '<i class="fas fa-satellite-dish" style="margin-right:4px;color:#0077cc"></i>' +
                    'Asset: <b>' + escHtml(r.assetNo || ('Asset ' + r.assetId)) + '</b>' +
                    ' &nbsp;|&nbsp; Station: <b>' + escHtml(r.station || '') + '</b>' +
                    ' &nbsp;|&nbsp; <b>' + dataRows.length + '</b> records' +
                    ' &nbsp;|&nbsp; <span style="color:#16a34a;font-weight:600">' +
                    '<i class="fas fa-sort-amount-down" style="margin-right:3px"></i>Latest first' +
                    '</span>' +
                    '</div>' +

                    // ── Outer container ──
                    '<div style="border:1px solid #d1dce8;border-radius:8px;overflow:hidden;">' +

                    // ── FIXED HEADER (no scroll) ──
                    '<div style="overflow:hidden;background:#1e3a5f;">' +
                    '<table style="width:' + totalW + 'px;border-collapse:collapse;table-layout:fixed;" id="teleHeaderTable">' +
                    colGroupHtml +
                    headerHtml +
                    '</table>' +
                    '</div>' +

                    // ── SCROLLABLE BODY ──
                    '<div id="teleBodyScroll" style="overflow-y:auto;overflow-x:auto;max-height:390px;"' +
                    ' onscroll="syncTeleScroll(this)">' +
                    '<table style="width:' + totalW + 'px;border-collapse:collapse;table-layout:fixed;">' +
                    colGroupHtml +
                    bodyHtml +
                    '</table>' +
