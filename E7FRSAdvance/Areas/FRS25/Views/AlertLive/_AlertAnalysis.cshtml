@model Domain.FRSAlertLister

@{
    var allAlerts = Model.mFRSAlerts.ToList();
    int failCount = Model.mFRSAlerts.Where(x => x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure).Count();
    int predCount = Model.mFRSAlerts.Where(x => x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive).Count();
    int totalCount = failCount + predCount;

    var assetGroups = allAlerts.GroupBy(x => x.AssetType ?? "Unknown").ToList();

    var totalByAsset = assetGroups.ToDictionary(g => g.Key, g => g.Count());
    var predByAsset = assetGroups.ToDictionary(g => g.Key,
        g => g.Count(x => x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive));
    var failByAsset = assetGroups.ToDictionary(g => g.Key,
        g => g.Count(x => x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure));

    var causeSummary = assetGroups.ToDictionary(
        g => g.Key,
        g => g.GroupBy(x => x.CauseCode ?? "-")
              .Select(cg => new
              {
                  code = cg.Key,
                  total = cg.Count(),
                  pred = cg.Count(x => x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive),
                  fail = cg.Count(x => x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure)
              })
              .OrderByDescending(c => c.total)
              .ToList()
    );

    var mFRSAlertRemarks = (ViewBag.FRSAlertRemarks as List<Domain.FRSAlertRemark>) ?? new List<Domain.FRSAlertRemark>();

    var rowsJson = Newtonsoft.Json.JsonConvert.SerializeObject(
        allAlerts.Select((item, i) =>
        {
            string rectDate = "-";
            if (item.ResetTimeStamp != null && item.ResetTimeStamp.Value != DateTime.MinValue)
                rectDate = item.ResetTimeStamp.Value.ToString("dd/MM/yyyy HH:mm:ss");
            else
            {
                var remark = mFRSAlertRemarks.Where(x => x.FRSAlertId == item.Id).OrderByDescending(x => x.Id).FirstOrDefault();
                if (remark != null && remark.RectificationDateTime != null)
                    rectDate = remark.RectificationDateTime.Value.ToString("dd/MM/yyyy HH:mm:ss");
            }
            string durStr = "-";
            if (item.ResetTimeStamp != null && item.ResetTimeStamp.Value != DateTime.MinValue)
            {
                var span = item.ResetTimeStamp.Value.Subtract(item.SetTimeStamp);
                durStr = span.Days + "-" + span.Hours.ToString("D2") + ":" + span.Minutes.ToString("D2") + ":" + span.Seconds.ToString("D2");
            }
            bool isPred = item.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive;
            return new
            {
                id = item.Id,
                assetId = item.AssetId,
                assetTypeId = item.AssetTypeId,
                siteId = item.SiteId,
                zone = item.ZoneName,
                division = item.DivisionName,
                station = item.SiteName,
                alertType = isPred ? "Predictive" : "Failure",
                assetType = item.AssetType ?? "-",
                assetNo = item.AssetName ?? "-",
                incDate = item.SetTimeStamp.ToString("dd/MM/yyyy HH:mm:ss"),
                duration = durStr,
                rectDate = rectDate,
                causeCode = item.CauseCode ?? "-",
                setMsg = item.SetAlertMessage ?? "",
                desc = item.Description ?? "",
                resetMsg = item.ResetAlertMessage ?? ""
            };
        }).ToList()
    );

    var causeSummaryJson = Newtonsoft.Json.JsonConvert.SerializeObject(causeSummary);
}

