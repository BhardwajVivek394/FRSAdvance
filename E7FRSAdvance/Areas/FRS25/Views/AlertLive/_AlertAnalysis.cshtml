$(document).ready(function() {
  _pageSize = window._alertPageSize || 10;
  renderTable();
  $('[data-toggle="popover"]').popover({ container:'body', html:true });
  var now=new Date(), meta=document.getElementById('frsPdfMeta');
  if(meta) meta.textContent='Report date: '+pad2(now.getDate())+'/'+pad2(now.getMonth()+1)+'/'+now.getFullYear()+'  '+pad2(now.getHours())+':'+pad2(now.getMinutes());
});

    function formatDateTimeAddForAPI(input, addMin) {
        // Split date and time

        // Parse manually (since JS doesn't reliably parse dd/MM/yyyy)
        const [datePart, timePart] = input.split(" ");
        const [day, month, year] = datePart.split("/").map(Number);
        const [hours, minutes, seconds] = timePart.split(":").map(Number);

        // Create Date object (month is 0-based in JS)
        const date = new Date(year, month - 1, day, hours, minutes, seconds);

        // Add 30 minutes
        date.setMinutes(date.getMinutes() + addMin);

        // Format function
        //const pad = (n) => n.toString().padStart(2, "0");

        //const formatted = `${pad(date.getDate())}${pad(date.getMonth() + 1)}${date.getFullYear()}_${pad(date.getHours())}${pad(date.getMinutes())}${pad(date.getSeconds())}`;


        // Format into ddMMyyyy_HHmmss
        return date;
    }

    function formatDateTimeMinusForAPI(input, addMin) {
        // Split date and time

        // Parse manually (since JS doesn't reliably parse dd/MM/yyyy)
        const [datePart, timePart] = input.split(" ");
        const [day, month, year] = datePart.split("/").map(Number);
        const [hours, minutes, seconds] = timePart.split(":").map(Number);

        // Create Date object (month is 0-based in JS)
        const date = new Date(year, month - 1, day, hours, minutes, seconds);

        // Add 30 minutes
        date.setMinutes(date.getMinutes() - addMin);

        // Format function
        //const pad = (n) => n.toString().padStart(2, "0");

        //const formatted = `${pad(date.getDate())}${pad(date.getMonth() + 1)}${date.getFullYear()}_${pad(date.getHours())}${pad(date.getMinutes())}${pad(date.getSeconds())}`;


        // Format into ddMMyyyy_HHmmss
        return date;
    }


    function renderHistoryTable(assetResults) {
        thCache = parseTableData(assetResults);
        thCurrentPage = 1;
        thTotalPages = Math.ceil(thCache.allTimestamps.length / TH_PAGE_SIZE) || 1;

        if (thCache.allTimestamps.length === 0) {
            $('#divTelemetryHistory').html('<div class="text-center text-muted p-5">No valid timestamp data found.</div>');
            $('#divPagination').hide();
            return;
        }

        var h = [];
        h.push('<div class="history-table-wrapper">');
        h.push('<table class="history-table" id="tblHistory">');
        h.push(buildThead(thCache));
        h.push('<tbody id="tblHistoryBody"></tbody>');
        h.push('</table></div>');

        //$('#divTelemetryHistory').html(h.join(''));
        //renderTablePage(1);
    }

    function parseTableData(assetResults) {
        var allTimestampsSet = {};
        var attributeData = {};
        var attrDataType = {};
        var columns = [];
        var assetGroups = [];

        assetResults.forEach(function (assetObj) {
            var aId = assetObj.assetId;
            var aName = assetObj.assetName;
            var attrs = assetObj.attributes.Data || [];
            var attrIdsForAsset = [];

            attrs.forEach(function (attr) {

                var attrId = attr.AttributeId;
                var compositeKey = aId + '_' + attrId;
                var entries = [];
                var detectedType = '';
                var values = attr.Values;
                for (var key in values) {
                    if (values.hasOwnProperty(key)) {
                        var entry = values[key];
                        var tsDate = new Date(entry.Timestamp.TimestampDevice);
                        if (tsDate.getFullYear() <= 1) continue;
                        allTimestampsSet[tsDate.getTime()] = tsDate;
                        entries.push({ ts: tsDate, value: entry.Value });
                        if (!detectedType && entry.DataType) detectedType = entry.DataType;
                    }
                }
                entries.sort(function (a, b) { return a.ts.getTime() - b.ts.getTime(); });
                attributeData[compositeKey] = entries;
                attrDataType[compositeKey] = detectedType || '';
                attrIdsForAsset.push(attrId);
            });

            attrIdsForAsset.sort(function (a, b) { return a - b; });
            attrIdsForAsset.forEach(function (attrId) {
                var ck = aId + '_' + attrId;
                var isDataLogger = (attrDataType[ck] || '').toLowerCase() === 'datalogger';
                // FIXED: Use relay name for DataLogger (same as Live page)
                var displayName = getAttrDisplayName(attrId, isDataLogger);
                columns.push({ assetId: aId, assetName: aName, attrId: attrId, isDataLogger: isDataLogger, displayName: displayName });
            });
            assetGroups.push({ assetId: aId, assetName: aName, attrCount: attrIdsForAsset.length });
        });

        //var allTimestamps = [];
        //for (var key in allTimestampsSet) allTimestamps.push(allTimestampsSet[key]);
        //allTimestamps.sort(function (a, b) { return b.getTime() - a.getTime(); });

        //var displayGrid = new Array(allTimestamps.length);

        var allTimestamps = [];
        for (var key in allTimestampsSet) allTimestamps.push(allTimestampsSet[key]);
        allTimestamps.sort(function (a, b) { return b.getTime() - a.getTime(); });

        // ===== LAST-CHANGE ROW LOGIC =====
        var searchStartDate = null;
        var fromDateVal = $('#txtFromDate').val();
        var fromTimeVal = $('#txtFromTime').val() || '00:00';
        if (fromDateVal) {
            var dp = fromDateVal.split('-');
            var tp = fromTimeVal.split(':');
            searchStartDate = new Date(parseInt(dp[0]), parseInt(dp[1]) - 1, parseInt(dp[2]),
                parseInt(tp[0]), parseInt(tp[1]), 0, 0);
        }

        if (searchStartDate) {
            var startMs = searchStartDate.getTime();
            var preStartTs = [];
            var inRangeTs = [];
            allTimestamps.forEach(function (ts) {
                if (ts.getTime() < startMs) preStartTs.push(ts);
                else inRangeTs.push(ts);
            });

            if (preStartTs.length > 0) {
                var lastPreStartTs = preStartTs[0];
                var syntheticTs = new Date(startMs);
                syntheticTs._originalTs = lastPreStartTs;
                syntheticTs._isStartRow = true;

                for (var ck in attributeData) {
                    var entries = attributeData[ck];
                    var carryVal = null;
                    for (var ei = 0; ei < entries.length; ei++) {
                        if (entries[ei].ts.getTime() <= lastPreStartTs.getTime()) carryVal = entries[ei].value;
                        else break;
                    }
                    if (carryVal !== null) {
                        var alreadyExists = false;
                        for (var ei2 = 0; ei2 < entries.length; ei2++) {
                            if (entries[ei2].ts.getTime() === startMs) { alreadyExists = true; break; }
                        }
                        if (!alreadyExists) {
                            entries.push({ ts: syntheticTs, value: carryVal });
                            entries.sort(function (a, b) { return a.ts.getTime() - b.ts.getTime(); });
                        }
                    }
                }

                allTimestamps = [syntheticTs].concat(inRangeTs);
                allTimestamps.sort(function (a, b) { return b.getTime() - a.getTime(); });
            }
        }
        // ===== END LAST-CHANGE ROW LOGIC =====

        var displayGrid = new Array(allTimestamps.length);



        var prevRowValues = {};
        var changedCount = 0, unchangedCount = 0;

        for (var r = allTimestamps.length - 1; r >= 0; r--) {
            var rowTs = allTimestamps[r];
            var rowCells = [];
            for (var c = 0; c < columns.length; c++) {
                var col = columns[c];
                var compositeKey = col.assetId + '_' + col.attrId;
                var rawValue = getValueForTimestamp(attributeData[compositeKey], rowTs);
                var displayVal = '', cellClass = '', cellContent = '';

                if (col.isDataLogger) {
                    if (rawValue !== null) {
                        var numVal = parseFloat(rawValue);
                        if (numVal === 1) { displayVal = 'Pickup'; cellContent = '<span class="dl-pickup">Pickup</span>'; }
                        else if (numVal === 0) { displayVal = 'Drop'; cellContent = '<span class="dl-drop">Drop</span>'; }
                        else { displayVal = numVal.toFixed(3); cellContent = displayVal; }
                    } else { displayVal = '-'; cellContent = '-'; }
                } else {
                    displayVal = (rawValue !== null ? parseFloat(rawValue).toFixed(3) : '-');
                    cellContent = displayVal;
                }

                if (prevRowValues[compositeKey] !== undefined && displayVal !== '-') {
                    if (displayVal !== prevRowValues[compositeKey] && prevRowValues[compositeKey] !== '-') {
                        cellClass = 'val-changed'; changedCount++;
                    } else if (displayVal === prevRowValues[compositeKey]) {
                        cellClass = 'val-unchanged'; unchangedCount++;
                    }
                }
                prevRowValues[compositeKey] = displayVal;
                rowCells.push({ cls: cellClass, html: cellContent });
            }
            displayGrid[r] = rowCells;
        }

        return {
            columns: columns, assetGroups: assetGroups,
            allTimestamps: allTimestamps, attributeData: attributeData,
            displayGrid: displayGrid,
            changedCount: changedCount, unchangedCount: unchangedCount,
            isTrack: isTrackAssetType()
        };
    }

    function getAttrDisplayName(attrId, isDataLogger) {
        if (isDataLogger) {
            var dlName = DATALOGGER_RELAY_MAP[attrId] || DATALOGGER_RELAY_MAP[String(attrId)];
            if (dlName) return dlName;
            return 'DL-' + attrId;
        }
        var attr = assetAttributeMap[attrId] || assetAttributeMap[String(attrId)];
        if (attr) return attr.alias || attr.title || ('Attr ' + attrId);
        return 'Attr ' + attrId;
    }


    function getValueForTimestamp(entries, targetTs) {
        if (!entries || entries.length === 0) return null;
        var targetTime = targetTs.getTime();
        var bestValue = null;
        for (var i = 0; i < entries.length; i++) {
            var entryTime = entries[i].ts.getTime();
            if (entryTime === targetTime) return entries[i].value;
            if (entryTime <= targetTime) bestValue = entries[i].value;
            else break;
        }
        return bestValue;
    }
</script>
