    // ── Render ECharts graph from network JSON response ────────
    function renderNetworkGraph(container, data, number, type, protocol) {
        // Normalize data — support array or { timestamps:[], values:[] } or { data:[] }
        var points = [];
        if (Array.isArray(data)) {
            points = data;
        } else if (data.data && Array.isArray(data.data)) {
            points = data.data;
        } else if (data.points && Array.isArray(data.points)) {
            points = data.points;
        } else {
            points = [data]; // single object
        }

        // Extract x (time) and series
        var keys = points.length > 0 ? Object.keys(points[0]) : [];
        var timeKey = keys.find(function (k) {
            var v = String(points[0][k] || '');
            return k.toLowerCase().includes('time') || k.toLowerCase().includes('date') || v.match(/^\d{4}-/);
        }) || keys[0];
        var valueKeys = keys.filter(function (k) { return k !== timeKey; });

        var xValues = points.map(function (p) {
            var raw = String(p[timeKey] || '');
            // Try to shorten timestamp for display
            try {
                var d = new Date(raw);
                if (!isNaN(d.getTime())) {
                    return pad2(d.getHours()) + ':' + pad2(d.getMinutes()) + ':' + pad2(d.getSeconds());
                }
            } catch (e) { }
            return raw;
        });

        var colors = ['#4bacc6', '#e74c3c', '#2ecc71', '#f39c12', '#9b59b6', '#1abc9c', '#e67e22', '#3498db'];
        var series = valueKeys.map(function (k, i) {
            return {
                name: k,
                type: 'line',
                smooth: false,
                symbol: 'none',
                connectNulls: true,
                lineStyle: { width: 1.8 },
                color: colors[i % colors.length],
                data: points.map(function (p) {
                    var v = parseFloat(p[k]);
                    return isNaN(v) ? null : v;
                })
            };
        });

        // Build chart container
        container.innerHTML =
            // Title bar
            '<div style="display:flex;align-items:center;justify-content:space-between;' +
            'margin-bottom:10px;flex-wrap:wrap;gap:8px;">' +
            '<div style="font-size:12px;font-weight:700;color:#1e293b;">' +
            '<i class="fas fa-chart-line" style="margin-right:5px;color:#0077cc"></i>' +
            escHtml(type) + ' — ' + escHtml(number) +
            ' <span style="font-weight:400;color:#64748b;font-size:11px">· ' + escHtml(protocol) + '</span>' +
            '</div>' +
            '<span style="font-size:10px;color:#94a3b8;">' + points.length + ' data points</span>' +
            '</div>' +
            '<div id="netEChart" style="width:100%;height:300px;border:1px solid #e2e8f0;border-radius:8px;"></div>';

        // Init ECharts
        if (window._netChart) {
            try { window._netChart.dispose(); } catch (e) { }
            window._netChart = null;
        }

        function initNetChart() {
            var dom = document.getElementById('netEChart');
            if (!dom) return;

            window._netChart = echarts.init(dom, null, { renderer: 'canvas' });
            window._netChart.setOption({
                backgroundColor: 'transparent',
                tooltip: {
                    trigger: 'axis',
                    confine: true,
                    axisPointer: { type: 'cross', label: { backgroundColor: '#1e293b' } },
                    formatter: function (params) {
                        var html = '<div style="font-size:11px;min-width:160px;">' +
                            '<div style="font-weight:700;color:#1e293b;margin-bottom:4px;' +
                            'padding-bottom:4px;border-bottom:1px solid #e2e8f0">' +
                            params[0].axisValue + '</div>';
                        params.forEach(function (p) {
                            if (p.value === null) return;
                            html += '<div style="display:flex;justify-content:space-between;gap:12px;margin:2px 0">' +
                                '<span>' + p.marker + p.seriesName + '</span>' +
                                '<span style="font-weight:700;font-family:monospace">' + p.value + '</span></div>';
                        });
                        return html + '</div>';
                    }
                },
                legend: {
                    data: valueKeys,
                    type: 'scroll',
                    top: 0,
                    left: 0,
                    right: 40,
                    textStyle: { fontSize: 10, color: '#475569' },
                    itemWidth: 12,
                    itemHeight: 8
                },
                toolbox: {
                    right: 4,
                    top: 0,
                    feature: {
                        dataZoom: { yAxisIndex: 'none', title: { zoom: 'Zoom', back: 'Undo' } },
                        restore: { title: 'Restore' },
                        saveAsImage: { title: 'Save PNG' }
                    }
                },
                grid: { top: 40, left: 50, right: 20, bottom: 55, containLabel: false },
                xAxis: [{
                    type: 'category',
                    boundaryGap: false,
                    data: xValues,
                    axisLine: { lineStyle: { color: '#d1dce8' } },
                    axisLabel: {
                        fontSize: 9,
                        color: '#6b7280',
                        rotate: 30,
                        interval: Math.max(0, Math.floor(xValues.length / 10) - 1)
                    },
                    splitLine: { show: false }
                }],
                yAxis: [{
                    type: 'value',
                    axisLine: { lineStyle: { color: '#d1dce8' } },
                    axisLabel: { fontSize: 9, color: '#475569' },
                    splitLine: { lineStyle: { color: '#f1f5f9', type: 'dashed' } }
                }],
                dataZoom: [
                    {
                        type: 'slider',
                        bottom: 4,
                        height: 20,
                        start: 0,
                        end: 100,
                        fillerColor: 'rgba(0,119,204,0.08)',
                        borderColor: '#d1dce8',
                        handleStyle: { color: '#0077cc' },
                        textStyle: { color: '#6b7280', fontSize: 9 }
                    },
                    { type: 'inside', start: 0, end: 100 }
                ],
                color: colors,
                series: series
            });

            setTimeout(function () {
                if (window._netChart) window._netChart.resize();
            }, 100);
        }

        if (typeof echarts !== 'undefined') {
            initNetChart();
        } else {
            var s = document.createElement('script');
            s.src = 'https://cdnjs.cloudflare.com/ajax/libs/echarts/5.4.3/echarts.min.js';
            s.onload = function () { initNetChart(); };
            document.head.appendChild(s);
        }
    }

