<!-- ── PDF PROGRESS BAR ── -->
<div class="frs-pdf-progress" id="frsPdfProgress">
    <div class="frs-pdf-progress-bar" id="frsPdfProgressBar"></div>
</div>

<!-- ════ PDF CAPTURE WRAPPER ════ -->
<div id="frsPdfCapture">

    <!-- ── PDF TOOLBAR ── -->
    <div class="frs-pdf-toolbar" id="frsPdfToolbar">
        <div class="frs-pdf-toolbar-left">
            <span class="frs-pdf-toolbar-title"><i class="fas fa-chart-bar"></i> Alert Analysis Report</span>
            <span class="frs-pdf-toolbar-meta" id="frsPdfMeta"></span>
        </div>
        <button class="frs-btn-pdf" id="frsBtnPdf" onclick="fnDownloadAlertPDF()">
            <i class="fas fa-file-pdf"></i> Download PDF
        </button>
    </div>

    <!-- ── SUMMARY CARDS ── -->
    <div class="frs-summary">
        <div class="frs-card ct">
            <div class="frs-card-lbl">Total Alerts</div>
            <div class="frs-card-big">@totalCount.ToString("N0")</div>
            <div class="frs-chip-wrap" id="chipsTotal">
                @foreach (var kv in totalByAsset.OrderByDescending(x => x.Value))
                {
                    <div class="frs-chip" data-asset="@kv.Key" data-card="total" onclick="onChipClick(this)">
                        <span class="frs-chip-name"><i class="fas fa-chevron-right"></i>@kv.Key</span>
                        <span class="frs-chip-count">@kv.Value.ToString("N0")</span>
                    </div>
                }
            </div>
        </div>
        <div class="frs-card cp">
            <div class="frs-card-lbl">Predictive</div>
            <div class="frs-card-big">@predCount.ToString("N0")</div>
            <div class="frs-chip-wrap" id="chipsPred">
                @foreach (var kv in predByAsset.OrderByDescending(x => x.Value))
                {
                    <div class="frs-chip" data-asset="@kv.Key" data-card="predictive" onclick="onChipClick(this)">
                        <span class="frs-chip-name"><i class="fas fa-chevron-right"></i>@kv.Key</span>
                        <span class="frs-chip-count">@kv.Value.ToString("N0")</span>
                    </div>
                }
            </div>
        </div>
        <div class="frs-card cf">
            <div class="frs-card-lbl">Failure</div>
            <div class="frs-card-big">@failCount.ToString("N0")</div>
            <div class="frs-chip-wrap" id="chipsFail">
                @foreach (var kv in failByAsset.OrderByDescending(x => x.Value))
                {
                    <div class="frs-chip" data-asset="@kv.Key" data-card="failure" onclick="onChipClick(this)">
                        <span class="frs-chip-name"><i class="fas fa-chevron-right"></i>@kv.Key</span>
                        <span class="frs-chip-count">@kv.Value.ToString("N0")</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ── CAUSE CODE PANEL ── -->
    <div class="frs-cause-panel" id="frsCausePanel" style="display:none">
        <div class="frs-cp-head">
            <div class="frs-cp-title"><i class="fas fa-sitemap"></i><span id="frsCpTitle"></span></div>
            <button class="frs-cp-close" onclick="closeCausePanel()"><i class="fas fa-times"></i></button>
        </div>
        <div class="frs-cause-grid" id="frsCauseGrid"></div>
    </div>

    <!-- ── ALERT TABLE ── -->
    <div class="frs-table-wrap">
        <div class="frs-table-scroll">
            <table class="frs-tbl" id="frsAlertTable">
                <thead>
                    <tr>
                        <th>Sr.No</th>
                        <th>Zone</th>
                        <th>Division</th>
                        <th>Station</th>
                        <th>Alert Type</th>
                        <th>Asset Type</th>
                        <th>Asset No.</th>
                        <th>Incidence Date &amp; Time</th>
                        <th>Duration (day-hh:mm:ss)</th>
                        <th>Rectification Date &amp; Time</th>
                        <th>Cause of Asset Failure</th>
                        <th class="frs-th-msg">Message &amp; Description</th>
                    </tr>
                </thead>
                <tbody id="frsAlertBody">
                    <tr>
                        <td colspan="12" style="text-align:center;padding:30px;color:#6b7280">
                            <i class="fas fa-circle-notch fa-spin"></i> Loading...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="frs-pager" id="frsPagerBar"></div>
    </div>

</div><!-- /#frsPdfCapture -->
<!-- ── CAUSE CODE DETAIL MODAL ── -->
