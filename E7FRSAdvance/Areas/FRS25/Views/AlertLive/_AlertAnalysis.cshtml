var _pageSize    = window._alertPageSize || 10;
var _currentPage = 1;

function renderTable() {
  var total  = _allRows.length;
  var tp     = Math.ceil(total/_pageSize)||1;
  if (_currentPage > tp) _currentPage = tp;
  var start  = (_currentPage-1)*_pageSize;
  var slice  = _allRows.slice(start, start+_pageSize);
  window._alertCurrentSkip = start;

  if (slice.length === 0) {
    document.getElementById('frsAlertBody').innerHTML =
      '<tr><td colspan="12" style="text-align:center;padding:30px;color:#6b7280">No records found.</td></tr>';
    document.getElementById('frsPagerBar').innerHTML = '';
    return;
  }

  document.getElementById('frsAlertBody').innerHTML = slice.map(function(r, i) {
    var idx      = start+i+1;
    var badgeCls = r.alertType==='Predictive' ? 'frs-badge-pred' : 'frs-badge-fail';
    return '<tr>' +
      '<td style="font-family:monospace;color:#6b7280">' + idx + '</td>' +
      '<td>' + escHtml(r.zone) + '</td>' +
      '<td>' + escHtml(r.division) + '</td>' +
      '<td>' + escHtml(r.station) + '</td>' +
      '<td><span class="frs-badge '+badgeCls+'">' + r.alertType + '</span></td>' +
      '<td style="font-weight:600">' + escHtml(r.assetType) + '</td>' +
      '<td style="font-family:monospace">' + escHtml(r.assetNo) + '</td>' +
      '<td style="font-family:monospace;color:#475569">' + r.incDate + '</td>' +
      '<td style="font-family:monospace;color:#6b7280">' + escHtml(r.duration) + '</td>' +
      '<td style="font-family:monospace;color:#475569">' + escHtml(r.rectDate) + '</td>' +
      '<td>' +
        '<span id="spnAlertmsg'+r.id+'" style="display:none">' + escHtml(r.setMsg) + '</span>' +
        '<span id="spnAlertDescription'+r.id+'" style="display:none">' + r.desc + '</span>' +
        '<span id="spnResetAlertmsg'+r.id+'" style="display:none">' + r.resetMsg + '</span>' +
        '<button class="frs-cause-btn" onclick="openCauseModal(\''+escJs(r.causeCode)+'\')">' + escHtml(r.causeCode) + '</button>' +
        '&nbsp;<a href="javascript:void(0)" onclick="fnShowAlertMessage(\''+r.id+'\')" title="Alert Message" style="color:#6b7280;font-size:10px"><i class="fas fa-info-circle"></i></a>' +
      '</td>' +
      '<td class="frs-td-msg">' +
        (r.setMsg   ? '<div class="frs-msg-line frs-msg-set">'               + sanitizeMsg(r.setMsg)  + '</div>' : '') +
        (r.desc     ? '<div class="frs-msg-line frs-msg-desc">'              + sanitizeMsg(r.desc)    + '</div>' : '') +
        (r.resetMsg ? '<div class="frs-msg-line frs-msg-reset"><b>Reset:</b> ' + sanitizeMsg(r.resetMsg) + '</div>' : '') +
      '</td>' +
    '</tr>';
  }).join('');

  renderPager(total, tp);
}

function renderPager(total, tp) {
  var cp   = _currentPage;
  var from = total > 0 ? (cp-1)*_pageSize+1 : 0;
  var to   = Math.min(cp*_pageSize, total);
  var btns = '';
  var addBtn = function(p){ btns+='<button class="'+(p===cp?'active':'')+'" onclick="goToPage('+p+')">'+p+'</button>'; };
  var addEll = function(){ btns+='<button class="frs-ell" disabled>\u2026</button>'; };
  if (tp<=7) { for(var p=1;p<=tp;p++) addBtn(p); }
  else {
    addBtn(1); if(cp>4) addEll();
    var s=Math.max(2,cp-2), e=Math.min(tp-1,cp+2);
    for(var p=s;p<=e;p++) addBtn(p);
    if(cp<tp-3) addEll(); addBtn(tp);
  }
  document.getElementById('frsPagerBar').innerHTML =
    '<span class="frs-pager-info">Showing <b>'+from.toLocaleString()+'\u2013'+to.toLocaleString()+'</b> of <b>'+total.toLocaleString()+'</b></span>' +
    '<div class="frs-pager-btns">' +
      '<button '+(cp<=1?'disabled':'')+' onclick="goToPage(1)" title="First"><i class="fas fa-angle-double-left"></i></button>' +
      '<button '+(cp<=1?'disabled':'')+' onclick="goToPage('+(cp-1)+')"><i class="fas fa-chevron-left"></i> Prev</button>' +
      btns +
      '<button '+(cp>=tp?'disabled':'')+' onclick="goToPage('+(cp+1)+')">Next <i class="fas fa-chevron-right"></i></button>' +
      '<button '+(cp>=tp?'disabled':'')+' onclick="goToPage('+tp+')" title="Last"><i class="fas fa-angle-double-right"></i></button>' +
    '</div>' +
    '<div class="frs-psize">Rows:<select onchange="changePageSize(this.value)">' +
      '<option value="10" '+(_pageSize===10?'selected':'')+'>10</option>' +
      '<option value="25" '+(_pageSize===25?'selected':'')+'>25</option>' +
      '<option value="50" '+(_pageSize===50?'selected':'')+'>50</option>' +
      '<option value="100" '+(_pageSize===100?'selected':'')+'>100</option>' +
    '</select></div>';
}

function goToPage(p) { var tp=Math.ceil(_allRows.length/_pageSize)||1; if(p<1||p>tp) return; _currentPage=p; renderTable(); }
function changePageSize(s) { _pageSize=parseInt(s)||10; window._alertPageSize=_pageSize; _currentPage=1; renderTable(); }
function reloadCurrentPage() { if(typeof fnGetAlertDetailReport==='function') fnGetAlertDetailReport(window._alertCurrentSkip||0); }
function GoToPage(pageNum) { goToPage(pageNum); }
function changeAlertPageSize(s) { changePageSize(s); }

