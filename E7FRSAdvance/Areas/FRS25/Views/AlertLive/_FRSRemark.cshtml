@model List<Domain.FRSAlertRemark>

@if (Model != null && Model.Count > 0)
{
    <div class="modal fade alrt-modal" id="modalFRSAlertRemark" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content alrt-modal-content">

                <!-- HEADER -->
                <div class="modal-header alrt-modal-header">
                    <h4 class="modal-title">See all Feedback & Remarks</h4>
                    <button type="button" class="alrt-close" data-dismiss="modal">×</button>
                </div>

                <!-- BODY -->
                <div class="modal-body alrt-modal-body">
                    <div class="table-responsive">
                        <table class="alrt-table-modern">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Status</th>
                                    <th>Remark / Cause</th>
                                    <th>Rectification Time</th>
                                    <th>Maintainer</th>
                                    <th>Designation</th>
                                    <th>Timestamp</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var srNo = 1;
                                }

                                @foreach (var item in Model)
                                {
                                    var status = item.AcknowledgementStatusId;

                                    var css = status == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True ? "pill-green"
                                            : status == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False ? "pill-red"
                                            : status == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT ? "pill-yellow"
                                            : "pill-blue";

                                    <tr>
                                        <td>@srNo</td>

                                        <!-- STATUS -->
                                        <td>
                                            <span class="alrt-pill @css">
                                                @((E7FRSAdvance.Utility.Utility.AcknowledgemenStatus)status)
                                            </span>
                                        </td>

                                        <!-- REMARK -->
                                        <td>
                                            @if (status == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT)
                                            {
                                                <div><b>@item.PTAlertInfoId</b></div>
                                            }
                                            <div>@item.Remark</div>
                                        </td>

                                        <!-- RECTIFICATION -->
                                        <td>
                                            @(item.RectificationDateTime != null && item.RectificationDateTime != DateTime.MinValue
                                                ? item.RectificationDateTime.Value.ToString("dd/MM/yyyy HH:mm:ss")
                                                : "-")
                                        </td>

                                        <!-- MAINTAINER -->
                                        <td>@(item.MaintainerName ?? "-")</td>

                                        <!-- DESIGNATION -->
                                        <td>@(item.MaintainerDesignation ?? "-")</td>

                                        <!-- CREATED -->
                                        <td>
                                            @(item.CreatedDate != DateTime.MinValue
                                                ? item.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")
                                                : "-")
                                        </td>
                                    </tr>

                                    srNo++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- FOOTER -->
                <div class="modal-footer alrt-modal-footer">
                    <button type="button" class="alrt-btn-secondary" data-dismiss="modal">
                        Close
                    </button>
                </div>

            </div>
        </div>
    </div>
}