    function fnShowAlertMessage(id) {
        var alertmsg = $('#spnAlertmsg' + id).text();
        var alertDesc = $('#spnAlertDescription' + id).text();
        var resetAlertDesc = $('#spnResetAlertmsg' + id).text();
        var msg = "";
        msg = alertmsg.replace(/\n/g, "") + "<br>" + alertDesc.replace(/\n/g, "");
        if (resetAlertDesc != null && resetAlertDesc != '') {
            msg += "<br><b>Reset Message</b>" + "<br>" + resetAlertDesc.replace(/\n/g, "");
        }
        $('#spnAlertMessage').html(msg.replace(/\n/g, "<br>"));
        $('#modelShowAlertMessage').modal('show');
    }

