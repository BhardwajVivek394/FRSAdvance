    function AddRemark(id, statusId) {
        if (id != null && id != undefined && id != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRS25/AlertLive/GetBy',
                type: 'POST',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data.Id > 0) {
                        $('#hdnAlertRemarkId').val(id);
                        $('#txtAlertRemark').val(data.Remark);
                        $('#hdnAlertAlertStatusId').val(statusId);
                    }

                    if (data.mAlertInfos != null && data.mAlertInfos.length > 0 && statusId == '@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT.GetHashCode()') {
                        $('#divRemarkAlertInfo').show();
                        $('#drpRemarkAlertInfo').empty();
                        $('#drpRemarkAlertInfo').append($("<option></option>").val('').html('Select'));
                        $(data.mAlertInfos).each(function (d, value) {
                            $('#drpRemarkAlertInfo').append($("<option></option>").val(value.Id).html(value.Name));
                        });
                    } else {
                        $('#drpRemarkAlertInfo').empty();
                        $('#divRemarkAlertInfo').hide();
                    }

                    $('#modelAddRemark').modal('show');
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }
    }

    function fnUpdateRemark() {
        var isValid = true;
        if ($('#txtAlertRemark').val() != null && $('#txtAlertRemark').val() != undefined && $('#txtAlertRemark').val() != '') {
            var mFRSAlert = {};
            mFRSAlert.Id = $('#hdnAlertRemarkId').val();
            mFRSAlert.Remark = $('#txtAlertRemark').val();

            var rectificationValue = $('#txtRectificationDateTime').val();

            if (rectificationValue != null && rectificationValue != '') {
                mFRSAlert.RectificationDateTime = new Date(rectificationValue).toISOString();
                var rectificationDate = new Date(rectificationValue);
                var now = new Date();
                if (rectificationDate > now) {
                    alert("Future date & time is not allowed.");
                    return false;
                }
            }

            mFRSAlert.AcknowledgemenStatusId = $('#hdnAlertAlertStatusId').val();
            if (mFRSAlert.AcknowledgemenStatusId != null && mFRSAlert.AcknowledgemenStatusId != undefined && mFRSAlert.AcknowledgemenStatusId == '@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT.GetHashCode()') {
                mFRSAlert.PTAlertInfoId = $('#drpRemarkAlertInfo').val();
                if (mFRSAlert.PTAlertInfoId != null && mFRSAlert.PTAlertInfoId != undefined && mFRSAlert.PTAlertInfoId != '') {
                } else {
                    isValid = false;
                    alert('Cause Code is required.');
                }
            }
            if (isValid) {
                $("#loader").show();
                $.ajax({
                    url: '/FRS25/AlertLive/UpdateRemark',
                    type: 'Post',
                    contentType: 'application/json',
                    data: JSON.stringify(mFRSAlert),
                    dataType: 'json',
                    success: function (data) {
                        $("#loader").hide();
                        $('#modelAddRemark').modal('hide');
                        reloadCurrentPage();
                        if (data != null) {
                            if (data.type == "success") {
                                alert(data.result);
                            }
                            else if (data.type == "error") {
                                alert(data.result);
                            }
                        }
                    },
                    error: function (response) {
                        $('#modelAddRemark').modal('hide');
                        $("#loader").hide();
                        alert("Something went wrong!");
                    }
                });
            }
        } else {
            alert('Remark is required.');
        }
    }

