@model Domain.PointMachineDataLister

<div class="table-border p-lg-4 p-2">
    @if (Model != null && Model.mPointMachineDatas != null && Model.mPointMachineDatas.Count > 0)
    {
        foreach (var asset in Model.mPointMachineDatas.GroupBy(x => new { x.AssetId, x.AssetName }).Select(x => x.Key).ToList())
        {
            var mAsset = Model.mAssets != null ? Model.mAssets.Where(x => x.Id == asset.AssetId).FirstOrDefault() : null;
            if (mAsset != null && mAsset.Id > 0)
            {
                bool isFullPointMachine = mAsset.IsHalfPointMachine == null || (mAsset.IsHalfPointMachine != null && !mAsset.IsHalfPointMachine.Value);

                <div class="ai-sec-asset">
                    <div class="ai-sec-asset-head">
                        <h6>
                            <a>PointMachine : @asset.AssetName</a>
                        </h6>
                    </div>
                    <div class="ai-sec-asset-body">
                        <div class="table-responsive tblAssetData ai-sec-scroll">
                            <table class="table table-hover" id="tblPoint@(asset.AssetId)">
                                <thead class="thead-light2">
                                    <tr>
                                        <th>Date</th>
                                        <th>Name</th>
                                        <th>Direction</th>
                                        @if (mAsset.IsSeriesOpration != null && mAsset.IsSeriesOpration.Value)
                                        {
                                            <th>Combine</th>
                                        }
                                        @if (isFullPointMachine)
                                        {
                                            <th>A Current(Max/Avg)</th>
                                            <th>A Voltage</th>
                                            <th>A Time (ms)</th>
                                            <th>B Current(Max/Avg)</th>
                                            <th>B Voltage</th>
                                            <th>B Time (ms)</th>
                                        }
                                        else
                                        {
                                            <th>Current(Max/Avg)</th>
                                            <th>Voltage</th>
                                            <th>Time (ms)</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var point in Model.mPointMachineDatas.Where(x => x.AssetId == asset.AssetId))
                                    {
                                        var pointRemark = (point.Remark ?? string.Empty).Split('~');
                                        <tr>
                                            <td>@point.TimeStamp.ToString()</td>
                                            <td>@point.AssetName</td>
                                            <td>@point.Direction</td>

                                            @if (mAsset.IsSeriesOpration != null && mAsset.IsSeriesOpration.Value)
                                            {
                                                var sumTime = point.PointMachineJson.A_C_TIME + point.PointMachineJson.B_C_TIME;
                                                <td>
                                                    <a href="#" class="ai-sec-link" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','CC',' @point.Date','@point.Direction','@point.AssetType'); return false;">C</a>/<a href="#" class="ai-sec-link" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','CV',' @point.Date','@point.Direction','@point.AssetType'); return false;">V</a>/<a>T(@sumTime)</a>
                                                </td>
                                            }

                                            <td>
                                                <a class="ai-sec-link" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','AC',' @point.Date','@point.Direction','@point.AssetType')">
                                                    @string.Format("{0:0.00}", point.PointMachineJson.A_C_MAX)  /  @string.Format("{0:0.00}", point.PointMachineJson.A_C_AVERAGE)
                                                </a>
                                                <br />
                                                @if (pointRemark.Length > 0)
                                                {
                                                    <span class="ai-sec-remark">@pointRemark[0]</span>
                                                }
                                            </td>
                                            <td class="ai-sec-click" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','AV',' @point.Date','@point.Direction','@point.AssetType')">
                                                @point.PointMachineJson.A_V_AVERAGE
                                            </td>
                                            <td>
                                                <span>@point.PointMachineJson.A_C_TIME</span>
                                            </td>
                                            @if (isFullPointMachine)
                                            {
                                                <td>
                                                    <a class="ai-sec-link" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','BC',' @point.Date','@point.Direction','@point.AssetType')">@string.Format("{0:0.00}", point.PointMachineJson.B_C_MAX)  /  @string.Format("{0:0.00}", point.PointMachineJson.B_C_AVERAGE)</a>
                                                    <br />
                                                    @if (pointRemark.Length > 1)
                                                    {
                                                        <span class="ai-sec-remark">@pointRemark[1]</span>
                                                    }
                                                </td>
                                                <td class="ai-sec-click" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','BV',' @point.Date','@point.Direction','@point.AssetType')">
                                                    @point.PointMachineJson.B_V_AVERAGE
                                                </td>
                                                <td>
                                                    @point.PointMachineJson.B_C_TIME
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <p class="ai-sec-empty">No record found!</p>
    }
</div>
