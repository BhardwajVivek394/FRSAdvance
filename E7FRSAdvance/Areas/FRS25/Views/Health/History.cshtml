sendA10(JSON.stringify({id:parseInt(cur.a10.a10Id,10)||1,channel_set:parseInt(ch,10),mode:parseInt(mo,10)||0,threshold:parseInt(th,10)||60,mul:parseInt(mu,10)||328,div:parseInt(dv,10)||100,offset:parseInt(of,10)||0}))}
