@{
    ViewBag.Title = "Health History";
    Layout = null;
    var siteId = Convert.ToInt32(ViewBag.SiteId ?? 0);
    var siteName = Convert.ToString(ViewBag.SiteName ?? ("Site " + siteId));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Health History - @siteName</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/paho-mqtt/1.0.1/mqttws31.min.js"></script>
    <style>
        :root {
            --bg: #070d1d;
            --panel: #0c1731;
            --panel2: #101e3e;
            --bdr: #1b2c55;
            --bdr2: #27407a;
            --txt: #e7edf7;
            --mut: #9fb1d1;
            --dim: #60749a;
            --cyan: #22d3ee;
            --green: #34d399;
            --red: #fb7185;
            --amber: #fbbf24;
            --blue: #60a5fa;
            --mono: 'JetBrains Mono',Consolas,monospace;
            --sans: 'Manrope','Segoe UI',Arial,sans-serif
        }

        * {
            box-sizing: border-box
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: radial-gradient(1000px 480px at 10% -10%,rgba(34,211,238,.12),transparent 60%),radial-gradient(900px 520px at 100% 0,rgba(96,165,250,.10),transparent 55%),var(--bg);
            color: var(--txt);
            font-family: var(--sans);
            padding: 22px
        }

        .top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            margin-bottom: 16px
        }

        .title h1 {
            font-size: 24px;
            margin: 0 0 5px
        }

        .meta {
            color: var(--mut);
            font-size: 13px
        }

        .back {
            border: 1px solid var(--bdr2);
            background: linear-gradient(135deg,#10244d,#0b1733);
            color: var(--txt);
            border-radius: 12px;
            padding: 10px 14px;
            cursor: pointer;
            font-weight: 800
        }

            .back:hover {
                border-color: var(--cyan)
            }

        .datebar {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            background: rgba(12,23,49,.78);
            border: 1px solid var(--bdr);
            border-radius: 14px;
            padding: 12px;
            margin-bottom: 14px
        }

            .datebar label {
                color: var(--mut);
                font-size: 12px
            }

            .datebar input {
                background: #071126;
                border: 1px solid var(--bdr2);
                color: var(--txt);
                border-radius: 9px;
                padding: 8px 10px
            }

        .hint {
            color: var(--dim);
            font-size: 12px
        }

        .tabs {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 14px
        }

        .tab {
            padding: 9px 13px;
            border: 1px solid var(--bdr);
            background: rgba(16,30,62,.72);
            border-radius: 999px;
            color: var(--mut);
            cursor: pointer;
            font-weight: 800;
            font-size: 12px
        }

            .tab.active {
                color: var(--cyan);
                border-color: rgba(34,211,238,.55);
                box-shadow: 0 0 0 1px rgba(34,211,238,.12) inset
            }

        .layout {
            display: grid;
            grid-template-columns: 360px 1fr;
            gap: 14px
        }

        .side, .main {
            background: rgba(12,23,49,.82);
            border: 1px solid var(--bdr);
            border-radius: 18px;
            padding: 14px;
            min-height: 570px
        }

        .side-title {
            font-weight: 900;
            color: var(--cyan);
            margin-bottom: 10px;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: .08em
        }

        .empty {
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--mut);
            height: 300px;
            text-align: center;
            border: 1px dashed var(--bdr2);
            border-radius: 16px
        }

        .loader {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--mut)
        }

        .spin {
            width: 18px;
            height: 18px;
            border: 3px solid rgba(34,211,238,.20);
            border-top-color: var(--cyan);
            border-radius: 50%;
            animation: s 1s linear infinite
        }

        @@keyframes s {
            to {
                transform: rotate(360deg)
            }
        }

        .card {
            border: 1px solid var(--bdr);
            background: rgba(16,30,62,.72);
            border-radius: 14px;
            padding: 12px;
            margin-bottom: 10px;
            cursor: pointer
        }

            .card:hover, .card.selected {
                border-color: rgba(34,211,238,.65);
                background: rgba(34,211,238,.08)
            }

        .card-top {
            display: flex;
            justify-content: space-between;
            gap: 8px
        }

        .name {
            font-weight: 900
        }

        .tags {
            display: flex;
            gap: 5px;
            flex-wrap: wrap
        }

        .tag {
            font-size: 10px;
            border-radius: 999px;
            padding: 4px 7px;
            border: 1px solid var(--bdr2);
            font-family: var(--mono)
        }

        .on {
            color: var(--green);
            border-color: rgba(52,211,153,.45);
            background: rgba(52,211,153,.08)
        }

        .off {
            color: var(--red);
            border-color: rgba(251,113,133,.45);
            background: rgba(251,113,133,.08)
        }

        .card-meta {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            color: var(--mut);
            font-size: 11px;
            margin-top: 8px
        }

        .chip {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            margin: 5px 5px 5px 0;
            padding: 8px 10px;
            border-radius: 999px;
            border: 1px solid var(--bdr);
            background: rgba(16,30,62,.78);
            cursor: pointer;
            font-size: 12px
        }

            .chip:hover, .chip.selected {
                border-color: rgba(34,211,238,.65);
                color: var(--cyan)
            }

        .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--red)
        }

            .dot.ok {
                background: var(--green)
            }

        .group {
            margin-bottom: 12px
        }

        .group-h {
            color: var(--mut);
            font-size: 12px;
            font-weight: 900;
            margin-bottom: 6px
        }

        .main-hint {
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: var(--mut);
            line-height: 1.7
        }

        .overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.62);
            backdrop-filter: blur(5px);
            display: none;
            z-index: 20
        }

            .overlay.open {
                display: block
            }

        .modal {
            position: fixed;
            left: 50%;
            top: 50%;
            transform: translate(-50%,-50%);
            width: min(1100px,96vw);
            max-height: 90vh;
            overflow: auto;
            background: #081226;
            border: 1px solid var(--bdr2);
            border-radius: 20px;
            display: none;
            z-index: 21;
            box-shadow: 0 24px 80px rgba(0,0,0,.45)
        }

            .modal.open {
                display: block
            }

        .mh {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 16px;
            border-bottom: 1px solid var(--bdr)
        }

            .mh h3 {
                margin: 0;
                font-size: 18px
            }

        .x {
            border: 1px solid var(--bdr2);
            background: #101e3e;
            color: var(--txt);
            border-radius: 10px;
            width: 34px;
            height: 34px;
            cursor: pointer
        }

        .mb {
            padding: 14px
        }

        .graph-box {
            border: 1px solid var(--bdr);
            border-radius: 16px;
            padding: 12px;
            background: rgba(16,30,62,.55)
        }

        .bar {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 10px
        }

        .bar-title {
            font-weight: 900;
            color: var(--cyan);
            margin-right: auto
        }

        .btn {
            border: 1px solid var(--bdr2);
            background: #10244d;
            color: var(--txt);
            border-radius: 9px;
            padding: 8px 12px;
            cursor: pointer;
            font-weight: 800
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(4,minmax(130px,1fr));
            gap: 8px;
            margin-bottom: 10px
        }

        .stat {
            border: 1px solid var(--bdr);
            border-radius: 12px;
            padding: 9px;
            background: rgba(7,17,38,.7)
        }

            .stat b {
                display: block;
                font-size: 18px
            }

            .stat span {
                font-size: 11px;
                color: var(--mut)
            }

        .chart {
            height: 380px
        }

        .list {
            margin-top: 12px;
            max-height: 180px;
            overflow: auto;
            border-top: 1px solid var(--bdr);
            padding-top: 8px
        }

        .row {
            display: grid;
            grid-template-columns: 160px 80px 1fr;
            gap: 8px;
            font-size: 12px;
            color: var(--mut);
            padding: 7px;
            border-bottom: 1px solid rgba(27,44,85,.55)
        }

        @@media(max-width:850px) {
            .layout {
                grid-template-columns: 1fr
            }

            .side, .main {
                min-height: auto
            }

            .stats {
                grid-template-columns: 1fr 1fr
            }

            .chart {
                height: 300px
            }
        }
        /* ===== device detail sidebar (N/W db parity) ===== */
        .dsb-ov {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.5);
            z-index: 90;
            opacity: 0;
            pointer-events: none;
            transition: opacity .2s
        }

            .dsb-ov.open {
                opacity: 1;
                pointer-events: auto
            }

        .dsb {
            position: fixed;
            top: 0;
            right: 0;
            width: 430px;
            max-width: 96vw;
            height: 100vh;
            background: linear-gradient(180deg,var(--panel),var(--panel2));
            border-left: 1px solid var(--bdr2);
            z-index: 91;
            transform: translateX(100%);
            transition: transform .25s;
            display: flex;
            flex-direction: column;
            box-shadow: -8px 0 40px rgba(0,0,0,.4)
        }

            .dsb.open {
                transform: translateX(0)
            }

        .dsb-hdr {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 13px 15px;
            border-bottom: 1px solid var(--bdr);
            flex-wrap: wrap
        }

            .dsb-hdr h3 {
                font-size: 14px;
                margin: 0;
                flex: 1;
                display: flex;
                align-items: center;
                gap: 7px;
                flex-wrap: wrap
            }

        .dsb-x {
            margin-left: auto;
            background: none;
            border: 1px solid var(--bdr2);
            color: var(--mut);
            border-radius: 8px;
            width: 26px;
            height: 26px;
            cursor: pointer;
            font-size: 14px
        }

            .dsb-x:hover {
                color: var(--txt);
                border-color: var(--cyan)
            }

        .dsb-tabs {
            display: flex;
            border-bottom: 1px solid var(--bdr)
        }

        .dsb-tab {
            flex: 1;
            text-align: center;
            padding: 9px 4px;
            font-size: 11px;
            font-weight: 700;
            color: var(--mut);
            cursor: pointer;
            border-bottom: 2px solid transparent
        }

            .dsb-tab.active {
                color: var(--cyan);
                border-bottom-color: var(--cyan)
            }

        .dsb-body {
            flex: 1;
            overflow-y: auto;
            padding: 13px
        }

        .dpane {
            display: none
        }

            .dpane.active {
                display: block
            }

        .sgrid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 7px;
            margin-bottom: 10px
        }

        .sstat {
            background: var(--panel2);
            border: 1px solid var(--bdr);
            border-radius: 9px;
            padding: 7px 9px
        }

            .sstat .l {
                font-size: 9px;
                font-weight: 700;
                letter-spacing: .06em;
                text-transform: uppercase;
                color: var(--dim);
                margin-bottom: 2px
            }

            .sstat .v {
                font-size: 12px;
                font-weight: 700
            }

        .ddot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 5px;
            vertical-align: middle
        }

            .ddot.on {
                background: var(--green);
                box-shadow: 0 0 6px var(--green)
            }

            .ddot.off {
                background: var(--red);
                box-shadow: 0 0 6px var(--red)
            }

        .dbadge {
            font-size: 9px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 99px;
            background: var(--panel2);
            border: 1px solid var(--bdr2);
            color: var(--mut)
        }

            .dbadge.v1 {
                color: #fb923c
            }

            .dbadge.v2 {
                color: #a78bfa
            }

            .dbadge.mq {
                color: var(--green)
            }

            .dbadge.a10 {
                color: var(--cyan)
            }

            .dbadge.no {
                color: var(--red)
            }

        .dsec {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--dim);
            margin: 12px 0 6px
        }

        .dkv {
            display: flex;
            justify-content: space-between;
            gap: 8px;
            font-size: 11px;
            padding: 4px 1px;
            border-bottom: 1px dashed var(--bdr);
            color: var(--dim)
        }

            .dkv b {
                color: var(--txt);
                font-size: 10px;
                word-break: break-all;
                text-align: right;
                font-family: var(--mono)
            }

        .dbtn {
            width: 100%;
            text-align: left;
            background: var(--panel2);
            border: 1px solid var(--bdr2);
            border-radius: 9px;
            padding: 7px 9px;
            color: var(--txt);
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            margin-bottom: 6px
        }

            .dbtn small {
                display: block;
                font-size: 8px;
                color: var(--dim);
                font-family: var(--mono);
                font-weight: 400
            }

            .dbtn:hover {
                border-color: var(--cyan)
            }

        .dgrid2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px
        }

        .dgrid3 {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 6px
        }

            .dgrid2 .dbtn, .dgrid3 .dbtn {
                margin-bottom: 0
            }

        .dcon {
            background: #050b18;
            border: 1px solid var(--bdr);
            border-radius: 10px;
            overflow: hidden;
            margin-top: 8px
        }

        .dcon-h {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 5px 9px;
            background: var(--panel2);
            border-bottom: 1px solid var(--bdr);
            font-size: 10px;
            font-weight: 700;
            color: var(--mut)
        }

        .dcon-b {
            max-height: 190px;
            overflow-y: auto;
            padding: 7px 9px;
            font-size: 10px
        }

        .dcl {
            display: flex;
            gap: 6px;
            padding: 2px 0
        }

            .dcl pre {
                margin: 0;
                white-space: pre-wrap;
                word-break: break-all;
                font-family: var(--mono);
                font-size: 10px;
                flex: 1
            }

            .dcl.cmd pre {
                color: var(--cyan)
            }

            .dcl.resp pre {
                color: var(--green)
            }

            .dcl.err pre {
                color: var(--red)
            }

            .dcl.info pre {
                color: var(--dim)
            }

        .dcl-ts {
            color: var(--dim);
            font-size: 9px;
            font-family: var(--mono);
            white-space: nowrap
        }

        .dcon-in {
            display: flex;
            align-items: center;
            gap: 6px;
            border-top: 1px solid var(--bdr);
            padding: 5px 8px
        }

            .dcon-in input {
                flex: 1;
                background: transparent;
                border: none;
                outline: none;
                color: var(--txt);
                font-size: 11px;
                font-family: var(--mono)
            }

        .dfrow {
            display: flex;
            gap: 7px;
            align-items: flex-end;
            flex-wrap: wrap;
            margin-bottom: 8px
        }

            .dfrow label {
                display: flex;
                flex-direction: column;
                gap: 3px;
                font-size: 9px;
                font-weight: 700;
                text-transform: uppercase;
                color: var(--dim)
            }

            .dfrow input[type=date], .dfrow select {
                background: var(--panel2);
                color: var(--txt);
                border: 1px solid var(--bdr2);
                border-radius: 7px;
                padding: 5px 7px;
                font-size: 11px;
                color-scheme: dark
            }

        .dhist {
            display: flex;
            flex-direction: column;
            gap: 5px;
            max-height: 46vh;
            overflow-y: auto
        }

        .dh-card {
            display: flex;
            align-items: center;
            gap: 7px;
            background: var(--panel2);
            border: 1px solid var(--bdr);
            border-radius: 8px;
            padding: 6px 9px;
            font-size: 11px
        }

            .dh-card.off {
                background: rgba(251,113,133,.07);
                border-color: rgba(251,113,133,.25)
            }

        .dh-time {
            margin-left: auto;
            font-size: 9px;
            color: var(--dim);
            font-family: var(--mono);
            white-space: nowrap
        }

        .dtag {
            font-size: 9px;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 5px
        }

            .dtag.tcp {
                background: rgba(96,165,250,.16);
                color: var(--blue)
            }

            .dtag.mqtt {
                background: rgba(52,211,153,.16);
                color: var(--green)
            }

        .dmq {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 7px
        }

        .dmq-c {
            background: var(--panel2);
            border: 1px solid var(--bdr2);
            border-radius: 9px;
            padding: 7px 9px;
            cursor: pointer
        }

            .dmq-c:hover, .dmq-c.live {
                border-color: var(--green)
            }

            .dmq-c .l {
                font-size: 9px;
                font-weight: 700;
                color: var(--dim)
            }

            .dmq-c .t {
                font-size: 9px;
                color: var(--green);
                font-family: var(--mono);
                word-break: break-all
            }

        .dim-box {
            background: var(--panel2);
            border: 1px solid var(--bdr2);
            border-radius: 10px;
            padding: 10px 12px;
            margin-top: 9px
        }

            .dim-box label {
                display: flex;
                flex-direction: column;
                gap: 3px;
                font-size: 9px;
                font-weight: 700;
                text-transform: uppercase;
                color: var(--dim);
                margin-bottom: 6px
            }

            .dim-box input, .dim-box select {
                background: var(--panel);
                color: var(--txt);
                border: 1px solid var(--bdr2);
                border-radius: 7px;
                padding: 5px 8px;
                font-size: 11px;
                color-scheme: dark
            }

        .dempty {
            text-align: center;
            color: var(--dim);
            font-size: 12px;
            padding: 14px
        }

        .vtoggle {
            display: inline-flex;
            border: 1px solid var(--bdr2);
            border-radius: 8px;
            overflow: hidden;
            margin-left: auto
        }

            .vtoggle button {
                background: var(--panel2);
                border: none;
                color: var(--dim);
                font-size: 10px;
                font-weight: 700;
                padding: 4px 11px;
                cursor: pointer
            }

                .vtoggle button.active {
                    background: rgba(34,211,238,.16);
                    color: var(--cyan)
                }

        .side-title-row {
            display: flex;
            align-items: center;
            gap: 8px
        }

        .ag {
            border: 1px solid var(--bdr);
            border-radius: 9px;
            margin-bottom: 6px;
            overflow: hidden
        }

        .ag-h {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 8px 10px;
            background: var(--panel2);
            cursor: pointer;
            font-size: 12px
        }

        .at-h {
            display: flex;
            align-items: center;
            gap: 7px;
            padding: 6px 10px 6px 20px;
            cursor: pointer;
            font-size: 11px;
            color: var(--mut);
            border-top: 1px solid var(--bdr)
        }

        .chev {
            font-size: 8px;
            color: var(--dim);
            transition: transform .15s
        }

        .adc-i {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 10px;
            padding: 5px 8px 5px 32px;
            cursor: pointer;
            color: var(--mut)
        }

            .adc-i:hover {
                background: var(--panel2);
                color: var(--txt)
            }

            .adc-i b {
                color: var(--amber)
            }

        .gbtn {
            border: 1px solid var(--bdr2);
            background: linear-gradient(135deg,#10244d,#0b1733);
            color: var(--txt);
            border-radius: 9px;
            padding: 6px 11px;
            cursor: pointer;
            font-weight: 700;
            font-size: 11px
        }

            .gbtn:hover {
                border-color: var(--cyan)
            }
    </style>
</head>
<body>
    <div class="top">
        <div class="title"><h1>&#128338; Health History - <span id="siteName"></span></h1><div class="meta">Site ID: <b id="siteId"></b> &#183; Select any modem or A10 from the left sidebar to open graph popup.</div></div>
        <button class="back" onclick="goBack()">&#8592; Back to Health DB</button>
    </div>
    <div class="datebar"><label>From</label><input type="date" id="fromDate" /><label>To</label><input type="date" id="toDate" /><span class="hint">Graph popup uses this date range.</span></div>
    <div class="tabs"><button class="tab active" data-tab="network">Network / Modem</button><button class="tab" data-tab="iot">IoT / A10</button><button class="tab" data-tab="services">Services</button></div>
    <div class="layout"><aside class="side" id="side"></aside><section class="main" id="main"><div class="main-hint">Select Network / Modem or IoT / A10 from the sidebar.<br />Graph opens in popup, not below the page.</div></section></div>

    <div class="overlay" id="ov" onclick="closeGraph()"></div>
    <div class="modal" id="graphModal" onclick="event.stopPropagation()"><div class="mh"><h3 id="graphTitle">Device History Graph</h3><button class="x" onclick="closeGraph()">&#215;</button></div><div class="mb" id="graphBody"></div></div>
    <!-- device detail sidebar (modem / A10) -->
    <div class="dsb-ov" id="dsbov" onclick="DSB.close()"></div>
    <div class="dsb" id="dsb" onclick="event.stopPropagation()"><div class="dsb-hdr" id="dsbHdr"></div><div class="dsb-tabs" id="dsbTabs"></div><div class="dsb-body" id="dsbBody"></div></div>
    <script>
(function(){
var SITE_ID=@siteId, SITE_NAME=@Html.Raw(Json.Encode(siteName));
var DEVICE_STATUS_URL='@Url.Action("GetSiteDeviceStatus", "Health", new { area = "FRS25" })';
var MODEM_GRAPH_URL='@Url.Action("GetModemHistoryForGraph", "Health", new { area = "FRS25" })';
var A10_GRAPH_URL='@Url.Action("GetA10HistoryForGraph", "Health", new { area = "FRS25" })';
var A10_RECORDS_URL='@Url.Action("GetA10HistoryRecords", "Health", new { area = "FRS25" })';
var INDEX_URL='@Url.Action("Index", "Health", new { area = "FRS25" })';
var NW_ASSET_TYPES_URL='@Url.Action("GetAssetTypeBySiteId", "Health", new { area = "" })';
var NW_YARD_CONFIG_URL='@Url.Action("GetYardConfigByAssetTypeJson", "Health", new { area = "" })';
var MODEM_TCP_CMD_URL ='/Health/SendTcpCommand';
var IS_ADMIN=@((E7FRSAdvance.Utility.ClsHttpContent.LoginUser != null && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode()) ? "true" : "false");
var MQTT_CFG=@Html.Raw(Json.Encode(ViewBag.MQTTDetail))||{};
var modems=[], active='network', sel=null, selType=null, chart=null, lastData=null;
function el(id){return document.getElementById(id)}
function esc(v){return String(v==null?'':v).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;')}
function fd(){for(var i=0;i<arguments.length;i++){if(arguments[i]!==undefined&&arguments[i]!==null&&arguments[i]!== '')return arguments[i]}return null}
function num(v,d){var n=Number(v);return isFinite(n)?n:(d||0)}
function iso(d){return d.toISOString().slice(0,10)}
function apiDate(s){var p=String(s).split('-');if(p.length===3)return p[2]+'-'+p[1]+'-'+p[0];var d=new Date(s);return String(d.getDate()).padStart(2,'0')+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+d.getFullYear()}
function parseTs(v){if(v===null||v===undefined||v==='')return null;if(v instanceof Date)return isNaN(v.getTime())?null:v.getTime();if(typeof v==='number')return v>1e12?v:(v>1e9?v*1000:null);var s=String(v).trim();var m=s.match(/\/Date\((-?\d+)/);if(m)return Number(m[1]);var t=Date.parse(s);if(!isNaN(t))return t;m=s.match(/^(\d{1,2})-(\d{1,2})-(\d{4})(?:[ T](\d{1,2}):(\d{1,2})(?::(\d{1,2}))?)?/);if(m)return new Date(+m[3],+m[2]-1,+m[1],+(m[4]||0),+(m[5]||0),+(m[6]||0)).getTime();return null}
window.goBack=function(){ if(history.length>1) history.back(); else window.location.href=INDEX_URL; };
el('siteId').textContent=SITE_ID; el('siteName').textContent=SITE_NAME; el('fromDate').value=iso(new Date()); el('toDate').value=iso(new Date());
document.querySelectorAll('.tab').forEach(function(t){t.onclick=function(){document.querySelectorAll('.tab').forEach(function(x){x.classList.remove('active')});t.classList.add('active');active=t.dataset.tab;render()}});
function normalize(resp){var ms=(resp&&resp.Modems)||[];return ms.filter(function(m){return m}).map(function(m){var tcp=!!fd(m.TcpStatus,m.tcpStatus,false),mqtt=!!fd(m.MqttStatus,m.mqttStatus,false);var on=fd(m.IsOnline,m.isOnline);on=(on===null)?(tcp||mqtt):!!on;var clusterId=num(fd(m.ClusterId,m.clusterId),0);var modemId=String(fd(m.ModemId,m.modemId,''));return{clusterId:clusterId,clusterName:String(fd(m.ClusterName,m.clusterName,m.ModemName,m.modemName,'Modem')),modemId:modemId,modemName:String(fd(m.ModemName,m.modemName,'')),version:String(fd(m.Version,m.version,'')),signal:fd(m.SignalStrength,m.signalStrength),sim:String(fd(m.SimNumber,m.simNumber,'')),mqttBase:String(fd(m.MqttBasePath,m.mqttBasePath,m.MQTTBasePath,'rdpms')),tcp:tcp,mqtt:mqtt,online:on,a10s:(fd(m.A10List,m.a10List)||[]).map(function(a){var at=!!fd(a.TcpStatus,a.tcpStatus,false),am=!!fd(a.MqttStatus,a.mqttStatus,a.MQTTStatus,false);return{a10Id:fd(a.A10Id,a.a10Id,a.Id,a.id,'?'),clusterId:clusterId,modemId:modemId,tcp:at,mqtt:am,online:at||am,type:String(fd(a.ADCTypeName,a.adcTypeName,'')),fw:String(fd(a.FirmwareVersion,a.firmwareVersion,'')),lastData:String(fd(a.LastDataTime,a.lastDataTime,'')),uptime:String(fd(a.Uptime,a.uptime,'')),slave:fd(a.SlaveAddress,a.slaveAddress,fd(a.A10Id,a.a10Id,a.Id,a.id,'?')),adcNumber:fd(a.ADCNumber,a.adcNumber,fd(a.A10Id,a.a10Id,a.Id,a.id,'?'))}})}})}
function load(){el('side').innerHTML='<div class="loader"><span class="spin"></span>Loading device status...</div>';fetch(DEVICE_STATUS_URL+'?siteId='+encodeURIComponent(SITE_ID),{credentials:'include'}).then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json()}).then(function(j){if(j&&j.Success===false)throw new Error(j.Message||'API error');modems=normalize(j);render()}).catch(function(e){el('side').innerHTML='<div class="empty">Failed to load devices<br/>'+esc(e.message)+'</div>'})}
function render(){destroyChart();if(active==='services'){el('side').innerHTML='<div class="side-title">Services</div><div class="empty">Service history APIs are not available yet.</div>';return}if(!modems.length){el('side').innerHTML='<div class="empty">No modem / A10 device found for this station.</div>';return}var vm=devView[active]||'cluster';var h='<div class="side-title side-title-row">'+(active==='network'?'Network / Modem':'IoT / A10')+'<span class="vtoggle"><button class="'+(vm==='cluster'?'active':'')+'" onclick="DSB.view(\'cluster\')">Cluster</button><button class="'+(vm==='asset'?'active':'')+'" onclick="DSB.view(\'asset\')">Asset</button></span></div>';if(vm==='asset'){h+=assetSectionHtml();el('side').innerHTML=h;ensureAssetTypes();return}if(active==='network'){modems.forEach(function(m,i){h+='<div class="card" data-i="'+i+'"><div class="card-top"><div class="name"><span class="ddot '+(m.online?'on':'off')+'"></span>\uD83D\uDCE1 '+esc(m.clusterName)+'</div><div class="tags"><span class="tag '+(m.tcp?'on':'off')+'">TCP</span><span class="tag '+(m.mqtt?'on':'off')+'">MQTT</span></div></div><div class="card-meta"><span>'+esc(m.modemName||m.modemId)+'</span><span>V '+esc(m.version||'?')+'</span>'+(m.signal!==null&&m.signal!==undefined?'<span>'+esc(m.signal)+' dBm</span>':'')+'<span>'+m.a10s.length+' A10</span></div></div>'})}else{modems.forEach(function(m,mi){if(!m.a10s.length)return;h+='<div class="group"><div class="group-h">\uD83D\uDCE1 '+esc(m.clusterName)+' <span style="font-weight:400;color:var(--dim)">'+esc(m.modemName)+'</span></div>';m.a10s.forEach(function(a,ai){h+='<span class="chip" data-mi="'+mi+'" data-ai="'+ai+'"><span class="dot '+(a.online?'ok':'')+'"></span>A10-'+esc(a.a10Id)+(a.type?' \u00B7 '+esc(a.type):'')+'</span>'});h+='</div>'})}el('side').innerHTML=h;if(active==='network'){document.querySelectorAll('.card').forEach(function(c){c.onclick=function(){document.querySelectorAll('.card').forEach(function(x){x.classList.remove('selected')});c.classList.add('selected');openModemSb(modems[parseInt(c.dataset.i,10)])}})}else{document.querySelectorAll('.chip').forEach(function(c){c.onclick=function(){document.querySelectorAll('.chip').forEach(function(x){x.classList.remove('selected')});c.classList.add('selected');var m=modems[parseInt(c.dataset.mi,10)];openA10Sb(m,m.a10s[parseInt(c.dataset.ai,10)])}})}}
function openGraph(title){el('graphTitle').textContent=title;el('ov').classList.add('open');el('graphModal').classList.add('open');el('graphBody').innerHTML='<div class="graph-box"><div class="bar"><div class="bar-title">'+esc(title)+'</div><label><input type="checkbox" id="tcp" checked> TCP</label><label><input type="checkbox" id="mqtt" checked> MQTT</label><button class="btn" id="reload">Load Graph</button></div><div class="stats" id="stats"></div><div class="loader" id="loader"><span class="spin"></span>Loading history...</div><div class="empty" id="empty" style="display:none;height:120px">No history found for selected date range.</div><div class="chart"><canvas id="chart" style="display:none"></canvas></div><div class="list" id="records"></div></div>';el('reload').onclick=function(){loadGraph();if(selType==='a10')loadA10Records()};el('tcp').onchange=function(){if(lastData)draw(lastData)};el('mqtt').onchange=function(){if(lastData)draw(lastData)}}
window.closeGraph=function(){destroyChart();el('ov').classList.remove('open');el('graphModal').classList.remove('open');el('graphBody').innerHTML=''};
function destroyChart(){if(chart){try{chart.destroy()}catch(e){}chart=null}}
function loadGraph(){if(!sel)return;destroyChart();lastData=null;el('loader').style.display='flex';el('empty').style.display='none';var f=apiDate(el('fromDate').value),t=apiDate(el('toDate').value);var u=selType==='modem'?MODEM_GRAPH_URL+'?clusterId='+encodeURIComponent(sel.clusterId)+'&fromDate='+encodeURIComponent(f)+'&toDate='+encodeURIComponent(t):A10_GRAPH_URL+'?clusterId='+encodeURIComponent(sel.clusterId)+'&a10Id='+encodeURIComponent(sel.a10Id)+'&fromDate='+encodeURIComponent(f)+'&toDate='+encodeURIComponent(t);fetch(u,{credentials:'include'}).then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json()}).then(function(j){var data=Array.isArray(j)?j:(j.Data||j.data||[]);lastData=data;draw(data)}).catch(function(e){el('loader').style.display='none';el('empty').style.display='flex';el('empty').innerHTML='Graph load failed<br/>'+esc(e.message)})}
function draw(data){el('loader').style.display='none';var rows=(data||[]).map(function(x){return{time:parseTs(fd(x.TimeStamp,x.timestamp,x.Timestamp,x.timeStamp,x.CreatedOn,x.time)),type:num(fd(x.TypeId,x.typeId),0),signal:fd(x.SignalStrength,x.signalStrength),uptime:fd(x.Uptime,x.uptime),response:fd(x.ResponseTime,x.responseTime)}}).filter(function(x){return x.time!==null});rows.sort(function(a,b){return a.time-b.time});var showTcp=el('tcp').checked,showMqtt=el('mqtt').checked;rows=rows.filter(function(x){return (x.type===1&&showTcp)||(x.type===2&&showMqtt)||(!x.type)});if(!rows.length){el('empty').style.display='flex';el('chart').style.display='none';el('stats').innerHTML='';return}el('empty').style.display='none';el('chart').style.display='block';var tcp=rows.filter(function(x){return x.type===1}).length,mqtt=rows.filter(function(x){return x.type===2}).length;el('stats').innerHTML='<div class="stat"><b>'+rows.length+'</b><span>Total samples</span></div><div class="stat"><b>'+tcp+'</b><span>TCP samples</span></div><div class="stat"><b>'+mqtt+'</b><span>MQTT samples</span></div><div class="stat"><b>'+esc(new Date(rows[rows.length-1].time).toLocaleString())+'</b><span>Last point</span></div>';var ctx=el('chart');chart=new Chart(ctx,{type:'line',data:{datasets:[{label:'TCP',data:rows.filter(function(x){return x.type===1}).map(function(x){return{x:x.time,y:num(fd(x.signal,x.response,x.uptime),0)}}),borderColor:'#60a5fa',backgroundColor:'rgba(96,165,250,.1)',borderWidth:2,fill:true,pointRadius:1,pointHoverRadius:5,tension:.25},{label:'MQTT',data:rows.filter(function(x){return x.type===2}).map(function(x){return{x:x.time,y:num(fd(x.signal,x.response,x.uptime),0)}}),borderColor:'#34d399',backgroundColor:'rgba(52,211,153,.1)',borderWidth:2,fill:true,pointRadius:1,pointHoverRadius:5,tension:.25}]},options:{responsive:true,maintainAspectRatio:false,parsing:false,normalized:true,interaction:{mode:'index',intersect:false},plugins:{legend:{labels:{color:'#e7edf7'}},tooltip:{callbacks:{title:function(c){return new Date(c[0].parsed.x).toLocaleString()}}}},scales:{x:{type:'time',time:{displayFormats:{minute:'HH:mm',hour:'HH:mm',day:'dd MMM'}},ticks:{color:'#9fb1d1',maxRotation:45},grid:{color:'rgba(96,116,154,.18)'}},y:{ticks:{color:'#9fb1d1'},grid:{color:'rgba(96,116,154,.18)'}}}}})}
function loadA10Records(){if(selType!=='a10')return;var f=apiDate(el('fromDate').value),t=apiDate(el('toDate').value);var u=A10_RECORDS_URL+'?clusterId='+encodeURIComponent(sel.clusterId)+'&a10Id='+encodeURIComponent(sel.a10Id)+'&ModemId='+encodeURIComponent(sel.modemId||'')+'&fromDate='+encodeURIComponent(f)+'&toDate='+encodeURIComponent(t);fetch(u,{credentials:'include'}).then(function(r){return r.json()}).then(function(j){var arr=Array.isArray(j)?j:(j.Data||j.data||[]);el('records').innerHTML=arr.slice(0,80).map(function(r){return'<div class="row"><span>'+esc(fd(r.TimeStamp,r.timestamp,''))+'</span><span>'+esc(fd(r.TypeId,r.typeId,''))+'</span><span>'+esc(fd(r.Message,r.message,r.Status,r.status,''))+'</span></div>'}).join('')}).catch(function(){})}
// =====================================================================
// DEVICE DETAIL SIDEBAR (N/W db parity) + cluster/asset grouping
// =====================================================================
var devView={network:'cluster',iot:'cluster'};
var cur=null,pendingPin=null,cmdPending=false;
var dMq=null,dMqOn=false,dMqPend={},dLiveSub=null;
var assetCache={loading:false,types:null,selType:'',trees:{}};
var GAP_MIN=5,MQ_TIMEOUT=10000;
function verNum(v){var n=parseInt(String(v==null?'':v).replace(/\D/g,''),10);return isNaN(n)||n===0?2:n}
function topics(base,cluster){var b=String(base||'rdpms').replace(/\/+$/,'');var c=String(cluster||'').replace(/\s+/g,'');return{pub:b+'/'+c+'/S',sub:b+'/'+c+'/P'}}
function fmtTs(v){var ms=parseTs(v);if(ms===null)return String(v||'-');var d=new Date(ms);return d.toLocaleDateString('en-GB')+' '+d.toLocaleTimeString('en-GB')}
function pretty(d){try{return JSON.stringify(JSON.parse(d),null,2)}catch(e){return d}}
function dsbOpen(hdr,tabs,body){el('dsbHdr').innerHTML=hdr+'<button class="dsb-x" onclick="DSB.close()">&#215;</button>';el('dsbTabs').innerHTML=tabs;el('dsbBody').innerHTML=body;el('dsbov').classList.add('open');el('dsb').classList.add('open');var f=el('dHistFrom'),t=el('dHistTo');if(f)f.value=el('fromDate').value;if(t)t.value=el('toDate').value}
function dsbClose(){el('dsb').classList.remove('open');el('dsbov').classList.remove('open');if(dLiveSub&&dMq){try{dMq.unsubscribe(dLiveSub)}catch(e){}dLiveSub=null}cur=null}
function tabBtn(k,l,a){return '<div class="dsb-tab'+(a?' active':'')+'" data-t="'+k+'" onclick="DSB.tab(this,\''+k+'\')">'+l+'</div>'}
function dsbTab(elx,t){document.querySelectorAll('#dsbTabs .dsb-tab').forEach(function(x){x.classList.remove('active')});elx.classList.add('active');document.querySelectorAll('#dsbBody .dpane').forEach(function(p){p.classList.toggle('active',p.dataset.p===t)});if(t==='history'&&cur&&!cur.histLoaded){cur.histLoaded=true;loadHist()}}
function pane(k,a,inner){return '<div class="dpane'+(a?' active':'')+'" data-p="'+k+'">'+inner+'</div>'}
// ---------- MODEM SIDEBAR ----------
function openModemSb(m){var ver=verNum(m.version);cur={kind:'modem',modem:m,a10:null,ver:ver,histLoaded:false};
var t=topics(m.mqttBase,m.clusterName||m.modemName);
var hdr='<h3><span class="ddot '+(m.online?'on':'off')+'"></span>\uD83D\uDCE1 '+esc(m.clusterName||m.modemName)+' <span class="dbadge v'+ver+'">MODEM V'+ver+'</span></h3>';
var tabs=tabBtn('status','Status',1)+tabBtn('a10s','A10 List',0)+tabBtn('history','History',0)+tabBtn('command','Command',0);
var st='<div class="sgrid">'
+'<div class="sstat"><div class="l">Status</div><div class="v" style="color:'+(m.online?'var(--green)':'var(--red)')+'">'+(m.online?'Online':'Offline')+'</div></div>'
+'<div class="sstat"><div class="l">Signal</div><div class="v">'+(m.signal!=null&&m.signal!==''?esc(m.signal)+' dBm':'\u2014')+'</div></div>'
+'<div class="sstat"><div class="l">TCP</div><div class="v" style="color:'+(m.tcp?'var(--green)':'var(--red)')+'">'+(m.tcp?'Connected':'Offline')+'</div></div>'
+'<div class="sstat"><div class="l">MQTT</div><div class="v" style="color:'+(m.mqtt?'var(--green)':'var(--red)')+'">'+(m.mqtt?'Connected':'Offline')+'</div></div>'
+'<div class="sstat"><div class="l">Modem ID</div><div class="v" style="font-size:10px">'+esc(m.modemId||'\u2014')+'</div></div>'
+'<div class="sstat"><div class="l">SIM</div><div class="v" style="font-size:10px">'+esc(m.sim||'\u2014')+'</div></div>'
+'</div><div class="dsec">MQTT</div>'
+'<div class="dkv"><span>Base</span><b>'+esc(m.mqttBase||'rdpms')+'</b></div>'
+'<div class="dkv"><span>Cmd Topic</span><b>'+esc(t.pub)+'</b></div>'
+'<div class="dkv"><span>Resp Topic</span><b>'+esc(t.sub)+'</b></div>'
+'<button class="gbtn" style="width:100%;margin-top:10px" onclick="DSB.graph()">\uD83D\uDCC8 View Signal Graph</button>';
var a10s='<div class="dsec">Connected A10 Devices ('+m.a10s.length+')</div>';
if(m.a10s.length){m.a10s.forEach(function(a,ai){a10s+='<div class="dh-card" style="cursor:pointer" onclick="DSB.a10('+modems.indexOf(m)+','+ai+')"><span class="ddot '+(a.online?'on':'off')+'"></span><b style="color:var(--cyan)">A10-'+esc(a.a10Id)+'</b><span class="dtag '+(a.tcp?'tcp':'')+'">TCP</span><span class="dtag '+(a.mqtt?'mqtt':'')+'">MQTT</span>'+(a.type?'<span style="font-size:9px;color:var(--dim)">'+esc(a.type)+'</span>':'')+'</div>'})}else a10s+='<div class="dempty">No A10 devices</div>';
dsbOpen(hdr,tabs,pane('status',1,st)+pane('a10s',0,a10s)+pane('history',0,histPaneHtml())+pane('command',0,modemCmdHtml(m,ver)))}
// ---------- A10 SIDEBAR ----------
function openA10Sb(m,a){var ver=verNum(m.version);cur={kind:'a10',modem:m,a10:a,ver:ver,histLoaded:false};
var t=topics(m.mqttBase,m.clusterName||m.modemName);a._sub=t.sub;a._pub=t.pub;
var hdr='<h3><span class="ddot '+(a.online?'on':'off')+'"></span>A10-'+esc(a.a10Id)+' <span class="dbadge a10">A10 DEVICE</span> <span class="dbadge v'+ver+'">Parent: V'+ver+'</span> '+(ver===1?'<span class="dbadge no">No Commands</span>':'<span class="dbadge mq">MQTT</span>')+'</h3>';
var tabs=tabBtn('status','Status',1)+tabBtn('history','History',0)+(ver===1?'':tabBtn('command','Command',0));
var st='<div class="sgrid">'
+'<div class="sstat"><div class="l">Modbus TCP</div><div class="v" style="color:'+(a.tcp?'var(--green)':'var(--red)')+'"><span class="ddot '+(a.tcp?'on':'off')+'"></span>'+(a.tcp?'Online':'Offline')+'</div></div>'
+'<div class="sstat"><div class="l">MQTT Periodic</div><div class="v" style="color:'+(a.mqtt?'var(--green)':'var(--red)')+'"><span class="ddot '+(a.mqtt?'on':'off')+'"></span>'+(a.mqtt?'Connected':'Disconnected')+'</div></div>'
+'<div class="sstat"><div class="l">Type</div><div class="v" style="font-size:10px">'+esc(a.type||'Data Logger')+'</div></div>'
+'<div class="sstat"><div class="l">Firmware</div><div class="v" style="font-size:10px">'+esc(a.fw||'\u2014')+'</div></div>'
+'<div class="sstat"><div class="l">Slave Address</div><div class="v">'+esc(a.slave||a.a10Id)+'</div></div>'
+'<div class="sstat"><div class="l">Parent Modem</div><div class="v" style="font-size:10px;color:var(--blue)">'+esc(m.clusterName||m.modemName)+'</div></div>'
+'<div class="sstat"><div class="l">Last Data</div><div class="v" style="font-size:9px">'+esc(a.lastData?fmtTs(a.lastData):'\u2014')+'</div></div>'
+'<div class="sstat"><div class="l">Uptime</div><div class="v" style="font-size:9px">'+esc(a.uptime||'\u2014')+'</div></div>'
+'</div><div class="dsec">MQTT Paths</div><div class="dmq">'
+'<div class="dmq-c" id="dSubCard" onclick="DSB.sub()"><div class="l">Subscribe (Response) <span id="dSubState"></span></div><div class="t">'+esc(t.sub)+'</div></div>'
+'<div class="dmq-c" onclick="DSB.pub()"><div class="l">Publish (Command) &#10148;</div><div class="t">'+esc(t.pub)+'</div></div></div>'
+'<div class="dcon" id="dStCon" style="display:none"><div class="dcon-h"><span>&#9679; Console</span><button class="dsb-x" style="width:auto;height:auto;padding:1px 8px;font-size:9px" onclick="DSB.clear(\'dStConB\')">Clear</button></div><div class="dcon-b" id="dStConB"></div></div>';
dsbOpen(hdr,tabs,pane('status',1,st)+pane('history',0,histPaneHtml())+(ver===1?'':pane('command',0,a10CmdHtml(a))))}
// ---------- HISTORY (gap detection + protocol filter) ----------
function histPaneHtml(){return '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px"><span class="dsec" style="margin:0">Status History</span><button class="gbtn" onclick="DSB.graph()">\uD83D\uDCC8 View Graph</button></div>'
+'<div class="dfrow"><label>From<input type="date" id="dHistFrom"></label><label>To<input type="date" id="dHistTo"></label><label>Protocol<select id="dHistProto" onchange="DSB.filt()"><option value="all">All</option><option value="tcp">TCP</option><option value="mqtt">MQTT</option></select></label><button class="gbtn" onclick="DSB.hist()">&#8635;</button></div>'
+'<div style="font-size:10px;color:var(--dim);margin-bottom:6px">Showing <b id="dHVis" style="color:var(--txt)">0</b> of <b id="dHTot" style="color:var(--txt)">0</b> records</div>'
+'<div class="dhist" id="dHistList"><div class="dempty">Click &#8635; to load history</div></div>'}
function loadHist(){if(!cur)return;var L=el('dHistList');var f=el('dHistFrom').value||iso(new Date()),t=el('dHistTo').value||iso(new Date());el('dHistProto').value='all';
L.innerHTML='<div class="dempty">Loading...</div>';
var u=cur.kind==='modem'?MODEM_GRAPH_URL+'?clusterId='+encodeURIComponent(cur.modem.clusterId)+'&fromDate='+encodeURIComponent(apiDate(f))+'&toDate='+encodeURIComponent(apiDate(t))
:A10_RECORDS_URL+'?clusterId='+encodeURIComponent(cur.a10.clusterId)+'&a10Id='+encodeURIComponent(cur.a10.a10Id)+'&ModemId='+encodeURIComponent(cur.a10.modemId||'')+'&fromDate='+encodeURIComponent(apiDate(f))+'&toDate='+encodeURIComponent(apiDate(t));
fetch(u,{credentials:'include'}).then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json()}).then(function(j){if(j&&j.Success===false){L.innerHTML='<div class="dempty" style="color:var(--red)">'+esc(j.Message||'No records')+'</div>';cnt(0,0);return}
var raw=Array.isArray(j)?j:(j.Data||j.data||[]);renderHist(gaps(raw,f,t))}).catch(function(){L.innerHTML='<div class="dempty" style="color:var(--red)">Failed to load history</div>';cnt(0,0)})}
function gaps(raw,f,t){if(!raw||!raw.length)return[];var rows=raw.map(function(r){return{ts:parseTs(fd(r.TimeStamp,r.timeStamp)),ty:num(fd(r.TypeId,r.typeId),0),src:r}}).filter(function(r){return r.ts!==null});if(!rows.length)return[];
rows.sort(function(a,b){return a.ts-b.ts});var g=GAP_MIN*60000,out=[],s=new Date(f+'T00:00:00').getTime(),e=Math.min(new Date(t+'T23:59:59').getTime(),Date.now());
if(rows[0].ts-s>g)out.push({ts:s,ty:rows[0].ty,on:false});
for(var i=0;i<rows.length;i++){if(i>0&&rows[i].ts-rows[i-1].ts>g)out.push({ts:rows[i-1].ts+60000,ty:rows[i-1].ty||rows[i].ty,on:false});out.push({ts:rows[i].ts,ty:rows[i].ty,on:true,src:rows[i].src})}
if(e-rows[rows.length-1].ts>g)out.push({ts:rows[rows.length-1].ts+60000,ty:rows[rows.length-1].ty,on:false});return out}
function renderHist(d){var L=el('dHistList');if(!d.length){L.innerHTML='<div class="dempty">No history for selected range</div>';cnt(0,0);return}
d.sort(function(a,b){return b.ts-a.ts});
L.innerHTML=d.map(function(it){var tcp=it.ty===1,mq=it.ty===2;var ex='';if(it.on&&it.src){var v=tcp?fd(it.src.ResponseTime,it.src.responseTime,it.src.SignalStrength,it.src.signalStrength):fd(it.src.Uptime,it.src.uptime,it.src.SignalStrength,it.src.signalStrength);if(v!=null&&v!=='')ex='<span style="font-size:9px;color:var(--dim)">'+esc(v)+'</span>'}
return '<div class="dh-card'+(it.on?'':' off')+'" data-p="'+(tcp?'tcp':mq?'mqtt':'offline')+'"><span class="ddot '+(it.on?'on':'off')+'"></span><span class="dtag '+(tcp?'tcp':mq?'mqtt':'')+'">'+(tcp?'TCP':mq?'MQTT':'\u2014')+'</span><span style="color:'+(it.on?'var(--green)':'var(--red)')+';font-weight:600">'+(it.on?'Online':'Offline')+'</span>'+ex+'<span class="dh-time">'+fmtTs(it.ts)+'</span></div>'}).join('');
cnt(d.length,d.length)}
function cnt(v,t){el('dHVis').textContent=v;el('dHTot').textContent=t}
function filtHist(){var f=el('dHistProto').value;var cs=document.querySelectorAll('#dHistList .dh-card'),vis=0;cs.forEach(function(c){var ok=f==='all'||c.dataset.p===f;c.style.display=ok?'':'none';if(ok)vis++});cnt(vis,cs.length)}
function openSelGraph(){if(!cur)return;sel=cur.kind==='modem'?cur.modem:cur.a10;selType=cur.kind;el('fromDate').value=el('dHistFrom')?el('dHistFrom').value:el('fromDate').value;el('toDate').value=el('dHistTo')?el('dHistTo').value:el('toDate').value;
openGraph(cur.kind==='modem'?('Modem \u2014 '+cur.modem.clusterName):('A10-'+cur.a10.a10Id+' \u2014 '+cur.modem.clusterName));loadGraph();if(cur.kind==='a10')loadA10Records()}
// ---------- MQTT TRANSPORT ----------
function mqHost(){return fd(MQTT_CFG&&MQTT_CFG.MQTTUri,MQTT_CFG&&MQTT_CFG.Uri,MQTT_CFG&&MQTT_CFG.Host,null)}
function mqPort(){return num(fd(MQTT_CFG&&MQTT_CFG.MQTTPort,MQTT_CFG&&MQTT_CFG.Port,null),0)}
function mqInit(cb){if(dMqOn&&dMq){cb(true);return}
var C=(typeof Paho!=='undefined')?((Paho.MQTT&&Paho.MQTT.Client)||Paho.Client):null;
if(!C){cb(false,'Paho MQTT not loaded');return}
var h=mqHost(),p=mqPort();if(!h||!p){cb(false,'MQTT detail missing (ViewBag.MQTTDetail)');return}
try{dMq=new C(h,p,'web_cmd_'+Math.ceil(Math.random()*100000));
dMq.onConnectionLost=function(){dMqOn=false;for(var k in dMqPend){var x=dMqPend[k];if(x.tid)clearTimeout(x.tid);if(x.cb)x.cb(false,'Connection lost',0)}dMqPend={}};
dMq.onMessageArrived=function(msg){var tp=msg.destinationName,pl=msg.payloadString;
if(dLiveSub&&tp===dLiveSub)dlog('dStConB','resp',pl);
var x=dMqPend[tp];if(x){if(x.tid)clearTimeout(x.tid);delete dMqPend[tp];if(tp!==dLiveSub){try{dMq.unsubscribe(tp)}catch(e){}}if(x.cb)x.cb(true,pl,Date.now()-x.at)}};
var o={timeout:10,useSSL:location.protocol==='https:',cleanSession:true,onSuccess:function(){dMqOn=true;cb(true)},onFailure:function(e){cb(false,e&&e.errorMessage)}};
var u=fd(MQTT_CFG&&MQTT_CFG.MQTTUsername,MQTT_CFG&&MQTT_CFG.Username,null),pw=fd(MQTT_CFG&&MQTT_CFG.MQTTPassword,MQTT_CFG&&MQTT_CFG.Password,null);
if(u)o.userName=u;if(pw)o.password=pw;dMq.connect(o)}catch(e){cb(false,e.message)}}
function mqCmd(base,cluster,json,cb){var t=topics(base,cluster);var pend={at:Date.now(),cb:cb,tid:null};
function go(){dMqPend[t.sub]=pend;dMq.subscribe(t.sub,{qos:0,onSuccess:function(){try{dMq.send(t.pub,json,0,false);pend.tid=setTimeout(function(){if(t.sub!==dLiveSub){try{dMq.unsubscribe(t.sub)}catch(e){}}delete dMqPend[t.sub];if(cb)cb(false,'Timeout - No response',Date.now()-pend.at)},MQ_TIMEOUT)}catch(pe){delete dMqPend[t.sub];if(cb)cb(false,'Publish failed: '+pe.message,0)}},onFailure:function(er){delete dMqPend[t.sub];if(cb)cb(false,'Subscribe failed',0)}})}
if(!dMqOn||!dMq){mqInit(function(ok,err){if(ok)go();else if(cb)cb(false,'MQTT connect failed: '+(err||'?'),0)});return}go()}
function dlog(id,type,txt,lat){var b=el(id);if(!b)return;var c=type==='cmd'?'cmd':type==='resp'?'resp':type==='err'?'err':'info';
var d=document.createElement('div');d.className='dcl '+c;d.innerHTML='<span class="dcl-ts">'+new Date().toLocaleTimeString('en-GB')+'</span><pre>'+esc(txt)+'</pre>'+(lat!=null?'<span class="dcl-ts">('+lat+'ms)</span>':'');b.appendChild(d);b.scrollTop=b.scrollHeight}
