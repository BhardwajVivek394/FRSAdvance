function mproto(){var s=el('dMProto');el('dMMq').style.display=s.value==='mqtt'?'block':'none';el('dMTcp').style.display=s.value==='tcp'?'block':'none'}
function clusterNoOf(n){if(!n)return 0;var m=String(n).replace(/\s/g,'').match(/cluster_?(\d+)/i);return(m&&m[1])?parseInt(m[1],10):0}
function proxyHost(){var h=window.location.hostname;if(h==='localhost'||h==='127.0.0.1'||h.indexOf('.local',h.length-6)!==-1)return 'proxy.energy7.org';if(h==='energy7.in'||h.indexOf('.energy7.in',h.length-11)!==-1)return 'proxy.energy7.org';return '172.31.25.106'}
function tcpPortOf(sid,cn,off){sid=parseInt(sid,10)||0;if(sid<=0||!cn||cn<=0)return 0;var c=String(cn+off);if(c.length<2)c='0'+c;return parseInt(String(sid)+c,10)}
function tcpInfoOf(m){var cn=clusterNoOf(m.clusterName||m.modemName),h=proxyHost(),rp=tcpPortOf(SITE_ID,cn,0),sp=tcpPortOf(SITE_ID,cn,30),b=String(m.mqttBase||'rdpms').replace(/\/+$/,''),cl=String(m.clusterName||m.modemName||'').replace(/\s+/g,'');return{modemId:m.modemId,modemName:m.modemName||m.clusterName,version:String(verNum(m.version)),clusterId:m.clusterId,clusterName:m.clusterName,clusterNo:cn,stationName:SITE_NAME||'',divisionName:'',zoneName:'',mqttBase:m.mqttBase,tcpSendPort:sp?h+':'+sp:'-',tcpRecvPort:rp?h+':'+rp:'-',subscribeTopic:b+'/'+cl+'/S',publishTopic:b+'/'+cl+'/P',tcpStatus:!!m.tcp,mqttStatus:!!m.mqtt,simNumber:m.sim||'-',signal:(m.signal!==undefined?m.signal:null)}}
function sigInfo(r){if(r===99)return{d:'Unknown',v:'Not detectable'};if(r===0)return{d:'No signal',v:'-113 dBm or less'};if(r===1)return{d:'Very weak',v:'-111 dBm'};if(r<=9)return{d:'Weak',v:'-109 to -95 dBm'};if(r<=14)return{d:'Fair',v:'-93 to -85 dBm'};if(r<=19)return{d:'Good',v:'-83 to -75 dBm'};return{d:'Excellent',v:'-73 dBm or greater'}}
function mcmd(proto,c){if(!cur||cur.kind!=='modem')return;if(cmdPending){dlog('dMConB','err','Command in progress...');return}
var m=cur.modem;dlog('dMConB','cmd','['+proto.toUpperCase()+'] > '+c);cmdPending=true;el('dMInfo').textContent='Sending...';
function done(ok,data,lat){cmdPending=false;if(ok&&data){dlog('dMConB','resp',pretty(data),lat);try{var j=JSON.parse(data);if(j.CSQ){var si=sigInfo(parseInt(String(j.CSQ).split(',')[0],10));dlog('dMConB','info','// Signal: '+si.d+' ('+si.v+')')}}catch(e){}el('dMInfo').textContent='OK ('+lat+'ms)'}else{dlog('dMConB','err',data||'No response (timeout)');el('dMInfo').textContent='Timeout'}}
if(proto==='mqtt')mqCmd(m.mqttBase,m.clusterName||m.modemName,c,done);
else{var at=Date.now();fetch(MODEM_TCP_CMD_URL,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({modemId:m.modemId,command:c,tcpInfo:tcpInfoOf(m)})}).then(function(r){return r.json()}).then(function(res){var lat=Date.now()-at;if(res&&(res.success||res.Success)&&(res.data||res.Data))done(true,res.data||res.Data,lat);else done(false,(res&&(res.error||res.Error))||'No response (timeout)',lat)}).catch(function(e){done(false,'TCP Failed: '+e.message,0)})}}
