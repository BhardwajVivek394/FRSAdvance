else{h+='<div class="dkv"><span>Protocol</span><b><select id="dMProto" style="background:var(--panel2);color:var(--txt);border:1px solid var(--bdr2);border-radius:6px;padding:3px 6px" onchange="DSB.mproto()"><option value="mqtt">MQTT</option><option value="tcp">TCP</option></select></b></div>'
