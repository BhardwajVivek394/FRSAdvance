var h='<div class="dfrow" style="margin-top:4px"><label style="flex:1">Asset Type<select style="width:100%" onchange="DSB.atype(this.value)"><option value="">-- Select Asset Type --</option>'
+(c.types||[]).map(function(it){var id=fd(it.Id,it.id,''),nm=fd(it.Name,it.name,'');return '<option value="'+esc(id)+'"'+(String(c.selType)===String(id)?' selected':'')+'>'+esc(nm)+'</option>'}).join('')+'</select></label></div>';
if(c.loading)return h+'<div class="dempty">Loading asset types...</div>';
if(!c.types)return h+'<div class="dempty">Asset types not loaded</div>';
if(!c.selType)return h+'<div class="dempty">Select an asset type to view assets, attributes &amp; ADCs</div>';
var tr=c.trees[c.selType];if(tr==='loading')return h+'<div class="dempty">Loading assets...</div>';
if(!tr||!tr.length)return h+'<div class="dempty">No assets found for this type</div>';
var gr={};tr.forEach(function(it){var an=fd(it.AssetName,it.assetName,'Unknown');if(!gr[an])gr[an]={tn:fd(it.AssetTypeName,it.assetTypeName,''),at:{}};var a=fd(it.AttributeName,it.attributeName,'Unknown');(gr[an].at[a]=gr[an].at[a]||[]).push(it)});
Object.keys(gr).sort().forEach(function(an){var g=gr[an],aid='ag_'+an.replace(/[^a-zA-Z0-9]/g,'_');
h+='<div class="ag"><div class="ag-h" onclick="DSB.tog(\''+aid+'\',this)"><span class="chev">&#9654;</span>&#128230; <b>'+esc(an)+'</b><span class="dbadge">'+esc(g.tn)+'</span><span class="dbadge mq" style="margin-left:auto">'+Object.keys(g.at).length+' Attributes</span></div><div id="'+aid+'" style="display:none">';
Object.keys(g.at).forEach(function(at){var ads=g.at[at],tid=aid+'_'+at.replace(/[^a-zA-Z0-9]/g,'_');
h+='<div class="at-h" onclick="DSB.tog(\''+tid+'\',this)"><span class="chev">&#9654;</span>&#127898; '+esc(at)+'<span class="dbadge" style="margin-left:auto">'+ads.length+' ADCs</span></div><div id="'+tid+'" style="display:none">';
ads.forEach(function(adc){var n=fd(adc.ADCNumber,adc.adcNumber,'?'),pin=fd(adc.Pin,adc.pin,'?'),cl=fd(adc.ClusterId,adc.clusterId,''),cn=fd(adc.ClusterName,adc.clusterName,'');
h+='<div class="adc-i" onclick="DSB.adc(\''+esc(String(n))+'\',\''+esc(String(cl))+'\')">&#128268; <b>ADC-'+esc(n)+'</b><span>Pin '+esc(pin)+'</span><span class="dbadge">'+esc(cn||'-')+'</span></div>'});
h+='</div>'});h+='</div></div>'});return h}
function atype(v){assetCache.selType=v;if(!v){render();return}
if(assetCache.trees[v]&&assetCache.trees[v]!=='loading'){render();return}
assetCache.trees[v]='loading';render();
fetch(NW_YARD_CONFIG_URL+'?siteId='+encodeURIComponent(SITE_ID)+'&assetTypeId='+encodeURIComponent(v),{credentials:'include'}).then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json()}).then(function(j){var d=[];if(j&&(j.Success||j.success)&&(j.Data||j.data))d=j.Data||j.data;else if(Array.isArray(j))d=j;assetCache.trees[v]=d;render()}).catch(function(){assetCache.trees[v]=[];render()})}
function tog(id,hdr){var x=el(id);if(!x)return;var o=x.style.display!=='none';x.style.display=o?'none':'block';var ch=hdr.querySelector('.chev');if(ch)ch.style.transform=o?'':'rotate(90deg)'}
function openAdc(adcNumber,clusterId){var m=modems.find(function(x){return String(x.clusterId)===String(clusterId)});if(!m)return;
var a=(m.a10s||[]).find(function(x){return String(x.adcNumber)===String(adcNumber)||String(x.a10Id)===String(adcNumber)});
if(a){openA10Sb(m,a);return}
openA10Sb(m,{a10Id:adcNumber,clusterId:m.clusterId,modemId:m.modemId,tcp:false,mqtt:false,online:false,type:'',fw:'',lastData:'',uptime:'',slave:adcNumber,adcNumber:adcNumber})}
// ---------- public namespace for onclick attributes ----------
window.DSB={close:dsbClose,tab:dsbTab,graph:openSelGraph,hist:loadHist,filt:filtHist,
mcmd:mcmd,msend:msend,mproto:mproto,acmd:acmd,asend:asend,pinOk:pinOk,pinNo:pinNo,ep:epPrev,timeOk:timeOk,timeNo:timeNo,
sub:subToggle,pub:pubClick,clear:function(id){var b=el(id);if(b)b.innerHTML=''},
view:function(v){devView[active]=v;render();if(v==='asset')ensureAssetTypes()},atype:atype,tog:tog,adc:openAdc,
a10:function(mi,ai){var m=modems[mi];if(m&&m.a10s[ai])openA10Sb(m,m.a10s[ai])}};

load();
})();
