        if (histState.selType === "modem") {
            if (!hdUrlOk(MODEM_GRAPH_URL)) return;
            url = MODEM_GRAPH_URL + "?clusterId=" + histState.sel.clusterId + "&fromDate=" + hdFormatDateApi(d.from) + "&toDate=" + hdFormatDateApi(d.to);
        } else {
            if (!hdUrlOk(A10_GRAPH_URL)) return;
