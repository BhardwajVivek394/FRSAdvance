    var EV = { DataRecv: evalDataReceiver, Datalogger: evalDatalogger, Alert: evalAlert, Debouncer: evalDebouncer, Point: evalPoint };

    // Milliseconds since the last MQTT payload for this station (Infinity if never received).
    function stationDataAgeMs(st) {
