    // ===== Filtering =====
    function getFilteredStations() {
        // Multi-select semantics: empty selection = All; match by id with a
        // name fallback (some MQTT stations only carry zone/division names).
        var dList = divisionOptions.length ? divisionOptions : masterDivisions;
        var sList = siteOptions.length ? siteOptions : masterSites;
        var zNames = filterZoneIds.map(function (id) { return String(optionName(masterZones, id) || "").toLowerCase(); }).filter(Boolean);
        var dNames = filterDivisionIds.map(function (id) { return String(optionName(dList, id) || "").toLowerCase(); }).filter(Boolean);
        var sNames = filterSiteIds.map(function (id) { return String(optionName(sList, id) || "").toLowerCase(); }).filter(Boolean);
        return stations.filter(function (s) {
            var ok = true;
            if (filterZoneIds.length) ok = ok && (filterZoneIds.indexOf(String(firstDefined(s.zoneId, s.ZoneId, ""))) >= 0 || zNames.indexOf(String(s.zone || "").toLowerCase()) >= 0);
            if (ok && filterDivisionIds.length) ok = ok && (filterDivisionIds.indexOf(String(firstDefined(s.divisionId, s.DivisionId, ""))) >= 0 || dNames.indexOf(String(s.division || "").toLowerCase()) >= 0);
            if (ok && filterSiteIds.length) ok = ok && (filterSiteIds.indexOf(String(firstDefined(s.siteId, s.SiteId, ""))) >= 0 || sNames.indexOf(String(s.stationName || "").toLowerCase()) >= 0);
            if (ok && filterSearch) { var q = filterSearch.toLowerCase(); ok = [s.stationName, s.siteId, s.zone, s.division, s._topic].some(function (x) { return String(x || "").toLowerCase().indexOf(q) >= 0; }); }
            return ok;
