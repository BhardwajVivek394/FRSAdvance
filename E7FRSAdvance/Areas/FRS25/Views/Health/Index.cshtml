                    '<span>' + m.a10s.length + ' A10</span></div></div>';
            });
            h += '</div>';
        } else { // iot
            h += '<div class="m-sec-t" style="margin-bottom:10px">Select an A10 to view its status history &amp; graph</div>';
            modems.forEach(function (m, mi) {
                if (!m.a10s.length) return;
                h += '<div class="a10-group"><div class="ag-hdr">\uD83D\uDCE1 ' + esc(m.clusterName) + ' <span style="color:var(--tx4);font-weight:400">(' + esc(m.modemName) + ')</span></div><div>';
                m.a10s.forEach(function (a, ai) {
                    h += '<span class="a10-chip" data-mi="' + mi + '" data-ai="' + ai + '"><span class="ad ' + (a.online ? "on" : "off") + '"></span>A10-' + esc(a.a10Id) + (a.type ? ' \u00B7 ' + esc(a.type) : '') + '</span>';
                });
                h += '</div></div>';
            });
        }
        h += '<div id="histGraphArea"></div>';
        body.innerHTML = h;

        if (key === "network") {
            body.querySelectorAll(".dev-card").forEach(function (el) {
                el.onclick = function () {
                    body.querySelectorAll(".dev-card").forEach(function (x) { x.classList.remove("selected"); });
                    el.classList.add("selected");
                    histState.sel = modems[parseInt(el.getAttribute("data-i"), 10)];
                    histState.selType = "modem";
                    buildGraphArea("Modem \u2014 " + histState.sel.clusterName);
                    loadHistGraph();
                };
            });
        } else {
            body.querySelectorAll(".a10-chip").forEach(function (el) {
                el.onclick = function () {
                    body.querySelectorAll(".a10-chip").forEach(function (x) { x.classList.remove("selected"); });
                    el.classList.add("selected");
                    var m = modems[parseInt(el.getAttribute("data-mi"), 10)];
                    histState.sel = m.a10s[parseInt(el.getAttribute("data-ai"), 10)];
                    histState.selType = "a10";
                    buildGraphArea("A10-" + histState.sel.a10Id + " \u2014 " + m.clusterName);
                    loadHistGraph();
                    loadA10HistoryList();
                };
            });
        }
    }

    function buildGraphArea(title) {
        document.getElementById("histGraphArea").innerHTML =
            '<div class="graph-box">' +
              '<div class="graph-bar"><div class="gb-title">' + esc(title) + '</div>' +
                '<label class="gchk"><input type="checkbox" id="hChkTcp" checked /> TCP</label>' +
                '<label class="gchk"><input type="checkbox" id="hChkMqtt" checked /> MQTT</label>' +
                '<button class="gbtn" id="hBtnLoad">Load Graph</button></div>' +
              '<div class="graph-stats" id="hGraphStats"></div>' +
              '<div class="graph-loader" id="hGraphLoader"><span class="msel-spin"></span> Loading history\u2026</div>' +
              '<div class="graph-empty" id="hGraphEmpty">\uD83D\uDCED No history found for this date range.</div>' +
              '<div class="chart-wrap"><canvas id="hChart" style="display:none"></canvas></div>' +
              '<div class="hist-list" id="hHistList"></div>' +
            '</div>';
        document.getElementById("hBtnLoad").onclick = function () { loadHistGraph(); if (histState.selType === "a10") loadA10HistoryList(); };
        document.getElementById("hChkTcp").onchange = function () { if (histState.lastData) renderHistChart(histState.lastData); };
        document.getElementById("hChkMqtt").onchange = function () { if (histState.lastData) renderHistChart(histState.lastData); };
    }

    async function loadHistGraph() {
        if (!histState.sel) return;
        var d = histDates();
        if (!d.from || !d.to) { alert("Please select a date range"); return; }
        var url;
        if (histState.selType === "modem") {
            if (!hdUrlOk(MODEM_GRAPH_URL)) return;
            url = MODEM_GRAPH_URL + "?clusterId=" + histState.sel.clusterId + "&fromDate=" + hdFormatDateApi(d.from) + "&toDate=" + hdFormatDateApi(d.to);
        } else {
            if (!hdUrlOk(A10_GRAPH_URL)) return;
            url = A10_GRAPH_URL + "?clusterId=" + histState.sel.clusterId + "&a10Id=" + histState.sel.a10Id + "&fromDate=" + hdFormatDateApi(d.from) + "&toDate=" + hdFormatDateApi(d.to);
        }
        var loader = document.getElementById("hGraphLoader"), empty = document.getElementById("hGraphEmpty"),
            chartEl = document.getElementById("hChart"), btn = document.getElementById("hBtnLoad");
        loader.style.display = "flex"; empty.style.display = "none"; chartEl.style.display = "none";
        document.getElementById("hGraphStats").innerHTML = "";
        btn.disabled = true;
        try {
            var r = await fetch(url, { credentials: "same-origin" });
            if (!r.ok) throw new Error("HTTP " + r.status);
            var data = await r.json();
            loader.style.display = "none"; btn.disabled = false;
            if (!data || data.Success === false || (Array.isArray(data) && data.length === 0)) {
                empty.style.display = "flex"; histState.lastData = null; return;
            }
            histState.lastData = Array.isArray(data) ? data : hdUnwrapList(data);
            chartEl.style.display = "block";
            renderHistChart(histState.lastData);
        } catch (e) {
            loader.style.display = "none"; btn.disabled = false; empty.style.display = "flex";
            log("History graph failed: " + e.message, "err");
        }
    }

    // ---- gap filling + online stats (ported from the Network Dashboard) ----
    function hdFillTimeGaps(dataArray, fromDate, toDate, gapThresholdMinutes) {
        if (dataArray.length === 0) return [];
        var gapMs = (gapThresholdMinutes || 5) * 60 * 1000;
        dataArray.sort(function (a, b) { return a.x - b.x; });
        var out = [];
        var startTime = new Date(fromDate + "T00:00:00").getTime();
        var endTime = new Date(toDate + "T23:59:59").getTime();
        var effectiveEnd = Math.min(endTime, Date.now());
        if (dataArray[0].x.getTime() > startTime + gapMs) {
            out.push({ x: new Date(startTime), y: 0, status: "offline" });
            out.push({ x: new Date(dataArray[0].x.getTime() - 1000), y: 0, status: "offline" });
        }
        for (var i = 0; i < dataArray.length; i++) {
            if (i > 0) {
                var gap = dataArray[i].x.getTime() - dataArray[i - 1].x.getTime();
                if (gap > gapMs) {
                    out.push({ x: new Date(dataArray[i - 1].x.getTime() + 1000), y: 0, status: "offline" });
                    out.push({ x: new Date(dataArray[i].x.getTime() - 1000), y: 0, status: "offline" });
                }
            }
            out.push({ x: dataArray[i].x, y: dataArray[i].y, status: "online" });
        }
        var last = dataArray[dataArray.length - 1];
        if (last.x.getTime() < effectiveEnd - gapMs) {
            out.push({ x: new Date(last.x.getTime() + 1000), y: 0, status: "offline" });
            out.push({ x: new Date(effectiveEnd), y: 0, status: "offline" });
        }
        return out;
    }
    function hdCalcOnlineStats(filled, fromDate, toDate) {
        if (!filled.length) return { onlinePercent: 0, avg: 0 };
        var on = filled.filter(function (p) { return p.status === "online"; });
        var avg = on.length ? Math.round(on.reduce(function (s, p) { return s + p.y; }, 0) / on.length) : 0;
        var t = 0, start = null;
        filled.forEach(function (p) {
            if (p.status === "online" && start === null) start = p.x.getTime();
            else if (p.status === "offline" && start !== null) { t += p.x.getTime() - start; start = null; }
        });
        if (start !== null) t += filled[filled.length - 1].x.getTime() - start;
        var total = Math.min(new Date(toDate + "T23:59:59").getTime(), Date.now()) - new Date(fromDate + "T00:00:00").getTime();
        return { onlinePercent: Math.min(total > 0 ? Math.round(t / total * 100) : 0, 100), avg: avg };
    }

    function renderHistChart(data) {
        var d = histDates();
        var showTcp = document.getElementById("hChkTcp").checked;
        var showMqtt = document.getElementById("hChkMqtt").checked;
        var isModem = histState.selType === "modem";
        var tcpRaw = [], mqttRaw = [];

        data.forEach(function (item) {
            var ts = firstDefined(item.TimeStamp, item.Timestamp, item.timeStamp, item.CreatedOn, item.DateTime);
            var typeId = num(firstDefined(item.TypeId, item.typeId), 0);
            if (!ts) return;
            var val;
            if (isModem) val = parseInt(firstDefined(item.SignalStrength, item.signalStrength, 0), 10) || 0;
            else val = typeId === 1 ? (parseInt(firstDefined(item.ResponseTime, item.responseTime, 0), 10) || 0)
                                    : (parseInt(firstDefined(item.Uptime, item.uptime, 0), 10) || 0);
            if (val <= 0) return;
            var pt = { x: new Date(ts), y: val };
            if (typeId === 1) tcpRaw.push(pt); else if (typeId === 2) mqttRaw.push(pt);
        });

        var tcpFilled = hdFillTimeGaps(tcpRaw, d.from, d.to, 5);
        var mqttFilled = hdFillTimeGaps(mqttRaw, d.from, d.to, 5);
        var tcpStats = hdCalcOnlineStats(tcpFilled, d.from, d.to);
        var mqttStats = hdCalcOnlineStats(mqttFilled, d.from, d.to);

        var unit = isModem ? " dBm" : "";
        var statsHtml = "";
        if (showTcp && tcpFilled.length) {
            var tc = tcpStats.onlinePercent >= 80 ? "good" : tcpStats.onlinePercent >= 50 ? "warn" : "poor";
            statsHtml += '<div class="gstat"><span class="gs-dot tcp"></span>TCP \u00B7 avg ' + tcpStats.avg + unit + ' \u00B7 <span class="pct ' + tc + '">' + tcpStats.onlinePercent + '% online</span></div>';
        }
        if (showMqtt && mqttFilled.length) {
            var mc = mqttStats.onlinePercent >= 80 ? "good" : mqttStats.onlinePercent >= 50 ? "warn" : "poor";
            statsHtml += '<div class="gstat"><span class="gs-dot mqtt"></span>MQTT \u00B7 avg ' + mqttStats.avg + unit + ' \u00B7 <span class="pct ' + mc + '">' + mqttStats.onlinePercent + '% online</span></div>';
        }
        document.getElementById("hGraphStats").innerHTML = statsHtml;

        var hasTcp = showTcp && tcpFilled.length > 0, hasMqtt = showMqtt && mqttFilled.length > 0;
        var chartEl = document.getElementById("hChart"), empty = document.getElementById("hGraphEmpty");
        if (!hasTcp && !hasMqtt) { chartEl.style.display = "none"; empty.style.display = "flex"; return; }
        empty.style.display = "none"; chartEl.style.display = "block";

        destroyHistChart();
        function seg(colorOk) {
            return {
                borderColor: function (ctx) { return (ctx.p0.parsed.y === 0 || ctx.p1.parsed.y === 0) ? "#ef4444" : colorOk; },
                backgroundColor: function (ctx) { return (ctx.p0.parsed.y === 0 || ctx.p1.parsed.y === 0) ? "rgba(239,68,68,0.1)" : "rgba(0,0,0,0)"; }
            };
        }
        var datasets = [];
        if (hasTcp) datasets.push({ label: "TCP", data: tcpFilled.map(function (p) { return { x: p.x, y: p.y }; }), borderColor: "#60a5fa", backgroundColor: "rgba(96,165,250,0.1)", borderWidth: 2, fill: true, tension: 0, pointRadius: 1, pointHoverRadius: 5, segment: seg("#60a5fa") });
        if (hasMqtt) datasets.push({ label: "MQTT", data: mqttFilled.map(function (p) { return { x: p.x, y: p.y }; }), borderColor: "#34d399", backgroundColor: "rgba(52,211,153,0.1)", borderWidth: 2, fill: true, tension: 0, pointRadius: 1, pointHoverRadius: 5, segment: seg("#34d399") });

        var isLight = document.body.getAttribute("data-aurora") === "light";
        var gridColor = isLight ? "rgba(15,23,42,0.08)" : "rgba(255,255,255,0.08)";
        var textColor = isLight ? "#64748b" : "#8b9dc3";
        var yTitle = isModem ? "Signal (dBm)" : "TCP: response \u00B7 MQTT: uptime";

        histState.chart = new Chart(chartEl.getContext("2d"), {
            type: "line",
            data: { datasets: datasets },
            options: {
                responsive: true, maintainAspectRatio: false,
                interaction: { mode: "index", intersect: false },
                plugins: {
                    legend: { display: true, labels: { color: textColor, boxWidth: 12, font: { size: 10 } } },
                    tooltip: {
                        callbacks: {
                            title: function (ctx) { return new Date(ctx[0].parsed.x).toLocaleString(); },
                            label: function (ctx) { var v = ctx.parsed.y; return ctx.dataset.label + ": " + (v === 0 ? "OFFLINE" : v + (isModem ? " dBm" : "")); }
                        }
                    }
                },
                scales: {
                    x: { type: "time", time: { displayFormats: { minute: "HH:mm", hour: "HH:mm", day: "dd MMM" } }, grid: { color: gridColor }, ticks: { color: textColor, maxRotation: 45 } },
                    y: { min: 0, title: { display: true, text: yTitle, color: textColor }, grid: { color: gridColor }, ticks: { color: textColor, callback: function (v) { return v === 0 ? "Offline" : v; } } }
                }
            }
        });
    }

    // A10 recent records list ({Success, Data})
    async function loadA10HistoryList() {
        if (!histState.sel || histState.selType !== "a10" || !hdUrlOk(A10_RECORDS_URL)) return;
        var d = histDates();
        var el = document.getElementById("hHistList");
        el.innerHTML = '<div class="graph-loader" style="display:flex"><span class="msel-spin"></span> Loading records\u2026</div>';
        var url = A10_RECORDS_URL + "?clusterId=" + histState.sel.clusterId + "&a10Id=" + histState.sel.a10Id +
            "&ModemId=" + encodeURIComponent(histState.sel.modemId || "") +
            "&fromDate=" + hdFormatDateApi(d.from) + "&toDate=" + hdFormatDateApi(d.to);
        try {
            var r = await fetch(url, { credentials: "same-origin" });
            if (!r.ok) throw new Error("HTTP " + r.status);
            var resp = await r.json();
            if (resp && resp.Success === false) { el.innerHTML = '<div class="htl-empty">' + esc(resp.Message || "No records") + '</div>'; return; }
            var rows = hdUnwrapList(resp);
            if (!rows.length) { el.innerHTML = '<div class="htl-empty">No records in this range.</div>'; return; }
            rows.sort(function (a, b) { return new Date(firstDefined(b.TimeStamp, b.timeStamp, 0)) - new Date(firstDefined(a.TimeStamp, a.timeStamp, 0)); });
            el.innerHTML = rows.slice(0, 100).map(function (rec) {
                var ts = new Date(firstDefined(rec.TimeStamp, rec.timeStamp, 0));
                var typeId = num(firstDefined(rec.TypeId, rec.typeId), 0);
                return '<div class="hist-row"><span class="hr-dot on"></span>' +
                    '<span class="hr-time">' + ts.toLocaleString() + '</span>' +
                    '<span class="hr-proto ' + (typeId === 1 ? "tcp" : "mqtt") + '">' + (typeId === 1 ? "TCP" : "MQTT") + '</span>' +
                    '<span class="hr-txt">' + (typeId === 1
                        ? ("Response " + esc(firstDefined(rec.ResponseTime, rec.responseTime, "\u2014")))
                        : ("Uptime " + esc(firstDefined(rec.Uptime, rec.uptime, "\u2014")))) + '</span></div>';
            }).join("");
        } catch (e) {
            el.innerHTML = '<div class="htl-empty">Failed to load records.</div>';
        }
    }

    // Sensors tab — sensor-alert timeline for the site within the date range
    function renderSensorTimeline() {
        var body = document.getElementById("hmoBody");
        var d = histDates();
        var from = new Date(d.from + "T00:00:00").getTime(), to = new Date(d.to + "T23:59:59").getTime();
        var alerts = alertLiveRaw.filter(function (a) {
            if (String(a.siteId || "") !== String(histState.siteId)) return false;
            if (SERVICE_HEALTH_IDS.indexOf(String(a.sourceId || "")) >= 0) return false;
            var ts = firstDefined(a.timestampSet, a.TimestampSet, a.timestampUpdated, a.TimestampUpdated);
            if (!ts) return true;
            var t = new Date(ts).getTime();
            return t >= from && t <= to;
        });
        var h = '<div class="m-sec-t" style="margin-bottom:10px">Sensor alert timeline (' + alerts.length + ' alert' + (alerts.length === 1 ? '' : 's') + ' in range)</div>' +
            '<div style="font-size:10.5px;color:var(--tx4);margin-bottom:12px">Refresh range with the date pickers above, then re-open this tab.</div>';
        if (!alerts.length) { body.innerHTML = h + '<div class="htl-empty">\u2705 No sensor alerts in this date range.</div>'; return; }
        alerts.sort(function (a, b) {
            return new Date(firstDefined(b.timestampSet, b.TimestampSet, 0)).getTime() - new Date(firstDefined(a.timestampSet, a.TimestampSet, 0)).getTime();
        });
        h += '<div class="htl">';
        alerts.slice(0, 150).forEach(function (a) {
            var ts = firstDefined(a.timestampSet, a.TimestampSet);
            var pri = String(firstDefined(a.priority, a.Priority, "")).toLowerCase();
            var stCls = (pri.indexOf("crit") >= 0 || pri.indexOf("high") >= 0) ? "st-critical" : "st-warning";
            h += '<div class="htl-item ' + stCls + '"' + (a.alertId ? ' style="cursor:pointer" onclick="HealthDash.openAlertDetail(' + num(a.alertId) + ')"' : '') + '>' +
                '<div class="htl-time">' + (ts ? new Date(ts).toLocaleString() : "\u2014") + '</div>' +
                '<div class="htl-event">' + esc(firstDefined(a.sourceId, a.SourceId, "Sensor")) + '</div>' +
                '<div class="htl-sub">' + esc(firstDefined(a.alertDescription, a.AlertDescription, "")) + '</div></div>';
        });
        body.innerHTML = h + '</div>';
    }

    function loadSiteDevices(siteId, reopenType) {
        fetchDeviceStatusForSite(siteId, true);
        if (reopenType) {
            var tries = 0;
            var t = setInterval(function () {
                var c = deviceStatusCache[parseInt(siteId, 10) || 0] || {};
                if (!c.loading || ++tries > 40) {
                    clearInterval(t);
                    var mo = document.getElementById("mo");
                    if (mo && mo.classList.contains("open")) openHW(String(siteId), reopenType);
                }
            }, 300);
        }
    }

    window.HealthDash = {
        openSvc: openSvc, openHW: openHW, openWrench: openWrench,
        openHistory: openHistory, closeHistory: closeHistory, loadSiteDevices: loadSiteDevices,
        mergePayload: mergeHealthPayload, // debug/integration hook: HealthDash.mergePayload(json, topic)
        openPaste: openPaste, doPaste: doPaste, closeModal: closeModal,
        toggleMqtt: function () { mqttConnected ? disconnectMqtt() : connectMqtt(); },
        subscribeMqtt: subscribeMqtt,
        switchView: switchView,
        toggleSiteAlerts: toggleSiteAlerts,
        openAlertDetail: openAlertDetail,
        loadSiteSensors: function (siteId) {
            Promise.all([
                fetchSensorDataForSite(siteId),
                fetchCardLineForSite(siteId)
            ]).then(function () {
                crossReferenceSensorAlerts();
                render();
                // Re-open the modal
                openHW(String(siteId), "sensors");
            });
        }
    };

    // ===== INIT =====
    refreshHealthMqttTopics(false).then(function () {
        connectMqtt();
        connectDebouncerWs();
        // Fetch sensor data for all known sites after topics load
        setTimeout(fetchAllSensorData, 1000);
        // Live modem / A10 device status (Network-Dashboard style binding)
        setTimeout(loadVisibleDeviceStatus, 500);
    });
    fetchAlertLive();
    setInterval(fetchAlertLive, ALERT_LIVE_POLL_MS);
    // Refresh visible-site device status every 2 minutes
    setInterval(function () { loadVisibleDeviceStatus(true); }, 120000);
    // Re-fetch sensor data periodically (every 5 min) for new sites
    setInterval(function () { fetchAllSensorData(); }, 300000);
    render();
    var _lastStaleKey = null;
    setInterval(function () {
        var t = document.getElementById("timer");
        if (t) t.textContent = Math.floor((Date.now() - lastRefresh) / 1000) + "s";
        // Detect staleness transitions (sites going silent / coming back) and re-render.
        var staleKey = stations.filter(isStationStale).map(function (s) { return s.siteId; }).sort().join(",");
        if (staleKey !== _lastStaleKey) { _lastStaleKey = staleKey; render(); }
    }, 1000);

    if (CONFIG.API_URL) {
        var poll = async function () {
            try { var r = await fetch(CONFIG.API_URL); if (r.ok) { mergeHealthPayload(await r.json(), "api"); } }
            catch (e) { log("API poll failed: " + e.message, "err"); }
        };
        poll(); setInterval(poll, CONFIG.POLL_INTERVAL_MS);
    }
})();
</script>
