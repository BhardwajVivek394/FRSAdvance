    // ===== GRAPH POPUP =====
    var graphChart = null;

    // Robust timestamp -> epoch ms. Handles ISO strings, epoch numbers,
    // ASP.NET "/Date(123456)/", and "dd-MM-yyyy HH:mm:ss" from the history API.
    // Chart.js time scale silently drops points it cannot parse, which is why
    // the graph used to come up blank ("not loading").
    function parseGraphTs(v) {
        if (v === null || v === undefined || v === "") return null;
        if (v instanceof Date) return isNaN(v.getTime()) ? null : v.getTime();
        if (typeof v === "number") return v > 1e12 ? v : (v > 1e9 ? v * 1000 : null);
        var s = String(v).trim();
        var m = s.match(/\/Date\((-?\d+)/);
        if (m) return Number(m[1]);
        var t = Date.parse(s);
        if (!isNaN(t)) return t;
        m = s.match(/^(\d{1,2})-(\d{1,2})-(\d{4})(?:[ T](\d{1,2}):(\d{1,2})(?::(\d{1,2}))?)?/);
        if (m) return new Date(+m[3], +m[2] - 1, +m[1], +(m[4] || 0), +(m[5] || 0), +(m[6] || 0)).getTime();
        return null;
    }
    function closeGraph() {
        document.getElementById("gpm").classList.remove("open");
        document.getElementById("gpPanel").classList.remove("fullscreen");
        if (graphChart) { try { graphChart.destroy(); } catch (e) {} graphChart = null; }
    }
