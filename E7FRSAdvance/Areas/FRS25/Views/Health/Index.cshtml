    var mQTTSource = @Html.Raw(mqttJson);
    var mQTT = Array.isArray(mQTTSource) ? (mQTTSource[0] || {}) : (mQTTSource || {});

    var DIVISION_URL = '@Url.Action("GetDivisionByZoneId", "Health", new { area = "FRS25" })';
