        var info = document.getElementById('nwHistFilterInfo');
        if (info) info.textContent = f === 'all' ? '' : ('(filter: ' + f.toUpperCase() + ')');
    }

    // =====================================================================
    // MQTT TRANSPORT (Paho) - dedicated command client, same broker config
    // Topic scheme identical to N/W db: publish base/Cluster/S, response base/Cluster/P
    // =====================================================================
    function nwMqttInit(cb) {
        if (nwMqttConnected && nwMqttClient) { cb(true); return; }
        var Ctor = getPahoClientConstructor();
        if (!Ctor) { cb(false, 'Paho MQTT library not loaded'); return; }
        var host = getBrokerHost(), port = getBrokerPort();
        if (!host || !port) { cb(false, 'MQTT detail missing (ViewBag.MQTTDetail)'); return; }
        try {
            nwMqttClient = new Ctor(host, port, 'web_cmd_' + Math.ceil(Math.random() * 100000));
            nwMqttClient.onConnectionLost = function () {
                nwMqttConnected = false;
                for (var t in nwMqttPending) {
                    var p = nwMqttPending[t];
                    if (p.timeoutId) clearTimeout(p.timeoutId);
                    if (p.callback) p.callback(false, 'Connection lost', 0);
                }
                nwMqttPending = {};
                nwSetSubState(false);
            };
            nwMqttClient.onMessageArrived = function (msg) { nwMqttOnMsg(msg.destinationName, msg.payloadString); };
            var opts = {
                timeout: 10, useSSL: window.location.protocol === 'https:', cleanSession: true,
                onSuccess: function () { nwMqttConnected = true; cb(true); },
                onFailure: function (e) { cb(false, e && e.errorMessage ? e.errorMessage : 'Connect failed'); }
            };
            var u = getBrokerUser(), pw = getBrokerPassword();
            if (u) opts.userName = u;
            if (pw) opts.password = pw;
            nwMqttClient.connect(opts);
        } catch (e) { cb(false, e.message); }
    }
    function nwMqttOnMsg(topic, payload) {
        if (nwMqttLiveSubTopic && topic === nwMqttLiveSubTopic) {
            nwLog(nwCur && nwCur.kind === 'a10' ? 'nwA10StatusConBody' : 'nwConBody', 'response', payload);
        }
        var p = nwMqttPending[topic];
        if (p) {
            if (p.timeoutId) clearTimeout(p.timeoutId);
            delete nwMqttPending[topic];
            if (topic !== nwMqttLiveSubTopic) { try { nwMqttClient.unsubscribe(topic); } catch (e) { } }
            if (p.callback) p.callback(true, payload, Date.now() - p.sentAt);
        }
    }
    function nwMqttCmd(base, cluster, cmdJson, cb) {
        var t = nwTopics(base, cluster);
        var pend = { sentAt: Date.now(), callback: cb, timeoutId: null };
        function go() {
            nwMqttPending[t.sub] = pend;
            nwMqttClient.subscribe(t.sub, {
                qos: 0,
                onSuccess: function () {
                    try {
                        nwMqttClient.send(t.pub, cmdJson, 0, false);
                        pend.timeoutId = setTimeout(function () {
                            if (t.sub !== nwMqttLiveSubTopic) { try { nwMqttClient.unsubscribe(t.sub); } catch (e) { } }
                            delete nwMqttPending[t.sub];
                            if (cb) cb(false, 'Timeout - No response', Date.now() - pend.sentAt);
                        }, NW_MQTT_TIMEOUT);
                    } catch (pe) {
                        try { nwMqttClient.unsubscribe(t.sub); } catch (e) { }
                        delete nwMqttPending[t.sub];
                        if (cb) cb(false, 'Publish failed: ' + pe.message, 0);
                    }
                },
                onFailure: function (err) {
                    delete nwMqttPending[t.sub];
                    if (cb) cb(false, 'Subscribe failed: ' + (err && err.errorMessage ? err.errorMessage : '?'), 0);
                }
            });
        }
        if (!nwMqttConnected || !nwMqttClient) {
            nwMqttInit(function (ok, err) { if (ok) go(); else if (cb) cb(false, 'MQTT connection failed: ' + (err || 'Unknown'), 0); });
            return;
        }
        go();
    }

    // ---------- MQTT path cards (A10 status tab) ----------
    function nwSetSubState(on) {
        var s = document.getElementById('nwSubState');
        if (s) { s.textContent = on ? '\u25CF LIVE' : ''; s.style.color = 'var(--grn)'; }
        var card = document.getElementById('nwSubCard');
        if (card) card.classList.toggle('live', !!on);
    }
    function nwMqttSubToggle() {
        if (!nwCur || nwCur.kind !== 'a10') return;
        var topic = nwCur.a10._sub;
        var con = document.getElementById('nwA10StatusCon');
        if (con) con.style.display = 'block';
        if (nwMqttLiveSubTopic === topic) {
            try { if (nwMqttClient) nwMqttClient.unsubscribe(topic); } catch (e) { }
            nwMqttLiveSubTopic = null;
            nwSetSubState(false);
            nwLog('nwA10StatusConBody', 'info', '// Unsubscribed ' + topic);
            return;
        }
        nwMqttInit(function (ok, err) {
            if (!ok) { nwLog('nwA10StatusConBody', 'error', 'MQTT connect failed: ' + (err || '?')); return; }
            try {
                nwMqttClient.subscribe(topic, { qos: 0 });
                nwMqttLiveSubTopic = topic;
                nwSetSubState(true);
                nwLog('nwA10StatusConBody', 'info', '// Subscribed ' + topic);
            } catch (e) { nwLog('nwA10StatusConBody', 'error', 'Subscribe failed: ' + e.message); }
        });
    }
