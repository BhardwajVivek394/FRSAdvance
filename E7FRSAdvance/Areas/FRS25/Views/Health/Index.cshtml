    function unknownSvc() { return { status: "unknown", conns: [], issues: [{ sev: "info", msg: "No health packet received yet" }], metrics: { Status: "Waiting" } }; }

    function getSvcData(services, key) {
        services = safeObj(services);
        if (key === "DataRecv") return firstDefined(services.dataReceiverHealth, services.dataReceiver, {});
        if (key === "Datalogger") return { dataloggerHeartbeat: services.dataloggerHeartbeat, dataloggerDiagnostic: services.dataloggerDiagnostic };
        if (key === "Alert") return firstDefined(services.alertHealth, services.alert, {});
        if (key === "Debouncer") return firstDefined(services.debouncerHealth, services.debouncer, {});
        if (key === "Point") return firstDefined(services.pointHealth, services.pointMachineHealth, services.pointServicesHealth, services.pointServices, {});
