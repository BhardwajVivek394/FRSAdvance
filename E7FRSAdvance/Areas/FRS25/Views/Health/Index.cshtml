            });
        }
        return svcs;
    }

    function getFixActions(st, svcs) {
        var fixes = [];
        svcs.forEach(function (svc) {
            svc.issues.filter(function (i) { return i.sev !== "info"; }).forEach(function (issue) {
                var a = "Investigate service logs and check latest packet timestamp.";
                if (/disconnected/i.test(issue.msg)) {
                    if (/mqtt/i.test(issue.msg)) a = "Check MQTT broker reachability, credentials, topic, and reconnect the MQTT client.";
                    else if (/database/i.test(issue.msg)) a = "Check DB server, credentials, network route, and DB service logs.";
                    else if (/ws|websocket/i.test(issue.msg)) a = "Check WebSocket endpoint, upstream service, and proxy/firewall rules.";
                    else if (/serial/i.test(issue.msg)) a = "Check COM port, driver, cable, and restart datalogger service.";
                } else if (/error|exception/i.test(issue.msg)) a = "Review application logs and exception count trend.";
                else if (/buffer|timeout/i.test(issue.msg)) a = "Check disk I/O, queue depth, service CPU/RAM, and outbox backlog.";
                else if (/reconnect/i.test(issue.msg)) a = "Network instability likely. Check upstream service health and firewall rules.";
                fixes.push({ svc: svc.label + " " + svc.icon, problem: issue.msg, action: a, sev: issue.sev });
            });
        });
        HW_ORDER.forEach(function (h) {
            var hw = safeObj(st.hardware[h.key]);
            if (num(hw.unhealthy) > 0) (hw.issues || []).forEach(function (i) { fixes.push({ svc: h.label, problem: i, action: "Check field device, power, wiring, and last communication timestamp.", sev: "warning" }); });
        });
