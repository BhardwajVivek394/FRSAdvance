        var remote = safeObj(dg.remote_mqtt), ingress = safeObj(dg.ingress), sys = safeObj(dg.system), loss = safeObj(dg.loss), ack = safeObj(dg.ack_pipeline), stats = safeObj(hb.Stats);
        var sOk = boolFrom(firstDefined(rx.IsOpen, true)) && boolFrom(firstDefined(tx.IsOpen, true));
        var mOk = boolFrom(firstDefined(conn.Connected, remote.connected, safeObj(safeObj(dg.mqtt).remote).connected, true));
        var ingressOk = String(firstDefined(ingress.datalogger_status, "UP")).toUpperCase() !== "DOWN";
        var mqttState = String(firstDefined(remote.state, mOk ? "HEALTHY" : "DOWN")).toUpperCase();
