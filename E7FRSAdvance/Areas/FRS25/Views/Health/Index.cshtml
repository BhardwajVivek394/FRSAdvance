        align-items: center;
        justify-content: center;
        font-size: 14px;
        flex-shrink: 0
    }

    .sb-cluster-info {
        flex: 1
    }

    .sb-cluster-name {
        font-size: 12px;
        font-weight: 700
    }

    .sb-cluster-sub {
        font-size: 10px;
        color: var(--tx3)
    }

