        if (!mOk) issues.push({ sev: "critical", msg: "MQTT disconnected" });
        if (!wOk) issues.push({ sev: "critical", msg: "WebSocket disconnected" });
        if (num(ex.broadcastError) > 100) issues.push({ sev: "warning", msg: num(ex.broadcastError) + " broadcast errors" });
        if (num(ex.mqttConnectionError) > 500) issues.push({ sev: "warning", msg: num(ex.mqttConnectionError) + " MQTT errors" });
        if (num(bl.writeFailed) > 0 || num(il.writeFailed) > 0) issues.push({ sev: "warning", msg: "Logger write failures" });
