    function nwS(v) { return esc(String(v === null || v === undefined ? '' : v)); }
    function nwVerNum(v) { var n = parseInt(String(v === null || v === undefined ? '' : v).replace(/\D/g, ''), 10); return isNaN(n) || n === 0 ? 2 : n; }
    function nwTopics(base, cluster) {
        var b = String(base || 'rdpms').replace(/\/+$/, '');
        var c = String(cluster || '').replace(/\s+/g, '');
        return { pub: b + '/' + c + '/S', sub: b + '/' + c + '/P' };  // publish command -> /S, response -> /P
    }
    function nwApiDate(s) { var p = String(s || '').split('-'); return p.length === 3 ? (p[2] + '-' + p[1] + '-' + p[0]) : s; } // yyyy-mm-dd -> dd-MM-yyyy
    function nwToday() { return new Date().toISOString().slice(0, 10); }
    function nwFmtTs(v) {
        var ms = parseGraphTs(v);
        if (ms === null) return String(v || '-');
        var d = new Date(ms);
        return d.toLocaleDateString('en-GB') + ' ' + d.toLocaleTimeString('en-GB');
    }

    // ---------- sidebar open (signature preserved: all existing onclicks keep working) ----------
    function openDeviceSidebar(siteId, modemOrA10, deviceType) {
        var dsc = deviceStatusCache[parseInt(siteId, 10) || 0] || {};
        if (!dsc.modems || !dsc.modems.length) {
            // device status not loaded yet -> fetch now, open sidebar when it lands (max ~12s)
            if (!dsc.loading) fetchDeviceStatusForSite(num(siteId), true);
            nwRenderDetail('<h3>\u23F3 Loading device status\u2026</h3>', "",
                '<div class="nw-empty">Fetching live TCP / MQTT status for this station\u2026</div>');
            var tries = 0;
            var t = setInterval(function () {
                var c = deviceStatusCache[parseInt(siteId, 10) || 0] || {};
                if (c.modems && c.modems.length) { clearInterval(t); openDeviceSidebar(siteId, modemOrA10, deviceType); }
                else if (++tries > 40 || (c.error && !c.loading)) {
                    clearInterval(t);
                    nwRenderDetail('<h3>\u26A0 Device status unavailable</h3>', "",
                        '<div class="nw-empty" style="color:var(--red)">' + (c.error ? esc(c.error) : "No response from GetSiteDeviceStatus") + '</div>');
                }
            }, 300);
            return;
        }
        var stn = stations.find(function (s) { return String(s.siteId) === String(siteId); });
        var siteName = stn ? (stn.stationName || ("Site " + siteId)) : ("Site " + siteId);

        if (deviceType === "modem") {
            var modem = dsc.modems.find(function (m) { return String(m.clusterId) === String(modemOrA10); });
            if (!modem) return;
            nwOpenModemSb(siteId, siteName, modem);
        } else if (deviceType === "a10") {
            var parts = String(modemOrA10).split("~");
            var a10Id = parts[0], clusterId = parts[1] || "";
            var pModem = dsc.modems.find(function (m) { return String(m.clusterId) === clusterId; });
            var a10 = null;
            if (pModem && pModem.a10s) a10 = pModem.a10s.find(function (a) { return String(a.a10Id) === a10Id; });
            if (!a10) return;
            nwOpenA10Sb(siteId, siteName, pModem, a10);
        }
    }
