                    '</tr>' +
                    '<tr class="sub-row">' +
                        SVC_ORDER.map(function (s, i) { return '<th class="' + (i === 0 ? "sh-svc" : "") + (i === SVC_ORDER.length - 1 ? " sh-svc-last" : "") + '">' + esc(s.label) + '</th>'; }).join("") +
                        HW_ORDER.map(function (h, i) { return '<th class="' + (i === 0 ? "sh-hw" : "") + (i === HW_ORDER.length - 1 ? " sh-hw-last" : "") + '">' + esc(h.label) + '</th>'; }).join("") +
                    '</tr>' +
                '</thead>' +
                '<tbody id="tb"></tbody>' +
            '</table></div>' : "") +
            '<div class="ftr">RDPMS Health Dashboard &middot; ENERGY7</div>';

        document.getElementById("fZ").onchange = function (e) { filterZoneId = e.target.value || ""; bindHealthDivisions(filterZoneId); };
        document.getElementById("fD").onchange = function (e) { filterDivisionId = e.target.value || ""; bindHealthSites(filterDivisionId); };
        document.getElementById("fSite").onchange = async function (e) { filterSiteId = e.target.value || ""; await refreshHealthMqttTopics(true); fetchAlertLive(); render(); };
        var stimer;
        document.getElementById("fS").oninput = function (e) { clearTimeout(stimer); stimer = setTimeout(function () { filterSearch = e.target.value; render(); }, 250); };

        var tb = document.getElementById("tb");
        if (activeView === "live" && tb) {
        if (!ev.length) {
            tb.innerHTML = '<tr class="empty-row"><td colspan="' + (1 + SVC_ORDER.length + HW_ORDER.length + 1) + '">No health data yet. Connect MQTT or paste JSON.</td></tr>';
        } else {
            ev.forEach(function (item) {
                var stn = item.st, svcs = item.svcs;
                var tr = document.createElement("tr");
                var fixes = getFixActions(stn, svcs);
                var escapedSid = esc(String(stn.siteId));
                var svcCells = svcs.map(function (svc, i) {
                    var c = svc.status === "healthy" ? "g" : svc.status === "warning" || svc.status === "unknown" ? "a" : "r";
                    var cls = [];
                    if (i === 0) cls.push("bd-svc-l");
                    if (i === SVC_ORDER.length - 1) cls.push("bd-svc-r");
                    return '<td class="' + cls.join(" ") + '"><div class="svc-chip ' + c + '" onclick="HealthDash.openSvc(\'' + escapedSid + '\',' + i + ')"><span class="sd"></span>' + esc(svc.label) + '</div></td>';
                }).join("");
                var hwCells = HW_ORDER.map(function (h, i) {
                    var hw = safeObj(stn.hardware[h.key]);
                    var cls = [];
                    if (i === 0) cls.push("bd-hw-l");
                    if (i === HW_ORDER.length - 1) cls.push("bd-hw-r");
                    var total = num(hw.total);
                    var bad = num(hw.unhealthy);
                    // Sensors, IoT, Network: always show total with clickable detail
                    if (h.key === "sensors" || h.key === "iot" || h.key === "network") {
                        if (total > 0 && bad > 0) {
                            return '<td class="' + cls.join(" ") + '"><div class="hw-val issue" onclick="HealthDash.openHW(\'' + escapedSid + '\',\'' + h.key + '\')">' + h.icon + '<span class="hw-count">' + bad + '</span><span class="hw-total">/' + total + '</span></div></td>';
                        }
                        if (total > 0) {
                            return '<td class="' + cls.join(" ") + '"><div class="hw-val ok hw-clickable" onclick="HealthDash.openHW(\'' + escapedSid + '\',\'' + h.key + '\')">' + h.icon + '<span class="hw-total-ok">' + total + '</span></div></td>';
                        }
                        return '<td class="' + cls.join(" ") + '"><div class="hw-val ok">\u2014</div></td>';
                    }
                    if (bad > 0) return '<td class="' + cls.join(" ") + '"><div class="hw-val issue" onclick="HealthDash.openHW(\'' + escapedSid + '\',\'' + h.key + '\')">' + h.icon + '<span class="hw-count">' + bad + '</span></div></td>';
                    return '<td class="' + cls.join(" ") + '"><div class="hw-val ok">\u2014</div></td>';
                }).join("");
                tr.innerHTML = '<td><div class="stn-col"><div class="zone">' + esc(stn.zone) + ' \u203A ' + esc(stn.division) + '</div><div class="stn">' + esc(stn.stationName) + '</div><div class="sid">ID: ' + esc(stn.siteId) + (stn._updatedAt ? " \u00B7 " + new Date(stn._updatedAt).toLocaleTimeString() : "") + '</div></div></td>' + svcCells + hwCells + '<td><button class="wrench-btn ' + (fixes.length ? "has-act" : "") + '" onclick="HealthDash.openWrench(\'' + escapedSid + '\')" title="Fix Actions"><svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg></button></td>';
                tb.appendChild(tr);
            });
        }
        } // end activeView === "live"
        window._healthEv = ev;
        restoreLog();
    }

    // ===== SERVICE DETAIL MODAL =====
    function buildConnectionDetailHtml(rawPayload) {
        if (!rawPayload || !Array.isArray(rawPayload.connections)) return "";
        var html = '<div class="m-sec"><div class="m-sec-t">Connection Details</div><div class="conn-table-wrap">';
        html += '<table class="conn-tbl"><thead><tr><th>Name</th><th>Transport</th><th>Role</th><th>Connected</th><th>Last Activity</th><th>Reconnects</th><th>Disconnects</th></tr></thead><tbody>';
        rawPayload.connections.forEach(function (c) {
            html += '<tr>';
            html += '<td>' + esc(c.name || "") + '</td>';
            html += '<td>' + esc(c.transport || "") + '</td>';
            html += '<td>' + esc(c.role || "") + '</td>';
            html += '<td class="' + (c.connected ? "conn-ok" : "conn-bad") + '">' + (c.connected ? "Yes" : "No") + '</td>';
            html += '<td>' + (c.lastActivityAgeSec !== undefined ? num(c.lastActivityAgeSec) + "s" : "\u2014") + '</td>';
            html += '<td>' + num(c.reconnectAttempts) + '</td>';
            html += '<td>' + num(c.disconnectCount) + '</td>';
            html += '</tr>';
        });
        html += '</tbody></table></div></div>';

        // Exceptions section
        var exc = safeObj(rawPayload.exceptions);
        if (exc.total !== undefined) {
            html += '<div class="m-sec"><div class="m-sec-t">Exceptions</div><div class="m-metrics">';
            html += '<div class="m-met"><div class="ml">Total</div><div class="mv' + (num(exc.total) > 5000 ? " bad" : "") + '">' + num(exc.total).toLocaleString() + '</div></div>';
            html += '<div class="m-met"><div class="ml">Rate/min</div><div class="mv' + (num(exc.ratePerMin) > 100 ? " warn" : "") + '">' + num(exc.ratePerMin) + '</div></div>';
            ["api", "ws", "mqtt", "broadcast", "processing", "snapshot"].forEach(function (k) {
                if (exc[k] !== undefined) html += '<div class="m-met"><div class="ml">' + k.toUpperCase() + '</div><div class="mv">' + num(exc[k]) + '</div></div>';
            });
            html += '</div></div>';
        }

        // Runtime section
        var rt = safeObj(rawPayload.runtime);
        var proc = safeObj(rt.process);
        var caches = safeObj(rt.caches);
        if (Object.keys(proc).length > 0) {
            html += '<div class="m-sec"><div class="m-sec-t">Runtime \u2014 Process</div><div class="runtime-grid">';
            var procFields = [
                { k: "workingSetMb", l: "Working Set" }, { k: "privateBytesMb", l: "Private Bytes" },
                { k: "gcHeapMb", l: "GC Heap" }, { k: "cpuPct", l: "CPU %" },
                { k: "threadCount", l: "Threads" }, { k: "handleCount", l: "Handles" },
                { k: "threadPoolWorkerBusy", l: "TP Busy" }, { k: "threadPoolWorkerQueued", l: "TP Queued" }
            ];
            procFields.forEach(function (pf) {
                if (proc[pf.k] !== undefined) {
                    var unit = pf.k.indexOf("Mb") >= 0 ? " MB" : pf.k === "cpuPct" ? "%" : "";
                    html += '<div class="rt-item"><div class="rt-label">' + pf.l + '</div><div class="rt-val">' + num(proc[pf.k]) + unit + '</div></div>';
                }
            });
            html += '</div></div>';
        }
        if (Object.keys(caches).length > 0 && num(caches.totalEntries) > 0) {
            html += '<div class="m-sec"><div class="m-sec-t">Runtime \u2014 Caches (' + num(caches.totalEntries) + ' entries)</div><div class="runtime-grid">';
            Object.keys(caches).forEach(function (ck) {
                if (ck !== "totalEntries" && num(caches[ck]) > 0) html += '<div class="rt-item"><div class="rt-label">' + esc(ck) + '</div><div class="rt-val">' + num(caches[ck]) + '</div></div>';
            });
            html += '</div></div>';
        }
        return html;
    }

    function openSvc(sid, idx) {
        var e = window._healthEv.find(function (d) { return String(d.st.siteId) === String(sid); }); if (!e) return;
        var svc = e.svcs[idx], sc = svc.status === "healthy" ? "g" : svc.status === "warning" || svc.status === "unknown" ? "a" : "r";
        var m = document.getElementById("mo"), o = document.getElementById("ov");

        // Find the raw payload for detailed view
        var rawKey = null;
        if (svc.key === "DataRecv") rawKey = "dataReceiverHealth";
        else if (svc.key === "Datalogger") rawKey = "dataloggerHeartbeat";
        else if (svc.key === "Alert") rawKey = "alertHealth";
        else if (svc.key === "Debouncer") rawKey = "debouncerHealth";
        else if (svc.key === "Point") rawKey = "pointHealth";
        var rawPayload = (e.st._rawPayloads || {})[rawKey] || null;

        var html = '<div class="modal-hdr"><h3>' + svc.icon + ' ' + esc(svc.label) + ' \u2014 ' + esc(e.st.stationName) + ' <span class="sbadge ' + sc + '">' + esc(svc.status) + '</span></h3>';
        html += '<button class="modal-close" onclick="HealthDash.closeModal()">&times;</button></div>';
        html += '<div class="modal-body">';

        // Connections summary
        html += '<div class="m-sec"><div class="m-sec-t">Connections</div><div class="m-conns">';
        if (svc.conns.length) {
            svc.conns.forEach(function (c) {
                html += '<div class="m-conn"><span class="cd ' + (c.ok ? "on" : "off") + '"></span><span>' + esc(c.l) + '</span>';
                if (c.transport) html += '<span class="conn-detail">' + esc(c.transport) + '</span>';
                html += '</div>';
            });
        } else {
            html += '<div class="m-conn"><span>No packet received</span></div>';
        }
        html += '</div></div>';

        // Metrics
        html += '<div class="m-sec"><div class="m-sec-t">Metrics</div><div class="m-metrics">';
        Object.keys(svc.metrics || {}).forEach(function (k) { html += '<div class="m-met"><div class="ml">' + esc(k).replace(/_/g, " ") + '</div><div class="mv">' + esc(svc.metrics[k]) + '</div></div>'; });
        html += '</div></div>';

        // Detailed connection table + exceptions + runtime (if new format payload exists)
        if (rawPayload) html += buildConnectionDetailHtml(rawPayload);

        // Issues
        if (svc.issues.length) {
            html += '<div class="m-sec"><div class="m-sec-t">Issues (' + svc.issues.length + ')</div><div class="m-issues">';
            svc.issues.forEach(function (i) { html += '<div class="m-issue sev-' + esc(i.sev) + '">' + esc(i.msg) + '</div>'; });
            html += '</div></div>';
        } else {
            html += '<div style="text-align:center;color:var(--tx3);padding:20px">\u2705 No issues</div>';
        }
        html += '</div>';
        m.innerHTML = html;
        m.classList.add("open"); o.classList.add("open");
    }

    function openHW(sid, type) {
        var stn = stations.find(function (s) { return String(s.siteId) === String(sid); }); if (!stn) return;
        var hw = safeObj(stn.hardware[type]); var info = HW_ORDER.find(function (h) { return h.key === type; });
        var m = document.getElementById("mo"), o = document.getElementById("ov");
        var html = '<div class="modal-hdr"><h3>' + esc(info.label) + ' \u2014 ' + esc(stn.stationName) + '</h3><button class="modal-close" onclick="HealthDash.closeModal()">&times;</button></div>';
        html += '<div class="modal-body">';

        // Summary cards
        html += '<div class="m-sec"><div class="m-sec-t">Summary</div><div class="m-metrics">';
        html += '<div class="m-met"><div class="ml">Total</div><div class="mv">' + num(hw.total) + '</div></div>';
        html += '<div class="m-met"><div class="ml">Unhealthy</div><div class="mv bad">' + num(hw.unhealthy) + '</div></div>';
        html += '<div class="m-met"><div class="ml">Healthy</div><div class="mv" style="color:var(--grn)">' + (num(hw.total) - num(hw.unhealthy)) + '</div></div>';
        html += '</div></div>';

        // ===== SENSOR DETAIL with per-attribute alerts =====
        if (type === "sensors") {
            var summary = sensorHealthSummary[String(stn.siteId)];
            if (summary && summary.details.length > 0) {
                // Count breakdowns
                html += '<div class="m-sec"><div class="m-sec-t">Sensor Health Breakdown</div>';
                html += '<div class="m-metrics" style="margin-bottom:12px">';
                html += '<div class="m-met"><div class="ml">Unhealthy (Dead)</div><div class="mv bad">' + summary.unhealthy + '</div></div>';
                html += '<div class="m-met"><div class="ml">Warning</div><div class="mv warn">' + summary.warning + '</div></div>';
                html += '<div class="m-met"><div class="ml">Healthy</div><div class="mv" style="color:var(--grn)">' + summary.healthy + '</div></div>';
                html += '</div>';

                // Group details by asset
                var byAsset = {};
                summary.details.forEach(function (d) {
                    var ak = d.assetId;
                    if (!byAsset[ak]) byAsset[ak] = { assetName: d.assetName, assetId: d.assetId, sensors: [] };
                    byAsset[ak].sensors.push(d);
                });

                Object.keys(byAsset).forEach(function (ak) {
                    var asset = byAsset[ak];
                    html += '<div class="sensor-asset-group">';
                    html += '<div class="sensor-asset-hdr">' +
                        '<span class="sensor-asset-name">' + esc(asset.assetName) + '</span>' +
                        '<span class="sensor-asset-id">Asset ID: ' + esc(asset.assetId) + '</span>' +
                        '<span class="sensor-asset-badge">' + asset.sensors.length + ' alert' + (asset.sensors.length > 1 ? 's' : '') + '</span>' +
                    '</div>';

                    asset.sensors.forEach(function (sensor) {
                        var sCls = sensor.status === "unhealthy" ? "red" : "amb";
                        var sLabel = sensor.status === "unhealthy" ? "DEAD" : "WARNING";
                        html += '<div class="sensor-item">';
                        html += '<div class="sensor-item-hdr">' +
                            '<span class="sensor-dot ' + sCls + '"></span>' +
                            '<span class="sensor-name">' + esc(sensor.attrAlias || sensor.attrTitle) + '</span>' +
                            '<span class="sensor-attr-id">Attr ID: ' + esc(sensor.attrId) + '</span>' +
                            '<span class="sensor-status-badge ' + sCls + '">' + sLabel + '</span>' +
                        '</div>';

                        // Show each alert for this sensor
                        sensor.alerts.forEach(function (alert) {
                            var parsed = parseAlertIdentifier(alert.alertIdentifier);
                            html += '<div class="sensor-alert-row" onclick="HealthDash.openAlertDetail(' + num(alert.alertId) + ')">';
                            html += '<div class="sensor-alert-desc">' + esc(alert.alertDescription || "") + '</div>';
                            html += '<div class="sensor-alert-meta">';
                            if (alert.priority) html += '<span class="sa-tag ' + (alert.priority === "Critical" ? "red" : "amb") + '">' + esc(alert.priority) + '</span>';
                            if (alert.category) html += '<span class="sa-tag">' + esc(alert.category) + '</span>';
                            if (alert.limitString) html += '<span class="sa-limit">' + esc(alert.limitString) + '</span>';
                            if (alert.timestampSet) html += '<span class="sa-time">' + new Date(alert.timestampSet).toLocaleString() + '</span>';
                            html += '</div></div>';
                        });
                        html += '</div>';
                    });
                    html += '</div>';
                });
                html += '</div>';
            } else if (sensorDataCache[String(stn.siteId)]) {
                html += '<div style="text-align:center;color:var(--grn);padding:16px;font-size:12px">\u2705 All ' + num(hw.total) + ' sensors healthy \u2014 no alerts</div>';
            } else if (sensorDataLoading[String(stn.siteId)]) {
                html += '<div style="text-align:center;color:var(--tx3);padding:16px;font-size:12px">\u23F3 Loading sensor data\u2026</div>';
            } else {
                html += '<div style="text-align:center;color:var(--tx3);padding:16px;font-size:12px">Sensor data not yet loaded for this site. <button class="paste-btn" onclick="HealthDash.loadSiteSensors(' + num(stn.siteId) + ')">Load Now</button></div>';
            }
        }

        // ===== IoT (ADC/A10) DETAIL =====
        if (type === "iot") {
            var cl = cardLineCache[String(stn.siteId)];
            if (cl && cl.adcIds.length > 0) {
                var sAlerts = sensorAlertMap[String(stn.siteId)] || {};
                html += '<div class="m-sec"><div class="m-sec-t">A10 / ADC Device Breakdown (' + cl.adcIds.length + ' devices)</div>';

                cl.adcIds.forEach(function (adcId) {
                    var adcInfo = cl.adcMap[adcId] || {};
                    var adcAttrs = adcInfo.attrs || [];

                    // Collect alerts for this ADC's attributes
                    var adcAlertList = [];
                    adcAttrs.forEach(function (attr) {
                        Object.keys(sAlerts).forEach(function (sensorKey) {
                            if (sensorKey.split("_")[1] === String(attr.attrId) || sensorKey === String(attr.attrId)) {
                                adcAlertList = adcAlertList.concat(sAlerts[sensorKey]);
                            }
                        });
                    });

                    var hasDead = adcAlertList.some(function (a) { return String(a.alertIdentifier || "").toLowerCase().indexOf("dead") >= 0; });
                    var adcCls = adcAlertList.length > 0 ? (hasDead ? "red" : "amb") : "grn";

                    html += '<div class="sensor-asset-group">';
                    html += '<div class="sensor-asset-hdr">';
                    html += '<span class="sensor-dot ' + adcCls + '" style="margin-right:4px"></span>';
                    html += '<span class="sensor-asset-name">A10 #' + esc(adcInfo.adcNumber || adcId) + '</span>';
                    html += '<span class="sensor-asset-id">ADC ID: ' + esc(adcId) + ' &middot; ' + esc(adcInfo.locationName || "") + ' &middot; Cluster: ' + esc(adcInfo.clusterName || "") + '</span>';
                    if (adcAlertList.length > 0) html += '<span class="sensor-asset-badge">' + adcAlertList.length + ' alert' + (adcAlertList.length > 1 ? "s" : "") + '</span>';
                    html += '</div>';

                    // Show mapped sensors
                    if (adcAttrs.length > 0) {
                        html += '<div style="padding:6px 14px;font-size:10px;color:var(--tx3)">' + adcAttrs.length + ' sensor(s): ';
                        html += adcAttrs.map(function (a) { return esc(a.assetName) + '/' + esc(a.attrName); }).join(', ');
                        html += '</div>';
                    }

                    if (adcAlertList.length > 0) {
                        adcAlertList.forEach(function (alert) {
                            html += '<div class="sensor-alert-row" onclick="HealthDash.openAlertDetail(' + num(alert.alertId) + ')">';
                            html += '<div class="sensor-alert-desc">' + esc(alert.alertDescription || "") + '</div>';
                            html += '<div class="sensor-alert-meta">';
                            if (alert.priority) html += '<span class="sa-tag ' + (alert.priority === "Critical" ? "red" : "amb") + '">' + esc(alert.priority) + '</span>';
                            if (alert.category) html += '<span class="sa-tag">' + esc(alert.category) + '</span>';
                            if (alert.limitString) html += '<span class="sa-limit">' + esc(alert.limitString) + '</span>';
                            if (alert.timestampSet) html += '<span class="sa-time">' + new Date(alert.timestampSet).toLocaleString() + '</span>';
                            html += '</div></div>';
                        });
                    } else {
                        html += '<div style="padding:8px 14px;font-size:11px;color:var(--grn)">\u2705 Healthy</div>';
                    }
                    html += '</div>';
                });
                html += '</div>';
            } else if (!cl) {
                html += '<div style="text-align:center;color:var(--tx3);padding:16px;font-size:12px">CardLine data not loaded. <button class="paste-btn" onclick="HealthDash.loadSiteSensors(' + num(stn.siteId) + ')">Load Now</button></div>';
            } else {
                html += '<div style="text-align:center;color:var(--tx3);padding:16px;font-size:12px">No ADC (A10) devices found in CardLine data.</div>';
            }
        }

        // ===== NETWORK (Cluster / Modem) DETAIL =====
        if (type === "network") {
            var cl = cardLineCache[String(stn.siteId)];
            if (cl && cl.clusterIds.length > 0) {
                var sAlerts = sensorAlertMap[String(stn.siteId)] || {};
                html += '<div class="m-sec"><div class="m-sec-t">Cluster / Modem Breakdown (' + cl.clusterIds.length + ' cluster' + (cl.clusterIds.length > 1 ? "s" : "") + ')</div>';

                cl.clusterIds.forEach(function (clustId) {
                    var cInfo = cl.clusterMap[clustId] || {};
                    var clusterAttrs = cInfo.attrs || [];
                    var adcCount = Object.keys(cInfo.adcIds || {}).length;

                    // Collect alerts for this cluster's attributes
                    var clusterAlertList = [];
                    clusterAttrs.forEach(function (attr) {
                        Object.keys(sAlerts).forEach(function (sensorKey) {
                            if (sensorKey.split("_")[1] === String(attr.attrId) || sensorKey === String(attr.attrId)) {
                                sAlerts[sensorKey].forEach(function (a) {
                                    if (clusterAlertList.indexOf(a) < 0) clusterAlertList.push(a);
                                });
                            }
                        });
                    });

                    var hasDead = clusterAlertList.some(function (a) { return String(a.alertIdentifier || "").toLowerCase().indexOf("dead") >= 0; });
                    var mCls = clusterAlertList.length > 0 ? (hasDead ? "red" : "amb") : "grn";

                    html += '<div class="sensor-asset-group">';
                    html += '<div class="sensor-asset-hdr">';
                    html += '<span class="sensor-dot ' + mCls + '" style="margin-right:4px"></span>';
                    html += '<span class="sensor-asset-name">' + esc(cInfo.clusterName || "Cluster " + clustId) + '</span>';
                    html += '<span class="sensor-asset-id">Modem: ' + esc(cInfo.modemId || "?") + ' &middot; v' + esc(cInfo.modemVersion || "?") + ' &middot; ' + adcCount + ' A10(s) &middot; ' + clusterAttrs.length + ' sensor(s)</span>';
                    if (clusterAlertList.length > 0) html += '<span class="sensor-asset-badge">' + clusterAlertList.length + ' alert' + (clusterAlertList.length > 1 ? "s" : "") + '</span>';
                    html += '</div>';

                    if (clusterAlertList.length > 0) {
                        clusterAlertList.forEach(function (alert) {
                            html += '<div class="sensor-alert-row" onclick="HealthDash.openAlertDetail(' + num(alert.alertId) + ')">';
                            html += '<div class="sensor-alert-desc">' + esc(alert.alertDescription || "") + '</div>';
                            html += '<div class="sensor-alert-meta">';
                            if (alert.priority) html += '<span class="sa-tag ' + (alert.priority === "Critical" ? "red" : "amb") + '">' + esc(alert.priority) + '</span>';
                            if (alert.category) html += '<span class="sa-tag">' + esc(alert.category) + '</span>';
                            if (alert.limitString) html += '<span class="sa-limit">' + esc(alert.limitString) + '</span>';
                            if (alert.timestampSet) html += '<span class="sa-time">' + new Date(alert.timestampSet).toLocaleString() + '</span>';
                            html += '</div></div>';
                        });
                    } else {
                        html += '<div style="padding:8px 14px;font-size:11px;color:var(--grn)">\u2705 Healthy</div>';
                    }
                    html += '</div>';
                });
                html += '</div>';
            } else if (!cl) {
                html += '<div style="text-align:center;color:var(--tx3);padding:16px;font-size:12px">CardLine data not loaded. <button class="paste-btn" onclick="HealthDash.loadSiteSensors(' + num(stn.siteId) + ')">Load Now</button></div>';
            } else {
                html += '<div style="text-align:center;color:var(--tx3);padding:16px;font-size:12px">No clusters found in CardLine data.</div>';
            }
        }

        html += '</div>';
        m.innerHTML = html;
        m.classList.add("open"); o.classList.add("open");
    }

    function openWrench(sid) {
        var e = window._healthEv.find(function (d) { return String(d.st.siteId) === String(sid); }); if (!e) return;
        var fixes = getFixActions(e.st, e.svcs);
        var m = document.getElementById("mo"), o = document.getElementById("ov");
        var html = '<div class="modal-hdr"><h3>\uD83D\uDD27 Fix Actions \u2014 ' + esc(e.st.stationName) + '</h3><button class="modal-close" onclick="HealthDash.closeModal()">&times;</button></div>';
        html += '<div class="modal-body">';
        if (fixes.length) {
            fixes.forEach(function (f) { html += '<div class="fix-item"><div class="fi-svc">' + esc(f.svc) + '</div><div class="fi-problem">' + esc(f.problem) + '</div><div class="fi-action">' + esc(f.action) + '</div></div>'; });
        } else {
            html += '<div style="text-align:center;color:var(--tx3);padding:30px">\u2705 No actions needed</div>';
        }
        html += '</div>';
        m.innerHTML = html;
        m.classList.add("open"); o.classList.add("open");
    }

    function openPaste() {
        var m = document.getElementById("mo"), o = document.getElementById("ov");
        var html = '<div class="modal-hdr"><h3>Update Health Data</h3><button class="modal-close" onclick="HealthDash.closeModal()">&times;</button></div>';
        html += '<div class="modal-body"><div class="paste-box"><p>Paste full stations array, single station object, or single service health JSON.</p>';
