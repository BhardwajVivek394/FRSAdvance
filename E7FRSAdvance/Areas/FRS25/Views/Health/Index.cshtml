    function doPaste() {
        var v = document.getElementById("pta").value.trim(); if (!v) return;
        try { mergeHealthPayload(JSON.parse(v), "manual/paste"); closeModal(); }
        catch (e) { alert("Invalid JSON: " + e.message); }
    }
    function closeModal() { var m = document.getElementById("mo"), o = document.getElementById("ov"); if (m) m.classList.remove("open"); if (o) o.classList.remove("open"); }

    // ===== ALERT LIVE API =====
    function parseAlertIdentifier(alertId) {
        var parts = {}; if (!alertId) return parts;
        String(alertId).split("|").forEach(function (seg) {
            var idx = seg.indexOf(":"); if (idx > 0) parts[seg.substring(0, idx).trim()] = seg.substring(idx + 1).trim();
        });
        return parts;
    }

    function getAlertHealthStatus(alertIdentifier) {
        var raw = String(alertIdentifier || "").toLowerCase();
        if (raw.indexOf("dead") >= 0) return "unhealthy";
        if (raw.length > 0) return "warning";
        return "warning";
    }

    function processAlertLiveData(alerts) {
        alertLiveRaw = Array.isArray(alerts) ? alerts : [];
        serviceHealthAlerts = {};

        alertLiveRaw.forEach(function (alert) {
            var sid = alert.siteId || 0;
            var srcId = String(alert.sourceId || "");
            if (SERVICE_HEALTH_IDS.indexOf(srcId) < 0) return; // skip non-service-health alerts

            if (!serviceHealthAlerts[sid]) {
                serviceHealthAlerts[sid] = {};
                SERVICE_HEALTH_IDS.forEach(function (s) { serviceHealthAlerts[sid][s] = { status: "healthy", alerts: [] }; });
            }

            var status = getAlertHealthStatus(alert.alertIdentifier);
            var entry = serviceHealthAlerts[sid][srcId];
            if (!entry) { entry = { status: "healthy", alerts: [] }; serviceHealthAlerts[sid][srcId] = entry; }
            entry.alerts.push(alert);
            // Escalate: unhealthy > warning > healthy
            if (status === "unhealthy") entry.status = "unhealthy";
            else if (status === "warning" && entry.status !== "unhealthy") entry.status = "warning";
        });

        alertLiveLastFetch = new Date();
    }

    function getAlertHealthSummary() {
        var total = { healthy: 0, warning: 0, unhealthy: 0 };
        var siteIds = Object.keys(serviceHealthAlerts);
        // If a site has an entry, check its services; services with no alert entry are healthy
        var allSiteIds = stations.map(function (s) { return String(s.siteId); });
        // Merge: include sites from stations that have no alert entry (all healthy for them)
        allSiteIds.forEach(function (sid) { if (siteIds.indexOf(sid) < 0) siteIds.push(sid); });

        siteIds.forEach(function (sid) {
            var siteAlerts = serviceHealthAlerts[sid] || {};
            SERVICE_HEALTH_IDS.forEach(function (svcId) {
                var entry = siteAlerts[svcId];
                var st = entry ? entry.status : "healthy";
                if (st === "unhealthy") total.unhealthy++;
                else if (st === "warning") total.warning++;
                else total.healthy++;
            });
        });
        return total;
    }

    function getServiceHealthAlertsList() {
        // Return flat list of all service health alerts with parsed details
        var list = [];
        alertLiveRaw.forEach(function (alert) {
            var srcId = String(alert.sourceId || "");
            if (SERVICE_HEALTH_IDS.indexOf(srcId) < 0) return;
            var parsed = parseAlertIdentifier(alert.alertIdentifier);
            list.push({
                siteId: alert.siteId,
                siteName: alert.alertDescription ? alert.alertDescription.split("/")[1] : ("Site " + alert.siteId),
                service: srcId,
                kind: parsed.kind || "unknown",
                rule: parsed.rule || "",
                desc: parsed.desc || alert.alertDescription || "",
                priority: alert.priority || "",
                category: alert.category || "",
                state: alert.alertState || "",
                timestampSet: alert.timestampSet || "",
                timestampUpdated: alert.timestampUpdated || "",
                alertId: alert.alertId,
                status: getAlertHealthStatus(alert.alertIdentifier),
                raw: alert
            });
        });
        return list;
    }

    async function fetchAlertLive() {
        var siteId = selectedHealthSiteId();
        try {
            var url = ALERT_LIVE_URL + "?siteId=" + encodeURIComponent(siteId || 0);
            var r = await fetch(url, { credentials: "same-origin" });
            if (!r.ok) throw new Error("HTTP " + r.status);
            var data = await r.json();
            processAlertLiveData(data);
            log("AlertLive fetched: " + alertLiveRaw.length + " alerts, " + getServiceHealthAlertsList().length + " service health", "sys");
            // After alerts arrive, recompute sensor health for all cached sites
            crossReferenceSensorAlerts();
            render();
        } catch (e) {
            log("AlertLive fetch failed: " + e.message, "err");
        }
    }

    // ===== SENSOR HEALTH: Fetch asset metadata for a site =====
    async function fetchSensorDataForSite(siteId) {
        if (!siteId || siteId <= 0) return;
        if (sensorDataLoading[siteId]) return;
        sensorDataLoading[siteId] = true;
        try {
            var r = await fetch(SITE_ASSETS_URL, {
                method: "POST",
                credentials: "same-origin",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "siteId=" + encodeURIComponent(siteId)
            });
            if (!r.ok) throw new Error("HTTP " + r.status);
            var data = await r.json();
            if (data.success && Array.isArray(data.mAssets)) {
                var assets = data.mAssets;
                var sensorMap = {};   // { "assetId_attrId": { assetId, assetName, attrId, attrTitle, attrAlias, assetTypeId } }
                var totalSensors = 0;

                assets.forEach(function (asset) {
                    var attrs = asset.assetAttributes || [];
                    attrs.forEach(function (attr) {
                        var key = asset.Id + "_" + attr.Id;
                        sensorMap[key] = {
                            assetId: asset.Id,
                            assetName: asset.Name || asset.AssetName || ("Asset " + asset.Id),
                            attrId: attr.Id,
                            attrTitle: attr.Title || "",
                            attrAlias: attr.AliasName || "",
                            assetTypeId: attr.AssetTypeId || asset.AssetTypeId,
                            minValue: attr.MinValue,
                            maxValue: attr.MaxValue
                        };
                        totalSensors++;
                    });
                });

                sensorDataCache[siteId] = {
                    assets: assets,
                    totalSensors: totalSensors,
                    sensorMap: sensorMap
                };
                log("Sensor data loaded for site " + siteId + ": " + totalSensors + " sensors", "sys");
            }
        } catch (e) {
            log("Sensor data fetch failed for site " + siteId + ": " + e.message, "err");
        }
        sensorDataLoading[siteId] = false;
    }

    // ===== CARDLINE: Fetch hardware mapping for a site =====
    async function fetchCardLineForSite(siteId) {
        if (!siteId || siteId <= 0) return;
        if (cardLineCache[siteId]) return; // already fetched
        try {
            var r = await fetch(CARDLINE_URL + "?siteId=" + encodeURIComponent(siteId), { credentials: "same-origin" });
            if (!r.ok) throw new Error("HTTP " + r.status);
            var data = await r.json();
            if (data.success && Array.isArray(data.cardLines)) {
                var lines = data.cardLines;

                // ---- IoT: unique ADCId (A10 devices) ----
                var adcMap = {};       // { adcId: { adcNumber, clusterId, clusterName, modemId, attrs:[] } }

                // ---- Network: unique ClusterId (cluster = modem unit) ----
                var clusterMap = {};   // { clusterId: { clusterName, modemId, modemVersion, adcIds:[], attrs:[] } }

                // ---- Mappings ----
                var attrToAdc = {};    // attributeId → adcId
                var attrToCluster = {};// attributeId → clusterId

                lines.forEach(function (cl) {
                    var adcId     = cl.ADCId;
                    var adcNum    = cl.ADCNumber;
                    var modemId   = cl.ModemId   || "";
                    var modemVer  = cl.ModemVersion;
                    var clusterId = cl.ClusterId;
                    var clusterNm = cl.ClusterName || "";
                    var attrId    = cl.AttributeId;
                    var assetId   = cl.AssetId;
                    var assetName = cl.AssetName || "";
                    var attrName  = cl.AttributeName || "";
                    var locName   = cl.LocationName || "";

                    // Build ADC (IoT) index
                    if (adcId !== null && adcId !== undefined && adcId !== 0) {
                        if (!adcMap[adcId]) {
                            adcMap[adcId] = {
                                adcId: adcId,
                                adcNumber: adcNum,
                                clusterId: clusterId,
                                clusterName: clusterNm,
                                modemId: modemId,
                                locationName: locName,
                                attrs: []
                            };
                        }
                        adcMap[adcId].attrs.push({ attrId: attrId, assetId: assetId, assetName: assetName, attrName: attrName });
                    }

                    // Build Cluster (Network) index
                    if (clusterId !== null && clusterId !== undefined && clusterId !== 0) {
                        if (!clusterMap[clusterId]) {
                            clusterMap[clusterId] = {
                                clusterId: clusterId,
                                clusterName: clusterNm,
                                modemId: modemId,
                                modemVersion: modemVer,
                                adcIds: {},
                                attrs: []
                            };
                        }
                        if (adcId) clusterMap[clusterId].adcIds[adcId] = true;
                        clusterMap[clusterId].attrs.push({ attrId: attrId, assetId: assetId, assetName: assetName, attrName: attrName });
                    }

                    // Attribute → ADC / Cluster mapping
                    if (attrId !== null && attrId !== undefined) {
                        if (adcId) attrToAdc[attrId] = adcId;
                        if (clusterId) attrToCluster[attrId] = clusterId;
                    }
                });

                var adcIds = Object.keys(adcMap);
                var clusterIds = Object.keys(clusterMap);

                cardLineCache[siteId] = {
                    cardLines: lines,
                    adcMap: adcMap,
                    clusterMap: clusterMap,
                    adcIds: adcIds,
                    clusterIds: clusterIds,
                    attrToAdc: attrToAdc,
                    attrToCluster: attrToCluster
                };
                log("CardLine loaded for site " + siteId + ": " + adcIds.length + " ADCs (IoT), " + clusterIds.length + " clusters (Network), " + lines.length + " lines", "sys");
            }
        } catch (e) {
            log("CardLine fetch failed for site " + siteId + ": " + e.message, "err");
        }
    }

    // Fetch sensor + cardline data for all known stations
    async function fetchAllSensorData() {
        var siteIds = stations.map(function (s) { return parseInt(s.siteId, 10) || 0; }).filter(function (id) { return id > 0; });
        // Deduplicate
        siteIds = siteIds.filter(function (id, i) { return siteIds.indexOf(id) === i; });

        for (var i = 0; i < siteIds.length; i++) {
            if (!sensorDataCache[siteIds[i]]) await fetchSensorDataForSite(siteIds[i]);
            if (!cardLineCache[siteIds[i]]) await fetchCardLineForSite(siteIds[i]);
        }
        crossReferenceSensorAlerts();
        render();
    }

    // ===== SENSOR HEALTH: Cross-reference alerts with sensor data =====
    function crossReferenceSensorAlerts() {
        sensorAlertMap = {};
        sensorHealthSummary = {};

        // Build per-site alert lookup keyed by assetId_attributeId
        alertLiveRaw.forEach(function (alert) {
            var sid = String(alert.siteId || 0);
            var attrId = alert.attributeId;
            var assetId = alert.assetId;
            var srcId = String(alert.sourceId || "");

            // Skip service-level health alerts (handled elsewhere)
            if (SERVICE_HEALTH_IDS.indexOf(srcId) >= 0) return;

            // Must have attributeId to be a sensor/hardware alert
            if (!attrId && attrId !== 0) return;

            if (!sensorAlertMap[sid]) sensorAlertMap[sid] = {};
            var key = (assetId || 0) + "_" + attrId;
            if (!sensorAlertMap[sid][key]) sensorAlertMap[sid][key] = [];
            sensorAlertMap[sid][key].push(alert);
        });

        // Build summary per site
        var allSiteIds = Object.keys(sensorDataCache);
        allSiteIds.forEach(function (sid) {
            var cache = sensorDataCache[sid];
            if (!cache) return;
            var sMap = cache.sensorMap;
            var sAlerts = sensorAlertMap[sid] || {};
            var total = cache.totalSensors;
            var unhealthy = 0, warning = 0, healthy = 0;
            var details = [];

            // ===== SENSOR health =====
            Object.keys(sMap).forEach(function (sensorKey) {
                var sensor = sMap[sensorKey];
                var alerts = sAlerts[sensorKey] || [];
                var status = "healthy";
                var matchedAlerts = [];

                alerts.forEach(function (a) {
                    var identifier = String(a.alertIdentifier || "").toLowerCase();
                    matchedAlerts.push(a);
                    if (identifier.indexOf("dead") >= 0) {
                        status = "unhealthy";
                    } else if (status !== "unhealthy") {
                        status = "warning";
                    }
                });

                if (status === "unhealthy") unhealthy++;
                else if (status === "warning") warning++;
                else healthy++;

                if (matchedAlerts.length > 0) {
                    details.push({
                        sensorKey: sensorKey,
                        assetId: sensor.assetId,
                        assetName: sensor.assetName,
                        attrId: sensor.attrId,
                        attrTitle: sensor.attrTitle,
                        attrAlias: sensor.attrAlias,
                        status: status,
                        alerts: matchedAlerts
                    });
                }
            });

            sensorHealthSummary[sid] = {
                total: total,
                healthy: healthy,
                warning: warning,
                unhealthy: unhealthy,
                details: details.sort(function (a, b) {
                    var order = { unhealthy: 0, warning: 1, healthy: 2 };
                    return (order[a.status] || 2) - (order[b.status] || 2);
                })
            };

            // ===== IoT (ADC/A10) & Network (Cluster/Modem) health from CardLine =====
            var cl = cardLineCache[sid];
            var iotTotal = 0, iotUnhealthy = 0, iotWarning = 0, iotIssues = [];
            var netTotal = 0, netUnhealthy = 0, netWarning = 0, netIssues = [];

            if (cl) {
                iotTotal = cl.adcIds.length;
                netTotal = cl.clusterIds.length;

                // ---- Group alerts by ADC (IoT) ----
                var adcAlerts = {};
                cl.adcIds.forEach(function (id) { adcAlerts[id] = { dead: false, warn: false, alerts: [] }; });

                // ---- Group alerts by Cluster (Network) ----
                var clusterAlerts = {};
                cl.clusterIds.forEach(function (id) { clusterAlerts[id] = { dead: false, warn: false, alerts: [] }; });

                // Walk sensor alerts → propagate to ADC and Cluster via CardLine mapping
                Object.keys(sAlerts).forEach(function (sensorKey) {
                    var parts = sensorKey.split("_");
                    var attrId = parts.length > 1 ? parts[1] : parts[0];
                    var alerts = sAlerts[sensorKey];

                    // Map attribute → ADC
                    var adcId = cl.attrToAdc[attrId];
                    if (adcId && adcAlerts[adcId]) {
                        alerts.forEach(function (a) {
                            adcAlerts[adcId].alerts.push(a);
                            var ident = String(a.alertIdentifier || "").toLowerCase();
                            if (ident.indexOf("dead") >= 0) adcAlerts[adcId].dead = true;
                            else adcAlerts[adcId].warn = true;
                        });
                    }

                    // Map attribute → Cluster
                    var clustId = cl.attrToCluster[attrId];
                    if (clustId && clusterAlerts[clustId]) {
                        alerts.forEach(function (a) {
                            // Avoid duplicates if same alert already added via another attr on same cluster
                            if (clusterAlerts[clustId].alerts.indexOf(a) < 0) clusterAlerts[clustId].alerts.push(a);
                            var ident = String(a.alertIdentifier || "").toLowerCase();
                            if (ident.indexOf("dead") >= 0) clusterAlerts[clustId].dead = true;
                            else clusterAlerts[clustId].warn = true;
                        });
                    }
                });

                // Tally IoT health
                cl.adcIds.forEach(function (adcId) {
                    var entry = adcAlerts[adcId];
                    var adcInfo = cl.adcMap[adcId] || {};
                    var label = "A10 #" + (adcInfo.adcNumber || adcId) + " (" + (adcInfo.locationName || "ADC " + adcId) + ")";
                    if (entry.dead) {
                        iotUnhealthy++;
                        iotIssues.push(label + " — sensor(s) dead (" + entry.alerts.length + " alert" + (entry.alerts.length > 1 ? "s" : "") + ")");
                    } else if (entry.warn) {
                        iotWarning++;
                        iotIssues.push(label + " — warning (" + entry.alerts.length + " alert" + (entry.alerts.length > 1 ? "s" : "") + ")");
                    }
                });

                // Tally Network health
                cl.clusterIds.forEach(function (clustId) {
                    var entry = clusterAlerts[clustId];
                    var cInfo = cl.clusterMap[clustId] || {};
                    var label = (cInfo.clusterName || "Cluster " + clustId) + " [Modem " + (cInfo.modemId || "?") + "]";
                    if (entry.dead) {
                        netUnhealthy++;
                        netIssues.push(label + " — sensor(s) dead (" + entry.alerts.length + " alert" + (entry.alerts.length > 1 ? "s" : "") + ")");
                    } else if (entry.warn) {
                        netWarning++;
                        netIssues.push(label + " — warning (" + entry.alerts.length + " alert" + (entry.alerts.length > 1 ? "s" : "") + ")");
                    }
                });
            }

            // Update station hardware data
            var station = stations.find(function (s) { return String(s.siteId) === String(sid); });
            if (station) {
                station.hardware.sensors = {
                    total: total,
                    unhealthy: unhealthy + warning,
                    issues: details.map(function (d) {
                        return d.assetName + " / " + (d.attrAlias || d.attrTitle) + " — " + d.status +
                            (d.alerts.length ? " (" + d.alerts.length + " alert" + (d.alerts.length > 1 ? "s" : "") + ")" : "");
                    })
                };
                station.hardware.iot = {
                    total: iotTotal,
                    unhealthy: iotUnhealthy + iotWarning,
                    issues: iotIssues
                };
                station.hardware.network = {
                    total: netTotal,
                    unhealthy: netUnhealthy + netWarning,
                    issues: netIssues
                };
            }
        });
    }

    function buildSiteAlertMap() {
        // Build map: { siteId: { siteName, services: {svcId: {status, alerts[]}}, allAlerts[], alertCount } }
        var map = {};

        // Seed from stations so sites appear even if they have no alerts
        stations.forEach(function (st) {
            var sid = String(st.siteId);
            if (!map[sid]) {
                map[sid] = { siteName: st.stationName || ("Site " + sid), services: {}, allAlerts: [], alertCount: 0 };
                SERVICE_HEALTH_IDS.forEach(function (s) { map[sid].services[s] = { status: "healthy", alerts: [] }; });
            }
        });

        // Process AlertLive data
        alertLiveRaw.forEach(function (alert) {
            var srcId = String(alert.sourceId || "");
            if (SERVICE_HEALTH_IDS.indexOf(srcId) < 0) return;

            var sid = String(alert.siteId || 0);
            if (!map[sid]) {
                map[sid] = { siteName: "Site " + sid, services: {}, allAlerts: [], alertCount: 0 };
                SERVICE_HEALTH_IDS.forEach(function (s) { map[sid].services[s] = { status: "healthy", alerts: [] }; });
            }

            // Try to get site name from alert description (format: "ServiceName/SiteName ...")
            if (alert.alertDescription && map[sid].siteName === "Site " + sid) {
                var descParts = alert.alertDescription.split("/");
                if (descParts.length > 1) {
                    var nameCandidate = descParts[1].split(" ")[0];
                    if (nameCandidate) map[sid].siteName = nameCandidate;
                }
            }

            var entry = map[sid].services[srcId];
            if (!entry) { entry = { status: "healthy", alerts: [] }; map[sid].services[srcId] = entry; }

            var status = getAlertHealthStatus(alert.alertIdentifier);
            entry.alerts.push(alert);
            if (status === "unhealthy") entry.status = "unhealthy";
            else if (status === "warning" && entry.status !== "unhealthy") entry.status = "warning";

            map[sid].allAlerts.push(alert);
            map[sid].alertCount++;
        });

        return map;
    }

    // ===== MQTT =====
    function getPahoClientConstructor() {
        if (typeof Paho === "undefined") return null;
        if (Paho.MQTT && typeof Paho.MQTT.Client === "function") return Paho.MQTT.Client;
        if (typeof Paho.Client === "function") return Paho.Client;
        return null;
    }
    function getBrokerHost() { return firstDefined(mQTT.MQTTUri, mQTT.Host, mQTT.host, ""); }
    function getBrokerPort() { return parseInt(firstDefined(mQTT.MQTTPort, mQTT.Port, mQTT.port, window.location.protocol === "https:" ? 8084 : 8083), 10); }
    function getBrokerUser() { return firstDefined(mQTT.MQTTUsername, mQTT.Username, mQTT.username, ""); }
    function getBrokerPassword() { return firstDefined(mQTT.MQTTPassword, mQTT.Password, mQTT.password, ""); }

    function connectMqtt() {
        if (mqttConnected && mqttClient) return;
        var Ctor = getPahoClientConstructor();
        if (!Ctor) { log("Paho MQTT library not loaded", "err"); return; }
        var host = getBrokerHost(), port = getBrokerPort();
        if (!host || !port) { log("MQTT detail missing. Check ViewBag.MQTTDetail.", "err"); return; }
        var clientId = "FRS25_HEALTH_" + Date.now() + "_" + Math.floor(Math.random() * 10000);
        mqttClient = new Ctor(host, port, clientId);
        mqttClient.onConnectionLost = function (res) {
            mqttConnected = false; mqttSubscribed = false;
            log("Connection lost: " + (res && res.errorMessage ? res.errorMessage : "Disconnected"), "err");
            render();
        };
        mqttClient.onMessageArrived = function (message) {
            var topic = message.destinationName || "";
            var body = message.payloadString || "";
            log(topic + " => " + body.substring(0, 300), "in");
            try { mergeHealthPayload(JSON.parse(body), topic); }
            catch (e) { log("Invalid health JSON on " + topic + ": " + e.message, "err"); }
        };
        var opts = {
            timeout: 10,
            useSSL: window.location.protocol === "https:",
            cleanSession: true,
            onSuccess: function () { mqttConnected = true; log("Connected to " + host + ":" + port, "sys"); render(); subscribeMqtt(); },
            onFailure: function (err) { mqttConnected = false; log("Connect failed: " + (err && err.errorMessage ? err.errorMessage : JSON.stringify(err)), "err"); render(); }
        };
        var user = getBrokerUser(), pass = getBrokerPassword();
        if (user) opts.userName = user;
        if (pass) opts.password = pass;
        log("Connecting to " + host + ":" + port + "...", "sys");
        mqttClient.connect(opts);
    }

    function disconnectMqtt() {
        try { if (mqttClient && mqttConnected) mqttClient.disconnect(); } catch (e) { }
        mqttConnected = false; mqttSubscribed = false; mqttClient = null; currentSubscribedTopics = [];
        log("Disconnected", "sys"); render();
    }

    async function subscribeMqtt() {
        if (!mqttTopics.length) await refreshHealthMqttTopics(false);
        var topics = mqttTopics.length ? mqttTopics.slice() : getManualTopicList();
        mqttTopic = topics.join(", ");
        if (!mqttConnected || !mqttClient) { log("Connect MQTT first", "err"); return; }
        if (!topics.length) { log("No health topics found. Check Site base path configuration.", "err"); return; }
        try {
            currentSubscribedTopics.forEach(function (topic) { try { mqttClient.unsubscribe(topic); } catch (ignore) { } });
            topics.forEach(function (topic) { mqttClient.subscribe(topic, { qos: 0 }); });
            currentSubscribedTopics = topics.slice();
            mqttSubscribed = true;
            log("Subscribed " + topics.length + " topic(s)", "sys");
            topics.slice(0, 10).forEach(function (topic) { log("SUB " + topic, "sys"); });
            if (topics.length > 10) log("... plus " + (topics.length - 10) + " more topic(s)", "sys");
            render();
        } catch (e) { log("Subscribe failed: " + e.message, "err"); }
    }

    // ===== DEBOUNCER WEBSOCKET =====
    function connectDebouncerWs() {
        if (debouncerWs) return;
        try {
            debouncerWs = new WebSocket(DEBOUNCER_WS_URL);
            debouncerWs.onopen = function () {
                debouncerWsConnected = true;
                log("Debouncer WS connected: " + DEBOUNCER_WS_URL, "sys");
                render();
            };
            debouncerWs.onmessage = function (event) {
                var body = event.data || "";
                log("WS Debouncer => " + body.substring(0, 300), "in");
                try {
                    var payload = JSON.parse(body);
                    // Route through mergeHealthPayload which handles:
                    //   1. Batch wrapper: { MessageType:"Batch", Topic:"debouncerHealth", Messages:["{...}"] }
                    //   2. Direct payload: { siteId:25, siteName:"...", wsConnected:... }
                    // The Topic field inside Batch is used as the topic for inner messages,
                    // and serviceKeyFromTopic maps "debouncerHealth" → services.debouncerHealth
                    mergeHealthPayload(payload, "debouncerHealth");
                } catch (e) { log("Invalid Debouncer WS JSON: " + e.message, "err"); }
            };
            debouncerWs.onclose = function () {
                debouncerWsConnected = false; debouncerWs = null;
                log("Debouncer WS closed. Reconnecting in 5s...", "err");
                render();
                debouncerWsReconnectTimer = setTimeout(connectDebouncerWs, 5000);
            };
            debouncerWs.onerror = function () {
                log("Debouncer WS error", "err");
            };
        } catch (e) {
            log("Debouncer WS connect failed: " + e.message, "err");
            debouncerWsReconnectTimer = setTimeout(connectDebouncerWs, 5000);
        }
    }

    // ===== LOG (debug only) =====
    var logBuffer = [];
    function log(msg, type) {
        var prefix = type === "err" ? "ERR" : type === "in" ? "IN " : type === "out" ? "OUT" : "SYS";
        logBuffer.push(new Date().toLocaleTimeString("en-GB") + " [" + prefix + "] " + msg);
        if (logBuffer.length > 100) logBuffer.shift();
        restoreLog();
    }
    function restoreLog() {
        if (window && window.console && logBuffer.length) window.HealthLastMqttLog = logBuffer.slice();
    }

    // ===== View Switching =====
    function switchView(view) {
        activeView = view;
        render();
    }

    // ===== Alert List Toggle =====
    function toggleSiteAlerts(siteId) {
        var el = document.getElementById("ahrow_" + siteId);
        if (el) el.classList.toggle("collapsed");
    }

    function openAlertDetail(alertId) {
        var alert = alertLiveRaw.find(function (a) { return a.alertId === alertId; });
        if (!alert) return;
        var m = document.getElementById("mo"), o = document.getElementById("ov");
        var parsed = parseAlertIdentifier(alert.alertIdentifier);
        var html = '<div class="modal-hdr"><h3>\u26A0\uFE0F Alert Detail \u2014 ' + esc(alert.sourceId) + '</h3><button class="modal-close" onclick="HealthDash.closeModal()">&times;</button></div>';
        html += '<div class="modal-body">';
        html += '<div class="m-sec"><div class="m-sec-t">Alert Info</div><div class="m-metrics">';
        var fields = [
            ["Alert ID", alert.alertId], ["Site ID", alert.siteId], ["Source", alert.sourceId],
            ["State", alert.alertState], ["Priority", alert.priority], ["Category", alert.category],
            ["Kind", parsed.kind], ["Rule", parsed.rule]
        ];
        fields.forEach(function (f) { if (f[1]) html += '<div class="m-met"><div class="ml">' + esc(f[0]) + '</div><div class="mv">' + esc(f[1]) + '</div></div>'; });
        html += '</div></div>';
        html += '<div class="m-sec"><div class="m-sec-t">Description</div><div style="font-size:12px;color:var(--tx2);line-height:1.5">' + esc(alert.alertDescription) + '</div></div>';
        html += '<div class="m-sec"><div class="m-sec-t">Timestamps</div><div class="m-metrics">';
        ["timestampSet", "timestampAck", "timestampReset", "timestampCompleted", "timestampUpdated"].forEach(function (ts) {
            if (alert[ts]) html += '<div class="m-met"><div class="ml">' + esc(ts.replace("timestamp", "")) + '</div><div class="mv" style="font-size:11px">' + new Date(alert[ts]).toLocaleString() + '</div></div>';
        });
        html += '</div></div>';
        // Show all non-null fields
        html += '<div class="m-sec"><div class="m-sec-t">All Fields</div><div class="m-metrics">';
        Object.keys(alert).forEach(function (k) {
            if (alert[k] !== null && alert[k] !== undefined && alert[k] !== "") {
                html += '<div class="m-met"><div class="ml">' + esc(k) + '</div><div class="mv" style="font-size:11px;word-break:break-all">' + esc(alert[k]) + '</div></div>';
            }
        });
        html += '</div></div>';
        html += '</div>';
        m.innerHTML = html;
        m.classList.add("open"); o.classList.add("open");
    }

    // ===== PUBLIC API =====
    window.HealthDash = {
        openSvc: openSvc, openHW: openHW, openWrench: openWrench,
        openPaste: openPaste, doPaste: doPaste, closeModal: closeModal,
        toggleMqtt: function () { mqttConnected ? disconnectMqtt() : connectMqtt(); },
        subscribeMqtt: subscribeMqtt,
        switchView: switchView,
        toggleSiteAlerts: toggleSiteAlerts,
        openAlertDetail: openAlertDetail,
        loadSiteSensors: function (siteId) {
            Promise.all([
                fetchSensorDataForSite(siteId),
                fetchCardLineForSite(siteId)
            ]).then(function () {
                crossReferenceSensorAlerts();
                render();
                // Re-open the modal
                openHW(String(siteId), "sensors");
            });
        }
    };

    // ===== INIT =====
    refreshHealthMqttTopics(false).then(function () {
        connectMqtt();
        connectDebouncerWs();
        // Fetch sensor data for all known sites after topics load
        setTimeout(fetchAllSensorData, 1000);
    });
    fetchAlertLive();
    setInterval(fetchAlertLive, ALERT_LIVE_POLL_MS);
    // Re-fetch sensor data periodically (every 5 min) for new sites
    setInterval(function () { fetchAllSensorData(); }, 300000);
    render();
    setInterval(function () { var t = document.getElementById("timer"); if (t) t.textContent = Math.floor((Date.now() - lastRefresh) / 1000) + "s"; }, 1000);

    if (CONFIG.API_URL) {
        var poll = async function () {
            try { var r = await fetch(CONFIG.API_URL); if (r.ok) { mergeHealthPayload(await r.json(), "api"); } }
            catch (e) { log("API poll failed: " + e.message, "err"); }
        };
        poll(); setInterval(poll, CONFIG.POLL_INTERVAL_MS);
    }
})();
</script>
