    MultiSelect.prototype.getSelected = function () { return Object.keys(this.selected); };
    function closeAllMultiSelects() {
        document.querySelectorAll(".msel.open").forEach(function (el) { el.classList.remove("open"); });
    }
    document.addEventListener("click", closeAllMultiSelects);

    // ---- persistent filter bar (built once, re-mounted on each render so
    //      open dropdowns / typed search survive frequent MQTT re-renders) ----
    var msZone = null, msDiv = null, msSite = null, filterBarEl = null;
    function buildFilterBar() {
        filterBarEl = document.createDocumentFragment();
        var mk = function (labelText) {
            var wrap = document.createElement("label");
            wrap.textContent = labelText;
            filterBarEl.appendChild(wrap);
        };
        mk("Zone");
        msZone = new MultiSelect({ allLabel: "All Zones", onChange: function () { onFiltersChanged("zone"); } });
        filterBarEl.appendChild(msZone.root);
        mk("Division");
        msDiv = new MultiSelect({ allLabel: "All Divisions", onChange: function () { onFiltersChanged("division"); } });
        filterBarEl.appendChild(msDiv.root);
        mk("Site");
        msSite = new MultiSelect({ allLabel: "All Sites", onChange: function () { onFiltersChanged("site"); } });
        filterBarEl.appendChild(msSite.root);
        var search = document.createElement("input");
        search.className = "search-box"; search.id = "fS"; search.placeholder = "Search station\u2026";
        var stimer;
        search.oninput = function (e) { clearTimeout(stimer); stimer = setTimeout(function () { filterSearch = e.target.value; render(); loadVisibleDeviceStatus(); }, 250); };
        filterBarEl.appendChild(search);
        msZone.setItems(masterZones);
        msDiv.setItems(divisionOptions);
        msSite.setItems(siteOptions);
        // Wrap fragment children into a persistent container element
        var host = document.createElement("div");
        host.style.display = "contents";
        host.appendChild(filterBarEl);
        filterBarEl = host;
    }
    function mountFilterBar() {
        var hostSlot = document.getElementById("filterHost");
        if (!hostSlot) return;
        if (!filterBarEl) buildFilterBar();
        hostSlot.appendChild(filterBarEl);
        // Restore focus + caret captured at the start of render()
        if (_filterFocusEl) {
            try {
                _filterFocusEl.focus({ preventScroll: true });
                if (_filterSelStart !== null && typeof _filterFocusEl.setSelectionRange === "function") {
                    _filterFocusEl.setSelectionRange(_filterSelStart, _filterSelEnd);
                }
            } catch (focusErr) { }
            _filterFocusEl = null; _filterSelStart = _filterSelEnd = null;
        }
    }

    async function rebuildDivisionOptions() {
        if (!filterZoneIds.length) { divisionOptions = masterDivisions.slice(); return; }
        var lists = await Promise.all(filterZoneIds.map(async function (zid) {
            if (divisionsByZone[zid]) return divisionsByZone[zid];
            try {
                var r = await fetch(DIVISION_URL + "?zoneId=" + encodeURIComponent(zid), { credentials: "same-origin" });
                if (!r.ok) throw new Error("HTTP " + r.status);
                var data = mapApiSelectItems(await r.json());
                divisionsByZone[zid] = data;
                return data;
            } catch (e) { log("Division bind failed (zone " + zid + "): " + e.message, "err"); return []; }
        }));
        var seen = {}; divisionOptions = [];
        lists.forEach(function (l) { l.forEach(function (d) { if (!seen[String(d.Id)]) { seen[String(d.Id)] = 1; divisionOptions.push(d); } }); });
    }
    async function rebuildSiteOptions() {
        // Site options follow the selected divisions; if none are selected but
        // zones are, they follow every division of those zones.
        var divIds = filterDivisionIds.length ? filterDivisionIds
            : (filterZoneIds.length ? divisionOptions.map(function (d) { return String(d.Id); }) : []);
        if (!divIds.length) { siteOptions = masterSites.slice(); return; }
        var lists = await Promise.all(divIds.map(async function (did) {
            if (sitesByDivision[did]) return sitesByDivision[did];
            try {
                var r = await fetch(SITE_URL + "?divisionId=" + encodeURIComponent(did), { credentials: "same-origin" });
                if (!r.ok) throw new Error("HTTP " + r.status);
                var data = mapApiSelectItems(await r.json());
                sitesByDivision[did] = data;
                return data;
            } catch (e) { log("Site bind failed (division " + did + "): " + e.message, "err"); return []; }
        }));
        var seen = {}; siteOptions = [];
        lists.forEach(function (l) { l.forEach(function (s) { if (!seen[String(s.Id)]) { seen[String(s.Id)] = 1; siteOptions.push(s); } }); });
    }
    var _filterSeq = 0;
    var _filterDebounceTimer = null;
    var FILTER_DEBOUNCE_MS = 300;   // coalesce rapid checkbox clicks into one fetch cascade
    async function onFiltersChanged(level) {
        filterZoneIds = msZone.getSelected();
        filterDivisionIds = msDiv.getSelected();
        filterSiteIds = msSite.getSelected();
        var seq = ++_filterSeq;
        render(); // instant feedback with current data (table filters client-side immediately)

        // Heavy work (cascading option fetches, MQTT re-subscribe, alert/device
        // refresh) is debounced so ticking several checkboxes quickly only
        // triggers ONE network round-trip instead of one per click.
        if (_filterDebounceTimer) clearTimeout(_filterDebounceTimer);
        _filterDebounceTimer = setTimeout(async function () {
            _filterDebounceTimer = null;
            if (seq !== _filterSeq) return;
            if (level === "zone") {
                await rebuildDivisionOptions();
                if (seq !== _filterSeq) return;
                msDiv.setItems(divisionOptions);
                filterDivisionIds = msDiv.getSelected();
            }
            if (level === "zone" || level === "division") {
                await rebuildSiteOptions();
                if (seq !== _filterSeq) return;
                msSite.setItems(siteOptions);
                filterSiteIds = msSite.getSelected();
            }
            await refreshHealthMqttTopics(true);
            if (seq !== _filterSeq) return;
            fetchAlertLive();
            reconnectAlertLiveWsForSite();
            loadVisibleDeviceStatus();
            loadVisibleAlertHistory(false);
            render();
        }, FILTER_DEBOUNCE_MS);
    }

    // ===== Topic-to-service mapping =====
    function getSiteId(payload, topic) {
        var p = safeObj(payload);
        var direct = firstDefined(p.siteId, p.SiteId, p.siteID, p.AssetSiteId);
        if (direct) return parseInt(direct, 10) || 0;
        var meta = healthTopicMeta[String(topic || "").replace(/^\/+|\/+$/g, "")];
        if (meta && meta.siteId) return parseInt(meta.siteId, 10) || 0;
        var match = String(topic || "").match(/(?:site|rdpms|health|datareceiver|debouncer|pointServices)[\/\-_]?(\d+)/i) || String(topic || "").match(/\/(\d+)\//);
        return match ? (parseInt(match[1], 10) || 0) : 0;
    }

    // Derive the node (local|cloud) from the topic path. datareceiver/debouncer/
    // pointServices now publish on .../local/health and .../cloud/health, so the
    // path segment identifies the node. Used as a fallback when the payload does
    // not carry an explicit serviceType field.
    function nodeFromTopic(topic) {
        var segs = String(topic || "").toLowerCase().split("/");
        if (segs.indexOf("local") >= 0) return "local";
        if (segs.indexOf("cloud") >= 0 || segs.indexOf("server") >= 0) return "cloud";
        return "";
    }

    function serviceKeyFromTopic(topic, payload) {
        var t = String(topic || "").toLowerCase();
        var p = safeObj(payload);
        var mt = String(firstDefined(p.Topic, p.topic, p.MessageType, "") || "").toLowerCase();
        // New-format payloads identify themselves via a "service" field
        // (e.g. TriggerAlert health -> { service: "TriggerAlert", connections: [...] })
        var svcName = String(firstDefined(p.service, p.Service, p.serviceName, p.ServiceName, "") || "").toLowerCase();
        var all = t + " " + mt + " " + svcName;
        if (all.indexOf("datareceiver") >= 0 || all.indexOf("data-receiver") >= 0 || all.indexOf("datarecv") >= 0) return "dataReceiverHealth";
        if (all.indexOf("dataloggerdiagnostic") >= 0 || all.indexOf("diagnostic") >= 0) return "dataloggerDiagnostic";
        if (all.indexOf("dataloggerheartbeat") >= 0 || all.indexOf("heartbeat") >= 0 || all.indexOf("mqtt/dl/heartbeat") >= 0) return "dataloggerHeartbeat";
        if (all.indexOf("alerthealth") >= 0 || all.indexOf("alert") >= 0) return "alertHealth";
        if (all.indexOf("debouncer/health") >= 0 || all.indexOf("debouncerhealth") >= 0 || all.indexOf("debouncer") >= 0) return "debouncerHealth";
        if (all.indexOf("pointservices") >= 0 || all.indexOf("pointmachinehealth") >= 0 || all.indexOf("pointhealth") >= 0 || all.indexOf("point") >= 0) return "pointHealth";
        return null;
    }

    // ===== Merge incoming health payload =====
    function mergeHealthPayload(payload, topic) {
        if (!payload) return;
        if (Array.isArray(payload)) { payload.forEach(function (x) { mergeHealthPayload(x, topic); }); return; }
        if (Array.isArray(payload.Messages)) {
            payload.Messages.forEach(function (m) {
                try { mergeHealthPayload(typeof m === "string" ? JSON.parse(m) : m, payload.Topic || topic); }
                catch (e) { log("Invalid nested message: " + e.message, "err"); }
            });
            return;
        }

        var siteId = getSiteId(payload, topic) || Date.now();
        var current = stations.find(function (s) { return String(s.siteId) === String(siteId); });
        if (!current) { current = defaultStation(siteId); stations.push(current); }

        current.zoneId = String(firstDefined(payload.zoneId, payload.ZoneId, payload.zoneID, current.zoneId, ""));
        current.divisionId = String(firstDefined(payload.divisionId, payload.DivisionId, payload.divisionID, current.divisionId, ""));
        var topicMeta = healthTopicMeta[String(topic || "").replace(/^\/+|\/+$/g, "")] || {};
        current.zone = str(firstDefined(payload.zone, payload.Zone, (current.zone !== "Unknown" ? current.zone : null), topicMeta.zoneName), "Unknown");
        current.division = str(firstDefined(payload.division, payload.Division, (current.division !== "Unknown" ? current.division : null), topicMeta.divisionName), "Unknown");
        if (!current.zoneId && topicMeta.zoneId) current.zoneId = String(topicMeta.zoneId);
        if (!current.divisionId && topicMeta.divisionId) current.divisionId = String(topicMeta.divisionId);
        current.stationName = str(firstDefined(payload.stationName, payload.SiteName, payload.siteName, payload.StationName, payload.Name, topicMeta.siteName, current.stationName), current.stationName);
        current.siteId = siteId;
        current._topic = topic || current._topic || "";
        current._updatedAt = new Date().toISOString();
        if (!current._rawPayloads) current._rawPayloads = {};
        if (!current._serviceTypes) current._serviceTypes = {};   // { serviceKey: { local: data, cloud: data } }
        if (!current._svcUpdatedAt) current._svcUpdatedAt = {};
        if (!current._svcTypeUpdatedAt) current._svcTypeUpdatedAt = {};

        // Detect serviceType (local / server) from payload - computed ONCE
        var payloadServiceType = String(firstDefined(payload.serviceType, payload.ServiceType, "") || "").toLowerCase();
        if (payloadServiceType === "server") payloadServiceType = "cloud";  // normalize: server -> cloud
        if (payloadServiceType !== "local" && payloadServiceType !== "cloud") payloadServiceType = "";

        // Separate Local/Cloud topics: datareceiver/debouncer/pointServices publish on
        // .../local/health and .../cloud/health. If the payload itself did not declare a
        // serviceType, derive the node from the topic path so per-node cells still bind.
        // (An explicit payload serviceType always wins over the topic-derived value.)
        if (!payloadServiceType) {
            var topicNode = nodeFromTopic(topic);
            if (topicNode) payloadServiceType = topicNode;
        }

        // Stamp "last data received" for a service (and its local/cloud node).
        function touchSvc(svcKey) {
            if (!svcKey) return;
            current._svcUpdatedAt[svcKey] = current._updatedAt;
            if (payloadServiceType) {
                if (!current._svcTypeUpdatedAt[svcKey]) current._svcTypeUpdatedAt[svcKey] = {};
                current._svcTypeUpdatedAt[svcKey][payloadServiceType] = current._updatedAt;
            }
        }

        if (payload.services) current.services = Object.assign({}, current.services, safeObj(payload.services));
        if (payload.hardware) current.hardware = normalizeHardware(Object.assign({}, current.hardware, safeObj(payload.hardware)));

        var directServiceMap = {
            dataReceiverHealth: "dataReceiverHealth",
            dataReceiver: "dataReceiverHealth",
            dataloggerHeartbeat: "dataloggerHeartbeat",
            dataloggerDiagnostic: "dataloggerDiagnostic",
            alertHealth: "alertHealth",
            debouncerHealth: "debouncerHealth",
            debouncer: "debouncerHealth",
            pointHealth: "pointHealth",
            pointMachineHealth: "pointHealth",
            pointServicesHealth: "pointHealth",
            pointServices: "pointHealth"
        };

        Object.keys(directServiceMap).forEach(function (k) {
            if (payload[k]) {
                var targetKey = directServiceMap[k];
                current.services[targetKey] = deepMergePayload(current.services[targetKey], payload[k]);
                current._rawPayloads[targetKey] = current.services[targetKey];
                touchSvc(targetKey);
                // Typed (local / cloud) copy from direct service sub-keys
                if (payloadServiceType) {
                    if (!current._serviceTypes[targetKey]) current._serviceTypes[targetKey] = {};
                    current._serviceTypes[targetKey][payloadServiceType] = deepMergePayload(
                        current._serviceTypes[targetKey][payloadServiceType], payload[k]
                    );
                }
            }
        });

        if (payload.services) {
            Object.keys(directServiceMap).forEach(function (k) {
                if (payload.services[k]) {
                    var targetKey = directServiceMap[k];
                    current.services[targetKey] = deepMergePayload(current.services[targetKey], payload.services[k]);
                    current._rawPayloads[targetKey] = current.services[targetKey];
                    touchSvc(targetKey);
                }
            });
        }

        var mappedKey = serviceKeyFromTopic(topic, payload);
        if (mappedKey && !payload.services && !payload[mappedKey]) {
