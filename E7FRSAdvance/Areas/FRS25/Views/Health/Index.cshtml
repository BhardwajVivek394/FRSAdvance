    var MODEM_GRAPH_URL = '@Url.Action("GetModemHistoryForGraph", "Health", new { area = "FRS25" })';
    var A10_GRAPH_URL = '@Url.Action("GetA10HistoryForGraph", "Health", new { area = "FRS25" })';
    var A10_RECORDS_URL = '@Url.Action("GetA10HistoryRecords", "Health", new { area = "FRS25" })';

    var masterZones = normalizeSelectItems(@Html.Raw(zonesJson));
    var masterDivisions = normalizeSelectItems(@Html.Raw(divisionsJson));
    var masterSites = normalizeSelectItems(@Html.Raw(sitesJson));

    var divisionOptions = masterDivisions.slice();
    var siteOptions = masterSites.slice();

    var stations = [];
    var lastRefresh = Date.now();
    // Multi-select filter state: empty array = "All"
    var filterZoneIds = [], filterDivisionIds = [], filterSiteIds = [], filterSearch = "";
    var divisionsByZone = {}, sitesByDivision = {};   // cascade lookup caches (server fetched, memoised)
    var deviceStatusCache = {};                        // { siteId: { loading, error, ts, modems[] } }
    var currentModal = null;                           // { kind: "svc"|"hw"|"wrench", sid, idx?, type? } - live-refreshed on render
    var _filterFocusEl = null, _filterSelStart = null, _filterSelEnd = null; // search-box focus preservation
    var mqttClient = null, mqttConnected = false, mqttSubscribed = false;
    var mqttTopic = "";
    var mqttTopics = [];
    var currentSubscribedTopics = [];
    var healthTopicMeta = {};

    // ===== Debouncer WebSocket =====
    var debouncerWs = null, debouncerWsConnected = false, debouncerWsReconnectTimer = null;

    // ===== AlertLive API =====
    var ALERT_LIVE_POLL_MS = 30000;
    var SERVICE_HEALTH_IDS = ["DataReceiverHealth", "DebouncerHealth", "PointMachineHealth", "AlertHealth", "DataloggerHealth"];
    var alertLiveRaw = [];          // Full AlertLive response
    var serviceHealthAlerts = {};   // { siteId: { DataReceiverHealth: {status,alert}, ... } }
    var alertLiveLastFetch = null;
    var activeView = "alerts";      // "alerts" | "live"

    // ===== Sensor (Attribute) Health =====
    var sensorDataCache = {};       // { siteId: { assets: [...], totalSensors: N, totalIoT: N, sensorMap: { attrId: {assetId, assetName, attrTitle, attrAlias} } } }
    var sensorAlertMap = {};        // { siteId: { attrKey: [alert, ...] } }  — alerts matched to sensors
    var sensorHealthSummary = {};   // { siteId: { total, healthy, warning, unhealthy, details[] } }
    var sensorDataLoading = {};     // { siteId: true/false }
    var cardLineCache = {};         // { siteId: { cardLines[], adcMap:{}, clusterMap:{}, adcIds:[], clusterIds:[], attrToAdc:{}, attrToCluster:{} } }

    // ===== Utility helpers =====
    function safeObj(x) { return x && typeof x === "object" ? x : {}; }
    function firstDefined() { for (var i = 0; i < arguments.length; i++) if (arguments[i] !== undefined && arguments[i] !== null && arguments[i] !== "") return arguments[i]; return null; }
    function num(v, d) { var n = Number(v); return isFinite(n) ? n : (d || 0); }
    function str(v, d) { return v === undefined || v === null || v === "" ? (d || "\u2014") : String(v); }
    function boolFrom(v) {
        if (typeof v === "boolean") return v;
        if (typeof v === "number") return v === 1;
        var s = String(v || "").toLowerCase();
        return s === "1" || s === "true" || s === "connected" || s === "up" || s.indexOf("1 (") === 0 || s.indexOf("healthy") >= 0;
    }
    function fmtUp(s) { s = num(s, 0); if (!s) return "\u2014"; var d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60); return d + "d " + h + "h " + m + "m"; }
    function esc(v) { return String(v == null ? "" : v).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;"); }
    function normalizeSelectItems(list) { if (!Array.isArray(list)) return []; return list.map(function (x) { return { Id: String(firstDefined(x.Id, x.id, x.Value, x.value, "")), Name: String(firstDefined(x.Name, x.name, x.Text, x.text, "")) }; }).filter(function (x) { return x.Id !== "" || x.Name !== ""; }); }
    function optionName(list, id) { var f = (list || []).find(function (x) { return String(x.Id) === String(id); }); return f ? f.Name : ""; }
    function mapApiSelectItems(data) { return normalizeSelectItems(Array.isArray(data) ? data.map(function (x) { return { Id: firstDefined(x.Id, x.id, x.Value, x.value), Name: firstDefined(x.Name, x.name, x.Text, x.text) }; }) : []); }

    // ===== Default station skeleton =====
    function defaultStation(siteId) {
        return {
            zoneId: "", divisionId: "", zone: "Unknown", division: "Unknown",
            stationName: siteId ? ("Site " + siteId) : "Unknown Site",
            siteId: siteId || 0,
            services: {},
            hardware: { sensors: { total: 0, unhealthy: 0, issues: [] }, iot: { total: 0, unhealthy: 0, issues: [] }, network: { total: 0, unhealthy: 0, issues: [] } },
            _topic: "", _updatedAt: null, _rawPayloads: {}
        };
    }
    function normalizeHardware(hw) {
        hw = safeObj(hw); var out = {};
        HW_ORDER.forEach(function (h) { var x = safeObj(hw[h.key]); out[h.key] = { total: num(firstDefined(x.total, x.Total), 0), unhealthy: num(firstDefined(x.unhealthy, x.Unhealthy, x.issue, x.Issue), 0), issues: Array.isArray(x.issues) ? x.issues : (Array.isArray(x.Issues) ? x.Issues : []) }; });
        return out;
    }

    function isPlainObj(x) { return !!x && typeof x === "object" && !Array.isArray(x); }
    // Deep-merge incoming health payloads: objects merge key-by-key (newest
    // values win), arrays and primitives are replaced. Services that alternate
    // between message shapes (small heartbeat vs full diagnostics) no longer
    // make previously received fields "disappear" from the modal.
    function deepMergePayload(oldVal, newVal) {
        if (!isPlainObj(oldVal) || !isPlainObj(newVal)) return newVal;
        var out = {};
        Object.keys(oldVal).forEach(function (k) { out[k] = oldVal[k]; });
        Object.keys(newVal).forEach(function (k) { out[k] = deepMergePayload(oldVal[k], newVal[k]); });
        return out;
    }

    // ===== Site / Topic resolution =====
    // MQTT topic scope: a single concrete site only when exactly one is selected,
    // otherwise 0 = all sites (display filtering stays client-side).
    function selectedHealthSiteId() { return filterSiteIds.length === 1 ? (parseInt(filterSiteIds[0], 10) || 0) : 0; }

    async function refreshHealthMqttTopics(autoResubscribe) {
        var siteId = selectedHealthSiteId();
        try {
            var r = await fetch(HEALTH_TOPICS_URL + "?siteId=" + encodeURIComponent(siteId), { credentials: "same-origin" });
            if (!r.ok) throw new Error("HTTP " + r.status);
            var json = await r.json();
            var rows = json && json.data ? json.data : [];
            var topics = [];
            healthTopicMeta = {};

            rows.forEach(function (row) {
                var siteIdValue = firstDefined(row.SiteId, row.siteId, "");
                var siteNameValue = firstDefined(row.SiteName, row.siteName, "");
                var basePathValue = firstDefined(row.BasePath, row.basePath, "");
                var zoneIdValue = firstDefined(row.ZoneId, row.zoneId, "");
                var zoneNameValue = firstDefined(row.ZoneName, row.zoneName, "");
                var divisionIdValue = firstDefined(row.DivisionId, row.divisionId, "");
                var divisionNameValue = firstDefined(row.DivisionName, row.divisionName, "");
                var rowTopics = Array.isArray(row.Topics) ? row.Topics : (Array.isArray(row.topics) ? row.topics : []);

                // Backend now returns these topics, but keep this client-side fallback
                // so the dashboard still subscribes correctly if an older controller is deployed.
                var parsedSid = parseInt(siteIdValue, 10) || 0;
                if (parsedSid > 0) {
                    var extraTopics = [
                        "debouncer/" + parsedSid + "/health",
                        "pointServices/" + parsedSid + "/health"
                    ];
                    // The Alert service (TriggerAlert) publishes its health on
                    // {BasePath}/alerthealth (e.g. /DNR/PPTA/alerthealth), so make
                    // sure that topic is always part of the subscription set even
                    // if the backend topic list does not include it.
                    var bp = String(basePathValue || "").replace(/^\/+|\/+$/g, "");
                    if (bp) extraTopics.push(bp + "/alerthealth");
                    extraTopics.forEach(function (extraTopic) {
                        if (rowTopics.indexOf(extraTopic) < 0) rowTopics.push(extraTopic);
                    });
                }

                rowTopics.forEach(function (topic) {
                    if (!topic) return;
                    topic = String(topic).replace(/^\/+|\/+$/g, "");
                    if (topics.indexOf(topic) < 0) topics.push(topic);
                    healthTopicMeta[topic] = {
                        siteId: siteIdValue, siteName: siteNameValue, basePath: basePathValue,
                        zoneId: zoneIdValue, zoneName: zoneNameValue,
                        divisionId: divisionIdValue, divisionName: divisionNameValue
                    };
                });

                if (parsedSid > 0 && !stations.find(function (s) { return String(s.siteId) === String(parsedSid); })) {
                    var placeholder = defaultStation(parsedSid);
                    placeholder.stationName = siteNameValue || placeholder.stationName;
                    placeholder.zoneId = zoneIdValue || "";
                    placeholder.zone = zoneNameValue || optionName(masterZones, zoneIdValue) || "Unknown";
                    placeholder.divisionId = divisionIdValue || "";
                    placeholder.division = divisionNameValue || optionName(masterDivisions.length ? masterDivisions : divisionOptions, divisionIdValue) || "Unknown";
                    stations.push(placeholder);
                }
            });

            mqttTopics = topics;
            mqttTopic = mqttTopics.join(", ");
            log((siteId ? "Selected site" : "All sites") + " health topics loaded: " + mqttTopics.length + ", stations: " + stations.length, "sys");

            if (autoResubscribe && mqttConnected && mqttClient) { subscribeMqtt(); }
            else { render(); }
            // Fetch sensor data for any newly discovered sites
            fetchAllSensorData();
            loadVisibleDeviceStatus();
        } catch (e) {
            mqttTopics = []; mqttTopic = ""; healthTopicMeta = {};
            log("Health topic bind failed: " + e.message, "err");
            render();
        }
    }

    function getManualTopicList() {
        var inp = document.getElementById("mqttTopic");
        var raw = inp && inp.value ? inp.value : mqttTopic;
        return String(raw || "").split(/[\n,]+/).map(function (x) { return x.trim().replace(/^\/+|\/+$/g, ""); }).filter(function (x, i, arr) { return x && arr.indexOf(x) === i; });
    }

    // =====================================================================
    // MULTI-SELECT FILTERS (Zone / Division / Site)
    // Empty selection = "All". Division & Site options cascade from the
    // selected parents using the existing GetDivisionByZoneId /
    // GetSiteByDivisionId endpoints (results memoised per id).
    // =====================================================================
    function MultiSelect(cfg) {
        this.allLabel = cfg.allLabel || "All";
        this.onChange = cfg.onChange || function () { };
        this.items = [];
        this.selected = {};   // id -> true (empty = All)
        this.search = "";
        this.root = document.createElement("div");
        this.root.className = "msel";
        this._build();
    }
    MultiSelect.prototype._build = function () {
        var self = this;
        this.root.innerHTML =
            '<button type="button" class="msel-btn"><span class="msel-label"></span></button>' +
            '<div class="msel-panel">' +
                '<div class="msel-search"><input type="text" placeholder="Search\u2026" /></div>' +
                '<div class="msel-tools"><button type="button" class="ms-all">Select all</button><button type="button" class="ms-clear">Clear (All)</button></div>' +
                '<div class="msel-list"></div>' +
            '</div>';
        this.btn = this.root.querySelector(".msel-btn");
        this.labelEl = this.root.querySelector(".msel-label");
        this.listEl = this.root.querySelector(".msel-list");
        this.searchEl = this.root.querySelector(".msel-search input");
        this.btn.onclick = function (e) {
            e.stopPropagation();
            var open = self.root.classList.contains("open");
            closeAllMultiSelects();
            if (!open) { self.root.classList.add("open"); self.searchEl.focus(); }
        };
        this.root.querySelector(".msel-panel").onclick = function (e) { e.stopPropagation(); };
        this.searchEl.oninput = function () { self.search = this.value; self._renderList(); };
        this.root.querySelector(".ms-all").onclick = function () {
            self._visible().forEach(function (it) { self.selected[String(it.Id)] = true; });
            self._renderList(); self._renderLabel(); self.onChange();
        };
        this.root.querySelector(".ms-clear").onclick = function () {
            self.selected = {}; self._renderList(); self._renderLabel(); self.onChange();
        };
        this._renderLabel(); this._renderList();
    };
    MultiSelect.prototype._visible = function () {
        var q = this.search.toLowerCase();
        return this.items.filter(function (it) { return !q || String(it.Name).toLowerCase().indexOf(q) >= 0; });
    };
    MultiSelect.prototype._renderList = function () {
        var self = this, vis = this._visible();
        if (!vis.length) { this.listEl.innerHTML = '<div class="msel-empty">No options</div>'; return; }
        this.listEl.innerHTML = vis.map(function (it) {
            return '<label class="msel-opt"><input type="checkbox" data-id="' + esc(it.Id) + '"' +
                (self.selected[String(it.Id)] ? " checked" : "") + ' /><span>' + esc(it.Name) + '</span></label>';
        }).join("");
        Array.prototype.forEach.call(this.listEl.querySelectorAll("input[type=checkbox]"), function (cb) {
            cb.onchange = function () {
                var id = String(this.getAttribute("data-id"));
                if (this.checked) self.selected[id] = true; else delete self.selected[id];
                self._renderLabel(); self.onChange();
            };
        });
    };
    MultiSelect.prototype._renderLabel = function () {
        var ids = Object.keys(this.selected);
        if (!ids.length) { this.labelEl.innerHTML = esc(this.allLabel); return; }
        if (ids.length === 1) {
            var it = this.items.find(function (x) { return String(x.Id) === ids[0]; });
            this.labelEl.innerHTML = esc(it ? it.Name : "1 selected"); return;
        }
        this.labelEl.innerHTML = '<span class="msel-count">' + ids.length + '</span>&nbsp;selected';
    };
    MultiSelect.prototype.setItems = function (items) {
        var self = this;
        this.items = items || [];
        var valid = {};
        this.items.forEach(function (it) { valid[String(it.Id)] = true; });
        Object.keys(this.selected).forEach(function (id) { if (!valid[id]) delete self.selected[id]; });
        this._renderList(); this._renderLabel();
    };
    MultiSelect.prototype.getSelected = function () { return Object.keys(this.selected); };
    function closeAllMultiSelects() {
        document.querySelectorAll(".msel.open").forEach(function (el) { el.classList.remove("open"); });
    }
    document.addEventListener("click", closeAllMultiSelects);

    // ---- persistent filter bar (built once, re-mounted on each render so
    //      open dropdowns / typed search survive frequent MQTT re-renders) ----
    var msZone = null, msDiv = null, msSite = null, filterBarEl = null;
    function buildFilterBar() {
        filterBarEl = document.createDocumentFragment();
        var mk = function (labelText) {
            var wrap = document.createElement("label");
            wrap.textContent = labelText;
            filterBarEl.appendChild(wrap);
        };
        mk("Zone");
        msZone = new MultiSelect({ allLabel: "All Zones", onChange: function () { onFiltersChanged("zone"); } });
        filterBarEl.appendChild(msZone.root);
        mk("Division");
        msDiv = new MultiSelect({ allLabel: "All Divisions", onChange: function () { onFiltersChanged("division"); } });
        filterBarEl.appendChild(msDiv.root);
        mk("Site");
        msSite = new MultiSelect({ allLabel: "All Sites", onChange: function () { onFiltersChanged("site"); } });
        filterBarEl.appendChild(msSite.root);
        var search = document.createElement("input");
        search.className = "search-box"; search.id = "fS"; search.placeholder = "Search station\u2026";
        var stimer;
        search.oninput = function (e) { clearTimeout(stimer); stimer = setTimeout(function () { filterSearch = e.target.value; render(); loadVisibleDeviceStatus(); }, 250); };
        filterBarEl.appendChild(search);
        msZone.setItems(masterZones);
        msDiv.setItems(divisionOptions);
        msSite.setItems(siteOptions);
        // Wrap fragment children into a persistent container element
        var host = document.createElement("div");
        host.style.display = "contents";
        host.appendChild(filterBarEl);
        filterBarEl = host;
    }
    function mountFilterBar() {
        var hostSlot = document.getElementById("filterHost");
        if (!hostSlot) return;
        if (!filterBarEl) buildFilterBar();
        hostSlot.appendChild(filterBarEl);
        // Restore focus + caret captured at the start of render()
        if (_filterFocusEl) {
            try {
                _filterFocusEl.focus({ preventScroll: true });
                if (_filterSelStart !== null && typeof _filterFocusEl.setSelectionRange === "function") {
                    _filterFocusEl.setSelectionRange(_filterSelStart, _filterSelEnd);
                }
            } catch (focusErr) { }
            _filterFocusEl = null; _filterSelStart = _filterSelEnd = null;
        }
    }

    async function rebuildDivisionOptions() {
        if (!filterZoneIds.length) { divisionOptions = masterDivisions.slice(); return; }
        var lists = await Promise.all(filterZoneIds.map(async function (zid) {
            if (divisionsByZone[zid]) return divisionsByZone[zid];
            try {
                var r = await fetch(DIVISION_URL + "?zoneId=" + encodeURIComponent(zid), { credentials: "same-origin" });
                if (!r.ok) throw new Error("HTTP " + r.status);
                var data = mapApiSelectItems(await r.json());
                divisionsByZone[zid] = data;
                return data;
            } catch (e) { log("Division bind failed (zone " + zid + "): " + e.message, "err"); return []; }
        }));
        var seen = {}; divisionOptions = [];
        lists.forEach(function (l) { l.forEach(function (d) { if (!seen[String(d.Id)]) { seen[String(d.Id)] = 1; divisionOptions.push(d); } }); });
    }
    async function rebuildSiteOptions() {
        // Site options follow the selected divisions; if none are selected but
        // zones are, they follow every division of those zones.
        var divIds = filterDivisionIds.length ? filterDivisionIds
            : (filterZoneIds.length ? divisionOptions.map(function (d) { return String(d.Id); }) : []);
        if (!divIds.length) { siteOptions = masterSites.slice(); return; }
        var lists = await Promise.all(divIds.map(async function (did) {
            if (sitesByDivision[did]) return sitesByDivision[did];
            try {
                var r = await fetch(SITE_URL + "?divisionId=" + encodeURIComponent(did), { credentials: "same-origin" });
                if (!r.ok) throw new Error("HTTP " + r.status);
                var data = mapApiSelectItems(await r.json());
                sitesByDivision[did] = data;
                return data;
            } catch (e) { log("Site bind failed (division " + did + "): " + e.message, "err"); return []; }
        }));
        var seen = {}; siteOptions = [];
        lists.forEach(function (l) { l.forEach(function (s) { if (!seen[String(s.Id)]) { seen[String(s.Id)] = 1; siteOptions.push(s); } }); });
    }
    var _filterSeq = 0;
    async function onFiltersChanged(level) {
        filterZoneIds = msZone.getSelected();
        filterDivisionIds = msDiv.getSelected();
        filterSiteIds = msSite.getSelected();
        var seq = ++_filterSeq;
        render(); // instant feedback with current data
        if (level === "zone") {
            await rebuildDivisionOptions();
            if (seq !== _filterSeq) return;
            msDiv.setItems(divisionOptions);
            filterDivisionIds = msDiv.getSelected();
        }
        if (level === "zone" || level === "division") {
            await rebuildSiteOptions();
            if (seq !== _filterSeq) return;
            msSite.setItems(siteOptions);
            filterSiteIds = msSite.getSelected();
        }
        await refreshHealthMqttTopics(true);
        if (seq !== _filterSeq) return;
        fetchAlertLive();
        loadVisibleDeviceStatus();
        render();
    }

    // ===== Topic-to-service mapping =====
    function getSiteId(payload, topic) {
        var p = safeObj(payload);
        var direct = firstDefined(p.siteId, p.SiteId, p.siteID, p.AssetSiteId);
        if (direct) return parseInt(direct, 10) || 0;
        var meta = healthTopicMeta[String(topic || "").replace(/^\/+|\/+$/g, "")];
        if (meta && meta.siteId) return parseInt(meta.siteId, 10) || 0;
        var match = String(topic || "").match(/(?:site|rdpms|health|datareceiver|debouncer|pointServices)[\/\-_]?(\d+)/i) || String(topic || "").match(/\/(\d+)\//);
        return match ? (parseInt(match[1], 10) || 0) : 0;
    }

    function serviceKeyFromTopic(topic, payload) {
        var t = String(topic || "").toLowerCase();
        var p = safeObj(payload);
        var mt = String(firstDefined(p.Topic, p.topic, p.MessageType, "") || "").toLowerCase();
        // New-format payloads identify themselves via a "service" field
        // (e.g. TriggerAlert health -> { service: "TriggerAlert", connections: [...] })
        var svcName = String(firstDefined(p.service, p.Service, p.serviceName, p.ServiceName, "") || "").toLowerCase();
        var all = t + " " + mt + " " + svcName;
        if (all.indexOf("datareceiver") >= 0 || all.indexOf("data-receiver") >= 0 || all.indexOf("datarecv") >= 0) return "dataReceiverHealth";
        if (all.indexOf("dataloggerdiagnostic") >= 0 || all.indexOf("diagnostic") >= 0) return "dataloggerDiagnostic";
        if (all.indexOf("dataloggerheartbeat") >= 0 || all.indexOf("heartbeat") >= 0 || all.indexOf("mqtt/dl/heartbeat") >= 0) return "dataloggerHeartbeat";
        if (all.indexOf("alerthealth") >= 0 || all.indexOf("alert") >= 0) return "alertHealth";
        if (all.indexOf("debouncer/health") >= 0 || all.indexOf("debouncerhealth") >= 0 || all.indexOf("debouncer") >= 0) return "debouncerHealth";
        if (all.indexOf("pointservices") >= 0 || all.indexOf("pointmachinehealth") >= 0 || all.indexOf("pointhealth") >= 0 || all.indexOf("point") >= 0) return "pointHealth";
        return null;
    }

    // ===== Merge incoming health payload =====
    function mergeHealthPayload(payload, topic) {
        if (!payload) return;
        if (Array.isArray(payload)) { payload.forEach(function (x) { mergeHealthPayload(x, topic); }); return; }
        if (Array.isArray(payload.Messages)) {
            payload.Messages.forEach(function (m) {
                try { mergeHealthPayload(typeof m === "string" ? JSON.parse(m) : m, payload.Topic || topic); }
                catch (e) { log("Invalid nested message: " + e.message, "err"); }
            });
            return;
        }

        var siteId = getSiteId(payload, topic) || Date.now();
        var current = stations.find(function (s) { return String(s.siteId) === String(siteId); });
        if (!current) { current = defaultStation(siteId); stations.push(current); }

        current.zoneId = String(firstDefined(payload.zoneId, payload.ZoneId, payload.zoneID, current.zoneId, ""));
        current.divisionId = String(firstDefined(payload.divisionId, payload.DivisionId, payload.divisionID, current.divisionId, ""));
        var topicMeta = healthTopicMeta[String(topic || "").replace(/^\/+|\/+$/g, "")] || {};
        current.zone = str(firstDefined(payload.zone, payload.Zone, (current.zone !== "Unknown" ? current.zone : null), topicMeta.zoneName), "Unknown");
        current.division = str(firstDefined(payload.division, payload.Division, (current.division !== "Unknown" ? current.division : null), topicMeta.divisionName), "Unknown");
        if (!current.zoneId && topicMeta.zoneId) current.zoneId = String(topicMeta.zoneId);
        if (!current.divisionId && topicMeta.divisionId) current.divisionId = String(topicMeta.divisionId);
        current.stationName = str(firstDefined(payload.stationName, payload.SiteName, payload.siteName, payload.StationName, payload.Name, topicMeta.siteName, current.stationName), current.stationName);
        current.siteId = siteId;
        current._topic = topic || current._topic || "";
        current._updatedAt = new Date().toISOString();
        if (!current._rawPayloads) current._rawPayloads = {};

        if (payload.services) current.services = Object.assign({}, current.services, safeObj(payload.services));
        if (payload.hardware) current.hardware = normalizeHardware(Object.assign({}, current.hardware, safeObj(payload.hardware)));

        var directServiceMap = {
            dataReceiverHealth: "dataReceiverHealth",
            dataReceiver: "dataReceiverHealth",
            dataloggerHeartbeat: "dataloggerHeartbeat",
            dataloggerDiagnostic: "dataloggerDiagnostic",
            alertHealth: "alertHealth",
            debouncerHealth: "debouncerHealth",
            debouncer: "debouncerHealth",
            pointHealth: "pointHealth",
            pointMachineHealth: "pointHealth",
            pointServicesHealth: "pointHealth",
            pointServices: "pointHealth"
        };

        Object.keys(directServiceMap).forEach(function (k) {
            if (payload[k]) {
                var targetKey = directServiceMap[k];
                current.services[targetKey] = deepMergePayload(current.services[targetKey], payload[k]);
                current._rawPayloads[targetKey] = current.services[targetKey];
            }
        });

        if (payload.services) {
            Object.keys(directServiceMap).forEach(function (k) {
                if (payload.services[k]) {
