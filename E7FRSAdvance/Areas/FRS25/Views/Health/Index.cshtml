        // is built only ONCE. On later renders we update the changing numbers in place
        // and only repaint the table rows - we do NOT tear down and rebuild the whole
        // DOM (and re-mount the filter bar) on every MQTT tick. This is what keeps clicks
        // responsive and the page smooth under a live data stream.
        var fastPath = !!document.getElementById("tb") && app.getAttribute("data-view") === activeView;
        if (!fastPath) {
            // Only the full rebuild detaches the filter bar / resets scroll, so save here.
            if (_savedScrollY === null) _savedScrollY = window.scrollY;
            _filterFocusEl = (filterBarEl && document.activeElement && filterBarEl.contains(document.activeElement)) ? document.activeElement : null;
            if (_filterFocusEl && typeof _filterFocusEl.selectionStart === "number") {
                try { _filterSelStart = _filterFocusEl.selectionStart; _filterSelEnd = _filterFocusEl.selectionEnd; } catch (selErr) { _filterSelStart = _filterSelEnd = null; }
            } else { _filterSelStart = _filterSelEnd = null; }
        }
        var f = getFilteredStations();
