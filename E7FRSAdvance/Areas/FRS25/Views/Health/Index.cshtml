        var c = deviceStatusCache[siteId];
        if (c && (c.loading || (!force && c.ts && (Date.now() - c.ts) < DS_CACHE_MS))) return;
        deviceStatusCache[siteId] = deviceStatusCache[siteId] || {};
        deviceStatusCache[siteId].loading = true;
        deviceStatusCache[siteId].error = null;
        dsEnqueue(async function () {
            try {
                var r = await fetch(DEVICE_STATUS_URL + "?siteId=" + encodeURIComponent(siteId), { credentials: "same-origin" });
                if (!r.ok) throw new Error("HTTP " + r.status);
                var resp = await r.json();
                if (resp && resp.Success === false) throw new Error(resp.Message || "API error");
                var norm = normalizeDeviceStatus(resp);
                deviceStatusCache[siteId] = { loading: false, error: null, ts: Date.now(), modems: norm.modems };
                applyDeviceStatus(siteId, norm);
            } catch (e) {
                deviceStatusCache[siteId] = { loading: false, error: e.message, ts: Date.now() };
                log("Device status failed (site " + siteId + "): " + e.message, "err");
            }
            renderThrottled();
        });
    }

    function loadVisibleDeviceStatus(force) {
        getFilteredStations().slice(0, DS_MAX_SITES).forEach(function (st) {
            fetchDeviceStatusForSite(st.siteId, force);
        });
    }

    var _renderTimer = null;
    var _renderDirty = false;
    var RENDER_COALESCE_MS = 250;   // ingest is instant (state updated per message); DOM repaint is batched
    function renderThrottled() {
        _renderDirty = true;
        if (_renderTimer) return;
        _renderTimer = setTimeout(function () {
            _renderTimer = null;
            if (!_renderDirty) return;
            if (document.hidden) return;            // tab in background: stay dirty, repaint on return
            _renderDirty = false;
            render();
        }, RENDER_COALESCE_MS);
    }
    document.addEventListener("visibilitychange", function () {
        if (!document.hidden && _renderDirty) { _renderDirty = false; render(); }
    });

    // Live connectivity section used inside the hardware detail modal.
    // N/W-db style station summary bar (screenshot parity):
    // [icon] Station / breadcrumb  |  Modems on/total | A10 total | TCP on/total | MQTT on/total
    function nwStationBar(stn, type, hw) {
        var dsc = deviceStatusCache[parseInt(stn.siteId, 10) || 0] || {};
        var ms = dsc.modems || [];
        var a10s = [];
        ms.forEach(function (m) { (m.a10s || []).forEach(function (a) { a10s.push(a); }); });
        var mOn = ms.filter(function (m) { return m.online; }).length;
        var aOn = a10s.filter(function (a) { return a.online; }).length;
        var aTcp = a10s.filter(function (a) { return a.tcp; }).length;
        var aMqtt = a10s.filter(function (a) { return a.mqtt; }).length;
        var mTcp = ms.filter(function (m) { return m.tcp; }).length;
        var mMqtt = ms.filter(function (m) { return m.mqtt; }).length;
        var loaded = ms.length > 0;
        function cell(v, t, l, cls) {
            return '<div class="nw-stnbar-cell"><div class="v' + (cls ? ' ' + cls : '') + '">' + v + (t !== null ? '<small> / ' + t + '</small>' : '') + '</div><div class="l">' + l + '</div></div>';
        }
        var h = '<div class="nw-stnbar">' +
            '<div class="nw-stnbar-id"><div class="ico">' + (type === 'network' ? '\uD83D\uDCE1' : '\uD83D\uDCDF') + '</div>' +
            '<div><div class="nm">' + esc(stn.stationName) + '</div><div class="sub">' + esc(stn.division || '') + (stn.zone ? ' / ' + esc(stn.zone) : '') + ' \u00B7 Devices</div></div></div>' +
            '<div class="nw-stnbar-stats">';
        if (loaded) {
            h += cell(mOn, ms.length, 'Modems Online', mOn === ms.length ? 'grn' : '') +
                '<div class="nw-stnbar-div"></div>' +
                cell(aOn, a10s.length, 'A10 Online', aOn === a10s.length && a10s.length ? 'grn' : '') +
                '<div class="nw-stnbar-div"></div>' +
                cell(type === 'network' ? mTcp : aTcp, type === 'network' ? ms.length : a10s.length, 'TCP', 'cy') +
                '<div class="nw-stnbar-div"></div>' +
                cell(type === 'network' ? mMqtt : aMqtt, type === 'network' ? ms.length : a10s.length, 'MQTT', 'grn');
        } else {
            h += cell(num(hw.total), null, 'Total') +
                '<div class="nw-stnbar-div"></div>' +
                cell(num(hw.total) - num(hw.unhealthy), null, 'Healthy', 'grn') +
                '<div class="nw-stnbar-div"></div>' +
                cell(num(hw.unhealthy), null, 'Unhealthy', num(hw.unhealthy) > 0 ? '' : 'grn') +
                '<div class="nw-stnbar-div"></div>' +
                '<div class="nw-stnbar-cell"><div class="v" style="font-size:11px;color:var(--tx3)">\u23F3 loading live\u2026</div></div>';
        }
        h += '</div></div>';
        return h;
    }

