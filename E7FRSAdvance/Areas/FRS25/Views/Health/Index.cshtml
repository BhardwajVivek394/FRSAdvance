    function nwTab(el, tab) {
        var tabs = el.parentElement.querySelectorAll('.sb-tab');
        for (var i = 0; i < tabs.length; i++) tabs[i].classList.remove('active');
        el.classList.add('active');
        var root = el.closest(".right-sidebar") || el.closest(".nw-modal-right") || document;
        var panes = root.querySelectorAll('.nw-pane');
        for (var j = 0; j < panes.length; j++) panes[j].style.display = (panes[j].getAttribute('data-pane') === tab) ? 'block' : 'none';
        if (tab === 'history' && nwCur && !nwCur.histLoaded) { nwCur.histLoaded = true; nwLoadHist(); }
    }

