        var to = (document.getElementById('nwHistTo') || {}).value || nwToday();
        var proto = document.getElementById('nwHistProto'); if (proto) proto.value = 'all';
        listEl.innerHTML = '<div class="graph-loader" style="display:flex"><span class="msel-spin"></span> Loading\u2026</div>';
        var url;
        if (nwCur.kind === 'modem') {
            url = MODEM_GRAPH_URL + '?clusterId=' + encodeURIComponent(nwCur.modem.clusterId) + '&fromDate=' + encodeURIComponent(nwApiDate(from)) + '&toDate=' + encodeURIComponent(nwApiDate(to));
        } else {
            url = A10_RECORDS_URL + '?clusterId=' + encodeURIComponent(nwCur.a10.clusterId) + '&a10Id=' + encodeURIComponent(nwCur.a10.a10Id) +
                '&ModemId=' + encodeURIComponent(nwCur.a10.modemId || '') + '&fromDate=' + encodeURIComponent(nwApiDate(from)) + '&toDate=' + encodeURIComponent(nwApiDate(to));
        }
        fetch(url, { credentials: 'same-origin' }).then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); }).then(function (resp) {
            if (resp && resp.Success === false) { listEl.innerHTML = '<div class="nw-empty" style="color:var(--red)">' + nwS(resp.Message || 'No records') + '</div>'; nwHistCounts(0, 0); return; }
            var raw = Array.isArray(resp) ? resp : (resp.Data || resp.data || []);
            nwHistData = nwProcessGaps(raw, from, to);
            nwRenderHist(nwHistData);
        }).catch(function () {
            listEl.innerHTML = '<div class="nw-empty" style="color:var(--red)">Failed to load history</div>';
            nwHistCounts(0, 0);
        });
    }
    // Port of processA10HistoryWithGaps: TypeId 1 = TCP, 2 = MQTT; data present = online; gap > threshold = synthetic offline entry
    function nwProcessGaps(rawData, fromDateStr, toDateStr) {
        if (!rawData || !rawData.length) return [];
        var rows = rawData.map(function (r) {
            return { ts: parseGraphTs(firstDefined(r.TimeStamp, r.timeStamp)), typeId: num(firstDefined(r.TypeId, r.typeId), 0), src: r };
        }).filter(function (r) { return r.ts !== null; });
        if (!rows.length) return [];
        rows.sort(function (a, b) { return a.ts - b.ts; });
        var gapMs = NW_GAP_MIN * 60 * 1000;
        var out = [];
        var startOfDay = new Date(fromDateStr + 'T00:00:00').getTime();
        var endOfDay = new Date(toDateStr + 'T23:59:59').getTime();
        var now = Date.now();
        var effectiveEnd = endOfDay > now ? now : endOfDay;
        if ((rows[0].ts - startOfDay) > gapMs) out.push({ ts: startOfDay, typeId: rows[0].typeId, online: false, synthetic: true });
        for (var i = 0; i < rows.length; i++) {
            if (i > 0) {
                var gap = rows[i].ts - rows[i - 1].ts;
                if (gap > gapMs) {
                    var gp = rows[i - 1].typeId > 0 ? rows[i - 1].typeId : rows[i].typeId;
                    out.push({ ts: rows[i - 1].ts + 60000, typeId: gp, online: false, synthetic: true });
                }
            }
            out.push({ ts: rows[i].ts, typeId: rows[i].typeId, online: true, synthetic: false, src: rows[i].src });
        }
        var last = rows[rows.length - 1];
        if ((effectiveEnd - last.ts) > gapMs) out.push({ ts: last.ts + 60000, typeId: last.typeId, online: false, synthetic: true });
        return out;
    }
    function nwRenderHist(data) {
        var el = document.getElementById('nwHistList');
        if (!el) return;
        if (!data || !data.length) { el.innerHTML = '<div class="nw-empty">No history available for selected date range</div>'; nwHistCounts(0, 0); return; }
        data.sort(function (a, b) { return b.ts - a.ts; });
        var h = '';
        data.forEach(function (it) {
            var isTcp = it.typeId === 1, isMqtt = it.typeId === 2;
            var proto = isTcp ? 'tcp' : (isMqtt ? 'mqtt' : 'offline');
            var extra = '';
            if (it.online && it.src) {
                if (isTcp) extra = firstDefined(it.src.ResponseTime, it.src.responseTime, it.src.SignalStrength, it.src.signalStrength, '');
                else extra = firstDefined(it.src.Uptime, it.src.uptime, it.src.SignalStrength, it.src.signalStrength, '');
                if (extra !== '' && extra !== null && extra !== undefined) extra = '<span class="nw-hist-extra">' + nwS(extra) + '</span>'; else extra = '';
            }
            h += '<div class="nw-hist-card' + (it.online ? '' : ' off') + '" data-protocol="' + proto + '">' +
                '<span class="nw-devdot ' + (it.online ? 'on' : 'off') + '"></span>' +
                '<span class="nw-tag ' + (isTcp ? 'tcp' : (isMqtt ? 'mqtt' : '')) + (it.online ? '' : ' dim') + '">' + (isTcp ? 'TCP' : (isMqtt ? 'MQTT' : '\u2014')) + '</span>' +
                '<span style="color:' + (it.online ? 'var(--grn)' : 'var(--red)') + ';font-size:11px;font-weight:600">' + (it.online ? 'Online' : 'Offline') + '</span>' + extra +
                '<span class="nw-hist-time nw-mono">' + nwFmtTs(it.ts) + '</span></div>';
        });
        el.innerHTML = h;
        nwHistCounts(data.length, data.length);
    }
    function nwHistCounts(visible, total) {
        var v = document.getElementById('nwHistVisible'), t = document.getElementById('nwHistTotal');
        if (v) v.textContent = visible;
        if (t) t.textContent = total;
