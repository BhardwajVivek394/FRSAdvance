    // --- Helper: parse new connections[] format ---
    function parseConnectionsFormat(d) {
        if (!Array.isArray(d.connections)) return null;
        var conns = [], issues = [], allOk = true;
        d.connections.forEach(function (c) {
            // Only entries that actually carry a "connected" flag take part in the
            // up/down decision. Stat-only entries (e.g. FCM push over HTTP) have no
            // such flag and must NOT be treated as disconnected.
            var hasConnectedFlag = (c.connected !== undefined && c.connected !== null);
            if (hasConnectedFlag) {
                var ok = boolFrom(c.connected);
                conns.push({ l: c.name || "unknown", ok: ok, transport: c.transport || "", role: c.role || "", lastActivityAgeSec: num(c.lastActivityAgeSec), reconnectAttempts: num(c.reconnectAttempts), disconnectCount: num(c.disconnectCount) });
                if (!ok) { allOk = false; issues.push({ sev: "critical", msg: (c.name || "Connection") + " (" + (c.transport || "") + ") disconnected" }); }
            } else {
                var sent = num(firstDefined(c.sentTotal, c.sent, 0)), fail = num(firstDefined(c.failTotal, c.failed, 0));
                var failPct = (sent + fail) > 0 ? (fail / (sent + fail) * 100) : 0;
                conns.push({ l: c.name || "unknown", ok: failPct < 50, transport: c.transport || "", role: c.role || "" });
                if (fail > 0 && failPct >= 25) issues.push({ sev: "warning", msg: (c.name || "push") + " failures: " + fail + "/" + (sent + fail) + " (" + failPct.toFixed(0) + "%)" });
            }
            if (num(c.reconnectAttempts) > 5) issues.push({ sev: "warning", msg: (c.name || "") + " " + c.reconnectAttempts + " reconnect attempts" });
            if (num(c.disconnectCount) > 0) issues.push({ sev: "warning", msg: (c.name || "") + " " + c.disconnectCount + " disconnect(s)" });
            if (c.errorRatePct && num(c.errorRatePct) > 50) issues.push({ sev: "warning", msg: (c.name || "api") + " error rate " + num(c.errorRatePct).toFixed(1) + "%" });
            if (num(c.queryErrors) > 0) issues.push({ sev: "warning", msg: (c.name || "db") + " " + num(c.queryErrors) + " query error(s)" });
            if (c.lastError && String(c.lastError).trim() !== "") issues.push({ sev: "warning", msg: (c.name || "") + " last error: " + esc(String(c.lastError).substring(0, 80)) });
        });
        var pr = safeObj(d.processing);
        if (num(pr.processingErrors) > 0) issues.push({ sev: "warning", msg: num(pr.processingErrors) + " processing errors" });
        if (num(pr.avgProcessingMs) > 200) issues.push({ sev: "warning", msg: "Latency: " + num(pr.avgProcessingMs).toFixed(0) + "ms" });
        var exc = safeObj(d.exceptions);
        if (num(exc.total) > 5000) issues.push({ sev: "warning", msg: num(exc.total).toLocaleString() + " total exceptions" });
        if (num(exc.ratePerMin) > 100) issues.push({ sev: "warning", msg: "Exception rate: " + num(exc.ratePerMin) + "/min" });

        var statusField = String(firstDefined(d.status, d.Status, "")).toUpperCase();
        var status = "healthy";
        if (!allOk || statusField === "DOWN" || statusField === "ERROR" || statusField === "CRITICAL" || statusField === "FAIL") status = "critical";
        else if (issues.some(function (i) { return i.sev === "warning"; }) || statusField === "DEGRADED" || statusField === "WARNING" || statusField === "WARN") status = "warning";

        var metrics = { Status: str(d.status), Uptime: fmtUp(firstDefined(d.uptimeSec, d.UptimeSec, d.uptimeSeconds)) };
        if (pr.batchesLastMinute !== undefined) metrics.Batches_min = num(pr.batchesLastMinute);
        if (pr.messagesProcessedLastMinute !== undefined) metrics.Msgs_min = num(pr.messagesProcessedLastMinute);
        if (pr.avgProcessingMs !== undefined) metrics.Avg_Latency = num(pr.avgProcessingMs).toFixed(1) + "ms";
        if (pr.totalBatches !== undefined) metrics.Total_Batches = num(pr.totalBatches).toLocaleString();
        if (pr.processingErrors !== undefined) metrics.Proc_Errors = num(pr.processingErrors);
        if (exc.total !== undefined) metrics.Exceptions = num(exc.total).toLocaleString();
        if (exc.ratePerMin !== undefined) metrics.Exc_Rate = exc.ratePerMin + "/min";
        var apiConn = d.connections.find(function (c) { return c.name === "api"; });
        if (apiConn) { metrics.API_Calls = num(apiConn.calls); metrics.API_Errors = num(apiConn.errors); metrics.API_ErrRate = num(apiConn.errorRatePct).toFixed(1) + "%"; }
        var pushConn = d.connections.find(function (c) { return c.role === "push" || c.name === "fcm"; });
        if (pushConn) { metrics.Push_Sent = num(firstDefined(pushConn.sentTotal, pushConn.sent, 0)); metrics.Push_Fail = num(firstDefined(pushConn.failTotal, pushConn.failed, 0)); }

