        line-height: 1.4
    }

    .aai-meta {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 3px
    }

        .aai-meta span {
            font-size: 9.5px;
            color: var(--tx4);
            font-family: var(--mono)
        }

    /* ===== 1-day history count chip on the eye/Health icon ===== */
    .cl-cnt.hist {
        background: var(--blu-s);
        color: var(--blu);
        border: 1px solid rgba(96,165,250,.4);
        font-weight: 800;
        letter-spacing: .01em;
    }

        .cl-cnt.hist small {
            font-size: 7px;
            opacity: .85;
            margin-left: 2px;
            font-weight: 800;
            letter-spacing: .03em;
        }

    /* ===== ALERT CENTER (bifurcated Live | History) ===== */
    .ac-body {
        display: flex;
        flex-direction: column;
        gap: 12px;
        font-family: var(--sans);
    }

    .ac-scope {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
        padding: 3px 9px;
        border-radius: 999px;
        margin-left: 10px;
        vertical-align: middle;
        background: var(--blu-s);
        color: var(--blu);
        border: 1px solid rgba(96,165,250,.32);
    }

    .ac-site {
        font-size: 10px;
        color: var(--tx3);
        font-family: var(--mono);
        margin-left: 7px;
        letter-spacing: .02em;
    }

    /* primary tabs (Live / History) */
    .ac-tabs {
        display: flex;
        gap: 4px;
        border-bottom: 1px solid var(--bdr);
    }

    .ac-tab {
        appearance: none;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 10px 16px;
        font-family: var(--sans);
        font-size: 12.5px;
        font-weight: 700;
        color: var(--tx3);
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        letter-spacing: .02em;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: color .15s ease, border-color .15s ease;
    }

        .ac-tab:hover {
            color: var(--tx);
        }

        .ac-tab.active {
            color: var(--blu);
            border-bottom-color: var(--blu);
        }

    .ac-tabn {
        font-size: 10px;
        font-weight: 800;
        min-width: 17px;
        height: 17px;
        padding: 0 5px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--bg4);
        color: var(--tx2);
    }

    .ac-tab.active .ac-tabn {
        background: var(--blu);
        color: #06122b;
    }

    .ac-note {
        font-size: 11.5px;
        color: var(--tx3);
        letter-spacing: .01em;
    }

    .ac-empty {
        text-align: center;
        padding: 34px 16px;
        font-size: 13px;
        color: var(--tx3);
        font-family: var(--sans);
    }

    /* date filter row */
    .ac-filter {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

        .ac-filter label {
            font-size: 11px;
            color: var(--tx3);
            display: inline-flex;
            align-items: center;
            gap: 7px;
            font-weight: 700;
            letter-spacing: .03em;
            text-transform: uppercase;
        }

        .ac-filter input[type="datetime-local"] {
            background: var(--bg2);
            color: var(--tx);
            border: 1px solid var(--bdr2);
            border-radius: 8px;
            padding: 6px 9px;
            font-size: 11.5px;
            font-family: var(--mono);
            letter-spacing: .02em;
            color-scheme: dark;
        }

            .ac-filter input[type="datetime-local"]:focus {
                outline: none;
                border-color: var(--blu);
                box-shadow: 0 0 0 3px var(--blu-s);
            }

    .ac-apply {
        appearance: none;
        cursor: pointer;
        border: none;
        border-radius: 8px;
        padding: 7px 18px;
        font-family: var(--sans);
        font-size: 11.5px;
        font-weight: 800;
        letter-spacing: .03em;
        background: var(--blu);
        color: #06122b;
        transition: filter .15s ease;
    }

        .ac-apply:hover {
            filter: brightness(1.1);
        }

    /* results table */
    .ac-table-wrap {
        overflow: auto;
        border: 1px solid var(--bdr);
        border-radius: 12px;
        background: var(--bg2);
    }

    .ac-table {
        width: 100%;
        border-collapse: collapse;
        font-family: var(--sans);
        font-size: 12px;
    }

        .ac-table thead th {
            position: sticky;
            top: 0;
            z-index: 1;
            background: var(--bg3);
            color: var(--tx3);
            text-align: left;
            font-weight: 800;
            font-size: 9.5px;
            letter-spacing: .08em;
            text-transform: uppercase;
            padding: 10px 12px;
            border-bottom: 1px solid var(--bdr2);
            white-space: nowrap;
        }

        .ac-table tbody td {
            padding: 11px 12px;
            border-bottom: 1px solid var(--bdr);
            color: var(--tx2);
            vertical-align: top;
            line-height: 1.45;
        }

        .ac-table tbody tr:last-child td {
            border-bottom: none;
        }

    .ac-row-click {
        cursor: pointer;
        transition: background .12s ease;
    }

        .ac-row-click:hover td {
            background: var(--bg3);
        }

    .ac-desc {
        max-width: 460px;
        color: var(--tx2);
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: .01em;
    }

    .ac-ts {
        font-family: var(--mono);
        white-space: nowrap;
        color: var(--tx3);
        font-size: 11px;
    }

        .ac-ts.set {
            color: var(--tx2);
        }

    .ac-node {
        display: inline-block;
        font-size: 10px;
        font-weight: 800;
        text-transform: capitalize;
        letter-spacing: .02em;
        padding: 2px 9px;
        border-radius: 999px;
        background: var(--bg4);
        color: var(--tx2);
    }

        .ac-node.local {
            background: var(--grn-s);
            color: var(--grn);
        }

        .ac-node.cloud {
            background: var(--blu-s);
            color: var(--blu);
        }

    .ac-ident {
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 700;
        color: var(--tx);
        letter-spacing: .01em;
    }

        .ac-ident.red {
            color: var(--red);
        }

        .ac-ident.amb {
            color: var(--amb);
        }

    .ac-state {
        font-size: 10px;
        font-weight: 800;
        padding: 2px 9px;
        border-radius: 999px;
        letter-spacing: .03em;
    }

        .ac-state.a {
            background: var(--amb-s);
            color: var(--amb);
        }

        .ac-state.g {
            background: var(--grn-s);
            color: var(--grn);
        }

    .ah-no-alerts {
        text-align: center;
        padding: 24px;
        font-size: 12px;
        color: var(--tx3)
    }

    .ah-expand-btn {
        background: none;
        border: none;
        color: var(--tx3);
        cursor: pointer;
        font-size: 11px;
        padding: 2px 6px;
        border-radius: 4px;
        transition: all .15s
    }

        .ah-expand-btn:hover {
            color: var(--tx);
            background: var(--bg5)
        }

    /* ===== VIEW TABS ===== */
    .view-tabs {
        display: flex;
        gap: 0;
        margin-bottom: 18px;
        border-radius: 10px;
        overflow: hidden;
        border: 1px solid var(--bdr);
        background: var(--bg2);
        width: fit-content
    }

    .view-tab {
        padding: 9px 22px;
        font-size: 12px;
        font-weight: 600;
        color: var(--tx3);
        cursor: pointer;
        transition: all .15s;
        border: none;
        background: transparent;
        font-family: var(--sans);
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
        position: relative
    }

        .view-tab:not(:last-child) {
            border-right: 1px solid var(--bdr)
        }

        .view-tab:hover {
            color: var(--tx2);
            background: var(--bg3)
        }

        .view-tab.active {
            color: var(--tx);
            background: var(--bg4);
            font-weight: 700
        }

            .view-tab.active::after {
                content: "";
                position: absolute;
                bottom: 0;
                left: 12px;
                right: 12px;
                height: 2px;
                border-radius: 2px
            }

            .view-tab.active.tab-alerts::after {
                background: var(--amb)
            }

            .view-tab.active.tab-live::after {
                background: var(--blu)
            }

        .view-tab svg {
            width: 15px;
            height: 15px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round
        }

        .view-tab .tab-count {
            font-size: 10px;
            font-weight: 700;
            padding: 1px 7px;
            border-radius: 10px;
            font-family: var(--mono)
        }

    .tab-count.red {
        background: var(--red-s);
        color: var(--red)
    }

    .tab-count.grn {
        background: var(--grn-s);
        color: var(--grn)
    }

    .tab-count.amb {
        background: var(--amb-s);
        color: var(--amb)
    }

    .tab-count.blu {
        background: var(--blu-s);
        color: var(--blu)
    }

    /* ===== SENSOR HEALTH MODAL ===== */
    .sensor-asset-group {
        margin-bottom: 14px;
        border: 1px solid var(--bdr);
        border-radius: 10px;
        overflow: hidden;
        background: rgba(255,255,255,.01)
    }

    .sensor-asset-hdr {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        background: var(--bg3);
        border-bottom: 1px solid var(--bdr);
        flex-wrap: wrap
    }

    .sensor-asset-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--tx)
    }

    .sensor-asset-id {
        font-size: 10px;
        color: var(--tx4);
        font-family: var(--mono)
    }

    .sensor-asset-badge {
        font-size: 9px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 10px;
        background: var(--red-s);
        color: var(--red);
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-left: auto
    }

    .sensor-item {
        padding: 10px 14px;
        border-bottom: 1px solid rgba(26,37,64,.35)
    }

        .sensor-item:last-child {
            border-bottom: none
        }

    .sensor-item-hdr {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
        flex-wrap: wrap
    }

    .sensor-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0
    }

        .sensor-dot.red {
            background: var(--red);
            box-shadow: 0 0 6px rgba(248,113,113,.5);
            animation: pulse 1.5s ease-in-out infinite
        }

        .sensor-dot.amb {
            background: var(--amb);
            box-shadow: 0 0 6px rgba(251,191,36,.5)
        }

    .sensor-name {
        font-size: 12px;
        font-weight: 600;
        color: var(--tx)
    }

    .sensor-attr-id {
        font-size: 10px;
        color: var(--tx4);
        font-family: var(--mono)
    }

    .sensor-status-badge {
        font-size: 9px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 8px;
        text-transform: uppercase;
        letter-spacing: .06em
    }

        .sensor-status-badge.red {
            background: var(--red-s);
            color: var(--red)
        }

        .sensor-status-badge.amb {
            background: var(--amb-s);
            color: var(--amb)
        }

    .sensor-alert-row {
        margin: 4px 0 4px 16px;
        padding: 8px 12px;
        border-radius: 6px;
        background: var(--bg2);
        border: 1px solid var(--bdr);
        cursor: pointer;
        transition: all .12s
    }

        .sensor-alert-row:hover {
            border-color: var(--bdr2);
            background: var(--bg4)
        }

    .sensor-alert-desc {
        font-size: 11px;
        color: var(--tx2);
        line-height: 1.4;
        margin-bottom: 4px
    }

    .sensor-alert-meta {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center
    }

    .sa-tag {
        font-size: 9px;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 6px;
        background: rgba(255,255,255,.04);
        border: 1px solid var(--bdr);
        color: var(--tx3);
        text-transform: uppercase;
        letter-spacing: .05em
    }

        .sa-tag.red {
            background: var(--red-s);
            border-color: rgba(248,113,113,.15);
            color: var(--red)
        }

        .sa-tag.amb {
            background: var(--amb-s);
            border-color: rgba(251,191,36,.15);
            color: var(--amb)
        }

    .sa-limit {
        font-size: 10px;
        color: var(--tx3);
        font-family: var(--mono)
    }

    .sa-time {
        font-size: 9.5px;
        color: var(--tx4);
        font-family: var(--mono)
    }

    /* Hardware chip enhancements */
    .hw-val .hw-total {
        font-size: 10px;
        font-weight: 400;
        color: var(--tx3);
        margin-left: -2px
    }

    .hw-val .hw-total-ok {
        font-size: 12px;
        font-weight: 600;
        color: var(--grn)
    }

    .hw-val.hw-clickable {
        cursor: pointer;
        transition: all .15s
    }

        .hw-val.hw-clickable:hover {
            background: rgba(52,211,153,.06);
            transform: translateY(-1px)
        }


    .tbl-wrap::-webkit-scrollbar,
    .ah-table-wrap::-webkit-scrollbar,
    .modal-body::-webkit-scrollbar,
    .conn-table-wrap::-webkit-scrollbar {
        width: 9px;
        height: 9px;
    }

    .tbl-wrap::-webkit-scrollbar-track,
    .ah-table-wrap::-webkit-scrollbar-track,
    .modal-body::-webkit-scrollbar-track,
    .conn-table-wrap::-webkit-scrollbar-track {
        background: transparent;
    }

    .tbl-wrap::-webkit-scrollbar-thumb,
    .ah-table-wrap::-webkit-scrollbar-thumb,
    .modal-body::-webkit-scrollbar-thumb,
    .conn-table-wrap::-webkit-scrollbar-thumb {
        background: var(--bdr2);
        border-radius: 999px;
        border: 2px solid transparent;
        background-clip: content-box;
    }

        .tbl-wrap::-webkit-scrollbar-thumb:hover,
        .ah-table-wrap::-webkit-scrollbar-thumb:hover,
        .modal-body::-webkit-scrollbar-thumb:hover,
        .conn-table-wrap::-webkit-scrollbar-thumb:hover {
            background: var(--tx3);
            background-clip: content-box;
        }

    body[data-aurora="light"] .sum-card,
    body[data-aurora="light"] .tbl-wrap,
    body[data-aurora="light"] .ah-card,
    body[data-aurora="light"] .modal {
        box-shadow: 0 14px 38px rgba(15,23,42,.08);
    }

    @@media(max-width:700px) {
        .summary {
            grid-template-columns: 1fr 1fr
        }

        .tbl-wrap, .ah-table-wrap {
            max-height: 58vh;
        }

        .filters {
            flex-direction: column;
            align-items: stretch
        }

        .sel, .search-box {
            width: 100%
        }

        .modal {
            width: 100vw;
            max-width: 100vw;
            height: 100vh;
            max-height: 100vh;
            border-radius: 0;
            top: 0;
            left: 0;
            transform: none
        }

            .modal.open {
                transform: none
            }
    }

    /* ===================================================================
       MULTI-SELECT FILTERS + HISTORY MODAL (theme-matched additions)
       =================================================================== */
    .msel {
        position: relative;
        min-width: 150px
    }

    .msel-btn {
        width: 100%;
        background: var(--bg2);
        color: var(--tx);
        border: 1px solid var(--bdr);
        border-radius: 8px;
        padding: 7px 28px 7px 12px;
        font-size: 12px;
        font-family: var(--sans);
        cursor: pointer;
        text-align: left;
        display: flex;
        align-items: center;
        gap: 6px;
        position: relative;
        transition: border-color .15s
    }

        .msel-btn::after {
            content: "";
            position: absolute;
            right: 11px;
            top: 50%;
            width: 7px;
            height: 7px;
            border-right: 1.6px solid var(--tx4);
            border-bottom: 1.6px solid var(--tx4);
            transform: translateY(-65%) rotate(45deg);
            transition: transform .15s
        }

        .msel.open .msel-btn, .msel-btn:hover {
            border-color: var(--blu)
        }

            .msel.open .msel-btn::after {
                transform: translateY(-35%) rotate(225deg)
            }

    .msel-count {
        background: var(--blu-s);
        color: var(--blu);
        border: 1px solid rgba(96,165,250,.3);
        font-size: 10px;
        font-weight: 700;
        padding: 0 7px;
        border-radius: 10px;
        font-family: var(--mono)
    }

    .msel-panel {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        min-width: 230px;
        max-width: 320px;
        background: linear-gradient(180deg, var(--bg3), var(--bg2));
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        border: 1px solid var(--bdr2);
        border-radius: 10px;
        box-shadow: var(--card-shadow);
        z-index: 2500;
        display: none;
        overflow: hidden
    }

    .msel.open .msel-panel {
        display: block
    }

    .msel-search {
        padding: 8px;
        border-bottom: 1px solid var(--bdr)
    }

        .msel-search input {
            width: 100%;
            background: var(--bg2);
            color: var(--tx);
            border: 1px solid var(--bdr);
            border-radius: 6px;
            padding: 6px 10px;
            font-size: 11.5px;
            font-family: var(--sans)
        }

            .msel-search input:focus {
                outline: none;
                border-color: var(--blu)
            }

    .msel-tools {
        display: flex;
        gap: 6px;
        padding: 6px 8px;
        border-bottom: 1px solid var(--bdr)
    }

        .msel-tools button {
            flex: 1;
            background: transparent;
            border: 1px solid var(--bdr);
            color: var(--tx3);
            font-size: 10.5px;
            font-weight: 600;
            border-radius: 6px;
            padding: 4px 6px;
            cursor: pointer
        }

            .msel-tools button:hover {
                border-color: var(--blu);
                color: var(--blu)
            }

    .msel-list {
        max-height: 240px;
        overflow-y: auto;
        padding: 6px
    }

    .msel-opt {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 8px;
        border-radius: 6px;
        font-size: 12px;
        color: var(--tx2);
        cursor: pointer;
        user-select: none
    }

        .msel-opt:hover {
            background: var(--bg4);
            color: var(--tx)
        }

        .msel-opt input {
            accent-color: var(--blu);
            cursor: pointer
        }

    .msel-empty {
        font-size: 11px;
        color: var(--tx3);
        text-align: center;
        padding: 14px
    }

    .msel-spin {
        display: inline-block;
        width: 11px;
        height: 11px;
        border: 2px solid var(--bdr2);
        border-top-color: var(--blu);
        border-radius: 50%;
        animation: mselrot .8s linear infinite;
        vertical-align: middle
    }

    @@keyframes mselrot {
        to {
            transform: rotate(360deg)
        }
    }

    /* Actions column */
    .act-cell {
        display: flex;
        gap: 4px;
        align-items: center;
        justify-content: center
    }

    .hist-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1px solid rgba(96,165,250,.28);
        background: var(--blu-s);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .15s;
        color: var(--blu)
    }

        .hist-btn:hover {
            background: var(--bg5);
            border-color: var(--blu)
        }

        .hist-btn svg {
            width: 16px;
            height: 16px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round
        }

    /* Live connectivity tags (TCP / MQTT) */
    .conn-tag {
        font-size: 9px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        gap: 4px
    }

        .conn-tag .ct-dot {
            width: 5px;
            height: 5px;
            border-radius: 50%
        }

        .conn-tag.tag-on {
            background: var(--grn-s);
            color: var(--grn)
        }

            .conn-tag.tag-on .ct-dot {
                background: var(--grn)
            }

        .conn-tag.tag-off {
            background: var(--red-s);
            color: var(--red)
        }

            .conn-tag.tag-off .ct-dot {
                background: var(--red)
            }

    .hw-device {
        background: var(--bg2);
        border: 1px solid var(--bdr);
        border-radius: 10px;
        padding: 11px 14px;
        margin-bottom: 8px
    }

        .hw-device .hd-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 5px;
            flex-wrap: wrap;
            gap: 6px
        }

        .hw-device .hd-name {
            font-size: 12.5px;
            font-weight: 700;
            color: var(--tx)
        }

        .hw-device .hd-tags {
            display: flex;
            gap: 4px
        }

        .hw-device .hd-meta {
            font-size: 10.5px;
            color: var(--tx3);
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            font-family: var(--mono)
        }

    /* ===== HISTORY MODAL ===== */
    .hmodal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%) scale(.97);
        z-index: 3001;
        background: linear-gradient(180deg, var(--bg2), var(--bg3));
        border: 1px solid var(--bdr);
        border-radius: 16px;
        width: 1080px;
        max-width: 96vw;
        height: 88vh;
        box-shadow: 0 28px 90px rgba(0,0,0,.46);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        display: flex;
        flex-direction: column;
        opacity: 0;
        pointer-events: none;
        transition: all .25s
    }

        .hmodal.open {
            opacity: 1;
            pointer-events: auto;
            transform: translate(-50%,-50%) scale(1)
        }

    .hmo-meta {
        font-size: 11px;
        color: var(--tx3);
        margin-top: 3px
    }

    .hmo-dates {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap
    }

        .hmo-dates label {
            font-size: 10px;
            font-weight: 600;
            color: var(--tx3);
            text-transform: uppercase;
            letter-spacing: .06em
        }

        .hmo-dates input[type=date] {
            background: var(--bg2);
            color: var(--tx);
            border: 1px solid var(--bdr);
            border-radius: 8px;
            padding: 6px 10px;
            font-size: 12px;
            font-family: var(--sans);
            color-scheme: dark
        }

    body[data-aurora="light"] .hmo-dates input[type=date] {
        color-scheme: light
    }

    .hmo-dates input:focus {
        outline: none;
        border-color: var(--blu)
    }

    .hmo-tabs {
        display: flex;
        gap: 0;
        border-bottom: 1px solid var(--bdr);
        padding: 0 16px;
        flex-wrap: wrap;
        flex-shrink: 0
    }

    .htab {
        padding: 10px 16px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        color: var(--tx3);
        border-bottom: 2px solid transparent;
        transition: all .15s;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: -1px;
        white-space: nowrap
    }

        .htab:hover {
            color: var(--tx)
        }

        .htab.active {
            color: var(--cyan);
            border-bottom-color: var(--cyan)
        }

        .htab.svc-tab.active {
            color: var(--grn);
            border-bottom-color: var(--grn)
        }

    .hmo-body {
        flex: 1;
        overflow-y: auto;
        padding: 18px 22px
    }

    .dev-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(235px,1fr));
        gap: 10px;
        margin-bottom: 14px
    }

    .dev-card {
        background: var(--bg2);
        border: 1px solid var(--bdr);
        border-radius: 10px;
        padding: 11px 13px;
        cursor: pointer;
        transition: all .15s
    }

        .dev-card:hover {
            border-color: var(--blu)
        }

        .dev-card.selected {
            border-color: var(--cyan);
            background: rgba(34,211,238,.07)
        }

        .dev-card .dc-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 6px;
            margin-bottom: 6px
        }

        .dev-card .dc-name {
            font-size: 12.5px;
            font-weight: 700;
            color: var(--tx);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis
        }

        .dev-card .dc-meta {
            font-size: 10px;
            color: var(--tx3);
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            font-family: var(--mono)
        }

    .a10-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 14px;
        border: 1px solid var(--bdr);
        background: var(--bg2);
        color: var(--tx2);
        cursor: pointer;
        transition: all .15s;
        margin: 2px
    }

        .a10-chip:hover {
            border-color: var(--blu)
        }

        .a10-chip.selected {
            border-color: var(--cyan);
            background: rgba(34,211,238,.08);
            color: var(--cyan)
        }

        .a10-chip .ad {
            width: 7px;
            height: 7px;
            border-radius: 50%
        }

            .a10-chip .ad.on {
                background: var(--grn)
            }

            .a10-chip .ad.off {
                background: var(--red)
            }

    .a10-group {
        margin-bottom: 12px
    }

        .a10-group .ag-hdr {
            font-size: 11px;
            font-weight: 700;
            color: var(--tx2);
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 8px
        }

    .graph-box {
        background: var(--bg2);
        border: 1px solid var(--bdr);
        border-radius: 12px;
        padding: 14px;
        margin-top: 8px
    }

    .graph-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 10px
    }

        .graph-bar .gb-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--tx2);
            margin-right: auto
        }

        .graph-bar .gchk {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 11px;
            color: var(--tx2);
            cursor: pointer
        }

            .graph-bar .gchk input {
                accent-color: var(--blu)
            }

    .gbtn {
        background: var(--blu);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 6px 14px;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer
    }

        .gbtn:disabled {
            opacity: .5;
            cursor: not-allowed
        }

    .graph-stats {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 8px
    }

    .gstat {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--bg3);
        border: 1px solid var(--bdr);
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 11px;
        color: var(--tx2)
    }

        .gstat .gs-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%
        }

            .gstat .gs-dot.tcp {
                background: var(--blu)
            }

            .gstat .gs-dot.mqtt {
                background: var(--grn)
            }

        .gstat .pct {
            font-weight: 700;
            font-family: var(--mono)
        }

            .gstat .pct.good {
                color: var(--grn)
            }

            .gstat .pct.warn {
                color: var(--amb)
            }

            .gstat .pct.poor {
                color: var(--red)
            }

    .chart-wrap {
        position: relative;
        height: 300px
    }

    .graph-empty, .graph-loader {
        display: none;
        align-items: center;
        justify-content: center;
        height: 110px;
        color: var(--tx3);
        font-size: 12px;
        gap: 8px
    }

    .hist-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        max-height: 240px;
        overflow-y: auto;
        margin-top: 10px
    }

    .hist-row {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--bg3);
        border: 1px solid var(--bdr);
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 11.5px
    }

        .hist-row .hr-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0
        }

            .hist-row .hr-dot.on {
                background: var(--grn)
            }

            .hist-row .hr-dot.off {
                background: var(--red)
            }

        .hist-row .hr-time {
            font-family: var(--mono);
            color: var(--tx3);
            white-space: nowrap
        }

        .hist-row .hr-proto {
            font-size: 9px;
            font-weight: 700;
            padding: 1px 7px;
            border-radius: 8px
        }

            .hist-row .hr-proto.tcp {
                background: var(--blu-s);
                color: var(--blu)
            }

            .hist-row .hr-proto.mqtt {
                background: var(--grn-s);
                color: var(--grn)
            }

        .hist-row .hr-txt {
            color: var(--tx2)
        }

    .htl {
        position: relative;
        padding-left: 28px
    }

        .htl::before {
            content: "";
            position: absolute;
            left: 10px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--bdr)
        }

    .htl-item {
        position: relative;
        padding: 10px 16px;
        margin-bottom: 8px;
        background: var(--bg2);
        border: 1px solid var(--bdr);
        border-radius: 8px
    }

        .htl-item::before {
            content: "";
            position: absolute;
            left: -22px;
            top: 14px;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            border: 2px solid var(--bdr2)
        }

        .htl-item.st-critical::before {
            background: var(--red);
            border-color: var(--red)
        }

        .htl-item.st-warning::before {
            background: var(--amb);
            border-color: var(--amb)
        }

        .htl-item .htl-time {
            font-size: 11px;
            font-family: var(--mono);
            color: var(--tx3);
            margin-bottom: 3px
        }

        .htl-item .htl-event {
            font-size: 13px;
            font-weight: 600;
            color: var(--tx)
        }

        .htl-item .htl-sub {
            font-size: 11px;
            color: var(--tx2);
            margin-top: 3px;
            line-height: 1.4
        }

    /* "All fields" payload viewer */
    .m-details {
        margin: 10px 0;
        border: 1px solid var(--bdr);
        border-radius: 10px;
        background: var(--bg2);
        overflow: hidden
    }

        .m-details summary {
            cursor: pointer;
            padding: 10px 14px;
            font-size: 11px;
            font-weight: 700;
            color: var(--tx2);
            text-transform: uppercase;
            letter-spacing: .08em;
            user-select: none;
            list-style: none
        }

            .m-details summary::-webkit-details-marker {
                display: none
            }

            .m-details summary::before {
                content: "\25B8";
                margin-right: 8px;
                color: var(--tx3);
                display: inline-block;
                transition: transform .15s
            }

        .m-details[open] > summary::before {
            transform: rotate(90deg)
        }

        .m-details summary:hover {
            color: var(--tx)
        }

    .m-details-body {
        padding: 10px 14px;
        border-top: 1px solid var(--bdr)
    }

    .kv-group {
        margin: 12px 0 4px
    }

    .kv-group-t {
        font-size: 10px;
        font-weight: 700;
        color: var(--cyan);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 6px;
        border-left: 2px solid var(--cyan);
        padding-left: 8px
    }

    .kv-empty {
        font-size: 11px;
        color: var(--tx4);
        padding: 4px 0
    }

    .m-met .mv.kv-v {
        font-size: 12px;
        word-break: break-all
    }

    pre.raw-json {
        font-family: var(--mono);
        font-size: 10.5px;
        color: var(--tx2);
        background: var(--bg3);
        border: 1px solid var(--bdr);
        border-radius: 8px;
        padding: 10px;
        overflow: auto;
        max-height: 320px;
        white-space: pre-wrap;
        word-break: break-word;
        margin: 6px 0 0
    }

    .htl-empty, .pending-note {
        text-align: center;
        color: var(--tx3);
        padding: 26px;
        font-size: 12px;
        line-height: 1.7
    }

    .pending-note {
        background: var(--bg2);
        border: 1px dashed var(--bdr2);
        border-radius: 12px
    }

        .pending-note b {
            color: var(--tx2)
        }


    /* ===== HISTORY SIDEBAR + GRAPH POPUP ===== */
    .hmo-layout {
        display: grid;
        grid-template-columns: 310px minmax(0,1fr);
        gap: 14px;
        min-height: 100%;
    }

    .hmo-side {
        background: var(--bg2);
        border: 1px solid var(--bdr);
        border-radius: 14px;
        padding: 12px;
        max-height: calc(88vh - 158px);
        overflow-y: auto;
        position: sticky;
        top: 0;
    }

    .hmo-main {
        min-width: 0;
        background: var(--bg2);
        border: 1px solid var(--bdr);
        border-radius: 14px;
        padding: 16px;
        max-height: calc(88vh - 158px);
        overflow-y: auto;
    }

    .hmo-side-title {
        font-size: 10.5px;
        font-weight: 800;
        color: var(--tx3);
        text-transform: uppercase;
        letter-spacing: .1em;
        margin: 0 0 10px;
    }

    .hmo-main-hint {
        min-height: 220px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: var(--tx3);
        font-size: 12.5px;
        line-height: 1.7;
        border: 1px dashed var(--bdr2);
        border-radius: 12px;
        background: var(--bg3);
        padding: 24px;
    }

    .gmodal {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%) scale(.97);
        z-index: 3201;
        background: linear-gradient(180deg, var(--bg2), var(--bg3));
        border: 1px solid var(--bdr);
        border-radius: 16px;
        width: 980px;
        max-width: 94vw;
        max-height: 86vh;
        box-shadow: 0 28px 90px rgba(0,0,0,.50);
        backdrop-filter: var(--glass-blur);
        -webkit-backdrop-filter: var(--glass-blur);
        display: flex;
        flex-direction: column;
        opacity: 0;
        pointer-events: none;
        transition: all .22s;
    }

        .gmodal.open {
            opacity: 1;
            pointer-events: auto;
            transform: translate(-50%,-50%) scale(1);
        }

        .gmodal .graph-box {
            margin: 0;
            border: none;
            border-radius: 0;
            background: transparent;
        }

        .gmodal .chart-wrap {
            height: 390px;
        }

    @@media (max-width: 860px) {
        .hmo-layout {
            grid-template-columns: 1fr;
        }

        .hmo-side, .hmo-main {
            max-height: none;
            position: relative;
        }

        .gmodal .chart-wrap {
            height: 300px;
        }
    }



    /* ===== FULLSCREEN MODAL ===== */
    .modal.fullscreen {
        width: 100vw !important;
        max-width: 100vw !important;
        height: 100vh !important;
        max-height: 100vh !important;
        border-radius: 0;
        top: 0;
        left: 0;
        transform: none !important
    }

        .modal.fullscreen.open {
            transform: none !important
        }

        /* fullscreen + N/W two-pane: detail pane and device panel use full height */
        .modal.fullscreen .nw-modal-right {
            max-height: calc(100vh - 130px);
        }

        .modal.fullscreen .nw-modal-layout {
            min-height: calc(100vh - 150px);
        }

    .modal-fs-btn {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        border: 1px solid var(--bdr);
        background: transparent;
        cursor: pointer;
        color: var(--tx2);
        font-size: 13px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-right: 6px
    }

        .modal-fs-btn:hover {
            background: var(--bg3);
            color: var(--tx)
        }

    /* ===== RIGHT SIDEBAR ===== */
    .right-sidebar {
        position: fixed;
        top: 0;
        right: 0;
        width: 420px;
        max-width: 96vw;
        height: 100vh;
        background: linear-gradient(180deg,var(--bg2),var(--bg3));
        border-left: 1px solid var(--bdr);
        z-index: 3002;
        transform: translateX(100%);
        transition: transform .3s cubic-bezier(.4,0,.2,1);
        display: flex;
        flex-direction: column;
        box-shadow: -8px 0 40px rgba(0,0,0,.35)
    }

        .right-sidebar.open {
            transform: translateX(0)
        }

    .sb-hdr {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-bottom: 1px solid var(--bdr);
        flex-shrink: 0
    }

        .sb-hdr h3 {
            font-size: 14px;
            font-weight: 700;
            flex: 1;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap
        }

    .sb-body {
        flex: 1;
        overflow-y: auto;
        padding: 14px 16px;
        overscroll-behavior: contain;
        scrollbar-width: thin;
        scrollbar-color: var(--bdr2) transparent
    }

    .sb-close {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        border: 1px solid var(--bdr);
        background: transparent;
        cursor: pointer;
        color: var(--tx2);
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0
    }

        .sb-close:hover {
            background: var(--bg3);
            color: var(--tx)
        }

    .sb-tabs {
        display: flex;
        gap: 0;
        border-bottom: 2px solid var(--bdr);
        flex-shrink: 0
    }

    .sb-tab {
        flex: 1;
        text-align: center;
        padding: 10px 8px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        color: var(--tx3);
        border-bottom: 2px solid transparent;
        margin-bottom: -2px;
        text-transform: uppercase;
        letter-spacing: .06em
    }

        .sb-tab:hover {
            color: var(--tx)
        }

        .sb-tab.active {
            color: var(--cyan);
            border-bottom-color: var(--cyan)
        }

    .sb-sec {
        margin-bottom: 16px
    }

    .sb-sec-t {
        font-size: 10px;
        font-weight: 800;
        color: var(--tx3);
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 8px
    }

    .sb-stat-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        margin-bottom: 12px
    }

    .sb-stat {
        border: 1px solid var(--bdr);
        border-radius: 10px;
        padding: 10px;
        background: rgba(16,30,62,.6)
    }

    .sb-stat-label {
        font-size: 9px;
        color: var(--tx3);
        text-transform: uppercase;
        margin-bottom: 2px
    }

    .sb-stat-val {
        font-size: 16px;
        font-weight: 800
    }

    .sb-device {
        border: 1px solid var(--bdr);
        border-radius: 10px;
        padding: 10px;
        margin-bottom: 6px;
        cursor: pointer;
        transition: all .15s
    }

        .sb-device:hover {
            border-color: rgba(34,211,238,.55);
            background: rgba(34,211,238,.05)
        }

        .sb-device.selected {
            border-color: var(--cyan);
            background: rgba(34,211,238,.08)
        }

    .sb-dev-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px
    }

    .sb-dev-name {
        font-size: 12px;
        font-weight: 700
    }

    .sb-dev-tags {
        display: flex;
        gap: 4px
    }

    .sb-dev-tag {
        font-size: 9px;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 6px;
        border: 1px solid var(--bdr)
    }

        .sb-dev-tag.on {
            color: var(--grn);
            border-color: rgba(52,211,153,.4);
            background: rgba(52,211,153,.07)
        }

        .sb-dev-tag.off {
            color: var(--red);
            border-color: rgba(248,113,133,.4);
            background: rgba(248,113,133,.07)
        }

    .sb-dev-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 6px;
        font-size: 10px;
        color: var(--tx3)
    }

        .sb-dev-meta span {
            white-space: nowrap
        }

    .sb-cluster {
        border: 1px solid var(--bdr);
        border-radius: 12px;
        margin-bottom: 10px;
        overflow: hidden
    }

    .sb-cluster-hdr {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        cursor: pointer;
        background: rgba(16,30,62,.55)
    }

        .sb-cluster-hdr:hover {
            background: rgba(16,30,62,.85)
        }

    .sb-cluster-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: rgba(96,165,250,.12);
