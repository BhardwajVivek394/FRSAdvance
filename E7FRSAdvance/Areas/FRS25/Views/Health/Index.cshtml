    }

    // =====================================================================
    // LIVE DEVICE STATUS — Network (Modem) & IoT (A10)
    // Bound exactly like the Network Dashboard: per-site call to the
    // A10Status/GetStatus API (proxied by Health/GetSiteDeviceStatus) giving
    // real TCP / MQTT connectivity per modem and per A10.
    // =====================================================================
    var DS_MAX_CONCURRENT = 4, DS_MAX_SITES = 60, DS_CACHE_MS = 30000;
    var dsQueue = [], dsActive = 0;
    function dsEnqueue(job) { dsQueue.push(job); dsPump(); }
    function dsPump() {
        while (dsActive < DS_MAX_CONCURRENT && dsQueue.length) {
            var job = dsQueue.shift();
            dsActive++;
            job().then(function () { dsActive--; dsPump(); }, function () { dsActive--; dsPump(); });
        }
    }

    function normalizeDeviceStatus(resp) {
        var modems = (resp && Array.isArray(resp.Modems)) ? resp.Modems : [];
        var net = { total: 0, online: 0, offline: 0, tcpOnline: 0, mqttOnline: 0, devices: [] };
        var iot = { total: 0, online: 0, offline: 0, tcpOnline: 0, mqttOnline: 0, devices: [] };
        var normModems = [];
        modems.forEach(function (m) {
            var tcp = !!firstDefined(m.TcpStatus, m.tcpStatus, false);
            var mqtt = !!firstDefined(m.MqttStatus, m.mqttStatus, false);
            var online = firstDefined(m.IsOnline, m.isOnline);
            online = (online === null) ? (tcp || mqtt) : !!online;
            var name = String(firstDefined(m.ClusterName, m.clusterName, m.ModemName, m.modemName, "Modem"));
            var nm = {
                clusterId: num(firstDefined(m.ClusterId, m.clusterId), 0),
                clusterName: name,
                modemId: String(firstDefined(m.ModemId, m.modemId, "")),
                modemName: String(firstDefined(m.ModemName, m.modemName, name)),
                version: firstDefined(m.Version, m.version, ""),
                signal: firstDefined(m.SignalStrength, m.signalStrength),
                sim: firstDefined(m.SimNumber, m.simNumber, ""),
                tcp: tcp, mqtt: mqtt, online: online, a10s: []
            };
            net.total++;
            if (online) net.online++; else net.offline++;
            if (tcp) net.tcpOnline++;
            if (mqtt) net.mqttOnline++;
            if (!online) net.devices.push({
                name: name, modemId: nm.modemId,
                signal: (nm.signal !== null && nm.signal !== undefined && nm.signal !== "") ? nm.signal + " dBm" : "\u2014",
                tcp: tcp, mqtt: mqtt,
                a10Count: (firstDefined(m.A10List, m.a10List) || []).length,
                issue: "Modem offline"
            });
            (firstDefined(m.A10List, m.a10List) || []).forEach(function (a) {
                var aTcp = !!firstDefined(a.TcpStatus, a.tcpStatus, false);
                var aMqtt = !!firstDefined(a.MqttStatus, a.mqttStatus, a.MQTTStatus, false);
                var aOnline = aTcp || aMqtt;
                var aId = firstDefined(a.A10Id, a.a10Id, a.Id, a.id, "?");
                var na = {
                    a10Id: aId, clusterId: nm.clusterId, modemId: nm.modemId,
                    modemName: nm.modemName, clusterName: nm.clusterName,
                    tcp: aTcp, mqtt: aMqtt, online: aOnline,
                    type: firstDefined(a.ADCTypeName, a.adcTypeName, ""),
                    fw: firstDefined(a.FirmwareVersion, a.firmwareVersion, ""),
                    lastData: firstDefined(a.LastDataTime, a.lastDataTime, ""),
                    uptime: firstDefined(a.Uptime, a.uptime, "")
                };
                nm.a10s.push(na);
                iot.total++;
                if (aOnline) iot.online++; else iot.offline++;
                if (aTcp) iot.tcpOnline++;
                if (aMqtt) iot.mqttOnline++;
                if (!aOnline) iot.devices.push({
                    name: "A10-" + aId, type: na.type, tcp: aTcp, mqtt: aMqtt,
                    modemName: nm.modemName, clusterName: nm.clusterName,
                    issue: "TCP/MQTT disconnected"
                });
            });
            normModems.push(nm);
        });
        return { modems: normModems, network: net, iot: iot };
    }

    function applyDeviceStatus(siteId, norm) {
        var st = stations.find(function (s) { return String(s.siteId) === String(siteId); });
        if (!st) return;
        st.hardware.iot = st.hardware.iot || { total: 0, unhealthy: 0, issues: [] };
        st.hardware.network = st.hardware.network || { total: 0, unhealthy: 0, issues: [] };
        var iot = st.hardware.iot, net = st.hardware.network;
        iot.ds = norm.iot;
        iot.total = norm.iot.total;
        iot.unhealthy = norm.iot.offline;
        iot.issues = norm.iot.devices.map(function (d) { return d.name + " (" + d.modemName + ") \u2014 " + d.issue; });
        net.ds = norm.network;
        net.total = norm.network.total;
        net.unhealthy = norm.network.offline;
        net.issues = norm.network.devices.map(function (d) { return d.name + " [" + d.modemId + "] \u2014 " + d.issue; });
    }

    function fetchDeviceStatusForSite(siteId, force) {
        siteId = parseInt(siteId, 10) || 0;
        if (!siteId || !DEVICE_STATUS_URL || DEVICE_STATUS_URL === "null") return;
        var c = deviceStatusCache[siteId];
        if (c && (c.loading || (!force && c.ts && (Date.now() - c.ts) < DS_CACHE_MS))) return;
        deviceStatusCache[siteId] = deviceStatusCache[siteId] || {};
        deviceStatusCache[siteId].loading = true;
        deviceStatusCache[siteId].error = null;
        dsEnqueue(async function () {
            try {
                var r = await fetch(DEVICE_STATUS_URL + "?siteId=" + encodeURIComponent(siteId), { credentials: "same-origin" });
                if (!r.ok) throw new Error("HTTP " + r.status);
                var resp = await r.json();
                if (resp && resp.Success === false) throw new Error(resp.Message || "API error");
                var norm = normalizeDeviceStatus(resp);
                deviceStatusCache[siteId] = { loading: false, error: null, ts: Date.now(), modems: norm.modems };
                applyDeviceStatus(siteId, norm);
            } catch (e) {
                deviceStatusCache[siteId] = { loading: false, error: e.message, ts: Date.now() };
                log("Device status failed (site " + siteId + "): " + e.message, "err");
            }
            renderThrottled();
        });
    }

    function loadVisibleDeviceStatus(force) {
        getFilteredStations().slice(0, DS_MAX_SITES).forEach(function (st) {
            fetchDeviceStatusForSite(st.siteId, force);
        });
    }

    var _renderTimer = null;
    function renderThrottled() {
        if (_renderTimer) return;
        _renderTimer = setTimeout(function () { _renderTimer = null; render(); }, 150);
    }

    // Live connectivity section used inside the hardware detail modal.
    function buildConnectivitySection(stn, type) {
        if (type !== "iot" && type !== "network") return "";
        var hw = safeObj(stn.hardware[type]);
        var ds = hw.ds;
        var dsc = deviceStatusCache[parseInt(stn.siteId, 10) || 0] || {};
        var title = type === "iot" ? "A10 Connectivity (live TCP / MQTT)" : "Modem Connectivity (live TCP / MQTT)";
        var html = '<div class="m-sec"><div class="m-sec-t">' + title + '</div>';
        if (!ds) {
            if (dsc.loading) html += '<div class="htl-empty">\u23F3 Loading device status\u2026</div>';
            else html += '<div class="htl-empty">Device status not loaded' + (dsc.error ? ' (' + esc(dsc.error) + ')' : '') +
                '. <button class="paste-btn" onclick="HealthDash.loadSiteDevices(' + num(stn.siteId) + ',\'' + type + '\')">Load Now</button></div>';
            return html + '</div>';
        }
        html += '<div class="m-metrics" style="margin-bottom:10px">';
        html += '<div class="m-met"><div class="ml">Total</div><div class="mv">' + ds.total + '</div></div>';
        html += '<div class="m-met"><div class="ml">Online</div><div class="mv" style="color:var(--grn)">' + ds.online + '</div></div>';
        html += '<div class="m-met"><div class="ml">Offline</div><div class="mv' + (ds.offline > 0 ? ' bad' : '') + '">' + ds.offline + '</div></div>';
        html += '<div class="m-met"><div class="ml">TCP Online</div><div class="mv">' + ds.tcpOnline + '</div></div>';
        html += '<div class="m-met"><div class="ml">MQTT Online</div><div class="mv">' + ds.mqttOnline + '</div></div>';
        html += '</div>';
        if (ds.devices.length) {
            ds.devices.forEach(function (d) {
                html += '<div class="hw-device"><div class="hd-top"><div class="hd-name">' + (type === "iot" ? "\u25CF " : "\uD83D\uDCE1 ") + esc(d.name) + '</div>' +
                    '<div class="hd-tags">' +
                    '<span class="conn-tag ' + (d.tcp ? "tag-on" : "tag-off") + '"><span class="ct-dot"></span>TCP</span>' +
                    '<span class="conn-tag ' + (d.mqtt ? "tag-on" : "tag-off") + '"><span class="ct-dot"></span>MQTT</span>' +
                    '</div></div>' +
                    '<div class="hd-meta">' +
                    (d.modemId ? '<span>Modem: ' + esc(d.modemId) + '</span>' : (d.modemName ? '<span>Modem: ' + esc(d.modemName) + '</span>' : '')) +
                    (d.type ? '<span>Type: ' + esc(d.type) + '</span>' : '') +
                    (d.signal ? '<span>Signal: ' + esc(d.signal) + '</span>' : '') +
                    (d.a10Count ? '<span>A10s: ' + d.a10Count + '</span>' : '') +
                    '</div></div>';
            });
        } else {
            html += '<div style="text-align:center;color:var(--grn);padding:10px;font-size:12px">\u2705 All ' + ds.total + ' device' + (ds.total === 1 ? '' : 's') + ' online</div>';
        }
        html += '<div style="margin-top:8px;text-align:right"><button class="paste-btn" onclick="HealthDash.openHistory(\'' + esc(String(stn.siteId)) + '\')">\u23F1 View History &amp; Graphs</button></div>';
        return html + '</div>';
    }

