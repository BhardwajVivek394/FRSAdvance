        border-top: 1px solid var(--bdr);
        display: none
    }

    .sb-cluster.expanded .sb-cluster-body {
        display: block
    }

    .sb-cluster-chevron {
        font-size: 10px;
        color: var(--tx3);
        transition: transform .2s
    }

    .sb-cluster.expanded .sb-cluster-chevron {
        transform: rotate(90deg)
    }

    /* Graph popup */
    .graph-modal {
        position: fixed;
        inset: 0;
        z-index: 3010;
        display: none
    }

        .graph-modal.open {
            display: flex;
            align-items: center;
            justify-content: center
        }

    .graph-ov {
        position: absolute;
        inset: 0;
        background: rgba(0,0,0,.6);
        backdrop-filter: blur(4px)
    }

    .graph-panel {
        position: relative;
        z-index: 1;
        width: min(1100px,96vw);
