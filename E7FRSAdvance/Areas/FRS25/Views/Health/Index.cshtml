    function nwFilterHist() {
        var sel = document.getElementById('nwHistProto');
        if (!sel) return;
        var f = sel.value.toLowerCase();
        var cards = document.querySelectorAll('#nwHistList .nw-hist-card');
        var vis = 0;
        for (var i = 0; i < cards.length; i++) {
            var p = (cards[i].getAttribute('data-protocol') || '').toLowerCase();
            var show = (f === 'all' || f === p);
