            // inline PIN modal
            '<div class="nw-inline-modal" id="nwPinBox" style="display:none"><div class="nw-im-t">Enter PIN Number (1-10)</div>' +
            '<select id="nwPinSel">' + (function () { var o = ''; for (var i = 1; i <= 10; i++) o += '<option value="' + i + '">' + i + '</option>'; return o; })() + '</select>' +
            '<div class="nw-im-btns"><button class="paste-btn" onclick="HealthDash.nwPinConfirm()">Send</button><button class="paste-btn alt" onclick="HealthDash.nwPinCancel()">Cancel</button></div></div>' +
            // inline time-set modal
            '<div class="nw-inline-modal" id="nwTimeBox" style="display:none"><div class="nw-im-t">\uD83D\uDCC5 Set Device Time</div>' +
            '<label>Date<input type="date" id="nwTimeDate" onchange="HealthDash.nwEpochPrev()"></label>' +
            '<label>Time<input type="time" id="nwTimeTime" onchange="HealthDash.nwEpochPrev()"></label>' +
            '<div class="nw-note" id="nwEpochPrev">Epoch: --</div>' +
            '<div class="nw-im-btns"><button class="paste-btn" onclick="HealthDash.nwTimeConfirm()">Send</button><button class="paste-btn alt" onclick="HealthDash.nwTimeCancel()">Cancel</button></div></div>' +
            // console
            '<div class="sb-sec-t" style="margin-top:12px">Console <span class="nw-substate" id="nwA10ConInfo">Ready</span></div>' +
            '<div class="nw-console"><div class="nw-con-hdr"><span>\u25CF A10 Terminal <span class="nw-tag mqtt">MQTT</span></span><span><button class="nw-con-btn" onclick="HealthDash.nwClearCon(\'nwA10ConBody\')">Clear</button></span></div>' +
            '<div class="nw-con-body" id="nwA10ConBody"><div class="nw-con-line info"><pre>// A10-' + nwS(a10.a10Id) + ' ready (MQTT)</pre></div></div>' +
            '<div class="nw-con-input"><span class="nw-mono">&gt;</span><input type="text" id="nwA10Input" placeholder="Enter JSON command..." onkeypress="if(event.key===\'Enter\')HealthDash.nwA10ConsoleSend()"><button class="paste-btn" onclick="HealthDash.nwA10ConsoleSend()">Send</button></div></div>' +
            '</div>';
    }
    function nwSendA10Cmd(cmdType) {
        if (!nwCur || nwCur.kind !== 'a10') { return; }
        if (nwCur.ver === 1) { nwLog('nwA10ConBody', 'error', 'A10 commands not available for V1 Modem'); return; }
        if (cmdType === 'channel_set') { nwChannelSet(); return; }
        if (cmdType === 'time_set') {
            var now = new Date();
            var d = document.getElementById('nwTimeDate'), t = document.getElementById('nwTimeTime');
            if (d) d.value = now.toISOString().slice(0, 10);
            if (t) t.value = ('0' + now.getHours()).slice(-2) + ':' + ('0' + now.getMinutes()).slice(-2);
            nwEpochPrev();
            var box = document.getElementById('nwTimeBox'); if (box) box.style.display = 'block';
            return;
        }
        if (NW_PIN_CMDS.indexOf(cmdType) !== -1) {
            nwPendingPin = cmdType;
            var pb = document.getElementById('nwPinBox'); if (pb) pb.style.display = 'block';
            return;
        }
        nwExecA10Cmd(cmdType, 1);
    }
    function nwExecA10Cmd(cmdType, value) {
        var cmd = { id: parseInt(nwCur.a10.a10Id, 10) || 1 };
        cmd[cmdType] = value;
        nwSendA10Json(JSON.stringify(cmd));
    }
    function nwPinConfirm() {
        var pin = parseInt((document.getElementById('nwPinSel') || {}).value, 10) || 1;
        var pb = document.getElementById('nwPinBox'); if (pb) pb.style.display = 'none';
        if (nwPendingPin) { nwExecA10Cmd(nwPendingPin, pin); nwPendingPin = null; }
    }
    function nwPinCancel() { nwPendingPin = null; var pb = document.getElementById('nwPinBox'); if (pb) pb.style.display = 'none'; }
    function nwEpochPrev() {
        var d = (document.getElementById('nwTimeDate') || {}).value, t = (document.getElementById('nwTimeTime') || {}).value;
        var el = document.getElementById('nwEpochPrev');
        if (!el) return;
        if (!d || !t) { el.textContent = 'Epoch: --'; return; }
        el.textContent = 'Epoch: ' + Math.floor(new Date(d + 'T' + t).getTime() / 1000);
    }
    function nwTimeConfirm() {
        var d = (document.getElementById('nwTimeDate') || {}).value, t = (document.getElementById('nwTimeTime') || {}).value;
        if (!d || !t) { nwLog('nwA10ConBody', 'error', 'Please select date and time'); return; }
        var dt = new Date(d + 'T' + t);
        var epoch = Math.floor(dt.getTime() / 1000);
        nwTimeCancel();
        nwLog('nwA10ConBody', 'info', 'Setting time to: ' + dt.toLocaleString() + ' (Epoch: ' + epoch + ')');
        nwSendA10Json(JSON.stringify({ id: parseInt(nwCur.a10.a10Id, 10) || 1, time_set: epoch }));
    }
    function nwTimeCancel() { var b = document.getElementById('nwTimeBox'); if (b) b.style.display = 'none'; }
    function nwChannelSet() {
        var channel = prompt('Enter channel number (1-10):'); if (!channel) return;
        var mode = prompt('Enter mode (0-7):'); if (mode === null) return;
        var threshold = prompt('Enter threshold (default 60):');
        var mul = prompt('Enter multiplier (default 328):');
        var div = prompt('Enter divisor (default 100):');
        var offset = prompt('Enter offset (default 0):');
        nwSendA10Json(JSON.stringify({
            id: parseInt(nwCur.a10.a10Id, 10) || 1,
            channel_set: parseInt(channel, 10),
            mode: parseInt(mode, 10) || 0,
            threshold: parseInt(threshold, 10) || 60,
            mul: parseInt(mul, 10) || 328,
            div: parseInt(div, 10) || 100,
            offset: parseInt(offset, 10) || 0
        }));
    }
    function nwSendA10Json(cmdJson) {
        if (!nwCur || nwCur.kind !== 'a10') return;
        if (nwCmdPending) { nwLog('nwA10ConBody', 'error', 'Command in progress...'); return; }
        var m = nwCur.modem;
        var base = m ? m.mqttBase : 'rdpms';
        var cluster = m ? (m.clusterName || m.modemName) : nwCur.a10.clusterName;
        if (!cluster) { nwLog('nwA10ConBody', 'error', 'Cluster name not configured'); return; }
        nwLog('nwA10ConBody', 'cmd', '[MQTT] > ' + cmdJson);
        nwCmdPending = true;
        var info = document.getElementById('nwA10ConInfo');
        if (info) info.textContent = 'Sending...';
        nwMqttCmd(base, cluster, cmdJson, function (ok, data, lat) {
            nwCmdPending = false;
            if (ok && data) {
                nwLog('nwA10ConBody', 'response', nwPretty(data), lat);
                if (info) info.textContent = 'OK (' + lat + 'ms)';
            } else {
                nwLog('nwA10ConBody', 'error', data || 'No response (timeout)');
                if (info) info.textContent = 'Timeout';
            }
        });
    }
    function nwA10ConsoleSend() {
        var input = document.getElementById('nwA10Input');
        if (input && input.value.trim()) { nwSendA10Json(input.value.trim()); input.value = ''; }
    }

    // =====================================================================
    // ASSET VIEW (port of _DevicePanel switchView / renderAssetView)
    // Categorize devices by Asset -> Attribute -> ADC, via NetworkDashboard JSON
    // =====================================================================
    function nwSwitchDevView(siteId, type, view) {
        nwDevView[type + '_' + siteId] = view;
        openHW(String(siteId), type);
        if (view === 'asset') nwEnsureAssetTypes(siteId, type);
    }
    function nwEnsureAssetTypes(siteId, type) {
        var c = nwAssetCache[siteId];
        if (c && (c.types || c.loading)) return;
        nwAssetCache[siteId] = { loading: true, types: null, trees: {} };
        fetch(NW_ASSET_TYPES_URL + '?siteId=' + encodeURIComponent(siteId), { credentials: 'same-origin' })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (j) {
                nwAssetCache[siteId].loading = false;
                nwAssetCache[siteId].types = Array.isArray(j) ? j : [];
                openHW(String(siteId), type);
            })
            .catch(function () { nwAssetCache[siteId].loading = false; nwAssetCache[siteId].types = []; openHW(String(siteId), type); });
    }
    function nwAssetSectionHtml(siteId, type) {
        var c = nwAssetCache[siteId] || {};
        var h = '<div class="nw-asset-bar"><label>Asset Type <select id="nwAssetTypeSel_' + type + '" onchange="HealthDash.nwAssetTypeChange(\'' + nwS(siteId) + '\',\'' + type + '\',this.value)">';
        h += '<option value="">-- Select Asset Type --</option>';
        (c.types || []).forEach(function (it) {
            var id = firstDefined(it.Id, it.id, ''), nm = firstDefined(it.Name, it.name, '');
            h += '<option value="' + nwS(id) + '"' + (String(c.selType) === String(id) ? ' selected' : '') + '>' + nwS(nm) + '</option>';
        });
        h += '</select></label></div>';
        if (c.loading) return h + '<div class="htl-empty">\u23F3 Loading asset types\u2026</div>';
        if (!c.types) return h + '<div class="htl-empty">Asset types not loaded</div>';
        if (!c.selType) return h + '<div class="nw-empty">Select an asset type to view assets, attributes &amp; ADCs</div>';
        var tree = c.trees[c.selType];
        if (tree === 'loading') return h + '<div class="htl-empty">\u23F3 Loading assets\u2026</div>';
        if (!tree || !tree.length) return h + '<div class="nw-empty">No assets found for this type</div>';
        // group: Asset -> Attribute -> ADC
        var groups = {};
        tree.forEach(function (item) {
            var an = firstDefined(item.AssetName, item.assetName, 'Unknown');
            if (!groups[an]) groups[an] = { typeName: firstDefined(item.AssetTypeName, item.assetTypeName, ''), attrs: {} };
            var at = firstDefined(item.AttributeName, item.attributeName, 'Unknown');
            if (!groups[an].attrs[at]) groups[an].attrs[at] = [];
            groups[an].attrs[at].push(item);
        });
        Object.keys(groups).sort().forEach(function (an) {
            var g = groups[an];
            var aid = 'nwag_' + type + '_' + an.replace(/[^a-zA-Z0-9]/g, '_');
            h += '<div class="nw-asset-grp"><div class="nw-asset-hdr" onclick="HealthDash.nwToggleAsset(\'' + aid + '\',this)"><span class="nw-chev">\u25B6</span>\uD83D\uDCE6 <b>' + nwS(an) + '</b>' +
                '<span class="nw-badge">' + nwS(g.typeName) + '</span><span class="nw-badge nw-badge-mqtt" style="margin-left:auto">' + Object.keys(g.attrs).length + ' Attributes</span></div>' +
                '<div class="nw-asset-body" id="' + aid + '" style="display:none">';
            Object.keys(g.attrs).forEach(function (at) {
                var adcs = g.attrs[at];
                var atid = aid + '_at_' + at.replace(/[^a-zA-Z0-9]/g, '_');
                h += '<div class="nw-attr-hdr" onclick="HealthDash.nwToggleAsset(\'' + atid + '\',this)"><span class="nw-chev">\u25B6</span>\uD83C\uDF9A ' + nwS(at) + '<span class="nw-badge" style="margin-left:auto">' + adcs.length + ' ADCs</span></div>' +
                    '<div class="nw-adc-list" id="' + atid + '" style="display:none">';
                adcs.forEach(function (adc) {
                    var adcNum = firstDefined(adc.ADCNumber, adc.adcNumber, '?');
                    var pin = firstDefined(adc.Pin, adc.pin, '?');
                    var clId = firstDefined(adc.ClusterId, adc.clusterId, '');
                    var clName = firstDefined(adc.ClusterName, adc.clusterName, '');
                    h += '<div class="nw-adc-item" onclick="HealthDash.nwOpenAdc(\'' + nwS(siteId) + '\',\'' + nwS(adcNum) + '\',\'' + nwS(clId) + '\')">' +
                        '\uD83D\uDD0C <b>ADC-' + nwS(adcNum) + '</b><span>Pin ' + nwS(pin) + '</span><span class="nw-badge">' + nwS(clName || '-') + '</span></div>';
                });
                h += '</div>';
            });
            h += '</div></div>';
        });
        return h;
    }
    function nwAssetTypeChange(siteId, type, assetTypeId) {
        var c = nwAssetCache[siteId];
        if (!c) return;
        c.selType = assetTypeId;
        if (!assetTypeId) { openHW(String(siteId), type); return; }
        if (c.trees[assetTypeId] && c.trees[assetTypeId] !== 'loading') { openHW(String(siteId), type); return; }
        c.trees[assetTypeId] = 'loading';
        openHW(String(siteId), type);
        fetch(NW_YARD_CONFIG_URL + '?siteId=' + encodeURIComponent(siteId) + '&assetTypeId=' + encodeURIComponent(assetTypeId), { credentials: 'same-origin' })
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (j) {
                var data = [];
                if (j && (j.Success || j.success) && (j.Data || j.data)) data = j.Data || j.data;
                else if (Array.isArray(j)) data = j;
                c.trees[assetTypeId] = data;
                openHW(String(siteId), type);
            })
            .catch(function () { c.trees[assetTypeId] = []; openHW(String(siteId), type); });
    }
    function nwToggleAsset(id, hdr) {
        var el = document.getElementById(id);
        if (!el) return;
        var open = el.style.display !== 'none';
        el.style.display = open ? 'none' : 'block';
        var ch = hdr.querySelector('.nw-chev');
        if (ch) ch.style.transform = open ? '' : 'rotate(90deg)';
    }
    function nwOpenAdc(siteId, adcNumber, clusterId) {
        // ADC -> open the matching A10 sidebar (command-capable) for its cluster
        var dsc = deviceStatusCache[parseInt(siteId, 10) || 0] || {};
        var modem = (dsc.modems || []).find(function (m) { return String(m.clusterId) === String(clusterId); });
        var a10 = null;
        if (modem && modem.a10s) a10 = modem.a10s.find(function (a) { return String(a.adcNumber) === String(adcNumber) || String(a.a10Id) === String(adcNumber); });
        if (modem && a10) { openDeviceSidebar(siteId, String(a10.a10Id) + '~' + String(modem.clusterId), 'a10'); return; }
        if (modem) {
            // pseudo A10 from yard config (device not in live status payload)
            var stn = stations.find(function (s) { return String(s.siteId) === String(siteId); });
            nwOpenA10Sb(siteId, stn ? stn.stationName : ('Site ' + siteId), modem, {
                a10Id: adcNumber, clusterId: modem.clusterId, modemId: modem.modemId,
                clusterName: modem.clusterName, tcp: false, mqtt: false, type: '', fw: '', lastData: '', uptime: '', slave: adcNumber, adcNumber: adcNumber
            });
        }
    }

    // ===== DEVICE GRAPH POPUP =====
    function openDeviceGraph(siteId, clusterId, a10Id, type, title) {
        if (graphChart) { try { graphChart.destroy(); } catch (e) {} graphChart = null; }
        var today = new Date().toISOString().slice(0, 10);
        var gpm = document.getElementById("gpm");
        var hdr = '<h3><svg viewBox="0 0 24 24" style="width:18px;height:18px"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg> ' + esc(title || 'Device Graph') + '</h3>' +
            '<button class="modal-fs-btn" onclick="HealthDash.toggleGraphFullscreen()" title="Fullscreen">\u26F6</button>' +
            '<button class="sb-close" onclick="HealthDash.closeGraph()">&#215;</button>';
        var body = '<div class="graph-controls">' +
            '<label>From: <input type="date" id="gpFrom" value="' + today + '"></label>' +
            '<label>To: <input type="date" id="gpTo" value="' + today + '"></label>' +
            '<label><input type="checkbox" id="gpTcp" checked> TCP</label>' +
            '<label><input type="checkbox" id="gpMqtt" checked> MQTT</label>' +
            '<button class="paste-btn" onclick="HealthDash.loadDeviceGraph()">Load</button>' +
            '</div>' +
            '<div class="graph-stats" id="gpStats"></div>' +
            '<div class="graph-loader" id="gpLoader" style="display:none"><span class="graph-spinner"></span>Loading history\u2026</div>' +
            '<div class="graph-empty" id="gpEmpty" style="display:none">No history found for this date range</div>' +
            '<div class="graph-canvas-wrap" id="gpChartWrap" style="display:none"><canvas id="gpCanvas"></canvas></div>';
        document.getElementById("gpHdr").innerHTML = hdr;
        document.getElementById("gpBody").innerHTML = body;
        gpm.classList.add("open");
        gpm._ctx = { siteId: siteId, clusterId: clusterId, a10Id: a10Id, type: type };
        gpm._lastData = null;
        // Re-draw from cached data when TCP / MQTT toggles change (no refetch needed)
        document.getElementById("gpTcp").onchange = function () { if (gpm._lastData) renderDeviceGraph(gpm._lastData); };
        document.getElementById("gpMqtt").onchange = function () { if (gpm._lastData) renderDeviceGraph(gpm._lastData); };
        loadDeviceGraph();
    }

    function loadDeviceGraph() {
        var gpm = document.getElementById("gpm");
        var ctx = gpm._ctx; if (!ctx) return;
        var from = document.getElementById("gpFrom").value;
        var to = document.getElementById("gpTo").value;
        // "yyyy-mm-dd" -> "dd-MM-yyyy" via string split: new Date("yyyy-mm-dd") parses as
        // UTC midnight and could shift to the previous day in negative-offset timezones.
        function apiDate(s) { var p = String(s).split("-"); return p.length === 3 ? (p[2] + "-" + p[1] + "-" + p[0]) : s; }
        var url;
        if (ctx.type === "modem") {
            url = MODEM_GRAPH_URL + '?clusterId=' + encodeURIComponent(ctx.clusterId) + '&fromDate=' + encodeURIComponent(apiDate(from)) + '&toDate=' + encodeURIComponent(apiDate(to));
        } else {
            url = A10_GRAPH_URL + '?clusterId=' + encodeURIComponent(ctx.clusterId) + '&a10Id=' + encodeURIComponent(ctx.a10Id) + '&fromDate=' + encodeURIComponent(apiDate(from)) + '&toDate=' + encodeURIComponent(apiDate(to));
        }
        document.getElementById("gpLoader").style.display = "flex";
        document.getElementById("gpEmpty").style.display = "none";
        document.getElementById("gpChartWrap").style.display = "none";
        document.getElementById("gpStats").innerHTML = "";
        if (graphChart) { try { graphChart.destroy(); } catch (e) {} graphChart = null; }
        fetch(url, { credentials: "same-origin" }).then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); }).then(function (j) {
            document.getElementById("gpLoader").style.display = "none";
            var data = Array.isArray(j) ? j : (j.Data || j.data || []);
            gpm._lastData = data;
            renderDeviceGraph(data, from, to);
        }).catch(function (e) {
            document.getElementById("gpLoader").style.display = "none";
            document.getElementById("gpEmpty").style.display = "flex";
            document.getElementById("gpEmpty").innerHTML = "Failed: " + esc(e.message);
        });
    }

    function renderDeviceGraph(data, fromDate, toDate) {
        var showTcp = document.getElementById("gpTcp").checked;
        var showMqtt = document.getElementById("gpMqtt").checked;
        var rows = (data || []).map(function (x) {
            return {
                time: parseGraphTs(firstDefined(x.TimeStamp, x.timestamp, x.Timestamp, x.timeStamp, x.CreatedOn, x.DateTime)),
                type: Number(firstDefined(x.TypeId, x.typeId, 0)) || 0,
                signal: Number(firstDefined(x.SignalStrength, x.signalStrength, 0)) || 0,
                response: Number(firstDefined(x.ResponseTime, x.responseTime, 0)) || 0,
                uptime: Number(firstDefined(x.Uptime, x.uptime, 0)) || 0
            };
        }).filter(function (x) {
            // signal !== 0 (NOT > 0): modem signal strength is negative dBm
            return x.time !== null && (x.signal !== 0 || x.response > 0 || x.uptime > 0);
        });
        rows = rows.filter(function (x) { return (x.type === 1 && showTcp) || (x.type === 2 && showMqtt) || (!x.type); });
        rows.sort(function (a, b) { return a.time - b.time; });
        if (!rows.length) { document.getElementById("gpChartWrap").style.display = "none"; document.getElementById("gpStats").innerHTML = ""; document.getElementById("gpEmpty").style.display = "flex"; return; }
        document.getElementById("gpEmpty").style.display = "none";
        document.getElementById("gpChartWrap").style.display = "block";
        var tcp = rows.filter(function (x) { return x.type === 1; });
        var mqtt = rows.filter(function (x) { return x.type === 2; });
        function yVal(x) { return x.signal !== 0 ? x.signal : (x.response || x.uptime); }
        var hasNeg = rows.some(function (x) { return yVal(x) < 0; });
        document.getElementById("gpStats").innerHTML = '<div class="graph-stat"><b>' + rows.length + '</b><span>Total samples</span></div>' +
            '<div class="graph-stat"><b>' + tcp.length + '</b><span>TCP samples</span></div>' +
            '<div class="graph-stat"><b>' + mqtt.length + '</b><span>MQTT samples</span></div>' +
            '<div class="graph-stat"><b>' + esc(new Date(rows[rows.length - 1].time).toLocaleString()) + '</b><span>Last point</span></div>';
        if (graphChart) { try { graphChart.destroy(); } catch (e) {} graphChart = null; }
        var canvas = document.getElementById("gpCanvas");
        graphChart = new Chart(canvas, {
            type: "line",
            data: {
                datasets: [
                    { label: "TCP", data: tcp.map(function (x) { return { x: x.time, y: yVal(x) }; }), borderColor: "#3b82f6", backgroundColor: "rgba(59,130,246,.1)", borderWidth: 2, fill: true, tension: .25, pointRadius: 1, pointHoverRadius: 6 },
                    { label: "MQTT", data: mqtt.map(function (x) { return { x: x.time, y: yVal(x) }; }), borderColor: "#22c55e", backgroundColor: "rgba(34,197,94,.1)", borderWidth: 2, fill: true, tension: .25, pointRadius: 1, pointHoverRadius: 6 }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false, parsing: false, normalized: true,
                interaction: { mode: "index", intersect: false },
                plugins: {
                    legend: { labels: { color: "#e7edf7" } },
                    tooltip: { callbacks: { title: function (c) { return new Date(c[0].parsed.x).toLocaleString(); } } }
                },
                scales: {
                    x: { type: "time", time: { displayFormats: { minute: "HH:mm", hour: "HH:mm", day: "dd MMM" } }, ticks: { color: "#9fb1d1", maxRotation: 45 }, grid: { color: "rgba(96,116,154,.18)" } },
                    y: { min: hasNeg ? undefined : 0, ticks: { color: "#9fb1d1", callback: function (v) { return v === 0 ? "Off" : v; } }, grid: { color: "rgba(96,116,154,.18)" } }
                }
            }
        });
    }

