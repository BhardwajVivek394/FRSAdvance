    function evalPoint(d) {
        d = safeObj(d);
        if (!Object.keys(d).length) return unknownSvc("Point Machine");
        var nf = parseConnectionsFormat(d); if (nf) return nf;

        var mqttPresent = firstDefined(d.mqttConnected, d.MqttConnected, d.mqttConnectionStatus, d.MqttConnectionStatus, null) !== null;
        var wsPresent = firstDefined(d.wsConnected, d.webSocketConnected, d.WebSocketConnected, d.wsConnectionStatus, null) !== null;
        var dbPresent = firstDefined(d.dbConnected, d.databaseConnected, d.DatabaseConnected, null) !== null;

        var mqttOk = boolFrom(firstDefined(d.mqttConnected, d.MqttConnected, d.mqttConnectionStatus, d.MqttConnectionStatus, true));
        var wsOk = boolFrom(firstDefined(d.wsConnected, d.webSocketConnected, d.WebSocketConnected, d.wsConnectionStatus, true));
        var dbOk = boolFrom(firstDefined(d.dbConnected, d.databaseConnected, d.DatabaseConnected, true));

        var issues = [], conns = [];
        if (mqttPresent || !wsPresent) conns.push({ l: "MQTT", ok: mqttOk });
        if (wsPresent) conns.push({ l: "WS", ok: wsOk });
        if (dbPresent) conns.push({ l: "DB", ok: dbOk });

        if (!mqttOk) issues.push({ sev: "critical", msg: "MQTT disconnected" });
        if (!wsOk) issues.push({ sev: "critical", msg: "WebSocket disconnected" });
        if (!dbOk) issues.push({ sev: "critical", msg: "Database disconnected" });

        var received = num(firstDefined(d.totalEventReceive, d.totalReceived, d.messagesReceived, d.received, d.rxMqtt));
        var invalid = num(firstDefined(d.totalInvalidEvent, d.invalidEvents, d.invalid, d.rxCorrupted));
        var ir = received > 0 ? (invalid / received * 100) : 0;
        if (ir > 20) issues.push({ sev: "warning", msg: "Invalid: " + ir.toFixed(0) + "%" });
        if (num(d.rxCorrupted) > 5) issues.push({ sev: "warning", msg: num(d.rxCorrupted) + " corrupted" });
        if (num(firstDefined(d.mqttSilence, d.mqttSilenceSec, d.silenceSeconds)) > 60) issues.push({ sev: "warning", msg: "Silent " + num(firstDefined(d.mqttSilence, d.mqttSilenceSec, d.silenceSeconds)) + "s" });

        var allOk = mqttOk && wsOk && dbOk;
        return {
            status: !allOk ? "critical" : issues.some(function (i) { return i.sev === "warning"; }) ? "warning" : "healthy",
            conns: conns,
            issues: issues,
            metrics: {
                Received: received,
                Saved: num(firstDefined(d.totalEventSave, d.totalSaved, d.saved)),
                Broadcast: num(firstDefined(d.totalEventBroadcast, d.totalBroadcast, d.broadcast)),
