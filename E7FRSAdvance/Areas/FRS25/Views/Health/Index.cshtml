        var t = new Date(st._updatedAt).getTime();
        if (isNaN(t)) return Infinity;
        return Date.now() - t;
    }
    function isStationStale(st) { return stationDataAgeMs(st) > STALE_THRESHOLD_MS; }

    function evalStation(st) {
        var svcs = SVC_ORDER.map(function (s) { return Object.assign(EV[s.key](getSvcData(st.services, s.key)), { key: s.key, label: s.label, icon: s.icon }); });
