        if (!mOk) issues.push({ sev: "critical", msg: "MQTT disconnected" });
        if (!ingressOk) issues.push({ sev: "critical", msg: "Datalogger ingress down" });
        if (!mqttH) issues.push({ sev: "critical", msg: "MQTT: " + mqttState });
        if (num(remote.failures_last_60s) > 0) issues.push({ sev: "warning", msg: num(remote.failures_last_60s) + " MQTT failures/60s" });
        if (num(remote.unhealthy_episodes_24h) > 3) issues.push({ sev: "warning", msg: num(remote.unhealthy_episodes_24h) + " unhealthy episodes 24h" });
        if (num(loss.buffer_clear_loss_lifetime) > 0) issues.push({ sev: "warning", msg: num(loss.buffer_clear_loss_lifetime) + " buffer loss" });
