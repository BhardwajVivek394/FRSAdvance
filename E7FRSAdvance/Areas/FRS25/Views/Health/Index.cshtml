        var warn = ev.filter(function (e) { return e.svcs.some(function (s) { return s.status === "warning"; }) && !e.svcs.some(function (s) { return s.status === "critical"; }); }).length;
        var ok = ev.filter(function (e) { return e.svcs.length && e.svcs.every(function (s) { return s.status === "healthy" || s.status === "unknown"; }) && !e.svcs.some(function (s) { return s.status === "unknown"; }); }).length;
