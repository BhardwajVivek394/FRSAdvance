<script>
var CFG = ${cfgJson};
var modems = [], devErr = null, devLoading = true;
var sel = null, selType = null, chart = null, lastData = null, activeTab = "network";
function el(id){ return document.getElementById(id); }
function esc(v){ return String(v == null ? "" : v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
function num(v,d){ var n = Number(v); return isFinite(n) ? n : (d || 0); }
function fd(){ for (var i = 0; i < arguments.length; i++) if (arguments[i] !== undefined && arguments[i] !== null && arguments[i] !== "") return arguments[i]; return null; }
function isoDay(d){ return d.toISOString().slice(0,10); }
function fmtApi(s){ var d = new Date(s); return String(d.getDate()).padStart(2,"0") + "-" + String(d.getMonth()+1).padStart(2,"0") + "-" + d.getFullYear(); }
el("stn").textContent = CFG.siteName;
el("meta").innerHTML = esc(CFG.zone) + " &rsaquo; " + esc(CFG.division) + " &middot; <b>Site ID: " + esc(CFG.siteId) + "</b>";
el("gen").textContent = "Generated: " + CFG.generatedAt;
el("dFrom").value = isoDay(new Date()); el("dTo").value = isoDay(new Date());
var TABS = [{k:"network",l:"Network (Modem)"},{k:"iot",l:"IoT (A10)"},{k:"sensors",l:"Sensors"},{k:"services",l:"Services",c:"svc"}];
el("tabs").innerHTML = TABS.map(function(t,i){ return '<div class="tab ' + (t.c||"") + (i===0?" active":"") + '" data-k="' + t.k + '">' + t.l + '</div>'; }).join("");
Array.prototype.forEach.call(document.querySelectorAll(".tab"), function(t){
  t.onclick = function(){
    Array.prototype.forEach.call(document.querySelectorAll(".tab"), function(x){ x.classList.remove("active"); });
    t.classList.add("active"); activeTab = t.getAttribute("data-k"); renderTab();
  };
});
function destroyChart(){ if (chart) { try { chart.destroy(); } catch(e){} chart = null; } }
function loadDevices(){
  if (!CFG.deviceStatusUrl) { devLoading = false; devErr = "Device endpoint not configured"; renderTab(); return; }
  fetch(CFG.deviceStatusUrl + "?siteId=" + encodeURIComponent(CFG.siteId), { credentials: "include" })
  .then(function(r){ if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
  .then(function(resp){
    if (resp && resp.Success === false) throw new Error(resp.Message || "API error");
    var ms = (resp && resp.Modems) || [];
    modems = ms.filter(function(m){ return m && (m.ModemId || m.modemId); }).map(function(m){
      var tcp = !!fd(m.TcpStatus, m.tcpStatus, false), mqtt = !!fd(m.MqttStatus, m.mqttStatus, false);
      var onl = fd(m.IsOnline, m.isOnline); onl = (onl === null) ? (tcp || mqtt) : !!onl;
      return {
        clusterId: num(fd(m.ClusterId, m.clusterId), 0),
        clusterName: String(fd(m.ClusterName, m.clusterName, m.ModemName, m.modemName, "Modem")),
        modemId: String(fd(m.ModemId, m.modemId, "")),
        modemName: String(fd(m.ModemName, m.modemName, "")),
        version: String(fd(m.Version, m.version, "")),
        signal: fd(m.SignalStrength, m.signalStrength),
        tcp: tcp, mqtt: mqtt, online: onl,
        a10s: (fd(m.A10List, m.a10List) || []).map(function(a){
          var at = !!fd(a.TcpStatus, a.tcpStatus, false), am = !!fd(a.MqttStatus, a.mqttStatus, a.MQTTStatus, false);
          return { a10Id: fd(a.A10Id, a.a10Id, a.Id, a.id, "?"), type: String(fd(a.ADCTypeName, a.adcTypeName, "")), tcp: at, mqtt: am, online: at || am };
        })
      };
    });
    devLoading = false; devErr = null; renderTab();
  })
  .catch(function(e){ devLoading = false; devErr = e.message; renderTab(); });
}
function renderTab(){
  destroyChart(); sel = null; selType = null; lastData = null;
  var b = el("body");
  if (activeTab === "services") {
    b.innerHTML = '<div class="pending"><b>Service health history</b><br/>Debouncer, Datalogger, Point Machine, Alert and Data Receiver history APIs are not available yet.<br/>This tab will bind automatically once those endpoints are integrated.</div>';
    return;
  }
  if (activeTab === "sensors") { renderSensors(); return; }
  if (devLoading) { b.innerHTML = '<div class="empty">Loading device list&hellip;</div>'; return; }
  if (devErr) { b.innerHTML = '<div class="empty">Failed to load devices: ' + esc(devErr) + '</div>'; return; }
  if (!modems.length) { b.innerHTML = '<div class="empty">No devices found for this station.</div>'; return; }
  var h = "";
  if (activeTab === "network") {
    h += '<div class="sec-t">Select a modem to view its status history &amp; signal graph</div><div class="dev-grid">';
    modems.forEach(function(m, i){
      h += '<div class="dev-card" data-i="' + i + '"><div class="dc-top"><div class="dc-name">&#x1F4E1; ' + esc(m.clusterName) + '</div><div>' +
        '<span class="tag ' + (m.tcp?"on":"off") + '"><i></i>TCP</span> <span class="tag ' + (m.mqtt?"on":"off") + '"><i></i>MQTT</span></div></div>' +
        '<div class="dc-meta"><span>' + esc(m.modemName) + '</span><span>V' + esc(m.version || "?") + '</span>' +
        (m.signal !== null && m.signal !== undefined && m.signal !== "" ? '<span>' + esc(m.signal) + ' dBm</span>' : '') +
        '<span>' + m.a10s.length + ' A10</span></div></div>';
    });
    h += '</div>';
  } else {
    h += '<div class="sec-t">Select an A10 to view its status history &amp; graph</div>';
    modems.forEach(function(m, mi){
      if (!m.a10s.length) return;
      h += '<div class="agroup"><div class="ag-h">&#x1F4E1; ' + esc(m.clusterName) + ' <span style="color:var(--tx4);font-weight:400">(' + esc(m.modemName) + ')</span></div><div>';
      m.a10s.forEach(function(a, ai){
        h += '<span class="chip" data-mi="' + mi + '" data-ai="' + ai + '"><i class="' + (a.online?"on":"off") + '"></i>A10-' + esc(a.a10Id) + (a.type ? ' &middot; ' + esc(a.type) : '') + '</span>';
      });
      h += '</div></div>';
    });
  }
  h += '<div id="garea"></div>';
  b.innerHTML = h;
  if (activeTab === "network") {
    Array.prototype.forEach.call(b.querySelectorAll(".dev-card"), function(c){
      c.onclick = function(){
        Array.prototype.forEach.call(b.querySelectorAll(".dev-card"), function(x){ x.classList.remove("sel"); });
        c.classList.add("sel");
        sel = modems[parseInt(c.getAttribute("data-i"), 10)]; selType = "modem";
        buildGraphArea("Modem - " + sel.clusterName); loadGraph();
      };
    });
  } else {
    Array.prototype.forEach.call(b.querySelectorAll(".chip"), function(c){
      c.onclick = function(){
        Array.prototype.forEach.call(b.querySelectorAll(".chip"), function(x){ x.classList.remove("sel"); });
        c.classList.add("sel");
        var m = modems[parseInt(c.getAttribute("data-mi"), 10)];
        var a = m.a10s[parseInt(c.getAttribute("data-ai"), 10)];
        sel = { clusterId: m.clusterId, modemId: m.modemId, a10Id: a.a10Id }; selType = "a10";
        buildGraphArea("A10-" + a.a10Id + " - " + m.clusterName); loadGraph(); loadRecords();
      };
    });
  }
}
function buildGraphArea(title){
  el("garea").innerHTML = '<div class="gbox"><div class="gbar"><div class="gtitle">' + esc(title) + '</div>' +
    '<label class="gchk"><input type="checkbox" id="cT" checked/> TCP</label>' +
    '<label class="gchk"><input type="checkbox" id="cM" checked/> MQTT</label>' +
    '<button class="gbtn" id="bL">Load Graph</button></div>' +
    '<div class="gstats" id="gstats"></div>' +
    '<div class="note" id="gload">Loading history&hellip;</div>' +
    '<div class="note" id="gempty">&#x1F4ED; No history found for this date range.</div>' +
    '<div class="cwrap"><canvas id="cv" style="display:none"></canvas></div>' +
    '<div class="rows" id="recs"></div></div>';
  el("bL").onclick = function(){ loadGraph(); if (selType === "a10") loadRecords(); };
  el("cT").onchange = function(){ if (lastData) renderChart(lastData); };
  el("cM").onchange = function(){ if (lastData) renderChart(lastData); };
}
function dates(){ return { from: el("dFrom").value, to: el("dTo").value }; }
function loadGraph(){
  if (!sel) return;
  var d = dates();
  if (!d.from || !d.to) { alert("Please select a date range"); return; }
  var url = selType === "modem"
    ? CFG.modemGraphUrl + "?clusterId=" + sel.clusterId + "&fromDate=" + fmtApi(d.from) + "&toDate=" + fmtApi(d.to)
    : CFG.a10GraphUrl + "?clusterId=" + sel.clusterId + "&a10Id=" + sel.a10Id + "&fromDate=" + fmtApi(d.from) + "&toDate=" + fmtApi(d.to);
  el("gload").style.display = "flex"; el("gempty").style.display = "none"; el("cv").style.display = "none";
  el("gstats").innerHTML = ""; el("bL").disabled = true;
  fetch(url, { credentials: "include" })
  .then(function(r){ if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
  .then(function(data){
    el("gload").style.display = "none"; el("bL").disabled = false;
    var arr = Array.isArray(data) ? data : ((data && (data.Data || data.data)) || []);
    if (!arr.length || (data && data.Success === false)) { el("gempty").style.display = "flex"; lastData = null; return; }
    lastData = arr; el("cv").style.display = "block"; renderChart(arr);
  })
  .catch(function(){ el("gload").style.display = "none"; el("bL").disabled = false; el("gempty").style.display = "flex"; });
}
function fillGaps(arr, from, to, gapMin){
  if (!arr.length) return [];
  var gap = (gapMin || 5) * 60000;
  arr.sort(function(a,b){ return a.x - b.x; });
  var out = [], start = new Date(from + "T00:00:00").getTime(), end = Math.min(new Date(to + "T23:59:59").getTime(), Date.now());
  if (arr[0].x.getTime() > start + gap) { out.push({x:new Date(start),y:0,s:"off"}); out.push({x:new Date(arr[0].x.getTime()-1000),y:0,s:"off"}); }
  for (var i = 0; i < arr.length; i++) {
    if (i > 0 && arr[i].x.getTime() - arr[i-1].x.getTime() > gap) {
      out.push({x:new Date(arr[i-1].x.getTime()+1000),y:0,s:"off"});
      out.push({x:new Date(arr[i].x.getTime()-1000),y:0,s:"off"});
    }
    out.push({x:arr[i].x,y:arr[i].y,s:"on"});
  }
  var last = arr[arr.length-1];
  if (last.x.getTime() < end - gap) { out.push({x:new Date(last.x.getTime()+1000),y:0,s:"off"}); out.push({x:new Date(end),y:0,s:"off"}); }
  return out;
}
function stats(filled, from, to){
  if (!filled.length) return {pct:0,avg:0};
  var on = filled.filter(function(p){ return p.s === "on"; });
  var avg = on.length ? Math.round(on.reduce(function(s,p){ return s+p.y; },0)/on.length) : 0;
  var t = 0, st = null;
  filled.forEach(function(p){
    if (p.s === "on" && st === null) st = p.x.getTime();
    else if (p.s === "off" && st !== null) { t += p.x.getTime() - st; st = null; }
  });
  if (st !== null) t += filled[filled.length-1].x.getTime() - st;
  var total = Math.min(new Date(to + "T23:59:59").getTime(), Date.now()) - new Date(from + "T00:00:00").getTime();
  return { pct: Math.min(total > 0 ? Math.round(t/total*100) : 0, 100), avg: avg };
}
function renderChart(data){
  var d = dates(), showT = el("cT").checked, showM = el("cM").checked, isModem = selType === "modem";
  var tcp = [], mqtt = [];
  data.forEach(function(it){
    var ts = fd(it.TimeStamp, it.Timestamp, it.timeStamp, it.CreatedOn, it.DateTime);
    var tid = num(fd(it.TypeId, it.typeId), 0);
    if (!ts) return;
    var v = isModem ? (parseInt(fd(it.SignalStrength, it.signalStrength, 0), 10) || 0)
      : (tid === 1 ? (parseInt(fd(it.ResponseTime, it.responseTime, 0), 10) || 0) : (parseInt(fd(it.Uptime, it.uptime, 0), 10) || 0));
    if (v <= 0) return;
    var p = { x: new Date(ts), y: v };
    if (tid === 1) tcp.push(p); else if (tid === 2) mqtt.push(p);
  });
  var tf = fillGaps(tcp, d.from, d.to, 5), mf = fillGaps(mqtt, d.from, d.to, 5);
  var tst = stats(tf, d.from, d.to), mst = stats(mf, d.from, d.to);
  var unit = isModem ? " dBm" : "";
  var sh = "";
  if (showT && tf.length) sh += '<div class="gstat"><span class="gdot tcp"></span>TCP &middot; avg ' + tst.avg + unit + ' &middot; <span class="pct ' + (tst.pct>=80?"good":tst.pct>=50?"warn":"poor") + '">' + tst.pct + '% online</span></div>';
  if (showM && mf.length) sh += '<div class="gstat"><span class="gdot mqtt"></span>MQTT &middot; avg ' + mst.avg + unit + ' &middot; <span class="pct ' + (mst.pct>=80?"good":mst.pct>=50?"warn":"poor") + '">' + mst.pct + '% online</span></div>';
  el("gstats").innerHTML = sh;
  var hasT = showT && tf.length > 0, hasM = showM && mf.length > 0;
  if (!hasT && !hasM) { el("cv").style.display = "none"; el("gempty").style.display = "flex"; return; }
  el("gempty").style.display = "none"; el("cv").style.display = "block";
  destroyChart();
  function seg(c){ return {
    borderColor: function(ctx){ return (ctx.p0.parsed.y === 0 || ctx.p1.parsed.y === 0) ? "#ef4444" : c; },
    backgroundColor: function(ctx){ return (ctx.p0.parsed.y === 0 || ctx.p1.parsed.y === 0) ? "rgba(239,68,68,0.1)" : "rgba(0,0,0,0)"; }
  }; }
  var ds = [];
  if (hasT) ds.push({ label:"TCP", data:tf.map(function(p){return {x:p.x,y:p.y};}), borderColor:"#60a5fa", backgroundColor:"rgba(96,165,250,0.1)", borderWidth:2, fill:true, tension:0, pointRadius:1, pointHoverRadius:5, segment:seg("#60a5fa") });
  if (hasM) ds.push({ label:"MQTT", data:mf.map(function(p){return {x:p.x,y:p.y};}), borderColor:"#34d399", backgroundColor:"rgba(52,211,153,0.1)", borderWidth:2, fill:true, tension:0, pointRadius:1, pointHoverRadius:5, segment:seg("#34d399") });
  chart = new Chart(el("cv").getContext("2d"), {
    type: "line", data: { datasets: ds },
    options: {
      responsive: true, maintainAspectRatio: false, interaction: { mode: "index", intersect: false },
      plugins: {
        legend: { display: true, labels: { color: "#9fb1d1", boxWidth: 12, font: { size: 10 } } },
        tooltip: { callbacks: {
          title: function(c){ return new Date(c[0].parsed.x).toLocaleString(); },
          label: function(c){ var v = c.parsed.y; return c.dataset.label + ": " + (v === 0 ? "OFFLINE" : v + (isModem ? " dBm" : "")); }
        } }
      },
      scales: {
        x: { type: "time", time: { displayFormats: { minute: "HH:mm", hour: "HH:mm", day: "dd MMM" } }, grid: { color: "rgba(255,255,255,0.07)" }, ticks: { color: "#9fb1d1", maxRotation: 45 } },
        y: { min: 0, title: { display: true, text: (isModem ? "Signal (dBm)" : "TCP: response / MQTT: uptime"), color: "#9fb1d1" }, grid: { color: "rgba(255,255,255,0.07)" }, ticks: { color: "#9fb1d1", callback: function(v){ return v === 0 ? "Offline" : v; } } }
      }
    }
  });
}
function loadRecords(){
  if (!sel || selType !== "a10" || !CFG.a10RecordsUrl) return;
  var d = dates(), r = el("recs");
  r.innerHTML = '<div class="empty">Loading records&hellip;</div>';
  var url = CFG.a10RecordsUrl + "?clusterId=" + sel.clusterId + "&a10Id=" + sel.a10Id + "&ModemId=" + encodeURIComponent(sel.modemId || "") + "&fromDate=" + fmtApi(d.from) + "&toDate=" + fmtApi(d.to);
  fetch(url, { credentials: "include" })
  .then(function(x){ if (!x.ok) throw new Error("HTTP " + x.status); return x.json(); })
  .then(function(resp){
    if (resp && resp.Success === false) { r.innerHTML = '<div class="empty">' + esc(resp.Message || "No records") + '</div>'; return; }
    var rows = Array.isArray(resp) ? resp : ((resp && (resp.Data || resp.data)) || []);
    if (!rows.length) { r.innerHTML = '<div class="empty">No records in this range.</div>'; return; }
    rows.sort(function(a,b){ return new Date(fd(b.TimeStamp, b.timeStamp, 0)) - new Date(fd(a.TimeStamp, a.timeStamp, 0)); });
    r.innerHTML = rows.slice(0, 100).map(function(rec){
      var ts = new Date(fd(rec.TimeStamp, rec.timeStamp, 0));
      var tid = num(fd(rec.TypeId, rec.typeId), 0);
      return '<div class="row"><span class="t">' + ts.toLocaleString() + '</span>' +
        '<span class="p ' + (tid === 1 ? "tcp" : "mqtt") + '">' + (tid === 1 ? "TCP" : "MQTT") + '</span>' +
        '<span class="x">' + (tid === 1 ? ("Response " + esc(fd(rec.ResponseTime, rec.responseTime, "-"))) : ("Uptime " + esc(fd(rec.Uptime, rec.uptime, "-")))) + '</span></div>';
    }).join("");
  })
  .catch(function(){ r.innerHTML = '<div class="empty">Failed to load records.</div>'; });
}
