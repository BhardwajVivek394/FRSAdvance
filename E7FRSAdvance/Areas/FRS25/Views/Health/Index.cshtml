    function nwModemProtoChange() {
        var sel = document.getElementById('nwModemProto');
        var mq = document.getElementById('nwModemCmdsMqtt'), tc = document.getElementById('nwModemCmdsTcp');
        if (!sel) return;
        if (mq) mq.style.display = sel.value === 'mqtt' ? 'block' : 'none';
        if (tc) tc.style.display = sel.value === 'tcp' ? 'block' : 'none';
    }
    function nwSendModemCmd(proto, cmd) {
        if (!nwCur || nwCur.kind !== 'modem') return;
        if (nwCmdPending) { nwLog('nwConBody', 'error', 'Command in progress...'); return; }
        var m = nwCur.modem;
        var info = document.getElementById('nwModemConInfo');
        nwLog('nwConBody', 'cmd', '[' + proto.toUpperCase() + '] > ' + cmd);
        nwCmdPending = true;
        if (info) info.textContent = 'Sending...';
        function done(ok, data, lat) {
            nwCmdPending = false;
            if (ok && data) {
                nwLog('nwConBody', 'response', nwPretty(data), lat);
                try {
                    var j = JSON.parse(data);
                    if (j.CSQ) {
                        var rssi = parseInt(String(j.CSQ).split(',')[0], 10);
                        var si = nwSignalInfo(rssi);
                        nwLog('nwConBody', 'info', '// Signal: ' + si.description + ' (' + si.dbm + ')');
                    }
                } catch (e) { }
                if (info) info.textContent = 'OK (' + lat + 'ms)';
            } else {
                nwLog('nwConBody', 'error', data || 'No response (timeout)');
                if (info) info.textContent = 'Timeout';
            }
        }
        if (proto === 'mqtt') {
            nwMqttCmd(m.mqttBase, m.clusterName || m.modemName, cmd, done);
        } else {
            var sentAt = Date.now();
            fetch(MODEM_TCP_CMD_URL, {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ modemId: m.modemId, command: cmd, tcpInfo: nwTcpInfo(m, nwCur ? nwCur.siteId : 0) })
            }).then(function (r) { return r.json(); }).then(function (res) {
                var lat = Date.now() - sentAt;
                if (res && (res.success || res.Success) && (res.data || res.Data)) done(true, res.data || res.Data, lat);
                else done(false, (res && (res.error || res.Error)) || 'No response (timeout)', lat);
            }).catch(function (e) { done(false, 'TCP Failed: ' + e.message, 0); });
        }
    }
    function nwModemConsoleSend() {
        var input = document.getElementById('nwModemInput');
        if (!input || !input.value.trim()) return;
        var sel = document.getElementById('nwModemProto');
        var proto = sel ? sel.value : (nwVerNum(nwCur.modem.version) === 1 ? 'tcp' : 'mqtt');
        nwSendModemCmd(proto, input.value.trim());
        input.value = '';
    }
    // ---- TCP info builder (N/W db parity: /Modem/SendTcpCommand expects full modem shape) ----
    function nwExtractClusterNo(name) {
        if (!name) return 0;
        var m = String(name).replace(/\s/g, '').match(/cluster_?(\d+)/i);
        return (m && m[1]) ? parseInt(m[1], 10) : 0;
    }
    function nwProxyHost() {
        var h = window.location.hostname;
        if (h === 'localhost' || h === '127.0.0.1' || h.indexOf('.local', h.length - 6) !== -1) return 'proxy.energy7.org';
        if (h === 'energy7.in' || h.indexOf('.energy7.in', h.length - 11) !== -1) return 'proxy.energy7.org';
        return '172.31.25.106';
    }
    function nwBuildTcpPort(siteId, clusterNo, offset) {
        siteId = parseInt(siteId, 10) || 0;
        if (siteId <= 0 || !clusterNo || clusterNo <= 0) return 0;
        var c = String(clusterNo + offset); if (c.length < 2) c = '0' + c;
        return parseInt(String(siteId) + c, 10);   // e.g. site 14 + cluster 2 -> recv 1402 / send 1432
    }
    function nwTcpInfo(m, siteId) {
        var clusterNo = nwExtractClusterNo(m.clusterName || m.modemName);
        var host = nwProxyHost();
        var recvP = nwBuildTcpPort(siteId, clusterNo, 0);
        var sendP = nwBuildTcpPort(siteId, clusterNo, 30);
        var base = String(m.mqttBase || 'rdpms').replace(/\/+$/, '');
        var clean = String(m.clusterName || m.modemName || '').replace(/\s+/g, '');
        return {
            modemId: m.modemId, modemName: m.modemName || m.clusterName,
            version: String(nwVerNum(m.version)),
            clusterId: m.clusterId, clusterName: m.clusterName, clusterNo: clusterNo,
            stationName: (nwCur && nwCur.siteName) || '', divisionName: '', zoneName: '',
            mqttBase: m.mqttBase,
            tcpSendPort: sendP ? host + ':' + sendP : '-',
            tcpRecvPort: recvP ? host + ':' + recvP : '-',
            subscribeTopic: base + '/' + clean + '/S',
            publishTopic: base + '/' + clean + '/P',
            tcpStatus: !!m.tcp, mqttStatus: !!m.mqtt,
            simNumber: m.sim || m.simNumber || '-',
            signal: (m.signal !== undefined ? m.signal : null)
        };
    }
    function nwSignalInfo(rssi) {
        if (rssi === 99) return { description: 'Unknown', dbm: 'Not detectable' };
        if (rssi === 0) return { description: 'No signal', dbm: '-113 dBm or less' };
        if (rssi === 1) return { description: 'Very weak', dbm: '-111 dBm' };
        if (rssi <= 9) return { description: 'Weak', dbm: '-109 to -95 dBm' };
        if (rssi <= 14) return { description: 'Fair', dbm: '-93 to -85 dBm' };
        if (rssi <= 19) return { description: 'Good', dbm: '-83 to -75 dBm' };
        return { description: 'Excellent', dbm: '-73 dBm or greater' };
    }

