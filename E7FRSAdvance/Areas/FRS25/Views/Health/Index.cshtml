    // ===== ALERT LIVE API =====
    function parseAlertIdentifier(alertId) {
        var parts = {}; if (!alertId) return parts;
        String(alertId).split("|").forEach(function (seg) {
            var idx = seg.indexOf(":"); if (idx > 0) parts[seg.substring(0, idx).trim()] = seg.substring(idx + 1).trim();
        });
        return parts;
    }

    function getAlertHealthStatus(alertIdentifier) {
        var raw = String(alertIdentifier || "").toLowerCase();
        // <service>.service.dead  -> service process is down  -> unhealthy (critical)
        if (raw.indexOf("service.dead") >= 0 || raw.indexOf("dead") >= 0) return "unhealthy";
        // <service>.health.bad    -> service reporting DOWN/WARNING -> warning
        if (raw.indexOf("health.bad") >= 0) return "warning";
        if (raw.length > 0) return "warning";
        return "warning";
    }

    function processAlertLiveData(alerts) {
        alertLiveRaw = Array.isArray(alerts) ? alerts : [];
        serviceHealthAlerts = {};
        alertNodeIndex = {};
        alertNodeAny = {};
        alertSvcIndex = {};

        alertLiveRaw.forEach(function (alert) {
            var sid = alert.siteId || alert.SiteId || 0;
            // Identify the owning service by the alertIdentifier rule (falls back to sourceId).
            var srcId = classifyServiceHealth(alert);
            var node = alertNodeOf(alert);
            var status = getAlertHealthStatus(alert.alertIdentifier || alert.AlertIdentifier);

            // ----- per-node index (used by the live-view Local/Cloud service sub-cells) -----
            if (node) {
                alertNodeAny[sid + "|" + node] = true;
                if (srcId) {
                    var nkey = sid + "|" + srcId + "|" + node;
                    var ne = alertNodeIndex[nkey] || (alertNodeIndex[nkey] = { count: 0, status: "healthy" });
                    ne.count++;
                    if (status === "unhealthy") ne.status = "unhealthy";
                    else if (status === "warning" && ne.status !== "unhealthy") ne.status = "warning";
                }
            }

            if (!srcId) return; // not a service-health alert (sensor/asset alert etc.)

            // ----- node-agnostic per-service index (real-time count badge on each service) -----
            var skey = sid + "|" + srcId;
            var se = alertSvcIndex[skey] || (alertSvcIndex[skey] = { count: 0, status: "healthy", dead: 0, bad: 0 });
            se.count++;
            if (status === "unhealthy") { se.status = "unhealthy"; se.dead++; }
            else { se.bad++; if (se.status !== "unhealthy") se.status = "warning"; }

            if (!serviceHealthAlerts[sid]) {
                serviceHealthAlerts[sid] = {};
                SERVICE_HEALTH_IDS.forEach(function (s) { serviceHealthAlerts[sid][s] = { status: "healthy", alerts: [] }; });
            }

            var entry = serviceHealthAlerts[sid][srcId];
            if (!entry) { entry = { status: "healthy", alerts: [] }; serviceHealthAlerts[sid][srcId] = entry; }
            entry.alerts.push(alert);
            // Escalate: unhealthy > warning > healthy
            if (status === "unhealthy") entry.status = "unhealthy";
            else if (status === "warning" && entry.status !== "unhealthy") entry.status = "warning";
        });

        alertLiveLastFetch = new Date();
    }

    // O(1) node-agnostic per-service summary (real-time count for the service cell badge).
    function svcAlertInfo(siteId, sourceId) {
        var hit = alertSvcIndex[siteId + "|" + sourceId];
        return {
            count: hit ? hit.count : 0,
            status: hit ? hit.status : "healthy",
            dead: hit ? hit.dead : 0,
            bad: hit ? hit.bad : 0
        };
    }

    // =====================================================================
    // ALERT HISTORY (GetAlertHistory proxy -> upstream /api/AlertHistory)
    // Historical alerts over a date range. Powers (a) the 1-day count badge on
    // each service eye icon and (b) the "History" tab of the Alert Center modal.
    // Uses the same rule-based service classification + node resolution as the
    // live feed so a service's history lines up with its live alerts.
    // =====================================================================
    var AH_DAY_MS = 24 * 60 * 60 * 1000;
    var alertHistoryDayRaw = [];      // flat 24h history across visible sites (for grid badge)
    var alertHistoryDayIndex = {};    // "site|sourceId"       -> count (last 24h, service-classified)
    var alertHistoryDayNodeIdx = {};  // "site|sourceId|node"  -> count (last 24h)
    var alertHistoryDayLoaded = {};   // siteId -> ts of last successful 24h load
    var AH_MAX_SITES = 40;            // cap visible sites we pre-load counts for

    // Upstream wants ddMMyyyy_HHmmss (e.g. 24062026_160200).
    function ahFmtDate(d) {
        function p(n) { return String(n).padStart(2, "0"); }
        return p(d.getDate()) + p(d.getMonth() + 1) + d.getFullYear() + "_" + p(d.getHours()) + p(d.getMinutes()) + p(d.getSeconds());
    }
    function ahUnwrap(resp) {
        if (Array.isArray(resp)) return resp;
        if (resp && Array.isArray(resp.data)) return resp.data;
        if (resp && Array.isArray(resp.Data)) return resp.Data;
        return [];
    }

    // Fetch history for one site between two Date objects.
    // Self-contained request cache + in-flight de-duplication keyed by site+range,
    // so repeated opens / visible-site sweeps don't re-hit the API.
    var ahCache = {};     // key -> { ts, value }
    var ahInflight = {};  // key -> Promise
    var AH_CACHE_TTL = 300000; // 5 min
    function fetchAlertHistory(siteId, fromDate, toDate, opts) {
        siteId = parseInt(siteId, 10) || 0;
        opts = opts || {};
        if (!siteId || !ALERT_HISTORY_URL || ALERT_HISTORY_URL === "null") return Promise.resolve([]);
        var sd = ahFmtDate(fromDate), ed = ahFmtDate(toDate);
        var key = siteId + "|" + sd + "|" + ed;
        var ttl = (opts.ttl != null ? opts.ttl : AH_CACHE_TTL);
        if (!opts.force) {
            var c = ahCache[key];
            if (c && (Date.now() - c.ts) < ttl) return Promise.resolve(c.value);
        }
        if (ahInflight[key]) return ahInflight[key];
        var url = ALERT_HISTORY_URL + "?siteId=" + encodeURIComponent(siteId) +
            "&StartDate=" + encodeURIComponent(sd) + "&EndDate=" + encodeURIComponent(ed);
        var p = fetch(url, { credentials: "same-origin" }).then(function (r) {
            if (!r.ok) throw new Error("HTTP " + r.status);
            return r.json();
        }).then(function (j) {
            var list = ahUnwrap(j);
            ahCache[key] = { ts: Date.now(), value: list };
            delete ahInflight[key];
            return list;
        }, function (err) { delete ahInflight[key]; throw err; });
        ahInflight[key] = p;
        return p;
    }

    // O(1) lookups for the grid badge.
    function svcHistoryDayInfo(siteId, sourceId) {
        return { count: alertHistoryDayIndex[siteId + "|" + sourceId] || 0 };
    }
    function nodeHistoryDayInfo(siteId, sourceId, node) {
        return { count: alertHistoryDayNodeIdx[siteId + "|" + sourceId + "|" + node] || 0 };
    }

    // Rebuild the 24h grid index from alertHistoryDayRaw (service-classified only).
    function buildAlertHistoryDayIndex() {
        alertHistoryDayIndex = {};
        alertHistoryDayNodeIdx = {};
        alertHistoryDayRaw.forEach(function (a) {
            var srcId = classifyServiceHealth(a);
            if (!srcId) return; // skip hardware/IoT alerts - the badge is per service column
            var sid = a.siteId || a.SiteId || 0;
            var sk = sid + "|" + srcId;
            alertHistoryDayIndex[sk] = (alertHistoryDayIndex[sk] || 0) + 1;
            var node = alertNodeOf(a);
            if (node) {
                var nk = sk + "|" + node;
                alertHistoryDayNodeIdx[nk] = (alertHistoryDayNodeIdx[nk] || 0) + 1;
            }
        });
    }

    // Concurrency-limited loader for the visible-site 24h counts (mirrors dsQueue).
    var ahQueue = [], ahActive = 0, AH_MAX_CONCURRENT = 4;
    function ahEnqueue(job) { ahQueue.push(job); ahPump(); }
    function ahPump() {
        while (ahActive < AH_MAX_CONCURRENT && ahQueue.length) {
            var job = ahQueue.shift();
            ahActive++;
            job().then(function () { ahActive--; ahPump(); }, function () { ahActive--; ahPump(); });
        }
    }

    function loadVisibleAlertHistory(force) {
        var to = new Date(), from = new Date(to.getTime() - AH_DAY_MS);
        var sites = getFilteredStations().slice(0, AH_MAX_SITES);
        var merged = [];
        var pending = sites.length;
        if (!pending) return;
        sites.forEach(function (st) {
            var sid = parseInt(st.siteId, 10) || 0;
            if (!sid) { pending--; return; }
            // honour the 5-min freshness unless forced
            if (!force && alertHistoryDayLoaded[sid] && (Date.now() - alertHistoryDayLoaded[sid]) < 300000) {
                pending--;
                if (pending === 0) finalize();
                return;
            }
            ahEnqueue(function () {
                return fetchAlertHistory(sid, from, to, { force: force }).then(function (list) {
                    alertHistoryDayLoaded[sid] = Date.now();
                    // tag siteId defensively (upstream rows already carry siteId)
                    list.forEach(function (a) { if (a.siteId == null && a.SiteId == null) a.siteId = sid; });
                    merged = merged.concat(list);
                }).catch(function () { }).then(function () {
                    pending--;
                    if (pending === 0) finalize();
                });
            });
        });
        function finalize() {
            // Replace the day cache with this fresh sweep, rebuild the index, repaint.
            alertHistoryDayRaw = merged;
            buildAlertHistoryDayIndex();
            renderThrottled();
        }
    }


    function getAlertHealthSummary() {
        var total = { healthy: 0, warning: 0, unhealthy: 0 };
        var siteIds = Object.keys(serviceHealthAlerts);
        // If a site has an entry, check its services; services with no alert entry are healthy
        var allSiteIds = stations.map(function (s) { return String(s.siteId); });
        // Merge: include sites from stations that have no alert entry (all healthy for them)
        allSiteIds.forEach(function (sid) { if (siteIds.indexOf(sid) < 0) siteIds.push(sid); });

        siteIds.forEach(function (sid) {
            var siteAlerts = serviceHealthAlerts[sid] || {};
            var stn = stations.find(function (s) { return String(s.siteId) === sid; });
            var stale = stn ? isStationStale(stn) : false;
            SERVICE_HEALTH_IDS.forEach(function (svcId) {
                var entry = siteAlerts[svcId];
                var st = entry ? entry.status : "healthy";
                if (stale) st = "unhealthy"; // no MQTT data within staleness window
                if (st === "unhealthy") total.unhealthy++;
                else if (st === "warning") total.warning++;
                else total.healthy++;
            });
        });
        return total;
    }

    function getServiceHealthAlertsList() {
        // Return flat list of all service health alerts with parsed details
        var list = [];
        alertLiveRaw.forEach(function (alert) {
            var srcId = classifyServiceHealth(alert);
            if (!srcId) return;
            var parsed = parseAlertIdentifier(alert.alertIdentifier);
            list.push({
                siteId: alert.siteId,
                siteName: alert.alertDescription ? alert.alertDescription.split("/")[1] : ("Site " + alert.siteId),
                service: srcId,
                kind: parsed.kind || "unknown",
                rule: parsed.rule || "",
                desc: parsed.desc || alert.alertDescription || "",
                priority: alert.priority || "",
                category: alert.category || "",
                state: alert.alertState || "",
                timestampSet: alert.timestampSet || "",
                timestampUpdated: alert.timestampUpdated || "",
                alertId: alert.alertId,
                status: getAlertHealthStatus(alert.alertIdentifier),
                raw: alert
            });
        });
        return list;
    }

    async function fetchAlertLive() {
        var siteId = selectedHealthSiteId();
        try {
            var url = ALERT_LIVE_URL + "?siteId=" + encodeURIComponent(siteId || 0);
            var r = await fetch(url, { credentials: "same-origin" });
            if (!r.ok) throw new Error("HTTP " + r.status);
            var data = await r.json();
            processAlertLiveData(data);
            log("AlertLive fetched: " + alertLiveRaw.length + " alerts, " + getServiceHealthAlertsList().length + " service health", "sys");
            // After alerts arrive, recompute sensor health for all cached sites
            crossReferenceSensorAlerts();
            renderThrottled();
        } catch (e) {
            log("AlertLive fetch failed: " + e.message, "err");
        }
    }

    // ===== SENSOR HEALTH: Fetch asset metadata for a site =====
    async function fetchSensorDataForSite(siteId) {
        if (!siteId || siteId <= 0) return;
        if (sensorDataLoading[siteId]) return;
        sensorDataLoading[siteId] = true;
        try {
            var r = await fetch(SITE_ASSETS_URL, {
                method: "POST",
                credentials: "same-origin",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: "siteId=" + encodeURIComponent(siteId)
            });
            if (!r.ok) throw new Error("HTTP " + r.status);
            var data = await r.json();
            if (data.success && Array.isArray(data.mAssets)) {
                var assets = data.mAssets;
                var sensorMap = {};   // { "assetId_attrId": { assetId, assetName, attrId, attrTitle, attrAlias, assetTypeId } }
                var totalSensors = 0;

                assets.forEach(function (asset) {
                    var attrs = asset.assetAttributes || [];
                    attrs.forEach(function (attr) {
                        var key = asset.Id + "_" + attr.Id;
                        sensorMap[key] = {
                            assetId: asset.Id,
                            assetName: asset.Name || asset.AssetName || ("Asset " + asset.Id),
                            attrId: attr.Id,
                            attrTitle: attr.Title || "",
                            attrAlias: attr.AliasName || "",
                            assetTypeId: attr.AssetTypeId || asset.AssetTypeId,
                            minValue: attr.MinValue,
                            maxValue: attr.MaxValue
                        };
                        totalSensors++;
                    });
                });

                sensorDataCache[siteId] = {
                    assets: assets,
                    totalSensors: totalSensors,
                    sensorMap: sensorMap
                };
                log("Sensor data loaded for site " + siteId + ": " + totalSensors + " sensors", "sys");
            }
        } catch (e) {
            log("Sensor data fetch failed for site " + siteId + ": " + e.message, "err");
        }
        sensorDataLoading[siteId] = false;
    }

    // ===== CARDLINE: Fetch hardware mapping for a site =====
    async function fetchCardLineForSite(siteId) {
        if (!siteId || siteId <= 0) return;
        if (cardLineCache[siteId]) return; // already fetched
        try {
            var r = await fetch(CARDLINE_URL + "?siteId=" + encodeURIComponent(siteId), { credentials: "same-origin" });
            if (!r.ok) throw new Error("HTTP " + r.status);
            var data = await r.json();
            if (data.success && Array.isArray(data.cardLines)) {
                var lines = data.cardLines;

                // ---- IoT: unique ADCId (A10 devices) ----
                var adcMap = {};       // { adcId: { adcNumber, clusterId, clusterName, modemId, attrs:[] } }

                // ---- Network: unique ClusterId (cluster = modem unit) ----
                var clusterMap = {};   // { clusterId: { clusterName, modemId, modemVersion, adcIds:[], attrs:[] } }

                // ---- Mappings ----
                var attrToAdc = {};    // attributeId -> adcId
                var attrToCluster = {};// attributeId -> clusterId

                lines.forEach(function (cl) {
                    var adcId     = cl.ADCId;
                    var adcNum    = cl.ADCNumber;
                    var modemId   = cl.ModemId   || "";
                    var modemVer  = cl.ModemVersion;
                    var clusterId = cl.ClusterId;
                    var clusterNm = cl.ClusterName || "";
                    var attrId    = cl.AttributeId;
                    var assetId   = cl.AssetId;
                    var assetName = cl.AssetName || "";
                    var attrName  = cl.AttributeName || "";
                    var locName   = cl.LocationName || "";

                    // Build ADC (IoT) index
                    if (adcId !== null && adcId !== undefined && adcId !== 0) {
                        if (!adcMap[adcId]) {
                            adcMap[adcId] = {
                                adcId: adcId,
                                adcNumber: adcNum,
                                clusterId: clusterId,
                                clusterName: clusterNm,
                                modemId: modemId,
                                locationName: locName,
                                attrs: []
                            };
                        }
                        adcMap[adcId].attrs.push({ attrId: attrId, assetId: assetId, assetName: assetName, attrName: attrName });
                    }

                    // Build Cluster (Network) index
                    if (clusterId !== null && clusterId !== undefined && clusterId !== 0) {
                        if (!clusterMap[clusterId]) {
                            clusterMap[clusterId] = {
                                clusterId: clusterId,
                                clusterName: clusterNm,
                                modemId: modemId,
                                modemVersion: modemVer,
                                adcIds: {},
                                attrs: []
                            };
                        }
                        if (adcId) clusterMap[clusterId].adcIds[adcId] = true;
                        clusterMap[clusterId].attrs.push({ attrId: attrId, assetId: assetId, assetName: assetName, attrName: attrName });
                    }

                    // Attribute -> ADC / Cluster mapping
                    if (attrId !== null && attrId !== undefined) {
                        if (adcId) attrToAdc[attrId] = adcId;
                        if (clusterId) attrToCluster[attrId] = clusterId;
                    }
                });

                var adcIds = Object.keys(adcMap);
                var clusterIds = Object.keys(clusterMap);

                cardLineCache[siteId] = {
                    cardLines: lines,
                    adcMap: adcMap,
                    clusterMap: clusterMap,
                    adcIds: adcIds,
                    clusterIds: clusterIds,
                    attrToAdc: attrToAdc,
                    attrToCluster: attrToCluster
                };
                log("CardLine loaded for site " + siteId + ": " + adcIds.length + " ADCs (IoT), " + clusterIds.length + " clusters (Network), " + lines.length + " lines", "sys");
            }
        } catch (e) {
            log("CardLine fetch failed for site " + siteId + ": " + e.message, "err");
        }
    }

    // Fetch sensor + cardline data for all known stations
    async function fetchAllSensorData() {
        var siteIds = stations.map(function (s) { return parseInt(s.siteId, 10) || 0; }).filter(function (id) { return id > 0; });
        // Deduplicate
        siteIds = siteIds.filter(function (id, i) { return siteIds.indexOf(id) === i; });

        for (var i = 0; i < siteIds.length; i++) {
            if (!sensorDataCache[siteIds[i]]) await fetchSensorDataForSite(siteIds[i]);
            if (!cardLineCache[siteIds[i]]) await fetchCardLineForSite(siteIds[i]);
        }
        crossReferenceSensorAlerts();
        render();
    }

    // ===== SENSOR HEALTH: Cross-reference alerts with sensor data =====
    function crossReferenceSensorAlerts() {
        sensorAlertMap = {};
        sensorHealthSummary = {};

        // Build per-site alert lookup keyed by assetId_attributeId
        alertLiveRaw.forEach(function (alert) {
            var sid = String(alert.siteId || 0);
            var attrId = alert.attributeId;
            var assetId = alert.assetId;

            // Skip service-level health alerts (handled elsewhere via rule classification)
            if (classifyServiceHealth(alert)) return;

            // Must have attributeId to be a sensor/hardware alert
            if (!attrId && attrId !== 0) return;

            if (!sensorAlertMap[sid]) sensorAlertMap[sid] = {};
            var key = (assetId || 0) + "_" + attrId;
            if (!sensorAlertMap[sid][key]) sensorAlertMap[sid][key] = [];
            sensorAlertMap[sid][key].push(alert);
        });

        // Build summary per site
        var allSiteIds = Object.keys(sensorDataCache);
        allSiteIds.forEach(function (sid) {
            var cache = sensorDataCache[sid];
            if (!cache) return;
            var sMap = cache.sensorMap;
            var sAlerts = sensorAlertMap[sid] || {};
            var total = cache.totalSensors;
            var unhealthy = 0, warning = 0, healthy = 0;
            var details = [];

            // ===== SENSOR health =====
            Object.keys(sMap).forEach(function (sensorKey) {
                var sensor = sMap[sensorKey];
                var alerts = sAlerts[sensorKey] || [];
                var status = "healthy";
                var matchedAlerts = [];

                alerts.forEach(function (a) {
                    var identifier = String(a.alertIdentifier || "").toLowerCase();
                    matchedAlerts.push(a);
                    if (identifier.indexOf("dead") >= 0) {
                        status = "unhealthy";
                    } else if (status !== "unhealthy") {
                        status = "warning";
                    }
                });

                if (status === "unhealthy") unhealthy++;
                else if (status === "warning") warning++;
                else healthy++;

                if (matchedAlerts.length > 0) {
                    details.push({
                        sensorKey: sensorKey,
                        assetId: sensor.assetId,
                        assetName: sensor.assetName,
                        attrId: sensor.attrId,
                        attrTitle: sensor.attrTitle,
                        attrAlias: sensor.attrAlias,
                        status: status,
                        alerts: matchedAlerts
                    });
                }
            });

            sensorHealthSummary[sid] = {
                total: total,
                healthy: healthy,
                warning: warning,
                unhealthy: unhealthy,
                details: details.sort(function (a, b) {
                    var order = { unhealthy: 0, warning: 1, healthy: 2 };
                    return (order[a.status] || 2) - (order[b.status] || 2);
                })
            };

            // ===== IoT (ADC/A10) & Network (Cluster/Modem) health from CardLine =====
            var cl = cardLineCache[sid];
            var iotTotal = 0, iotUnhealthy = 0, iotWarning = 0, iotIssues = [];
            var netTotal = 0, netUnhealthy = 0, netWarning = 0, netIssues = [];

            if (cl) {
                iotTotal = cl.adcIds.length;
                netTotal = cl.clusterIds.length;

                // ---- Group alerts by ADC (IoT) ----
                var adcAlerts = {};
                cl.adcIds.forEach(function (id) { adcAlerts[id] = { dead: false, warn: false, alerts: [] }; });

                // ---- Group alerts by Cluster (Network) ----
                var clusterAlerts = {};
                cl.clusterIds.forEach(function (id) { clusterAlerts[id] = { dead: false, warn: false, alerts: [] }; });

                // Walk sensor alerts -> propagate to ADC and Cluster via CardLine mapping
                Object.keys(sAlerts).forEach(function (sensorKey) {
                    var parts = sensorKey.split("_");
                    var attrId = parts.length > 1 ? parts[1] : parts[0];
                    var alerts = sAlerts[sensorKey];

                    // Map attribute -> ADC
                    var adcId = cl.attrToAdc[attrId];
                    if (adcId && adcAlerts[adcId]) {
                        alerts.forEach(function (a) {
                            adcAlerts[adcId].alerts.push(a);
                            var ident = String(a.alertIdentifier || "").toLowerCase();
                            if (ident.indexOf("dead") >= 0) adcAlerts[adcId].dead = true;
                            else adcAlerts[adcId].warn = true;
                        });
                    }

                    // Map attribute -> Cluster
                    var clustId = cl.attrToCluster[attrId];
                    if (clustId && clusterAlerts[clustId]) {
                        alerts.forEach(function (a) {
                            // Avoid duplicates if same alert already added via another attr on same cluster
                            if (clusterAlerts[clustId].alerts.indexOf(a) < 0) clusterAlerts[clustId].alerts.push(a);
                            var ident = String(a.alertIdentifier || "").toLowerCase();
                            if (ident.indexOf("dead") >= 0) clusterAlerts[clustId].dead = true;
                            else clusterAlerts[clustId].warn = true;
                        });
                    }
                });

                // Tally IoT health
                cl.adcIds.forEach(function (adcId) {
                    var entry = adcAlerts[adcId];
                    var adcInfo = cl.adcMap[adcId] || {};
                    var label = "A10 #" + (adcInfo.adcNumber || adcId) + " (" + (adcInfo.locationName || "ADC " + adcId) + ")";
                    if (entry.dead) {
                        iotUnhealthy++;
                        iotIssues.push(label + " \u2014 sensor(s) dead (" + entry.alerts.length + " alert" + (entry.alerts.length > 1 ? "s" : "") + ")");
                    } else if (entry.warn) {
                        iotWarning++;
                        iotIssues.push(label + " \u2014 warning (" + entry.alerts.length + " alert" + (entry.alerts.length > 1 ? "s" : "") + ")");
                    }
                });

                // Tally Network health
                cl.clusterIds.forEach(function (clustId) {
                    var entry = clusterAlerts[clustId];
                    var cInfo = cl.clusterMap[clustId] || {};
                    var label = (cInfo.clusterName || "Cluster " + clustId) + " [Modem " + (cInfo.modemId || "?") + "]";
                    if (entry.dead) {
                        netUnhealthy++;
                        netIssues.push(label + " \u2014 sensor(s) dead (" + entry.alerts.length + " alert" + (entry.alerts.length > 1 ? "s" : "") + ")");
                    } else if (entry.warn) {
                        netWarning++;
                        netIssues.push(label + " \u2014 warning (" + entry.alerts.length + " alert" + (entry.alerts.length > 1 ? "s" : "") + ")");
                    }
                });
            }

            // Update station hardware data
            var station = stations.find(function (s) { return String(s.siteId) === String(sid); });
            if (station) {
                station.hardware.sensors = {
                    total: total,
                    unhealthy: unhealthy + warning,
                    issues: details.map(function (d) {
                        return d.assetName + " / " + (d.attrAlias || d.attrTitle) + " \u2014 " + d.status +
                            (d.alerts.length ? " (" + d.alerts.length + " alert" + (d.alerts.length > 1 ? "s" : "") + ")" : "");
                    })
                };
                // IoT / Network are now primarily bound to live device status
                // (Network-Dashboard style). Keep the sensor-alert mapping as
                // supplementary info, and only use it as the column source
                // while live device status has not loaded yet.
                station.hardware.iot = station.hardware.iot || { total: 0, unhealthy: 0, issues: [] };
                station.hardware.iot.alertIssues = iotIssues;
                station.hardware.iot.alertUnhealthy = iotUnhealthy + iotWarning;
                if (!station.hardware.iot.ds) {
                    station.hardware.iot.total = iotTotal;
                    station.hardware.iot.unhealthy = iotUnhealthy + iotWarning;
                    station.hardware.iot.issues = iotIssues;
                }
                station.hardware.network = station.hardware.network || { total: 0, unhealthy: 0, issues: [] };
                station.hardware.network.alertIssues = netIssues;
                station.hardware.network.alertUnhealthy = netUnhealthy + netWarning;
                if (!station.hardware.network.ds) {
                    station.hardware.network.total = netTotal;
                    station.hardware.network.unhealthy = netUnhealthy + netWarning;
                    station.hardware.network.issues = netIssues;
                }
            }
        });
    }

    function buildSiteAlertMap() {
        // Build map: { siteId: { siteName, services: {svcId: {status, alerts[], byNode:{cloud:{status,alerts},local:{status,alerts}}}}, allAlerts[], alertCount } }
        var map = {};

        function freshEntry() { return { status: "healthy", alerts: [], byNode: {} }; }
        function freshNodeEntry() { return { status: "healthy", alerts: [] }; }

        // Seed from stations so sites appear even if they have no alerts
        stations.forEach(function (st) {
            var sid = String(st.siteId);
            if (!map[sid]) {
                map[sid] = { siteName: st.stationName || ("Site " + sid), services: {}, allAlerts: [], alertCount: 0 };
                SERVICE_HEALTH_IDS.forEach(function (s) { map[sid].services[s] = freshEntry(); });
            }
            // No MQTT data within the staleness window -> mark every service unhealthy.
            if (isStationStale(st)) {
                SERVICE_HEALTH_IDS.forEach(function (s) {
                    if (!map[sid].services[s]) map[sid].services[s] = freshEntry();
                    map[sid].services[s].status = "unhealthy";
                    map[sid].services[s].stale = true;
                });
            }
        });

        // Process AlertLive data
        alertLiveRaw.forEach(function (alert) {
            var srcId = classifyServiceHealth(alert);
            if (!srcId) return;

            var sid = String(alert.siteId || 0);
            if (!map[sid]) {
                map[sid] = { siteName: "Site " + sid, services: {}, allAlerts: [], alertCount: 0 };
                SERVICE_HEALTH_IDS.forEach(function (s) { map[sid].services[s] = freshEntry(); });
            }

            // Try to get site name from alert description (format: "ServiceName/SiteName ...")
            if (alert.alertDescription && map[sid].siteName === "Site " + sid) {
                var descParts = alert.alertDescription.split("/");
                if (descParts.length > 1) {
                    var nameCandidate = descParts[1].split(" ")[0];
                    if (nameCandidate) map[sid].siteName = nameCandidate;
                }
            }

            var entry = map[sid].services[srcId];
            if (!entry) { entry = freshEntry(); map[sid].services[srcId] = entry; }

            var status = getAlertHealthStatus(alert.alertIdentifier);
            entry.alerts.push(alert);
            if (status === "unhealthy") entry.status = "unhealthy";
            else if (status === "warning" && entry.status !== "unhealthy") entry.status = "warning";

            // Track by node (Cloud / Local) - nodeIdentity, else role hint in alertIdentifier
            var nodeId = alertNodeOf(alert);
            if (nodeId === "cloud" || nodeId === "local") {
                if (!entry.byNode[nodeId]) entry.byNode[nodeId] = freshNodeEntry();
                entry.byNode[nodeId].alerts.push(alert);
                if (status === "unhealthy") entry.byNode[nodeId].status = "unhealthy";
                else if (status === "warning" && entry.byNode[nodeId].status !== "unhealthy") entry.byNode[nodeId].status = "warning";
            }

            map[sid].allAlerts.push(alert);
            map[sid].alertCount++;
        });

        return map;
    }

    // ===== MQTT =====
    function getPahoClientConstructor() {
        if (typeof Paho === "undefined") return null;
        if (Paho.MQTT && typeof Paho.MQTT.Client === "function") return Paho.MQTT.Client;
        if (typeof Paho.Client === "function") return Paho.Client;
        return null;
    }
    function getBrokerHost() { return firstDefined(mQTT.MQTTUri, mQTT.Host, mQTT.host, ""); }
    function getBrokerPort() { return parseInt(firstDefined(mQTT.MQTTPort, mQTT.Port, mQTT.port, window.location.protocol === "https:" ? 8084 : 8083), 10); }
    function getBrokerUser() { return firstDefined(mQTT.MQTTUsername, mQTT.Username, mQTT.username, ""); }
    function getBrokerPassword() { return firstDefined(mQTT.MQTTPassword, mQTT.Password, mQTT.password, ""); }

    function connectMqtt() {
        if (mqttConnected && mqttClient) return;
        var Ctor = getPahoClientConstructor();
        if (!Ctor) { log("Paho MQTT library not loaded", "err"); return; }
        var host = getBrokerHost(), port = getBrokerPort();
        if (!host || !port) { log("MQTT detail missing. Check ViewBag.MQTTDetail.", "err"); return; }
        var clientId = "FRS25_HEALTH_" + Date.now() + "_" + Math.floor(Math.random() * 10000);
        mqttClient = new Ctor(host, port, clientId);
        mqttClient.onConnectionLost = function (res) {
            mqttConnected = false; mqttSubscribed = false;
            log("Connection lost: " + (res && res.errorMessage ? res.errorMessage : "Disconnected"), "err");
            render();
        };
        mqttClient.onMessageArrived = function (message) {
            var topic = message.destinationName || "";
            var body = message.payloadString || "";
            log(topic + " => " + body.substring(0, 300), "in");
            try { mergeHealthPayload(JSON.parse(body), topic); }
            catch (e) { log("Invalid health JSON on " + topic + ": " + e.message, "err"); }
        };
        var opts = {
            timeout: 10,
            useSSL: window.location.protocol === "https:",
            cleanSession: true,
            onSuccess: function () { mqttConnected = true; log("Connected to " + host + ":" + port, "sys"); render(); subscribeMqtt(); },
            onFailure: function (err) { mqttConnected = false; log("Connect failed: " + (err && err.errorMessage ? err.errorMessage : JSON.stringify(err)), "err"); render(); }
        };
        var user = getBrokerUser(), pass = getBrokerPassword();
        if (user) opts.userName = user;
        if (pass) opts.password = pass;
        log("Connecting to " + host + ":" + port + "...", "sys");
        mqttClient.connect(opts);
    }

    function disconnectMqtt() {
        try { if (mqttClient && mqttConnected) mqttClient.disconnect(); } catch (e) { }
        mqttConnected = false; mqttSubscribed = false; mqttClient = null; currentSubscribedTopics = [];
        log("Disconnected", "sys"); render();
    }

    async function subscribeMqtt() {
        if (!mqttTopics.length) await refreshHealthMqttTopics(false);
        var topics = mqttTopics.length ? mqttTopics.slice() : getManualTopicList();
        mqttTopic = topics.join(", ");
        if (!mqttConnected || !mqttClient) { log("Connect MQTT first", "err"); return; }
        if (!topics.length) { log("No health topics found. Check Site base path configuration.", "err"); return; }
        try {
            currentSubscribedTopics.forEach(function (topic) {
                try { mqttClient.unsubscribe(topic); } catch (ignore) { }
                if (topic.charAt(0) !== "/") { try { mqttClient.unsubscribe("/" + topic); } catch (ignore) { } }
            });
            topics.forEach(function (topic) {
                mqttClient.subscribe(topic, { qos: 0 });
                // Some services publish with a leading slash (TriggerAlert uses
                // "/DNR/PPTA/alerthealth"). In MQTT "/a/b" and "a/b" are DIFFERENT
                // topics, so subscribe to both variants to catch either style.
                if (topic.charAt(0) !== "/") { try { mqttClient.subscribe("/" + topic, { qos: 0 }); } catch (ignore) { } }
            });
            currentSubscribedTopics = topics.slice();
            mqttSubscribed = true;
            log("Subscribed " + topics.length + " topic(s)", "sys");
            topics.slice(0, 10).forEach(function (topic) { log("SUB " + topic, "sys"); });
            if (topics.length > 10) log("... plus " + (topics.length - 10) + " more topic(s)", "sys");
            render();
        } catch (e) { log("Subscribe failed: " + e.message, "err"); }
    }

    // ===== DEBOUNCER WEBSOCKET =====
    var debouncerWsAttempts = 0, _dwsConnecting = false;
    function connectDebouncerWs() {
        if (_dwsConnecting) return;                                   // guard: connect already in flight
        if (debouncerWs && debouncerWs.readyState === WebSocket.OPEN) return;
        _dwsConnecting = true;

        // silent teardown of any stale socket (reference pattern)
        if (debouncerWs) {
            try {
                debouncerWs.onopen = null; debouncerWs.onmessage = null;
                debouncerWs.onclose = null; debouncerWs.onerror = null;
                debouncerWs.close(1000);
            } catch (e) { }
            debouncerWs = null;
        }
        if (debouncerWsReconnectTimer) { clearTimeout(debouncerWsReconnectTimer); debouncerWsReconnectTimer = null; }

        // wss upgrade on HTTPS + SSL auth token (same handling as telemetrylive.js)
        var wsUrl = buildSecureWsUrl(DEBOUNCER_WS_URL);

        try {
            debouncerWs = new WebSocket(wsUrl);
            debouncerWs.onopen = function () {
                _dwsConnecting = false;
                debouncerWsConnected = true;
                debouncerWsAttempts = 0;
                log("Debouncer WS connected: " + DEBOUNCER_WS_URL, "sys");
                renderThrottled();
            };
            debouncerWs.onmessage = function (event) {
                var body = event.data || "";
                log("WS Debouncer => " + body.substring(0, 300), "in");
                try {
                    var payload = JSON.parse(body);
                    mergeHealthPayload(payload, "debouncerHealth");
                } catch (e) { log("Invalid Debouncer WS JSON: " + e.message, "err"); }
            };
            debouncerWs.onclose = function () {
                _dwsConnecting = false;
                debouncerWsConnected = false; debouncerWs = null;
                debouncerWsAttempts++;
                if (debouncerWsAttempts > WS_MAX_RECONNECT_ATTEMPTS) {
                    log("Debouncer WS: max reconnect attempts reached (" + WS_MAX_RECONNECT_ATTEMPTS + "). Giving up.", "err");
                    renderThrottled();
                    return;
                }
                log("Debouncer WS closed. Reconnecting in " + (WS_RECONNECT_DELAY / 1000) + "s (attempt " + debouncerWsAttempts + "/" + WS_MAX_RECONNECT_ATTEMPTS + ")...", "err");
                renderThrottled();
                debouncerWsReconnectTimer = setTimeout(connectDebouncerWs, WS_RECONNECT_DELAY);
            };
            debouncerWs.onerror = function () {
                log("Debouncer WS error", "err");
            };
        } catch (e) {
            _dwsConnecting = false;
            log("Debouncer WS connect failed: " + e.message, "err");
            debouncerWsAttempts++;
            if (debouncerWsAttempts <= WS_MAX_RECONNECT_ATTEMPTS)
                debouncerWsReconnectTimer = setTimeout(connectDebouncerWs, WS_RECONNECT_DELAY);
        }
    }

    // ===== ALERTLIVE WEBSOCKET (real-time alert push) =====
    // Subscribes to ws(s)://<host>/subscribe/AlertLive/{siteId|all}. Each incoming
    // alert is upserted into alertLiveRaw (by alertId), re-classified by its
    // alertIdentifier rule, and the per-service counts / cells re-render instantly.
    // The 30s REST poll (fetchAlertLive) remains the authoritative reconciler.

    // Normalize whatever shape the socket sends into a flat array of alert objects.
    function normalizeAlertMessage(payload) {
        if (Array.isArray(payload)) return payload;
        if (!payload || typeof payload !== "object") return [];
        if (Array.isArray(payload.data)) return payload.data;
        if (Array.isArray(payload.Data)) return payload.Data;
        if (Array.isArray(payload.alerts)) return payload.alerts;
        if (Array.isArray(payload.Alerts)) return payload.Alerts;
        if (Array.isArray(payload.items)) return payload.items;
        // A single alert object pushed on its own.
        if (firstDefined(payload.alertId, payload.AlertId, payload.alertIdentifier, payload.AlertIdentifier) != null)
            return [payload];
        // A wrapper carrying a single alert under a known key.
        var single = firstDefined(payload.alert, payload.Alert, null);
        if (single && typeof single === "object") return [single];
        return [];
    }

    // An alert is "cleared" (and should leave the live set) when it is reset/completed.
    function isAlertCleared(a) {
        var state = String(firstDefined(a.alertState, a.AlertState, "") || "").toLowerCase();
        if (state === "reset" || state === "completed" || state === "complete" ||
            state === "cleared" || state === "inactive" || state === "normal" || state === "closed") return true;
        if (firstDefined(a.timestampReset, a.TimestampReset, null)) return true;
        if (firstDefined(a.timestampCompleted, a.TimestampCompleted, null)) return true;
        return false;
    }

    function alertKeyOf(a) { return firstDefined(a.alertId, a.AlertId, null); }

    // Merge a batch of pushed alerts into alertLiveRaw. Returns true if anything changed.
    function upsertAlertLive(incoming) {
        var changed = false;
        incoming.forEach(function (a) {
            var id = alertKeyOf(a);
            var idx = -1;
            if (id != null) {
                for (var i = 0; i < alertLiveRaw.length; i++) {
                    if (alertKeyOf(alertLiveRaw[i]) === id) { idx = i; break; }
                }
            }
            if (isAlertCleared(a)) {
                if (idx >= 0) { alertLiveRaw.splice(idx, 1); changed = true; }
                return;
            }
            if (idx >= 0) { alertLiveRaw[idx] = a; changed = true; }
            else { alertLiveRaw.push(a); changed = true; }
        });
        return changed;
    }

    function connectAlertLiveWs() {
        if (_alwsConnecting) return;
        if (alertLiveWs && alertLiveWs.readyState === WebSocket.OPEN) return;
        _alwsConnecting = true;

        // silent teardown of any stale socket
        if (alertLiveWs) {
            try {
                alertLiveWs.onopen = null; alertLiveWs.onmessage = null;
                alertLiveWs.onclose = null; alertLiveWs.onerror = null;
                alertLiveWs.close(1000);
            } catch (e) { }
            alertLiveWs = null;
        }
        if (alertLiveWsReconnectTimer) { clearTimeout(alertLiveWsReconnectTimer); alertLiveWsReconnectTimer = null; }

        // Keep the token-less URL for the site-change reconnect comparison,
        // but connect with the wss upgrade + SSL token applied (telemetrylive scheme).
        alertLiveWsCurrentUrl = alertLiveWsUrl();
        var wsUrl = buildSecureWsUrl(alertLiveWsCurrentUrl);

        try {
            alertLiveWs = new WebSocket(wsUrl);
            alertLiveWs.onopen = function () {
                _alwsConnecting = false;
                alertLiveWsConnected = true;
                alertLiveWsAttempts = 0;
                log("AlertLive WS connected: " + alertLiveWsCurrentUrl, "sys");
                renderThrottled();
            };
            alertLiveWs.onmessage = function (event) {
                var body = event.data || "";
                log("WS AlertLive => " + String(body).substring(0, 300), "in");
                try {
                    var payload = JSON.parse(body);
                    var batch = normalizeAlertMessage(payload);
                    if (!batch.length) return;
                    if (upsertAlertLive(batch)) {
                        // Rebuild indexes from the merged live set, then refresh sensor
                        // cross-reference and the grid - counts update in real time.
                        processAlertLiveData(alertLiveRaw);
                        crossReferenceSensorAlerts();
                        renderThrottled();
                    }
                } catch (e) { log("Invalid AlertLive WS JSON: " + e.message, "err"); }
            };
            alertLiveWs.onclose = function () {
                _alwsConnecting = false;
                alertLiveWsConnected = false; alertLiveWs = null;
                alertLiveWsAttempts++;
                if (alertLiveWsAttempts > WS_MAX_RECONNECT_ATTEMPTS) {
                    log("AlertLive WS: max reconnect attempts reached (" + WS_MAX_RECONNECT_ATTEMPTS + "). Giving up.", "err");
                    renderThrottled();
                    return;
                }
                log("AlertLive WS closed. Reconnecting in " + (WS_RECONNECT_DELAY / 1000) + "s (attempt " + alertLiveWsAttempts + "/" + WS_MAX_RECONNECT_ATTEMPTS + ")...", "err");
                renderThrottled();
                alertLiveWsReconnectTimer = setTimeout(connectAlertLiveWs, WS_RECONNECT_DELAY);
            };
            alertLiveWs.onerror = function () {
                log("AlertLive WS error", "err");
            };
        } catch (e) {
            _alwsConnecting = false;
            log("AlertLive WS connect failed: " + e.message, "err");
            alertLiveWsAttempts++;
            if (alertLiveWsAttempts <= WS_MAX_RECONNECT_ATTEMPTS)
                alertLiveWsReconnectTimer = setTimeout(connectAlertLiveWs, WS_RECONNECT_DELAY);
        }
    }

    // Reconnect the AlertLive socket if the desired subscription (site vs all) changed.
    function reconnectAlertLiveWsForSite() {
        var desired = alertLiveWsUrl();
        if (desired === alertLiveWsCurrentUrl && alertLiveWs && alertLiveWs.readyState === WebSocket.OPEN) return;
        alertLiveWsAttempts = 0;
        connectAlertLiveWs();
    }

    // ===== LOG (debug only) =====
    var logBuffer = [];
    function log(msg, type) {
        var prefix = type === "err" ? "ERR" : type === "in" ? "IN " : type === "out" ? "OUT" : "SYS";
        logBuffer.push(new Date().toLocaleTimeString("en-GB") + " [" + prefix + "] " + msg);
        if (logBuffer.length > 100) logBuffer.shift();
        restoreLog();
    }
    function restoreLog() {
        if (window && window.console && logBuffer.length) window.HealthLastMqttLog = logBuffer.slice();
    }

    // ===== View Switching =====
    var _savedScrollY = null;
    function switchView(view) {
        _savedScrollY = window.scrollY;
        activeView = view;
        render();
    }

    // ===== Alert List Toggle =====
    function toggleSiteAlerts(siteId) {
        var el = document.getElementById("ahrow_" + siteId);
        if (el) el.classList.toggle("collapsed");
    }

    function openAlertDetail(alertId) {
        currentModal = null;
        var alert = alertLiveRaw.find(function (a) { return a.alertId === alertId; });
        if (!alert) return;
        var m = document.getElementById("mo"), o = document.getElementById("ov");
        var parsed = parseAlertIdentifier(alert.alertIdentifier);
        var html = '<div class="modal-hdr"><h3>\u26A0\uFE0F Alert Detail \u2014 ' + esc(alert.sourceId) + '</h3>' + modalFsBtn() + '<button class="modal-close" onclick="HealthDash.closeModal()">&#215;</button></div>';
        html += '<div class="modal-body">';
        html += '<div class="m-sec"><div class="m-sec-t">Alert Info</div><div class="m-metrics">';
        var fields = [
            ["Alert ID", alert.alertId], ["Site ID", alert.siteId], ["Source", alert.sourceId],
            ["State", alert.alertState], ["Priority", alert.priority], ["Category", alert.category],
            ["Kind", parsed.kind], ["Rule", parsed.rule],
            ["Node", firstDefined(alert.nodeIdentity, alert.NodeIdentity, null)]
        ];
        fields.forEach(function (f) { if (f[1]) html += '<div class="m-met"><div class="ml">' + esc(f[0]) + '</div><div class="mv">' + esc(f[1]) + '</div></div>'; });
        html += '</div></div>';
        html += '<div class="m-sec"><div class="m-sec-t">Description</div><div style="font-size:12px;color:var(--tx2);line-height:1.5">' + esc(alert.alertDescription) + '</div></div>';
        html += '<div class="m-sec"><div class="m-sec-t">Timestamps</div><div class="m-metrics">';
        ["timestampSet", "timestampAck", "timestampReset", "timestampCompleted", "timestampUpdated"].forEach(function (ts) {
            if (alert[ts]) html += '<div class="m-met"><div class="ml">' + esc(ts.replace("timestamp", "")) + '</div><div class="mv" style="font-size:11px">' + new Date(alert[ts]).toLocaleString() + '</div></div>';
        });
        html += '</div></div>';
        // Show all non-null fields
        html += '<div class="m-sec"><div class="m-sec-t">All Fields</div><div class="m-metrics">';
        Object.keys(alert).forEach(function (k) {
            if (alert[k] !== null && alert[k] !== undefined && alert[k] !== "") {
                html += '<div class="m-met"><div class="ml">' + esc(k) + '</div><div class="mv" style="font-size:11px;word-break:break-all">' + esc(alert[k]) + '</div></div>';
            }
        });
        html += '</div></div>';
        html += '</div>';
        m.innerHTML = html;
        m.classList.add("open"); o.classList.add("open");
    }

    // Open a modal showing alerts for a specific service at a specific site, filtered by nodeIdentity
    // =====================================================================
    // ALERT CENTER MODAL (bifurcated: Live | History)
    // Opened from a service's eye/Health icon (node-scoped) or the service
    // count badge (whole service). The Live tab reads the real-time AlertLive
    // feed; the History tab queries GetAlertHistory over a chosen date range
    // (default last 24h). Both bind: identifier, kind (local/cloud), description,
    // station, siteId, set/reset timestamps, priority, category.
    // =====================================================================
    var AC_SVC_LABELS = { DataReceiverHealth: "Data Receiver", DataloggerHealth: "Datalogger", AlertHealth: "Alert", DebouncerHealth: "Debouncer", PointMachineHealth: "Point Machine" };
    var acState = { siteId: null, sourceId: null, node: null, tab: "live", from: null, to: null, hist: null, histLoading: false, histErr: null };

    function acIsoLocal(d) {
        function p(n) { return String(n).padStart(2, "0"); }
        return d.getFullYear() + "-" + p(d.getMonth() + 1) + "-" + p(d.getDate()) + "T" + p(d.getHours()) + ":" + p(d.getMinutes());
    }
    function acParseLocal(v) { var d = new Date(v); return isNaN(d.getTime()) ? null : d; }
    function acStationName(siteId) {
        var stn = stations.find(function (s) { return String(s.siteId) === String(siteId); });
        return stn ? (stn.stationName || ("Site " + siteId)) : ("Site " + siteId);
    }
    function acRowState(a) {
        var reset = firstDefined(a.timestampReset, a.TimestampReset, a.timestampCompleted, a.TimestampCompleted, null);
        if (reset) return "Reset";
        var st = String(firstDefined(a.alertState, a.AlertState, "") || "");
        return st || "Set";
    }
    function acNodeOf(a) {
        var n = alertNodeOf(a);
        if (n) return n;
        // hardware/source-typed alerts carry no local/cloud - show the source type
        var stype = String(firstDefined(a.sourceType, a.SourceType, "") || "");
        return stype ? stype.toLowerCase() : "";
    }
    function acIdentifier(a) {
        var parsed = parseAlertIdentifier(a.alertIdentifier || a.AlertIdentifier);
        return parsed.rule || String(firstDefined(a.sourceType, a.SourceType, a.sourceId, a.SourceId, "") || "") || "alert";
    }
    // site + service match (node-agnostic)
    function acMatchesSvc(a) {
        if (String(a.siteId || a.SiteId || 0) !== String(acState.siteId)) return false;
        return classifyServiceHealth(a) === acState.sourceId;
    }
    // Live match: service + (the node the modal was opened with, if any)
    function acMatches(a) {
        if (!acMatchesSvc(a)) return false;
        if (acState.node && alertNodeOf(a) !== acState.node) return false;
        return true;
    }

    function openAlertCenter(siteId, sourceId, node) {
        currentModal = null;  // snapshot modal: grid re-renders won't reset the active tab/date
        var to = new Date(), from = new Date(to.getTime() - AH_DAY_MS);
        var nd = (node === "local" || node === "cloud") ? node : null;
        acState = {
            siteId: String(siteId), sourceId: sourceId, node: nd,
            tab: "live", from: from, to: to, hist: null, histLoading: false, histErr: null
        };
        acRender();
        document.getElementById("ov").classList.add("open");
    }

    function acSwitchTab(tab) {
        acReadDateInputs(); // persist any edited dates before switching away
        acState.tab = tab;
        if (tab === "history" && acState.hist === null && !acState.histLoading) { acLoadHistory(false); return; }
        acRender();
    }
    function acReadDateInputs() {
        var f = document.getElementById("acFrom"), t = document.getElementById("acTo");
        if (f && f.value) { var df = acParseLocal(f.value); if (df) acState.from = df; }
        if (t && t.value) { var dt = acParseLocal(t.value); if (dt) acState.to = dt; }
    }
    function acApplyHistory() { acReadDateInputs(); acLoadHistory(true); }

    function acLoadHistory(force) {
        acState.histLoading = true; acState.histErr = null;
        acRender();
        fetchAlertHistory(acState.siteId, acState.from, acState.to, { force: force }).then(function (list) {
            acState.hist = Array.isArray(list) ? list : [];
            acState.histLoading = false;
            acRender();
        }).catch(function (e) {
            acState.histLoading = false; acState.histErr = e && e.message ? e.message : "Failed to load history";
            acRender();
        });
    }

    function acAlertRowHtml(a, isHistory) {
        var node = acNodeOf(a);
        var nodeCls = node === "cloud" ? "cloud" : (node === "local" ? "local" : "src");
        var status = getAlertHealthStatus(a.alertIdentifier || a.AlertIdentifier);
        var kCls = status === "unhealthy" ? "red" : "amb";
        var setTs = firstDefined(a.timestampSet, a.TimestampSet, "");
        var resetTs = firstDefined(a.timestampReset, a.TimestampReset, a.timestampCompleted, a.TimestampCompleted, "");
        var aid = firstDefined(a.alertId, a.AlertId, a.id, a.Id, null);
        var rowState = acRowState(a);
        var stateCls = /reset|complete/i.test(rowState) ? "g" : "a";
        return '<tr' + (aid != null ? ' class="ac-row-click" onclick="HealthDash.openAlertDetail(' + num(aid) + ')"' : '') + '>' +
            '<td><span class="ac-node ' + nodeCls + '">' + esc(node || "\u2014") + '</span></td>' +
            '<td><span class="ac-ident ' + kCls + '">' + esc(acIdentifier(a)) + '</span></td>' +
            '<td class="ac-desc">' + esc(firstDefined(a.alertDescription, a.AlertDescription, "")) + '</td>' +
            '<td>' + esc(firstDefined(a.priority, a.Priority, "\u2014")) + '</td>' +
            '<td>' + esc(firstDefined(a.category, a.Category, "\u2014")) + '</td>' +
            '<td><span class="ac-state ' + stateCls + '">' + esc(rowState) + '</span></td>' +
            '<td class="ac-ts set">' + (setTs ? esc(new Date(setTs).toLocaleString()) : "\u2014") + '</td>' +
            '<td class="ac-ts">' + (resetTs ? esc(new Date(resetTs).toLocaleString()) : "\u2014") + '</td>' +
            '</tr>';
    }

    function acTableHtml(list, isHistory) {
        var head = '<div class="ac-table-wrap"><table class="ac-table"><thead><tr>' +
            '<th>Kind</th><th>Identifier</th><th>Description</th><th>Priority</th><th>Category</th><th>State</th><th>Set</th><th>Reset</th>' +
            '</tr></thead><tbody>';
        var body = list.map(function (a) { return acAlertRowHtml(a, isHistory); }).join("");
        return head + body + '</tbody></table></div>';
    }

    function acRender() {
        var m = document.getElementById("mo");
        if (!m) return;
        var label = AC_SVC_LABELS[acState.sourceId] || acState.sourceId;
        var scope = acState.node ? (acState.node === "cloud" ? "\u2601 Cloud" : "\uD83D\uDCBB Local") : "All nodes";
        var station = acStationName(acState.siteId);

        // live list (current snapshot, scoped to the opened node if any)
        var liveList = alertLiveRaw.filter(acMatches);
        var liveCount = liveList.length;

        // history list (service + the node this modal was opened for)
        var histAll = Array.isArray(acState.hist) ? acState.hist : [];
        var histList = histAll.filter(acMatches);
        var histCount = histList.length;

        var html = '<div class="modal-hdr"><h3>\u26A1 ' + esc(label) + ' \u2014 ' + esc(station) +
            ' <span class="ac-scope">' + esc(scope) + '</span> <span class="ac-site">site ' + esc(acState.siteId) + '</span></h3>' +
            modalFsBtn() + '<button class="modal-close" onclick="HealthDash.closeModal()">&#215;</button></div>';
        html += '<div class="modal-body ac-body">';

        // Primary tabs (Live | History)
        html += '<div class="ac-tabs">' +
            '<button class="ac-tab' + (acState.tab === "live" ? " active" : "") + '" onclick="HealthDash.acSwitchTab(\'live\')">Live <span class="ac-tabn">' + liveCount + '</span></button>' +
            '<button class="ac-tab' + (acState.tab === "history" ? " active" : "") + '" onclick="HealthDash.acSwitchTab(\'history\')">History <span class="ac-tabn">' + (acState.hist === null ? "\u2013" : histCount) + '</span></button>' +
            '</div>';

        if (acState.tab === "live") {
            if (!liveCount) {
                html += '<div class="ac-empty">\u2705 No active ' + esc(label) + ' alerts' + (acState.node ? (" on " + esc(scope)) : "") + ' right now.</div>';
            } else {
                html += '<div class="ac-note">Real-time active alerts from AlertLive.</div>' + acTableHtml(liveList, false);
            }
        } else {
            // Date-range filter (history is already scoped to this node)
            html += '<div class="ac-filter">' +
                '<label>From <input type="datetime-local" id="acFrom" value="' + esc(acIsoLocal(acState.from)) + '"></label>' +
                '<label>To <input type="datetime-local" id="acTo" value="' + esc(acIsoLocal(acState.to)) + '"></label>' +
                '<button class="ac-apply" onclick="HealthDash.acApplyHistory()">Apply</button>' +
                '</div>';

            if (acState.histLoading) {
                html += '<div class="ac-empty"><span class="msel-spin"></span> Loading history\u2026</div>';
            } else if (acState.histErr) {
                html += '<div class="ac-empty" style="color:var(--red)">History load failed \u2014 ' + esc(acState.histErr) + '</div>';
            } else if (acState.hist === null) {
                html += '<div class="ac-empty">Pick a range and press Apply.</div>';
            } else if (!histCount) {
                html += '<div class="ac-empty">No ' + esc(label) + ' history' + (acState.node ? (" on " + esc(scope)) : "") + ' in this range.</div>';
            } else {
                html += '<div class="ac-note">' + histCount + ' alert' + (histCount !== 1 ? 's' : '') +
                    ' between ' + esc(acState.from.toLocaleString()) + ' and ' + esc(acState.to.toLocaleString()) + '.</div>' +
                    acTableHtml(histList, true);
            }
        }

        html += '</div>';
        m.innerHTML = html;
        m.classList.add("open");
    }

    // Eye/Health icon (node-scoped) -> bifurcated Live | History modal for that node.
    function openNodeAlerts(siteId, svcId, nodeType) {
        openAlertCenter(siteId, svcId, nodeType);
    }

    // Service-level alert model bound from AlertLive: every active alert for one
    // service at one site (both nodes), grouped by node and split into
    // dead (service.dead) vs bad (health.bad). Opened from the service count badge.
    function buildServiceAlertModel(siteId, sourceId) {
        var svcLabels = { DataReceiverHealth: "Data Receiver", DataloggerHealth: "Datalogger", AlertHealth: "Alert", DebouncerHealth: "Debouncer", PointMachineHealth: "Point Machine" };
        var model = {
            siteId: String(siteId),
            sourceId: sourceId,
            serviceLabel: svcLabels[sourceId] || sourceId,
            count: 0, dead: 0, bad: 0,
            status: "healthy",
            byNode: { local: [], cloud: [], none: [] },
            alerts: []
        };
        alertLiveRaw.forEach(function (a) {
            if (String(a.siteId || 0) !== String(siteId)) return;
            if (classifyServiceHealth(a) !== sourceId) return;
            var parsed = parseAlertIdentifier(a.alertIdentifier);
            var status = getAlertHealthStatus(a.alertIdentifier);
            var node = alertNodeOf(a) || "none";
            var item = {
                alertId: firstDefined(a.alertId, a.AlertId, null),
                rule: parsed.rule || "",
                kind: parsed.kind || "",
                node: node,
                status: status,
                description: firstDefined(a.alertDescription, a.AlertDescription, ""),
                priority: firstDefined(a.priority, a.Priority, ""),
                category: firstDefined(a.category, a.Category, ""),
                state: firstDefined(a.alertState, a.AlertState, ""),
                limitString: firstDefined(a.limitString, a.LimitString, ""),
                timestampSet: firstDefined(a.timestampSet, a.TimestampSet, ""),
                timestampUpdated: firstDefined(a.timestampUpdated, a.TimestampUpdated, ""),
                raw: a
            };
            model.alerts.push(item);
            (model.byNode[node] || (model.byNode[node] = [])).push(item);
            model.count++;
            if (status === "unhealthy") { model.dead++; model.status = "unhealthy"; }
            else { model.bad++; if (model.status !== "unhealthy") model.status = "warning"; }
        });
        return model;
    }

    // Service-title count badge -> bifurcated Live | History modal for the whole service.
    function openServiceAlerts(siteId, sourceId) {
        openAlertCenter(siteId, sourceId, null);
    }
    // =====================================================================
    // HISTORY MODAL (watch button) - Modem & A10 graphs bound exactly like
    // the Network Dashboard:
    //   GetModemHistoryForGraph -> [{TimeStamp, TypeId(1 TCP / 2 MQTT), SignalStrength}]
    //   GetA10HistoryForGraph   -> [{TimeStamp, TypeId, ResponseTime | Uptime}]
    //   GetA10HistoryRecords    -> {Success, Data:[records]}
    // Dates go to the API as dd-MM-yyyy (same as the Network Dashboard).
    // =====================================================================
    var histState = { siteId: null, chart: null, sel: null, selType: null, lastData: null };

    function hdUrlOk(u) { return u && u !== "null"; }
    function hdFormatDateApi(dateStr) {
        // "yyyy-mm-dd" -> "dd-MM-yyyy" via string split (avoids UTC-midnight day shift)
        var p = String(dateStr).split("-");
        if (p.length === 3) return p[2] + "-" + p[1] + "-" + p[0];
        var d = new Date(dateStr);
        return String(d.getDate()).padStart(2, "0") + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + d.getFullYear();
    }
    function hdIsoDay(d) { return d.toISOString().slice(0, 10); }
    function hdUnwrapList(resp) {
        if (Array.isArray(resp)) return resp;
        if (resp && Array.isArray(resp.Data)) return resp.Data;
        if (resp && Array.isArray(resp.data)) return resp.data;
        return [];
    }
    function histDates() {
        return { from: document.getElementById("histFrom").value, to: document.getElementById("histTo").value };
    }
    function destroyHistChart() {
        if (histState.chart) { try { histState.chart.destroy(); } catch (e) { } histState.chart = null; }
    }

    // =====================================================================
    // HISTORY IN A SEPARATE PAGE - the watch button opens a standalone tab
    // with the station's Modem / A10 / Sensor history. If the popup is
    // blocked by the browser, it falls back to the in-page modal.
    // =====================================================================
    function openHistory(sid) {
        // Open Health History in a SEPARATE BROWSER TAB so the live dashboard
        // (MQTT subscriptions, alert polling) keeps running untouched.
        // Falls back to same-tab navigation if the popup is blocked.
        if (!sid) return;
        var url = HISTORY_PAGE_URL + "?siteId=" + encodeURIComponent(sid);
        var w = window.open(url, "_blank", "noopener");
        if (!w) window.location.href = url;
    }

    function buildHistoryWindow(w, stn) {
        function absUrl(u) { return (!u || u === "null") ? "" : (u.charAt(0) === "/" ? (window.location.origin + u) : u); }
        var sensorAlerts = alertLiveRaw.filter(function (a) {
            return String(a.siteId || "") === String(stn.siteId) && !classifyServiceHealth(a);
        }).slice(0, 300).map(function (a) {
            return {
                time: firstDefined(a.timestampSet, a.TimestampSet, null),
                source: String(firstDefined(a.sourceId, a.SourceId, "Sensor")),
                desc: String(firstDefined(a.alertDescription, a.AlertDescription, "")),
                priority: String(firstDefined(a.priority, a.Priority, ""))
            };
        });
        var cfg = {
            siteId: stn.siteId,
            siteName: String(stn.stationName || ("Site " + stn.siteId)),
            zone: String(stn.zone || "?"),
            division: String(stn.division || "?"),
            deviceStatusUrl: absUrl(DEVICE_STATUS_URL),
            modemGraphUrl: absUrl(MODEM_GRAPH_URL),
            a10GraphUrl: absUrl(A10_GRAPH_URL),
            a10RecordsUrl: absUrl(A10_RECORDS_URL),
            sensorAlerts: sensorAlerts,
            generatedAt: new Date().toLocaleString()
        };
        w.document.open();
        w.document.write(buildHistoryDocHtml(cfg));
        w.document.close();
    }

    function buildHistoryDocHtml(cfg) {
        var cfgJson = JSON.stringify(cfg).replace(/</g, "\\u003c");
        return `<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Health History - ${cfg.siteName.replace(/[<>&"]/g, "")}</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"><\/script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"><\/script>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#070d1d;--bg2:#0c1731;--bg3:#101e3e;--bdr:#1b2c55;--bdr2:#27407a;--tx:#e7edf7;--tx2:#9fb1d1;--tx3:#5f7499;--tx4:#3c4f74;--grn:#34d399;--amb:#fbbf24;--red:#fb7185;--blu:#60a5fa;--cyan:#22d3ee;--mono:'JetBrains Mono',ui-monospace,monospace;--sans:'Manrope','Segoe UI',-apple-system,sans-serif}
body{font-family:var(--sans);background:radial-gradient(1100px 500px at 15% -10%,rgba(34,211,238,.10),transparent 60%),radial-gradient(900px 480px at 95% 0%,rgba(96,165,250,.10),transparent 55%),var(--bg);color:var(--tx);min-height:100vh;padding:26px}
.wrap{max-width:1180px;margin:0 auto}
.hdr{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;margin-bottom:18px}
.hdr h1{font-size:21px;font-weight:800}
.hdr h1 em{color:var(--cyan);font-style:normal}
.hdr .meta{font-size:12px;color:var(--tx3);margin-top:3px}
.hdr .meta b{color:var(--tx2)}
.gen{font-size:11px;color:var(--tx3)}
.datebar{background:var(--bg2);border:1px solid var(--bdr);border-radius:12px;padding:12px 16px;margin-bottom:16px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.datebar label{font-size:10px;font-weight:700;color:var(--tx3);text-transform:uppercase;letter-spacing:.08em}
.datebar input[type=date]{background:var(--bg3);color:var(--tx);border:1px solid var(--bdr2);border-radius:8px;padding:7px 11px;font-size:12px;font-family:var(--sans);color-scheme:dark}
.datebar input:focus{outline:none;border-color:var(--cyan)}
.tabs{display:flex;gap:0;border-bottom:2px solid var(--bdr);margin-bottom:16px;flex-wrap:wrap}
.tab{padding:10px 18px;font-size:12.5px;font-weight:600;cursor:pointer;color:var(--tx3);border-bottom:3px solid transparent;margin-bottom:-2px;white-space:nowrap}
.tab:hover{color:var(--tx)}
.tab.active{color:var(--cyan);border-bottom-color:var(--cyan)}
.tab.svc.active{color:var(--grn);border-bottom-color:var(--grn)}
.sec-t{font-size:10.5px;font-weight:700;color:var(--tx3);text-transform:uppercase;letter-spacing:.1em;margin:0 0 10px}
.dev-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:10px;margin-bottom:14px}
.dev-card{background:var(--bg2);border:1px solid var(--bdr);border-radius:10px;padding:12px 14px;cursor:pointer;transition:border-color .15s}
.dev-card:hover{border-color:var(--blu)}
.dev-card.sel{border-color:var(--cyan);background:rgba(34,211,238,.06)}
.dc-top{display:flex;justify-content:space-between;align-items:center;gap:6px;margin-bottom:6px}
.dc-name{font-size:12.5px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dc-meta{font-size:10px;color:var(--tx3);display:flex;gap:10px;flex-wrap:wrap;font-family:var(--mono)}
.tag{font-size:9px;font-weight:700;padding:2px 8px;border-radius:4px;display:inline-flex;align-items:center;gap:4px}
.tag i{width:5px;height:5px;border-radius:50%;display:inline-block}
.tag.on{background:rgba(52,211,153,.12);color:var(--grn)} .tag.on i{background:var(--grn)}
.tag.off{background:rgba(251,113,133,.12);color:var(--red)} .tag.off i{background:var(--red)}
.chip{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:600;padding:5px 11px;border-radius:14px;border:1px solid var(--bdr);background:var(--bg2);color:var(--tx2);cursor:pointer;margin:2px}
.chip:hover{border-color:var(--blu)}
.chip.sel{border-color:var(--cyan);background:rgba(34,211,238,.08);color:var(--cyan)}
.chip i{width:7px;height:7px;border-radius:50%;display:inline-block}
.chip i.on{background:var(--grn)} .chip i.off{background:var(--red)}
.agroup{margin-bottom:12px}
.agroup .ag-h{font-size:11px;font-weight:700;color:var(--tx2);margin-bottom:6px}
.gbox{background:var(--bg2);border:1px solid var(--bdr);border-radius:12px;padding:14px;margin-top:10px}
.gbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:10px}
.gtitle{font-size:12.5px;font-weight:700;color:var(--tx2);margin-right:auto}
.gchk{display:inline-flex;align-items:center;gap:5px;font-size:11px;color:var(--tx2);cursor:pointer}
.gchk input{accent-color:var(--cyan)}
.gbtn{background:var(--cyan);color:#04222b;border:none;border-radius:8px;padding:7px 15px;font-size:11.5px;font-weight:700;cursor:pointer}
.gbtn:disabled{opacity:.5;cursor:not-allowed}
.gstats{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:8px}
.gstat{display:inline-flex;align-items:center;gap:8px;background:var(--bg3);border:1px solid var(--bdr);border-radius:8px;padding:6px 12px;font-size:11px;color:var(--tx2)}
.gdot{width:8px;height:8px;border-radius:50%;display:inline-block}
.gdot.tcp{background:var(--blu)} .gdot.mqtt{background:var(--grn)}
.pct{font-weight:700;font-family:var(--mono)} .pct.good{color:var(--grn)} .pct.warn{color:var(--amb)} .pct.poor{color:var(--red)}
.cwrap{position:relative;height:330px}
.note{display:none;align-items:center;justify-content:center;height:110px;color:var(--tx3);font-size:12px}
.rows{display:flex;flex-direction:column;gap:6px;max-height:260px;overflow-y:auto;margin-top:10px}
.row{display:flex;align-items:center;gap:10px;background:var(--bg3);border:1px solid var(--bdr);border-radius:8px;padding:7px 12px;font-size:11.5px}
.row .t{font-family:var(--mono);color:var(--tx3);white-space:nowrap}
.row .p{font-size:9px;font-weight:700;padding:1px 7px;border-radius:8px}
.row .p.tcp{background:rgba(96,165,250,.12);color:var(--blu)} .row .p.mqtt{background:rgba(52,211,153,.12);color:var(--grn)}
.row .x{color:var(--tx2)}
.tl{position:relative;padding-left:28px}
.tl::before{content:"";position:absolute;left:10px;top:0;bottom:0;width:2px;background:var(--bdr)}
.tli{position:relative;padding:10px 16px;margin-bottom:8px;background:var(--bg2);border:1px solid var(--bdr);border-radius:8px}
.tli::before{content:"";position:absolute;left:-22px;top:14px;width:10px;height:10px;border-radius:50%;border:2px solid var(--bdr2)}
.tli.crit::before{background:var(--red);border-color:var(--red)}
.tli.warn::before{background:var(--amb);border-color:var(--amb)}
.tli .tt{font-size:11px;font-family:var(--mono);color:var(--tx3);margin-bottom:3px}
.tli .te{font-size:13px;font-weight:600}
.tli .ts{font-size:11px;color:var(--tx2);margin-top:3px;line-height:1.4}
.empty{text-align:center;color:var(--tx3);padding:30px;font-size:12px}
.pending{background:var(--bg2);border:1px dashed var(--bdr2);border-radius:12px;padding:26px;text-align:center;color:var(--tx3);font-size:12.5px;line-height:1.7}
.pending b{color:var(--tx2)}
.ftr{text-align:center;margin-top:26px;font-size:10px;color:var(--tx3)}
</style></head><body><div class="wrap">
<div class="hdr"><div><h1><em>&#x1F552;</em> Health History - <span id="stn"></span></h1><div class="meta" id="meta"></div></div><div class="gen" id="gen"></div></div>
<div class="datebar"><label>From</label><input type="date" id="dFrom"/><label>To</label><input type="date" id="dTo"/><span style="font-size:10.5px;color:var(--tx4)">Pick a device below, then Load Graph. Dates use the same range for graphs, records and the sensor timeline.</span></div>
<div class="tabs" id="tabs"></div>
<div id="body"></div>
<div class="ftr">RDPMS Health History &middot; ENERGY7</div>
</div>
<script>
var CFG = ${cfgJson};
var modems = [], devErr = null, devLoading = true;
var sel = null, selType = null, chart = null, lastData = null, activeTab = "network";
function el(id){ return document.getElementById(id); }
function esc(v){ return String(v == null ? "" : v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
function num(v,d){ var n = Number(v); return isFinite(n) ? n : (d || 0); }
function fd(){ for (var i = 0; i < arguments.length; i++) if (arguments[i] !== undefined && arguments[i] !== null && arguments[i] !== "") return arguments[i]; return null; }
function isoDay(d){ return d.toISOString().slice(0,10); }
function fmtApi(s){ var p = String(s).split("-"); if (p.length === 3) return p[2] + "-" + p[1] + "-" + p[0]; var d = new Date(s); return String(d.getDate()).padStart(2,"0") + "-" + String(d.getMonth()+1).padStart(2,"0") + "-" + d.getFullYear(); }
function parseTs(v){
  if (v === null || v === undefined || v === "") return null;
  if (v instanceof Date) return isNaN(v.getTime()) ? null : v.getTime();
  if (typeof v === "number") return v > 1e12 ? v : (v > 1e9 ? v * 1000 : null);
  var s = String(v).trim();
  var m = s.match(/\/Date\((-?\d+)/);
  if (m) return Number(m[1]);
  var t = Date.parse(s);
  if (!isNaN(t)) return t;
  m = s.match(/^(\d{1,2})-(\d{1,2})-(\d{4})(?:[ T](\d{1,2}):(\d{1,2})(?::(\d{1,2}))?)?/);
  if (m) return new Date(+m[3], +m[2] - 1, +m[1], +(m[4] || 0), +(m[5] || 0), +(m[6] || 0)).getTime();
  return null;
}
el("stn").textContent = CFG.siteName;
el("meta").innerHTML = esc(CFG.zone) + " &rsaquo; " + esc(CFG.division) + " &middot; <b>Site ID: " + esc(CFG.siteId) + "</b>";
el("gen").textContent = "Generated: " + CFG.generatedAt;
el("dFrom").value = isoDay(new Date()); el("dTo").value = isoDay(new Date());
var TABS = [{k:"network",l:"Network (Modem)"},{k:"iot",l:"IoT (A10)"},{k:"sensors",l:"Sensors"},{k:"services",l:"Services",c:"svc"}];
el("tabs").innerHTML = TABS.map(function(t,i){ return '<div class="tab ' + (t.c||"") + (i===0?" active":"") + '" data-k="' + t.k + '">' + t.l + '</div>'; }).join("");
Array.prototype.forEach.call(document.querySelectorAll(".tab"), function(t){
  t.onclick = function(){
    Array.prototype.forEach.call(document.querySelectorAll(".tab"), function(x){ x.classList.remove("active"); });
    t.classList.add("active"); activeTab = t.getAttribute("data-k"); renderTab();
  };
});
function destroyChart(){ if (chart) { try { chart.destroy(); } catch(e){} chart = null; } }
function loadDevices(){
  if (!CFG.deviceStatusUrl) { devLoading = false; devErr = "Device endpoint not configured"; renderTab(); return; }
  fetch(CFG.deviceStatusUrl + "?siteId=" + encodeURIComponent(CFG.siteId), { credentials: "include" })
  .then(function(r){ if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
  .then(function(resp){
    if (resp && resp.Success === false) throw new Error(resp.Message || "API error");
    var ms = (resp && resp.Modems) || [];
    modems = ms.filter(function(m){ return m && (m.ModemId || m.modemId); }).map(function(m){
      var tcp = !!fd(m.TcpStatus, m.tcpStatus, false), mqtt = !!fd(m.MqttStatus, m.mqttStatus, false);
      var onl = fd(m.IsOnline, m.isOnline); onl = (onl === null) ? (tcp || mqtt) : !!onl;
      return {
        clusterId: num(fd(m.ClusterId, m.clusterId), 0),
        clusterName: String(fd(m.ClusterName, m.clusterName, m.ModemName, m.modemName, "Modem")),
        modemId: String(fd(m.ModemId, m.modemId, "")),
        modemName: String(fd(m.ModemName, m.modemName, "")),
        version: String(fd(m.Version, m.version, "")),
        signal: fd(m.SignalStrength, m.signalStrength),
        tcp: tcp, mqtt: mqtt, online: onl,
        a10s: (fd(m.A10List, m.a10List) || []).map(function(a){
          var at = !!fd(a.TcpStatus, a.tcpStatus, false), am = !!fd(a.MqttStatus, a.mqttStatus, a.MQTTStatus, false);
          return { a10Id: fd(a.A10Id, a.a10Id, a.Id, a.id, "?"), type: String(fd(a.ADCTypeName, a.adcTypeName, "")), tcp: at, mqtt: am, online: at || am };
        })
      };
    });
    devLoading = false; devErr = null; renderTab();
  })
  .catch(function(e){ devLoading = false; devErr = e.message; renderTab(); });
}
function renderTab(){
  destroyChart(); sel = null; selType = null; lastData = null;
  var b = el("body");
  if (activeTab === "services") {
    b.innerHTML = '<div class="pending"><b>Service health history</b><br/>Debouncer, Datalogger, Point Machine, Alert and Data Receiver history APIs are not available yet.<br/>This tab will bind automatically once those endpoints are integrated.</div>';
    return;
  }
  if (activeTab === "sensors") { renderSensors(); return; }
  if (devLoading) { b.innerHTML = '<div class="empty">Loading device list&hellip;</div>'; return; }
  if (devErr) { b.innerHTML = '<div class="empty">Failed to load devices: ' + esc(devErr) + '</div>'; return; }
  if (!modems.length) { b.innerHTML = '<div class="empty">No devices found for this station.</div>'; return; }
  var h = "";
  if (activeTab === "network") {
    h += '<div class="sec-t">Select a modem to view its status history &amp; signal graph</div><div class="dev-grid">';
    modems.forEach(function(m, i){
      h += '<div class="dev-card" data-i="' + i + '"><div class="dc-top"><div class="dc-name">&#x1F4E1; ' + esc(m.clusterName) + '</div><div>' +
        '<span class="tag ' + (m.tcp?"on":"off") + '"><i></i>TCP</span> <span class="tag ' + (m.mqtt?"on":"off") + '"><i></i>MQTT</span></div></div>' +
        '<div class="dc-meta"><span>' + esc(m.modemName) + '</span><span>V' + esc(m.version || "?") + '</span>' +
        (m.signal !== null && m.signal !== undefined && m.signal !== "" ? '<span>' + esc(m.signal) + ' dBm</span>' : '') +
        '<span>' + m.a10s.length + ' A10</span></div></div>';
    });
    h += '</div>';
  } else {
    h += '<div class="sec-t">Select an A10 to view its status history &amp; graph</div>';
    modems.forEach(function(m, mi){
      if (!m.a10s.length) return;
      h += '<div class="agroup"><div class="ag-h">&#x1F4E1; ' + esc(m.clusterName) + ' <span style="color:var(--tx4);font-weight:400">(' + esc(m.modemName) + ')</span></div><div>';
      m.a10s.forEach(function(a, ai){
        h += '<span class="chip" data-mi="' + mi + '" data-ai="' + ai + '"><i class="' + (a.online?"on":"off") + '"></i>A10-' + esc(a.a10Id) + (a.type ? ' &middot; ' + esc(a.type) : '') + '</span>';
      });
      h += '</div></div>';
    });
  }
  h += '<div id="garea"></div>';
  b.innerHTML = h;
  if (activeTab === "network") {
    Array.prototype.forEach.call(b.querySelectorAll(".dev-card"), function(c){
      c.onclick = function(){
        Array.prototype.forEach.call(b.querySelectorAll(".dev-card"), function(x){ x.classList.remove("sel"); });
        c.classList.add("sel");
        sel = modems[parseInt(c.getAttribute("data-i"), 10)]; selType = "modem";
        buildGraphArea("Modem - " + sel.clusterName); loadGraph();
      };
    });
  } else {
    Array.prototype.forEach.call(b.querySelectorAll(".chip"), function(c){
      c.onclick = function(){
        Array.prototype.forEach.call(b.querySelectorAll(".chip"), function(x){ x.classList.remove("sel"); });
        c.classList.add("sel");
        var m = modems[parseInt(c.getAttribute("data-mi"), 10)];
        var a = m.a10s[parseInt(c.getAttribute("data-ai"), 10)];
        sel = { clusterId: m.clusterId, modemId: m.modemId, a10Id: a.a10Id }; selType = "a10";
        buildGraphArea("A10-" + a.a10Id + " - " + m.clusterName); loadGraph(); loadRecords();
      };
    });
  }
}
function buildGraphArea(title){
  el("garea").innerHTML = '<div class="gbox"><div class="gbar"><div class="gtitle">' + esc(title) + '</div>' +
    '<label class="gchk"><input type="checkbox" id="cT" checked/> TCP</label>' +
    '<label class="gchk"><input type="checkbox" id="cM" checked/> MQTT</label>' +
    '<button class="gbtn" id="bL">Load Graph</button></div>' +
    '<div class="gstats" id="gstats"></div>' +
    '<div class="note" id="gload">Loading history&hellip;</div>' +
    '<div class="note" id="gempty">&#x1F4ED; No history found for this date range.</div>' +
    '<div class="cwrap"><canvas id="cv" style="display:none"></canvas></div>' +
    '<div class="rows" id="recs"></div></div>';
  el("bL").onclick = function(){ loadGraph(); if (selType === "a10") loadRecords(); };
  el("cT").onchange = function(){ if (lastData) renderChart(lastData); };
  el("cM").onchange = function(){ if (lastData) renderChart(lastData); };
}
function dates(){ return { from: el("dFrom").value, to: el("dTo").value }; }
function loadGraph(){
  if (!sel) return;
  var d = dates();
  if (!d.from || !d.to) { alert("Please select a date range"); return; }
  var url = selType === "modem"
    ? CFG.modemGraphUrl + "?clusterId=" + sel.clusterId + "&fromDate=" + fmtApi(d.from) + "&toDate=" + fmtApi(d.to)
    : CFG.a10GraphUrl + "?clusterId=" + sel.clusterId + "&a10Id=" + sel.a10Id + "&fromDate=" + fmtApi(d.from) + "&toDate=" + fmtApi(d.to);
  el("gload").style.display = "flex"; el("gempty").style.display = "none"; el("cv").style.display = "none";
  el("gstats").innerHTML = ""; el("bL").disabled = true;
  fetch(url, { credentials: "include" })
  .then(function(r){ if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
  .then(function(data){
    el("gload").style.display = "none"; el("bL").disabled = false;
    var arr = Array.isArray(data) ? data : ((data && (data.Data || data.data)) || []);
    if (!arr.length || (data && data.Success === false)) { el("gempty").style.display = "flex"; lastData = null; return; }
    lastData = arr; el("cv").style.display = "block"; renderChart(arr);
  })
  .catch(function(){ el("gload").style.display = "none"; el("bL").disabled = false; el("gempty").style.display = "flex"; });
}
function fillGaps(arr, from, to, gapMin){
  if (!arr.length) return [];
  var gap = (gapMin || 5) * 60000;
  arr.sort(function(a,b){ return a.x - b.x; });
  var out = [], start = new Date(from + "T00:00:00").getTime(), end = Math.min(new Date(to + "T23:59:59").getTime(), Date.now());
  if (arr[0].x.getTime() > start + gap) { out.push({x:new Date(start),y:0,s:"off"}); out.push({x:new Date(arr[0].x.getTime()-1000),y:0,s:"off"}); }
  for (var i = 0; i < arr.length; i++) {
    if (i > 0 && arr[i].x.getTime() - arr[i-1].x.getTime() > gap) {
      out.push({x:new Date(arr[i-1].x.getTime()+1000),y:0,s:"off"});
      out.push({x:new Date(arr[i].x.getTime()-1000),y:0,s:"off"});
    }
    out.push({x:arr[i].x,y:arr[i].y,s:"on"});
  }
  var last = arr[arr.length-1];
  if (last.x.getTime() < end - gap) { out.push({x:new Date(last.x.getTime()+1000),y:0,s:"off"}); out.push({x:new Date(end),y:0,s:"off"}); }
  return out;
}
function stats(filled, from, to){
  if (!filled.length) return {pct:0,avg:0};
  var on = filled.filter(function(p){ return p.s === "on"; });
  var avg = on.length ? Math.round(on.reduce(function(s,p){ return s+p.y; },0)/on.length) : 0;
  var t = 0, st = null;
  filled.forEach(function(p){
    if (p.s === "on" && st === null) st = p.x.getTime();
    else if (p.s === "off" && st !== null) { t += p.x.getTime() - st; st = null; }
  });
  if (st !== null) t += filled[filled.length-1].x.getTime() - st;
  var total = Math.min(new Date(to + "T23:59:59").getTime(), Date.now()) - new Date(from + "T00:00:00").getTime();
  return { pct: Math.min(total > 0 ? Math.round(t/total*100) : 0, 100), avg: avg };
}
function renderChart(data){
  var d = dates(), showT = el("cT").checked, showM = el("cM").checked, isModem = selType === "modem";
  var tcp = [], mqtt = [];
  data.forEach(function(it){
    var ts = parseTs(fd(it.TimeStamp, it.Timestamp, it.timeStamp, it.timestamp, it.CreatedOn, it.DateTime));
    var tid = num(fd(it.TypeId, it.typeId), 0);
    if (ts === null) return;
    var v = isModem ? (parseInt(fd(it.SignalStrength, it.signalStrength, 0), 10) || 0)
      : (tid === 1 ? (parseInt(fd(it.ResponseTime, it.responseTime, 0), 10) || 0) : (parseInt(fd(it.Uptime, it.uptime, 0), 10) || 0));
    if (!v) return;
    var p = { x: new Date(ts), y: v };
    if (tid === 1) tcp.push(p); else if (tid === 2) mqtt.push(p);
  });
  var hasNeg = tcp.concat(mqtt).some(function(p){ return p.y < 0; });
  var tf = fillGaps(tcp, d.from, d.to, 5), mf = fillGaps(mqtt, d.from, d.to, 5);
  var tst = stats(tf, d.from, d.to), mst = stats(mf, d.from, d.to);
  var unit = isModem ? " dBm" : "";
  var sh = "";
  if (showT && tf.length) sh += '<div class="gstat"><span class="gdot tcp"></span>TCP &middot; avg ' + tst.avg + unit + ' &middot; <span class="pct ' + (tst.pct>=80?"good":tst.pct>=50?"warn":"poor") + '">' + tst.pct + '% online</span></div>';
  if (showM && mf.length) sh += '<div class="gstat"><span class="gdot mqtt"></span>MQTT &middot; avg ' + mst.avg + unit + ' &middot; <span class="pct ' + (mst.pct>=80?"good":mst.pct>=50?"warn":"poor") + '">' + mst.pct + '% online</span></div>';
  el("gstats").innerHTML = sh;
  var hasT = showT && tf.length > 0, hasM = showM && mf.length > 0;
  if (!hasT && !hasM) { el("cv").style.display = "none"; el("gempty").style.display = "flex"; return; }
  el("gempty").style.display = "none"; el("cv").style.display = "block";
  destroyChart();
  function seg(c){ return {
    borderColor: function(ctx){ return (ctx.p0.parsed.y === 0 || ctx.p1.parsed.y === 0) ? "#ef4444" : c; },
    backgroundColor: function(ctx){ return (ctx.p0.parsed.y === 0 || ctx.p1.parsed.y === 0) ? "rgba(239,68,68,0.1)" : "rgba(0,0,0,0)"; }
  }; }
  var ds = [];
  if (hasT) ds.push({ label:"TCP", data:tf.map(function(p){return {x:p.x,y:p.y};}), borderColor:"#60a5fa", backgroundColor:"rgba(96,165,250,0.1)", borderWidth:2, fill:true, tension:0, pointRadius:1, pointHoverRadius:5, segment:seg("#60a5fa") });
  if (hasM) ds.push({ label:"MQTT", data:mf.map(function(p){return {x:p.x,y:p.y};}), borderColor:"#34d399", backgroundColor:"rgba(52,211,153,0.1)", borderWidth:2, fill:true, tension:0, pointRadius:1, pointHoverRadius:5, segment:seg("#34d399") });
  chart = new Chart(el("cv").getContext("2d"), {
    type: "line", data: { datasets: ds },
    options: {
      responsive: true, maintainAspectRatio: false, interaction: { mode: "index", intersect: false },
      plugins: {
        legend: { display: true, labels: { color: "#9fb1d1", boxWidth: 12, font: { size: 10 } } },
        tooltip: { callbacks: {
          title: function(c){ return new Date(c[0].parsed.x).toLocaleString(); },
          label: function(c){ var v = c.parsed.y; return c.dataset.label + ": " + (v === 0 ? "OFFLINE" : v + (isModem ? " dBm" : "")); }
        } }
      },
      scales: {
        x: { type: "time", time: { displayFormats: { minute: "HH:mm", hour: "HH:mm", day: "dd MMM" } }, grid: { color: "rgba(255,255,255,0.07)" }, ticks: { color: "#9fb1d1", maxRotation: 45 } },
        y: { min: hasNeg ? undefined : 0, title: { display: true, text: (isModem ? "Signal (dBm)" : "TCP: response / MQTT: uptime"), color: "#9fb1d1" }, grid: { color: "rgba(255,255,255,0.07)" }, ticks: { color: "#9fb1d1", callback: function(v){ return v === 0 ? "Offline" : v; } } }
      }
    }
  });
}
function loadRecords(){
  if (!sel || selType !== "a10" || !CFG.a10RecordsUrl) return;
  var d = dates(), r = el("recs");
  r.innerHTML = '<div class="empty">Loading records&hellip;</div>';
  var url = CFG.a10RecordsUrl + "?clusterId=" + sel.clusterId + "&a10Id=" + sel.a10Id + "&ModemId=" + encodeURIComponent(sel.modemId || "") + "&fromDate=" + fmtApi(d.from) + "&toDate=" + fmtApi(d.to);
  fetch(url, { credentials: "include" })
  .then(function(x){ if (!x.ok) throw new Error("HTTP " + x.status); return x.json(); })
  .then(function(resp){
    if (resp && resp.Success === false) { r.innerHTML = '<div class="empty">' + esc(resp.Message || "No records") + '</div>'; return; }
