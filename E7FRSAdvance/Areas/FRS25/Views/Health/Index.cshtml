    }

    function evalAlert(d) {
        d = safeObj(d);
        if (!Object.keys(d).length) return unknownSvc("Alert");
        var nf = parseConnectionsFormat(d); if (nf) return nf;
        var ws = safeObj(d.websocket), ccs = safeObj(ws.causeCodeScan), dl = safeObj(ws.causeCodeScanDL), pr = safeObj(d.processing), api = safeObj(d.api), live = safeObj(api.liveApi), db = safeObj(api.database);
        var cOk = boolFrom(firstDefined(ccs.connected, true)), dlOk = boolFrom(firstDefined(dl.connected, true)), dbOk = boolFrom(firstDefined(db.connected, true)), apiOk = num(firstDefined(live.successRate, 100), 100) >= 95;
        var issues = [], conns = [{ l: "WS CCS", ok: cOk }, { l: "WS DL", ok: dlOk }, { l: "DB", ok: dbOk }, { l: "API", ok: apiOk }];
        if (!cOk) issues.push({ sev: "critical", msg: "WS CauseCode disconnected" });
        if (!dlOk) issues.push({ sev: "critical", msg: "WS DL disconnected" });
        if (!dbOk) issues.push({ sev: "critical", msg: "Database disconnected" });
        if (num(pr.processingErrors) > 0) issues.push({ sev: "warning", msg: num(pr.processingErrors) + " processing errors" });
        if (num(pr.avgProcessingMs) > 200) issues.push({ sev: "warning", msg: "Latency: " + num(pr.avgProcessingMs).toFixed(0) + "ms" });
        return { status: (!cOk || !dlOk || !dbOk) ? "critical" : issues.length ? "warning" : "healthy", conns: conns, issues: issues, metrics: { Processed_min: num(pr.messagesProcessedLastMinute), Avg_Latency: num(pr.avgProcessingMs).toFixed(1) + "ms", Errors: num(pr.processingErrors), API_OK: num(firstDefined(live.successRate, 100), 100) + "%", WS_CCS: num(ccs.totalMessages), WS_DL: num(dl.totalMessages), Uptime: fmtUp(d.uptimeSeconds) } };
    }

    function evalDebouncer(d) {
        d = safeObj(d);
        if (!Object.keys(d).length) return unknownSvc("Debouncer");
        var nf = parseConnectionsFormat(d); if (nf) return nf;
        var dl = safeObj(d.mqttDl), pm = safeObj(d.wsPmOp), blocked = safeObj(d.blocked);
        var wsOk = boolFrom(firstDefined(d.wsConnected, true)), mqttOk = boolFrom(firstDefined(d.mqttConnected, true)), dlOk = boolFrom(firstDefined(dl.connected, true)), pmOk = boolFrom(firstDefined(pm.connected, true));
        var issues = [], conns = [{ l: "WS Live", ok: wsOk }, { l: "MQTT", ok: mqttOk }, { l: "MQTT DL", ok: dlOk }, { l: "WS PM", ok: pmOk }];
        if (!wsOk) issues.push({ sev: "critical", msg: "WebSocket disconnected" + (d.wsLastReceived ? " (last: " + new Date(d.wsLastReceived).toLocaleTimeString() + ")" : "") });
        if (!mqttOk) issues.push({ sev: "critical", msg: "MQTT disconnected" });
        if (!dlOk) issues.push({ sev: "critical", msg: "MQTT DL disconnected" });
        if (!pmOk) issues.push({ sev: "critical", msg: "WS PM disconnected" });
        var er = num(d.apiCalls) > 0 ? (num(d.apiErrors) / num(d.apiCalls) * 100) : 0;
        if (er > 50) issues.push({ sev: "warning", msg: "API error: " + er.toFixed(0) + "%" });
        if (num(d.exceptions) > 5000) issues.push({ sev: "warning", msg: num(d.exceptions).toLocaleString() + " exceptions" });
        if (num(blocked.trm) > 20) issues.push({ sev: "warning", msg: num(blocked.trm) + " TRM blocked" });
        if (num(blocked.l3) > 20) issues.push({ sev: "warning", msg: num(blocked.l3) + " L3 blocked" });
        if (num(pm.cacheStaleSkipped) > 5000) issues.push({ sev: "info", msg: num(pm.cacheStaleSkipped).toLocaleString() + " PM cache stale skipped" });
        var allC = wsOk && mqttOk && dlOk && pmOk;
        var metrics = {
            WS_Received: num(d.wsReceived).toLocaleString(),
            CCS_Scan: num(d.causeCodeScan).toLocaleString(),
            CCS_DL: num(d.causeCodeScanDL).toLocaleString(),
            API_Calls: num(d.apiCalls).toLocaleString(),
            API_Errors: num(d.apiErrors),
