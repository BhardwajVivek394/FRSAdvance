                { k: "gcHeapMb", l: "GC Heap" }, { k: "cpuPct", l: "CPU %" },
                { k: "threadCount", l: "Threads" }, { k: "handleCount", l: "Handles" },
                { k: "threadPoolWorkerBusy", l: "TP Busy" }, { k: "threadPoolWorkerQueued", l: "TP Queued" }
            ];
            procFields.forEach(function (pf) {
                if (proc[pf.k] !== undefined) {
                    var unit = pf.k.indexOf("Mb") >= 0 ? " MB" : pf.k === "cpuPct" ? "%" : "";
                    html += '<div class="rt-item"><div class="rt-label">' + pf.l + '</div><div class="rt-val">' + num(proc[pf.k]) + unit + '</div></div>';
                }
            });
            html += '</div></div>';
        }
        if (Object.keys(caches).length > 0 && num(caches.totalEntries) > 0) {
            html += '<div class="m-sec"><div class="m-sec-t">Runtime \u2014 Caches (' + num(caches.totalEntries) + ' entries)</div><div class="runtime-grid">';
            Object.keys(caches).forEach(function (ck) {
                if (ck !== "totalEntries" && num(caches[ck]) > 0) html += '<div class="rt-item"><div class="rt-label">' + esc(ck) + '</div><div class="rt-val">' + num(caches[ck]) + '</div></div>';
            });
            html += '</div></div>';
        }
        return html;
    }

    // =====================================================================
    // COMPLETE PAYLOAD VIEWER - renders EVERY field of an MQTT health payload
    // (nested objects as grouped grids, arrays of objects as tables) plus a
    // collapsible raw-JSON view, so no information from the message is hidden.
    // =====================================================================
    function fmtAnyVal(v) {
        if (v === null || v === undefined || v === "") return "\u2014";
        if (typeof v === "boolean") return v ? "true" : "false";
        if (typeof v === "number") return (v % 1 === 0) ? v.toLocaleString() : String(v);
        return String(v);
    }
    function buildDataTree(value, depth) {
        depth = depth || 0;
        if (depth > 6) return '<div class="kv-empty">\u2026</div>';
        if (Array.isArray(value)) {
            if (!value.length) return '<div class="kv-empty">(empty list)</div>';
            if (isPlainObj(value[0])) {
                // Array of objects -> table over the union of primitive columns
                var cols = [];
                value.forEach(function (row) {
                    if (!isPlainObj(row)) return;
                    Object.keys(row).forEach(function (k) {
                        if (cols.indexOf(k) < 0 && !isPlainObj(row[k]) && !Array.isArray(row[k])) cols.push(k);
                    });
                });
                cols = cols.slice(0, 12);
                var h = '<div class="conn-table-wrap"><table class="conn-tbl"><thead><tr>' +
                    cols.map(function (c) { return '<th>' + esc(c) + '</th>'; }).join("") + '</tr></thead><tbody>';
                value.forEach(function (row) {
                    h += '<tr>' + cols.map(function (c) { return '<td>' + esc(fmtAnyVal(safeObj(row)[c])) + '</td>'; }).join("") + '</tr>';
                });
                h += '</tbody></table></div>';
                // Nested structures inside rows (rare) rendered underneath
                value.forEach(function (row, i) {
                    if (!isPlainObj(row)) return;
                    Object.keys(row).forEach(function (k) {
                        if (isPlainObj(row[k]) || Array.isArray(row[k])) {
                            h += '<div class="kv-group"><div class="kv-group-t">[' + i + '] ' + esc(k) + '</div>' + buildDataTree(row[k], depth + 1) + '</div>';
                        }
                    });
                });
                return h;
            }
            return '<div class="m-metrics">' + value.map(function (v, i) {
                return '<div class="m-met"><div class="ml">#' + i + '</div><div class="mv kv-v">' + esc(fmtAnyVal(v)) + '</div></div>';
            }).join("") + '</div>';
        }
        if (isPlainObj(value)) {
            var prims = [], nested = [];
            Object.keys(value).forEach(function (k) {
                if (isPlainObj(value[k]) || Array.isArray(value[k])) nested.push(k); else prims.push(k);
            });
            var out = "";
            if (prims.length) {
                out += '<div class="m-metrics">' + prims.map(function (k) {
                    return '<div class="m-met"><div class="ml">' + esc(k) + '</div><div class="mv kv-v">' + esc(fmtAnyVal(value[k])) + '</div></div>';
                }).join("") + '</div>';
            }
            nested.forEach(function (k) {
                out += '<div class="kv-group"><div class="kv-group-t">' + esc(k) + '</div>' + buildDataTree(value[k], depth + 1) + '</div>';
            });
            return out || '<div class="kv-empty">(empty)</div>';
        }
        return '<div class="m-metrics"><div class="m-met"><div class="mv kv-v">' + esc(fmtAnyVal(value)) + '</div></div></div>';
    }
    function buildFullDataSection(title, payload) {
        if (!payload || typeof payload !== "object" || !Object.keys(payload).length) return "";
        var jsonText = "";
        try { jsonText = JSON.stringify(payload, null, 2); } catch (e) { jsonText = "(unserializable)"; }
        return '<details class="m-details" data-sec="' + esc(title) + '" open>' +
            '<summary>\uD83D\uDCC4 ' + esc(title) + ' \u2014 all fields</summary>' +
            '<div class="m-details-body">' + buildDataTree(payload, 0) +
            '<details class="m-details" data-sec="' + esc(title) + '-json"><summary>Raw JSON</summary><pre class="raw-json">' + esc(jsonText) + '</pre></details>' +
            '</div></details>';
    }

    function openSvc(sid, idx, serviceType) {
        var e = window._healthEv.find(function (d) { return String(d.st.siteId) === String(sid); }); if (!e) return;
        currentModal = { kind: "svc", sid: String(sid), idx: idx, serviceType: serviceType || null };
        var svc = e.svcs[idx];

        var m = document.getElementById("mo"), o = document.getElementById("ov");

        // Each Local / Cloud sub-cell opens ONLY its own node's data. No toggle is shown
        // so Local and Cloud stay strictly separated (per requirement). The node is shown
        // in the modal header instead.
        function typeToggleHtml() {
            return "";
        }

        // "Last data received" banner: full timestamp; if the station has gone
        // silent we keep showing the last data and say so explicitly.
        function lastReceivedBanner(tsIso) {
            var full = fmtFullTs(tsIso);
            if (!full) return '<div class="m-sec" style="margin-bottom:12px"><div class="m-conn"><span class="cd off"></span><span style="color:var(--tx3)">No data received yet</span></div></div>';
            var stale = isStationStale(e.st);
            var h = '<div class="m-sec" style="margin-bottom:12px"><div class="m-conn">';
            h += '<span class="cd ' + (stale ? "off" : "on") + '"></span>';
            h += '<span><b>Last data received:</b> ' + esc(full) + ' <span style="color:var(--tx3)">(' + esc(fmtAgo(tsIso) || "") + ')</span></span>';
            h += '</div>';
            if (stale) h += '<div style="font-size:11px;color:var(--amb);padding:4px 2px 0">\u26A0 No new data is coming \u2014 showing the last received data below.</div>';
            h += '</div>';
            return h;
        }

        // ===== "NO DATA FOUND" PATH =====
        // User clicked Local or Cloud but no payload of that node type ever
        // arrived for this service -> do NOT silently fall back to combined
        // data; tell the user clearly that nothing was found.
        if (serviceType === "local" || serviceType === "cloud") {
            var hasTypedData = serviceType === "local" ? !!(svc.localEval || svc.localData) : !!(svc.cloudEval || svc.cloudData);
            if (!hasTypedData) {
                var ndLabel = serviceType === "local" ? "\uD83D\uDCBB Local" : "\u2601 Cloud (Server)";
                var ndTs = serviceType === "local" ? svc.localLastAt : svc.cloudLastAt;
                var otherType = serviceType === "local" ? "cloud" : "local";
                var otherHas = otherType === "local" ? !!(svc.localEval || svc.localData) : !!(svc.cloudEval || svc.cloudData);
                var ndHtml = '<div class="modal-hdr"><h3>' + svc.icon + ' ' + esc(svc.label) + ' \u2014 ' + ndLabel + ' \u2014 ' + esc(e.st.stationName) + ' <span class="sbadge a">no data</span></h3>';
                ndHtml += '' + modalFsBtn() + '<button class="modal-close" onclick="HealthDash.closeModal()">&#215;</button></div>';
                ndHtml += '<div class="modal-body">';
                ndHtml += typeToggleHtml();
                ndHtml += '<div style="text-align:center;padding:36px 16px;color:var(--tx3)">' +
                    '<div style="font-size:30px;margin-bottom:10px">\uD83D\uDCED</div>' +
                    '<div style="font-size:14px;font-weight:700;color:var(--tx2);margin-bottom:6px">No data found</div>' +
                    '<div style="font-size:12px;line-height:1.6">No ' + ndLabel + ' health data has been received for <b>' + esc(svc.label) + '</b> on this station.' +
                    (ndTs ? '<br/>Last ' + ndLabel + ' data was received: <b>' + esc(fmtFullTs(ndTs)) + '</b> (' + esc(fmtAgo(ndTs) || '') + ')' : '') +
                    (otherHas ? '<br/>Data is available on the <b>' + (otherType === "local" ? "\uD83D\uDCBB Local" : "\u2601 Cloud") + '</b> node \u2014 open that sub-cell to view it.' : '') +
                    '</div></div>';
                ndHtml += '</div>';
                m.innerHTML = ndHtml;
                m.classList.add("open"); o.classList.add("open");
                return;
            }
        }

        // If serviceType is specified and the service has typed data, show that specific data
        var targetEval = svc;
        var targetLabel = svc.label;
        var targetLastAt = svc.lastReceivedAt;
        if (serviceType === "local" && svc.localEval) {
            targetEval = Object.assign({}, svc.localEval, { key: svc.key, label: svc.label, icon: svc.icon });
            targetLabel = svc.label + " \u2014 \uD83D\uDCBB Local";
            targetLastAt = svc.localLastAt || svc.lastReceivedAt;
        } else if (serviceType === "cloud" && svc.cloudEval) {
            targetEval = Object.assign({}, svc.cloudEval, { key: svc.key, label: svc.label, icon: svc.icon });
            targetLabel = svc.label + " \u2014 \u2601 Cloud (Server)";
            targetLastAt = svc.cloudLastAt || svc.lastReceivedAt;
        }

        var sc = targetEval.status === "healthy" ? "g" : targetEval.status === "warning" || targetEval.status === "unknown" ? "a" : "r";

        // Find the raw payload for detailed view
        var rawKey = null;
        if (svc.key === "DataRecv") rawKey = "dataReceiverHealth";
        else if (svc.key === "Datalogger") rawKey = "dataloggerHeartbeat";
        else if (svc.key === "Alert") rawKey = "alertHealth";
        else if (svc.key === "Debouncer") rawKey = "debouncerHealth";
        else if (svc.key === "Point") rawKey = "pointHealth";

        var rawPayload = null;
        if (serviceType && rawKey) {
            var types = (e.st._serviceTypes || {})[rawKey];
            rawPayload = types ? (types[serviceType] || null) : null;
        }
        // When a node (Local/Cloud) was clicked, stay strictly on that node - do NOT
        // fall back to the combined payload. Only the combined view may use it.
        if (!rawPayload && !serviceType) rawPayload = (e.st._rawPayloads || {})[rawKey] || null;

        var html = '<div class="modal-hdr"><h3>' + svc.icon + ' ' + esc(targetLabel) + ' \u2014 ' + esc(e.st.stationName) + ' <span class="sbadge ' + sc + '">' + esc(targetEval.status) + '</span></h3>';
        html += '' + modalFsBtn() + '<button class="modal-close" onclick="HealthDash.closeModal()">&#215;</button></div>';
        html += '<div class="modal-body">';

        // If service has both types, show a tab-like toggle at top of modal
        html += typeToggleHtml();

        // Last data received (full timestamp) - always shown
        html += lastReceivedBanner(targetLastAt);

        // Connections summary
        html += '<div class="m-sec"><div class="m-sec-t">Connections</div><div class="m-conns">';
        if (targetEval.conns.length) {
            targetEval.conns.forEach(function (c) {
                html += '<div class="m-conn"><span class="cd ' + (c.ok ? "on" : "off") + '"></span><span>' + esc(c.l) + '</span>';
                if (c.transport) html += '<span class="conn-detail">' + esc(c.transport) + '</span>';
                html += '</div>';
            });
        } else {
            html += '<div class="m-conn"><span>No packet received</span></div>';
        }
        html += '</div></div>';

        // Metrics
        html += '<div class="m-sec"><div class="m-sec-t">Metrics</div><div class="m-metrics">';
        Object.keys(targetEval.metrics || {}).forEach(function (k) { html += '<div class="m-met"><div class="ml">' + esc(k).replace(/_/g, " ") + '</div><div class="mv">' + esc(targetEval.metrics[k]) + '</div></div>'; });
        html += '</div></div>';

        // Detailed connection table + exceptions + runtime (if new format payload exists)
        if (rawPayload) html += buildConnectionDetailHtml(rawPayload);

        // Issues
        if (targetEval.issues.length) {
            html += '<div class="m-sec"><div class="m-sec-t">Issues (' + targetEval.issues.length + ')</div><div class="m-issues">';
            targetEval.issues.forEach(function (i) { html += '<div class="m-issue sev-' + esc(i.sev) + '">' + esc(i.msg) + '</div>'; });
            html += '</div></div>';
        } else {
            html += '<div style="text-align:center;color:var(--tx3);padding:20px">\u2705 No issues</div>';
        }
        // ===== COMPLETE PAYLOAD - every field from the MQTT message(s) =====
        if (serviceType) {
            // Node-scoped: show ONLY this node's payload (never combined / cross-node).
            html += buildFullDataSection((serviceType === "local" ? "\uD83D\uDCBB Local" : "\u2601 Cloud (Server)") + " payload", rawPayload);
        } else if (svc.key === "Datalogger") {
            html += buildFullDataSection("Heartbeat payload", firstDefined((e.st._rawPayloads || {}).dataloggerHeartbeat, safeObj(e.st.services).dataloggerHeartbeat, null));
            html += buildFullDataSection("Diagnostic payload", firstDefined((e.st._rawPayloads || {}).dataloggerDiagnostic, safeObj(e.st.services).dataloggerDiagnostic, null));
        } else {
            html += buildFullDataSection("Complete payload", rawPayload || getSvcData(e.st.services, svc.key));
        }

        html += '</div>';
        m.innerHTML = html;
        m.classList.add("open"); o.classList.add("open");
    }

    function openHW(sid, type) {
        var stn = stations.find(function (s) { return String(s.siteId) === String(sid); }); if (!stn) return;
        currentModal = { kind: "hw", sid: String(sid), type: type };
        var hw = safeObj(stn.hardware[type]); var info = HW_ORDER.find(function (h) { return h.key === type; });
        var m = document.getElementById("mo"), o = document.getElementById("ov");
        var html = '<div class="modal-hdr"><h3>' + esc(info.label) + ' \u2014 ' + esc(stn.stationName) + '</h3>' + modalFsBtn() + '<button class="modal-close" onclick="HealthDash.closeModal()">&#215;</button></div>';
        html += '<div class="modal-body">';
        // Last MQTT data received for this station (full timestamp)
        (function () {
            var full = fmtFullTs(stn._updatedAt);
            var stale = isStationStale(stn);
            if (full) {
                html += '<div class="m-sec" style="margin-bottom:12px"><div class="m-conn"><span class="cd ' + (stale ? "off" : "on") + '"></span><span><b>Last data received:</b> ' + esc(full) + ' <span style="color:var(--tx3)">(' + esc(fmtAgo(stn._updatedAt) || "") + ')</span></span></div>' +
                    (stale ? '<div style="font-size:11px;color:var(--amb);padding:4px 2px 0">\u26A0 No new data is coming \u2014 showing the last received data below.</div>' : '') +
                    '</div>';
            } else {
                html += '<div class="m-sec" style="margin-bottom:12px"><div class="m-conn"><span class="cd off"></span><span style="color:var(--tx3)">No data received yet</span></div></div>';
            }
        })();
        var nwTwoPane = (type === "network" || type === "iot");
        m.classList.toggle("nw-wide", nwTwoPane);
        if (nwTwoPane) html += '<div class="nw-modal-layout"><div class="nw-modal-left">';

        if (nwTwoPane) {
            // N/W-db style station summary bar - identity left, stats spread across the center
            html += nwStationBar(stn, type, hw);
        } else {
            // Summary cards
            html += '<div class="m-sec"><div class="m-sec-t">Summary</div><div class="m-metrics">';
            html += '<div class="m-met"><div class="ml">Total</div><div class="mv">' + num(hw.total) + '</div></div>';
            html += '<div class="m-met"><div class="ml">Unhealthy</div><div class="mv bad">' + num(hw.unhealthy) + '</div></div>';
            html += '<div class="m-met"><div class="ml">Healthy</div><div class="mv" style="color:var(--grn)">' + (num(hw.total) - num(hw.unhealthy)) + '</div></div>';
            html += '</div></div>';
        }

        // Live modem / A10 connectivity (Network-Dashboard style) for IoT & Network
        // Auto-load device status (like N/W db) so device lists & sidebar clicks work immediately
        if (type === "network" || type === "iot") {
            var dscAuto = deviceStatusCache[parseInt(stn.siteId, 10) || 0] || {};
            if (!dscAuto.modems && !dscAuto.loading) loadSiteDevices(num(stn.siteId), type);
        }
        html += buildConnectivitySection(stn, type);

        // ===== SENSOR DETAIL with per-attribute alerts =====
        if (type === "sensors") {
            var summary = sensorHealthSummary[String(stn.siteId)];
            if (summary && summary.details.length > 0) {
                // Count breakdowns
                html += '<div class="m-sec"><div class="m-sec-t">Sensor Health Breakdown</div>';
                html += '<div class="m-metrics" style="margin-bottom:12px">';
                html += '<div class="m-met"><div class="ml">Unhealthy (Dead)</div><div class="mv bad">' + summary.unhealthy + '</div></div>';
                html += '<div class="m-met"><div class="ml">Warning</div><div class="mv warn">' + summary.warning + '</div></div>';
                html += '<div class="m-met"><div class="ml">Healthy</div><div class="mv" style="color:var(--grn)">' + summary.healthy + '</div></div>';
                html += '</div>';

                // Group details by asset
                var byAsset = {};
                summary.details.forEach(function (d) {
                    var ak = d.assetId;
                    if (!byAsset[ak]) byAsset[ak] = { assetName: d.assetName, assetId: d.assetId, sensors: [] };
                    byAsset[ak].sensors.push(d);
                });

                Object.keys(byAsset).forEach(function (ak) {
                    var asset = byAsset[ak];
                    html += '<div class="sensor-asset-group">';
                    html += '<div class="sensor-asset-hdr">' +
                        '<span class="sensor-asset-name">' + esc(asset.assetName) + '</span>' +
                        '<span class="sensor-asset-id">Asset ID: ' + esc(asset.assetId) + '</span>' +
                        '<span class="sensor-asset-badge">' + asset.sensors.length + ' alert' + (asset.sensors.length > 1 ? 's' : '') + '</span>' +
                    '</div>';

                    asset.sensors.forEach(function (sensor) {
                        var sCls = sensor.status === "unhealthy" ? "red" : "amb";
                        var sLabel = sensor.status === "unhealthy" ? "DEAD" : "WARNING";
                        html += '<div class="sensor-item">';
                        html += '<div class="sensor-item-hdr">' +
                            '<span class="sensor-dot ' + sCls + '"></span>' +
                            '<span class="sensor-name">' + esc(sensor.attrAlias || sensor.attrTitle) + '</span>' +
                            '<span class="sensor-attr-id">Attr ID: ' + esc(sensor.attrId) + '</span>' +
                            '<span class="sensor-status-badge ' + sCls + '">' + sLabel + '</span>' +
                        '</div>';

                        // Show each alert for this sensor
                        sensor.alerts.forEach(function (alert) {
                            var parsed = parseAlertIdentifier(alert.alertIdentifier);
                            html += '<div class="sensor-alert-row" onclick="HealthDash.openAlertDetail(' + num(alert.alertId) + ')">';
                            html += '<div class="sensor-alert-desc">' + esc(alert.alertDescription || "") + '</div>';
                            html += '<div class="sensor-alert-meta">';
                            if (alert.priority) html += '<span class="sa-tag ' + (alert.priority === "Critical" ? "red" : "amb") + '">' + esc(alert.priority) + '</span>';
                            if (alert.category) html += '<span class="sa-tag">' + esc(alert.category) + '</span>';
                            if (alert.limitString) html += '<span class="sa-limit">' + esc(alert.limitString) + '</span>';
                            if (alert.timestampSet) html += '<span class="sa-time">' + new Date(alert.timestampSet).toLocaleString() + '</span>';
                            html += '</div></div>';
                        });
                        html += '</div>';
                    });
                    html += '</div>';
                });
                html += '</div>';
            } else if (sensorDataCache[String(stn.siteId)]) {
                html += '<div style="text-align:center;color:var(--grn);padding:16px;font-size:12px">\u2705 All ' + num(hw.total) + ' sensors healthy \u2014 no alerts</div>';
            } else if (sensorDataLoading[String(stn.siteId)]) {
                html += '<div style="text-align:center;color:var(--tx3);padding:16px;font-size:12px">\u23F3 Loading sensor data\u2026</div>';
            } else {
                html += '<div style="text-align:center;color:var(--tx3);padding:16px;font-size:12px">Sensor data not yet loaded for this site. <button class="paste-btn" onclick="HealthDash.loadSiteSensors(' + num(stn.siteId) + ')">Load Now</button></div>';
            }
        }

        // ===== IoT (ADC/A10) DETAIL =====
        if (type === "iot") {
            var cl = cardLineCache[String(stn.siteId)];
            if (cl && cl.adcIds.length > 0) {
                var sAlerts = sensorAlertMap[String(stn.siteId)] || {};
                html += '<div class="m-sec"><div class="m-sec-t">A10 / ADC Device Breakdown (' + cl.adcIds.length + ' devices)</div>';

                cl.adcIds.forEach(function (adcId) {
                    var adcInfo = cl.adcMap[adcId] || {};
                    var adcAttrs = adcInfo.attrs || [];

                    // Collect alerts for this ADC's attributes
                    var adcAlertList = [];
                    adcAttrs.forEach(function (attr) {
                        Object.keys(sAlerts).forEach(function (sensorKey) {
                            if (sensorKey.split("_")[1] === String(attr.attrId) || sensorKey === String(attr.attrId)) {
                                adcAlertList = adcAlertList.concat(sAlerts[sensorKey]);
                            }
                        });
                    });

                    var hasDead = adcAlertList.some(function (a) { return String(a.alertIdentifier || "").toLowerCase().indexOf("dead") >= 0; });
                    var adcCls = adcAlertList.length > 0 ? (hasDead ? "red" : "amb") : "grn";

                    html += '<div class="sensor-asset-group">';
                    html += '<div class="sensor-asset-hdr">';
                    html += '<span class="sensor-dot ' + adcCls + '" style="margin-right:4px"></span>';
                    html += '<span class="sensor-asset-name">A10 #' + esc(adcInfo.adcNumber || adcId) + '</span>';
                    html += '<span class="sensor-asset-id">ADC ID: ' + esc(adcId) + ' &middot; ' + esc(adcInfo.locationName || "") + ' &middot; Cluster: ' + esc(adcInfo.clusterName || "") + '</span>';
                    if (adcAlertList.length > 0) html += '<span class="sensor-asset-badge">' + adcAlertList.length + ' alert' + (adcAlertList.length > 1 ? "s" : "") + '</span>';
                    html += '</div>';

                    // Show mapped sensors
                    if (adcAttrs.length > 0) {
                        html += '<div style="padding:6px 14px;font-size:10px;color:var(--tx3)">' + adcAttrs.length + ' sensor(s): ';
                        html += adcAttrs.map(function (a) { return esc(a.assetName) + '/' + esc(a.attrName); }).join(', ');
                        html += '</div>';
                    }

                    if (adcAlertList.length > 0) {
                        adcAlertList.forEach(function (alert) {
                            html += '<div class="sensor-alert-row" onclick="HealthDash.openAlertDetail(' + num(alert.alertId) + ')">';
                            html += '<div class="sensor-alert-desc">' + esc(alert.alertDescription || "") + '</div>';
                            html += '<div class="sensor-alert-meta">';
                            if (alert.priority) html += '<span class="sa-tag ' + (alert.priority === "Critical" ? "red" : "amb") + '">' + esc(alert.priority) + '</span>';
                            if (alert.category) html += '<span class="sa-tag">' + esc(alert.category) + '</span>';
                            if (alert.limitString) html += '<span class="sa-limit">' + esc(alert.limitString) + '</span>';
                            if (alert.timestampSet) html += '<span class="sa-time">' + new Date(alert.timestampSet).toLocaleString() + '</span>';
                            html += '</div></div>';
                        });
                    } else {
                        html += '<div style="padding:8px 14px;font-size:11px;color:var(--grn)">\u2705 Healthy</div>';
                    }
                    html += '</div>';
                });
                html += '</div>';
            } else if (!cl) {
