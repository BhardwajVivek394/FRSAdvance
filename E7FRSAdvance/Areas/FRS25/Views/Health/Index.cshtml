        var rt = safeObj(d.runtime);
        var rp = rt.process ? safeObj(rt.process) : rt;
        if (rp.cpuPct !== undefined && rp.cpuPct !== null) metrics.CPU = rp.cpuPct + "%";
        if (rp.workingSetMb) metrics.RAM = rp.workingSetMb + "MB";
        if (rp.threadCount) metrics.Threads = rp.threadCount;

        return { status: status, conns: conns, issues: issues, metrics: metrics };
    }

    function evalDataReceiver(d) {
        d = safeObj(d);
