<script>
(function () {
    "use strict";

    var CONFIG = { API_URL: null, POLL_INTERVAL_MS: 15000 };
    // Protocol-aware WebSocket config (same scheme as telemetrylive.js):
    // https page -> wss + SSL base + auth token; http page -> ws + plain base.
    var isSecure = window.location.protocol === "https:";
    var APP_CONFIG;
    if (isSecure) {
        APP_CONFIG = {
            WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrlSSL"]',
            WebSocketAuthToken: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketAuthToken"]'
        };
    } else {
        APP_CONFIG = {
            WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrl"]',
            WebSocketAuthToken: null
        };
    }
    var WS_BASE = APP_CONFIG.WebSocketBaseUrl && APP_CONFIG.WebSocketBaseUrl.indexOf("@@") === -1
        ? APP_CONFIG.WebSocketBaseUrl.replace(/\/+$/, "")
        : ((isSecure ? "wss" : "ws") + "://proxy.energy7.org:8081");
    var DEBOUNCER_WS_URL = WS_BASE + "/subscribe/debouncerHealth";
    // AlertLive real-time feed. Site-scoped when a single site is selected, else "all".
    //   ws://proxy.energy7.org:8081/subscribe/AlertLive/all
    //   ws://proxy.energy7.org:8081/subscribe/AlertLive/{siteId}
    var ALERT_LIVE_WS_PATH = "/subscribe/AlertLive/";
    function alertLiveWsUrl() {
        var sid = selectedHealthSiteId();
        return WS_BASE + ALERT_LIVE_WS_PATH + (sid > 0 ? sid : "all");
    }

    // Make a WebSocket URL connect-ready exactly the way telemetrylive.js does.
    // On an HTTPS page:
    //   1. force ws:// -> wss:// so the browser does not block it as mixed
    //      content (guards against a base/config left as ws://), and
    //   2. append ?token=<WebSocketAuthToken>, which the server requires for the
    //      WSS upgrade handshake (without it the connection is rejected).
    // On plain HTTP it is returned unchanged.
    function buildSecureWsUrl(rawUrl) {
        var url = String(rawUrl || "");
        if (isSecure && url.indexOf("ws://") === 0) {
            url = "wss://" + url.slice(5);
        }
        if (isSecure && APP_CONFIG && APP_CONFIG.WebSocketAuthToken &&
            APP_CONFIG.WebSocketAuthToken.indexOf("@@") === -1) {
            url += (url.indexOf("?") > -1 ? "&" : "?") + "token=" + encodeURIComponent(APP_CONFIG.WebSocketAuthToken);
        }
        return url;
    }
    var WS_MAX_RECONNECT_ATTEMPTS = 15, WS_RECONNECT_DELAY = 3000;

    // If a site sends no MQTT data within this window, force all its services unhealthy.
    var STALE_THRESHOLD_MS = 90 * 1000;

    var SVC_ORDER = [
        { key: "DataRecv", label: "Data Receiver", icon: "\uD83D\uDCE5" },
        { key: "Datalogger", label: "Datalogger", icon: "\uD83D\uDCE1" },
        { key: "Alert", label: "Alert", icon: "\u26A1" },
        { key: "Debouncer", label: "Debouncer", icon: "\uD83D\uDD00" },
        { key: "Point", label: "Point Machine", icon: "\uD83D\uDD27" }
    ];

    var HW_ORDER = [
        { key: "sensors", label: "Sensors", icon: '<svg viewBox="0 0 24 24"><path d="M12 2a4 4 0 014 4v4a4 4 0 01-8 0V6a4 4 0 014-4z"/><path d="M6 10v1a6 6 0 0012 0v-1"/><path d="M12 17v5"/><path d="M8 22h8"/></svg>' },
        { key: "iot", label: "IoT", icon: '<svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h.01M15 9h.01M9 15h.01M15 15h.01"/><path d="M12 9v6M9 12h6"/></svg>' },
        { key: "network", label: "Network", icon: '<svg viewBox="0 0 24 24"><rect x="9" y="2" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="16" y="16" width="6" height="6" rx="1"/><path d="M12 8v4M5 16v-2a2 2 0 012-2h10a2 2 0 012 2v2"/></svg>' }
    ];

    var mQTTSource = @Html.Raw(mqttJson);
    var mQTT = Array.isArray(mQTTSource) ? (mQTTSource[0] || {}) : (mQTTSource || {});

    var DIVISION_URL = '@Url.Action("GetDivisionByZoneId", "Health", new { area = "FRS25" })';
    var SITE_URL = '@Url.Action("GetSiteByDivisionId", "Health", new { area = "FRS25" })';
    var HEALTH_TOPICS_URL = '@Url.Action("GetHealthMqttTopics", "Health", new { area = "FRS25" })';
    var ALERT_LIVE_URL = '@Url.Action("GetAlertLive", "Health", new { area = "FRS25" })';
    var ALERT_HISTORY_URL = '@Url.Action("GetAlertHistory", "Health", new { area = "FRS25" })';
    var SITE_ASSETS_URL = '@Url.Action("GetSiteAssets", "Health", new { area = "FRS25" })';
    var CARDLINE_URL = '@Url.Action("GetSiteCardLines", "Health", new { area = "FRS25" })';
    // Device status + history graph endpoints (added to the Health controller;
    // binding mirrors the Network Dashboard's modem & A10 data flow).
    var DEVICE_STATUS_URL = '@Url.Action("GetSiteDeviceStatus", "Health", new { area = "FRS25" })';
    var MODEM_GRAPH_URL = '@Url.Action("GetModemHistoryForGraph", "Health", new { area = "FRS25" })';
    var A10_GRAPH_URL = '@Url.Action("GetA10HistoryForGraph", "Health", new { area = "FRS25" })';
    var A10_RECORDS_URL = '@Url.Action("GetA10HistoryRecords", "Health", new { area = "FRS25" })';
    var HISTORY_PAGE_URL = '@Url.Action("History", "Health", new { area = "FRS25" })';
    // NW-parity device detail: cross-controller endpoints (same web app, root area)
    var NW_ASSET_TYPES_URL = '@Url.Action("GetAssetTypeBySiteId", "Health", new { area = "" })';
    var NW_YARD_CONFIG_URL = '@Url.Action("GetYardConfigByAssetTypeJson", "Health", new { area = "" })';
    var MODEM_TCP_CMD_URL = '/Health/SendTcpCommand';
    var NW_IS_ADMIN = @((E7FRSAdvance.Utility.ClsHttpContent.LoginUser != null && E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode()) ? "true" : "false");

    var masterZones = normalizeSelectItems(@Html.Raw(zonesJson));
    var masterDivisions = normalizeSelectItems(@Html.Raw(divisionsJson));
    var masterSites = normalizeSelectItems(@Html.Raw(sitesJson));

    var divisionOptions = masterDivisions.slice();
    var siteOptions = masterSites.slice();

    var stations = [];
    var lastRefresh = Date.now();
    // Multi-select filter state: empty array = "All"
    var filterZoneIds = [], filterDivisionIds = [], filterSiteIds = [], filterSearch = "";
    var divisionsByZone = {}, sitesByDivision = {};   // cascade lookup caches (server fetched, memoised)
    var deviceStatusCache = {};                        // { siteId: { loading, error, ts, modems[] } }
    var currentModal = null;                           // { kind: "svc"|"hw"|"wrench", sid, idx?, type? } - live-refreshed on render
    var _filterFocusEl = null, _filterSelStart = null, _filterSelEnd = null; // search-box focus preservation
    var mqttClient = null, mqttConnected = false, mqttSubscribed = false;
    var mqttTopic = "";
    var mqttTopics = [];
    var currentSubscribedTopics = [];
    var healthTopicMeta = {};

    // ===== Debouncer WebSocket =====
    var debouncerWs = null, debouncerWsConnected = false, debouncerWsReconnectTimer = null;

    // ===== AlertLive API =====
    var ALERT_LIVE_POLL_MS = 30000;
    var SERVICE_HEALTH_IDS = ["DataReceiverHealth", "DebouncerHealth", "PointMachineHealth", "AlertHealth", "DataloggerHealth"];

    // Rule-based service classification. AlertLive alerts are attributed to one of the
    // five health services by the "rule:" segment of the alertIdentifier, e.g.
    //   monitor:DatareceiverHealth|...|rule:datareceiver.health.bad|desc:...
    // Matching on the rule (not just sourceId) makes binding robust regardless of how
    // sourceId is cased/populated upstream. Each service owns its <name>.health.bad and
    // <name>.service.dead rules.
    var SERVICE_RULE_MAP = [
        { sourceId: "DataReceiverHealth", prefixes: ["datareceiver.health", "datareceiver.service"] },
        { sourceId: "DataloggerHealth",   prefixes: ["datalogger.health", "datalogger.service"] },
        { sourceId: "AlertHealth",        prefixes: ["alert.health", "alert.service"] },
        { sourceId: "DebouncerHealth",    prefixes: ["debouncer.health", "debouncer.service"] },
        { sourceId: "PointMachineHealth", prefixes: ["pointmachine.health", "pointmachine.service"] }
    ];

    // Return the canonical service sourceId for an alert (one of SERVICE_HEALTH_IDS),
    // or "" if the alert is not a service-health alert. Rule wins; sourceId is the fallback.
    function classifyServiceHealth(alert) {
        var rawId = String(firstDefined(alert.alertIdentifier, alert.AlertIdentifier, "") || "").toLowerCase();
        var parsed = parseAlertIdentifier(alert.alertIdentifier || alert.AlertIdentifier);
        var rule = String(parsed.rule || "").toLowerCase();
        var hay = rule || rawId; // prefer the explicit rule, else scan the whole identifier
        for (var i = 0; i < SERVICE_RULE_MAP.length; i++) {
            var m = SERVICE_RULE_MAP[i];
            for (var j = 0; j < m.prefixes.length; j++) {
                if (hay.indexOf(m.prefixes[j]) >= 0) return m.sourceId;
            }
        }
        // Fallback: trust sourceId if it is already one of the known service ids.
        var srcId = String(firstDefined(alert.sourceId, alert.SourceId, "") || "");
        return SERVICE_HEALTH_IDS.indexOf(srcId) >= 0 ? srcId : "";
    }

    // Resolve the node (local|cloud) for an alert: nodeIdentity first, then the
    // role:/monitor: hints in the alertIdentifier. "" when neither indicates a node.
    function alertNodeOf(alert) {
        var nid = String(firstDefined(alert.nodeIdentity, alert.NodeIdentity, "") || "").toLowerCase();
        if (nid === "local" || nid === "cloud") return nid;
        var parsed = parseAlertIdentifier(alert.alertIdentifier || alert.AlertIdentifier);
        var role = String(parsed.role || "").toLowerCase();
        if (role.indexOf("cloud") >= 0 || role.indexOf("server") >= 0) return "cloud";
        if (role.indexOf("local") >= 0 || role.indexOf("edge") >= 0) return "local";
        return "";
    }

    var alertLiveRaw = [];          // Full AlertLive response
    var serviceHealthAlerts = {};   // { siteId: { DataReceiverHealth: {status,alert}, ... } }
    // Precomputed per-node alert index (built once per AlertLive fetch) so the service
    // cells don't rescan alertLiveRaw on every render. Keys: "siteId|sourceId|node".
    var alertNodeIndex = {};        // { "site|source|node": { count, status } }
    var alertNodeAny = {};          // { "site|node": true }  (does this node report anything at this site)
    var alertSvcIndex = {};         // { "site|sourceId": { count, status, dead, bad } }  node-agnostic per-service count
    var alertLiveLastFetch = null;
    // AlertLive WebSocket (real-time push) runtime state.
    var alertLiveWs = null, alertLiveWsConnected = false, alertLiveWsReconnectTimer = null;
    var alertLiveWsAttempts = 0, _alwsConnecting = false, alertLiveWsCurrentUrl = null;
    var activeView = "live";        // Alert Health tab removed - Live Services is the only view

    // ===== Sensor (Attribute) Health =====
    var sensorDataCache = {};       // { siteId: { assets: [...], totalSensors: N, totalIoT: N, sensorMap: { attrId: {assetId, assetName, attrTitle, attrAlias} } } }
    var sensorAlertMap = {};        // { siteId: { attrKey: [alert, ...] } }  - alerts matched to sensors
    var sensorHealthSummary = {};   // { siteId: { total, healthy, warning, unhealthy, details[] } }
    var sensorDataLoading = {};     // { siteId: true/false }
    var cardLineCache = {};         // { siteId: { cardLines[], adcMap:{}, clusterMap:{}, adcIds:[], clusterIds:[], attrToAdc:{}, attrToCluster:{} } }

    // ===== Utility helpers =====
    function safeObj(x) { return x && typeof x === "object" ? x : {}; }
    function firstDefined() { for (var i = 0; i < arguments.length; i++) if (arguments[i] !== undefined && arguments[i] !== null && arguments[i] !== "") return arguments[i]; return null; }
    function num(v, d) { var n = Number(v); return isFinite(n) ? n : (d || 0); }
    function str(v, d) { return v === undefined || v === null || v === "" ? (d || "\u2014") : String(v); }
    function boolFrom(v) {
        if (typeof v === "boolean") return v;
        if (typeof v === "number") return v === 1;
        var s = String(v || "").toLowerCase();
        return s === "1" || s === "true" || s === "connected" || s === "up" || s.indexOf("1 (") === 0 || s.indexOf("healthy") >= 0;
    }
    function fmtUp(s) { s = num(s, 0); if (!s) return "\u2014"; var d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600), m = Math.floor((s % 3600) / 60); return d + "d " + h + "h " + m + "m"; }
    function esc(v) { return String(v == null ? "" : v).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#039;"); }
    // Full date + time (with seconds) for "last data received" displays.
    function fmtFullTs(iso) {
        if (!iso) return null;
        var t = new Date(iso);
        if (isNaN(t.getTime())) return null;
        return t.toLocaleString(undefined, { year: "numeric", month: "short", day: "2-digit", hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: true });
    }
    // Compact "x ago" for tooltips ("12s ago", "3m 4s ago", "2h 5m ago", "1d 3h ago").
    function fmtAgo(iso) {
        if (!iso) return null;
        var ms = Date.now() - new Date(iso).getTime();
        if (isNaN(ms) || ms < 0) ms = 0;
        var s = Math.floor(ms / 1000);
        if (s < 60) return s + "s ago";
        var m = Math.floor(s / 60); s = s % 60;
        if (m < 60) return m + "m " + s + "s ago";
        var h = Math.floor(m / 60); m = m % 60;
        if (h < 24) return h + "h " + m + "m ago";
        var d = Math.floor(h / 24); h = h % 24;
        return d + "d " + h + "h ago";
    }
    function normalizeSelectItems(list) { if (!Array.isArray(list)) return []; return list.map(function (x) { return { Id: String(firstDefined(x.Id, x.id, x.Value, x.value, "")), Name: String(firstDefined(x.Name, x.name, x.Text, x.text, "")) }; }).filter(function (x) { return x.Id !== "" || x.Name !== ""; }); }
    function optionName(list, id) { var f = (list || []).find(function (x) { return String(x.Id) === String(id); }); return f ? f.Name : ""; }
    function mapApiSelectItems(data) { return normalizeSelectItems(Array.isArray(data) ? data.map(function (x) { return { Id: firstDefined(x.Id, x.id, x.Value, x.value), Name: firstDefined(x.Name, x.name, x.Text, x.text) }; }) : []); }

    // ===== Default station skeleton =====
    function defaultStation(siteId) {
        return {
            zoneId: "", divisionId: "", zone: "Unknown", division: "Unknown",
            stationName: siteId ? ("Site " + siteId) : "Unknown Site",
            siteId: siteId || 0,
            services: {},
            hardware: { sensors: { total: 0, unhealthy: 0, issues: [] }, iot: { total: 0, unhealthy: 0, issues: [] }, network: { total: 0, unhealthy: 0, issues: [] } },
            _topic: "", _updatedAt: null, _rawPayloads: {}, _serviceTypes: {},
            _svcUpdatedAt: {},      // { serviceKey: ISO } - last MQTT data per service
            _svcTypeUpdatedAt: {}   // { serviceKey: { local: ISO, cloud: ISO } } - last data per Local/Cloud node
        };
    }
    function normalizeHardware(hw) {
        hw = safeObj(hw); var out = {};
        HW_ORDER.forEach(function (h) { var x = safeObj(hw[h.key]); out[h.key] = { total: num(firstDefined(x.total, x.Total), 0), unhealthy: num(firstDefined(x.unhealthy, x.Unhealthy, x.issue, x.Issue), 0), issues: Array.isArray(x.issues) ? x.issues : (Array.isArray(x.Issues) ? x.Issues : []) }; });
        return out;
    }

    function isPlainObj(x) { return !!x && typeof x === "object" && !Array.isArray(x); }
    // Deep-merge incoming health payloads: objects merge key-by-key (newest
    // values win), arrays and primitives are replaced. Services that alternate
    // between message shapes (small heartbeat vs full diagnostics) no longer
    // make previously received fields "disappear" from the modal.
    function deepMergePayload(oldVal, newVal) {
        if (!isPlainObj(oldVal) || !isPlainObj(newVal)) return newVal;
        var out = {};
        Object.keys(oldVal).forEach(function (k) { out[k] = oldVal[k]; });
        Object.keys(newVal).forEach(function (k) { out[k] = deepMergePayload(oldVal[k], newVal[k]); });
        return out;
    }

    // ===== Site / Topic resolution =====
    // MQTT topic scope: a single concrete site only when exactly one is selected,
    // otherwise 0 = all sites (display filtering stays client-side).
    function selectedHealthSiteId() { return filterSiteIds.length === 1 ? (parseInt(filterSiteIds[0], 10) || 0) : 0; }

    async function refreshHealthMqttTopics(autoResubscribe) {
        var siteId = selectedHealthSiteId();
        try {
            var r = await fetch(HEALTH_TOPICS_URL + "?siteId=" + encodeURIComponent(siteId), { credentials: "same-origin" });
            if (!r.ok) throw new Error("HTTP " + r.status);
            var json = await r.json();
            var rows = json && json.data ? json.data : [];
            var topics = [];
            healthTopicMeta = {};

            rows.forEach(function (row) {
                var siteIdValue = firstDefined(row.SiteId, row.siteId, "");
                var siteNameValue = firstDefined(row.SiteName, row.siteName, "");
                var basePathValue = firstDefined(row.BasePath, row.basePath, "");
                var zoneIdValue = firstDefined(row.ZoneId, row.zoneId, "");
                var zoneNameValue = firstDefined(row.ZoneName, row.zoneName, "");
                var divisionIdValue = firstDefined(row.DivisionId, row.divisionId, "");
                var divisionNameValue = firstDefined(row.DivisionName, row.divisionName, "");
                var rowTopics = Array.isArray(row.Topics) ? row.Topics : (Array.isArray(row.topics) ? row.topics : []);

                // Backend now returns these topics, but keep this client-side fallback
                // so the dashboard still subscribes correctly if an older controller is deployed.
                var parsedSid = parseInt(siteIdValue, 10) || 0;
                if (parsedSid > 0) {
                    // datareceiver / debouncer / pointServices publish on per-node topics
                    // (/local/ and /cloud/ inserted before /health). Subscribe to both so
                    // each node's health is received even against an older controller that
                    // does not yet return these in its topic list.
                    var extraTopics = [
                        "datareceiver/" + parsedSid + "/local/health",
                        "datareceiver/" + parsedSid + "/cloud/health",
                        "debouncer/" + parsedSid + "/local/health",
                        "debouncer/" + parsedSid + "/cloud/health",
                        "pointServices/" + parsedSid + "/local/health",
                        "pointServices/" + parsedSid + "/cloud/health"
                    ];
                    // The Alert service (TriggerAlert) publishes its health on
                    // {BasePath}/alerthealth (e.g. /DNR/PPTA/alerthealth), so make
                    // sure that topic is always part of the subscription set even
                    // if the backend topic list does not include it.
                    var bp = String(basePathValue || "").replace(/^\/+|\/+$/g, "");
                    if (bp) extraTopics.push(bp + "/alerthealth");
                    extraTopics.forEach(function (extraTopic) {
                        if (rowTopics.indexOf(extraTopic) < 0) rowTopics.push(extraTopic);
                    });
                }

                rowTopics.forEach(function (topic) {
                    if (!topic) return;
                    topic = String(topic).replace(/^\/+|\/+$/g, "");
                    if (topics.indexOf(topic) < 0) topics.push(topic);
                    healthTopicMeta[topic] = {
                        siteId: siteIdValue, siteName: siteNameValue, basePath: basePathValue,
                        zoneId: zoneIdValue, zoneName: zoneNameValue,
                        divisionId: divisionIdValue, divisionName: divisionNameValue
                    };
                });

                if (parsedSid > 0 && !stations.find(function (s) { return String(s.siteId) === String(parsedSid); })) {
                    var placeholder = defaultStation(parsedSid);
                    placeholder.stationName = siteNameValue || placeholder.stationName;
                    placeholder.zoneId = zoneIdValue || "";
                    placeholder.zone = zoneNameValue || optionName(masterZones, zoneIdValue) || "Unknown";
                    placeholder.divisionId = divisionIdValue || "";
                    placeholder.division = divisionNameValue || optionName(masterDivisions.length ? masterDivisions : divisionOptions, divisionIdValue) || "Unknown";
                    stations.push(placeholder);
                }
            });

            mqttTopics = topics;
            mqttTopic = mqttTopics.join(", ");
            log((siteId ? "Selected site" : "All sites") + " health topics loaded: " + mqttTopics.length + ", stations: " + stations.length, "sys");

            if (autoResubscribe && mqttConnected && mqttClient) { subscribeMqtt(); }
            else { render(); }
            // Fetch sensor data for any newly discovered sites
            fetchAllSensorData();
            loadVisibleDeviceStatus();
        } catch (e) {
            mqttTopics = []; mqttTopic = ""; healthTopicMeta = {};
            log("Health topic bind failed: " + e.message, "err");
            render();
        }
    }

    function getManualTopicList() {
        var inp = document.getElementById("mqttTopic");
        var raw = inp && inp.value ? inp.value : mqttTopic;
        return String(raw || "").split(/[\n,]+/).map(function (x) { return x.trim().replace(/^\/+|\/+$/g, ""); }).filter(function (x, i, arr) { return x && arr.indexOf(x) === i; });
    }

    // =====================================================================
    // MULTI-SELECT FILTERS (Zone / Division / Site)
    // Empty selection = "All". Division & Site options cascade from the
    // selected parents using the existing GetDivisionByZoneId /
    // GetSiteByDivisionId endpoints (results memoised per id).
    // =====================================================================
    function MultiSelect(cfg) {
        this.allLabel = cfg.allLabel || "All";
        this.onChange = cfg.onChange || function () { };
        this.items = [];
        this.selected = {};   // id -> true (empty = All)
        this.search = "";
        this.root = document.createElement("div");
        this.root.className = "msel";
        this._build();
    }
    MultiSelect.prototype._build = function () {
        var self = this;
