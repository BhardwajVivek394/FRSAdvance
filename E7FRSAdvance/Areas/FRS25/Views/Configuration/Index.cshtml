@{
    ViewBag.Title = "Configuration";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="row">
                        <div class="col-12 col-sm-5">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">Configuration</li>
                                    <li class="breadcrumb-item active" aria-current="page"><a href="#">Configuration</a></li>
                                </ol>
                            </nav>
                        </div>
                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-t-10">
                    <div class="row mb-lg-5 mb-3">
                        <div class="col">
                            <ul class="nav nav-pills mb-3 tabsStyle" id="pills-tab" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active border-0 mr-2" id="maintenance-mode-tab"
                                            data-toggle="pill" data-target="#maintenance-mode"
                                            onclick="fnBindMaintenanceModeScal()">
                                        Maintenance Mode
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link border-0 mr-2" id="feedback-duration-tab"
                                            data-toggle="pill" data-target="#feedback-duration"
                                            onclick="fnBindFeedbackScal()">
                                        Feedback Duration
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link border-0 mr-2" id="hierarchy-alerts-tab"
                                            data-toggle="pill" data-target="#hierarchy-alerts"
                                            onclick="fnBindHierarchyScal()">
                                        Hierarchy Alerts &amp; Repeat Alert Frequency
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link border-0 mr-2" id="system-parameters-tab"
                                            data-toggle="pill" data-target="#system-parameters">
                                        System Parameters
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link border-0 mr-2" id="login-security-tab"
                                            data-toggle="pill" data-target="#login-security"
                                            onclick="fnBindSecurityAppConfig()">
                                        Login Security
                                    </button>
                                </li>
                            </ul>

                            <div class="tab-content" id="pills-tabContent">

                                <!-- =========================================================
                                     MAINTENANCE MODE TAB
                                     Alert Frequency column: number input + Hours/Min radios
                                ========================================================= -->
                                <div class="tab-pane fade show active" id="maintenance-mode"
                                     role="tabpanel" aria-labelledby="maintenance-mode-tab">
                                    <div class="row">
                                        <div class="col-lg-6"></div>
                                        <div class="col-lg-6">
                                            <div class="row">
                                                <div class="col-4"></div>
                                                <div class="col-1">
                                                    <label class="switch">
                                                        <input type="checkbox" id="chkMaintenanceModeScal" data-id="" checked
                                                               onchange="fnUpdateMaintenanceModeScal()" />
                                                        <span class="slider"></span>
                                                    </label>
                                                </div>
                                                <div class="col-3">
                                                    @Html.DropDownList("drpMaintenanceModeZone",
                                                             (IEnumerable<SelectListItem>)ViewBag.Zones, "Zone",
                                                             new
                                                             {
                                                                 @class = "form-control",
                                                                 tabindex = 1,
                                                                 @onchange = "fnBindMaintenanceModeAppConfig(this)"
                                                             })
                                                </div>
                                                <div class="col-1">
                                                    <button type="button" class="btn btn-primary-search-home"
                                                            onclick="fnSaveMaintenanceMode()">
                                                        Save
                                                    </button>
                                                </div>
                                                <div class="col-2">
                                                    <button type="button" class="btn btn-primary-search-home"
                                                            onclick="fnSetDefaultMaintenanceMode()">
                                                        Set Default value
                                                    </button>
                                                </div>
                                                <div class="col-1"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="table-border mt-2">
                                        <div class="my-4 px-lg-4 px-2 w-100">
                                            <div class="d-flex align-items-center badge-cl gap-10">
                                                <h5 class="m-0">Maintenance Mode Alert Frequency</h5>
                                            </div>
                                        </div>
                                        <table class="table">
                                            <thead>
                                                <tr>
                                                    <th>Sr. No.</th>
                                                    <th>Asset Type</th>
                                                    <th>Alert Frequency</th>
                                                    <th>Status</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbodyMaintenanceMode">
                                                @if (ViewBag.AssetTypes != null)
                                                {
                                                    int counter = 1;
                                                    foreach (var atype in ViewBag.AssetTypes as List<Domain.AssetType>)
                                                    {
                                                        <tr data-assettypeid="@atype.Id">
                                                            <td>@counter</td>
                                                            <td>@atype.Name</td>
                                                            <td>
                                                                <div class="d-flex align-items-center flex-wrap gap-2">
                                                                    <input type="number" class="form-control alert-frequency"
                                                                           data-assettypeid="@atype.Id" data-id=""
                                                                           style="max-width:120px;" />
                                                                    <div class="d-flex align-items-center ml-2">
                                                                        <div class="form-check form-check-inline mb-0">
                                                                            <input class="form-check-input mm-freq-unit-radio" type="radio"
                                                                                   name="mm_freq_unit_@atype.Id"
                                                                                   id="mm_freq_hours_@atype.Id"
                                                                                   data-assettypeid="@atype.Id" data-id=""
                                                                                   value="Hours" checked />
                                                                            <label class="form-check-label" for="mm_freq_hours_@atype.Id">Hours</label>
                                                                        </div>
                                                                        <div class="form-check form-check-inline mb-0">
                                                                            <input class="form-check-input mm-freq-unit-radio" type="radio"
                                                                                   name="mm_freq_unit_@atype.Id"
                                                                                   id="mm_freq_min_@atype.Id"
                                                                                   data-assettypeid="@atype.Id" data-id=""
                                                                                   value="Min" />
                                                                            <label class="form-check-label" for="mm_freq_min_@atype.Id">Min</label>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                            <td>
                                                                <select class="form-control status-select"
                                                                        data-assettypeid="@atype.Id">
                                                                    <option value="1">Active</option>
                                                                    <option value="0">Inactive</option>
                                                                </select>
                                                            </td>
                                                        </tr>
                                                        counter++;
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- =========================================================
                                     FEEDBACK DURATION TAB
                                     Both Failure AND Predictive columns: Hours/Min radios
                                ========================================================= -->
                                <div class="tab-pane fade" id="feedback-duration"
                                     role="tabpanel" aria-labelledby="feedback-duration-tab">
                                    <div class="card-body p-t-10">
                                        <div class="row">
                                            <div class="col-lg-6"></div>
                                            <div class="col-lg-6">
                                                <div class="row">
                                                    <div class="col-5"></div>
                                                    <div class="col-3">
                                                        @Html.DropDownList("drpFeedbackZone",
                                                                 (IEnumerable<SelectListItem>)ViewBag.Zones, "Zone",
                                                                 new
                                                                 {
                                                                     @class = "form-control",
                                                                     tabindex = 1,
                                                                     @onchange = "fnBindFeedbackAppConfig(this)"
                                                                 })
                                                    </div>
                                                    <div class="col-1">
                                                        <button type="button" class="btn btn-primary-search-home"
                                                                onclick="fnSaveFeedback()">
                                                            Save
                                                        </button>
                                                    </div>
                                                    <div class="col-2">
                                                        <button type="button" class="btn btn-primary-search-home"
                                                                onclick="fnSetDefaultFeedback()">
                                                            Set Default value
                                                        </button>
                                                    </div>
                                                    <div class="col-1"></div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Maintainer Feedback Duration -->
                                        <div class="table-border mt-2">
                                            <div class="my-4 px-lg-4 px-2 w-100">
                                                <div class="d-flex align-items-center badge-cl gap-10">
                                                    <h5 class="m-0">Maintainer Feedback Duration (hours)</h5>
                                                </div>
                                            </div>
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th>Asset Type</th>
                                                        <th>Failure Alert Feedback</th>
                                                        <th>Predictive Alert Feedback</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="tbodyMaintainerFeedback">
                                                    @if (ViewBag.AssetTypes != null)
                                                    {
                                                        foreach (var atype in ViewBag.AssetTypes as List<Domain.AssetType>)
                                                        {
                                                            <tr data-assettypeid="@atype.Id">
                                                                <td>@atype.Name</td>
                                                                <td>
                                                                    <div class="d-flex align-items-center flex-wrap gap-2">
                                                                        <input type="number" class="form-control failure-alert-frequency"
                                                                               data-assettypeid="@atype.Id" data-id="" style="max-width:120px;" />
                                                                        <div class="d-flex align-items-center ml-2">
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input failure-unit-radio" type="radio"
                                                                                       name="mf_fail_unit_@atype.Id" id="mf_fail_h_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Hours" checked />
                                                                                <label class="form-check-label" for="mf_fail_h_@atype.Id">Hours</label>
                                                                            </div>
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input failure-unit-radio" type="radio"
                                                                                       name="mf_fail_unit_@atype.Id" id="mf_fail_m_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Min" />
                                                                                <label class="form-check-label" for="mf_fail_m_@atype.Id">Min</label>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="d-flex align-items-center flex-wrap gap-2">
                                                                        <input type="number" class="form-control predictive-alert-frequency"
                                                                               data-assettypeid="@atype.Id" data-id="" style="max-width:120px;" />
                                                                        <div class="d-flex align-items-center ml-2">
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input predictive-unit-radio" type="radio"
                                                                                       name="mf_pred_unit_@atype.Id" id="mf_pred_h_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Hours" checked />
                                                                                <label class="form-check-label" for="mf_pred_h_@atype.Id">Hours</label>
                                                                            </div>
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input predictive-unit-radio" type="radio"
                                                                                       name="mf_pred_unit_@atype.Id" id="mf_pred_m_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Min" />
                                                                                <label class="form-check-label" for="mf_pred_m_@atype.Id">Min</label>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- Vendor Comment Duration -->
                                    <div class="card-body p-t-10">
                                        <div class="table-border">
                                            <div class="my-4 px-lg-4 px-2 w-100">
                                                <div class="d-flex align-items-center badge-cl gap-10">
                                                    <h5 class="m-0">Vendor Comment Duration after PT/F Feedback (hours)</h5>
                                                </div>
                                            </div>
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th>Asset Type</th>
                                                        <th>Failure Alert Feedback</th>
                                                        <th>Predictive Alert Feedback</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="tbodyVendorFeedback">
                                                    @if (ViewBag.AssetTypes != null)
                                                    {
                                                        foreach (var atype in ViewBag.AssetTypes as List<Domain.AssetType>)
                                                        {
                                                            <tr data-assettypeid="@atype.Id">
                                                                <td>@atype.Name</td>
                                                                <td>
                                                                    <div class="d-flex align-items-center flex-wrap gap-2">
                                                                        <input type="number" class="form-control failure-alert-frequency"
                                                                               data-assettypeid="@atype.Id" data-id="" style="max-width:120px;" />
                                                                        <div class="d-flex align-items-center ml-2">
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input failure-unit-radio" type="radio"
                                                                                       name="vf_fail_unit_@atype.Id" id="vf_fail_h_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Hours" checked />
                                                                                <label class="form-check-label" for="vf_fail_h_@atype.Id">Hours</label>
                                                                            </div>
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input failure-unit-radio" type="radio"
                                                                                       name="vf_fail_unit_@atype.Id" id="vf_fail_m_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Min" />
                                                                                <label class="form-check-label" for="vf_fail_m_@atype.Id">Min</label>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="d-flex align-items-center flex-wrap gap-2">
                                                                        <input type="number" class="form-control predictive-alert-frequency"
                                                                               data-assettypeid="@atype.Id" data-id="" style="max-width:120px;" />
                                                                        <div class="d-flex align-items-center ml-2">
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input predictive-unit-radio" type="radio"
                                                                                       name="vf_pred_unit_@atype.Id" id="vf_pred_h_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Hours" checked />
                                                                                <label class="form-check-label" for="vf_pred_h_@atype.Id">Hours</label>
                                                                            </div>
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input predictive-unit-radio" type="radio"
                                                                                       name="vf_pred_unit_@atype.Id" id="vf_pred_m_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Min" />
                                                                                <label class="form-check-label" for="vf_pred_m_@atype.Id">Min</label>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <!-- JE/SSE Feedback Modification Duration -->
                                    <div class="card-body p-t-10">
                                        <div class="table-border">
                                            <div class="my-4 px-lg-4 px-2 w-100">
                                                <div class="d-flex align-items-center badge-cl gap-10">
                                                    <h5 class="m-0">JE/SSE Feedback Modification Duration (hours)</h5>
                                                </div>
                                            </div>
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th>Asset Type</th>
                                                        <th>Failure Alert Feedback</th>
                                                        <th>Predictive Alert Feedback</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="tbodyJESSEFeedback">
                                                    @if (ViewBag.AssetTypes != null)
                                                    {
                                                        foreach (var atype in ViewBag.AssetTypes as List<Domain.AssetType>)
                                                        {
                                                            <tr data-assettypeid="@atype.Id">
                                                                <td>@atype.Name</td>
                                                                <td>
                                                                    <div class="d-flex align-items-center flex-wrap gap-2">
                                                                        <input type="number" class="form-control failure-alert-frequency"
                                                                               data-assettypeid="@atype.Id" data-id="" style="max-width:120px;" />
                                                                        <div class="d-flex align-items-center ml-2">
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input failure-unit-radio" type="radio"
                                                                                       name="jf_fail_unit_@atype.Id" id="jf_fail_h_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Hours" checked />
                                                                                <label class="form-check-label" for="jf_fail_h_@atype.Id">Hours</label>
                                                                            </div>
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input failure-unit-radio" type="radio"
                                                                                       name="jf_fail_unit_@atype.Id" id="jf_fail_m_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Min" />
                                                                                <label class="form-check-label" for="jf_fail_m_@atype.Id">Min</label>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="d-flex align-items-center flex-wrap gap-2">
                                                                        <input type="number" class="form-control predictive-alert-frequency"
                                                                               data-assettypeid="@atype.Id" data-id="" style="max-width:120px;" />
                                                                        <div class="d-flex align-items-center ml-2">
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input predictive-unit-radio" type="radio"
                                                                                       name="jf_pred_unit_@atype.Id" id="jf_pred_h_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Hours" checked />
                                                                                <label class="form-check-label" for="jf_pred_h_@atype.Id">Hours</label>
                                                                            </div>
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input predictive-unit-radio" type="radio"
                                                                                       name="jf_pred_unit_@atype.Id" id="jf_pred_m_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Min" />
                                                                                <label class="form-check-label" for="jf_pred_m_@atype.Id">Min</label>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <!-- =========================================================
                                     HIERARCHY ALERTS TAB
                                     ALL 4 level tables:
                                       Failure Alert Freq    → Hours/Min radio  (NEW)
                                       Predictive Alert Freq → Hours/Min radio  (NEW)
                                ========================================================= -->
                                <div class="tab-pane fade" id="hierarchy-alerts"
                                     role="tabpanel" aria-labelledby="hierarchy-alerts-tab">
                                    <div class="card-body p-t-10">
                                        <div class="row">
                                            <div class="col-lg-6"></div>
                                            <div class="col-lg-6">
                                                <div class="row">
                                                    <div class="col-4"></div>
                                                    <div class="col-1">
                                                        <label class="switch">
                                                            <input type="checkbox" id="chkHierarchyScal" data-id="" checked
                                                                   onchange="fnUpdateHierarchyScal()" />
                                                            <span class="slider"></span>
                                                        </label>
                                                    </div>
                                                    <div class="col-3">
                                                        @Html.DropDownList("drpHierarchyZone",
                                                                 (IEnumerable<SelectListItem>)ViewBag.Zones, "Zone",
                                                                 new
                                                                 {
                                                                     @class = "form-control",
                                                                     tabindex = 1,
                                                                     @onchange = "fnBindHierarchyAppConfig(this)"
                                                                 })
                                                    </div>
                                                    <div class="col-1">
                                                        <button type="button" class="btn btn-primary-search-home"
                                                                onclick="fnSaveHierarchy()">
                                                            Save
                                                        </button>
                                                    </div>
                                                    <div class="col-2">
                                                        <button type="button" class="btn btn-primary-search-home"
                                                                onclick="fnSetDefaultHierarchy()">
                                                            Set Default value
                                                        </button>
                                                    </div>
                                                    <div class="col-1"></div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- ESM Level -->
                                        <div class="table-border mt-2">
                                            <div class="my-4 px-lg-4 px-2 w-100">
                                                <div class="d-md-flex justify-content-between align-items-center">
                                                    <div class="d-flex align-items-center badge-cl gap-10">
                                                        <h5 class="m-0">ESM Level</h5>
                                                    </div>
                                                    <div class="d-flex align-items-center badge-cl gap-10">
                                                        <label>First Alert Delay (Min)</label>
                                                        <input type="number" class="form-control hierarchy-alerts-input"
                                                               id="esm_alert_days" data-key="ESMAlertDelay" data-id="" value=""
                                                               data-userClassId="@E7FRSAdvance.Utility.Utility.UserClass.ESM.GetHashCode()" />
                                                    </div>
                                                </div>
                                            </div>
                                            <table class="table">
                                                <thead>
                                                    <tr>
                                                        <th>Asset Type</th>
                                                        <th>Failure Alert Freq</th>
                                                        <th>Predictive Alert Freq</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="tbodyESMLevel">
                                                    @if (ViewBag.AssetTypes != null)
                                                    {
                                                        foreach (var atype in ViewBag.AssetTypes as List<Domain.AssetType>)
                                                        {
                                                            <tr data-assettypeid="@atype.Id">
                                                                <td>@atype.Name</td>
                                                                <td>
                                                                    <div class="d-flex align-items-center flex-wrap gap-2">
                                                                        <input type="number" class="form-control failure-alert-frequency"
                                                                               data-assettypeid="@atype.Id" data-id="" style="max-width:120px;" />
                                                                        <div class="d-flex align-items-center ml-2">
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input failure-unit-radio" type="radio"
                                                                                       name="esm_fail_unit_@atype.Id" id="esm_fail_h_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Hours" checked />
                                                                                <label class="form-check-label" for="esm_fail_h_@atype.Id">Hours</label>
                                                                            </div>
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input failure-unit-radio" type="radio"
                                                                                       name="esm_fail_unit_@atype.Id" id="esm_fail_m_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Min" />
                                                                                <label class="form-check-label" for="esm_fail_m_@atype.Id">Min</label>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                                <td>
                                                                    <div class="d-flex align-items-center flex-wrap gap-2">
                                                                        <input type="number" class="form-control predictive-alert-frequency"
                                                                               data-assettypeid="@atype.Id" data-id="" style="max-width:120px;" />
                                                                        <div class="d-flex align-items-center ml-2">
                                                                            <div class="form-check form-check-inline mb-0">
                                                                                <input class="form-check-input predictive-unit-radio" type="radio"
                                                                                       name="esm_pred_unit_@atype.Id" id="esm_pred_h_@atype.Id"
                                                                                       data-assettypeid="@atype.Id" data-id="" value="Hours" checked />
                                                                                <label class="form-check-label" for="esm_pred_h_@atype.Id">Hours</label>
