</section>

<script>
    var alertPredictive   = '@E7FRSAdvance.Utility.Utility.AlertType.Predictive.GetHashCode()';
    var alertFail         = '@E7FRSAdvance.Utility.Utility.AlertType.Failure.GetHashCode()';
    var userClassJE       = '@E7FRSAdvance.Utility.Utility.UserClass.JE.GetHashCode()';
    var userClassESM      = '@E7FRSAdvance.Utility.Utility.UserClass.ESM.GetHashCode()';
    var userClassSSECSI   = '@E7FRSAdvance.Utility.Utility.UserClass.SSECSI.GetHashCode()';
    var userClassASTEDSTE = '@E7FRSAdvance.Utility.Utility.UserClass.ASTEDSTE.GetHashCode()';
    var userClasse7Con    = '@E7FRSAdvance.Utility.Utility.UserClass.ENERGY7CONTROL.GetHashCode()';

    var isMaintenanceModeLoading = false;
    var isFeedbackLoading        = false;
    var isHierarchyLoading       = false;
    var isSystemParamsLoading    = false;
    var isSecurityLoading        = false;

    $(document).ready(function () { fnBindMaintenanceModeScal(); });

    // ─────────────────────────────────────────────────────────────
    // SHARED HELPERS
    // ─────────────────────────────────────────────────────────────

    /** Read checked radio in a row → { unit, unitId } */
    function getRadioUnit(row, radioClass) {
        var chk = row.find('.' + radioClass + ':checked');
        return { unit: chk.val() || 'Hours', unitId: chk.attr('data-id') || '' };
    }

    /** Set a radio group to a saved value and store its DB id */
    function restoreRadio(row, radioClass, savedValue, savedId) {
        row.find('.' + radioClass).attr('data-id', savedId || '');
        row.find('.' + radioClass + '[value="' + (savedValue || 'Hours') + '"]').prop('checked', true);
    }

    /** Reset all radio groups in a row back to Hours */
    function resetRadios(row) {
        row.find('.mm-freq-unit-radio, .failure-unit-radio, .predictive-unit-radio')
           .attr('data-id', '');
        row.find('.mm-freq-unit-radio[value="Hours"], .failure-unit-radio[value="Hours"], .predictive-unit-radio[value="Hours"]')
           .prop('checked', true);
    }

    /**
     * Load values + unit radios for one column of one table.
     * appKey     – data AppKey for the numeric values
     * unitKey    – data AppKey for the unit (Hours/Min)
     * alertType  – alertFail | alertPredictive | null
     * valClass   – CSS class on the number <input>
     * radioClass – CSS class on the radio <input>s
     */
    function loadColumn(tbodyId, appKey, unitKey, alertType, valClass, radioClass, zoneId, onDone) {
        var done = 0;
        function tick() { if (++done >= 2 && onDone) onDone(); }

        $.ajax({
            url: '/FRS25/Configuration/GetAppConfig', type: 'POST', contentType: 'application/json',
            data: '{zoneId:' + zoneId + ',appKey:"' + appKey + '"}',
            success: function (resp) {
                $('#' + tbodyId + ' tr').each(function () {
                    var row = $(this), atid = row.data('assettypeid');
                    var m = resp && resp.length
                        ? resp.filter(function (a) {
                            return a.AssetTypeId == atid && (alertType === null || a.AlertInfoId == alertType);
                          })[0] : null;
                    if (m) row.find('.' + valClass).val(m.AppValue).attr('data-id', m.Id);
                    else   row.find('.' + valClass).val('').attr('data-id', '');
                });
            },
            error: function (x, s, e) { alert('Error loading ' + appKey + ': ' + e); },
            complete: tick
        });

        $.ajax({
            url: '/FRS25/Configuration/GetAppConfig', type: 'POST', contentType: 'application/json',
            data: '{zoneId:' + zoneId + ',appKey:"' + unitKey + '"}',
            success: function (resp) {
                $('#' + tbodyId + ' tr').each(function () {
                    var row = $(this), atid = row.data('assettypeid');
                    var m = resp && resp.length
                        ? resp.filter(function (a) {
                            return a.AssetTypeId == atid && (alertType === null || a.AlertInfoId == alertType);
                          })[0] : null;
                    restoreRadio(row, radioClass, m ? m.AppValue : 'Hours', m ? m.Id : '');
                });
            },
            error: function () { /* silently default to Hours */ },
            complete: tick
        });
    }

    // ═══════════════════════════════════════════════════════════════
    // #region MAINTENANCE MODE
    // ═══════════════════════════════════════════════════════════════
    function fnSaveMaintenanceMode() {
        if (isMaintenanceModeLoading) { alert('Please wait, data is still loading...'); return; }
        var zoneId = $('#drpMaintenanceModeZone').val();
        if (!zoneId || zoneId === '') { alert('Please select a Zone'); return; }

        var data = [];
        $('#tbodyMaintenanceMode tr').each(function () {
            debugger;
            var row = $(this), atid = row.data('assettypeid');
            var val = row.find('.alert-frequency').val();
            var id  = row.find('.alert-frequency').attr('data-id');
            var st  = row.find('.status-select').val();
            var u   = getRadioUnit(row, 'mm-freq-unit-radio');

            if (atid && val !== null && val !== '') {
                data.push({ Id: id ? parseInt(id) : null, AssetTypeId: atid,
                    AppKey: 'MaintenanceMode', GroupName: 'MaintenanceMode',
                    AppValue: parseInt(val), Status: st ? parseInt(st) : 1, ZoneId: parseInt(zoneId) });
                data.push({ Id: u.unitId ? parseInt(u.unitId) : null, AssetTypeId: atid,
                    AppKey: 'MaintenanceModeFreqUnit', GroupName: 'MaintenanceMode',
                    AppValue: u.unit, ZoneId: parseInt(zoneId) });
            }
        });

        if (!data.length) { alert('No data to save'); return; }
        $('#loader').show();
        $.ajax({
            url: '@Url.Action("Save","Configuration",new{area="FRS25"})',
            type: 'POST', contentType: 'application/json', data: JSON.stringify(data),
            success: function (r) {
                $('#loader').hide();
                if (r.type === 'success') { alert('Maintenance mode saved successfully'); fnBindMaintenanceModeAppConfig($('#drpMaintenanceModeZone')); }
                else alert('Error: ' + r.Message);
            },
            error: function (x, s, e) { $('#loader').hide(); alert('Error: ' + e); }
        });
    }

    function fnSetDefaultMaintenanceMode() {
        var defs = { 1:60, 2:45, 3:60, 34:30 };
        $('#tbodyMaintenanceMode tr').each(function () {
            var row = $(this), atid = row.data('assettypeid');
            row.find('.alert-frequency').val(defs[atid] || '');
            restoreRadio(row, 'mm-freq-unit-radio', 'Hours', '');
        });
    }

    function fnBindMaintenanceModeAppConfig($this) {
        var zoneId = $($this).val();
        if (zoneId && zoneId !== '0' && zoneId !== '') {
            isMaintenanceModeLoading = true;
            $('#loader').show();
            loadColumn('tbodyMaintenanceMode',
                'MaintenanceMode', 'MaintenanceModeFreqUnit',
                null, 'alert-frequency', 'mm-freq-unit-radio',
                zoneId, function () { isMaintenanceModeLoading = false; $('#loader').hide(); });
        } else {
            $('#tbodyMaintenanceMode tr').each(function () {
                var row = $(this);
                row.find('.alert-frequency').val('').attr('data-id', '');
                resetRadios(row);
            });
        }
    }

    function fnUpdateMaintenanceModeScal() {
        var pid = $('#chkMaintenanceModeScal').attr('data-id');
        var d = [{ Id: pid ? parseInt(pid) : null, AppKey: 'MaintenanceModeType',
                   GroupName: 'MaintenanceMode',
                   AppValue: $('#chkMaintenanceModeScal').is(':checked') ? 'Minute' : 'Hour' }];
        $('#loader').show();
        $.ajax({
            url: '@Url.Action("Save","Configuration",new{area="FRS25"})',
            type: 'POST', contentType: 'application/json', data: JSON.stringify(d),
            success: function (r) { $('#loader').hide(); if (r.type !== 'success') alert('Error: ' + r.Message); },
            error: function (x, s, e) { $('#loader').hide(); alert('Error: ' + e); }
        });
    }

    function fnBindMaintenanceModeScal() {
        $.ajax({
            url: '/FRS25/Configuration/GetAppConfigKeyByGroup', type: 'POST', contentType: 'application/json',
            data: '{GroupName:"MaintenanceMode",appKey:"MaintenanceModeType"}',
            success: function (r) {
                if (r && r.Id > 0)
                    $('#chkMaintenanceModeScal').prop('checked', r.AppValue === 'Minute').attr('data-id', r.Id);
            }
        });
    }
    // #endregion

    // ═══════════════════════════════════════════════════════════════
    // #region FEEDBACK DURATION  (Failure unit + Predictive unit)
    // ═══════════════════════════════════════════════════════════════

    function pushFeedbackRows(tbodyId, appKey, userClassId, zoneId, out) {
        $('#' + tbodyId + ' tr').each(function () {
            var row  = $(this), atid = row.data('assettypeid');
            var fv   = row.find('.failure-alert-frequency').val();
            var pv   = row.find('.predictive-alert-frequency').val();
            var fid  = row.find('.failure-alert-frequency').attr('data-id');
            var pid  = row.find('.predictive-alert-frequency').attr('data-id');
            var fu   = getRadioUnit(row, 'failure-unit-radio');
            var pu   = getRadioUnit(row, 'predictive-unit-radio');
            if (!atid) return;
            if (fv !== null && fv !== '') {
                out.push({ Id: fid ? parseInt(fid) : null, AssetTypeId: atid, AppKey: appKey,
                    GroupName: 'FeedbackDuration', AppValue: parseInt(fv),
                    AlertInfoId: alertFail, UserClassId: userClassId, ZoneId: parseInt(zoneId) });
                out.push({ Id: fu.unitId ? parseInt(fu.unitId) : null, AssetTypeId: atid,
                    AppKey: appKey + 'FailureUnit', GroupName: 'FeedbackDuration',
                    AppValue: fu.unit, AlertInfoId: alertFail, UserClassId: userClassId, ZoneId: parseInt(zoneId) });
            }
            if (pv !== null && pv !== '') {
                out.push({ Id: pid ? parseInt(pid) : null, AssetTypeId: atid, AppKey: appKey,
                    GroupName: 'FeedbackDuration', AppValue: parseInt(pv),
                    AlertInfoId: alertPredictive, UserClassId: userClassId, ZoneId: parseInt(zoneId) });
                out.push({ Id: pu.unitId ? parseInt(pu.unitId) : null, AssetTypeId: atid,
                    AppKey: appKey + 'PredictiveUnit', GroupName: 'FeedbackDuration',
                    AppValue: pu.unit, AlertInfoId: alertPredictive, UserClassId: userClassId, ZoneId: parseInt(zoneId) });
            }
        });
    }

    function fnSaveFeedback() {
        if (isFeedbackLoading) { alert('Please wait, data is still loading...'); return; }
        var zoneId = $('#drpFeedbackZone').val();
        if (!zoneId || zoneId === '') { alert('Please select a Zone'); return; }
        var data = [];
        pushFeedbackRows('tbodyMaintainerFeedback', 'MaintainerFeedback', userClassESM,   zoneId, data);
        pushFeedbackRows('tbodyVendorFeedback',     'VendorFeedback',     userClasse7Con,  zoneId, data);
        pushFeedbackRows('tbodyJESSEFeedback',      'JESSEFeedback',      userClassJE,     zoneId, data);
        if (!data.length) { alert('No data to save'); return; }
        $('#loader').show();
        $.ajax({
            url: '@Url.Action("Save","Configuration",new{area="FRS25"})',
            type: 'POST', contentType: 'application/json', data: JSON.stringify(data),
            success: function (r) {
                $('#loader').hide();
                if (r.type === 'success') { alert('Feedback Duration saved successfully'); fnBindFeedbackAppConfig($('#drpFeedbackZone')); }
                else alert('Error: ' + r.Message);
            },
            error: function (x, s, e) { $('#loader').hide(); alert('Error: ' + e); }
        });
    }

    function fnSetDefaultFeedback() {
        var md = {1:[4,12],2:[4,12],3:[4,12],34:[2,12]};
        var vd = {1:[24,48],2:[24,48],3:[24,48],34:[12,24]};
        var jd = {1:[48,72],2:[48,72],3:[48,72],34:[24,48]};
        function applyTable(tbodyId, defs) {
            $('#' + tbodyId + ' tr').each(function () {
                var row = $(this), v = defs[row.data('assettypeid')] || ['',''];
                row.find('.failure-alert-frequency').val(v[0]);
                row.find('.predictive-alert-frequency').val(v[1]);
                restoreRadio(row, 'failure-unit-radio',    'Hours', '');
                restoreRadio(row, 'predictive-unit-radio', 'Hours', '');
            });
        }
        applyTable('tbodyMaintainerFeedback', md);
        applyTable('tbodyVendorFeedback', vd);
        applyTable('tbodyJESSEFeedback', jd);
    }

    /** Bind one feedback table: 4 AJAX calls (values, failUnit, predUnit) */
    function bindFeedbackTable(tbodyId, appKey, zoneId, onDone) {
        var done = 0;
        function tick() { if (++done >= 3 && onDone) onDone(); }

        // Values (both alert types)
        $.ajax({
            url: '/FRS25/Configuration/GetAppConfig', type: 'POST', contentType: 'application/json',
            data: '{zoneId:' + zoneId + ',appKey:"' + appKey + '"}',
            success: function (resp) {
                $('#' + tbodyId + ' tr').each(function () {
                    var row = $(this), atid = row.data('assettypeid');
                    var fi = resp && resp.length ? resp.filter(function (a) { return a.AssetTypeId == atid && a.AlertInfoId == alertFail; })[0] : null;
                    var pi = resp && resp.length ? resp.filter(function (a) { return a.AssetTypeId == atid && a.AlertInfoId == alertPredictive; })[0] : null;
                    row.find('.failure-alert-frequency').val(fi ? fi.AppValue : '').attr('data-id', fi ? fi.Id : '');
                    row.find('.predictive-alert-frequency').val(pi ? pi.AppValue : '').attr('data-id', pi ? pi.Id : '');
                });
            },
            complete: tick
        });

        // Failure unit radios
        $.ajax({
            url: '/FRS25/Configuration/GetAppConfig', type: 'POST', contentType: 'application/json',
            data: '{zoneId:' + zoneId + ',appKey:"' + appKey + 'FailureUnit"}',
            success: function (resp) {
                $('#' + tbodyId + ' tr').each(function () {
                    var row = $(this), atid = row.data('assettypeid');
                    var m = resp && resp.length ? resp.filter(function (a) { return a.AssetTypeId == atid; })[0] : null;
                    restoreRadio(row, 'failure-unit-radio', m ? m.AppValue : 'Hours', m ? m.Id : '');
                });
            },
            complete: tick
        });

        // Predictive unit radios
        $.ajax({
            url: '/FRS25/Configuration/GetAppConfig', type: 'POST', contentType: 'application/json',
            data: '{zoneId:' + zoneId + ',appKey:"' + appKey + 'PredictiveUnit"}',
            success: function (resp) {
                $('#' + tbodyId + ' tr').each(function () {
                    var row = $(this), atid = row.data('assettypeid');
                    var m = resp && resp.length ? resp.filter(function (a) { return a.AssetTypeId == atid; })[0] : null;
                    restoreRadio(row, 'predictive-unit-radio', m ? m.AppValue : 'Hours', m ? m.Id : '');
                });
            },
            complete: tick
        });
    }

    function fnBindFeedbackAppConfig($this) {
        var zoneId = $($this).val();
        if (zoneId && zoneId !== '0' && zoneId !== '') {
            isFeedbackLoading = true;
            $('#loader').show();
            var done = 0;
            function onTable() { if (++done >= 3) { isFeedbackLoading = false; $('#loader').hide(); } }
            bindFeedbackTable('tbodyMaintainerFeedback', 'MaintainerFeedback', zoneId, onTable);
            bindFeedbackTable('tbodyVendorFeedback',     'VendorFeedback',     zoneId, onTable);
            bindFeedbackTable('tbodyJESSEFeedback',      'JESSEFeedback',      zoneId, onTable);
        } else {
            $('#tbodyMaintainerFeedback tr,#tbodyVendorFeedback tr,#tbodyJESSEFeedback tr').each(function () {
                var row = $(this);
                row.find('.failure-alert-frequency,.predictive-alert-frequency').val('').attr('data-id', '');
                resetRadios(row);
            });
        }
    }

    function fnBindFeedbackScal() { /* toggle removed – stub so onclick doesn't throw */ }
    // #endregion

    // ═══════════════════════════════════════════════════════════════
    // #region HIERARCHY ALERTS  (Failure unit + Predictive unit)
    // ═══════════════════════════════════════════════════════════════

    function pushHierarchyRows(tbodyId, appKey, userClassId, zoneId, out) {
        $('#' + tbodyId + ' tr').each(function () {
            var row  = $(this), atid = row.data('assettypeid');
            var fv   = row.find('.failure-alert-frequency').val();
            var pv   = row.find('.predictive-alert-frequency').val();
            var fid  = row.find('.failure-alert-frequency').attr('data-id');
            var pid  = row.find('.predictive-alert-frequency').attr('data-id');
            var fu   = getRadioUnit(row, 'failure-unit-radio');
            var pu   = getRadioUnit(row, 'predictive-unit-radio');
            if (!atid) return;
            if (fv !== null && fv !== '') {
                out.push({ Id: fid ? parseInt(fid) : null, AssetTypeId: atid, AppKey: appKey,
                    GroupName: 'HierarchyAlert', AppValue: parseInt(fv),
                    AlertInfoId: alertFail, UserClassId: userClassId, ZoneId: parseInt(zoneId) });
                out.push({ Id: fu.unitId ? parseInt(fu.unitId) : null, AssetTypeId: atid,
                    AppKey: appKey + 'FailureUnit', GroupName: 'HierarchyAlert',
                    AppValue: fu.unit, AlertInfoId: alertFail, UserClassId: userClassId, ZoneId: parseInt(zoneId) });
            }
            if (pv !== null && pv !== '') {
                out.push({ Id: pid ? parseInt(pid) : null, AssetTypeId: atid, AppKey: appKey,
                    GroupName: 'HierarchyAlert', AppValue: parseInt(pv),
                    AlertInfoId: alertPredictive, UserClassId: userClassId, ZoneId: parseInt(zoneId) });
                out.push({ Id: pu.unitId ? parseInt(pu.unitId) : null, AssetTypeId: atid,
                    AppKey: appKey + 'PredictiveUnit', GroupName: 'HierarchyAlert',
                    AppValue: pu.unit, AlertInfoId: alertPredictive, UserClassId: userClassId, ZoneId: parseInt(zoneId) });
            }
        });
    }

    function fnSaveHierarchy() {
        if (isHierarchyLoading) { alert('Please wait, data is still loading...'); return; }
        var zoneId = $('#drpHierarchyZone').val();
        if (!zoneId || zoneId === '') { alert('Please select a Zone'); return; }
        var data = [];
        pushHierarchyRows('tbodyJESELevel',     'HierarchyJESE',     userClassJE,       zoneId, data);
        pushHierarchyRows('tbodySSELevel',      'HierarchySSE',      userClassSSECSI,   zoneId, data);
        pushHierarchyRows('tbodyASTEDSTELevel', 'HierarchyASTEDSTE', userClassASTEDSTE, zoneId, data);
        pushHierarchyRows('tbodyESMLevel',      'HierarchyESM',      userClassESM,      zoneId, data);

        $('.hierarchy-alerts-input').each(function () {
            var inp = $(this), key = inp.attr('data-key'), v = inp.val(), id = inp.attr('data-id'), uc = inp.attr('data-userClassId');
            if (key && v !== null && v !== '')
                data.push({ Id: id ? parseInt(id) : null, AssetTypeId: null, AppKey: key,
                    UserClassId: uc, GroupName: 'HierarchyAlert', AppValue: parseInt(v), ZoneId: parseInt(zoneId) });
        });

        if (!data.length) { alert('No data to save'); return; }
        $('#loader').show();
        $.ajax({
            url: '@Url.Action("Save","Configuration",new{area="FRS25"})',
            type: 'POST', contentType: 'application/json', data: JSON.stringify(data),
            success: function (r) {
                $('#loader').hide();
                if (r.type === 'success') { alert('Hierarchy Alerts saved successfully'); fnBindHierarchyAppConfig($('#drpHierarchyZone')); }
                else alert('Error: ' + r.Message);
            },
            error: function (x, s, e) { $('#loader').hide(); alert('Error: ' + e); }
        });
    }

    function fnSetDefaultHierarchy() {
        var defs = {
            tbodyJESELevel:     {1:[4,18], 2:[4,18], 3:[3,18], 34:[1,18]},
            tbodySSELevel:      {1:[8,24], 2:[8,24], 3:[6,24], 34:[1,24]},
            tbodyASTEDSTELevel: {1:[12,36],2:[12,36],3:[9,36], 34:[2,36]},
            tbodyESMLevel:      {1:[3,12], 2:[3,12], 3:[2,12], 34:[1,12]}
        };
        $.each(defs, function (tbodyId, tbl) {
            $('#' + tbodyId + ' tr').each(function () {
                var row = $(this), v = tbl[row.data('assettypeid')] || ['',''];
                row.find('.failure-alert-frequency').val(v[0]);
                row.find('.predictive-alert-frequency').val(v[1]);
                restoreRadio(row, 'failure-unit-radio',    'Hours', '');
                restoreRadio(row, 'predictive-unit-radio', 'Hours', '');
            });
        });
        $('#esm_alert_days').val('0'); $('#je_alert_days').val('30');
        $('#sse_alert_days').val('60'); $('#aste_alert_days').val('120');
    }

    /** Bind one hierarchy table: values + failure unit + predictive unit */
    function bindHierarchyTable(tbodyId, appKey, zoneId, onDone) {
        var done = 0;
        function tick() { if (++done >= 3 && onDone) onDone(); }

        $.ajax({
            url: '/FRS25/Configuration/GetAppConfig', type: 'POST', contentType: 'application/json',
            data: '{zoneId:' + zoneId + ',appKey:"' + appKey + '"}',
            success: function (resp) {
                $('#' + tbodyId + ' tr').each(function () {
                    var row = $(this), atid = row.data('assettypeid');
                    var fi = resp && resp.length ? resp.filter(function (a) { return a.AssetTypeId == atid && a.AlertInfoId == alertFail; })[0] : null;
                    var pi = resp && resp.length ? resp.filter(function (a) { return a.AssetTypeId == atid && a.AlertInfoId == alertPredictive; })[0] : null;
                    row.find('.failure-alert-frequency').val(fi ? fi.AppValue : '').attr('data-id', fi ? fi.Id : '');
                    row.find('.predictive-alert-frequency').val(pi ? pi.AppValue : '').attr('data-id', pi ? pi.Id : '');
                });
            },
            complete: tick
        });

        $.ajax({
            url: '/FRS25/Configuration/GetAppConfig', type: 'POST', contentType: 'application/json',
            data: '{zoneId:' + zoneId + ',appKey:"' + appKey + 'FailureUnit"}',
            success: function (resp) {
                $('#' + tbodyId + ' tr').each(function () {
                    var row = $(this), atid = row.data('assettypeid');
                    var m = resp && resp.length ? resp.filter(function (a) { return a.AssetTypeId == atid; })[0] : null;
                    restoreRadio(row, 'failure-unit-radio', m ? m.AppValue : 'Hours', m ? m.Id : '');
                });
            },
            complete: tick
        });

        $.ajax({
            url: '/FRS25/Configuration/GetAppConfig', type: 'POST', contentType: 'application/json',
            data: '{zoneId:' + zoneId + ',appKey:"' + appKey + 'PredictiveUnit"}',
            success: function (resp) {
                $('#' + tbodyId + ' tr').each(function () {
                    var row = $(this), atid = row.data('assettypeid');
                    var m = resp && resp.length ? resp.filter(function (a) { return a.AssetTypeId == atid; })[0] : null;
                    restoreRadio(row, 'predictive-unit-radio', m ? m.AppValue : 'Hours', m ? m.Id : '');
                });
            },
            complete: tick
        });
    }

    function fnBindHierarchyAppConfig($this) {
        var zoneId = $($this).val();
        if (zoneId && zoneId !== '0' && zoneId !== '') {
            isHierarchyLoading = true;
            $('#loader').show();
            var done = 0;
            function onTable() { if (++done >= 5) { isHierarchyLoading = false; $('#loader').hide(); } }

            bindHierarchyTable('tbodyJESELevel',     'HierarchyJESE',     zoneId, onTable);
            bindHierarchyTable('tbodySSELevel',      'HierarchySSE',      zoneId, onTable);
            bindHierarchyTable('tbodyASTEDSTELevel', 'HierarchyASTEDSTE', zoneId, onTable);
            bindHierarchyTable('tbodyESMLevel',      'HierarchyESM',      zoneId, onTable);

            // First Alert Delay inputs (separate endpoint)
            $.ajax({
                url: '/FRS25/Configuration/GetAppConfigByGroupName', type: 'POST', contentType: 'application/json',
                data: '{zoneId:' + zoneId + ',groupName:"HierarchyAlert"}',
                success: function (resp) {
                    $('.hierarchy-alerts-input').val('').attr('data-id', '');
                    if (resp && resp.length)
                        resp.forEach(function (item) {
                            var inp = $('.hierarchy-alerts-input[data-key="' + item.AppKey + '"]');
                            if (inp.length) inp.val(item.AppValue).attr('data-id', item.Id);
                        });
                },
                error: function (x, s, e) { alert('Error loading hierarchy delays: ' + e); },
                complete: onTable
            });
        } else {
            $('#tbodyJESELevel tr,#tbodySSELevel tr,#tbodyASTEDSTELevel tr,#tbodyESMLevel tr').each(function () {
                var row = $(this);
                row.find('.failure-alert-frequency,.predictive-alert-frequency').val('').attr('data-id', '');
                resetRadios(row);
            });
            $('.hierarchy-alerts-input').val('').attr('data-id', '');
        }
    }

    function fnUpdateHierarchyScal() {
        var pid = $('#chkHierarchyScal').attr('data-id');
        var d = [{ Id: pid ? parseInt(pid) : null, AppKey: 'MaintainerHierarchyType',
                   GroupName: 'HierarchyAlert',
                   AppValue: $('#chkHierarchyScal').is(':checked') ? 'Minute' : 'Hour' }];
        $('#loader').show();
        $.ajax({
            url: '@Url.Action("Save","Configuration",new{area="FRS25"})',
            type: 'POST', contentType: 'application/json', data: JSON.stringify(d),
            success: function (r) { $('#loader').hide(); if (r.type !== 'success') alert('Error: ' + r.Message); },
            error: function (x, s, e) { $('#loader').hide(); alert('Error: ' + e); }
        });
    }

    function fnBindHierarchyScal() {
        $.ajax({
            url: '/FRS25/Configuration/GetAppConfigKeyByGroup', type: 'POST', contentType: 'application/json',
            data: '{GroupName:"HierarchyAlert",appKey:"MaintainerHierarchyType"}',
            success: function (r) {
                if (r && r.Id > 0)
                    $('#chkHierarchyScal').prop('checked', r.AppValue === 'Minute').attr('data-id', r.Id);
            }
        });
    }
    // #endregion

    // ═══════════════════════════════════════════════════════════════
    // #region SYSTEM PARAMETERS  (unchanged)
    // ═══════════════════════════════════════════════════════════════
    function fnSaveSystemParams() {
        if (isSystemParamsLoading) { alert('Please wait, data is still loading...'); return; }
        var zoneId = $('#drpSystemParamsZone').val();
        if (!zoneId || zoneId === '') { alert('Please select a Zone'); return; }
        var data = [];
        $('.system-param-input').each(function () {
            var inp = $(this), key = inp.attr('data-key'), val = inp.val(), id = inp.attr('data-id');
            if (key && val !== null && val !== '')
                data.push({ Id: id ? parseInt(id) : null, AssetTypeId: null,
                    AppKey: key, GroupName: 'SystemParameter', AppValue: parseInt(val), ZoneId: parseInt(zoneId) });
        });
        if (!data.length) { alert('No data to save'); return; }
        $('#loader').show();
        $.ajax({
            url: '@Url.Action("Save","Configuration",new{area="FRS25"})',
            type: 'POST', contentType: 'application/json', data: JSON.stringify(data),
            success: function (r) {
                $('#loader').hide();
                if (r.type === 'success') { alert('System Parameters saved successfully'); $('#drpSystemParamsZone').val('').trigger('change'); }
                else alert('Error: ' + r.Message);
            },
            error: function (x, s, e) { $('#loader').hide(); alert('Error: ' + e); }
        });
    }

    function fnSetDefaultSystemParams() {
        $('#avg_param_days').val('15'); $('#time_sync_freq').val('7');
        $('#info_req_freq').val('30'); $('#image_req_freq').val('7'); $('#event_update_time').val('60');
    }

    function fnBindSystemParamsAppConfig($this) {
        var zoneId = $($this).val();
        if (zoneId && zoneId !== '0' && zoneId !== '') {
            isSystemParamsLoading = true; $('#loader').show();
            $.ajax({
                url: '/FRS25/Configuration/GetAppConfigByGroupName', type: 'POST', contentType: 'application/json',
                data: '{zoneId:' + zoneId + ',groupName:"SystemParameter"}',
                success: function (resp) {
                    $('.system-param-input').val('').attr('data-id', '');
                    if (resp && resp.length)
                        resp.forEach(function (item) {
                            var inp = $('.system-param-input[data-key="' + item.AppKey + '"]');
                            if (inp.length) inp.val(item.AppValue).attr('data-id', item.Id);
                        });
                },
                error: function (x, s, e) { alert('Error loading: ' + e); },
                complete: function () { isSystemParamsLoading = false; $('#loader').hide(); }
            });
        } else { $('.system-param-input').val('').attr('data-id', ''); }
    }
    // #endregion

    // ═══════════════════════════════════════════════════════════════
    // #region LOGIN & SECURITY  (unchanged)
    // ═══════════════════════════════════════════════════════════════
    function fnSaveSecurity() {
        if (isSecurityLoading) { alert('Please wait, data is still loading...'); return; }
        var data = [];
        $('.security-param-input').each(function () {
            var inp = $(this), key = inp.attr('data-key'), val = inp.val(), id = inp.attr('data-id');
            if (key && val !== null && val !== '')
                data.push({ Id: id ? parseInt(id) : null, AssetTypeId: null,
                    AppKey: key, GroupName: 'SecurityParams', AppValue: parseInt(val) });
        });
        $('.security-param-checkbox').each(function () {
            var inp = $(this), key = inp.attr('data-key'), id = inp.attr('data-id');
            if (key) data.push({ Id: id ? parseInt(id) : null, AssetTypeId: null,
                AppKey: key, AppValue: inp.is(':checked') ? 1 : 0, GroupName: 'SecurityParams' });
        });
        if (!data.length) { alert('No data to save'); return; }
        $('#loader').show();
        $.ajax({
            url: '@Url.Action("Save","Configuration",new{area="FRS25"})',
            type: 'POST', contentType: 'application/json', data: JSON.stringify(data),
            success: function (r) {
                $('#loader').hide();
                if (r.type === 'success') alert('Login & Security saved successfully');
                else alert('Error: ' + r.Message);
            },
            error: function (x, s, e) { $('#loader').hide(); alert('Error: ' + e); }
        });
    }

    function fnSetDefaultSecurity() {
        $('#otp_validity').val('5'); $('#max_otp_attempts').val('3'); $('#otp_resend_delay').val('60');
        $('#max_mobile_devices').val('1'); $('#max_desktop_devices').val('1'); $('#device_trust_days').val('90');
        $('#session_timeout').val('30'); $('#max_session_duration').val('12');
        $('#concurrent_sessions').prop('checked', true); $('#force_logout_new').prop('checked', true);
    }

    function fnBindSecurityAppConfig() {
        $.ajax({
            url: '/FRS25/Configuration/GetAppConfigByGroup', type: 'POST', contentType: 'application/json',
            data: '{groupName:"SecurityParams"}',
            success: function (resp) {
                $('.security-param-input').val('').attr('data-id', '');
                $('.security-param-checkbox').prop('checked', false).attr('data-id', '');
                if (resp && resp.length)
                    resp.forEach(function (item) {
                        var inp = $('.security-param-input[data-key="' + item.AppKey + '"]');
                        var chk = $('.security-param-checkbox[data-key="' + item.AppKey + '"]');
                        if (inp.length) inp.val(item.AppValue).attr('data-id', item.Id);
                        if (chk.length) chk.prop('checked', item.AppValue == 1).attr('data-id', item.Id);
                    });
            },
            error: function (x, s, e) { alert('Error loading: ' + e); },
            complete: function () { isSecurityLoading = false; $('#loader').hide(); }
        });
    }
    // #endregion
</script>
