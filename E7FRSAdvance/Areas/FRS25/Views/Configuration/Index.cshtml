                                                        <tr><td><strong>JE (Junior Engineer)</strong></td><td>Station Level</td><td>❌</td><td>✅</td><td>✅</td><td>✅</td><td>Full Access + Feedback Modification</td></tr>
                                                        <tr><td><strong>SSE (Senior Section Engineer)</strong></td><td>Section Level</td><td>❌</td><td>✅</td><td>✅</td><td>✅</td><td>Full Access + Feedback Modification</td></tr>
