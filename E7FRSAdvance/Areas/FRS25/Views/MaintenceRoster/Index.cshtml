#dm button:disabled { cursor:wait; opacity:.55; }
#dm button:focus-visible, #dm a:focus-visible, #dm input:focus-visible, #dm select:focus-visible { outline:3px solid #4396ed; outline-offset:3px; }
#dm .dm-top { background:var(--navy); color:white; padding:20px 28px; display:flex; align-items:center; justify-content:space-between; gap:18px; flex-wrap:wrap; }
#dm .dm-brand { display:flex; align-items:center; gap:14px; }
