    <div class="dm-field"><label for="dmStation">Station</label><select id="dmStation"><option value="all">All stations</option></select></div>
    <div class="dm-field"><label for="dmFamily">Asset type</label><select id="dmFamily"><option value="all">All asset types</option><option value="Point">Point machine</option><option value="Track">Track</option><option value="Signal">Signal</option><option value="IPS">IPS</option></select></div>
    <div class="dm-field"><label for="dmSort">Sort by</label><select id="dmSort"><option value="priority">Priority first</option><option value="drift">Average drift</option><option value="alerts">Alerts</option><option value="station">Station name</option></select></div>

   </div>
   <div class="dm-filter-line"><button type="button" class="dm-btn" id="dmClearFilters">Clear filters</button><span id="dmResultCount">No division loaded</span><span id="dmEvidencePeriod" hidden></span></div>
   <div class="dm-table-wrap"><table aria-label="Maintenance assets"><thead><tr><th scope="col">S.No.</th><th scope="col">Asset / Station</th><th scope="col">Maintenance reason</th><th scope="col">PM ops &#183; 7d</th><th scope="col">Avg drift</th><th scope="col">Priority</th><th scope="col">Maintenance status</th><th scope="col">Actions</th></tr></thead><tbody id="dmRows"></tbody></table></div>
   <div class="dm-empty" id="dmEmpty"><strong>Your division roster will appear here</strong><p>Choose a division above to load its stations and assets.</p></div>
   <div class="dm-pagination"><span id="dmPageInfo">15 assets per page</span><div class="dm-page-buttons"><button class="dm-btn" id="dmPrev" type="button" disabled>&#8592; Previous</button><span id="dmPage">1 / 1</span><button class="dm-btn" id="dmNext" type="button" disabled>Next &#8594;</button></div></div>
  </section>
  <section class="dm-panel" data-views="outcomes" aria-labelledby="dmOutTitle">
   <div class="dm-ph"><div><h2 id="dmOutTitle">Recorded outcomes</h2><p>What the visit found, asset by asset</p></div></div>
