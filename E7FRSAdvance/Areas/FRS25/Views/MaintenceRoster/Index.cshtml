    function rosSelAsset(gi){ rosCur=gi; rosType=ROS_ITEMS[gi].fam; rosTab=0; rosDaySel=-1; rosAlIdx=0; rosRenderTypes(); rosRenderAssets(); rosRenderDetail(); }

