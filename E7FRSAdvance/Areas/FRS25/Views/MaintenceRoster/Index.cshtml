@@media(max-width:550px) { #dm .dm-live-grid { grid-template-columns:1fr; } #dm .dm-timeline { grid-template-columns:85px 1fr; } #dm .dm-timeline > span { grid-column:2; } #dm .dm-detail-tabs { padding:8px 17px 0; } }
