#dm .dm-filter-line { padding:10px 20px; display:flex; gap:10px; justify-content:space-between; align-items:center; font-size:13px; color:var(--muted); border-bottom:1px solid var(--line); flex-wrap:wrap; }
#dm .dm-table-wrap { overflow-x:auto; }
#dm table { border-collapse:collapse; width:100%; font-size:14px; margin:0; text-align:left; }
#dm th { padding:12px 16px; font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:#52677d; background:#f5f8fc; white-space:nowrap; }
#dm td { padding:16px; border-top:1px solid #e8eef5; vertical-align:middle; }
#dm tr:hover td { background:#f8fbff; }
#dm td strong { display:block; font-size:15px; color:var(--navy); }
#dm td small { display:block; font-size:13px; color:var(--muted); margin-top:3px; }
#dm td .dm-num { font-variant-numeric:tabular-nums; font-weight:600; white-space:nowrap; }
#dm td.dm-reason { max-width:330px; }
#dm .dm-pill { display:inline-flex; border-radius:5px; padding:4px 8px; font-size:12px; font-weight:700; background:#eef2f7; color:#52657a; white-space:normal; }
#dm .dm-pill.urgent { background:#ffebee; color:#a12937; }
#dm .dm-pill.soon { background:#fff3d9; color:#865610; }
#dm .dm-pill.preventive { background:#e6f5f2; color:#116d60; }
#dm .dm-pill.corrective { background:#fff0f1; color:#a23640; }
#dm .dm-empty { text-align:center; padding:42px 22px; color:var(--muted); }
#dm .dm-empty strong { display:block; color:var(--ink); font-size:18px; margin-bottom:7px; }
#dm .dm-empty p { font-size:14px; }
#dm .dm-pagination { display:flex; justify-content:space-between; gap:14px; align-items:center; padding:16px 20px; border-top:1px solid var(--line); font-size:14px; color:var(--muted); flex-wrap:wrap; }
#dm .dm-page-buttons { display:flex; gap:10px; align-items:center; }
#dm .dm-footer { font-size:12px; color:var(--muted); padding-top:18px; display:flex; flex-wrap:wrap; justify-content:space-between; gap:10px; }
#dm .dm-dialog { border:0; border-radius:14px; padding:0; color:var(--ink); background:white; width:min(690px,calc(100% - 28px)); max-height:90vh; box-shadow:0 25px 90px #0a1d3c55; }
#dm .dm-dialog::backdrop { background:#10263d88; }
