#dm .dm-top a { color:#e3efff; text-decoration:none; font-size:14px; border:1px solid #60778f; border-radius:7px; padding:8px 12px; }
#dm .dm-main { padding:26px 28px; }
#dm .dm-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; margin-bottom:22px; }
#dm .dm-eyebrow { font-size:12px; letter-spacing:.1em; text-transform:uppercase; font-weight:700; color:var(--muted); margin:0 0 6px; }
#dm h1 { font-size:clamp(25px,2.7vw,34px); line-height:1.2; letter-spacing:-.8px; margin:0; font-weight:700; color:var(--navy); }
#dm h2 { font-size:19px; line-height:1.35; margin:0; color:inherit; }
#dm h3 { font-size:16px; margin:0 0 8px; }
#dm p { margin:0; }
#dm .dm-sub { color:var(--muted); font-size:14px; margin-top:9px; }
#dm .dm-btn { display:inline-flex; justify-content:center; align-items:center; gap:7px; border:1px solid #c6d3e1; border-radius:8px; background:white; color:var(--ink); padding:9px 14px; min-height:42px; text-decoration:none; font-size:14px; font-weight:600; white-space:normal; }
#dm .dm-btn:hover { background:#eaf1fa; }
#dm .dm-primary { background:var(--blue); color:#fff; border-color:var(--blue); }
#dm .dm-primary:hover { background:#164897; }
#dm .dm-toolbar { display:flex; gap:14px; flex-wrap:wrap; padding:18px; background:white; border:1px solid var(--line); border-radius:12px; align-items:flex-end; }
#dm .dm-field { display:flex; flex-direction:column; gap:6px; min-width:155px; flex:1; }
#dm .dm-field label { font-size:14px; font-weight:600; color:#435971; }
#dm .dm-field input, #dm .dm-field select { border:1px solid #c6d3e1; background:white; border-radius:7px; padding:9px 11px; min-height:43px; min-width:0; width:100%; color:var(--ink); font-size:14px; }
#dm .dm-message { margin:15px 0; padding:12px 15px; border:1px solid #b8cfeb; border-radius:9px; background:#e9f2ff; color:#284c75; font-size:14px; }
#dm .dm-message.error { background:#fff0f1; border-color:#efc0c4; color:#8c2833; }
#dm .dm-message.warn { background:#fff8e8; border-color:#efd6a6; color:#735022; }
#dm [hidden] { display:none !important; }
#dm .dm-run { display:flex; flex-wrap:wrap; gap:6px 18px; margin:14px 2px; font-size:13px; color:var(--muted); }
#dm .dm-summary { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; margin:20px 0; }
#dm .dm-stat { border:1px solid var(--line); border-radius:11px; background:#fff; padding:17px 18px; text-align:left; color:var(--ink); min-width:0; }
#dm button.dm-stat:hover { border-color:#749ac7; }
