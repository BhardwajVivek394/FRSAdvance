        return 'DIVISION ROSTER for '+rosState.date+'. '+rosDivData.length+' assets across the division, SORTED BY ALERT COUNT ('+urg+' urgent, '+soon+' soon). TOP BY ALERT COUNT: '+lines.join('; ')+'. '; }
