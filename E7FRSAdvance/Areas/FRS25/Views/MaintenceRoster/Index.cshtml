    function rosPmLoad(it){ var aid=rosF(it,['AssetId','assetId'],0), sid=rosF(it,['SiteId','siteId'],0);
        if(!ROS.pm||!aid||rosPmCache[aid]||rosPmBusy[aid]){ return; } rosPmBusy[aid]=true;
        rosGet(ROS.pm+'?assetId='+encodeURIComponent(aid)+'&siteId='+encodeURIComponent(sid)).then(function(j){
