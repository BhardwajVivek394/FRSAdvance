                'Check the ballast sits clear of the rail foot \u2014 the 50 mm clearance matters more than it looks.',
                'Check drainage: water standing in the cess or between sleepers is the usual culprit.',
                'Take one reading in dry weather and one in wet \u2014 decide from the pair, not one number.'])
              +'<div class="evimeta" style="margin-top:9px">IRSEM 17.1.2, 17.2.5 \u00b7 ballast clearance / drainage, resistance minima (TRK-014 weather, TRK-013 stray DC).</div>' },
            { t:'If it is ignored', art:'stop', ac:'var(--urgent)', body:'<div class="rslead">Every monsoon shower will drop this track circuit.</div>'
              +'That means repeated failures, cautions and detentions all season. An hour of cleaning, clearance and drainage now buys a quiet monsoon.' } ]; }
        return rosStory(chs); }
    function rosPmFeat(f){ var m={'i_run':'running current up (load / friction)','end_rise':'end-of-stroke current up (obstruction / lock)','work':'more effort per throw (resistance)','i_trough':'mid-stroke dip changing (transmission)'}; return m[f]||f; }
    function rosPmPattern(st){ var r=st.rising||[]; if(!r.length){ return 'stable (no developing trend)'; }
        if(r.indexOf('end_rise')>=0){ return 'obstruction / friction building at the lock'; }
        if(r.indexOf('i_run')>=0&&r.indexOf('work')>=0){ return 'load rising across the throw (lubrication / alignment)'; }
        var out=[],i; for(i=0;i<r.length;i++){ out.push(rosPmFeat(r[i])); } return out.join('; '); }
    function rosPmStCls(s){ s=String(s||'').toUpperCase(); if(s==='URGENT'){ return 'URGENT'; } if(s==='MAINTAIN-SOON'||s==='SOON'){ return 'SOON'; } if(s==='WATCH'){ return 'WATCH'; } return 'OK'; }
    function rosPmAct(s){ s=String(s||'').toUpperCase(); if(s==='URGENT'){ return 'INSPECT NOW'; } if(s==='MAINTAIN-SOON'){ return 'INSPECT SOON'; } if(s==='WATCH'){ return 'KEEP WATCHING'; } return 'NO ACTION'; }
    function rosPmWorst(pm){ var rank={'URGENT':3,'MAINTAIN-SOON':2,'SOON':2,'WATCH':1}, worst='NORMAL', wr=0, ks=['a','b'], ds=['Normal','Reverse'], i, j;
        for(i=0;i<ks.length;i++){ var st=(pm[ks[i]]||{}).states||{}; for(j=0;j<ds.length;j++){ if(st[ds[j]]){ var s=String(st[ds[j]].state).toUpperCase(); var r=rank[s]||0; if(r>wr){ wr=r; worst=s; } } } }
        return worst; }
    function rosPmDirCard(dir,st){ var cls=rosPmStCls(st.state); var rows='', r=st.rising||[], i;
        for(i=0;i<r.length;i++){ rows+='<div class="rpmtrow"><span class="rpmup">\u25b2</span> '+rosEsc(rosPmFeat(r[i]))+'</div>'; }
