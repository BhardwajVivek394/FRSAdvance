    function rosVerdRing(pct,color){ var c=157, off=c*(1-Math.max(0,Math.min(100,pct))/100);
        return '<svg width="60" height="60"><circle cx="30" cy="30" r="25" fill="none" stroke="rgba(255,255,255,.12)" stroke-width="5"></circle>'
            +'<circle cx="30" cy="30" r="25" fill="none" stroke="'+color+'" stroke-width="5" stroke-dasharray="'+c+'" stroke-dashoffset="'+off.toFixed(1)+'" stroke-linecap="round"></circle></svg>'
            +'<span class="pct">'+(pct>0?Math.round(pct)+'%':'\u2014')+'</span>'; }
    function rosNum(v){ var n=Number(v); return isNaN(n)?String(v):(Math.round(n*100)/100); }
    function rosDiagBuild(o){ var it=o.it, e=o.e, tr=rosTrend(e).t;
        var ev={ cause:e.dominantCause, setHM:'', dur:null, idx:0, list:null };
        var w=rosAlWisdom(o,ev);
        var d={ cause:e.dominantCause, asset:rosF(it,['AssetName','assetName'],'Asset'),
                station:rosF(it,['StationName','stationName'],'')+(rosF(it,['SiteId','siteId'],'')!==''?(' \u00b7 '+rosF(it,['SiteId','siteId'],'')):''),
                incidence:(e.lastSet||''), cur:'numbers', wisdom:w };
        // reset / active banner
        d.resetHtml = e.activeNow
            ? '<div class="aireset act"><span class="pin">\u25CF</span> Active now \u2014 live condition on this asset.</div>'
            : '<div class="aireset rec"><span class="pin">\u25CF</span> Recovered'+(e.lastSet?(' \u00b7 last set <b>'+rosEsc(e.lastSet)+'</b>'):'')+' \u2014 a record of what happened, not a live fault.</div>';
        // numbers + how-the-value-moved from live readings (hero = out-of-band, else first)
        var lc=rosLiveCache[rosF(it,['AssetId','assetId'],0)]; var hero=null;
        if(lc&&lc.rows&&lc.rows.length){ for(var i=0;i<lc.rows.length;i++){ var r=lc.rows[i], st=String(r.state||'').toLowerCase();
            if(st==='low'||st==='high'){ hero=r; break; } } if(!hero){ hero=lc.rows[0]; } }
        if(hero){ var st=String(hero.state||'').toLowerCase();
            var lim=(st==='low'?hero.minSafe:(st==='high'?hero.maxSafe:hero.minSafe)); var avg=hero.avg;
            var pctTxt='', dp=null; if(avg!=null&&Number(avg)!==0){ dp=(hero.value-avg)/Math.abs(avg)*100; pctTxt=(Math.abs(Math.round(dp*10)/10))+'% '+(dp<0?'below':'above')+' the usual level'; }
            d.numbers={ big:(pctTxt||'Current reading'), nums:[[String(rosNum(hero.value)),rosEsc((hero.attr||'')+(hero.unit?(' '+hero.unit):'')),'hero'],
                        (lim!=null?[String(rosNum(lim)),'limit'+(hero.unit?(' '+hero.unit):''),'']:null),
                        (avg!=null?[String(rosNum(avg)),'normal'+(hero.unit?(' '+hero.unit):''),'']:null)].filter(Boolean),
                        cap:(w.what.replace(/<[^>]+>/g,'')) };
            if(avg!=null&&lim!=null){ var okv=(st!=='low'&&st!=='high'); var by=Math.abs(hero.value-lim); var pastPct=(lim!==0?(by/Math.abs(lim)*100):0);
                d.hvmHtml='<div class="sec aihvm"><div class="sh">How the value moved</div>'
                  +'<div class="row1"><span class="from">'+rosNum(avg)+'</span><span class="arr">\u2192</span><span class="to'+(okv?' ok':'')+'">'+rosNum(hero.value)+'</span>'
                  +'<span style="font:600 10px var(--mono);color:var(--ink3)">'+rosEsc(hero.attr||'')+'</span>'
                  +(dp!=null?'<span class="dp'+(okv?' ok':'')+'">'+(dp<0?'':'+')+(Math.round(dp*10)/10)+'%</span>':'')+'</div>'
                  +'<div class="sub">normal (resting) level \u2192 value at the alert</div>'
                  +(!okv?('<div class="limit">Limit <b>'+rosNum(lim)+(hero.unit?(' '+hero.unit):'')+'</b> breached by <b>'+rosNum(by)+'</b> ('+(Math.round(pastPct*10)/10)+'% past the limit)</div>'):'')
                  +'</div>'; }
            else { d.hvmHtml=''; }
        } else {
            d.numbers={ big:e.total+' alert'+(e.total===1?'':'s')+' in '+(e.windowDays||15)+' days',
                        nums:[[String(e.firstHalf),'first half','hero'],[String(e.secondHalf),'second half',''],[String(e.total),'total','']],
                        cap:'No live readings attached yet \u2014 open the Live tab for current values.' };
            d.hvmHtml=''; }
        // story tabs (what/why from wisdom; do from wisdom.move; sure filled by AI; hist/live from data)
        d.story={
            what:{ lab:'What happened', big:'What happened', body:'<p>'+w.what+'</p>' },
            numbers:d.numbers,
            why:{ lab:'Why', big:'Likely cause', body:'<p>'+w.cause+'</p>' },
            do:{ lab:'What to do', big:'What to do', body:'<p>'+(w.move&&w.move.length?w.move[0]:'Attend the asset and verify on site.')+'</p>' },
            sure:{ lab:'How sure', big:'How sure', body:'<p>Analysing the evidence \u2026</p>' },
            hist:{ lab:'Asset history', big:e.total+' alert'+(e.total===1?'':'s')+' in '+(e.windowDays||15)+' days',
                   body:'<p>Dominant cause <b>'+rosEsc(e.dominantCause)+'</b>, trend '+(tr==='degrading'?'worsening':(tr==='improving'?'settling':'flat'))+' ('+e.firstHalf+' \u2192 '+e.secondHalf+').'+(e.activeNow?' Active right now.':'')+'</p>' },
            live:{ lab:'Live data', big:'Live data', body:'<p>'+(lc&&lc.rows&&lc.rows.length?(lc.rows.length+' readings attached; '+(hero?('hero '+rosEsc(hero.attr||'')+' '+rosNum(hero.value)+(hero.unit?(' '+hero.unit):'')):'all in range')+'.'):'Opens on the Live tab for this asset.')+'</p>' }
        };
        d.order=['what','numbers','why','do','sure','hist','live'];
        // assessment (likely cause/category/action) -- wisdom now, AI overrides in rosFillAI
        d.asgHtml=rosAsgHtml('inc', w.cause.replace(/<[^>]+>/g,''), (w.move&&w.move.length?w.move[0]:''), '');
        // evidence
        var ev2='<div class="aiev"><div class="eh">Evidence</div>';
        if(lc&&lc.rows&&lc.rows.length){ for(var k=0;k<lc.rows.length&&k<4;k++){ var rr=lc.rows[k], s2=String(rr.state||'').toLowerCase();
            ev2+='<div class="er"><span class="kind">[record]</span> '+rosEsc(rr.attr||rr.attrId||'')+' <span class="chip'+(s2==='low'?' low':(s2==='high'?' high':''))+'">'+rosNum(rr.value)+(rr.unit?(' '+rosEsc(rr.unit)):'')+'</span>'
              +(rr.at?(' at <span class="mut">'+rosEsc(rr.at)+'</span>'):'')
              +((rr.minSafe!=null||rr.maxSafe!=null)?(' band <span class="mut">'+(rr.minSafe!=null?rosNum(rr.minSafe):'\u2013')+'\u2013'+(rr.maxSafe!=null?rosNum(rr.maxSafe):'\u2013')+'</span>'):'')+'</div>'; } }
        ev2+='<div class="er"><span class="kind">[fetched]</span> 15-day history <span class="chip">'+e.total+' alert'+(e.total===1?'':'s')+'</span> '+e.firstHalf+' \u2192 '+e.secondHalf+' \u00b7 '+rosEsc(e.dominantCause)+'</div>';
        ev2+='</div>'; d.evHtml=ev2;
        return d; }
    function rosAsgHtml(vc, likely, action, catText){
        var cat=catText||(vc==='yes'?'Real \u00b7 action needed':(vc==='no'?'Transient \u00b7 no action':'Needs eyes \u00b7 verify'));
