                +'<span><span class="ft" style="display:block">Defect confirmed</span><span class="fs" style="display:block">A real fault was found on site \u2014 flags the asset for repair follow-up.</span></span></button>'
              +'<button class="fcard non" onclick="rosClose('+id+',\'NO_DEFECT_FOUND\')">'
                +'<span class="fic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6"/><path d="M15 15 L20 20"/><path d="M8 10.5 L10 12.5 L13.5 8.5"/></svg></span>'
                +'<span><span class="ft" style="display:block">Nothing found</span><span class="fs" style="display:block">Checked on site, no defect visible \u2014 likely weather or data; stays watched.</span></span></button>'
              +'<button class="fcard wrk" onclick="rosClose('+id+',\'WORK_DONE\')">'
                +'<span class="fic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M14.5 6.5 a4.2 4.2 0 1 0 3 3 L21 6 L18 3 Z" /><path d="M12.5 11.5 L4.5 19.5 a1.6 1.6 0 0 0 2.3 2.3 L14 14"/></svg></span>'
                +'<span><span class="ft" style="display:block">Work done</span><span class="fs" style="display:block">Maintenance carried out \u2014 monitoring proves the repair held.</span></span></button>'
              +'</div>'; }
        else { var by=rosF(it,['ClosedByName','closedByName'],''); var at=String(rosF(it,['ClosedAtIst','closedAtIst'],'')).replace('T',' ').substring(0,16); acts+='<div class="rclosedby">'+rosEsc(close.replace(/_/g,' '))+(by?' by '+rosEsc(by):'')+(at?' \u00b7 '+rosEsc(at):'')+'</div>'; }
        acts+='</div>';
        host.innerHTML='<div class="rdetail">'+hd+band+'<div class="rtabs">'+rail+'</div><div class="rtabbody">'
            +rosTabBody(o)+rosTrkChart(o)+'</div>'+acts+'</div>';
        if(rosTab===2&&document.getElementById('rosStoryStage')){ rosStoryBoot(); }

        rosAlPopSync(); }

    /* ---------- track shorting: readings from major_events ----------
       Only for Track assets, and only when the predictor actually reported windows -- a
       point machine or a clean track gets nothing rather than an empty frame. The event
       objects are passed through from the API verbatim, so the series is DISCOVERED here
       instead of assuming a field name: any array of numbers on the event is a channel,
       and {t,v} / {time,value} pairs are unpacked. If the upstream renames its readings,
       the chart follows instead of going blank. */
    function rosTrkNums(v){
        if(!v||typeof v!=='object'||!v.length){ return null; }
        var out=[],i;
        for(i=0;i<v.length;i++){ var x=v[i];
            if(typeof x==='number'){ out.push(x); }
            else if(x&&typeof x==='object'){
                var n=(x.v!==undefined?x.v:(x.value!==undefined?x.value:(x.y!==undefined?x.y:null)));
                if(typeof n==='number'){ out.push(n); } else { return null; } }
            else { var f=Number(x); if(isNaN(f)){ return null; } out.push(f); } }
        return out.length>=2?out:null; }
    function rosTrkSeries(ev){ var out=[],k;
        if(!ev||typeof ev!=='object'){ return out; }
        for(k in ev){ if(!Object.prototype.hasOwnProperty.call(ev,k)){ continue; }
            var v=ev[k];
            var nums=rosTrkNums(v);
            if(nums){ out.push({ name:k, vals:nums }); continue; }
            if(v&&typeof v==='object'&&!v.length){       // readings:{ If:[..], Ir:[..] }
                var k2; for(k2 in v){ if(!Object.prototype.hasOwnProperty.call(v,k2)){ continue; }
                    var n2=rosTrkNums(v[k2]); if(n2){ out.push({ name:k2, vals:n2 }); } } } }
        return out; }
    function rosTrkPath(vals,w,hh){ var mn=Math.min.apply(null,vals), mx=Math.max.apply(null,vals);
        var sp=(mx-mn)||1, i, d='';
        for(i=0;i<vals.length;i++){ var x=(vals.length===1?0:(i/(vals.length-1)*w));
            var y=hh-((vals[i]-mn)/sp*(hh-6))-3;
            d+=(i?' L':'M')+x.toFixed(1)+' '+y.toFixed(1); }
        return d; }
    function rosTrkChart(o){
        if(String(o.fam||'').toLowerCase()!=='track'){ return ''; }
        var aid=rosF(o.it,['AssetId','assetId'],0), sid=rosF(o.it,['SiteId','siteId'],0);
        if(!aid||!sid||!ROS.trackShort){ return ''; }
        var c=rosTrkCache[aid];
        if(!c){ rosTrkFetch(o, function(){ if(rosCur>=0&&ROS_ITEMS[rosCur]&&rosF(ROS_ITEMS[rosCur].it,['AssetId','assetId'],0)===aid){ rosRenderDetail(); } });
            return '<div class="trkc"><div class="rplab"><span class="tag api">API</span> Track shorting \u00b7 readings</div>'
                 + '<div class="rpmclazy">Reading the shorting windows \u2026</div></div>'; }
        var evs=c.major||[];
        if(!evs.length){ return ''; }

        var h='<div class="trkc"><div class="rplab"><span class="tag api">API</span> Track shorting \u00b7 readings</div>';
        if(c.summary||c.reason){ h+='<div class="trksum">'
            +(c.summary?'<b>'+rosEsc(c.summary)+'</b>':'')
            +(c.reason&&c.reason!==c.summary?'<span>'+rosEsc(c.reason)+'</span>':'')
            +(c.why?'<i>banded '+rosEsc(c.band||'-')+' \u00b7 '+rosEsc(c.why)+'</i>':'')+'</div>'; }

        var drew=0, i;
        for(i=0;i<evs.length&&i<4;i++){
            var ev=evs[i], ser=rosTrkSeries(ev);
            var st=ev.Start_Time||ev.start||'', en=ev.End_Time||ev.end||'';
            var cz=ev.Dominant_Cause||ev.cause||'';
            var du=ev.Duration_Hours!==undefined?ev.Duration_Hours:null;
            h+='<div class="trkev"><div class="trkeh"><b>'+rosEsc(String(st).replace('T',' ').substring(0,16))+'</b>'
              +(en?(' \u2192 '+rosEsc(String(en).replace('T',' ').substring(0,16))):'')
              +(du!=null?('<span class="d">'+du+' h</span>'):'')
              +(cz?('<span class="c">'+rosEsc(cz)+'</span>'):'')+'</div>';
            if(!ser.length){ h+='<div class="rpmclazy">No readings on this window.</div></div>'; continue; }
            drew++;
            var w=560, hh=54, j;
            for(j=0;j<ser.length&&j<4;j++){ var sName=ser[j].name, vals=ser[j].vals;
                var col=['var(--urgent)','var(--blue)','var(--soon)','var(--ok)'][j%4];
                h+='<div class="trkrow"><span class="nm">'+rosEsc(sName)+'</span>'
                  +'<svg class="trksvg" viewBox="0 0 '+w+' '+hh+'" preserveAspectRatio="none">'
                  +'<path d="'+rosTrkPath(vals,w,hh)+'" fill="none" stroke="'+col+'" stroke-width="1.6" stroke-linejoin="round"/></svg>'
                  +'<span class="mm">'+rosEsc(rosFmtVal(Math.min.apply(null,vals)))+' \u2013 '+rosEsc(rosFmtVal(Math.max.apply(null,vals)))+'</span></div>'; }
            h+='</div>'; }
        if(evs.length>4){ h+='<div class="rpmclazy">+'+(evs.length-4)+' earlier window(s) not plotted.</div>'; }
        if(!drew){ h+='<div class="rpmclazy">The predictor reported '+evs.length+' window(s) but attached no readings to them.</div>'; }
        return h+'</div>'; }

    function rosReadLabel(fam){ return fam==='Track'?'Read':(fam==='Point'?'Prediction':(fam==='Signal'?'Analysis':'Read')); }
    function rosSetTab(i){ rosTab=i; rosRenderDetail(); }
    function rosTabBody(o){ if(rosTab===0){ return rosAlertsTab(o); } if(rosTab===1){ return rosReadings(o); } return rosReadTab(o); }

    function rosDays(e){ if(e.days && e.days.length===15){ return e.days; }
        var a=e.firstHalf,b=e.secondHalf,d=new Array(15),i,k; for(i=0;i<15;i++){ d[i]={count:0,events:null}; }
        for(k=0;k<a;k++){ d[Math.floor(k*7/Math.max(a,1))].count++; } for(k=0;k<b;k++){ d[7+Math.floor(k*8/Math.max(b,1))].count++; } return d; }
    function rosDateFor(i){ var base=rosState.date?new Date(rosState.date):new Date(); if(isNaN(base.getTime())){ base=new Date(); }
        base.setDate(base.getDate()-(14-i)); var mo=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][base.getMonth()];
        return {label:mo+' '+base.getDate(), dow:['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][base.getDay()]}; }
    function rosDayISO(i){ var base=rosState.date?new Date(rosState.date):new Date(); if(isNaN(base.getTime())){ base=new Date(); }
        base.setDate(base.getDate()-(14-i)); var mm=('0'+(base.getMonth()+1)).slice(-2), dd=('0'+base.getDate()).slice(-2);
        return base.getFullYear()+'-'+mm+'-'+dd; }
    function rosDayLoad(o,i){ var aid=rosF(o.it,['AssetId','assetId'],0), sid=rosF(o.it,['SiteId','siteId'],0);
        var key=aid+'|'+i; if(!ROS.day||!aid||rosDayCache[key]||rosDayBusy[key]){ return; } rosDayBusy[key]=true;
        rosPostJson(ROS.day,{ assetId:aid, siteId:sid, divisionId:rosState.divisionId, date:rosDayISO(i) })
            .then(function(j){ rosDayBusy[key]=false; var err=rosF(j,['error','Error'],'');
                if(err){ rosErr('DAY','asset='+aid+' day='+i+' server said: '+err); }
                rosDayCache[key]={ ok:!err, events:err?null:(rosF(j,['events','Events'],[])||[]) };
                if(rosDaySel===i){ rosRenderDetail(); } })
            .catch(function(ex){ rosErr('DAY','asset='+aid+' day='+i+' '+((ex&&ex.message)||ex)); rosDayBusy[key]=false; rosDayCache[key]={ ok:false, events:null };
                if(rosDaySel===i){ rosRenderDetail(); } }); }
    function rosShowDay(i){ rosDaySel=(rosDaySel===i?-1:i); rosAlIdx=0;
        if(rosDaySel>=0 && rosCur>=0 && ROS_ITEMS[rosCur]){ var o=ROS_ITEMS[rosCur], days=rosDays(o.e);
            if(days[rosDaySel].count>0 && !days[rosDaySel].events){ rosDayLoad(o,rosDaySel); }
            rosAlPopOn=true; rosAlDlg(true); }
        else { rosAlPopOn=false; rosAlDlg(false); }
        rosRenderDetail(); }
    function rosAlDlg(on){ var d=document.getElementById('rosAlOv'); if(!d){ return; }
        if(on){ if(d.showModal){ if(!d.open){ d.showModal(); } } else { d.setAttribute('open',''); } }
        else { if(d.close){ if(d.open){ d.close(); } } else { d.removeAttribute('open'); } } }
    function rosAlPopClose(){ rosAlPopOn=false; rosAlDlg(false);
        if(rosDaySel>=0){ rosDaySel=-1; rosAlIdx=0; rosRenderDetail(); } }
    function rosAlPopSync(){ var m=document.getElementById('rosAlMod'); if(!m){ return; }
        if(rosAlPopOn && rosDaySel>=0 && rosCur>=0 && ROS_ITEMS[rosCur]){ m.innerHTML=rosDayPanel(ROS_ITEMS[rosCur],rosDaySel); }
        else { m.innerHTML=''; } }
    function rosCloseDay(){ rosAlPopClose(); }
    function rosCzAbbr(cz){ var t=String(cz||'').toUpperCase().replace(/^(TC|PT|SIG|SG)\s+/,'').replace(/HIGH/,'HI').replace(/LOW/,'LO').replace(/VOLT/,'V');
        var w=t.split(/[\s\/]+/).filter(function(x){return x;}); if(w.length>2){ w=w.slice(-2); } return w.join(' '); }
    function rosDayCauses(day,e){ if(day.events&&day.events.length){ var seen={},out=[],k; for(k=0;k<day.events.length;k++){ var c=day.events[k].cause||day.events[k].c||''; if(c&&!seen[c]){ seen[c]=1; out.push(c); } } if(out.length){ return out; } }
        return day.count?[e.dominantCause]:[]; }
    function rosBigspark(e,pcls,sel){ var days=rosDays(e), mx=1, i; for(i=0;i<15;i++){ if(days[i].count>mx){ mx=days[i].count; } }
        var rec='h'+pcls, h='<div class="rbigspark">', lbl='<div class="rsparklbls">';
        for(i=0;i<15;i++){ var ht=days[i].count?Math.max(5,Math.round(days[i].count/mx*58)):3; var cl=days[i].count?(i<7?'h1':rec):''; var nw=(i===14&&e.activeNow)?' now':'';
            var t=rosDateFor(i); var cz=rosDayCauses(days[i],e);
            var tip=t.dow+' '+t.label+(days[i].count?(' \u00b7 '+days[i].count+' alert'+(days[i].count>1?'s':'')+(cz.length?' \u00b7 '+cz.join(', '):'')):'');
            h+='<div class="rsparkcol'+(i===sel?' sel':'')+'" onclick="rosShowDay('+i+')" title="'+rosEsc(tip)+'"><i class="'+cl+nw+'" style="height:'+ht+'px"></i></div>';
            lbl+='<span class="rsparklbl"'+(cz.length?' title="'+rosEsc(cz.join(', '))+'"':'')+'>'+(days[i].count?rosEsc(rosCzAbbr(cz[0])):'')+'</span>'; }
        return h+'</div>'+lbl+'</div>'; }
    // ---- per-alert AI analysis (replaces the flat day list) ----
    // Deterministic, IRSEM-grounded wisdom keyed by family + cause, woven with THIS
    // alert's numbers and the 15-day evidence. The verdict band prefers the live
    // Diagnose engine (per-alert context, cached by asset|day|alert) and falls back to
    // the deterministic read below when the engine is off or still loading -- the panel
    // never blocks. Same endpoint the Ask-AI popup already uses (ROS.diagnose).
    function rosAlHM(s){ var m=String(s||'').match(/(\d{1,2}:\d{2})/); return m?m[1]:''; }
    function rosAlEv(o,sel){ var e=o.e, days=rosDays(e), day=days[sel];
        var aid=rosF(o.it,['AssetId','assetId'],0), cached=rosDayCache[aid+'|'+sel];
        var evs=(day.events&&day.events.length)?day.events:(cached&&cached.ok&&cached.events&&cached.events.length?cached.events:null);
        if(evs&&evs.length){ var i=Math.min(rosAlIdx,evs.length-1), ev=evs[i];
            return { list:evs, idx:i, cause:(ev.cause||ev.c||e.dominantCause), setHM:rosAlHM(ev.setT||ev.set),
                resetHM:rosAlHM(ev.resetT||ev.reset), dur:((ev.dur||ev.durMin)!=null?(ev.dur||ev.durMin):null),
                ackType:String(ev.ackType||'').toUpperCase(), acked:(ev.acked===true||ev.acked==='true'||ev.ack===true), synthetic:false }; }
        return { list:null, idx:0, cause:e.dominantCause, setHM:(sel===14?rosAlHM(e.lastSet):''), resetHM:'',
            dur:null, ackType:'', acked:false, synthetic:true }; }

    function rosAlBaseVerdict(o,ev){ var e=o.e, tr=rosTrend(e).t, c=String(ev.cause).toUpperCase(), fam=rosFamily(o.it,e);
        if(ev.ackType==='F'){ return { tint:'no', word:'No defect on site', conf:68, line:'The maintainer attended and marked this alert False \u2014 no fault was found on site.' }; }
        if(e.activeNow && fam==='Track' && c.indexOf('SHORT')>=0){ return { tint:'yes', word:'Live \u2014 treat as occupied', conf:80, line:'A path across the rails is active right now; treat the section as occupied until it releases.' }; }
        if(tr==='degrading'){ return { tint:'yes', word:'Likely real \u2014 worsening', conf:76, line:'The trend is up ('+e.firstHalf+' \u2192 '+e.secondHalf+'); expect this to recur and worsen without attention.' }; }
        if(ev.dur!=null && ev.dur>=45){ return { tint:'watch', word:'Likely real \u2014 watch', conf:74, line:'Held below the limit for '+ev.dur+' minutes before recovering \u2014 long enough to earn a look on a dry day.' }; }
        if(tr==='improving'){ return { tint:'watch', word:'Likely real \u2014 self-recovering', conf:71, line:'A short excursion that recovered on its own; part of a settling trend ('+e.firstHalf+' \u2192 '+e.secondHalf+').' }; }
        return { tint:'watch', word:'Under watch', conf:60, line:'A single short excursion; not enough on its own to confirm a defect \u2014 verify on site.' }; }

    function rosAlWisdom(o,ev){ var it=o.it, e=o.e, c=String(ev.cause).toUpperCase(), fam=rosFamily(it,e);
        var when=ev.setHM?(' at '+ev.setHM):'';
        var held=(ev.dur!=null)?(ev.dur<=1?('within '+ev.dur+' minute'):('for '+ev.dur+' minutes')):'briefly';
        var w;
        if(fam==='Track'){
            if(c.indexOf('SHORT')>=0){ w={
                what:'<b>Something is joining the two rails electrically.</b> The relay-end current jumped toward pick-up'+when+' then let go '+held+'. A bridge that comes and goes is something loose or wet \u2014 a solid bridge would stay down.',
                cause:'<b>A metal or water path bridging the rails.</b> The two rails must stay separate \u2014 that is how the circuit knows the section is clear. Wire, tools, metal debris or a heap of wet ballast touching both rails takes the current as a short-cut, and the panel can show the section occupied with nothing on it.',
                ruleout:['<b>A real train or vehicle standing there.</b> Match the time against movements before anything else.',
                    '<b>A failing insulated joint to the next circuit</b> leaking the neighbour\u0027s current in.',
                    '<b>A bobbing (chattering) relay contact</b> even though the track is fine.'],
                move:['Walk the full section slowly for wire, tools, scrap metal or anything metallic across both rails.',
                    'Look for wet ballast or mud heaped to the rail foot \u2014 in rain that alone can bridge the rails.',
                    'Inspect the insulated joints at both ends for cracks or metal burrs across the gap.',
                    'Check bonds and jumpers \u2014 a loose one swinging onto the other rail makes a perfect intermittent short.'],
                cons:'A hard short keeps the section showing <b>OCCUPIED</b> \u2014 signals stay at danger, trains detained, control calling until it is found. Near an insulated joint it can burn the joint too. Finding it today is a walk with your eyes open; finding it in a failure is a line block at night.' }; }
            else if(c.indexOf('RES HIGH')>=0||c.indexOf('CKT OPEN')>=0||c.indexOf('RES OPEN')>=0){ w={
                what:'<b>This track circuit is slowly losing its electrical path.</b> The feed end keeps sending current but less of it reaches the relay end; it crossed the alert line'+when+' and recovered '+held+'.',
                cause:'<b>A drying glued joint or a corroded bond \u2014 like an old wire splice.</b> The feed side is healthy, so the weakness sits in the rail path itself: a drying glued joint, a loose or corroded bond wire, or a loose relay-side termination. Not a short (that pulls the reading down hard); this is a path slowly opening.',
                ruleout:['<b>Do not turn the feed up to clear the alert.</b> That hides the fault and eats the safety margin that detects a train.',
                    '<b>Check it was not a re-adjustment</b> \u2014 a recent relay or feed change can look man-made, not a fault.',
                    '<b>Confirm no genuine occupancy</b>'+when+' \u2014 a standing vehicle also drops the relay-end reading.'],
                move:['Megger the section and record the reading for post-repair comparison.',
                    'Open and inspect the glued joints \u2014 cracks, rust lines, dry or crumbling glue.',
                    'Check every bond wire and TLJB termination \u2014 loose lugs, green corrosion, broken strands.',
                    'Measure feed-end vs relay-end voltage \u2014 the bigger the gap, the closer the fault to the relay end.'],
                cons:'One day the relay will not hold and the track shows <b>OCCUPIED with no train</b> \u2014 signals to danger, trains held, usually in the rain at the worst time. Re-making a joint today is a short planned job; the same fault in service is a failure report and a line block.' }; }
            else if(c.indexOf('VOLT')>=0){ w={
                what:'<b>Track voltage is sagging.</b> The relay-end voltage dipped below its safe level'+when+' and recovered '+held+'.',
                cause:'<b>A tired feed set or a bond termination.</b> The supply to the circuit is dropping \u2014 a weak feed battery or charger, a loose feed termination, or a high-resistance bond starving the relay.',
                ruleout:['<b>A drying joint</b> can look similar \u2014 but that shows at the relay end only; a feed problem drops both ends together.',
                    '<b>A genuine occupancy</b>'+when+'.'],
                move:['Measure the feed-end voltage against spec and check the feed battery and charger.',
                    'Check feed and relay terminations for looseness and corrosion.',
                    'Compare feed-end vs relay-end \u2014 both low points to the feed set.'],
                cons:'If the feed keeps sagging the relay eventually drops and the section shows OCCUPIED \u2014 signals to danger. A feed check today is quick; a mid-service drop is a failure.' }; }
            else { w={
                what:'<b>The rail / ballast resistance on this track circuit fell below its low threshold'+when+' and recovered '+held+'.</b> A dip that clears itself is the classic wet-ballast pattern \u2014 the feed end stays steady while the relay end sags, then comes back as the bed dries. It is not a short (a short pulls the reading down hard) and not an open joint (that keeps climbing).',
                cause:'<b>Ballast leaking current to ground \u2014 usually rain.</b> The stone bed is meant to keep the two rails apart electrically. Wet, muddy, coal-dusted or overgrown ballast lets part of the track current escape through the ground instead of reaching the relay. That is why the reading sinks during and just after rain and recovers dry.',
                ruleout:['<b>A joint or bond fault wearing weather\u0027s disguise.</b> That one stays bad on a dry day too \u2014 take a dry-day reading before replacing anything.',
                    '<b>A genuine occupancy</b>'+when+' \u2014 a standing vehicle also drops the relay-end reading. Match the time against movements.',
                    '<b>Stray DC from nearby traction</b> distorting the small rail voltages.'],
                move:['On the next <b>dry</b> day, megger the section and write the reading down \u2014 compare it against this wet dip.',
                    'Walk the section for mud, coal dust, iron filings or vegetation bridging the rails.',
                    'Check the ballast sits clear of the rail foot \u2014 the 50 mm clearance matters more than it looks.'],
                cons:'If this really is weather it will keep clearing on its own. But if a joint or bond is the true cause hiding behind the rain, one wet night the relay will not hold and the section shows <b>OCCUPIED with no train on it</b> \u2014 signals to danger, trains held. A dry-day megger today tells the two apart cheaply.' }; }
        } else if(fam==='Point'){
            if(c.indexOf('OBS')>=0){ w={
                what:'<b>The point hit something mid-stroke.</b> The throw current spiked partway through the movement'+when+' then completed. That is a bump on the path, not a drive fault.',
                cause:'<b>An obstruction between or under the blades</b> \u2014 ballast, a stone, packing, ice, or a bent stretcher \u2014 the machine has to push past.',
                ruleout:['<b>A genuine drive fault</b> \u2014 that shows high current across the WHOLE stroke, not one bump.',
                    '<b>Loss of lubrication</b> making the slide chairs stiff.'],
                move:['Inspect between and under the switch blades for ballast, stones or debris.',
                    'Check the stretcher bars and lock for bending or fouling.',
                    'Clean and lubricate the slide chairs; work the point and watch where it binds.'],
                cons:'An obstruction that grows can fail the point mid-stroke with a train waiting \u2014 detention and a call-out. Clearing it today is a few minutes with a scraper.' }; }
            else if(c.indexOf('DRIVE')>=0){ w={
                what:'<b>The throw current is running high.</b> The machine drew more current than normal to complete the movement'+when+'. Reads like binding in the drive.',
                cause:'<b>Binding in the drive train</b> \u2014 stiff slide chairs, dry gearing, a tight lock, or a worn drive rod \u2014 the motor works harder to move the blades.',
                ruleout:['<b>An obstruction</b> \u2014 that spikes at one point in the stroke, not across it.',
                    '<b>Low supply voltage</b> making the motor pull more current.'],
                move:['Measure the throw current across the full stroke and note where it climbs.',
                    'Clean and lubricate slide chairs, gearing and the lock.',
                    'Check the drive rod and clamp lock for wear and correct adjustment.'],
                cons:'Rising drive current ends in a failed operation \u2014 the point stops mid-stroke, detection is lost, and a train waits. Servicing the drive today avoids the call-out.' }; }
            else { w={
                what:'<b>Detection voltage is drifting toward drop-out.</b> The point proves its position through the detection contacts, and that proof voltage is fading'+when+'. Marginal contact, not binding.',
                cause:'<b>Worn or dirty detection contacts, or a marginal adjustment.</b> The blades reach position but the contacts barely make \u2014 the proof voltage sits close to the drop-out line.',
                ruleout:['<b>A binding drive</b> \u2014 that shows in throw current, not detection voltage.',
                    '<b>Vibration from passing traffic</b> nudging a marginal contact.'],
                move:['Measure the detection voltage against drop-out and note the margin.',
                    'Clean and check the detection contacts and their adjustment.',
                    'Confirm the blades sit fully home against the stock rail.'],
                cons:'If detection drops the point cannot prove its position \u2014 it reads failed and signals hold, even though the blades are home. Adjusting the contacts today is routine; a lost detection in service is a failure.' }; }
        } else if(fam==='Signal'){
            if(c.indexOf('ECR')>=0){ w={
