    function rosRangeMap(e){ var m={}, ch=e.channels||[], i; for(i=0;i<ch.length;i++){ var c=ch[i]; var key=(c.attrId!==undefined&&c.attrId!==null)?String(c.attrId):String(c.name||'').toUpperCase();
        m[key]={name:c.name,unit:c.unit,min:(c.min!==undefined?c.min:null),max:(c.max!==undefined?c.max:null),avg:(c.avg!==undefined?c.avg:null)}; if(c.name){ m[String(c.name).toUpperCase()]=m[key]; } } return m; }
    function rosParseStamp(s){ var m=String(s).match(/(\d{1,2})\/(\d{1,2})\/(\d{4})\s+(\d{1,2}):(\d{2})(?::(\d{2}))?/); if(m){ return new Date(+m[3],+m[2]-1,+m[1],+m[4],+m[5],+(m[6]||0)); } var d=new Date(s); return isNaN(d.getTime())?new Date():d; }
    function rosParseAt(s,now){ var m=String(s).match(/(\d{1,2})\/(\d{1,2})(?:\/(\d{4}))?\s+(\d{1,2}):(\d{2})/); if(!m){ var d=new Date(s); return isNaN(d.getTime())?null:d; } var yr=m[3]?+m[3]:now.getFullYear(); return new Date(yr,+m[2]-1,+m[1],+m[4],+m[5],0); }
    function rosAgeH(atStr,nowStr){ if(!atStr){ return 0; } try{ var now=nowStr?rosParseStamp(nowStr):new Date(); var d=rosParseAt(atStr,now); if(!d){ return 0; } var h=Math.round((now-d)/3600000); return (h<0||h>9000)?0:h; }catch(x){ return 0; } }
    function rosFmtVal(v){ if(v===null||v===undefined||v===''){ return '-'; } var n=Number(v); if(isNaN(n)){ return String(v); } var s=(Math.abs(n)>=1000?n.toFixed(0):(Math.abs(n)>=100?n.toFixed(1):n.toFixed(2))); return s.replace(/\.00$/,'').replace(/(\.\d)0$/,'$1'); }
    function rosLiveMaybeRerender(aid){ if(rosTab===1 && rosCur>=0 && ROS_ITEMS[rosCur] && rosF(ROS_ITEMS[rosCur].it,['AssetId','assetId'],0)===aid){ rosRenderDetail(); } }
    function rosLoadLive(o){ var it=o.it; var aid=rosF(it,['AssetId','assetId'],0), sid=rosF(it,['SiteId','siteId'],0);
        if(!ROS.live||!aid||rosLiveCache[aid]||rosLiveBusy[aid]){ return; } rosLiveBusy[aid]=true;
        rosGet(ROS.live+'?assetId='+encodeURIComponent(aid)+'&siteId='+encodeURIComponent(sid)).then(function(j){
            var vals=rosF(j,['values','Values'],[])||[]; var at=rosF(j,['retrievedAt','RetrievedAt'],''); var err=rosF(j,['error','Error'],'');
            rosLiveCache[aid]={at:at, err:err, rows:vals.map(function(r){ return {attrId:rosF(r,['attrId','AttrId','AssetAttributeId'],''), attr:rosF(r,['attr','Attr','AssetAttributeName'],''), unit:rosF(r,['unit','Unit','TagUnit'],''), value:rosF(r,['value','Value'],0), minSafe:rosF(r,['minSafe','MinSafe'],null), maxSafe:rosF(r,['maxSafe','MaxSafe'],null), avg:rosF(r,['avg','Avg'],null), at:rosF(r,['at','At','TimestampDevice'],'')}; })};
            rosLiveBusy[aid]=false; rosLiveMaybeRerender(aid);
        }).catch(function(ex){ rosErr('LIVE','asset='+aid+' '+((ex&&ex.message)||ex)); rosLiveBusy[aid]=false; rosLiveCache[aid]={at:'',err:(ex&&ex.message)||'fetch failed',rows:[]}; rosLiveMaybeRerender(aid); }); }
    function rosDigital(c){ var v=Number(c.val); if(v!==0&&v!==1){ return false; }
        var n=String(c.name||'').trim();
        if(/\b(V|mA|A|mV|Volt|Voltage|Current)\b/i.test(n)){ return false; }
        return /TPR\b|NWKR|RWKR|NWCR|RWCR|ECR\b|KR\b|RELAY|^DR$|^HR$|^HHR$|\bDR\b|\bHR\b|\bHHR\b/i.test(n); }
    // ECR correspondence: RECR proves RG, DECR proves DG, HECR proves HG, HHECR proves HHG (xECR -> xG).
    // A dropped ECR means that aspect is de-energised, so its V / mA reading near zero is EXPECTED, not LOW.
    function rosAspectGate(rows){ var g={}, i;
        for(i=0;i<rows.length;i++){ var n=String(rows[i].name||'').trim().toUpperCase();
            var m=n.match(/^([A-Z]{0,3})ECR$/); if(!m){ continue; }
            var v=Number(rows[i].val); if(v!==0&&v!==1){ continue; }
            if(m[1].length){ g[m[1]+'G']=v; } }
        return g; }
    function rosGatedOff(c,g){ var n=String(c.name||'').trim().toUpperCase();
        var m=n.match(/^([A-Z]{1,4}G)\b/); if(!m){ return false; }
        return g[m[1]]===0; }
    function rosReadingsGrid(ch,readAt,src){ var rows=ch.slice(), outN=0, oldest=0, i;
        var gate=rosAspectGate(rows);
        function isBad(c){ if(rosDigital(c)||rosGatedOff(c,gate)){ return false; }
            var hasR=(c.min!==undefined&&c.min!==null&&c.max!==undefined&&c.max!==null); return hasR&&(c.val<c.min||c.val>c.max); }
        rows.sort(function(a,b){ function rank(x){ if(isBad(x)){ return 0; } if(rosDigital(x)||(x.min!==undefined&&x.min!==null)){ return 1; } return 2; } return rank(a)-rank(b); });
        for(i=0;i<rows.length;i++){ var c=rows[i]; var a=(c.ageH!==undefined?c.ageH:0); if(a>oldest){ oldest=a; } if(isBad(c)){ outN++; } }
        var hdr=(outN===0?'<b style="color:var(--ok)">All '+rows.length+' readings in range</b>':'<b style="color:var(--urgent)">'+outN+' of '+rows.length+' outside safe range</b>');
        var tag='<span class="tag api">API</span> Live readings'+(src==='snapshot'?' <span class="rrdread">(snapshot)</span>':'');
        var h='<div class="rplab">'+tag+'</div><div class="rrdhead">'+hdr
          +(readAt?'<span class="rrdread">read '+rosEsc(String(readAt).replace('T',' ').substring(0,19))+'</span>':'')
          +(oldest>0?'<span class="rrdold">oldest channel '+oldest+'h old</span>':'')+'</div>'
          +'<div class="rrdsub">exceptions first \u00b7 marker = current value'+(src==='live'?'':'')+'</div><div class="rrdgrid">';
        for(i=0;i<rows.length;i++){ var c2=rows[i]; var a2=(c2.ageH!==undefined?c2.ageH:0);
            var dig=rosDigital(c2); var goff=!dig&&rosGatedOff(c2,gate); var bad=isBad(c2); var st=bad?(c2.val<c2.min?'low':'high'):'';
            var hasR=(c2.min!==undefined&&c2.min!==null&&c2.max!==undefined&&c2.max!==null);
            var cls=dig?'dig':(bad?st:(goff?'':(hasR?'okc':'')));
            var rel='';
            if(bad){ rel=(st==='low'?'LOW \u2014 below '+rosFmtVal(c2.min):'HIGH \u2014 above '+rosFmtVal(c2.max)); }
            else if(goff){ rel='not lit \u00b7 ECR dropped \u2014 expected'; }
            else if(hasR&&c2.avg!==undefined&&c2.avg!==null&&Number(c2.avg)!==0){
                var dp=(c2.val-c2.avg)/Math.abs(c2.avg)*100;
                rel=Math.abs(dp)<3?'at normal':(Math.abs(dp).toFixed(0)+'% '+(dp<0?'below':'above')+' normal'); }
            h+='<div class="rrdcard '+cls+'"><div class="rrdtop">'
              +'<span class="rrddot '+(dig?(Number(c2.val)===1?'ok':'na'):(bad?'bad':(goff?'na':(hasR?'ok':'na'))))+'"></span>'
              +'<span class="rrdname">'+rosEsc(c2.name||'')+'</span>'
              +(dig?'<span class="rrdpill '+(Number(c2.val)===1?'pick':'drop')+'">'+(Number(c2.val)===1?'Picked up':'Dropped')+'</span>':'')
              +(goff?'<span class="rrdpill drop">not lit</span>':'')
              +(bad?'<span class="rrdpill '+st+'">'+st.toUpperCase()+'</span>':'')
              +'</div>'
              +'<div class="rrdval">'+rosEsc(rosFmtVal(c2.val))+(c2.unit?'<i>'+rosEsc(c2.unit)+'</i>':'')+'</div>'
              +((rel||a2>0)?('<div class="rrdrel'+(bad?' bad':(rel==='at normal'?' good':''))+'">'+(rel||'')+(a2>0?' <span class="rrdage">'+a2+'h old</span>':'')+'</div>'):'');
            if(dig){ h+='<div class="rrdnorange">digital indication</div>'; }
            else if(hasR){ var span=(c2.max-c2.min)||1; var pos=Math.max(1,Math.min(99,(c2.val-c2.min)/span*100));
                var ap=(c2.avg!==undefined&&c2.avg!==null)?Math.max(1,Math.min(99,(c2.avg-c2.min)/span*100)):null;
                h+='<div class="rrdbar">'+(ap!==null?'<span class="avg" style="left:'+ap.toFixed(1)+'%"></span>':'')
                  +'<span class="valm" style="left:'+pos.toFixed(1)+'%"></span></div>'
                  +'<div class="rrdmm"><span>'+rosEsc(rosFmtVal(c2.min))+'</span>'
                  +((c2.avg!==undefined&&c2.avg!==null)?'<span>avg '+rosEsc(rosFmtVal(c2.avg))+'</span>':'')
                  +'<span>'+rosEsc(rosFmtVal(c2.max))+'</span></div>'; }
            else { h+='<div class="rrdnorange">no safe band configured</div>'; }
            h+='</div>'; }
        return h+'</div>'; }

    function rosReadings(o){ var e=o.e, it=o.it; var aid=rosF(it,['AssetId','assetId'],0);
        var ranges=rosRangeMap(e); var live=ROS.live?rosLiveCache[aid]:null;
        if(live && !live.err && live.rows && live.rows.length){
            var chans=live.rows.map(function(r){ var rg=ranges[String(r.attrId)]||ranges[String(r.attr||'').toUpperCase()]||{};
                return {name:r.attr||rg.name||('attr '+r.attrId), val:r.value, unit:r.unit||rg.unit||'', min:(r.minSafe!==null&&r.minSafe!==undefined?r.minSafe:(rg.min!==undefined?rg.min:null)), max:(r.maxSafe!==null&&r.maxSafe!==undefined?r.maxSafe:(rg.max!==undefined?rg.max:null)), avg:(r.avg!==null&&r.avg!==undefined?r.avg:(rg.avg!==undefined?rg.avg:null)), ageH:rosAgeH(r.at,live.at)}; });
