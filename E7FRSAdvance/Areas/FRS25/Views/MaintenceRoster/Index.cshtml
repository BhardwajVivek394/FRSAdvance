                if (!entry.text.trim()) { throw new Error('Empty AI response'); }
            } catch(e) { failure=stalled ? 'AI timed out: no data from the AI service for '+Math.round(AI_STALL_MS/1000)+' s' : (e.message || 'AI request failed'); throw stalled ? new Error(failure) : e; }
            finally { clearInterval(ticker); clearTimeout(stallTimer); if (signal) { signal.removeEventListener('abort',relay); } finishAiLog(log,entry,failure); }
