        if (run) { head.push('roster run: ' + [F(run, ['GeneratedBy', 'generatedBy'], ''), F(run, ['GeneratedAtIst', 'generatedAtIst'], ''), F(run, ['Status', 'status'], '')].filter(function (x) { return String(x || '').trim(); }).join(' | ') + ' | alerts read ' + shown(F(run, ['AlertsRead', 'alertsRead'], null)) + '/' + shown(F(run, ['AlertsTotal', 'alertsTotal'], null))); }
