 #dm td { display:block; padding:0; border:0; min-width:0; } #dm td::before { content:attr(data-label); display:block; color:var(--muted); font-size:12px; margin-bottom:3px; }
 #dm td.dm-reason { grid-column:1 / -1; max-width:none; } #dm td.dm-asset { grid-column:1 / -1; } #dm td.dm-asset::before { display:none; } #dm td.dm-action { display:flex; justify-content:flex-end; align-items:center; } #dm td.dm-action::before { display:none; }
 #dm .dm-evidence-grid { grid-template-columns:1fr 1fr; } #dm .dm-dialog-body { padding:17px; } #dm .dm-dialog-head { padding:17px; }
}
@@media(max-width:390px) { #dm .dm-field, #dm .dm-filters .dm-field { min-width:100%; } #dm .dm-evidence-grid { grid-template-columns:1fr; } }
@@media print { #dm { overflow:visible; } #dm .dm-top a, #dm .dm-toolbar, #dm .dm-filters, #dm .dm-tabs, #dm .dm-pagination, #dm .dm-btn, #dm .dm-dialog { display:none!important; } #dm .dm-main { padding:0; } #dm .dm-workspace { overflow:visible; } #dm tr { break-inside:avoid; } #dm .dm-top { color:#112b48; background:white; } }
/* Asset roster 2.0: compact operating overview and accessible bar controls. */
