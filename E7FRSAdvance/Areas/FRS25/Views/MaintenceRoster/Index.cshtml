    function rosTrackRead(it,e){ var c=String(e.dominantCause).toUpperCase(), tr=rosTrend(e); var chs;
        var num=e.total+' time'+(e.total===1?'':'s')+' in 15 days \u2014 '+e.firstHalf+' in the first week, '+e.secondHalf+' in the second ('+tr.t+')';
        if(c.indexOf('SHORT')>=0){ chs=[
            { t:'What happened', art:'short', ac:'var(--urgent)', body:'<div class="rslead">Something is joining the two rails electrically.</div>'
              +'<div class="rsym">'+rosRB('bad','!','The relay-end current jumped toward pick-up '+num+'. That pattern means a metal or water path is bridging the rails, then letting go.')
              +rosRB('n','i','<b>'+(e.activeNow?'It is happening right now.':'It comes and goes.')+'</b> '+(e.activeNow?'Treat the section as blocked until it releases.':'A bridge that comes and goes is something loose or wet \u2014 a solid bridge would stay down.'))+'</div>' },
            { t:'What it means', art:'mech', ac:'var(--soon)', body:'The two rails must stay electrically separate \u2014 that is how the circuit knows the section is clear. When wire, tools, metal debris or a heap of wet ballast touches both rails, the current takes that short-cut instead of reaching the relay. The panel can then show the section occupied with nothing standing on it.' },
            { t:'Rule out first', art:'ruleout', ac:'var(--urgent)', body:'Three things look exactly like this but are not a rail short:'+rosSteps([
                '<b>A real train or vehicle standing there.</b> Match the alert times against train movements before anything else.',
                '<b>A failing insulated joint to the NEXT circuit.</b> It leaks the neighbour\u0027s current in and mimics a short.',
                '<b>A bouncing relay contact (\u0022bobbing\u0022).</b> The relay chatters even though the track is fine.']) },
            { t:'Verify on site', art:'verify', ac:'var(--ok)', body:rosSteps([
                'Walk the full section slowly. Look for wire, tools, scrap metal or anything metallic touching both rails.',
                'Look for wet ballast or mud heaped up to the rail foot \u2014 in rain that alone can bridge the rails.',
                'Inspect the insulated joints at both ends for cracks or metal burrs across the gap.',
                'Check bonds and jumpers \u2014 a loose one swinging onto the other rail makes a perfect intermittent short.'])
              +'<div class="evimeta" style="margin-top:9px">IRSEM 17.1\u201317.2 \u00b7 track-circuit continuity, bonds, insulated joints (TRK-002 occupancy, TRK-008 joint, TRK-012 bobbing).</div>' },
            { t:'If it is ignored', art:'stop', ac:'var(--urgent)', body:'<div class="rslead">A hard short keeps the section showing occupied.</div>'
              +'Signals behind it stay at danger, trains are detained, and control keeps calling until someone finds it. If the bridge sits near an insulated joint it can burn the joint too. Finding it today is a walk with your eyes open \u2014 finding it during a failure is a line block at night.' } ]; }
        else if(c.indexOf('RES HIGH')>=0||c.indexOf('CKT OPEN')>=0||c.indexOf('RES OPEN')>=0){ chs=[
            { t:'What happened', art:'res', ac:'var(--soon)', body:'<div class="rslead">This track circuit is slowly losing its electrical path.</div>'
              +'<div class="rsym">'+rosRB('warn','!','The feed end keeps sending current, but less and less of it reaches the relay end. It crossed the alert line '+num+'.')
              +rosRB('n','i',(tr.t==='improving'?'<b>It is easing for now</b> \u2014 typical of a joint that dries and recovers. It will come back; the weakness is still there.':'<b>It is not settling.</b> The path is degrading \u2014 expect it to trip more often.'))+'</div>' },
            { t:'What it means', art:'mech', ac:'var(--soon)', body:'Think of a glued rail joint or a bond wire like an old wire splice \u2014 when the glue dries or the lug corrodes, electricity struggles to cross it. The feed side is healthy here, so the weakness sits in the rail path itself: a drying glued joint, a loose or corroded bond wire, or a loose termination on the relay side. It is <b>not</b> a short \u2014 a short pulls the reading down hard; this is a path slowly opening. If BOTH ends were low together, the suspect would instead be the feed battery / charger.' },
            { t:'Rule out first', art:'ruleout', ac:'var(--urgent)', body:rosSteps([
                '<b>Do not turn the feed up to make the alert go away.</b> That hides the fault and eats the safety margin that detects a train \u2014 the circuit may then miss a real occupancy.',
                '<b>Check it was not a re-adjustment.</b> If someone recently adjusted the relay or feed, the change may be man-made, not a fault.',
                '<b>Confirm no genuine occupancy</b> at the alert times \u2014 a standing vehicle also drops the relay-end reading.']) },
            { t:'Verify on site', art:'verify', ac:'var(--ok)', body:rosSteps([
                'Megger (resistance-test) the section and write the reading down \u2014 you will want to compare it after repair.',
                'Open and inspect the glued joints: look for cracks, rust lines and dry or crumbling glue.',
                'Check every bond wire and the TLJB terminations \u2014 loose lugs, green corrosion, broken strands.',
                'Measure feed-end vs relay-end voltage. The bigger the gap, the closer the fault sits to the relay end.',
                'Note the weather: if readings sink in rain and recover dry, drainage and ballast are part of the story.'])
              +'<div class="evimeta" style="margin-top:9px">IRSEM 17.2.4\u201317.2.5 \u00b7 joints, bonds, ballast-resistance minima (TRK-006 do-not-over-energize, TRK-011 feed vs relay).</div>' },
            { t:'If it is ignored', art:'stop', ac:'var(--urgent)', body:'<div class="rslead">One day the relay will not hold, and the track shows OCCUPIED with no train on it.</div>'
              +'Signals go to danger, trains are held, and the section fails \u2014 usually in the rain, at the worst time. Re-making a joint or bond today is a short planned job; the same fault in service is a failure report and a line block.' } ]; }
        else { chs=[
            { t:'What happened', art:'ballast', ac:'var(--soon)', body:'<div class="rslead">The stone bed under the track is leaking current \u2014 usually rain.</div>'
              +'<div class="rsym">'+rosRB('warn','~','Ballast / rail-path resistance drifted off its normal level '+num+'.')
              +rosRB('n','i',(tr.t==='improving'?'<b>Settling as it dries</b> \u2014 the classic wet-weather pattern.':'<b>Watch the trend</b> \u2014 if it persists in dry weather, it is not the rain.'))+'</div>' },
            { t:'What it means', art:'mech', ac:'var(--soon)', body:'The ballast (stone bed) is supposed to insulate one rail from the other. When it is wet, muddy, coated in coal / iron dust or overgrown, part of the track current leaks through the ground instead of reaching the relay. That is why readings sink during rain and recover as the section dries \u2014 the feed stays steady while the relay end sags.' },
            { t:'Rule out first', art:'ruleout', ac:'var(--urgent)', body:rosSteps([
