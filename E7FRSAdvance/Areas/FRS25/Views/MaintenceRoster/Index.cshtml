    #ros .ctxd pre { margin: 0; max-height: 240px; overflow: auto; white-space: pre-wrap;
        word-break: break-word; font: 10px/1.5 var(--mono); color: var(--ink2); }

    #ros .aitabs { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 12px; }
    #ros .aitab { font-size: 9px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 5px 10px; border-radius: 14px; border: 1px solid var(--line); background: #fff; color: var(--ink2); cursor: pointer; }
    #ros .aitab.on { background: var(--teal); border-color: var(--teal); color: #fff; }
    #ros .aistory { background: linear-gradient(180deg, var(--tealbg), #fff 90%); border: 1px solid var(--tealln); border-radius: 11px; padding: 14px 16px; min-height: 96px; }
    #ros .aistory .lab { font-size: 8.5px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--teal); }
    #ros .aistory .big { font-size: 15px; font-weight: 700; color: var(--ink); margin: 6px 0 10px; line-height: 1.35; }
    #ros .aistory p { margin: 0; font-size: 12.5px; line-height: 1.55; color: var(--ink); }
    #ros .ainums { display: flex; gap: 26px; flex-wrap: wrap; }
    #ros .ainums .n b { display: block; font: 600 26px/1 var(--mono); } #ros .ainums .n.hero b { color: var(--teal); }
    #ros .ainums .n span { font-size: 9px; color: var(--ink3); font-family: var(--mono); }
    #ros .aistory .cap { margin-top: 11px; font-size: 11.5px; color: var(--ink2); }
    #ros .aicaro { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; }
    #ros .aicaro .dots { display: flex; gap: 4px; } #ros .aicaro .dots i { width: 5px; height: 5px; border-radius: 50%; background: var(--line); } #ros .aicaro .dots i.on { background: var(--teal); }
    #ros .aicaro .ar { font: 600 12px var(--mono); color: var(--ink3); cursor: pointer; padding: 2px 6px; } #ros .aicaro .pg { font: 500 9px var(--mono); color: var(--ink3); }

    #ros .aihvm .row1 { display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap; }
    #ros .aihvm .from { font: 600 15px var(--mono); color: var(--ink3); } #ros .aihvm .arr { color: var(--ink3); } #ros .aihvm .to { font: 700 20px var(--mono); color: var(--urgent); }
    #ros .aihvm .to.ok { color: var(--ok); }
    #ros .aihvm .dp { font: 700 9px var(--mono); background: var(--urgentbg); color: var(--urgent); border: 1px solid var(--urgentln); border-radius: 8px; padding: 2px 7px; }
    #ros .aihvm .dp.ok { background: var(--okbg); color: #2E7D51; border-color: var(--okln); }
    #ros .aihvm .sub { font-size: 9px; color: var(--ink3); font-family: var(--mono); margin-top: 2px; }
    #ros .aihvm .limit { font-size: 11.5px; color: var(--ink2); margin: 10px 0; } #ros .aihvm .limit b { color: var(--urgent); }

    #ros .aiasg { display: grid; grid-template-columns: 96px 1fr; gap: 8px 14px; }
    #ros .aiasg .k { font-size: 9px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--ink3); padding-top: 2px; }
    #ros .aiasg .v { font-size: 12.5px; color: var(--ink); line-height: 1.5; }
    #ros .aiasg .cat { display: inline-block; font: 600 10px var(--mono); border-radius: 8px; padding: 2px 9px; }
    #ros .aiasg .cat.no { background: var(--tealbg); color: var(--teal); border: 1px solid var(--tealln); }
    #ros .aiasg .cat.yes { background: var(--urgentbg); color: var(--urgent); border: 1px solid var(--urgentln); }
    #ros .aiasg .cat.inc { background: var(--soonbg); color: var(--soon); border: 1px solid var(--soonln); }

    #ros .aiev { background: linear-gradient(150deg, var(--panel), #0F1A15); border-radius: 11px; padding: 12px 14px; }
    #ros .aiev .eh { font-size: 9px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: #7FA79A; margin-bottom: 9px; }
    #ros .aiev .er { font: 500 10.5px var(--mono); color: #C6D6CF; padding: 5px 0; border-top: 1px solid rgba(255,255,255,.06); display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    #ros .aiev .er:first-child { border-top: none; }
    #ros .aiev .kind { color: #6FB7A8; } #ros .aiev .chip { background: rgba(18,165,148,.18); color: #8FE3D3; border: 1px solid rgba(18,165,148,.35); border-radius: 6px; padding: 1px 7px; }
    #ros .aiev .chip.low { background: rgba(201,127,18,.2); color: #F0CB86; border-color: rgba(201,127,18,.4); } #ros .aiev .chip.high { background: rgba(217,64,58,.22); color: #F2A9A5; border-color: rgba(217,64,58,.4); }
    #ros .aiev .mut { color: #7C8C85; }

    #ros .aithread { padding: 0 16px; } #ros .aithread:empty { display: none; }
    #ros .think { font: 400 11.5px var(--mono); color: var(--ai); padding: 8px 0; }
    #ros .msg { font-size: 12.5px; line-height: 1.5; color: var(--ink); margin: 9px 0; } #ros .msg b { font-weight: 700; }
    #ros .rhook { font-size: 11.5px; color: var(--ink3); padding: 6px 0; }
    #ros .askrow { display: flex; gap: 8px; padding: 12px 16px; border-top: 1px solid var(--line2); background: var(--surface2); }
    #ros .askrow input { flex: 1; font-family: inherit; font-size: 12.5px; padding: 9px 12px; border: 1px solid var(--line); border-radius: 9px; }
    #ros .askrow button { font-family: inherit; font-size: 12px; font-weight: 700; padding: 9px 16px; border-radius: 9px; border: 1px solid var(--ai); background: var(--ai); color: #fff; cursor: pointer; }

    @@media (max-width:900px) {
        #ros .ratwo {
            grid-template-columns: 1fr;
        }

        #ros .rmvs {
            grid-template-columns: 1fr 1fr;
        }

        #ros .rmvc:nth-child(2) {
            border-right: 0;
        }

        #ros .rmvc:nth-child(1), #ros .rmvc:nth-child(2) {
            border-bottom: 1px dashed var(--line);
        }

        #ros .rpmgrid {
            grid-template-columns: 1fr;
        }

        #ros .mod {
            flex-basis: 190px;
        }

        #ros .dhd {
            gap: 12px;
        }

            #ros .dhd .aid {
                font-size: 24px;
            }

        #ros .dhstats {
            margin-left: 0;
            width: 100%;
            justify-content: space-between;
        }

        #ros .dwell {
            width: auto;
            flex: 1;
            min-width: 90px;
        }

        #ros .vband {
            flex-direction: column;
            gap: 10px;
        }

        #ros .vstat {
            flex-direction: row;
            align-items: center;
            border-right: 0;
            border-bottom: 1px dashed var(--line);
            padding: 0 0 9px;
            min-width: 0;
        }

        #ros .vmain {
            padding-right: 0;
        }

        #ros .vsum {
            font-size: 15px;
        }

        #ros .stn-row {
            grid-template-columns: 4px 1fr 46px 46px 46px;
        }

            #ros .stn-worst, #ros .stn-cell.old, #ros .stn-row .oldh {
                display: none;
            }
    }

    @@media print {
        #ros .ros-bar, #ros .ros-head button, #ros .racts, #ros .kpi.click {
            display: none;
        }
    }

    @@media (prefers-reduced-motion:reduce) {
        #ros .lamp.live, #ros .vstat .lvd {
            animation: none;
        }
    }
</style>

<style>
    /* FRS Advance: 617's aurora-bridge.css forces day/night colours on labels, form controls and
       .card with !important. This page's internals are light-only, so keep its own palette inside
       #ros (the id selector out-ranks the bridge rules). */
    body #ros label { color: var(--ink3) !important; }
    body #ros select, body #ros textarea, body #ros .form-control,
    body #ros input:not([type=checkbox]):not([type=radio]):not([type=range]):not([type=color]):not([type=file]):not([type=button]):not([type=submit]) {
        background-color: var(--surface) !important; color: var(--ink) !important; border-color: var(--line) !important;
    }
    body #ros select option { background: var(--surface) !important; color: var(--ink) !important; }
    body #ros .card { background: var(--surface) !important; color: var(--ink) !important; border-color: var(--line) !important; -webkit-backdrop-filter: none; backdrop-filter: none; }
    body #ros .card-header, body #ros .card-body { color: inherit !important; }
</style>

@* FRS Advance page header (617 theme): breadcrumb card like EquipmentRoom/Index. *@
<section class="section e7-page-head">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="row">
                        <div class="col-12 col-sm-5">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">AI/ML Analysis</li>
                                    <li class="breadcrumb-item active" aria-current="page"><a href="#">Maintenance Roster</a></li>
                                </ol>
                            </nav>
                        </div>
                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                            <h2 class="page-name">Maintenance Roster</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="ros">

    <div class="ros-bar">
        <div>
            <label for="rosDiv">Division</label>
            <select id="rosDiv">
                <option value="">-- Select division --</option>
                @if (ViewBag.Divisions != null)
                {
                    foreach (var d in (IEnumerable<Domain.Division>)ViewBag.Divisions)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                }
            </select>
        </div>
        <div>
            <label for="rosDate">Roster date</label>
            <input type="date" id="rosDate" />
        </div>
        <div><button class="pri" id="rosLoad" onclick="rosLoadRollup()">Load</button></div>
        <div><button id="rosRegen" onclick="rosRegenerate()" title="Rebuild today's roster from current data. The 00:30 run is kept for audit.">Regenerate</button></div>
        <div><button id="rosPrint" onclick="window.print()">Print</button></div>
        <div><button id="rosDivAi" onclick="rosOpenDivAI()">Ask AI</button></div>
        <div class="ros-ver">roster v3 &middot; @rosterVer</div>
    </div>

    <div id="rosNote" class="ros-note info hide"></div>

    <div id="rosRollup"></div>
    <div id="rosSheet" class="hide"></div>

    <dialog class="apdlg" id="rosAlOv" onclick="if(event.target===this)rosAlPopClose()" oncancel="rosAlPopClose()"><div class="apwrap" id="rosAlMod"></div></dialog>
    <dialog class="aidlg" id="rosAiOv" onclick="if(event.target===this)rosCloseAI()" oncancel="rosCloseAI()"><div class="aimodal" id="rosAiModal"></div></dialog>
    <dialog class="aidlg" id="rosMetOv" onclick="if(event.target===this)rosMetClose()" oncancel="rosMetClose()"><div class="aimodal" id="rosMetModal"></div></dialog>

</div>

<script>
    var ROS = {
        rollup: '@Url.Action("GetRollup", "MaintenceRoster", new { area = "FRS25" })',
        sheet:  '@Url.Action("GetWorksheet", "MaintenceRoster", new { area = "FRS25" })',
        regen:  '@Url.Action("Regenerate", "MaintenceRoster", new { area = "FRS25" })',
        close:  '@Url.Action("CloseItem", "MaintenceRoster", new { area = "FRS25" })',
        live:   '@Url.Action("Live", "MaintenceRoster", new { area = "FRS25" })',
        pm:     '@Url.Action("PmPredict", "MaintenceRoster", new { area = "FRS25" })',
        pmTrend:'@Url.Action("PmTrend", "MaintenceRoster", new { area = "FRS25" })',
        // HOOK: point this at your AiChat per-asset verdict endpoint to light up the AI diagnosis +
        // true/false donut. Leave '' to keep the AI panel in its inert "connect the engine" state.
        // Expected: POST { assetId, siteId, divisionId } -> { Verdict:'CONFIRMED_DEFECT|NO_DEFECT_FOUND|INCONCLUSIVE', Confidence, Reason, Action }
        diagnose: '@Url.Action("AnalyzeChat", "AiChat", new { area = "FRS25" })',
        day: '@Url.Action("DayAlerts", "MaintenceRoster", new { area = "FRS25" })',
        ack: '@Url.Action("AckSummary", "MaintenceRoster", new { area = "FRS25" })',
        rangeHist: '@Url.Action("RangeHistory", "MaintenceRoster", new { area = "FRS25" })',
        pmOps: '@Url.Action("PmOps", "MaintenceRoster", new { area = "FRS25" })',
        trackShort: '@Url.Action("TrackShort", "MaintenceRoster", new { area = "FRS25" })',
        clientLog: '@Url.Action("ClientLog", "MaintenceRoster", new { area = "FRS25" })'
    };
    var rosState = { divisionId: 0, date: '', rollup: null, sheet: null, stnFilter: 'ALL' };
    var ROS_DEBUG = true;   /* set false to silence roster console logging */
    /* ROS_TRACE mirrors the NORMAL flow lines (rosLog) to the server file as well, so the whole
       UI journey interleaves with the controller lines in roster-YYYYMMDD.log. Errors are mirrored
       either way (rosErr). Default OFF: the flow is chatty and the post cap is 80 per page load.
       Turn on per REQUEST with ?trace=1 -- no file edit, no effect on anyone else's session,
       nothing to remember to revert. Web.config appSetting RosTraceUi=true forces it on globally. */
    var ROS_TRACE = @rosterTrace;
    /* The server folds track-short / pm / drift into the persisted Priority at Regenerate time
       (RosCompositeRescore). When that is on, re-fetching the same three signals per asset in the
       browser is pure duplicate work -- the bands are already in Priority. */
    var ROS_SERVER_COMPOSITE = @rosterComposite;
    var ROS_VER = '@rosterVer';   /* running roster component version (from the controller) */
    var _rosLogSent = 0;          /* cap client->server log posts per page load */
    function rosPostLog(level, tag, msg){
        try{ if(!ROS.clientLog || _rosLogSent>80){ return; }
            if(_rosLogSent===80){ _rosLogSent++; level='WARN'; tag='LOGCAP'; msg='client log cap (80) reached -- further UI failures on this page load are console-only'; }
            else { _rosLogSent++; }
            fetch(ROS.clientLog,{ method:'POST', credentials:'same-origin', headers:{'Content-Type':'application/json'},
                body:JSON.stringify({ level:level||'ERROR', tag:tag||'', msg:String(msg==null?'':msg).slice(0,1000), ver:ROS_VER, url:(typeof location!=='undefined'?location.href:'') }) }).catch(function(){});
        }catch(_e){} }
    function rosLog(tag, msg){ try{ if(ROS_DEBUG && typeof console!=='undefined' && console.log){ console.log('[ROS v'+ROS_VER+']['+tag+'] '+msg); } }catch(_e){}
        if(ROS_TRACE){ rosPostLog('INFO', tag, msg); } }
    function rosErr(tag, ex){ var m=((ex&&ex.message)||ex);
        try{ if(ROS_DEBUG && typeof console!=='undefined' && console.error){ console.error('[ROS v'+ROS_VER+']['+tag+'] '+m); } }catch(_e){}
        rosPostLog('ERROR', tag, m); }
    // GLOBAL catch-all: any uncaught error / logic failure / unhandled promise -> logged + mirrored to the server log.
    try{ if(typeof window!=='undefined' && window.addEventListener){
        window.addEventListener('error', function(e){ try{ var m=(e&&e.message)||'script error'; var at=(e&&e.filename?(' @@ '+e.filename+':'+(e.lineno||0)+':'+(e.colno||0)):''); if(ROS_DEBUG&&console&&console.error){ console.error('[ROS v'+ROS_VER+'][WINDOW] '+m+at); } rosPostLog('ERROR','WINDOW',m+at); }catch(_x){} });
        window.addEventListener('unhandledrejection', function(e){ try{ var r=(e&&e.reason)||{}; var m=(r&&r.message)||r; if(ROS_DEBUG&&console&&console.error){ console.error('[ROS v'+ROS_VER+'][PROMISE] '+m); } rosPostLog('ERROR','PROMISE',m); }catch(_x){} });
    } }catch(_e){}
    rosLog('VERSION','roster view v'+ROS_VER+' ready (trace='+(ROS_TRACE?'on':'off')+', serverComposite='+(ROS_SERVER_COMPOSITE?'on':'off')+')');
    if(ROS_TRACE){ rosPostLog('INFO','TRACE','UI trace ON -- flow lines are being mirrored to the server log'); }

    function rosEsc(s){ return String(s == null ? '' : s)
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
    // The API is PascalCase; read defensively so a serializer setting cannot blank the page.
    function rosF(o, names, dflt){ if(!o){return dflt;}
        for(var i=0;i<names.length;i++){ if(o[names[i]]!==undefined && o[names[i]]!==null){return o[names[i]];} } return dflt; }
    function rosNote(kind, msg){ var el=document.getElementById('rosNote');
        if(!msg){ el.className='ros-note hide'; el.innerHTML=''; return; }
        el.className='ros-note '+kind; el.innerHTML=rosEsc(msg); }
    function rosToday(){ var d=new Date(),p=function(n){return (n<10?'0':'')+n;};
        return d.getFullYear()+'-'+p(d.getMonth()+1)+'-'+p(d.getDate()); }
    /* ONE place where every api failure is punched: http status, url, and the first 200 chars of
       whatever the server actually sent (html error page / login redirect / empty body). */
    function rosReadJson(r, url){
        var st=(r&&r.status)||0, ok=!!(r&&r.ok), rd=!!(r&&r.redirected);
        return r.text().then(function(t){
            if(!ok){ rosErr('HTTP', st+' '+url+' body='+String(t||'').slice(0,200)); }
            else if(rd){ rosErr('HTTP','redirected (session?) '+url); }
            try{ return JSON.parse(t); }
            catch(_e){ rosErr('HTTP','bad json '+st+' '+url+' body='+String(t||'').slice(0,200));
                throw new Error(ok?('Bad reply from server ('+st+')'):('Server returned '+st)); } }); }
    function rosGet(url){ return fetch(url,{credentials:'same-origin'}).then(function(r){ return rosReadJson(r,url); }); }
    function rosPost(url, body){ var form=new URLSearchParams();
        for(var k in body){ if(Object.prototype.hasOwnProperty.call(body,k)){ form.append(k, body[k]); } }
        return fetch(url,{ method:'POST', credentials:'same-origin',
            headers:{'Content-Type':'application/x-www-form-urlencoded; charset=UTF-8'}, body:form.toString()
        }).then(function(r){ return rosReadJson(r,url); }); }
    function rosPostJson(url, body){ return fetch(url,{ method:'POST', credentials:'same-origin',
        headers:{'Content-Type':'application/json; charset=UTF-8'}, body:JSON.stringify(body)
    }).then(function(r){ return rosReadJson(r,url); }); }
    function rosBusy(on){ ['rosLoad','rosRegen'].forEach(function(id){ var b=document.getElementById(id); if(b){b.disabled=!!on;} }); }

    // A run that read fewer alerts than existed must never look complete, and a FAILED run must say so.
    function rosRunLine(run, message){
        if(!run){ return message?'<span class="rc">'+rosEsc(message)+'</span>':''; }
        var gen=rosF(run,['GeneratedAtIst','generatedAtIst'],'');
        var by=rosF(run,['GeneratedBy','generatedBy'],'');
        var rid=rosF(run,['RunId','runId'],0);
        var read=rosF(run,['AlertsRead','alertsRead'],null), total=rosF(run,['AlertsTotal','alertsTotal'],null);
        var note=rosF(run,['SourceNote','sourceNote'],'');
        var tip=[]; if(by){ tip.push(by); } if(note){ tip.push(note); }
        var h='';
        if(gen){ h+='<span class="rc">generated '+rosEsc(String(gen).replace('T',' ').substring(0,16))+'</span>'; }
        if(rid){ h+='<span class="rc">run #'+rid+'</span>'; }
        if(read!==null && total!==null){
            if(read<total){ h+='<span class="rc warn">alerts read '+read+' / '+total+' \u00b7 partial \u2014 ranking may be incomplete</span>'; }
            else { h+='<span class="rc ok">alerts read '+read+' / '+total+'</span>'; } }
        return '<span class="rosrun"'+(tip.length?' title="'+rosEsc(tip.join(' \u00b7 '))+'"':'')+'>'+h+'</span>'; }

    // ---------- roll-up ----------
    function rosLoadRollup(){
        var div=parseInt(document.getElementById('rosDiv').value,10)||0;
        var date=document.getElementById('rosDate').value||rosToday();
        if(!div){ rosNote('err','Select a division first.'); return; }
        rosState.divisionId=div; rosState.date=date; rosState.stnFilter='ALL';
        document.getElementById('rosSheet').className='hide';
        document.getElementById('rosRollup').className='';
        rosBusy(true); rosNote('','');
        rosGet(ROS.rollup+'?divisionId='+div+'&rosterDate='+encodeURIComponent(date))
            .then(function(j){ rosState.rollup=j; rosLog('ROLLUP','div='+rosState.divisionId+' date='+rosState.date+' ok='+rosF(j,['IsSuccess','isSuccess'],false)); try{ rosRenderRollup(j); }catch(_e){ rosErr('RENDER-ROLLUP',_e); rosNote('err','Could not render the roster.'); } })
            .catch(function(e){ rosErr('ROLLUP','div='+div+' date='+date+' '+((e&&e.message)||e)); rosNote('err','Roll-up unavailable: '+e.message); })
            .then(function(){ rosBusy(false); });
    }

    function rosKpi(label, value, cls, filter){
        var click=filter?' click'+(rosState.stnFilter===filter?' on':''):'';
        var oc=filter?(' onclick="rosStnFilter(\''+filter+'\')"'):'';
        return '<div class="kpi'+click+'"'+oc+'><div class="k">'+rosEsc(label)+'</div><div class="v '+cls+'">'+value+'</div></div>';
    }

    function rosRenderRollup(j){
        var host=document.getElementById('rosRollup'); rosStnOpen={};
        var ok=rosF(j,['IsSuccess','isSuccess'],false), msg=rosF(j,['Message','message'],'');
        var run=rosF(j,['Run','run'],null);
        if(!ok){ host.innerHTML='<div class="ros-empty">No roster for this division and date. Press Regenerate to build one.</div>';
            rosNote('err', msg||'The roll-up could not be loaded.'); return; }
        if(msg && msg!=='Success'){ rosNote('warn', msg); } else { rosNote('',''); }

        var stations=rosF(j,['Stations','stations'],[])||[];
        var fr=rosF(j,['FailedRepairCount','failedRepairCount'],0);
        var urg=rosF(j,['UrgentCount','urgentCount'],0), soon=rosF(j,['SoonCount','soonCount'],0);
        var mon=0; for(var m=0;m<stations.length;m++){ mon+=rosF(stations[m],['MonitorCount','monitorCount'],0); }
        var oldd=rosF(j,['OldestOpenDays','oldestOpenDays'],0);
        var closed=rosF(j,['ClosedYesterday','closedYesterday'],0), yitems=rosF(j,['ItemsYesterday','itemsYesterday'],0);

        var h='<div class="ros-meta">'+rosRunLine(run, msg)+'</div>';
        h+='<div class="ros-kpis">'
          + rosKpi('Failed repairs', fr, fr>0?'u':'n', fr>0?'FAILED':null)
          + rosKpi('Urgent', urg, urg>0?'u':'n', 'URGENT')
          + rosKpi('Soon', soon, soon>0?'s':'n', 'SOON')
          + rosKpi('Monitor', mon, mon>0?'m':'n', 'MONITOR')
          + rosKpi('Oldest open', oldd+' d', 'n', null)
          + rosKpi('Closed yesterday', closed+' / '+yitems, closed>0?'m':'n', null)
          + '</div>';

        if(!stations.length){ h+='<div class="stns"><div class="ros-empty" style="border:0">No items in this roster -- every asset is clear or resolved.</div></div>';
            host.innerHTML=h; return; }

        var rows=stations.slice().sort(function(a,b){ return rosStnRank(a)-rosStnRank(b); });

        h+='<div class="stns dss">';
        for(var i=0;i<rows.length;i++){
            var st=rows[i]; if(!rosStnPass(st)){ continue; }
            h+=rosDcard(st);
        }
        h+='</div>';
        host.innerHTML=h;
        for(var q=0;q<rows.length;q++){ var q1=rosF(rows[q],['SiteId','siteId'],0); if(rosStnOpen[q1]){ rosDsDraw(q1); } }
    }

    /* One card per station. Everything on it is a projection of the persisted roster --
       counts, families and the named urgent assets all come from the roll-up, so the card
       is correct on the first Load, not only after a Regenerate. */
    function rosDcard(st){
        var sid=rosF(st,['SiteId','siteId'],0);
        var u=rosF(st,['UrgentCount','urgentCount'],0), so=rosF(st,['SoonCount','soonCount'],0), mo=rosF(st,['MonitorCount','monitorCount'],0);
        var tot=rosF(st,['AssetCount','assetCount'],0)||(u+so+mo);
        var old=rosF(st,['OldestOpenDays','oldestOpenDays'],0);
        var op=!!rosStnOpen[sid], selK=rosStnCol[sid]||'';

        var c={ all:tot,
                alert:rosF(st,['TrackAlert','trackAlert'],0)+rosF(st,['SignalAlert','signalAlert'],0)
                     +rosF(st,['PointAlert','pointAlert'],0)+rosF(st,['OtherAlert','otherAlert'],0),
                trackAlert:rosF(st,['TrackAlert','trackAlert'],0),
                signalAlert:rosF(st,['SignalAlert','signalAlert'],0),
                pointAlert:rosF(st,['PointAlert','pointAlert'],0),
                trackShort:rosF(st,['TrackShortCount','trackShortCount'],0),
                pointPm:rosF(st,['PointPmCount','pointPmCount'],0),
                drift:rosF(st,['DriftCount','driftCount'],0),
                swept:rosF(st,['SweptCount','sweptCount'],0) };
        c.urgent=u;
        rosStnCounts[sid]=c;

        /* the proportion bar -- guard against a zero total so it renders flat, not broken */
        var den=(u+so+mo)||1;
        var bar='<div class="dbar">'
            +(u?'<i class="u" style="flex:'+u+'"></i>':'')
            +(so?'<i class="s" style="flex:'+so+'"></i>':'')
            +(mo?'<i class="m" style="flex:'+mo+'"></i>':'')
            +((u+so+mo)===0?'<i class="m" style="flex:1"></i>':'')+'</div>';

        /* Every chip opens the urgent list. A name with no way through to the asset is a
           dead end, and "+N more urgent" is the one place an operator most wants to click. */
        var chips='', go=' onclick="event.stopPropagation();rosMetOpen('+sid+',\'urgent\')"'
                       + ' title="Show every urgent asset at this station"';
        var top=rosF(st,['TopUrgent','topUrgent'],null);
        if(top&&top.length){
            for(var t=0;t<top.length&&t<3;t++){ chips+='<span class="dchip"'+go+'>'+rosEsc(top[t])+'</span>'; }
            if(u>top.length){ chips+='<span class="dchip more"'+go+'>+'+(u-top.length)+' more urgent</span>'; }
        } else {
            var worst=rosF(st,['WorstItem','worstItem'],'');
            if(worst){ chips+='<span class="dchip"'+go+'>'+rosEsc(worst)+'</span>';
                if(u>1){ chips+='<span class="dchip more"'+go+'>+'+(u-1)+' more urgent</span>'; } }
        }

        return '<div class="dcard'+(op?' open':'')+'">'
          +'<div class="dchd" onclick="rosOpenSheet('+sid+')" title="Open the station worksheet">'
            +'<b>'+rosEsc(rosF(st,['StationName','stationName'],'Station '+sid))+'</b>'
            +'<span class="sid">site '+sid+'</span>'
            +'<span class="rt">'+tot+' asset'+(tot===1?'':'s')+' \u00b7 oldest '+old+'d</span>'
            +'<span class="cv" title="Show every job at this station" onclick="event.stopPropagation();rosDsToggle('+sid+')">\u25B8</span></div>'
          +bar
          +'<div class="dmix"><span class="u" onclick="event.stopPropagation();rosMetOpen('+sid+',\'urgent\')"'
            +' title="Show every urgent asset at this station">'+u+' urgent</span> \u00b7 '
            +'<span class="s">'+so+' soon</span> \u00b7 '+mo+' monitor</div>'
          +'<div class="dwhy">Why each asset is on the list \u00b7 an asset can carry more than one</div>'
          +'<div class="dmet">'
            +rosDmet(sid,'alert','Alert',c.alert,'cool',selK)
            +rosDmet(sid,'trackShort','Track shorting',c.trackShort,'hot',selK)
            +rosDmet(sid,'pointPm','PM predict',c.pointPm,'warm',selK)
            +rosDmet(sid,'drift','Avg drift',c.drift,'warm',selK)
          +'</div>'
          +(chips?'<div class="dchips">'+chips+'</div>':'')
          +'<div class="dfoot"><b>'+c.alert+'</b> with an alert \u00b7 <b>'+c.swept+'</b> found by sweep only'
            +' \u00b7 Track '+c.trackAlert+' \u00b7 Point '+c.pointAlert+' \u00b7 Signal '+c.signalAlert+'</div>'
          +'<div class="dsdrop'+(op?' on':'')+'" id="stnexp-'+sid+'" onclick="event.stopPropagation()"></div>'
          +'</div>';
    }

    /* ---------- avg-drift trend ----------
       Values come from FRSAttributeRangeHistory via the RangeHistory proxy, which now returns
       the AvgValues series (downsampled to 80 points) alongside the summary. Fetched per asset,
       cached, and drawn only inside the drift popup -- the same window the rescore scored on. */
    var rosDriftFull={}, rosDriftFullBusy={};
    function rosDriftLoad(aid, cb){
        if(!aid||!ROS.rangeHist){ if(cb){cb();} return; }
        if(rosDriftFull[aid]||rosDriftFullBusy[aid]){ if(cb){cb();} return; }
        rosDriftFullBusy[aid]=true; var w=rosDriftWindow();
        rosGet(ROS.rangeHist+'?assetId='+aid+'&start='+w.s+'&end='+w.e).then(function(j){
            rosDriftFullBusy[aid]=false;
            rosDriftFull[aid]={ attrs:(rosF(j,['attrs','Attrs'],[])||[]),
                drift:rosF(j,['drift','Drift'],0), dir:rosF(j,['dir','Dir'],''),
                worst:rosF(j,['worstAttr','WorstAttr'],''), band:rosF(j,['band','Band'],''),
                use:rosF(j,['safeBandUse','SafeBandUse'],0), useAttr:rosF(j,['safeBandAttr','SafeBandAttr'],''),
                edge:rosF(j,['safeBandEdge','SafeBandEdge'],''), err:rosF(j,['error','Error'],'') };
            rosLog('DRIFT','asset='+aid+' attrs='+rosDriftFull[aid].attrs.length+' drift='+rosDriftFull[aid].drift+'%');
            if(cb){cb();}
        }).catch(function(ex){ rosDriftFullBusy[aid]=false; rosErr('DRIFT','asset='+aid+' '+((ex&&ex.message)||ex));
            rosDriftFull[aid]={ attrs:[], err:(ex&&ex.message)||'fetch failed' }; if(cb){cb();} }); }

    /* one attribute: the series, with the safe band shaded and the limits ruled. Everything is
       scaled to include the band, so a value sitting ON a limit is visibly on it. */
    function rosDriftSvg(a){
        var v=a.vals||[]; if(v.length<2){ return ''; }
        var w=520, h=64, pad=4;
        var lo=Math.min.apply(null,v), hi=Math.max.apply(null,v);
        var hasB=(a.min!==null&&a.min!==undefined&&a.max!==null&&a.max!==undefined&&(a.max-a.min)>1e-9);
        if(hasB){ lo=Math.min(lo,a.min); hi=Math.max(hi,a.max); }
        var sp=(hi-lo)||1;
        function Y(val){ return pad+(h-2*pad)-((val-lo)/sp*(h-2*pad)); }
        function X(i){ return v.length===1?0:(i/(v.length-1)*w); }
        var d='',i; for(i=0;i<v.length;i++){ d+=(i?' L':'M')+X(i).toFixed(1)+' '+Y(v[i]).toFixed(1); }
        var band='';
        if(hasB){ var yTop=Y(a.max), yBot=Y(a.min);
            band='<rect x="0" y="'+yTop.toFixed(1)+'" width="'+w+'" height="'+Math.max(1,(yBot-yTop)).toFixed(1)+'"'
                +' fill="var(--okbg)"/>'
                +'<line x1="0" y1="'+yTop.toFixed(1)+'" x2="'+w+'" y2="'+yTop.toFixed(1)+'" stroke="var(--okln)" stroke-width="1" stroke-dasharray="3 3"/>'
                +'<line x1="0" y1="'+yBot.toFixed(1)+'" x2="'+w+'" y2="'+yBot.toFixed(1)+'" stroke="var(--okln)" stroke-width="1" stroke-dasharray="3 3"/>'; }
        var col=(a.skipped?'var(--ink3)':(Math.abs(a.drift)>=50?'var(--urgent)':(Math.abs(a.drift)>=25?'var(--soon)':'var(--blue)')));
        return '<svg class="drsvg" viewBox="0 0 '+w+' '+h+'" preserveAspectRatio="none">'+band
             +'<path d="'+d+'" fill="none" stroke="'+col+'" stroke-width="1.6" stroke-linejoin="round"/></svg>'; }

    function rosDriftPanel(it){
        var aid=rosF(it,['AssetId','assetId'],0);
        var nm=rosEsc(rosF(it,['AssetName','assetName'],'Asset'));
        var d=rosDriftFull[aid];
        if(!d){ rosDriftLoad(aid, function(){ if(rosMetSid&&rosMetKey==='drift'){ rosMetRender(); } });
            return '<div class="drpan"><div class="drhd"><b>'+nm+'</b><span>reading the trend \u2026</span></div></div>'; }
        if(d.err){ return '<div class="drpan"><div class="drhd"><b>'+nm+'</b><span class="bad">trend unavailable \u2014 '+rosEsc(d.err)+'</span></div></div>'; }

        var attrs=(d.attrs||[]).slice().sort(function(x,y){ return Math.abs(y.drift||0)-Math.abs(x.drift||0); });
        if(!attrs.length){ return '<div class="drpan"><div class="drhd"><b>'+nm+'</b><span>no attributes returned for this window</span></div></div>'; }

        var h='<div class="drpan"><div class="drhd"><b>'+nm+'</b>'
            +'<span>worst <b>'+rosEsc(d.worst||'-')+'</b> '+rosEsc(String(d.drift))+'% '+rosEsc(d.dir||'')+'</span>'
            +(d.use?('<span>safe band '+rosEsc(String(Math.round(d.use)))+'% toward '+rosEsc(d.edge||'-')+'</span>'):'')
            +(d.band?('<span class="bd '+(d.band==='URGENT'?'u':'s')+'">'+rosEsc(d.band)+'</span>'):'')+'</div>';
        var i, shown=0;
        for(i=0;i<attrs.length&&shown<4;i++){ var a=attrs[i];
            var svg=rosDriftSvg(a); if(!svg){ continue; } shown++;
            h+='<div class="drrow"><span class="nm">'+rosEsc(a.attr||'')
                +'<i>'+(a.skipped?rosEsc(a.skipped):(rosEsc(String(a.drift))+'% '+rosEsc(a.dir||'')))+'</i></span>'
              +svg
              +'<span class="mm">'+rosEsc(rosFmtVal(a.min))+' \u2013 '+rosEsc(rosFmtVal(a.max))
                +'<i>avg '+rosEsc(rosFmtVal(a.avg))+' \u00b7 n='+(a.n||0)+'</i></span></div>'; }
        if(!shown){ h+='<div class="rpmclazy">No attribute on this asset has enough samples to draw.</div>'; }
        else if(attrs.length>shown){ h+='<div class="rpmclazy">+'+(attrs.length-shown)+' more attribute(s) not drawn.</div>'; }
        return h+'</div>'; }

    /* ---------- metric popup ----------
       Each card on the landing page opens the assets behind its number. The counts come
       from the roll-up (persisted, so correct on first Load); the asset list comes from
       the station worksheet, fetched once per site and shared with the inline drop. */
    var rosMetSid=0, rosMetKey='';
    var ROS_MET=[['urgent','Urgent','at urgent priority, or a repair that did not hold'],
                 ['alert','Alert','with an alert against them'],
                 ['trackShort','Track shorting','raised by the track-shorting predictor'],
                 ['pointPm','PM predict','raised by the point-machine prediction'],
                 ['drift','Avg drift','raised by average-value drift or safe-band proximity'],
                 ['swept','Sweep only','no alert -- found by the site sweep'],
                 ['all','All jobs','every job on this station roster']];
    function rosMetLabel(k){ for(var i=0;i<ROS_MET.length;i++){ if(ROS_MET[i][0]===k){ return ROS_MET[i]; } }
        return [k,k,'']; }
    function rosMetDlg(on){ var d=document.getElementById('rosMetOv'); if(!d){ return; }
        if(on){ if(d.showModal){ if(!d.open){ d.showModal(); } } else { d.setAttribute('open',''); } }
        else { if(d.close){ if(d.open){ d.close(); } } else { d.removeAttribute('open'); } } }
    function rosMetClose(){ rosMetSid=0; rosMetKey=''; rosMetDlg(false); }
    function rosMetOpen(sid, key){
        rosMetSid=sid; rosMetKey=key||'all';
        rosMetDlg(true); rosMetRender();
        if(!rosStnPeek[sid]&&!rosStnPeekBusy[sid]){
            rosStnPeekBusy[sid]=true;
            rosGet(ROS.sheet+'?divisionId='+rosState.divisionId+'&siteId='+sid+'&rosterDate='+encodeURIComponent(rosState.date))
                .then(function(j){ rosStnPeekBusy[sid]=false; rosStnPeek[sid]=j;
                    rosLog('METRIC','site='+sid+' key='+key+' items='+((rosF(j,['Items','items'],[])||[]).length));
                    if(rosMetSid===sid){ rosMetRender(); } })
                .catch(function(ex){ rosStnPeekBusy[sid]=false; rosErr('METRIC','site='+sid+' '+((ex&&ex.message)||ex));
                    if(rosMetSid===sid){ rosMetRender(); } }); } }
    function rosMetSwitch(k){ rosMetKey=k; rosMetRender(); }
    function rosMetRender(){
        var m=document.getElementById('rosMetModal'); if(!m||!rosMetSid){ return; }
        var sid=rosMetSid, c=rosStnCounts[sid]||{}, lab=rosMetLabel(rosMetKey);
        var stn='';
        var rl=rosF(rosState.rollup,['Stations','stations'],[])||[];
        for(var q=0;q<rl.length;q++){ if(rosF(rl[q],['SiteId','siteId'],0)===sid){ stn=rosF(rl[q],['StationName','stationName'],''); break; } }

        var tabs=''; for(var t=0;t<ROS_MET.length;t++){ var k=ROS_MET[t][0];
            var n=(k==='all')?(c.all||0):(c[k]||0);
            tabs+='<span class="aitab'+(k===rosMetKey?' on':'')+'" onclick="rosMetSwitch(\''+k+'\')">'
                 +rosEsc(ROS_MET[t][1])+' \u00b7 '+n+'</span>'; }

        var body;
        var j=rosStnPeek[sid];
        if(!j){ body=rosStnPeekBusy[sid]
            ? '<div class="dswait">Reading the station \u2026</div>'
            : '<div class="dsnone">Could not load this station.</div>'; }
        else {
            var items=rosF(j,['Items','items'],[])||[];
            var list=items.filter(function(it){ return rosDsMatch(it,rosMetKey); });
            if(!list.length){ body='<div class="dsnone">'+(rosMetKey==='all'
                ? 'No open items at this station today.'
                : ('No asset at this station is '+rosEsc(lab[2])+'.'))+'</div>'; }
            else { body=''; for(var i=0;i<list.length;i++){ body+=rosDsItem(list[i],sid);
                if(rosMetKey==='drift'){ body+=rosDriftPanel(list[i]); } } }
        }

        m.className='aimodal divwide';
        m.innerHTML='<div class="aidtop"><span class="dt"></span><span class="lbl">'+rosEsc(lab[1])+'</span>'
            +'<button class="aix" onclick="rosMetClose()">\u00d7</button></div>'
          +'<div class="metahd"><b>'+rosEsc(stn||('Station '+sid))+'</b><span>site '+sid+'</span>'
            +'<i>'+rosEsc(lab[2])+'</i></div>'
          +'<div class="aibody"><div class="sec" style="border-bottom:none">'
            +'<div class="aitabs">'+tabs+'</div>'+body+'</div></div>'
          +'<div class="metfoot"><span class="pkopen" onclick="rosMetClose();rosOpenSheet('+sid+')">Open full worksheet \u2192</span></div>';
    }

    /* a metric box -- tapping it opens the drop filtered to that reason */
    function rosDmet(sid, k, label, n, tone, selK){
        n=n||0;
        var v=n>0?('<div class="v '+tone+'">'+n+'</div>'):'<div class="v z">\u2014</div>';
        return '<div class="dm'+(selK===k?' sel':'')+'" onclick="event.stopPropagation();rosMetOpen('+sid+',\''+k+'\')"'
             +' title="Show the assets behind this number">'
             +'<div class="k">'+rosEsc(label)+'</div>'+v+'</div>';
    }

    var rosStnCol={}, rosStnCounts={};
    /* 'all' is the chevron's view -- the whole roster for the station. The five that follow
       are the count columns; tapping a number filters the same list down to it. */
    var ROS_DSCOLS=[['all','All jobs'],['alert','Alert'],['trackShort','Track shorting'],
                    ['pointPm','PM predict'],['drift','Avg drift'],['swept','Sweep only']];

    function rosDsToggle(sid){
        if(rosStnOpen[sid]){ rosStnOpen[sid]=false; rosStnCol[sid]=''; }
        else { rosStnOpen[sid]=true; rosStnCol[sid]='all'; }
        rosLog('PEEK',(rosStnOpen[sid]?'expand (all jobs)':'collapse')+' site='+sid);
        rosRenderRollup(rosState.rollup);
    }
    function rosDsCol(sid,k){
        if(rosStnOpen[sid] && rosStnCol[sid]===k){ rosStnOpen[sid]=false; rosStnCol[sid]=''; }
        else { rosStnOpen[sid]=true; rosStnCol[sid]=k; }
        rosRenderRollup(rosState.rollup);
    }
    function rosDsFirstCol(sid){ return 'all'; }

    /* ---------- coverage view ----------
       Which analysis could SEE each asset, and which actually fired. Three states, and the
       difference between the last two is the whole point of the panel:
         fired  -- the analysis ran and raised a band
         clear  -- it ran and found nothing
         n/a    -- it does not exist for this family, so silence means nothing
       Reading "PM predict: 0" as good news on a track is exactly the mistake this prevents.

       Everything here is derived from the roster items themselves. The one number that is not
       is "scanned" -- how many assets the asset-first loop walked -- which the API supplies as
       ScannedCount when present and is simply omitted when it is not. */

    var ROS_CVFAM=[['Track','Track'],['Point','Point'],['Signal','Signal'],['Other','Other']];

    function rosCvFam(it){
        var f=String(rosF(it,['AssetFamily','assetFamily'],'')||'');
        if(f){ return f; }
        return rosFamily(it, rosEvi(it)); }

    /* Does this analysis exist for this family at all? The distinction carries the panel:
       "PM predict 0" on a track would read as good news, when in fact nothing looked. */
    function rosCvApplies(fam, k){
        if(k==='alert'||k==='drift'){ return true; }
        if(k==='track'){ return fam==='Track'; }
        if(k==='pm'){ return fam==='Point'; }
        return false; }

    /* An asset the budget cut off. Not the same as clear -- one means the track is fine, the
       other means nobody looked at it. */
    function rosCvMissed(it){ return !!rosF(it,['NotScored','notScored'],false); }

    /* The band THIS analysis produced, so a badge is shaded by its own verdict rather than by
       which analysis it is. '' = ran and found nothing. */
    function rosCvBand(it, k){
        if(k==='alert'){
            if(rosF(it,['IsSwept','isSwept'],false)){ return ''; }
            return String(rosF(it,['Priority','priority'],'')||'').toUpperCase(); }
        if(k==='track'){ return String(rosF(it,['TrackShortBand','trackShortBand'],'')||'').toUpperCase(); }
        if(k==='pm'){ return String(rosF(it,['PmBand','pmBand'],'')||'').toUpperCase(); }
        if(k==='drift'){ return String(rosF(it,['DriftBand','driftBand'],'')||'').toUpperCase(); }
        return ''; }
    function rosCvTone(b){ return b==='URGENT'?'u':(b==='SOON'?'s':''); }
    function rosCvFired(it,k){ var t=rosCvTone(rosCvBand(it,k)); return t==='u'||t==='s'; }

    function rosCvMatrix(items){
        var fams={}, i, ks=['alert','track','pm','drift'], k;
        for(i=0;i<items.length;i++){ var f=rosCvFam(items[i]);
            if(!fams[f]){ fams[f]={ n:0, miss:0 };
                for(k=0;k<ks.length;k++){ fams[f][ks[k]]={ u:0, s:0, miss:0 }; } }
            var d=fams[f]; d.n++;
            var missed=rosCvMissed(items[i]);
            for(k=0;k<ks.length;k++){ var kk=ks[k];
                if(!rosCvApplies(f,kk)){ continue; }
                if(missed && kk!=='alert'){ d[kk].miss++; continue; }
                var t=rosCvTone(rosCvBand(items[i],kk));
                if(t==='u'){ d[kk].u++; } else if(t==='s'){ d[kk].s++; } } }

        var h='<div class="cvgrid"><span></span>'
             +'<span class="h">Alert</span><span class="h">Track short</span>'
             +'<span class="h">PM predict</span><span class="h">Avg drift</span>';
        var any=false;
        for(i=0;i<ROS_CVFAM.length;i++){ var fam=ROS_CVFAM[i][0], d2=fams[fam];
            if(!d2){ continue; }
            any=true;
            h+='<span class="rl">'+rosEsc(ROS_CVFAM[i][1])+'<i>'+d2.n+'</i></span>';
            for(k=0;k<ks.length;k++){ h+=rosCvCell(fam, ks[k], d2[ks[k]], d2.n); } }
        return any?(h+'</div>'):''; }

    function rosCvCell(fam, k, c, total){
        if(!rosCvApplies(fam,k)){
            return '<span class="cvc na" title="no analysis of this kind for '+rosEsc(fam)+'">n/a</span>'; }
        if(c.miss>0 && (c.u+c.s)===0){
            return '<span class="cvc miss" title="the run ran out of time before these were scored">'
                 +c.miss+' not scored</span>'; }
        var fired=c.u+c.s;
        var bar='';
        if(fired>0){ bar='<span class="sp">'
            +(c.u?'<i class="u" style="flex:'+c.u+'"></i>':'')
            +(c.s?'<i class="s" style="flex:'+c.s+'"></i>':'')
            +'<i style="flex:'+(total-fired)+'"></i></span>'; }
        return '<span class="cvc'+(fired>0?' hit':'')+'" title="'+c.u+' urgent, '+c.s+' soon, of '
             +total+' '+rosEsc(fam)+' on the roster'+(c.miss?(' \u00b7 '+c.miss+' not scored'):'')+'">'
             +fired+' / '+total+bar+'</span>'; }

    /* Three fixed slots: Alert, the family's own predictor, Drift. Fixed on purpose -- the eye
       learns one position per analysis, and a shifting layout would defeat that. */
    function rosCvSlot(it, fam, k, letter){
        if(!rosCvApplies(fam,k)){
            return '<span class="sl na" title="no analysis of this kind for '+rosEsc(fam)+'">\u00b7</span>'; }
        if(rosCvMissed(it) && k!=='alert'){
            return '<span class="sl miss" title="not scored -- the run ran out of time">?</span>'; }
        var t=rosCvTone(rosCvBand(it,k));
        if(t){ return '<span class="sl b-'+t+'" title="'+rosEsc(k)+' \u2014 '
            +rosEsc(rosCvBand(it,k))+'">'+letter+'</span>'; }
        return '<span class="sl" title="'+rosEsc(k)+' ran, found nothing">'+letter+'</span>'; }

    function rosCvAgree(it, fam){
        var mid=fam==='Track'?'track':(fam==='Point'?'pm':'');
        var ran=1+(mid?1:0)+1;
        var fired=(rosCvFired(it,'alert')?1:0)+(mid&&rosCvFired(it,mid)?1:0)+(rosCvFired(it,'drift')?1:0);
        return { ran:ran, fired:fired, mid:mid }; }

    function rosCvVerdict(it, fam){
        var a=rosCvAgree(it,fam), label=fam.toLowerCase();
        if(rosCvMissed(it)){ return label+' \u00b7 not scored'; }
        if(!a.mid){ return label+' \u00b7 no predictor exists'; }
        if(rosF(it,['IsSwept','isSwept'],false)){ return label+' \u00b7 sweep only'; }
        if(a.fired===1&&rosCvFired(it,'alert')){ return label+' \u00b7 alert only'; }
        return label+' \u00b7 '+a.fired+' of '+a.ran+' agree'; }

    function rosCvAssets(items, sid){
        /* worst first, then the ones the most analyses agree on -- a single-signal URGENT and a
           three-signal URGENT are not the same job to send a crew to */
        var rows=items.slice().sort(function(x,y){
            var px=rosPrank(rosF(x,['Priority','priority'],'MONITOR'));
            var py=rosPrank(rosF(y,['Priority','priority'],'MONITOR'));
            if(px!==py){ return px-py; }
            var ax=rosCvAgree(x,rosCvFam(x)).fired, ay=rosCvAgree(y,rosCvFam(y)).fired;
            return ay-ax; });

        var h='', i;
        for(i=0;i<rows.length;i++){ var it=rows[i], fam=rosCvFam(it);
            var pri=String(rosF(it,['Priority','priority'],'MONITOR')).toUpperCase();
            var pc=pri==='URGENT'?'u':(pri==='SOON'?'s':'m');
            var midK=fam==='Track'?'track':(fam==='Point'?'pm':'none');
            var midL=fam==='Track'?'T':(fam==='Point'?'P':'\u00b7');
            h+='<div class="cvrow '+pc+'" onclick="rosMetClose();rosOpenSheet('+sid+')">'
              +'<span class="an">'+rosEsc(rosF(it,['AssetName','assetName'],'Asset'))+'</span>'
              +'<span class="pb '+pc+'">'+rosEsc(pri)+'</span>'
              +'<span class="cvslots">'
                +rosCvSlot(it,fam,'alert','A')
                +rosCvSlot(it,fam,midK,midL)
                +rosCvSlot(it,fam,'drift','D')
              +'</span>'
              +'<span class="vd">'+rosEsc(rosCvVerdict(it,fam))+'</span></div>'; }
        return h; }

    function rosPrank(p){ p=String(p||'').toUpperCase();
        return p==='URGENT'?1:(p==='SOON'?2:3); }

    function rosCvPanel(sid, station, items, scanned){
        var u=0,so=0,mo=0,i;
        for(i=0;i<items.length;i++){ var r=rosPrank(rosF(items[i],['Priority','priority'],'MONITOR'));
            if(r===1){ u++; } else if(r===2){ so++; } else { mo++; } }

        var h='<div class="cvhd"><b>'+rosEsc(station||('Station '+sid))+'</b>'
            +'<span class="sid">site '+sid+'</span>'
            +'<span class="rt">'+items.length+' on roster'
            +(scanned>0?(' \u00b7 '+scanned+' scanned'):'')+'</span></div>';
        h+='<div class="cvbar">'
            +(u?'<i class="u" style="flex:'+u+'"></i>':'')
            +(so?'<i class="s" style="flex:'+so+'"></i>':'')
            +(mo?'<i class="m" style="flex:'+mo+'"></i>':'')
            +((u+so+mo)===0?'<i class="m" style="flex:1"></i>':'')+'</div>';
        h+='<div class="cvmix"><span class="u">'+u+' urgent</span> \u00b7 <span class="s">'+so
            +' soon</span> \u00b7 '+mo+' monitor</div>';
        h+='<div class="cvcap">What each analysis can see \u00b7 bar splits urgent from soon</div>'
            +rosCvMatrix(items);
        h+='<div class="cvcap">Per asset \u00b7 ordered by priority, then by agreement</div>'
            +rosCvAssets(items, sid);
        h+='<div class="cvlgd">Badge shade = that analysis\u0027s own band \u00b7 grey = ran, clear'
            +' \u00b7 dashed = no analysis for this family</div>';
        return h; }

    /* The drop lists the ACTUAL assets behind the number. The counts come from the roll-up,
       but the assets live on the worksheet, so it is fetched once per site and cached. */
    function rosDsDraw(sid){ var el=document.getElementById('stnexp-'+sid); if(!el){ return; }
        var j=rosStnPeek[sid];
        if(!j){
            el.innerHTML='<div class="dswait">Reading the station \u2026</div>';
            if(rosStnPeekBusy[sid]){ return; } rosStnPeekBusy[sid]=true;
            rosGet(ROS.sheet+'?divisionId='+rosState.divisionId+'&siteId='+sid+'&rosterDate='+encodeURIComponent(rosState.date))
                .then(function(r){ rosStnPeekBusy[sid]=false; rosStnPeek[sid]=r;
                    rosLog('PEEK','site='+sid+' items='+((rosF(r,['Items','items'],[])||[]).length));
                    if(rosStnOpen[sid]){ rosDsDraw(sid); } })
                .catch(function(ex){ rosStnPeekBusy[sid]=false; rosErr('PEEK','site='+sid+' '+((ex&&ex.message)||ex));
                    var e2=document.getElementById('stnexp-'+sid); if(e2){ e2.innerHTML='<div class="dsnone">Could not load this station.</div>'; } });
            return; }

        var items=rosF(j,['Items','items'],[])||[];
        var cur=rosStnCol[sid]||rosDsFirstCol(sid);

        /* the chevron opens the coverage view; a metric cell still opens its filtered list */
        if(cur==='all'){
            var stn2='', rl2=rosF(rosState.rollup,['Stations','stations'],[])||[];
            for(var z=0;z<rl2.length;z++){ if(rosF(rl2[z],['SiteId','siteId'],0)===sid){
                stn2=rosF(rl2[z],['StationName','stationName'],'');
                var sc=rosF(rl2[z],['ScannedCount','scannedCount'],0);
                el.innerHTML=rosCvPanel(sid, stn2, items, sc); return; } }
            el.innerHTML=rosCvPanel(sid, '', items, 0); return; }
        var c=rosStnCounts[sid]||{};
        var tabs=''; for(var t=0;t<ROS_DSCOLS.length;t++){ var k=ROS_DSCOLS[t][0];
            tabs+='<button aria-pressed="'+(k===cur?'true':'false')+'" onclick="event.stopPropagation();rosDsCol('+sid+',\''+k+'\')">'
                 +ROS_DSCOLS[t][1]+'<b>'+(c[k]||0)+'</b></button>'; }

        var list=items.filter(function(it){ return rosDsMatch(it,cur); });
        var body='';
        if(!list.length){ body='<div class="dsnone">'+(cur==='all'
            ? 'No open items at this station today.'
            : ('Nothing under '+ROS_DSCOLS.filter(function(x){return x[0]===cur;})[0][1].toLowerCase()+' at this site today.'))+'</div>'; }
        else { for(var i2=0;i2<list.length;i2++){ body+=rosDsItem(list[i2],sid); } }
        el.innerHTML='<div class="dsseg">'+tabs+'</div>'+body
            +'<div class="pkopen" onclick="rosOpenSheet('+sid+')">Open full worksheet \u2192</div>';
    }

    function rosDsFam(it){ var f=rosF(it,['AssetFamily','assetFamily'],''); if(f){ return f; }
        return rosFamily(it, rosEvi(it)); }
    function rosDsMatch(it,k){
        if(k==='all'){ return true; }
        var swept=rosF(it,['IsSwept','isSwept'],false);
        /* An asset can carry more than one reason -- these filters overlap on purpose, which
           is why the metric boxes do not add up to the asset count. */
        if(k==='urgent'){ return String(rosF(it,['Priority','priority'],'')).toUpperCase()==='URGENT'
            || !!rosF(it,['IsFailedRepair','isFailedRepair'],false); }
        if(k==='alert'){ return !swept; }
        if(k==='swept'){ return !!swept; }
        if(k==='trackShort'){ return rosDsRaises(rosF(it,['TrackShortBand','trackShortBand'],'')); }
        if(k==='pointPm'){ return rosDsRaises(rosF(it,['PmBand','pmBand'],'')); }
        if(k==='drift'){ return rosDsRaises(rosF(it,['DriftBand','driftBand'],'')); }
        return false; }
    /* MONITOR is an opinion, not a hit -- the station counts exclude it, so the drop must too */
    function rosDsRaises(b){ b=String(b||'').toUpperCase(); return b==='URGENT'||b==='SOON'; }

    function rosDsItem(it,sid){ var e=rosEvi(it);
        /* closing first matters: rosOpenSheet re-renders the page underneath, and a <dialog>
           left open would sit on top of the worksheet the operator just asked for. */
        var pri=String(rosF(it,['Priority','priority'],'MONITOR')).toUpperCase(), pc=rosPcls(pri);
        var why=String(rosF(it,['CompositeReason','compositeReason'],'')||'');
        /* the model's own words -- track simple_summary, point classification.condition */
        var note=String(rosF(it,['SignalNote','signalNote'],'')||'');
        var swept=rosF(it,['IsSwept','isSwept'],false);
        var closed=String(rosF(it,['CloseStatus','closeStatus'],'OPEN')).toUpperCase()!=='OPEN';
        var tr=rosTrend(e);
        return '<div class="dsitem '+pc+'" onclick="rosMetClose();rosCloseAI();rosOpenSheet('+sid+')">'
          +'<div class="as">'+rosEsc(rosF(it,['AssetName','assetName'],'Asset'))
            +'<small>'+rosEsc(rosDsFam(it))+(swept?' \u00b7 \u25c7 no alert':'')+'</small></div>'
          +'<div class="tx">'+rosEsc(e.dominantCause||rosF(it,['Reason','reason'],''))
            +(note?'<em class="note">'+rosEsc(note)+'</em>':'')
            +(why?'<em>'+rosEsc(why)+'</em>':'')+'</div>'
          +'<div class="vd">'+(swept?'found by the site sweep':(e.total+' alert'+(e.total===1?'':'s')+' \u00b7 15d \u00b7 '+tr.s))+'</div>'
          +'<div class="tm">'+rosEsc(pri)+'<span class="'+(closed?'cl':'open')+'">'+(closed?'closed':'open')+'</span></div>'
          +'</div>'; }

    function rosStnRank(s){ if(rosF(s,['UrgentCount','urgentCount'],0)>0){return 1;}
        if(rosF(s,['SoonCount','soonCount'],0)>0){return 2;} return 3; }
    function rosStnPass(s){ var f=rosState.stnFilter;
        if(f==='ALL'){return true;}
        if(f==='FAILED'||f==='URGENT'){ return rosF(s,['UrgentCount','urgentCount'],0)>0 || rosF(s,['FailedRepairCount','failedRepairCount'],0)>0; }
        if(f==='SOON'){ return rosF(s,['SoonCount','soonCount'],0)>0; }
        if(f==='MONITOR'){ return rosF(s,['MonitorCount','monitorCount'],0)>0; }
        return true; }
    function rosStnFilter(f){ rosState.stnFilter = (rosState.stnFilter===f?'ALL':f); rosRenderRollup(rosState.rollup); }

    // ---------- station preview ----------
    function rosOpenSheet(siteId){
        if(!siteId){ return; }
        document.getElementById('rosRollup').className='hide';
        document.getElementById('rosSheet').className='';
        rosBusy(true);
        rosGet(ROS.sheet+'?divisionId='+rosState.divisionId+'&siteId='+siteId+'&rosterDate='+encodeURIComponent(rosState.date))
            .then(function(j){ rosState.sheet=j; rosLog('SHEET','site loaded items='+((rosF(j,['Items','items'],[])||[]).length)); try{ rosRenderSheet(j); }catch(_e){ rosErr('RENDER-SHEET',_e); rosNote('err','Could not render the worksheet.'); } })
            .catch(function(e){ rosErr('SHEET','site='+siteId+' '+((e&&e.message)||e)); rosNote('err','Worksheet unavailable: '+e.message); })
            .then(function(){ rosBusy(false); window.scrollTo(0,0); });
    }
    function rosBackToRollup(){ document.getElementById('rosSheet').className='hide';
        document.getElementById('rosRollup').className=''; rosNote('',''); }

    // parse the small JSON the builder wrote into Evidence15d
    function rosEvi(it){
        var raw=rosF(it,['Evidence15d','evidence15d'],''); var e={total:0,unacked:0,unackKnown:false,activeNow:false,firstHalf:0,secondHalf:0,trend:'stable',dominantCause:'',lastSet:'',windowDays:15,live:null,channels:null,days:null,liveReadAt:''};
        if(raw){ try{ var p=(typeof raw==='string')?JSON.parse(raw):raw;
            e.total=p.total||0; e.activeNow=!!p.activeNow; e.firstHalf=p.firstHalf||0; e.secondHalf=p.secondHalf||0;
            e.trend=p.trend||'stable'; e.dominantCause=p.dominantCause||''; e.lastSet=p.lastSet||''; e.windowDays=p.windowDays||15;
            if(p.unacked!==undefined && p.unacked!==null){ e.unacked=p.unacked; e.unackKnown=true; }
            if(p.live && typeof p.live==='object'){ e.live=p.live; }
            if(p.channels && p.channels.length){ e.channels=p.channels; }
            if(p.days && p.days.length){ e.days=p.days; }
            if(p.liveReadAt){ e.liveReadAt=p.liveReadAt; }
        }catch(x){ rosErr('EVIDENCE','unparsable Evidence15d for asset='+rosF(it,['AssetId','assetId'],'?')+' -- scored from defaults: '+((x&&x.message)||x)); } }
        if(!e.dominantCause){ e.dominantCause=String(rosF(it,['Reason','reason'],'')).split('.')[0]; }
        return e;
    }
    function rosPcls(pri){ pri=String(pri).toUpperCase(); return pri==='URGENT'?'u':(pri==='SOON'?'s':'m'); }
    function rosTrend(e){ if(e.secondHalf>e.firstHalf){ return {t:'degrading',cls:'up',s:e.firstHalf+'\u2192'+e.secondHalf+' \u2197'}; }
        if(e.secondHalf<e.firstHalf){ return {t:'improving',cls:'dn',s:e.firstHalf+'\u2192'+e.secondHalf+' \u2198'}; }
        return {t:'stable',cls:'flat',s:e.firstHalf+'\u2192'+e.secondHalf+' \u2192'}; }

    function rosFamily(it, e){
        var t=String(rosF(it,['AssetTypeName','assetTypeName'],'')).toUpperCase();
        var c=String(e.dominantCause).toUpperCase();
        if(t.indexOf('POINT')>=0 || c.indexOf('PT ')===0){ return 'Point'; }
        if(t.indexOf('SIGNAL')>=0 || c.indexOf('SIG')===0 || c.indexOf('ROSIG')>=0){ return 'Signal'; }
        if(t.indexOf('TRACK')>=0 || c.indexOf('TC ')===0 || c.indexOf('RAIL')>=0 || c.indexOf('BALST')>=0){ return 'Track'; }
        return 'Other';
    }
    // fault-mode key for the per-family analysis band
    var ROS_ITEMS=[]; var ROS_BYTYPE={Track:[],Point:[],Signal:[],Other:[]};
    /* AI context log -- one entry per rosAiStream call, newest last. Ring, 40 deep.
       Page-scoped on purpose: both AI modals read the same buffer, so a division call
       and an asset call can be compared without reloading. */
    var ROS_AI_LOG=[]; var ROS_AI_LOG_OPEN=false; var ROS_AI_LOG_EXP={}; var ROS_AI_SEQ=0;
    var rosType='Track'; var rosCur=-1; var rosTab=0; var rosDaySel=-1; var rosAlIdx=0; var rosAiFor=-1; var ROS_TABS=['Alerts','Live','Read']; var rosLiveCache={}; var rosLiveBusy={}; var rosPmCache={}; var rosPmBusy={}; var rosPmTrendCache={}; var rosAiHist=[]; var rosMvMore=false; var rosMvAiCache={}; var rosMvAiBusy={}; var rosMvAiFail={}; var rosEyesType='ALL'; var rosDivData=[]; var rosDriftCache={}; var rosDriftBusy={}; var rosDriftPrefetched=false; var rosStnPeek={}; var rosStnOpen={}; var rosStnPeekBusy={}; var rosPmOpsCache={}; var rosPmOpsBusy={}; var rosPmOpsPrefetched=false; var rosTrkCache={}; var rosTrkBusy={}; var rosTrkPrefetched=false; var rosDayCache={}; var rosDayBusy={}; var rosAckCache={}; var rosAckBusy={}; var rosAlDiag={}; var rosAlDiagBusy={}; var rosAlPopOn=false; var rosDiag=null; var ROS_AI_ENGINE='quantum11';  /* roster AI engine: quantum11 = DeepSeek Flash; change here to switch */

    function rosRenderSheet(j){
        var host=document.getElementById('rosSheet');
        var ok=rosF(j,['IsSuccess','isSuccess'],false), msg=rosF(j,['Message','message'],'');
        var run=rosF(j,['Run','run'],null), items=rosF(j,['Items','items'],[])||[];
        if(!ok){ host.innerHTML='<div class="ros-head"><button onclick="rosBackToRollup()">&larr; Division</button></div><div class="ros-empty">No worksheet for this station and date.</div>'; rosNote('err', msg||'The worksheet could not be loaded.'); return; }
        if(msg && msg!=='Success'){ rosNote('warn', msg); } else { rosNote('',''); }
        var stn=rosF(j,['StationName','stationName'],'')||('Site '+rosF(j,['SiteId','siteId'],''));
        var head='<div class="ros-head"><button onclick="rosBackToRollup()">&larr; Division</button><div><span class="ros-h1">'+rosEsc(stn)+'</span></div><span class="ros-sub">'+rosEsc(rosState.date)+'</span></div><div class="ros-meta">'+rosRunLine(run,'')+'</div>';
        if(!items.length){ host.innerHTML=head+'<div class="ros-empty">Nothing to attend at this station today.</div>'; return; }
        ROS_ITEMS=[]; ROS_BYTYPE={Track:[],Point:[],Signal:[],Other:[]}; var i; rosPmPrefetched=false; rosDriftPrefetched=false; rosPmOpsPrefetched=false; rosTrkPrefetched=false;
        for(i=0;i<items.length;i++){ var it=items[i]; var e=rosEvi(it); var fam=rosFamily(it,e); ROS_ITEMS.push({it:it,e:e,fam:fam}); ROS_BYTYPE[fam].push(i); }
        var order=['Track','Point','Signal','Other']; rosType=order[0]; var best=-1;
        for(i=0;i<order.length;i++){ if(ROS_BYTYPE[order[i]].length>best){ best=ROS_BYTYPE[order[i]].length; rosType=order[i]; } }
        rosCur=(ROS_BYTYPE[rosType][0]!==undefined?ROS_BYTYPE[rosType][0]:-1); rosTab=0; rosDaySel=-1;
        var doneN=0; for(i=0;i<ROS_ITEMS.length;i++){ if(String(rosF(ROS_ITEMS[i].it,['CloseStatus','closeStatus'],'OPEN')).toUpperCase()!=='OPEN'){ doneN++; } }
        var segs=''; var tot=ROS_ITEMS.length;
        if(tot<=24){ for(i=0;i<tot;i++){ segs+='<i'+(i<doneN?' class="f"':'')+'></i>'; } segs='<span class="gsegs">'+segs+'</span>'; }
        else { segs='<span class="gbar"><i style="width:'+(tot?Math.round(doneN/tot*100):0)+'%"></i></span>'; }
        var guide='<div class="rosguide">'
          +'<span class="gicon"><svg viewBox="0 0 24 24" fill="none" stroke="#E8ECF2" stroke-width="2" stroke-linecap="round"><path d="M8 6 H19 M8 12 H19 M8 18 H14"/><path d="M4 5.2 L5 6.4 L6.6 4.4" stroke="#5ED694"/><path d="M4 11.2 L5 12.4 L6.6 10.4" stroke="#5ED694"/><circle cx="5" cy="18" r="1.1" stroke="#8D99A9"/></svg></span>'
          +'<div class="gtx"><div class="gt">Today\u0027s maintenance roster</div>'
          +'<div class="gs">The <b>'+tot+'</b> assets below are picked for your attention today \u2014 open each job, verify on site, and close it with a finding.</div></div>'
          +'<div class="gprog"><div class="gcnt'+(doneN===0?' zero':'')+'">'+doneN+'<i>of '+tot+' attended</i></div>'+segs+'</div></div>';
        host.innerHTML=head+guide+'<div class="ttabs" id="rosTypes"></div>'
          +'<div class="railcap"><span class="t">Today\u0027s jobs</span><span class="s">tap a job to attend it \u00b7 lamp = priority \u00b7 pulsing = active now</span></div>'
          +'<div class="rail" id="rosRail"></div>'
          +'<div id="rosDetail"></div>'
          +'<div class="rmvcap"><span class="t">Station movement</span><span class="s">across all '+ROS_ITEMS.length+' jobs \u00b7 tap anything to open the asset</span></div>'
          +'<div id="rosMove"></div>';
        rosRenderTypes(); rosRenderAssets(); rosRenderDetail(); rosRenderMovement();
    }

    function rosFamLabel(f){ return f==='Track'?'Track circuits':(f==='Point'?'Point machines':(f==='Signal'?'Signals':'Other assets')); }
    function rosPriRankV(pri){ pri=String(pri).toUpperCase(); return pri==='URGENT'?1:(pri==='SOON'?2:3); }
    // ---- Composite priority: existing ALERT priority + TRACK-SHORT + PM-ANALYSIS ----
    /* WHY this asset was raised. The server writes it during the composite rescore; without it
       the card shows a band with no way to tell shorting from PM from drift. Empty = alert only. */
    function rosWhy(o){ return String(rosF(o.it,['CompositeReason','compositeReason'],'')||''); }
    function rosWhyChip(o){ var w=rosWhy(o); if(!w){ return ''; }
        var sw=rosF(o.it,['IsSwept','isSwept'],false);
        return '<span class="mwhy" title="'+rosEsc(w)+(sw?' \u2014 no alert, found by the site sweep':'')+'">'
             +(sw?'\u25c7 ':'')+rosEsc(w)+'</span>'; }
    /* A swept asset has NO alert -- it reached the roster because track-shorting or
       pm-prediction flagged it. Everything alert-shaped (cause code, 15-day bars, alert
       count, trend arrow) is meaningless for it and must not be rendered as if it were real. */
    function rosSwept(o){ return !!rosF(o.it,['IsSwept','isSwept'],false); }
    function rosSigText(o){
        var n=String(rosF(o.it,['SignalNote','signalNote'],'')||'').trim();
        if(n){ return n; }
        var r=String(rosF(o.it,['Reason','reason'],'')||'').trim();
        return r||'Flagged by a signal.'; }
    function rosSigKind(o){
        var t=String(rosF(o.it,['TrackShortBand','trackShortBand'],'')||'');
        var pm=String(rosF(o.it,['PmBand','pmBand'],'')||'');
        var dr=String(rosF(o.it,['DriftBand','driftBand'],'')||'');
        if(t){ return { k:'short', lb:'track shorting', band:t }; }
        if(pm){ return { k:'pm', lb:'pm prediction', band:pm }; }
        if(dr){ return { k:'drift', lb:'avg drift', band:dr }; }
        return { k:'sig', lb:'signal', band:String(rosF(o.it,['CompositeBand','compositeBand'],'')||'') }; }
    function rosIsShort(o){ return /(^|[^A-Z])SHORT([^A-Z]|$)/i.test(String(o.e.dominantCause||'')); }
    function rosPmStateOf(o){ if(!ROS.pm){ return ''; } var aid=rosF(o.it,['AssetId','assetId'],0); var pc=rosPmCache[aid];
        if(!pc||!pc.pm){ return ''; } var w=String(rosPmWorst(pc.pm)||'').toUpperCase();
        if(w.indexOf('URGENT')>=0||w.indexOf('INSPECT')>=0){ return 'INSPECT'; }
        if(w.indexOf('MAINTAIN')>=0||w==='SOON'){ return 'SOON'; }
        if(w.indexOf('WATCH')>=0){ return 'WATCH'; } return ''; }
    function rosDdmy(d){ function p(n){ return (n<10?'0':'')+n; } return p(d.getDate())+p(d.getMonth()+1)+d.getFullYear()+'_'+p(d.getHours())+p(d.getMinutes())+p(d.getSeconds()); }
    function rosDriftWindow(){ var end=new Date(); var start=new Date(end.getTime()-7*86400000); return { s:rosDdmy(start), e:rosDdmy(end) }; }
    function rosDriftStateOf(o){ var c=rosDriftCache[rosF(o.it,['AssetId','assetId'],0)]; if(!c||!c.band){ return ''; } return c.band; } // 'URGENT'|'SOON'|''
    function rosDriftFetch(o, cb){ var aid=rosF(o.it,['AssetId','assetId'],0); if(!aid){ if(cb){cb();} return; }
        if(rosDriftCache[aid]||rosDriftBusy[aid]){ if(cb){cb();} return; } rosDriftBusy[aid]=true; var w=rosDriftWindow();
        rosGet(ROS.rangeHist+'?assetId='+aid+'&start='+w.s+'&end='+w.e).then(function(j){
            rosDriftCache[aid]={ band:rosF(j,['band','Band'],''), drift:rosF(j,['drift','Drift'],0), dir:rosF(j,['dir','Dir'],''), worst:rosF(j,['worstAttr','WorstAttr'],'') };
            rosLog('DRIFT','asset='+aid+' drift='+rosDriftCache[aid].drift+'% dir='+rosDriftCache[aid].dir+' band='+(rosDriftCache[aid].band||'-'));
            rosDriftBusy[aid]=false; if(cb){cb();}
        }).catch(function(ex){ rosErr('DRIFT','asset='+aid+' '+((ex&&ex.message)||ex)); rosDriftCache[aid]={band:''}; rosDriftBusy[aid]=false; if(cb){cb();} }); }
    function rosDriftPrefetch(){ if(rosDriftPrefetched||!ROS.rangeHist){ return; } rosDriftPrefetched=true; rosLog('PREFETCH','drift assets='+ROS_ITEMS.length);
        var pend=0, i, any=false;
        for(i=0;i<ROS_ITEMS.length;i++){ var o=ROS_ITEMS[i], aid=rosF(o.it,['AssetId','assetId'],0);
            if(!aid||rosDriftCache[aid]||rosDriftBusy[aid]){ continue; } any=true; pend++;
            rosDriftFetch(o, function(){ if(--pend<=0){ rosPmRescore(); } }); }
        if(!any){ return; } }
    // point-machine abnormal-operation count (pm-operation-v4). POINTS ONLY.
    function rosPmOpsStateOf(o){ if(String(o.fam||'').toLowerCase()!=='point'){ return ''; } var c=rosPmOpsCache[rosF(o.it,['AssetId','assetId'],0)]; if(!c){ return ''; } return c.band||''; }
    function rosPmOpsFetch(o, cb){ var aid=rosF(o.it,['AssetId','assetId'],0), sid=rosF(o.it,['SiteId','siteId'],0);
        if(!aid||!sid){ if(cb){cb();} return; } if(rosPmOpsCache[aid]||rosPmOpsBusy[aid]){ if(cb){cb();} return; } rosPmOpsBusy[aid]=true;
        rosGet(ROS.pmOps+'?siteId='+sid+'&assetId='+aid).then(function(j){
            rosPmOpsCache[aid]={ band:rosF(j,['band','Band'],''), problem:rosF(j,['problem','Problem'],0), ops:rosF(j,['ops','Ops'],0) };
            rosLog('PMOPS','asset='+aid+' ops='+rosPmOpsCache[aid].ops+' problem='+rosPmOpsCache[aid].problem+' band='+(rosPmOpsCache[aid].band||'-'));
            rosPmOpsBusy[aid]=false; if(cb){cb();}
        }).catch(function(ex){ rosErr('PMOPS','asset='+aid+' '+((ex&&ex.message)||ex)); rosPmOpsCache[aid]={band:''}; rosPmOpsBusy[aid]=false; if(cb){cb();} }); }
    function rosPmOpsPrefetch(){ if(rosPmOpsPrefetched||!ROS.pmOps){ return; } rosPmOpsPrefetched=true; rosLog('PREFETCH','pm-ops points='+((ROS_BYTYPE.Point||[]).length));
        var pts=ROS_BYTYPE.Point||[], pend=0, i, any=false;
        for(i=0;i<pts.length;i++){ var o=ROS_ITEMS[pts[i]], aid=rosF(o.it,['AssetId','assetId'],0);
            if(!aid||rosPmOpsCache[aid]||rosPmOpsBusy[aid]){ continue; } any=true; pend++;
            rosPmOpsFetch(o, function(){ if(--pend<=0){ rosPmRescore(); } }); }
        if(!any){ return; } }
    // track shorting (ai-prediction/track major_events + live). TRACKS ONLY.
    function rosTrkStateOf(o){ if(String(o.fam||'').toLowerCase()!=='track'){ return ''; } var c=rosTrkCache[rosF(o.it,['AssetId','assetId'],0)]; if(!c){ return ''; } return c.band||''; }
    function rosTrkLive(o){ if(String(o.fam||'').toLowerCase()!=='track'){ return false; } var c=rosTrkCache[rosF(o.it,['AssetId','assetId'],0)]; return !!(c&&c.live); }
    function rosTrkFetch(o, cb){ var aid=rosF(o.it,['AssetId','assetId'],0), sid=rosF(o.it,['SiteId','siteId'],0);
        var nm=rosF(o.it,['AssetName','assetName'],'');
        if(!aid||!sid){ rosLog('TRACK','skip '+nm+' (no assetId/siteId)'); if(cb){cb();} return; }
        if(rosTrkCache[aid]||rosTrkBusy[aid]){ if(cb){cb();} return; } rosTrkBusy[aid]=true;
        var url=ROS.trackShort+'?siteId='+sid+'&assetId='+aid;
        rosLog('TRACK','fetch '+nm+' (asset='+aid+' site='+sid+') '+url);
        rosGet(url).then(function(j){
            rosTrkCache[aid]={ band:rosF(j,['band','Band'],''), live:rosF(j,['live','Live'],false), has:rosF(j,['hasShorting','HasShorting'],false), events:rosF(j,['events','Events'],0), cause:rosF(j,['worstCause','WorstCause'],''), err:rosF(j,['error','Error'],''),
                summary:rosF(j,['simpleSummary','SimpleSummary'],''), reason:rosF(j,['leakReason','LeakReason'],''),
                major:(rosF(j,['majorEvents','MajorEvents'],[])||[]), why:rosF(j,['bandReason','BandReason'],'') };
            var c=rosTrkCache[aid];
            rosLog('TRACK','result '+nm+' events='+c.events+' hasShorting='+c.has+' live='+c.live+' cause="'+c.cause+'" band='+(c.band||'-')+(c.err?(' ERR='+c.err):''));
            rosTrkBusy[aid]=false; if(cb){cb();}
        }).catch(function(ex){ rosErr('TRACK','fetch failed '+nm+' asset='+aid+' '+((ex&&ex.message)||ex)); rosTrkCache[aid]={band:''}; rosTrkBusy[aid]=false; if(cb){cb();} }); }
    function rosTrkPrefetch(){ if(rosTrkPrefetched||!ROS.trackShort){ return; } rosTrkPrefetched=true; rosLog('PREFETCH','track: '+((ROS_BYTYPE.Track||[]).length)+' track asset(s) to score');
        var trk=ROS_BYTYPE.Track||[], pend=0, i, any=false;
        for(i=0;i<trk.length;i++){ var o=ROS_ITEMS[trk[i]], aid=rosF(o.it,['AssetId','assetId'],0);
            if(!aid||rosTrkCache[aid]||rosTrkBusy[aid]){ continue; } any=true; pend++;
            rosTrkFetch(o, function(){ if(--pend<=0){ rosPmRescore(); } }); }
        if(!any){ return; } }
    function rosPriEff(o){ var rank=rosPriRankV(String(rosF(o.it,['Priority','priority'],'MONITOR')).toUpperCase());
        if(rosIsShort(o)){ rank=Math.min(rank, o.e.activeNow?1:2); }
        var pm=rosPmStateOf(o);
        if(pm==='INSPECT'){ rank=Math.min(rank,1); } else if(pm==='SOON'){ rank=Math.min(rank,2); } else if(pm==='WATCH'){ rank=Math.min(rank,3); }
        var dr=rosDriftStateOf(o);   // avg-drift from FRSAttributeRangeHistory
        if(dr==='URGENT'){ rank=Math.min(rank,1); } else if(dr==='SOON'){ rank=Math.min(rank,2); }
        var po=rosPmOpsStateOf(o);   // point-machine abnormal-op count (pm-operation-v4)
        if(po==='URGENT'){ rank=Math.min(rank,1); } else if(po==='SOON'){ rank=Math.min(rank,2); }
        var tk=rosTrkStateOf(o);     // track shorting (ai-prediction/track): live short -> Urgent, past windows -> Soon
        if(tk){ var _aidT=rosF(o.it,['AssetId','assetId'],0); var _r0=rank;
            if(tk==='URGENT'){ rank=Math.min(rank,1); } else if(tk==='SOON'){ rank=Math.min(rank,2); }
            if(rank<_r0 && rosTrkCache[_aidT] && !rosTrkCache[_aidT]._logged){ rosTrkCache[_aidT]._logged=true;
                rosLog('PRI','track-short raised '+rosF(o.it,['AssetName','assetName'],'')+' \u2192 '+(rank===1?'URGENT':'SOON')+(rosTrkCache[_aidT].live?' (live)':' (past windows)')); } }
        return rank===1?'URGENT':(rank===2?'SOON':'MONITOR'); }
    function rosPmPrefetch(){ if(!ROS.pm){ return; } var pts=ROS_BYTYPE.Point||[], pend=0, i; rosLog('PREFETCH','PmPredict points='+pts.length);
        for(i=0;i<pts.length;i++){ var o=ROS_ITEMS[pts[i]]; var aid=rosF(o.it,['AssetId','assetId'],0);
            if(!aid||rosPmCache[aid]||rosPmBusy[aid]){ continue; } pend++;
            (function(it2){ var a2=rosF(it2,['AssetId','assetId'],0), s2=rosF(it2,['SiteId','siteId'],0); rosPmBusy[a2]=true;
                rosGet(ROS.pm+'?assetId='+encodeURIComponent(a2)+'&siteId='+encodeURIComponent(s2)).then(function(j){
                    rosPmCache[a2]=(j&&(j.a||j.b))?{pm:j}:{err:'empty'}; rosPmBusy[a2]=false; if(--pend<=0){ rosPmRescore(); }
                }).catch(function(ex){ rosErr('PM-PREFETCH','asset='+a2+' site='+s2+' '+((ex&&ex.message)||ex)); rosPmCache[a2]={err:'fetch'}; rosPmBusy[a2]=false; if(--pend<=0){ rosPmRescore(); } });
            })(o.it); }
    }
    function rosPmRescore(){
        try{ var tu=0,ts=0,tl=0,k; for(k in rosTrkCache){ if(!rosTrkCache.hasOwnProperty(k)){ continue; } var c=rosTrkCache[k]; if(c.band==='URGENT'){tu++;} else if(c.band==='SOON'){ts++;} if(c.live){tl++;} }
            rosLog('RESCORE','composite re-render \u2014 track bands urgent='+tu+' soon='+ts+' live='+tl); }catch(_e){}
        if(document.getElementById('rosRail')){ rosRenderTypes(); rosRenderAssets(); } }
    function rosSortIdxs(idxs){ return idxs.slice().sort(function(a,b){ return rosPriRankV(rosPriEff(ROS_ITEMS[a]))-rosPriRankV(rosPriEff(ROS_ITEMS[b])) || ROS_ITEMS[b].e.total-ROS_ITEMS[a].e.total; }); }
    function rosArrow(e){ var t=rosTrend(e).t; return t==='improving'?'<span class="arr dn">\u2198</span>':(t==='degrading'?'<span class="arr up">\u2197</span>':'<span class="arr fl">\u00b7</span>'); }
    function rosWellBars(e,pcls,tall){
        var d=new Array(15),i,k; for(i=0;i<15;i++){ d[i]=0; }
        var a=e.firstHalf,b=e.secondHalf;
        for(k=0;k<a;k++){ d[Math.floor(k*7/Math.max(a,1))]++; }
        for(k=0;k<b;k++){ d[7+Math.floor(k*8/Math.max(b,1))]++; }
        var mx=1; for(i=0;i<15;i++){ if(d[i]>mx){ mx=d[i]; } }
        var top=tall?21:18, h='';
        for(i=0;i<15;i++){ var ht=d[i]?Math.max(7,Math.round(d[i]/mx*top)):3;
            var cl=d[i]?(i<7?' class="h"':' class="h'+pcls+'"'):'';
            if(i===14&&e.activeNow){ cl=' class="'+(d[i]?(i<7?'h':'h'+pcls):'')+' now"'; }
            h+='<i'+cl+' style="height:'+ht+'px"></i>'; }
        return h;
    }
    // The model summary: status word + band tint + marker-highlighted sentence with the
    // evidence numbers woven in. All deterministic from cause + trend + counts, so it never
    // claims more than Evidence15d supports.
    function rosSummary(it,e){
        var fam=rosFamily(it,e), c=String(e.dominantCause).toUpperCase(), tr=rosTrend(e).t;
        var st, w, tot=e.total, wd=e.windowDays||15, t1=e.firstHalf, t2=e.secondHalf;
        var evs=(tot===1?'event':'events'), als=(tot===1?'alert':'alerts');
        if(e.activeNow){ st='bad'; w='Active now'; }
        else if(tr==='degrading'){ st='bad'; w='Degrading'; }
        else if(tr==='improving'){ st='ok'; w=(t2===0?'Recovered':'Easing off'); }
        else { st='warn'; w=(tot<=1?'Under watch':'Steady'); }
        function H(t){ return '<em class="hl">'+t+'</em>'; }
        var sum;
        if(fam==='Track'){
            if(c.indexOf('SHORT')>=0){
                sum=e.activeNow?(H('Something is bridging the rails right now')+' \u2014 '+tot+' '+evs+' in '+wd+'d and one is live; treat as occupied until it releases.')
                               :('A '+H('forming short')+' \u2014 '+tot+' dips in '+wd+'d ('+t1+' \u2192 '+t2+'), current recovers between events.'); }
            else if(c.indexOf('RES HIGH')>=0||c.indexOf('CKT OPEN')>=0||c.indexOf('RES OPEN')>=0){
                sum=(tr==='improving')?('Resistance high but '+H('easing off')+' \u2014 '+t1+' '+(t1===1?'alert':'alerts')+' in the first week fell to '+t2+' in the second; likely a '+H('drying joint')+', mostly self-recovering.')
                                      :('Resistance '+H('climbing toward the open limit')+' \u2014 '+tot+' '+als+' in '+wd+'d, '+t1+' \u2192 '+t2+'; reads like a degrading bond, not a short.'); }
            else if(c.indexOf('VOLT LOW')>=0){
                sum='Track voltage '+H('sagging')+' \u2014 '+tot+' '+(tot===1?'dip':'dips')+' in '+wd+'d; check the feed set and bond terminations.'; }
            else {
                sum=(tr==='improving')?('Ballast resistance '+H('drifting but settling')+' \u2014 '+t1+' \u2192 '+t2+' across the fortnight; tracks the weather.')
                                      :('Ballast resistance '+H('drifting')+' \u2014 '+tot+' '+als+' in '+wd+'d; usually self-recovers, watch the trend.'); }
        } else if(fam==='Point'){
            if(c.indexOf('OBS')>=0){ sum=H('Mid-stroke bump on the throw')+' \u2014 '+tot+' flagged '+(tot===1?'operation':'operations')+' in '+wd+'d; an obstruction, not a drive fault.'; }
            else if(c.indexOf('DRIVE')>=0){ sum='Throw current '+H('running high')+' \u2014 '+tot+' '+evs+' in '+wd+'d; likely binding in the drive.'; }
            else if(e.activeNow||rosF(it,['IsFailedRepair','isFailedRepair'],false)){ sum=H('Detection dead at LOC right now')+' \u2014 the point cannot prove its position; treat as failed until proved on site.'; }
            else { sum='Detection voltage '+H('drifting toward drop-out')+' \u2014 '+tot+' '+evs+' in '+wd+'d; marginal contact, not binding.'; }
        } else if(fam==='Signal'){
            if(c.indexOf('ECR')>=0){ sum=H('ECR dropped')+' \u2014 '+tot+' '+evs+' in '+wd+'d; check the relay path before calling it a signal fault.'; }
            else { sum='Aspect voltage low \u2014 '+tot+' '+evs+' in '+wd+'d, reads like a '+H('supply blip')+'; watch for re-clustering.'; }
        } else {
            sum=(rosEsc(rosF(it,['Reason','reason'],''))||'Under watch \u2014 see the analysis.');
        }
        if(e.activeNow && !(fam==='Track'&&c.indexOf('SHORT')>=0) && !(fam==='Point'&&(c.indexOf('OBS')<0&&c.indexOf('DRIVE')<0))){
            sum+=' '+H('Live at this moment.'); }
        return { st:st, w:w, sum:sum };
    }

    var rosPmPrefetched=false;
    var rosPrefetchSkipLogged=false;
    function rosRenderTypes(){
        if(ROS_SERVER_COMPOSITE){ if(!rosPrefetchSkipLogged){ rosPrefetchSkipLogged=true;
            rosLog('PREFETCH','skipped \u2014 server composite is on, bands are already in Priority'); } }
        else {
        if(!rosPmPrefetched&&ROS.pm&&(ROS_BYTYPE.Point||[]).length){ rosPmPrefetched=true; rosPmPrefetch(); }
        if(!rosDriftPrefetched&&ROS.rangeHist&&ROS_ITEMS.length){ rosDriftPrefetch(); }
        if(!rosPmOpsPrefetched&&ROS.pmOps&&(ROS_BYTYPE.Point||[]).length){ rosPmOpsPrefetch(); }
        if(!rosTrkPrefetched&&ROS.trackShort&&(ROS_BYTYPE.Track||[]).length){ rosTrkPrefetch(); } }
        var order=['Track','Point','Signal','Other'], h='', g;
        for(g=0;g<order.length;g++){ var t=order[g]; var idxs=ROS_BYTYPE[t]; if(!idxs.length){ continue; }
            var u=0,s=0,m=0,k; for(k=0;k<idxs.length;k++){ var p=rosPriEff(ROS_ITEMS[idxs[k]]); if(p==='URGENT'){u++;}else if(p==='SOON'){s++;}else{m++;} }
            var pcs='';
            if(u){ pcs+='<span class="pc u"><i></i>'+u+' urgent</span>'; }
            if(s){ pcs+='<span class="pc s"><i></i>'+s+' soon</span>'; }
            if(m){ pcs+='<span class="pc m"><i></i>'+m+' watch</span>'; }
            h+='<button class="ttab'+(t===rosType?' on':'')+'" onclick="rosSetType(\''+t+'\')">'
              +'<span class="tr1"><span class="tname">'+rosFamLabel(t)+'</span><span class="cnt">'+idxs.length+'</span></span>'
              +'<span class="pcnts">'+pcs+'</span></button>'; }
        document.getElementById('rosTypes').innerHTML=h;
    }
    function rosSetType(t){ rosType=t; var idxs=ROS_BYTYPE[t]; rosCur=(idxs[0]!==undefined?idxs[0]:-1); rosTab=0; rosDaySel=-1; rosAlIdx=0; rosRenderTypes(); rosRenderAssets(); rosRenderDetail(); }

    function rosRenderAssets(){ var idxs=rosSortIdxs(ROS_BYTYPE[rosType]), h='', i;
        for(i=0;i<idxs.length;i++){ var gi=idxs[i]; var o=ROS_ITEMS[gi], it=o.it, e=o.e;
            var pri=rosPriEff(o); var failed=rosF(it,['IsFailedRepair','isFailedRepair'],false); var pcls=rosPcls(pri);
            var aid=rosF(it,['AssetName','assetName'],'Asset');
