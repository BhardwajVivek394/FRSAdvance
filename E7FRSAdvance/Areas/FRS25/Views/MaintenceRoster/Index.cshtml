            e2.innerHTML='<div class="vb no"><div class="lead"><div class="vw">Division read</div><div class="hl">'+rosEsc(ans.replace(/\s+/g,' ').trim())+'</div></div></div>'; }, 'div-read'); }
    function rosDivAsk(){ var inp=document.getElementById('rosAskIn'), out=document.getElementById('rosChat'); if(!inp||!out){ return; }
