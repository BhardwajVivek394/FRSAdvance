   <div class="dm-field"><label for="dmDivision">Division</label><select id="dmDivision" required><option value="">Select division</option>
@if (ViewBag.Divisions != null)
{
    foreach (var division in (IEnumerable<Domain.Division>)ViewBag.Divisions)
    {
        @* view 2.11.2.3: DivisionService.GetAll() prepends its own placeholder row
           (Id = 0, Name = "Select Division") for the pages that bind it straight to a
           DropDownList. This view writes its own <option value=""> placeholder above, so
           binding that row too put "Select division" in the list twice -- and the second
           one was selectable, which would have loaded the roster with divisionId=0.
           Real divisions always have Id > 0. *@
        if (division.Id > 0)
        {
            <option value="@division.Id">@division.Name</option>
        }
    }
}</select></div>
   <div class="dm-field"><label for="dmDate">Roster date</label><input type="date" id="dmDate" required value="@maintenanceToday" max="@maintenanceToday"></div>
