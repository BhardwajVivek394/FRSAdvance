          +'</div></div>'
          +'<span class="vsrc"><span class="tag api">Model</span></span></div>'; }
        var rail='',i; for(i=0;i<ROS_TABS.length;i++){ var lbl=(i===2?rosReadLabel(fam):ROS_TABS[i]); rail+='<button class="rtab'+(i===rosTab?' on':'')+'" onclick="rosSetTab('+i+')"><span class="tn">'+(i+1)+'</span>'+lbl+'</button>'; }
