    function rosAiCtx(o){ var it=o.it, e=o.e; var sm=rosSummary(it,e);
        var ctx={ division:rosState.divisionId, rosterDate:rosState.date,
            station:rosF(it,['StationName','stationName'],''), stationItems:ROS_ITEMS.length,
            asset:rosF(it,['AssetName','assetName'],''), assetType:rosF(it,['AssetTypeName','assetTypeName'],''),
            priority:rosF(it,['Priority','priority'],''), closeStatus:rosF(it,['CloseStatus','closeStatus'],'OPEN'),
            dominantCause:e.dominantCause, status:sm.w, read:String(sm.sum).replace(/<[^>]+>/g,''),
            evidence:{ total:e.total, firstHalf:e.firstHalf, secondHalf:e.secondHalf, trend:rosTrend(e).t,
                lastSet:e.lastSet, activeNow:e.activeNow, windowDays:e.windowDays,
                unacked:(e.unackKnown?e.unacked:null) },
            reason:rosF(it,['Reason','reason'],'') };
        var lc=rosLiveCache[rosF(it,['AssetId','assetId'],0)];
        if(lc&&lc.rows&&lc.rows.length){ var ranges=rosRangeMap(e);
            ctx.live=lc.rows.slice(0,16).map(function(r){ var rg=ranges[String(r.attrId)]||{};
                return { name:r.attr||rg.name||'', val:r.value, unit:r.unit||'',
                    min:(r.minSafe!==null&&r.minSafe!==undefined?r.minSafe:(rg.min!==undefined?rg.min:null)),
                    max:(r.maxSafe!==null&&r.maxSafe!==undefined?r.maxSafe:(rg.max!==undefined?rg.max:null)),
                    avg:(r.avg!==null&&r.avg!==undefined?r.avg:null), at:r.at }; });
            ctx.liveReadAt=lc.at; }
        else if(e.channels&&e.channels.length){ ctx.live=e.channels.slice(0,16); ctx.liveReadAt=e.liveReadAt||''; }
        return ctx; }
    function rosVerdictLead(o){ var it=o.it, e=o.e; var tr=rosTrend(e).t;
        var asset=rosF(it,['AssetName','assetName'],'')||'this asset';
        var typ=rosF(it,['AssetTypeName','assetTypeName'],o.fam||'');
        var stn=rosF(it,['StationName','stationName'],''); var sid=rosF(it,['SiteId','siteId'],'');
        var lead='Diagnose this railway asset for the maintenance roster. '
          +'ASSET: '+asset+(typ?(' (type '+typ+')'):'')+(stn?(' at station '+stn):'')+(sid!==''?(', site '+sid):'')+'. '
          +'DOMINANT CAUSE: '+(e.dominantCause||'unknown')+'. '
          +'15-DAY EVIDENCE: '+e.total+' alert'+(e.total===1?'':'s')+', first half '+e.firstHalf+' -> second half '+e.secondHalf
          +', trend '+tr+(e.activeNow?', ACTIVE NOW':', recovered')+(e.lastSet?(', last set '+e.lastSet):'')+'. ';
        var lc=rosLiveCache[rosF(it,['AssetId','assetId'],0)];
        if(lc&&lc.rows&&lc.rows.length){ var parts=lc.rows.slice(0,6).map(function(r){ return (r.attr||'')+' '+r.value+(r.unit?(' '+r.unit):'')+(r.state?(' ('+r.state+')'):''); });
            lead+='LIVE READINGS: '+parts.join('; ')+'. '; }
        lead+='The asset is fully identified above \u2014 do NOT say the asset is missing. Base the verdict ONLY on these facts; give verdict, confidence, reason and one first action.';
        return lead; }
    // ---- Ask AI rides the SAME proven engine as the alert board: JSON POST, SSE stream back ----
    /* Top-bar controls. The panel at the foot of the modal is collapsed and below the
       scroll, so the download lived somewhere nobody would find it. These sit beside the
       close button in both modals and are always visible. */
    function rosCtxTopBtns(){
        return '<button type="button" class="aidl" id="rosCtxDl" onclick="rosCtxDownload(\'json\')"'
             + ' title="Download every AI call recorded this page load (.json)">\u21e9 log</button>'
             + '<button type="button" class="aidl" onclick="rosCtxOpen()"'
             + ' title="Show the context sent with each AI call">view</button>'; }
    /* jump to the panel and open it -- the section is at the foot of a scrolling body */
    function rosCtxOpen(){ ROS_AI_LOG_OPEN=true; rosCtxRender();
        try{ var el=document.getElementById('rosCtxLog');
            if(el&&el.scrollIntoView){ el.scrollIntoView({ block:'nearest' }); } }catch(_e){} }
    function rosCtxKB(n){ return n<1024 ? (n+' B') : ((n/1024).toFixed(1)+' KB'); }
    function rosCtxToggle(){ ROS_AI_LOG_OPEN=!ROS_AI_LOG_OPEN; rosCtxRender(); }
    function rosCtxExp(i){ ROS_AI_LOG_EXP[i]=!ROS_AI_LOG_EXP[i]; rosCtxRender(); }

    /* ---------- download ----------
       The panel is for measuring payloads, and reading 1.8 KB of prose through a
       240px scroller is not measuring. These write the WHOLE ring to a file so the
       calls can be diffed offline.
       ctx is stored by reference, so the serializer drops circular links rather than
       throwing and losing the whole export. */
    function rosCtxSafe(o){ var seen=[];
        return JSON.stringify(o, function(k,v){
            if(v && typeof v==='object'){ if(seen.indexOf(v)>=0){ return '[circular]'; } seen.push(v); }
            return v; }, 1); }
    function rosCtxStamp(){ var d=new Date(), p=function(n){ return (n<10?'0':'')+n; };
        return d.getFullYear()+p(d.getMonth()+1)+p(d.getDate())+'_'+p(d.getHours())+p(d.getMinutes())+p(d.getSeconds()); }
    function rosCtxPayload(){
        return { exportedAt:new Date().toISOString(), viewVersion:ROS_VER,
                 division:rosState.divisionId, rosterDate:rosState.date,
                 engine:ROS_AI_ENGINE, url:(typeof location!=='undefined'?location.href:''),
                 calls:ROS_AI_LOG.length, entries:ROS_AI_LOG }; }
    function rosCtxText(){
        var p=rosCtxPayload(), L=[], i;
        L.push('Maintenance Roster -- AI context log');
        L.push('exported   '+p.exportedAt);
        L.push('view       v'+p.viewVersion+'   engine '+p.engine);
        L.push('division   '+p.division+'   roster date '+p.rosterDate);
        L.push('calls      '+p.calls);
        L.push('');
        for(i=0;i<ROS_AI_LOG.length;i++){ var e=ROS_AI_LOG[i];
            L.push('======================================================================');
            L.push('#'+e.seq+'  '+e.src+'  '+e.at+'   total '+rosCtxKB(e.bytes)
                  +'   ctx '+rosCtxKB(e.ctxBytes)+'/'+e.ctxKeys+'k'
                  +'   msg '+rosCtxKB(e.msgBytes)
                  +'   hist '+e.hist+' ('+rosCtxKB(e.histBytes)+')'
                  +'   live '+e.live
                  +'   '+(e.ms?(e.ms+'ms'):'-')+'   out '+rosCtxKB(e.outBytes)
                  +(e.err?('   ERROR '+e.err):''));
            L.push('');
            L.push('--- messages[last] -------------------------------------------------');
            L.push(e.msg||'(empty)');
            L.push('');
            L.push('--- context --------------------------------------------------------');
            L.push(rosCtxSafe(e.ctx));
            L.push(''); }
        return L.join('\n'); }
    function rosCtxSave(name, text, mime){
        try{
            var blob=new Blob([text],{ type:mime+';charset=utf-8' });
            var url=URL.createObjectURL(blob);
            var a=document.createElement('a');
            a.href=url; a.download=name; a.style.display='none';
            document.body.appendChild(a); a.click();
            setTimeout(function(){ try{ document.body.removeChild(a); URL.revokeObjectURL(url); }catch(_x){} },0);
            rosLog('CTXLOG','downloaded '+name+' ('+rosCtxKB(text.length)+', '+ROS_AI_LOG.length+' call(s))');
        }catch(ex){ rosErr('CTXLOG','download failed: '+((ex&&ex.message)||ex));
            rosNote('err','Could not save the log file: '+((ex&&ex.message)||ex)); } }
    function rosCtxDownload(fmt){
        if(!ROS_AI_LOG.length){ rosNote('warn','No AI call recorded yet -- nothing to download.'); return; }
        var base='roster-ai-context_div'+(rosState.divisionId||0)+'_'+rosCtxStamp();
        if(fmt==='txt'){ rosCtxSave(base+'.txt', rosCtxText(), 'text/plain'); }
        else { rosCtxSave(base+'.json', rosCtxSafe(rosCtxPayload()), 'application/json'); } }
    function rosCtxCopy(){
        if(!ROS_AI_LOG.length){ rosNote('warn','No AI call recorded yet -- nothing to copy.'); return; }
        var t=rosCtxText();
        try{
            if(navigator.clipboard&&navigator.clipboard.writeText){
                navigator.clipboard.writeText(t).then(function(){ rosNote('info','AI context log copied to the clipboard.'); },
                    function(){ rosNote('warn','The browser refused clipboard access -- use Download instead.'); });
                return; }
            /* older browsers, and any https-less host where the clipboard API is absent */
            var ta=document.createElement('textarea'); ta.value=t; ta.style.position='fixed'; ta.style.opacity='0';
            document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
            rosNote('info','AI context log copied to the clipboard.');
        }catch(ex){ rosErr('CTXLOG','copy failed: '+((ex&&ex.message)||ex));
            rosNote('warn','Could not copy -- use Download instead.'); } }
    function rosCtxClear(){ ROS_AI_LOG=[]; ROS_AI_LOG_EXP={}; rosLog('CTXLOG','ring cleared'); rosCtxRender(); }

    function rosCtxRender(){ var el=document.getElementById('rosCtxLog'); if(!el){ return; }
        var dl=document.getElementById('rosCtxDl');
        if(dl){ dl.innerHTML='\u21e9 log ('+ROS_AI_LOG.length+')';
            dl.className='aidl'+(ROS_AI_LOG.length?'':' off'); }
        var hd=document.getElementById('rosCtxHd');
        if(hd){ hd.innerHTML='Context sent \u00b7 '+ROS_AI_LOG.length+' call'+(ROS_AI_LOG.length===1?'':'s')+' '+(ROS_AI_LOG_OPEN?'\u25b4':'\u25be'); }
        if(!ROS_AI_LOG_OPEN){ el.style.display='none'; return; }
        el.style.display='block';
        var bar='<div class="ctxbar">'
            +'<button type="button" onclick="rosCtxDownload(\'json\')" title="Every recorded call, with full context and message">Download .json</button>'
            +'<button type="button" onclick="rosCtxDownload(\'txt\')" title="Same data, readable without a JSON viewer">Download .txt</button>'
            +'<button type="button" onclick="rosCtxCopy()">Copy</button>'
            +'<button type="button" class="dim" onclick="rosCtxClear()">Clear</button>'
            +'<span class="n">'+ROS_AI_LOG.length+' / 40 kept \u00b7 this page load only</span></div>';
        if(!ROS_AI_LOG.length){ el.innerHTML=bar+'<div class="rhook" style="padding:10px 2px">No AI call yet this session.</div>'; return; }
        var h=bar, i, n=ROS_AI_LOG.length;
        for(i=n-1;i>=0;i--){ var e=ROS_AI_LOG[i], open=!!ROS_AI_LOG_EXP[i];
            h+='<div class="ctxr'+(e.err?' bad':'')+'" onclick="rosCtxExp('+i+')">'
              +'<span class="src">'+rosEsc(e.src)+'</span><span class="t">'+rosEsc(e.at)+'</span>'
              +'<span class="b">'+rosCtxKB(e.bytes)+'</span>'
              +'<span class="d">ctx '+rosCtxKB(e.ctxBytes)+' / '+e.ctxKeys+'k'
                +' \u00b7 msg '+rosCtxKB(e.msgBytes)
                +(e.hist?(' \u00b7 hist '+e.hist+' ('+rosCtxKB(e.histBytes)+')'):'')
                +(e.live?(' \u00b7 live '+e.live):'')
                +' \u00b7 '+(e.ms?(e.ms+'ms'):'\u2026')
                +' \u00b7 out '+rosCtxKB(e.outBytes)
                +(e.err?(' \u00b7 '+rosEsc(e.err)):'')+'</span>'
              +'<span class="x">'+(open?'\u2212':'+')+'</span></div>';
            if(open){
                h+='<div class="ctxd"><div class="k">messages[last] -- what the model reads</div>'
                  +'<pre>'+rosEsc(e.msg)+'</pre>'
                  +'<div class="k">context'+(e.engine?(' \u00b7 engine '+rosEsc(e.engine)):'')+'</div>'
                  +'<pre>'+rosEsc(rosCtxSafe(e.ctx))+'</pre></div>'; } }
        el.innerHTML=h; }
    function rosAiStream(payload, cb, src){
        try{ payload=payload||{}; if(!payload.context||typeof payload.context!=='object'){ payload.context={}; }
            if(payload.context.provider===undefined||payload.context.provider===null||payload.context.provider===''){ payload.context.provider=ROS_AI_ENGINE; }
            if(payload.engine===undefined){ payload.engine=ROS_AI_ENGINE; } }catch(_e){}
        var _t0=Date.now(), _body=JSON.stringify(payload), _ent=null;
        try{
            var _ms=payload.messages||[];
            var _last=_ms.length?String(_ms[_ms.length-1].content||''):'';
            var _histB=0;
            for(var _i=0;_i<_ms.length-1;_i++){ _histB+=String(_ms[_i].content||'').length; }
            _ent={ seq:(++ROS_AI_SEQ), src:src||'?', at:new Date().toTimeString().slice(0,8),
                   iso:new Date().toISOString(),
                   bytes:_body.length, msgBytes:_last.length, histBytes:_histB,
                   ctxBytes:JSON.stringify(payload.context||{}).length,
                   ctxKeys:Object.keys(payload.context||{}).length,
                   live:((payload.context||{}).live||[]).length,
                   hist:Math.max(0,_ms.length-1),
                   engine:payload.engine||'', ctx:payload.context, msg:_last,
                   ms:0, outBytes:0, err:'' };
            ROS_AI_LOG.push(_ent);
            if(ROS_AI_LOG.length>40){ ROS_AI_LOG.shift(); }
        }catch(_e){}
        fetch(ROS.diagnose,{ method:'POST', credentials:'same-origin',
            headers:{'Content-Type':'application/json'}, body:_body })
        .then(function(resp){ if(!resp.ok||!resp.body){ throw new Error('HTTP '+resp.status); }
            var reader=resp.body.getReader(), dec=new TextDecoder('utf-8'), buf='', acc='', fin=false;
            function done(){ if(fin){ return; } fin=true;
                if(_ent){ _ent.ms=Date.now()-_t0; _ent.outBytes=acc.length; }
                cb({ text:acc }); }
            function pump(){ return reader.read().then(function(res){
                if(res.done){ done(); return; }
                buf+=dec.decode(res.value,{stream:true});
                var parts=buf.split('\n\n'); buf=parts.pop();
                for(var i=0;i<parts.length;i++){ var line=parts[i].trim();
                    if(line.indexOf('data:')!==0){ continue; }
                    var fr=line.substring(5).trim();
                    if(fr==='[DONE]'){ done(); return; }
                    var evt=null; try{ evt=JSON.parse(fr); }catch(e){ rosErr('AI','dropped malformed sse frame: '+String(fr).slice(0,160)); continue; }
                    if(evt.type==='text'&&evt.text){ acc+=evt.text; }
                    else if(evt.type==='error'){ rosErr('AI','raw provider error: '+(evt.message||evt.error||acc||''));
                        if(_ent){ _ent.ms=Date.now()-_t0; _ent.err=String(evt.message||evt.error||'provider error').slice(0,120); }
                        if(!fin){ fin=true; cb({ error:rosAiClassifyErr(evt.message||evt.error||acc||'') }); } return; } }
                return pump(); }); }
            return pump(); })
        .catch(function(ex){ rosErr('AI','stream failed: '+((ex&&ex.message)||ex));
            if(_ent){ _ent.ms=Date.now()-_t0; _ent.err=String((ex&&ex.message)||ex).slice(0,120); }
            cb({ error:rosAiClassifyErr(String((ex&&ex.message)||ex)) }); }); }
    function rosAiJsonOf(t){ var x=String(t||'').replace(/```json|```/g,'').trim();
        var a=x.indexOf('{'), b=x.lastIndexOf('}');
        if(a<0||b<=a){ return null; }
        try{ return JSON.parse(x.substring(a,b+1)); }catch(e){ return null; } }
    // Never show a raw provider error to a user. Map known upstream failures to safe wording;
    // strip provider/model names, request ids, JSON error bodies, and billing text.
    function rosAiLooksLikeErr(t){ var x=String(t||'');
        return /"type"\s*:\s*"error"/.test(x) || /invalid_request_error|credit balance|too low|billing|request_id|quota/i.test(x)
            || /\b(400|401|402|403|429|500|502|503)\b\s*[:{]/.test(x) || /^\s*the\s+engine\b/i.test(x); }
    function rosAiClassifyErr(raw){ var t=String(raw||'').toLowerCase();
        if(t.indexOf('credit')>=0||t.indexOf('balance')>=0||t.indexOf('billing')>=0||t.indexOf('quota')>=0||t.indexOf('too low')>=0||t.indexOf('402')>=0){
            return 'AI is temporarily unavailable \u2014 the service account needs attention. Please notify your administrator.'; }
        if(t.indexOf('429')>=0||t.indexOf('rate')>=0||t.indexOf('overload')>=0){ return 'AI is busy right now \u2014 please retry in a moment.'; }
        if(t.indexOf('timeout')>=0||t.indexOf('timed out')>=0){ return 'AI timed out \u2014 please retry.'; }
        if(t.indexOf('401')>=0||t.indexOf('403')>=0||t.indexOf('unauth')>=0||t.indexOf('api key')>=0||t.indexOf('invalid_request')>=0){ return 'AI is temporarily unavailable.'; }
        return 'AI is temporarily unavailable.'; }
    var ROS_AI_VJSON='Respond ONLY with a JSON object {"verdict":"CONFIRMED_DEFECT|NO_DEFECT|INCONCLUSIVE","confidence":<0-100 number>,"reason":"<one or two field-language sentences>","action":"<the single best first step on site>"} and nothing else, no code fences.';
    function rosAiVerdictCall(ctx, lead, cb, src){
        rosAiStream({ context:ctx, verdict:null, messages:[{ role:'user', content:lead+' '+ROS_AI_VJSON }] }, function(r){
            if(r.error){ cb({ error:r.error }); return; }
            if(rosAiLooksLikeErr(r.text)){ cb({ error:rosAiClassifyErr(r.text) }); return; }
            var j=rosAiJsonOf(r.text);
            if(!j){ cb({ error:'shape' }); return; }
            cb(j); }, src||'verdict'); }
    function rosAiTextCall(ctx, question, history, cb, src){
        var msgs=[]; (history||[]).forEach(function(hh){ msgs.push({role:'user',content:hh.q}); msgs.push({role:'assistant',content:hh.a}); });
        msgs.push({ role:'user', content:question });
        rosAiStream({ context:ctx, verdict:null, messages:msgs }, function(r){
            if(r.error){ cb({ error:r.error }); return; }
            if(!r.text){ cb({ error:'empty' }); return; }
            if(rosAiLooksLikeErr(r.text)){ cb({ error:rosAiClassifyErr(r.text) }); return; }
            cb({ answer:r.text }); }, src||'text'); }
    function rosFillAI(){ var o=ROS_ITEMS[rosAiFor]; if(!o||!rosDiag){ return; } var it=o.it;
        var vb=document.getElementById('rosVb');
        if(!ROS.diagnose){ if(vb){ vb.innerHTML='<div class="vb inc"><div class="lead"><div class="vw">AI off</div><div class="hl">AI diagnosis is not enabled for this deployment.</div></div></div>'; } return; }
        rosAiVerdictCall(rosAiCtx(o), rosVerdictLead(o), function(j){
                var err=rosF(j,['error','Error'],'');
                if(err){ var fmsg=(err==='not configured')?'AI diagnosis is not enabled for this deployment.':((err==='empty'||err==='shape')?'AI diagnosis is unavailable right now.':err);
                    if(vb){ vb.innerHTML='<div class="vb inc"><div class="lead"><div class="vw">Unavailable</div><div class="hl">'+rosEsc(fmsg)+'</div></div></div>'; } return; }
                var v=String(rosF(j,['Verdict','verdict'],'INCONCLUSIVE')).toUpperCase();
                var conf=rosF(j,['Confidence','confidence'],''), reason=rosF(j,['Reason','reason'],''), act=rosF(j,['Action','action'],'');
                var vc=v.indexOf('CONFIRM')>=0?'yes':((v.indexOf('NO_')>=0||v.indexOf('NO ')>=0)?'no':'inc');
                var vw=vc==='yes'?'Confirmed':(vc==='no'?'Not confirmed':'Inconclusive');
                var col=vc==='yes'?'#FF7A70':(vc==='no'?'#3ECF8E':'#E8C36B');
                var pct=(conf!==''&&conf!=null)?Number(conf):0;
                var headline=reason?String(reason).split('. ')[0].replace(/\.$/,''):vw;
                rosAiHist.push({ q:'(verdict for '+rosF(it,['AssetName','assetName'],'')+')', a:reason||vw });
                if(vb){ vb.innerHTML='<div class="vb '+vc+'"><div class="lead"><div class="vw">'+rosEsc(vw)+'</div>'
                    +'<div class="hl">'+rosEsc(headline)+'.</div></div>'
                    +'<div class="ringwrap"><div class="ring">'+rosVerdRing(pct,col)+'</div>'
                    +'<div class="sure">'+(vc==='no'?'Sure it is not a sustained fault':(vc==='yes'?'Confidence a defect is present':'Verify on site'))+'</div></div></div>'; }
                // bind AI text into assessment + story
                var asg=document.getElementById('rosAsg'); if(asg){ asg.innerHTML=rosAsgHtml(vc, reason||rosDiag.wisdom.cause.replace(/<[^>]+>/g,''), act||(rosDiag.wisdom.move[0]||''), ''); }
                if(reason){ rosDiag.story.what.body='<p>'+rosEsc(reason)+'</p>'; }
                if(act){ rosDiag.story.do.body='<p>'+rosEsc(act)+'</p>'; }
                rosDiag.story.sure.big=(pct>0?(Math.round(pct)+'% \u2014 '+(vc==='no'?'not a sustained fault':(vc==='yes'?'a defect is likely':'inconclusive'))):'How sure');
                rosDiag.story.sure.body='<p>'+rosEsc(reason||'')+'</p>';
                rosStoryTab(rosDiag.cur); }, 'verdict');
    }
    function rosAskMore(){ var out=document.getElementById('rosChat'), q=document.getElementById('rosAskIn'); if(!out){ return; }
        var o=ROS_ITEMS[rosAiFor]; if(!o||!ROS.diagnose){ return; } var it=o.it;
        var qq=(q&&q.value)||'What should I do first at this station?';
        out.innerHTML+='<div class="msg" style="color:var(--ink2)"><b>You \u00b7 </b>'+rosEsc(qq)+'</div><div class="think" id="rosThink">thinking with the roster context \u2026</div>';
        if(q){ q.value=''; }
        out.scrollTop=out.scrollHeight;
        rosAiTextCall(rosAiCtx(o), qq, rosAiHist.slice(-3), function(j){
                var t=document.getElementById('rosThink'); if(t){ t.parentNode.removeChild(t); }
                var err=rosF(j,['error','Error'],''); var ans=rosF(j,['answer','Answer'],'');
                if(err||!ans){ out.innerHTML+='<div class="rhook">AI diagnosis is unavailable right now.</div>'; }
                else { rosAiHist.push({ q:qq, a:ans }); out.innerHTML+='<div class="msg">'+rosEsc(ans)+'</div>'; }
                out.scrollTop=out.scrollHeight; }, 'ask-more'); }

    function rosRegenerate(){
        var div=parseInt(document.getElementById('rosDiv').value,10)||0;
        var date=document.getElementById('rosDate').value||rosToday();
        if(!div){ rosNote('err','Select a division first.'); return; }
        rosBusy(true); rosNote('info','Rebuilding the roster from current data...');
        rosPost(ROS.regen,{ divisionId:div, rosterDate:date })
            .then(function(j){ var ok=rosF(j,['IsSuccess','isSuccess'],false);
                if(!ok){ rosErr('REGEN','div='+div+' date='+date+' server said: '+rosF(j,['Message','message'],'(no message)')); rosNote('err', rosF(j,['Message','message'],'Regenerate failed.')); return; }
                rosNote('info','Roster rebuilt.'); rosState.divisionId=div; rosState.date=date; rosLoadRollup(); })
            .catch(function(e){ rosErr('REGEN','div='+div+' date='+date+' '+((e&&e.message)||e)); rosNote('err','Regenerate failed: '+e.message); })
            .then(function(){ rosBusy(false); });
    }

    (function(){ var d=document.getElementById('rosDate'); if(d && !d.value){ d.value=rosToday(); } })();
</script>
