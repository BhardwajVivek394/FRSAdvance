        if ((c.sourceProblems || []).length) { head.push('coverage notes: ' + clip(c.sourceProblems.slice(0, 6).join(' | '), 500)); }
        if (c.assetsOmitted) { head.push(c.assetsOmitted + ' assets have no finding, alert or visit; they are counted in the totals and not listed.'); }
