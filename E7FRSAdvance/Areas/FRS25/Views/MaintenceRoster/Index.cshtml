    function rosSteps(a){ var h='<div class="rsteps">', i; for(i=0;i<a.length;i++){ h+='<div class="rstep"><span class="n">'+(i+1)+'</span><div>'+a[i]+'</div></div>'; } return h+'</div>'; }
