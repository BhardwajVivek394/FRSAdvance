    function rosPmDT(s){ var d=new Date(s); if(isNaN(d.getTime())){ return String(s); } function p(n){ return (n<10?'0':'')+n; } return p(d.getDate())+'/'+p(d.getMonth()+1)+' '+p(d.getHours())+':'+p(d.getMinutes()); }
    function rosPmLoadTrend(aid,sid){ var host=document.getElementById('rosPmTrend'); if(!host){ return; }
