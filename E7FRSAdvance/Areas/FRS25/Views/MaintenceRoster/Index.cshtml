            rosPmTrendCache[aid]=j; host.innerHTML=rosPmTrendPlot(j);
        }).catch(function(ex){ rosErr('PMTREND','asset='+aid+' '+((ex&&ex.message)||ex)); host.innerHTML='<div class="rpmclazy">Trend unavailable: '+rosEsc((ex&&ex.message)||'fetch failed')+'</div>'; }); }
    function rosPmTrendPlot(d){ if(!d||!d.transition_summary){ return '<div class="rpmclazy">No transition data in the window.</div>'; }
        var t0=new Date(d.start), t1=new Date(d.end); var span=(t1-t0)||1; var ends=['a','b'], h='', evs=[], i, k;
        for(k=0;k<ends.length;k++){ var tr=(d.transition_summary[ends[k]])||[], dots='', n=0;
            for(i=0;i<tr.length;i++){ var to=String(tr[i].to||''); if(to==='Normal'){ continue; } n++;
                var at=new Date(tr[i].at); var x=Math.max(1,Math.min(99,(at-t0)/span*100));
                var col=(to.toUpperCase().indexOf('OBS')>=0)?'var(--soon)':'var(--urgent)';
                dots+='<div class="rpmdotp" style="left:'+x.toFixed(2)+'%;background:'+col+'" title="'+rosEsc(to)+'"></div>';
                evs.push({at:tr[i].at,end:ends[k].toUpperCase(),from:tr[i].from,to:to}); }
            h+='<div class="rpmtr"><span class="rpmtl">Machine '+ends[k].toUpperCase()+'</span><div class="rpmplot">'+dots+'</div><span class="rpmtn">'+n+' episode'+(n===1?'':'s')+'</span></div>'; }
        evs.sort(function(x,y){ return new Date(y.at)-new Date(x.at); });
        for(i=0;i<Math.min(5,evs.length);i++){ h+='<div class="rpmev">'+rosPmDT(evs[i].at)+' \u00b7 '+evs[i].end+' \u00b7 '+rosEsc(String(evs[i].from||''))+' \u2192 '+rosEsc(String(evs[i].to))+'</div>'; }
        if(!evs.length){ h+='<div class="rpmev">No abnormal classifications in the window.</div>'; }
        return h; }
    function rosPointRead(it,e){ var c=String(e.dominantCause).toUpperCase(), ml=rosF(it,['MlNote','mlNote'],''); var obs=c.indexOf('OBS')>=0; var dead=(rosF(it,['IsFailedRepair','isFailedRepair'],false)||e.activeNow);
        var aid=rosF(it,['AssetId','assetId'],0), sid=rosF(it,['SiteId','siteId'],0);
        var wis;
        if(obs){ wis=rosStory([
            { t:'What it means', art:'point', ac:'var(--soon)', body:'<div class="rslead">Midway through the throw, the motor suddenly worked harder \u2014 like a door hitting a stone.</div>'
              +'Something in the switch is resisting the blades: stones or packing between blade and stock rail, dry slide chairs, or an uneven load between Normal and Reverse. The friction clutch protects the machine, but the throw gets slow \u2014 and one day incomplete.' },
            { t:'Rule out first', art:'ruleout', ac:'var(--urgent)', body:rosSteps([
                '<b>General stiffness is not an obstruction.</b> Lost lubrication, switch lift or an uneven N/R load gives the SAME high-current shape \u2014 do not replace parts before checking the simple causes.',
                '<b>Run a proper 5 mm obstruction test</b> \u2014 that is the honest way to prove the clutch and the setting.']) },
            { t:'Verify on site', art:'verify', ac:'var(--ok)', body:rosSteps([
                'Look between the blades and stock rails for stones, packing or ice \u2014 remove and re-test.',
                'Check and grease the slide chairs; a dry chair alone can mimic this.',
                'Check the stretcher rod and its fastenings.',
                'Compare Normal vs Reverse current across the FULL stroke \u2014 one sample number hides the bump.'])
              +'<div class="evimeta" style="margin-top:9px">IRSEM 19.3.2 \u00b7 point current, obstruction, friction clutch (PNT-005 N/R symmetry, PNT-006 high current is not one cause, PNT-008 waveform-as-one-record).</div>' },
            { t:'If it is ignored', art:'stop', ac:'var(--urgent)', body:'<div class="rslead">One day the point will not complete its throw.</div>'
              +'No detection, the route will not set, and the point sits mid-stroke at the worst moment \u2014 with a train waiting. Clearing and greasing today is minutes; a failed point in service is an operating incident.' } ]); }
        else { wis=rosStory([
            { t:'What it means', art:'point', ac:'var(--soon)', body:'<div class="rslead">The machine says it moved \u2014 but the proof voltage is fading.</div>'
              +'The detection contact that proves the blade position is wearing or dirty. The motor and throw are healthy; the voltage that says \u0022I am locked here\u0022 is drifting toward the drop-out level.' },
            { t:'Rule out first', art:'ruleout', ac:'var(--urgent)', body:rosSteps([
                '<b>Both detections down DURING a commanded operation is normal</b> \u2014 it only matters if it outlasts the operation interval.',
                '<b>A crank-handle or interlocking withhold</b> also removes detection \u2014 check the log first.',
                '<b>A cross / earth fault</b> can fake a position \u2014 the dangerous look-alike; test if the readings make no sense.']) },
            { t:'Verify on site', art:'verify', ac:'var(--ok)', body:rosSteps([
                'Clean and re-adjust the N-detection contact; if it drifts again soon, replace it.',
                'Prove command-start against detection in the records \u2014 the timing tells you contact vs control.',
                'Check motor voltage / current health and the overload / cutoff while you are there.'])
              +'<div class="evimeta" style="margin-top:9px">IRSEM 19.3.2, 21.1.12 \u00b7 detection, point control / protection (PNT-002 both-down-in-transition, PNT-007 low-current feed proof, PNT-011 cross faults).</div>' },
            { t:'If it is ignored', art:'stop', ac:'var(--urgent)', body:'<div class="rslead">When the contact finally drops, the panel loses point proof.</div>'
              +'The route cannot set and the point stands failed until a man reaches it \u2014 usually at night, usually in rain. A contact cleaned on this roster costs ten minutes.' } ]); }
        if(ROS.pm&&aid){ var pc=rosPmCache[aid];
            if(pc&&pc.pm){ return rosPmAnalysis(pc.pm,aid,sid)+(ml?'<div class="rpmrec"><b>ML note \u00b7 </b>'+rosEsc(ml)+'</div>':'')+wis; }
            if(pc&&pc.err){ return '<div class="rpred"><div class="rpredhd"><span class="tag ml">ML</span> '+(obs?'Obstruction in the stroke':'Detection / voltage drift')+'</div>'
                +'<div style="font-size:12px">'+(obs?('Mid-stroke current bump across '+e.total+' operations \u2014 load rises, then the clutch / cutoff acts.'):(dead?'Detection is dead at LOC right now \u2014 the point cannot prove its position.':'N-detection voltage drifting toward drop-out while throw current stays steady.'))+'</div>'
                +'<div class="rhook" style="margin-top:9px">Operation analysis is unavailable right now ('+rosEsc(pc.err)+').</div></div>'+wis; }
            rosPmLoad(it);
            return '<div class="rpred"><div class="rpredhd"><span class="tag ml">ML</span> Operation analysis</div><div class="rpmclazy">Analysing the recent operations of this point \u2026</div></div>'+wis; }
        var h='<div class="rpred"><div class="rpredhd"><span class="tag ml">ML</span> '+(obs?'Obstruction in the stroke':'Detection / voltage drift')+'</div>'
          +'<div style="font-size:12px">'+(obs?('Mid-stroke current bump across '+e.total+' operations \u2014 load rises, then the clutch / cutoff acts. Reads as an obstruction, not a drive-electrical fault.'):(dead?'Detection is dead at LOC right now \u2014 the point cannot prove its position. Throw the operation and watch whether current is present.':'N-detection voltage drifting toward drop-out while throw current stays steady \u2014 marginal contact, not binding.'))+'</div>';
        if(ml){ h+='<div style="font-size:12px;margin-top:8px"><b>ML \u00b7 </b>'+rosEsc(ml)+'</div>'; }
        else { h+='<div class="rhook" style="margin-top:9px"><span class="tag ml">ML</span> &nbsp; Operation analysis is not configured for this deployment.</div>'; }
        h+='</div>';
        return h+wis; }

    function rosSignalRead(it,e){ var tr=rosTrend(e);
        return rosStory([
          { t:'What happened', art:'signal', ac:'var(--ok)', body:'<div class="rslead">The signal\u0027s lamp circuit blinked.</div>'
            +'<div class="rsym">'+rosRB('ok','\u2713','<b>'+(e.total===1?'A single event':e.total+' events')+' in 15 days, '+tr.t+'.</b> One-off blips usually mean supply, not the signal head \u2014 unless they start clustering.')
            +rosRB('n','i','<b>Cause code '+rosEsc(e.dominantCause)+'.</b> The reading to trust is the PAIR \u2014 voltage AND current together, plus the proving relay.')+'</div>' },
          { t:'What it means', art:'mech', ac:'var(--soon)', body:'A signal aspect needs two proofs: the <b>command</b> (the panel asked for it) and the <b>correspondence</b> (current actually flowed and the proving relay agreed). Read it like this: voltage present but NO current \u2192 a break after the transformer (the lamp / LED unit or its feed). Voltage AND current but no proving \u2192 the proving path. Several aspects lost together \u2192 the common supply or cable. And zero on a lamp that was never lit is simply a lamp that was off \u2014 not a fault.' },
          { t:'Rule out first', art:'ruleout', ac:'var(--urgent)', body:rosSteps([
            '<b>A dark or unselected aspect reading zero.</b> That is expected de-energisation \u2014 not an open circuit.',
            '<b>A power changeover (IPS switching)</b> dipping the whole feed for a moment \u2014 that shows on many circuits at once, not one signal.']) },
          { t:'Verify on site', art:'verify', ac:'var(--ok)', body:rosSteps([
            'First confirm the aspect was actually commanded at the alert time \u2014 no command, no fault.',
            'Measure voltage AND current together at the signal head \u2014 the pair tells you which side of the transformer to open.',
            'Check the ECR / proving relay and its contacts \u2014 correspondence faults live here.',
            'Check the supply bus and fuses \u2014 especially if more than one aspect blinked together.'])
            +'<div class="rnopred" style="margin-top:9px"><span class="tag api">API</span> &nbsp; <b>No ML prediction for signals</b> \u2014 deterministic analysis only.</div>'
            +'<div class="evimeta" style="margin-top:8px">IRSEM 7.1.12\u20137.1.15, 21.1.9 \u00b7 aspect command, correspondence, proving (SIG-001 command+correspondence, SIG-002 zero-on-unselected, SIG-004 V/I pattern).</div>' },
          { t:'If it is ignored', art:'stop', ac:'var(--urgent)', body:'<div class="rslead">A failed aspect forces restrictive working.</div>'
            +'Drivers get less information, control posts cautions, and if the proving path is the fault the panel may stop trusting the signal altogether. A blink today is the cheap warning \u2014 use it.' } ]); }
    function rosMoveCompute(){ var res={deg:{Track:[],Point:[],Signal:[],Other:[]},imp:{Track:[],Point:[],Signal:[],Other:[]},unack:0,openN:0,total:0}, i;
        for(i=0;i<ROS_ITEMS.length;i++){ var o=ROS_ITEMS[i], e=o.e, tr=rosTrend(e);
            if(e.activeNow||tr.t==='degrading'){ res.deg[o.fam].push(i); } else if(tr.t==='improving'){ res.imp[o.fam].push(i); }
            if(e.unackKnown){ res.unack+=e.unacked; }
            if(String(rosF(o.it,['CloseStatus','closeStatus'],'OPEN')).toUpperCase()==='OPEN'){ res.openN++; } res.total++; }
        return res; }
    function rosFirstMove(o){ var fam=o.fam, c=String(o.e.dominantCause).toUpperCase();
        if(fam==='Point'){ return c.indexOf('OBS')>=0 ? 'Look between the blades for stones or packing \u2014 then grease the slide chairs.'
                                                      : 'Measure the detection voltage at LOC \u2014 is it near drop-out?'; }
        if(fam==='Signal'){ return c.indexOf('ECR')>=0 ? 'Check the ECR / proving relay before touching the signal head.'
                                                       : 'Measure aspect voltage AND current together at the head.'; }
        if(fam==='Track'){ if(c.indexOf('SHORT')>=0){ return 'Walk the section for a physical bridge \u2014 wire, metal, wet ballast.'; }
            if(c.indexOf('RES HIGH')>=0||c.indexOf('CKT OPEN')>=0||c.indexOf('RES OPEN')>=0){ return 'Megger the section, then open the glued joints and bonds.'; }
            return 'Check drainage and ballast clearance \u2014 compare a dry-day reading.'; }
        return 'Open the job and follow Verify on site.'; }
    function rosMvSpark(e){ var days=rosDays(e), h='<span class="spk">', mx=1, i;
        for(i=8;i<15;i++){ if(days[i].count>mx){ mx=days[i].count; } }
        for(i=8;i<15;i++){ var ht=days[i].count?Math.max(4,Math.round(days[i].count/mx*13)):2;
            h+='<i class="'+(i===14&&days[i].count?'h':'')+'" style="height:'+ht+'px"></i>'; }
        return h+'</span>'; }
    function rosMvToggle(){ rosMvMore=!rosMvMore; rosRenderMovement(); }
    function rosEyesFilter(ty){ rosEyesType=ty; rosRenderMovement(); }
    function rosRenderMovement(){ var m=rosMoveCompute();
        var deg=[].concat(m.deg.Track,m.deg.Point,m.deg.Signal,m.deg.Other);
        var imp=[].concat(m.imp.Track,m.imp.Point,m.imp.Signal,m.imp.Other);
        var i, h='<div class="rmv">';
        // ---- left dark spine: tonight's picture ----
        h+='<div class="rmz1"><div class="zt">Tonight\u0027s picture</div>'
          +'<div class="rmbig'+(deg.length?' bad':' ok')+'"><span class="n">'+deg.length+'</span><span class="lbl">need eyes<br>worsening or active</span></div>'
          +'<div class="rmbig ok"><span class="n">'+imp.length+'</span><span class="lbl">settling<br>alert rate falling</span></div>'
          +(m.unack>0?'<div class="rmbig warn"><span class="n" id="rosUnackBig">'+m.unack+'</span><span class="lbl">unacknowledged<br>alerts to book</span></div>'
                     :'<div class="rmbig"><span class="n" style="color:#C9D2DE">'+m.openN+'</span><span class="lbl">jobs open<br>on this roster</span></div>');
        var names=deg.slice(0,2).map(function(gi){ return '<b>'+rosEsc(rosF(ROS_ITEMS[gi].it,['AssetName','assetName'],''))+'</b>'; });
        h+='<div class="rmread">'+(deg.length===0
            ?'Station is <b>settling</b> \u2014 nothing needs eyes tonight. Work the list and book each closure.'
            :'Station is '+(imp.length>=deg.length?'<b>settling overall</b>':'<b>under pressure</b>')+' \u2014 '+imp.length+' of '+m.total
             +' assets easing. Put eyes on '+names.join(' and ')+(deg.length>2?' (+'+(deg.length-2)+' more)':'')+' before signing off.')
          +'</div></div>';
        // ---- content column (one flowing column: no blank centre possible) ----
        h+='<div class="rmc">';
        // ---- STATION READ first (prominent) ----
        h+='<div class="rmai big'+(ROS.diagnose?'':' off')+'" id="rosMvAi"><div class="hd"><span class="dot"></span><span class="tag ai">AI</span><b>Station read</b></div>'
          +'<div class="tx" id="rosMvAiTx">'+(ROS.diagnose?'Reading the station \u2026':'The AI station read appears here once diagnosis is enabled.')+'</div></div>';
        // ---- needs eyes, grouped by asset type (click a type to filter) ----
        h+='<div class="rmsec eyes">';
        if(deg.length){ h+='<div class="hd"><span class="ld"></span><span class="t">Needs eyes first</span></div>';
            var tc={ Track:m.deg.Track.length, Point:m.deg.Point.length, Signal:m.deg.Signal.length, Other:m.deg.Other.length };
            if(rosEyesType!=='ALL'&&(!tc[rosEyesType])){ rosEyesType='ALL'; }
            h+='<div class="eyetabs"><span class="eyetab'+(rosEyesType==='ALL'?' on':'')+'" onclick="rosEyesFilter(\'ALL\')">All \u00b7 '+deg.length+'</span>';
            ['Track','Point','Signal','Other'].forEach(function(ty){ if(tc[ty]>0){ h+='<span class="eyetab '+ty.toLowerCase()+(rosEyesType===ty?' on':'')+'" onclick="rosEyesFilter(\''+ty+'\')">'+ty+' \u00b7 '+tc[ty]+'</span>'; } });
            h+='</div>';
            var shown=(rosEyesType==='ALL')?deg:(m.deg[rosEyesType]||[]);
            for(i=0;i<shown.length;i++){ var gi=shown[i], o=ROS_ITEMS[gi], e=o.e;
                var aid=rosF(o.it,['AssetName','assetName'],'Asset');
                h+='<button class="rmeye" onclick="rosSelAsset('+gi+')">'
                  +'<span class="r1"><span class="id">'+rosEsc(aid)+'</span><span class="fam '+o.fam.toLowerCase()+'">'+o.fam.toUpperCase()+'</span>'
                  +'<span class="why'+(e.activeNow?'':' warn')+'">'+(e.activeNow?'<span class="ld"></span>Active now':'Worsening \u00b7 reset')+'</span></span>'
                  +'<span class="cz">'+rosEsc(e.dominantCause)+'</span>'
                  +'<span class="meta">'+rosMvSpark(e)+'<span>'+e.total+' alert'+(e.total===1?'':'s')+' \u00b7 '+e.firstHalf+' \u2192 '+e.secondHalf+'</span><span class="go">open \u2192</span></span>'
                  +'<span class="first"><b>First</b>'+rosFirstMove(o)+'</span></button>'; } }
        else { h+='<div class="hd"><span class="t" style="color:var(--ok)">Nothing needs eyes</span></div>'
              +'<div class="rmok">No asset is worsening or active right now \u2014 the roster is routine attention only.</div>'; }
        h+='</div>';
        // settling
        if(imp.length){ var lim=rosMvMore?imp.length:8;
            h+='<div class="rmsec sett"><div class="hd"><span class="t" style="color:var(--ok)">Settling \u00b7 '+imp.length+'</span></div><div>';
            for(i=0;i<imp.length&&i<lim;i++){ var g2=imp[i];
                h+='<span class="rmsc" onclick="rosSelAsset('+g2+')">'+rosEsc(rosF(ROS_ITEMS[g2].it,['AssetName','assetName'],''))+' <span class="dn">\u2198</span></span>'; }
            if(imp.length>8){ h+='<span class="rmsc more" onclick="rosMvToggle()">'+(rosMvMore?'show less':'+'+(imp.length-8)+' more')+'</span>'; }
            h+='</div><div class="rmsub">Leave these alone \u2014 the trend is doing the work. They stay on the roster until clear.</div></div>'; }
        h+='<div class="rmdiv"></div>';
        // before you sign off
        h+='<div class="rmsec sign"><div class="hd"><span class="t">Before you sign off</span></div><div class="rmtasks">';
        if(m.unack>0){ h+='<div class="rmtask warn"><span class="kn" id="rosUnackN">'+m.unack+'</span><div class="tx"><b>alert'+(m.unack===1?'':'s')+' unacknowledged.</b>'
            +'<span class="act">Acknowledge against each asset as you attend it \u2014 the division report counts these.</span></div></div>'; }
        h+='<div class="rmtask ink"><span class="kn">'+m.openN+'</span><div class="tx"><b>job'+(m.openN===1?'':'s')+' still open on this roster.</b>'
            +'<span class="act">Close each with a finding \u2014 Defect confirmed, Nothing found, or Work done.</span></div></div>';
        h+='</div></div>';
        // acknowledgement scorecard (reconciling)
        h+='<div class="rmsec ack"><div class="hd"><span class="t">Acknowledgement \u00b7 15 days</span></div>'
          +'<div class="rmack" id="rosAckCard" style="display:none"></div></div>';
        h+='</div></div>';
        document.getElementById('rosMove').innerHTML=h;
        if(ROS.ack){ rosAckLoad(); }
        if(ROS.diagnose){ rosMvAiLoad(m,deg); } }
    function rosAckFill(d){ var card=document.getElementById('rosAckCard'); if(!card){ return; }
        var t=d.ackTrue||0, f=d.ackFalse||0, pt=d.ackPT||0, acked=d.acked||0, total=d.total||0;
        var maint=(d.ackMaint!=null?d.ackMaint:0)+(d.ackAck!=null?d.ackAck:0);
        var other=Math.max(0, acked-(t+f+pt+maint));   // any leftover (unknown status) still reconciles
        var mtot=maint+other;                            // maintenance / no-verdict bucket
        var un=Math.max(0,total-acked);
        function seg(cls,n){ return n>0?'<i class="'+cls+'" style="flex:'+n+'" title="'+n+'"></i>':''; }
        function key(cls,label,n){ return '<span class="k'+(n===0?' z':'')+'"><span class="sw '+cls+'"></span>'+label+' <b>'+n+'</b></span>'; }
        card.innerHTML='<div class="top"><span class="big">'+acked+'</span><span class="of">of '+total+' acknowledged</span>'
            +'<span class="un">'+un+' unacked</span></div>'
          +'<div class="ackbar">'+seg('t',t)+seg('m',mtot)+seg('f',f)+seg('pt',pt)+'</div>'
          +'<div class="acklg">'+key('t','True',t)+key('m','Maintenance',mtot)+key('f','False',f)+key('pt','Partial',pt)+'</div>'
          +'<div class="ackfoot">Every acknowledged alert is one of these. '
            +(mtot>0?'<b>'+mtot+'</b> were acknowledged as maintenance / cleared without a true-false verdict.':'All carry a true / false verdict.')+'</div>';
        card.style.display='';
        var b1=document.getElementById('rosUnackBig'); if(b1){ b1.textContent=un; }
        var b2=document.getElementById('rosUnackN'); if(b2){ b2.textContent=un; } }
    function rosAckLoad(){ var it0=(ROS_ITEMS[0]||{}).it||{};
        var sid=rosF(rosState.sheet,['SiteId','siteId'],0)||rosF(it0,['SiteId','siteId'],0);
        var iso=rosDayISO(14);
        var key=sid+'|'+iso;
        if(rosAckCache[key]){ rosAckFill(rosAckCache[key]); return; }
        if(rosAckBusy[key]||!sid){ return; } rosAckBusy[key]=true;
        rosPostJson(ROS.ack,{ siteId:sid, divisionId:rosState.divisionId, date:iso })
            .then(function(j){ rosAckBusy[key]=false; var err=rosF(j,['error','Error'],'');
                if(err){ return; }
                var d={ total:rosF(j,['total','Total'],0), acked:rosF(j,['acked','Acked'],0),
                        ackTrue:rosF(j,['ackTrue','AckTrue'],0), ackFalse:rosF(j,['ackFalse','AckFalse'],0),
                        ackPT:rosF(j,['ackPT','AckPT'],0) };
                rosAckCache[key]=d; rosAckFill(d); })
            .catch(function(ex){ rosErr('ACK','key='+key+' '+((ex&&ex.message)||ex)); rosAckBusy[key]=false; }); }
    function rosMvAiLoad(m,deg){ var it0=(ROS_ITEMS[0]||{}).it||{};
        var sid=rosF(rosState.sheet,['SiteId','siteId'],0)||rosF(it0,['SiteId','siteId'],0);
        var key=sid+'|'+rosState.date;
        if(rosMvAiCache[key]){ var el=document.getElementById('rosMvAiTx'); if(el){ el.innerHTML=rosMvAiCache[key]; } return; }
        if(rosMvAiBusy[key]){ return; } rosMvAiBusy[key]=true;
        // grounded per-asset detail for the assets that need eyes -- family, cause, trend, active, PM state
        var eyes=deg.slice(0,5).map(function(gi){ var o=ROS_ITEMS[gi], e=o.e;
            var pm=(o.pm&&o.pm.worst)?(', PM '+o.pm.worst):'';
            return { name:rosF(o.it,['AssetName','assetName'],''), family:o.fam, cause:e.dominantCause,
                     activeNow:!!e.activeNow, trend:(e.secondHalf>e.firstHalf?'worsening':(e.secondHalf<e.firstHalf?'settling':'flat')),
                     window:(e.firstHalf+'\u2192'+e.secondHalf)+pm }; });
        var settling=impNames(m).slice(0,6);
        var stName=rosF(rosState.sheet,['SiteName','siteName'],'')||rosF(it0,['StationName','stationName'],'')||'this station';
        var ctx={ station:stName, date:rosState.date, totalJobs:m.total, openJobs:m.openN, unacknowledged:m.unack,
                  needEyesCount:deg.length, settlingCount:m.total-deg.length, needsEyes:eyes, settling:settling };
        // Embed the facts IN the question text -- the shared AI prompt is alert-oriented, so a
        // station-level context object alone reads as "blank alert fields". Putting the roster
        // facts in the user message makes them available to the model directly.
        var eyesTxt=eyes.length?eyes.map(function(x){ return x.name+' ('+x.family+', '+x.cause+', '+x.trend
                    +(x.activeNow?', active now':'')+', '+x.window+')'; }).join('; '):'none';
        var settTxt=settling.length?settling.join(', '):'none';
        var facts='ROSTER SIGN-OFF FACTS \u2014 Station: '+stName+'. Date: '+rosState.date+'. '
                 +'Tonight: '+deg.length+' need eyes, '+(m.total-deg.length)+' settling, '+m.unack+' unacknowledged, '+m.openN+' jobs open. '
                 +'NEEDS EYES: '+eyesTxt+'. SETTLING: '+settTxt+'. ';
        var ask = deg.length===0
            ? facts+'Nothing needs eyes tonight. In ONE plain sentence, confirm the station is settling and the maintainer can work the list and book closures. Use ONLY these facts. No lists, no headings, no markdown.'
            : facts+'You are briefing the night maintainer at sign-off. In 2\u20133 short plain sentences, name the asset(s) from NEEDS EYES that must be attended first and WHY (use its family, cause, trend and active flag), then confirm the rest is settling. Use ONLY these facts; name the real assets above; no lists, no headings, no markdown.';
        rosAiTextCall(ctx, ask, [],
                function(j){ rosMvAiBusy[key]=false; var el=document.getElementById('rosMvAiTx'); if(!el){ return; }
                    var err=rosF(j,['error','Error'],''), ans=rosF(j,['answer','Answer'],'');
                    if(err==='not configured'){ var bx=document.getElementById('rosMvAi'); if(bx){ bx.className='rmai off'; }
                        el.innerHTML='The AI station read appears here once diagnosis is enabled.'; return; }
                    if(err||!ans){ var smsg=(err&&err.indexOf(' ')>=0&&err!=='not configured')?err:('Station read unavailable \u2014 '+(err==='empty'?'the model returned nothing':'call failed')+'.');
                        el.innerHTML=rosEsc(smsg)+' <span class="rcopen" onclick="rosMvAiRetry()">retry</span>'; rosMvAiFail[key]=true; return; }
                    rosMvAiCache[key]=rosEsc(ans.replace(/\s+/g,' ').trim()); el.innerHTML=rosMvAiCache[key]; }, 'station-read'); }
    function rosMvAiRetry(){ var it0=(ROS_ITEMS[0]||{}).it||{};
        var sid=rosF(rosState.sheet,['SiteId','siteId'],0)||rosF(it0,['SiteId','siteId'],0), key=sid+'|'+rosState.date;
        delete rosMvAiCache[key]; rosMvAiFail[key]=false; rosMvAiBusy[key]=false;
        var el=document.getElementById('rosMvAiTx'); if(el){ el.innerHTML='Reading the station \u2026'; }
        rosRenderMovement(); }
    function impNames(m){ var a=[].concat(m.imp.Track,m.imp.Point,m.imp.Signal,m.imp.Other);
        return a.map(function(gi){ return rosF(ROS_ITEMS[gi].it,['AssetName','assetName'],''); }); }
    function rosClose(itemId, status){
        var remark='';
        if(status==='NO_DEFECT_FOUND'||status==='CONFIRMED_DEFECT'){ remark=window.prompt('Remark (optional) -- what did you find?','')||''; }
        var card=document.getElementById('rosItem'+itemId); if(card){ card.style.opacity='.5'; }
        rosPost(ROS.close,{ itemId:itemId, closeStatus:status, remark:remark })
            .then(function(j){ var ok=rosF(j,['IsSuccess','isSuccess'],false);
                if(!ok){ if(card){card.style.opacity='1';} rosNote('err', rosF(j,['Message','message'],'The item could not be closed.')); return; }
                rosNote('info','Item closed. It will carry into tomorrow only if it is still relevant.');
                rosOpenSheet(rosF(rosState.sheet,['SiteId','siteId'],0)); })
            .catch(function(e){ rosErr('CLOSE','item='+itemId+' '+((e&&e.message)||e)); if(card){card.style.opacity='1';} rosNote('err','Close failed: '+e.message); });
    }

    // AI popup -- seeded with the whole roster context; posts to ROS.diagnose when configured
