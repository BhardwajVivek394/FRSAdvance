#dm .dm-stat small { display:block; font-size:13px; color:var(--muted); }
#dm .dm-red { color:var(--red); }
#dm .dm-teal { color:var(--teal); }
#dm .dm-paths { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:22px; }
