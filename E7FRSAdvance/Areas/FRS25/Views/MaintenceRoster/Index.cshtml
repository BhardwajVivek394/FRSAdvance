ame{background:none;border:0;font:inherit;font-weight:750;color:#17395a;padding:0;cursor:pointer;text-align:left}#dm .dm-status{font-size:13px;color:#675128}#dm .dm-status.attended{color:#176958}#dm .dm-action .dm-btn{margin:3px}#dm .dm-filters{grid-template-columns:minmax(180px,1.5fr) repeat(3,minmax(140px,1fr))}#dm .dm-chart-panel h2{font-size:22px}#dm .dm-stat{min-height:128px}#dm .dm-stat strong{font-size:34px}#dm .dm-stat-label{font-size:13px}#dm button:focus-visible,#dm a:focus-visible{outline:3px solid #2689cf;outline-offset:3px}#dm .dm-detail-form textarea:invalid{border-color:#c85050}#dm .dm-history-remark{white-space:pre-wrap;overflow-wrap:anywhere}#dm .dm-ai-answer{overflow-wrap:anywhere}#dm .dm-table-wrap table{min-width:1120px}
@@media(max-width:900px){#dm .dm-filters{grid-template-columns:repeat(2,minmax(0,1fr))}#dm .dm-bar{grid-template-columns:115px minmax(30px,1fr) 35px;gap:8px}#dm .dm-chart-panel{padding:16px}#dm .dm-outcomes{gap:12px}}
@@media(max-width:720px){#dm .dm-table-wrap table{min-width:0}#dm .dm-site-card{min-width:0}#dm .dm-filters{grid-template-columns:1fr}#dm .dm-site-grid{grid-template-columns:1fr}#dm .dm-heading{gap:16px}#dm .dm-bar{grid-template-columns:100px minmax(25px,1fr) 32px;font-size:13px}#dm .dm-stat{min-height:116px}#dm .dm-stat strong{font-size:28px}}
@@media print{#dm .dm-site-card .dm-btn,#dm [data-asset-ai],#dm #dmDivisionAi{display:none}#dm .dm-bar-track i{print-color-adjust:exact;-webkit-print-color-adjust:exact}}
/* Maintainer view: compact selectors, legible controls and full worksheet navigation. */
#dm .dm-chart-panel .dm-workhead{padding:0;flex-wrap:nowrap}
#dm .dm-chart-panel .dm-field{flex:0 0 190px;min-width:160px}
#dm .dm-chart-panel h2{font-size:20px}
#dm .dm-workhead #dmWorkSub:empty{display:none}
#dm #dmRoster,#dm #dmRows tr{scroll-margin-top:20px}
#dm .dm-worksheet-list{display:grid;gap:10px;margin-top:18px}
#dm .dm-worksheet-row{display:grid;grid-template-columns:30px 1fr auto;align-items:center;gap:12px;border:1px solid var(--line);border-radius:9px;padding:14px}
#dm .dm-worksheet-row p,#dm .dm-worksheet-row small{font-size:13px;color:var(--muted)}
#dm .dm-worksheet-no{font-variant-numeric:tabular-nums;color:var(--muted)}
#dmPrintReport{display:none}
@@media(max-width:550px){#dm .dm-chart-panel .dm-workhead{align-items:flex-start;flex-direction:column}#dm .dm-chart-panel .dm-field{flex:auto;width:100%}#dm .dm-worksheet-row{grid-template-columns:25px 1fr}#dm .dm-worksheet-row .dm-btn{grid-column:2;justify-self:start}}
@@page{size:A4 landscape;margin:12mm}
@@media print{
 body.dm-printing{margin:0!important;padding:0!important;background:white!important;overflow:visible!important;height:auto!important}
 body.dm-printing > *{display:none!important}
 body.dm-printing > #dmPrintReport{display:block!important;color:#142b42;font:10pt/1.35 Arial,sans-serif}
 #dmPrintReport header{margin-bottom:6mm}#dmPrintReport h1{font-size:20pt;margin:0 0 3mm}#dmPrintReport p{margin:2mm 0}
 #dmPrintReport table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:9pt}
 #dmPrintReport thead{display:table-header-group}#dmPrintReport tbody{display:table-row-group}#dmPrintReport tr{display:table-row;break-inside:avoid;page-break-inside:avoid}
 #dmPrintReport th,#dmPrintReport td{display:table-cell;border-bottom:1px solid #ccd5df;padding:3mm 2mm;text-align:left;vertical-align:top;overflow-wrap:anywhere}
 #dmPrintReport th{background:#eff3f7}#dmPrintReport th:first-child{width:4%}#dmPrintReport th:nth-child(2){width:15%}#dmPrintReport th:nth-child(3){width:20%}#dmPrintReport th:nth-child(4){width:8%}#dmPrintReport th:nth-child(5){width:8%}#dmPrintReport th:nth-child(6){width:8%}#dmPrintReport th:nth-child(7){width:13%}#dmPrintReport th:nth-child(8){width:24%}
 #dmPrintReport strong,#dmPrintReport small{display:block}#dmPrintReport small{color:#526477;font-size:8pt;margin-top:1mm}
 #dmPrintReport .dm-source{display:block}#dmPrintReport .dm-action{display:none!important}
}

/* Restored diagnostics */
#dm .dm-log-dialog{width:min(1100px,calc(100% - 28px))}
#dm .dm-log-record{padding:12px;border:1px solid var(--line);border-radius:8px;margin-top:12px}
#dm .dm-log-record summary{cursor:pointer;font-weight:600}
#dm .dm-log-record pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:12px;max-height:360px;overflow:auto;background:#f1f5fa;padding:12px}
#dm .dm-alert-window{margin:20px 0;padding:16px;border:1px solid var(--line);border-radius:10px}
#dm .dm-alert-bars{display:grid;grid-template-columns:repeat(15,minmax(0,1fr));gap:4px;margin-top:14px}
#dm .dm-alert-bar{border:0;background:transparent;padding:0;color:var(--ink);min-width:0;text-align:center}
#dm .dm-alert-bar b,#dm .dm-alert-bar small{display:block;font-size:11px;font-variant-numeric:tabular-nums}
#dm .dm-alert-bar>span{display:flex;height:64px;align-items:flex-end;justify-content:center}
#dm .dm-alert-bar i{display:block;width:70%;background:var(--blue);border-radius:3px 3px 0 0;min-height:2px}
#dm .dm-alert-bar:hover{background:#dfeafb;border-radius:4px}
#dm .dm-assessment-head{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:15px;background:#e9f2ff;border-radius:8px;margin:12px 0}
#dm .dm-assessment-block{padding:12px 0;border-bottom:1px solid var(--line)}

#dm .dm-evidence-expand{margin:18px 0;padding:14px;border:1px solid var(--line);border-radius:10px}
#dm .dm-evidence-expand>summary{font-weight:650;cursor:pointer}
#dm .dm-reading-section{padding:16px 0;border-top:1px solid var(--line);margin-top:12px}
#dm .dm-reading-figure{margin:12px 0}
#dm .dm-reading-plot{display:block;width:100%;height:auto;max-height:140px;background:#f5f8fc}
#dm .dm-reading-plot path{stroke:var(--blue);stroke-width:2;fill:none;stroke-linejoin:round}
#dm .dm-reading-band{fill:#d8eee5}
#dm .dm-reading-limit{stroke:var(--teal);stroke-dasharray:4 4}
#dm .dm-reading-figure figcaption{font-size:12px;color:var(--muted)}


/* ===== Division UI 3.0 (2.10.0.0): reference layout -- side rail, top bar, command-centre views ===== */
#dm { --bg:#EEF1F6; --panel:#FFFFFF; --panel2:#F7F9FC; --ink:#14203A; --muted:#4D5A70; --line:#DCE2EB; --line2:#EBEFF5;
      --navy:#0D1A33; --nav2:#1A2D55; --navink:#D3DCEC; --blue:#1D4FC4; --teal:#0E6B58; --red:#B42318; --amber:#8A4B00;
      --uBg:#FDE6E3; --sBg:#FFEFD3; --mBg:#E2EAFD; --okBg:#DBF2EA;
      font:14px/1.45 'IBM Plex Sans',system-ui,-apple-system,"Segoe UI",sans-serif; color:var(--ink); background:var(--bg);
      border-radius:0; overflow:visible; }
#dm .dm-shell { display:grid; grid-template-columns:232px minmax(0,1fr); min-height:calc(100vh - 60px); }
#dm .dm-rail { background:var(--navy); color:var(--navink); padding:16px 10px; display:flex; flex-direction:column; gap:4px; position:sticky; top:0; align-self:start; height:100vh; overflow-y:auto; }
#dm .dm-rbrand { padding:4px 10px 14px; border-bottom:1px solid #22355E; margin-bottom:8px; display:flex; flex-direction:column; }
#dm .dm-rbrand b { color:#fff; font-size:18px; letter-spacing:.02em; }
#dm .dm-rbrand span { color:#fff; font-size:13.5px; }
#dm .dm-rbrand small { color:#8FA0C2; font-size:12px; }
#dm .dm-rlinks { display:flex; flex-direction:column; gap:2px; }
#dm .dm-rlinks a { display:flex; justify-content:space-between; align-items:center; gap:8px; color:var(--navink); text-decoration:none; padding:10px 12px; border-radius:7px; font-size:14px; border:0; }
#dm .dm-rlinks a:hover { background:#16284C; color:#fff; }
#dm .dm-rlinks a[aria-current="page"] { background:#24427E; color:#fff; font-weight:600; }
#dm .dm-rlinks a em { font-style:normal; font-size:11px; background:#F1AE52; color:#1B1200; border-radius:999px; padding:1px 7px; font-weight:600; }
#dm .dm-rlinks a i { font-style:normal; color:#8FA0C2; }
#dm .dm-rfoot { margin-top:auto; padding:10px; }
#dm .dm-live { display:inline-flex; align-items:center; gap:7px; font-size:12px; color:#AEBBD3; }
#dm .dm-live i { width:8px; height:8px; border-radius:50%; background:#5B6B8A; flex:none; }
#dm .dm-live.on i { background:#2E9E6B; }
#dm .dm-main { padding:0; min-width:0; }
#dm .dm-topbar { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:12px; padding:14px 20px; background:var(--panel); border-bottom:1px solid var(--line); position:sticky; top:0; z-index:20; }
#dm .dm-topbar h1 { margin:0; font-size:22px; font-weight:600; letter-spacing:0; color:var(--ink); }
#dm .dm-topbar .dm-sub { margin:2px 0 0; }
#dm .dm-body { padding:14px 20px 36px; display:flex; flex-direction:column; gap:12px; }
#dm .dm-body > * { margin-top:0; margin-bottom:0; }
/* views: an element shows only in the views listed in data-views */
#dm[data-view="home"] [data-views]:not([data-views~="home"]),
#dm[data-view="stations"] [data-views]:not([data-views~="stations"]),
#dm[data-view="issues"] [data-views]:not([data-views~="issues"]),
#dm[data-view="roster"] [data-views]:not([data-views~="roster"]),
#dm[data-view="outcomes"] [data-views]:not([data-views~="outcomes"]) { display:none !important; }
#dm[data-view="issues"] .dm-chart-panel { order:1; }
#dm .dm-footer { order:3; }
/* primitives */
#dm .dm-btn { min-height:34px; padding:0 12px; border-radius:6px; border:1px solid var(--line); background:var(--panel); font-size:13px; font-weight:500; }
#dm .dm-btn:hover { background:var(--panel2); }
#dm .dm-btn.dm-sm { min-height:28px; padding:0 9px; font-size:12px; }
#dm .dm-primary { background:var(--blue); border-color:var(--blue); color:#fff; }
#dm .dm-primary:hover { background:#173F9E; }
#dm .dm-toolbar { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:12px 14px; gap:12px; align-items:flex-end; }
#dm .dm-field label { font-size:12px; color:var(--muted); font-weight:500; }
#dm .dm-field select, #dm .dm-field input { height:34px; border:1px solid var(--line); border-radius:6px; background:var(--panel); padding:0 8px; font-size:13px; }
#dm .dm-scope-label { font-size:12.5px; color:var(--muted); font-weight:600; }
#dm .dm-panel, #dm .dm-chart-panel, #dm .dm-workspace { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:14px; min-width:0; box-shadow:none; }
#dm .dm-ph { display:flex; justify-content:space-between; align-items:flex-start; gap:10px; flex-wrap:wrap; margin:0 0 10px; }
#dm .dm-ph h2, #dm .dm-workhead h2 { font-size:15px; font-weight:600; margin:0; }
#dm .dm-ph p { font-size:12px; color:var(--muted); margin:2px 0 0; }
#dm .dm-c2 { display:grid; gap:12px; grid-template-columns:minmax(0,3fr) minmax(0,2fr); }
#dm .dm-mono { font-family:'IBM Plex Mono',ui-monospace,Consolas,monospace; }
/* KPI strip (existing stat cards) */
#dm .dm-summary { display:grid; gap:10px; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); }
#dm .dm-stat { background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:12px 14px; display:flex; flex-direction:column; gap:2px; text-align:left; min-width:0; box-shadow:none; }
#dm button.dm-stat:hover { border-color:var(--blue); background:var(--panel); }
#dm .dm-stat-label { font-size:12px; color:var(--muted); text-transform:none; letter-spacing:0; font-weight:500; }
#dm .dm-stat strong { font-size:26px; line-height:1.15; font-weight:600; color:var(--ink); }
#dm .dm-stat small { font-size:11.5px; color:var(--muted); }
#dm .dm-stat strong.dm-red { color:var(--red); }
#dm .dm-stat strong.dm-teal { color:var(--teal); }
/* tables, pills, tabs */
#dm table { font-size:13px; }
#dm thead th { font-size:12px; font-weight:600; color:var(--muted); background:var(--panel2); text-transform:none; letter-spacing:0; }
#dm .dm-pill { display:inline-block; padding:2px 8px; border-radius:999px; font-size:11px; font-weight:600; background:var(--mBg); color:var(--blue); }
#dm .dm-pill.urgent { background:var(--uBg); color:var(--red); }
#dm .dm-pill.soon { background:var(--sBg); color:var(--amber); }
#dm .dm-status { font-size:12px; }
#dm .dm-status.attended { color:var(--teal); }
#dm .dm-tab { border-radius:6px; font-size:13px; }
#dm .dm-tab[aria-pressed="true"] { background:var(--blue); border-color:var(--blue); color:#fff; }
#dm .dm-tab[aria-pressed="true"] span { background:rgba(255,255,255,.22); color:#fff; }
#dm .dm-site-card { border-radius:10px; border:1px solid var(--line); box-shadow:none; }
#dm .dm-message { border-radius:8px; font-size:13px; }
/* lifecycle */
#dm .dm-flow { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:8px; }
#dm .dm-flow div { background:var(--panel2); border:1px solid var(--line2); border-radius:8px; padding:9px 10px; display:flex; flex-direction:column; gap:3px; min-width:0; }
#dm .dm-flow span { font-size:12px; color:var(--muted); }
#dm .dm-flow b { font-size:22px; font-weight:600; line-height:1.1; }
#dm .dm-flow i { display:block; height:5px; border-radius:999px; background:var(--line2); overflow:hidden; }
#dm .dm-flow i u { display:block; height:100%; }
#dm .dm-flow small { font-size:11px; color:var(--muted); }
/* heatmap */
#dm .dm-hm-ctrl { display:flex; gap:8px; align-items:center; }
#dm .dm-hm-ctrl label { font-size:12px; color:var(--muted); }
#dm .dm-hm-ctrl select { height:30px; border:1px solid var(--line); border-radius:6px; background:var(--panel); padding:0 8px; font-size:12.5px; }
#dm .dm-legend { display:flex; flex-wrap:wrap; gap:10px; align-items:center; font-size:11.5px; color:var(--muted); margin:0 0 10px; }
#dm .dm-legend i { display:inline-block; width:12px; height:12px; border-radius:3px; margin-right:4px; vertical-align:-2px; border:1px solid rgba(0,0,0,.12); }
#dm .dm-hm-scroll { overflow-x:auto; }
#dm .dm-hmg { display:grid; row-gap:8px; align-items:center; min-width:max-content; }
#dm .dm-hmh { font-size:11.5px; color:var(--muted); font-weight:600; padding:0 10px 2px; white-space:nowrap; }
#dm .dm-hm-st { font-family:'IBM Plex Mono',ui-monospace,Consolas,monospace; font-weight:600; font-size:12.5px; background:none; border:0; text-align:left; padding:0 8px 0 0; color:var(--ink); min-height:0; cursor:pointer; max-width:150px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
#dm .dm-hm-st:hover { color:var(--blue); text-decoration:underline; }
#dm .dm-hm-fam { display:flex; flex-wrap:wrap; gap:3px; padding:0 10px; border-right:1px dashed var(--line); max-width:300px; }
#dm .dm-hm-tot { padding-left:10px; font-size:13px; font-weight:600; color:var(--red); text-align:left; }
#dm .dm-hc { width:14px; height:14px; min-height:0; border-radius:3px; border:0; padding:0; cursor:pointer; background:#E3E7EE; display:inline-block; }
#dm .dm-hc:hover, #dm .dm-hc:focus-visible { outline:2px solid var(--ink); outline-offset:1px; }
#dm .dm-h-u { background:#D5492C; } #dm .dm-h-s { background:#F1AE52; } #dm .dm-h-m { background:#9DB4EE; } #dm .dm-h-ok { background:#4FB6A0; } #dm .dm-h-n { background:#E3E7EE; }
#dm .dm-h-p { background:#F1AE52; } #dm .dm-h-q { background:#B8C0CF; } #dm .dm-h-a { background:#4FB6A0; } #dm .dm-h-c { background:#1E7A4F; }
/* compact tables used by the new views */
#dm .dm-t { width:100%; border-collapse:collapse; font-size:13px; }
#dm .dm-t th { text-align:left; font-size:12px; font-weight:600; color:var(--muted); padding:7px 8px; border-bottom:1px solid var(--line); background:var(--panel2); white-space:nowrap; }
#dm .dm-t td { padding:8px; border-bottom:1px solid var(--line2); vertical-align:top; }
#dm .dm-t td small { display:block; color:var(--muted); font-size:11.5px; }
#dm .dm-t tr.dm-click { cursor:pointer; }
#dm .dm-t tr.dm-click:hover td { background:var(--panel2); }
#dm .dm-tscroll { overflow-x:auto; }
#dm .dm-prog { height:7px; background:var(--line2); border-radius:999px; overflow:hidden; min-width:60px; }
#dm .dm-prog i { display:block; height:100%; background:var(--teal); }
#dm .dm-none { color:var(--muted); font-size:13px; padding:10px 2px; }
/* issues */
#dm .dm-iss { border:1px solid var(--line); border-radius:8px; margin:0 0 8px; background:var(--panel); }
#dm .dm-iss summary { display:grid; grid-template-columns:minmax(0,1fr) auto auto auto; gap:12px; align-items:center; padding:10px 12px; cursor:pointer; list-style:none; }
#dm .dm-iss summary::-webkit-details-marker { display:none; }
#dm .dm-iss summary b { font-family:'IBM Plex Mono',ui-monospace,Consolas,monospace; font-size:13px; }
#dm .dm-iss summary small { display:block; color:var(--muted); font-size:11.5px; }
#dm .dm-iss[open] summary { border-bottom:1px solid var(--line2); }
#dm .dm-iss .dm-t { margin:0; }
#dm .dm-ibar { width:140px; height:7px; background:var(--line2); border-radius:999px; overflow:hidden; }
#dm .dm-ibar i { display:block; height:100%; background:var(--blue); }
@@media (max-width:1100px) { #dm .dm-c2 { grid-template-columns:1fr; } #dm .dm-flow { grid-template-columns:repeat(2,minmax(0,1fr)); } }
@@media (max-width:900px) {
  #dm .dm-shell { grid-template-columns:1fr; }
  #dm .dm-rail { position:static; height:auto; flex-direction:row; flex-wrap:wrap; align-items:center; }
  #dm .dm-rbrand { border:0; margin:0; padding:4px 10px; }
  #dm .dm-rlinks { flex-direction:row; flex-wrap:wrap; }
  #dm .dm-rfoot { margin:0; }
  #dm .dm-topbar { position:static; }
  #dm .dm-iss summary { grid-template-columns:minmax(0,1fr) auto; }
  #dm .dm-ibar { display:none; }
}
@@media (prefers-reduced-motion: reduce) { #dm * { scroll-behavior:auto !important; transition:none !important; } }
@@media print { #dm .dm-rail, #dm .dm-topbar .dm-page-buttons, #dm [data-views="home"], #dm [data-views="issues"], #dm [data-views="outcomes"] { display:none !important; } #dm .dm-shell { display:block; } }

/* ===== Division UI 3.1 ===== */
#dm .dm-dialog-head { padding:20px 28px; }
#dm .dm-detail-tabs { padding:10px 28px 0; gap:2px 6px; }
#dm .dm-detail-tabs .dm-tab { padding:8px 12px; }
#dm .dm-dialog-body { padding:22px 28px 26px; }
#dm .dm-cause { display:block; margin-top:4px; font-family:'IBM Plex Mono',ui-monospace,Consolas,monospace; font-size:11.5px; color:var(--muted); letter-spacing:.01em; }
#dm .dm-recommend .dm-cause { font-size:12.5px; color:var(--ink); }
#dm .dm-ai-answer:has(> .dm-aa) { background:none; border:0; padding:0; box-shadow:none; white-space:normal; }
#dm .dm-aa { border:1px solid var(--line); border-radius:12px; padding:16px 18px; background:#fff; margin-top:6px; }
#dm .dm-aa-k { font-size:12px; font-weight:700; letter-spacing:.08em; color:var(--muted); text-transform:uppercase; margin:0 0 12px; }
#dm .dm-aa-head { display:flex; align-items:center; gap:16px; }
#dm .dm-aa-ring { width:64px; height:64px; flex:none; }
#dm .dm-aa-ring circle { fill:none; stroke-width:7; stroke-linecap:round; }
#dm .dm-aa-ring circle.bg { stroke:#E6EAF0; }
#dm .dm-aa-ring text { font:600 18px 'IBM Plex Sans',system-ui,sans-serif; fill:var(--ink); }
#dm .dm-aa-verdict { font-size:19px; font-weight:600; line-height:1.25; }
#dm .dm-aa-sub { color:var(--muted); font-size:13.5px; margin-top:3px; line-height:1.45; }
#dm .dm-aa-meta { color:var(--muted); font-size:12px; margin-top:4px; }
#dm .dm-aa-list { list-style:none; margin:16px 0 0; padding:0; display:flex; flex-direction:column; gap:12px; }
#dm .dm-aa-list > li { display:grid; grid-template-columns:12px minmax(0,1fr); gap:10px; font-size:14px; line-height:1.55; }
#dm .dm-aa-list > li b { display:block; font-size:12px; color:var(--muted); font-weight:600; text-transform:uppercase; letter-spacing:.04em; margin-bottom:1px; }
#dm .dm-aa-list > li p { margin:0; white-space:pre-line; }
#dm .dm-aa-dot { width:9px; height:9px; border-radius:50%; margin-top:6px; display:block; }
#dm .dm-aa-steps { margin:2px 0 0; padding-left:18px; }
#dm .aa-t-red { color:#B42318; } #dm .aa-t-amber { color:#B26B00; } #dm .aa-t-green { color:#0E6B58; } #dm .aa-t-gray { color:#5B6474; } #dm .aa-t-blue { color:#1D4FC4; }
#dm .aa-s-red { stroke:#D5492C; } #dm .aa-s-amber { stroke:#E3A21A; } #dm .aa-s-green { stroke:#2E9E6B; } #dm .aa-s-gray { stroke:#9AA3B2; } #dm .aa-s-blue { stroke:#1D4FC4; }
#dm .aa-d-red { background:#D5492C; } #dm .aa-d-amber { background:#E3A21A; } #dm .aa-d-green { background:#2E9E6B; } #dm .aa-d-gray { background:#9AA3B2; } #dm .aa-d-blue { background:#5B86E5; }
