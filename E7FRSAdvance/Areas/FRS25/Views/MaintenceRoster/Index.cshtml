    function rosDivLoadAll(sites){ var dv=rosState.divisionId, dt=encodeURIComponent(rosState.date);
        var jobs=sites.map(function(x){ return rosGet(ROS.sheet+'?divisionId='+dv+'&siteId='+x.sid+'&rosterDate='+dt)
            .then(function(j){ return { sid:x.sid, name:(x.name||rosF(j,['StationName','stationName'],'Site '+x.sid)), items:(rosF(j,['Items','items'],[])||[]) }; })
            .catch(function(ex){ rosErr('DIV-SITE','site='+x.sid+' dropped from the division read: '+((ex&&ex.message)||ex)); return { sid:x.sid, name:x.name, items:[] }; }); });
        Promise.all(jobs).then(function(results){ rosDivData=[];
            results.forEach(function(r){ r.items.forEach(function(it){ var e=rosEvi(it);
                rosDivData.push({ it:it, e:e, fam:rosFamily(it,e), siteName:r.name, siteId:r.sid }); }); });
            rosDivData.sort(function(p,q){ return q.e.total-p.e.total
                || rosPriRankV(rosPriEff(p))-rosPriRankV(rosPriEff(q)); });
            rosDivRenderList(); rosDivRead(); })
            .catch(function(ex){ rosErr('DIV-ALL','div='+dv+' '+((ex&&ex.message)||ex)); var el=document.getElementById('rosDivList'); if(el){ el.innerHTML='<div class="rhook" style="padding:14px 2px">Could not load the sites. Please retry.</div>'; } }); }
    function rosDivSev(grp){ var u=0,s2=0; for(var i=0;i<grp.assets.length;i++){ var p=String(rosF(grp.assets[i].it,['Priority','priority'],'MONITOR')).toUpperCase(); if(p==='URGENT'){u++;} else if(p==='SOON'){s2++;} } return u*100+s2*10+grp.assets.length; }
