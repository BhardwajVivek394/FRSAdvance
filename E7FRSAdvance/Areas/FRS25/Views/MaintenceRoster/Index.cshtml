        }).catch(function(ex){ rosErr('PMPREDICT','asset='+aid+' '+((ex&&ex.message)||ex)); rosPmBusy[aid]=false; rosPmCache[aid]={err:(ex&&ex.message)||'fetch failed'}; rosPmMaybeRerender(aid); }); }
