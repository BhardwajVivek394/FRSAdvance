<script>window.DM_VIEW_VERSION='2.11.2.3';try{console.info('%c[ROSTER-UI] Maintenance Roster view 2.11.2.3 (Division UI 3.2.2 - item mode) loaded '+new Date().toLocaleString(),'background:#0E6B58;color:#fff;padding:2px 6px;border-radius:3px;font-weight:bold');}catch(e){}</script>
<script>
var DM_TODAY = '@maintenanceToday';
var DM_START_WORKSHEET = @openWorksheetOnLoad;
var DM_API = {
    rollup: '@Url.Action("GetRollup", "MaintenceRoster", new { area = "FRS25" })',
    sites: '@Url.Action("GetRosterSites", "MaintenceRoster", new { area = "FRS25" })',
    assets: '@Url.Action("GetAssestBy", "MaintenceRoster", new { area = "FRS25" })',
    sheet: '@Url.Action("GetWorksheet", "MaintenceRoster", new { area = "FRS25" })',
    rangeHist: '@Url.Action("RangeHistory", "MaintenceRoster", new { area = "FRS25" })',
    pmOps: '@Url.Action("PmOps", "MaintenceRoster", new { area = "FRS25" })',
    trackShort: '@Url.Action("TrackShort", "MaintenceRoster", new { area = "FRS25" })',
    regen: '@Url.Action("Regenerate", "MaintenceRoster", new { area = "FRS25" })',
    classic: '@Url.Action("Worksheet", "MaintenceRoster", new { area = "FRS25" })',
    live: '@Url.Action("Live", "MaintenceRoster", new { area = "FRS25" })',
    pm: '@Url.Action("PmPredict", "MaintenceRoster", new { area = "FRS25" })',
    trend: '@Url.Action("PmTrend", "MaintenceRoster", new { area = "FRS25" })',
    day: '@Url.Action("DayAlerts", "MaintenceRoster", new { area = "FRS25" })',
    ack: '@Url.Action("AckSummary", "MaintenceRoster", new { area = "FRS25" })',
    close: '@Url.Action("CloseItem", "MaintenceRoster", new { area = "FRS25" })',
    closeAsset: '@Url.Action("CloseAsset", "MaintenceRoster", new { area = "FRS25" })',
    visits: '@Url.Action("GetMaintenanceState", "MaintenceRoster", new { area = "FRS25" })',
    clientLog: '@Url.Action("ClientLog", "MaintenceRoster", new { area = "FRS25" })',
    alertEvidence: '@Url.Action("AiAlertEvidence", "MaintenceRoster", new { area = "FRS25" })'
};
DM_API.ai = '@Url.Action("AnalyzeChat", "AiChat", new { area = "FRS25" })';
var DM_AI_ENGINE = 'quantum11';
/* Unique-asset roster model. Source counts overlap; attendance and repair completion differ. */
(function (root) {
    'use strict';
    function field(o, keys, fallback) { for (var i = 0; o && i < keys.length; i++) { if (o[keys[i]] !== undefined && o[keys[i]] !== null) { return o[keys[i]]; } } return fallback; }
    function number(v) { if (v === null || v === undefined || typeof v === 'boolean' || String(v).trim() === '') { return null; } var n = Number(v); return Number.isFinite(n) ? n : null; }
    function yes(v) { return v === true || v === 1 || v === '1' || String(v).toLowerCase() === 'true'; }
    function upper(v) { return String(v || '').trim().toUpperCase(); }
    function band(v) { var b = upper(v); return b === 'URGENT' ? 3 : b === 'SOON' || b === 'MAINTAIN-SOON' ? 2 : 0; }
    function evidence(item) { var e = field(item, ['Evidence15d', 'evidence15d'], null); if (typeof e === 'string') { try { e = JSON.parse(e); } catch (_) { return null; } } return e && typeof e === 'object' && !Array.isArray(e) ? e : null; }
    function typeId(item) { var id = number(field(item, ['AssetTypeId', 'assetTypeId'], null)); if (id) { return id; } var name = upper(field(item, ['AssetFamily', 'assetFamily', 'AssetTypeName', 'assetTypeName', 'AssetTypeTitle', 'TypeName'], '')); return /TRACK/.test(name) ? 1 : /POINT|^PM$/.test(name) ? 3 : /SIGNAL/.test(name) ? 2 : /IPS/.test(name) ? 34 : 0; }
    function family(item) { return {1:'Track',2:'Signal',3:'Point',34:'IPS'}[typeId(item)] || 'Other'; }
    function eligible(item) { return [1,2,3,34].indexOf(typeId(item)) >= 0; }
    function open(item) { return ['', 'OPEN'].indexOf(upper(field(item, ['CloseStatus', 'closeStatus'], 'OPEN'))) >= 0; }
    function validSignal(kind, data) {
        if (!data || typeof data !== 'object' || field(data, ['error', 'Error'], '') || field(data, ['IsSuccess', 'isSuccess'], true) === false) { return false; }
        if (kind === 'drift') { var attrs = field(data, ['attrs', 'Attrs'], []); return Array.isArray(attrs) && attrs.some(function (a) { return !field(a, ['skipped', 'Skipped'], '') && number(field(a, ['n', 'N'], null)) >= 2; }) && number(field(data, ['drift', 'Drift'], null)) !== null; }
        if (kind === 'pm') { return number(field(data, ['ops', 'Ops'], null)) > 0 || band(field(data, ['band', 'Band'], '')) > 0; }
        return !!field(data, ['overall', 'Overall', 'severity', 'Severity'], '') || band(field(data, ['band', 'Band'], '')) > 0;
    }
    // Generator snapshots arrive as {valid,data,error} (sourceSchema 2) or as one flat record (earlier schema). Bind both.
    function savedSource(s) { if (!s || typeof s !== 'object' || (s.data && typeof s.data === 'object')) { return s; } var bad = s.valid === false || !!field(s, ['error', 'Error'], ''); return { valid: !bad, data: bad ? null : s, error: bad ? field(s, ['error', 'Error'], 'Source unavailable') : '' }; }
    function savedSignals(row) { var result = {}; (row.items || []).forEach(function (it) { var ev = evidence(it), sources = ev && ev.sources; if (sources) { Object.keys(sources).forEach(function (key) { result[key] = savedSource(sources[key]); }); } }); return result; }
    function combinedSignals(row) { var result = savedSignals(row); Object.keys(row.signals || {}).forEach(function (key) { result[key] = row.signals[key]; }); return result; }
    function classify(row) {
        var items = row.items || [], sources = [], priority = 0, alerts = 0, alertKnown = !!row.sheetKnown, active = false, bands = {drift:0,pm:0,track:0}, storedKeys = {}, failed = false;
        function add(key, label) { if (!sources.some(function (s) { return s.key === key; })) { sources.push({key:key,text:label}); } }
        items.forEach(function (it) {
            var e = evidence(it), count = e ? number(field(e, ['total','Total'], null)) : null;
            if (!yes(field(it, ['IsSwept','isSwept'], false))) { if (count === null) { alertKnown = false; } if (count > 0) { alerts += count; } if (count > 0 || !e) { add('alert','Alert'); storedKeys.alert = true; } }
            active = active || !!(e && yes(field(e, ['activeNow','ActiveNow'], false)));
            priority = Math.max(priority, band(field(it, ['Priority','priority'], '')));
            failed = failed || yes(field(it, ['IsFailedRepair','isFailedRepair'], false));
            [['drift','DriftBand'],['pm','PmBand'],['track','TrackShortBand']].forEach(function (pair) { var b = band(field(it, [pair[1],pair[1][0].toLowerCase()+pair[1].slice(1)], '')); bands[pair[0]] = Math.max(bands[pair[0]], b); if (b) { storedKeys[pair[0]] = true; } });
        });
        var storedSignals = savedSignals(row);
        var signals = combinedSignals(row), pm = signals.pm, drift = signals.drift, trk = signals.track;
        Object.keys(bands).forEach(function (key) { var s = signals[key]; if (s && s.data && !field(s.data,['error','Error'],'') && (s.valid || band(field(s.data,['band','Band'],'')))) { bands[key] = Math.max(bands[key], band(field(s.data, ['band','Band'], ''))); } });
        if (row.family !== 'Point') { bands.pm = 0; } if (row.family !== 'Track') { bands.track = 0; }
        if (bands.pm) { add('pm','PM prediction'); } if (bands.track) { add('track','Track shorting'); } if (bands.drift) { add('drift','Average drift'); }
        priority = Math.max(priority, bands.pm, bands.track, bands.drift, failed ? 3 : 0);
        var kinds = ['drift'].concat(row.family === 'Point' ? ['pm'] : row.family === 'Track' ? ['track'] : []);
        // Bound to the generator: a complete saved run that holds items for this station has walked every eligible asset there,
        // so a source with no saved snapshot counts as assessed. A snapshot that says invalid still reads as incomplete.
