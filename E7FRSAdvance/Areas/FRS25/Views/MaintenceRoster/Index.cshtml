    // AiChat streams step / tool_use frames while it works and gives its chat loop a 90 s budget. The dialog shows
    // that stage with elapsed seconds, so a long read is visibly alive; 150 s of total silence is a dead request and
    // is ended with a plain message instead of hanging on "Analysing" for ever.
    var AI_STALL_MS = Number(window.DM_AI_STALL_MS) || 150000;
    async function streamAi(context, messages, entry, update, signal, progress) {
        await task(async function () {
            if (signal && signal.aborted) { throw new Error('Cancelled'); }
            var body=JSON.stringify({context:context,verdict:null,engine:DM_AI_ENGINE,messages:messages}),log=beginAiLog(body),failure='';
            var started=Date.now(),label='Waiting for the AI service',stalled=false,guard=new AbortController(),stallTimer=null,reader=null;
            function say() { if (progress) { progress(label+' \u00b7 '+Math.round((Date.now()-started)/1000)+' s'); } }
            // Ending a request aborts the fetch AND cancels the body reader, so a read that is already waiting is released too.
            function kill() { guard.abort(); if (reader) { reader.cancel().catch(function(){}); } }
            function arm() { clearTimeout(stallTimer); stallTimer=setTimeout(function(){stalled=true;kill();},AI_STALL_MS); }
            function relay() { kill(); }
            if (signal) { signal.addEventListener('abort',relay); }
            var ticker=setInterval(say,1000); arm(); say();
            try {
                var response=await fetch(DM_API.ai,{method:'POST',credentials:'same-origin',signal:guard.signal,headers:{'Content-Type':'application/json'},body:body});
                if (!response.ok || response.redirected) { throw new Error('AI HTTP '+response.status); }
                var type=response.headers && response.headers.get('content-type') || '';
                if (/application\/json/i.test(type)) { var j=await response.json();if(j.error || j.IsSuccess===false){throw new Error('AI response failed');}entry.text=F(j,['answer','text','Answer','Text'],'');if(!entry.text && (j.verdict || j.Verdict || j.reason || j.Reason)){entry.text=JSON.stringify(j);}if(typeof entry.text!=='string' || !entry.text.trim()){throw new Error('Empty AI response');}update();return; }
                if (!response.body) { throw new Error('Stream unavailable'); }
                reader=response.body.getReader();
                var decoder=new TextDecoder('utf-8'),parser=DmStream(function(chunk){entry.text+=chunk;label='AI is answering';update();},function(ev){
                    if(ev.type==='tool_use' && ev.name){label='AI is reading '+String(ev.name).split(' \u00b7 ')[0];}
                    else if(ev.type==='step' && ev.phase==='model_start'){label='AI is reasoning \u00b7 step '+((Number(ev.iter) || 0)+1);}
                    say();
                });
