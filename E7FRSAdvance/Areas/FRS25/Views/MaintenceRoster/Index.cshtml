    }
    function aaCardHtml(a, row) {
        var v = String(a.verdict || '').trim(), m = /^(.*?)\s+(?:\u2014|\u2013|-|:)\s+(.*)$/.exec(v);
        var word = (m ? m[1] : v).replace(/[.;,]+$/, '').trim(), sub = m ? m[2].trim() : '';
        var tone = aaTone(word), conf = a.confidence, pct = conf === null ? 0 : Math.max(0, Math.min(100, conf));
        var circ = 2 * Math.PI * 26, dash = (circ * pct / 100).toFixed(1) + ' ' + circ.toFixed(1);
        var ring = '<svg class="dm-aa-ring" viewBox="0 0 64 64" role="img" aria-label="Model confidence ' + (conf === null ? 'unknown' : fmt(conf, 0) + '%') + '"><circle class="bg" cx="32" cy="32" r="26"/><circle class="fg aa-s-' + tone + '" cx="32" cy="32" r="26" stroke-dasharray="' + dash + '" transform="rotate(-90 32 32)"/><text x="32" y="33" text-anchor="middle" dominant-baseline="middle">' + (conf === null ? '?' : fmt(conf, 0)) + '</text></svg>';
        var cz = row ? vCauses(row) : [];
        function item(dot, title, body) {
            if (!body || (Array.isArray(body) && !body.length)) { return ''; }
            var inner = Array.isArray(body) ? '<ol class="dm-aa-steps">' + body.map(function (x) { return '<li>' + esc(typeof x === 'object' ? JSON.stringify(x) : x) + '</li>'; }).join('') + '</ol>' : '<p>' + esc(body) + '</p>';
            return '<li><i class="dm-aa-dot aa-d-' + dot + '"></i><div><b>' + title + '</b>' + inner + '</div></li>';
        }
        return '<section class="dm-aa" aria-label="AI analysis">'
            + '<p class="dm-aa-k">Analysis</p>'
            + '<div class="dm-aa-head">' + ring + '<div><div class="dm-aa-verdict aa-t-' + tone + '">' + esc(word || 'No verdict') + '</div>'
            + (sub ? '<div class="dm-aa-sub">' + esc(sub) + '</div>' : '')
            + '<div class="dm-aa-meta">Model confidence ' + (conf === null ? 'unknown' : fmt(conf, 0) + '%') + (cz.length ? ' \u00b7 Cause code ' + esc(cz.join(', ')) : '') + '</div></div></div>'
            + '<ul class="dm-aa-list">'
            + item('blue', 'What happened', a.what)
            + item('amber', 'Likely cause', a.why)
            + item('gray', 'Rule out first', a.ruleOut)
            + item(tone === 'gray' ? 'blue' : tone, 'First action', a.action)
            + item('red', 'If ignored', a.consequences)
            + '</ul></section>';
    }
    // ===== Division UI 3.0 (2.10.0.0): reference-layout views. Read-only over S.rows + assessed(); no new requests. =====
    var V = { view: 'home', hm: 'priority' };
    var VIEW_TEXT = {
        home: ['Command centre', 'Every asset that needs work across the division, and where its work stands'],
        stations: ['Stations', 'Pick a station; its assets and work fill the page'],
        issues: ['Issues', 'One kind of problem across all stations, so the same fix can be planned once'],
        roster: ['Asset roster', 'Every asset on the saved roster run, with its evidence and visit status'],
        outcomes: ['Outcomes', 'What each visit found, recorded against this roster run']
    };
    var FAM_ORDER = ['Point', 'Track', 'Signal', 'IPS'];
    var FAM_NAME = { Point: 'Point machines', Track: 'Track circuits', Signal: 'Signals', IPS: 'IPS', Other: 'Other' };
    var OUTCOME_NAME = { CONFIRMED_DEFECT: 'Defect confirmed', NO_DEFECT_FOUND: 'No defect found', WORK_DONE: 'Work done' };
    function vRows() { return S.rows.map(function (r) { return { row: r, a: assessed(r) }; }); }
    function vLevel(a) { if (!a.maintenance) { return 'n'; } if (a.attended) { return 'ok'; } return a.priority === 3 ? 'u' : a.priority === 2 ? 's' : 'm'; }
    function vState(a) { if (!a.maintenance) { return 'n'; } if (!a.statusKnown) { return 'q'; } if (a.attended) { return a.outcome ? 'c' : 'a'; } return 'p'; }
    function vPrioText(a) { return a.priority === 3 ? 'Urgent' : a.priority === 2 ? 'Soon' : a.maintenance ? 'Monitor' : '\u2014'; }
    function vPill(a) { return '<span class="dm-pill ' + (a.priority === 3 ? 'urgent' : a.priority === 2 ? 'soon' : '') + '">' + vPrioText(a) + '</span>'; }
    function vRank(x) { var a = x.a; return (a.maintenance ? 100 : 0) + (a.attended ? 0 : 50) + a.priority * 10 + (a.active ? 5 : 0); }
    function vTip(x) { var a = x.a, r = x.row, cz = vCauses(r); return r.name + ' \u00b7 ' + r.station + ' \u00b7 ' + (FAM_NAME[r.family] || r.family) + ' \u00b7 ' + (a.maintenance ? vPrioText(a) + (a.attended ? ', attended' : a.statusKnown ? ', pending visit' : ', visit status unknown') : 'no maintenance needed') + (cz.length ? ' \u00b7 cause ' + cz.join(', ') : ''); }
    function vCauses(r) {
        var out = [];
        (r.items || []).forEach(function (it) { var e = C.evidence(it), c = String((e ? F(e, ['dominantCause', 'DominantCause'], '') : '') || F(it, ['CauseCode', 'causeCode', 'DominantCause'], '') || '').trim().toUpperCase(); if (c && out.indexOf(c) < 0) { out.push(c); } });
        return out;
    }
    function vStations(rows) {
        var map = {}, list = [];
        rows.forEach(function (x) { var k = String(x.row.siteId); if (!map[k]) { map[k] = { id: x.row.siteId, name: x.row.station, all: [], m: 0, u: 0, s: 0, p: 0, att: 0 }; list.push(map[k]); } var st = map[k], a = x.a; st.all.push(x); if (a.maintenance) { st.m++; if (a.priority === 3) { st.u++; } else if (a.priority === 2) { st.s++; } if (a.attended) { st.att++; } else if (a.statusKnown) { st.p++; } } });
        return list.sort(function (p, q) { return q.u - p.u || q.m - p.m || String(p.name).localeCompare(String(q.name)); });
    }
    function vEmpty(msg) { return '<p class="dm-none">' + esc(msg) + '</p>'; }
    function setView(v, keepScroll) {
        if (!VIEW_TEXT[v]) { v = 'home'; }
        V.view = v; $('dm').setAttribute('data-view', v);
        var links = $('dm').querySelectorAll('[data-view-go]');
        for (var i = 0; i < links.length; i++) { if (links[i].getAttribute('data-view-go') === v) { links[i].setAttribute('aria-current', 'page'); } else { links[i].removeAttribute('aria-current'); } }
        text('dmViewTitle', VIEW_TEXT[v][0]); text('dmViewSub', VIEW_TEXT[v][1]);
        try { if (window.history && history.replaceState) { history.replaceState(null, '', '#' + v); } } catch (_) { }
        renderViews();
        if (!keepScroll) { try { $('dm').scrollIntoView({ block: 'start' }); } catch (_) { } }
    }
    function vBadge(id, n) { var el = $(id); if (!el) { return; } if (n > 0) { el.textContent = n; el.hidden = false; } else { el.hidden = true; } }
    function renderLifecycle(t) {
        var outcomes = t.confirmed + t.nothing + t.done, max = Math.max(1, t.maintenance);
        var st = [['Needs maintenance', t.maintenance, '#5B86E5', 'on this roster run'], ['Pending visit', t.pending, '#F1AE52', 'not yet acknowledged'], ['Status unknown', t.unknownAttendance, '#B8C0CF', 'visit state not returned'], ['Attended', t.attended, '#4FB6A0', 'visit acknowledged'], ['Outcome recorded', outcomes, '#1E7A4F', t.confirmed + ' defect \u00b7 ' + t.nothing + ' none \u00b7 ' + t.done + ' work done']];
        $('dmLifecycle').innerHTML = st.map(function (s) { return '<div><span>' + esc(s[0]) + '</span><b>' + (S.loaded ? s[1] : '\u2014') + '</b><i><u style="width:' + (S.loaded ? Math.round(100 * s[1] / max) : 0) + '%;background:' + s[2] + '"></u></i><small>' + esc(s[3]) + '</small></div>'; }).join('');
    }
    function renderHeatmap(rows) {
        var byPrio = V.hm === 'priority';
        $('dmHmLegend').innerHTML = byPrio
            ? '<span><i class="dm-h-u"></i>Urgent</span><span><i class="dm-h-s"></i>Soon</span><span><i class="dm-h-m"></i>Monitor</span><span><i class="dm-h-ok"></i>Attended</span><span><i class="dm-h-n"></i>No maintenance</span>'
            : '<span><i class="dm-h-p"></i>Pending visit</span><span><i class="dm-h-q"></i>Status unknown</span><span><i class="dm-h-a"></i>Attended</span><span><i class="dm-h-c"></i>Outcome recorded</span><span><i class="dm-h-n"></i>No maintenance</span>';
        if (!rows.length) { $('dmHeatmap').innerHTML = vEmpty(S.loaded ? 'No assets on this roster run.' : 'Load a division to see its assets.'); return; }
        var fams = FAM_ORDER.filter(function (f) { return rows.some(function (x) { return x.row.family === f; }); });
        if (rows.some(function (x) { return FAM_ORDER.indexOf(x.row.family) < 0; })) { fams.push('Other'); }
        var cols = 'minmax(90px,max-content) ' + fams.map(function () { return 'max-content'; }).join(' ') + ' minmax(56px,1fr)';
        var g = '<div class="dm-hmg" style="grid-template-columns:' + cols + '"><span></span>' + fams.map(function (f) { return '<span class="dm-hmh">' + esc(FAM_NAME[f] || f) + '</span>'; }).join('') + '<span class="dm-hmh">Urgent</span>';
        vStations(rows).forEach(function (st) {
            g += '<button type="button" class="dm-hm-st" data-st-go="' + esc(st.id) + '" title="' + esc(st.name) + '">' + esc(st.name) + '</button>';
            fams.forEach(function (f) {
                var cell = st.all.filter(function (x) { return f === 'Other' ? FAM_ORDER.indexOf(x.row.family) < 0 : x.row.family === f; }).sort(function (p, q) { return vRank(q) - vRank(p); });
                g += '<div class="dm-hm-fam">' + cell.map(function (x) { var c = byPrio ? vLevel(x.a) : vState(x.a), t = vTip(x); return '<button type="button" class="dm-hc dm-h-' + c + '" data-v-asset="' + esc(x.row.key) + '" title="' + esc(t) + '" aria-label="' + esc(t) + '"></button>'; }).join('') + '</div>';
            });
            g += '<span class="dm-hm-tot">' + (st.u || '') + '</span>';
        });
        $('dmHeatmap').innerHTML = g + '</div>';
    }
    function renderQueue(rows) {
        var q = rows.filter(function (x) { return x.a.maintenance && !x.a.attended; }).sort(function (p, q2) { return vRank(q2) - vRank(p) || String(p.row.station).localeCompare(String(q2.row.station)); }).slice(0, 10);
        if (!q.length) { $('dmQueue').innerHTML = vEmpty(S.loaded ? 'No asset is waiting for a visit.' : 'Load a division to see its queue.'); return; }
        $('dmQueue').innerHTML = '<div class="dm-tscroll"><table class="dm-t"><thead><tr><th>#</th><th>Station</th><th>Asset</th><th>Why</th><th>Priority</th></tr></thead><tbody>' + q.map(function (x, i) {
            var a = x.a, r = x.row;
            return '<tr class="dm-click" data-v-asset="' + esc(r.key) + '" tabindex="0"><td>' + (i + 1) + '</td><td class="dm-mono">' + esc(r.station) + '</td><td><b>' + esc(r.name) + '</b><small>' + esc(FAM_NAME[r.family] || r.family) + '</small></td><td>' + (a.sources.length ? a.sources.map(function (f) { return '<span class="dm-source source-' + f.key + '">' + esc(f.text) + '</span>'; }).join(' ') : esc(a.reason)) + causeHtml(r) + (a.active ? '<small>Active alert at roster generation</small>' : '') + '</td><td>' + vPill(a) + '</td></tr>';
        }).join('') + '</tbody></table></div>';
    }
    function renderStationTable(rows) {
        var st = vStations(rows);
        if (!st.length) { $('dmStationTable').innerHTML = vEmpty(S.loaded ? 'No stations on this roster run.' : 'Load a division to see its stations.'); return; }
        $('dmStationTable').innerHTML = '<div class="dm-tscroll"><table class="dm-t"><thead><tr><th>Station</th><th>Urgent</th><th>Soon</th><th>Pending</th><th>Attended</th><th>Progress</th></tr></thead><tbody>' + st.map(function (s) {
            var p = s.m ? Math.round(100 * s.att / s.m) : 0;
            return '<tr class="dm-click" data-st-go="' + esc(s.id) + '" tabindex="0"><td><b class="dm-mono">' + esc(s.name) + '</b><small>' + s.all.length + ' assets</small></td><td><span class="dm-pill urgent">' + s.u + '</span></td><td><span class="dm-pill soon">' + s.s + '</span></td><td>' + s.p + '</td><td>' + s.att + '/' + s.m + '</td><td><div class="dm-prog" title="' + p + '% attended"><i style="width:' + p + '%"></i></div></td></tr>';
        }).join('') + '</tbody></table></div>';
    }
    function renderIssues(rows) {
        var groups = {}, list = [];
        rows.forEach(function (x) {
            if (!x.a.maintenance) { return; }
            var keys = vCauses(x.row);
            if (!keys.length) { keys = x.a.sources.length ? x.a.sources.map(function (f) { return f.text; }) : ['Other reason']; }
            keys.forEach(function (k) { if (!groups[k]) { groups[k] = { cause: k, items: [], st: {}, u: 0 }; list.push(groups[k]); } var g = groups[k]; g.items.push(x); g.st[x.row.station] = true; if (x.a.priority === 3 && !x.a.attended) { g.u++; } });
        });
        list.sort(function (p, q) { return q.u - p.u || q.items.length - p.items.length || p.cause.localeCompare(q.cause); });
        vBadge('dmRailIssues', list.length);
        if (!list.length) { $('dmIssues').innerHTML = vEmpty(S.loaded ? 'No maintenance assets on this roster run.' : 'Load a division to see its problems.'); return; }
        var max = Math.max.apply(null, list.map(function (g) { return g.items.length; }));
        $('dmIssues').innerHTML = list.map(function (g) {
            var stations = Object.keys(g.st).sort(), pend = g.items.filter(function (x) { return !x.a.attended; }).length;
            return '<details class="dm-iss"><summary><span><b>' + esc(g.cause) + '</b><small>' + stations.length + (stations.length === 1 ? ' station: ' : ' stations: ') + esc(stations.slice(0, 6).join(', ')) + (stations.length > 6 ? ', \u2026' : '') + '</small></span><span class="dm-ibar"><i style="width:' + Math.round(100 * g.items.length / max) + '%"></i></span><span>' + g.items.length + (g.items.length === 1 ? ' asset' : ' assets') + ' \u00b7 ' + pend + ' pending</span>' + (g.u ? '<span class="dm-pill urgent">' + g.u + ' urgent</span>' : '<span></span>') + '</summary>'
                + '<div class="dm-tscroll"><table class="dm-t"><thead><tr><th>Station</th><th>Asset</th><th>Priority</th><th>Status</th></tr></thead><tbody>' + g.items.sort(function (p, q) { return vRank(q) - vRank(p); }).map(function (x) {
                    return '<tr class="dm-click" data-v-asset="' + esc(x.row.key) + '" tabindex="0"><td class="dm-mono">' + esc(x.row.station) + '</td><td><b>' + esc(x.row.name) + '</b><small>' + esc(FAM_NAME[x.row.family] || x.row.family) + '</small></td><td>' + vPill(x.a) + '</td><td><span class="dm-status ' + (x.a.attended ? 'attended' : '') + '">' + esc(x.a.status) + '</span></td></tr>';
                }).join('') + '</tbody></table></div></details>';
        }).join('');
    }
    function renderOutcomeList(rows) {
        var done = rows.filter(function (x) { return x.a.maintenance && x.a.attended; }).sort(function (p, q) { return String(p.row.station).localeCompare(String(q.row.station)) || String(p.row.name).localeCompare(String(q.row.name)); });
        if (!done.length) { $('dmOutcomeList').innerHTML = vEmpty(S.loaded ? 'No visit has been recorded on this roster run yet.' : 'Load a division to see its outcomes.'); return; }
        $('dmOutcomeList').innerHTML = '<div class="dm-tscroll"><table class="dm-t"><thead><tr><th>Station</th><th>Asset</th><th>Outcome</th><th>Priority at roster</th><th>Status</th></tr></thead><tbody>' + done.map(function (x) {
            return '<tr class="dm-click" data-v-asset="' + esc(x.row.key) + '" tabindex="0"><td class="dm-mono">' + esc(x.row.station) + '</td><td><b>' + esc(x.row.name) + '</b><small>' + esc(FAM_NAME[x.row.family] || x.row.family) + '</small></td><td>' + esc(OUTCOME_NAME[x.a.outcome] || 'Attended, no outcome') + '</td><td>' + vPill(x.a) + '</td><td><span class="dm-status attended">' + esc(x.a.status) + '</span></td></tr>';
        }).join('') + '</tbody></table></div>';
    }
    function renderViews() {
        var rows = vRows(), t = C.summarize(rows.map(function (x) { return x.row; })), opt = $('dmDivision').selectedOptions && $('dmDivision').selectedOptions[0];
        text('dmRailDiv', S.loaded && opt && opt.value ? 'S&T \u00b7 ' + opt.textContent : 'Select a division');
        var live = $('dmLiveChip'); if (S.loaded) { live.classList.add('on'); text('dmLiveText', 'Roster ' + S.date + (S.runComplete ? '' : ' \u00b7 partial read')); } else { live.classList.remove('on'); text('dmLiveText', S.busy ? 'Loading roster\u2026' : 'No roster loaded'); }
        vBadge('dmRailUrgent', S.loaded ? t.urgent : 0); vBadge('dmRailStations', S.loaded ? vStations(rows).length : 0); vBadge('dmRailRoster', S.loaded ? t.maintenance : 0); vBadge('dmRailOutcomes', S.loaded ? t.confirmed + t.nothing + t.done : 0);
        if (V.view === 'home') { renderLifecycle(t); renderHeatmap(rows); renderQueue(rows); renderStationTable(rows); }
        if (V.view === 'issues' || !S.loaded) { renderIssues(rows); }
        if (V.view === 'outcomes') { renderOutcomeList(rows); }
    }
    var baseRender = render;
    render = function () { baseRender.apply(this, arguments); try { renderViews(); } catch (err) { if (window.console) { console.error('DIVISION-VIEWS', err); } } };
    $('dm').addEventListener('click', function (e) {
        var t = e.target.closest ? e.target : null; if (!t) { return; }
        var go = t.closest('[data-view-go]'); if (go) { e.preventDefault(); setView(go.getAttribute('data-view-go')); return; }
        var as = t.closest('[data-v-asset]'); if (as) { e.preventDefault(); openDetail(as.getAttribute('data-v-asset'), as); return; }
        var st = t.closest('[data-st-go]'); if (st) { e.preventDefault(); $('dmStation').value = st.getAttribute('data-st-go'); S.page = 1; setView('stations'); render(); return; }
    });
    // Existing route buttons (KPI cards, chart bars, tabs) show the roster table; switch to it before their own handler scrolls there.
    $('dm').addEventListener('click', function (e) { var r = e.target.closest && e.target.closest('[data-route]'); if (r && V.view !== 'roster' && V.view !== 'stations') { setView('roster', true); } }, true);
    $('dm').addEventListener('keydown', function (e) { if (e.key !== 'Enter' && e.key !== ' ') { return; } var t = e.target; if (t && t.matches && t.matches('tr[data-v-asset], tr[data-st-go]')) { e.preventDefault(); t.click(); } });
    $('dmHmColour').addEventListener('change', function () { V.hm = this.value; renderViews(); });
    $('dmDivision').addEventListener('change', function () { renderViews(); });
    (function () { var h = (location.hash || '').replace('#', ''); setView(VIEW_TEXT[h] ? h : 'home', true); })();
    render();
    // =========================================================================================
    // 2.12.0.0 -- SERVER-SIDE PDF BOOT.  MaintenceRosterPdfController.DownloadRosterPdf renders
    // this page headless with ?pdfMode=1 and waits on window.__rosPdfReady. Neither existed in
    // this view, so GenerateService waited on a signal that was never set -- the download could
    // only ever time out or return a page with no roster on it. This is that contract, implemented.
    //
    // It mirrors the DM_DEMO auto-load below: pick the division, load, then build the print report.
    // Three things matter and are deliberate:
    //   1. route 'all' -- the PDF must carry every asset, not the current filter. preparePrint
    //      already ignores pagination, but it honours the route and the filters.
    //   2. __rosPdfReady is set on FAILURE too, and behind a hard ceiling. A generator blocked on a
    //      signal that never arrives is the bug being fixed; it must not be reintroduced by an
    //      error path. A PDF of an error state is diagnosable, a hung request is not.
    //   3. dm-printing + #dmPrintReport live inside @@media print, which is the media a headless
    //      page.pdf() emulates -- so the same markup serves the button and the download.
    // =========================================================================================
    (function () {
        var q = new URLSearchParams(location.search || '');
        if (q.get('pdfMode') !== '1') { if (!window.DM_DEMO) { loadQueryScope(); } return; }

        var ready = false;
        function signalReady(why) {
            if (ready) { return; }
            ready = true;
            try { console.log('[ROSTER-PDF] ready (' + why + ')'); } catch (_) { }
            window.__rosPdfReady = true;
        }
        var ceiling = setTimeout(function () { signalReady('ceiling reached'); }, 120000);

        var div = N(q.get('divisionId'));
        var date = q.get('rosterDate');
        if (date) { $('dmDate').value = date; }
        if (!(div > 0)) { clearTimeout(ceiling); signalReady('no divisionId'); return; }
        $('dmDivision').value = String(div);
        if ($('dmDivision').value !== String(div)) { clearTimeout(ceiling); signalReady('division ' + div + ' not in the list'); return; }

        load().then(function () {
            setRoute('all');
            setView('roster', true);
            S.page = 1;
            render();
            preparePrint();
        }).catch(function (e) {
            try { console.log('[ROSTER-PDF] load failed: ' + (e && e.message)); } catch (_) { }
        }).finally(function () { clearTimeout(ceiling); signalReady('render complete'); });
    })();
    if (window.DM_DEMO) { $('dmDivision').value = '33'; load().then(function () { if (window.DmDemoSeed) { render(); if (!S.problems.length) { message(''); } } }); }
})();

</script>
