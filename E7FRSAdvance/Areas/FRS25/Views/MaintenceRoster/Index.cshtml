        var ask=rosDivFacts()+'Question: '+q+' \u2014 answer in 1\u20134 short plain sentences using ONLY these facts; name the real assets and sites above; no lists, no headings.';
        rosAiTextCall({ scope:'division', date:rosState.date }, ask, [], function(r){ var o2=document.getElementById('rosChat'); if(!o2){ return; }
            var err=rosF(r,['error','Error'],''), ans=rosF(r,['answer','Answer'],'');
