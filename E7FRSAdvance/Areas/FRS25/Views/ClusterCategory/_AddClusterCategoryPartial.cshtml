@model Domain.ClusterCategory

<input type="hidden" id="hdnSaveType" value="@ViewBag.Type" />
<input type="hidden" id="hdnSaveMessage" value="@ViewBag.Message" />

<div class="modal fade ais-modal" id="modal-add-ClusterCategory" tabindex="-1" role="dialog" aria-labelledby="modal-add-ClusterCategory" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            @Html.HiddenFor(m => Model.Id, new { @id = "hdnClusterCategoryId" })
            @Html.HiddenFor(m => Model.ImageBase64, new { @id = "hdnImageBase64" })
            @Html.HiddenFor(m => Model.ImageExtension, new { @id = "hdnImageExtension" })
            <div class="modal-header">
                @if (Model.Id == 0)
                {
                    <h4 class="modal-title" id="myModalLabel"><span id="spHeader">Add Cluster Category</span></h4>
                }
                else
                {
                    <h4 class="modal-title isEdit" id="myModalLabel"><span id="spHeader"> Edit Cluster Category</span></h4>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="AssetTypeId">Asset Type <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.AssetTypeId, (IEnumerable<SelectListItem>)ViewBag.AssetTypes, "Select", new { @class = "form-control", tabindex = 1 })
                            <span class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="ClasificationTypeId">Clasification Type <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.ClasificationTypeId, (IEnumerable<SelectListItem>)ViewBag.ClasificationTypes, "Select", new { @class = "form-control", tabindex = 1 })
                            <span class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-sm-3">
                        <div class="form-group">
                            <label for="Cluster">Cluster <span class="text-danger">*</span></label>
                            <select name="Cluster" id="Cluster" class="form-control">
                                @for (int i = 0; i <= 24; i++)
                                {
                                    if (Model.Cluster == i)
                                    {
                                        <option value="@i" selected>@i</option>
                                    }
                                    else
                                    {
                                        <option value="@i">@i</option>
                                    }
                                }
                            </select>
                            <span class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-sm-3">
                        <div class="form-group">
                            <label for="SubCluster">Sub Cluster <span class="text-danger">*</span></label>
                            <select name="SubCluster" id="SubCluster" class="form-control">
                                @for (int i = 0; i <= 29; i++)
                                {
                                    if (Model.SubCluster == i)
                                    {
                                        <option value="@i" selected>@i</option>
                                    }
                                    else
                                    {
                                        <option value="@i">@i</option>
                                    }
                                }
                            </select>
                            <span class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="StatusId">Status <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.StatusId, (IEnumerable<SelectListItem>)ViewBag.Status, "Select", new { @class = "form-control", tabindex = 1 })
                            <span class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="Remark">Remark <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Remark, new { @class = "form-control", tabindex = 2 })
                            <span class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="Percentage">Percentage <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Percentage, new { @class = "form-control", tabindex = 2, @type = "Number" })
                            <span class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-sm-6" id="divPointMachineType" style="display:none">
                        <div class="form-group">
                            <label for="PointMachineTypeId">PointMachine Type</label>
                            @Html.DropDownListFor(m => m.PointMachineTypeId, (IEnumerable<SelectListItem>)ViewBag.PointMachineTypes, "Select", new { @class = "form-control", tabindex = 1 })
                            <span class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="form-group">
                            <label for="UploadImg">Upload Image</label>
                            <input type="file" id="UploadImg" name="UploadImg" accept="image/*" class="form-control" onchange="fnUploadImageFile(this)">
                        </div>
                    </div>

                    <div class="col-sm-3">
                        <div class="form-group">
                            <label for="IsDivisionPDF">Is Division PDF</label>
                            <div class="ais-check">
                                @Html.CheckBoxFor(m => m.IsDivisionPDF)
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-3">
                        <div class="form-group">
                            <label for="IsUnderObservation">Is Under Observation</label>
                            <div class="ais-check">
                                @Html.CheckBoxFor(m => m.IsUnderObservation)
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-12 ais-thumb" id="divImage">
                        @if (!string.IsNullOrEmpty(Model.ImageBase64))
                        {
                            <img height="100" width="100" src="data:image/png;base64,@Model.ImageBase64" />
                        }
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary ls-1-2" onclick="fnSave()" id="btnSaveClusterCategory">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    function fnUploadImageFile($this) {
        var counter = 0;
        $("#loader, #e7-loader").show();
        var files = $($this).get(0).files;
        var fileData = new FormData();
        for (var i = 0; i < files.length; i++) {
            fileData.append(files[i].name, files[i]);
        }

        $.ajax({
            url: "/FRS25/ClusterCategory/UploadFile",
            type: "POST",
            contentType: false,
            processData: false,
            data: fileData,
            async: true,
            success: function (data) {
                $("#loader, #e7-loader").hide();
                var imageBase64 = '';
                if (data != null && data != undefined && data != '') {
                    imageBase64 += "<input type='hidden' id='hdnBas64_" + counter + "' class='hdnImageBase64' value='" + data.ImageBase64 + "' data-fileextension='" + data.ImageExtension + "' />";
                    imageBase64 += "<img height='100' width='100' id='imgBas64_" + counter + "' src='data:image/png;base64," + data.ImageBase64 + "'/>";

                    $('#hdnImageBase64').val(data.ImageBase64);
                    $('#hdnImageExtension').val(data.ImageExtension);
                }
                $('#divImage').empty().append(imageBase64);
            },
            error: function (xhr, error, status) {
                $("#loader, #e7-loader").hide();
                CommonNotification("ERROR", "Internal server error.", "Error");
            }
        });
    }

    // First rendered inside Index (before the layout loads jQuery), later returned by GetById / Save.
    (function (fn) {
        if (window.jQuery) { jQuery(fn); } else { document.addEventListener('DOMContentLoaded', fn); }
    })(function () {
        if ($('#hdnSaveType').val() == 'Success') {
            CommonNotification($("#hdnSaveType").val().toLowerCase(), $("#hdnSaveMessage").val());

            fnAisClearModalBackdrop();
            $("#frmClusterCategoryList").submit();
            window.history.pushState('', '', '@Url.Action("Index", "ClusterCategory", new { area = "FRS25" })');
        }
        else if ($('#hdnSaveType').val() == 'Error') {
            CommonNotification($("#hdnSaveType").val().toLowerCase(), $("#hdnSaveMessage").val());

            fnAisClearModalBackdrop();
            window.history.pushState('', '', '@Url.Action("Index", "ClusterCategory", new { area = "FRS25" })');
        }

        if ($("#AssetTypeId").val() == '@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()') {
            $('#divPointMachineType').show();
        } else {
            $('#divPointMachineType').hide();
            $('#PointMachineTypeId').val(0);
        }

        $("#AssetTypeId").change(function () {
            if ($(this).val() == '@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()') {
                $('#divPointMachineType').show();
            } else {
                $('#divPointMachineType').hide();
                $('#PointMachineTypeId').val(0);
            }
        });
    });

    function ClusterCategorySaved() {
        $("#loader, #e7-loader").hide();
        $("#modal-add-ClusterCategory").hide();
    }

    function fnSave() {
        if (Validate()) {
            $("#frmSaveClusterCategory").submit();
        }
    }

    function Validate() {
        var result = true;

        if ($.trim($("#Cluster").val()).length == 0) {
            $("#Cluster").next("span").html("Cluster is required");
            result = false;
        }
        else {
            $("#Cluster").next("span").html("");
        }

        if ($.trim($("#SubCluster").val()).length == 0) {
            $("#SubCluster").next("span").html("Sub Cluster is required");
            result = false;
        }
        else {
            $("#SubCluster").next("span").html("");
        }

        if ($.trim($("#Remark").val()).length == 0) {
            $("#Remark").next("span").html("Alias Name is required");
            result = false;
        }
        else {
            $("#Remark").next("span").html("");
        }

        if ($.trim($("#AssetTypeId").val()).length == 0 || $("#AssetTypeId").val() == "0") {
            $("#AssetTypeId").next("span").html("Asset Type is required");
            result = false;
        }
        else {
            $("#AssetTypeId").next("span").html("");
        }

        if ($.trim($("#ClasificationTypeId").val()).length == 0 || $("#ClasificationTypeId").val() == "0") {
            $("#ClasificationTypeId").next("span").html("Clasification Type is required");
            result = false;
        }
        else {
            $("#ClasificationTypeId").next("span").html("");
        }

        if ($.trim($("#StatusId").val()).length == 0 || $("#StatusId").val() == "0") {
            $("#StatusId").next("span").html("Status is required");
            result = false;
        }
        else {
            $("#StatusId").next("span").html("");
        }

        return result;
    }
</script>
