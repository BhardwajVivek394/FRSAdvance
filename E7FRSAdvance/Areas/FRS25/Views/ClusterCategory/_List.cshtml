@model Domain.ClusterCategoryLister

@{
    int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
    if (Model.mClusterCategories == null || Model.mClusterCategories.Count == 0)
    {
        start = 0;
    }
    decimal end = Math.Floor(Model.Pager.TotalRecord);
    if (Model.Pager.PageSize < Model.Pager.TotalRecord)
    {
        if (Model.Pager.PageSize == -1)
        {
            end = Model.Pager.TotalRecord;
        }
        else
        {
            end = Model.Pager.PageSize * Model.Pager.CurrentPage;
            if (end > Model.Pager.TotalRecord)
            {
                end = Model.Pager.TotalRecord;
            }
        }
    }
}

<div class="table-border">
    <div class="ais-section-head">
        <h5>Cluster Categories</h5>
        <div class="d-flex flex-wrap align-items-center gap-10">
            <span class="ais-count">Showing <strong>@start - @Math.Floor(end)</strong> of <strong>@Math.Floor(Model.Pager.TotalRecord)</strong> ClusterCategory</span>
            <div class="ais-pager">
                @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
                @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
                <button type="button" class="btn btn-inactive" title="Previous" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left"></i></button>
                <button type="button" class="btn btn-inactive" title="Next" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>
            </div>
        </div>
    </div>

    <div class="table-responsive" style="max-height: 620px;">
        <table class="table table-hover ais-table">
            <thead class="thead-light2">
                <tr>
                    <th style="width:70px;" colspan="2" class="text-center">Action</th>
                    <th>Name</th>
                    <th>Remark</th>
                    <th>Clasification Type</th>
                    <th>Cluster Status</th>
                    <th>Asset Type</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.mClusterCategories != null && Model.mClusterCategories.Count > 0)
                {
                    foreach (var item in Model.mClusterCategories)
                    {
                        <tr>
                            <td class="ais-action">
                                <a href="javascript:void(0)" title="Edit" onclick="GetById('@item.Id')">
                                    <i class="fa fa-edit"></i>
                                </a>
                            </td>
                            <td class="ais-action">
                                <a href="javascript:void(0)" title="Delete" onclick="Delete('@item.Id')">
                                    <i class="text-danger fa fa-trash"></i>
                                </a>
                            </td>
                            <td>
                                <a href="javascript:void(0)" class="ais-link" title="View Image" onclick="ShowImage('@item.Id')">@item.Name</a>
                            </td>
                            <td>@item.Remark</td>
                            <td>
                                @Enum.GetName(typeof(E7FRSAdvance.Utility.Utility.ClasificationTypes), item.ClasificationTypeId)
                            </td>
                            <td>
                                @Enum.GetName(typeof(E7FRSAdvance.Utility.Utility.ClusterStatus), item.StatusId)
                            </td>
                            <td>@item.AssetType</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="ais-empty">
                            No record found
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    // First rendered inside Index (before the layout loads jQuery), later re-rendered by the Ajax form.
    (function (fn) {
        if (window.jQuery) { jQuery(fn); } else { document.addEventListener('DOMContentLoaded', fn); }
    })(function () {
        // The filter boxes live in Index (outside this partial), so unbind first to avoid stacking a
        // new handler each time the list is re-rendered.
        $(".txtSearchName").off("keyup.ais").on("keyup.ais", function (e) {
            e.preventDefault();
            if (e.keyCode === 13) {
                $("#hdnSkip").val('0');
                $("#frmClusterCategoryList").submit();
            }
        });

        $('#drpPageSize').change(function (e) {
            $("#hdnSkip").val('0');
            $("#frmClusterCategoryList").submit();
        });
    });

    function Delete(id) {
        if (confirm('Are you sure you want to delete this record?')) {
            $("#loader, #e7-loader").show();
            $.ajax({
                url: '/FRS25/ClusterCategory/Delete',
                type: 'Post',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader, #e7-loader").hide();
                    if (data.type == "success") {
                        CommonNotification("success", "Cluster Category has been deleted.");
                        $("#frmClusterCategoryList").submit();
                    } else if (data.type == "error") {
                        CommonNotification("ERROR", "Error occured while deleting cluster category!");
                    } else {
                        CommonNotification("ERROR", "Internal server error.");
                    }
                },
                error: function (response) {
                    $("#loader, #e7-loader").hide();
                    CommonNotification("ERROR", "Internal server error.");
                }
            });
        }
    }

    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (Number('@Model.Pager.TotalPage') != Number('@Model.Pager.CurrentPage')) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmClusterCategoryList").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize) {
                var prevSkip = @Model.Pager.Skip;
                prevSkip = prevSkip - @Model.Pager.PageSize;
                $("#hdnSkip").val(prevSkip);
                $("#frmClusterCategoryList").submit();
            }
        }
    }

    function GetById(id) {
        $("#loader, #e7-loader").show();
        $.ajax({
            url: '/FRS25/ClusterCategory/GetById',
            type: 'Post',
            data: '{id:' + id + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader, #e7-loader").hide();
                $("#divSaveClusterCategory").empty().append(data);
                $("#modal-add-ClusterCategory").modal('show');
            },
            error: function (response) {
                $("#loader, #e7-loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function ShowImage(id) {
        $("#loader, #e7-loader").show();
        $.ajax({
            url: '/FRS25/ClusterCategory/Get',
            type: 'Post',
            data: '{id:' + id + '}',
            dataType: 'json',
            contentType: 'application/json',
            success: function (data) {
                $("#loader, #e7-loader").hide();
                // The old page requested 'html' (so data.ImageBase64 was always undefined) and then wired a
                // click handler to a non-existent '#btn' element, i.e. nothing was ever shown. Show the
                // stored image in the page's image modal instead.
                if (data != null && data.ImageBase64 != null && data.ImageBase64 != undefined && data.ImageBase64 != '') {
                    if (typeof fnAisShowClusterImage === 'function') {
                        fnAisShowClusterImage(data.Name, data.ImageBase64);
                    }
                }
            },
            error: function (response) {
                $("#loader, #e7-loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }
</script>
