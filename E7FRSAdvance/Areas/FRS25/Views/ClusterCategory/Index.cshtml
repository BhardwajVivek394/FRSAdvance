@model Domain.ClusterCategoryLister

@{
    ViewBag.Title = "Cluster Category";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}

@* jQuery, jquery.unobtrusive-ajax and Bootstrap 4 are loaded by the FRS25 layout at the end of <body>,
   so start-up code in this page and its partials waits for DOMContentLoaded (or runs at once when
   the partial is re-rendered by Ajax and jQuery is already present). *@

<style>
    .ais-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .ais-actions .btn {
        white-space: nowrap;
    }

    .ais-section-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--e7-border, var(--e7-edge));
    }

    .ais-section-head h5 {
        margin: 0;
        font-weight: 600;
        color: var(--e7-heading, var(--e7-t1));
    }

    .ais-count {
        font-size: 13px;
        color: var(--e7-text-2, var(--e7-t2));
    }

    .ais-count strong {
        color: var(--e7-text, var(--e7-t1));
    }

    .ais-pager {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ais-pager select.form-control {
        width: auto;
        min-width: 72px;
        height: 32px;
        padding: 2px 8px;
    }

    .ais-pager .btn {
        height: 32px;
        padding: 2px 10px;
    }

    .ais-table {
        margin-bottom: 0;
        color: var(--e7-text, var(--e7-t1));
    }

    .ais-table td,
    .ais-table th {
        border-color: var(--e7-border, var(--e7-edge));
        vertical-align: middle;
    }

    .ais-table .ais-action {
        width: 50px;
        text-align: center;
    }

    .ais-table .ais-action a {
        display: inline-block;
        padding: 2px 6px;
    }

    .ais-table .ais-action .fa-edit {
        color: var(--e7-accent, var(--primary));
    }

    .ais-table .ais-link {
        font-weight: 600;
        color: var(--e7-accent, var(--primary));
        cursor: pointer;
    }

    .ais-empty {
        padding: 24px !important;
        text-align: center;
        font-size: 14px;
        color: var(--e7-text-2, var(--e7-t2));
    }

    .ais-modal .form-group > label {
        font-weight: 500;
        color: var(--e7-text, var(--e7-t1));
    }

    .ais-modal .text-danger:empty {
        display: none;
    }

    .ais-check {
        display: flex;
        align-items: center;
        min-height: calc(1.5em + .75rem + 2px);
    }

    .ais-check input[type="checkbox"] {
        width: 18px;
        height: 18px;
        margin: 0;
        accent-color: var(--e7-accent, var(--primary));
        cursor: pointer;
    }

    .ais-thumb img {
        border: 1px solid var(--e7-border, var(--e7-edge));
        border-radius: 6px;
        object-fit: contain;
        background: var(--e7-surface, transparent);
    }

    #imgClusterCategory {
        max-width: 100%;
        height: auto;
        display: block;
        margin: 0 auto;
    }

    .ais-modal-fixed-height {
        max-height: 70vh;
        overflow: auto;
    }
</style>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="row">
                        <div class="col-12 col-sm-5">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">AI Section</li>
                                    <li class="breadcrumb-item active" aria-current="page"><a href="#">Cluster Category</a></li>
                                </ol>
                            </nav>
                        </div>
                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                            <h2 class="page-name">Cluster Category</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header mb-4">
                    <div class="d-flex justify-content-between">
                        <h4 class="m-0">Search</h4>
                    </div>
                </div>

                <div class="card-body p-0">
                    @* The Name / Remark filters were a filter row inside the _List table; they now sit in the
                       Search card but stay inside the list form so SearchCriteria.Name / SearchCriteria.Remark
                       are still posted with the pager fields. *@
                    @using (Ajax.BeginForm("List", "ClusterCategory", new { area = "FRS25" }, new AjaxOptions()
                    {
                        HttpMethod = "POST",
                        UpdateTargetId = "divClusterCategoryList",
                        InsertionMode = InsertionMode.Replace,
                        LoadingElementId = "e7-loader"
                    }, new { id = "frmClusterCategoryList" }))
                    {
                        { HtmlHelper.ClientValidationEnabled = false; }
                        <div class="row mb-lg-5 mb-3">
                            <div class="col">
                                <div class="d-lg-flex d-md-flex d-flex flex-md-nowrap flex-wrap alertsearchform gap-10">
                                    <div class="form-group w-100 w-sm-48">
                                        <label for="SearchCriteria_Name">Name</label>
                                        <input type="text" class="form-control txtSearchName" id="SearchCriteria_Name" name="SearchCriteria.Name" autocomplete="off" />
                                    </div>

                                    <div class="form-group w-100 w-sm-48">
                                        <label for="SearchCriteria_Remark">Remark</label>
                                        <input type="text" class="form-control txtSearchName" id="SearchCriteria_Remark" name="SearchCriteria.Remark" autocomplete="off" />
                                    </div>

                                    <div class="form-group w-sm-100">
                                        <label class="d-none d-md-block">&nbsp;</label>
                                        <div class="ais-actions">
                                            <button type="button" class="btn btn-primary-search" onclick="fnSearchClusterCategory()" title="Search Cluster Category">
                                                <img src="~/Areas/FRS25/assets/img/search.svg" alt="Search" />
                                            </button>
                                            <button type="button" class="btn btn-active" id="btnAddClusterCategory" onclick="GetById(0)" title="Add Cluster Category">Add Cluster Category</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="divClusterCategoryList">
                            @Html.Action("List", "ClusterCategory", new { area = "FRS25" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@* Modal hosts live outside the cards so no card styling can clip the fixed-position modals. *@
@using (Ajax.BeginForm("Save", "ClusterCategory", new { area = "FRS25" }, new AjaxOptions()
{
    HttpMethod = "POST",
    UpdateTargetId = "divSaveClusterCategory",
    InsertionMode = InsertionMode.Replace,
    LoadingElementId = "e7-loader",
    OnSuccess = "ClusterCategorySaved"
}, new { id = "frmSaveClusterCategory" }))
{
    <div id="divSaveClusterCategory">
        @Html.Partial("_AddClusterCategoryPartial", new Domain.ClusterCategory())
    </div>
}

<div class="modal fade ais-modal" id="modal-cluster-category-image" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><span id="spClusterCategoryImageTitle">Cluster Image</span></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body ais-modal-fixed-height">
                <img id="imgClusterCategory" alt="Cluster Image" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Enter in a filter box must not trigger a native (non-Ajax) form post; the keyup handler in
        // _List submits the Ajax form instead.
        $("#frmClusterCategoryList").on("keydown", ".txtSearchName", function (e) {
            if (e.keyCode === 13) { e.preventDefault(); }
        });
    });

    function fnSearchClusterCategory() {
        $("#hdnSkip").val('0');
        $("#frmClusterCategoryList").submit();
    }

    // The open modal is replaced by the Save response, so its backdrop / body lock must be cleared by hand.
    function fnAisClearModalBackdrop() {
        $(".modal-backdrop").remove();
        $("body").removeClass("modal-open").css("padding-right", "");
    }

    function fnAisShowClusterImage(title, imageBase64) {
        $("#spClusterCategoryImageTitle").text(title ? ("Cluster Image - " + title) : "Cluster Image");
        $("#imgClusterCategory").attr("src", "data:image/png;base64," + imageBase64);
        $("#modal-cluster-category-image").modal("show");
    }
</script>
