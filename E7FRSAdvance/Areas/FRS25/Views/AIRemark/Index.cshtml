@model Domain.AIRemarkLister

@{
    ViewBag.Title = "Remark";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}

@* jQuery, jquery.unobtrusive-ajax and Bootstrap 4 are loaded by the FRS25 layout at the end of <body>,
   so start-up code in this page and its partials waits for DOMContentLoaded (or runs at once when
   the partial is re-rendered by Ajax and jQuery is already present). The old page loaded
   ~/Content/PageJS/AIRemark/AIRemarkList.js and AddAIRemark.js; their code is inlined here and in
   the partials with area-prefixed URLs. *@

<style>
    .ais-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .ais-actions .btn {
        white-space: nowrap;
    }

    .ais-section-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--e7-border, var(--e7-edge));
    }

    .ais-section-head h5 {
        margin: 0;
        font-weight: 600;
        color: var(--e7-heading, var(--e7-t1));
    }

    .ais-count {
        font-size: 13px;
        color: var(--e7-text-2, var(--e7-t2));
    }

    .ais-count strong {
        color: var(--e7-text, var(--e7-t1));
    }

    .ais-pager {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ais-pager select.form-control {
        width: auto;
        min-width: 72px;
        height: 32px;
        padding: 2px 8px;
    }

    .ais-pager .btn {
        height: 32px;
        padding: 2px 10px;
    }

    .ais-table {
        margin-bottom: 0;
        color: var(--e7-text, var(--e7-t1));
    }

    .ais-table td,
    .ais-table th {
        border-color: var(--e7-border, var(--e7-edge));
        vertical-align: middle;
    }

    .ais-table .ais-action {
        width: 50px;
        text-align: center;
    }

    .ais-table .ais-action a {
        display: inline-block;
        padding: 2px 6px;
    }

    .ais-table .ais-action .fa-edit {
        color: var(--e7-accent, var(--primary));
    }

    .ais-empty {
        padding: 24px !important;
        text-align: center;
        font-size: 14px;
        color: var(--e7-text-2, var(--e7-t2));
    }

    .ais-modal .form-group > label {
        font-weight: 500;
        color: var(--e7-text, var(--e7-t1));
    }

    .ais-modal .text-danger:empty {
        display: none;
    }
</style>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="row">
                        <div class="col-12 col-sm-5">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">AI Section</li>
                                    <li class="breadcrumb-item active" aria-current="page"><a href="#">Remark</a></li>
                                </ol>
                            </nav>
                        </div>
                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                            <h2 class="page-name">Remark</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header mb-4">
                    <div class="d-flex justify-content-between">
                        <h4 class="m-0">Search</h4>
                    </div>
                </div>

                <div class="card-body p-0">
                    @* The search field sits inside the list form so it is posted with the pager fields
                       (SearchCriteria.Remark), exactly as when it lived inside _AIRemarkListPartial. *@
                    @using (Ajax.BeginForm("AIRemarkList", "AIRemark", new { area = "FRS25" }, new AjaxOptions()
                    {
                        HttpMethod = "POST",
                        UpdateTargetId = "divAIRemarkList",
                        InsertionMode = InsertionMode.Replace,
                        LoadingElementId = "e7-loader"
                    }, new { id = "frmGetAIRemarkList" }))
                    {
                        { HtmlHelper.ClientValidationEnabled = false; }
                        <div class="row mb-lg-5 mb-3">
                            <div class="col">
                                <div class="d-lg-flex d-md-flex d-flex flex-md-nowrap flex-wrap alertsearchform gap-10">
                                    <div class="form-group w-100 w-sm-48">
                                        <label for="txtSearchName">Remark</label>
                                        <input type="text" class="form-control" id="txtSearchName" name="SearchCriteria.Remark" autocomplete="off" />
                                    </div>

                                    <div class="form-group w-sm-100">
                                        <label class="d-none d-md-block">&nbsp;</label>
                                        <div class="ais-actions">
                                            <button type="button" class="btn btn-primary-search" onclick="Search()" title="Search Remark">
                                                <img src="~/Areas/FRS25/assets/img/search.svg" alt="Search" />
                                            </button>
                                            <button type="button" class="btn btn-inactive" onclick="Clear()" title="Clear">Clear</button>
                                            <button type="button" class="btn btn-active" id="btnAddAIRemark" title="Add Remark">Add Remark</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="divAIRemarkList">
                            @Html.Action("AIRemarkList", "AIRemark", new { area = "FRS25" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@* Modal host lives outside the cards so no card styling can clip the fixed-position modal. *@
@using (Ajax.BeginForm("SaveAIRemark", "AIRemark", new { area = "FRS25" }, new AjaxOptions()
{
    HttpMethod = "POST",
    UpdateTargetId = "divSaveAIRemark",
    InsertionMode = InsertionMode.Replace,
    LoadingElementId = "e7-loader"
}, new { id = "frmSaveAIRemark" }))
{
    <div id="divSaveAIRemark">
        @Html.Partial("_AddAIRemarkPartial", new Domain.AIRemark())
    </div>
}

<script>
    // ---- from AIRemarkList.js (URLs area-prefixed) ----
    document.addEventListener('DOMContentLoaded', function () {
        $("#btnAddAIRemark").click(function () {
            GetById(0);
        });

        $("#txtSearchName").keyup(function (e) {
            e.preventDefault();
            if (e.keyCode === 13) {
                $("#hdnSkip").val('0');
                $("#frmGetAIRemarkList").submit();
            }
        });

        // Enter in the search box must not trigger a native (non-Ajax) form post.
        $("#txtSearchName").keydown(function (e) {
            if (e.keyCode === 13) { e.preventDefault(); }
        });
    });

    function PageSize() {
        $("#hdnSkip").val('0');
        $("#frmGetAIRemarkList").submit();
    }

    function Search() {
        $("#hdnSkip").val('0');
        $("#frmGetAIRemarkList").submit();
    }

    function Clear() {
        $("#hdnSkip").val('0');
        $("#txtSearchName").val("");
        $("#frmGetAIRemarkList").submit();
    }

    function GetById(id) {
        $("#loader, #e7-loader").show();
        $.ajax({
            url: '/FRS25/AIRemark/GetById',
            type: 'Post',
            data: '{id:' + id + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader, #e7-loader").hide();
                $("#divSaveAIRemark").empty().append(data);
                $("#modal-add-AIRemark").modal('show');
            },
            error: function (response) {
                $("#loader, #e7-loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    function DeleteById(id) {
        if (confirm('Are you sure you want to delete this record?')) {
            $("#loader, #e7-loader").show();
            $.ajax({
                url: '/FRS25/AIRemark/Delete',
                type: 'Post',
                data: '{id:' + id + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader, #e7-loader").hide();
                    if (data != null) {
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                            $("#frmGetAIRemarkList").submit();
                        }
                        else if (data.type == "error") {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    }
                },
                error: function (response) {
                    $("#loader, #e7-loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
    }

    // The open modal is replaced by the Save response, so its backdrop / body lock must be cleared by hand.
    function fnAisClearModalBackdrop() {
        $(".modal-backdrop").remove();
        $("body").removeClass("modal-open").css("padding-right", "");
    }
</script>
