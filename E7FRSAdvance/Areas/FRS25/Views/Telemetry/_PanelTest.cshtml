                    svg += svgEl('line', { x1: xp, y1: PT2, x2: xp, y2: CH - PB + 4, stroke: isPick ? '#a5d6a7' : '#ef9a9a', 'stroke-width': .8, 'stroke-dasharray': '3 3', opacity: .5 });
                });
                svg += svgEl('rect', { x: PL, y: PT2, width: iW, height: iH, fill: 'none', stroke: 'rgba(255,255,255,.12)', 'stroke-width': 1 });
                svg += '</svg>';
                chartHtml += '<div style="background:#fff;border-radius:6px;border:1px solid #cde3ea;margin-bottom:12px;overflow-x:auto;">' +
                    '<div style="padding:7px 12px 2px;border-bottom:1px solid rgba(255,255,255,.05);display:flex;align-items:center;gap:8px;">' +
                    '<span style="width:9px;height:9px;border-radius:50%;background:' + col + ';display:inline-block;"></span>' +
                    '<strong style="font-size:12px;color:' + col + ';font-family:\'JetBrains Mono\',monospace;">' + _esc(atName) + '</strong></div>' +
                    '<div style="min-width:' + chartW + 'px;">' + svg + '</div></div>';
            });
            $area.html(chartHtml || '<div style="text-align:center;padding:60px;color:rgba(255,255,255,.35);">No data.</div>');
            _ptGraphHoverInit($area[0]);
        } else {
            $area.html('<div style="text-align:center;padding:60px;color:rgba(255,255,255,.35);">Select <strong>Deviation</strong> mode to view the graph.</div>');
        }
    }

    function _ptGraphHoverInit(container) {
        var $tt = $('#ptGraphTooltip');
        $(container).off('mouseover.gtt mousemove.gtt mouseout.gtt')
            .on('mouseover.gtt', '.pt-gdot', function (e) {
                var raw = $(this).attr('data-pt'); if (!raw) return;
                try {
                    var d = JSON.parse(raw), isWarn = d.warn === 1;
                    var devClr = isWarn ? '#ff8a80' : (d.dev && d.dev[0] === '-' ? '#64b5f6' : '#81c784');
                    var colDot = '<span style="width:8px;height:8px;border-radius:50%;background:' + (d.col || '#0e5068') + ';display:inline-block;margin-right:5px;vertical-align:middle;"></span>';
                    var html = '<div class="pt-gtt-hdr' + (isWarn ? ' warn' : '') + '">' + colDot + _esc(d.attr) + '</div>' +
                        '<div class="pt-gtt-row"><span class="pt-gtt-lbl">Event</span><span class="pt-gtt-val">' + (d.evType === 'Pickup' ? '▲ ' : '▼ ') + 'E' + d.evIdx + ' &nbsp; ' + _esc(d.evTs) + '</span></div>' +
                        '<div class="pt-gtt-div"></div>' +
                        '<div class="pt-gtt-row"><span class="pt-gtt-lbl">Value</span><span class="pt-gtt-val" style="color:' + (isWarn ? '#ff8a80' : '#a5d6a7') + ';">' + _esc(String(d.val)) + '</span></div>' +
                        '<div class="pt-gtt-row"><span class="pt-gtt-lbl">TsDev</span><span class="pt-gtt-val">' + _esc(d.ts) + '</span></div>' +
                        '<div class="pt-gtt-row"><span class="pt-gtt-lbl">Deviation</span><span class="pt-gtt-val" style="color:' + devClr + ';font-size:13px;">' + _esc(d.dev) + (isWarn ? ' ⚠' : ' ✓') + '</span></div>';
                    if (d.prevVal && d.prevVal !== '—') html += '<div class="pt-gtt-div"></div><div class="pt-gtt-row"><span class="pt-gtt-lbl">Prev Value</span><span class="pt-gtt-val" style="color:#90a4ae;">' + _esc(String(d.prevVal)) + '</span></div><div class="pt-gtt-row"><span class="pt-gtt-lbl">Prev TsDev</span><span class="pt-gtt-val" style="color:#78909c;">' + _esc(d.prevTs) + '</span></div>';
                    $tt.html(html).toggleClass('warn-tip', isWarn).show();
                    _ptPositionGraphTt(e);
                } catch (ex) { }
            })
            .on('mousemove.gtt', '.pt-gdot', function (e) { _ptPositionGraphTt(e); })
            .on('mouseout.gtt', '.pt-gdot', function () { $tt.hide(); });
    }
    function _ptPositionGraphTt(e) {
        var $tt = $('#ptGraphTooltip'); if (!$tt.is(':visible')) return;
        var x = e.clientX + 16, y = e.clientY + 16, tw = $tt.outerWidth() + 4, th = $tt.outerHeight() + 4;
        if (x + tw > window.innerWidth - 8) x = e.clientX - tw - 8;
        if (y + th > window.innerHeight - 8) y = e.clientY - th - 8;
        $tt.css({ left: x, top: y });
    }

    // ══════════════════════════════════════════════════════════════
    //  DL EVENTS QUICK-POPUP (badge click on summary card)
    // ══════════════════════════════════════════════════════════════
    function _ptShowDLEvents(assetId, filterType, evt) {
        if (evt) evt.stopPropagation();
        var r = PT.data[String(assetId)]; if (!r) return;
        var an = r.analysis || _ptAnalyse(r.raw, r.asset && r.asset.assetTypeId), a = r.asset;
        var filtered = an.dlEvents.filter(function (ev) { return filterType === 'All' || ev.type === filterType; });
        $('#ptQuickPop').remove();
        var html = '<div id="ptQuickPop" style="position:fixed;z-index:99990;background:#fff;border:1px solid #cde3ea;border-radius:6px;box-shadow:0 8px 28px rgba(14,80,104,.25);min-width:500px;max-width:660px;font-family:Segoe UI,Arial,sans-serif;">' +
            '<div style="display:flex;justify-content:space-between;align-items:center;padding:10px 16px;background:#0e5068;border-radius:6px 6px 0 0;">' +
            '<span style="font-weight:700;font-size:13px;color:#fff;">' + _esc(a.assetName) + ' &mdash; ' + filterType + ' (' + filtered.length + ')</span>' +
            '<button onclick="$(\'#ptQuickPop\').remove()" style="background:none;border:none;color:#b8dde6;cursor:pointer;font-size:16px;">&#10005;</button>' +
            '</div><div style="overflow:auto;max-height:340px;">' +
            '<table class="pt-matrix"><thead><tr>' +
            '<th style="width:28px;text-align:center;">#</th>' +
            '<th>DL Attribute</th><th style="text-align:center;">Event</th>' +
            '<th style="text-align:right;">Value</th><th>TimestampDevice (T)</th>' +
            '</tr></thead><tbody>';
        filtered.forEach(function (ev, i) {
            var isPick = ev.type === 'Pickup';
            html += '<tr style="background:' + (isPick ? 'rgba(16,185,129,.05)' : i % 2 === 0 ? 'rgba(255,255,255,.02)' : 'rgba(255,255,255,.04)') + ';">' +
                '<td style="text-align:center;color:rgba(255,255,255,.38);">' + (i + 1) + '</td>' +
                '<td style="padding:7px 12px;font-weight:700;">' + _esc(ev.attrName) + '</td>' +
                '<td style="text-align:center;"><span class="pt-etag ' + (isPick ? 'pt-etag-up' : 'pt-etag-dn') + '">' + (isPick ? '&#9650; Pickup' : '&#9660; Drop') + '</span></td>' +
                '<td style="padding:7px 8px;text-align:right;font-family:JetBrains Mono,monospace;font-weight:700;">' + ev.value + '</td>' +
                '<td style="padding:7px 12px;"><span class="pt-ts">' + _ptFmt(ev.tsDev) + '</span></td>' +
                '</tr>';
        });
        html += '</tbody></table></div></div>';
        $('body').append(html);
        var $p = $('#ptQuickPop');
        if (evt) { var x = Math.min(evt.clientX, window.innerWidth - 670), y = Math.min(evt.clientY, window.innerHeight - 400); $p.css({ top: y, left: x }); }
        else { $p.css({ top: '50%', left: '50%', transform: 'translate(-50%,-50%)' }); }
    }

    // ══════════════════════════════════════════════════════════════
    //  UI STATE HELPERS
    // ══════════════════════════════════════════════════════════════
    function _ptShowIdle() {
        $('#ptPopupBody').html('<div class="pt-empty">' +
            '<div class="pt-empty-icon">&#128300;</div>' +
            '<div class="pt-empty-title">Panel Test</div>' +
            '<div style="font-size:12px;color:rgba(255,255,255,.38);max-width:480px;margin:0 auto;line-height:1.7;">' +
            'Choose a date range above and click <strong style="color:#22d3ee;">Run Analysis</strong>.<br>' +
            'For each DataLogger Pickup/Drop event the tool measures how long each attribute\'s ' +
