                    svg += svgEl('line', { x1: PL - 4, y1: yp, x2: PL, y2: yp, stroke: tcol, 'stroke-width': 1 });
                    svg += svgEl('text', { x: PL - 6, y: yp + 4, 'text-anchor': 'end', 'font-size': 9, fill: tcol }, escSvg(fD(tick)));
                });
                events.forEach(function (ev, i) {
