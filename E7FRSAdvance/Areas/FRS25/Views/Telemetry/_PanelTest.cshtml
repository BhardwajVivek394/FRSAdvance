        z-index: 99980;
    }

        #ptOverlay.pt-vis {
            display: block;
        }

    /* ── Popup base (dark glass) ── */
    #ptPopup, #ptDetailPopup {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        background: rgba(10,15,36,.97);
        backdrop-filter: blur(32px) saturate(160%);
