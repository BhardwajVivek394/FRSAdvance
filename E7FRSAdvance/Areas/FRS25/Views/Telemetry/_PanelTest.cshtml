    // ══════════════════════════════════════════════════════════════
    //  PANE 2: ALL ATTRIBUTES
    // ══════════════════════════════════════════════════════════════
    function _ptAttrList(an) {
        if (!an.attributes.length) return '<div class="pt-empty"><div class="pt-empty-icon">&#128203;</div><div class="pt-empty-title">No attributes</div></div>';
        var excl = {}; (PT.EXCLUDED_ATTRS || []).forEach(function (n) { excl[n] = true; });
        var visibleAttrs = an.attributes.filter(function (a) { return !excl[a.name]; });
        var hiddenCount = an.attributes.length - visibleAttrs.length;
        if (!visibleAttrs.length) return '<div class="pt-empty"><div class="pt-empty-icon">&#128203;</div><div class="pt-empty-title">All attributes hidden</div></div>';

        var html = '<table class="pt-matrix"><thead><tr>' +
            '<th style="width:28px;text-align:center;">#</th>' +
            '<th>Attribute</th><th style="text-align:center;">Source</th>' +
            '<th style="text-align:right;">Last Value</th><th>Last TimestampDevice</th>' +
            '<th style="text-align:center;">Values in period</th>' +
