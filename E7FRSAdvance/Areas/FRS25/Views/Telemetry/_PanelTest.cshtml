        var PALETTE = ['#22d3ee', '#f59e0b', '#34d399', '#a78bfa', '#60a5fa', '#fb923c', '#2dd4bf', '#f87171', '#c084fc', '#86efac'];
        var excl = {}; (PT.EXCLUDED_ATTRS || []).forEach(function (n) { excl[n] = true; });
        var allAttrNames = [];
        an.attrDevs.forEach(function (d) { if (!excl[d.attrName] && allAttrNames.indexOf(d.attrName) < 0) allAttrNames.push(d.attrName); });
        var attrColors = {};
        allAttrNames.forEach(function (n, i) { attrColors[n] = PALETTE[i % PALETTE.length]; });
        var selectedAttrs = {};
        $('#ptDetPane3 input[data-attr]:checked').each(function () { selectedAttrs[$(this).attr('data-attr')] = true; });
        var mode = $('input[name="ptGraphMode"]:checked').val() || 'deviation';
        var events = an.dlEvents;
        if (!events.length) { $area.html('<div style="text-align:center;padding:60px;color:rgba(255,255,255,.35);">No events.</div>'); return; }
        var attrOrder = allAttrNames.filter(function (n) { return selectedAttrs[n]; });
        if (!attrOrder.length) { $area.html('<div style="text-align:center;padding:60px;color:rgba(255,255,255,.35);">Select at least one attribute.</div>'); return; }
        var cm = {};
        an.attrDevs.forEach(function (d) { cm[d.attrName + '_' + d.dlTsDev.getTime()] = d; });
        var N = events.length;
        var MIN_PX = 18, containerW = Math.max($area.width() - 4, 500), chartW = Math.max(containerW, N * MIN_PX + 120);
        var PL = 68, PR = 20, PT2 = 32, PB = 52, iW = chartW - PL - PR;
        function xPx(i) { return PL + (N <= 1 ? iW / 2 : (i / (N - 1)) * iW); }
        var labelStep = Math.max(1, Math.ceil(N * MIN_PX / 60));
        function svgEl(tag, attrs, inner) { var a = Object.keys(attrs).map(function (k) { return k + '="' + attrs[k] + '"'; }).join(' '); return '<' + tag + ' ' + a + '>' + (inner || '</' + tag + '>'); }
