    // Esc: exit fullscreen first, then close
    $(document).on('keydown.ptFs', function (e) {
        if (e.key !== 'Escape' && e.keyCode !== 27) return;
        var $det = $('#ptDetailPopup');
        var $main = $('#ptPopup');
        if (!$main.hasClass('pt-vis') && !$det.hasClass('pt-vis')) return;
        if ($det.hasClass('pt-fullscreen')) { ptToggleFullscreen('ptDetailPopup', document.getElementById('ptDetFsBtn')); e.preventDefault(); }
        else if ($main.hasClass('pt-fullscreen')) { ptToggleFullscreen('ptPopup', document.getElementById('ptFsBtn')); e.preventDefault(); }
    });

    // ══════════════════════════════════════════════════════════════
    //  ASSET TYPE + ASSET LOADERS
    //  Uses Telemetry Live endpoints (/Telemetry/…) directly — no legacy
    //  #hdnsiteId hidden fields required.
    // ══════════════════════════════════════════════════════════════

    function _ptLoadAssetTypes(siteId) {
        var sel = $('#ptAssetTypeId');

        // Already loaded for this site — re-populate from cache immediately
        if (PT._typesLoaded && PT._cachedTypeData && PT._cachedTypeData.length) {
            _ptPopulateTypeDropdown(sel, PT._cachedTypeData, true);
            return;
        }

        if (!siteId || siteId === '' || siteId === '0') {
            // No site selected in filter bar — load all sites from the main dropdown
            _ptLoadAllSites(sel);
            return;
        }

        sel.html('<option value="">&mdash; loading… &mdash;</option>').prop('disabled', true);

        $.ajax({
            url: '/Telemetry/GetAssetTypeBySiteId',
            type: 'POST',
            data: JSON.stringify({ siteId: siteId }),
            contentType: 'application/json',
            dataType: 'json',
            success: function (data) {
                if (data && data.length > 0) {
                    _ptPopulateTypeDropdown(sel, data);
                } else {
                    sel.html('<option value="">— no types found —</option>').prop('disabled', false);
                }
            },
            error: function () {
                sel.html('<option value="">— failed to load —</option>').prop('disabled', false);
            }
        });
    }

    // ── Load all sites when none selected in filter bar ──────────
    function _ptLoadAllSites(sel) {
        // Populate ptSiteInternal from #drpSite options (already in DOM)
        var $drp = $('#drpSite');
        if ($drp.length && $drp.find('option').length > 1) {
            // Build site selector inside config bar
            _ptShowSitePicker($drp);
            return;
        }
        // Fallback: ask server
        sel.html('<option value="">— no site selected —</option>');
    }

    function _ptShowSitePicker($drp) {
        var $grp = $('#ptSitePickerGrp');
        if (!$grp.length) {
            $grp = $('<div class="pt-cfg-grp" id="ptSitePickerGrp"></div>');
            var $lbl = $('<label class="pt-cfg-lbl">Select Station</label>');
            var $sel = $('<select id="ptSitePicker" class="pt-cfg-input" style="min-width:200px;"></select>');
            $sel.append('<option value="">&mdash; Select Site &mdash;</option>');
            $drp.find('option').each(function () {
                var v = $(this).val(), t = $(this).text();
                if (!v || v === '0' || v === '') return;
                $sel.append('<option value="' + v + '">' + t + '</option>');
            });
            $sel.on('change', function () {
                var sid = $.trim($(this).val() || '');
                if (!sid) return;
                $('#ptSiteDisplay').text($(this).find('option:selected').text());
                PT._lastSiteId = sid;
                PT._typesLoaded = false;
                PT._cachedTypeData = null;
                PT._typesFetched = {};
                PT.allKnownAssets = {};
                PT.dlReady = false;
                PT.dlMap = {};
                ptResetAssetMultiSelect();
                _ptLoadAssetTypes(sid);
            });
            $grp.append($lbl).append($sel);
            // Insert at the start of the config bar (before date fields)
            $('.pt-config-bar').prepend($grp);
        }
        $('#ptAssetTypeId').html('<option value="">&mdash; select site first &mdash;</option>').prop('disabled', true);
    }

    function _ptPopulateTypeDropdown(sel, data, restoreOnly) {
        PT._typesLoaded = true;
        PT._cachedTypeData = data;
        sel.empty().prop('disabled', false);

        // Filter to track types; fall back to all if none
        var trackOnly = data.filter(function (t) {
            return (t.Name || t.name || t.AssetTypeName || '').toLowerCase().indexOf('track') >= 0;
        });
        var displayData = trackOnly.length ? trackOnly : data;
        displayData.sort(function (a, b) { return (a.Name || a.name || '').toLowerCase().localeCompare((b.Name || b.name || '').toLowerCase()); });

        if (displayData.length > 1) sel.append('<option value="">&mdash; All Track Types &mdash;</option>');

        var firstId = '';
        $.each(displayData, function (k, t) {
            var id = String(t.Id || t.id || t.AssetTypeId || '');
            var name = t.Name || t.name || t.AssetTypeName || ('Type ' + id);
            if (k === 0) firstId = id;
            sel.append('<option value="' + _esc(id) + '">' + _esc(name) + '</option>');
        });

        if (restoreOnly) { sel.val(displayData.length === 1 ? firstId : ''); return; }

        // Determine the current siteId — may come from main filter bar OR inner site picker
        function _ptCurrentSiteId() {
            var fromPicker = $.trim($('#ptSitePicker').val() || '');
            var fromFilter = $.trim($('#drpSite').val() || '');
            return fromPicker || fromFilter || '';
        }

        if (displayData.length === 1 && firstId) {
            // Single track type — auto-select it and load assets
            sel.val(firstId);
            var sid1 = _ptCurrentSiteId();
            if (PT._typesFetched[firstId]) {
                _ptPopulateAssetMultiSelect(Object.values(PT.allKnownAssets).filter(function (a) { return a.assetTypeId === firstId; }));
            } else {
                _ptFetchAssetsByType(sid1, firstId, function (assets) { _ptPopulateAssetMultiSelect(assets); });
            }
        } else if (displayData.length > 1) {
            // Multiple types — select blank "All Track Types" but immediately
            // load assets for ALL track types so the asset multi-select is populated
            sel.val('');
            var sid2 = _ptCurrentSiteId();
            var pending2 = displayData.length, combinedAssets = [];
            displayData.forEach(function (t) {
                var tid = String(t.Id || t.id || t.AssetTypeId || '');
                if (!tid) { pending2--; if (!pending2) _ptPopulateAssetMultiSelect(combinedAssets); return; }
                if (PT._typesFetched[tid]) {
                    var cached = Object.values(PT.allKnownAssets).filter(function (a) { return a.assetTypeId === tid; });
                    combinedAssets = combinedAssets.concat(cached);
                    pending2--;
                    if (!pending2) _ptPopulateAssetMultiSelect(combinedAssets);
                } else {
                    _ptFetchAssetsByType(sid2, tid, function (assets) {
                        combinedAssets = combinedAssets.concat(assets);
                        pending2--;
                        if (!pending2) _ptPopulateAssetMultiSelect(combinedAssets);
                    });
                }
            });
        }
    }

    function ptOnAssetTypeChange() {
        var siteId = $.trim($('#ptSitePicker').val() || $('#drpSite').val() || '');
        var assetTypeId = $.trim($('#ptAssetTypeId').val() || '');
        ptResetAssetMultiSelect();

        if (!siteId || siteId === '0') return;

        if (!assetTypeId) {
            // "All Track Types" selected — load assets for every known type
            var allTypes = PT._cachedTypeData || [];
            var trackTypes = allTypes.filter(function (t) {
                return (t.Name || t.name || t.AssetTypeName || '').toLowerCase().indexOf('track') >= 0;
            });
            if (!trackTypes.length) trackTypes = allTypes;
            if (!trackTypes.length) {
                _ptPopulateAssetMultiSelect(Object.values(PT.allKnownAssets));
                return;
            }
            var pending3 = trackTypes.length, combined3 = [];
            trackTypes.forEach(function (t) {
                var tid = String(t.Id || t.id || t.AssetTypeId || '');
                if (!tid) { pending3--; if (!pending3) _ptPopulateAssetMultiSelect(combined3); return; }
                if (PT._typesFetched[tid]) {
                    combined3 = combined3.concat(Object.values(PT.allKnownAssets).filter(function (a) { return a.assetTypeId === tid; }));
                    pending3--;
                    if (!pending3) _ptPopulateAssetMultiSelect(combined3);
                } else {
                    _ptFetchAssetsByType(siteId, tid, function (assets) {
                        combined3 = combined3.concat(assets);
                        pending3--;
                        if (!pending3) _ptPopulateAssetMultiSelect(combined3);
                    });
                }
            });
            return;
        }

        if (PT._typesFetched[String(assetTypeId)]) {
            _ptPopulateAssetMultiSelect(Object.values(PT.allKnownAssets).filter(function (a) { return a.assetTypeId === String(assetTypeId); }));
            return;
        }

        _ptFetchAssetsByType(siteId, assetTypeId, function (assets) { _ptPopulateAssetMultiSelect(assets); });
    }

    function _ptFetchAssetsByType(siteId, assetTypeId, cb) {
        if (!siteId || siteId === '0' || !assetTypeId) return;
        $('#ptAssetMsList').html('<div class="pt-ms-item">&#9203; Loading assets…</div>');
        $('#ptAssetMsWrap').addClass('open');
        $('#ptAssetMsDropdown').show();

        $.ajax({
            url: '/Telemetry/GetAssestBy',
            type: 'POST',
            data: JSON.stringify({ siteId: siteId, assetTypeId: assetTypeId }),
            contentType: 'application/json',
            dataType: 'json',
            success: function (d) {
                PT._typesFetched[String(assetTypeId)] = true;
                var typeName = $('#ptAssetTypeId option:selected').text() || 'Unknown';
                var assets = [];
                if (d && d.length > 0) {
                    $.each(d, function (k, v) {
                        var id = String(v.Id || v.id || '');
                        var name = v.Name || v.name || ('Asset ' + id);
                        if (!id) return;
                        if (!PT.allKnownAssets[id]) {
                            PT.allKnownAssets[id] = { assetId: id, assetName: name, assetType: typeName, assetTypeId: String(assetTypeId) };
                        }
                        assets.push({ assetId: id, assetName: name, assetTypeId: String(assetTypeId) });
                    });
                }
                if (cb) cb(assets);
            },
            error: function () {
                $('#ptAssetMsList').html('<div class="pt-ms-empty">Failed to load assets</div>');
                if (cb) cb([]);
            }
        });
    }

    // ── Multi-select widget ────────────────────────────────────────
    function ptResetAssetMultiSelect() {
        PT._selectedAssets = {};
        $('#ptAssetMsList').html('<div class="pt-ms-empty">Select an Asset Type first</div>');
        $('#ptAssetMsLabel').text('All Assets');
        $('#ptAssetSelCount').text('(all)');
        $('#ptAssetMsSearch').val('');
        _ptCloseAssetDropdown();
    }

    function _ptPopulateAssetMultiSelect(assets) {
        var list = $('#ptAssetMsList');
        list.empty();
        if (!assets || !assets.length) { list.html('<div class="pt-ms-empty">No assets found</div>'); return; }
        assets.sort(function (a, b) { return (a.assetName || '').localeCompare(b.assetName || ''); });
        assets.forEach(function (a) {
            var id = a.assetId, name = a.assetName;
            var isChk = PT._selectedAssets[id] !== false;
            if (PT._selectedAssets[id] === undefined) PT._selectedAssets[id] = true;
            var row = $('<div class="pt-ms-item" data-id="' + id + '" data-name="' + _esc(name) + '">' +
                '<input type="checkbox" id="ptAC_' + id + '" ' + (isChk ? 'checked' : '') + '>' +
                '<label for="ptAC_' + id + '">' + _esc(name) + '</label></div>');
            row.find('input').on('change', function () { PT._selectedAssets[id] = this.checked; ptUpdateAssetSelLabel(); });
            list.append(row);
        });
        ptUpdateAssetSelLabel();
        $('#ptAssetMsWrap').addClass('open');
        $('#ptAssetMsDropdown').show();
    }

    function ptToggleAssetDropdown(e) {
        if (e) e.stopPropagation();
        if ($('#ptAssetMsDropdown').is(':visible')) _ptCloseAssetDropdown();
        else { $('#ptAssetMsDropdown').show(); $('#ptAssetMsWrap').addClass('open'); }
    }
    function _ptCloseAssetDropdown() { $('#ptAssetMsDropdown').hide(); $('#ptAssetMsWrap').removeClass('open'); }
    function ptFilterAssetList() {
        var q = $.trim($('#ptAssetMsSearch').val()).toLowerCase();
        $('#ptAssetMsList .pt-ms-item').each(function () { $(this).toggle(!q || ($(this).attr('data-name') || '').toLowerCase().indexOf(q) >= 0); });
    }
    function ptSelectAllAssets(chk) {
        $('#ptAssetMsList .pt-ms-item input[type=checkbox]').each(function () {
            this.checked = chk;
            PT._selectedAssets[$(this).closest('.pt-ms-item').attr('data-id')] = chk;
        });
        ptUpdateAssetSelLabel();
    }
    function ptUpdateAssetSelLabel() {
        var all = $('#ptAssetMsList .pt-ms-item').length;
        var chk = $('#ptAssetMsList .pt-ms-item input:checked').length;
        if (chk === 0) { $('#ptAssetMsLabel').text('None selected'); $('#ptAssetSelCount').text('(0)'); }
        else if (chk === all) { $('#ptAssetMsLabel').text('All Assets'); $('#ptAssetSelCount').text('(all)'); }
        else {
            var first = $('#ptAssetMsList .pt-ms-item input:checked').first().closest('.pt-ms-item').attr('data-name') || '';
            $('#ptAssetMsLabel').text(chk === 1 ? first : first + ' +' + (chk - 1) + ' more');
            $('#ptAssetSelCount').text('(' + chk + ')');
        }
    }
    $(document).on('click.ptAssetMs', function (e) { if (!$(e.target).closest('[id^="ptAssetMs"]').length) _ptCloseAssetDropdown(); });

    // ── Build asset list for a run ─────────────────────────────────
    function _ptGetAssets() {
        var selectedTypeId = $.trim($('#ptAssetTypeId').val() || '');
        var hasAssetSel = Object.keys(PT._selectedAssets).length > 0;
        var list = [];
        Object.keys(PT.allKnownAssets).forEach(function (id) {
            var a = PT.allKnownAssets[id];
            if (selectedTypeId && a.assetTypeId !== selectedTypeId) return;
            if (hasAssetSel && PT._selectedAssets[id] === false) return;
            list.push({ assetId: a.assetId, assetName: a.assetName, assetType: a.assetType, assetTypeId: a.assetTypeId });
        });
        return list;
    }

    // ══════════════════════════════════════════════════════════════
    //  RUN ANALYSIS
    // ══════════════════════════════════════════════════════════════
    function ptRunAnalysis() {
        var fromVal = $('#ptFromDt').val();
        var toVal = $('#ptToDt').val();

        if (!fromVal || !toVal) { CommonNotification('ERROR', 'Please select both From and To date/time.', 'error'); return; }
        if (new Date(fromVal).getTime() >= new Date(toVal).getTime()) {
            CommonNotification('ERROR', 'From date must be earlier than To date.', 'error'); return;
        }

        var warnInput = parseFloat($('#ptWarnSec').val());
        if (isNaN(warnInput) || warnInput < 1) { warnInput = 10; $('#ptWarnSec').val(10); }
        PT.WARN_SEC = warnInput;
        ptUpdateLegend();

        PT.startFmt = _ptToApiDate(fromVal, true);
        PT.endFmt = _ptToApiDate(toVal, false);
        PT.startMs = _ptToMs(fromVal);
        PT.endMs = _ptToMs(toVal);

        if (!PT.startFmt || !PT.startMs) { CommonNotification('ERROR', 'Invalid date/time values.', 'error'); return; }

        PT.data = {};
        PT.assets = _ptGetAssets();

        $('#ptRangeBadge').text(_ptFmtDtLocal(fromVal) + ' → ' + _ptFmtDtLocal(toVal));
        $('#ptHdrSub').text('Warn window: ' + PT.WARN_SEC + 's  |  Clock: TimestampDevice');
        $('#ptStatStrip,#ptTabBar,#ptFooterBar').hide();
        $('#ptExportBtn').hide();
        _ptShowLoading('Fetching data…', 0);
        $('#ptRunBtn').prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Running…');

        if (!PT.assets.length) {
            _ptShowEmpty('No assets found. Select an Asset Type and assets first, then run again.');
            $('#ptRunBtn').prop('disabled', false).html('<i class="fa fa-play mr-1"></i> Run Analysis');
            return;
        }

        var atTypeId = $.trim($('#ptAssetTypeId').val() || '');
        var siteId = $.trim($('#drpSite').val() || '');

        PT.attrReady = false;
        PT.attrMap = {};

        _ptLoadNames(atTypeId, function () {
            _ptLoadDLNames(siteId, function () {
                _ptFetch(0);
            });
        });
    }

    // ── Attribute name loaders ─────────────────────────────────────
    function _ptLoadNames(primaryTypeId, cb) {
        var typeIds = {};
        PT.assets.forEach(function (a) { var tid = a.assetTypeId || primaryTypeId; if (tid && tid !== '0' && tid !== '') typeIds[tid] = true; });
        if (!Object.keys(typeIds).length) { PT.attrReady = true; cb(); return; }

        var pending = Object.keys(typeIds).filter(function (tid) { return !PT.attrByType[tid]; });
        if (!pending.length) { _ptMergeAttrMaps(typeIds); cb(); return; }

        var done = 0;
        pending.forEach(function (tid) {
            $.ajax({
                url: '/Telemetry/GetAttributesByAssestId', type: 'POST',
                data: '{id:' + tid + '}', contentType: 'application/json',
                success: function (d) {
                    var map = {};
                    if (Array.isArray(d)) {
                        d.forEach(function (x) {
                            var id = x.Id || x.id || x.AttributeId;
                            var name = x.AliasName || x.aliasName || x.Title || x.title || x.Name || '';
                            if (id !== undefined && name) { map[id] = name; map[String(id)] = name; }
                        });
                    }
                    PT.attrByType[tid] = map;
                },
                error: function () { PT.attrByType[tid] = {}; },
                complete: function () {
                    done++;
                    if (done >= pending.length) { _ptMergeAttrMaps(typeIds); cb(); }
                }
            });
        });
    }

    function _ptMergeAttrMaps(typeIds) {
        PT.attrMap = {};
        Object.keys(typeIds).forEach(function (tid) {
            var m = PT.attrByType[tid] || {};
            Object.keys(m).forEach(function (id) { PT.attrMap[id] = m[id]; });
        });
        PT.attrReady = true;
    }

    function _ptLoadDLNames(siteId, cb) {
        if (PT.dlReady) { cb(); return; }
        if (!siteId || siteId === '0' || siteId === '') { PT.dlReady = true; cb(); return; }
        $.ajax({
            url: '/Telemetry/GetUserAssetInfoDatalogger?siteId=' + siteId,
            type: 'GET', dataType: 'json',
            success: function (d) {
                PT.dlMap = {};
                if (Array.isArray(d)) {
                    d.forEach(function (x) {
                        var r = x.Role, n = x.DataloggerAttribute || x.dataloggerAttribute || x.Name || '';
                        if (r != null && n) { PT.dlMap[r] = n; PT.dlMap[parseInt(r)] = n; PT.dlMap[String(r)] = n; }
                    });
                }
                PT.dlReady = true; cb();
            },
            error: function () { PT.dlReady = true; cb(); }
        });
    }

    // ── Sequential fetch ───────────────────────────────────────────
    function _ptFetch(i) {
        if (i >= PT.assets.length) {
            $('#ptRunBtn').prop('disabled', false).html('<i class="fa fa-play mr-1"></i> Run Analysis');
            _ptRender();
            return;
        }
        var a = PT.assets[i];
        var pct = Math.round(i / PT.assets.length * 100);
        $('#ptProgFill').css('width', pct + '%');
        $('#ptProgSub').html('<strong>' + (i + 1) + ' / ' + PT.assets.length + '</strong> &mdash; ' + _esc(a.assetName));

        $.ajax({
            url: PT.API + '?assetId=' + a.assetId + '&startDate=' + PT.startFmt + '&endDate=' + PT.endFmt,
            type: 'GET', dataType: 'json', timeout: 60000,
            success: function (d) {
                if (d && d.error) {
                    PT.data[a.assetId] = { asset: a, raw: null, analysis: null, err: d.error };
                } else {
                    var payload = (d && (d.Data || d.data)) ? (d.Data || d.data) : d;
                    PT.data[a.assetId] = { asset: a, raw: { Data: Array.isArray(payload) ? payload : [] }, analysis: null, err: null };
                }
                _ptFetch(i + 1);
            },
            error: function (x, s, e) {
                PT.data[a.assetId] = { asset: a, raw: null, analysis: null, err: s + ':' + e };
                _ptFetch(i + 1);
            }
        });
    }

    // ══════════════════════════════════════════════════════════════
    //  CORE ANALYSIS  (TimestampDevice = master clock)
    // ══════════════════════════════════════════════════════════════
    function _ptAnalyse(raw, assetTypeId) {
        var r = {
            totalEvents: 0, pickups: 0, drops: 0, hasEvent: false,
            lastTsDev: null, maxDevSec: null,
            hasWarn: false, hasRangeWarn: false, hasRangeFail: false,
            dlEvents: [], attributes: [], attrDevs: []
        };
        if (!raw || !Array.isArray(raw.Data)) return r;

        // Pass 1 — parse all attribute blocks
        raw.Data.forEach(function (block) {
            var atId = block.AttributeId, isDL = false;
            var info = { attrId: atId, isDL: false, name: '', lastValue: null, lastTsDev: null, events: [], vals: [] };
            if (!block.Values) { r.attributes.push(info); return; }

            Object.keys(block.Values).sort(function (a, b) { return +a - +b; }).forEach(function (k) {
                var v = block.Values[k]; if (!v) return;
                var ts = v.Timestamp || {};
                var tsDevRaw = ts.TimestampDevice;
                if (!tsDevRaw) return;
                var tsDev = new Date(tsDevRaw);
                if (isNaN(tsDev.getTime())) return;

                var tsDevMs = tsDev.getTime();
                if (tsDevMs < PT.startMs - PT.PRE_WIN * 1000) return;
                if (PT.endMs && tsDevMs > PT.endMs) return;

                var src = ts.DataSource || '';
                var isEv = (v.DataType === 'DataLogger') || (src === 'Event');
                if (isEv) isDL = true;

                info.vals.push({ val: v.Value, tsDev: tsDev, src: src, dt: v.DataType });

                if (isEv) {
                    var et = (v.Value === 1 || v.Value === 1.0) ? 'Pickup' : (v.Value === 0 || v.Value === 0.0) ? 'Drop' : null;
                    if (et) {
                        info.events.push({ type: et, value: v.Value, tsDev: tsDev });
                        r.totalEvents++; if (et === 'Pickup') r.pickups++; else r.drops++;
                        r.hasEvent = true;
                    }
                }
            });

            info.isDL = isDL;
            info.name = _ptName(atId, isDL, assetTypeId);
            if (info.vals.length) {
                var lv = info.vals[info.vals.length - 1];
                info.lastValue = lv.val; info.lastTsDev = lv.tsDev;
                if (!r.lastTsDev || lv.tsDev > r.lastTsDev) r.lastTsDev = lv.tsDev;
            }
            r.attributes.push(info);
        });

        // Deduplicate DL events
        var _dlMap = {};
        r.attributes.forEach(function (at) {
            if (!at.isDL) return;
            at.events.forEach(function (ev) {
                var key = ev.type + '_' + ev.tsDev.getTime();
                if (_dlMap[key]) { if (_dlMap[key].attrNames.indexOf(at.name) < 0) _dlMap[key].attrNames.push(at.name); }
                else { _dlMap[key] = { attrName: at.name, attrNames: [at.name], type: ev.type, value: ev.value, tsDev: ev.tsDev }; }
            });
        });
        r.dlEvents = Object.keys(_dlMap).map(function (k) { return _dlMap[k]; });
        r.dlEvents.sort(function (a, b) { return a.tsDev.getTime() - b.tsDev.getTime(); });
        r.totalEvents = r.dlEvents.length;
        r.pickups = r.dlEvents.filter(function (e) { return e.type === 'Pickup'; }).length;
        r.drops = r.dlEvents.filter(function (e) { return e.type === 'Drop'; }).length;
        r.hasEvent = r.totalEvents > 0;

        var WIN = PT.WARN_SEC * 1000;
        var PRE_WIN = PT.PRE_WIN * 1000;
        var SEARCH_MS = 300 * 1000;
        var PRE_WIN_SEC = PT.PRE_WIN;

        var nonDL = r.attributes.filter(function (at) { return !at.isDL && at.vals.length; });
        nonDL.forEach(function (at) { at.vals.sort(function (a, b) { return a.tsDev.getTime() - b.tsDev.getTime(); }); });

        r.dlEvents.forEach(function (dlEv) {
            var T = dlEv.tsDev.getTime();
            var Tmin = T - PRE_WIN;
            var Tmax = T + WIN;

            nonDL.forEach(function (at) {
                // Pre-event steady state
                var preVal = null;
                for (var p = at.vals.length - 1; p >= 0; p--) { if (at.vals[p].tsDev.getTime() < T) { preVal = at.vals[p].val; break; } }

                // Priority 1 — exact timestamp match
                var exact = null, exactChanged = false, exactIdx = -1;
                for (var ex = 0; ex < at.vals.length; ex++) {
                    var ev = at.vals[ex];
                    if (ev.tsDev.getTime() !== T) continue;
                    var evChanged = (preVal === null) || (String(ev.val) !== String(preVal));
                    if (exact === null) { exact = ev; exactChanged = evChanged; exactIdx = ex; }
                    else if (evChanged && !exactChanged) { exact = ev; exactChanged = true; exactIdx = ex; }
                    else if (evChanged === exactChanged) { exact = ev; exactIdx = ex; }
                }

                var found = null, foundIdx = -1, warn = false;

                if (exact) {
                    found = exact; foundIdx = exactIdx;
                } else {
                    // Priority 2 — nearest in-window
                    var bestInWin = null, bestInWinAbs = Infinity, bestInWinIdx = -1;
                    var nearAny = null, nearAnyAbs = Infinity;
                    for (var ii = 0; ii < at.vals.length; ii++) {
                        var vv = at.vals[ii];
                        var dev = vv.tsDev.getTime() - T;
                        var ad = dev < 0 ? -dev : dev;
                        var inWin = (dev >= 0 && dev <= WIN) || (dev < 0 && ad <= PRE_WIN);
                        if (inWin && ad < bestInWinAbs) { bestInWin = vv; bestInWinAbs = ad; bestInWinIdx = ii; }
                        if (ad <= SEARCH_MS && ad < nearAnyAbs) { nearAny = vv; nearAnyAbs = ad; }
                    }
                    if (bestInWin) { found = bestInWin; foundIdx = bestInWinIdx; }
                    else if (nearAny) { found = nearAny; warn = true; }
                }

                var devSec = found ? (found.tsDev.getTime() - T) / 1000 : null;
                if (!found) warn = true;
                if (found && (devSec > PT.WARN_SEC || devSec < -PRE_WIN_SEC)) warn = true;

                // PREV: reading immediately before matched value
                var lastKnown = null;
                if (foundIdx > 0) lastKnown = at.vals[foundIdx - 1];
                else if (foundIdx === -1) { for (var j = at.vals.length - 1; j >= 0; j--) { if (at.vals[j].tsDev.getTime() < T) { lastKnown = at.vals[j]; break; } } }

                // Range check
                var rng = found ? _ptRangeCheck(at.attrId, found.val) : { status: 'ok', max: null, min: null, fail: null, avg: null, cfg: false };
                if (rng.status === 'fail') r.hasRangeFail = true;
                if (rng.status !== 'ok') r.hasRangeWarn = true;

                r.attrDevs.push({
                    attrName: at.name, attrId: at.attrId,
                    dlAttr: dlEv.attrName, dlType: dlEv.type, dlTsDev: dlEv.tsDev,
                    windowStart: new Date(Tmin), windowEnd: new Date(Tmax),
                    firstTs: found ? found.tsDev : null, firstVal: found ? found.val : null,
                    devSec: devSec, warn: warn,
                    lastKnownTs: lastKnown ? lastKnown.tsDev : null,
                    lastKnownVal: lastKnown ? lastKnown.val : null,
                    rangeStatus: rng.status, rangeMax: rng.max, rangeMin: rng.min,
                    rangeFail: rng.fail, rangeAvg: rng.avg, rangeCfg: rng.cfg,
                    flag: false
                });

                if (warn) r.hasWarn = true;
                if (found && devSec !== null) {
                    var absDev = Math.abs(devSec);
                    if (r.maxDevSec === null || absDev > r.maxDevSec) r.maxDevSec = absDev;
                }
            });
        });

        return r;
    }

    // ══════════════════════════════════════════════════════════════
    //  RENDER — summary card grid
    // ══════════════════════════════════════════════════════════════
    function _ptRender() {
        var tc = {};
        PT.assets.forEach(function (a) { tc[a.assetType] = (tc[a.assetType] || 0) + 1; });
        var tabs = '<button class="pt-tab active" data-t="All" onclick="_ptTab(this,\'All\')">ALL (' + PT.assets.length + ')</button>';
        Object.keys(tc).forEach(function (t) {
            tabs += '<button class="pt-tab" data-t="' + _esc(t) + '" onclick="_ptTab(this,\'' + _escJs(t) + '\')">' + _esc(t.toUpperCase()) + ' (' + tc[t] + ')</button>';
        });
        $('#ptTabBar').html(tabs).show();

        var n = 0, fail = 0, warn = 0, ok = 0, totalPick = 0, totalDrop = 0, globalMax = null, cards = '';

        PT.assets.forEach(function (a) {
            var r = PT.data[a.assetId]; if (!r) return;
            var an = _ptAnalyse(r.raw, a.assetTypeId);
            r.analysis = an; n++;
            totalPick += an.pickups; totalDrop += an.drops;
            if (an.maxDevSec !== null && (globalMax === null || an.maxDevSec > globalMax)) globalMax = an.maxDevSec;

            var isFail = an.hasRangeFail;
            var isWarn = an.hasWarn || an.hasRangeWarn;
            var cls, chip;
            if (isFail) { cls = 'pt-fail'; chip = '<span class="pt-chip pt-fail">&#9888; Fail</span>'; fail++; }
            else if (isWarn) { cls = 'pt-warn'; chip = '<span class="pt-chip pt-warn">&#9889; Warn</span>'; warn++; }
            else { cls = 'pt-ok'; chip = '<span class="pt-chip pt-ok">&#10003; OK</span>'; ok++; }

            var devNum = an.maxDevSec || 0;
            var barPct = Math.min(100, devNum / (PT.WARN_SEC * 2) * 100);
            var barClr = isFail ? '#c62828' : (isWarn ? '#e65100' : '#2e7d32');
            var devStr = an.maxDevSec !== null ? an.maxDevSec.toFixed(1) + 's' : '—';
            var errIco = r.err ? '<i class="fa fa-exclamation-circle" style="color:#fb8c00;margin-left:4px;" title="' + _esc(r.err) + '"></i>' : '';

            // Live data watermark for this asset
            var liveTag = '';
            if (window.wsLiveData && window.wsLiveData[a.assetId]) {
                liveTag = '<span style="font-size:8px;background:rgba(52,211,153,.2);color:#059669;border:1px solid rgba(52,211,153,.4);border-radius:3px;padding:1px 5px;margin-left:6px;vertical-align:middle;">&#11044; LIVE</span>';
            }

            var pickBadge = an.pickups > 0
                ? '<span class="pt-etag pt-etag-up" onclick="event.stopPropagation();_ptShowDLEvents(\'' + a.assetId + '\',\'Pickup\',event)">&#9650;&nbsp;' + an.pickups + '</span>'
                : '<span style="color:rgba(255,255,255,.22);">—</span>';
            var dropBadge = an.drops > 0
                ? '<span class="pt-etag pt-etag-dn" style="margin-left:4px;" onclick="event.stopPropagation();_ptShowDLEvents(\'' + a.assetId + '\',\'Drop\',event)">&#9660;&nbsp;' + an.drops + '</span>'
                : '<span style="color:rgba(255,255,255,.22);margin-left:4px;">—</span>';

            cards += '<div class="pt-card ' + cls + '" data-t="' + _esc(a.assetType) + '" onclick="_ptDetail(\'' + a.assetId + '\')">' +
                '<div class="pt-card-hdr">' +
                '<div><div class="pt-card-name">' + _esc(a.assetName) + errIco + liveTag + '</div>' +
                '<div class="pt-card-type">' + _esc(a.assetType) + '</div></div>' + chip +
                '</div>' +
                '<div class="pt-card-body">' +
                '<div class="pt-card-stats">' +
                '<div class="pt-card-stat"><div class="pt-card-stat-val" style="color:#22d3ee;">' + an.totalEvents + '</div><div class="pt-card-stat-lbl">Events</div></div>' +
                '<div class="pt-card-stat"><div class="pt-card-stat-val" style="color:#34d399;">' + an.pickups + '</div><div class="pt-card-stat-lbl">Pickups</div></div>' +
                '<div class="pt-card-stat"><div class="pt-card-stat-val" style="color:#f87171;">' + an.drops + '</div><div class="pt-card-stat-lbl">Drops</div></div>' +
                '<div class="pt-card-stat"><div class="pt-card-stat-val" style="color:' + barClr + ';">' + devStr + '</div><div class="pt-card-stat-lbl">Max Dev</div></div>' +
                '</div>' +
                '<div class="pt-dev-bar">' +
                '<span class="pt-dev-bar-label">Deviation</span>' +
                '<div class="pt-dev-bar-track"><div class="pt-dev-bar-fill" style="width:' + barPct + '%;background:' + barClr + ';"></div></div>' +
                '<span class="pt-dev-bar-val" style="color:' + barClr + ';">' + devStr + '</span>' +
                '</div>' +
                '<div style="margin-top:8px;display:flex;align-items:center;gap:4px;">' + pickBadge + dropBadge + '</div>' +
                '</div>' +
                '</div>';
        });

        // Stats strip
        var liveCount = window.wsLiveData ? Object.keys(window.wsLiveData).length : 0;
        $('#ptsTotal').text(n); $('#ptsWarn').text(warn + fail); $('#ptsOk').text(ok);
        $('#ptsPick').text(totalPick); $('#ptsDrop').text(totalDrop);
        $('#ptsMxDev').html(globalMax !== null ? globalMax.toFixed(1) + 's' : '—');
        if (liveCount > 0) { $('#ptsLiveBox').show(); $('#ptsLive').text(liveCount); } else { $('#ptsLiveBox').hide(); }
        $('#ptStatStrip').show();

        var body = '<div class="pt-cards-wrap"><div class="pt-cards-grid">' + cards + '</div></div>';
        $('#ptPopupBody').html(body);
        $('#ptFooterTxt').html('<strong>' + n + '</strong> assets analysed &nbsp;|&nbsp; ' +
            '<strong style="color:#34d399;">' + ok + '</strong> OK &nbsp;|&nbsp; ' +
            '<strong style="color:#fbbf24;">' + (warn + fail) + '</strong> warn/fail &nbsp;|&nbsp; ' +
            'Warn window: <strong>' + PT.WARN_SEC + 's</strong>');
        $('#ptFooterBar').show();
        if (n > 0) $('#ptExportBtn').show();

        $('#ptTotals').text(n + ' assets, ' + (warn + fail) + ' warn');
    }

    // ── Type-filter tabs ───────────────────────────────────────────
    function _ptTab(btn, type) {
        $('.pt-tab').removeClass('active');
        $(btn).addClass('active');
        $('.pt-card').each(function () {
            $(this).toggle(type === 'All' || $(this).attr('data-t') === type);
        });
    }

    // ══════════════════════════════════════════════════════════════
    //  DETAIL VIEW
    // ══════════════════════════════════════════════════════════════
    function _ptDetail(assetId) {
        assetId = String(assetId);
        var r = PT.data[assetId]; if (!r) return;
        var an = r.analysis || _ptAnalyse(r.raw, r.asset.assetTypeId);
        r.analysis = an;
        PT._detAn = an;
        PT.matrixMode = 'all';

        var a = r.asset;
        var isFail = an.hasRangeFail;
        var isWarn = an.hasWarn || an.hasRangeWarn;
        var statusCls = isFail ? 'pt-fail' : (isWarn ? 'pt-warn' : 'pt-ok');
        var statusChip = isFail
            ? '<span class="pt-chip pt-fail">&#9888; Fail</span>'
            : isWarn
                ? '<span class="pt-chip pt-warn">&#9889; Warn</span>'
                : '<span class="pt-chip pt-ok">&#10003; OK</span>';

        $('#ptDetTitle').html('<i class="fa fa-microchip mr-2" style="opacity:.8;"></i>' + _esc(a.assetName));
        $('#ptDetSub').text(a.assetType + ' | ' + _ptFmt(an.lastTsDev) + ' (last activity)');
        $('#ptDetChip').html(statusChip);

        // Stat strip
        var devStr2 = an.maxDevSec !== null ? an.maxDevSec.toFixed(1) + 's' : '—';
        $('#ptDetStats').html(
            _detStat(an.totalEvents, 'Events', '#0e5068') +
            _detStat(an.pickups, '&#9650; Pickups', '#2e7d32') +
            _detStat(an.drops, '&#9660; Drops', '#c62828') +
            _detStat(an.attributes.length, 'Attributes', '#6b8c94') +
            _detStat(devStr2, 'Max Dev', an.hasWarn ? '#e65100' : '#2e7d32')
        );

        // Tabs
        var detTabs = [
            { id: 0, icon: 'fa-th', label: 'Deviation Matrix' },
            { id: 1, icon: 'fa-bolt', label: 'DL Events (' + an.dlEvents.length + ')' },
            { id: 2, icon: 'fa-list', label: 'All Attributes' },
            { id: 3, icon: 'fa-chart-line', label: 'Timeline Graph' }
        ];
        var tabHtml = '';
        detTabs.forEach(function (t) {
            tabHtml += '<button class="pt-tab' + (t.id === 0 ? ' active' : '') + '" onclick="_ptDetTab(' + t.id + ',this)"><i class="fa ' + t.icon + ' mr-1"></i>' + t.label + '</button>';
        });
        $('#ptDetTabBar').html(tabHtml);

        // Populate panes
        $('#ptDetPane0').html(_ptMatrix(an));
        $('#ptDetPane1').html(_ptDLList(an));
        $('#ptDetPane2').html(_ptAttrList(an));
        $('#ptDetPane3').html(_ptGraphShell(an));

        _ptDetShowPane(0);

        $('#ptDetailPopup').addClass('pt-vis');
    }

    function _detStat(val, lbl, color) {
        return '<div class="pt-det-stat"><div class="pt-stat-num" style="font-size:18px;color:' + color + ';">' + val + '</div><div class="pt-stat-lbl">' + lbl + '</div></div>';
    }

    function _ptDetTab(i, btn) {
        $('.pt-tabs .pt-tab').removeClass('active');
        $(btn).addClass('active');
        _ptDetShowPane(i);
        if (i === 3 && PT._detAn) {
            // Always render graph when tab is activated, default to deviation mode
            setTimeout(function () { _ptRenderGraph(PT._detAn); }, 50);
        }
    }

    function _ptDetShowPane(i) {
        for (var p = 0; p < 4; p++) $('#ptDetPane' + p).hide();
        $('#ptDetPane' + i).show();
    }

    // ══════════════════════════════════════════════════════════════
    //  PANE 0: DEVIATION MATRIX
    // ══════════════════════════════════════════════════════════════
    function _ptMatrix(an) {
        var mode = PT.matrixMode || 'all';
        var allEvs = mode === 'pickup' ? an.dlEvents.filter(function (e) { return e.type === 'Pickup'; })
            : mode === 'drop' ? an.dlEvents.filter(function (e) { return e.type === 'Drop'; })
                : an.dlEvents;
        var pickN = an.dlEvents.filter(function (e) { return e.type === 'Pickup'; }).length;
        var dropN = an.dlEvents.filter(function (e) { return e.type === 'Drop'; }).length;

        var excl = {};
        (PT.EXCLUDED_ATTRS || []).forEach(function (n) { excl[n] = true; });

        // Build cell map
        var cm = {};
        an.attrDevs.forEach(function (d) { cm[d.attrName + '_' + d.dlTsDev.getTime()] = d; });

        // Attribute order (DL first, sorted; then RDPMS sorted)
        var seenDL = [], seenRD = [];
        allEvs.forEach(function (ev) {
            an.attrDevs.filter(function (d) { return d.dlTsDev.getTime() === ev.tsDev.getTime(); }).forEach(function (d) {
                if (excl[d.attrName]) return;
                if (d.dlType === 'DataLogger' || (an.attributes.find && an.attributes.find(function (a) { return a.name === d.attrName && a.isDL; }))) {
                    if (seenDL.indexOf(d.attrName) < 0) seenDL.push(d.attrName);
                } else {
                    if (seenRD.indexOf(d.attrName) < 0) seenRD.push(d.attrName);
                }
            });
        });
        // Also include non-DL attributes that have any data for these events
        an.attributes.forEach(function (at) {
            if (excl[at.name] || at.isDL) return;
            var hasDev = allEvs.some(function (ev) { return cm[at.name + '_' + ev.tsDev.getTime()]; });
            if (hasDev && seenRD.indexOf(at.name) < 0) seenRD.push(at.name);
        });
        seenRD.sort(); seenDL.sort();
        var attrOrder = seenRD.concat(seenDL);

        // Last value per attribute
        var lastInfo = {};
        an.attributes.forEach(function (at) { lastInfo[at.name] = at; });

        var totalCols = allEvs.length + 5;

        // THEAD
        var thead = '<tr>';
        thead += '<th class="pt-mc-attr" style="text-align:left;min-width:155px;">ATTRIBUTE</th>';
        thead += '<th class="pt-mc-last" style="text-align:center;">LAST VALUE</th>';
        allEvs.forEach(function (ev, ci) {
            var isPick = ev.type === 'Pickup';
            var bg = isPick ? '#e8f5e9' : '#ffebee', fg = isPick ? '#2e7d32' : '#c62828', brd = isPick ? '#a5d6a7' : '#ef9a9a';
            var arrow = isPick ? '&#9650;' : '&#9660;';
            var tip = (ev.attrNames ? ev.attrNames.join(', ') : ev.attrName) + ' — ' + ev.type;
            var multi = ev.attrNames && ev.attrNames.length > 1 ? '<div style="font-size:8px;color:' + fg + ';opacity:.85;margin-top:2px;max-width:100px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="' + _esc(tip) + '">' + _esc(ev.attrNames.join(' + ')) + '</div>' : '';
            thead += '<th style="padding:5px 6px;text-align:center;min-width:108px;border-left:1px solid #145f78;" title="' + _esc(tip) + '">' +
                '<span style="display:inline-block;padding:1px 9px;border-radius:3px;font-size:9.5px;font-weight:700;background:' + bg + ';color:' + fg + ';border:1px solid ' + brd + ';">' + arrow + ' E' + (ci + 1) + '</span>' + multi + '</th>';
        });
        thead += '<th style="text-align:center;border-left:2px solid #145f78;color:#b8dde6;font-size:9px;font-weight:700;min-width:64px;">AVG</th>';
        thead += '<th style="text-align:center;color:#b8dde6;font-size:9px;font-weight:700;min-width:58px;">MIN</th>';
        thead += '<th style="text-align:center;color:#b8dde6;font-size:9px;font-weight:700;min-width:58px;">MAX</th>';
        thead += '</tr>';
        thead += '<tr class="pt-ts-row"><th class="pt-mc-attr" style="padding:2px 12px;font-size:9px;color:rgba(255,255,255,.38);">TimestampDevice (T)</th>';
        thead += '<th class="pt-mc-last" style="padding:2px 6px;font-size:9px;color:rgba(255,255,255,.38);text-align:center;">Most recent</th>';
        allEvs.forEach(function (ev) { thead += '<th style="padding:2px 5px;text-align:center;border-left:1px solid #0e5068;"><span class="pt-ts" style="font-size:9.5px;color:#7ab8c8;">' + _ptFmtShort(ev.tsDev) + '</span></th>'; });
        thead += '<th colspan="3" style="text-align:center;font-size:8.5px;color:rgba(255,255,255,.38);">across ' + allEvs.length + ' events (<span style="color:#86efac;">&#9650; ' + pickN + '</span> / <span style="color:#fca5a5;">&#9660; ' + dropN + '</span>)</th>';
        thead += '</tr>';

        // TBODY
        var tbody = '<tr><td colspan="' + totalCols + '" style="padding:5px 12px;background:rgba(34,211,238,.06);color:#22d3ee;font-weight:700;font-size:10px;letter-spacing:.4px;text-transform:uppercase;border-top:1px solid rgba(34,211,238,.25);border-bottom:1px solid rgba(255,255,255,.07);">' +
            '<span style="color:#34d399;">&#9650; PICKUP</span> &nbsp;+&nbsp; <span style="color:#f87171;">&#9660; DROP</span> &nbsp;&mdash;&nbsp; ' + allEvs.length + ' event' + (allEvs.length > 1 ? 's' : '') +
            '<span style="font-size:9px;font-weight:400;color:#888;margin-left:12px;text-transform:none;letter-spacing:0;">Deviation = Attr.TimestampDevice &minus; DL.TimestampDevice &nbsp;|&nbsp; nearest unique value shown per event &nbsp;|&nbsp; <span style="color:#f87171;">red = exceeded ' + PT.WARN_SEC + 's warn window</span></span>' +
            '</td></tr>';

        if (!attrOrder.length) {
            tbody += '<tr><td colspan="' + totalCols + '" style="text-align:center;padding:16px;color:rgba(255,255,255,.38);font-size:12px;">No attribute values found within 5 minutes of these events.</td></tr>';
        } else {
            attrOrder.forEach(function (atName, ri) {
                var rowHasNoData = allEvs.some(function (ev) { var c = cm[atName + '_' + ev.tsDev.getTime()]; return c && c.warn && (c.firstVal === null || c.firstVal === undefined); });
                var rowHasLate = allEvs.some(function (ev) { var c = cm[atName + '_' + ev.tsDev.getTime()]; return c && c.warn && c.firstVal !== null && c.firstVal !== undefined; });
                var rowStatus = rowHasNoData ? 'nodata' : (rowHasLate ? 'late' : 'ok');
                var isEven = ri % 2 === 0;
                var rowBg = rowHasNoData ? (isEven ? 'rgba(239,68,68,.08)' : 'rgba(239,68,68,.12)') : (rowHasLate ? (isEven ? 'rgba(245,158,11,.07)' : 'rgba(245,158,11,.10)') : (isEven ? 'rgba(255,255,255,.025)' : 'rgba(255,255,255,.04)'));
                var lastBg = rowHasNoData ? (isEven ? 'rgba(239,68,68,.10)' : 'rgba(239,68,68,.14)') : (rowHasLate ? (isEven ? 'rgba(245,158,11,.08)' : 'rgba(245,158,11,.12)') : (isEven ? 'rgba(15,22,45,.90)' : 'rgba(20,28,55,.92)'));

                tbody += '<tr data-attr="' + _esc(atName.toLowerCase()) + '" data-status="' + rowStatus + '">';
                tbody += '<td class="pt-mc-attr" style="background:' + rowBg + ';">' + _esc(atName) + '</td>';
                tbody += '<td class="pt-mc-last" style="background:' + lastBg + ';">' + _lastValHtml(lastInfo[atName]) + '</td>';

                allEvs.forEach(function (ev) {
                    var isPick = ev.type === 'Pickup';
                    var c = cm[atName + '_' + ev.tsDev.getTime()];
                    var cND = c && c.warn && (c.firstVal === null || c.firstVal === undefined);
                    var cLate = c && c.warn && c.firstVal !== null && c.firstVal !== undefined;
                    var cellBg = cND ? 'rgba(239,68,68,.08)' : (cLate ? 'rgba(245,158,11,.07)' : (isPick ? (isEven ? 'rgba(16,185,129,.05)' : 'rgba(16,185,129,.08)') : (isEven ? 'rgba(239,68,68,.04)' : 'rgba(239,68,68,.06)')));
                    tbody += '<td style="padding:3px 4px;border-left:1px solid rgba(255,255,255,.05);background:' + cellBg + ';vertical-align:middle;">' + _cellHtml(c, ev) + '</td>';
                });

                var st = _attrStats(atName, allEvs, cm);
                if (st) {
                    var avgClr = Math.abs(st.avg) > PT.WARN_SEC ? '#f87171' : (st.avg < 0 ? '#60a5fa' : '#34d399');
                    var maxClr = Math.abs(st.max) > PT.WARN_SEC ? '#f87171' : (st.max < 0 ? '#60a5fa' : '#34d399');
                    var minClr = st.min < 0 ? '#60a5fa' : (Math.abs(st.min) > PT.WARN_SEC ? '#f87171' : '#34d399');
                    tbody += '<td style="text-align:center;border-left:2px solid rgba(34,211,238,.15);padding:5px;background:' + rowBg + ';">' +
                        '<span style="font-family:JetBrains Mono,monospace;font-size:12px;font-weight:800;color:' + avgClr + ';">' + _fmtDev(st.avg) + '</span>' +
                        '<div style="font-size:8.5px;color:rgba(255,255,255,.38);">n=' + st.n + '</div></td>';
                    tbody += '<td style="text-align:center;padding:5px;background:' + rowBg + ';">' +
                        '<span style="font-family:JetBrains Mono,monospace;font-size:11px;color:' + minClr + ';">' + _fmtDev(st.min) + '</span></td>';
                    tbody += '<td style="text-align:center;padding:5px;background:' + rowBg + ';">' +
                        '<span style="font-family:JetBrains Mono,monospace;font-size:11px;font-weight:700;color:' + maxClr + ';">' + _fmtDev(st.max) + '</span></td>';
                } else {
                    tbody += '<td colspan="3" style="text-align:center;color:rgba(255,255,255,.22);background:' + rowBg + ';">—</td>';
                }
                tbody += '</tr>';
            });
        }

        var hiddenCount = 0; an.attributes.forEach(function (a) { if (excl[a.name]) hiddenCount++; });
        var hiddenNote = hiddenCount ? '<div style="padding:6px 14px;background:rgba(255,255,255,.02);border-top:1px solid rgba(255,255,255,.07);font-size:10px;color:rgba(255,255,255,.38);"><i class="fa fa-eye-slash mr-1" style="opacity:.6;"></i>' + hiddenCount + ' attribute' + (hiddenCount > 1 ? 's' : '') + ' hidden (' + _esc((PT.EXCLUDED_ATTRS || []).join(', ')) + ')</div>' : '';

        // ── View toolbar
        function tbBtn(val, lbl, color) {
            var active = mode === val, bg = active ? color : 'rgba(255,255,255,.08)', fg = active ? '#fff' : color, brd = active ? color : 'rgba(255,255,255,.15)';
            return '<button type="button" onclick="ptSetMatrixMode(\'' + val + '\')" style="padding:4px 12px;font-size:10.5px;font-weight:700;letter-spacing:.4px;text-transform:uppercase;background:' + bg + ';color:' + fg + ';border:1px solid ' + brd + ';border-radius:4px;cursor:pointer;transition:all .12s;">' + lbl + '</button>';
        }
        var matId = 'ptMx_' + Date.now();
        function _ptTbFilterBtn(id, status, label, bg, fg, brd) {
            return '<button type="button" id="' + id + '" onclick="ptMxRowFlt(\'' + matId + '\',\'' + status + '\')" ' +
                'style="padding:3px 10px;font-size:10.5px;font-weight:700;background:' + bg + ';color:' + fg + ';' +
                'border:1px solid ' + brd + ';border-radius:4px;cursor:pointer;">' + label + '</button>';
        }
        var toolbar =
            '<style>#ptDetPane0 .pt-matrix thead th{top:80px;}</style>' +
            '<div id="' + matId + '_bar" style="position:sticky;top:0;z-index:5;background:#0e5068;padding:7px 14px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">' +
            '<span style="font-size:10px;font-weight:700;color:#7ab8c8;text-transform:uppercase;letter-spacing:.5px;">Events:</span>' +
            tbBtn('all', 'All ' + an.dlEvents.length, '#1a7a96') +
            tbBtn('pickup', '&#9650; Pick ' + pickN, '#2e7d32') +
            tbBtn('drop', '&#9660; Drop ' + dropN, '#c62828') +
            '<div style="width:1px;height:20px;background:rgba(255,255,255,.2);margin:0 4px;"></div>' +
            '<span style="font-size:10px;font-weight:700;color:#7ab8c8;text-transform:uppercase;letter-spacing:.5px;">Rows:</span>' +
            _ptTbFilterBtn(matId + '_rAll', 'all', 'All', 'rgba(255,255,255,.10)', 'rgba(255,255,255,.80)', 'rgba(255,255,255,.20)') +
            _ptTbFilterBtn(matId + '_rOk', 'ok', '&#10003; OK', 'rgba(16,185,129,.12)', '#34d399', 'rgba(16,185,129,.30)') +
            _ptTbFilterBtn(matId + '_rLate', 'late', '&#9889; Late', 'rgba(239,68,68,.12)', '#f87171', 'rgba(239,68,68,.30)') +
            '<div style="width:1px;height:20px;background:rgba(255,255,255,.2);margin:0 4px;"></div>' +
            '<span style="font-size:10px;font-weight:700;color:#7ab8c8;text-transform:uppercase;letter-spacing:.5px;">Attr:</span>' +
            '<input id="' + matId + '_srch" type="text" placeholder="Search attribute..." ' +
            'oninput="ptMxRowFlt(\'' + matId + '\',null)" ' +
            'style="padding:3px 9px;border:1px solid rgba(255,255,255,.3);border-radius:4px;' +
            'background:rgba(255,255,255,.15);color:#fff;font-size:11px;font-family:JetBrains Mono,monospace;' +
            'outline:none;min-width:150px;" onclick="event.stopPropagation()">' +
            '<button type="button" onclick="ptMxRowFltReset(\'' + matId + '\')" ' +
            'style="padding:3px 8px;font-size:10px;background:rgba(255,255,255,.15);color:#b8dde6;' +
            'border:1px solid rgba(255,255,255,.25);border-radius:4px;cursor:pointer;">&#10005; Reset</button>' +
            '<span id="' + matId + '_cnt" style="font-size:10px;color:#7ab8c8;margin-left:auto;white-space:nowrap;">' + attrOrder.length + ' attrs</span>' +
            '</div>';

        return toolbar + (allEvs.length === 0
            ? '<div class="pt-empty"><div class="pt-empty-icon">&#128269;</div><div class="pt-empty-title">No ' + (mode === 'pickup' ? 'Pickup' : mode === 'drop' ? 'Drop' : '') + ' events</div><div style="font-size:12px;color:rgba(255,255,255,.38);">Switch to <strong>All</strong> to see the other event type.</div></div>'
            : '<style>#ptDetPane0 .pt-matrix thead th{top:46px;}</style>' +
            '<table class="pt-matrix" id="' + matId + '_tbl"><thead>' + thead + '</thead><tbody>' + tbody + '</tbody></table>' + hiddenNote
        );
    }

    function ptSetMatrixMode(mode) {
        if (mode !== 'all' && mode !== 'pickup' && mode !== 'drop') mode = 'all';
        if (PT.matrixMode === mode) return;
        PT.matrixMode = mode;
        if (PT._detAn) $('#ptDetPane0').html(_ptMatrix(PT._detAn));
    }

    var _ptMxFltState = {};
    function ptMxRowFlt(matId, statusOverride) {
        if (!_ptMxFltState[matId]) _ptMxFltState[matId] = { status: 'all', search: '' };
        var state = _ptMxFltState[matId];
        if (statusOverride !== null && statusOverride !== undefined) state.status = statusOverride;
        var srchEl = document.getElementById(matId + '_srch');
        state.search = srchEl ? srchEl.value.toLowerCase().trim() : '';
        var statusBtns = { all: { bg: 'rgba(255,255,255,.10)', fg: 'rgba(255,255,255,.80)', brd: 'rgba(255,255,255,.20)' }, ok: { bg: 'rgba(16,185,129,.12)', fg: '#34d399', brd: 'rgba(16,185,129,.30)' }, late: { bg: 'rgba(239,68,68,.12)', fg: '#f87171', brd: 'rgba(239,68,68,.30)' } };
        ['all', 'ok', 'late'].forEach(function (s) {
            var el = document.getElementById(matId + '_r' + (s === 'all' ? 'All' : s === 'ok' ? 'Ok' : 'Late'));
            if (!el) return;
            var active = state.status === s, st = statusBtns[s];
            el.style.background = active ? (s === 'all' ? 'rgba(34,211,238,.25)' : s === 'ok' ? 'rgba(16,185,129,.30)' : 'rgba(239,68,68,.30)') : st.bg;
            el.style.color = active ? '#fff' : st.fg;
            el.style.borderColor = active ? (s === 'all' ? 'rgba(34,211,238,.50)' : s === 'ok' ? 'rgba(16,185,129,.50)' : 'rgba(239,68,68,.50)') : st.brd;
        });
        var visCount = 0, totalCount = 0;
        $('#ptDetPane0 .pt-matrix').find('tbody tr[data-attr]').each(function () {
            var $tr = $(this), attrName = $tr.attr('data-attr') || '', rowStatus = $tr.attr('data-status') || 'ok';
            var matchSearch = !state.search || attrName.indexOf(state.search) >= 0;
            var matchStatus = state.status === 'all' || (state.status === 'ok' && rowStatus === 'ok') || (state.status === 'late' && (rowStatus === 'late' || rowStatus === 'nodata'));
            $tr.toggle(matchSearch && matchStatus); totalCount++;
            if (matchSearch && matchStatus) visCount++;
        });
        var cntEl = document.getElementById(matId + '_cnt');
        if (cntEl) cntEl.textContent = visCount + ' / ' + totalCount + ' attrs';
    }
    function ptMxRowFltReset(matId) {
        _ptMxFltState[matId] = { status: 'all', search: '' };
        var srchEl = document.getElementById(matId + '_srch');
        if (srchEl) srchEl.value = '';
        ptMxRowFlt(matId, 'all');
    }

    // ── Matrix helper: cell HTML ───────────────────────────────────
    function _cellHtml(c, dlEv) {
        if (!c) return '<span class="pt-cell-nil">&mdash;</span>';
        if (c.firstVal === null || c.firstVal === undefined) return '<span class="pt-cell-nil" title="No readings in analysis period">&mdash;</span>';

        var isPre = c.devSec !== null && c.devSec < 0;
        var devSign = c.devSec !== null ? (c.devSec < 0 ? '' : '+') : '';
        var devStr = c.devSec !== null ? devSign + c.devSec.toFixed(1) + 's' : '?s';
        var badgeColor, badgeBg, badgeBorder, badgeIcon, checkMark, badgeTitle;
        if (c.warn) {
            badgeColor = '#f87171'; badgeBg = 'rgba(239,68,68,.15)'; badgeBorder = 'rgba(239,68,68,.35)';
            badgeIcon = '&#9889; '; checkMark = ' &#9888;';
            badgeTitle = 'Responded ' + devStr + ' from DL event — exceeds warn window (' + PT.WARN_SEC + 's)';
        } else if (isPre) {
            badgeColor = '#60a5fa'; badgeBg = 'rgba(96,165,250,.12)'; badgeBorder = 'rgba(96,165,250,.30)';
            badgeIcon = ''; checkMark = ' &#10003;';
            badgeTitle = 'Pre-response: attribute changed ' + Math.abs(c.devSec).toFixed(1) + 's before DL event';
        } else {
            badgeColor = '#34d399'; badgeBg = 'rgba(16,185,129,.12)'; badgeBorder = 'rgba(16,185,129,.30)';
            badgeIcon = ''; checkMark = ' &#10003;';
            badgeTitle = 'Post-response: attribute changed ' + devStr + ' after DL event';
        }
        var badge = '<span style="display:inline-block;padding:1px 7px;border-radius:3px;font-size:10px;font-weight:700;background:' + badgeBg + ';color:' + badgeColor + ';border:1px solid ' + badgeBorder + ';" title="' + badgeTitle + '">' + badgeIcon + devStr + checkMark + '</span>';

        var prevHtml = '';
        if (c.lastKnownVal !== null && c.lastKnownVal !== undefined && String(c.lastKnownVal) !== String(c.firstVal)) {
            prevHtml = '<div style="margin-top:3px;padding:2px 4px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:4px;">' +
                '<div style="font-size:7.5px;color:rgba(255,255,255,.38);font-weight:700;text-transform:uppercase;letter-spacing:.4px;margin-bottom:1px;">Prev</div>' +
                '<div style="font-size:9.5px;color:rgba(255,255,255,.38);font-family:JetBrains Mono,monospace;">' + c.lastKnownVal + '</div>' +
                '<div style="font-size:8px;color:rgba(255,255,255,.28);font-family:JetBrains Mono,monospace;">' + (c.lastKnownTs ? _ptFmtMs(c.lastKnownTs) : '') + '</div></div>';
        }

        var cellContent = '<div style="text-align:center;padding:2px 0;">' + badge +
            '<div style="font-size:10.5px;font-weight:700;color:' + (c.warn ? '#f87171' : 'rgba(255,255,255,.90)') + ';margin-top:3px;font-family:\'JetBrains Mono\',monospace;">' + c.firstVal + '</div>' +
            '<div style="font-size:9px;color:' + (c.warn ? 'rgba(239,68,68,.60)' : 'rgba(255,255,255,.35)') + ';font-family:\'JetBrains Mono\',monospace;">' + _ptFmtMs(c.firstTs) + '</div>' + prevHtml + '</div>';

        // Tooltip
        var devClr = c.warn ? '#ff8a80' : (isPre ? '#64b5f6' : '#81c784');
        var ttRows = '';
        if (dlEv) {
            ttRows += '<div class="pt-tt-sep">DL Event</div>';
            ttRows += '<div class="pt-tt-row"><span class="pt-tt-lbl">Type</span><span class="pt-tt-val">' + (dlEv.type === 'Pickup' ? '&#9650; Pickup' : '&#9660; Drop') + '</span></div>';
            ttRows += '<div class="pt-tt-row"><span class="pt-tt-lbl">T DL TsDev</span><span class="pt-tt-val">' + _ptFmt(dlEv.tsDev) + '</span></div>';
            ttRows += '<div class="pt-tt-row"><span class="pt-tt-lbl">Window</span><span class="pt-tt-val">&minus;' + PT.PRE_WIN + 's &rarr; +' + PT.WARN_SEC + 's</span></div>';
        }
        ttRows += '<div class="pt-tt-sep" style="margin-top:4px;">Nearest Unique Value</div>';
        ttRows += '<div class="pt-tt-row"><span class="pt-tt-lbl">Value</span><span class="pt-tt-val" style="color:' + (c.warn ? '#ff8a80' : '#a5d6a7') + ';">' + c.firstVal + '</span></div>';
        ttRows += '<div class="pt-tt-row"><span class="pt-tt-lbl">TimestampDevice</span><span class="pt-tt-val">' + _ptFmt(c.firstTs) + '</span></div>';
        ttRows += '<div class="pt-tt-row"><span class="pt-tt-lbl">Deviation</span><span class="pt-tt-val" style="color:' + devClr + ';font-size:13px;">' + devStr + (c.warn ? ' ⚠' : ' ✓') + '</span></div>';
        if (c.lastKnownVal !== null && c.lastKnownVal !== undefined) {
            ttRows += '<div class="pt-tt-sep" style="margin-top:4px;">Previous Known</div>';
            ttRows += '<div class="pt-tt-row"><span class="pt-tt-lbl">Value</span><span class="pt-tt-val" style="color:#b0bec5;">' + c.lastKnownVal + '</span></div>';
            if (c.lastKnownTs) {
                ttRows += '<div class="pt-tt-row"><span class="pt-tt-lbl">TimestampDevice</span><span class="pt-tt-val" style="color:#90a4ae;">' + _ptFmt(c.lastKnownTs) + '</span></div>';
                var prevGap = ((c.firstTs.getTime() - c.lastKnownTs.getTime()) / 1000).toFixed(1);
                ttRows += '<div class="pt-tt-row"><span class="pt-tt-lbl">Gap from Prev</span><span class="pt-tt-val" style="color:#90a4ae;">+' + prevGap + 's</span></div>';
            }
        }
        var tooltip = '<div class="pt-tooltip">' + ttRows + '</div>';
        return '<div class="pt-tooltip-wrap" onmouseenter="ptTtPosition(this,event)" onmousemove="ptTtPosition(this,event)">' + cellContent + tooltip + '</div>';
    }

    function ptTtPosition(wrap, e) {
        var tt = $(wrap).find('.pt-tooltip')[0];
        if (!tt) return;
        var x = e.clientX + 14, y = e.clientY + 14;
        var tw = tt.offsetWidth, th = tt.offsetHeight;
        if (x + tw > window.innerWidth - 8) x = e.clientX - tw - 6;
        if (y + th > window.innerHeight - 8) y = e.clientY - th - 6;
