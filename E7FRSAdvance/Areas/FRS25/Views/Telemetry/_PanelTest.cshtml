                '<td style="padding:7px 12px;font-weight:700;color:rgba(255,255,255,.85);">' + _esc(attr.name) + (attr.isDL ? '<span class="pt-dl-tag">DL</span>' : '') + '</td>' +
                '<td style="padding:7px 8px;text-align:center;">' + (attr.isDL ? '<span class="pt-dl-tag">DataLogger</span>' : '<span class="pt-rdpms-tag">RDPMS</span>') + '</td>' +
