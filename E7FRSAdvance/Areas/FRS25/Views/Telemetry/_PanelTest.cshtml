            '<div id="ptGraphArea" style="flex:1;overflow-y:auto;overflow-x:hidden;padding:16px 16px 24px;background:rgba(255,255,255,.02);"><div style="text-align:center;padding:60px;color:rgba(255,255,255,.38);">Select a chart type above</div></div>' +
