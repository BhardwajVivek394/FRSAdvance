                    var c = cm[atName + '_' + ev.tsDev.getTime()];
                    return { x: xPx(i), dev: c && c.devSec !== null ? c.devSec : null, warn: c && c.warn ? 1 : 0, val: c ? c.firstVal : null, ts: c && c.firstTs ? _ptFmtMs(c.firstTs) : '', evTs: _ptFmtShort(ev.tsDev), evType: ev.type, evIdx: i + 1, prevVal: c && c.lastKnownVal !== null ? c.lastKnownVal : '—', prevTs: c && c.lastKnownTs ? _ptFmtMs(c.lastKnownTs) : '' };
                });
                var svg = '<svg viewBox="0 0 ' + chartW + ' ' + CH + '" width="' + chartW + '" height="' + CH + '" xmlns="http://www.w3.org/2000/svg">';
                svg += svgEl('rect', { x: 0, y: 0, width: chartW, height: CH, fill: 'rgba(10,15,36,0.95)' });
                svg += svgEl('line', { x1: PL, y1: yPx(PT.WARN_SEC), x2: PL + iW, y2: yPx(PT.WARN_SEC), stroke: '#f87171', 'stroke-width': 1.5, 'stroke-dasharray': '5 3', opacity: .8 });
                svg += svgEl('line', { x1: PL, y1: yPx(-PT.PRE_WIN), x2: PL + iW, y2: yPx(-PT.PRE_WIN), stroke: '#60a5fa', 'stroke-width': 1.5, 'stroke-dasharray': '5 3', opacity: .7 });
                svg += svgEl('line', { x1: PL, y1: yPx(0), x2: PL + iW, y2: yPx(0), stroke: 'rgba(255,255,255,.25)', 'stroke-width': 1.5 });
                var pathD = '', first = true;
                pts.forEach(function (p) {
                    if (p.dev === null) { first = true; return; }
                    var clampedDev = Math.max(yMin, Math.min(yMax, p.dev));
                    var yp = yPx(clampedDev);
                    pathD += (first ? 'M' : 'L') + p.x + ' ' + yp; first = false;
                });
                if (pathD) svg += svgEl('path', { d: pathD, fill: 'none', stroke: col, 'stroke-width': 2, 'stroke-linejoin': 'round' });
                pts.forEach(function (p) {
                    if (p.dev === null) {
                        svg += svgEl('circle', { cx: p.x, cy: yPx(0), r: 3, fill: '#ccc', stroke: '#fff', 'stroke-width': 1.5 }); return;
                    }
                    var clampedDev = Math.max(yMin, Math.min(yMax, p.dev));
                    var yp = yPx(clampedDev);
                    var dotCol = p.warn ? '#c62828' : col;
                    var tipData = JSON.stringify({ attr: atName, dev: fD(p.dev), warn: p.warn, val: p.val, ts: p.ts, evTs: p.evTs, evType: p.evType, evIdx: p.evIdx, prevVal: p.prevVal, prevTs: p.prevTs, col: dotCol });
                    svg += svgEl('circle', { cx: p.x, cy: yp, r: 4, fill: dotCol, stroke: '#fff', 'stroke-width': 1.5, 'data-pt': tipData, 'class': 'pt-gdot', 'style': 'cursor:crosshair;' });
                    if (N <= 40) svg += svgEl('text', { x: p.x, y: yp - 7, fill: dotCol, 'font-size': 7.5, 'font-weight': '700', 'text-anchor': 'middle', 'pointer-events': 'none' }, escSvg(fD(p.dev)));
