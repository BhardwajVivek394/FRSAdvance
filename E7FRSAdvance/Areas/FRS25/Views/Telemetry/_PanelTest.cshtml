        586: { name: 'VTC VAR RES', max: 4.7, avg: 2.7, min: 0.5, fail: null },
        587: { name: 'RTC CH FEED END', max: 7.2, avg: 2.86, min: 1.2, fail: null },
        588: { name: 'RTC VAR RES', max: 18.8, avg: 11, min: 1, fail: null },
        589: { name: 'RTC CH RELAY END', max: 17, avg: 2.86, min: 0.75, fail: null },
        590: { name: 'RRAIL', max: 6.67, avg: 5.71, min: 0.75, fail: null },
        591: { name: 'VTC CH RELAY END', max: 3.4, avg: 1, min: 0.3, fail: null }
    };

    function _ptRangeCheck(attrId, rawVal) {
        var cfg = PT_RANGE[attrId] || PT_RANGE[String(attrId)];
        var out = { status: 'ok', max: null, min: null, fail: null, avg: null, cfg: !!cfg };
        if (!cfg) return out;
        out.max = cfg.max; out.min = cfg.min; out.fail = cfg.fail; out.avg = cfg.avg;
        var val = parseFloat(rawVal);
        if (isNaN(val)) return out;
        if (cfg.fail !== null && val < cfg.fail) { out.status = 'fail'; return out; }
        if (cfg.max !== null && val > cfg.max) { out.status = 'fail'; return out; }
        if (cfg.min !== null && val < cfg.min) { out.status = 'warn'; return out; }
        return out;
    }

    // ── Core state ─────────────────────────────────────────────────
    var PT = {
        API: '/Telemetry/GetHistoryData',
        WARN_SEC: 10,
        PRE_WIN: 5,
        EXCLUDED_ATTRS: ['ITC TFC O/P(mA)', 'VTC TFC I/P(V)', 'VTC TFC O/P(V)'],
        matrixMode: 'all',
        _detAn: null,
        attrMap: {},
        attrByType: {},
        attrReady: false,
        dlMap: {},
        dlReady: false,
        data: {},
        assets: [],
        allKnownAssets: {},
        _typesLoaded: false,
        _cachedTypeData: null,
        _typesFetched: {},
        _selectedAssets: {},
        _lastSiteId: null,
        startMs: 0, endMs: 0,
        startFmt: '', endFmt: ''
    };

    // ── Helpers ────────────────────────────────────────────────────
    function _ptNow() { return new Date(); }
    function _ptLocalIso(d) {
        var p = function (n) { return String(n).padStart(2, '0'); };
        return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate())
            + 'T' + p(d.getHours()) + ':' + p(d.getMinutes());
    }
    function _ptToApiDate(localVal, isStart) {
        if (!localVal) return null;
        var d = new Date(localVal);
        if (isNaN(d.getTime())) return null;
        if (!isStart) d.setSeconds(59); else d.setSeconds(0);
        var p = function (n) { return String(n).padStart(2, '0'); };
        return p(d.getDate()) + p(d.getMonth() + 1) + d.getFullYear()
            + '_' + p(d.getHours()) + p(d.getMinutes()) + p(d.getSeconds());
    }
    function _ptToMs(v) { var d = new Date(v); return isNaN(d.getTime()) ? 0 : d.getTime(); }
    function _ptFmtDtLocal(v) {
        var d = new Date(v); if (isNaN(d.getTime())) return v;
        var p = function (n) { return String(n).padStart(2, '0'); };
        return p(d.getDate()) + '/' + p(d.getMonth() + 1) + '/' + d.getFullYear() + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
    }
    function _ptMs(d) { return String(d.getMilliseconds()).padStart(3, '0'); }
    function _ptFmt(d) {
        if (!d || isNaN(d.getTime())) return '—';
        var p = function (n) { return String(n).padStart(2, '0'); };
        return p(d.getDate()) + '/' + p(d.getMonth() + 1) + '/' + d.getFullYear() + ' ' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
    }
    function _ptFmtShort(d) {
        if (!d || isNaN(d.getTime())) return '';
        var p = function (n) { return String(n).padStart(2, '0'); };
        return p(d.getDate()) + '/' + p(d.getMonth() + 1) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
    }
    function _ptFmtTime(d) {
        if (!d || isNaN(d.getTime())) return '';
        var p = function (n) { return String(n).padStart(2, '0'); };
        return p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
    }
    function _ptFmtMs(d) {
        if (!d || isNaN(d.getTime())) return '';
        var p = function (n) { return String(n).padStart(2, '0'); };
        return p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds()) + '.' + _ptMs(d);
    }
    function _ptXFmt(d) {  // for Excel export
        if (!d || isNaN(d.getTime())) return '';
        var p = function (n) { return String(n).padStart(2, '0'); };
        return p(d.getDate()) + '/' + p(d.getMonth() + 1) + '/' + d.getFullYear() + ' ' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
    }
    function _esc(s) {
        return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function _escJs(s) { return String(s || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'"); }

    // ── Attribute name lookup ──────────────────────────────────────
    function _ptName(id, isDL, assetTypeId) {
        if (isDL) {
            var dn = PT.dlMap[id] || PT.dlMap[String(id)] || PT.dlMap[parseInt(id)];
            if (dn) return dn;
        }
        var n = PT.attrMap[id] || PT.attrMap[String(id)];
        if (n) return n;
        if (assetTypeId && PT.attrByType[assetTypeId]) {
            n = PT.attrByType[assetTypeId][id] || PT.attrByType[assetTypeId][String(id)];
            if (n) return n;
        }
        return isDL ? 'DL-' + id : 'Attr-' + id;
    }

    // ── Legend refresh ─────────────────────────────────────────────
    function ptUpdateLegend() {
        var w = parseFloat($('#ptWarnSec').val()) || 10;
        if (w < 1) { w = 1; $('#ptWarnSec').val(1); }
        $('#ptLegWarn,#ptLegWin').text(w);
        $('#ptLegPre').text(PT.PRE_WIN);
        PT.WARN_SEC = w;
    }

    // ── Quick range ────────────────────────────────────────────────
    function ptApplyQuickRange() {
        var h = parseInt($('#ptQuickRange').val());
        if (!h) return;
        var now = _ptNow();
        $('#ptFromDt').val(_ptLocalIso(new Date(now.getTime() - h * 3600 * 1000)));
        $('#ptToDt').val(_ptLocalIso(now));
    }

    // ══════════════════════════════════════════════════════════════
    //  OPEN / CLOSE
    // ══════════════════════════════════════════════════════════════

    // Entry point — called by the Panel Test button in the filter bar
    function _ptOpenFromTelemetryLive() {
        // Read siteId and site label from the Telemetry Live filter bar
        var siteId = $.trim($('#drpSite').val() || '');
        var siteName = $.trim($('#drpSite option:selected').text() || siteId || '—');

        // Mirror into the site info display inside the popup
        $('#ptSiteDisplay').text(siteName || '—');

        // Default date range: last 2 hours → now
        var now = _ptNow();
        var from = new Date(now.getTime() - 2 * 3600 * 1000);
        $('#ptToDt').val(_ptLocalIso(now));
        $('#ptFromDt').val(_ptLocalIso(from));
        $('#ptWarnSec').val(PT.WARN_SEC);
        $('#ptQuickRange').val('');
        ptUpdateLegend();

        // Live badge
        var liveCount = window.wsLiveData ? Object.keys(window.wsLiveData).length : 0;
        if (liveCount > 0) {
            $('#ptLiveBadge').show();
            $('#ptsLiveBox').show();
            $('#ptsLive').text(liveCount);
        } else {
            $('#ptLiveBadge').hide();
            $('#ptsLiveBox').hide();
        }

        // Show popup
        $('#ptOverlay').addClass('pt-vis');
        $('#ptPopup').addClass('pt-vis');
        $('#ptDetailPopup').removeClass('pt-vis');

        // Reset result UI
        $('#ptStatStrip,#ptTabBar,#ptFooterBar').hide();
        $('#ptExportBtn').hide();
        $('#ptTotals,#ptRangeBadge').text('');
        $('#ptHdrSub').text('Select a date range and click Run Analysis');

        // Site change detection
        var siteChanged = PT._lastSiteId && PT._lastSiteId !== siteId;
        if (siteChanged) {
            PT._typesLoaded = false;
            PT._cachedTypeData = null;
            PT._typesFetched = {};
            PT.allKnownAssets = {};
            PT.dlReady = false;
            PT.dlMap = {};
        }
        PT._lastSiteId = siteId;

        if (!PT._typesLoaded || siteChanged) ptResetAssetMultiSelect();

        _ptLoadAssetTypes(siteId);
        _ptShowIdle();
    }

    // Keep legacy alias so any other callers still work
    var fnOpenPanelTest = _ptOpenFromTelemetryLive;

    function ptClose() {
        $('#ptOverlay').removeClass('pt-vis');
        $('#ptPopup,#ptDetailPopup').removeClass('pt-vis pt-fullscreen');
        // Reset fullscreen button icons
        $('#ptFsBtn,#ptDetFsBtn').each(function () {
            $(this).find('i').removeClass('fa-compress').addClass('fa-expand');
            $(this).find('span').text('Fullscreen');
        });
    }

    function ptCloseDetail() {
        $('#ptDetailPopup').removeClass('pt-vis pt-fullscreen');
        var $b = $('#ptDetFsBtn');
        $b.find('i').removeClass('fa-compress').addClass('fa-expand');
        $b.find('span').text('Fullscreen');
    }

    function ptToggleFullscreen(popupId, btn) {
        var $p = $('#' + popupId);
        var isFs = $p.toggleClass('pt-fullscreen').hasClass('pt-fullscreen');
        var $btn = $(btn);
        $btn.find('i').toggleClass('fa-expand', !isFs).toggleClass('fa-compress', isFs);
        $btn.find('span').text(isFs ? 'Exit Fullscreen' : 'Fullscreen');
        $btn.attr('title', isFs ? 'Exit Fullscreen (Esc)' : 'Toggle Fullscreen');
