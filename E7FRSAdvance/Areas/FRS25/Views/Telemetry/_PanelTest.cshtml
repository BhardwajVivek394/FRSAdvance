            '<span style="font-size:10px;font-weight:700;color:#7ab8c8;text-transform:uppercase;letter-spacing:.6px;">Chart:</span>' +
            ['deviation|&#9654; Deviation (s)', 'timestamps|&#128336; Prev vs Current TsDev', 'values|&#128200; Attribute Values'].map(function (s) {
