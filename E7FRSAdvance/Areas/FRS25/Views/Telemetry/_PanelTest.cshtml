    /* ── Deviation matrix ── */
    .pt-matrix {
        width: 100%;
        border-collapse: collapse;
        font-size: 11.5px;
    }

        .pt-matrix thead th {
            background: rgba(14,21,40,.95);
            color: rgba(34,211,238,.80);
            padding: 7px 10px;
            font-size: 9.5px;
            font-weight: 700;
            letter-spacing: .6px;
            text-transform: uppercase;
            border-bottom: 2px solid rgba(34,211,238,.25);
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 2;
        }

            .pt-matrix thead th.pt-mc-attr {
                position: sticky;
                left: 0;
                z-index: 3;
                min-width: 155px;
                background: rgba(14,21,40,.98);
                border-right: 2px solid rgba(34,211,238,.20);
            }

            .pt-matrix thead th.pt-mc-last {
                position: sticky;
                left: 155px;
                z-index: 3;
                min-width: 120px;
                background: rgba(14,21,40,.98);
                border-right: 2px solid rgba(34,211,238,.20);
            }

        .pt-matrix thead tr.pt-ts-row th {
            background: rgba(8,12,28,.98);
            padding: 2px 5px;
        }

            .pt-matrix thead tr.pt-ts-row th.pt-mc-attr,
            .pt-matrix thead tr.pt-ts-row th.pt-mc-last {
                background: rgba(8,12,28,.98);
            }

        .pt-matrix tbody td {
            padding: 5px 8px;
            border-bottom: 1px solid rgba(255,255,255,.05);
            vertical-align: middle;
            background: rgba(255,255,255,.02);
            color: rgba(255,255,255,.75);
        }

            .pt-matrix tbody td.pt-mc-attr {
                position: sticky;
                left: 0;
                z-index: 1;
                background: rgba(15,20,40,.95);
                border-right: 2px solid rgba(255,255,255,.07);
                font-weight: 700;
                color: rgba(255,255,255,.85);
                white-space: nowrap;
            }

            .pt-matrix tbody td.pt-mc-last {
