            '<div class="pt-prog-bar"><div class="pt-prog-fill" id="ptProgFill" style="width:' + pct + '%;"></div></div>' +
            '<div class="pt-prog-sub" id="ptProgSub"></div></div>');
    }
    function _ptShowEmpty(msg) {
        $('#ptPopupBody').html('<div class="pt-empty">' +
            '<div class="pt-empty-icon">&#128451;</div>' +
            '<div class="pt-empty-title">No assets found</div>' +
            '<div style="font-size:12px;color:rgba(255,255,255,.38);">' + msg + '</div></div>');
    }

    // ══════════════════════════════════════════════════════════════
    //  EXCEL + CSV EXPORT
    // ══════════════════════════════════════════════════════════════
    function _ptDlStart() { $('#ptDownloadProgress').css('display', 'flex'); }
    function _ptDlMsg(m) { $('#ptDownloadMsg').text(m); }
    function _ptDlDone() { $('#ptDownloadProgress').hide(); }

    function _ptExportCSV() {
        _ptDlStart(); _ptDlMsg('Building CSV…');
        setTimeout(function () {
            try {
                var rows = [['Asset', 'Asset Type', 'DL Attribute', 'Event Type', 'T_DL', 'Attribute', 'Source', 'Status', 'Value', 'TimestampDevice', 'Deviation (s)', 'Prev Value', 'Prev TsDev']];
                PT.assets.forEach(function (a) {
                    var r = PT.data[a.assetId]; if (!r || !r.analysis) return;
                    var an = r.analysis;
                    an.attrDevs.forEach(function (d) {
                        var isPre = d.devSec !== null && d.devSec < -0;
                        var st = d.warn ? 'LATE' : (d.firstVal === null ? 'NO DATA' : (isPre ? 'PRE' : 'OK'));
                        rows.push([
                            a.assetName, a.assetType,
                            d.dlAttr, d.dlType, _ptXFmt(d.dlTsDev),
                            d.attrName, d.attrId,
                            st,
                            d.firstVal !== null && d.firstVal !== undefined ? d.firstVal : '',
                            d.firstTs ? _ptXFmt(d.firstTs) : '',
                            d.devSec !== null ? d.devSec.toFixed(2) : '',
                            d.lastKnownVal !== null && d.lastKnownVal !== undefined ? d.lastKnownVal : '',
                            d.lastKnownTs ? _ptXFmt(d.lastKnownTs) : ''
                        ]);
                    });
                });
                var csv = rows.map(function (r) { return r.map(function (c) { var s = String(c == null ? '' : c); return /[,"\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; }).join(','); }).join('\r\n');
                var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                saveAs(blob, 'PanelTest_' + (PT.startFmt || 'export') + '.csv');
                _ptDlDone();
                CommonNotification('SUCCESS', 'CSV downloaded.', 'success');
            } catch (err) { _ptDlDone(); CommonNotification('ERROR', 'CSV export failed: ' + err.message, 'error'); }
        }, 60);
    }

    function _ptExportExcel() {
        _ptDlStart(); _ptDlMsg('Preparing Excel…');
        setTimeout(function () {
            try {
                var ExcelJS = window.ExcelJS; if (!ExcelJS) throw new Error('ExcelJS not loaded');
                var wb = new ExcelJS.Workbook();
                wb.creator = 'PanelTest'; wb.created = new Date();
                var HDR_FILL = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF0E5068' } };
                var HDR_FONT = { bold: true, color: { argb: 'FFB8DDE6' }, size: 10 };
                var OK_FILL = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFD1FAE5' } };
                var OK_FONT = { bold: true, color: { argb: 'FF065F46' } };
                var WARN_FILL = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFEF3C7' } };
                var WARN_FONT = { bold: true, color: { argb: 'FF92400E' } };
                var PK_FILL = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFF0FFF4' } };
                var DR_FILL = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFF0F0' } };
                var PRE_FILL = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFE0F2FE' } };
                var PRE_FONT = { bold: true, color: { argb: 'FF0369A1' } };
                function addTitle(ws, title, cols) { ws.mergeCells(1, 1, 1, cols); var r = ws.getRow(1); r.getCell(1).value = title; r.getCell(1).font = { bold: true, size: 13, color: { argb: 'FF0E5068' } }; r.getCell(1).fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFE6F2F5' } }; r.height = 22; ws.addRow([]); }
                function applyHdr(r) { r.eachCell(function (c) { c.fill = HDR_FILL; c.font = HDR_FONT; c.alignment = { vertical: 'middle', horizontal: 'center' }; }); r.height = 20; }
                // Sheet 1 — Summary
                _ptDlMsg('Building Summary…');
                var ws1 = wb.addWorksheet('Summary');
                ws1.columns = [{ width: 22 }, { width: 12 }, { width: 10 }, { width: 10 }, { width: 10 }, { width: 10 }, { width: 14 }, { width: 12 }];
                addTitle(ws1, 'Panel Test — Summary', 8);
                var h1 = ws1.addRow(['Asset', 'Asset Type', 'Total Events', 'Pickups', 'Drops', 'Max Dev (s)', 'Status', 'Range']);
                applyHdr(h1);
                ws1.views = [{ state: 'frozen', ySplit: 3 }];
                PT.assets.forEach(function (a) {
                    var r = PT.data[a.assetId]; if (!r || !r.analysis) return;
                    var an = r.analysis;
                    var st = an.hasRangeFail ? 'FAIL' : (an.hasWarn || an.hasRangeWarn ? 'WARN' : 'OK');
                    var rng = an.hasRangeFail ? 'FAIL' : (an.hasRangeWarn ? 'WARN' : 'OK');
                    var row = ws1.addRow([a.assetName, a.assetType, an.totalEvents, an.pickups, an.drops, an.maxDevSec !== null ? +an.maxDevSec.toFixed(2) : null, st, rng]);
                    var stCell = row.getCell(7);
                    if (st === 'FAIL') { stCell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFFFEBEE' } }; stCell.font = { bold: true, color: { argb: 'FFC62828' } }; }
                    else if (st === 'WARN') { stCell.fill = WARN_FILL; stCell.font = { bold: true, color: { argb: 'FFE65100' } }; }
                    else { stCell.fill = OK_FILL; stCell.font = OK_FONT; }
                    row.eachCell(function (c) { c.alignment = { vertical: 'middle', horizontal: 'center' }; });
                    row.getCell(1).alignment = { horizontal: 'left' };
                });
                // Sheet 2 — Deviations
                _ptDlMsg('Building Deviations…');
                var ws2 = wb.addWorksheet('Deviations');
                ws2.columns = [{ width: 22 }, { width: 12 }, { width: 22 }, { width: 10 }, { width: 24 }, { width: 22 }, { width: 10 }, { width: 14 }, { width: 10 }, { width: 14 }, { width: 14 }];
                addTitle(ws2, 'Panel Test — Deviations', 11);
                var h2 = ws2.addRow(['Asset', 'Asset Type', 'DL Attribute', 'Event Type', 'T_DL (TsDev)', 'Attribute', 'Source', 'Status', 'Value', 'T_Attr (TsDev)', 'Deviation (s)', 'Prev Value', 'Prev TsDev']);
                applyHdr(h2);
                ws2.views = [{ state: 'frozen', ySplit: 3 }];
                PT.assets.forEach(function (a) {
                    var r = PT.data[a.assetId]; if (!r || !r.analysis) return;
                    var an = r.analysis;
                    an.attrDevs.forEach(function (d) {
                        var isPre = d.devSec !== null && d.devSec < 0;
                        var st = d.warn ? 'LATE' : (d.firstVal === null || d.firstVal === undefined ? 'NO DATA' : (isPre ? 'PRE' : 'OK'));
                        var row = ws2.addRow([a.assetName, a.assetType, d.dlAttr, d.dlType, _ptXFmt(d.dlTsDev), d.attrName, d.attrId, st, d.firstVal !== null && d.firstVal !== undefined ? d.firstVal : '', d.firstTs ? _ptXFmt(d.firstTs) : '', d.devSec !== null ? +d.devSec.toFixed(2) : '', d.lastKnownVal !== null && d.lastKnownVal !== undefined ? d.lastKnownVal : '', d.lastKnownTs ? _ptXFmt(d.lastKnownTs) : '']);
                        var stCell = row.getCell(8);
                        if (d.warn) { stCell.fill = WARN_FILL; stCell.font = { bold: true, color: { argb: 'FFE65100' } }; }
                        else if (isPre) { stCell.fill = PRE_FILL; stCell.font = PRE_FONT; }
                        else { stCell.fill = OK_FILL; stCell.font = OK_FONT; }
                        row.eachCell(function (c) { c.alignment = { vertical: 'middle', horizontal: 'center' }; });
                        row.getCell(1).alignment = { horizontal: 'left' };
                    });
                });
                // Sheet 3 — DL Events
                _ptDlMsg('Building DL Events…');
                var ws3 = wb.addWorksheet('DL Events');
                ws3.columns = [{ width: 22 }, { width: 12 }, { width: 22 }, { width: 10 }, { width: 8 }, { width: 24 }, { width: 14 }, { width: 10 }];
                addTitle(ws3, 'Panel Test — DataLogger Events', 8);
                var h3 = ws3.addRow(['Asset', 'Asset Type', 'DL Attribute(s)', 'Event Type', 'Value', 'TimestampDevice (T_DL)', 'Attrs Responded', 'Warned']);
                applyHdr(h3);
                ws3.views = [{ state: 'frozen', ySplit: 3 }];
                PT.assets.forEach(function (a) {
                    var r = PT.data[a.assetId]; if (!r || !r.analysis) return;
                    var an = r.analysis;
                    an.dlEvents.forEach(function (ev) {
                        var T = ev.tsDev.getTime();
                        var res = an.attrDevs.filter(function (d) { return d.dlTsDev.getTime() === T; });
                        var row = ws3.addRow([a.assetName, a.assetType, (ev.attrNames || [ev.attrName]).join(', '), ev.type, ev.value !== undefined ? ev.value : '', _ptXFmt(ev.tsDev), res.filter(function (d) { return !d.warn; }).length, res.filter(function (d) { return d.warn; }).length]);
                        row.eachCell(function (c) { c.fill = ev.type === 'Pickup' ? PK_FILL : DR_FILL; c.alignment = { vertical: 'middle', horizontal: 'center' }; });
                        row.getCell(1).alignment = { horizontal: 'left' };
                        row.getCell(4).font = { bold: true, color: { argb: ev.type === 'Pickup' ? 'FF2E7D32' : 'FFC62828' } };
                    });
                });
                // Sheet 4 — Attribute Values
                _ptDlMsg('Building Attribute Values…');
                var ws4 = wb.addWorksheet('Attribute Values');
                ws4.columns = [{ width: 22 }, { width: 12 }, { width: 22 }, { width: 12 }, { width: 14 }, { width: 22 }, { width: 14 }, { width: 14 }, { width: 10 }];
                addTitle(ws4, 'Panel Test — Attribute Values Snapshot', 9);
                var h4 = ws4.addRow(['Asset', 'Asset Type', 'Attribute', 'Source', 'Last Value', 'Last TimestampDevice', 'Values in Period', 'Max Deviation (s)', 'Status']);
                applyHdr(h4);
                ws4.views = [{ state: 'frozen', ySplit: 3 }];
                PT.assets.forEach(function (a) {
                    var r = PT.data[a.assetId]; if (!r || !r.analysis) return;
                    var an = r.analysis;
                    an.attributes.forEach(function (attr) {
                        var myD = an.attrDevs.filter(function (d) { return d.attrId === attr.attrId; });
                        var warnD = myD.filter(function (d) { return d.warn; });
                        var okD = myD.filter(function (d) { return !d.warn && d.devSec !== null; });
                        var hasWarn = warnD.length > 0;
                        var allNoData = warnD.length > 0 && warnD.every(function (d) { return d.firstVal === null || d.firstVal === undefined; });
                        var mxOk = okD.length ? Math.max.apply(null, okD.map(function (d) { return Math.abs(d.devSec); })) : null;
                        var mxWarn = warnD.filter(function (d) { return d.devSec !== null; }).length ? Math.max.apply(null, warnD.filter(function (d) { return d.devSec !== null; }).map(function (d) { return Math.abs(d.devSec); })) : null;
                        var mxAll = [mxOk, mxWarn].filter(function (v) { return v !== null; });
                        var mxFinal = mxAll.length ? Math.max.apply(null, mxAll) : null;
                        var mxSt = myD.length === 0 ? '—' : allNoData ? 'NO DATA' : hasWarn ? 'LATE' : 'OK';
                        var row = ws4.addRow([a.assetName, a.assetType, attr.name, attr.isDL ? 'DataLogger' : 'RDPMS', attr.lastValue !== null && attr.lastValue !== undefined ? attr.lastValue : '', _ptXFmt(attr.lastTsDev), attr.vals.length, mxFinal !== null ? +mxFinal.toFixed(2) : '', mxSt]);
                        if (hasWarn) { row.getCell(9).fill = WARN_FILL; row.getCell(9).font = { bold: true, color: { argb: 'FFE65100' } }; }
                        else if (mxSt === 'OK') { row.getCell(9).fill = OK_FILL; row.getCell(9).font = OK_FONT; }
                        row.eachCell(function (c) { c.alignment = { vertical: 'middle', horizontal: 'center' }; });
                        row.getCell(1).alignment = { horizontal: 'left' };
                        row.getCell(3).alignment = { horizontal: 'left' };
                    });
                });
                // Write
                _ptDlMsg('Saving .xlsx…');
                var fname = 'PanelTest_' + (PT.startFmt || 'export') + '.xlsx';
                wb.xlsx.writeBuffer().then(function (buffer) {
                    saveAs(new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), fname);
                    _ptDlDone();
                    CommonNotification('SUCCESS', 'Excel downloaded — 4 sheets.', 'success');
                }).catch(function (err) { _ptDlDone(); CommonNotification('ERROR', 'Excel write failed: ' + err.message, 'error'); });
            } catch (err) { _ptDlDone(); CommonNotification('ERROR', 'Excel export failed: ' + err.message, 'error'); }
        }, 60);
    }

