                    }
                    if (aRWKRLocVal != null) {
                        $.each(parseJson.cells, function (id, val) {
                            if ('label' in val.attrs && 'text' in val.attrs.label) {

                                if (val.type == "examples.Label") {
                                    if ($.trim(val.attrs.label.text).includes($.trim('A End - RWKR (Loc)')) || $.trim(val.attrs.label.text).includes($.trim('(A)RWKR(LOC):'))) {
                                        val.attrs.label.fill = "#e2e8f0";
                                        val.attrs.label.text = "(A)RWKR(LOC):" + aRWKRLocVal;
                                    }
                                }
                            }
                        });

                    }
                    if (bNWKRLocVal != null) {
                        $.each(parseJson.cells, function (id, val) {
                            if ('label' in val.attrs && 'text' in val.attrs.label) {

                                if (val.type == "examples.Label") {
