                    }
                    if (bRWKRVal != null) {

                        $.each(parseJson.cells, function (id, val) {
                            if ('label' in val.attrs && 'text' in val.attrs.label) {

                                if (val.type == "examples.Label") {
                                    if ($.trim(val.attrs.label.text) == $.trim('B End - RWKR') || $.trim(val.attrs.label.text).startsWith($.trim('(B)RWKR:'))) {
                                        val.attrs.label.fill = "#e2e8f0";
                                        val.attrs.label.text = "(B)RWKR:" + bRWKRVal;
                                    }
                                }

                            }
                        });
                    }

                    if (aNWKRLocVal != null) {
                        $.each(parseJson.cells, function (id, val) {
                            if ('label' in val.attrs && 'text' in val.attrs.label) {

                                if (val.type == "examples.Label") {
