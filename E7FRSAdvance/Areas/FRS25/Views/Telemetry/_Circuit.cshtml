    function BindCircuitPointSimulation(basePath, data) {
        // setTimeout removed — was for MQTT polling delay, not needed with WebSocket
        (function () {

            var d = new Date();
            var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
            $("#circuitDiagramLiveTimeStamp").html('Last Update: ' + time);

            if (parseJson != null && parseJson != undefined && parseJson != '') {
                var item = assetJson;
// debugger; // REMOVED: was pausing execution in production
                if (item.assetAttributes != null && item.assetAttributes.length > 0) {

                    // ---------------------------------------------------------------
                    // Read NWKR/RWKR analog values from window.circuitPmAnalog bridge.
                    // This is built by Index.cshtml from wsAttrs directly by AttrId,
                    // which is reliable. The old data[AssetInfoValue] approach failed
                    // because AssetInfoValue indices don't align with RDPMS attrs.
                    // ---------------------------------------------------------------
                    var _pa = window.circuitPmAnalog || {};
                    var _getVal = function(bridgeVal, dataFallback) {
                        // Use bridge value if valid and non-NaN
                        if (bridgeVal !== null && bridgeVal !== undefined && !isNaN(bridgeVal)) {
                            return parseFloat(bridgeVal).toFixed(2);
                        }
                        // Fallback to dataArray-derived value
                        if (dataFallback !== null && dataFallback !== undefined && !isNaN(parseFloat(dataFallback))) {
                            return parseFloat(dataFallback).toFixed(2);
                        }
                        return null;
                    };

                    // Legacy dataArray values (kept as fallback)
                    var _legacyNWKRA = null, _legacyRWKRA = null, _legacyNWKRB = null, _legacyRWKRB = null;
                    var _legacyNWKRALoc = null, _legacyRWKRALoc = null, _legacyNWKRBLoc = null, _legacyRWKRBLoc = null;

                    $.each(item.assetAttributes, function (idx, inItem) {
                        var str1 = basePath.toLowerCase();
                        var str2 = "";
                        if (inItem.AssetInfoChannel != null && inItem.AssetInfoChannel != "") {
                            str2 = inItem.AssetInfoChannel;
                        }
                        if (str2 == null || str2 == "" || str1.indexOf(str2) != -1) {
                            var infoValue = inItem.AssetInfoValue;
                            var infoMultiplication = inItem.Multiplication;
                            if (infoValue != null && infoMultiplication != null) {
                                var dataValue = data[infoValue];
                                if (dataValue !== undefined && dataValue !== null) {
                                    var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                    if (!isNaN(mainData)) {
                                        var v = ((mainData * 100) / 100).toFixed(2);
                                        if (inItem.Title == "A End - NWKR")       _legacyNWKRA = v;
                                        else if (inItem.Title == "B End - NWKR")  _legacyNWKRB = v;
                                        else if (inItem.Title == "A End - RWKR")  _legacyRWKRA = v;
                                        else if (inItem.Title == "B End - RWKR")  _legacyRWKRB = v;
                                        else if (inItem.Title == "A End - NWKR (Loc)") _legacyNWKRALoc = v;
                                        else if (inItem.Title == "A End - RWKR (Loc)") _legacyRWKRALoc = v;
                                        else if (inItem.Title == "B End - NWKR (Loc)") _legacyNWKRBLoc = v;
                                        else if (inItem.Title == "B End - RWKR (Loc)") _legacyRWKRBLoc = v;
                                    }
                                }
                            }
                        }
                    });

                    // Final values: circuitPmAnalog bridge wins over dataArray legacy
                    var aNWKRVal    = _getVal(_pa.aNWKR,    _legacyNWKRA);
                    var aRWKRVal    = _getVal(_pa.aRWKR,    _legacyRWKRA);
                    var bNWKRVal    = _getVal(_pa.bNWKR,    _legacyNWKRB);
                    var bRWKRVal    = _getVal(_pa.bRWKR,    _legacyRWKRB);
                    var aNWKRLocVal = _getVal(_pa.aNWKRLoc, _legacyNWKRALoc);
                    var aRWKRLocVal = _getVal(_pa.aRWKRLoc, _legacyRWKRALoc);
                    var bNWKRLocVal = _getVal(_pa.bNWKRLoc, _legacyNWKRBLoc);
                    var bRWKRLocVal = _getVal(_pa.bRWKRLoc, _legacyRWKRBLoc);


                    if (aNWKRVal != null) {

                        $.each(parseJson.cells, function (id, val) {
                            if ('label' in val.attrs && 'text' in val.attrs.label) {

                                if (val.type == "examples.Label") {
                                    if ($.trim(val.attrs.label.text) == $.trim('A End - NWKR') || $.trim(val.attrs.label.text).startsWith($.trim('(A)NWKR:'))) {
                                        val.attrs.label.fill = "#e2e8f0";
                                        val.attrs.label.text = "(A)NWKR: " + aNWKRVal;
                                    }
                                }

                            }
                            //if (val.type == "examples.RectBox") {
                            //    if ($.trim(val.attrs.label.text).endsWith($.trim('NWKR')) || $.trim(val.attrs.label.text).endsWith($.trim('RWKR'))) {

