    });

    function onConnect() {
        // Once a connection has been made, make a subscription and send a message.
        client.subscribe(mQQTPath + 'channel1');

        client.subscribe(mQQTPath + 'dl/#');
    }

    // called when the client loses its connection
    function onConnectionLost(responseObject) {
        if (responseObject.errorCode !== 0) {
            console.log("onConnectionLost:" + responseObject.errorMessage);
        }
        // FIX: Guard against reconnecting when already connected or connecting
        // This prevents AMQJS0011E "Invalid state already connected" error
        if (client && client.isConnected()) {
            console.log("[MQTT] Already connected — skipping reconnect");
            return;
        }
        var _isSecure = window.location.protocol === "https:";
        try {
            client.connect({
                onSuccess: onConnect,
                useSSL: _isSecure,
                userName: mQTT.MQTTUsername,
                password: mQTT.MQTTPassword,
                cleanSession: true
            });
        } catch (reconnectErr) {
            console.warn("[MQTT] Reconnect attempt failed:", reconnectErr.message);
        }
    }

    function onMessageArrivedCircuit(message) {
        if (message.destinationName.includes("/dl/")) {
            var parseJson = JSON.parse(message.payloadString);
            if (parseJson != null && parseJson != undefined && parseJson != '') {
                var jsonData = parseJson['bits'];
                if (jsonData != null && jsonData != undefined && jsonData.length > 0) {
                    var jsonArrayString = '';
                    for (var i = 0; i < jsonData.length; i++) {
                        var decimalNumber = decimalToBinary(jsonData[i]);
                        if (decimalNumber != null) {
                            if (decimalNumber.length != 8) {
                                decimalNumber = ("00000000" + decimalNumber.toString(2)).substr(-8);
                            }
                            const reversedString = decimalNumber.split("").reduce((acc, char) => char + acc, "");

                            jsonArrayString += reversedString;
                        }
                    }
                    var jsonArray = jsonArrayString.split('');
                    if (jsonArray != null && jsonArray != undefined && jsonArray.length > 0) {
                        try {
                            if (sitejson.IsDatalogger == true) {

                                try {

                                    BindCircuitDataLoggerSimulation(message.destinationName, jsonArray);

                                }
                                catch (err) {

                                }
                            }
                        }
                        catch (err) {

                        }
                    }
                }
            }
        }
        else {
            if (message.payloadString.includes("roles") && message.payloadString.includes("ts")) {
                var parseJson = JSON.parse(message.payloadString);
                if (parseJson != null && parseJson != undefined && parseJson != '') {
                    var array = parseJson['roles'];
                    var tsarray = parseJson['ts'];
                    if (array != null && array != undefined && array.length > 0) {

                        try {
                            var assetTypeId = $('#hdnCircuitDiagramAssetTypeId').val();
                            if (assetTypeId == 1) {
                                BindCircuitTrackSimulation(message.destinationName, array);
                            }
                            else if (assetTypeId == 2) {
                                BindCircuitSignalSimulation(message.destinationName, array);
                            }
                            else if (assetTypeId == 3) {
                                BindCircuitPointSimulation(message.destinationName, array);
                            }

                        }
                        catch (err) {

                        }
                    }
                }
            }
            else {
            }

            //for (var i = 0; i < channels.length; i++) {
            //    if (channels[i] != null && channels[i] != "null" && channels[i] != "") {
            //        var name = mQQTPath.toLowerCase() + channels[i].toLowerCase();
            //        if (message.destinationName.toLowerCase() == name.toLowerCase()) {
            //            var d = new Date();
            //            var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
            //            $("#c" + i).html(time);
            //        }
            //    }
            //}
        }


    }

    function fnShowSignatureGraghCircuit($this) {
        var lastdate = new Date();
        var firstDay = new Date();
        var assetId = assetJson.Id;
        var type = $($this).data('type');
        var eventTime = $($this).data('time');
        //alert('Hello')
        //var lastDay = new Date(date.getFullYear(), date.getMonth() + 1, 0);
        $("#loader").show();
        $.ajax({
            url: '/Site/GetPointMachineCurrentGraph',
            type: 'Post',
            data: '{assetId:' + assetJson.Id + ',startDate:"' + firstDay.toLocaleDateString() + '",endDate:"' + lastdate.toLocaleDateString() + '"}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                if (data != null) {
                    $(data).each(function (d, val) {
                        if (val.Date != '' && val.Date.includes(eventTime)) {

                            if (type == "AV" || type == "BV") {
                                fnBindSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                            } else {
                                if (type.includes('A')) {
                                    if (val.Direction.toLowerCase() == "normal" && assetJson.MachineAReverseScale == pointScale20) {
                                        fnBindCombineSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                                    }
                                    else if (val.Direction.toLowerCase() == "reverse" && assetJson.MachineAReverseScale == pointScale20) {
                                        fnBindCombineSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                                    } else {
                                        fnBindSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                                    }
                                } else {
                                    if (val.Direction.toLowerCase() == "normal" && assetJson.MachineBReverseScale == pointScale20) {
                                        fnBindCombineSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                                    }
                                    else if (val.Direction.toLowerCase() == "reverse" && assetJson.MachineBReverseScale == pointScale20) {
                                        fnBindCombineSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                                    } else {
                                        fnBindSignatureGragh(JSON.stringify(val.PointMachineJson), type, val.Date, val.Direction, val.AssetType, assetId)
                                    }
                                }


                            }
                        }

                    });

                    //$('#modal-graph').on('show.bs.modal', function () {
                    //    let zIndex = 1050 + ($('.modal:visible').length * 10);
                    //    $(this).css('z-index', zIndex);
                    //    setTimeout(function () {
                    //        $('.modal-backdrop').not('.stacked').first().css('z-index', zIndex - 1).addClass('stacked');
                    //    }, 0);
                    //});
                }
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });
    }

    function BindCircuitTrackSimulation(basePath, data) {
        // setTimeout removed — was for MQTT polling delay, not needed with WebSocket
        (function () {
            if ($("#circuitDiagramLiveGif").attr("src") != '/assets/images/liveGif.gif') {
                $("#circuitDiagramLiveGif").attr("src", "/assets/images/Live_green.gif");

            }
            var d = new Date();
            var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
            $("#circuitDiagramLiveTimeStamp").html('Last Update: ' + time);

            if (parseJson != null && parseJson != undefined && parseJson != '') {
                var item = assetJson;
                if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                    $.each(item.assetAttributes, function (idx, inItem) {

                        var infoValue = inItem.AssetInfoValue;
                        var infoMultiplication = inItem.Multiplication;
                        if (infoValue != null) {

                            var dataValue = data[infoValue];
                            if (infoMultiplication != null) {
                                $.each(parseJson.cells, function (id, val) {
                                    if ('label' in val.attrs && 'text' in val.attrs.label) {

                                        var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                        var v = ((mainData * 100) / 100).toFixed(1);
                                        if (val.type == "examples.Label") {
                                            var attrName = inItem.Title;
                                            var romovebracketAttr = inItem.Title;
                                            if (inItem.AliasName != null && inItem.AliasName != undefined && inItem.AliasName != '') {
                                                attrName = inItem.AliasName;
                                                romovebracketAttr = inItem.AliasName.replace(/\(.*?\)/, '');

                                            }
                                            if ($.trim(val.attrs.label.text).startsWith($.trim(romovebracketAttr))) {

                                                var attrNameStr = $.trim(attrName) + " : " + v;
                                                val.attrs.label.text = attrNameStr.replaceAll('(', '\n(');
                                                val.attrs.label.fill = "#e2e8f0";
                                            }
                                        }

                                        if ($.trim(val.attrs.label.text) == 'LCBOXFEED') {

                                            if (cardLines != null && cardLines != undefined && cardLines.length > 0) {
                                                $(cardLines).each(function (d, data) {
                                                    if (data.AttributeName == 'If mA') {
                                                        var splitClu = data.ClusterName.split("/");
                                                        val.attrs.label.text = splitClu[splitClu.length - 1];

                                                    }
                                                });

                                            }
                                        }

                                        if ($.trim(val.attrs.label.text) == 'LCBOXRELAY') {

                                            if (cardLines != null && cardLines != undefined && cardLines.length > 0) {
                                                $(cardLines).each(function (d, data) {
                                                    if (data.AttributeName == 'Ir mA') {
                                                        var splitClu = data.ClusterName.split("/");
                                                        val.attrs.label.text = splitClu[splitClu.length - 1];

                                                    }
                                                });

                                            }
                                        }

                                        // LKGVAL is now handled below via window.circuitLeakage bridge
                                    }

                                });
                            }
                        }

                    });
                }

                // Derived values — read from window.circuitDerived bridge (populated by
                // Index.cshtml's updateCircuitFromWebSocket via calculateDerivedValues before
                // calling BindCircuitTrackSimulation). Falls back to 0 if not yet available.
                var _derived = window.circuitDerived || {};
                var _lkgVal  = window.circuitLeakage != null ? window.circuitLeakage : 0;

                $.each(parseJson.cells, function (id, val) {
                    if ('label' in val.attrs && 'text' in val.attrs.label && val.type == "examples.Label") {
                        var txt = $.trim(val.attrs.label.text);
                        if (txt == 'LKGVAL' || txt.startsWith('LKGVAL')) {
                            val.attrs.label.text = _lkgVal;
                        } else if (txt.startsWith('RTC VAR RES') || txt.startsWith('VTC VAR RES') ||
                                   txt.startsWith('ITC BATT CHARG') || txt.startsWith('RTC CH FEED END') ||
                                   txt.startsWith('VTC TR') || txt.startsWith('IBALST') || txt.startsWith('RRAIL')) {
                            // Map label prefix → derived key
                            var derivedMap = {
                                'RTC VAR RES':    { key: 'rtcVarRes',    unit: '(ohm)' },
                                'VTC VAR RES':    { key: 'vtcVarRes',    unit: '(V)' },
                                'ITC BATT CHARG': { key: 'itcBattCharg', unit: '(mA)' },
                                'RTC CH FEED END':{ key: 'rtcChFeedEnd', unit: '(Ω)' },
                                'VTC TR':         { key: 'vtcTr',        unit: '(V)' },
                                'IBALST':         { key: 'ibalst',       unit: '(mA)' },
                                'RRAIL':          { key: 'rrail',        unit: '(Ω)' }
                            };
                            for (var prefix in derivedMap) {
                                if (txt.startsWith(prefix)) {
                                    var dKey = derivedMap[prefix].key;
                                    var dVal = (_derived[dKey] !== undefined && !isNaN(_derived[dKey]))
                                               ? parseFloat(_derived[dKey]).toFixed(2) : '0.00';
                                    // Preserve original label prefix (use first colon part if already set)
                                    var labelBase = txt.split(':')[0].split('\n')[0].trim();
                                    val.attrs.label.text = labelBase + ' :\n' + dVal;
                                    val.attrs.label.fill = '#e2e8f0';
                                    break;
                                }
                            }
                        }
                    }
                });

                appModel.graph.fromJSON(parseJson);
            }

        })(); // immediately-invoked — no setTimeout delay




    }

    function BindCircuitSignalSimulation(basePath, data) {

        var d = new Date();
        var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
        $("#circuitDiagramLiveTimeStamp").html('Last Update: ' + time);


        if ($("#circuitDiagramLiveGif").attr("src") != '/assets/images/liveGif.gif')
        {
            $("#circuitDiagramLiveGif").attr("src", "/assets/images/Live_green.gif");

        }

        // setTimeout removed — was for MQTT polling delay, not needed with WebSocket
        if (parseJson != null && parseJson != undefined && parseJson != '') {
            // First pass: reset all SingleCircle fills to default
            $.each(parseJson.cells, function (id, val) {
                if (val.type == "examples.SingleCircle") {
                    val.attrs.path.fill = "#1e293b";
                }
            });
            appModel.graph.fromJSON(parseJson);
            var item = assetJson;
            if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                $.each(item.assetAttributes, function (idx, inItem) {

                    var infoValue = inItem.AssetInfoValue;
                    var infoMultiplication = inItem.Multiplication;
                    if (infoValue != null) {

                        var dataValue = data[infoValue];
                        if (infoMultiplication != null) {
                            $.each(parseJson.cells, function (id, val) {
                                if ('label' in val.attrs && 'text' in val.attrs.label) {

                                    var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                    var v = ((mainData * 100) / 100).toFixed(2);
                                    if (val.type == "examples.Label") {
                                        var attrName = inItem.Title;
                                        if (inItem.AliasName != null && inItem.AliasName != undefined && inItem.AliasName != '') {
                                            attrName = inItem.AliasName;
                                        }
                                        if ($.trim(val.attrs.label.text).startsWith($.trim(attrName))) {
                                            val.attrs.label.text = $.trim(attrName) + " : " + v
                                            val.attrs.label.fill = "#e2e8f0";
                                        }
                                    }
                                }

                                if (val.type == "examples.Text") {
                                    if (val.attrs != null && val.attrs.label != null && val.attrs.label != undefined && val.attrs.label.text != null && val.attrs.label.text != undefined) {
                                        if ($.trim(val.attrs.label.text) == 'SLCBOX') {

                                            if (cardLines != null && cardLines != undefined && cardLines.length > 0) {
                                                $(cardLines).each(function (d, data) {
                                                    if (data.AttributeName == 'RG mA') {
                                                        var splitClu = data.ClusterName.split("/");
                                                        val.attrs.label.text = splitClu[splitClu.length - 1];

                                                    }
                                                });

                                            }
                                        }
                                    }

                                }


                                if (val.type == "examples.SingleCircle") {
                                    var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                    var v = ((mainData * 100) / 100).toFixed(2);

                                    if (val.attrs != null && val.attrs.label != null && val.attrs.label != undefined && val.attrs.label.text != null && val.attrs.label.text != undefined) {
                                        if (val.attrs.label.text == "RG mA" && inItem.Title == "RG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                            val.attrs.path.fill = "#FF0E0E";

                                        }
                                        else if (val.attrs.label.text == "DG mA" && inItem.Title == "DG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                            val.attrs.path.fill = "#00FF00";

                                        }
                                        else if (val.attrs.label.text == "HG mA" && inItem.Title == "HG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                            val.attrs.path.fill = "#FFBF00";
                                        }
                                        else if (val.attrs.label.text == "HHG mA" && inItem.Title == "HHG mA" && parseFloat(v) > parseFloat(item.ZeroOffsetValue)) {
                                            val.attrs.path.fill = "#FFBF00";

                                        }
                                    }

                                }
                            });
                        }
                    }
                });
            }

            appModel.graph.fromJSON(parseJson);
        }

    }

