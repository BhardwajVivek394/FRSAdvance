        var pointMachineData = {};
        pointMachineData.AssetId = assetId;
        pointMachineData.StartDate = new Date();
        pointMachineData.EndDate = new Date();

        $.ajax({
            url: '/Site/GetPointMachineData',
            type: 'Post',
            data: '{pointMachineData:' + JSON.stringify(pointMachineData) + '}',
            contentType: 'application/json',
            success: function (data) {
                if (data != null && data.length > 0) {

                    if (data.length > 2) {
                        const lastThree = data.slice(0, 3);
                        var str = '';
                        if (lastThree) {
                            str += '<tr><th style="padding:5px;background-color: #085885; color: white;">Date</th><th style="padding:5px;background-color: #085885; color: white;">Direction</th><th style="padding:5px;background-color: #085885; color: white;" class="text-center">A <br /> Current</th><th style="padding:5px;background-color: #085885; color: white;" class="text-center">A <br /> Voltage</th><th style="background-color: #085885; color: white;">A <br /> Time</th><th style="background-color: #085885; color: white; padding:5px;" class="text-center">B <br /> Current</th><th style="background-color: #085885; color: white;padding:5px;" class="text-center">B <br /> Voltage</th><th style="background-color: #085885; color: white;padding:5px;">B<br />Time</th></tr>';
                            $(lastThree).each(function (d, val) {
                                str += '<tr>';
                                str += '<td style="padding:5px">' + val.Date +'</td>';
                                str += '<td>' + val.Direction + '</td>';
                                str += "<td style='padding:5px' class='text-center'><a onclick='fnShowSignatureGraghCircuit(this)' data-type='AC' data-time='" + val.Date +"'>" + val.PointMachineJson.A_C_MAX + "</a></td>";
                                str += "<td style='padding:5px' class='text-center'><a onclick='fnShowSignatureGraghCircuit(this)' data-type='AV' data-time='" + val.Date + "'>" + val.PointMachineJson.A_V_AVERAGE + "</a></td>";
                                str += '<td>' + val.PointMachineJson.A_C_TIME + '</td>';
                                str += "<td style='padding:5px' class='text-center'><a onclick='fnShowSignatureGraghCircuit(this)' data-type='BC' data-time='" + val.Date + "'>" + val.PointMachineJson.B_C_MAX + "</a></td>";
                                str += "<td style='padding:5px' class='text-center'><a onclick='fnShowSignatureGraghCircuit(this)' data-type='BV' data-time='" + val.Date + "'>" + val.PointMachineJson.B_V_AVERAGE + "</a></td>";
                                str += '<td style="padding:5px">' + val.PointMachineJson.B_C_TIME + '</td>';
                                str += '</tr>';
                            });
                        }

                        $('#dataTableCircuit').empty().append(str);

                    }


                    const PointMachineDataR = data
                        .filter(x => x.Direction === "Reverse")[0]; // Get the first item (same as FirstOrDefault)

                    if (PointMachineDataR != null && PointMachineDataR.PointMachineJson != null) {
                        pointMachineDataJsonR = PointMachineDataR.PointMachineJson;

                        pointMachineEventTime = PointMachineDataR.Date.split(" ")[1];
                    }

                    const PointMachineDataN = data
                        .filter(x => x.Direction === "Normal")[0]; // Get the first item (same as FirstOrDefault)

                    if (PointMachineDataN != null && PointMachineDataN.PointMachineJson != null) {
                        pointMachineDataJsonN = PointMachineDataN.PointMachineJson;

                        pointMachineEventTime = PointMachineDataN.Date.split(" ")[1];
                    }
                }

            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });

    }

    // =======================================================================
    // PM OPERATIONS TABLE — renderPmLastOpPanel
    // =======================================================================
    // Renders a clean data table into #pmLastOpPanel showing both Normal and
    // Reverse rows from window.circuitPmRows. Called from Index.cshtml after
    // new WS data. Change-signature guard prevents redundant re-renders.
    // =======================================================================
    var _pmPanelLastSig = null;

    window.renderPmLastOpPanel = function () {
        var p = document.getElementById('pmLastOpPanel');
        if (!p) return;

        var rows = window.circuitPmRows;
        if (!rows || rows.length === 0) { p.style.display = 'none'; return; }

        // Only show the most recent operation (index 0)
        var rows = [rows[0]];

        // Build sig from all rows
        var sig = rows.map(function(r) {
            return [r.direction, r.date, r.aCurrent, r.aVoltage, r.aTime, r.bCurrent, r.bVoltage, r.bTime].join('|');
        }).join('||');
        if (sig === _pmPanelLastSig) return;
        _pmPanelLastSig = sig;

        // ── Build table rows HTML ────────────────────────────────────────────
        var rowsHtml = '';
        for (var i = 0; i < rows.length; i++) {
            var r = rows[i];
            var isRev = (r.direction === 'Reverse');
            var isLast = (i === 0);  // index 0 = most recent operation
            var dirStyle = isRev
                ? 'background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;'
                : 'background:#f0fdf4;color:#166534;border:1px solid #bbf7d0;';
            var rowBg = isLast ? '#f8faff' : '#fff';
            var acVal  = r.aCurrent || '—';
            var avVal  = r.aVoltage || '—';
            var atVal  = r.aTime    || '—';
            var bcVal  = r.bCurrent || '—';
            var bvVal  = r.bVoltage || '—';
            var btVal  = r.bTime    || '—';

            rowsHtml +=
                '<tr style="background:' + rowBg + ';border-bottom:1px solid #e2e8f0;">' +
                  // Date
                  '<td style="padding:7px 10px;font-size:11px;color:#475569;white-space:nowrap;">' + (r.date || '—') + '</td>' +
                  // Direction badge
                  '<td style="padding:7px 10px;text-align:center;">' +
                    '<span style="' + dirStyle + 'font-size:10px;font-weight:700;padding:2px 9px;border-radius:20px;display:inline-block;">' + (r.direction || '—') + '</span>' +
                  '</td>' +
                  // A Current
                  '<td style="padding:7px 10px;text-align:right;font-size:12px;font-weight:700;color:#1e293b;">' + acVal + '<small style="font-weight:400;color:#94a3b8;font-size:10px;"> A</small></td>' +
                  // A Voltage
                  '<td style="padding:7px 10px;text-align:right;font-size:12px;font-weight:700;color:#1e293b;">' + avVal + '<small style="font-weight:400;color:#94a3b8;font-size:10px;"> V</small></td>' +
                  // A Time
                  '<td style="padding:7px 10px;text-align:right;font-size:12px;font-weight:700;color:#1e293b;">' + atVal + '<small style="font-weight:400;color:#94a3b8;font-size:10px;"> ms</small></td>' +
                  // B Current
                  '<td style="padding:7px 10px;text-align:right;font-size:12px;font-weight:700;color:#1e293b;">' + bcVal + '<small style="font-weight:400;color:#94a3b8;font-size:10px;"> A</small></td>' +
                  // B Voltage
                  '<td style="padding:7px 10px;text-align:right;font-size:12px;font-weight:700;color:#1e293b;">' + bvVal + '<small style="font-weight:400;color:#94a3b8;font-size:10px;"> V</small></td>' +
                  // B Time
                  '<td style="padding:7px 10px;text-align:right;font-size:12px;font-weight:700;color:#1e293b;">' + btVal + '<small style="font-weight:400;color:#94a3b8;font-size:10px;"> ms</small></td>' +
                '</tr>';
        }

        p.innerHTML =
            // ── Header bar ──────────────────────────────────────────────────
            '<div style="background:#0a3d62;padding:8px 14px;display:flex;justify-content:space-between;align-items:center;border-radius:8px 8px 0 0;">' +
              '<span style="color:#fff;font-size:12px;font-weight:700;letter-spacing:.5px;">&#x26A1;&nbsp;Operations History</span>' +
              '<span style="color:#93c5fd;font-size:10px;">Live</span>' +
            '</div>' +
            // ── Table ────────────────────────────────────────────────────────
            '<div style="overflow-x:auto;">' +
              '<table style="width:100%;border-collapse:collapse;font-family:\'Segoe UI\',sans-serif;">' +
                // Column headers
                '<thead>' +
                  '<tr style="background:#1e3a5f;">' +
                    '<th style="padding:7px 10px;text-align:left;font-size:10px;font-weight:700;color:#93c5fd;text-transform:uppercase;letter-spacing:.5px;white-space:nowrap;">Date</th>' +
                    '<th style="padding:7px 10px;text-align:center;font-size:10px;font-weight:700;color:#93c5fd;text-transform:uppercase;letter-spacing:.5px;">Direction</th>' +
                    '<th style="padding:7px 10px;text-align:center;font-size:10px;font-weight:700;color:#7dd3fc;text-transform:uppercase;letter-spacing:.5px;" colspan="3">A End</th>' +
                    '<th style="padding:7px 10px;text-align:center;font-size:10px;font-weight:700;color:#6ee7b7;text-transform:uppercase;letter-spacing:.5px;" colspan="3">B End</th>' +
                  '</tr>' +
                  '<tr style="background:#162d4a;border-bottom:2px solid #0a3d62;">' +
                    '<th style="padding:5px 10px;"></th>' +
                    '<th style="padding:5px 10px;"></th>' +
                    '<th style="padding:5px 10px;text-align:right;font-size:10px;color:#7dd3fc;font-weight:600;">I Max</th>' +
                    '<th style="padding:5px 10px;text-align:right;font-size:10px;color:#7dd3fc;font-weight:600;">V Avg</th>' +
                    '<th style="padding:5px 10px;text-align:right;font-size:10px;color:#7dd3fc;font-weight:600;">Op Time</th>' +
                    '<th style="padding:5px 10px;text-align:right;font-size:10px;color:#6ee7b7;font-weight:600;">I Max</th>' +
                    '<th style="padding:5px 10px;text-align:right;font-size:10px;color:#6ee7b7;font-weight:600;">V Avg</th>' +
                    '<th style="padding:5px 10px;text-align:right;font-size:10px;color:#6ee7b7;font-weight:600;">Op Time</th>' +
                  '</tr>' +
                '</thead>' +
                '<tbody>' + rowsHtml + '</tbody>' +
              '</table>' +
            '</div>';

        p.style.display = 'block';
    };

    // Legacy stub — kept so any remaining call sites don't throw errors
    function fnBindPointTable() {}

    function decimalToBinary(num) {
        let binary = "";
        while (num > 0) {
            let digit = num % 2;
            binary = "" + digit + binary;
            num = parseInt(num / 2);
        }
        return binary.padStart(8, '0');
