@model List<Domain.CardLine>



@if (Model != null && Model.Count > 0)
{

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover vh-100">
                <thead class="thead-light2">
                    <tr>
                        <th>Attribute</th>
                        <th>Location</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cardline in Model)
                    {

                        <tr>
                            <td>@cardline.AttributeName</td>
                            <td>@cardline.ClusterName</td>
                        </tr>


                    }
                </tbody>

            </table>

        </div>
    </div>
}


