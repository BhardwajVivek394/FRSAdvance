            font-family: 'JetBrains Mono', monospace;
            font-size: 11px;
        }

        .pm-relay-badge .relay-status {
            padding: 2px 10px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 700;
            color: #fff;
            position: relative;
            overflow: hidden;
        }

            .pm-relay-badge .relay-status.pickup {
                background: linear-gradient(135deg,#10b981,#059669);
            }

            .pm-relay-badge .relay-status.drop {
                background: linear-gradient(135deg,#f59e0b,#d97706);
            }

            .pm-relay-badge .relay-status.shine::before {
                content: '';
                position: absolute;
                top: 0;
                left: -75%;
                width: 50%;
                height: 100%;
                background: linear-gradient(120deg, rgba(255,255,255,.15) 0%, rgba(255,255,255,.55) 50%, rgba(255,255,255,.15) 100%);
                transform: skewX(-20deg);
                animation: pmShine 2.5s infinite;
            }

    .pm-detail-badge {
        padding: 2px 10px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: 700;
        color: rgba(255,255,255,0.85);
        background: rgba(255,255,255,0.10);
        border: 1px solid rgba(255,255,255,0.15);
        cursor: pointer;
        transition: all .18s;
    }

        .pm-detail-badge:hover {
            background: rgba(255,255,255,0.18);
        }

    .pm-actions-right {
        margin-left: auto;
        display: flex;
        gap: 8px;
    }

    .pm-btn-download, .pm-btn-seemore {
        padding: 4px 14px;
        border-radius: 14px;
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.80);
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.14);
        cursor: pointer;
        transition: all .18s;
    }

        .pm-btn-download:hover, .pm-btn-seemore:hover {
            background: rgba(34,211,238,0.14);
            color: #22d3ee;
            border-color: rgba(34,211,238,0.35);
        }

    .pm-dir-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 700;
        color: #fff;
        letter-spacing: 0.03em;
    }

        .pm-dir-badge.normal {
            background: linear-gradient(135deg,#0d9488,#0f766e);
            box-shadow: 0 0 10px rgba(13,148,136,0.35);
        }

        .pm-dir-badge.reverse {
            background: linear-gradient(135deg,#e85d04,#c2410c);
            box-shadow: 0 0 10px rgba(232,93,4,0.35);
        }

    .pm-data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

    .pm-name-merged-cell {
        font-family: 'Bricolage Grotesque', sans-serif;
        font-weight: 700;
        font-size: 16px;
        color: rgba(255,255,255,0.90);
        background: rgba(255,255,255,0.03);
        vertical-align: middle;
        border: 1px solid rgba(255,255,255,0.07);
        padding: 12px;
        letter-spacing: -0.01em;
    }

    .pm-dir-header-cell {
        padding: 10px 14px;
