        window.atpFilterCards = function (query) {
            var q = (query || '').trim().toLowerCase();
            // Filter card view
            $('#atCardView .at-card, #atCardView .ips-asset-card').each(function () {
                var name = ($(this).find('.at-card-name, .ips-asset-name').text() || '').toLowerCase();
                $(this).toggle(q === '' || name.indexOf(q) > -1);
            });
            // Filter table rows
            $('#divTelemetryLive tbody tr, #trackCardContainer .pm-card, #trackCardContainer .track-card').each(function () {
                var text = $(this).text().toLowerCase();
                $(this).toggle(q === '' || text.indexOf(q) > -1);
            });
            atpUpdateCount();
        };

        // ── Asset count badge ────────────────────────────────────────
        function atpUpdateCount() {
            var total = Object.keys(window.wsLiveData || {}).length;
            if (total > 0) {
                $count.html('Showing <strong>' + total + '</strong> Assets');
            } else {
                $count.html('');
            }
