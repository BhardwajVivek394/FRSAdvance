        // Hook into updateWsStats so count refreshes on live data updates
        var _origUpdateStats = window.updateWsStats;
        if (typeof _origUpdateStats === 'function') {
            window.updateWsStats = function () {
                _origUpdateStats.apply(this, arguments);
                atpUpdateCount();
            };
        }

        // ── MutationObserver: rebuild pills when GetAssetTypeBySiteId()
        //    repopulates the hidden <select> options ──────────────────
        var observer = new MutationObserver(function () {
            console.log('[ATP] drpAssetType options changed — rebuilding pills');
            atpRebuildPills();
        });
        observer.observe($drp[0], { childList: true, subtree: true });

        // ── Initial build on DOM ready ───────────────────────────────
        $(function () {
            atpRebuildPills();
