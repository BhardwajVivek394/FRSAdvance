            WebSocketBaseUrl:   '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrlSSL"]',
            WebSocketAuthToken: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketAuthToken"]'
        };
    } else {
        APP_CONFIG = {
            ProxyBaseUrl:       '@System.Configuration.ConfigurationManager.AppSettings["ProxyBaseUrl"]',
            WebSocketBaseUrl:   '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrl"]',
            WebSocketAuthToken: null
        };
    }

    // ── Safety net: auto-correct protocol mismatches ──
    if (isSecure) {
        if (APP_CONFIG.WebSocketBaseUrl && APP_CONFIG.WebSocketBaseUrl.indexOf('ws://') === 0) {
            console.warn('[APP_CONFIG] Fixing WebSocketBaseUrl: ws:// → wss:// (page is HTTPS)');
            APP_CONFIG.WebSocketBaseUrl = APP_CONFIG.WebSocketBaseUrl.replace('ws://', 'wss://');
        }
        if (APP_CONFIG.ProxyBaseUrl && APP_CONFIG.ProxyBaseUrl.indexOf('http://') === 0) {
            console.warn('[APP_CONFIG] Fixing ProxyBaseUrl: http:// → https:// (page is HTTPS)');
            APP_CONFIG.ProxyBaseUrl = APP_CONFIG.ProxyBaseUrl.replace('http://', 'https://');
        }
    }

    var API_BASE_URL = APP_CONFIG.ProxyBaseUrl + '/api/liveValue';
    var WS_BASE_URL = APP_CONFIG.WebSocketBaseUrl + '/subscribe/liveValue';

    // ── Safety net: auto-correct protocol mismatches ──
    if (isSecure) {
        if (APP_CONFIG.WebSocketBaseUrl && APP_CONFIG.WebSocketBaseUrl.indexOf('ws://') === 0) {
            console.warn('[APP_CONFIG] Fixing WebSocketBaseUrl: ws:// → wss:// (page is HTTPS)');
            APP_CONFIG.WebSocketBaseUrl = APP_CONFIG.WebSocketBaseUrl.replace('ws://', 'wss://');
            WS_BASE_URL = APP_CONFIG.WebSocketBaseUrl + '/subscribe/liveValue';
        }
        if (APP_CONFIG.ProxyBaseUrl && APP_CONFIG.ProxyBaseUrl.indexOf('http://') === 0) {
            console.warn('[APP_CONFIG] Fixing ProxyBaseUrl: http:// → https:// (page is HTTPS)');
