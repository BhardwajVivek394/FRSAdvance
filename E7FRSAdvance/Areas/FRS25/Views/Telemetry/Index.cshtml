<script>
    // ═══════════════════════════════════════════════════════════════
    // SIP CARD DRAG-TO-MOVE (header grip)
    // ═══════════════════════════════════════════════════════════════
    (function () {
        'use strict';
        var sipCard = document.getElementById('sipCardSection');
        if (!sipCard) return;

        var isDragging = false, startX, startY, origRect, ghost;

        function onPointerDown(e) {
            // only from the card-head bar
            if (!e.target.closest('.sip-card-head')) return;
            if (e.target.closest('button,a,input,select')) return;
            if (sipCard.classList.contains('fullscreen')) return;

            isDragging = true;
            startX = e.clientX;
            startY = e.clientY;
            origRect = sipCard.getBoundingClientRect();

            sipCard.classList.add('sip-dragging');
            sipCard.style.position = 'fixed';
            sipCard.style.left = origRect.left + 'px';
            sipCard.style.top = origRect.top + 'px';
            sipCard.style.width = origRect.width + 'px';
            sipCard.style.zIndex = '9999';
            sipCard.style.margin = '0';
            sipCard.style.transition = 'none';

            document.addEventListener('pointermove', onPointerMove);
            document.addEventListener('pointerup', onPointerUp);
            e.preventDefault();
        }

        function onPointerMove(e) {
            if (!isDragging) return;
            var dx = e.clientX - startX;
            var dy = e.clientY - startY;
            sipCard.style.left = (origRect.left + dx) + 'px';
            sipCard.style.top = (origRect.top + dy) + 'px';
        }

        function onPointerUp() {
            if (!isDragging) return;
            isDragging = false;
            document.removeEventListener('pointermove', onPointerMove);
            document.removeEventListener('pointerup', onPointerUp);

            sipCard.classList.remove('sip-dragging');
            // Snap back to flow position
            sipCard.style.position = '';
            sipCard.style.left = '';
            sipCard.style.top = '';
            sipCard.style.width = '';
            sipCard.style.zIndex = '';
            sipCard.style.margin = '';
            sipCard.style.transition = '';
        }

        sipCard.addEventListener('pointerdown', onPointerDown);
    })();

    // ═══════════════════════════════════════════════════════════════
    // SMOOTH VIEW TRANSITIONS (Card ↔ List)
    // ═══════════════════════════════════════════════════════════════
    (function () {
        'use strict';

        // Add CSS for smooth transitions
        var style = document.createElement('style');
        style.textContent =
            '#atCardView, .at-table-scroll, #divTelemetryLive, #trackCardContainer {' +
            '  transition: opacity 0.2s ease;' +
            '}' +
            '#atCardView.view-entering, .at-table-scroll.view-entering {' +
            '  animation: viewFadeIn 0.25s ease forwards;' +
            '}' +
            '@@keyframes viewFadeIn {' +
            '  from { opacity: 0; transform: translateY(6px); }' +
            '  to   { opacity: 1; transform: translateY(0); }' +
            '}' +
            /* PM card wrapper smooth rendering */
            '.pm-card-wrapper {' +
            '  animation: pmCardAppear 0.3s ease forwards;' +
            '}' +
            '@@keyframes pmCardAppear {' +
            '  from { opacity: 0; transform: translateY(10px); }' +
            '  to   { opacity: 1; transform: translateY(0); }' +
            '}';
        document.head.appendChild(style);

        // Hook into _tlApplyViewMode for smooth transitions
        if (typeof window._tlApplyViewMode === 'function') {
            var _origApply = window._tlApplyViewMode;
            window._tlApplyViewMode = function (mode, opts) {
                // Add entering class for animation
                var target = (mode === 'Cards') ? '#atCardView' : '.at-table-scroll';
                _origApply.call(this, mode, opts);
                $(target).addClass('view-entering');
                setTimeout(function () { $(target).removeClass('view-entering'); }, 300);
            };
        }
    })();

    // ═══════════════════════════════════════════════════════════════
    // PM CARD VIEW FIX: ensure Point Machine cards render properly
    // in Card mode (not just Table mode)
    // ═══════════════════════════════════════════════════════════════
    (function () {
        'use strict';
        // Ensure PM container exists before renderPointMachineView runs
        var _origRenderPM = window.renderPointMachineView;
        if (typeof _origRenderPM === 'function') {
            window.renderPointMachineView = function () {
                var $c = $('#divTelemetryLive');
                // Make sure the parent containers are visible
                $('.at-table-scroll').show().removeClass('at-force-hidden').addClass('at-force-shown');
                $c.show();
                // Remove any lingering "no data" placeholders
                $c.find('.text-center.p-5').remove();
                // Ensure pmMainContainer exists
                if ($c.find('#pmMainContainer').length === 0) {
                    $c.html('<div id="pmMainContainer" class="col-12 p-0 p-md-2"></div>');
                }
                try {
                    _origRenderPM.apply(this, arguments);
                } catch (e) {
                    console.error('[PM Fix] renderPointMachineView error:', e);
                }
                // After render, ensure the table-scroll container doesn't constrain PM cards
                var tsEl = document.querySelector('.at-table-scroll');
                if (tsEl) {
                    tsEl.style.overflow = 'visible';
                    tsEl.style.maxHeight = 'none';
                    tsEl.classList.remove('scroll-table-mode');
                }
            };
            console.log('[PM Fix] renderPointMachineView wrapped for card view compatibility');
        }

        // ── Fix atSwitchView('Cards') to route PM/Signal/IPS to their
        //    rich renderers instead of the generic stub cards ──────────
        var _origAtSwitchView = window.atSwitchView;
        if (typeof _origAtSwitchView === 'function') {
            window.atSwitchView = function (viewName, el) {
                if (viewName === 'Cards') {
                    // Check if this is a rich asset type that has its own renderer
                    var isSignal = (typeof isSignalAssetType === 'function' && isSignalAssetType());
                    var isPoint = (typeof isPointAssetType === 'function' && isPointAssetType());
                    var isIps = (typeof isIpsAssetType === 'function' && isIpsAssetType());

                    if (!isSignal && !isPoint && !isIps) {
                        var atVal = $('#drpAssetType').val();
                        var atText = ($('#drpAssetType option:selected').text() || '').toLowerCase();
                        isSignal = (atVal === '2' || atText === 'signal');
                        isPoint = (atVal === '3' || atText.indexOf('point') !== -1);
                        isIps = (atVal === '4' || atText === 'ips');
                    }

                    // For rich asset types, delegate to _tlApplyViewMode which handles
                    // routing to renderPointMachineView / renderRDPMSView / renderIpsGridView
                    if (isSignal || isPoint || isIps) {
                        console.log('[atSwitchView Fix] Cards for rich type → delegating to _tlApplyViewMode');
                        // Sync tab highlight
                        if (el) {
                            document.querySelectorAll('#atViewTabBar .at-tab-btn').forEach(function (b) {
                                b.classList.toggle('active', b === el);
                            });
                        }
                        if (typeof window._tlApplyViewMode === 'function') {
                            window._tlApplyViewMode('Cards', { dataAlreadyOpen: true });
                        }
                        return;
                    }
                }
                // For all other cases (Track cards, Table, etc.) use the original
                _origAtSwitchView.call(this, viewName, el);
            };
            console.log('[PM Fix] atSwitchView wrapped to route rich types through _tlApplyViewMode');
        }
    })();
</script>

