        width: 28px;
        height: 28px;
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(34,211,238,0.12);
        color: var(--at-brand,#22d3ee);
        font-size: 12px;
    }

    .at-table-card-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

