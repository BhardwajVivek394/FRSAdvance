        width: calc(25px * var(--rdpms-scale));
        height: calc(25px * var(--rdpms-scale));
    }

    .rdpms-routeSignal2 {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: calc(8px * var(--rdpms-scale));
        padding-top: calc(8px * var(--rdpms-scale));
        padding-bottom: calc(8px * var(--rdpms-scale));
        width: calc(48px * var(--rdpms-scale));
        background: #111;
        background-image: linear-gradient(transparent 2%, #0a0a0a 2%, transparent 3%, #0a0a0a 30%);
        border-radius: calc(20px * var(--rdpms-scale));
