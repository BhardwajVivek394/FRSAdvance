        // ── Sub-pills for asset sub-types (TRACK / UFSBI etc.) ──────
        window.atpRenderSubPills = function (subTypes) {
            $subBox.empty();
            if (!subTypes || subTypes.length === 0) { $subBox.hide(); return; }
            $subBox.show();
            $.each(subTypes, function (i, st) {
                var $sp = $('<span class="atp-sub-pill"></span>')
                    .attr('data-sub', st.Id || st.Name)
                    .text((st.Name || '').toUpperCase());
                if (i === 0) $sp.addClass('active');
                $subBox.append($sp);
            });
