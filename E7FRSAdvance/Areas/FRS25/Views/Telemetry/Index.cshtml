        letter-spacing: .1em;
        color: var(--at-brand,#22d3ee);
        margin-bottom: 4px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .at-page-title {
        font-size: 28px;
        font-weight: 800;
        font-family: var(--at-font-display,'Bricolage Grotesque',sans-serif);
        color: var(--at-t1,rgba(255,255,255,0.96));
        margin: 0 0 4px;
    }

    .at-page-sub {
        font-size: 13px;
        color: var(--at-t3,rgba(255,255,255,0.50));
        margin: 0;
    }

    :root {
        --brand: #22d3ee;
        --brand-glow: rgba(34,211,238,0.45);
        --ok: #34d399;
        --warn: #fbbf24;
        --bad: #fb7185;
        --info: #a78bfa;
        --aurora-magenta: #f472b6;
        --glass-1: rgba(255,255,255,0.04);
        --glass-2: rgba(255,255,255,0.06);
        --glass-3: rgba(255,255,255,0.08);
        --glass-4: rgba(255,255,255,0.13);
        --glass-edge: rgba(255,255,255,0.10);
        --glass-edge-strong: rgba(255,255,255,0.18);
        --text-1: rgba(255,255,255,0.96);
        --text-2: rgba(255,255,255,0.72);
        --text-3: rgba(255,255,255,0.50);
        --text-4: rgba(255,255,255,0.34);
        --bg-2: #0e1530;
        --radius-xl: 22px;
        --radius-lg: 16px;
        --radius-md: 12px;
        --radius-sm: 8px;
        --t-fast: .18s cubic-bezier(0.22,1,0.36,1);
        --t-base: .32s cubic-bezier(0.22,1,0.36,1);
        --shadow-glass: 0 8px 32px rgba(0,0,0,0.36), 0 1px 0 rgba(255,255,255,0.08) inset;
        --shadow-raised: 0 24px 48px -12px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.06) inset;
    }

    body[data-aurora="light"] {
        --glass-1: rgba(255,255,255,0.45);
        --glass-2: rgba(255,255,255,0.58);
        --glass-3: rgba(255,255,255,0.70);
        --glass-4: rgba(255,255,255,0.82);
        --glass-edge: rgba(15,23,42,0.10);
        --glass-edge-strong: rgba(15,23,42,0.18);
        --text-1: #0b1530;
        --text-2: #334155;
        --text-3: #64748b;
        --text-4: #94a3b8;
        --bg-2: #f1f5f9;
        --shadow-glass: 0 8px 32px rgba(15,23,42,0.12), 0 1px 0 rgba(255,255,255,0.7) inset;
        --shadow-raised: 0 24px 48px -12px rgba(15,23,42,0.18), 0 0 0 1px rgba(15,23,42,0.04) inset;
    }

    .at-page-header {
        align-items: stretch;
    }

    .sip-card {
        flex: 1 1 640px;
        min-width: 0;
        background: var(--glass-2);
        backdrop-filter: blur(28px) saturate(160%);
        -webkit-backdrop-filter: blur(28px) saturate(160%);
        border: 1px solid var(--glass-edge);
        border-radius: var(--radius-xl);
        box-shadow: var(--shadow-glass);
        overflow: hidden;
        position: relative;
    }

        .sip-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(800px 200px at 20% -20%, rgba(34,211,238,0.12), transparent 60%), radial-gradient(600px 200px at 90% 120%, rgba(167,139,250,0.10), transparent 60%);
            pointer-events: none;
        }

    .sip-card-head {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--glass-edge);
        flex-wrap: wrap;
    }

    .sip-title-row {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .sip-title {
        font-family: 'Bricolage Grotesque', sans-serif;
        font-weight: 600;
        font-size: 13px;
        color: var(--text-1);
        letter-spacing: -0.005em;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

        .sip-title i {
            color: var(--brand);
            font-size: 11px;
        }

    .sip-sub {
        font-size: 10.5px;
        color: var(--text-3);
    }

        .sip-sub kbd {
            display: inline-block;
            padding: 1px 5px;
            border-radius: 4px;
            background: var(--glass-1);
            border: 1px solid var(--glass-edge);
            font-family: 'JetBrains Mono', monospace;
            font-size: 9.5px;
            color: var(--text-2);
        }

    .sip-controls {
        display: inline-flex;
        gap: 6px;
        align-items: center;
        flex-wrap: wrap;
    }

    .compare-toggle {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 12px;
        border-radius: 8px;
        background: var(--glass-1);
        border: 1px solid var(--glass-edge);
        color: var(--text-2);
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all var(--t-fast);
    }

        .compare-toggle i {
            font-size: 10px;
            opacity: 0.85;
        }

        .compare-toggle strong {
            color: var(--text-3);
            font-weight: 600;
        }

        .compare-toggle:hover {
            background: var(--glass-3);
            color: var(--text-1);
        }

        .compare-toggle.on {
            background: linear-gradient(135deg, rgba(34,211,238,0.20), rgba(167,139,250,0.14));
            color: var(--text-1);
            border-color: var(--glass-edge-strong);
            box-shadow: inset 0 1px 0 rgba(255,255,255,0.10), 0 4px 14px -6px var(--brand-glow);
        }

            .compare-toggle.on strong {
                color: var(--brand);
            }

    .sip-clear {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 8px;
        background: rgba(251,113,133,0.10);
        border: 1px solid rgba(251,113,133,0.28);
        color: var(--bad);
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        transition: all var(--t-fast);
    }

        .sip-clear:hover {
            background: rgba(251,113,133,0.18);
        }

        .sip-clear[hidden] {
            display: none;
        }


    .sip-canvas::-webkit-scrollbar {
        height: 8px;
        width: 8px;
    }

    .sip-canvas::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.18);
        border-radius: 4px;
    }

    body[data-aurora="light"] .sip-canvas::-webkit-scrollbar-track {
        background: rgba(15,23,42,0.06);
    }

    .sip-canvas::-webkit-scrollbar-thumb {
        background: var(--glass-edge-strong);
        border-radius: 4px;
    }

        .sip-canvas::-webkit-scrollbar-thumb:hover {
            background: var(--brand);
        }

    .sip-canvas svg {
        display: block;
        width: 100%;
        min-width: 900px;
        height: auto;
    }

    .sip-legend {
        position: relative;
        display: flex;
        flex-wrap: wrap;
        gap: 14px 18px;
        padding: 8px 14px 10px;
        border-top: 1px solid var(--glass-edge);
        font-size: 10.5px;
        color: var(--text-3);
    }

        .sip-legend .legend-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .sip-legend .legend-swatch {
            display: inline-block;
            width: 22px;
            height: 11px;
            border-radius: 6px;
            background: rgba(52,211,153,0.16);
            border: 1px solid rgba(52,211,153,0.50);
        }

            .sip-legend .legend-swatch.signal {
                width: 16px;
                height: 9px;
                border-radius: 50%;
                background: rgba(52,211,153,0.20);
                border: 1px solid var(--ok);
                box-shadow: 0 0 4px var(--ok);
            }

                .sip-legend .legend-swatch.signal.r {
                    background: rgba(251,113,133,0.20);
                    border-color: var(--bad);
                    box-shadow: 0 0 4px var(--bad);
                }

                .sip-legend .legend-swatch.signal.y {
                    background: rgba(251,191,36,0.20);
                    border-color: var(--warn);
                    box-shadow: 0 0 4px var(--warn);
                }

            .sip-legend .legend-swatch.shunt {
                width: 16px;
                height: 9px;
                border-radius: 50%;
                background: rgba(167,139,250,0.20);
                border: 1px solid var(--info);
            }

            .sip-legend .legend-swatch.pm {
                width: 18px;
                height: 11px;
                background: linear-gradient(135deg, rgba(34,211,238,0.40), rgba(167,139,250,0.30));
                border: 1px solid rgba(34,211,238,0.60);
                clip-path: polygon(15% 0, 85% 0, 100% 50%, 85% 100%, 15% 100%, 0 50%);
            }

            .sip-legend .legend-swatch.axc {
                width: 16px;
                height: 8px;
                border-radius: 3px;
                background: var(--glass-1);
                border: 1px solid var(--text-2);
            }

    .sip-tooltip {
        position: absolute;
        background: var(--bg-2);
        border: 1px solid var(--glass-edge-strong);
        border-radius: 8px;
        padding: 7px 10px;
        font-size: 11px;
        color: var(--text-1);
        pointer-events: none;
        z-index: 100;
        box-shadow: 0 8px 24px -8px rgba(0,0,0,0.5);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        white-space: nowrap;
        transform: translate(-50%, -100%);
        margin-top: -8px;
        opacity: 0;
        transition: opacity var(--t-fast);
    }

        .sip-tooltip.show {
            opacity: 1;
        }

        .sip-tooltip strong {
            color: var(--brand);
            font-family: 'JetBrains Mono', monospace;
            font-size: 11.5px;
        }

        .sip-tooltip .tt-meta {
            font-size: 10px;
            color: var(--text-3);
            margin-top: 2px;
            font-family: 'JetBrains Mono', monospace;
        }

    .sip-asset {
        cursor: pointer;
        transition: filter var(--t-fast);
    }

        .sip-asset:hover {
            filter: brightness(1.25);
        }

    .sip-block-label {
        fill: var(--text-1);
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
        text-anchor: middle;
        dominant-baseline: central;
        pointer-events: none;
        letter-spacing: 0.01em;
        transition: fill var(--t-fast);
    }

    .sip-track-block {
        fill: var(--glass-1);
        stroke: var(--text-3);
        stroke-width: 1.2;
        cursor: pointer;
        transition: fill var(--t-fast), stroke var(--t-fast), stroke-width var(--t-fast);
    }

    g.sip-asset[data-type="track"] .sip-block-label {
        font-size: 9.5px;
    }

    g.sip-asset[data-state="ok"] .sip-track-block {
        fill: rgba(52,211,153,0.10);
        stroke: rgba(52,211,153,0.55);
    }

    g.sip-asset[data-state="warn"] .sip-track-block {
        fill: rgba(251,191,36,0.14);
        stroke: rgba(251,191,36,0.62);
    }

    g.sip-asset[data-state="bad"] .sip-track-block {
        fill: rgba(251,113,133,0.14);
        stroke: rgba(251,113,133,0.62);
    }

    g.sip-asset[data-state="ok"][data-type="track"] .sip-block-label {
        fill: var(--ok);
    }

    g.sip-asset[data-state="warn"][data-type="track"] .sip-block-label {
        fill: var(--warn);
    }

    g.sip-asset[data-state="bad"][data-type="track"] .sip-block-label {
        fill: var(--bad);
    }

    .sip-sig-block {
        fill: rgba(167,139,250,0.10);
        stroke: var(--text-3);
        stroke-width: 1.2;
        cursor: pointer;
        transition: fill var(--t-fast), stroke var(--t-fast), filter var(--t-fast);
    }

    g.sip-asset[data-type="signal"] .sip-block-label {
        font-size: 8.5px;
        fill: var(--text-1);
    }

    g.sip-asset[data-type="signal"][data-aspect="green"] .sip-sig-block {
        fill: rgba(52,211,153,0.20);
        stroke: var(--ok);
        filter: drop-shadow(0 0 4px var(--ok));
    }

    g.sip-asset[data-type="signal"][data-aspect="yellow"] .sip-sig-block {
        fill: rgba(251,191,36,0.22);
        stroke: var(--warn);
        filter: drop-shadow(0 0 4px var(--warn));
    }

    g.sip-asset[data-type="signal"][data-aspect="red"] .sip-sig-block {
        fill: rgba(251,113,133,0.22);
        stroke: var(--bad);
        filter: drop-shadow(0 0 4px var(--bad));
    }

    .sip-shunt-block {
        fill: rgba(167,139,250,0.22);
        stroke: var(--info);
        stroke-width: 1.2;
        cursor: pointer;
        transition: fill var(--t-fast), stroke var(--t-fast);
    }

    g.sip-asset[data-type="shunt"] .sip-block-label {
        font-size: 8px;
        fill: var(--text-1);
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .sip-pm-block {
        fill: rgba(34,211,238,0.18);
        stroke: rgba(34,211,238,0.60);
        stroke-width: 1.4;
        cursor: pointer;
        transition: fill var(--t-fast), stroke var(--t-fast), filter var(--t-fast);
        filter: drop-shadow(0 0 4px var(--brand-glow));
    }

    g.sip-asset[data-type="pm"] .sip-block-label {
        fill: var(--brand);
        font-size: 8.5px;
        font-weight: 700;
    }

    .sip-axc-block {
        fill: var(--glass-1);
        stroke: var(--text-2);
        stroke-width: 1;
        cursor: pointer;
        transition: fill var(--t-fast), stroke var(--t-fast);
    }

    g.sip-asset[data-type="axc"] .sip-block-label {
        fill: var(--text-2);
        font-size: 7.5px;
        font-weight: 700;
        letter-spacing: 0.03em;
    }

    g.sip-asset[data-type="axc"][data-state="warn"] .sip-axc-block {
        fill: rgba(251,191,36,0.14);
        stroke: var(--warn);
    }

    g.sip-asset[data-type="axc"][data-state="warn"] .sip-block-label {
        fill: var(--warn);
    }
    /* Highlighted (single-click) */
    g.sip-asset.highlighted .sip-track-block,
    g.sip-asset.highlighted .sip-sig-block,
    g.sip-asset.highlighted .sip-shunt-block,
    g.sip-asset.highlighted .sip-pm-block,
    g.sip-asset.highlighted .sip-axc-block {
        fill: rgba(34,211,238,0.34);
        stroke: var(--brand);
        stroke-width: 2.4;
        filter: drop-shadow(0 0 12px var(--brand));
    }

    g.sip-asset.highlighted .sip-block-label {
        fill: var(--text-1);
        font-weight: 700;
    }

    g.sip-asset.selected .sip-track-block,
    g.sip-asset.selected .sip-sig-block,
    g.sip-asset.selected .sip-shunt-block,
    g.sip-asset.selected .sip-pm-block,
    g.sip-asset.selected .sip-axc-block {
        fill: rgba(244,114,182,0.32);
        stroke: var(--aurora-magenta);
        stroke-width: 2.4;
        filter: drop-shadow(0 0 12px var(--aurora-magenta));
    }

    g.sip-asset.selected .sip-block-label {
        fill: var(--aurora-magenta);
        font-weight: 700;
    }

    .inline-details-stack {
        display: flex;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 16px;
    }

        .inline-details-stack:empty {
            display: none;
        }

    .inline-detail {
        background: var(--glass-2);
        backdrop-filter: blur(24px) saturate(160%);
        -webkit-backdrop-filter: blur(24px) saturate(160%);
        border: 1px solid var(--glass-edge-strong);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-raised);
        overflow: hidden;
        position: relative;
        animation: sipSlideDown .32s cubic-bezier(.16,1,.3,1);
    }

        .inline-detail::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--accent, var(--brand)), transparent);
        }

        .inline-detail[data-state="ok"] {
            --accent: var(--ok);
        }

        .inline-detail[data-state="warn"] {
            --accent: var(--warn);
        }

        .inline-detail[data-state="bad"] {
            --accent: var(--bad);
        }

    @@keyframes sipSlideDown {
        from {
            opacity: 0;
            transform: translateY(-6px) scale(0.99);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .inline-detail-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        border-bottom: 1px solid var(--glass-edge);
        gap: 12px;
        flex-wrap: wrap;
    }

    .inline-detail-id {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .inline-detail-icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: var(--glass-1);
        border: 1px solid var(--glass-edge);
        color: var(--accent, var(--brand));
        font-size: 14px;
    }

    .inline-detail-name {
        font-family: 'Bricolage Grotesque', sans-serif;
        font-weight: 600;
        font-size: 16px;
        color: var(--text-1);
        letter-spacing: -0.015em;
    }

    .inline-detail-meta {
        font-size: 11px;
        color: var(--text-3);
        font-family: 'JetBrains Mono', monospace;
        margin-top: 2px;
    }

    .inline-detail-actions {
        display: flex;
        gap: 6px;
        align-items: center;
        flex-wrap: wrap;
    }

    .inline-state-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 4px 9px;
        border-radius: 999px;
        background: var(--glass-1);
        border: 1px solid var(--glass-edge);
    }

        .inline-state-pill .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            box-shadow: 0 0 6px currentColor;
        }

        .inline-state-pill[data-state="ok"] {
            color: var(--ok);
            border-color: rgba(52,211,153,0.30);
            background: rgba(52,211,153,0.08);
        }

        .inline-state-pill[data-state="warn"] {
            color: var(--warn);
            border-color: rgba(251,191,36,0.30);
            background: rgba(251,191,36,0.08);
        }

        .inline-state-pill[data-state="bad"] {
            color: var(--bad);
            border-color: rgba(251,113,133,0.30);
            background: rgba(251,113,133,0.08);
        }

        .inline-state-pill[data-state="ok"] .dot {
            background: var(--ok);
        }

        .inline-state-pill[data-state="warn"] .dot {
            background: var(--warn);
        }

        .inline-state-pill[data-state="bad"] .dot {
            background: var(--bad);
        }

    .inline-detail-close {
        width: 32px;
        height: 32px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        background: var(--glass-1);
        border: 1px solid var(--glass-edge);
        color: var(--text-3);
        font-size: 12px;
        cursor: pointer;
        transition: all var(--t-fast);
    }

        .inline-detail-close:hover {
            background: rgba(251,113,133,0.16);
            color: var(--bad);
            border-color: rgba(251,113,133,0.30);
        }

    .inline-detail-body {
        padding: 14px 16px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 10px;
    }

    .inline-metric {
        background: var(--glass-1);
        border: 1px solid var(--glass-edge);
        border-radius: 9px;
        padding: 10px 12px;
    }

        .inline-metric .lbl {
            font-family: 'JetBrains Mono', monospace;
            font-size: 10px;
            color: var(--text-3);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .inline-metric .val {
            font-family: 'JetBrains Mono', monospace;
            font-size: 16px;
            font-weight: 700;
            color: var(--text-1);
            margin-top: 2px;
            letter-spacing: -0.01em;
        }

            .inline-metric .val.ok {
                color: var(--ok);
            }

            .inline-metric .val.warn {
                color: var(--warn);
            }

            .inline-metric .val.bad {
                color: var(--bad);
            }

            .inline-metric .val.brand {
                color: var(--brand);
            }

    .inline-detail-foot {
        padding: 10px 16px;
        background: rgba(0,0,0,0.10);
        border-top: 1px solid var(--glass-edge);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        font-size: 11px;
        color: var(--text-3);
    }

    body[data-aurora="light"] .inline-detail-foot {
        background: rgba(255,255,255,0.40);
    }

    .jump-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 8px;
        background: var(--glass-1);
        border: 1px solid var(--glass-edge);
        color: var(--brand);
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all var(--t-fast);
    }

        .jump-btn:hover {
            background: var(--glass-3);
        }

    @@media (max-width: 1100px) {
        .at-page-header {
            flex-direction: column;
        }

        .sip-card {
            flex: 1 1 100%;
        }
    }

    @@media (max-width: 767px) {
        .sip-canvas {
            max-height: 140px;
        }
    }






    .sip-flash-row {
        animation: sipRowFlash 1.5s ease-out;
