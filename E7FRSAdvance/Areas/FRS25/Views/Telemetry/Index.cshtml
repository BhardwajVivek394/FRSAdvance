    .at-ws-badge {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 7px 16px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        flex-wrap: wrap;
    }

        .at-ws-badge.ws-live {
            background: rgba(52,211,153,0.12);
            border: 1px solid rgba(52,211,153,0.3);
            color: #34d399;
        }

        .at-ws-badge.ws-connecting {
            background: rgba(251,191,36,0.12);
            border: 1px solid rgba(251,191,36,0.3);
            color: #fbbf24;
        }

        .at-ws-badge.ws-error {
            background: rgba(251,113,133,0.12);
            border: 1px solid rgba(251,113,133,0.3);
            color: #fb7185;
        }

    .at-ws-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: currentColor;
        flex-shrink: 0;
        animation: atWsDot 1.8s ease-in-out infinite;
    }

    @@keyframes atWsDot {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .3;
        }
    }

    .at-ws-badge.ws-connecting .at-ws-dot, .at-ws-badge.ws-error .at-ws-dot {
        animation: none;
    }

    .at-ws-stats {
        display: flex;
        gap: 12px;
        font-size: 11px;
        opacity: .8;
    }

    .view-mode-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 10px;
        font-weight: 600;
        padding: 2px 7px;
        border-radius: 999px;
        margin-left: 4px;
        background: rgba(34,211,238,0.14);
        border: 1px solid rgba(34,211,238,0.26);
        color: var(--at-brand,#22d3ee);
    }

    .dropdown-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 99;
    }

        .dropdown-backdrop.show {
            display: block;
        }

    .at-tabbar {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        padding: 10px 16px 6px;
        background: var(--at-glass,rgba(255,255,255,0.03));
        border-bottom: 1px solid var(--at-edge,rgba(255,255,255,0.06));
    }

    .at-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 16px;
        border-radius: 8px;
        border: 1px solid transparent;
        font-size: 12.5px;
        font-weight: 600;
        font-family: var(--at-font-body,'Manrope',sans-serif);
        cursor: pointer;
        transition: all .18s;
        background: none;
        color: var(--at-t3,rgba(255,255,255,0.50));
    }

        .at-tab-btn:hover {
            background: var(--at-g2,rgba(255,255,255,0.06));
            color: var(--at-t1,rgba(255,255,255,0.96));
        }

        .at-tab-btn.active {
            background: rgba(34,211,238,0.14);
            border-color: rgba(34,211,238,0.32);
            color: var(--at-brand,#22d3ee);
        }

    .at-kpi-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--at-edge,rgba(255,255,255,0.06));
    }

    .at-kpi {
        flex: 1;
        min-width: 140px;
        padding: 12px 16px;
        border-radius: 12px;
        background: var(--at-g1,rgba(255,255,255,0.04));
        border: 1px solid var(--at-edge,rgba(255,255,255,0.08));
    }

    .at-kpi-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 6px;
    }

    .at-kpi-label {
        font-size: 11px;
        font-weight: 600;
        color: var(--at-t3,rgba(255,255,255,0.50));
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .at-kpi-value {
        font-size: 24px;
        font-weight: 800;
        font-family: var(--at-font-display,'Bricolage Grotesque',sans-serif);
        color: var(--at-t1,rgba(255,255,255,0.96));
        margin-top: 2px;
    }

    .at-kpi-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        background: rgba(34,211,238,0.12);
        color: var(--at-brand,#22d3ee);
    }

