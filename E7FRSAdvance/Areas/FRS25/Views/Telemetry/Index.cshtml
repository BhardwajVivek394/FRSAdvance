@{ ViewBag.Title = "Telemetry Live";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml"; }


<link rel="stylesheet" href="~/Areas/FRS25/assets/css/aurora-telemetry.css" />
<style>


    * {
        box-sizing: border-box;
    }

    .pm-card-flash-anim {
        animation: pmCardFlash 1s ease-out;
    }

    @@keyframes pmCardFlash {
        0% {
            box-shadow: 0 0 0 3px rgba(37,157,171,0.35);
        }

        100% {
            box-shadow: none;
        }
    }

    .pm-val-flash-anim {
        animation: pmValFlash 1.2s ease-out;
    }

    @@keyframes pmValFlash {
        0% {
            background-color: #bbf7d0 !important;
        }

        100% {
            background-color: transparent;
        }
    }

    .pm-badge-shine {
        position: relative;
        overflow: hidden;
    }

        .pm-badge-shine::before {
            content: '';
            position: absolute;
            top: 0;
            left: -75%;
            width: 50%;
            height: 100%;
            background: linear-gradient(120deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0.5) 50%, rgba(255,255,255,0.15) 100%);
            transform: skewX(-20deg);
            animation: pmShine 2.5s infinite;
        }

    @@keyframes pmShine {
        0% {
            left: -75%;
        }

        100% {
            left: 125%;
        }
    }

    .pm-waiting-text {
        font-size: 11px;
        color: #94a3b8;
        font-style: italic;
    }


    .ips-grid-container {
        padding: 16px;
    }

    .ips-grid-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        padding-bottom: 12px;
        border-bottom: 2px solid #259dab;
    }

        .ips-grid-header h6 {
            font-size: 15px;
            font-weight: 700;
            color: #042c43;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .ips-grid-badge {
        background: linear-gradient(135deg, #259dab 0%, #0a4a6e 100%);
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        letter-spacing: 0.03em;
    }

    .ips-card-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    @@media (max-width: 1400px) {
        .ips-card-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 1024px) {
        .ips-card-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 640px) {
        .ips-card-grid {
            grid-template-columns: 1fr;
        }
    }

    .ips-asset-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        transition: box-shadow 0.25s ease, transform 0.25s ease;
    }

        .ips-asset-card:hover {
            box-shadow: 0 6px 20px rgba(0,0,0,0.12);
            transform: translateY(-2px);
        }

        .ips-asset-card.ips-card-flash {
            animation: ipsCardFlash 1s ease-out;
        }

    @@keyframes ipsCardFlash {
        0% {
            box-shadow: 0 0 0 3px rgba(37,157,171,0.4);
        }

        100% {
            box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        }
    }

    .ips-card-head {
        background: linear-gradient(135deg, #042c43 0%, #0a4a6e 100%);
        padding: 10px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

        .ips-card-head .ips-asset-name {
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .ips-card-head .ips-status-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: #10b981;
            flex-shrink: 0;
            box-shadow: 0 0 5px rgba(16,185,129,0.7);
            animation: ipsPulse 2s infinite;
        }

    @@keyframes ipsPulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.4;
        }
    }

    .ips-attr-list {
        padding: 10px 14px;
        display: flex;
        flex-direction: column;
        gap: 4px;
        max-height: 280px;
        overflow-y: auto;
    }

    .ips-attr-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        font-size: 12px;
        padding: 3px 0;
        border-bottom: 1px dashed #f1f5f9;
        gap: 6px;
    }

        .ips-attr-row:last-child {
            border-bottom: none;
        }

        .ips-attr-row .ips-attr-name {
            color: #64748b;
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 55%;
            flex-shrink: 0;
        }

        .ips-attr-row .ips-attr-val {
            color: #0d9488;
            font-weight: 700;
            text-align: right;
            white-space: nowrap;
        }

            .ips-attr-row .ips-attr-val.no-data {
                color: #94a3b8;
                font-style: italic;
                font-weight: 400;
            }

    .ips-val-flash {
        animation: ipsValFlash 1.2s ease-out;
    }

    @@keyframes ipsValFlash {
        0% {
            background-color: #bbf7d0;
        }

        100% {
            background-color: transparent;
        }
    }

    .ips-card-footer {
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        padding: 7px 14px;
        font-size: 10.5px;
        color: #94a3b8;
        display: flex;
        align-items: center;
        gap: 5px;
    }

        .ips-card-footer i {
            color: #259dab;
        }

    .ips-waiting-card {
        grid-column: 1 / -1;
        text-align: center;
        padding: 40px 20px;
        color: #94a3b8;
        font-size: 14px;
    }

    .pm-chart-wrap {
        border: 1px solid #e8edf2;
        border-radius: 14px;
        padding: 0;
        background: #ffffff;
        min-height: 440px;
        position: relative;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06), 0 4px 16px rgba(0,0,0,0.04);
        transition: box-shadow 0.25s ease, transform 0.25s ease;
        overflow: hidden;
    }

        .pm-chart-wrap:hover {
            box-shadow: 0 4px 20px rgba(0,0,0,0.10), 0 1px 4px rgba(0,0,0,0.06);
            transform: translateY(-1px);
        }

        .pm-chart-wrap canvas {
            height: 360px !important;
            width: 100% !important;
        }

    .pm-chart-label {
        font-size: 13px;
        font-weight: 600;
        text-align: left;
        color: #1e293b;
        margin-bottom: 0;
    }

    .pm-seemore-section {
        background: #0a0f24;
        border-top: 1px solid #e8edf2;
        padding: 24px;
    }

    .pm-seemore-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        padding-bottom: 14px;
        border-bottom: 2px solid #259dab;
    }

        .pm-seemore-header h6 {
            font-size: 15px;
            font-weight: 700;
            color: #042c43;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .pm-seemore-header h6::before {
                content: '\f201';
                font-family: 'Font Awesome 5 Free';
                font-weight: 900;
                color: #259dab;
            }

    .pm-waveform-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    @@media (max-width: 1200px) {
        .pm-waveform-grid {
            grid-template-columns: 1fr;
        }
    }

    .pm-wave-box {
        margin-bottom: 0 !important;
    }

    .pm-chart-wrap > div:first-child {
        font-size: 13px !important;
        font-weight: 600 !important;
        color: #0a0f24 !important;
        margin-bottom: 0 !important;
        padding: 11px 16px !important;
        background: #1e293b !important;
        border-radius: 0 !important;
        border-left: none !important;
        border-bottom: 1px solid rgba(255,255,255,0.08) !important;
        letter-spacing: 0.01em !important;
    }

    .pm-card-wrapper {
        background: rgba(255,255,255,0.04);
        backdrop-filter: blur(24px) saturate(160%);
        -webkit-backdrop-filter: blur(24px) saturate(160%);
        border: 1px solid rgba(255,255,255,0.09);
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 20px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.36), 0 1px 0 rgba(255,255,255,0.07) inset;
        transition: transform .18s, box-shadow .18s;
    }

        .pm-card-wrapper:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.44), 0 1px 0 rgba(255,255,255,0.09) inset;
        }

    .pm-card-header {
        background: linear-gradient(135deg, rgba(34,211,238,0.14) 0%, rgba(167,139,250,0.10) 100%);
        border-bottom: 1px solid rgba(255,255,255,0.09);
        padding: 14px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .pm-card-header-left h4 {
        color: rgba(255,255,255,0.96);
        font-family: 'Bricolage Grotesque', sans-serif;
        font-size: 15px;
        font-weight: 700;
        margin: 0;
        letter-spacing: -0.01em;
    }

    .pm-card-header-left .pm-index-score {
        color: rgba(255,255,255,0.42);
        font-size: 11px;
        font-family: 'JetBrains Mono', monospace;
        margin: 2px 0 0;
    }

    .pm-card-header-right .btn-event-log {
        background: linear-gradient(135deg, #e85d04, #c2410c);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 7px 14px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 4px 12px rgba(232,93,4,0.30);
        transition: all .18s;
    }

        .pm-card-header-right .btn-event-log:hover {
            background: linear-gradient(135deg, #c2410c, #9a3412);
            box-shadow: 0 4px 16px rgba(232,93,4,0.45);
        }

    .pm-badges-row {
        padding: 10px 16px;
        background: rgba(0,0,0,0.18);
        border-bottom: 1px solid rgba(255,255,255,0.07);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
    }

    .pm-irs-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        color: rgba(255,255,255,0.72);
        font-family: 'JetBrains Mono', monospace;
    }

    .pm-irs-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
    }

        .pm-irs-dot.orange {
            background: #f59e0b;
            box-shadow: 0 0 6px #f59e0b;
        }

        .pm-irs-dot.green {
            background: #10b981;
