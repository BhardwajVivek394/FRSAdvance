            flex: 1;
        }

    .tl-f-dd-menu {
        position: absolute;
        top: calc(100% + 4px);
        left: 0;
        min-width: 240px;
        max-width: 320px;
        max-height: 360px;
        background: rgba(8,14,36,0.98);
        border: 1px solid rgba(34,211,238,0.18);
        border-radius: 10px;
        box-shadow: 0 12px 40px rgba(0,0,0,0.55);
        z-index: 9999;
        display: none;
        flex-direction: column;
        overflow: hidden;
    }

        .tl-f-dd-menu.show {
            display: flex;
        }

    .tl-f-dd-search-wrap {
        padding: 8px;
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .tl-f-dd-search {
        width: 100%;
        height: 30px;
        background: rgba(255,255,255,0.06);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 6px;
        padding: 0 8px;
        color: rgba(255,255,255,0.9);
        font-size: 12px;
        outline: none;
    }

        .tl-f-dd-search:focus {
            border-color: rgba(34,211,238,0.5);
        }

    .tl-f-dd-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        cursor: pointer;
        font-size: 12px;
        color: rgba(255,255,255,0.8);
        border-bottom: 1px solid rgba(255,255,255,0.04);
        transition: background 0.12s;
        margin: 0;
    }

        .tl-f-dd-item:hover {
            background: rgba(34,211,238,0.08);
        }

        .tl-f-dd-item.checked {
            background: rgba(34,211,238,0.14);
            color: #67e8f9;
        }

        .tl-f-dd-item.hidden {
            display: none !important;
        }

        .tl-f-dd-item input[type="checkbox"] {
            margin: 0;
            accent-color: #22d3ee;
            flex-shrink: 0;
            width: 15px;
            height: 15px;
            cursor: pointer;
        }

    .tl-f-dd-select-all {
        background: rgba(255,255,255,0.03);
        font-weight: 600;
        color: rgba(255,255,255,0.9);
        border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .tl-f-dd-divider {
        height: 1px;
        background: rgba(255,255,255,0.06);
    }

    .tl-f-dd-list {
        max-height: 240px;
        overflow-y: auto;
        padding: 2px 0;
    }

        .tl-f-dd-list::-webkit-scrollbar {
            width: 6px;
        }

        .tl-f-dd-list::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.18);
            border-radius: 3px;
        }

        /* Dropdown items inside the list (dynamically created) */
        .tl-f-dd-list .dropdown-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 7px 12px;
            cursor: pointer;
            font-size: 12px;
            color: rgba(255,255,255,0.8);
            border-bottom: 1px solid rgba(255,255,255,0.04);
            transition: background 0.12s;
            background: transparent;
        }

            .tl-f-dd-list .dropdown-item:hover {
                background: rgba(34,211,238,0.08);
            }

            .tl-f-dd-list .dropdown-item.checked {
                background: rgba(34,211,238,0.14);
                color: #67e8f9;
            }

            .tl-f-dd-list .dropdown-item.hidden {
                display: none !important;
            }

            .tl-f-dd-list .dropdown-item input[type="checkbox"] {
                margin: 0;
                accent-color: #22d3ee;
                flex-shrink: 0;
                width: 15px;
                height: 15px;
                cursor: pointer;
            }

        .tl-f-dd-list .dropdown-empty {
            padding: 18px 12px;
            text-align: center;
            color: rgba(255,255,255,0.35);
            font-size: 12px;
        }

    /* ── Filter action buttons ── */
    .tl-f-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 32px;
        padding: 0 12px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: all 0.18s;
        flex-shrink: 0;
        font-family: var(--at-font-body,'Manrope',sans-serif);
    }

    .tl-f-btn-search {
        background: linear-gradient(135deg, #0a4a6e, #259dab);
        color: #fff;
    }

        .tl-f-btn-search:hover {
            filter: brightness(1.2);
        }

    .tl-f-btn-secondary {
        background: linear-gradient(135deg, #0e5068, #145f78);
        color: #fff;
    }

        .tl-f-btn-secondary:hover {
            filter: brightness(1.2);
        }

    /* ── Asset Type Strip (inside tl-top-left, below filters) ── */
    .tl-type-strip {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 6px 0 2px;
        margin-top: 6px;
        border-top: 1px solid rgba(255,255,255,0.06);
        overflow: visible;
        width: 100%;
        flex-wrap: wrap;
    }

        .tl-type-strip::-webkit-scrollbar {
            display: none;
        }

    .tl-top-right {
        flex: 1 1 0;
        min-width: 280px;
        max-width: 600px;
        margin-left: auto;
    }

    @@media (max-width: 860px) {
        .tl-top-row {
            flex-direction: column !important;
        }

        .tl-top-right {
            max-width: 100%;
            margin-left: 0;
        }
    }

    /* ── SIP card in top-bar — high specificity to override sip-mini-mode ── */
    .sip-card.sip-card-topbar,
    body.sip-mini-mode .sip-card.sip-card-topbar {
        position: relative !important;
        width: 100% !important;
        max-width: 100% !important;
        flex: none !important;
        min-width: 0 !important;
        min-height: 0 !important;
        height: auto !important;
        padding: 0 !important;
        border-radius: 10px !important;
        box-shadow: 0 3px 14px rgba(0,0,0,0.30) !important;
        background: rgba(12,18,35,0.97) !important;
        border: 1px solid rgba(255,255,255,0.08) !important;
        overflow: hidden !important;
        transition: box-shadow .2s, border-color .2s;
        cursor: default !important;
        align-self: auto !important;
    }

        .sip-card.sip-card-topbar::before,
        body.sip-mini-mode .sip-card.sip-card-topbar::before {
            display: none !important;
        }

        .sip-card.sip-card-topbar:hover,
        body.sip-mini-mode .sip-card.sip-card-topbar:hover {
            box-shadow: 0 5px 20px rgba(0,0,0,0.40) !important;
            border-color: rgba(52,211,153,0.18) !important;
            transform: none !important;
        }

        .sip-card.sip-card-topbar .sip-card-head,
        body.sip-mini-mode .sip-card.sip-card-topbar .sip-card-head {
            padding: 6px 10px !important;
            border-bottom: 1px solid rgba(255,255,255,0.06) !important;
            margin-bottom: 0 !important;
            gap: 6px !important;
            flex-wrap: nowrap !important;
            display: flex !important;
            align-items: center !important;
            cursor: grab;
        }

            .sip-card.sip-card-topbar .sip-card-head:active {
                cursor: grabbing;
            }

        .sip-card.sip-card-topbar .sip-title-row,
        body.sip-mini-mode .sip-card.sip-card-topbar .sip-title-row {
            flex-direction: row !important;
            align-items: center !important;
            gap: 6px !important;
            min-width: 0 !important;
            flex: 1 !important;
        }

        .sip-card.sip-card-topbar .sip-title,
        body.sip-mini-mode .sip-card.sip-card-topbar .sip-title {
            font-size: 11.5px !important;
            font-weight: 600 !important;
            color: rgba(255,255,255,0.85) !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
        }

        .sip-card.sip-card-topbar .sip-sub,
        body.sip-mini-mode .sip-card.sip-card-topbar .sip-sub {
            display: none !important;
        }

        .sip-card.sip-card-topbar .sip-canvas,
        body.sip-mini-mode .sip-card.sip-card-topbar .sip-canvas {
            display: block !important;
            max-height: 200px !important;
            min-height: 80px !important;
            overflow-x: auto !important;
            overflow-y: hidden !important;
        }

        .sip-card.sip-card-topbar .sip-mini-thumb,
        body.sip-mini-mode .sip-card.sip-card-topbar .sip-mini-thumb {
            display: none !important;
        }

        .sip-card.sip-card-topbar .sip-mini-foot,
        body.sip-mini-mode .sip-card.sip-card-topbar .sip-mini-foot {
            display: flex !important;
            justify-content: space-between;
            padding: 4px 10px !important;
            font-size: 9px !important;
            color: rgba(255,255,255,0.40);
            border-top: 1px solid rgba(255,255,255,0.04);
            font-family: 'JetBrains Mono', monospace;
        }

            .sip-card.sip-card-topbar .sip-mini-foot strong {
                color: rgba(255,255,255,0.80);
            }

        .sip-card.sip-card-topbar .sip-mini-pulse,
        body.sip-mini-mode .sip-card.sip-card-topbar .sip-mini-pulse {
            width: 6px !important;
            height: 6px !important;
            border-radius: 50% !important;
            background: #34d399 !important;
            display: inline-block !important;
            animation: sipMiniPulse 1.6s ease-out infinite !important;
            flex-shrink: 0 !important;
        }

        .sip-card.sip-card-topbar .sip-controls,
        body.sip-mini-mode .sip-card.sip-card-topbar .sip-controls {
            display: inline-flex !important;
            gap: 4px !important;
        }

        body.sip-mini-mode .sip-card.sip-card-topbar #sipClearBtn,
        body.sip-mini-mode .sip-card.sip-card-topbar #sipCompareToggle {
            display: none !important;
        }

        .sip-card.sip-card-topbar .sip-legend,
        body.sip-mini-mode .sip-card.sip-card-topbar .sip-legend {
            display: none !important;
        }

        .sip-card.sip-card-topbar #sipFullscreenBtn {
            width: 24px;
            height: 24px;
            padding: 0;
            margin: 0;
            background: rgba(255,255,255,0.06);
            border: none;
            border-radius: 5px;
            font-size: 10px;
            color: rgba(255,255,255,0.55);
            cursor: pointer;
            transition: all .15s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .sip-card.sip-card-topbar #sipFullscreenBtn:hover {
                background: rgba(52,211,153,0.15);
                color: rgba(255,255,255,0.95);
            }

        /* SIP card being dragged */
        .sip-card.sip-card-topbar.sip-dragging {
            opacity: 0.9;
            box-shadow: 0 12px 40px rgba(0,0,0,0.55) !important;
            z-index: 9999;
        }

        /* Fullscreen override */
        .sip-card.sip-card-topbar.fullscreen,
        body.sip-mini-mode .sip-card.sip-card-topbar.fullscreen {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 !important;
            border-radius: 0 !important;
            z-index: 10000 !important;
            padding: 0 !important;
        }

            .sip-card.sip-card-topbar.fullscreen .sip-canvas,
            body.sip-mini-mode .sip-card.sip-card-topbar.fullscreen .sip-canvas {
                display: block !important;
                max-height: none !important;
                min-height: 0 !important;
                height: calc(100vh - 60px) !important;
            }

            .sip-card.sip-card-topbar.fullscreen .sip-sub {
                display: block !important;
            }

            .sip-card.sip-card-topbar.fullscreen .sip-mini-thumb,
            .sip-card.sip-card-topbar.fullscreen .sip-mini-foot,
            body.sip-mini-mode .sip-card.sip-card-topbar.fullscreen .sip-mini-thumb,
            body.sip-mini-mode .sip-card.sip-card-topbar.fullscreen .sip-mini-foot {
                display: none !important;
            }

            .sip-card.sip-card-topbar.fullscreen .sip-legend {
                display: flex !important;
            }
    .at-card-name {
        cursor: pointer;
    }

        .at-card-name:hover {
            text-decoration: underline;
            color: #00d4ff;
        }
</style>

<div class="toast-container" id="toastContainer"></div>

@* ═══════════════════════════════════════════════════════════════
    HEADER + INTEGRATED FILTERS — title on left, SIP on right,
    filter dropdowns directly below title (no blank gap)
    ═══════════════════════════════════════════════════════════════ *@
<div class="at-page-header tl-top-row">
    <div class="tl-top-left">
        <div class="at-page-eyebrow"><i class="fas fa-satellite-dish"></i> RDPMS · Live</div>
        <h1 class="at-page-title">Telemetry Live</h1>
        <p class="at-page-sub">Real-time asset data via WebSocket streaming</p>

        @* ── Filter controls embedded below title ── *@
        <div class="tl-filters-row" id="tlFiltersRow">
            <div class="dropdown-backdrop" id="backdrop"></div>
            <div class="tl-f-group">
                <span class="tl-f-label">Zone</span>
                @Html.DropDownList("ZoneId", (IEnumerable<SelectListItem>)ViewBag.Zones, "All", new { @class = "tl-f-select", @id = "drpZones", tabindex = 1 })
            </div>
            <div class="tl-f-group">
                <span class="tl-f-label">Division</span>
                @Html.DropDownList("DivisionId", (IEnumerable<SelectListItem>)ViewBag.Divisions, "All", new { @class = "tl-f-select", @id = "drpDivisions", tabindex = 2 })
            </div>
            <div class="tl-f-group">
                <span class="tl-f-label">Station</span>
                @Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites, "All", new { @class = "tl-f-select", @id = "drpSite", tabindex = 3 })
            </div>


            <button type="button" class="tl-f-btn tl-f-btn-secondary" onclick="_ptOpenFromTelemetryLive()" title="Panel Test"><i class="fas fa-tasks"></i> Panel Test</button>
        </div>

        @* ── Asset Type pills strip (inside header, below filters) ── *@
        <select id="drpAssetType" style="display:none;" aria-hidden="true" tabindex="-1">
            <option value="">All</option>
            @foreach (var at in (IEnumerable<SelectListItem>)ViewBag.AssetTypes)
            {
                <option value="@at.Value">@at.Text</option>
            }
        </select>
        <div class="tl-type-strip" id="atpStrip" style="display:none;">
            <span class="atp-inline-label"><i class="fas fa-cubes"></i> Type</span>
            <div class="atp-pills-row">
                <div class="atp-pills atp-pills-inline" id="atpPills">
                    <!-- Populated dynamically from #drpAssetType options by atpRebuildPills() -->
                </div>
                <button type="button" class="atp-expand-btn" id="atpExpandBtn" title="Show all types" style="display:none;">
                    <i class="fas fa-plus"></i>
                </button>
            </div>
            <div class="atp-sub-pills" id="atpSubPills" style="display:none;"></div>
            <div style="margin-left:auto;display:flex;align-items:center;gap:5px;flex-shrink:0;">
                @*<input type="text" class="atp-search" id="atpSearch" placeholder="Search asset" oninput="atpFilterCards(this.value)" style="width:130px;height:26px;font-size:11px;padding:3px 8px;">*@
                <span class="atp-count" id="atpCount" style="font-size:11px;white-space:nowrap;"></span>
                <button class="at-btn at-btn-sm" id="btnRefresh" onclick="refreshApiData()" title="Refresh" style="display:none;"><i class="fas fa-sync-alt"></i></button>

                @* ── Asset Number (same line as type pills, before Export) ── *@
                <div id="assetNumberFieldWrap" style="display:none;position:relative;z-index:300;">
                    <div style="display:flex;align-items:center;gap:4px;">
                        <span class="tl-f-label" style="white-space:nowrap;">Asset No</span>
                        <div class="custom-dropdown" id="assetNumberDropdown" style="position:relative;">
                            <button type="button" class="tl-f-select tl-f-dd-btn" id="btnAssetNumberToggle" tabindex="4" aria-haspopup="true" aria-expanded="false" style="min-width:130px;">
                                <span id="txtAssetNumber">All</span>
                                <i class="fas fa-chevron-down" style="font-size:9px;opacity:.5;margin-left:auto;"></i>
                            </button>
                            <div class="tl-f-dd-menu" id="assetNumberMenu" role="menu">
                                <div class="tl-f-dd-search-wrap">
                                    <input type="text" id="txtAssetNumberSearch" class="tl-f-dd-search" placeholder="Search asset…" autocomplete="off">
                                </div>
                                <label class="tl-f-dd-item tl-f-dd-select-all">
                                    <input type="checkbox" id="chkAllAssetNumber"> <span>Select All</span>
                                </label>
                                <div class="tl-f-dd-divider"></div>
                                <div id="listAssetNumber" class="tl-f-dd-list">
                                    <div class="dropdown-empty">Select Station &amp; Asset Type first</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="dropdown" id="downloadContainer" style="display:none;">
                    <button class="at-btn at-btn-sm" id="btnDownload" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Export">
                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path d="M4 16.004V17a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1M12 4.5v11m3.5-3.5L12 15.5 8.5 12" /></svg>
                        Export
                    </button>
                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="btnDownload">
                        <a class="dropdown-item" href="javascript:void(0);" onclick="fnDownloadExcel()"><i class="fa fa-file-excel mr-2" style="color:#22c55e;"></i> Excel</a>
                        <a class="dropdown-item" href="javascript:void(0);" onclick="fnDownloadCSV()"><i class="fa fa-file-alt mr-2" style="color:#3b82f6;"></i> CSV</a>
                    </div>
                </div>
            </div>
        </div>


        <div id="wsStatusBar" style="display:none;padding:6px 16px;"></div>



    </div>
    <div class="tl-top-right">
        @* ── SIP Schematic — top right, opposite the heading ── *@
        <section class="sip-card sip-card-topbar" id="sipCardSection" aria-label="Station yard schematic">
            <div class="sip-card-head">
                <div class="sip-title-row">
                    <div class="sip-title-row">
                        <div class="sip-title">
                            <span class="sip-mini-pulse" aria-hidden="true"></span>
                            <i class="fa-solid fa-diagram-project"></i>
                            <span>Schematic</span>
                            <span style="color:rgba(255,255,255,0.45);font-weight:400;">·</span>
                            <span id="sipSiteName" style="color:rgba(255,255,255,0.45);font-weight:400;">Select a site</span>
                        </div>
                        <div class="sip-sub">Real-time from WebSocket · click asset to jump</div>
                    </div>
                    <div class="sip-sub">Real-time from WebSocket · click asset to jump</div>
                </div>
                <div class="sip-controls" id="sipControls" style="display:none;">
                    <button class="sip-clear" id="sipClearBtn" style="display:none;">
                        <i class="fa-solid fa-xmark"></i> Clear
                    </button>
                    <button class="compare-toggle" id="sipCompareToggle">
                        <i class="fa-solid fa-layer-group"></i> Compare: <strong id="compareState">Off</strong>
                    </button>
                    <button class="sip-fullscreen-btn" id="sipFullscreenBtn" title="Full screen">
                        <i class="fas fa-expand"></i>
                    </button>
                </div>
            </div>
            <div class="sip-canvas" id="sipCanvas" style="overflow-x:auto;max-height:180px;min-height:120px;">
                <div id="sipWaiting" style="display:flex;align-items:center;justify-content:center;height:120px;color:rgba(255,255,255,0.35);font-size:12px;gap:8px;">
                    <i class="fas fa-diagram-project" style="font-size:18px;opacity:0.4;"></i>
                    Select site & asset type to load schematic
                </div>
            </div>
            <div class="sip-mini-thumb" aria-hidden="true"></div>
            <div class="sip-mini-foot">
                <span><strong id="sipMiniAssetCount">0</strong> assets · live</span>
                <span id="sipMiniStats">awaiting data</span>
            </div>
            <div class="sip-legend" id="sipLegend" style="display:none;">
                <span class="legend-item"><span class="legend-swatch"></span>Track clear</span>
                <span class="legend-item"><span class="legend-swatch signal r"></span>Signal red</span>
                <span class="legend-item"><span class="legend-swatch signal y"></span>Yellow</span>
                <span class="legend-item"><span class="legend-swatch signal"></span>Green</span>
                <span class="legend-item"><span class="legend-swatch shunt"></span>Shunt</span>
                <span class="legend-item"><span class="legend-swatch pm"></span>Point machine</span>
                <span class="legend-item"><span class="legend-swatch axc"></span>Axle counter</span>
            </div>
        </section>
    </div>
</div>

@* Hidden selects for JS state *@
<select id="drpAsset" style="display:none;" aria-hidden="true" tabindex="-1"><option value="">All</option></select>
<select id="drpView" style="display:none;" aria-hidden="true" tabindex="-1">
    <option value="Table">Table</option>
    <option value="Cards">Cards</option>
    <option value="RDPMS">RDPMS</option>
    <option value="IPS">IPS</option>
</select>

<div class="inline-details-stack" id="inlineDetailsStack" aria-live="polite"></div>



<!-- Inline back-bar: visible only while a per-asset Graph/Circuit overlay is active -->
<div class="tl-back-bar" id="tlBackBar" style="display:none;">
    <button type="button" class="tl-back-btn" onclick="tlReturnFromAssetView()"><i class="fas fa-arrow-left"></i> Back to <span id="tlBackTo">List</span></button>
    <span class="tl-back-context" id="tlBackContext"></span>
</div>

@*<div id="wsStatusBar" style="display:none;padding:6px 16px;"></div>*@

<div class="at-table-card">
    <div class="at-table-card-head">
        <div class="at-table-card-title"><span class="at-t-icon"><i class="fas fa-satellite-dish"></i></span> Live Asset Data</div>
        <div class="at-table-card-actions">
            <span id="dataSourceInfo" style="font-size:11px;color:var(--at-t3);"></span>

            <!-- Card / Grid view toggle — mirrors the existing Cards/Table tabs but
             as a compact icon segmented control. Drives atSwitchView() so all
             the existing rendering/refresh logic runs unchanged. -->
            <div class="tl-vmode" role="group" aria-label="View mode">
                <button type="button" class="tl-vmode-btn active" data-vmode="Cards" title="Card view" aria-pressed="true">
