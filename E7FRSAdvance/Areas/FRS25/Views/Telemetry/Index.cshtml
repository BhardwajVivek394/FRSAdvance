            width: calc(25px * var(--rdpms-scale));
            height: calc(25px * var(--rdpms-scale));
            border-radius: 50%;
            position: absolute;
            top: calc(38px * var(--rdpms-scale));
            left: calc(38px * var(--rdpms-scale));
        }

            .rdpms-shunt .rdpms-white:nth-child(3) {
                left: calc(93px * var(--rdpms-scale));
                top: calc(86px * var(--rdpms-scale));
            }

            .rdpms-shunt .rdpms-white:nth-child(4) {
                left: calc(20px * var(--rdpms-scale));
                top: calc(88px * var(--rdpms-scale));
            }

    .rdpms-route-table {
