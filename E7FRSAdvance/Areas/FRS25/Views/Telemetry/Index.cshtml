        width: calc(50px * var(--rdpms-scale));
        height: calc(50px * var(--rdpms-scale));
        position: absolute;
        top: calc(-50px * var(--rdpms-scale));
        left: 50%;
        transform: translateX(-50%);
        border-radius: 50%;
        border: solid 2px #2a2a2a;
        z-index: 1;
