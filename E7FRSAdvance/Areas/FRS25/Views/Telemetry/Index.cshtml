            e.stopPropagation();
            var nowOpen = !$menu.hasClass('show');
            $menu.toggleClass('show', nowOpen);
            $toggle.attr('aria-expanded', nowOpen ? 'true' : 'false');
            if (nowOpen) { setTimeout(function () { $search.trigger('focus'); }, 30); }
        });

        // ── Close on outside click ────────────────────────────────
        $(document).on('click', function (e) {
            if (!$wrap[0].contains(e.target)) {
                $menu.removeClass('show');
                $toggle.attr('aria-expanded', 'false');
            }
        });

        // ── Search filter inside menu ─────────────────────────────
        $search.on('input', function () {
            var q = ($(this).val() || '').trim().toLowerCase();
            $list.children('.dropdown-item').each(function () {
                var txt = ($(this).attr('data-text') || $(this).text() || '').toLowerCase();
                $(this).toggleClass('hidden', !(q === '' || txt.indexOf(q) > -1));
            });
            // refresh "Select All" state for the visible subset
            if (typeof window.updateSelectAllState === 'function') updateSelectAllState();
        });

