            $('#atpStrip').show();

            var currentVal = String($drp.val() || '');
            var pillCount = 0;

            opts.each(function () {
                var $o = $(this);
                var val = String($o.val());
                var text = ($o.text() || '').trim();
                if (val === '' || val === '0') return;

                var iconSvg = getAssetTypeIcon(text);
                var $pill = $('<span class="atp-pill"></span>')
                    .attr('data-val', val)
                    .html(iconSvg + ' ' + text.toUpperCase());

                if (val === currentVal) $pill.addClass('active');

                if (pillCount >= ATP_VISIBLE_COUNT) {
                    $pill.addClass('atp-pill-overflow');
                }
                pillCount++;
                $pillBox.append($pill);
            });

            var $expandBtn = $('#atpExpandBtn');
            var overflowCount = pillCount - ATP_VISIBLE_COUNT;
            if (overflowCount > 0) {
                $expandBtn.show().attr('title', 'Show ' + overflowCount + ' more type' + (overflowCount > 1 ? 's' : ''));
                if ($pillBox.find('.atp-pill-overflow.active').length > 0) {
                    $pillBox.addClass('atp-expanded');
                    $expandBtn.addClass('expanded');
                }
            } else {
                $expandBtn.hide();
            }

            atpUpdateCount();
            atpAutoPickTrack();
