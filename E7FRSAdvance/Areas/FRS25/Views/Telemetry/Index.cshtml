        font-family: 'JetBrains Mono', monospace;
    }

        .pm-data-table tbody td.col-a {
            background: rgba(34,211,238,0.04);
        }

        .pm-data-table tbody td.col-b {
            background: rgba(167,139,250,0.04);
        }

        .pm-data-table tbody td .pm-current-val {
            color: #22d3ee;
            font-weight: 700;
        }

        .pm-data-table tbody td .pm-current-val-b {
