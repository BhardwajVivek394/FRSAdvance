        background: var(--at-glass,rgba(255,255,255,0.03));
        border: 1px solid var(--at-edge,rgba(255,255,255,0.06));
        border-radius: 16px;
        overflow: visible;
        margin: 2px 0 0;
    }

    .at-table-card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-bottom: 1px solid var(--at-edge,rgba(255,255,255,0.06));
    }

    .at-table-card-title {
        display: flex;
        align-items: center;
