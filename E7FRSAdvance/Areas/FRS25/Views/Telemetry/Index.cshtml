        align-items: center;
        gap: calc(15px * var(--rdpms-scale));
        padding-top: calc(15px * var(--rdpms-scale));
        padding-bottom: calc(15px * var(--rdpms-scale));
        width: calc(48px * var(--rdpms-scale));
        background: #111;
        background-image: linear-gradient(transparent 2%, #0a0a0a 2%, transparent 3%, #0a0a0a 30%);
        border-radius: calc(20px * var(--rdpms-scale));
        position: relative;
        border: solid 2px #2a2a2a;
