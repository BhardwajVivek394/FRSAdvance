        border: solid 2px #2a2a2a;
        width: calc(120px * var(--rdpms-scale));
        height: calc(30px * var(--rdpms-scale));
        position: absolute;
        border-radius: 0 calc(27px * var(--rdpms-scale)) calc(27px * var(--rdpms-scale)) 0;
    }

        .rdpms-Signal .rdpms-white-always {
            background: #ffffff;
            background-image: radial-gradient(#e5e5e5, transparent);
            background-size: 3px 2px;
            border: solid 2px #fff;
            box-shadow: 0 0 10px #fff;
            border-radius: 50%;
            position: absolute;
            width: calc(10px * var(--rdpms-scale));
            height: calc(10px * var(--rdpms-scale));
            top: 50%;
            transform: translateY(-50%);
        }

            .rdpms-Signal .rdpms-white-always:nth-child(2) {
                left: calc(35px * var(--rdpms-scale));
            }

            .rdpms-Signal .rdpms-white-always:nth-child(3) {
                left: calc(55px * var(--rdpms-scale));
            }

            .rdpms-Signal .rdpms-white-always:nth-child(4) {
                left: calc(75px * var(--rdpms-scale));
            }

            .rdpms-Signal .rdpms-white-always:nth-child(5) {
                left: calc(95px * var(--rdpms-scale));
            }

    .rdpms-arm-1 {
        transform: rotate(33deg);
        top: 0;
        left: calc(24px * var(--rdpms-scale));
    }

    .rdpms-arm-2 {
        transform: rotate(0deg);
        top: calc(-42px * var(--rdpms-scale));
        left: calc(40px * var(--rdpms-scale));
    }

    .rdpms-arm-3 {
        transform: rotate(-46deg);
        top: calc(-97px * var(--rdpms-scale));
        left: calc(10px * var(--rdpms-scale));
    }

    .rdpms-arm-4 {
        transform: rotate(-144deg);
        top: calc(-79px * var(--rdpms-scale));
        left: calc(-92px * var(--rdpms-scale));
    }

    .rdpms-arm-single {
        transform: rotate(-46deg) !important;
        top: calc(-97px * var(--rdpms-scale)) !important;
        left: calc(10px * var(--rdpms-scale)) !important;
    }

    .rdpms-signal-label {
        font-size: calc(12px * var(--rdpms-scale));
        position: absolute;
        right: calc(-36px * var(--rdpms-scale));
