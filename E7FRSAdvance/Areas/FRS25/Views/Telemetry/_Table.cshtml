@model Domain.AssetLister
<style>
    .popover {
        width: 100%;
    }

    .popover-content {
        color: black;
    }

    @@media only screen and (max-width: 1200px) {
        .panel-body {
        }
    }

    .tableFixHead {
        overflow: auto;
        height: 100vh;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }

    .progress {
        height: 30px;
        font-size: 18px;
    }

    .progress-bar-animated {
        color: black !important;
    }
</style>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="thead-light2">

            @{
                List<Domain.AssetAttribute> mAssetAttribute = new List<Domain.AssetAttribute>();
                foreach (var item in Model.mAssets)
                {
                    foreach (var assetAttribute in item.assetAttributes)
                    {
                        if (mAssetAttribute.Where(x => x.Title == assetAttribute.Title).Count() == 0)
                        {
                            mAssetAttribute.Add(assetAttribute);
                        }
                    }
                }
            }

            @if (Model.mAssets != null && Model.mAssets.Count > 0)
            {
                int i = 0;
                int j = 0;
                foreach (var item in Model.mAssets)
                {
                    if (item.assetAttributes != null && item.assetAttributes.Count > 0 && i == 0)
                    {
                        i++;
                        <tr>
                            <th>
                                @item.AssetTypeName
                            </th>

                            @if (item.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK)
                            {

                                foreach (var assetAttribute in mAssetAttribute.OrderBy(x => x.Sequence))
                                {
                                    <th>
                                        @if (!string.IsNullOrEmpty(assetAttribute.AliasName) && !string.IsNullOrWhiteSpace(assetAttribute.AliasName))
                                        {
                                            <span> @assetAttribute.AliasName</span>
                                        }
                                        else
                                        {
                                            <span> @assetAttribute.Title</span>
                                        }

                                    </th>

                                    if (j == 2)
                                    { j = 0; }
                                    else
                                    { j++; }
                                }

                                <th>Index Score</th>
                                <th>Leakage</th>
                                <th>HEALTH </th>
                                <th>TRACK O/C </th>

                            }
                            else
                            {
                                foreach (var assetAttribute in mAssetAttribute)
                                {


                                    if (assetAttribute.Title.Contains("Last Update"))
                                    {
                                        <th>

                                            @assetAttribute.Title
                                        </th>
                                    }
                                    else
                                    {
                                        <th>
                                            @if (assetAttribute.Title.Contains("+ve"))
                                            {
                                                <span style="color:white;font-weight:900">  @assetAttribute.Title</span>
                                            }
                                            else if (assetAttribute.Title.Contains("-ve"))
                                            {
                                                <span style="color:white;font-weight:900">  @assetAttribute.Title</span>
                                            }
                                            else
                                            {
                                                if (!string.IsNullOrEmpty(assetAttribute.AliasName) && !string.IsNullOrWhiteSpace(assetAttribute.AliasName))
                                                {
                                                    <span> @assetAttribute.AliasName</span>
                                                }
                                                else
                                                {
                                                    <span> @assetAttribute.Title</span>
                                                }
                                            }

                                        </th>
                                    }
                                    if (j == 2)
                                    { j = 0; }
                                    else
                                    { j++; }
                                }
                            }



                        </tr>
                    }

                }

            }

        </thead>
        <tbody>
            @if (Model.mAssets != null && Model.mAssets.Count > 0)
            {

                foreach (var item in Model.mAssets)
                {
                    if (item.assetAttributes != null && item.assetAttributes.Count > 0)
                    {

                        <tr data-id="@item.Id">
                            <td class="hdnAssetNameTD@(item.Id) fault-line">
                                <a href="@item.HttpMisLink" target="_blank"> @item.Name</a>
                            </td>

                            @if (item.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.TRACK)
                            {

                                foreach (var attribute in mAssetAttribute.OrderBy(x => x.Sequence))
                                {
                                    var attItem = item.assetAttributes.Where(x => x.Title == attribute.Title).FirstOrDefault();

                                    if (attItem != null)
                                    {
                                        <td class="hdnAttributeData@(attItem.Id)@(item.Id) list@(attribute.Title.Replace(" ",""))">
                                            @attItem.AttributeData
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="hdnAttributeData@(attribute.Id)@(item.Id) list@(attribute.Title.Replace(" ",""))">
                                            N/A
                                        </td>
                                    }

                                }

                                if (Model.SearchCriteria.AssetTypeName.ToLower() == "Track".ToLower())
                                {
                                    <td class="@(item.IndexScore<7?"text-danger":"")">
                                        @item.IndexScore
                                    </td>
                                    <td class="leakge">
                                    </td>
                                    <td data-id="@item.Id" class="checkHealth@(item.Id)">
                                        @if (item.IsAlarm)
                                        {
                                            <span style='cursor:pointer' onclick="GetLogByAssetId(@item.Id)" class="text-danger">Alarm</span>
                                        }
                                        else
                                        {
                                            <span class="text-success">Ok</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-success trackoc@(item.Id)">C</span>
                                    </td>

                                }
                            }
                            else
                            {
                                foreach (var attribute in mAssetAttribute)
                                {
                                    string backgroundColor = string.Empty;

                                    if (attribute.Title == "Vf" || attribute.Title == "If mA" || attribute.Title == "Choke V" || attribute.Title == "Charger V" || attribute.Title == "Charger mA")
                                    {
                                        backgroundColor = "#F9F9FD";
                                    }
                                    else if (attribute.Title == "Ir mA" || attribute.Title == "Vr")
                                    {
                                        backgroundColor = "#ffffff";
                                    }
                                    else if (attribute.Title == "TPR V")
                                    {
                                        backgroundColor = "#f4f8f8";
                                    }
                                    else if (attribute.Title.Contains("Last Update Feed End") || attribute.Title.Contains("Last Update Relay End"))
                                    {
                                        backgroundColor = "#fdfdff";
                                    }

                                    var attItem = item.assetAttributes.Where(x => x.Title == attribute.Title).FirstOrDefault();
                                    if (Model.SearchCriteria.AssetTypeName.ToLower() == "Earth Fault".ToLower())
                                    {

                                        if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode())
                                        {
                                            if (attItem != null)
                                            {
                                                <td class="hdnAttributeData@(attItem.Id)@(item.Id) fault-line">
                                                    @attItem.AttributeData
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="hdnAttributeData@(attribute.Id)@(item.Id) fault-line">
                                                    N/A
                                                </td>
                                            }
                                        }
                                        else if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId == E7FRSAdvance.Utility.Utility.Role.User.GetHashCode())
                                        {
                                            if (attItem != null)
                                            {
                                                <td class="hdnAttributeData@(attItem.Id)@(item.Id) fault-line">
                                                    @attItem.AttributeData
                                                </td>
                                            }
                                            else
                                            {
                                                <td class="hdnAttributeData@(attribute.Id)@(item.Id) fault-line">
                                                    N/A
                                                </td>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        if (attItem != null)
                                        {
                                            <td class="hdnAttributeData@(attItem.Id)@(item.Id) list@(attribute.Title.Replace(" ",""))" style="background-color:@backgroundColor">
                                                @attItem.AttributeData
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="hdnAttributeData@(attribute.Id)@(item.Id) list@(attribute.Title.Replace(" ",""))" style="background-color:@backgroundColor">
                                                N/A
                                            </td>
                                        }
                                    }

                                }
                            }


                        </tr>
                    }
                }

            }
        </tbody>
    </table>
</div>

@{
    string type = string.Empty;
    if (Model != null && Model.mAssets.Count > 0)
    {
        type = Model.mAssets[0].AssetTypeName;
    }
}

<input type="hidden" id="asset_hidden_field" />
<script>
    (function ($) {
        $.fn.focusTextToEnd = function () {
            this.focus();
            var $thisVal = this.val();
            this.val('').val($thisVal);
            return this;
        }
    }(jQuery));
    var isMultipleAssets = true;
    var json = "";
    var client = null;
    var mQQTPath = "";
    var channels = [];
    var mQTT = null;
    var admin = '@E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId';
    var isSiteKeeping = stringToBool('@E7FRSAdvance.Utility.ClsHttpContent.LoginUser.IsSiteKeeping');
    var values = '@type';
    var isDatalogger = '@Model.Site.IsDatalogger';
    var isDataLoggerJsonReverse = '@Model.Site.IsDataLoggerJsonReverse';
    $(document).ready(function () {
        // debugger; // REMOVED: pauses execution in production
        if (this.client && this.client.isConnected()) {
            try {
                this.client.disconnect();
            } catch (err) {
            }
        }

        $(".main-header").each(function () {

            $(this).find("div:eq(1)").css("height", $(this).height()).css("display", "grid")
            //console.log($(this).height())

        });
        $('.asset-search').focusTextToEnd();
        $(".asset-search").keyup(function (e) {
            setTimeout(function () {
                $("#frmAssetDetails").submit();
            },3000)

        });
        $('[data-toggle="popover"]').popover();

        $("#lblAssetType").html($("#AssetName" + $("#hdnassetTypeId").val()).val());

        $('#drpPageSize').change(function (e) {
            $("#hdnSkip").val('0');
            //$("#hdndateValue").val();
            //$("#hdnassetTypeId").val();
            $("#frmAssetDetails").submit();
        });

     //   $('.dropDownList').select2({ minimumResultsForSearch: Infinity });
        json = @Html.Raw(Json.Encode(Model));

        $('#asset_hidden_field').val(JSON.stringify(json));

        mQTT =@Html.Raw(Json.Encode(Model.MQTTDetail));

        if (json.SearchCriteria.MQTTPaths != null && json.SearchCriteria.MQTTPaths.length > 0)
            mQQTPath = json.SearchCriteria.MQTTPaths[0];

        if (json.SearchCriteria.ChannelList != null && json.SearchCriteria.ChannelList.length > 0) {
            channels = json.SearchCriteria.ChannelList;
        }
        for (var i = 0; i < channels.length; i++) {
            $("#c" + i).html('');
        }

        client = new Paho.Client(mQTT.MQTTUri, mQTT.MQTTPort, "clientId" + Math.ceil(Math.random() * 10000));
        // set callback handlers

        client.onConnectionLost = onConnectionLost;
        client.onMessageArrived = onMessageArrived;

        // connect the client
        client.connect({
            onSuccess: onConnect,
            userName: mQTT.MQTTUsername,
            password: mQTT.MQTTPassword,
            cleanSession: true
        });
        setInterval(function () {

            $(".listBody").each(function (i, j) {
                $(this).find('table').children('tbody').children('tr').each(function (n, ji) {
                    var ifMa = $.trim($(ji).find('td.listIfmA').html());
                    var irMa = $.trim($(ji).find("td.listIrmA").html());
                   // var irMa = $.trim($(ji).find("td:eq(2)").html());

                    var id = $(this).attr("data-id");
                    var tpr = $.trim($(ji).find("td.listTPRV").html());

                    if (ifMa != null && irMa != null) {

                        if (isNaN($.trim(ifMa.replace(/\n/g, ''))) || ifMa == "")
                            ifMa = 0;
                        if (isNaN($.trim(irMa.replace(/\n/g, ''))) || irMa == "")
                            irMa = 0;

                        var lekage = parseFloat(ifMa) - parseFloat(irMa);
                        if (lekage > 150) {

                            $(ji).children('td').each(function (ele, ids) {

                                if ($(this).hasClass('leakge')) {

                                    $(this).addClass('text-danger').html(lekage.toFixed(1));
                                }
                            });
                        }
                        else {
                            $(ji).children('td').each(function (ele, ids) {
                                if ($(this).hasClass('leakge')) {
                                    $(this).removeClass('text-danger').html(lekage.toFixed(1));
                                }
                            });
                        }

                        if ($.trim($(ji).find("td:eq(12)").text()) == "O" && parseInt(tpr) > 1) {

                            $(ji).find("td:eq(10)").removeClass("text-danger");
                        }
                    }
                })
            });
        }, 4000)
    });
    function onConnect() {
        // Once a connection has been made, make a subscription and send a message.
        for (var i = 0; i < channels.length; i++) {
            if (channels[i] != null && channels[i] != "null" && channels[i] != "") {
                client.subscribe(mQQTPath + channels[i].toLowerCase());

                client.subscribe(mQQTPath + 'dl/#');
            }
        }
    }

    // called when the client loses its connection
    function onConnectionLost(responseObject) {
        if (responseObject.errorCode !== 0) {
            console.warn("[MQTT] Connection lost:", responseObject.errorMessage);
        }
        // Guard: do not reconnect if already connected or connecting
        try {
            if (client && client.isConnected()) return;
        } catch(e) {}
        try {
            client.connect({
                onSuccess: onConnect,
                userName: mQTT.MQTTUsername,
                password: mQTT.MQTTPassword,
                cleanSession: true
            });
        } catch (reconnectErr) {
            console.warn("[MQTT] Reconnect failed:", reconnectErr.message);
        }
    }

    // called when a message arrives
    function onMessageArrived(message) {
        if (message.destinationName.includes("/dl/")) {

            var parseJson = JSON.parse(message.payloadString);
            if (parseJson != null && parseJson != undefined && parseJson != '') {
                var jsonData = parseJson['bits'];
                if (jsonData != null && jsonData != undefined && jsonData.length > 0) {
                    var jsonArrayString = '';
                    for (var i = 0; i < jsonData.length; i++) {
                        var decimalNumber = decimalToBinary(jsonData[i]);
                        if (decimalNumber != null) {
                            if (decimalNumber.length != 8) {
                                decimalNumber = ("00000000" + decimalNumber.toString(2)).substr(-8);
                            }
                            const reversedString = decimalNumber.split("").reduce((acc, char) => char + acc, "");

                            jsonArrayString += reversedString;
                        }
                    }
                    var jsonArray = jsonArrayString.split('');
                    if (jsonArray != null && jsonArray != undefined && jsonArray.length > 0) {
                        try {
                            if (isDatalogger == "True") {
                                BindDataLoggerAttribute(jsonArray);

                                try {
                                    BindCircuitDataLoggerSimulation(message.destinationName, jsonArray);

                                }
                                catch (err) {

                                }
                            }
                        }
                        catch (err) {

                        }
                    }
                }
            }
        }
        else {
            if (message.payloadString.includes("roles") && message.payloadString.includes("ts")) {
                var parseJson = JSON.parse(message.payloadString);
                if (parseJson != null && parseJson != undefined && parseJson != '') {
                    var array = parseJson['roles'];
                    var tsarray = parseJson['ts'];
                    if (array != null && array != undefined && array.length > 0) {
                        BindData(message.destinationName, array, tsarray);

                        try {
                            BindCircuitTrackSimulation(message.destinationName, array);

                        }
                        catch (err) {

                        }
                    }
                }
            }
            else {
                var channeldata = message.payloadString.split(',');
                BindData(message.destinationName, channeldata);
            }

            for (var i = 0; i < channels.length; i++) {
                if (channels[i] != null && channels[i] != "null" && channels[i] != "") {
                    var name = mQQTPath.toLowerCase() + channels[i].toLowerCase();
                    if (message.destinationName.toLowerCase() == name.toLowerCase()) {
                        var d = new Date();
                        var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
                        $("#c" + i).html(time);
                    }
                }
            }
        }


    }

    function parseJSON(data) {
        return window.JSON && window.JSON.parse ? window.JSON.parse(data) : (new Function("return " + data))();
    }


    function BindData(basePath, data, tsarray, roletsArray) {
        $.each(json.mAssets, function (id, item) {

            var ifMa = 0;
            var irMa = 0;
            var plusV = 0
            var minusV = 0;
            var hdnAttributeDataFeedEndIds = [];
            var hdnAttributeDataRelayEndIds = [];
            if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                var tprv = 0;
                $.each(item.assetAttributes, function (idx, inItem) {
                    var isLinkIssue = false;

                    if (inItem.Title == "A10 id") {
                        $(".hdnAttributeData" + inItem.Id + item.Id).html(inItem.AssetInfoValue);
                    }

                    var str1 = basePath.toLowerCase();
                    if (inItem.AssetInfoChannel != null) {
                        var str2 = inItem.AssetInfoChannel.toLowerCase();
                        if (str1.indexOf(str2) != -1) {
                            var infoValue = inItem.AssetInfoValue;
                            var infoMultiplication = inItem.Multiplication;
                            if (infoValue != null) {
                                var dataValue = data[infoValue];
                                var id = ".hdnAttributeData" + inItem.Id + item.Id;
                                var calibrationId = ".hdnAttributeCalibration" + inItem.Id + item.Id;

                                if (inItem.Title == "If mA") {
                                    ifMa = infoValue;
                                    hdnAttributeDataFeedEndIds.push(id);
                                }
                                else if (inItem.Title == "Choke V") {
                                    hdnAttributeDataFeedEndIds.push(id);
                                }
                                else if (inItem.Title == "Charger mA") {
                                    hdnAttributeDataFeedEndIds.push(id);
                                }

                                if (inItem.Title == "Ir mA") {
                                    irMa = infoValue;
                                    hdnAttributeDataRelayEndIds.push(id);
                                }
                                else if (inItem.Title == "Vr") {
                                    hdnAttributeDataRelayEndIds.push(id);
                                }

                                if (tsarray != null && tsarray != undefined && tsarray.length > 0) {
                                    var dVal = tsarray[infoValue];

                                    var currentDate = new Date();
                                    var dateObj = new Date(dVal * 1000);

                                    var fullDate = fnConvertUTCDate(dateObj);
                                    var mqttDate = new Date(fullDate);

                                    var seconds = (currentDate.getTime() - mqttDate.getTime()) / 1000;
                                    var secondsValue = parseFloat(seconds);

                                    var v = (Math.round(secondsValue * 100) / 100).toFixed(1);
                                    if (v > 300) {
                                        isLinkIssue = true;
                                    }
                                }

                                if (roletsArray != null && roletsArray != undefined && roletsArray.length > 0) {
                                    if (roletsArray.length > parseInt(infoValue)) {
                                        var dVal = roletsArray[infoValue];
                                        if (dVal != null && dVal != undefined) {
                                            if (parseInt(dVal) > 0) {
                                                var dateObj = new Date(dVal * 1000);
                                                var fullDate = fnConvertUTCDate(dateObj);
                                                var mqttDate = new Date(fullDate);
                                                var timeOnly = mqttDate.toTimeString().split(' ')[0];

                                                $(calibrationId).text(timeOnly);
                                                $(id).addClass('popover-enabled') // optional extra class for styling
                                                    .attr('data-bs-toggle', 'popover')
                                                    .attr('data-bs-title', 'Change Time')
                                                    .attr('data-bs-content', '' + timeOnly + '')
                                                    .attr('data-bs-placement', 'top');
                                            }

                                        }
                                    }
                                }

                                if (infoMultiplication != null) {

                                    if (inItem.Title == "Last Update Feed End( sec ago)" || inItem.Title == "Last Update Relay End( sec ago)" || inItem.Title == "Last Access (Sec)") {

                                        var mainData = parseFloat(dataValue);
                                        if (tsarray != null && tsarray != undefined && tsarray.length > 0) {
                                            var dVal = 0;
                                            if (inItem.Title == "Last Update Feed End( sec ago)") {
                                                dVal = tsarray[ifMa];
                                            } else if (inItem.Title == "Last Update Relay End( sec ago)") {
                                                dVal = tsarray[irMa];
                                            }
                                            var currentDate = new Date();
                                            var dateObj = new Date(dVal * 1000);

                                            var fullDate = fnConvertUTCDate(dateObj);
                                            var mqttDate = new Date(fullDate);

                                            var seconds = (currentDate.getTime() - mqttDate.getTime()) / 1000;
                                            mainData = parseFloat(seconds);
                                        }

                                        var v = (Math.round(mainData * 100) / 100).toFixed(1)
                                        $(id).html(v);

                                    } else {
                                        var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                        var v = (Math.round(mainData * 100) / 100).toFixed(1);
                                        if (parseFloat(v) <= 0) {
                                            v = '0.0';
                                        }


                                        if (inItem.Title == "Vr") {

                                            if (v > 0.1 && v < 2.5 && tprv > 1) {
                                                $(id).addClass("text-danger");
                                            }
                                            else if (v > 4.2) {
                                                $(id).addClass("text-danger");
                                            }
                                            else {
                                                $(id).removeClass("text-danger");
                                            }
                                        }

                                        if (inItem.Title == "TPR V") {
                                            tprv = v;
                                            if (v > 0.1 && v < 20) {
                                                $(id).addClass("text-danger");
                                            }
                                            else {
                                                $(id).removeClass("text-danger");
                                            }
                                            if (v < 1) {
                                                $(".trackoc" + item.Id).addClass("text-danger").removeClass("text-success").html("O");
                                                $(".lekage" + item.Id).addClass("text-danger").removeClass("text-danger")
                                            }
                                            else {
                                                $(".trackoc" + item.Id).addClass("text-success").removeClass("text-danger").html("C");
                                            }
                                        }

                                        if (inItem.Title == "Charger mA") {
                                            if (v < 40) {
                                                v = '0.0';
                                            }
                                            if (v < 100) {
                                                $(id).addClass("text-danger");
                                            }
                                            else {
                                                $(id).removeClass("text-danger");
                                            }
                                        }

                                        if (inItem.Title == "Choke V") {
                                            if (v > 1.8 && tprv > 1) {
                                                $(id).addClass("text-danger");
                                            }
                                            else {
                                                $(id).removeClass("text-danger");
                                            }
                                        }

                                        if (values == 'Earth Fault') {
                                            $(id).attr('data-val', v);
                                        }
                                        else {
                                            $(id).html(v);
                                            if (isLinkIssue) {
                                                $(id).addClass("text-danger");
                                                $(id).html("Link Issue");
                                            }
                                            else {
                                                $(id).removeClass("text-danger");
                                            }
                                        }
                                    }


                                }

                            }
                            else {
                                var v = (Math.round(dataValue * 100) / 100).toFixed(1);
                                if (parseFloat(v) <= 0) {
                                    v = '0.0';
                                }
                                if (inItem.Title == "Vr") {

                                    if (v > 0.1 && v < 2.5) {
                                        $(id).addClass("text-danger");
                                    }
                                    else if (v > 4.2) {
                                        $(id).addClass("text-danger");
                                    }
                                    else {
                                        $(id).removeClass("text-danger");
                                    }
                                }
                                if (inItem.Title == "TPR V") {

                                    if (v > 0.1 && v < 20) {
                                        $(id).addClass("text-danger");
                                    }
                                    else {
                                        $(id).removeClass("text-danger");
                                    }
                                }
                                if (inItem.Title == "Charger mA") {
                                    if (v < 40) {
                                        v = '0.0';
                                    }
                                    if (v < 100) {
                                        $(id).addClass("text-danger");
                                    }
                                    else {
                                        $(id).removeClass("text-danger");
                                    }
                                }
                                if (inItem.Title == "Choke V") {
                                    if (v > 1.8) {
                                        $(id).addClass("text-danger");
                                    }
                                    else {
                                        $(id).removeClass("text-danger");
                                    }
                                }
                                $(id).html(v);
                                if (isLinkIssue) {
                                    $(id).addClass("text-danger");
                                    $(id).html("Link Issue");
                                }
                                else {
                                    $(id).removeClass("text-danger");
                                }
                            }
                        }
                    }
                });
            }




        });


        $('[data-bs-toggle="popover"]').popover({
            trigger: 'hover',  // or 'click'
            html: true
        });
    }

    function BindDataLoggerAttribute(data) {

        //Bind Datalogger Attribute
        $.each(json.mAssets, function (id, item) {
            if (item.mAssetInfoDataloggers != null && item.mAssetInfoDataloggers.length > 0) {
                $.each(item.mAssetInfoDataloggers, function (idx, inItem) {
                    if (inItem.Value != null && inItem.Value != '') {
                        var dataValue = data[inItem.Value - 1];
                        if (dataValue != null) {
                            var id = ".DLAttribute" + item.Id + inItem.DataloggerAttributeId;

                            if (isDataLoggerJsonReverse == "True") {

                                if (parseInt(dataValue) == 0)
                                    dataValue = 1;
                                else if (parseInt(dataValue) == 1)
                                    dataValue = 0;
                            }
                            if (inItem.ContactType != null && inItem.ContactType != undefined && inItem.ContactType.toLowerCase() == 'front') {
                                if (parseInt(dataValue) == 1) {
                                    $(id).html("<span class='badge badge-success'>Pickup</span>");
                                }
                                else if (parseInt(dataValue) == 0) {
                                    $(id).html("<span class='badge badge-warning'>DROP</span>");
                                }
                            } else if (inItem.ContactType != null && inItem.ContactType != undefined && inItem.ContactType.toLowerCase() == 'back') {
                                if (parseInt(dataValue) == 1) {
                                    $(id).html("<span class='badge badge-warning'>DROP</span>");

                                }
                                else if (parseInt(dataValue) == 0) {

                                    $(id).html("<span class='badge badge-success'>Pickup</span>");
                                }
                            }
                        }
                    }
                });
            }
        });

    }

    function CalculateEarthFalt(item,attributeItem,attValue) {
        var id = ".hdnAttributeData" + attributeItem.Id + item.Id;
        var vc = (parseFloat(attValue) / parseFloat(item.ReferenceValue)) * 100;

        if (vc < item.X) {
            if (admin == '@E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode()') {
                $(id).empty().html(attValue + '<div class="progress"><div class="progress-bar-animated progress-bar-striped bg-danger text-center" role ="progressbar" style= "width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" >Full Earth</div></div >');
            }
            else if (admin == '@E7FRSAdvance.Utility.Utility.Role.User.GetHashCode()' && isSiteKeeping) {
                $(id).empty().html(attValue + '<div class="progress"><div class="progress-bar-animated progress-bar-striped bg-danger text-center" role ="progressbar" style= "width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" >Full Earth</div></div >');
            }
            else {
                $(id).empty().html('<div class="progress"><div class="progress-bar-animated progress-bar-striped bg-danger text-center" role ="progressbar" style= "width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" >Full Earth</div></div >');
            }

        }
        else if (vc > item.X && vc < item.Y) {
            if (admin == '@E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode()') {
                $(id).empty().html(attValue + '<div class="progress"><div class="progress-bar-animated progress-bar-striped bg-warning text-center" role ="progressbar" style= "width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">Partial</div></div >');
            }
            else if (admin == '@E7FRSAdvance.Utility.Utility.Role.User.GetHashCode()' && isSiteKeeping) {
                $(id).empty().html(attValue + '<div class="progress"><div class="progress-bar-animated progress-bar-striped bg-warning text-center" role ="progressbar" style= "width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">Partial</div></div >');
            }
            else {
                $(id).empty().html('<div class="progress"><div class="progress-bar-animated progress-bar-striped bg-warning text-center" role ="progressbar" style= "width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100">Partial</div></div >');
            }
        }
        else if (vc >= item.Y) {
            if (admin == '@E7FRSAdvance.Utility.Utility.Role.Admin.GetHashCode()') {
                $(id).empty().html(attValue+ '<div class="progress"><div class="progress-bar-animated progress-bar-striped bg-success text-center" role ="progressbar" style= "width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" >Healthy</div></div >');
            }
            else if (admin == '@E7FRSAdvance.Utility.Utility.Role.User.GetHashCode()' && isSiteKeeping) {
                $(id).empty().html(attValue + '<div class="progress"><div class="progress-bar-animated progress-bar-striped bg-success text-center" role ="progressbar" style= "width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" >Healthy</div></div >');
            }
            else {
                $(id).empty().html('<div class="progress"><div class="progress-bar-animated progress-bar-striped bg-success text-center" role ="progressbar" style= "width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" >Healthy</div></div >');
            }
        }
    }

