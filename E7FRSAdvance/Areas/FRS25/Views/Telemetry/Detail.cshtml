                    <div class="d-flex gap-10">
                       
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="row mb-3">

                    <div class="col-xxl-1 col-xl-1 col-lg-4 col-md-4 mt-2">
                        <span>Zone</span>
                        @Html.DropDownList("ZoneId", (IEnumerable<SelectListItem>)ViewBag.Zones, "All", new { @class = "form-control", @id = "drpZones", tabindex = 1 })
                    </div>
                    <div class="col-xxl-2 col-xl-2 col-lg-4 col-md-4 mt-2">
                        <span>Division</span>
                        @Html.DropDownList("DivisionId", (IEnumerable<SelectListItem>)ViewBag.Divisions, "All", new { @class = "form-control", @id = "drpDivisions", tabindex = 2 })
                    </div>
                    <div class="col-xxl-2 col-xl-2 col-lg-4 col-md-4 mt-2">
                        <span>Site</span>
                        @Html.DropDownList("SiteId", (IEnumerable<SelectListItem>)ViewBag.Sites, "All", new { @class = "form-control", @id = "drpSite", tabindex = 3 })
                    </div>
                    <div class="col-xxl-1 col-xl-1 col-lg-4 col-md-4 mt-2">
                        <span>Asset Type</span>
                        @Html.DropDownList("AssetTypeId", (IEnumerable<SelectListItem>)ViewBag.AssetTypes, "All", new { @class = "form-control", @id = "drpAssetType", tabindex = 4 })
                    </div>
                    <div class="col-xxl-1 col-xl-1 col-lg-4 col-md-4 mt-2">
                        <span>Asset Number</span>
                        <select class="form-control" id="drpAsset">
                        </select>
                    </div>
                    <div class="col-xxl-1 col-xl-1 col-lg-4 col-md-4 mt-2">
                        <span>From Date</span>
                        <input type="text" class="form-control" id="txtFromDate" />
                    </div>
                    <div class="col-xxl-1 col-xl-1 col-lg-4 col-md-4 mt-2">
                        <span>From Time</span>
                        <input type="text" class="form-control" id="txtFromTime" />
                    </div>
                    <div class="col-xxl-1 col-xl-1 col-lg-4 col-md-4 mt-2">
                        <span>To Date</span>
                        <input type="text" class="form-control" id="txtToDate" />
                    </div>
                    <div class="col-xxl-1 col-xl-1 col-lg-4 col-md-4 mt-2">
                        <span>To Time</span>
                        <input type="text" class="form-control" id="txtToTime" />
