
@{
    ViewBag.Title = "Telemetry History";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}
<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="~/assets/js/paho-mqtt.js"></script>

<style>
    #tablePager {
        text-align: right;
    }

        #tablePager .page-number {
            cursor: pointer;
            padding: 4px 8px;
            margin: 2px;
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        #tablePager .active {
            background: #007bff;
            color: #fff;
            border-color: #007bff;
        }
</style>


<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body p-0">
                <div class="row">
                    <div class="col-12 col-sm-5">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item ">Telemetry</li>
                                <li class="breadcrumb-item active" aria-current="page"><a href="#">Telemetry History</a></li>
                            </ol>
                        </nav>
                    </div>
                    <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                        <h2 class="page-name">Telemetry History</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
