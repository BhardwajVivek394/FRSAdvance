<script>

    $(document).ready(function () {

        $('#txtFromDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        });

        $('#txtToDate').datepicker({
            dateFormat: 'm/d/yy',
            autoClose: true
        });


        $('#txtFromTime').clockpicker({
            placement: 'bottom',
            align: 'right',
            autoclose: true,
            'default': '00:00'
        });

        $('#txtToTime').clockpicker({
            placement: 'bottom',
            align: 'right',
            autoclose: true,
            'default': '00:00'
        });

    });

    $('#drpZones').change(function () {
        GetDivisionByZone($(this).val());
    });

    $('#drpDivisions').change(function () {
        GetByDivisionId($(this).val());
    });

    $('#drpAssetType').change(function () {
        GetByAssest($('#drpSite').val(), $(this).val());
    });

    function GetDivisionByZone(zoneId) {
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRS25/Telemetry/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpDivisions").empty();
                    $("#drpDivisions").append($("<option></option>").val('0').html('All'));
                    $.each(data, function (key, value) {
                        $("#drpDivisions").append($("<option></option>").val(value.Id).html(value.Name));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function GetByDivisionId(divisionId) {
        if (divisionId != null && divisionId != undefined && divisionId != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRS25/Telemetry/GetSiteByDivisionId',
                type: 'POST',
                data: '{divisionId:' + divisionId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpSite").empty();
                    $("#drpSite").append($("<option></option>").val('0').html('All'));
                    $.each(data, function (key, value) {
                        $("#drpSite").append($("<option></option>").val(value.Id).html(value.Name));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function GetByAssest(siteId, assetTypeId) {
        if (siteId != null && siteId != undefined && siteId != '' && assetTypeId != null && assetTypeId != undefined && assetTypeId != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRS25/Telemetry/GetAssestBy',
                type: 'POST',
                data: '{siteId:' + siteId + ',assetTypeId:' + assetTypeId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $("#drpAsset").empty();
                    $("#drpAsset").append($("<option></option>").val('0').html('All'));
                    $.each(data, function (key, value) {
                        $("#drpAsset").append($("<option></option>").val(value.Id).html(value.Name));
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function fnSearchView() {
        var isValid = true;

        var mAsset = {};
        mAsset.Id = $("#drpAsset").val();
        mAsset.SiteId = $("#drpSite").val();
        mAsset.AssetTypeId = $('#drpAssetType').val();

        mAsset.StartDate = $('#txtFromDate').val();
        mAsset.EndDate = $('#txtToDate').val();

        mAsset.StartTime = $('#txtFromTime').val();
        mAsset.EndTime = $('#txtToTime').val();

        mAsset.IsReadHttpPost = false;
        //if ($("#selDatabase").val() == "HTTP") {
        //    mAsset.IsReadHttpPost = true;
        //}
        if (mAsset.SiteId == null || mAsset.SiteId == undefined || mAsset.SiteId == '') {
            isValid = false;
            alert('select site')
        }
        else if (mAsset.AssetTypeId == null || mAsset.AssetTypeId == undefined || mAsset.AssetTypeId == '') {
            isValid = false;
            alert('select asset type')
        }
        else if (mAsset.Id == null || mAsset.Id == undefined || mAsset.Id == '') {
            isValid = false;
            alert('select asset')
        }
        else if (mAsset.StartDate == null || mAsset.StartDate == undefined || mAsset.StartDate == '') {
            isValid = false;
            alert('select from date')
        }
        else if (mAsset.EndDate == null || mAsset.EndDate == undefined || mAsset.EndDate == '') {
            isValid = false;
            alert('select to date')
        }

        if (isValid) {
            $("#loader").show();
            $.ajax({
                url: '/FRS25/Telemetry/_DetailList',
                type: 'Post',
                data: '{asset:' + JSON.stringify(mAsset) + '}',
                contentType: 'application/json',
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    $('#listView').empty().append(data);
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

     

        //if ($('#drpView').val() == "Table") {
        //    fnBindTable();
        //}
        //else if ($('#drpView').val() == "Graph") {

        //}
        //else if ($('#drpView').val() == "Circuit") {

        //}
        //else if ($('#drpView').val() == "Yard") {
        //    fnBindYard();
        //}
    }

    function fnBindTable() {
        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#drpSite').val();
        mSearchCriteria.Id = $('#drpAsset').val();
        mSearchCriteria.AssetTypeId = $('#drpAssetType').val();
        mAssetLister.SearchCriteria = mSearchCriteria;

        $.ajax({
            url: '/FRS25/Telemetry/_Table',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            success: function (data) {


                $('#divTelemetryLive').empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });

    }

    function fnBindYard() {
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#drpSite').val();
        mSearchCriteria.Id = $('#drpAsset').val();
        mSearchCriteria.AssetTypeId = $('#drpAssetType').val();

        $.ajax({
            url: '/FRS25/Telemetry/_Yard',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(mSearchCriteria),
            success: function (data) {


                $('#divTelemetryLive').empty().append(data);
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });

    }

</script>



