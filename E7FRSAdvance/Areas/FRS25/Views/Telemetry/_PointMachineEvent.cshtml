@model List<Domain.PointMachineEvent>

<table class="table table-bordered">
    <thead>
        <tr>
            <th style="background-color: #215968; color: white;">Asset Name</th>
            <th style="background-color: #215968; color: white;">Type</th>
            <th style="background-color: #215968; color: white;">Direction</th>
            <th style="background-color: #215968; color: white;">Voltage Count</th>
            <th style="background-color: #215968; color: white;">Current Count</th>
            <th style="background-color: #215968; color: white;">Time Of Operation</th>
            <th style="background-color: #215968; color: white;">Operation Time</th>
            <th style="background-color: #215968; color: white;">Capture Time</th>
            <th style="background-color: #215968; color: white;">Update Time</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count() > 0)
        {
            foreach (var item in Model)
            {
                <tr class="table-light">
                    <td>@item.AssetName</td>
                    <td>@item.Type</td>
                    <td>@item.Direction</td>
                    <td>@item.VoltageCount</td>
                    <td>@item.CurrentCount</td>
                    <td>@item.TimeOfOpration</td>
                    <td>@item.OperationTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>@item.CaptureTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    <td>@item.UpdateTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="9" class="text-center">No record found</td>
            </tr>
        }
    </tbody>
</table>