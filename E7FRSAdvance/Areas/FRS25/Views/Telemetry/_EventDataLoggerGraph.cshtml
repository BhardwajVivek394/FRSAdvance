@model List<Domain.Datalogger>

@{
    string assetsName = string.Empty;
}

<style>
    /* EventDataLoggerGraph — aurora-adaptive table header */
    .el-dg-table thead th {
        background: linear-gradient(135deg, var(--e7-rail-from) 0%, var(--e7-rail-to) 100%);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        padding: 12px 14px;
        border: none;
        white-space: nowrap;
    }

    .el-dg-table tbody td {
        padding: 10px 14px;
        border-bottom: 1px solid var(--e7-border);
        color: var(--e7-text-2);
        font-size: 13px;
        vertical-align: middle;
    }

    .el-dg-table tbody tr:hover {
        background: var(--e7-surface-2);
    }
    /* Aurora dark overrides */
    body[data-aurora="dark"] .el-dg-table tbody td {
        color: var(--e7-text);
        border-bottom-color: var(--e7-border);
    }

    body[data-aurora="dark"] .el-dg-table tbody tr:hover {
        background: var(--e7-surface-2);
    }
    /* Pickup / Drop badges */
    .el-dg-pickup {
        background: var(--e7-green-soft);
        color: var(--e7-green);
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
    }

    .el-dg-drop {
        background: var(--e7-amber-soft);
        color: var(--e7-amber);
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
    }

    body[data-aurora="dark"] .el-dg-pickup {
        background: var(--e7-green-soft);
        color: var(--e7-green);
    }

    body[data-aurora="dark"] .el-dg-drop {
        background: var(--e7-amber-soft);
        color: var(--e7-amber);
    }

    /* FIX: this table always renders inside the light #modalalertlogs modal.
       Keep text/hover readable even when the page theme is dark (which would
       otherwise force near-invisible light grey text on the light modal). */
    #modalalertlogs .el-dg-table tbody td {
        color: var(--e7-text-2) !important;
        border-bottom-color: var(--e7-border) !important;
    }

    #modalalertlogs .el-dg-table tbody tr:hover {
        background: var(--e7-surface-3) !important;
    }

        #modalalertlogs .el-dg-table tbody tr:hover td {
            color: var(--e7-heading) !important;
        }

    #modalalertlogs .el-dg-pickup {
        background: var(--e7-green-soft) !important;
        color: var(--e7-green) !important;
    }

    #modalalertlogs .el-dg-drop {
        background: var(--e7-amber-soft) !important;
        color: var(--e7-amber) !important;
    }
</style>
<table id="EventDataLoggerGraphTable" class="table el-dg-table" style="border-collapse:separate;border-spacing:0;border-radius:10px;overflow:hidden;box-shadow:var(--e7-shadow-soft, 0 2px 8px rgba(0,0,0,0.06));">
    <thead>
        <tr>
            <th>SR No.</th>
            <th>Asset</th>
            <th>Attribute</th>
            <th>Current Value</th>
            <th>Time Stamp</th>
            <th>Update Time</th>
            <th>Type</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model.OrderByDescending(x => x.Date))
            {
                <tr>
                    <td>@item.SrNo</td>
                    <td>@item.AssetName</td>
                    <td>@item.AttributeName</td>
                    <td>
                        @{
                            var currentValue = (item.CurrentValue ?? string.Empty).Trim();
                        }

                        @if (currentValue.Equals("Pickup", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="el-dg-pickup">Pickup</span>
                        }
                        else if (currentValue.Equals("Drop", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="el-dg-drop">Drop</span>
                        }
                        else
                        {
                            @(string.IsNullOrWhiteSpace(currentValue) ? "-" : currentValue)
                        }
                    </td>
                    <td>@(item.Timestamp != null ? item.Timestamp.ToString() : "-")</td>
                    <td>@item.CurrentDate.ToString("dd/MM/yyyy hh:mm:ss tt")</td>
                    <td>@item.Type</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">
                    No record found
                </td>
            </tr>
        }
    </tbody>

</table>


