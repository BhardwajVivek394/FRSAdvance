@model Domain.FRSAlertLister
@{ ViewBag.Title = "Alert History";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml"; }

<style>
    /* ===== SEARCH SECTION ===== */
    .search-section {
        padding: 20px 0px;
        position: relative;
        z-index: 100;
    }

    .search-title {
        font-size: 18px;
        font-weight: 600;
        color: #333;
        margin-bottom: 20px;
    }

    /* ===== FILTER ROW ===== */
    .filter-row {
        display: flex;
        align-items: flex-end;
        gap: 12px;
        flex-wrap: nowrap;
        overflow-x: auto;
        padding-bottom: 8px;
        position: relative;
        z-index: 100;
    }

        .filter-row::-webkit-scrollbar {
            height: 4px;
        }

        .filter-row::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 4px;
        }

    /* ===== FILTER ITEM ===== */
    .filter-item {
        flex-shrink: 0;
        position: relative;
        z-index: 100;
    }

        .filter-item label {
            display: block;
            font-size: 13px;
            color: #555;
            margin-bottom: 6px;
            font-weight: 500;
        }

    /* ===== SELECT BUTTON ===== */
    .select-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        color: #333;
        cursor: pointer;
        min-width: 110px;
        height: 40px;
    }

        .select-btn:hover {
            border-color: #999;
        }

        .select-btn.active {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

        .select-btn .text {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: left;
        }

        .select-btn i {
            margin-left: 8px;
            font-size: 12px;
            color: #666;
        }

    /* ===== DROPDOWN - FIXED POSITION ===== */
    .filter-dropdown {
        position: fixed;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
        min-width: 260px;
        max-width: 320px;
        z-index: 9999;
        display: none;
    }

        .filter-dropdown.open {
            display: block;
        }

    /* Search Box in Dropdown */
    .dropdown-search {
        padding: 10px 12px;
        border-bottom: 1px solid #e0e0e0;
    }

        .dropdown-search input {
            width: 100%;
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s;
        }

            .dropdown-search input:focus {
                border-color: #3b82f6;
            }

            .dropdown-search input::placeholder {
                color: #aaa;
            }

    /* Select All Header */
    .dropdown-header {
        padding: 10px 14px;
        background: #f5f5f5;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .dropdown-header input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #3b82f6;
        }

        .dropdown-header label {
            font-size: 14px;
            font-weight: 600;
            color: #333;
            cursor: pointer;
            margin: 0;
        }

    /* Options List */
    .dropdown-list {
        max-height: 250px;
        overflow-y: auto;
    }

    .dropdown-item {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.15s;
    }

        .dropdown-item:last-child {
            border-bottom: none;
        }

        .dropdown-item:hover {
            background: #f5f7fa;
        }

        .dropdown-item.checked {
            background: #e8f2ff;
        }

        .dropdown-item.hidden {
            display: none;
        }

        .dropdown-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #3b82f6;
            flex-shrink: 0;
        }

        .dropdown-item span {
            font-size: 14px;
            color: #333;
        }

        .dropdown-item.checked span {
            color: #1d4ed8;
            font-weight: 500;
        }

        /* Highlight matched text */
        .dropdown-item span mark {
            background: #fef08a;
            color: #333;
            padding: 0;
            border-radius: 2px;
        }

    /* Empty/Loading State */
    .dropdown-empty {
        padding: 25px;
        text-align: center;
        color: #888;
        font-size: 14px;
    }

    /* No results message */
    .dropdown-no-results {
        padding: 20px;
        text-align: center;
        color: #999;
        font-size: 13px;
        display: none;
    }

        .dropdown-no-results.show {
            display: block;
        }

    /* ===== INPUT FIELDS ===== */
    .filter-input {
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        height: 40px;
        width: 100px;
        outline: none;
    }

        .filter-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

    /* ===== SEARCH BUTTON ===== */
    .btn-search {
        background: var(--primary);
        border: none;
        border-radius: 6px;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #fff;
        transition: background 0.2s;
    }

        .btn-search:hover {
            background: var(--primary);
        }

        .btn-search i {
            font-size: 16px;
        }

    /* ===== BACKDROP ===== */
    .dropdown-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9998;
        display: none;
    }

        .dropdown-backdrop.show {
            display: block;
        }

    /* ===== TABLE SECTION ===== */
    .table-border {
        position: relative;
        z-index: 1;
    }

    /* Download Dropdown Styling */
    #btn2 + .dropdown-menu {
        min-width: 130px;
        padding: 8px 0;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
        border: 1px solid #e2e8f0;
    }

        #btn2 + .dropdown-menu .dropdown-item {
            padding: 10px 15px;
            font-size: 14px;
            display: flex;
            align-items: center;
        }

            #btn2 + .dropdown-menu .dropdown-item:hover {
                background: #f1f5f9;
            }
</style>

