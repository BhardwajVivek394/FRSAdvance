    // ===== LOAD CAUSE CODES BY ASSET TYPE =====
    function loadCauseCodes() {
        var assetTypeIds = getValues('assetType');

        // Clear cause dropdown
        $('#listCause').html('<div class="dropdown-empty">Loading...</div>');
        $('#chkAllCause').prop('checked', false);
        $('#txtCause').text('All');

        if (assetTypeIds.length === 0) {
            // No asset type selected - reload all cause codes or show message
            $('#listCause').html('<div class="dropdown-empty">Select Asset Type first</div>');
            return;
        }

        var allCauses = [];
        var seenIds = {};
        var completed = 0;
        var total = assetTypeIds.length;

        for (var i = 0; i < assetTypeIds.length; i++) {
            (function (assetTypeId) {
                $.ajax({
                    url: '/FRS25/AlertDetailReport/GetAlertInfo',
                    type: 'POST',
                    data: '{assetTypeId:' + assetTypeId + '}',
                    contentType: 'application/json',
                    success: function (data) {
                        if (data && data.length > 0) {
                            $.each(data, function (key, value) {
                                if (value && value.Id && !seenIds[value.Id]) {
                                    seenIds[value.Id] = true;
                                    allCauses.push({ Id: value.Id, Name: value.Name });
                                }
                            });
                        }
                        completed++;
                        if (completed >= total) renderCauseCodes(allCauses);
                    },
                    error: function () {
                        completed++;
                        if (completed >= total) renderCauseCodes(allCauses);
                    }
                });
            })(assetTypeIds[i]);
        }
    }

    function renderCauseCodes(allCauses) {
        allCauses.sort(function (a, b) { return (a.Name || '').localeCompare(b.Name || ''); });

        if (allCauses.length > 0) {
            var html = '';
            for (var i = 0; i < allCauses.length; i++) {
                var c = allCauses[i];
                html += '<div class="dropdown-item" data-value="' + c.Id + '" data-text="' + c.Name + '">';
                html += '<input type="checkbox" class="cb-cause" value="' + c.Id + '">';
                html += '<span>' + c.Name + '</span></div>';
            }
            $('#listCause').html(html);
        } else {
            $('#listCause').html('<div class="dropdown-empty">No cause codes found</div>');
        }
    }
    function onPageSizeChange() {
        window._alertPageSize = parseInt($('#ddlPageSize').val()) || 10;
        fnSearch(0); // Reset to first page
    }
</script>
