    // ===== EXCEL DOWNLOAD =====
    function fnDownloadExcel() {
        var table = document.querySelector('#divAlertDetailReport table');

        if (!table) {
            alert('No data available to download');
            return;
        }

        try {
            $("#loader").show();

            var workbook = new ExcelJS.Workbook();
            workbook.creator = 'RDPMS';
            workbook.created = new Date();

            var worksheet = workbook.addWorksheet('Alert Detail Report');

            // Extract table data
            var rows = table.querySelectorAll('tr');
            var tableData = [];
            var columnCount = 0;

            rows.forEach(function (row) {
                var rowData = [];
                var cols = row.querySelectorAll('th, td');
                columnCount = Math.max(columnCount, cols.length);
                cols.forEach(function (col) {
                    var text = col.innerText.replace(/(\r\n|\n|\r)/gm, ' ').trim();
                    rowData.push(text);
                });
                if (rowData.length > 0) {
                    tableData.push(rowData);
                }
            });

            // Title Row
            var fromDate = $('#txtFromDate').val() || '';
            var toDate = $('#txtToDate').val() || '';
            var titleRow = worksheet.addRow(['Alert Detail Report']);
            titleRow.height = 30;
            worksheet.mergeCells(1, 1, 1, columnCount);
            titleRow.getCell(1).fill = {
                type: 'pattern',
                pattern: 'solid',
                fgColor: { argb: 'FF4F46E5' }
            };
            titleRow.getCell(1).font = {
                bold: true,
                color: { argb: 'FFFFFFFF' },
                size: 16,
                name: 'Calibri'
            };
            titleRow.getCell(1).alignment = { vertical: 'middle', horizontal: 'center' };

            // Date Row
            var dateRow = worksheet.addRow(['Period: ' + fromDate + ' to ' + toDate + ' | Generated: ' + new Date().toLocaleString()]);
            dateRow.height = 20;
            worksheet.mergeCells(2, 1, 2, columnCount);
            dateRow.getCell(1).font = { italic: true, size: 10, color: { argb: 'FF64748B' } };
            dateRow.getCell(1).alignment = { horizontal: 'center' };

            // Empty row
            worksheet.addRow([]);

            // Data rows
            tableData.forEach(function (row, rowIndex) {
                var excelRow = worksheet.addRow(row);

                if (rowIndex === 0) {
                    // Header row styling
                    excelRow.eachCell(function (cell) {
                        cell.fill = {
                            type: 'pattern',
                            pattern: 'solid',
                            fgColor: { argb: 'FF1E3A5F' }
                        };
                        cell.font = {
                            bold: true,
                            color: { argb: 'FFFFFFFF' },
                            size: 11,
                            name: 'Calibri'
                        };
                        cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
                        cell.border = {
                            top: { style: 'medium', color: { argb: 'FF1E3A5F' } },
                            left: { style: 'medium', color: { argb: 'FF1E3A5F' } },
                            bottom: { style: 'medium', color: { argb: 'FF1E3A5F' } },
                            right: { style: 'medium', color: { argb: 'FF1E3A5F' } }
                        };
                    });
                    excelRow.height = 25;
                } else {
                    // Data row styling
                    excelRow.eachCell(function (cell) {
                        cell.fill = {
                            type: 'pattern',
                            pattern: 'solid',
                            fgColor: { argb: rowIndex % 2 === 0 ? 'FFF1F5F9' : 'FFFFFFFF' }
                        };
                        cell.font = { size: 10, name: 'Calibri' };
                        cell.alignment = { vertical: 'middle', horizontal: 'left' };
                        cell.border = {
                            top: { style: 'thin', color: { argb: 'FFE2E8F0' } },
                            left: { style: 'thin', color: { argb: 'FFE2E8F0' } },
                            bottom: { style: 'thin', color: { argb: 'FFE2E8F0' } },
                            right: { style: 'thin', color: { argb: 'FFE2E8F0' } }
                        };
                    });
                    excelRow.height = 20;
                }
            });

            // Auto-fit columns
            worksheet.columns.forEach(function (column) {
                var maxLength = 12;
                column.eachCell({ includeEmpty: true }, function (cell) {
                    var cellLength = cell.value ? cell.value.toString().length : 10;
                    if (cellLength > maxLength) maxLength = cellLength;
                });
                column.width = Math.min(maxLength + 2, 40);
            });

            // Footer
            worksheet.addRow([]);
            var footerRow = worksheet.addRow(['Total Records: ' + (tableData.length - 1)]);
            footerRow.getCell(1).font = { bold: true, size: 10, color: { argb: 'FF64748B' } };

            var fileName = getDownloadFileName('xlsx');

            workbook.xlsx.writeBuffer().then(function (buffer) {
                var blob = new Blob([buffer], {
                    type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                });
                saveAs(blob, fileName);
                $("#loader").hide();
                CommonNotification("SUCCESS", "Excel downloaded successfully!", "Success");
            });

        } catch (error) {
            $("#loader").hide();
            console.error('Excel Error:', error);
            CommonNotification("ERROR", "Error downloading Excel", "Error");
        }
    }

    // ===== CSV DOWNLOAD =====
    function fnDownloadCSV() {
        var table = document.querySelector('#divAlertDetailReport table');

        if (!table) {
            alert('No data available to download');
            return;
        }

        try {
            $("#loader").show();

            var csv = [];
            var rows = table.querySelectorAll('tr');

            rows.forEach(function (row) {
                var rowData = [];
                var cols = row.querySelectorAll('th, td');
                cols.forEach(function (col) {
                    var text = col.innerText.replace(/(\r\n|\n|\r)/gm, ' ').trim();
                    // Escape double quotes and wrap in quotes
                    text = text.replace(/"/g, '""');
                    rowData.push('"' + text + '"');
                });
                csv.push(rowData.join(','));
            });

            // Add BOM for Excel UTF-8 compatibility
            var BOM = '\uFEFF';
            var csvString = BOM + csv.join('\n');
            var fileName = getDownloadFileName('csv');

            var blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
            saveAs(blob, fileName);

            $("#loader").hide();
            CommonNotification("SUCCESS", "CSV downloaded successfully!", "Success");

        } catch (error) {
            $("#loader").hide();
            console.error('CSV Error:', error);
            CommonNotification("ERROR", "Error downloading CSV", "Error");
        }
    }

    // ===== GET FILENAME =====
    function getDownloadFileName(extension) {
        var now = new Date();
        var timestamp = now.getFullYear() +
            String(now.getMonth() + 1).padStart(2, '0') +
            String(now.getDate()).padStart(2, '0') + '_' +
            String(now.getHours()).padStart(2, '0') +
            String(now.getMinutes()).padStart(2, '0');
        return 'AlertDetailReport_' + timestamp + '.' + extension;
    }

