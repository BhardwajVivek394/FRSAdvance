        // separate fetch, no separate route). Real VAE latent (novelty_x_*/
        // novelty_y_*) and real ratio-based severity - the "sensitivity"
        // slider recomputes severity live from each op's stored ratio, it
        // never fakes a point's position. \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        const NM = { side: 'a', ops: [], focusedIdx: null, alertRatio: 8.0, watchRatio: 4.0 };
        // shape marker for the Health Map's SVG points - circle/triangle/square,
        // same severity->shape mapping as the .sev-pill::before glyphs above
        function nmMarker(cx, cy, sev, r, dataI) {
            const color = sevColor(sev);
            const attrs = dataI != null ? ` data-i="${dataI}" style="cursor:pointer"` : '';
            if (sev === 'watch') {
                const h = r * 2.1;
                const pts = `${cx},${cy - h * 0.6} ${cx - h * 0.55},${cy + h * 0.4} ${cx + h * 0.55},${cy + h * 0.4}`;
                return `<polygon points="${pts}" fill="${color}" opacity="0.9"${attrs}/>`;
            }
            if (sev === 'anomaly') {
                const s = r * 1.9;
                return `<rect x="${cx - s / 2}" y="${cy - s / 2}" width="${s}" height="${s}" rx="1" fill="${color}" opacity="0.9"${attrs}/>`;
            }
            return `<circle cx="${cx}" cy="${cy}" r="${r}" fill="${color}" opacity="${sev === 'unknown' ? 0.5 : 0.85}"${attrs}/>`;
        }

        function renderHealthMap(ops) {
            const box = document.getElementById('healthMapSection');
