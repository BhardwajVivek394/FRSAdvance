        function nmScoredOps() {
            return NM.ops
                .map((o, i) => ({ o, i, ratio: o['novelty_ratio_' + NM.side], x: o['novelty_x_' + NM.side], y: o['novelty_y_' + NM.side] }))
                .filter(r => r.ratio != null && r.x != null && r.y != null);
        }
        function nmScoreAt(ratio) { return ratio == null ? null : Math.max(0, Math.min(100, Math.round((ratio / NM.alertRatio) * 70))); }
        function nmSeverityAt(ratio) {
            if (ratio == null) return 'unknown';
            if (ratio >= NM.alertRatio) return 'anomaly';
            if (ratio >= NM.watchRatio) return 'watch';
            return 'normal';
        }

        function nmOnSensChange() {
            const v = +document.getElementById('nmSens').value;
            const sensTxt = ['very loose', 'loose', 'medium', 'tight', 'very tight'];
            document.getElementById('nmVSens').textContent = sensTxt[Math.min(4, Math.floor(v / 20.01))];
            NM.alertRatio = 11 - (v / 100) * 7.5;
            NM.watchRatio = NM.alertRatio / 2;
            const pts = nmScoredOps();
            const flagged = pts.filter(p => nmSeverityAt(p.ratio) !== 'normal').length;
            const pct = pts.length ? Math.round(flagged / pts.length * 100) : 0;
            const fpEl = document.getElementById('nmFp');
            fpEl.textContent = `${flagged} / ${pts.length} (${pct}%)`;
            fpEl.style.color = pct <= 10 ? 'var(--nm-green)' : pct <= 30 ? 'var(--nm-amber)' : 'var(--nm-red)';
            nmRenderAll();
        }

        function nmRenderAll() {
            const pts = nmScoredOps();
            if (!pts.length) {
                document.getElementById('nmMap').innerHTML = '';
                document.getElementById('nmTchart').innerHTML = '';
                document.getElementById('nmFeed').innerHTML = '<div style="color:var(--nm-muted); font-size:12px; padding:8px;">No scored operations yet on this side.</div>';
                return;
            }
            if (NM.focusedIdx == null || !pts.find(p => p.i === NM.focusedIdx)) NM.focusedIdx = pts[pts.length - 1].i;
            nmDrawMap(pts);
            nmDrawGauge(pts);
            nmDrawTime(pts);
            nmDrawFeed(pts);
        }

        function nmDrawMap(pts) {
            const svg = document.getElementById('nmMap');
            const cx = 240, cy = 180, scale = 38;
            const toPx = (x, y) => [cx + x * scale, cy + y * scale];
            let s = `<circle cx="${cx}" cy="${cy}" r="${1.5 * scale}" fill="#16a34a0f" stroke="#16a34a33" stroke-width="1"/>`;
            s += `<text x="${cx}" y="${cy - 1.5 * scale - 7}" text-anchor="middle" fill="#16a34a" font-size="10" font-family="IBM Plex Sans">learned normal (~1.5\u03c3)</text>`;
            pts.forEach(p => {
                if (p.i === NM.focusedIdx) return;
                const [px, py] = toPx(p.x, p.y);
                s += nmMarker(px, py, nmSeverityAt(p.ratio), 3.2, p.i);
            });
            const f = pts.find(p => p.i === NM.focusedIdx);
            if (f) {
                const [px, py] = toPx(f.x, f.y);
                s += `<circle cx="${px}" cy="${py}" r="6.5" fill="#4f46e5" stroke="#fff" stroke-width="2"/>`;
                s += `<circle cx="${px}" cy="${py}" r="10" fill="none" stroke="#4f46e5" stroke-width="1" opacity="0.5"/>`;
            }
            svg.innerHTML = s;
            svg.querySelectorAll('[data-i]').forEach(el => {
                el.addEventListener('click', () => { NM.focusedIdx = parseInt(el.getAttribute('data-i'), 10); nmRenderAll(); });
            });
        }

        function nmDrawGauge(pts) {
            const f = pts.find(p => p.i === NM.focusedIdx);
            const score = f ? nmScoreAt(f.ratio) : null;
            const sev = f ? nmSeverityAt(f.ratio) : 'unknown';
            document.getElementById('nmScoreTxt').textContent = score == null ? '\u2013' : score;
            const C = 289, off = score == null ? C : C * (1 - score / 100);
            const arc = document.getElementById('nmScoreArc');
            arc.setAttribute('stroke-dashoffset', off);
            arc.setAttribute('stroke', sev === 'anomaly' ? 'var(--nm-red)' : sev === 'watch' ? 'var(--nm-amber)' : sev === 'normal' ? 'var(--nm-green)' : '#cbd5e1');
            const v = document.getElementById('nmVerdict');
            const labels = { normal: ['Normal', 'nm-v-ok'], watch: ['Watch', 'nm-v-watch'], anomaly: ['Anomaly', 'nm-v-anom'], unknown: ['--', 'nm-v-none'] };
            v.textContent = labels[sev][0]; v.className = 'nm-verdict ' + labels[sev][1];
            document.getElementById('nmFocusedTime').textContent = f ? f.o.time.toLocaleString() : 'no operation focused';
            document.getElementById('nmExplain').innerHTML = f ? noveltyExplainLine(f.o, NM.side) : '';
        }

        function nmDrawTime(pts) {
            const c = document.getElementById('nmTchart'), W = 460, H = 150, mL = 28, mR = 10, mT = 12, mB = 20;
            const n = Math.min(14, pts.length);
            const recent = pts.slice(-n);
            const watchScore = nmScoreAt(NM.watchRatio), alertScore = nmScoreAt(NM.alertRatio);
            const px = i => mL + (n > 1 ? i / (n - 1) * (W - mL - mR) : (W - mL - mR) / 2);
            const py = v => mT + (100 - v) / 100 * (H - mT - mB);
            let s = '';
            [0, 50, 100].forEach(g => { s += `<line x1="${mL}" y1="${py(g)}" x2="${W - mR}" y2="${py(g)}" stroke="#e2e4f0"/>`; });
            s += `<line x1="${mL}" y1="${py(alertScore)}" x2="${W - mR}" y2="${py(alertScore)}" stroke="#dc2626" stroke-width="1.1" stroke-dasharray="5 4"/>`;
            s += `<line x1="${mL}" y1="${py(watchScore)}" x2="${W - mR}" y2="${py(watchScore)}" stroke="#ca8a04" stroke-width="1" stroke-dasharray="3 4"/>`;
            let path = '';
            recent.forEach((p, i) => { const v = nmScoreAt(p.ratio); path += (i ? 'L' : 'M') + px(i) + ' ' + py(v) + ' '; });
            s += `<path d="${path}" fill="none" stroke="#4f46e5" stroke-width="2"/>`;
            recent.forEach((p, i) => {
                const v = nmScoreAt(p.ratio), sev = nmSeverityAt(p.ratio), focused = p.i === NM.focusedIdx;
                s += nmMarker(px(i), py(v), sev, focused ? 4.5 : 2.4, p.i);
            });
            c.innerHTML = s;
            c.querySelectorAll('[data-i]').forEach(el => {
                el.addEventListener('click', () => { NM.focusedIdx = parseInt(el.getAttribute('data-i'), 10); nmRenderAll(); });
            });
        }

        function nmDrawFeed(pts) {
            const el = document.getElementById('nmFeed');
            const recent = pts.slice(-10).reverse();
            el.innerHTML = recent.map(p => {
                const v = nmScoreAt(p.ratio), sev = nmSeverityAt(p.ratio);
                return `<div class="nm-op${p.i === NM.focusedIdx ? ' focused' : ''}" data-i="${p.i}">
                    <span class="glyph" style="color:${sevColor(sev)}">${sevGlyph(sev)}</span>
                    <span class="id">${p.o.time.toLocaleDateString()}</span>
                    <span class="nm-bar"><i style="width:${v}%; background:${sevColor(sev)}"></i></span>
                    <span class="s">${v}</span></div>`;
            }).join('');
            el.querySelectorAll('.nm-op').forEach(row => {
                row.addEventListener('click', () => { NM.focusedIdx = parseInt(row.getAttribute('data-i'), 10); nmRenderAll(); });
            });
        }

// After an "Update Results" (or a "Get Results" that fell back to live), write
// the fresh ops+AI-summary into the SAME cache file the GET endpoint reads -
// so the next "Get Results" click reflects this run, not a stale one.
async function writeClusterCache(pm, start, refTime, ops, dist, aiSummary) {
    try {
        const siteObj = (S.sites || []).find(s => String(s.SiteId) === String(S.currentSiteId));
        await fetch(PMC_ENDPOINTS.clusterCachePost, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                site_id: S.currentSiteId,
                site_name: (siteObj && siteObj.SiteName) || null,
                asset_id: pm.assetId,
                asset_name: pm.assetName,
                window_start: start.toISOString(),
                window_end: refTime.toISOString(),
                ops: ops,
                total_a: dist.a.total, counts_a: dist.a.counts,
                total_b: dist.b.total, counts_b: dist.b.counts,
                ai_summary: aiSummary,
            })
        });
    } catch (e) {
        console.warn('Cluster cache write-through failed:', e.message);
    }
}

// \u2500\u2500 EXPORT JSON / PDF (same pattern as Track Leakage's export buttons) \u2500\u2500\u2500\u2500\u2500\u2500
function exportClusterJson() {
    if (!S.ops.length) { alert('No results to export. Click "Fetch & Compute" first.'); return; }
    const pm = S.selectedAsset;
    const siteObj = (S.sites || []).find(s => String(s.SiteId) === String(S.currentSiteId));
    const dA = sideDistribution(S.ops, 'clusterA');
    const dB = sideDistribution(S.ops, 'clusterB');
    const machinePayload = dist => ({
        total: dist.total,
        clusters: dist.sorted.map(code => ({
            code, label: expandCode(code), count: dist.counts[code],
            pct: dist.total ? Math.round(dist.counts[code] / dist.total * 1000) / 10 : 0,
        })),
    });

    const exportObj = {
        export_meta: {
            exported_at: new Date().toISOString(),
            site_id: S.currentSiteId ?? null,
            site_name: (siteObj && siteObj.SiteName) || null,
            asset_id: pm ? pm.assetId : null,
            asset_name: pm ? pm.assetName : null,
            window_start: S.windowStart ? S.windowStart.toISOString() : null,
            window_end: S.windowEnd ? S.windowEnd.toISOString() : null,
        },
        ai_summary: S.lastAiSummary || null,
        machine_a: machinePayload(dA),
        machine_b: machinePayload(dB),
        // ADDITIVE: self-supervised anomaly score, alongside the cluster export above
        novelty_score: {
            machine_a: noveltySideSummary(S.ops, 'a'),
            machine_b: noveltySideSummary(S.ops, 'b'),
        },
    };

    const blob = new Blob([JSON.stringify(exportObj, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    const safeAsset = (pm ? pm.assetName : 'asset').replace(/[\\/:*?"<>|]+/g, ' ').trim();
    a.href = url;
    a.download = `point machine cluster ${safeAsset}.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
}

// Full PDF report (client-side) \u2014 text + the Monthly Cluster Timeline chart as
// an image, straight off the live Plotly div. No server call.
// Same consecutive-run grouping renderOperationStrip() uses, but returns each
// band's canvas as a PNG data URL (synchronous - Chart.js already drew it to
// the canvas, toDataURL just reads the existing pixel buffer) instead of DOM
// elements.
function collectOperationStripImages(ops, clusterKey, curKey, containerId) {
    const items = ops.filter(o => o[clusterKey] && o[curKey] && o[curKey].length);
    const bands = [];
    items.forEach(o => {
        const code = o[clusterKey].cluster;
        const last = bands[bands.length - 1];
        if (last && last.code === code) last.ops.push(o);
        else bands.push({ code, ops: [o] });
    });
    return bands.map((band, idx) => {
        const canvas = document.getElementById(containerId + '_band' + idx);
        if (!canvas) return null;
        const label = `${band.ops[0].time.toLocaleString()} \u00b7 ${band.ops.length} op${band.ops.length > 1 ? 's' : ''}`;
        return { code: band.code, label, dataUrl: canvas.toDataURL('image/png') };
    }).filter(Boolean);
}

// \u2500\u2500 PDF report: professional layout, plain-language explanations for a
// non-technical reader. Colored verdict banner + real tables (jspdf-autotable)
// instead of the old plain text dump - same underlying data, easier to read. \u2500\u2500
const PDF_COLORS = {
    accent: [79, 70, 229], accentDark: [55, 48, 163],
    green: [22, 163, 74], greenBg: [220, 252, 231],
    amber: [202, 138, 4], amberBg: [254, 249, 195],
    red: [220, 38, 38], redBg: [254, 226, 226],
    gray: [107, 114, 128], grayBg: [243, 244, 246], text: [30, 34, 51],
};

function pdfSeverityRgb(sev) {
    return sev === 'anomaly' ? PDF_COLORS.red : sev === 'watch' ? PDF_COLORS.amber : sev === 'normal' ? PDF_COLORS.green : PDF_COLORS.gray;
}

async function exportClusterPdf(btn) {
    if (!S.ops.length) { alert('No results to export. Click "Fetch & Compute" first.'); return; }
    const pm = S.selectedAsset;
    const siteObj = (S.sites || []).find(s => String(s.SiteId) === String(S.currentSiteId));
    const origLabel = btn ? btn.innerHTML : null;
    if (btn) { btn.disabled = true; btn.textContent = 'Generating PDF\u2026'; }
    try {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF({ unit: 'pt', format: 'a4' });
        const pageW = doc.internal.pageSize.getWidth();
        const pageH = doc.internal.pageSize.getHeight();
        const M = 40;
        let y = M;
        const ensure = (h) => {
            if (y + h > pageH - 50) { doc.addPage(); y = M; return true; }
            return false;
        };
        const setColor = (rgb) => doc.setTextColor(rgb[0], rgb[1], rgb[2]);
        const setFill = (rgb) => doc.setFillColor(rgb[0], rgb[1], rgb[2]);

        const assetName = pm ? pm.assetName : 'asset';
        const siteName = (siteObj && siteObj.SiteName) || '';
        const winStartStr = S.windowStart ? S.windowStart.toLocaleString() : '';
        const winEndStr = S.windowEnd ? S.windowEnd.toLocaleString() : '';

        // \u2500\u2500 Header banner \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        setFill(PDF_COLORS.accent); doc.rect(0, 0, pageW, 86, 'F');
        doc.setTextColor(255, 255, 255);
        doc.setFontSize(18); doc.setFont(undefined, 'bold');
        doc.text('Point Machine Cluster Report', M, 34);
        doc.setFontSize(12); doc.setFont(undefined, 'normal');
        doc.text(`${assetName}${siteName ? '  \u00b7  ' + siteName : ''}`, M, 54);
        doc.setFontSize(9);
        doc.text(`Period: ${winStartStr} to ${winEndStr}`, M, 70);
        doc.setFontSize(8);
        doc.text(`Generated ${new Date().toLocaleString()}`, pageW - M, 70, { align: 'right' });
        y = 108;

        // \u2500\u2500 Plain-language explainer (for a non-technical reader) \u2500\u2500\u2500\u2500\u2500\u2500\u2500
        doc.setFontSize(8.5); doc.setFont(undefined, 'italic'); setColor(PDF_COLORS.gray);
        const explainer = 'This report combines two independent checks on this point machine: (1) Cluster Analysis - grouping every '
            + 'operation by the shape of its electrical signature, using patterns already recorded in the historian, and (2) Self-Supervised '
            + 'Anomaly Score - a model trained only on this machine\'s own past operations that flags any operation whose shape looks unusual, '
            + 'without needing a human to label faults in advance.';
        const explainerLines = doc.splitTextToSize(explainer, pageW - 2 * M);
        doc.text(explainerLines, M, y); y += explainerLines.length * 10.5 + 14;
        doc.setFont(undefined, 'normal');

        // \u2500\u2500 Executive verdict banner - the one thing a busy reader needs first \u2500\u2500
        const sA = noveltySideSummary(S.ops, 'a'), sB = noveltySideSummary(S.ops, 'b');
        const totalAnomaly = sA.counts.anomaly + sB.counts.anomaly;
        const totalWatch = sA.counts.watch + sB.counts.watch;
        const totalScored = (sA.total - sA.counts.unknown) + (sB.total - sB.counts.unknown);
        const hasNovelty = totalScored > 0;
        let verdictColor, verdictBg, verdictText, verdictDetail;
        if (!hasNovelty) {
            verdictColor = PDF_COLORS.gray; verdictBg = PDF_COLORS.grayBg;
            verdictText = 'Not enough history yet to score this machine';
            verdictDetail = 'The self-supervised model needs more past operations before it can judge what is "normal" for this machine.';
        } else if (totalAnomaly > 0) {
            verdictColor = PDF_COLORS.red; verdictBg = PDF_COLORS.redBg;
            verdictText = 'This machine needs a closer look';
            verdictDetail = `${totalAnomaly} operation${totalAnomaly === 1 ? '' : 's'} scored as a clear anomaly, and ${totalWatch} more as borderline (watch), across both machines in this period.`;
        } else if (totalWatch > 0) {
            verdictColor = PDF_COLORS.amber; verdictBg = PDF_COLORS.amberBg;
            verdictText = 'A few operations look borderline';
            verdictDetail = `${totalWatch} operation${totalWatch === 1 ? '' : 's'} scored as "watch" (mildly unusual). No clear anomalies were found.`;
        } else {
            verdictColor = PDF_COLORS.green; verdictBg = PDF_COLORS.greenBg;
            verdictText = 'No unusual behavior detected';
            verdictDetail = `All ${totalScored} scored operations in this period matched this machine's normal historical pattern.`;
        }
        ensure(56);
        setFill(verdictBg); doc.roundedRect(M, y, pageW - 2 * M, 46, 6, 6, 'F');
        setFill(verdictColor); doc.circle(M + 18, y + 23, 6, 'F');
        setColor(verdictColor); doc.setFontSize(12.5); doc.setFont(undefined, 'bold');
        doc.text(verdictText, M + 34, y + 19);
        doc.setFontSize(9); doc.setFont(undefined, 'normal'); setColor(PDF_COLORS.text);
        doc.text(doc.splitTextToSize(verdictDetail, pageW - 2 * M - 40), M + 34, y + 34);
        y += 46 + 18;

        // \u2500\u2500 AI-generated summary (existing feature, kept) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        if (S.lastAiSummary) {
            const verdictLines = doc.splitTextToSize(S.lastAiSummary.verdict || '', pageW - 2 * M - 20);
            const pointLines = (S.lastAiSummary.points || []).map(p => doc.splitTextToSize('\u2022  ' + p, pageW - 2 * M - 20));
            const recLines = S.lastAiSummary.recommendation ? doc.splitTextToSize('Recommendation: ' + S.lastAiSummary.recommendation, pageW - 2 * M - 20) : [];
            const boxH = 24 + verdictLines.length * 12 + pointLines.reduce((a, l) => a + l.length * 11, 0) + recLines.length * 11 + 14;
            ensure(boxH + 10);
            setFill(PDF_COLORS.grayBg); doc.roundedRect(M, y, pageW - 2 * M, boxH, 6, 6, 'F');
            let iy = y + 18;
            doc.setFontSize(10.5); doc.setFont(undefined, 'bold'); setColor(PDF_COLORS.accentDark);
            doc.text('AI-Generated Summary', M + 12, iy); iy += 14;
            doc.setFontSize(9.5); doc.setFont(undefined, 'bold'); setColor(PDF_COLORS.text);
            doc.text(verdictLines, M + 12, iy); iy += verdictLines.length * 12 + 4;
            doc.setFont(undefined, 'normal');
            pointLines.forEach(lines => { doc.text(lines, M + 12, iy); iy += lines.length * 11; });
            if (recLines.length) {
                iy += 3; doc.setFont(undefined, 'italic'); setColor(PDF_COLORS.accentDark);
                doc.text(recLines, M + 12, iy); doc.setFont(undefined, 'normal');
            }
            y += boxH + 18;
        }

        // \u2500\u2500 Per-machine sections - ALL of Machine A first (score, cluster
        // breakdown, timeline, waveforms), then ALL of Machine B, per the
        // user's requested order. Any section with no data for that machine
        // is simply skipped rather than leaving a gap. \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        const SAMPLE_CAP = 12;
        for (const side of ['A', 'B']) {
            const sideLower = side.toLowerCase();
            const machineLabel = `Machine ${side}`;
            const sSide = side === 'A' ? sA : sB;
            const sideHasNovelty = (sSide.total - sSide.counts.unknown) > 0;

            ensure(26);
            doc.setFontSize(13); doc.setFont(undefined, 'bold'); setColor(PDF_COLORS.accentDark);
            doc.text(machineLabel, M, y); y += 6;
            doc.setDrawColor(PDF_COLORS.accent[0], PDF_COLORS.accent[1], PDF_COLORS.accent[2]);
            doc.setLineWidth(1.4); doc.line(M, y, M + 40, y); doc.setLineWidth(0.5);
            y += 16;

            // Self-Supervised Anomaly Score (this machine only)
            if (sideHasNovelty) {
                ensure(30);
                doc.setFontSize(11); doc.setFont(undefined, 'bold'); setColor(PDF_COLORS.text);
                doc.text(`${machineLabel} - Self-Supervised Anomaly Score`, M, y); y += 6;
                doc.setFontSize(8); doc.setFont(undefined, 'normal'); setColor(PDF_COLORS.gray);
                doc.text('0-100 per operation - higher means this operation looked harder for the model to reconstruct vs. this machine\'s own history.', M, y + 10);
                y += 22;
                doc.autoTable({
                    startY: y, margin: { left: M, right: M },
                    head: [['Total Ops', 'Normal', 'Watch', 'Anomaly', 'Avg Score', 'Worst Score']],
                    body: [[sSide.total, sSide.counts.normal, sSide.counts.watch, sSide.counts.anomaly, sSide.avg ?? '-', sSide.worst ?? '-']],
                    theme: 'grid', styles: { fontSize: 9, cellPadding: 5 },
                    headStyles: { fillColor: PDF_COLORS.accent, textColor: 255, fontStyle: 'bold' },
                    didParseCell: (data) => {
                        if (data.section !== 'body') return;
                        if (data.column.index === 2 && Number(data.cell.raw) > 0) data.cell.styles.textColor = PDF_COLORS.amber;
                        if (data.column.index === 3 && Number(data.cell.raw) > 0) { data.cell.styles.textColor = PDF_COLORS.red; data.cell.styles.fontStyle = 'bold'; }
                    },
                });
                y = doc.lastAutoTable.finalY + 18;
            }

            // Cluster Breakdown (this machine only)
            const dist = sideDistribution(S.ops, side === 'A' ? 'clusterA' : 'clusterB');
            if (dist.sorted.length) {
                ensure(30);
                doc.setFontSize(11); doc.setFont(undefined, 'bold'); setColor(PDF_COLORS.text);
                doc.text(`${machineLabel} - Cluster Breakdown (${dist.total} operations)`, M, y); y += 8;
                const rows = dist.sorted.map(code => {
                    const count = dist.counts[code];
                    const pct = dist.total ? Math.round(count / dist.total * 1000) / 10 : 0;
                    const ab = clusterAbnormalStats(S.ops, side, code);
                    return [code, expandCode(code) || '-', count, `${pct}%`, ab.scored ? `${ab.pct}%` : 'n/a'];
                });
                doc.autoTable({
                    startY: y + 6, margin: { left: M, right: M },
                    head: [['Code', 'Meaning', 'Ops', '% of Total', 'Abnormal %']],
                    body: rows,
                    theme: 'grid', styles: { fontSize: 8.5, cellPadding: 4 },
                    headStyles: { fillColor: PDF_COLORS.accentDark, textColor: 255, fontStyle: 'bold' },
                    didParseCell: (data) => {
                        if (data.section !== 'body' || data.column.index !== 4) return;
                        const v = parseInt(data.cell.raw, 10);
                        if (!isNaN(v) && v >= 50) { data.cell.styles.textColor = PDF_COLORS.red; data.cell.styles.fontStyle = 'bold'; }
                        else if (!isNaN(v) && v > 0) data.cell.styles.textColor = PDF_COLORS.amber;
                    },
                });
                y = doc.lastAutoTable.finalY + 18;
            }

            // Cluster Timeline (this machine only)
            const elId = side === 'A' ? 'timelineA' : 'timelineB';
            const el = document.getElementById(elId);
            if (el && el.data) {
                try {
                    const png = await Plotly.toImage(el, { format: 'png', width: 900, height: 220 });
                    const w = pageW - 2 * M, h = w * (220 / 900);
                    ensure(h + 26);
                    doc.setFontSize(10.5); doc.setFont(undefined, 'bold'); setColor(PDF_COLORS.text);
                    doc.text(`${machineLabel} - Cluster Timeline`, M, y); y += 12;
                    doc.setDrawColor(226, 228, 240); doc.rect(M, y, w, h);
                    doc.addImage(png, 'PNG', M, y, w, h);
                    y += h + 16;
                } catch (e) { /* chart not ready - skip rather than fail the whole export */ }
            }

            // Sample Waveforms (this machine only) - capped so the PDF stays a
            // reasonable size; the on-screen dashboard has the full set.
            const clusterKey = side === 'A' ? 'clusterA' : 'clusterB', curKey = side === 'A' ? 'aCur' : 'bCur', containerId = side === 'A' ? 'gridA' : 'gridB';
            const images = collectOperationStripImages(S.ops, clusterKey, curKey, containerId).slice(0, SAMPLE_CAP);
            if (images.length) {
                ensure(24);
                doc.setFontSize(10.5); doc.setFont(undefined, 'bold'); setColor(PDF_COLORS.text);
                doc.text(`${machineLabel} - Sample Waveforms (first ${images.length} bands)`, M, y); y += 12;
                doc.setFont(undefined, 'normal');
                let x = M;
                const w = 115, h = 74;
                images.forEach(img => {
                    if (x + w > pageW - M) { x = M; y += h + 20; ensure(h + 20); }
                    ensure(h + 20);
                    doc.setFontSize(7.5); setColor(PDF_COLORS.text);
                    doc.text(`${img.code}`, x, y);
                    doc.setDrawColor(226, 228, 240); doc.rect(x, y + 3, w, h);
                    doc.addImage(img.dataUrl, 'PNG', x, y + 3, w, h);
                    x += w + 8;
                });
                y += h + 26;
            }

            y += 6;
        }

        // \u2500\u2500 ADDITIVE: final "How to Read This Report" page - a plain-language
        // walkthrough so a first-time or non-technical reader knows what every
        // color/table/chart above actually means, without re-reading the app. \u2500\u2500
        doc.addPage(); y = M;
        doc.setFontSize(15); doc.setFont(undefined, 'bold'); setColor(PDF_COLORS.accentDark);
        doc.text('How to Read This Report', M, y); y += 10;
        doc.setDrawColor(PDF_COLORS.accent[0], PDF_COLORS.accent[1], PDF_COLORS.accent[2]);
        doc.setLineWidth(1.4); doc.line(M, y, M + 60, y); doc.setLineWidth(0.5);
        y += 22;

        const guideItem = (title, body) => {
            const titleLines = doc.splitTextToSize(title, pageW - 2 * M);
            const bodyLines = doc.splitTextToSize(body, pageW - 2 * M);
            ensure(titleLines.length * 13 + bodyLines.length * 11 + 12);
            doc.setFontSize(10.5); doc.setFont(undefined, 'bold'); setColor(PDF_COLORS.text);
            doc.text(titleLines, M, y); y += titleLines.length * 13 + 2;
            doc.setFontSize(9.5); doc.setFont(undefined, 'normal'); setColor(PDF_COLORS.gray);
            doc.text(bodyLines, M, y); y += bodyLines.length * 11 + 12;
        };

        guideItem('1. Start with the colored banner near the top of this report.',
            'Green means no unusual behavior was found, amber means a few operations looked borderline, and red means '
            + 'at least one operation clearly stood out from this machine\'s own history - that banner is the fastest way '
            + 'to tell whether this machine needs a closer look.');
        guideItem('2. The Cluster Breakdown table groups operations by shape.',
            'Every code has a wave letter (T=TWS, I=IRS), a quality letter (G=Good, B=Bad, M=Medium), and a number that just '
            + 'tells clusters of the same quality apart. The code "T0" or "I0" is a special reserved code meaning Obstruction '
            + '(a mechanical blockage/jam), not "no letter".');
        guideItem('3. The Self-Supervised Anomaly Score is a second, independent opinion.',
            'It does not know about cluster codes or fault names at all - a small model learns what "normal" looks like from '
            + 'this machine\'s own history, then scores every new operation 0-100 by how hard it is to match to that pattern. '
            + 'Normal is below 35, Watch is 35-70 (mildly unusual), and Anomaly is above 70 (clearly different).');
        guideItem('4. The Cluster Timeline chart shows how this machine behaved over time.',
            'Each colored bar is one operation, held until the next one - a run of the same color means the machine kept '
            + 'behaving consistently; a sudden change in color is worth investigating first.');
        guideItem('5. The Sample Waveforms are the actual electrical signal for a few real operations.',
            'The current (top, orange on-screen) and voltage (bottom, teal on-screen) shapes are what both the cluster match '
            + 'and the anomaly score are based on - useful for a quick visual sanity check against what the tables above say.');

        ensure(50);
        doc.setFontSize(9.5); doc.setFont(undefined, 'bold'); setColor(PDF_COLORS.text);
        doc.text('Severity color legend (used throughout this report):', M, y); y += 14;
        const legend = [['Normal', PDF_COLORS.green], ['Watch', PDF_COLORS.amber], ['Anomaly', PDF_COLORS.red], ['Not enough history', PDF_COLORS.gray]];
        let lx = M;
        legend.forEach(([text, rgb]) => {
            setFill(rgb); doc.roundedRect(lx, y - 8, 10, 10, 2, 2, 'F');
            doc.setFontSize(9); doc.setFont(undefined, 'normal'); setColor(PDF_COLORS.text);
            doc.text(text, lx + 14, y);
            lx += doc.getTextWidth(text) + 34;
        });
        y += 24;

        // \u2500\u2500 Footer on every page: page numbers + a plain-language disclaimer \u2500\u2500
        const pageCount = doc.internal.getNumberOfPages();
        for (let i = 1; i <= pageCount; i++) {
            doc.setPage(i);
            doc.setDrawColor(226, 228, 240); doc.line(M, pageH - 34, pageW - M, pageH - 34);
            doc.setFontSize(7.5); doc.setFont(undefined, 'normal'); setColor(PDF_COLORS.gray);
            doc.text('The self-supervised score is a statistical deviation signal, not a certified fault diagnosis - use it alongside the cluster codes above.', M, pageH - 22);
            doc.text(`Page ${i} of ${pageCount}`, pageW - M, pageH - 22, { align: 'right' });
        }

        const safeAsset = assetName.replace(/[\\/:*?"<>|]+/g, ' ').trim();
        doc.save(`point machine cluster ${safeAsset}.pdf`);
    } catch (e) {
        alert('PDF export failed: ' + e.message);
    } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = origLabel; }
    }
}

        async function analyzeClusters(forceLive) {
            const pm = S.selectedAsset;
            if (!pm) { toast('Select a point machine first', 'error'); return; }
            const refInput = document.getElementById('refTime').value;
            const refTime = refInput ? new Date(refInput) : new Date();

            const loading = document.getElementById('loading');
            const loadingText = document.getElementById('loadingText');
            const results = document.getElementById('results');
            const empty2 = document.getElementById('empty2');
            const btns = [document.getElementById('updateResultsBtn')];

            empty2.style.display = 'none';
            results.style.display = 'none';
            loading.style.display = 'block';
            loadingText.textContent = 'Fetching last 30 days of operations\u2026';
            btns.forEach(b => b.disabled = true);
            // Reset the additive cluster-detail panels + trend filter from any previous machine.
            ['clusterOpsDetailA', 'clusterOpsDetailB'].forEach(id => {
                const el = document.getElementById(id);
                el.style.display = 'none'; el.innerHTML = '';
            });
            S.trendFilter = { a: null, b: null };

            try {
                let start = new Date(refTime.getTime() - 30 * 24 * 3600 * 1000);
                let ops = null;
                let cachedAiSummary = null;
                let fromCache = false;

                // Fast path: last write-through for this asset. "Update Results"
                // always skips this and forces a fresh live run.
                if (!forceLive) {
                    loadingText.textContent = 'Checking local cache\u2026';
                    try {
                        const cacheUrl = `${PMC_ENDPOINTS.clusterCache}?SiteId=${encodeURIComponent(S.currentSiteId)}&AssetId=${encodeURIComponent(pm.assetId)}`;
                        const cr = await fetch(cacheUrl);
                        if (cr.ok) {
                            const cached = await cr.json();
                            if (cached && Array.isArray(cached.ops)) {
                                ops = cached.ops.map(o => ({ ...o, time: new Date(o.time) }));
                                start = new Date(cached.window_start);
                                cachedAiSummary = cached.ai_summary || null;
                                fromCache = true;
                            }
                        }
                    } catch (e) {
                        console.warn('Cluster cache check failed, falling back to live fetch:', e.message);
                    }
                }

                if (!ops) {
                    // ADDITIVE: this used to build `ops` here by hand from
                    // /api/pmdata (parsing ClusterA/B client-side only) - that
                    // path never computed novelty_score_a/b, so any asset that
                    // hadn't yet gone through the scheduled server-side refresh
                    // silently showed no self-supervised section at all. Now it
                    // calls the SAME server-side refresh (cluster parsing +
                    // novelty scoring together) the nightly job uses, so a live
                    // "Fetch & Compute" and a cache hit always agree.
                    loadingText.textContent = 'Running live analysis (clusters + self-supervised scoring)\u2026';
                    const r = await fetch(PMC_ENDPOINTS.refreshLive, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ site_id: S.currentSiteId, asset_id: pm.assetId }),
                    });
                    if (!r.ok) {
                        let detail = '';
                        try { detail = (await r.json()).detail || ''; } catch (e) { /* ignore */ }
                        throw new Error(`HTTP ${r.status}${detail ? ' - ' + detail : ''}`);
                    }
                    const cached = await r.json();
                    if (!cached || !Array.isArray(cached.ops) || !cached.ops.length) {
                        loading.style.display = 'none'; empty2.style.display = 'block';
                        empty2.textContent = 'No operations found for this asset in the last 30 days.';
                        return;
                    }

                    ops = cached.ops.map(o => ({ ...o, time: new Date(o.time) }));
                    start = new Date(cached.window_start);
                    cachedAiSummary = cached.ai_summary || null;
                    fromCache = true; // already persisted server-side by refresh_live - skip writeClusterCache below
                }

                if (!ops.length) {
                    loading.style.display = 'none'; empty2.style.display = 'block';
                    empty2.textContent = 'No operations found for this asset in the last 30 days.';
                    return;
                }

                await renderClusterView(pm, ops, start, refTime, cachedAiSummary, !fromCache);
            } catch (e) {
                loading.style.display = 'none'; empty2.style.display = 'block';
                empty2.textContent = 'Failed: ' + e.message;
                toast('Cluster analysis failed: ' + e.message, 'error');
            } finally {
                btns.forEach(b => b.disabled = false);
            }
        }

        // \u2500\u2500 ADDITIVE: shared render tail for BOTH quick (last-30-days) and
        // custom-date-range results - identical rendering pipeline either way,
        // just `shouldPersist` differs (custom ranges are never cached). \u2500\u2500\u2500\u2500\u2500\u2500
        async function renderClusterView(pm, ops, start, end, cachedAiSummary, shouldPersist) {
            S.colorMap = {};
            S.shadeIndex = {};
            S.timelineShapes = { A: [], B: [] };
            S.ops = ops;

            const withClusters = ops.filter(o => o.clusterA || o.clusterB).length;
            document.getElementById('clusterSub').textContent =
                `${ops.length} operations \u00b7 ${withClusters} clustered \u00b7 ${start.toLocaleDateString()} \u2192 ${end.toLocaleDateString()}`;

            document.getElementById('loading').style.display = 'none';
            document.getElementById('results').style.display = 'block';
            document.getElementById('empty2').style.display = 'none';
            document.getElementById('detail').style.display = 'none';
            const dA = renderSummary(ops);
            renderNoveltyAlert(ops);
            renderNoveltySummary(ops);
            renderHealthMap(ops);
            renderTimelines(ops, start, end);
            renderNoveltyTimelines(ops, start, end);
            renderGridView(ops, end);
            const aiSummary = await renderAiSummary(pm.assetName, dA.a, dA.b, cachedAiSummary);
            S.lastAiSummary = aiSummary;  // for Export JSON/PDF
            S.windowStart = start; S.windowEnd = end;

            // Live computation (forced, or a cache-miss fallback) - persist it
            // into the cache so the next "Get Results" click sees this run.
            // Custom-date-range results never persist (see applyCustomDates).
            if (shouldPersist) {
                writeClusterCache(pm, start, end, ops, dA, aiSummary);
            }
        }

        // \u2500\u2500 ADDITIVE: Custom Dates mode (same idea as pm_operation3) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        function switchClusterMode(mode) {
            S.clusterMode = mode;
            updateCompactSidebar();
            const quickBtn = document.getElementById('modeQuickBtn');
            const customBtn = document.getElementById('modeCustomBtn');
            quickBtn.style.background = mode === 'quick' ? 'var(--accent)' : 'transparent';
            quickBtn.style.color = mode === 'quick' ? '#fff' : 'var(--text-secondary)';
            customBtn.style.background = mode === 'custom' ? 'var(--accent)' : 'transparent';
            customBtn.style.color = mode === 'custom' ? '#fff' : 'var(--text-secondary)';
            document.getElementById('quickModeRow').style.display = mode === 'quick' ? 'flex' : 'none';
            document.getElementById('quickPmSection').style.display = mode === 'quick' ? 'block' : 'none';
            document.getElementById('customDatePanel').style.display = mode === 'custom' ? 'block' : 'none';
            if (mode === 'custom') {
                const toInput = document.getElementById('customToDate');
                const fromInput = document.getElementById('customFromDate');
                const today = new Date().toISOString().split('T')[0];
                const past30 = new Date(); past30.setDate(past30.getDate() - 30);
                if (!toInput.value) toInput.value = today;
                if (!fromInput.value) fromInput.value = past30.toISOString().split('T')[0];
                toInput.max = today; fromInput.max = today;
                renderCustomPmSelect();
                validateCustomDateRange();
            }
        }

        // \u2500\u2500 ADDITIVE: custom-mode's own Point Machine dropdown (sidebar) - kept
        // in sync with S.pointMachines the same way renderPmList() is. \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        function renderCustomPmSelect() {
            const sel = document.getElementById('customPmSelect');
            if (!sel) return;
            const current = sel.value;
            sel.innerHTML = '<option value="">-- Select --</option>' +
                S.pointMachines.map((pm, i) => `<option value="${i}">${pm.assetName}</option>`).join('');
            if (current !== '' && S.pointMachines[current]) sel.value = current;
            else if (S.selectedAsset) {
                const idx = S.pointMachines.findIndex(p => p.assetId === S.selectedAsset.assetId);
                if (idx >= 0) sel.value = String(idx);
            }
        }

        function getCustomDateRange() {
            const fromVal = document.getElementById('customFromDate').value;
            const toVal = document.getElementById('customToDate').value;
            if (!fromVal || !toVal) return null;
            const fromTime = document.getElementById('customFromTime').value || '00:00:00';
            const toTime = document.getElementById('customToTime').value || '23:59:59';
            const fullFromTime = fromTime.length === 5 ? fromTime + ':00' : fromTime;
            const fullToTime = toTime.length === 5 ? toTime + ':00' : toTime;
            return {
                startDate: new Date(`${fromVal}T${fullFromTime}`),
                endDate: new Date(`${toVal}T${fullToTime}`),
            };
        }

        function validateCustomDateRange() {
            const errorEl = document.getElementById('customDateError');
            const applyBtn = document.getElementById('applyCustomDatesBtn');
            const range = getCustomDateRange();
            if (!range) { errorEl.style.display = 'none'; applyBtn.disabled = true; return false; }
            const diffDays = (range.endDate - range.startDate) / (1000 * 60 * 60 * 24);
            if (diffDays <= 0) {
                errorEl.textContent = 'Invalid range: "To" must be after "From".';
                errorEl.style.display = 'block'; applyBtn.disabled = true; return false;
            }
            if (diffDays > 90) {
                errorEl.textContent = `Range exceeds the 90-day max (selected: ${diffDays.toFixed(1)} days).`;
                errorEl.style.display = 'block'; applyBtn.disabled = true; return false;
            }
            errorEl.style.display = 'none'; applyBtn.disabled = false; return true;
        }

        async function applyCustomDates() {
            const idx = document.getElementById('customPmSelect').value;
            if (idx === '') { toast('Select a point machine first', 'error'); return; }
            if (!validateCustomDateRange()) return;
            const range = getCustomDateRange();
            const pm = S.pointMachines[idx];
            S.selectedAsset = pm;
            renderPmList();
            updateCompactSidebar();

            document.getElementById('emptyState').style.display = 'none';
            document.getElementById('mainView').style.display = 'flex';
            document.getElementById('assetTitle').textContent = pm.assetName;
            document.getElementById('assetBreadcrumb').textContent = pm.assetName;
            document.getElementById('assetSub').textContent = `Asset ID ${pm.assetId}`;

            const loading = document.getElementById('loading');
            const loadingText = document.getElementById('loadingText');
            const results = document.getElementById('results');
            const empty2 = document.getElementById('empty2');
            const applyBtn = document.getElementById('applyCustomDatesBtn');

            empty2.style.display = 'none';
            results.style.display = 'none';
            loading.style.display = 'block';
            loadingText.textContent = 'Running live analysis for selected range (clusters + self-supervised scoring)\u2026';
            applyBtn.disabled = true;
            ['clusterOpsDetailA', 'clusterOpsDetailB'].forEach(id => {
                const el = document.getElementById(id);
                el.style.display = 'none'; el.innerHTML = '';
            });
            S.trendFilter = { a: null, b: null };

            try {
                const r = await fetch(PMC_ENDPOINTS.refreshCustomRange, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        site_id: S.currentSiteId, asset_id: pm.assetId,
                        start: range.startDate.toISOString(), end: range.endDate.toISOString(),
                    }),
                });
                if (!r.ok) {
                    let detail = '';
                    try { detail = (await r.json()).detail || ''; } catch (e) { /* ignore */ }
                    throw new Error(`HTTP ${r.status}${detail ? ' - ' + detail : ''}`);
                }
                const result = await r.json();
                if (!result || !Array.isArray(result.ops) || !result.ops.length) {
                    loading.style.display = 'none'; empty2.style.display = 'block';
                    empty2.textContent = 'No operations found for this asset in the selected date range.';
                    return;
                }

                const ops = result.ops.map(o => ({ ...o, time: new Date(o.time) }));
                const start = new Date(result.window_start);
                const end = new Date(result.window_end);
                await renderClusterView(pm, ops, start, end, result.ai_summary || null, false);
            } catch (e) {
                loading.style.display = 'none'; empty2.style.display = 'block';
                empty2.textContent = 'Failed: ' + e.message;
                toast('Custom-range analysis failed: ' + e.message, 'error');
            } finally {
                applyBtn.disabled = false;
            }
        }

        // \u2500\u2500 SUMMARY: per-side cluster distribution \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        function sideDistribution(ops, key) {
            const counts = {};
            let total = 0;
            ops.forEach(o => {
                const c = o[key];
                if (!c) return;
                total++;
                counts[c.cluster] = (counts[c.cluster] || 0) + 1;
            });
            const sorted = Object.keys(counts).sort((a, b) => counts[b] - counts[a]);
            return { total, counts, sorted };
        }

        function sideBlock(label, dist, ops) {
            const chips = dist.sorted.map(cl => {
                const c = dist.counts[cl];
                const p = dist.total ? Math.round(c / dist.total * 1000) / 10 : 0;
                const safeCl = cl.replace(/'/g, "\\'");
                // ADDITIVE: how abnormal does the self-supervised score think THIS
                // cluster's own operations are - not a per-op score, a per-cluster rate.
                const ab = ops ? clusterAbnormalStats(ops, label, cl) : null;
                let abBadge = '';
                if (ab && ab.scored) {
                    const sev = ab.pct >= 50 ? 'anomaly' : ab.pct > 0 ? 'watch' : 'normal';
                    abBadge = ` <span class="sev-pill pill-${sev}" title="${ab.abnormal} of ${ab.scored} scored operations in this cluster were watch/anomaly">${ab.pct}% abnormal</span>`;
                }
                return `<span class="chip" style="cursor:pointer;" title="Click to plot all ${c} operations of this cluster" onclick="showClusterOps('${label}','${safeCl}')"><span class="dot" style="background:${colorFor(cl)};"></span>${cl} <b>${c}</b> <span style="opacity:0.7;">(${p}%)</span>${abBadge}</span>`;
            }).join('');
            return `<div style="flex:1; min-width:320px; background:var(--bg-card); border:1px solid var(--border); border-radius:12px; padding:16px;">
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px;">
                    <span style="font-size:15px; font-weight:800;">${label}</span>
                    <span style="font-size:12px; color:var(--text-muted); font-weight:700;">${dist.total} ops \u00b7 ${dist.sorted.length} clusters</span>
                </div>
                <div style="display:flex; gap:8px; flex-wrap:wrap;">${chips || '<span style="font-size:12px; color:var(--text-muted);">No cluster data</span>'}</div>
            </div>`;
        }

        // \u2500\u2500 ADDITIVE: click a cluster chip/band -> plot ALL of that cluster's
        // operations right below that SAME side's strip (no auto-scroll - it
        // appears in place, right where you clicked, not jumping elsewhere). \u2500\u2500
        function showClusterOps(side, code) {
            const clusterKey = side === 'A' ? 'clusterA' : 'clusterB';
            const curKey = side === 'A' ? 'aCur' : 'bCur';
            const sideLetter = side.toLowerCase();
            const matches = S.ops.filter(o => o[clusterKey] && o[clusterKey].cluster === code && o[curKey] && o[curKey].length);
            const box = document.getElementById('clusterOpsDetail' + side);
            box.style.display = 'block';

            if (!matches.length) {
                box.innerHTML = `<div class="card-title"><span>Cluster ${code} \u2014 Side ${side}</span></div>
                    <div style="font-size:13px; color:var(--text-muted);">No plottable operations for this cluster.</div>`;
                return;
            }

            const ab = clusterAbnormalStats(S.ops, side, code);
            const abText = ab.scored
                ? `<span style="text-transform:none; font-weight:500;">Self-supervised: <b class="sev-${ab.pct >= 50 ? 'anomaly' : ab.pct > 0 ? 'watch' : 'normal'}">${ab.pct}% abnormal</b> (${ab.abnormal} of ${ab.scored} scored)</span>`
                : `<span style="text-transform:none; font-weight:500; color:var(--text-muted);">not enough scored operations yet</span>`;
            box.innerHTML = `<div class="card-title">
                    <span><span class="chip" style="background:${colorFor(code)}22; border-color:${colorFor(code)};"><span class="dot" style="background:${colorFor(code)};"></span>${code}</span> \u2014 Side ${side}</span>
                    <span style="text-transform:none; font-weight:500; color:var(--text-muted);">${matches.length} operations, time order</span>
                </div>
                <div style="font-size:12.5px; margin-bottom:10px;">${abText} \u2014 how much of THIS cluster's own history does the self-supervised score consider unusual for this machine.</div>
                <div style="display:flex; overflow-x:auto; gap:10px; padding-bottom:8px;" id="clusterOpsStrip${side}"></div>
                <div id="clusterOpPointDetail${side}" style="display:none; margin-top:10px;"></div>`;

            const strip = document.getElementById('clusterOpsStrip' + side);
            matches.forEach((o, idx) => {
                const score = o['novelty_score_' + sideLetter];
                const sev = o['novelty_severity_' + sideLetter] || 'unknown';
                const cell = document.createElement('div');
                cell.style.cssText = `flex:0 0 150px; min-width:0; border:1px solid var(--border); border-radius:10px; padding:8px; background:var(--bg-tertiary); cursor:pointer;`;
                const canvasId = 'clusterOp_' + side + '_' + idx;
                const badge = score != null ? `<span class="sev-pill pill-${sev}" style="float:right;">Score ${score}</span>` : '';
                cell.innerHTML = `<div style="margin-bottom:4px;">${badge}</div>
                    <div style="font-size:9px; color:var(--text-muted); margin-bottom:4px;">${o.time.toLocaleString()}</div>
                    <div style="height:90px; width:100%; position:relative;"><canvas id="${canvasId}"></canvas></div>`;
                // Plot THIS operation's waveform right here, inside this same
                // cluster-detail box (not the shared #detail panel far below).
                cell.addEventListener('click', () => showDetail(o, side, 'clusterOpPointDetail' + side));
                strip.appendChild(cell);
                drawStripChart(canvasId, [o[curKey]], colorFor(code));
            });
        }

        function renderSummary(ops) {
            const dA = sideDistribution(ops, 'clusterA');
            const dB = sideDistribution(ops, 'clusterB');
            document.getElementById('summary').innerHTML =
                `<div style="display:flex; gap:16px; flex-wrap:wrap;">
                    ${sideBlock('A', dA, ops)}
                    ${sideBlock('B', dB, ops)}
                </div>`;
            return { a: dA, b: dB };
        }

        // \u2500\u2500 ADDITIVE: for one cluster code on one side, what % of ITS OWN
        // operations does the self-supervised score call abnormal (watch+anomaly)?
        // This is the real question - "is this cluster actually abnormal-looking
        // to the self-supervised model" - not just a per-op label. \u2500\u2500
        function clusterAbnormalStats(ops, side, code) {
            const clusterKey = side === 'A' ? 'clusterA' : 'clusterB';
            const sevKey = 'novelty_severity_' + side.toLowerCase();
            const matches = ops.filter(o => o[clusterKey] && o[clusterKey].cluster === code);
            const scored = matches.filter(o => o[sevKey] && o[sevKey] !== 'unknown');
            const abnormal = scored.filter(o => o[sevKey] === 'watch' || o[sevKey] === 'anomaly');
            return {
                total: matches.length, scored: scored.length, abnormal: abnormal.length,
                pct: scored.length ? Math.round(abnormal.length / scored.length * 100) : null,
            };
        }

        // \u2500\u2500 AI SUMMARY (Claude, server-side) \u2014 structured verdict + bullets \u2500\u2500\u2500\u2500
        function escapeHtml(s) {
            const d = document.createElement('div');
            d.textContent = s == null ? '' : String(s);
            return d.innerHTML;
        }

        function renderSummaryHtml(data) {
            const points = Array.isArray(data.points) ? data.points : [];
            const bullets = points.map(p => `<li style="margin-bottom:4px;">${escapeHtml(p)}</li>`).join('');
            return `<div style="font-weight:800; font-size:14.5px; margin-bottom:8px;">${escapeHtml(data.verdict)}</div>`
                + (bullets ? `<ul style="margin:0 0 8px 18px; padding:0;">${bullets}</ul>` : '')
                + (data.recommendation
                    ? `<div style="margin-top:6px;"><b>Recommendation:</b> ${escapeHtml(data.recommendation)}</div>`
                    : '');
        }

        // Returns the {verdict,points,recommendation} object it rendered (cached
        // or freshly generated), or null on failure - callers use this to write a
        // live result through to the local cache (see analyzeClusters).
        async function renderAiSummary(assetName, dA, dB, cachedSummary) {
            const box = document.getElementById('aiSummary');
            const txt = document.getElementById('aiSummaryText');
            box.style.display = 'block';

            // Cache already has this exact summary (see point_machine_cluster
            // cache write-through) - use it instantly instead of re-calling
            // Claude live for the same data.
            if (cachedSummary) {
                txt.innerHTML = renderSummaryHtml(cachedSummary);
                return cachedSummary;
            }

            txt.textContent = 'Generating\u2026';
            const siteObj = (S.sites || []).find(s => String(s.SiteId) === String(S.currentSiteId));
            try {
                const r = await fetch(PMC_ENDPOINTS.clusterSummary, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        asset_name: assetName,
                        site_name: (siteObj && siteObj.SiteName) || null,
                        total_a: dA.total, counts_a: dA.counts,
                        total_b: dB.total, counts_b: dB.counts,
                    }),
                });
                const data = await r.json();
                if (!r.ok) throw new Error(data.detail || `HTTP ${r.status}`);
                txt.innerHTML = renderSummaryHtml(data);
                return data;
            } catch (e) {
                box.style.display = 'none';
                console.warn('AI summary unavailable:', e.message);
                return null;
            }
        }

        // \u2500\u2500 OPERATION STRIP: one mini-chart per OPERATION (not per cluster) in
        // the SAME left-to-right time order as the timeline bands above it, so
        // scrolling this strip mirrors scrolling through the timeline. \u2500\u2500
        function renderGridView(ops, xEnd) {
            renderOperationStrip('gridA', ops, 'clusterA', 'aCur', 'A', xEnd);
            renderOperationStrip('gridB', ops, 'clusterB', 'bCur', 'B', xEnd);
        }

        function renderOperationStrip(containerId, ops, clusterKey, curKey, label, xEnd) {
            const container = document.getElementById(containerId);
            const items = ops.filter(o => o[clusterKey] && o[curKey] && o[curKey].length);

            if (!items.length) {
                container.innerHTML = `<div class="card-title"><span>Side ${label}</span></div>
                    <div style="font-size:12px; color:var(--text-muted);">No cluster data.</div>`;
                return;
            }

            // Group CONSECUTIVE ops with the same cluster into one band - this
            // mirrors the timeline above, where a run of same-cluster ops merges
            // visually into one continuous colored block. One band = one plot
            // (all its ops' signals overlaid together), not one plot per op.
            // Each band also remembers its own [startTime, endTime) on the
            // timeline (endTime = next band's start, or xEnd for the last one -
            // same rule renderSideTimeline uses for its rects) so hovering a
            // tile can highlight exactly that range up on the timeline.
            const bands = [];
            items.forEach((o, i) => {
                const code = o[clusterKey].cluster;
                const last = bands[bands.length - 1];
                if (last && last.code === code) { last.ops.push(o); last.endIdx = i; }
                else bands.push({ code, ops: [o], endIdx: i });
            });
            bands.forEach(band => {
                band.startTime = band.ops[0].time;
                const nextItem = items[band.endIdx + 1];
                band.endTime = nextItem ? nextItem.time : (xEnd || band.ops[band.ops.length - 1].time);
            });

            container.innerHTML = `<div class="card-title"><span>Side ${label} \u2014 signature per band</span>
                    <span style="text-transform:none; font-weight:500; color:var(--text-muted);">${bands.length} bands \u00b7 ${items.length} ops, time order</span></div>
                <div style="display:flex; overflow-x:auto; gap:10px; padding-bottom:8px;" id="${containerId}Strip"></div>`;

            const strip = document.getElementById(containerId + 'Strip');
            bands.forEach((band, idx) => {
                const color = colorFor(band.code);
                const cell = document.createElement('div');
                // Width scales with the band's op-count, so a wide grey band up on
                // the timeline (many consecutive ops) gets a proportionally wider
                // tile down here too, instead of every tile being the same size.
                const width = Math.min(140 + (band.ops.length - 1) * 18, 450);
                // min-width:0 overrides flexbox's default "never shrink below
                // content size" - without it, Chart.js's canvas (which defaults
                // to an intrinsic 300px) forces every tile to the same ~300px+
                // width regardless of flex-basis, silently ignoring it.
                // ADDITIVE: border color/thickness reflects this band's WORST self-supervised
                // severity (not just cluster quality) - cluster-color chip inside still shows
                // cluster identity, this is purely an extra signal, not a replacement.
                const sideLetter = label.toLowerCase();
                const SEV_RANK = { anomaly: 3, watch: 2, normal: 1, unknown: 0 };
                let worstSev = 'unknown';
                band.ops.forEach(o => {
                    const sev = o['novelty_severity_' + sideLetter];
                    if (sev && SEV_RANK[sev] > SEV_RANK[worstSev]) worstSev = sev;
                });
                const noveltyScores = band.ops.map(o => o['novelty_score_' + sideLetter]).filter(v => v != null);
                const borderColor = noveltyScores.length ? severityColor(worstSev) : 'var(--border)';
                const borderWidth = (worstSev === 'anomaly') ? 3 : (worstSev === 'watch') ? 2 : 1;
                cell.style.cssText = `flex:0 0 ${width}px; min-width:0; border:${borderWidth}px solid ${borderColor}; border-radius:10px; padding:8px; background:var(--bg-tertiary); cursor:pointer;`;
                const canvasId = containerId + '_band' + idx;
                const noveltyBadge = noveltyScores.length
                    ? `<span class="sev-pill pill-${worstSev}" style="float:right;" title="Self-supervised anomaly score (0-100, worst in this band)">Score ${Math.max(...noveltyScores)}</span>`
                    : '';
                cell.innerHTML = `<div style="margin-bottom:4px;">
                        <span class="chip" style="background:${color}22; border-color:${color}; font-size:10px; padding:2px 6px;">
                            <span class="dot" style="background:${color};"></span>${band.code}
                        </span>${noveltyBadge}
                    </div>
                    <div style="font-size:9px; color:var(--text-muted); margin-bottom:4px;">${band.ops[0].time.toLocaleString()} \u00b7 ${band.ops.length} op${band.ops.length > 1 ? 's' : ''}</div>
                    <div style="height:120px; width:100%; position:relative;"><canvas id="${canvasId}"></canvas></div>`;
                // Hover a tile -> outline that exact time-range on this side's
                // timeline above, so you can always see where this plot sits.
                cell.addEventListener('mouseenter', () => highlightTimelineRange(label, band.startTime, band.endTime));
                cell.addEventListener('mouseleave', () => clearTimelineHighlight(label));
                // Click the band tile -> plot ALL operations of this cluster code
                // (not just this one band's ops) - same view as clicking the
                // cluster chip in the summary box above.
                cell.addEventListener('click', () => showClusterOps(label, band.code));
                strip.appendChild(cell);
                drawStripChart(canvasId, band.ops.map(o => o[curKey]), color);
            });
        }

        function drawStripChart(canvasId, signals, color) {
            const key = 'strip_' + canvasId;
            if (S.charts[key]) { S.charts[key].destroy(); S.charts[key] = null; }
            const maxLen = Math.max(...signals.map(s => s.length));
            // Semi-transparent only matters when a band has 2+ ops overlaid -
            // a single-op band just draws one solid line.
            const lineColor = signals.length > 1 ? hexToRgba(color, 0.55) : color;
            const datasets = signals.map(s => ({
                data: s, borderColor: lineColor, borderWidth: signals.length > 1 ? 1.25 : 1.5,
                pointRadius: 0, tension: 0.15, fill: false,
            }));
            const ctx = document.getElementById(canvasId).getContext('2d');
            S.charts[key] = new Chart(ctx, {
                type: 'line',
                data: { labels: Array.from({ length: maxLen }, (_, i) => i * 20), datasets },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    elements: { line: { borderJoinStyle: 'round' } },
                    scales: {
                        x: { display: false },
                        // Fixed 0-10 range (not auto-scaled) so every strip cell is directly
                        // comparable \u2014 a rare outlier spike in one band shouldn't squash
                        // the visible shape of every other band's chart.
                        y: { min: 0, max: 10, grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { color: '#8b90ac', font: { size: 8 } } },
                    },
                },
            });
        }

        // Hovering a signature-strip tile outlines that exact [x0,x1) time
        // range on the SAME side's timeline above it (S.timelineShapes[side]
        // holds that timeline's base band-fill shapes - relayout adds one more
        // shape on top, outline-only, spanning the full plot height).
        function highlightTimelineRange(side, x0, x1) {
            const elId = side === 'A' ? 'timelineA' : 'timelineB';
            const el = document.getElementById(elId);
            if (!el || !el.data) return;
            const highlight = {
                type: 'rect', xref: 'x', yref: 'paper', x0, x1, y0: 0, y1: 1,
                fillcolor: 'rgba(0,0,0,0)', line: { color: '#1e2233', width: 3 }, layer: 'above',
            };
            Plotly.relayout(el, { shapes: [...(S.timelineShapes[side] || []), highlight] });
        }

        function clearTimelineHighlight(side) {
            const elId = side === 'A' ? 'timelineA' : 'timelineB';
            const el = document.getElementById(elId);
            if (!el || !el.data) return;
            Plotly.relayout(el, { shapes: S.timelineShapes[side] || [] });
        }

        function hexToRgba(hex, alpha) {
            const h = hex.replace('#', '');
            const r = parseInt(h.substring(0, 2), 16), g = parseInt(h.substring(2, 4), 16), b = parseInt(h.substring(4, 6), 16);
            return `rgba(${r},${g},${b},${alpha})`;
        }

        // \u2500\u2500 TIMELINE \u2014 continuous CLUSTER BAND, one per side (not scattered dots,
        // not the two sides combined into one plot) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        // Har operation apne cluster ka color us operation ke time se agle operation
        // ke time tak "fill" karta hai -> ek continuous colored band. Hover/click
        // ke liye upar invisible-blended markers (band ke same color) rakhte hain.
        // Side A and Side B each get their OWN small timeline, positioned directly
        // above that same side's signature-per-band strip (see renderOperationStrip)
        // so the pair reads as one paired group, not one merged combined chart.
        function renderTimelines(ops, xStart, xEnd) {
            renderSideTimeline(ops, 'clusterA', 'A', 'timelineA', xStart, xEnd);
            renderSideTimeline(ops, 'clusterB', 'B', 'timelineB', xStart, xEnd);
        }

        function renderSideTimeline(ops, key, label, elId, xStart, xEnd) {
            const grid = 'rgba(0,0,0,0.08)';
            const pts = ops.filter(o => o[key]);   // time-sorted already
            const shapes = pts.map((p, i) => ({
                type: 'rect', xref: 'x', yref: 'y', x0: p.time,
                x1: (i + 1 < pts.length) ? pts[i + 1].time : (xEnd || p.time),
                y0: 0.5, y1: 1.5, fillcolor: colorFor(p[key].cluster), line: { width: 0 }, layer: 'below',
            }));
            S.timelineShapes[label] = shapes;   // base shapes, reused by hover-highlight (see highlightTimelineRange)

            const sideLetter = label.toLowerCase();
            const x = [], y = [], colors = [], text = [];
            pts.forEach(o => {
                const c = o[key];
                x.push(o.time); y.push(1); colors.push(colorFor(c.cluster));
                const exp = expandCode(c.cluster);
                const top = (c.top3 || []).map(t => `${t.id} (${t.dist})`).join(', ') || '\u2014';
                // ADDITIVE: append the self-supervised score/severity to the existing hover text, if present
                const noveltyScore = o['novelty_score_' + sideLetter];
                const noveltyLine = noveltyScore != null
                    ? `<br>Anomaly score (self-supervised): ${noveltyScore} (${o['novelty_severity_' + sideLetter]})`
                    : '';
                text.push(`<b>${label} \u00b7 ${c.cluster}</b>${exp ? ' (' + exp + ')' : ''} \u00b7 ${o.time.toLocaleString()}`
                    + `<br>Distance: ${isFinite(c.distance) ? c.distance : '\u2014'}`
                    + `<br>Match: ${isFinite(c.match) ? c.match + '%' : '\u2014'}`
                    + `<br>Direction: ${o.direction || '\u2014'}`
                    + `<br>Top 3 close: ${top}`
                    + noveltyLine);
            });
            // Marker band ke same color (blend) \u2014 dikhte nahi, sirf hover/click ke liye.
            const data = [{
                x, y, text, mode: 'markers', type: 'scatter', name: label,
                marker: { color: colors, size: 12, opacity: 0.01 },
                hovertemplate: '%{text}<extra></extra>',
            }];
            const layout = {
                height: 90, margin: { l: 36, r: 20, t: 6, b: 26 },
                paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
                font: { color: '#565b76', size: 11 }, shapes,
                xaxis: { type: 'date', gridcolor: grid, range: xStart && xEnd ? [xStart, xEnd] : undefined },
                yaxis: { tickmode: 'array', tickvals: [1], ticktext: [label], range: [0.5, 1.5], gridcolor: grid, fixedrange: true },
                showlegend: false, hovermode: 'closest',
            };
            const el = document.getElementById(elId);
            Plotly.newPlot(el, data, layout, { responsive: true, displaylogo: false });
            el.removeAllListeners && el.removeAllListeners('plotly_click');
            el.on('plotly_click', (ev) => {
                const pt = ev.points && ev.points[0];
                if (!pt) return;
                const t = +new Date(pt.x);
                let best = null;
                pts.forEach(o => { const d = Math.abs(+o.time - t); if (!best || d < best.d) best = { o, d }; });
                if (best) showDetail(best.o, label);
            });
        }

        // \u2500\u2500 CLICK DETAIL: cluster info + current/voltage waveform \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        function drawChart(canvasId, key, data, yMax, color) {
            if (S.charts[key]) { S.charts[key].destroy(); S.charts[key] = null; }
            const ctx = document.getElementById(canvasId).getContext('2d');
            S.charts[key] = new Chart(ctx, {
                type: 'line',
                data: { labels: data.map((_, i) => i * 20), datasets: [{ data, borderColor: color, borderWidth: 2, pointRadius: 0, tension: 0.15, fill: true, backgroundColor: color + '22' }] },
                options: {
                    responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: '#8b90ac', font: { size: 8 }, maxTicksLimit: 10 }, title: { display: true, text: 'ms', color: '#8b90ac', font: { size: 9 } } },
                        y: { min: 0, max: yMax, grid: { color: 'rgba(0,0,0,0.06)' }, ticks: { color: '#8b90ac', font: { size: 8 } } }
                    }
                }
            });
        }

        // targetId (optional): where to render - defaults to the shared bottom
        // #detail panel (with its scroll-into-view, unchanged behavior for
        // cluster-tile/timeline clicks). Pass a different id (e.g. from the
        // trend chart) to render in-place instead, with no scrolling.
        // \u2500\u2500 ADDITIVE (Part A #5): nearest cluster via a real nearest-neighbor
        // search in this machine's OWN already-scored latent points (this page
        // has no invented named zones like the mock's TG28/IM16/IB10 - the
        // honest equivalent here is "which of this machine's own real,
        // already-labelled operations sits closest in latent space"). \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        function noveltyNearestCluster(op, sideLetter) {
            const x = op['novelty_x_' + sideLetter], y = op['novelty_y_' + sideLetter];
            if (x == null || y == null || !S.ops) return null;
            const clusterKey = sideLetter === 'a' ? 'clusterA' : 'clusterB';
            let best = null, bestD = Infinity;
            S.ops.forEach(o => {
                if (o === op) return;
                const ox = o['novelty_x_' + sideLetter], oy = o['novelty_y_' + sideLetter];
                if (ox == null || oy == null || !o[clusterKey]) return;
                const d = Math.hypot(ox - x, oy - y);
                if (d < bestD) { bestD = d; best = o[clusterKey].cluster; }
            });
            return best;
        }

        // Real drift signal: compares how far this machine's OWN points sit
        // from their OWN median position in the earlier half of the window
        // vs the later half - needs >=6 same-direction scored ops to say
        // anything; below that, returns null (shown as nothing - never faked).
        function noveltyDriftDirection(op, sideLetter) {
            if (!S.ops) return null;
            const sameDir = S.ops
                .filter(o => o.direction === op.direction && o['novelty_x_' + sideLetter] != null && o['novelty_y_' + sideLetter] != null)
                .sort((a, b) => a.time - b.time);
            if (sameDir.length < 6) return null;
            const med = arr => arr.slice().sort((a, b) => a - b)[Math.floor(arr.length / 2)];
            const mx = med(sameDir.map(o => o['novelty_x_' + sideLetter]));
            const my = med(sameDir.map(o => o['novelty_y_' + sideLetter]));
            const half = Math.floor(sameDir.length / 2);
            const avgDistFromMed = pts => pts.reduce((s, o) => s + Math.hypot(o['novelty_x_' + sideLetter] - mx, o['novelty_y_' + sideLetter] - my), 0) / pts.length;
            const delta = avgDistFromMed(sameDir.slice(-half)) - avgDistFromMed(sameDir.slice(0, half));
            if (Math.abs(delta) < 0.1) return 'stable \u2014 no meaningful drift from its own typical position this window';
            return delta > 0
                ? `drifting away from its own typical position this window (\u0394${delta.toFixed(2)})`
                : `drifting back toward its own typical position this window (\u0394${delta.toFixed(2)})`;
        }

        function noveltyExplainLine(op, sideLetter) {
            const ratio = op['novelty_ratio_' + sideLetter];
            if (ratio == null) return '';
            const parts = [`<b>${ratio.toFixed(1)}\u00d7</b> this machine's usual error`];
            const nearest = noveltyNearestCluster(op, sideLetter);
            if (nearest) parts.push(`nearest cluster <b>${nearest}</b> (by latent distance)`);
            const drift = noveltyDriftDirection(op, sideLetter);
            if (drift) parts.push(drift);
            const modelVer = op['novelty_model_version_' + sideLetter];
            const trainedAt = op['novelty_model_trained_at_' + sideLetter];
            if (modelVer) {
                const ageDays = trainedAt ? Math.floor((Date.now() - new Date(trainedAt + 'T00:00:00')) / 86400000) : null;
                const staleTxt = ageDays != null && ageDays > 90 ? ` <span class="model-stale-warn">\u26a0 model ${ageDays}d old</span>` : '';
                parts.push(`model <span class="mono">${modelVer}</span>${staleTxt}`);
            }
            return `<div class="explain-line">${parts.join(' \u00b7 ')}</div>`;
        }

        function showDetail(op, side, targetId) {
            targetId = targetId || 'detail';
            const c = side === 'A' ? op.clusterA : op.clusterB;
            const cur = side === 'A' ? op.aCur : op.bCur;
            const volt = side === 'A' ? op.aVolt : op.bVolt;
            const det = document.getElementById(targetId);
            det.style.display = 'block';
            const curCanvasId = targetId + 'Current', voltCanvasId = targetId + 'Voltage';

            const sideLetter = side.toLowerCase();
            const noveltyScore = op['novelty_score_' + sideLetter];
            const noveltyRow = noveltyScore != null
                ? `<div style="font-size:12px; color:var(--text-secondary); margin:2px 0 4px;">
                    Self-supervised anomaly score: <span class="sev-pill pill-${op['novelty_severity_' + sideLetter]}">${noveltyScore} \u00b7 ${op['novelty_severity_' + sideLetter]}</span>
                   </div>
                   ${noveltyExplainLine(op, sideLetter)}`
                : '';

            let clusterSection;
            if (c) {
                const top = (c.top3 || []).map(t => `<span class="chip"><span class="dot" style="background:${colorFor(t.id)};"></span>${t.id} <span style="opacity:0.7;">(${t.dist})</span></span>`).join(' ');
                clusterSection = `
                    <span class="chip" style="background:${colorFor(c.cluster)}22; border-color:${colorFor(c.cluster)};"><span class="dot" style="background:${colorFor(c.cluster)};"></span>${c.cluster}${expandCode(c.cluster) ? ' \u00b7 ' + expandCode(c.cluster) : ''}</span>
                    <div style="font-size:12px; color:var(--text-secondary); margin:6px 0 10px;">
                        Distance: <b>${isFinite(c.distance) ? c.distance : '\u2014'}</b> \u00b7 Match: <b>${isFinite(c.match) ? c.match + '%' : '\u2014'}</b> \u00b7 Direction: <b>${op.direction || '\u2014'}</b></div>
                    ${noveltyRow}
                    <div style="font-size:11px; color:var(--text-muted); text-transform:uppercase; font-weight:700; margin-bottom:6px;">Top 3 close clusters</div>
                    <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:14px;">${top || '\u2014'}</div>`;
            } else {
                // ADDITIVE: previously this branch showed text only, no waveform -
                // now it still draws the real current/voltage charts below, since
                // "no cluster data" doesn't mean "no operation data".
                clusterSection = `<div style="font-size:12px; color:var(--text-muted); margin:2px 0 10px;">No cluster data for this operation.</div>${noveltyRow}`;
            }

            const bodyId = targetId + 'Body';
            det.innerHTML = `
                <div class="card-title" style="display:flex; align-items:center; justify-content:space-between;">
                    <span>${side} \u00b7 ${op.time.toLocaleString()}</span>
                    <button onclick="toggleDetailCollapse('${targetId}')" id="${targetId}ToggleBtn"
                        title="Hide/expand plot" style="background:none; border:1px solid var(--border); border-radius:6px; cursor:pointer; width:26px; height:26px; font-size:13px; line-height:1; color:var(--text-secondary);">\u25b2</button>
                </div>
                <div id="${bodyId}">
                    ${clusterSection}
                    <div class="chart-box" style="height:220px; width:100%;"><canvas id="${curCanvasId}"></canvas></div>
                    <div class="chart-box" style="height:220px; width:100%; margin-top:12px;"><canvas id="${voltCanvasId}"></canvas></div>
                </div>`;
            drawChart(curCanvasId, curCanvasId, cur, 8, '#d97706');
            drawChart(voltCanvasId, voltCanvasId, volt, 150, '#0d9488');
            if (targetId === 'detail') det.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        // ADDITIVE: collapse/expand arrow for showDetail()'s plot card, top-right
        function toggleDetailCollapse(targetId) {
            const body = document.getElementById(targetId + 'Body');
            const btn = document.getElementById(targetId + 'ToggleBtn');
            if (!body || !btn) return;
            const collapsed = body.style.display === 'none';
            body.style.display = collapsed ? '' : 'none';
            btn.textContent = collapsed ? '\u25b2' : '\u25bc';
        }</script>
