@{
    ViewBag.Title = "Point Machine Clustering";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}

<meta charset="utf-8">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js" charset="utf-8"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
     #pmcApp <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
         #pmcApp {
            --bg-primary: #f3f4f9; --bg-secondary: #fff; --bg-tertiary: #eef0f9; --bg-card: #fff;
            --bg-hover: #eef0fb; --border: #e2e4f0; --border-hover: #c7cae4;
            --text-primary: #1e2233; --text-secondary: #565b76; --text-muted: #8b90ac;
            --accent: #4f46e5; --accent-hover: #4338ca; --accent-muted: rgba(79,70,229,0.1);
            --current-color: #d97706; --voltage-color: #0d9488;
        }
         #pmcApp { background: var(--bg-primary); color: var(--text-primary); font-family: 'Inter', system-ui, sans-serif; min-height: 100vh; }
         #pmcApp .topbar { height: 52px; background: var(--bg-secondary); border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 12px; padding: 0 18px; position: sticky; top: 0; z-index: 50; }
         #pmcApp .topbar .logo { width: 30px; height: 30px; border-radius: 8px; background: linear-gradient(135deg, var(--accent), #9333ea); color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; }
         #pmcApp .topbar .title { font-weight: 800; font-size: 15px; }
         #pmcApp .topbar .sub { font-size: 12px; color: var(--text-muted); }
         #pmcApp .layout { display: flex; height: calc(100vh - 52px); }
        /* ADDITIVE: collapsible/resizable drawer, same behavior as
           pm_operation_combined.html's sidebar (collapse to a 64px icon
           rail, drag-resize when expanded) - only the drawer mechanics are
           ported here, not that file's multi-model tab-switching. */
         #pmcApp .sidebar { width: 300px; min-width: 240px; max-width: 420px; background: var(--bg-secondary); border-right: 1px solid var(--border); overflow-y: auto; flex-shrink: 0; padding: 16px; transition: width 0.3s cubic-bezier(0.4,0,0.2,1), padding 0.3s ease; }
         #pmcApp .sidebar.collapsed { width: 64px !important; flex-basis: 64px !important; min-width: 64px !important; padding: 12px 6px !important; align-items: center; cursor: pointer; }
         #pmcApp .sidebar-full { min-width: 0; }
         #pmcApp .sidebar.collapsed .sidebar-full { display: none; }
         #pmcApp .sidebar-compact { display: none; }
         #pmcApp .sidebar.collapsed .sidebar-compact { display: flex; flex-direction: column; align-items: center; gap: 10px; cursor: pointer; width: 100%; }
         #pmcApp .compact-icon-btn { width: 38px; height: 38px; border-radius: 8px; background: var(--bg-tertiary); border: 1px solid var(--border); color: var(--text-secondary); display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
         #pmcApp .sidebar-compact:hover .compact-icon-btn { border-color: var(--accent); color: var(--accent); }
         #pmcApp .compact-pm-badge { font-size: 10px; font-weight: 800; letter-spacing: 0.2px; text-align: center; line-height: 1.1; padding: 2px; overflow: hidden; }
         #pmcApp .sidebar-toggle-btn { display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary); border-radius: 8px; cursor: pointer; transition: all 0.2s ease; flex: 0 0 auto; }
         #pmcApp .sidebar-toggle-btn:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
         #pmcApp .sidebar-toggle-btn.collapsed-active { background: var(--accent); color: #fff; border-color: var(--accent); }
         #pmcApp .pm-sidebar-resizer { flex: 0 0 5px; width: 5px; cursor: col-resize; background: transparent; }
         #pmcApp .pm-sidebar-resizer:hover, #pmcApp .pm-sidebar-resizer:active { background: rgba(79,70,229,0.35); }
         #pmcApp .content { flex: 1; overflow-y: auto; padding: 16px; min-width: 0; }
         #pmcApp .side-label { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin: 14px 0 8px; }
         #pmcApp .form-control { width: 100%; background: var(--bg-secondary); border: 1px solid var(--border); color: var(--text-primary); padding: 9px 12px; border-radius: 8px; font-size: 14px; outline: none; }
         #pmcApp .form-control:focus { border-color: var(--accent); }
         #pmcApp .btn { display: inline-flex; align-items: center; gap: 7px; border-radius: 8px; padding: 9px 14px; font-size: 14px; font-weight: 700; cursor: pointer; border: 1px solid var(--border); background: var(--bg-secondary); color: var(--text-primary); transition: 0.15s; }
         #pmcApp .btn:hover { background: var(--bg-hover); }
         #pmcApp .btn-primary { background: var(--accent); color: #fff; border: none; }
         #pmcApp .btn-primary:hover { background: var(--accent-hover); }
         #pmcApp .btn-primary:disabled { opacity: 0.6; cursor: default; }
         #pmcApp .btn.block { width: 100%; justify-content: center; margin-top: 10px; }
         #pmcApp .pm-list { margin-top: 4px; display: flex; flex-direction: column; gap: 8px; }
         #pmcApp .pm-item { border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; cursor: pointer; transition: 0.15s; }
         #pmcApp .pm-item:hover { background: var(--bg-hover); border-color: var(--border-hover); }
         #pmcApp .pm-item.active { border-color: var(--accent); background: var(--accent-muted); }
         #pmcApp .pm-name { font-weight: 700; font-size: 14px; }
         #pmcApp .pm-meta { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
         #pmcApp .empty-msg { color: var(--text-muted); font-size: 13px; padding: 10px 2px; }
         #pmcApp .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 16px; }
         #pmcApp .card-title { display: flex; align-items: center; justify-content: space-between; font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.4px; color: var(--text-secondary); margin-bottom: 12px; }
         #pmcApp .asset-title { font-size: 22px; font-weight: 800; color: var(--accent); }
         #pmcApp .asset-sub { font-size: 12px; color: var(--text-muted); }
         #pmcApp .breadcrumb { font-size: 12px; color: var(--text-muted); }
         #pmcApp .breadcrumb .current { color: var(--accent); font-weight: 700; }
         #pmcApp .row2 { display: flex; gap: 12px; align-items: flex-end; margin-bottom: 6px; }
         #pmcApp .spinner { display: inline-block; width: 16px; height: 16px; border: 2px solid var(--accent-muted); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; vertical-align: middle; }
        @@keyframes spin { to { transform: rotate(360deg); } }
         #pmcApp .empty-state { text-align: center; margin-top: 90px; color: var(--text-muted); }
         #pmcApp .empty-state h2 { font-size: 20px; color: var(--text-primary); margin-bottom: 8px; }
         #pmcApp .chip { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--border); border-radius: 16px; padding: 4px 12px; font-size: 12px; font-weight: 600; background: var(--bg-tertiary); }
         #pmcApp .dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
         #pmcApp .chart-box { position: relative; }
         #pmcApp .toast-box { position: fixed; bottom: 18px; right: 18px; display: flex; flex-direction: column; gap: 8px; z-index: 200; }
         #pmcApp .toast { background: var(--bg-card); border: 1px solid var(--border); border-left: 3px solid var(--accent); border-radius: 8px; padding: 10px 14px; font-size: 13px; box-shadow: 0 6px 20px rgba(0,0,0,0.12); }
         #pmcApp .toast.error { border-left-color: #ef4444; }
         #pmcApp .toast.success { border-left-color: #16a34a; }
        /*  ADDITIVE: self-supervised anomaly score styling only (nothing above this is changed)  */
         #pmcApp .sev-normal { color: #16a34a; }  #pmcApp .sev-watch { color: #ca8a04; }  #pmcApp .sev-anomaly { color: #dc2626; }  #pmcApp .sev-unknown { color: #94a3b8; }
         #pmcApp .sev-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; padding: 3px 10px; border-radius: 20px; }
         #pmcApp .pill-normal { background: #dcfce7; color: #16a34a; }  #pmcApp .pill-watch { background: #fef9c3; color: #ca8a04; }
         #pmcApp .pill-anomaly { background: #fee2e2; color: #dc2626; }  #pmcApp .pill-unknown { background: #f1f5f9; color: #94a3b8; }
        /* ADDITIVE: shape cue so severity is never color-only - applies to every
           existing .sev-pill usage on the page for free (badges, grid, detail). */
         #pmcApp .sev-pill::before { font-size: 9px; }
         #pmcApp .pill-normal::before { content: ""; }  #pmcApp .pill-watch::before { content: ""; }
         #pmcApp .pill-anomaly::before { content: ""; }  #pmcApp .pill-unknown::before { content: ""; }
         #pmcApp .handoff-row { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-top: 10px; font-size: 11.5px; }
         #pmcApp .handoff-chip { padding: 3px 9px; border-radius: 7px; background: var(--bg-tertiary); border: 1px solid var(--border); color: var(--text-secondary); white-space: nowrap; }
         #pmcApp .handoff-chip.active { border-color: var(--accent); color: var(--accent); background: var(--accent-muted); }
         #pmcApp .handoff-arrow { color: var(--text-muted); }
         #pmcApp .model-meta-row { font-size: 11px; color: var(--text-muted); margin-top: 8px; line-height: 1.6; }
         #pmcApp .model-stale-warn { display: inline-block; margin-top: 4px; padding: 2px 8px; border-radius: 7px; background: #fef9c3; color: #92400e; border: 1px solid #fde68a; font-size: 11px; font-weight: 600; }
         #pmcApp .explain-line { font-size: 11.5px; color: var(--text-secondary); background: var(--bg-tertiary); border: 1px dashed var(--border); border-radius: 7px; padding: 6px 9px; margin: 6px 0 10px; line-height: 1.5; }
         #pmcApp .novelty-stat-row { display: flex; gap: 10px; flex-wrap: wrap; margin: 8px 0; }
         #pmcApp .novelty-stat { flex: 1; min-width: 100px; background: var(--bg-tertiary); border-radius: 8px; padding: 8px; text-align: center; }
         #pmcApp .novelty-stat .v { font-size: 16px; font-weight: 800; }
         #pmcApp .novelty-stat .l { font-size: 9.5px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-top: 2px; }

        /*  ADDITIVE: Health Map (same-page, "same to same" layout as Task 3's
           reference self-supervised-anomaly-monitor.html, re-themed light to
           match the rest of this page) - scoped under .nm- so its palette
           never conflicts with the rest of this page's own CSS vars. Wired to
           this machine's own already-loaded S.ops, not a separate fetch.  */
         #pmcApp .nm-wrap { --nm-bg:var(--bg-primary); --nm-panel:var(--bg-card); --nm-line:var(--border); --nm-line2:var(--border);
            --nm-ink:var(--text-primary); --nm-muted:var(--text-secondary); --nm-faint:var(--text-muted);
            --nm-green:#16a34a; --nm-amber:#ca8a04; --nm-red:#dc2626; --nm-cyan:#4f46e5;
            background:var(--nm-bg); color:var(--nm-ink); border:1px solid var(--nm-line); border-radius:14px; padding:18px; margin-bottom:14px;
            font-family:'IBM Plex Sans',var(--font-sans,sans-serif); }
         #pmcApp .nm-wrap .mono { font-family:'IBM Plex Mono',monospace; }
         #pmcApp .nm-head { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-bottom:14px; }
         #pmcApp .nm-head h3 { margin:0; font-size:15px; font-weight:700; }
         #pmcApp .nm-watching { display:flex; align-items:center; gap:8px; color:var(--nm-muted); font-size:12.5px; }
         #pmcApp .nm-pulse { width:9px; height:9px; border-radius:50%; background:var(--nm-cyan); animation:nmPulse 2.4s ease-in-out infinite; }
        @@keyframes nmPulse{ 0%,100%{opacity:.35; transform:scale(.85)} 50%{opacity:1; transform:scale(1.15)} }
        @@media (prefers-reduced-motion:reduce){  #pmcApp .nm-pulse { animation:none; } }
         #pmcApp .nm-side-toggle { display:flex; gap:6px; }
         #pmcApp .nm-side-toggle button { background:var(--bg-tertiary); color:var(--nm-muted); border:1px solid var(--nm-line); border-radius:7px;
            padding:5px 11px; font-size:12px; font-weight:700; cursor:pointer; font-family:inherit; }
         #pmcApp .nm-side-toggle button.active { background:var(--nm-cyan); color:#fff; border-color:var(--nm-cyan); }
         #pmcApp .nm-grid { display:grid; gap:14px; grid-template-columns:1.35fr 1fr; grid-template-areas:"map score" "map time" "controls feed" "note note"; }
        @@media (max-width:860px){  #pmcApp .nm-grid { grid-template-columns:1fr; grid-template-areas:"map" "score" "time" "controls" "feed" "note"; } }
         #pmcApp .nm-map { grid-area:map }  #pmcApp .nm-score { grid-area:score }  #pmcApp .nm-time { grid-area:time }  #pmcApp .nm-controls { grid-area:controls }  #pmcApp .nm-feed { grid-area:feed }  #pmcApp .nm-note { grid-area:note }
         #pmcApp .nm-note { background:var(--bg-tertiary); }
         #pmcApp .nm-note .nm-row { display:flex; gap:12px; align-items:flex-start; font-size:13.5px; line-height:1.55; color:var(--nm-ink); }
         #pmcApp .nm-chip { font-size:11.5px; padding:4px 9px; border-radius:8px; background:var(--bg-card); border:1px solid var(--nm-line); white-space:nowrap; color:var(--nm-muted); }
         #pmcApp .nm-chip.cyan { border-color:#4f46e555; color:var(--nm-cyan); }
         #pmcApp .nm-handoff { margin-top:12px; display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
         #pmcApp .nm-arrow { color:var(--nm-faint); }
         #pmcApp .nm-panel { background:var(--nm-panel); border:1px solid var(--nm-line); border-radius:12px; padding:14px; display:flex; flex-direction:column; }
         #pmcApp .nm-panel > h4 { font-size:12px; font-weight:700; color:var(--nm-muted); margin:0 0 10px; text-transform:none; letter-spacing:0; }
         #pmcApp .nm-map { background:var(--bg-tertiary); }
         #pmcApp .nm-legend { display:flex; gap:12px; flex-wrap:wrap; font-size:11.5px; color:var(--nm-muted); margin-top:6px; }
         #pmcApp .nm-legend span { display:flex; align-items:center; gap:5px; }
         #pmcApp .nm-sw { width:10px; height:10px; border-radius:50%; }
         #pmcApp .nm-src { font-size:10.5px; color:var(--nm-faint); margin-top:auto; padding-top:10px; }
         #pmcApp .nm-gwrap { display:flex; align-items:center; gap:14px; }
         #pmcApp .nm-gnum b { font-size:34px; font-weight:600; line-height:1; }
         #pmcApp .nm-verdict { display:inline-block; padding:3px 10px; border-radius:999px; font-size:12px; font-weight:600; margin-top:6px; }
         #pmcApp .nm-v-ok { background:#16a34a1a; color:var(--nm-green); border:1px solid #16a34a44; }
         #pmcApp .nm-v-watch { background:#ca8a041a; color:var(--nm-amber); border:1px solid #ca8a0444; }
         #pmcApp .nm-v-anom { background:#dc26261a; color:var(--nm-red); border:1px solid #dc262655; }
         #pmcApp .nm-v-none { background:#8b90ac1a; color:var(--nm-faint); border:1px solid #8b90ac44; }
         #pmcApp .nm-scorehint { font-size:12px; color:var(--nm-muted); margin-top:10px; line-height:1.5; }
         #pmcApp .nm-ctrl label { display:flex; justify-content:space-between; font-size:12.5px; margin-bottom:6px; }
         #pmcApp .nm-ctrl label b { font-family:'IBM Plex Mono',monospace; color:var(--nm-cyan); }
         #pmcApp .nm-wrap input[type=range] { width:100%; accent-color:var(--nm-cyan); height:20px; }
         #pmcApp .nm-tradeoff { display:flex; justify-content:space-between; font-size:11.5px; margin-top:5px; }
         #pmcApp .nm-reset { align-self:flex-start; margin-top:8px; background:var(--bg-tertiary); color:var(--nm-muted); border:1px solid var(--nm-line);
            border-radius:7px; padding:5px 11px; font-family:inherit; font-size:12px; cursor:pointer; }
         #pmcApp .nm-reset:hover { color:var(--nm-ink); border-color:var(--nm-cyan); }
         #pmcApp .nm-feedlist { display:flex; flex-direction:column; gap:1px; max-height:220px; overflow-y:auto; }
         #pmcApp .nm-op { display:grid; grid-template-columns:14px auto 1fr 40px; align-items:center; gap:8px; padding:6px 2px;
            border-top:1px solid var(--nm-line2); font-size:12px; cursor:pointer; border-radius:5px; }
         #pmcApp .nm-op:hover { background:var(--bg-hover); }  #pmcApp .nm-op.focused { background:#4f46e51a; }  #pmcApp .nm-op:first-child { border-top:none; }
         #pmcApp .nm-op .glyph { font-size:11px; text-align:center; }
         #pmcApp .nm-op .id { font-family:'IBM Plex Mono',monospace; color:var(--nm-muted); white-space:nowrap; }
         #pmcApp .nm-bar { height:7px; border-radius:5px; background:var(--bg-tertiary); overflow:hidden; }
         #pmcApp .nm-bar i { display:block; height:100%; border-radius:5px; }
         #pmcApp .nm-op .s { font-family:'IBM Plex Mono',monospace; text-align:right; }
</style>
<style>
    /* FRS Advance: 617's aurora-bridge.css forces day/night colours on labels, form controls and
       .card with !important. This page's internals are light-only, so keep its own palette inside
       #pmcApp (the id selector out-ranks the bridge rules). */
    body #pmcApp label { color: var(--text-primary) !important; }
    body #pmcApp select, body #pmcApp textarea, body #pmcApp .form-control,
    body #pmcApp input:not([type=checkbox]):not([type=radio]):not([type=range]):not([type=color]):not([type=file]):not([type=button]):not([type=submit]) {
        background-color: var(--bg-secondary) !important; color: var(--text-primary) !important; border-color: var(--border) !important;
    }
    body #pmcApp select option { background: var(--bg-secondary) !important; color: var(--text-primary) !important; }
    body #pmcApp .card { background: var(--bg-card) !important; color: var(--text-primary) !important; border-color: var(--border) !important; -webkit-backdrop-filter: none; backdrop-filter: none; }
    body #pmcApp .card-header, body #pmcApp .card-body { color: inherit !important; }
</style>

@* FRS Advance page header (617 theme): breadcrumb card like EquipmentRoom/Index. *@
<section class="section e7-page-head">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="row">
                        <div class="col-12 col-sm-5">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">AI/ML Analysis</li>
                                    <li class="breadcrumb-item active" aria-current="page"><a href="#">Point Machine Clustering</a></li>
                                </ol>
                            </nav>
                        </div>
                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                            <h2 class="page-name">Point Machine Clustering</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="pmcApp">
    <div class="topbar">
        <button class="sidebar-toggle-btn" id="sidebarToggleBtn" onclick="toggleSidebar()" title="Collapse Sidebar">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
        </button>
        <div class="logo">PC</div>
        <div>
            <div class="title">Point Machine &#8212; Cluster View</div>
            <div class="sub">Operation clustering (from historian) + self-supervised anomaly score (new, additive)</div>
        </div>
    </div>

    <div class="layout">
        <div class="sidebar" id="sidebarEl">
            <!-- ADDITIVE: collapsed-rail mini view - click anywhere in it to expand -->
            <div class="sidebar-compact" title="Click to expand" onclick="toggleSidebar(false)">
                <div class="compact-icon-btn" title="Analysis window">
                    <svg id="compactModeQuick" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                    <svg id="compactModeCustom" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line><path d="M8 14h4v4H8z"></path></svg>
                </div>
                <div class="compact-icon-btn compact-pm-badge" id="compactPmBadge" title="No point machine selected">&#8211;</div>
            </div>
            <div class="sidebar-full">
                <div class="side-label">Site</div>
                <select class="form-control" id="siteSelect" onchange="onSiteSelectChange()"><option value="">Loading sites&#8230;</option></select>
                <!-- ADDITIVE: auto-fetches on site select now (onSiteSelectChange below) -
                     button kept (hidden) only so fetchPointMachines()'s disable-while-loading
                     logic still has an element to target. -->
                <button class="btn btn-primary block" id="fetchPmBtn" onclick="fetchPointMachines()" style="display:none;">Fetch Point Machines</button>

                <!-- ADDITIVE: Quick (last 30 days) vs Custom Dates - same idea/placement
                     as pm_operation_combined.html's sidebar mode tabs. -->
                <div style="display:flex; gap:4px; background:var(--bg-primary); border:1px solid var(--border); border-radius:10px; padding:3px; margin-top:14px;">
                    <button type="button" id="modeQuickBtn" onclick="switchClusterMode('quick')"
