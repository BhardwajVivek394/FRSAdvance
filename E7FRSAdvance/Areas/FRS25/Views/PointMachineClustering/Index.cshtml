                    </div>
                    <label class="side-label" style="margin:0 0 4px;">Point Machine</label>
                    <select class="form-control" id="customPmSelect" style="margin-bottom:8px;">
                        <option value="">-- Select --</option>
                    </select>
                    <!-- ADDITIVE fix: native date/time inputs have a platform min-width
                         that doesn't shrink below ~150px, so a 2-column grid inside this
                         ~270px-wide panel overflowed the sidebar. Stacked single-column
                         instead - still fits comfortably at any sidebar width. -->
                    <div style="display:flex; flex-direction:column; gap:8px; min-width:0;">
                        <div style="min-width:0;">
                            <div class="side-label" style="margin:0 0 4px;">From date</div>
                            <input class="form-control" id="customFromDate" type="date" style="width:100%; min-width:0;" onchange="validateCustomDateRange()">
                            <div class="side-label" style="margin:6px 0 4px;">From time</div>
                            <input class="form-control" id="customFromTime" type="time" step="1" value="00:00:00" style="width:100%; min-width:0;" onchange="validateCustomDateRange()">
                        </div>
                        <div style="min-width:0;">
                            <div class="side-label" style="margin:0 0 4px;">To date</div>
                            <input class="form-control" id="customToDate" type="date" style="width:100%; min-width:0;" onchange="validateCustomDateRange()">
                            <div class="side-label" style="margin:6px 0 4px;">To time</div>
                            <input class="form-control" id="customToTime" type="time" step="1" value="23:59:59" style="width:100%; min-width:0;" onchange="validateCustomDateRange()">
                        </div>
                    </div>
                    <div id="customDateError" style="display:none; font-size:11px; font-weight:600; color:#dc2626; background:rgba(220,38,38,0.08); border:1px solid rgba(220,38,38,0.25); padding:6px 8px; border-radius:6px; margin-top:8px;"></div>
                    <button class="btn btn-primary block" id="applyCustomDatesBtn" style="margin-top:8px;" onclick="applyCustomDates()" disabled title="Runs clusters + self-supervised scoring for this exact range">Analyze This Range</button>
                </div>
            </div>
        </div>
        <div class="pm-sidebar-resizer" id="sidebarResizer" title="Drag to resize sidebar"></div>

        <div class="content">
            <div class="empty-state" id="emptyState">
                <h2>Select a point machine</h2>
                <p>Choose a site &#8594; Fetch Point Machines &#8594; click any machine. The last-30-days clustering timeline loads automatically.</p>
            </div>

            <div id="mainView" style="display:none; flex-direction:column; gap:14px;">
                <div style="display:flex; align-items:center; justify-content:space-between;">
                    <div>
                        <div class="breadcrumb">Point Machines / <span class="current" id="assetBreadcrumb">--</span></div>
                        <div class="asset-title" id="assetTitle">--</div>
                        <div class="asset-sub" id="assetSub">--</div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title">
                        <span>Monthly Cluster Timeline</span>
                        <span id="clusterSub" style="text-transform:none; font-weight:500; color:var(--text-muted);">Last 30 days</span>
                    </div>
                    <!-- ADDITIVE: quick (last-30-days) controls - shown only in quick mode
                         (see the sidebar's Quick/Custom tabs); custom-range analysis is
                         triggered from the sidebar's custom-date-panel instead. -->
                    <div class="row2" id="quickModeRow">
                        <div style="flex:1;">
                            <div class="side-label" style="margin:0 0 6px;">Window ending</div>
                            <input class="form-control" id="refTime" type="datetime-local">
                        </div>
                        <button class="btn btn-primary" id="updateResultsBtn" onclick="analyzeClusters(true)" title="Always re-fetches and re-analyzes right now, ignoring any cache">Fetch &amp; Compute</button>
                    </div>

                    <div id="loading" style="display:none; text-align:center; padding:40px 20px;">
                        <span class="spinner" style="width:28px;height:28px;"></span>
                        <div id="loadingText" style="margin-top:12px; color:var(--text-secondary); font-weight:600;">Loading&#8230;</div>
                    </div>

                    <div id="results" style="display:none;">
                        <div style="display:flex; justify-content:flex-end; gap:8px; margin-bottom:10px;">
                            <button class="btn" id="clusterExportJsonBtn" onclick="exportClusterJson()" title="Download this machine's cluster distribution as JSON">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                Export JSON
                            </button>
                            <button class="btn" id="clusterExportPdfBtn" onclick="exportClusterPdf(this)" title="Download a full PDF report with the cluster timeline chart">
                                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                                Export PDF
                            </button>
                        </div>
                        <div id="aiSummary" style="display:none; background:linear-gradient(135deg, var(--accent-muted), rgba(147,51,234,0.08)); border:1px solid var(--accent); border-radius:12px; padding:14px 16px; margin-bottom:14px;">
                            <div style="display:flex; align-items:center; gap:8px; font-size:12px; font-weight:800; text-transform:uppercase; letter-spacing:0.4px; color:var(--accent); margin-bottom:6px;">
                                <span>AI Summary</span>
                            </div>
                            <div id="aiSummaryText" style="font-size:13.5px; line-height:1.6; color:var(--text-primary);">Generating&#8230;</div>
                        </div>

                        <!-- ADDITIVE: self-supervised alert banner - most-visible signal, shown first, above everything else -->
                        <div id="noveltyAlert" style="display:none;"></div>

                        <div id="summary"></div>

                        <!-- ADDITIVE: self-supervised anomaly score card, alongside (not replacing) the cluster summary above -->
                        <div id="noveltySummary" style="display:none;"></div>

                        <!-- ADDITIVE: self-supervised score trend, one line chart per side -->

                        <!-- ADDITIVE: Health Map - "same to same" layout as Task 3's reference
                             dashboard (New task/Task 3 .../self-supervised-anomaly-monitor.html),
                             embedded directly on this page (not a separate route), wired to this
                             machine's own already-loaded ops and real VAE latent coordinates. -->
                        <div id="healthMapSection" class="nm-wrap" style="display:none;"></div>

                        <!-- Each side's own color-band timeline sits directly above that
                             SAME side's signature-per-band strip, so the two stay paired -
                             Side A's timeline+strip as one group, then Side B's below it. -->
                        <div id="timelineView">
                            <div style="font-size:11px; color:var(--text-muted); margin-bottom:4px;">
                                Continuous band per side &#8212; each colored segment = one operation's cluster, held until the next operation. Hover for cluster details; click a segment to view its current/voltage waveform.
                            </div>

                            <div id="timelineA" style="width:100%; min-height:90px;"></div>
                            <!-- ADDITIVE: severity (self-supervised) band, directly under the cluster band above -->
                            <div id="noveltyTimelineA" style="width:100%; min-height:50px;"></div>
                            <div id="gridA" style="margin-top:6px;"></div>
                            <!-- ADDITIVE: click a cluster chip/band above -> that cluster's operations plot right here, in place -->
                            <div id="clusterOpsDetailA" class="card" style="display:none; margin:10px 0 22px;"></div>

                            <div id="timelineB" style="width:100%; min-height:90px;"></div>
                            <div id="noveltyTimelineB" style="width:100%; min-height:50px;"></div>
                            <div id="gridB" style="margin-top:6px;"></div>
                            <div id="clusterOpsDetailB" class="card" style="display:none; margin-top:10px;"></div>
                        </div>

                        <details style="margin-top:8px; font-size:12px;">
                            <summary style="cursor:pointer; color:var(--text-secondary); font-weight:700;">Cluster code &#8212; what it means</summary>
                            <div style="margin-top:8px; color:var(--text-secondary); line-height:1.7;">
                                <b>1st letter</b> &#8212; <b>T</b> = TWS, <b>I</b> = IRS &nbsp;&#183;&nbsp;
                                <b>2nd letter</b> &#8212; <b>G</b> = Good, <b>B</b> = Bad, <b>M</b> = Medium &nbsp;&#183;&nbsp;
                                <b>trailing number</b> = cluster number.<br>
                                <code>I0</code> / <code>T0</code> is a special reserved code, not "no letter" &#8212; it means <b>Obstruction</b>
                                (a mechanical blockage/jam during the throw), one of the known point-machine fault types.<br>
                                Example: <code>IB17</code> = IRS &#183; Bad &#183; #17 &nbsp;|&nbsp; <code>TG3</code> = TWS &#183; Good &#183; #3 &nbsp;|&nbsp; <code>T0</code> = TWS &#183; Obstruction.
                                (Any leading <code>NORMAL/ABNORMAL</code> label in the raw data is stripped &#8212; only the cluster code is shown.)<br>
                                <b>Colors</b> follow this same quality letter &#8212; every <b>Good</b> cluster is a shade of green, every <b>Medium</b> a shade of amber, every <b>Bad</b> a shade of red (each cluster number gets its own shade within that family).
                            </div>
                        </details>
                        <!-- ADDITIVE: explains the new self-supervised score alongside the existing cluster-code legend above -->
                        <details style="margin-top:8px; font-size:12px;">
                            <summary style="cursor:pointer; color:var(--text-secondary); font-weight:700;">Self-supervised anomaly score &#8212; what it means (new)</summary>
                            <div style="margin-top:8px; color:var(--text-secondary); line-height:1.7;">
                                A separate, additive signal from an autoencoder trained ONLY on this machine's own normal-looking
                                current shapes (no fault labels, no cluster names) &#8212; a 0-100 score per operation, based on how
                                hard that operation's shape is to reconstruct vs. this machine's own recent history.
                                <span class="sev-pill pill-normal">normal</span> &lt; 35 &#183;
                                <span class="sev-pill pill-watch">watch</span> 35-70 &#183;
                                <span class="sev-pill pill-anomaly">anomaly</span> &gt; 70 &#183;
                                <span class="sev-pill pill-unknown">unscored</span> not enough history yet for this machine/direction.
                                This score only detects deviation &#8212; it does not diagnose a fault type (that's what the cluster code above is for).
                            </div>
                        </details>
                        <div id="detail" style="display:none; margin-top:14px;"></div>

                        <!-- ADDITIVE: always-visible "how to read this" band at the very
                             end of the page - a plain-language walkthrough for a first-time
                             or non-technical viewer, not another collapsed <details>. -->
                        <div class="card" style="margin-top:18px; border-left:4px solid var(--accent); background:linear-gradient(135deg, var(--accent-muted), var(--bg-card));">
                            <div class="card-title" style="text-transform:none; font-size:15px; color:var(--text-primary);">
                                <span>&#128214; How to Read This Report</span>
                            </div>
                            <div style="display:flex; flex-direction:column; gap:12px; font-size:13px; line-height:1.65; color:var(--text-secondary);">
                                <div>
                                    <b style="color:var(--text-primary);">1. Start with the alert banner at the top.</b>
                                    It tells you in plain words whether this machine needs a look, and links straight to the
                                    worst cluster - that is the fastest path to "is something wrong?".
                                </div>
                                <div>
                                    <b style="color:var(--text-primary);">2. The colored band under each machine's title is a timeline.</b>
                                    Each colored segment is one operation's cluster, held until the next operation - hover any
                                    segment for details, click it to plot that operation's current/voltage waveform below.
                                    <span class="chip" style="margin-left:4px;"><span class="dot" style="background:#16a34a;"></span>Green = Good</span>
                                    <span class="chip"><span class="dot" style="background:#ca8a04;"></span>Amber = Medium</span>
                                    <span class="chip"><span class="dot" style="background:#dc2626;"></span>Red = Bad / Obstruction</span>
                                </div>
                                <div>
                                    <b style="color:var(--text-primary);">3. The cluster chips (e.g. "TG3", "T0") group similar-shaped operations.</b>
                                    Letter 1 = wave type (T/I), letter 2 = quality (G=Good, B=Bad, M=Medium), the number just
                                    tells clusters of the same quality apart. <code>T0</code>/<code>I0</code> is a special code
                                    meaning <b>Obstruction</b>. Click any chip to see every operation in that cluster.
                                </div>
                                <div>
                                    <b style="color:var(--text-primary);">4. The self-supervised score (0-100) is a second, independent opinion.</b>
                                    It does not know about clusters or fault names - it just learns what "normal" looks like for
                                    this exact machine, then flags operations whose shape looks unusual compared to that machine's
                                    own history. You will see it marked three ways, not just by color, so it is still clear on a
                                    printout or for anyone who has trouble telling colors apart:
                                    <span class="sev-pill pill-normal" style="margin-left:4px;">normal</span> = looks like usual behavior &#183;
                                    <span class="sev-pill pill-watch">watch</span> = mildly unusual, worth keeping an eye on &#183;
                                    <span class="sev-pill pill-anomaly">anomaly</span> = clearly different from this machine's history.
                                    <b>Anomaly means different, not broken</b> - a re-adjusted machine or a weather change can score
                                    high too, so always confirm before acting; nothing on this page takes any action by itself.
                                    Each score also shows which model version produced it and how old its training/baseline is -
                                    an amber warning there means that particular score deserves extra scrutiny, not automatic trust.
                                </div>
                                <div>
                                    <b style="color:var(--text-primary);">5. A flagged score is never the end of the story - it is routed onward.</b>
                                    Think of it as a 4-step relay, shown near the score and again in the Health Map below:
                                    <span class="chip" style="margin-left:4px;">detect (this score)</span><span style="color:var(--text-muted);">&#8594;</span>
                                    <span class="chip">name (CNN classifier)</span><span style="color:var(--text-muted);">&#8594;</span>
                                    <span class="chip">confirm (RDSO rules)</span><span style="color:var(--text-muted);">&#8594;</span>
                                    <span class="chip">human review</span>.
                                    This page only ever does step 1 - it spots that something looks different and raises a hand;
                                    naming the exact fault and deciding what to do about it always stays a separate, human-checked step.
                                </div>
                                <div>
                                    <b style="color:var(--text-primary);">6. The "Health Map" panel is the same score, drawn as a picture instead of a number.</b>
                                    Each dot is one real operation; dots that cluster tightly together are this machine's learned
                                    "normal" - the further a dot sits from that cluster, the higher its score. The small gauge next
                                    to it shows the score for whichever dot you last clicked ("focused"), the line chart shows the
                                    last several operations' scores over time (a rising line is an early warning, before anything
                                    crosses into "anomaly"), and the list below that is the same operations as a simple feed you can
                                    click through. The <b>sensitivity slider</b> only changes how strict the grading is when looking
                                    back at this same real data - it never changes the data itself or re-runs anything live.
                                </div>
                                <div>
                                    <b style="color:var(--text-primary);">7. Click anything to dig deeper.</b>
                                    A band segment, a cluster chip, a dot on the Health Map, or a point on the score trend chart all
                                    open that exact operation's current/voltage waveform right below where you clicked - no need to
                                    scroll away. Once opened, you will also see a short "why" line explaining that one operation's
                                    score: how many times worse than usual its error was, the nearest already-labelled cluster to it,
                                    and (once there is enough history for this machine) whether it has been drifting.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="empty2" style="color:var(--text-muted); font-size:13px; padding:8px 0;">
                        Click "Analyze Last 30 Days".
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="toast-box" id="toastBox"></div>
</div>
<script>
    var PMC_ENDPOINTS = {
        sites: '@Url.Action("GetSites", "PointMachineClustering", new { area = "FRS25" })',
        liveValue: '@Url.Action("GetLiveValue", "PointMachineClustering", new { area = "FRS25" })',
        clusterCache: '@Url.Action("GetClusterCache", "PointMachineClustering", new { area = "FRS25" })',
        clusterCachePost: '@Url.Action("PostClusterCache", "PointMachineClustering", new { area = "FRS25" })',
        clusterSummary: '@Url.Action("PostClusterSummary", "PointMachineClustering", new { area = "FRS25" })',
        refreshLive: '@Url.Action("PostRefreshLive", "PointMachineClustering", new { area = "FRS25" })',
        refreshCustomRange: '@Url.Action("PostRefreshCustomRange", "PointMachineClustering", new { area = "FRS25" })'
    };
</script>
<script>
        const S = { sites: [], pointMachines: [], selectedAsset: null, currentSiteId: null, ops: [], colorMap: {}, shadeIndex: {}, charts: {}, timelineShapes: { A: [], B: [] }, trendFilter: { a: null, b: null } };

        // \u2500\u2500 ADDITIVE: collapsible/resizable sidebar drawer, ported from
        // pm_operation_combined.html's sidebar (same collapse-to-64px-rail +
        // drag-resize behavior, just for this page's single sidebar instead
        // of that file's 4 model tabs). \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        const SIDEBAR_WIDTH_KEY = 'pmcluster-sidebar-width';
        function getSavedSidebarWidth() {
            const saved = parseInt(localStorage.getItem(SIDEBAR_WIDTH_KEY), 10);
            return (saved >= 180 && saved <= 420) ? saved : 300;
        }
        function applySidebarWidth(px) {
            const sidebar = document.getElementById('sidebarEl');
            if (!sidebar) return;
            sidebar.style.flexBasis = px + 'px';
            sidebar.style.width = px + 'px';
        }
        function toggleSidebar(forceCollapsed) {
            const sidebar = document.getElementById('sidebarEl');
            const toggleBtn = document.getElementById('sidebarToggleBtn');
            if (!sidebar) return;
            const isCollapsed = typeof forceCollapsed === 'boolean'
                ? (sidebar.classList.toggle('collapsed', forceCollapsed), forceCollapsed)
                : sidebar.classList.toggle('collapsed');
            if (toggleBtn) {
                toggleBtn.title = isCollapsed ? 'Expand Sidebar' : 'Collapse Sidebar';
                toggleBtn.classList.toggle('collapsed-active', isCollapsed);
            }
            applySidebarWidth(isCollapsed ? 64 : getSavedSidebarWidth());
            setTimeout(() => window.dispatchEvent(new Event('resize')), 300);
        }
        function updateCompactSidebar() {
            const badge = document.getElementById('compactPmBadge');
            if (badge) {
                const pm = S.selectedAsset;
                badge.textContent = pm ? (pm.assetName || '').replace(/[^A-Za-z0-9]/g, '').slice(0, 2).toUpperCase() || '?' : '\u2013';
                badge.title = pm ? pm.assetName : 'No point machine selected';
            }
            const quickIcon = document.getElementById('compactModeQuick');
            const customIcon = document.getElementById('compactModeCustom');
            if (quickIcon && customIcon) {
                const isCustom = S.clusterMode === 'custom';
                quickIcon.style.display = isCustom ? 'none' : 'block';
                customIcon.style.display = isCustom ? 'block' : 'none';
            }
        }
        (function setupSidebarResizer() {
            const sidebar = document.getElementById('sidebarEl');
            const handle = document.getElementById('sidebarResizer');
            if (!sidebar || !handle) return;
            applySidebarWidth(getSavedSidebarWidth());
            let dragging = false, startX = 0, startWidth = 0;
            const clientX = e => (e.touches ? e.touches[0].clientX : e.clientX);
            const onDown = e => {
                if (sidebar.classList.contains('collapsed')) return;
                dragging = true;
                startX = clientX(e);
                startWidth = sidebar.getBoundingClientRect().width;
                document.body.style.cursor = 'col-resize';
                document.body.style.userSelect = 'none';
                e.preventDefault();
            };
            const onMove = e => {
                if (!dragging) return;
                const next = Math.max(180, Math.min(420, startWidth + (clientX(e) - startX)));
                applySidebarWidth(next);
            };
            const onUp = () => {
                if (!dragging) return;
                dragging = false;
                document.body.style.cursor = '';
                document.body.style.userSelect = '';
                localStorage.setItem(SIDEBAR_WIDTH_KEY, Math.round(sidebar.getBoundingClientRect().width));
                window.dispatchEvent(new Event('resize'));
            };
            handle.addEventListener('mousedown', onDown);
            handle.addEventListener('touchstart', onDown, { passive: false });
            window.addEventListener('mousemove', onMove);
            window.addEventListener('touchmove', onMove, { passive: false });
            window.addEventListener('mouseup', onUp);
            window.addEventListener('touchend', onUp);
        })();
        // Collapsed rail -> click anywhere in it expands; expanded -> clicking
        // blank sidebar space (not a real control) collapses it.
        document.addEventListener('click', (e) => {
            const sidebar = document.getElementById('sidebarEl');
            const toggleBtn = document.getElementById('sidebarToggleBtn');
            if (!sidebar || (toggleBtn && toggleBtn.contains(e.target))) return;
            if (sidebar.classList.contains('collapsed')) {
                if (sidebar.contains(e.target)) toggleSidebar(false);
                return;
            }
            if (!sidebar.contains(e.target)) return;
            let el = e.target;
            while (el && el !== sidebar) {
                if (['SELECT', 'INPUT', 'BUTTON', 'A', 'TEXTAREA'].includes(el.tagName) || el.hasAttribute('onclick')) return;
                el = el.parentElement;
            }
            toggleSidebar(true);
        });

        // Color by cluster QUALITY (code's 2nd letter: G=Good, M=Medium, B=Bad -
        // see the "Cluster code" legend below) so condition is visible at a
        // glance: greens = good, ambers = medium, reds = bad. Each cluster still
        // gets its own shade within that family so individual clusters stay
        // distinguishable. T0/I0 ("Obstruction") and anything unrecognized fall
        // back to a neutral gray family.
        const QUALITY_SHADES = {
            G: ['#15803d', '#16a34a', '#22c55e', '#4ade80', '#059669', '#10b981', '#65a30d', '#84cc16'],
            M: ['#b45309', '#d97706', '#f59e0b', '#eab308', '#ca8a04', '#facc15', '#f97316', '#ea580c'],
            B: ['#b91c1c', '#dc2626', '#ef4444', '#e11d48', '#be123c', '#f43f5e', '#9f1239', '#f87171'],
        };
        const NEUTRAL_SHADES = ['#64748b', '#475569', '#94a3b8', '#334155'];

        function colorFor(cluster) {
            if (cluster in S.colorMap) return S.colorMap[cluster];
            const m = String(cluster).trim().toUpperCase().match(/^([TI])([GBM]?)(\d+)$/);
            const q = m ? m[2] : '';
            const shades = QUALITY_SHADES[q] || NEUTRAL_SHADES;
            const bucket = q || '_neutral';
            const i = S.shadeIndex[bucket] || 0;
            S.shadeIndex[bucket] = i + 1;
            S.colorMap[cluster] = shades[i % shades.length];
            return S.colorMap[cluster];
        }

        function toast(msg, type) {
            const box = document.getElementById('toastBox');
            const el = document.createElement('div');
            el.className = 'toast ' + (type || '');
            el.textContent = msg;
            box.appendChild(el);
            setTimeout(() => el.remove(), 4000);
        }

        function toLocalISO(d) { return new Date(d - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16); }

        // \u2500\u2500 SITES / POINT MACHINES (same endpoints as operation page) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        async function loadSites() {
            try {
                const r = await fetch(PMC_ENDPOINTS.sites);
                const sites = await r.json();
                S.sites = sites;
                const sel = document.getElementById('siteSelect');
                sel.innerHTML = '<option value="">-- Select Site --</option>';
                sites.sort((a, b) => (a.SiteName || '').localeCompare(b.SiteName || ''));
                sites.forEach(s => {
                    const o = document.createElement('option');
                    o.value = s.SiteId; o.textContent = `${s.SiteName} (${s.SiteId})`;
                    sel.appendChild(o);
                });
            } catch (e) { toast('Load sites failed: ' + e.message, 'error'); }
        }
        loadSites();

        // ADDITIVE: auto-fetch point machines as soon as a site is picked -
        // same pattern as pm_operation_combined.html's onSiteChange().
        function onSiteSelectChange() {
            if (document.getElementById('siteSelect').value) fetchPointMachines();
        }

        async function fetchPointMachines() {
            const siteId = document.getElementById('siteSelect').value;
            if (!siteId) return toast('Select a site first', 'error');
            S.currentSiteId = siteId;
            const btn = document.getElementById('fetchPmBtn');
            btn.disabled = true;
            try {
                const r = await fetch(`${PMC_ENDPOINTS.liveValue}?SiteId=${encodeURIComponent(siteId)}`);
                const tags = await r.json();
                if (!Array.isArray(tags)) throw new Error('Unexpected response');
                const assets = new Map();
                tags.forEach(t => {
                    if (String(t.AssetTypeId) !== '3') return;   // Point Machine asset type
                    if (!assets.has(t.AssetId)) assets.set(t.AssetId, { assetId: t.AssetId, assetName: t.AssetName || `Asset ${t.AssetId}`, tags: [] });
                    assets.get(t.AssetId).tags.push(t);
                });
                S.pointMachines = Array.from(assets.values());
                renderPmList();
                toast(`${S.pointMachines.length} point machines found`, 'success');
            } catch (e) { toast('Fetch failed: ' + e.message, 'error'); }
            btn.disabled = false;
        }

        function renderPmList() {
            const list = document.getElementById('pmList');
            document.getElementById('pmCount').textContent = S.pointMachines.length;
            renderCustomPmSelect();
            if (!S.pointMachines.length) { list.innerHTML = '<div class="empty-msg">No point machines for this site.</div>'; return; }
            list.innerHTML = S.pointMachines.map((pm, i) =>
                `<div class="pm-item ${S.selectedAsset && S.selectedAsset.assetId === pm.assetId ? 'active' : ''}" onclick="selectPointMachine(${i})">
                    <div class="pm-name">${pm.assetName}</div>
                    <div class="pm-meta">Asset ID ${pm.assetId} &middot; ${pm.tags.length} tags</div>
                </div>`).join('');
        }

        function selectPointMachine(idx) {
            S.selectedAsset = S.pointMachines[idx];
            renderPmList();
            updateCompactSidebar();
            document.getElementById('emptyState').style.display = 'none';
            document.getElementById('mainView').style.display = 'flex';
            document.getElementById('assetTitle').textContent = S.selectedAsset.assetName;
            document.getElementById('assetBreadcrumb').textContent = S.selectedAsset.assetName;
            document.getElementById('assetSub').textContent = `Asset ID ${S.selectedAsset.assetId}`;
            const rt = document.getElementById('refTime');
            if (!rt.value) rt.value = toLocalISO(new Date());
            document.getElementById('results').style.display = 'none';
            document.getElementById('detail').style.display = 'none';
            document.getElementById('clusterSub').textContent = 'Last 30 days';
            analyzeClusters();   // auto-run on select
        }

        // \u2500\u2500 SIGNAL PARSING (for click\u2192waveform) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        function parseArrayValue(raw) {
            if (raw == null) return [];
            if (Array.isArray(raw)) {
                if (raw.length === 1 && typeof raw[0] === 'string') return parseArrayValue(raw[0]);
                return raw.map(Number).filter(Number.isFinite);
            }
            if (typeof raw === 'string') {
                let s = raw.trim();
                if (s.startsWith('[')) s = s.slice(1);
                if (s.endsWith(']')) s = s.slice(0, -1);
                s = s.replace(/[\r\n]+/g, '');
                if (s.includes(',')) return s.split(',').map(v => parseFloat(v)).filter(Number.isFinite);
                try { const p = JSON.parse(raw); return Array.isArray(p) ? p.map(Number).filter(Number.isFinite) : []; }
                catch (e) { const n = parseFloat(s); return Number.isFinite(n) ? [n] : []; }
            }
            return [];
        }

        function extractPmj(rec) {
            let pmj = rec.PointMachineJson;
            if (typeof pmj === 'string') { try { pmj = JSON.parse(pmj); } catch (e) { pmj = null; } }
            if (Array.isArray(pmj)) pmj = pmj[0];
            return (pmj && typeof pmj === 'object') ? pmj : null;
        }

        // \u2500\u2500 CLUSTER STRING PARSER \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        // Do formats aate hain:
        //   "TB5 - 58.53 - 87.54% -- Top 3 close clusters: TB5 (58.53), ..."
        //   "ABNORMAL (100.00) - I0 - 55.51 - 100.00% -- Top 3 close clusters: I0 (55.51), ..."
        // Doosre mein leading "NORMAL/ABNORMAL (xx.xx)" ek EXTRA prefix hai \u2014 usko
        // strip karke sirf code (I0 / TB5 / IB17) rakhte hain.
        function parseCluster(str) {
            if (!str || typeof str !== 'string') return null;
            const parts = str.split('--');
            let head = parts[0].trim().split(/\s+-\s+/).map(s => s.trim());
            if (head.length && /^(NORMAL|ABNORMAL)\b/i.test(head[0])) head = head.slice(1);
            const cluster = (head[0] || '').trim();
            if (!cluster) return null;
            const distance = head.length > 1 ? parseFloat(head[1]) : null;
            const match = head.length > 2 ? parseFloat(head[2].replace('%', '')) : null;
            const top3 = [];
            if (parts.length > 1) {
                const after = parts[1].replace(/^[^:]*:/, '');
                const re = /([A-Za-z0-9]+)\s*\(\s*([\d.]+)\s*\)/g;
                let m;
                while ((m = re.exec(after))) top3.push({ id: m[1], dist: parseFloat(m[2]) });
            }
            return { cluster, distance, match, top3, raw: str };
        }

        function expandCode(code) {
            if (!code) return '';
            const c = code.trim().toUpperCase();
            if (c === 'T0' || c === 'I0') return (c[0] === 'T' ? 'TWS' : 'IRS') + ' \u00b7 Obstruction';
            const m = code.match(/^([TI])([GBM]?)(\d+)$/i);
            if (!m) return '';
            const wave = m[1].toUpperCase() === 'T' ? 'TWS' : 'IRS';
            const q = { G: 'Good', B: 'Bad', M: 'Medium' }[m[2].toUpperCase()] || '';
            return wave + (q ? ' \u00b7 ' + q : '') + ' \u00b7 #' + m[3];
        }

        // \u2500\u2500 ONE shared severity system (Part A #1): color + label + shape,
        // used EVERYWHERE on this page - the main badges/Plotly charts/grid
        // AND the Health Map below (which used to have its own separate
        // NM_SEV_COLOR with a different "normal" color - gray instead of this
        // page's established green - now unified onto this single source). \u2500\u2500
        const SEV = {
            normal: { color: '#16a34a', glyph: '\u25cf', label: 'Normal' },
            watch: { color: '#ca8a04', glyph: '\u25b2', label: 'Watch' },
            anomaly: { color: '#dc2626', glyph: '\u25a0', label: 'Anomaly' },
            unknown: { color: '#94a3b8', glyph: '\u25cb', label: 'Unscored' },
        };
        function sevColor(sev) { return (SEV[sev] || SEV.unknown).color; }
        function sevGlyph(sev) { return (SEV[sev] || SEV.unknown).glyph; }
        function sevLabel(sev) { return (SEV[sev] || SEV.unknown).label; }
        function severityColor(sev) { return sevColor(sev); } // kept: still called a few places below

        function noveltySideSummary(ops, side) {
            const scoreKey = 'novelty_score_' + side, sevKey = 'novelty_severity_' + side;
            const scores = ops.map(o => o[scoreKey]).filter(v => v != null);
            const counts = { normal: 0, watch: 0, anomaly: 0, unknown: 0 };
            ops.forEach(o => {
                const sev = o[sevKey] || 'unknown';
                counts[sev] = (counts[sev] || 0) + 1;
            });
            return {
                total: ops.length,
                avg: scores.length ? Math.round((scores.reduce((a, b) => a + b, 0) / scores.length) * 10) / 10 : null,
                worst: scores.length ? Math.max(...scores) : null,
                counts,
            };
        }

        function noveltySideBlock(label, s, meta) {
            const sideLetter = label.toLowerCase();
            // ADDITIVE: each pill is clickable - jumps to the Health Map below
            // and focuses the latest operation of that severity on that side.
            const pill = (sev, count, text) => {
                const active = S.trendFilter[sideLetter] === sev;
                const ring = active ? 'box-shadow:0 0 0 2px currentColor;' : '';
                return `<span class="sev-pill pill-${sev}" style="cursor:pointer; ${ring}" title="Click to focus a ${sev} operation in the Health Map below" onclick="filterNoveltyTrend('${sideLetter}','${sev}')">${count} ${text}</span>`;
            };
            const abnormal = s.counts.watch + s.counts.anomaly;
            return `<div style="flex:1; min-width:280px; background:var(--bg-card); border:1px solid var(--border); border-radius:12px; padding:16px;">
                <div style="font-size:15px; font-weight:800; margin-bottom:10px;">Machine ${label}</div>
                <div class="novelty-stat-row" style="margin-bottom:8px;">
                    <div class="novelty-stat"><div class="v">${s.total}</div><div class="l">Total ops</div></div>
                    <div class="novelty-stat"><div class="v sev-anomaly">${abnormal}</div><div class="l">Abnormal</div></div>
                    <div class="novelty-stat"><div class="v sev-watch">${s.counts.watch}</div><div class="l">Watch</div></div>
                    <div class="novelty-stat"><div class="v">${s.worst != null ? s.worst : '\u2014'}</div><div class="l">Worst score</div></div>
                </div>
                <div style="display:flex; gap:6px; flex-wrap:wrap;">
                    ${pill('normal', s.counts.normal, 'normal')}
                    ${pill('watch', s.counts.watch, 'watch')}
                    ${pill('anomaly', s.counts.anomaly, 'anomaly')}
                    ${s.counts.unknown ? pill('unknown', s.counts.unknown, 'unscored') : ''}
                </div>
                ${meta ? noveltyMetaBlock(meta) : ''}
            </div>`;
        }

        // \u2500\u2500 ADDITIVE: click a severity pill above -> jump to + focus that
        // severity's latest operation in the Health Map below (the dedicated
        // trend chart this used to redraw was removed - the Health Map's own
        // score-over-time panel supersedes it) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        function filterNoveltyTrend(sideLetter, sev) {
            S.trendFilter[sideLetter] = (S.trendFilter[sideLetter] === sev) ? null : sev;
            renderNoveltySummary(S.ops);   // re-render pills so the active one gets its highlight ring
            const box = document.getElementById('healthMapSection');
            if (!box || box.style.display === 'none') return;
            nmSetSide(sideLetter);
            const active = S.trendFilter[sideLetter];
            if (active) {
                const match = nmScoredOps().filter(p => nmSeverityAt(p.ratio) === active);
                if (match.length) { NM.focusedIdx = match[match.length - 1].i; nmRenderAll(); }
            }
            box.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // \u2500\u2500 ADDITIVE (Part A #3/#4): one model/baseline summary per side, read
        // straight off the already-fetched ops - every op already carries its
        // own novelty_model_version_x/novelty_model_trained_at_x/
        // novelty_normal_baseline_version_x (Spec \u00a75.1 fields, from
        // cache_refresh.py). A side can show 2 distinct models here (Normal-
        // direction ops use one VAE, Reverse-direction ops use another). \u2500\u2500\u2500\u2500\u2500\u2500
        function noveltyMetaSummary(ops, side) {
            const verKey = 'novelty_model_version_' + side, atKey = 'novelty_model_trained_at_' + side;
            const baseKey = 'novelty_normal_baseline_version_' + side;
            const seen = new Map();
            let minCount = null;
            ops.forEach(o => {
                const ver = o[verKey];
                if (!ver || seen.has(ver)) {
                    if (ver) return;
                } else {
                    seen.set(ver, o[atKey] || null);
                }
                const m = (o[baseKey] || '').match(/\(n=(\d+)\)/);
                if (m) {
                    const n = parseInt(m[1], 10);
                    if (minCount == null || n < minCount) minCount = n;
                }
            });
            const models = Array.from(seen.entries()).map(([version, trainedAt]) => {
                const known = trainedAt && trainedAt !== 'unknown';
                const ageDays = known ? Math.floor((Date.now() - new Date(trainedAt + 'T00:00:00')) / 86400000) : null;
                return { version, trainedAt, ageDays, stale: ageDays != null && ageDays > 90 };
            });
            // Part B final step #1: shadow-baseline quality, read from any
            // op that has it (most machines won't, until the server-side
            // one-time build command runs) - shown so low_confidence/fallback
            // is visible on the page, not just inside the baseline JSON file.
            let shadowQuality = null;
            for (const o of ops) {
                const src = o['novelty_baseline_source_' + side];
                if (src) { shadowQuality = { source: src, lowConfidence: o['novelty_baseline_low_confidence_' + side] }; break; }
            }
            return { models, minBaselineOps: minCount, baselineThin: minCount != null && minCount < 8, shadowQuality };
        }

        function noveltyMetaBlock(meta) {
            if (!meta.models.length) return '';
            const modelLines = meta.models.map(m => {
                const ageTxt = m.ageDays != null ? `${m.ageDays}d old` : 'age unknown';
                const warn = m.stale ? `<span class="model-stale-warn">\u26a0 baseline ${ageTxt} \u2014 confidence reduced</span>` : '';
                return `<div><span class="mono">${m.version}</span> \u00b7 trained ${m.trainedAt || '\u2014'} (${ageTxt}) ${warn}</div>`;
            }).join('');
            const baselineWarn = meta.baselineThin
                ? `<div class="model-stale-warn" style="margin-top:4px;">\u26a0 baseline built from only ${meta.minBaselineOps} ops this window \u2014 below the recommended minimum (8), severity may be unreliable</div>`
                : '';
            const sq = meta.shadowQuality;
            const shadowLine = sq
                ? `<div style="margin-top:4px;">Fixed baseline (not yet displayed): <span class="mono">${sq.source}</span>${sq.lowConfidence ? ' <span class="model-stale-warn">\u26a0 low confidence</span>' : ''}</div>`
                : '';
            return `<div class="model-meta-row">${modelLines}${baselineWarn}${shadowLine}</div>`;
        }

        // \u2500\u2500 ADDITIVE (Part A #6): detect -> name -> confirm -> human handoff,
        // shown near the main score section too (previously only inside the
        // Health Map's own note panel below) - nothing here suggests automatic
        // action on the asset, every step before "human review" is advisory. \u2500\u2500
        function handoffRow() {
            return `<div class="handoff-row">
                <span class="handoff-chip active">detect (this score)</span><span class="handoff-arrow">\u2192</span>
                <span class="handoff-chip">name (CNN classifier)</span><span class="handoff-arrow">\u2192</span>
                <span class="handoff-chip">confirm (RDSO rules)</span><span class="handoff-arrow">\u2192</span>
                <span class="handoff-chip">human review (safety cap)</span>
            </div>`;
        }

        function renderNoveltySummary(ops) {
            const box = document.getElementById('noveltySummary');
            const hasAny = ops.some(o => o.novelty_score_a != null || o.novelty_score_b != null);
            if (!hasAny) { box.style.display = 'none'; box.innerHTML = ''; return; }
            const sA = noveltySideSummary(ops, 'a'), sB = noveltySideSummary(ops, 'b');
            const metaA = noveltyMetaSummary(ops, 'a'), metaB = noveltyMetaSummary(ops, 'b');
            box.style.display = 'block';
            box.innerHTML = `<div class="card" style="margin-bottom:14px; background:var(--bg-tertiary);">
                <div class="card-title"><span>Self-Supervised Anomaly Score (new, additive)</span></div>
                <div style="display:flex; gap:16px; flex-wrap:wrap;">
                    ${noveltySideBlock('A', sA, metaA)}
                    ${noveltySideBlock('B', sB, metaB)}
                </div>
                ${handoffRow()}
            </div>`;
        }

        // \u2500\u2500 ADDITIVE #1: alert banner - the loudest, first-seen signal \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
        // ADDITIVE helpers: the worst-scoring operation for a side, and which
        // cluster code carries the most watch/anomaly ops on that side - what
        // actually makes an alert banner "detailed" instead of just a count.
        function noveltyWorstOp(ops, sideLetter) {
            let worst = null;
            ops.forEach(o => {
                const score = o['novelty_score_' + sideLetter];
                if (score != null && (!worst || score > worst['novelty_score_' + sideLetter])) worst = o;
            });
            return worst;
        }

        function topAbnormalCluster(ops, side, sideLetter) {
            const clusterKey = side === 'A' ? 'clusterA' : 'clusterB';
            const counts = {};
            ops.forEach(o => {
                const sev = o['novelty_severity_' + sideLetter];
                if ((sev === 'anomaly' || sev === 'watch') && o[clusterKey]) {
                    const c = o[clusterKey].cluster;
                    counts[c] = (counts[c] || 0) + 1;
                }
            });
            let top = null, topCount = 0;
            Object.entries(counts).forEach(([c, n]) => { if (n > topCount) { top = c; topCount = n; } });
            return top ? { code: top, count: topCount } : null;
        }

        function renderNoveltyAlert(ops) {
            const box = document.getElementById('noveltyAlert');
            const hasAny = ops.some(o => o.novelty_score_a != null || o.novelty_score_b != null);
            if (!hasAny) { box.style.display = 'none'; box.innerHTML = ''; return; }
            const sA = noveltySideSummary(ops, 'a'), sB = noveltySideSummary(ops, 'b');
            const rows = [];
            [['A', sA], ['B', sB]].forEach(([label, s]) => {
                const sideLetter = label.toLowerCase();
                if (s.counts.anomaly === 0 && s.counts.watch === 0) return;
                const level = s.counts.anomaly > 0 ? 'anomaly' : 'watch';
                const abnormalCount = s.counts.anomaly + s.counts.watch;
                const scoredTotal = s.counts.normal + s.counts.watch + s.counts.anomaly;
                const pct = scoredTotal ? Math.round(abnormalCount / scoredTotal * 100) : 0;
                const worstOp = noveltyWorstOp(ops, sideLetter);
                const topCluster = topAbnormalCluster(ops, label, sideLetter);
                rows.push({ label, level, s, abnormalCount, pct, worstOp, topCluster, sideLetter });
            });
            if (!rows.length) {
                box.style.display = 'block';
                box.innerHTML = `<div class="card" style="margin-bottom:14px; border-left:4px solid #16a34a; background:#f0fdf4;">
                    <b style="color:#16a34a;">\u2713 No anomalies detected</b> \u2014 both machines' current shapes matched their own recent normal, self-supervised score-wise.
                </div>`;
                return;
            }
            const worst = rows.some(r => r.level === 'anomaly') ? 'anomaly' : 'watch';
            const color = worst === 'anomaly' ? '#dc2626' : '#ca8a04';
            const bg = worst === 'anomaly' ? '#fef2f2' : '#fffbeb';
            const icon = worst === 'anomaly' ? '\u26a0' : '\ud83d\udc41';
            box.style.display = 'block';
            box.innerHTML = `<div class="card" style="margin-bottom:14px; border-left:4px solid ${color}; background:${bg};">
                <div style="font-weight:800; color:${color}; margin-bottom:8px;">${icon} This machine needs a look</div>
                ${rows.map(r => `
                    <div style="margin-bottom:${rows.length > 1 ? '10px' : '0'}; padding-bottom:${rows.length > 1 ? '10px' : '0'}; ${rows.length > 1 ? 'border-bottom:1px solid rgba(0,0,0,0.08);' : ''}">
                        <div style="font-size:13.5px; margin-bottom:3px;">
                            <b>Machine ${r.label}:</b> <b class="sev-${r.level}">${r.pct}%</b> of its recent operations (${r.abnormalCount} out of ${r.s.counts.normal + r.s.counts.watch + r.s.counts.anomaly}) looked unusual.
                            The worst one scored <b>${r.s.worst}/100</b>${r.worstOp ? ` on ${r.worstOp.time.toLocaleDateString()}` : ''}.
                        </div>
                        ${r.topCluster ? `<div style="font-size:12.5px; color:var(--text-secondary);">Most of these happened in cluster <span class="chip" style="cursor:pointer; padding:1px 8px; font-size:11px;" onclick="showClusterOps('${r.label}','${r.topCluster.code.replace(/'/g, "\\'")}')"><span class="dot" style="background:${colorFor(r.topCluster.code)};"></span>${r.topCluster.code}</span> \u2014 click it to see those operations.</div>` : ''}
                        <button class="btn" style="width:auto; margin-top:6px; padding:4px 10px; font-size:11.5px;" onclick="filterNoveltyTrend('${r.sideLetter}','${r.level}')">Show these in the Health Map \u2193</button>
                    </div>`).join('')}
            </div>`;
        }

        // \u2500\u2500 ADDITIVE #2: severity timeline (continuous band, colored by severity
        // instead of cluster) - sits directly under each side's cluster timeline \u2500\u2500
        function renderNoveltyTimelines(ops, xStart, xEnd) {
            renderNoveltySideTimeline(ops, 'a', 'A', 'noveltyTimelineA', xStart, xEnd);
            renderNoveltySideTimeline(ops, 'b', 'B', 'noveltyTimelineB', xStart, xEnd);
        }

        function renderNoveltySideTimeline(ops, sideLetter, label, elId, xStart, xEnd) {
            const el = document.getElementById(elId);
            const pts = ops.filter(o => o['novelty_score_' + sideLetter] != null);
            if (!pts.length) { el.innerHTML = ''; return; }
            const grid = 'rgba(0,0,0,0.08)';
            const shapes = pts.map((p, i) => ({
                type: 'rect', xref: 'x', yref: 'y', x0: p.time,
                x1: (i + 1 < pts.length) ? pts[i + 1].time : (xEnd || p.time),
                y0: 0.5, y1: 1.5, fillcolor: severityColor(p['novelty_severity_' + sideLetter]), line: { width: 0 }, layer: 'below',
            }));
            const x = [], y = [], colors = [], text = [];
            pts.forEach(o => {
                const score = o['novelty_score_' + sideLetter], sev = o['novelty_severity_' + sideLetter];
                x.push(o.time); y.push(1); colors.push(severityColor(sev));
                text.push(`<b>Self-supervised score</b> \u00b7 ${o.time.toLocaleString()}<br>Score: ${score} (${sev})`);
            });
            const data = [{
                x, y, text, mode: 'markers', type: 'scatter', name: label,
                marker: { color: colors, size: 12, opacity: 0.01 },
                hovertemplate: '%{text}<extra></extra>',
            }];
            const layout = {
                height: 50, margin: { l: 36, r: 20, t: 2, b: 18 },
