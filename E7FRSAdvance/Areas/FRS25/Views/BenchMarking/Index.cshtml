    function BindTable(DataSeriaes) {
        var tblthead = '';
        var tblbody = '';
        var drpAttributes = [];
        if (DataSeriaes != null && DataSeriaes != undefined && DataSeriaes != '') {
            tblthead += '<tr>';
            tblthead += '<th>Time</th>';
            if (DataSeriaes.assetAttributes != null && DataSeriaes.assetAttributes.length > 0) {
                $(DataSeriaes.assetAttributes).each(function (val, data) {
                    tblthead += '<th>' + data.Title + '</th>';

                    var firstTitle = data.Title.split(" ");
                    if (firstTitle.length > 0) {
                        if ($.inArray(firstTitle[0], drpAttributes) == -1) {
                            drpAttributes.push(firstTitle[0]);
                        }
                    }
                });
            }
            tblthead += '<th class="text-center">Select Bench Marking</th>';
            tblthead += '</tr>';

            for (var i = 0; i < DataSeriaes.DateList.length; i++) {
                tblbody += '<tr>';
                tblbody += '<td> ' + $('#searchDate').val() + ' ' + DataSeriaes.DateList[i] + '</td>';
                if (DataSeriaes.assetAttributes != null && DataSeriaes.assetAttributes.length > 0) {
                    $(DataSeriaes.assetAttributes).each(function (val, ldata) {
                        tblbody += '<td data-attributeName="' + ldata.Title + '" data-attributeid="' + ldata.Id + '">' + ldata.Data[i] + '</td>';
                    });

                    if ($("#AssetTypeId").val() == "@E7FRSAdvance.Utility.Utility.AssetType.SIGNAL.GetHashCode()") {
                        var optionAttr = '';
                        $(drpAttributes).each(function (d, drpAttribute) {
                            optionAttr += '<option value=' + drpAttribute + '>' + drpAttribute + '</option>';
                        });
                        tblbody += '<td class="text-center text-nowrap"><input type="checkbox"  /><select class="m-l-10 ml-2">' + optionAttr + '</select></td>';
                    }
                    else if ($("#AssetTypeId").val() == "@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()") {
                        var optionAttr = '<option value="NWKR">NWKR</option><option value="RWKR">RWKR</option>';
                        tblbody += '<td class="text-center text-nowrap"><input type="checkbox"  /><select class="m-l-10 ml-2">' + optionAttr + '</select></td>';
                    }
                    else {
                        tblbody += '<td class="text-center"><input type="checkbox" /></td>';
                    }
                }
                tblbody += '</tr>';
            }
        }
        $("#area-echart-thead").empty().append(tblthead);
        $("#area-echart-tbody").empty().append(tblbody);
    }

