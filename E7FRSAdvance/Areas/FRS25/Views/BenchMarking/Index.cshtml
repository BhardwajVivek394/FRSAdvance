    function fnBindSignatureGragh(data, type, datevalue, direction, name) {
        $("div").remove(".chartjs-size-monitor");
        var j = JSON.parse(data);
        var acg;
        var bcg;
        var avg;
        var bvg;
        if (j.A_C_AVERAGE != null) {
            acg = parseFloat(j.A_C_AVERAGE).toFixed(2);
        }
        if (j.B_C_AVERAGE != null) {
            bcg = parseFloat(j.B_C_AVERAGE).toFixed(2);
        }
        if (j.A_V_AVERAGE != null) {
            avg = parseFloat(j.A_V_AVERAGE).toFixed(2);
        }
        if (j.B_V_AVERAGE != null) {
            bvg = parseFloat(j.B_V_AVERAGE).toFixed(2);
        }

        $("#line1").empty().text(name + " " + datevalue);
        $("#op").text(direction + " Operation");
        $("#line2").empty().text("- A Max / Average Current:" + j.A_C_MAX + "/" + acg);
        $("#line3").empty().text("-  Average Voltage:" + avg);
        $("#line4").empty().text("- A Operating Time (ms):" + j.A_C_TIME);
        $("#line5").empty().text("- B Max / Average Current:" + j.B_C_MAX + "/" + bcg);
        $("#line6").empty().text("- Average Voltage:" + bvg);
        $("#line7").empty().text("- B Operating Time (ms):" + j.B_C_TIME);

        var array = [];
        var labels = "";
        var total = 0;
        function collect(values) {
            $.each(values, function (id, val) {
                if (val != null && val != undefined && val != '') {
                    var num = parseInt(val);
                    total += num;
                    array.push(val);
                }
            });
        }

        if (type == "CC") {
            labels = "Combine C";
            collect(j.A_C);
            collect(j.B_C);
        }
        if (type == "CV") {
            labels = "Combine V";
            collect(j.A_V);
            collect(j.B_V);
        }
        if (type == "AC") {
            labels = "A End";
            collect(j.A_C);
        }
        if (type == "BC") {
            labels = "B End";
            collect(j.B_C);
        }
        if (type == "AV") {
            labels = "A End";
            collect(j.A_V);
        }
        if (type == "BV") {
            labels = "B End";
            collect(j.B_V);
        }

        var label = [];
        for (var i = 0; i <= array.length; i++) {
            label.push(i * 100);
        }

        var chartContainer = document.getElementById('mainId');
        chartContainer.innerHTML = '&nbsp;';
        $('#mainId').append('<canvas id="basicflot" style="height: 263px"></canvas>');
        var canvas = $("#basicflot").get(0).getContext("2d");

        var t = fnBmChartTheme();
        Chart.defaults.global.defaultFontColor = t.text;

        var chartData = {
            labels: label,
            datasets: [
                {
                    label: labels + " Current",
                    fill: false,
                    lineTension: 0.1,
                    backgroundColor: t.accent,
                    borderColor: t.accent,
                    borderCapStyle: 'butt',
                    borderDash: [],
                    borderDashOffset: 0.0,
                    borderJoinStyle: 'miter',
                    pointBorderColor: t.accent,
                    pointBackgroundColor: t.surface,
                    pointBorderWidth: 0.5,
                    pointHoverRadius: 5,
                    pointHoverBackgroundColor: t.accent,
                    pointHoverBorderColor: t.grid,
                    pointHoverBorderWidth: 1,
                    pointRadius: 5,
                    pointHitRadius: 10,
                    data: array
                }
            ]
        };

        var option = {
            showLines: true,
            scales: {
                xAxes: [{ gridLines: { color: t.grid } }],
                yAxes: [{ gridLines: { color: t.grid } }]
            }
        };
        Chart.Line(canvas, {
            data: chartData,
            options: option
        });

        $("#modal-pointmachine-graph").modal("show");
    }

    function fnDeletePointMachineBenchMarking(id) {

        if ($("#SiteId").val() != null && $("#SiteId").val() != undefined && $("#SiteId").val() != '' && $("#SiteId").val() != '0' && $("#AssetId").val() != null && $("#AssetId").val() != undefined && $("#AssetId").val() != '' && $("#AssetId").val() != '0') {
            if (confirm('Are you sure you want to delete this record?')) {
                fnBmLoader(true);
                $.ajax({
                    url: '/FRS25/BenchMarking/DeletePointMachineEvent',
                    type: 'Post',
                    data: '{id:' + id + '}',
                    contentType: 'application/json',
                    success: function (data) {
                        fnBmLoader(false);
                        $("#model-benchmarking-pointmachine-eventgraph").modal("hide");
                        if (data.type == "success") {
                            CommonNotification("SUCCESS", data.result, "success");
                        } else {
                            CommonNotification("ERROR", data.result, "error");
                        }
                    },
                    error: function (response) {
                        fnBmLoader(false);
                        CommonNotification("ERROR", "Something went wrong!", "Error");
                    }
                });
            }
        } else {
            CommonNotification("ERROR", "Select Site and Asset", "Error");
        }
    }
</script>
