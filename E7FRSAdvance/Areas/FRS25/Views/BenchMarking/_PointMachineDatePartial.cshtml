@model Domain.Asset

@* Rows of the point-machine event table in _PointMachineEvent (one <tr> per operation). *@
@if (Model != null && Model.mPointMachineData != null)
{
    // Thick-wave assets were highlighted in blue (#00A4E0), the rest in orange (#dc8b33).
    bool thickA = Model.IsThickWave != null && Model.ThickWaveTypeId != null && Model.IsThickWave.Value
                  && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.A || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both);
    bool thickB = Model.IsThickWave != null && Model.ThickWaveTypeId != null && Model.IsThickWave.Value
                  && (Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.B || Model.ThickWaveTypeId == (int)E7FRSAdvance.Utility.Utility.ThickWaveType.Both);
    string clsA = "bm-click " + (thickA ? "bm-val-thick" : "bm-val-normal");
    string clsB = "bm-click " + (thickB ? "bm-val-thick" : "bm-val-normal");
    bool isSeriesOperation = Model.IsSeriesOpration != null && Model.IsSeriesOpration.Value;
    bool isFullPointMachine = Model.IsHalfPointMachine == null || (Model.IsHalfPointMachine != null && !Model.IsHalfPointMachine.Value);

    foreach (var point in Model.mPointMachineData.OrderByDescending(x => x.Date))
    {
        var date = Convert.ToDateTime(point.Date).ToString("MM/dd/yyyy");
        <tr>
            <td class="text-nowrap">
                @point.Date
            </td>
            <td class="assetname">
                @point.AssetType
            </td>
            <td>
                @point.Direction  Operation
            </td>
            @if (isSeriesOperation)
            {
                var sumTime = point.PointMachineJson.A_C_TIME + point.PointMachineJson.B_C_TIME;

                <td>
                    @if (point.PointMachineJson.Combine_C_TIME > 0 && point.PointMachineJson.Combine_V_TIME > 0)
                    {
                        <span class="bm-muted">(Max/Avg/Time)</span>
                        <span>
                            <a href="#" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','CC',' @point.Date','@point.Direction','@point.AssetType'); return false;">C(@point.PointMachineJson.Combine_C_MAX/@point.PointMachineJson.Combine_C_AVERAGE/@point.PointMachineJson.Combine_C_TIME)</a>
                            <br />
                            <a href="#" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','CV',' @point.Date','@point.Direction','@point.AssetType'); return false;">V(@point.PointMachineJson.Combine_V_MAX/@point.PointMachineJson.Combine_V_AVERAGE/@point.PointMachineJson.Combine_V_TIME)</a>
                        </span>
                    }
                    else
                    {
                        <span>
                            <a href="#" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','CC',' @point.Date','@point.Direction','@point.AssetType'); return false;">C</a>/<a href="#" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','CV',' @point.Date','@point.Direction','@point.AssetType'); return false;">V</a>/<a>T(@sumTime)</a>
                        </span>
                    }
                </td>
            }

            <td class="@clsA" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','AC',' @point.Date','@point.Direction','@point.AssetType')">
                @string.Format("{0:0.00}", point.PointMachineJson.A_C_MAX) / @string.Format("{0:0.00}", point.PointMachineJson.A_C_AVERAGE) (@point.PointMachineJson.A_C_CurveArea)
            </td>
            <td class="bm-click" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','AV',' @point.Date','@point.Direction','@point.AssetType')">
                @point.PointMachineJson.A_V_AVERAGE
            </td>
            <td>
                <span> @point.PointMachineJson.A_C_TIME </span>
            </td>
            @if (isFullPointMachine)
            {
                <td class="@clsB" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','BC',' @point.Date','@point.Direction','@point.AssetType')">
                    @string.Format("{0:0.00}", point.PointMachineJson.B_C_MAX) / @string.Format("{0:0.00}", point.PointMachineJson.B_C_AVERAGE) (@point.PointMachineJson.B_C_CurveArea)
                </td>
                <td class="bm-click" onclick="fnBindSignatureGragh('@Json.Encode(point.PointMachineJson)','BV',' @point.Date','@point.Direction','@point.AssetType')">
                    @point.PointMachineJson.B_V_AVERAGE
                </td>
                <td>
                    @point.PointMachineJson.B_C_TIME
                </td>
            }
            <td class="text-center">
                <input type="checkbox" class="clspmEventDataCheck" data-AssetId="@Model.Id" data-direction="@point.Direction" data-tstime="@point.Date" data-timestamp="@point.TimeStamp" data-pmjson="@point.ArrayData" />
            </td>
        </tr>
    }
}
