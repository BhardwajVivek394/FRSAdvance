<!-- ── Break-up popup markup ─────────────────────────────────────── -->
<div id="perfBreakupBackdrop"></div>
<div id="perfBreakupModal" role="dialog" aria-labelledby="perfBreakupTitle" aria-hidden="true">
    <div class="breakup-card" role="document">
        <div class="breakup-header">
            <div class="breakup-title-wrap">
                <div class="breakup-eyebrow">Break Up</div>
                <div class="breakup-title" id="perfBreakupTitle">Break up</div>
            </div>
            <button type="button" class="breakup-close" data-breakup-close="1" aria-label="Close">&times;</button>
        </div>

        <div class="breakup-meta">
            <div><span class="lbl">Station:</span> <strong id="perfBreakupStation">-</strong></div>
            <div><span class="lbl">Percentage:</span> <strong id="perfBreakupPct">-</strong></div>
        </div>

        <div class="breakup-summary">
            <div class="tile tile-total">
                <span class="tile-label">Total</span>
                <span class="tile-value" id="perfBreakupTotal">0</span>
            </div>
            <div class="tile tile-t">
                <span class="tile-label">True (T)</span>
                <span class="tile-value" id="perfBreakupT">0</span>
            </div>
            <div class="tile tile-pt">
