@model Domain.FRSAlertLister

@{ // Process data once at the top for better performance
    var alertSummaryReport = new List<dynamic>();

    if (Model != null && Model.mFRSAlerts != null && Model.mFRSAlerts.Count > 0)
    {
        alertSummaryReport = Model.mFRSAlerts
            .GroupBy(c => new
            {
                c.ZoneName,
                c.DivisionName,
                c.SectionName,
                c.SiteName,
            })
     .Select(gcs => new
     {
         gcs.Key.ZoneName,
         gcs.Key.DivisionName,
         gcs.Key.SectionName,
         gcs.Key.SiteName,
         Count = gcs.Count(),
         TrueCount = gcs.Count(x => x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True),
         PTCount = gcs.Count(x => x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT),
         FalseCount = gcs.Count(x => x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False),
         FailCount = gcs.Count(x => x.AlertCategoryId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure),
         PredictiveCount = gcs.Count(x => x.AlertCategoryId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive),


         //1st
         TotalPTFailAlerts = gcs.Count(x =>
            x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure &&
            (x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True ||
             x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT)),

         TotalFailAlerts = gcs.Count(x =>
             x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure &&
             (x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True ||
              x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT || x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False)),


         //2nd
         TotalPTPredictiveAlerts = gcs.Count(x =>
                     x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive &&
            (x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True ||
             x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT)),

         TotalPredictiveAlerts = gcs.Count(x =>
             x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Predictive &&
             (x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True ||
              x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT || x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False)),
         //


         //3rd
         TruePTFailAlertCountRDPMS = gcs.Count(x =>
                     x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure &&
                     x.isManual == 0 &&
                     (x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True ||
                      x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT)),

         TotalActualFailAlertCount = gcs.Count(x =>
              x.AlertTypeId == (int)E7FRSAdvance.Utility.Utility.AlertType.Failure && x.isManual == 1 &&
             (x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True ||
              x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT || x.AcknowledgemenStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False)),
     })
     .OrderBy(x => x.ZoneName)
     .ThenBy(x => x.DivisionName)
     .ThenBy(x => x.SiteName)
     .ToList<dynamic>();
    } }

