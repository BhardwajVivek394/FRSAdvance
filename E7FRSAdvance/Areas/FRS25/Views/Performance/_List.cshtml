    function getPerfTableData() {
        var headers = [
            'Sr.No', 'Zone', 'Division', 'Station', 'Vendor Name',
            '% of (True + Partially True) Failure Alerts out of Total Failure Alerts Generated',
            '% of (True + Partially True) Predictive Alerts out of Total Predictive Alerts Generated',
            '% of (True + Partially True) Failure Alerts by RDPMS out of Total Actual Failures Occurred at Station'
        ];
        // Robust text extraction: strip HTML, collapse whitespace, fallback to innerText
        function cellText(td) {
            var $td = $(td);
            var t = $td.text().trim();
            if (!t) t = (td.innerText || '').trim();
            if (!t) t = $td.html().replace(/<[^>]*>/g, '').trim();
            return t || '—';
        }
        var rows = [];
        $('#tblPerformance tbody tr').each(function () {
            var tds = $(this).find('td');
            if (tds.eq(0).attr('colspan')) return;
            if (tds.length < 7) return;
            rows.push([
                cellText(tds[0]),
                cellText(tds[1]),
                cellText(tds[2]),
                cellText(tds[3]),
                'Energy7',
                cellText(tds[4]),
                cellText(tds[5]),
                cellText(tds[6])
            ]);
        });
        return { headers: headers, rows: rows };
    }

    // Replace the entire perfDownload function
    // Replace the entire perfDownload function
    window.perfDownload = function (type) {
        // Fix 6: Lazy-load ExcelJS on first Excel export
        if (type !== 'csv' && type !== 'pdf' && typeof ExcelJS === 'undefined') {
            ensureExcelJsList(function () { window.perfDownload(type); });
            return;
        }
        var data = getPerfTableData();
        if (data.rows.length === 0) {
            showWarning('No data to download.', 'Download');
            return;
        }
        if (type === 'pdf' && typeof window.jspdf === 'undefined' && typeof window.jsPDF === 'undefined') {
            showError('PDF library not loaded.', 'Error');
            return;
        }
        var fileName = 'PerformanceReport_' + new Date().toISOString().split('T')[0];
        $("#loader").show();

        // All three formats need filter values — fetch once, shared.
        getReportFilterValues(function (fv) {
            try {
                // Derive Zone/Division/Station from actual data when filters say "All" or "Select"
                function isUnset(v) { return !v || v === 'All' || v === 'Select' || v === '--Select--'; }
                if (isUnset(fv.zone) && data.rows.length > 0) {
                    var zones = []; data.rows.forEach(function (r) { if (r[1] && zones.indexOf(r[1]) === -1) zones.push(r[1]); });
                    if (zones.length === 1) fv.zone = zones[0];
                    else if (zones.length > 1) fv.zone = zones.join(', ');
                }
                if (isUnset(fv.division) && data.rows.length > 0) {
                    var divs = []; data.rows.forEach(function (r) { if (r[2] && divs.indexOf(r[2]) === -1) divs.push(r[2]); });
                    if (divs.length === 1) fv.division = divs[0];
                    else if (divs.length > 1) fv.division = divs.join(', ');
                }
                if (isUnset(fv.station) && data.rows.length > 0) {
                    var stns = []; data.rows.forEach(function (r) { if (r[3] && stns.indexOf(r[3]) === -1) stns.push(r[3]); });
                    if (stns.length === 1) fv.station = stns[0];
                    else if (stns.length > 1) fv.station = stns.join(', ');
                }

                var _now = new Date();
                var _date = ('0' + _now.getDate()).slice(-2) + '/' + ('0' + (_now.getMonth() + 1)).slice(-2) + '/' + _now.getFullYear();
                var _time = ('0' + _now.getHours()).slice(-2) + ':' + ('0' + _now.getMinutes()).slice(-2) + ':' + ('0' + _now.getSeconds()).slice(-2);
                var fromDate = $('#txtFromDate').val() || '';
                var toDate = $('#txtToDate').val() || '';

                // ----- CSV -----
                if (type === 'csv') {
                    var esc = function (v) { return '"' + String(v || '').replace(/"/g, '""') + '"'; };
                    var csvLines = [];

                    // Meta header (matches Telemetry History)
                    csvLines.push(esc('Performance Report'));
                    csvLines.push([esc('Zone'), esc(fv.zone || 'All'), esc('Division'), esc(fv.division || 'All'), esc('Station'), esc(fv.station || 'All')].join(','));
                    csvLines.push([esc('Generated Date'), esc(_date + ' ' + _time)].join(','));
                    csvLines.push([esc('Period From'), esc(fromDate), esc('Period To'), esc(toDate)].join(','));
                    csvLines.push('');

                    // Data header + rows
                    csvLines.push(data.headers.map(esc).join(','));
                    data.rows.forEach(function (r) {
                        csvLines.push(r.map(esc).join(','));
                    });

                    var blob = new Blob(['\uFEFF' + csvLines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
                    saveAs(blob, fileName + '.csv');
                }
                // ----- Excel -----
                else if (type === 'excel') {
                    var workbook = new ExcelJS.Workbook();
                    workbook.creator = 'Energy7';
                    var ws = workbook.addWorksheet('Performance Report');
                    ws.columns = [
                        { key: 'a', width: 8 }, { key: 'b', width: 16 }, { key: 'c', width: 20 },
                        { key: 'd', width: 20 }, { key: 'e', width: 18 }, { key: 'f', width: 40 },
                        { key: 'g', width: 40 }, { key: 'h', width: 40 }
                    ];
                    var totalCols = data.headers.length;

                    // Row 1: Title (matches Telemetry History)
                    var r1 = ws.addRow(['Performance Report']);
                    r1.height = 32;
                    ws.mergeCells(1, 1, 1, totalCols);
                    var c1 = r1.getCell(1);
                    c1.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF4338CA' } };
                    c1.font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 15, name: 'Segoe UI' };
                    c1.alignment = { vertical: 'middle', horizontal: 'center' };

                    // Row 2: Filter info
                    var r2txt = 'Zone: ' + (fv.zone || 'All')
                        + '   |   Division: ' + (fv.division || 'All')
                        + '   |   Station: ' + (fv.station || 'All')
                        + '   |   Period: ' + fromDate + ' to ' + toDate
                        + '   |   Generated: ' + _date + ' ' + _time;
                    var r2 = ws.addRow([r2txt]);
                    r2.height = 18;
                    ws.mergeCells(2, 1, 2, totalCols);
                    var c2 = r2.getCell(1);
                    c2.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFEEF2FF' } };
                    c2.font = { italic: true, size: 9, color: { argb: 'FF3730A3' }, name: 'Segoe UI' };
                    c2.alignment = { horizontal: 'center', vertical: 'middle' };

                    // Row 3: Spacer
                    ws.addRow([]).height = 4;

                    // Row 4: Data headers
                    var headerRow = ws.addRow(data.headers);
                    headerRow.eachCell(function (cell) {
                        cell.font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11, name: 'Segoe UI' };
                        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1E3A5F' } };
                        cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
                        cell.border = {
                            bottom: { style: 'thin', color: { argb: 'FF93C5FD' } },
                            right: { style: 'hair', color: { argb: 'FF3B5270' } }
                        };
                    });
                    headerRow.height = 45;
                    ws.views = [{ state: 'frozen', ySplit: 4 }];

                    data.rows.forEach(function (row, idx) {
                        var dataRow = ws.addRow(row);
                        var bgColor = idx % 2 === 0 ? 'FFFFFFFF' : 'FFF8FAFF';
                        dataRow.eachCell(function (cell) {
                            cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgColor } };
                            cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
                        });
                        dataRow.height = 24;
                    });
                    workbook.xlsx.writeBuffer().then(function (buffer) {
                        saveAs(new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), fileName + '.xlsx');
                    });
                }
                // ----- PDF (unchanged — already matches Telemetry History) -----
                else if (type === 'pdf') {
                    var jsPDF = window.jspdf ? window.jspdf.jsPDF : window.jsPDF;
                    var doc = new jsPDF({ orientation: 'landscape', unit: 'mm', format: 'a3' });
                    var pageWidth = doc.internal.pageSize.getWidth();
                    var pageHeight = doc.internal.pageSize.getHeight();
                    var margin = 10;

                    var primaryColor = [67, 56, 202];
                    var headerBg = [15, 43, 76];
                    var accentLine = [96, 165, 250];
                    var textDark = [30, 41, 59];
                    var textMuted = [100, 116, 139];
                    var fixedEven = [232, 240, 254];
                    var fixedOdd = [240, 247, 255];
                    var dataEven = [248, 250, 252];
                    var dataOdd = [255, 255, 255];

                    var headers = data.headers;
                    var body = data.rows;

                    // Title bar
                    doc.setFillColor.apply(doc, primaryColor);
                    doc.rect(margin, margin, pageWidth - 2 * margin, 12, 'F');
                    doc.setFont('helvetica', 'bold');
                    doc.setFontSize(13);
                    doc.setTextColor(255, 255, 255);
                    doc.text('Performance Report', pageWidth / 2, margin + 8, { align: 'center' });

                    // Accent line
                    doc.setDrawColor.apply(doc, accentLine);
                    doc.setLineWidth(0.7);
                    doc.line(margin, margin + 12, pageWidth - margin, margin + 12);

                    // Info row
                    doc.setFillColor(238, 242, 255);
                    doc.rect(margin, margin + 13, pageWidth - 2 * margin, 7, 'F');
                    doc.setFont('helvetica', 'italic');
                    doc.setFontSize(7.5);
                    doc.setTextColor.apply(doc, textMuted);
                    var infoText = 'Zone: ' + fv.zone + '  |  Division: ' + fv.division
                        + '  |  Station: ' + fv.station
                        + '  |  Period: ' + fromDate + ' to ' + toDate
                        + '  |  Generated: ' + _date + ' ' + _time;
                    doc.text(infoText, pageWidth / 2, margin + 17.5, { align: 'center' });

                    // Normalize percentage cells: "-" or "—" → "0%" for clean PDF output
                    var pdfBody = body.map(function (row) {
                        return row.map(function (cell, ci) {
                            if (ci >= 5) { // percentage columns (after Sr.No, Zone, Division, Station, Vendor)
                                var v = String(cell || '').trim();
                                if (v === '-' || v === '—' || v === '' || v === '–') return '0%';
                            }
                            return cell;
                        });
                    });

                    // AutoTable
                    var colCount = headers.length;
                    var fontSize = 8;

                    doc.autoTable({
                        startY: margin + 28,
                        head: [headers],
                        body: pdfBody,
                        theme: 'grid',
                        margin: { left: margin, right: margin, top: margin + 28, bottom: 14 },
                        styles: {
                            fontSize: fontSize,
                            cellPadding: 1.5,
                            lineColor: [226, 232, 240],
                            lineWidth: 0.2,
                            textColor: textDark,
                            font: 'helvetica',
                            overflow: 'linebreak',
                            valign: 'middle'
                        },
                        headStyles: {
                            fillColor: headerBg,
                            textColor: [255, 255, 255],
                            fontStyle: 'bold',
                            halign: 'center',
                            valign: 'middle',
                            fontSize: fontSize,
                            cellPadding: 2,
                            lineColor: [59, 89, 152],
                            lineWidth: 0.3
                        },
                        columnStyles: (function () {
                            var cs = {};
                            var availWidth = pageWidth - 2 * margin;
                            var fixedUsed = 12 + 22 + 28 + 30 + 22; // S.No + Zone + Division + Station + Vendor
                            var percCount = colCount - 5;
                            var percWidth = percCount > 0 ? (availWidth - fixedUsed) / percCount : 50;

                            cs[0] = { halign: 'center', cellWidth: 12 };           // S.No
                            cs[1] = { halign: 'left', fontStyle: 'bold', cellWidth: 22 };  // Zone
                            cs[2] = { halign: 'left', fontStyle: 'bold', cellWidth: 28 };  // Division
                            cs[3] = { halign: 'left', fontStyle: 'bold', cellWidth: 30 };  // Station
                            cs[4] = { halign: 'center', fontStyle: 'bold', cellWidth: 22 }; // Vendor
                            for (var i = 5; i < colCount; i++) {
                                cs[i] = {
                                    halign: 'center',
                                    cellWidth: percWidth,
                                    fontSize: 9,
                                    fontStyle: 'bold'
                                };
                            }
                            return cs;
                        })(),
                        didParseCell: function (data) {
                            if (data.section === 'body') {
                                var isEven = data.row.index % 2 === 0;
                                if (data.column.index < 5) {
                                    data.cell.styles.fillColor = isEven ? fixedEven : fixedOdd;
                                } else {
                                    data.cell.styles.fillColor = isEven ? dataEven : dataOdd;
                                }
                                var val = String(data.cell.raw || '');
                                if (data.column.index >= 5 && val !== '' && !isNaN(val.replace('%', ''))) {
                                    data.cell.styles.halign = 'right';
                                }
                            }
                        },
                        didDrawPage: function (data) {
                            doc.setDrawColor(200, 200, 200);
                            doc.setLineWidth(0.3);
                            doc.line(margin, pageHeight - 10, pageWidth - margin, pageHeight - 10);
                            doc.setFont('helvetica', 'normal');
                            doc.setFontSize(7);
                            doc.setTextColor.apply(doc, textMuted);
                            doc.text('RDPMS — Performance Report', margin, pageHeight - 6);
                            var pageNum = doc.internal.getCurrentPageInfo().pageNumber;
                            doc.text('Page ' + pageNum, pageWidth / 2, pageHeight - 6, { align: 'center' });
                            doc.text(_date + ' ' + _time, pageWidth - margin, pageHeight - 6, { align: 'right' });
                        }
                    });

                    var totalPages = doc.internal.getNumberOfPages();
                    for (var p = 1; p <= totalPages; p++) {
                        doc.setPage(p);
                        doc.setFont('helvetica', 'normal');
                        doc.setFontSize(7);
                        doc.setTextColor.apply(doc, textMuted);
                        doc.setFillColor(255, 255, 255);
                        doc.rect(pageWidth / 2 - 20, pageHeight - 10, 40, 6, 'F');
                        doc.text('Page ' + p + ' of ' + totalPages, pageWidth / 2, pageHeight - 6, { align: 'center' });
                    }

                    doc.save(fileName + '.pdf');
                    showSuccess('PDF downloaded!', 'Download Complete');
                }

            } catch (err) {
                console.error('[Download] Error:', err);
                showError('Failed to download ' + type.toUpperCase() + '.', 'Download Error');
            } finally {
                $("#loader").hide();
            }
        }); // end getReportFilterValues
    };

    // Helper: get filter values (same as Telemetry History)
    function getReportFilterValues(callback) {
        var zoneName = $('#drpZones option:selected').text().trim() || 'All';
        var divisionName = $('#drpDivisions option:selected').text().trim() || 'All';
        var stationName = $('#drpSite option:selected').text().trim() || 'All';
        var assetTypeName = $('#drpAssetType option:selected').text().trim() || 'All';
        var siteId = $('#drpSite').val();

        var values = { zone: zoneName, division: divisionName, station: stationName, vendorName: 'Energy7', assetType: assetTypeName };

        if (siteId && siteId !== '' && siteId !== '0' && (zoneName === 'All' || divisionName === 'All')) {
            $.ajax({
                url: '/FRS25/Performance/GetSiteById?siteId=' + siteId,
                type: 'GET',
                success: function (data) {
                    if (data) {
                        if (zoneName === 'All') values.zone = data.ZoneName || data.Zone || data.ZoneCode || 'All';
                        if (divisionName === 'All') values.division = data.DivisionName || data.Division || data.DivisionCode || 'All';
                        values.station = data.Name || data.SiteName || stationName;
                    }
                    callback(values);
                },
                error: function () { callback(values); }
            });
        } else {
            callback(values);
        }
    }

    // ── Breakup popup: click the icon after each % to see the details ───────────
    (function () {
        // Data pushed from Razor: { "<StationName>": [ {assetName, cause, setTime, resetTime, feedback, maintainerName, alertCat, ackStatus, isManual}, ... ] }
        window.perfBreakupData = @Html.Raw(perfBreakupJson);

        // Column-type -> title used in the popup header
        var colTitleMap = {
            failure: '% of (True + Partially True) Failure Alerts out of Total Failure Alerts Generated',
            predictive: '% of (True + Partially True) Predictive Alerts out of Total Predictive Alerts Generated',
            rdpms: '% of (True + Partially True) Failure Alerts by RDPMS out of Total Actual Failures Occurred at Station'
        };

        // Acknowledgement status IDs (match E7FRSAdvance.Utility.Utility.AcknowledgemenStatus)
        var ACK_TRUE = @((int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True);
        var ACK_PT   = @((int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT);
        var ACK_FALSE = @((int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False);

        // Alert category IDs
        var CAT_FAILURE   = @((int)E7FRSAdvance.Utility.Utility.AlertType.Failure);
        var CAT_PREDICTIVE = @((int)E7FRSAdvance.Utility.Utility.AlertType.Predictive);

        // Filter rows for a given column
        function filterRows(rows, col) {
            if (!rows || !rows.length) return [];
            if (col === 'failure') {
                return rows.filter(function (r) {
                    return r.alertCat === CAT_FAILURE && r.isManual === 0
                        && (r.ackStatus === ACK_TRUE || r.ackStatus === ACK_PT || r.ackStatus === ACK_FALSE);
                });
            }
            if (col === 'predictive') {
                return rows.filter(function (r) {
                    return r.alertCat === CAT_PREDICTIVE && r.isManual === 0
                        && (r.ackStatus === ACK_TRUE || r.ackStatus === ACK_PT || r.ackStatus === ACK_FALSE);
                });
            }
            if (col === 'rdpms') {
                // Denominator of the RDPMS column = all actual failures with True or PT
                // (manual + non-manual). Numerator = the subset with isManual = 0.
                return rows.filter(function (r) {
                    return r.alertCat === CAT_FAILURE
                        && (r.ackStatus === ACK_TRUE || r.ackStatus === ACK_PT);
                });
            }
            return [];
        }

        function ackBadge(id) {
            if (id === ACK_TRUE)  return '<span class="status-badge status-t">T</span>';
            if (id === ACK_PT)    return '<span class="status-badge status-pt">PT</span>';
            if (id === ACK_FALSE) return '<span class="status-badge status-f">F</span>';
            return '<span class="status-badge status-na">-</span>';
        }

        function esc(s) {
            if (s === null || s === undefined) return '';
            return String(s)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function openBreakup(station, col, pct) {
            var rows = filterRows((window.perfBreakupData || {})[station] || [], col);

            var total = rows.length;
            var t  = rows.filter(function (r) { return r.ackStatus === ACK_TRUE;  }).length;
            var pt = rows.filter(function (r) { return r.ackStatus === ACK_PT;    }).length;
            var f  = rows.filter(function (r) { return r.ackStatus === ACK_FALSE; }).length;

            // The RDPMS column measures actual failures at the station, so False
            // alerts never enter this set (see filterRows) and the F tile would
            // always read 0. The meaningful figure there is "Missed": every
            // manually logged failure, i.e. the ones RDPMS did not raise itself.
            // Those manual rows carry their own T/PT feedback, but they are not
            // RDPMS detections, so they are excluded from the T and PT tiles --
            // which keeps Total = T + PT + Missed and makes the tiles agree with
            // the percentage (numerator = RDPMS T + PT only).
            var isRdpms = (col === 'rdpms');
            var missed = rows.filter(function (r) { return r.isManual === 1; }).length;
            var tRdpms  = rows.filter(function (r) { return r.ackStatus === ACK_TRUE && r.isManual === 0; }).length;
            var ptRdpms = rows.filter(function (r) { return r.ackStatus === ACK_PT   && r.isManual === 0; }).length;

            $('#perfBreakupTitle').text(colTitleMap[col] || 'Break up');
            $('#perfBreakupStation').text(station || '-');
            $('#perfBreakupPct').text((pct !== undefined && pct !== null && pct !== '') ? (pct + '%') : '-');
            $('#perfBreakupTotal').text(total);
            $('#perfBreakupT').text(isRdpms ? tRdpms : t);
            $('#perfBreakupPT').text(isRdpms ? ptRdpms : pt);
            $('#perfBreakupFLabel').text(isRdpms ? 'Missed' : 'False (F)');
            $('#perfBreakupF').text(isRdpms ? missed : f);

            var $body = $('#perfBreakupTbody').empty();
            if (!rows.length) {
                var emptySpan = (col === 'rdpms') ? 9 : 8;
                $body.append('<tr><td colspan="' + emptySpan + '" class="text-center text-muted py-3">No records</td></tr>');
            } else {
                rows.forEach(function (r, i) {
                    var src = (col === 'rdpms')
                        ? (r.isManual === 0 ? '<span class="src-badge src-rdpms">RDPMS</span>'
                                            : '<span class="src-badge src-manual">Manual</span>')
                        : '';
                    var srcCell = (col === 'rdpms') ? ('<td class="text-center">' + src + '</td>') : '';
                    $body.append(
                        '<tr>' +
                            '<td class="text-center col-sno">' + (i + 1) + '</td>' +
                            '<td>' + esc(r.assetName) + '</td>' +
                            '<td>' + esc(r.cause) + '</td>' +
                            '<td class="text-center">' + esc(r.setTime) + '</td>' +
                            '<td class="text-center">' + esc(r.resetTime) + '</td>' +
                            '<td class="text-center">' + ackBadge(r.ackStatus) + '</td>' +
                            '<td>' + esc(r.feedback) + '</td>' +
                            '<td>' + esc(r.maintainerName) + '</td>' +
                            srcCell +
                        '</tr>'
                    );
                });
            }

            // Show/hide "Source" column depending on the column-type
            if (col === 'rdpms') {
                $('#perfBreakupSourceHead').show();
            } else {
                $('#perfBreakupSourceHead').hide();
            }

            showBreakupModal();
        }

        // The popup markup is rendered inside #divTableContainer, which the theme
        // styles with a low z-index (position:relative; z-index:1). The search
        // filter section sits at z-index:100, so anything left inside that
        // container paints UNDER the filters. Moving the backdrop + modal to be
        // direct children of <body> lifts them out of that trapped stacking
        // context so their own z-index actually wins.
        function ensureBreakupInBody() {
            var modal = document.getElementById('perfBreakupModal');
            var backdrop = document.getElementById('perfBreakupBackdrop');
            if (!modal) return;

            // A fresh partial load re-injects this markup, so a copy from a
            // previous load may still be parked on <body>. Remove those stale
            // duplicates before parking the current one, to avoid dup IDs.
            document.querySelectorAll('#perfBreakupModal').forEach(function (m) {
                if (m !== modal && m.parentElement === document.body) { m.parentNode.removeChild(m); }
            });
            document.querySelectorAll('#perfBreakupBackdrop').forEach(function (b) {
                if (b !== backdrop && b.parentElement === document.body) { b.parentNode.removeChild(b); }
            });

            if (backdrop && backdrop.parentElement !== document.body) {
                document.body.appendChild(backdrop);
            }
            if (modal && modal.parentElement !== document.body) {
                document.body.appendChild(modal);
            }
        }

        function showBreakupModal() {
            ensureBreakupInBody();
            $('#perfBreakupBackdrop').css('display', 'block');
            $('#perfBreakupModal').addClass('show').attr('aria-hidden', 'false');
            $('body').addClass('perf-breakup-open');
        }
        function hideBreakupModal() {
            $('#perfBreakupBackdrop').css('display', 'none');
            $('#perfBreakupModal').removeClass('show').attr('aria-hidden', 'true');
            $('body').removeClass('perf-breakup-open');
        }

        // Wire up clicks on the break-up icons (delegated so it survives pagination)
        $(document).off('click.perfBreakup', '.perf-breakup-btn')
                   .on('click.perfBreakup', '.perf-breakup-btn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var $b = $(this);
            openBreakup($b.data('station'), $b.data('col'), $b.data('pct'));
        });

        // Close handlers – backdrop click, [x] button, footer Close, Esc
        $(document).off('click.perfBreakupClose', '[data-breakup-close]')
                   .on('click.perfBreakupClose', '[data-breakup-close]', function (e) {
            e.preventDefault();
            hideBreakupModal();
        });
        $(document).off('click.perfBreakupBackdrop', '#perfBreakupBackdrop')
                   .on('click.perfBreakupBackdrop', '#perfBreakupBackdrop', function () {
            hideBreakupModal();
        });
        $(document).off('keydown.perfBreakupEsc')
                   .on('keydown.perfBreakupEsc', function (e) {
            if (e.key === 'Escape' && $('#perfBreakupModal').hasClass('show')) {
                hideBreakupModal();
            }
        });
    })();
</script>

