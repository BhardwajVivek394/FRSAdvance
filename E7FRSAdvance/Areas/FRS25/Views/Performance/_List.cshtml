<script>
    (function () {
        var rowsPerPage = 10;
        var $table = $('#tblPerformance');
        var $rows = $table.find('tbody tr');
        var totalRows = $rows.length;
        var totalPages = Math.ceil(totalRows / rowsPerPage);
        var currentPage = 1;

        // Check if we have data rows (not "no data" row)
        if (totalRows === 1 && $rows.first().find('td[colspan]').length > 0) {
            // No data row - hide pagination
            $('#paginationInfo').parent().hide();
        } else if (totalRows > 0) {
            showPage(1);
        }

        function showPage(page) {
            if (page < 1) page = 1;
            if (page > totalPages) page = totalPages;
            currentPage = page;

            var start = (page - 1) * rowsPerPage;
            var end = start + rowsPerPage;

            $rows.hide();
            $rows.slice(start, end).show();

            var showEnd = Math.min(end, totalRows);
            $('#showingFrom').text(totalRows > 0 ? start + 1 : 0);
            $('#showingTo').text(showEnd);

            renderPagination();
        }

        function renderPagination() {
            var $pager = $('#pager');
            $pager.find('.page-number').remove();

            if (currentPage <= 1) {
                $('#prevBtn').addClass('disabled');
            } else {
                $('#prevBtn').removeClass('disabled');
            }

            if (currentPage >= totalPages) {
                $('#nextBtn').addClass('disabled');
            } else {
                $('#nextBtn').removeClass('disabled');
            }

            var $nextBtn = $('#nextBtn');
            var pagesToShow = [];

            if (totalPages <= 7) {
                for (var i = 1; i <= totalPages; i++) {
                    pagesToShow.push(i);
                }
            } else {
                pagesToShow.push(1);
                if (currentPage > 3) pagesToShow.push('...');
                for (var i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
                    if (pagesToShow.indexOf(i) === -1 && i !== '...') pagesToShow.push(i);
                }
                if (currentPage < totalPages - 2) pagesToShow.push('...');
                if (pagesToShow.indexOf(totalPages) === -1) pagesToShow.push(totalPages);
            }

            for (var j = 0; j < pagesToShow.length; j++) {
                var p = pagesToShow[j];
                var $li;
                if (p === '...') {
                    $li = $('<li class="page-item page-number disabled"><span class="page-link">...</span></li>');
                } else {
                    var activeClass = (p === currentPage) ? 'active' : '';
                    $li = $('<li class="page-item page-number ' + activeClass + '">' +
                        '<a class="page-link" href="javascript:void(0);" onclick="goToPage(' + p + ')">' + p + '</a></li>');
                }
                $li.insertBefore($nextBtn);
            }
        }

        window.changePage = function (direction) {
            if (direction === 'prev' && currentPage > 1) {
                showPage(currentPage - 1);
            } else if (direction === 'next' && currentPage < totalPages) {
                showPage(currentPage + 1);
            }
        };

        window.goToPage = function (page) {
            showPage(page);
        };
    })();

    // ── Download dropdown toggle ──────────────────────────────────────
    window.togglePerfDlMenu = function (e) {
        e.stopPropagation();
        document.getElementById('perfDlMenu').classList.toggle('open');
    };
    document.addEventListener('click', function () {
        var m = document.getElementById('perfDlMenu');
        if (m) m.classList.remove('open');
    });

    // ── Collect table data ────────────────────────────────────────────
    function getPerfTableData() {
        var headers = [
            'Sr.No', 'Zone', 'Division', 'Station',
            '% Failure Alerts (True+PT) / Total Failure',
            '% Predictive Alerts (True+PT) / Total Predictive',
            '% RDPMS Failure / Total Actual Failures'
        ];
        var rows = [];
        $('#tblPerformance tbody tr').each(function () {
            var tds = $(this).find('td');
            if (tds.eq(0).attr('colspan')) return;
            rows.push([
                tds.eq(0).text().trim(),
                tds.eq(1).text().trim(),
                tds.eq(2).text().trim(),
                tds.eq(3).text().trim(),
                tds.eq(4).text().trim(),
                tds.eq(5).text().trim(),
                tds.eq(6).text().trim()
            ]);
        });
        return { headers: headers, rows: rows };
    }

    // ── Main download function ────────────────────────────────────────
    window.perfDownload = function (type) {
        var data = getPerfTableData();
        if (data.rows.length === 0) {
            alert('No data to download.');
            return;
        }

        var fileName = 'PerformanceReport_' + new Date().toISOString().split('T')[0];

        if (type === 'csv') {
            // ── CSV ──────────────────────────────────────────────────
            var allRows = [data.headers].concat(data.rows);
            var csv = allRows.map(function (r) {
                return r.map(function (c) {
                    return '"' + String(c || '').replace(/"/g, '""') + '"';
                }).join(',');
            }).join('\r\n');

            var blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
            saveAs(blob, fileName + '.csv');

        } else {
            // ── Excel via ExcelJS ────────────────────────────────────
            var workbook = new ExcelJS.Workbook();
            workbook.creator = 'Energy7';
            workbook.created = new Date();

            var worksheet = workbook.addWorksheet('Performance Report');

            // Column widths
            worksheet.columns = [
                { key: 'a', width: 8 },
                { key: 'b', width: 16 },
                { key: 'c', width: 20 },
                { key: 'd', width: 20 },
                { key: 'e', width: 36 },
                { key: 'f', width: 36 },
                { key: 'g', width: 36 }
            ];

            // Header row
            var headerRow = worksheet.addRow(data.headers);
            headerRow.eachCell(function (cell) {
                cell.font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11 };
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1A2D5A' } };
                cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
                cell.border = {
                    top: { style: 'thin', color: { argb: 'FFB0B8D1' } },
                    left: { style: 'thin', color: { argb: 'FFB0B8D1' } },
                    bottom: { style: 'thin', color: { argb: 'FFB0B8D1' } },
                    right: { style: 'thin', color: { argb: 'FFB0B8D1' } }
                };
            });
            headerRow.height = 40;

            // Data rows
            data.rows.forEach(function (row, idx) {
                var dataRow = worksheet.addRow(row);
                var bgColor = idx % 2 === 0 ? 'FFFFFFFF' : 'FFF8FAFF';
                dataRow.eachCell(function (cell) {
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: bgColor } };
                    cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
                    cell.border = {
                        top: { style: 'thin', color: { argb: 'FFEDF0F8' } },
                        left: { style: 'thin', color: { argb: 'FFEDF0F8' } },
                        bottom: { style: 'thin', color: { argb: 'FFEDF0F8' } },
                        right: { style: 'thin', color: { argb: 'FFEDF0F8' } }
                    };
                });
                // Left-align text columns
                dataRow.getCell(1).alignment = { vertical: 'middle', horizontal: 'center' };
                dataRow.getCell(2).alignment = { vertical: 'middle', horizontal: 'left' };
                dataRow.getCell(3).alignment = { vertical: 'middle', horizontal: 'left' };
                dataRow.getCell(4).alignment = { vertical: 'middle', horizontal: 'left' };
                dataRow.height = 22;
            });

            workbook.xlsx.writeBuffer().then(function (buffer) {
                var blob = new Blob([buffer], {
                    type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                });
                saveAs(blob, fileName + '.xlsx');
            });
        }
    };
</script>
