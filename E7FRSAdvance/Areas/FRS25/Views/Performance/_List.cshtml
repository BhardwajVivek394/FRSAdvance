<!-- Fix 6: exceljs + FileSaver loaded lazily on first export click -->
<script>
    var _excelJsLoadedList = false;
    function ensureExcelJsList(callback) {
        if (_excelJsLoadedList || typeof ExcelJS !== 'undefined') { _excelJsLoadedList = true; callback(); return; }
        var s1 = document.createElement('script');
        s1.src = 'https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js';
        s1.onload = function () {
            var s2 = document.createElement('script');
            s2.src = 'https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js';
            s2.onload = function () { _excelJsLoadedList = true; callback(); };
            document.head.appendChild(s2);
        };
        document.head.appendChild(s1);
    }
</script>

