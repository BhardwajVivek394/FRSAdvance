    // -- Open Edit Modal: loads cause codes + pre-selects via GET API --
    function vfOpenEditModal(row) {
        var today = new Date().toISOString().split('T')[0];

        // Use <tr> data-* attrs — more reliable than list API response fields
        var $tr         = $('[data-id="' + row.Id + '"]').closest('tr');
        var siteId      = parseInt($tr.data('site-id'))      || parseInt(row.SiteId)      || 0;
        var assetTypeId = parseInt($tr.data('assettype-id')) || parseInt(row.AssetTypeId) || 0;
        // Fallback: if list API didn't return AssetTypeId, resolve from AssetType string
        if (assetTypeId === 0 && row.AssetType) {
            assetTypeId = afResolveAssetTypeId(row.AssetType);
        }
        var assetId     = parseInt($tr.data('asset-id'))     || parseInt(row.AssetId)     || 0;

        // Populate static fields immediately
        $('#ef_Id').val(row.Id);
        $('#ef_SiteId').val(siteId);
        $('#ef_AssetTypeId').val(assetTypeId);
        $('#ef_AssetId').val(assetId);
        $('#ef_StationName').text(row.StationName || '—');
        $('#ef_AssetType').text(row.AssetType     || '—');
        $('#ef_AssetNo').text(row.AssetNo         || '—');

        // Populate Incidence & Rectification date inputs (date only — strip time part)
        var incidenceFull = vfBuildDateTimeLocal(
            row.FromDateTime, row.FailureDateFrom, row.FailureTimeFrom
        );
        $('#ef_IncidenceDateTime').val(incidenceFull ? incidenceFull.split('T')[0] : '')
                                  .attr('max', today);

        // Rectification may be empty for RDPMS-generated records — that is OK
        var rectFull = vfBuildDateTimeLocal(row.ToDateTime, row.FailureDateTo, row.FailureTimeTo);
        // Also check the new RectificationDateTime field if API returns it
        if (!rectFull && row.RectificationDateTime) {
            rectFull = vfBuildDateTimeLocal(row.RectificationDateTime, null, null);
        }
        $('#ef_RectificationDateTime').val(rectFull ? rectFull.split('T')[0] : '')
                                      .attr('max', today);

        $('#ef_Remark').val(row.Remark             || '');

        // Show modal immediately
        $('#ef_CauseCode').html('<option value="0">Loading...</option>').prop('disabled', true);
        $('#modal-vfEdit').modal('show');

        // Step 1: Load all cause codes for this asset type (same API as Add tab)
        afLoadCauseCodes(assetTypeId, function (list) {
            if (!list || list.length === 0) {
                $('#ef_CauseCode').html('<option value="0">-- No cause codes for this asset type --</option>').prop('disabled', false);
                return;
            }
            $('#ef_CauseCode').html(afBuildCauseCodeOptions(list)).prop('disabled', false);

            // Step 2: Fetch the saved record to get exact AlertInfoId
            $.ajax({
                url: '/FRS25/Performance/Get',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ Id: row.Id }),
                success: function (record) {
                    // ── Always update SiteId & AssetId from GET response ──
                    // The list API often does not return these — GET API always does
                    if (record && record.SiteId  && parseInt(record.SiteId)  > 0) {
                        $('#ef_SiteId').val(parseInt(record.SiteId));
                    }
                    if (record && record.AssetId && parseInt(record.AssetId) > 0) {
                        $('#ef_AssetId').val(parseInt(record.AssetId));
                    }

                    // ── Pre-select CauseCode ──
                    var alertInfoId = (record && record.AlertInfoId) ? parseInt(record.AlertInfoId) : 0;
                    if (alertInfoId > 0) {
                        $('#ef_CauseCode').val(alertInfoId);
                    }
                    // Fallback: match by CauseCode name if direct val didn't stick
                    if (!$('#ef_CauseCode').val() || parseInt($('#ef_CauseCode').val()) === 0) {
                        var nameToMatch = (record && record.CauseCode) ? record.CauseCode.trim().toLowerCase()
                                                                       : (row.CauseCode || '').trim().toLowerCase();
                        $('#ef_CauseCode option').each(function () {
                            if ($(this).text().trim().toLowerCase() === nameToMatch ||
                                $(this).data('code') === nameToMatch) {
                                $(this).prop('selected', true);
                                return false;
                            }
                        });
                    }
                    if (record && record.Remark) { $('#ef_Remark').val(record.Remark); }
                },
                error: function () {
                    // GET failed — fallback to name match from list data
                    var nameToMatch = (row.CauseCode || '').trim().toLowerCase();
                    if (nameToMatch) {
                        $('#ef_CauseCode option').each(function () {
                            if ($(this).text().trim().toLowerCase() === nameToMatch) {
                                $(this).prop('selected', true);
                                return false;
                            }
                        });
                    }
                    showInfo('Could not verify saved cause code — please confirm selection.', 'Info');
                }
            });
        });
    }

    // ── Save Edit (Update) ───────────────────────────────────────────
    function vfSaveEdit() {
        var id = parseInt($('#ef_Id').val()) || 0;
        var siteId = parseInt($('#ef_SiteId').val()) || 0;
        var assetTypeId = parseInt($('#ef_AssetTypeId').val()) || 0;
        var assetId = parseInt($('#ef_AssetId').val()) || 0;
        var incidenceDate = $('#ef_IncidenceDateTime').val() || '';
        var incidenceTime = $('#ef_IncidenceTime').val() || '00:00';
        var rectificationDate = $('#ef_RectificationDateTime').val() || '';
        var rectificationTime = $('#ef_RectificationTime').val() || '23:59';
        var alertInfoId = parseInt($('#ef_CauseCode').val()) || 0;
        var causeCode = $('#ef_CauseCode option:selected').data('code') || '';
        var remark = $('#ef_Remark').val();

        function buildDateTime(date, time) {
            if (!date) return '';
            return date + ' ' + time + ':00';
        }
        var incidenceDT = buildDateTime(incidenceDate, incidenceTime);
        var rectificationDT = buildDateTime(rectificationDate, rectificationTime);

        if (!incidenceDate) { showWarning('Incidence Date is required.', 'Validation'); return; }
        if (alertInfoId === 0) { showWarning('Cause Code is required.', 'Validation'); return; }

        if (rectificationDate) {
            var incFull = new Date(incidenceDate + 'T' + incidenceTime);
            var recFull = new Date(rectificationDate + 'T' + rectificationTime);
            if (recFull < incFull) {
                showWarning('Rectification Date/Time cannot be earlier than Incidence Date/Time.', 'Validation');
                return;
            }
        }

        var dateFrom = incidenceDate;
        var dateTo = rectificationDate;
        var timeFrom = incidenceTime;
        var timeTo = rectificationTime;

        $('#loader').show();
        $.ajax({
            url: '/FRS25/Performance/UpdateActualFailure',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                Id: id,
                SiteId: siteId,
                AssetTypeId: assetTypeId,
                AssetId: assetId,
                DateFrom: dateFrom,
                DateTo: dateTo,
                TimeFrom: timeFrom,
                TimeTo: timeTo,
                FromDateTime: incidenceDT,
                RectificationDateTime: rectificationDT,
                AlertInfoId: alertInfoId,
                CauseCode: causeCode,
                Remark: remark || ''
            }),
            success: function (response) {
                $('#loader').hide();
                if (response && response.IsSuccess) {
                    $('#modal-vfEdit').modal('hide');
                    showSuccess('Record updated successfully!', 'Success');
                    vfLoadList();
                } else {
                    showError((response && response.Message) || 'Update failed.', 'Error');
                }
            },
            error: function () { $('#loader').hide(); showError('Something went wrong.', 'Error'); }
        });
    }
    // ── Soft Delete ─────────────────────────────────────────────────
    function vfDelete(id) {
        afConfirm('Are you sure you want to delete this failure record?', 'Delete Record', function () {
        $('#loader').show();
        $.ajax({
            url: '/FRS25/Performance/DeleteActualFailure',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ Id: id }),
            success: function (response) {
                $('#loader').hide();
                if (response && response.IsSuccess) {
                    showSuccess('Record deleted successfully.', 'Success');
                    vfLoadList();
                } else {
                    showError((response && response.Message) || 'Delete failed.', 'Error');
                }
            },
            error: function () { $('#loader').hide(); showError('Delete failed.', 'Error'); }
        });
        }); // end afConfirm
    }

    // ================================================================
    //  DISABLE FUTURE DATES — edit modal date inputs
    //  (Add-tab row inputs already get max=today baked into the HTML
    //   at build time inside afAddToTable)
    // ================================================================
    $('#modal-ActualFailureEntry').on('show.bs.modal', function () {
        var today = new Date().toISOString().split('T')[0];
        $('#ef_IncidenceDateTime, #ef_RectificationDateTime').attr('max', today);
    });
</script>
