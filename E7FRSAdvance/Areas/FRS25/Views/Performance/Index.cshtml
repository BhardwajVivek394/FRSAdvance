    /** Save ALL new unsaved rows at once */
    function afSaveAll() {
        var rows = [];
        var valid = true;
        $('#vf_ListBody tr[data-new-row]').each(function () {
            var idx = parseInt($(this).data('idx'));
            var payload = afBuildRowPayload(idx);
            if (!payload) { valid = false; return false; }
            rows.push(payload);
        });
        if (!valid || rows.length === 0) return;
        afCallSaveAPI(rows, function () {
            showSuccess('All ' + rows.length + ' failure(s) saved successfully!', 'Success');
            $('#vf_ListBody tr[data-new-row]').remove();
            afNewRowCount = 0;
            $('#btnSaveAllFailures').hide();
            vfLoadList();   // reload saved list
        });
    }
    function afBuildRowPayload(idx) {
        var $row = $('#af_row_' + idx);
        var incidenceDate     = $('#af_incidenceDT_'     + idx).val() || '';   // yyyy-MM-dd
        var rectificationDate = $('#af_rectificationDT_' + idx).val() || '';   // yyyy-MM-dd (optional)
        var assetNoId = $('#af_assetNo_' + idx).val();
        if (assetNoId && assetNoId !== '0') $row.data('assetno-id', assetNoId);
        var $causeSelect = $('#af_causeCode_' + idx);
        var alertInfoId = parseInt($causeSelect.val()) || 0;
        var causeCode   = $causeSelect.find('option:selected').data('code') || '';
        var remark      = $('#af_remark_' + idx).val();

        // Build full datetime strings (time defaults to 00:00)
        var incidenceDT     = incidenceDate     ? incidenceDate     + 'T00:00' : '';
        var rectificationDT = rectificationDate ? rectificationDate + 'T00:00' : '';

        // ── Validation ──────────────────────────────────────────────────
        if (!incidenceDate) {
            showWarning('Row ' + idx + ': Incidence Date is required.', 'Validation');
            return null;
        }
        if (alertInfoId === 0) {
            showWarning('Row ' + idx + ': Cause Code is required.', 'Validation');
            return null;
        }
        if (rectificationDate && rectificationDate < incidenceDate) {
            showWarning('Row ' + idx + ': Rectification Date cannot be earlier than Incidence Date.', 'Validation');
            return null;
        }

        // Keep legacy split fields for backward compat
        var dateFrom = incidenceDate;
        var dateTo   = rectificationDate;
        var timeFrom = '';
        var timeTo   = '';

        return {
            Id:           parseInt($row.data('id'))           || 0,   // 0 = INSERT, >0 = UPDATE
            RowNo:        idx,
            SiteId:       parseInt($row.data('station-id'))   || 0,
            AssetTypeId:  parseInt($row.data('assettype-id')) || 0,
            AssetId:      parseInt($row.data('assetno-id'))   || 0,
            DateFrom:     dateFrom,
            DateTo:       dateTo,
            TimeFrom:     timeFrom       || '',
            TimeTo:       timeTo         || '',
            FromDateTime:         incidenceDT,               // ← Incidence Date & Time → FromDateTime column
            RectificationDateTime: rectificationDT || '',      // ← Rectification Date & Time → RectificationDateTime column
            AlertInfoId:  alertInfoId,   // ← integer FK required by API
            CauseCode:    causeCode,     // ← display string (e.g. "EC")
            Remark:       remark         || ''
        };
    }

    /** Extract a clean, human-readable message from whatever the API returns.
     *  Handles: plain strings, "API error: Conflict – {...json...}", raw JSON objects/strings. */
    function afCleanMsg(raw) {
        if (!raw) return null;
        var s = String(raw).trim();
        // Strip server prefix e.g. "API error: Conflict – "
        s = s.replace(/^API\s+error\s*:[^–—-]*[–—-]\s*/i, '').trim();
        // Extract Message field if JSON
        if (s.charAt(0) === '{') {
            try { var obj = JSON.parse(s); if (obj && obj.Message) s = String(obj.Message).trim(); } catch (e) {}
        }
        // Map verbose server messages → short user-friendly messages
        if (/duplicate/i.test(s))               return 'Duplicate entry — record already exists for this date range.';
        if (/not found/i.test(s))               return 'Record not found. It may have been deleted.';
        if (/unauthorized|forbidden/i.test(s))  return 'Access denied. Please contact your administrator.';
        if (/timeout|timed out/i.test(s))        return 'Request timed out. Please try again.';
        if (/invalid|bad request/i.test(s))     return 'Invalid data. Please check your entries and try again.';
        if (/conflict/i.test(s))                return 'Conflict — this record overlaps with an existing entry.';
        return s || null;
    }

    function afCallSaveAPI(rows, onSuccess) {
        $('#loader').show();
        $.ajax({
            url: '/FRS25/Performance/SaveActualFailures',
            type: 'POST',
            data: JSON.stringify({ Failures: rows }),
            contentType: 'application/json',
            success: function (response) {
                $('#loader').hide();
                if (response && response.IsSuccess) {
                    // ✅ Do NOT show a toast here — the onSuccess callback is
                    //    responsible for showing its own message (prevents double toasts).
                    if (typeof onSuccess === 'function') onSuccess(response);
                } else {
                    var raw = (response && response.Message) ? response.Message : '';
                    var msg = afCleanMsg(raw) || 'Save failed. Please try again.';
                    showError(msg, 'Error');
                }
            },
            error: function (xhr) {
                $('#loader').hide();
                var msg = 'Something went wrong while saving.';
                try {
                    // xhr.responseText may be plain JSON or "API error: X – {json}"
                    var cleaned = afCleanMsg(xhr.responseText);
                    if (cleaned) msg = cleaned;
                } catch (e) {}
                showError(msg, 'Error');
            }
        });
    }

