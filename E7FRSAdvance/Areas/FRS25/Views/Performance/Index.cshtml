    // Fallback: resolve AssetTypeId integer from AssetType string e.g. "TRACK" -> 1
    function afResolveAssetTypeId(assetTypeStr) {
        if (!assetTypeStr) return 0;
        var resolved = 0;
        $('#af_AssetType option').each(function () {
            if ($(this).text().trim().toUpperCase() === assetTypeStr.trim().toUpperCase()) {
                resolved = parseInt($(this).val()) || 0;
                return false;
            }
        });
        return resolved;
    }

    function afLoadCauseCodes(assetTypeId, callback) {
        var key = String(assetTypeId || 0);

        // Only use cache if it contains REAL API data (flagged by .fromApi)
        if (afCauseCodeCache[key] && afCauseCodeCache[key].fromApi) {
            if (typeof callback === 'function') callback(afCauseCodeCache[key].list);
            return;
        }

        $.ajax({
            url: '/FRS25/AlertDetailReport/GetAlertInfo', type: 'POST', contentType: 'application/json',
            data: JSON.stringify({ AssetTypeId: assetTypeId }),
            success: function (data) {
                if (data && data.length > 0) {
                    // Normalise: API may return Id/Code/Name OR Id/AlertCode/AlertName OR Id/Title etc.
                    var list = $.map(data, function (c) {
                        return {
                            Id:   c.Id   || c.id   || 0,
                            Code: c.Code || c.AlertCode || c.ShortName || c.code || '',
                            Name: c.Name || c.AlertName || c.Title     || c.name || ''
                        };
                    });
                    afCauseCodeCache[key] = { fromApi: true, list: list };
                    if (typeof callback === 'function') callback(list);
                } else {
                    // API returned empty — do NOT cache, do NOT use fallback
                    showInfo('No cause codes found for this asset type.', 'Cause Code');
                    if (typeof callback === 'function') callback([]);
                }
            },
            error: function (xhr) {
                // API failed — do NOT cache fallback data
                var msg = 'Could not load cause codes from server.';
                try { var e = JSON.parse(xhr.responseText); if (e && e.Message) msg = e.Message; } catch(ex) {}
                showError(msg, 'Cause Code');
                if (typeof callback === 'function') callback([]);
            }
        });
    }
    function afBuildCauseCodeOptions(list) {
        var html = '<option value="0" data-code="">-- Select --</option>';
        $.each(list || [], function (i, c) {
            html += '<option value="' + c.Id + '" data-code="' + c.Code + '">' + c.Name + '</option>';
        });
        return html;
    }

