    function fnLoadTableView(mAssetLister) {
        $("#loader").show();
        $('#divTableContainer').show();
        $('#divChartContainer').hide();

        // Destroy existing chart
        if (performanceChart != null) {
            performanceChart.destroy();
            performanceChart = null;
        }

        $.ajax({
            url: '/FRS25/Performance/_List',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();
                $("#divTableContainer").empty().append(data);
