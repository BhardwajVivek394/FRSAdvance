<script>
    var openDropdown = null;
    var selectedViewType = 'Table';
    var performanceChart = null;

    // ================================================================
    //  DATETIME HELPERS
    // ================================================================

    /**
     * Build a datetime-local string (yyyy-MM-ddTHH:mm) from multiple possible
     * sources. Priority:
     *   1. row.FromDateTime / row.ToDateTime  (ISO or "yyyy-MM-dd HH:mm:ss")
     *   2. separate date + time fields       (row.FailureDateFrom + FailureTimeFrom)
     *   3. empty string if nothing available
     */
    function vfBuildDateTimeLocal(isoDateTime, datePart, timePart) {
        // ── 1. Try combined ISO / SQL datetime string ──────────────────
        if (isoDateTime && isoDateTime !== '0001-01-01T00:00:00' &&
            isoDateTime !== '0001-01-01 00:00:00' && isoDateTime !== '01/01/0001 00:00:00') {
            // Handle formats:  "2025-06-10T14:30:00"  or  "2025-06-10 14:30:00"
            var s = String(isoDateTime).replace(' ', 'T');
            if (s.indexOf('T') !== -1) {
                // Slice to "yyyy-MM-ddTHH:mm" (drop seconds / timezone)
                return s.substring(0, 16);
            }
        }

        // ── 2. Try separate date + time parts ─────────────────────────
        // datePart may arrive as "dd/MM/yyyy", "yyyy-MM-dd", or "dd-MM-yyyy"
        if (datePart && datePart.trim()) {
            var dNorm = vfNormalizeDate(datePart.trim());   // → yyyy-MM-dd
            if (dNorm) {
                var tNorm = (timePart || '').trim().substring(0, 5); // HH:mm
                return dNorm + 'T' + (tNorm || '00:00');
            }
        }

        return '';
    }

    /**
     * Normalise various date formats to yyyy-MM-dd.
     * Accepts: dd/MM/yyyy | dd-MM-yyyy | yyyy-MM-dd
     */
    function vfNormalizeDate(d) {
        if (!d) return '';
        // dd/MM/yyyy  or  dd-MM-yyyy
        var m = d.match(/^(\d{2})[\/\-](\d{2})[\/\-](\d{4})$/);
        if (m) return m[3] + '-' + m[2] + '-' + m[1];
        // yyyy-MM-dd  (already correct)
        if (/^\d{4}-\d{2}-\d{2}$/.test(d)) return d;
        return '';
    }

    /**
     * Format a datetime for table cell display.
     * Shows "dd/MM/yyyy HH:mm" or "–" if unavailable / min-date.
     */
    function vfFmtDT(isoDateTime, datePart, timePart) {
        var local = vfBuildDateTimeLocal(isoDateTime, datePart, timePart);
        if (!local) return '<span style="color:var(--e7-text-3, #94a3b8);">–</span>';
        // local = "yyyy-MM-ddTHH:mm"
        var parts = local.split('T');
        var dp    = parts[0].split('-');
        var displayDate = dp[2] + '/' + dp[1] + '/' + dp[0];   // dd/MM/yyyy
        var displayTime = parts[1] || '00:00';
        return '<span style="display:block;font-weight:500;">' + displayDate + '</span>' +
               '<span style="color:var(--e7-text-2, #64748b);font-size:11px;">' + displayTime + '</span>';
    }

    // Chart colors
    var chartColors = {
        failure: '#ef4444',      // Red
        predictive: '#3b82f6',   // Blue
        rdpms: '#22c55e'         // Green
    };

    // Display format for both filter pickers: dd/MM/yyyy.
    //
    // It was 'dd/mm/yy'. In Air Datepicker 2.2.3 -- the library this page actually loads --
    // 'yy' is the TWO-DIGIT year, not jQuery UI's four. So the field was prefilled by
    // setDefaultDates() as "15/09/2026" and rewritten as "15/09/26" the moment anyone
    // picked a date, and toBackend() then shipped "09/15/26" to the server. Every comparison
    // below parses this string, so the format has to mean what the rest of the page assumes.
    // 'dd/mm/yyyy' is what the other FRS25 date filters use (EquipmentRoom/History,
    // RDPMSHealthLive/Detail).
    var DATE_FORMAT = 'dd/mm/yyyy';

    /* ==================================================================
       DATE RANGE RULES -- no future date, and To is never before From.

       Enforced in TWO places on purpose, because they fail differently:
         - the PICKERS carry minDate/maxDate, so an invalid date cannot be clicked. That is
           the part a user sees, and it is the only part that prevents the mistake.
         - pfCheckRange() is asked again at search time, and IT is the authority. The fields
           are prefilled before any picker exists, they are set programmatically in several
           places (setDefaultDates, vfResetList, openActualFailureModal), and a reset that
           runs while the page is idle leaves a value no picker ever vetted. A bound alone
           would let those paths through.

       LOCAL midnight throughout, never toISOString(). toISOString() is UTC, so in IST
       (+05:30) it reports YESTERDAY until 05:30 in the morning -- a "not in the future"
       bound built on it would refuse today's date for the first five and a half hours of
       every day, which is precisely when the day's own data is being looked at.
       ================================================================== */

    // Today at local midnight -- the inclusive upper bound for both fields.
    function pfToday() {
        var n = new Date();
        return new Date(n.getFullYear(), n.getMonth(), n.getDate());
    }

    // Local yyyy-MM-dd, for the native <input type="date"> min/max attributes and values.
    function pfIsoLocal(d) {
        d = d || pfToday();
        return d.getFullYear()
             + '-' + ('0' + (d.getMonth() + 1)).slice(-2)
             + '-' + ('0' + d.getDate()).slice(-2);
    }

    // Local dd/MM/yyyy, for the two filter text fields.
    function pfFmtDisplay(d) {
        return ('0' + d.getDate()).slice(-2)
             + '/' + ('0' + (d.getMonth() + 1)).slice(-2)
             + '/' + d.getFullYear();
    }

    // 'dd/MM/yyyy' -> Date at local midnight, or null. Returns null for a date that does not
    // exist (31/02/2026) rather than letting the Date constructor roll it into March, which
    // would silently widen the range the user asked for.
    function pfParseDisplay(s) {
        var p = String(s || '').trim().split('/');
        if (p.length !== 3) { return null; }
        var dd = parseInt(p[0], 10), mm = parseInt(p[1], 10), yy = parseInt(p[2], 10);
        if (!dd || !mm || !yy) { return null; }
        var dt = new Date(yy, mm - 1, dd);
        if (dt.getDate() !== dd || dt.getMonth() !== (mm - 1) || dt.getFullYear() !== yy) { return null; }
        return dt;
    }

    // 'yyyy-MM-dd' (native date input) -> Date at local midnight, or null. Built from the
    // parts rather than new Date(s): the string form is parsed as UTC by the spec, which
    // shifts it a day behind in IST.
    function pfParseIso(s) {
        var p = String(s || '').trim().split('-');
        if (p.length !== 3) { return null; }
        var yy = parseInt(p[0], 10), mm = parseInt(p[1], 10), dd = parseInt(p[2], 10);
        if (!dd || !mm || !yy) { return null; }
        var dt = new Date(yy, mm - 1, dd);
        if (dt.getDate() !== dd || dt.getMonth() !== (mm - 1) || dt.getFullYear() !== yy) { return null; }
        return dt;
    }

    // The one rule, stated once. Returns '' when the range is usable, otherwise the message
    // to show. Both date pairs on this page call it, so they cannot drift apart.
    function pfCheckRange(from, to) {
        if (!from || !to) { return 'Please select both From Date and To Date.'; }
        var today = pfToday();
        if (from > today && to > today) {
            return 'From Date and To Date cannot be in the future. Please select dates up to today (' + pfFmtDisplay(today) + ').';
        }
        if (from > today) {
            return 'From Date cannot be in the future. Please select a date up to today (' + pfFmtDisplay(today) + ').';
        }
        if (to > today) {
            return 'To Date cannot be in the future. Please select a date up to today (' + pfFmtDisplay(today) + ').';
        }
        if (to < from) {
            return 'To Date cannot be earlier than From Date.';
        }
        return '';
    }

    /* Keeps the two filter calendars consistent with each other.
         - From is bounded by TODAY ONLY. Bounding it by To as well would mean anyone wanting
           a later range has to edit To first, and a picker that refuses the field you reached
           for reads as broken rather than as protective.
         - To is bounded by today AND by the current From, so it can never land before it.
         - Choosing a From later than the current To drags To along with it, instead of
           leaving a crossed pair on screen for the search to reject a click later. */
    function pfSyncMainBounds(which, picked) {
        var $from = $('#txtFromDate'), $to = $('#txtToDate');
        var dpTo = $to.data('datepicker');
        var today = pfToday();

        // onSelect hands over a Date -- or an array of them, if multipleDates is ever turned
        // on for these fields. Read defensively rather than assuming the scalar.
        var sel = (picked instanceof Date) ? picked
                : (($.isArray(picked) && picked.length) ? picked[0] : null);

        var from = (which === 'from' && sel) ? sel : pfParseDisplay($from.val());
        var to = (which === 'to' && sel) ? sel : pfParseDisplay($to.val());

        if (which === 'from' && from && to && to < from) {
            // selectDate writes the field and re-enters this function as 'to'. Harmless:
            // that branch only reads and re-applies the same bounds.
            if (dpTo && dpTo.selectDate) { dpTo.selectDate(from); }
            else { $to.val(pfFmtDisplay(from)); }
        }

        if (dpTo && dpTo.update) {
            dpTo.update({ minDate: from || '', maxDate: today });
        }
    }

    $(document).ready(function () {
        // Set default dates to today with consistent format
        setDefaultDates();

        // Date pickers with consistent format
        // maxDate: today -- a future day is not clickable in either calendar. The To picker
        // additionally carries minDate = the current From, so the pair cannot be crossed.
        //
        // onSelect is NOT used to write the value back. Air Datepicker invokes it as
        // this.opts.onSelect(...), so `this` inside is the options object, not the input --
        // the old `$(this).val(dateText)` was setting a property on a plain object and doing
        // nothing. The plugin fills the input itself; onSelect is only used here to move the
        // other field's bound.
        $('#txtFromDate').datepicker({
            dateFormat: DATE_FORMAT,
            autoClose: true,
            maxDate: pfToday(),
            onSelect: function (dateText, date) {
                pfSyncMainBounds('from', date);
            }
        });

        $('#txtToDate').datepicker({
            dateFormat: DATE_FORMAT,
            autoClose: true,
            maxDate: pfToday(),
            onSelect: function (dateText, date) {
                pfSyncMainBounds('to', date);
            }
        });

        // The fields are prefilled by setDefaultDates() before this runs, so seed the bounds
        // from those values rather than waiting for the first pick.
        pfSyncMainBounds('init', null);

        // Bind button clicks
        $('.select-btn').on('click', function (e) {
            e.stopPropagation();
