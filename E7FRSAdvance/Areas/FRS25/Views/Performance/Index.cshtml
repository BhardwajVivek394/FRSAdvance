    function vfDownload(type) {

        var headers = ['S No', 'Station Name', 'Asset Type', 'Asset No',
            'Incidence Date & Time', 'Rectification Date & Time',
            'Cause Code', 'Remark', 'Alert Status', 'Generated By'];
        var rows = [];

        $('#vf_ListBody tr[data-id]').each(function (i) {
            var tds = $(this).find('td');
            rows.push([
                (i + 1),
                tds.eq(1).text().trim(),
                tds.eq(2).text().trim(),
                tds.eq(3).text().trim(),
                tds.eq(4).text().trim(),   // Incidence Date & Time
                tds.eq(5).text().trim(),   // Rectification Date & Time
                tds.eq(6).text().trim(),   // Cause Code
                tds.eq(7).text().trim(),   // Remark
                tds.eq(8).text().trim(),   // Alert Status
                tds.eq(9).text().trim()    // Generated By
            ]);
        });

        if (rows.length === 0) { showWarning('No data to download. Please search first.', 'Download'); return; }

        var fromDate = $('#vf_FromDate').val() || 'all';
        var toDate   = $('#vf_ToDate').val()   || 'all';
        var fileName = 'ActualFailureList_' + fromDate + '_to_' + toDate;

        if (type === 'csv') {
            var allRows = [headers].concat(rows);
            var csv = allRows.map(function (r) {
                return r.map(function (c) {
                    return '"' + String(c === null || c === undefined ? '' : c).replace(/"/g, '""') + '"';
                }).join(',');
            }).join('\r\n');
            var blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
            saveAs(blob, fileName + '.csv');

        } else {
            var workbook  = new ExcelJS.Workbook();
            workbook.creator = 'Energy7';
            workbook.created = new Date();
            var ws = workbook.addWorksheet('Actual Failure List');

            ws.columns = [
                { key: 'a', width: 7 },
                { key: 'b', width: 18 },
                { key: 'c', width: 16 },
                { key: 'd', width: 16 },
                { key: 'e', width: 22 },  // Incidence Date & Time
                { key: 'f', width: 22 },  // Rectification Date & Time
                { key: 'g', width: 20 },  // Cause Code
                { key: 'h', width: 28 },  // Remark
                { key: 'i', width: 18 },  // Alert Status
                { key: 'j', width: 18 }   // Generated By
            ];

            var hRow = ws.addRow(headers);
            hRow.eachCell(function (cell) {
                cell.font      = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11 };
                cell.fill      = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1A2D5A' } };
                cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
                cell.border    = { top: { style: 'thin', color: { argb: 'FFB0B8D1' } }, left: { style: 'thin', color: { argb: 'FFB0B8D1' } }, bottom: { style: 'thin', color: { argb: 'FFB0B8D1' } }, right: { style: 'thin', color: { argb: 'FFB0B8D1' } } };
            });
            hRow.height = 36;

            rows.forEach(function (row, idx) {
                var dRow = ws.addRow(row);
                var bg = idx % 2 === 0 ? 'FFFFFFFF' : 'FFF8FAFF';
                dRow.eachCell(function (cell) {
                    cell.fill      = { type: 'pattern', pattern: 'solid', fgColor: { argb: bg } };
                    cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
                    cell.border    = { top: { style: 'thin', color: { argb: 'FFEDF0F8' } }, left: { style: 'thin', color: { argb: 'FFEDF0F8' } }, bottom: { style: 'thin', color: { argb: 'FFEDF0F8' } }, right: { style: 'thin', color: { argb: 'FFEDF0F8' } } };
                });
                dRow.getCell(2).alignment = { vertical: 'middle', horizontal: 'left' };
                dRow.getCell(8).alignment = { vertical: 'middle', horizontal: 'left', wrapText: true };
                dRow.height = 22;
            });

            workbook.xlsx.writeBuffer().then(function (buffer) {
                var blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                saveAs(blob, fileName + '.xlsx');
            });
        }
    }

