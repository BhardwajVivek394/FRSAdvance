                data: {
                    labels: data.labels,
                    datasets: [
                        {
                            label: '% (True + PT) Failure Alerts',
                            data: data.failure,
                            backgroundColor: chartColors.failure,
                            borderRadius: 4,
                            barPercentage: 0.7,
                            categoryPercentage: 0.8
                        },
                        {
                            label: '% (True + PT) Predictive Alerts',
                            data: data.predictive,
                            backgroundColor: chartColors.predictive,
                            borderRadius: 4,
                            barPercentage: 0.7,
                            categoryPercentage: 0.8
                        },
                        {
