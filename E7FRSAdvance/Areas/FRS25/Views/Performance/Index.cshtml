    // ── Helper: rank a line point against the other station lines at the
    //    same metric index. 0 = highest value at that metric. Ties break by
    //    dataset order so identical values still get distinct ranks (and thus
    //    never land on the same spot).
    function rankAtPoint(ctx) {
        var idx = ctx.dataIndex;
        var dsi = ctx.datasetIndex;
        var myVal = parseFloat(ctx.dataset.data[idx]) || 0;
        var rank = 0;
        ctx.chart.data.datasets.forEach(function (d, i) {
            var v = parseFloat(d.data[idx]) || 0;
            if (v > myVal || (v === myVal && i < dsi)) rank++;
        });
        return rank;
    }

    // ── Helper: break a long metric label into multiple lines + value ──
    //    Returns an array of strings, which Chart.js renders as separate
    //    tooltip body lines — makes long descriptive labels readable on tap.
    function splitLabelForTooltip(label, valueText) {
        var maxLen = 48;            // chars per tooltip line
        var lines  = [];
        var words  = (label || '').split(' ');
        var cur    = '';
        for (var i = 0; i < words.length; i++) {
            if ((cur + ' ' + words[i]).trim().length > maxLen) {
                if (cur) lines.push(cur);
                cur = words[i];
            } else {
                cur = (cur ? cur + ' ' : '') + words[i];
            }
        }
        if (cur) lines.push(cur);
        if (valueText) lines.push('▸ ' + valueText);
        return lines;
    }

