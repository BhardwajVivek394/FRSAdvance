                                </ol>
                            </nav>
                        </div>
                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                            <h2 class="page-name">Performance</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="search-section">
                        <div class="search-title">Search</div>

                        <!-- Backdrop for closing dropdowns -->
                        <div class="dropdown-backdrop" id="backdrop"></div>

                        <div class="filter-row">
                            <!-- Zone -->
                            <div class="filter-item">
                                <label>Zone</label>
                                <div class="select-btn" id="btnZone" data-target="ddZone">
                                    <span class="text" id="txtZone">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>

                            <!-- Division -->
                            <div class="filter-item">
                                <label>Division</label>
                                <div class="select-btn" id="btnDivision" data-target="ddDivision">
                                    <span class="text" id="txtDivision">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>

                            <!-- Station -->
                            <div class="filter-item">
                                <label>Station</label>
                                <div class="select-btn" id="btnSite" data-target="ddSite">
                                    <span class="text" id="txtSite">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>

                            <!-- From Date -->
                            <div class="filter-item">
                                <label>From Date</label>
                                <input type="text" class="filter-input" id="txtFromDate" placeholder="Select" readonly>
                            </div>

                            <!-- To Date -->
                            <div class="filter-item">
                                <label>To Date</label>
                                <input type="text" class="filter-input" id="txtToDate" placeholder="Select" readonly>
                            </div>

                            <!-- View Type -->
                            <div class="filter-item">
                                <label>View</label>
                                <div class="select-btn" id="btnViewType" data-target="ddViewType" style="min-width: 100px;">
                                    <span class="text" id="txtViewType">Table</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>

                            <!-- Search Button -->
                            <div class="filter-item">
                                <label>&nbsp;</label>
                                <button type="button" class="btn-search" onclick="fnGetAlertPerformanceReport()">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </button>
                            </div>

                            <!-- Actual Failure Entry Button -->
                            <div class="filter-item">
                                <label>&nbsp;</label>
                                <button type="button" class="btn-failure-entry" onclick="openActualFailureModal()">
                                    <i class="fa fa-exclamation-triangle"></i> Actual Failure Entry
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- DROPDOWNS -->
                    <!-- Zone Dropdown -->
                    <div class="filter-dropdown" id="ddZone">
                        <div class="dropdown-search">
                            <input type="text" placeholder="Search zone..." onkeyup="filterDropdown('zone', this.value)">
                        </div>
                        <div class="dropdown-header">
                            <input type="checkbox" id="chkAllZone">
                            <label for="chkAllZone">Select All</label>
                        </div>
                        <div class="dropdown-list" id="listZone">
                            @if (ViewBag.Zones != null)
                            {
                                foreach (var zone in (IEnumerable<SelectListItem>)ViewBag.Zones)
                                {
                <div class="dropdown-item" data-value="@zone.Value" data-text="@zone.Text">
                    <input type="checkbox" class="cb-zone" value="@zone.Value">
                    <span>@zone.Text</span>
                </div>}
        }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>

                    <!-- Division Dropdown -->
                    <div class="filter-dropdown" id="ddDivision">
                        <div class="dropdown-search">
                            <input type="text" placeholder="Search division..." onkeyup="filterDropdown('division', this.value)">
