<script>
    var openDropdown = null;
    var selectedViewType = 'Table';
    var performanceChart = null;

    // ================================================================
    //  DATETIME HELPERS
    // ================================================================

    /**
     * Build a datetime-local string (yyyy-MM-ddTHH:mm) from multiple possible
     * sources. Priority:
     *   1. row.FromDateTime / row.ToDateTime  (ISO or "yyyy-MM-dd HH:mm:ss")
     *   2. separate date + time fields       (row.FailureDateFrom + FailureTimeFrom)
     *   3. empty string if nothing available
     */
    function vfBuildDateTimeLocal(isoDateTime, datePart, timePart) {
        // ── 1. Try combined ISO / SQL datetime string ──────────────────
        if (isoDateTime && isoDateTime !== '0001-01-01T00:00:00' &&
            isoDateTime !== '0001-01-01 00:00:00' && isoDateTime !== '01/01/0001 00:00:00') {
            // Handle formats:  "2025-06-10T14:30:00"  or  "2025-06-10 14:30:00"
            var s = String(isoDateTime).replace(' ', 'T');
            if (s.indexOf('T') !== -1) {
                // Slice to "yyyy-MM-ddTHH:mm" (drop seconds / timezone)
                return s.substring(0, 16);
            }
        }

        // ── 2. Try separate date + time parts ─────────────────────────
        // datePart may arrive as "dd/MM/yyyy", "yyyy-MM-dd", or "dd-MM-yyyy"
        if (datePart && datePart.trim()) {
            var dNorm = vfNormalizeDate(datePart.trim());   // → yyyy-MM-dd
            if (dNorm) {
                var tNorm = (timePart || '').trim().substring(0, 5); // HH:mm
                return dNorm + 'T' + (tNorm || '00:00');
            }
        }

        return '';
    }

    /**
     * Normalise various date formats to yyyy-MM-dd.
     * Accepts: dd/MM/yyyy | dd-MM-yyyy | yyyy-MM-dd
     */
    function vfNormalizeDate(d) {
        if (!d) return '';
        // dd/MM/yyyy  or  dd-MM-yyyy
        var m = d.match(/^(\d{2})[\/\-](\d{2})[\/\-](\d{4})$/);
        if (m) return m[3] + '-' + m[2] + '-' + m[1];
        // yyyy-MM-dd  (already correct)
        if (/^\d{4}-\d{2}-\d{2}$/.test(d)) return d;
        return '';
    }

    /**
     * Format a datetime for table cell display.
     * Shows "dd/MM/yyyy HH:mm" or "–" if unavailable / min-date.
     */
    function vfFmtDT(isoDateTime, datePart, timePart) {
        var local = vfBuildDateTimeLocal(isoDateTime, datePart, timePart);
        if (!local) return '<span style="color:#94a3b8;">–</span>';
        // local = "yyyy-MM-ddTHH:mm"
        var parts = local.split('T');
        var dp    = parts[0].split('-');
        var displayDate = dp[2] + '/' + dp[1] + '/' + dp[0];   // dd/MM/yyyy
        var displayTime = parts[1] || '00:00';
        return '<span style="display:block;font-weight:500;">' + displayDate + '</span>' +
               '<span style="color:#64748b;font-size:11px;">' + displayTime + '</span>';
    }

