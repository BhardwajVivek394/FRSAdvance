@{
    ViewBag.Title = "Performance";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";

    // Zonal and Divisional Admin can VIEW failures but NOT add/edit/delete
    var _lu = E7FRSAdvance.Utility.ClsHttpContent.LoginUser;
    var _ucn = (_lu.UserClassTypeName ?? "").Trim();

    bool isZonalAdmin = _ucn.Equals("Headquarter Level User", StringComparison.OrdinalIgnoreCase);
    bool isDivisionalAdmin = _ucn.Equals("Division Level User", StringComparison.OrdinalIgnoreCase);
    bool isViewOnly = isZonalAdmin || isDivisionalAdmin;
}

<style>
    /* ===== SEARCH SECTION ===== */
    .search-section {
        padding: 20px 0px;
        position: relative;
        z-index: 100;
    }

    .search-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--e7-heading);
        margin-bottom: 20px;
    }

    /* ===== FILTER ROW ===== */
    .filter-row {
        display: flex;
        align-items: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        position: relative;
        z-index: 100;
    }

    /* ===== FILTER ITEM ===== */
    .filter-item {
        flex-shrink: 0;
        position: relative;
        z-index: 100;
    }

        .filter-item label {
            display: block;
            font-size: 13px;
            color: var(--e7-text-2);
            margin-bottom: 6px;
            font-weight: 500;
        }

    /* ===== SELECT BUTTON ===== */
    .select-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--e7-surface-2);
        border: 1px solid var(--e7-border-2);
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        color: var(--e7-text);
        cursor: pointer;
        min-width: 230px;
        height: 40px;
    }

        .select-btn:hover {
            border-color: var(--e7-accent);
        }

        .select-btn.active {
            border-color: var(--e7-accent);
            box-shadow: 0 0 0 2px var(--e7-accent-soft);
        }

        .select-btn .text {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: left;
        }

        .select-btn i {
            margin-left: 8px;
            font-size: 12px;
            color: var(--e7-text-3);
        }

    /* ===== DROPDOWN - FIXED POSITION ===== */
    .filter-dropdown {
        position: fixed;
        background: var(--e7-surface);
        border: 1px solid var(--e7-border);
        border-radius: 8px;
        box-shadow: var(--e7-shadow-pop);
        min-width: 260px;
        max-width: 320px;
        z-index: 9999;
        display: none;
    }

        .filter-dropdown.open {
            display: block;
        }

    /* Search Box in Dropdown */
    .dropdown-search {
        padding: 10px 12px;
        border-bottom: 1px solid var(--e7-border);
    }

        .dropdown-search input {
            width: 100%;
            border: 1px solid var(--e7-border-2);
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s;
            background: var(--e7-surface-2);
            color: var(--e7-text);
        }

            .dropdown-search input:focus {
                border-color: var(--e7-accent);
            }

            .dropdown-search input::placeholder {
                color: var(--e7-text-4);
            }

    /* Select All Header */
    .dropdown-header {
        padding: 10px 14px;
        background: var(--e7-surface-2);
        border-bottom: 1px solid var(--e7-border);
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .dropdown-header input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--e7-accent);
        }

        .dropdown-header label {
            font-size: 14px;
            font-weight: 600;
            color: var(--e7-text-2);
            cursor: pointer;
            margin: 0;
        }

    /* Options List */
    .dropdown-list {
        max-height: 250px;
        overflow-y: auto;
    }

    .dropdown-item {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid var(--e7-border);
        transition: background 0.15s;
    }

        .dropdown-item:last-child {
            border-bottom: none;
        }

        .dropdown-item:hover {
            background: var(--e7-surface-3);
        }

        .dropdown-item.checked {
            background: var(--e7-accent-soft);
        }

        .dropdown-item.hidden {
            display: none;
        }

        .dropdown-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--e7-accent);
            flex-shrink: 0;
        }

        .dropdown-item span {
            font-size: 14px;
            color: var(--e7-text);
        }

        .dropdown-item.checked span {
            color: var(--e7-accent-ink);
            font-weight: 500;
        }

        /* Highlight matched text */
        .dropdown-item span mark {
            background: var(--e7-amber-soft);
            color: var(--e7-amber);
            padding: 0;
            border-radius: 2px;
        }

    /* Empty/Loading State */
    .dropdown-empty {
        padding: 25px;
        text-align: center;
        color: var(--e7-text-3);
        font-size: 14px;
    }

    /* No results message */
    .dropdown-no-results {
        padding: 20px;
        text-align: center;
        color: var(--e7-text-3);
        font-size: 13px;
        display: none;
    }

        .dropdown-no-results.show {
            display: block;
        }

    /* ===== INPUT FIELDS ===== */
    .filter-input {
        border: 1px solid var(--e7-border-2);
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        height: 40px;
        width: 120px;
        outline: none;
        background: var(--e7-surface-2);
        color: var(--e7-text);
    }

        .filter-input:focus {
            border-color: var(--e7-accent);
            box-shadow: 0 0 0 2px var(--e7-accent-soft);
        }

        .filter-input::placeholder {
            color: var(--e7-text-4);
        }

    /* ===== SEARCH BUTTON ===== */
    .btn-search {
        background: linear-gradient(120deg, var(--e7-ask-from), var(--e7-ask-to));
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        color: #fff;
        font-size: 14px;
        font-weight: 500;
        transition: background 0.2s;
    }

        .btn-search:hover {
            background: linear-gradient(120deg, var(--e7-ask-from), var(--e7-ask-to));
            filter: brightness(1.06);
        }

    /* ===== BACKDROP ===== */
    .dropdown-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9998;
        display: none;
    }

        .dropdown-backdrop.show {
            display: block;
        }

    /* ===== TABLE SECTION ===== */
    .table-border {
        position: relative;
        z-index: 1;
    }

    /* ===== CHART STYLES ===== */
    .chart-container {
        padding: 25px;
        background: var(--e7-surface);
        border-radius: 12px;
        box-shadow: var(--e7-shadow-card);
        margin: 15px;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 1px solid var(--e7-border);
    }

    .chart-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--e7-heading);
        margin: 0;
    }

    .chart-wrapper {
        position: relative;
        height: 400px;
        width: 100%;
    }

    .no-data-box {
        height: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--e7-text-3);
        font-size: 16px;
    }

        .no-data-box i {
            font-size: 50px;
            margin-bottom: 15px;
            color: var(--e7-text-4);
        }

    .chart-legend {
        display: flex;
        justify-content: center;
        gap: 18px 28px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid var(--e7-border);
        flex-wrap: wrap;
    }

    .legend-item {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 13px;
        color: var(--e7-text-2);
        max-width: 360px;
        line-height: 1.4;
    }

    .legend-color {
        width: 16px;
        height: 16px;
        border-radius: 4px;
        flex-shrink: 0;
        margin-top: 2px;
    }

    /* ================================================================
       ACTUAL FAILURE MODAL — REDESIGNED
    ================================================================ */
    #modal-ActualFailureEntry {
        padding-right: 0 !important;
    }

        #modal-ActualFailureEntry .modal-dialog {
            max-width: min(92vw, 1260px) !important;
            width: min(92vw, 1260px) !important;
            margin: 20px auto !important;
        }

        #modal-ActualFailureEntry .modal-content {
            border-radius: 14px !important;
            overflow: hidden;
            border: none;
            box-shadow: var(--e7-shadow-pop);
        }

        /* ── HEADER ── */
        #modal-ActualFailureEntry .modal-header {
            background: var(--e7-surface-2) !important;
            color: var(--e7-heading) !important;
            padding: 0 20px;
            border-bottom: none !important;
            display: flex !important;
            align-items: center;
            gap: 12px;
            height: 56px;
            min-height: 56px;
            position: relative;
        }

            #modal-ActualFailureEntry .modal-header::after {
                content: '';
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, var(--e7-rail-from), var(--e7-rail-mid), var(--e7-rail-to));
            }

        #modal-ActualFailureEntry .af-header-icon {
            width: 34px;
            height: 34px;
            background: var(--e7-amber-soft);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--e7-amber);
            font-size: 15px;
            flex-shrink: 0;
            border: 1px solid color-mix(in srgb, var(--e7-dot-amber) 35%, transparent);
        }

        #modal-ActualFailureEntry .modal-title {
            font-size: 14.5px !important;
            font-weight: 700 !important;
            color: var(--e7-heading) !important;
            flex: 1;
            line-height: 1.2;
            letter-spacing: 0.2px;
        }

            #modal-ActualFailureEntry .modal-title small {
                display: block;
                font-size: 10.5px;
                font-weight: 400;
                color: var(--e7-text-3);
                margin-top: 2px;
                letter-spacing: 0.3px;
            }

        #modal-ActualFailureEntry .af-modal-close {
            background: var(--e7-surface);
            border: 1px solid var(--e7-border-2);
            border-radius: 6px;
            color: var(--e7-text-3) !important;
            font-size: 18px;
            font-weight: 700;
            line-height: 1;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.15s;
            flex-shrink: 0;
            padding: 0;
        }

            #modal-ActualFailureEntry .af-modal-close:hover {
                background: var(--e7-red-soft);
                border-color: var(--e7-dot-red);
                color: var(--e7-red) !important;
            }

        /* ── FILTER SECTION ── */
        #modal-ActualFailureEntry .af-filter-section {
            background: var(--e7-surface-2);
            border-bottom: 1px solid var(--e7-border);
            padding: 14px 20px;
            margin-bottom: 0;
        }

        #modal-ActualFailureEntry .af-filter-section-title {
            font-size: 9.5px;
            font-weight: 700;
            color: var(--e7-text-3);
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 10px;
        }

        #modal-ActualFailureEntry .af-filter-row {
            display: flex;
            flex-wrap: nowrap;
            gap: 10px;
            align-items: flex-end;
            overflow-x: auto;
        }

        #modal-ActualFailureEntry .af-filter-item {
            flex: 1;
            min-width: 100px;
        }

            #modal-ActualFailureEntry .af-filter-item.btn-item {
                flex: 0 0 auto;
                min-width: 100px;
            }

        #modal-ActualFailureEntry .af-filter-label {
            font-size: 10px;
            font-weight: 700;
            color: var(--e7-text-2);
            margin-bottom: 5px;
            display: block;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        #modal-ActualFailureEntry .af-select,
        #modal-ActualFailureEntry .af-input {
            width: 100%;
            height: 34px;
            border: 1.5px solid var(--e7-border-2);
            border-radius: 7px;
            padding: 3px 10px;
            font-size: 12.5px;
            color: var(--e7-text);
            background: var(--e7-surface);
            outline: none;
            transition: all 0.15s;
            box-shadow: var(--e7-shadow-soft);
        }

            #modal-ActualFailureEntry .af-select:focus,
            #modal-ActualFailureEntry .af-input:focus {
                border-color: var(--e7-accent);
                box-shadow: 0 0 0 3px var(--e7-accent-soft);
            }

    /* Search button */
    .vf-btn-search {
        width: 100%;
        height: 34px;
        background: linear-gradient(120deg, var(--e7-ask-from), var(--e7-ask-to));
        color: #fff;
        border: none;
        border-radius: 7px;
        font-size: 12.5px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.2s;
        box-shadow: var(--e7-shadow-soft);
    }

        .vf-btn-search:hover {
            background: linear-gradient(120deg, var(--e7-ask-from), var(--e7-ask-to));
            filter: brightness(1.06);
            box-shadow: var(--e7-shadow-hover);
            transform: translateY(-1px);
        }

    .vf-btn-reset {
        width: 100%;
        height: 34px;
        background: var(--e7-surface);
        color: var(--e7-text-2);
        border: 1.5px solid var(--e7-border-2);
        border-radius: 7px;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.15s;
    }

        .vf-btn-reset:hover {
            background: var(--e7-surface-3);
            color: var(--e7-heading);
            border-color: var(--e7-text-4);
        }

    /* Add New Row button */
    .af-btn-add-table {
        width: 100%;
        height: 34px;
        background: linear-gradient(135deg, #059669, #047857);
        color: #fff;
        border: none;
        border-radius: 7px;
        font-size: 12.5px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        transition: all 0.2s;
        box-shadow: 0 2px 8px rgba(5,150,105,0.3);
        white-space: nowrap;
    }

        .af-btn-add-table:hover {
            background: linear-gradient(135deg, #047857, #065f46);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(5,150,105,0.4);
        }

    /* Download buttons */
    .vf-dl-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 34px;
        padding: 0 12px;
        border-radius: 6px;
        border: none;
        font-size: 12.5px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s;
        white-space: nowrap;
    }

    .vf-dl-excel {
        background: var(--e7-green-soft);
        color: var(--e7-green);
    }

        .vf-dl-excel:hover {
            background: #1d6f42;
            color: #fff;
        }

    .vf-dl-csv {
        background: var(--e7-p-blue);
        color: var(--e7-accent-ink);
    }

        .vf-dl-csv:hover {
            background: #185abc;
            color: #fff;
        }

    /* ── TABLE ── */
    #modal-ActualFailureEntry .vf-table-wrap {
        overflow-x: auto;
        overflow-y: auto;
        max-height: 420px;
    }

    #modal-ActualFailureEntry .vf-table,
    #modal-ActualFailureEntry .af-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 12px;
        min-width: 860px;
    }

        /* Sticky header */
        #modal-ActualFailureEntry .vf-table thead th,
        #modal-ActualFailureEntry .af-table thead th {
            position: sticky;
            top: 0;
            z-index: 3;
            background: var(--e7-surface-2);
            color: var(--e7-text-2);
            font-weight: 600;
            font-size: 11px;
            padding: 11px 12px;
            white-space: nowrap;
            border: none;
            border-right: 1px solid var(--e7-border);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            vertical-align: middle;
        }

            #modal-ActualFailureEntry .vf-table thead th:last-child,
            #modal-ActualFailureEntry .af-table thead th:last-child {
                border-right: none;
            }

            #modal-ActualFailureEntry .vf-table thead th small {
                display: block;
                color: var(--e7-text-3);
                font-weight: 400;
                font-size: 9.5px;
                margin-top: 2px;
                text-transform: none;
                letter-spacing: 0;
            }

        /* Body rows */
        #modal-ActualFailureEntry .vf-table tbody tr,
        #modal-ActualFailureEntry .af-table tbody tr {
            background: var(--e7-surface);
            transition: background 0.12s;
        }

            #modal-ActualFailureEntry .vf-table tbody tr:nth-child(even) {
                background: var(--e7-surface-2);
            }

            #modal-ActualFailureEntry .vf-table tbody tr:hover {
                background: var(--e7-surface-3) !important;
            }

        #modal-ActualFailureEntry .vf-table tbody td,
        #modal-ActualFailureEntry .af-table tbody td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--e7-border);
            vertical-align: middle;
            color: var(--e7-text);
            font-size: 12px;
        }

        /* New editable row style */
        #modal-ActualFailureEntry .vf-table tbody tr[data-new-row] {
            background: var(--e7-amber-soft) !important;
            border-left: 3px solid var(--e7-dot-amber);
        }

            #modal-ActualFailureEntry .vf-table tbody tr[data-new-row]:hover {
                background: color-mix(in srgb, var(--e7-dot-amber) 22%, var(--e7-surface)) !important;
            }

            #modal-ActualFailureEntry .vf-table tbody tr[data-new-row] td {
                border-bottom: 1px solid color-mix(in srgb, var(--e7-dot-amber) 35%, transparent);
            }

    /* Cause code badge */
    .vf-badge {
        display: inline-block;
        background: var(--e7-violet-soft);
        color: var(--e7-violet);
        border: 1px solid color-mix(in srgb, var(--e7-violet) 35%, transparent);
        border-radius: 20px;
        padding: 2px 10px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.3px;
        white-space: nowrap;
    }

    /* Cell inputs in editable row */
    #modal-ActualFailureEntry .af-cell-input,
    #modal-ActualFailureEntry .af-cell-select,
    #modal-ActualFailureEntry .af-cell-textarea {
        width: 100%;
        border: 1.5px solid var(--e7-border-2);
        border-radius: 5px;
        padding: 3px 7px;
        font-size: 11.5px;
        color: var(--e7-text);
        background: var(--e7-surface);
        outline: none;
        transition: border-color 0.15s;
    }

    #modal-ActualFailureEntry .af-cell-input {
        height: 28px;
    }

    #modal-ActualFailureEntry .af-cell-select {
        height: 28px;
    }

        #modal-ActualFailureEntry .af-cell-input:focus,
        #modal-ActualFailureEntry .af-cell-select:focus,
        #modal-ActualFailureEntry .af-cell-textarea:focus {
            border-color: var(--e7-accent);
            box-shadow: 0 0 0 2px var(--e7-accent-soft);
        }

    #modal-ActualFailureEntry .af-date-label {
        font-size: 9px;
        color: var(--e7-text-3);
        font-weight: 700;
        text-transform: uppercase;
        display: block;
        margin-bottom: 2px;
        letter-spacing: 0.3px;
    }

    /* Row action buttons */
    .af-row-actions {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .af-btn {
        border: none;
        border-radius: 5px;
        padding: 4px 9px;
        font-size: 10.5px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 3px;
        white-space: nowrap;
        height: 26px;
        transition: all 0.15s;
    }

    .af-btn-save {
        background: var(--e7-green-soft);
        color: var(--e7-green);
        border: 1px solid color-mix(in srgb, var(--e7-dot-green) 40%, transparent);
    }

        .af-btn-save:hover {
            background: #059669;
            color: #fff;
            border-color: #059669;
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(5,150,105,0.3);
        }

    .af-btn-del {
        background: var(--e7-red-soft);
        color: var(--e7-red);
        border: 1px solid color-mix(in srgb, var(--e7-dot-red) 40%, transparent);
    }

        .af-btn-del:hover {
            background: #dc2626;
            color: #fff;
            border-color: #dc2626;
            transform: translateY(-1px);
            box-shadow: 0 3px 8px rgba(220,38,38,0.3);
        }

    .vf-btn-edit {
        background: var(--e7-p-blue);
        color: var(--e7-accent-ink);
        border: 1px solid color-mix(in srgb, var(--e7-accent) 40%, transparent);
    }

        .vf-btn-edit:hover {
            background: var(--e7-accent);
            color: #fff;
            border-color: var(--e7-accent);
        }

    .vf-btn-del {
        background: var(--e7-red-soft);
        color: var(--e7-red);
        border: 1px solid color-mix(in srgb, var(--e7-dot-red) 40%, transparent);
    }

        .vf-btn-del:hover {
            background: #dc2626;
            color: #fff;
            border-color: #dc2626;
