        // ===== LINE GRAPH =====
        else if (viewType === 'Graph') {
            chartConfig = {
                type: 'line',
                data: {
                    labels: data.labels,
                    datasets: [
                        {
                            label: '% (True + PT) Failure Alerts',
                            data: data.failure,
                            borderColor: chartColors.failure,
                            backgroundColor: 'rgba(239, 68, 68, 0.1)',
