    // ===== CHART VIEW =====
    function fnLoadChartView(mAssetLister, viewType) {
        $("#loader").show();
        $('#divTableContainer').hide();
        $('#divChartContainer').show();

        // First load table data to parse for chart
        $.ajax({
            url: '/FRS25/Performance/_List',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();

                // Parse table data to extract chart data
                var chartData = parseTableDataForChart(data);

                if (chartData.labels.length > 0) {
                    renderChart(chartData, viewType);
                } else {
                    renderNoData();
                }
            },
            error: function () {
                $("#loader").hide();
                showError("Something went wrong!", "Error");
            }
        });
    }

    // ===== PARSE TABLE DATA FOR CHART =====
    function parseTableDataForChart(htmlData) {
        var $temp = $('<div>').html(htmlData);
        var $rows = $temp.find('tbody tr[data-station]');

        var labels = [];
        var failurePercentages = [];
        var predictivePercentages = [];
        var rdpmsPercentages = [];

        $rows.each(function () {
            var station = $(this).data('station') || '';
            var failPct = parseFloat($(this).data('failure')) || 0;
            var predPct = parseFloat($(this).data('predictive')) || 0;
            var rdpmsPct = parseFloat($(this).data('rdpms')) || 0;

            if (station) {
                labels.push(station);
                failurePercentages.push(failPct);
                predictivePercentages.push(predPct);
                rdpmsPercentages.push(rdpmsPct);
            }
        });

        return {
            labels: labels,
            failure: failurePercentages,
            predictive: predictivePercentages,
            rdpms: rdpmsPercentages
        };
    }

