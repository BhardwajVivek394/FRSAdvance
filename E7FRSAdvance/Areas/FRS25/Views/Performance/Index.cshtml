    // Load asset nos when asset type changes in a new row
    function afNewRowLoadAssetNo(idx, siteId) {
        var assetTypeId = $('#af_assetType_' + idx).val();
        $('#af_row_' + idx).data('assettype-id', assetTypeId);
        var $assetNo = $('#af_assetNo_' + idx);
        var $causeCode = $('#af_causeCode_' + idx);
        $assetNo.html('<option value="0">Loading...</option>');
        $causeCode.html('<option value="0">Loading...</option>');

        if (!assetTypeId || assetTypeId === '0') {
            $assetNo.html('<option value="0">-- Select Asset Type First --</option>');
            $causeCode.html('<option value="0">-- Select Asset Type First --</option>');
            return;
        }

        // Load asset nos
        $.ajax({
            url: '/FRS25/Performance/GetAssestBy', type: 'POST', contentType: 'application/json',
            data: JSON.stringify({ AssetTypeId: assetTypeId, SiteId: siteId }),
            success: function (data) {
                var html = '<option value="0">-- Select --</option>';
                $.each(data || [], function (i, a) { html += '<option value="' + a.Id + '">' + a.Name + '</option>'; });
                $assetNo.html(html);
            },
            error: function () { $assetNo.html('<option value="0">Error loading</option>'); }
        });

