    function vfDownload(type) {
        // Fix 6: Lazy-load ExcelJS on first export (skip for CSV which doesn't need it)
        if (type !== 'csv' && typeof ExcelJS === 'undefined') {
            ensureExcelJs(function () { vfDownload(type); });
            return;
        }

        var headers = ['S No', 'Station Name', 'Asset Type', 'Asset Number',
            'Incidence Date & Time', 'Rectification Date & Time',
            'Cause Code', 'Remark', 'Alert Status', 'Generated By'];
        var rows = [];

        $('#vf_ListBody tr[data-id]').each(function (i) {
            var tds = $(this).find('td');
            rows.push([
                (i + 1),
                tds.eq(1).text().trim(),
                tds.eq(2).text().trim(),
                tds.eq(3).text().trim(),
                tds.eq(4).text().trim(),   // Incidence Date & Time
                tds.eq(5).text().trim(),   // Rectification Date & Time
                tds.eq(6).text().trim(),   // Cause Code
                tds.eq(7).text().trim(),   // Remark
                tds.eq(8).text().trim(),   // Alert Status
                tds.eq(9).text().trim()    // Generated By
            ]);
        });

        if (rows.length === 0) { showWarning('No data to download. Please search first.', 'Download'); return; }

        var fromDate = $('#vf_FromDate').val() || 'all';
        var toDate   = $('#vf_ToDate').val()   || 'all';
        var fileName = 'ActualFailureList_' + fromDate + '_to_' + toDate;

        if (type === 'csv') {
            var allRows = [headers].concat(rows);
            var csv = allRows.map(function (r) {
                return r.map(function (c) {
                    return '"' + String(c === null || c === undefined ? '' : c).replace(/"/g, '""') + '"';
                }).join(',');
            }).join('\r\n');
            var blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
            saveAs(blob, fileName + '.csv');

        } else {
            var workbook  = new ExcelJS.Workbook();
            workbook.creator = 'Energy7';
            workbook.created = new Date();
            var ws = workbook.addWorksheet('Actual Failure List');

            ws.columns = [
                { key: 'a', width: 7 },
                { key: 'b', width: 18 },
                { key: 'c', width: 16 },
                { key: 'd', width: 16 },
                { key: 'e', width: 22 },  // Incidence Date & Time
                { key: 'f', width: 22 },  // Rectification Date & Time
                { key: 'g', width: 20 },  // Cause Code
                { key: 'h', width: 28 },  // Remark
                { key: 'i', width: 18 },  // Alert Status
                { key: 'j', width: 18 }   // Generated By
            ];

            var hRow = ws.addRow(headers);
            hRow.eachCell(function (cell) {
                cell.font      = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11 };
                cell.fill      = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1A2D5A' } };
                cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
                cell.border    = { top: { style: 'thin', color: { argb: 'FFB0B8D1' } }, left: { style: 'thin', color: { argb: 'FFB0B8D1' } }, bottom: { style: 'thin', color: { argb: 'FFB0B8D1' } }, right: { style: 'thin', color: { argb: 'FFB0B8D1' } } };
            });
            hRow.height = 36;

            rows.forEach(function (row, idx) {
                var dRow = ws.addRow(row);
                var bg = idx % 2 === 0 ? 'FFFFFFFF' : 'FFF8FAFF';
                dRow.eachCell(function (cell) {
                    cell.fill      = { type: 'pattern', pattern: 'solid', fgColor: { argb: bg } };
                    cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
                    cell.border    = { top: { style: 'thin', color: { argb: 'FFEDF0F8' } }, left: { style: 'thin', color: { argb: 'FFEDF0F8' } }, bottom: { style: 'thin', color: { argb: 'FFEDF0F8' } }, right: { style: 'thin', color: { argb: 'FFEDF0F8' } } };
                });
                dRow.getCell(2).alignment = { vertical: 'middle', horizontal: 'left' };
                dRow.getCell(8).alignment = { vertical: 'middle', horizontal: 'left', wrapText: true };
                dRow.height = 22;
            });

            workbook.xlsx.writeBuffer().then(function (buffer) {
                var blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                saveAs(blob, fileName + '.xlsx');
            });
        }
    }

    /* The same two rules on the failure-list filter, which is a pair of native date inputs
       rather than the Air Datepicker used above.

       `max` and `min` are what the browser's own calendar honours -- a future day is greyed
       out in the picker -- but they are advisory only: a native date field still accepts a
       typed date outside them, and marks the field :invalid without telling anyone. So the
       value is corrected here as well, and vfLoadList() checks it again before it queries. */
    function vfApplyDateBounds(changed) {
        var $from = $('#vf_FromDate'), $to = $('#vf_ToDate');
        var today = pfToday(), todayIso = pfIsoLocal(today);

        var from = pfParseIso($from.val());
        var to = pfParseIso($to.val());

        // Nothing later than today, in either field.
        if (from && from > today) { $from.val(todayIso); from = today; }
        if (to && to > today) { $to.val(todayIso); to = today; }

        // Crossed pair: move the field the user did NOT just touch, so their own choice
        // stands and the other one follows it.
        if (from && to && to < from) {
            if (changed === 'to') { $from.val(pfIsoLocal(to)); from = to; }
            else { $to.val(pfIsoLocal(from)); to = from; }
        }

        // Browser-level guard rails, refreshed from the current values. From is bounded by
        // TODAY only and never by To -- the same rule as the filter calendars above, and for
        // the same reason: a From field that refuses a later date until To is edited first
        // traps anyone moving a range forward. Crossing it instead drags To along, which the
        // block above has already done.
        $from.attr('max', todayIso);
        $to.attr('min', from ? pfIsoLocal(from) : '');
        $to.attr('max', todayIso);
    }

    function vfLoadList() {
        // Correct and bound the fields before reading them: the modal's own reset paths set
        // these values directly, so this may be the first time they have been looked at.
        vfApplyDateBounds('to');

        var fromDate = $('#vf_FromDate').val();
        var toDate = $('#vf_ToDate').val();
        var station = parseInt($('#vf_Station').val()) || 0;

        var vfRangeError = pfCheckRange(pfParseIso(fromDate), pfParseIso(toDate));
        if (vfRangeError) { showWarning(vfRangeError, 'Validation'); return; }

        // Convert yyyy-MM-dd → dd-MM-yyyy to match controller expected format
        //function fmtDate(d) {
        //    if (!d) return '';
        //    var p = d.split('-');
        //    return p.length === 3 ? p[2] + '-' + p[1] + '-' + p[0] : d;
        //}
        function fmtDate(d) {
            if (!d) return '';
            var p = d.split('-');           // '2026-06-09' → ['2026','06','09']
            return p.length === 3 ? p[1] + '/' + p[2] + '/' + p[0] : d;  // '06/09/2026'
        }
        fromDate = fmtDate(fromDate);
        toDate = fmtDate(toDate);
        if (!fromDate || !toDate) { showWarning('Please select both From Date and To Date.', 'Validation'); return; }
        $('#loader').show();
        $.ajax({
            url: '/FRS25/Performance/GetActualFailureList',
            type: 'POST',
            contentType: 'application/json',
