    // ── "All" toggle: clicking All selects/deselects every option ────
    $(document).on('change', '#af_AssetNo', function () {
        var $sel     = $(this);
        var $allOpt  = $sel.find('option[value="0"]');
        var allWasJustSelected = $allOpt.is(':selected');

        // Detect if user just clicked "All" by checking if it just became selected
        // while previously not all items were selected — we track via a data flag
        var prevAllState = $sel.data('prevAllSelected') || false;

        if (allWasJustSelected && !prevAllState) {
            // User just clicked "All" ON → select everything
            $sel.find('option').prop('selected', true);
        } else if (!allWasJustSelected && prevAllState) {
            // User just clicked "All" OFF → deselect everything
            $sel.find('option').prop('selected', false);
        } else {
            // Individual item toggled
            var totalItems     = $sel.find('option[value!="0"]').length;
            var selectedItems  = $sel.find('option[value!="0"]:selected').length;
            if (selectedItems === totalItems) {
                // All individuals selected → also tick "All"
                $allOpt.prop('selected', true);
            } else {
                // Not all → untick "All"
                $allOpt.prop('selected', false);
            }
        }

        // Remember All state for next change
        $sel.data('prevAllSelected', $sel.find('option[value="0"]').is(':selected'));
    });

    // ----- Add row to table -----

    function afAddToTable() {
        var stationVal    = $('#af_Station').val();
        var stationText   = $('#af_Station option:selected').text();
        var assetTypeVal  = $('#af_AssetType').val();
        var assetTypeText = $('#af_AssetType option:selected').text();

        if (!stationVal || stationVal === '0') {
            showWarning('Please select a Station before adding to the table.', 'Validation'); return;
        }
        if (!assetTypeVal || assetTypeVal === '0') {
            showWarning('Please select an Asset Type before adding to the table.', 'Validation'); return;
        }

        // Collect selected Asset Nos from native multiselect
        var selectedAssets = [];
        var isAllSelected  = $('#af_AssetNo option[value="0"]').is(':selected');

        if (isAllSelected) {
            // "All" checked → expand to every individual asset in the list
            $('#af_AssetNo option').each(function () {
                if ($(this).val() !== '0') {
                    selectedAssets.push({ val: $(this).val(), text: $(this).text() });
                }
            });
            // If no individual assets exist yet (list only has "All"), fall back to one All row
            if (selectedAssets.length === 0) {
                selectedAssets = [{ val: '0', text: 'All' }];
            }
        } else {
            // Specific assets chosen via Ctrl+click
            $('#af_AssetNo option:selected').each(function () {
                selectedAssets.push({ val: $(this).val(), text: $(this).text() });
            });
            if (selectedAssets.length === 0) selectedAssets = [{ val: '0', text: 'All' }];
        }

        $('#af_emptyRow').remove();

        $.each(selectedAssets, function (i, asset) {
            afRowCount++;
            afNewRowCount++;
            var idx = afRowCount;

            var _today = new Date().toISOString().split('T')[0];
            var row =
                '<tr id="af_row_' + idx + '" data-idx="' + idx + '" data-id="0" data-new-row="1"' +
                ' data-station-id="' + stationVal + '" data-assettype-id="' + assetTypeVal + '" data-assetno-id="' + asset.val + '">' +
                '<td style="text-align:center;font-weight:700;color:#1a2d5a;">' + idx + '</td>' +
                '<td style="font-weight:500;color:#1a2d5a;">' + stationText + '</td>' +
                '<td>' + assetTypeText + '</td>' +
                '<td>' + (asset.val === '0' ? 'All' : asset.text) + '</td>' +
                '<td style="min-width:140px;">' +
                  '<input type="date" class="af-cell-input" id="af_incidenceDT_' + idx + '" max="' + _today + '" style="width:100%;height:28px;">' +
                '</td>' +
                '<td style="min-width:140px;">' +
                  '<input type="date" class="af-cell-input" id="af_rectificationDT_' + idx + '" max="' + _today + '" style="width:100%;height:28px;">' +
                '</td>' +
                '<td style="min-width:150px;"><select class="af-cell-select" id="af_causeCode_' + idx + '" disabled><option value="0">Loading...</option></select></td>' +
                '<td style="min-width:160px;"><textarea class="af-cell-textarea" id="af_remark_' + idx + '" rows="2" maxlength="350" placeholder="Max 50 words..." oninput="afLimitWords(this,50)"></textarea></td>' +
                '<td style="text-align:center;white-space:nowrap;min-width:125px;">' +
                  '<div class="af-row-actions">' +
                  '<button class="af-btn af-btn-del" onclick="afDeleteRow(' + idx + ')"><i class="fa fa-trash"></i> Del</button>' +
                  '<button class="af-btn af-btn-save" onclick="afSaveRow(' + idx + ')"><i class="fa fa-save"></i> Save</button>' +
                  '</div></td></tr>';

            $('#vf_ListBody').prepend(row);

            (function (rowIdx, atVal) {
                afLoadCauseCodes(atVal, function (list) {
                    $('#af_causeCode_' + rowIdx).html(afBuildCauseCodeOptions(list)).prop('disabled', false);
                });
            }(idx, assetTypeVal));
        });

        $('#btnSaveAllFailures').show();
    }

