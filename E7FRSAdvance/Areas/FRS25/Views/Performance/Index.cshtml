    function fnGetAlertPerformanceReport() {
        var mAssetLister = { SearchCriteria: {} };

        mAssetLister.SearchCriteria.ZoneIds = getValues('zone');
        mAssetLister.SearchCriteria.DivisionIds = getValues('division');
        mAssetLister.SearchCriteria.SiteIds = getValues('site');

        var fromDateDisplay = $('#txtFromDate').val();
        var toDateDisplay = $('#txtToDate').val();
        if (!fromDateDisplay || !toDateDisplay) {
            showWarning('Please select both From Date and To Date.', 'Validation');
            return;
        }

        // THE AUTHORITY on the range, not the calendars. The pickers stop the mistake being
        // made by hand; this stops it being made any other way -- a prefilled value, a reset
        // run from code, a field left over from a page that has been open since yesterday.
        // Nothing is sent to the server until this passes.
        var fromDateObj = pfParseDisplay(fromDateDisplay);
        var toDateObj = pfParseDisplay(toDateDisplay);
        var rangeError = pfCheckRange(fromDateObj, toDateObj);
        if (rangeError) {
            showWarning(rangeError, 'Validation');
            return;
        }

        function toBackend(d) {
            var parts = d.split('/');       // '09/06/2026' → ['09','06','2026']  (DD/MM/YYYY)
            if (parts.length === 3) {
                return parts[1] + '/' + parts[0] + '/' + parts[2];  // '06/09/2026'  (MM/DD/YYYY)
            }
            return d;
        }
        var fromDateBackend = toBackend(fromDateDisplay);
        var toDateBackend = toBackend(toDateDisplay);

        // Is the To Date today? It decides whether the range bar reads "up to now" or
        // "to end of day", and it was never true: toDateBackend is MM/DD/YYYY and todayStr
        // was a UTC yyyy-MM-dd, so the two could not match in any timezone on any date.
        // The range now always showed 23:59:59, including for a range ending today.
        // Compared as dates, against LOCAL today, now that both are already parsed.
        var isToday = (toDateObj.getTime() === pfToday().getTime());

        var fromTime = '00:00:00';
        var toTime = isToday ? getCurrentTime() : '23:59:59';

        // Update info bar with dd/MM/yyyy HH:mm:ss
        $('#dispFromDate').text(fromDateDisplay + ' ' + fromTime);
        $('#dispToDate').text(toDateDisplay + ' ' + toTime);
        $('#selectedRangeBar').css('display', 'flex');

        // Send dates to backend in yyyy-MM-dd format
        mAssetLister.SearchCriteria.FromDate = fromDateBackend;
        mAssetLister.SearchCriteria.ToDate = toDateBackend;

        if (selectedViewType === 'Table') {
            fnLoadTableView(mAssetLister);
        } else {
            fnLoadChartView(mAssetLister, selectedViewType);
        }
    }    function getCurrentTime() {
        var now = new Date();
        var hh = ('0' + now.getHours()).slice(-2);
        var mm = ('0' + now.getMinutes()).slice(-2);
        var ss = ('0' + now.getSeconds()).slice(-2);
        return hh + ':' + mm + ':' + ss;
    }

    // Helper: format date from yyyy-mm-dd to dd/MM/yyyy
    function formatDateDDMMYYYY(dateStr) {
        if (!dateStr) return '';
        var parts = dateStr.split('-');
        if (parts.length === 3) {
            return parts[2] + '/' + parts[1] + '/' + parts[0];
        }
        return dateStr;
    }

    // Helper: format date from yyyy-mm-dd to yyyy-mm-dd (already)
    function formatDateYYYYMMDD(date) {
        var y = date.getFullYear();
        var m = ('0' + (date.getMonth() + 1)).slice(-2);
        var d = ('0' + date.getDate()).slice(-2);
        return y + '-' + m + '-' + d;
    }

    // Helper: get current time in HH:MM:SS (24-hour)
    function getCurrentTime() {
        var now = new Date();
        var hh = ('0' + now.getHours()).slice(-2);
        var mm = ('0' + now.getMinutes()).slice(-2);
        var ss = ('0' + now.getSeconds()).slice(-2);
        return hh + ':' + mm + ':' + ss;
    }

    // Helper: format date (yyyy-mm-dd) and time (HH:MM:SS) to ddMMyyyy_HHmmss for API
    function formatDateTimeForAPI(dateStr, timeStr) {
        if (!dateStr) return '';
        var parts = dateStr.split('-');
        if (parts.length !== 3) return '';
        var day = parts[2];
        var month = parts[1];
        var year = parts[0];
        var timeParts = timeStr.split(':');
        var hour = timeParts[0] || '00';
        var minute = timeParts[1] || '00';
        var second = timeParts[2] || '00';
        return day + month + year + '_' + hour + minute + second;
    }

