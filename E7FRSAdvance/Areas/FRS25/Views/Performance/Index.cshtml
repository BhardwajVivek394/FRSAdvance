    function openActualFailureModal() {
        afRowCount = 0;
        afCauseCodeCache = {};
        afNewRowCount = 0;
        $('#btnSaveAllFailures').hide();
        // Reset filters. pfIsoLocal, not toISOString: the latter is UTC and hands back
        // YESTERDAY in IST until 05:30, so the modal opened on the wrong day's list every
        // morning -- and would now open on a date its own max attribute excludes.
        var today = pfIsoLocal();
        $('#vf_FromDate').val(today);
        $('#vf_ToDate').val(today);
        $('#vf_Station').val('0');
        vfApplyDateBounds('to');
        afFilterAssetTypes = [];
        // Show modal and auto-load today's list
        $('#modal-ActualFailureEntry').modal('show');
        vfLoadList();
    }
    /** Close the modal — works for both Bootstrap 4 and 5 */
    function closeActualFailureModal() {
        try {
            // Bootstrap 5
            var modalEl = document.getElementById('modal-ActualFailureEntry');
            var bsModal = bootstrap.Modal.getInstance(modalEl);
            if (bsModal) { bsModal.hide(); return; }
        } catch(e) {}
        try {
            // Bootstrap 4 / jQuery
            $('#modal-ActualFailureEntry').modal('hide');
        } catch(e) {}
    }

