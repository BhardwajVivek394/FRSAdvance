    // ===== CHART VIEW =====
    function fnLoadChartView(mAssetLister, viewType) {
        $("#loader").show();
        $('#divTableContainer').hide();
        $('#divChartContainer').show();

        // First load table data to parse for chart
        $.ajax({
            url: '/FRS25/Performance/_List',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            dataType: 'html',
            success: function (data) {
                $("#loader").hide();

                // Parse table data to extract chart data
                var chartData = parseTableDataForChart(data);

                if (chartData.labels.length > 0) {
                    renderChart(chartData, viewType);
                } else {
                    renderNoData();
                }
            },
            error: function () {
                $("#loader").hide();
                showError("Something went wrong!", "Error");
            }
        });
    }

    // ===== PARSE TABLE DATA FOR CHART =====
    function parseTableDataForChart(htmlData) {
        var $temp = $('<div>').html(htmlData);
        var $rows = $temp.find('tbody tr[data-station]');

        var labels = [];
        var failurePercentages = [];
        var predictivePercentages = [];
        var rdpmsPercentages = [];

        $rows.each(function () {
            var station = $(this).data('station') || '';
            var failPct = parseFloat($(this).data('failure')) || 0;
            var predPct = parseFloat($(this).data('predictive')) || 0;
            var rdpmsPct = parseFloat($(this).data('rdpms')) || 0;

            if (station) {
                labels.push(station);
                failurePercentages.push(failPct);
                predictivePercentages.push(predPct);
                rdpmsPercentages.push(rdpmsPct);
            }
        });

        return {
            labels: labels,
            failure: failurePercentages,
            predictive: predictivePercentages,
            rdpms: rdpmsPercentages
        };
    }

    // ===== NO DATA VIEW =====
    function renderNoData() {
        var html = '<div class="chart-container">' +
            '<div class="no-data-box">' +
            '<i class="fas fa-chart-bar"></i>' +
            '<p>No data available for visualization</p>' +
            '</div></div>';
        $('#divChartContainer').html(html);
    }

    // ===== RENDER CHART =====
    function renderChart(data, viewType) {
        // Destroy existing chart
        if (performanceChart != null) {
            performanceChart.destroy();
            performanceChart = null;
        }

        var chartTitle = viewType === 'Pie' ? 'Performance Distribution (Average %)' :
            viewType === 'Graph' ? 'Performance Trend Analysis' : 'Performance Comparison by Station';

        var $container = $('#divChartContainer');
        $container.empty();

        var $chartContainer = $('<div class="chart-container"></div>');
        var $chartHeader = $('<div class="chart-header"><h4 class="chart-title">' + chartTitle + '</h4></div>');
        var $chartWrapper = $('<div class="chart-wrapper"></div>');
        var $canvas = $('<canvas id="performanceChart"></canvas>');

        $chartWrapper.append($canvas);
        $chartContainer.append($chartHeader).append($chartWrapper);

        // Add legend
        var $legend = $('<div class="chart-legend">' +
            '<div class="legend-item"><div class="legend-color" style="background:' + chartColors.failure + '"></div><span>% (True + PT) Failure Alerts</span></div>' +
            '<div class="legend-item"><div class="legend-color" style="background:' + chartColors.predictive + '"></div><span>% (True + PT) Predictive Alerts</span></div>' +
            '<div class="legend-item"><div class="legend-color" style="background:' + chartColors.rdpms + '"></div><span>% Failure Alerts by RDPMS</span></div>' +
            '</div>');

        $chartContainer.append($legend);
        $container.append($chartContainer);

        var ctx = $canvas[0].getContext('2d');
        var chartConfig = {};

        // ===== PIE CHART =====
        if (viewType === 'Pie') {
            // Calculate averages for pie chart
            var avgFailure = data.failure.length > 0 ? data.failure.reduce(function (a, b) { return a + b; }, 0) / data.failure.length : 0;
            var avgPredictive = data.predictive.length > 0 ? data.predictive.reduce(function (a, b) { return a + b; }, 0) / data.predictive.length : 0;
            var avgRdpms = data.rdpms.length > 0 ? data.rdpms.reduce(function (a, b) { return a + b; }, 0) / data.rdpms.length : 0;

            chartConfig = {
                type: 'doughnut',
                data: {
                    labels: ['% (True + PT) Failure Alerts', '% (True + PT) Predictive Alerts', '% Failure Alerts by RDPMS'],
