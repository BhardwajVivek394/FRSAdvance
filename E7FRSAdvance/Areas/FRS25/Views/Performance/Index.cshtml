    /** Limit textarea to N words */
    function afLimitWords(el, maxWords) {
        var words = el.value.trim().split(/\s+/).filter(function (w) { return w.length > 0; });
        if (words.length > maxWords) { el.value = words.slice(0, maxWords).join(' '); }
    }

