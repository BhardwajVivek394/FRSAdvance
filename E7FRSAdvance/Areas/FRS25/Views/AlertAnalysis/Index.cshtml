    function rvDrawChart(cid){
        try{
            var C=_rvCharts[cid]; if(!C){ return; }
            var el=document.getElementById(cid); if(!el||typeof window.Chart!=='function'){ return; }
            if(_rvCharts[cid]._chart){ try{ _rvCharts[cid]._chart.destroy(); }catch(e){} }
            var data=C.pts.map(function(p){ return { x:p[0], y:p[1] }; });
            var t0=C.pts[0][0], t1=C.pts[C.pts.length-1][0];
            var ann=[];
            function mk(tsStr,color,lbl){
                if(!tsStr){ return; }
                var mt=C.tsFn(tsStr); if(isNaN(mt)||mt<t0||mt>t1){ return; }
                ann.push({ x:mt, color:color, lbl:lbl });
            }
            mk(C.alertTs,'#dc2626','ALERT'); mk(C.resetTs,'#059669','RESET');
            // custom plugin: threshold band + reference lines + alert/reset verticals
            var refPlugin={ id:'rvrefs', afterDraw:function(ch){
                var ctx=ch.ctx, xa=ch.scales.x, ya=ch.scales.y, ar=ch.chartArea;
