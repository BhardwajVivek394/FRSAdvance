                                            <script>/* ================= ALERT ANALYSIS TRIAGE BOARD ================= */
    var AA_ALERTS = [];
    var AA_INRANGE = [];
    var AA_SITES = [];
    var AA_CAUSES = [];
    var AA_TOTF = 0;
    var AA_TOTP = 0;
    var aaState = { site: null, type: null, cause: null, assetClass: null, bm: false };   // v1.0.55.175: bm
    var aaDate = { fromMs: null, toMs: null, days: 1 };   // v1.0.55.55: default 24h (was 7d)

    // ================= v1.0.55.109: LIVE ALERT EVENTS =================
    // Subscribes to the broadcaster's alert feed for every site currently on the board and
    // raises a toast the moment an alert fires, then silently refreshes the board so the new
    // alert appears in place. One socket per site, opened/closed by reconciliation against
    // AA_SITES -- filters change the board constantly, so aeSync() must be idempotent.
    // DELIBERATELY NOT AUTO-ANALYSING: a just-fired alert has not settled (no reset, telemetry
    // still arriving), and an automatic verdict on every event would both cost model calls per
    // alert and cache a verdict formed on incomplete evidence -- the .153 lesson. The toast
    // offers Analyze; the human decides.
    // The message SHAPE is not contractually known here, so the parser is tolerant: it accepts
    // a bare object, an array, or a {data|payload|alert|body} envelope, and finds each field by
    // trying the plausible names. An unparseable frame still refreshes the board and logs the
    // raw payload to the console (aeLog) so the real shape can be read off one live event.
    var AE_BASE = '@(System.Configuration.ConfigurationManager.AppSettings["AlertEventsWsBase"] ?? "wss://energy7.in:58081")';
    var AE_MAXSITES = 12;          // a board showing 40 sites must not open 40 sockets
    var AE_SOCKS = {};             // siteId -> { ws, tries, timer, closed }
    var AE_SEEN = {};              // dedupe key -> ts (the same event can arrive twice)
    var AE_RELOAD_T = null;

    function aeLog(msg, extra) {
        try { if (window.console && console.debug) { console.debug('[alertEvents] ' + msg, extra === undefined ? '' : extra); } } catch (e) { }
    }
    function aeDesiredSites() {
        var out = [];
        for (var i = 0; i < AA_SITES.length && out.length < AE_MAXSITES; i++) {
            var s = AA_SITES[i] ? AA_SITES[i].siteId : null;
            if (s === null || s === undefined || String(s) === '') { continue; }
            s = String(s);
            if (out.indexOf(s) < 0) { out.push(s); }
        }
        return out;
    }
    function aeSync() {
        if (!AE_BASE || typeof WebSocket === 'undefined') { return; }
        var want = aeDesiredSites();
        for (var i = 0; i < want.length; i++) {
            if (!AE_SOCKS[want[i]]) { aeConnect(want[i], { tries: 0 }); }
        }
        for (var k in AE_SOCKS) {
            if (!AE_SOCKS.hasOwnProperty(k)) { continue; }
            if (want.indexOf(k) < 0) { aeClose(k); }
        }
    }
    function aeConnect(siteId, seed) {
        var st = AE_SOCKS[siteId];
        if (!st) { st = { ws: null, tries: (seed && seed.tries) || 0, timer: null, closed: false }; AE_SOCKS[siteId] = st; }
        if (st.closed) { return; }
        var url = String(AE_BASE).replace(/\/+$/, '') + '/subscribe/alertEvents/' + encodeURIComponent(siteId);
        var ws;
        try { ws = new WebSocket(url); } catch (e) { aeRetry(siteId); return; }
        st.ws = ws;
        ws.onopen = function () { st.tries = 0; aeLog('subscribed site ' + siteId); };
        ws.onmessage = function (ev) { aeOnEvent(siteId, ev.data); };
        ws.onerror = function () { };
        ws.onclose = function () { st.ws = null; if (!st.closed) { aeRetry(siteId); } };
    }
    function aeRetry(siteId) {
        var st = AE_SOCKS[siteId];
        if (!st || st.closed) { return; }
        st.tries++;
        var wait = Math.min(30000, 3000 * st.tries);   // 3s, 6s, 9s ... capped at 30s
        if (st.timer) { clearTimeout(st.timer); }
        st.timer = setTimeout(function () { st.timer = null; aeConnect(siteId); }, wait);
    }
    function aeClose(siteId) {
        var st = AE_SOCKS[siteId];
        if (!st) { return; }
        st.closed = true;
        if (st.timer) { clearTimeout(st.timer); st.timer = null; }
        try { if (st.ws) { st.ws.close(); } } catch (e) { }
        delete AE_SOCKS[siteId];
    }
    function aeField(o, names) {
        for (var i = 0; i < names.length; i++) {
            var v = o[names[i]];
            if (v !== undefined && v !== null && String(v).length > 0) { return String(v); }
        }
        return '';
    }
    function aeUnwrap(o) {
        // {type:'alert', data:{...}} / {payload:{...}} / {alert:{...}} / {body:{...}}
        var keys = ['data', 'payload', 'alert', 'body', 'Alert', 'Data'];
        for (var i = 0; i < keys.length; i++) {
            var v = o[keys[i]];
            if (v && typeof v === 'object' && !(v instanceof Array)) { return v; }
        }
        return o;
    }
    function aeOnEvent(siteId, raw) {
        var parsed = null;
        try { parsed = JSON.parse(raw); } catch (e) { parsed = null; }
        if (!parsed || typeof parsed !== 'object') {
            aeLog('unparseable frame -- refreshing board anyway', raw);
            aeReloadSoon();
            return;
        }
        var list = (parsed instanceof Array) ? parsed : [parsed];
        for (var i = 0; i < list.length; i++) {
            if (!list[i] || typeof list[i] !== 'object') { continue; }
            aeShow(siteId, aeUnwrap(list[i]));
        }
        aeReloadSoon();
    }
    function aeShow(siteId, a) {
        var id = aeField(a, ['alertId', 'AlertId', 'Id', 'id', 'alert_id']);
        var asset = aeField(a, ['assetName', 'AssetName', 'asset', 'Asset', 'assetname']);
        var cause = aeField(a, ['causeCode', 'CauseCode', 'alertCode', 'AlertCode', 'cause', 'Cause', 'description', 'Description']);
        var site = aeField(a, ['stationName', 'StationName', 'siteName', 'SiteName', 'station', 'Station']);
        var type = aeField(a, ['alertType', 'AlertType', 'type', 'Type', 'category', 'Category']);
        if (!site) { site = aeSiteName(siteId); }
        var key = id ? ('id:' + id) : ('k:' + siteId + '|' + asset + '|' + cause);
        var nowMs = Date.now();
        for (var k in AE_SEEN) { if (AE_SEEN.hasOwnProperty(k) && nowMs - AE_SEEN[k] > 90000) { delete AE_SEEN[k]; } }
        if (AE_SEEN[key]) { return; }
        AE_SEEN[key] = nowMs;
        if (!id && !asset && !cause) { aeLog('event with no recognised fields -- shape check needed', a); }
        aeToast(id, site, asset, cause, type);
    }
    function aeSiteName(siteId) {
        for (var i = 0; i < AA_SITES.length; i++) {
            if (AA_SITES[i] && String(AA_SITES[i].siteId) === String(siteId)) { return AA_SITES[i].name || String(siteId); }
        }
        return String(siteId);
    }
    function aeReloadSoon() {
        if (AE_RELOAD_T) { clearTimeout(AE_RELOAD_T); }
        // A burst of events at one site must produce ONE reload, not one per event.
        AE_RELOAD_T = setTimeout(function () {
            AE_RELOAD_T = null;
            try { if (typeof fnLoadAlerts === 'function') { fnLoadAlerts(true); } } catch (e) { }
        }, 4000);
    }
    function aeToast(id, site, asset, cause, type) {
        var box = document.getElementById('aeToasts');
        if (!box) {
            box = document.createElement('div');
            box.id = 'aeToasts';
            document.body.appendChild(box);
        }
        var isFail = /fail/i.test(type || '') || /fail/i.test(cause || '');
        var el = document.createElement('div');
        el.className = 'ae-toast' + (isFail ? ' fail' : '');
        var canAnalyze = !!id;
        el.innerHTML = '<div class="ae-h"><span class="ae-dot"></span>Alert triggered'
            + (type ? (' &middot; ' + escapeHtml(type)) : '')
            + '<span class="ae-x" title="Dismiss">&times;</span></div>'
            + '<div class="ae-body"><span class="ae-asset">' + escapeHtml(asset || 'asset') + '</span>'
            + ' at ' + escapeHtml(site || 'site')
            + (cause ? ('<br><span class="ae-cause">' + escapeHtml(cause) + '</span>') : '') + '</div>'
            + '<div class="ae-acts">'
            + (canAnalyze ? '<button class="pri" data-ae-go="1">Analyze</button>' : '')
            + '<button data-ae-x="1">Dismiss</button></div>';
        var kill = function () { try { if (el.parentNode) { el.parentNode.removeChild(el); } } catch (e) { } };
        var x = el.querySelector('.ae-x'); if (x) { x.onclick = kill; }
        var dz = el.querySelector('[data-ae-x]'); if (dz) { dz.onclick = kill; }
        var go = el.querySelector('[data-ae-go]');
        if (go) { go.onclick = function () { kill(); aeAnalyze(id); }; }
        box.appendChild(el);
        // Long enough to notice from across a control room, short enough not to stack up.
        setTimeout(kill, 45000);
        while (box.children.length > 4) { box.removeChild(box.firstChild); }
    }
    function aeAnalyze(id) {
        var n = parseInt(id, 10);
        if (!n) { return; }
        var open = function () {
            try {
                if (typeof aaInsightGo === 'function') { aaInsightGo(n); return true; }
                if (typeof fnRowAnalyze === 'function') { fnRowAnalyze(n); return true; }
            } catch (e) { }
            return false;
        };
        var have = true;
        try { have = (typeof aaRowById !== 'function') || !!aaRowById(n); } catch (e) { have = true; }
        if (have) { open(); return; }
        // The event beat the board refresh: pull the list, then open.
        try { if (typeof fnLoadAlerts === 'function') { fnLoadAlerts(true); } } catch (e) { }
        setTimeout(open, 2500);
    }
    try {
        document.addEventListener('visibilitychange', function () {
            // A laptop resumed from sleep has dead sockets; reconcile on return.
            if (!document.hidden) { try { aeSync(); } catch (e) { } }
        });
    } catch (e) { }
    // ================= end live alert events =================
    var aaPieType = null;
    var AA_PIE_COLORS = ['#5457e6','#17976a','#e0961a','#dc2f4a','#7c3aed','#0ea5a4','#64748b','#c026d3'];
    var _aaRefreshPaused = false;
    var _aaRefreshPending = false;

    $(document).ready(function () {
        // v1.0.55.31: SITE-KEEPING ROLE GATE (merged from the other team's Index_21).
        // Null-safe on purpose: their Razor dereferences LoginUser directly, which throws if the
        // view renders without a session. A missing LoginUser is treated as NOT site-keeping, which
        // is also what their server-side SafeIsSiteKeeping() does.
        // NOTE: their file also hard-codes a test-user email override -- deliberately NOT copied.
        // v1.0.55.54: display name for the exported record, read in RAZOR (synchronous -- LoginUser
        // is available here; the controller cannot read it after its first await).
        var _aiUserName = '@(E7FRSAdvance.Utility.ClsHttpContent.LoginUser != null
            ? ((E7FRSAdvance.Utility.ClsHttpContent.LoginUser.FirstName ?? "") + " " +
               (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.LastName ?? "")).Trim()
            : "Operator")';
        if (!_aiUserName) { _aiUserName = 'Operator'; }
        window._aiUserName = _aiUserName;
        // v1.0.55.63: the override list and the user's email are NO LONGER emitted into JavaScript.
        // The match runs server-side in the Razor block at the top of this view; only the resolved
        // boolean reaches the browser.
        var AA_SITEKEEP = @(__aaPrivileged ? "true" : "false");
        // v1.0.55.55: publish on window AFTER the email override has run. The other team's gate fix
        // tests `window.AA_SITEKEEP === true`, but here AA_SITEKEEP is a plain `var` in this script
        // block -- window.AA_SITEKEEP would be undefined and the Debug button would never appear,
        // even for a site-keeping user. Set it here, after the override, so both the gate and the
        // re-show read the same resolved value.
        window.AA_SITEKEEP = (AA_SITEKEEP === true);
        if (!AA_SITEKEEP) { try { aaApplySiteKeepGate(); } catch (e) { } }
        // v1.0.53.0: trend chart chip toggles (delegated -- chips are injected with the verdict)
        $(document).on('click', '.rvz-chip[data-ci]', function () {
            var ci = parseInt($(this).attr('data-ci'), 10);
            var cid = $(this).attr('data-cid');
            var C = _rvCharts[cid]; if (!C) { return; }
            C._hidden = C._hidden || {};
            var nowHidden = !(C._hidden[ci]);
            C._hidden[ci] = nowHidden;
            $(this).toggleClass('off', nowHidden).toggleClass('on', !nowHidden);
            // v1.0.55.0: small-multiples -> show/hide the CELL and (re)draw remaining
            try{
                var cell = document.querySelector('#'+cid+'_row .rvz-cell[data-ci="'+ci+'"]');
                if(cell){ cell.style.display = nowHidden ? 'none' : ''; }
                if(C._charts && C._charts[ci] && nowHidden){ try{ C._charts[ci].destroy(); }catch(e){} C._charts[ci]=null; }
            }catch(e){}
            rvDrawCells(cid);
        });
        // v1.0.55.8: event-zoom buttons (delegated -- injected with the verdict)
        $(document).on('click', '.rvz-zb[data-zdir]', function(){ rvZoom($(this).attr('data-cid'), parseInt($(this).attr('data-zdir'),10)); });
        $(document).on('click', '.rvz-zb[data-zfit]', function(){ rvZoomFit($(this).attr('data-cid')); });
        $(document).on('click', '.rvz-zb[data-zfull]', function(){ rvZoomFull($(this).attr('data-cid')); });
        $(document).on('click', '.rvz-zb[data-zview]', function(){ rvSetView($(this).attr('data-cid'), $(this).attr('data-zview')); });
        $(document).on('click', '.rvz-zb[data-zsync]', function(){ rvToggleSync($(this).attr('data-cid')); });
        fnAaInitDate(); fnAaMarkPreset();
        fnLoadAlerts(false);
        setInterval(function () { fnLoadAlerts(true); }, 600000);

        $(document).on('show.bs.modal', '#aaAlertModal', function () {
            _aaRefreshPaused = true;
        });
        $(document).on('hidden.bs.modal', '#aaAlertModal', function () {
            aiTraceFlush();   // v1.0.55.25: never carry a trace past the window that produced it
            _aaRefreshPaused = false;
            if (_aaRefreshPending) {
                _aaRefreshPending = false;
                fnLoadAlerts(true);
            }
        });
    });

    // v1.0.55.56 (from the other team, verbatim): dd/mm/yyyy -> MM/DD/YYYY for the server.
    // See the version note: both call sites pass an ISO string, which this returns unchanged.
    // v1.0.55.74: send LOCAL wall-clock, no zone marker. `toISOString()` yields UTC with a
    // trailing Z; MVC then binds that as UTC and shifts the window +5.5 h in IST, so alerts between
    // the picked time and 5.5 h later never reached the board. The alert timestamps this filters
    // against are stored as naive local DateTime, so the request must be naive local too.
    function toServerDate(ms) {
        if (ms == null || ms === '') { return ''; }
        var d = (ms instanceof Date) ? ms : new Date(ms);
        if (isNaN(d.getTime())) { return ''; }
        function p2(n) { return (n < 10 ? '0' : '') + n; }
        return d.getFullYear() + '-' + p2(d.getMonth() + 1) + '-' + p2(d.getDate())
             + 'T' + p2(d.getHours()) + ':' + p2(d.getMinutes()) + ':' + p2(d.getSeconds());
    }

    function fnLoadAlerts(silent) {
        if (_aaRefreshPaused) {
            _aaRefreshPending = true;
            return;
        }
        if (!silent) { $('#loader, #e7-loader').show(); }
        // v1.0.55.56 (from the other team): send the date range to the server instead of fetching
        // everything and filtering in the browser.
        var body = {};
        // v1.0.55.74: pass the millisecond value straight through -- no toISOString(), which was
        // what introduced the UTC shift.
        if (aaDate.fromMs != null) { body.fromDate = toServerDate(aaDate.fromMs); }
        if (aaDate.toMs != null) { body.toDate = toServerDate(aaDate.toMs); }
        $.ajax({
            url: '@Url.Action("GetLiveAlerts", "AlertAnalysis")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(body),
            success: function (data) {
                if (!silent) { $('#loader, #e7-loader').hide(); }
                AA_ALERTS = [];
                if (data && data.length) {
                    for (var i = 0; i < data.length; i++) {
                        var d = data[i];
                        AA_ALERTS.push({
                            id: d.Id,
                            siteId: d.SiteId,
                            station: d.SiteName || '',
                            zone: d.ZoneName || '',
                            division: d.DivisionName || '',
                            type: d.AlertType || '',
                            asset: d.AssetName || '',
                            assetType: d.AssetType || '',
                            code: d.CauseCode || '',
                            timeText: d.TimeText || '-',
                            timeSort: d.TimeSort || '',
                            resetText: d.ResetText || '',      // v1.0.55.65: '' means still open
                            durationText: d.DurationText || '',
                            remark: d.Remark || '',                      // v1.0.55.76
                            maintRemark: d.MaintainerRemarks || ''
                        });
                    }
                }
                fnAaDerive();
                fnAaRenderAll();
                fnAaLoadBookmarks();   // v1.0.55.174
            },
            error: function () {
                if (!silent) { $('#loader, #e7-loader').hide(); }
                $('#aaRows').html('<tr class="aa-empty"><td colspan="11">Failed to load alerts. <a href="javascript:void(0)" onclick="fnLoadAlerts(false)">Retry</a></td></tr>');
                $('#aaCountTxt').text('Error');
            }
        });
    }

    var AA_CLASSES = [
        { key: 'TC', name: 'Track circuit' },
        { key: 'PT', name: 'Point machine' },
        { key: 'SIG', name: 'Signal' },
        { key: 'IPS', name: 'Power supply' },
        { key: 'OTH', name: 'Other' }
    ];
    function aaClassOf(code) {
        var c = (code || '').toUpperCase().replace(/^\s+/, '');
        if (c.indexOf('TC') === 0) { return 'TC'; }
        if (c.indexOf('PT') === 0) { return 'PT'; }
        if (c.indexOf('IPS') === 0) { return 'IPS'; }
        if (c.indexOf('SIG') >= 0) { return 'SIG'; }
        return 'OTH';
    }
    function aaPad(n){ return n < 10 ? '0' + n : '' + n; }
    function aaToLocalInput(d){ return d.getFullYear() + '-' + aaPad(d.getMonth()+1) + '-' + aaPad(d.getDate()) + 'T' + aaPad(d.getHours()) + ':' + aaPad(d.getMinutes()); }
    function fnAaInitDate(){
        var to = new Date();
        var from = new Date(to.getTime() - aaDate.days * 86400000);
        var eF = document.getElementById('aaDateFrom'), eT = document.getElementById('aaDateTo');
        if (eF) { eF.value = aaToLocalInput(from); }
        if (eT) { eT.value = aaToLocalInput(to); }
        aaDate.fromMs = from.getTime(); aaDate.toMs = to.getTime();
    }
    function fnAaReadDate(){
        var eF = document.getElementById('aaDateFrom'), eT = document.getElementById('aaDateTo');
        aaDate.fromMs = (eF && eF.value) ? Date.parse(eF.value) : null;
        aaDate.toMs   = (eT && eT.value) ? Date.parse(eT.value) : null;
        aaDate.days = null;
        fnAaMarkPreset();
        fnAaApplyDate();
    }
    function fnAaPreset(days){
        aaDate.days = days; fnAaInitDate(); fnAaMarkPreset(); fnAaApplyDate();
    }
    function fnAaMarkPreset(){
        var btns = document.querySelectorAll('#aaPresets button');
        for (var i = 0; i < btns.length; i++) {
            var d = parseInt(btns[i].getAttribute('data-d'), 10);
            btns[i].className = (aaDate.days === d) ? 'on' : '';
        }
    }
    function aaInRange(){
        if (aaDate.fromMs == null && aaDate.toMs == null) { return AA_ALERTS.slice(); }
        var out = [];
        for (var i = 0; i < AA_ALERTS.length; i++) {
            var t = Date.parse(AA_ALERTS[i].timeSort);
            if (isNaN(t)) { out.push(AA_ALERTS[i]); continue; }
            if (aaDate.fromMs != null && t < aaDate.fromMs) { continue; }
            if (aaDate.toMs != null && t > aaDate.toMs) { continue; }
            out.push(AA_ALERTS[i]);
        }
        return out;
    }
    // v1.0.55.80: the window is a SERVER filter (since 1.0.55.56 the range is posted with the
    // request), so changing it must REFETCH. Re-deriving the local set alone can only ever narrow
    // what was already downloaded -- widening the window silently showed nothing new.
    function fnAaApplyDate(){
        fnAaDerive(); fnAaRenderAll();      // immediate feedback from what we already hold
        fnAaReloadDebounced();              // then go and get the real set for the new window
    }
    // Debounced: the datetime-local spinner fires change on every increment, and each fires a POST.
    var _aaReloadT = null;
    function fnAaReloadDebounced(){
        if (_aaReloadT) { clearTimeout(_aaReloadT); }
        _aaReloadT = setTimeout(function () {
            _aaReloadT = null;
            try { fnLoadAlerts(true); } catch (e) { }   // silent: no full-screen loader on a window nudge
        }, 350);
    }
    function fnAaDerive() {
        AA_INRANGE = aaInRange();
        var m = {};
        AA_TOTF = 0; AA_TOTP = 0;
        for (var i = 0; i < AA_INRANGE.length; i++) {
            var a = AA_INRANGE[i];
            if (!m[a.station]) { m[a.station] = { name: a.station, siteId: a.siteId, f: 0, p: 0, of: 0, op: 0 }; }
            // v1.0.55.82: OPEN = no reset time. The status pill is about NOW; the f/p totals are
            // about the window. Conflating them is what made a cleared site read ATTENTION.
            if (!a.resetText) { if (a.type === 'Failure') { m[a.station].of++; } else { m[a.station].op++; } }
            if (a.type === 'Failure') { m[a.station].f++; AA_TOTF++; }
            else { m[a.station].p++; AA_TOTP++; }
        }
        AA_SITES = [];
        for (var k in m) { if (m.hasOwnProperty(k)) { AA_SITES.push(m[k]); } }
        AA_SITES.sort(function (x, y) { return (y.f - x.f) || ((y.f + y.p) - (x.f + x.p)) || x.name.localeCompare(y.name); });

        var cm = {};
        for (var j = 0; j < AA_INRANGE.length; j++) { cm[AA_INRANGE[j].code] = (cm[AA_INRANGE[j].code] || 0) + 1; }
        AA_CAUSES = [];
        for (var c in cm) { if (cm.hasOwnProperty(c)) { AA_CAUSES.push({ code: c, n: cm[c] }); } }
        AA_CAUSES.sort(function (x, y) { return (y.n - x.n) || x.code.localeCompare(y.code); });

        if (aaState.site && !m[aaState.site]) { aaState.site = null; }
        if (aaState.cause && !cm[aaState.cause]) { aaState.cause = null; }
        // v1.0.55.109: AA_SITES was just rebuilt -- reconcile the live-event subscriptions
        // against it. Idempotent: opens only what is missing, closes only what left the board.
        try { aeSync(); } catch (e) { }
    }

    function aaRowById(id) {
        for (var i = 0; i < AA_ALERTS.length; i++) { if (AA_ALERTS[i].id === id) { return AA_ALERTS[i]; } }
        return null;
    }

    function fnAaFiltered() {
        var out = [];
        for (var i = 0; i < AA_INRANGE.length; i++) {
            var a = AA_INRANGE[i];
            if (aaState.site && a.station !== aaState.site) { continue; }
            if (aaState.type && a.type !== aaState.type) { continue; }
            if (aaState.cause && a.code !== aaState.cause) { continue; }
            if (aaState.assetClass && aaClassOf(a.code) !== aaState.assetClass) { continue; }
            if (aaState.bm && !AA_BM[a.id]) { continue; }   // v1.0.55.175
            out.push(a);
        }
        return out;
    }

    // v1.0.55.155: the counting SCOPE. AA_INRANGE is the whole window (every site); when a site tile
    // is selected the header spills, the Asset-type chips and the All/Failure/Predictive segment must
    // count within that site to match the list the two views actually show. Site ONLY -- those three
    // are themselves the other facets, so they must not self-narrow by type/cause. No site selected
    // returns AA_INRANGE unchanged, so behaviour with no filter is identical to before.
    function aaScope() {
        if (!aaState.site) { return AA_INRANGE; }
        var out = [];
        for (var i = 0; i < AA_INRANGE.length; i++) {
            if (AA_INRANGE[i].station === aaState.site) { out.push(AA_INRANGE[i]); }
        }
        return out;
    }
    function aaScopeTot() {
        var sc = aaScope(), f = 0, p = 0;
        for (var i = 0; i < sc.length; i++) { if (sc[i].type === 'Failure') { f++; } else { p++; } }
        return { list: sc, n: sc.length, f: f, p: p };
    }

    function fnAaRenderAll() {
        var _sc = aaScopeTot();   // v1.0.55.155: header spills follow the SELECTED SITE
        $('#aaStatPred').text(_sc.p); $('#aaStatFail').text(_sc.f); $('#aaStatTotal').text(_sc.n);
        fnAaRenderTypeChips();
        fnAaRenderRail(); fnAaRenderSeg(); fnAaRenderTable();   // v1.0.55.64: cause-by-asset lanes removed
        aaBmPaintFilter();   // v1.0.55.175
        // v1.0.55.69: ONE batched state lookup per data load. Called here, NOT inside
        // fnAaRenderTable, or the success handler's re-render would fetch again forever.
        fnAaLoadVerdictStates(AA_INRANGE);
    }

    function aaTypeCounts(){
        var m = {}; var order = [];
        var scope = aaScope();   // v1.0.55.155: Asset-type counts follow the SELECTED SITE
        for (var i = 0; i < scope.length; i++) {
            var t = (scope[i].assetType || 'UNKNOWN').toUpperCase();
            if (!m[t]) { m[t] = 0; order.push(t); }
            m[t]++;
        }
        order.sort(function(a,b){ return m[b]-m[a] || a.localeCompare(b); });
        return { map: m, order: order };
    }
    function fnAaRenderTypeChips(){
        var tc = aaTypeCounts();
        var h = '';
        for (var i = 0; i < tc.order.length; i++) {
            var t = tc.order[i];
            var on = (aaPieType === t) ? ' on' : '';
            h += '<button class="aa-typechip' + on + '" onclick="fnAaTogglePie(\'' + t.replace(/'/g,"\\'") + '\')">' + escapeHtml(t) + '<b>' + tc.map[t] + '</b></button>';
        }
        $('#aaTypeChips').html(h);
        if (aaPieType && !tc.map[aaPieType]) { aaPieType = null; }
        fnAaRenderPie();
    }
    function fnAaTogglePie(t){ aaPieType = (aaPieType === t) ? null : t; fnAaRenderTypeChips(); }
    function aaArc(cx, cy, R, r, a0, a1, fill){
        var large = (a1 - a0) > Math.PI ? 1 : 0;
        var x1 = cx + R*Math.cos(a0), y1 = cy + R*Math.sin(a0);
        var x2 = cx + R*Math.cos(a1), y2 = cy + R*Math.sin(a1);
        var xi2 = cx + r*Math.cos(a1), yi2 = cy + r*Math.sin(a1);
        var xi1 = cx + r*Math.cos(a0), yi1 = cy + r*Math.sin(a0);
        var d = 'M'+x1+' '+y1+' A'+R+' '+R+' 0 '+large+' 1 '+x2+' '+y2+' L'+xi2+' '+yi2+' A'+r+' '+r+' 0 '+large+' 0 '+xi1+' '+yi1+' Z';
        return '<path d="'+d+'" fill="'+fill+'"></path>';
    }
    function fnAaRenderPie(){
        var w = document.getElementById('aaPieWrap');
        if (!w) { return; }
        if (!aaPieType) { w.style.display = 'none'; w.innerHTML = ''; return; }
        var cm = {}, total = 0;
        var scope = aaScope();   // v1.0.55.155: the cause-mix pie follows the SELECTED SITE too
        for (var i = 0; i < scope.length; i++) {
            var a = scope[i];
            if ((a.assetType || 'UNKNOWN').toUpperCase() !== aaPieType) { continue; }
            cm[a.code] = (cm[a.code] || 0) + 1; total++;
        }
        var arr = [];
        for (var k in cm) { if (cm.hasOwnProperty(k)) { arr.push({ code: k, n: cm[k] }); } }
        arr.sort(function(x,y){ return y.n - x.n; });
        var top = arr.slice(0, 7);
        var restN = 0; for (var j = 7; j < arr.length; j++) { restN += arr[j].n; }
        if (restN > 0) { top.push({ code: 'Other (' + (arr.length - 7) + ')', n: restN, other: true }); }
        var cx = 90, cy = 90, R = 82, r = 48, a = -Math.PI/2, svg = '';
        if (top.length === 1) {
            svg = '<circle cx="'+cx+'" cy="'+cy+'" r="'+((R+r)/2)+'" fill="none" stroke="'+AA_PIE_COLORS[0]+'" stroke-width="'+(R-r)+'"></circle>';
        } else {
            for (var s = 0; s < top.length; s++) {
                var frac = top[s].n / total, a1 = a + frac * Math.PI * 2;
                svg += aaArc(cx, cy, R, r, a, a1 - 0.006, top[s].other ? '#c4cad4' : AA_PIE_COLORS[s % AA_PIE_COLORS.length]);
                a = a1;
            }
        }
        var leg = '';
        for (var m2 = 0; m2 < top.length; m2++) {
            var col = top[m2].other ? '#c4cad4' : AA_PIE_COLORS[m2 % AA_PIE_COLORS.length];
            var pct = total ? Math.round(top[m2].n * 100 / total) : 0;
            leg += '<div class="aa-leg-row"><span class="aa-leg-dot" style="background:'+col+'"></span>'+
                '<span class="aa-leg-code">'+escapeHtml(top[m2].code)+'</span>'+
                '<span class="aa-leg-n">'+top[m2].n+' &middot; '+pct+'%</span></div>';
        }
        var html = '<div class="aa-pie">'+
            '<div class="aa-pie-svg"><svg viewBox="0 0 180 180" width="180" height="180">'+svg+
            '<text x="90" y="86" text-anchor="middle" class="aa-pie-num">'+total+'</text>'+
            '<text x="90" y="104" text-anchor="middle" class="aa-pie-sub">alerts</text></svg></div>'+
            '<div class="aa-pie-leg"><div class="aa-pie-title">'+escapeHtml(aaPieType)+' &mdash; cause mix</div>'+leg+'</div>'+
            '</div>';
        w.innerHTML = html; w.style.display = 'block';
    }
    // v1.0.55.62: icon strings for the site tiles (site = signal tower, all = grid roll-up).
    var AA_ICON_SITE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 20a8 8 0 0 1 16 0"/><path d="M8 20a4 4 0 0 1 8 0"/><circle cx="12" cy="20" r="1"/></svg>';
    var AA_ICON_GRID = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>';

    function fnAaRenderRail() {
        var maxF = 1;   // v1.0.55.62: max SITE failure (per design) -- the worst site reads ~100%
        for (var j = 0; j < AA_SITES.length; j++) { if (AA_SITES[j].f > maxF) { maxF = AA_SITES[j].f; } }
        // v1.0.55.82: ALL SITES needs its own OPEN totals, or the summary tile would keep the old
        // window-count behaviour while every site tile beside it reported live status.
        var allOF = 0, allOP = 0;
        for (var z = 0; z < AA_SITES.length; z++) { allOF += (AA_SITES[z].of || 0); allOP += (AA_SITES[z].op || 0); }
        var h = aaSiteCard(null, 'ALL SITES', '', AA_TOTF, AA_TOTP, maxF, allOF, allOP);
        for (var i = 0; i < AA_SITES.length; i++) {
            var s = AA_SITES[i];
            h += aaSiteCard(s.name, s.name, 'SITE ' + s.siteId, s.f, s.p, maxF, s.of, s.op);
        }
        $('#aaRail').html(h);
    }
    function aaSiteCard(key, name, code, f, p, maxF, of, op) {
        var on = (aaState.site === key) ? ' on' : '';
        var kArg = key ? "'" + key.replace(/'/g, "\\'") + "'" : 'null';
        var isAll = !key;
        of = of || 0; op = op || 0;
        // v1.0.55.82: the pill answers "what is wrong NOW", so it reads OPEN alerts only. It sits
        // beside a LIVE dot; computing it from a 7-day failure COUNT meant a site whose every alert
        // had cleared still read ATTENTION, which is a history statistic wearing a live label.
        var FCRIT = 3;    // open failures at/above which a site reads CRITICAL rather than ATTENTION
        var status, cls, bc, pct;
        if (of === 0 && op === 0) { status = 'OPERATIONAL'; cls = 'ok'; bc = 'var(--aa-green)'; pct = (f + p > 0 ? 10 : 5); }
        else if (of >= FCRIT) { status = 'CRITICAL'; cls = 'crit'; bc = 'var(--aa-red)'; pct = Math.max(60, Math.min(100, Math.round(100 * of / Math.max(1, FCRIT * 2)))); }
        else if (of > 0) { status = 'ATTENTION'; cls = 'warn'; bc = 'var(--aa-amber)'; pct = Math.max(30, Math.min(58, Math.round(100 * of / Math.max(1, FCRIT)))); }
        else { status = 'ATTENTION'; cls = 'warn'; bc = 'var(--aa-amber)'; pct = Math.max(15, Math.min(40, Math.round(100 * op / Math.max(1, FCRIT * 2)))); }
        // An unexplained status is a status nobody trusts -- say what is driving it.
        var why = (of + op) === 0 ? 'nothing open'
                : ((of ? of + ' open failure' + (of > 1 ? 's' : '') : '')
                   + (of && op ? ' , ' : '')
                   + (op ? op + ' open predictive' : ''));
        var icon = isAll ? AA_ICON_GRID : AA_ICON_SITE;
        return '<button class="aa-site-card' + on + (isAll ? ' all' : '') + '" onclick="fnAaSetSite(' + kArg + ')">' +
            '<div class="aa-sc-top"><span class="aa-sc-idi">' + icon + '</span>' +
            '<span class="aa-sc-name">' + escapeHtml(name) + '</span>' +
            (code ? '<span class="aa-sc-code">' + escapeHtml(code) + '</span>' : '') + '</div>' +
            '<span class="aa-sc-pill ' + cls + '"><i></i>' + status + '</span>' +
            '<span class="aa-sc-why">' + escapeHtml(why) + '</span>' +
            '<div class="aa-sc-stats">' +
            '<span class="aa-sc-stat f' + (f ? '' : ' z') + '"><b>' + f + '</b><em>Failure</em></span>' +
            '<span class="aa-sc-stat p' + (p ? '' : ' z') + '"><b>' + p + '</b><em>Predictive</em></span>' +
            '</div>' +
            '<div class="aa-sc-foot"><span class="aa-sc-live"><i></i>LIVE</span><span>' + (f + p) + ' alerts</span></div>' +
            '<div class="aa-sc-bar"><i style="width:' + pct + '%;background:' + bc + '"></i></div>' +
            '</button>';
    }
    function fnAaRenderSeg() {
        var _sc = aaScopeTot();   // v1.0.55.155: All/Failure/Predictive counts follow the SELECTED SITE
        var h = aaSeg(null, 'All', _sc.n) + aaSeg('Failure', 'Failure', _sc.f) + aaSeg('Predictive', 'Predictive', _sc.p);
        $('#aaSegType').html(h);
    }
    function aaSeg(key, label, n) {
        var on = (aaState.type === key) ? ' class="on"' : '';
        var kArg = key ? "'" + key + "'" : 'null';
        return '<button' + on + ' onclick="fnAaSetType(' + kArg + ')">' + label + '<b>' + n + '</b></button>';
    }
    // v1.0.55.64: fnAaRenderChips (cause-by-asset lanes) REMOVED with its markup. The asset-type
    // segment above filters the same data; the lanes repeated it down a full screen. fnAaSetCause /
    // fnAaSetClass are kept -- they are one-liners that Clear-filters state still resets -- and the
    // .aa-lane / .aa-chip / .aa-chips-cap-row rules are left inert so the block can be restored.
    // v1.0.55.69 (SL 18 / G3): stored-verdict state per alert id. Display only -- this NEVER causes
    // an analysis to run. An absent entry renders "not analysed" explicitly, because a blank cell
    // reads as "nothing wrong", which is the opposite of what it means.
    var AA_VSTATE = {};
    function aaVerdictStateCell(id) {
        var st = AA_VSTATE[String(id)];
        if (st === 'valid') { return '<span class="aa-vs ok" title="A stored analysis is available">AI</span>'; }
        if (st === 'outdated') { return '<span class="aa-vs old" title="A stored analysis exists but is superseded -- re-run to refresh">AI</span>'; }
        return '<span class="aa-vs none" title="Not analysed">&ndash;</span>';
    }
    function fnAaLoadVerdictStates(list) {
        try {
            if (!list || !list.length) { return; }
            var ids = [];
            for (var i = 0; i < list.length && ids.length < 200; i++) { ids.push(list[i].id); }
            if (!ids.length) { return; }
            $.ajax({
                url: '@Url.Action("VerdictStates", "AiChat")',
                type: 'POST', contentType: 'application/json',
                data: JSON.stringify({ alertIds: ids, engine: _aiProvider }),
                success: function (d) {
                    if (!d || !d.ok || !d.states) { return; }
                    AA_VSTATE = d.states;
                    fnAaRenderTable();   // re-render with states; no further fetch (guarded below)
                },
                error: function () { /* board must render regardless */ }
            });
        } catch (e) { }
    }

    // v1.0.55.73: list presentation only. Filters, tiles and the date window are untouched.
    var AA_VIEW = 'timeline';   // v1.0.55.81: board opens on the lanes
    function fnAaSetView(v) {
        AA_VIEW = (v === 'timeline') ? 'timeline' : 'table';
        var bt = document.getElementById('aaViewTable'), bl = document.getElementById('aaViewTime');
        if (bt) { bt.className = (AA_VIEW === 'table') ? 'on' : ''; }
        if (bl) { bl.className = (AA_VIEW === 'timeline') ? 'on' : ''; }
        // v1.0.55.79: swap CONTAINERS. A colspan cell in an auto-layout table is only as wide as its
        // content, and the lane positions content as a percentage of that width -- so it collapsed.
        var tw = document.getElementById('aaTblWrap'), lw = document.getElementById('aaTimelineWrap');
        if (tw) { tw.style.display = (AA_VIEW === 'timeline') ? 'none' : ''; }
        if (lw) { lw.style.display = (AA_VIEW === 'timeline') ? '' : 'none'; }
        fnAaRenderTable();
    }

    // Alerts at ONE site within 15 min are one EVENT, not N rows. On the sample data five JIG-1
    // alerts across four assets inside five minutes are five unrelated table rows and one cluster
    // here -- that difference is the reason this view exists.
    function fnAaClusterWindowMs() { return 15 * 60 * 1000; }

    // v1.0.55.75: one Analyze control for BOTH views. Solid and legible -- the previous chip sat at
    // 28% opacity and read as disabled. "ENERGY7 INSIGHT" rather than a bare "AI": it names what the
    // operator gets, not the technology, and matches the engine branding used elsewhere.
    function aaInsightBtn(id) {
        return '<button type="button" class="e7ins" id="e7ins-' + id + '" title="Run ENERGY7 Insight on this alert"'
             + ' onclick="aaInsightGo(' + id + ',event)">'
             + '<span class="e7ins-m">7</span><span class="e7ins-t">INSIGHT</span></button>';
    }
    /* ================= v1.0.55.174 ALERT BOOKMARKS ================= */
    // alertId -> true. Only ids in here are bookmarked; AA_BM_STATE says whether the set can be
    // trusted. 'loading'/'error' render the button UNKNOWN, never as "not bookmarked".
    var AA_BM = {};
    var AA_BM_STATE = 'loading';
    var AA_BM_BUSY = {};
    var AA_BM_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4.5L6 21z"/></svg>';

    function aaBookmarkBtn(id, siteId) {
        var on = AA_BM_STATE === 'ok' && !!AA_BM[id];
        var cls = 'aa-bm' + (AA_BM_STATE !== 'ok' ? ' unk' : (on ? ' on' : '')) + (AA_BM_BUSY[id] ? ' busy' : '');
        return '<button type="button" class="' + cls + '" data-bm="' + id + '" data-site="' + (parseInt(siteId, 10) || 0) + '"'
             + ' title="' + aaBmTitle(id) + '" aria-pressed="' + (on ? 'true' : 'false') + '"'
             + ' onclick="aaBookmarkGo(' + id + ',event)">' + AA_BM_SVG + '</button>';
    }
    function aaBmTitle(id) {
        if (AA_BM_STATE === 'loading') { return 'Loading bookmarks...'; }
        if (AA_BM_STATE === 'error') { return 'Bookmarks could not be loaded - click to retry'; }
        return AA_BM[id] ? 'Remove bookmark' : 'Bookmark this alert';
    }
    // Repaint every button for one alert (or all) IN PLACE. Re-rendering the board would close an
    // open lane detail and the modal, so the toggle never calls fnAaRenderAll.
    function aaBmPaint(id) {
        var sel = (id == null) ? '.aa-bm[data-bm]' : '.aa-bm[data-bm="' + id + '"]';
        var els = document.querySelectorAll(sel);
        for (var i = 0; i < els.length; i++) {
            var n = parseInt(els[i].getAttribute('data-bm'), 10);
            var on = AA_BM_STATE === 'ok' && !!AA_BM[n];
            els[i].className = 'aa-bm' + (AA_BM_STATE !== 'ok' ? ' unk' : (on ? ' on' : '')) + (AA_BM_BUSY[n] ? ' busy' : '');
            els[i].setAttribute('title', aaBmTitle(n));
            els[i].setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        aaBmPaintFilter();
    }
    // v1.0.55.175: the filter toggle. Count follows the same SITE scope as the other facets.
    function aaBmPaintFilter() {
        var b = document.getElementById('aaBmFilter');
        if (!b) { return; }
        var ok = AA_BM_STATE === 'ok', n = 0;
        if (ok) {
            var sc = aaScope();
            for (var i = 0; i < sc.length; i++) { if (AA_BM[sc[i].id]) { n++; } }
        }
        b.className = 'aa-bmf' + (!ok ? ' unk' : (aaState.bm ? ' on' : ''));
        b.setAttribute('aria-pressed', (ok && aaState.bm) ? 'true' : 'false');
        b.setAttribute('title', AA_BM_STATE === 'loading' ? 'Loading bookmarks...'
            : (AA_BM_STATE === 'error' ? 'Bookmarks could not be loaded - click to retry'
            : (aaState.bm ? 'Showing bookmarked alerts only - click to show all' : 'Show only bookmarked alerts')));
        var c = document.getElementById('aaBmFilterN');
        if (c) { c.textContent = ok ? String(n) : '-'; }
    }
    function fnAaToggleBmFilter() {
        if (AA_BM_STATE === 'error') { fnAaLoadBookmarks(); return; }
        if (AA_BM_STATE !== 'ok') { return; }   // never filter on a set that has not loaded
        aaState.bm = !aaState.bm;
        fnAaRenderAll();
    }
    function fnAaLoadBookmarks() {
        // Once loaded, local toggles keep the set current -- a silent board refresh only repaints.
        if (AA_BM_STATE === 'ok') { aaBmPaint(null); return; }
        AA_BM_STATE = 'loading'; aaBmPaint(null);
        $.ajax({
            url: '@Url.Action("GetMyBookmarks", "AlertAnalysis")',
            type: 'GET',
            cache: false,
            success: function (j) {
                if (!j || j.ok !== true) { AA_BM_STATE = 'error'; aaBmPaint(null); return; }
                AA_BM = {};
                var ids = j.ids || [];
                for (var i = 0; i < ids.length; i++) { AA_BM[ids[i]] = true; }
                AA_BM_STATE = 'ok';
                aaBmPaint(null);
            },
            error: function () { AA_BM_STATE = 'error'; aaBmPaint(null); }
        });
    }
    function aaBookmarkGo(id, ev) {
        try { if (ev && ev.stopPropagation) { ev.stopPropagation(); } } catch (e) { }
        if (AA_BM_STATE === 'error') { fnAaLoadBookmarks(); return; }
        if (AA_BM_STATE !== 'ok' || AA_BM_BUSY[id]) { return; }
        var btn = ev && ev.currentTarget ? ev.currentTarget : document.querySelector('.aa-bm[data-bm="' + id + '"]');
        var siteId = btn ? (parseInt(btn.getAttribute('data-site'), 10) || 0) : 0;
        if (!siteId) { var r = aaRowById(id); siteId = r ? (r.siteId || 0) : 0; }
        var was = !!AA_BM[id], want = !was;
        // Optimistic: show the new state now, revert if the server does not confirm it.
        if (want) { AA_BM[id] = true; } else { delete AA_BM[id]; }
        AA_BM_BUSY[id] = true;
        aaBmPaint(id);
        var body = 'alertId=' + encodeURIComponent(id)
                 + '&siteId=' + encodeURIComponent(siteId)
                 + '&bookmarked=' + (want ? 'true' : 'false')
                 + '&__RequestVerificationToken=' + encodeURIComponent(aiRateTok());
        fetch('@Url.Action("ToggleBookmark", "AlertAnalysis")', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
            body: body
        }).then(function (r) {
            return r.ok ? r.json() : r.text().then(function (t) { throw new Error(aiRateErr(r.status, t)); });
        }).then(function (j) {
            if (!j || j.ok !== true) { throw new Error((j && j.error) ? j.error : 'the server did not confirm the bookmark'); }
            delete AA_BM_BUSY[id];
            if (j.bookmarked) { AA_BM[id] = true; } else { delete AA_BM[id]; }
            aaBmPaint(id);
            // v1.0.55.175: with the filter on, a removed bookmark leaves the list -- after the server
            // confirms, not before, so a failed save never makes the alert vanish.
            if (aaState.bm && !j.bookmarked) { fnAaRenderAll(); }
        }).catch(function (e) {
            delete AA_BM_BUSY[id];
            if (was) { AA_BM[id] = true; } else { delete AA_BM[id]; }
            aaBmPaint(id);
            if (window.CommonNotification) { CommonNotification('ERROR', 'Bookmark not saved: ' + (e && e.message ? e.message : 'unknown error'), 'Error'); }
        });
    }

    // The click-to-modal gap is long enough to read as a dead button. Mark the one pressed.
    function aaInsightGo(id, ev) {
        try {
            if (ev && ev.stopPropagation) { ev.stopPropagation(); }
            var b = document.getElementById('e7ins-' + id);
            if (b) {
                b.className = 'e7ins busy';
                var t = b.querySelector('.e7ins-t');
                if (t) { t.textContent = 'WORKING'; }
                setTimeout(function () {
                    var b2 = document.getElementById('e7ins-' + id);
                    if (!b2) { return; }
                    b2.className = 'e7ins';
                    var t2 = b2.querySelector('.e7ins-t');
                    if (t2) { t2.textContent = 'INSIGHT'; }
                }, 12000);
            }
        } catch (e) { }
        try { fnRowAnalyze(id); } catch (e) { }
    }

    // v1.0.55.76: ONE DAY PER ROW. A vertical list of 200 alerts is a scroll; a 24 h lane shows
    // WHEN they happened relative to each other, which is the only thing a timeline adds over a table.
    function fnAaRenderTimeline(list) {
        // v1.0.55.85: cards in FLOW along a SEQUENTIAL axis. The four previous revisions positioned
        // cards at a time coordinate on a 24 h scale and then fought the overlaps that creates --
        // alerts minutes apart cannot be drawn side by side at true position, so the lane could only
        // ever stack, spill or hide them. Sequential ordering removes the problem at its source: two
        // alerts a minute apart get two ADJACENT nodes. The axis labels carry the real times, and a
        // burst collapses to one card, so the timeline reading (order, clustering, gaps) survives.
        var rows = list.slice().sort(function (x, y) {
            return (x.timeSort > y.timeSort) ? 1 : ((x.timeSort < y.timeSort) ? -1 : 0);   // chronological
        });
        var byDay = {}, order = [];
        for (var i = 0; i < rows.length; i++) {
            var k = aaDayLabel(rows[i]);
            if (!byDay[k]) { byDay[k] = []; order.push(k); }
            byDay[k].push(rows[i]);
        }
        order.reverse();   // newest DAY first, chronological within the day
        var h = '<div class="aa-tl">';
        for (var d = 0; d < order.length; d++) {
            var day = order[d], items = byDay[day], nf = 0;
            for (var q = 0; q < items.length; q++) { if (items[q].type === 'Failure') { nf++; } }

            // v1.0.55.155: ONE CARD PER ALERT. The .85 rebuild put cards in sequential FLOW, so two
            // alerts a minute apart are already two adjacent nodes -- nothing can collide. Burst
            // clustering (same site, within 20 min -> one card + count) was left over from the earlier
            // true-time-position layout it replaced, and its only remaining effect was to HIDE alerts:
            // a 5-alert burst rendered ONE card, so the timeline read fewer alerts than the table for
            // the identical filtered set. Each alert is now its own card, so both views show the same
            // set. fnAaTlCard still handles n>1, so cluster cards can be reintroduced behind a flag.
            var groups = [];
            for (var j = 0; j < items.length; j++) { groups.push([items[j]]); }

            h += '<div class="aa-dayrow">'
               + '<div class="aa-dayhd"><b>' + escapeHtml(day) + '</b>'
               + '<span class="aa-dn">' + items.length + '</span>'
               + (nf ? '<span class="aa-df">' + nf + ' failure</span>' : '')
               + '<span class="aa-ev-sp"></span>'
               + (groups.length > 5 ? '<span class="aa-hint">scroll &rarr;</span>' : '')
               + '</div>'
               + '<div class="aa-trackwrap"><div class="aa-track"><div class="aa-axis"></div>';
            for (var g = 0; g < groups.length; g++) { h += fnAaTlCard(groups[g]); }
            h += '</div></div></div>';
        }
        h += '</div>';
        return h;
    }

    // Short coded badge rather than the full type string: "POINT MACHINE" is 13 characters and
    // would dominate a 236px card, while the operator only needs to distinguish four kinds.
    // resetText is "dd/MM/yyyy HH:mm:ss" -- the card only needs the clock part, and the date only
    // when the alert cleared on a LATER day than it was raised.
    function aaResetLabel(a) {
        var r = String(a.resetText || '');
        if (!r) { return ''; }
        var sp = r.split(' ');
        if (sp.length < 2) { return r.substring(0, 5); }
        var hhmm = sp[1].substring(0, 5);
        var sameDay = String(a.timeText || '').indexOf(sp[0]) === 0;
        return sameDay ? hhmm : (hhmm + ' +' + sp[0].substring(0, 5));
    }

    // "0-02:24:33" is days-HH:mm:ss. The leading day count is printed even when zero, which is most
    // of the time -- so say it in units a person reads instead.
    function aaElapsed(dt) {
        var v = String(dt || '');
        var m = v.match(/^(\d+)-(\d{2}):(\d{2}):(\d{2})$/);
        if (!m) { return v; }
        var d = +m[1], h = +m[2], mi = +m[3], se = +m[4];
        if (d > 0) { return d + 'd ' + h + 'h'; }
        if (h > 0) { return h + 'h ' + mi + 'm'; }
        if (mi > 0) { return mi + 'm ' + se + 's'; }
        return se + 's';
    }

    function aaTypeBadge(t) {
        var v = String(t || '').toUpperCase(), code = '', cls = 'oth';
        if (v.indexOf('TRACK') >= 0) { code = 'TRK'; cls = 'trk'; }
        else if (v.indexOf('POINT') >= 0) { code = 'PM'; cls = 'pm'; }
        else if (v.indexOf('SIGNAL') >= 0) { code = 'SIG'; cls = 'sig'; }
        else if (v.indexOf('IPS') >= 0) { code = 'IPS'; cls = 'ips'; }
        else if (v.length) { code = v.substring(0, 3); }
        return code ? '<span class="aa-tb ' + cls + '">' + escapeHtml(code) + '</span>' : '';
    }

    function aaMs(a) { var d = new Date(a.timeSort || a.time); return isNaN(d.getTime()) ? 0 : d.getTime(); }

    // One card per alert, or per BURST. Severity follows the worst member: a group containing a
    // failure must not read as predictive because most of it is.
    function fnAaTlCard(grp) {
        var a = grp[0], n = grp.length, nf = 0;
        for (var i = 0; i < n; i++) { if (grp[i].type === 'Failure') { nf++; } }
        var cls = nf ? 'fail' : 'pred';
        var isOpen = !a.resetText;
        var v = aaRemarkVerdict(a);
        var span = n > 1 ? Math.max(1, Math.round((aaMs(grp[n - 1]) - aaMs(a)) / 60000)) : 0;
        var tip = n > 1
            ? (n + ' alerts in ' + span + ' min at ' + (a.station || '') + '\n'
               + nf + ' failure, ' + (n - nf) + ' predictive')
            : ((a.code || '') + '\n' + aaTimeLabel(a) + (a.resetText ? '\ncleared ' + a.resetText : '\nOPEN')
               + (v.text ? '\nremark: ' + v.text : ''));
        return '<div class="aa-ti ' + cls + '" onclick="aaLanePick(' + a.id + ',event)" title="' + escapeHtml(tip) + '">'
             + '<div class="aa-tc">'
             + '<div class="aa-tch"><span class="aa-tct">' + escapeHtml(aaTimeLabel(a)) + '</span>'
             + '<b>' + escapeHtml(a.asset || '') + '</b>'
             + (n > 1 ? '<span class="aa-cl">' + n + '</span>' : '')
             + (v.flag ? '<span class="aa-vflag ' + v.flag + '">' + (v.flag === 'true' ? 'T' : 'F') + '</span>' : '')
             + '<span class="aa-ev-sp"></span>'
             + '<span class="aa-chip ' + cls + '">' + (nf ? 'Failure' : 'Predictive') + '</span>'
             + aaBookmarkBtn(a.id, a.siteId) + '</div>'   // v1.0.55.174
             + '<div class="aa-tcc">' + escapeHtml(a.code || '') + '</div>'
             + '<div class="aa-tcf">'
             + '<span class="aa-sr"><span class="aa-set">' + escapeHtml(aaTimeLabel(a).substring(0, 5)) + '</span>'
             + '<span class="aa-arw">&rarr;</span>'
             + (isOpen ? '<span class="aa-rst open">OPEN</span>'
                       : '<span class="aa-rst">' + escapeHtml(aaResetLabel(a)) + '</span>')
             + '</span>'
             + (isOpen ? '' : '<span class="aa-eld">' + escapeHtml(aaElapsed(a.durationText)) + '</span>')
             + '<span class="aa-ev-sp"></span>' + aaVerdictStateCell(a.id) + aaInsightBtn(a.id)
             + '</div>'
             + '<div class="aa-tcm">' + aaTypeBadge(a.assetType)
             + '<span class="aa-tcs' + (aaState.site ? '' : ' hi') + '">' + escapeHtml(a.station || '') + '</span>'
             + (a.division ? '<span class="aa-tcd">' + escapeHtml(a.division) + '</span>' : '')
             + '</div></div>'
             + '<span class="aa-stem"></span><span class="aa-node"></span>'
             + '<span class="aa-axlbl">' + escapeHtml(aaTimeLabel(a).substring(0, 5)) + '</span>'
             + '</div>';
    }

    function aaRemarkVerdict(a) {
        var r = (a.remark || a.maintRemark || '').trim();
        var low = r.toLowerCase();
        if (low === 'true' || low === 'yes') { return { flag: 'true', text: r }; }
        if (low === 'false' || low === 'no') { return { flag: 'false', text: r }; }
        return { flag: '', text: r };
    }

    // Clicking a chip opens the detail row beneath its lane -- the chip is too small for the cause,
    // the remark and an action, and cramming them in would defeat the point of the lane.
    function aaLanePick(id, ev) {
        try {
            if (ev && ev.stopPropagation) { ev.stopPropagation(); }
            var list = fnAaFiltered(), a = null;
            for (var i = 0; i < list.length; i++) { if (list[i].id === id) { a = list[i]; break; } }
            if (!a) { return; }
            var old = document.getElementById('aaLaneDet');
            if (old && old.parentNode) { old.parentNode.removeChild(old); }
            // v1.0.55.85: the detail opens beneath the DAY ROW -- .aa-lane no longer exists.
            var host = ev && ev.target ? ev.target.closest('.aa-dayrow') : null;
            if (!host) { return; }
            var v = aaRemarkVerdict(a);
            var d = document.createElement('div');
            d.id = 'aaLaneDet';
            d.className = 'aa-lane-det ' + ((a.type === 'Failure') ? 'fail' : 'pred');
            d.innerHTML = '<div class="aa-det-hd"><b>' + escapeHtml(a.asset || '') + '</b>'
                + '<span class="aa-chip ghost">' + escapeHtml(a.assetType || '') + '</span>'
                + '<span class="aa-chip sev ' + ((a.type === 'Failure') ? 'fail' : 'pred') + '">'
                + (a.type === 'Failure' ? 'Failure' : 'Predictive') + '</span>'
                + aaBookmarkBtn(a.id, a.siteId)   // v1.0.55.174
                + '<span class="aa-chip">' + escapeHtml(aaTimeLabel(a)) + '</span>'
                + '<span class="aa-sr"><span class="aa-set">' + escapeHtml(aaTimeLabel(a).substring(0, 5)) + '</span>'
                + '<span class="aa-arw">&rarr;</span>'
                + (a.resetText ? '<span class="aa-rst">' + escapeHtml(aaResetLabel(a)) + '</span>'
                               : '<span class="aa-rst open">OPEN</span>')
                + '</span>'
                + (a.resetText ? '<span class="aa-eld">' + escapeHtml(aaElapsed(a.durationText)) + '</span>' : '')
                + '<span class="aa-det-sp"></span>'
                + aaVerdictStateCell(a.id) + aaInsightBtn(a.id) + '</div>'
                + '<div class="aa-det-cause">' + escapeHtml(a.code || '') + '</div>'
                + (v.text
                    ? '<div class="aa-det-rem">' + (v.flag
                        ? '<span class="aa-rem-flag ' + v.flag + '">' + (v.flag === 'true' ? 'CONFIRMED TRUE' : 'CONFIRMED FALSE') + '</span>'
                        : '<span class="aa-rem-lbl">Maintainer</span>')
                      + '<span class="aa-rem-txt">' + escapeHtml(v.text) + '</span></div>'
                    : '<div class="aa-det-rem"><span class="aa-rem-lbl none">No maintainer remark</span></div>')
                + '<div class="aa-det-foot">' + escapeHtml(a.station || '')
                + (a.division ? ' &middot; ' + escapeHtml(a.division) : '') + '</div>';
            host.appendChild(d);
        } catch (e) { }
    }


    // Helpers kept tiny and local: the row objects already carry what these need.
    function aaTs(a) { var d = new Date(a.timeSort || a.time); return isNaN(d.getTime()) ? 0 : d.getTime(); }
    function aaDayLabel(a) { var d = new Date(a.timeSort || a.time); return isNaN(d.getTime()) ? '' : d.toDateString(); }
    function aaTimeLabel(a) {
        var d = new Date(a.timeSort || a.time);
        if (isNaN(d.getTime())) { return String(a.time || ''); }
        function p(n) { return (n < 10 ? '0' : '') + n; }
        return p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
    }
    function aaAttr(v) { return String(v || '').replace(/\\/g, '').replace(/'/g, ""); }
    // Site selection goes through fnAaSetSite(id) -- the same call the site tiles use.
    // (fnAaPickSite does not exist; it was my invention.)
    function fnAaFocusSite(name) {
        try {
            for (var i = 0; i < AA_SITES.length; i++) {
                if (AA_SITES[i].name === name) { fnAaSetSite(AA_SITES[i].id); return; }
            }
        } catch (e) { }
    }

    function fnAaRenderTable() {
        var list = fnAaFiltered();
        if (!list.length) {
            // v1.0.55.81: the empty state must land in the VISIBLE container. With timeline as the
            // default, writing it into the table body left the board looking blank rather than
            // saying why it was blank.
            var msg = AA_INRANGE.length
                ? (aaState.bm ? 'No bookmarked alerts match the current filters.' : 'No alerts match the current filters.')
                : 'No alerts in this date window.';
            if (AA_VIEW === 'timeline') { $('#aaTimelineWrap').html('<div class="aa-tl-empty">' + msg + '</div>'); }
            else { $('#aaRows').html('<tr class="aa-empty"><td colspan="11">' + msg + '</td></tr>'); }
            fnAaUpdateCount(list);
            return;
        }
        if (AA_VIEW === 'timeline') {
            $('#aaTimelineWrap').html(fnAaRenderTimeline(list));
            fnAaUpdateCount(list);
            return;
        }
        var bySite = {};
        for (var i = 0; i < list.length; i++) { (bySite[list[i].station] = bySite[list[i].station] || []).push(list[i]); }
        var h = '';
        var sr = 0;
        for (var s = 0; s < AA_SITES.length; s++) {
            var site = AA_SITES[s];
            var g = bySite[site.name];
            if (!g) { continue; }
            g.sort(function (x, y) { return (y.timeSort > x.timeSort) ? 1 : ((y.timeSort < x.timeSort) ? -1 : 0); });
            var f = 0;
            for (var q = 0; q < g.length; q++) { if (g[q].type === 'Failure') { f++; } }
            var p = g.length - f;
            h += '<tr class="aa-grp"><td colspan="11"><div class="aa-grp-in">' +
                '<span class="aa-grp-name">' + escapeHtml(site.name) + '</span>' +
                '<span class="aa-grp-meta">' + g.length + ' alert' + (g.length > 1 ? 's' : '') +
                (f ? ' &middot; <em>' + f + ' failure</em>' : '') + (p ? ' &middot; ' + p + ' predictive' : '') + '</span>' +
                '<span class="aa-grp-code">SITE ' + site.siteId + '</span>' +
                '</div></td></tr>';
            for (var r = 0; r < g.length; r++) {
                var a = g[r];
                sr++;
                var pred = a.type !== 'Failure';
                // v1.0.55.65: an alert with no reset is still OPEN -- dash in both the duration and
                // rectification cells rather than a computed or zero value.
                var openAlert = !a.resetText;
                h += '<tr class="aa-row ' + (pred ? 'is-pred' : 'is-fail') + (openAlert ? ' is-open' : '') + '"><td class="aa-c-sr">' + sr + '</td>' +
                    '<td class="aa-c-org">' + escapeHtml(a.zone || '-') + '</td>' +
                    '<td class="aa-c-org">' + escapeHtml(a.division || '-') + '</td>' +
                    '<td><span class="aa-type ' + (pred ? 'pred' : 'fail') + '"><i></i>' + escapeHtml(a.type || '-') + '</span>' + aaBookmarkBtn(a.id, a.siteId) + '</td>' +
                    '<td class="aa-c-atype">' + escapeHtml(a.assetType || '-') + '</td>' +
                    '<td class="aa-c-asset">' + escapeHtml(a.asset) + '</td><td class="aa-c-time">' + escapeHtml(a.timeText) + '</td>' +
                    '<td class="aa-c-dur">' + (openAlert ? '<span class="aa-open">open</span>' : escapeHtml(a.durationText || '-')) + '</td>' +
                    '<td class="aa-c-time">' + (openAlert ? '<span class="aa-dash">-</span>' : escapeHtml(a.resetText)) + '</td>' +
                    '<td class="aa-ai">' + aaVerdictStateCell(a.id) + '</td>' +
                    '<td class="aa-cause"><a onclick="fnShowAlertMessage(' + a.id + ')">' + escapeHtml(a.code) + '</a>' +
                    aaInsightBtn(a.id) +
                    '</td></tr>';
            }
        }
        $('#aaRows').html(h);
        fnAaUpdateCount(list);
    }
    function fnAaUpdateCount(list) {
        var any = aaState.site || aaState.type || aaState.cause || aaState.assetClass || aaState.bm;
        $('#aaCountTxt').text(any ? (list.length + ' of ' + AA_INRANGE.length + ' shown') : (AA_INRANGE.length + ' in window'));
