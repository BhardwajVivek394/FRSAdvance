              + "<line x1='350' y1='142' x2='350' y2='184'/></g>"
              + "<g stroke='#60a5fa' stroke-opacity='.30' stroke-width='2' stroke-linecap='round'>"
              + "<line x1='60' y1='20' x2='44' y2='70'/><line x1='120' y1='10' x2='104' y2='60'/>"
              + "<line x1='180' y1='26' x2='164' y2='76'/><line x1='240' y1='8' x2='224' y2='58'/>"
              + "<line x1='300' y1='24' x2='284' y2='74'/><line x1='360' y1='14' x2='344' y2='64'/></g>";
        } else {
            a = "<g stroke='#94a3b8' stroke-opacity='.25' stroke-width='3'>"
              + "<line x1='40' y1='150' x2='400' y2='150'/><line x1='40' y1='176' x2='400' y2='176'/></g>"
              + "<g stroke='#94a3b8' stroke-opacity='.18' stroke-width='6'>"
              + "<line x1='80' y1='142' x2='80' y2='184'/><line x1='170' y1='142' x2='170' y2='184'/>"
              + "<line x1='260' y1='142' x2='260' y2='184'/><line x1='350' y1='142' x2='350' y2='184'/></g>"
              + "<circle cx='330' cy='70' r='30' fill='#60a5fa' fill-opacity='.16'/>";
        }
        return "url(\"data:image/svg+xml;charset=utf-8," + encodeURIComponent(wrap(a)) + "\")";
    }
    // v1.0.55.19: STACKED STORY -- built entirely from verdict JSON already on the client
    // (headline, likely_cause, viz, evidence, recommended_action, caveats). No controller change.
    function renderAiStory(v, c){
        try{
            if(!v || !v.headline){ return ''; }
            var vk = String(v.verdict||'').toUpperCase();
            var tone = (vk==='NOT_CONFIRMED') ? 'ok' : ((vk==='INCONCLUSIVE') ? 'warn' : '');
            var who = [ (c&&c.assetName)||'', (c&&c.station)||'' ].filter(function(x){ return !!x; }).join(' \u00b7 ');
            var h = '<div class="rv-sec sec-story rvs-sec '+tone+'"><div class="rv-eyebrow">The story</div>'
                  + '<div class="rvs-stage"><div class="rvs-chaps" id="rvsChaps"></div>'
                  + '<div class="rvs-deck" id="rvsDeck"><div class="rvs-track" id="rvsTrack">';
            h += '<div class="rvs-card rvs-hero '+tone+'" data-lbl="What happened" style="background-image:'+rvStoryArt(c&&c.causeCode)+';">'
               + '<div class="rvs-eyebrow">What happened'+(who?(' \u00b7 '+escapeHtml(who)):'')+'</div>'
               + '<div class="rvs-h">'+escapeHtml(v.headline)+'</div>'
               + (v.likely_cause?('<div class="rvs-p">'+escapeHtml(v.likely_cause)+'</div>'):'') + '</div>';
            var z = v.viz||{};
            if(z.value!=null && !isNaN(Number(z.value))){
                var u = z.unit?(' '+escapeHtml(z.unit)):'';
                var pc = (z.pct_change!=null && !isNaN(Number(z.pct_change))) ? (Math.round(Number(z.pct_change)*10)/10) : null;
                h += '<div class="rvs-card rvs-c2 '+tone+'" data-lbl="The numbers"><div class="rvs-eyebrow">The numbers</div>'
                   + '<div class="rvs-h">'+(pc!=null ? (Math.abs(pc)+'% '+(pc<0?'below':'above')+' the usual level') : escapeHtml(String(z.metric||'Measured value')))+'</div>'
                   + '<div class="rvs-nums"><div><div class="rvs-num">'+escapeHtml(String(z.value))+'</div><div class="rvs-cap">'+escapeHtml(String(z.metric||'measured'))+metricUnitSuffix(z.metric||'measured', z.unit)+'</div></div>'
                   + ((z.threshold!=null&&!isNaN(Number(z.threshold)))?('<div><div class="rvs-num sub">'+escapeHtml(String(z.threshold))+'</div><div class="rvs-cap">threshold'+u+'</div></div>'):'')
                   + ((z.baseline!=null&&!isNaN(Number(z.baseline)))?('<div><div class="rvs-num sub">'+escapeHtml(String(z.baseline))+'</div><div class="rvs-cap">normal'+u+'</div></div>'):'')
                   + '</div>' + (z.phase_note?('<div class="rvs-p">'+escapeHtml(String(z.phase_note))+'</div>'):'') + '</div>';
            }
            var ev = v.evidence||[];
            if(ev.length){
                h += '<div class="rvs-card rvs-c3 '+tone+'" data-lbl="Why"><div class="rvs-eyebrow">Why we think so</div>'
                   + '<div class="rvs-h">'+ev.length+' thing'+(ev.length>1?'s':'')+' line up</div>';
                for(var i=0;i<ev.length;i++){ h += '<div class="rvs-li">'+escapeHtml(String(ev[i]))+'</div>'; }
                h += '</div>';
            }
            if(v.recommended_action){
                var acts = String(v.recommended_action).split(';').map(function(x){ return x.trim(); }).filter(function(x){ return x.length>1; });
                h += '<div class="rvs-card rvs-c4 '+tone+'" data-lbl="What to do"><div class="rvs-eyebrow">What to do</div>'
                   + '<div class="rvs-h">'+escapeHtml(acts.length?(acts[0].charAt(0).toUpperCase()+acts[0].slice(1)):'Recommended action')+'</div>';
                for(var k=(acts.length>1?1:0);k<acts.length;k++){ h += '<div class="rvs-li">'+escapeHtml(acts[k])+'</div>'; }
                h += '</div>';
            }
            var cf = (v.confidence!=null&&!isNaN(Number(v.confidence)))?Math.round(Number(v.confidence)):null;
            if(cf!=null || v.caveats){
                h += '<div class="rvs-card rvs-c5 '+tone+'" data-lbl="How sure"><div class="rvs-eyebrow">How sure</div>'
                   + (cf!=null?('<div class="rvs-h">'+cf+'% confident</div>'):'<div class="rvs-h">Confidence</div>')
                   + (v.caveats?('<div class="rvs-p">'+escapeHtml(String(v.caveats))+'</div>'):'') + '</div>';
            }
            // v1.0.55.99: ASSET HEALTH as a story chapter. This is where a reader looks for context
            // about the asset, rather than being met by it before the verdict.
            try {
                var acHtml = renderAssetCondition(false);
                if (acHtml) {
                    h += '<div class="rvs-card rvs-health '+tone+'" data-lbl="Asset health">'
                       + '<div class="rvs-eyebrow">Asset health</div>' + acHtml + '</div>';
                }
            } catch (e) { }

            // v1.0.55.103: ASSET HISTORY chapter -- the cause-code spread of THIS asset over the
            // controller's lookback window (AiChat .154 Layer A), drawn as a pie so the asset's
            // symptom mix in the past reads at a glance. Field record (FRS), not AI opinion;
            // absent when the controller flag is off or the fetch failed.
            try {
                var ah = v.asset_history;
                if (ah && ah.byCause && Number(ah.total) > 0) {
                    h += '<div class="rvs-card rvs-ahist '+tone+'" data-lbl="Asset history">'
                       + '<div class="rvs-eyebrow">Asset history &middot; '+Number(ah.windowDays||30)+'d</div>'
                       + rvhPieHtml(ah) + '</div>';
                }
            } catch (e) { }

            // v1.0.55.153: PM ANALYSIS chapter -- shows for any POINT MACHINE alert. Uses window._aiPm
            // if the backend injected it; otherwise offers a "Load analysis" button that fetches v4 from
            // the asset's site/asset id. Non-point alerts never get the chapter.
            try {
                var _pmc = (typeof _currentAlertContext !== 'undefined') ? _currentAlertContext : null;
                // v1.0.55.162: detect a point alert by ANY reliable form -- assetType text,
                // AssetTypeId 3, or a "PT ..." cause code (all point causes start with PT) -- not only
                // assetType literally containing "POINT" (which is often blank/numeric/"POINT MACHINE").
                var _pmAt   = String((_pmc && (_pmc.assetType || _pmc.AssetType)) || '');
                var _pmAtId = (_pmc && (_pmc.assetTypeId != null ? _pmc.assetTypeId : _pmc.AssetTypeId));
                var _pmCc   = String((_pmc && (_pmc.causeCode || _pmc.CauseCode)) || '');
                var _pmIsPoint = (window._aiPm && (_aiPm.a || _aiPm.b))
                              || /POINT/i.test(_pmAt)
                              || (_pmAtId != null && Number(_pmAtId) === 3)
                              || /^\s*PT[\s\-]/i.test(_pmCc);
                if (_pmIsPoint) {
                    // v1.0.55.158: the Model 4 sections are the chapter now. The containers go
                    // in with the rest of the deck's html; aiPm4Boot fires on the next tick,
                    // once they are actually in the DOM, and fills them from one fetch.
                    h += '<div class="rvs-card rvs-pm ' + tone + '" data-lbl="PM Analysis">'
                       + '<div class="rvs-eyebrow">PM Analysis'
                       + '<button type="button" class="rvl-rf" onclick="aiPm4Reload(event)" title="Fetch the per-stroke analysis again">'
                       + '<span class="rvl-rfi">&#8635;</span>Reload</button></div>'
                       + '<div id="aiPmBody">' + aiPmSkeleton() + '</div></div>';
                    setTimeout(aiPm4Boot, 0);
                }
            } catch (ePm) { }

            // v1.0.55.89: Live data as its own chapter, refreshable in place.
            h += '<div class="rvs-card rvs-live '+tone+'" data-lbl="Live data">'
               + '<div class="rvs-eyebrow">Live data'
               + '<button type="button" class="rvl-rf" onclick="aiRefreshLive(event)" title="Fetch current values now">'
               + '<span class="rvl-rfi">&#8635;</span>Refresh</button></div>'
               + '<div id="aiLiveBody">' + aiLiveGrid() + '</div></div>';
            return h + '</div></div>'
                 + '<div class="rvs-prog" id="rvsProg"><i id="rvsProgBar"></i></div>'
                 + '<div class="rvs-nav"><button type="button" class="rvs-arw" id="rvsPrev" onclick="rvsGo(-1)" title="Previous card">&#8592;</button>'
                 + '<div class="rvs-dots" id="rvsDots"></div>'
                 + '<div style="display:flex;align-items:center;gap:8px;"><span class="rvs-step" id="rvsStep"></span>'
                 + '<button type="button" class="rvs-arw" id="rvsNext" onclick="rvsGo(1)" title="Next card">&#8594;</button></div></div>'
                 + '</div></div>';
        }catch(e){ return ''; }
    }
    // v1.0.55.27: MOVEMENT, not a plot. Owner: "just compute explanation -- last health value,
    // threshold violation and driver attribute movement; how the value moved at a glance, and if
    // derived, which value caused it." Everything here is computed from data already on the client:
    // the verdict's viz/derived_inputs plus the real trend frame when one arrived.
    // v1.0.55.27: formulas are written in ALIAS names (ITC FEED END) while inputs arrive as
    // attribute names (IF MA). From RDPMS_Attributes in the master cause-code workbook.
    var RVM_ALIAS = { 'IF MA':'ITC FEED END', 'IR MA':'ITC RELAY END', 'VF':'VTC FEED END',
        'VR':'VTC RELAY END', 'CHOKE V':'VTC CH FEED END', 'CHARGER MA':'ITC TFC O/P',
        'CHARGER OP V':'VTC TFC O/P', 'CHARGER V':'VTC TFC I/P', 'TPR V':'VTC 24 DC TPR I/P',
        'TPR V (LOC)':'VTC 24 DC LOC' };
    function rvmDivisor(formula){
        var f=String(formula||'').replace(/\s+/g,' ');
        var i=f.indexOf('/'); if(i<0){ return ''; }
        var tail=f.substring(i+1);
        var stop=tail.search(/,|\bwhere\b/i);
        return (stop>0? tail.substring(0,stop) : tail).toUpperCase();
    }
    function rvmIsDivisor(name, formula){
        var div=rvmDivisor(formula); if(!div){ return false; }
        var n=String(name||'').toUpperCase().trim(); if(!n){ return false; }
        if(div.indexOf(n)>=0){ return true; }
        var al=RVM_ALIAS[n]; return !!(al && div.indexOf(al)>=0);
    }
    // v1.0.55.30: name matching for the hero series, and a digital-series guard. A 0/1 state line
    // (TPR) has no baseline and no "worst value" -- treating it as the metric produced nonsense.
    function rvmNorm(x){ return String(x||'').toUpperCase().replace(/\(.*?\)/g,' ').replace(/[^A-Z0-9]+/g,' ').trim(); }
    function rvmDigital(sr){
        try{
            if(!sr || !sr.pts || !sr.pts.length){ return false; }
            var seen=0, n=0;
            for(var i=0;i<sr.pts.length && n<40;i++){
                var val=sr.pts[i][1]; if(val==null||isNaN(val)){ continue; }
                n++; if(val!==0 && val!==1){ return false; } seen++;
            }
            return seen>0;
        }catch(e){ return false; }
    }
    function rvmFmt(x){ if(x==null||isNaN(Number(x))){ return '-'; }
        var n=Number(x), a=Math.abs(n);
        return (a>=100? n.toFixed(0) : (a>=10? n.toFixed(1) : n.toFixed(3))).replace(/\.0+$/,''); }
    function rvmPct(from,to){ if(from==null||to==null||isNaN(from)||isNaN(to)||Math.abs(from)<1e-9){ return null; }
        return ((to-from)/Math.abs(from))*100; }
    // last sample at or before the incidence, and the last sample still on the SAFE side of the limit
    function rvmAtAndHealthy(pts, incMs, thr, rising){
        var at=null, healthy=null, healthyT=null, peak=null;
        for(var i=0;i<pts.length;i++){
            var t=pts[i][0], val=pts[i][1];
            if(val==null||isNaN(val)){ continue; }
            if(incMs==null || t<=incMs){
                at=val;
                if(thr==null || (rising? (val<thr) : (val>thr))){ healthy=val; healthyT=t; }
            }
            if(peak==null){ peak=val; } else { peak = rising ? Math.max(peak,val) : Math.min(peak,val); }
        }
        return { at:at, healthy:healthy, healthyT:healthyT, peak:peak };
    }
    function renderAiMovement(v, c){
        try{
            var z = v && v.viz; if(!z){ return ''; }
            // v1.0.55.58: for a DERIVED alert the hero headlines alert value-vs-limit (the limit line
            // below), NOT a was->now movement pill -- a window-relative move can be large and
            // misleading on marginal drift (e.g. 541980). Suppress the pill in the derived case.
            var isDerivedAlert = !!(v.derived_inputs && v.derived_inputs.inputs && v.derived_inputs.inputs.length);
            var unit = z.unit? (' '+escapeHtml(z.unit)) : '';
            var thr = (z.threshold!=null && !isNaN(Number(z.threshold))) ? Number(z.threshold) : null;
            var base = (z.baseline!=null && !isNaN(Number(z.baseline))) ? Number(z.baseline) : null;
            var val = (z.value!=null && !isNaN(Number(z.value))) ? Number(z.value) : null;
            var rising = String(z.direction||'').toLowerCase().indexOf('declin')<0 && String(z.direction||'').toLowerCase().indexOf('fall')<0;
            if(thr!=null && base!=null){ rising = (thr>=base); }
            // prefer REAL telemetry for the "was" value when a trend frame arrived
            var TR = window._aiLastTrend, hero=null, incMs=null;
            try{
                if(TR && TR.series && TR.series.length){
                    var ss=rvParseSeries(TR.series);
                    // v1.0.55.30 BUGFIX: this used to fall back to ss[0] when no derived/trigger
                    // series was present. ss[0] is TPR -- a DIGITAL 0/1 state line -- so "was" came
                    // out as 1 and the move read +736%. A series may only stand in for the metric
                    // if its NAME matches, and a digital series can never be the hero.
                    var wantNm = rvmNorm((z.metric||'') + ' ' + ((v.derived_inputs&&v.derived_inputs.param)||''));
                    for(var i=0;i<ss.length;i++){
                        if(rvmDigital(ss[i])){ continue; }
                        var an=rvmNorm(ss[i].attr||'');
                        if(an && wantNm && (wantNm.indexOf(an)>=0 || an.indexOf(wantNm)>=0)){ hero=ss[i]; break; }
                    }
                    if(!hero){
                        for(var j=0;j<ss.length;j++){
                            if(rvmDigital(ss[j])){ continue; }
                            if(ss[j].isDerived||ss[j].isTrigger){ hero=ss[j]; break; }
                        }
                    }
                    // no confident match -> use NO telemetry rather than the wrong series
                    incMs = rvEvTs((c&&c.time)||'');
                    if(isNaN(incMs)){ incMs=null; }
                }
            }catch(e){}
            var meas=null;
            if(hero && hero.pts && hero.pts.length){ meas = rvmAtAndHealthy(hero.pts, incMs, thr, rising); }

            var h = '<div class="rv-sec sec-moved rvm-sec" style="grid-column:1 / -1;"><div class="rv-eyebrow">How the value moved</div>';

            // v1.0.55.58: for a DERIVED alert the hero is ALERT VALUE vs LIMIT, using the AUTHORITATIVE
            // card value emitted as derived_inputs.value -- NOT a baseline/last-healthy movement and NOT
            // the model's z.value. The per-component movement is shown correctly in the input rows below,
            // so the resting-level flow (which can headline a misleading window-relative move) is not
            // rendered on the derived path. Non-derived alerts keep the was->now telemetry flow.
            if(isDerivedAlert){
                var diH = v.derived_inputs;
                // v1.0.55.60: FAIL CLOSED. Render the derived hero ONLY when the authoritative card
                // value, its own limit, and a breach direction are all present. NEVER fall back to the
                // model z.value/z.threshold/z.unit/direction -- those can belong to a different metric
                // (527969: viz=ITC RELAY END while the derived param is IBALST).
                var haveCardVal = !!(diH && diH.value!=null && !isNaN(Number(diH.value)));
                var haveLimit = !!(diH && diH.limit!=null && !isNaN(Number(diH.limit)));
                var haveDir = !!(diH && diH.breachAbove!=null);
                if(!(haveCardVal && haveLimit && haveDir)){
                    // v1.0.55.71 SL6: only a CACHED verdict can be improved by re-running. On a fresh
                    // run the card itself lacks the value/limit, so "re-run required" sent the user
                    // to repeat what they had just done.
                    var fromCache = !!(v && v.served_from_cache);
                    h += '<div class="rvm-hero"><div class="rvm-cap">'
                       + (fromCache
                          ? 'Alert value/limit unavailable in this stored analysis - re-run to rebuild it.'
                          : 'Alert card does not carry the value and limit for this parameter - re-running will not change this.')
                       + '</div></div>';
                } else {
                    var cardVal = Number(diH.value);
                    var limD = Number(diH.limit);
                    var limUnit = diH.limitUnit ? (' '+escapeHtml(String(diH.limitUnit))) : '';
                    var upD = (diH.breachAbove!==false);
                    var overD = upD ? (cardVal-limD) : (limD-cardVal);
                    var overPctD = (Math.abs(limD)>1e-9) ? (overD/Math.abs(limD)*100) : null;
                    h += '<div class="rvm-hero"><div class="rvm-flow">'
                       + '<span class="rvm-v was">limit '+rvmFmt(limD)+'</span>'
                       + '<span class="rvm-arrow">&#8594;</span>'
                       + '<span class="rvm-v '+((overD>0)?'bad':'ok')+'">'+rvmFmt(cardVal)+'</span>'
                       + '<span class="rvm-unit">'+escapeHtml(String(diH.param||'value'))+metricUnitSuffix(diH.param||'value', diH.limitUnit)+'</span>'
                       + ((overPctD!=null&&overD>0)? ('<span class="rvm-pill bad">'+overPctD.toFixed(1)+'% past limit</span>') : '')
                       + '</div>'
                       + '<div class="rvm-cap">alert value vs its limit</div>';
                    h += '<div class="rvm-thr">'
                       + (overD>0 ? ('breached by <b>'+rvmFmt(overD)+limUnit+'</b>')
                                  : ('<b>'+rvmFmt(Math.abs(overD))+limUnit+'</b> inside the limit'))
                       + '</div>';
                    h += '</div>';
                }
            } else {
                var wasVal = (meas && meas.healthy!=null) ? meas.healthy : base;
                var nowVal = (val!=null) ? val : (meas? meas.at : null);
                // never fall back to the model's pct_change: with no real was/now telemetry the limit
                // line (below) is the headline rather than an invented %.
                var movePct = rvmPct(wasVal, nowVal);
                h += '<div class="rvm-hero"><div class="rvm-flow">'
                   + '<span class="rvm-v was">'+rvmFmt(wasVal)+'</span>'
                   + '<span class="rvm-arrow">&#8594;</span>'
                   + '<span class="rvm-v '+((thr!=null&&nowVal!=null&&(rising? nowVal>thr : nowVal<thr))?'bad':'ok')+'">'+rvmFmt(nowVal)+'</span>'
                   + '<span class="rvm-unit">'+escapeHtml(String(z.metric||'value'))+metricUnitSuffix(z.metric||'value', z.unit)+'</span>'
                   + (movePct!=null? ('<span class="rvm-pill '+(Math.abs(movePct)<1?'ok':'bad')+'">'+(movePct>0?'+':'')+movePct.toFixed(1)+'%</span>') : '')
                   + '</div>'
                   + '<div class="rvm-cap">'
                   + ((meas&&meas.healthy!=null&&meas.healthyT)? ('last healthy reading '+rvFmtDT(meas.healthyT)) : 'normal (resting) level')
                   + ' &rarr; value at the alert</div>';
                if(thr!=null && nowVal!=null){
                    var over = rising ? (nowVal-thr) : (thr-nowVal);
                    var overPct = (Math.abs(thr)>1e-9)? (over/Math.abs(thr)*100) : null;
                    h += '<div class="rvm-thr">Limit <b>'+rvmFmt(thr)+unit+'</b> &middot; '
                       + (over>0 ? ('breached by <b>'+rvmFmt(over)+unit+'</b>'+(overPct!=null?(' ('+overPct.toFixed(1)+'% past the limit)'):''))
                                 : ('still <b>'+rvmFmt(Math.abs(over))+unit+'</b> inside the limit'))
                       + (meas&&meas.peak!=null? (' &middot; worst in window <b>'+rvmFmt(meas.peak)+unit+'</b>') : '')
                       + '</div>';
                }
                h += '</div>';
            }

            // ---- which input moved it (derived only) ----
            // v1.0.55.57: inputs now carry a PREVIOUS-IN-ENVELOPE comparison (referenceValue/deltaPct/
            // comparisonKind/currentOutsideEnvelope), not a window-statistic drift. Read those. Fail
            // CLOSED on a legacy/older-cache payload (inputs present but none of referenceValue/
            // deltaPct/reason) -- never reinterpret the old driftPct.
            var di = v.derived_inputs, ins = (di && di.inputs) ? di.inputs : null;
            if(ins && ins.length){
                var hasCompare=false;
                for(var c0=0;c0<ins.length;c0++){
                    var i0=ins[c0];
                    if(i0.referenceValue!=null || i0.deltaPct!=null || i0.reason!=null){ hasCompare=true; break; }
                }
                if(!hasCompare){
                    h += '<div class="rvm-why">'
                       + ((v && v.served_from_cache)
                          ? 'Previous-comparison data unavailable from this stored analysis - re-run to rebuild it.'
                          : 'Previous-comparison data unavailable for this run - no comparable earlier reading was found.')
                       + '</div>';
                } else {
                    var formula = String(di.formula||'');
                    var worst=null;
                    for(var k=0;k<ins.length;k++){
                        var d=ins[k], dp=(d.deltaPct!=null&&!isNaN(Number(d.deltaPct)))?Number(d.deltaPct):null;
                        if(dp==null){ continue; }
                        if(d.largestDeviation){ worst=d; break; }
                        if(worst==null || Math.abs(dp)>Math.abs(Number(worst.deltaPct))){ worst=d; }
                    }
                    for(var m=0;m<ins.length;m++){
                        var it=ins[m];
                        var p=(it.deltaPct!=null&&!isNaN(Number(it.deltaPct)))?Number(it.deltaPct):null;
                        var cls = (p==null||Math.abs(p)<2)?'flat':(p>0?'up':'dn');
                        var isMain = (worst && it.name===worst.name);
                        var refTxt = (it.referenceValue!=null) ? rvmFmt(it.referenceValue)
                                   : (it.reason? escapeHtml(String(it.reason)) : '-');
                        var outFlag = it.currentOutsideEnvelope? ' <span class="rvm-tag">outside limits</span>' : '';
                        h += '<div class="rvm-row'+(isMain?' main':'')+'">'
                           + '<span class="rvm-nm">'+escapeHtml(String(it.name||'input'))+outFlag+'</span>'
                           + '<span class="rvm-nums">'+refTxt+' &#8594; '+rvmFmt(it.value)+'</span>'
                           + '<span class="rvm-chg '+cls+'">'+(p==null?'-':((p>0?'+':'')+p.toFixed(1)+'%'))+'</span>'
                           + (isMain? '<span class="rvm-tag">biggest move</span>':'')
                           + '</div>';
                    }
                    if(worst){
                        var nm=String(worst.name||''), wp=Number(worst.deltaPct);
                        h += '<div class="rvm-why"><b>Biggest move:</b> '+escapeHtml(nm+' '+(wp>0?'up':'down')+' '
                           + Math.abs(wp).toFixed(1)+'% since its last comparable reading.')+'</div>';
                    }
                    // The DIVISOR is what actually drives a derived value, and it is not always the
                    // biggest mover -- so name it separately and compute how much it alone lifts the
                    // result: value is proportional to 1/divisor, so a fall of p% multiplies by 1/(1-p).
                    for(var q=0;q<ins.length;q++){
                        var dv=ins[q];
                        if(!rvmIsDivisor(dv.name, formula)){ continue; }
                        var dp2=(dv.deltaPct!=null&&!isNaN(Number(dv.deltaPct)))?Number(dv.deltaPct):null;
                        if(dp2==null || Math.abs(dp2)<1){ break; }
                        var factor=(1/(1+dp2/100)-1)*100;
                        h += '<div class="rvm-why"><b>Why the derived value moved:</b> '
                           + escapeHtml(String(dv.name)+' is the DIVISOR in this formula. It '
                             + (dp2<0?'fell':'rose')+' '+Math.abs(dp2).toFixed(1)+'%, which on its own '
                             + (factor>0?'raises':'lowers')+' the computed value by about '
                             + Math.abs(factor).toFixed(0)+'% - even with everything else unchanged.')
                           + '</div>';
                        break;
                    }
                    if(formula){ h += '<div class="rvm-note">'+escapeHtml(formula)+'</div>'; }
                }
            }
            // The model sometimes makes a DRIVER the hero metric and parks the breaching parameter
            // in viz.secondary. Never hide the thing that actually crossed its limit.
            try{
                var sc=z.secondary;
                if(sc && sc.value!=null && !isNaN(Number(sc.value))){
                    var su=sc.unit?(' '+escapeHtml(sc.unit)):'';
                    var st=(sc.x_threshold!=null&&!isNaN(Number(sc.x_threshold)))?Number(sc.x_threshold):null;
                    var sOver=(st!=null)?(Number(sc.value)-st):null;
                    h += '<div class="rvm-row'+((sOver!=null&&sOver>0)?' main':'')+'">'
                       + '<span class="rvm-nm">'+escapeHtml(String(sc.label||'also'))+'</span>'
                       + '<span class="rvm-nums">'+(st!=null? ('limit '+rvmFmt(st)+su+' &#8594; ') : '')+rvmFmt(sc.value)+su+'</span>'
                       + '<span class="rvm-chg '+((sOver!=null&&sOver>0)?'up':'flat')+'">'
                       + ((sOver!=null)? ((sOver>0?'+':'')+rvmFmt(sOver)) : '-')+'</span>'
                       + ((sOver!=null&&sOver>0)? '<span class="rvm-tag">breached</span>':'')
                       + '</div>';
                }
            }catch(e){}
            if(z.phase_note){ h += '<div class="rvm-why">'+escapeHtml(String(z.phase_note))+'</div>'; }
            return h + '</div>';
        }catch(e){ return ''; }
    }
    function renderAiViz(v, c){
        var z = v && v.viz; if (!z) { return ''; }
        // v1.0.47.0: when the analysis streamed REAL telemetry (trend frame), plot it
        // with alert/reset markers instead of the 2-3 point modelled shape.
        var TR = window._aiLastTrend;
        if (TR && ((TR.series && TR.series.length) || (TR.points && TR.points.length >= 5))) {
            var real = renderAiTrendReal(z, TR);
            if (real) { return real; }
        }
        var val = Number(z.value), thr = Number(z.threshold), base = Number(z.baseline);
        var hasVal = !isNaN(val), hasThr = !isNaN(thr), hasBase = !isNaN(base);
        if (!hasVal || (!hasThr && !hasBase)) { return ''; }
        var s = [];
        if (Object.prototype.toString.call(z.series) === '[object Array]') {
            for (var i=0;i<z.series.length;i++){ var p=Number(z.series[i]); if(!isNaN(p)){ s.push(p); } }
        }
        var synth = false;
        if (s.length < 2) {
            // v1.0.55.11: DO NOT fabricate a trend. Previously we synthesized a 6-point
            // straight line from baseline->value (from + (val-from)*(k/5)); that drew a fake
            // "trend" the data never showed (random art). When there are <2 REAL samples we
            // now render ONLY the real reference lines (threshold, healthy-avg) and the single
            // measured value as a marker -- no invented curve. synth stays a flag for the
            // no-data caption; s is left with the real point(s) only.
            synth = true;
        }
        // v1.0.55.11: with no real trend, render only the measured value as a marker on the
        // real reference lines - no invented path. The seg()/marker path logic below is skipped
        // for the synth case via the guards on dHealthy/dBreach/dAfter.
        var lo, hi;
        if (synth) {
            // scale the axis around the REAL numbers we have (value + threshold + baseline),
            // not fabricated points.
            var reals = [];
            if (hasVal) { reals.push(val); }
            if (hasThr) { reals.push(thr); }
            if (hasBase) { reals.push(base); }
            lo = Math.min.apply(null, reals); hi = Math.max.apply(null, reals);
        } else {
            lo = Math.min.apply(null, s); hi = Math.max.apply(null, s);
            if (hasThr){ lo=Math.min(lo,thr); hi=Math.max(hi,thr); }
            if (hasBase){ lo=Math.min(lo,base); hi=Math.max(hi,base); }
        }
        if (hi===lo){ hi=lo+1; }
        var pad=(hi-lo)*0.16; lo-=pad; hi+=pad;
        var L=56,R=544,T=30,B=170;
        function X(idx){ return s.length<=1 ? L : L + (idx/(s.length-1))*(R-L); }
        function Y(u){ return B - (u-lo)/(hi-lo)*(B-T); }

        // breach direction: is a HIGH value bad, or a LOW one?
        var above = hasThr ? (val >= thr) : (hasBase ? val >= base : true);
        function breached(u){ if(!hasThr){ return false; } return above ? (u >= thr) : (u <= thr); }

        // trigger / recovery positions: use the model's percentages when given,
        // otherwise derive them from the first and last breaching sample.
        function pctToIdx(p){
            var n = Number(p);
            if (isNaN(n)) { return -1; }
            n = Math.max(0, Math.min(100, n));
            return Math.round((n/100)*(s.length-1));
        }
        var tIdx = pctToIdx(z.trigger_pct), rIdx = pctToIdx(z.recovery_pct);
        if (tIdx < 0){ for (var a=0;a<s.length;a++){ if (breached(s[a])) { tIdx=a; break; } } }
        if (rIdx < 0 && tIdx >= 0){
            for (var b=tIdx+1;b<s.length;b++){ if (!breached(s[b])) { rIdx=b; break; } }
        }
        var stillBreached = (rIdx < 0) && (tIdx >= 0);

        // split the path: healthy run, breach run, recovered run
        function seg(a,b){
            var d='';
            for (var q=a;q<=b && q<s.length;q++){ d += (q===a?'M':' L')+X(q).toFixed(1)+' '+Y(s[q]).toFixed(1); }
            return d;
        }
        var dHealthy = synth ? '' : (tIdx>0 ? seg(0, tIdx) : (tIdx===0 ? '' : seg(0, s.length-1)));
        var dBreach  = synth ? '' : (tIdx>=0 ? seg(tIdx, (rIdx>=0? rIdx : s.length-1)) : '');
        var dAfter   = synth ? '' : ((rIdx>=0 && rIdx < s.length-1) ? seg(rIdx, s.length-1) : '');
        function plen(d){
            var n=(d.match(/[ML]/g)||[]).length; return Math.max(120, n*46);
        }

        var refs='';
        if (hasBase){ var yb=Y(base).toFixed(1); refs += '<line class="rvz-ref base" x1="'+L+'" y1="'+yb+'" x2="'+R+'" y2="'+yb+'"></line><text class="rvz-reflbl base" x="'+(L+4)+'" y="'+(Number(yb)-5).toFixed(1)+'">healthy avg '+escapeHtml(aiVizNum(base)||'')+(z.unit?(' '+escapeHtml(z.unit)):'')+'</text>'; }
        if (hasThr){ var yt=Y(thr).toFixed(1); refs += '<line class="rvz-ref thr" x1="'+L+'" y1="'+yt+'" x2="'+R+'" y2="'+yt+'"></line><text class="rvz-reflbl thr" x="'+R+'" y="'+(Number(yt)-5).toFixed(1)+'" text-anchor="end">alert threshold '+escapeHtml(aiVizNum(thr)||'')+'</text>'; }
        var breachRect='';
        if (hasThr){ var by=Y(thr); breachRect = '<rect class="rvz-breach" x="'+L+'" y="'+(above?T:by).toFixed(1)+'" width="'+(R-L)+'" height="'+(above?(by-T):(B-by)).toFixed(1)+'"></rect>'; }

        // event markers
        var marks='';
        if (tIdx>=0){
            var tx=X(tIdx), ty=Y(s[tIdx]);
            marks += '<line class="rvz-evt trig" x1="'+tx.toFixed(1)+'" y1="'+T+'" x2="'+tx.toFixed(1)+'" y2="'+B+'"></line>'
                  +  '<circle class="rvz-evtdot trig" cx="'+tx.toFixed(1)+'" cy="'+ty.toFixed(1)+'" r="4.5"></circle>'
                  +  '<text class="rvz-evtlbl trig" x="'+Math.min(tx+6,R-4).toFixed(1)+'" y="'+(T+12)+'">ALERT TRIGGERED'
                  +  (trigClock ? '  '+escapeHtml(trigClock) : '')+'</text>';
        }
        if (rIdx>=0){
            var rx=X(rIdx), ry=Y(s[rIdx]);
            marks += '<line class="rvz-evt rec" x1="'+rx.toFixed(1)+'" y1="'+T+'" x2="'+rx.toFixed(1)+'" y2="'+B+'"></line>'
                  +  '<circle class="rvz-evtdot rec" cx="'+rx.toFixed(1)+'" cy="'+ry.toFixed(1)+'" r="4.5"></circle>'
                  +  '<text class="rvz-evtlbl rec" x="'+Math.min(rx+6,R-4).toFixed(1)+'" y="'+(T+26)+'">RECOVERED'
                  +  ((recClock && recClock !== trigClock) ? '  '+escapeHtml(recClock) : '')+'</text>';
        }
        var trigClock = aiClock(c && c.time);
        var recClock  = aiClock(c && c.resetTime);
        var lastX = synth ? (R-8) : X(s.length-1);
        var lastY = synth ? Y(hasVal?val:(hasBase?base:thr)) : Y(s[s.length-1]);
        var endVal = synth ? (hasVal?val:NaN) : s[s.length-1];
        var endTxt=(aiVizNum(endVal)||'')+(z.unit?(' '+z.unit):'')+(synth?'':(stillBreached?' \u2014 still out':' \u2014 back in band'));
        var fx=Math.max(L, Math.min(lastX-104, R-112));

        var svg = '<svg viewBox="0 0 560 196" preserveAspectRatio="xMidYMid meet">'
            + '<line class="rvz-axis" x1="'+L+'" y1="'+T+'" x2="'+L+'" y2="'+B+'"></line>'
            + '<line class="rvz-axis" x1="'+L+'" y1="'+B+'" x2="'+R+'" y2="'+B+'"></line>'
            + breachRect + refs
            + (dHealthy?('<path class="rvz-seg ok" style="--len:'+plen(dHealthy)+'" d="'+dHealthy+'"></path>'):'')
            + (dBreach?('<path class="rvz-seg bad" style="--len:'+plen(dBreach)+'" d="'+dBreach+'"></path>'):'')
            + (dAfter?('<path class="rvz-seg back" style="--len:'+plen(dAfter)+'" d="'+dAfter+'"></path>'):'')
            + marks
            + '<circle class="rvz-dot'+(stillBreached?' bad':' ok')+'" cx="'+lastX.toFixed(1)+'" cy="'+lastY.toFixed(1)+'" r="4.5"></circle>'
            + '<g class="rvz-flag"><rect x="'+fx.toFixed(1)+'" y="'+(lastY+9).toFixed(1)+'" width="112" height="17" rx="4"></rect>'
            + '<text x="'+(fx+56).toFixed(1)+'" y="'+(lastY+21).toFixed(1)+'" text-anchor="middle">'+escapeHtml(endTxt)+'</text></g>'
            + '<text class="rvz-x" x="'+L+'" y="188">healthy</text>'
            + (trigClock ? '<text class="rvz-x" x="'+((L+R)/2).toFixed(1)+'" y="188" text-anchor="middle">'
                 + escapeHtml(trigClock)
                 + ((recClock && recClock !== trigClock) ? ' \u2192 '+escapeHtml(recClock) : '')
                 + '</text>' : '')
            + '<text class="rvz-x" x="'+R+'" y="188" text-anchor="end">now</text>'
            + '</svg>';

        var reads='';
        var pc = aiVizNum(z.pct_change);
        var arrow = (Number(z.pct_change)<0?'\u2193 ':(Number(z.pct_change)>0?'\u2191 ':''));
        reads += '<div class="rvz-rd a"><div class="k">'+escapeHtml(z.metric||'value')+'</div><div class="vv">'+escapeHtml(aiVizNum(val)||'-')+(z.unit?(' '+escapeHtml(z.unit)):'')+'</div>'+(pc!==null?('<div class="dd">'+arrow+Math.abs(Number(pc))+'% vs healthy avg</div>'):'')+'</div>';
        if (z.secondary && aiVizNum(z.secondary.value)!==null){
            var xt = aiVizNum(z.secondary.x_threshold);
            var su = z.secondary.unit ? (' '+escapeHtml(z.secondary.unit)) : '';
            reads += '<div class="rvz-rd b"><div class="k">'+escapeHtml(z.secondary.label||'secondary')+'</div><div class="vv">'+escapeHtml(aiVizNum(z.secondary.value))+su+'</div>'+(xt!==null?('<div class="dd">'+xt+'\u00d7 threshold</div>'):'')+'</div>';
        }
        if (z.direction){ reads += '<div class="rvz-rd c"><div class="k">State now</div><div class="vv">'+escapeHtml(stillBreached?'still breached':'recovered')+'</div><div class="dd">'+escapeHtml(String(z.direction))+'</div></div>'; }

        var note = z.phase_note ? '<div class="rvz-note">'+escapeHtml(String(z.phase_note))+'</div>' : '';
        var cap = synth ? '<div class="rvz-cap">No telemetry samples returned for the alerting attribute at incidence &mdash; showing the alert-card value against its threshold and healthy average only (no trend to plot).</div>' : '';
        return '<div class="rv-sec rvz-sec"><div class="rv-eyebrow">How the fault developed'+(z.metric?(' <span class="rvz-metric">'+escapeHtml(z.metric)+metricUnitSuffix(z.metric, z.unit)+'</span>'):'')+'</div>'
            + '<div class="rvz">'+svg+note+'<div class="rvz-reads">'+reads+'</div></div>'+cap+'</div>';
    }

    var _aiLastVerdict = null;
    var _aiServerVerdict = null;   // set by the server-validated SSE frame
    var _aiVerdictProvider = null; // provider that produced the DISPLAYED verdict

    // v1.0.25.0: render the raw inputs behind a DERIVED alert + a static cause-chain diagram.
    // Data is server-computed (v.derived_inputs): each input's value, baseline, drift %, and
    // which one drove the derived move. Only shows for derived alerts (RRAIL etc.).
    function renderDerivedInputs(v) {
        var di = v && v.derived_inputs ? v.derived_inputs : null;
        if (!di || !di.inputs || !di.inputs.length) { return ''; }
        var param = escapeHtml(di.param || 'derived');
        var inputs = di.inputs;

        // v1.0.55.57: fail CLOSED on a legacy/older-cache payload (no comparator fields at all) --
        // never reinterpret the old driftPct/windowMean as a comparable-sample movement.
        var hasCompare = false;
        for (var c0 = 0; c0 < inputs.length; c0++) {
            var i0 = inputs[c0];
            if (i0.referenceValue != null || i0.deltaPct != null || i0.reason != null) { hasCompare = true; break; }
        }
        if (!hasCompare) {
            return '<div class="rv-sec di-sec"><div class="rv-eyebrow">Derived value \u2014 component inputs</div>'
                 + '<div class="di-warn">Previous-comparison data unavailable from this stored/older analysis \u2014 re-run required.</div></div>';
        }

        // --- inputs table: movement of each input vs its PREVIOUS IN-ENVELOPE reading ---
        var rows = '';
        var anyStale = false; var STALE_SEC = 600; // 10 min = flag as read well before incidence
        for (var i = 0; i < inputs.length; i++) {
            var inp = inputs[i];
            var nm = escapeHtml(inp.name || '');
            var noReading = inp.noReading === true;
            var val = (inp.value !== undefined && inp.value !== null) ? inp.value : '-';
            var refv = (inp.referenceValue !== undefined && inp.referenceValue !== null) ? inp.referenceValue
                     : (inp.reason ? escapeHtml(String(inp.reason)) : '\u2014');
            var dp = (inp.deltaPct !== undefined && inp.deltaPct !== null) ? inp.deltaPct : null;
            var largest = inp.largestDeviation === true;
            var outside = inp.currentOutsideEnvelope === true;
            // staleness age (seconds before incidence), if provided
            var ageSec = (inp.ageSec !== undefined && inp.ageSec !== null) ? inp.ageSec : null;
            var ageTxt = '';
            if (ageSec !== null) {
                if (ageSec >= STALE_SEC) { anyStale = true; }
                var am = Math.round(ageSec / 60);
                ageTxt = ' <span class="di-age' + (ageSec >= STALE_SEC ? ' di-age-old' : '') + '">'
                       + (ageSec < 90 ? ageSec + 's' : am + 'm') + ' before</span>';
            }
            var outTxt = outside ? ' <span class="di-tag">outside limits</span>' : '';
            if (noReading) {
                // a missing sample encoded as 0 - show "no reading", never a deviation
                rows += '<tr class="di-nulled">'
                     + '<td class="di-nm">' + nm + ageTxt + '</td>'
                     + '<td class="di-num" style="color:#9aa4b1">no reading</td>'
                     + '<td class="di-num di-base">' + refv + '</td>'
                     + '<td class="di-num" style="color:#9aa4b1">\u2014</td>'
                     + '</tr>';
                continue;
            }
            var arrow = dp === null ? '' : (dp > 0 ? ' \u2191' : (dp < 0 ? ' \u2193' : ''));
            var dpTxt = dp === null ? '\u2014' : ((dp > 0 ? '+' : '') + dp + '%' + arrow);
            var dpColor = dp === null ? '#9aa4b1' : (Math.abs(dp) >= 5 ? '#c2410c' : '#5a6472');
            rows += '<tr' + (largest ? ' class="di-drove"' : '') + '>'
                 + '<td class="di-nm">' + nm + (largest ? ' <span class="di-tag">largest \u0394</span>' : '') + outTxt + ageTxt + '</td>'
                 + '<td class="di-num">' + val + '</td>'
                 + '<td class="di-num di-base">' + refv + '</td>'
                 + '<td class="di-num" style="color:' + dpColor + ';font-weight:' + (largest ? '700' : '600') + '">' + dpTxt + '</td>'
                 + '</tr>';
        }
        var table = '<table class="di-table"><thead><tr>'
            + '<th>Input</th><th>At alert</th><th>Previous reading</th><th>Change</th>'
            + '</tr></thead><tbody>' + rows + '</tbody></table>';

        // v1.0.27.0: NO cause-chain diagram. The largest-% deviation is NOT necessarily the input
        // that contributed most to the derived move (for Derived=A-B a small % change in a large
        // term can dominate), so we present this as an OBSERVATION, not a causal claim.
        // v1.0.28.0: if a formula input is a no-reading (0 vs non-zero mean) or components are
        // stale, warn that the system-computed derived value is only indicative - this is why it
        // can diverge from the alert-card value.
        var suspect = di.inputSuspect === true;
        var warnBits = [];
        if (suspect) { warnBits.push('one or more inputs had <b>no reading</b> (shown above)'); }
        if (anyStale) { warnBits.push('some inputs were read <b>well before</b> the alert time'); }
        var warnHtml = '';
        if (warnBits.length) {
            warnHtml = '<div class="di-warn">\u26a0 The system-computed value here is <b>indicative only</b> \u2014 '
                     + warnBits.join(' and ') + ', so it may differ from the alert-card value.</div>';
        }

        return '<div class="rv-sec di-sec"><div class="rv-eyebrow">Derived value \u2014 component inputs</div>'
            + '<div class="di-note">' + param + ' is computed from these inputs (not directly sensed). '
            + 'Each input is compared to its <b>previous comparable reading</b> (the last in-range sample '
            + 'before the alert). The tagged input shows the <b>largest change</b> \u2014 the biggest '
            + 'observed movement, not necessarily the main cause of the derived change. An input flagged '
            + '<b>outside limits</b> is itself past its configured range at the alert.</div>'
            + warnHtml + table + '</div>';
    }

    // v1.0.26.0 #4: triage - a maintenance-PRIORITY hint (NOT an operational order). Shows the
    // server's severity + trend + short note, so a maintainer can tell "attend now" from "can
    // wait" instead of being sent to field on every CONFIRMED. Advisory only; the note has
    // already passed the operational-action filter server-side. Omitted if the verdict carries
    // no triage (model had no basis to judge).
    // v1.0.27.0 #4: triage - a maintenance-PRIORITY hint (NOT an operational order). Now driven
    // by SERVER-COMPUTED evidence: severity/trend derived from a mechanical count of prior alerts
    // with the same asset + cause code. Shows that count as the basis. Only appears when the
    // server attaches triage (feature enabled AND a real basis AND not INCONCLUSIVE). Advisory
    // only; the maintainer decides.
    function renderTriage(v) {
        var t = v && v.triage ? v.triage : null;
        if (!t || !t.severity) { return ''; }
        var sev = (t.severity || '').toLowerCase();
        var sevMap = {
            high:   { lab: 'Attend soon',   col: '#c2410c', bg: '#fff2ec', bd: '#f7c9b3' },
            medium: { lab: 'Plan a visit',  col: '#b0730a', bg: '#fdf6e9', bd: '#f0e0bd' },
            low:    { lab: 'Lower priority', col: '#17976a', bg: '#eefaf4', bd: '#c2ecda' }
        };
        var s = sevMap[sev] || { lab: 'Priority', col: '#5a6472', bg: '#f6f8fa', bd: '#e4e8ee' };
        var trendTxt = '';
        if (t.trend) {
            trendTxt = '<span class="tri-trend">' + escapeHtml(t.trend) + '</span>';
        }
        var out = '<div class="rv-tri" style="background:' + s.bg + ';border-color:' + s.bd + '">';
        out += '<div class="tri-head">';
        out += '<span class="tri-pill" style="background:' + s.col + '">' + s.lab + '</span>';
        out += '<span class="tri-cap">Maintenance priority' + (sev ? (' \u00b7 ' + escapeHtml(sev)) : '') + '</span>';
        out += trendTxt;
        out += '</div>';
        // evidence basis - the count of OTHER same-cause alerts on this asset in the fetched
        // incidence window (current alert excluded), server-counted.
        var cnt = (t.otherSameCauseInWindow !== undefined && t.otherSameCauseInWindow !== null) ? t.otherSameCauseInWindow : null;
        if (cnt !== null) {
            var word = cnt === 0 ? 'no other alerts of this type on this asset in the fetched window (isolated)'
                     : (cnt === 1 ? '1 other alert of this type on this asset in the fetched window'
                     : cnt + ' other alerts of this type on this asset in the fetched window');
            out += '<div class="tri-note">Based on ' + word + '.</div>';
        }
        out += '<div class="tri-foot">Priority guidance from alert history only \u2014 the maintainer decides whether to attend.</div>';
        out += '</div>';
        return out;
    }

    // v1.0.25.0: weather placeholder. The get_weather tool is not built yet, so weather is not
    // available; show an honest placeholder. When the tool lands and the verdict carries
    // v.weather, swap this to render the real data.
    // v1.0.55.3: at-a-glance weather icon (sun/cloud/rain/storm/snow/fog) from condition+summary.
    // v1.0.55.34: icon strip became a CARD - rvwxKind() classifies, rvwxScene() draws a 48px
    // ANIMATED inline-SVG scene (CSS keyframes, no GIF/CDN), card is condition-tinted with big
    // temperature and condition/rainfall sub-line. rvWeatherIcon() retired.
    function rvwxKind(cond, summary){
        var t=((cond||'')+' '+(summary||'')).toLowerCase();
        if(/thunder|storm|lightning/.test(t)) return 'storm';
        if(/snow|sleet/.test(t)) return 'snow';
        if(/rain|drizzle|shower/.test(t)) return 'rain';
        if(/wind|breez|gust|squall/.test(t)) return 'wind';
        if(/mist|fog|haze|smoke/.test(t)) return 'fog';
        if(/cloud|overcast/.test(t)) return 'cloud';
        if(/clear|sunny|sun|fair/.test(t)) return 'sun';
        return 'def';
    }
    function rvwxScene(kind){
        function svg(inner){ return '<svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true">'+inner+'</svg>'; }
        var cloud='<path d="M7 15a4 4 0 01-.5-8 5 5 0 019.5-1.5A3.5 3.5 0 0117 15H7z" stroke="#64748b" stroke-width="1.5" fill="#fff"/>';
        if(kind==='storm'){ return svg(cloud+'<path class="rvwx-boltp" d="M12 12l-2 4h3l-2 4" stroke="#f59e0b" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"/>'); }
        if(kind==='snow'){ return svg(cloud+'<g stroke="#38bdf8" stroke-width="1.6" stroke-linecap="round">'
            +'<circle class="rvwx-flakec" cx="9" cy="18" r=".8" fill="#38bdf8"/>'
            +'<circle class="rvwx-flakec" cx="13" cy="18" r=".8" fill="#38bdf8" style="animation-delay:.6s"/>'
            +'<circle class="rvwx-flakec" cx="17" cy="18" r=".8" fill="#38bdf8" style="animation-delay:1.2s"/></g>'); }
        if(kind==='rain'){ return svg(cloud+'<g stroke="#3b82f6" stroke-width="1.7" stroke-linecap="round">'
            +'<path class="rvwx-dropl" d="M9 17v2.6"/>'
            +'<path class="rvwx-dropl" d="M13 17v2.6" style="animation-delay:.4s"/>'
            +'<path class="rvwx-dropl" d="M17 17v2.6" style="animation-delay:.8s"/></g>'); }
        if(kind==='wind'){ return svg('<g class="rvwx-gustp" stroke="#0d9488" stroke-width="1.7" stroke-linecap="round">'
            +'<path d="M3 9h11a2.4 2.4 0 10-2.4-2.6"/>'
            +'<path d="M3 14h15a2.4 2.4 0 11-2.4 2.6" style="animation-delay:.5s"/></g>'); }
        if(kind==='fog'){ return svg('<g stroke="#94a3b8" stroke-width="1.7" stroke-linecap="round">'
            +'<path class="rvwx-fogl" d="M4 9h16"/>'
            +'<path class="rvwx-fogl" d="M4 13h16" style="animation-delay:1.3s"/>'
            +'<path class="rvwx-fogl" d="M6 17h12" style="animation-delay:2.6s"/></g>'); }
        if(kind==='cloud'){ return svg('<g class="rvwx-driftg">'+cloud.replace('M7 15','M7 16').replace('0117 15H7z','0117 16H7z')+'</g>'); }
        if(kind==='sun'){ return svg('<circle cx="12" cy="12" r="4.3" stroke="#f59e0b" stroke-width="1.7" fill="#fde68a"/>'
            +'<g class="rvwx-rays" stroke="#f59e0b" stroke-width="1.7" stroke-linecap="round">'
            +'<path d="M12 3v2.5M12 18.5V21M3 12h2.5M18.5 12H21M5.6 5.6l1.7 1.7M16.7 16.7l1.7 1.7M18.4 5.6l-1.7 1.7M7.3 16.7l-1.7 1.7"/></g>'); }
        return svg('<circle cx="12" cy="12" r="4.3" stroke="#94a3b8" stroke-width="1.7"/>');
    }
    function renderWeatherSlot(v) {
        var w = v && v.weather ? v.weather : null;
        if (w && (w.summary || w.tempC !== undefined || w.condition)) {
            var kind = rvwxKind(w.condition, w.summary);
            var hasTemp = (w.tempC !== undefined && w.tempC !== null);
            var big = hasTemp ? escapeHtml(String(w.tempC)) + '\u00b0C' : escapeHtml(w.condition || '\u2014');
            var sub = [];
            if (w.condition && hasTemp) { sub.push(escapeHtml(w.condition)); }
            if (w.summary) { sub.push(escapeHtml(w.summary)); }
            return '<div class="rv-weather rvwx-card rvwx-' + kind + '">'
                 +   '<div class="rvwx-scene">' + rvwxScene(kind) + '</div>'
                 +   '<div class="rvwx-body">'
                 +     '<span class="rv-weather-cap">Weather at alert time</span>'
                 +     '<div class="rvwx-big">' + big + '</div>'
                 +     (sub.length ? '<div class="rvwx-sub">' + sub.join(' \u00b7 ') + '</div>' : '')
                 +   '</div>'
                 + '</div>';
        }
        return '<div class="rv-weather rv-weather-na"><span class="rv-weather-cap">Weather at alert time</span> not available <span class="rv-weather-sub">(weather tool pending)</span></div>';
    }

    // v1.0.55.38: TRAIN CONTEXT card. The controller has been emitting v.train_context for many
    // versions and nothing rendered it. Two DISTINCT things are shown, deliberately separated:
    //   scheduled=true + matches[]  -> a train was booked through the station INSIDE the window.
    //                                  This is the ONLY part that can support a shunt explanation.
    //   previous / next             -> nearest trains OUTSIDE the window. Orientation ONLY; the card
    //                                  says so, so a train hours away is never read as the cause.
    function rvtrIcon(){
        return '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">'
             + '<rect x="5" y="3.5" width="14" height="12.5" rx="3" stroke="#0f766e" stroke-width="1.5" fill="#fff"/>'
             + '<path d="M5.5 9.5h13" stroke="#0f766e" stroke-width="1.3"/>'
             + '<circle cx="9" cy="12.8" r="1.05" fill="#0f766e"/><circle cx="15" cy="12.8" r="1.05" fill="#0f766e"/>'
             + '<path d="M8 16l-2 4M16 16l2 4" stroke="#0f766e" stroke-width="1.5" stroke-linecap="round"/></svg>';
    }
    // v1.0.55.41: 579 min is hard to read; 9h 39m is not.
    function rvtrDur(m){
        m = parseInt(m, 10); if (isNaN(m)) { return ''; }
        if (m < 90) { return m + ' min'; }
        var h = Math.floor(m / 60), r = m % 60;
        return h + 'h' + (r ? ' ' + r + 'm' : '');
    }
    function rvtrLine(t){
        if(!t) { return ''; }
        var no = escapeHtml(String(t.train_no || ''));
        var nm = t.train_name ? escapeHtml(String(t.train_name)) : '';
        var tm = escapeHtml(String(t.sched_time || ''));
        var dp = (t.dep_time && t.dep_time !== t.sched_time) ? '\u2013' + escapeHtml(String(t.dep_time)) : '';
        return '<b>' + no + '</b>' + (nm ? ' ' + nm : '') + ' \u00b7 ' + tm + dp;
    }
    function renderTrainSlot(v) {
        var t = v && v.train_context ? v.train_context : null;
        if (!t) { return ''; }                       // block omitted server-side (feature off / no code)
        var stn = t.station ? escapeHtml(String(t.station)) : '';
        var at  = t.alert_time ? escapeHtml(String(t.alert_time)) : '';
        var win = (t.window_min !== undefined && t.window_min !== null) ? String(t.window_min) : '';
        var sched = !!t.scheduled;
        var m = (t.matches && t.matches.length) ? t.matches[0] : (t.nearest || null);
        var big = sched
            ? 'Train scheduled at the alert minute'
            : 'No train booked within \u00b1' + escapeHtml(win) + ' min';
        var h = '<div class="rv-weather rvtr-card' + (sched ? '' : ' rvtr-none') + '">'
              +   '<div class="rvtr-scene">' + rvtrIcon() + '</div>'
              +   '<div class="rvtr-body">'
              +     '<span class="rv-weather-cap">Trains at ' + stn + (at ? ' \u00b7 alert ' + at : '') + '</span>'
              +     '<div class="rvtr-big">' + big + '</div>';
        if (sched && m) {
            var d = (m.delta_min === 0) ? 'at the station now'
                  : (m.delta_min < 0 ? Math.abs(m.delta_min) + ' min before the alert' : m.delta_min + ' min after the alert');
            h += '<div class="rvtr-sub">' + rvtrLine(m) + ' \u00b7 ' + escapeHtml(d) + '</div>';
        }
        // v1.0.55.41: every offset here is measured from the ALERT time, never from now. Say so, or a
        // reader at 11:00 sees 'in 60 min' against an 18:44 train and reasonably suspects a clock bug.
        if (t.previous) { h += '<div class="rvtr-row">Last: ' + rvtrLine(t.previous)
                             + (t.previous.mins_since !== undefined ? ' \u00b7 ' + rvtrDur(t.previous.mins_since) + ' before the alert' : '') + '</div>'; }
        if (t.next)     { h += '<div class="rvtr-row">Next: ' + rvtrLine(t.next)
                             + (t.next.mins_until !== undefined ? ' \u00b7 ' + rvtrDur(t.next.mins_until) + ' after the alert' : '') + '</div>'; }
        if (t.trains_today !== undefined && t.trains_today !== null) {
            h += '<div class="rvtr-row">' + escapeHtml(String(t.trains_today)) + ' trains booked here today</div>';
        }
        h += '<div class="rvtr-anim"><div class="rvtr-rail"></div><div class="rvtr-loco">'
           + '<svg width="64" height="18" viewBox="0 0 64 18" aria-hidden="true">'
           // Vande Bharat: ONE articulated set, not a loco pulling coaches. The sloped nose and the
           // unbroken window band are what make it read correctly at this size.
           // --- leading car: nose slopes from the rail up to the roof ---
           + '<path d="M2.2 12.4 L4.2 7.4 Q5.6 4.6 8.8 4.6 L30 4.6 L30 12.4 Z" fill="#f4f7fb" stroke="#0f766e" stroke-width="1"/>'
           // continuous window band -- the single most recognisable feature
           + '<path d="M6.6 7.2 Q7.4 6.2 9.2 6.2 L30 6.2 L30 9 L5.6 9 Z" fill="#0f766e"/>'
           // headlamp cluster low in the nose
           + '<circle cx="4.6" cy="10.6" r="1" fill="#ffe6a3"/>'
           // --- trailing car ---
           + '<rect x="31.5" y="4.6" width="30" height="7.8" rx="1.2" fill="#f4f7fb" stroke="#0f766e" stroke-width="1"/>'
           + '<rect x="33" y="6.2" width="27" height="2.8" fill="#0f766e"/>'
           // gangway: articulated, so the cars meet rather than couple
           + '<rect x="29.8" y="6" width="2" height="6" fill="#cfd6e0"/>'
           // bogies in PAIRS under the car ends, the way a trainset sits
           + '<circle cx="9" cy="13.6" r="1.5" fill="#0b5c55"/><circle cx="13" cy="13.6" r="1.5" fill="#0b5c55"/>'
           + '<circle cx="24" cy="13.6" r="1.5" fill="#0b5c55"/><circle cx="28" cy="13.6" r="1.5" fill="#0b5c55"/>'
           + '<circle cx="36" cy="13.6" r="1.5" fill="#0b5c55"/><circle cx="40" cy="13.6" r="1.5" fill="#0b5c55"/>'
           + '<circle cx="54" cy="13.6" r="1.5" fill="#0b5c55"/><circle cx="58" cy="13.6" r="1.5" fill="#0b5c55"/>'
           + '</svg></div></div>';
        h += '<div class="rvtr-note">' + (sched
             ? 'Scheduled, not confirmed passage \u2014 verify the running day with section control.'
             : 'Last/next are orientation only \u2014 not evidence that a train influenced this alert.') + '</div>';
        h += '</div></div>';
        return h;
    }

    // v1.0.21.0: follow-up threads are PER ENGINE, or a follow-up on one engine would ship
    // another engine's conversation as its context and poison the comparison
    function aiChatKey(id) { return String(id) + '|' + (_aiVerdictProvider || _aiProvider); }

    // Provider is chosen PER REQUEST and travels in the context, so the same alert
    // can be run through both and the envelopes compared directly. It is not a
    // global setting: switching does not disturb an analysis already in flight.
    var _aiProvider = 'quantum10';   // v1.0.55.173: default is QUANTUM (DeepSeek Pro) for everyone (was quantum11/Flash since .66)

    function aiWithProvider(ctx) {
        if (ctx) { ctx.provider = _aiProvider; ctx.think = _aiThink; }   // v1.0.55.37
        return ctx;
    }
    // v1.0.55.48: Re-run must reach the SERVER. Without this the server-side cache would hand a
    // stored verdict back to the operator who pressed Re-run precisely to get a fresh one.
    function aiWithForce(ctx, force) {
        ctx = aiWithProvider(ctx);
        if (ctx) { ctx.force = !!force; }
        return ctx;
    }

    // v1.0.55.37: THINK applies to the QUANTUM engines only; the checkbox is hidden for
    // NEXUS/ORION so it cannot look active where it has no effect.
    function fnAiIsQuantum(p) { p = String(p || "").toLowerCase(); return p.indexOf("quantum") >= 0; }
    function fnAiSyncThinkUi(p) {
        var w = document.getElementById("aiThinkWrap");
        if (w) { w.style.display = fnAiIsQuantum(p) ? "" : "none"; }
    }
    function fnAiSetThink(on) {
        _aiThink = !!on;
        if (_currentAlertContext) { _currentAlertContext.think = _aiThink; }
        var c = document.getElementById("aiThinkChk");
        if (c && c.checked !== _aiThink) { c.checked = _aiThink; }
    }
    function fnAiSetProvider(p) {
        _aiProvider = p;
        // The context is built once when an alert opens, and Re-analyze posts it
        // unchanged -- so updating only the variable meant the picker did nothing
        // until a different alert was opened. Update the live context too.
        if (_currentAlertContext) { _currentAlertContext.provider = p; _currentAlertContext.think = _aiThink; }
        fnAiSyncThinkUi(p);
        // v1.0.38.0: dropdown picker. Keep the <select> in sync when provider is set
        // programmatically (e.g. restored from a cached verdict's provider).
        var sel = document.getElementById('aiProvSel');
        if (sel && sel.value !== p) { sel.value = p; }
        // v1.0.39.0: if the start prompt is showing, relabel its Analyze button
        var sm = document.getElementById('aiStartModel');
        if (sm) { sm.textContent = aiModelLabel(p); }
        // harmless if the legacy buttons are absent
        $('#aiProvWrap .ai-prov-b').each(function () {
            $(this).toggleClass('on', $(this).attr('data-prov') === p);
        });
    }

    // The progress trail is replaced by the verdict the moment the run finishes, so
    // the timings that explain a slow or wrong analysis are gone exactly when someone
    // wants to report it. Keep the trail and write it out on request.
    // v1.0.55.11: per-alert Tool trace card. Fetches THIS run's tool calls (by convId) and
    // shows each as an expandable row: friendly name, raw tool name, timing, result size, and
    // on click the exact args it was called with and what it returned. For debugging.
    // v1.0.55.11: read the verdict aloud using the browser's built-in speech synthesis
    // (offline, no external service, no cost). Toggles: click again to stop.
    // v1.0.55.28: Speak reads the STORY, not just the headline -- the same five chapters the deck
    // shows (what happened / the numbers / why / what to do / how sure), in English or Hindi.
    function aiSpeakScript(lang){
        var v = _aiServerVerdict || window._aiLastVerdictObj;
        if(!v){ return window._aiSpeakText || ''; }
        var hi = (lang==='hi' && v.hi) ? v.hi : null;
        var parts = [];
        var head = hi ? (hi.headline||v.headline) : v.headline;
        if(head){ parts.push((hi?'Kya hua. ':'What happened. ') + head + '.'); }
        var cause = hi ? (hi.likely_cause||v.likely_cause) : v.likely_cause;
        if(cause){ parts.push(cause + '.'); }
        var z = v.viz||{};
        if(z.value!=null && !isNaN(Number(z.value))){
            var u = z.unit||'';
            var line = (hi?'Aankde. ':'The numbers. ') + (z.metric||'value') + ' ' + z.value + ' ' + u;
            if(z.threshold!=null && !isNaN(Number(z.threshold))){
                line += (hi?', threshold ':', against a limit of ') + z.threshold + ' ' + u;
            }
            if(z.baseline!=null && !isNaN(Number(z.baseline))){
                line += (hi?', normal ':', normal is ') + z.baseline + ' ' + u;
            }
            parts.push(line + '.');
        }
        var ev = (hi && hi.evidence && hi.evidence.length) ? hi.evidence : (v.evidence||[]);
        if(ev.length){
            parts.push(hi?'Hum aisa kyun maante hain. ':'Why we think so. ');
            for(var i=0;i<Math.min(ev.length,4);i++){ parts.push(String(ev[i]).replace(/\s+/g,' ') + '.'); }
        }
        var act = v.recommended_action || (hi? hi.recommended_action_en : '');
        if(act){ parts.push((hi?'Kya karein. ':'What to do. ') + act + '.'); }
        var cf = (v.confidence!=null && !isNaN(Number(v.confidence))) ? Math.round(Number(v.confidence)) : null;
        var cav = hi ? (hi.caveats||v.caveats) : v.caveats;
        if(cf!=null){ parts.push((hi?'Kitna yaqeen. ':'How sure. ') + cf + (hi?' percent.':' percent confident.')); }
        if(cav){ parts.push((hi?'Dhyaan de. ':'Caveat. ') + cav); }
        return parts.join(' ');
    }
    function aiSpeakGo(lang){
        try{
            var old=document.getElementById('rvkAsk'); if(old&&old.parentNode){ old.parentNode.removeChild(old); }
            var btn=document.getElementById('aiSpeakBtn');
            if(window.speechSynthesis.speaking){ window.speechSynthesis.cancel(); }
            var txt=aiSpeakScript(lang);
            if(!txt){ return; }
            var u=new SpeechSynthesisUtterance(txt);
            u.rate=0.98; u.pitch=1.0; u.lang = (lang==='hi') ? 'hi-IN' : 'en-IN';
            var vs=window.speechSynthesis.getVoices()||[];
            var want = (lang==='hi') ? /hi[-_]IN/i : /en[-_]IN/i;
            for(var i=0;i<vs.length;i++){ if(want.test(vs[i].lang)){ u.voice=vs[i]; break; } }
            if(!u.voice && lang==='hi'){
                // no Hindi voice installed -- say so once rather than reading Hindi with an English voice
                for(var j=0;j<vs.length;j++){ if(/en[-_]IN|en[-_]GB|en[-_]US/i.test(vs[j].lang)){ u.voice=vs[j]; break; } }
            }
            if(btn){ btn.innerHTML='&#9632; Stop'; }
            u.onend=function(){ if(btn){ btn.innerHTML='&#128266; Speak'; } };
            u.onerror=function(){ if(btn){ btn.innerHTML='&#128266; Speak'; } };
            window.speechSynthesis.speak(u);
        }catch(e){}
    }
    // v1.0.55.28: voice input for the follow-up box. NOTE: SpeechRecognition requires a SECURE
    // CONTEXT -- on a plain http origin the browser does not expose it at all, so the button
    // explains that instead of failing silently. Speaking (speechSynthesis) works on http and is
    // unaffected.
    var _aiRec=null, _aiRecOn=false;
    function fnAiMic(){
        var btn=document.getElementById('aiMicBtn');
        var SR = window.SpeechRecognition || window.webkitSpeechRecognition;
        if(!SR || !window.isSecureContext){
            alert('Voice input needs a secure page (https) - this app is served over http, so the browser blocks the microphone API.\n\nSpeak (reading the verdict aloud) still works.');
            if(btn){ btn.disabled=true; }
            return;
        }
        try{
            if(_aiRecOn && _aiRec){ _aiRec.stop(); return; }
            _aiRec = new SR();
            _aiRec.lang='en-IN'; _aiRec.interimResults=true; _aiRec.maxAlternatives=1;
            _aiRec.onstart=function(){ _aiRecOn=true; if(btn){ btn.className='rv-mic on'; } };
            _aiRec.onresult=function(e){
                var t='';
                for(var i=e.resultIndex;i<e.results.length;i++){ t += e.results[i][0].transcript; }
                var inp=document.getElementById('aiChatIn'); if(inp){ inp.value=t.trim(); }
            };
            _aiRec.onerror=function(){ _aiRecOn=false; if(btn){ btn.className='rv-mic'; } };
            _aiRec.onend=function(){ _aiRecOn=false; if(btn){ btn.className='rv-mic'; } };
            _aiRec.start();
        }catch(e){ if(btn){ btn.className='rv-mic'; } }
    }
    // v1.0.55.31: MERGED FROM THE OTHER TEAM'S Index_21 (AlertAnalysis) -- role gate on the UI.
    // Presentation only; the server enforces the same rule in GateProviderForRole (1.0.160.1).
    function aaApplySiteKeepGate() {
        // 1) Model: force QUANTUM and hide the whole picker.
        // v1.0.55.66 H3: quantum11 is the approved unconditional default -- it is the only id that
        // carries its model override; the plain family id resolves to a different (slower) model.
        try { if (typeof fnAiSetProvider === 'function') { fnAiSetProvider('quantum10'); } } catch (e) { }   // v1.0.55.173: Pro for ordinary users too
        var pv = document.getElementById('aiProvWrap');
        if (pv) { pv.style.display = 'none'; }
        // 2) Wisdom bar: keep only "Save last as wisdom".
        var wPanelBtn = document.querySelector('#aiWisdomBar button[onclick="wisdomOpenPanel()"]');
        var wManageBtn = document.querySelector('#aiWisdomBar a');
        if (wPanelBtn) { wPanelBtn.style.display = 'none'; }
        if (wManageBtn) { wManageBtn.style.display = 'none'; }
        // 3) Diagnostic buttons: hide Log / AI logs / Trace / Debug tools / Re-run.
        // v1.0.55.44: Re-run REMOVED from this list. Owner rule: site-keeping users and the
        // explicit config emails get all debug and tools; everyone else gets Analyze AND RE-RUN.
        // Re-run was being hidden with the debug buttons, so ordinary users could analyse once
        // and had no way to re-run -- more restrictive than intended.
        ['aiDiagBtn', 'aiLogsBtn', 'aiToolTraceBtn', 'aiDebugToolsBtn']
            .forEach(function (idv) { var b = document.getElementById(idv); if (b) { b.style.display = 'none'; } });
        // Dismiss stays. wSaveBtn stays.
    }
    function fnAiSpeak() {
        try {
            if (!('speechSynthesis' in window)) { alert('Voice output is not supported in this browser.'); return; }
            var btn = document.getElementById('aiSpeakBtn');
            if (window.speechSynthesis.speaking) {
                window.speechSynthesis.cancel();
                if (btn) { btn.innerHTML = '&#128266; Speak'; }
                return;
            }
            // v1.0.55.28: ask the language before reading. Two taps, no dialog box.
            var prev=document.getElementById('rvkAsk');
            if(prev){ if(prev.parentNode){ prev.parentNode.removeChild(prev); } return; }
            var box=document.createElement('div');
            box.id='rvkAsk'; box.className='rvk-ask';
            box.innerHTML='<button type="button" onclick="aiSpeakGo(\'en\')">English</button>'
                        + '<button type="button" onclick="aiSpeakGo(\'hi\')">\u0939\u093f\u0928\u094d\u0926\u0940</button>';
            if(btn && btn.parentNode){
                btn.parentNode.style.position='relative';
                box.style.right='0'; box.style.top=(btn.offsetTop+btn.offsetHeight+6)+'px';
                btn.parentNode.appendChild(box);
            } else { document.body.appendChild(box); }
            return;
            /* unreachable legacy path kept for reference */
            var txt = window._aiSpeakText || '';
            if (!txt) { return; }
            var u = new SpeechSynthesisUtterance(txt);
            u.rate = 0.98; u.pitch = 1.0; u.lang = 'en-IN';
            var vs = window.speechSynthesis.getVoices() || [];
            for (var i=0;i<vs.length;i++){ if (/en[-_]IN/i.test(vs[i].lang)) { u.voice = vs[i]; break; } }
            u.onend = function(){ if (btn) { btn.innerHTML = '&#128266; Speak'; } };
            u.onerror = function(){ if (btn) { btn.innerHTML = '&#128266; Speak'; } };
            if (btn) { btn.innerHTML = '&#9632; Stop'; }
            window.speechSynthesis.speak(u);
        } catch(e) { /* ignore */ }
    }

    // v1.0.55.18: copy the trace as JSON. NOTE: this app is served over plain HTTP, where
    // navigator.clipboard is undefined (secure-context only) -- so always keep the textarea +
    // execCommand fallback, and confirm on the button so the operator knows it landed.
    function aiCopyText(txt, btn) {
        function done(ok){ if(!btn){ return; } var old=btn.getAttribute('data-lbl')||btn.textContent;
            btn.setAttribute('data-lbl', old); btn.textContent = ok ? 'copied' : 'copy failed';
            setTimeout(function(){ btn.textContent = btn.getAttribute('data-lbl'); }, 1400); }
        try{
            if(navigator.clipboard && window.isSecureContext){
                navigator.clipboard.writeText(txt).then(function(){ done(true); }, function(){ done(false); }); return;
            }
        }catch(e){}
        try{
            var ta=document.createElement('textarea'); ta.value=txt;
            ta.setAttribute('readonly',''); ta.style.cssText='position:absolute;left:-9999px;top:0;';
            document.body.appendChild(ta); ta.select(); ta.setSelectionRange(0, txt.length);
            var ok=document.execCommand('copy'); document.body.removeChild(ta); done(ok);
        }catch(e2){ done(false); }
    }
    // v1.0.55.23: TagIds are 19 digits (~7.25e17) -- past JS's 2^53 safe integer, so JSON.parse
    // silently ROUNDS them and three distinct tags all exported as ...801000. Keep any payload
    // containing a 16+ digit bare integer as its original STRING so the export stays faithful.
    function aiTraceBigInt(t){ try{ return /[:\[,]\s*-?\d{16,}(?![.\d])/.test(t); }catch(e){ return false; } }
    function aiTraceJsonVal(v){ if(v==null){ return null; }
        if(typeof v!=='string'){ return v; }
        var t=v.trim(); if(!t){ return ''; }
        if(aiTraceBigInt(t)){ return v; }   // v1.0.55.23: keep 19-digit TagIds exact
        if(t.charAt(0)==='{'||t.charAt(0)==='['){ try{ return JSON.parse(t); }catch(e){} }
        return v; }
    function aiTraceRowJson(c){ return { seq:c._seq, tool:c.tool, stage:c.stage||'model', phase:c.phase,
        server:c.server, iteration:c.iter, elapsedMs:c.ms, resultLength:c.resultLen,
        args:aiTraceJsonVal(c.args), result:aiTraceJsonVal(c.result), error:c.error||'' }; }
    function aiTraceCopyOne(i, btn){ try{ var d=window._aiTraceData; if(!d||!d.calls||!d.calls[i]){ return; }
        aiCopyText(JSON.stringify(aiTraceRowJson(d.calls[i]), null, 2), btn); }catch(e){} }
    function aiTraceCopyAll(btn){ try{ var d=window._aiTraceData; if(!d||!d.calls){ return; }
        var rows=[], pf=0;
        for(var i=0;i<d.calls.length;i++){ rows.push(aiTraceRowJson(d.calls[i])); if(d.calls[i].stage==='prefetch'){ pf++; } }
        aiCopyText(JSON.stringify({ runId:d.convId, calls:d.calls.length, prefetch:pf,
            inLoop:d.calls.length-pf, exportedAt:new Date().toISOString(), trace:rows }, null, 2), btn);
    }catch(e){} }
    // v1.0.55.22: the trace card is inserted next to the footer button, which SURVIVES a modal
    // close/open -- so a previous run's trace stayed on screen over a fresh, un-analysed alert.
    // Drop it when a new alert is opened or a new analysis starts; the sticky preference
    // (window._aiTraceAuto) is deliberately KEPT so it re-opens once the new run has an id.
    function aiTraceDrop(){ try{ var b=document.getElementById('aiToolTraceBox'); if(b&&b.parentNode){ b.parentNode.removeChild(b); } }catch(e){} }
    function aiTraceClose(){ aiTraceDrop(); try{ window._aiTraceAuto = false; }catch(e){} }
    // v1.0.55.29: every render goes through the modal shell -- identity strip, sticky header
    // (counts + copy all + Close), scrolling body. Only the body changes between states.
    function aiTraceShell(box, idLine, titleHtml, actionsHtml, bodyHtml){
        box.innerHTML = '<div class="rvk-md">'
            + (idLine ? ('<div class="rvk-md-id">' + escapeHtml(idLine) + '</div>') : '')
            + '<div class="rvk-md-h"><span>' + titleHtml + '</span>'
            + '<span style="display:flex;gap:12px;align-items:center;">' + (actionsHtml || '')
            + '<button type="button" class="rvk-x" onclick="aiTraceClose()">Close</button></span></div>'
            + '<div class="rvk-md-b">' + bodyHtml + '</div></div>';
    }
    // v1.0.55.23: a trace belongs to ONE alert run. Removing the card on context change was not
    // enough -- bind it to an identity (alertId + cause + asset + station + incidence) and drop it
    // whenever that identity stops matching the alert on screen, so a carried-over card can never
    // be misread as belonging to the current alert.
    function aiTraceIdent(){ var c=_currentAlertContext||{};
        return { id:(_aiCurrentAlertId||''), cause:(c.causeCode||''), asset:(c.assetName||''),
                 station:(c.station||''), time:(c.time||'') }; }
    function aiTraceIdentKey(o){ return [o.id,o.cause,o.asset,o.station,o.time].join('|'); }
    function aiTraceIdLine(o){ try{ return [ (o.id?('#'+o.id):''), o.cause,
        ((o.asset||'')+(o.station?(' \u00b7 '+o.station):'')), o.time ]
        .filter(function(x){ return !!x; }).join('  \u00b7  '); }catch(e){ return ''; } }
    // v1.0.55.29: THE RULE THAT ACTUALLY HOLDS -- a trace belongs to ONE RUN, not to an alert.
    // Binding to the alert (55.23) kept the card alive when the SAME alert was re-opened, so a
    // previous run's calls sat over a fresh "Choose a model" screen. Now: the card carries the
    // sse-... run it was fetched for, and may exist ONLY while that equals the current run id.
    // No run id (nothing analysed yet) => no card can match => no card can survive.
    function aiTraceCheck(){ try{ var b=document.getElementById('aiToolTraceBox'); if(!b){ return; }
        var curRun = window._aiConvId || '';
        if(b.getAttribute('data-run') !== curRun){ aiTraceDrop(); return; }
        if(b.getAttribute('data-ident')!==aiTraceIdentKey(aiTraceIdent())){ aiTraceDrop(); } }catch(e){} }
    // v1.0.55.25: closing the popup FLUSHES the trace outright -- card removed AND the sticky
    // auto-open preference cleared, so nothing is ever carried into the next alert. Re-open it
    // deliberately with the Trace button when it is wanted.
    function rvsTeardown(){ try{ _rvsManual=true; rvsAutoStop(true); }catch(e){} }
    function aiTraceFlush(){ try{ rvsTeardown(); }catch(e){} aiTraceDrop(); try{ window._aiTraceAuto = false; window._aiTraceData = null; }catch(e){} }
    // ================= RATE THIS ANALYSIS (v1.0.55.163) =================
    // The outcome signal .101 removed, rebuilt as a rating. Its three rules are the
    // reasons this code looks the way it does:
    //   1. HIDDEN, not disabled, until a row id exists for the OPEN alert -- .101 pulled
    //      the old bar because a visible control that cannot save makes an operator
    //      believe a judgement was recorded when it was not;
    //   2. a failed post says NOT SAVED and leaves the stars editable, same reason;
    //   3. the post goes to a same-origin action, never at the rating host directly --
    //      plain http from an https page, internal name, the .157 PM Analysis wall.
    var _AI_RATE_WORD = ['Poor', 'Fair', 'Average', 'Good', 'Excellent'];
    var _aiRatedByAnalysis = {};   // analysisId -> { rating, comment, by }
    var _aiRateSel = 0;
    var _aiRateComment = '';
    var _aiRateForId = null;
    var _aiRateBusy = false;
    // v1.0.55.169: the overlay has a fourth state now -- EDIT, an existing rating reopened as a
    // form. It is deliberately NOT persisted per analysis: closing the overlay and reopening it
    // shows the saved rating again, so an abandoned edit cannot be mistaken for a pending one.
    var _aiRateEdit = false;
    var _AI_RATE_MAX = 2000;
    // v1.0.55.164: analysisId -> 'pending' | 'done'. Absent means NOT YET KNOWN, which is a
    // different thing from 'not rated' and must never be rendered as an empty form.
    var _aiRateFetch = {};

    // v1.0.55.165: LOCAL token and error helpers. .163/.164 called wTok()/wErrMsg(), which
    // are PRIVATE to the Wisdom IIFE in a later <script> element -- never globals, so the first
    // render threw "wEsc is not defined" and the overlay stayed blank. Escaping now uses
    // escapeHtml(), which is top-level in THIS script block; the other two are defined here.
    function aiRateTok() {
        var t = document.querySelector('input[name="__RequestVerificationToken"]');
        return t ? t.value : '';
    }
    function aiRateErr(status, text) {
        var t = String(text == null ? '' : text).trim();
        if (t.charAt(0) === '<' || t.toLowerCase().indexOf('<html') >= 0 || t.toLowerCase().indexOf('<!doctype') >= 0) {
            return 'server error (HTTP ' + status + ')';
        }
        try { var j = JSON.parse(t); if (j && j.error) { t = j.error; } } catch (ignore) { }
        return 'HTTP ' + status + ': ' + t.slice(0, 200);
    }

    // The id to rate, and the single test for whether rating is possible at all.
    function aiRateId() {
        if (!_aiCurrentAlertId) { return null; }
        var aid = _aiAnalysisIdByAlert[String(_aiCurrentAlertId)];
        return aid ? aid : null;
    }
    function aiRateBtnSync() {
        var b = document.getElementById('aiRateBtn');
        if (!b) { return; }
        // v1.0.55.167: site-keeping only. The check lives HERE rather than in
        // aaApplySiteKeepGate's id list, because that gate runs once at ready() while this
        // function runs on every alert switch and after every analysis and sets display=''
        // again -- it would undo the gate's hide a moment later, which is the same fault the
        // header note at .55.44 records for the debug buttons. Returning before aiRateLoad also
        // means a non-privileged session never issues the lookup request at all.
        if (window.AA_SITEKEEP !== true) { b.style.display = 'none'; return; }
        var aid = aiRateId();
        if (!aid) { b.style.display = 'none'; return; }
        b.style.display = '';
        b.innerHTML = _aiRatedByAnalysis[String(aid)] ? '&#9733; Rated' : '&#9733; Rate';
        aiRateLoad(aid);   // v1.0.55.164: so the button says "Rated" without the overlay being opened
    }
    // Reads an existing rating for this analysis. Called from the button sync and from the
    // overlay; it de-duplicates its own in-flight call, and on FAILURE it clears the marker
    // rather than recording 'done', so the next attempt retries instead of concluding that
    // nothing is rated.
    function aiRateLoad(aid) {
        var k = String(aid);
        if (_aiRateFetch[k]) { return; }
        _aiRateFetch[k] = 'pending';
        fetch('@Url.Action("GetAnalysisRating", "AlertAnalysis")' + '?analysisId=' + encodeURIComponent(aid), {
            credentials: 'same-origin'
        }).then(function (r) {
            return r.ok ? r.json() : r.text().then(function (t) { throw new Error(aiRateErr(r.status, t)); });
        }).then(function (j) {
            if (!j || j.ok !== true) { throw new Error((j && j.error) ? j.error : 'lookup failed'); }
            _aiRateFetch[k] = 'done';
            if (j.rated === true) {
                // v1.0.55.169: mine decides Edit vs "Add my rating". The server already returns it
                // (.164) by comparing the row's UserName with the caller -- the view never guesses.
                _aiRatedByAnalysis[k] = {
                    rating: j.rating, comment: j.comment || '', by: j.by || 'Operator', mine: (j.mine === true)
                };
            }
            aiRateBtnSync();
            if (_aiRateForId === k && document.getElementById('aiRateBox')) { aiRateRender(null, false); }
        }).catch(function (e) {
            delete _aiRateFetch[k];
            if (_aiRateForId === k && document.getElementById('aiRateBox')) {
                aiRateRender('Could not check for an existing rating -- ' + ((e && e.message) ? e.message : 'request failed') + '.', true);
            }
        });
    }
    function aiRateDrop() {
        var b = document.getElementById('aiRateBox');
        if (b && b.parentNode) { b.parentNode.removeChild(b); }
    }
    function aiRateCapTxt(v) {
        if (!v) { return 'Not rated yet.'; }
        return v + ' / 5 &middot; ' + _AI_RATE_WORD[v - 1];
    }
    // asset . station . cause -- the same three facts the alert card leads with.
    function aiRateSub() {
        var c = _currentAlertContext || {};
        var p = [];
        if (c.assetName) { p.push(c.assetName); }
        if (c.station) { p.push(c.station); }
        if (c.causeCode) { p.push(c.causeCode); }
        return p.join(' \u00B7 ');
    }
    function aiRateStarsHtml(sel, live) {
        var h = '<div class="rvr-stars' + (live ? '' : ' ro') + '">';
        for (var i = 1; i <= 5; i++) {
            var on = (i <= sel) ? ' on' : '';
            if (live) {
                h += '<span class="rvr-star' + on + '" data-v="' + i + '" title="' + _AI_RATE_WORD[i - 1] + '"'
                   + ' onclick="aiRateSet(' + i + ')" onmouseover="aiRateHover(' + i + ')" onmouseout="aiRateHover(0)">&#9733;</span>';
            } else {
                h += '<span class="rvr-star' + on + '">&#9733;</span>';
            }
        }
        return h + '</div>';
    }
    // Hover previews WITHOUT a re-render: rebuilding the card on every mouseover would
    // also rebuild the textarea and drop what the operator had typed into it.
    function aiRateHover(v) {
        var ss = document.querySelectorAll('#aiRateBox .rvr-star[data-v]');
        if (!ss || !ss.length) { return; }
        var show = v || _aiRateSel;
        for (var i = 0; i < ss.length; i++) {
            var n = parseInt(ss[i].getAttribute('data-v'), 10);
            if (n <= show) { ss[i].className = 'rvr-star on'; } else { ss[i].className = 'rvr-star'; }
        }
        var cap = document.getElementById('aiRateCap');
        if (cap) { cap.innerHTML = aiRateCapTxt(show); }
    }
    function aiRateSet(v) {
        _aiRateSel = v;
        aiRateHover(0);
        var go = document.getElementById('aiRateGo');
        if (go) { go.disabled = false; }
    }
    function aiRateKeep() {
        var t = document.getElementById('aiRateTxt');
        if (t) { _aiRateComment = String(t.value || ''); }
        var c = document.getElementById('aiRateCnt');
        if (c) { c.innerHTML = _aiRateComment.length + ' / ' + _AI_RATE_MAX; }
    }
    // v1.0.55.169: reopen an existing rating as a form. Editing MY row starts from what I saved;
    // "Add my rating" starts blank, because the row on screen is someone else's judgement and
    // pre-filling from it would put their words under my name.
    function aiRateEdit(mine) {
        var aid = aiRateId();
        var done = aid ? _aiRatedByAnalysis[String(aid)] : null;
        if (!done) { return; }
        _aiRateSel = mine ? (done.rating || 0) : 0;
        _aiRateComment = mine ? String(done.comment || '') : '';
        _aiRateEdit = true;
        aiRateRender(null, false);
    }
    function aiRateCancelEdit() {
        _aiRateEdit = false;
        _aiRateSel = 0;
        _aiRateComment = '';
        aiRateRender(null, false);
    }
    function fnAiRateOpen() {
        if (window.AA_SITEKEEP !== true) { return; }            // v1.0.55.167: not a hidden button away
        var aid = aiRateId();
        if (!aid) { return; }                                   // no row id -> nothing to rate
        if (document.getElementById('aiRateBox')) { aiRateDrop(); return; }   // toggle off
        if (_aiRateForId !== String(aid)) {                     // a different analysis: fresh form
            _aiRateForId = String(aid);
            _aiRateSel = 0;
            _aiRateComment = '';
        }
        _aiRateEdit = false;                                    // v1.0.55.169: always open on the saved state
        var box = document.createElement('div');
        box.id = 'aiRateBox';
        box.className = 'rvk-ov';
        box.onclick = function (e) { if (e.target === box) { aiRateKeep(); aiRateDrop(); } };
        // v1.0.55.166: attach INSIDE #aaAlertModal, not to <body>. Bootstrap's modal traps
        // focus -- its enforceFocus handler pulls focus back the moment it lands on an element
        // that is not a descendant of the open modal, so a textarea parked on <body> could be
        // clicked but never typed into. Tool trace uses the same rvk-ov on <body> and is
        // unaffected only because it has no fields. The overlay is position:fixed, so it still
        // covers the viewport from here, and its z-index puts it above the modal content.
        var rateHost = document.getElementById('aaAlertModal') || document.body;
        rateHost.appendChild(box);
        if (!window._aiRateEsc) {
            window._aiRateEsc = 1;
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && document.getElementById('aiRateBox')) { aiRateKeep(); aiRateDrop(); }
            });
        }
        aiRateLoad(aid);   // v1.0.55.164: no form until the lookup has answered
        aiRateRender(null, false);
    }
    function aiRateRender(msg, bad) {
        var box = document.getElementById('aiRateBox');
        if (!box) { return; }
        var aid = aiRateId();
        var k = String(aid);
        var done = aid ? _aiRatedByAnalysis[k] : null;
        // v1.0.55.164: three states. UNKNOWN is the one that matters -- the lookup has not
        // answered (or failed), so the form is withheld. An unreachable service is not evidence
        // that nobody has rated this, and offering a form on that assumption is how the existing
        // rating gets overwritten through Upsert.
        var known = (_aiRateFetch[k] === 'done');
        // v1.0.55.169: an existing rating is shown read-only UNTIL the operator asks to change
        // it. In edit mode the saved row is still on file -- nothing is written until Save.
        var editing = (!!done && _aiRateEdit);
        var readOnly = (!!done && !editing);
        var sel = readOnly ? done.rating : _aiRateSel;

        var h = '<div class="rvk-md rvr-md">'
              + '<div class="rvk-md-h"><span>Rate this analysis<span class="rvr-sub">' + escapeHtml(aiRateSub()) + '</span></span>'
              + '<button type="button" class="rvk-x" onclick="aiRateKeep();aiRateDrop();">Close</button></div>'
              + '<div class="rvk-md-b rvr-b">';

        if (!done && !known) {
            h += '<div class="rvr-msg' + (bad ? ' bad' : '') + '">'
               + (msg ? escapeHtml(msg) : 'Checking for an existing rating\u2026')
               + '</div></div>'
               + '<div class="rvr-foot">'
               + '<button type="button" class="rvk-x" onclick="aiRateDrop()">Close</button>'
               + (bad ? '<button type="button" class="rvr-go" onclick="aiRateLoad(' + aid + ')">Retry</button>' : '')
               + '</div></div>';
            box.innerHTML = h;
            return;
        }

        h += '<div class="rvr-sec">RATING</div>'
           + aiRateStarsHtml(sel, !readOnly)
           + '<div class="rvr-cap" id="aiRateCap">' + aiRateCapTxt(sel) + '</div>'
           + '<div class="rvr-sec gap">REMARK</div>';

        if (readOnly) {
            h += done.comment
               ? '<div class="rvr-rem">' + escapeHtml(done.comment) + '</div>'
               : '<div class="rvr-rem none">Rated without a remark.</div>';
            h += '<div class="rvr-note">Rated by ' + escapeHtml(done.by || 'Operator') + '. '
               + (done.mine
                    ? 'You can change your rating and remark at any time.'
                    : 'This is another operator\'s rating and cannot be edited here -- you can file your own.')
               + '</div>';
        } else {
            h += '<textarea id="aiRateTxt" class="rvr-txt" maxlength="' + _AI_RATE_MAX + '" oninput="aiRateKeep()" '
               + 'placeholder="Optional -- what was right or wrong about this analysis?">' + escapeHtml(_aiRateComment) + '</textarea>'
               + '<div class="rvr-cnt" id="aiRateCnt">' + _aiRateComment.length + ' / ' + _AI_RATE_MAX + '</div>';
            h += '<div class="rvr-note">'
               + (editing
                    ? 'Saving replaces your existing rating and remark. Cancel leaves them as they are.'
                    : 'You can come back and change this later.')
               + '</div>';
        }
        if (msg) { h += '<div class="rvr-msg' + (bad ? ' bad' : '') + '">' + escapeHtml(msg) + '</div>'; }
        h += '</div>';

        h += '<div class="rvr-foot">';
        if (readOnly) {
            h += '<button type="button" class="rvk-x" onclick="aiRateDrop()">Close</button>'
               + '<button type="button" class="rvr-go" onclick="aiRateEdit(' + (done.mine ? 'true' : 'false') + ')">'
               + (done.mine ? 'Edit rating' : 'Add my rating') + '</button>';
        } else {
            h += '<button type="button" class="rvk-x" onclick="'
               + (editing ? 'aiRateCancelEdit()' : 'aiRateKeep();aiRateDrop();') + '">Cancel</button>'
               + '<button type="button" class="rvr-go" id="aiRateGo" onclick="aiRateSubmit()"' + (sel && !_aiRateBusy ? '' : ' disabled') + '>'
               + (_aiRateBusy ? 'Saving&hellip;' : (editing ? 'Save changes' : 'Submit rating')) + '</button>';
        }
        h += '</div></div>';

        box.innerHTML = h;
    }
    function aiRateSubmit() {
        var aid = aiRateId();
        if (!aid || _aiRateBusy) { return; }
        if (!_aiRateSel) { aiRateRender('Pick a star rating first.', true); return; }
        aiRateKeep();
        var comment = _aiRateComment.trim();
        if (comment.length > _AI_RATE_MAX) {
            aiRateRender('Remark is ' + comment.length + ' characters -- the limit is ' + _AI_RATE_MAX + '.', true);
            return;
        }
        _aiRateBusy = true;
        aiRateRender(null, false);

        var body = 'analysisId=' + encodeURIComponent(aid)
                 + '&rating=' + encodeURIComponent(_aiRateSel)
                 + '&comment=' + encodeURIComponent(comment)
                 + '&__RequestVerificationToken=' + encodeURIComponent(aiRateTok());

        fetch('@Url.Action("RateAnalysis", "AlertAnalysis")', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
            body: body
        }).then(function (r) {
            return r.ok ? r.json() : r.text().then(function (t) { throw new Error(aiRateErr(r.status, t)); });
        }).then(function (j) {
            _aiRateBusy = false;
            if (!j || j.ok !== true) { throw new Error((j && j.error) ? j.error : 'the server did not confirm the save'); }
            // v1.0.55.169: whatever was on file, the row now on file is MINE -- the server
            // stamps the name it saved under, so Edit is offered next time round.
            _aiRatedByAnalysis[String(aid)] = {
                rating: _aiRateSel,
                comment: comment,
                by: (j.userName || window._aiUserName || 'Operator'),
                mine: true
            };
            _aiRateEdit = false;
            _aiRateFetch[String(aid)] = 'done';   // v1.0.55.164: just written, so it is known -- no re-lookup
            aiRateBtnSync();
            aiRateRender(null, false);
        }).catch(function (e) {
            // NOT SAVED, said plainly, with the stars still editable. The .101 failure mode was
            // a control that looked like it had recorded something it had not.
            // The edit stays OPEN with the typed text intact: _aiRateEdit is untouched, so a
            // failed save cannot quietly drop back to the old rating as though it had worked.
            _aiRateBusy = false;
            aiRateRender('NOT SAVED -- ' + ((e && e.message) ? e.message : 'request failed') + '. Nothing was changed; try again.', true);
        });
    }
    // ================= end rating =================

    function fnAiToolTrace() {
        var cid = window._aiConvId;
        var box = document.getElementById('aiToolTraceBox');
        if (box) { box.parentNode.removeChild(box); window._aiTraceAuto = false; return; }   // toggle off if already open
        window._aiTraceAuto = true;   // v1.0.55.17: once opened, re-open automatically for later runs
        if (!cid) {
            alert('Tool trace is available right after an analysis runs (no run id yet). Re-run the alert, then click Tool trace.');
            return;
        }
        // v1.0.55.29: modal over the popup, not a box wedged beside the footer.
        box = document.createElement('div');
        box.id = 'aiToolTraceBox';
        box.className = 'rvk-ov';
        var _idn = aiTraceIdent();
        box.setAttribute('data-ident', aiTraceIdentKey(_idn));
        box.setAttribute('data-run', cid);          // the run this trace belongs to
        box.innerHTML = '<div class="rvk-md"><div class="rvk-md-h"><span>Tool trace &mdash; loading&hellip;</span>'
                      + '<button type="button" class="rvk-x" onclick="aiTraceDrop()">Close</button></div></div>';
        box.onclick = function(e){ if(e.target === box){ aiTraceDrop(); } };   // backdrop closes
        document.body.appendChild(box);
        if(!window._rvkEsc){
            window._rvkEsc = 1;
            document.addEventListener('keydown', function(e){
                if(e.key === 'Escape' && document.getElementById('aiToolTraceBox')){ aiTraceDrop(); }
            });
        }

        var url = '@Url.Action("ToolTrace", "AiChat")' + '?convId=' + encodeURIComponent(cid);
        fetch(url, { credentials: 'same-origin' })
          .then(function(r){ return r.json(); })
          .then(function(d){
              if (!d || !d.ok) { aiTraceShell(box, aiTraceIdLine(_idn), 'Tool trace', '',
                    '<div style="padding:14px 16px;color:#dc2626;">Tool trace error: ' + escapeHtml(d && d.error ? d.error : 'unknown') + '</div>'); return; }
              if (!d.calls || !d.calls.length) {
                  // v1.0.55.14: one message used to cover three very different causes.
                  var why;
                  if (d.logging === false || d.reason === 'logging_disabled') {
                      why = '<b>Tool logging is switched off on this server.</b><br>No tool calls are being recorded, so there is nothing to show &mdash; this does not mean the run made no tool calls.<br><br>Add to Web.config appSettings and re-run the alert:<br><code style="display:inline-block;margin-top:4px;padding:3px 6px;background:#f1f5f9;border-radius:4px;">&lt;add key="AiToolLoggingEnabled" value="true" /&gt;</code>';
                  } else if (d.reason === 'no_log_file') {
                      why = '<b>No tool log file found.</b><br>Logging is on but no ai-tool-*.jsonl exists in App_Data\\AiToolLogs &mdash; check folder permissions, or this app instance has not written one yet.';
                  } else {
                      why = '<b>No tool calls recorded for this run id.</b><br><span style="font-family:ui-monospace,monospace;font-size:11px;">' + escapeHtml(cid) + '</span><br>Needs controller 1.0.158.2 or later: before that, evidence gathered in the PREFETCH stage was filed under the id "prefetch" instead of this run, so a run that prefetched everything showed nothing here. If you are already on 158.2+, the analysis may have run on a different app instance than this lookup.';
                  }
                  aiTraceShell(box, aiTraceIdLine(_idn), 'Tool trace', '',
                      '<div style="padding:16px;color:#475569;line-height:1.6;">' + why + '</div>'); return; }
              window._aiTraceData = d;
              for (var sq=0; sq<d.calls.length; sq++){ d.calls[sq]._seq = sq+1; }
              // v1.0.55.30: surface the evidence counter the run itself reports ("6/7 gathered")
              // and how many calls failed, so the header answers "did everything arrive?".
              var _gath = '';
              try{
                  for(var g=0; g<_aiTrail.length; g++){
                      var mm = String(_aiTrail[g].sub||'').match(/(\d+)\s*\/\s*(\d+)\s*gathered/i);
                      if(mm){ _gath = ' \u00b7 ' + mm[1] + '/' + mm[2] + ' evidence gathered'; break; }
                  }
              }catch(e){}
              var _errN = 0, _cutN = 0;
              for(var er=0; er<d.calls.length; er++){
                  var _r2 = String(d.calls[er].result||'');
                  // v1.0.160.6: match the per-row rule -- only a top-level tool error or a wholly
                  // non-JSON response is a failure. A nested optional "error" (e.g. REDA logs
                  // missing) inside valid data is NOT a failed call, so it is no longer counted.
                  var _e2 = (d.calls[er].error && String(d.calls[er].error).length>0)
                          || /NOT_JSON/i.test(_r2);
                  if(_e2){ _errN++; }
                  else if(/\[\.\.\.\s*[\d,]+\s*chars truncated/.test(_r2)){ _cutN++; }
              }
              var _errTxt = (_errN ? (' \u00b7 <span style="color:#b91c1c;font-weight:700;">' + _errN + ' failed</span>') : '')
                          + (_cutN ? (' \u00b7 <span style="color:#b45309;font-weight:700;">' + _cutN + ' truncated</span>') : '');
              var _title = 'Tool trace &mdash; ' + d.calls.length + ' call' + (d.calls.length===1?'':'s')
                    + (function(){ var pf=0; for(var q=0;q<d.calls.length;q++){ if(d.calls[q].stage==='prefetch'){ pf++; } }
                         return pf ? (' \u00b7 ' + pf + ' prefetch, ' + (d.calls.length-pf) + ' in-loop') : ''; })()
                    + _gath + _errTxt;
              var _actions = '<span style="cursor:pointer;color:#4338ca;font-weight:600;" onclick="aiTraceCopyAll(this)" title="Copy every stage as one JSON document">copy all JSON</span>';
              var h = '';
              for (var i=0;i<d.calls.length;i++){
                  var c = d.calls[i];
                  var friendly = aiToolFriendly(c.tool) || c.tool || 'tool';
                  var ms = (c.ms!=null) ? (Number(c.ms)/1000).toFixed(1)+'s' : '';
                  var rl = Number(c.resultLen)||0;
                  var sz = rl>=1024 ? (rl/1024).toFixed(1)+' KB' : rl+' B';
                  var isErr = c.error && String(c.error).length>0;
                  var isEmpty = rl===0;
                  // v1.0.55.35: per-row content-level detection (was only in the header counters;
                  // _trunc/_inErr were referenced below but never declared -> ReferenceError killed
                  // the whole trace render on the first row)
                  var _rs = String(c.result||'');
                  var _mTr = _rs.match(/\[\.\.\.\s*([\d,]+)\s*chars truncated/);
                  var _trunc = _mTr ? _mTr[1] : '';
                  var _inErr = '';
                  if(!isErr){
                      // v1.0.160.6: only a NON-JSON response counts as a failed call here. Do NOT
                      // scan for a nested "error":"..." string: analyse_alert embeds optional
                      // sub-results (e.g. "reda":{"error":"No REDA logs..."}) inside an otherwise
                      // complete, valid payload -- that is a missing OPTIONAL sub-source, not a tool
                      // failure, and flagging it turned a 95%-CONFIRMED run into "1 failed". The
                      // authoritative failure signal is the top-level c.error (from the tool log),
                      // already handled by isErr above. A response that isn't JSON at all is still a
                      // real failure and stays flagged.
                      if(/NOT_JSON/i.test(_rs)){ isErr = true; _inErr = 'response was not JSON'; }
                  }
                  var badge = isErr ? '<span style="color:#dc2626;">&#9888; error</span>'
                            : (isEmpty ? '<span style="color:#d97706;">empty</span>'
                            : (_trunc ? '<span style="color:#b45309;">&#9986; cut</span>'
                            : '<span style="color:#16a34a;">'+escapeHtml(sz)+'</span>'));
                  h += '<div class="rvk-row'+(isErr?' err':(_trunc?' warn':''))+'">'
                     + '<div class="rvk-hd" onclick="var b=this.nextSibling;b.style.display=(b.style.display===\'none\'?\'block\':\'none\');">'
                     +   '<span class="rvk-seq">'+(i+1)+'</span>'
                     +   '<span class="rvk-nm">'+escapeHtml(friendly)+'</span>'
                     +   (c.stage==='prefetch' ? '<span class="rvk-pf">prefetch</span>' : '<span></span>')
                     +   '<span class="rvk-tool">'+escapeHtml(String(c.tool||''))+'</span>'
                     +   '<span class="rvk-ms">'+escapeHtml(ms)+'</span>'
                     +   '<span class="rvk-sz">'+badge+'</span>'
                     // v1.0.55.30: a failure is readable WITHOUT expanding the row
                     +   (isErr ? ('<span class="rvk-errline">&#9888; '+escapeHtml(String(c.error||_inErr))+'</span>') : '')
                     +   ((!isErr && _trunc) ? ('<span class="rvk-warnline">&#9986; server truncated this payload &mdash; '+escapeHtml(_trunc)+' characters dropped, so the analysis saw only part of it</span>') : '')
                     + '</div>'
                     + '<div class="rvk-body">'
                     +   '<div class="rvk-lbl"><span><b>Called with</b></span>'
                     +     '<span style="cursor:pointer;color:#4338ca;font-weight:600;" onclick="event.stopPropagation();aiTraceCopyOne(' + i + ',this)" title="Copy this stage as JSON">copy JSON</span>'
                     +   '</div>'
                     +   '<pre class="rvk-pre" style="max-height:160px;">'+escapeHtml(c.args||'(none)')+'</pre>'
                     +   '<div class="rvk-lbl"><span><b>Returned</b> ('+escapeHtml(sz)+')</span></div>'
                     +   '<pre class="rvk-pre">'+escapeHtml((isErr && c.error)?('ERROR: '+c.error):(c.result||'(empty)'))+'</pre>'
                     + '</div>'
                     + '</div>';
              }
              aiTraceShell(box, aiTraceIdLine(_idn), _title, _actions, h);
          })
          .catch(function(e){ box.innerHTML = '<div style="padding:10px 12px;color:#dc2626;">Tool trace fetch failed: ' + escapeHtml(String(e)) + '</div>'; });
    }

    function aiToolFriendly(t) {
        if (!t) { return ''; }
        var m = {
            'search_tags':'Matching sensor names', 'history_get':'Pulling value history',
            'live_get':'Reading live values', 'get_asset_tags':'Listing asset tags',
            'get_attribute_range_history':'Pulling range history', 'analyse_alert':'Checking alert record',
            'predict_pm_operation':'Point machine operation analysis', 'predict_pm_cluster':'Point machine waveform clustering',
            'predict_track_health':'Track health analysis', 'get_hist_realtime':'Reading realtime history'
        };
        return m[t] || '';
    }

    function fnAiDownloadDiag() {
        var c = _currentAlertContext || {};
        var L = [];
        L.push('ENERGY7 AI DIAGNOSTIC - analysis log');
        L.push('generated  : ' + new Date().toString());
        L.push('');
        L.push('ALERT');
        L.push('  alertId   : ' + (c.alertId || '-'));
        L.push('  cause     : ' + (c.causeCode || '-'));
        L.push('  asset     : ' + (c.assetName || '-') + '   station: ' + (c.station || '-'));
        L.push('  siteId    : ' + (c.siteId || '(not supplied)') + '   assetId: ' + (c.assetId || '(not supplied)'));
        L.push('  incidence : ' + (c.time || '-'));
        L.push('  reset     : ' + (c.resetTime || '(none)'));
        L.push('');
        L.push('STEP TRAIL   (per-step / cumulative)');
        var total = 0;
        for (var i = 0; i < _aiTrail.length; i++) {
            var st = _aiTrail[i];
            var cum = _aiT0 ? ((st.t - _aiT0 + (st.ms || 0)) / 1000) : 0;
            if (cum > total) { total = cum; }
            L.push('  ' + (st.state === 'done' ? 'ok  ' : (st.state === 'warn' ? 'WARN' : 'run '))
                 + ' ' + aiPadCol(st.label, 42)
                 + aiPadCol(((st.ms || 0) / 1000).toFixed(1) + 's', 8)
                 + aiPadCol('(' + cum.toFixed(1) + 's)', 10)
                 + (st.sub || ''));
        }
        L.push('');
        L.push('  TOTAL     : ' + total.toFixed(1) + 's over ' + _aiTrail.length + ' steps');
        var turns = 0;
        for (var j = 0; j < _aiTrail.length; j++) { if (/turn \d+/.test(_aiTrail[j].label)) { turns++; } }
        L.push('  model turns: ' + turns);
        L.push('');
        // v1.0.55.43: 7W audit -- what the run actually did. Straight from meta.audit; if an older
        // controller does not supply it, the whole section is skipped rather than printing blanks.
        var A = (window._aiLastMeta && window._aiLastMeta.audit) ? window._aiLastMeta.audit : null;
        if (!A) {
            // v1.0.55.46: say WHY rather than omitting. The audit is an SSE event emitted during
            // the run, so a cached verdict or a page reload legitimately has none -- and a
            // controller older than 1.0.160.57 never sends one at all.
            L.push('AUDIT (7W)');
            L.push('  not captured for this view of the alert.');
            L.push('  The audit is sent DURING an analysis. This verdict was shown from cache or');
            L.push('  after a page reload, so no audit event was received. Press Re-run, let it');
            L.push('  finish, then download this log again.');
            L.push('  If it is still absent after a fresh run, the deployed controller is older');
            L.push('  than 1.0.160.57 -- check /FRS25/AiChat/Status for the running version.');
            L.push('');
        }
        if (A) {
            function _kv(k, v) { L.push('  ' + (k + '            ').substring(0, 12) + ': ' + (v === undefined || v === null || v === '' ? '-' : v)); }
            L.push('AUDIT (7W)');
            if (A.who)   { _kv('who',   (A.who.user || '-') + '  role=' + (A.who.role || '-') + '  ip=' + (A.who.ip || '-')); }
            if (A.why)   { _kv('why',   (A.why.requestType || '-') + '  alert=' + (A.why.alertId || '-') + ' ' + (A.why.alertType || '') + '  cause=' + (A.why.causeCode || '-') + '  asset=' + (A.why.asset || '-')); }
            if (A.which) { _kv('which', 'engine=' + (A.which.engine || '-') + '  provider=' + (A.which.provider || '-') + '  model=' + (A.which.model || '-') + '  thinking=' + (A.which.thinking ? 'ON' : 'off') + '  roleGated=' + (A.which.roleGated ? 'yes' : 'no')); }
            if (A.where) { _kv('where', 'site=' + (A.where.siteId || '-') + ' ' + (A.where.station || '') + '  node=' + (A.where.node || '-') + '  endpoint=' + (A.where.endpoint || '-')); }
            if (A.when)  {
                // v1.0.55.71 SL9: prefer the WALL-CLOCK fields (1.0.160.110). toolMs only ever counted
                // the in-loop path, so a prefetch-only run -- the normal case -- printed tools=0ms
                // while the calls took seconds. Fall back to toolMs only for an older controller.
                var _tSum  = (A.when.toolCallMsSum != null) ? A.when.toolCallMsSum : null;
                var _tPre  = (A.when.prefetchWallMs != null) ? A.when.prefetchWallMs : null;
                var _tLoop = (A.when.inLoopWallMs != null) ? A.when.inLoopWallMs : null;
                var _tools = (_tPre != null || _tLoop != null)
                             ? ('prefetch=' + (_tPre || 0) + 'ms  inLoop=' + (_tLoop || 0) + 'ms'
                                + (_tSum != null ? '  toolCallSum=' + _tSum + 'ms' : ''))
                             : ('tools=' + (A.when.toolMs || 0) + 'ms');
                _kv('when',  (A.when.startUtc || '-') + ' -> ' + (A.when.endUtc || '-')
                    + '   total=' + (A.when.totalMs || 0) + 'ms  model=' + (A.when.modelMs || 0) + 'ms  ' + _tools);
            }
            if (A.cost)  { _kv('cost',  'tokIn=' + (A.cost.tokIn || 0) + '  tokOut=' + (A.cost.tokOut || 0) + '  cacheRead=' + (A.cost.cacheRead || 0) + '  toolCalls=' + (A.cost.toolCalls || 0) + '  turns=' + (A.cost.iterations || 0)); }
            if (A.wisdom){ _kv('wisdom','doctrinal=' + (A.wisdom.doctrinal || 0) + '  field=' + (A.wisdom.field || 0) + '  circuit=' + (A.wisdom.circuit || 0) + '  learned=' + (A.wisdom.learned || 0) + '  checklist=' + (A.wisdom.checklist || 0) + '  (' + (A.wisdom.chars || 0) + ' chars)');
                          if (A.wisdom.driverSet) { _kv('driverSet', A.wisdom.driverSet); } }
            L.push('');
        }
        L.push('VERDICT');
        L.push(_aiLastVerdict ? JSON.stringify(_aiLastVerdict, null, 2) : '(no verdict produced)');
        L.push('');
        L.push('CONTEXT SENT (payload the analysis was given)');
        L.push(JSON.stringify(c, null, 2));

        var name = 'ai-diagnostic-' + (c.alertId || 'alert') + '-'
                 + new Date().toISOString().replace(/[:.]/g, '').slice(0, 15) + '.txt';
        aiSaveText(name, L.join('\n'));
    }

    function aiPadCol(t, n) { t = String(t); while (t.length < n) { t += ' '; } return t; }

    function aiSaveText(name, text) {
        try {
            var blob = new Blob([text], { type: 'text/plain;charset=utf-8' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url; a.download = name;
            document.body.appendChild(a); a.click();
            setTimeout(function () { document.body.removeChild(a); URL.revokeObjectURL(url); }, 100);
        } catch (e) {
            // some embedded browsers block Blob downloads: fall back to a new window
            var w = window.open('', '_blank');
            if (w) { w.document.write('<pre>' + escapeHtml(text) + '</pre>'); }
        }
    }

    // v1.0.55.67 (SL 7/12/17): envelope extras. Reset per run so a previous alert's condition or
    // snapshot can never render against a new verdict.
    var _aiContextPatch = null, _aiAssetCondition = null, _aiSnapshot = null;

    // SL 7: merge ONLY the grounding keys the server sends. Never replace the whole context -- the
    // patch is deliberately minimal and the local context may hold view-only state.
    function aiApplyContextPatch() {
        try {
            if (!_aiContextPatch || !_currentAlertContext) { return; }
            if (_aiContextPatch.station && !_currentAlertContext.station) { _currentAlertContext.station = _aiContextPatch.station; }
            if (_aiContextPatch.assetType && !_currentAlertContext.assetType) { _currentAlertContext.assetType = _aiContextPatch.assetType; }
            // v1.0.55.90: resetTime is AUTHORITATIVE from the server -- it comes from the FRS alert
            // row. Overwrite rather than fill-only-when-empty, because a stale or missing client
            // value is exactly what printed "Still active" on a cleared alert.
            // aiApplyContextPatch() runs BEFORE renderAiResolution in the same pass, so merging the
            // value is enough -- no DOM surgery. (My first version re-rendered an element id that
            // does not exist.)
            if (_aiContextPatch.resetTime) { _currentAlertContext.resetTime = _aiContextPatch.resetTime; }
        } catch (e) { }
    }

    // SL 12: its own band. A Critical standing condition must never read as part of the verdict --
    // on 543194 "Critical Risk / active leakage" sat as the last line of caveats under a headline
    // that said "no action".
    // criticalOnly=true renders ONLY an active critical condition (the pre-verdict slot);
    // criticalOnly=false renders whatever there is (the story chapter).
    function renderAssetCondition(criticalOnly) {
        var a = _aiAssetCondition;
        if (!a) { return ''; }
        // v1.0.55.77: colour = HEALTH, not merely "a condition exists". A resolved historical leak is
        // GOOD news and must not be styled like a live fault.
        var st = String(a.state || '').toLowerCase();
        if (criticalOnly && st !== 'issue') { return ''; }
        var cls = (st === 'issue') ? 'bad' : (st === 'watch' ? 'warn' : 'ok');
        var mark = (st === 'issue') ? '&#9888;' : (st === 'watch' ? '&#9679;' : '&#10003;');
        return '<div class="ac-band ' + cls + '">'
             + '<div class="ac-head"><span class="ac-mark">' + mark + '</span>'
             + '<b>Asset health</b>'
             + '<span class="ac-state">' + escapeHtml(a.title || '') + '</span>'
             + (a.condition ? '<span class="ac-cond">' + escapeHtml(a.condition) + '</span>' : '')
             + '<span class="ac-sp"></span>'
             + '<span class="ac-src">' + escapeHtml(a.source || '') + '</span></div>'
             + (a.summary ? '<div class="ac-sum">' + escapeHtml(a.summary) + '</div>' : '')
             + (a.detail ? '<div class="ac-det"><span class="ac-det-lbl">Technical</span>'
                         + escapeHtml(a.detail) + '</div>' : '')
             + (a.action ? '<div class="ac-act">' + escapeHtml(a.action) + '</div>' : '')
             + '</div>';
    }

    // SL 17: say WHEN the snapshot was taken. "current" values can be many hours after the alert.
    // v1.0.55.89: the live-values grid, rendered from whatever snapshot we currently hold.
    // v1.0.55.152: render the point-machine maintenance block from the v4 result
    // (window._aiPm = { a:{states}, b:{states}, ai_summary, window_days }). Minimum-token: uses
    // states + ai_summary only -- NO ops[] arrays. The 15-day trend chart is a separate lazy fetch.
    // v1.0.55.153: resolve the v4 endpoint from the alert context (or an injected override), then
    // fetch the plain analysis (states + ai_summary; no arrays) and render the maintenance block.
    /* ============ v1.0.55.156: PM ANALYSIS -- MODEL 4 VISUALS ============
       Machine A / Machine B cards, Timeline, Measurement trend and Class Timeline,
       ported from the Point Machine Operation page's Model 4 block.

       WHERE IT LIVES: the PM Analysis story card itself -- aiPmSkeleton() lays the
       containers down with the rest of the deck and aiPm4Boot() fills them. That card
       sits in the auto-advancing .rvs-track carousel, whose height is measured once at
       paint, so aiPm4Render stops the auto-advance and aiPm4Resize re-takes the height
       after the plots finish laying out.

       WHERE THE DATA COMES FROM: /AiChat/PmOpsV4, same origin. The SSE 'pm' event
       strips ops[] on purpose (controller .176) and the cache-serve path emits no
       'pm' event at all, so re-opening an alert leaves window._aiPm null -- these
       visuals therefore fetch their own copy through the server, which also keeps
       the browser from calling the v4 host directly (mixed content on https).

       WHAT IS DELIBERATELY NOT PORTED: waveform arrays are not fetched, so the class
       tiles carry class + op count instead of a mini current plot, and clicking a
       point shows that stroke's numbers instead of its current/voltage graph. Model
       4's site/asset browser, watchlist and technician feedback belong to that page,
       not to an alert popup. ES5 syntax throughout to match the rest of this file. */
    var PM4_OPS_URL = '@Url.Action("PmOpsV4", "AiChat")';
    var PM4_WINDOW_DAYS = 30;   // same window Model 4 analyses
    var PM4 = {
        data: null, loading: false, loaded: false, feature: 'i_run',
        timelineOps: { a: [], b: [] }, traceIdx: { a: null, b: null },
        highlight: null, plots: [], bands: {}
    };

    var PM4_GRADE_COLORS = { NORMAL: '#16a34a', WATCH: '#ca8a04', ALERT: '#ea580c', FAULT: '#dc2626', LEARNING: '#94a3b8' };
    var PM4_STATE_COLORS = { URGENT: '#dc2626', 'MAINTAIN-SOON': '#ea580c', WATCH: '#ca8a04', NORMAL: '#16a34a', LEARNING: '#94a3b8' };
    var PM4_CONDITION_COLORS = {
        'END-FRICTION': '#2563eb', 'CREEPING': '#7c3aed', 'OBSTRUCTION': '#dc2626',
        'SLAGGING': '#0d9488', 'SIGNATURE-CHANGE': '#c026d3', 'UNUSUAL-SHAPE': '#4338ca'
    };
    var PM4_BAND_COLORS = { WATCH: '#ca8a04', ALERT: '#ea580c', FAULT: '#dc2626' };
    var PM4_FILTER_LABELS = {
        no_data: 'Too few samples', too_short: 'Stroke too short',
        no_load: 'No load (current too low)', sensor_garbage: 'Sensor garbage (current out of range)'
    };
    var PM4_FEATURE_LABELS = {
        throw_time: 'stroke took longer', i_inrush: 'startup current spike', i_run: 'higher running current',
        i_trough: 'higher lowest-current', i_late_peak: 'bigger late current peak',
        end_rise: 'current rises at the end', end_rise_amps: 'size of the end-rise',
        late_peak_pos: 'late peak in an unusual place', rise_span: 'end-rise lasts unusually long',
        pegged: 'current stuck near max', i_tail: 'current at cut-off', work: 'more energy used per stroke',
        ripple: 'current less steady', shape_dist: 'overall shape has drifted', novelty_z: 'AI flagged an unusual shape'
    };
    var PM4_TREND_LABELS = {
        i_run: 'running current', i_trough: 'lowest current',
        end_rise: 'end-of-stroke rise', work: 'energy per stroke'
    };
    var PM4_TREND_FEATS = ['i_run', 'i_trough', 'end_rise', 'end_rise_amps', 'work', 'pegged', 'ripple',
        'shape_dist', 'throw_time', 'i_inrush', 'i_late_peak', 'late_peak_pos', 'rise_span'];

    function pm4HasPlotly() { return (typeof Plotly !== 'undefined' && Plotly && Plotly.newPlot); }

    // v1.0.55.161: every plot gets an EXPLICIT pixel width measured from its own container.
    // Left to size itself, a plot drawn in a card that is momentarily unmeasured falls back to
    // Plotly's default width and overflows the card to the right -- which, in a horizontal
    // carousel, lands on top of the next slide. PM4.plots keeps the drawn elements so a window
    // resize can re-fit them.
    function pm4Width(el) {
        var w = el && el.clientWidth ? el.clientWidth : 0;
        if (!w) {
            var body = document.getElementById('aiPmBody');
            w = body && body.clientWidth ? body.clientWidth : 0;
        }
        if (!w) {
            var card = document.querySelector('.rvs-card.rvs-pm');
            w = card && card.clientWidth ? (card.clientWidth - 36) : 0;
        }
        if (!w) { w = 560; }
        return Math.max(220, Math.floor(w) - 2);
    }

    function pm4NewPlot(el, data, layout, config) {
        if (!el) { return; }
        layout = layout || {};
        layout.autosize = false;
        layout.width = pm4Width(el);
        Plotly.newPlot(el, data, layout, config || { displaylogo: false, displayModeBar: false });
        if (PM4.plots.indexOf(el) < 0) { PM4.plots.push(el); }
    }

    function pm4RefitPlots() {
        if (!pm4HasPlotly()) { return; }
        PM4.plots.forEach(function (el) {
            if (!el || !el.isConnected || !el.data) { return; }
            try { Plotly.relayout(el, { width: pm4Width(el) }); } catch (e) { }
        });
    }

    if (!window._pm4Resize) {
        window._pm4Resize = 1;
        window.addEventListener('resize', function () {
            clearTimeout(window._pm4ResizeT);
            window._pm4ResizeT = setTimeout(pm4RefitPlots, 180);
        });
    }

    // Plotly is expected at ~/assets/js/plotly-2.35.2.min.js (the offline rule this page already
    // follows for Chart.js). If that file is not deployed the <script> tag above 404s silently and
    // every chart falls back to a text line -- which is what the field saw. So load it on demand:
    // local path first, CDN second, and draw as soon as either lands. Nothing else on the page is
    // affected either way, and a server with the file present never reaches this code.
    var PM4_PLOTLY_LOCAL = '@Url.Content("~/assets/js/plotly-2.35.2.min.js")';
    var PM4_PLOTLY_CDN = 'https://cdn.plot.ly/plotly-2.35.2.min.js';
    var _pm4PlotlyBusy = false, _pm4PlotlyDone = false, _pm4PlotlyWaiting = [];

    function pm4AddScript(src, onOk, onFail) {
        var s = document.createElement('script');
        s.src = src;
        s.async = true;
        s.onload = onOk;
        s.onerror = onFail;
        document.head.appendChild(s);
    }

    function pm4EnsurePlotly(cb) {
        if (pm4HasPlotly()) { cb(true); return; }
        if (_pm4PlotlyDone) { cb(false); return; }
        _pm4PlotlyWaiting.push(cb);
        if (_pm4PlotlyBusy) { return; }
        _pm4PlotlyBusy = true;
        var settle = function () {
            var ok = pm4HasPlotly();
            _pm4PlotlyBusy = false;
            _pm4PlotlyDone = !ok;   // only give up permanently on failure
            var waiting = _pm4PlotlyWaiting;
            _pm4PlotlyWaiting = [];
            waiting.forEach(function (f) { f(ok); });
        };
        pm4AddScript(PM4_PLOTLY_LOCAL, settle, function () {
            pm4AddScript(PM4_PLOTLY_CDN, settle, settle);
        });
    }

    /* v1.0.55.158: PM ANALYSIS chapter -- Model 4 layout, bound in place.
       The legacy renderer (overview strip, per-direction text cards, CSS dot-strip
       "15-DAY TREND") is gone: it depended on a browser-side call to the v4 host that
       could not work from an https page, and its trend block needed a second endpoint
       (_aiPmTrendUrl) that was never wired, so it only ever printed "Trend endpoint not
       configured". This chapter now renders the same five sections as the Point Machine
       Operation page's Model 4: AI summary, Machine A/B cards, Timeline, Measurement
       trend, Class Timeline -- all from one /AiChat/PmOpsV4 fetch. */
    // The response carries window_start / window_end / generated_at / _from_cache -- there is no
    // window_days field on it, so the window is read off the two timestamps.
    function aiPm4Meta(d) {
        var el = document.getElementById('aiPm4Meta');
        if (!el) { return; }
        if (!d) { el.innerHTML = ''; return; }
        var side = d.a || d.b || {};
        var bits = [];
        if (side.window_start && side.window_end) {
            var days = Math.round((new Date(side.window_end) - new Date(side.window_start)) / 86400000);
            bits.push(days + '-day window to ' + new Date(side.window_end).toLocaleDateString());
        }
        if (d.generated_at) {
            bits.push((d._from_cache ? 'cached result' : 'live result') + ' &middot; '
                + new Date(d.generated_at).toLocaleString());
        }
        if (side.wave_type) { bits.push(escapeHtml(String(side.wave_type))); }
        el.innerHTML = bits.join(' &middot; ');
    }

    function aiPmSkeleton() {
        return '<div id="aiPm4Meta" class="pm4-note" style="margin:0 0 10px;"></div>'
             + '<div id="aiPm4Summary" class="pm4-card" style="display:none;">'
             + '<div class="pm4-card-title"><span>AI summary</span></div>'
             + '<div id="aiPm4SummaryText" style="font-size:13px;line-height:1.6;"></div></div>'
             + '<div id="aiPm4Cards"><div class="pm4-empty">Loading per-stroke analysis&hellip;</div></div>'
             + '<div class="pm4-card">'
             + '<div class="pm4-card-title"><span>Timeline</span><span>Click a point for that stroke\'s numbers &middot; click a grade box or condition chip above to highlight it here</span></div>'
             + '<div id="aiPm4Timeline" class="pm4-plot"></div>'
             + '<div id="aiPm4Sel" class="pm4-sel">Click a point above for that stroke\'s numbers.</div></div>'
             + '<div class="pm4-card">'
             + '<div class="pm4-card-title"><span>Measurement trend</span><span>Pick a measurement &middot; rising = degrading &middot; dotted line = this machine\'s own normal</span></div>'
             + '<div id="aiPm4TrendBox"></div></div>'
             + '<div class="pm4-card">'
             + '<div class="pm4-card-title"><span>Class Timeline</span><span>One tile per run of same-class strokes &middot; every stroke in the run drawn over the others &middot; click a tile for its numbers</span></div>'
             + '<div class="pm4-side-label">Machine A</div>'
             + '<div id="aiPm4ClassA"></div>'
             + '<div class="pm4-side-label" style="margin-top:14px;">Machine B</div>'
             + '<div id="aiPm4ClassB"></div>'
             + '<div id="aiPm4ClsSel" class="pm4-sel">Click a tile above for its numbers.</div></div>';
    }

    // Called from the chapter builder on the next tick, i.e. once the deck's innerHTML is
    // in the DOM and the containers above exist. window._aiPm (the SSE copy) carries states
    // and ai_summary but never ops[] -- the controller strips them -- so the visuals always
    // need their own fetch, which is why there is no "use the injected copy" shortcut here.
    function aiPm4Boot() {
        if (!document.getElementById('aiPm4Cards')) { return; }
        PM4.loaded = false;
        aiPm4Load(false);
    }

    // ---------- fetch ----------
    function aiPm4Load(force) {
        var c = (typeof _currentAlertContext !== 'undefined' && _currentAlertContext) ? _currentAlertContext : {};
        var host = document.getElementById('aiPm4Cards');
        if (!c.assetId) {
            if (host) { host.innerHTML = '<div class="pm4-err">This alert carries no asset id, so the point-machine analysis cannot be fetched.</div>'; }
            return;
        }
        if (PM4.loading) { return; }
        PM4.loading = true;
        if (host) { host.innerHTML = '<div class="pm4-empty">Loading per-stroke analysis&hellip;</div>'; }
        aiPm4ClearPlots();
        // Same parameter set the Point Machine Operation page sends to api/pm4/analyze.
        // ForceLive re-analyzes instead of serving the cached result -- that is what Reload is for.
        var url = PM4_OPS_URL + '?siteId=' + encodeURIComponent(c.siteId || '')
                + '&assetId=' + encodeURIComponent(c.assetId || '')
                + '&windowDays=' + PM4_WINDOW_DAYS
                + '&assetName=' + encodeURIComponent(c.assetName || '')
                + '&siteName=' + encodeURIComponent(c.station || '')
                + (force ? '&forceLive=true' : '');
        fetch(url, { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (d) {
            PM4.loading = false;
            if (!d || d.ok === false) {
                if (host) { host.innerHTML = '<div class="pm4-err">Analysis unavailable (' + escapeHtml(String((d && d.error) || 'no response')) + ').</div>'; }
                return;
            }
            PM4.loaded = true;
            PM4.data = d;
            if (!window._aiPm) { window._aiPm = d; }
            aiPm4Meta(d);
            aiPm4Render(d);
        }).catch(function (e) {
            PM4.loading = false;
            if (host) { host.innerHTML = '<div class="pm4-err">Analysis unavailable (' + escapeHtml(String(e && e.message ? e.message : e)) + ').</div>'; }
        });
    }
    function aiPm4Reload(ev) {
        if (ev) { ev.preventDefault(); ev.stopPropagation(); }
        PM4.loaded = false;
        aiPm4Load(true);
    }
    function aiPm4ClearPlots() {
        PM4.plots = [];
        ['aiPm4Timeline', 'aiPm4TrendBox', 'aiPm4ClassA', 'aiPm4ClassB', 'aiPm4Sel', 'aiPm4ClsSel'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) { el.innerHTML = ''; }
        });
    }

    // ---------- render ----------
    function aiPm4Render(d) {
        var a = d.a || {}, b = d.b || {};
        a.ops = a.ops || []; b.ops = b.ops || [];
        PM4.highlight = null;

        // Section A parity with Model 4: verdict, findings, recommendation from ai_summary.
        var sum = d.ai_summary;
        var sumBox = document.getElementById('aiPm4Summary');
        var sumText = document.getElementById('aiPm4SummaryText');
        if (sumBox && sumText && sum) {
            if (typeof sum === 'string') {
                sumText.innerHTML = escapeHtml(sum);
            } else {
                var pts = (sum.points || []).map(function (p) {
                    return '<li style="margin-bottom:3px;">' + escapeHtml(String(p)) + '</li>';
                }).join('');
                sumText.innerHTML = '<div style="font-weight:800;font-size:13.5px;margin-bottom:5px;">'
                    + escapeHtml(String(sum.verdict || '')) + '</div>'
                    + (pts ? ('<ul style="margin:0 0 5px 18px;padding:0;">' + pts + '</ul>') : '')
                    + (sum.recommendation ? ('<div style="margin-top:4px;"><b>Recommendation:</b> '
                        + escapeHtml(String(sum.recommendation)) + '</div>') : '');
            }
            sumBox.style.display = 'block';
        } else if (sumBox) {
            sumBox.style.display = 'none';
        }

        // The deck auto-advances every 2s. Charts the reader is about to click on must not
        // slide away, so once they are on screen the deck becomes manual -- the same state
        // rvsJump(i, 1) sets when the operator drives it themselves.
        try {
            _rvsManual = true;
            rvsAutoStop(true);
        } catch (eAuto) { }

        var cards = document.getElementById('aiPm4Cards');
        if (cards) {
            cards.innerHTML = '<div class="pm4-cards">'
                + '<div class="pm4-col">' + pm4SideCard('Machine A', a, 'a') + '</div>'
                + '<div class="pm4-col">' + pm4SideCard('Machine B', b, 'b') + '</div>'
                + '</div>';
        }

        pm4Draw(a, b);
    }

    var PM4_CHART_HOSTS = ['aiPm4Timeline', 'aiPm4TrendBox', 'aiPm4ClassA', 'aiPm4ClassB'];

    function pm4ChartsSay(html) {
        PM4_CHART_HOSTS.forEach(function (id) {
            var el = document.getElementById(id);
            if (el) { el.innerHTML = '<div class="pm4-empty">' + html + '</div>'; }
        });
        aiPm4Resize();
    }

    function pm4Draw(a, b) {
        if (pm4HasPlotly()) {
            pm4RenderTimeline(a, b);
            pm4RenderTrendLines(a, b);
            pm4RenderClassStrips('a', a.ops, 'aiPm4ClassA');
            pm4RenderClassStrips('b', b.ops, 'aiPm4ClassB');
            aiPm4Resize();
            return;
        }
        pm4ChartsSay('Loading the chart library&hellip;');
        pm4EnsurePlotly(function (ok) {
            if (!ok) {
                pm4ChartsSay('Charts need Plotly, which did not load from <b>' + escapeHtml(PM4_PLOTLY_LOCAL)
                    + '</b> or <b>' + escapeHtml(PM4_PLOTLY_CDN) + '</b>. Drop plotly-2.35.2.min.js into '
                    + '~/assets/js/ on this server. The Machine A / Machine B figures above are unaffected.');
                return;
            }
            pm4RenderTimeline(a, b);
            pm4RenderTrendLines(a, b);
            pm4RenderClassStrips('a', a.ops, 'aiPm4ClassA');
            pm4RenderClassStrips('b', b.ops, 'aiPm4ClassB');
            aiPm4Resize();
        });
    }

    // The deck's height is the ACTIVE card's offsetHeight, measured once at paint (rvsSize).
    // These sections arrive later and are much taller, so the height has to be re-taken after
    // the plots land -- twice, because Plotly finishes its own layout a tick after newPlot.
    function aiPm4Resize() {
        var again = function () {
            try {
                // Width first: a plot that measured itself before the card was laid out would
                // otherwise keep an oversized width and push out of the card.
                pm4RefitPlots();
                if (typeof rvsSize === 'function') { rvsSize(); }
            } catch (e) { }
        };
        again();
        setTimeout(again, 120);
        setTimeout(again, 400);
    }

    function pm4Summary(ops) {
        var counts = { NORMAL: 0, WATCH: 0, ALERT: 0, FAULT: 0, INVALID: 0 };
        var conditions = {}, filtered = {};
        (ops || []).forEach(function (o) {
            var c = o.confirmed || (o.grade === 'INVALID' ? 'INVALID' : null);
            if (c && counts[c] !== undefined) { counts[c]++; }
            if (o.grade === 'INVALID') {
                var reason = o.reason || 'unknown';
                filtered[reason] = (filtered[reason] || 0) + 1;
            }
            if (o.condition && o.condition !== '-') {
                String(o.condition).split('+').forEach(function (cond) { conditions[cond] = (conditions[cond] || 0) + 1; });
            }
        });
        return { counts: counts, conditions: conditions, filtered: filtered, total: (ops || []).length };
    }

    function pm4SideCard(label, side, sideKey) {
        var wave = side.wave_type || '';
        if (!wave) {
            return '<div class="pm4-card"><div class="pm4-card-title"><span>' + escapeHtml(label) + '</span></div>'
                 + '<div class="pm4-empty">Wave type unresolved for this side -- cannot analyze.</div></div>';
        }
        if (!side.ops || !side.ops.length) {
            return '<div class="pm4-card"><div class="pm4-card-title"><span>' + escapeHtml(label) + ' &middot; ' + escapeHtml(wave) + '</span></div>'
                 + '<div class="pm4-empty">No operations in this window.</div></div>';
        }
        var s = pm4Summary(side.ops);

        var stateLine = '';
        if (side.states && Object.keys(side.states).length) {
            stateLine = '<div style="margin-bottom:9px;"><span class="pm4-lbl">State</span>';
            Object.keys(side.states).forEach(function (dir) {
                var st = side.states[dir] || {};
                var col = PM4_STATE_COLORS[st.state] || '#94a3b8';
                // The separator is MARKUP, not text: escaping the assembled string turned
                // "&middot;" into visible characters on the chip.
                var risers = '';
                if (st.rising && st.rising.length && st.trends) {
                    risers = ' &middot; ' + st.rising.map(function (f) {
                        var v = st.trends[f];
                        return escapeHtml((PM4_TREND_LABELS[f] || f) + ' ' + (v > 0 ? '+' : '') + v + '%/100 ops');
                    }).join(', ');
                }
                stateLine += '<span class="pm4-state" style="background:' + col + '1a;color:' + col + ';border-color:' + col + '55;"'
                    + ' title="worst grade ' + escapeHtml(String(st.worst_confirmed || '-')) + ' over ' + Number(st.n || 0) + ' ops">'
                    + 'dir-' + escapeHtml(String(dir)) + ': ' + escapeHtml(String(st.state || '')) + risers + '</span>';
            });
            stateLine += '</div>';
        }

        var stat = function (val, lbl, grade) {
            return '<div class="pm4-stat" onclick="pm4ToggleGrade(\'' + sideKey + '\',\'' + grade + '\')"'
                 + ' title="Highlight ' + lbl + ' operations in the Timeline (click again to clear)">'
                 + '<div class="v pm4-g-' + grade + '">' + Number(val || 0) + '</div>'
                 + '<div class="l">' + lbl + '</div></div>';
        };

        var filteredTotal = 0;
        Object.keys(s.filtered).forEach(function (k) { filteredTotal += s.filtered[k]; });
        var filteredLine = '';
        if (filteredTotal) {
            var parts = Object.keys(s.filtered).sort(function (x, y) { return s.filtered[y] - s.filtered[x]; })
                .map(function (r) { return escapeHtml(PM4_FILTER_LABELS[r] || r) + ' <b>' + s.filtered[r] + '</b>'; });
            filteredLine = '<div class="pm4-note"><b>' + filteredTotal + '</b> filtered (not scored): ' + parts.join(' &middot; ') + '</div>';
        }

        var condNames = Object.keys(s.conditions).sort(function (x, y) { return s.conditions[y] - s.conditions[x]; });
        var chips = condNames.map(function (n) {
            return '<span class="pm4-chip" id="pm4chip-' + sideKey + '-' + n.replace(/[^A-Za-z0-9]/g, '') + '"'
                 + ' onclick="pm4ToggleCondition(\'' + sideKey + '\',\'' + n + '\')"'
                 + ' title="Highlight these operations in the Timeline">' + escapeHtml(n) + ' <b>' + s.conditions[n] + '</b></span>';
        }).join('');

        return '<div class="pm4-card">'
            + '<div class="pm4-card-title"><span>' + escapeHtml(label) + ' &middot; ' + escapeHtml(wave) + '</span><span>' + s.total + ' ops</span></div>'
            + stateLine
            + '<div class="pm4-stat-row">'
            + stat(s.counts.NORMAL, 'Normal', 'NORMAL') + stat(s.counts.WATCH, 'Watch', 'WATCH')
            + stat(s.counts.ALERT, 'Alert', 'ALERT') + stat(s.counts.FAULT, 'Fault', 'FAULT')
            + '</div>'
            + filteredLine
            + '<div class="pm4-lbl" style="margin-top:8px;">Conditions detected</div><div>'
            + (chips || '<span class="pm4-empty">None</span>') + '</div>'
            + '</div>';
    }

    // ---------- (C) TIMELINE ----------
    function pm4TimelineTrace(ops, yVal, label, side) {
        var x = [], y = [], colors = [], text = [], sizes = [];
        PM4.timelineOps[side] = [];
        (ops || []).forEach(function (o) {
            if (!o.time) { return; }
            var grade = o.confirmed || (o.grade === 'INVALID' ? null : o.grade);
            if (!grade) { return; }
            x.push(o.time);
            y.push(yVal);
            colors.push(PM4_GRADE_COLORS[grade] || '#94a3b8');
            sizes.push(grade === 'NORMAL' ? 6 : 9);
            var cond = (o.condition && o.condition !== '-') ? ('<br>Condition: <b>' + o.condition + '</b>') : '';
            var ft = o.fault_type ? ('<br>Fault type: <b>' + o.fault_type + '</b>') : '';
            var dirh = o.direction ? ('<br>Direction: <b>dir-' + o.direction + '</b>') : '';
            text.push('<b>' + label + '</b> &middot; ' + new Date(o.time).toLocaleString() + dirh
                + '<br>Grade: <b>' + grade + '</b>' + cond + ft + '<br><i>Click for this stroke\'s numbers</i>');
            PM4.timelineOps[side].push(o);
        });
        return {
            x: x, y: y, text: text, mode: 'markers', type: 'scatter', name: label,
            marker: { color: colors, size: sizes, line: { width: 1, color: '#fff' } },
            hovertemplate: '%{text}<extra></extra>'
        };
    }

    function pm4RenderTimeline(dataA, dataB) {
        var el = document.getElementById('aiPm4Timeline');
        if (!el) { return; }
        var traces = [];
        PM4.traceIdx.a = null; PM4.traceIdx.b = null;
        if (dataA.ops && dataA.ops.length) { traces.push(pm4TimelineTrace(dataA.ops, 2, 'A', 'a')); PM4.traceIdx.a = traces.length - 1; }
        if (dataB.ops && dataB.ops.length) { traces.push(pm4TimelineTrace(dataB.ops, 1, 'B', 'b')); PM4.traceIdx.b = traces.length - 1; }
        if (!traces.length) { el.innerHTML = '<div class="pm4-empty">No graded operations in this window.</div>'; return; }
        pm4NewPlot(el, traces, {
            height: 200, margin: { l: 34, r: 10, t: 6, b: 30 },
            xaxis: { type: 'date' },
            yaxis: { tickmode: 'array', tickvals: [1, 2], ticktext: ['B', 'A'], range: [0.5, 2.5] },
            showlegend: false, hovermode: 'closest'
        });
        if (el.removeAllListeners) { el.removeAllListeners('plotly_click'); }
        el.on('plotly_click', function (ev) {
            var pt = ev.points && ev.points[0];
            if (!pt) { return; }
            var side = null;
            ['a', 'b'].forEach(function (k) { if (PM4.traceIdx[k] === pt.curveNumber) { side = k; } });
            var op = side && PM4.timelineOps[side] ? PM4.timelineOps[side][pt.pointNumber] : null;
            if (op) { pm4ShowOp(op, side === 'a' ? 'Machine A' : 'Machine B'); }
        });
    }

    function pm4Restyle(sideKey, matchFn) {
        var idx = PM4.traceIdx[sideKey];
        if (idx == null) { return; }
        var ops = PM4.timelineOps[sideKey] || [];
        var sizes = [], widths = [], colors = [], opacities = [];
        ops.forEach(function (o) {
            var g = o.confirmed || (o.grade === 'INVALID' ? null : o.grade);
            var match = matchFn ? matchFn(o, g) : false;
            sizes.push(match ? 15 : (g === 'NORMAL' ? 6 : 9));
            widths.push(match ? 3 : 1);
            colors.push(match ? '#000000' : '#ffffff');
            opacities.push(matchFn ? (match ? 1 : 0.15) : 1);
        });
        Plotly.restyle('aiPm4Timeline', {
            'marker.size': [sizes], 'marker.line.width': [widths],
            'marker.line.color': [colors], 'marker.opacity': [opacities]
        }, [idx]);
    }

    function pm4ClearHighlight() {
        if (!PM4.highlight) { return; }
        pm4Restyle(PM4.highlight.side, null);
        var prev = document.querySelector('#aiPm4Cards .pm4-chip.on');
        if (prev) { prev.classList.remove('on'); }
        PM4.highlight = null;
    }

    function pm4ToggleGrade(sideKey, grade) {
        if (!pm4HasPlotly() || PM4.traceIdx[sideKey] == null) { return; }
        var same = PM4.highlight && PM4.highlight.side === sideKey && PM4.highlight.grade === grade;
        pm4ClearHighlight();
        if (same) { return; }
        PM4.highlight = { side: sideKey, grade: grade };
        pm4Restyle(sideKey, function (o, g) { return g === grade; });
    }

    function pm4ToggleCondition(sideKey, condName) {
        if (!pm4HasPlotly() || PM4.traceIdx[sideKey] == null) { return; }
        var same = PM4.highlight && PM4.highlight.side === sideKey && PM4.highlight.cond === condName;
        pm4ClearHighlight();
        if (same) { return; }
        PM4.highlight = { side: sideKey, cond: condName };
        pm4Restyle(sideKey, function (o) {
            return !!(o.condition && String(o.condition).split('+').indexOf(condName) >= 0);
        });
        var chip = document.getElementById('pm4chip-' + sideKey + '-' + condName.replace(/[^A-Za-z0-9]/g, ''));
        if (chip) { chip.classList.add('on'); }
    }

    // Clicking a point shows THIS stroke's numbers. Model 4 draws the current/voltage
    // waveform here; that needs the sample arrays, which are stripped server-side to
    // keep the popup payload small, so the numbers stand in for the graph.
    // targetId lets each card report into ITS OWN box. Writing every result into the timeline's
    // box pushed the cards below it down, which moved whatever the operator had just clicked.
    function pm4ShowOp(op, label, targetId) {
        var box = document.getElementById(targetId || 'aiPm4Sel');
        if (!box || !op) { return; }
        var grade = op.confirmed || op.grade || '-';
        var col = PM4_GRADE_COLORS[grade] || '#94a3b8';
        var feats = '';
        if (op.features) {
            var keys = PM4_TREND_FEATS.filter(function (f) { return op.features[f] != null && isFinite(op.features[f]); });
            feats = keys.map(function (f) {
                return '<i>' + escapeHtml(PM4_FEATURE_LABELS[f] || f) + '</i> <b>' + Number(op.features[f]).toFixed(3) + '</b>';
            }).join(' &middot; ');
        }
        box.innerHTML = '<div><b>' + escapeHtml(label) + '</b> &middot; ' + escapeHtml(new Date(op.time).toLocaleString())
            + (op.direction ? (' &middot; dir-' + escapeHtml(String(op.direction))) : '')
            + ' &middot; <span style="color:' + col + ';font-weight:800;">' + escapeHtml(String(grade)) + '</span>'
            + ((op.condition && op.condition !== '-') ? (' &middot; ' + escapeHtml(String(op.condition))) : '')
            + (op.fault_type ? (' &middot; ' + escapeHtml(String(op.fault_type))) : '') + '</div>'
            + (op.cond_notes ? ('<div class="pm4-note" style="margin-top:3px;">'
                + escapeHtml(String(op.cond_notes)) + '</div>') : '')
            + (op.reason ? ('<div class="pm4-note">flagged on: ' + escapeHtml(String(op.reason)) + '</div>') : '')
            + (feats ? ('<div style="margin-top:4px;">' + feats + '</div>')
                     : '<div class="pm4-note">No measurement values on this stroke.</div>');
        pm4Reveal(box);
    }

    // Scroll the panel by the MINIMUM needed to bring the result box into view -- never a
    // scrollIntoView, which recentres and drags the tile the operator just clicked off screen.
    function pm4Reveal(box) {
        var host = document.getElementById('aiPmBody');
        if (!host || !box || !host.scrollHeight) { return; }
        var h = host.getBoundingClientRect(), b = box.getBoundingClientRect();
        if (b.bottom > h.bottom) { host.scrollTop += (b.bottom - h.bottom) + 10; }
        else if (b.top < h.top) { host.scrollTop -= (h.top - b.top) + 10; }
    }

    // ---------- (C2) MEASUREMENT TREND ----------
    function pm4RenderTrendLines(dataA, dataB) {
        var box = document.getElementById('aiPm4TrendBox');
        if (!box) { return; }
        PM4.trendData = { a: dataA, b: dataB };
        var hasFeat = [dataA, dataB].some(function (sd) {
            return sd && sd.ops && sd.ops.some(function (o) { return !!o.features; });
        });
        if (!hasFeat) {
            box.innerHTML = '<div class="pm4-empty">This result carries no per-stroke measurement values, so the feature trends cannot be drawn.</div>';
            return;
        }
        var opts = PM4_TREND_FEATS.map(function (f) {
            return '<option value="' + f + '"' + (f === PM4.feature ? ' selected' : '') + '>'
                 + escapeHtml(PM4_FEATURE_LABELS[f] || f) + ' (' + f + ')</option>';
        }).join('');
        box.innerHTML = '<div style="margin-bottom:10px;"><span class="pm4-lbl">Measurement</span>'
            + '<select class="pm4-feat" onchange="pm4OnFeatureChange(this.value)" aria-label="Measurement">' + opts + '</select></div>'
            + '<div id="aiPm4TrendCharts"></div>';
        pm4DrawTrendCharts();
    }

    function pm4OnFeatureChange(value) {
        PM4.feature = value;
        pm4DrawTrendCharts();
    }

    function pm4DrawTrendCharts() {
        if (!PM4.trendData) { return; }
        var charts = document.getElementById('aiPm4TrendCharts');
        if (!charts) { return; }
        var sides = [['Machine A', PM4.trendData.a, 'a'], ['Machine B', PM4.trendData.b, 'b']];
        var html = '', toPlot = [];
        sides.forEach(function (entry, si) {
            var label = entry[0], sd = entry[1], sideKey = entry[2];
            if (!sd || !sd.ops || !sd.ops.length) { return; }
            var byDir = {};
            sd.ops.forEach(function (o) {
                if (!o.time || !o.features) { return; }
                var v = o.features[PM4.feature];
                if (v == null || !isFinite(v)) { return; }
                var d = o.direction || '?';
                if (!byDir[d]) { byDir[d] = []; }
                byDir[d].push({ op: o, v: +v });
            });
            var dirs = Object.keys(byDir).sort();
            if (!dirs.length) { return; }
            html += '<div class="pm4-side-label" style="margin-top:' + (si ? '14px' : '2px') + ';">'
                 + escapeHtml(label) + ' &middot; ' + escapeHtml(String(sd.wave_type || '')) + '</div>'
                 + '<div style="display:flex;gap:12px;flex-wrap:wrap;">';
            dirs.forEach(function (dir) {
                var id = 'aiPm4Ft-' + sideKey + '-' + String(dir).replace(/[^A-Za-z0-9]/g, '');
                html += '<div style="flex:1 1 240px;min-width:0;max-width:100%;">'
                     + '<div class="pm4-side-label sub">dir-' + escapeHtml(String(dir)) + ' &middot; ' + byDir[dir].length + ' ops</div>'
                     + '<div id="' + id + '" class="pm4-plot"></div></div>';
                toPlot.push({ id: id, pts: byDir[dir], label: label });
            });
            html += '</div>';
        });
        charts.innerHTML = html || '<div class="pm4-empty">No data for this measurement.</div>';
        toPlot.forEach(function (p) { pm4PlotFeatureTrend(p.id, p.pts, p.label); });
    }

    function pm4PlotFeatureTrend(divId, pts, sideLabel) {
        var el = document.getElementById(divId);
        if (!el) { return; }
        var x = pts.map(function (p) { return p.op.time; });
        var y = pts.map(function (p) { return p.v; });
        var colors = pts.map(function (p) { return PM4_GRADE_COLORS[p.op.confirmed || p.op.grade] || '#94a3b8'; });
        var sorted = y.slice().sort(function (m, n) { return m - n; });
        var med = sorted.length ? sorted[Math.floor(sorted.length / 2)] : 0;
        var ylabel = PM4_FEATURE_LABELS[PM4.feature] || PM4.feature;
        pm4NewPlot(el, [{
            x: x, y: y, mode: 'lines+markers', type: 'scatter',
            line: { color: '#00a4e0', width: 1.5 },
            marker: { color: colors, size: 6, line: { width: 1, color: '#fff' } },
            hovertemplate: '%{x|%d %b %H:%M}<br>' + ylabel + ': <b>%{y:.3f}</b><br><i>Click for this stroke\'s numbers</i><extra></extra>'
        }], {
            height: 170, margin: { l: 44, r: 8, t: 6, b: 26 },
            yaxis: { title: { text: ylabel, font: { size: 9 } }, zeroline: false, tickfont: { size: 9 } },
            xaxis: { type: 'date', showgrid: false, tickfont: { size: 9 } },
            showlegend: false, hovermode: 'closest',
            shapes: [{ type: 'line', xref: 'paper', x0: 0, x1: 1, y0: med, y1: med, line: { color: '#94a3b8', width: 1, dash: 'dot' } }]
        });
        if (el.removeAllListeners) { el.removeAllListeners('plotly_click'); }
        el.on('plotly_click', function (ev) {
            var pt = ev.points && ev.points[0];
            if (!pt) { return; }
            var p = pts[pt.pointNumber];
            if (p && p.op) { pm4ShowOp(p.op, sideLabel); }
        });
    }

    // ---------- (C3) CLASS TIMELINE ----------
    function pm4ClassifyOp(o) {
        var grade = o.confirmed || (o.grade === 'INVALID' ? null : o.grade);
        if (!grade) { return null; }
        if (grade === 'NORMAL') { return { cls: 'Normal', color: '#16a34a', label: 'Normal' }; }
        var cond = (o.condition && o.condition !== '-') ? String(o.condition).split('+')[0] : null;
        if (cond) { return { cls: cond, color: PM4_CONDITION_COLORS[cond] || '#ef4444', label: cond }; }
        return { cls: grade, color: PM4_BAND_COLORS[grade] || '#94a3b8', label: grade };
    }
    function pm4IsReverse(direction) {
        return !!(direction && String(direction).toLowerCase().indexOf('rev') === 0);
    }

    // v1.0.55.162: CLASS TIMELINE -- one tile per run of consecutive same-class strokes, each
    // tile drawing every stroke in that run on top of the others, exactly like the Point Machine
    // Operation page. Strips are split Normal / Reverse per machine.
    // The curves are inline SVG, not Plotly: a busy machine yields ~180 tiles and 180 Plotly
    // instances in one popup is pointless when a 96x46 polyline looks the same.
    function pm4ClassBands(ops) {
        var bands = [];
        (ops || []).forEach(function (o) {
            var c = pm4ClassifyOp(o);
            if (!c) { return; }
            var last = bands[bands.length - 1];
            if (last && last.cls === c.cls) { last.ops.push(o); }
            else { bands.push({ cls: c.cls, label: c.label, color: c.color, ops: [o] }); }
        });
        return bands;
    }

    // Overlaid current curves, scaled to the tallest stroke in the RUN so the shapes in one tile
    // are comparable with each other. Opacity does the work when many strokes stack up: a thick
    // solid band means the run is repeatable, a spray of separate lines means it is not.
    function pm4MiniCurves(band) {
        var W = 96, H = 46, curves = [], peak = 0, longest = 0;
        band.ops.forEach(function (o) {
            var c = o.current;
            if (!c || !c.length) { return; }
            curves.push(c);
            if (c.length > longest) { longest = c.length; }
            for (var i = 0; i < c.length; i++) {
                var v = +c[i];
                if (isFinite(v) && v > peak) { peak = v; }
            }
        });
        if (!curves.length || peak <= 0) {
            return '<div class="pm4-tile-c" style="height:46px;line-height:46px;">no curve</div>';
        }
        // More than ~24 overlaid strokes adds ink, not information.
        if (curves.length > 24) { curves = curves.slice(0, 24); }
        var op = curves.length > 12 ? 0.25 : (curves.length > 4 ? 0.4 : 0.75);
        var lines = curves.map(function (c) {
            var pts = [];
            for (var i = 0; i < c.length; i++) {
                var v = +c[i];
                if (!isFinite(v)) { v = 0; }
                var x = (c.length === 1) ? 0 : (i * (W - 2) / (c.length - 1)) + 1;
                var y = H - 2 - (v / peak) * (H - 5);
                pts.push(x.toFixed(1) + ',' + y.toFixed(1));
            }
            return '<polyline points="' + pts.join(' ') + '" fill="none" stroke="' + band.color
                 + '" stroke-width="1.2" stroke-opacity="' + op + '" stroke-linejoin="round" />';
        }).join('');
        return '<svg viewBox="0 0 ' + W + ' ' + H + '" preserveAspectRatio="none" role="img" aria-label="'
             + escapeHtml(band.label) + ' stroke shape">' + lines + '</svg>';
    }

    function pm4RenderClassStrips(sideKey, ops, hostId) {
        var host = document.getElementById(hostId);
        if (!host) { return; }

        var graded = (ops || []).filter(function (o) { return !!pm4ClassifyOp(o); });
        if (!graded.length) {
            host.innerHTML = '<div class="pm4-empty">No graded operations for this machine.</div>';
            return;
        }

        var dirs = [];
        graded.forEach(function (o) {
            var d = o.direction || '?';
            if (dirs.indexOf(d) < 0) { dirs.push(d); }
        });
        dirs.sort();

        PM4.bands[sideKey] = {};
        var html = '';

        dirs.forEach(function (dir) {
            var bands = pm4ClassBands(graded.filter(function (o) { return (o.direction || '?') === dir; }));
            PM4.bands[sideKey][dir] = bands;
            html += '<div class="pm4-side-label sub">' + escapeHtml(String(dir)) + ' &middot; '
                 + bands.length + ' run' + (bands.length > 1 ? 's' : '') + '</div>'
                 + '<div class="pm4-strip">'
                 + bands.map(function (b, i) {
                     return '<div class="pm4-tile" data-side="' + sideKey + '" data-dir="' + escapeHtml(String(dir))
                          + '" data-band="' + i + '">'
                          + '<div class="pm4-tile-l" style="color:' + b.color + ';" title="' + escapeHtml(b.label) + '">'
                          + escapeHtml(b.label) + '</div>'
                          + '<div class="pm4-tile-c">' + b.ops.length + ' op' + (b.ops.length > 1 ? 's' : '') + '</div>'
                          + pm4MiniCurves(b) + '</div>';
                   }).join('')
                 + '</div>';
        });

        host.innerHTML = html;

        var tiles = host.querySelectorAll('.pm4-tile');
        for (var i = 0; i < tiles.length; i++) {
            tiles[i].onclick = function () { pm4SelectTile(this); };
        }
    }

    function pm4SelectTile(tile) {
        var side = tile.getAttribute('data-side');
        var dir = tile.getAttribute('data-dir');
        var idx = Number(tile.getAttribute('data-band'));
        var bands = PM4.bands[side] && PM4.bands[side][dir];
        var band = bands ? bands[idx] : null;
        if (!band || !band.ops.length) { return; }

        ['aiPm4ClassA', 'aiPm4ClassB'].forEach(function (hostId) {
            var host = document.getElementById(hostId);
            if (!host) { return; }
            var all = host.querySelectorAll('.pm4-tile');
            for (var i = 0; i < all.length; i++) { all[i].classList.remove('on'); }
        });
        tile.classList.add('on');

        // A run of one is a single stroke; a longer run gets its first stroke plus the span it
        // covers. The separator is the CHARACTER, not the entity: pm4ShowOp escapes this label.
        var label = (side === 'a' ? 'Machine A' : 'Machine B');
        pm4ShowOp(band.ops[0], label + (band.ops.length > 1
            ? (' \u00b7 run of ' + band.ops.length + ' to ' + new Date(band.ops[band.ops.length - 1].time).toLocaleString())
            : ''), 'aiPm4ClsSel');
    }

    /* ============ end PM ANALYSIS -- MODEL 4 VISUALS ============ */


    function aiLiveGrid() {
        var s = _aiSnapshot;
        if (!s || !(s.values || []).length) {
            return '<div class="rvl-none">No current readings were captured for this analysis.</div>';
        }
        // v1.0.55.92: exceptions first. A flat list makes the reader do the comparing; putting the
        // out-of-range readings at the top does it for them.
        var vals = (s.values || []).slice();

        // v1.0.55.150 (point LIVE binding): a point machine sits in ONE direction; the other side is
        // de-energized and legitimately reads 0 -- it must NOT be flagged LOW or counted "outside safe
        // range". Detect position from the DataLogger relay (Combined-NWKR/RWKR = 1) and tag the
        // inactive direction as de-energized. Self-contained: for any asset with no point relay row,
        // pmPos stays null and NOTHING below changes (other asset types render exactly as before).
        var pmPos = null;
        var isPM = false;   // v1.0.55.151: a point machine is present (relay rows exist), regardless of position
        for (var pi = 0; pi < vals.length; pi++) {
            var pn = String(vals[pi].attr || '').toUpperCase();
            if (pn.indexOf('COMBINED-NWKR') >= 0 || pn.indexOf('COMBINED-RWKR') >= 0) { isPM = true; }
            var one = (String(vals[pi].value) === '1' || +vals[pi].value === 1);
            if (one && pn.indexOf('COMBINED-NWKR') >= 0) { pmPos = 'N'; }
            else if (one && pn.indexOf('COMBINED-RWKR') >= 0) { pmPos = 'R'; }
        }
        // v1.0.55.151: a reading is UNSET when it is null / '' / non-numeric.
        function pmIsUnset(r) {
            if (r == null) { return true; }
            var v = r.value;
            if (v === null || v === undefined || v === '') { return true; }
            return !isFinite(+v);
        }
        // v1.0.55.151: operation voltage/current (NW-V/NW-C/RW-V/RW-C) is measured only DURING a throw;
        // at rest it reads 0. On a point machine that 0 is "idle (no recent operation)", NOT a LOW fault.
        // KR/CR indication (NWKR/RWKR/NWCR/RWCR) is steady and is NOT treated this way.
        function pmIsOpVC(attr) {
            var a = String(attr || '').toUpperCase();
            if (a.indexOf('KR') >= 0 || a.indexOf('CR') >= 0) { return false; } // relay/indication, not op V/C
            return /(NW|RW)[\s\-_]*[VC]\b/.test(a) || a.indexOf('NW-V') >= 0 || a.indexOf('NW-C') >= 0
                || a.indexOf('RW-V') >= 0 || a.indexOf('RW-C') >= 0;
        }
        function pmDeadDir(attr) {
            if (!pmPos) { return false; }
            var a = String(attr || '').toUpperCase();
            var isN = (a.indexOf('NW') >= 0);   // NW-V, NW-C, NWKR, NWCR, Combined-NWKR ...
            var isR = (a.indexOf('RW') >= 0);   // RW-V, RW-C, RWKR, RWCR, Combined-RWKR ...
            if (isN === isR) { return false; }  // direction-neutral (op-time etc.) stays active
            if (pmPos === 'N' && isR) { return true; }   // point NORMAL  -> Reverse side de-energized
            if (pmPos === 'R' && isN) { return true; }   // point REVERSE -> Normal  side de-energized
            return false;
        }

        vals.sort(function (a, b) {
            // muted rows (de-energized / no-reading / idle op) sink to the bottom; among the rest, out-of-range first
            function rank(x) {
                if (pmDeadDir(x.attr)) { return 2; }
                if (isPM && (pmIsUnset(x) || (pmIsOpVC(x.attr) && +x.value === 0))) { return 2; }
                return (x.state === 'low' || x.state === 'high') ? 0 : 1;
            }
            return rank(a) - rank(b);
        });
        var out = 0, oldestMin = -1, body = '', deadCount = 0;
        for (var i = 0; i < vals.length; i++) {
            var r = vals[i], st = String(r.state || '').toLowerCase();
            var dead = pmDeadDir(r.attr);            // v1.0.55.150: point inactive direction
            // v1.0.55.151: a point reading can be legitimately not-a-fault for three reasons.
            var mutedReason = '';
            if (dead) { mutedReason = 'de-energised (inactive direction)'; }
            else if (isPM && pmIsUnset(r)) { mutedReason = 'no reading'; }
            else if (isPM && pmIsOpVC(r.attr) && (+r.value === 0)) { mutedReason = 'idle (no recent operation)'; }
            var muted = (mutedReason !== '');
            if (muted) { deadCount++; }
            var bad = (!muted && (st === 'low' || st === 'high'));
            if (bad) { out++; }
            var mn = (r.minSafe != null) ? +r.minSafe : null;
            var mx = (r.maxSafe != null) ? +r.maxSafe : null;
            // where the value sits in its safe band, clamped so an out-of-range value still shows
            // at the end it exceeded rather than sliding off the bar
            var pct = null, avgPct = null, failPct = null;
            if (mn != null && mx != null && mx > mn) {
                pct = Math.max(0, Math.min(100, ((+r.value - mn) / (mx - mn)) * 100));
                // v1.0.55.93: where NORMAL sits in the band, and the fail threshold when it differs
                // from MinSafe. Both clamped so a marker outside the band still shows at its edge.
                if (r.avg != null) { avgPct = Math.max(0, Math.min(100, ((+r.avg - mn) / (mx - mn)) * 100)); }
                if (r.minFail != null && +r.minFail < mn) { failPct = 0; }
                else if (r.minFail != null) { failPct = Math.max(0, Math.min(100, ((+r.minFail - mn) / (mx - mn)) * 100)); }
            }
            // v1.0.55.96: the RELATION in words. A marker position is only meaningful to a reader
            // who already knows what the marker means; "6% below normal" needs no key.
            var rel = '';
            if (st === 'low') { rel = 'LOW' + (mn != null ? ' - below ' + mn : ''); }
            else if (st === 'high') { rel = 'HIGH' + (mx != null ? ' - above ' + mx : ''); }
            else if (r.avg != null && +r.avg !== 0) {
                var dp = ((+r.value - +r.avg) / Math.abs(+r.avg)) * 100;
                rel = (Math.abs(dp) < 3) ? 'at normal'
                    : (Math.abs(dp).toFixed(0) + '% ' + (dp < 0 ? 'below' : 'above') + ' normal');
            }
            var ageMin = aiAgeMinutes(r.at);
            if (ageMin != null && ageMin > oldestMin) { oldestMin = ageMin; }
            var stale = (ageMin != null && ageMin >= 60);
            // v1.0.55.150: a de-energized inactive-direction reading is shown as such, never as LOW.
            var relTxt = muted ? mutedReason : rel;
            var deadBadge = dead ? 'DE-ENERGISED' : (mutedReason === 'no reading' ? 'NO DATA' : 'IDLE');
            body += '<div class="rvl-t' + (muted ? ' pm-dead' : (bad ? ' ' + st : '')) + '">'
                  + '<div class="rvl-t-top"><span class="rvl-t-a">' + escapeHtml(r.attr || '') + '</span>'
                  + (muted ? '<span class="rvl-t-f pm-dead">' + deadBadge + '</span>'
                          : (bad ? '<span class="rvl-t-f ' + st + '">' + st.toUpperCase() + '</span>' : ''))
                  + (stale ? '<span class="rvl-t-s" title="last update ' + escapeHtml(r.at || '') + '">'
                             + aiAgeLabel(ageMin) + '</span>' : '')
                  + '</div>'
                  + '<div class="rvl-t-v">' + escapeHtml(muted && pmIsUnset(r) ? '--' : String(r.value))
                  + (r.unit ? '<i>' + escapeHtml(r.unit) + '</i>' : '') + '</div>'
                  + (relTxt ? '<div class="rvl-rel' + (muted ? ' pm-dead' : (bad ? ' bad' : '')) + '">' + escapeHtml(relTxt) + '</div>' : '')
                  + (pct != null
                      ? ('<div class="rvl-bar">'
                         + (avgPct != null ? '<span class="rvl-bar-avg" style="left:' + avgPct.toFixed(1)
                                             + '%" title="average ' + escapeHtml(String(r.avg)) + '"></span>' : '')
                         + (failPct != null && r.minFail != null && +r.minFail > mn
                             ? '<span class="rvl-bar-fail" style="left:' + failPct.toFixed(1)
                               + '%" title="MinFail ' + escapeHtml(String(r.minFail)) + '"></span>' : '')
                         + '<span class="rvl-bar-f" style="left:' + pct.toFixed(1) + '%"></span></div>'
                         + '<div class="rvl-t-r"><span>' + mn + '</span>'
                         + (r.avg != null ? '<span class="rvl-t-avg">avg ' + escapeHtml(String(r.avg)) + '</span>' : '')
                         + '<span>' + mx + '</span></div>')
                      : '<div class="rvl-t-r nolim"><span>no safe range</span></div>')
                  + '</div>';
        }
        // v1.0.55.150: for a point machine the "in range" total counts only the ACTIVE direction
        // (de-energized rows are expected 0, not readings under test), and a chip states the position.
        var liveCount = vals.length - deadCount;
        var pmChip = pmPos
            ? '<span class="rvl-as" style="color:#3f7a54;font-weight:600">point ' + (pmPos === 'N' ? 'NORMAL' : 'REVERSE')
              + '<span style="color:#9aa0a6;font-weight:400"> \u00b7 ' + deadCount + ' de-energised</span></span>'
            : '';
        var head = '<div class="rvl-hd">'
                 + (out ? '<b class="rvl-bad">' + out + ' outside safe range</b>'
                        : '<b class="rvl-ok">All ' + liveCount + ' readings in range</b>')
                 + pmChip
                 + '<span class="rvl-as">read ' + escapeHtml(s.retrievedAt || '') + '</span>'
                 + (oldestMin >= 60
                     ? '<span class="rvl-old">oldest channel ' + aiAgeLabel(oldestMin) + '</span>' : '')
                 + '</div>';
        return head + '<div class="rvl-grid">' + body + '</div>';
    }

    // "15/08 11:44" -> minutes old. A snapshot is only as current as its stalest channel, so the
    // card has to be able to say which one that is.
    function aiAgeMinutes(at) {
        try {
            var m = String(at || '').match(/^(\d{2})\/(\d{2})\s+(\d{2}):(\d{2})$/);
            if (!m) { return null; }
            var now = new Date();
            var d = new Date(now.getFullYear(), +m[2] - 1, +m[1], +m[3], +m[4], 0);
            if (d > now) { d.setFullYear(now.getFullYear() - 1); }   // year rollover
            return Math.max(0, Math.round((now - d) / 60000));
        } catch (e) { return null; }
    }
    function aiAgeLabel(mins) {
        if (mins == null) { return ''; }
        if (mins < 60) { return mins + 'm old'; }
        if (mins < 1440) { return Math.round(mins / 60) + 'h old'; }
        return Math.round(mins / 1440) + 'd old';
    }

    // Re-fetch on demand. The snapshot is taken at ANALYSIS time; on an alert two days old that is
    // two days stale, and the reader has no way to tell without asking for it again.
    function aiRefreshLive(ev) {
        try { if (ev && ev.stopPropagation) { ev.stopPropagation(); } } catch (e) { }
        var host = document.getElementById('aiLiveBody');
        var btn = ev && ev.target ? ev.target.closest('.rvl-rf') : null;
        if (!host) { return; }
        if (btn) { btn.className = 'rvl-rf busy'; }
        var c = _currentAlertContext || {};
        $.ajax({
            url: '@Url.Action("LiveValues", "AlertAnalysis")',
            type: 'POST', contentType: 'application/json',
            // v1.0.55.91: carry the run id (same traceId the diagnostic prints) and the alert id,
            // so a LiveValues log line can be found from the run the operator was looking at.
            data: JSON.stringify({ assetId: c.assetId, siteId: c.siteId,
                                   alertId: c.alertId || 0,
                                   runId: (window._aiConvId || '') }),
            success: function (d) {
                try {
                    if (d && d.values && d.values.length) {
                        // v1.0.55.90: LiveValue gives no attribute NAME and no safe range. The
                        // analysis snapshot has both, so carry them across by attribute id and keep
                        // the previous row when the live feed cannot name a channel.
                        var prev = (_aiSnapshot && _aiSnapshot.values) ? _aiSnapshot.values : [];
                        var byName = {};
                        for (var p2 = 0; p2 < prev.length; p2++) { byName[prev[p2].attr] = prev[p2]; }
                        var merged = [];
                        for (var q = 0; q < d.values.length; q++) {
                            var nv = d.values[q];
                            var ref = nv.attr ? byName[nv.attr] : null;
                            if (!nv.attr && !ref) { continue; }   // unnameable channel -- skip, do not show a bare id
                            var mn = (nv.minSafe != null) ? nv.minSafe : (ref ? ref.minSafe : null);
                            var mx = (nv.maxSafe != null) ? nv.maxSafe : (ref ? ref.maxSafe : null);
                            var st = '';
                            if (mn != null || mx != null) {
                                st = (mn != null && nv.value < mn) ? 'low'
                                   : ((mx != null && nv.value > mx) ? 'high' : 'ok');
                            }
                            // v1.0.55.97: START from the reference row so every field it carries
                            // survives -- avg, minFail and anything added later. Re-listing fields by
                            // hand is what lost avg and minFail here in the first place.
                            var out = {};
                            if (ref) { for (var k in ref) { if (Object.prototype.hasOwnProperty.call(ref, k)) { out[k] = ref[k]; } } }
                            out.attr = nv.attr || (ref ? ref.attr : '');
                            out.value = nv.value;
                            out.minSafe = mn;
                            out.maxSafe = mx;
                            out.state = st;
                            out.at = nv.at || '';
                            if (nv.unit) { out.unit = nv.unit; }
                            merged.push(out);
                        }
                        if (!merged.length) { host.innerHTML = '<div class="rvl-none">No readings returned.</div>'; if (btn) { btn.className = 'rvl-rf'; } return; }
                        _aiSnapshot = _aiSnapshot || {};
                        _aiSnapshot.values = merged;
                        _aiSnapshot.retrievedAt = d.retrievedAt || '';
                        host.innerHTML = aiLiveGrid();
                    } else {
                        host.innerHTML = '<div class="rvl-none">No readings returned.</div>';
                    }
                } catch (e) { }
                if (btn) { btn.className = 'rvl-rf'; }
            },
            error: function () {
                host.innerHTML = '<div class="rvl-none">Could not fetch current values.</div>';
                if (btn) { btn.className = 'rvl-rf'; }
            }
        });
    }

    function aiSnapshotNote() {
        var s = _aiSnapshot;
        if (!s || !s.retrievedAt) { return ''; }
        var age = '';
        if (typeof s.ageFromIncidenceSec === 'number' && s.ageFromIncidenceSec > 0) {
            var h = s.ageFromIncidenceSec / 3600;
            age = h >= 1 ? (' &middot; ' + h.toFixed(1) + ' h after the incidence')
                         : (' &middot; ' + Math.round(s.ageFromIncidenceSec / 60) + ' min after the incidence');
        }
        var head = '<div class="rv-snap">Current values read ' + escapeHtml(s.retrievedAt) + age + '</div>';
        // v1.0.55.78: the caption used to stand alone. A reader was told WHEN something was read and
        // never shown WHAT -- which is worse than omitting the line.
        var vals = s.values || [];
        if (!vals.length) { return '<div class="rv-snapblk">' + head + '</div>'; }
        var body = '', oldest = 0;
        for (var i = 0; i < vals.length; i++) {
            var r = vals[i], st = String(r.state || '').toLowerCase();
            var cls = (st === 'low' || st === 'high') ? ' out' : '';
            var rng = '';
            if (r.minSafe != null || r.maxSafe != null) {
                rng = (r.minSafe != null ? r.minSafe : '') + '-' + (r.maxSafe != null ? r.maxSafe : '');
            }
            body += '<div class="snapv' + cls + '">'
                  + '<span class="snapv-a">' + escapeHtml(r.attr || '') + '</span>'
                  + '<span class="snapv-v">' + escapeHtml(String(r.value)) + '</span>'
                  + (rng ? '<span class="snapv-r">' + escapeHtml(rng) + '</span>' : '')
                  + (st === 'low' ? '<span class="snapv-f low">LOW</span>'
                     : (st === 'high' ? '<span class="snapv-f high">HIGH</span>' : ''))
                  + (r.at ? '<span class="snapv-t">' + escapeHtml(r.at) + '</span>' : '')
                  + '</div>';
        }
        return '<div class="rv-snapblk">' + head + '<div class="snapgrid">' + body + '</div></div>';
    }

    function renderAiVerdict(v) {
        _aiLastVerdict = v;
        if (!v) { return; }
        aiApplyContextPatch();   // v1.0.55.67 SL7: before anything reads station/assetType
        var st = aiStateOf(v.verdict);
        var conf = parseInt(v.confidence, 10); if (isNaN(conf)) { conf = 0; }
        // caption text is set after the band renders, below
        if (conf < 0) { conf = 0; } if (conf > 100) { conf = 100; }
        var c = _currentAlertContext || {};
        var ev = (v.evidence || []);
        var idHtml = aiIdItem('Cause', c.causeCode) + aiIdItem('Asset', c.assetName) + aiIdItem('Station', c.station) + aiIdItem('Incidence', c.time);
        // v1.0.55.88: the snapshot is its OWN block below the strip. Appending a grid into a flex
        // row of narrow items made it collapse to a single column.
        var snapHtml = aiSnapshotNote();
        var h = '';
        // v1.0.55.99: only a CRITICAL standing condition outranks the verdict. Anything else is
        // context and reads as an argument with the verdict when placed before it.
        h += renderAssetCondition(true);
        h += '<div class="rv" data-state="' + st[0] + '">';
        // "sure it IS" vs "sure it is NOT" -- without this the number reads as a
        // score for the alert, so a 90% NOT_CONFIRMED looked stronger than an 88%
        // CONFIRMED. They measure different things.
        var vkey = String(v.verdict || '').toUpperCase();
        var capTxt = vkey === 'CONFIRMED' ? 'sure it IS a real fault'
                   : (vkey === 'NOT_CONFIRMED' ? 'sure it is NOT a sustained fault'
                   : 'sure of this reading');
        window._aiLastVerdictObj = v;   // v1.0.55.28: the Speak script is built from the full verdict
        window._aiSpeakText = (st[1] || '') + '. ' + (v.headline || '') + '. Likely cause: ' + (v.likely_cause || '') + '. Recommended action: ' + (v.recommended_action || '');
        h += '<div class="rv-band"><div class="rv-lamp"></div><div class="rv-band-main"><div class="rv-verdict">' + st[1] + '</div><div class="rv-headline">' + escapeHtml(v.headline || '') + '</div></div><div class="rv-gauge"><div class="rv-ring" id="aiRing"><div class="rv-ring-num" id="aiRingNum">0<span>%</span></div></div><div class="rv-gauge-cap" id="aiGaugeCap">' + capTxt + '</div><button type="button" id="aiSpeakBtn" onclick="fnAiSpeak()" title="Read the verdict aloud" class="rv-speak" style="margin-top:6px;">&#128266; Speak</button></div></div>';
        if (idHtml) { h += '<div class="rv-id">' + idHtml + '</div>'; }
        // v1.0.55.89: the snapshot moved INTO the story as a Live data chapter. It was sitting in a
        // band of its own between the identity strip and the verdict, which is not where a reader
        // looks for it -- and it was stale on arrival with no way to refresh.
        h += renderAiResolution(v, c);
        h += renderTriage(v);
        h += renderAiStory(v, c);   // v1.0.55.19: plain-language story cards before the charts
        // v1.0.55.27: the chart is dropped in favour of the computed movement panel. renderAiViz
        // (small multiples + zone bands) is left intact -- swap this line back to restore it.
        h += renderAiMovement(v, c);
        h += renderDerivedInputs(v);
        // v1.0.55.39: one row, weather left, train right.
        // v1.0.55.49: state BOTH cases. An absent banner is not a statement -- it could equally mean
        // an old build or a failed render, so 'fresh' is said explicitly rather than inferred.
        if (v && !v.served_from_cache) {
            h += '<div class="rv-sec" style="padding-top:9px;padding-bottom:9px;">'
               + '<span style="display:inline-block;font-size:10.5px;font-weight:700;letter-spacing:.04em;'
               + 'padding:3px 9px;border-radius:11px;background:rgba(15,118,110,.10);color:#0f766e;'
               + 'border:1px solid rgba(15,118,110,.28);">FRESH ANALYSIS</span>'
               + '<span style="margin-left:9px;font-size:11.5px;color:#6b7482;">model called just now</span>'
               + '</div>';
        }
        // v1.0.55.48: a reused verdict is LABELLED -- an operator must never receive a stored
        // answer believing it is new.
        if (v && v.served_from_cache) {
            h += '<div class="rv-sec" style="background:rgba(163,102,26,.06);border-left:3px solid #a3661a;">'
               + '<span style="display:inline-block;font-size:10.5px;font-weight:700;letter-spacing:.04em;'
               + 'padding:3px 9px;border-radius:11px;background:rgba(163,102,26,.14);color:#7a4d14;'
               + 'border:1px solid rgba(163,102,26,.34);margin-bottom:5px;">REUSED</span>'
               + '<div style="font-size:12px;color:#7a4d14;">'
               + '<b>Previous analysis reused</b> &middot; ' + escapeHtml(fmtCachedAt(v.cached_at))
               /* v1.0.55.104: engine segment removed -- badge is REUSED + time only. Old CACHED rows still carry cached_engine in their stored payload, so the view must not render it even when present. */
               + ' &middot; no new model call. Press <b>Re-run</b> for a fresh analysis.'
               + '</div></div>';
        }
        var _wx = renderWeatherSlot(v), _tr = renderTrainSlot(v);
        h += _tr ? ('<div class="rv-ctxrow">' + _wx + _tr + '</div>') : _wx;
        h += '<div class="rv-sec sec-assess"><div class="rv-eyebrow">Assessment</div><div class="rv-fields">';
        h += aiField('Likely cause', escapeHtml(v.likely_cause || '-'));
        h += aiField('Category', '<span class="rv-cat"><i></i>' + escapeHtml(v.category || '-') + '</span>');
        h += aiField('Action', escapeHtml(v.recommended_action || '-'));
        h += '</div></div>';
        if (ev.length) {
            h += '<div class="rv-sec sec-evid"><div class="rv-eyebrow">Evidence<span class="rv-count">' + ev.length + ' source' + (ev.length > 1 ? 's' : '') + '</span></div><ul class="rv-ev">';
            for (var i = 0; i < ev.length; i++) { h += '<li>' + aiChipValues(escapeHtml(ev[i])) + '</li>'; }
            h += '</ul></div>';
        }
        if (v.caveats) { h += '<div class="rv-sec rv-span" style="border-bottom:none;padding-bottom:0"><div class="rv-caveat"><b>Caveat.</b> ' + escapeHtml(v.caveats) + '</div></div>'; }
        // v1.0.24.0: Hinglish (Romanized Hindi) block, stacked under the English verdict.
        // Rendered from v.hi (server translation of the ALREADY-SANITIZED English).
        h += renderAiHinglish(v);
        h += '</div>';
        $('#aiVerdictBody').html(h);
        aiTweenRing(conf);
        try{ rvsInit(); }catch(e){}   // v1.0.55.21: story deck lives in the same freshly-inserted HTML
        renderAiChat();
    }

    // v1.0.24.0: render the Hinglish translation block (from the sanitized verdict's `hi`).
    function renderAiHinglish(v) {
        var hi = v && v.hi ? v.hi : null;
        if (!hi) { return ''; }
        var out = '<div class="rv-hi"><div class="rv-hi-cap">\u0939\u093f\u0902\u0926\u0940 / Hinglish</div>';
        if (hi.headline) { out += '<div class="rv-hi-head">' + escapeHtml(hi.headline) + '</div>'; }
        if (hi.likely_cause) { out += aiField('Sambhavit kaaran', escapeHtml(hi.likely_cause)); }
        // v1.0.27.0: the recommended action is shown in ENGLISH (not translated) - it is the one
        // field that could carry an operational instruction, so it stays filter-checked English.
        if (hi.recommended_action_en) { out += aiField('Kya karein (English)', escapeHtml(hi.recommended_action_en)); }
        var hev = hi.evidence || [];
        if (hev.length) {
            out += '<div class="rv-sec sec-hi" style="padding-left:0;padding-right:0"><div class="rv-eyebrow">Mukhya readings</div><ul class="rv-ev">';
            for (var i = 0; i < hev.length; i++) { out += '<li>' + aiChipValues(escapeHtml(hev[i])) + '</li>'; }
            out += '</ul></div>';
        }
        if (hi.caveats) { out += '<div class="rv-caveat" style="margin-top:8px"><b>Dhyaan de.</b> ' + escapeHtml(hi.caveats) + '</div>'; }
        out += '</div>';
        return out;
    }
    // v1.0.55.21: story deck -- one card per slide across the full row. Height follows the ACTIVE
    // card (cards differ a lot in length; a fixed track height leaves dead space under short ones).
    var _rvsIdx = 0, _rvsN = 0;
    function rvsSize(){
        var dk=document.getElementById('rvsDeck'), tr=document.getElementById('rvsTrack');
        if(!dk||!tr){ return; }
        var card=tr.children[_rvsIdx];
        if(card){ dk.style.height = card.offsetHeight + 'px'; }
    }
    function rvsPaint(){
        var tr=document.getElementById('rvsTrack'); if(!tr){ return; }
        tr.style.transform = 'translateX(-' + (_rvsIdx*100) + '%)';
        var dots=document.getElementById('rvsDots');
        if(dots){ var d='';
            for(var i=0;i<_rvsN;i++){ d += '<div class="rvs-dot'+(i===_rvsIdx?' on':'')+'" onclick="rvsJump('+i+')"></div>'; }
            dots.innerHTML=d; }
        // v1.0.55.26: NAMED chapters, so the deck reads as one section with parts rather than an
        // anonymous card floating on the page.
        var chaps=document.getElementById('rvsChaps');
        if(chaps){ var ch='';
            for(var k=0;k<_rvsN;k++){ var lb=tr.children[k].getAttribute('data-lbl')||('Part '+(k+1));
                ch += '<button type="button" class="rvs-chap'+(k===_rvsIdx?' on':'')+'" onclick="rvsJump('+k+',1)">'+lb+'</button>'; }
            chaps.innerHTML=ch; }
        var st=document.getElementById('rvsStep'); if(st){ st.textContent=(_rvsIdx+1)+' / '+_rvsN; }
        var p=document.getElementById('rvsPrev'), n=document.getElementById('rvsNext');
        if(p){ p.disabled=(_rvsIdx<=0); } if(n){ n.disabled=(_rvsIdx>=_rvsN-1); }
        rvsSize();
    }
    // v1.0.55.26: AUTO-ADVANCE every 2s, looping. Pauses while the pointer is over the deck, and
    // stops for good once the operator drives it themselves (clicking an arrow, dot or chapter) --
    // auto-play that fights the reader is worse than none. Honours prefers-reduced-motion.
    var _rvsTimer=null, _rvsTick=null, _rvsElapsed=0, _rvsManual=false, _rvsHover=false;
    var RVS_MS=2000;
    function rvsProgress(pct){ var b=document.getElementById('rvsProgBar'); if(b){ b.style.width=Math.max(0,Math.min(100,pct))+'%'; } }
    function rvsAutoStop(hide){ if(_rvsTimer){ clearInterval(_rvsTimer); _rvsTimer=null; }
        if(_rvsTick){ clearInterval(_rvsTick); _rvsTick=null; }
        _rvsElapsed=0; rvsProgress(0);
        var pr=document.getElementById('rvsProg'); if(pr && hide){ pr.className='rvs-prog off'; } }
    function rvsAutoStart(){
        if(_rvsManual || _AI_REDUCE || _rvsN<2){ rvsAutoStop(true); return; }
        rvsAutoStop(false);
        var pr=document.getElementById('rvsProg'); if(pr){ pr.className='rvs-prog'; }
        _rvsTick=setInterval(function(){ if(_rvsHover){ return; } _rvsElapsed+=100; rvsProgress(_rvsElapsed/RVS_MS*100); }, 100);
        _rvsTimer=setInterval(function(){
            if(_rvsHover){ return; }
            _rvsElapsed=0; rvsProgress(0);
            _rvsIdx = (_rvsIdx+1) % _rvsN;
            rvsPaint();
        }, RVS_MS);
    }
    function rvsJump(i,manual){ if(i<0||i>=_rvsN){ return; }
        if(manual){ _rvsManual=true; rvsAutoStop(true); }
        _rvsIdx=i; rvsPaint(); }
    function rvsGo(d){ rvsJump(_rvsIdx+d,1); }
    function rvsInit(){
        var tr=document.getElementById('rvsTrack'); if(!tr){ _rvsN=0; return; }
        _rvsN=tr.children.length; _rvsIdx=0; rvsPaint();
        setTimeout(rvsSize,60); setTimeout(rvsSize,320);   // after fonts/reflow settle
        _rvsManual=false; _rvsHover=false;
        try{ var st=document.getElementById('rvsDeck').parentNode;
            st.addEventListener('mouseenter', function(){ _rvsHover=true; });
            st.addEventListener('mouseleave', function(){ _rvsHover=false; });
        }catch(e){}
        rvsAutoStart();
        try{
            var dk=document.getElementById('rvsDeck'), x0=null;
            dk.addEventListener('touchstart', function(e){ x0=e.touches[0].clientX; }, {passive:true});
            dk.addEventListener('touchend', function(e){
                if(x0==null){ return; } var dx=e.changedTouches[0].clientX-x0; x0=null;
                if(Math.abs(dx)>40){ rvsGo(dx<0?1:-1); } }, {passive:true});
        }catch(e){}
        if(!window._rvsResize){ window._rvsResize=1; window.addEventListener('resize', rvsSize); }
    }
    function aiTweenRing(target) {
        var ring = document.getElementById('aiRing'), num = document.getElementById('aiRingNum');
        if (!ring) { return; }
        if (_AI_REDUCE) { ring.style.setProperty('--p', target); num.innerHTML = target + '<span>%</span>'; return; }
        var start = performance.now(), dur = 750;
        function step(t) {
            var k = Math.min(1, (t - start) / dur);
            var e = 1 - Math.pow(1 - k, 3);
            var val = Math.round(target * e);
            ring.style.setProperty('--p', val);
            num.innerHTML = val + '<span>%</span>';
            if (k < 1) { requestAnimationFrame(step); }
        }
        requestAnimationFrame(step);
    }
    /* ---- follow-up chat ---- */
    var _aiChatThreads = {};
    var _aiChatBusy = false;

    function renderAiChat() {
        var id = _aiCurrentAlertId;
        if (!id) { return; }
        var th = _aiChatThreads[aiChatKey(id)] || [];
        var h = '<div class="rv-chat">';
        h += '<div class="rv-chat-cap">Follow-up</div>';
        h += '<div class="rv-chat-thread" id="aiChatThread">';
        for (var i = 0; i < th.length; i++) { h += aiChatBubble(th[i], false); }
        h += '</div>';
        h += '<div class="rv-chat-row">';
        h += '<input type="text" class="rv-chat-in" id="aiChatIn" maxlength="500" placeholder="Ask a follow-up about this alert..." onkeydown="if (event.key === \'Enter\') { fnAiChatSend(); }" />';
        h += '<button type="button" class="rv-mic" id="aiMicBtn" onclick="fnAiMic()" title="Dictate a follow-up">&#127908;</button>';
        h += '<button type="button" class="rv-chat-send" id="aiChatSend" onclick="fnAiChatSend()">Ask</button>';
        h += '</div></div>';
        $('#aiChatWrap').html(h);
        aiChatScroll();
        aiChatSetBusy(_aiChatBusy);
    }
    // v1.0.55.111: the follow-up answer was rendered with escapeHtml() alone -- every "##",
    // "**bold**" and "- bullet" the model wrote arrived on screen as literal characters, so a
    // structured Hinglish answer read as one flat wall. This renders it. Escaping runs FIRST and
    // the block rules only ever match text that is already escaped, so nothing the model emits
    // can inject markup. Streaming stays plain text (textContent) and the finished answer is
    // re-rendered by renderAiChat() through this function.
    // v1.0.55.112: [[CARD]] blocks -> maintenance-plan cards, same marker format the ChatBot
    // uses (1.2.9.5) so ONE format serves both surfaces. Runs BEFORE the markdown pass so a card
    // body is never mangled by the list/heading rules, and the HTML is spliced back after so the
    // markdown pass cannot re-escape it. Text with no marker is untouched: a model that ignores
    // the format degrades to readable prose rather than broken markup.
    var RVC_LABELS = { '15-DAY': '15-day record', 'ML': 'Model classification', 'LASTOP': 'Last operation', 'ACTION': 'Action', 'NOTE': 'Note' };
    function aiPlanCards(raw, stash) {
        if (!raw || raw.indexOf('[[CARD]]') < 0) { return raw; }
        return raw.replace(/\[\[CARD\]\]([\s\S]*?)\[\[\/CARD\]\]/g, function (_, body) {
            var lines = body.split('\n').map(function (l) { return l.replace(/^\s*[-*\u2022]\s?/, '').trim(); }).filter(function (l) { return l.length; });
            if (!lines.length) { return ''; }
            var head = {};
            lines[0].split('|').forEach(function (p) {
                var kv = p.split('=');
                if (kv.length >= 2) { head[kv[0].trim().toLowerCase()] = kv.slice(1).join('=').trim(); }
            });
            var pr = (head.priority || 'MONITOR').toUpperCase();
            var cls = pr.indexOf('URGENT') >= 0 ? 'urgent' : (pr.indexOf('INSPECT') >= 0 ? 'soon' : 'monitor');
            var rows = '';
            for (var i = 1; i < lines.length; i++) {
                var c = lines[i].indexOf(':');
                if (c < 0) { rows += '<div class="rvc-row"><div class="rvc-v">' + escapeHtml(lines[i]) + '</div></div>'; continue; }
                var key = lines[i].substring(0, c).trim().toUpperCase();
                var val = lines[i].substring(c + 1).trim();
                var label = RVC_LABELS[key] || (key.charAt(0) + key.slice(1).toLowerCase());
                var extra = (key === 'NOTE') ? ' rvc-note' : (key === 'ACTION' ? ' rvc-action' : '');
                rows += '<div class="rvc-row' + extra + '"><div class="rvc-k">' + escapeHtml(label) + '</div><div class="rvc-v">' + escapeHtml(val) + '</div></div>';
            }
            var sub = [head.type, head.site].filter(Boolean).map(escapeHtml).join(' &middot; ');
            stash.push('<div class="plan-card ' + cls + '">'
                + '<div class="rvc-head"><span class="rvc-pill">' + escapeHtml(pr) + '</span>'
                + '<span class="rvc-asset">' + escapeHtml(head.asset || 'Asset') + '</span>'
                + (sub ? '<span class="rvc-sub">' + sub + '</span>' : '') + '</div>'
                + '<div class="rvc-body">' + rows + '</div></div>');
            return '\n\u0000CARD' + (stash.length - 1) + '\u0000\n';
        });
    }
    function aiChatMd(raw) {
        if (!raw) { return ''; }
