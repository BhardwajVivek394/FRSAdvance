    function fnRenderAlertCard(id, data, alertCardJson) {
        var a = _cacParseJson(alertCardJson);
        var row = aaRowById(id);
        var code = a ? (a.alertCode || '') : ((data && data.CauseCode) ? data.CauseCode : (row ? row.code : ''));
        var asset = a ? (a.assetName || '') : (row ? row.asset : '');
        var station = a ? (a.station || '') : (row ? row.station : '');
        var time = a ? (a.time || '') : (row ? row.timeText : '');
        var desc = '';
        if (a && a.description) { desc = a.description; }
        else if (data && data.SetAlertMessage) { desc = data.SetAlertMessage; }
        else if (data && data.Description) { desc = data.Description; }
        // v1.0.55.161: PREDICTIVE was shown as FAILURE. Rule (owner): if the API sends alertType,
        // use it EXACTLY; else AlertCategoryId (1=predictive, 2=failure). alertType arrives EITHER as
        // a string ("PREDICTIVE"/"FAILURE", from the card JSON) OR as the numeric AlertType 1/2 (from
        // the alert row d.AlertType) -- the old "starts-with-PRED else FAILURE" check failed both the
        // numeric form and any blank/variant, defaulting predictive alerts to FAILURE. Resolve both
        // forms; fall back to AlertCategoryId, then the description text, then FAILURE.
        var _rawType = a ? ((a.alertType != null) ? a.alertType : a.AlertType)
                         : (row ? row.type : null);
        if (_rawType == null && data) { _rawType = (data.AlertType != null) ? data.AlertType : data.alertType; }
        var _cat = (a && a.alertCategoryId != null) ? a.alertCategoryId
                 : (data && data.AlertCategoryId != null) ? data.AlertCategoryId
                 : (row && row.categoryId != null) ? row.categoryId : null;
        var _tU = (_rawType == null ? '' : String(_rawType)).trim().toUpperCase();
        var _dU = (desc || '').toUpperCase();
        var pred;
        if (_tU.indexOf('PRED') >= 0) { pred = true; }          // explicit string, predictive
        else if (_tU.indexOf('FAIL') >= 0) { pred = false; }    // explicit string, failure
        else if (_tU === '1') { pred = true; }                  // numeric AlertType 1 = predictive
        else if (_tU === '2') { pred = false; }                 // numeric AlertType 2 = failure
        else if (_cat != null && Number(_cat) === 1) { pred = true; }   // AlertCategoryId 1 = predictive
        else if (_cat != null && Number(_cat) === 2) { pred = false; }  // AlertCategoryId 2 = failure
        else if (_dU.indexOf('PREDICTIVE') >= 0) { pred = true; }
        else { pred = false; }                                  // nothing indicates predictive
        $('#aaCardCode').text(code);
        $('#aaCardMeta').text(asset + '  \u00b7  ' + station + '  \u00b7  ' + time);
        $('#aaCardBadge').text(pred ? 'PREDICTIVE' : 'FAILURE');
        $('#aaCardBadge').attr('class', 'aa-card-badge ' + (pred ? 'aa-b-pred' : 'aa-b-fail'));
        $('#aaCardBmHost').html(aaBookmarkBtn(id, row ? row.siteId : ((data && data.SiteId) ? data.SiteId : 0)));   // v1.0.55.174
        $('#aaCardBody').text(desc || 'No description available.');
    }

