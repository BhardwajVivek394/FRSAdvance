                window.wisdomOpenPanel();   // scoped list now shows the new PENDING rule below
            })
            .catch(function (e) {
                if (sb) { sb.disabled = false; sb.textContent = sbOld; }
                if (pp) { pp.innerHTML = '<div style="color:#b91c1c;font-size:12px;padding:8px 0;">Save failed: ' + wEsc(e.message) + '</div>'; }
            });
    };

    // v1.0.55.45: RUN LOG tab. Metadata only -- payloads stay behind ToolTrace (gated in 160.58).
    // v1.0.55.47: what.verdict is {verdict, confidence, category, headline} -- render it, do not
    // stringify the object.
    function rvVerdictText(wt) {
        if (!wt || !wt.verdict) { return '-'; }
        var v = wt.verdict;
        if (typeof v !== 'object') { return String(v); }
        var t = v.verdict || '-';
        if (v.confidence !== undefined && v.confidence !== null) { t += ' ' + v.confidence + '%'; }
        return t;
    }
    // v1.0.55.51: EXPORT PDF -- build a REAL DOCUMENT, do not print the screen.
    // 1.0.55.50 printed the live panel and produced THREE IDENTICAL PAGES. Cause: the panel lives
    // inside .vd-modal, which is position:fixed; inset:0; overflow:auto. A fixed overlay has no
    // page flow -- the browser prints its visible viewport and repeats it for every page. No amount
    // of @@media print on the inner elements fixes that; the clipper is the ancestor.
    // So: clone the RENDERED content into a clean document in a new window. Still no second
    // renderer -- the same DOM the operator just read -- but laid out as a linear document that
    // paginates properly.
    window.fnAiExportPdf = function () {
        try {
            var body = document.getElementById('aiVerdictBody');
            if (!body) { return; }
            var ctx = window._currentAlertContext || {};
            // v1.0.55.54: _aiLastMeta only ever holds { audit: ... }, so meta.componentVersion was
            // always undefined and the footer printed "component" followed by nothing.
            var meta = window._aiLastMeta || {};
            var _aud = meta.audit || {};
            var _compVer = _aud.componentVersion || meta.componentVersion || '';
            var v = window._aiLastVerdictObj || {};
            var vv = v.verdict ? v.verdict : v;
            var reused = !!(vv && vv.served_from_cache);

            function esc(x) { return String(x === undefined || x === null ? '' : x)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

            // carry the page's own styles so the document looks like what was on screen
            var css = '';
            var sheets = document.querySelectorAll('style');
            for (var i = 0; i < sheets.length; i++) { css += sheets[i].innerHTML + '\n'; }

            var thread = document.getElementById('aiChatThread');
            // v1.0.55.52: the model answers follow-ups in MARKDOWN, and the panel shows it raw --
            // '**bold**', '|table|', '---' all reached the page as literal characters. On screen it
            // is untidy; on a printed maintenance record it reads as broken output. Minimal, safe
            // conversion: bold, pipe tables, horizontal rules. No library.
            function mdLite(html) {
                try {
                    var out = html.replace(/\*\*([^*<>]{1,200}?)\*\*/g, '<b>$1</b>');
                    out = out.replace(/^\s*---\s*$/gm, '<hr style="border:0;border-top:1px solid #d8dee6;margin:8px 0;">');
                    // pipe table -> real table, so columns line up on paper
                    out = out.replace(/(?:^\|.*\|\s*$\n?){2,}/gm, function (blk) {
                        var rows = blk.trim().split(/\n/);
                        var cells = [];
                        for (var r = 0; r < rows.length; r++) {
                            var t = rows[r].trim().replace(/^\||\|$/g, '');
                            if (/^[\s|:-]+$/.test(t)) { continue; }   // the |---|---| separator
                            cells.push(t.split('|'));
                        }
                        if (cells.length === 0) { return blk; }
                        var h = '<table style="border-collapse:collapse;margin:6px 0;font-size:12px;">';
                        for (var i2 = 0; i2 < cells.length; i2++) {
                            h += '<tr>';
                            for (var j2 = 0; j2 < cells[i2].length; j2++) {
                                h += (i2 === 0 ? '<th' : '<td') +
                                     ' style="border:1px solid #d8dee6;padding:3px 7px;text-align:left;">' +
                                     cells[i2][j2].trim() + (i2 === 0 ? '</th>' : '</td>');
                            }
                            h += '</tr>';
                        }
                        return h + '</table>';
                    });
                    return out;
                } catch (e) { return html; }
            }
            var chatHtml = (thread && thread.innerHTML.trim().length > 0)
                ? '<h2 class="pd-h2">Conversation</h2><div class="pd-chat">' + mdLite(thread.innerHTML) + '</div>'
                : '';

            var d = new Date();
            var stamp = d.toLocaleDateString() + ' ' + d.toTimeString().substring(0, 5);

            var w = window.open('', '_blank');
            if (!w) { alert('Allow pop-ups for this site to export the PDF.'); return; }

            w.document.write('<!DOCTYPE html><html><head><meta charset="utf-8">'
              + '<title>Alert ' + esc(ctx.alertId) + ' -- ENERGY7 Analysis</title><style>'
              + css
              + '/* ---- document layout: overrides the on-screen panel chrome ---- */'
              + 'body{background:#fff;margin:0;padding:18px 20px;'
              + 'font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;}'
              + '.vd-modal,.ai-verdict-head,.ai-live{display:none!important;}'
              + '.pd-hd{border-bottom:2px solid #253041;padding-bottom:9px;margin-bottom:14px;}'
              + '.pd-t{font-weight:700;font-size:15px;color:#253041;}'
              + '.pd-s{font-size:12px;color:#4a5561;margin-top:3px;}'
              + '.pd-reuse{font-size:11px;color:#7a4d14;margin-top:5px;}'
              + '.pd-h2{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:#5b6672;'
              + 'border-bottom:1px solid #d8dee6;padding-bottom:5px;margin:20px 0 10px;}'
              + '.pd-ft{margin-top:18px;padding-top:9px;border-top:1px solid #b9c2cc;'
              + 'font-size:10.5px;color:#5b6672;}'
              /* the carousel again: unstack or four of five chapters never appear */
              + '.rvs-track{display:block!important;transform:none!important;}'
              + '.rvs-track>.rvs-card{flex:none!important;width:100%!important;margin:0 0 10px!important;}'
              + '.rvs-deck,.rvs-stage,.rvs-wrap{overflow:visible!important;height:auto!important;'
              + 'min-height:0!important;background:none!important;border:0!important;padding:0!important;}'
              /* .rvs-chaps are the tab buttons. Once the carousel is unstacked every chapter is
                 printed in full, so the tabs are navigation to nothing. */
              + '.rvs-nav,.rvs-arw,.rvs-dots,.rvs-chaps,.rv-speak,'
              + '#aiChatIn,#aiChatSend,#aiChatLive{display:none!important;}'
              /* v1.0.55.54: the QUESTION printed as faint grey body text -- on a maintenance record a
                 reader could not tell a question from an answer, nor who asked it. */
              + '.rv-msg.u{background:#eef2f7;border:1px solid #dbe2ea;border-radius:8px;'
              + 'padding:8px 12px;margin:14px 0 6px;color:#1f2937!important;font-weight:600;}'
              + '.rv-msg.u:before{content:"ASKED BY " attr(data-who);display:block;font-weight:700;'
              + 'font-size:9.5px;letter-spacing:.06em;color:#5b6672;margin-bottom:4px;}'
              + '.rv-msg.a{border-left:3px solid #6366f1;padding:8px 0 8px 12px;margin:0 0 12px;}'
              /* the engine status line is LIVE chrome, not part of the answer */
              + '.rv-msg .tools{display:none!important;}'
              /* the screen shadow reserves space and prints as a grey smear -- part of why page 1
                 looked half empty */
              + '.rvs-card{box-shadow:none!important;min-height:0!important;}'
              /* dark band -> light: toner, and legibility on a mono printer */
              + '.rv-band,.rv-verdict,.rvs-hero{background:#fff!important;color:#111!important;'
              + 'border-left:4px solid #334155!important;box-shadow:none!important;}'
              + '.rv-band *,.rvs-hero *{color:#111!important;}'
              /* .rv-sec REMOVED from this list: it is a whole SECTION, and keeping something taller
                 than the remaining page whole forces the entire section to the next page -- which is
                 what left two thirds of page 1 blank. Keep-whole belongs on the small units. */
              + '.rvs-card,.rv-ev,.rv-caveat,.ai-chat{break-inside:avoid;page-break-inside:avoid;}'
              /* let a long section flow across pages rather than jump */
              + '.rv-sec{break-inside:auto;page-break-inside:auto;}'
              /* v1.0.55.53: FORCE ONE COLUMN. The panel tiles Assessment/Evidence/Caveat TWO-UP above
                 900px -- a good screen layout that is wrong on paper: the export window is wide, so
                 the two columns came through, then broke across pages leaving most of a sheet blank.
                 A printed record reads top to bottom in one column. */
              + '.rv{display:block!important;}'
              + '.rv>.rv-sec{grid-column:auto!important;width:auto!important;}'
              + '.rv-ctxrow{display:block!important;}'
              + '.rv-ctxrow>*{width:auto!important;margin-bottom:8px;}'
              /* and pin the document to a page width, so layout does not follow the window size */
              + 'body{max-width:186mm;margin:0 auto;}'
              + '@@media print{@@page{margin:14mm 12mm;}}'
              + '</style></head><body>'
              + '<div class="pd-hd"><div class="pd-t">ENERGY7 -- Alert Analysis Record</div>'
              + '<div class="pd-s">Alert ' + esc(ctx.alertId) + ' &nbsp;|&nbsp; ' + esc(ctx.causeCode)
              + ' &nbsp;|&nbsp; ' + esc(ctx.assetName) + ' &nbsp;|&nbsp; '
              + esc(ctx.station || ctx.siteId) + ' &nbsp;|&nbsp; ' + esc(ctx.time) + '</div>'
              + (reused ? '<div class="pd-reuse">Previous analysis reused -- originally analysed '
                    + esc(fmtCachedAt(vv.cached_at))
                    + '. This is not a new analysis.</div>' : '')
              + '</div>'
              + body.innerHTML
              + chatHtml
              + '<div class="pd-ft">Engine ' + esc(meta.engineLabel || 'ENERGY7 ULTRA')
              + (_compVer ? ' &nbsp;|&nbsp; component ' + esc(_compVer) : '')
              + ' &nbsp;|&nbsp; exported ' + esc(stamp)
              + '<br><b>Advisory only -- a diagnostic record, not authority to occupy or operate. '
              + 'Movement decisions remain with the section controller.</b></div>'
              + '</body></html>');
            w.document.close();
            // let fonts and layout settle, or the first page can paginate against a half-laid-out DOM
            setTimeout(function () { try { w.focus(); w.print(); } catch (e) { } }, 350);
        } catch (e) { }
    };

    window.wisdomOpenRuns = function (dateStr) {
        var p = document.getElementById('aiWisdomPanel');
        if (!p) { return; }
        p.style.display = 'block';
        p.innerHTML = 'Loading runs...';
        var url = '@Url.Action("RunLogFeed", "AiChat")' + (dateStr ? ('?date=' + encodeURIComponent(dateStr)) : '');
        var x = new XMLHttpRequest();
        x.open('GET', url, true);
        x.onreadystatechange = function () {
            if (x.readyState !== 4) { return; }
            if (x.status === 403) { p.innerHTML = '<div style="padding:14px;color:#b45309;">Run log is restricted to site-keeping users.</div>'; return; }
            var d; try { d = JSON.parse(x.responseText); } catch (e) { p.innerHTML = '<div style="padding:14px;color:#b91c1c;">Could not read the run log.</div>'; return; }
            var rows = (d && d.rows) || [];
            var noWis = 0, tokTot = 0, incon = 0;
            for (var i = 0; i < rows.length; i++) {
                var w = rows[i].wisdom || {}, c = rows[i].cost || {}, wh = rows[i].what || {};
                var tot = (w.doctrinal || 0) + (w.field || 0) + (w.circuit || 0) + (w.learned || 0);
                if (!tot) { noWis++; }
                tokTot += (c.tokIn || 0) + (c.tokOut || 0);
                // v1.0.55.47: what.verdict is an OBJECT {verdict, confidence, ...}; String() on it
                // yields '[object Object]', so this counter never matched and always read 0.
                var vtxt = (wh.verdict && typeof wh.verdict === 'object') ? (wh.verdict.verdict || '') : (wh.verdict || '');
                if (String(vtxt).indexOf('INCONCLUSIVE') >= 0) { incon++; }
            }
            var pct = rows.length ? Math.round(noWis * 100 / rows.length) : 0;
            // v1.0.55.47: one labelled chip per figure -- the old spans ran together and read as
            // '18 runstokens 575,525 inconclusive 00% with NO wisdom injected'.
            function chip(lbl, val, col) {
                return '<span style="display:inline-block;margin:0 14px 0 0;">'
                     + '<span style="color:#6b7280;font-size:11px;">' + lbl + '</span> '
                     + '<b style="color:' + (col || '#253041') + ';">' + val + '</b></span>';
            }
            var h = '<div style="padding:12px 14px;border-bottom:1px solid #e5e7eb;">'
                  + '<div style="margin-bottom:6px;"><b>Run log</b> &middot; ' + wEsc(d.date || '') + '</div>'
                  + chip('runs', rows.length)
                  + chip('tokens', tokTot.toLocaleString())
                  + chip('inconclusive', incon)
                  + chip('no wisdom', pct + '%', pct > 0 ? '#b45309' : '#065f46')
                  + '</div>';
            h += '<div style="max-height:60vh;overflow:auto;"><table style="width:100%;border-collapse:collapse;font-size:11.5px;">';
            h += '<tr style="position:sticky;top:0;background:#f8fafc;">'
               + ['time','user','site','alert','cause','engine / model','verdict','tok','tools','ms','wisdom']
                 .map(function (t) { return '<th style="text-align:left;padding:6px 8px;border-bottom:1px solid #e5e7eb;font-weight:700;color:#475569;">' + t + '</th>'; }).join('') + '</tr>';
            for (var r = 0; r < rows.length; r++) {
                var o = rows[r], who = o.who || {}, why = o.why || {}, wc = o.which || {},
                    wr = o.where || {}, wn = o.when || {}, co = o.cost || {}, wi = o.wisdom || {}, wt = o.what || {};
                var wt2 = (wi.doctrinal || 0) + (wi.field || 0) + (wi.circuit || 0) + (wi.learned || 0);
                h += '<tr style="border-bottom:1px solid #f1f5f9;">'
                   + '<td style="padding:5px 8px;">' + wEsc(String(o.tsUtc || '').substring(11, 19)) + '</td>'
                   + '<td style="padding:5px 8px;">' + wEsc(who.user || '-') + '</td>'
                   + '<td style="padding:5px 8px;">' + wEsc(String(wr.siteId || '')) + ' ' + wEsc(wr.station || '') + '</td>'
                   + '<td style="padding:5px 8px;">' + wEsc(String(why.alertId || '-')) + '</td>'
                   + '<td style="padding:5px 8px;">' + wEsc(why.causeCode || '-') + '</td>'
                   + '<td style="padding:5px 8px;">' + wEsc(wc.engine || '-') + ' / ' + wEsc(wc.model || '-') + '</td>'
                   + '<td style="padding:5px 8px;">' + wEsc(rvVerdictText(wt)) + '</td>'
                   + '<td style="padding:5px 8px;">' + ((co.tokIn || 0) + (co.tokOut || 0)) + '</td>'
                   + '<td style="padding:5px 8px;">' + (co.toolCalls || 0) + '</td>'
                   + '<td style="padding:5px 8px;">' + (wn.totalMs || 0) + '</td>'
                   + '<td style="padding:5px 8px;color:' + (wt2 ? '#065f46' : '#b45309') + ';">' + wt2 + '</td></tr>';
            }
            h += '</table></div>';
            p.innerHTML = h;
        };
        x.send();
    };

    window.wisdomOpenPanel = function (showAll) {
        showAll = false;   // v1.0.42.0: popup is ALWAYS scoped to the current alert.
                           // "Manage all" is the only everything view, per decision.
        var p = document.getElementById('aiWisdomPanel');
        if (!p) { return; }
        p.style.display = 'block';
        p.innerHTML = 'Loading...';
        // v1.0.40.0: scoped to the CURRENT alert (cause+site) by default; "Show all"
        // switches to everything; Manage all covers cross-cause work.
        var c = _currentAlertContext || {};
        var scCause = showAll ? '' : (c.causeCode || c.cause_code || '');
        var scSite  = showAll ? '' : String(c.siteId || c.site_id || '');
        function wBadge(st) {
            var bg = st === 'PENDING' ? '#fef3c7' : (st.indexOf('APPROVED') === 0 ? '#d1fae5' : '#f1f5f9');
            var fg = st === 'PENDING' ? '#92400e' : (st.indexOf('APPROVED') === 0 ? '#065f46' : '#475569');
            return '<span style="background:' + bg + ';color:' + fg + ';font-size:10px;font-weight:700;padding:2px 8px;border-radius:10px;letter-spacing:.3px;">' + wEsc(st) + '</span>';
        }
        function renderRows(d) {
            var items = (d.items || []);
            // v1.0.41.0: filter CLIENT-SIDE too. The server params (1.0.139) scope the
            // list when the new DLL is live, but a stale DLL ignores unknown params and
            // returns everything -- this filter guarantees the scoped view either way.
            if (!showAll) {
                items = items.filter(function (it) {
                    var sc = it.scope || {};
                    var okC = !scCause || String(sc.causeCode || '').toUpperCase() === String(scCause).toUpperCase();
                    var okS = !scSite || !sc.siteId || String(sc.siteId) === String(scSite);
                    return okC && okS;
                });
            }
            var h = '<div style="display:flex;align-items:center;gap:8px;margin:6px 0;">'
                  + '<span style="font-weight:600;font-size:13px;">Wisdom for this alert (' + items.length + ')</span>'
                  + '<span style="font-size:11px;color:#94a3b8;">all wisdom is in Manage all</span></div>';
            if (!items.length) {
                h += '<div style="color:#94a3b8;font-size:12px;padding:10px 0;">No wisdom for this alert&#39;s cause/site yet. Correct an answer in chat then "Save last as wisdom" &mdash; or open "Manage all" for everything.</div>';
                return h;
            }
            items.forEach(function (it) {
                var pend = it.status === 'PENDING';
                h += '<div style="border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px;margin-bottom:8px;background:#fff;">';
                h += '<div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">' + wBadge(it.status)
                   + '<span style="font-size:11px;color:#64748b;">' + wEsc(it.scope.causeCode) + ' &middot; ' + wEsc(it.scope.assetType) + ' &middot; site ' + wEsc(it.scope.siteId || 'any') + '</span></div>';
                if (pend) {
                    h += '<textarea id="wr_' + wEsc(it.id) + '" style="width:100%;box-sizing:border-box;min-height:40px;margin:2px 0 6px;border:1px solid #cbd5e1;border-radius:8px;padding:6px 8px;font:inherit;font-size:12px;">' + wEsc(it.distilledRule || '') + '</textarea>';
                } else {
                    h += '<div id="wr_' + wEsc(it.id) + '" style="font-size:12.5px;margin:2px 0 6px;">' + wEsc(it.distilledRule || '') + '</div>';
                }
                if (it.aiText) { h += '<div style="font-size:11px;color:#94a3b8;border-left:2px solid #e2e8f0;padding-left:8px;margin-bottom:2px;">was: ' + wEsc((it.aiText || '').slice(0, 160)) + '</div>'; }
                if (it.userText) { h += '<div style="font-size:11px;color:#94a3b8;border-left:2px solid #e2e8f0;padding-left:8px;margin-bottom:6px;">fix: ' + wEsc((it.userText || '').slice(0, 160)) + '</div>'; }
                h += '<div style="display:flex;gap:6px;">';
                if (pend) {
                    h += '<button type="button" data-wact="edit" data-wid="' + wEsc(it.id) + '" style="font-size:11px;padding:4px 10px;border-radius:6px;border:1px solid #cbd5e1;background:#f8fafc;cursor:pointer;">Save edit</button>';
                    h += '<button type="button" data-wact="approve" data-wid="' + wEsc(it.id) + '" style="font-size:11px;padding:4px 10px;border-radius:6px;border:0;background:#059669;color:#fff;cursor:pointer;">Approve</button>';
                    h += '<button type="button" data-wact="reject" data-wid="' + wEsc(it.id) + '" style="font-size:11px;padding:4px 10px;border-radius:6px;border:0;background:#dc2626;color:#fff;cursor:pointer;">Reject</button>';
                } else if ((it.status || '').indexOf('APPROVED') === 0) {
                    h += '<button type="button" data-wact="reject" data-wid="' + wEsc(it.id) + '" style="font-size:11px;padding:4px 10px;border-radius:6px;border:0;background:#dc2626;color:#fff;cursor:pointer;">Retire</button>';
                }
                h += '</div></div>';
            });
            return h;
        }
        fetch(W_WHO, { headers: { 'X-Wisdom-Token': wTok() } })
            .then(function (r) { return r.ok ? r.json() : r.text().then(function (t) { throw new Error(wErrMsg(r.status, t)); }); })
            .then(function (me) {
                var hdr = '<div style="border:1px solid #cbd5e1;border-radius:8px;padding:8px;margin-bottom:8px;background:#f8fafc;font-size:13px;">';
                if (!me.authenticated) {
                    hdr += '<b>Not signed in.</b> The app is not passing a Windows identity, so wisdom cannot authorize you. Enable Windows auth on the site / check IIS.';
                } else {
                    // -- v1.0.45.0 -- REPLACED: shows the portal display name, and the
                    // hint no longer points at a WisdomReviewers/WisdomApprovers config
                    // list -- access is now RoleId/IsSiteKeeping, evaluated per request.
                    // hdr += 'Signed in as <b>' + wEsc(me.identity) + '</b> &middot; reviewer: ' + (me.isReviewer ? 'yes' : '<b style="color:#b45309;">no</b>') + ' &middot; approver: ' + (me.isApprover ? 'yes' : '<b style="color:#b45309;">no</b>');
                    // if (!me.isReviewer) {
                    //     hdr += '<div style="margin-top:4px;color:#b45309;">To enable: add <code>' + wEsc(me.identity) + '</code> to <code>WisdomReviewers</code> and <code>WisdomApprovers</code> in Web.config, then reload.</div>';
                    hdr += 'Signed in as <b>' + wEsc(me.displayName || me.identity) + '</b> &middot; reviewer: ' + (me.isReviewer ? 'yes' : '<b style="color:#b45309;">no</b>') + ' &middot; approver: ' + (me.isApprover ? 'yes' : '<b style="color:#b45309;">no</b>');
                    if (!me.isReviewer) {
                        hdr += '<div style="margin-top:4px;color:#b45309;">Wisdom access requires Admin role, or User role with Site Keeping, on your portal login.</div>';
                    }
                }
                hdr += '</div>';
                var listUrl = W_LIST + (scCause || scSite ? ((W_LIST.indexOf('?') >= 0 ? '&' : '?') + 'causeCode=' + encodeURIComponent(scCause) + '&siteId=' + encodeURIComponent(scSite)) : '');
                return fetch(listUrl, { headers: { 'X-Wisdom-Token': wTok() } })
                    .then(function (r) { return r.ok ? r.json() : r.text().then(function (t) { throw new Error(wErrMsg(r.status, t)); }); })
                    .then(function (d) { p.innerHTML = hdr + renderRows(d); })
                    .catch(function (e) { p.innerHTML = hdr + '<div style="color:#b91c1c;">List: ' + wEsc(e.message) + '</div>'; });
            })
            .catch(function (e) { p.innerHTML = 'Error: ' + wEsc(e.message); });
    };

    document.addEventListener('click', function (e) {
        var b = e.target;
        if (!b || b.tagName !== 'BUTTON') { return; }
        var act = b.getAttribute('data-wact');
        var id = b.getAttribute('data-wid');
        if (!act || !id) { return; }
        var ta = document.getElementById('wr_' + id);
        var rule = (ta && typeof ta.value === 'string') ? ta.value : '';
        if (act === 'edit') {
            wPost(W_UPD, { id: id, editedRule: rule }).then(window.wisdomOpenPanel).catch(function (e2) { alert('Edit failed: ' + e2.message); });
        } else if (act === 'approve') {
            wPost(W_SET, { id: id, status: 'APPROVED', editedRule: rule }).then(window.wisdomOpenPanel).catch(function (e2) { alert('Approve failed: ' + e2.message); });
        } else if (act === 'reject') {
            wPost(W_SET, { id: id, status: 'REJECTED' }).then(window.wisdomOpenPanel).catch(function (e2) { alert('Reject failed: ' + e2.message); });
        }
    });

    document.addEventListener('DOMContentLoaded', function () {
        if (AA_WISDOM) {
            var bar = document.getElementById('aiWisdomBar');
            if (bar) { bar.style.display = 'block'; }
