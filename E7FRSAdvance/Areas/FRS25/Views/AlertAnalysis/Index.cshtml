    function fnAnalyzeAlert(force) {
        if (!_currentAlertContext || !_aiCurrentAlertId) { return; }
        var id = _aiCurrentAlertId;
        if (!force && _aiVerdictCache[aiCacheKey(id)]) { _aiVerdictProvider = _aiProvider; renderAiVerdict(_aiVerdictCache[aiCacheKey(id)]); return; }
        if (_aiInFlight) { return; }
        _aiInFlight = true;
        $('#aiReanalyzeBtn').prop('disabled', true);
        _aiTrail = []; window._aiLastStats = null; window._aiLastTrend = null; window._aiConvId = null; window._aiGreeting = null; aiTraceDrop();   // v1.0.47.0: no stale stats/trend across runs; v1.0.55.22: nor a stale trace; v1.0.55.110: nor a stale greeting
        _aiServerVerdict = null;
        _aiT0 = Date.now();
        aiTrailPush('Preparing data', '', 'run');
        aiStartTick();
        renderAiLoading();
        $('#aiChatWrap').empty();
        var acc = '';
        var finished = false;
        var runProv = _aiProvider; // pinned at POST time, same moment the body is stamped
        function done() { if (finished) { return; } finished = true; finishAi(acc, id, runProv); }
        fetch('@Url.Action("AnalyzeAlert", "AiChat")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            // stamped at POST time: the only moment that cannot be stale
            body: JSON.stringify(aiWithForce(_currentAlertContext, force))   // v1.0.55.48
        }).then(function (resp) {
            if (!resp.ok || !resp.body) { throw new Error('HTTP ' + resp.status); }
            var reader = resp.body.getReader();
            var decoder = new TextDecoder('utf-8');
            var buffer = '';
            function pump() {
                return reader.read().then(function (res) {
                    if (res.done) { done(); return; }
                    buffer += decoder.decode(res.value, { stream: true });
                    var parts = buffer.split('\n\n');
                    buffer = parts.pop();
                    for (var i = 0; i < parts.length; i++) {
                        var line = parts[i].trim();
                        if (line.indexOf('data:') !== 0) { continue; }
                        var payload = line.substring(5).trim();
                        if (payload === '[DONE]') { done(); return; }
                        var evt = null;
                        try { evt = JSON.parse(payload); } catch (e) { continue; }
                        if (evt.type === 'text' && evt.text) { acc += evt.text; }
                        else if (evt.type === 'verdict' && evt.verdict) {
                            // server-validated: filtered, category-checked, word-capped.
                            // Always preferred over the browser's own JSON extraction.
                            _aiServerVerdict = evt.verdict;
                        }
                        // v1.0.55.67: the controller emits these on the verdict envelope; without
                        // the merge below the follow-up chat keeps posting the ORIGINAL blank
                        // station/assetType, because mutating ctx server-side never reaches us.
                        else if (evt.type === 'context_patch' && evt.patch) { _aiContextPatch = evt.patch; }
                        else if (evt.type === 'asset_condition' && evt.condition) { _aiAssetCondition = evt.condition; }
                        else if (evt.type === 'snapshot' && evt.snapshot) { _aiSnapshot = evt.snapshot; }
                        else if (evt.type === 'pm' && evt.pm) { window._aiPm = evt.pm; }   // v1.0.55.154: server-injected v4 point analysis (states + ai_summary)
                        else if (evt.type === 'stats') { window._aiLastStats = evt; }
                        else if (evt.type === 'trend') { window._aiLastTrend = evt; }
                        else if (evt.type === 'meta' && evt.traceId) { window._aiConvId = evt.traceId; }   // v1.0.55.11: for Tool trace
                        else if (evt.type === 'greeting' && evt.text) { window._aiGreeting = String(evt.text); renderAiLoading(); }   // v1.0.55.110
                        else if (evt.type === 'analysis_id' && evt.analysisId) { window._aiAnalysisId = evt.analysisId; _aiAnalysisIdByAlert[String(id)] = evt.analysisId; }   // v1.0.55.163: keyed by the alert this run belongs to   // v1.0.55.98
                        // v1.0.55.43: the 7W audit arrives at the END of the run (the meta event fires
                        // before it), so it has its own event. Stored for the Log download.
                        else if (evt.type === 'audit' && evt.audit) { window._aiLastMeta = { audit: evt.audit }; }
                        // v1.0.55.70: the server declined to send an audit for this run. Drop any
                        // copy retained from an earlier run -- stale privileged data left in the page
                        // is the same disclosure by another route.
                        else if (evt.type === 'audit_denied') { try { window._aiLastMeta = null; } catch (e) { } }
                        else if (evt.type === 'step') { aiOnStep(evt); renderAiLoading(); }
                        else if (evt.type === 'tool_use' && evt.name) { renderAiLoading(); }
                        else if (evt.type === 'error') { aiError(evt.message || 'Error'); finished = true; return; }
                    }
                    // v1.0.55.17: if the operator opened Tool trace, keep it open for the NEXT
                    // analysis too -- they are debugging a sequence of alerts, not one.
                    try{ aiTraceCheck(); if(window._aiTraceAuto && window._aiConvId && !document.getElementById('aiToolTraceBox')){
                        setTimeout(function(){ try{ if(window._aiTraceAuto && !document.getElementById('aiToolTraceBox')){ fnAiToolTrace(); } }catch(e){} }, 400); } }catch(e){}
                    (function(){
                        var st=window._aiLastStats; var el=document.getElementById('aiVerdictStats');
                        if(st&&el){
                            function k(n){return n>=1000?((n/1000).toFixed(n>=10000?0:1)+'k'):(''+n);}
                            var totalMs=(st.modelMs||0)+(st.toolMs||0)+(st.discoveryMs||0);
                            var parts=[];
                            parts.push('\u23F1 '+(totalMs/1000).toFixed(1)+'s');
                            parts.push('\uD83C\uDFAB '+k(st.tokIn||0)+' in / '+k(st.tokOut||0)+' out');
                            if(st.cacheRead){parts.push(k(st.cacheRead)+' cached');}
                            el.textContent=parts.join('  \u00B7  ');
                        }
                    })();
                    return pump();
                });
            }
            return pump();
        }).catch(function (err) {
            aiError('Diagnostic failed: ' + (err && err.message ? err.message : err));
        });
    }

    function aiOnStep(e) {
        if (e.phase === 'model_start') {
            if (_aiTrail.length === 1) { aiTrailDone(); }       // close "Preparing data"
            // Cycle rather than pinning the last entry: the old code showed
            // "Building the verdict" for every turn past the 5th, which was simply
            // not true - the model was still gathering data.
            var it = e.iter || 0;
            var w = _AI_THINK[it % _AI_THINK.length] + '  (turn ' + (it + 1) + ')';
            aiTrailPush(w, (e.engine || ''), 'run');
        } else if (e.phase === 'model_done') {
            var kt = e.tokIn ? Math.round(e.tokIn / 1000) : 0;
            var tk = kt ? (kt + 'k context' + (kt >= 40 ? '  \u2014 growing' : '')) : '';
            aiTrailDone(e.ms, tk);
        } else if (e.phase === 'tool_done') {
            var lbl = _AI_TOOL_LABEL[e.name] || e.name;
            var sub = (e.engine || '') + (e.chars ? '  \u00b7 ' + aiKb(e.chars) : '')
                    + (e.note ? '  \u00b7 ' + e.note : '');
            // subtract the duration: the frame arrives when the call ENDED, so t must
            // be the START for the cumulative column to agree with total elapsed
            _aiTrail.push({ label: lbl, sub: sub, t: Date.now() - (e.ms || 0),
                            ms: e.ms || 0, state: e.ok ? 'done' : 'warn' });
        }
    }

    function aiKb(n) { return n >= 1024 ? (n / 1024).toFixed(1) + ' KB' : n + ' B'; }

    // The trail only redrew when a frame arrived, so during a 10 s model turn the
    // elapsed counter sat still and the analysis looked hung. Tick it while any
    // step is running.
    var _aiTick = null;
    function aiStartTick() {
        if (_aiTick) { return; }
        _aiTick = setInterval(function () {
            var running = false;
            for (var i = 0; i < _aiTrail.length; i++) { if (_aiTrail[i].state === 'run') { running = true; break; } }
            if (!running) { aiStopTick(); return; }
            if ($('#aiVerdictBody .rv-steps.live').length) { renderAiLoading(); }
        }, 300);
    }
    function aiStopTick() { if (_aiTick) { clearInterval(_aiTick); _aiTick = null; } }

    function renderAiLoading() {
        // v1.0.44.0: "AI at work" presentation -- pulsing orb, gradient title, animated
        // beam, card steps with a live spinner. Same trail data model as before.
        var li = '', total = _aiT0 ? ((Date.now() - _aiT0) / 1000) : 0;
        for (var k = 0; k < _aiTrail.length; k++) {
            var st = _aiTrail[k];
            var tk = st.state === 'done' ? '\u2713' : (st.state === 'warn' ? '!' : '');
            var cum = _aiT0 ? ((st.t - _aiT0 + (st.ms || 0)) / 1000).toFixed(1) : '0.0';
            var per = st.ms ? ((st.ms / 1000).toFixed(1) + 's') : '';
            li += '<li class="' + st.state + '">'
                + '<span class="tk">' + tk + '</span>'
                + '<span class="lb">' + escapeHtml(st.label) + '</span>'
                + (st.sub ? '<span class="sb">' + escapeHtml(st.sub) + '</span>' : '')
                + '<span class="tm">' + (st.state === 'run'
                        ? ((Date.now() - st.t) / 1000).toFixed(1) + 's'
                        : per + ' (' + cum + 's)') + '</span>'
                + '</li>';
        }
        var brand = (typeof aiModelLabel === 'function') ? aiModelLabel(_aiProvider) : 'ENERGY7 AI';
        $('#aiVerdictBody').html(
            '<div class="rv" data-state="analyzing"><div class="ai-think">'
            + (window._aiGreeting ? ('<div class="ai-greet">' + escapeHtml(window._aiGreeting) + '</div>') : '')
            + '<div class="ai-think-head"><span class="ai-orb"><i></i></span>'
            + '<span class="ai-think-title">' + escapeHtml(brand) + ' analyzing<span class="ai-dots"><i>.</i><i>.</i><i>.</i></span></span></div>'
            + '<div class="ai-beam"><i></i></div>'
            + '<ul class="ai-tsteps">' + li + '</ul>'
            + '<div class="ai-think-cap"><b>' + total.toFixed(1) + 's</b> \u00b7 correlating telemetry, history &amp; ML evidence</div>'
            + '</div></div>');
    }

    function finishAi(text, id, runProv) {
        _aiInFlight = false;
        $('#aiReanalyzeBtn').prop('disabled', false);
        var v = _aiServerVerdict || extractJson(text);
        if (!v) { aiShowRaw(text); return; }
        // toggling mid-run must not file this verdict under the other model
        _aiVerdictCache[String(id) + '|' + (runProv || _aiProvider)] = v;
        _aiVerdictProvider = runProv || _aiProvider;
        renderAiVerdict(v);
        try { aiRateBtnSync(); } catch (e) { }   // v1.0.55.163: the row id arrived mid-run; the button appears now
    }
    function extractJson(text) {
        if (!text) { return null; }
        var t = text.replace(/```json/gi, '').replace(/```/g, '').trim();
        var s = t.indexOf('{'); var e = t.lastIndexOf('}');
        if (s < 0 || e < 0 || e <= s) { return null; }
        try { return JSON.parse(t.substring(s, e + 1)); } catch (ex) { return null; }
    }
    function aiError(msg) {
        _aiInFlight = false;
        $('#aiReanalyzeBtn').prop('disabled', false);
        $('#aiVerdictBody').html('<div class="rv-error">' + escapeHtml(msg) + '</div>');
    }
    function aiShowRaw(text) {
        $('#aiVerdictBody').html('<div class="rv-raw">' + escapeHtml(text) + '</div>');
    }

    function aiStateOf(v) {
        v = (v || '').toString().toUpperCase();
        if (v.indexOf('NOT_CONFIRMED') >= 0 || v.indexOf('NOT CONFIRMED') >= 0 || v.indexOf('FALSE') >= 0) { return ['unconfirmed', 'Not confirmed']; }
        if (v.indexOf('CONFIRMED') >= 0 || v.indexOf('VALID') >= 0) { return ['confirmed', 'Confirmed']; }
        return ['inconclusive', 'Inconclusive'];
    }
    function aiIdItem(k, val) {
        if (!val) { return ''; }
        return '<div class="rv-id-item"><div class="rv-id-k">' + escapeHtml(k) + '</div><div class="rv-id-v">' + escapeHtml(val) + '</div></div>';
    }
    function aiField(k, vhtml) {
        return '<div class="rv-field"><div class="rv-fk">' + escapeHtml(k) + '</div><div class="rv-fv">' + vhtml + '</div></div>';
    }

    function aiVizNum(x){
        if (x === null || x === undefined || x === '' || isNaN(x)) { return null; }
        var n = Number(x); var r = Math.round(n*100)/100;
        return (r % 1 === 0) ? String(r) : String(r);
    }
    // ---- SERVICE VERDICT DRY RUN -------------------------------------
    // Calls the SAME endpoint (AnalyzeAlertJson) the alert service will call,
    // via a server-side proxy that holds the shared key. Shows the verbatim
    // envelope so the contract and the accuracy can both be judged on a real,
    // already-triggered alert.
    var _vdInFlight = false;

    function fnRowVerdictDry(evt, id){
        if (evt && evt.stopPropagation) { evt.stopPropagation(); }
        if (_vdInFlight) { return; }
        var row = aaRowById(id);
        if (!row) { return; }
        _vdInFlight = true;
        fnVdOpen(row);
        // Mirror the AI popup EXACTLY: POST with a JSON body. My earlier GET with a
        // query string returned nothing, so alertCard never reached the model and
        // every dry run came back ungrounded.
        $.ajax({
            url: '@Url.Action("GetFRSAlertById", "AlertLive")',
            type: 'POST',
            data: JSON.stringify({ id: id }),
            contentType: 'application/json'
        }).done(function (data) {
            fnVdPost(fnVdBuildCtx(id, row, data));
        }).fail(function () {
            fnVdPost(fnVdBuildCtx(id, row, null));
        });
    }

    // Build the context with the SAME logic the AI popup uses, so the dry run
    // exercises a real payload. The card JSON lives under CloudAlertCardJson /
    // LocalAlertCardJson / ResetAlertCardJson -- the names I guessed before
    // (AlertConditionJson etc.) do not exist, which is why alertCard was always
    // absent and the model had no threshold to judge against.
    function fnVdBuildCtx(id, row, data){
        var alertCardJson = (data && data.CloudAlertCardJson) ? data.CloudAlertCardJson
                          : ((data && data.LocalAlertCardJson) ? data.LocalAlertCardJson : null);
        var rectCardJson = (data && data.ResetAlertCardJson) ? data.ResetAlertCardJson : null;
        var a = _cacParseJson(alertCardJson);
        var r = _cacParseJson(rectCardJson);

        var ctx = { alertId: id };
        if (a) {
            ctx.causeCode = a.alertCode || '';
            ctx.assetName = a.assetName || '';
            ctx.station = a.station || '';
            ctx.time = a.time || '';
            ctx.alertType = a.alertType || '';
            ctx.description = a.description || '';
            ctx.alertCard = a;                 // threshold + input snapshot
        } else {
            ctx.causeCode = (data && data.CauseCode) ? data.CauseCode : (row ? row.code : '');
            ctx.rawMessage = ((data && data.SetAlertMessage) ? data.SetAlertMessage : '')
                           + ' ' + ((data && data.Description) ? data.Description : '');
            if (row) {
                ctx.station = row.station;
                ctx.assetName = row.asset;
                ctx.alertType = row.type;
                ctx.time = row.timeText;
            }
        }
        if (r) { ctx.resetTime = r.resetTimestamp || ''; ctx.resetCard = r; }
        // v1.0.55.88: the reset card is OPTIONAL; the alert row always carries resetText. Without
        // this the panel announced "Still active" on an alert the same page showed as cleared.
        if (!ctx.resetTime && row && row.resetText) { ctx.resetTime = row.resetText; }
        aiAttachIds(ctx, data, a);
        ctx.provider = _aiProvider;
        ctx.think = _aiThink;   // v1.0.55.37
        return ctx;
    }

    function fnVdPost(ctx){
        $.ajax({
            url: '@Url.Action("VerdictDryRun", "AlertAnalysis")',
            type: 'POST', contentType: 'application/json',
            data: JSON.stringify(ctx), dataType: 'json'
        }).done(function (res) {
            fnVdRender(res, ctx);
        }).fail(function (xhr) {
            // Report what actually happened. A generic message here hides the
            // usual cause: the controller action is not deployed yet.
            var code = xhr ? xhr.status : 0;
            var srv = null;
            try { srv = JSON.parse(xhr.responseText); } catch (e) { srv = null; }
            var msg, hint;
            if (srv && (srv.detail || srv.dryRun)) {
                msg = srv.detail || srv.dryRun;
                hint = '';
            } else if (code === 404) {
                msg = 'HTTP 404 - VerdictDryRun action not found';
                hint = 'The view is drop-in but AlertAnalysisController.cs is C#: rebuild and redeploy E7FRSAdvance, then retry.';
            } else if (code === 0) {
                msg = 'No response (request blocked or connection dropped)';
                hint = 'Check the browser Network tab: the POST may have been blocked or the app pool recycled.';
            } else if (code === 401 || code === 403) {
                msg = 'HTTP ' + code + ' - rejected before reaching the verdict endpoint';
                hint = 'The page session or an auth filter rejected the POST.';
            } else if (code === 500) {
                msg = 'HTTP 500 - server error in VerdictDryRun';
                hint = 'Check the E7FRSAdvance trace log; the raw exception is written server-side.';
            } else {
                msg = 'HTTP ' + code + ' - dry run could not complete';
                hint = '';
            }
            var head = (xhr && xhr.responseText) ? String(xhr.responseText).substring(0, 400) : '';
            fnVdRender({ dryRun: 'error', httpStatus: code, detail: msg, hint: hint, rawBody: head }, ctx);
        }).always(function () { _vdInFlight = false; });
    }

    function fnVdOpen(row){
        $('#vdTitle').text((row.code || 'Alert') + '  -  ' + (row.asset || '') + '  @@  ' + (row.station || ''));
        $('#vdBody').html('<div class="vd-wait">Calling the service verdict endpoint ...</div>');
        $('#vdModal').show();
    }
    function fnVdClose(){ $('#vdModal').hide(); }

    function fnVdRender(res, ctx){
        var h = '';
        var env = res && res.response ? res.response : null;
        var st  = env && env.status ? env.status : (res && res.dryRun === 'ok' ? 'unknown' : (res.dryRun || 'error'));
        var okCls = (st === 'ok') ? 'ok' : (st === 'ungrounded' ? 'warn' : 'bad');

        h += '<div class="vd-strip ' + okCls + '">';
        h += '<span class="vd-k">status</span><b>' + escapeHtml(String(st)) + '</b>';
        if (res && typeof res.httpStatus !== 'undefined') { h += '<span class="vd-k">http</span><b>' + escapeHtml(String(res.httpStatus)) + '</b>'; }
        if (res && typeof res.roundTripMs !== 'undefined') { h += '<span class="vd-k">round trip</span><b>' + escapeHtml(String(res.roundTripMs)) + ' ms</b>'; }
        if (res && res.detail) { h += '<span class="vd-k">detail</span><b>' + escapeHtml(String(res.detail)) + '</b>'; }
        h += '</div>';
        if (res && res.hint) { h += '<div class="vd-hint">' + escapeHtml(String(res.hint)) + '</div>'; }
        if (res && res.rawBody) { h += '<div class="vd-sec"><div class="vd-eyebrow">Server response (first 400 chars)</div><pre class="vd-json">' + escapeHtml(String(res.rawBody)) + '</pre></div>'; }

        var vd = env && env.verdict ? env.verdict : null;
        if (vd) {
            h += '<div class="vd-sec"><div class="vd-eyebrow">Verdict the alert service would receive</div>';
            h += '<div class="vd-vd"><span class="vd-badge ' + escapeHtml(String(vd.verdict || '').toLowerCase()) + '">' + escapeHtml(vd.verdict || '-') + '</span>';
            h += '<span class="vd-conf">' + escapeHtml(String(vd.confidence)) + '% confidence</span>';
            h += '<span class="vd-cat">' + escapeHtml(vd.category || '-') + '</span></div>';
            h += '<div class="vd-head">' + aiChipValues(escapeHtml(vd.headline || '')) + '</div>';
            if (vd.evidence && vd.evidence.length) {
                h += '<ul class="vd-ev">';
                for (var i = 0; i < vd.evidence.length; i++) { h += '<li>' + aiChipValues(escapeHtml(vd.evidence[i])) + '</li>'; }
                h += '</ul>';
            }
            h += '</div>';
        } else {
            h += '<div class="vd-sec"><div class="vd-none">No verdict returned &#8212; consumers must fail open and treat this alert as un-analysed.</div></div>';
        }

        var meta = env && env.meta ? env.meta : null;
        if (meta) {
            h += '<div class="vd-sec"><div class="vd-eyebrow">Meta</div><div class="vd-meta">';
            var keys = ['componentVersion','promptVersion','model','turns','modelMs','toolMs','discoveryMs','durationMs','toolCalls','toolSucceeded','requestId','evidenceArgs','diagnostics','error'];
            for (var m = 0; m < keys.length; m++) {
                if (typeof meta[keys[m]] === 'undefined' || meta[keys[m]] === null) { continue; }
                h += '<div class="vd-mrow"><span>' + escapeHtml(keys[m]) + '</span><code>' + escapeHtml(String(meta[keys[m]])) + '</code></div>';
            }
            h += '</div></div>';
        }

        h += '<div class="vd-sec"><div class="vd-eyebrow">Exact payload sent <button class="vd-copy" onclick="fnVdCopy(\'vdReq\')">copy</button></div>';
        h += '<pre class="vd-json" id="vdReq">' + escapeHtml(JSON.stringify(ctx, null, 2)) + '</pre></div>';
        h += '<div class="vd-sec" style="border-bottom:none"><div class="vd-eyebrow">Exact envelope returned <button class="vd-copy" onclick="fnVdCopy(\'vdRes\')">copy</button></div>';
        h += '<pre class="vd-json" id="vdRes">' + escapeHtml(JSON.stringify(env !== null ? env : res, null, 2)) + '</pre></div>';

        $('#vdBody').html(h);
    }

    function fnVdCopy(id){
        var el = document.getElementById(id);
        if (!el) { return; }
        var r = document.createRange(); r.selectNodeContents(el);
        var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(r);
        try { document.execCommand('copy'); } catch (e) { }
        sel.removeAllRanges();
    }

    // Wrap measured values in chips so the eye lands on numbers, not prose.
    // Operates on ALREADY-ESCAPED text, so it cannot introduce model markup.
    function aiChipValues(escaped){
        var out = escaped;
        out = out.replace(/\b(\d{1,2}:\d{2}(?::\d{2})?)\b/g, '<b class="rv-chip t">$1</b>');
        out = out.replace(/(~?-?\d+(?:\.\d+)?)\s?(&#937;|\u03a9|mA|mV|kV|ms|min|Hz|[AVsh%])(?![A-Za-z0-9])/g,
                          '<b class="rv-chip v">$1&#8202;$2</b>');
        out = out.replace(/(\d+(?:\.\d+)?)\s?(x|\u00d7)(?![A-Za-z0-9])/g, '<b class="rv-chip v">$1$2</b>');
        return out;
    }

    function aiParseAlertTime(str){
        if (!str) { return null; }
        var t = String(str).trim(), m;
        m = t.match(/^(\d{1,2}):(\d{2}):(\d{2})\s*[\/ ]\s*(\d{1,2})\.(\d{1,2})\.(\d{4})$/);
        if (m) { return new Date(+m[6], +m[5]-1, +m[4], +m[1], +m[2], +m[3]); }
        m = t.match(/^(\d{1,2})\.(\d{1,2})\.(\d{4})\s*[\/ ]\s*(\d{1,2}):(\d{2}):(\d{2})$/);
        if (m) { return new Date(+m[3], +m[2]-1, +m[1], +m[4], +m[5], +m[6]); }
        m = t.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})\s+(\d{1,2}):(\d{2}):(\d{2})$/);
        if (m) { return new Date(+m[3], +m[2]-1, +m[1], +m[4], +m[5], +m[6]); }
        var d = new Date(t);
        return isNaN(d.getTime()) ? null : d;
    }

    function aiHumanDur(sec){
        sec = Math.max(0, Math.round(sec));
        if (sec < 60) { return sec + ' s'; }
        if (sec < 3600) { var m1 = Math.floor(sec/60), s1 = sec%60; return m1 + ' min' + (s1 ? (' ' + s1 + ' s') : ''); }
        var h1 = Math.floor(sec/3600), m2 = Math.round((sec%3600)/60);
        return h1 + ' h' + (m2 ? (' ' + m2 + ' min') : '');
    }

    // The first thing a maintainer needs: is this still live, or did it clear?
    function renderAiResolution(v, c){
        var reset = (c && c.resetTime) ? String(c.resetTime).trim() : '';
        if (!reset) {
            return '<div class="rv-res live"><div class="rv-res-ic"></div><div class="rv-res-tx">'
                 + '<b>Still active.</b> No reset recorded &#8212; the condition has not cleared.'
                 + '</div></div>';
        }
        var t0 = aiParseAlertTime(c.time), t1 = aiParseAlertTime(reset), durTxt = '';
        if (t0 && t1 && t1 >= t0) { durTxt = ' after <b class="rv-chip v">' + aiHumanDur((t1 - t0)/1000) + '</b>'; }
        return '<div class="rv-res done"><div class="rv-res-ic"></div><div class="rv-res-tx">'
             + '<b>Already reset.</b> Condition cleared at <b class="rv-chip t">' + escapeHtml(reset) + '</b>' + durTxt
             + ' &#8212; this is a record of what happened, not a live fault.'
             + '</div></div>';
    }

    // Pull "HH:mm:ss" out of the alert-context time formats so the chart can be
    // anchored to real clock times instead of a bare "healthy -> now" axis.
    function aiClock(str){
        if (!str) { return ''; }
        var m = String(str).match(/(\d{1,2}:\d{2}:\d{2})/);
        return m ? m[1] : '';
    }

    // v1.0.52.0: real chart via Chart.js (local lib). Parses the same TR frame, draws a
    // proper time axis (date + time), threshold/healthy-avg reference lines, and ALERT/RESET
    // markers. Falls back to the inline-SVG renderer if Chart.js is not loaded on the server.
    function rvParsePts(TR){
        function rvTs(sv){
            if(sv===null||sv===undefined){ return NaN; }
            var str=String(sv);
            var t=Date.parse(str.replace(/(\d{2}):(\d{2}):(\d{2})\/(\d{2})\.(\d{2})\.(\d{4})/, '$6-$5-$4T$1:$2:$3'));
            if(isNaN(t)){ t=Date.parse(str); }
            if(isNaN(t)&&/^\d{12,}$/.test(str)){ t=Number(str); }
            return t;
        }
        var pts=[];
        for(var i=0;i<TR.points.length;i++){
            var t=rvTs(TR.points[i][0]); var vv=Number(TR.points[i][1]);
            if(!isNaN(t)&&!isNaN(vv)){ pts.push([t,vv]); }
        }
        pts.sort(function(a,b){return a[0]-b[0];});
        pts._ts=rvTs; return pts;
    }
    function rvFmtDT(t){
        var d=new Date(t); function z2(n){return (n<10?'0':'')+n;}
        var mon=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        return z2(d.getDate())+' '+mon[d.getMonth()]+' '+z2(d.getHours())+':'+z2(d.getMinutes());
    }
    var _rvChartSeq=0, _rvCharts={};
    // v1.0.53.0: palette for multi-line series (trigger gets index 0 emphasis colour).
    var RV_PAL=['#4f7bf0','#22b07d','#f0a326','#e5544b','#8b5cf6','#0ea5e9'];
    // v1.0.55.1: STRICT numeric -- null/''/undefined -> NaN (never 0). Number(null)===0 would
    // otherwise paint a phantom 0 threshold/baseline line.
    function rvNumber(v){ if(v===null||v===undefined||v==='') return NaN; var n=Number(v); return isNaN(n)?NaN:n; }
    function rvParseSeries(sarr){
