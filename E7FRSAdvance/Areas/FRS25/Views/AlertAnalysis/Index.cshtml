              + "<rect x='270' y='70' width='90' height='110' rx='8'/><line x1='300' y1='60' x2='330' y2='60'/></g>"
              + "<path d='M318 92 L296 136 L316 136 L306 168 L336 122 L316 122 Z' fill='#fbbf24' fill-opacity='.40'/>";
        } else if(/SIG|ASPECT|HHG|ECR|HPR|HHPR|DPR|COSIG|SHSIG/.test(c)){
            a = "<rect x='188' y='40' width='44' height='120' rx='22' fill='#1f2937' stroke='#94a3b8' stroke-opacity='.25'/>"
              + "<circle cx='210' cy='68' r='13' fill='#ef4444' fill-opacity='.55'/>"
