                    var mx=xa.getPixelForValue(ann[i].x);
                    ctx.strokeStyle=ann[i].color; ctx.setLineDash([4,3]); ctx.lineWidth=1.4;
                    ctx.beginPath(); ctx.moveTo(mx,ar.top); ctx.lineTo(mx,ar.bottom); ctx.stroke();
