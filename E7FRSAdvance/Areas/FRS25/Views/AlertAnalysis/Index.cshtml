              + "<path d='M150 160 L390 92'/></g>"
              + "<g stroke='#a78bfa' stroke-opacity='.40' stroke-width='5'><line x1='150' y1='160' x2='250' y2='132'/></g>"
              + "<circle cx='150' cy='160' r='7' fill='#a78bfa' fill-opacity='.45'/>";
        } else if(/^IPS |IPS /.test(c)){
            a = "<g fill='#f59e0b' fill-opacity='.20'><rect x='60' y='120' width='34' height='60' rx='3'/>"
              + "<rect x='104' y='96' width='34' height='84' rx='3'/><rect x='148' y='140' width='34' height='40' rx='3'/>"
              + "<rect x='192' y='112' width='34' height='68' rx='3'/></g>"
