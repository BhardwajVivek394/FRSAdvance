              + "<circle cx='210' cy='136' r='13' fill='#34d399' fill-opacity='.22'/>"
              + "<rect x='202' y='160' width='16' height='44' fill='#94a3b8' fill-opacity='.22'/>";
        } else if(/CHG|CHARG|BATT|IPS|DC-DC|SUPPLY|DATALOG/.test(c)){
            a = "<g fill='#f59e0b' fill-opacity='.20'><rect x='60' y='120' width='34' height='60' rx='3'/>"
              + "<rect x='104' y='96' width='34' height='84' rx='3'/><rect x='148' y='140' width='34' height='40' rx='3'/>"
              + "<rect x='192' y='112' width='34' height='68' rx='3'/></g>"
              + "<g stroke='#f59e0b' stroke-opacity='.35' stroke-width='3' fill='none'>"
              + "<rect x='270' y='70' width='90' height='110' rx='8'/><line x1='300' y1='60' x2='330' y2='60'/></g>"
              + "<path d='M318 92 L296 136 L316 136 L306 168 L336 122 L316 122 Z' fill='#fbbf24' fill-opacity='.40'/>";
        } else if(/RAIL RES|BALST|BALLAST|SLPR|LEAK|VAR RES|CH RES|CONTACT RES/.test(c)){
            a = "<g stroke='#ef4444' stroke-opacity='.30' stroke-width='3'>"
              + "<line x1='40' y1='150' x2='400' y2='150'/><line x1='40' y1='176' x2='400' y2='176'/></g>"
              + "<g stroke='#94a3b8' stroke-opacity='.22' stroke-width='6'>"
