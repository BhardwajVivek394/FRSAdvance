                svg+='<text x="'+tx.toFixed(1)+'" y="'+ty.toFixed(1)+'" text-anchor="'+ta+'" fill="'+color+'" style="font:700 10.5px ui-monospace,monospace;">'+lbl+'</text>';
            }
