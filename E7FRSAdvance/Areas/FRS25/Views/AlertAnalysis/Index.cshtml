        var dbgBase = (typeof AA_DEBUG_CTRL_BASE !== 'undefined' ? AA_DEBUG_CTRL_BASE : '') || '';
        var url = dbgBase + '/FRS25/AiChat/DryRunTools?siteId=' + encodeURIComponent(siteId || '')
                + '&assetId=' + encodeURIComponent(assetId) + '&days=3&runs=1';
