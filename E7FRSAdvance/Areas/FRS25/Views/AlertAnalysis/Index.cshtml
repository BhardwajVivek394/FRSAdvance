    function renderAiTrendSvg(z, TR){
        try{
            function rvTs(sv){
                if(sv===null||sv===undefined){ return NaN; }
                var str=String(sv);
                // v1.0.48.0: E7 style "HH:mm:ss/dd.MM.yyyy" -> ISO before Date.parse
                var t=Date.parse(str.replace(/(\d{2}):(\d{2}):(\d{2})\/(\d{2})\.(\d{2})\.(\d{4})/, '$6-$5-$4T$1:$2:$3'));
                if(isNaN(t)){ t=Date.parse(str); }
                if(isNaN(t)&&/^\d{12,}$/.test(str)){ t=Number(str); }   // epoch ms as string
                return t;
            }
            var pts=[];
            for(var i=0;i<TR.points.length;i++){
                var t=rvTs(TR.points[i][0]); var vv=Number(TR.points[i][1]);
                if(!isNaN(t)&&!isNaN(vv)){ pts.push([t,vv]); }
            }
            if(pts.length<5){ return ''; }
            pts.sort(function(a,b){return a[0]-b[0];});
            var t0=pts[0][0], t1=pts[pts.length-1][0]; if(t1<=t0){ return ''; }
            var thr=Number(z.threshold), base=Number(z.baseline);
            var hasThr=!isNaN(thr), hasBase=!isNaN(base);
            var lo=Infinity, hi=-Infinity;
            for(var j=0;j<pts.length;j++){ if(pts[j][1]<lo)lo=pts[j][1]; if(pts[j][1]>hi)hi=pts[j][1]; }
            if(hasThr){ lo=Math.min(lo,thr); hi=Math.max(hi,thr); }
            if(hasBase){ lo=Math.min(lo,base); hi=Math.max(hi,base); }
            if(hi===lo){ hi=lo+1; }
            var pad=(hi-lo)*0.14; lo-=pad; hi+=pad;
            var L=56,R=544,T=26,B=168;
            function X(t){ return L+(R-L)*(t-t0)/(t1-t0); }
            function Y(vv){ return B-(B-T)*(vv-lo)/(hi-lo); }
            function hm(t){ var d=new Date(t); function z2(n){return (n<10?'0':'')+n;} return z2(d.getHours())+':'+z2(d.getMinutes()); }
            var path='';
            for(var k=0;k<pts.length;k++){ path+=(k?'L':'M')+X(pts[k][0]).toFixed(1)+' '+Y(pts[k][1]).toFixed(1)+' '; }
            // v1.0.51.0: locate peak / trough / last for value markers
            var iPk=0,iMin=0;
            for(var m=1;m<pts.length;m++){ if(pts[m][1]>pts[iPk][1])iPk=m; if(pts[m][1]<pts[iMin][1])iMin=m; }
            var iLast=pts.length-1;
            var svg='<svg class="rvz-svg" viewBox="0 0 560 200" preserveAspectRatio="none">';
            if(hasThr){ var yt=Y(thr); svg+='<rect x="'+L+'" y="'+T+'" width="'+(R-L)+'" height="'+Math.max(0,(yt-T)).toFixed(1)+'" fill="rgba(220,38,38,.06)"></rect>'; }
            if(hasThr){ var yt2=Y(thr).toFixed(1); svg+='<line class="rvz-ref thr" x1="'+L+'" y1="'+yt2+'" x2="'+R+'" y2="'+yt2+'"></line><text class="rvz-reflbl thr" x="'+(R-4)+'" y="'+(Number(yt2)-5).toFixed(1)+'" text-anchor="end">alert threshold '+escapeHtml(aiVizNum(thr)||'')+'</text>'; }
            if(hasBase){ var yb=Y(base).toFixed(1); svg+='<line class="rvz-ref base" x1="'+L+'" y1="'+yb+'" x2="'+R+'" y2="'+yb+'"></line><text class="rvz-reflbl base" x="'+(L+4)+'" y="'+(Number(yb)-5).toFixed(1)+'">healthy avg '+escapeHtml(aiVizNum(base)||'')+(z.unit?(' '+escapeHtml(z.unit)):'')+'</text>'; }
            svg+='<path d="'+path+'" fill="none" stroke="#5457e6" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" opacity="0.9"></path>';
            // value markers: labelled dots at peak, trough, and last reading
            function vdot(idx,color,anchor){
                var vx=X(pts[idx][0]), vy=Y(pts[idx][1]);
                var lbl=(aiVizNum(pts[idx][1])||'')+(z.unit?(' '+z.unit):'');
                var tx = anchor==='end' ? vx-7 : (anchor==='start' ? vx+7 : vx);
                var ta = anchor==='mid' ? 'middle' : anchor;
                var ty = vy - 8; if(ty < T+10){ ty = vy + 15; }
