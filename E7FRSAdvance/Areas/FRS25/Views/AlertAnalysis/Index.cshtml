    // Called from _List fnShowAlertMessage after the alert record loads.
    // The alert record already carries the numeric ids -- the board could not have

    // rendered the row otherwise. Passing them removes the whole resolution chain:

    // the station is a CODE ("SK") which search_sites cannot match (it matches the

    // NAME, "SAKHUN"), and without a SiteId an asset-name search is ambiguous

    // because names repeat across stations. Observed: 5 failed "Locating asset"

    // calls in one run, then the analysis gave up.

    // Field names vary by source, so check the usual spellings on both the alert

    // record and the parsed card.

    function aiFindNum(src, names){

        if (!src) { return null; }

        for (var i = 0; i < names.length; i++) {

            var v = src[names[i]];

            if (v === undefined || v === null || v === '') { continue; }

            var n = Number(v);

            if (!isNaN(n) && n > 0) { return n; }

        }

        return null;

    }

    function aiAttachIds(ctx, data, card){

        var siteId  = aiFindNum(data, ['SiteId','SiteID','siteId','siteid'])

                   || aiFindNum(card, ['siteId','SiteId','site_id']);

        var assetId = aiFindNum(data, ['AssetId','AssetID','assetId','assetid'])

                   || aiFindNum(card, ['assetId','AssetId','asset_id']);

        if (siteId)  { ctx.siteId = siteId; }

        if (assetId) { ctx.assetId = assetId; }

        return ctx;

    }



