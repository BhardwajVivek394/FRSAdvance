    // v1.0.55.8: EVENT ZOOM -- zoom the shared time axis in/out around the SET->RESET event so the
    // (often seconds-apart) markers and the gap between them are legible. No zoom library (offline
    // servers); steps a discrete set of windows centered on the event and drives Chart.js min/max.
    var RV_ZOOM=[0,86400,21600,3600,900,180,30];      // level 0 = full range; else +/- seconds
    var RV_ZLBL=['Full range','\u00b124h','\u00b16h','\u00b11h','\u00b115m','\u00b13m','\u00b130s'];
