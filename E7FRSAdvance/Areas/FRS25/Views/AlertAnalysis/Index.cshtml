                    ctx.fillText('alert threshold '+(Math.round(C.thr*100)/100)+C.unit, ar.right-4, yt-4);
                }
                if(C.hasBase){
                    var yb=ya.getPixelForValue(C.base);
                    ctx.strokeStyle='#059669'; ctx.setLineDash([5,3]); ctx.lineWidth=1.2;
                    ctx.beginPath(); ctx.moveTo(ar.left,yb); ctx.lineTo(ar.right,yb); ctx.stroke();
                    ctx.setLineDash([]); ctx.fillStyle='#047857'; ctx.font='11px ui-monospace,monospace'; ctx.textAlign='left';
