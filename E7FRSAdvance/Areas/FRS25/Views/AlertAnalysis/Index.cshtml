            svg+='<text class="rvz-ax" x="'+L+'" y="192">'+hm(t0)+'</text><text class="rvz-ax" x="'+((L+R)/2)+'" y="192" text-anchor="middle">'+hm((t0+t1)/2)+'</text><text class="rvz-ax" x="'+R+'" y="192" text-anchor="end">'+hm(t1)+'</text>';
            svg+='</svg>';
