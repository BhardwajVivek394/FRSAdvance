                svg+='<line x1="'+mx+'" y1="'+T+'" x2="'+mx+'" y2="'+B+'" stroke="'+color+'" stroke-width="1.4" stroke-dasharray="4 3"></line>';
                svg+='<text x="'+mx+'" y="'+(T-6)+'" text-anchor="middle" fill="'+color+'" style="font:700 10px ui-monospace,monospace;letter-spacing:.06em;">'+lbl+' '+hm(mt)+'</text>';
            }
