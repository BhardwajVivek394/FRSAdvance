    function rvZoomFull(cid){ var C=_rvCharts[cid]; if(!C){ return; } C._zl=0; rvZoomApply(cid); }
    function rvZoom(cid,dir){ var C=_rvCharts[cid]; if(!C){ return; } var n=(C._zl||0)+dir; if(n<0){ n=0; } if(n>RV_ZOOM.length-1){ n=RV_ZOOM.length-1; } C._zl=n; rvZoomApply(cid); }
