        if(_vr){ if(C._view==='raw'){ _vr.classList.add('on'); } else { _vr.classList.remove('on'); } }
        if(_vs){ if(C._sync!==false){ _vs.classList.add('on'); } else { _vs.classList.remove('on'); } }
        if(zo){ zo.disabled=((C._zl||0)<=0); } if(zi){ zi.disabled=((C._zl||0)>=RV_ZOOM.length-1)||C._evc==null; } if(zf){ zf.disabled=(C._evc==null); }
