                    ctx.fillStyle='rgba(220,38,38,.06)'; ctx.fillRect(ar.left, ar.top, ar.right-ar.left, Math.max(0,yt-ar.top));
                    ctx.strokeStyle='#dc2626'; ctx.setLineDash([5,3]); ctx.lineWidth=1.2;
