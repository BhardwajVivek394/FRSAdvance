                                            // v1.0.55.63: privilege resolved HERE, server-side. The SiteKeepingOverrideEmails list and the
                                            // user's email address must never be emitted into JavaScript -- only this boolean ships. Plain
                                            // loop rather than .Any(): this view has no @using System.Linq.
                                            var __aaLu = E7FRSAdvance.Utility.ClsHttpContent.LoginUser;
                                            var __aaPrivileged = (__aaLu != null && __aaLu.IsSiteKeeping);
                                            if (!__aaPrivileged && __aaLu != null && __aaLu.EmailAddress != null)
                                            {
                                            var __aaEmail = __aaLu.EmailAddress.Trim();
                                            var __aaOverride = (System.Configuration.ConfigurationManager.AppSettings["SiteKeepingOverrideEmails"] ?? "");
                                            if (__aaEmail.Length > 0 && __aaOverride.Length > 0)
                                            {
                                            foreach (var __aaE in __aaOverride.Split(new char[] { ',', ';' }))
                                            {
                                            if (string.Equals(__aaE.Trim(), __aaEmail, System.StringComparison.OrdinalIgnoreCase))
                                            {
                                            __aaPrivileged = true;
                                            break;
                                            }
                                            }
                                            }
                                            }
                                            }

