            else if(C._x0&&C._x1){ ch.options.scales.x.min=C._x0[i]; ch.options.scales.x.max=C._x1[i]; }
            try{ ch.update('none'); }catch(e){} }
        var lb=document.getElementById(cid+'_zlbl'); if(lb){ lb.textContent=RV_ZLBL[C._zl||0]; }
        var zo=document.getElementById(cid+'_zout'), zi=document.getElementById(cid+'_zin'), zf=document.getElementById(cid+'_zfit');
        var zfu=document.getElementById(cid+'_zfull'); if(zfu){ zfu.disabled=((C._zl||0)<=0); }
