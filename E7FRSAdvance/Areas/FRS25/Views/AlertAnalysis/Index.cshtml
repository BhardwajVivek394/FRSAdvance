    // v1.0.55.14 (re-applied from 55.11): AUTO-FOCUS. Opening on Full range made a ~2-minute event
    // a 1px sliver at the edge of a multi-day axis. First render now opens on a CONTEXT window
    // (~20x the SET->RESET span, min +/-15m) so healthy->SET->RESET is visible immediately.
    function rvZoomAuto(cid,applyNow){ var C=_rvCharts[cid]; if(!C){ return; } if(C._zauto){ return; } C._zauto=1;
        C._evc=rvEvCenter(C); if(C._evc==null){ C._zl=0; if(applyNow){ rvZoomApply(cid); } return; }
