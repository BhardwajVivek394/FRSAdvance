                                                .ai-foot-note {
                                                    font-size: 11.5px;
                                                    color: #9aa4b1;
                                                }

                                                .ai-foot-actions {
                                                    display: flex;
                                                    gap: 6px; /* v1.0.53: tighter */
                                                    flex-wrap: nowrap; /* v1.0.53: keep on ONE row */
                                                    align-items: center;
                                                    justify-content: flex-end;
                                                    overflow-x: auto; /* if it truly cannot fit, scroll rather than wrap */
                                                    -ms-overflow-style: none;
                                                    scrollbar-width: none;
                                                }

                                                    .ai-foot-actions::-webkit-scrollbar {
                                                        display: none;
                                                    }
                                                    /* v1.0.55.14: the Tool trace chip pushed the row past the edge (it scrolls, so chips fell out
                                                   of sight). Footer chips only: tighter padding/font so the whole row fits without scrolling. */
                                                    .ai-foot-actions .btn-quiet {
                                                        padding: 4px 9px;
                                                        font-size: 11.5px;
                                                    }

                                                .ai-foot-actions {
                                                    gap: 5px;
                                                }
                                                /* v1.0.51.0: single merged glossy footer -- wisdom actions + diagnostics on one row */
                                                .ai-foot-group {
                                                    display: inline-flex;
                                                    gap: 6px;
                                                }
                                                /* v1.0.53 */
                                                .ai-foot-sep {
                                                    flex: 1 1 auto;
                                                    min-width: 0;
                                                }

                                                .btn-quiet.btn-accent {
                                                    background: linear-gradient(180deg, #2b333f 0%, #1f2732 100%);
                                                    border-color: #171d26;
                                                    color: #fff;
                                                    box-shadow: inset 0 1px 0 rgba(255,255,255,.14), 0 1px 2px rgba(16,24,40,.18), 0 3px 8px rgba(16,24,40,.16);
                                                }

                                                    .btn-quiet.btn-accent:hover {
                                                        background: linear-gradient(180deg, #333c49 0%, #232c37 100%);
                                                        border-color: #171d26;
                                                        color: #fff;
                                                    }

                                                .btn-quiet {
                                                    /* v1.0.50.0: glossy pill; v1.0.53: smaller chips, single-row footer */
                                                    background: linear-gradient(180deg, #ffffff 0%, #f4f6fa 48%, #e9edf4 100%);
                                                    border: 1px solid #d3dae4;
                                                    color: #3f4855;
                                                    border-radius: 8px;
                                                    padding: 5px 11px;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    white-space: nowrap; /* v1.0.53: don't wrap chip text */
                                                    flex: 0 0 auto;
                                                    box-shadow: inset 0 1px 0 rgba(255,255,255,.95), 0 1px 2px rgba(16,24,40,.08), 0 2px 5px rgba(16,24,40,.06);
                                                    transition: transform .12s ease, box-shadow .12s ease;
                                                    cursor: pointer;
                                                }

                                                    .btn-quiet:hover {
                                                        transform: translateY(-1px);
                                                        box-shadow: inset 0 1px 0 rgba(255,255,255,.95), 0 3px 6px rgba(16,24,40,.10), 0 8px 18px rgba(16,24,40,.12);
                                                        border-color: #b9c4d4;
                                                        background: linear-gradient(180deg, #ffffff 0%, #f7f9fc 48%, #eef2f8 100%);
                                                    }

                                                .btn-ai-analyze-lg {
                                                    display: inline-flex;
                                                    align-items: center;
                                                    gap: 8px;
                                                    background: #1b2027;
                                                    border: 1px solid #1b2027;
                                                    color: #fff;
                                                    border-radius: 7px;
                                                    padding: 8px 16px;
                                                    font-size: 13.5px;
                                                    font-weight: 600;
                                                    cursor: pointer;
                                                }

                                                    .btn-ai-analyze-lg::before {
                                                        content: '';
                                                        width: 7px;
                                                        height: 7px;
                                                        border-radius: 50%;
                                                        background: #3ad29f;
                                                        box-shadow: 0 0 6px #3ad29f;
                                                    }

                                                    .btn-ai-analyze-lg:hover {
                                                        background: #12161c;
                                                    }

                                                    .btn-ai-analyze-lg:disabled {
                                                        opacity: .55;
                                                        cursor: default;
                                                    }

                                                /* loading */
                                                .rv-load {
                                                    padding: 24px 20px;
                                                }

                                                .rv-scan {
                                                    height: 3px;
                                                    background: #eef1f5;
                                                    border-radius: 2px;
                                                    overflow: hidden;
                                                    margin-bottom: 20px;
                                                }

                                                    .rv-scan i {
                                                        display: block;
                                                        height: 100%;
                                                        width: 32%;
                                                        background: #8a93a1;
                                                        border-radius: 2px;
                                                        animation: airvscan 1.15s ease-in-out infinite;
                                                    }

                                                @@keyframes airvscan {
                                                    0% {
                                                        transform: translateX(-120%);
                                                    }

                                                    100% {
                                                        transform: translateX(360%);
                                                    }
                                                }

                                                .rv-steps {
                                                    list-style: none;
                                                    margin: 0;
                                                    padding: 0;
                                                    font: 500 12.5px/1 var(--mono);
                                                }

                                                    .rv-steps li {
                                                        display: flex;
                                                        align-items: center;
                                                        gap: 11px;
                                                        padding: 8px 0;
                                                        color: #a3abb6;
                                                    }

                                                        .rv-steps li .mk {
                                                            width: 15px;
                                                            height: 15px;
                                                            border-radius: 50%;
                                                            border: 1.5px solid #cfd6df;
                                                            flex: none;
                                                            display: grid;
                                                            place-items: center;
                                                            font-size: 9px;
                                                            color: #fff;
                                                        }

                                                        .rv-steps li.done {
                                                            color: #39424f;
                                                        }

                                                            .rv-steps li.done .mk {
                                                                background: #1f9d6b;
                                                                border-color: #1f9d6b;
                                                            }

                                                        .rv-steps li.active {
                                                            color: #161a20;
                                                        }

                                                            .rv-steps li.active .mk {
                                                                border-color: #8a93a1;
                                                                animation: airvblink 1s ease-in-out infinite;
                                                            }

                                                @@keyframes airvblink {
                                                    50% {
                                                        opacity: .35;
                                                    }
                                                }

                                                .rv-load-cap {
                                                    margin-top: 18px;
                                                    font-weight: 600;
                                                    font-size: 10.5px;
                                                    letter-spacing: .14em;
                                                    text-transform: uppercase;
                                                    color: #a3abb6;
                                                }

                                                .rv-error {
                                                    margin: 20px;
                                                    padding: 14px;
                                                    background: #fdecef;
                                                    border: 1px solid #f6ccd4;
                                                    border-radius: 8px;
                                                    color: #a3213a;
                                                    font-size: 13px;
                                                }

                                                .rv-raw {
                                                    margin: 18px;
                                                    padding: 14px;
                                                    background: #f6f8fa;
                                                    border: 1px solid #e4e8ee;
                                                    border-radius: 8px;
                                                    white-space: pre-wrap;
                                                    font: 500 12.5px/1.55 var(--mono);
                                                    color: #39424f;
                                                }

                                                /* verdict */
                                                .rv {
                                                    --accent: #6b7482;
                                                    --soft: #eef1f5;
                                                    /* v1.0.50.0: 3D card surface -- layered elevation instead of flat white board */
                                                    background: linear-gradient(180deg, #ffffff 0%, #fafbfd 55%, #f3f6fa 100%);
                                                    border: 1px solid #e6eaf1;
                                                    border-radius: 16px;
                                                    box-shadow: 0 1px 2px rgba(16,24,40,.05), 0 6px 16px rgba(16,24,40,.08), 0 18px 44px rgba(16,24,40,.10);
                                                    position: relative;
                                                    overflow: hidden;
                                                    margin: 4px 2px 10px;
                                                }

                                                    .rv::before {
                                                        content: '';
                                                        position: absolute;
                                                        top: 0;
                                                        left: 0;
                                                        right: 0;
                                                        height: 4px;
                                                        background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 35%, #ffffff));
                                                        opacity: .9;
                                                    }

                                                    .rv[data-state="confirmed"] {
                                                        --accent: #d1435b;
                                                        --soft: #fdecef;
                                                    }

                                                    .rv[data-state="unconfirmed"] {
                                                        --accent: #1f9d6b;
                                                        --soft: #e7f6ef;
                                                    }

                                                    .rv[data-state="analyzing"] {
                                                        --accent: #5457e6;
                                                        --soft: #eef0fe;
                                                    }

                                                    .rv[data-state="inconclusive"] {
                                                        --accent: #d99616;
                                                        --soft: #fdf3e2;
                                                    }

                                                .rv-band {
                                                    background: #1b2027;
                                                    color: #fff;
                                                    display: flex;
                                                    align-items: center;
                                                    gap: 15px;
                                                    padding: 16px 18px;
                                                }

                                                .rv-lamp {
                                                    width: 14px;
                                                    height: 14px;
                                                    border-radius: 50%;
                                                    flex: none;
                                                    background: radial-gradient(circle at 34% 30%, rgba(255,255,255,.9), var(--accent) 62%);
                                                    box-shadow: 0 0 0 3px rgba(255,255,255,.05), 0 0 13px 1px var(--accent);
                                                    animation: airvlampon .5s ease-out;
                                                }

                                                @@keyframes airvlampon {
                                                    from {
                                                        box-shadow: 0 0 0 3px rgba(255,255,255,0), 0 0 0 0 var(--accent);
                                                    }
                                                }

                                                .rv-band-main {
                                                    flex: 1;
                                                    min-width: 0;
                                                }

                                                .rv-verdict {
                                                    font-weight: 800;
                                                    font-size: 16px;
                                                    letter-spacing: .05em;
                                                    text-transform: uppercase;
                                                    color: var(--accent);
                                                    line-height: 1;
                                                }

                                                .rv-headline {
                                                    margin-top: 6px;
                                                    font-size: 13.5px;
                                                    line-height: 1.45;
                                                    color: #c9d1da;
                                                    display: -webkit-box;
                                                    -webkit-line-clamp: 2;
                                                    -webkit-box-orient: vertical;
                                                    overflow: hidden;
                                                }

                                                .rv-gauge {
                                                    text-align: center;
                                                    flex: none;
                                                }

                                                .rv-ring {
                                                    position: relative;
                                                    width: 64px;
                                                    height: 64px;
                                                    border-radius: 50%;
                                                    margin: 0 auto;
                                                    background: conic-gradient(var(--accent) calc(var(--p,0) * 1%), rgba(255,255,255,.13) 0);
                                                    display: grid;
                                                    place-items: center;
                                                }

                                                    .rv-ring::after {
                                                        content: '';
                                                        position: absolute;
                                                        inset: 6px;
                                                        border-radius: 50%;
                                                        background: #1b2027;
                                                    }

                                                .rv-ring-num {
                                                    position: relative;
                                                    z-index: 1;
                                                    font: 700 18px/1 var(--mono);
                                                    color: #fff;
                                                }

                                                    .rv-ring-num span {
                                                        font-size: 10px;
                                                        color: #9aa4b1;
                                                        margin-left: 1px;
                                                    }

                                                .rv-gauge-cap {
                                                    margin-top: 6px;
                                                    font-size: 9.5px;
                                                    letter-spacing: .12em;
                                                    text-transform: uppercase;
                                                    color: #8a93a1;
                                                }

                                                .rv-id {
                                                    display: flex;
                                                    flex-wrap: wrap;
                                                    gap: 4px 22px;
                                                    padding: 13px 18px;
                                                    background: #f6f8fa;
                                                    border-bottom: 1px solid #e4e8ee;
                                                }

                                                .rv-id-k {
                                                    font-size: 9.5px;
                                                    letter-spacing: .12em;
                                                    text-transform: uppercase;
                                                    color: #6b7482;
                                                    margin-bottom: 2px;
                                                }

                                                .rv-id-v {
                                                    font: 500 13px/1.3 var(--mono);
                                                    color: #161a20;
                                                }

                                                .rv-sec {
                                                    padding: 15px 18px;
                                                    border-bottom: 1px solid #e4e8ee;
                                                    box-shadow: inset 0 1px 0 rgba(255,255,255,.85);
                                                    --sec: #64748b; /* v1.0.55.42: per-section accent, defaults to slate */
                                                    --secbg: rgba(100,116,139,.035);
                                                    --secrail: #cbd5e1; /* explicit, not color-mix: that needs Chrome 111+ and an ops
                                                                                  box may be older, where the rail would vanish entirely */
                                                    background: var(--secbg);
                                                }
                                                    /* v1.0.55.42: quiet per-section identity. The washes are 3-5% on white -- enough to tell the
                                                   sections apart at a glance, not enough to compete with the verdict band or the status lamp. */
                                                    .rv-sec.sec-story {
                                                        --sec: #5b6b8c;
                                                        --secbg: rgba(91,107,140,.035);
                                                        --secrail: #c3cbdb;
                                                    }

                                                    .rv-sec.sec-moved {
                                                        --sec: #0f766e;
                                                        --secbg: rgba(15,118,110,.04);
                                                        --secrail: #a8d5cf;
                                                    }

                                                    .rv-sec.sec-assess {
                                                        --sec: #a3661a;
                                                        --secbg: rgba(163,102,26,.045);
                                                        --secrail: #e3c79a;
                                                    }

                                                    .rv-sec.sec-evid {
                                                        --sec: #4c51bf;
                                                        --secbg: rgba(76,81,191,.035);
                                                        --secrail: #bcbee6;
                                                    }

                                                    .rv-sec.sec-hi {
                                                        --sec: #7c3aed;
                                                        --secbg: rgba(124,58,237,.035);
                                                        --secrail: #cdb8f5;
                                                    }
                                                /* v1.0.54.0: RECTANGULAR verdict -- at wide widths lay sections across a 2-col grid so the
                                                   whole verdict is visible at a glance instead of a tall vertical strip. The chart and the
                                                   derived-inputs sections span the full width; the text sections (Assessment / Evidence /
                                                   Mukhya / Caveat) tile two-up. Narrow screens keep the single-column stack. */
                                                @@media (min-width: 900px) {
                                                    .rv {
                                                        display: grid;
                                                        grid-template-columns: 1fr 1fr;
                                                        align-items: start;
                                                    }

                                                        .rv > .rv-sec {
                                                            border-bottom: none;
                                                            border-right: 1px solid rgba(228,232,238,.7);
                                                            border-top: 1px solid rgba(228,232,238,.7);
                                                        }

                                                            .rv > .rv-sec:nth-child(odd) {
                                                                border-right: 1px solid rgba(228,232,238,.7);
                                                            }

                                                            .rv > .rv-sec:nth-child(even) {
                                                                border-right: none;
                                                            }
                                                        /* full-width sections: the chart, the derived-inputs, and anything marked rv-span */
                                                        .rv > .rvz-sec,
                                                        .rv > .di-sec,
                                                        .rv > .rv-span {
                                                            grid-column: 1 / -1;
                                                            border-right: none;
                                                        }
                                                        /* v1.0.55.3: the band (gauge), id row, Hinglish block, resolution/triage and the weather
                                                       slot are NOT tiling text sections -- span them full width so they never leave a blank
                                                       half-column (was: gauge in col 1, col 2 blank; Hindi block mis-oriented). */
                                                        .rv > *:not(.rv-sec) {
                                                            grid-column: 1 / -1;
                                                            border-right: none;
                                                        }
                                                        /* first row shouldn't show a top hairline */
                                                        .rv > .rv-sec:nth-child(1),
                                                        .rv > .rv-sec:nth-child(2) {
                                                            border-top: none;
                                                        }
                                                        /* the accent top edge (::before) must stay across the full grid width */
                                                        .rv::before {
                                                            grid-column: 1 / -1;
                                                        }
                                                }

                                                .rv-sec:last-of-type {
                                                    border-bottom: none;
                                                }

                                                .rv-eyebrow {
                                                    display: flex;
                                                    align-items: center;
                                                    gap: 8px;
                                                    font-weight: 700;
                                                    font-size: 10px;
                                                    letter-spacing: .14em;
                                                    text-transform: uppercase;
                                                    color: #6b7482;
                                                    margin-bottom: 11px;
                                                }

                                                    .rv-eyebrow::before {
                                                        content: '';
                                                        width: 14px;
                                                        height: 2px;
                                                        background: var(--sec, var(--accent));
                                                        border-radius: 1px;
                                                    }

                                                .rv-eyebrow {
                                                    color: var(--sec, #6b7482);
                                                }

                                                    .rv-eyebrow .rv-count {
                                                        margin-left: auto;
                                                        font-family: var(--mono);
                                                        font-size: 11px;
                                                        letter-spacing: 0;
                                                        color: #9aa4b1;
                                                    }

                                                .rv-fields {
                                                    display: grid;
                                                    grid-template-columns: 1fr;
                                                    gap: 12px;
                                                }

                                                .rv-field {
