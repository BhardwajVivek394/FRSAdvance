@model Domain.Login
@{ 
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Energy7</title>
    <link rel="icon" type="image/png" href="~/Areas/FRS25/assets/images/faveicon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/Areas/FRS25/assets/images/brand/e7-icon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/Areas/FRS25/assets/images/brand/e7-icon-192.png" />
    <link rel="apple-touch-icon" href="~/Areas/FRS25/assets/images/brand/e7-icon-180.png" />
    <link href="@Url.Content("~/Areas/FRS25/assets/css/e7-brand.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Areas/FRS25/assets/css/e7-brand.css")).Ticks" rel="stylesheet" />

    <!-- General CSS Files -->
    <link href="~/Areas/FRS25/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" rel="stylesheet">
    <link href="~/Areas/FRS25/assets/css/style.css" rel="stylesheet" />
    <!-- Option C · Signal Room login (fonts + skin). Remove these three lines to roll back. -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="@Url.Content("~/Areas/FRS25/assets/css/e7-login-signalroom.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Areas/FRS25/assets/css/e7-login-signalroom.css")).Ticks" rel="stylesheet" />

    <style>
        /* OTP Verification Styles */
        .otp-input.success {
            border-color: #35d95a !important;
            background-color: rgba(40, 167, 69, 0.1) !important;
        }

        .otp-input.error {
            border-color: #dc3545 !important;
            background-color: rgba(220, 53, 69, 0.1) !important;
        }

        .otp-message {
            font-size: 14px;
            margin-top: 10px;
        }

            .otp-message.success {
                color: #35d95a;
            }

            .otp-message.error {
                color: #dc3545;
            }

        .otp-loader {
            display: none;
            margin-top: 15px;
        }

        .otp-input:disabled {
            opacity: 0.7;
        }
    </style>
</head>
<body class="e7l">
    <div class="login-container d-flex min-vh-100">
        <!-- Left Side - Login Form -->
        <div class="login-left d-flex flex-column align-items-center justify-content-center bg-white p-4 p-lg-5">
            <!-- Logo -->
            <div class="logo-login mb-5">
                <span class="e7l-brand">
                    <span class="e7l-mark e7-brandmark on-light" aria-hidden="true"></span>
                    <span class="e7l-brand-text">
                        <span class="e7l-brand-name e7-wordmark on-light" role="img" aria-label="Energy7">Energy7</span>
                        <span class="e7l-tag">RDPMS · Railway Intelligence</span>
                    </span>
                </span>
            </div>

            <!-- Login Form -->
            <div class="login-form-wrapper">
                <h1 class="login-title mb-2">Welcome back</h1>
                <p class="login-subtitle mb-4">Sign in to the RDPMS workspace. A one-time code will be sent to your registered mobile number.</p>

                @using (Html.BeginForm("Index", "Login", FormMethod.Post, new { @id = "loginForm", @class = "theme-form" }))
                {
                    <div class="form-group">
                        <label for="EmailAddress" class="form-label">Email</label>
                        @Html.TextBoxFor(m => m.EmailAddress, new { @class = "form-control", placeholder = "name@energy7.in", autocomplete = "username" })
                    </div>

                    <div class="form-group">
                        <label for="Password" class="form-label">Password</label>
                        <div class="password-wrapper position-relative">
                            @Html.TextBoxFor(m => m.Password, new { @class = "form-control", type = "password", placeholder = "••••••••••", autocomplete = "current-password" })
                            <span class="password-toggle position-absolute" onclick="togglePassword()">
                                <svg id="eyeIcon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ADADAD" stroke-width="2">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </span>
                        </div>
                    </div>

                    <div class="e7l-row">
                        <label class="e7l-check mb-0" for="rememberMe">
                            <input type="checkbox" id="rememberMe">
                            <span>Keep me signed in for 30 days</span>
                        </label>
                        <a href="@Url.Action("ForgotPassword", "Login", new { area = "FRS25" })" class="e7l-link">Forgot password?</a>
                    </div>

                    <button type="submit" class="btn btn-primary-custom btn-block">Sign in</button>
                }

                <div class="e7l-foot">
                    <span>Authorized personnel only. Access is logged under RDSO/SPN/257/2025.</span>
                    <span>&copy; @DateTime.Now.Year Energy7 · <a href="mailto:care@energy7.in?subject=RDPMS%20access%20request" class="e7l-link">Need access?</a></span>
                </div>
            </div>
        </div>

        <!-- Right Side - OTP Entry -->
        <div class="login-right position-relative d-flex align-items-center justify-content-center" id="loginRight">
            <!-- Background blur layer -->
            <div class="bg-blur-layer">
                <!-- Signal-room line art: OHE masts, catenary and track (decorative) -->
                <svg aria-hidden="true" viewBox="0 0 900 700" preserveAspectRatio="xMidYMid slice">
                    <path d="M620 700V140M620 158h120M620 196h104M718 158l-98 52" fill="none" stroke="rgba(140,172,226,.32)" stroke-width="1.6" />
                    <path d="M440 700V240M440 254h86M440 284h74M510 254l-70 40" fill="none" stroke="rgba(140,172,226,.24)" stroke-width="1.5" />
                    <path d="M810 700V90M810 106h70M810 140h58" fill="none" stroke="rgba(140,172,226,.18)" stroke-width="1.5" />
                    <path d="M-40 330 C 240 390 560 384 940 280" fill="none" stroke="rgba(140,172,226,.28)" stroke-width="1.4" />
                    <path d="M-40 352 C 240 412 560 406 940 302" fill="none" stroke="rgba(140,172,226,.15)" stroke-width="1.3" />
                    <path d="M-40 640h980M-40 662h980" fill="none" stroke="rgba(140,172,226,.16)" stroke-width="1.5" />
                    <path d="M60 640 L0 700M200 640 L170 700M340 640 L330 700M480 640 L490 700M620 640 L650 700M760 640 L810 700" fill="none" stroke="rgba(140,172,226,.10)" stroke-width="1.2" />
                    <circle cx="620" cy="330" r="5" fill="rgba(120,220,170,.85)" />
                    <circle cx="440" cy="368" r="4" fill="rgba(251,191,36,.65)" />
                    <circle cx="810" cy="300" r="4" fill="rgba(140,172,226,.55)" />
                </svg>
            </div>

            <!-- Sample live-event card (decorative, hidden while the OTP card is shown) -->
            <div class="e7l-live" aria-hidden="true">
                <span class="e7l-live-kicker">Live · Sakhun</span>
                <strong>PM-203 · Point Machine</strong>
                <span class="e7l-live-meta">Operation 6.4 s · NR → RV <i class="fa fa-check"></i></span>
            </div>

            <!-- Tagline (hidden while the OTP card is shown) -->
            <div class="e7l-pitch">
                <h2>One workspace for 500+ stations.</h2>
                <p>Live telemetry, predictive alerts and remote diagnostics for signalling assets across Indian Railways.</p>
                <div class="e7l-chips"><span>24×7 telemetry</span><span>Predictive maintenance</span><span>SPN/257 Ver 2.0</span></div>
            </div>

            <!-- OTP Card -->
            <div class="otp-card text-center" id="otpCard">
                <h2 class="otp-title mb-2">Enter code</h2>
                <p class="otp-subtitle mb-4">We sent a code to <a href="#" class="text-white" id="displayMobile">@ViewBag.PhoneNumberMasked</a>.</p>

                <div class="otp-inputs d-flex justify-content-center mb-3">
                    <input type="text" class="otp-input text-center mx-1" maxlength="1" data-index="0">
                    <input type="text" class="otp-input text-center mx-1" maxlength="1" data-index="1">
                    <input type="text" class="otp-input text-center mx-1" maxlength="1" data-index="2">
                    <input type="text" class="otp-input text-center mx-1" maxlength="1" data-index="3">
                </div>

                <!-- OTP Message -->
                <p class="otp-message" id="otpMessage"></p>

                <!-- Loader -->
                <div class="otp-loader" id="otpLoader">
                    <i class="fa fa-spinner fa-spin"></i> Verifying...
                </div>

                <!-- Resend Section -->
                <p class="resend-link mb-0">
                    <span id="timerSection">Resend OTP in <strong id="countdown">@ViewBag.OTPResendDelay</strong>s</span>
                    <a href="javascript:void(0)" class="text-white text-decoration-underline" id="btnResend" style="display:none;" onclick="resendOtp()">Click to resend</a>
                </p>
                <p class="resend-link mt-2">Didn't get a code? <a href="javascript:void(0)" class="text-white text-decoration-underline" id="btnResendLink" style="display:none;" onclick="resendOtp()">Click to resend</a></p>
            </div>
        </div>
    </div>

    <!-- Hidden field for the pre-auth OTP session -->
    <input type="hidden" id="hdnOtpSessionId" value="@ViewBag.OtpSessionId" />

    <!-- Use full jQuery (not slim) for AJAX support -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/Areas/FRS25/assets/js/popper.js"></script>
    <script src="~/Areas/FRS25/assets/js/bootstrap.min.js"></script>

    <script>
        var otpSessionId = '';
        var timerInterval;

        $(document).ready(function () {

            if ('@ViewBag.Error' != "") {
                @*CommonNotify("danger", '@ViewBag.Error');*@

                     alert('@ViewBag.Error');
            }
            // Get OTP session id from hidden field
            otpSessionId = $('#hdnOtpSessionId').val();
            // Check if OTP card should be shown
            var isRedirect = '@ViewBag.IsRedirect';
            if (isRedirect != null && isRedirect != '' && isRedirect != 'False') {
                showOtpCard();
            }

            // OTP Input - Allow only numbers
            $('.otp-input').on('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });

            // OTP Input Auto-focus and Auto-verify
            $('.otp-input').each(function (index) {
                var inputs = $('.otp-input');

                $(this).on('input', function () {
                    // Move to next input
                    if (this.value.length === 1 && index < inputs.length - 1) {
                        inputs.eq(index + 1).focus();
                    }

                    // Check if all 4 digits entered
                    checkAndVerifyOtp();
                });

                $(this).on('keydown', function (e) {
                    // Backspace - move to previous input
                    if (e.key === 'Backspace' && this.value === '' && index > 0) {
                        inputs.eq(index - 1).focus();
                    }
                });

                // Handle paste
                $(this).on('paste', function (e) {
                    e.preventDefault();
                    var pastedData = (e.originalEvent.clipboardData || window.clipboardData).getData('text');
                    pastedData = pastedData.replace(/[^0-9]/g, '').substring(0, 4);

                    if (pastedData.length > 0) {
                        for (var i = 0; i < pastedData.length && i < 4; i++) {
                            inputs.eq(i).val(pastedData[i]);
                        }
                        if (pastedData.length >= 4) {
                            inputs.eq(3).focus();
                            checkAndVerifyOtp();
                        } else {
                            inputs.eq(pastedData.length).focus();
                        }
                    }
                });
            });
        });

        // Check if all 4 digits entered and verify OTP
        function checkAndVerifyOtp() {
            var otp = getOtpValue();

            if (otp.length === 4) {
                verifyOtp(otp);
            }
        }

        // Get OTP value from all inputs
        function getOtpValue() {
            var otp = '';
            $('.otp-input').each(function () {
                otp = otp + $(this).val();
            });
            return otp;
        }

        // Verify OTP via AJAX
        function verifyOtp(otp) {
            // Show loader
            $('#otpLoader').show();
            $('#otpMessage').hide();

            // Disable inputs
            $('.otp-input').prop('disabled', true);

            debugger;
            $.ajax({
                url: '@Url.Action("VerifyOtp", "Login")',
                type: 'POST',
                data: {
                    otpSessionId: otpSessionId,
                    otp: otp
                },
                success: function (response) {
                    $('#otpLoader').hide();
                    debugger;
                    if (response.type == "success") {
                        // Success
                        $('.otp-input').addClass('success').removeClass('error');
                        showOtpMessage(response.message, 'success');
                        // ── Pass password to AI sidebar immediately ──────────
                        if (window.E7AI) {
                            E7AI.setPassword($('#Password').val());
                        }
                        // ─────────────────────────────────────────────────────

                        // Redirect after success
                        setTimeout(function () {
                            window.location.href = response.redirectUrl || '@Url.Action("Index", "Home")';
                        }, 1000);
                    } else {
                        // Error
                        $('.otp-input').addClass('error').removeClass('success');
                        showOtpMessage(response.message, 'error');

                        // Clear inputs and enable
                        setTimeout(function () {
                            clearOtpInputs();
                            $('.otp-input').prop('disabled', false).removeClass('error');
                            $('.otp-input').first().focus();
                        }, 1500);
                    }
                    if (window.E7AI) {
                        E7AI.setApiKey($('#Password').val());
                    }
                },
                error: function () {
                    $('#otpLoader').hide();
                    $('.otp-input').prop('disabled', false);
                    showOtpMessage('Error verifying OTP. Please try again.', 'error');
                }
            });
        }

        // Resend OTP
        function resendOtp() {
            $('#btnResend').hide();
            $('#btnResendLink').hide();
            $('#timerSection').show();

            $.ajax({
                url: '@Url.Action("ResendOtp", "Login")',
                type: 'POST',
                data: { otpSessionId: otpSessionId },
                success: function (response) {
                    if (response.type == "success") {
                        debugger;
                        showOtpMessage(response.message, 'success');
                        clearOtpInputs();
                        $('.otp-input').removeClass('error success');
                        $('.otp-input').first().focus();
                        startTimer('@ViewBag.OTPResendDelay');
                    } else {
                        showOtpMessage(response.message, 'error');
                        $('#btnResend').show();
                        $('#btnResendLink').show();
                        $('#timerSection').hide();
                    }
                },
                error: function () {
                    showOtpMessage('Error resending OTP.', 'error');
                    $('#btnResend').show();
                    $('#btnResendLink').show();
                    $('#timerSection').hide();
                }
            });
        }

        // Clear OTP inputs
        function clearOtpInputs() {
            $('.otp-input').val('');
        }

        // Show OTP message
        function showOtpMessage(message, type) {
            $('#otpMessage')
                .removeClass('success error')
                .addClass(type)
                .text(message)
                .show();
        }

        // Countdown timer
        function startTimer(seconds) {
            $('#countdown').text(seconds);
            $('#timerSection').show();
            $('#btnResend').hide();
            $('#btnResendLink').hide();

            timerInterval = setInterval(function () {
                seconds--;
                $('#countdown').text(seconds);

                if (seconds <= 0) {
                    clearInterval(timerInterval);
                    $('#timerSection').hide();
                    $('#btnResend').show();
                    $('#btnResendLink').show();
                }
            }, 1000);
        }

        // Password Toggle
        function togglePassword() {
            var passwordInput = document.getElementById('Password');
            var eyeIcon = document.getElementById('eyeIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                passwordInput.type = 'password';
                eyeIcon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
            }
        }

        // Show OTP Card
        function showOtpCard() {
            var loginRight = document.getElementById('loginRight');
            var otpCard = document.getElementById('otpCard');

            loginRight.classList.add('blurred');
            otpCard.classList.add('visible');

            // Start countdown timer
            startTimer('@ViewBag.OTPResendDelay');

            // Focus on first OTP input
            setTimeout(function () {
                $('.otp-input').first().focus();
            }, 500);
        }
    </script>
</body>
</html>