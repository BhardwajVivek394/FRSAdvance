@model Domain.Login
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Forgot Password | Energy7</title>
    <link rel="icon" type="image/png" href="~/Areas/FRS25/assets/images/faveicon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/Areas/FRS25/assets/images/brand/e7-icon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="~/Areas/FRS25/assets/images/brand/e7-icon-192.png" />
    <link rel="apple-touch-icon" href="~/Areas/FRS25/assets/images/brand/e7-icon-180.png" />
    <link href="@Url.Content("~/Areas/FRS25/assets/css/e7-brand.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Areas/FRS25/assets/css/e7-brand.css")).Ticks" rel="stylesheet" />

    <link href="~/Areas/FRS25/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css" rel="stylesheet">
    <link href="~/Areas/FRS25/assets/css/style.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link href="@Url.Content("~/Areas/FRS25/assets/css/e7-login-signalroom.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Areas/FRS25/assets/css/e7-login-signalroom.css")).Ticks" rel="stylesheet" />

    <style>
        /* OTP states (same as the login page) */
        .otp-input.success { border-color: #35d95a !important; background-color: rgba(40, 167, 69, 0.1) !important; }
        .otp-input.error { border-color: #dc3545 !important; background-color: rgba(220, 53, 69, 0.1) !important; }
        .otp-input:disabled { opacity: 0.7; }
        .otp-message { font-size: 14px; margin-top: 10px; }
        .otp-message.success { color: #35d95a; }
        .otp-message.error { color: #dc3545; }
        .otp-loader { display: none; margin-top: 15px; }

        /* Forgot-password steps */
        .fp-panel { display: none; }
        .fp-panel.active { display: block; }
        .fp-hidden { display: none !important; }
        .fp-alert-box { display: none; }

        .password-requirements { font-size: 12px; color: #6c757d; margin-top: 6px; }
        .password-requirements .req-item { display: flex; align-items: center; gap: 4px; margin-top: 2px; }
        .password-requirements .req-item.valid { color: #28a745; }
        .password-match-msg { font-size: 12px; margin-top: 4px; display: none; }
        .password-match-msg.match { color: #28a745; }
        .password-match-msg.no-match { color: #dc3545; }
    </style>
</head>
<body class="e7l">
    <div class="login-container d-flex min-vh-100">
        <!-- Left Side - Forgot Password steps -->
        <div class="login-left d-flex flex-column align-items-center justify-content-center bg-white p-4 p-lg-5">
            <!-- Logo -->
            <div class="logo-login mb-5">
                <span class="e7l-brand">
                    <span class="e7l-mark e7-brandmark on-light" aria-hidden="true"></span>
                    <span class="e7l-brand-text">
                        <span class="e7l-brand-name e7-wordmark on-light" role="img" aria-label="Energy7">Energy7</span>
                        <span class="e7l-tag">RDPMS · Railway Intelligence</span>
                    </span>
                </span>
            </div>

            <!-- STEP 1: phone number -->
            <div class="login-form-wrapper fp-panel active" id="panelForgotPhone">
                <h1 class="login-title mb-2">Forgot password?</h1>
                <p class="login-subtitle mb-4">Enter your registered phone number. We'll send an OTP to verify your identity.</p>

                <div class="e7l-alert fp-alert-box" id="fpPhoneAlert" role="alert"><i class="fa" aria-hidden="true"></i><span></span></div>

                <div class="form-group">
                    <label for="fpPhoneNumber" class="form-label">Phone number</label>
                    <input type="text" class="form-control" id="fpPhoneNumber" placeholder="Enter phone number" maxlength="15" inputmode="numeric" autocomplete="tel" />
                </div>

                <button type="button" class="btn btn-primary-custom btn-block" id="btnFpSendOtp" onclick="fpSendOtp()">Send OTP</button>

                <a href="@Url.Action("Index", "Login", new { area = "FRS25" })" class="e7l-link e7l-back"><i class="fa fa-arrow-left" aria-hidden="true"></i>Back to sign in</a>

                <div class="e7l-foot">
                    <span>Authorized personnel only. Access is logged under RDSO/SPN/257/2025.</span>
                    <span>&copy; @DateTime.Now.Year Energy7</span>
                </div>
            </div>

            <!-- STEP 3: set new password (after OTP verified) -->
            <div class="login-form-wrapper fp-panel" id="panelChangePassword">
                <h1 class="login-title mb-2">Set new password</h1>
                <p class="login-subtitle mb-4">Your identity has been verified. Select the account and create a new password.</p>

                <div class="e7l-alert fp-alert-box" id="fpPasswordAlert" role="alert"><i class="fa" aria-hidden="true"></i><span></span></div>

                <div class="form-group">
                    <label for="fpEmailDropdown" class="form-label">Email</label>
                    <select class="form-control" id="fpEmailDropdown">
                        <option value="">Select email</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="fpNewPassword" class="form-label">New password</label>
                    <div class="password-wrapper position-relative">
                        <input type="password" class="form-control" id="fpNewPassword" placeholder="New password" autocomplete="new-password" oninput="validatePasswordRequirements()" />
                        <span class="password-toggle position-absolute" onclick="toggleFpPassword('fpNewPassword', 'fpEyeNew')">
                            <svg id="fpEyeNew" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ADADAD" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </span>
                    </div>
                    <div class="password-requirements" id="passwordRequirements">
                        <div class="req-item invalid" id="reqLength"><span>&#9679;</span> At least 6 characters</div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="fpConfirmPassword" class="form-label">Confirm password</label>
                    <div class="password-wrapper position-relative">
                        <input type="password" class="form-control" id="fpConfirmPassword" placeholder="Confirm password" autocomplete="new-password" oninput="checkPasswordMatch()" />
                        <span class="password-toggle position-absolute" onclick="toggleFpPassword('fpConfirmPassword', 'fpEyeConfirm')">
                            <svg id="fpEyeConfirm" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#ADADAD" stroke-width="2">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                        </span>
                    </div>
                    <p class="password-match-msg" id="passwordMatchMsg"></p>
                </div>

                <button type="button" class="btn btn-primary-custom btn-block" id="btnFpResetPassword" onclick="fpResetPassword()">Save password</button>

                <a href="@Url.Action("Index", "Login", new { area = "FRS25" })" class="e7l-link e7l-back"><i class="fa fa-arrow-left" aria-hidden="true"></i>Back to sign in</a>

                <div class="e7l-foot">
                    <span>Authorized personnel only. Access is logged under RDSO/SPN/257/2025.</span>
                    <span>&copy; @DateTime.Now.Year Energy7</span>
                </div>
            </div>
        </div>

        <!-- Right Side - signal-room panel + OTP card (STEP 2) -->
        <div class="login-right position-relative d-flex align-items-center justify-content-center" id="loginRight">
            <div class="bg-blur-layer">
                <svg aria-hidden="true" viewBox="0 0 900 700" preserveAspectRatio="xMidYMid slice">
                    <path d="M620 700V140M620 158h120M620 196h104M718 158l-98 52" fill="none" stroke="rgba(140,172,226,.32)" stroke-width="1.6" />
                    <path d="M440 700V240M440 254h86M440 284h74M510 254l-70 40" fill="none" stroke="rgba(140,172,226,.24)" stroke-width="1.5" />
                    <path d="M810 700V90M810 106h70M810 140h58" fill="none" stroke="rgba(140,172,226,.18)" stroke-width="1.5" />
                    <path d="M-40 330 C 240 390 560 384 940 280" fill="none" stroke="rgba(140,172,226,.28)" stroke-width="1.4" />
                    <path d="M-40 352 C 240 412 560 406 940 302" fill="none" stroke="rgba(140,172,226,.15)" stroke-width="1.3" />
                    <path d="M-40 640h980M-40 662h980" fill="none" stroke="rgba(140,172,226,.16)" stroke-width="1.5" />
                    <path d="M60 640 L0 700M200 640 L170 700M340 640 L330 700M480 640 L490 700M620 640 L650 700M760 640 L810 700" fill="none" stroke="rgba(140,172,226,.10)" stroke-width="1.2" />
                    <circle cx="620" cy="330" r="5" fill="rgba(120,220,170,.85)" />
                    <circle cx="440" cy="368" r="4" fill="rgba(251,191,36,.65)" />
                    <circle cx="810" cy="300" r="4" fill="rgba(140,172,226,.55)" />
                </svg>
            </div>

            <div class="e7l-live" aria-hidden="true">
                <span class="e7l-live-kicker">Live · Sakhun</span>
                <strong>PM-203 · Point Machine</strong>
                <span class="e7l-live-meta">Operation 6.4 s · NR → RV <i class="fa fa-check"></i></span>
            </div>

            <div class="e7l-pitch">
                <h2>One workspace for 500+ stations.</h2>
                <p>Live telemetry, predictive alerts and remote diagnostics for signalling assets across Indian Railways.</p>
                <div class="e7l-chips"><span>24×7 telemetry</span><span>Predictive maintenance</span><span>SPN/257 Ver 2.0</span></div>
            </div>

            <!-- Forgot Password OTP Card -->
            <div class="otp-card text-center" id="fpOtpCard">
                <h2 class="otp-title mb-2">Verify your identity</h2>
                <p class="otp-subtitle mb-4">We sent a code to <span class="text-white" id="fpDisplayMobile"></span>.</p>

                <div class="otp-inputs d-flex justify-content-center mb-3" id="fpOtpInputs">
                    <input type="text" class="otp-input text-center mx-1" maxlength="1" inputmode="numeric" data-index="0">
                    <input type="text" class="otp-input text-center mx-1" maxlength="1" inputmode="numeric" data-index="1">
                    <input type="text" class="otp-input text-center mx-1" maxlength="1" inputmode="numeric" data-index="2">
                    <input type="text" class="otp-input text-center mx-1" maxlength="1" inputmode="numeric" data-index="3">
                </div>

                <p class="otp-message" id="fpOtpMessage"></p>

                <div class="otp-loader" id="fpOtpLoader">
                    <i class="fa fa-spinner fa-spin"></i> Verifying...
                </div>

                <p class="resend-link mb-0">
                    <span id="fpTimerSection">Resend OTP in <strong id="fpCountdown">60</strong>s</span>
                    <a href="javascript:void(0)" class="text-white text-decoration-underline fp-hidden" id="fpBtnResend" onclick="fpResendOtp()">Click to resend</a>
                </p>
                <p class="resend-link mt-2">Didn't get a code? <a href="javascript:void(0)" class="text-white text-decoration-underline fp-hidden" id="fpBtnResendLink" onclick="fpResendOtp()">Click to resend</a></p>
                <p class="resend-link mt-2"><a href="javascript:void(0)" class="text-white text-decoration-underline" onclick="fpChangeNumber()">Change phone number</a></p>
            </div>
        </div>
    </div>

    <!-- Hidden fields -->
    <input type="hidden" id="fpHdnPhoneNumber" value="" />
    <input type="hidden" id="fpHdnResetToken" value="" />

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/Areas/FRS25/assets/js/popper.js"></script>
    <script src="~/Areas/FRS25/assets/js/bootstrap.min.js"></script>

    <script>
        // Forgot-password flow ported from 616 (FRS25 Login/Index):
        //   1) phone  -> ForgotPasswordSendOtp
        //   2) OTP    -> ForgotPasswordVerifyOtp (returns ResetToken + Emails)
        //   3) email + new password -> ResetPassword
        var fpTimerInterval;
        var fpOtpResendDelay = 60;
        var fpOtpSel = '#fpOtpInputs .otp-input';
        var loginUrl = '@Url.Action("Index", "Login", new { area = "FRS25" })';

        $(document).ready(function () {
            $(document).on('input', '.otp-input', function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });
            $('#fpPhoneNumber').on('input', function () {
                this.value = this.value.replace(/[^0-9]/g, '');
            });
            $('#fpPhoneNumber').on('keydown', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); fpSendOtp(); }
            });
            initOtpInputBehavior(fpOtpSel, fpCheckAndVerifyOtp);
            $('#fpPhoneNumber').focus();
        });

        // ---- OTP input auto-focus + paste ----
        function initOtpInputBehavior(selector, verifyCallback) {
            $(selector).each(function (index) {
                var inputs = $(selector);
                $(this).on('input', function () {
                    if (this.value.length === 1 && index < inputs.length - 1) {
                        inputs.eq(index + 1).focus();
                    }
                    verifyCallback();
                });
                $(this).on('keydown', function (e) {
                    if (e.key === 'Backspace' && this.value === '' && index > 0) {
                        inputs.eq(index - 1).focus();
                    }
                });
                $(this).on('paste', function (e) {
                    e.preventDefault();
                    var pastedData = (e.originalEvent.clipboardData || window.clipboardData).getData('text');
                    pastedData = pastedData.replace(/[^0-9]/g, '').substring(0, 4);
                    if (pastedData.length > 0) {
                        for (var i = 0; i < pastedData.length && i < 4; i++) {
                            inputs.eq(i).val(pastedData[i]);
                        }
                        if (pastedData.length >= 4) {
                            inputs.eq(3).focus();
                            verifyCallback();
                        } else {
                            inputs.eq(pastedData.length).focus();
                        }
                    }
                });
            });
        }

        function getOtpValue(selector) {
            var otp = '';
            $(selector).each(function () { otp = otp + $(this).val(); });
            return otp;
        }

        function clearOtpInputs(selector) { $(selector).val(''); }

        // ---- Alerts (617 e7l-alert style) ----
        function showFpAlert(elementId, message, type) {
            var $a = $('#' + elementId);
            $a.removeClass('is-ok is-bad').addClass(type === 'success' ? 'is-ok' : 'is-bad');
            $a.find('i').attr('class', 'fa ' + (type === 'success' ? 'fa-circle-check' : 'fa-circle-exclamation'));
            $a.find('span').text(message || '');
            $a.css('display', 'flex');
        }

        function hideFpAlert(elementId) {
            var $a = $('#' + elementId);
            $a.hide();
            $a.find('span').text('');
        }

        // ---- Panels ----
        function showPhonePanel() {
            hideFpOtpCard();
            $('.fp-panel').removeClass('active');
            $('#panelForgotPhone').addClass('active');
        }

        function hideFpOtpCard() {
            $('#fpOtpCard').removeClass('visible');
            $('#loginRight').removeClass('blurred');
            clearInterval(fpTimerInterval);
        }

        function fpChangeNumber() {
            showPhonePanel();
            $('#fpHdnPhoneNumber').val('');
            hideFpAlert('fpPhoneAlert');
            $('#fpPhoneNumber').focus();
        }

        function showChangePasswordPanel(emails) {
            hideFpOtpCard();
            $('.fp-panel').removeClass('active');
            $('#panelChangePassword').addClass('active');

            var $dropdown = $('#fpEmailDropdown');
            $dropdown.html('<option value="">Select email</option>');
            if (emails && emails.length > 0) {
                for (var i = 0; i < emails.length; i++) {
                    $dropdown.append($('<option></option>').val(emails[i]).text(emails[i]));
                }
                if (emails.length === 1) {
                    $dropdown.val(emails[0]);
                }
            }

            $('#fpNewPassword').val('');
            $('#fpConfirmPassword').val('');
            hideFpAlert('fpPasswordAlert');
            $('#passwordMatchMsg').text('').hide();
            $('#reqLength').removeClass('valid').addClass('invalid');
            $dropdown.focus();
        }

        // ---- STEP 1: send OTP ----
        function fpSendOtp() {
            var phone = $.trim($('#fpPhoneNumber').val());
            if (!phone) {
                showFpAlert('fpPhoneAlert', 'Please enter your phone number.', 'error');
                return;
            }
            if (phone.length < 10) {
                showFpAlert('fpPhoneAlert', 'Please enter a valid phone number.', 'error');
                return;
            }
            hideFpAlert('fpPhoneAlert');

            var $btn = $('#btnFpSendOtp');
            $btn.prop('disabled', true).text('Sending…');

            $.ajax({
                url: '@Url.Action("ForgotPasswordSendOtp", "Login", new { area = "FRS25" })',
                type: 'POST',
                data: { phoneNumber: phone },
                success: function (response) {
                    $btn.prop('disabled', false).text('Send OTP');
                    if (response.type === 'success') {
                        var confirmedPhone = response.phoneNumber || phone;
                        $('#fpHdnPhoneNumber').val(confirmedPhone);
                        $('#fpDisplayMobile').text(maskPhoneNumber(confirmedPhone));
                        showFpOtpCard();
                        showFpAlert('fpPhoneAlert', 'OTP sent to your phone number.', 'success');
                    } else {
                        showFpAlert('fpPhoneAlert', response.message, 'error');
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).text('Send OTP');
                    showFpAlert('fpPhoneAlert', 'Something went wrong. Please try again.', 'error');
                }
            });
        }

        function maskPhoneNumber(phone) {
            if (!phone || phone.length < 4) return phone;
            return '******' + phone.slice(-4);
        }

        function showFpOtpCard() {
            $('#loginRight').addClass('blurred');
            $('#fpOtpCard').addClass('visible');
            clearOtpInputs(fpOtpSel);
            $(fpOtpSel).removeClass('error success').prop('disabled', false);
            $('#fpOtpMessage').hide();
            fpStartTimer(fpOtpResendDelay);
            setTimeout(function () { $(fpOtpSel).first().focus(); }, 500);
        }

        // ---- STEP 2: verify OTP ----
        function fpCheckAndVerifyOtp() {
            var otp = getOtpValue(fpOtpSel);
            if (otp.length === 4) {
                fpVerifyOtp(otp);
            }
        }

        function fpVerifyOtp(otp) {
            $('#fpOtpLoader').show();
            $('#fpOtpMessage').hide();
            $(fpOtpSel).prop('disabled', true);

            $.ajax({
                url: '@Url.Action("ForgotPasswordVerifyOtp", "Login", new { area = "FRS25" })',
                type: 'POST',
                data: { mobileNumber: $('#fpHdnPhoneNumber').val(), otp: otp },
                success: function (response) {
                    $('#fpOtpLoader').hide();
                    if (response.Success) {
                        $(fpOtpSel).addClass('success').removeClass('error');
                        showFpOtpMessage(response.Message || 'Verified successfully!', 'success');
                        $('#fpHdnResetToken').val(response.ResetToken);
                        setTimeout(function () { showChangePasswordPanel(response.Emails); }, 1000);
                    } else {
                        $(fpOtpSel).addClass('error').removeClass('success');
                        showFpOtpMessage(response.Message || 'Invalid OTP.', 'error');
                        setTimeout(function () {
                            clearOtpInputs(fpOtpSel);
                            $(fpOtpSel).prop('disabled', false).removeClass('error');
                            $(fpOtpSel).first().focus();
                        }, 1500);
                    }
                },
                error: function () {
                    $('#fpOtpLoader').hide();
                    $(fpOtpSel).prop('disabled', false);
                    showFpOtpMessage('Error verifying OTP. Please try again.', 'error');
                }
            });
        }

        function showFpOtpMessage(message, type) {
            $('#fpOtpMessage').removeClass('success error').addClass(type).text(message).show();
        }

        function fpResendOtp() {
            $('#fpBtnResend').addClass('fp-hidden');
            $('#fpBtnResendLink').addClass('fp-hidden');
            $('#fpTimerSection').removeClass('fp-hidden');

            $.ajax({
                url: '@Url.Action("ForgotPasswordResendOtp", "Login", new { area = "FRS25" })',
                type: 'POST',
                data: { mobileNumber: $('#fpHdnPhoneNumber').val() },
                success: function (response) {
                    if (response.type === 'success') {
                        showFpOtpMessage('OTP sent successfully.', 'success');
                        clearOtpInputs(fpOtpSel);
                        $(fpOtpSel).removeClass('error success').prop('disabled', false);
                        $(fpOtpSel).first().focus();
                        fpStartTimer(fpOtpResendDelay);
                    } else {
                        showFpOtpMessage(response.message, 'error');
                        $('#fpBtnResend').removeClass('fp-hidden');
                        $('#fpBtnResendLink').removeClass('fp-hidden');
                        $('#fpTimerSection').addClass('fp-hidden');
                    }
                },
                error: function () {
                    showFpOtpMessage('Error resending OTP.', 'error');
                    $('#fpBtnResend').removeClass('fp-hidden');
                    $('#fpBtnResendLink').removeClass('fp-hidden');
                    $('#fpTimerSection').addClass('fp-hidden');
                }
            });
        }

        function fpStartTimer(seconds) {
            clearInterval(fpTimerInterval);
            $('#fpCountdown').text(seconds);
            $('#fpTimerSection').removeClass('fp-hidden');
            $('#fpBtnResend').addClass('fp-hidden');
            $('#fpBtnResendLink').addClass('fp-hidden');

            fpTimerInterval = setInterval(function () {
                seconds--;
                $('#fpCountdown').text(seconds);
                if (seconds <= 0) {
                    clearInterval(fpTimerInterval);
                    $('#fpTimerSection').addClass('fp-hidden');
                    $('#fpBtnResend').removeClass('fp-hidden');
                    $('#fpBtnResendLink').removeClass('fp-hidden');
                }
            }, 1000);
        }

        // ---- STEP 3: reset password ----
        function fpResetPassword() {
            var selectedEmail = $('#fpEmailDropdown').val();
            var newPwd = $('#fpNewPassword').val();
            var confirmPwd = $('#fpConfirmPassword').val();

            hideFpAlert('fpPasswordAlert');

            if (!selectedEmail) {
                showFpAlert('fpPasswordAlert', 'Please select an email address.', 'error');
                return;
            }
            if (!newPwd || !confirmPwd) {
                showFpAlert('fpPasswordAlert', 'Please fill in both password fields.', 'error');
                return;
            }
            if (newPwd.length < 6) {
                showFpAlert('fpPasswordAlert', 'Password must be at least 6 characters.', 'error');
                return;
            }
            if (newPwd !== confirmPwd) {
                showFpAlert('fpPasswordAlert', 'Passwords do not match.', 'error');
                return;
            }

            var $btn = $('#btnFpResetPassword');
            $btn.prop('disabled', true).text('Saving…');

            $.ajax({
                url: '@Url.Action("ResetPassword", "Login", new { area = "FRS25" })',
                type: 'POST',
                data: {
                    emailAddress: selectedEmail,
                    newPassword: newPwd,
                    confirmPassword: confirmPwd,
                    resetToken: $('#fpHdnResetToken').val(),
                    phoneNumber: $('#fpHdnPhoneNumber').val()
                },
                success: function (response) {
                    if (response.type === 'success') {
                        showFpAlert('fpPasswordAlert', (response.message || 'Password changed successfully!') + ' Redirecting to sign in…', 'success');
                        setTimeout(function () { window.location.href = loginUrl; }, 1800);
                    } else {
                        $btn.prop('disabled', false).text('Save password');
                        showFpAlert('fpPasswordAlert', response.message, 'error');
                    }
                },
                error: function () {
                    $btn.prop('disabled', false).text('Save password');
                    showFpAlert('fpPasswordAlert', 'Something went wrong. Please try again.', 'error');
                }
            });
        }

        // ---- Password helpers ----
        function validatePasswordRequirements() {
            var pwd = $('#fpNewPassword').val();
            $('#reqLength').toggleClass('valid', pwd.length >= 6).toggleClass('invalid', pwd.length < 6);
            checkPasswordMatch();
        }

        function checkPasswordMatch() {
            var newPwd = $('#fpNewPassword').val();
            var confirmPwd = $('#fpConfirmPassword').val();
            var $msg = $('#passwordMatchMsg');
            if (!confirmPwd) { $msg.text('').hide(); return; }
            if (newPwd === confirmPwd) {
                $msg.text('Passwords match').removeClass('no-match').addClass('match').show();
            } else {
                $msg.text('Passwords do not match').removeClass('match').addClass('no-match').show();
            }
        }

        function toggleFpPassword(inputId, iconId) {
            var input = document.getElementById(inputId);
            var icon = document.getElementById(iconId);
            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path><line x1="1" y1="1" x2="23" y2="23"></line>';
            } else {
                input.type = 'password';
                icon.innerHTML = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
            }
        }
    </script>
