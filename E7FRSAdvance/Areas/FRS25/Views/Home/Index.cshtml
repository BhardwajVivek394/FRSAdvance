// ==================== DROPDOWN FUNCTIONS ====================
function toggleDD(id, btn) {
  if (openDropdown === id) { closeDD(); return; }
  closeDD();
  var $dd = $('#' + id);
  $dd.addClass('open');
  $dd.closest('.filter-item').addClass('dd-open');
  $(btn).addClass('active');
  $('#backdrop').css('display', 'block');
  openDropdown = id;
}
function closeDD() {
  if (openDropdown) {
    $('#' + openDropdown).removeClass('open').find('.dropdown-search input').val('');
    $('#' + openDropdown).find('.dropdown-item').removeClass('hidden');
    $('#' + openDropdown).find('.dropdown-no-results').removeClass('show');
    $('.filter-item').removeClass('dd-open');
    $('.select-btn').removeClass('active');
    $('#backdrop').css('display', 'none');
    openDropdown = null;
  }
}
function filterDropdown(type, val) {
  var $dd=$('#dd'+capitalize(type)), search=val.toLowerCase().trim(), visible=0;
  $dd.find('.dropdown-item').each(function(){
    var txt=( $(this).data('text')||$(this).find('span').text() ).toLowerCase();
      if (!search || txt.indexOf(search) > -1) { $(this).removeClass('hidden'); visible++; } else { $(this).addClass('hidden') };
  });
  $dd.find('.dropdown-no-results').toggleClass('show', visible===0&&!!search);
}
function selectAll(type, checked) {
  $('.cb-'+type).each(function(){var $it=$(this).closest('.dropdown-item');if(!$it.hasClass('hidden')){$(this).prop('checked',checked);$it.toggleClass('checked',checked);}});
  updateText(type); onFilterChange(type);
}
function updateSelectAllState(type) {
  var $list=$('#list'+capitalize(type)), total=$list.find('.dropdown-item').length, checked=$list.find('.cb-'+type+':checked').length;
  $('#chkAll'+capitalize(type)).prop('checked',total>0&&total===checked);
}
function updateText(type) {
  var $chk=$('.cb-'+type+':checked'), txt=type==='zone'?'Zone':type==='division'?'Division':'Station';
  if($chk.length===1)    txt=$chk.first().closest('.dropdown-item').data('text')||$chk.first().closest('.dropdown-item').find('span').text();
  else if($chk.length>1) txt=$chk.length+' selected';
  $('#txt'+capitalize(type)).text(txt);
}
function getValues(type){var v=[];$('.cb-'+type+':checked').each(function(){v.push($(this).val());});return v;}
function capitalize(s){return s.charAt(0).toUpperCase()+s.slice(1);}
function onFilterChange(type){if(type==='zone')loadDivisions();else if(type==='division')loadSites();}

function loadDivisions() {
  var zIds=getValues('zone');
  $('#listDivision').html('<div class="dropdown-empty">Loading…</div>'); $('#chkAllDivision').prop('checked',false); $('#txtDivision').text('Division');
  $('#listSite').html('<div class="dropdown-empty">Select Division first</div>'); $('#chkAllSite').prop('checked',false); $('#txtSite').text('Station');
  if(!zIds.length){$('#listDivision').html('<div class="dropdown-empty">Select Zone first</div>');return;}
  var key=zIds.slice().sort().join(',');
  fetchDivisionsByZone(zIds).done(function(data){
      if(getValues('zone').slice().sort().join(',')!==key) return;   // zone changed while loading
      if(data&&data.length){var h='';data.forEach(function(d){h+='<div class="dropdown-item" data-value="'+d.Id+'" data-text="'+d.Name+'"><input type="checkbox" class="cb-division" value="'+d.Id+'"><span>'+d.Name+'</span></div>';});$('#listDivision').html(h);}
      else $('#listDivision').html('<div class="dropdown-empty">No divisions found</div>');
  });
}
// One GetDivisionByZoneId request per zone selection, shared by the Division dropdown
// (loadDivisions) and the card/popup station scope (resolveZoneSites) — they used to
// fire the same request back to back on every zone change.
var _divByZoneReq = { key: null, xhr: null };
function fetchDivisionsByZone(zIds){
  var key=zIds.slice().sort().join(',');
  if(_divByZoneReq.key===key && _divByZoneReq.xhr) return _divByZoneReq.xhr;
  var xhr=$.ajax({ url:'/FRS25/Home/GetDivisionByZoneId', type:'POST', contentType:'application/json', data:JSON.stringify({SearchCriteria:{ZoneIds:zIds}}) });
  xhr.fail(function(){ if(_divByZoneReq.xhr===xhr) _divByZoneReq={ key:null, xhr:null }; });   // allow a retry
  _divByZoneReq={ key:key, xhr:xhr };
  return xhr;
}
function loadSites() {
  var dIds=getValues('division');
  $('#listSite').html('<div class="dropdown-empty">Loading…</div>'); $('#chkAllSite').prop('checked',false); $('#txtSite').text('Station');
