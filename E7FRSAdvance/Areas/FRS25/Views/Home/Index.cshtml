        height: 7px;
        border-radius: 50%;
        display: inline-block;
    }

        .shm-ad.grn {
            background: var(--green);
        }

        .shm-ad.red {
            background: var(--red);
        }

        .shm-ad.grey {
            background: var(--text-muted);
        }

    .shm-info-icon {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--glass-4);
        color: var(--text-secondary);
        font-size: 10px;
        font-weight: 700;
        cursor: help;
    }

        .shm-info-icon:hover {
            background: var(--blue-dim);
            color: var(--brand);
        }

    .shm-tooltip {
