        }

    .shm-search {
        margin-left: auto;
        min-width: 190px;
    }

        .shm-search input {
            width: 100%;
            font-family: inherit;
            font-size: 12.5px;
            padding: 6px 10px;
            border: 1px solid var(--border);
            border-radius: var(--radius-sm);
            background: var(--glass-1);
            color: var(--text-primary);
            outline: none;
        }

            .shm-search input:focus {
                border-color: var(--blue);
            }

    .shm-btn-refresh {
        font-family: inherit;
        font-size: 12px;
        font-weight: 600;
        padding: 7px 14px;
        border-radius: var(--radius-sm);
        border: 1px solid var(--border);
        background: var(--glass-1);
        color: var(--text-secondary);
        cursor: pointer;
        transition: var(--transition);
    }

        .shm-btn-refresh:hover {
            background: var(--glass-3);
            color: var(--text-primary);
        }

    .shm-empty {
        text-align: center;
        color: var(--text-muted);
        padding: 40px 16px;
    }

    .shm-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
        gap: 14px;
    }

    .shm-card {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-left: 3px solid var(--green);
        border-radius: var(--radius-lg);
        box-shadow: var(--glass-inset);
        padding: 14px 16px;
    }

        .shm-card.shm-off {
            border-left-color: var(--red);
        }

        .shm-card.shm-deg {
            border-left-color: var(--amber);
        }

    .shm-c-top {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

    .shm-c-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex-shrink: 0;
    }

        .shm-c-dot.grn {
            background: var(--green);
        }

        .shm-c-dot.red {
            background: var(--red);
        }

        .shm-c-dot.amb {
            background: var(--amber);
        }

    .shm-c-name {
        font-weight: 600;
        font-size: 13px;
        color: var(--text-primary);
    }

    .shm-c-offline {
        margin-left: auto;
        font-family: inherit;
        font-size: 10.5px;
        font-weight: 700;
        color: var(--red);
        background: var(--red-dim);
        border: 1px solid color-mix(in srgb, var(--e7-red, #fb7185) 35%, transparent);
        padding: 3px 9px;
        border-radius: 999px;
        cursor: pointer;
        transition: var(--transition);
    }

        .shm-c-offline:hover {
            background: var(--red);
            color: var(--e7-surface, #0b1220);
        }

    /* Mixed cluster (some down, some up / masked) — amber instead of red, as in 616. */
    .shm-c-offline.shm-c-mixed {
        color: var(--amber);
        background: var(--amber-dim);
        border-color: color-mix(in srgb, var(--amber) 35%, transparent);
    }

        .shm-c-offline.shm-c-mixed:hover {
            background: var(--amber);
            color: var(--e7-surface, #0b1220);
        }

    .shm-c-ok-badge {
        margin-left: auto;
        font-size: 10.5px;
        font-weight: 700;
        color: var(--green);
        background: var(--green-dim);
        padding: 3px 9px;
        border-radius: 999px;
    }

    .shm-c-mac {
        font-size: 12px;
        color: var(--text-secondary);
        margin-bottom: 4px;
    }

        .shm-c-mac.shm-c-muted {
            font-style: italic;
            margin-bottom: 10px;
        }

    .shm-c-mac-id {
        font-weight: 600;
        color: var(--text-primary);
    }

    .shm-lane {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
    }

        .shm-lane:last-of-type {
