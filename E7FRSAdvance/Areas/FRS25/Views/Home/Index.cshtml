        sitesToShow.forEach(function (site) { $tab.append('<li class="nav-item" role="presentation"><button class="nav-link border-0" id="btn-site-tab-' + site.value + '" data-site-id="' + site.value + '" type="button" role="tab">' + escapeHtml(site.text) + '</button></li>'); });
        activeTabSiteId = null;
        $tab.off('click', '.nav-link').on('click', '.nav-link', function () {
            $tab.find('.nav-link').removeClass('active'); $(this).addClass('active');
            var sid = $(this).data('site-id'); activeTabSiteId = sid ? sid.toString() : null; fnBindAssetAndAlertCount();
