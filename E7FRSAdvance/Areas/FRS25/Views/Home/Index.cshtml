            success: function (resp) { renderAlertModal(resp); },
            error: function (xhr) { $('#alertModalBody').html('<div class="alert-modal-empty"><i class="fas fa-exclamation-triangle" style="font-size:28px;color:var(--red);margin-bottom:8px;"></i><br>Failed to load alerts (HTTP ' + xhr.status + ').</div>'); }
        });
    }

    function renderAlertModal(resp) {
        var items = [];
        if (Array.isArray(resp)) items = resp;
        else if (resp) {
            var raw = resp.mFRSAlerts || resp.MFRSAlerts || resp.fRSAlerts || resp.FRSAlerts || resp.Alerts || resp.alerts || resp.Record || resp.Data || [];
            if (typeof raw === 'string') { try { raw = JSON.parse(raw); } catch (e) { raw = []; } }
            items = Array.isArray(raw) ? raw : [];
        }
        items = items.map(function (it) {
            return {
                AlertTypeId: it.AlertTypeId || it.alertTypeId || 0, AssetId: it.AssetId || it.assetId || 0,
                AssetName: it.AssetName || it.assetName || it.StationName || it.stationName || it.Name || it.name || '',
                AlertDate: it.SetTimeStamp || it.AlertDate || it.alertDate || it.CreatedDate || it.createdDate || it.Date || it.date || '',
                CauseCode: it.CauseCode || it.causeCode || it.AlertCode || it.alertCode || '',
                AlertMessage: it.AlertMessage || it.alertMessage || it.Message || it.message || it.Description || it.description || '',
                AlertTimestamp: it.SetTimeStamp || it.AlertDate || it.alertDate || it.CreatedDate || '',
                SetAlertMessage: it.setAlertMessage || it.SetAlertMessage || it.AlertMessage || it.alertMessage || it.Message || it.message || ''
            };
        });
        var predCount = 0, failCount = 0;
        items.forEach(function (it) {
            if (String(it.AlertTypeId) === String(alertPredictive)) predCount++;
            if (String(it.AlertTypeId) === String(alertFail)) failCount++;
        });
        $('#alertBadgeTotal').text(predCount + failCount); $('#alertBadgePred').text(predCount); $('#alertBadgeFail').text(failCount);
        if (!items.length) { $('#alertModalBody').html('<div class="alert-modal-empty"><i class="fas fa-check-circle" style="font-size:32px;color:var(--green);margin-bottom:8px;"></i><br>No active alerts found.</div>'); return; }
        var groups = {}, groupOrder = [];
        items.forEach(function (it) {
            var label = 'Date: --';
            var d = parseDotNetDate(it.AlertDate);
            if (d) label = 'Date: ' + pad(d.getDate()) + '-' + pad(d.getMonth() + 1) + '-' + d.getFullYear();
            if (!groups[label]) { groups[label] = []; groupOrder.push(label); }
            groups[label].push(it);
        });
        var html = '';
        groupOrder.forEach(function (dateLabel) {
            html += '<div class="alert-date-label">' + dateLabel + '</div>';
            groups[dateLabel].forEach(function (it, idx) {
                var isPred = String(it.AlertTypeId) === String(alertPredictive);
                var typeCls = isPred ? 'predictive' : 'failure', typeText = isPred ? 'Predictive' : 'Failure';
                var uid = 'ali' + idx + '_' + String(Date.now()).slice(-6);
                var timeStr = '', tsStr = '';
                var dt = parseDotNetDate(it.AlertDate);
                if (dt) timeStr = pad(dt.getDate()) + '-' + pad(dt.getMonth() + 1) + '-' + dt.getFullYear() + ' ' + pad(dt.getHours()) + ':' + pad(dt.getMinutes());
                var ts = parseDotNetDate(it.AlertTimestamp);
                if (ts) tsStr = pad(ts.getDate()) + '-' + pad(ts.getMonth() + 1) + '-' + ts.getFullYear() + ' ' + pad(ts.getHours()) + ':' + pad(ts.getMinutes()) + ':' + pad(ts.getSeconds());
                var alertMsg = it.SetAlertMessage || it.AlertMessage;
                var shortMsg = alertMsg && alertMsg.length > 140 ? alertMsg.substring(0, 140) + '…' : alertMsg;
                var hasMore = alertMsg && alertMsg.length > 140;
                html += '<div class="alert-item" id="' + uid + '">';
                html += '<div class="alert-item-header" onclick="toggleAlertItem(\'' + uid + '\')">';
                html += '<div><div class="alert-item-name"><i class="fas fa-microchip" style="color:var(--blue);font-size:11px;margin-right:6px;"></i>' + (it.AssetName || 'Asset ' + it.AssetId) + '</div>';
                // Sensor/Asset ID line removed from the dashboard popup (matches 616).
                html += '</div>';
                html += '<span class="alert-item-right"><span class="alert-type-badge ' + typeCls + '">' + typeText + '</span><i class="fas fa-chevron-down alert-chevron"></i></span></div>';
                html += '<div class="alert-item-detail"><div class="alert-detail-grid">';
                if (it.CauseCode) html += '<div class="alert-detail-card"><div class="detail-label"><i class="fas fa-code" style="margin-right:4px;"></i>Cause Code</div><div class="detail-value">' + it.CauseCode + '</div></div>';
                html += '<div class="alert-detail-card"><div class="detail-label"><i class="fas fa-clock" style="margin-right:4px;"></i>Timestamp</div><div class="detail-value">' + (tsStr || timeStr || '—') + '</div></div>';
                if (alertMsg) {
                    html += '<div class="alert-detail-card full-width"><div class="detail-label"><i class="fas fa-bell" style="margin-right:4px;"></i>Alert Message</div><div class="detail-value">';
                    html += '<span class="alert-msg-short">' + shortMsg + '</span><span class="alert-msg-full">' + alertMsg + '</span>';
                    if (hasMore) html += '<br/><button class="alert-read-more" onclick="toggleReadMore(event,\'' + uid + '\')">Read More <i class="fas fa-chevron-down" style="font-size:9px;"></i></button>';
                    html += '</div></div>';
                }
                html += '</div></div></div>';
            });
        });
        $('#alertModalBody').html(html);
        filterAlertItems(_activeAlertFilter);
    }

    var _activeAlertFilter = 'all';
    function filterAlertItems(type) {
        _activeAlertFilter = type;
        var activeCls = type === 'predictive' ? 'badge-pred' : type === 'failure' ? 'badge-fail' : 'badge-total';
        $('.alert-badge').addClass('dimmed').filter('.' + activeCls).removeClass('dimmed');
        $('#alertModalBody .alert-item').each(function () {
            var $b = $(this).find('.alert-type-badge');
            $(this).toggle(type === 'all' || $b.hasClass(type));
        });
        // Hide date labels with no visible items under them
        $('#alertModalBody .alert-date-label').each(function () {
            $(this).toggle($(this).nextUntil('.alert-date-label', '.alert-item').filter(':visible').length > 0);
        });
    }

    function toggleAlertItem(uid) { $('#' + uid).toggleClass('expanded'); }
    function toggleReadMore(e, uid) {
        e.stopPropagation(); var $el = $('#' + uid); $el.toggleClass('msg-expanded');
        $el.find('.alert-read-more').html($el.hasClass('msg-expanded') ? 'Read Less <i class="fas fa-chevron-up" style="font-size:9px;"></i>' : 'Read More <i class="fas fa-chevron-down" style="font-size:9px;"></i>');
    }
    function closeAlertModal() { $('#alertModalOverlay').removeClass('open'); $('body').css('overflow', ''); }
    function onClickRemarks() { if (_alertCurrentAssetTypeId) window.location.href = '/FRS25/Alerts/Index'; }
    $('#alertModalOverlay').on('click', function (e) { if ($(e.target).is('#alertModalOverlay')) closeAlertModal(); });

// ==================== SITE TABS ====================
    var allSiteItems = [], _siteTabsBuilt = false;
    function buildSiteCache() {
        allSiteItems = [];
        $('#listSite .dropdown-item').each(function () { allSiteItems.push({ value: $(this).data('value').toString(), text: $(this).data('text') || $(this).find('span').text() }); });
    }
    // "All Stations" always leads, then one tab per checked station. Selecting the
    // "All Stations" tab clears activeTabSiteId, so getEffectiveSiteIds() falls back
    // to the whole dropdown — the same behaviour as the web dashboard.
    function renderSiteTabs() {
        var selectedIds = getValues('site'), $tab = $('#pills-tab');
        $tab.empty();
        _siteTabsBuilt = selectedIds.length > 0;
        activeTabSiteId = null;

        $tab.append('<li class="nav-item" role="presentation"><button class="nav-link active border-0" id="btn-site-all" data-site-id="" type="button" role="tab">All Stations</button></li>');

        if (selectedIds.length > 0) {
            allSiteItems.filter(function (s) { return selectedIds.indexOf(s.value) > -1; })
                .forEach(function (site) {
                    $tab.append('<li class="nav-item" role="presentation"><button class="nav-link border-0" id="btn-site-tab-' + site.value + '" data-site-id="' + site.value + '" type="button" role="tab" title="' + escapeHtml(site.text) + '">' + escapeHtml(site.text) + '</button></li>');
                });
        }

        $tab.off('click', '.nav-link').on('click', '.nav-link', function () {
            $tab.find('.nav-link').removeClass('active'); $(this).addClass('active');
            var sid = $(this).data('site-id');
            activeTabSiteId = sid ? sid.toString() : null;
            fnBindAssetAndAlertCount(true);
        });
    }
    function escapeHtml(str) { return $('<div>').text(str).html(); }
</script>

<script>
    var iotFirst = true, sensorFirst = true, networkFirst = true, gatwayFirst = true;
    var wsConnections = {}, wsReconnectTimers = {}, wsReconnectAttempts = {}, wsIsConnected = {}, wsHeartbeatIntervals = {}, wsLastMessageTimes = {};
    var MAX_RECONNECT_ATTEMPTS = 15, RECONNECT_DELAY = 3000, WS_HEARTBEAT_TIMEOUT = 30000;

    // Redraw a chart only when the numbers that matter — Total and Failure — actually
    // changed since its last render (Healthy = Total - Failure, so it's covered). This
    // stops echarts dispose+init churn on every snapshot while guaranteeing the bar can
    // never go stale vs the card: the old gate compared Failure only, so a change in
    // Total alone updated the card text but left the bar showing the previous value.
    var lastChartKeys = {};
    function shouldRedrawChart(chartId, total, failure) {
        var key = total + '|' + failure;
        if (lastChartKeys[chartId] === key) return false;
        lastChartKeys[chartId] = key;
        return true;
    }

    // The per-station AlertLiveSnapshot sockets that used to drive the IoT / Network /
    // Gateway cards are gone: those cards now sum the global deviceHealth summaries
    // (recomputeDeviceHealth), the same feed and logic as the web dashboard.


    function disconnectWebSocket() {
        Object.keys(wsConnections).forEach(function (key) {
            if (wsReconnectTimers[key]) { clearTimeout(wsReconnectTimers[key]); wsReconnectTimers[key] = null; }
            if (wsHeartbeatIntervals[key]) { clearInterval(wsHeartbeatIntervals[key]); wsHeartbeatIntervals[key] = null; }
            var conn = wsConnections[key]; if (conn) { conn.onclose = null; conn.onerror = null; conn.close(1000); wsConnections[key] = null; }
            wsIsConnected[key] = false;
        });
        wsConnections = {};
    }

    function updateStatusBar() {
        var keys = Object.keys(wsConnections), connected = keys.filter(function (k) { return wsIsConnected[k]; }), total = keys.length;
        var $bar = $('#wsStatusBar'); if (!$bar.length) return;
        if (total === 0) { $bar.html('<div class="ws-status-bar ws-error"><span class="ws-dot red"></span><strong>No connections</strong></div>').show(); return; }
        if (connected.length === total) $bar.html('<div class="ws-status-bar ws-live"><span class="ws-dot live"></span><strong>Live</strong> — ' + total + '/' + total + ' sites <small>[ ' + connected.join(', ') + ' ]</small></div>').show();
        else if (connected.length > 0) $bar.html('<div class="ws-status-bar ws-connecting"><span class="ws-dot orange"></span><strong>Partial</strong> — ' + connected.length + '/' + total + ' sites</div>').show();
        else $bar.html('<div class="ws-status-bar ws-error"><span class="ws-dot red"></span><strong>Disconnected</strong> — 0/' + total + ' sites</div>').show();
    }
    function showWsStatus(s) { if (s === 'error') { var $bar = $('#wsStatusBar'); if ($bar.length) $bar.html('<div class="ws-status-bar ws-error"><span class="ws-dot red"></span><strong>Disconnected</strong></div>').show(); } }

    function parseDotNetDate(val) {
        if (!val) return null;
        var m = String(val).match(/\/Date\((-?\d+)([+-]\d{4})?\)\//);
        if (m) { var ms = parseInt(m[1], 10); if (ms <= 0) return null; return new Date(ms); }
        var d = new Date(val); return isNaN(d.getTime()) ? null : d;
    }
</script>

<!-- ══════════════════════════════════════════════════════════════════
     STATION-WISE LIVE HEALTH  (Site Health Modal + Faulty Sensor Modal)
     Ported from E7MRIV2Web /FRS25/Home dashboard.

     Self-contained: it owns its own `deviceHealth` / `sensorHealth`
     WebSocket subscriptions (prefix shmWs*) so it never interferes with
     the AlertLiveSnapshot sockets the carousel cards already use.
     Entry points: openSiteHealthModal() and openSensorHealthModal(),
     both wired onto the carousel stat cards.
══════════════════════════════════════════════════════════════════ -->
<script type="text/javascript">

    // ── Asset attribute value lookup (from GetIOTCount → mAssetInfos) ────
    // WS sensor faults only carry assetId/attributeId — this resolves the
    // live value and the A/B point-machine naming shown in the popup.
    var shmAssetValueLookup = {};       // "AssetId|AssetAttributeId" -> Value
    var shmAssetAttrRowsByAssetId = {}; // AssetId -> [{ AssetAttributeId, name, Value }, ...]

    function shmBuildAssetValueLookup(list) {
        shmAssetValueLookup = {};
        shmAssetAttrRowsByAssetId = {};
        (list || []).forEach(function (item) {
            shmAssetValueLookup[item.AssetId + '|' + item.AssetAttributeId] = item.Value;
            var name = (item.AttributeAliasName && item.AttributeAliasName.trim())
                ? item.AttributeAliasName
                : item.AttributeName;
            if (!shmAssetAttrRowsByAssetId[item.AssetId]) shmAssetAttrRowsByAssetId[item.AssetId] = [];
            shmAssetAttrRowsByAssetId[item.AssetId].push({
                AssetAttributeId: item.AssetAttributeId,
                name: name,
                Value: item.Value
            });
        });
    }

    // Splits "A VPT NWKR" -> { end: 'A', label: 'VPT NWKR' }. null when the name
    // doesn't start with a bare A/B end prefix.
    function shmPmSplitEnd(name) {
        var m = String(name || '').trim().match(/^([AB])\s+(.+)$/i);
        if (!m) return null;
        return { end: m[1].toUpperCase(), label: m[2].trim() };
    }

    // Point Machine (AssetTypeId 3) only: if the opposite-end counterpart on the same
    // asset has the SAME label and SAME value, show them merged as "A/B <label>" —
    // matching the Sensor Health Detail popup convention. Anything else is unchanged.
    function shmResolvePmDisplayName(f) {
        if (Number(f.assetTypeId) !== 3) return f.assetAttributeName;
        var split = shmPmSplitEnd(f.assetAttributeName);
        if (!split) return f.assetAttributeName;

        var rows = shmAssetAttrRowsByAssetId[f.assetId] || [];
        var ownValue = shmAssetValueLookup[f.assetId + '|' + f.attId];
        var otherEnd = split.end === 'A' ? 'B' : 'A';

        for (var i = 0; i < rows.length; i++) {
            var r = rows[i];
            if (r.AssetAttributeId === f.attId) continue;
            var rSplit = shmPmSplitEnd(r.name);
            if (!rSplit || rSplit.end !== otherEnd) continue;
            if (rSplit.label.toLowerCase() !== split.label.toLowerCase()) continue;
            if (String(r.Value == null ? '' : r.Value).trim() === String(ownValue == null ? '' : ownValue).trim()) {
                return 'A/B ' + split.label;
            }
        }
        return f.assetAttributeName;
    }

    // ── WebSocket plumbing (own maps — keeps AlertLiveSnapshot untouched) ─
    var shmWsConnections = {}, shmWsReconnectTimers = {}, shmWsReconnectAttempts = {},
        shmWsIsConnected = {}, shmWsHeartbeats = {}, shmWsLastMessageTimes = {};
    var SHM_MAX_RECONNECT_ATTEMPTS = 15, SHM_RECONNECT_DELAY = 3000, SHM_HEARTBEAT_TIMEOUT = 30000;


    // The station this popup can actually show: the selected station tab, or the only
    // station in scope. Null when the dashboard is on "All Stations" with several.
    // Same model as the web (616/619) dashboard: exactly TWO sockets for the whole page —
    // one global 'deviceHealth' and one global 'sensorHealth' subscription (no siteId in
    // the URL). Every message carries its own siteId; groupHealthState /
    // shmSensorHealthState keep one entry per station. The IoT / Network / Gateway /
    // Sensor cards sum the stations in scope (recomputeDeviceHealth / recomputeSensorHealth)
    // and both station popups read the same state, so a popup has data the moment it opens
    // and no per-station socket fan-out is needed (that fan-out is what exhausted the
    // browser before). explicitSiteId is accepted for the popups' call sites; the global
    // sockets already cover every station.
    function shmConnectHealthSockets(explicitSiteId) {
        connectDeviceWebSocket();
        connectSensorWebSocket();
        connectAlertEventsSocket();
    }

    // ── ALERT EVENTS (SET / RESET pushes) — keeps the asset-type cards, Today's Report
    // and Total Assets live after the first load, like the web dashboard. Any SET/RESET
    // for a station in view triggers one debounced re-fetch of the alert counts (and of
    // the alert popup's list if it is open).
    var _alertEventsOn = false, _alertEventsTimer = null;
    function connectAlertEventsSocket() {
        if (_alertEventsOn) return;
        _alertEventsOn = true;
        shmOpenWs('alertEvents', null, handleAlertEventsMessage);
    }
    function handleAlertEventsMessage(siteId, batch) {
        var eff = getCardSiteIds();
        var relevant = shmUnwrapBatch(batch).some(function (m) {
            var action = String((m && (m.AlertAction || m.alertAction)) || '').toUpperCase();
            if (action !== 'SET' && action !== 'RESET') return false;
            var sid = m.SiteId != null ? m.SiteId : m.siteId;
            return sid != null && eff.indexOf(String(sid)) > -1;
        });
        if (!relevant) return;
        if (_alertEventsTimer) clearTimeout(_alertEventsTimer);
        _alertEventsTimer = setTimeout(function () {
            _alertEventsTimer = null;
            if (globalAssetData) fnBindWithOutAcknowledgementAlert(globalAssetData, true);
            if ($('#alertModalOverlay').hasClass('open') && _alertCurrentAssetTypeId != null) {
                $.ajax({
                    url: '/FRS25/Home/GetAlertDetails', type: 'POST', contentType: 'application/json',
                    data: JSON.stringify({ SearchCriteria: { AssetTypeId: _alertCurrentAssetTypeId, ZoneIds: getValues('zone'), DivisionIds: getValues('division'), SiteIds: getEffectiveSiteIds(), Pager: { Take: -1 } } }),
                    success: function (resp) { renderAlertModal(resp); }
                });
            }
        }, 400);
    }

    var shmDeviceGlobalOn = false;
    function connectDeviceWebSocket() {
        if (!shmDeviceGlobalOn) {
            shmDeviceGlobalOn = true;
            shmOpenWs('deviceHealth', null, shmHandleDeviceMessage);
        }
        recomputeDeviceHealth();
    }

    // IoT / Network / Gateway cards — summed from each in-scope station's groupHealth
    // summary, exactly like the web dashboard's recomputeDeviceHealth():
    //   IoT     = a10Total / a10Online / a10Down
    //   Network = modemTotal; wired & wireless down counted separately
    //   Gateway = gatewayTotal / gatewayUp / gatewayDown
    function recomputeDeviceHealth() {
        var eff = getCardSiteIds();
        var iotTotal = 0, iotHealthy = 0, iotFaulty = 0;
        var nwCount = 0, wiredH = 0, wiredF = 0, wirelessH = 0, wirelessF = 0;
        var gwTotal = 0, gwHealthy = 0, gwFaulty = 0;

        Object.keys(groupHealthState).forEach(function (skey) {
            if (eff.indexOf(skey) === -1) return;
            var full = groupHealthState[skey];
            var s = full && full.summary;
            if (!s) return;

            iotTotal += s.a10Total || 0;
            iotHealthy += s.a10Online || 0;
            iotFaulty += s.a10Down || 0;

            var modemTotal = s.modemTotal || 0;
            var wiredDown = s.modemWiredDown || 0;
            var wirelessDown = s.modemWirelessDown || 0;
            nwCount += modemTotal;
            wiredF += wiredDown;
            wiredH += Math.max(0, modemTotal - wiredDown);
            wirelessF += wirelessDown;
            wirelessH += Math.max(0, modemTotal - wirelessDown);

            gwTotal += s.gatewayTotal || 0;
            gwHealthy += s.gatewayUp || 0;
            gwFaulty += s.gatewayDown || 0;
        });

        var iot = { TotalADC: iotTotal, HelthyCount: iotHealthy, FailurCount: iotFaulty };
        fnBindIOTCard(iot);
        if (shouldRedrawChart('iot', iotTotal, iotFaulty)) fnBindIOTChart(iot);

        var nw = { TotalCluster: nwCount, WiredHealthy: wiredH, WiredFaulty: wiredF, WirelessHealthy: wirelessH, WirelessFaulty: wirelessF };
        fnBindNetworkCard(nw);
        if (shouldRedrawChart('network', nwCount, wiredF + '|' + wirelessF)) fnBindNetworkChart(nw);

        var gw = { TotalGatway: gwTotal, HelthyCount: gwHealthy, FailurCount: gwFaulty };
        fnBindGatwayCard(gw);
        if (shouldRedrawChart('gateway', gwTotal, gwFaulty)) fnBindGatwayChart(gw);

        updateStatusBar();
        if (typeof resizeDashboardCharts === 'function') resizeDashboardCharts();
    }

    var shmSensorGlobalOn = false;
    function connectSensorWebSocket() {
        if (!shmSensorGlobalOn) {
            shmSensorGlobalOn = true;
            shmOpenWs('sensorHealth', null, shmHandleSensorMessage);
        }
        recomputeSensorHealth();
    }

    function shmOpenWs(topic, siteId, onMessage) {
        if (!window.APP_CONFIG || !window.APP_CONFIG.WebSocketBaseUrl) return;
        var key = topic + '|' + (siteId != null ? siteId : '*');
        var wsUrl = window.APP_CONFIG.WebSocketBaseUrl + '/subscribe/' + topic + (siteId != null ? '/' + siteId : '');
        if (window.isSecure && window.APP_CONFIG.WebSocketAuthToken) {
            var sep = wsUrl.indexOf('?') > -1 ? '&' : '?';
            wsUrl += sep + 'token=' + encodeURIComponent(window.APP_CONFIG.WebSocketAuthToken);
        }
        shmWsReconnectAttempts[key] = shmWsReconnectAttempts[key] || 0;
        shmWsLastMessageTimes[key] = Date.now();
        try {
            var ws = new WebSocket(wsUrl);
            shmWsConnections[key] = ws;
            ws.onopen = function () {
                shmWsIsConnected[key] = true;
                shmWsReconnectAttempts[key] = 0;
                shmWsLastMessageTimes[key] = Date.now();
                if (shmWsHeartbeats[key]) clearInterval(shmWsHeartbeats[key]);
                shmWsHeartbeats[key] = setInterval(function () {
                    if (shmWsIsConnected[key] && (Date.now() - shmWsLastMessageTimes[key] > SHM_HEARTBEAT_TIMEOUT)) {
                        var conn = shmWsConnections[key];
                        if (conn) { conn.onclose = null; conn.close(); }
                        shmWsConnections[key] = null;
                        shmWsIsConnected[key] = false;
                        shmWsReconnectAttempts[key]++;
                        shmOpenWs(topic, siteId, onMessage);
                    }
                }, 10000);
            };
            ws.onmessage = function (event) {
                shmWsLastMessageTimes[key] = Date.now();
                try { onMessage(siteId, typeof event.data === 'string' ? JSON.parse(event.data) : event.data); } catch (e) { }
            };
            ws.onclose = function (event) {
                shmWsIsConnected[key] = false;
                var fatal = [1008, 4001, 4003, 401];
                if (fatal.indexOf(event.code) > -1) return;
                if (event.code !== 1000 && shmWsReconnectAttempts[key] < SHM_MAX_RECONNECT_ATTEMPTS) {
                    shmWsReconnectAttempts[key]++;
                    var delay = SHM_RECONNECT_DELAY * Math.min(shmWsReconnectAttempts[key], 5);
                    shmWsReconnectTimers[key] = setTimeout(function () { shmOpenWs(topic, siteId, onMessage); }, delay);
                }
            };
            ws.onerror = function () { shmWsIsConnected[key] = false; };
        } catch (e) { }
    }

    // topicPrefix tears down only that topic's sockets, so reconnecting one topic
    // never drops the other's live connection.
    function shmDisconnectWs(topicPrefix) {
        Object.keys(shmWsConnections).forEach(function (key) {
            if (topicPrefix && key.indexOf(topicPrefix + '|') !== 0) return;
            if (shmWsReconnectTimers[key]) { clearTimeout(shmWsReconnectTimers[key]); shmWsReconnectTimers[key] = null; }
            if (shmWsHeartbeats[key]) { clearInterval(shmWsHeartbeats[key]); shmWsHeartbeats[key] = null; }
            var conn = shmWsConnections[key];
            if (conn) { conn.onclose = null; conn.onerror = null; conn.close(1000); }
            shmWsIsConnected[key] = false;
            delete shmWsConnections[key];
        });
    }

    function shmUnwrapBatch(batch) {
        if (batch && batch.MessageType === 'Batch' && Array.isArray(batch.Messages)) {
            var out = [];
            batch.Messages.forEach(function (m) {
                try { out.push(typeof m === 'string' ? JSON.parse(m) : m); } catch (e) { /* skip malformed entry */ }
            });
            return out;
        }
        if (Array.isArray(batch)) return batch;
        return batch ? [batch] : [];
    }

    // ── STATION HEALTH POPUP state ───────────────────────────────────────
    // Per-site cache of the FULL latest groupHealth message (not just the summary),
    // so the popup has cluster / modem / A10 detail available.
    var groupHealthState = {};
    var shmCurrentSiteId = null;
    var shmFilters = { status: 'all', issue: 'any', sort: 'issues', search: '' };

    function shmHandleDeviceMessage(siteId, batch) {
        var touched = false;
        shmUnwrapBatch(batch).forEach(function (msg) {
            if (!msg || msg.type !== 'groupHealth' || !msg.summary) return;
            if (msg.siteId == null && siteId == null) return;
            var skey = String(msg.siteId != null ? msg.siteId : siteId);
            groupHealthState[skey] = msg;
            touched = true;
            // Live-refresh the popup when it is open on this exact station.
            if (shmCurrentSiteId != null && String(shmCurrentSiteId) === skey) shmRenderAll(msg);
        });
        if (touched) recomputeDeviceHealth();   // IoT / Network / Gateway cards
    }

    // ── STATION HEALTH POPUP — open / close ──────────────────────────────
    // ── SITE PICKER — "All Stations" scope defaults to a station chooser ─────
    // Resolves which single station the popup should show. If a station tab is active, or the
    // current filter already narrows to one site, resolves immediately; otherwise opens a picker
    // listing every station in scope (so the Device/Sensor cards open from "All Stations" instead
    // of refusing with an alert).
    function resolveOrPickSite(onResolved) {
        if (activeTabSiteId) { onResolved(String(activeTabSiteId)); return; }
        // Zone / Division / Station / nothing selected -> the stations in that scope.
        withScopeSiteIds(function (ids) {
            if (ids && ids.length === 1) { onResolved(String(ids[0])); return; }
            openSitePickerModal(ids, onResolved);
        });
    }

    var _sitePickerCallback = null;
    function openSitePickerModal(candidateIds, onResolved) {
        _sitePickerCallback = onResolved;
        // Build from the scoped ids (names from _siteNameById) — allSiteItems mirrors
        // #listSite, which is only a placeholder while just a Zone is ticked.
        var items = (candidateIds || []).map(function (id) {
            id = String(id);
            return { value: id, text: _siteNameById[id] || ('Station ' + id) };
        });
        items.sort(function (a, b) { return String(a.text).localeCompare(String(b.text)); });
        var html = items.map(function (s) {
            return '<div class="shm-site-pick-item" data-site-id="' + s.value + '">' + escapeHtml(s.text) + '</div>';
        }).join('');
        $('#shmSitePickerList').html(html || '<div class="shm-empty">No stations available.</div>');
        $('#shmSitePickerSearch').val('');
        $('#shmSitePickerOverlay').addClass('open');
        $('body').css('overflow', 'hidden');
    }
    function closeSitePickerModal() {
        $('#shmSitePickerOverlay').removeClass('open');
        $('body').css('overflow', '');
        _sitePickerCallback = null;
    }
    $(document).on('click', '#shmSitePickerList .shm-site-pick-item', function () {
        var siteId = $(this).data('site-id').toString();
        var cb = _sitePickerCallback;
        closeSitePickerModal();
        if (cb) cb(siteId);
    });
    $(document).on('input', '#shmSitePickerSearch', function () {
        var q = $(this).val().toLowerCase();
        $('#shmSitePickerList .shm-site-pick-item').each(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(q) > -1);
        });
    });
    $(document).on('click', '#shmSitePickerOverlay', function (e) { if (e.target === this) closeSitePickerModal(); });

    function openSiteHealthModal() {
        resolveOrPickSite(function (siteId) {
            shmConnectHealthSockets(siteId);   // connect this station's sockets (no-op if already subscribed)
            shmCurrentSiteId = String(siteId);
            $('#shmModalOverlay').addClass('open');
            $('body').css('overflow', 'hidden');

            var msg = groupHealthState[shmCurrentSiteId];
            if (msg) {
                shmRenderAll(msg);
            } else {
                $('#shmStatRow,#shmBanner,#shmFleetCard,#shmMeters').html('');
                $('#shmGrid').html('<div class="shm-empty">Waiting for live data from this station&hellip;</div>');
                $('#shmModalTitle').text('Live Station Health');
            }
        });
    }

    function closeSiteHealthModal() {
        $('#shmModalOverlay').removeClass('open');
        $('body').css('overflow', '');
        shmCurrentSiteId = null;
    }

    // ── STATION HEALTH POPUP — rendering (all computed from groupHealth) ──
    function shmFriendlyChannel(channel) {
        var map = {
            '4G_TCP': '4G TCP', '4G_MQTT': '4G MQTT', 'OFC_TCP': 'OFC TCP', 'OFC_MQTT': 'OFC MQTT',
            'A10_TCP': 'IoT TCP', 'A10_MQTT': 'IoT MQTT', 'A10_OFC': 'IoT OFC'
        };
        return map[channel] || String(channel).replace(/_/g, ' ');
    }

    function shmComputeChannelStats(msg) {
        var meterCounters = {}; // channel -> {up, total}
        function count(ch, up) {
            if (!meterCounters[ch]) meterCounters[ch] = { up: 0, total: 0 };
            meterCounters[ch].total++;
            if (up) meterCounters[ch].up++;
        }
        var channelsTotal = 0, channelsUp = 0;
        (msg.clusters || []).forEach(function (cl) {
            if (cl.modem && Array.isArray(cl.modem.channels)) {
                cl.modem.channels.forEach(function (ch, i) {
                    var up = Number(cl.modem.flag && cl.modem.flag[i]) === 1;
                    count(ch, up); channelsTotal++; if (up) channelsUp++;
                });
            }
            (cl.a10Devices || []).forEach(function (a) {
                (a.channels || []).forEach(function (ch, i) {
                    var up = Number(a.flag && a.flag[i]) === 1;
                    count(ch, up); channelsTotal++; if (up) channelsUp++;
                });
            });
        });
        return { meterCounters: meterCounters, channelsTotal: channelsTotal, channelsUp: channelsUp };
    }

    function shmRenderAll(msg) {
        var stats = shmComputeChannelStats(msg);
        $('#shmModalTitle').text((msg.siteName || ('Site ' + msg.siteId)) + ' — Live Health');
        $('#shmUpdatedAt').text(msg.updateTime ? ('Updated: ' + msg.updateTime) : '');
        shmRenderBanner(msg);
        shmRenderStats(msg, stats);
        shmRenderFleet(stats);
        shmRenderMeters(stats.meterCounters);
        shmRenderGrid();
    }

    function shmRenderBanner(msg) {
        var s = msg.summary || {};
        function chip(label, total, up, down) {
            if (!total) {
                return '<div class="shm-gw shm-gw-pending"><span class="shm-gw-dot"></span><span class="shm-gw-label">' + label + '</span><span class="shm-gw-state">Pending</span></div>';
            }
            var isUp = (down || 0) === 0 && (up || 0) > 0;
            return '<div class="shm-gw ' + (isUp ? 'gw-up' : 'gw-down') + '"><span class="shm-gw-dot"></span><span class="shm-gw-label">' + label + '</span><span class="shm-gw-state">' + (isUp ? 'Online' : 'OFFLINE') + '</span></div>';
        }
        $('#shmBanner').html('<div class="shm-banner-row">' + chip('Gateway', s.gatewayTotal, s.gatewayUp, s.gatewayDown) + '</div>');
    }

    function shmRenderStats(msg, stats) {
        var s = msg.summary || {};
        var down = stats.channelsTotal - stats.channelsUp;
        var maskedCount = s.a10Masked || 0;
        $('#shmStatRow').html(
            '<div class="shm-stat-card"><div class="shm-stat-label">Clusters</div><div class="shm-stat-value">' + (s.clustersTotal || 0) + '</div></div>' +
            '<div class="shm-stat-card ' + (down > 0 ? 'warn' : '') + '"><div class="shm-stat-label">Channels down</div><div class="shm-stat-value">' + down + '</div></div>' +
            (maskedCount > 0 ? '<div class="shm-stat-card muted"><div class="shm-stat-label">IoT masked</div><div class="shm-stat-value">' + maskedCount + '</div></div>' : '') +
            '<div class="shm-stat-card"><div class="shm-stat-label">Station</div><div class="shm-stat-value">' + (msg.siteName || ('Site ' + msg.siteId)) + '</div></div>'
        );
    }

    function shmRenderFleet(stats) {
        var pct = stats.channelsTotal ? Math.round((stats.channelsUp / stats.channelsTotal) * 100) : 100;
        $('#shmFleetCard').html(
            '<div class="shm-scard-label">FLEET HEALTH</div>' +
            '<div class="shm-fh-row"><div class="shm-fh-frac">' + stats.channelsUp + ' <span class="shm-fh-of">/ ' + stats.channelsTotal + ' up</span></div>' +
            '<div class="shm-fh-pct">' + pct + '%</div></div>' +
            '<div class="shm-hbar"><div class="shm-hbar-up" style="width:' + pct + '%"></div></div>' +
            '<div class="shm-fh-legend"><span><span class="shm-dot grn"></span>' + stats.channelsUp + ' up</span>' +
            '<span><span class="shm-dot red"></span>' + (stats.channelsTotal - stats.channelsUp) + ' down</span></div>'
        );
    }

    function shmRenderMeters(meterCounters) {
        function row(channel) {
            var c = meterCounters[channel] || { up: 0, total: 0 };
            var pct = c.total ? Math.round((c.up / c.total) * 100) : 100;
            var short = channel.replace(/^(A10_|4G_|OFC_)/, '');
            return '<div class="shm-mrow"><span class="shm-mrow-ch">' + short + '</span>' +
                '<span class="shm-mrow-frac">' + c.up + ' / ' + c.total + ' <b>' + pct + '%</b></span>' +
                '<div class="shm-m-track"><div class="shm-m-fill" style="width:' + pct + '%"></div></div></div>';
        }
        function hasAny(channels) { return channels.some(function (ch) { return meterCounters[ch] && meterCounters[ch].total > 0; }); }
        var cells = [{ label: 'Network &middot; 4G', rows: ['4G_TCP', '4G_MQTT'] }];
        if (hasAny(['OFC_MQTT', 'OFC_TCP'])) cells.push({ label: 'Network &middot; OFC', rows: ['OFC_MQTT', 'OFC_TCP'] });
        cells.push({ label: 'IoT &middot; 4G', rows: ['A10_TCP', 'A10_MQTT'] });
        if (hasAny(['A10_OFC'])) cells.push({ label: 'IoT &middot; OFC', rows: ['A10_OFC'] });
        $('#shmMeters').html(cells.map(function (cell) {
            return '<div class="shm-mcell"><div class="shm-mcell-label">' + cell.label + '</div>' + cell.rows.map(row).join('') + '</div>';
        }).join(''));
    }

    // ── Dashboard-computed masking (added ON TOP of backend masked[]/status — union, never override):
    //   1. Gateway down              -> mask A10_OFC + Network OFC (Wired lane)
    //   2. External Gateway down     -> mask A10_TCP
    //   3. Network OFC (Wired) down  -> mask A10_OFC AND A10_TCP
    //   4. Network 4G (Wireless) down -> mask A10_MQTT
    // A transport counts as down for masking only while its rolled-up .status says down AND none
    // of its raw channel flags has recovered yet — so IoT (A10) masking clears the moment the
    // Network lane flips up, instead of waiting for the backend rollup (fixes the slow A10-MQTT
    // reset after a 4G reset). Fields absent from the summary simply make a rule a no-op.
    function shmAnyTransportChannelUp(cl, chans) {
        if (!cl.modem) return false;
        var anyUp = false;
        (cl.modem.channels || []).forEach(function (ch, i) {
            if (chans.indexOf(ch) > -1 && Number(cl.modem.flag[i]) === 1) anyUp = true;
        });
        return anyUp;
    }

    function shmDerivedMasks(msg, cl) {
        var s = (msg && msg.summary) || {};
        var gatewayDown = (s.gatewayDown || 0) > 0;
        var exGatewayDown = (s.exGatewayDown || 0) > 0;
        var networkOfcDown = !!(cl.modem && cl.modem.wired && cl.modem.wired.status === 'down')
            && !shmAnyTransportChannelUp(cl, ['OFC_TCP', 'OFC_MQTT']);
        var network4gDown = !!(cl.modem && cl.modem.wireless && cl.modem.wireless.status === 'down')
            && !shmAnyTransportChannelUp(cl, ['4G_TCP', '4G_MQTT']);
        return {
            a10: {
                A10_OFC: gatewayDown || networkOfcDown,   // rules 1 + 3
                A10_TCP: exGatewayDown || networkOfcDown,  // rules 2 + 3
                A10_MQTT: network4gDown                    // rule 4
            },
            networkOfc: gatewayDown                        // rule 1
        };
    }

    function shmClusterHasIssue(cl, kind, masks) {
        var modemUp = {};
        if (cl.modem) (cl.modem.channels || []).forEach(function (ch, i) { modemUp[ch] = Number(cl.modem.flag[i]) === 1; });
        var a10AnyRealDown = (cl.a10Devices || []).some(function (a) {
            if (a.status === 'unknown') return false; // fully masked — nothing to flag
            return (a.channels || []).some(function (ch, i) {
                var masked = (a.masked && a.masked[i]) || (masks && masks.a10[ch]);
                return !masked && Number(a.flag[i]) !== 1;
            });
        });
        if (kind === '4g') return (('4G_TCP' in modemUp) || ('4G_MQTT' in modemUp)) && (modemUp['4G_TCP'] === false || modemUp['4G_MQTT'] === false);
        if (kind === 'ofc') {
            var wiredUnknown = (cl.modem && cl.modem.wired && cl.modem.wired.status === 'unknown') || (masks && masks.networkOfc);
            if (wiredUnknown) return false; // masked — not a real "down"
            return modemUp['OFC_TCP'] === false || modemUp['OFC_MQTT'] === false;
        }
        if (kind === 'a10') return a10AnyRealDown;
        return cl.status !== 'ok';
    }

    function shmModemDownItems(cl, masks) {
        if (!cl.modem) return [];
        var items = [];
        var wiredUnknown = (cl.modem.wired && cl.modem.wired.status === 'unknown') || (masks && masks.networkOfc);
        (cl.modem.channels || []).forEach(function (ch, i) {
            var isWiredChannel = (ch === 'OFC_TCP' || ch === 'OFC_MQTT');
            if (isWiredChannel && wiredUnknown) return; // masked — not a real down condition
            if (Number(cl.modem.flag[i]) !== 1) items.push(shmFriendlyChannel(ch));
        });
        return items;
    }

    function shmA10DownItems(cl, masks) {
        var items = [];
        (cl.a10Devices || []).forEach(function (a) {
            // A device with status "unknown" has every channel masked — the service doesn't
            // alert on it at all, so it has no place in a "what's actually down" list.
            if (a.status === 'unknown') return;
            (a.channels || []).forEach(function (ch, i) {
                if ((a.masked && a.masked[i]) || (masks && masks.a10[ch])) return; // suppressed — not a real down condition
                if (Number(a.flag[i]) !== 1) items.push('IoT ' + a.deviceId + ' &middot; ' + shmFriendlyChannel(ch).replace(/^IoT /, ''));
            });
        });
        return items;
    }

    function shmModemBlock(cl, masks) {
        if (!cl.modem) return '<div class="shm-c-mac shm-c-muted">No network on this cluster</div>';
        var byChannel = {};
        (cl.modem.channels || []).forEach(function (ch, i) { byChannel[ch] = Number(cl.modem.flag[i]) === 1; });

        // Modem has NO per-channel masked array — Wired signals masking via wired.status ===
        // "unknown" only (flag is forced up while masked, so it can't be used). Wireless is
        // never masked. Also masked whenever the dashboard-derived rule applies (Gateway down,
        // see shmDerivedMasks) — union with the backend signal. Same as 616.
        var wiredUnknown = !!(cl.modem.wired && cl.modem.wired.status === 'unknown') || !!(masks && masks.networkOfc);

        function lane(label, chans, isUnknown) {
            var present = chans.filter(function (ch) { return ch in byChannel; });
            if (!present.length) return '';
            var chips = present.map(function (ch) {
                var up = byChannel[ch];
                var short = ch.replace(/^(A10_|4G_|OFC_)/, '');
                var cls = isUnknown ? 'ch-unknown' : (up ? 'ch-up' : 'ch-down');
                var title = isUnknown
                    ? shmFriendlyChannel(ch) + ': Indeterminable — parent Gateway link is down, cannot verify this transport independently'
                    : shmFriendlyChannel(ch) + ': ' + (up ? 'up' : 'down');
                return '<span class="shm-ch ' + cls + '" title="' + title + '">' + short + '</span>';
            }).join('');
            var row = '<div class="shm-lane"><span class="shm-lane-label">' + label + '</span><span class="shm-lane-chips">' + chips + '</span></div>';
            if (isUnknown) row += '<div class="shm-lane-unknown-tag">Indeterminable — parent Gateway link is down</div>';
            return row;
        }
        var lanes = lane('4G', ['4G_TCP', '4G_MQTT'], false) + lane('OFC', ['OFC_TCP', 'OFC_MQTT'], wiredUnknown);
        return '<div class="shm-c-mac"><span class="shm-c-mac-id">Network ' + cl.modem.deviceId + '</span></div>' + lanes;
    }

    // A device is fully masked/Indeterminable when every channel it has is masked, whether
    // by the backend's own masked[] flag or by a dashboard-derived rule (shmDerivedMasks).
    function shmA10DeviceIsUnknown(a, masks) {
        var channels = a.channels || [];
        if (!channels.length) return false;
        return channels.every(function (ch, i) { return !!(a.masked && a.masked[i]) || !!(masks && masks.a10[ch]); });
    }

    function shmA10Block(cl, masks) {
        var a10s = cl.a10Devices || [];
        if (!a10s.length) return '';
        var dotOrder = (a10s[0] && a10s[0].channels) || [];
        // A channel is masked if the backend already flags it OR a dashboard-derived rule
        // (shmDerivedMasks) applies to this channel name — union, never subtractive.
        function channelMasked(a, ch, i) { return !!(a.masked && a.masked[i]) || !!(masks && masks.a10[ch]); }
        var tiles = a10s.map(function (a) {
            var isUnknown = shmA10DeviceIsUnknown(a, masks);
            var dots = (a.channels || []).map(function (ch, i) {
                return '<span class="shm-ad ' + shmColorFor(a.flag[i], channelMasked(a, ch, i)) + '"></span>';
            }).join('');
            var tipRows = (a.channels || []).map(function (ch, i) {
                var masked = channelMasked(a, ch, i);
                var cls = shmColorFor(a.flag[i], masked);
                var detail = masked ? 'Indeterminable by parent link outage' : (Number(a.flag[i]) === 1 ? 'Up' : 'Down');
                return '<div class="shm-tip-row"><span class="shm-tip-dot ' + cls + '"></span><span class="shm-tip-ch">' + shmFriendlyChannel(ch) + '</span><span class="shm-tip-detail">' + detail + '</span></div>';
            }).join('');
            var unknownBadge = isUnknown ? '<span class="shm-a10-unknown-badge" title="Cannot be verified — the parent Network/Gateway link is down. This device may or may not be faulty.">?</span>' : '';
            return '<div class="shm-a10chip' + (isUnknown ? ' shm-a10-unknown' : '') + '">' +
                '<div class="shm-a10id">IoT ' + a.deviceId + unknownBadge + '</div>' +
                '<div class="shm-a10dots">' + dots + '</div>' +
                '<div class="shm-tooltip shm-tooltip-a10"><div class="shm-tooltip-title">IoT ' + a.deviceId + (isUnknown ? ' &middot; Indeterminable' : '') + '</div>' + tipRows + '</div></div>';
        }).join('');
        return '<div class="shm-a10hd"><span>IoT devices</span>' +
            '<span class="shm-info-icon">?<div class="shm-tooltip shm-tooltip-legend"><div class="shm-tooltip-title">Dot order (left to right)</div>' +
            dotOrder.map(function (ch, i) { return '<div class="shm-tip-row"><span class="shm-tip-num">' + (i + 1) + '.</span><span class="shm-tip-ch">' + shmFriendlyChannel(ch) + '</span></div>'; }).join('') +
            '</div></span>' +
            '<span class="shm-a10cnt">' + (cl.a10OnlineCount || 0) + '/' + (cl.a10Total || 0) + ' fully online</span></div>' +
            '<div class="shm-a10grid">' + tiles + '</div>';
    }

    // Network (Modem) only — masking-aware, same rule as the lane chips themselves use.
    function shmNetworkUpDownCounts(cl, masks) {
        var total = 0, down = 0;
        if (cl.modem) {
            var wiredUnknown = (cl.modem.wired && cl.modem.wired.status === 'unknown') || (masks && masks.networkOfc);
            (cl.modem.channels || []).forEach(function (ch, i) {
                var isWiredChannel = (ch === 'OFC_TCP' || ch === 'OFC_MQTT');
                if (isWiredChannel && wiredUnknown) return; // masked — excluded
                total++;
                if (Number(cl.modem.flag[i]) !== 1) down++;
            });
        }
        return { total: total, down: down };
    }

    // Card colour/badge follows 616: masked Network lanes are left out, so a Gateway outage
    // shows the OFC lane as Indeterminable instead of turning the whole cluster red.
    function shmRenderClusterCard(cl, msg) {
        var masks = shmDerivedMasks(msg, cl);
        var allDown = { s: 'shm-off', d: 'red', b: '<button type="button" class="shm-c-offline" data-cluster-id="' + cl.clusterId + '">See all Downs</button>' };
        var mixed = { s: 'shm-deg', d: 'amb', b: '<button type="button" class="shm-c-offline shm-c-mixed" data-cluster-id="' + cl.clusterId + '">Down</button>' };
        var ok = { s: '', d: 'grn', b: '<span class="shm-c-ok-badge">OK</span>' };

        // IoT side uses the same a10OnlineCount/a10Total printed as "X/Y fully online", so the
        // badge always agrees with the card text.
        var a10Total = cl.a10Total || 0;
        var a10Online = cl.a10OnlineCount || 0;
        var a10AllOnline = a10Total === 0 || a10Online === a10Total;
        var a10AllDown = a10Total > 0 && a10Online === 0;
        var st;

        if (!cl.modem && a10Total === 0) {
            st = allDown;                                  // nothing configured — nothing verified healthy
        } else if (!cl.modem) {
            st = a10AllOnline ? ok : (a10AllDown ? allDown : mixed);
        } else {
            var net = shmNetworkUpDownCounts(cl, masks);
            var netAllUp = net.total === 0 || net.down === 0;
            var netAllDown = net.total > 0 && net.down === net.total;
            st = netAllDown ? allDown : ((netAllUp && a10AllOnline) ? ok : mixed);
        }

        return '<div class="shm-card ' + st.s + '">' +
            '<div class="shm-c-top"><span class="shm-c-dot ' + st.d + '"></span><span class="shm-c-name">' + (cl.clusterName || ('Cluster ' + cl.clusterId)) + '</span>' +
            st.b +
            '</div>' + shmModemBlock(cl, masks) + shmA10Block(cl, masks) + '</div>';
    }

    function shmRenderGrid() {
        var msg = groupHealthState[String(shmCurrentSiteId)];
        if (!msg) { $('#shmGrid').html('<div class="shm-empty">No live data yet for this station.</div>'); return; }
        var clusters = (msg.clusters || []).slice();
        var f = shmFilters;
        if (f.status === 'online') clusters = clusters.filter(function (c) { return c.status === 'ok'; });
        if (f.status === 'offline') clusters = clusters.filter(function (c) { return c.status !== 'ok'; });
        if (f.issue !== 'any') clusters = clusters.filter(function (c) { return shmClusterHasIssue(c, f.issue, shmDerivedMasks(msg, c)); });
        if (f.search) {
            var q = f.search.toLowerCase();
            clusters = clusters.filter(function (c) {
                return (c.clusterName || '').toLowerCase().indexOf(q) > -1 ||
                    (c.modem && (c.modem.deviceId || '').toLowerCase().indexOf(q) > -1) ||
                    (c.a10Devices || []).some(function (a) { return (a.deviceId || '').toLowerCase().indexOf(q) > -1; });
            });
        }
        if (f.sort === 'issues') {
            clusters.sort(function (a, b) { return (a.status === 'ok') - (b.status === 'ok') || (a.clusterName || '').localeCompare(b.clusterName || ''); });
        } else {
            clusters.sort(function (a, b) { return (a.clusterName || '').localeCompare(b.clusterName || ''); });
        }
        if (!clusters.length) { $('#shmGrid').html('<div class="shm-empty">No clusters match these filters.</div>'); return; }
        $('#shmGrid').html(clusters.map(function (cl) { return shmRenderClusterCard(cl, msg); }).join(''));
    }

    function shmOpenClusterModal(clusterId) {
        var msg = groupHealthState[String(shmCurrentSiteId)];
        var cl = ((msg && msg.clusters) || []).filter(function (c) { return String(c.clusterId) === String(clusterId); })[0];
        if (!cl) return;
        $('#shmClusterModalTitle').text(cl.clusterName || ('Cluster ' + cl.clusterId));
        function section(heading, items) {
            if (!items.length) return '<div class="shm-modal-section"><h4>' + heading + '</h4><div class="shm-modal-ok">&#10003; All up</div></div>';
            return '<div class="shm-modal-section"><h4>' + heading + '</h4>' + items.map(function (label) {
                return '<div class="shm-modal-item"><span class="shm-modal-item-label">' + label + '</span><span class="shm-modal-item-dur">down</span></div>';
            }).join('') + '</div>';
        }
        var masks = shmDerivedMasks(msg, cl);
        $('#shmClusterModalBody').html(section('Network', shmModemDownItems(cl, masks)) + section('IOT Devices', shmA10DownItems(cl, masks)));
        $('#shmClusterModalOverlay').addClass('open');
    }

    // Colour comes from `masked` FIRST, then `flag`. A masked channel is suppressed from
    // alerting — it is neither a real "up" nor a real "down".
    function shmColorFor(flag, masked) {
        if (masked) return 'grey';
        return Number(flag) === 1 ? 'grn' : 'red';
    }

    // ── FAULTY SENSOR POPUP ──────────────────────────────────────────────
    // siteId(string) -> { sensorTotal, sensorOnline, sensorDown, updateTime, faults: { "assetId|attId": {...} } }
    var shmSensorHealthState = {};
    var shmSensorCurrentSiteId = null;
    var shmSensorGroupMode = 'asset'; // 'asset' | 'cluster'
    // Which groups are expanded, per mode, so live WS updates re-rendering the list
    // don't collapse whatever the user had open.
    var shmSensorExpandedGroups = { asset: {}, cluster: {} };

    function shmHandleSensorMessage(siteId, batch) {
        var summaryTouched = false, popupTouched = false;
        shmUnwrapBatch(batch).forEach(function (msg) {
            if (!msg) return;
            if (msg.siteId == null && siteId == null) return;   // global socket: every real message carries siteId
            var skey = String(msg.siteId != null ? msg.siteId : siteId);
            if (!shmSensorHealthState[skey]) {
                shmSensorHealthState[skey] = { sensorTotal: 0, sensorOnline: 0, sensorDown: 0, updateTime: null, faults: {} };
            }
            var siteState = shmSensorHealthState[skey];

            if (msg.type === 'sensorHealthSummary' && msg.summary) {
                siteState.sensorTotal = msg.summary.sensorTotal || 0;
                siteState.sensorOnline = msg.summary.sensorOnline || 0;
                siteState.sensorDown = msg.summary.sensorDown || 0;
                siteState.updateTime = msg.updateTime;
                summaryTouched = true;
            }
            else if (msg.type === 'sensorHealth') {
                var key = msg.assetId + '|' + msg.attId;
                if (Number(msg.active) === 1) {
                    siteState.faults[key] = {
                        assetId: msg.assetId,
                        attId: msg.attId,
                        assetTypeId: msg.assetTypeId,
                        assetName: msg.assetName || ('Asset #' + msg.assetId),
                        assetAttributeName: (msg.aliasName && msg.aliasName.trim())
                            ? msg.aliasName
                            : (msg.assetAttributeName || ('Attribute #' + msg.attId)),
                        clusterName: msg.clusterName || '',
                        setTime: msg.setTime,
                        setValue: msg.setValue
                    };
                } else {
                    delete siteState.faults[key];
                }
                siteState.updateTime = msg.updateTime || siteState.updateTime;
            }

            if (shmSensorCurrentSiteId != null && String(shmSensorCurrentSiteId) === skey) popupTouched = true;
        });

        // The global socket carries every station, so re-render once per batch, not per message.
        if (popupTouched) shmRenderSensorList();   // popup open on a station that just changed
        if (summaryTouched) recomputeSensorHealth();
    }

    function openSensorHealthModal() {
        resolveOrPickSite(function (siteId) {
            shmConnectHealthSockets(siteId);   // connect this station's sockets (no-op if already subscribed)
            shmSensorCurrentSiteId = String(siteId);
            $('#shmSensorModalOverlay').addClass('open');
            $('body').css('overflow', 'hidden');
            shmRenderSensorList();
        });
    }

    function closeSensorHealthModal() {
        $('#shmSensorModalOverlay').removeClass('open');
        $('body').css('overflow', '');
        shmSensorCurrentSiteId = null;
    }

    function shmRenderSensorList() {
        var s = shmSensorHealthState[String(shmSensorCurrentSiteId)];
        if (!s) {
            $('#shmSensorStatRow,#shmSensorUpdatedAt').html('');
            $('#shmSensorList').html('<div class="shm-empty">Waiting for live data from this station&hellip;</div>');
            return;
        }
        $('#shmSensorUpdatedAt').text(s.updateTime ? ('Updated: ' + s.updateTime) : '');
        $('#shmSensorStatRow').html(
            '<div class="shm-stat-card"><div class="shm-stat-label">Total sensors</div><div class="shm-stat-value">' + s.sensorTotal + '</div></div>' +
            '<div class="shm-stat-card ' + (s.sensorDown > 0 ? 'warn' : '') + '"><div class="shm-stat-label">Faulty</div><div class="shm-stat-value">' + s.sensorDown + '</div></div>'
        );

        var faultKeys = Object.keys(s.faults);
        if (!faultKeys.length) {
            $('#shmSensorList').html('<div class="shm-empty">&#10003; All sensors healthy.</div>');
            return;
        }

        function sensorItemHtml(f, showCluster) {
            var attrLine = shmResolvePmDisplayName(f);
            return '<div class="shm-sensor-item"><span class="shm-sensor-dot"></span>' +
                '<div><div class="shm-sensor-asset">' + f.assetName + '</div>' +
                '<div class="shm-sensor-attr">' + attrLine + '</div>' +
                (showCluster && f.clusterName ? '<div class="shm-sensor-cluster">' + f.clusterName + '</div>' : '') +
                '</div></div>';
        }

        // Group key + item list differ by mode; the collapsible group shell is shared.
        var groups = {};
        var groupByCluster = shmSensorGroupMode === 'cluster';
        faultKeys.forEach(function (key) {
            var f = s.faults[key];
            var groupKey = groupByCluster ? (f.clusterName || 'No cluster') : f.assetName;
            if (!groups[groupKey]) groups[groupKey] = [];
            groups[groupKey].push(f);
        });

        var groupNames = Object.keys(groups).sort(function (a, b) {
            if (a === 'No cluster') return 1;
            if (b === 'No cluster') return -1;
            return a.localeCompare(b);
        });

        var expandedMap = shmSensorExpandedGroups[shmSensorGroupMode];
        $('#shmSensorList').html(groupNames.map(function (groupKey) {
            var items = groups[groupKey];
            var isOpen = !!expandedMap[groupKey];
            var itemsHtml = items.map(function (f) { return sensorItemHtml(f, !groupByCluster); }).join('');
            return '<div class="shm-sensor-group' + (isOpen ? ' open' : '') + '">' +
                '<div class="shm-sensor-group-head" data-group="' + groupKey.replace(/"/g, '&quot;') + '">' +
                '<span class="shm-sensor-caret">&#9656;</span>' +
                '<span class="shm-sensor-group-title">' + groupKey + '</span>' +
                '<span class="shm-sensor-group-count">' + items.length + '</span>' +
                '</div>' +
                '<div class="shm-sensor-group-body' + (isOpen ? '' : ' collapsed') + '">' + itemsHtml + '</div>' +
                '</div>';
        }).join(''));
    }

    // ── WIRING ───────────────────────────────────────────────────────────
    $(function () {
        $('#shmGrid').on('click', '.shm-c-offline', function () { shmOpenClusterModal($(this).data('cluster-id')); });
        $('#shmClusterModalClose').on('click', function () { $('#shmClusterModalOverlay').removeClass('open'); });
        $('#shmClusterModalOverlay').on('click', function (e) { if (e.target === this) $(this).removeClass('open'); });
        $('#shmModalOverlay').on('click', function (e) { if (e.target === this) closeSiteHealthModal(); });
        $('#shmSensorModalOverlay').on('click', function (e) { if (e.target === this) closeSensorHealthModal(); });

        function shmWireSegment(id, key) {
            var $group = $('#' + id);
            $group.on('click', '.shm-seg-btn', function () {
                $group.find('.shm-seg-btn').removeClass('active');
                $(this).addClass('active');
                shmFilters[key] = $(this).data('value');
                shmRenderGrid();
            });
        }
        shmWireSegment('shmFilterStatus', 'status');
        shmWireSegment('shmFilterIssue', 'issue');
        shmWireSegment('shmFilterSort', 'sort');

        var shmSearchDebounce = null;
        $('#shmSearch').on('input', function () {
            clearTimeout(shmSearchDebounce);
            var val = this.value;
            shmSearchDebounce = setTimeout(function () { shmFilters.search = val.trim(); shmRenderGrid(); }, 150);
        });

        $('#shmBtnRefresh').on('click', function () {
            var msg = groupHealthState[String(shmCurrentSiteId)];
            if (msg) shmRenderAll(msg);
        });

        $('#shmSensorGroupToggle').on('click', '.shm-seg-btn', function () {
            $('#shmSensorGroupToggle .shm-seg-btn').removeClass('active');
            $(this).addClass('active');
            shmSensorGroupMode = $(this).data('value');
            shmRenderSensorList();
        });

        $('#shmSensorList').on('click', '.shm-sensor-group-head', function () {
            var groupKey = $(this).data('group');
            shmSensorExpandedGroups[shmSensorGroupMode][groupKey] = !shmSensorExpandedGroups[shmSensorGroupMode][groupKey];
            shmRenderSensorList();
        });

        $(document).on('keydown', function (e) {
            if (e.key !== 'Escape') return;
            if ($('#shmClusterModalOverlay').hasClass('open')) { $('#shmClusterModalOverlay').removeClass('open'); return; }
            if ($('#shmSensorModalOverlay').hasClass('open')) { closeSensorHealthModal(); return; }
            if ($('#shmModalOverlay').hasClass('open')) closeSiteHealthModal();
        });
    });
</script>
