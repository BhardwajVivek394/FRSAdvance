<script type="text/javascript">
    var isSecure = window.location.protocol === "https:";
    var APP_CONFIG = {};
    if (isSecure) {
        APP_CONFIG = {
            ProxyBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["ProxyBaseUrlSSL"]',
            WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrlSSL"]',
            WebSocketAuthToken: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketAuthToken"]'
        };
    } else {
        APP_CONFIG = {
            ProxyBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["ProxyBaseUrl"]',
            WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrl"]',
            WebSocketAuth: null
        };
    }
var activeTabSiteId = null;
var barChart, openDropdown = null;
var alertPredictive = '@E7FRSAdvance.Utility.Utility.AlertType.Predictive.GetHashCode()';
var alertFail       = '@E7FRSAdvance.Utility.Utility.AlertType.Failure.GetHashCode()';
var trackAssetType  = '@E7FRSAdvance.Utility.Utility.AssetType.TRACK.GetHashCode()';
var pointAssetType  = '@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()';
var signalAssetType = '@E7FRSAdvance.Utility.Utility.AssetType.SIGNAL.GetHashCode()';
var assetTypes      = @Html.Raw(Json.Encode(ViewBag.FRSAssetType as List<Domain.AssetType>));
var globalAssetData = null;

// Design tokens (aurora — read by echarts)
    var CLRS = {
        green: '#34d399',
        amber: '#fbbf24',
        red: '#fb7185',
        blue: '#22d3ee',
        muted: 'rgba(255,255,255,0.36)',
        text: 'rgba(255,255,255,0.52)',
        grid: 'rgba(255,255,255,0.06)',
        bg: 'transparent',
        tipBg: '#0a0f24',
        tipBorder: '#22d3ee',
        tipText: '#f0f4ff'
    };
    function updateClrsForTheme() {
        var _t2 = document.documentElement.getAttribute('data-aurora') || document.documentElement.getAttribute('data-theme') || 'dark';
        var light = _t2 === 'light';
        CLRS.muted = light ? 'rgba(15,23,42,0.36)' : 'rgba(255,255,255,0.36)';
        CLRS.text = light ? 'rgba(15,23,42,0.52)' : 'rgba(255,255,255,0.52)';
        CLRS.grid = light ? 'rgba(15,23,42,0.06)' : 'rgba(255,255,255,0.06)';
        CLRS.tipBg = light ? 'rgba(240,244,255,0.98)' : 'rgba(8,12,30,0.96)';
        CLRS.tipBorder = light ? 'rgba(26,115,232,0.40)' : 'rgba(34,211,238,0.40)';
        CLRS.tipText = light ? 'rgba(15,23,42,0.92)' : 'rgba(255,255,255,0.92)';
    }
updateClrsForTheme();
// ─── THEME TOGGLE ─────────────────────────────
function toggleTheme() {
  var root = document.documentElement;
  var _cur = root.getAttribute('data-aurora') || root.getAttribute('data-theme') || 'dark';
  var isDark = _cur !== 'light';
  var next = isDark ? 'light' : 'dark';
  root.setAttribute('data-aurora', next);
  root.setAttribute('data-theme', next);
  if (document.body) { document.body.setAttribute('data-aurora', next); document.body.setAttribute('data-theme', next); }
  try { localStorage.setItem('e7-theme-pref', next); } catch(e) {}
  var icon = document.getElementById('themeIcon');
  if (icon) icon.className = isDark ? 'fas fa-moon' : 'fas fa-sun';
  updateClrsForTheme();
}
// Set initial icon state
(function(){
  var icon = document.getElementById('themeIcon');
  if (icon) { var _ti = document.documentElement.getAttribute('data-aurora') || document.documentElement.getAttribute('data-theme') || 'dark'; icon.className = (_ti === 'light') ? 'fas fa-moon' : 'fas fa-sun'; }
})();

var datePickerState = { preset: 'today', fromDate: null, toDate: null };
(function () {
  var t = new Date(); t.setHours(0,0,0,0);
  datePickerState.fromDate = new Date(t); datePickerState.toDate = new Date(t);
})();

function pad(n) { return (n < 10 ? '0' : '') + n; }
function formatDDMMYYYY(d) { return pad(d.getDate()) + '/' + pad(d.getMonth()+1) + '/' + d.getFullYear(); }
function formatApiDate(d)   { return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T00:00:00'; }
function formatApiEndDate(d){ return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T23:59:59'; }

// Live clock
(function clk(){var e=document.getElementById('liveClock');if(e){var n=new Date();e.textContent=n.toLocaleTimeString('en-IN',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});}setTimeout(clk,1000);})();
// Search debounce
var _sBusy=false;
function onSearchClick(b){if(_sBusy)return;_sBusy=true;if(b)b.disabled=true;buildSiteCache();renderSiteTabs();fnBindAssetAndAlertCount();setTimeout(function(){_sBusy=false;if(b)b.disabled=false;},3000);}
    $(document).ready(function () {
  fnBindAssetAndAlertCount();
  setTimeout(initDatePicker, 100);
  buildSiteCache();
  renderSiteTabs();

  $('.select-btn').on('click', function (e) { e.stopPropagation(); toggleDD($(this).data('target'), this); });

  // Close dropdown when clicking the backdrop (outside the dropdown)
  $('#backdrop').on('click', closeDD);

  $('#chkAllZone').on('change',     function () { selectAll('zone',     this.checked); });
  $('#chkAllDivision').on('change', function () { selectAll('division', this.checked); });
  $('#chkAllSite').on('change',     function () { selectAll('site',     this.checked); });

  $(document).on('click', '.filter-dropdown', function (e) { e.stopPropagation(); });

  $(document).on('click', '.dropdown-item', function (e) {
    e.stopPropagation();
    var $cb = $(this).find('input[type="checkbox"]');
    if (!$(e.target).is('input')) $cb.prop('checked', !$cb.prop('checked'));
    $(this).toggleClass('checked', $cb.prop('checked'));
    var type = ($cb.attr('class') || '').replace('cb-', '');
    updateSelectAllState(type); updateText(type); onFilterChange(type);
  });

  waitForOwl();
  $(window).on('resize', function () { resizeDashboardCharts(); });
});

function resizeDashboardCharts() {
  ['TotalAssets','SensorChart','SensorIoT','SensorNetworkChart','GatwayNetwork'].forEach(function (id) {
    var dom = document.getElementById(id);
    if (dom) { var inst = echarts.getInstanceByDom(dom); if (inst) inst.resize(); }
  });
  // Also resize every per-asset-type donut (Main-Track, Main-Signal, ...)
  document.querySelectorAll('.gaph-assetType[id^="Main-"]').forEach(function (dom) {
    var inst = echarts.getInstanceByDom(dom);
    if (inst) inst.resize();
  });
}

var _owlRetryCount = 0;
function waitForOwl() {
  if (typeof $ === 'undefined' || typeof $.fn === 'undefined') { _owlRetryCount++; if (_owlRetryCount > 100) return; setTimeout(waitForOwl, 100); return; }
  if (typeof $.fn.owlCarousel !== 'undefined') { setTimeout(initOwlCarousel, 50); }
  else { _owlRetryCount++; if (_owlRetryCount > 100) return; setTimeout(waitForOwl, 100); }
}

function initOwlCarousel() {
  var $c = $('#dashboardCarousel');
  if (!$c.length || $c.hasClass('owl-loaded')) return;
  try {
    $c.on('initialized.owl.carousel changed.owl.carousel translated.owl.carousel resized.owl.carousel', function () {
      setTimeout(resizeDashboardCharts, 50);
      setTimeout(resizeDashboardCharts, 350);
    });
    $c.owlCarousel({
      loop: false, rewind: true, margin: 14, autoplay: false, smartSpeed: 600,
      nav: true, dots: true,
      navText: ['<i class="fas fa-chevron-left"></i>', '<i class="fas fa-chevron-right"></i>'],
      responsive: { 0: { items: 1 }, 768: { items: 2 }, 1200: { items: 3 } }
    });
  } catch (err) { if (_owlRetryCount < 5) { _owlRetryCount++; setTimeout(initOwlCarousel, 500); } }
}

// ==================== DATEPICKER ====================
function initDatePicker() {
  if (typeof $.fn.datepicker === 'undefined') { setTimeout(initDatePicker, 200); return; }
  var $from = $('#dpFromDate'), $to = $('#dpToDate');
  if (!$from.length || !$to.length) return;
  try { $from.datepicker('destroy'); $to.datepicker('destroy'); } catch (e) {}
  var today = new Date(); today.setHours(0,0,0,0);
  var dpFmt = {
    toDisplay: function (d) { if (!d) return ''; var x = new Date(d); return isNaN(x.getTime()) ? '' : pad(x.getDate())+'/'+pad(x.getMonth()+1)+'/'+x.getFullYear(); },
    toValue:   function (d) { if (!d) return null; if (d instanceof Date) return d; var p = d.split('/'); return p.length===3 ? new Date(+p[2],+p[1]-1,+p[0]) : null; }
  };
  $from.datepicker({ format: dpFmt, autoclose: true, todayHighlight: true, endDate: today, container: 'body', zIndexOffset: 10002 })
       .on('changeDate', function (e) { if (e.date) { $to.datepicker('setStartDate', e.date); var td = $to.datepicker('getDate'); if (td && td < e.date) $to.datepicker('setDate', e.date); } });
  $to.datepicker({ format: dpFmt, autoclose: true, todayHighlight: true, endDate: today, container: 'body', zIndexOffset: 10002 });
  $from.datepicker('setDate', today); $to.datepicker('setDate', today);

  $('#dpBtn').off('click').on('click', function (e) {
    e.stopPropagation();
    var $dd = $('#dpDropdown');
    if ($dd.hasClass('open')) closeDatePicker(); else { $dd.addClass('open'); $(this).addClass('active'); $('#dpBackdrop').addClass('show'); }
  });
  $('#dpBackdrop').off('click').on('click', closeDatePicker);
  $('.dp-option').off('click').on('click', function (e) {
    e.stopPropagation();
    var preset = $(this).data('preset');
    if (preset === 'custom') { $('#dpCustomPanel').addClass('show'); $('.dp-option').removeClass('active'); $(this).addClass('active'); }
    else applyPreset(preset);
  });
  $('#dpApplyBtn').off('click').on('click', function (e) { e.stopPropagation(); applyCustom(); });
  $('#dpDropdown').off('click').on('click', function (e) { e.stopPropagation(); });
  $(document).off('click.dpcal').on('click.dpcal', '.datepicker,.datepicker-dropdown', function (e) { e.stopPropagation(); });
}

function closeDatePicker() { $('#dpDropdown').removeClass('open'); $('#dpBtn').removeClass('active'); $('#dpBackdrop').removeClass('show'); $('#dpCustomPanel').removeClass('show'); }

function applyPreset(preset) {
  var today = new Date(); today.setHours(0,0,0,0);
  var from, to, text;
  if      (preset==='today')     { from=new Date(today); to=new Date(today); text='Today'; }
  else if (preset==='yesterday') { from=new Date(today); from.setDate(from.getDate()-1); to=new Date(from); text='Yesterday'; }
  else if (preset==='last7days') { from=new Date(today); from.setDate(from.getDate()-6); to=new Date(today); text='Last 7 Days'; }
  else                           { from=new Date(today); to=new Date(today); text='Today'; }
  datePickerState.preset=preset; datePickerState.fromDate=from; datePickerState.toDate=to;
  $('.dp-option').removeClass('active'); $('.dp-option[data-preset="'+preset+'"]').addClass('active');
  $('#dpCustomPanel').removeClass('show'); $('#dpText').text(text);
  $('#dpFromDate').datepicker('setDate', from); $('#dpToDate').datepicker('setDate', to);
  closeDatePicker(); loadFilteredData();
}

function parseInputDate(s) {
  if (!s) return null; s=s.trim();
  var p=s.indexOf('-')>-1?s.split('-'):s.split('/');
  if (p.length!==3) return null;
  var p0=+p[0],p1=+p[1],p2=+p[2]; if (isNaN(p0)||isNaN(p1)||isNaN(p2)) return null;
  var day,month,year;
  if (p2>100) { year=p2;day=p0;month=p1; } else if (p0>100) { year=p0;month=p1;day=p2; } else return null;
  if (month<1||month>12||day<1||day>31) return null;
  var d=new Date(year,month-1,day); return (d.getFullYear()===year&&d.getMonth()===month-1&&d.getDate()===day)?d:null;
}

function applyCustom() {
  var fromStr=$('#dpFromDate').val(), toStr=$('#dpToDate').val();
  if (!fromStr) { alert('Please select From date'); return; }
  if (!toStr)   { alert('Please select To date');   return; }
  var from=parseInputDate(fromStr), to=parseInputDate(toStr);
  if (!from) { alert('Invalid From date'); return; }
  if (!to)   { alert('Invalid To date');   return; }
  from.setHours(0,0,0,0); to.setHours(0,0,0,0);
  var now=new Date(); now.setHours(23,59,59,999);
  if (from>now) { alert('From date cannot be in the future'); return; }
  if (to>now)   { alert('To date cannot be in the future');   return; }
  if (from>to)  { alert('From date cannot be after To date'); return; }
  datePickerState.preset='custom'; datePickerState.fromDate=new Date(from); datePickerState.toDate=new Date(to);
  var text=from.toDateString()===to.toDateString()?formatDDMMYYYY(from):formatDDMMYYYY(from)+' – '+formatDDMMYYYY(to);
  $('#dpText').text(text); closeDatePicker(); loadFilteredData();
}

function loadFilteredData() {
  var params = { SearchCriteria: { ZoneIds: getValues('zone'), DivisionIds: getValues('division'), SiteIds: getValues('site') } };
  $("#loader").show();
  $.ajax({
    url: '/FRS25/Home/GetWithOutAcknowledgementAlert', type: 'POST', contentType: 'application/json',
    data: JSON.stringify(params),
    success: function (data) {
      $("#loader").hide();
      var totalP=0,totalF=0,totalA=0;
      $(assetTypes).each(function (i,at) {
        if (globalAssetData) { var f=globalAssetData.find(function(a){return a.AssetTypeId==at.Id;}); totalA+=f?f.Count:0; }
        var pM={},fM={};
        data.forEach(function(d){ if(d.AssetTypeId==at.Id){ if(d.AlertTypeId==alertPredictive)pM[d.AssetId]=1; if(d.AlertTypeId==alertFail)fM[d.AssetId]=1; } });
        totalP+=Object.keys(pM).length; totalF+=Object.keys(fM).length;
      });
      updateTotalAssetsCard({ TotalAsset:totalA, Predictive:totalP, Fail:totalF });
      updateTotalAssetsChart({ TotalAsset:totalA, Predictive:totalP, Fail:totalF });
    },
    error: function () { $("#loader").hide(); }
  });
}

function updateTotalAssetsChart(d) {
