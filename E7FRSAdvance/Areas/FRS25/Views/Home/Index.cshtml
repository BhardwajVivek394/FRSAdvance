// ==================== UTILITY ====================
function updateProgressCircle(id, pct, color) {
  pct=Math.max(0,Math.min(100,parseFloat(pct)||0));
  if(!color) color=pct<50?CLRS.green:pct<80?CLRS.amber:CLRS.red;
  var el=document.getElementById(id);
  if(el){el.style.setProperty('--percent',pct);el.style.setProperty('--color',color);
    // the surrounding .gauge tile shows the same status (same thresholds as the ring
    // colour) as its border + percentage colour — see .gauge[data-status] in the theme CSS
    var tile=el.closest('.gauge'); if(tile) tile.setAttribute('data-status', pct<50?'ok':pct<80?'warn':'bad');}
}
function formatNumber(n){return(n||0).toString().replace(/\B(?=(\d{3})+(?!\d))/g,',');}
// A station tab wins; otherwise the checked stations; otherwise "All Stations" —
// sent as an EMPTY list, which this backend already reads as "every station this user
// may see" (it scopes by UserId/RoleId server-side).
//
// Do not "helpfully" expand this to every id in the dropdown the way the web dashboard
// does. GetRDPMSHealthLive skips its expensive Asset/GetRDPMSHealthLiveDetails call
// entirely for an admin with an empty SiteIds; handing it a full list turns page load
// into an unpaged whole-estate query (Take = -1, MaxJsonLength = int.MaxValue).
function getEffectiveSiteIds(){
  if(activeTabSiteId) return [activeTabSiteId];
  return getValues('site');
}
// Every station value present in the dropdown, checked or not. Used for the station
// tabs, never for query scoping.
function getAllSiteValues(){
  var v=[];
  $('#listSite .dropdown-item').each(function(){ var d=$(this).data('value'); if(d!==undefined&&d!==null) v.push(d.toString()); });
  return v;
}

