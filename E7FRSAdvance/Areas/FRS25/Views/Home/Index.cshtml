var _alertCurrentAssetTypeId=null, _alertCurrentAssetTypeName='';

    $(document).on('click', '.asset-type-card .five-cards', function () {
        var $card = $(this).closest('.asset-type-card');
        var assetTypeId = $card.data('asset-type-id');
        var title = $card.find('.f-style').clone().children().remove().end().text().trim() || $card.data('asset-type-name') || 'Alerts';
        openAlertModal(assetTypeId, title);
    });

    function openAlertModal(assetTypeId, title) {
        _alertCurrentAssetTypeId = assetTypeId; _alertCurrentAssetTypeName = title;
        $('#alertModalTitle').text(title);
        $('#alertBadgeTotal,#alertBadgePred,#alertBadgeFail').text('0');
        $('#alertModalBody').html('<div class="alert-modal-loading"><span class="alert-modal-spinner"></span>Loading alerts…</div>');
        $('#alertModalOverlay').addClass('open'); $('body').css('overflow', 'hidden');
        $.ajax({
            url: '/FRS25/Home/GetAlertDetails', type: 'POST', contentType: 'application/json',
            data: JSON.stringify({ SearchCriteria: { AssetTypeId: assetTypeId, ZoneIds: getValues('zone'), DivisionIds: getValues('division'), SiteIds: getEffectiveSiteIds(), Pager: { Take: -1 } } }),
            success: function (resp) { renderAlertModal(resp); },
            error: function (xhr) { $('#alertModalBody').html('<div class="alert-modal-empty"><i class="fas fa-exclamation-triangle" style="font-size:28px;color:var(--red);margin-bottom:8px;"></i><br>Failed to load alerts (HTTP ' + xhr.status + ').</div>'); }
        });
    }

    function renderAlertModal(resp) {
        var items = [];
        if (Array.isArray(resp)) items = resp;
        else if (resp) {
            var raw = resp.mFRSAlerts || resp.MFRSAlerts || resp.fRSAlerts || resp.FRSAlerts || resp.Alerts || resp.alerts || resp.Record || resp.Data || [];
            if (typeof raw === 'string') { try { raw = JSON.parse(raw); } catch (e) { raw = []; } }
            items = Array.isArray(raw) ? raw : [];
        }
        items = items.map(function (it) {
            return {
                AlertTypeId: it.AlertTypeId || it.alertTypeId || 0, AssetId: it.AssetId || it.assetId || 0,
                AssetName: it.AssetName || it.assetName || it.StationName || it.stationName || it.Name || it.name || '',
                AlertDate: it.AlertDate || it.alertDate || it.CreatedDate || it.createdDate || it.Date || it.date || '',
                CauseCode: it.CauseCode || it.causeCode || it.AlertCode || it.alertCode || '',
                AlertMessage: it.AlertMessage || it.alertMessage || it.Message || it.message || it.Description || it.description || '',
                AlertTimestamp: it.SetTimeStamp || it.AlertDate || it.alertDate || it.CreatedDate || '',
                SetAlertMessage: it.setAlertMessage || it.SetAlertMessage || it.AlertMessage || it.alertMessage || it.Message || it.message || ''
            };
        });
        var predCount = 0, failCount = 0;
        items.forEach(function (it) {
            if (String(it.AlertTypeId) === String(alertPredictive)) predCount++;
            if (String(it.AlertTypeId) === String(alertFail)) failCount++;
        });
        $('#alertBadgeTotal').text(predCount + failCount); $('#alertBadgePred').text(predCount); $('#alertBadgeFail').text(failCount);
        if (!items.length) { $('#alertModalBody').html('<div class="alert-modal-empty"><i class="fas fa-check-circle" style="font-size:32px;color:var(--green);margin-bottom:8px;"></i><br>No active alerts found.</div>'); return; }
        var groups = {}, groupOrder = [];
        items.forEach(function (it) {
            var label = 'Date: --';
            if (it.AlertDate) { var d = new Date(it.AlertDate); if (!isNaN(d.getTime())) label = 'Date: ' + pad(d.getDate()) + '-' + pad(d.getMonth() + 1) + '-' + d.getFullYear(); }
            if (!groups[label]) { groups[label] = []; groupOrder.push(label); }
            groups[label].push(it);
        });
        var html = '';
        groupOrder.forEach(function (dateLabel) {
            html += '<div class="alert-date-label">' + dateLabel + '</div>';
            groups[dateLabel].forEach(function (it, idx) {
                var isPred = String(it.AlertTypeId) === String(alertPredictive);
                var typeCls = isPred ? 'predictive' : 'failure', typeText = isPred ? 'Predictive' : 'Failure';
                var uid = 'ali' + idx + '_' + String(Date.now()).slice(-6);
                var timeStr = '', tsStr = '';
                if (it.AlertDate) { var dt = new Date(it.AlertDate); if (!isNaN(dt.getTime())) timeStr = pad(dt.getDate()) + '-' + pad(dt.getMonth() + 1) + '-' + dt.getFullYear() + ' ' + pad(dt.getHours()) + ':' + pad(dt.getMinutes()); }
                if (it.AlertTimestamp) { var ts = new Date(it.AlertTimestamp); if (!isNaN(ts.getTime())) tsStr = pad(ts.getDate()) + '-' + pad(ts.getMonth() + 1) + '-' + ts.getFullYear() + ' ' + pad(ts.getHours()) + ':' + pad(ts.getMinutes()) + ':' + pad(ts.getSeconds()); else tsStr = it.AlertTimestamp; }
                var alertMsg = it.SetAlertMessage || it.AlertMessage;
                var shortMsg = alertMsg && alertMsg.length > 140 ? alertMsg.substring(0, 140) + '…' : alertMsg;
                var hasMore = alertMsg && alertMsg.length > 140;
                html += '<div class="alert-item" id="' + uid + '">';
                html += '<div class="alert-item-header" onclick="toggleAlertItem(\'' + uid + '\')">';
                html += '<div><div class="alert-item-name"><i class="fas fa-microchip" style="color:var(--blue);font-size:11px;margin-right:6px;"></i>' + (it.AssetName || 'Asset ' + it.AssetId) + '</div>';
                if (it.AssetName && it.AssetId) html += '<div class="alert-item-sub">ID: ' + it.AssetId + '</div>';
                html += '</div>';
                html += '<span class="alert-item-right"><span class="alert-type-badge ' + typeCls + '">' + typeText + '</span><i class="fas fa-chevron-down alert-chevron"></i></span></div>';
                html += '<div class="alert-item-detail"><div class="alert-detail-grid">';
                if (it.CauseCode) html += '<div class="alert-detail-card"><div class="detail-label"><i class="fas fa-code" style="margin-right:4px;"></i>Cause Code</div><div class="detail-value">' + it.CauseCode + '</div></div>';
                html += '<div class="alert-detail-card"><div class="detail-label"><i class="fas fa-clock" style="margin-right:4px;"></i>Timestamp</div><div class="detail-value">' + (tsStr || timeStr || '—') + '</div></div>';
                if (alertMsg) {
                    html += '<div class="alert-detail-card full-width"><div class="detail-label"><i class="fas fa-bell" style="margin-right:4px;"></i>Alert Message</div><div class="detail-value">';
                    html += '<span class="alert-msg-short">' + shortMsg + '</span><span class="alert-msg-full">' + alertMsg + '</span>';
                    if (hasMore) html += '<br/><button class="alert-read-more" onclick="toggleReadMore(event,\'' + uid + '\')">Read More <i class="fas fa-chevron-down" style="font-size:9px;"></i></button>';
                    html += '</div></div>';
                }
                html += '</div></div></div>';
            });
        });
        $('#alertModalBody').html(html);
    }

    function toggleAlertItem(uid) { $('#' + uid).toggleClass('expanded'); }
    function toggleReadMore(e, uid) {
        e.stopPropagation(); var $el = $('#' + uid); $el.toggleClass('msg-expanded');
        $el.find('.alert-read-more').html($el.hasClass('msg-expanded') ? 'Read Less <i class="fas fa-chevron-up" style="font-size:9px;"></i>' : 'Read More <i class="fas fa-chevron-down" style="font-size:9px;"></i>');
    }
    function closeAlertModal() { $('#alertModalOverlay').removeClass('open'); $('body').css('overflow', ''); }
    function onClickRemarks() { if (_alertCurrentAssetTypeId) window.location.href = '/FRS25/Alerts/Index'; }
    $('#alertModalOverlay').on('click', function (e) { if ($(e.target).is('#alertModalOverlay')) closeAlertModal(); });

