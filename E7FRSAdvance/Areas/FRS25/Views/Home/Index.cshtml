<script type="text/javascript">
    var isSecure = window.location.protocol === "https:";
    var APP_CONFIG = {};
    if (isSecure) {
        APP_CONFIG = {
            ProxyBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["ProxyBaseUrlSSL"]',
            WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrlSSL"]',
            WebSocketAuthToken: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketAuthToken"]'
        };
    } else {
        APP_CONFIG = {
            ProxyBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["ProxyBaseUrl"]',
            WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrl"]',
            WebSocketAuth: null
        };
    }
var activeTabSiteId = null;
var barChart, openDropdown = null;
var alertPredictive = '@E7FRSAdvance.Utility.Utility.AlertType.Predictive.GetHashCode()';
var alertFail       = '@E7FRSAdvance.Utility.Utility.AlertType.Failure.GetHashCode()';
var trackAssetType  = '@E7FRSAdvance.Utility.Utility.AssetType.TRACK.GetHashCode()';
var pointAssetType  = '@E7FRSAdvance.Utility.Utility.AssetType.POINT_MACHINE.GetHashCode()';
var signalAssetType = '@E7FRSAdvance.Utility.Utility.AssetType.SIGNAL.GetHashCode()';
var assetTypes      = @Html.Raw(Json.Encode(ViewBag.FRSAssetType as List<Domain.AssetType>));
var globalAssetData = null;

// Design tokens (aurora — read by echarts)
    var CLRS = {
        green: '#34d399',
        amber: '#fbbf24',
        red: '#fb7185',
        blue: '#22d3ee',
        muted: 'rgba(255,255,255,0.36)',
        text: 'rgba(255,255,255,0.52)',
        grid: 'rgba(255,255,255,0.06)',
        bg: 'transparent',
        tipBg: '#0a0f24',
        tipBorder: '#22d3ee',
        tipText: '#f0f4ff'
    };
    function updateClrsForTheme() {
        var _t2 = document.documentElement.getAttribute('data-aurora') || document.documentElement.getAttribute('data-theme') || 'dark';
        var light = _t2 === 'light';
        // Energy7 theme palette (mirrors e7-energy7-theme.css bar / text tokens)
        CLRS.green = light ? '#35c9a1' : '#2fc596';
        CLRS.amber = light ? '#f7bb2e' : '#e8ab1e';
        CLRS.red = light ? '#f4697f' : '#f0687e';
        CLRS.blue = light ? '#2f9ec4' : '#5cc0e2';
        CLRS.muted = light ? '#8b98a8' : '#8391a3';
        CLRS.text = light ? '#55657a' : '#aab6c6';
        CLRS.grid = light ? '#eef2f7' : 'rgba(140,175,235,0.12)';
        CLRS.tipBg = light ? '#ffffff' : '#212934';
        CLRS.tipBorder = light ? '#dde3ec' : '#36424f';
        CLRS.tipText = light ? '#22303f' : '#dce4ee';
    }
updateClrsForTheme();
// Tooltip box for every dashboard chart — follows the current theme colours
function e7TipCss() {
    return 'background:' + CLRS.tipBg + ' !important;border:1px solid ' + CLRS.tipBorder + ' !important;' +
        'backdrop-filter:none !important;-webkit-backdrop-filter:none !important;' +
        'box-shadow:0 12px 28px rgba(20,44,74,0.18) !important;border-radius:10px !important;' +
        "font-family:'Inter',sans-serif !important;";
}
// Each chart registers how to redraw itself; a day/night toggle repaints them all
// in the new palette from the data they already have (no re-fetch).
var _e7ChartRedraw = {};
window.addEventListener('e7ThemeChange', function () {
    updateClrsForTheme();
    Object.keys(_e7ChartRedraw).forEach(function (k) { try { _e7ChartRedraw[k](); } catch (e) { } });
});
// ─── THEME TOGGLE ─────────────────────────────
function toggleTheme() {
  var root = document.documentElement;
  var _cur = root.getAttribute('data-aurora') || root.getAttribute('data-theme') || 'dark';
  var isDark = _cur !== 'light';
  var next = isDark ? 'light' : 'dark';
  root.setAttribute('data-aurora', next);
  root.setAttribute('data-theme', next);
  if (document.body) { document.body.setAttribute('data-aurora', next); document.body.setAttribute('data-theme', next); }
  try { localStorage.setItem('e7-theme-pref', next); } catch(e) {}
  var icon = document.getElementById('themeIcon');
  if (icon) icon.className = isDark ? 'fas fa-moon' : 'fas fa-sun';
  updateClrsForTheme();
}
// Set initial icon state
(function(){
  var icon = document.getElementById('themeIcon');
  if (icon) { var _ti = document.documentElement.getAttribute('data-aurora') || document.documentElement.getAttribute('data-theme') || 'dark'; icon.className = (_ti === 'light') ? 'fas fa-moon' : 'fas fa-sun'; }
})();

var datePickerState = { preset: 'today', fromDate: null, toDate: null };
(function () {
  var t = new Date(); t.setHours(0,0,0,0);
  datePickerState.fromDate = new Date(t); datePickerState.toDate = new Date(t);
})();

function pad(n) { return (n < 10 ? '0' : '') + n; }
function formatDDMMYYYY(d) { return pad(d.getDate()) + '/' + pad(d.getMonth()+1) + '/' + d.getFullYear(); }
function formatApiDate(d)   { return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T00:00:00'; }
function formatApiEndDate(d){ return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())+'T23:59:59'; }

