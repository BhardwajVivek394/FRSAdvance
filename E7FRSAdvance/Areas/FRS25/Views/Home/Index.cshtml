    .shm-tooltip-title {
        font-weight: 700;
        font-size: 10.5px;
        margin-bottom: 6px;
        color: var(--text-muted);
    }

    .shm-tip-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 4px;
    }

        .shm-tip-row:last-child {
            margin-bottom: 0;
        }

    .shm-tip-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
    }

        .shm-tip-dot.grn {
            background: var(--green);
        }

        .shm-tip-dot.red {
            background: var(--red);
        }

        .shm-tip-dot.grey {
            background: var(--text-muted);
        }

    .shm-tip-ch {
        font-weight: 600;
        min-width: 62px;
    }

    .shm-tip-detail {
        color: var(--text-muted);
    }

    .shm-tip-num {
        color: var(--text-muted);
        font-weight: 700;
        width: 14px;
    }

    .shm-modal-section {
        margin-bottom: 16px;
    }

        .shm-modal-section:last-child {
            margin-bottom: 0;
        }

        .shm-modal-section h4 {
