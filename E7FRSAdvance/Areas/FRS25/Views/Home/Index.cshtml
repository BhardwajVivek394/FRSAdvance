        $tab.append('<li class="nav-item" role="presentation"><button class="nav-link active border-0" id="btn-site-all" data-site-id="" type="button" role="tab">All Stations</button></li>');

        if (selectedIds.length > 0) {
            allSiteItems.filter(function (s) { return selectedIds.indexOf(s.value) > -1; })
                .forEach(function (site) {
                    $tab.append('<li class="nav-item" role="presentation"><button class="nav-link border-0" id="btn-site-tab-' + site.value + '" data-site-id="' + site.value + '" type="button" role="tab" title="' + escapeHtml(site.text) + '">' + escapeHtml(site.text) + '</button></li>');
                });
        }

        $tab.off('click', '.nav-link').on('click', '.nav-link', function () {
            $tab.find('.nav-link').removeClass('active'); $(this).addClass('active');
            var sid = $(this).data('site-id');
            activeTabSiteId = sid ? sid.toString() : null;
            fnBindAssetAndAlertCount();
        });
    }
    function escapeHtml(str) { return $('<div>').text(str).html(); }
</script>

<script>
    var iotFirst = true, sensorFirst = true, networkFirst = true, gatwayFirst = true;
    var wsConnections = {}, wsReconnectTimers = {}, wsReconnectAttempts = {}, wsIsConnected = {}, wsHeartbeatIntervals = {}, wsLastMessageTimes = {};
    var MAX_RECONNECT_ATTEMPTS = 15, RECONNECT_DELAY = 3000, WS_HEARTBEAT_TIMEOUT = 30000;

    function connectWebSocket(json) {
        disconnectWebSocket();
        var siteIds = (json.GatewaySiteId && json.GatewaySiteId.length > 0) ? json.GatewaySiteId : [];
        if (siteIds.length === 0) { showWsStatus('error'); return; }
        siteIds.forEach(function (siteId) { openWsConnection(siteId, json); });
    }

    function openWsConnection(siteId, json) {
        var key = siteId.toString();

        var wsUrl = window.APP_CONFIG.WebSocketBaseUrl + '/subscribe/AlertLiveSnapshot/' + key;
        if (window.isSecure && window.APP_CONFIG && window.APP_CONFIG.WebSocketAuthToken) {
            var separator = wsUrl.indexOf('?') > -1 ? '&' : '?';
            wsUrl = wsUrl + separator + 'token=' + encodeURIComponent(APP_CONFIG.WebSocketAuthToken);
        }

        wsReconnectAttempts[key] = wsReconnectAttempts[key] || 0; wsLastMessageTimes[key] = Date.now();
        try {
            var ws = new WebSocket(wsUrl); wsConnections[key] = ws;
            ws.onopen = function () {
                wsIsConnected[key] = true; wsReconnectAttempts[key] = 0; wsLastMessageTimes[key] = Date.now(); updateStatusBar();
                if (wsHeartbeatIntervals[key]) clearInterval(wsHeartbeatIntervals[key]);
                wsHeartbeatIntervals[key] = setInterval(function () {
                    if (wsIsConnected[key] && (Date.now() - wsLastMessageTimes[key] > WS_HEARTBEAT_TIMEOUT)) {
                        var conn = wsConnections[key]; if (conn) { conn.onclose = null; conn.close(); }
                        wsConnections[key] = null; wsIsConnected[key] = false; wsReconnectAttempts[key]++; openWsConnection(siteId, json);
                    }
                }, 10000);
            };
            ws.onmessage = function (event) { wsLastMessageTimes[key] = Date.now(); try { handleWsMessage(key, typeof event.data === 'string' ? JSON.parse(event.data) : event.data, json); } catch (e) { } };
            ws.onclose = function (event) {
                wsIsConnected[key] = false; updateStatusBar();
                var fatalCodes = [1008, 4001, 4003, 401]; if (fatalCodes.indexOf(event.code) > -1) return;
                if (event.code !== 1000 && wsReconnectAttempts[key] < MAX_RECONNECT_ATTEMPTS) { wsReconnectAttempts[key]++; var delay = RECONNECT_DELAY * Math.min(wsReconnectAttempts[key], 5); wsReconnectTimers[key] = setTimeout(function () { openWsConnection(siteId, json); }, delay); }
            };
            ws.onerror = function () { wsIsConnected[key] = false; updateStatusBar(); };
        } catch (e) { }
    }

    function handleWsMessage(siteId, batch, json) {
        if (batch.MessageType !== 'InitialSnapshot') return;
        if (!Array.isArray(batch.Alerts) || batch.Alerts.length === 0) return;
        var totalFaltyIot = 0, totalFaultyNetwork = 0, totalFaultyGWNetwork = 0, totalFaultySensor = 0;
        batch.Alerts.filter(function (a) { return a.sourceType === 'Modem_MQTT' && a.alertState === 'Active'; }).forEach(function (a) {
            if (!a.alertIdentifier) return;
            var modemId = extractIdentifier(a.alertIdentifier, 'deviceId');
            if (json.mClusters && modemId && json.mClusters.filter(function (c) { return c.SiteId == a.siteId && c.ModemId == modemId; })[0]) totalFaultyNetwork++;
        });
        batch.Alerts.filter(function (a) { return a.sourceType === 'A10_MQTT' && a.alertState === 'Active'; }).forEach(function (a) {
            if (!a.alertIdentifier) return;
            var a10Id = extractIdentifier(a.alertIdentifier, 'deviceId'), clusterId = extractIdentifier(a.alertIdentifier, 'clusterId');
            if (json.mADCs && a10Id && json.mADCs.filter(function (adc) { return adc.SiteId == a.siteId && adc.ADCNumber == a10Id && (!clusterId || adc.ClusterId == clusterId); })[0]) { totalFaltyIot++; $('#spnA10' + a10Id).text('Faulty'); }
        });
        batch.Alerts.filter(function (a) { return a.sourceType === 'GatewayHealth' && a.alertState === 'Active'; }).forEach(function (a) {
            if (json.GatewaySiteId && json.GatewaySiteId.filter(function (sid) { return sid == a.siteId; })[0]) totalFaultyGWNetwork++;
        });
        batch.Alerts.filter(function (a) { return a.sourceType === 'Tag' && a.alertState === 'Active'; }).forEach(function (a) {
            if (!a.alertDescription) return;
            var aM = a.alertDescription.match(/AssetId:(\d+)/), atM = a.alertDescription.match(/AttributeId:(\d+)/);
            if (!aM || !atM) return;
            if (json.mAssetInfos && json.mAssetInfos.filter(function (info) { return info.SiteId == a.siteId && info.AssetId == aM[1] && info.AssetAttributeId == atM[1]; })[0]) totalFaultySensor++;
        });
        if (fnBindIOTCard({ TotalADC: json.mADCs.length, HelthyCount: json.mADCs.length - totalFaltyIot, FailurCount: totalFaltyIot }) || iotFirst) { iotFirst = false; fnBindIOTChart({ TotalADC: json.mADCs.length, HelthyCount: json.mADCs.length - totalFaltyIot, FailurCount: totalFaltyIot }); }
        if (fnBindNetworkCard({ TotalCluster: json.mClusters.length, HelthyCount: json.mClusters.length - totalFaultyNetwork, FailurCount: totalFaultyNetwork }) || networkFirst) { networkFirst = false; fnBindNetworkChart({ TotalCluster: json.mClusters.length, HelthyCount: json.mClusters.length - totalFaultyNetwork, FailurCount: totalFaultyNetwork }); }
        if (fnBindGatwayCard({ TotalGatway: json.GatewaySiteId.length, HelthyCount: json.GatewaySiteId.length - totalFaultyGWNetwork, FailurCount: totalFaultyGWNetwork }) || gatwayFirst) { gatwayFirst = false; fnBindGatwayChart({ TotalGatway: json.GatewaySiteId.length, HelthyCount: json.GatewaySiteId.length - totalFaultyGWNetwork, FailurCount: totalFaultyGWNetwork }); }
        // Sensor card is now driven by fnGetSensorLiveData() (REST poll every 60s) using ResetTime rule.
        // Previously computed here from mAssetInfos.length + Tag alerts, but that treated ALL asset infos
        // as sensors and produced misleading totals. Kept disabled to avoid overwriting the REST value.
        // if (fnBindSensorCard({ TotalSensor: json.mAssetInfos.length, HelthyCount: json.mAssetInfos.length - totalFaultySensor, FailurCount: totalFaultySensor }) || sensorFirst) { sensorFirst = false; fnBindSensorChart({ TotalSensor: json.mAssetInfos.length, HelthyCount: json.mAssetInfos.length - totalFaultySensor, FailurCount: totalFaultySensor }); }
        resizeDashboardCharts();
    }

    function extractIdentifier(s, key) { var parts = s.split('|'); for (var i = 0; i < parts.length; i++) { var kv = parts[i].split(':'); if (kv[0] === key) return kv[1]; } return ''; }

    function disconnectWebSocket() {
        Object.keys(wsConnections).forEach(function (key) {
            if (wsReconnectTimers[key]) { clearTimeout(wsReconnectTimers[key]); wsReconnectTimers[key] = null; }
            if (wsHeartbeatIntervals[key]) { clearInterval(wsHeartbeatIntervals[key]); wsHeartbeatIntervals[key] = null; }
            var conn = wsConnections[key]; if (conn) { conn.onclose = null; conn.onerror = null; conn.close(1000); wsConnections[key] = null; }
            wsIsConnected[key] = false;
        });
        wsConnections = {};
    }

    function updateStatusBar() {
        var keys = Object.keys(wsConnections), connected = keys.filter(function (k) { return wsIsConnected[k]; }), total = keys.length;
        var $bar = $('#wsStatusBar'); if (!$bar.length) return;
        if (total === 0) { $bar.html('<div class="ws-status-bar ws-error"><span class="ws-dot red"></span><strong>No connections</strong></div>').show(); return; }
        if (connected.length === total) $bar.html('<div class="ws-status-bar ws-live"><span class="ws-dot live"></span><strong>Live</strong> — ' + total + '/' + total + ' sites <small>[ ' + connected.join(', ') + ' ]</small></div>').show();
        else if (connected.length > 0) $bar.html('<div class="ws-status-bar ws-connecting"><span class="ws-dot orange"></span><strong>Partial</strong> — ' + connected.length + '/' + total + ' sites</div>').show();
        else $bar.html('<div class="ws-status-bar ws-error"><span class="ws-dot red"></span><strong>Disconnected</strong> — 0/' + total + ' sites</div>').show();
    }
    function showWsStatus(s) { if (s === 'error') { var $bar = $('#wsStatusBar'); if ($bar.length) $bar.html('<div class="ws-status-bar ws-error"><span class="ws-dot red"></span><strong>Disconnected</strong></div>').show(); } }

    function parseDotNetDate(val) {
        if (!val) return null;
        var m = String(val).match(/\/Date\((-?\d+)([+-]\d{4})?\)\//);
        if (m) { var ms = parseInt(m[1], 10); if (ms <= 0) return null; return new Date(ms); }
        var d = new Date(val); return isNaN(d.getTime()) ? null : d;
    }
</script>

<!-- ══════════════════════════════════════════════════════════════════
     STATION-WISE LIVE HEALTH  (Site Health Modal + Faulty Sensor Modal)
     Ported from E7MRIV2Web /FRS25/Home dashboard.

     Self-contained: it owns its own `deviceHealth` / `sensorHealth`
     WebSocket subscriptions (prefix shmWs*) so it never interferes with
     the AlertLiveSnapshot sockets the carousel cards already use.
     Entry points: openSiteHealthModal() and openSensorHealthModal(),
     both wired onto the carousel stat cards.
══════════════════════════════════════════════════════════════════ -->
<script type="text/javascript">

    // ── Asset attribute value lookup (from GetIOTCount → mAssetInfos) ────
    // WS sensor faults only carry assetId/attributeId — this resolves the
    // live value and the A/B point-machine naming shown in the popup.
    var shmAssetValueLookup = {};       // "AssetId|AssetAttributeId" -> Value
    var shmAssetAttrRowsByAssetId = {}; // AssetId -> [{ AssetAttributeId, name, Value }, ...]

    function shmBuildAssetValueLookup(list) {
        shmAssetValueLookup = {};
        shmAssetAttrRowsByAssetId = {};
        (list || []).forEach(function (item) {
            shmAssetValueLookup[item.AssetId + '|' + item.AssetAttributeId] = item.Value;
            var name = (item.AttributeAliasName && item.AttributeAliasName.trim())
                ? item.AttributeAliasName
                : item.AttributeName;
            if (!shmAssetAttrRowsByAssetId[item.AssetId]) shmAssetAttrRowsByAssetId[item.AssetId] = [];
            shmAssetAttrRowsByAssetId[item.AssetId].push({
                AssetAttributeId: item.AssetAttributeId,
                name: name,
                Value: item.Value
            });
        });
    }

    // Splits "A VPT NWKR" -> { end: 'A', label: 'VPT NWKR' }. null when the name
    // doesn't start with a bare A/B end prefix.
    function shmPmSplitEnd(name) {
        var m = String(name || '').trim().match(/^([AB])\s+(.+)$/i);
        if (!m) return null;
        return { end: m[1].toUpperCase(), label: m[2].trim() };
    }

    // Point Machine (AssetTypeId 3) only: if the opposite-end counterpart on the same
    // asset has the SAME label and SAME value, show them merged as "A/B <label>" —
    // matching the Sensor Health Detail popup convention. Anything else is unchanged.
    function shmResolvePmDisplayName(f) {
        if (Number(f.assetTypeId) !== 3) return f.assetAttributeName;
        var split = shmPmSplitEnd(f.assetAttributeName);
        if (!split) return f.assetAttributeName;

        var rows = shmAssetAttrRowsByAssetId[f.assetId] || [];
        var ownValue = shmAssetValueLookup[f.assetId + '|' + f.attId];
        var otherEnd = split.end === 'A' ? 'B' : 'A';

        for (var i = 0; i < rows.length; i++) {
            var r = rows[i];
            if (r.AssetAttributeId === f.attId) continue;
            var rSplit = shmPmSplitEnd(r.name);
            if (!rSplit || rSplit.end !== otherEnd) continue;
            if (rSplit.label.toLowerCase() !== split.label.toLowerCase()) continue;
            if (String(r.Value == null ? '' : r.Value).trim() === String(ownValue == null ? '' : ownValue).trim()) {
                return 'A/B ' + split.label;
            }
        }
        return f.assetAttributeName;
    }

    // ── WebSocket plumbing (own maps — keeps AlertLiveSnapshot untouched) ─
    var shmWsConnections = {}, shmWsReconnectTimers = {}, shmWsReconnectAttempts = {},
        shmWsIsConnected = {}, shmWsHeartbeats = {}, shmWsLastMessageTimes = {};
    var SHM_MAX_RECONNECT_ATTEMPTS = 15, SHM_RECONNECT_DELAY = 3000, SHM_HEARTBEAT_TIMEOUT = 30000;

    var shmLastDeviceSiteIds = null, shmLastSensorSiteIds = null;

    // The station this popup can actually show: the selected station tab, or the only
    // station in scope. Null when the dashboard is on "All Stations" with several.
    function shmFocusedSiteId() {
        if (activeTabSiteId) return String(activeTabSiteId);
        var eff = getEffectiveSiteIds();
        return (eff && eff.length === 1) ? String(eff[0]) : null;
    }

    // ONE station's worth of sockets, never a fan-out.
    //
    // Both popups refuse to open unless a single station is in focus, so subscribing
    // per selected station was pure waste: on an account with many stations it opened
    // two sockets each ON TOP of the dashboard's existing per-station AlertLiveSnapshot
    // socket — three times the connections — which is what exhausted the browser
    // (ERR_INSUFFICIENT_RESOURCES) and stalled the load. The web dashboard can fan out
    // because these two topics REPLACE its alert socket; here they are additional.
    function shmConnectHealthSockets() {
        var siteId = shmFocusedSiteId();

        if (!siteId) {
            if (shmLastDeviceSiteIds !== null) {
                shmDisconnectWs('deviceHealth');
                shmDisconnectWs('sensorHealth');
                groupHealthState = {};
                shmSensorHealthState = {};
                shmLastDeviceSiteIds = null;
                shmLastSensorSiteIds = null;
            }
            return;
        }

        if (siteId === shmLastDeviceSiteIds) return; // already subscribed to this station

        shmDisconnectWs('deviceHealth');
        shmDisconnectWs('sensorHealth');
        groupHealthState = {};
        shmSensorHealthState = {};
        shmLastDeviceSiteIds = siteId;
        shmLastSensorSiteIds = siteId;

        shmOpenWs('deviceHealth', siteId, shmHandleDeviceMessage);
        shmOpenWs('sensorHealth', siteId, shmHandleSensorMessage);
    }

    function shmOpenWs(topic, siteId, onMessage) {
        if (!window.APP_CONFIG || !window.APP_CONFIG.WebSocketBaseUrl) return;
        var key = topic + '|' + siteId;
        var wsUrl = window.APP_CONFIG.WebSocketBaseUrl + '/subscribe/' + topic + '/' + siteId;
        if (window.isSecure && window.APP_CONFIG.WebSocketAuthToken) {
            var sep = wsUrl.indexOf('?') > -1 ? '&' : '?';
            wsUrl += sep + 'token=' + encodeURIComponent(window.APP_CONFIG.WebSocketAuthToken);
        }
        shmWsReconnectAttempts[key] = shmWsReconnectAttempts[key] || 0;
        shmWsLastMessageTimes[key] = Date.now();
        try {
            var ws = new WebSocket(wsUrl);
            shmWsConnections[key] = ws;
            ws.onopen = function () {
                shmWsIsConnected[key] = true;
                shmWsReconnectAttempts[key] = 0;
                shmWsLastMessageTimes[key] = Date.now();
                if (shmWsHeartbeats[key]) clearInterval(shmWsHeartbeats[key]);
                shmWsHeartbeats[key] = setInterval(function () {
                    if (shmWsIsConnected[key] && (Date.now() - shmWsLastMessageTimes[key] > SHM_HEARTBEAT_TIMEOUT)) {
                        var conn = shmWsConnections[key];
                        if (conn) { conn.onclose = null; conn.close(); }
                        shmWsConnections[key] = null;
                        shmWsIsConnected[key] = false;
                        shmWsReconnectAttempts[key]++;
                        shmOpenWs(topic, siteId, onMessage);
                    }
                }, 10000);
            };
            ws.onmessage = function (event) {
                shmWsLastMessageTimes[key] = Date.now();
                try { onMessage(siteId, typeof event.data === 'string' ? JSON.parse(event.data) : event.data); } catch (e) { }
            };
            ws.onclose = function (event) {
                shmWsIsConnected[key] = false;
                var fatal = [1008, 4001, 4003, 401];
                if (fatal.indexOf(event.code) > -1) return;
                if (event.code !== 1000 && shmWsReconnectAttempts[key] < SHM_MAX_RECONNECT_ATTEMPTS) {
                    shmWsReconnectAttempts[key]++;
                    var delay = SHM_RECONNECT_DELAY * Math.min(shmWsReconnectAttempts[key], 5);
                    shmWsReconnectTimers[key] = setTimeout(function () { shmOpenWs(topic, siteId, onMessage); }, delay);
                }
            };
            ws.onerror = function () { shmWsIsConnected[key] = false; };
        } catch (e) { }
    }

    // topicPrefix tears down only that topic's sockets, so reconnecting one topic
    // never drops the other's live connection.
    function shmDisconnectWs(topicPrefix) {
        Object.keys(shmWsConnections).forEach(function (key) {
            if (topicPrefix && key.indexOf(topicPrefix + '|') !== 0) return;
            if (shmWsReconnectTimers[key]) { clearTimeout(shmWsReconnectTimers[key]); shmWsReconnectTimers[key] = null; }
            if (shmWsHeartbeats[key]) { clearInterval(shmWsHeartbeats[key]); shmWsHeartbeats[key] = null; }
            var conn = shmWsConnections[key];
            if (conn) { conn.onclose = null; conn.onerror = null; conn.close(1000); }
            shmWsIsConnected[key] = false;
            delete shmWsConnections[key];
        });
    }

    function shmUnwrapBatch(batch) {
        if (batch && batch.MessageType === 'Batch' && Array.isArray(batch.Messages)) {
            var out = [];
            batch.Messages.forEach(function (m) {
                try { out.push(typeof m === 'string' ? JSON.parse(m) : m); } catch (e) { /* skip malformed entry */ }
            });
            return out;
        }
        if (Array.isArray(batch)) return batch;
        return batch ? [batch] : [];
    }

    // ── STATION HEALTH POPUP state ───────────────────────────────────────
    // Per-site cache of the FULL latest groupHealth message (not just the summary),
    // so the popup has cluster / modem / A10 detail available.
    var groupHealthState = {};
    var shmCurrentSiteId = null;
    var shmFilters = { status: 'all', issue: 'any', sort: 'issues', search: '' };

    function shmHandleDeviceMessage(siteId, batch) {
        shmUnwrapBatch(batch).forEach(function (msg) {
            if (!msg || msg.type !== 'groupHealth' || !msg.summary) return;
            var skey = String(msg.siteId != null ? msg.siteId : siteId);
            groupHealthState[skey] = msg;
            // Live-refresh the popup when it is open on this exact station.
            if (shmCurrentSiteId != null && String(shmCurrentSiteId) === skey) shmRenderAll(msg);
        });
    }

    // ── STATION HEALTH POPUP — open / close ──────────────────────────────
    function openSiteHealthModal() {
        var siteId = shmFocusedSiteId();
        if (!siteId) {
            alert('Select a single station tab above to view its live health details.');
            return;
        }
        shmConnectHealthSockets();   // no-op if already subscribed to this station

        shmCurrentSiteId = String(siteId);
        $('#shmModalOverlay').addClass('open');
        $('body').css('overflow', 'hidden');

        var msg = groupHealthState[shmCurrentSiteId];
        if (msg) {
            shmRenderAll(msg);
        } else {
            $('#shmStatRow,#shmBanner,#shmFleetCard,#shmMeters').html('');
            $('#shmGrid').html('<div class="shm-empty">Waiting for live data from this station&hellip;</div>');
            $('#shmModalTitle').text('Live Station Health');
        }
    }

    function closeSiteHealthModal() {
        $('#shmModalOverlay').removeClass('open');
        $('body').css('overflow', '');
        shmCurrentSiteId = null;
    }

    // ── STATION HEALTH POPUP — rendering (all computed from groupHealth) ──
    function shmFriendlyChannel(channel) {
        var map = {
            '4G_TCP': '4G TCP', '4G_MQTT': '4G MQTT', 'OFC_TCP': 'OFC TCP', 'OFC_MQTT': 'OFC MQTT',
            'A10_TCP': 'A10 TCP', 'A10_MQTT': 'A10 MQTT', 'A10_OFC': 'A10 OFC'
        };
        return map[channel] || String(channel).replace(/_/g, ' ');
    }

    function shmComputeChannelStats(msg) {
        var meterCounters = {}; // channel -> {up, total}
        function count(ch, up) {
            if (!meterCounters[ch]) meterCounters[ch] = { up: 0, total: 0 };
            meterCounters[ch].total++;
            if (up) meterCounters[ch].up++;
        }
        var channelsTotal = 0, channelsUp = 0;
        (msg.clusters || []).forEach(function (cl) {
            if (cl.modem && Array.isArray(cl.modem.channels)) {
                cl.modem.channels.forEach(function (ch, i) {
                    var up = Number(cl.modem.flag && cl.modem.flag[i]) === 1;
                    count(ch, up); channelsTotal++; if (up) channelsUp++;
                });
            }
            (cl.a10Devices || []).forEach(function (a) {
                (a.channels || []).forEach(function (ch, i) {
                    var up = Number(a.flag && a.flag[i]) === 1;
                    count(ch, up); channelsTotal++; if (up) channelsUp++;
                });
            });
        });
        return { meterCounters: meterCounters, channelsTotal: channelsTotal, channelsUp: channelsUp };
    }

    function shmRenderAll(msg) {
        var stats = shmComputeChannelStats(msg);
        $('#shmModalTitle').text((msg.siteName || ('Site ' + msg.siteId)) + ' — Live Health');
        $('#shmUpdatedAt').text(msg.updateTime ? ('Updated: ' + msg.updateTime) : '');
        shmRenderBanner(msg);
        shmRenderStats(msg, stats);
        shmRenderFleet(stats);
        shmRenderMeters(stats.meterCounters);
        shmRenderGrid();
    }

    function shmRenderBanner(msg) {
        var s = msg.summary || {};
        function chip(label, total, up, down) {
            if (!total) {
                return '<div class="shm-gw shm-gw-pending"><span class="shm-gw-dot"></span><span class="shm-gw-label">' + label + '</span><span class="shm-gw-state">Pending</span></div>';
            }
            var isUp = (down || 0) === 0 && (up || 0) > 0;
            return '<div class="shm-gw ' + (isUp ? 'gw-up' : 'gw-down') + '"><span class="shm-gw-dot"></span><span class="shm-gw-label">' + label + '</span><span class="shm-gw-state">' + (isUp ? 'Online' : 'OFFLINE') + '</span></div>';
        }
        $('#shmBanner').html('<div class="shm-banner-row">' + chip('Gateway', s.gatewayTotal, s.gatewayUp, s.gatewayDown) + '</div>');
    }

    function shmRenderStats(msg, stats) {
        var s = msg.summary || {};
        var down = stats.channelsTotal - stats.channelsUp;
        var maskedCount = s.a10Masked || 0;
        $('#shmStatRow').html(
            '<div class="shm-stat-card"><div class="shm-stat-label">Clusters</div><div class="shm-stat-value">' + (s.clustersTotal || 0) + '</div></div>' +
            '<div class="shm-stat-card ' + (down > 0 ? 'warn' : '') + '"><div class="shm-stat-label">Channels down</div><div class="shm-stat-value">' + down + '</div></div>' +
            (maskedCount > 0 ? '<div class="shm-stat-card muted"><div class="shm-stat-label">A10 masked</div><div class="shm-stat-value">' + maskedCount + '</div></div>' : '') +
            '<div class="shm-stat-card"><div class="shm-stat-label">Station</div><div class="shm-stat-value">' + (msg.siteName || ('Site ' + msg.siteId)) + '</div></div>'
        );
    }

    function shmRenderFleet(stats) {
        var pct = stats.channelsTotal ? Math.round((stats.channelsUp / stats.channelsTotal) * 100) : 100;
        $('#shmFleetCard').html(
            '<div class="shm-scard-label">FLEET HEALTH</div>' +
            '<div class="shm-fh-row"><div class="shm-fh-frac">' + stats.channelsUp + ' <span class="shm-fh-of">/ ' + stats.channelsTotal + ' up</span></div>' +
            '<div class="shm-fh-pct">' + pct + '%</div></div>' +
            '<div class="shm-hbar"><div class="shm-hbar-up" style="width:' + pct + '%"></div></div>' +
            '<div class="shm-fh-legend"><span><span class="shm-dot grn"></span>' + stats.channelsUp + ' up</span>' +
            '<span><span class="shm-dot red"></span>' + (stats.channelsTotal - stats.channelsUp) + ' down</span></div>'
        );
    }

    function shmRenderMeters(meterCounters) {
        function row(channel) {
            var c = meterCounters[channel] || { up: 0, total: 0 };
            var pct = c.total ? Math.round((c.up / c.total) * 100) : 100;
            var short = channel.replace(/^(A10_|4G_|OFC_)/, '');
            return '<div class="shm-mrow"><span class="shm-mrow-ch">' + short + '</span>' +
                '<span class="shm-mrow-frac">' + c.up + ' / ' + c.total + ' <b>' + pct + '%</b></span>' +
                '<div class="shm-m-track"><div class="shm-m-fill" style="width:' + pct + '%"></div></div></div>';
        }
        function hasAny(channels) { return channels.some(function (ch) { return meterCounters[ch] && meterCounters[ch].total > 0; }); }
        var cells = [{ label: 'Modem &middot; 4G', rows: ['4G_TCP', '4G_MQTT'] }];
        if (hasAny(['OFC_MQTT', 'OFC_TCP'])) cells.push({ label: 'Modem &middot; OFC', rows: ['OFC_MQTT', 'OFC_TCP'] });
        cells.push({ label: 'A10 &middot; 4G', rows: ['A10_TCP', 'A10_MQTT'] });
        if (hasAny(['A10_OFC'])) cells.push({ label: 'A10 &middot; OFC', rows: ['A10_OFC'] });
        $('#shmMeters').html(cells.map(function (cell) {
            return '<div class="shm-mcell"><div class="shm-mcell-label">' + cell.label + '</div>' + cell.rows.map(row).join('') + '</div>';
        }).join(''));
    }

    function shmClusterHasIssue(cl, kind) {
        var modemUp = {};
        if (cl.modem) (cl.modem.channels || []).forEach(function (ch, i) { modemUp[ch] = Number(cl.modem.flag[i]) === 1; });
        var a10AnyRealDown = (cl.a10Devices || []).some(function (a) {
            if (a.status === 'unknown') return false; // fully masked — nothing to flag
            return (a.channels || []).some(function (ch, i) {
                var masked = a.masked && a.masked[i];
                return !masked && Number(a.flag[i]) !== 1;
            });
        });
        if (kind === '4g') return (('4G_TCP' in modemUp) || ('4G_MQTT' in modemUp)) && (modemUp['4G_TCP'] === false || modemUp['4G_MQTT'] === false);
        if (kind === 'ofc') return modemUp['OFC_TCP'] === false || modemUp['OFC_MQTT'] === false;
        if (kind === 'a10') return a10AnyRealDown;
        return cl.status !== 'ok';
    }

    function shmModemDownItems(cl) {
        if (!cl.modem) return [];
        var items = [];
        (cl.modem.channels || []).forEach(function (ch, i) { if (Number(cl.modem.flag[i]) !== 1) items.push(shmFriendlyChannel(ch)); });
        return items;
    }

    function shmA10DownItems(cl) {
        var items = [];
        (cl.a10Devices || []).forEach(function (a) {
            // A device with status "unknown" has every channel masked — the service doesn't
            // alert on it at all, so it has no place in a "what's actually down" list.
            if (a.status === 'unknown') return;
            (a.channels || []).forEach(function (ch, i) {
                if (a.masked && a.masked[i]) return; // suppressed — not a real down condition
                if (Number(a.flag[i]) !== 1) items.push('A10 ' + a.deviceId + ' &middot; ' + shmFriendlyChannel(ch).replace(/^A10 /, ''));
            });
        });
        return items;
    }

    function shmModemBlock(cl) {
        if (!cl.modem) return '<div class="shm-c-mac shm-c-muted">No modem on this cluster</div>';
        var byChannel = {};
        (cl.modem.channels || []).forEach(function (ch, i) { byChannel[ch] = Number(cl.modem.flag[i]) === 1; });
        function lane(label, chans) {
            var present = chans.filter(function (ch) { return ch in byChannel; });
            if (!present.length) return '';
            var chips = present.map(function (ch) {
                var up = byChannel[ch];
                var short = ch.replace(/^(A10_|4G_|OFC_)/, '');
                return '<span class="shm-ch ' + (up ? 'ch-up' : 'ch-down') + '" title="' + shmFriendlyChannel(ch) + ': ' + (up ? 'up' : 'down') + '">' + short + '</span>';
            }).join('');
            return '<div class="shm-lane"><span class="shm-lane-label">' + label + '</span><span class="shm-lane-chips">' + chips + '</span></div>';
        }
        var lanes = lane('4G', ['4G_TCP', '4G_MQTT']) + lane('OFC', ['OFC_TCP', 'OFC_MQTT']);
        return '<div class="shm-c-mac"><span class="shm-c-mac-id">Modem ' + cl.modem.deviceId + '</span></div>' + lanes;
    }

    function shmA10Block(cl) {
        var a10s = cl.a10Devices || [];
        if (!a10s.length) return '';
        var dotOrder = (a10s[0] && a10s[0].channels) || [];
        var tiles = a10s.map(function (a) {
            var isUnknown = a.status === 'unknown';
            var dots = (a.channels || []).map(function (ch, i) {
                return '<span class="shm-ad ' + shmColorFor(a.flag[i], a.masked && a.masked[i]) + '"></span>';
            }).join('');
            var tipRows = (a.channels || []).map(function (ch, i) {
                var masked = a.masked && a.masked[i];
                var cls = shmColorFor(a.flag[i], masked);
                var detail = masked ? 'Unknown · parent Modem channel is down' : (Number(a.flag[i]) === 1 ? 'Up' : 'Down');
                return '<div class="shm-tip-row"><span class="shm-tip-dot ' + cls + '"></span><span class="shm-tip-ch">' + shmFriendlyChannel(ch) + '</span><span class="shm-tip-detail">' + detail + '</span></div>';
            }).join('');
            var unknownBadge = isUnknown ? '<span class="shm-a10-unknown-badge" title="Every channel on this device is currently masked — nothing to judge it by">?</span>' : '';
            return '<div class="shm-a10chip' + (isUnknown ? ' shm-a10-unknown' : '') + '">' +
                '<div class="shm-a10id">A10 ' + a.deviceId + unknownBadge + '</div>' +
                '<div class="shm-a10dots">' + dots + '</div>' +
                '<div class="shm-tooltip shm-tooltip-a10"><div class="shm-tooltip-title">A10 ' + a.deviceId + (isUnknown ? ' &middot; all masked' : '') + '</div>' + tipRows + '</div></div>';
        }).join('');
        return '<div class="shm-a10hd"><span>A10 devices</span>' +
            '<span class="shm-info-icon">?<div class="shm-tooltip shm-tooltip-legend"><div class="shm-tooltip-title">Dot order (left to right)</div>' +
            dotOrder.map(function (ch, i) { return '<div class="shm-tip-row"><span class="shm-tip-num">' + (i + 1) + '.</span><span class="shm-tip-ch">' + shmFriendlyChannel(ch) + '</span></div>'; }).join('') +
            '</div></span>' +
            '<span class="shm-a10cnt">' + (cl.a10OnlineCount || 0) + '/' + (cl.a10Total || 0) + ' fully online</span></div>' +
            '<div class="shm-a10grid">' + tiles + '</div>';
    }

    function shmRenderClusterCard(cl) {
        var stateCls = cl.status === 'ok' ? '' : (cl.status === 'down' ? 'shm-off' : 'shm-deg');
        var dotCls = cl.status === 'ok' ? 'grn' : (cl.status === 'down' ? 'red' : 'amb');
        var issueCount = shmModemDownItems(cl).length + shmA10DownItems(cl).length;
        return '<div class="shm-card ' + stateCls + '">' +
            '<div class="shm-c-top"><span class="shm-c-dot ' + dotCls + '"></span><span class="shm-c-name">' + (cl.clusterName || ('Cluster ' + cl.clusterId)) + '</span>' +
            (issueCount ? '<button type="button" class="shm-c-offline" data-cluster-id="' + cl.clusterId + '">See all Down</button>' : '<span class="shm-c-ok-badge">OK</span>') +
            '</div>' + shmModemBlock(cl) + shmA10Block(cl) + '</div>';
    }

    function shmRenderGrid() {
        var msg = groupHealthState[String(shmCurrentSiteId)];
        if (!msg) { $('#shmGrid').html('<div class="shm-empty">No live data yet for this station.</div>'); return; }
        var clusters = (msg.clusters || []).slice();
        var f = shmFilters;
        if (f.status === 'online') clusters = clusters.filter(function (c) { return c.status === 'ok'; });
        if (f.status === 'offline') clusters = clusters.filter(function (c) { return c.status !== 'ok'; });
        if (f.issue !== 'any') clusters = clusters.filter(function (c) { return shmClusterHasIssue(c, f.issue); });
        if (f.search) {
            var q = f.search.toLowerCase();
            clusters = clusters.filter(function (c) {
                return (c.clusterName || '').toLowerCase().indexOf(q) > -1 ||
                    (c.modem && (c.modem.deviceId || '').toLowerCase().indexOf(q) > -1) ||
                    (c.a10Devices || []).some(function (a) { return (a.deviceId || '').toLowerCase().indexOf(q) > -1; });
            });
        }
        if (f.sort === 'issues') {
            clusters.sort(function (a, b) { return (a.status === 'ok') - (b.status === 'ok') || (a.clusterName || '').localeCompare(b.clusterName || ''); });
        } else {
            clusters.sort(function (a, b) { return (a.clusterName || '').localeCompare(b.clusterName || ''); });
        }
        if (!clusters.length) { $('#shmGrid').html('<div class="shm-empty">No clusters match these filters.</div>'); return; }
        $('#shmGrid').html(clusters.map(shmRenderClusterCard).join(''));
    }

    function shmOpenClusterModal(clusterId) {
        var msg = groupHealthState[String(shmCurrentSiteId)];
        var cl = ((msg && msg.clusters) || []).filter(function (c) { return String(c.clusterId) === String(clusterId); })[0];
        if (!cl) return;
        $('#shmClusterModalTitle').text(cl.clusterName || ('Cluster ' + cl.clusterId));
        function section(heading, items) {
            if (!items.length) return '<div class="shm-modal-section"><h4>' + heading + '</h4><div class="shm-modal-ok">&#10003; All up</div></div>';
            return '<div class="shm-modal-section"><h4>' + heading + '</h4>' + items.map(function (label) {
                return '<div class="shm-modal-item"><span class="shm-modal-item-label">' + label + '</span><span class="shm-modal-item-dur">down</span></div>';
            }).join('') + '</div>';
        }
        $('#shmClusterModalBody').html(section('Modem', shmModemDownItems(cl)) + section('A10 Devices', shmA10DownItems(cl)));
        $('#shmClusterModalOverlay').addClass('open');
    }

    // Colour comes from `masked` FIRST, then `flag`. A masked channel is suppressed from
    // alerting — it is neither a real "up" nor a real "down".
    function shmColorFor(flag, masked) {
        if (masked) return 'grey';
        return Number(flag) === 1 ? 'grn' : 'red';
    }

    // ── FAULTY SENSOR POPUP ──────────────────────────────────────────────
    // siteId(string) -> { sensorTotal, sensorOnline, sensorDown, updateTime, faults: { "assetId|attId": {...} } }
    var shmSensorHealthState = {};
    var shmSensorCurrentSiteId = null;
    var shmSensorGroupMode = 'asset'; // 'asset' | 'cluster'
    // Which groups are expanded, per mode, so live WS updates re-rendering the list
    // don't collapse whatever the user had open.
    var shmSensorExpandedGroups = { asset: {}, cluster: {} };

    function shmHandleSensorMessage(siteId, batch) {
        shmUnwrapBatch(batch).forEach(function (msg) {
            if (!msg) return;
            var skey = String(msg.siteId != null ? msg.siteId : siteId);
            if (!shmSensorHealthState[skey]) {
                shmSensorHealthState[skey] = { sensorTotal: 0, sensorOnline: 0, sensorDown: 0, updateTime: null, faults: {} };
            }
            var siteState = shmSensorHealthState[skey];

            if (msg.type === 'sensorHealthSummary' && msg.summary) {
                siteState.sensorTotal = msg.summary.sensorTotal || 0;
                siteState.sensorOnline = msg.summary.sensorOnline || 0;
                siteState.sensorDown = msg.summary.sensorDown || 0;
                siteState.updateTime = msg.updateTime;
            }
            else if (msg.type === 'sensorHealth') {
                var key = msg.assetId + '|' + msg.attId;
                if (Number(msg.active) === 1) {
                    siteState.faults[key] = {
                        assetId: msg.assetId,
                        attId: msg.attId,
                        assetTypeId: msg.assetTypeId,
                        assetName: msg.assetName || ('Asset #' + msg.assetId),
                        assetAttributeName: (msg.aliasName && msg.aliasName.trim())
                            ? msg.aliasName
                            : (msg.assetAttributeName || ('Attribute #' + msg.attId)),
                        clusterName: msg.clusterName || '',
                        setTime: msg.setTime,
                        setValue: msg.setValue
                    };
                } else {
                    delete siteState.faults[key];
                }
                siteState.updateTime = msg.updateTime || siteState.updateTime;
            }

            // Live-refresh the popup when it is open on this exact station.
            if (shmSensorCurrentSiteId != null && String(shmSensorCurrentSiteId) === skey) shmRenderSensorList();
        });
    }

    function openSensorHealthModal() {
        var siteId = shmFocusedSiteId();
        if (!siteId) {
            alert('Select a single station tab above to view its faulty sensors.');
            return;
        }
        shmConnectHealthSockets();   // no-op if already subscribed to this station
        shmSensorCurrentSiteId = String(siteId);
        $('#shmSensorModalOverlay').addClass('open');
        $('body').css('overflow', 'hidden');
        shmRenderSensorList();
    }

    function closeSensorHealthModal() {
        $('#shmSensorModalOverlay').removeClass('open');
        $('body').css('overflow', '');
        shmSensorCurrentSiteId = null;
    }

    function shmRenderSensorList() {
        var s = shmSensorHealthState[String(shmSensorCurrentSiteId)];
        if (!s) {
            $('#shmSensorStatRow,#shmSensorUpdatedAt').html('');
            $('#shmSensorList').html('<div class="shm-empty">Waiting for live data from this station&hellip;</div>');
            return;
        }
        $('#shmSensorUpdatedAt').text(s.updateTime ? ('Updated: ' + s.updateTime) : '');
        $('#shmSensorStatRow').html(
            '<div class="shm-stat-card"><div class="shm-stat-label">Total sensors</div><div class="shm-stat-value">' + s.sensorTotal + '</div></div>' +
            '<div class="shm-stat-card ' + (s.sensorDown > 0 ? 'warn' : '') + '"><div class="shm-stat-label">Faulty</div><div class="shm-stat-value">' + s.sensorDown + '</div></div>'
        );

        var faultKeys = Object.keys(s.faults);
        if (!faultKeys.length) {
            $('#shmSensorList').html('<div class="shm-empty">&#10003; All sensors healthy.</div>');
            return;
        }

        function sensorItemHtml(f, showCluster) {
            var displayName = shmResolvePmDisplayName(f);
            var val = shmAssetValueLookup[f.assetId + '|' + f.attId];
            var hasVal = val !== undefined && val !== null && val !== '';
            var attrLine = displayName + (hasVal ? ' &middot; ' + val : '');
            return '<div class="shm-sensor-item"><span class="shm-sensor-dot"></span>' +
                '<div><div class="shm-sensor-asset">' + f.assetName + '</div>' +
                '<div class="shm-sensor-attr">' + attrLine + '</div>' +
                (showCluster && f.clusterName ? '<div class="shm-sensor-cluster">' + f.clusterName + '</div>' : '') +
                '</div></div>';
        }

        // Group key + item list differ by mode; the collapsible group shell is shared.
        var groups = {};
        var groupByCluster = shmSensorGroupMode === 'cluster';
        faultKeys.forEach(function (key) {
            var f = s.faults[key];
            var groupKey = groupByCluster ? (f.clusterName || 'No cluster') : f.assetName;
            if (!groups[groupKey]) groups[groupKey] = [];
            groups[groupKey].push(f);
        });

        var groupNames = Object.keys(groups).sort(function (a, b) {
            if (a === 'No cluster') return 1;
            if (b === 'No cluster') return -1;
            return a.localeCompare(b);
        });

        var expandedMap = shmSensorExpandedGroups[shmSensorGroupMode];
        $('#shmSensorList').html(groupNames.map(function (groupKey) {
            var items = groups[groupKey];
            var isOpen = !!expandedMap[groupKey];
            var itemsHtml = items.map(function (f) { return sensorItemHtml(f, !groupByCluster); }).join('');
            return '<div class="shm-sensor-group' + (isOpen ? ' open' : '') + '">' +
                '<div class="shm-sensor-group-head" data-group="' + groupKey.replace(/"/g, '&quot;') + '">' +
                '<span class="shm-sensor-caret">&#9656;</span>' +
                '<span class="shm-sensor-group-title">' + groupKey + '</span>' +
                '<span class="shm-sensor-group-count">' + items.length + '</span>' +
                '</div>' +
                '<div class="shm-sensor-group-body' + (isOpen ? '' : ' collapsed') + '">' + itemsHtml + '</div>' +
                '</div>';
        }).join(''));
    }

    // ── WIRING ───────────────────────────────────────────────────────────
    $(function () {
        $('#shmGrid').on('click', '.shm-c-offline', function () { shmOpenClusterModal($(this).data('cluster-id')); });
        $('#shmClusterModalClose').on('click', function () { $('#shmClusterModalOverlay').removeClass('open'); });
        $('#shmClusterModalOverlay').on('click', function (e) { if (e.target === this) $(this).removeClass('open'); });
        $('#shmModalOverlay').on('click', function (e) { if (e.target === this) closeSiteHealthModal(); });
        $('#shmSensorModalOverlay').on('click', function (e) { if (e.target === this) closeSensorHealthModal(); });

        function shmWireSegment(id, key) {
            var $group = $('#' + id);
            $group.on('click', '.shm-seg-btn', function () {
                $group.find('.shm-seg-btn').removeClass('active');
                $(this).addClass('active');
                shmFilters[key] = $(this).data('value');
                shmRenderGrid();
            });
        }
        shmWireSegment('shmFilterStatus', 'status');
        shmWireSegment('shmFilterIssue', 'issue');
        shmWireSegment('shmFilterSort', 'sort');

        var shmSearchDebounce = null;
        $('#shmSearch').on('input', function () {
            clearTimeout(shmSearchDebounce);
            var val = this.value;
            shmSearchDebounce = setTimeout(function () { shmFilters.search = val.trim(); shmRenderGrid(); }, 150);
        });

        $('#shmBtnRefresh').on('click', function () {
            var msg = groupHealthState[String(shmCurrentSiteId)];
            if (msg) shmRenderAll(msg);
        });

        $('#shmSensorGroupToggle').on('click', '.shm-seg-btn', function () {
            $('#shmSensorGroupToggle .shm-seg-btn').removeClass('active');
            $(this).addClass('active');
            shmSensorGroupMode = $(this).data('value');
            shmRenderSensorList();
        });

        $('#shmSensorList').on('click', '.shm-sensor-group-head', function () {
            var groupKey = $(this).data('group');
            shmSensorExpandedGroups[shmSensorGroupMode][groupKey] = !shmSensorExpandedGroups[shmSensorGroupMode][groupKey];
            shmRenderSensorList();
        });

        $(document).on('keydown', function (e) {
            if (e.key !== 'Escape') return;
            if ($('#shmClusterModalOverlay').hasClass('open')) { $('#shmClusterModalOverlay').removeClass('open'); return; }
            if ($('#shmSensorModalOverlay').hasClass('open')) { closeSensorHealthModal(); return; }
            if ($('#shmModalOverlay').hasClass('open')) closeSiteHealthModal();
        });
    });
</script>
