        var pM={},fM={};
        data.filter(function(d){return d.AssetTypeId==at.Id&&d.AlertTypeId==alertPredictive;}).forEach(function(d){pM[d.AssetId]=1;});
        data.filter(function(d){return d.AssetTypeId==at.Id&&d.AlertTypeId==alertFail;}).forEach(function(d){fM[d.AssetId]=1;});
