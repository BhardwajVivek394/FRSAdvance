    }

    .shm-ch {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 999px;
    }

        .shm-ch.ch-up {
            background: var(--green-dim);
            color: var(--green);
        }

        .shm-ch.ch-down {
            background: var(--red-dim);
            color: var(--red);
        }

        /* Masked (Indeterminable) — parent Gateway link is down, so this transport can't be judged. */
        .shm-ch.ch-unknown {
            background: var(--glass-3);
            color: var(--text-muted);
        }

    .shm-lane-unknown-tag {
        display: block;
        font-size: 10.5px;
        font-weight: 600;
        color: var(--text-muted);
        margin: -2px 0 8px 36px;
    }

    .shm-a10hd {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11px;
        color: var(--text-secondary);
        margin-bottom: 6px;
    }

    .shm-a10cnt {
        font-weight: 600;
        margin-left: auto;
    }

    .shm-a10grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(68px, 1fr));
        gap: 8px;
    }

    .shm-a10chip {
