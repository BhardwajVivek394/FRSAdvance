function BindGraph(alerts, assetData, at) {
  _e7ChartRedraw['Main-' + at.Id] = function () { BindGraph(alerts, assetData, at); };
  var total=0,pred=0,fail=0;
  if(assetData){var f=assetData.find(function(a){return a.AssetTypeId==at.Id;});total=f?f.Count:0;}
  var pM={},fM={};
  alerts.filter(function(a){return a.AssetTypeId==at.Id&&a.AlertTypeId==alertPredictive;}).forEach(function(a){pM[a.AssetId]=1;});
  alerts.filter(function(a){return a.AssetTypeId==at.Id&&a.AlertTypeId==alertFail;}).forEach(function(a){fM[a.AssetId]=1;});
  pred=Object.keys(pM).length; fail=Object.keys(fM).length;
  var healthy=Math.max(0,total-pred-fail);
  var cid=String(at.Name||'').replace(/[^A-Za-z0-9_-]/g,'');   // same key as the Razor card markup
  $('.totalcount-'+cid).text(total);
  // Asset Health Summary cards read "count/total" like the web dashboard; the Today's
  // Report legend (same classes) keeps the plain count next to its percentage.
  var $card=$('.asset-type-card[data-asset-type-name="'+cid+'"]');
  $card.find('.healthycount-'+cid).text(healthy+'/'+total);
  $card.find('.predictivecount-'+cid).text(pred+'/'+total);
  $card.find('.failurecount-'+cid).text(fail+'/'+total);
  $('.pie-chart-box .healthycount-'+cid).text(healthy);
  $('.pie-chart-box .predictivecount-'+cid).text(pred);
  $('.pie-chart-box .failurecount-'+cid).text(fail);
  // Card trend arrow + total colour by healthy ratio (≥70 % green, ≥40 % amber, else red).
  var hr=total>0?(healthy/total)*100:0, $ic=$card.find('.upIcon'), $tot=$card.find('.totalcount-'+cid);
  $ic.removeClass('fa-arrow-trend-up fa-arrow-trend-down text-success text-warning text-danger');
  $tot.removeClass('text-success text-warning text-danger');
  if(hr>=70){ $ic.addClass('fa-arrow-trend-up text-success'); $tot.addClass('text-success'); }
  else if(hr>=40){ $ic.addClass('fa-arrow-trend-down text-warning'); $tot.addClass('text-warning'); }
  else { $ic.addClass('fa-arrow-trend-down text-danger'); $tot.addClass('text-danger'); }
  var sum=healthy+pred+fail;
  var hPct=sum>0?((healthy/sum)*100).toFixed(1):'0.0';
  var pPct=sum>0?((pred/sum)*100).toFixed(1):'0.0';
  var fPct=sum>0?((fail/sum)*100).toFixed(1):'0.0';
  $('.healthy-pct-'+cid).text(hPct+'%');
  $('.predictive-pct-'+cid).text(pPct+'%');
  $('.failure-pct-'+cid).text(fPct+'%');
  var el=document.getElementById('Main-'+cid); if(!el) return;
  var ec=echarts.getInstanceByDom(el); if(ec) ec.dispose();
  var chart=echarts.init(el,null,{renderer:'svg'});
  var statusColor=parseFloat(hPct)>=70?CLRS.green:parseFloat(hPct)>=40?CLRS.amber:CLRS.red;
  var statusText=parseFloat(hPct)>=70?'Healthy':parseFloat(hPct)>=40?'Warning':'Critical';
  // Scale the centre labels to whatever size the CSS gave the donut (150px desktop,
  // smaller on narrow columns), and shrink once more for 6-char values like "100.0%".
  var side=Math.min(el.clientWidth||150, el.clientHeight||150);
  var pctFont=Math.max(11, Math.round(side*((hPct+'%').length>5?0.115:0.135)));
  var lblFont=Math.max(8,  Math.round(side*0.068));
  chart.setOption({
    backgroundColor:'transparent',
      tooltip: {
          trigger: 'item',
          confine: true,
          backgroundColor: CLRS.tipBg,
          borderColor: CLRS.tipBorder,
          borderWidth: 1,
          padding: [8, 12],
          extraCssText: e7TipCss(),
          textStyle: { color: CLRS.tipText, fontSize: 12 },
          formatter: function (p) {
              var pct = sum > 0 ? ((p.value / sum) * 100).toFixed(1) : '0.0';
              return '<div style="font-weight:600;margin-bottom:6px;"><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + p.color + ';margin-right:6px;"></span>' + p.name + '</div>Count: <b>' + p.value + '</b><br/>Pct: <b>' + pct + '%</b><br/>Of Total: <b>' + p.value + '/' + total + '</b>';
          }
      },
    // Centre label is sized from the container, and the ring's inner radius is wide
    // enough to hold it — at 30% the hole was only ~45px and "89.1%" (≈58px) spilled
    // over the ring.
    title:[
      { text:hPct+'%', left:'center', top:'37%', textStyle:{color:statusColor,fontWeight:'800',fontSize:pctFont,fontFamily:"'Inter',sans-serif"} },
      { text:statusText, left:'center', top:'56%', textStyle:{color:CLRS.text,fontWeight:'600',fontSize:lblFont,fontFamily:"'Inter',sans-serif",letterSpacing:0.4} }
    ],
    series:[{
        type: 'pie', radius: ['58%', '80%'], center: ['50%', '50%'], avoidLabelOverlap: false,
        itemStyle:{ borderColor:CLRS.bg, borderWidth:2, borderRadius:5 },
        label: { show: false },
        labelLine: { show: false },
      emphasis:{ itemStyle:{shadowBlur:16,shadowColor:'rgba(0,0,0,0.4)',borderWidth:0}, scale:true, scaleSize:8 },
      data:[
        {name:'Failure',   value:fail,    itemStyle:{color:CLRS.red}},
        {name:'Healthy',   value:healthy, itemStyle:{color:CLRS.green}},
        {name:'Predictive',value:pred,    itemStyle:{color:CLRS.amber}}
      ]
    }]
  });
  // Pick up whatever size the CSS gave the container, then keep following it.
  // A ResizeObserver (not a window resize listener) is needed because the donut also
  // changes width when the sidebar collapses or the grid reflows, with no window resize.
  setTimeout(function(){ try { chart.resize(); } catch(e) {} }, 50);
  if (el.__e7DonutRO) { el.__e7DonutRO.disconnect(); }
  if (typeof ResizeObserver !== 'undefined') {
    el.__e7DonutRO = new ResizeObserver(function () {
      try {
        chart.resize();
        var s = Math.min(el.clientWidth || 150, el.clientHeight || 150);
        chart.setOption({ title: [
          { textStyle: { fontSize: Math.max(11, Math.round(s * ((hPct + '%').length > 5 ? 0.115 : 0.135))) } },
          { textStyle: { fontSize: Math.max(8, Math.round(s * 0.068)) } }
        ] });
      } catch (e) { }
    });
    el.__e7DonutRO.observe(el);
  }
}

