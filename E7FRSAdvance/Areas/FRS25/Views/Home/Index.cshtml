<!-- Global backdrop for closing dropdowns on outside click -->
<div id="backdrop" style="display:none;position:fixed;inset:0;z-index:199;"></div>

<!-- ==================== FILTER BAR (mockup: .filters.bg-Up) ==================== -->
@* Every section below uses the Energy7 Dashboard 2 markup classes
   (filters / crumb / panel + phead / asset-grid / reports / bottom).
   Ids and the classes the page script reads (.asset-type-card, .f-style,
   .pie-chart-box, .gaph-assetType, .select-btn, *count-*, *-pct-*) are kept. *@
<div class="filters bg-Up">
    <b class="h6"><i class="fa fa-th" aria-hidden="true"></i> Dashboard</b>

    <div class="filter-container">
        <!-- Zone -->
        <div class="filter-item">
            <div class="select-btn selectx bg-Up" id="btnZone" data-target="ddZone">
                <i class="fa fa-map-marker" aria-hidden="true"></i>
                <span class="text" id="txtZone">Zone</span>
                <i class="fa fa-angle-down" aria-hidden="true"></i>
            </div>
            <div class="filter-dropdown" id="ddZone">
                <div class="dropdown-search"><input type="text" placeholder="Search zone..." onkeyup="filterDropdown('zone', this.value)"></div>
                <div class="dropdown-header"><input type="checkbox" id="chkAllZone"><label for="chkAllZone">Select All</label></div>
                <div class="dropdown-list" id="listZone">
                    @if (ViewBag.Zones != null)
                    {
                        foreach (var zone in ViewBag.Zones as SelectList)
                        {
                            <div class="dropdown-item" data-value="@zone.Value" data-text="@zone.Text">
                                <input type="checkbox" class="cb-zone" value="@zone.Value"><span>@zone.Text</span>
                            </div>
                        }
                    }
                </div>
                <div class="dropdown-no-results">No results found</div>
            </div>
        </div>

        <!-- Division -->
        <div class="filter-item">
            <div class="select-btn selectx bg-Up" id="btnDivision" data-target="ddDivision">
                <i class="fa fa-sitemap" aria-hidden="true"></i>
                <span class="text" id="txtDivision">Division</span>
                <i class="fa fa-angle-down" aria-hidden="true"></i>
            </div>
            <div class="filter-dropdown" id="ddDivision">
                <div class="dropdown-search"><input type="text" placeholder="Search division..." onkeyup="filterDropdown('division', this.value)"></div>
                <div class="dropdown-header"><input type="checkbox" id="chkAllDivision"><label for="chkAllDivision">Select All</label></div>
                <div class="dropdown-list" id="listDivision">
                    @if (ViewBag.Divisions != null)
                    {
                        foreach (var division in ViewBag.Divisions as SelectList)
                        {
                            <div class="dropdown-item" data-value="@division.Value" data-text="@division.Text">
                                <input type="checkbox" class="cb-division" value="@division.Value"><span>@division.Text</span>
                            </div>
                        }
                    }
                </div>
                <div class="dropdown-no-results">No results found</div>
            </div>
        </div>

        <!-- Site -->
        <div class="filter-item">
            <div class="select-btn selectx bg-Up" id="btnSite" data-target="ddSite">
                <i class="fa fa-building" aria-hidden="true"></i>
                <span class="text" id="txtSite">Station</span>
                <i class="fa fa-angle-down" aria-hidden="true"></i>
            </div>
            <div class="filter-dropdown" id="ddSite">
                <div class="dropdown-search"><input type="text" placeholder="Search station..." onkeyup="filterDropdown('site', this.value)"></div>
                <div class="dropdown-header"><input type="checkbox" id="chkAllSite"><label for="chkAllSite">Select All</label></div>
                <div class="dropdown-list" id="listSite">
                    @if (ViewBag.Sites != null)
                    {
                        foreach (var site in (IEnumerable<SelectListItem>)ViewBag.Sites)
                        {
                            <div class="dropdown-item" data-value="@site.Value" data-text="@site.Text">
                                <input type="checkbox" class="cb-site" value="@site.Value"><span>@site.Text</span>
                            </div>
                        }
                    }
                </div>
                <div class="dropdown-no-results">No results found</div>
            </div>
        </div>

        <button type="button" class="search bg-Up" onclick="onSearchClick(this)" title="Apply Filters">
            <i class="fa fa-search" aria-hidden="true"></i>
        </button>
    </div>

    <!-- CPU / RAM / DISK (mockup: .sys > .gauge.bg-down). The tile border is the usage gauge: the
         .gauge-ring outline fills clockwise; updateProgressCircle() sets --percent on it and data-status on the tile. -->
    <div class="sys">
        <div class="gauge bg-down" data-status="ok">
            <svg class="gauge-ring" aria-hidden="true"><rect id="cpuCircle" pathLength="100" style="--percent:0;"></rect></svg>
            <strong id="cpuValue">0%</strong><small>CPU</small>
        </div>
        <div class="gauge bg-down" data-status="ok">
            <svg class="gauge-ring" aria-hidden="true"><rect id="ramCircle" pathLength="100" style="--percent:0;"></rect></svg>
            <strong id="ramValue">0%</strong><small>RAM</small>
        </div>
        <div class="gauge bg-down" data-status="ok">
            <svg class="gauge-ring" aria-hidden="true"><rect id="storageCircle" pathLength="100" style="--percent:0;"></rect></svg>
            <strong id="storageValue">0%</strong><small>DISK</small>
        </div>
    </div>
</div>

