        @if (ViewBag.FRSAssetType != null)
        {
            string[] tones = { "c1", "c2", "c4", "c1", "c3", "c1" };
            int counter = 0;
            foreach (var assettype in ViewBag.FRSAssetType as List<Domain.AssetType>)
            {
                var key = System.Text.RegularExpressions.Regex.Replace(assettype.Name ?? "", "[^A-Za-z0-9_-]", "");
                <div class="report pie-chart-box" data-asset-type-id="@assettype.Id" data-asset-type-name="@key">
                    <div class="report-title @tones[counter % tones.Length]">&#9612; @assettype.Name</div>
                    <div class="rbody">
                        @* ECharts donut (sized like the mockup's 120px .donut) *@
                        <div class="gaph-assetType" id="Main-@key"></div>
                        <div class="legend" id="Legend-@key">
                            <p><span><i class="dot dgreen"></i>Healthy</span><span><small class="healthycount-@key"></small><b class="green healthy-pct-@key">&mdash;</b></span></p>
                            <p><span><i class="dot dyellow"></i>Predictive</span><span><small class="predictivecount-@key"></small><b class="text-warning predictive-pct-@key">&mdash;</b></span></p>
                            <p><span><i class="dot dred"></i>Failure</span><span><small class="failurecount-@key"></small><b class="text-danger failure-pct-@key">&mdash;</b></span></p>
                        </div>
                    </div>
                </div>
                counter++;
