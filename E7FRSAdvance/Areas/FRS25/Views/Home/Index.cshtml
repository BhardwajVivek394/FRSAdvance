// ── SENSOR (live sensorHealth WebSocket — same feed as the web dashboard) ──
// The card used to count rows from the GetSensorLiveData REST call, which only returns
// sensors that have had a health event: a station whose sensors are all fine (or that
// has no events yet) came back empty and the card showed nothing. Every station publishes
// a sensorHealthSummary (sensorTotal / sensorOnline / sensorDown) on the global
// 'sensorHealth' topic, so the card now sums those for the stations in scope — the
// faulty-sensor popup reads the same per-station state.

var _sensorLastDrawn = null;
function recomputeSensorHealth() {
    var eff = getCardSiteIds();
    var total = 0, healthy = 0, faulty = 0;
    Object.keys(shmSensorHealthState).forEach(function (skey) {
        if (eff.indexOf(skey) === -1) return;
        var s = shmSensorHealthState[skey];
        total += s.sensorTotal || 0;
        healthy += s.sensorOnline || 0;
        faulty += s.sensorDown || 0;
    });

    var d = { TotalSensor: total, HelthyCount: healthy, FailurCount: faulty };
    fnBindSensorCard(d);
    var sig = total + '|' + faulty;
    if (sensorFirst || sig !== _sensorLastDrawn) {
        sensorFirst = false;
        _sensorLastDrawn = sig;
        fnBindSensorChart(d);
    }
}

