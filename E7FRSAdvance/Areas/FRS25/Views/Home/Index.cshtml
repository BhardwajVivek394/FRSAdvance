// ==================== UTILITY ====================
function updateProgressCircle(id, pct, color) {
  pct=Math.max(0,Math.min(100,parseFloat(pct)||0));
  if(!color) color=pct<50?CLRS.green:pct<80?CLRS.amber:CLRS.red;
  var el=document.getElementById(id);
  if(el){el.style.setProperty('--percent',pct);el.style.setProperty('--color',color);
    // the surrounding .gauge tile shows the same status (same thresholds as the ring
    // colour) as its border + percentage colour — see .gauge[data-status] in the theme CSS
    var tile=el.closest('.gauge'); if(tile) tile.setAttribute('data-status', pct<50?'ok':pct<80?'warn':'bad');}
}
function formatNumber(n){return(n||0).toString().replace(/\B(?=(\d{3})+(?!\d))/g,',');}
// A station tab wins; otherwise the checked stations; otherwise "All Stations" —
// sent as an EMPTY list, which this backend already reads as "every station this user
// may see" (it scopes by UserId/RoleId server-side).
//
// Do not "helpfully" expand this to every id in the dropdown the way the web dashboard
// does. GetRDPMSHealthLive skips its expensive Asset/GetRDPMSHealthLiveDetails call
// entirely for an admin with an empty SiteIds; handing it a full list turns page load
// into an unpaged whole-estate query (Take = -1, MaxJsonLength = int.MaxValue).
function getEffectiveSiteIds(){
  if(activeTabSiteId) return [activeTabSiteId];
  return getValues('site');
}
// Every station value present in the dropdown, checked or not. Used for the station
// tabs, never for query scoping.
function getAllSiteValues(){
  var v=[];
  $('#listSite .dropdown-item').each(function(){ var d=$(this).data('value'); if(d!==undefined&&d!==null) v.push(d.toString()); });
  return v;
}

// Stations whose live health counts toward the IoT / Network / Gateway / Sensor cards.
// The global health sockets deliver EVERY station, so the cards must sum only the ones in
// the current view — same precedence as the web dashboard's getEffectiveSiteIds():
// station tab → ticked stations → stations of the ticked divisions → stations of the
// ticked zones (resolved once, cached) → all of this user's stations. Client-side only:
// REST calls keep using getEffectiveSiteIds() (empty list = "all", see above).
var _userSiteIds = null;   // the user's full station list, captured from the first-render dropdown
$(function(){ if(_userSiteIds===null) _userSiteIds=getAllSiteValues(); });
var _zoneSiteCache = { key: null, ids: [], pending: null };
function getCardSiteIds(){
  if(_userSiteIds===null) _userSiteIds=getAllSiteValues();
  if(activeTabSiteId) return [String(activeTabSiteId)];
  var sel=getValues('site'); if(sel.length) return sel.map(String);
  if(getValues('division').length) return getAllSiteValues();
  var zIds=getValues('zone');
  if(zIds.length){
    var key=zIds.slice().sort().join(',');
    if(_zoneSiteCache.key===key) return _zoneSiteCache.ids;
    resolveZoneSites(zIds,key);           // repaints the cards when it lands
  }
  return _userSiteIds;
}
// No Zone→Station endpoint exists, so chain Zone→Division→Station once per zone selection.
function resolveZoneSites(zIds,key){
  if(_zoneSiteCache.pending===key) return;
  _zoneSiteCache.pending=key;
  function done(ids){
    _zoneSiteCache={ key:key, ids:ids, pending:null };
    flushZoneSiteWaiters();
    if(getValues('zone').slice().sort().join(',')===key && !getValues('division').length){
      if(typeof recomputeDeviceHealth==='function') recomputeDeviceHealth();
      if(typeof recomputeSensorHealth==='function') recomputeSensorHealth();
    }
  }
  fetchDivisionsByZone(zIds).then(function(divs){
      var dIds=(divs||[]).map(function(d){ return d.Id; });
      if(!dIds.length){ done([]); return; }
      $.ajax({ url:'/FRS25/Home/GetSiteByDivisionId', type:'POST', contentType:'application/json', data:JSON.stringify({SearchCriteria:{DivisionIds:dIds}}),
        success:function(sites){ rememberSiteNames(sites); done((sites||[]).map(function(s){ return String(s.Id); })); },
        error:function(){ _zoneSiteCache.pending=null; flushZoneSiteWaiters(); } });
    }, function(){ _zoneSiteCache.pending=null; flushZoneSiteWaiters(); });
}
var _zoneSiteWaiters = [];
function flushZoneSiteWaiters(){ var w=_zoneSiteWaiters; _zoneSiteWaiters=[]; w.forEach(function(cb){ cb(); }); }

// Station id -> name for every station seen (page-load dropdown, Division->Station and
// Zone->Station lookups). The popup site picker needs names for zone-scoped stations,
// which never appear in #listSite while only a Zone is ticked.
var _siteNameById = {};
function rememberSiteNames(sites){ (sites||[]).forEach(function(s){ _siteNameById[String(s.Id)] = s.Name; }); }
$(function(){ $('#listSite .dropdown-item').each(function(){ _siteNameById[String($(this).data('value'))] = $(this).data('text') || $(this).find('span').text(); }); });

// Same scope as the cards (station tab -> ticked stations -> ticked divisions -> ticked
// zones -> all of the user's stations), but waits for a pending Zone->Station lookup so
// a popup opened right after picking a zone gets that zone's stations, not everything.
function withScopeSiteIds(cb){
  var zIds=getValues('zone');
  if(!activeTabSiteId && !getValues('site').length && !getValues('division').length && zIds.length){
    var key=zIds.slice().sort().join(',');
    if(_zoneSiteCache.key!==key){
      _zoneSiteWaiters.push(function(){ cb(_zoneSiteCache.key===key ? _zoneSiteCache.ids : getCardSiteIds()); });
      resolveZoneSites(zIds,key);
      return;
    }
  }
  cb(getCardSiteIds());
}

// ==================== DATA LOAD ====================
function fnBindAssetAndAlertCount(includeIOT) {
  $.ajax({
    url:'/FRS25/Home/GetAssetList', type:'POST', contentType:'application/json',
    data:JSON.stringify({ZoneIds:getValues('zone'),DivisionIds:getValues('division'),SiteIds:getEffectiveSiteIds()}),
    success: function(r){
      fnGetSystemData();
      if(r){globalAssetData=JSON.parse(r.Record);filterAssetTypeCards(globalAssetData);if(includeIOT)fnBindWithOutAcknowledgementAlert(globalAssetData);}
      else filterAssetTypeCards([]);
      // IoT / Network / Gateway / Sensor are live from the global health sockets; on load and
      // on a filter / tab change re-sum them for the new scope (and refresh the popups'
      // attribute lookup). The plain 60 s heartbeat leaves them to the sockets.
      if(includeIOT) fnGetIOTCount();
    }
  });
}

