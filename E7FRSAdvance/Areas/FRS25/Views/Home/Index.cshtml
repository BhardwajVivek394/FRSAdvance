function BindGraph(alerts, assetData, at) {
  var total=0,pred=0,fail=0;
  if(assetData){var f=assetData.find(function(a){return a.AssetTypeId==at.Id;});total=f?f.Count:0;}
  var pM={},fM={};
  alerts.filter(function(a){return a.AssetTypeId==at.Id&&a.AlertTypeId==alertPredictive;}).forEach(function(a){pM[a.AssetId]=1;});
  alerts.filter(function(a){return a.AssetTypeId==at.Id&&a.AlertTypeId==alertFail;}).forEach(function(a){fM[a.AssetId]=1;});
  pred=Object.keys(pM).length; fail=Object.keys(fM).length;
  var healthy=Math.max(0,total-pred-fail);
  var cid=at.Name.replace(/ /g,'');
  $('.totalcount-'+cid).text(total);
  $('.healthycount-'+cid).text(healthy+'/'+total);
  $('.predictivecount-'+cid).text(pred+'/'+total);
  $('.failurecount-'+cid).text(fail+'/'+total);
  var sum=healthy+pred+fail;
  var hPct=sum>0?((healthy/sum)*100).toFixed(1):'0.0';
  var pPct=sum>0?((pred/sum)*100).toFixed(1):'0.0';
  var fPct=sum>0?((fail/sum)*100).toFixed(1):'0.0';
  $('.healthy-pct-'+cid).text(hPct+'%');
  $('.predictive-pct-'+cid).text(pPct+'%');
  $('.failure-pct-'+cid).text(fPct+'%');
  var el=document.getElementById('Main-'+cid); if(!el) return;
  var ec=echarts.getInstanceByDom(el); if(ec) ec.dispose();
  var chart=echarts.init(el,null,{renderer:'svg'});
  var statusColor=parseFloat(hPct)>=70?CLRS.green:parseFloat(hPct)>=40?CLRS.amber:CLRS.red;
  var statusText=parseFloat(hPct)>=70?'Healthy':parseFloat(hPct)>=40?'Warning':'Critical';
  chart.setOption({
    backgroundColor:'transparent',
      tooltip: {
          trigger: 'item',
          confine: true,
          backgroundColor: CLRS.tipBg,
          borderColor: CLRS.tipBorder,
          borderWidth: 1,
          padding: [8, 12],
          extraCssText: 'background:#0a0f24 !important;border:1px solid #22d3ee !important;backdrop-filter:none !important;-webkit-backdrop-filter:none !important;box-shadow:0 8px 24px rgba(0,0,0,0.8) !important;border-radius:8px !important;',          textStyle: { color: CLRS.tipText, fontSize: 12 },
          formatter: function (p) {
              var pct = sum > 0 ? ((p.value / sum) * 100).toFixed(1) : '0.0';
              return '<div style="font-weight:600;margin-bottom:6px;"><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + p.color + ';margin-right:6px;"></span>' + p.name + '</div>Count: <b>' + p.value + '</b><br/>Pct: <b>' + pct + '%</b><br/>Of Total: <b>' + p.value + '/' + total + '</b>';
          }
      },
    title:[
      { text:hPct+'%', left:'center', top:'36%', textStyle:{color:statusColor,fontWeight:'700',fontSize:18,fontFamily:"'DM Mono',monospace"} },
      { text:statusText, left:'center', top:'50%', textStyle:{color:CLRS.text,fontWeight:'500',fontSize:10,fontFamily:"'DM Sans',sans-serif"} }
    ],
    series:[{
        type: 'pie', radius: ['38%', '62%'], center: ['50%', '48%'], avoidLabelOverlap: false,      itemStyle:{ borderColor:CLRS.bg, borderWidth:2, borderRadius:4 },
        label: { show: false },
        labelLine: { show: false },
      emphasis:{ itemStyle:{shadowBlur:12,shadowColor:'rgba(0,0,0,0.3)'}, scale:true, scaleSize:6 },
      data:[
        {name:'Failure',   value:fail,    itemStyle:{color:CLRS.red}},
        {name:'Healthy',   value:healthy, itemStyle:{color:CLRS.green}},
        {name:'Predictive',value:pred,    itemStyle:{color:CLRS.amber}}
      ]
    }]
  });
  // Ensure the chart picks up the 130px container size set by CSS
  setTimeout(function(){ try { chart.resize(); } catch(e) {} }, 50);
  window.addEventListener('resize', function(){chart.resize();});
}

function updateTotalAssetsCard(d) {
  var total=d.TotalAsset||0,pred=d.Predictive||0,fail=d.Fail||0;
  var healthy=Math.max(0,total-pred-fail);
  $('#totalAssetsCount').text(formatNumber(total));
  $('#totalAssetsHealthy').text(formatNumber(healthy)+'/'+formatNumber(total));
  $('#totalAssetsPredictive').text(formatNumber(pred)+'/'+formatNumber(total));
  $('#totalAssetsFailure').text(formatNumber(fail)+'/'+formatNumber(total));
  var ratio=total>0?(healthy/total)*100:0;
  var $icon=$('#totalAssetsTrendIcon'), $no=$('#totalAssetsCount');
  $icon.removeClass('fa-arrow-trend-up fa-arrow-trend-down text-success text-warning text-danger');
  $no.removeClass('text-success text-warning text-danger');
  if(ratio>=70){$icon.addClass('fa-arrow-trend-up text-success');$no.addClass('text-success');}
  else if(ratio>=40){$icon.addClass('fa-arrow-trend-down text-warning');$no.addClass('text-warning');}
  else{$icon.addClass('fa-arrow-trend-down text-danger');$no.addClass('text-danger');}
}

