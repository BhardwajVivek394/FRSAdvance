        padding: 10px 14px;
    }

    .shm-sensor-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--red);
        flex-shrink: 0;
    }

    .shm-sensor-asset {
        font-weight: 700;
        font-size: 13px;
        color: var(--text-primary);
    }

    .shm-sensor-attr {
        font-size: 12px;
        color: var(--text-secondary);
        margin-top: 2px;
    }

    .shm-sensor-cluster {
        font-size: 11px;
        color: var(--text-muted);
        margin-top: 2px;
    }

    #shmSensorGroupToggle {
        margin: 12px 0 14px;
    }

    .shm-sensor-group {
        margin-bottom: 4px;
    }

    .shm-sensor-group-head {
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--text-muted);
        margin: 14px 0 6px;
        user-select: none;
    }

        .shm-sensor-group-head:first-child {
            margin-top: 0;
        }

        .shm-sensor-group-head:hover {
            color: var(--text-primary);
        }

    .shm-sensor-caret {
        display: inline-block;
        font-size: 10px;
        color: var(--text-muted);
        transition: transform .15s;
        transform: rotate(0deg);
    }

    .shm-sensor-group.open .shm-sensor-caret {
        transform: rotate(90deg);
    }

    .shm-sensor-group-title {
        flex: 1;
    }

    .shm-sensor-group-count {
        display: inline-block;
        font-size: 10px;
        font-weight: 700;
        color: var(--red);
        background: var(--red-dim);
