                int chartIdx = 0;
                foreach (var assettype in ViewBag.FRSAssetType as List<Domain.AssetType>)
                {
                    if (chartIdx >= 3) { break; }
                    string assetId = assettype.Name.Replace(" ", "");
<div class="frs-chart-card">
    <div class="frs-chart-header">
        <span class="frs-chart-title @chartClasses[chartIdx]"><i class="fas @chartIcons[chartIdx]"></i> @assettype.Name</span>
