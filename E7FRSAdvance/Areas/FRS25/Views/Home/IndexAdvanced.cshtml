    </div>

    <!-- Charts -->
    <div class="frs-charts-section">
        <h3 class="frs-section-title"><i class="fas fa-chart-pie"></i> Asset Distribution</h3>
        <div class="frs-charts-grid">
            @if (ViewBag.FRSAssetType != null)
            {
                string[] chartClasses = { "track", "signal", "point" };
                string[] chartIcons = { "fa-road", "fa-traffic-light", "fa-code-branch" };
                int chartIdx = 0;
                foreach (var assettype in ViewBag.FRSAssetType as List<Domain.AssetType>)
                {
                    if (chartIdx >= 3) { break; }
                    string assetId = assettype.Name.Replace(" ", "");
<div class="frs-chart-card">
    <div class="frs-chart-header">
        <span class="frs-chart-title @chartClasses[chartIdx]"><i class="fas @chartIcons[chartIdx]"></i> @assettype.Name</span>
        <div class="frs-chart-toggle">
            <button class="active" onclick="frsChartType('@assetId','pie',this)">Pie</button>
            <button onclick="frsChartType('@assetId','bar',this)">Bar</button>
        </div>
    </div>
    <div class="frs-chart-container" id="chart-@assetId"></div>
</div>                    chartIdx++;
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
    <script>
    var alertPredictive = '@E7FRSAdvance.Utility.Utility.AlertType.Predictive.GetHashCode()';
    var alertFail = '@E7FRSAdvance.Utility.Utility.AlertType.Failure.GetHashCode()';
    var assetTypes = @Html.Raw(Json.Encode(ViewBag.FRSAssetType as List<Domain.AssetType>));

    var frsCharts = {};
    var frsChartTypes = {};
    var frsAssetData = {};

    $(document).ready(function() {
        frsInitCharts();
        fnBindAssetAndAlertCount();
        setInterval(fnBindAssetAndAlertCount, 60000);
    });

    function fnBindAssetAndAlertCount() {
        var mSearchCriteria = {
            SiteId: $('#drpSite').val() || '',
            ZoneId: $('#drpZones').val() || '',
            DivisionId: $('#drpDivisions').val() || ''
        };

        $.ajax({
            url: '/FRS25/Home/GetAssetList',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(mSearchCriteria),
            success: function(assetData) {
                fnGetSystemData();
                if (assetData != null && assetData != undefined) {
                    fnBindWithOutAcknowledgementAlert(JSON.parse(assetData.Record));
                }
            }
        });
    }

    function fnGetSystemData() {
        $.ajax({
            url: '/FRS25/Home/GetSystemData',
            type: 'POST',
            contentType: 'application/json',
            success: function(data) {
                if (data) {
                    frsUpdateRing('cpu', data.CpuUsagePercent);
                    frsUpdateRing('ram', data.Ram.UsagePercent);
                    if (data.Disk && data.Disk.length > 0) frsUpdateRing('storage', data.Disk[0].UsagePercent);
                    frsUpdateRing('uptime', 99.9);
                }
            }
        });
    }

    function fnBindWithOutAcknowledgementAlert(assetData) {
        var mFRSAlertLister = {
            SearchCriteria: {
                SiteId: $('#drpSite').val() || '',
                ZoneId: $('#drpZones').val() || '',
                DivisionId: $('#drpDivisions').val() || '',
                AlertStatus: 2
            }
        };

        $.ajax({
            url: '/FRS25/Home/GetWithOutAcknowledgementAlert',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(mFRSAlertLister),
            success: function(alertData) {
                var totals = { total: 0, healthy: 0, predictive: 0, failure: 0 };

                $(assetTypes).each(function(idx, atype) {
                    var result = frsCalculateStats(alertData, assetData, atype);
                    totals.total += result.total;
                    totals.healthy += result.healthy;
                    totals.predictive += result.predictive;
                    totals.failure += result.failure;

                    var assetId = atype.Name.replace(/\s+/g, '');
                    frsAssetData[assetId] = result;
                    frsUpdateChart(assetId, result);
                });

                frsUpdateTotals(totals);
            }
        });
    }

    function frsCalculateStats(alerts, assetData, atype) {
        var total = 0, predictive = 0, failure = 0, healthy = 0;

        if (assetData && assetData.length > 0) {
            var found = assetData.find(function(a) { return a.AssetTypeId == atype.Id; });
            total = found ? (found.Count || 0) : 0;
        }

        var predAlerts = alerts.filter(function(a) { return a.AssetTypeId == atype.Id && a.AlertTypeId == alertPredictive; });
        var predAssets = {};
        $.each(predAlerts, function(i, a) { predAssets[a.AssetId] = true; });
        predictive = Object.keys(predAssets).length;

        var failAlerts = alerts.filter(function(a) { return a.AssetTypeId == atype.Id && a.AlertTypeId == alertFail; });
        var failAssets = {};
        $.each(failAlerts, function(i, a) { failAssets[a.AssetId] = true; });
        failure = Object.keys(failAssets).length;

        healthy = Math.max(0, total - predictive - failure);

        var id = atype.Name.replace(/\s+/g, '');
        $('.totalcount-' + id).text(total.toLocaleString());
        $('.healthycount-' + id).text(healthy.toLocaleString());
        $('.predictivecount-' + id).text(predictive.toLocaleString());
        $('.failurecount-' + id).text(failure.toLocaleString());

        if (total > 0) {
            $('.healthybar-' + id).css('width', (healthy / total * 100) + '%');
            $('.predictivebar-' + id).css('width', (predictive / total * 100) + '%');
            $('.failurebar-' + id).css('width', (failure / total * 100) + '%');
        }

        return { total: total, healthy: healthy, predictive: predictive, failure: failure };
    }

    function frsUpdateTotals(t) {
        $('#totalAssets').text(t.total.toLocaleString());
        $('#totalHealthy').text(t.healthy.toLocaleString());
        $('#totalPredictive').text(t.predictive.toLocaleString());
        $('#totalFailure').text(t.failure.toLocaleString());
        if (t.total > 0) {
            $('#totalHealthyBar').css('width', (t.healthy / t.total * 100) + '%');
            $('#totalPredictiveBar').css('width', (t.predictive / t.total * 100) + '%');
            $('#totalFailureBar').css('width', (t.failure / t.total * 100) + '%');
        }
    }

    function frsUpdateRing(type, value) {
        var offset = 97.4 - (value / 100) * 97.4;
        $('#' + type + 'Ring').attr('stroke-dashoffset', offset);
        $('#' + type + 'Value').text(value.toFixed(1) + '%');
        var status = value >= 90 ? 'critical' : value >= 70 ? 'high' : 'normal';
        if (type === 'uptime') status = value >= 99 ? 'excellent' : 'normal';
        $('#' + type + 'Status').removeClass('normal high critical excellent').addClass(status).text(status.charAt(0).toUpperCase() + status.slice(1));
    }

    function frsInitCharts() {
        if (assetTypes && assetTypes.length > 0) {
            for (var i = 0; i < Math.min(assetTypes.length, 3); i++) {
                var id = assetTypes[i].Name.replace(/\s+/g, '');
                var el = document.getElementById('chart-' + id);
                if (el) { frsCharts[id] = echarts.init(el); frsChartTypes[id] = 'pie'; }
            }
        }
        window.addEventListener('resize', function() { for (var k in frsCharts) if (frsCharts[k]) frsCharts[k].resize(); });
    }

    function frsUpdateChart(id, d) {
        var c = frsCharts[id]; if (!c) return;
        c.setOption(frsChartTypes[id] === 'pie' ? frsPieOpt(d) : frsBarOpt(d), true);
    }

    function frsPieOpt(d) {
        return {
            tooltip: { trigger: 'item', formatter: '{b}: {c} ({d}%)', backgroundColor: 'rgba(30,38,56,0.95)', borderColor: 'rgba(255,255,255,0.1)', borderWidth: 1, textStyle: { color: '#f8fafc', fontSize: 12 } },
            series: [{
                type: 'pie', radius: ['45%', '70%'],
                itemStyle: { borderRadius: 6, borderColor: '#1e2638', borderWidth: 3 },
                label: { show: false },
                emphasis: {
                    scale: true, scaleSize: 8,
                    itemStyle: { shadowBlur: 20, shadowColor: 'rgba(0,0,0,0.5)' }
                },
                data: [
                    { value: d.healthy, name: 'Healthy', itemStyle: { color: { type: 'linear', x: 0, y: 0, x2: 1, y2: 1, colorStops: [{ offset: 0, color: '#10b981' }, { offset: 1, color: '#34d399' }] } } },
                    { value: d.predictive, name: 'Predictive', itemStyle: { color: { type: 'linear', x: 0, y: 0, x2: 1, y2: 1, colorStops: [{ offset: 0, color: '#f59e0b' }, { offset: 1, color: '#fbbf24' }] } } },
                    { value: d.failure, name: 'Failure', itemStyle: { color: { type: 'linear', x: 0, y: 0, x2: 1, y2: 1, colorStops: [{ offset: 0, color: '#ef4444' }, { offset: 1, color: '#f87171' }] } } }
                ]
            }]
        };
    }

    function frsBarOpt(d) {
        return {
            tooltip: { trigger: 'axis', backgroundColor: 'rgba(30,38,56,0.95)', borderColor: 'rgba(255,255,255,0.1)', textStyle: { color: '#f8fafc' } },
            grid: { left: '3%', right: '4%', bottom: '3%', top: '15%', containLabel: true },
            xAxis: { type: 'category', data: ['Healthy', 'Predictive', 'Failure'], axisLine: { lineStyle: { color: '#374151' } }, axisLabel: { color: '#94a3b8', fontSize: 10, fontWeight: 600 } },
            yAxis: { type: 'value', axisLine: { show: false }, axisLabel: { color: '#64748b', fontSize: 10 }, splitLine: { lineStyle: { color: 'rgba(255,255,255,0.05)' } } },
            series: [{
                type: 'bar', barWidth: '50%',
                itemStyle: { borderRadius: [6, 6, 0, 0] },
                data: [
                    { value: d.healthy, itemStyle: { color: { type: 'linear', x: 0, y: 0, x2: 0, y2: 1, colorStops: [{ offset: 0, color: '#34d399' }, { offset: 1, color: '#10b981' }] } } },
                    { value: d.predictive, itemStyle: { color: { type: 'linear', x: 0, y: 0, x2: 0, y2: 1, colorStops: [{ offset: 0, color: '#fbbf24' }, { offset: 1, color: '#f59e0b' }] } } },
                    { value: d.failure, itemStyle: { color: { type: 'linear', x: 0, y: 0, x2: 0, y2: 1, colorStops: [{ offset: 0, color: '#f87171' }, { offset: 1, color: '#ef4444' }] } } }
                ]
            }]
        };
    }

    function frsChartType(id, type, btn) {
        frsChartTypes[id] = type;
        $(btn).siblings().removeClass('active'); $(btn).addClass('active');
        if (frsAssetData[id]) frsUpdateChart(id, frsAssetData[id]);
    }

    function frsGetDivision() {
        var z = $('#drpZones').val();
        $('#drpDivisions').html('<option value="">All Divisions</option>');
        $('#drpSite').html('<option value="">All Sites</option>');
        if (z) {
            $.ajax({ url: '/FRS25/Home/GetDivisionByZoneId', type: 'POST', data: '{zoneId:' + z + '}', contentType: 'application/json',
                success: function(d) { $.each(d, function(k, v) { $('#drpDivisions').append('<option value="' + v.Id + '">' + v.Name + '</option>'); }); }
            });
        }
    }

    function frsGetSite() {
        var d = $('#drpDivisions').val();
        $('#drpSite').html('<option value="">All Sites</option>');
        if (d) {
            $.ajax({ url: '/FRS25/Home/GetSiteByDivisionId', type: 'POST', data: '{divisionId:' + d + '}', contentType: 'application/json',
                success: function(data) { $.each(data, function(k, v) { $('#drpSite').append('<option value="' + v.Id + '">' + v.Name + '</option>'); }); }
            });
        }
    }
    </script>
}
