@*=============================================================================
        Editor library — MUST load before any SipEditor.* call.
    =============================================================================*@
<script src="~/Areas/FRS25/assets/sip/js/sip-library.js"></script>
<script src="~/Areas/FRS25/assets/sip/js/sip-editor.js"></script>

<script>
    /* =========================================================================
       Page glue — just two AJAX calls. The editor itself works directly on the
       OLD Rappid cell shape so there is NOTHING to convert on this side.
       SipEditor.getLayout() returns { cells: [...] }; SipEditor.setLayout()
       accepts the same shape (and the parsed JSON from the legacy table).
       ========================================================================= */

    $(document).ready(function () {
        WireSiteFilters();
        WireSipAssetPopup();
        // The controller's Index action already bound the AdvancedSIPView for
        // the requested siteId.  If hdnSipViewData has content, push it
        // straight into the editor — no GetSipView AJAX needed.  If not, we
        // fall back to AJAX so the legacy load path still works.
        var siteId = parseInt($("#hdnSiteId").val() || '0', 10);
        if (siteId > 0) {
            $("#site-id-readout").text(siteId);
            var pre = $("#hdnSipViewData").val();
            if (pre) {
                hydrateEditorFromString(pre);
            } else {
                // No saved layout for this site yet (create case) — the
                // canvas just stays blank; first Save will create the row.
                $("#sipStatus").text('New SIP — site ' + siteId);
            }
        }
    });

    /* Parse a server-supplied SIP view string and push it into the editor. */
    function hydrateEditorFromString(viewStr) {
        var parsed;
        try { parsed = JSON.parse(viewStr); }
        catch (e) {
            console.error('[SIP] Could not parse pre-loaded layout:', e);
            return;
        }
        waitForEditor(function () {
            SipEditor.setLayout(parsed);
            $("#sipStatus").text('Loaded · ' + ((parsed.cells || parsed || []).length || 0) + ' cells');
        });
    }

    /* -------------------------------------------------------------------------
       Zone / Division / Site cascade.
       Zones are rendered server-side from ViewBag.Zones.  When a zone is
       picked we POST { zoneId } to GetDivisionByZoneId; when a division is
       picked we POST { divisionId } to GetSiteByDivisionId.  Same endpoint
       names you're using elsewhere — see SipController.GetDivisionByZoneId
       and SipController.GetSiteByDivisionId.
       ------------------------------------------------------------------------- */
    function LoadDivisions(zoneId) {
        if (!zoneId) {
            $('#division-select').prop('disabled', true).html('<option value="">— select division —</option>');
            $('#site-select').prop('disabled', true).html('<option value="">— select site —</option>');
            return;
        }
        $.ajax({
            url: '/Sip/GetDivisionByZoneId',
            type: 'Post',
            data: '{zoneId:' + zoneId + '}',
            contentType: 'application/json',
            success: function (data) {
                fillSelect('#division-select', data, '— select division —');
                $('#division-select').prop('disabled', false);
                $('#site-select').prop('disabled', true).html('<option value="">— select site —</option>');
            },
            error: function () {
                fillSelect('#division-select', [], '— (no divisions) —');
            }
        });
    }

    function LoadSites(divisionId) {
        if (!divisionId) {
            $('#site-select').prop('disabled', true).html('<option value="">— select site —</option>');
            return;
        }
        $.ajax({
            url: '/Sip/GetSiteByDivisionId',
            type: 'Post',
            data: '{divisionId:' + divisionId + '}',
            contentType: 'application/json',
            success: function (data) {
                fillSelect('#site-select', data, '— select site —');
                $('#site-select').prop('disabled', false);
            },
            error: function () {
                fillSelect('#site-select', [], '— (no sites) —');
            }
        });
    }

    function fillSelect(selector, data, placeholder) {
        var html = '<option value="">' + placeholder + '</option>';
        (data || []).forEach(function (item) {
            var id = item.Id != null ? item.Id : (item.id != null ? item.id : '');
            var name = item.Name != null ? item.Name : (item.name != null ? item.name : id);
            html += '<option value="' + id + '">' + name + '</option>';
        });
        $(selector).html(html);
    }

    function WireSiteFilters() {
        $('#zone-select').on('change', function () { LoadDivisions($(this).val()); });
        $('#division-select').on('change', function () { LoadSites($(this).val()); });
        $('#site-select').on('change', function () {
            var siteId = parseInt($(this).val() || '0', 10);
            $("#hdnSiteId").val(siteId || 0);
            $("#hdnId").val(0);   // reset row id — GetSipView() will set it if a saved row exists
            $("#site-id-readout").text(siteId || '—');
            $("#sipStatus").text('');
            if (!siteId) return;
            // Clear the canvas before pulling the new site's layout so the user
            // doesn't briefly see the previous site's geometry.
            if (window.SipEditor && typeof SipEditor.loadPreset === 'function') {
                SipEditor.loadPreset('blank');
            }
            GetSipView();
        });
    }

    /* -------------------------------------------------------------------------
       SaveSipView — POSTs { SiteId, Id, SipView } to /Site/SaveAdvSipView.
       SipView is the stringified getLayout() output — i.e. exactly the
       OLD Rappid { "cells": [...] } shape that the advancesipview table
       and Sview.cshtml runtime both expect.
       ------------------------------------------------------------------------- */
    function SaveSipView() {
        if (!window.SipEditor || typeof SipEditor.getLayout !== 'function') {
            CommonNotification("ERROR", "Editor not ready yet.", "Error");
            return;
        }

        var siteId = parseInt($("#hdnSiteId").val() || '0', 10);
        if (!siteId) {
            CommonNotification("warning", "Please select a Zone, Division and Site before saving.", "Site required");
            return;
        }

        var layout = SipEditor.getLayout();   // { cells: [...] } — OLD RAPPID

        var sipView = {
            SiteId: siteId,
            Id: $("#hdnId").val(),
            SipView: JSON.stringify(layout)
        };

        $.ajax({
            url: '/Sip/SaveAdvSipView',
            type: 'Post',
            data: '{sipView:' + JSON.stringify(sipView) + '}',
            contentType: 'application/json',
            success: function (data) {
                if (data === true) {
                    $("#sipStatus").text('Saved · ' + (layout.cells || []).length + ' cells');
                    CommonNotification("success", "SipView has been Saved.", "success");
                } else {
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            },
            error: function () {
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    /* -------------------------------------------------------------------------
       GetSipView — fetches the saved layout (if any) and hands it to the
       editor. The server endpoint should prefer advancesipview first and
       fall back to the legacy sipview row so existing sites keep loading.

       SipEditor.setLayout() accepts any of:
         • { cells: [...] }                      — canonical OLD Rappid
         • [<cell>, <cell>, ...]                 — bare cells array
         • [{type, props, stencilType, ...}, …]  — older NEW-format saves
       So we can safely pass whatever the server returned without inspection.
       ------------------------------------------------------------------------- */
    function GetSipView() {
        var siteId = parseInt($("#hdnSiteId").val() || '0', 10);
        if (!siteId) { return; }      // nothing to fetch until a site is picked
        $.ajax({
            url: '/Sip/GetSipView',
            type: 'Post',
            data: '{siteId:' + siteId + '}',
            contentType: 'application/json',
            success: function (data) {
                if (!data || !data.Id || data.Id <= 0 || !data.SipView) {
                    // Blank canvas for a site that has no saved layout yet.
                    if (window.SipEditor && typeof SipEditor.loadPreset === 'function') {
                        SipEditor.loadPreset('blank');
                    }
                    return;
                }
                $("#hdnId").val(data.Id);

                var parsed;
                try { parsed = JSON.parse(data.SipView); }
                catch (e) {
                    console.error('[SIP] Could not parse saved layout:', e);
                    return;
                }

                waitForEditor(function () {
                    SipEditor.setLayout(parsed);
                    $("#sipStatus").text('Loaded · ' + ((parsed.cells || parsed || []).length || 0) + ' cells');
                });
            },
            error: function () { /* silent on first load */ }
        });
    }

    /* Wait until sip-editor.js has finished init() before pushing data into it. */
    function waitForEditor(cb, tries) {
        tries = tries || 0;
        if (window.SipEditor && typeof SipEditor.setLayout === 'function') {
            cb();
        } else if (tries < 20) {
            setTimeout(function () { waitForEditor(cb, tries + 1); }, 50);
        } else {
            console.error('[SIP] Editor failed to initialise.');
        }
    }

    /* -------------------------------------------------------------------------
       SipAssetSource — feeds the inspector's "Asset" dropdown.
       Returns the existing assets of a given stencil type for the current
       site so the operator can pick e.g. an existing track-circuit name
       instead of typing it freehand.
       ------------------------------------------------------------------------- */
    window.SipAssetSource = function (stencilType, callback) {
        $.ajax({
            url: '/Sip/GetAllAssetWithAttribute',
            type: 'Post',
            data: '{stencilType:"' + stencilType + '",siteId:' + $("#hdnSiteId").val() + '}',
            contentType: 'application/json',
            success: function (data) {
                var list = (data || []).map(function (a) {
                    return { id: a.Id || a.id || a.Name, name: a.Name || a.name };
                });
                callback(list);
            },
            error: function () { callback([]); }
        });
    };
    /* -------------------------------------------------------------------------
       SIP Asset Detail Popup
       - Opens on click of any canvas asset.
       - Resolves the clicked SIP cell, fetches live attributes through the
         existing /Sip/GetAllAssetWithAttribute endpoint, and renders all
         selected-asset attributes in the Live tab.
       ------------------------------------------------------------------------- */
    (function () {
        var state = {
            mouseDown: null,
            currentContext: null,
            currentLiveRows: [],
            refreshTimer: null,
            popupUiBound: false,
            canvasBound: false,
            editorEventBound: false,
            lastOpenKey: '',
            lastOpenAt: 0
        };

        window.WireSipAssetPopup = function () {
            bindPopupUiOnce();
            bindCanvasClickOnce();
            bindEditorAssetClickEventOnce();
            initialisePopupDates();
        };

        window.OpenSipAssetPopupFromCell = function (cellOrContext, sourceInfo) {
            debugger;
            bindPopupUiOnce();
            bindEditorAssetClickEventOnce();
            initialisePopupDates();

            var context = resolveAssetContextFromCell(cellOrContext, sourceInfo);
            if (!context) return false;

            openAssetPopup(context);
            return true;
        };

        function bindEditorAssetClickEventOnce() {
            if (state.editorEventBound) return;
            state.editorEventBound = true;

            window.addEventListener('sip:asset-click', function (e) {
                if (!e || !e.detail) return;
                window.OpenSipAssetPopupFromCell(e.detail.cell || e.detail.context || e.detail, e.detail);
            });
        }

        function bindCanvasClickOnce() {
            var canvas = document.getElementById('canvas');
            if (!canvas || state.canvasBound) return;
            state.canvasBound = true;

            canvas.addEventListener('mousedown', function (e) {
                state.mouseDown = { x: e.clientX, y: e.clientY, target: e.target };
            }, true);

            canvas.addEventListener('click', function (e) {
                if (!state.mouseDown) return;
                var dx = Math.abs((e.clientX || 0) - state.mouseDown.x);
                var dy = Math.abs((e.clientY || 0) - state.mouseDown.y);
                if (dx > 5 || dy > 5) return; // drag/move inside editor, do not open popup

                var context = resolveAssetContextFromClick(e.target);
                if (!context) return;

                setTimeout(function () { openAssetPopup(context); }, 0);
            }, true);
        }

        function bindPopupUiOnce() {
            if (state.popupUiBound) return;
            var overlay = document.getElementById('sipAssetPopupOverlay');
            if (!overlay) return;
            state.popupUiBound = true;

            document.getElementById('sipAssetPopupClose').addEventListener('click', closeAssetPopup);
            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) closeAssetPopup();
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && overlay.classList.contains('sap-show')) closeAssetPopup();
            });

            overlay.querySelectorAll('.sap-tab').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    activatePopupTab(tab.getAttribute('data-sap-tab'));
                });
            });

            overlay.querySelectorAll('.sap-range-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    overlay.querySelectorAll('.sap-range-btn').forEach(function (b) { b.classList.remove('sap-active'); });
                    btn.classList.add('sap-active');
                    drawAssetChart();
                });
            });

            var paramSelect = document.getElementById('sipAssetParamSelect');
            if (paramSelect) paramSelect.addEventListener('change', drawAssetChart);
            var graphDate = document.getElementById('sipAssetGraphDate');
            if (graphDate) graphDate.addEventListener('change', drawAssetChart);

            document.getElementById('sipAssetMaintBtn').addEventListener('click', function () {
                document.getElementById('sipAssetMaintModal').classList.add('sap-show');
            });
            document.getElementById('sipAssetMaintCancel').addEventListener('click', function () {
                document.getElementById('sipAssetMaintModal').classList.remove('sap-show');
            });
            document.getElementById('sipAssetMaintModal').addEventListener('click', function (e) {
                if (e.target === this) this.classList.remove('sap-show');
            });
            document.getElementById('sipAssetMaintActivate').addEventListener('click', function () {
                document.getElementById('sipAssetMaintModal').classList.remove('sap-show');
                var btn = document.getElementById('sipAssetMaintBtn');
                btn.classList.add('sap-active-mode');
                btn.innerHTML = '<svg class="sap-wrench" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg> Maint. Mode Active';
            });

            var exportBtn = document.getElementById('sipAssetExportBtn');
            if (exportBtn) {
                exportBtn.addEventListener('click', function () {
                    exportCurrentLiveRows();
                });
            }

            window.addEventListener('resize', function () {
                var graphTab = document.getElementById('sap-tab-graph');
                if (graphTab && graphTab.classList.contains('sap-active')) drawAssetChart();
            });
        }

        function initialisePopupDates() {
            var now = new Date();
            var today = toDateInput(now);
            ['sipAssetAnalyticsFrom', 'sipAssetAnalyticsTo', 'sipAssetGraphDate', 'sipAssetEventFrom', 'sipAssetEventTo'].forEach(function (id) {
                var el = document.getElementById(id);
                if (el && !el.value) el.value = today;
            });

            var start = document.getElementById('sipAssetMaintStart');
            var end = document.getElementById('sipAssetMaintEnd');
            if (start && !start.value) start.value = toDateTimeInput(now);
            if (end && !end.value) {
                var endDt = new Date(now.getTime() + (8 * 60 * 60 * 1000));
                end.value = toDateTimeInput(endDt);
            }
        }

        function resolveAssetContextFromCell(cellOrContext, sourceInfo) {
            if (!cellOrContext) return null;

            var explicit = cellOrContext || {};
            var source = sourceInfo || {};
            var cell = explicit.cell || explicit.Cell || cellOrContext;
            var meta = extractCellMeta(cell);

            meta.cell = cell || null;
            meta.assetId = firstNonEmpty(explicit.assetId, explicit.AssetId, source.assetId, source.AssetId, meta.assetId);
            meta.assetName = firstNonEmpty(explicit.assetName, explicit.AssetName, source.assetName, source.AssetName, meta.assetName, meta.label, meta.title, meta.cellId, 'Selected Asset');
            meta.stencilType = firstNonEmpty(explicit.stencilType, explicit.StencilType, source.stencilType, source.StencilType, meta.stencilType, meta.type);
            meta.type = firstNonEmpty(explicit.type, explicit.Type, source.type, source.Type, meta.type, meta.stencilType);
            meta.location = firstNonEmpty(explicit.location, explicit.Location, source.location, source.Location, meta.location, getSelectedSitePath());
            meta.cellId = firstNonEmpty(explicit.cellId, explicit.CellId, explicit.id, explicit.Id, source.cellId, source.CellId, source.id, source.Id, meta.cellId);

            if (!meta.assetName && !meta.assetId && !meta.cellId) return null;
            return meta;
        }

        function resolveAssetContextFromClick(target) {
            var canvas = document.getElementById('canvas');
            if (!canvas || !target || target === canvas) return null;

            var svgCellEl = closestRenderableSvgNode(target, canvas);
            if (!svgCellEl) return null;

            var ids = collectDomIdentifiers(svgCellEl, canvas);
            var domLabel = extractDomLabel(svgCellEl);
            var layout = getCurrentSipLayout();
            var cells = normalizeCells(layout);
            var cell = findCellByIdentifiers(cells, ids) || findCellByLabel(cells, domLabel);
            var meta = cell ? extractCellMeta(cell) : {};

            meta.cell = cell || null;
            meta.domElement = svgCellEl;
            meta.domLabel = domLabel;
            meta.assetId = firstNonEmpty(meta.assetId, ids.assetId);
            meta.assetName = firstNonEmpty(meta.assetName, domLabel, ids.title);
            meta.stencilType = firstNonEmpty(meta.stencilType, ids.stencilType, meta.type);
            meta.type = firstNonEmpty(meta.type, meta.stencilType, ids.domType);
            meta.location = firstNonEmpty(meta.location, getSelectedSitePath());
            meta.cellId = firstNonEmpty(meta.cellId, ids.cellId, ids.domId);

            if (!meta.assetName && !meta.assetId && !meta.cellId) return null;
            return meta;
        }

        function closestRenderableSvgNode(target, boundary) {
            var el = target.nodeType === 1 ? target : target.parentNode;
            var fallbackWithId = null;
            while (el && el !== boundary) {
                if (el.nodeType !== 1) break;
                var tag = (el.tagName || '').toLowerCase();
                var hasSipData = el.getAttribute('data-cell-id') || el.getAttribute('model-id') || el.getAttribute('data-model-id') || el.getAttribute('data-id') || el.getAttribute('data-asset-id') || el.getAttribute('data-stencil-type');
                if (hasSipData) return el;
                if (tag === 'g') return el;
                if (tag !== 'svg' && el.id && !fallbackWithId) fallbackWithId = el;
                el = el.parentNode;
            }
            return fallbackWithId;
        }

        function collectDomIdentifiers(el, boundary) {
            var ids = { raw: [] };
            var node = el;
            while (node && node !== boundary && node.nodeType === 1) {
                pushIdentifier(ids.raw, node.getAttribute('data-cell-id'));
                pushIdentifier(ids.raw, node.getAttribute('data-model-id'));
                pushIdentifier(ids.raw, node.getAttribute('model-id'));
                pushIdentifier(ids.raw, node.getAttribute('data-id'));
                pushIdentifier(ids.raw, node.getAttribute('id'));
                pushIdentifier(ids.raw, node.id);

                ids.assetId = firstNonEmpty(ids.assetId, node.getAttribute('data-asset-id'), node.getAttribute('asset-id'));
                ids.stencilType = firstNonEmpty(ids.stencilType, node.getAttribute('data-stencil-type'), node.getAttribute('stencil-type'));
                ids.title = firstNonEmpty(ids.title, node.getAttribute('title'), node.getAttribute('aria-label'));
                ids.domType = firstNonEmpty(ids.domType, node.getAttribute('data-type'), node.getAttribute('type'));
                ids.cellId = firstNonEmpty(ids.cellId, node.getAttribute('data-cell-id'), node.getAttribute('data-model-id'), node.getAttribute('model-id'));
                ids.domId = firstNonEmpty(ids.domId, node.getAttribute('id'), node.id);
                node = node.parentNode;
            }
            ids.raw = uniqueStrings(ids.raw);
            return ids;
        }

        function pushIdentifier(list, value) {
            value = cleanString(value);
            if (!value) return;
            if (value === 'canvas') return;
            list.push(value);
        }

        function getCurrentSipLayout() {
            if (window.SipEditor && typeof SipEditor.getLayout === 'function') {
                try { return SipEditor.getLayout(); } catch (e) { console.warn('[SIP] getLayout failed:', e); }
            }
            var pre = $('#hdnSipViewData').val();
            if (pre) {
                try { return JSON.parse(pre); } catch (ignore) { }
            }
            return { cells: [] };
        }

        function normalizeCells(layout) {
            if (!layout) return [];
            if (Array.isArray(layout)) return layout;
            if (Array.isArray(layout.cells)) return layout.cells;
            return [];
        }

        function findCellByIdentifiers(cells, ids) {
            var raw = ids && ids.raw ? ids.raw : [];
            if (!cells.length || !raw.length) return null;

            for (var i = 0; i < raw.length; i++) {
                var id = raw[i];
                for (var c = 0; c < cells.length; c++) {
                    var cell = cells[c];
                    var cellIds = extractCellIdentifierCandidates(cell);
                    for (var j = 0; j < cellIds.length; j++) {
                        if (sameIdentifier(cellIds[j], id)) return cell;
                    }
                }
            }
            return null;
        }

        function findCellByLabel(cells, label) {
            label = normalizeText(label);
            if (!cells.length || !label) return null;
            for (var i = 0; i < cells.length; i++) {
                var meta = extractCellMeta(cells[i]);
                var name = normalizeText(firstNonEmpty(meta.assetName, meta.label, meta.title));
                if (name && name === label) return cells[i];
            }
            return null;
        }

        function extractCellIdentifierCandidates(cell) {
            var candidates = [];
            ['id', 'Id', 'ID', 'cid', 'modelId', 'ModelId', 'assetId', 'AssetId', 'assetID'].forEach(function (key) {
                if (cell && cell[key] != null) candidates.push(cell[key]);
            });
            if (cell && cell.props) {
                ['id', 'Id', 'assetId', 'AssetId', 'modelId', 'ModelId'].forEach(function (key) {
                    if (cell.props[key] != null) candidates.push(cell.props[key]);
                });
            }
            if (cell && cell.data) {
                ['id', 'Id', 'assetId', 'AssetId', 'modelId', 'ModelId'].forEach(function (key) {
                    if (cell.data[key] != null) candidates.push(cell.data[key]);
                });
            }
            return uniqueStrings(candidates.map(cleanString));
        }

        function sameIdentifier(a, b) {
            a = cleanString(a);
            b = cleanString(b);
            if (!a || !b) return false;
            if (a === b) return true;
            if (a.length >= 8 && b.indexOf(a) >= 0) return true;
            if (b.length >= 8 && a.indexOf(b) >= 0) return true;
            return false;
        }

        function extractDomLabel(el) {
            if (!el) return '';
            var textEl = el.tagName && el.tagName.toLowerCase() === 'text' ? el : el.querySelector && el.querySelector('text');
            var text = textEl ? cleanString(textEl.textContent) : '';
            if (text && text.length <= 100) return text;

            var labelAttrs = ['data-asset-name', 'asset-name', 'data-name', 'title', 'aria-label'];
            for (var i = 0; i < labelAttrs.length; i++) {
                text = cleanString(el.getAttribute(labelAttrs[i]));
                if (text) return text;
            }
            return '';
        }

        function extractCellMeta(cell) {
            cell = cell || {};
            var props = cell.props || {};
            var data = cell.data || {};
            var attrs = cell.attrs || {};
            var labelFromAttrs = extractLabelFromAttrs(attrs);

            var meta = {
                cellId: firstNonEmpty(cell.id, cell.Id, props.id, props.Id),
                type: firstNonEmpty(cell.type, cell.Type, props.type, props.Type),
                stencilType: firstNonEmpty(cell.stencilType, cell.StencilType, props.stencilType, props.StencilType, data.stencilType, data.StencilType),
                assetId: firstNonEmpty(cell.assetId, cell.AssetId, props.assetId, props.AssetId, data.assetId, data.AssetId, deepFindValue(cell, ['assetid', 'assetmasterid', 'assetpk'], 4)),
                assetName: firstNonEmpty(cell.assetName, cell.AssetName, props.assetName, props.AssetName, data.assetName, data.AssetName, cell.name, cell.Name, props.name, props.Name, labelFromAttrs, deepFindValue(cell, ['assetname', 'tagname'], 4)),
                label: labelFromAttrs,
                title: firstNonEmpty(cell.title, cell.Title, props.title, props.Title),
                location: firstNonEmpty(cell.location, cell.Location, props.location, props.Location, data.location, data.Location)
            };

            meta.attributes = extractAttributeRows(cell);
            return meta;
        }

        function extractLabelFromAttrs(attrs) {
            if (!attrs || typeof attrs !== 'object') return '';
            var preferredKeys = ['label', '.label', 'text', '.text', 'labelText', 'name', 'title'];
            for (var i = 0; i < preferredKeys.length; i++) {
                var v = attrs[preferredKeys[i]];
                var text = extractPossibleText(v);
                if (text) return text;
            }
            for (var key in attrs) {
                if (!Object.prototype.hasOwnProperty.call(attrs, key)) continue;
                var found = extractPossibleText(attrs[key]);
                if (found) return found;
            }
            return '';
        }

        function extractPossibleText(value) {
            if (typeof value === 'string' || typeof value === 'number') return cleanString(value);
            if (!value || typeof value !== 'object') return '';
            return firstNonEmpty(value.text, value.Text, value.label, value.Label, value.name, value.Name, value.title, value.Title, value['text/value']);
        }

        function openAssetPopup(context) {
            var overlay = document.getElementById('sipAssetPopupOverlay');
            if (!overlay) return;

            var openKey = firstNonEmpty(context.cellId, context.assetId, context.assetName, context.stencilType, context.type);
            var nowTick = Date.now ? Date.now() : new Date().getTime();
            if (openKey && state.lastOpenKey === openKey && (nowTick - state.lastOpenAt) < 350) return;
            state.lastOpenKey = openKey || '';
            state.lastOpenAt = nowTick;

            clearRefreshTimer();
            state.currentContext = context;
            state.currentLiveRows = [];

            var name = firstNonEmpty(context.assetName, context.cellId, 'Selected Asset');
            setText('sipAssetPopupAssetName', name);
            setText('sipAssetPopupAssetLocation', firstNonEmpty(context.location, getSelectedSitePath(), 'Site ' + ($('#hdnSiteId').val() || '—')));
            setText('sipAssetTelemetryTitle', 'Live Telemetry — ' + name);
            setText('sipAssetFooterType', 'Type: ' + firstNonEmpty(context.stencilType, context.type, '—'));
            setText('sipAssetMaintSub', 'Put ' + name + ' into maintenance mode to suppress alerts during scheduled work.');
            setHtml('sipAssetAlarmBannerText', escapeHtml(name) + ' alarm summary<span>Live alarm binding can be connected to your alarm endpoint.</span>');

            activatePopupTab('live');
            overlay.classList.add('sap-show');
            overlay.setAttribute('aria-hidden', 'false');
            renderTelemetryLoading(name);
            refreshAssetLiveValues(true);

            state.refreshTimer = setInterval(function () {
                refreshAssetLiveValues(false);
            }, 30000);
        }

        function closeAssetPopup() {
            var overlay = document.getElementById('sipAssetPopupOverlay');
            if (!overlay) return;
            overlay.classList.remove('sap-show');
            overlay.setAttribute('aria-hidden', 'true');
            document.getElementById('sipAssetMaintModal').classList.remove('sap-show');
            clearRefreshTimer();
        }

        function clearRefreshTimer() {
            if (state.refreshTimer) {
                clearInterval(state.refreshTimer);
                state.refreshTimer = null;
            }
        }

        function activatePopupTab(tabName) {
            var overlay = document.getElementById('sipAssetPopupOverlay');
            if (!overlay) return;
            overlay.querySelectorAll('.sap-tab').forEach(function (tab) {
                tab.classList.toggle('sap-active', tab.getAttribute('data-sap-tab') === tabName);
            });
            overlay.querySelectorAll('.sap-tab-content').forEach(function (content) {
                content.classList.toggle('sap-active', content.id === 'sap-tab-' + tabName);
            });
            if (tabName === 'graph') setTimeout(drawAssetChart, 50);
        }

        function refreshAssetLiveValues(showLoading) {
            var context = state.currentContext;
            if (!context) return;

            var siteId = parseInt($('#hdnSiteId').val() || '0', 10);
            var stencilType = firstNonEmpty(context.stencilType, context.type, '');
            var fallbackRows = normalizeRows(context.attributes || []);

            if (showLoading) renderTelemetryLoading(firstNonEmpty(context.assetName, context.cellId, 'selected asset'));

            if (!siteId) {
                renderTelemetryRows(fallbackRows, 'Select a Site before opening live values. Showing saved SIP-cell attributes only.');
                return;
            }

            $.ajax({
                url: '/Sip/GetAllAssetWithAttribute',
                type: 'Post',
                data: '{stencilType:' + JSON.stringify(stencilType || '') + ',siteId:' + siteId + '}',
                contentType: 'application/json',
                success: function (data) {
                    var assets = normalizeAssetList(data);
                    var asset = findMatchingAsset(assets, context);
                    var rows = asset ? extractAttributeRows(asset) : [];

                    if (asset) {
                        applyLiveAssetHeader(asset, context);
                    }

                    if (!rows.length && fallbackRows.length) {
                        renderTelemetryRows(fallbackRows, 'Live source did not return attributes for this asset. Showing saved SIP-cell attributes.');
                    } else if (!rows.length) {
                        renderTelemetryRows([], 'No live attributes were returned for ' + firstNonEmpty(context.assetName, context.cellId, 'the selected asset') + '.');
                    } else {
                        renderTelemetryRows(rows, '');
                    }
                },
                error: function () {
                    if (fallbackRows.length) {
                        renderTelemetryRows(fallbackRows, 'Could not reach the live attribute endpoint. Showing saved SIP-cell attributes.');
                    } else {
                        renderTelemetryRows([], 'Could not load live attributes from /Sip/GetAllAssetWithAttribute.');
                    }
                }
            });
        }

        function normalizeAssetList(data) {
            if (Array.isArray(data)) return data;
            if (!data || typeof data !== 'object') return [];
            var keys = ['Data', 'data', 'Result', 'result', 'Assets', 'assets', 'AssetList', 'assetList', 'Items', 'items'];
            for (var i = 0; i < keys.length; i++) {
                if (Array.isArray(data[keys[i]])) return data[keys[i]];
            }
            return [data];
        }

        function findMatchingAsset(assets, context) {
            if (!assets || !assets.length) return null;
            var targetId = normalizeIdentifier(firstNonEmpty(context.assetId, context.cellId));
            var targetName = normalizeText(context.assetName);

            if (targetId) {
                for (var i = 0; i < assets.length; i++) {
                    var id = normalizeIdentifier(firstNonEmpty(assets[i].Id, assets[i].id, assets[i].AssetId, assets[i].assetId, assets[i].AssetID, assets[i].assetID));
                    if (id && id === targetId) return assets[i];
                }
            }

            if (targetName) {
                for (var j = 0; j < assets.length; j++) {
                    var name = normalizeText(firstNonEmpty(assets[j].Name, assets[j].name, assets[j].AssetName, assets[j].assetName, assets[j].TagName, assets[j].tagName));
                    if (name && name === targetName) return assets[j];
                }
            }

            if (!targetName && !targetId && assets.length === 1) return assets[0];
            return null;
        }

        function applyLiveAssetHeader(asset, context) {
            var liveName = firstNonEmpty(asset.Name, asset.name, asset.AssetName, asset.assetName, asset.TagName, asset.tagName, context.assetName, context.cellId, 'Selected Asset');
            var liveType = firstNonEmpty(asset.StencilType, asset.stencilType, asset.Type, asset.type, context.stencilType, context.type, '—');
            var liveLocation = firstNonEmpty(
                asset.Location, asset.location,
                joinNonEmpty([asset.ZoneName || asset.zoneName, asset.DivisionName || asset.divisionName, asset.SiteName || asset.siteName], ' · '),
                context.location,
                getSelectedSitePath()
            );

            setText('sipAssetPopupAssetName', liveName);
            setText('sipAssetPopupAssetLocation', liveLocation || '—');
            setText('sipAssetTelemetryTitle', 'Live Telemetry — ' + liveName);
            setText('sipAssetFooterType', 'Type: ' + liveType);
            setText('sipAssetMaintSub', 'Put ' + liveName + ' into maintenance mode to suppress alerts during scheduled work.');
            setHtml('sipAssetAlarmBannerText', escapeHtml(liveName) + ' alarm summary<span>Live alarm binding can be connected to your alarm endpoint.</span>');
        }

        function extractAttributeRows(source) {
            if (!source) return [];
            var rows = [];
            var containers = [
                source.Attributes, source.attributes,
                source.AssetAttributes, source.assetAttributes,
                source.AttributeValues, source.attributeValues,
                source.LiveValues, source.liveValues,
                source.LiveAttributes, source.liveAttributes,
                source.Parameters, source.parameters,
                source.Tags, source.tags,
                source.Telemetry, source.telemetry,
                source.DataValues, source.dataValues,
                source.Data, source.data
            ];

            containers.forEach(function (container) {
                rows = rows.concat(rowsFromContainer(container));
            });

            if (!rows.length && typeof source === 'object') {
                rows = rows.concat(rowsFromDirectScalarFields(source));
            }

            return normalizeRows(rows);
        }

        function rowsFromContainer(container) {
            var rows = [];
            if (!container) return rows;

            if (Array.isArray(container)) {
                container.forEach(function (item) {
                    var row = rowFromAttributeObject(item);
                    if (row) rows.push(row);
                });
                return rows;
            }

            if (typeof container === 'object') {
                Object.keys(container).forEach(function (key) {
                    var value = container[key];
                    if (Array.isArray(value)) {
                        value.forEach(function (item) {
                            var row = rowFromAttributeObject(item);
                            if (row) rows.push(row);
                        });
                    } else if (value && typeof value === 'object') {
                        var nestedRow = rowFromAttributeObject(value, key);
                        if (nestedRow) rows.push(nestedRow);
                    } else if (!isMetaKey(key)) {
                        rows.push({ label: key, value: value, unit: '' });
                    }
                });
            }
            return rows;
        }

        function rowFromAttributeObject(item, fallbackLabel) {
            if (item == null) return null;
            if (typeof item !== 'object') {
                return fallbackLabel ? { label: fallbackLabel, value: item, unit: '' } : null;
            }

            var label = firstNonEmpty(
                item.Name, item.name,
                item.AttributeName, item.attributeName,
                item.DisplayName, item.displayName,
                item.ParameterName, item.parameterName,
                item.ParamName, item.paramName,
                item.TagName, item.tagName,
                item.ChannelName, item.channelName,
                item.Key, item.key,
                item.Code, item.code,
                item.Label, item.label,
                fallbackLabel
            );

            var value = firstDefined(
                item.LiveValue, item.liveValue,
                item.CurrentValue, item.currentValue,
                item.Value, item.value,
                item.AttributeValue, item.attributeValue,
                item.Reading, item.reading,
                item.Status, item.status,
                item.State, item.state,
                item.DataValue, item.dataValue,
                item.AnalogValue, item.analogValue,
                item.DigitalValue, item.digitalValue,
                item.LastValue, item.lastValue
            );

            if (!label) {
                var scalarKeys = Object.keys(item).filter(function (k) { return !isMetaKey(k) && isScalar(item[k]); });
                if (scalarKeys.length === 1) {
                    label = scalarKeys[0];
                    value = item[scalarKeys[0]];
                }
            }

            if (!label) return null;

            var unit = firstNonEmpty(item.Unit, item.unit, item.UOM, item.uom, item.UnitName, item.unitName, item.MeasurementUnit, item.measurementUnit);
            var updatedAt = firstNonEmpty(item.UpdatedAt, item.updatedAt, item.LastUpdated, item.lastUpdated, item.Timestamp, item.timestamp, item.TimeStamp, item.timeStamp);
            return { label: cleanString(label), value: value, unit: cleanString(unit), updatedAt: updatedAt };
        }

        function rowsFromDirectScalarFields(source) {
            var rows = [];
            Object.keys(source).forEach(function (key) {
                if (isMetaKey(key)) return;
                var value = source[key];
                if (isScalar(value)) rows.push({ label: key, value: value, unit: '' });
            });
            return rows;
        }

        function normalizeRows(rows) {
            var out = [];
            var seen = {};
            (rows || []).forEach(function (row) {
                if (!row || !cleanString(row.label)) return;
                var key = normalizeText(row.label);
                if (!key || seen[key]) return;
                seen[key] = true;
                out.push({
                    label: cleanString(row.label),
                    value: row.value,
                    unit: cleanString(row.unit),
                    updatedAt: row.updatedAt
                });
            });
            return out;
        }

        function renderTelemetryLoading(assetName) {
            var grid = document.getElementById('sipAssetTelemetryGrid');
            if (!grid) return;
            grid.innerHTML = '<div class="sap-empty-state">Loading live attributes for ' + escapeHtml(assetName) + '...</div>';
        }

        function renderTelemetryRows(rows, message) {
            var grid = document.getElementById('sipAssetTelemetryGrid');
            if (!grid) return;
            rows = normalizeRows(rows);
            state.currentLiveRows = rows;
            setText('sipAssetLastSync', 'Last sync: ' + formatTime(new Date()));
            updateGraphParameterOptions(rows);

            if (!rows.length) {
                grid.innerHTML = '<div class="sap-empty-state">' + escapeHtml(message || 'No attributes available for this asset.') + '</div>';
                drawAssetChart();
                return;
            }

            var midpoint = Math.ceil(rows.length / 2);
            var left = rows.slice(0, midpoint).map(renderTelemetryRow).join('');
            var right = rows.slice(midpoint).map(renderTelemetryRow).join('');
            var note = message ? '<div class="sap-empty-state" style="grid-column:1/-1;padding:10px 20px;justify-content:flex-start;text-align:left;border-bottom:1px solid rgba(30,42,69,.5);">' + escapeHtml(message) + '</div>' : '';
            grid.innerHTML = note + '<div class="sap-telemetry-col">' + left + '</div><div class="sap-telemetry-col">' + right + '</div>';
            drawAssetChart();
        }

        function renderTelemetryRow(row) {
            var displayValue = formatAttributeValue(row.value, row.unit);
            var cls = valueClass(row.label, row.value);
            return '<div class="sap-telem-row"><span class="sap-telem-label" title="' + escapeHtml(row.label) + '">' + escapeHtml(row.label) + '</span><span class="sap-telem-value ' + cls + '">' + escapeHtml(displayValue) + '</span></div>';
        }

        function updateGraphParameterOptions(rows) {
            var select = document.getElementById('sipAssetParamSelect');
            if (!select) return;
            var current = select.value;
            if (!rows || !rows.length) {
                select.innerHTML = '<option>Live Value</option>';
                return;
            }
            select.innerHTML = rows.map(function (row) {
                return '<option value="' + escapeHtml(row.label) + '">' + escapeHtml(row.label) + '</option>';
            }).join('');
            if (rows.some(function (r) { return r.label === current; })) select.value = current;
        }

        function drawAssetChart() {
            var canvas = document.getElementById('sipAssetChartCanvas');
            if (!canvas) return;
            var parent = canvas.parentElement;
            var rect = parent.getBoundingClientRect();
            if (!rect.width || !rect.height) return;

            var ctx = canvas.getContext('2d');
            var dpr = window.devicePixelRatio || 1;
            canvas.width = rect.width * dpr;
            canvas.height = rect.height * dpr;
            canvas.style.width = rect.width + 'px';
            canvas.style.height = rect.height + 'px';
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

            var W = rect.width, H = rect.height;
            var pad = { top: 24, right: 20, bottom: 36, left: 52 };
            var gw = W - pad.left - pad.right;
            var gh = H - pad.top - pad.bottom;
            ctx.clearRect(0, 0, W, H);

            var selected = document.getElementById('sipAssetParamSelect') ? document.getElementById('sipAssetParamSelect').value : '';
            var row = (state.currentLiveRows || []).filter(function (r) { return r.label === selected; })[0] || state.currentLiveRows[0];
            var baseValue = parseNumeric(row ? row.value : 100);
            if (!isFinite(baseValue)) baseValue = 100;
            if (baseValue === 0) baseValue = 1;

            var pts = 96;
            var data = [];
            for (var i = 0; i < pts; i++) {
                data.push(baseValue + (Math.sin(i * 0.15) * Math.abs(baseValue) * 0.04) + ((Math.random() - 0.5) * Math.abs(baseValue) * 0.02));
            }
            var minV = Math.min.apply(null, data) - Math.abs(baseValue) * 0.02;
            var maxV = Math.max.apply(null, data) + Math.abs(baseValue) * 0.02;
            if (minV === maxV) { minV -= 1; maxV += 1; }

            ctx.strokeStyle = 'rgba(30,42,69,0.6)';
            ctx.lineWidth = 1;
            for (var g = 0; g <= 4; g++) {
                var y = pad.top + (gh / 4) * g;
                ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + gw, y); ctx.stroke();
                ctx.fillStyle = '#5a6a8a'; ctx.font = '10px JetBrains Mono'; ctx.textAlign = 'right';
                ctx.fillText((maxV - (maxV - minV) * (g / 4)).toFixed(1), pad.left - 8, y + 3);
            }

            var hours = ['00:00', '04:00', '08:00', '12:00', '16:00', '20:00', '24:00'];
            ctx.fillStyle = '#5a6a8a'; ctx.font = '10px JetBrains Mono'; ctx.textAlign = 'center';
            hours.forEach(function (h, idx) { var x = pad.left + (gw / 6) * idx; ctx.fillText(h, x, H - pad.bottom + 18); });

            var grad = ctx.createLinearGradient(0, pad.top, 0, pad.top + gh);
            grad.addColorStop(0, 'rgba(0,212,255,0.12)');
            grad.addColorStop(1, 'rgba(0,212,255,0)');
            ctx.beginPath();
            data.forEach(function (v, idx) {
                var x = pad.left + (gw / (pts - 1)) * idx;
                var y = pad.top + gh - ((v - minV) / (maxV - minV)) * gh;
                idx === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
            });
            ctx.lineTo(pad.left + gw, pad.top + gh); ctx.lineTo(pad.left, pad.top + gh); ctx.closePath(); ctx.fillStyle = grad; ctx.fill();

            ctx.beginPath();
            data.forEach(function (v, idx) {
                var x = pad.left + (gw / (pts - 1)) * idx;
                var y = pad.top + gh - ((v - minV) / (maxV - minV)) * gh;
                idx === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
            });
            ctx.strokeStyle = '#00d4ff'; ctx.lineWidth = 2; ctx.stroke();

            var lx = pad.left + gw;
            var ly = pad.top + gh - ((data[pts - 1] - minV) / (maxV - minV)) * gh;
            ctx.beginPath(); ctx.arc(lx, ly, 4, 0, Math.PI * 2); ctx.fillStyle = '#00d4ff'; ctx.fill();
        }

        function exportCurrentLiveRows() {
            var context = state.currentContext || {};
            var name = firstNonEmpty(context.assetName, context.cellId, 'asset');
            var rows = state.currentLiveRows || [];
            if (!rows.length) {
                if (typeof CommonNotification === 'function') CommonNotification('warning', 'No live rows available to export.', 'No data');
                return;
            }
            var csv = 'Attribute,Value,Updated At\n' + rows.map(function (row) {
                return [row.label, formatAttributeValue(row.value, row.unit), row.updatedAt || ''].map(csvEscape).join(',');
            }).join('\n');
            var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = name.replace(/[^a-z0-9_-]+/gi, '_') + '_live_attributes.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        function csvEscape(value) {
            value = cleanString(value);
            if (/[",\n]/.test(value)) return '"' + value.replace(/"/g, '""') + '"';
            return value;
        }

        function isMetaKey(key) {
            var k = normalizeKey(key);
            return !!{
                id: 1, assetid: 1, assetmasterid: 1, siteid: 1, stationid: 1, divisionid: 1, zoneid: 1,
                name: 1, assetname: 1, tagname: 1, type: 1, stenciltype: 1, cellid: 1, modelid: 1,
                location: 1, zonename: 1, divisionname: 1, sitename: 1,
                createdat: 1, updatedat: 1, modifiedat: 1, createdby: 1, modifiedby: 1,
                attributes: 1, assetattributes: 1, attributevalues: 1, livevalues: 1, liveattributes: 1,
                parameters: 1, tags: 1, telemetry: 1, data: 1, datavalues: 1
            }[k];
        }

        function deepFindValue(obj, wantedKeys, maxDepth) {
            if (!obj || maxDepth < 0) return '';
            var wanted = {};
            wantedKeys.forEach(function (k) { wanted[normalizeKey(k)] = true; });
            var visited = [];

            function walk(value, depth) {
                if (!value || typeof value !== 'object' || depth > maxDepth) return '';
                if (visited.indexOf(value) >= 0) return '';
                visited.push(value);
                for (var key in value) {
                    if (!Object.prototype.hasOwnProperty.call(value, key)) continue;
                    if (wanted[normalizeKey(key)] && isScalar(value[key])) return cleanString(value[key]);
                }
                for (var key2 in value) {
                    if (!Object.prototype.hasOwnProperty.call(value, key2)) continue;
                    var found = walk(value[key2], depth + 1);
                    if (found) return found;
                }
                return '';
            }
            return walk(obj, 0);
        }

        function valueClass(label, value) {
            var combined = normalizeText(label + ' ' + cleanString(value));
            if (/fail|failed|alarm|critical|danger|fault|down|bad/.test(combined)) return 'sap-value-danger';
            if (/warn|warning|low|high|under|over/.test(combined)) return 'sap-value-warn';
            if (/health|status|state/.test(normalizeText(label)) && /ok|healthy|normal|active|up/.test(normalizeText(value))) return 'sap-value-ok';
            return '';
        }

        function formatAttributeValue(value, unit) {
            if (value === null || value === undefined || value === '') return '—';
            if (typeof value === 'boolean') return value ? 'True' : 'False';
            if (typeof value === 'object') {
                try { value = JSON.stringify(value); } catch (e) { value = String(value); }
            }
            var text = cleanString(value);
            return unit ? (text + ' ' + unit) : text;
        }

        function firstDefined() {
            for (var i = 0; i < arguments.length; i++) {
                if (arguments[i] !== undefined && arguments[i] !== null && arguments[i] !== '') return arguments[i];
            }
            return '';
        }

        function firstNonEmpty() {
            for (var i = 0; i < arguments.length; i++) {
                var v = cleanString(arguments[i]);
                if (v) return v;
            }
            return '';
        }

        function cleanString(value) {
            if (value === null || value === undefined) return '';
            return String(value).replace(/\s+/g, ' ').trim();
        }

        function normalizeKey(value) {
            return cleanString(value).toLowerCase().replace(/[^a-z0-9]/g, '');
        }

        function normalizeText(value) {
            return cleanString(value).toLowerCase().replace(/\s+/g, ' ');
        }

        function normalizeIdentifier(value) {
            return cleanString(value).toLowerCase();
        }

        function uniqueStrings(list) {
            var seen = {};
            var out = [];
            (list || []).forEach(function (v) {
                v = cleanString(v);
                if (!v || seen[v]) return;
                seen[v] = true;
                out.push(v);
            });
            return out;
        }

        function isScalar(value) {
            return value === null || ['string', 'number', 'boolean'].indexOf(typeof value) >= 0;
        }

        function parseNumeric(value) {
            if (typeof value === 'number') return value;
            var m = cleanString(value).replace(/,/g, '').match(/-?\d+(\.\d+)?/);
            return m ? parseFloat(m[0]) : NaN;
        }

        function escapeHtml(value) {
            return cleanString(value).replace(/[&<>'"]/g, function (ch) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[ch];
            });
        }

        function setText(id, text) {
            var el = document.getElementById(id);
            if (el) el.textContent = text;
        }

        function setHtml(id, html) {
            var el = document.getElementById(id);
            if (el) el.innerHTML = html;
        }

        function joinNonEmpty(items, sep) {
            return (items || []).map(cleanString).filter(Boolean).join(sep || ' ');
        }

        function getSelectedSitePath() {
            var zone = $('#zone-select option:selected').text();
            var division = $('#division-select option:selected').text();
            var site = $('#site-select option:selected').text();
            var items = [zone, division, site].filter(function (x) { x = cleanString(x); return x && x.indexOf('—') < 0; });
            return items.join(' · ');
        }

        function formatTime(date) {
            function pad(n) { return n < 10 ? '0' + n : '' + n; }
            return pad(date.getHours()) + ':' + pad(date.getMinutes()) + ':' + pad(date.getSeconds());
        }

        function toDateInput(date) {
            function pad(n) { return n < 10 ? '0' + n : '' + n; }
            return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate());
        }

        function toDateTimeInput(date) {
            function pad(n) { return n < 10 ? '0' + n : '' + n; }
            return date.getFullYear() + '-' + pad(date.getMonth() + 1) + '-' + pad(date.getDate()) + 'T' + pad(date.getHours()) + ':' + pad(date.getMinutes());
        }
    })();


    (function () {
        'use strict';

        function getSipCells() {
            try {
                if (window.SipEditor && typeof window.SipEditor.getLayout === 'function') {
                    var editorLayout = window.SipEditor.getLayout();
                    if (editorLayout && Array.isArray(editorLayout.cells)) {
                        return editorLayout.cells;
                    }
                }

                if (window.currentSipLayout && Array.isArray(window.currentSipLayout.cells)) {
                    return window.currentSipLayout.cells;
                }

                if (window.sipLayout && Array.isArray(window.sipLayout.cells)) {
                    return window.sipLayout.cells;
                }

                if (window.SipLayout && Array.isArray(window.SipLayout.cells)) {
                    return window.SipLayout.cells;
                }
            } catch (e) {
                console.warn('Unable to read SIP cells:', e);
            }

            return [];
        }

        function getTextFromAssetGroup(assetGroup) {
            if (!assetGroup) return '';

            var textNodes = assetGroup.querySelectorAll('text');
            var parts = [];

            textNodes.forEach(function (node) {
                var text = (node.textContent || '').trim();
                if (text) parts.push(text);
            });

            return parts.join(' ').trim();
        }

        function buildCellFromClickedAsset(assetGroup) {
            var id =
                assetGroup.getAttribute('data-eid') ||
                assetGroup.getAttribute('data-id') ||
                '';

            var type =
                assetGroup.getAttribute('data-type') ||
                '';

            var cells = getSipCells();

            var matchedCell = cells.find(function (cell) {
                return String(cell.id) === String(id);
            });

            if (matchedCell) {
                return matchedCell;
            }

            // Fallback for SIP View where only SVG metadata is available
            return {
                id: id,
                type: type,
                attrs: {
                    label: {
                        text: getTextFromAssetGroup(assetGroup)
                    }
                }
            };
        }

        function findClickedSipAsset(target) {
            if (!target || typeof target.closest !== 'function') {
                return null;
            }

            // Editor mode: .editable[data-eid]
            // View mode:   .sip-asset[data-id]
            return target.closest('g.editable[data-eid], g.sip-asset[data-id]');
        }

        var pointerDownInfo = null;

        document.addEventListener('pointerdown', function (evt) {
            var assetGroup = findClickedSipAsset(evt.target);

            if (!assetGroup) {
                pointerDownInfo = null;
                return;
            }

            pointerDownInfo = {
                x: evt.clientX,
                y: evt.clientY,
                id: assetGroup.getAttribute('data-eid') || assetGroup.getAttribute('data-id'),
                group: assetGroup
            };
        }, true);

        document.addEventListener('pointerup', function (evt) {
            if (!pointerDownInfo) return;

            var assetGroup = findClickedSipAsset(evt.target) || pointerDownInfo.group;

            if (!assetGroup) {
                pointerDownInfo = null;
                return;
            }

            var upId =
                assetGroup.getAttribute('data-eid') ||
                assetGroup.getAttribute('data-id');

            var moved =
                Math.abs(evt.clientX - pointerDownInfo.x) > 5 ||
                Math.abs(evt.clientY - pointerDownInfo.y) > 5;

            var sameAsset = String(upId) === String(pointerDownInfo.id);

            pointerDownInfo = null;

            if (moved || !sameAsset) {
                return;
            }

            evt.preventDefault();
            evt.stopPropagation();

            var cell = buildCellFromClickedAsset(assetGroup);

            console.log('SIP asset clicked:', cell);

            if (typeof window.OpenSipAssetPopupFromCell === 'function') {
                window.OpenSipAssetPopupFromCell(cell, {
                    event: evt,
                    source: 'sip-view-click'
                });
            } else {
                console.error('OpenSipAssetPopupFromCell is not defined.');
            }
        }, true);
    })();

    let previousFocus = null;

    function openAssetDetailPopup(asset) {
        currentPopupAsset = asset;
        const overlay = document.getElementById('sipAssetPopupOverlay');
        const popup = document.getElementById('sipAssetPopup');

        // Update content
        document.getElementById('popupAssetName').innerText = asset.name || asset.label || 'Asset';
        document.getElementById('popupAssetLocation').innerText = asset.location || `${asset.type || 'Asset'} · ${asset.siteId || '—'}`;
        document.getElementById('popupAssetId').innerText = asset.id || '—';
        document.getElementById('liveAssetName').innerText = asset.name || asset.label || 'Asset';

        // Show modal
        overlay.style.display = 'flex';
        overlay.removeAttribute('aria-hidden');          // ✅ remove aria-hidden
        popup.classList.add('sip-popup-visible');        // optional class for styling

        // Hide main content from screen readers (accessibility)
        document.querySelector('.at-page-header')?.setAttribute('aria-hidden', 'true');
        document.querySelector('.at-table-card')?.setAttribute('aria-hidden', 'true');
        document.querySelector('#sipCardSection')?.setAttribute('aria-hidden', 'true');

        // Store previously focused element
        previousFocus = document.activeElement;

        // Move focus to close button
        const closeBtn = document.getElementById('sipAssetPopupClose');
        if (closeBtn) closeBtn.focus();

        loadAssetLiveAttributesForPopup(asset);
        initPopupTabs();
    }

    function closeAssetDetailPopup() {
        const overlay = document.getElementById('sipAssetPopupOverlay');
        if (!overlay) return;

        overlay.style.display = 'none';
        overlay.setAttribute('aria-hidden', 'true');     // ✅ restore aria-hidden

        // Restore accessibility for main content
        document.querySelector('.at-page-header')?.removeAttribute('aria-hidden');
        document.querySelector('.at-table-card')?.removeAttribute('aria-hidden');
        document.querySelector('#sipCardSection')?.removeAttribute('aria-hidden');

        // Restore focus
        if (previousFocus && previousFocus.focus) {
            previousFocus.focus();
        }
        currentPopupAsset = null;
    }

</script>


