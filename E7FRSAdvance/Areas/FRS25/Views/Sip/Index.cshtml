<script>
    (function () {
        "use strict";

        function esc(v) {
            return String(v == null ? "" : v)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        function getCellLabel(cell) {
            return cell &&
                cell.attrs &&
                cell.attrs.label &&
                cell.attrs.label.text
                ? String(cell.attrs.label.text).trim()
                : "";
        }

        function getAssetName(cell, detail) {
            return (detail && detail.assetName)
                || getCellLabel(cell)
                || (cell && cell.id)
                || "Selected Asset";
        }

        function getAssetType(cell, detail) {
            return (detail && detail.cellType)
                || (cell && cell.type)
                || "";
        }

        function getLiveValues(assetName, detail) {
            if (detail && detail.liveValues && Object.keys(detail.liveValues).length > 0) {
                return detail.liveValues;
            }

            if (window.SipTelemetry &&
                window.SipTelemetry._state &&
                window.SipTelemetry._state.assetValues &&
                window.SipTelemetry._state.assetValues[assetName]) {
                return window.SipTelemetry._state.assetValues[assetName];
            }

            return {};
        }

        function ensurePopup() {
            var existing = document.getElementById("sipAssetPopupOverlay");
            if (existing) return existing;

            var style = document.createElement("style");
            style.id = "sipAssetPopupStyle";
            style.innerHTML =
                "#sipAssetPopupOverlay{" +
                "position:fixed;inset:0;background:rgba(5,8,18,.72);" +
                "z-index:999999;display:none;align-items:center;justify-content:center;" +
                "font-family:Arial,Helvetica,sans-serif;" +
                "}" +
                "#sipAssetPopupBox{" +
                "width:900px;max-width:96vw;max-height:80vh;background:#0f172a;" +
                "border:1px solid #334155;border-radius:12px;overflow:hidden;" +
                "box-shadow:0 20px 60px rgba(0,0,0,.45);color:#e2e8f0;" +
                "}" +
                "#sipAssetPopupHead{" +
                "padding:14px 18px;background:#111827;border-bottom:1px solid #334155;" +
                "display:flex;align-items:center;justify-content:space-between;" +
                "}" +
                "#sipAssetPopupTitle{font-size:17px;font-weight:700;color:#fff;}" +
                "#sipAssetPopupSub{font-size:12px;color:#94a3b8;margin-top:3px;}" +
                "#sipAssetPopupClose{" +
                "border:1px solid #475569;background:#1e293b;color:#cbd5e1;" +
                "width:32px;height:32px;border-radius:6px;cursor:pointer;font-size:18px;" +
                "}" +
                "#sipAssetPopupTabs{display:flex;background:#020617;border-bottom:1px solid #334155;}" +
                ".sip-popup-tab{padding:11px 16px;color:#94a3b8;font-size:13px;border:none;background:transparent;cursor:pointer;}" +
                ".sip-popup-tab.active{color:#22d3ee;border-bottom:2px solid #22d3ee;}" +
                "#sipAssetPopupBody{padding:16px;overflow:auto;max-height:58vh;}" +
                ".sip-attr-table{width:100%;border-collapse:collapse;}" +
                ".sip-attr-table th{" +
                "text-align:left;font-size:12px;color:#94a3b8;text-transform:uppercase;" +
                "padding:10px;border-bottom:1px solid #334155;" +
                "}" +
                ".sip-attr-table td{" +
                "padding:10px;border-bottom:1px solid rgba(51,65,85,.6);" +
                "font-size:13px;color:#e2e8f0;" +
                "}" +
                ".sip-attr-table td.value{font-family:Consolas,monospace;color:#86efac;}" +
                ".sip-empty{padding:30px;text-align:center;color:#94a3b8;border:1px dashed #334155;border-radius:8px;}";
            document.head.appendChild(style);

            var overlay = document.createElement("div");
            overlay.id = "sipAssetPopupOverlay";
            overlay.innerHTML =
                '<div id="sipAssetPopupBox">' +
                '<div id="sipAssetPopupHead">' +
                '<div>' +
                '<div id="sipAssetPopupTitle">Selected Asset</div>' +
                '<div id="sipAssetPopupSub">Live Attributes</div>' +
                '</div>' +
                '<button id="sipAssetPopupClose" type="button">×</button>' +
                '</div>' +
                '<div id="sipAssetPopupTabs">' +
                '<button type="button" class="sip-popup-tab active" data-tab="live">Live Values</button>' +
                '<button type="button" class="sip-popup-tab" data-tab="info">Asset Info</button>' +
                '</div>' +
                '<div id="sipAssetPopupBody"></div>' +
                '</div>';

            document.body.appendChild(overlay);

            document.getElementById("sipAssetPopupClose").onclick = function () {
                overlay.style.display = "none";
            };

            overlay.addEventListener("click", function (e) {
                if (e.target === overlay) {
                    overlay.style.display = "none";
                }
            });

            return overlay;
        }

        function renderLiveValues(values) {
            var keys = Object.keys(values || {});

            if (!keys.length) {
                return '<div class="sip-empty">No live attribute values received for this asset yet.</div>';
            }

            keys.sort();

            var html = '<table class="sip-attr-table">' +
                '<thead><tr><th>Attribute</th><th>Live Value</th></tr></thead><tbody>';

            keys.forEach(function (key) {
                html += '<tr>' +
                    '<td>' + esc(key) + '</td>' +
                    '<td class="value">' + esc(values[key]) + '</td>' +
                    '</tr>';
            });

            html += '</tbody></table>';
            return html;
        }

        function renderAssetInfo(cell, detail, assetName, assetType) {
            return '<table class="sip-attr-table">' +
                '<tbody>' +
                '<tr><td>Asset Name</td><td class="value">' + esc(assetName) + '</td></tr>' +
                '<tr><td>Cell Id</td><td class="value">' + esc(cell && cell.id) + '</td></tr>' +
                '<tr><td>Cell Type</td><td class="value">' + esc(assetType) + '</td></tr>' +
                '<tr><td>Site Id</td><td class="value">' + esc(detail && detail.siteId) + '</td></tr>' +
                '<tr><td>Source</td><td class="value">' + esc(detail && detail.source) + '</td></tr>' +
                '</tbody>' +
                '</table>';
        }

        window.OpenSipAssetPopupFromCell = function (cell, detail) {
            var overlay = ensurePopup();

            var assetName = getAssetName(cell, detail || {});
            var assetType = getAssetType(cell, detail || {});
            var liveValues = getLiveValues(assetName, detail || {});

            document.getElementById("sipAssetPopupTitle").textContent = assetName;
            document.getElementById("sipAssetPopupSub").textContent = assetType || "Live Attributes";

            var body = document.getElementById("sipAssetPopupBody");
            body.innerHTML = renderLiveValues(liveValues);

            var tabs = overlay.querySelectorAll(".sip-popup-tab");
            tabs.forEach(function (tab) {
                tab.onclick = function () {
                    tabs.forEach(function (t) { t.classList.remove("active"); });
                    tab.classList.add("active");

                    if (tab.getAttribute("data-tab") === "live") {
                        body.innerHTML = renderLiveValues(getLiveValues(assetName, detail || {}));
                    } else {
                        body.innerHTML = renderAssetInfo(cell, detail || {}, assetName, assetType);
                    }
                };
            });

            overlay.style.display = "flex";

            console.log("[sip-popup] popup opened", {
                assetName: assetName,
                assetType: assetType,
                liveValues: liveValues,
                cell: cell,
                detail: detail
            });
        };

        console.log("[sip-popup] window.OpenSipAssetPopupFromCell registered");
    })();
</script>
<div class="container-fluid">

    @{
        var advSip = ViewBag.AdvSipView as Domain.AdvancedSIPView ?? new Domain.AdvancedSIPView();
    }

    <input type="hidden" id="hdnId" value="@(advSip.Id)" />
    <input type="hidden" id="hdnSiteId" value="@(advSip.SiteId)" />
    <input type="hidden" id="hdnSipViewData" value="@(advSip.SipView)" />

    <div class="sip-app" style="height: 800px;">
        <div class="app">

            <header class="topbar">
                <div class="brand">SIP <span class="accent">/</span> YARD EDITOR</div>
                <div class="actions">
                    <button class="tb primary" onclick="SaveSipView()" id="save">Save</button>
                    <span class="sip-status" id="sipStatus"></span>
                    <span class="sep"></span>
                    <button class="tb" onclick="SipEditor.loadPreset('blank')">New</button>
                    <button class="tb" onclick="SipEditor.loadPreset('sample')">Load Sample</button>
                    <span class="sep"></span>
                    <button class="tb" id="undo-btn" onclick="SipEditor.undo()">Undo</button>
                    <button class="tb" id="redo-btn" onclick="SipEditor.redo()">Redo</button>
                    <button class="tb" onclick="SipEditor.fitAll()">Fit All</button>
                    <span class="sep"></span>
                    <button class="tb" onclick="SipEditor.openImport()">Import</button>
                    <button class="tb" onclick="SipEditor.exportLayoutJs()">Export .js</button>
                    <button class="tb" onclick="SipEditor.exportSvg()">Export .svg</button>
                    <span class="sep"></span>
                    <button class="tb" id="fullscreen-btn" onclick="SipEditor.toggleFullscreen()">Fullscreen</button>
                </div>
            </header>

            @* ---------------------------------------------------------------
                Site filter — Zone → Division → Site cascade. Drives which
                site the editor reads / writes against.  Changing the site
                triggers GetSipView() so the canvas updates in-place.
                Zones are rendered server-side from ViewBag.Zones;
                Divisions and Sites load via /Sip/GetDivisionByZoneId and
                /Sip/GetSiteByDivisionId on cascade.
                ---------------------------------------------------------------*@
            <div class="filterbar"
                 style="display:flex; gap:12px; align-items:flex-end;
                        padding:10px 14px;
                        background:rgba(127,197,255,0.04);
                        border-bottom:1px solid var(--line);">
                <div class="field" style="margin:0; flex:1; max-width:220px;">
                    <label>Zone</label>
                    @Html.DropDownList("ZoneId",
                                            (SelectList)ViewBag.Zones,
                                            "— select zone —",
                                            new { id = "zone-select" })
                </div>
                <div class="field" style="margin:0; flex:1; max-width:220px;">
                    <label>Division</label>
                    <select id="division-select" disabled><option value="">— select division —</option></select>
                </div>
                <div class="field" style="margin:0; flex:1; max-width:240px;">
                    <label>Site</label>
                    <select id="site-select" disabled><option value="">— select site —</option></select>
                </div>
                <div style="flex:1"></div>
                <div style="padding-bottom:6px; font-size:11px; color:var(--muted); font-family:'JetBrains Mono', ui-monospace, monospace;">
                    Active site:&nbsp;<span id="site-id-readout" style="color:var(--accent);">@(advSip.SiteId > 0 ? advSip.SiteId.ToString() : "—")</span>
                </div>
            </div>

            <div class="workspace">

                <aside class="toolbox">
                    <div class="toolbox-grid" id="toolbox-grid"></div>

                    <h3>Grid</h3>
                    <label class="checkbox-row">
                        <input type="checkbox" id="snap-toggle" checked />
                        Snap to grid
                    </label>
                    <div class="field">
                        <label>Snap size (units)</label>
                        <input type="number" id="snap-size" value="10" min="1" max="100" />
                    </div>

                    <h3>Canvas</h3>
                    <div class="field">
                        <label>ViewBox</label>
                        <input type="text" id="viewbox-input" value="0 0 2000 740" />
                    </div>

                    <div class="toolbox-info">
                        <span class="kbd">Click</span> select &nbsp;·&nbsp;
                        <span class="kbd">Drag</span> move<br />
                        <span class="kbd">Del</span> remove &nbsp;·&nbsp;
                        <span class="kbd">Esc</span> deselect<br />
                        <span class="kbd">Ctrl+Z</span> undo &nbsp;·&nbsp;
                        <span class="kbd">Ctrl+Y</span> redo<br />
                        <span class="kbd">Ctrl+D</span> duplicate
                    </div>
                </aside>

                <main class="canvas-wrap">
                    <div class="canvas-host">
                        <div id="canvas"></div>
                    </div>
                    <div class="statusbar">
                        <span class="coords" id="cursor-coords">—</span>
                        <span class="sep">·</span>
                        <span id="element-count">0 elements</span>
                        <span class="sep">·</span>
                        <span id="selection-label">No selection</span>
                        <span class="hint">SIP-LIB v2.0 · AURORA</span>
                    </div>
                </main>

                <aside class="inspector">
                    <h3>Inspector</h3>
                    <div id="inspector-body">
                        <p class="muted">Nothing selected.<br /><br />Click an element on the canvas, or add one from the toolbox.</p>
                    </div>
                </aside>

            </div>
        </div>

        @*--- Modal (Import / Export .js / Export .svg) ---*@
        <div class="modal-backdrop" id="modal">
            <div class="modal">
                <div class="modal-head">
                    <div class="title">SIP <span class="accent">/</span> <span id="modal-title">EXPORT</span></div>
                    <button class="tb" onclick="SipEditor.closeModal()">Close</button>
                </div>
                <div class="modal-body">
                    <textarea id="modal-text" spellcheck="false"></textarea>
                </div>
                <div class="modal-foot">
                    <span class="left" id="modal-hint"></span>
                    <button class="tb" onclick="SipEditor.copyModal()">Copy</button>
                    <button class="tb" id="modal-action" onclick="SipEditor.downloadModal()">Download</button>
                </div>
            </div>
        </div>

        <div class="toast" id="toast"></div>
    </div>

</div>
