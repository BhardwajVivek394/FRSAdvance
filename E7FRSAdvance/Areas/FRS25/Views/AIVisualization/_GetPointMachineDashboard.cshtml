@model Domain.AssetLister

@if (Model.mAssets != null && Model.mAssets.Count > 0)
{
    var countClusterA = Model.mAssets.SelectMany(d => d.mPointMachineData).GroupBy(x => x.ClusterA).Select(x =>
       new
       {
           Key = x.Key,
           Count = x.Count()
       });

    var countClusterB = Model.mAssets.SelectMany(d => d.mPointMachineData).GroupBy(x => x.ClusterB).Select(x =>
       new
       {
           Key = x.Key,
           Count = x.Count()
       });

    bool isThickWave = false;
    if (Model.mAssets.Where(x => x.IsThickWave == true).Count() == Model.mAssets.Count())
    {
        isThickWave = true;
    }

    var siteId = Model.SearchCriteria != null ? Model.SearchCriteria.SiteId.ToString() : "";

    var mAssetListerTemp = TempData.Peek("tempAIVisualizationPointMachine");
    if (mAssetListerTemp != null)
    {
        var mTempAssetLister = mAssetListerTemp as Domain.AssetLister;
        if (mTempAssetLister != null && mTempAssetLister.mAssets != null)
        {
            var aStatus = new List<string>();
            var bStatus = new List<string>();
            var aCluster = new List<string>();
            var bCluster = new List<string>();
            foreach (var item in mTempAssetLister.mAssets)
            {
                if (item.mPointMachineData != null && item.mPointMachineData.Count > 0)
                {
                    aStatus.AddRange(item.mPointMachineData.Where(x => !aStatus.Contains(x.AI_status_A)).GroupBy(x => x.AI_status_A).Select(x => x.Key).ToList());
                    bStatus.AddRange(item.mPointMachineData.Where(x => !bStatus.Contains(x.AI_status_B)).GroupBy(x => x.AI_status_B).Select(x => x.Key).ToList());

                    aCluster.AddRange(item.mPointMachineData.Where(x => !aCluster.Contains(x.ClusterA)).GroupBy(x => x.ClusterA).Select(x => x.Key).ToList());
                    bCluster.AddRange(item.mPointMachineData.Where(x => !bCluster.Contains(x.ClusterB)).GroupBy(x => x.ClusterB).Select(x => x.Key).ToList());
                }
            }

            <div class="aiv-subfilter">
                <div class="d-lg-flex d-md-flex d-flex flex-md-nowrap flex-wrap alertsearchform gap-10">
                    <div class="form-group w-100 w-sm-48">
                        <label for="drpAStatus">A Status</label>
                        <select class="form-control" id="drpAStatus">
                            <option value="">Select</option>
                            @if (aStatus != null && aStatus.Count > 0)
                            {
                                foreach (var item in aStatus)
                                {
                                    <option value="@item">@item</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group w-100 w-sm-48">
                        <label for="drpBStatus">B Status</label>
                        <select class="form-control" id="drpBStatus">
                            <option value="">Select</option>
                            @if (bStatus != null && bStatus.Count > 0)
                            {
                                foreach (var item in bStatus)
                                {
                                    <option value="@item">@item</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group w-100 w-sm-48">
                        <label for="drpaCluster">Cluster A</label>
                        <select class="form-control" id="drpaCluster">
                            <option value="">Select</option>
                            @if (aCluster != null && aCluster.Count > 0)
                            {
                                foreach (var item in aCluster)
                                {
                                    var count = countClusterA.Where(x => x.Key == item).Select(x => x.Count).FirstOrDefault();
                                    <option value="@item">@item (count: @count)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group w-100 w-sm-48">
                        <label for="drpbCluster">Cluster B</label>
                        <select class="form-control" id="drpbCluster">
                            <option value="">Select</option>
                            @if (bCluster != null && bCluster.Count > 0)
                            {
                                foreach (var item in bCluster)
                                {
                                    var count = countClusterB.Where(x => x.Key == item).Select(x => x.Count).FirstOrDefault();
                                    <option value="@item">@item (count: @count)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group w-sm-48">
                        <label class="d-none d-md-block">&nbsp;</label>
                        <label class="aiv-check" for="chkIsThickWave">
                            @if (isThickWave)
                            {
                                <input type="checkbox" id="chkIsThickWave" checked />
                            }
                            else
                            {
                                <input type="checkbox" id="chkIsThickWave" />
                            }
                            Is Thick Wave
                        </label>
                    </div>
                    <div class="form-group w-sm-100">
                        <label class="d-none d-md-block">&nbsp;</label>
                        <button class="btn btn-primary-search" type="button" title="Search" onclick="fnFilterPointMachine()">
                            <img src="~/Areas/FRS25/assets/img/search.svg" alt="Search" />
                        </button>
                    </div>
                </div>
            </div>

            <div class="aiv-chipbar">
                <span class="aiv-chipbar-label">All assets graph</span>
                @if (Model.mAssets != null && Model.mAssets.Where(x => x.IsSeriesOpration != null && x.IsSeriesOpration.Value).Count() > 0)
                {
                    <a class="aiv-chip" href="javascript:;" title="Combine / Normal" onclick="fnShowMultipleGraphBySite('@siteId','CC','Normal')">C/N</a>
                    <a class="aiv-chip" href="javascript:;" title="Combine / Reverse" onclick="fnShowMultipleGraphBySite('@siteId','CC','Reverse')">C/R</a>
                    <span class="aiv-chip-sep"></span>
                }
                <a class="aiv-chip" href="javascript:;" title="A end / Normal" onclick="fnShowMultipleGraphBySite('@siteId','AC','Normal')">A/N</a>
                <a class="aiv-chip" href="javascript:;" title="A end / Reverse" onclick="fnShowMultipleGraphBySite('@siteId','AC','Reverse')">A/R</a>
                <span class="aiv-chip-sep"></span>
                <a class="aiv-chip" href="javascript:;" title="B end / Normal" onclick="fnShowMultipleGraphBySite('@siteId','BC','Normal')">B/N</a>
                <a class="aiv-chip" href="javascript:;" title="B end / Reverse" onclick="fnShowMultipleGraphBySite('@siteId','BC','Reverse')">B/R</a>
            </div>
        }
    }

    foreach (var item in Model.mAssets)
    {
        var vibration = item.assetAttributes != null ? item.assetAttributes.Where(x => x.Title != null && x.Title.Contains("Vibration")).ToList() : null;
        bool isVibration = false;
        if (vibration != null && vibration.Count > 0)
        {
            isVibration = true;
        }
        bool isFullPointMachine = item.IsHalfPointMachine == null || (item.IsHalfPointMachine != null && !item.IsHalfPointMachine.Value);

        <div class="aiv-asset">
            <div class="aiv-asset-head">
                <h6 class="aiv-asset-title">@item.AssetTypeName : @item.Name</h6>
                <span class="aiv-asset-site"><i class="fa-solid fa-location-dot"></i>Site: @item.SiteName</span>
            </div>

            <div class="aiv-asset-meta">
                <span class="aiv-badge aiv-badge-strong">@item.Name</span>
                @if (isFullPointMachine)
                {
                    <span class="aiv-badge">Direction: @(string.IsNullOrEmpty(item.AliasDirectionA) ? "A" : item.AliasDirectionA)</span>
                    <span class="aiv-badge">Direction: @(string.IsNullOrEmpty(item.AliasDirectionB) ? "B" : item.AliasDirectionB)</span>
                    if (isVibration)
                    {
                        <span class="aiv-badge">VibrationA(x/y/z)</span>
                        <span class="aiv-badge">VibrationB(x/y/z)</span>
                    }
                }
                else
                {
                    <span class="aiv-badge">Direction</span>
                }
            </div>

            <div class="aiv-asset-body">
                <div class="table-border">
                    <div class="table-responsive aiv-scroll tblAssetData">
                        <table class="table table-hover aiv-table mb-0" id="tblPoint@(item.Id)">
                            <thead class="thead-light2">
                                <tr>
                                    <th>Date</th>
                                    <th>Name</th>
                                    <th>Direction</th>
                                    @if (item.IsSeriesOpration != null && item.IsSeriesOpration.Value)
                                    {
                                        <th>Combine</th>
                                    }

                                    @if (isFullPointMachine)
                                    {
                                        <th>
                                            A Current(Max/Avg)
                                            <a class="aiv-chip aiv-chip-sm ml-1" href="javascript:;" title="Normal" onclick="fnShowMultipleGraph('@item.Id', 'Normal', 'AC');return false;">N</a>
                                            <a class="aiv-chip aiv-chip-sm" href="javascript:;" title="Reverse" onclick="fnShowMultipleGraph('@item.Id','Reverse','AC');return false;">R</a>
                                        </th>
                                        <th>A Voltage</th>
                                        <th>A Time (ms)</th>
                                        <th>A Status</th>
                                        <th>A Cluster</th>
                                    }
                                    else
                                    {
                                        <th>
                                            Current(Max/Avg)
                                            <a class="aiv-chip aiv-chip-sm ml-1" href="javascript:;" title="Normal" onclick="fnShowMultipleGraph('@item.Id', 'Normal', 'AC');return false;">N</a>
                                            <a class="aiv-chip aiv-chip-sm" href="javascript:;" title="Reverse" onclick="fnShowMultipleGraph('@item.Id','Reverse','AC');return false;">R</a>
                                        </th>
                                        <th>Voltage</th>
                                        <th>A Status</th>
                                        <th>A Cluster</th>
                                    }

                                    @if (isFullPointMachine)
                                    {
                                        <th>
                                            B Current(Max/Avg)
                                            <a class="aiv-chip aiv-chip-sm ml-1" href="javascript:;" title="Normal" onclick="fnShowMultipleGraph('@item.Id','Normal','BC');return false;">N</a>
                                            <a class="aiv-chip aiv-chip-sm" href="javascript:;" title="Reverse" onclick="fnShowMultipleGraph('@item.Id','Reverse','BC');return false;">R</a>
                                        </th>
                                        <th>B Voltage</th>
                                        <th>B Time (ms)</th>
                                        <th>B Status</th>
                                        <th>B Cluster</th>
                                    }

                                </tr>
                            </thead>
                            <tbody class="fbody@(item.Id)">
                                @Html.Partial("_PointMachineDatePartial", item)
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="aiv-empty"><i class="fa-regular fa-folder-open"></i>No record found!</div>
}

<script>
    var chart;
    function fnShowMultipleGraph(assetId, datevalue, type) {
        $('#hdnPMAssetId').val(assetId);
        var searchCriteria = {
            AssetId: assetId,
            Status_A: $('#drpAStatus').find(":selected").val(),
            Status_B: $('#drpBStatus').find(":selected").val(),
            ClusterA: $('#drpaCluster').find(":selected").val(),
            ClusterB: $('#drpbCluster').find(":selected").val(),
            Direction: datevalue,
            IsThickWave: $("#chkIsThickWave").is(":checked") ? "true" : "false"
        };

        $.ajax({
            url: '/FRS25/AIVisualization/GetSitePointMachineGraph',
            type: 'Post',
            data: '{searchCriteria:' + JSON.stringify(searchCriteria) + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                fnBindMultipleSignatureGragh(data, type, datevalue, assetId);

            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });

    }

    /* Builds one Chart.js 2.9.4 line dataset (shared by every multi-signature graph below). */
    function fnAivSignatureDataset(legends, lineColor, array) {
        return {
            label: legends,
            fill: false,
            lineTension: 0.1,
            backgroundColor: "rgba(75,192,192,0.4)",
            borderColor: lineColor,
            borderCapStyle: 'butt',
            borderDash: [],
            borderDashOffset: 0.0,
            borderJoinStyle: 'miter',
            pointBorderColor: lineColor,
            pointBackgroundColor: (typeof fnAivCss === 'function') ? fnAivCss('--e7-surface', '#fff') : '#fff',
            pointBorderWidth: 0.5,
            pointHoverRadius: 5,
            pointHoverBackgroundColor: lineColor,
            pointHoverBorderColor: (typeof fnAivCss === 'function') ? fnAivCss('--e7-border', 'rgba(220,220,220,1)') : 'rgba(220,220,220,1)',
            pointHoverBorderWidth: 1,
            pointRadius: 5,
            pointHitRadius: 10,
            data: array,
            markLine: {
                data: [{
                    type: 'average',
                    name: '???'
                }]
            }
        };
    }

    /* Collects the signature points for one record (same rules as the reference for each graph type). */
    function fnAivSignaturePoints(j, type, includeVoltage) {
        var array = [];
        if (type == "CC") {
            $.each(j.A_C, function (id, val) { array.push(val); });
            $.each(j.B_C, function (id, val) { array.push(val); });
        }
        if (type == "CV") {
            $.each(j.A_V, function (id, val) { array.push(val); });
            $.each(j.B_V, function (id, val) { array.push(val); });
        }
        if (type == "AC") {
            $.each(j.A_C, function (id, val) { array.push(val); });
        }
        if (type == "BC") {
            $.each(j.B_C, function (id, val) { array.push(val); });
        }
        if (includeVoltage) {
            if (type == "AV") {
                $.each(j.A_V, function (id, val) { array.push(val); });
            }
            if (type == "BV") {
                $.each(j.B_V, function (id, val) { array.push(val); });
            }
        }
        return array;
    }

    function fnAivDrawPointMachineChart(label, datasets) {
        if (typeof fnAivChartTheme === 'function') fnAivChartTheme();
        var pieChartContent = document.getElementById('pointmachine-mainId');
        pieChartContent.innerHTML = '&nbsp;';
        $('#pointmachine-mainId').append('<canvas id="pointmachine-basicflot" style="height: 263px"></canvas>');

        var canvas = $("#pointmachine-basicflot").get(0).getContext("2d");

        var data = {
            labels: label,
            datasets: datasets
        };

        var option = {
            showLines: true,
            legend: { display: false }
        };
        var myLineChart = Chart.Line(canvas, {
            data: data,
            options: option
        });
    }

    function fnAivClearPointMachineChart() {
        var pieChartContent = document.getElementById('pointmachine-mainId');
        pieChartContent.innerHTML = '&nbsp;';
        $('#pointmachine-mainId').append('<canvas id="pointmachine-basicflot" style="height: 263px"></canvas>');
    }

    function fnAivPushLabels(label, array) {
        for (var i = 0; i <= array.length; i++) {
            var xVal = (i) * (100);
            if (label.indexOf(xVal) == -1) {
                label.push(xVal);
            }
        }
    }

    function fnAivLegendDate(val) {
        const d = new Date(val.Date);
        return d.getDate() + "-" + (d.getMonth() + 1) + "-" + d.getFullYear() + " " + d.getHours() + ":" + d.getMinutes() + "";
    }

    function fnBindMultipleSignatureGragh(data, type, datevalue) {
        if (chart != null && chart != "" && chart != undefined) {
            chart.dispose();
        }
        $('#pointmachine-select-mainId').empty();
        var datasets = [];
        var label = [];
        var clusterA = [];
        var clusterB = [];
        var lineColor;
        if (data != null && data != undefined && data != '') {
            $(data).each(function (data, val) {
                var clusterName = '';
                if (type.includes("A")) {
                    if (clusterA.indexOf(val.ClusterA) == -1) {
                        lineColor = fnGetDarkColor();
                        $('#pointmachine-select-mainId').append("<div class='col-sm-2'><input type='checkbox' class='chkPointMachineGraphA' id='chkcluster_" + val.ClusterA + "' value='" + val.ClusterA + "' data-color='" + lineColor + "' onchange=fnFilterPointMachineGraph('" + type + "','" + datevalue + "') checked/><label for='chkcluster_" + val.ClusterA + "'>" + val.ClusterA + "</label></div>");
                    }
                    clusterName = val.ClusterA;
                    clusterA.push(val.ClusterA);
                }
                if (type.includes("B")) {
                    if (clusterB.indexOf(val.ClusterB) == -1) {
                        lineColor = fnGetDarkColor();
                        $('#pointmachine-select-mainId').append("<div class='col-sm-2'><input type='checkbox' class='chkPointMachineGraphB' id='chkcluster_" + val.ClusterB + "' value='" + val.ClusterB + "' data-color='" + lineColor + "' onchange=fnFilterPointMachineGraph('" + type + "','" + datevalue + "') checked/><label for='chkcluster_" + val.ClusterB + "'>" + val.ClusterB + "</label></div>");
                    }
                    clusterName = val.ClusterB;
                    clusterB.push(val.ClusterB);
                }
                var legends = clusterName + " | " + fnAivLegendDate(val);
                var array = fnAivSignaturePoints(val.PointMachineJson, type, true);
                fnAivPushLabels(label, array);
                datasets.push(fnAivSignatureDataset(legends, lineColor, array));
            });
        }

        fnAivDrawPointMachineChart(label, datasets);
        $("#modal-pointmachine-graph").modal("show");
    }

    function fnFilterPointMachineGraph(type, datevalue) {
        var aClusterIds = [];
        var bClusterIds = [];

        $('.chkPointMachineGraphA:checkbox:checked').each(function () {
            aClusterIds.push(parseInt($(this).val()));
        });

        $('.chkPointMachineGraphB:checkbox:checked').each(function () {
            bClusterIds.push(parseInt($(this).val()));
        });

        if ((aClusterIds != null && aClusterIds.length > 0) || bClusterIds != null && bClusterIds.length > 0) {
            var searchCriteria = {
                MultipleClusterA: aClusterIds,
                MultipleClusterB: bClusterIds,
                AssetId: $('#hdnPMAssetId').val(),
                Direction: datevalue,
                IsThickWave: $("#chkIsThickWave").is(":checked") ? "true" : "false"
            };

            $("#loader").show();
            $.ajax({
                url: '/FRS25/AIVisualization/GetSitePointMachineGraph',
                type: 'Post',
                data: '{searchCriteria:' + JSON.stringify(searchCriteria) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    var datasets = [];
                    var label = [];
                    var clusterA = [];
                    var clusterB = [];
                    var lineColor = '';
                    if (chart != null && chart != "" && chart != undefined) {
                        chart.dispose();
                    }
                    if (data != null && data != undefined && data != '') {
                        $(data).each(function (data, val) {
                            var clusterName = '';
                            if (type.includes("A")) {
                                if (clusterA.indexOf(val.ClusterA) == -1) {
                                    var clusterColor = $('#chkcluster_' + val.ClusterA).data('color')
                                    if (clusterColor != null && clusterColor != undefined && clusterColor != '') {
                                        lineColor = clusterColor;
                                    } else {
                                        lineColor = fnGetDarkColor();
                                    }
                                }
                                clusterA.push(val.ClusterA);
                                clusterName = val.ClusterA;
                            }
                            if (type.includes("B")) {
                                if (clusterB.indexOf(val.ClusterB) == -1) {
                                    var clusterColor = $('#chkcluster_' + val.ClusterB).data('color')
                                    if (clusterColor != null && clusterColor != undefined && clusterColor != '') {
                                        lineColor = clusterColor;
                                    } else {
                                        lineColor = fnGetDarkColor();
                                    }
                                }
                                clusterB.push(val.ClusterB);
                                clusterName = val.ClusterB;
                            }

                            var legends = clusterName + " | " + fnAivLegendDate(val);
                            var array = fnAivSignaturePoints(val.PointMachineJson, type, true);
                            fnAivPushLabels(label, array);
                            datasets.push(fnAivSignatureDataset(legends, lineColor, array));
                        });
                    }

                    fnAivDrawPointMachineChart(label, datasets);
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
        else {
            fnAivClearPointMachineChart();
        }

    }


    function fnShowMultipleGraphBySite(siteId, type, datevalue) {
        var searchCriteria = {
            Status_A: $('#drpAStatus').find(":selected").val(),
            Status_B: $('#drpBStatus').find(":selected").val(),
            ClusterA: $('#drpaCluster').find(":selected").val(),
            ClusterB: $('#drpbCluster').find(":selected").val(),
            Direction: datevalue,
            IsThickWave: $("#chkIsThickWave").is(":checked") ? "true" : "false"
        };

        $("#loader").show();
        $.ajax({
            url: '/FRS25/AIVisualization/GetAllSitePointMachineGraph',
            type: 'Post',
            data: '{searchCriteria:' + JSON.stringify(searchCriteria) + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                fnBindMultipleSignatureGraghBySite(data, type, datevalue, siteId);

            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("ERROR", "Internal server error.", "error");
            }
        });

    }

    function fnBindMultipleSignatureGraghBySite(data, type, datevalue) {
        if (chart != null && chart != "" && chart != undefined) {
            chart.dispose();
        }
        $('#pointmachine-select-mainId').empty();
        var datasets = [];
        var label = [];
        var clusterA = [];
        var clusterB = [];

        if (data != null && data != undefined && data != '') {
            var lineColor = '';
            $(data).each(function (data, val) {
                var clusterName = '';
                if (type.includes("A")) {
                    if (clusterA.indexOf(val.ClusterA) == -1) {
                        lineColor = fnGetDarkColor();
                        $('#pointmachine-select-mainId').append("<div class='col-sm-2'><input type='checkbox' class='chkPointMachineGraphA' id='chkcluster_" + val.ClusterA + "' value='" + val.ClusterA + "' data-color='" + lineColor + "' onchange=fnFilterPointMachineGraphBySite('" + type + "','" + datevalue + "') checked/><label for='chkcluster_" + val.ClusterA + "'>" + val.ClusterA + "</label></div>");
                    }
                    clusterName = val.ClusterA;
                    clusterA.push(val.ClusterA);
                }
                if (type.includes("B")) {
                    if (clusterB.indexOf(val.ClusterB) == -1) {
                        lineColor = fnGetDarkColor();
                        // value='ClusterA' kept exactly as in the reference implementation.
                        $('#pointmachine-select-mainId').append("<div class='col-sm-2'><input type='checkbox' class='chkPointMachineGraphB' id='chkcluster_" + val.ClusterB + "' value='" + val.ClusterA + "' data-color='" + lineColor + "' onchange=fnFilterPointMachineGraphBySite('" + type + "','" + datevalue + "') checked/><label for='chkcluster_" + val.ClusterB + "'>" + val.ClusterB + "</label></div>");
                    }
                    clusterName = val.ClusterB;
                    clusterB.push(val.ClusterB);
                }

                var legends = clusterName + " | " + val.AssetType + " | " + fnAivLegendDate(val);
                // The reference "by site" graph only plots current (CC/CV/AC/BC), never AV/BV.
                var array = fnAivSignaturePoints(val.PointMachineJson, type, false);
                fnAivPushLabels(label, array);
                datasets.push(fnAivSignatureDataset(legends, lineColor, array));
            });
        }

        fnAivDrawPointMachineChart(label, datasets);
        $("#modal-pointmachine-graph").modal("show");
    }

    function fnFilterPointMachineGraphBySite(type, datevalue) {
        var aClusterIds = [];
        var bClusterIds = [];
        $('.chkPointMachineGraphA:checkbox:checked').each(function () {
            aClusterIds.push(parseInt($(this).val()));
        });

        $('.chkPointMachineGraphB:checkbox:checked').each(function () {
            bClusterIds.push(parseInt($(this).val()));
        });

        if (aClusterIds != null && aClusterIds.length > 0) {
            var searchCriteria = {
                MultipleClusterA: aClusterIds,
                MultipleClusterB: bClusterIds,
                Direction: datevalue,
                IsThickWave: $("#chkIsThickWave").is(":checked") ? "true" : "false"
            };

            $("#loader").show();
            $.ajax({
                url: '/FRS25/AIVisualization/GetAllSitePointMachineGraph',
                type: 'Post',
                data: '{searchCriteria:' + JSON.stringify(searchCriteria) + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    var clusterA = [];
                    var clusterB = [];
                    var datasets = [];
                    var label = [];
                    var lineColor = '';

                    if (chart != null && chart != "" && chart != undefined) {
                        chart.dispose();
                    }
                    if (data != null && data != undefined && data != '') {
                        $(data).each(function (data, val) {
                            var clusterName = '';
                            if (type.includes("A")) {
                                if (clusterA.indexOf(val.ClusterA) == -1) {
                                    // Reference reads the checkbox value (not data-color) here; kept as-is.
                                    var clusterColor = $('#chkcluster_' + val.ClusterA).val()
                                    if (clusterColor != null && clusterColor != undefined && clusterColor != '') {
                                        lineColor = clusterColor;
                                    } else {
                                        lineColor = fnGetDarkColor();
                                    }
                                }
                                clusterName = val.ClusterA;
                                clusterA.push(val.ClusterA);
                            }
                            if (type.includes("B")) {
                                if (clusterB.indexOf(val.ClusterB) == -1) {
                                    var clusterColor = $('#chkcluster_' + val.ClusterB).val()
                                    if (clusterColor != null && clusterColor != undefined && clusterColor != '') {
                                        lineColor = clusterColor;
                                    } else {
                                        lineColor = fnGetDarkColor();
                                    }
                                }
                                clusterName = val.ClusterB;
                                clusterB.push(val.ClusterB);
                            }

                            var legends = clusterName + " | " + val.AssetType + " | " + fnAivLegendDate(val);
                            var array = fnAivSignaturePoints(val.PointMachineJson, type, true);
                            fnAivPushLabels(label, array);
                            datasets.push(fnAivSignatureDataset(legends, lineColor, array));
                        });
                    }

                    fnAivDrawPointMachineChart(label, datasets);
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Internal server error.", "error");
                }
            });
        }
        else {
            fnAivClearPointMachineChart();
        }

    }

    function fnGetDarkColor() {
        var allowed = "ABCDEF0123456789", S = "#";

        while (S.length < 7) {
            S += allowed.charAt(Math.floor((Math.random() * 16) + 1));
        }
        return S;
    }
</script>
