@model Domain.TrackDataLister
@{
    var searchCriteria = Model.SearchCriteria ?? new Domain.TrackData();
    var trackDatas = Model.TrackDatas ?? new List<Domain.TrackData>();

    int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
    if (trackDatas.Count == 0)
    {
        start = 0;
    }
    decimal end = Math.Floor(Model.Pager.TotalRecord);
    if (Model.Pager.PageSize < Model.Pager.TotalRecord)
    {
        if (Model.Pager.PageSize == -1)
        {
            end = Model.Pager.TotalRecord;
        }
        else
        {
            end = Model.Pager.PageSize * Model.Pager.CurrentPage;
            if (end > Model.Pager.TotalRecord)
            {
                end = Model.Pager.TotalRecord;
            }
        }
    }
}

<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />

@* Filters (posted with #frmTrack to _TrackDashboard; field names unchanged) *@
<div class="aiv-subfilter">
    <div class="d-lg-flex d-md-flex d-flex flex-md-nowrap flex-wrap alertsearchform gap-10">
        <div class="form-group w-100 w-sm-48">
            <label for="SearchCriteria_SiteName">Site</label>
            @Html.DropDownListFor(m => m.SearchCriteria.SiteName, new SelectList(searchCriteria.SiteNames ?? new List<string>()), "Select Site", new { @class = "form-control" })
        </div>
        <div class="form-group w-100 w-sm-48">
            <label for="SearchCriteria_AssetName">Asset</label>
            @Html.DropDownListFor(m => m.SearchCriteria.AssetName, new SelectList(searchCriteria.AssetNames ?? new List<string>()), "Select Asset", new { @class = "form-control" })
        </div>
        <div class="form-group w-100 w-sm-48">
            <label for="SearchCriteria_Cluster">Cluster</label>
            @Html.DropDownListFor(m => m.SearchCriteria.Cluster, new SelectList(searchCriteria.Clusters ?? new List<string>()), "Select Cluster", new { @class = "form-control" })
        </div>
        <div class="form-group w-100 w-sm-48">
            <label for="SearchCriteria_OutlierCluster">Outlier Cluster</label>
            @Html.DropDownListFor(m => m.SearchCriteria.OutlierCluster, new SelectList(searchCriteria.OutlierClusters ?? new List<string>()), "Select Outlier Cluster", new { @class = "form-control" })
        </div>
        <div class="form-group w-sm-100">
            <label class="d-none d-md-block">&nbsp;</label>
            <button type="button" class="btn btn-primary-search" title="Search" onclick="SearchTrack()">
                <img src="~/Areas/FRS25/assets/img/search.svg" alt="Search" />
            </button>
        </div>
        <div class="form-group w-sm-100">
            <label class="d-none d-md-block">&nbsp;</label>
            <a class="btn-aiv-download" href="@Url.Action("DownloadTrack")"><i class="fa-solid fa-download"></i>Download</a>
        </div>
    </div>
</div>

<div class="aiv-toolbar">
    <span class="aiv-count">Showing <strong>@start - @Math.Floor(end)</strong> of <strong>@Math.Floor(Model.Pager.TotalRecord)</strong> records</span>
    <div class="aiv-pager">
        @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
        <label for="drpPageSize" class="aiv-count mb-0">Rows</label>
        @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
        <ul class="pagination pagination-sm">
            <li class="page-item"><a class="page-link" href="javascript:void(0);" title="Previous" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left"></i></a></li>
            <li class="page-item"><a class="page-link" href="javascript:void(0);" title="Next" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></a></li>
        </ul>
    </div>
</div>

<div class="table-border">
    <div class="table-responsive aiv-scroll" style="max-height: 620px;">
        <table class="table table-hover aiv-table mb-0">
            <thead class="thead-light2">
                <tr>
                    <th>Date</th>
                    <th>Site Name</th>
                    <th>Asset Name</th>
                    <th>If mA</th>
                    <th>Ir mA</th>
                    <th>Vr</th>
                    <th>Choke V</th>
                    <th>Charger mA</th>
                    <th>TPR V</th>
                    <th>AI Cluster</th>
                    <th>Outlier Cluster</th>
                </tr>
            </thead>
            <tbody>
                @if (trackDatas.Count > 0)
                {
                    foreach (var item in trackDatas)
                    {
                        <tr>
                            <td>@item.Date</td>
                            <td>@item.SiteName</td>
                            <td class="aiv-link"><a href="javascript:void(0)" onclick="fnGetAssetAttribute('@item.SiteName','@item.AssetId','@E7FRSAdvance.Utility.Utility.AssetType.TRACK.GetHashCode()')">@item.AssetName</a></td>
                            <td>@item.IfmA</td>
                            <td>@item.IrmA</td>
                            <td>@item.Vr</td>
                            <td>@item.ChokeV</td>
                            <td>@item.ChargermA</td>
                            <td>@item.TPRV</td>
                            <td>@item.Cluster</td>
                            <td>@item.OutlierCluster</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center">
                            <div class="aiv-empty"><i class="fa-regular fa-folder-open"></i>No record found</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Root (non-area) AssetAttribute partial is loaded here; it brings its own modal(s). *@
<div id="divAssetAttributePartial" class="aiv-asset-attr"></div>

<script>
    (function () {
        var type = $('#hdnCatListType').val();
        var message = $('#hdnCatListMessage').val();
        if (type && message) {
            CommonNotification(type, message, type);
        }
    })();

    function SearchTrack() {
        $("#hdnSkip").val('0');
        $("#frmTrack").submit();
    }

    function DownloadTrack() {

    }

    $(document).ready(function () {
        $('#drpPageSize').change(function (e) {
            $("#hdnSkip").val('0');
            $("#frmTrack").submit();
        });

    });

    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            var totalPage = parseFloat('@Model.Pager.TotalPage');
            if (!isNaN(totalPage) && totalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmTrack").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize) {
                var skip = @Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmTrack").submit();
            }
        }
    }

    function fnGetAssetAttribute(siteName, assetId, assetTypeId) {
        $("#loader").show();
        $.ajax({
            url: '/AssetAttribute/_AssetAttributePartial',
            type: 'Post',
            data: '{siteName:"' + siteName + '",assetId:' + assetId + ',assetTypeId:' + assetTypeId + '}',
            dataType: 'html',
            contentType: 'application/json',
            success: function (data) {
                $("#loader").hide();
                $("#divAssetAttributePartial").empty().append(data);
                $("#modal-assetLister").modal('show');
            },
            error: function (response) {
                $("#loader").hide();
                CommonNotification("danger", "Something went wrong!");
            }
        });
    }
</script>
