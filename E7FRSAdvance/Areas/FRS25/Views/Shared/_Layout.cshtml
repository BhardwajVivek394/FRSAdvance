        /* ══════════════════════════════════════════════════════════════
           FAB CHATBOT TRIGGER — improved: modern AI sparkle icon,
           floating animation, sparkle accent dot, full aurora gradient.
           ══════════════════════════════════════════════════════════════ */
        #aiChatTrigger {
            width: 60px !important;
            height: 60px !important;
            background: linear-gradient(135deg, var(--aurora-cyan) 0%, var(--aurora-violet) 55%, var(--aurora-magenta) 100%) !important;
            border: 1px solid rgba(255,255,255,0.28) !important;
            box-shadow: 0 8px 28px -4px var(--brand-glow), inset 0 1px 0 rgba(255,255,255,0.30) !important;
            position: fixed !important;
            overflow: visible !important;
            transition: all var(--t-fast) !important;
        }

            #aiChatTrigger:hover {
                box-shadow: 0 14px 40px -4px var(--brand-glow), inset 0 1px 0 rgba(255,255,255,0.35) !important;
                transform: translateY(-2px) scale(1.04) !important;
            }

            /* Hide the default SVG that ai-chat-sidebar.js injects */
            #aiChatTrigger svg {
                display: none !important;
            }

            /* New AI/sparkle icon via Font Awesome — modern & distinctive */
            #aiChatTrigger::before {
                content: '\f544'; /* fa-wand-magic-sparkles */
                font-family: 'Font Awesome 6 Free';
                font-weight: 900;
                font-size: 24px;
                color: #fff;
                text-shadow: 0 2px 8px rgba(0,0,0,0.25);
                z-index: 2;
                position: relative;
                animation: e7AiIconFloat 3.5s ease-in-out infinite;
                display: block;
                line-height: 1;
            }

            /* Tiny sparkle accent in the corner */
            #aiChatTrigger .e7-fab-spark {
                position: absolute;
                top: 8px;
                right: 10px;
                width: 8px;
                height: 8px;
                background: #fff;
                border-radius: 50%;
                box-shadow: 0 0 8px #fff, 0 0 14px var(--aurora-cyan);
                animation: e7FabSparkle 2.2s ease-in-out infinite;
                z-index: 3;
                pointer-events: none;
            }

            /* Replace the original double-ring pulse with an expanding glow */
            #aiChatTrigger::after {
                content: '' !important;
                position: absolute !important;
                inset: 0 !important;
                border-radius: 50% !important;
                border: none !important;
                box-shadow: 0 0 0 0 rgba(34,211,238,0.45);
                animation: e7FabGlow 3s ease-in-out infinite !important;
                pointer-events: none;
            }

        @@keyframes e7FabGlow {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(34,211,238,0.40);
            }

            50% {
                box-shadow: 0 0 0 16px rgba(34,211,238,0);
            }
        }

        @@keyframes e7AiIconFloat {
            0%, 100% {
                transform: translateY(0) rotate(0deg);
            }

            50% {
                transform: translateY(-2px) rotate(-6deg);
            }
        }

        @@keyframes e7FabSparkle {
            0%, 100% {
                opacity: 0.4;
                transform: scale(0.8);
            }

            50% {
                opacity: 1;
                transform: scale(1.2);
            }
        }

        /* ══════════════════════════════════════════════════════════════
           FULLSCREEN MODE
           When body has .ai-chat-fullscreen, the chat panel expands to
           cover the whole viewport. Messages get a comfortable max-width
           so the chat feels like a real fullscreen experience.
           ══════════════════════════════════════════════════════════════ */
        body.ai-chat-fullscreen #aiChatPanel {
            width: 100vw !important;
            border-left: none !important;
            border-radius: 0 !important;
            box-shadow: none !important;
        }

            /* Center the messages column when fullscreen */
            body.ai-chat-fullscreen #aiChatPanel .ai-chat-messages {
                padding: 28px max(28px, calc((100vw - 880px) / 2)) !important;
            }

            body.ai-chat-fullscreen #aiChatPanel .ai-msg-bubble {
                max-width: min(720px, 75vw) !important;
                font-size: 15px !important;
                line-height: 1.6 !important;
                padding: 13px 18px !important;
            }

            body.ai-chat-fullscreen #aiChatPanel .ai-msg-avatar {
                width: 36px !important;
                height: 36px !important;
                font-size: 13px !important;
            }

            body.ai-chat-fullscreen #aiChatPanel .ai-chat-header,
            body.ai-chat-fullscreen #aiChatPanel .ai-chat-context,
            body.ai-chat-fullscreen #aiChatPanel .ai-suggestions,
            body.ai-chat-fullscreen #aiChatPanel .ai-chat-input-area {
                padding-left: max(24px, calc((100vw - 880px) / 2)) !important;
                padding-right: max(24px, calc((100vw - 880px) / 2)) !important;
            }

            body.ai-chat-fullscreen #aiChatPanel .ai-input-wrapper {
                max-width: 880px;
                margin: 0 auto;
            }

            body.ai-chat-fullscreen #aiChatPanel .ai-input-footer {
                max-width: 880px;
                margin: 7px auto 0;
