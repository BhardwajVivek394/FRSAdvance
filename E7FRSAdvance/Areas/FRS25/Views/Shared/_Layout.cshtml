        .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background: rgba(255,255,255,0.18);
            border-radius: 26px;
            transition: .35s;
        }

            .slider::before {
                content: "";
                position: absolute;
                width: 20px;
                height: 20px;
                left: 3px;
                bottom: 3px;
                background: #fff;
                border-radius: 50%;
                transition: .35s;
                box-shadow: 0 2px 4px rgba(0,0,0,.25);
            }

        .switch input:checked + .slider {
            background: var(--primary);
        }

            .switch input:checked + .slider::before {
                transform: translateX(22px);
            }

        .switch.green input:checked + .slider {
            background: #22c55e;
        }

        .switch.red input:checked + .slider {
            background: var(--red);
        }

        .switch.orange input:checked + .slider {
            background: #f97316;
        }

        .switch.cyan input:checked + .slider {
            background: #06b6d4;
        }

        .switch.sm {
            width: 34px;
            height: 18px;
        }

            .switch.sm .slider::before {
                width: 12px;
                height: 12px;
                left: 3px;
                bottom: 3px;
            }

            .switch.sm input:checked + .slider::before {
                transform: translateX(16px);
            }

        .switch.lg {
            width: 64px;
            height: 34px;
        }

            .switch.lg .slider {
                border-radius: 34px;
            }

                .switch.lg .slider::before {
                    width: 26px;
                    height: 26px;
                    left: 4px;
                    bottom: 4px;
                }

            .switch.lg input:checked + .slider::before {
                transform: translateX(30px);
            }

        .switch.icon .slider::after {
            content: '✕';
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 10px;
            color: rgba(255,255,255,0.6);
            transition: .3s;
        }

        .switch.icon input:checked + .slider::after {
            content: '✓';
            left: 6px;
            right: auto;
            color: #fff;
        }

