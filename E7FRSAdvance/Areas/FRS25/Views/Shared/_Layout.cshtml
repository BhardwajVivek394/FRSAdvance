        /* ── Toast notifications — glass ── */
        .toast-container {
            position: fixed;
            top: 72px;
            right: 20px;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
        }

        .toast-notification {
            pointer-events: auto;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            min-width: 320px;
            max-width: 380px;
            padding: 14px 16px;
            border-radius: var(--radius-lg);
            background: rgba(10,16,40,0.92);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            box-shadow: 0 10px 40px rgba(0,0,0,.50);
            border: 1px solid rgba(255,255,255,0.12);
            animation: toastIn 0.35s cubic-bezier(.16,1,.3,1);
            position: relative;
            overflow: hidden;
        }

            .toast-notification::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                bottom: 0;
                width: 4px;
            }

            .toast-notification.hiding {
                animation: toastOut 0.25s ease-in forwards;
            }

        @@keyframes toastIn {
            from {
                transform: translateX(110%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @@keyframes toastOut {
            from {
                transform: translateX(0);
                opacity: 1;
            }

            to {
                transform: translateX(110%);
                opacity: 0;
            }
        }

        .toast-success::before {
            background: var(--green);
        }

        .toast-error::before {
            background: var(--red);
        }

        .toast-warning::before {
            background: var(--amber);
        }

        .toast-info::before {
            background: var(--primary);
        }

        .toast-icon {
            width: 36px;
            height: 36px;
            min-width: 36px;
            border-radius: var(--radius);
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .toast-success .toast-icon {
            background: var(--green-light);
            color: var(--green);
        }

        .toast-error .toast-icon {
            background: var(--red-light);
            color: var(--red);
        }

        .toast-warning .toast-icon {
            background: var(--amber-light);
            color: var(--amber);
        }

        .toast-info .toast-icon {
            background: var(--primary-50);
            color: var(--primary);
        }

        .toast-body {
            flex: 1;
            padding-right: 20px;
        }

        .toast-title {
            font-weight: 600;
            font-size: 13px;
            color: #fff;
            margin-bottom: 2px;
        }

        .toast-message {
            font-size: 12px;
            color: rgba(255,255,255,0.55);
        }

        .toast-close {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 22px;
            height: 22px;
            background: rgba(255,255,255,0.08);
            border: none;
            border-radius: 5px;
            font-size: 13px;
