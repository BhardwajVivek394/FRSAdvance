    <script>
        // ── Sidebar toggle (hamburger) ──────────────────────────────
        document.getElementById('e7MenuToggle').addEventListener('click', function () {
            if (window.innerWidth <= 991) {
                document.getElementById('e7Sidebar').classList.toggle('open');
            } else {
                document.body.classList.toggle('sidebar-mini');
            }
        });

        // ── Submenu accordion ───────────────────────────────────────
        function e7ToggleSub(subId, parentEl) {
            event.preventDefault();
            var sub = document.getElementById(subId);
            var isOpen = sub.classList.contains('open');
            // Close all siblings
            document.querySelectorAll('.e7-submenu').forEach(function(s) { s.classList.remove('open'); });
            document.querySelectorAll('.e7-nav-item.has-sub').forEach(function(p) { p.classList.remove('open'); });
            if (!isOpen) {
                sub.classList.add('open');
                parentEl.classList.add('open');
            }
        }

        // ── Fullscreen ──────────────────────────────────────────────
        document.getElementById('e7Fullscreen').addEventListener('click', function () {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen && document.documentElement.requestFullscreen();
            } else {
                document.exitFullscreen && document.exitFullscreen();
            }
        });

        // ── Live clock ticker (header live badge) ───────────────────
        (function () {
            var el = document.getElementById('e7LiveTime');
            if (!el) return;
            function tick() {
                var d = new Date();
                var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
                el.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
            }
            tick();
            setInterval(tick, 1000);
        })();

        // ══════════════════════════════════════════════════════════════
        // AI Chat: fullscreen toggle shim + FAB sparkle accent
        // - Injects a SINGLE fullscreen toggle button into the chat header
        //   (and removes any duplicates that might appear).
        // - Adds a tiny sparkle accent dot on the floating chat trigger.
        // - Doesn't touch any existing chat logic.
        // ══════════════════════════════════════════════════════════════
        (function () {
            var BUTTON_CLASS = 'e7-ai-fs-btn ai-chat-header-btn';

            function toggleFullscreen() {
                document.body.classList.toggle('ai-chat-fullscreen');
            }

            function injectButton() {
                var panel = document.getElementById('aiChatPanel');
                if (!panel) return false;

                // Already injected? Remove any duplicates beyond the first.
                var existing = panel.querySelectorAll('.e7-ai-fs-btn');
                if (existing.length >= 1) {
                    for (var i = 1; i < existing.length; i++) existing[i].remove();
                    return true;
                }

                // The widget creates a .ai-chat-header-actions container next to the title
                var actions = panel.querySelector('.ai-chat-header-actions');
                var header  = panel.querySelector('.ai-chat-header');
                if (!actions && !header) return false;

                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = BUTTON_CLASS;
                btn.title = 'Toggle fullscreen';
                btn.setAttribute('aria-label', 'Toggle chat fullscreen');
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    toggleFullscreen();
                });

                if (actions) {
                    // Place as the first action so it sits left of close/minimize.
                    actions.insertBefore(btn, actions.firstChild);
                } else {
                    header.appendChild(btn);
                }
                return true;
            }

            // Add a tiny sparkle dot on the FAB trigger for extra polish.
            function injectFabSparkle() {
                var fab = document.getElementById('aiChatTrigger');
                if (!fab) return false;
                if (fab.querySelector('.e7-fab-spark')) return true;
                var spark = document.createElement('span');
                spark.className = 'e7-fab-spark';
                spark.setAttribute('aria-hidden', 'true');
                fab.appendChild(spark);
                return true;
            }

            function tryInject() {
                var a = injectButton();
                var b = injectFabSparkle();
                return a && b;
            }

            // Try once immediately; then watch the DOM in case the panel
            // and FAB mount later.
            if (!tryInject()) {
                var obs = new MutationObserver(function () {
                    // Always run both — this also keeps duplicates pruned
                    // if the widget re-renders its header.
                    tryInject();
                });
                obs.observe(document.body, { childList: true, subtree: true });
                // Safety: stop after 30s if everything settled.
                setTimeout(function () { obs.disconnect(); }, 30000);
            }

            // Esc exits fullscreen (but does not close the chat).
            // We only intercept Esc when fullscreen is on, so the widget's
            // own Esc-to-close behavior is preserved when not fullscreen.
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && document.body.classList.contains('ai-chat-fullscreen')) {
                    document.body.classList.remove('ai-chat-fullscreen');
                    e.stopPropagation();
                }
            }, true); // capture phase so we run before the widget's Esc handler

            // If the chat panel gets closed (loses .open), drop fullscreen too,
            // so reopening it returns to the normal sidebar size.
            (function watchClose() {
                var panel = document.getElementById('aiChatPanel');
                if (!panel) {
                    setTimeout(watchClose, 500);
                    return;
                }
                var mo = new MutationObserver(function () {
                    if (!panel.classList.contains('open')) {
                        document.body.classList.remove('ai-chat-fullscreen');
                    }
                });
                mo.observe(panel, { attributes: true, attributeFilter: ['class'] });
            })();
        })();

        // ── Dark/light mode CSS fix ─────────────────────────────────
        $('#toggle-btn').click(function () { fnChangeCSSAfterChnageMode(); });

        function fnChangeCSSAfterChnageMode() {
            try {
                const sheets = document.styleSheets;
                for (let sheet of sheets) {
                    try {
                        const rules = sheet.cssRules || sheet.rules;
                        for (let rule of rules) {
                            if (rule.selectorText ===
                                'body:not(.sidebar-mini) .sidebar-style-2 .sidebar-menu li.active ul.dropdown-menu li a') {
                                rule.style.backgroundColor = localStorage.getItem("theme") === "dark" ? '#000' : '#fff';
                                return;
                            }
                        }
                    } catch (e) { /* cross-origin */ }
                }
            } catch(e){}
        }

        // ── Toast helpers ───────────────────────────────────────────
        function showToast(type, title, message, duration) {
            duration = duration || 4000;
            var icons = {
                success: '<i class="fas fa-check"></i>',
                error:   '<i class="fas fa-times"></i>',
                warning: '<i class="fas fa-exclamation-triangle"></i>',
                info:    '<i class="fas fa-info-circle"></i>'
            };
            var id = 'toast_' + Date.now();
            $('#toastContainer').append(
                '<div class="toast-notification toast-' + type + '" id="' + id + '">' +
                '<div class="toast-icon">' + icons[type] + '</div>' +
                '<div class="toast-body">' +
                '<div class="toast-title">' + title + '</div>' +
                '<div class="toast-message">' + message + '</div>' +
                '</div>' +
                '<button class="toast-close" onclick="closeToast(\'' + id + '\')">×</button>' +
                '<div class="toast-progress"></div>' +
                '</div>'
            );
            setTimeout(function () { closeToast(id); }, duration);
        }

        function closeToast(id) {
            var $t = $('#' + id);
            if ($t.length && !$t.hasClass('hiding')) {
                $t.addClass('hiding');
                setTimeout(function () { $t.remove(); }, 300);
            }
        }

        function showSuccess(m, t) { showToast('success', t || 'Success', m); }
        function showError(m, t)   { showToast('error',   t || 'Error',   m); }
        function showWarning(m, t) { showToast('warning', t || 'Warning', m); }
        function showInfo(m, t)    { showToast('info',    t || 'Info',    m); }

        // ── Session keep-alive ──────────────────────────────────────
        setInterval(function () { MakeMeLive(); }, 10000);

        function MakeMeLive() {
            $.ajax({
                type: "POST",
                url: '@Url.Content("~/FRS25/Home/MakeSessionLive")',
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                async: true,
                success: function (response) {
                    if (response.Result == "Forbidden") {
                        window.location.href = '@Url.Content("~/FRS25/Login/Index")';
                    }
                },
                error: function () {}
            });
        }

        // ── Annexure switcher ───────────────────────────────────────
        function fnOnChangeAnnexure($this) {
            var val = $($this).val();
            if (val && val !== '' && val !== '0') {
                window.location.href = '@Url.Action("LoginWithAnnexure", "Login", new { area = "" })' + '?annexureId=' + val;
            }
        }

        // ── List / Grid view toggle (for pages that use it) ─────────
        $(document).ready(function () {
            var btnList = document.getElementById("btnList");
            var btnGrid = document.getElementById("btnGrid");
            var listView = document.getElementById("listView");
            var gridView = document.getElementById("gridView");

            if (btnList && btnGrid && listView && gridView) {
                btnList.addEventListener('click', function () {
                    listView.style.display = "block"; gridView.style.display = "none";
                    btnList.classList.add('active-table-btn', 'btn-active');
                    btnGrid.classList.remove('active-table-btn', 'btn-active');
                });
                btnGrid.addEventListener('click', function () {
                    listView.style.display = "none"; gridView.style.display = "block";
                    btnGrid.classList.add('active-table-btn', 'btn-active');
                    btnList.classList.remove('active-table-btn', 'btn-active');
                });
            }

            // Button group active state
            $('#buttonGroupLeft .btn').click(function () {
                $('#buttonGroupLeft .btn').removeClass('active btn-primary');
                $(this).addClass('active btn-primary');
            });

            // Bootstrap collapse chevron flip
            $('a[data-toggle="collapse"]').each(function () {
                var $icon = $(this).find('i');
                var target = $(this).attr('href');
                $(target).on('show.bs.collapse', function () { $icon.removeClass('fa-angle-down').addClass('fa-angle-up'); });
                $(target).on('hide.bs.collapse', function () { $icon.removeClass('fa-angle-up').addClass('fa-angle-down'); });
            });
        });
    </script>

