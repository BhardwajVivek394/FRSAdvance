    <script>
// ════════════════════════════════════════════════════════════════
// NOTIFICATION BELL — Hybrid: DB (refresh) + WebSocket (live)
// "Seen" state persisted in COOKIES by FRSAlertId.
// Once marked seen, an alert is NEVER shown again today.
// ════════════════════════════════════════════════════════════════
(function () {

    // ── Config ───────────────────────────────────────────────────
    var WS_BASE = (window.APP_CONFIG && window.APP_CONFIG.WebSocketBaseUrl) || '';
    var WS_URL = '';
    if (WS_BASE) {
        WS_URL = WS_BASE.replace(/\/$/, '') + '/subscribe/alertEvents';
        if (window.APP_CONFIG.WebSocketAuthToken) {
            WS_URL += (WS_URL.indexOf('?') === -1 ? '?' : '&')
                    + 'token=' + encodeURIComponent(window.APP_CONFIG.WebSocketAuthToken);
        }
    }

    var ALERTS_PAGE_URL  = '@Url.Content("~/FRS25/Alerts/Index")';
    var GET_ALERTS_URL   = '@Url.Content("~/FRS25/Alerts/GetTodayAlertsJson")';
    var MAX_ALERTS       = 100;
    var COOKIE_NAME      = 'e7_notif_seen';
    var COOKIE_DAY       = 'e7_notif_day';
    var COOKIE_EXPIRY_DAYS = 1;

    // ── State ────────────────────────────────────────────────────
    var notifications  = [];
    var seenIds        = loadSeenIds();
    var socket         = null;
    var reconnectTimer = null;

    // ── DOM refs ─────────────────────────────────────────────────
    var $btn       = document.getElementById('e7NotifBtn');
    var $count     = document.getElementById('e7NotifCount');
    var $headCount = document.getElementById('e7NotifHeadCount');
    var $dropdown  = document.getElementById('e7NotifDropdown');
    var $list      = document.getElementById('e7NotifList');
    var $clearBtn  = document.getElementById('e7NotifClearBtn');
    var $wrap      = document.getElementById('e7NotifWrap');

    if (!$btn) {
        console.warn('[Notif] Bell markup not found.');
        return;
    }

    // ── COOKIE HELPERS ───────────────────────────────────────────
    function setCookie(name, value, days) {
        try {
            var expires = '';
            if (days) {
                var date = new Date();
                date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                expires = '; expires=' + date.toUTCString();
            }
            document.cookie = name + '=' + encodeURIComponent(value || '') + expires + '; path=/; SameSite=Lax';
        } catch (e) {
            console.error('[Notif] setCookie failed', e);
        }
    }

    function getCookie(name) {
        try {
            var nameEQ = name + '=';
            var parts = document.cookie.split(';');
            for (var i = 0; i < parts.length; i++) {
                var c = parts[i];
                while (c.charAt(0) === ' ') c = c.substring(1);
                if (c.indexOf(nameEQ) === 0) {
                    return decodeURIComponent(c.substring(nameEQ.length));
                }
            }
        } catch (e) {}
        return null;
    }

    // ── Load seen IDs (with daily auto-reset) ────────────────────
    function loadSeenIds() {
        try {
            var today = new Date().toDateString();
            var storedDay = getCookie(COOKIE_DAY);

            // New day → wipe yesterday's seen list, start fresh
            if (storedDay !== today) {
                setCookie(COOKIE_DAY, today, COOKIE_EXPIRY_DAYS);
                setCookie(COOKIE_NAME, '', COOKIE_EXPIRY_DAYS);
                return {};
            }

            var raw = getCookie(COOKIE_NAME) || '';
            if (!raw) return {};

            var arr = raw.split(',').filter(function (s) { return s.length > 0; });
            var map = {};
            arr.forEach(function (id) { map[String(id)] = true; });
            return map;
        } catch (e) {
            return {};
        }
    }

    function saveSeenIds() {
        try {
            var arr = Object.keys(seenIds);
            setCookie(COOKIE_NAME, arr.join(','), COOKIE_EXPIRY_DAYS);
            setCookie(COOKIE_DAY, new Date().toDateString(), COOKIE_EXPIRY_DAYS);
        } catch (e) {
            console.error('[Notif] saveSeenIds failed', e);
        }
    }

    function isSeen(id) {
        return !!seenIds[String(id)];
    }

    function markSeen(id) {
        if (!id) return;
        seenIds[String(id)] = true;
        saveSeenIds();
    }

    // ── Dropdown open / close ────────────────────────────────────
    // Opening the bell just shows the list — does NOT mark alerts seen.
    // The badge clears because the user has "viewed" the count, but the
    // items stay visible until the user actually interacts with them.
    $btn.addEventListener('click', function (e) {
        e.stopPropagation();
        $dropdown.classList.toggle('open');
        // The list is already rendered, just show it.
        // Badge stays as-is — only individual clicks or "Clear all" remove items.
    });

    document.addEventListener('click', function (e) {
        if (!$wrap.contains(e.target)) {
            $dropdown.classList.remove('open');
        }
    });

    // ── Clear all — marks every visible alert as seen, clears list ──
    $clearBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        notifications.forEach(function (n) {
            if (n.id) seenIds[String(n.id)] = true;
        });
        saveSeenIds();
        notifications = [];
        updateBadge();
        renderList();
    });

    // ── Badge update ─────────────────────────────────────────────
    function updateBadge() {
        var n = notifications.length;
        if (n > 0) {
            $count.textContent = n > 99 ? '99+' : n;
            $count.classList.add('show');
            $btn.classList.add('has-alerts');
        } else {
            $count.classList.remove('show');
            $btn.classList.remove('has-alerts');
        }
        $headCount.textContent = n ? '· ' + n : '';
    }

    // ── Render the dropdown list ─────────────────────────────────
    function renderList() {
        if (notifications.length === 0) {
            $list.innerHTML =
                '<div class="e7-notif-empty">' +
                '<i class="fas fa-bell-slash"></i>' +
                '<p>No new alerts</p>' +
                '</div>';
            return;
        }

        var html = '';
        notifications.forEach(function (n) {
            var isPredictive = (n.alertType || '').toLowerCase() === 'predictive';
            var iconClass    = isPredictive ? 'predictive' : '';
            var tagClass     = isPredictive ? 'predictive' : '';
            var icon         = isPredictive ? 'fa-chart-line' : 'fa-exclamation-triangle';

            var timeStr = '';
            try {
                var d = n.time ? parseDateSafe(n.time) : new Date();
                if (d && !isNaN(d.getTime())) {
                    timeStr = ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);
                }
            } catch (e) {}

            var desc = (n.description || '').split('\n')[0];

            html +=
                '<a href="javascript:void(0)" class="e7-notif-item unread" ' +
                'onclick="e7NotifClick(\'' + n.id + '\', ' + (n.siteId || 0) + ', ' + (n.assetId || 0) + ')">' +
                    '<div class="e7-notif-icon ' + iconClass + '">' +
                        '<i class="fas ' + icon + '"></i>' +
                    '</div>' +
                    '<div class="e7-notif-body">' +
                        '<div class="e7-notif-title">' +
                            '<span class="e7-notif-asset">' + escapeHtml(n.assetName || 'Unknown asset') + '</span>' +
                            '<span class="e7-notif-time">' + timeStr + '</span>' +
                        '</div>' +
                        '<div class="e7-notif-desc">' +
                            escapeHtml(n.causeCode || '') +
                            (desc ? ' — ' + escapeHtml(desc) : '') +
                        '</div>' +
                        '<span class="e7-notif-tag ' + tagClass + '">' + escapeHtml(n.alertType || 'Alert') + '</span>' +
                    '</div>' +
                '</a>';
        });

        $list.innerHTML = html;
    }

    function escapeHtml(s) {
        if (s === null || s === undefined) return '';
        return String(s)
            .replace(/&/g,  '&amp;')
            .replace(/</g,  '&lt;')
            .replace(/>/g,  '&gt;')
            .replace(/"/g,  '&quot;')
            .replace(/'/g,  '&#39;');
    }

    function parseDateSafe(v) {
        if (!v) return null;
        if (v instanceof Date) return v;
        if (typeof v === 'string') {
            var m = v.match(/\/Date\((\-?\d+)\)\//);
            if (m) return new Date(parseInt(m[1], 10));
            return new Date(v);
        }
        if (typeof v === 'number') return new Date(v);
        return null;
    }

    // ── Click on an alert — mark seen + navigate ─────────────────
    window.e7NotifClick = function (notifId, siteId, assetId) {
        // Mark THIS specific alert as seen so it never reappears
        markSeen(notifId);

        var url = ALERTS_PAGE_URL;
        var params = [];
        if (siteId)  params.push('siteId='  + encodeURIComponent(siteId));
        if (assetId) params.push('assetId=' + encodeURIComponent(assetId));
        if (params.length) url += '?' + params.join('&');
        window.location.href = url;
    };

    // ── Sort newest first ────────────────────────────────────────
    function sortByTimeDesc() {
        notifications.sort(function (a, b) {
            var ta = parseDateSafe(a.time);
            var tb = parseDateSafe(b.time);
            var na = ta ? ta.getTime() : 0;
            var nb = tb ? tb.getTime() : 0;
            return nb - na;
        });
    }

    // ════════════════════════════════════════════════════════════
    // INITIAL DB LOAD — runs on every page refresh.
    // Filters out alerts that are already in the "seen" cookie.
    // ════════════════════════════════════════════════════════════
    function loadInitialAlerts() {
        $.ajax({
            url: GET_ALERTS_URL,
            type: 'POST',
            dataType: 'json',
            success: function (resp) {
                if (!resp || !resp.success) {
                    console.warn('[Notif] DB load failed', resp);
                    finalizeRender();
                    return;
                }

                var serverAlerts = resp.alerts || [];
                console.log('[Notif] DB returned ' + serverAlerts.length + ' alerts');

                var skipped = 0;
                serverAlerts.forEach(function (a) {
                    var id = String(a.id);

                    // Skip if user already saw/dismissed this alert
                    if (isSeen(id)) { skipped++; return; }

                    notifications.push({
                        id:          id,
                        siteId:      a.siteId || 0,
                        assetId:     a.assetId || 0,
                        assetName:   a.assetName || '',
                        alertType:   a.alertType || 'Failure',
                        causeCode:   a.causeCode || '',
                        description: a.description || '',
                        time:        a.incidenceTime || ''
                    });
                });

                console.log('[Notif] Filtered out ' + skipped + ' seen alerts, showing ' + notifications.length);
                finalizeRender();
            },
            error: function (xhr) {
                console.error('[Notif] DB load error', xhr.status);
                finalizeRender();
            }
        });
    }

    function finalizeRender() {
        sortByTimeDesc();
        if (notifications.length > MAX_ALERTS) {
            notifications = notifications.slice(0, MAX_ALERTS);
        }
        updateBadge();
        renderList();
    }

    // ════════════════════════════════════════════════════════════
    // WEBSOCKET — live updates
    // ════════════════════════════════════════════════════════════
    function connectSocket() {
        if (!WS_URL) {
            console.warn('[Notif] WebSocket URL not configured.');
            return;
        }
        try {
            socket = new WebSocket(WS_URL);

            socket.onopen = function () {
                console.log('[Notif] WebSocket connected');
            };

            socket.onmessage = function (evt) {
                handleBatch(evt.data);
            };

            socket.onclose = function () {
                console.warn('[Notif] WebSocket closed. Reconnecting in 5s...');
                if (reconnectTimer) clearTimeout(reconnectTimer);
                reconnectTimer = setTimeout(connectSocket, 5000);
            };

            socket.onerror = function (err) {
                console.error('[Notif] WebSocket error', err);
                try { socket.close(); } catch (e) {}
            };
        } catch (e) {
            console.error('[Notif] Connect failed', e);
            if (reconnectTimer) clearTimeout(reconnectTimer);
            reconnectTimer = setTimeout(connectSocket, 5000);
        }
    }

    function isToday(dateLike) {
        var d = parseDateSafe(dateLike);
        if (!d || isNaN(d.getTime())) return true;
        var today = new Date();
        return d.getDate() === today.getDate()
            && d.getMonth() === today.getMonth()
            && d.getFullYear() === today.getFullYear();
    }

    function handleBatch(raw) {
        var batch;
        try { batch = JSON.parse(raw); }
        catch (e) { console.error('[Notif] Bad batch payload', e); return; }

        var messages = [];
        if (batch && batch.MessageType === 'Batch' && Array.isArray(batch.Messages)) {
            messages = batch.Messages;
        } else if (batch && batch.Topic === 'alertEvents' && batch.Messages) {
            messages = batch.Messages;
        } else if (Array.isArray(batch)) {
            messages = batch;
        } else if (batch && batch.SiteId !== undefined) {
            messages = [batch];
        } else {
            return;
        }

        var changed = false;

        messages.forEach(function (msgStr) {
            var a;
            try { a = (typeof msgStr === 'string') ? JSON.parse(msgStr) : msgStr; }
            catch (e) { return; }

            if (!a) return;

            var action = (a.AlertAction || '').toUpperCase();
            var alertId = a.FRSAlertId || a.FrsAlertId || a.AlertId
                       || (a.AssetId + '|' + a.CauseCode);
            alertId = String(alertId);

            if (action === 'SET') {
                // Only accept today's alerts
                if (!isToday(a.Time)) return;

                // Skip if already in cookie (user dismissed it earlier)
                if (isSeen(alertId)) {
                    console.log('[Notif] WS ignoring already-seen alert #' + alertId);
                    return;
                }

                // Skip if already in current list (dedupe)
                if (notifications.some(function (n) { return n.id === alertId; })) return;

                // Add live to top of list
                notifications.unshift({
                    id:          alertId,
                    siteId:      a.SiteId,
                    assetId:     a.AssetId,
                    assetName:   a.AssetName,
                    alertType:   a.AlertType,
                    causeCode:   a.CauseCode,
                    description: a.Description,
                    time:        a.Time
                });
                changed = true;
                console.log('[Notif] WS added live alert #' + alertId);

            } else if (action === 'RESET') {
                // Alert was cleared at source — remove from list
                var idx = notifications.findIndex(function (n) { return n.id === alertId; });
                if (idx !== -1) {
                    notifications.splice(idx, 1);
                    changed = true;
                }
                // Also remove from cookie — if it ever fires fresh again, allow showing
                if (seenIds[alertId]) {
                    delete seenIds[alertId];
                    saveSeenIds();
                }
            }
        });

        if (notifications.length > MAX_ALERTS) {
            notifications = notifications.slice(0, MAX_ALERTS);
        }

        if (changed) {
            sortByTimeDesc();
            updateBadge();
            renderList();
        }
    }

    // ── Boot ─────────────────────────────────────────────────────
    if (typeof jQuery !== 'undefined') {
        loadInitialAlerts();
        connectSocket();
    } else {
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof jQuery !== 'undefined') {
                loadInitialAlerts();
                connectSocket();
            } else {
                connectSocket();
            }
        });
    }

    window.addEventListener('beforeunload', function () {
        if (socket) { try { socket.close(); } catch (e) {} }
        if (reconnectTimer) clearTimeout(reconnectTimer);
    });

})();
    </script>
</body>

</html>
