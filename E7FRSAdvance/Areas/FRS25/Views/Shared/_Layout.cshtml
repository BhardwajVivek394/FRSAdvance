            body[data-aurora="light"] .alrt-tl-content {
                background: rgba(15,23,42,0.04) !important;
            }





        /* ══════════════════════════════════════════════════════════════
        NOTIFICATION BELL — Aurora glass dropdown
        ══════════════════════════════════════════════════════════════ */
        .e7-notif-wrap {
            position: relative;
        }

        .e7-notif-btn {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            background: var(--glass-1);
            border: 1px solid var(--glass-edge);
            color: rgba(255,255,255,0.72);
            font-size: 15px;
            cursor: pointer;
            transition: all var(--t-fast);
            position: relative;
        }

            .e7-notif-btn:hover {
                background: var(--glass-3);
                border-color: var(--glass-edge-strong);
                color: rgba(255,255,255,0.96);
            }

            .e7-notif-btn.has-alerts {
                color: var(--aurora-cyan);
                border-color: rgba(34,211,238,0.40);
                animation: e7BellShake 1.5s ease-in-out;
            }

        .e7-notif-count {
            position: absolute;
            top: -5px;
            right: -5px;
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            background: linear-gradient(135deg, #fb7185, #f43f5e);
            color: #fff;
            border-radius: 999px;
            font-family: 'JetBrains Mono', ui-monospace, monospace;
            font-size: 10px;
            font-weight: 700;
            display: none;
            align-items: center;
            justify-content: center;
            border: 2px solid rgba(10,15,36,0.85);
            box-shadow: 0 0 8px rgba(251,113,133,0.6);
            line-height: 1;
        }

            .e7-notif-count.show {
                display: inline-flex;
                animation: e7BadgePop 0.3s cubic-bezier(.34,1.56,.64,1);
            }

        @@keyframes e7BadgePop {
            0% {
                transform: scale(0);
            }

            70% {
                transform: scale(1.15);
            }

            100% {
                transform: scale(1);
            }
        }

        @@keyframes e7BellShake {
            0%, 100% {
                transform: rotate(0);
            }

            20% {
                transform: rotate(-12deg);
            }

            40% {
                transform: rotate(10deg);
            }

            60% {
                transform: rotate(-6deg);
            }

            80% {
                transform: rotate(4deg);
            }
        }

        .e7-notif-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 380px;
            max-height: 480px;
            background: rgba(10,16,40,0.96);
            backdrop-filter: blur(28px) saturate(160%);
            -webkit-backdrop-filter: blur(28px) saturate(160%);
            border: 1px solid var(--glass-edge-strong);
            border-radius: 14px;
            box-shadow: 0 24px 48px -12px rgba(0,0,0,0.55);
            z-index: 10000;
            overflow: hidden;
            flex-direction: column;
        }

            .e7-notif-dropdown.open {
                display: flex;
                animation: e7DropdownIn 0.2s ease-out;
            }

        @@keyframes e7DropdownIn {
            from {
                opacity: 0;
                transform: translateY(-8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .e7-notif-head {
            padding: 14px 16px;
            border-bottom: 1px solid var(--glass-edge);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: linear-gradient(135deg, rgba(34,211,238,0.08), rgba(167,139,250,0.04));
            flex-shrink: 0;
        }

            .e7-notif-head h6 {
                margin: 0;
                font-family: 'Bricolage Grotesque', system-ui, sans-serif;
                font-size: 14px;
                font-weight: 700;
                color: rgba(255,255,255,0.96);
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .e7-notif-head .e7-notif-clear {
                background: transparent;
                border: none;
                color: rgba(255,255,255,0.55);
                font-size: 11px;
                font-weight: 500;
                cursor: pointer;
                padding: 4px 8px;
                border-radius: 6px;
                transition: all var(--t-fast);
            }

                .e7-notif-head .e7-notif-clear:hover {
                    background: var(--glass-3);
                    color: var(--aurora-cyan);
                }

        .e7-notif-list {
            flex: 1;
            overflow-y: auto;
            padding: 6px;
        }

            .e7-notif-list::-webkit-scrollbar {
                width: 4px;
            }

            .e7-notif-list::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,0.10);
                border-radius: 3px;
            }

        .e7-notif-item {
            display: flex;
            gap: 10px;
            padding: 11px 12px;
            border-radius: 10px;
            cursor: pointer;
            transition: all var(--t-fast);
            border: 1px solid transparent;
            margin-bottom: 2px;
            text-decoration: none;
            color: inherit;
        }

            .e7-notif-item:hover {
                background: var(--glass-3);
                border-color: var(--glass-edge);
                text-decoration: none;
                color: inherit;
            }

            .e7-notif-item.unread {
                background: rgba(34,211,238,0.08);
                border-color: rgba(34,211,238,0.20);
            }

                .e7-notif-item.unread:hover {
                    background: rgba(34,211,238,0.14);
                }

        .e7-notif-icon {
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            border-radius: 10px;
            background: rgba(251,113,133,0.15);
            color: #fb7185;
            display: grid;
            place-items: center;
            font-size: 13px;
            border: 1px solid rgba(251,113,133,0.25);
        }

            .e7-notif-icon.predictive {
                background: rgba(251,191,36,0.15);
                color: #fbbf24;
                border-color: rgba(251,191,36,0.25);
            }

        .e7-notif-body {
            flex: 1;
            min-width: 0;
        }

        .e7-notif-title {
            font-size: 12.5px;
            font-weight: 600;
            color: rgba(255,255,255,0.96);
            margin-bottom: 2px;
            display: flex;
            justify-content: space-between;
            gap: 8px;
            align-items: center;
        }

            .e7-notif-title .e7-notif-asset {
                flex: 1;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .e7-notif-title .e7-notif-time {
                font-family: 'JetBrains Mono', ui-monospace, monospace;
                font-size: 10px;
                color: rgba(255,255,255,0.40);
                flex-shrink: 0;
                font-weight: 400;
            }

        .e7-notif-desc {
            font-size: 11.5px;
            color: rgba(255,255,255,0.65);
            line-height: 1.4;
            overflow: hidden;
            text-overflow: ellipsis;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
        }

        .e7-notif-tag {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 7px;
            border-radius: 4px;
            font-size: 9.5px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            margin-top: 4px;
            background: rgba(251,113,133,0.15);
            color: #fb7185;
            border: 1px solid rgba(251,113,133,0.25);
        }

            .e7-notif-tag.predictive {
                background: rgba(251,191,36,0.15);
                color: #fbbf24;
                border-color: rgba(251,191,36,0.25);
            }

            .e7-notif-tag.site {
                background: var(--glass-1);
                color: rgba(255,255,255,0.55);
                border-color: var(--glass-edge);
            }

        .e7-notif-empty {
            padding: 50px 20px;
            text-align: center;
            color: rgba(255,255,255,0.40);
        }

            .e7-notif-empty i {
                font-size: 36px;
                margin-bottom: 10px;
                color: rgba(255,255,255,0.25);
            }

            .e7-notif-empty p {
                margin: 0;
                font-size: 13px;
            }

        .e7-notif-foot {
            padding: 10px;
            border-top: 1px solid var(--glass-edge);
            text-align: center;
            flex-shrink: 0;
        }

            .e7-notif-foot a {
                font-size: 12px;
                font-weight: 500;
                color: var(--aurora-cyan);
                text-decoration: none;
                padding: 6px 12px;
                border-radius: 8px;
                transition: all var(--t-fast);
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

                .e7-notif-foot a:hover {
                    background: rgba(34,211,238,0.12);
                }

        /* Light theme */
        body[data-aurora="light"] .e7-notif-btn {
            background: rgba(15,23,42,0.04) !important;
            border-color: rgba(15,23,42,0.10) !important;
            color: #475569 !important;
        }

            body[data-aurora="light"] .e7-notif-btn:hover {
                background: rgba(15,23,42,0.08) !important;
                color: #0b1530 !important;
            }

        body[data-aurora="light"] .e7-notif-dropdown {
            background: rgba(255,255,255,0.96) !important;
            border-color: rgba(15,23,42,0.10) !important;
            box-shadow: 0 24px 48px -12px rgba(15,23,42,0.20) !important;
        }

        body[data-aurora="light"] .e7-notif-head h6 {
            color: #0b1530 !important;
        }

        body[data-aurora="light"] .e7-notif-title {
            color: #0b1530 !important;
        }

        body[data-aurora="light"] .e7-notif-desc {
            color: #475569 !important;
        }

        body[data-aurora="light"] .e7-notif-item:hover {
            background: rgba(15,23,42,0.05) !important;
        }



        /* ── LIGHT THEME OVERRIDES for the chat panel ── */
        body[data-aurora="light"] .e7-welcome p {
            color: #3c3c3c !important;
        }

        body[data-aurora="light"] .e7-welcome h3 {
            color: #000 !important;
        }

        body[data-aurora="light"] .e7-cat-tab {
            color: #000 !important;
        }

        body[data-aurora="light"] .e7-prompt-btn {
            color: #000 !important;
        }


        body[data-aurora="light"] .e7-prompt-panel {
            background: rgb(232 244 254);
        }

        body[data-aurora="light"] #aiChatPanel .ai-chat-input-area {
            background: rgb(204 240 252) !important;
        }


        body[data-aurora="light"] .e7-input-hint {
            font-size: 10.5px;
            color: rgb(89 152 185);
        }


        body[data-aurora="light"] .alrt-esc-hdr h3 {
            color: #fff !important;
        }


        body[data-aurora="light"] .alrt-maint-hdr h3 {
            color: #fff !important;
        }

        body[data-aurora="light"] .alrt-metrics-hdr h3 {
            color: #fff !important;
        }



        /*        .alrt-esc-hdr*/




        body:not([data-aurora="light"]) #aiChatPanel .ai-chat-input-area {
            background: #000 !important;
        }




        body:not([data-aurora="light"]) .e7-welcome p {
            color: #fff !important;
        }


        body:not([data-aurora="light"]) .e7-welcome h3 {
            color: #fff !important;
        }


        body:not([data-aurora="light"]) .e7-cat-tab {
            color: #fff !important;
        }

        body:not([data-aurora="light"]) .e7-prompt-btn {
            color: #fff !important;
        }
    </style>
    <!-- ═══ END AURORA BRIDGE ═══ -->
</head>

<body id="e7Body">
    <!-- Aurora animated background canvas -->
    <div class="at-canvas" aria-hidden="true"></div>

    <!-- Toast Container -->
    <div class="toast-container" id="toastContainer"></div>

    <!-- Loader -->
    <div id="e7-loader">
        <img src="~/Content/images/FRSLoader.gif" height="80" alt="Loading..." />
    </div>

    <!-- Aurora animated background — lives at body level so it fills viewport -->
    <div class="e7-aurora-bg" id="auroraCanvas" aria-hidden="true"><div class="e7-grain"></div></div>

    <div class="e7-app e7-aurora" id="e7App">

        <!-- ═══════════════════════════════════
             SIDEBAR
        ════════════════════════════════════ -->
        <aside class="e7-sidebar" id="e7Sidebar">
            <!-- Brand -->
            <div class="e7-brand">
                <div class="e7-brand-icon">
                    <i class="fas fa-bolt"></i>
                </div>
                <div class="e7-brand-text">
                    <div class="e7-brand-name">Energy7</div>
                    <div class="e7-brand-tag">RDPMS · V4.2</div>
                </div>
            </div>

            <!-- Navigation — built from server menu data -->
            <nav class="e7-nav" id="e7Nav">
                @{ foreach (var menu in E7FRSAdvance.Utility.ClsHttpContent.FRS25Menus)
                    {
                        if (menu.Childs.Count() == 0)
                        {
                            // ── Leaf item ──
                            bool isActive = ViewBag.Title == menu.Main.MenuName;
                            <a class="e7-nav-item @(isActive ? "active" : "")"
                               href="@Url.Content("~/FRS25/" + menu.Main.ControllerName + "/" + menu.Main.ActionName)">
                                <i class="@menu.Main.IconName"></i>
                                <span>@menu.Main.MenuName</span>
                            </a> }
                        else
                        {
                            // ── Parent with children ──
                            string parentActive = "";
                            foreach (var child in menu.Childs)
                            {
                                if (child.MenuName.Contains(ViewBag.Title))
                                {
                                    parentActive = "active open";
                                    break;
                                }
                            }

                            string subId = "sub_" + menu.Main.MenuName.Replace(" ", "_");
                            bool subOpen = parentActive.Contains("open");

                            <a class="e7-nav-item has-sub @parentActive"
                               onclick="e7ToggleSub('@subId', this)" href="#">
                                <i class="@menu.Main.IconName"></i>
                                <span>@menu.Main.MenuName</span>
                                <i class="fas fa-chevron-right e7-chevron"></i>
                            </a>
                            <div class="e7-submenu @(subOpen ? "open" : "")" id="@subId">
                                @foreach (var child in menu.Childs)
                                {
                                    bool childActive = ViewBag.Title == child.MenuName;
                                    <a class="e7-nav-item @(childActive ? "active" : "")"
                                       href="@Url.Content("~/FRS25/" + child.ControllerName + "/" + child.ActionName)">
                                        <span>@child.MenuName</span>
                                    </a>}
                            </div> }
                    } }
            </nav>

            <!-- Sidebar footer / user card -->
            <div class="e7-sidebar-footer">
                @{
                    var __sidebarUser = E7FRSAdvance.Utility.ClsHttpContent.LoginUser;
                    var __sidebarFirst = (__sidebarUser != null && !string.IsNullOrEmpty(__sidebarUser.FirstName)) ? __sidebarUser.FirstName : "User";
                    var __sidebarRole = (__sidebarUser != null && !string.IsNullOrEmpty(__sidebarUser.RoleName)) ? __sidebarUser.RoleName : "Member";
                    var __sidebarInit = !string.IsNullOrEmpty(__sidebarFirst) ? __sidebarFirst.Substring(0, 1).ToUpper() : "U";
                }
                <a class="e7-sidebar-user" href="@Url.Action("MyProfile","User")" title="View profile">
                    <div class="e7-sidebar-user-avatar">@__sidebarInit</div>
                    <div class="e7-sidebar-user-meta">
                        <div class="e7-sidebar-user-name">@__sidebarFirst</div>
                        <div class="e7-sidebar-user-role">@__sidebarRole</div>
                    </div>
                    <i class="fas fa-chevron-up e7-sidebar-user-caret"></i>
                </a>
            </div>
        </aside>

        <!-- ═══════════════════════════════════
             MAIN AREA
        ════════════════════════════════════ -->
        <div class="e7-main" id="e7Main">

            <!-- Header / Navbar -->
            <header class="e7-header">
                <div class="e7-header-left">
                    <!-- Hamburger (sidebar toggle) -->
                    <button class="e7-menu-toggle" id="e7MenuToggle" title="Toggle sidebar">
                        <i class="fas fa-bars"></i>
                    </button>
                    <span class="e7-header-title">Remote Diagnostic &amp; Predictive Maintenance</span>
                </div>

                <div class="e7-header-right">
                    <!-- Live indicator with clock -->
                    <div class="e7-live-badge" title="System status: Live">
                        <span class="e7-live-dot"></span>
                        <span id="e7LiveTime">--:--:--</span>
                    </div>
                    <!-- Notification Bell -->
                    <div class="e7-notif-wrap" id="e7NotifWrap">
                        <button class="e7-notif-btn" id="e7NotifBtn" title="Alerts">
                            <i class="fas fa-bell"></i>
                            <span class="e7-notif-count" id="e7NotifCount">0</span>
                        </button>

                        <div class="e7-notif-dropdown" id="e7NotifDropdown">
                            <div class="e7-notif-head">
                                <h6>
                                    <i class="fas fa-bell" style="color: var(--aurora-cyan);"></i>
                                    Alerts <span id="e7NotifHeadCount" style="color: rgba(255,255,255,0.45); font-weight: 400;"></span>
                                </h6>
                                <button type="button" class="e7-notif-clear" id="e7NotifClearBtn">Clear all</button>
                            </div>
                            <div class="e7-notif-list" id="e7NotifList">
                                <div class="e7-notif-empty" id="e7NotifEmpty">
                                    <i class="fas fa-bell-slash"></i>
                                    <p>No new alerts</p>
                                </div>
                            </div>
                            <div class="e7-notif-foot">
                                <a href="@Url.Content("~/FRS25/Alerts/Index")">
                                    View all alerts <i class="fas fa-arrow-right" style="font-size: 10px;"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <!-- AI Assistant trigger — distinctive gradient pill -->
                    <button class="e7-ai-btn" id="e7AiHeaderBtn" title="AI Assistant (Alt+C)" onclick="document.getElementById('aiChatTrigger').click()">
                        <span class="e7-ai-btn-orb">
                            <i class="fas fa-robot"></i>
                        </span>
                        <span class="e7-ai-btn-label">Ask AI</span>
                        <span class="e7-ai-btn-dot"></span>
                    </button>

                    <!-- Fullscreen -->
                    <button class="e7-icon-btn" id="e7Fullscreen" title="Fullscreen">
                        <i class="fas fa-expand-arrows-alt"></i>
                    </button>

                    <!-- Dark / Light mode -->
                    <button class="e7-icon-btn e7-theme-toggle" id="toggle-btn" title="Toggle Day / Night">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"
                             viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12.808c-.5 5.347-5.849 9.14-11.107 7.983C-.078 18.6 1.15 3.909 11.11 3 6.395 9.296 14.619 17.462 21 12.808M17 5.5h3M18.5 4v3" />
                        </svg>
                    </button>

                    <!-- Annexure selector (server-rendered) -->
                    <select class="e7-annexure-select" onchange="fnOnChangeAnnexure(this)">
                        @{ var enumlist = (from E7FRSAdvance.Utility.Utility.Annexure e
                                                                           in Enum.GetValues(typeof(E7FRSAdvance.Utility.Utility.Annexure))
