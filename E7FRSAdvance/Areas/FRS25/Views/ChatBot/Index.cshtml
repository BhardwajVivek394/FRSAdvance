                    trend_get: 'Analysing trend…',
                };
                const label = TOOL_LABELS[name] || (String(name || 'Working') + '\u2026');
                el.querySelector('.e7c-tool-slot').innerHTML = '<span class="e7c-tool"><span class="e7c-spin" aria-hidden="true"></span><span>' + esc(label) + '</span></span>';
                scrollDown(false);
            }
            function clearTool(el) { const s = el.querySelector('.e7c-tool-slot'); if (s) s.innerHTML = ''; }
            function showError(el, text) {
                const d = document.createElement('div'); d.className = 'e7c-err'; d.setAttribute('role', 'alert'); d.textContent = text;
                el.querySelector('.e7c-extra').appendChild(d);
            }
            function addActions(el, raw, isLast, stopped) {
                const extra = el.querySelector('.e7c-extra');
                if (stopped) { const n = document.createElement('div'); n.className = 'e7c-note'; n.textContent = 'Stopped before the answer was complete.'; extra.appendChild(n); }
                const row = document.createElement('div'); row.className = 'e7c-actions';
                const cp = document.createElement('button'); cp.type = 'button'; cp.innerHTML = ICON_COPY + '<span>Copy</span>'; cp.setAttribute('aria-label', 'Copy answer');
                cp.addEventListener('click', function () { copyText(raw, cp); }); row.appendChild(cp);
                if (isLast) {
                    const rg = document.createElement('button'); rg.type = 'button'; rg.innerHTML = ICON_RETRY + '<span>Retry</span>'; rg.setAttribute('data-regen', '1'); rg.setAttribute('aria-label', 'Regenerate answer');
                    rg.addEventListener('click', regenerate); row.appendChild(rg);
                }
                extra.appendChild(row);
            }
            function copyText(text, btn) {
                function done() { const lab = btn.querySelector('span') || btn; const t = lab.textContent; lab.textContent = 'Copied'; setTimeout(function () { lab.textContent = t; }, 1400); }
                if (navigator.clipboard && window.isSecureContext) { navigator.clipboard.writeText(text).then(done, fallback); } else { fallback(); }
                function fallback() { const ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); done(); } catch (_) { } ta.remove(); }
            }
            function followUpChips(question, answer) {
                const q = question.toLowerCase();
                const a = answer.toLowerCase();
                const chips = [];

                const assetMatch = question.match(/\b(\d+T\d*|SH\d+|PM\d+|DL\d+|A10\d*)\b/i);
                const asset = assetMatch ? assetMatch[1] : null;

                if (asset) {
                    if (q.includes('tpr') || q.includes('current') || q.includes('live') || q.includes('value')) {
                        chips.push({ label: '📈 History today', prompt: `Show today's history for asset ${asset}` });
                        chips.push({ label: '🚨 Active alerts', prompt: `Show active alerts for asset ${asset}` });
                    }
                    if (q.includes('alert') || a.includes('alert')) {
                        chips.push({ label: '📋 Alert history 7d', prompt: `Show alert history for asset ${asset} over the last 7 days` });
                        chips.push({ label: '📊 Current values', prompt: `Show all current tag values for asset ${asset}` });
                    }
                    if (q.includes('history') || q.includes('reading')) {
                        chips.push({ label: '⏰ Last updated', prompt: `When was asset ${asset} last updated? Show TimestampDevice.` });
                        chips.push({ label: '🛠️ Health summary', prompt: `Give a health summary for asset ${asset}` });
                    }
                } else {
                    if (a.includes('alert') || q.includes('alert')) {
                        chips.push({ label: '📋 All active alerts', prompt: 'Show all active alerts' });
                    }
                    chips.push({
                        label: '🔍 Search asset', prompt: null, action: () => {
                            startCategory('search');
                        }
                    });
                }

                
                return chips;
            }
            function addFollowUps(el, question, answer) {
                const chips = followUpChips(question, answer);
                if (!chips.length) return;
                const row = document.createElement('div'); row.className = 'e7c-follow';
                chips.slice(0, 4).forEach(function (chip) {
                    const b = document.createElement('button'); b.type = 'button'; b.textContent = chip.label;
                    // 1.5.0.0: send once. 1.4 pushed the prompt into the history AND sent it, so it went to the server twice.
                    b.addEventListener('click', function () { if (chip.action) { chip.action(); return; } if (chip.prompt && !isStreaming) { send(chip.prompt); } });
                    row.appendChild(b);
                });
                el.querySelector('.e7c-extra').appendChild(row);
                scrollDown(false);
            }
            function startCategory(id) {
                const cat = PROMPT_CATEGORIES.find(function (c) { return c.id === id; });
                if (cat && cat.prompts.length) { activeCat = id; selectPrompt(cat.prompts[0]); }
            }

            /* ---------- prompts that need an asset or site name ---------- */
            function selectPrompt(p) {
                activePrompt = p;
                askTextEl.innerHTML = '<strong>' + esc(p.label) + '</strong> \u00b7 ' + (p.ask === 'site' ? 'type the site name' : 'type the asset name, e.g. 2T, SH04, PM07');
                askEl.classList.add('on');
                inputEl.placeholder = p.ask === 'site' ? 'Type site name, e.g. Arnetha, Patliputra\u2026' : 'Type asset name, e.g. 2T, 11T, SH04, PM07\u2026';
                inputEl.value = ''; onInput(); inputEl.focus();
            }
            function cancelPrompt() {
                activePrompt = null;
                if (askEl) { askEl.classList.remove('on'); }
                if (inputEl) { inputEl.placeholder = 'How can I help you today?'; }
            }

            /* ---------- send / stream ---------- */
            function clearInput() { inputEl.value = ''; onInput(); }
            function setSendMode() {
                if (isStreaming) { sendBtn.classList.add('stop'); sendBtn.innerHTML = ICON_STOP; sendBtn.setAttribute('aria-label', 'Stop generating'); sendBtn.disabled = false; }
                else { sendBtn.classList.remove('stop'); sendBtn.innerHTML = ICON_SEND; sendBtn.setAttribute('aria-label', 'Send'); sendBtn.disabled = !inputEl.value.trim(); }
            }
            function scheduleRender(el, text) {
                if (rq) return;
                rq = requestAnimationFrame(function () { rq = null; setBotText(el, text, true); scrollDown(false); });
            }
            async function send(textIn, opts) {
                opts = opts || {};
                if (isStreaming) return;
                let text;
                if (opts.regenerate) { text = textIn; }
                else {
                    const raw = (textIn != null ? String(textIn) : inputEl.value).trim();
                    if (!raw) return;
                    if (activePrompt && textIn == null) { text = activePrompt.tpl.replace('{input}', raw); cancelPrompt(); }
                    else {
                        if (isOutOfScope(raw)) {
                            clearInput();
                            if (threadEl.querySelector('.e7c-welcome')) { threadEl.innerHTML = ''; setEmpty(false); }
                            appendUser(raw);
                            const r = appendBot();
                            setBotText(r, 'I am not trained to answer that. I can only assist with EdgeX RDPMS railway monitoring data \u2014 asset values, history, alerts and timestamps.', false);
                            scrollDown(true); return;
                        }
                        text = raw;
                    }
                    clearInput();
                }
                let c = current();
                if (!c) { c = newConvo([]); convos.unshift(c); currentId = c.id; }
                if (!opts.regenerate) { c.messages.push({ role: 'user', content: text }); if (c.messages.length === 1) c.title = titleOf(c.messages); }
                c.updated = Date.now(); saveConvos(); renderList(); titleEl.textContent = c.title;
                if (threadEl.querySelector('.e7c-welcome')) { threadEl.innerHTML = ''; setEmpty(false); }
                threadEl.querySelectorAll('[data-regen]').forEach(function (b) { b.remove(); });
                threadEl.querySelectorAll('.e7c-follow').forEach(function (f) { f.remove(); });
                if (!opts.regenerate) appendUser(text);
                const botEl = appendBot(); botEl.querySelector('.e7c-body').innerHTML = THINKING; scrollDown(true);

                isStreaming = true; controller = new AbortController(); setSendMode(); setStatus('connecting', 'Working\u2026');
                let botText = '', failed = null, stopped = false;
                // the server receives only role + content, exactly as in 1.4
                const payload = c.messages.slice(-MAX_HISTORY * 2).map(function (m) { return { role: m.role, content: m.content }; });
                try {
                    const res = await fetch(CHAT_ENDPOINT, {
                        method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ messages: payload, provider: E7_PROVIDER }), signal: controller.signal
                    });
                    const ct = (res.headers.get('content-type') || '').toLowerCase();
                    // 401, or a redirect to the login page ([Authenticate]) -> the session has ended
                    if (res.status === 401 || res.redirected || ct.indexOf('text/html') >= 0) { failed = 'session'; }
                    else if (!res.ok) { failed = 'The assistant could not answer (server error ' + res.status + '). Please try again.'; }
                    else {
                        const reader = res.body.getReader(), decoder = new TextDecoder();
                        let buf = '';
                        while (true) {
                            const r = await reader.read();
                            if (r.done) break;
                            buf += decoder.decode(r.value, { stream: true });
                            const lines = buf.split('\n'); buf = lines.pop();
                            for (const line of lines) {
                                if (!line.startsWith('data: ')) continue;
                                const raw2 = line.slice(6).trim();
                                if (raw2 === '[DONE]') continue;
                                let evt; try { evt = JSON.parse(raw2); } catch (_) { continue; }
                                if (evt.type === 'text') { botText += evt.text; clearTool(botEl); scheduleRender(botEl, botText); }
                                else if (evt.type === 'tool_use') { setTool(botEl, evt.name); setStatus('connecting', 'Fetching data\u2026'); }
                                else if (evt.type === 'error') { showError(botEl, evt.message || 'Error'); setStatus('error', 'Error'); }
                            }
                        }
                    }
                } catch (err) {
                    if (err && err.name === 'AbortError') stopped = true;
                    else failed = 'Connection error \u2014 please try again.';
                } finally {
                    if (rq) { cancelAnimationFrame(rq); rq = null; }
                    clearTool(botEl);
                    if (failed === 'session') {
                        botEl.querySelector('.e7c-body').innerHTML = '';
                        showError(botEl, 'Your session has ended. Sign in to RDPMS again, then ask your question.');
                        setStatus('error', 'Not signed in');
                    } else {
                        if (botText) {
                            setBotText(botEl, botText, false);
                            const msg = { role: 'assistant', content: botText }; if (stopped) msg.stopped = true;
                            c.messages.push(msg); c.updated = Date.now(); saveConvos(); renderList();
                            addActions(botEl, botText, true, stopped);
                            if (!stopped && !failed) addFollowUps(botEl, text, botText);
                        } else {
                            botEl.querySelector('.e7c-body').innerHTML = '';
                            if (stopped) { const n = document.createElement('div'); n.className = 'e7c-note'; n.textContent = 'Stopped before any answer arrived.'; botEl.querySelector('.e7c-extra').appendChild(n); }
                            else if (!failed && !botEl.querySelector('.e7c-err')) { const n = document.createElement('div'); n.className = 'e7c-note'; n.textContent = 'No answer was returned. Try rephrasing the question.'; botEl.querySelector('.e7c-extra').appendChild(n); }
                        }
                        if (failed) { showError(botEl, failed); setStatus('error', 'Error'); }
                        else if (!botEl.querySelector('.e7c-err')) { setStatus('online', 'Ready'); }
                    }
                    isStreaming = false; controller = null; setSendMode(); scrollDown(false); inputEl.focus();
                }
            }
            function regenerate() {
                const c = current(); if (!c || isStreaming) return;
                if (c.messages.length && c.messages[c.messages.length - 1].role === 'assistant') c.messages.pop();
                let lastUser = null;
                for (let i = c.messages.length - 1; i >= 0; i--) { if (c.messages[i].role === 'user') { lastUser = c.messages[i]; break; } }
                if (!lastUser) return;
                saveConvos();
                const bots = threadEl.querySelectorAll('.e7c-msg.bot'); if (bots.length) bots[bots.length - 1].remove();
                send(lastUser.content, { regenerate: true });
            }

            /* ---------- input ---------- */
            function onInput() {
                inputEl.style.height = 'auto'; inputEl.style.height = Math.min(inputEl.scrollHeight, 200) + 'px';
                countEl.textContent = inputEl.value.length + ' / ' + MAX_CHARS;
                if (!isStreaming) sendBtn.disabled = !inputEl.value.trim();
            }
            function bindEvents() {
                inputEl.addEventListener('input', onInput);
                inputEl.addEventListener('keydown', function (e) { if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); if (!isStreaming) send(); } else if (e.key === 'Escape' && activePrompt) { cancelPrompt(); } });
                sendBtn.addEventListener('click', function () { if (isStreaming) { if (controller) controller.abort(); } else { send(); } });
                document.getElementById('e7cNew').addEventListener('click', newChat);
                document.getElementById('e7cSearch').addEventListener('input', function () { query = this.value.trim(); renderList(); });
                document.getElementById('e7cClear').addEventListener('click', function () {
                    if (isStreaming || !convos.length || !window.confirm('Delete all ' + convos.length + ' chats saved on this computer?')) return;
                    convos = []; currentId = null; saveConvos(); renderList(); renderThread();
                });
                document.getElementById('e7cMenu').addEventListener('click', function () { appEl.classList.toggle('nav-open'); });
                document.getElementById('e7cScrim').addEventListener('click', function () { appEl.classList.remove('nav-open'); });
                document.getElementById('e7cAskCancel').addEventListener('click', function () { cancelPrompt(); inputEl.focus(); });
                listEl.addEventListener('click', function (e) {
                    const o = e.target.closest('[data-open]'); if (o) { openConvo(o.getAttribute('data-open')); return; }
                    const d = e.target.closest('[data-del]'); if (d) { deleteConvo(d.getAttribute('data-del')); }
                });
                function onPick(e) {
                    const cat = e.target.closest('[data-cat]'); if (cat) { activeCat = cat.getAttribute('data-cat'); threadEl.querySelectorAll('[data-cat]').forEach(function (b) { b.setAttribute('aria-pressed', String(b === cat)); }); renderPrompts(); return; }
                    const pr = e.target.closest('[data-prompt]'); if (pr) { const c = PROMPT_CATEGORIES.find(function (x) { return x.id === activeCat; }); if (c) selectPrompt(c.prompts[+pr.getAttribute('data-prompt')]); }
                }
                threadEl.addEventListener('click', onPick);
            }
            function init() {
                mount = document.getElementById('e7ChatBotMount'); if (!mount) return;
                buildHTML(); loadConvos(); bindEvents();
                currentId = null; renderList(); renderThread(); setSendMode(); pingStatus(); inputEl.focus();
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
        })();

</script>
