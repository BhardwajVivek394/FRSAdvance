            /* ---------- chat list ---------- */
            function renderList() {
                const q = query.toLowerCase();
                const items = convos.filter(function (c) { return !q || c.title.toLowerCase().indexOf(q) >= 0 || c.messages.some(function (m) { return String(m.content).toLowerCase().indexOf(q) >= 0; }); });
                if (!items.length) { listEl.innerHTML = '<p class="e7c-empty-list">' + (q ? 'No chat matches your search.' : 'Your chats will appear here.') + '</p>'; return; }
                const d = new Date(); d.setHours(0, 0, 0, 0);
                const t0 = d.getTime(), w0 = t0 - 6 * 864e5;
                const groups = [['Today', function (c) { return c.updated >= t0; }], ['Previous 7 days', function (c) { return c.updated < t0 && c.updated >= w0; }], ['Older', function (c) { return c.updated < w0; }]];
                let html = '';
