@{

    var __userName = E7FRSAdvance.Utility.ClsHttpContent.LoginUser != null
        ? E7FRSAdvance.Utility.ClsHttpContent.LoginUser.FirstName
        : "User";

    // v1.2.1.0: engine picker for site-keeping users and the configured emails only. Decided HERE,
    // in Razor, because the page renders synchronously -- the controller cannot read LoginUser after
    // its first await (the ConfigureAwait(false) trap fixed in AiChat 1.0.160.85).
    var __lu = E7FRSAdvance.Utility.ClsHttpContent.LoginUser;
    var __overrideList = (System.Configuration.ConfigurationManager.AppSettings["SiteKeepingOverrideEmails"] ?? "");
    var __email = (__lu != null && __lu.EmailAddress != null) ? __lu.EmailAddress.Trim() : "";
    // Plain loop rather than .Any() -- this view has no @using System.Linq, and adding one for a
    // single call is a wider change than the check deserves.
    var __privileged = (__lu != null && __lu.IsSiteKeeping);
    if (!__privileged && __email.Length > 0 && __overrideList.Length > 0)
    {
        foreach (var __e in __overrideList.Split(new char[] { ',', ';' }))
        {
            if (string.Equals(__e.Trim(), __email, StringComparison.OrdinalIgnoreCase))
            {
                __privileged = true;
                break;
            }
        }
    }
    var __engineBrand = System.Configuration.ConfigurationManager.AppSettings["AiEngineBrand"] ?? "ENERGY7 ULTRA";
    var __aiDefault = E7.AiCore.AiModelConfig.DefaultEngine("quantum10");   // 1.0.193.0: IsDefault engine from AiModelConfig/GetAllWithKeys

    // 1.5.0.0: chats are stored per RDPMS user on this computer (localStorage key carries the user id).
    var __userKey = (__lu != null) ? __lu.Id.ToString() : "anon";

    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "ChatBot";

}
@* ChatBot UI 1.5.2.0: input always docked at the bottom (greeting + suggestions in the chat area on a new chat);
   full-width chat area (--e7c-col: 100%).
   ChatBot UI 1.5.1.0: Claude-style look -- light sidebar, white chat area, answers without avatar, engine picker
   inside the composer, greeting + composer centred on a new chat; column width in --e7c-col (was 1.5.0.0 below).
   ChatBot UI 1.5.0.0: chat-app layout -- chat list (per user, on this computer), centred reading column, streaming
   answers with Stop / Regenerate / Copy, copy on code blocks, prompt catalogue on a new chat, session-ended message
   when [Authenticate] redirects. Endpoints, request body {messages, provider} and SSE frames are unchanged. Reused
   verbatim from 1.4: scope list, engine picker (privileged only), prompt catalogue, Markdown + plan-card renderers,
   tool labels, follow-up rules. FIX: a follow-up chip no longer sends its question twice. *@
<style>
    /* ================================================================
       ENERGY7 RDPMS AI ASSISTANT -- chat UI 1.5.1.0 (Claude-style layout)
       Light sidebar, white chat area, centred reading column, answers as
       plain text, rounded composer with the engine picker inside it.
       Column width: --e7c-col (100% = full width; e.g. 960px for a centred column).
       Endpoints, request shape and stream frames are unchanged.
       ================================================================ */
    #e7ChatBotMount { --e7c-col:100%; --side:#F7F7F5; --side-line:#E8E6DF; --hover:#EEEDE8; --active:#E7E5DE;
        --bg:#FFFFFF; --ink:#1F1E1D; --mut:#6B6A66; --line:#E6E4DD; --line2:#F0EEE8; --user:#F1F0EB;
        --accent:#1D4FC4; --accent2:#173F9E; --u:#B42318; --uBg:#FDECEA; --s:#8A4B00; --sBg:#FFF1DA; --ok:#0E6B58;
        font:15px/1.6 'IBM Plex Sans',system-ui,-apple-system,"Segoe UI",sans-serif; color:var(--ink); }
    #e7ChatBotMount *, #e7ChatBotMount *::before, #e7ChatBotMount *::after { box-sizing:border-box; }
    #e7ChatBotMount button { font:inherit; cursor:pointer; }
    #e7ChatBotMount input, #e7ChatBotMount textarea, #e7ChatBotMount select { font:inherit; color:inherit; }
    #e7ChatBotMount :focus-visible { outline:2px solid #8FB0F2; outline-offset:2px; }
    .e7c-app { display:grid; grid-template-columns:260px minmax(0,1fr); height:calc(100vh - 96px); min-height:560px; background:var(--bg); border:1px solid var(--line); border-radius:12px; overflow:hidden; }
    /* ---- sidebar ---- */
    .e7c-side { background:var(--side); border-right:1px solid var(--side-line); display:flex; flex-direction:column; min-height:0; }
    .e7c-brand { display:flex; align-items:center; gap:10px; padding:16px 14px 10px; }
    .e7c-logo { width:30px; height:30px; border-radius:8px; background:var(--ink); color:#fff; display:grid; place-items:center; flex:none; }
    .e7c-logo svg { width:15px; height:15px; }
    .e7c-brand b { display:block; font-size:15px; font-weight:600; color:var(--ink); line-height:1.2; }
    .e7c-brand small { display:block; font-size:12px; color:var(--mut); }
    .e7c-new { margin:6px 10px 6px; display:flex; align-items:center; gap:10px; height:38px; padding:0 8px; border-radius:9px; border:0; background:transparent; color:var(--ink); font-size:14px; font-weight:500; text-align:left; }
    .e7c-new:hover { background:var(--hover); }
    .e7c-plus { width:24px; height:24px; border-radius:50%; background:var(--accent); color:#fff; display:grid; place-items:center; font-size:17px; line-height:1; flex:none; }
    .e7c-search { margin:2px 10px 8px; height:34px; border-radius:8px; border:1px solid var(--side-line); background:#fff; padding:0 10px; font-size:13.5px; }
    .e7c-search::placeholder { color:#9A988F; }
    .e7c-list { flex:1; overflow-y:auto; padding:0 8px 8px; min-height:0; }
    .e7c-group { font-size:12px; color:var(--mut); padding:12px 8px 4px; font-weight:500; }
    .e7c-item { display:flex; align-items:center; gap:4px; border-radius:8px; padding:0 4px 0 10px; }
    .e7c-item:hover { background:var(--hover); }
    .e7c-item[aria-current="true"] { background:var(--active); }
    .e7c-item button.e7c-open { flex:1; min-width:0; text-align:left; background:none; border:0; color:var(--ink); padding:7px 0; font-size:13.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .e7c-item button.e7c-del { background:none; border:0; color:var(--mut); width:26px; height:26px; border-radius:6px; visibility:hidden; font-size:15px; line-height:1; }
    .e7c-item:hover button.e7c-del, .e7c-item[aria-current="true"] button.e7c-del, .e7c-item button.e7c-del:focus-visible { visibility:visible; }
    .e7c-item button.e7c-del:hover { background:#DEDCD4; color:var(--ink); }
    .e7c-empty-list { color:var(--mut); font-size:13px; padding:10px; }
    .e7c-foot { border-top:1px solid var(--side-line); padding:10px 12px; display:flex; align-items:center; gap:10px; }
    .e7c-av { width:30px; height:30px; border-radius:50%; background:var(--ink); color:#fff; display:grid; place-items:center; font-weight:600; font-size:13px; }
    .e7c-foot span.e7c-av { flex:none; }
    .e7c-foot span { flex:1; min-width:0; font-size:13.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .e7c-foot button { background:none; border:0; color:var(--mut); font-size:12.5px; padding:4px 6px; border-radius:6px; }
    .e7c-foot button:hover { color:var(--ink); background:var(--hover); }
    /* ---- main ---- */
    .e7c-main { display:flex; flex-direction:column; min-width:0; min-height:0; background:var(--bg); }
    .e7c-head { display:flex; align-items:center; gap:10px; padding:10px 18px; background:var(--bg); }
    .e7c-menu { display:none; background:none; color:var(--ink); border:1px solid var(--line); border-radius:8px; width:34px; height:34px; }
    .e7c-title { flex:1; min-width:0; font-size:14px; font-weight:500; color:var(--ink); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .e7c-status { display:inline-flex; align-items:center; gap:6px; font-size:12px; color:var(--mut); white-space:nowrap; }
    .e7c-status i { width:7px; height:7px; border-radius:50%; background:#B5B3AB; }
    .e7c-status.online i { background:#2E9E6B; } .e7c-status.connecting i { background:#E3A21A; } .e7c-status.error i { background:var(--u); }
    .e7c-scroll { flex:1; overflow-y:auto; min-height:0; background:#FFFFFF; scroll-behavior:smooth; }
    .e7c-thread { max-width:var(--e7c-col); margin:0 auto; padding:18px 32px 12px; display:flex; flex-direction:column; gap:26px; }
    /* messages */
    .e7c-msg { display:flex; }
    .e7c-msg.user { justify-content:flex-end; }
    .e7c-msg.user .e7c-bubble { background:var(--user); border-radius:18px; padding:10px 16px; max-width:82%; white-space:pre-wrap; word-wrap:break-word; }
    .e7c-answer { flex:1; min-width:0; }
    .e7c-body { word-wrap:break-word; overflow-wrap:anywhere; line-height:1.7; }
    .e7c-body p { margin:0 0 .75em; }
    .e7c-body .md-h { font-size:16px; margin:1.1em 0 .4em; font-weight:600; }
    .e7c-body h2.md-h { font-size:17px; }
    .e7c-body .md-list { margin:.3em 0 .8em; padding-left:1.4em; }
    .e7c-body .md-list li { margin:.2em 0; }
    .e7c-body .md-hr { border:0; border-top:1px solid var(--line); margin:14px 0; }
    .e7c-body .md-q { border-left:3px solid var(--line); margin:.5em 0; padding:2px 12px; color:var(--mut); }
    .e7c-body code { font-family:'IBM Plex Mono',ui-monospace,Consolas,monospace; font-size:13px; background:#F5F4EF; border:1px solid var(--line2); border-radius:5px; padding:1px 5px; }
    .e7c-body pre { position:relative; background:#F7F6F2; color:var(--ink); border:1px solid var(--line); border-radius:10px; padding:14px 14px 12px; overflow-x:auto; margin:.7em 0; }
    .e7c-body pre code { background:none; border:0; padding:0; color:inherit; font-size:13px; }
    .e7c-body table { border-collapse:collapse; width:100% !important; margin:.7em 0 !important; font-size:14px !important; display:block; overflow-x:auto; }
    .e7c-body th { background:#F7F6F2; text-align:left; font-weight:600; }
    .e7c-body th, .e7c-body td { border:1px solid var(--line) !important; padding:7px 10px !important; }
    .e7c-codecopy { position:absolute; top:7px; right:7px; background:#fff; color:var(--mut); border:1px solid var(--line); border-radius:6px; font-size:12px; padding:2px 8px; }
    .e7c-codecopy:hover { color:var(--ink); }
    .e7c-caret { display:inline-block; width:8px; height:16px; background:var(--ink); vertical-align:-3px; margin-left:2px; border-radius:1px; animation:e7cBlink 1s steps(2) infinite; }
    .e7c-tool { display:inline-flex; align-items:center; gap:8px; font-size:13px; color:var(--mut); margin:2px 0 8px; }
    .e7c-spin { width:12px; height:12px; border:2px solid #D9D7CF; border-top-color:var(--ink); border-radius:50%; animation:e7cSpin .8s linear infinite; }
    .e7c-thinking { display:inline-flex; gap:5px; padding:8px 0; }
    .e7c-thinking i { width:7px; height:7px; border-radius:50%; background:#B5B3AB; animation:e7cDot 1.2s ease-in-out infinite; }
    .e7c-thinking i:nth-child(2) { animation-delay:.15s; } .e7c-thinking i:nth-child(3) { animation-delay:.3s; }
    .e7c-note { font-size:13px; color:var(--mut); margin-top:6px; }
    .e7c-err { background:var(--uBg); color:var(--u); border-radius:10px; padding:9px 13px; font-size:14px; margin-top:6px; }
    .e7c-actions { display:flex; gap:2px; margin-top:4px; }
    .e7c-actions button { display:inline-flex; align-items:center; gap:5px; background:none; border:0; color:var(--mut); font-size:12.5px; padding:4px 8px; border-radius:6px; }
    .e7c-actions button svg { width:14px; height:14px; }
    .e7c-actions button:hover { background:var(--hover); color:var(--ink); }
    .e7c-follow { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
    .e7c-follow button { border:1px solid var(--line); background:#fff; color:var(--ink); border-radius:999px; padding:6px 13px; font-size:13px; }
    .e7c-follow button:hover { background:var(--hover); }
    /* plan cards ([[CARD]] blocks from the server) */
    .e7c-body .plan-card { border:1px solid var(--line); border-radius:12px; margin:.7em 0; overflow:hidden; background:#fff; }
    .e7c-body .pc-head { display:flex; flex-wrap:wrap; gap:8px; align-items:center; padding:9px 13px; background:#F7F6F2; border-bottom:1px solid var(--line2); }
    .e7c-body .pc-pill { font-size:11px; font-weight:600; border-radius:999px; padding:2px 8px; background:#E2EAFD; color:var(--accent); }
    .e7c-body .plan-card.urgent .pc-pill { background:var(--uBg); color:var(--u); } .e7c-body .plan-card.soon .pc-pill { background:var(--sBg); color:var(--s); }
    .e7c-body .pc-asset { font-family:'IBM Plex Mono',ui-monospace,Consolas,monospace; font-weight:600; }
    .e7c-body .pc-sub { color:var(--mut); font-size:12.5px; }
    .e7c-body .pc-body { padding:6px 13px 10px; }
    .e7c-body .pc-row { display:grid; grid-template-columns:150px minmax(0,1fr); gap:10px; padding:5px 0; border-bottom:1px dashed var(--line2); font-size:14px; }
    .e7c-body .pc-row:last-child { border-bottom:0; }
    .e7c-body .pc-k { color:var(--mut); }
    .e7c-body .pc-action .pc-v { font-weight:600; }
    /* composer */
    .e7c-compose { padding:6px 32px 14px; background:var(--bg); border-top:1px solid var(--line2); }
    .e7c-compose-in { max-width:var(--e7c-col); margin:0 auto; }
    .e7c-ask { display:none; align-items:center; justify-content:space-between; gap:10px; font-size:13px; background:#F1F4FC; color:#1C3A86; border:1px solid #D6DFF6; border-radius:14px 14px 0 0; border-bottom:0; padding:7px 14px; margin:0 12px; }
    .e7c-ask.on { display:flex; }
    .e7c-ask button { background:none; border:0; color:#1C3A86; font-weight:600; font-size:13px; }
    .e7c-box { background:#fff; border:1px solid #DDDBD3; border-radius:20px; padding:12px 12px 10px 16px; box-shadow:0 2px 10px rgba(31,30,29,.06); transition:border-color .15s, box-shadow .15s; }
    .e7c-box:focus-within { border-color:#C7C4BA; box-shadow:0 2px 14px rgba(31,30,29,.09); }
    .e7c-box textarea { display:block; width:100%; border:0; resize:none; outline:0; background:transparent; min-height:26px; max-height:220px; padding:2px 0 6px; line-height:1.55; }
    #e7ChatBotMount .e7c-box textarea:focus-visible { outline:none; }
    .e7c-box-row { display:flex; align-items:center; gap:10px; }
    .e7c-box-tools { flex:1; min-width:0; display:flex; align-items:center; gap:8px; }
    .e7c-box-tools select { font-size:13px; height:32px; border:1px solid var(--line); border-radius:8px; background:#fff; padding:0 8px; max-width:240px; margin-left:0 !important; color:var(--ink); }
    .e7c-engine { font-size:12.5px; color:var(--mut); border:1px solid var(--line); border-radius:8px; padding:5px 10px; white-space:nowrap; }
    .e7c-count { font-size:12px; color:#9A988F; white-space:nowrap; }
    .e7c-send { width:34px; height:34px; border-radius:10px; border:0; background:var(--accent); color:#fff; display:grid; place-items:center; flex:none; }
    .e7c-send:hover { background:var(--accent2); }
    .e7c-send:disabled { background:#C9D3EA; cursor:default; }
    .e7c-send.stop { background:var(--ink); }
    .e7c-send svg { width:16px; height:16px; }
    .e7c-hint { text-align:center; font-size:12px; color:var(--mut); margin-top:8px; }
    /* new chat: greeting and suggestions in the chat area; the input stays at the bottom */
    .e7c-main.is-empty .e7c-thread { min-height:100%; justify-content:center; }
    .e7c-main.is-empty .e7c-compose { border-top-color:transparent; }
    .e7c-welcome { text-align:center; padding:8px 0; }
    .e7c-wlogo { width:40px; height:40px; border-radius:11px; background:var(--ink); color:#fff; display:inline-grid; place-items:center; margin-bottom:12px; }
    .e7c-wlogo svg { width:20px; height:20px; }
    .e7c-welcome h2 { font-size:30px; font-weight:500; margin:0 0 6px; letter-spacing:-.01em; color:var(--ink); }
    .e7c-welcome p { color:var(--mut); margin:0; }
    .e7c-suggest { margin:22px auto 0; max-width:1100px; width:100%; }
    .e7c-cats { display:flex; flex-wrap:wrap; justify-content:center; gap:8px; margin-bottom:14px; }
    .e7c-cats button { border:1px solid var(--line); background:#fff; color:var(--ink); border-radius:999px; padding:6px 14px; font-size:13.5px; }
    .e7c-cats button:hover { background:var(--hover); }
    .e7c-cats button[aria-pressed="true"] { background:var(--ink); border-color:var(--ink); color:#fff; }
    .e7c-prompts { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:8px; }
    .e7c-prompts button { text-align:left; border:1px solid var(--line); background:#fff; color:var(--ink); border-radius:12px; padding:10px 14px; font-size:14px; line-height:1.35; }
    .e7c-prompts button:hover { background:#FAFAF8; border-color:#D3D0C6; }
    .e7c-prompts button small { display:block; color:var(--mut); font-size:12.5px; margin-top:3px; }
    .e7c-scrim { display:none; }
    .e7c-main { position:relative; }
    @@keyframes e7cSpin { to { transform:rotate(360deg); } }
    @@keyframes e7cBlink { 50% { opacity:0; } }
    @@keyframes e7cDot { 0%,80%,100% { transform:translateY(0); opacity:.5; } 40% { transform:translateY(-4px); opacity:1; } }
    @@media (max-width: 860px) {
        .e7c-app { grid-template-columns:1fr; height:calc(100vh - 80px); position:relative; }
        .e7c-side { position:absolute; inset:0 auto 0 0; width:min(300px,86%); z-index:30; transform:translateX(-100%); transition:transform .18s ease; }
        .e7c-app.nav-open .e7c-side { transform:none; }
        .e7c-app.nav-open .e7c-scrim { display:block; position:absolute; inset:0; background:rgba(20,20,18,.35); z-index:25; }
        .e7c-menu { display:inline-grid; place-items:center; }
        .e7c-thread { padding:14px 14px 8px; }
        .e7c-compose { padding:6px 10px 10px; }
        .e7c-msg.user .e7c-bubble { max-width:90%; }
        .e7c-welcome h2 { font-size:24px; }
        .e7c-body .pc-row { grid-template-columns:1fr; gap:0; }
        .e7c-count { display:none; }
    }
    @@media (prefers-reduced-motion: reduce) { #e7ChatBotMount * { animation:none !important; transition:none !important; scroll-behavior:auto !important; } }
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght%40400;500;600;700&family=IBM+Plex+Mono:wght%40500&display=swap">
<!-- Hidden markers read by the chat app: display name and the per-user storage key -->
<span class="e7-user-name" style="display:none">@__userName</span>
<span class="e7-user-key" style="display:none">@__userKey</span>
<div id="e7ChatBotMount"></div>
<script>
        (function () {
            'use strict';

            // ChatBot UI 1.5.0.0 -- chat app. Endpoints, request body {messages, provider} and the SSE frames
            // (text / tool_use / error, then [DONE]) are exactly as in 1.4.x; only the interface changed.
            const CHAT_ENDPOINT = '@Url.Action("Chat", "ChatBot", new { area = "FRS25" })';
            const STATUS_ENDPOINT = '@Url.Action("Status", "ChatBot", new { area = "FRS25" })';
            const MAX_HISTORY = 20;       // turns sent to the server per request (x2 messages), unchanged
            const MAX_CONVOS = 30;        // chats kept on this computer, per RDPMS user
            const MAX_CHARS = 500;

            const OUT_OF_SCOPE = [
                'weather', 'recipe', 'cook', 'poem', 'joke', 'capital of',
                'javascript', 'python', '2+2', 'math', 'history of india',
                'news', 'stock', 'bitcoin', 'translate', 'who is', 'president',
                'cricket', 'football', 'movie', 'song', 'write a story',
                'write an essay', 'email', 'time in'
            ];
            function isOutOfScope(text) {
                const l = text.toLowerCase();
                return OUT_OF_SCOPE.some(k => l.includes(k));
            }

            var E7_BRAND = "@__engineBrand";
            var E7_PROVIDER = @Html.Raw(E7.AiCore.AiModelConfig.JsString(__aiDefault));   // 1.0.193.0: IsDefault engine
            var E7_ENGINE_PICKER = "";
@if (__privileged)
{
    <text>
            var E7_ENGINES = @Html.Raw(E7.AiCore.AiModelConfig.EngineListJson());   // 1.0.193.0: AiModelConfig/GetAllWithKeys (id + label only, no keys)
            // A saved id is honoured only if it is still in the list; anything else (including an
            // id from a page cached before this release) is discarded and the default applies.
            try {
                var _saved = sessionStorage.getItem("e7ChatEngine");
                if (_saved) {
                    for (var _i = 0; _i < E7_ENGINES.length; _i++) {
                        if (E7_ENGINES[_i].id === _saved) { E7_PROVIDER = _saved; break; }
                    }
                }
            } catch (e) { }

            E7_ENGINE_PICKER =
                '<select id="e7EngineSel" aria-label="Model" ' +
                'style="margin-left:auto;font:inherit;font-size:12px;padding:5px 9px;border-radius:7px;' +
                'border:1px solid #cfd6de;background:#fff;color:#253041;max-width:210px;">' +
                E7_ENGINES.map(function (m) {
                    return '<option value="' + m.id + '"' +
                        (m.id === E7_PROVIDER ? ' selected' : '') + '>' + m.label + '</option>';
                }).join("") + '</select>';

            document.addEventListener("change", function (ev) {
                var t = ev.target;
                if (!t || t.id !== "e7EngineSel") { return; }
                E7_PROVIDER = t.value;
                try { sessionStorage.setItem("e7ChatEngine", E7_PROVIDER); } catch (e) { }
            });
    </text>
}

            const PROMPT_CATEGORIES = [
                {
                    id: 'alerts',
                    icon: '🚨',
