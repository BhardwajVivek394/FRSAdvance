                    '  <nav class="e7c-list" id="e7cList" aria-label="Chat history"></nav>' +
                    '  <div class="e7c-foot"><span class="e7c-av" aria-hidden="true">' + esc(USER_NAME.charAt(0).toUpperCase()) + '</span><span>' + esc(USER_NAME) + '</span><button type="button" id="e7cClear" title="Delete all chats saved on this computer">Clear all</button></div>' +
                    ' </aside>' +
                    ' <div class="e7c-scrim" id="e7cScrim"></div>' +
                    ' <main class="e7c-main" id="e7cMain">' +
                    '  <header class="e7c-head"><button type="button" class="e7c-menu" id="e7cMenu" aria-label="Show chats">&#9776;</button><div class="e7c-title" id="e7cTitle">New chat</div>' +
                    '   <span class="e7c-status" id="e7cStatus"><i></i><span>Connecting\u2026</span></span></header>' +
