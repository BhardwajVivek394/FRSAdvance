                    label: 'Health',
                    prompts: [
                        { label: 'Health summary — asset', ask: 'asset', tpl: 'Give a health summary for asset {input}' },
                        { label: 'Health index score', ask: 'asset', tpl: 'What is the health index score for asset {input}?' },
                        { label: 'Leakage current', ask: 'asset', tpl: 'What is the leakage current for asset {input}?' },
                        { label: 'Choke resistance', ask: 'asset', tpl: 'What is the choke resistance for asset {input}?' },
                    ]
                },
            ];

            const CARD_FIELDS = { '15-DAY': '15-day record', 'ML': 'Model classification', 'LASTOP': 'Last operation', 'ACTION': 'Action', 'NOTE': 'Note' };

            const USER_NAME = ((document.querySelector('.e7-user-name') || {}).textContent || 'User').trim() || 'User';
            const USER_KEY = ((document.querySelector('.e7-user-key') || {}).textContent || 'anon').trim() || 'anon';
            // Chats are kept per RDPMS user, so two people sharing one office PC never see each other's chats.
            const STORE = 'e7ai_convos_v2_' + USER_KEY;
            const BOLT = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>';
            const ICON_SEND = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>';
            const ICON_STOP = '<svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>';
            const ICON_COPY = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>';
            const ICON_RETRY = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/></svg>';
            const THINKING = '<span class="e7c-thinking" aria-label="Thinking"><i></i><i></i><i></i></span>';

            let convos = [], currentId = null, isStreaming = false, controller = null, activePrompt = null, activeCat = PROMPT_CATEGORIES[0].id, query = '', rq = null;
            let mount, appEl, listEl, threadEl, scrollEl, inputEl, sendBtn, titleEl, statusEl, askEl, askTextEl, countEl, mainEl;

            function esc(s) {
                return String(s)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }

            function renderPlanCards(raw, stash) {
                if (!raw || raw.indexOf('[[CARD]]') < 0) return raw;
                return raw.replace(/\[\[CARD\]\]([\s\S]*?)\[\[\/CARD\]\]/g, function (_, body) {
                    const lines = body.split('\n').map(function (l) { return l.replace(/^\s*[-*\u2022]\s?/, '').trim(); }).filter(function (l) { return l.length; });
                    if (!lines.length) return '';
                    const head = {};
                    lines[0].split('|').forEach(function (p) {
                        const kv = p.split('=');
                        if (kv.length >= 2) head[kv[0].trim().toLowerCase()] = kv.slice(1).join('=').trim();
                    });
                    const pr = (head.priority || 'MONITOR').toUpperCase();
                    const cls = pr.indexOf('URGENT') >= 0 ? 'urgent' : (pr.indexOf('INSPECT') >= 0 ? 'soon' : 'monitor');
                    let rows = '';
                    for (let i = 1; i < lines.length; i++) {
                        const c = lines[i].indexOf(':');
                        if (c < 0) { rows += '<div class="pc-row"><div class="pc-v">' + esc(lines[i]) + '</div></div>'; continue; }
                        const key = lines[i].substring(0, c).trim().toUpperCase();
                        const val = lines[i].substring(c + 1).trim();
                        const label = CARD_FIELDS[key] || (key.charAt(0) + key.slice(1).toLowerCase());
                        const extra = (key === 'NOTE') ? ' pc-note' : (key === 'ACTION' ? ' pc-action' : '');
                        rows += '<div class="pc-row' + extra + '"><div class="pc-k">' + esc(label) + '</div><div class="pc-v">' + esc(val) + '</div></div>';
                    }
                    const sub = [head.type, head.site].filter(Boolean).map(esc).join(' &middot; ');
                    const html = '<div class="plan-card ' + cls + '">'
                        + '<div class="pc-head"><span class="pc-pill">' + esc(pr) + '</span>'
                        + '<span class="pc-asset">' + esc(head.asset || 'Asset') + '</span>'
                        + (sub ? '<span class="pc-sub">' + sub + '</span>' : '') + '</div>'
                        + '<div class="pc-body">' + rows + '</div></div>';
                    stash.push(html);
                    return '\n\u0000CARD' + (stash.length - 1) + '\u0000\n';
                });
            }

            function renderMarkdown(raw) {
                if (!raw) return '';
                const fpText = fpDecorateText(raw);   // 1.6.0.0 (merge, from ChatBotNew): plan marker and asset chips
                raw = fpText.raw;
                const cardStash = [];
                raw = renderPlanCards(String(raw), cardStash);
                let h = String(raw)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                h = h.replace(/```[\w]*\n?([\s\S]*?)```/g,
                    (_, c) => '<pre><code>' + c.trim() + '</code></pre>');
                h = h.replace(/`([^`\n]+)`/g, '<code>$1</code>');
                // headings BEFORE bold, so "## **Verdict**" still resolves both
                h = h.replace(/^\s{0,3}####\s+(.+?)\s*#*$/gm, '<h4 class="md-h">$1</h4>');
                h = h.replace(/^\s{0,3}###\s+(.+?)\s*#*$/gm, '<h3 class="md-h">$1</h3>');
                h = h.replace(/^\s{0,3}##\s+(.+?)\s*#*$/gm, '<h2 class="md-h">$1</h2>');
                h = h.replace(/^\s{0,3}#\s+(.+?)\s*#*$/gm, '<h2 class="md-h">$1</h2>');
                h = h.replace(/^\s*(?:---|\*\*\*|___)\s*$/gm, '<hr class="md-hr">');
                h = h.replace(/^\s*&gt;\s+(.+)$/gm, '<blockquote class="md-q">$1</blockquote>');
                h = h.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
                h = h.replace(/\*([^*\n]+)\*/g, '<em>$1</em>');
                h = h.replace(/((\|[^\n]+\|\n?)+)/g, function (m) {
                    const rows = m.trim().split('\n').filter(r => r.trim());
                    if (rows.length < 2) return m;
                    let t = '<table style="border-collapse:collapse;font-size:12px;margin:6px 0;width:100%">';
                    rows.forEach((row, i) => {
                        if (/^\|[\s\-:|]+\|$/.test(row.trim())) return;
                        const cells = row.split('|').filter((c, ci, a) => ci > 0 && ci < a.length - 1);
                        const tag = i === 0 ? 'th' : 'td';
                        t += '<tr>' + cells.map(c =>
                            `<${tag} style="border:1px solid rgba(15,23,42,.10);padding:4px 8px">${c.trim()}</${tag}>`
                        ).join('') + '</tr>';
                    });
                    return t + '</table>';
                });
                // ordered list first, tagged so it can be wrapped in <ol> rather than <ul>
                h = h.replace(/^\s*\d+[.)] (.+)$/gm, '<li data-ol="1">$1</li>');
                h = h.replace(/^\s*[\u2022\-\*] (.+)$/gm, '<li>$1</li>');
                // 1.5.0.0: group ordered and bullet items separately -- 1.4 merged a numbered list and the
                // bullet list after it into one numbered list.
                h = h.replace(/(?:<li data-ol="1">[\s\S]*?<\/li>\n?)+/g, function (m) {
                    return '<ol class="md-list">' + m.replace(/ data-ol="1"/g, ' class="md-oli"').replace(/\n/g, '') + '</ol>';
                });
                h = h.replace(/(?:<li>[\s\S]*?<\/li>\n?)+/g, function (m) {
                    return '<ul class="md-list">' + m.replace(/\n/g, '') + '</ul>';
                });
                // only NEWLINES BETWEEN INLINE TEXT become <br>; a newline that merely sits beside
                // block markup would otherwise render as an empty line.
                h = h.replace(/\n{2,}/g, '\n');
                h = h.replace(/\n(?!\s*<\/?(?:h2|h3|h4|ul|ol|li|pre|table|tr|hr|blockquote))/g, '<br>');
                h = h.replace(/\n/g, '');
                h = h.replace(/(<br>\s*)+(<(?:h2|h3|h4|ul|ol|pre|table|hr|blockquote))/g, '$2');
                h = h.replace(/(<\/(?:h2|h3|h4|ul|ol|pre|table|blockquote)>)(\s*<br>)+/g, '$1');
                if (cardStash.length) {
                    h = h.replace(/(<br>\s*)*\u0000CARD(\d+)\u0000(\s*<br>)*/g, function (_, a, idx) { return cardStash[Number(idx)] || ''; });
                }
                return fpText.prefix + fpAssetChips(h);
            }

            /* 1.6.0.0 (merge): copied from ChatBotNew Index.cshtml (v1.3.0.0 fast maintenance plan). */
            /* ==========================================================
               v1.3.0.0 FAST MAINTENANCE PLAN -- renderer for the SSE "plan" event.
               The plan is computed on the server (E7.AiCore); this code only draws it.
               All text goes through esc(); the page stays pure ASCII (\u escapes).
            ========================================================== */
            const FP_WORKSHEET = '@Url.Action("Worksheet", "MaintenceRoster", new { area = "FRS25" })';
            const FP = { seq: 0, plans: {}, names: {}, rendered: {} };
            const FP_PR = {
                URGENT: { label: 'Urgent', cls: 'u' },
                INSPECT_SOON: { label: 'Inspect soon', cls: 's' },
                MONITOR: { label: 'Monitor', cls: 'm' }
            };
            const FP_FAMS = ['TC', 'PM', 'SG', 'IPS'];
            const FP_FAM_LABEL = { TC: 'Track circuits', PM: 'Point machines', SG: 'Signals', IPS: 'IPS' };
            const FP_SUBS = {
                TC: [['cond', 'Leakage & condition'], ['avg', 'Average insight'], ['alerts', 'Alert info'], ['events', 'Major events']],
                PM: [['cls', 'Model classification'], ['last', 'Last operation'], ['avg', 'Average insight'], ['alerts', 'Alert info']],
                SG: [['lamp', 'Lamp & ECR'], ['alerts', 'Alert info']],
                IPS: [['avg', 'Average insight'], ['alerts', 'Alert info']]
            };
            const FP_RISING = {
                i_run: 'running current',
                end_rise: 'end-of-stroke current',
                work: 'effort per throw',
                i_trough: 'mid-stroke current dip'
            };
            const FP_LOCS = [
                ['FeedSide', 'Feed side', 'Feed current only'],
                ['GluedJoint', 'Glued joint', 'Both currents move'],
                ['SleeperBallast', 'Sleeper / ballast', 'Spread along section'],
                ['RelaySide', 'Relay side', 'Relay current only'],
                ['ExternalShorting', 'External shorting', 'Object across rails']
            ];
            const FP_DOT = ' \u00b7 ';

            // Builds an SVG text element without spelling its tag name in the page: Razor treats that
            // bare tag name specially inside code blocks, so it never appears literally here.
            function fpSvgText(x, y, cls, anchor, content) {
                const tag = 'te' + 'xt';
                return '<' + tag + ' x="' + x + '" y="' + y + '"' + (anchor ? ' text-anchor="' + anchor + '"' : '') + ' class="' + cls + '">' + content + '</' + tag + '>';
            }

            function fpNum(v, d) {
                if (v === null || v === undefined || isNaN(Number(v))) {
                    return '\u2014';
                }
                return Number(v).toFixed(d === undefined ? 0 : d);
            }

            function fpTime(iso) {
                if (!iso) {
                    return '';
                }
                const m = String(iso).match(/T?(\d{2}):(\d{2})/);
                return m ? m[1] + ':' + m[2] : String(iso);
            }

            function fpPill(priority) {
                const p = FP_PR[priority] || { label: 'Healthy', cls: 'ok' };
                return '<span class="fp-pill fp-' + p.cls + '">' + p.label + '</span>';
            }

            function fpFit(plan, hours) {
                const total = hours * 60;
                const setup = plan.timeBudget ? plan.timeBudget.setupMinutes || 0 : 0;
                let left = total - setup;
                const inPlan = [];
                const later = [];
                plan.assets.forEach(function (a) {
                    if (a.minutes <= left) {
                        inPlan.push(a);
                        left -= a.minutes;
                    } else {
                        later.push(a);
                    }
                });
                return { inPlan: inPlan, later: later, left: Math.max(0, left), setup: setup, total: total };
            }

            // 1.6.0.0 (merge): ChatBotNew appended its own message row; here the plan is drawn inside the
            // answer's own element (above .e7c-body), so the explanation streams directly below the cards,
            // and the same function redraws a plan saved with the chat.
            function appendPlanMsg(plan, botEl) {
                if (!plan || !plan.site || !Array.isArray(plan.assets) || !botEl) {
                    return;
                }
                const id = 'fp' + (++FP.seq);
                const first = plan.assets.length ? plan.assets[0].key : null;
                const state = { plan: plan, hours: plan.hours || 4, fam: 'all', open: {}, sub: {} };
                if (first) {
                    state.open[first] = true;
                }
                FP.plans[id] = state;
                FP.rendered[String(plan.site.id)] = true;
                plan.assets.forEach(function (a) {
                    FP.names[a.key] = a.name;
                });

                const host = document.createElement('div');
                host.className = 'fp-plan';
                host.id = id;
                const answer = botEl.querySelector('.e7c-answer');
                const body = botEl.querySelector('.e7c-body');
                answer.insertBefore(host, body);
                fpRender(id);
                scrollDown(false);
            }


            function fpRender(id) {
                const host = document.getElementById(id);
                const st = FP.plans[id];
                if (!host || !st) {
                    return;
                }
                host.innerHTML = fpHeader(id, st) + fpBudget(id, st) + fpFamilies(id, st) + fpCards(id, st) + fpFooter(id, st);
            }

            function fpHeader(id, st) {
                const p = st.plan;
                const name = p.site.name + (p.site.code ? ' (' + p.site.code + ')' : '');
                const src = p.source || {};
                const from = src.rosterRunAt ? 'From roster run ' + fpTime(src.rosterRunAt) + ' + live check ' + fpTime(src.liveCheckAt) : 'From alerts and live models ' + fpTime(src.liveCheckAt);
                const hoursOpts = [2, 4, 6, 8].concat([2, 4, 6, 8].indexOf(st.hours) < 0 ? [st.hours] : []).sort(function (a, b) { return a - b; });
                let partial = '';
                if (Array.isArray(src.partial) && src.partial.length) {
                    partial = '<div class="fp-partial"><b>Some data could not be read.</b> ' + src.partial.map(esc).join(FP_DOT) + '</div>';
                }
                return '<div class="fp-head">'
                    + '<div class="fp-head-top"><div><h3 class="fp-title">' + esc(name) + FP_DOT + st.hours + '-hour maintenance plan</h3>'
                    + '<p class="fp-headline">' + esc(p.headline || '') + '</p></div>'
                    + '<div class="fp-chips"><span class="fp-chip"><i></i>Plan ready in ' + fpNum((src.buildMs || 0) / 1000, 1) + ' s</span>'
                    + '<span class="fp-chip fp-chip-plain">' + esc(from) + '</span></div></div>'
                    + partial
                    + '<div class="fp-ctrls"><label for="' + id + '-hrs">Time on site</label>'
                    + '<select id="' + id + '-hrs" data-fp-hours="' + id + '">'
                    + hoursOpts.map(function (h) { return '<option value="' + h + '"' + (h === st.hours ? ' selected' : '') + '>' + h + ' hours</option>'; }).join('')
                    + '</select></div></div>';
            }

            function fpBudget(id, st) {
                const p = st.plan;
                const f = fpFit(p, st.hours);
                if (!p.assets.length) {
                    return '';
                }
                let bar = '<span class="fp-b-x" style="width:' + (100 * f.setup / f.total) + '%" title="' + esc(p.timeBudget.setupLabel || 'Setup') + '">Setup</span>';
                f.inPlan.forEach(function (a) {
                    const c = (FP_PR[a.priority] || { cls: 'm' }).cls;
                    bar += '<span class="fp-b-' + c + '" style="width:' + (100 * a.minutes / f.total) + '%" title="' + esc(a.name) + FP_DOT + a.minutes + ' min">' + esc(a.name) + '</span>';
                });
                if (f.left > 0) {
                    bar += '<span class="fp-b-buf" style="width:' + (100 * f.left / f.total) + '%">Buffer</span>';
                }
                let n = 1;
                let order = '<li><span class="fp-n">' + (n++) + '</span><span>' + esc(p.timeBudget.setupLabel || 'Setup') + '</span><span class="fp-mut">' + f.setup + ' min</span></li>';
                f.inPlan.forEach(function (a) {
                    order += '<li><span class="fp-n">' + (n++) + '</span><span><button type="button" class="fp-linkbtn" data-fp-jump="' + esc(a.key) + '">' + esc(a.name) + '</button>' + FP_DOT + esc((a.subtitle || '').toLowerCase()) + '</span><span class="fp-mut">' + a.minutes + ' min</span></li>';
                });
                f.later.forEach(function (a) {
                    order += '<li class="fp-later"><span class="fp-n">\u2013</span><span><button type="button" class="fp-linkbtn" data-fp-jump="' + esc(a.key) + '">' + esc(a.name) + '</button>' + FP_DOT + 'next visit</span><span class="fp-mut">' + a.minutes + ' min</span></li>';
                });
                const used = f.total - f.left;
                return '<div class="fp-budget" aria-label="Time budget"><div class="fp-bar">' + bar + '</div>'
                    + '<div class="fp-blegend"><span>' + used + ' of ' + f.total + ' min planned</span><span>'
                    + (f.later.length ? f.later.length + ' item(s) for the next visit' : f.left + ' min buffer for travel or a surprise') + '</span></div>'
                    + '<ol class="fp-order">' + order + '</ol></div>';
            }

            function fpFamilies(id, st) {
                const fams = (st.plan.families || []).filter(function (f) { return FP_FAMS.indexOf(f.family) >= 0; });
                if (!fams.length) {
                    return '';
                }
                return '<div class="fp-fams" role="group" aria-label="Asset family">' + fams.map(function (f) {
                    const cards = st.plan.assets.filter(function (a) { return a.family === f.family; });
                    const sq = cards.map(function (a) { return '<span class="fp-sq fp-sq-' + ((FP_PR[a.priority] || { cls: 'ok' }).cls) + '" title="' + esc(a.name) + '"></span>'; }).join('')
                        + (f.healthy || []).map(function (n) { return '<span class="fp-sq fp-sq-ok" title="' + esc(n) + ' (healthy)"></span>'; }).join('');
                    const pills = (f.urgent ? '<span class="fp-pill fp-u">' + f.urgent + ' urgent</span>' : '')
                        + (f.soon ? '<span class="fp-pill fp-s">' + f.soon + ' soon</span>' : '')
                        + (f.monitor ? '<span class="fp-pill fp-m">' + f.monitor + ' monitor</span>' : '')
                        + '<span class="fp-pill fp-ok">' + (f.healthy || []).length + ' healthy</span>';
                    return '<button type="button" class="fp-fam" data-fp-fam="' + id + '|' + f.family + '" aria-pressed="' + (st.fam === f.family) + '">'
                        + '<span class="fp-fam-h"><b>' + esc(f.label || FP_FAM_LABEL[f.family]) + '</b><span>' + (f.total || 0) + ' assets</span></span>'
                        + '<span class="fp-pills">' + pills + '</span><span class="fp-squares" aria-hidden="true">' + sq + '</span></button>';
                }).join('') + '</div>';
            }

            function fpCards(id, st) {
                const p = st.plan;
                const list = p.assets.filter(function (a) { return st.fam === 'all' || a.family === st.fam; });
                let html = '<div class="fp-cards">';
                if (st.fam !== 'all') {
                    html += '<button type="button" class="fp-btn fp-btn-sm" data-fp-fam="' + id + '|all">Show all families</button>';
                }
                html += list.map(function (a) { return fpCard(id, st, a); }).join('');
                const healthy = [];
                (p.families || []).forEach(function (f) {
                    if (st.fam === 'all' || st.fam === f.family) {
                        (f.healthy || []).forEach(function (n) { healthy.push(n); });
                    }
                });
                if (healthy.length) {
                    html += '<div class="fp-card"><div class="fp-ch fp-ch-static"><span class="fp-pill fp-ok">Healthy</span><span class="fp-mut">No finding in 15 days. Nothing to do today.</span></div>'
                        + '<div class="fp-cb"><div class="fp-ok-list">' + healthy.map(function (n) { return '<span>' + esc(n) + '</span>'; }).join('') + '</div></div></div>';
                }
                if (!list.length && !healthy.length) {
                    html += '<p class="fp-mut">Nothing at this station needs attention today.</p>';
                }
                return html + '</div>';
            }

            function fpCard(id, st, a) {
                const open = !!st.open[a.key];
                const pr = FP_PR[a.priority] || { cls: 'ok' };
                let body = '';
                if (open) {
                    const subs = FP_SUBS[a.family] || FP_SUBS.IPS;
                    const sub = st.sub[a.key] || subs[0][0];
                    body = '<div class="fp-cb">'
                        + (a.reasons && a.reasons.length ? '<div class="fp-reasons">' + a.reasons.map(function (r) { return '<span class="fp-chip-r">' + esc(r) + '</span>'; }).join('') + '</div>' : '')
                        + '<div class="fp-subtabs" role="group" aria-label="Sections for ' + esc(a.name) + '">'
                        + subs.map(function (s) { return '<button type="button" class="fp-st" data-fp-sub="' + id + '|' + esc(a.key) + '|' + s[0] + '" aria-pressed="' + (sub === s[0]) + '">' + s[1] + '</button>'; }).join('')
                        + '</div>' + fpSection(a, sub) + fpAction(st, a) + '</div>';
                }
                return '<article class="fp-card fp-card-' + pr.cls + '" data-fp-card="' + esc(a.key) + '">'
                    + '<button type="button" class="fp-ch" data-fp-toggle="' + id + '|' + esc(a.key) + '" aria-expanded="' + open + '">'
                    + fpPill(a.priority) + '<span class="fp-name">' + esc(a.name) + '</span><span class="fp-mut">' + esc(a.subtitle || '') + '</span>'
                    + '<span class="fp-verdict">' + esc(a.verdict || '') + '</span><span class="fp-mins">' + (a.minutes || 0) + ' min</span>'
                    + '<svg class="fp-caret" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></button>'
                    + body + '</article>';
            }

            function fpSection(a, sub) {
                if (sub === 'alerts') {
                    return fpAlertsBox(a.alerts15d);
                }
                if (sub === 'avg') {
                    return fpDriftBox(a.drift, a.family === 'TC' ? 'Shunted samples are excluded by the roster run.' : '');
                }
                if (sub === 'cond') {
                    return fpTrackCond(a.track);
                }
                if (sub === 'events') {
                    return fpTrackEvents(a.track);
                }
                if (sub === 'cls') {
                    return fpPmClass(a.pm);
                }
                if (sub === 'last') {
                    return fpPmLast(a.pm);
                }
                if (sub === 'lamp') {
                    return '<div class="fp-grid2">' + fpDriftBox(a.drift, '') + fpSignalBox(a.signal) + '</div>';
                }
                return '';
            }

            function fpAlertsBox(al) {
                if (!al) {
                    return '<div class="fp-box"><p class="fp-mut">Alert history was not available.</p></div>';
                }
                let trend = '<span class="fp-mut">too few alerts for a trend</span>';
                if (al.count >= 3) {
                    if (al.secondHalf > al.firstHalf) {
                        trend = '<span class="fp-bad">degrading (' + al.firstHalf + ' \u2192 ' + al.secondHalf + ')</span>';
                    } else if (al.secondHalf < al.firstHalf) {
                        trend = '<span class="fp-good">improving (' + al.firstHalf + ' \u2192 ' + al.secondHalf + ')</span>';
                    } else {
                        trend = 'steady (' + al.firstHalf + ' \u2192 ' + al.secondHalf + ')';
                    }
                }
                const days = Array.isArray(al.perDay) ? al.perDay : [];
                const max = Math.max.apply(null, days.concat([1]));
                const half = Math.ceil(days.length / 2);
                const bars = days.map(function (v, i) {
                    return '<span class="' + (i < half ? 'fp-half' : '') + '" style="height:' + Math.max(v ? 8 : 2, 100 * v / max) + '%" title="' + v + ' alert(s)"></span>';
                }).join('');
                return '<div class="fp-box"><h4>Alerts' + FP_DOT + 'last ' + (days.length || 15) + ' days</h4><dl class="fp-kv">'
                    + '<dt>Count</dt><dd><b>' + (al.count || 0) + '</b></dd>'
                    + '<dt>Active now</dt><dd>' + (al.active ? '<span class="fp-pill fp-u">' + al.active + ' active</span>' : '<span class="fp-pill fp-ok">None</span>') + '</dd>'
                    + '<dt>Trend</dt><dd>' + trend + '</dd>'
                    + (al.topCause ? '<dt>Most frequent</dt><dd>' + esc(al.topCause) + '</dd>' : '')
                    + (al.latest ? '<dt>Latest</dt><dd>' + esc(al.latest) + '</dd>' : '')
                    + '</dl>'
                    + (days.length ? '<div class="fp-bars15" aria-label="Alerts per day">' + bars + '</div><div class="fp-axis"><span>' + esc(al.fromDay || '') + '</span><span>first half' + FP_DOT + 'second half</span><span>' + esc(al.toDay || '') + '</span></div>' : '')
                    + '</div>';
            }

            function fpSigned(attr) {
                let v = Number(attr.drift);
                if (isNaN(v)) {
                    return null;
                }
                const dir = String(attr.dir || '').toLowerCase();
                if (v > 0 && (dir.indexOf('down') >= 0 || dir.indexOf('dec') >= 0 || dir.indexOf('low') >= 0)) {
                    v = -v;
                }
                return v;
            }

            function fpDriftBox(d, note) {
                if (!d || ((!d.attrs || !d.attrs.length) && (d.value === undefined || d.value === null))) {
                    return '<div class="fp-box"><h4>Average insight</h4><p class="fp-mut">Comparison unavailable: the roster run has no average-drift reading for this asset.</p></div>';
                }
                let rows = '';
                (d.attrs || []).forEach(function (at) {
                    const v = fpSigned(at);
                    const w = v === null ? 0 : Math.min(100, Math.abs(v) * 5);
                    const bad = v !== null && Math.abs(v) >= 5;
                    rows += '<div class="fp-metric"><span>' + esc(at.attr) + '</span><span class="fp-mbar"><b class="' + (bad ? 'fp-mbad' : '') + '" style="width:' + w + '%"></b></span>'
                        + '<span class="fp-mv">avg ' + fpNum(at.avg, 2) + ' <span class="' + (bad ? 'fp-bad' : 'fp-mut') + '">' + (v === null ? '' : (v > 0 ? '+' : '') + fpNum(v, 1) + '%') + '</span></span></div>';
                });
                const head = (d.value !== undefined && d.value !== null) ? '<p class="fp-mut" style="margin:0 0 8px">Overall drift <b>' + ((d.value > 0 ? '+' : '') + fpNum(d.value, 1)) + '%</b>' + (d.worstAttr ? ', worst on ' + esc(d.worstAttr) : '') + '</p>' : '';
                return '<div class="fp-box"><h4>Average insight' + FP_DOT + 'drift against the asset\'s own normal</h4>' + head + rows
                    + '<p class="fp-note">Bar length = size of the drift (20% fills the bar).' + (note ? ' ' + esc(note) : '') + '</p></div>';
            }

            function fpTrackDiagram(t) {
                const hit = t ? t.leakType : 'None';
                const pos = { FeedSide: [70, 'Feed end'], GluedJoint: [612, 'Glued joint'], SleeperBallast: [340, 'Sleeper / ballast'], RelaySide: [668, 'Relay end'], ExternalShorting: [300, 'Shorting across rails'] }[hit];
                let sl = '';
                for (let x = 60; x <= 680; x += 26) {
                    sl += '<rect x="' + x + '" y="34" width="10" height="62" rx="2" class="fp-sleeper"/>';
                }
                let mark = '';
                if (pos) {
                    if (hit === 'ExternalShorting') {
                        mark = '<line x1="' + pos[0] + '" y1="44" x2="' + (pos[0] + 30) + '" y2="86" class="fp-hit-line"/>';
                    } else if (hit === 'SleeperBallast') {
                        mark = '<rect x="250" y="30" width="190" height="70" rx="10" class="fp-hit-area"/>';
                    } else {
                        mark = '<circle cx="' + pos[0] + '" cy="65" r="22" class="fp-hit-area"/>';
                    }
                    mark += fpSvgText(Math.min(640, Math.max(80, pos[0])), 122, 'fp-hit-text', 'middle', pos[1]);
                }
                const svg = '<svg viewBox="0 0 740 130" class="fp-rail" role="img" aria-label="Track circuit leak location: ' + esc(pos ? pos[1] : 'none found') + '">' + sl
                    + '<line x1="40" y1="44" x2="700" y2="44" class="fp-railline"/><line x1="40" y1="86" x2="700" y2="86" class="fp-railline"/>'
                    + '<rect x="4" y="52" width="30" height="26" rx="4" class="fp-endbox"/>' + fpSvgText(19, 70, 'fp-endtext', 'middle', 'F')
                    + '<rect x="706" y="52" width="30" height="26" rx="4" class="fp-endbox"/>' + fpSvgText(721, 70, 'fp-endtext', 'middle', 'R')
                    + fpSvgText(48, 22, 'fp-svgmut', '', 'glued joint') + fpSvgText(600, 22, 'fp-svgmut', '', 'glued joint') + mark + '</svg>';
                const locs = '<div class="fp-loc">' + FP_LOCS.map(function (l) {
                    const cls = l[0] === hit ? 'fp-loc-hit' : (t && l[0] === t.seenEarlier ? 'fp-loc-was' : '');
                    const txt = l[0] === hit ? 'Found by model' : (t && l[0] === t.seenEarlier ? 'Seen earlier' : l[2]);
                    return '<div class="' + cls + '"><b>' + l[1] + '</b><span>' + txt + '</span></div>';
                }).join('') + '</div>';
                return svg + locs;
            }

            function fpTrackCond(t) {
                if (!t) {
                    return '<div class="fp-box"><p class="fp-mut">The track model could not be read for this circuit.</p></div>';
                }
                const stat = String(t.status || '').toLowerCase();
                let pill = '<span class="fp-pill fp-ok">No leak</span>';
                if (stat === 'ongoing') {
                    pill = '<span class="fp-pill fp-u">Happening now</span>';
                } else if (stat === 'active') {
                    pill = '<span class="fp-pill fp-s">Active in last hours</span>';
                } else if (stat === 'recovery') {
                    pill = '<span class="fp-pill fp-s">Receding now</span>';
                } else if (stat === 'resolved') {
                    pill = '<span class="fp-pill fp-ok">Resolved</span>';
                }
                return '<div class="fp-grid2"><div class="fp-box"><h4>Where the leak is</h4>' + fpTrackDiagram(t) + '</div>'
                    + '<div class="fp-box"><h4>Track model reading</h4><dl class="fp-kv">'
                    + (t.overall ? '<dt>Overall</dt><dd><b>' + esc(t.overall) + '</b></dd>' : '')
                    + '<dt>Leakage type</dt><dd>' + esc(t.leakTypeRaw || 'None') + '</dd>'
                    + '<dt>Status</dt><dd>' + pill + '</dd>'
                    + (t.severity ? '<dt>Severity</dt><dd>' + esc(t.severity) + '</dd>' : '')
                    + (t.band ? '<dt>Band</dt><dd>' + esc(t.band) + (t.bandReason ? FP_DOT + esc(t.bandReason) : '') + '</dd>' : '')
                    + (t.summary ? '<dt>In plain words</dt><dd>' + esc(t.summary) + '</dd>' : '')
                    + (t.reason && t.reason !== t.summary ? '<dt>Model reason</dt><dd>' + esc(t.reason) + '</dd>' : '')
                    + '</dl><p class="fp-note">' + (t.source === 'roster' ? 'From the roster run; the live model was not reached. ' : '') + 'Model classification. Confirm on site.</p></div></div>';
            }

            function fpTrackEvents(t) {
                if (!t || !t.events || !t.events.length) {
                    return '<div class="fp-box"><p class="fp-mut">No major events in the model history' + (t && t.eventCount ? ' (' + t.eventCount + ' in the roster run)' : '') + '.</p></div>';
                }
                return '<div class="fp-box"><h4>Major events</h4><div class="fp-scroll"><table class="fp-table"><thead><tr><th>Start</th><th>End</th><th>Hours</th><th>Dominant cause</th></tr></thead><tbody>'
                    + t.events.map(function (e) { return '<tr><td>' + esc(e.start || '\u2014') + '</td><td>' + esc(e.end || '\u2014') + '</td><td>' + fpNum(e.hours, 1) + '</td><td><b>' + esc(e.cause || '\u2014') + '</b></td></tr>'; }).join('')
                    + '</tbody></table></div></div>';
            }

            function fpPmClass(pm) {
                if (!pm) {
                    return '<div class="fp-box"><p class="fp-mut">The point-machine model could not be read.</p></div>';
                }
                if (!pm.machines || !pm.machines.length) {
                    return '<div class="fp-box"><h4>Point-machine model (roster run)</h4><dl class="fp-kv"><dt>Throws</dt><dd>' + (pm.opsInWindow || 0) + '</dd><dt>Flagged</dt><dd>' + (pm.flaggedInWindow || 0) + '</dd>'
                        + (pm.worstState ? '<dt>Worst state</dt><dd>' + esc(pm.worstState) + '</dd>' : '') + (pm.condition ? '<dt>Condition</dt><dd>' + esc(pm.condition) + '</dd>' : '') + '</dl></div>';
                }
                const colors = { NORMAL: 'var(--fp-ok)', CREEPING: '#d98b19', OBSTRUCTION: 'var(--fp-u)', SLUGGISH: '#7a3fb8', INVALID: '#9aa6b8' };
                return '<div class="fp-machines">' + pm.machines.map(function (m) {
                    const keys = Object.keys(m.grades || {}).sort(function (x, y) { return m.grades[y] - m.grades[x]; });
                    const tot = keys.reduce(function (s, k) { return s + m.grades[k]; }, 0) || 1;
                    const share = m.opsInWindow ? m.flagged / m.opsInWindow : 0;
                    const rows = keys.map(function (k) {
                        return '<div class="fp-clsrow"><span>' + esc(k.charAt(0) + k.slice(1).toLowerCase()) + '</span><span class="fp-tr"><i style="width:' + (100 * m.grades[k] / tot) + '%;background:' + (colors[k] || '#1f4fb8') + '"></i></span><b>' + m.grades[k] + '</b></div>';
                    }).join('');
                    const dirs = (m.directions || []).map(function (d) {
                        return '<tr><td>' + esc(d.dir) + '</td><td>' + esc(d.state || '\u2014') + '</td><td>' + fpNum(d.throws) + '</td><td>' + esc(d.worst || '\u2014') + '</td><td>' + (d.rising && d.rising.length ? d.rising.map(function (r) { return esc(FP_RISING[r] || r); }).join(', ') : '\u2014') + '</td></tr>';
                    }).join('');
                    return '<div class="fp-box"><div class="fp-mhead"><b>Machine ' + esc(m.end) + FP_DOT + esc(m.tag || '') + '</b><span class="fp-pill ' + (share >= 0.5 ? 'fp-u' : (share >= 0.1 ? 'fp-s' : 'fp-ok')) + '">' + (m.flagged || 0) + ' of ' + (m.opsInWindow || 0) + ' flagged</span></div>'
                        + (rows || '<p class="fp-mut">No graded throws in the window.</p>')
                        + (dirs ? '<div class="fp-scroll"><table class="fp-table"><thead><tr><th>Direction</th><th>State</th><th>Throws</th><th>Worst</th><th>Rising</th></tr></thead><tbody>' + dirs + '</tbody></table></div>' : '')
                        + '</div>';
                }).join('') + '</div>'
                    + (pm.verdict ? '<p class="fp-pmv"><b>Model summary:</b> ' + esc(pm.verdict) + (pm.recommendation ? FP_DOT + esc(pm.recommendation) : '') + '</p>' : '')
                    + '<p class="fp-note">Model classification over the last 15 days. Confirm with the waveform on site.</p>';
            }

            function fpWave(samples, cls) {
                if (!samples || samples.length < 5) {
                    return '';
                }
                const W = 360;
                const H = 140;
                const pad = 26;
                const max = Math.max.apply(null, samples.concat([1]));
                const pts = samples.map(function (v, i) {
                    const x = pad + (W - pad - 8) * i / (samples.length - 1);
                    const y = H - 20 - (H - 32) * v / max;
                    return x.toFixed(1) + ',' + y.toFixed(1);
                }).join(' ');
                return '<svg viewBox="0 0 ' + W + ' ' + H + '" class="fp-wave" role="img" aria-label="Current through the last throw">'
                    + '<line x1="' + pad + '" x2="' + (W - 8) + '" y1="' + (H - 20) + '" y2="' + (H - 20) + '" class="fp-gridline"/>'
                    + fpSvgText(pad - 4, H - 16, 'fp-svgmut', 'end', '0')
                    + fpSvgText(pad - 4, 16, 'fp-svgmut', 'end', fpNum(max, 1) + ' A')
                    + '<polyline points="' + pts + '" class="' + cls + '"/></svg>';
            }

            function fpPmLast(pm) {
                if (!pm || !pm.machines || !pm.machines.length) {
                    return '<div class="fp-box"><p class="fp-mut">No operation details in the model reply.</p></div>';
                }
                return '<div class="fp-machines">' + pm.machines.map(function (m, i) {
                    const op = m.lastOp;
                    if (!op) {
                        return '<div class="fp-box"><div class="fp-mhead"><b>Machine ' + esc(m.end) + '</b></div><p class="fp-mut">No operation in the window.</p></div>';
                    }
                    const wave = fpWave(op.samples, i === 0 ? 'fp-trace-a' : 'fp-trace-b');
                    return '<div class="fp-box"><div class="fp-mhead"><b>Machine ' + esc(m.end) + FP_DOT + esc(m.tag || '') + '</b><span class="fp-mut">' + esc(op.at || '') + '</span></div>'
                        + '<dl class="fp-kv"><dt>Grade</dt><dd><b>' + esc(op.grade || '\u2014') + '</b></dd>'
                        + '<dt>Average current</dt><dd>' + fpNum(op.avgA, 2) + ' A</dd><dt>Peak current</dt><dd>' + fpNum(op.maxA, 2) + ' A</dd><dt>Operation time</dt><dd>' + fpNum(op.timeS, 2) + ' s</dd></dl>'
                        + (wave || '<p class="fp-note">The model reply carries no stroke samples. Open Telemetry Live for the trace.</p>') + '</div>';
                }).join('') + '</div>';
            }

            function fpSignalBox(sg) {
                if (!sg) {
                    return '';
                }
                const pattern = sg.nightFailures > 2 && sg.dayFailures === 0 ? 'Failures only at night usually mean a loose termination that opens as it cools.' : 'No clear time pattern.';
                return '<div class="fp-box"><h4>When failures happen</h4><dl class="fp-kv"><dt>Night (22:00\u201306:00)</dt><dd><b>' + (sg.nightFailures || 0) + '</b></dd><dt>Day</dt><dd><b>' + (sg.dayFailures || 0) + '</b></dd></dl><p class="fp-mut" style="margin:8px 0 0">' + pattern + '</p></div>';
            }

            function fpWorksheetUrl(plan) {
                const d = new Date();
                const day = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
                return FP_WORKSHEET + '?divisionId=' + encodeURIComponent(plan.site.divisionId || '') + '&siteId=' + encodeURIComponent(plan.site.id) + '&rosterDate=' + day;
            }

            function fpAction(st, a) {
                const act = a.action || {};
                return '<div class="fp-act"><p>' + esc(act.text || 'No action suggested.') + '<small>Estimated ' + (a.minutes || 0) + ' min on site' + (act.id ? FP_DOT + esc(act.id) : '') + '</small></p>'
                    + '<a class="fp-btn" href="' + esc(fpWorksheetUrl(st.plan)) + '" target="_blank" rel="noopener">Record outcome in roster</a></div>';
            }

            function fpFooter(id, st) {
                return '<div class="fp-foot"><a class="fp-btn fp-btn-p" href="' + esc(fpWorksheetUrl(st.plan)) + '" target="_blank" rel="noopener">Open station worksheet</a>'
                    + '<button type="button" class="fp-btn" data-fp-copy="' + id + '">Copy plan as text</button><span class="fp-copied" id="' + id + '-copied" role="status"></span></div>';
            }

            function fpPlanText(st) {
                const p = st.plan;
                const f = fpFit(p, st.hours);
                const lines = [p.site.name + (p.site.code ? ' (' + p.site.code + ')' : '') + ' - ' + st.hours + '-hour maintenance plan', p.headline || '', ''];
                lines.push('1. ' + (p.timeBudget.setupLabel || 'Setup') + ' - ' + f.setup + ' min');
                f.inPlan.forEach(function (a, i) {
                    lines.push((i + 2) + '. ' + a.name + ' [' + ((FP_PR[a.priority] || {}).label || '') + ', ' + a.minutes + ' min] ' + (a.action ? a.action.text : ''));
                });
                if (f.later.length) {
                    lines.push('');
                    lines.push('Next visit: ' + f.later.map(function (a) { return a.name; }).join(', '));
                }
                return lines.join('\n');
            }

            function fpJump(key) {
                const ids = Object.keys(FP.plans);
                for (let i = ids.length - 1; i >= 0; i--) {
                    const st = FP.plans[ids[i]];
                    if (st.plan.assets.some(function (a) { return a.key === key; })) {
                        st.fam = 'all';
                        st.open[key] = true;
                        fpRender(ids[i]);
                        const card = document.querySelector('#' + ids[i] + ' [data-fp-card="' + key + '"]');
                        if (card) {
                            card.scrollIntoView({ block: 'start', behavior: 'smooth' });
                            const btn = card.querySelector('.fp-ch');
                            if (btn) {
                                btn.focus({ preventScroll: true });
                            }
                        }
                        return;
                    }
                }
            }

            document.addEventListener('click', function (ev) {
                const t = ev.target.closest ? ev.target.closest('[data-fp-toggle],[data-fp-sub],[data-fp-fam],[data-fp-jump],[data-fp-copy]') : null;
                if (!t) {
                    return;
                }
                if (t.hasAttribute('data-fp-toggle')) {
                    const p = t.getAttribute('data-fp-toggle').split('|');
                    const st = FP.plans[p[0]];
                    if (st) {
                        st.open[p[1]] = !st.open[p[1]];
                        fpRender(p[0]);
                        const again = document.querySelector('[data-fp-toggle="' + p[0] + '|' + p[1] + '"]');
                        if (again) {
                            again.focus();
                        }
                    }
                } else if (t.hasAttribute('data-fp-sub')) {
                    const p = t.getAttribute('data-fp-sub').split('|');
                    const st = FP.plans[p[0]];
                    if (st) {
                        st.sub[p[1]] = p[2];
                        fpRender(p[0]);
                        const again = document.querySelector('[data-fp-sub="' + p.join('|') + '"]');
                        if (again) {
                            again.focus();
                        }
                    }
                } else if (t.hasAttribute('data-fp-fam')) {
                    const p = t.getAttribute('data-fp-fam').split('|');
                    const st = FP.plans[p[0]];
                    if (st) {
                        st.fam = (p[1] === 'all' || st.fam === p[1]) ? 'all' : p[1];
                        fpRender(p[0]);
                    }
                } else if (t.hasAttribute('data-fp-jump')) {
                    fpJump(t.getAttribute('data-fp-jump'));
                } else if (t.hasAttribute('data-fp-copy')) {
                    const id = t.getAttribute('data-fp-copy');
                    const st = FP.plans[id];
                    const out = document.getElementById(id + '-copied');
                    if (!st) {
                        return;
                    }
                    const text = fpPlanText(st);
                    const done = function (msg) {
                        if (out) {
                            out.textContent = msg;
                        }
                    };
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(text).then(function () { done('Copied'); }, function () { done('Copy blocked by the browser'); });
                    } else {
                        done('Copy not supported in this browser');
                    }
                }
            });

            document.addEventListener('change', function (ev) {
                const t = ev.target;
                if (!t || !t.hasAttribute || !t.hasAttribute('data-fp-hours')) {
                    return;
                }
                const id = t.getAttribute('data-fp-hours');
                const st = FP.plans[id];
                if (st) {
                    st.hours = Number(t.value) || st.hours;
                    fpRender(id);
                    const again = document.getElementById(id + '-hrs');
                    if (again) {
                        again.focus();
                    }
                }
            });

            // Used by renderMarkdown: plan marker -> heading, [[asset:key]] -> jump chip.
            function fpDecorateText(raw) {
                const m = String(raw).match(/\[\[plan:(\d+):[^\]]*\]\]\s*/);
                if (!m) {
                    return { raw: raw, prefix: '' };
                }
                const live = !!FP.rendered[m[1]];
                const prefix = live
                    ? '<div class="fp-why-h">Why this order</div>'
                    : '<div class="fp-why-h">Station plan from earlier</div><p class="fp-mut">Ask again to rebuild the plan cards.</p>';
                return { raw: String(raw).replace(/\[\[plan:[^\]]*\]\]\s*/g, ''), prefix: prefix };
            }

            function fpAssetChips(html) {
                return html.replace(/\[\[asset:([A-Za-z0-9_-]+)\]\]/g, function (_, key) {
                    const name = FP.names[key];
                    if (!name) {
                        return '';
                    }
                    return '<button type="button" class="fp-cite" data-fp-jump="' + key + '">' + esc(name) + '</button>';
                });
            }

            /* ---------- storage ---------- */
            function titleOf(msgs) {
                const u = (msgs || []).find(function (m) { return m && m.role === 'user'; });
                if (!u) return 'New chat';
                const t = String(u.content).replace(/\s+/g, ' ').trim();
                return t.length > 48 ? t.slice(0, 47) + '\u2026' : t;
            }
            function newConvo(msgs) {
                const now = Date.now();
                return { id: 'c' + now.toString(36) + Math.random().toString(36).slice(2, 6), title: titleOf(msgs), created: now, updated: now, messages: msgs || [] };
            }
            function loadConvos() {
                try { const s = localStorage.getItem(STORE); convos = s ? JSON.parse(s) : []; if (!Array.isArray(convos)) convos = []; } catch (_) { convos = []; }
                convos = convos.filter(function (c) { return c && c.id && Array.isArray(c.messages); });
                // carry over the single conversation that ChatBot 1.4 kept in sessionStorage
                try {
                    const old = sessionStorage.getItem('e7ai_history');
                    if (old) {
                        const msgs = JSON.parse(old);
                        if (Array.isArray(msgs) && msgs.length && !convos.length) { convos.push(newConvo(msgs.filter(function (m) { return m && (m.role === 'user' || m.role === 'assistant') && m.content; }))); saveConvos(); }
                        sessionStorage.removeItem('e7ai_history');
                    }
                } catch (_) { }
            }
            function saveConvos() {
                convos.sort(function (a, b) { return b.updated - a.updated; });
                if (convos.length > MAX_CONVOS) convos = convos.slice(0, MAX_CONVOS);
                try { localStorage.setItem(STORE, JSON.stringify(convos)); }
                catch (_) { try { convos = convos.slice(0, Math.max(5, Math.floor(convos.length / 2))); localStorage.setItem(STORE, JSON.stringify(convos)); } catch (__) { } }
            }
            function current() { return convos.find(function (c) { return c.id === currentId; }) || null; }

            /* ---------- shell ---------- */
            function buildHTML() {
                const picker = (typeof E7_ENGINE_PICKER === 'string' && E7_ENGINE_PICKER) ? E7_ENGINE_PICKER : '<span class="e7c-engine">' + esc(E7_BRAND) + '</span>';
                mount.innerHTML =
                    '<div class="e7c-app" id="e7cApp">' +
                    ' <aside class="e7c-side" aria-label="Chats">' +
                    '  <div class="e7c-brand"><span class="e7c-logo" aria-hidden="true">' + BOLT + '</span><div><b>RDPMS Assistant</b><small>Signalling maintenance data</small></div></div>' +
                    '  <button type="button" class="e7c-new" id="e7cNew"><span class="e7c-plus" aria-hidden="true">+</span>New chat</button>' +
                    '  <input type="search" class="e7c-search" id="e7cSearch" placeholder="Search chats" aria-label="Search chats">' +
                    '  <nav class="e7c-list" id="e7cList" aria-label="Chat history"></nav>' +
                    '  <div class="e7c-foot"><span class="e7c-av" aria-hidden="true">' + esc(USER_NAME.charAt(0).toUpperCase()) + '</span><span>' + esc(USER_NAME) + '</span><button type="button" id="e7cClear" title="Delete all chats saved on this computer">Clear all</button></div>' +
                    ' </aside>' +
                    ' <div class="e7c-scrim" id="e7cScrim"></div>' +
                    ' <main class="e7c-main" id="e7cMain">' +
                    '  <header class="e7c-head"><button type="button" class="e7c-menu" id="e7cMenu" aria-label="Show chats">&#9776;</button><div class="e7c-title" id="e7cTitle">New chat</div>' +
                    '   <span class="e7c-status" id="e7cStatus"><i></i><span>Connecting\u2026</span></span></header>' +
                    '  <div class="e7c-scroll" id="e7cScroll"><div class="e7c-thread" id="e7cThread" role="log" aria-live="polite" aria-relevant="additions"></div></div>' +
                    '  <div class="e7c-compose"><div class="e7c-compose-in">' +
                    '   <div class="e7c-ask" id="e7cAsk"><span id="e7cAskText"></span><button type="button" id="e7cAskCancel">Cancel</button></div>' +
                    '   <div class="e7c-box"><textarea id="e7cInput" rows="1" maxlength="' + MAX_CHARS + '" aria-label="Message" placeholder="How can I help you today?"></textarea>' +
                    '    <div class="e7c-box-row"><div class="e7c-box-tools">' + picker + '</div><span class="e7c-count" id="e7cCount">0 / ' + MAX_CHARS + '</span>' +
                    '     <button type="button" class="e7c-send" id="e7cSend" aria-label="Send" disabled>' + ICON_SEND + '</button></div></div>' +
                    '   <div class="e7c-hint">Answers come from live RDPMS data. Check before acting on site.</div>' +
                    '  </div></div>' +
                    ' </main>' +
                    '</div>';
                appEl = document.getElementById('e7cApp'); listEl = document.getElementById('e7cList'); threadEl = document.getElementById('e7cThread');
                scrollEl = document.getElementById('e7cScroll'); inputEl = document.getElementById('e7cInput'); sendBtn = document.getElementById('e7cSend');
                titleEl = document.getElementById('e7cTitle'); statusEl = document.getElementById('e7cStatus'); askEl = document.getElementById('e7cAsk');
                askTextEl = document.getElementById('e7cAskText'); countEl = document.getElementById('e7cCount');
                mainEl = document.getElementById('e7cMain');
            }
            function setEmpty(on) { mainEl.classList.toggle('is-empty', !!on); }
            function setStatus(state, text) { statusEl.className = 'e7c-status ' + state; statusEl.lastChild.textContent = text; }
            async function pingStatus() {
                setStatus('connecting', 'Connecting\u2026');
                try {
                    const r = await fetch(STATUS_ENDPOINT, { credentials: 'same-origin' });
                    const ct = (r.headers.get('content-type') || '').toLowerCase();
                    if (r.status === 401 || r.redirected || ct.indexOf('text/html') >= 0) { setStatus('error', 'Not signed in'); return; }
                    const d = await r.json();
                    setStatus(d.ok ? 'online' : 'error', d.ok ? 'Ready' : (d.error || 'Unavailable'));
                } catch (_) { setStatus('error', 'Unavailable'); }
            }

            /* ---------- chat list ---------- */
            function renderList() {
                const q = query.toLowerCase();
                const items = convos.filter(function (c) { return !q || c.title.toLowerCase().indexOf(q) >= 0 || c.messages.some(function (m) { return String(m.content).toLowerCase().indexOf(q) >= 0; }); });
                if (!items.length) { listEl.innerHTML = '<p class="e7c-empty-list">' + (q ? 'No chat matches your search.' : 'Your chats will appear here.') + '</p>'; return; }
                const d = new Date(); d.setHours(0, 0, 0, 0);
                const t0 = d.getTime(), w0 = t0 - 6 * 864e5;
                const groups = [['Today', function (c) { return c.updated >= t0; }], ['Previous 7 days', function (c) { return c.updated < t0 && c.updated >= w0; }], ['Older', function (c) { return c.updated < w0; }]];
                let html = '';
                groups.forEach(function (g) {
                    const part = items.filter(g[1]);
                    if (!part.length) return;
                    html += '<div class="e7c-group">' + g[0] + '</div>' + part.map(function (c) {
                        return '<div class="e7c-item" aria-current="' + (c.id === currentId) + '"><button type="button" class="e7c-open" data-open="' + esc(c.id) + '" title="' + esc(c.title) + '">' + esc(c.title) + '</button>' +
                            '<button type="button" class="e7c-del" data-del="' + esc(c.id) + '" aria-label="Delete chat: ' + esc(c.title) + '">&#215;</button></div>';
                    }).join('');
                });
                listEl.innerHTML = html;
            }
            function openConvo(id) {
                if (isStreaming) { setStatus('connecting', 'Wait for the answer, or stop it'); return; }
                currentId = id; cancelPrompt(); renderList(); renderThread(); appEl.classList.remove('nav-open'); inputEl.focus();
            }
            function newChat() { if (isStreaming) return; currentId = null; cancelPrompt(); renderList(); renderThread(); appEl.classList.remove('nav-open'); inputEl.focus(); }
            function deleteConvo(id) {
                if (isStreaming && id === currentId) return;
                const c = convos.find(function (x) { return x.id === id; });
                if (!c || !window.confirm('Delete this chat?\n\n' + c.title)) return;
                convos = convos.filter(function (x) { return x.id !== id; }); saveConvos();
                if (id === currentId) { currentId = null; renderThread(); }
                renderList();
            }

            /* ---------- thread ---------- */
            function scrollDown(force) {
                const near = scrollEl.scrollHeight - scrollEl.scrollTop - scrollEl.clientHeight < 140;
                if (force || near) scrollEl.scrollTop = scrollEl.scrollHeight;
            }
            function renderThread() {
                threadEl.innerHTML = '';
                const c = current();
                titleEl.textContent = c ? c.title : 'New chat';
                if (!c || !c.messages.length) { renderWelcome(); return; }
                setEmpty(false);
                c.messages.forEach(function (m, i) {
                    if (m.role === 'user') { appendUser(m.content); }
                    else if (m.role === 'assistant') { const el = appendBot(); if (m.plan) appendPlanMsg(m.plan, el); setBotText(el, m.content, false); addActions(el, m.content, i === c.messages.length - 1, !!m.stopped); }
                });
                scrollDown(true);
            }
            function renderWelcome() {
                const h = new Date().getHours(), g = h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';
                setEmpty(true);
                threadEl.innerHTML = '<div class="e7c-welcome"><span class="e7c-wlogo" aria-hidden="true">' + BOLT + '</span><h2>' + g + ', ' + esc(USER_NAME) + '</h2>' +
                    '<p>Ask about a site, asset, alert, live value or recent history.</p>' +
                    '<div class="e7c-suggest"><div class="e7c-cats" role="group" aria-label="Question topics">' + PROMPT_CATEGORIES.map(function (c) {
                        return '<button type="button" data-cat="' + esc(c.id) + '" aria-pressed="' + (c.id === activeCat) + '">' + c.icon + ' ' + esc(c.label) + '</button>';
                    }).join('') + '</div><div class="e7c-prompts" id="e7cPrompts"></div></div></div>';
                renderPrompts();
            }
            function renderPrompts() {
                const box = document.getElementById('e7cPrompts'); if (!box) return;
                const cat = PROMPT_CATEGORIES.find(function (c) { return c.id === activeCat; }) || PROMPT_CATEGORIES[0];
                box.innerHTML = cat.prompts.map(function (p, i) {
                    return '<button type="button" data-prompt="' + i + '">' + esc(p.label) + '<small>' + (p.ask === 'site' ? 'You type the site name' : 'You type the asset name') + '</small></button>';
                }).join('');
            }
            function appendUser(text) {
                const el = document.createElement('div'); el.className = 'e7c-msg user';
                const b = document.createElement('div'); b.className = 'e7c-bubble'; b.textContent = text; el.appendChild(b);
                threadEl.appendChild(el); return el;
            }
            function appendBot() {
                const el = document.createElement('div'); el.className = 'e7c-msg bot';
                el.innerHTML = '<div class="e7c-answer"><div class="e7c-tool-slot"></div><div class="e7c-body"></div><div class="e7c-extra"></div></div>';
                threadEl.appendChild(el); return el;
            }
            function setBotText(el, raw, streaming) {
                const body = el.querySelector('.e7c-body');
                body.innerHTML = renderMarkdown(raw) + (streaming ? '<span class="e7c-caret" aria-hidden="true"></span>' : '');
                if (!streaming) decorateCode(body);
            }
            function decorateCode(body) {
                body.querySelectorAll('pre').forEach(function (pre) {
                    if (pre.querySelector('.e7c-codecopy')) return;
                    const b = document.createElement('button'); b.type = 'button'; b.className = 'e7c-codecopy'; b.textContent = 'Copy';
                    b.addEventListener('click', function () { const code = pre.querySelector('code'); copyText(code ? code.textContent : pre.textContent, b); });
                    pre.appendChild(b);
                });
            }
            function setTool(el, name) {
                const TOOL_LABELS = {
                    search_sites: 'Searching sites…',
                    search_assets: 'Searching assets…',
                    search_tags: 'Searching tags…',
                    get_asset_tags: 'Loading tags…',
                    get_tag_current: 'Reading live value…',
                    get_live_values: 'Reading live values…',
                    state_get: 'Getting state…',
                    get_history: 'Loading history…',
                    get_history_compact: 'Loading history…',
                    get_limited_history: 'Loading recent readings…',
                    get_timestamps: 'Reading timestamps…',
                    get_alerts: 'Checking alerts…',
                    get_alert_history: 'Loading alert history…',
                    alert_smart: 'Summarising alerts…',
                    summary_get: 'Calculating summary…',
                    trend_get: 'Analysing trend…',
                };
                const label = TOOL_LABELS[name] || (String(name || 'Working') + '\u2026');
                el.querySelector('.e7c-tool-slot').innerHTML = '<span class="e7c-tool"><span class="e7c-spin" aria-hidden="true"></span><span>' + esc(label) + '</span></span>';
                scrollDown(false);
            }
            function clearTool(el) { const s = el.querySelector('.e7c-tool-slot'); if (s) s.innerHTML = ''; }
            function showError(el, text) {
                const d = document.createElement('div'); d.className = 'e7c-err'; d.setAttribute('role', 'alert'); d.textContent = text;
                el.querySelector('.e7c-extra').appendChild(d);
            }
            function addActions(el, raw, isLast, stopped) {
                const extra = el.querySelector('.e7c-extra');
                if (stopped) { const n = document.createElement('div'); n.className = 'e7c-note'; n.textContent = 'Stopped before the answer was complete.'; extra.appendChild(n); }
                const row = document.createElement('div'); row.className = 'e7c-actions';
                const cp = document.createElement('button'); cp.type = 'button'; cp.innerHTML = ICON_COPY + '<span>Copy</span>'; cp.setAttribute('aria-label', 'Copy answer');
                // 1.6.0.0 (merge): the fast-plan markers are for the page, not for the person pasting the answer
                const clean = String(raw).replace(/\[\[plan:[^\]]*\]\]\s*/g, '').replace(/\[\[asset:([A-Za-z0-9_-]+)\]\]/g, function (_, k) { return FP.names[k] || ''; });
                cp.addEventListener('click', function () { copyText(clean, cp); }); row.appendChild(cp);
                if (isLast) {
                    const rg = document.createElement('button'); rg.type = 'button'; rg.innerHTML = ICON_RETRY + '<span>Retry</span>'; rg.setAttribute('data-regen', '1'); rg.setAttribute('aria-label', 'Regenerate answer');
                    rg.addEventListener('click', regenerate); row.appendChild(rg);
                }
                extra.appendChild(row);
            }
            function copyText(text, btn) {
                function done() { const lab = btn.querySelector('span') || btn; const t = lab.textContent; lab.textContent = 'Copied'; setTimeout(function () { lab.textContent = t; }, 1400); }
                if (navigator.clipboard && window.isSecureContext) { navigator.clipboard.writeText(text).then(done, fallback); } else { fallback(); }
                function fallback() { const ta = document.createElement('textarea'); ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0'; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); done(); } catch (_) { } ta.remove(); }
            }
            function followUpChips(question, answer) {
                const q = question.toLowerCase();
                const a = answer.toLowerCase();
                const chips = [];

                const assetMatch = question.match(/\b(\d+T\d*|SH\d+|PM\d+|DL\d+|A10\d*)\b/i);
                const asset = assetMatch ? assetMatch[1] : null;

                if (asset) {
                    if (q.includes('tpr') || q.includes('current') || q.includes('live') || q.includes('value')) {
                        chips.push({ label: '📈 History today', prompt: `Show today's history for asset ${asset}` });
                        chips.push({ label: '🚨 Active alerts', prompt: `Show active alerts for asset ${asset}` });
                    }
                    if (q.includes('alert') || a.includes('alert')) {
                        chips.push({ label: '📋 Alert history 7d', prompt: `Show alert history for asset ${asset} over the last 7 days` });
                        chips.push({ label: '📊 Current values', prompt: `Show all current tag values for asset ${asset}` });
                    }
                    if (q.includes('history') || q.includes('reading')) {
                        chips.push({ label: '⏰ Last updated', prompt: `When was asset ${asset} last updated? Show TimestampDevice.` });
                        chips.push({ label: '🛠️ Health summary', prompt: `Give a health summary for asset ${asset}` });
                    }
                } else {
                    if (a.includes('alert') || q.includes('alert')) {
                        chips.push({ label: '📋 All active alerts', prompt: 'Show all active alerts' });
                    }
                    chips.push({
                        label: '🔍 Search asset', prompt: null, action: () => {
                            startCategory('search');
                        }
                    });
                }

                
                return chips;
            }
            function addFollowUps(el, question, answer) {
                const chips = followUpChips(question, answer);
                if (!chips.length) return;
                const row = document.createElement('div'); row.className = 'e7c-follow';
                chips.slice(0, 4).forEach(function (chip) {
                    const b = document.createElement('button'); b.type = 'button'; b.textContent = chip.label;
                    // 1.5.0.0: send once. 1.4 pushed the prompt into the history AND sent it, so it went to the server twice.
                    b.addEventListener('click', function () { if (chip.action) { chip.action(); return; } if (chip.prompt && !isStreaming) { send(chip.prompt); } });
                    row.appendChild(b);
                });
                el.querySelector('.e7c-extra').appendChild(row);
                scrollDown(false);
            }
            function startCategory(id) {
                const cat = PROMPT_CATEGORIES.find(function (c) { return c.id === id; });
                if (cat && cat.prompts.length) { activeCat = id; selectPrompt(cat.prompts[0]); }
            }

            /* ---------- prompts that need an asset or site name ---------- */
            function selectPrompt(p) {
                activePrompt = p;
                askTextEl.innerHTML = '<strong>' + esc(p.label) + '</strong> \u00b7 ' + (p.ask === 'site' ? 'type the site name' : 'type the asset name, e.g. 2T, SH04, PM07');
                askEl.classList.add('on');
                inputEl.placeholder = p.ask === 'site' ? 'Type site name, e.g. Arnetha, Patliputra\u2026' : 'Type asset name, e.g. 2T, 11T, SH04, PM07\u2026';
                inputEl.value = ''; onInput(); inputEl.focus();
            }
            function cancelPrompt() {
                activePrompt = null;
                if (askEl) { askEl.classList.remove('on'); }
                if (inputEl) { inputEl.placeholder = 'How can I help you today?'; }
            }

            /* ---------- send / stream ---------- */
            function clearInput() { inputEl.value = ''; onInput(); }
            function setSendMode() {
                if (isStreaming) { sendBtn.classList.add('stop'); sendBtn.innerHTML = ICON_STOP; sendBtn.setAttribute('aria-label', 'Stop generating'); sendBtn.disabled = false; }
                else { sendBtn.classList.remove('stop'); sendBtn.innerHTML = ICON_SEND; sendBtn.setAttribute('aria-label', 'Send'); sendBtn.disabled = !inputEl.value.trim(); }
            }
            function scheduleRender(el, text) {
                if (rq) return;
                rq = requestAnimationFrame(function () { rq = null; setBotText(el, text, true); scrollDown(false); });
            }
            async function send(textIn, opts) {
                opts = opts || {};
                if (isStreaming) return;
                let text;
                if (opts.regenerate) { text = textIn; }
                else {
                    const raw = (textIn != null ? String(textIn) : inputEl.value).trim();
                    if (!raw) return;
                    if (activePrompt && textIn == null) { text = activePrompt.tpl.replace('{input}', raw); cancelPrompt(); }
                    else {
                        if (isOutOfScope(raw)) {
                            clearInput();
                            if (threadEl.querySelector('.e7c-welcome')) { threadEl.innerHTML = ''; setEmpty(false); }
                            appendUser(raw);
                            const r = appendBot();
                            setBotText(r, 'I am not trained to answer that. I can only assist with EdgeX RDPMS railway monitoring data \u2014 asset values, history, alerts and timestamps.', false);
                            scrollDown(true); return;
                        }
                        text = raw;
                    }
                    clearInput();
                }
                let c = current();
                if (!c) { c = newConvo([]); convos.unshift(c); currentId = c.id; }
                if (!opts.regenerate) { c.messages.push({ role: 'user', content: text }); if (c.messages.length === 1) c.title = titleOf(c.messages); }
                c.updated = Date.now(); saveConvos(); renderList(); titleEl.textContent = c.title;
                if (threadEl.querySelector('.e7c-welcome')) { threadEl.innerHTML = ''; setEmpty(false); }
                threadEl.querySelectorAll('[data-regen]').forEach(function (b) { b.remove(); });
                threadEl.querySelectorAll('.e7c-follow').forEach(function (f) { f.remove(); });
                if (!opts.regenerate) appendUser(text);
                const botEl = appendBot(); botEl.querySelector('.e7c-body').innerHTML = THINKING; scrollDown(true);

                isStreaming = true; controller = new AbortController(); setSendMode(); setStatus('connecting', 'Working\u2026');
                let botText = '', failed = null, stopped = false, planData = null;
                // the server receives only role + content, exactly as in 1.4
                const payload = c.messages.slice(-MAX_HISTORY * 2).map(function (m) { return { role: m.role, content: m.content }; });
                try {
                    const res = await fetch(CHAT_ENDPOINT, {
                        method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ messages: payload, provider: E7_PROVIDER }), signal: controller.signal
                    });
                    const ct = (res.headers.get('content-type') || '').toLowerCase();
                    // 401, or a redirect to the login page ([Authenticate]) -> the session has ended
                    if (res.status === 401 || res.redirected || ct.indexOf('text/html') >= 0) { failed = 'session'; }
                    else if (!res.ok) { failed = 'The assistant could not answer (server error ' + res.status + '). Please try again.'; }
                    else {
                        const reader = res.body.getReader(), decoder = new TextDecoder();
                        let buf = '';
                        while (true) {
                            const r = await reader.read();
                            if (r.done) break;
                            buf += decoder.decode(r.value, { stream: true });
                            const lines = buf.split('\n'); buf = lines.pop();
                            for (const line of lines) {
                                if (!line.startsWith('data: ')) continue;
                                const raw2 = line.slice(6).trim();
                                if (raw2 === '[DONE]') continue;
                                let evt; try { evt = JSON.parse(raw2); } catch (_) { continue; }
                                if (evt.type === 'text') { botText += evt.text; clearTool(botEl); scheduleRender(botEl, botText); }
                                else if (evt.type === 'tool_use') { setTool(botEl, evt.name); setStatus('connecting', 'Fetching data\u2026'); }
                                // 1.6.0.0 (merge, from ChatBotNew 1.3.0.0): fast maintenance plan -- cards first, the explanation streams below them
                                else if (evt.type === 'plan') { clearTool(botEl); planData = evt.plan || null; appendPlanMsg(planData, botEl); setStatus('connecting', 'Writing explanation\u2026'); }
                                else if (evt.type === 'plan_error') { clearTool(botEl); const n = document.createElement('div'); n.className = 'e7c-note'; n.textContent = evt.message || 'The quick plan could not be built.'; botEl.querySelector('.e7c-answer').insertBefore(n, botEl.querySelector('.e7c-body')); }
                                else if (evt.type === 'error') { showError(botEl, evt.message || 'Error'); setStatus('error', 'Error'); }
                            }
                        }
                    }
                } catch (err) {
                    if (err && err.name === 'AbortError') stopped = true;
                    else failed = 'Connection error \u2014 please try again.';
                } finally {
                    if (rq) { cancelAnimationFrame(rq); rq = null; }
                    clearTool(botEl);
                    if (failed === 'session') {
                        botEl.querySelector('.e7c-body').innerHTML = '';
                        showError(botEl, 'Your session has ended. Sign in to RDPMS again, then ask your question.');
                        setStatus('error', 'Not signed in');
                    } else {
                        if (botText) {
                            setBotText(botEl, botText, false);
                            const msg = { role: 'assistant', content: botText }; if (stopped) msg.stopped = true;
                            if (planData) msg.plan = planData;   // 1.6.0.0 (merge): saved with the chat so the cards come back when it is reopened
                            c.messages.push(msg); c.updated = Date.now(); saveConvos(); renderList();
                            addActions(botEl, botText, true, stopped);
                            if (!stopped && !failed) addFollowUps(botEl, text, botText);
                        } else {
                            botEl.querySelector('.e7c-body').innerHTML = '';
                            if (stopped) { const n = document.createElement('div'); n.className = 'e7c-note'; n.textContent = 'Stopped before any answer arrived.'; botEl.querySelector('.e7c-extra').appendChild(n); }
                            else if (!failed && !botEl.querySelector('.e7c-err')) { const n = document.createElement('div'); n.className = 'e7c-note'; n.textContent = 'No answer was returned. Try rephrasing the question.'; botEl.querySelector('.e7c-extra').appendChild(n); }
                        }
                        if (failed) { showError(botEl, failed); setStatus('error', 'Error'); }
                        else if (!botEl.querySelector('.e7c-err')) { setStatus('online', 'Ready'); }
                    }
                    isStreaming = false; controller = null; setSendMode(); scrollDown(false); inputEl.focus();
                }
            }
            function regenerate() {
                const c = current(); if (!c || isStreaming) return;
                if (c.messages.length && c.messages[c.messages.length - 1].role === 'assistant') c.messages.pop();
                let lastUser = null;
                for (let i = c.messages.length - 1; i >= 0; i--) { if (c.messages[i].role === 'user') { lastUser = c.messages[i]; break; } }
                if (!lastUser) return;
                saveConvos();
                const bots = threadEl.querySelectorAll('.e7c-msg.bot'); if (bots.length) bots[bots.length - 1].remove();
                send(lastUser.content, { regenerate: true });
            }

            /* ---------- input ---------- */
            function onInput() {
                inputEl.style.height = 'auto'; inputEl.style.height = Math.min(inputEl.scrollHeight, 200) + 'px';
                countEl.textContent = inputEl.value.length + ' / ' + MAX_CHARS;
                if (!isStreaming) sendBtn.disabled = !inputEl.value.trim();
            }
            function bindEvents() {
                inputEl.addEventListener('input', onInput);
                inputEl.addEventListener('keydown', function (e) { if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); if (!isStreaming) send(); } else if (e.key === 'Escape' && activePrompt) { cancelPrompt(); } });
                sendBtn.addEventListener('click', function () { if (isStreaming) { if (controller) controller.abort(); } else { send(); } });
                document.getElementById('e7cNew').addEventListener('click', newChat);
                document.getElementById('e7cSearch').addEventListener('input', function () { query = this.value.trim(); renderList(); });
                document.getElementById('e7cClear').addEventListener('click', function () {
                    if (isStreaming || !convos.length || !window.confirm('Delete all ' + convos.length + ' chats saved on this computer?')) return;
                    convos = []; currentId = null; saveConvos(); renderList(); renderThread();
                });
                document.getElementById('e7cMenu').addEventListener('click', function () { appEl.classList.toggle('nav-open'); });
                document.getElementById('e7cScrim').addEventListener('click', function () { appEl.classList.remove('nav-open'); });
                document.getElementById('e7cAskCancel').addEventListener('click', function () { cancelPrompt(); inputEl.focus(); });
                listEl.addEventListener('click', function (e) {
                    const o = e.target.closest('[data-open]'); if (o) { openConvo(o.getAttribute('data-open')); return; }
                    const d = e.target.closest('[data-del]'); if (d) { deleteConvo(d.getAttribute('data-del')); }
                });
                function onPick(e) {
                    const cat = e.target.closest('[data-cat]'); if (cat) { activeCat = cat.getAttribute('data-cat'); threadEl.querySelectorAll('[data-cat]').forEach(function (b) { b.setAttribute('aria-pressed', String(b === cat)); }); renderPrompts(); return; }
                    const pr = e.target.closest('[data-prompt]'); if (pr) { const c = PROMPT_CATEGORIES.find(function (x) { return x.id === activeCat; }); if (c) selectPrompt(c.prompts[+pr.getAttribute('data-prompt')]); }
                }
                threadEl.addEventListener('click', onPick);
            }
            function init() {
                mount = document.getElementById('e7ChatBotMount'); if (!mount) return;
                buildHTML(); loadConvos(); bindEvents();
                currentId = null; renderList(); renderThread(); setSendMode(); pingStatus(); inputEl.focus();
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
        })();

</script>
