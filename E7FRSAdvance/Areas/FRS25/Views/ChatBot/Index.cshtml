                appEl = document.getElementById('e7cApp'); listEl = document.getElementById('e7cList'); threadEl = document.getElementById('e7cThread');
                scrollEl = document.getElementById('e7cScroll'); inputEl = document.getElementById('e7cInput'); sendBtn = document.getElementById('e7cSend');
                titleEl = document.getElementById('e7cTitle'); statusEl = document.getElementById('e7cStatus'); askEl = document.getElementById('e7cAsk');
                askTextEl = document.getElementById('e7cAskText'); countEl = document.getElementById('e7cCount');
                mainEl = document.getElementById('e7cMain');
            }
            function setEmpty(on) { mainEl.classList.toggle('is-empty', !!on); }
            function setStatus(state, text) { statusEl.className = 'e7c-status ' + state; statusEl.lastChild.textContent = text; }
            async function pingStatus() {
                setStatus('connecting', 'Connecting\u2026');
