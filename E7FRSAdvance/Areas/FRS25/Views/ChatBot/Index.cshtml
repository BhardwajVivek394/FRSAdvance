    }

    .ai-msg.user .ai-msg-bubble code {
        color: #fff;
        background: rgba(255,255,255,.12);
        border-color: rgba(255,255,255,.18);
    }

    .ai-msg-bubble pre {
        max-width: 100%;
        margin: 9px 0 3px;
        padding: 12px 14px;
        overflow-x: auto;
        color: #d8e7f2;
        background: #102b3e;
        border: 1px solid #24475e;
        border-radius: 8px;
    }

        .ai-msg-bubble pre code {
            padding: 0;
            color: inherit;
            background: transparent;
            border: 0;
        }

    .ai-msg-bubble table {
        width: 100%;
        margin: 9px 0;
        border-collapse: separate;
        border-spacing: 0;
        overflow: hidden;
        border: 1px solid var(--e7-border);
        border-radius: 8px;
        font-size: 11.5px;
    }

    .ai-msg-bubble th,
    .ai-msg-bubble td {
        padding: 7px 9px;
        border-right: 1px solid var(--e7-border-soft);
        border-bottom: 1px solid var(--e7-border-soft);
        text-align: left;
    }

    .ai-msg-bubble th {
        color: #27465f;
        background: #edf4f8;
        font-weight: 700;
    }

    .ai-msg-time {
        margin-top: 4px;
        padding: 0 2px;
        color: var(--e7-text-soft);
        font-size: 9.5px;
        font-weight: 500;
    }

    .ai-typing-bubble {
        display: inline-flex;
        gap: 4px;
        padding: 12px 16px;
        background: #fff;
        border: 1px solid var(--e7-border);
        border-radius: 4px 13px 13px 13px;
        box-shadow: 0 4px 14px rgba(30,62,88,.055);
    }

    .ai-typing-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--e7-accent);
        animation: e7typingBounce 1.2s ease-in-out infinite;
    }

        .ai-typing-dot:nth-child(2) {
            animation-delay: .15s;
        }

        .ai-typing-dot:nth-child(3) {
            animation-delay: .30s;
        }

    @@keyframes e7typingBounce {
        0%, 60%, 100% {
            transform: translateY(0);
            opacity: .4;
        }

        30% {
            transform: translateY(-4px);
            opacity: 1;
        }
    }

    /* Composer */
    .ai-chat-input-area {
        position: relative;
        z-index: 2;
        flex-shrink: 0;
        padding: 11px 20px 13px;
        background: rgba(255,255,255,.98);
        border-top: 1px solid var(--e7-border);
        box-shadow: 0 -10px 28px rgba(27,63,90,.04);
    }

    .ai-input-wrapper {
        width: 100%;
        max-width: 920px;
        min-height: 48px;
        margin: 0 auto;
        padding: 6px 7px 6px 14px;
        display: flex;
        align-items: flex-end;
        gap: 9px;
        background: #fff;
        border: 1px solid #cfdbe5;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(32,67,91,.05);
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        .ai-input-wrapper:focus-within {
            border-color: var(--e7-accent);
            box-shadow: 0 0 0 3px rgba(20,167,191,.12), 0 4px 14px rgba(32,67,91,.06);
        }

    #aiChatInput {
        flex: 1;
        min-height: 34px;
        max-height: 108px;
        padding: 7px 0 5px;
        resize: none;
        outline: none;
        color: var(--e7-text);
        background: transparent;
        border: 0;
        font-family: inherit;
        font-size: 13px;
        line-height: 1.5;
    }

        #aiChatInput::placeholder {
            color: #96a5b3;
        }

    .ai-send-btn {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(135deg, #0b5d88, #0e91ae);
        border: 0;
        border-radius: 8px;
        box-shadow: 0 5px 12px rgba(11,93,136,.22);
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease, opacity .15s ease;
    }

        .ai-send-btn svg {
            width: 15px;
            height: 15px;
        }

        .ai-send-btn:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 7px 16px rgba(11,93,136,.28);
        }

        .ai-send-btn:disabled {
            opacity: .34;
            cursor: default;
            box-shadow: none;
        }

    .e7-input-footer {
        width: 100%;
        max-width: 920px;
        margin: 6px auto 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .e7-input-hint,
    .e7-char-count {
        color: var(--e7-text-soft);
        font-size: 9.5px;
        letter-spacing: .01em;
    }

    @@media (max-width: 768px) {
        #e7ChatBotMount {
            height: calc(100vh - 112px);
            min-height: 500px;
            padding: 6px;
        }

        #e7cbChatPanel {
            border-radius: 10px;
        }

        .ai-chat-header {
            min-height: 64px;
            padding: 10px 12px;
            gap: 9px;
        }

        .ai-chat-avatar {
            width: 38px;
            height: 38px;
        }

        .ai-chat-header-status {
            display: none;
        }

        .ai-chat-header-btn {
            width: 32px;
            min-width: 32px;
            padding: 0;
        }

            .ai-chat-header-btn .e7-btn-text {
                display: none;
            }

        .ai-chat-messages-inner {
            padding: 18px 13px;
            gap: 13px;
        }

        .ai-msg > div:last-child {
            max-width: calc(100% - 42px);
        }

        .ai-chat-input-area {
            padding: 9px 10px 10px;
        }
    }

    @@media (max-width: 480px) {
        .ai-chat-brand-kicker {
            display: none;
        }

        .ai-chat-header-title {
            font-size: 13px;
        }

        .ai-chat-header-actions {
            gap: 4px;
        }

        .ai-msg-avatar {
            width: 28px;
            height: 28px;
            border-radius: 8px;
        }

        .ai-msg-bubble {
            padding: 10px 12px;
            font-size: 12.5px;
        }

        .e7-input-hint {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
    }
</style>

<!-- Hidden marker so the widget's getUserInitial() shows the real user's initial -->
<span class="e7-user-name" style="display:none">@__userName</span>

@* FRS advance port: the FRS25 layout loads the global AI chat sidebar (ai-chat-sidebar.js/.css) and styles it by
   id/class (#aiChatPanel, .e7-welcome, .e7-prompt-btn ...). This page IS the chat, so: the sidebar script is told to
   stand down (window.E7AI_PAGE_OWNS_CHAT, checked at the top of ai-chat-sidebar.js), its stylesheet is disabled here,
   the page panel id is e7cbChatPanel (was aiChatPanel) so the layout's #aiChatPanel overrides do not hit it, and the
