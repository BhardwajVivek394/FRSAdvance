                setEmpty(false);
                c.messages.forEach(function (m, i) {
                    if (m.role === 'user') { appendUser(m.content); }
                    else if (m.role === 'assistant') { const el = appendBot(); setBotText(el, m.content, false); addActions(el, m.content, i === c.messages.length - 1, !!m.stopped); }
                });
                scrollDown(true);
