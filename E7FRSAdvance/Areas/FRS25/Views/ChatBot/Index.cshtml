    }

    .ai-msg-bubble .pc-v { font-size: 12.5px; line-height: 1.5; }
    .ai-msg-bubble .pc-row.pc-action .pc-v { font-weight: 600; color: var(--e7-primary-dark); }
    .ai-msg-bubble .pc-row.pc-note .pc-v { font-size: 11.5px; color: #64748b; font-style: italic; }

    @@media (max-width: 560px) {
        .ai-msg-bubble .pc-row { grid-template-columns: 1fr; gap: 2px; }
    }

    /* v1.2.9.4: block markup produced by renderMarkdown -- headings, rules, lists, quotes.
       Answers are structured documents now, so they need document typography. */
    .ai-msg-bubble .md-h {
        margin: 14px 0 6px;
        color: var(--e7-primary-dark);
        font-weight: 700;
        line-height: 1.3;
        letter-spacing: .1px;
    }

    .ai-msg-bubble .md-h:first-child {
        margin-top: 0;
    }

    .ai-msg-bubble h2.md-h {
        padding-bottom: 5px;
        border-bottom: 1px solid var(--e7-border);
        font-size: 14.5px;
    }

    .ai-msg-bubble h3.md-h {
        font-size: 13.5px;
    }

    .ai-msg-bubble h4.md-h {
        font-size: 12.5px;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: var(--e7-accent);
    }

    .ai-msg-bubble .md-hr {
        margin: 13px 0;
        border: 0;
        border-top: 1px solid var(--e7-border);
    }

    .ai-msg-bubble .md-list {
        margin: 6px 0 8px;
        padding-left: 20px;
    }

    .ai-msg-bubble .md-list li {
        margin: 3px 0;
        padding-left: 2px;
    }

    .ai-msg-bubble .md-list li::marker {
        color: var(--e7-accent);
        font-weight: 700;
    }

    .ai-msg-bubble .md-q {
        margin: 8px 0;
        padding: 7px 12px;
        border-left: 3px solid var(--e7-accent);
        background: var(--e7-accent-soft);
        border-radius: 0 8px 8px 0;
        color: var(--e7-primary-dark);
    }

    .ai-msg.user .ai-msg-bubble .md-h,
    .ai-msg.user .ai-msg-bubble .md-q {
        color: #fff;
        border-color: rgba(255,255,255,.25);
        background: transparent;
    }

    .ai-msg.user .ai-msg-bubble .md-list li::marker {
        color: rgba(255,255,255,.75);
    }

    .ai-msg-bubble code {
        padding: 2px 5px;
        color: #075985;
        background: #e9f3f7;
        border: 1px solid #d8e8ef;
        border-radius: 4px;
