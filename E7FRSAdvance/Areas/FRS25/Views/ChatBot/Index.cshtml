                    const r = await fetch(STATUS_ENDPOINT, { credentials: 'same-origin' });
                    const ct = (r.headers.get('content-type') || '').toLowerCase();
                    if (r.status === 401 || r.redirected || ct.indexOf('text/html') >= 0) { setStatus('error', 'Not signed in'); return; }
