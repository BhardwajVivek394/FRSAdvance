.e7-input-label svg { width: 12px; height: 12px; margin-right: 4px; vertical-align: -2px; }
.e7-input-label em { color: #7e909e !important; }
.e7-label-cancel {
  margin-left: auto;
  padding: 2px 6px;
  color: #718493;
  background: transparent;
  border: 0;
  border-radius: 4px;
  cursor: pointer;
  font-family: inherit;
  font-size: 9px;
  font-weight: 600;
}
.e7-label-cancel:hover { color: #9e3841; background: #fff0f1; }

/* TOOL STATUS */
.e7-tool-badge {
  width: fit-content;
  margin: 0 0 0 41px;
  padding: 6px 10px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #6d5a22;
  background: #fff9e9;
  border: 1px solid #eadcae;
