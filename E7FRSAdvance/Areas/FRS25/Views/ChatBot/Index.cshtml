@{

    var __userName = E7FRSAdvance.Utility.ClsHttpContent.LoginUser != null
        ? E7FRSAdvance.Utility.ClsHttpContent.LoginUser.FirstName
        : "User";

    // v1.2.1.0: engine picker for site-keeping users and the configured emails only. Decided HERE,
    // in Razor, because the page renders synchronously -- the controller cannot read LoginUser after
    // its first await (the ConfigureAwait(false) trap fixed in AiChat 1.0.160.85).
    var __lu = E7FRSAdvance.Utility.ClsHttpContent.LoginUser;
    var __overrideList = (System.Configuration.ConfigurationManager.AppSettings["SiteKeepingOverrideEmails"] ?? "");
    var __email = (__lu != null && __lu.EmailAddress != null) ? __lu.EmailAddress.Trim() : "";
    // Plain loop rather than .Any() -- this view has no @using System.Linq, and adding one for a
    // single call is a wider change than the check deserves.
    var __privileged = (__lu != null && __lu.IsSiteKeeping);
    if (!__privileged && __email.Length > 0 && __overrideList.Length > 0)
    {
        foreach (var __e in __overrideList.Split(new char[] { ',', ';' }))
        {
            if (string.Equals(__e.Trim(), __email, StringComparison.OrdinalIgnoreCase))
            {
                __privileged = true;
                break;
            }
        }
    }
    var __engineBrand = System.Configuration.ConfigurationManager.AppSettings["AiEngineBrand"] ?? "ENERGY7 ULTRA";

    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Chatbot";

}
<style>
    /* ================================================================
       ENERGY7 RDPMS AI ASSISTANT - enterprise page UI
       Presentation-only update. Chat endpoints and streaming logic stay intact.
       ================================================================ */
    #e7ChatBotMount,
    #e7ChatBotMount *,
    #e7ChatBotMount *::before,
    #e7ChatBotMount *::after {
        box-sizing: border-box;
    }

    #e7ChatBotMount {
        --e7-primary: var(--primary, var(--bs-primary, #0b6fae));
        --e7-primary-dark: #0b3558;
        --e7-primary-deep: #082b49;
        --e7-accent: #14a7bf;
        --e7-accent-soft: #e8f7fa;
        --e7-page: #eef3f8;
        --e7-surface: #ffffff;
        --e7-surface-muted: #f6f8fb;
        --e7-border: #dce5ee;
        --e7-border-soft: #eaf0f5;
        --e7-text: #1c2b39;
        --e7-text-muted: #6b7c8d;
        --e7-text-soft: #93a2b1;
        display: flex;
        width: 100%;
        height: calc(100vh - 136px);
        min-height: 560px;
        padding: 12px;
        background: radial-gradient(circle at 4% 0%, rgba(20,167,191,.10), transparent 28%), linear-gradient(180deg, #f5f8fb 0%, var(--e7-page) 100%);
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    }

    #aiChatTrigger,
    #aiChatOverlay,
    #aiFullscreenBtn {
        display: none !important;
    }

    #e7cbChatPanel {
        position: relative;
        isolation: isolate;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        color: var(--e7-text);
        background: var(--e7-surface);
        border: 1px solid rgba(11,53,88,.13);
        border-radius: 14px;
        box-shadow: 0 18px 46px rgba(23,52,77,.12), 0 2px 8px rgba(23,52,77,.06);
    }

        #e7cbChatPanel::before {
            content: "";
            position: absolute;
            z-index: 3;
            inset: 0 0 auto;
            height: 3px;
            background: linear-gradient(90deg, var(--e7-accent), #3f8dcc 58%, #7cc7d7);
        }

    /* Header */
    .ai-chat-header {
        position: relative;
        z-index: 2;
        flex-shrink: 0;
        min-height: 72px;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 13px 18px;
        color: #fff;
        background: radial-gradient(circle at 85% 15%, rgba(38,177,199,.20), transparent 30%), linear-gradient(112deg, var(--e7-primary-deep), var(--e7-primary-dark) 58%, #0b5575);
        border-bottom: 1px solid rgba(255,255,255,.08);
    }

    .ai-chat-brand {
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .ai-chat-avatar {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        background: linear-gradient(145deg, rgba(255,255,255,.22), rgba(255,255,255,.08));
        border: 1px solid rgba(255,255,255,.25);
        border-radius: 11px;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.18), 0 8px 20px rgba(0,0,0,.14);
    }

        .ai-chat-avatar svg {
            width: 21px;
            height: 21px;
        }

    .ai-chat-header-info {
        min-width: 0;
    }

    .ai-chat-brand-kicker {
        margin-bottom: 1px;
        color: rgba(255,255,255,.62);
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
    }

    .ai-chat-header-title {
        overflow: hidden;
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: -.01em;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ai-chat-header-status {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
        min-height: 28px;
        padding: 5px 10px;
        color: rgba(255,255,255,.82);
        background: rgba(255,255,255,.09);
        border: 1px solid rgba(255,255,255,.13);
        border-radius: 999px;
        font-size: 10.5px;
        font-weight: 600;
        backdrop-filter: blur(8px);
    }

    .ai-chat-status-dot {
        width: 7px;
        height: 7px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #56d88f;
        box-shadow: 0 0 0 3px rgba(86,216,143,.14);
    }

        .ai-chat-status-dot.connecting {
            background: #f8c35c;
            box-shadow: 0 0 0 3px rgba(248,195,92,.14);
            animation: e7pulse 1.2s ease-in-out infinite;
        }

        .ai-chat-status-dot.error {
            background: #ff7a7a;
            box-shadow: 0 0 0 3px rgba(255,122,122,.14);
        }

    @@keyframes e7pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .35;
        }
    }

    .ai-chat-header-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-shrink: 0;
    }

    .ai-chat-header-btn {
        min-width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 0 10px;
        color: rgba(255,255,255,.84);
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 8px;
        cursor: pointer;
        font-family: inherit;
        font-size: 11px;
        font-weight: 600;
        transition: background .15s ease, border-color .15s ease, transform .15s ease;
    }

        .ai-chat-header-btn:hover {
            color: #fff;
            background: rgba(255,255,255,.15);
            border-color: rgba(255,255,255,.28);
            transform: translateY(-1px);
        }

        .ai-chat-header-btn svg {
            width: 14px;
            height: 14px;
            flex-shrink: 0;
        }

    /* Conversation */
    .ai-chat-messages {
        position: relative;
        flex: 1;
        overflow-x: hidden;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        background: linear-gradient(rgba(255,255,255,.94), rgba(255,255,255,.94)), radial-gradient(circle at 1px 1px, #bfd0dd 1px, transparent 1.2px);
        background-size: auto, 24px 24px;
        scrollbar-width: thin;
        scrollbar-color: #c7d4de transparent;
    }

        .ai-chat-messages::-webkit-scrollbar {
            width: 6px;
        }

        .ai-chat-messages::-webkit-scrollbar-track {
            background: transparent;
        }

        .ai-chat-messages::-webkit-scrollbar-thumb {
            background: #c7d4de;
            border-radius: 8px;
        }

    .ai-chat-messages-inner {
        flex: 1;
        width: 100%;
        max-width: 980px;
        min-height: 100%;
        margin: 0 auto;
        padding: 26px 30px 22px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    @@keyframes e7msgIn {
        from {
            opacity: 0;
            transform: translateY(7px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .ai-msg {
        width: 100%;
        max-width: 100%;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        animation: e7msgIn .2s ease-out;
    }

        .ai-msg.user {
            flex-direction: row-reverse;
        }

            .ai-msg.user > div:last-child {
                align-items: flex-end;
            }

    .ai-msg-avatar {
        width: 31px;
        height: 31px;
        margin-top: 1px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        border-radius: 9px;
        font-size: 10.5px;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(17,57,88,.12);
    }

    .ai-msg.ai .ai-msg-avatar {
        background: linear-gradient(145deg, var(--e7-primary-dark), #117fa1);
    }

    .ai-msg.user .ai-msg-avatar {
        background: linear-gradient(145deg, #617489, #34495d);
    }

    .ai-msg > div:last-child {
        max-width: min(78%, 760px);
        display: flex;
        flex-direction: column;
    }

    .ai-msg-bubble {
        position: relative;
        padding: 11px 14px;
        color: var(--e7-text);
        background: #fff;
        border: 1px solid var(--e7-border);
        border-radius: 4px 13px 13px 13px;
        box-shadow: 0 4px 14px rgba(30,62,88,.055);
        font-size: 13px;
        line-height: 1.62;
        overflow-wrap: anywhere;
        word-break: normal;
    }

    .ai-msg.user .ai-msg-bubble {
        color: #fff;
        background: linear-gradient(135deg, #0b557d, #0b78a5);
        border-color: transparent;
        border-radius: 13px 4px 13px 13px;
        box-shadow: 0 5px 16px rgba(11,85,125,.16);
    }

    .ai-msg.ai.ai-msg-error .ai-msg-bubble {
        color: #a53842;
        background: #fff5f5;
        border-color: #f2c9cd;
    }

    .ai-msg-bubble strong {
        color: #173b57;
    }

    .ai-msg.user .ai-msg-bubble strong {
        color: #fff;
    }

    /* v1.2.9.5: maintenance plan cards ([[CARD]] blocks) */
    .ai-msg-bubble .plan-card {
        margin: 10px 0;
        border: 1px solid var(--e7-border);
        border-left: 4px solid #94a3b8;
        border-radius: 10px;
        background: #fff;
        box-shadow: 0 2px 8px rgba(30,62,88,.06);
        overflow: hidden;
    }

    .ai-msg-bubble .plan-card.urgent { border-left-color: #dc2626; }
    .ai-msg-bubble .plan-card.soon { border-left-color: #d97706; }
    .ai-msg-bubble .plan-card.monitor { border-left-color: #059669; }

    .ai-msg-bubble .pc-head {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding: 9px 12px;
        background: #f6f9fc;
        border-bottom: 1px solid var(--e7-border);
    }

    .ai-msg-bubble .pc-pill {
        padding: 2px 9px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .6px;
        color: #fff;
        background: #94a3b8;
    }

    .ai-msg-bubble .plan-card.urgent .pc-pill { background: #dc2626; }
    .ai-msg-bubble .plan-card.soon .pc-pill { background: #d97706; }
    .ai-msg-bubble .plan-card.monitor .pc-pill { background: #059669; }

    .ai-msg-bubble .pc-asset {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--e7-primary-dark);
    }

    .ai-msg-bubble .pc-sub {
        font-size: 11px;
        color: #64748b;
    }

    .ai-msg-bubble .pc-body { padding: 4px 12px 9px; }

    .ai-msg-bubble .pc-row {
        display: grid;
        grid-template-columns: 128px 1fr;
        gap: 10px;
        padding: 5px 0;
        border-bottom: 1px dashed rgba(15,23,42,.07);
    }

    .ai-msg-bubble .pc-row:last-child { border-bottom: 0; }

    .ai-msg-bubble .pc-k {
