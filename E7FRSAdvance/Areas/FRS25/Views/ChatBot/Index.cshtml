  .e7-cat-tabs { width: 100%; }
  .e7-prompt-list { grid-template-columns: 1fr; }
  .e7-prompt-list .e7-prompt-btn:nth-child(n+4) { display: none; }
  .e7-input-label { font-size: 9px; }
}
`;
                document.head.appendChild(s);
            }

            /* ══════════════════════════════════════════════════════════
               BIND
            ══════════════════════════════════════════════════════════ */
            function bindRefs() {
                panel = document.getElementById('e7cbChatPanel');
                // Use the inner container for all message appends
                messagesEl = document.getElementById('aiMessagesInner');
                inputEl = document.getElementById('aiChatInput');
                sendBtn = document.getElementById('aiSendBtn');
                statusDot = document.getElementById('aiStatusDot');
                statusText = document.getElementById('aiStatusText');
                charCountEl = document.getElementById('e7CharCount');
            }

            function bindEvents() {
                // Close (✕) leaves the page instead of hiding the panel —
                // there's nothing behind it on this standalone page.
                document.getElementById('aiCloseBtn').addEventListener('click', function () {
                    window.location.href = '@Url.Action("Index", "ChatBot", new { Area = "FRS25" })';
                });
                document.getElementById('aiClearBtn').addEventListener('click', clearChat);
                var _expBtn = document.getElementById('aiExportBtn');
                if (_expBtn) _expBtn.addEventListener('click', exportChatPdf);
                // v1.2.9.6 (#1): delegated per-message actions (reply / edit / export).
                messagesEl.addEventListener('click', onMsgAction);
                sendBtn.addEventListener('click', sendMessage);

                inputEl.addEventListener('input', function () {
                    autoResize(this);
                    sendBtn.disabled = !this.value.trim() || isStreaming;
                    if (charCountEl) charCountEl.textContent = this.value.length + ' / 500';
                });

                inputEl.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        if (!sendBtn.disabled) sendMessage();
                    }
                    if (e.key === 'Escape') cancelPrompt();
                });
            }

            /* ══════════════════════════════════════════════════════════
               PANEL
            ══════════════════════════════════════════════════════════ */
            function openChat() {
                isOpen = true;
                if (!messagesEl.children.length) {
                    if (chatHistory.length) renderSavedHistory();
                    else renderWelcome();
                }
                renderPromptPanel();
                setTimeout(() => inputEl.focus(), 150);
            }

            function renderSavedHistory() {
                chatHistory.forEach(item => {
                    if (!item || !item.content) return;
                    if (item.role === 'user') appendUserMsg(item.content);
                    else if (item.role === 'assistant') appendBotMsg(item.content, false);
                });
            }

            function clearChat() {
                chatHistory = [];
                saveHistory();
                messagesEl.innerHTML = '';
                cancelPrompt();
                renderWelcome();
            }

            /* ══════════════════════════════════════════════════════════
               WELCOME
            ══════════════════════════════════════════════════════════ */
            // v1.2.6.0: professional, ready-to-run example prompts shown on the welcome screen in
            // place of the capability-card grid.
            const E7_SAMPLE_LINES = [
                'Show live values for 11T at Arnetha',
                'Last 10 readings for asset 2T',
                'Any active alerts today?',
                'Asset health for PM07'
            ];

            function renderWelcome() {
                const el = document.createElement('div');
                el.className = 'e7-welcome';
                el.id = 'e7WelcomeBlock';
                el.innerHTML = `
                  <div class="e7-welcome-hero">
                    <div class="e7-welcome-eyebrow">Railway asset intelligence</div>
                    <h3>Operational answers from your RDPMS data</h3>
                    <p>Ask about live values, active alerts, device timestamps, recent history, asset health and site-level status across tracks, signals and point machines.</p>
                    <div class="e7-welcome-security">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
                      </svg>
                      Restricted to authorised RDPMS operational data
                    </div>
                  </div>
                  <div class="e7-welcome-suggest">
                    <span class="e7-suggest-label">Try asking</span>
                    <div class="e7-suggest-list">
                      ${E7_SAMPLE_LINES.map(sx => `<button type="button" class="e7-suggest-chip">${esc(sx)}</button>`).join('')}
                    </div>
                  </div>`;
                messagesEl.appendChild(el);

                // v1.2.6.0: sample lines fill the composer (the operator can adjust the site/asset
                // before sending) -- the normal send path; no capability grid.
                el.querySelectorAll('.e7-suggest-chip').forEach(chip => {
                    chip.addEventListener('click', () => {
                        cancelPrompt();
                        inputEl.value = chip.textContent;
                        inputEl.dispatchEvent(new Event('input'));
                        inputEl.focus();
                    });
                });
            }

            function getCategoryIcon(id) {
                const icons = {
                    alerts: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"/><path d="M10 21h4"/></svg>',
                    live: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l2-6 4 12 2-6h6"/></svg>',
                    history: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v5h5"/><path d="M3.5 8A9 9 0 1 1 6 18.5"/><path d="M12 7v5l3 2"/></svg>',
                    timestamps: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
                    search: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>',
                    health: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13h4l2-5 4 9 2-4h4"/><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/></svg>'
                };
                return icons[id] || icons.search;
            }

            /* ══════════════════════════════════════════════════════════
               PROMPT PANEL — category tabs + prompt list
            ══════════════════════════════════════════════════════════ */
            function renderPromptPanel(openCatId) {
                const panelEl = document.getElementById('e7PromptPanel');

                if (!openCatId) openCatId = activeCategory || PROMPT_CATEGORIES[0].id;
                activeCategory = openCatId;

                const cat = PROMPT_CATEGORIES.find(c => c.id === openCatId);

                panelEl.innerHTML = `
                  <div class="e7-prompt-inner">
                    <div class="e7-prompt-toolbar">
                      <div class="e7-prompt-heading">
                        <strong>Quick queries</strong>
                        <span>Choose a data request</span>
                      </div>
                      ${E7_ENGINE_PICKER}
                      <div class="e7-cat-tabs" role="tablist" aria-label="Query categories">
                        ${PROMPT_CATEGORIES.map(c => `
                          <button type="button" class="e7-cat-tab ${c.id === openCatId ? 'active' : ''}" data-cat="${c.id}" role="tab" aria-selected="${c.id === openCatId}">
                            ${getCategoryIcon(c.id)}<span>${c.label}</span>
                          </button>`).join('')}
                      </div>
                    </div>
                    <div class="e7-prompt-list">
                      ${cat.prompts.map((p, i) => `
                        <button type="button" class="e7-prompt-btn" data-cat="${openCatId}" data-idx="${i}">
                          <span>${p.label}</span>
                          <span class="e7-prompt-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg></span>
                        </button>`).join('')}
                    </div>
                  </div>`;

                panelEl.querySelectorAll('.e7-cat-tab').forEach(tab => {
                    tab.addEventListener('click', () => {
                        cancelPrompt();
                        renderPromptPanel(tab.dataset.cat);
                    });
                });

                panelEl.querySelectorAll('.e7-prompt-btn').forEach(btn => {
                    btn.addEventListener('click', () => {
                        const cat2 = PROMPT_CATEGORIES.find(c => c.id === btn.dataset.cat);
                        const pmt = cat2.prompts[parseInt(btn.dataset.idx)];
                        selectPrompt(pmt, btn);
                    });
                });
            }

            function selectPrompt(prompt, btnEl) {
                document.querySelectorAll('.e7-prompt-btn').forEach(b => b.classList.remove('active'));
                if (btnEl) btnEl.classList.add('active');

                activePrompt = prompt;

                const label = document.getElementById('e7InputLabel');
                const askText = prompt.ask === 'site' ? 'Enter site name' : 'Enter asset name (e.g. 2T, SH04, PM07)';
                label.style.display = 'flex';
                label.innerHTML = `
                  <span>${getCategoryIcon(activeCategory)} ${esc(prompt.label)}&nbsp;·&nbsp;<em>${askText}</em></span>
                  <button type="button" class="e7-label-cancel" id="e7CancelBtn">Cancel</button>`;
                document.getElementById('e7CancelBtn').addEventListener('click', cancelPrompt);

                inputEl.placeholder = prompt.ask === 'site'
                    ? 'Type site name, e.g. Arnetha, Patliputra…'
                    : 'Type asset name, e.g. 2T, 11T, SH04, PM07…';

                inputEl.value = '';
                inputEl.dispatchEvent(new Event('input'));
                inputEl.focus();
            }

            function cancelPrompt() {
                activePrompt = null;
                document.querySelectorAll('.e7-prompt-btn').forEach(b => b.classList.remove('active'));
                const label = document.getElementById('e7InputLabel');
                if (label) label.style.display = 'none';
                inputEl.placeholder = 'Ask about a site, asset, alert, health value or recent history…';
                inputEl.value = '';
                inputEl.dispatchEvent(new Event('input'));
            }

            /* ══════════════════════════════════════════════════════════
               SEND
            ══════════════════════════════════════════════════════════ */
            async function sendMessage() {
                const raw = inputEl.value.trim();
                if (!raw || isStreaming) return;

                let text;

                if (activePrompt) {
                    text = activePrompt.tpl.replace('{input}', raw);
                    cancelPrompt();
                } else {
                    if (isOutOfScope(raw)) {
                        appendUserMsg(raw);
                        inputEl.value = '';
                        autoResize(inputEl);
                        sendBtn.disabled = true;
                        if (charCountEl) charCountEl.textContent = '0 / 500';
                        appendScopeRefusal();
                        return;
                    }
                    text = raw;
                }

                inputEl.value = '';
                autoResize(inputEl);
                sendBtn.disabled = true;
                if (charCountEl) charCountEl.textContent = '0 / 500';

                const welcome = document.getElementById('e7WelcomeBlock');
                if (welcome) welcome.remove();

                appendUserMsg(text);
                chatHistory.push({ role: 'user', content: text });
                if (chatHistory.length > MAX_HISTORY * 2)
                    chatHistory = chatHistory.slice(-MAX_HISTORY * 2);

                const typingEl = appendTyping();
                let activeBadge = null;
                let botText = '';
                _botMsgEl = null;
                isStreaming = true;
                setStatus('connecting', 'Fetching data…');

                try {
                    const res = await fetch(CHAT_ENDPOINT, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ messages: chatHistory, provider: E7_PROVIDER, pageContext: (window.E7_CHAT_CONTEXT && typeof window.E7_CHAT_CONTEXT === 'object') ? window.E7_CHAT_CONTEXT : null }),
                    });

                    if (res.status === 401) {
                        typingEl.remove();
                        appendBotMsg('Session expired — please sign in again.', true);
                        setStatus('error', 'Session expired');
                        return;
                    }
                    if (!res.ok) throw new Error('Server error ' + res.status);

                    const reader = res.body.getReader();
                    const decoder = new TextDecoder();
                    let buf = '';
                    typingEl.remove();

                    while (true) {
                        const { done, value } = await reader.read();
                        if (done) break;
                        buf += decoder.decode(value, { stream: true });
                        const lines = buf.split('\n');
                        buf = lines.pop();

                        for (const line of lines) {
                            if (!line.startsWith('data: ')) continue;
                            const raw2 = line.slice(6).trim();
                            if (raw2 === '[DONE]') continue;
                            let evt;
                            try { evt = JSON.parse(raw2); } catch { continue; }

                            if (evt.type === 'text') {
                                botText += evt.text;
                                streamBotBubble(botText);
                                if (activeBadge) { activeBadge.remove(); activeBadge = null; }
                            }
                            if (evt.type === 'tool_use') {
                                if (activeBadge) activeBadge.remove();
                                activeBadge = appendToolBadge(evt.name);
                                setStatus('connecting', 'Fetching data…');
                            }
                            if (evt.type === 'error') {
                                appendBotMsg('⚠ ' + (evt.message || 'Error'), true);
                                setStatus('error', 'Error');
                            }
                        }
                    }

                    if (botText) {
                        chatHistory.push({ role: 'assistant', content: botText });
                        saveHistory();
                        showFollowUps(text, botText);
                    }
                    setStatus('online', 'Ready');

                } catch (err) {
                    if (typingEl.parentNode) typingEl.remove();
                    appendBotMsg('Connection error — please try again.', true);
                    setStatus('error', 'Error');
                } finally {
                    if (activeBadge) activeBadge.remove();
                    isStreaming = false;
                    sendBtn.disabled = !inputEl.value.trim();
                    inputEl.focus();
                }
            }

            /* ══════════════════════════════════════════════════════════
               FOLLOW-UP CHIPS
            ══════════════════════════════════════════════════════════ */
            function showFollowUps(question, answer) {
                const q = question.toLowerCase();
                const a = answer.toLowerCase();
                const chips = [];

                const assetMatch = question.match(/\b(\d+T\d*|SH\d+|PM\d+|DL\d+|A10\d*)\b/i);
                const asset = assetMatch ? assetMatch[1] : null;

                if (asset) {
                    if (q.includes('tpr') || q.includes('current') || q.includes('live') || q.includes('value')) {
                        chips.push({ label: '📈 History today', prompt: `Show today's history for asset ${asset}` });
                        chips.push({ label: '🚨 Active alerts', prompt: `Show active alerts for asset ${asset}` });
                    }
                    if (q.includes('alert') || a.includes('alert')) {
                        chips.push({ label: '📋 Alert history 7d', prompt: `Show alert history for asset ${asset} over the last 7 days` });
                        chips.push({ label: '📊 Current values', prompt: `Show all current tag values for asset ${asset}` });
                    }
                    if (q.includes('history') || q.includes('reading')) {
                        chips.push({ label: '⏰ Last updated', prompt: `When was asset ${asset} last updated? Show TimestampDevice.` });
                        chips.push({ label: '🛠️ Health summary', prompt: `Give a health summary for asset ${asset}` });
                    }
                } else {
                    if (a.includes('alert') || q.includes('alert')) {
                        chips.push({ label: '📋 All active alerts', prompt: 'Show all active alerts' });
                    }
                    chips.push({
                        label: '🔍 Search asset', prompt: null, action: () => {
                            renderPromptPanel('search');
                            inputEl.focus();
                        }
                    });
                }

                if (!chips.length) return;

                if (_botMsgEl) {
                    const bubble = _botMsgEl.querySelector('.ai-msg-bubble');
                    if (bubble) {
                        const row = document.createElement('div');
                        row.className = 'e7-followup';
                        chips.slice(0, 4).forEach(chip => {
                            const btn = document.createElement('button');
                            btn.className = 'e7-followup-chip';
                            btn.textContent = chip.label;
                            btn.addEventListener('click', () => {
                                if (chip.action) { chip.action(); return; }
                                if (chip.prompt && !isStreaming) {
                                    chatHistory.push({ role: 'user', content: chip.prompt });
                                    inputEl.value = chip.prompt;
                                    sendMessage();
                                }
                            });
                            row.appendChild(btn);
                        });
                        bubble.appendChild(row);
                        scrollDown();
                    }
                }
            }

            /* ══════════════════════════════════════════════════════════
               SCOPE
            ══════════════════════════════════════════════════════════ */
            function isOutOfScope(text) {
                const l = text.toLowerCase();
                return OUT_OF_SCOPE.some(k => l.includes(k));
            }

            function appendScopeRefusal() {
                const el = document.createElement('div');
                el.className = 'ai-msg ai';
                el.innerHTML = `
                  <div class="ai-msg-avatar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="ai-msg-bubble">
                      I am not trained to answer that. I can only assist with EdgeX RDPMS railway monitoring data — asset values, history, alerts and timestamps.
                    </div>
                    <div class="ai-msg-time">${fmtTime()}</div>
                  </div>`;
                messagesEl.appendChild(el);
                scrollDown();
            }

            /* ══════════════════════════════════════════════════════════
               MESSAGES
            ══════════════════════════════════════════════════════════ */
            function appendUserMsg(text) {
                _botMsgEl = null;
                const el = document.createElement('div');
                el.className = 'ai-msg user';
                el.dataset.raw = text;   // v1.2.9.6 (#1): used by Edit and history rebuild
                el.innerHTML = `
                  <div class="ai-msg-avatar">${getUserInitial()}</div>
                  <div>
                    <div class="ai-msg-bubble">${esc(text)}</div>
                    <div class="ai-msg-meta">
                      <span class="ai-msg-time">${fmtTime()}</span>
                      <button type="button" class="e7-msg-act e7-msg-edit" title="Edit &amp; resend">Edit</button>
                    </div>
                  </div>`;
                messagesEl.appendChild(el);
                scrollDown();
                return el;
            }

            function streamBotBubble(content) {
                if (!_botMsgEl || !_botMsgEl.parentNode) {
                    _botMsgEl = document.createElement('div');
                    _botMsgEl.className = 'ai-msg ai';
                    _botMsgEl.innerHTML = `
                      <div class="ai-msg-avatar">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                          <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                        </svg>
                      </div>
                      <div>
                        <div class="ai-msg-bubble"></div>
                        <div class="ai-msg-meta">
                          <span class="ai-msg-time">${fmtTime()}</span>
                          <button type="button" class="e7-msg-act e7-msg-reply" title="Reply to this answer">Reply</button>
                          <button type="button" class="e7-msg-act e7-msg-export" title="Export this answer to PDF">PDF</button>
                        </div>
                      </div>`;
                    messagesEl.appendChild(_botMsgEl);
                }
                _botMsgEl.dataset.raw = content;   // v1.2.9.6 (#1/#3): latest full answer text
                _botMsgEl.querySelector('.ai-msg-bubble').innerHTML = renderMarkdown(content);
                scrollDown();
            }

            function appendBotMsg(text, isErr) {
                const el = document.createElement('div');
                el.className = 'ai-msg ai' + (isErr ? ' ai-msg-error' : '');
                if (!isErr) el.dataset.raw = text;   // v1.2.9.6 (#1/#3)
                const actions = isErr ? '' :
                    `<button type="button" class="e7-msg-act e7-msg-reply" title="Reply to this answer">Reply</button>
                     <button type="button" class="e7-msg-act e7-msg-export" title="Export this answer to PDF">PDF</button>`;
                el.innerHTML = `
                  <div class="ai-msg-avatar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="ai-msg-bubble">${isErr ? esc(text) : renderMarkdown(text)}</div>
                    <div class="ai-msg-meta">
                      <span class="ai-msg-time">${fmtTime()}</span>
                      ${actions}
                    </div>
                  </div>`;
                messagesEl.appendChild(el);
                scrollDown();
            }

            function appendTyping() {
                _botMsgEl = null;
                const el = document.createElement('div');
                el.className = 'ai-msg ai';
                el.innerHTML = `
                  <div class="ai-msg-avatar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                    </svg>
                  </div>
                  <div>
                    <div class="ai-typing-bubble">
                      <div class="ai-typing-dot"></div>
                      <div class="ai-typing-dot"></div>
                      <div class="ai-typing-dot"></div>
                    </div>
                  </div>`;
                messagesEl.appendChild(el);
                scrollDown();
                return el;
            }

            function appendToolBadge(name) {
                const TOOL_LABELS = {
                    search_sites: 'Searching sites…',
                    search_assets: 'Searching assets…',
                    search_tags: 'Searching tags…',
                    get_asset_tags: 'Loading tags…',
                    get_tag_current: 'Reading live value…',
                    get_live_values: 'Reading live values…',
                    state_get: 'Getting state…',
                    get_history: 'Loading history…',
                    get_history_compact: 'Loading history…',
                    get_limited_history: 'Loading recent readings…',
                    get_timestamps: 'Reading timestamps…',
                    get_alerts: 'Checking alerts…',
                    get_alert_history: 'Loading alert history…',
                    alert_smart: 'Summarising alerts…',
                    summary_get: 'Calculating summary…',
                    trend_get: 'Analysing trend…',
                };
                const label = TOOL_LABELS[name] || (name + '…');
                const el = document.createElement('div');
                el.className = 'e7-tool-badge';
                el.innerHTML = `<span class="e7-spinner"></span><span>${esc(label)}</span>`;
                messagesEl.appendChild(el);
                scrollDown();
                return el;
            }

            /* ══════════════════════════════════════════════════════════
               MARKDOWN
            ══════════════════════════════════════════════════════════ */
            // v1.2.9.4: the renderer had NO heading support, so "## Alert ka Summary" and "---"
            // reached the bubble as literal text -- that, not the styling, is why an answer read
            // like a dump. Headings, rules, ordered lists and blockquotes are handled here, and
            // the <br> pass no longer fires inside block markup (it was adding a blank line after
            // every </li> and </h3>, which is what made the spacing look broken).
            // v1.2.9.5: [[CARD]] blocks -> real cards. Runs BEFORE the markdown pass so a card
            // body is never mangled by the list/heading rules, and the card HTML is spliced back
            // in afterwards so the markdown pass cannot re-escape it. Anything that is not a
            // well-formed block is left completely alone -- a model that ignores the format
            // degrades to plain text instead of producing broken markup.
            const CARD_FIELDS = { '15-DAY': '15-day record', 'ML': 'Model classification', 'LASTOP': 'Last operation', 'ACTION': 'Action', 'NOTE': 'Note' };
            function renderPlanCards(raw, stash) {
                if (!raw || raw.indexOf('[[CARD]]') < 0) return raw;
                return raw.replace(/\[\[CARD\]\]([\s\S]*?)\[\[\/CARD\]\]/g, function (_, body) {
                    const lines = body.split('\n').map(function (l) { return l.replace(/^\s*[-*\u2022]\s?/, '').trim(); }).filter(function (l) { return l.length; });
                    if (!lines.length) return '';
                    const head = {};
                    lines[0].split('|').forEach(function (p) {
                        const kv = p.split('=');
                        if (kv.length >= 2) head[kv[0].trim().toLowerCase()] = kv.slice(1).join('=').trim();
                    });
                    const pr = (head.priority || 'MONITOR').toUpperCase();
                    const cls = pr.indexOf('URGENT') >= 0 ? 'urgent' : (pr.indexOf('INSPECT') >= 0 ? 'soon' : 'monitor');
                    let rows = '';
                    for (let i = 1; i < lines.length; i++) {
                        const c = lines[i].indexOf(':');
                        if (c < 0) { rows += '<div class="pc-row"><div class="pc-v">' + esc(lines[i]) + '</div></div>'; continue; }
                        const key = lines[i].substring(0, c).trim().toUpperCase();
                        const val = lines[i].substring(c + 1).trim();
                        const label = CARD_FIELDS[key] || (key.charAt(0) + key.slice(1).toLowerCase());
                        const extra = (key === 'NOTE') ? ' pc-note' : (key === 'ACTION' ? ' pc-action' : '');
                        rows += '<div class="pc-row' + extra + '"><div class="pc-k">' + esc(label) + '</div><div class="pc-v">' + esc(val) + '</div></div>';
                    }
                    const sub = [head.type, head.site].filter(Boolean).map(esc).join(' &middot; ');
                    const html = '<div class="plan-card ' + cls + '">'
                        + '<div class="pc-head"><span class="pc-pill">' + esc(pr) + '</span>'
                        + '<span class="pc-asset">' + esc(head.asset || 'Asset') + '</span>'
                        + (sub ? '<span class="pc-sub">' + sub + '</span>' : '') + '</div>'
                        + '<div class="pc-body">' + rows + '</div></div>';
                    stash.push(html);
                    return '\n\u0000CARD' + (stash.length - 1) + '\u0000\n';
                });
            }

            function renderMarkdown(raw) {
                if (!raw) return '';
                const cardStash = [];
                raw = renderPlanCards(String(raw), cardStash);
                let h = String(raw)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                h = h.replace(/```[\w]*\n?([\s\S]*?)```/g,
                    (_, c) => '<pre><code>' + c.trim() + '</code></pre>');
                h = h.replace(/`([^`\n]+)`/g, '<code>$1</code>');
                // headings BEFORE bold, so "## **Verdict**" still resolves both
                h = h.replace(/^\s{0,3}####\s+(.+?)\s*#*$/gm, '<h4 class="md-h">$1</h4>');
                h = h.replace(/^\s{0,3}###\s+(.+?)\s*#*$/gm, '<h3 class="md-h">$1</h3>');
                h = h.replace(/^\s{0,3}##\s+(.+?)\s*#*$/gm, '<h2 class="md-h">$1</h2>');
                h = h.replace(/^\s{0,3}#\s+(.+?)\s*#*$/gm, '<h2 class="md-h">$1</h2>');
                h = h.replace(/^\s*(?:---|\*\*\*|___)\s*$/gm, '<hr class="md-hr">');
                h = h.replace(/^\s*&gt;\s+(.+)$/gm, '<blockquote class="md-q">$1</blockquote>');
                h = h.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
                h = h.replace(/\*([^*\n]+)\*/g, '<em>$1</em>');
                h = h.replace(/((\|[^\n]+\|\n?)+)/g, function (m) {
                    const rows = m.trim().split('\n').filter(r => r.trim());
                    if (rows.length < 2) return m;
                    let t = '<table style="border-collapse:collapse;font-size:12px;margin:6px 0;width:100%">';
                    rows.forEach((row, i) => {
                        if (/^\|[\s\-:|]+\|$/.test(row.trim())) return;
                        const cells = row.split('|').filter((c, ci, a) => ci > 0 && ci < a.length - 1);
                        const tag = i === 0 ? 'th' : 'td';
                        t += '<tr>' + cells.map(c =>
                            `<${tag} style="border:1px solid rgba(15,23,42,.10);padding:4px 8px">${c.trim()}</${tag}>`
                        ).join('') + '</tr>';
                    });
                    return t + '</table>';
                });
                // ordered list first, tagged so it can be wrapped in <ol> rather than <ul>
                h = h.replace(/^\s*\d+[.)] (.+)$/gm, '<li data-ol="1">$1</li>');
                h = h.replace(/^\s*[\u2022\-\*] (.+)$/gm, '<li>$1</li>');
                h = h.replace(/(?:<li(?: data-ol="1")?>[\s\S]*?<\/li>\n?)+/g, function (m) {
                    const ordered = m.indexOf('data-ol') >= 0;
                    const body = m.replace(/ data-ol="1"/g, '').replace(/\n/g, '');
                    return '<' + (ordered ? 'ol' : 'ul') + ' class="md-list">' + body + '</' + (ordered ? 'ol' : 'ul') + '>';
                });
                // only NEWLINES BETWEEN INLINE TEXT become <br>; a newline that merely sits beside
                // block markup would otherwise render as an empty line.
                h = h.replace(/\n{2,}/g, '\n');
                h = h.replace(/\n(?!\s*<\/?(?:h2|h3|h4|ul|ol|li|pre|table|tr|hr|blockquote))/g, '<br>');
                h = h.replace(/\n/g, '');
                h = h.replace(/(<br>\s*)+(<(?:h2|h3|h4|ul|ol|pre|table|hr|blockquote))/g, '$2');
                h = h.replace(/(<\/(?:h2|h3|h4|ul|ol|pre|table|blockquote)>)(\s*<br>)+/g, '$1');
                if (cardStash.length) {
                    h = h.replace(/(<br>\s*)*\u0000CARD(\d+)\u0000(\s*<br>)*/g, function (_, a, idx) { return cardStash[Number(idx)] || ''; });
                }
                return h;
            }

            /* ══════════════════════════════════════════════════════════
               UTILS
            ══════════════════════════════════════════════════════════ */
            function esc(s) {
                return String(s)
                    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }
            function scrollDown() {
                const outer = document.getElementById('aiMessages');
                if (outer) outer.scrollTop = outer.scrollHeight;
            }
            function fmtTime() { return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }); }

            /* ══════════════════════════════════════════════════════════
               v1.2.9.6 — PER-MESSAGE ACTIONS (#1) + PDF EXPORT (#3)
            ══════════════════════════════════════════════════════════ */
            // Rebuild chatHistory from whatever messages are still on screen, so Edit can drop a turn
            // and everything after it without any index bookkeeping. Error bubbles are never in history.
            function rebuildHistoryFromDom() {
                const out = [];
                messagesEl.querySelectorAll('.ai-msg').forEach(function (m) {
                    if (m.classList.contains('ai-msg-error')) return;
                    if (m.dataset.raw == null) return;
                    out.push({ role: m.classList.contains('user') ? 'user' : 'assistant', content: m.dataset.raw });
                });
                chatHistory = out;
                saveHistory();
            }

            function onMsgAction(ev) {
                const t = ev.target.closest('.e7-msg-act');
                if (!t) return;
                const msg = t.closest('.ai-msg');
                if (!msg) return;
                const raw = msg.dataset.raw || '';

                // EDIT (#1): load this user message back into the input, drop it and everything after.
                if (t.classList.contains('e7-msg-edit')) {
                    if (isStreaming) return;
                    cancelPrompt();
                    let n = msg;
                    while (n) { const nx = n.nextSibling; n.remove(); n = nx; }
                    rebuildHistoryFromDom();
                    inputEl.value = raw;
                    autoResize(inputEl);
                    sendBtn.disabled = !raw.trim();
                    inputEl.focus();
                    return;
                }

                // REPLY (#1): quote this answer into the input so the next question has context.
                if (t.classList.contains('e7-msg-reply')) {
                    const snip = raw.replace(/\s+/g, ' ').trim().slice(0, 160);
                    const pre = inputEl.value.trim();
                    inputEl.value = (pre ? pre + '\n' : '')
                        + 'Regarding your previous answer'
                        + (snip ? ' (\u201C' + snip + (raw.length > 160 ? '\u2026' : '') + '\u201D)' : '')
                        + ': ';
                    autoResize(inputEl);
                    sendBtn.disabled = !inputEl.value.trim() || isStreaming;
                    inputEl.focus();
                    return;
                }

                // EXPORT one answer (#3).
                if (t.classList.contains('e7-msg-export')) {
                    exportToPdf([{ role: 'assistant', content: raw }], 'RDPMS AI — Answer');
                    return;
                }
            }

            function exportChatPdf() {
                if (!chatHistory.length) { return; }
                exportToPdf(chatHistory, 'RDPMS AI — Conversation');
            }

            // Dependency-free, CSP-safe: open a plain print window and trigger the browser's print /
            // Save-as-PDF. No inline <script>, no external libraries.
            function exportToPdf(items, title) {
                try {
                    const when = new Date().toLocaleString();
                    let rows = '';
                    (items || []).forEach(function (it) {
                        if (!it || it.content == null) return;
                        const who = it.role === 'user' ? 'You' : 'AI Assistant';
                        const cls = it.role === 'user' ? 'u' : 'a';
                        const bodyHtml = it.role === 'user' ? esc(String(it.content)) : renderMarkdown(String(it.content));
                        rows += '<div class="row ' + cls + '"><div class="who">' + who + '</div><div class="body">' + bodyHtml + '</div></div>';
                    });
                    const css =
                        '*{box-sizing:border-box}'
                        + 'body{font:13px/1.5 "Segoe UI",Arial,sans-serif;color:#1a2b3c;margin:24px;}'
                        + 'header{border-bottom:2px solid #0a4d8c;margin-bottom:16px;padding-bottom:8px;}'
                        + 'h1{font-size:16px;margin:0 0 4px;color:#0a4d8c;}'
                        + '.meta{font-size:11px;color:#667;}'
                        + '.row{margin:10px 0;padding:8px 10px;border-radius:6px;page-break-inside:avoid;}'
                        + '.row.u{background:#eef4fb;}'
                        + '.row.a{background:#f7f9fb;border:1px solid #e3e8ee;}'
                        + '.who{font-weight:600;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:#0a4d8c;margin-bottom:4px;}'
                        + '.body{white-space:normal;}'
                        + '.body table{border-collapse:collapse;}'
                        + '.body td,.body th{border:1px solid #cdd6df;padding:3px 6px;}'
                        + '.plan-card{border:1px solid #cdd6df;border-radius:6px;padding:6px 8px;margin:6px 0;}'
                        + '@@media print{body{margin:0;}.row{break-inside:avoid;}}';
                    const w = window.open('', '_blank');
                    if (!w) { alert('Please allow pop-ups to export the PDF.'); return; }
                    w.document.open();
                    w.document.write('<!doctype html><html><head><meta charset="utf-8"><title>'
                        + esc(title) + '</title><style>' + css + '</style></head><body>'
                        + '<header><h1>' + esc(title) + '</h1><div class="meta">ENERGY7 &middot; RDPMS — '
                        + esc(when) + '</div></header>' + rows + '</body></html>');
                    w.document.close();
                    setTimeout(function () { try { w.focus(); w.print(); } catch (e) { } }, 350);
                } catch (e) { alert('Export failed.'); }
            }
            function autoResize(el) { el.style.height = ''; el.style.height = Math.min(el.scrollHeight, 100) + 'px'; }
            function getUserInitial() {
                const el = document.querySelector('.e7-user-name');
                return el ? (el.textContent.trim()[0] || 'U').toUpperCase() : 'U';
            }
            function setStatus(state, text) {
                if (!statusDot || !statusText) return;
                statusDot.className = 'ai-chat-status-dot' + (state === 'online' ? '' : ' ' + state);
                statusText.textContent = text;
            }
            function saveHistory() {
                try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(chatHistory.slice(-MAX_HISTORY * 2))); }
                catch (_) { }
            }
            function loadHistory() {
                try { const s = sessionStorage.getItem(STORAGE_KEY); if (s) chatHistory = JSON.parse(s); }
                catch (_) { }
            }

            /* ── Boot ── */
            if (document.readyState === 'loading')
                document.addEventListener('DOMContentLoaded', init);
            else
                init();

        })();
</script>
