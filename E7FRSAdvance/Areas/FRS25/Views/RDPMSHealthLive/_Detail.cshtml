        var s = startIdx + 1, e = Math.min(startIdx + RDPMS_BAR_PER_PAGE, _rdpmsBarStations.length);
        renderRdpmsPager('#rdpmsBarAvailPager', rdpmsBarAvailPage, Math.ceil(_rdpmsBarStations.length / RDPMS_BAR_PER_PAGE), _rdpmsBarStations.length, s, e,
            function (pg) { rdpmsBarAvailPage = pg; drawRdpmsBarAvailPage(); });
    }

    // ==========================================================================
    // GRAPH — Canvas line charts
    // ==========================================================================
    function renderRdpmsGraph(data) {
        _rdpmsLineSites = data.stationOrder;
        _rdpmsLineSiteMeta = data.stationMeta;

        _rdpmsLineMatrix = { sensors: {}, iot: {}, network: {}, gateway: {}, pctSensor: {}, pctIot: {}, pctNet: {}, pctGw: {} };
        data.stationOrder.forEach(function (stKey) {
            var m = data.stationMatrix[stKey];
            _rdpmsLineMatrix.sensors[stKey] = m.sensors;
            _rdpmsLineMatrix.iot[stKey] = m.iot;
            _rdpmsLineMatrix.network[stKey] = m.network;
            _rdpmsLineMatrix.gateway[stKey] = m.gateway;
            _rdpmsLineMatrix.pctSensor[stKey] = m.pctSensor.length ? (m.pctSensor.reduce(function (a, b) { return a + b; }, 0) / m.pctSensor.length) : 0;
            _rdpmsLineMatrix.pctIot[stKey] = m.pctIot.length ? (m.pctIot.reduce(function (a, b) { return a + b; }, 0) / m.pctIot.length) : 0;
            _rdpmsLineMatrix.pctNet[stKey] = m.pctNet.length ? (m.pctNet.reduce(function (a, b) { return a + b; }, 0) / m.pctNet.length) : 0;
            _rdpmsLineMatrix.pctGw[stKey] = m.pctGw.length ? (m.pctGw.reduce(function (a, b) { return a + b; }, 0) / m.pctGw.length) : 0;
        });

