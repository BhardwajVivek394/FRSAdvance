            { key: 'iot', label: 'IoTs', color: '#22c55e', dash: [6, 3] },
            { key: 'network', label: 'Network', color: '#f97316', dash: [4, 4] },
            { key: 'gateway', label: 'Stn Gateway', color: '#3b82f6', dash: [8, 4] }
        ];

        var pctSeries = [
            { key: 'pctSensor', label: '% Availability of Sensors', color: '#6366f1', dash: [] },
            { key: 'pctIot', label: '% Availability of IoT', color: '#22c55e', dash: [6, 3] },
            { key: 'pctNet', label: '% Availability of Network ', color: '#f97316', dash: [4, 4] },
            { key: 'pctGw', label: '% Availability of Station Gateway ', color: '#3b82f6', dash: [8, 4] }
        ];

        // ── Group stKeys by station name ──
        var stationGroups = {}, stationOrder = [];
        data.stationOrder.forEach(function (stKey) {
            var meta = data.stationMeta[stKey] || {};
            var station = meta.station || stKey;
            if (!stationGroups[station]) {
                stationGroups[station] = [];
                stationOrder.push(station);
            }
            stationGroups[station].push(stKey);
        });

        // ── Render one panel per station ──
        stationOrder.forEach(function (station, stIdx) {
            var stKeys = stationGroups[station];
            var meta = data.stationMeta[stKeys[0]] || {};

            // X-axis labels = assetType for each stKey in this station
            var xLabels = stKeys.map(function (stKey) {
                var m = data.stationMeta[stKey] || {};
                return m.assetType || stKey;
            });

            // Station panel wrapper
            var $stPanel = $('<div></div>').css({
                padding: '24px', background: '#fff', borderRadius: '12px',
                boxShadow: '0 2px 12px rgba(0,0,0,0.08)', marginBottom: '24px'
            });

            // Station heading
            $stPanel.append(
                '<div style="font-size:16px;font-weight:700;color:#1e293b;border-bottom:2px solid #e5e7eb;' +
                'padding-bottom:10px;margin-bottom:20px;">' +
                '<i class="fas fa-map-marker-alt mr-2" style="color:#6366f1;font-size:14px;"></i>' +
                station +
                (meta.division ? '<span style="font-size:12px;font-weight:400;color:#64748b;margin-left:10px;">' + meta.division + (meta.zone ? ', ' + meta.zone : '') + '</span>' : '') +
                '</div>'
            );

            // ── Chart 1: Total asset counts ──
            var countChartId = 'rdpmsCountChart_' + stIdx;

            $stPanel.append(
                '<div style="font-size:14px;font-weight:600;color:#1e293b;margin-bottom:8px;">' +
                '<i class="fas fa-chart-line mr-1" style="color:#6366f1;font-size:12px;"></i>' +
                'Total asset counts by type</div>'
            );
            $stPanel.append(
                '<div style="font-size:12px;color:#64748b;margin-bottom:12px;">' +
                'Number of Sensors, IoTs, Network devices and Station Gateway</div>'
            );

            var $leg1 = buildRdpmsInteractiveLegend(countSeries, countChartId);
            $stPanel.append($leg1);

            var $wrap1 = $('<div></div>').css({ position: 'relative', height: '300px', marginBottom: '24px' });
            var $canvas1 = $('<canvas id="' + countChartId + '"></canvas>');
            $wrap1.append($canvas1);
            $stPanel.append($wrap1);

            // ── Chart 2: % Availability ──
            var pctChartId = 'rdpmsPctChart_' + stIdx;

            $stPanel.append(
                '<div style="font-size:14px;font-weight:600;color:#1e293b;margin-bottom:8px;' +
                'border-top:1px solid #e5e7eb;padding-top:20px;">' +
                '<i class="fas fa-percent mr-1" style="color:#22c55e;font-size:12px;"></i>' +
                '% Availability per Asset Type</div>'
            );
            $stPanel.append(
                '<div style="font-size:12px;color:#64748b;margin-bottom:12px;">' +
                'Sensor, IoT, Network and Station Gateway availability %</div>'
            );

            var $leg2 = buildRdpmsInteractiveLegend(pctSeries, pctChartId);
            $stPanel.append($leg2);

            var $wrap2 = $('<div></div>').css({ position: 'relative', height: '300px' });
            var $canvas2 = $('<canvas id="' + pctChartId + '"></canvas>');
            $wrap2.append($canvas2);
            $stPanel.append($wrap2);

            $c.append($stPanel);

            // ── Build count chart for this station ──
            buildRdpmsChartJs(
                $canvas1[0], xLabels, countSeries,
