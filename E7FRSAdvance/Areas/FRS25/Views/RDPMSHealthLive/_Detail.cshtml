            worksheet.mergeCells(2, 1, 2, colCount);
            summaryRow.getCell(1).font = { italic: true, size: 10, color: { argb: 'FF64748B' } };
            summaryRow.getCell(1).alignment = { horizontal: 'center' };
            worksheet.addRow([]);

            var headers = ['Sr.No', 'Zone', 'Division', 'Station', 'Asset Type',
                'Total number of Sensors', '% Availability of Sensors',
                'Total Number of IoTs', '% Availability of IoTs',
                'Total Number of Network', '% Availability of Network',
                'Total Number of Station Gateway', '% Availability of station gateway'];
            var headerRow = worksheet.addRow(headers); headerRow.height = 40;
            headerRow.eachCell(function (cell) {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1E3A5F' } };
                cell.font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11, name: 'Calibri' };
                cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
                cell.border = { top: { style: 'medium', color: { argb: 'FF1E3A5F' } }, left: { style: 'medium', color: { argb: 'FF1E3A5F' } }, bottom: { style: 'medium', color: { argb: 'FF1E3A5F' } }, right: { style: 'medium', color: { argb: 'FF1E3A5F' } } };
            });

            $allRows.show();
            var dataIdx = 0;
            $allRows.each(function () {
                var $tr = $(this); if ($tr.find('td[colspan]').length) return; dataIdx++;
                var rowData = []; $tr.find('td').each(function (i) { if (i < 13) rowData.push($(this).text().replace(/(\r\n|\n|\r)/gm, ' ').trim()); });
                var excelRow = worksheet.addRow(rowData); excelRow.height = 22;
                excelRow.eachCell(function (cell, col) {
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: dataIdx % 2 === 0 ? 'FFF1F5F9' : 'FFFFFFFF' } };
                    cell.font = { size: 10, name: 'Calibri' };
                    cell.alignment = { vertical: 'middle', horizontal: col <= 4 ? (col === 1 ? 'center' : 'left') : 'center' };
                    cell.border = { top: { style: 'thin', color: { argb: 'FFE2E8F0' } }, left: { style: 'thin', color: { argb: 'FFE2E8F0' } }, bottom: { style: 'thin', color: { argb: 'FFE2E8F0' } }, right: { style: 'thin', color: { argb: 'FFE2E8F0' } } };
                });
            });
            if (typeof goToPage === 'function') goToPage(1);

            worksheet.getColumn(1).width = 8; worksheet.getColumn(2).width = 12; worksheet.getColumn(3).width = 15;
            worksheet.getColumn(4).width = 20; worksheet.getColumn(5).width = 20;
            for (var c = 6; c <= 13; c++) worksheet.getColumn(c).width = 28;

            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), getFileName('xlsx'));
