    // Donut — Total Device Count (4 segments)
    function buildRdpmsPieItem(item) {
        var total = item.sensors + item.iot + item.network + item.gateway;
        if (total <= 0) total = 1;
        var r = 62, circ = 2 * Math.PI * r;
        var segs = [
            { val: item.sensors, color: '#6366f1' },
            { val: item.iot, color: '#22c55e' },
            { val: item.network, color: '#3b82f6' },
            { val: item.gateway, color: '#f97316' }
        ];
        var svg = '<svg class="rdpms-pie-svg" viewBox="0 0 180 180" style="transform:rotate(-90deg)">';
        svg += '<circle cx="90" cy="90" r="' + r + '" fill="none" stroke="#f0f0f0" stroke-width="52"/>';
        var offset = 0;
        segs.forEach(function (seg) {
            if (seg.val <= 0) return;
            var len = (seg.val / total) * circ;
            svg += '<circle cx="90" cy="90" r="' + r + '" fill="none" stroke="' + seg.color + '" stroke-width="52" stroke-dasharray="' + len + ' ' + (circ - len) + '" stroke-dashoffset="' + (-offset) + '"/>';
            offset += len;
        });
        svg += '</svg>';

        var totalDevices = item.sensors + item.iot + item.network + item.gateway;
        var $pi = $('<div class="rdpms-pie-item"></div>');
        $pi.append('<div class="rdpms-pie-total-label">Total: ' + totalDevices + '</div>');
        var $cont = $('<div class="rdpms-pie-container"></div>').html(svg);
        $cont.append('<div class="rdpms-pie-center"><div class="rdpms-pie-total-val">' + totalDevices + '</div><div class="rdpms-pie-total-sub">devices</div></div>');
        $cont.on('mouseenter', function (e) {
            var html = '<div class="rdpms-tt-title">' + item.label + '</div>';
            if (item.sub) html += '<div class="rdpms-tt-sub">' + item.sub + (item.division ? ' | ' + item.division + ', ' + item.zone : '') + '</div>';
            html += '<div class="rdpms-tt-divider">' + rdpmsDeviceTipRows(item.sensors, item.iot, item.network, item.gateway) + '</div>';
            rdpmsShowTip(html, e);
        }).on('mousemove', rdpmsMoveTip).on('mouseleave', rdpmsHideTip);

        var $info = $('<div class="rdpms-pie-info"></div>');
        $info.append('<div class="rdpms-pie-name">' + item.label + '</div>');
        if (item.sub) $info.append('<div class="rdpms-pie-sub-name">' + item.sub + '</div>');
        return $pi.append($cont).append($info);
    }

    // ★ UPDATED: Donut — Availability % (4 segments: Sensor / IoT / Network / Gateway)
    function buildRdpmsAvailPieItem(item) {
        var r = 62, circ = 2 * Math.PI * r;
        var pctSensor = item.pctSensor || 0;
        var pctIot = item.pctIot || 0;
        var pctNet = item.pctNet || 0;
        var pctGw = item.pctGw || 0;
        var segsSum = pctSensor + pctIot + pctNet + pctGw;

        var activeCount = (pctSensor > 0 ? 1 : 0) + (pctIot > 0 ? 1 : 0) + (pctNet > 0 ? 1 : 0) + (pctGw > 0 ? 1 : 0);
        var avgAvail = activeCount > 0 ? (segsSum / activeCount) : 0;
        var avgColor = avgAvail >= 80 ? '#22c55e' : avgAvail >= 50 ? '#f97316' : '#f43f5e';

        var svg = '<svg class="rdpms-pie-svg" viewBox="0 0 180 180" style="transform:rotate(-90deg)">';
        svg += '<circle cx="90" cy="90" r="' + r + '" fill="none" stroke="#f0f0f0" stroke-width="52"/>';

        if (segsSum > 0) {
            var segs = [
                { val: pctSensor, color: '#6366f1' },
                { val: pctIot, color: '#22c55e' },
                { val: pctNet, color: '#3b82f6' },
                { val: pctGw, color: '#f97316' }
            ];
            var offset = 0;
            segs.forEach(function (seg) {
                if (seg.val <= 0) return;
                var len = (seg.val / segsSum) * circ;
                svg += '<circle cx="90" cy="90" r="' + r + '" fill="none" stroke="' + seg.color + '" stroke-width="52" stroke-dasharray="' + len + ' ' + (circ - len) + '" stroke-dashoffset="' + (-offset) + '"/>';
                offset += len;
            });
        }
        svg += '</svg>';

        var $pi = $('<div class="rdpms-pie-item"></div>');
        $pi.append('<div class="rdpms-pie-total-label">Avg: ' + avgAvail.toFixed(1) + '<span style="font-size:10px;">%</span></div>');
        var $cont = $('<div class="rdpms-pie-container"></div>').html(svg);
        $cont.append('<div class="rdpms-pie-center"><div class="rdpms-pie-total-val" style="color:' + avgColor + ';font-size:18px;">' + avgAvail.toFixed(1) + '<span style="font-size:11px;font-weight:500;color:' + avgColor + ';">%</span></div><div class="rdpms-pie-total-sub">avg avail.</div></div>');

        $cont.on('mouseenter', function (e) {
            var html = '<div class="rdpms-tt-title">' + item.label + '</div>';
            if (item.sub) html += '<div class="rdpms-tt-sub">' + item.sub + (item.division ? ' | ' + item.division + ', ' + item.zone : '') + '</div>';
            html += '<div class="rdpms-tt-divider">';
            html += '<div class="rdpms-tt-row"><span class="rdpms-tt-swatch" style="background:#6366f1"></span>Sensor Availability: <strong>' + pctSensor.toFixed(2) + '%</strong></div>';
            html += '<div class="rdpms-tt-row"><span class="rdpms-tt-swatch" style="background:#22c55e"></span>IoT Availability: <strong>' + pctIot.toFixed(2) + '%</strong></div>';
            html += '<div class="rdpms-tt-row"><span class="rdpms-tt-swatch" style="background:#3b82f6"></span>Network Availability: <strong>' + pctNet.toFixed(2) + '%</strong></div>';
            html += '<div class="rdpms-tt-row"><span class="rdpms-tt-swatch" style="background:#f97316"></span>Station Gateway Availability: <strong>' + pctGw.toFixed(2) + '%</strong></div>';
            html += '<div style="border-top:1px solid #f0f0f0;margin-top:6px;padding-top:6px;font-weight:600;color:' + avgColor + ';">Avg: ' + avgAvail.toFixed(2) + '%</div>';
            html += '</div>';
            rdpmsShowTip(html, e);
        }).on('mousemove', rdpmsMoveTip).on('mouseleave', rdpmsHideTip);

        var $info = $('<div class="rdpms-pie-info"></div>');
        $info.append('<div class="rdpms-pie-name">' + item.label + '</div>');
        if (item.sub) $info.append('<div class="rdpms-pie-sub-name">' + item.sub + '</div>');
        return $pi.append($cont).append($info);
    }

