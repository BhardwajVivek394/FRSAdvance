    function drawRdpmsBarPage() {
        var startIdx = (rdpmsBarPage - 1) * RDPMS_BAR_PER_PAGE;
        var pageStations = _rdpmsBarStations.slice(startIdx, startIdx + RDPMS_BAR_PER_PAGE);
        var yMax = 1;
        pageStations.forEach(function (stKey) {
            var m = _rdpmsBarMatrix[stKey];
            var t = m.sensors + m.iot + m.network + m.gateway;
            if (t > yMax) yMax = t;
        });
        yMax += Math.max(1, Math.ceil(yMax * 0.1));
        var chartH = 320, unitH = chartH / yMax;
        var yStep = yMax <= 10 ? 1 : Math.ceil(yMax / 8);

        var $yAxis = $('#rdpmsBarYAxis').empty();
        for (var i = 0; i <= yMax; i += yStep) $yAxis.append('<div class="rdpms-bar-y-tick">' + i + '</div>');
        $('#rdpmsBarOuter .rdpms-bar-grid-line').remove();
        for (var g = yStep; g <= yMax; g += yStep) {
            $('#rdpmsBarOuter').append('<div class="rdpms-bar-grid-line" style="bottom:' + (g / yMax * 100) + '%"></div>');
        }

        var $bars = $('#rdpmsBarBarsInner').empty();
        pageStations.forEach(function (stKey) {
            var m = _rdpmsBarMatrix[stKey];
            var meta = _rdpmsBarStationMeta[stKey];
            var stTotal = m.sensors + m.iot + m.network + m.gateway;
            var $grp = $('<div class="rdpms-bar-group"></div>');
            var $wrap = $('<div class="rdpms-bar-wrapper"></div>');
            if (stTotal > 0) $wrap.append('<div class="rdpms-bar-total-label">' + stTotal + '</div>');
            [{ val: m.sensors, color: '#6366f1' },
            { val: m.iot, color: '#22c55e' },
            { val: m.network, color: '#3b82f6' },
            { val: m.gateway, color: '#f97316' }].forEach(function (seg) {
                if (!seg.val) return;
                $wrap.append('<div class="rdpms-bar-seg" style="height:' + (seg.val * unitH) + 'px;background:' + seg.color + ';opacity:0.9;"></div>');
            });
            var labelText = meta ? meta.station + ' (' + meta.assetType + ')' : stKey;
            $grp.append('<div class="rdpms-bar-x-label">' + labelText + '</div>');
            $wrap.on('mouseenter', function (e) {
                var html = '<div class="rdpms-tt-title">' + labelText + '</div>';
                if (meta) html += '<div class="rdpms-tt-sub">' + meta.assetType + ' | ' + meta.division + ', ' + meta.zone + '</div>';
                html += '<div class="rdpms-tt-divider">' + rdpmsDeviceTipRows(m.sensors, m.iot, m.network, m.gateway);
                html += '<div style="border-top:1px solid #f0f0f0;margin-top:6px;padding-top:6px;font-weight:600;">Total: ' + stTotal + '</div></div>';
                rdpmsShowTip(html, e);
            }).on('mousemove', rdpmsMoveTip).on('mouseleave', rdpmsHideTip);
            $grp.prepend($wrap); $bars.append($grp);
        });

        var s = startIdx + 1, e = Math.min(startIdx + RDPMS_BAR_PER_PAGE, _rdpmsBarStations.length);
        renderRdpmsPager('#rdpmsBarPager', rdpmsBarPage, Math.ceil(_rdpmsBarStations.length / RDPMS_BAR_PER_PAGE), _rdpmsBarStations.length, s, e,
            function (pg) { rdpmsBarPage = pg; drawRdpmsBarPage(); });
    }

    // ★ UPDATED: 4 grouped bars per station (Sensor / IoT / Network / Gateway)
    function drawRdpmsBarAvailPage() {
        var startIdx = (rdpmsBarAvailPage - 1) * RDPMS_BAR_PER_PAGE;
        var pageStations = _rdpmsBarStations.slice(startIdx, startIdx + RDPMS_BAR_PER_PAGE);

