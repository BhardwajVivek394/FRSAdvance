                    return stKeys.map(function (stKey) {
                        return _rdpmsLineMatrix[s.key][stKey] || 0;
                    });
                },
                false, 'Device Count'
            );

            // ── Build pct chart for this station ──
            buildRdpmsChartJs(
                $canvas2[0], xLabels, pctSeries,
                function (s) {
                    return stKeys.map(function (stKey) {
                        return _rdpmsLineMatrix[s.key][stKey] || 0;
                    });
                },
                true, 'Availability %'
            );
        });
    }

    // ── Build interactive legend with check/uncheck per series ──
    function buildRdpmsInteractiveLegend(series, chartId) {
        var $leg = $('<div></div>').css({
            display: 'flex', flexWrap: 'wrap', gap: '8px 20px',
            marginBottom: '16px', padding: '0 4px'
        });

        series.forEach(function (s, idx) {
            var $item = $('<label></label>').css({
                display: 'flex', alignItems: 'center', gap: '8px',
                cursor: 'pointer', fontSize: '12px', color: '#475569',
                userSelect: 'none'
            });

            var $chk = $('<input type="checkbox" checked>').css({
                accentColor: s.color, width: '14px', height: '14px', cursor: 'pointer'
            });

            // Dashed line swatch
            var dashStyle = s.dash && s.dash.length ? 'dashed' : 'solid';
            var $swatch = $('<span></span>').css({
                display: 'inline-block', width: '28px', height: '3px',
                background: s.color, borderRadius: '2px', flexShrink: 0,
                borderTop: '3px ' + dashStyle + ' ' + s.color
            });

            $item.append($chk).append($swatch).append($('<span>' + s.label + '</span>'));

            $chk.on('change', function () {
                var chart = rdpmsChartInstances[chartId];
                if (!chart) return;
                var meta = chart.getDatasetMeta(idx);
                meta.hidden = !$(this).prop('checked');
                $item.css('opacity', $(this).prop('checked') ? 1 : 0.4);
                chart.update();
            });

            $leg.append($item);
        });

        return $leg;
    }

    // ── Build Chart.js multi-line chart ──
    var rdpmsChartInstances = {};

    function buildRdpmsChartJs(canvas, xLabels, series, dataFn, isPct, yLabel) {
        var chartId = canvas.id;
        if (rdpmsChartInstances[chartId]) {
            rdpmsChartInstances[chartId].destroy();
        }

        var datasets = series.map(function (s) {
            return {
                label: s.label,
                data: dataFn(s),
                borderColor: s.color,
                backgroundColor: s.color + '18',
                borderWidth: 2,
                borderDash: s.dash || [],
                pointBackgroundColor: '#fff',
                pointBorderColor: s.color,
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 7,
                fill: false,
                tension: 0.4,
                spanGaps: true
            };
        });

        // For first series (Sensors), add fill under line like the image
        if (datasets.length > 0) {
            datasets[0].fill = true;
            datasets[0].backgroundColor = series[0].color + '15';
        }

        rdpmsChartInstances[chartId] = new Chart(canvas.getContext('2d'), {
            type: 'line',
            data: { labels: xLabels, datasets: datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: 'rgba(15,23,42,0.88)',
                        padding: 12,
                        cornerRadius: 8,
                        callbacks: {
                            title: function (items) {
                                var idx = items[0].dataIndex;
                                var stKey = _rdpmsLineSites[idx] || '';
                                var meta = _rdpmsLineSiteMeta[stKey] || {};
                                return (meta.station || stKey) + (meta.assetType ? ' (' + meta.assetType + ')' : '');
                            },
                            label: function (c) {
                                if (c.parsed.y === null) return null;
                                var suffix = isPct ? '%' : '';
                                return ' ' + c.dataset.label + ': ' + (isPct ? c.parsed.y.toFixed(2) : c.parsed.y) + suffix;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { color: 'rgba(0,0,0,0.04)' },
                        ticks: {
                            font: { size: 11 }, color: '#64748b',
                            maxRotation: 0, autoSkip: false
                        }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0,0,0,0.05)' },
                        title: { display: true, text: yLabel, font: { size: 12 }, color: '#475569' },
                        ticks: {
                            font: { size: 11 }, color: '#94a3b8',
                            callback: function (v) { return isPct ? v + '%' : v; }
                        }
                    }
                }
            }
        });
    }

    function drawRdpmsLineCanvas(canvas, wrapper, series, isPct, hoverIdx) {
        var PAD_L = 60, PAD_R = 24, PAD_T = 28, PAD_B = 130, INNER_H = 300;
        var colW = Math.min(120, Math.max(70, Math.floor(900 / Math.max(_rdpmsLineSites.length, 1))));
        var INNER_W = colW * _rdpmsLineSites.length;
        var CW = INNER_W + PAD_L + PAD_R, CH = INNER_H + PAD_T + PAD_B;

        if (!canvas._layout) {
            canvas.width = CW; canvas.height = CH;
            canvas.style.width = CW + 'px'; canvas.style.height = CH + 'px';
            wrapper.style.height = CH + 'px';
            canvas._layout = { PAD_L: PAD_L, PAD_T: PAD_T, INNER_W: INNER_W, INNER_H: INNER_H, colW: colW };
        }
        var L = canvas._layout;
        var ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, canvas.width, canvas.height);

        var maxVal = 1;
        series.forEach(function (s) { _rdpmsLineSites.forEach(function (st) { var v = _rdpmsLineMatrix[s.key][st] || 0; if (v > maxVal) maxVal = v; }); });
        var yMax = isPct ? (maxVal > 0 ? Math.min(100, Math.ceil(maxVal * 1.1)) : 100) : (maxVal + Math.max(1, Math.ceil(maxVal * 0.12)));
        var yStep = isPct ? (yMax <= 10 ? 1 : yMax <= 25 ? 5 : 10) : (yMax <= 10 ? 1 : Math.ceil(yMax / 8));
        canvas._yMax = yMax; canvas._isPct = isPct;

        var xPos = _rdpmsLineSites.map(function (s, i) { return L.PAD_L + i * L.colW + L.colW / 2; });
        canvas._xPos = xPos;

        ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
        ctx.font = '11px Segoe UI, Arial, sans-serif';
        for (var yv = 0; yv <= yMax; yv += yStep) {
            var gy = L.PAD_T + L.INNER_H - (yv / yMax) * L.INNER_H;
            ctx.strokeStyle = '#e5e7eb'; ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(L.PAD_L, gy); ctx.lineTo(L.PAD_L + L.INNER_W, gy); ctx.stroke();
            ctx.fillStyle = '#64748b';
            ctx.fillText(isPct ? yv + '%' : yv, L.PAD_L - 6, gy);
        }

        ctx.save(); ctx.translate(14, L.PAD_T + L.INNER_H / 2); ctx.rotate(-Math.PI / 2);
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.font = '12px Segoe UI, Arial, sans-serif'; ctx.fillStyle = '#475569';
        ctx.fillText(isPct ? 'Availability %' : 'Device Count', 0, 0); ctx.restore();

        ctx.strokeStyle = '#94a3b8'; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(L.PAD_L, L.PAD_T); ctx.lineTo(L.PAD_L, L.PAD_T + L.INNER_H); ctx.lineTo(L.PAD_L + L.INNER_W, L.PAD_T + L.INNER_H); ctx.stroke();

        if (hoverIdx !== undefined && hoverIdx >= 0) {
            var hx = xPos[hoverIdx];
            ctx.fillStyle = 'rgba(99,102,241,0.07)'; ctx.fillRect(hx - L.colW / 2, L.PAD_T, L.colW, L.INNER_H);
            ctx.strokeStyle = 'rgba(99,102,241,0.3)'; ctx.lineWidth = 1; ctx.setLineDash([4, 4]);
            ctx.beginPath(); ctx.moveTo(hx, L.PAD_T); ctx.lineTo(hx, L.PAD_T + L.INNER_H); ctx.stroke();
            ctx.setLineDash([]);
        }

        xPos.forEach(function (x) {
            ctx.strokeStyle = '#94a3b8'; ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(x, L.PAD_T + L.INNER_H); ctx.lineTo(x, L.PAD_T + L.INNER_H + 5); ctx.stroke();
        });

        series.forEach(function (s) {
            var pts = _rdpmsLineSites.map(function (stKey, si) {
                var val = _rdpmsLineMatrix[s.key][stKey] || 0;
                return { x: xPos[si], y: L.PAD_T + L.INNER_H - (val / yMax) * L.INNER_H, val: val };
            });
            ctx.strokeStyle = s.color; ctx.lineWidth = 2.2; ctx.lineJoin = 'round'; ctx.lineCap = 'round';
            ctx.beginPath();
            pts.forEach(function (p, i) { i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y); });
            ctx.stroke();
            pts.forEach(function (p) {
                ctx.beginPath(); ctx.arc(p.x, p.y, 5, 0, 2 * Math.PI);
                ctx.fillStyle = '#fff'; ctx.fill();
                ctx.strokeStyle = s.color; ctx.lineWidth = 2.5; ctx.stroke();
                if (p.val > 0 && series.length <= 4) {
                    ctx.fillStyle = s.color; ctx.font = 'bold 10px Segoe UI, Arial, sans-serif';
                    ctx.textAlign = 'center'; ctx.textBaseline = 'bottom';
                    ctx.fillText(isPct ? (+p.val).toFixed(1) + '%' : p.val, p.x, p.y - 8);
                }
            });
        });

        _rdpmsLineSites.forEach(function (stKey, si) {
            var x = xPos[si];
            var meta = _rdpmsLineSiteMeta[stKey] || {};
            ctx.save(); ctx.translate(x, L.PAD_T + L.INNER_H + 10); ctx.rotate(Math.PI / 4);
            ctx.textAlign = 'left'; ctx.textBaseline = 'top';
            ctx.font = 'bold 10px Segoe UI, Arial, sans-serif'; ctx.fillStyle = '#1e293b';
            ctx.fillText(meta.station || stKey, 0, 0);
            ctx.font = '9px Segoe UI, Arial, sans-serif'; ctx.fillStyle = '#94a3b8';
            ctx.fillText((meta.assetType || '') + ' | ' + (meta.division || ''), 0, 13);
            ctx.restore();
        });
    }

    function handleRdpmsLineHover(e, canvas, series, isPct) {
        if (!canvas._layout || !canvas._xPos) return;
        var L = canvas._layout;
        var rect = canvas.getBoundingClientRect();
        var mx = e.clientX - rect.left, my = e.clientY - rect.top;
        var closest = -1, minDist = L.colW;
        canvas._xPos.forEach(function (x, i) { var d = Math.abs(mx - x); if (d < minDist) { minDist = d; closest = i; } });
        var wrapper = canvas.parentElement;
        if (closest === -1 || my < L.PAD_T || my > L.PAD_T + L.INNER_H) {
            rdpmsHideTip(); drawRdpmsLineCanvas(canvas, wrapper, series, isPct); return;
        }
        drawRdpmsLineCanvas(canvas, wrapper, series, isPct, closest);
        var stKey = _rdpmsLineSites[closest];
        var meta = _rdpmsLineSiteMeta[stKey] || {};
        var html = '<div class="rdpms-tt-title">' + (meta.station || stKey) + '</div>';
        if (meta.assetType) html += '<div class="rdpms-tt-sub">' + meta.assetType + ' | ' + (meta.division || '') + ', ' + (meta.zone || '') + '</div>';
        html += '<div class="rdpms-tt-divider">';
        series.forEach(function (s) {
            var val = _rdpmsLineMatrix[s.key][stKey] || 0;
            html += '<div class="rdpms-tt-row"><span style="display:inline-block;width:12px;height:3px;background:' + s.color + ';border-radius:2px;margin-right:6px;vertical-align:middle;flex-shrink:0;"></span>' +
                '<span style="flex:1;color:#475569;font-size:11px;">' + s.label + '</span>' +
                '<strong style="margin-left:8px;">' + (isPct ? val.toFixed(2) + '%' : val) + '</strong></div>';
        });
        html += '</div>';
        rdpmsShowTip(html, e);
    }

