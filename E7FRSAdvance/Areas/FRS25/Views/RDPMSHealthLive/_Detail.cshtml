            AVAIL_SEGS.forEach(function (seg, si) {
                var val = vals[si];
                var h = Math.max(val * unitH, val > 0 ? 2 : 0);
                var $bar = $('<div style="width:28px;height:' + h + 'px;background:' + seg.color + ';opacity:0.88;border-radius:3px 3px 0 0;position:relative;"></div>');
                if (val > 0) {
                    $bar.append('<div style="position:absolute;top:-18px;left:50%;transform:translateX(-50%);font-size:9px;font-weight:600;color:' + seg.color + ';white-space:nowrap;">' + val.toFixed(1) + '%</div>');
