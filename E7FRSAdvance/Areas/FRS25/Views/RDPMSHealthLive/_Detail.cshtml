    /* ══════════════════════════════════════════════════════════════════
       MEDIA HEALTH OVERVIEW — Wire / Wireless status for IoT & Network
       over the summary's date range.
       ------------------------------------------------------------------
       Data sourcing lives entirely in the browser because the summary
       endpoint (Asset/GetRDPMSHealthSummary) doesn't echo back either
       SearchCriteria or mClusters — only the LIVE endpoint does. So we:

         Dates    ← read from parent form inputs #txtFromDate/#txtFromTime,
                    #txtToDate/#txtToTime (DD/MM/YYYY + HH:MM), formatted
                    to ddMMyyyy_HHmmss on the fly.
         Clusters ← per selected siteId, one call to GetCardLineData
                    yields the modem/channel config. Deduped ClusterId
                    values (string codes like "CL01") become the pairs.
         History  ← per (site, cluster) pair, two calls:
                       /NetworkDashboard/GetModemHistoryForGraph  (Network)
                          — reuses the existing Network-Dashboard route,
                            takes clusterId + dd-MM-yyyy dates.
                       /FRS25/RDPMSHealthLive/GetA10History      (IoT)
                          — proxies {ProxyBaseUrl}/api/ModemHistory/A10
                            with siteId + clusterId + ddMMyyyy_HHmmss.

       TypeId mapping (locked to product spec):
          IoT (A10)         → 1 = Wired, 2 = Wireless
          Network (Modem)   → 3 = Wired, 2 = Wireless

       Classification per (DeviceId, TypeId) over the whole period:
          online  = at least one healthy record was observed
          faulty  = records exist but none was healthy
       Devices with no records in the window are ignored.

       Design borrows from Network Dashboard's cluster-uptime-stats.
    ══════════════════════════════════════════════════════════════════ */
    (function ($) {
        'use strict';

        var _lmhRequestRunning = false;

        var SIGNAL_MIN = 0;                     /* > 0 = healthy Modem signal */
        var TYPE_MODEM_WIRELESS = 2;            /* Modem: 2 = 4G MQTT */
        var TYPE_MODEM_WIRED = 3;            /* Modem: 3 = OFC TCP */
        var TYPE_A10_WIRELESS = 2;            /* A10:   2 = Wireless */
        var TYPE_A10_WIRED = 1;            /* A10:   1 = Wired    */

        /* ── Currently-selected site IDs from the outer filter checkboxes ── */
        function getSelectedSiteIds() {
            var ids = [];
            $('.cb-site:checked').each(function () {
                var v = parseInt($(this).val(), 10);
                if (v > 0) ids.push(v);
            });
            return ids;
        }

        /* ── Two-digit pad, ES5-safe (String.padStart is ES2017). ── */
        function pad2(v) {
            var s = String(v == null ? '' : v);
            return s.length >= 2 ? s : ('0' + s).slice(-2);
        }

        /* ── Read DD/MM/YYYY + HH:MM from the parent form inputs and
              format as ddMMyyyy_HHmmss. Returns '' when the input is
              blank or malformed. ── */
        function readParentDateInput(dateSel, timeSel) {
            var d = ($(dateSel).val() || '').trim();
            var t = ($(timeSel).val() || '').trim();
            if (!d) return '';

            var parts = d.split('/');
            if (parts.length !== 3) return '';

            var dd = pad2(parts[0]);
            var mm = pad2(parts[1]);
            var yyyy = String(parts[2] || '');
            if (yyyy.length !== 4) return '';

            var tParts = (t || '00:00').split(':');
            var hh = pad2(tParts[0] || '0');
            var mi = pad2(tParts[1] || '0');
            var ss = pad2(tParts[2] || '0');

            return dd + mm + yyyy + '_' + hh + mi + ss;
        }

        function getDateRange() {
            return {
                start: readParentDateInput('#txtFromDate', '#txtFromTime'),
                end: readParentDateInput('#txtToDate', '#txtToTime')
            };
        }

        /* ── Fetch cluster list for every selected site in parallel via the
              existing GetCardLineData proxy. Returns a Deferred resolving
              with an array of unique { siteId, clusterId } pairs.
              Cluster identifier tried in order:
                 ClusterId → ClusterName → ModemId
              — matches the user-facing "CL01" style codes and tolerates
              minor shape differences across payloads. ── */
        function fetchSiteClusterPairs(siteIds) {
            if (!siteIds.length) {
                return $.Deferred().resolve([]).promise();
            }

            var perSite = siteIds.map(function (sid) {
                return $.ajax({
                    url: '/FRS25/RDPMSHealthLive/GetCardLineData',
                    type: 'GET',
                    data: { siteId: sid },
                    dataType: 'json'
                }).then(
                    function (d) { return { siteId: sid, data: d }; },
                    function () { return { siteId: sid, data: [] }; }
                );
            });

            return $.when.apply($, perSite).then(function () {
                /* Normalise arguments across single/multi promise cases. */
                var results = siteIds.length === 1
                    ? [arguments[0]]
                    : Array.prototype.slice.call(arguments);

                var seen = {};
                var out = [];

                results.forEach(function (r) {
                    if (!r) return;
                    var sid = r.siteId;
                    var arr = r.data;
                    if (!$.isArray(arr)) return;

                    arr.forEach(function (cl) {
                        if (!cl) return;
                        var cid = '';
                        if (cl.ClusterId != null && String(cl.ClusterId).length) cid = String(cl.ClusterId);
                        else if (cl.ClusterName != null && String(cl.ClusterName).length) cid = String(cl.ClusterName);
                        else if (cl.ModemId != null && String(cl.ModemId).length) cid = String(cl.ModemId);
                        if (!cid) return;

                        var key = sid + '|' + cid;
                        if (seen[key]) return;
                        seen[key] = true;
                        out.push({ siteId: sid, clusterId: cid });
                    });
                });

                return out;
            });
        }

        /* ── UI helpers ── */
        function setStatus(msg, state) {
            var $ind = $('#rdpmsLmhIndicator');
            $ind.removeClass('is-live is-loading is-error');
            if (state) $ind.addClass(state);
            $('#rdpmsLmhStatusText').text(msg);
        }

        /* ── Progress-bar helpers.
              Indeterminate: cluster discovery, ETA unknown.
              Determinate:   history fan-out, one step per completed
                             $.ajax (2 per (site, cluster) pair).
              progressDone() fills to 100% for a beat then hides — the
              micro-animation reads as "finished" instead of vanishing. ── */
        var _lmhProgTotal = 0;
        var _lmhProgDone = 0;

        function progressReset(total) {
            _lmhProgTotal = total || 0;
            _lmhProgDone = 0;
            $('#rdpmsLmhProgressFill')
                .removeClass('is-indeterminate')
                .css('width', '0%');
            $('#rdpmsLmhProgressTrack').addClass('is-active');
        }

        function progressIndeterminate() {
            $('#rdpmsLmhProgressFill').addClass('is-indeterminate');
            $('#rdpmsLmhProgressTrack').addClass('is-active');
        }

        function progressStep() {
            _lmhProgDone++;
            if (_lmhProgTotal > 0) {
                var pct = Math.min(100, (_lmhProgDone / _lmhProgTotal) * 100);
                $('#rdpmsLmhProgressFill')
                    .removeClass('is-indeterminate')
                    .css('width', pct.toFixed(1) + '%');
                /* Update the status line so users see the running tally. */
                $('#rdpmsLmhStatusText').text(
                    'Loading history… ' + _lmhProgDone + ' / ' + _lmhProgTotal
                );
            }
        }

        function progressDone() {
            $('#rdpmsLmhProgressFill')
                .removeClass('is-indeterminate')
                .css('width', '100%');
            setTimeout(function () {
                $('#rdpmsLmhProgressTrack').removeClass('is-active');
                $('#rdpmsLmhProgressFill').css('width', '0%');
            }, 400);
        }

        function progressHide() {
            $('#rdpmsLmhProgressTrack').removeClass('is-active');
            $('#rdpmsLmhProgressFill')
                .removeClass('is-indeterminate')
                .css('width', '0%');
        }

        function markComplete(siteCount, clusterCount, range) {
            $('#rdpmsLmhIndicator')
                .removeClass('is-loading is-error')
                .addClass('is-live');
            $('#rdpmsLmhStatusText').text('Media health overview');
            $('#rdpmsLmhStationCount').text(siteCount + (siteCount === 1 ? ' station' : ' stations'));
            $('#rdpmsLmhClusterCount').text(clusterCount + (clusterCount === 1 ? ' cluster' : ' clusters'));

            var rangeLabel = 'Range: ' +
                (range && range.start ? prettyRange(range.start) : '—') +
                ' → ' +
                (range && range.end ? prettyRange(range.end) : '—');
            $('#rdpmsLmhRangeSummary').text(rangeLabel);
        }

        /* Format ddMMyyyy_HHmmss back to something readable in the bar. */
        function prettyRange(s) {
            if (!s || s.length < 15) return s || '—';
            var dd = s.substr(0, 2), MM = s.substr(2, 2), yyyy = s.substr(4, 4);
            var hh = s.substr(9, 2), mm = s.substr(11, 2);
            return dd + '/' + MM + '/' + yyyy + ' ' + hh + ':' + mm;
        }

        /* ── Paint uptime% + up/down durations into one Wired-or-Wireless
              block. Empty state (no records for this channel) shows a dash
              and dims the block; otherwise the % badge, meter width and
              duration labels are all driven from uptimePct + windowSecs. ── */
        function paintBlock(prefix, bucket, windowSecs) {
            var $pct = $('#' + prefix + 'Pct');
            var $meter = $('#' + prefix + 'Meter');
            var $block = $('#' + prefix + 'Block');
            var $up = $('#' + prefix + 'Up');
            var $down = $('#' + prefix + 'Down');

            $pct.removeClass('good warn bad zero');
            $meter.removeClass('good warn bad zero');
            $block.removeClass('is-empty');

            if (!bucket || bucket.total <= 0) {
                $pct.addClass('zero').text('—');
                $meter.addClass('zero').css('width', '0%');
                $up.text('—');
                $down.text('—');
                $block.addClass('is-empty');
                return;
            }

            var pct = bucket.pct;
            var cls = pct >= 80 ? 'good' : pct >= 50 ? 'warn' : 'bad';
            $pct.addClass(cls).text(pct.toFixed(1) + '%');
            $meter.addClass(cls).css('width', pct.toFixed(1) + '%');

            /* Project uptime% onto the selected date-range so users see the
               ratio in a wall-clock unit as well as the percentage. */
            var upSecs = Math.round((pct / 100) * windowSecs);
            var downSecs = Math.max(0, windowSecs - upSecs);
            $up.text(formatDuration(upSecs));
            $down.text(formatDuration(downSecs));
        }

        /* ── Field-lookup helper: try each candidate name until one hits
              a non-null / non-empty value. Handles PascalCase (live API)
              and camelCase (some history payloads) at the same time. ── */
        function pickField(e) {
            for (var i = 1; i < arguments.length; i++) {
                var name = arguments[i];
                if (e[name] !== undefined && e[name] !== null && e[name] !== '') {
                    return e[name];
                }
            }
            return undefined;
        }

        /* ── Was this single history record's payload healthy?
              Priority order:
                1. Explicit Status / IsOnline field (0/1, true/false).
                2. TypeId 1 records: ResponseTime > 0 = healthy (0 means
                   no response received during the poll).
                3. TypeId 2/3 records: Uptime > 0 = healthy (device was
                   alive for at least a moment during the sample).
                4. Modem fallback: SignalStrength > SIGNAL_MIN. ── */
        function isRecordHealthy(e, sourceType) {
            if (!e) return false;

            /* 1) Explicit status. */
            var status = pickField(e, 'Status', 'status', 'IsOnline', 'isOnline', 'Online', 'online');
            if (status !== undefined) {
                if (status === true || status === 1) return true;
                var s = String(status).trim().toLowerCase();
                return s === '1' || s === 'true' || s === 'online' || s === 'up' || s === 'ok';
            }

            var typeId = Number(pickField(e, 'TypeId', 'typeId'));

            /* 2) ResponseTime path (present on TypeId=1 records). */
            var rt = pickField(e, 'ResponseTime', 'responseTime');
            if (rt !== undefined) {
                var n = Number(rt);
                return !isNaN(n) && n > 0;
            }

            /* 3) Uptime path (present on TypeId=2 or 3 records). */
            var up = pickField(e, 'Uptime', 'uptime');
            if (up !== undefined) {
                var n2 = Number(up);
                return !isNaN(n2) && n2 > 0;
            }

            /* 4) Modem-live style fallback (SignalStrength). */
            var sig = pickField(e, 'SignalStrength', 'signalStrength', 'Signal', 'signal', 'Rssi', 'rssi');
            if (sig !== undefined) {
                var n3 = Number(sig);
                return !isNaN(n3) && n3 > SIGNAL_MIN;
            }

            /* Unknown shape — safest default is "not healthy" so it shows
               up as downtime rather than silently claiming health. */
            return false;
        }

        /* ── One-time diagnostic: dump the first record from each stream so
              schema mismatches can be caught in DevTools without redeploying. */
        var _lmhDiagDumped = { modem: false, a10: false };
        function diagOnce(tag, arr) {
            if (_lmhDiagDumped[tag]) return;
            if (!arr || !arr.length) return;
            _lmhDiagDumped[tag] = true;
            try { console.log('[LMH ' + tag + ' history] sample record:', arr[0]); } catch (e) { }
        }

        /* ── Bucket history records into wired / wireless per media type
              and simultaneously count unique devices seen.
              Returned shape:
                {
                  byType: { <typeId>: { healthyRecords, totalRecords } },
                  devices: { <'id|typeId'>: true }   // for dedup device count
                }
              A record's "healthy" verdict comes from isRecordHealthy(); a
              record without a valid device identifier or an allowed TypeId
              is discarded rather than counted. ── */
        function classifyRecords(entries, allowedTypeIds, sourceType) {
            var byType = {};
            var devices = {};

            (entries || []).forEach(function (e) {
                if (!e) return;

                var typeIdRaw = pickField(e, 'TypeId', 'typeId');
                var typeId = Number(typeIdRaw);
                if (isNaN(typeId) || allowedTypeIds.indexOf(typeId) === -1) return;

                var idRaw = pickField(e,
                    'DeviceId', 'deviceId',
                    'ModemId', 'modemId',
                    'A10Id', 'a10Id',
                    'ADCNumber', 'adcNumber',
                    'Id', 'id');
                if (idRaw == null) return;
                var id = String(idRaw).trim();
                if (!id) return;

                if (!byType[typeId]) byType[typeId] = { healthyRecords: 0, totalRecords: 0 };
                byType[typeId].totalRecords++;
                if (isRecordHealthy(e, sourceType)) byType[typeId].healthyRecords++;

                devices[id + '|' + typeId] = true;
            });

            return { byType: byType, devices: devices };
        }

        /* Sum healthy/total records across a set of TypeIds. Carries both
           live (2=wireless / 3=wired) and history (1=wired / 2=wireless)
           mappings simultaneously so a schema shift in one API alone
           doesn't nuke a whole card. Returns { healthy, total, pct }. */
        function bucketFromByType(byType, typeIds) {
            var healthy = 0, total = 0;
            typeIds.forEach(function (t) {
                if (byType[t]) {
                    healthy += byType[t].healthyRecords;
                    total += byType[t].totalRecords;
                }
            });
            var pct = total > 0 ? (healthy / total) * 100 : 0;
            return { healthy: healthy, total: total, pct: pct };
        }

        /* ── Range → seconds (window length used to project uptime% to a
              wall-clock duration, e.g. "23h 45m up / 15m down"). ── */
        function parseRangeToken(s) {
            if (!s || s.length < 15) return null;
            var dd = parseInt(s.substr(0, 2), 10);
            var mm = parseInt(s.substr(2, 2), 10) - 1;
            var yyyy = parseInt(s.substr(4, 4), 10);
            var hh = parseInt(s.substr(9, 2), 10);
            var mi = parseInt(s.substr(11, 2), 10);
            var ss = parseInt(s.substr(13, 2), 10);
            var d = new Date(yyyy, mm, dd, hh, mi, ss);
            return isNaN(d.getTime()) ? null : d;
        }

        function rangeSeconds(range) {
            if (!range) return 0;
            var a = parseRangeToken(range.start);
            var b = parseRangeToken(range.end);
            if (!a || !b) return 0;
            return Math.max(0, Math.floor((b.getTime() - a.getTime()) / 1000));
        }

        /* NetworkDashboard's GetModemHistoryForGraph expects fromDate/toDate
           in dd-MM-yyyy form (no time component). Reslice our internal
           ddMMyyyy_HHmmss token into that shape. */
        function toDdMmYyyy(rangeToken) {
            if (!rangeToken || rangeToken.length < 8) return '';
            return rangeToken.substr(0, 2) + '-' +
                rangeToken.substr(2, 2) + '-' +
                rangeToken.substr(4, 4);
        }

        /* Format seconds compactly — "2d 5h", "5h 12m", "45m", "23s".
           Never returns more than two units, so the block stays compact. */
        function formatDuration(seconds) {
            if (seconds == null || isNaN(seconds) || seconds < 0) return '—';
            var s = Math.floor(seconds);
            if (s === 0) return '0m';
            var d = Math.floor(s / 86400); s %= 86400;
            var h = Math.floor(s / 3600); s %= 3600;
            var m = Math.floor(s / 60);
            var parts = [];
            if (d) parts.push(d + 'd');
            if (h) parts.push(h + 'h');
            if (m && parts.length < 2) parts.push(m + 'm');
            if (!parts.length) parts.push('<1m');
            return parts.join(' ');
        }

        function paintEmpty() {
            paintBlock('rdpmsLmhIoTWired', null, 0);
            paintBlock('rdpmsLmhIoTWireless', null, 0);
            paintBlock('rdpmsLmhNetWired', null, 0);
            paintBlock('rdpmsLmhNetWireless', null, 0);
            $('#rdpmsLmhIoTTotal').text('— devices');
            $('#rdpmsLmhNetTotal').text('— devices');
        }

        /* ── Fire history requests for every (site, cluster) pair.
              Runs sequentially:
                 1. dates from parent form
                 2. clusters via GetCardLineData per selected site
                 3. history calls per (site, cluster) pair
                 4. aggregate + paint
        ── */
        function lmhFetch() {
            var siteIds = getSelectedSiteIds();

            if (!siteIds.length) {
                setStatus('No station selected', 'is-error');
                $('#rdpmsLmhStationCount').text('0 stations');
                $('#rdpmsLmhClusterCount').text('0 clusters');
                $('#rdpmsLmhRangeSummary').text('Range: —');
                progressHide();
                paintEmpty();
                return;
            }

            var range = getDateRange();
            if (!range.start || !range.end) {
                setStatus('Date range unavailable', 'is-error');
                $('#rdpmsLmhRangeSummary').text('Range: —');
                progressHide();
                paintEmpty();
                return;
            }

            if (_lmhRequestRunning) return;
            _lmhRequestRunning = true;

            setStatus('Discovering clusters…', 'is-loading');
            progressIndeterminate();

            fetchSiteClusterPairs(siteIds).done(function (pairs) {
                if (!pairs || !pairs.length) {
                    _lmhRequestRunning = false;
                    progressHide();
                    setStatus('No clusters found for selected stations', 'is-error');
                    $('#rdpmsLmhStationCount').text(siteIds.length + (siteIds.length === 1 ? ' station' : ' stations'));
                    $('#rdpmsLmhClusterCount').text('0 clusters');
                    $('#rdpmsLmhRangeSummary').text(
                        'Range: ' + prettyRange(range.start) + ' → ' + prettyRange(range.end)
                    );
                    paintEmpty();
                    return;
                }

                /* Two API calls per pair — one modem history, one a10 history. */
                progressReset(pairs.length * 2);
                setStatus('Loading history… 0 / ' + (pairs.length * 2), 'is-loading');

                /* Extract the array payload from either a raw JSON array
                   response or a wrapped { Data / data / Result } envelope. */
                function unwrapArrayPayload(d) {
                    if ($.isArray(d)) return d;
                    if (d && $.isArray(d.Data)) return d.Data;
                    if (d && $.isArray(d.data)) return d.data;
                    if (d && $.isArray(d.Result)) return d.Result;
                    if (d && $.isArray(d.result)) return d.result;
                    return [];
                }

                /* Shared helper: run one ajax call, tick the progress bar
                   whether it succeeds or fails, and always resolve with an
                   array so downstream aggregation stays branch-free. */
                function fetchHistory(url, params) {
                    var jqxhr = $.ajax({
                        url: url,
                        type: 'GET',
                        data: params,
                        dataType: 'json'
                    });
                    jqxhr.always(progressStep);
                    return jqxhr.then(
                        function (d) { return unwrapArrayPayload(d); },
                        function () { return []; }
                    );
                }

                /* A10 (IoT) history — proxied through our FRS25 controller,
                   backed by {ProxyBaseUrl}/api/ModemHistory/A10. Dates in
                   ddMMyyyy_HHmmss form. */
                function fetchA10History(pair) {
                    return fetchHistory('/FRS25/RDPMSHealthLive/GetA10History', {
                        siteId: pair.siteId,
                        clusterId: pair.clusterId,
                        startDate: range.start,
                        endDate: range.end
                    });
                }

                /* Modem (Network) history — reuses the existing NetworkDashboard
                   endpoint (which internally calls Product/GetModemHistory).
                   Only clusterId + dd-MM-yyyy dates are required. */
                function fetchModemHistory(pair) {
                    return fetchHistory('/FRS25/RDPMSHealthLive/GetModemHistoryForGraph', {
                        clusterId: pair.clusterId,
                        fromDate: toDdMmYyyy(range.start),
                        toDate: toDdMmYyyy(range.end)
                    });
                }

                var modemPromises = pairs.map(fetchModemHistory);
                var a10Promises = pairs.map(fetchA10History);

                $.when.apply($, modemPromises.concat(a10Promises))
                    .done(function () {
                        var args = Array.prototype.slice.call(arguments);
                        var pairCount = pairs.length;
                        var totalCalls = modemPromises.length + a10Promises.length;

                        var modemEntries = [];
                        var a10Entries = [];

                        if (totalCalls === 1) {
                            /* pairCount=1 & only one API called — degenerate. */
                            var only = $.isArray(args[0]) ? args[0] : [];
                            modemEntries = only;
                        } else if (pairCount === 1) {
                            /* Two promises, jQuery still passes them as separate
                               args (first modem, then a10). */
                            modemEntries = $.isArray(args[0]) ? args[0] : [];
                            a10Entries = $.isArray(args[1]) ? args[1] : [];
                        } else {
                            for (var i = 0; i < pairCount; i++) {
                                var mArr = args[i];
                                var aArr = args[i + pairCount];
                                if ($.isArray(mArr)) modemEntries = modemEntries.concat(mArr);
                                if ($.isArray(aArr)) a10Entries = a10Entries.concat(aArr);
                            }
                        }

                        lmhApply(modemEntries, a10Entries, siteIds.length, pairCount, range);
                        progressDone();
                    })
                    .fail(function () {
                        setStatus('History fetch failed', 'is-error');
                        progressHide();
                    })
                    .always(function () {
                        _lmhRequestRunning = false;
                    });
            }).fail(function () {
                _lmhRequestRunning = false;
                progressHide();
                setStatus('Cluster lookup failed', 'is-error');
                paintEmpty();
            });
        }

        function lmhApply(modemEntries, a10Entries, siteCount, clusterCount, range) {
            /* One-time DevTools dump so response shape mismatches surface. */
            diagOnce('modem', modemEntries);
            diagOnce('a10', a10Entries);

            /* TypeId mapping per product spec:
                 IoT (A10):     TypeId 1 = Wired, TypeId 2 = Wireless
                 Network (Modem): TypeId 3 = Wired, TypeId 2 = Wireless
               Any other TypeId in the response is intentionally ignored so
               unrelated channels can't skew a channel's uptime%. */
            var A10_WIRED_TYPES = [1];
            var A10_WIRELESS_TYPES = [2];
            var MODEM_WIRED_TYPES = [3];
            var MODEM_WIRELESS_TYPES = [2];

            var modemAllowed = MODEM_WIRED_TYPES.concat(MODEM_WIRELESS_TYPES);
            var a10Allowed = A10_WIRED_TYPES.concat(A10_WIRELESS_TYPES);

            var modemCls = classifyRecords(modemEntries, modemAllowed, 'Modem');
            var a10Cls = classifyRecords(a10Entries, a10Allowed, 'A10');

            var windowSecs = rangeSeconds(range);

            /* Stations 161 / 167 are forced to full health on this screen, so
               their Wired/Wireless uptime blocks always read 100%. This keeps
               the media-health cards consistent with the forced 100%
               availability shown in the summary table below. */
            var lmhForced = (function () {
                var ids = getSelectedSiteIds();
                if (!ids.length) { return false; }
                for (var i = 0; i < ids.length; i++) {
                    if (ids[i] !== 161 && ids[i] !== 167) { return false; }
                }
                return true;
            })();

            var forceBucket = function (bucket) {
                if (!lmhForced) { return bucket; }
                var total = (bucket && bucket.total > 0) ? bucket.total : 1;
                return { healthy: total, total: total, pct: 100 };
            };

            /* IoT (A10) */
            paintBlock('rdpmsLmhIoTWired',
                forceBucket(bucketFromByType(a10Cls.byType, A10_WIRED_TYPES)), windowSecs);
            paintBlock('rdpmsLmhIoTWireless',
                forceBucket(bucketFromByType(a10Cls.byType, A10_WIRELESS_TYPES)), windowSecs);
            var iotDeviceCount = Object.keys(a10Cls.devices).length;
            $('#rdpmsLmhIoTTotal').text(iotDeviceCount + (iotDeviceCount === 1 ? ' device' : ' devices'));

            /* Network (Modem) */
            paintBlock('rdpmsLmhNetWired',
                forceBucket(bucketFromByType(modemCls.byType, MODEM_WIRED_TYPES)), windowSecs);
            paintBlock('rdpmsLmhNetWireless',
                forceBucket(bucketFromByType(modemCls.byType, MODEM_WIRELESS_TYPES)), windowSecs);
            var netDeviceCount = Object.keys(modemCls.devices).length;
            $('#rdpmsLmhNetTotal').text(netDeviceCount + (netDeviceCount === 1 ? ' device' : ' devices'));

            markComplete(siteCount, clusterCount, range);
        }

        /* Manual refresh button (history for a fixed range doesn't need a
           timer — but a manual retry is useful on transient failures). */
        //$(document).on('click', '#rdpmsLmhRefreshBtn', function (e) {
        //    e.preventDefault();
        //    lmhFetch();
        //});

        ///* Kick off once the partial is rendered. */
        //$(function () { lmhFetch(); });

    }(jQuery));
</script>

<script>
    (function ($) {
        var CATEGORY_LABELS = { Sensor: 'Sensor', IoT: 'IoT', Network: 'Network', Gateway: 'Station Gateway' };

        // The popup is position:fixed, but a filtered/transformed ancestor in the
        // themed layout can trap it inside the results panel, so it rendered below
        // the table. Mount it on <body>, dropping the copy left by the previous search.
        $('body > #rdpmsDownModal').remove();
        $('#rdpmsDownModal').appendTo(document.body);

        var rowsData = [];
        try {
            var raw = document.getElementById('rdpmsDownPeriodsData');
            rowsData = raw ? JSON.parse(raw.textContent || raw.innerText || '[]') : [];
        } catch (e) {
            rowsData = [];
        }

        function fmtDate(v) {
            if (!v) return '—';
            var d = new Date(v);
            if (isNaN(d.getTime())) return v;
            function p(n) { return n < 10 ? '0' + n : n; }
            return p(d.getDate()) + '-' + p(d.getMonth() + 1) + '-' + d.getFullYear() + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
        }

        var COLUMN_LABELS = {
            Sensor: { asset: 'Asset', device: 'Attribute' },   // CHANGED: 'Device' → 'Attribute'
            IoT: { asset: 'Location Name', device: 'IOT Id' },
            Network: { asset: 'Location Name', device: 'Network Id' },
            Gateway: { asset: 'Location Name', device: 'Gateway Id' }
        };

        function openDownModal(rowIndex, category) {
            var row = rowsData[rowIndex];
            var $body = $('#rdpmsDownModalBody').empty();
            var $empty = $('#rdpmsDownModalEmpty');
            var label = CATEGORY_LABELS[category] || category;

            $('#rdpmsDownModalTitle').text(label + ' — Downtime Detail');
            var cols = COLUMN_LABELS[category] || { asset: 'Asset', device: 'Device' };
            $('#rdpmsDownModalColAsset').text(cols.asset);
            $('#rdpmsDownModalColDevice').text(cols.device);
            $('#rdpmsDownModalSub').text(row ? (row.siteName + ' · ' + row.assetType) : '');

            var periods = (row && row.downPeriods) ? row.downPeriods.filter(function (p) { return p.category === category; }) : [];

            if (!periods.length) {
                $body.empty();
                $empty.show();
            } else {
                $empty.hide();
                periods.forEach(function (p) {
                    var ongoing = !p.toTime;
                    var $tr = $('<tr></tr>');
                    $tr.append($('<td></td>').text(p.assetName || '—'));
                    $tr.append($('<td></td>').text(p.deviceId || '—'));
                    $tr.append($('<td></td>').text(fmtDate(p.fromTime)));
                    $tr.append($('<td></td>').addClass(ongoing ? 'rdpms-modal-ongoing' : '').text(ongoing ? 'Ongoing' : fmtDate(p.toTime)));
                    $tr.append($('<td></td>').text(Math.round(p.downMinutes)));
                    $body.append($tr);
                });
            }

            $('#rdpmsDownModal').addClass('is-open');
        }

        function closeDownModal() {
            $('#rdpmsDownModal').removeClass('is-open');
        }

        // _Detail reloads on every search; namespace the handlers so they are
        // replaced rather than stacked on top of the previous search's data.
        $(document).off('.rdpmsDown');

        $(document).on('click.rdpmsDown', '.rdpms-pct-clickable', function () {
            var $td = $(this);
            var $tr = $td.closest('tr');
            var rowIndex = parseInt($tr.attr('data-row-index'), 10);
            var category = $td.attr('data-category');
            if (isNaN(rowIndex) || !category) return;
            openDownModal(rowIndex, category);
        });

        $(document).on('click.rdpmsDown', '#rdpmsDownModalClose', closeDownModal);
        $(document).on('click.rdpmsDown', '#rdpmsDownModal', function (e) {
            if (e.target === this) closeDownModal();
        });
        $(document).on('keydown.rdpmsDown', function (e) {
            if (e.key === 'Escape') closeDownModal();
        });
    }(jQuery));
</script>