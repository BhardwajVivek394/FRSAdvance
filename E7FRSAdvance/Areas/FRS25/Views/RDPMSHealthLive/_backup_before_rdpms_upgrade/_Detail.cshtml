    function rdpmsMoveTip(e) {
        var $tt = $('#rdpmsTooltip');
        var x = e.clientX + 16, y = e.clientY + 16;
        if (x + 230 > window.innerWidth) x = e.clientX - 240;
        if (y + $tt.outerHeight() > window.innerHeight) y = e.clientY - $tt.outerHeight() - 8;
        $tt.css({ left: x + 'px', top: y + 'px' });
    }
    function rdpmsHideTip() { $('#rdpmsTooltip').removeClass('show'); }

