    <div class="row">
        <div class="col-lg-12">
            <div class="card">

                <div class="card-body p-0">
                    <div class="search-section">
                        <div class="search-title">Search</div>

                        <!-- Backdrop for closing dropdowns -->
                        <div class="dropdown-backdrop" id="backdrop"></div>

                        <div class="filter-row">
                            <!-- Zone -->
