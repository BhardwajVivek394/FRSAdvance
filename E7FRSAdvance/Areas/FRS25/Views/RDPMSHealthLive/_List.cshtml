                                        <span id="picOutModemNetWiredTime_@(cluster.SiteId)_@(cluster.ModemId)" class="pic-time"></span>
                                    </div>
                                    <!-- Ghost icon + label keep the Wireless tag aligned under the
                                    Wired tag without hard-coding the label width. -->
                                    <div class="pic-health-row">
                                        <span class="pic-hi pic-hi-net pic-ghost"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18" /></svg></span>
                                        <span class="pic-hl pic-ghost">Network :</span>
                                        <span class="pic-leg-tag pic-leg-tag--wireless">Wireless</span>
                                        <span id="picOutModemNetWirelessVal_@(cluster.SiteId)_@(cluster.ModemId)" class="pic-val pic-val--healthy">Healthy</span>
                                        <span id="picOutModemNetWirelessTime_@(cluster.SiteId)_@(cluster.ModemId)" class="pic-time"></span>
                                    </div>
                                    <!-- Sensor summary -->
                                    <div class="pic-health-row">
                                        <span class="pic-hi pic-hi-sensor">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4" /></svg>
                                        </span>
                                        <span class="pic-hl">Sensor :</span>
                                        <span id="picOutModemSensorSumVal_@(cluster.SiteId)_@(cluster.ModemId)"
                                              class="pic-val pic-val--healthy">Healthy</span>
                                        <span id="picOutModemSensorSumInfo_@(cluster.SiteId)_@(cluster.ModemId)"
                                              class="pic-time"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="pic-sensor-section" id="picOutModemSensorSection_@(cluster.SiteId)_@(cluster.ModemId)" style="display:none;">
                                <div class="pic-sensor-header">
                                    <span class="pic-hi pic-hi-sensor"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4" /></svg></span>
                                    <span class="pic-hl">Sensor</span>
                                    <span class="pic-sensor-badge" id="picOutModemSensorBadge_@(cluster.SiteId)_@(cluster.ModemId)"></span>
                                </div>
                                <div class="pic-sensor-list" id="picOutModemSensorList_@(cluster.SiteId)_@(cluster.ModemId)"></div>
                            </div>

                        </div><!-- /.pic-modem-card -->
                    }
                }
            </div>

            <!-- Empty state -->
            <div id="picOutdoorEmpty" class="pic-empty-state" style="display:none;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                <div class="pic-empty-title">All Systems Healthy</div>
                <div class="pic-empty-sub">No faulty components detected in Outdoor RDPMS</div>
            </div>

        </div><!-- /#picOutdoorPanel -->

    </div><!-- /#pictorialView -->
</div><!-- /.col.px-0 — end of partial container -->
<!-- ══════════════════════════════════════════════════════════════════════
     STYLES
══════════════════════════════════════════════════════════════════════ -->
<style>
    /* ── stat table ── */
    #mainview {
        gap: 16px
    }

    .rdpms-stat-table-wrap {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden
    }

    .rdpms-stat-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        table-layout: fixed
    }

    .rdpms-group-row th, .rdpms-sub-row th {
        background: #f8fafc
    }

    .rdpms-group-header {
        padding: 9px 10px;
        text-align: center;
        font-weight: 600;
        font-size: 11.5px;
        letter-spacing: .3px;
        border-right: 1px solid #e2e8f0;
        border-bottom: 2px solid currentColor
    }

    .rdpms-gh-blue {
        color: #378ADD
    }

    .rdpms-gh-green {
        color: #1D9E75
    }

    .rdpms-gh-amber {
        color: #BA7517
    }

    .rdpms-gh-purple {
        color: #534AB7
    }

    .rdpms-group-header svg {
        vertical-align: middle;
        margin-right: 4px
    }

    .rdpms-sub-header {
        padding: 6px 10px;
        text-align: center;
        font-weight: 500;
        font-size: 11px;
        color: #475569;
        border-bottom: 1px solid #e2e8f0;
        border-right: 1px dashed #e2e8f0
    }

    .rdpms-val-cell {
        padding: 13px 10px;
        text-align: center;
        font-size: 20px;
        font-weight: 600;
        border-right: 1px dashed #e2e8f0
    }

        .rdpms-val-cell.green {
            color: #16a34a
        }

        .rdpms-val-cell.red {
            color: #dc2626
        }

    .rdpms-sep-solid {
        border-right: 1px solid #e2e8f0 !important
    }

    .rdpms-no-right-border {
        border-right: none !important
    }

    /* ── table view ── */
    .rdpms-list-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 8px 0 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        overflow: hidden
    }

    .rdpms-table {
        margin-bottom: 0;
        font-size: 13.5px;
        color: #1e293b
    }

        .rdpms-table thead tr {
            background: transparent;
            border-bottom: 2px solid #f1f5f9
        }

        .rdpms-table thead th {
            font-weight: 600;
            font-size: 13px;
            color: #475569;
            border: none;
            padding: 12px 14px;
            white-space: nowrap
        }

        .rdpms-table tbody tr {
            border-bottom: 1px solid #f8fafc;
            transition: background .15s
        }

            .rdpms-table tbody tr:hover {
                background: #f8fafc
            }

        .rdpms-table tbody td {
            padding: 11px 14px;
            border: none;
            vertical-align: middle
        }

    .rdpms-pager-wrap {
        padding: 12px 16px 4px
    }

        .rdpms-pager-wrap .page-link {
            border-radius: 6px !important;
            margin: 0 2px;
            font-size: 13px;
            color: #475569;
            border-color: #e2e8f0
        }

        .rdpms-pager-wrap .page-item.active .page-link {
            background-color: #6366f1;
            border-color: #6366f1;
            color: #fff
        }

        .rdpms-pager-wrap .page-item.disabled .page-link {
            color: #cbd5e1
        }

    .badge-danger {
        background-color: #fee2e2;
        color: #dc2626;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 5px;
        font-size: 12px
    }

    .badge-success {
        background-color: #dcfce7;
        color: #16a34a;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 5px;
        font-size: 12px
    }

    /* ── Detail icon button ── */
    .rdpms-detail-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border: none;
        background: none;
        cursor: pointer;
        padding: 0;
        margin-left: 5px;
        vertical-align: middle;
        color: #64748b;
        border-radius: 50%;
        transition: color .15s, background .15s;
    }

        .rdpms-detail-btn:hover {
            color: #1d4ed8;
            background: #e0eaff;
        }

    /* ── Centered Popup Modal ── */
    .rdpms-popup-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, .45);
        z-index: 10000;
        align-items: center;
        justify-content: center;
        padding: 20px;
        animation: rdpmsOverlayIn .18s ease;
    }

        .rdpms-popup-overlay.open {
            display: flex;
        }

    @@keyframes rdpmsOverlayIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes rdpmsPopupIn {
        from {
            opacity: 0;
            transform: scale(.94) translateY(-10px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .rdpms-popup {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 24px 60px rgba(0,0,0,.22), 0 4px 16px rgba(0,0,0,.1);
        width: 500px;
        max-width: 96vw;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        animation: rdpmsPopupIn .22s cubic-bezier(.34,1.26,.64,1);
        overflow: hidden;
    }

    /* Header strip — coloured per type */
    .rdpms-popup-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 22px 16px;
        border-bottom: 1px solid #e2e8f0;
        flex-shrink: 0;
    }

        .rdpms-popup-head.type-sensor {
            border-top: 4px solid #378add;
        }

        .rdpms-popup-head.type-iot {
            border-top: 4px solid #1d9e75;
        }

        .rdpms-popup-head.type-network {
            border-top: 4px solid #7c3aed;
        }

    .rdpms-popup-title {
        font-size: 15px;
        font-weight: 700;
        color: #1e293b;
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .rdpms-popup-close {
        border: none;
        background: #f1f5f9;
        cursor: pointer;
        color: #64748b;
        font-size: 16px;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        line-height: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .15s, color .15s;
    }

        .rdpms-popup-close:hover {
            background: #e2e8f0;
            color: #1e293b;
        }

    /* Context breadcrumb strip */
    .rdpms-popup-meta {
        display: flex;
        align-items: center;
        gap: 0;
        padding: 9px 22px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        flex-shrink: 0;
        flex-wrap: wrap;
    }

    .rdpms-popup-meta-item {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 12px;
        color: #475569;
    }

        .rdpms-popup-meta-item strong {
            color: #1e293b;
            font-weight: 600;
        }

    .rdpms-popup-meta-sep {
        color: #cbd5e1;
        margin: 0 6px;
        font-size: 14px;
    }

    /* Scrollable body */
    .rdpms-popup-body {
        flex: 1;
        overflow-y: auto;
        padding: 20px 22px;
    }

    /* Overall status pill */
    .rdpms-popup-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 18px;
    }

        .rdpms-popup-status.healthy {
            background: #dcfce7;
            color: #16a34a;
        }

        .rdpms-popup-status.faulty {
            background: #fee2e2;
            color: #dc2626;
        }

        .rdpms-popup-status.unknown {
            background: #f1f5f9;
            color: #64748b;
        }

        /* "na" here is always a MASKED reading (parent link down, status
           suppressed), never a structurally absent device - so it is amber,
           while .unknown above stays grey for "nothing received yet". */
        .rdpms-popup-status.na {
            background: #fef3c7;
            color: #b45309;
        }

    /* Fault card */
    .rdpms-popup-fault-card {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 10px;
        background: #fff5f5;
        border: 1px solid #fecdd3;
        margin-bottom: 8px;
    }

    .rdpms-popup-fault-num {
        flex-shrink: 0;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #dc2626;
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .rdpms-popup-fault-body {
        flex: 1;
    }

    .rdpms-popup-fault-name {
        font-size: 13px;
        font-weight: 600;
        color: #1e293b;
        line-height: 1.35;
    }

    .rdpms-popup-fault-sub {
        font-size: 12px;
        color: #64748b;
        margin-top: 3px;
    }

    .rdpms-popup-fault-time {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 11px;
        color: #94a3b8;
        margin-top: 5px;
    }

    /* Healthy card */
    .rdpms-popup-healthy-card {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        border-radius: 10px;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        font-size: 13px;
        font-weight: 600;
        color: #15803d;
        margin-bottom: 8px;
    }

    /* Network section */
    .rdpms-popup-net-section {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 8px;
    }

    .rdpms-popup-section-title {
        display: flex;
        align-items: center;
        gap: 7px;
        margin: 14px 0 7px;
        color: #64748b;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .rdpms-popup-section-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 18px;
        height: 18px;
        padding: 0 5px;
        border-radius: 9px;
        background: #e2e8f0;
        color: #475569;
        font-size: 10px;
    }

    .rdpms-popup-modem-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
        margin-bottom: 10px;
    }

    .rdpms-popup-modem-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border-radius: 8px;
        font-size: 11px;
        white-space: nowrap;
    }

        .rdpms-popup-modem-chip.healthy {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #166534;
        }

        /* Modem whose only verdict-bearing leg is masked -> N/A, not Healthy. */
        .rdpms-popup-modem-chip.masked {
            background: #fffbeb;
            border: 1px solid #fcd34d;
            color: #b45309;
        }

            .rdpms-popup-modem-chip.masked .rdpms-popup-modem-chip-status {
                color: #b45309;
            }

    .rdpms-popup-modem-chip-status {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: #16a34a;
        font-size: 10px;
        font-weight: 700;
    }

    .rdpms-popup-net-grid {
        display: grid;
        /* minmax(0,1fr), not 1fr: a plain 1fr track refuses to shrink below its
           content, so the Wired / Wireless cards overflowed the drawer and the
           section's overflow:hidden cut the status pill off. */
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 8px;
    }

        .rdpms-popup-net-grid .rdpms-popup-net-section {
            margin-bottom: 0;
        }

    @@media (max-width: 600px) {
        .rdpms-popup-net-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    .rdpms-popup-net-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 11px 14px;
        background: #f8fafc;
        font-size: 12px;
        font-weight: 700;
        color: #334155;
        letter-spacing: .03em;
        gap: 10px;
        /* Wrap rather than clip: when the label and a wide status pill cannot
           share one line in a half-width grid track, the pill drops to its own
           line under the label instead of being cut off by the section's
           overflow:hidden. */
        flex-wrap: wrap;
    }

    /* only show divider when a body row follows */
    .rdpms-popup-net-section.has-body .rdpms-popup-net-head {
        border-bottom: 1px solid #e2e8f0;
    }

    /* medium icon box — wired vs wireless */
    .rdpms-popup-net-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 7px;
        flex-shrink: 0;
        font-size: 14px;
    }

        .rdpms-popup-net-icon.wired {
            background: #e0f2fe;
            color: #0369a1;
        }

        .rdpms-popup-net-icon.wireless {
            background: #ede9fe;
            color: #7c3aed;
        }

    .rdpms-popup-net-label-wrap {
        display: flex;
        align-items: center;
        gap: 9px;
        flex: 1;
        font-size: 13px;
        font-weight: 600;
        color: #1e293b;
        /* Must NOT shrink below its own content. Allowing that (min-width:0)
           squeezed "OFC / TCP" onto two lines and left the status pill sitting
           alongside the broken label instead of dropping below it. Holding the
           label at its natural width makes the head's flex-wrap do the right
           thing: the pill moves to its own line when it no longer fits. */
        min-width: auto;
    }

    .rdpms-popup-net-label-sub {
        font-size: 11px;
        font-weight: 400;
        color: #94a3b8;
        margin-top: 1px;
        /* "OFC / TCP" and "4G / MQTT" are one unit - never break them. */
        white-space: nowrap;
    }

    .rdpms-popup-net-body {
        padding: 12px 14px;
        font-size: 13px;
    }

    .rdpms-popup-net-badge-healthy {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 12px;
        background: #dcfce7;
        color: #16a34a;
        font-weight: 700;
        font-size: 12px;
    }

    .rdpms-popup-net-badge-faulty {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 12px;
        background: #fee2e2;
        color: #dc2626;
        font-weight: 700;
        font-size: 12px;
    }

    .rdpms-popup-net-badge-na {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 12px;
        background: #f1f5f9;
        color: #64748b;
        font-weight: 700;
        font-size: 12px;
    }

    /* Masked reading (parent link down). N/A in amber, never grey: the
       reading is SUPPRESSED, which is not the same as "no data at all". */
    .rdpms-popup-net-badge-masked {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 12px;
        background: #fef3c7;
        border: 1px solid #fcd34d;
        color: #b45309;
        font-weight: 700;
        font-size: 12px;
    }

    /* The four status pills sit in a flex head inside a section that CLIPS
       (overflow:hidden), and the head lives in a half-width grid track. A pill
       wider than its share - "Undetermined" is nearly twice "Healthy" - was
       being squeezed and then cut off at the section edge. Keep each pill at
       its natural width and let the HEAD wrap instead (rule below). */
    .rdpms-popup-net-badge-healthy,
    .rdpms-popup-net-badge-faulty,
    .rdpms-popup-net-badge-na,
    .rdpms-popup-net-badge-masked {
        flex-shrink: 0;
        white-space: nowrap;
        max-width: 100%;
    }

    /* Device ID chip */
    .rdpms-popup-device-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        border-radius: 7px;
        font-size: 12px;
        color: #1e293b;
        margin: 0 5px 6px 0;
    }

        /* faulty variant — same chip, red tint */
        .rdpms-popup-device-chip.is-faulty {
            background: #fef2f2;
            border-color: #fecaca;
        }

        /* masked variant — same chip, amber tint (parent link down / Undetermined) */
        .rdpms-popup-device-chip.is-masked {
            background: #fffbeb;
            border-color: #fde68a;
        }

    /* Chip container. Without this the inline-flex chips sat in a bare div,
       so a long alias ("A/B VPT NWKR CONTACT") pushed past the popup edge and
       the list read as overlapping text. */
    .rdpms-popup-chip-wrap {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 6px;
        max-width: 100%;
    }

        .rdpms-popup-chip-wrap .rdpms-popup-device-chip {
            margin: 0;
            max-width: 100%;
            align-items: center;
        }

    .rdpms-popup-chip-name {
        overflow-wrap: anywhere;
        line-height: 1.35;
    }

    .rdpms-popup-chip-link {
        color: #94a3b8;
        font-size: 11px;
        white-space: nowrap;
        flex: 0 0 auto;
        padding-left: 4px;
        border-left: 1px solid #e2e8f0;
    }

    .rdpms-popup-attr-empty {
        padding: 10px 12px;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        font-size: 12px;
        color: #64748b;
    }

    /* Attribute roll-up heading */
    .rdpms-popup-attr-head {
        margin: 14px 0 8px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #64748b;
    }

    /* Empty state */
    .rdpms-popup-empty {
        text-align: center;
        padding: 32px 20px;
        color: #94a3b8;
