        3002: 'B IPT N',
        3004: 'B IPT N',
        3005: 'B TPT N',
        4002: 'B VPT 110 DC LOC N',

        /* A End — Reverse */
        6002: 'A IPT R',
        6004: 'A IPT R',
        6005: 'A TPT R',
        7002: 'A VPT 110 DC LOC R',

        /* B End — Reverse */
        8002: 'B IPT R',
        8004: 'B IPT R',
        8005: 'B TPT R',
        9002: 'B VPT 110 DC LOC R'
