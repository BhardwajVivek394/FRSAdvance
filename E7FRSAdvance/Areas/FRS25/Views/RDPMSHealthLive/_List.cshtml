@model Domain.RDPMSHealthLiveLister

<div class="col px-0">

    <style>
        .nhb-dot-inline {
            display: inline-block;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            margin-right: 4px;
            vertical-align: middle;
        }

        /*
        * Compact Wired/Wireless status presentation.
        * Each table column represents one communication channel.
        */
        .rdpms-channel-card {
            display: flex;
            align-items: stretch;
            justify-content: center;
            gap: 5px;
            min-width: 108px;
            padding: 3px;
        }

        .rdpms-channel-metric {
            display: flex;
            flex: 1;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-width: 45px;
            padding: 5px 6px;
            border-radius: 7px;
            line-height: 1.1;
        }

            .rdpms-channel-metric.online {
                color: #15803d;
                background: #ecfdf3;
                border: 1px solid #bbf7d0;
            }

            .rdpms-channel-metric.faulty {
                color: #dc2626;
                background: #fff1f2;
                border: 1px solid #fecdd3;
            }

        .rdpms-channel-caption {
            display: inline-flex;
            align-items: center;
            margin-bottom: 4px;
            font-size: 8px;
            font-weight: 700;
            color: #64748b;
            white-space: nowrap;
        }

        .rdpms-channel-metric strong {
            font-size: 13px;
            font-weight: 800;
            line-height: 1;
        }

        .rdpms-health-dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            margin-right: 3px;
            border-radius: 50%;
            flex: 0 0 auto;
        }

            .rdpms-health-dot.online {
                background: #22c55e;
            }

            .rdpms-health-dot.offline {
                background: #ef4444;
            }

        .rdpms-network-refresh-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin: 0 0 8px;
            padding: 7px 11px;
            border: 1px solid #dbeafe;
            border-radius: 7px;
            background: #f8fbff;
            color: #475569;
            font-size: 10px;
            font-weight: 600;
        }

        .rdpms-refresh-left,
        .rdpms-refresh-right {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .rdpms-refresh-indicator {
            width: 8px;
            height: 8px;
            flex: 0 0 auto;
            border-radius: 50%;
            background: #94a3b8;
        }

            .rdpms-refresh-indicator.is-live {
                background: #22c55e;
                box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.13);
            }

            .rdpms-refresh-indicator.is-loading {
                background: #3b82f6;
                animation: nmRefreshPulse 1s infinite ease-in-out;
            }

            .rdpms-refresh-indicator.is-error {
                background: #ef4444;
            }

        .rdpms-refresh-separator {
            color: #cbd5e1;
        }

        #nmLastUpdatedText {
            color: #334155;
        }

        #nmNextRefreshText {
            min-width: 88px;
            text-align: right;
            color: #64748b;
        }

        @@keyframes nmRefreshPulse {
            0%,
            100% {
                opacity: 0.45;
                transform: scale(0.9);
            }

            50% {
                opacity: 1;
                transform: scale(1.15);
            }
        }

        @@media (max-width: 768px) {
            .rdpms-network-refresh-bar {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>

    <!-- WS Status Bar -->
    <div id="wsStatusBar" style="display:none;"></div>

    <div class="rdpms-network-refresh-bar">
        <div class="rdpms-refresh-left">
            <span id="nmRefreshIndicator"
                  class="rdpms-refresh-indicator">
            </span>

            <span id="nmRefreshText">
                Network status loading...
            </span>
        </div>

        <div class="rdpms-refresh-right">
            <span id="nmLastUpdatedText">
                Last updated: —
            </span>

            <span class="rdpms-refresh-separator">•</span>

            <span id="nmNextRefreshText">
                Next refresh: 60s
            </span>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════
         SUMMARY STAT TABLE
    ══════════════════════════════════════════════════════════════════ -->
    <div id="mainview" class="mb-3">
        <div class="rdpms-stat-table-wrap">
            <table class="rdpms-stat-table">
                <thead>
                    <tr class="rdpms-group-row">
                        <th colspan="2" class="rdpms-group-header rdpms-gh-blue">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4" /></svg>
                            Sensors
                        </th>
                        <th colspan="1" class="rdpms-group-header rdpms-gh-green">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <rect x="2" y="3" width="20" height="14" rx="2" />
                                <path d="M8 21h8M12 17v4" />
                            </svg>
                            IoTs
                        </th>
                        <th colspan="2" class="rdpms-group-header rdpms-gh-amber">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18" /></svg>
                            Network
                        </th>
                        <th colspan="2" class="rdpms-group-header rdpms-gh-purple rdpms-no-right-border">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>
                            Stn Gateway
                        </th>
                    </tr>
                    <tr class="rdpms-sub-row">
                        <!-- Sensors -->
                        <th class="rdpms-sub-header">Total</th>
                        <th class="rdpms-sub-header rdpms-sep-solid">Faulty</th>

                        <!-- IoT -->
                        <!-- IoT: no Wired/Wireless bifurcation -->
                        <th class="rdpms-sub-header rdpms-sep-solid">Health</th>

                        <!-- Network -->
                        <th class="rdpms-sub-header">Wired</th>
                        <th class="rdpms-sub-header rdpms-sep-solid">Wireless</th>

                        <!-- Station Gateway -->
                        <th class="rdpms-sub-header">Total</th>
                        <th class="rdpms-sub-header rdpms-no-right-border">Faulty</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="rdpms-val-cell green">@(Model.mAssetInfos != null ? Model.mAssetInfos.Count() : 0)</td>
                        <td class="rdpms-val-cell red rdpms-sep-solid"><span id="spnTotalFaultySensor">0</span></td>
                        <!-- IoT: Wired -->
                        <!-- IoT: combined device health, no Wired/Wireless split -->
                        <td class="rdpms-val-cell rdpms-sep-solid">
                            <div class="rdpms-channel-card">
                                <div class="rdpms-channel-metric online">
                                    <span class="rdpms-channel-caption">
                                        <span class="rdpms-health-dot online"></span>Healthy
                                    </span>
                                    <strong id="spnIoTHealthy">—</strong>
                                </div>

                                <div class="rdpms-channel-metric faulty">
                                    <span class="rdpms-channel-caption">
                                        <span class="rdpms-health-dot offline"></span>Faulty
                                    </span>
                                    <strong id="spnIoTFaulty">—</strong>
                                </div>
                            </div>
                        </td>

                        <!-- IoT: Wireless -->
                        <!--<td class="rdpms-val-cell rdpms-sep-solid">
                            <div class="rdpms-channel-card">
                                <div class="rdpms-channel-metric online">
                                    <span class="rdpms-channel-caption">
                                        <span class="rdpms-health-dot online"></span>Online
                                    </span>
                                    <strong id="spnIoTWirelessOnline">—</strong>
                                </div>

                                <div class="rdpms-channel-metric faulty">
                                    <span class="rdpms-channel-caption">
                                        <span class="rdpms-health-dot offline"></span>Faulty
                                    </span>
                                    <strong id="spnIoTWirelessFaulty">—</strong>
                                </div>
                            </div>
                        </td>-->
                        <!-- Network: Wired -->
                        <td class="rdpms-val-cell">
                            <div class="rdpms-channel-card">
                                <div class="rdpms-channel-metric online">
                                    <span class="rdpms-channel-caption">
                                        <span class="rdpms-health-dot online"></span>Online
                                    </span>
                                    <strong id="spnNetWiredOnline">—</strong>
                                </div>

                                <div class="rdpms-channel-metric faulty">
                                    <span class="rdpms-channel-caption">
                                        <span class="rdpms-health-dot offline"></span>Faulty
                                    </span>
                                    <strong id="spnNetWiredFaulty">—</strong>
                                </div>
                            </div>
                        </td>

                        <!-- Network: Wireless -->
                        <td class="rdpms-val-cell rdpms-sep-solid">
                            <div class="rdpms-channel-card">
                                <div class="rdpms-channel-metric online">
                                    <span class="rdpms-channel-caption">
                                        <span class="rdpms-health-dot online"></span>Online
                                    </span>
                                    <strong id="spnNetWirelessOnline">—</strong>
                                </div>

                                <div class="rdpms-channel-metric faulty">
                                    <span class="rdpms-channel-caption">
                                        <span class="rdpms-health-dot offline"></span>Faulty
                                    </span>
                                    <strong id="spnNetWirelessFaulty">—</strong>
                                </div>
                            </div>
                        </td>

                        <!-- Station Gateway -->
                        <td class="rdpms-val-cell green">
                            @(Model.GatewaySiteId != null ? Model.GatewaySiteId.Count() : 0)
                        </td>

                        <td class="rdpms-val-cell red rdpms-no-right-border">
                            <span id="spnTotalFaultyGatewaySite">0</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════
         TABLE VIEW
    ══════════════════════════════════════════════════════════════════ -->
    <div id="listView" class="rdpms-list-card">
        <div class="table-responsive">
            <table class="table rdpms-table" id="tblRDPMSHealthLive">
                <thead>
                    <tr>
                        <th>Sr.No</th>
                        <th>Zone</th>
                        <th>Division</th>
                        <th>Station</th>
                        <th>Asset Type</th>
                        <th>Asset Number</th>
                        <th class="text-center">Faulty Sensor description</th>
                        <th class="text-center">Faulty IoT description</th>
                        <th class="text-center">Faulty Network description</th>
                        <th class="text-center">Faulty Station gateway</th>
                    </tr>
                </thead>
                <tbody id="tbodyRDPMSHealthLive">
                    @if (Model != null && Model.mAssets != null && Model.mAssets.Count > 0)
                    {
                        // UI FIX: some upstream feeds return placeholder/attribute rows
                        // interleaved with real asset rows (empty Zone / Division / SiteName).
                        // Filter them out so the table shows one clean row per asset.
                        var visibleAssets = Model.mAssets
                            .Where(a => a != null
                                        && a.AssetId > 0
                                        && !string.IsNullOrWhiteSpace(a.SiteName)
                                        && !string.IsNullOrWhiteSpace(a.Name))
                            .ToList();

                        int counter = 0;
                        foreach (var item in visibleAssets)
                        {
                            counter++;
                            <tr data-modemid="@(item.ModemIdStr)"
                                data-a10id="@(item.A10IdStr)"
                                data-siteid="@item.SiteId"
                                data-assetid="@item.AssetId"
                                style="display:none;">
                                <td>@counter</td>
                                <td>@item.Zone</td>
                                <td>@item.Division</td>
                                <td>@item.SiteName</td>
                                <td>@item.AssetTypeName</td>
                                <td>@item.Name</td>
                                <td class="text-center"><span id="spnSensor@(item.AssetId)"></span></td>
                                <td class="text-center"><span id="spnA10@(item.A10IdStr)"></span></td>
                                <td class="text-center"><span id="spnModem@(item.ModemIdStr)"></span></td>
                                <td class="text-center"><span id="spnGW@(item.SiteId)"></span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="rdpms-pager-wrap">
            <nav>
                <ul class="pagination justify-content-end mb-0" id="pager">
                    <li class="page-item" data-page="prev"><a class="page-link" href="#">Previous</a></li>
                    <li class="page-item" data-page="next"><a class="page-link" href="#">Next</a></li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════
         PICTORIAL VIEW
         ONE CARD PER MODEM (cluster).
         Card layout:
           Header  : SiteName — Modem {ModemId}  +  status dot
           Row 1   : IoT    : Healthy/Faulty  timestamp
           Row 2   : Network: Healthy/Faulty  timestamp
           Section : Sensor fault list
                     Each item → "AssetName - SensorAttributeName : Faulty  timestamp"
    ══════════════════════════════════════════════════════════════════ -->
    <div id="pictorialView" style="display:none;">

        <!-- Tab bar -->
        <div class="pic-tab-bar">
            <button type="button"
                    class="pic-tab-btn active"
                    id="tabIndoor"
                    onclick="fnSwitchPicTab('indoor'); return false;">
                Indoor RDPMS
            </button>

            <button type="button"
                    class="pic-tab-btn"
                    id="tabOutdoor"
                    onclick="fnSwitchPicTab('outdoor'); return false;">
                Outdoor RDPMS
            </button>
        </div>

