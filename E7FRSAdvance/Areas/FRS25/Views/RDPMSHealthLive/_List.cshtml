    var hasUsableAssetTypeMetadata = false;

    if (json && $.isArray(json.mAssets)) {
        $.each(json.mAssets, function (_, asset) {
            if (!asset) {
                return;
            }

            var assetTypeId =
                asset.AssetTypeId != null
                    ? String(asset.AssetTypeId).trim()
                    : '';

            var assetId =
                asset.AssetId != null
                    ? String(asset.AssetId).trim()
                    : (
                        asset.Id != null
                            ? String(asset.Id).trim()
                            : ''
                    );

            if (!assetTypeId || !assetId) {
                return;
            }

            hasUsableAssetTypeMetadata = true;

            if (
                selectedAssetTypeIds.indexOf(assetTypeId) !== -1
            ) {
                assetIds[assetId] = true;
            }
        });
    }

    /*
     * Secondary source in case mAssets does not contain AssetTypeId,
     * but mAssetInfos does.
