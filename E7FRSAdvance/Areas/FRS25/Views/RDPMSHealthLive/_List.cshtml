                if (sel && ai.AssetTypeId != null &&
                    sel.indexOf(String(ai.AssetTypeId).trim()) === -1) { continue; }
                if (ai.SiteId != null && !_siteOk(String(ai.SiteId))) { continue; }

                var _sid = String(ai.SiteId != null ? ai.SiteId : '');
                var _aid = String(ai.AssetId != null ? ai.AssetId : '');

                /* Point machines are counted once per asset through the same
                   collapsed list the drawer shows, so a half machine's B end
                   and a full machine's A/B pairs cannot make the tile read
                   higher than the chips. */
                if (window.rdpmsIsPointMachine && window.rdpmsIsPointMachine(_aid)) {
                    var _pmk = _sid + '|' + _aid;
                    if (_pmSeen[_pmk]) { continue; }
                    _pmSeen[_pmk] = true;
                    total += rdpmsAssetAttributes(_sid, _aid).length;
