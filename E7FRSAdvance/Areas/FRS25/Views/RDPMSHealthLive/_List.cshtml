            }
            return { state: 'masked', time: '' };   /* other leg is unknown */
        }

        return { state: 'healthy', time: '' };
    }

    /* clusterId -> true when BOTH wired and wireless are fully down.
       Built from the Modem rows in the raw channel store. A medium counts
