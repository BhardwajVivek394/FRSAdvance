<style>
    /* ── stat table ── */
    #mainview {
        gap: 16px
    }

    .rdpms-stat-table-wrap {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        overflow: hidden
    }

    .rdpms-stat-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
        table-layout: fixed
    }

    .rdpms-group-row th, .rdpms-sub-row th {
        background: #f8fafc
    }

    .rdpms-group-header {
        padding: 9px 10px;
        text-align: center;
        font-weight: 600;
        font-size: 11.5px;
        letter-spacing: .3px;
        border-right: 1px solid #e2e8f0;
        border-bottom: 2px solid currentColor
    }

    .rdpms-gh-blue {
        color: #378ADD
    }

    .rdpms-gh-green {
        color: #1D9E75
    }

    .rdpms-gh-amber {
        color: #BA7517
    }

    .rdpms-gh-purple {
        color: #534AB7
    }

    .rdpms-group-header svg {
        vertical-align: middle;
        margin-right: 4px
    }

    .rdpms-sub-header {
        padding: 6px 10px;
        text-align: center;
        font-weight: 500;
        font-size: 11px;
        color: #475569;
        border-bottom: 1px solid #e2e8f0;
        border-right: 1px dashed #e2e8f0
    }

    .rdpms-val-cell {
        padding: 13px 10px;
        text-align: center;
        font-size: 20px;
        font-weight: 600;
        border-right: 1px dashed #e2e8f0
    }

        .rdpms-val-cell.green {
            color: #16a34a
        }

        .rdpms-val-cell.red {
            color: #dc2626
        }

    .rdpms-sep-solid {
        border-right: 1px solid #e2e8f0 !important
    }

    .rdpms-no-right-border {
        border-right: none !important
    }

    /* ── table view ── */
    .rdpms-list-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 8px 0 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        overflow: hidden
    }

    .rdpms-table {
        margin-bottom: 0;
        font-size: 13.5px;
        color: #1e293b;
        width: 100%;
        border-collapse: separate;
        border-spacing: 0
    }

        /* Force header visibility — some parent themes hide .table thead by default. */
        .rdpms-table thead {
            display: table-header-group !important;
            visibility: visible !important
        }

        .rdpms-table thead tr {
            background: #f8fafc;
            border-bottom: 2px solid #e2e8f0
        }

        .rdpms-table thead th {
            font-weight: 700;
            font-size: 12.5px;
            letter-spacing: .3px;
            text-transform: uppercase;
            color: #475569;
            background: #f8fafc;
            border: none;
            border-bottom: 2px solid #e2e8f0;
            padding: 12px 14px;
            white-space: nowrap;
            text-align: left
        }

            .rdpms-table thead th.text-center {
                text-align: center
            }

        /* Zebra striping so alternating rows are visually distinct. */
        .rdpms-table tbody tr {
            border-bottom: 1px solid #f1f5f9;
            transition: background .15s
        }

            .rdpms-table tbody tr:nth-of-type(odd) {
                background: #ffffff
            }

            .rdpms-table tbody tr:nth-of-type(even) {
                background: #fafbfc
            }

            .rdpms-table tbody tr:hover {
                background: #eef4fb !important
            }

        .rdpms-table tbody td {
            padding: 11px 14px;
            border: none;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            font-size: 13px;
            color: #1e293b
        }

        /* Empty-cell fallback: keeps column alignment when a value is missing. */
        .rdpms-table tbody td:empty::after {
            content: "—";
            color: #cbd5e1
        }

        /* Continuation rows for additional faulty sensors on the same asset —
           dim the leading columns so they don't visually repeat, but keep the
           row height so it aligns with the parent. */
        .rdpms-table tbody tr.sensor-clone-row td:not(:nth-child(7)) {
            color: transparent
        }

        .rdpms-table tbody tr.sensor-clone-row {
            background: #fafbfc !important
        }

    .rdpms-pager-wrap {
        padding: 12px 16px 4px
    }

        .rdpms-pager-wrap .page-link {
            border-radius: 6px !important;
            margin: 0 2px;
            font-size: 13px;
            color: #475569;
            border-color: #e2e8f0
        }

        .rdpms-pager-wrap .page-item.active .page-link {
            background-color: #6366f1;
            border-color: #6366f1;
            color: #fff
        }

        .rdpms-pager-wrap .page-item.disabled .page-link {
            color: #cbd5e1
        }

    .badge-danger {
        background-color: #fee2e2;
        color: #dc2626;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 5px;
        font-size: 12px
    }

