            if (!store.hasOwnProperty(k)) { continue; }
            var r = store[k];
            if (!r || r.deviceType !== 'A10' || r.deviceId == null) { continue; }
            if (!RDPMS_A10_CHANNELS[String(r.channel || '').toUpperCase()]) { continue; }

            var rsid = (r.siteId != null) ? String(r.siteId) : '';
            if (!rsid && !window.__rdpmsA10NoSiteWarned) {
