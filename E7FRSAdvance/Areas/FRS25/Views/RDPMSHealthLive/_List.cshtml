                .attr('title', 'Filtered by the selected asset type(s)');
        }
       /*
 * Under an Asset-Type filter the station-wide sensorHealthSummary MUST NOT
 * own Faulty. `faulty` above is already restricted to allowed.assets, so it
 * is the correct value for the currently selected Asset Type(s).
 */
$('#spnTotalFaultySensor')
    .removeData('nm-text')
    .text(faulty);

console.log(
    '[RDPMS tile] Sensor (filtered) Total=' + total +
    ' Faulty=' + faulty,
    {
