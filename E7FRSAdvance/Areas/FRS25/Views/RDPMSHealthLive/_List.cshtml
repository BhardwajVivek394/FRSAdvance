                    {
                        var clusterAssets = Model.mAssets.Where(a => a.SiteId == cluster.SiteId && a.ModemIdStr != null && a.ModemIdStr.Contains(cluster.ModemId)).ToList();


                        var assetIdList = string.Join(",", clusterAssets.Select(a => a.AssetId.ToString()));
                        var a10IdList = string.Join(",", Model.mCardLines.Where(x => x.ClusterId == cluster.Id).GroupBy(x => x.ADCNumber).Select(x => x.Key).ToList());


