        Object.keys(_sensorSummaryBySite).forEach(function (sid) {
            if (sel.restrict && sel.ids.indexOf(String(sid)) === -1) { return; }
            var sm = _sensorSummaryBySite[sid];
            if (!sm) { return; }
            gotSensor = true;
            senTotal += sm.sensorTotal;
            senFaulty += sm.sensorDown;
        });

       if (gotSensor) {
