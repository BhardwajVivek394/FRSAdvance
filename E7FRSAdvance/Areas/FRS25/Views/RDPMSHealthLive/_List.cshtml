        cardLineRows: cardLines.length,
        universeRows: universe.length
    }
);
    }

    /* Station Gateway is a per-station verdict: Faulty when any Gateway device
       for the site is down. Store per-site, paint this site's row GW cell(s),
            and re-sum the combined header faulty count. Mirrors the network path. */
    window.applyGatewayHealthModel = function (siteId, gwModel, updateTime) {
        var sid = String(siteId != null ? siteId : '').trim();
        if (!sid) { return; }
        window.__rdpmsGwWsAt = Date.now();   /* WS now owns GW (poll guard) */

        /* GW is declared with treatPartialAsFaulty:false in the socket module,
   so its rollup status is already three-state: Faulty = every gateway
   down, Partial = some down. Use that split directly.
     cellFaulty -> grid cell (both down only)
     faulty     -> header contribution (any down) */
        var _gwDown = [];
        if (gwModel && $.isArray(gwModel.downBits)) {
            for (var _gb = 0; _gb < gwModel.downBits.length; _gb++) {
                /* Bit 0 = Station gateway; higher bits = External gateway, now
                   intentionally ignored so only the main gateway is reported. */
                if (gwModel.downBits[_gb] === 0) { _gwDown.push('Station'); }
            }
        } else if (gwModel && typeof gwModel.faulty === 'number') {
            /* Station gateway only: at most one down family, External excluded. */
            if ((gwModel.faulty + (parseInt(gwModel.partial, 10) || 0)) > 0) {
                _gwDown.push('Station');
            }
        }
        var cellFaulty = !!(gwModel && gwModel.status === 'Faulty');
        var faulty = cellFaulty || _gwDown.length > 0;

        if (window.rdpmsIsForcedSite && window.rdpmsIsForcedSite(sid)) {
            faulty = false;
            cellFaulty = false;
            _gwDown = [];
        }

        /* `updateTime` (model.updateTime from buildModelFromRows) is the
           site's latest update across EVERY device - IoT, Network AND
           Gateway - so it moves on every unrelated frame and reads like a
           live clock rather than "when did the gateway actually go down".
           The real fault time lives on the gateway device row itself
           (setTime, stamped once when that row's type:"Set" fires); pull it
