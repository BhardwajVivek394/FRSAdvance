    function rdpmsCountSensorsFromInventory(assetTypeIds, siteFilter) {
        var _siteOk = (siteFilter && siteFilter.restrict)
            ? function (s) { return siteFilter.ids.indexOf(String(s)) !== -1; }
            : function () { return true; };
        var sel = assetTypeIds;   /* null = all types */

        var vinfos = (window.json && $.isArray(window.json.mAssetInfos))
            ? window.json.mAssetInfos : [];
        var cardLines = (window.json && $.isArray(window.json.mCardLines))
            ? window.json.mCardLines : [];

        var total = 0, _vibSeen = {}, _pmSeen = {};

        function _nm(ai) {
            return $.trim(ai.AttributeAliasName || '') ||
                $.trim(ai.AliasName || '') ||
                $.trim(ai.AttributeName || '') ||
                $.trim(ai.AssetAttributeName || '');
        }

        if (vinfos.length) {
            var _attrSeen = {};
            for (var ii = 0; ii < vinfos.length; ii++) {
                var ai = vinfos[ii];
                if (!ai) { continue; }
                if (sel && ai.AssetTypeId != null &&
                    sel.indexOf(String(ai.AssetTypeId).trim()) === -1) { continue; }
                if (ai.SiteId != null && !_siteOk(ai.SiteId)) { continue; }

                var _sid = String(ai.SiteId != null ? ai.SiteId : '');
                var _aid = String(ai.AssetId != null ? ai.AssetId : '');

                if (window.rdpmsIsPointMachine && window.rdpmsIsPointMachine(_aid)) {
                    var _pmk = _sid + '|' + _aid;
                    if (_pmSeen[_pmk]) { continue; }
                    _pmSeen[_pmk] = true;
                    total += rdpmsAssetAttributes(_sid, _aid).length;
