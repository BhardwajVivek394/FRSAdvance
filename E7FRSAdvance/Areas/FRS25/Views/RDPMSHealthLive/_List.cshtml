                    ? window.rdpmsVibrationGroup(_nm) : '';

                if (_vg) {
                    var _vk = _sid + '|' + _aid + '|' + _vg;
                    if (_vibGroupSeen[_vk]) { continue; }
                    _vibGroupSeen[_vk] = true;
                    total++;
                    continue;
                }

                /* This site returns AttributeId null on every AssetInfo row, so
                   fall through to AssetAttributeId, then to the normalised name.
                   Names carry trailing spaces ('B VPT NWKR '), which would key
                   the same attribute twice if used raw. */
                var _gid = ai.AttributeId != null ? String(ai.AttributeId).trim() : '';
                var _lid = ai.AssetAttributeId != null ? String(ai.AssetAttributeId).trim() : '';
                var _ak = _sid + '|' + _aid + '|' +
