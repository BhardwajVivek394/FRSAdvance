    /* Point machine attribute presentation.

       This replaces the short "DO NOT rename A + B => A/B" version that was
       live here. That version had no phantom drop and no pairing, which is why
       PT-119/120 read 16 in Sensor (mAssetInfos) and 14 in IoT (CardLine): the
       two extra were B VPT NWKR / B VPT RWKR, configured on the asset but with
       no CardLine row, so they are not wired sensors.

       Three decisions, deliberately keyed on different things:

       1. IS IT REAL?   No CardLine pin => not a wired sensor => dropped.
       2. COUNTERPART?  Decided on the LABEL with the end prefix removed, so
                        "A VPT NWKR" looks for a "B VPT NWKR".
       3. MERGE?        Decided on the CardLine Role, never on the label.

         only one end configured     -> one chip, "A/B <label>"
         both ends, same Role        -> one chip, "A/B <label>"
         both ends, different Roles  -> two chips, "A <label>" / "B <label>"
         IsHalfPointMachine == true  -> B end dropped, survivor reads "A/B ..."
         vibration                   -> always per end, never merged, never
                                        dropped (it has no CardLine row by
                                        design)                              */
    window.rdpmsCollapsePmAttributes = function (assetId, list, siteId) {
        list = $.isArray(list) ? list : [];
        if (!window.rdpmsIsPointMachine(assetId)) { return list; }

        var roles = rdpmsPmRoleMap(siteId, assetId);

        /* No CardLine for this asset yet - do not guess, and above all do not
           drop everything. Return untouched until the fetch lands. */
        if (!roles.found) {
            if (typeof nfFetchCardLineRows === 'function' && siteId) {
                try { nfFetchCardLineRows(siteId); } catch (e) { }
            }
            return list;
        }

        /* The end configuration must be KNOWN, not assumed. Treating an
           unfetched flag as "full machine" is why a half point machine
           rendered its B end before the POST landed and dropped it after -
           the same asset, two different chip lists, decided purely by click
           timing. Bail out consistently and kick the fetch instead. */
        if (!window.rdpmsHalfPmKnown(assetId)) {
            if (typeof window.rdpmsFetchPointMachineFlags === 'function') {
                try { window.rdpmsFetchPointMachineFlags(); } catch (e) { }
            }
            if (window.console && console.warn) {
                console.warn('[RDPMS] IsHalfPointMachine not loaded for asset ' +
                    assetId + ' - point machine attributes left uncollapsed');
            }
            return list;
        }

        var isHalfPm = (window.rdpmsIsHalfPointMachine(assetId) === true);

        /* PASS 1 - resolve every attribute's CardLine Role. */
        var meta = [], resolved = 0;

        for (var i = 0; i < list.length; i++) {
            var a = list[i] || {};
            var isVib = !!a.vibGroup ||
                !!(window.rdpmsVibrationGroup &&
                    window.rdpmsVibrationGroup(a.name || ''));

            var role = '';
            if (!isVib) {
                /* mAssetInfos returns AttributeId null on every row at this
                   site, so linkId (AssetAttributeId) is the only usable id -
                   and it holds CardLine's AttributeId value. Verified on
                   asset 41903: linkIds 25,26,212..219,576..579 all hit
                   roles.byId; 27 and 28 (B VPT NWKR / RWKR) do not. */
                if (a.attributeId && roles.byId[String(a.attributeId)]) {
                    role = roles.byId[String(a.attributeId)];
                } else if (a.linkId && roles.byId[String(a.linkId)]) {
                    role = roles.byId[String(a.linkId)];
                } else {
                    var nk = $.trim(a.name || '').replace(/\s+/g, ' ').toLowerCase();
                    if (roles.byName[nk]) { role = roles.byName[nk]; }
                }
                if (role) { resolved++; }
            }

            meta.push({
                item: a, isVib: isVib, role: role, split: rdpmsAttrSplit(a)
            });
        }

        /* Dropping as "no CardLine pin" is only safe when both sides speak the
    same vocabulary. When NOTHING resolved the lookup is unavailable, so
    keep the list whole rather than emptying the i-button. */
        var canDrop = (resolved > 0);
        if (!canDrop && window.console && console.warn) {
            console.warn('[RDPMS] no CardLine Role resolved for asset ' +
                assetId + ' - point machine attributes left uncollapsed');
        }

        /* PASS 2 - group by label so each end can find its counterpart. */
        var groups = {}, order = [];

        for (var m0 = 0; m0 < meta.length; m0++) {
            var e = meta[m0];

            if (e.isVib) {
                var _vgn = e.item.vibGroup ||
                    (window.rdpmsVibrationGroup
                        ? window.rdpmsVibrationGroup(e.item.name || '') : '');
                if (isHalfPm && /\bB\s*End\b/i.test(String(_vgn))) { continue; }

                groups['x|' + m0] = {
                    items: [{ item: e.item, end: '', role: '' }], plain: true
                };
                order.push('x|' + m0);
                continue;
            }

            /* Half machine has no B end at all. */
            if (isHalfPm && e.split.end === 'B') { continue; }

            /* Decision 1: no CardLine pin, not a real sensor. */
            if (!e.role && canDrop) { continue; }

            /* Decision 2: group by label. */
            var k = e.split.end ? ('lbl|' + e.split.roleKey) : ('x|' + m0);
            if (!groups[k]) {
                groups[k] = {
                    items: [], ends: {}, split: e.split, plain: !e.split.end
                };
                order.push(k);
            }
            groups[k].items.push({ item: e.item, end: e.split.end, role: e.role });
            if (e.split.end) { groups[k].ends[e.split.end] = true; }
        }

        function passThrough(g, out) {
            for (var p = 0; p < g.items.length; p++) { out.push(g.items[p].item); }
        }

        function mergeGroup(g) {
            var merged = $.extend({}, g.items[0].item);
            merged.name = 'A/B ' + g.split.label;
            merged.pairedNames = [];
            merged.pairedIds = [];

            var links = [], anyFaulty = false, hasStatus = false;
            for (var m = 0; m < g.items.length; m++) {
                var it = g.items[m].item;
                if (it.name) { merged.pairedNames.push(it.name); }
                if (it.attributeId) { merged.pairedIds.push(String(it.attributeId)); }
                if (it.linkId) { merged.pairedIds.push(String(it.linkId)); }
                if (it.link && links.indexOf(String(it.link)) === -1) {
                    links.push(String(it.link));
                }
                if (it.status != null) {
                    hasStatus = true;
                    if (String(it.status).toLowerCase() === 'faulty') { anyFaulty = true; }
                }
            }
            /* A merged chip covers both ends, so the worst state wins. */
            if (hasStatus) { merged.status = anyFaulty ? 'faulty' : 'healthy'; }
            if (links.length) { merged.link = links.join(', '); }
            return merged;
        }

        var out = [];
        for (var o = 0; o < order.length; o++) {
            var g = groups[order[o]];
            if (!g || !g.items.length) { continue; }

            if (g.plain) { passThrough(g, out); continue; }

            /* A HALF machine has an A end and nothing else. "A/B" would claim a
   B end that does not exist, so no merge and no relabel here - the
   attribute is shown exactly as configured. The A/B rule belongs
   to IsHalfPointMachine === false only.

   This is why half machines were showing "A/B ..." : PASS 2 above
   deletes their B end, the group is then single-ended, and the
   !bothEnds branch below relabelled it - reading its own deletion
   as evidence that one end stands for both. */
            if (isHalfPm) { passThrough(g, out); continue; }

            /* Counterpart and Role both come from CardLine (map.byEnd), NOT
               from g.ends / g.items - those describe only the slice of the
               asset this particular drawer can see. */
            var _cfg = roles.byEnd ? roles.byEnd[g.split.roleKey] : null;

            var bothEnds = _cfg
                ? !!(_cfg.A && _cfg.B)
                : !!(g.ends.A && g.ends.B);   /* fallback: byEnd unavailable */

            /* Only one end configured on the ASSET - it stands for both, so
               "A/B <label>". Two attributes on the SAME end sharing a label are
               two sensors and must not be folded together. */
            if (!bothEnds) {
                if (g.items.length === 1) { out.push(mergeGroup(g)); }
                else { passThrough(g, out); }
                continue;
            }

            /* Decision 3: merge only when the configuration agrees they are one
               sensor. Compare the two CardLine Roles directly when we have
               them, so the verdict is identical in all three drawers even when
               one of them can only see a single end. An UNRESOLVED role is not
               a matching role - without that guard two empty strings compare
               equal and merge ends we have no evidence to merge. */
            var sameRole;
            if (_cfg) {
                sameRole = !!_cfg.A && (_cfg.A === _cfg.B);
            } else {
                sameRole = !!g.items[0].role;
                for (var r = 1; sameRole && r < g.items.length; r++) {
                    if (g.items[r].role !== g.items[0].role) { sameRole = false; }
                }
            }

            /* Both ends exist on the asset but only one reached this drawer.
               Merging would print "A/B" over a chip that carries one end's
               status only, so pass it through under its own name instead. */
            if (sameRole && !(g.ends.A && g.ends.B)) {
                passThrough(g, out);
                continue;
            }

            if (sameRole) { out.push(mergeGroup(g)); }
            else { passThrough(g, out); }
        }
        return out;
    };

    /* Vibration is published through mAssetInfos, not CardLine - the CardLine
       feed for this station carries no vibration channel at all. The IoT and
       Network drawers are built from CardLine rows, which is why vibration
       never appeared in them. Append the asset's vibration groups so it does.
       One entry per end, matching how the sensor tile counts them. */
    window.rdpmsAppendAssetVibration = function (siteId, assetId, list, state) {
        list = list || [];
        if (!window.rdpmsVibrationGroup) { return list; }

        var seen = {};
        for (var s = 0; s < list.length; s++) {
            var ex = $.trim((list[s] || {}).name || '').toLowerCase();
            if (ex) { seen[ex] = true; }
        }

        var infos = (window.json && $.isArray(window.json.mAssetInfos))
            ? window.json.mAssetInfos : [];

        for (var i = 0; i < infos.length; i++) {
            var ai = infos[i];
            if (!ai) { continue; }
            if (String(ai.AssetId) !== String(assetId)) { continue; }
            if (siteId && ai.SiteId != null &&
                String(ai.SiteId) !== String(siteId)) { continue; }

            var nm = $.trim(ai.AttributeAliasName || '') ||
                $.trim(ai.AliasName || '') ||
                $.trim(ai.AttributeName || '') ||
                $.trim(ai.AssetAttributeName || '');

            var vg = window.rdpmsVibrationGroup(nm);
            if (!vg) { continue; }

            /* mAssetInfos can carry a stray "Vibration_..." attribute row for
               an end that has no vibration sensor actually wired - PT-101/102
               is a FULL point machine (IsHalfPointMachine === false) with
               BOTH Asset.VibrationA and Asset.VibrationB null, yet the drawer
               still showed both "Vibration A End" and "Vibration B End".
               IsHalfPointMachine only says whether the A/B end mechanically
               exists, not whether that end has a vibration sensor - so the
               chip must be gated on the asset's own VibrationA/VibrationB
               config (Asset/GetByAssetIds), never inferred from the
               half-machine flag. Do not guess while that fetch is still
               pending either, or the chip flashes on before the POST lands. */
            var vgEnd = String(vg).match(/^Vibration\s+([AB])\s+End$/i);
            if (vgEnd && window.rdpmsIsPointMachine(assetId)) {
                var vgConfigured = window.rdpmsVibrationEndConfigured(assetId, vgEnd[1]);

                if (vgConfigured === undefined) {
                    if (typeof window.rdpmsFetchPointMachineFlags === 'function') {
                        try { window.rdpmsFetchPointMachineFlags(); } catch (e) { }
                    }
                    continue;
                }

                if (!vgConfigured) {
                    continue;
                }
            }

            var k = vg.toLowerCase();
            if (seen[k]) { continue; }
            seen[k] = true;

            list.push({
                name: vg,
                link: '',
                status: (state === 'masked') ? 'masked'
                    : ((state === 'faulty') ? 'faulty' : 'healthy')
            });
        }
        return list;
    };

    /* Fetch IsHalfPointMachine for every point machine in the current result
       set. One POST for all of them; the flag is asset configuration, so it is
       cached for the life of the page. */
    window.rdpmsFetchPointMachineFlags = function () {
        var assets = (window.json && $.isArray(window.json.mAssets))
            ? window.json.mAssets : [];
        var ids = [], seen = {};

        for (var i = 0; i < assets.length; i++) {
            var a = assets[i];
            if (!a) { continue; }
            var isPm = (a.AssetTypeId != null)
                ? (String(a.AssetTypeId).trim() === RDPMS_PM_ASSET_TYPE_ID)
                : /point\s*machine/i.test(String(a.AssetTypeName || ''));
            if (!isPm) { continue; }

            var aid = parseInt((a.AssetId != null) ? a.AssetId : a.Id, 10);
            if (!(aid > 0)) { continue; }
            if (seen[aid]) { continue; }
            seen[aid] = true;
            /* Already known from an earlier search - do not ask again. */
            if (window.__rdpmsHalfPmByAsset[String(aid)] !== undefined) { continue; }
            ids.push(aid);
        }

        if (!ids.length) { return $.Deferred().resolve().promise(); }

        /* A point machine's flag stays "unknown" for the whole window between
           firing this POST and its response landing. rdpmsCollapsePmAttributes
           calls back in here for every row/attribute that repaints while a
           flag is still unresolved - the 1-second freshness tick, every
           WebSocket frame, every aggregateAndUpdateUI pass - so without a
           guard each of those repaints fired its own identical POST with the
           same assetIds. Reuse the pending request instead of stacking
           duplicates; the cache is cleared once it settles so a later batch
           (new assets from the next search) gets a fresh request. */
        if (window.__rdpmsPmFlagsRequest) {
            return window.__rdpmsPmFlagsRequest;
        }

        var req = $.ajax({
            url: '/FRS25/RDPMSHealthLive/GetAssetsByIds',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ assetIds: ids }),
            dataType: 'json'
        }).then(function (rows) {
            rows = $.isArray(rows) ? rows : [];
            for (var r = 0; r < rows.length; r++) {
                var row = rows[r];
                if (!row) { continue; }
                var rid = (row.Id != null) ? row.Id : row.AssetId;
                if (rid == null) { continue; }
                window.__rdpmsHalfPmByAsset[String(rid)] = !!row.IsHalfPointMachine;
                window.__rdpmsVibrationEndsByAsset[String(rid)] = {
                    a: row.VibrationA != null,
                    b: row.VibrationB != null
                };
            }

            /* The drawer now rebuilds at click time, but the CELL counts were
   computed before the flags landed - a half machine's cell still
   counts its B end until something repaints it. */
            if (typeof nfBindFilteredSensorCounts === 'function') {
                try { nfBindFilteredSensorCounts(); } catch (e) { }
            }
            if (typeof aggregateAndUpdateUI === 'function') {
                try { aggregateAndUpdateUI(); } catch (e) { }
            }
        }, function () {
            /* Leave the map untouched: an absent flag means "do not collapse",
               which is the pre-change behaviour. */
            if (window.console && console.warn) {
                console.warn('[RDPMS] GetAssetsByIds failed - point machine ' +
                    'ends left uncollapsed');
            }
            return $.Deferred().resolve().promise();
        }).always(function () {
            window.__rdpmsPmFlagsRequest = null;
        });

        window.__rdpmsPmFlagsRequest = req;
        return req;
    };
    /* ══════════════════════════════════════════════════════════════════
       NETWORK & IoT LIVE STATUS
       Network  = Modem   (DataSource=Modem) — TypeId 2=Wireless, 3=Wired
       IoT      = A10     (DataSource=A10)   — TypeId 2=Wireless, 1=Wired
       Reads siteIds from the loaded rows' data-siteid attributes.
