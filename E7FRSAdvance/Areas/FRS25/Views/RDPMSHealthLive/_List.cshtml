        _currentView = val;

        window.__rdpmsCurrentView = val;

        if (val === 'Pictorial') {
            $('#listView').hide();
            $('#pictorialView').show();

            fnSwitchPicTab(
                window.__rdpmsCurrentPicTab ||
                _currentPicTab ||
                'indoor'
            );

            /* Paint the cards from the current state right away. fnUpdatePictorial
               is what reveals cluster cards (display:none by default) and builds
               their sensor-description lists; without this the tab shows empty
               until the next deviceHealth frame happens to fire the aggregate. */
            if (typeof aggregateAndUpdateUI === 'function') {
                try { aggregateAndUpdateUI(); } catch (e) {
                    if (window.console) { console.warn('[RDPMS view switch]', e); }
                }
            }
        }
        else {
            $('#pictorialView').hide();
            $('#listView').show();

            /* Repaint the table on return so the Sensor/IoT/Network/Gateway
               cells reflect the latest state immediately, rather than relying
               on the next async callback to happen to fire. Idempotent:
               fnUpdateTableData rewrites the same cells and the pictorial is
               signature-guarded. */
            if (typeof aggregateAndUpdateUI === 'function') {
                try { aggregateAndUpdateUI(); } catch (e) {
                    if (window.console) { console.warn('[RDPMS view switch]', e); }
                }
            }
        }
    };

    function fnSwitchPicTab(tab) {
        tab = tab === 'outdoor'
            ? 'outdoor'
            : 'indoor';

        _currentPicTab = tab;
        window.__rdpmsCurrentPicTab = tab;

        if (tab === 'indoor') {
            $('#picIndoorPanel').show();
            $('#picOutdoorPanel').hide();

            $('#tabIndoor').addClass('active');
            $('#tabOutdoor').removeClass('active');
        }
        else {
            $('#picIndoorPanel').hide();
            $('#picOutdoorPanel').show();

            $('#tabIndoor').removeClass('active');
            $('#tabOutdoor').addClass('active');
        }
    }

    /* ── Live data state ─────────────────────────────────────────────────
     * WebSocket-based alert delivery was removed — repeated Snapshot
     * pushes were driving continuous re-renders on the Pictorial view
     * even after the per-card signature guard was in place.
     *
     * All live data now comes from REST polls, each on its own timer:
     *   Sensors  →  GetSensorHealthLive   (shFetch, 60 s)
     *   IoT      →  GetA10Live            (nmFetch → nmApply, 60 s)
     *   Network  →  GetModemLive          (nmFetch → nmApply, 60 s)
     *
     * wsSiteFaults is kept as the shared bucket that shFetch writes
     * faultySensorLive into and aggregateAndUpdateUI reads from.
     * wsAlertTimes stays as an empty object so the legacy alert-time
     * lookups in fnUpdatePictorial / fnUpdateTableData continue to
     * resolve to the harmless `|| now` fallback branch. Names preserved
     * so no downstream reader needs to change.
     * ──────────────────────────────────────────────────────────────── */
    var wsSiteFaults = {};
    var wsAlertTimes = {};

    /* ── Fault-onset registry ────────────────────────────────────────────
     * Fixes: IoT "Set Time auto-increments by 1 min chasing current time".
     *
     * A failed A10/Modem often keeps emitting a heartbeat whose DeviceTime
     * crawls forward every poll (tracking the wall clock) even though the
     * device is down. The old code displayed latestFaultyDeviceTime, so the
     * shown Set Time advanced ~1 min on every refresh.
     *
     * Here we PIN the fault time at the moment a device is FIRST seen faulty
     * and keep returning that frozen value for as long as it stays faulty.
     * The onset is cleared the instant the device recovers, so the next
     * failure re-pins correctly.
     *
     * Stored on window so the frozen time survives an AJAX reload of the
     * _List partial (a Search must not reset every device's fault clock).
     * Key: sourceType|siteId|deviceId
     * ──────────────────────────────────────────────────────────────────── */
    var _rdpmsFaultOnset =
        window.__rdpmsFaultOnset ||
        (window.__rdpmsFaultOnset = {});

    /* ── Shared freshness window (fixes IoT/Network flapping — issue 12) ──
     * A device counts as live only while its last DeviceTime is within this
     * window; beyond it → Faulty. It MUST be comfortably LARGER than the
     * A10/Modem heartbeat interval, otherwise a device whose heartbeat lands
     * near the edge oscillates Healthy⇄Faulty between polls ("sometimes
     * faulty, fixes on refresh"). Field heartbeat is ~1 min, so 3 min
     * tolerates ~2 missed beats and stops the flap while keeping detection
     * reasonably quick. Both the table (IIFE) and the outdoor pictorial read
     * this single value so they can never drift apart.
     * Tune this to ≈ 2–3× your real heartbeat interval.
     * ──────────────────────────────────────────────────────────────────── */
    var RDPMS_ONLINE_MS = 3 * 60 * 1000;

    function rdpmsFaultTime(sourceType, siteId, deviceId, isFaulty, deviceTime) {
        var key = sourceType + '|' +
                  String(siteId).trim() + '|' +
                  String(deviceId).trim();

        if (!isFaulty) {
            /* Recovered — drop the pin so a future failure re-pins fresh. */
            delete _rdpmsFaultOnset[key];
            return null;
        }

        var rec = _rdpmsFaultOnset[key];
        if (!rec) {
            /* First poll on which this device is faulty. Pin the onset to the
               device's own last real DeviceTime when we have one; fall back to
               the wall clock only when the API gave us nothing usable. */
            var dt = deviceTime ? new Date(deviceTime) : null;
            var onset = (dt && !isNaN(dt.getTime())) ? dt : new Date();
            rec = _rdpmsFaultOnset[key] = { onset: onset };
        }

        /* Frozen — later polls (and the 1-second local re-eval) never advance it. */
        return rec.onset;
    }

    /* ── WS DIAGNOSTIC LOGGER ──────────────────────────────────────────────
   Ring buffer of every deviceHealth / sensorHealth frame, so a wrong
   verdict can be traced back to what actually arrived rather than
   inferred from the rendered DOM. Off by default; zero cost until on().

   Console API:
     rdpmsWsLog.on()             start capturing
     rdpmsWsLog.off()
     rdpmsWsLog.all()            every frame, newest last
     rdpmsWsLog.device('11')     frames for one deviceId
     rdpmsWsLog.type('Modem')    frames for one deviceType
     rdpmsWsLog.state()          derived verdict per device (the key one)
     rdpmsWsLog.clear()
