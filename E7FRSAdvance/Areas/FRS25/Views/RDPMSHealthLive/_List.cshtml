       truthful even when the flags are not: resetTime older than
       setTime (or absent) means the Set is the latest event on that
       channel, so the fault is still open and began at setTime.

         setTime 13:43:39, resetTime 13:22:15  -> open since 13:43:39
         setTime 21:49:36, resetTime null      -> open since 21:49:36
         setTime 13:26:22, resetTime 13:40:52  -> cleared, ''
         setTime == resetTime                  -> cleared, ''

       Times are 'YYYY-MM-DD HH:mm:ss', so they compare as strings -
       the same assumption the callers already make when picking the
       earliest of several fault times. */
    window.rdpmsOpenFaultAt = function (setTime, resetTime) {
        var s = $.trim(setTime || '');
        if (!s) { return ''; }
        var r = $.trim(resetTime || '');
        return (!r || r < s) ? s : '';
    };

    /* Derive per-site Gateway verdicts straight from the channel store.

       _gwFaultyBySite is otherwise written only by applyGatewayHealthModel,
       which belongs to the legacy rolled-up model path. On sites driven by the
       flat Set/Reset feed that function never runs, so _gwSites came back empty
       and nfBindCombinedGatewayCount short-circuited the tile to 0 faulty even
       while groupHealth reported gatewayDown:1.

       Rule: a station's gateway is Faulty when EITHER gateway is down -
       GATEWAY_HEALTH (station) or EXGT_HEALTH (external), or both. There is no
       partial state; one down is enough to mark the station. */
    /* WS gw model per site, written by applyGatewayHealthModel and read back
   by the seed below. Previously applyGatewayHealthModel wrote straight
   into _gwFaultyBySite and then called nfApplyGatewayChannelsToRows,
   whose seed rebuilt _gwFaultyBySite from channel rows alone and threw
   the WS verdict away — that is why the gateway never updated live. */
    window.__rdpmsGwWsModelBySite = window.__rdpmsGwWsModelBySite || {};

    function nfSeedGatewayFaultyFromChannels() {
        var store = window.__rdpmsChannelRows || {};
        var bySite = {};

        /* Seed a bucket for every site the WS gw model has reported, so a
           station with no Gateway channel row still survives the loop. */
        Object.keys(window.__rdpmsGwWsModelBySite).forEach(function (_wsid) {
            if (!bySite[_wsid]) {
                bySite[_wsid] = {
                    faulty: false, cellFaulty: false,
                    down: [], total: 0, seen: {}, at: ''
                };
            }
        });

        for (var gk in store) {
            if (!store.hasOwnProperty(gk)) { continue; }
            var gr = store[gk];
            if (!gr || gr.deviceType !== 'Gateway') { continue; }

            var gsid = String(gr.siteId != null ? gr.siteId : '').trim();
            if (!gsid) { continue; }

            if (!bySite[gsid]) {
                bySite[gsid] = {
                    faulty: false, cellFaulty: false,
                    down: [], total: 0, seen: {}, at: ''
                };
            }

            var gch = String(gr.channel || '').toUpperCase();

            /* External gateway (EXGT_HEALTH) is intentionally EXCLUDED: the
               Station Gateway verdict — grid cell, pictorial and the faulty
               list it drives — now considers ONLY the main gateway
               (GATEWAY_HEALTH). */
            if (gch === 'EXGT_HEALTH') { continue; }

            var glabel = (gch === 'GATEWAY_HEALTH') ? 'Station'
                : (gch === 'EXGT_HEALTH') ? 'External'
                    : (gr.channel || 'Gateway');

            /* Count each gateway FAMILY once, whatever its state. Without a
               denominator "one of two down" cannot be told from "both down",
               which is what the cell rule below needs. */
            if (!bySite[gsid].seen[glabel]) {
                bySite[gsid].seen[glabel] = true;
                bySite[gsid].total++;
            }

            if (Number(gr.active) === 1) {
                bySite[gsid].faulty = true;

                if (bySite[gsid].down.indexOf(glabel) === -1) {
                    bySite[gsid].down.push(glabel);
                }
            }

            /* Harvested OUTSIDE the active check on purpose. The verdict
               above still belongs to active / groupHealth, but the time must
               not: this row can carry an open fault (setTime newer than
               resetTime) while active still reads 0, which is precisely the
               state groupHealth reports as gatewayDown:1. Keyed to active,
               the Faulty cell showed no time in exactly that case. */
            var _grAt = window.rdpmsOpenFaultAt(gr.setTime, gr.resetTime);
            if (_grAt && (!bySite[gsid].at || _grAt < bySite[gsid].at)) {
                bySite[gsid].at = _grAt;
            }
        }

        /* A station can report gatewayDown through groupHealth before any
   Gateway channel row lands - and under a partial Asset Type selection
   it may never land at all. bySite was built only from channel rows, so
   those stations never entered _gwFaultyBySite and both the grid cell
   and the header tile stayed Healthy / 0. Seed them here. */
        if (typeof _groupSummaryBySite !== 'undefined') {
            Object.keys(_groupSummaryBySite).forEach(function (_ssid) {
                if (!bySite[_ssid]) {
                    bySite[_ssid] = {
                        faulty: false, cellFaulty: false,
                        down: [], total: 0, seen: {}, at: ''
                    };
                }
            });
        }

        Object.keys(bySite).forEach(function (sid) {
            if (window.rdpmsIsForcedSite && window.rdpmsIsForcedSite(sid)) {
                bySite[sid].faulty = false;
                bySite[sid].cellFaulty = false;
                bySite[sid].down = [];
                bySite[sid].at = '';
                _gwFaultyBySite[sid] = bySite[sid];
                return;
            }

            /* groupHealth carries gatewayDown for the station; the per-row
               Gateway frames only carry a fault once the publisher emits
               type:"Set". The two disagree today - groupHealth reports
               gatewayDown:1 while both rows still say active:0 - so a bare
               channel verdict of "healthy" would erase a real fault and the
               cell flashed Faulty then Healthy as the two feeds raced.

               Channel rows may only ESCALATE to faulty, never clear a fault
               groupHealth is still reporting. */
            var g = (typeof _groupSummaryBySite !== 'undefined')
                ? _groupSummaryBySite[sid] : null;

            /* Reconcile the two families SEPARATELY - collapsing them into one
               boolean is what lost the "one down vs both down" distinction. */
            if (g) {
                if (g.gatewayDown > 0 &&
                    bySite[sid].down.indexOf('Station') === -1) {
                    bySite[sid].down.push('Station');
                }
                /* External gateway (exGatewayDown / exGatewayTotal) intentionally
   ignored: only the main gateway decides the Station Gateway
   cell, pictorial and faulty list. */
                var _gTot = (parseInt(g.gatewayTotal, 10) || 0);
                if (_gTot > bySite[sid].total) { bySite[sid].total = _gTot; }
            }

            /* Third source: the flat deviceHealth gw rollup. It is the fastest
               of the three, so a fault it reports must survive the rebuild
               rather than be erased by a stale channel snapshot. Union the
               down families and take the largest denominator seen. */
            var _ws = window.__rdpmsGwWsModelBySite[sid];
            if (_ws) {
                for (var _wd = 0; _wd < _ws.down.length; _wd++) {
                    if (bySite[sid].down.indexOf(_ws.down[_wd]) === -1) {
                        bySite[sid].down.push(_ws.down[_wd]);
                    }
                }
                if (_ws.total > bySite[sid].total) {
                    bySite[sid].total = _ws.total;
                }
                if (_ws.at && (!bySite[sid].at || _ws.at < bySite[sid].at)) {
                    bySite[sid].at = _ws.at;
                }
            }

            /* Never fewer families than we have seen down. */
            if (bySite[sid].total < bySite[sid].down.length) {
                bySite[sid].total = bySite[sid].down.length;
            }

            /* HEADER: any gateway down makes the station contribute.
               CELL  : Faulty only when EVERY configured gateway of the station
                       is down. One of two down => header counts 1, grid stays
                       Healthy. */
            bySite[sid].faulty = bySite[sid].down.length > 0;
            bySite[sid].cellFaulty =
                bySite[sid].total > 0 &&
                bySite[sid].down.length >= bySite[sid].total;

            _gwFaultyBySite[sid] = bySite[sid];

            /* ORDERING DIAGNOSTIC - log only, no behaviour change. */
            if (window.rdpmsOrderLog) {
                window.rdpmsOrderLog.state(sid, 'gateway',
                    bySite[sid].cellFaulty ? 'Faulty' : 'Healthy',
                    'down=[' + bySite[sid].down.join(',') + '] total=' +
                    bySite[sid].total + ' since=' + (bySite[sid].at || '-'));
            }
        });

        return bySite;
    }

    /* Paint the Faulty Station Gateway cell on EVERY row of a site. The verdict
       is per-station, so all rows for that site carry the same badge. */
        function nfApplyGatewayChannelsToRows() {
        var bySite = nfSeedGatewayFaultyFromChannels();

        $('#tbodyRDPMSHealthLive tr[data-siteid]').each(function () {
            var $r = $(this);
            var sid = String($r.data('siteid') || '').trim();
            var ent = bySite[sid];
            if (!ent) { return; }   /* no Gateway row for this site yet */

            var gwHtml;
            if (ent.cellFaulty) {
                gwHtml = '<span class="badge badge-danger">Faulty</span>';
                /* ent.down is always ['Station'] now that the external gateway
                   is excluded from this verdict - the label added nothing but
                   noise, so show only the actual fault time underneath. */
                if (ent.at) {
                    gwHtml += '<div class="tbl-net-time">' + ent.at + '</div>';
                }
            } else {
                gwHtml = '<span class="badge badge-success">Healthy</span>';
            }

            $r.find('td').eq(9).find('span[id^="spnGW"]').html(gwHtml);
        });

        /* ── Also update the pictorial gateway card for every site ── */
        Object.keys(bySite).forEach(function (sid) {
            var ent = bySite[sid];
            var $gwCard = $('#picGW_' + sid);
            if (!$gwCard.length) { return; }

            var gwPicFaulty = ent && ent.cellFaulty;
            $gwCard.find('.pic-gw-dot')
                .removeClass('pic-dot--healthy pic-dot--faulty')
                .addClass(gwPicFaulty ? 'pic-dot--faulty' : 'pic-dot--healthy');

            var $gwStatus = $gwCard.find('.pic-gw-status');
            $gwStatus
                .removeClass('pic-status--healthy pic-status--faulty')
                .addClass(gwPicFaulty ? 'pic-status--faulty' : 'pic-status--healthy');

            $gwStatus.contents()
                .filter(function () { return this.nodeType === 3; })
                .first()
                .replaceWith(gwPicFaulty ? 'Faulty\u00a0' : 'Healthy\u00a0');

            var _at = (ent && ent.at) ? ent.at : '';
            $gwCard.find('#picGWTime_' + sid).text(gwPicFaulty ? _at : '');
        });
    }
    /* Combined IoT header: faulty = sum of gated per-site faults over the
       selected sites; total = CardLine universe; healthy = total - faulty
       (N/A and healthy both fall into healthy). Guarantees header == grid. */
    function nfBindCombinedIotCounts() {
        if (rdpmsTileOwner() !== 'rows') { return; }
        var selectedSiteIds = $('.cb-site:checked').map(function () {
            var id = parseInt($(this).val(), 10);
            return id > 0 ? String(id) : null;
        }).get();
        var restrict = selectedSiteIds.length > 0;

        var _allowed = nfAllowedUniverse();

        var faulty = 0;
        if (!_allowed.filtered) {
            Object.keys(_iotFaultyBySite).forEach(function (sid) {
                if (restrict && selectedSiteIds.indexOf(String(sid)) === -1) { return; }
                faulty += parseInt(_iotFaultyBySite[sid], 10) || 0;
            });
        } else {
            /* Filtered: recount from the channel store, keeping only A10s that
               serve a selected asset type. Both sides are now keyed
               siteId|clusterId|ADCNumber (deviceId IS the ADCNumber), so the
               match is station-exact as well as asset-type exact. */
            var _st = nfHasA10Verdicts() ? nfBuildA10StateFromChannels() : null;
            if (_st) {
                Object.keys(_st.byKey).forEach(function (k) {
                    if (!_allowed.adc[k]) { return; }
                    /* countFaulty: a masked A10 that groupHealth still reports
                       down is a real fault and belongs in the header. */
                    if (_st.byKey[k] && _st.byKey[k].countFaulty) { faulty++; }
                });
            }
        }

        var total = nfIotUniverseTotal();

        /* Masked (Undetermined) A10s are NOT held back from the tile: the
           header is a two-bucket Healthy / Faulty count, so every device that
           is not counted faulty falls into Healthy. Subtracting the masked
           ones here made Healthy + Faulty fall short of the device total with
           nothing on screen to account for the difference, and disagreed with
           the grid, which paints a masked A10 as its working (Healthy)
           verdict. Undetermined is surfaced in the drawer / pictorial only. */
        if (total > 0) { faulty = Math.min(faulty, total); }
        var healthy = total > 0 ? Math.max(0, total - faulty) : 0;

        $('#spnIoTHealthy').text(healthy);
        $('#spnIoTFaulty').text(faulty);

        /* Log the exact IoT tile numbers + the identity of every faulty A10
           behind the count (auditable: faultyDevices.length === tile Faulty).
           Faulty A10s are the cardLineId-resolved cluster|adc keys marked DOWN
           across the selected sites' cached models. */
        var _iotFaultyDevices = [];
        var _iotGetCached = (window.RdpmsHealthLive && window.RdpmsHealthLive.getCached)
            ? window.RdpmsHealthLive.getCached : null;
        Object.keys(_iotFaultyBySite).forEach(function (sid) {
            if (restrict && selectedSiteIds.indexOf(String(sid)) === -1) { return; }
            var m = _iotGetCached ? (_iotGetCached(parseInt(sid, 10)) || _iotGetCached(sid)) : null;
            if (!m) { return; }
            var h = nfBuildIotHealth(m);
            Object.keys(h.byKey).forEach(function (k) {
                if (h.byKey[k]) { _iotFaultyDevices.push(sid + ':' + k); }  /* site:cluster|adc */
            });
        });
        console.log('[RDPMS tile] IoT  Total=' + total +
            '  Healthy=' + healthy + '  Faulty=' + faulty,
            { faultyCount: _iotFaultyDevices.length, faultyDevices: _iotFaultyDevices });
    }

    /* Sensor tile under a partial Asset-Type filter.

       BOTH figures now come from ONE universe: the raw sensorHealth row store
       (window.rdpmsSensorUniverse), narrowed to the assets that survive the
       station + asset-type filter.

       What was wrong before:
         - Total was never written at all. The comment said the tile "stays on
           the WebSocket universe", but rdpmsBindSummaryTiles - the only writer
           of #spnTotalSensor - refuses to run while the filter is partial, and
