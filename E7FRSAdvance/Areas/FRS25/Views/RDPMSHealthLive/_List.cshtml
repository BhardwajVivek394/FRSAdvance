           station, not to an asset type, so the roll-up and the row-derived
           math describe the SAME universe for this one tile. The old
           `!== 'rows'` guard meant that with every asset type checked
           (owner === 'summary') a gateway going down never reached the header
           tile until some unrelated event repainted it. */
        var selectedSiteIds = $('.cb-site:checked').map(function () {
            var id = parseInt($(this).val(), 10);
            return id > 0 ? String(id) : null;
        }).get();
        var restrict = selectedSiteIds.length > 0;

        /* Seed from the channel store first: on the flat-feed path nothing else
   populates _gwFaultyBySite, and an empty map makes _gwSites empty,
   which short-circuits the tile to 0 faulty below. */
        if (typeof nfSeedGatewayFaultyFromChannels === 'function') {
            nfSeedGatewayFaultyFromChannels();
        }

        var _gwAllowed = nfAllowedUniverse();
        /* Stations that survive the site + asset-type filter. */
        /* Stations still present in the grid. The grid is already the filtered
   result set (Asset Type is applied server-side on Search), so it is a
   reliable second opinion on nfAllowedUniverse - whose site map is
   built from json.mCardLines and can come back empty for a station
   under a single-asset-type selection, which zeroed this tile. */
        var _gwGridSites = {};
        $('#tbodyRDPMSHealthLive tr[data-siteid]').each(function () {
            var _gs = String($(this).data('siteid') || '').trim();
            if (_gs) { _gwGridSites[_gs] = true; }
        });

        var _gwSites = Object.keys(_gwFaultyBySite).filter(function (sid) {
            if (restrict && selectedSiteIds.indexOf(String(sid)) === -1) { return false; }
            /* A station gateway belongs to the station, not to an asset type,
               so it is counted whole - but a station with no surviving row
               should not contribute a gateway to a filtered header. */
            if (_gwAllowed.filtered &&
                !_gwAllowed.sites[String(sid)] &&
                !_gwGridSites[String(sid)]) { return false; }
            return true;
        });
        /* Total counts gateway CHANNELS, the same unit rdpmsBindSummaryTiles
    uses, so the two owners can never report a different Stn Gateway
    Total. nfCountGatewayFromChannels treats an empty list as "no
    restriction", so an empty selection must short-circuit rather than
    count the world. */
        var _gwCh = _gwSites.length
            ? nfCountGatewayFromChannels(_gwSites)
            : { total: 0, faulty: 0, hasRows: false };
        var total = _gwCh.total;

        /* Faulty comes from _gwFaultyBySite, NOT from the raw channel count.

           nfCountGatewayFromChannels only sees channels with active:1. Today's
           feed reports the gateway fault solely through groupHealth's
           gatewayDown, while both per-row Gateway frames still carry active:0 -
           so a channel-only count read 0 while the row cells correctly showed
           Faulty. _gwFaultyBySite already holds the reconciled per-station
           verdict (channel rows escalated by groupHealth), which is the same
           value the cells are painted from, so tile and grid now agree. */
        var faulty = 0;
        for (var _gsi = 0; _gsi < _gwSites.length; _gsi++) {
            var _gent = _gwFaultyBySite[_gwSites[_gsi]];
            if (!_gent) { continue; }
            /* Count DOWN GATEWAYS, not stations. A station with one of its two
               gateways down must read 1 here even though its grid cell stays
               Healthy. This also matches rdpmsBindSummaryTiles, which sums
               gatewayDown + exGatewayDown, so the tile no longer changes unit
               when the Asset Type filter flips tile ownership. */
            faulty += _gent.down.length
                ? _gent.down.length
                : (_gent.faulty ? 1 : 0);
        }

        $('#spnTotalFaultyGatewaySite').removeData('nm-text').text(faulty);
        /* Update live Total only when we have real WS data (the tile starts at
    0 and is WS-owned; the API count is no longer used). */
        if (_gwCh.hasRows || _gwSites.length) { $('#spnTotalGatewaySite').text(total); }

        var _gwFaultySites = [];
        Object.keys(_gwFaultyBySite).forEach(function (sid) {
            if (restrict && selectedSiteIds.indexOf(String(sid)) === -1) { return; }
            if (_gwFaultyBySite[sid] && _gwFaultyBySite[sid].faulty) { _gwFaultySites.push(sid); }
        });
        console.log('[RDPMS tile] Gateway  Faulty=' + faulty,
            { faultyCount: _gwFaultySites.length, faultySites: _gwFaultySites });
    }

    /* ── Tile ownership: exactly one painter per pass ──────────────────────
       'none'    asset-type filter not rendered yet — nobody paints. The old
                 `if (!$all.length) return true;` read an unbuilt dropdown as
                 "nothing is filtered", which is why both families painted
                 during the first ~1 s after every Search.
       'rows'    asset-type filter is partial — row-derived math owns tiles.
       'summary' whole-site scope — the WebSocket roll-up owns tiles.

       Frame staleness is deliberately NOT part of ownership any more. A stale
       summary must be surfaced as stale, never silently replaced by a count
       taken from a different universe.                                      */
    function rdpmsTileOwner() {
        var $all = $('.cb-assetType');
        if (!$all.length) { return 'none'; }
        return ($all.length === $('.cb-assetType:checked').length)
            ? 'summary' : 'rows';
    }
    /* ══════════════════════════════════════════════════════════════════
       ROLL-UP SNAPSHOT → HEADER TILES

       groupHealth        (deviceHealth/{siteId}) → IoT, Network, Gateway
       sensorHealthSummary (sensorHealth/{siteId}) → Sensors

       These are per-site server-side counts, so they are summed over the
       selected stations and written straight to the tiles. While a snapshot
       is fresh the derived binders stand down (rdpmsSummaryOwnsTiles), the
       same 90 s ownership idiom already used for Gateway via __rdpmsGwWsAt.
       Grid cells are NOT touched here — flat rows still own those.
       ══════════════════════════════════════════════════════════════════ */
    /* The roll-up is a per-STATION count. The server does not see the Asset
       Type filter, so its numbers only describe the grid when every asset type
       of the selected station(s) is checked. Under a partial selection the
       tiles stay on the row-derived math, which IS filtered. */
    function rdpmsSummaryScopeIsWholeSite() {
        var $all = $('.cb-assetType');
        if (!$all.length) { return true; }   /* no filter rendered = nothing filtered */
        return $all.length === $('.cb-assetType:checked').length;
    }

    function rdpmsSummaryOwnsTiles() {
        return rdpmsTileOwner() === 'summary';
    }

    function rdpmsNum(obj, name) {
        if (!obj || obj[name] == null) { return 0; }
        var n = parseInt(obj[name], 10);
        return isNaN(n) ? 0 : n;
    }

    /* Stations the header should count: the explicit selection, or every
       station that has reported when nothing is checked. Mirrors
       nfBindCombinedNetworkCounts. */
    function rdpmsSelectedSiteFilter() {
        var ids = $('.cb-site:checked').map(function () {
            var id = parseInt($(this).val(), 10);
            return id > 0 ? String(id) : null;
        }).get();
        return { ids: ids, restrict: ids.length > 0 };
    }

    window.rdpmsApplyGroupHealthSummary = function (siteId, snap) {
        var sid = String(siteId != null ? siteId : '').trim();
        if (!sid || !snap) { return; }

        var s = snap.summary || snap.Summary;
        if (!s) { return; }

        _groupSummaryBySite[sid] = {
            a10Total: rdpmsNum(s, 'a10Total'),
            a10Online: rdpmsNum(s, 'a10Online'),
            a10Down: rdpmsNum(s, 'a10Down'),
            a10Masked: rdpmsNum(s, 'a10Masked'),
            clustersTotal: rdpmsNum(s, 'clustersTotal'),
            modemTotal: rdpmsNum(s, 'modemTotal'),
            modemWiredDown: rdpmsNum(s, 'modemWiredDown'),
            modemWirelessDown: rdpmsNum(s, 'modemWirelessDown'),
            gatewayTotal: rdpmsNum(s, 'gatewayTotal'),
            gatewayUp: rdpmsNum(s, 'gatewayUp'),
            gatewayDown: rdpmsNum(s, 'gatewayDown'),
            exGatewayTotal: rdpmsNum(s, 'exGatewayTotal'),
            exGatewayUp: rdpmsNum(s, 'exGatewayUp'),
            exGatewayDown: rdpmsNum(s, 'exGatewayDown'),
            updateTime: snap.updateTime || snap.UpdateTime || ''
        };

        /* Grid column: ONLY the normal gateway decides the per-row cell —
           exGateway contributes to the header count, never to the column.
           The list source (applyGatewayHealthModel, fed by the flat
           deviceHealth rows) outranks this: once it has reported for the
           station, the roll-up never repaints that station's cells. */
        var g = _groupSummaryBySite[sid];
        /* Repaint whenever groupHealth's verdict differs from what is stored,
   not merely when nothing is stored. The channel seed now creates an
   entry for every site with a Gateway row, which made this guard always
   false and froze the cell at whatever the channel rows said. */
        /* Claim the cell so the sensor pipeline's blanket repaint at
   fnUpdateTableData does not put Healthy back. Set BEFORE painting so
   the guards in fnUpdateTableData / fnUpdatePictorial already see it. */
        window.__rdpmsGwWsAt = Date.now();

        /* Repaint through the SHARED painter instead of inline here.
           nfApplyGatewayChannelsToRows reseeds _gwFaultyBySite from channel rows
           + this groupHealth summary + the flat gw model, then paints BOTH the
           table cells and the pictorial gateway cards. The old inline block
           painted table cells ONLY -- which is why a gateway going down never
           moved the pictorial until an unrelated deviceHealth row happened to
           arrive. It was also gated on a "verdict changed" test against a map the
           seed had already overwritten, so it often skipped the repaint entirely. */
        try {
            if (typeof nfApplyGatewayChannelsToRows === 'function') {
                nfApplyGatewayChannelsToRows();
            }
