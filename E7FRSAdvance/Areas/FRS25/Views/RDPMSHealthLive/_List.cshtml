            var _gwCh = nfCountGatewayFromChannels(sel.restrict ? sel.ids : null);
            var _gwT = _gwCh.hasRows ? _gwCh.total : gwTotal;

            var _gwFch = _gwCh.hasRows ? _gwCh.faulty : 0;
            var _gwFgrp = parseInt(gwFaulty, 10) || 0;
