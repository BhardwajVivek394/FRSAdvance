                   something to resolve even when data-a10id is empty or
                   mismatched. */
                if (window.json && $.isArray(window.json.mCardLines)) {
                    var _seenAdc = {};
                    for (var _z = 0; _z < a10Ids.length; _z++) { _seenAdc[String(a10Ids[_z]).trim()] = true; }
                    window.json.mCardLines.forEach(function (cl) {
                        if (!cl || cl.ADCNumber == null) { return; }
                        if (String(cl.SiteId) !== rSite) { return; }
                        if (String(cl.AssetId) !== rAsset) { return; }
                        var _adc = String(cl.ADCNumber).trim();
                        if (_adc && !_seenAdc[_adc]) { _seenAdc[_adc] = true; a10Ids.push(_adc); }
                    });
                }

                if (!a10Ids.length) { return null; }

                var state = null, timeText = '';

                for (var i = 0; i < a10Ids.length; i++) {
                    var _id = String(a10Ids[i]).trim();
                    /* Station-exact: an A10 down at one station must not paint
                       the same ADCNumber at another. */
                    var ent = a10State.bySiteAdc[rSite + '|' + _id];

                    /* Fallback: match by cardLineId. */
                    if (!ent) {
                        var _clid = clBySiteAssetAdc[rSite + '|' + rAsset + '|' + _id];
                        if (_clid != null && a10State.byClid) {
                            ent = a10State.byClid[String(_clid)];
                        }
                    }
                    if (!ent) { continue; }

                    if (ent.masked) {
                        /* N/A only if no un-masked A10 on this row gives a verdict */
                        if (!state) { state = 'masked'; }
                    } else if (ent.faulty) {
                        state = 'faulty';
                        if (ent.time && !timeText) { timeText = ent.time; }
                    } else if (state !== 'faulty') {
                        state = 'healthy';
                    }
                }

                /* No verdict from data-a10id (empty or mismatched), but this
      asset owns a fully-masked A10: show N/A, never leave it frozen. */
                if (!state && maskedAsset[rSite + '|' + rAsset]) { state = 'masked'; }

                return state ? { state: state, time: timeText } : null;
            }
        };
    };

    /* Repaint the IoT cell for one site (or all rows when siteId is null)
       straight from the raw A10 channel store, applying the network gate. */
    /* TABLE cells show masked A10s as their WORKING verdict (Healthy/Faulty),
     NOT N/A. Masking is surfaced only inside the drawer (per-A10 chip) and
     the pictorial view. A fully-masked A10 has no live reading, so it reads
     Healthy in the table. */
    function nfTableFlattenMasked(res) {
        if (res && res.state === 'masked') { return { state: 'healthy', time: '' }; }
        return res;
    }

    window.fnApplyChannelRowsToIotCells = function (siteId) {
        var paintCell = window.__rdpmsPaintDeviceCell;
        if (typeof paintCell !== 'function') { return; }
        /* Masks alone are enough to paint: a fully masked station has no flat
           A10 rows, and returning here left its cells frozen on Healthy. */
        var resolver = window.nfMakeIotStateResolver();
        if (!resolver) { return; }

        var sid = (siteId == null) ? null : String(siteId).trim();

        $('#tbodyRDPMSHealthLive tr[data-siteid]').each(function () {
            var $row = $(this);
            var rSite = String($row.data('siteid') || '').trim();
            if (sid !== null && rSite !== sid) { return; }

            var r = nfTableFlattenMasked(resolver.resolve($row));
            if (r) {
                paintCell($row.find('td').eq(7), r.state,
                    r.state === 'faulty' ? r.time : '');
            }
        });
    };

    /* Repaint every row from the store — call after a _List AJAX reload so the
       cells recover without waiting for the next frame. */
    window.fnRepaintNetworkFromChannels = function () {
        fnApplyChannelRowsToNetworkCells(null);
        if (typeof window.fnApplyChannelRowsToIotCells === 'function') {
            window.fnApplyChannelRowsToIotCells(null);
        }
        if (typeof window.fnApplyChannelRowsToPictorial === 'function') {
            window.fnApplyChannelRowsToPictorial();
        }
    };

    /* ── Pictorial cards: IoT + Network from the channel store, with the
         same network gate as the table. Network Faulty only when BOTH media
         are down (time = earliest Modem setTime); IoT forced Healthy when the
         cluster network is both-down, else Faulty with earliest A10 setTime.
         Writes indoor (#picModem*) and outdoor (#picOutModem*) id prefixes,
         keyed siteId_modemId. ─────────────────────────────────────────────── */
    window.fnApplyChannelRowsToPictorial = function () {
        if (!nfHasModemChannelRows() && !nfHasA10Verdicts()) { return; }

        var idx = nfBuildModemMediaIndex();
        var gate = nfBuildClusterNetGate();
        var a10State = nfHasA10Verdicts()
            ? nfBuildA10StateFromChannels() : null;

        var clusterByModem = {};
        if (window.json && $.isArray(window.json.mCardLines)) {
            window.json.mCardLines.forEach(function (cl) {
                if (!cl || cl.ModemId == null || cl.ClusterId == null) { return; }
                nfIdVariants(cl.ModemId).forEach(function (v) {
                    clusterByModem[v] = String(cl.ClusterId);
                });
            });
        }

        var writePair = function ($val, $time, state, timeText, maskTip) {
            if (!$val.length) { return; }
            if ($val.data('nm-state') !== state) {
                $val.data('nm-state', state)
                    .removeClass('pic-val--healthy pic-val--faulty pic-val--unknown pic-val--masked')
                    .addClass(state === 'faulty' ? 'pic-val--faulty'
                        : (state === 'masked' ? 'pic-val--masked' : 'pic-val--healthy'))
                    .text(state === 'faulty' ? 'Faulty'
                        : (state === 'masked' ? 'Undetermined' : 'Healthy'));
                if (state === 'masked') {
                    $val.attr('title', maskTip || window.RDPMS_MASK_TIP.iot).css('cursor', 'help');
                } else {
                    $val.removeAttr('title').css('cursor', '');
                }
            }
            if ($time.length && $time.data('nm-time') !== timeText) {
                $time.data('nm-time', timeText).text(timeText);
            }
        };

        /* Like writePair but for a single medium, which unlike the combined
           verdict has a third state: 'unknown' (the feed carries no row for
           that leg) renders as "--" rather than a misleading Healthy. */
        var writeLeg = function ($val, $time, legState) {
            if (!$val.length) { return; }

            var state = (legState && legState.state) || 'unknown';
            var timeText = (legState && legState.time) || '';

            if ($val.data('nm-state') !== state) {
                var txt = state === 'faulty' ? 'Faulty'
                    : (state === 'healthy' ? 'Healthy'
                        : (state === 'masked' ? 'Undetermined' : '--'));
                if (state === 'masked') {
                    $val.attr('title', window.RDPMS_MASK_TIP.wired).css('cursor', 'help');
                } else {
                    $val.removeAttr('title').css('cursor', '');
                }
                var cls = state === 'faulty' ? 'pic-val--faulty'
                    : (state === 'healthy' ? 'pic-val--healthy'
                        : (state === 'masked' ? 'pic-val--masked'
                            : 'pic-val--unknown'));

                $val.data('nm-state', state)
                    .removeClass('pic-val--healthy pic-val--faulty pic-val--unknown pic-val--masked')
                    .addClass(cls)
                    .text(txt);
            }
            if ($time.length && $time.data('nm-time') !== timeText) {
                $time.data('nm-time', timeText).text(timeText);
            }
        };

        $('.pic-modem-card').each(function () {
            var $card = $(this);
            var siteId = String($card.data('siteid') || '').trim();
            var modemId = String($card.data('modemid') || '').trim();
            if (!siteId || !modemId) { return; }

            var ck = siteId + '_' + modemId;
            var outdoor = $card.closest('#picOutdoorGrid').length > 0;
            var vPfx = outdoor ? '#picOutModem' : '#picModem';

            var wired = nfWiredLegMasked(siteId, [modemId], idx);
            var wireless = nfMediumState([modemId], idx, 'wireless');
            /* One masked leg does not make the modem N/A: the un-masked leg
               still decides (Healthy -> Healthy, Faulty -> Faulty). Only when
               nothing un-masked is left is the modem N/A. See
               nfCombineNetLegs. */
            var netVerdict = nfCombineNetLegs(wired, wireless);
            var netState = netVerdict.state;
            var netTime = netVerdict.time || '';

            if (wired.state !== 'unknown' || wireless.state !== 'unknown') {
                writePair($(vPfx + 'NetVal_' + ck), $(vPfx + 'NetTime_' + ck),
                    netState, netTime, window.RDPMS_MASK_TIP.net);
            }

            /* Legs must be written here too. This painter is authoritative
               for the pictorial Network cell whenever channel rows exist, and
               it fires on the deviceHealth cadence - fnUpdatePictorial runs on
               the sensor cadence. Without this the combined row would flip to
               Faulty while both leg lines still read Healthy until the next
               aggregateAndUpdateUI. */
            writeLeg($(vPfx + 'NetWiredVal_' + ck),
                $(vPfx + 'NetWiredTime_' + ck), wired);
            writeLeg($(vPfx + 'NetWirelessVal_' + ck),
                $(vPfx + 'NetWirelessTime_' + ck), wireless);

            if (!a10State) { return; }

            var cid = null;
            nfIdVariants(modemId).some(function (v) {
                if (clusterByModem[v]) { cid = clusterByModem[v]; return true; }
                return false;
            });

            /* nfBuildClusterNetGate returns siteId|clusterId -> boolean (both
    media down). When true, force IoT Healthy for every A10 on this cluster. */
            if (cid && gate[siteId + '|' + cid] === true) {
                /* Masked by the cluster network: N/A, never Healthy. */
                writePair($(vPfx + 'IoTVal_' + ck), $(vPfx + 'IoTTime_' + ck),
                    'masked', '', window.RDPMS_MASK_TIP.iot);
                return;
            }

            var a10Ids = String($card.data('a10ids') || '')
                .split(',').map(function (s) { return s.trim(); }).filter(Boolean);

            var iotState = null;
            var iotFaultCount = 0;   /* faulty A10s on this card */
            var iotTotal = 0;        /* A10s the feed actually named on this card */
            var iotEarliest = '';    /* earliest setTime among the faulty ones */

            for (var i = 0; i < a10Ids.length; i++) {
                var ent = a10State.bySiteAdc[siteId + '|' + a10Ids[i]];
                if (!ent && cid) {
                    ent = a10State.byKey[siteId + '|' + cid + '|' + a10Ids[i]];
                }
                if (!ent) { continue; }

                if (ent.masked) {
                    if (!iotState) { iotState = 'masked'; }
                    continue;   /* masked A10 is neither counted nor verdict-bearing */
                }

                iotTotal++;
                if (ent.faulty) {
                    iotState = 'faulty';
                    iotFaultCount++;
                    if (ent.time && !iotEarliest) { iotEarliest = ent.time; }
                } else if (iotState !== 'faulty') {
                    iotState = 'healthy';
                }
            }

            if (iotState) {
                /* Count text mirrors the Sensor row: "N Faulty" beside the
                   verdict when faulty, cleared when healthy. */
                var iotInfo = (iotState === 'faulty')
                    ? (iotFaultCount + ' Faulty' + (iotTotal ? ' Out of ' + iotTotal : ''))
                    : '';
                writePair($(vPfx + 'IoTVal_' + ck), $(vPfx + 'IoTTime_' + ck),
                    iotState, iotInfo);
            }
        });
    };

    /* ══════════════════════════════════════════════════════════════════
       RAW deviceHealth CHANNEL STORE  (Set/Reset snapshot feed)

       The feed no longer carries a packed flag. Each record is ONE
       (deviceType, deviceId, channel) row — that triple is its identity
       per the integration guide — with:
           active 1 = DOWN (open alert)      active 0 = UP
           setTime  = when that channel last went down (local time)

       For Modem, the channel name IS the medium, so the Network cell
       bifurcates with no bit decoding at all:
           wireless : 4G_TCP  , 4G_MQTT
           wired    : OFC_TCP , OFC_MQTT

       Kept on window so an AJAX reload of the _List partial (a Search)
       does not discard the snapshot — the socket only resends it on
       reconnect, not on a partial reload.
       ══════════════════════════════════════════════════════════════════ */
    window.__rdpmsChannelRows = window.__rdpmsChannelRows || {};

    var RDPMS_MODEM_WIRELESS_CH = { '4G_TCP': 1, '4G_MQTT': 1 };
    var RDPMS_MODEM_WIRED_CH = { 'OFC_TCP': 1, 'OFC_MQTT': 1 };

    /* Row identity per the guide: deviceType|deviceId|channel. */
    function nfChannelKey(r) {
        /* Row identity must carry the STATION. deviceType|deviceId|channel is
           unique only WITHIN one site: ADCNumber restarts at 1 per station, so
           "A10|1|A10_TCP" from site 161 overwrote the same key from site 155 in
           the shared window.__rdpmsChannelRows store, and one station's A10
           fault then decided every station's A10 cell. */
        return String(r.siteId != null ? r.siteId : '') + '|' +
            String(r.deviceType != null ? r.deviceType : '') + '|' +
            String(r.deviceId != null ? r.deviceId : '') + '|' +
            String(r.channel != null ? r.channel : '');
    }

    /* Feed times arrive as "YYYY-MM-DD HH:mm:ss". The space form is not
       parsed reliably by every browser, so normalise to the ISO 'T' form —
       which is read as LOCAL time, matching what the guide states these are. */
    function nfParseWsTime(s) {
        if (!s) { return null; }
        var d = new Date(String(s).replace(' ', 'T'));
        return isNaN(d.getTime()) ? null : d;
    }

    /* True once the feed has delivered at least one Modem channel row. Used to
       decide whether this store or the legacy rolled-up device model owns the
       Network cell, so the two can never fight over it. */
    function nfHasModemChannelRows() {
        var store = window.__rdpmsChannelRows;
        for (var k in store) {
            if (store.hasOwnProperty(k) && store[k] &&
                store[k].deviceType === 'Modem') { return true; }
        }
        return false;
    }

    /* Index the store once per repaint:
         variantId -> { wired: [rows], wireless: [rows] }
       Built through nfIdVariants so a row's data-modemid still matches when
       the feed's MAC casing or leading zeros differ. */
    function nfBuildModemMediaIndex() {
        var idx = {};
        var store = window.__rdpmsChannelRows;

        for (var k in store) {
            if (!store.hasOwnProperty(k)) { continue; }

            var r = store[k];
            if (!r || r.deviceType !== 'Modem' || r.deviceId == null) { continue; }

            var ch = String(r.channel || '').toUpperCase();
            var medium = RDPMS_MODEM_WIRELESS_CH[ch]
                ? 'wireless'
                : (RDPMS_MODEM_WIRED_CH[ch] ? 'wired' : null);

            if (!medium) { continue; }   /* unknown channel -> ignore, never guess */

            var variants = nfIdVariants(r.deviceId);
            for (var v = 0; v < variants.length; v++) {
                var e = idx[variants[v]] ||
                    (idx[variants[v]] = { wired: [], wireless: [] });
                e[medium].push(r);
            }
        }
        return idx;
    }

    /* Worst-of one medium across all the modems on a row:
         'faulty'  -> any channel of that medium is active:1
         'healthy' -> the medium is present and every channel is active:0
         'unknown' -> the feed named no channel of that medium for this row
       Fault time is the EARLIEST setTime among the down channels, taken
       straight from the server — no local onset pinning is needed here,
       because setTime is already a stable fault instant, not a heartbeat. */
    function nfMediumState(modemIds, idx, medium) {
        var seen = false, down = false, onset = null;

        for (var i = 0; i < modemIds.length; i++) {
            var variants = nfIdVariants(modemIds[i]);
            var e = null;

            for (var v = 0; v < variants.length; v++) {
                if (idx[variants[v]]) { e = idx[variants[v]]; break; }
            }
            if (!e) { continue; }

            var rows = e[medium] || [];
            for (var r = 0; r < rows.length; r++) {
                seen = true;
                if (Number(rows[r].active) !== 1) { continue; }

                down = true;
                var t = nfParseWsTime(rows[r].setTime);
                if (t && (!onset || t < onset)) { onset = t; }
            }
        }

        if (!seen) { return { state: 'unknown', time: '' }; }
        if (!down) { return { state: 'healthy', time: '' }; }

        /* fnFormatOutdoorDeviceTime is declared in the first <script> block and
     reached here via window. Fall back to the raw value rather than
     throwing if the export has not run yet — a missing timestamp is a
     cosmetic loss, a ReferenceError kills the whole onSummary handler and
     freezes every live update. */
        return {
            state: 'faulty',
            time: onset
                ? (typeof window.fnFormatOutdoorDeviceTime === 'function'
                    ? window.fnFormatOutdoorDeviceTime(onset)
                    : String(onset))
                : ''
        };
    }

    /* Repaint the bifurcated Network cell for one site, or for every row when
       siteId is null (used after a _List partial reload). */
    function fnApplyChannelRowsToNetworkCells(siteId) {
        var paintSplit = window.__rdpmsPaintNetworkSplitCell;
        if (typeof paintSplit !== 'function') { return; }

        var sid = (siteId == null) ? null : String(siteId).trim();
        var idx = nfBuildModemMediaIndex();

        $('#tbodyRDPMSHealthLive tr[data-siteid]').each(function () {
            var $row = $(this);
            var rSite = String($row.data('siteid') || '').trim();
            if (sid !== null && rSite !== sid) { return; }

            var modemIds = nfSplitRowIds($row.data('modemid'));

            if (!modemIds.length) {
                /* IPS rows carry no modem — leave the cell alone rather than
                   marking N/A; their cluster is still counted in the header. */
                return;
            }

            var wired = nfWiredLegMasked(rSite, modemIds, idx);
            var wireless = nfMediumState(modemIds, idx, 'wireless');

            /* ORDERING DIAGNOSTIC - log only, no behaviour change.
               'masked' is what the grid shows as Undetermined. */
            if (window.rdpmsOrderLog) {
                window.rdpmsOrderLog.state(rSite, 'wired',
                    (wired.state === 'masked') ? 'Undetermined'
                        : (wired.state === 'faulty') ? 'Faulty'
                        : (wired.state === 'healthy') ? 'Healthy' : 'Unknown',
                    'modems=' + modemIds.join('|') +
                    ' wireless=' + wireless.state);
            }

            /* Feed named NEITHER medium for this row's modem -> leave the cell
               to nmApply()'s REST fallback rather than blanking real data. */
            if (wired.state === 'unknown' && wireless.state === 'unknown') { return; }

            paintSplit($row.find('td').eq(8), { wired: wired, wireless: wireless });
        });
    }

    /* ── Feed entry point ───────────────────────────────────────────────
       Call this from the socket handler with the raw envelope, for BOTH the
       initial snapshot and every subsequent one-row update — the handling is
       identical, which is the whole point of the row-identity key.

         { MessageType:'Batch', Topic:'deviceHealth/155',
           MessagesCount:54, Messages:[ '<json string>', ... ] }

       Each Messages entry is a JSON STRING and must be parsed individually.
       ─────────────────────────────────────────────────────────────────── */
    /* NOTE: the live definition of fnApplyDeviceHealthBatch is further down
   (search "NEW FEED: flat per-row"). This earlier copy was dead code — the
   second definition overwrote it at load time. Kept removed to avoid two
   divergent implementations writing __rdpmsChannelRows. */
    window.__rdpmsDeadApplyDeviceHealthBatch = function (batch) {
        if (!batch) { return; }

        var raws = $.isArray(batch.Messages)
            ? batch.Messages
            : ($.isArray(batch) ? batch : []);

        var touchedSites = {};

        for (var i = 0; i < raws.length; i++) {
            var rec = raws[i];

            if (typeof rec === 'string') {
                try { rec = JSON.parse(rec); }
                catch (e) { continue; }   /* one bad row must not drop the batch */
            }

            if (!rec || !rec.deviceType || rec.deviceId == null) { continue; }

            window.__rdpmsChannelRows[nfChannelKey(rec)] = rec;

            if (rec.siteId != null) { touchedSites[String(rec.siteId)] = true; }
        }

        /* Frame-based ownership marker — the same flag nmApply() already
           checks, so the 60 s REST poll stops overwriting these cells for
           90 s after the last frame. */
        window.__rdpmsNetWsAt = Date.now();

        Object.keys(touchedSites).forEach(function (sid) {
            fnApplyChannelRowsToNetworkCells(sid);
            if (typeof nfApplyGatewayChannelsToRows === 'function') {
                nfApplyGatewayChannelsToRows();
            }
            if (typeof window.fnApplyChannelRowsToIotCells === 'function') {
                window.fnApplyChannelRowsToIotCells(sid);
            }
        });

        if (typeof nfBindCombinedIotCounts === 'function') { nfBindCombinedIotCounts(); }
        if (window.rdpmsNormalizeLive) { window.rdpmsNormalizeLive(); }
    };

    /* Repaint every row from the store — call after a _List AJAX reload so the
       cells recover without waiting for the next frame. */
    window.fnRepaintNetworkFromChannels = function () {
        /* This is the SECOND definition of this function in the file and it is
           the one that wins. It was missing the IoT and pictorial repaints the
           first (overwritten) definition had, so after a _List AJAX reload the
           Network cells recovered but the IoT cells and the pictorial cards did
           not, until the next WS frame. */
        fnApplyChannelRowsToNetworkCells(null);
        if (typeof nfApplyGatewayChannelsToRows === 'function') {
            nfApplyGatewayChannelsToRows();
        }
        if (typeof window.fnApplyChannelRowsToIotCells === 'function') {
            window.fnApplyChannelRowsToIotCells(null);
        }
        if (typeof window.fnApplyChannelRowsToPictorial === 'function') {
            window.fnApplyChannelRowsToPictorial();
        }
    };

    /* ──────────────────────────────────────────────────────────────────
       IoT network-gate (per spec) — SEPARATE from nfClassifyNetwork above
       so the Network cards keep their existing wired = (bit1 OR bit3) rule
       and are NOT affected by this change.

       Network is "UP" for IoT purposes when Wireless is up OR BOTH wired
       legs are up. On the 3-bit flag {bit1=8, bit2=4, bit3=2} the UP-set is
       exactly {111,101,010,110,011}; DOWN-set {000,001,100}.
         net UP   → evaluate IoT (all-zero → Faulty, else Healthy)
         net DOWN → IoT = N/A (gray)
       Returns true (up) / false (down) / null (unknown flag → caller falls
       back to existing Healthy/Faulty, never forces N/A). */
    function nfNetworkIsUp(fv) {
        if (typeof fv !== 'number' || !isFinite(fv)) return null;
        var w1 = (fv & 8) ? 1 : 0, wl = (fv & 4) ? 1 : 0, w3 = (fv & 2) ? 1 : 0;
        return (wl === 1 || (w1 === 1 && w3 === 1));
    }

    /* Latest per-cluster network up/down, harvested from each deviceHealth
       WS frame in computeNetworkCounts(). Key = "siteId|clusterId".
       Absent → gate is unknown → row keeps its existing state (fail-safe). */
    window.__rdpmsClusterNetUp = window.__rdpmsClusterNetUp || {};

    /* IoT gate for the ADCNumbers on one table row, resolved via CardLine
       (json.mCardLines) ADCNumber → ClusterId, then the WS net-up map:
         'down'    = every resolvable IoT cluster is network-DOWN → N/A
         'up'      = at least one cluster is network-UP           → evaluate
         'unknown' = no WS flag yet for any cluster               → fall back
       IPS rows (ModemId == null) carry no network gate and are ignored. */
    function nfIotGateForAdcs(siteId, adcIds) {
        if (!adcIds || !adcIds.length || !json || !json.mCardLines) return 'unknown';
        var sid = parseInt(siteId, 10);
        var sawUp = false, sawDown = false, sawFlag = false;
        for (var i = 0; i < adcIds.length; i++) {
            var adc = parseInt(adcIds[i], 10);
            if (!(adc > 0)) continue;
            for (var j = 0; j < json.mCardLines.length; j++) {
                var cl = json.mCardLines[j];
                if (!cl || cl.SiteId !== sid) continue;
                if (parseInt(cl.ADCNumber, 10) !== adc) continue;
                if (cl.ModemId == null) continue;
                var cid = parseInt(cl.ClusterId, 10);
                if (!(cid > 0)) continue;
                var up = window.__rdpmsClusterNetUp[sid + '|' + cid];
                if (up === true) { sawUp = true; sawFlag = true; }
                else if (up === false) { sawDown = true; sawFlag = true; }
            }
        }
        if (!sawFlag) return 'unknown';
        if (sawUp) return 'up';
        if (sawDown) return 'down';
        return 'unknown';
    }

    /* IoT TOTAL universe = distinct (ClusterId, ADCNumber) among all CardLine
   rows with a valid ADCNumber. This now includes IPS rows (ModemId == null)
   that still carry a valid ADCId — keyed as sid|ips|ADCId in nfAllowedUniverse.
   Restricted to the checked Asset Types so the tile denominator always
   describes the rows actually on screen. */
    function nfIotUniverseTotal() {
        return Object.keys(nfAllowedUniverse().adc).length;
    }

    /* Network TOTAL universe = distinct ClusterId in CardLine (any row with a
   valid ClusterId is counted, regardless of ModemId). This includes IPS
