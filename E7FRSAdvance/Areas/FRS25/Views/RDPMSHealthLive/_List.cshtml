            </div>

            <!-- Modem cards grid — Indoor -->
            <div class="pic-modem-grid" id="picIndoorGrid">
                @if (Model != null && Model.mClusters != null)
                {
                    foreach (var cluster in Model.mClusters.Where(x => x.TypeId == (int)E7FRSAdvance.Utility.Utility.ClusterType.Indoor.GetHashCode()))
                    {
                        /* Assets that belong to this modem */
                        var clusterAssets = Model.mAssets.Where(a => a.SiteId == cluster.SiteId && a.ModemIdStr != null && a.ModemIdStr.Contains(cluster.ModemId)).ToList();

                        /* ADCs for this cluster — used to resolve A10 ids for IoT */


                        /* All assetIds under this modem — used to pre-populate data-assetids */
                        var assetIdList = string.Join(",", clusterAssets.Select(a => a.AssetId.ToString()));


                        /* All A10 ids under this modem */
                        var a10IdList = string.Join(",", Model.mCardLines.Where(x => x.ClusterId == cluster.Id).GroupBy(x => x.ADCNumber).Select(x => x.Key).ToList());

                        var siteName = clusterAssets.Count > 0
                        ? (clusterAssets[0].SiteName ?? cluster.SiteId.ToString())
                        : cluster.SiteId.ToString();

                        string sensorIds = string.Empty;

                        var cardLines = Model.mCardLines.Where(x => x.ClusterId == cluster.Id).ToList();
                        if (cardLines != null && cardLines.Count > 0)
                        {
                            var strfd = cardLines
                            .Where(x => x.AttributeId != null && x.AssetId != null)
                            .Select(x => x.AssetId.ToString() + "-" + x.AttributeId.ToString())
                            .ToList();
                            if (strfd != null && strfd.Count > 0)
                            {
                                sensorIds = string.Join(",", strfd);
                            }
                        }

                        <div class="pic-modem-card"
                             id="picModem_@(cluster.SiteId)_@(cluster.ModemId)"
                             data-siteid="@cluster.SiteId"
                             data-modemid="@cluster.ModemId"
                             data-clusterid="@cluster.Id"
                             data-assetids="@assetIdList"
                             data-a10ids="@a10IdList"
                             data-sensor="@sensorIds"
                             style="display:none;">

                            <!-- Card header -->
                            <div class="pic-modem-header">
                                <div class="pic-modem-title">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18" /></svg>
                                    @siteName — @cluster.Name
                                </div>
                                <span class="pic-status-dot pic-dot--healthy"
                                      id="picModemDot_@(cluster.SiteId)_@(cluster.ModemId)"></span>
                            </div>

                            <!-- Health rows: IoT + Network -->
                            <!-- Health rows: icon + IoT + Network + Sensor summary -->
                            <div class="pic-modem-health">
                                <!-- Indoor cabinet icon -->
                                <div class="pic-asset-thumb">
                                    <svg width="56" height="62" viewBox="0 0 56 62" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M0 62V20.6667L28 0L56 20.6667V62H45.5V27.5556H10.5V62H0ZM17.5 55.1111H38.5V48.2222H17.5V55.1111ZM17.5 41.3333H38.5V34.4444H17.5V41.3333Z" fill="#BABFCA" />
                                    </svg>

                                </div>
                                <div class="pic-health-rows-wrap">
                                    <!-- IoT -->
                                    <div class="pic-health-row">
                                        <span class="pic-hi pic-hi-iot">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
                                        </span>
                                        <span class="pic-hl">IoT :</span>
                                        <span id="picModemIoTVal_@(cluster.SiteId)_@(cluster.ModemId)"
                                              class="pic-val pic-val--healthy">Healthy</span>
                                        <span id="picModemIoTTime_@(cluster.SiteId)_@(cluster.ModemId)"
                                              class="pic-time"></span>
                                    </div>
                                    <!-- Network -->
                                    <div class="pic-health-row">
                                        <span class="pic-hi pic-hi-net">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3H5a2 2 0 0 0-2 2v4m6-6h10a2 2 0 0 1 2 2v4M9 3v18m0 0h10a2 2 0 0 0 2-2V9M9 21H5a2 2 0 0 1-2-2V9m0 0h18" /></svg>
                                        </span>
                                        <span class="pic-hl">Network :</span>
                                        <span id="picModemNetVal_@(cluster.SiteId)_@(cluster.ModemId)"
                                              class="pic-val pic-val--healthy">Healthy</span>
                                        <span id="picModemNetTime_@(cluster.SiteId)_@(cluster.ModemId)"
                                              class="pic-time"></span>
                                    </div>
                                    <!-- Sensor summary -->
                                    <div class="pic-health-row">
                                        <span class="pic-hi pic-hi-sensor">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4" /></svg>
                                        </span>
                                        <span class="pic-hl">Sensor :</span>
                                        <span id="picModemSensorSumVal_@(cluster.SiteId)_@(cluster.ModemId)"
                                              class="pic-val pic-val--healthy">Healthy</span>
                                        <span id="picModemSensorSumInfo_@(cluster.SiteId)_@(cluster.ModemId)"
                                              class="pic-time"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Sensor fault list (AssetName - SensorName : Faulty  timestamp) -->
                            <div class="pic-sensor-section" id="picModemSensorSection_@(cluster.SiteId)_@(cluster.ModemId)" style="display:none;">
                                <div class="pic-sensor-header">
                                    <span class="pic-hi pic-hi-sensor">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4" /></svg>
                                    </span>
                                    <span class="pic-hl">Sensor</span>
                                    <span class="pic-sensor-badge" id="picModemSensorBadge_@(cluster.SiteId)_@(cluster.ModemId)"></span>
                                </div>
                                <div class="pic-sensor-list" id="picModemSensorList_@(cluster.SiteId)_@(cluster.ModemId)"></div>
                            </div>

                        </div><!-- /.pic-modem-card -->
                    }
                }
            </div>

            <!-- Empty state -->
            <div id="picIndoorEmpty" class="pic-empty-state" style="display:none;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                <div class="pic-empty-title">All Systems Healthy</div>
                <div class="pic-empty-sub">No faulty components detected in Indoor RDPMS</div>
            </div>

        </div><!-- /#picIndoorPanel -->
