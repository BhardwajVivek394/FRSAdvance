           changing, so repaint this station from the channel store now.
           (The socket indexed the masks before calling us.) */
        try {
            fnApplyChannelRowsToNetworkCells(sid);
            if (typeof window.fnApplyChannelRowsToIotCells === 'function') {
                window.fnApplyChannelRowsToIotCells(sid);
            }
            if (typeof window.fnApplyChannelRowsToPictorial === 'function') {
                window.fnApplyChannelRowsToPictorial();
            }
        } catch (eMask) {
            if (window.console) { console.warn('[RDPMS mask] repaint failed', eMask); }
        }

        window.__rdpmsSummaryWsAt = Date.now();
        rdpmsBindSummaryTiles();
    };

    window.rdpmsApplySensorHealthSummary = function (siteId, snap) {
        var sid = String(siteId != null ? siteId : '').trim();
        if (!sid || !snap) { return; }

        var s = snap.summary || snap.Summary;
        if (!s) { return; }

        _sensorSummaryBySite[sid] = {
            sensorTotal: rdpmsNum(s, 'sensorTotal'),
            sensorOnline: rdpmsNum(s, 'sensorOnline'),
            sensorDown: rdpmsNum(s, 'sensorDown'),
            updateTime: snap.updateTime || snap.UpdateTime || ''
        };

        window.__rdpmsSummaryWsAt = Date.now();
        rdpmsBindSummaryTiles();
    };

    /* WebSocket-independent sensor TOTAL from the on-page inventory
