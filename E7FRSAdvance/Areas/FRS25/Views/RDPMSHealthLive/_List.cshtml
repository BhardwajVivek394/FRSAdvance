    var id = parseInt(attributeId, 10);

    if (isNaN(id) || id <= 0) {
        return '';
    }

    var names = {
        /* A End — Normal */
        1002: 'A IPT N',
        1004: 'A IPT N',
        1005: 'A TPT N',
        2002: 'A VPT 110 DC LOC N',

        /* B End — Normal */
        3002: 'B IPT N',
        3004: 'B IPT N',
        3005: 'B TPT N',
