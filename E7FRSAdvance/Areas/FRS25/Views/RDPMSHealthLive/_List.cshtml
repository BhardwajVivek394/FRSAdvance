    function nfIdVariants(rawId) {
        var s = String(rawId == null ? '' : rawId).trim();
        if (!s) return [];
        var out = [s];
        var d = s.lastIndexOf('-'); if (d > -1 && d < s.length - 1) out.push(s.substring(d + 1));
        var u = s.lastIndexOf('_'); if (u > -1 && u < s.length - 1) out.push(s.substring(u + 1));
        var nz = s.replace(/^0+(?=\d)/, ''); if (nz !== s) out.push(nz);
        var lc = s.toLowerCase(); if (lc !== s) out.push(lc);
        return out;
    }

    /* Wired faulty = bit1 AND bit3 both 0; Wireless faulty = bit2 = 0.
       MSB-first 4-bit flag: bit1 = 8, bit2 = 4, bit3 = 2. No flag -> Faulty. */
    function nfClassifyNetwork(fv) {
        if (typeof fv !== 'number' || !isFinite(fv)) return { wired: 'Faulty', wireless: 'Faulty' };
        var bit1 = (fv & 8) ? 1 : 0, bit2 = (fv & 4) ? 1 : 0, bit3 = (fv & 2) ? 1 : 0;
        return {
            wired: (bit1 === 0 && bit3 === 0) ? 'Faulty' : 'Healthy',
            wireless: (bit2 === 0) ? 'Faulty' : 'Healthy'
        };
    }

    /* ──────────────────────────────────────────────────────────────────
       IoT network-gate (per spec) — SEPARATE from nfClassifyNetwork above
       so the Network cards keep their existing wired = (bit1 OR bit3) rule
       and are NOT affected by this change.

       Network is "UP" for IoT purposes when Wireless is up OR BOTH wired
       legs are up. On the 3-bit flag {bit1=8, bit2=4, bit3=2} the UP-set is
       exactly {111,101,010,110,011}; DOWN-set {000,001,100}.
         net UP   → evaluate IoT (all-zero → Faulty, else Healthy)
         net DOWN → IoT = N/A (gray)
       Returns true (up) / false (down) / null (unknown flag → caller falls
       back to existing Healthy/Faulty, never forces N/A). */
    function nfNetworkIsUp(fv) {
        if (typeof fv !== 'number' || !isFinite(fv)) return null;
        var w1 = (fv & 8) ? 1 : 0, wl = (fv & 4) ? 1 : 0, w3 = (fv & 2) ? 1 : 0;
        return (wl === 1 || (w1 === 1 && w3 === 1));
    }

    /* Latest per-cluster network up/down, harvested from each deviceHealth
       WS frame in computeNetworkCounts(). Key = "siteId|clusterId".
       Absent → gate is unknown → row keeps its existing state (fail-safe). */
    window.__rdpmsClusterNetUp = window.__rdpmsClusterNetUp || {};

    /* IoT gate for the ADCNumbers on one table row, resolved via CardLine
       (json.mCardLines) ADCNumber → ClusterId, then the WS net-up map:
         'down'    = every resolvable IoT cluster is network-DOWN → N/A
         'up'      = at least one cluster is network-UP           → evaluate
         'unknown' = no WS flag yet for any cluster               → fall back
       IPS rows (ModemId == null) carry no network gate and are ignored. */
    function nfIotGateForAdcs(siteId, adcIds) {
        if (!adcIds || !adcIds.length || !json || !json.mCardLines) return 'unknown';
        var sid = parseInt(siteId, 10);
        var sawUp = false, sawDown = false, sawFlag = false;
        for (var i = 0; i < adcIds.length; i++) {
            var adc = parseInt(adcIds[i], 10);
            if (!(adc > 0)) continue;
            for (var j = 0; j < json.mCardLines.length; j++) {
                var cl = json.mCardLines[j];
                if (!cl || cl.SiteId !== sid) continue;
                if (parseInt(cl.ADCNumber, 10) !== adc) continue;
                if (cl.ModemId == null) continue;
                var cid = parseInt(cl.ClusterId, 10);
                if (!(cid > 0)) continue;
                var up = window.__rdpmsClusterNetUp[sid + '|' + cid];
                if (up === true) { sawUp = true; sawFlag = true; }
                else if (up === false) { sawDown = true; sawFlag = true; }
            }
        }
        if (!sawFlag) return 'unknown';
        if (sawUp) return 'up';
        if (sawDown) return 'down';
        return 'unknown';
    }

    /* IoT TOTAL universe = distinct (ClusterId, ADCNumber) among modem-backed
       CardLine rows (ModemId present). IPS rows (ModemId == null) excluded. */
    function nfIotUniverseTotal() {
        if (!json || !json.mCardLines) return 0;
        var seen = {}, n = 0;
        for (var i = 0; i < json.mCardLines.length; i++) {
            var cl = json.mCardLines[i];
            if (!cl) continue;
            var cid = parseInt(cl.ClusterId, 10);
            var adc = parseInt(cl.ADCNumber, 10);
            /* Distinct ADCNumber per ClusterId across ALL clusters
               (IPS / no-modem clusters included). Rows whose ADCNumber
               is null (some IPS panel rows) cannot be counted → skip. */
            if (!(cid > 0) || !(adc > 0)) continue;
            var k = cid + '|' + adc;
            if (seen[k]) continue;
            seen[k] = true; n++;
        }
        return n;
    }

    /*
     * CardLine filter rules:
     *
     * 1. Station selected:
     *      Load only that SiteId.
     *
     * 2. No station selected:
     *      Load CardLine data for all currently rendered/authorised sites.
     *
     * 3. Asset type selected:
     *      Keep only the selected AssetTypeId rows.
     *
     * 4. No asset type selected:
     *      Keep all asset types.
     *
     * 5. Network total:
     *      One network per unique SiteId + ClusterId.
     */
    function fetchSiteClusters(siteId) {
        var selectedTypes = $('.cb-assetType:checked')
            .map(function () {
                return String($(this).val()).trim();
            })
            .get()
            .filter(Boolean);

        var requestedSiteId = parseInt(siteId, 10);

        /*
         * When no specific station is selected, siteId = 0 tells the API
         * to return all authorised CardLine records.
         */
        if (isNaN(requestedSiteId) || requestedSiteId <= 0) {
            requestedSiteId = 0;
        }

        return $.ajax({
            url: '/FRS25/RDPMSHealthLive/GetCardLineData',
            type: 'GET',
            data: {
                siteId: requestedSiteId
            },
            dataType: 'json'
        }).then(function (rows) {
            rows = $.isArray(rows) ? rows : [];

            /*
             * Apply AssetTypeId filter only when one or more asset types
             * are selected. Otherwise retain all CardLine rows.
             */
            if (selectedTypes.length > 0) {
                rows = rows.filter(function (row) {
                    if (!row || row.AssetTypeId == null) {
                        return false;
                    }

                    return selectedTypes.indexOf(
                        String(row.AssetTypeId).trim()
                    ) !== -1;
                });
            }

            var clusters = {};

            rows.forEach(function (row) {
                if (!row) return;

                var clusterId =
                    row.ClusterId != null
                        ? String(row.ClusterId).trim()
                        : '';

                var rowSiteId =
                    row.SiteId != null
                        ? String(row.SiteId).trim()
                        : String(requestedSiteId);

                if (!clusterId) return;

                /*
                 * Include SiteId in the key because two stations may contain
                 * the same numeric ClusterId. Within one station, duplicate
                 * CardLine rows still count as only one network.
                 */
                var uniqueClusterKey =
                    rowSiteId + '|' + clusterId;

                if (!clusters[uniqueClusterKey]) {
                    clusters[uniqueClusterKey] = {
                        siteId: rowSiteId,
                        clusterId: clusterId,
                        modemId:
                            row.ModemId != null
                                ? String(row.ModemId).trim()
                                : ''
                    };
                }
            });

            return clusters;
        });
    }
    /*
     * Latest Network result per station.
     *
     * Required because every selected station has its own deviceHealth socket.
     * Without this map, the last station frame overwrites the summary count
     * produced by all previous station frames.
     */
    var _networkCountsBySite =
        window.__rdpmsNetworkCountsBySite ||
        (window.__rdpmsNetworkCountsBySite = {});


    function nfGetClusterId(device) {
        if (!device) {
            return '';
        }

        var clusterId =
            device.clusterId != null
                ? device.clusterId
                : device.ClusterId;

        return clusterId != null
            ? String(clusterId).trim()
            : '';
    }


    /*
     * Calculate Network status using:
     *
     * Total:
     *   Unique CardLine SiteId + ClusterId after current filters.
     *
     * Health:
     *   Corresponding NW device from deviceHealth WebSocket,
     *   matched primarily by ClusterId.
     *
     * Fallback:
     *   DeviceId/ModemId matching is retained only for older payloads
     *   where clusterId is missing.
     */
    function computeNetworkCounts(siteId, wsModel) {
        return fetchSiteClusters(siteId).then(function (clusters) {
            var wsDevices =
                wsModel &&
                    wsModel.nw &&
                    $.isArray(wsModel.nw.devices)
                    ? wsModel.nw.devices
                    : [];

            var networkByCluster = {};
            var flagByDevice = {};

            wsDevices.forEach(function (device) {
                if (!device) {
                    return;
                }

                var deviceSiteId =
                    parseInt(device.siteId, 10) > 0
                        ? String(parseInt(device.siteId, 10))
                        : String(parseInt(siteId, 10));

                var rawClusterId = nfGetClusterId(device);

                var clusterId =
                    parseInt(rawClusterId, 10) > 0
                        ? String(parseInt(rawClusterId, 10))
                        : '';

                var flagValue = Number(device.flagValue);

                if (!isFinite(flagValue)) {
                    return;
                }

                var updateTimeRaw =
                    device.updateTime ||
                    device.lastChange ||
                    '';

                var updateTime =
                    updateTimeRaw
                        ? new Date(updateTimeRaw)
                        : null;

                var updateTicks =
                    updateTime &&
                        !isNaN(updateTime.getTime())
                        ? updateTime.getTime()
                        : 0;

                /*
                 * Primary matching:
                 * One latest Network WebSocket record per SiteId + ClusterId.
                 */
                if (clusterId) {
                    var clusterKey =
                        deviceSiteId + '|' + clusterId;

                    var existing =
                        networkByCluster[clusterKey];

                    if (
                        !existing ||
                        updateTicks >= existing.updateTicks
                    ) {
                        networkByCluster[clusterKey] = {
                            flagValue: flagValue,
                            updateTicks: updateTicks,
                            deviceId: device.deviceId
                        };
                    }
                }

                /*
                 * Compatibility fallback only.
                 */
                nfIdVariants(device.deviceId).forEach(function (variant) {
                    flagByDevice[
                        deviceSiteId + '|' + variant
                    ] = flagValue;
                });
            });

            var total = 0;
            var wiredHealthy = 0;
            var wiredFaulty = 0;
            var wirelessHealthy = 0;
            var wirelessFaulty = 0;
            var unknown = 0;

            Object.keys(clusters).forEach(function (clusterKey) {
                var cluster = clusters[clusterKey];

                if (!cluster) {
                    return;
                }

                total++;

                var clusterSiteId =
                    parseInt(cluster.siteId, 10) > 0
                        ? String(parseInt(cluster.siteId, 10))
                        : String(parseInt(siteId, 10));

                var clusterId =
                    parseInt(cluster.clusterId, 10) > 0
                        ? String(parseInt(cluster.clusterId, 10))
                        : '';

                var flagValue = null;

                var wsClusterKey =
                    clusterSiteId + '|' + clusterId;

                if (
                    clusterId &&
                    Object.prototype.hasOwnProperty.call(
                        networkByCluster,
                        wsClusterKey
                    )
                ) {
                    flagValue =
                        networkByCluster[wsClusterKey].flagValue;
                }
                /*
                 * Only when the WebSocket did not provide ClusterId,
                 * fall back to CardLine ModemId versus WS DeviceId.
                 */
                if (flagValue == null && cluster.modemId) {
                    nfIdVariants(cluster.modemId).some(function (variant) {
                        var deviceKey =
                            clusterSiteId + '|' + variant;

                        if (
                            Object.prototype.hasOwnProperty.call(
                                flagByDevice,
                                deviceKey
                            )
                        ) {
                            flagValue = flagByDevice[deviceKey];
                            return true;
                        }

                        return false;
                    });
                }

                /*
                 * Do not silently mark an unmatched WebSocket network as healthy.
                 * It remains excluded from Healthy and Faulty until a corresponding
                 * NW device is received.
                 */
                if (
                    typeof flagValue !== 'number' ||
                    !isFinite(flagValue)
                ) {
                    unknown++;
                    return;
                }

                /* Publish this cluster's network up/down for the IoT gate
                   (uses the spec UP-set, independent of the card verdict). */
                window.__rdpmsClusterNetUp[wsClusterKey] = nfNetworkIsUp(flagValue);

                var verdict = nfClassifyNetwork(flagValue);

                if (verdict.wired === 'Healthy') {
                    wiredHealthy++;
                }
                else {
                    wiredFaulty++;
                }

                if (verdict.wireless === 'Healthy') {
                    wirelessHealthy++;
                }
                else {
                    wirelessFaulty++;
                }
            });

            /*
  * Business rule:
  *
  * Total Network count comes from unique CardLine clusters.
  * WebSocket determines only which corresponding clusters are Faulty.
  *
  * Any cluster not present in the current WebSocket snapshot must not
  * disappear from the Network total.
  */
            return {
                total: total,

                wiredOnline:
                    Math.max(0, total - wiredFaulty),

                wiredFaulty:
                    wiredFaulty,

                wirelessOnline:
                    Math.max(0, total - wirelessFaulty),

                wirelessFaulty:
                    wirelessFaulty,

                /*
                 * Diagnostic only. Unknown clusters remain included in Online
                 * according to the required total-minus-faulty business rule.
                 */
                unknown:
                    unknown
            };
        });
    }

    /*
 * Bind the sum of all currently active station WebSocket results.
 *
 * Each SiteId has a separate deviceHealth socket. Therefore, the header
 * must sum the last known result of every active site instead of allowing
 * the latest socket frame to overwrite the previous site's result.
 */
    function nfBindCombinedNetworkCounts() {
        var selectedSiteIds = $('.cb-site:checked')
            .map(function () {
                var id = parseInt($(this).val(), 10);

                return id > 0
                    ? String(id)
                    : null;
            })
            .get();

        /*
         * No explicit station selection means use every station that currently
         * has a WebSocket result in the map.
         */
        var restrictToSelectedSites =
            selectedSiteIds.length > 0;

        var wiredOnline = 0;
        var wiredFaulty = 0;
        var wirelessOnline = 0;
        var wirelessFaulty = 0;

        Object.keys(_networkCountsBySite).forEach(function (siteKey) {
            if (
                restrictToSelectedSites &&
                selectedSiteIds.indexOf(String(siteKey)) === -1
            ) {
                return;
            }

            var counts = _networkCountsBySite[siteKey];

            if (!counts) {
                return;
            }

            wiredOnline +=
                parseInt(counts.wiredOnline, 10) || 0;

            wiredFaulty +=
                parseInt(counts.wiredFaulty, 10) || 0;

            wirelessOnline +=
                parseInt(counts.wirelessOnline, 10) || 0;

            wirelessFaulty +=
                parseInt(counts.wirelessFaulty, 10) || 0;
        });

        $('#spnNetWiredOnline').text(wiredOnline);
        $('#spnNetWiredFaulty').text(wiredFaulty);

        $('#spnNetWirelessOnline').text(wirelessOnline);
        $('#spnNetWirelessFaulty').text(wirelessFaulty);
    }
    window.fnBindDeviceHealth = function (siteId, model) {
        if (!model) {
            return;
        }

        /*
         * IoT:
         * No Wired/Wireless bifurcation.
         *
         * IoT Partial/Degraded devices are counted as Faulty in the
         * current two-state Healthy/Faulty dashboard.
         */
        if (model.iot) {
            var iotHealthy =
                parseInt(model.iot.healthy, 10);

            var iotFaulty =
                parseInt(model.iot.faultyEffective, 10);

            if (isNaN(iotHealthy)) {
                iotHealthy = 0;
            }

            if (isNaN(iotFaulty)) {
                /*
                 * Safe fallback when faultyEffective is unavailable.
                 */
                var directFaulty =
                    parseInt(model.iot.faulty, 10);

                var partial =
                    parseInt(model.iot.partial, 10);

                iotFaulty =
                    (isNaN(directFaulty) ? 0 : directFaulty) +
                    (isNaN(partial) ? 0 : partial);
            }

            /* Total IoT = distinct ADCNumber per cluster from CardLine
               (IPS excluded). Healthy = Total − Faulty so the header always
               sums to the real device universe. */
            var iotTotalWs = nfIotUniverseTotal();
            if (iotTotalWs > 0) {
                iotFaulty = Math.min(iotFaulty, iotTotalWs);
                iotHealthy = Math.max(0, iotTotalWs - iotFaulty);
            }
            $('#spnIoTHealthy').text(iotHealthy);
            $('#spnIoTFaulty').text(iotFaulty);

            /* Mark the socket as the authoritative IoT source so the REST poll
               in nmApply() stops overwriting these counts (see that guard). */
            window.__rdpmsIotWsAt = Date.now();
        }

        /*
         * Network: total from CardLine (distinct ClusterId, asset-type aware);
         * wired/wireless verdict per cluster from the WS flag. Async — the cells
         * update when the CardLine fetch resolves.
         */
        if (model.nw) {
            window.__rdpmsNetWsAt = Date.now();

            computeNetworkCounts(siteId, model)
                .then(function (networkCounts) {
                    /*
                     * Store this station's latest result. Do not directly paint only
                     * this station because another selected station may already have
                     * contributed its own counts.
                     */
                    _networkCountsBySite[
                        String(siteId)
                    ] = networkCounts;

                    nfBindCombinedNetworkCounts();

                    console.log(
                        '[DeviceHealth Network Count]',
                        {
                            siteId: siteId,
                            cardLineTotal:
                                networkCounts.total,

                            wiredHealthy:
                                networkCounts.wiredOnline,

                            wiredFaulty:
                                networkCounts.wiredFaulty,

                            wirelessHealthy:
                                networkCounts.wirelessOnline,

                            wirelessFaulty:
                                networkCounts.wirelessFaulty,

                            unmatchedClusters:
                                networkCounts.unknown
                        }
                    );
                })
                .fail(function () {
                    /*
                     * Keep the last valid WebSocket-derived count when CardLine API
                     * temporarily fails. Do not replace it with zeros.
                     */
                    console.warn(
                        '[DeviceHealth Network Count] CardLine fetch failed for SiteId:',
                        siteId
                    );
                });
        }

        /*
         * Gateway remains handled by the Gateway-specific binding.
         */
        if (
            model.gw &&
            typeof window.applyGatewayHealthModel === 'function'
        ) {
            window.applyGatewayHealthModel(
                siteId,
                model.gw,
                model.updateTime
            );
        }

        console.log('[DeviceHealth]', {
            siteId: siteId,
            iot: model.iot,
            network: model.nw,
            gateway: model.gw
        });
    };</script>