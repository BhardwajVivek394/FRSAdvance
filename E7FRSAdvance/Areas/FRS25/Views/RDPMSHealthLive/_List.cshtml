                            <div class="pic-gw-text">
                                <div class="pic-gw-label">Station Gateway</div>
                                <div class="pic-gw-title">@gwSiteName</div>
                                <div class="pic-gw-status pic-status--healthy" id="picGWStatus_@siteId">
                                    Healthy&nbsp;<span class="pic-time" id="picGWTime_@siteId"></span>
