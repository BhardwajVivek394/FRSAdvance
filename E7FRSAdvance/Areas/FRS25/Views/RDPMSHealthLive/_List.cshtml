            var assetTypeId =
                info.AssetTypeId != null
                    ? String(info.AssetTypeId).trim()
                    : '';

            var assetId =
                info.AssetId != null
                    ? String(info.AssetId).trim()
                    : '';

            if (!assetTypeId || !assetId) {
                return;
