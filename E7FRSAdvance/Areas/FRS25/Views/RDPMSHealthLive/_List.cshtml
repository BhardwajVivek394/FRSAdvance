            + '<span class="tbl-sensor-badge">Faulty</span>'
            + '<div class="tbl-sensor-name">' + lbl + '</div>'
            + '<div class="tbl-sensor-time">' + t + '</div>'
            + '</div></div>';
    }

    function fnUpdateTableData(modemIds, aIds, sensorIds, faultyGWSiteIds) {
        modemIds = modemIds || []; aIds = aIds || []; sensorIds = sensorIds || []; faultyGWSiteIds = faultyGWSiteIds || [];

        // Remove previously-added continuation rows before rebuilding.
        $('#tbodyRDPMSHealthLive tr.sensor-clone-row').remove();

        /*
  * Every configured asset row belongs to the Health Live table.
  * Healthy/Faulty status controls the cell content, not whether the
  * asset row is included in pagination.
  *
  * Exclude only temporary sensor continuation rows because they are
  * rebuilt below.
  */
        $('#tbodyRDPMSHealthLive tr')
            .not('.sensor-clone-row')
            .addClass('rdpms-filter-row')
            .show();

        var now = fmtNow();

        $('#tbodyRDPMSHealthLive tr').each(function () {
            var row = $(this);
            var rSite = row.data('siteid') != null ? row.data('siteid').toString() : '';
            var rAsset = row.data('assetid') != null ? row.data('assetid').toString() : '';
            var rMods = (row.data('modemid') != null && row.data('modemid') !== '') ? row.data('modemid').toString().split(',') : [];
            var rA10s = (row.data('a10id') != null && row.data('a10id') !== '') ? row.data('a10id').toString().split(',') : [];

            var mMatch = false;
            for (var m = 0; m < rMods.length && !mMatch; m++) { var tm = rMods[m].trim(); for (var n = 0; n < modemIds.length; n++) { if (modemIds[n].siteId === rSite && modemIds[n].modemId === tm) { mMatch = true; break; } } }
            var aMatch = false;
            for (var a = 0; a < rA10s.length && !aMatch; a++) { var ta = rA10s[a].trim(); for (var b = 0; b < aIds.length; b++) { if (aIds[b].siteId === rSite && aIds[b].a10Id === ta) { aMatch = true; break; } } }

            var sFaults = sensorIds.filter(function (s) { return s.siteId === rSite && s.assetId === rAsset; });
            var sMatch = sFaults.length > 0;
            var gMatch = faultyGWSiteIds.indexOf(rSite) > -1;

            // Gateway badge — same for the original row and every continuation
            // row for this asset, so set it once here. Network (Modem) and IoT
            // (A10) badges are NOT painted here anymore — those two cells are
            // driven exclusively by nmApply() from the ModemLive/A10Live APIs
            // (see the NETWORK MEDIA BOX block below) to avoid two systems
            // fighting over the same cell. mMatch/aMatch below are still used
            // to decide whether this row should be visible at all.
            var gwHtml = gMatch ? '<span class="badge badge-danger">Faulty</span>' : '<span class="badge badge-success">Healthy</span>';

            row.find('td').eq(9).find('span[id^="spnGW"]').html(gwHtml);

            var $sensorCell = row.find('td').eq(6);

            if (!sMatch) {
                $sensorCell.html(
                    '<span class="badge badge-success">Healthy</span>'
                );

                /*
                 * Keep every configured asset in the table. Network, IoT,
                 * Sensor and Gateway cells independently show Healthy/Faulty.
                 */
                row
                    .addClass('rdpms-filter-row')
                    .show();

                return;
            }

            // First faulty attribute stays on the original row
            $sensorCell.html(
                buildSensorItemHtml(
                    sFaults[0],
                    now
                )
            );

            row
                .addClass('rdpms-filter-row')
                .show();

            // Any additional faulty attributes on this same asset get their own
            // row directly below, repeating the other columns' values.
            var $prev = row;
            for (var i = 1; i < sFaults.length; i++) {
                var $clone = row
                    .clone(false)
                    .removeAttr('id')
                    .addClass(
                        'sensor-clone-row rdpms-filter-row'
                    );

                $clone
                    .find('td')
                    .eq(6)
                    .html(
                        buildSensorItemHtml(
                            sFaults[i],
                            now
                        )
                    );

                $prev.after($clone);
                $prev = $clone;
            }
        });
    }

