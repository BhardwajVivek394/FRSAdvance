<script>
    var rowsPerPage = 10;
    var rows = $();
    var totalRows = 0;
    var totalPages = 0;
    var currentPage = 1;
    var pager = null;

    /*
     * Renumber every row that belongs to the filtered result,
     * including rows currently hidden by pagination.
     */
    function fnRenumberRows() {
        $('#tbodyRDPMSHealthLive tr.rdpms-filter-row')
            .each(function (index) {
                $(this)
                    .find('td:first')
                    .text(index + 1);
            });
    }

    function fnRefreshTable() {
        /*
         * Never use tr:visible here. showPage() hides records from
         * other pages, so :visible would make totalRows become 10
         * after page 1 is displayed.
         */
        rows = $(
            '#tbodyRDPMSHealthLive tr.rdpms-filter-row'
        );

        totalRows = rows.length;
        totalPages = Math.ceil(
            totalRows / rowsPerPage
        );

        fnRenumberRows();

        pager = $('#pager');

        pager
            .off(
                'click.rdpmsPager',
                '.page-link'
            )
            .on(
                'click.rdpmsPager',
                '.page-link',
                function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    var $item = $(this).closest(
                        '.page-item'
                    );

                    if (
                        $item.hasClass('disabled') ||
                        $item.hasClass('active')
                    ) {
                        return false;
                    }

                    var pageAction =
                        $item.attr('data-page');

                    if (pageAction === 'prev') {
                        showPage(currentPage - 1);
                    }
                    else if (pageAction === 'next') {
                        showPage(currentPage + 1);
                    }
                    else {
                        var selectedPage = parseInt(
                            $item.attr('data-page-number'),
                            10
                        );

                        if (!isNaN(selectedPage)) {
                            showPage(selectedPage);
                        }
                    }

                    return false;
                }
            );

        if (totalPages === 0) {
            currentPage = 1;

            $('#tbodyRDPMSHealthLive tr')
                .hide();

            renderPager();
            return;
        }

        if (currentPage > totalPages) {
            currentPage = totalPages;
        }

        if (currentPage < 1) {
            currentPage = 1;
        }

        showPage(currentPage);
    }

    function showPage(page) {
        if (
            totalPages === 0 ||
            page < 1 ||
            page > totalPages
        ) {
            return;
        }

        currentPage = page;

        /*
         * Hide all physical rows first, then show only the matching
         * records belonging to the selected page.
         */
        $('#tbodyRDPMSHealthLive tr').hide();

        rows
            .slice(
                (currentPage - 1) * rowsPerPage,
                currentPage * rowsPerPage
            )
            .show();

        renderPager();
    }

    function renderPager() {
        if (!pager || !pager.length) {
            pager = $('#pager');
        }

        pager
            .find('.page-number, .ellipsis')
            .remove();

        /*
         * Hide the complete pager when zero or one page exists.
         */
        if (totalPages <= 1) {
            pager
                .closest('.rdpms-pager-wrap')
                .toggle(totalRows > 0);

            pager
                .find('.page-number, .ellipsis')
                .remove();

            if (totalRows > 0) {
                var $singlePage = $(
                    '<li class="page-item page-number active">' +
                    '<a class="page-link" href="#">1</a>' +
                    '</li>'
                );

                $singlePage
                    .attr('data-page-number', 1)
                    .insertBefore(
                        pager.find('[data-page="next"]')
                    );
            }

            pager
                .find('[data-page="prev"], [data-page="next"]')
                .addClass('disabled');

            return;
        }

        pager
            .closest('.rdpms-pager-wrap')
            .show();

        function addPage(pageNumber) {
            var $page = $(
                '<li class="page-item page-number">' +
                '<a class="page-link" href="#">' +
                pageNumber +
                '</a>' +
                '</li>'
            );

            $page.attr(
                'data-page-number',
                pageNumber
            );

            if (pageNumber === currentPage) {
                $page.addClass('active');
            }

            $page.insertBefore(
                pager.find('[data-page="next"]')
            );
        }

        function addEllipsis() {
            $(
                '<li class="page-item disabled ellipsis">' +
                '<span class="page-link">...</span>' +
                '</li>'
            ).insertBefore(
                pager.find('[data-page="next"]')
            );
        }

        var pagesToRender = [];
        var pageNumber;

        for (
            pageNumber = 1;
            pageNumber <= totalPages;
            pageNumber++
        ) {
            if (
                pageNumber === 1 ||
                pageNumber === totalPages ||
                Math.abs(
                    pageNumber - currentPage
                ) <= 1
            ) {
                pagesToRender.push(pageNumber);
            }
        }

        var previousRenderedPage = 0;

        $.each(
            pagesToRender,
            function (_, pageValue) {
                if (
                    previousRenderedPage > 0 &&
                    pageValue -
                    previousRenderedPage >
                    1
                ) {
                    addEllipsis();
                }

                addPage(pageValue);
                previousRenderedPage = pageValue;
            }
        );

        pager
            .find('[data-page="prev"]')
            .toggleClass(
                'disabled',
                currentPage <= 1
            );

        pager
            .find('[data-page="next"]')
            .toggleClass(
                'disabled',
                currentPage >= totalPages
            );
    }


    /* ── CardLine-based network totals ─────────────────────────────────
     * Total networks for a site = distinct ClusterId from CardLine
     * (narrowed to the selected asset type(s) when any are checked). Each
     * cluster's wired/wireless verdict comes from its live WS flag, matched
     * cluster.ModemId <-> nwDevices[].deviceId. Self-contained: does not rely
     * on the first-block idVariants() (scoped in its IIFE) nor on the socket
     * module's classifyNetwork.
