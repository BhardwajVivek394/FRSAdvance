                var names = (at.pairedNames || [at.name]).map(norm);

                if ((fid && ids.indexOf(fid) !== -1) ||
                    (fn && (fn === norm(at.name) || names.indexOf(fn) !== -1))) {
                    owner = at;
                    break;
                }
            }

            /* No owning chip: this end was dropped (half machine B end, or an
               attribute with no CardLine pin). It is not presented, so it must
               not be reported either. */
            if (!owner) { continue; }

            var key = norm(owner.name);
            var prev = byChip[key];

            if (!prev) {
                prev = {
                    sensorName: owner.name,
                    assetName: f.assetName || '',
                    alertTime: f.alertTime || ''
                };
                byChip[key] = prev;
                out.push(prev);
                continue;
            }

            /* Both ends of a merged pair faulty -> one card, earliest onset. */
            if (f.alertTime && (!prev.alertTime || f.alertTime < prev.alertTime)) {
                prev.alertTime = f.alertTime;
            }
        }

        /* Fail safe: never swallow every fault. If nothing matched a chip the
           attribute list is stale, so show the raw feed rather than an empty
           drawer on a row the table is painting Faulty. */
        return out.length ? out : plain;
    }

    /* Build the encoded payload string for the sensor drawer.
       Encodes all faults for this asset into a data attribute. */
    function buildSensorDrawerPayload(row, sFaults, zone, station, assetName) {
        var payload = {
            zone: zone,
            station: station,
            asset: assetName,
            status: sFaults.length > 0 ? 'faulty' : 'healthy',
            faults: sFaults.map(function (f) {
                return {
                    sensorName: f.sensorName || ('Attr ' + f.attributeId),
                    assetName: f.assetName || '',
                    alertTime: f.alertTime || ''
                };
            })
        };
        return JSON.stringify(payload).replace(/'/g, '&#39;');
    }

    /* True when this row's IoT (col 7) or Network (col 8) cell is showing a
   fault. Read from the rendered cells so it is source-agnostic — those
   cells are owned by the deviceHealth pipeline, not the sensor one. Only a
   faulty verdict greys the sensor; Healthy / N/A / — / empty do not. */
    window.rdpmsRowIotOrNetFaulty = function (row) {
        try {
            var iotHtml = row.find('td').eq(7).html() || '';
            var netHtml = row.find('td').eq(8).html() || '';
            function _isFaulty(h) {
                if (!h) { return false; }
                if (/badge-danger/.test(h)) { return true; }
                return />\s*Faulty\s*</.test(h);
            }
            return _isFaulty(iotHtml) || _isFaulty(netHtml);
        } catch (e) { return false; }
    };

    /* Re-apply the sensor grey rule after the IoT / Network cells repaint
       (they paint on the deviceHealth cadence, which is independent of the
       sensor pipeline). Only flips a currently-Healthy sensor cell to grey, or
       a stale grey back to Healthy — never touches a real faulty sensor cell. */
    window.rdpmsReconcileSensorUndetermined = function (siteId) {
        var sidStr = (siteId == null) ? null : String(siteId).trim();
        $('#tbodyRDPMSHealthLive tr[data-siteid]').each(function () {
            var row = $(this);
            if (sidStr !== null &&
                String(row.data('siteid') || '').trim() !== sidStr) { return; }

            var $cell = row.find('td').eq(6);
            var html = $cell.html() || '';
            /* A real sensor fault (red badge/icon) is authoritative — leave it. */
            if (/badge-danger/.test(html) || /#dc2626/.test(html)) { return; }

            //var down = window.rdpmsRowIotOrNetFaulty(row);
            //var isGrey = /Undetermined/.test(html);
            //var isHealthy = /badge-success/.test(html);

            //if (down && isHealthy) {
            //    $cell.html(
            //        '<span class="badge" style="background:#9ca3af;color:#fff;" ' +
            //        'title="Sensor state cannot be determined while IoT / Network is faulty">' +
            //        'Undetermined</span>');
            //} else if (!down && isGrey) {
            //    /* IoT/Network recovered — let the sensor pipeline repaint the
            //       real Healthy/Faulty cell on its next pass. Show Healthy now
            //       so the grey does not linger. */
            //    $cell.html('<span class="badge badge-success">Healthy</span>');
            //}

            /* "Undetermined" was removed by request — a sensor cell now only
   ever shows Healthy or Faulty from its own feed, never a grey
   placeholder driven by IoT/Network state. If a stale "Undetermined"
   badge is still on screen from a previous build, restore Healthy so
   the sensor pipeline can repaint it normally. */
            var isGrey = /Undetermined/.test(html);
            if (isGrey) {
                $cell.html('<span class="badge badge-success">Healthy</span>');
            }
        });
    };

    function fnUpdateTableData(modemIds, aIds, sensorIds, faultyGWSiteIds) {
        modemIds = modemIds || []; aIds = aIds || []; sensorIds = sensorIds || []; faultyGWSiteIds = faultyGWSiteIds || [];

        // Remove previously-added continuation rows before rebuilding.
        $('#tbodyRDPMSHealthLive tr.sensor-clone-row').remove();

        /*
  * Every configured asset row belongs to the Health Live table.
  * Healthy/Faulty status controls the cell content, not whether the
  * asset row is included in pagination.
  *
  * Exclude only temporary sensor continuation rows because they are
  * rebuilt below.
  */
        $('#tbodyRDPMSHealthLive tr')
            .not('.sensor-clone-row')
            .addClass('rdpms-filter-row')
            .show();

        var now = fmtNow();

        $('#tbodyRDPMSHealthLive tr').each(function () {
            var row = $(this);
            var rSite = row.data('siteid') != null ? row.data('siteid').toString() : '';
            var rAsset = row.data('assetid') != null ? row.data('assetid').toString() : '';
            var rMods = (row.data('modemid') != null && row.data('modemid') !== '') ? row.data('modemid').toString().split(',') : [];
            var rA10s = (row.data('a10id') != null && row.data('a10id') !== '') ? row.data('a10id').toString().split(',') : [];

            var mMatch = false;
            for (var m = 0; m < rMods.length && !mMatch; m++) { var tm = rMods[m].trim(); for (var n = 0; n < modemIds.length; n++) { if (modemIds[n].siteId === rSite && modemIds[n].modemId === tm) { mMatch = true; break; } } }
            var aMatch = false;
            for (var a = 0; a < rA10s.length && !aMatch; a++) { var ta = rA10s[a].trim(); for (var b = 0; b < aIds.length; b++) { if (aIds[b].siteId === rSite && aIds[b].a10Id === ta) { aMatch = true; break; } } }

            var sFaults = sensorIds.filter(function (s) { return s.siteId === rSite && s.assetId === rAsset; });
            var sMatch = sFaults.length > 0;
            var gMatch = faultyGWSiteIds.indexOf(rSite) > -1;

            // Gateway badge — same for the original row and every continuation
            // row for this asset, so set it once here. Network (Modem) and IoT
            // (A10) badges are NOT painted here anymore — those two cells are
            // driven exclusively by nmApply() from the ModemLive/A10Live APIs
            // (see the NETWORK MEDIA BOX block below) to avoid two systems
            // fighting over the same cell. mMatch/aMatch below are still used
            // to decide whether this row should be visible at all.
            /* When the deviceHealth WebSocket owns GW, applyGatewayHealthModel
               paints this cell -- don't overwrite it from the sensor pipeline,
               which has no gateway source and would always repaint Healthy. */
            var __gwOwnedByWs =
                (window.__rdpmsGwWsAt && (Date.now() - window.__rdpmsGwWsAt) < 90000);
            if (!__gwOwnedByWs) {
                var gwHtml = gMatch ? '<span class="badge badge-danger">Faulty</span>' : '<span class="badge badge-success">Healthy</span>';
                row.find('td').eq(9).find('span[id^="spnGW"]').html(gwHtml);
            }

            var $sensorCell = row.find('td').eq(6);

            /* Build row context for drawer meta */
            var _zone = row.find('td').eq(1).text().trim();
            var _station = row.find('td').eq(3).text().trim();
            var _asset = row.find('td').eq(5).text().trim();

            if (!sMatch) {
                /* Carry the keys so rdpmsOpenDrawer can rebuild this list at
   CLICK time. Built here it is frozen into the onclick string,
   and the two fetches it depends on - nfFetchCardLineRows and
   rdpmsFetchPointMachineFlags - are both kicked off after the
   first paint. Whichever had landed when this row was painted
   is what the drawer shows for the rest of the page: 16
   attributes if neither, 14 if CardLine only, B end dropped if
   the half-machine flag also arrived. That is why the list
   changed between searches. */
                var _sHealthyPayload = JSON.stringify({
                    zone: _zone, station: _station, asset: _asset,
                    status: 'healthy', faults: [],
                    attributes: buildSensorAttrStatus(rSite, rAsset, []),
                    sensorLazy: { siteId: String(rSite || ''), assetId: String(rAsset || ''), faults: [] }
                }).replace(/'/g, '&#39;');
                /* A sensor reports THROUGH its A10 / modem. When this row's IoT
    or Network cell is faulty, the sensor's true state cannot be
    known, so show grey "Undetermined" rather than a misleading
    green Healthy. rdpmsRowIotOrNetFaulty reads the sibling cells
    this pipeline does not own. */
                /* A down reporting path no longer replaces this cell. Paint the
                    normal markup — it carries the detail button, which the old
                    Undetermined branch dropped — then grey the badge in place
                    below. Label is untouched; colour alone carries the gating. */
                {
                    $sensorCell.html(
                        '<span class="badge badge-success">Healthy</span>' +
                        '<button class="rdpms-detail-btn" title="Sensor detail" ' +
                        'onclick=\'rdpmsOpenDrawer("sensor",' + _sHealthyPayload + ')\'>' +
                        '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="8"/><line x1="12" y1="12" x2="12" y2="16"/></svg>' +
                        '</button>'
                    );
                }

                /*
                 * Keep every configured asset in the table. Network, IoT,
                 * Sensor and Gateway cells independently show Healthy/Faulty.
                 */
                row
                    .addClass('rdpms-filter-row')
                    .show();

                return;
            }

            /* Point machine ends are collapsed once, then reused for the cards,
    the "N Faulty Sensors" heading and the cell count, so all three
    agree with the chip list. */
            var _sFaultCards = rdpmsCollapseSensorFaults(rSite, rAsset, sFaults);

            var _sFaultyPayload = JSON.stringify({
                zone: _zone, station: _station, asset: _asset,
                status: 'faulty',
                faults: _sFaultCards,
                attributes: buildSensorAttrStatus(rSite, rAsset, sFaults),
                /* Raw faults ride along so the click-time rebuild can re-run
                   both buildSensorAttrStatus and rdpmsCollapseSensorFaults
                   against the same fault set this cell was painted from. */
                sensorLazy: {
                    siteId: String(rSite || ''),
                    assetId: String(rAsset || ''),
                    faults: sFaults
                }
            }).replace(/'/g, '&#39;');

            // Every faulty attribute of this asset is rendered inside the SAME
            // cell. Earlier only sFaults[0] stayed here and each extra fault
            // was pushed onto a cloned <tr>, which made one asset show up as
            // two (or more) rows.
            $sensorCell.html(
                buildSensorItemHtml(_sFaultCards, now) +
                '<button class="rdpms-detail-btn" title="Sensor detail" ' +
                'onclick=\'rdpmsOpenDrawer("sensor",' + _sFaultyPayload + ')\'>' +
                '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="8"/><line x1="12" y1="12" x2="12" y2="16"/></svg>' +
                '</button>'
            );

            row
                .addClass('rdpms-filter-row')
                .show();

            /* No continuation rows are created any more - one asset =
   one row, however many of its sensors are faulty. */
        });

        /* Sensor cells just repainted with fresh onclick payloads — re-render
           the detail popup if it is open on a sensor cell. */
        if (typeof window.rdpmsRefreshOpenDrawer === 'function') {
            window.rdpmsRefreshOpenDrawer();
        }
    }

    /* disconnectWebSocket, updateStatusBar, showWsStatus removed —
       WebSocket delivery is gone, and the #wsStatusBar element stays
       hidden (its initial style="display:none;" is untouched). */

    window.fnToggleSensorList = function (btn, total, preview) {
        var $btn = $(btn);
        var $list = $btn.closest('.pic-sensor-list');
        var $extras = $list.find('.pic-sensor-extra');
        var isOpen = $btn.data('open');

        if (!isOpen) {
            $extras.show();
            var shown = total - preview;
            $btn.data('open', true).html(
                '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>'
                + 'See less'
            );
        } else {
            $extras.hide();
            var remaining = total - preview;
            $btn.data('open', false).html(
                '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>'
                + 'See ' + remaining + ' more'
            );
        }
    };

    /* ══════════════════════════════════════════════════════════════════
   DETAIL POPUP
   Injected directly into <body> so position:fixed works correctly
   and never shifts the partial container (#divRDPMSHealthLive).
   Guard prevents duplicate injection on repeated Search clicks.
══════════════════════════════════════════════════════════════════ */
    /* ══════════════════════════════════════════════════════════════════
   DETAIL POPUP — injected once into <body> so position:fixed never
   shifts the partial container. Guard prevents re-injection on Search.
══════════════════════════════════════════════════════════════════ */

    /* Define close first so it is always callable regardless of injection order */
    window.rdpmsCloseDrawer = function () {
        $('#rdpmsPopupOverlay').removeClass('open');
        /* Drop the live-refresh anchor so WS frames stop re-rendering a
           popup the user has closed. */
        window.__rdpmsActiveDrawer = null;
    };

    /* ── LIVE REFRESH OF THE OPEN DETAIL POPUP ──────────────────────────
       The IoT / Network / Sensor cells repaint on every WebSocket frame and
       rebuild their detail button's onclick payload with the fresh state.
       rdpmsOpenDrawer records which cell opened the popup (window.__rdpmsActiveDrawer);
       when a frame lands we re-invoke that cell's current button so the open
       popup re-renders from the freshest payload — without re-fetching or
       animating. Debounced so a burst of rows rebuilds the popup once, and
       given a short delay so the async network-count paint has settled.
       ─────────────────────────────────────────────────────────────────── */
    var _rdpmsDrawerRefreshTimer = null;

    function _rdpmsDoRefreshOpenDrawer() {
        if (!$('#rdpmsPopupOverlay').hasClass('open')) { return; }

        var ctx = window.__rdpmsActiveDrawer;
        if (!ctx || !ctx.cell || !document.body.contains(ctx.cell)) { return; }

        /* The cell persists across repaints (only its inner HTML is replaced),
           so the current button carries the latest onclick payload. */
        var btn = ctx.cell.querySelector('.rdpms-detail-btn');
        if (!btn || typeof btn.onclick !== 'function') { return; }

        /* Call the inline handler directly (no dispatched event) so nothing
           bubbles to row handlers; __rdpmsDrawerRefreshing tells rdpmsOpenDrawer
           to re-render in place rather than re-capture the source or re-run the
           point-machine fetch/re-open. */
        window.__rdpmsDrawerRefreshing = true;
        try { btn.onclick.call(btn); }
        catch (e) {
            if (window.console && console.warn) {
                console.warn('[RDPMS] detail popup live refresh failed:', e);
            }
        }
        finally { window.__rdpmsDrawerRefreshing = false; }
    }

    window.rdpmsRefreshOpenDrawer = function () {
        if (!$('#rdpmsPopupOverlay').hasClass('open')) { return; }
        if (_rdpmsDrawerRefreshTimer) { return; }   /* coalesce this frame's rows */
        _rdpmsDrawerRefreshTimer = setTimeout(function () {
            _rdpmsDrawerRefreshTimer = null;
            _rdpmsDoRefreshOpenDrawer();
        }, 200);
    };

    /* Delegated — survives partial reloads and works whether popup
       was injected by this instance or a prior one */
    $(document).off('click.rdpmsPopup').on('click.rdpmsPopup',
        '#rdpmsPopupCloseBtn, #rdpmsPopupFooterClose', function () {
            window.rdpmsCloseDrawer();
        }
    );
    $(document).off('click.rdpmsPopupOverlay').on('click.rdpmsPopupOverlay',
        '#rdpmsPopupOverlay', function (e) {
            if (e.target === this) { window.rdpmsCloseDrawer(); }
        }
    );
    $(document).off('keydown.rdpmsDrawer').on('keydown.rdpmsDrawer', function (e) {
        if (e.key === 'Escape') { window.rdpmsCloseDrawer(); }
    });

    /* Inject popup HTML into body once only */
    if (!$('#rdpmsPopupOverlay').length) {
        $('body').append(
            '<div id="rdpmsPopupOverlay" class="rdpms-popup-overlay">' +
            '<div id="rdpmsPopup" class="rdpms-popup">' +
            '<div id="rdpmsPopupHead" class="rdpms-popup-head">' +
            '<div id="rdpmsPopupTitle" class="rdpms-popup-title">' +
            '<i class="fas fa-info-circle"></i> Detail' +
            '</div>' +
            '<button id="rdpmsPopupCloseBtn" class="rdpms-popup-close" type="button" title="Close">' +
            '<i class="fas fa-times"></i>' +
            '</button>' +
            '</div>' +
            '<div id="rdpmsPopupMeta" class="rdpms-popup-meta"></div>' +
            '<div id="rdpmsPopupBody" class="rdpms-popup-body"></div>' +
            '<div class="rdpms-popup-footer">' +
            '<button id="rdpmsPopupFooterClose" class="rdpms-popup-btn-close" type="button">Close</button>' +
            '</div>' +
            '</div>' +
            '</div>'
        );
    }

    /* ── helpers ── */
    function rdpmsNetBadge(state) {
        if (state === 'healthy') {
            return '<span class="rdpms-popup-net-badge-healthy"><i class="fas fa-check-circle"></i> Healthy</span>';
        }
        if (state === 'faulty') {
            return '<span class="rdpms-popup-net-badge-faulty"><i class="fas fa-times-circle"></i> Faulty</span>';
        }
        if (state === 'na') {
            return '<span class="rdpms-popup-net-badge-na"><i class="fas fa-minus-circle"></i> N/A</span>';
        }
        if (state === 'masked') {
            return '<span class="rdpms-popup-net-badge-masked" style="cursor:help;" title="' +
                ((window.RDPMS_MASK_TIP && window.RDPMS_MASK_TIP.wired) || 'Parent link down') +
                '"><i class="fas fa-minus-circle"></i> Undetermined</span>';
        }
        return '<span class="rdpms-popup-net-badge-na"><i class="fas fa-question-circle"></i> Unknown</span>';
    }

    function rdpmsNetSection(label, iconClass, iconType, leg) {
    /*
     * Wired / Wireless cards show STATUS only.
     * Fault time belongs to the faulty Modem card above so it is displayed
     * exactly once.
     */
    var st = (leg && leg.state) || 'unknown';
    var subLabel = iconType === 'wired' ? 'OFC / TCP' : '4G / MQTT';

    return '<div class="rdpms-popup-net-section">' +
        '<div class="rdpms-popup-net-head">' +
        '<div class="rdpms-popup-net-label-wrap">' +
        '<span class="rdpms-popup-net-icon ' + iconType + '">' +
        '<i class="fas ' + iconClass + '"></i>' +
        '</span>' +
        '<div>' +
        '<div>' + label + '</div>' +
        '<div class="rdpms-popup-net-label-sub">' + subLabel + '</div>' +
        '</div>' +
        '</div>' +
        rdpmsNetBadge(st) +
        '</div>' +
        '</div>';
}

    /* ── Click-time alias resolution ─────────────────────────────────────
   The IoT / Network payloads are serialised into the cell's onclick when
   the row is PAINTED. If GetCardLineData had not landed yet at that
   moment, the raw AttributeName was baked into that string and no later
   fix can reach it. So resolve the alias again here, when the drawer
   actually opens, by mapping AttributeName -> AttributeAliasName from
   whatever CardLine rows are cached by then.

   Map is rebuilt when the set of cached sites changes. */
    var _rdpmsAliasByName = null;
    var _rdpmsAliasByNameStamp = null;

    window.rdpmsAliasForAttributeName = function (name) {
        var raw = $.trim(name || '');
        if (!raw) { return ''; }

        var store = window.__rdpmsCardLineRowsBySite || {};
        var stamp = Object.keys(store).sort().join(',') + '|' +
            ((window.json && $.isArray(window.json.mCardLines)) ? window.json.mCardLines.length : 0) + '|' +
            ((window.json && $.isArray(window.json.mAssetInfos)) ? window.json.mAssetInfos.length : 0) + '|' +
            Object.keys(store).map(function (sid) { return $.isArray(store[sid]) ? store[sid].length : 0; }).join(',');

        if (!_rdpmsAliasByName || _rdpmsAliasByNameStamp !== stamp) {
            var map = {};

            function _absorbAliasRows(rows) {
                if (!$.isArray(rows)) { return; }
                for (var i = 0; i < rows.length; i++) {
                    var r = rows[i];
                    if (!r) { continue; }
                    var al = $.trim(r.AttributeAliasName || '') ||
                        $.trim(r.AliasName || '');
                    if (!al) { continue; }
                    [r.AttributeName, r.AssetAttributeName].forEach(function (c) {
                        var an = $.trim(c || '');
                        if (an && !map[an]) { map[an] = al; }
                    });
                }
            }

            Object.keys(store).forEach(function (sid) {
                _absorbAliasRows(store[sid]);
            });
            /* Same reason as rdpmsBuildAliasIndex: the CardLine cache is cold
               and json.mCardLines has no alias column, so this map was empty
               and every IoT / Network chip fell back to the raw name. */
            _absorbAliasRows((window.json && window.json.mCardLines)
                ? window.json.mCardLines : []);
            _absorbAliasRows((window.json && window.json.mAssetInfos)
                ? window.json.mAssetInfos : []);
            _rdpmsAliasByName = map;
            _rdpmsAliasByNameStamp = stamp;
        }

        return _rdpmsAliasByName[raw] || '';
    };
    var rdpmsAliasForAttributeName = window.rdpmsAliasForAttributeName;

    /* Resolve the IoT / Network linked attributes NOW, from the lookup keys the
   cell carried, rather than trusting the names it serialised at paint time.
   paintDeviceCell / paintSplit run on the first WS tick - before
   GetCardLineData lands - and their repaint guard keys only on state|time,
   so whatever was baked in then is never refreshed. */
    function rdpmsResolveLazyAttributes(payload) {
        var lz = payload && payload.lazy;
        if (!lz || !$.isArray(lz.ids) || !lz.ids.length) { return null; }
        if (typeof nfRowLinkedAttributes !== 'function') { return null; }

        /* Always rebuild from the latest CardLine inventory at click time.
   Do not trust the attribute list baked into the first WS paint. */
        var out = [];

        /*
         * IoT lazy payload may have been created before CardLine finished loading.
         * Rebuild the ADC inventory from the CURRENT CardLine cache at click time.
         *
         * IoT = ADC based:
         *   include ADCNumber / ADCId even when ModemId is null.
         *
         * Network remains ModemId based and is not changed here.
         */
        if (lz.kind === 'adc' && typeof nfCardLineRowsFor === 'function') {
            var lazyRows = nfCardLineRowsFor(lz.siteId);
            var lazyIds = [];
            var lazySeen = {};

            /* Keep ids already stored in the payload. */
            for (var li = 0; li < lz.ids.length; li++) {
                var existingId = String(lz.ids[li] == null ? '' : lz.ids[li]).trim();
                if (!existingId || lazySeen[existingId]) { continue; }

                lazySeen[existingId] = true;
                lazyIds.push(existingId);
            }

            /* Add every ADC belonging to this asset from the current CardLine data. */
            if ($.isArray(lazyRows)) {
                for (var lr = 0; lr < lazyRows.length; lr++) {
                    var cl = lazyRows[lr];
                    if (!cl) { continue; }

                    if (lz.siteId && cl.SiteId != null &&
                        String(cl.SiteId).trim() !== String(lz.siteId).trim()) {
                        continue;
                    }

                    if (String(cl.AssetId == null ? '' : cl.AssetId).trim() !==
                        String(lz.assetId == null ? '' : lz.assetId).trim()) {
                        continue;
                    }

                    var adcNumber = cl.ADCNumber != null ? String(cl.ADCNumber).trim() : '';
                    var adcId = cl.ADCId != null ? String(cl.ADCId).trim() : '';

