                $('#spnNetWiredFaulty').removeData('nm-text').text(wiredFaulty);

                $('#spnNetWirelessOnline').removeData('nm-text').text(wirelessOnline);
                $('#spnNetWirelessFaulty').removeData('nm-text').text(wirelessFaulty);
            } else {
                /* Partial asset-type filter: let the filtered binders own IoT /
                   Network so unselected types (IPS) are excluded and stay
                   excluded across every frame. */
                if (typeof nfBindCombinedIotCounts === 'function') {
