           markup's literal 0 on screen. */
        if (!gotSensor && typeof window.rdpmsSensorUniverse === 'function') {
            var _su = window.rdpmsSensorUniverse();
            if (_su.length) {
                var _suT = 0, _suF = 0;
                for (var _sui = 0; _sui < _su.length; _sui++) {
                    var _sur = _su[_sui];
                    if (sel.restrict && _sur.siteId &&
                        sel.ids.indexOf(_sur.siteId) === -1) { continue; }
                    _suT++;
                    if (_sur.faulty) { _suF++; }
                }
                $('#spnTotalSensor').removeData('nm-text').text(_suT)
                    .removeAttr('title');
                $('#spnTotalFaultySensor').removeData('nm-text').text(_suF);

                console.log('[RDPMS tile/snapshot] Sensor from raw rows Total=' +
                    _suT + ' Faulty=' + _suF);
            } else {
                /* No summary frame AND no raw sensor rows (the sensor feed is
                   silent). Fall back to the on-page CardLine/AssetInfo inventory
                   so Total reflects the configured sensor count instead of the
                   markup's literal 0. Faulty stays 0 — there is no fault source
                   until the sensor feed delivers. */
                var _invTotal = rdpmsCountSensorsFromInventory(
                    (typeof nfSelectedAssetTypeIds === 'function')
                        ? nfSelectedAssetTypeIds() : null,
                    sel);
                if (_invTotal > 0) {
                    $('#spnTotalSensor').removeData('nm-text').text(_invTotal)
                        .removeAttr('title');
                    $('#spnTotalFaultySensor').removeData('nm-text').text(0);
                    console.log('[RDPMS tile/snapshot] Sensor from inventory Total=' +
                        _invTotal + ' Faulty=0 (no sensor feed)');
                }
            }
        }

        if (window.rdpmsNormalizeLive) { window.rdpmsNormalizeLive(); }
    }

    /* ── Per-row WebSocket device-health update ─────────────────────────────
     * Called from fnBindDeviceHealth every time a WS frame arrives.
     *
     * Matching rules (per product spec):
     *   Network cell (col 8) : nwDevices[i].deviceId  === row data-modemid
     *   IoT cell     (col 7) : iotDevices[i].deviceId === row data-a10id
     *                          (data-a10id is the CardLine ADCNumber)
     *
     * nfIdVariants() is used so MAC / numeric / lower-case variants all hit.
     * The IoT network-gate (nfIotGateForAdcs) is applied before painting.
     * ──────────────────────────────────────────────────────────────────── */
    /* ── Split a comma-separated data-attr into a clean id array ─────────
     * Row-level data-modemid / data-a10id can carry ONE id or a
     * comma-separated list. Both branches must work per the spec:
     *   Network row  : any ModemId in the list mapped to a WS nwDevice by
     *                  deviceId  → that row inherits the worst state
     *   IoT     row  : any ADCNumber in the list mapped to a WS iotDevice
     *                  by deviceId → same worst-state rule.
     * ──────────────────────────────────────────────────────────────────── */
    function nfSplitRowIds(raw) {
        if (raw == null || raw === '') { return []; }
        return String(raw)
            .split(',')
            .map(function (s) { return String(s).trim(); })
            .filter(Boolean);
    }
    /* Alias names of every CardLine attribute this row links through a given
       device, with the device verdict folded onto each one.
         kind 'adc'   -> match ADCNumber against the row's data-a10id list
         kind 'modem' -> match ModemId   against the row's data-modemid list
       Status is inherited: an attribute is only reachable through its A10 /
       modem, so when that link is down every attribute behind it is down. */
    /* ── Attribute alias lookup for the IoT / Network drawers ────────────
    window.json.mCardLines (Razor model) does NOT carry AttributeAliasName -
    only AttributeName. The alias IS present on the GetCardLineData rows
    cached in window.__rdpmsCardLineRowsBySite, and on json.mAssetInfos.

    Index both, under two keys so the join works whether or not the Razor
    rows expose AttributeId:
        'A|<assetId>|<attributeId>'
        'N|<assetId>|<attributeName>'

    Rebuilt whenever the cache object identity changes (new search). */
    var _nfAliasIdx = null;
    var _nfAliasIdxStamp = null;

    function nfAliasIndex() {
        var clSrc = window.__rdpmsCardLineRowsBySite || {};
        var aiSrc = (window.json && window.json.mAssetInfos) || [];

        /* Cheap change stamp: which sites are cached + how many infos. */
        var stamp = Object.keys(clSrc).join(',') + '#' + aiSrc.length;
        if (_nfAliasIdx && _nfAliasIdxStamp === stamp) { return _nfAliasIdx; }

        var idx = {};

        function add(assetId, attributeId, attributeName, alias) {
            alias = $.trim(alias || '');
            if (!alias || assetId == null) { return; }
            if (attributeId != null && attributeId !== '') {
                idx['A|' + String(assetId) + '|' + String(attributeId)] = alias;
            }
            var an = $.trim(attributeName || '');
            if (an) { idx['N|' + String(assetId) + '|' + an] = alias; }
        }

        Object.keys(clSrc).forEach(function (sid) {
            var rows = clSrc[sid];
            if (!$.isArray(rows)) { return; }
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                if (!r) { continue; }
                add(r.AssetId, r.AttributeId, r.AttributeName,
                    r.AttributeAliasName || r.AliasName);
            }
        });

        for (var k = 0; k < aiSrc.length; k++) {
            var ai = aiSrc[k];
            if (!ai) { continue; }
            add(ai.AssetId, ai.AttributeId, ai.AttributeName,
                ai.AttributeAliasName || ai.AliasName);
        }

        _nfAliasIdx = idx;
        _nfAliasIdxStamp = stamp;
        return idx;
    }

    /* ── Row source for the IoT / Network drawer attribute list ──────────
       window.json.mCardLines (Razor model) does NOT expose AttributeAliasName -
       only AttributeName. The GetCardLineData rows cached in
       window.__rdpmsCardLineRowsBySite DO carry it, and they carry every other
       field this function needs (SiteId, AssetId, ADCNumber, ModemId), so use
       them as the row source whenever the site is cached.

       Falls back to mCardLines when the fetch has not landed yet, and kicks
       off that fetch so the next open has aliases. */
    function nfCardLineRowsFor(siteId) {
        var key = String(parseInt(siteId, 10) > 0 ? parseInt(siteId, 10) : 0);
        var store = window.__rdpmsCardLineRowsBySite || {};

        /* Per-site bucket first. */
        var cached = store[key];
        if ($.isArray(cached) && cached.length) { return cached; }

        /* fetchSiteClusters() normalises "no station selected" to siteId 0, so
           the rows for every authorised station land under key '0'. Without
           this the per-site lookup above misses and the drawer silently falls
           back to mCardLines, which has no alias. */
        var all = store['0'];
        if ($.isArray(all) && all.length) { return all; }

        /* Nothing keyed usefully - scan whatever buckets exist rather than
           giving up, then warm the per-site cache for the next open. */
        var keys = Object.keys(store);
        for (var k = 0; k < keys.length; k++) {
            var rows = store[keys[k]];
            if ($.isArray(rows) && rows.length) { return rows; }
        }

        if (typeof nfFetchCardLineRows === 'function' && parseInt(key, 10) > 0) {
            try { nfFetchCardLineRows(key); } catch (e) { }
        }

        return (window.json && $.isArray(window.json.mCardLines))
            ? window.json.mCardLines : [];
    }

    /* Merge two attribute lists into one: unique by normalised name, and
   WORST-STATUS-WINS. The IoT drawer calls nfRowLinkedAttributes once per
   A10 and used to plain-concat the results, so one alias reachable through
   two ADCs was printed twice - once green, once red. That is what made the
   IoT i-button list unreadable. */
    function nfMergeAttrLists(base, extra) {
        base = base || [];
        extra = extra || [];

        /* Two-level normalisation:
           1. whitespace collapse   "VPT  110" -> "VPT 110"
           2. non-alphanumeric drop "VPT110"   -> "vpt110"
                                    "VPT 110"  -> "vpt110"
           Level 2 catches the real-world alias mismatch where one CardLine row
           reads "A VPT110 DC LOC R" (no space) and its counterpart reads
           "B VPT 110 DC LOC R" (space). Without this, nfMergeAttrLists saw
           "a/b vpt110 dc loc r" vs "a/b vpt 110 dc loc r" as two different
           names and rendered a duplicate chip in the Network drawer. */
        function normName(v) {
            return String(v == null ? '' : v).replace(/\s+/g, ' ').trim().toLowerCase();
        }
        function dedupeKey(v) {
            return normName(v).replace(/[^a-z0-9]/g, '');
        }

        for (var i = 0; i < extra.length; i++) {
            var a = extra[i];
            if (!a || !a.name) { continue; }
            var k = dedupeKey(a.name);
            if (!k) { continue; }

            var hit = null;
            for (var j = 0; j < base.length; j++) {
                if (base[j] && dedupeKey(base[j].name) === k) { hit = base[j]; break; }
            }

            if (!hit) { base.push(a); continue; }

            if (a.status === 'faulty') { hit.status = 'faulty'; }

            if (!hit.link) { hit.link = a.link || ''; }
            else if (a.link && String(hit.link).split(',').indexOf(String(a.link)) === -1) {
                hit.link = hit.link + ',' + a.link;
            }
        }
        return base;
    }

    function nfRowLinkedAttributes(siteId, assetId, ids, kind, state) {
        if (!ids || !ids.length) { return []; }

        /* Match ids the SAME way every other join in this file does - through
           nfIdVariants. CardLine ADCNumber / ModemId and the row's
           data-a10id / data-modemid do not always agree on leading zeros, case
           or an "XX-" prefix. The old exact-string compare therefore matched
           nothing, nfRowLinkedAttributes returned [], and the drawer skipped
           the whole "Linked attributes" section without a word. */
        function idKeys(v) {
            var list = (typeof nfIdVariants === 'function')
                ? nfIdVariants(v)
                : [String(v == null ? '' : v).trim()];
            var outk = [];
            for (var z = 0; z < list.length; z++) {
                if (list[z]) { outk.push(String(list[z]).toLowerCase()); }
            }
            return outk;
        }

        var want = {};
        for (var i = 0; i < ids.length; i++) {
            var vs = idKeys(ids[i]);
            for (var v = 0; v < vs.length; v++) { want[vs[v]] = true; }
        }

        var out = [], seen = {};
        var rows = nfCardLineRowsFor(siteId);
        if (!$.isArray(rows) || !rows.length) { return []; }

        for (var j = 0; j < rows.length; j++) {
            var cl = rows[j];
            if (!cl) { continue; }

            /* json.mCardLines is the fallback source until the GetCardLineData
               fetch lands, and those rows may carry no SiteId. Filtering on a
               missing SiteId discarded every one of them. Compare only when
               both sides actually have a value - the same guard rdpmsPmRoleMap
               already uses. */
            if (siteId && cl.SiteId != null &&
                String(cl.SiteId) !== String(siteId)) { continue; }
            if (String(cl.AssetId) !== String(assetId)) { continue; }

            var raw = '';
            var matched = false;

            if (kind === 'modem') {
                /* Network = ModemId only.
                   CardLine rows with ModemId = null must NOT appear in Network. */
                raw = cl.ModemId != null ? String(cl.ModemId).trim() : '';
                if (!raw) { continue; }

                var modemKeys = idKeys(raw);
                for (var q = 0; q < modemKeys.length && !matched; q++) {
                    if (want[modemKeys[q]]) { matched = true; }
                }
            }
            else {
                /* IoT = ADC based.
                   Match both ADCNumber and ADCId because the row/device mapping may
                   contain either representation. ModemId is intentionally ignored. */
                var adcNumber = cl.ADCNumber != null ? String(cl.ADCNumber).trim() : '';
                var adcId = cl.ADCId != null ? String(cl.ADCId).trim() : '';

                var adcNumberKeys = idKeys(adcNumber);
                var adcIdKeys = idKeys(adcId);

                for (var q1 = 0; q1 < adcNumberKeys.length && !matched; q1++) {
                    if (want[adcNumberKeys[q1]]) { matched = true; }
                }

                for (var q2 = 0; q2 < adcIdKeys.length && !matched; q2++) {
                    if (want[adcIdKeys[q2]]) { matched = true; }
                }

                if (adcNumber) {
                    raw = adcNumber;
                } else if (adcId) {
                    raw = adcId;
                }
            }

            if (!matched) { continue; }

            /* Alias is what we bind. Go through rdpmsCanonicalAlias so this
   list and the Sensor list resolve the SAME string for the same
   attribute — that identity is what makes the A/B pairing and the
   chip counts agree across the three drawers. AttributeName stays
   as the safety net: never leave nm empty, an empty name silently
   drops the row from the list. */
            var _clRaw = $.trim(cl.AttributeAliasName || '') ||
                $.trim(cl.AliasName || '') ||
                $.trim(cl.AttributeName || '') ||
                $.trim(cl.AssetAttributeName || '');

            var nm = '';
            var infos = (window.json && $.isArray(window.json.mAssetInfos)) ? window.json.mAssetInfos : [];

            var clAttrId = cl.AttributeId != null ? String(cl.AttributeId).trim() : '';
            var clLinkId = cl.AssetAttributeId != null ? String(cl.AssetAttributeId).trim() : '';

            for (var mi = 0; mi < infos.length; mi++) {
                var ai = infos[mi];
                if (!ai) { continue; }

                if (String(ai.AssetId == null ? '' : ai.AssetId).trim() !== String(assetId).trim()) {
                    continue;
                }

                if (siteId && ai.SiteId != null && String(ai.SiteId).trim() !== String(siteId).trim()) {
                    continue;
                }

                var aiAttrId = ai.AttributeId != null ? String(ai.AttributeId).trim() : '';
                var aiLinkId = ai.AssetAttributeId != null ? String(ai.AssetAttributeId).trim() : '';

                var idMatch =
                    (clAttrId && aiAttrId && clAttrId === aiAttrId) ||
                    (clLinkId && aiLinkId && clLinkId === aiLinkId) ||
                    (clAttrId && aiLinkId && clAttrId === aiLinkId) ||
                    (clLinkId && aiAttrId && clLinkId === aiAttrId);

                if (!idMatch) { continue; }

                nm = $.trim(ai.AttributeAliasName || '') ||
                    $.trim(ai.AliasName || '');

                if (nm) { break; }
            }

            if (!nm && window.rdpmsCanonicalAlias) {
                nm = window.rdpmsCanonicalAlias(
                    cl.AssetId,
                    cl.AttributeId,
                    cl.AssetAttributeId,
                    _clRaw
                );
            }

            nm = nm || _clRaw;

            if (!nm) { continue; }

            var attrKey =
                String(cl.AssetId || '') + '|' +
                String(cl.AttributeId != null ? cl.AttributeId : '') + '|' +
                String(cl.AssetAttributeId != null ? cl.AssetAttributeId : '') + '|' +
                String(raw || '');

            if (seen[attrKey]) { continue; }
            seen[attrKey] = true;

            /* attributeId / linkId must ride along: rdpmsCollapsePmAttributes
               resolves the CardLine Role by id first and only falls back to
               the name. Without them every IoT/Network entry resolved its
               Role by name alone, and any alias whitespace difference between
               the two ends broke the pairing. */
            out.push({
                name: nm,
                attributeId: (cl.AttributeId != null) ? String(cl.AttributeId).trim() : '',
                linkId: (cl.AssetAttributeId != null) ? String(cl.AssetAttributeId).trim() : '',
                link: raw,
                status: (state === 'masked') ? 'masked'
                    : ((state === 'faulty') ? 'faulty' : 'healthy')
            });
        }

        /* DO NOT call rdpmsCollapsePmAttributes here. This function is called
   once per ADC / per modem in a loop. Each single call only sees ONE
   end's attributes, so the collapse treats every A-end entry as a
   single-end group and renames "A IPT N" -> "A/B IPT N". The next
   loop iteration does the same to "B IPT N" -> "A/B IPT N", and
   nfMergeAttrLists deduplicates those two into one chip. Result:
   12 separate A+B chips wrongly collapse to 6 merged chips.
   The caller (IoT/Network paint path and rdpmsResolveLazyAttributes)
   runs the collapse ONCE after all ids are merged. */
        return out;
    }
    /* Robust healthy/faulty for a WS device entry.
       "Healthy" (server) or full-mask flagValue → healthy; anything else
       (Faulty, Partial, Degraded, Unknown, missing) → faulty. This matches
       the socket module's `effectiveStatus` (Partial folds to Faulty for
       both NW and IoT). Called separately for NW and IoT so each keeps its
       own rule if the socket ever diverges. */
    function nfWsDeviceIsHealthy(dev) {
        if (!dev) { return false; }
        var st = String(dev.effectiveStatus || dev.status || '').toLowerCase();
        /* Accept the groupHealth vocabulary ("ok" for modems/clusters, "up"
           for A10s) alongside the per-row "Healthy", so a device the feed
           reports as fine is never painted faulty on wording alone. */
        return st === 'healthy' || st === 'ok' || st === 'up' || st === 'online';
    }

    /* Format a device's last-seen timestamp, only for a faulty state. */
    function nfWsDeviceTimeText(dev, isHealthy) {
        if (isHealthy) { return ''; }
        var t = dev.lastChange || dev.updateTime || '';
        if (!t) { return ''; }
        return (typeof fnFormatOutdoorDeviceTime === 'function')
            ? fnFormatOutdoorDeviceTime(t)
            : String(t);
    }

    /* Build a Network lookup: variant → {healthy, time, deviceId}.
       Uses the socket's effectiveStatus (Partial/Degraded → Faulty).
       Faulty entry wins over healthy under the same variant key so a row
       whose id lookup hits multiple channels always sees the worst state. */
    function nfBuildNwLookup(devices) {
        var map = {};
        if (!$.isArray(devices)) { return map; }
        devices.forEach(function (dev) {
            if (!dev || dev.deviceId == null || dev.deviceId === '') { return; }
            var healthy = nfWsDeviceIsHealthy(dev);
            var entry = {
                healthy: healthy,
                time: nfWsDeviceTimeText(dev, healthy),
                deviceId: String(dev.deviceId)
            };
            nfIdVariants(dev.deviceId).forEach(function (v) {
                var existing = map[v];
                if (!existing || (existing.healthy && !entry.healthy)) {
                    map[v] = entry;
                }
            });
        });
        return map;
    }

    /* Build an IoT lookup: variant → {flagValue, time, deviceId}.
       We deliberately carry the RAW flagValue here rather than the socket's
       effectiveStatus, because the socket's IoT gate uses the site-wide
       Network flag whereas the row-level rule needs the per-cluster
       Network gate (nfIotGateForAdcs). The row logic below applies the
       spec directly:
           gate NOT reachable (net top-3 bits ∉ {010,011,101,110,111})
                                → N/A
           gate reachable, iot.flagValue == 0     → Faulty
           gate reachable, iot.flagValue  > 0     → Healthy
       For a variant collision the entry whose flagValue is 0 (the "worse"
       reading) wins so the worst-state semantics still apply.               */
    function nfBuildIotLookup(devices) {
        var map = {};
        if (!$.isArray(devices)) { return map; }
        devices.forEach(function (dev) {
            if (!dev || dev.deviceId == null || dev.deviceId === '') { return; }
            var fv = (typeof dev.flagValue === 'number' && isFinite(dev.flagValue))
                ? dev.flagValue : null;
            var entry = {
                flagValue: fv,
                /* time is only rendered when the row paints Faulty */
                time: nfWsDeviceTimeText(dev, fv !== null && fv > 0),
                deviceId: String(dev.deviceId)
            };
            nfIdVariants(dev.deviceId).forEach(function (v) {
                var existing = map[v];
                /* fv === 0 (worst) beats healthy or null. */
                if (!existing) { map[v] = entry; return; }
                if (existing.flagValue !== 0 && entry.flagValue === 0) {
                    map[v] = entry;
                }
            });
        });
        return map;
    }

    /* Network row worst-state:
         'faulty'  → at least one modem id matched a faulty NW device
         'healthy' → at least one matched and every match is healthy
         null      → no match (leave the cell alone). */
    function nfNwRowWorstState(ids, lookup) {
        var matched = null;
        for (var i = 0; i < ids.length; i++) {
            var variants = nfIdVariants(ids[i]);
            for (var v = 0; v < variants.length; v++) {
                var e = lookup[variants[v]];
                if (!e) { continue; }
                if (!matched) { matched = e; }
                if (!e.healthy) {
                    return { state: 'faulty', time: e.time, deviceId: e.deviceId };
                }
                break;
            }
        }
        if (!matched) { return null; }
        return { state: 'healthy', time: '', deviceId: matched.deviceId };
    }

    /* IoT row worst-state per spec (network gate already checked by caller):
         'faulty'  → at least one matched IoT device has flagValue === 0
         'healthy' → at least one matched and every match has flagValue > 0
         null      → no id matched any WS IoT device (leave cell alone).
        The network gate is applied by the caller / by
       nfBuildA10StateFromChannels: a cluster whose network is down reads
       Healthy, never N/A. This fn only decides Healthy vs Faulty using the
       raw IoT flagValue rule. */
    function nfIotRowWorstState(ids, lookup) {
        var matched = null;
        for (var i = 0; i < ids.length; i++) {
            var variants = nfIdVariants(ids[i]);
            for (var v = 0; v < variants.length; v++) {
                var e = lookup[variants[v]];
                if (!e) { continue; }
                if (!matched) { matched = e; }
                /* Per spec: iot flagValue == 0 → Faulty, > 0 → Healthy.
                   flagValue === null means we have no reading for that
                   device — treat as no-match so nmApply can fall back. */
                if (e.flagValue === 0) {
                    return { state: 'faulty', time: e.time, deviceId: e.deviceId };
                }
                if (typeof e.flagValue === 'number' && e.flagValue > 0) {
                    break; /* healthy match for this id, move on */
                }
            }
        }
        if (!matched) { return null; }
        if (typeof matched.flagValue === 'number' && matched.flagValue > 0) {
            return { state: 'healthy', time: '', deviceId: matched.deviceId };
        }
        /* Match found but flagValue was null → no verdict. */
        return null;
    }

    /* Optional CardLine bridge — resolves a WS deviceId against the
       CardLine table already loaded on `json.mCardLines`. Used only for
       diagnostic logging so a mismatched deviceId format shows up in
       DevTools as "seen in WS but not in CardLine" rather than silently. */
    function nfCardLineMatchInfo(deviceId, kind /* 'modem' | 'adc' */) {
        if (!window.json || !$.isArray(window.json.mCardLines) || !deviceId) {
            return null;
        }
        var needle = nfIdVariants(deviceId);
        var lines = window.json.mCardLines;
        for (var i = 0; i < lines.length; i++) {
            var cl = lines[i]; if (!cl) { continue; }
            var haystack = kind === 'modem'
                ? nfIdVariants(cl.ModemId || '')
                : nfIdVariants(cl.ADCNumber != null ? cl.ADCNumber : '');
            for (var a = 0; a < needle.length; a++) {
                if (needle[a] && haystack.indexOf(needle[a]) !== -1) {
                    return {
                        siteId: cl.SiteId,
                        clusterId: cl.ClusterId,
                        modemId: cl.ModemId,
                        adcNumber: cl.ADCNumber
                    };
                }
            }
        }
        return null;
    }

    /* ── Per-row WebSocket device-health update ─────────────────────────────
     * Called from fnBindDeviceHealth every time a WS frame arrives.
     *
     * Bridge:
     *   The row's data-modemid was populated (server-side) from CardLine's
     *   ModemId column and data-a10id from CardLine's ADCNumber column.
     *   So matching a WS device against the row IS the CardLine mapping:
     *
     *     Network row  : nwDevice.deviceId  ≡ CardLine.ModemId    ≡ data-modemid
     *     IoT     row  : iotDevice.deviceId ≡ CardLine.ADCNumber  ≡ data-a10id
     *
     *   nfIdVariants() absorbs common format drift (MAC casing, leading
     *   zeros, "<prefix>-<id>" composites).
     *
     * State per row:
     *   1) Split the row's ids on comma (asset may span multiple modems /
     *      several A10s) → list [id1, id2, ...]
     *   2) Look each id up in the WS device map
     *   3) Take the WORST state (any faulty ⇒ row faulty, else healthy)
     *   4) If NO id matched → do NOT touch the cell (nmApply owns it)
     *
     * IoT extra rule:
     *   Apply the row-level network gate (nfIotGateForAdcs). When that
     *   gate says the cluster's network is DOWN, the IoT cell reads N/A
     *   (gray) regardless of the WS IoT state — the reading isn't
     *   meaningful when the pipe carrying it is dark.
     * ──────────────────────────────────────────────────────────────────── */
    function fnApplyWsDeviceHealthToRows(siteId, model) {
        var paintCell = window.__rdpmsPaintDeviceCell;
        var paintSplit = window.__rdpmsPaintNetworkSplitCell;
        if (typeof paintCell !== 'function') { return; }
        if (!model) { return; }

        var sid = String(siteId != null ? siteId : '').trim();

        var nwLookup = nfBuildNwLookup(model.nw && model.nw.devices);
        /* Shared with the network drawer builder so it can resolve per-modem
           health instead of applying one row-wide state to every attribute. */
        window.__rdpmsNwLookup = nwLookup;
        var iotLookup = nfBuildIotLookup(model.iot && model.iot.devices);
        var iotHealth = nfBuildIotHealth(model);   /* cardLineId-resolved A10 health */

        /* For the clean IoT faulty log: cardLineId keyed by site|asset|adc, so a
           row painted Faulty can report the exact cardLineId it is showing. */
        /* CardLine is one row PER PIN (AssetId + AttributeId + Pin), so a single
    (site, asset, ADCNumber) owns 1..n Ids and the WS feed names only one of
    them. A scalar map loses that match. Keep all Ids, and also index by ADC
    alone - A10 health is a property of the ADC device, not of one pin. */
        var clidsBySiteAssetAdc = {};   // '155|42867|11' -> [111684, 111688, 111692]
        var clidsBySiteAdc = {};   // '155|11'       -> [ ...every asset's pins... ]
        if (window.json && $.isArray(window.json.mCardLines)) {
            window.json.mCardLines.forEach(function (cl) {
                if (!cl || cl.Id == null || cl.ADCNumber == null) return;
                var kA = String(cl.SiteId) + '|' + String(cl.AssetId) + '|' + String(cl.ADCNumber);
                var kD = String(cl.SiteId) + '|' + String(cl.ADCNumber);
                (clidsBySiteAssetAdc[kA] = clidsBySiteAssetAdc[kA] || []).push(cl.Id);
                (clidsBySiteAdc[kD] = clidsBySiteAdc[kD] || []).push(cl.Id);
            });
        }
        var listFaulty = [];   /* cardLineIds actually shown Faulty in the LIST */

        /* Diagnostic — run once per session so DevTools clearly shows whether
           WS device IDs actually land in CardLine. Silent thereafter. */
        if (!window.__rdpmsWsRowMatchDiagLogged) {
            window.__rdpmsWsRowMatchDiagLogged = true;
            var nwSample = ($.isArray(model.nw && model.nw.devices)
                ? model.nw.devices : []).slice(0, 3).map(function (d) {
                    return {
                        deviceId: d && d.deviceId,
                        status: d && (d.effectiveStatus || d.status),
                        cardLineMatch: nfCardLineMatchInfo(d && d.deviceId, 'modem')
                    };
                });
            var iotSample = ($.isArray(model.iot && model.iot.devices)
                ? model.iot.devices : []).slice(0, 3).map(function (d) {
                    return {
                        deviceId: d && d.deviceId,
                        effective: d && d.effectiveStatus,
                        cardLineMatch: nfCardLineMatchInfo(d && d.deviceId, 'adc')
                    };
                });
            console.log('[RDPMS row-match diag] NW WS ↔ CardLine.ModemId', nwSample);
            console.log('[RDPMS row-match diag] IOT WS ↔ CardLine.ADCNumber', iotSample);
        }

        var rowsUpdated = 0, netFaultyPainted = 0, iotFaultyPainted = 0;

        $('#tbodyRDPMSHealthLive tr[data-siteid]').each(function () {
            var $row = $(this);
            var rSite = String($row.data('siteid') || '').trim();
            if (rSite !== sid) { return; }

            /* ─── Network cell (col index 8) ─── */
            /* The Set/Reset feed carries the medium in `channel`, so the raw
               channel store (fnApplyDeviceHealthBatch) owns this cell whenever
               it holds Modem rows — the two painters must never both write it.
               The block below is the legacy path for a model that still only
               offers a rolled-up per-device verdict; with no medium available
               it paints the SAME state into both legs rather than inventing a
               split it cannot actually see. */
            var modemIds = nfSplitRowIds($row.data('modemid'));
            if (!nfHasModemChannelRows() && typeof paintSplit === 'function') {
                if (modemIds.length) {
                    var netRes = nfNwRowWorstState(modemIds, nwLookup);
                    if (netRes) {
                        paintSplit($row.find('td').eq(8), {
                            wired: { state: netRes.state, time: netRes.time },
                            wireless: { state: netRes.state, time: netRes.time }
                        });
                        if (netRes.state === 'faulty') { netFaultyPainted++; }
                        rowsUpdated++;
                    }
                } else {
                    /* No data-modemid at all -> this asset has no modem (e.g. IPS,
                       ModemId null in CardLine). Nothing to bind; paint an explicit
                       N/A so the cell reads intentionally instead of looking blank
                       / unbound. A keyed row with no WS match is left alone above. */
                    paintSplit($row.find('td').eq(8), {
                        wired: { state: 'na', time: '' },
                        wireless: { state: 'na', time: '' }
                    });
                }
            }

            /* IoT cell (col index 7) — cardLineId-EXACT (Option B).
               Resolve THIS row's own cardLineId per ADC via site|asset|adc,
               then read its state from the WS per-pin map (iotHealth.byClid).
               A down A10 therefore paints only the asset/pin the feed named,
               NOT every sibling asset that merely shares the ADCNumber (that
               was the fan-out). Worst-of across the row's pins:
                 any pin DOWN  -> Faulty
                 else any pin present & UP -> Healthy
                 no pin named by the feed  -> leave (nmApply owns it).
               Trade-off: a sibling asset sharing a down A10's ADC is NOT marked
               here (the WS carries no cardLineId for it); it falls to the poll. */
            var a10Ids = nfSplitRowIds($row.data('a10id'));
            if (a10Ids.length) {
                var rAsset = String($row.data('assetid') || '').trim();
                var iotState = null;   /* null = none of this row's pins in feed */
                var iotTime = '';
                var rowFaultyClids = [];

                /* Channel-store path: applies the network gate (both media
                   down -> Healthy) and the all-channels-set fault rule, and
                   carries the earliest setTime for display under the badge. */
                /* A10 health is a property of the ADC DEVICE, not of one CardLine pin. The
   feed carries a single representative cardLineId per A10 channel row, so
   matching on it painted only the one asset/pin the backend happened to
   name and left every sibling blank. Both builders already expose an
   ADC-keyed map whose key IS the value the row carries in data-a10id.
   The false-fault guard is nfBuildClusterNetGate() inside
   nfBuildA10StateFromChannels(), not the cardLineId narrowing. */
                var a10State = nfHasA10Verdicts()
                    ? nfBuildA10StateFromChannels()
                    : null;

                for (var ai = 0; ai < a10Ids.length; ai++) {
                    var adc = String(a10Ids[ai]).trim();
                    if (!adc) { continue; }

                    /* Only evaluate this ADC if it actually serves this asset.
                       clidsBySiteAssetAdc key = siteId|assetId|ADCNumber.
                       If this ADC has no CardLine pin for this asset, skip it —
                       it belongs to a sibling asset on the same cluster and must
                       not poison this row's verdict. */
                    var assetAdcClids = clidsBySiteAssetAdc[rSite + '|' + rAsset + '|' + adc] || [];
                    if (!assetAdcClids.length) { continue; }

                    var down;
                    if (a10State) {
                        var ent = a10State.bySiteAdc[rSite + '|' + adc];
                        if (!ent) { continue; }                   /* feed never named this ADC */
                        if (ent.masked) {                         /* groupHealth masked -> N/A */
                            if (!iotState) { iotState = 'masked'; }
                            continue;
                        }
                        down = !!ent.faulty;
                        if (down && ent.time && !iotTime) { iotTime = ent.time; }
                    } else {
                        var b = iotHealth.byAdc[adc];             /* boolean - false is VALID */
                        if (b === undefined) { continue; }
                        down = (b === true);
                    }

                    if (down) {
                        iotState = 'faulty';
                        for (var ci = 0; ci < assetAdcClids.length; ci++) { rowFaultyClids.push(assetAdcClids[ci]); }
                    } else if (iotState !== 'faulty') {
                        iotState = 'healthy';
                    }
                }

                if (iotState) {
                    paintCell($row.find('td').eq(7), iotState,
                        iotState === 'faulty' ? iotTime : '');
                    if (iotState === 'faulty') {
                        iotFaultyPainted++;
                        rowFaultyClids.forEach(function (c) {
                            listFaulty.push({ cardLineId: c, site: rSite, asset: rAsset });
                        });
                    }
                    rowsUpdated++;
                }
                /* iotState null -> no pin of this asset was in the feed -> leave */
            } else {
                /* No data-a10id -> this asset has no A10/ADC (e.g. IPS rows with
                   ADCNumber null in CardLine). Paint N/A rather than blank. */
                paintCell($row.find('td').eq(7), 'na', '');
            }
        });

        /* TILE basis: distinct cardLineId of every DOWN A10 in the model
           (this is what the IoT tile Faulty count is built from). */
        var _tileSet = {}, _iotDevs = (model.iot && model.iot.devices) || [];
        _iotDevs.forEach(function (d) {
            if (!d || d.flagValue !== 0) { return; }
            _tileSet[(d.cardLineId != null) ? d.cardLineId : ('adc:' + d.deviceId)] = true;
        });
        /* Normalise BOTH sides to String so the diff is truthful (Object.keys
           yields strings; cl.Id is numeric — mixing them made every id look
           mismatched). */
        var _tileIds = Object.keys(_tileSet).map(String).sort();
        var _listIds = [];
        listFaulty.forEach(function (x) {
            var k = (x.cardLineId != null) ? String(x.cardLineId)
                : ('adc:' + x.site + '/' + x.asset + '/' + x.adc);
            if (_listIds.indexOf(k) === -1) { _listIds.push(k); }
        });
        _listIds.sort();

        /* ONE clean line: cardLineIds shown Faulty in the LIST vs the TILE.
           With Option B these are 1:1 (each down pin paints only its own row). */
        console.log('[RDPMS IoT faulty] site ' + sid +
            ' | TILE cardLineIds (' + _tileIds.length + '): [' + _tileIds.join(', ') + ']' +
            ' | LIST cardLineIds (' + _listIds.length + '): [' + _listIds.join(', ') + ']');

        var _inListNotTile = _listIds.filter(function (x) { return _tileIds.indexOf(x) === -1; });
        var _inTileNotList = _tileIds.filter(function (x) { return _listIds.indexOf(x) === -1; });
        if (_inListNotTile.length || _inTileNotList.length) {
            console.warn('[RDPMS IoT faulty] MISMATCH | in LIST not TILE:', _inListNotTile,
                '| in TILE not LIST:', _inTileNotList);
        } else {
            console.log('[RDPMS IoT faulty] LIST == TILE (' + _tileIds.length + ' cardLineIds) OK');
        }

        if (window.rdpmsNormalizeLive) { window.rdpmsNormalizeLive(); }
    }

    window.fnBindDeviceHealth = function (siteId, model) {
        if (!model) {
            return;
        }

        /* Bridge: pull the socket's raw per-channel rows (A10_TCP/OFC/MQTT,
           OFC_*, 4G_*) into the channel store the gate logic reads. Without
           this the raw setTime/resetTime never reaches nfBuildA10StateFromChannels
           and the network gate cannot run. */
        if (window.RdpmsHealthLive &&
            typeof window.RdpmsHealthLive.getRawRows === 'function') {
            var raw = window.RdpmsHealthLive.getRawRows(siteId);
            if (raw) {
                window.__rdpmsChannelRows = window.__rdpmsChannelRows || {};
                for (var rk in raw) {
                    if (raw.hasOwnProperty(rk) && raw[rk]) {
                        window.__rdpmsChannelRows[nfChannelKey(raw[rk])] = raw[rk];
                    }
                }
                fnApplyChannelRowsToNetworkCells(String(siteId));
                if (typeof nfApplyGatewayChannelsToRows === 'function') {
                    nfApplyGatewayChannelsToRows();
                }
                if (typeof window.fnApplyChannelRowsToIotCells === 'function') {
                    window.fnApplyChannelRowsToIotCells(String(siteId));
                }
                if (typeof window.fnApplyChannelRowsToPictorial === 'function') {
                    window.fnApplyChannelRowsToPictorial();
                }
                if (typeof window.rdpmsReconcileSensorUndetermined === 'function') {
                    window.rdpmsReconcileSensorUndetermined(String(siteId));
                }
            }
        }

        /*
         * IoT:
         * No Wired/Wireless bifurcation.
         *
         * IoT Partial/Degraded devices are counted as Faulty in the
         * current two-state Healthy/Faulty dashboard.
         */
        if (model.iot) {
            /* Header IoT faulty = distinct DOWN A10s, resolved via the channel
               store with the network gate applied (nfCountIotFaulty). Total is
               the CardLine universe, so header == grid. */
            _iotFaultyBySite[String(siteId)] =
                nfCountIotFaulty(siteId, model);
            nfBindCombinedIotCounts();

            /* Mark the socket as the authoritative IoT source so the REST poll
               in nmApply() stops overwriting these counts (see that guard). */
            window.__rdpmsIotWsAt = Date.now();
        }

        /*
         * Network: total from CardLine (distinct ClusterId, asset-type aware);
         * wired/wireless verdict per cluster from the WS flag. Async — the cells
         * update when the CardLine fetch resolves.
         */
        if (model.nw) {
            window.__rdpmsNetWsAt = Date.now();

            computeNetworkCounts(siteId, model)
                .then(function (networkCounts) {
                    /*
                     * Store this station's latest result. Do not directly paint only
                     * this station because another selected station may already have
                     * contributed its own counts.
                     */
                    /* Forced-health sites (161 / 167): report every network
                       cluster online so the combined header count never shows
                       a faulty modem for them, even alongside other stations. */
                    if (window.rdpmsIsForcedSite &&
                        window.rdpmsIsForcedSite(siteId) &&
                        networkCounts) {
                        networkCounts.wiredFaulty = 0;
                        networkCounts.wirelessFaulty = 0;
                        networkCounts.wiredOnline = networkCounts.total;
                        networkCounts.wirelessOnline = networkCounts.total;
                        networkCounts.unknown = 0;
                    }

                    _networkCountsBySite[
                        String(siteId)
                    ] = networkCounts;

                    nfBindCombinedNetworkCounts();

                    console.log(
                        '[DeviceHealth Network Count]',
                        {
                            siteId: siteId,
                            cardLineTotal:
                                networkCounts.total,

                            wiredHealthy:
                                networkCounts.wiredOnline,

                            wiredFaulty:
                                networkCounts.wiredFaulty,

                            wirelessHealthy:
                                networkCounts.wirelessOnline,

                            wirelessFaulty:
                                networkCounts.wirelessFaulty,

                            unmatchedClusters:
                                networkCounts.unknown
                        }
                    );
                })
                .fail(function () {
                    /*
                     * Keep the last valid WebSocket-derived count when CardLine API
                     * temporarily fails. Do not replace it with zeros.
                     */
                    console.warn(
                        '[DeviceHealth Network Count] CardLine fetch failed for SiteId:',
                        siteId
                    );
                });
        }

        /*
         * Gateway remains handled by the Gateway-specific binding.
         */
        if (
            model.gw &&
            typeof window.applyGatewayHealthModel === 'function'
        ) {
            window.applyGatewayHealthModel(
                siteId,
                model.gw,
                model.updateTime
            );
        }

        /* ── Per-row table-cell update from WS device list ──────────────────
         * Paints Network (col 8) and IoT (col 7) cells for every table row
         * belonging to this site, matched by:
         *   Network : nwDevices[i].deviceId === row data-modemid
         *   IoT     : iotDevices[i].deviceId === row data-a10id (ADCNumber)
         * This mirrors the header-count matching already done above and ensures
         * that the per-row badges react immediately when a WS frame arrives,
         * without waiting for the next REST poll in nmApply().
         * ─────────────────────────────────────────────────────────────────── */
        fnApplyWsDeviceHealthToRows(siteId, model);

        /* (verbose per-frame model dump removed — see the clean
   [RDPMS IoT faulty] / [RDPMS tile] lines instead) */

        if (window.rdpmsNormalizeLive) { window.rdpmsNormalizeLive(); }

        /* IoT / Network cells just repainted with fresh onclick payloads —
           re-render the detail popup if it is open on one of them. */
        if (typeof window.rdpmsRefreshOpenDrawer === 'function') {
            window.rdpmsRefreshOpenDrawer();
        }
    };

    /* ══════════════════════════════════════════════════════════════════
       FORCED-HEALTH SITE OVERRIDE (RDPMS Health Live)

       Business rule: stations 161 and 167 must always present as fully
       healthy on this screen — every per-row Network / IoT / Sensor /
       Gateway cell reads Healthy, and the summary header counters show
       zero faulty (100% availability), regardless of what the live
       Modem/A10/sensor sources report.

       This is enforced in two layers:
         1. Source-level coercion (sensor faults filtered, network per-site
            faulty zeroed, per-row cells forced healthy in paintDeviceCell).
            This keeps the combined counters correct even when a forced site
            is viewed alongside ordinary stations.
         2. This normalizer, run after every UI update as a backstop, which
            repaints any forced-site row/pictorial cell to Healthy and — when
            EVERY displayed station is a forced site — pins the header faulty
            counters to zero.

       To change the list, edit RDPMS_FORCE_HEALTHY_SITES below.
       ══════════════════════════════════════════════════════════════════ */
    /* Forced-health override removed: Sakun (161) and Gahlot (167) now report
       their real live Network / IoT / Sensor / Gateway state like every other
       station. Leaving the map empty makes rdpmsIsForcedSite() return false
       everywhere, so all the coercion below (per-row repaint, header pinning)
       becomes an inert no-op without having to unpick each call site. */
    var RDPMS_FORCE_HEALTHY_SITES = {};

    window.rdpmsIsForcedSite = function (id) {
        var n = parseInt(id, 10);
        return n > 0 && RDPMS_FORCE_HEALTHY_SITES[String(n)] === true;
    };

    /* True only when every station currently shown in the table is forced.
       Used to decide whether the shared header counters can be pinned to
       "all healthy" without hiding a real fault on some other station. */
    window.rdpmsDisplayedSitesAllForced = function () {
        var rows = $('#tbodyRDPMSHealthLive tr[data-siteid]');
        var seen = false, all = true;
        rows.each(function () {
            var s = $(this).data('siteid');
            if (s == null || s === '') { return; }
            seen = true;
            if (!window.rdpmsIsForcedSite(s)) { all = false; return false; }
        });
        return seen && all;
    };

    window.rdpmsNormalizeLive = function () {
        try {
            var HEALTHY = '<span class="badge badge-success">Healthy</span>';

            /* ── Per-row Network (col 8) and IoT (col 7) cells ───────────── */
            $('#tbodyRDPMSHealthLive tr[data-siteid]').each(function () {
                var $r = $(this);
                if (!window.rdpmsIsForcedSite($r.data('siteid'))) { return; }

                /* Sensor continuation rows only ever represent extra faults,
                   which a forced site cannot have — drop them. */
                if ($r.hasClass('sensor-clone-row')) { $r.remove(); return; }

                var $tds = $r.children('td');

                [7, 8].forEach(function (i) {
                    var $c = $tds.eq(i);
                    if (!$c.length) { return; }
                    var $sp = $c.find('span').first();
                    if ($sp.length && $sp.html() !== HEALTHY) {
                        $sp.html(HEALTHY);
                    }
                    /* Match paintDeviceCell's change-detection cache so its
                       1-second tick treats the cell as already Healthy. */
                    $c.data('nm-state', 'healthy|');
                });
            });

            /* ── Pictorial cards (gateway + modem) ───────────────────────── */
            $('.pic-gw-card, .pic-modem-card').each(function () {
                var $c = $(this);
                if (!window.rdpmsIsForcedSite($c.data('siteid'))) { return; }

                $c.find('.pic-dot--faulty')
                    .removeClass('pic-dot--faulty')
                    .addClass('pic-dot--healthy');

                /* Value pills that read "Faulty" → Healthy (outdoor cards). */
                $c.find('.pic-val--faulty')
                    .removeClass('pic-val--faulty')
                    .addClass('pic-val--healthy')
                    .removeData('nm-state')
                    .text('Healthy');

                $c.data('pic-sig', '');   /* let a future real change repaint */
            });

            /* ── Header counters: only safe to pin to zero-faulty when the
                 whole table belongs to forced sites (otherwise a genuine
                 fault on another selected station would be masked). ──────── */
            if (window.rdpmsDisplayedSitesAllForced()) {
                var pinFaultyZero = function (sel) {
                    var $s = $(sel);
                    if ($s.length) { $s.removeData('nm-text').text('0'); }
                };

                /* Real device totals for the forced-site rows, taken straight
                   from the table's data-a10id (IoT / ADCNumber) and
                   data-modemid (Network / cluster) attributes. This is
                   independent of the CardLine-derived header math, which shows
                   0 online when CardLine returns no ClusterId for the station
                   (the cause of the empty IoT/Network "online" counts). */
                var distinctForcedRowIds = function (attr) {
                    var set = {};
                    $('#tbodyRDPMSHealthLive tr[data-siteid]').each(function () {
                        var $r = $(this);
                        if (!window.rdpmsIsForcedSite($r.data('siteid'))) { return; }
                        var raw = $r.data(attr);
                        if (raw == null || raw === '') { return; }
                        String(raw).split(',').forEach(function (x) {
                            x = String(x).trim();
                            if (x) { set[x] = true; }
                        });
                    });
                    return Object.keys(set).length;
                };

                pinFaultyZero('#spnTotalFaultySensor');
                pinFaultyZero('#spnTotalFaultyGatewaySite');

                /* IoT: all online. Prefer the real device count from the rows;
                   fall back to the existing healthy+faulty if the rows carry no
                   ADCNumber. */
                var $iotH = $('#spnIoTHealthy'), $iotF = $('#spnIoTFaulty');
                if ($iotH.length && $iotF.length) {
                    var iotTotal = distinctForcedRowIds('a10id');
                    /* Only pin when the table gave an authoritative device count.
                       The old fallback read $iotH/$iotF back and summed them,
                       so every tick rewrote Healthy as Healthy + Faulty. A tile
                       must never be an input to the sum that fills it. */
                    if (iotTotal > 0) {
                        $iotH.text(iotTotal);
                        $iotF.text('0');
                    }
                }

                /* Network: every cluster's wired and wireless channel online. */
                var netTotal = distinctForcedRowIds('modemid');
                var pinChannel = function (onlineSel, faultySel) {
                    var $on = $(onlineSel), $fa = $(faultySel);
                    if (!$on.length || !$fa.length) { return; }
                    if (!(netTotal > 0)) { return; }   /* no self-referential math */
                    $on.text(netTotal);
                    $fa.text('0');
                };
                pinChannel('#spnNetWiredOnline', '#spnNetWiredFaulty');
                pinChannel('#spnNetWirelessOnline', '#spnNetWirelessFaulty');
            }
        } catch (e) {
            /* Normalizer must never break the live screen. */
            if (window.console && console.warn) {
                console.warn('[RDPMS forced-health normalize] skipped:', e);
            }
        }
    };

    /* Backstop tick: the 1-second freshness loop can repaint cells between
       explicit normalize calls, so run once per second as well. Also run
       shortly after load so the very first render is normalized. */
    $(function () {
        /* Warm the CardLine cache for every selected station up front. The
       IoT / Network drawers read AttributeAliasName from these rows, and
       without this the first drawer opened after a search falls back to
       the raw AttributeName because the fetch had not run yet. */
        /* Point machine end configuration (IsHalfPointMachine). Needed before
   the header sensor Total is meaningful for point machines, and before
   the first i-button drawer is opened. */
        if (typeof window.rdpmsFetchPointMachineFlags === 'function') {
            try { window.rdpmsFetchPointMachineFlags(); } catch (e) { }
        }

        if (typeof nfFetchCardLineRows === 'function') {
            var _sids = $('.cb-site:checked').map(function () {
                var v = parseInt($(this).val(), 10);
                return v > 0 ? v : null;
            }).get();

            if (!_sids.length) { _sids = [0]; }   /* 0 = all authorised */
            for (var _s = 0; _s < _sids.length; _s++) {
                try { nfFetchCardLineRows(_sids[_s]); } catch (e) { }
            }
        }
        /* Show the IoT (A10) total immediately from the CardLine inventory so
           the header reads Total/Healthy before the first WS frame; faulty stays
                  0 until a frame arrives. Network total fills on nmApply's first tick;
           Gateway total is WS-driven (groupHealth / deviceHealth feed). */
        if (typeof nfBindCombinedIotCounts === 'function') { nfBindCombinedIotCounts(); }

        /* Paint the Sensor column once, right after the partial renders. The
           Healthy/Faulty badge is drawn only by fnUpdateTableData, which runs
           only inside aggregateAndUpdateUI. On load that was triggered only by
           async callbacks — the (currently silent) sensor WebSocket and the
           GetAssetsByIds POST, and the latter runs only for point-machine
           assets and skips the aggregate entirely when there are none. So the
           sensor cells stayed blank until some unrelated async event fired the
           aggregate — which is exactly why switching to Pictorial and back
           "made them appear": the round-trip merely gave that callback time to
           land. Calling it here removes the race and paints every station type
           immediately. */
        if (typeof aggregateAndUpdateUI === 'function') {
            try { aggregateAndUpdateUI(); } catch (e) {
                if (window.console) { console.warn('[RDPMS initial paint]', e); }
            }
        }

        window.rdpmsNormalizeLive();
        if (!window.__rdpmsForcedHealthTimer) {
            window.__rdpmsForcedHealthTimer =
                setInterval(window.rdpmsNormalizeLive, 1000);
        }
    });</script>