                    if (_vibSeen[_vk]) { continue; }
                    _vibSeen[_vk] = true;
                    total++;
                    continue;
                }

                var _gid = ai.AttributeId != null ? String(ai.AttributeId).trim() : '';
                var _lid = ai.AssetAttributeId != null ? String(ai.AssetAttributeId).trim() : '';
