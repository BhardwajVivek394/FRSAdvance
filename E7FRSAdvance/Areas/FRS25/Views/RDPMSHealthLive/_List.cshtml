                /* Faulty: still taken from the WS _shRows store, filtered to the
           allowed asset IDs. The feed IS complete for faulty sensors — a
           sensor crossing its threshold always triggers a setTime row. */
        var universe = (typeof window.rdpmsSensorUniverse === 'function')
