    window.rdpmsWsLog = (function () {
        var MAX = 3000;
        var buf = [];
        var enabled = false;

        function stamp() { return new Date().toISOString().substr(11, 12); }

        function push(topic, msg) {
            if (!enabled) { return; }

            var env;
            try { env = (typeof msg === 'string') ? JSON.parse(msg) : msg; }
            catch (e) {
                buf.push({ at: stamp(), topic: String(topic), _raw: String(msg), _parseError: true });
                return;
            }
            if (!env) { return; }

            /* Batch envelope: unwrap Messages[] so each device row is its own
               entry. A non-batch frame is logged as-is. */
            var list = $.isArray(env.Messages) ? env.Messages : [env];

            for (var i = 0; i < list.length; i++) {
                var rec = list[i];
                if (typeof rec === 'string') {
                    try { rec = JSON.parse(rec); } catch (e2) { continue; }
                }
                if (!rec) { continue; }

                buf.push({
                    at: stamp(),
                    topic: env.Topic || String(topic || ''),
                    type: rec.type || '',
                    deviceType: rec.deviceType || '',
                    deviceId: rec.deviceId != null ? String(rec.deviceId) : '',
                    channel: rec.channel || '',
                    siteId: rec.siteId != null ? String(rec.siteId) : String(topic || ''),
                    clusterId: rec.clusterId != null ? String(rec.clusterId) : '',
                    setTime: rec.setTime || '',
                    resetTime: rec.resetTime || '',
                    active: rec.active,
                    raw: rec
                });
            }
            if (buf.length > MAX) { buf.splice(0, buf.length - MAX); }
        }

        function show(rows) {
            console.table(rows.map(function (r) {
                return {
                    at: r.at, type: r.type, deviceType: r.deviceType,
                    deviceId: r.deviceId, channel: r.channel,
                    active: r.active, setTime: r.setTime, resetTime: r.resetTime
                };
            }));
            return rows.length + ' frame(s)';
        }

        return {
            _push: push,
            on: function () { enabled = true; return 'WS logging ON'; },
            off: function () { enabled = false; return 'WS logging OFF'; },
            clear: function () { buf = []; return 'cleared'; },
            all: function () { return show(buf); },
            raw: function () { return buf.slice(); },
            device: function (id) {
                return show(buf.filter(function (r) { return r.deviceId === String(id); }));
            },
            type: function (t) {
                return show(buf.filter(function (r) { return r.deviceType === t; }));
            },

            /* Derived verdict per device, straight from the channel store the
               painters read. This is what you compare against the UI. */
            state: function () {
                var out = [], ch = window.__rdpmsChannelRows || {}, byDev = {};
                Object.keys(ch).forEach(function (k) {
                    var r = ch[k];
                    if (!r) { return; }
                    var key = r.siteId + '|' + r.deviceType + '|' + r.deviceId;
                    (byDev[key] = byDev[key] || []).push(r);
                });
                Object.keys(byDev).sort().forEach(function (key) {
                    var rows = byDev[key], parts = key.split('|');
                    var activeCh = rows.filter(function (r) {
                        return r.active === 1 || r.active === '1';
                    });
                    out.push({
                        siteId: parts[0], deviceType: parts[1], deviceId: parts[2],
                        channels: rows.length, activeSet: activeCh.length,
                        verdict: activeCh.length ? 'FAULTY' : 'healthy',
                        channelList: rows.map(function (r) {
                            return r.channel + ((r.active === 1 || r.active === '1') ? '(SET)' : '(reset)');
                        }).join(' ')
                    });
                });
                console.table(out);
                return out.length + ' device(s)';
            }
        };
    })();

