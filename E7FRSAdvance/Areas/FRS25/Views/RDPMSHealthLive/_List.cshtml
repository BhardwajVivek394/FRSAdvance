    function rdpmsBindSummaryTiles() {
        var sel = rdpmsSelectedSiteFilter();

        var iotHealthy = 0, iotFaulty = 0;
        var wiredOnline = 0, wiredFaulty = 0;
        var wirelessOnline = 0, wirelessFaulty = 0;
        var gwTotal = 0, gwFaulty = 0;
        var gotGroup = false;

        Object.keys(_groupSummaryBySite).forEach(function (sid) {
            if (sel.restrict && sel.ids.indexOf(String(sid)) === -1) { return; }
            var g = _groupSummaryBySite[sid];
            if (!g) { return; }
            gotGroup = true;

            /* The tile is a plain Healthy / Faulty count: masking does NOT
    carve a third bucket out of it. a10Online already INCLUDES the
    masked A10s (cluster_9: a10OnlineCount 5 of 5, all masked), so
    take it as-is - that also keeps the tile in step with the grid,
    which renders a masked A10 as its working (Healthy) verdict.
    Undetermined stays a drawer / pictorial concept only. */
            iotHealthy += Math.max(0, g.a10Online);
            iotFaulty += g.a10Down;

            /* Denominator is the MODEM count. A cluster with no modem
               (cluster_1/ips-room, "modem": null) is not a network: its rows
               paint N/A in the grid and are excluded from fetchSiteClusters(),
               so counting it here would put the tile permanently above the
               table. clustersTotal is kept only as a fallback for an older
               frame that omits modemTotal. */
            var netTotal = (g.modemTotal > 0) ? g.modemTotal : g.clustersTotal;

            wiredFaulty += g.modemWiredDown;
            wiredOnline += Math.max(0, netTotal - g.modemWiredDown);

            wirelessFaulty += g.modemWirelessDown;
            wirelessOnline += Math.max(0, netTotal - g.modemWirelessDown);

            /* Header counts the STATION gateway only — external gateway is
    excluded so the tile matches the grid cell and pictorial. */
            gwTotal += g.gatewayTotal;
            gwFaulty += g.gatewayDown;
        });

        //if (gotGroup) {
        //    $('#spnIoTHealthy').removeData('nm-text').text(iotHealthy);
        //    $('#spnIoTFaulty').removeData('nm-text').text(iotFaulty);

        //    $('#spnNetWiredOnline').removeData('nm-text').text(wiredOnline);
        //    $('#spnNetWiredFaulty').removeData('nm-text').text(wiredFaulty);

        //    $('#spnNetWirelessOnline').removeData('nm-text').text(wirelessOnline);
        //    $('#spnNetWirelessFaulty').removeData('nm-text').text(wirelessFaulty);

        if (gotGroup) {
