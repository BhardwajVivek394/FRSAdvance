@{
    ViewBag.Title = "RDPMS Health Summary";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}

<style>
    @@keyframes progressShrink {
        from {
            width: 100%;
        }

        to {
            width: 0%;
        }
    }

    /* ===== 24-HOUR TIME INPUT WITH CUSTOM PICKER ===== */
    .time-24-wrapper {
        position: relative;
        display: inline-block;
        width: 100%;
    }

    input.time-24 {
        font-variant-numeric: tabular-nums;
        font-family: inherit;
        letter-spacing: 0.5px;
        text-align: center;
        padding-right: 30px !important;
        cursor: pointer;
    }

        input.time-24::placeholder {
            color: #9ca3af;
            letter-spacing: 1px;
        }

    .time-24-icon {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        color: #6b7280;
        font-size: 13px;
        pointer-events: none;
    }

    .time-picker-popup {
        position: absolute;
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
        z-index: 99999;
        display: none;
        width: 220px;
        overflow: hidden;
    }

        .time-picker-popup.open {
            display: block;
        }

    .time-picker-header {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        gap: 4px;
    }

    .time-picker-display {
        font-size: 20px;
        font-weight: 600;
        color: #1e3a5f;
        font-variant-numeric: tabular-nums;
        letter-spacing: 1px;
    }

    .time-picker-body {
        display: flex;
        height: 200px;
    }

    .time-picker-col {
        flex: 1;
        overflow-y: auto;
        border-right: 1px solid #f0f0f0;
        scroll-behavior: smooth;
    }

        .time-picker-col:last-child {
            border-right: none;
        }

        .time-picker-col::-webkit-scrollbar {
            width: 6px;
        }

        .time-picker-col::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }

        .time-picker-col::-webkit-scrollbar-track {
            background: #f8fafc;
        }

    .time-picker-item {
        padding: 8px 0;
        text-align: center;
        font-size: 14px;
        color: #374151;
        cursor: pointer;
        font-variant-numeric: tabular-nums;
        transition: background 0.12s;
    }

        .time-picker-item:hover {
            background: #e8f2ff;
            color: #1d4ed8;
        }

        .time-picker-item.selected {
            background: #3b82f6;
            color: #fff;
            font-weight: 600;
        }

    .time-picker-footer {
        display: flex;
        border-top: 1px solid #e2e8f0;
        background: #f8fafc;
    }

    .time-picker-btn {
        flex: 1;
        border: none;
        background: transparent;
        padding: 8px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        color: #64748b;
        transition: background 0.15s;
    }

        .time-picker-btn:hover {
            background: #e2e8f0;
        }

        .time-picker-btn.primary {
            color: #1d4ed8;
            font-weight: 600;
        }

            .time-picker-btn.primary:hover {
                background: #dbeafe;
            }

    /* ===== INPUT FIELDS ===== */
    .filter-input {
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        height: 38px;
        width: 100px;
        outline: none;
    }

        .filter-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59,130,246,0.2);
        }

        .filter-input.time-24 {
            width: 100px;
        }

    .btn-search {
        background: var(--primary);
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        color: #fff;
        font-size: 14px;
        font-weight: 500;
        transition: background 0.2s;
    }

        .btn-search:hover {
            background: #3c3ebf;
        }

    .select-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        color: #333;
        cursor: pointer;
        min-width: 170px;
        height: 40px;
    }

        .select-btn:hover {
            border-color: #999;
        }

        .select-btn.active {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59,130,246,0.2);
        }

        .select-btn .text {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: left;
        }

        .select-btn i {
            margin-left: 8px;
            font-size: 12px;
            color: #666;
        }

    .filter-dropdown {
        position: fixed;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 6px 24px rgba(0,0,0,0.18);
        min-width: 260px;
        max-width: 320px;
        z-index: 9999;
        display: none;
    }

        .filter-dropdown.open {
            display: block;
        }

    .ms-dropdown-search {
        padding: 10px 12px;
        border-bottom: 1px solid #e0e0e0;
    }

        .ms-dropdown-search input {
            width: 100%;
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s;
        }

            .ms-dropdown-search input:focus {
                border-color: #3b82f6;
            }

            .ms-dropdown-search input::placeholder {
                color: #aaa;
            }

    .ms-dropdown-header {
        padding: 10px 14px;
        background: #f5f5f5;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .ms-dropdown-header input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #3b82f6;
        }

        .ms-dropdown-header label {
            font-size: 14px;
            font-weight: 600;
            color: #333;
            cursor: pointer;
            margin: 0;
        }

    .ms-dropdown-list {
        max-height: 250px;
        overflow-y: auto;
    }

    .ms-dropdown-item {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.15s;
    }

        .ms-dropdown-item:last-child {
            border-bottom: none;
        }

        .ms-dropdown-item:hover {
            background: #f5f7fa;
        }

        .ms-dropdown-item.checked {
            background: #e8f2ff;
        }

        .ms-dropdown-item.hidden {
            display: none;
        }

        .ms-dropdown-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #3b82f6;
            flex-shrink: 0;
        }

        .ms-dropdown-item span {
            font-size: 14px;
            color: #333;
        }

        .ms-dropdown-item.checked span {
            color: #1d4ed8;
            font-weight: 500;
        }

        .ms-dropdown-item span mark {
            background: #fef08a;
            color: #333;
            padding: 0;
            border-radius: 2px;
        }

    .ms-dropdown-empty {
        padding: 25px;
        text-align: center;
        color: #888;
        font-size: 14px;
    }

    .ms-dropdown-no-results {
        padding: 20px;
        text-align: center;
        color: #999;
        font-size: 13px;
        display: none;
    }

        .ms-dropdown-no-results.show {
            display: block;
        }

    .dropdown-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9998;
        display: none;
    }

        .dropdown-backdrop.show {
            display: block;
        }

    #filterContainer {
        display: flex !important;
        flex-wrap: wrap !important;
        align-items: flex-end !important;
        gap: 12px 8px;
        padding-bottom: 4px;
    }

        #filterContainer > div {
            flex: 0 0 auto;
            width: auto !important;
            min-width: 0;
            max-width: none;
            margin-top: 0 !important;
            padding: 0 2px;
        }

            #filterContainer > div > span,
            #filterContainer > div > label {
                font-size: 12px;
                font-weight: 500;
                color: #475569;
                white-space: nowrap;
                display: block;
                margin-bottom: 4px;
            }

        #filterContainer .form-control,
        #filterContainer .select-btn {
            font-size: 13px;
            padding: 5px 10px;
            height: 36px;
            min-width: 90px;
        }

        #filterContainer input[type="text"]:not(.time-24) {
            min-width: 130px;
        }

        #filterContainer input[type="date"] {
            min-width: 130px;
        }

        #filterContainer input.time-24 {
            min-width: 95px;
            max-width: 115px;
        }

        #filterContainer .time-24-wrapper {
            min-width: 95px;
            max-width: 115px;
        }

        #filterContainer .select-btn {
            min-width: 150px;
        }

        #filterContainer .btn-search {
            height: 36px;
            padding: 6px 14px;
        }


    /* ===== RESPONSIVE FILTER BAR ===== */
    @@media (max-width: 991.98px) {
        #filterContainer > div {
            flex: 1 1 calc(33.333% - 8px) !important;
        }

        #filterContainer .filter-item:has(#btnZone),
        #filterContainer .filter-item:has(#btnDivision),
        #filterContainer .filter-item:has(#btnSite),
        #filterContainer .filter-item:has(#btnAssetType),
        #filterContainer input[type="text"]:not(.time-24),
        #filterContainer input[type="date"],
        #filterContainer .select-btn {
            min-width: 100%;
            width: 100% !important;
        }

        #filterContainer > div {
            width: 100% !important;
            max-width: 100%;
        }
    }

    @@media (max-width: 767.98px) {
        #filterContainer {
            flex-direction: column !important;
            align-items: stretch !important;
        }

            #filterContainer > div {
                width: 100% !important;
                flex: 1 1 100% !important;
                max-width: 100%;
            }

            #filterContainer .select-btn,
            #filterContainer input[type="text"],
            #filterContainer input[type="date"],
            #filterContainer .time-24-wrapper,
            #filterContainer select.form-control {
                min-width: 100% !important;
                max-width: 100% !important;
                width: 100% !important;
            }

            #filterContainer .btn-search {
                width: 100%;
            }

        .filter-dropdown {
            left: 12px !important;
            right: 12px !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
        }
    }

    @@media (max-width: 575.98px) {
        .time-picker-popup {
            width: calc(100vw - 24px);
            max-width: 260px;
        }
    }
</style>

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="dropdown-backdrop" id="backdrop"></div>

<!-- 24-hour Time Picker Popup (shared) -->
<div class="time-picker-popup" id="timePickerPopup">
    <div class="time-picker-header">
        <span class="time-picker-display" id="tpHour">00</span>
        <span class="time-picker-display">:</span>
        <span class="time-picker-display" id="tpMinute">00</span>
    </div>
    <div class="time-picker-body">
        <div class="time-picker-col" id="tpHourCol"></div>
        <div class="time-picker-col" id="tpMinuteCol"></div>
    </div>
    <div class="time-picker-footer">
        <button type="button" class="time-picker-btn" onclick="return tpNow(event);">Now</button>
        <button type="button" class="time-picker-btn" onclick="return tpClear(event);">Clear</button>
        <button type="button" class="time-picker-btn primary" onclick="return tpApply(event);">OK</button>
    </div>
</div>

<!-- Breadcrumb + Page Title -->
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body p-0">
                <div class="row">
                    <div class="col-12 col-sm-5">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">RDPMS</li>
                                <li class="breadcrumb-item active" aria-current="page">
                                    <a href="#">RDPMS Health Summary</a>
                                </li>
                            </ol>
                        </nav>
                    </div>
                    <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                        <h2 class="page-name">RDPMS Health Summary</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Search / Filter Card -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header mb-2">
                <h4 class="m-0">Search</h4>
            </div>
            <div class="card-body">
                <div class="mb-3" id="filterContainer">

                    <!-- Zone -->
                    <div class="filter-item" style="position:relative;z-index:100;">
                        <span>Zone</span>
                        <div class="select-btn" id="btnZone" data-target="ddZone">
                            <span class="text" id="txtZone">All</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </div>

                    <!-- Division -->
                    <div class="filter-item" style="position:relative;z-index:100;">
                        <span>Division</span>
                        <div class="select-btn" id="btnDivision" data-target="ddDivision">
                            <span class="text" id="txtDivision">All</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </div>

                    <!-- Station -->
                    <div class="filter-item" style="position:relative;z-index:100;">
                        <span>Station</span>
                        <div class="select-btn" id="btnSite" data-target="ddSite">
                            <span class="text" id="txtSite">All</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </div>

                    <!-- Asset Type -->
                    <div class="filter-item" style="position:relative;z-index:100;">
                        <span>Asset Type</span>
                        <div class="select-btn" id="btnAssetType" data-target="ddAssetType">
                            <span class="text" id="txtAssetType">All</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </div>

                    <!-- From Date -->
                    <div class="filter-item">
                        <span>From Date</span>
                        <input type="text" class="form-control" id="txtFromDate" placeholder="Select" readonly style="width:130px;background-color:white" />
                    </div>

                    <!-- From Time -->
                    <div class="filter-item">
                        <span>From Time</span>
                        <div class="time-24-wrapper">
                            <input type="text" class="filter-input time-24" id="txtFromTime"
                                   placeholder="HH:MM" maxlength="5" autocomplete="off" readonly />
                            <i class="fas fa-clock time-24-icon"></i>
                        </div>
                    </div>

                    <!-- To Date -->
                    <div class="filter-item">
                        <span>To Date</span>
                        <input type="text" class="form-control" id="txtToDate" placeholder="Select" readonly style="width: 130px; background-color: white" />
                    </div>

                    <!-- To Time -->
                    <div class="filter-item">
                        <span>To Time</span>
                        <div class="time-24-wrapper">
                            <input type="text" class="filter-input time-24" id="txtToTime"
                                   placeholder="HH:MM" maxlength="5" autocomplete="off" readonly />
                            <i class="fas fa-clock time-24-icon"></i>
                        </div>
                    </div>

                    <!-- View -->
                    <div class="filter-item">
                        <span>View</span>
                        <select class="form-control" id="drpView"
                                style="height:36px;min-width:110px;font-size:13px;">
                            <option value="Table">Table</option>
                            <option value="Pie">Pie</option>
                            <option value="Bar">Bar</option>
                            <option value="Graph">Graph</option>
                        </select>
                    </div>

                    <!-- Search Button -->
                    <div class="filter-item">
                        <button type="button" class="btn-search"
                                onclick="fnGetRDPMSHealthLiveReport()">
                            <img src="~/Areas/FRS25/assets/img/search.svg">
                        </button>
                    </div>

                </div>

                <!-- Zone Dropdown -->
                <div class="filter-dropdown" id="ddZone">
                    <div class="ms-dropdown-search">
                        <input type="text" placeholder="Search zone..."
                               onkeyup="filterMsDropdown('zone', this.value)">
                    </div>
                    <div class="ms-dropdown-header">
                        <input type="checkbox" id="chkAllZone">
                        <label for="chkAllZone">Select All</label>
                    </div>
                    <div class="ms-dropdown-list" id="listZone">
                        @if (ViewBag.Zones != null)
                        {
                            foreach (var zone in (IEnumerable<SelectListItem>)ViewBag.Zones)
                            {
                                <div class="ms-dropdown-item" data-value="@zone.Value" data-text="@zone.Text">
                                    <input type="checkbox" class="cb-zone" value="@zone.Value">
                                    <span>@zone.Text</span>
                                </div>
                            }
                        }
                    </div>
                    <div class="ms-dropdown-no-results">No results found</div>
                </div>

                <!-- Division Dropdown -->
                <div class="filter-dropdown" id="ddDivision">
                    <div class="ms-dropdown-search">
                        <input type="text" placeholder="Search division..."
                               onkeyup="filterMsDropdown('division', this.value)">
                    </div>
                    <div class="ms-dropdown-header">
                        <input type="checkbox" id="chkAllDivision">
                        <label for="chkAllDivision">Select All</label>
                    </div>
                    <div class="ms-dropdown-list" id="listDivision">
                        @if (ViewBag.Divisions != null)
                        {
                            foreach (var division in (IEnumerable<SelectListItem>)ViewBag.Divisions)
                            {
                                <div class="ms-dropdown-item" data-value="@division.Value" data-text="@division.Text">
                                    <input type="checkbox" class="cb-division" value="@division.Value">
                                    <span>@division.Text</span>
                                </div>
                            }
                        }
                    </div>
                    <div class="ms-dropdown-no-results">No results found</div>
                </div>

                <!-- Site Dropdown -->
                <div class="filter-dropdown" id="ddSite">
                    <div class="ms-dropdown-search">
                        <input type="text" placeholder="Search station..."
                               onkeyup="filterMsDropdown('site', this.value)">
                    </div>
                    <div class="ms-dropdown-header">
                        <input type="checkbox" id="chkAllSite">
                        <label for="chkAllSite">Select All</label>
                    </div>
                    <div class="ms-dropdown-list" id="listSite">
                        @if (ViewBag.Sites != null)
                        {
                            foreach (var site in (IEnumerable<SelectListItem>)ViewBag.Sites)
                            {
                                <div class="ms-dropdown-item" data-value="@site.Value" data-text="@site.Text">
                                    <input type="checkbox" class="cb-site" value="@site.Value">
                                    <span>@site.Text</span>
                                </div>
                            }
                        }
                    </div>
                    <div class="ms-dropdown-no-results">No results found</div>
                </div>

                <!-- Asset Type Dropdown -->
                <div class="filter-dropdown" id="ddAssetType">
                    <div class="ms-dropdown-search">
                        <input type="text" placeholder="Search asset type..."
                               onkeyup="filterMsDropdown('assetType', this.value)">
                    </div>
                    <div class="ms-dropdown-header">
                        <input type="checkbox" id="chkAllAssetType">
                        <label for="chkAllAssetType">Select All</label>
                    </div>
                    <div class="ms-dropdown-list" id="listAssetType">
                        @if (ViewBag.AssetTypes != null)
                        {
                            foreach (var assettype in (IEnumerable<SelectListItem>)ViewBag.AssetTypes)
                            {
                                <div class="ms-dropdown-item" data-value="@assettype.Value" data-text="@assettype.Text">
                                    <input type="checkbox" class="cb-assetType" value="@assettype.Value">
                                    <span>@assettype.Text</span>
                                </div>
                            }
                        }
                    </div>
                    <div class="ms-dropdown-no-results">No results found</div>
                </div>

                <!-- ══════════════════════════════════════════════════════════════
                     INSIGHTS PANEL — Network intelligence for the selected sites.
                     Adapted from the "Live Comparer › NW Status" view in the
                     historian tool. Fleet health + 4 connectivity meters + a
                     per-cluster grid with signal strength / TCP / MQTT / A10 chips.

                     Data sources (all via the existing controller proxies):
                       /FRS25/RDPMSHealthLive/GetModemLive?siteId=…   (Modem MQTT)
                       /FRS25/RDPMSHealthLive/GetA10Live?siteId=…     (A10 MQTT)
                       /FRS25/RDPMSHealthLive/GetCardLineData?siteId= (cluster / A10 IDs)
                     Refresh interval: 30 s while the panel is visible.
                ══════════════════════════════════════════════════════════════════ -->
                <section id="rdpmsInsightsPanel" class="rdpms-ins-panel" style="display:none;">
                    <div class="rdpms-ins-head">
                        <div class="rdpms-ins-title">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5v14"/></svg>
                            Insights &mdash; Network fleet
                            <span id="rdpmsInsMeta" class="rdpms-ins-meta"></span>
                        </div>
                        <div class="rdpms-ins-actions">
                            <button type="button" class="rdpms-ins-btn rdpms-ins-btn-primary" id="rdpmsInsLoadUptime"
                                    onclick="RdpmsInsights.loadUptime()"
                                    title="Compute today's uptime/downtime per cluster from history. Heavy on large sites — runs on demand.">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10M6 20v-6M18 20V4"/></svg>
                                Load Uptime
                            </button>
                            <button type="button" class="rdpms-ins-btn" id="rdpmsInsRefresh" onclick="RdpmsInsights.refresh()" title="Refresh live status now">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></svg>
                                Refresh
                            </button>
                            <button type="button" class="rdpms-ins-btn rdpms-ins-btn-toggle" id="rdpmsInsToggle" onclick="RdpmsInsights.toggle()" title="Collapse / expand">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                            </button>
                        </div>
                    </div>

                    <div class="rdpms-ins-body" id="rdpmsInsBody">
                        <!-- Top rail: fleet health + 4 connectivity meters -->
                        <div class="rdpms-ins-rail">
                            <div class="rdpms-ins-card rdpms-ins-fleet">
                                <div class="rdpms-ins-lab">Fleet health</div>
                                <div class="rdpms-ins-fh-mid">
                                    <div class="rdpms-ins-fh-num"><b id="rdpmsInsUpCount">0</b><span>/ <span id="rdpmsInsTotCount">0</span> up</span></div>
                                    <div class="rdpms-ins-fh-pct" id="rdpmsInsUpPct">0%</div>
                                </div>
                                <div class="rdpms-ins-hbar">
                                    <span class="on" id="rdpmsInsHbarOn" style="width:0%"></span>
                                    <span class="off" id="rdpmsInsHbarOff" style="width:100%"></span>
                                </div>
                                <div class="rdpms-ins-fh-leg">
                                    <span><span class="d on"></span><b id="rdpmsInsLegUp">0</b> up</span>
                                    <span><span class="d off"></span><b id="rdpmsInsLegDown">0</b> down</span>
                                </div>
                            </div>
                            <div class="rdpms-ins-card rdpms-ins-conn">
                                <div class="rdpms-ins-lab">Connectivity &amp; downstream</div>
                                <div class="rdpms-ins-mgrid">
                                    <div class="rdpms-ins-meter" data-key="mtcp">
                                        <div class="rdpms-ins-m-row"><span class="rdpms-ins-m-lab"><span class="rdpms-ins-m-dot" style="background:#22d3ee"></span>Modem TCP</span><span class="rdpms-ins-m-val"><b>0</b> / <span>0</span> <span class="pct">0%</span></span></div>
                                        <div class="rdpms-ins-m-track"><span style="width:0%"></span></div>
                                    </div>
                                    <div class="rdpms-ins-meter" data-key="mmqtt">
                                        <div class="rdpms-ins-m-row"><span class="rdpms-ins-m-lab"><span class="rdpms-ins-m-dot" style="background:#60a5fa"></span>Modem MQTT</span><span class="rdpms-ins-m-val"><b>0</b> / <span>0</span> <span class="pct">0%</span></span></div>
                                        <div class="rdpms-ins-m-track"><span style="width:0%"></span></div>
                                    </div>
                                    <div class="rdpms-ins-meter" data-key="atcp">
                                        <div class="rdpms-ins-m-row"><span class="rdpms-ins-m-lab"><span class="rdpms-ins-m-dot" style="background:#a78bfa"></span>A10 TCP</span><span class="rdpms-ins-m-val"><b>0</b> / <span>0</span> <span class="pct">0%</span></span></div>
                                        <div class="rdpms-ins-m-track"><span style="width:0%"></span></div>
                                    </div>
                                    <div class="rdpms-ins-meter" data-key="amqtt">
                                        <div class="rdpms-ins-m-row"><span class="rdpms-ins-m-lab"><span class="rdpms-ins-m-dot" style="background:#34d399"></span>A10 MQTT</span><span class="rdpms-ins-m-val"><b>0</b> / <span>0</span> <span class="pct">0%</span></span></div>
                                        <div class="rdpms-ins-m-track"><span style="width:0%"></span></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Availability rail (populated by Load Uptime) -->
                        <div class="rdpms-ins-avail-rail" id="rdpmsInsAvailRail" style="display:none;">
                            <div class="rdpms-ins-card rdpms-ins-avail">
                                <div class="rdpms-ins-lab">Availability today <span class="rdpms-ins-lab-sub" id="rdpmsInsAvailScope"></span></div>
                                <div class="rdpms-ins-avail-mid">
                                    <div class="rdpms-ins-avail-big" id="rdpmsInsAvailPct">—</div>
                                    <div class="rdpms-ins-avail-side">
                                        <div class="rdpms-ins-avail-row"><span class="dot up"></span>Uptime <b id="rdpmsInsAvailUpDur">—</b></div>
                                        <div class="rdpms-ins-avail-row"><span class="dot down"></span>Downtime <b id="rdpmsInsAvailDownDur">—</b></div>
                                    </div>
                                </div>
                                <div class="rdpms-ins-hbar">
                                    <span class="on" id="rdpmsInsAvailHbarOn" style="width:0%"></span>
                                    <span class="off" id="rdpmsInsAvailHbarOff" style="width:100%"></span>
                                </div>
                            </div>
                            <div class="rdpms-ins-card rdpms-ins-avail-brk">
                                <div class="rdpms-ins-lab">By channel (samples online / total)</div>
                                <div class="rdpms-ins-mgrid">
                                    <div class="rdpms-ins-meter" data-key="utcp">
                                        <div class="rdpms-ins-m-row"><span class="rdpms-ins-m-lab"><span class="rdpms-ins-m-dot" style="background:#22d3ee"></span>Modem TCP uptime</span><span class="rdpms-ins-m-val"><b>0</b> / <span>0</span> <span class="pct">—</span></span></div>
                                        <div class="rdpms-ins-m-track"><span style="width:0%"></span></div>
                                    </div>
                                    <div class="rdpms-ins-meter" data-key="ummqt">
                                        <div class="rdpms-ins-m-row"><span class="rdpms-ins-m-lab"><span class="rdpms-ins-m-dot" style="background:#60a5fa"></span>Modem MQTT uptime</span><span class="rdpms-ins-m-val"><b>0</b> / <span>0</span> <span class="pct">—</span></span></div>
                                        <div class="rdpms-ins-m-track"><span style="width:0%"></span></div>
                                    </div>
                                    <div class="rdpms-ins-meter" data-key="uatcp">
                                        <div class="rdpms-ins-m-row"><span class="rdpms-ins-m-lab"><span class="rdpms-ins-m-dot" style="background:#a78bfa"></span>A10 TCP uptime</span><span class="rdpms-ins-m-val"><b>0</b> / <span>0</span> <span class="pct">—</span></span></div>
                                        <div class="rdpms-ins-m-track"><span style="width:0%"></span></div>
                                    </div>
                                    <div class="rdpms-ins-meter" data-key="uamqt">
                                        <div class="rdpms-ins-m-row"><span class="rdpms-ins-m-lab"><span class="rdpms-ins-m-dot" style="background:#34d399"></span>A10 MQTT uptime</span><span class="rdpms-ins-m-val"><b>0</b> / <span>0</span> <span class="pct">—</span></span></div>
                                        <div class="rdpms-ins-m-track"><span style="width:0%"></span></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Filter bar -->
                        <div class="rdpms-ins-filters">
                            <div class="rdpms-ins-seg" data-filter-group="show">
                                <button type="button" data-v="all" class="on">All</button>
                                <button type="button" data-v="online">Online</button>
                                <button type="button" data-v="offline">Offline</button>
                            </div>
                            <div class="rdpms-ins-seg" data-filter-group="issue">
                                <button type="button" data-v="any" class="on">Any issue</button>
                                <button type="button" data-v="tcp">TCP down</button>
                                <button type="button" data-v="mqtt">MQTT down</button>
                                <button type="button" data-v="a10">A10 missing</button>
                            </div>
                            <div class="rdpms-ins-seg" data-filter-group="sort">
                                <button type="button" data-v="issues" class="on">Issues first</button>
                                <button type="button" data-v="name">By name</button>
                            </div>
                            <input id="rdpmsInsSearch" class="rdpms-ins-search" placeholder="cluster / modem / A10…" />
                        </div>

                        <!-- Cluster grid -->
                        <div id="rdpmsInsGrid" class="rdpms-ins-grid"></div>
                        <div id="rdpmsInsEmpty" class="rdpms-ins-empty" style="display:none;">
                            No clusters returned by the selected sites. Run a search and pick at least one station.
                        </div>
                    </div>
                </section>

                <div id="divRDPMSHealthLive"></div>

            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════════════════════
     INSIGHTS PANEL — styles.
     Light theme sibling of the historian's `.nwdash` block. Names are prefixed
     `rdpms-ins-` to avoid collision with the RDPMS Health Live table CSS.
══════════════════════════════════════════════════════════════════════════════ -->
<style>
    .rdpms-ins-panel {
        --ins-grn: #16a34a;
        --ins-amb: #d97706;
        --ins-red: #dc2626;
        --ins-blu: #2563eb;
        --ins-pur: #7c3aed;
        --ins-cyan: #0891b2;
        --ins-bg: #ffffff;
        --ins-bg2: #f8fafc;
        --ins-bg3: #f1f5f9;
        --ins-bdr: #e2e8f0;
        --ins-tx: #1e293b;
        --ins-tx2: #475569;
        --ins-tx3: #64748b;
        --ins-tx4: #94a3b8;
        --ins-mono: 'JetBrains Mono', ui-monospace, 'SF Mono', Consolas, monospace;
        background: var(--ins-bg);
        border: 1px solid var(--ins-bdr);
        border-radius: 12px;
        margin: 16px 0 20px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0,0,0,.04);
    }

    .rdpms-ins-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 16px;
        background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
        border-bottom: 1px solid var(--ins-bdr);
    }

    .rdpms-ins-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
        font-weight: 700;
        color: var(--ins-tx);
        letter-spacing: .2px;
    }

    .rdpms-ins-title svg { color: var(--ins-blu); }

    .rdpms-ins-meta {
        font-weight: 500;
        font-size: 11.5px;
        color: var(--ins-tx3);
        margin-left: 8px;
        font-family: var(--ins-mono);
    }

    .rdpms-ins-actions { display: flex; gap: 6px; }

    .rdpms-ins-btn {
        display: inline-flex; align-items: center; gap: 4px;
        background: #fff; border: 1px solid var(--ins-bdr); border-radius: 7px;
        color: var(--ins-tx2); font-size: 12px; font-weight: 600;
        padding: 6px 10px; cursor: pointer; transition: all .15s;
        line-height: 1;
    }
    .rdpms-ins-btn:hover { background: var(--ins-bg2); border-color: #cbd5e1; color: var(--ins-tx); }
    .rdpms-ins-btn-toggle { padding: 6px 8px; }
    .rdpms-ins-panel.collapsed .rdpms-ins-body { display: none; }
    .rdpms-ins-panel.collapsed .rdpms-ins-btn-toggle svg { transform: rotate(-90deg); }
    .rdpms-ins-btn-toggle svg { transition: transform .2s; }

    .rdpms-ins-body { padding: 16px; background: var(--ins-bg2); }

    .rdpms-ins-rail {
        display: grid;
        grid-template-columns: minmax(240px, .85fr) minmax(360px, 1.4fr);
        gap: 12px;
        margin-bottom: 14px;
    }
    @@media (max-width: 820px) { .rdpms-ins-rail { grid-template-columns: 1fr; } }

    .rdpms-ins-card {
        background: #fff;
        border: 1px solid var(--ins-bdr);
        border-radius: 10px;
        padding: 12px 14px;
    }

    .rdpms-ins-lab {
        font-size: 10px; letter-spacing: 1px; text-transform: uppercase;
        color: var(--ins-tx3); font-weight: 700; margin-bottom: 9px;
    }

    .rdpms-ins-fleet { display: flex; flex-direction: column; }
    .rdpms-ins-fh-mid { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 9px; }
    .rdpms-ins-fh-num { font-family: var(--ins-mono); }
    .rdpms-ins-fh-num b { font-size: 26px; color: var(--ins-tx); font-weight: 800; letter-spacing: -.5px; }
    .rdpms-ins-fh-num span { font-size: 12px; color: var(--ins-tx3); margin-left: 5px; }
    .rdpms-ins-fh-pct { font-family: var(--ins-mono); font-size: 20px; font-weight: 800; color: var(--ins-grn); }

    .rdpms-ins-hbar { display: flex; height: 10px; border-radius: 6px; overflow: hidden; background: var(--ins-bg3); gap: 2px; }
    .rdpms-ins-hbar span { display: block; transition: width .5s cubic-bezier(.4,0,.2,1); }
    .rdpms-ins-hbar .on { background: linear-gradient(90deg, var(--ins-grn), #22c55e); }
    .rdpms-ins-hbar .off { background: linear-gradient(90deg, #f43f5e, var(--ins-red)); }

    .rdpms-ins-fh-leg { display: flex; align-items: center; gap: 16px; margin-top: 10px; font-size: 12px; color: var(--ins-tx2); }
    .rdpms-ins-fh-leg b { font-family: var(--ins-mono); font-weight: 800; color: var(--ins-tx); margin-right: 3px; }
    .rdpms-ins-fh-leg .d { width: 8px; height: 8px; border-radius: 3px; display: inline-block; margin-right: 6px; vertical-align: middle; }
    .rdpms-ins-fh-leg .d.on { background: var(--ins-grn); }
    .rdpms-ins-fh-leg .d.off { background: var(--ins-red); }

    .rdpms-ins-mgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 22px; }
    @@media (max-width: 560px) { .rdpms-ins-mgrid { grid-template-columns: 1fr; } }
    .rdpms-ins-m-row { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 5px; }
    .rdpms-ins-m-lab { font-size: 10.5px; letter-spacing: .3px; text-transform: uppercase; color: var(--ins-tx2); font-weight: 700; display: flex; align-items: center; gap: 6px; }
    .rdpms-ins-m-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .rdpms-ins-m-val { font-family: var(--ins-mono); font-size: 11.5px; color: var(--ins-tx3); }
    .rdpms-ins-m-val b { color: var(--ins-tx); font-weight: 700; }
    .rdpms-ins-m-val .pct { margin-left: 4px; font-weight: 700; }
    .rdpms-ins-m-track { height: 6px; border-radius: 4px; background: var(--ins-bg3); overflow: hidden; }
    .rdpms-ins-m-track span { display: block; height: 100%; border-radius: 4px; transition: width .5s; background: var(--ins-grn); }

    .rdpms-ins-filters { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
    .rdpms-ins-seg { display: inline-flex; background: #fff; border: 1px solid var(--ins-bdr); border-radius: 8px; padding: 3px; gap: 2px; }
    .rdpms-ins-seg button { border: none; background: transparent; color: var(--ins-tx3); font-size: 12px; font-weight: 600; padding: 5px 11px; border-radius: 5px; cursor: pointer; transition: all .15s; }
    .rdpms-ins-seg button:hover { color: var(--ins-tx); background: var(--ins-bg2); }
    .rdpms-ins-seg button.on { background: var(--ins-blu); color: #fff; }
    .rdpms-ins-search { flex: 1 1 180px; min-width: 160px; background: #fff; border: 1px solid var(--ins-bdr); border-radius: 8px; padding: 7px 12px; color: var(--ins-tx); font-size: 12px; outline: none; }
    .rdpms-ins-search:focus { border-color: var(--ins-blu); box-shadow: 0 0 0 2px rgba(37,99,235,.15); }

    .rdpms-ins-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
    .rdpms-ins-empty { text-align: center; color: var(--ins-tx3); padding: 20px; font-size: 13px; }

    .rdpms-ins-cluster {
        position: relative; background: #fff; border: 1px solid var(--ins-bdr);
        border-radius: 12px; padding: 14px 15px; overflow: hidden;
        transition: all .18s;
    }
    .rdpms-ins-cluster:hover { border-color: #cbd5e1; box-shadow: 0 4px 12px rgba(15,23,42,.06); transform: translateY(-1px); }
    .rdpms-ins-cluster::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; }
    .rdpms-ins-cluster.ok::before   { background: var(--ins-grn); }
    .rdpms-ins-cluster.deg::before  { background: var(--ins-amb); }
    .rdpms-ins-cluster.off::before  { background: var(--ins-red); }

    .rdpms-ins-c-top { display: flex; align-items: center; gap: 8px; margin-bottom: 3px; }
    .rdpms-ins-c-dot { width: 9px; height: 9px; border-radius: 50%; flex: 0 0 auto; }
    .rdpms-ins-c-dot.grn { background: var(--ins-grn); box-shadow: 0 0 6px rgba(22,163,74,.35); }
    .rdpms-ins-c-dot.amb { background: var(--ins-amb); }
    .rdpms-ins-c-dot.red { background: var(--ins-red); }
    .rdpms-ins-c-name { font-size: 13.5px; font-weight: 700; color: var(--ins-tx); flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rdpms-ins-c-sig { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; }

    .rdpms-ins-sig { display: inline-flex; align-items: flex-end; gap: 2px; height: 13px; }
    .rdpms-ins-sig i { width: 3px; border-radius: 1px; background: var(--ins-bg3); display: block; }
    .rdpms-ins-sig i:nth-child(1) { height: 4px; }
    .rdpms-ins-sig i:nth-child(2) { height: 6px; }
    .rdpms-ins-sig i:nth-child(3) { height: 8px; }
    .rdpms-ins-sig i:nth-child(4) { height: 11px; }
    .rdpms-ins-sig i:nth-child(5) { height: 13px; }
    .rdpms-ins-sig.grn i.on { background: var(--ins-grn); }
    .rdpms-ins-sig.amb i.on { background: var(--ins-amb); }
    .rdpms-ins-sig.red i.on { background: var(--ins-red); }
    .rdpms-ins-c-dbm { font-family: var(--ins-mono); font-size: 10.5px; color: var(--ins-tx3); font-weight: 700; }
    .rdpms-ins-c-offlab { font-family: var(--ins-mono); font-size: 10px; font-weight: 700; color: var(--ins-red); letter-spacing: .5px; }
    .rdpms-ins-c-mac { font-family: var(--ins-mono); font-size: 10px; color: var(--ins-tx4); margin-bottom: 10px; }

    .rdpms-ins-c-chans { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-bottom: 10px; }
    .rdpms-ins-ch { font-family: var(--ins-mono); font-size: 10px; font-weight: 700; letter-spacing: .5px; text-align: center; padding: 5px 0; border-radius: 6px; border: 1px solid transparent; }
    .rdpms-ins-ch.up   { background: rgba(22,163,74,.08);  border-color: rgba(22,163,74,.28);  color: var(--ins-grn); }
    .rdpms-ins-ch.down { background: rgba(220,38,38,.08);  border-color: rgba(220,38,38,.28);  color: var(--ins-red); }
    .rdpms-ins-ch.na   { background: var(--ins-bg3); border-color: var(--ins-bdr); color: var(--ins-tx4); }

    .rdpms-ins-c-a10hd { display: flex; align-items: center; justify-content: space-between; margin-bottom: 7px; }
    .rdpms-ins-c-a10lab { font-size: 9.5px; letter-spacing: .5px; text-transform: uppercase; color: var(--ins-tx3); font-weight: 700; }
    .rdpms-ins-c-a10cnt { font-family: var(--ins-mono); font-size: 11px; font-weight: 700; }

    .rdpms-ins-c-a10grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(76px, 1fr)); gap: 5px; }
    .rdpms-ins-a10chip { display: flex; align-items: center; gap: 5px; background: var(--ins-bg2); border: 1px solid var(--ins-bdr); border-radius: 7px; padding: 4px 7px; min-width: 0; }
    .rdpms-ins-a10id { font-family: var(--ins-mono); font-size: 10.5px; font-weight: 700; color: var(--ins-tx2); flex: 0 0 auto; }
    .rdpms-ins-a10dots { display: flex; gap: 6px; margin-left: auto; }
    .rdpms-ins-a10p { display: inline-flex; align-items: center; gap: 2px; font-family: var(--ins-mono); font-size: 8.5px; font-weight: 700; color: var(--ins-tx4); }
    .rdpms-ins-ad { width: 7px; height: 7px; border-radius: 50%; display: inline-block; }
    .rdpms-ins-c-a10none { font-size: 10.5px; color: var(--ins-tx4); font-style: italic; }

    /* ── Uptime / Downtime additions ────────────────────────────────────────── */
    .rdpms-ins-btn-primary { background: var(--ins-blu); border-color: var(--ins-blu); color: #fff; }
    .rdpms-ins-btn-primary:hover { background: #1d4ed8; border-color: #1d4ed8; color: #fff; }
    .rdpms-ins-btn-primary[disabled] { opacity: .55; cursor: default; pointer-events: none; }

    .rdpms-ins-lab-sub { font-family: var(--ins-mono); font-size: 10px; color: var(--ins-tx3); font-weight: 600; margin-left: 6px; text-transform: none; letter-spacing: 0; }

    .rdpms-ins-avail-rail {
        display: grid;
        grid-template-columns: minmax(240px, .85fr) minmax(360px, 1.4fr);
        gap: 12px;
        margin-bottom: 14px;
    }
    @@media (max-width: 820px) { .rdpms-ins-avail-rail { grid-template-columns: 1fr; } }

    .rdpms-ins-avail-mid { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
    .rdpms-ins-avail-big { font-family: var(--ins-mono); font-size: 30px; font-weight: 800; letter-spacing: -1px; line-height: 1; color: var(--ins-grn); }
    .rdpms-ins-avail-big.amb { color: var(--ins-amb); }
    .rdpms-ins-avail-big.red { color: var(--ins-red); }
    .rdpms-ins-avail-big.na  { color: var(--ins-tx3); font-size: 22px; }
    .rdpms-ins-avail-side { flex: 1 1 auto; font-size: 12px; color: var(--ins-tx2); }
    .rdpms-ins-avail-row { display: flex; align-items: center; gap: 6px; margin: 3px 0; }
    .rdpms-ins-avail-row b { font-family: var(--ins-mono); font-weight: 700; color: var(--ins-tx); }
    .rdpms-ins-avail-row .dot { width: 8px; height: 8px; border-radius: 3px; display: inline-block; }
    .rdpms-ins-avail-row .dot.up { background: var(--ins-grn); }
    .rdpms-ins-avail-row .dot.down { background: var(--ins-red); }

    /* Per-cluster uptime slot (added by Load Uptime) */
    .rdpms-ins-c-uptime {
        display: flex; align-items: center; flex-wrap: wrap; gap: 4px;
        border-top: 1px dashed var(--ins-bdr);
        margin-top: 10px; padding-top: 8px;
        font-size: 10.5px;
    }
    .rdpms-ins-up-chip {
        display: inline-flex; align-items: center; gap: 3px;
        font-family: var(--ins-mono); font-size: 10px; font-weight: 700;
        padding: 2px 6px; border-radius: 5px; border: 1px solid transparent;
    }
    .rdpms-ins-up-chip.g { background: rgba(22,163,74,.10);  border-color: rgba(22,163,74,.3);  color: var(--ins-grn); }
    .rdpms-ins-up-chip.a { background: rgba(217,119,6,.10);  border-color: rgba(217,119,6,.3);  color: var(--ins-amb); }
    .rdpms-ins-up-chip.r { background: rgba(220,38,38,.10);  border-color: rgba(220,38,38,.3);  color: var(--ins-red); }
    .rdpms-ins-up-chip.n { background: var(--ins-bg3);       border-color: var(--ins-bdr);      color: var(--ins-tx4); }
    .rdpms-ins-up-chip b { font-weight: 800; }
    .rdpms-ins-up-dur { margin-left: auto; font-family: var(--ins-mono); font-size: 10px; color: var(--ins-tx3); }
    .rdpms-ins-up-dur b.down { color: var(--ins-red); font-weight: 800; }
    .rdpms-ins-up-dur b.up   { color: var(--ins-grn); font-weight: 800; }

    /* Load-uptime progress in the button */
    .rdpms-ins-btn-primary .prog { margin-left: 6px; font-family: var(--ins-mono); font-size: 11px; opacity: .9; }
</style>

<!-- ══════════════════════════════════════════════════════════════════════════
     INSIGHTS PANEL — logic.
     Reads Modem+A10 live snapshots via the RDPMS Health Live controller and
     renders fleet stats + per-cluster cards. Exposed as window.RdpmsInsights
     so `fnGetRDPMSHealthLiveReport` (in the same view) can call
     RdpmsInsights.attach(siteIds) after the summary partial is loaded.
══════════════════════════════════════════════════════════════════════════════ -->
<script>
    (function (window, $) {
        'use strict';

        if (window.RdpmsInsights) { return; }

        var REFRESH_MS = 30000;
        var state = {
            siteIds: [],
            clusters: [],     // [{ clusterId, clusterName, modemId, siteId, siteName, a10s:[{id,adc}] }]
            live: { modem: [], a10: [], tcp: [] },
            model: [],        // per-cluster derived state
            filter: { show: 'all', issue: 'any', sort: 'issues', text: '' },
            timer: null,
            attachedAt: 0,
            // uptime cache keyed by "siteId|clusterId" -> {
            //   tcpPct, mqttPct, aTcpPct, aMqttPct, tcpUp, tcpTot, mqttUp, mqttTot,
            //   aTcpUp, aTcpTot, aMqttUp, aMqttTot, upMin, downMin, elapsedMin }
            uptime: {},
            uptimeLoadedAt: 0
        };

        function fmtNow() {
            var d = new Date();
            return d.getHours().toString().padStart(2,'0') + ':' +
                   d.getMinutes().toString().padStart(2,'0') + ':' +
                   d.getSeconds().toString().padStart(2,'0');
        }

        // Normalize a single live record; mirrors historian's lcNwNorm.
        function normLive(r) {
            var sig = r.SignalStrength != null ? Number(r.SignalStrength)
                    : (r.Signal != null ? Number(r.Signal) : null);
            return {
                a10Id: r.A10Id != null ? Number(r.A10Id)
                       : (r.ADCNumber != null ? Number(r.ADCNumber) : null),
                deviceId: r.DeviceId != null ? String(r.DeviceId).replace(/\s/g,'') : null,
                clusterId: r.ClusterId != null ? r.ClusterId : null,
                typeId: r.TypeId != null ? Number(r.TypeId) : null,
                signal: sig,
                ts: r.LastUpdated || r.TimeStamp || r.Timestamp || null
            };
        }

        function onlineFrom(rec, isA10) {
            if (!rec) return null;
            if (isA10) {
                if (rec.signal == null) return null;
                if (rec.signal < 0) return 'down';
                return rec.signal > 0 ? 'online' : 'offline';
            }
            if (rec.signal === -1) return 'down';
            if (rec.signal != null) return rec.signal > 0 ? 'online' : 'offline';
            return null;
        }

        function fetchLive(kind, siteId) {
            var url;
            if (kind === 'Modem') url = '/FRS25/RDPMSHealthLive/GetModemLive?siteId=' + siteId;
            else if (kind === 'A10') url = '/FRS25/RDPMSHealthLive/GetA10Live?siteId=' + siteId;
            else return $.Deferred().resolve([]).promise();

            return $.ajax({ url: url, type: 'GET', dataType: 'json' })
                .then(function (data) {
                    var arr = $.isArray(data) ? data : (data && (data.Data || data.data || data.Result) || []);
                    return arr.map(normLive);
                }, function () { return []; });
        }

        function fetchCardLine(siteId) {
            return $.ajax({
                url: '/FRS25/RDPMSHealthLive/GetCardLineData?siteId=' + siteId,
                type: 'GET', dataType: 'json'
            }).then(function (arr) {
                return $.isArray(arr) ? arr : [];
            }, function () { return []; });
        }

        // Build the cluster / A10 hierarchy from CardLine records.
        // A row with ClusterId + ADCNumber contributes one A10 to that cluster.
        function buildClusterMap(siteId, cardLines) {
            var byCluster = {};
            (cardLines || []).forEach(function (c) {
                var cid = c.ClusterId;
                if (cid == null) return;
                if (!byCluster[cid]) {
                    byCluster[cid] = {
                        clusterId: cid,
                        clusterName: c.ClusterName || ('Cluster ' + cid),
                        modemId: c.ModemId ? String(c.ModemId).replace(/\s/g,'').toUpperCase() : null,
                        siteId: siteId,
                        a10s: {}
                    };
                }
                var adc = c.ADCNumber != null ? c.ADCNumber : null;
                if (adc != null) byCluster[cid].a10s[adc] = { id: c.ADCId != null ? c.ADCId : adc, adc: adc };
            });
            return Object.keys(byCluster).map(function (k) {
                var cl = byCluster[k];
                cl.a10s = Object.keys(cl.a10s).map(function (a) { return cl.a10s[a]; });
                return cl;
            });
        }

        // Aggregate live snapshots into per-cluster state + fleet totals.
        function buildModel() {
            var model = state.clusters.map(function (cl) {
                // Match modem records by hex DeviceId first, cluster id as fallback.
                var modemHex = cl.modemId;
                var mTcp = null, mMqtt = null, mSig = null;

                state.live.modem.forEach(function (x) {
                    var mine = (modemHex && x.deviceId && x.deviceId.toUpperCase() === modemHex)
                            || (x.clusterId != null && String(x.clusterId) === String(cl.clusterId));
                    if (!mine) return;
                    var st = onlineFrom(x, false);
                    if (x.typeId === 1) { if (st === 'online' || mTcp == null) mTcp = st; }
                    else if (x.typeId === 2) { if (st === 'online' || mMqtt == null) mMqtt = st; }
                    else { if (st === 'online' || mMqtt == null) mMqtt = st; } // fall back
                    if (mSig == null && x.signal != null && x.signal > 0) mSig = x.signal;
                });

                var a10List = cl.a10s.map(function (a) {
                    var tcp = null, mqtt = null;
                    state.live.a10.forEach(function (x) {
                        var mine = false;
                        if (x.a10Id != null && (String(x.a10Id) === String(a.id) || String(x.a10Id) === String(a.adc))) mine = true;
                        if (x.clusterId != null && String(x.clusterId) === String(cl.clusterId) && x.a10Id == null) mine = mine || false;
                        if (!mine) return;
                        var st = onlineFrom(x, true);
                        if (x.typeId === 1) tcp = tcp === 'online' ? 'online' : st;
                        else if (x.typeId === 2) mqtt = mqtt === 'online' ? 'online' : st;
                        else if (mqtt == null) mqtt = st;
                    });
                    return { id: a.id, adc: a.adc, tcp: tcp, mqtt: mqtt };
                });

                var a10Tot = a10List.length;
                var a10On = a10List.filter(function (a) {
                    return a.tcp === 'online' || a.mqtt === 'online';
                }).length;
                var modemUp = (mTcp === 'online') || (mMqtt === 'online');

                return {
                    cl: cl,
                    m: { tcp: mTcp, mqtt: mMqtt },
                    sig: mSig,
                    modemUp: modemUp,
                    a10Tot: a10Tot,
                    a10On: a10On,
                    a10List: a10List
                };
            });

            // Fleet totals
            var totModems = model.length;
            var modemsUp = model.filter(function (x) { return x.modemUp; }).length;
            var mTcpUp = model.filter(function (x) { return x.m.tcp === 'online'; }).length;
            var mMqttUp = model.filter(function (x) { return x.m.mqtt === 'online'; }).length;
            var a10Tot = 0, aTcpUp = 0, aMqttUp = 0;
            model.forEach(function (x) {
                a10Tot += x.a10Tot;
                aTcpUp += x.a10List.filter(function (a) { return a.tcp === 'online'; }).length;
                aMqttUp += x.a10List.filter(function (a) { return a.mqtt === 'online'; }).length;
            });

            return {
                clusters: model,
                fleet: {
                    totModems: totModems, modemsUp: modemsUp,
                    mTcpUp: mTcpUp, mMqttUp: mMqttUp,
                    a10Tot: a10Tot, aTcpUp: aTcpUp, aMqttUp: aMqttUp
                }
            };
        }

        // ---- Render ------------------------------------------------------------

        function pct(a, b) { return b > 0 ? Math.round(a / b * 100) : 0; }

        function sigBars(dbm) {
            var lvl = 0, cls = 'red';
            if (dbm == null || dbm <= 0) { lvl = 0; cls = 'red'; }
            else {
                if (dbm >= 25) lvl = 5;
                else if (dbm >= 20) lvl = 4;
                else if (dbm >= 15) lvl = 3;
                else if (dbm >= 10) lvl = 2;
                else lvl = 1;
                cls = dbm >= 18 ? 'grn' : (dbm >= 10 ? 'amb' : 'red');
            }
            var out = '<span class="rdpms-ins-sig ' + cls + '">';
            for (var b = 1; b <= 5; b++) out += '<i class="' + (b <= lvl ? 'on' : '') + '"></i>';
            return out + '</span>';
        }

        function renderFleet(built) {
            var f = built.fleet;
            var upPct = pct(f.modemsUp, f.totModems);
            $('#rdpmsInsUpCount').text(f.modemsUp);
            $('#rdpmsInsTotCount').text(f.totModems);
            $('#rdpmsInsUpPct').text(upPct + '%').css('color',
                upPct >= 66 ? 'var(--ins-grn)' : upPct >= 33 ? 'var(--ins-amb)' : 'var(--ins-red)');
            $('#rdpmsInsHbarOn').css('width', upPct + '%');
            $('#rdpmsInsHbarOff').css('width', (100 - upPct) + '%');
            $('#rdpmsInsLegUp').text(f.modemsUp);
            $('#rdpmsInsLegDown').text(Math.max(f.totModems - f.modemsUp, 0));

            var meters = [
                { key: 'mtcp',  val: f.mTcpUp,  tot: f.totModems },
                { key: 'mmqtt', val: f.mMqttUp, tot: f.totModems },
                { key: 'atcp',  val: f.aTcpUp,  tot: f.a10Tot },
                { key: 'amqtt', val: f.aMqttUp, tot: f.a10Tot }
            ];
            meters.forEach(function (mt) {
                var p = pct(mt.val, mt.tot);
                var color = p >= 66 ? 'var(--ins-grn)' : p >= 33 ? 'var(--ins-amb)' : 'var(--ins-red)';
                var $m = $('.rdpms-ins-meter[data-key="' + mt.key + '"]');
                $m.find('.rdpms-ins-m-val b').text(mt.val);
                $m.find('.rdpms-ins-m-val span:first-of-type').text(mt.tot);
                $m.find('.rdpms-ins-m-val .pct').text(p + '%').css('color', color);
                $m.find('.rdpms-ins-m-track span').css({ width: p + '%', background: color });
            });
        }

        function passesFilter(row) {
            var s = state.filter;
            if (s.text) {
                var key = ((row.cl.clusterName || '') + ' ' + (row.cl.modemId || '') + ' ' +
                           row.a10List.map(function (a) { return a.adc || a.id; }).join(' ')).toLowerCase();
                if (key.indexOf(s.text.toLowerCase()) < 0) return false;
            }
            if (s.show === 'online' && !row.modemUp) return false;
            if (s.show === 'offline' && row.modemUp) return false;

            if (s.issue === 'tcp'  && row.m.tcp  === 'online') return false;
            if (s.issue === 'mqtt' && row.m.mqtt === 'online') return false;
            if (s.issue === 'a10'  && !(row.a10Tot > 0 && row.a10On < row.a10Tot)) return false;
            return true;
        }

        function sortRows(rows) {
            if (state.filter.sort === 'name') {
                return rows.sort(function (a, b) {
                    return (a.cl.clusterName || '').localeCompare(b.cl.clusterName || '');
                });
            }
            // issues first: worst state ranks highest
            var rank = function (r) {
                if (!r.modemUp) return 3;
                var deg = (r.m.tcp !== 'online') || (r.m.mqtt !== 'online') || (r.a10Tot > 0 && r.a10On < r.a10Tot);
                return deg ? 2 : 1;
            };
            return rows.sort(function (a, b) {
                return rank(b) - rank(a) ||
                       (a.cl.clusterName || '').localeCompare(b.cl.clusterName || '');
            });
        }

        function renderGrid(built) {
            var rows = built.clusters.filter(passesFilter);
            rows = sortRows(rows);

            if (!rows.length) {
                $('#rdpmsInsGrid').empty().hide();
                $('#rdpmsInsEmpty').show().text(
                    built.clusters.length
                        ? 'No clusters match the current filters.'
                        : 'No clusters returned by the selected sites.');
                return;
            }
            $('#rdpmsInsEmpty').hide();

            var html = rows.map(function (x) {
                var cl = x.cl, m = x.m;
                var stateCls = !x.modemUp ? 'off'
                             : ((m.tcp !== 'online' || m.mqtt !== 'online' ||
                                 (x.a10Tot && x.a10On < x.a10Tot)) ? 'deg' : 'ok');
                var dotCls = !x.modemUp ? 'red' : (stateCls === 'deg' ? 'amb' : 'grn');
                var chTcp  = m.tcp  === 'online' ? 'up' : (m.tcp  == null ? 'na' : 'down');
                var chMqtt = m.mqtt === 'online' ? 'up' : (m.mqtt == null ? 'na' : 'down');
                var covPct = x.a10Tot ? Math.round(x.a10On / x.a10Tot * 100) : 0;
                var covColor = x.a10Tot === 0 ? 'var(--ins-tx4)'
                             : x.a10On === 0 ? 'var(--ins-red)'
                             : x.a10On < x.a10Tot ? 'var(--ins-amb)' : 'var(--ins-grn)';

                var dot = function (st) {
                    var bg = st === 'online' ? 'var(--ins-grn)'
                           : (st === 'down' || st === 'offline') ? 'var(--ins-red)'
                           : '#cbd5e1';
                    return '<span class="rdpms-ins-ad" style="background:' + bg + '"></span>';
                };
                var a10Html;
                if (x.a10List.length) {
                    a10Html = '<div class="rdpms-ins-c-a10grid">' + x.a10List.map(function (a) {
                        return '<span class="rdpms-ins-a10chip" title="A10 ' +
                               (a.adc != null ? a.adc : a.id) + ' — TCP ' + (a.tcp || 'no data') +
                               ', MQTT ' + (a.mqtt || 'no data') + '">' +
                               '<span class="rdpms-ins-a10id">' + (a.adc != null ? a.adc : a.id) + '</span>' +
                               '<span class="rdpms-ins-a10dots">' +
                               '<span class="rdpms-ins-a10p">T' + dot(a.tcp) + '</span>' +
                               '<span class="rdpms-ins-a10p">M' + dot(a.mqtt) + '</span>' +
                               '</span></span>';
                    }).join('') + '</div>';
                } else {
                    a10Html = '<div class="rdpms-ins-c-a10none">No A10 devices in hierarchy</div>';
                }
                var sig = x.sig != null && x.sig > 0
                    ? (sigBars(x.sig) + '<span class="rdpms-ins-c-dbm">' + x.sig + ' dBm</span>')
                    : '<span class="rdpms-ins-c-offlab">OFFLINE</span>';

                // Uptime slot — populated by loadUptime(); starts empty and appears once
                // stats resolve for this cluster.
                var upKey = 'rdpmsInsUp_' + cl.siteId + '_' + cl.clusterId;
                var cached = state.uptime[cl.siteId + '|' + cl.clusterId];
                var upHtml = '';
                if (cached) upHtml = renderClusterUptimeHtml(cached);

                return '<div class="rdpms-ins-cluster ' + stateCls + '" data-site="' + cl.siteId + '" data-cluster="' + cl.clusterId + '">' +
                       '<div class="rdpms-ins-c-top">' +
                         '<span class="rdpms-ins-c-dot ' + dotCls + '"></span>' +
                         '<span class="rdpms-ins-c-name">' + $('<div>').text(cl.clusterName).html() + '</span>' +
                         '<span class="rdpms-ins-c-sig">' + sig + '</span>' +
                       '</div>' +
                       '<div class="rdpms-ins-c-mac">' + (cl.modemId || '?') + '</div>' +
                       '<div class="rdpms-ins-c-chans">' +
                         '<span class="rdpms-ins-ch ' + chTcp + '">TCP</span>' +
                         '<span class="rdpms-ins-ch ' + chMqtt + '">MQTT</span>' +
                       '</div>' +
                       '<div class="rdpms-ins-c-a10hd">' +
                         '<span class="rdpms-ins-c-a10lab">A10s</span>' +
                         '<span class="rdpms-ins-c-a10cnt" style="color:' + covColor + '">' + x.a10On + '/' + x.a10Tot + ' online</span>' +
                       '</div>' + a10Html +
                       '<div class="rdpms-ins-c-uptime" id="' + upKey + '" style="' + (upHtml ? '' : 'display:none;') + '">' + upHtml + '</div>' +
                       '</div>';
            }).join('');

            $('#rdpmsInsGrid').show().html(html);
        }

        function renderAll() {
            var built = buildModel();
            renderFleet(built);
            renderGrid(built);
            $('#rdpmsInsMeta').text('· ' + state.clusters.length + ' clusters · updated ' + fmtNow());
        }

        // ---- Uptime / Downtime -------------------------------------------------
        //
        // Adapted from historian's `lcNwModemUptimeStats` / `lcNwA10UptimeStats`
        // but simplified to sample-percentage semantics: for a fetched history
        // series we count how many samples were "online" and divide by total.
        // Downtime minutes = elapsedMinutesToday * (1 - onlinePct/100).
        //
        // The upstream feeds we hit:
        //   /FRS25/RDPMSHealthLive/GetModemHistoryForGraph?clusterId=…&fromDate=…&toDate=…
        //   /FRS25/RDPMSHealthLive/GetA10History?siteId=…&clusterId=…&startDate=…&endDate=…
        // Date format for GetA10History is ddMMyyyy_HHmmss; for the graph
        // endpoint it is passed through as-is.

        function pad2(n) { return (n < 10 ? '0' : '') + n; }
        function todayStart() { var d = new Date(); d.setHours(0,0,0,0); return d; }
        function elapsedMinsToday() {
            return Math.max(1, Math.round((Date.now() - todayStart().getTime()) / 60000));
        }
        // ddMMyyyy_HHmmss (used by the A10 proxy).
        function fmtDdMmYyyy(dt) {
            return pad2(dt.getDate()) + pad2(dt.getMonth() + 1) + dt.getFullYear() +
                   '_' + pad2(dt.getHours()) + pad2(dt.getMinutes()) + pad2(dt.getSeconds());
        }
        // dd/MM/yyyy HH:mm:ss (used by Product/GetModemHistory).
        function fmtSlashDate(dt) {
            return pad2(dt.getDate()) + '/' + pad2(dt.getMonth() + 1) + '/' + dt.getFullYear() +
                   ' ' + pad2(dt.getHours()) + ':' + pad2(dt.getMinutes()) + ':' + pad2(dt.getSeconds());
        }
        // Format minutes as "Hh Mm" (or "Nm" under an hour).
        function fmtMinutes(min) {
            if (min == null || isNaN(min)) return '—';
            min = Math.round(min);
            if (min <= 0) return '0m';
            if (min < 60) return min + 'm';
            var h = Math.floor(min / 60), m = min - h * 60;
            return h + 'h ' + pad2(m) + 'm';
        }
        function pctClass(p) { return p == null ? 'n' : (p >= 80 ? 'g' : (p >= 50 ? 'a' : 'r')); }

        // Was this sample "online"? TCP is response-time based (>=0 => up).
        // MQTT/A10 is signal/uptime based (>0 => up; -1 => down; null => skip).
        function isOnlineSample(it) {
            var typeId = it.TypeId != null ? it.TypeId : it.typeId;
            if (typeId === 1) {
                var rt = it.ResponseTime != null ? Number(it.ResponseTime) : null;
                if (rt == null || isNaN(rt)) return null;
                return rt >= 0;
            }
            // 2 = MQTT / 3 = OFC MQTT — either Uptime seconds or signal strength.
            var up = it.Uptime != null ? Number(it.Uptime) : null;
            if (up != null && !isNaN(up)) return up > 0;
            var sig = it.SignalStrength != null ? Number(it.SignalStrength)
                    : (it.Signal != null ? Number(it.Signal) : null);
            if (sig == null || isNaN(sig)) return null;
            if (sig < 0) return false;
            return sig > 0;
        }

        // Given an array of history samples, return { up, tot, tcpUp, tcpTot, mqttUp, mqttTot }.
        function tallyHistory(arr) {
            var out = { up: 0, tot: 0, tcpUp: 0, tcpTot: 0, mqttUp: 0, mqttTot: 0 };
            (arr || []).forEach(function (it) {
                var typeId = it.TypeId != null ? it.TypeId : it.typeId;
                var on = isOnlineSample(it);
                if (on == null) return;
                out.tot++;
                if (on) out.up++;
                if (typeId === 1) { out.tcpTot++; if (on) out.tcpUp++; }
                else if (typeId === 2 || typeId === 3) { out.mqttTot++; if (on) out.mqttUp++; }
            });
            return out;
        }

        function fetchModemHistory(clusterId, fromDt, toDt) {
            return $.ajax({
                url: '/FRS25/RDPMSHealthLive/GetModemHistoryForGraph',
                type: 'GET', dataType: 'json',
                data: { clusterId: clusterId, fromDate: fmtSlashDate(fromDt), toDate: fmtSlashDate(toDt) }
            }).then(function (data) {
                return $.isArray(data) ? data : (data && (data.Data || data.data || data.Result) || []);
            }, function () { return []; });
        }
        function fetchA10History(siteId, clusterId, fromDt, toDt) {
            return $.ajax({
                url: '/FRS25/RDPMSHealthLive/GetA10History',
                type: 'GET', dataType: 'json',
                data: {
                    siteId: siteId, clusterId: clusterId,
                    startDate: fmtDdMmYyyy(fromDt), endDate: fmtDdMmYyyy(toDt)
                }
            }).then(function (data) {
                return $.isArray(data) ? data : (data && (data.Data || data.data || data.Result) || []);
            }, function () { return []; });
        }

        // Turn a completed per-cluster stats object into the inline chip row.
        function renderClusterUptimeHtml(u) {
            var chips = '';
            var chip = function (label, pct) {
                if (pct == null) return '<span class="rdpms-ins-up-chip n">' + label + ' —</span>';
                return '<span class="rdpms-ins-up-chip ' + pctClass(pct) + '">' + label + ' <b>' + pct + '%</b></span>';
            };
            chips += chip('M-TCP',  u.tcpPct);
            chips += chip('M-MQTT', u.mqttPct);
            if (u.aTcpTot > 0 || u.aMqttTot > 0) {
                chips += chip('A-TCP',  u.aTcpPct);
                chips += chip('A-MQTT', u.aMqttPct);
            }
            var downMin = u.downMin != null ? u.downMin : 0;
            var upMin = u.upMin != null ? u.upMin : 0;
            var dur = '<span class="rdpms-ins-up-dur" title="Approx uptime / downtime today, from sample percentage">' +
                      '<b class="up">' + fmtMinutes(upMin) + '</b> up · ' +
                      '<b class="down">' + fmtMinutes(downMin) + '</b> down</span>';
            return chips + dur;
        }

        // Aggregate all cached cluster uptime stats into the top availability card.
        function renderFleetAvailability() {
            var keys = Object.keys(state.uptime);
            if (!keys.length) {
                $('#rdpmsInsAvailRail').hide();
                return;
            }
            $('#rdpmsInsAvailRail').show();

            var tcpUp = 0, tcpTot = 0, mqttUp = 0, mqttTot = 0;
            var aTcpUp = 0, aTcpTot = 0, aMqttUp = 0, aMqttTot = 0;
            var upSum = 0, downSum = 0, cnt = 0;
            keys.forEach(function (k) {
                var u = state.uptime[k]; if (!u) return;
                tcpUp += u.tcpUp || 0; tcpTot += u.tcpTot || 0;
                mqttUp += u.mqttUp || 0; mqttTot += u.mqttTot || 0;
                aTcpUp += u.aTcpUp || 0; aTcpTot += u.aTcpTot || 0;
                aMqttUp += u.aMqttUp || 0; aMqttTot += u.aMqttTot || 0;
                if (u.upMin != null && u.downMin != null) {
                    upSum += u.upMin; downSum += u.downMin; cnt++;
                }
            });
            var elapsedMin = elapsedMinsToday();
            var avgUp = cnt ? upSum / cnt : null;
            var avgDown = cnt ? downSum / cnt : null;
            var pct = (avgUp != null && (avgUp + avgDown) > 0)
                ? Math.round(avgUp / (avgUp + avgDown) * 100)
                : null;

            var $big = $('#rdpmsInsAvailPct').removeClass('amb red na');
            if (pct == null) { $big.addClass('na').text('N/A'); }
            else {
                $big.text(pct + '%');
                if (pct < 50) $big.addClass('red');
                else if (pct < 80) $big.addClass('amb');
            }
            $('#rdpmsInsAvailUpDur').text(fmtMinutes(avgUp));
            $('#rdpmsInsAvailDownDur').text(fmtMinutes(avgDown));
            $('#rdpmsInsAvailHbarOn').css('width',  (pct || 0) + '%');
            $('#rdpmsInsAvailHbarOff').css('width', (100 - (pct || 0)) + '%');
            $('#rdpmsInsAvailScope').text('· ' + cnt + '/' + state.clusters.length + ' clusters · elapsed ' + fmtMinutes(elapsedMin));

            var meters = [
                { key: 'utcp',  val: tcpUp,   tot: tcpTot },
                { key: 'ummqt', val: mqttUp,  tot: mqttTot },
                { key: 'uatcp', val: aTcpUp,  tot: aTcpTot },
                { key: 'uamqt', val: aMqttUp, tot: aMqttTot }
            ];
            meters.forEach(function (mt) {
                var p = mt.tot > 0 ? Math.round(mt.val / mt.tot * 100) : null;
                var color = p == null ? 'var(--ins-tx4)'
                          : p >= 80 ? 'var(--ins-grn)'
                          : p >= 50 ? 'var(--ins-amb)'
                          : 'var(--ins-red)';
                var $m = $('#rdpmsInsAvailRail .rdpms-ins-meter[data-key="' + mt.key + '"]');
                $m.find('.rdpms-ins-m-val b').text(mt.val);
                $m.find('.rdpms-ins-m-val span:first-of-type').text(mt.tot);
                $m.find('.rdpms-ins-m-val .pct').text(p == null ? '—' : (p + '%')).css('color', color);
                $m.find('.rdpms-ins-m-track span').css({ width: (p || 0) + '%', background: color });
            });
        }

        // Kick off the uptime pass over every visible cluster. Progressive: each
        // cluster patches its own card the moment its stats resolve.
        var _upGen = 0;
        function loadUptime() {
            if (!state.clusters.length) return;
            var gen = ++_upGen;
            var $btn = $('#rdpmsInsLoadUptime');
            $btn.prop('disabled', true).css({ opacity: .6 });

            var toDt = new Date();
            var fromDt = todayStart();
            var elapsedMin = elapsedMinsToday();

            state.uptime = {};    // fresh pass
            var total = state.clusters.length, done = 0;
            $btn.html('<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10M6 20v-6M18 20V4"/></svg> Loading <span class="prog">0/' + total + '</span>');

            // Sequential batches of 4 so we don't hammer the API on large sites.
            var BATCH = 4;
            var i = 0;
            function runNext() {
                if (gen !== _upGen) return;              // superseded
                if (i >= total) {                        // finished
                    $btn.prop('disabled', false).css({ opacity: '' })
                        .html('<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10M6 20v-6M18 20V4"/></svg> Load Uptime');
                    state.uptimeLoadedAt = Date.now();
                    return;
                }
                var slice = state.clusters.slice(i, i + BATCH);
                i += BATCH;

                var slicePromises = slice.map(function (cl) {
                    var mp = fetchModemHistory(cl.clusterId, fromDt, toDt);
                    var ap = fetchA10History(cl.siteId, cl.clusterId, fromDt, toDt);
                    return $.when(mp, ap).then(function (modemHist, a10Hist) {
                        var m = tallyHistory(modemHist || []);
                        var a = tallyHistory(a10Hist  || []);

                        // Percentage per channel (null when no samples).
                        var tcpPct  = m.tcpTot  > 0 ? Math.round(m.tcpUp  / m.tcpTot  * 100) : null;
                        var mqttPct = m.mqttTot > 0 ? Math.round(m.mqttUp / m.mqttTot * 100) : null;
                        var aTcpPct  = a.tcpTot  > 0 ? Math.round(a.tcpUp  / a.tcpTot  * 100) : null;
                        var aMqttPct = a.mqttTot > 0 ? Math.round(a.mqttUp / a.mqttTot * 100) : null;

                        // Combined pct: prefer whichever protocol has samples.
                        var combinedPct;
                        var totSamp = m.tot + a.tot;
                        if (totSamp > 0) combinedPct = Math.round((m.up + a.up) / totSamp * 100);
                        else combinedPct = null;
                        var downMin = combinedPct == null ? null : Math.round(elapsedMin * (100 - combinedPct) / 100);
                        var upMin   = combinedPct == null ? null : elapsedMin - downMin;

                        var stats = {
                            tcpPct: tcpPct, mqttPct: mqttPct,
                            aTcpPct: aTcpPct, aMqttPct: aMqttPct,
                            tcpUp: m.tcpUp,  tcpTot: m.tcpTot,
                            mqttUp: m.mqttUp, mqttTot: m.mqttTot,
                            aTcpUp: a.tcpUp,  aTcpTot: a.tcpTot,
                            aMqttUp: a.mqttUp, aMqttTot: a.mqttTot,
                            combinedPct: combinedPct,
                            upMin: upMin, downMin: downMin, elapsedMin: elapsedMin
                        };
                        if (gen !== _upGen) return;
                        state.uptime[cl.siteId + '|' + cl.clusterId] = stats;

                        // Patch this cluster's card immediately.
                        var $slot = $('#rdpmsInsUp_' + cl.siteId + '_' + cl.clusterId);
                        if ($slot.length) $slot.html(renderClusterUptimeHtml(stats)).show();

                        done++;
                        $btn.find('.prog').text(done + '/' + total);
                        renderFleetAvailability();
                    });
                });

                $.when.apply($, slicePromises).always(runNext);
            }
            runNext();
        }

        // ---- Public API --------------------------------------------------------

        function attach(siteIds) {
            state.siteIds = ($.isArray(siteIds) ? siteIds : [siteIds])
                .map(function (v) { return parseInt(v, 10); })
                .filter(function (v) { return !isNaN(v) && v > 0; });

            if (!state.siteIds.length) { detach(); return; }

            $('#rdpmsInsightsPanel').show();
            state.attachedAt = Date.now();

            // 1) discover clusters via CardLine for every site (parallel).
            var cardCalls = state.siteIds.map(function (id) {
                return fetchCardLine(id).then(function (rows) { return buildClusterMap(id, rows); });
            });
            $.when.apply($, cardCalls).then(function () {
                state.clusters = [];
                var args = state.siteIds.length === 1 ? [arguments[0]] : Array.prototype.slice.call(arguments);
                args.forEach(function (arr) { if ($.isArray(arr)) state.clusters = state.clusters.concat(arr); });

                // 2) initial live fetch + start refresh loop.
                refresh();
                startTimer();
            });
        }

        function refresh() {
            if (!state.siteIds.length) return;

            // Parallel fetch for every site × (Modem + A10). Each promise resolves
            // to a normalized array; concat all into one array per kind.
            var modemPromises = state.siteIds.map(function (id) { return fetchLive('Modem', id); });
            var a10Promises   = state.siteIds.map(function (id) { return fetchLive('A10',   id); });

            $.when.apply($, modemPromises).then(function () {
                var modem = [];
                var args = state.siteIds.length === 1 ? [arguments[0]] : Array.prototype.slice.call(arguments);
                args.forEach(function (arr) { if ($.isArray(arr)) modem = modem.concat(arr); });

                $.when.apply($, a10Promises).then(function () {
                    var a10 = [];
                    var args2 = state.siteIds.length === 1 ? [arguments[0]] : Array.prototype.slice.call(arguments);
                    args2.forEach(function (arr) { if ($.isArray(arr)) a10 = a10.concat(arr); });

                    state.live = { modem: modem, a10: a10, tcp: [] };
                    renderAll();
                });
            });
        }

        function startTimer() {
            stopTimer();
            state.timer = setInterval(function () { refresh(); }, REFRESH_MS);
        }

        function stopTimer() {
            if (state.timer) { clearInterval(state.timer); state.timer = null; }
        }

        function detach() {
            stopTimer();
            _upGen++; // invalidate any in-flight uptime pass
            state.siteIds = []; state.clusters = [];
            state.live = { modem:[], a10:[], tcp:[] };
            state.uptime = {};
            $('#rdpmsInsAvailRail').hide();
            $('#rdpmsInsightsPanel').hide();
        }

        function toggle() { $('#rdpmsInsightsPanel').toggleClass('collapsed'); }

        // Filter / search wiring — delegated because the segs live inside the panel.
        $(document).on('click', '#rdpmsInsightsPanel .rdpms-ins-seg button', function () {
            var $btn = $(this);
            var group = $btn.closest('.rdpms-ins-seg').attr('data-filter-group');
            var val = $btn.attr('data-v');
            $btn.siblings('button').removeClass('on');
            $btn.addClass('on');
            state.filter[group] = val;
            renderAll();
        });
        $(document).on('input', '#rdpmsInsSearch', function () {
            state.filter.text = String($(this).val() || '').trim();
            renderAll();
        });

        $(window).on('beforeunload', detach);

        window.RdpmsInsights = {
            attach: attach,
            detach: detach,
            refresh: refresh,
            toggle: toggle,
            loadUptime: loadUptime
        };
    })(window, jQuery);
</script>

<script>
    var openDropdown = null;
    var _isDropdownOpen = false;
    var _defaultAssetTypeHtml = null;
    // ==========================================================================
    // TIME PICKER (24-HOUR) STATE
    // ==========================================================================
    var tpCurrentInputId = null;
    var tpSelectedHour = 0;
    var tpSelectedMinute = 0;

    function tpBuildLists() {
        var hrHtml = '';
        for (var h = 0; h < 24; h++) {
            var hh = ('0' + h).slice(-2);
            hrHtml += '<div class="time-picker-item" data-hour="' + h + '">' + hh + '</div>';
        }
        $('#tpHourCol').html(hrHtml);

        var mnHtml = '';
        for (var m = 0; m < 60; m++) {
            var mm = ('0' + m).slice(-2);
            mnHtml += '<div class="time-picker-item" data-minute="' + m + '">' + mm + '</div>';
        }
        $('#tpMinuteCol').html(mnHtml);
    }

    function tpOpen(inputId) {
        tpCurrentInputId = inputId;
        var cur = $('#' + inputId).val().trim();
        var parts = cur.split(':');
        tpSelectedHour = (parts.length === 2 && !isNaN(parseInt(parts[0]))) ? parseInt(parts[0], 10) : 0;
        tpSelectedMinute = (parts.length === 2 && !isNaN(parseInt(parts[1]))) ? parseInt(parts[1], 10) : 0;
        tpUpdateSelection();

        var $input = $('#' + inputId);
        var $popup = $('#timePickerPopup');
        $('body').append($popup);
        var rect = $input[0].getBoundingClientRect();
        $popup.css({ position: 'absolute', visibility: 'hidden', display: 'block', top: '-9999px', left: '-9999px' });
        var popupH = $popup.outerHeight(), popupW = $popup.outerWidth();
        var top = rect.bottom + window.scrollY + 4;
        var left = rect.left + window.scrollX;
        if (top + popupH > window.innerHeight + window.scrollY) top = rect.top + window.scrollY - popupH - 4;
        if (left + popupW > window.innerWidth + window.scrollX) left = window.innerWidth + window.scrollX - popupW - 8;
        if (left < 4) left = 4;
        $popup.css({ visibility: '', display: '', top: top + 'px', left: left + 'px' }).addClass('open');
        setTimeout(function () {
            var $selHr = $('#tpHourCol .time-picker-item.selected');
            var $selMn = $('#tpMinuteCol .time-picker-item.selected');
            if ($selHr.length) $('#tpHourCol').scrollTop($selHr[0].offsetTop - 70);
            if ($selMn.length) $('#tpMinuteCol').scrollTop($selMn[0].offsetTop - 70);
        }, 20);
    }

    function tpUpdateSelection() {
        $('#tpHourCol .time-picker-item').removeClass('selected');
        $('#tpMinuteCol .time-picker-item').removeClass('selected');
        $('#tpHourCol .time-picker-item[data-hour="' + tpSelectedHour + '"]').addClass('selected');
        $('#tpMinuteCol .time-picker-item[data-minute="' + tpSelectedMinute + '"]').addClass('selected');
        $('#tpHour').text(('0' + tpSelectedHour).slice(-2));
        $('#tpMinute').text(('0' + tpSelectedMinute).slice(-2));
    }

    function tpClose() {
        var $popup = $('#timePickerPopup');
        $popup.removeClass('open').css({ display: 'none', top: '-9999px', left: '-9999px', visibility: 'hidden' });
        tpCurrentInputId = null;
    }

    function tpNow(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        var now = new Date();
        tpSelectedHour = now.getHours();
        tpSelectedMinute = now.getMinutes();
        tpUpdateSelection();
        var $selHr = $('#tpHourCol .time-picker-item.selected');
        var $selMn = $('#tpMinuteCol .time-picker-item.selected');
        if ($selHr.length) $('#tpHourCol').scrollTop($selHr[0].offsetTop - 70);
        if ($selMn.length) $('#tpMinuteCol').scrollTop($selMn[0].offsetTop - 70);
        return false;
    }

    function tpClear(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        if (tpCurrentInputId) $('#' + tpCurrentInputId).val('');
        tpClose();
        return false;
    }

    function tpApply(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        if (tpCurrentInputId) {
            var timeStr = ('0' + tpSelectedHour).slice(-2) + ':' + ('0' + tpSelectedMinute).slice(-2);
            $('#' + tpCurrentInputId).val(timeStr);
        }
        tpClose();
        return false;
    }

    $(document).ready(function () {
        _defaultAssetTypeHtml = $('#listAssetType').html(); 
        tpBuildLists();

        $('.select-btn').on('click', function (e) {
            e.stopPropagation();
            toggleDD($(this).data('target'), this);
        });

        $('#backdrop').on('click', closeDD);

        $(document).on('click', '.ms-dropdown-header', function (e) {
            e.stopPropagation();
            var $chk = $(this).find('input[type="checkbox"]');
            var id = $chk.attr('id') || '';
            var type = id.replace('chkAll', '').charAt(0).toLowerCase() + id.replace('chkAll', '').slice(1);
            if ($(e.target).is('input[type="checkbox"]') || $(e.target).is('label')) {
                setTimeout(function () { msSelectAll(type, $chk.prop('checked')); }, 0);
            } else {
                var newState = !$chk.prop('checked');
                $chk.prop('checked', newState);
                msSelectAll(type, newState);
            }
        });

        $(document).on('click', '.ms-dropdown-item', function (e) {
            e.stopPropagation();
            var $cb = $(this).find('input[type="checkbox"]');
            if (!$(e.target).is('input[type="checkbox"]')) $cb.prop('checked', !$cb.prop('checked'));
            $(this).toggleClass('checked', $cb.prop('checked'));
            var type = ($cb.attr('class') || '').replace('cb-', '');
            msUpdateSelectAllState(type);
            msUpdateText(type);
            onFilterChange(type);
        });

        $(document).on('click', '.ms-dropdown-search', function (e) { e.stopPropagation(); });

        // TIME PICKER EVENTS
        $(document).on('click', '.time-24', function (e) {
            e.stopPropagation();
            tpOpen(this.id);
        });

        $(document).on('click', '#tpHourCol .time-picker-item', function (e) {
            e.stopPropagation();
            tpSelectedHour = parseInt($(this).data('hour'), 10);
            tpUpdateSelection();
        });

        $(document).on('click', '#tpMinuteCol .time-picker-item', function (e) {
            e.stopPropagation();
            tpSelectedMinute = parseInt($(this).data('minute'), 10);
            tpUpdateSelection();
        });

        $(document).on('mousedown', function (e) {
            if ($('#timePickerPopup').hasClass('open')) {
                var $target = $(e.target);
                if ($target.closest('#timePickerPopup').length === 0 &&
                    !$target.hasClass('time-24') &&
                    $target.closest('.time-24-wrapper').length === 0) {
                    tpClose();
                }
            }
        });

        $(document).on('keydown', function (e) {
            if (e.key === 'Escape' && $('#timePickerPopup').hasClass('open')) tpClose();
        });

        // Default dates/times
        var today = new Date();
        $('#txtFromDate').val(formatDateForInput(today));
        $('#txtToDate').val(formatDateForInput(today));
        $('#txtFromTime').val('00:00');
        $('#txtToTime').val(formatTimeForInput(today));

        // Init datepickers (DD/MM/YYYY display)
        $('#txtFromDate').datepicker({ dateFormat: 'dd/mm/yyyy', autoClose: true });
        $('#txtToDate').datepicker({ dateFormat: 'dd/mm/yyyy', autoClose: true });

        $('#drpView').change(function () {
            renderRdpmsView($(this).val());
        });

        $(window).on('resize', function () {
            if (openDropdown) closeDD();
            if ($('#timePickerPopup').hasClass('open')) tpClose();
        });
    });

    // ==========================================================================
    // MULTI-SELECT HELPERS
    // ==========================================================================
    function toggleDD(id, btn) {
        if (openDropdown === id) { closeDD(); _isDropdownOpen = false; return; }
        closeDD(); _isDropdownOpen = true;

        var $dd = $('#' + id);
        $('body').append($dd);
        var rect = btn.getBoundingClientRect();
        $dd.css({ position: 'absolute', visibility: 'hidden', display: 'block', top: '-9999px', left: '-9999px' });
        var h = $dd.outerHeight(), w = $dd.outerWidth();
        var top = rect.bottom + window.scrollY + 4;
        var left = rect.left + window.scrollX;
        if (top + h > window.innerHeight + window.scrollY) top = rect.top + window.scrollY - h - 4;
        if (left + w > window.innerWidth + window.scrollX) left = window.innerWidth + window.scrollX - w - 8;
        if (left < 4) left = 4;
        $dd.css({ visibility: '', display: '', top: top + 'px', left: left + 'px' }).addClass('open');
        $(btn).addClass('active');
        $('#backdrop').addClass('show');
        openDropdown = id;
        setTimeout(function () { $dd.find('.dropdown-search input').focus(); }, 100);
    }

    function closeDD() {
        if (!openDropdown) return;
        var $dd = $('#' + openDropdown);
        $dd.find('.dropdown-search input').val('');
        $dd.find('.dropdown-item').removeClass('hidden');
        $dd.find('.dropdown-no-results').removeClass('show');
        $dd.find('.dropdown-item').each(function () {
            var t = $(this).data('text');
            if (t) $(this).find('span').text(t);
        });
        $dd.removeClass('open').css({ top: '-9999px', left: '-9999px', display: 'none', visibility: 'hidden' });
        $('.select-btn').removeClass('active');
        $('#backdrop').removeClass('show');
        openDropdown = null;
        _isDropdownOpen = false;
    }

    function msSelectAll(type, checked) {
        $('.cb-' + type).each(function () {
            var $item = $(this).closest('.ms-dropdown-item');
            if (!$item.hasClass('hidden')) {
                $(this).prop('checked', checked);
                $item.toggleClass('checked', checked);
            }
        });
        msUpdateText(type);
        onFilterChange(type);
    }

    function msUpdateSelectAllState(type) {
        var $visible = $('#list' + capitalize(type) + ' .ms-dropdown-item:not(.hidden)');
        var total = $visible.length;
        var checked = $visible.find('.cb-' + type + ':checked').length;
        $('#chkAll' + capitalize(type)).prop('checked', total > 0 && total === checked);
    }

    function msUpdateText(type) {
        var $checked = $('.cb-' + type + ':checked');
        var count = $checked.length;
        var text = 'All';
        if (count === 1) {
            text = $checked.first().closest('.ms-dropdown-item').data('text') ||
                $checked.first().closest('.ms-dropdown-item').find('span').text();
        } else if (count > 1) {
            text = count + ' selected';
        }
        $('#txt' + capitalize(type)).text(text);
    }

    function getValues(type) {
        var vals = [];
        $('.cb-' + type + ':checked').each(function () { vals.push($(this).val()); });
        return vals;
    }

    function capitalize(str) {
        return str.charAt(0).toUpperCase() + str.slice(1);
    }

    function filterMsDropdown(type, searchText) {
        var $dropdown = $('#dd' + capitalize(type));
        var $items = $dropdown.find('.ms-dropdown-item');
        var $noResults = $dropdown.find('.ms-dropdown-no-results');
        var search = searchText.toLowerCase().trim();
        var visible = 0;

        $items.each(function () {
            var $item = $(this);
            var text = ($item.data('text') || $item.find('span').text()).toLowerCase();
            if (search === '' || text.indexOf(search) > -1) {
                $item.removeClass('hidden');
                visible++;
                if (search !== '') {
                    var orig = $item.data('text') || $item.find('span').text();
                    var regex = new RegExp('(' + escapeRegex(searchText) + ')', 'gi');
                    $item.find('span').html(orig.replace(regex, '<mark>$1</mark>'));
                } else {
                    var origText = $item.data('text');
                    if (origText) $item.find('span').text(origText);
                }
            } else {
                $item.addClass('hidden');
            }
        });

        $noResults.toggleClass('show', visible === 0 && search !== '');
    }

    function escapeRegex(s) {
        return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    // ==========================================================================
    // CASCADING FILTERS
    // ==========================================================================
    function onFilterChange(type) {
        if (type === 'zone') loadDivisions();
        else if (type === 'division') loadSites();
        else if (type === 'site') loadAssetTypes();  // ← ADD THIS
    }

    function loadDivisions() {
        var zoneIds = getValues('zone');
        $('#listDivision').html('<div class="ms-dropdown-empty">Loading...</div>');
        $('#chkAllDivision').prop('checked', false);
        $('#txtDivision').text('All');
        $('#listSite').html('<div class="ms-dropdown-empty">Select Division first</div>');
        $('#chkAllSite').prop('checked', false);
        $('#txtSite').text('All');

        if (zoneIds.length === 0) {
            $('#listDivision').html('<div class="ms-dropdown-empty">Select Zone first</div>');
            return;
        }

        $.ajax({
            url: '/FRS25/AlertLive/GetDivisionByZoneId',
            type: 'POST',
            data: JSON.stringify({ SearchCriteria: { ZoneIds: zoneIds } }),
            contentType: 'application/json',
            success: function (data) {
                if (data && data.length > 0) {
                    var html = '';
                    $.each(data, function (k, v) {
                        html += '<div class="ms-dropdown-item" data-value="' + v.Id + '" data-text="' + v.Name + '">';
                        html += '<input type="checkbox" class="cb-division" value="' + v.Id + '">';
                        html += '<span>' + v.Name + '</span></div>';
                    });
                    $('#listDivision').html(html);
                } else {
                    $('#listDivision').html('<div class="ms-dropdown-empty">No divisions found</div>');
                }
            },
            error: function () {
                $('#listDivision').html('<div class="ms-dropdown-empty">Error loading divisions</div>');
            }
        });
    }

    function loadSites() {
        var divisionIds = getValues('division');
        $('#listSite').html('<div class="ms-dropdown-empty">Loading...</div>');
        $('#chkAllSite').prop('checked', false);
        $('#txtSite').text('All');

        if (divisionIds.length === 0) {
            $('#listSite').html('<div class="ms-dropdown-empty">Select Division first</div>');
            return;
        }

        $.ajax({
            url: '/FRS25/AlertLive/GetSiteByDivisionId',
            type: 'POST',
            data: JSON.stringify({ SearchCriteria: { DivisionIds: divisionIds } }),
            contentType: 'application/json',
            success: function (data) {
                if (data && data.length > 0) {
                    var html = '';
                    $.each(data, function (k, v) {
                        html += '<div class="ms-dropdown-item" data-value="' + v.Id + '" data-text="' + v.Name + '">';
                        html += '<input type="checkbox" class="cb-site" value="' + v.Id + '">';
                        html += '<span>' + v.Name + '</span></div>';
                    });
                    $('#listSite').html(html);
                } else {
                    $('#listSite').html('<div class="ms-dropdown-empty">No sites found</div>');
                }
            },
            error: function () {
                $('#listSite').html('<div class="ms-dropdown-empty">Error loading sites</div>');
            }
        });
    }

    function loadAssetTypes() {
        var siteIds = getValues('site');

        // Reset selection state
        $('#chkAllAssetType').prop('checked', false);
        $('#txtAssetType').text('All');

        // No station selected → restore ViewBag defaults
        if (siteIds.length === 0) {
            $('#listAssetType').html(_defaultAssetTypeHtml);
            return;
        }

        // Station(s) selected → load filtered asset types via AJAX
        $('#listAssetType').html(
            '<div class="ms-dropdown-empty">Loading...</div>'
            // ↑ NOTE: ms-dropdown-empty (not dropdown-empty) for this page
        );

        $.ajax({
            url: '/FRS25/RDPMSHealthLive/GetAssetTypeBySiteIds',
            type: 'POST',
            data: JSON.stringify(siteIds),
            contentType: 'application/json',
            success: function (data) {
                if (data && data.length > 0) {
                    var html = '';
                    $.each(data, function (key, value) {
                        html += '<div class="ms-dropdown-item" data-value="' + value.Id +
                            '" data-text="' + value.Name + '">';
                        html += '<input type="checkbox" class="cb-assetType" value="' +
                            value.Id + '">';
                        html += '<span>' + value.Name + '</span>';
                        html += '</div>';
                    });
                    $('#listAssetType').html(html);
                } else {
                    $('#listAssetType').html(
                        '<div class="ms-dropdown-empty">No asset types found</div>'
                    );
                }
            },
            error: function () {
                $('#listAssetType').html(_defaultAssetTypeHtml);
            }
        });
    }

    // ==========================================================================
    // MAIN SEARCH
    // ==========================================================================
    function fnGetRDPMSHealthLiveReport() {
        var fromDate = $('#txtFromDate').val();
        var toDate = $('#txtToDate').val();

        if (!fromDate) { showWarning('Please select From Date.', 'Validation'); return; }
        if (!toDate) { showWarning('Please select To Date.', 'Validation'); return; }

        // ── Future date/time validation ──
        var now = new Date();

        var fParts = fromDate.split('/'); // DD/MM/YYYY
        var fromTimeParts = ($('#txtFromTime').val() || '00:00').split(':');
        var fromDateTime = new Date(
            parseInt(fParts[2]),
            parseInt(fParts[1]) - 1,
            parseInt(fParts[0]),
            parseInt(fromTimeParts[0] || 0),
            parseInt(fromTimeParts[1] || 0),
            0
        );

        var tParts = toDate.split('/'); // DD/MM/YYYY
        var toTimeParts = ($('#txtToTime').val() || '00:00').split(':');
        var toDateTime = new Date(
            parseInt(tParts[2]),
            parseInt(tParts[1]) - 1,
            parseInt(tParts[0]),
            parseInt(toTimeParts[0] || 0),
            parseInt(toTimeParts[1] || 0),
            0
        );

        if (fromDateTime > now) {
            showWarning('From Date & Time cannot be a future date and time.', 'Validation');
            return;
        }

        if (toDateTime > now) {
            showWarning('To Date & Time cannot be a future date and time.', 'Validation');
            return;
        }

        if (fromDateTime > toDateTime) {
            showWarning('From Date & Time must be less than or equal to To Date & Time.', 'Validation');
            return;
        }

        var m = { SearchCriteria: {} };
        m.SearchCriteria.ZoneIds = getValues('zone');
        m.SearchCriteria.DivisionIds = getValues('division');
        m.SearchCriteria.SiteIds = getValues('site');
        m.SearchCriteria.AssetTypeIds = getValues('assetType');
        m.SearchCriteria.FromDate = toServerDate(fromDate);
        m.SearchCriteria.FromTime = $('#txtFromTime').val();
        m.SearchCriteria.ToDate = toServerDate(toDate);
        m.SearchCriteria.ToTime = $('#txtToTime').val();
        m.SearchCriteria.View = $('#drpView').val();

        if (!m.SearchCriteria.SiteIds || m.SearchCriteria.SiteIds.length <= 0) {
            alert('Station is required');
            return;
        }

        $('#divRDPMSHealthLive').html(
            '<div class="text-center p-5">' +
            '<i class="fas fa-spinner fa-spin fa-2x text-primary"></i>' +
            '<br/><small class="text-muted mt-2">Loading data...</small>' +
            '</div>'
        );

        $.ajax({
            url: '/FRS25/RDPMSHealthLive/_Detail',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(m),
            dataType: 'html',
            success: function (data) {
                $("#divRDPMSHealthLive").empty().append(data);
                var view = $('#drpView').val();
                if (typeof renderRdpmsView === 'function') {
                    renderRdpmsView(view);
                    updateRangeBar();
                }

                /* Wire up the Insights panel: uses the same selected stations
                   as the summary. Detaches any previous session first so we
                   never leak polling timers across searches. */
                if (window.RdpmsInsights) {
                    window.RdpmsInsights.detach();
                    window.RdpmsInsights.attach(m.SearchCriteria.SiteIds);
                }
            },
            error: function () {
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    // ==========================================================================
    // DATE / TIME HELPERS
    // ==========================================================================
    function formatDateForInput(date) {
        var d = ('0' + date.getDate()).slice(-2);
        var m = ('0' + (date.getMonth() + 1)).slice(-2);
        var y = date.getFullYear();
        return d + '/' + m + '/' + y;
    }
    function toServerDate(ddmmyyyy) {
        if (!ddmmyyyy) return '';
        var parts = ddmmyyyy.split('/');
        if (parts.length !== 3) return ddmmyyyy;
        return parts[1] + '/' + parts[0] + '/' + parts[2]; // MM/DD/YYYY
    }

    function formatTimeForInput(date) {
        return ('0' + date.getHours()).slice(-2) + ':' + ('0' + date.getMinutes()).slice(-2);
    }
</script>
