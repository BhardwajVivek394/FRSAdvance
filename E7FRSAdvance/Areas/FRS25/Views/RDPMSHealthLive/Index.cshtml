@{
    ViewBag.Title = "RDPMS Health Live";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}
<style>
    .search-section {
        padding: 20px 0px;
        position: relative;
        z-index: 100;
    }

    .search-title {
        font-size: 18px;
        font-weight: 600;
        color: #333;
        margin-bottom: 20px;
    }

    .filter-row {
        display: flex;
        align-items: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        position: relative;
        z-index: 100;
    }

    .filter-item {
        flex-shrink: 0;
        position: relative;
        z-index: 100;
    }

        .filter-item label {
            display: block;
            font-size: 13px;
            color: #555;
            margin-bottom: 6px;
            font-weight: 500;
        }

    .select-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        color: #333;
        cursor: pointer;
        min-width: 230px;
        height: 40px;
    }

        .select-btn:hover {
            border-color: #999;
        }

        .select-btn.active {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59,130,246,.2);
        }

        .select-btn .text {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: left;
        }

        .select-btn i {
            margin-left: 8px;
            font-size: 12px;
            color: #666;
        }

    .filter-dropdown {
        position: fixed;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 6px 24px rgba(0,0,0,.18);
        min-width: 260px;
        max-width: 320px;
        z-index: 9999;
        display: none;
    }

        .filter-dropdown.open {
            display: block;
        }

    .dropdown-search {
        padding: 10px 12px;
        border-bottom: 1px solid #e0e0e0;
    }

        .dropdown-search input {
            width: 100%;
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 13px;
            outline: none;
            transition: border-color .2s;
        }

            .dropdown-search input:focus {
                border-color: #3b82f6;
            }

            .dropdown-search input::placeholder {
                color: #aaa;
            }

    .dropdown-header {
        padding: 10px 14px;
        background: #f5f5f5;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .dropdown-header input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #3b82f6;
        }

        .dropdown-header label {
            font-size: 14px;
            font-weight: 600;
            color: #333;
            cursor: pointer;
            margin: 0;
        }

    .dropdown-list {
        max-height: 250px;
        overflow-y: auto;
    }

    .dropdown-item {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
        transition: background .15s;
    }

        .dropdown-item:last-child {
            border-bottom: none;
        }

        .dropdown-item:hover {
            background: #f5f7fa;
        }

        .dropdown-item.checked {
            background: #e8f2ff;
        }

        .dropdown-item.hidden {
            display: none;
        }

        .dropdown-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #3b82f6;
            flex-shrink: 0;
        }

        .dropdown-item span {
            font-size: 14px;
            color: #333;
        }

        .dropdown-item.checked span {
            color: #1d4ed8;
            font-weight: 500;
        }

        .dropdown-item span mark {
            background: #fef08a;
            color: #333;
            padding: 0;
            border-radius: 2px;
        }

    .dropdown-empty {
        padding: 25px;
        text-align: center;
        color: #888;
        font-size: 14px;
    }

    .dropdown-no-results {
        padding: 20px;
        text-align: center;
        color: #999;
        font-size: 13px;
        display: none;
    }

        .dropdown-no-results.show {
            display: block;
        }

    .btn-search {
        background: var(--primary);
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        color: #fff;
        font-size: 14px;
        font-weight: 500;
        transition: background .2s;
    }

        .btn-search:hover {
            background: var(--primary);
        }

    .dropdown-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9998;
        display: none;
    }

        .dropdown-backdrop.show {
            display: block;
        }

    .pic-sensor-toggle {
        margin-top: 6px;
    }

    .pic-see-more-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: none;
        border: 1px solid #e2e8f0;
        border-radius: 6px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
        color: #378ADD;
        cursor: pointer;
        transition: background .15s, border-color .15s;
    }

        .pic-see-more-btn:hover {
            background: #e8f1fb;
            border-color: #378ADD;
        }

        .pic-see-more-btn svg {
            flex-shrink: 0;
            transition: transform .2s;
        }

    .tbl-sensor-wrap {
        display: flex;
        flex-direction: column; /* stack every faulty sensor of the asset */
        align-items: center;
        justify-content: center;
    }

    .tbl-sensor-item {
        text-align: center;
        padding: 2px;
    }

        .tbl-sensor-item + .tbl-sensor-item {
            border-top: 1px solid #f1f5f9;
            padding-top: 8px;
        }

    .tbl-sensor-badge {
        display: inline-block;
        background: #fee2e2;
        color: #dc2626;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 12px;
        border-radius: 10px;
        margin-bottom: 4px;
    }

    .tbl-sensor-name {
        font-size: 12.5px;
        font-weight: 600;
        color: #1e293b;
        line-height: 1.3;
    }

    .tbl-sensor-time {
        font-size: 10.5px;
        color: #94a3b8;
        margin-top: 2px;
    }
    /* Faulty date-time shown under the IoT / Network badge in the table
       view (issue 13). Matches the sensor cell's timestamp styling. */
    .tbl-net-time {
        font-size: 10.5px;
        color: #94a3b8;
        margin-top: 3px;
        white-space: nowrap;
    }

    /* Network cell — Wired (OFC) / Wireless (4G) bifurcation. One leg per
       medium so a cluster that has lost only one no longer reads as a single
       rolled-up badge. */
    .tbl-net-split {
        display: inline-block;
        text-align: left;
        min-width: 138px;
    }

    .tbl-net-leg {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        line-height: 1.25;
    }

    .tbl-net-leg-label {
        font-size: 10px;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .tbl-net-leg-wrap + .tbl-net-leg-wrap {
        margin-top: 4px;
        padding-top: 4px;
        border-top: 1px dashed #e2e8f0;
    }

    .sensor-clone-row {
        background: #fafbfc;
    }

        .sensor-clone-row td {
            border-top: none !important;
        }
</style>

<!-- Aurora UI refinement overlay for RDPMS Health Live (targets _List markup). Loaded after the inline <style> so it wins ties; ~/ is resolved by Razor. -->
<link href="~/Areas/FRS25/assets/css/rdpms-health-live-ui.css" rel="stylesheet" />
<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="row">
                        <div class="col-12 col-sm-5">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">RDPMS</li>
                                    <li class="breadcrumb-item active" aria-current="page"><a href="#">RDPMS Health Live</a></li>
                                </ol>
                            </nav>
                        </div>
                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                            <h2 class="page-name">RDPMS Health Live</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="search-section">
                        @*<div class="search-title">Search</div>*@

                        <div class="dropdown-backdrop" id="backdrop"></div>

                        <div class="filter-row">
                            <!-- Zone -->
                            <div class="filter-item">
                                <label>Zone</label>
                                <div class="select-btn" id="btnZone" data-target="ddZone">
                                    <span class="text" id="txtZone">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>
                            <!-- Division -->
                            <div class="filter-item">
                                <label>Division</label>
                                <div class="select-btn" id="btnDivision" data-target="ddDivision">
                                    <span class="text" id="txtDivision">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>
                            <!-- Station -->
                            <div class="filter-item">
                                <label>Station</label>
                                <div class="select-btn" id="btnSite" data-target="ddSite">
                                    <span class="text" id="txtSite">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>
                            <!-- Asset Type -->
                            <div class="filter-item">
                                <label>Asset Type</label>
                                <div class="select-btn" id="btnAssetType" data-target="ddAssetType">
                                    <span class="text" id="txtAssetType">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>
                            <!-- View dropdown — id="selView" wires to fnToggleView -->
                            <div class="filter-item">
                                <label for="selView">View</label>
                                <select class="form-control" id="selView" onchange="fnToggleView(this.value)">
                                    <option value="Table">Table</option>
                                    <option value="Pictorial">Pictorial</option>
                                </select>
                            </div>
                            <!-- Search button -->
                            <div class="filter-item">
                                <label>&nbsp;</label>
                                <button type="button" class="btn-search" onclick="fnGetAlertDetailReport(0)">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- DROPDOWNS -->
                    <div class="filter-dropdown" id="ddZone">
                        <div class="dropdown-search"><input type="text" placeholder="Search zone..." onkeyup="filterDropdown('zone', this.value)"></div>
                        <div class="dropdown-header"><input type="checkbox" id="chkAllZone"><label for="chkAllZone">Select All</label></div>
                        <div class="dropdown-list" id="listZone">
                            @if (ViewBag.Zones != null)
                            {
                                foreach (var zone in (IEnumerable<SelectListItem>
                                    )ViewBag.Zones)
                                {
                                    <div class="dropdown-item" data-value="@zone.Value" data-text="@zone.Text">
                                        <input type="checkbox" class="cb-zone" value="@zone.Value">
                                        <span>@zone.Text</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>

                    <div class="filter-dropdown" id="ddDivision">
                        <div class="dropdown-search"><input type="text" placeholder="Search division..." onkeyup="filterDropdown('division', this.value)"></div>
                        <div class="dropdown-header"><input type="checkbox" id="chkAllDivision"><label for="chkAllDivision">Select All</label></div>
                        <div class="dropdown-list" id="listDivision">
                            @if (ViewBag.Divisions != null)
                            {
                                foreach (var division in (IEnumerable<SelectListItem>
                                    )ViewBag.Divisions)
                                {
                                    <div class="dropdown-item" data-value="@division.Value" data-text="@division.Text">
                                        <input type="checkbox" class="cb-division" value="@division.Value">
                                        <span>@division.Text</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>

                    <div class="filter-dropdown" id="ddSite">
                        <div class="dropdown-search"><input type="text" placeholder="Search station..." onkeyup="filterDropdown('site', this.value)"></div>
                        <div class="dropdown-header"><input type="checkbox" id="chkAllSite"><label for="chkAllSite">Select All</label></div>
                        <div class="dropdown-list" id="listSite">
                            @if (ViewBag.Sites != null)
                            {
                                foreach (var site in (IEnumerable<SelectListItem>
                                    )ViewBag.Sites)
                                {
                                    <div class="dropdown-item" data-value="@site.Value" data-text="@site.Text">
                                        <input type="checkbox" class="cb-site" value="@site.Value">
                                        <span>@site.Text</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>

                    <div class="filter-dropdown" id="ddAssetType">
                        <div class="dropdown-search"><input type="text" placeholder="Search asset type..." onkeyup="filterDropdown('assetType', this.value)"></div>
                        <div class="dropdown-header"><input type="checkbox" id="chkAllAssetType"><label for="chkAllAssetType">Select All</label></div>
                        <div class="dropdown-list" id="listAssetType">
                            @if (ViewBag.AssetTypes != null)
                            {
                                foreach (var assettype in (IEnumerable<SelectListItem>
                                    )ViewBag.AssetTypes)
                                {
                                    <div class="dropdown-item" data-value="@assettype.Value" data-text="@assettype.Text">
                                        <input type="checkbox" class="cb-assetType" value="@assettype.Value">
                                        <span>@assettype.Text</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>

                    <div id="divRDPMSHealthLive"></div>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    /*
     * Use the same SSL/non-SSL WebSocket configuration pattern as
     * Telemetry Live.
     *
     * HTTP page:
     *   WebSocketBaseUrl
     *
     * HTTPS page:
     *   WebSocketBaseUrlSSL
     */
    window.RDPMS_HEALTH_IS_SECURE =
        window.location.protocol === 'https:';

    window.RDPMS_HEALTH_WS_BASE =
        window.RDPMS_HEALTH_IS_SECURE
            ? '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrlSSL"]'
            : '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrl"]';

    window.RDPMS_HEALTH_WS_TOKEN =
        '@System.Configuration.ConfigurationManager.AppSettings["WebSocketAuthToken"]';
</script>

<script src="~/Areas/FRS25/assets/PageJs/RDPMSHealth/rdpms-health-live-socket.js"></script>

<script>
    var openDropdown = null;
    var _isDropdownOpen = false;
    var _defaultAssetTypeHtml = null;

    $(document).ready(function () {
        _defaultAssetTypeHtml = $('#listAssetType').html();

        $('.select-btn').on('click', function (e) {
            e.stopPropagation();
            toggleDD($(this).data('target'), this);
        });

        $('#backdrop').on('click', closeDD);

        $(document).on('click', '.dropdown-item', function (e) {
            e.stopPropagation();
            var $cb = $(this).find('input[type="checkbox"]');
            if (!$(e.target).is('input[type="checkbox"]')) $cb.prop('checked', !$cb.prop('checked'));
            $(this).toggleClass('checked', $cb.prop('checked'));
            var type = ($cb.attr('class') || '').replace('cb-', '');
            updateSelectAllState(type); updateText(type); onFilterChange(type);
        });

        $(document).on('click', '.dropdown-header', function (e) {
            e.stopPropagation();
            var $chk = $(this).find('input[type="checkbox"]');
            if ($(e.target).is('input[type="checkbox"]') || $(e.target).is('label')) {
                var id = $chk.attr('id') || '';
                var type = id.replace('chkAll', '').charAt(0).toLowerCase() + id.replace('chkAll', '').slice(1);
                selectAll(type, $chk.prop('checked')); return;
            }
            var ns = !$chk.prop('checked'); $chk.prop('checked', ns);
            var id = $chk.attr('id') || '';
            var type = id.replace('chkAll', '').charAt(0).toLowerCase() + id.replace('chkAll', '').slice(1);
            selectAll(type, ns);
        });

        $(document).on('click', '.dropdown-search', function (e) { e.stopPropagation(); });
    });

    /* ── View toggle ── */
    function fnToggleView(val) {
        if (typeof window.fnSwitchView === 'function') window.fnSwitchView(val);
    }

    /* ── Dropdown helpers ── */
    function filterDropdown(type, searchText) {
        var $dd = $('#dd' + capitalize(type));
        var $items = $dd.find('.dropdown-item'), $nr = $dd.find('.dropdown-no-results');
        var search = searchText.toLowerCase().trim(), vis = 0;
        $items.each(function () {
            var $i = $(this), text = ($i.data('text') || $i.find('span').text()).toLowerCase();
            if (search === '' || text.indexOf(search) > -1) {
                $i.removeClass('hidden'); vis++;
                if (search !== '') {
                    var orig = $i.data('text') || $i.find('span').text();
                    $i.find('span').html(orig.replace(new RegExp('(' + escapeRegex(searchText) + ')', 'gi'), '<mark>$1</mark>'));
                } else { var ot = $i.data('text'); if (ot) $i.find('span').text(ot); }
            } else { $i.addClass('hidden'); }
        });
        vis === 0 && search !== '' ? $nr.addClass('show') : $nr.removeClass('show');
    }

    function escapeRegex(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

    function toggleDD(id, btn) {
        if (openDropdown === id) { closeDD(); _isDropdownOpen = false; return; }
        closeDD(); _isDropdownOpen = true;
        var $dd = $('#' + id);
        $('body').append($dd);
        $dd.css({ position:'absolute', visibility:'hidden', display:'block', top:'-9999px', left:'-9999px' });
        var h = $dd.outerHeight(), w = $dd.outerWidth(), rect = btn.getBoundingClientRect();
        var top = rect.bottom + 4, left = rect.left;
        if (top + h > window.innerHeight) top = rect.top - h - 4;
        if (left + w > window.innerWidth) left = window.innerWidth - w - 8;
        $dd.css({ visibility:'', display:'', top:top+'px', left:left+'px' });
        $dd.addClass('open'); $(btn).addClass('active'); $('#backdrop').addClass('show'); openDropdown = id;
        setTimeout(function () { $dd.find('.dropdown-search input').focus(); }, 100);
    }

    function closeDD() {
        if (!openDropdown) return;
        var $dd = $('#' + openDropdown);
        $dd.find('.dropdown-search input').val('');
        $dd.find('.dropdown-item').removeClass('hidden');
        $dd.find('.dropdown-no-results').removeClass('show');
        $dd.find('.dropdown-item').each(function () { var t=$(this).data('text'); if(t) $(this).find('span').text(t); });
        $dd.removeClass('open'); $('.select-btn').removeClass('active'); $('#backdrop').removeClass('show'); openDropdown = null;
    }

    function selectAll(type, checked) {
        $('.cb-' + type).each(function () {
            var $i = $(this).closest('.dropdown-item');
            if (!$i.hasClass('hidden')) { $(this).prop('checked', checked); $i.toggleClass('checked', checked); }
        });
        updateText(type); onFilterChange(type);
    }

    function updateSelectAllState(type) {
        var $v = $('#list' + capitalize(type) + ' .dropdown-item:not(.hidden)');
        $('#chkAll' + capitalize(type)).prop('checked', $v.length > 0 && $v.length === $v.find('.cb-' + type + ':checked').length);
    }

    function updateText(type) {
        var $c = $('.cb-' + type + ':checked'), cnt = $c.length, text = 'All';
        if (cnt === 1) text = $c.first().closest('.dropdown-item').data('text') || $c.first().closest('.dropdown-item').find('span').text();
        else if (cnt > 1) text = cnt + ' selected';
        $('#txt' + capitalize(type)).text(text);
    }

    function getValues(type) { var v=[]; $('.cb-'+type+':checked').each(function(){ v.push($(this).val()); }); return v; }
    function capitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

    function onFilterChange(type) {
        if (type === 'zone') loadDivisions();
        else if (type === 'division') loadSites();
        else if (type === 'site') loadAssetTypes();
       else if (type === 'assetType' &&
    typeof window.rdpmsRecomputeHeaderCounts === 'function') {
    /*
     * Run after the checkbox/select-all click has completely finished.
     * This guarantees the header reads the FINAL Asset-Type selection.
     */
    setTimeout(function () {
        window.rdpmsRecomputeHeaderCounts();
    }, 0);
}
    }

    function loadDivisions() {
        var zoneIds = getValues('zone');
        $('#listDivision').html('<div class="dropdown-empty">Loading...</div>');
        $('#chkAllDivision').prop('checked', false); $('#txtDivision').text('All');
        $('#listSite').html('<div class="dropdown-empty">Select Division first</div>');
        $('#chkAllSite').prop('checked', false); $('#txtSite').text('All');
        if (zoneIds.length === 0) { $('#listDivision').html('<div class="dropdown-empty">Select Zone first</div>'); return; }
        $.ajax({
            url: '/FRS25/AlertLive/GetDivisionByZoneId', type: 'POST',
            data: JSON.stringify({ SearchCriteria: { ZoneIds: zoneIds } }), contentType: 'application/json',
            success: function (data) {
                if (data && data.length > 0) {
                    var h=''; $.each(data, function(k,v){ h+='<div class="dropdown-item" data-value="'+v.Id+'" data-text="'+v.Name+'"><input type="checkbox" class="cb-division" value="'+v.Id+'"><span>'+v.Name+'</span></div>'; });
                    $('#listDivision').html(h);
                } else { $('#listDivision').html('<div class="dropdown-empty">No divisions found</div>'); }
            },
            error: function () { $('#listDivision').html('<div class="dropdown-empty">Error loading divisions</div>'); }
        });
    }

    function loadSites() {
        var divisionIds = getValues('division');
        $('#listSite').html('<div class="dropdown-empty">Loading...</div>');
        $('#chkAllSite').prop('checked', false); $('#txtSite').text('All');
        if (divisionIds.length === 0) { $('#listSite').html('<div class="dropdown-empty">Select Division first</div>'); return; }
        $.ajax({
            url: '/FRS25/AlertLive/GetSiteByDivisionId', type: 'POST',
            data: JSON.stringify({ SearchCriteria: { DivisionIds: divisionIds } }), contentType: 'application/json',
            success: function (data) {
                if (data && data.length > 0) {
                    var h=''; $.each(data, function(k,v){ h+='<div class="dropdown-item" data-value="'+v.Id+'" data-text="'+v.Name+'"><input type="checkbox" class="cb-site" value="'+v.Id+'"><span>'+v.Name+'</span></div>'; });
                    $('#listSite').html(h);
                } else { $('#listSite').html('<div class="dropdown-empty">No sites found</div>'); }
            },
            error: function () { $('#listSite').html('<div class="dropdown-empty">Error loading sites</div>'); }
        });
    }

    // ===== LOAD ASSET TYPES BY SITE =====
    function loadAssetTypes() {
        var siteIds = getValues('site');

        // Reset selection state
        $('#chkAllAssetType').prop('checked', false);
        $('#txtAssetType').text('All');

        // No station selected → restore ViewBag defaults
        if (siteIds.length === 0) {
            $('#listAssetType').html(_defaultAssetTypeHtml);
            return;
        }

        // Station(s) selected → load filtered asset types via AJAX
        $('#listAssetType').html(
            '<div class="dropdown-empty">Loading...</div>'
        );

        $.ajax({
            url: '/FRS25/RDPMSHealthLive/GetAssetTypeBySiteIds',
            type: 'POST',
            data: JSON.stringify(siteIds),
            contentType: 'application/json',
            success: function (data) {
                if (data && data.length > 0) {
                    var html = '';
                    $.each(data, function (key, value) {
                        /*
                         * Every asset type of the selected Station(s) is
                         * checked by default, so changing the Station goes
                         * straight to a complete result without the user
                         * having to open this dropdown.
                         *
                         * The "checked" class on .dropdown-item is what
                         * selectAll() toggles for the row highlight, so it
                         * has to be set here as well as the input attribute.
                         */
                        html += '<div class="dropdown-item checked" data-value="' + value.Id +
                            '" data-text="' + value.Name + '">';
                        html += '<input type="checkbox" class="cb-assetType" value="' +
                            value.Id + '" checked>';
                        html += '<span>' + value.Name + '</span>';
                        html += '</div>';
                    });
                    $('#listAssetType').html(html);

                    /*
                     * Header "Select All" and the button caption must agree
                     * with the checkboxes that were just rendered.
                     */
                    $('#chkAllAssetType').prop('checked', true);
                    updateText('assetType');
                } else {
                    $('#listAssetType').html(
                        '<div class="dropdown-empty">No asset types found</div>'
                    );
                }
            },
            error: function () {
                // On error fall back to ViewBag defaults
                $('#listAssetType').html(_defaultAssetTypeHtml);
            }
        });
    }

    function fnGetAlertDetailReport(skip) {
        var m = { SearchCriteria: {}, Pager: {} };
        m.SearchCriteria.ZoneIds      = getValues('zone');
        m.SearchCriteria.DivisionIds  = getValues('division');
        m.SearchCriteria.SiteIds      = getValues('site');
        m.SearchCriteria.AssetTypeIds = getValues('assetType');
        if (!m.SearchCriteria.SiteIds || m.SearchCriteria.SiteIds.length <= 0) { alert('Station is required'); return; }

        $("#loader").show();
        $.ajax({
            url: '/FRS25/RDPMSHealthLive/_List', type: 'Post',
            contentType: 'application/json', data: JSON.stringify(m), dataType: 'html',
            success: function (data) {
                $("#loader").hide();

                /* Close sockets BEFORE the new partial replaces the DOM, so no
   in-flight frame can paint rows that are about to be removed.
   BOTH pools: disconnect() covers deviceHealth, and the sensor
   pool is separate - leaving it open is what exhausted the
   browser's WebSocket slots after a few Searches. */
                if (window.RdpmsHealthLive) {
    /*
     * disconnect() now owns teardown of BOTH deviceHealth and sensorHealth.
     */
    window.RdpmsHealthLive.disconnect();
}

                /* Clear the previous partial's model so a late frame cannot read
                   stale mCardLines while the new partial is being injected. */
                window.json = "";

                $("#divRDPMSHealthLive").empty().append(data);

                /*
 * Device-health WebSocket is opened below through
 * RdpmsHealthLive.connect().
 *
 * Do not call the legacy partial connectWebSocket(), otherwise two
 * independent socket implementations may be started.
 */

                /* Device-health feed: one socket per selected station. */
                if (window.RdpmsHealthLive) {
                    /* Track which stations currently have an OPEN socket. The
                       REST poll (nmApply) uses this to decide whether it may
                       write the IoT card counts: while any socket is open the
                       socket owns IoT, so the 1-second poll tick never
                       overwrites the live value. Reset on each new search. */
                    window.__rdpmsWsOpen = {};
                    /*
 * A new search can change station and asset-type scope.
 * Remove Network results belonging to the previous search before
 * the new station sockets start sending data.
 */
                    window.__rdpmsNetworkCountsBySite = {};
                    window.__rdpmsIotFaultyBySite = {};
                    window.__rdpmsGwFaultyBySite = {};
                    window.__rdpmsGroupSummaryBySite = {};
                    /* Clear IN PLACE. The partial's module captured this object by
                       reference at first load, so assigning a fresh {} here detached
                       the global from the store rdpmsBindSummaryTiles reads — every
                       external reader then saw an empty map for the rest of the session. */
                    if (!window.__rdpmsSensorSummaryBySite) {
                        window.__rdpmsSensorSummaryBySite = {};
                    } else {
                        Object.keys(window.__rdpmsSensorSummaryBySite)
                            .forEach(function (k) {
                                delete window.__rdpmsSensorSummaryBySite[k];
                            });
                    }
                    /* Raw per-channel rows live on window and are now keyed
                       siteId|deviceType|deviceId|channel, so a previous search's
                       stations stayed in the store and kept feeding the tiles
                       and nfBuildClusterNetGate. Clear them with the rest. */
                    window.__rdpmsChannelRows = {};
                    var _connectAttempts = 0;
                    var _openSockets = function () {
                        var ready = window.json &&
                            typeof window.json === 'object' &&
                            $.isArray(window.json.mCardLines);

                        if (!ready && _connectAttempts < 40) {   /* ~2 s max */
                            _connectAttempts++;
                            setTimeout(_openSockets, 50);
                            return;
                        }

                        /*
 * IMPORTANT:
 * Open deviceHealth FIRST.
 *
 * RdpmsHealthLive.connect() internally calls disconnect(), and disconnect()
 * also closes the sensorHealth socket. Therefore sensorHealth must be started
 * AFTER deviceHealth has completed its connection setup.
 */
window.RdpmsHealthLive.connect(m.SearchCriteria.SiteIds, {
    onOpen: function (siteId) {
        window.__rdpmsWsOpen[siteId] = true;
    },
    onClose: function (siteId) {
        if (window.__rdpmsWsOpen) {
            delete window.__rdpmsWsOpen[siteId];
        }
    },
    onGroupHealth: function (siteId, snap) {
    if (typeof window.rdpmsApplyGroupHealthSummary === 'function') {
        window.rdpmsApplyGroupHealthSummary(siteId, snap);
    }

    if (typeof window.rdpmsTouchLastUpdated === 'function') {
        window.rdpmsTouchLastUpdated();
    }
},
    onSummary: function (siteId, model) {
        window.RdpmsHealthLive.bindDom(siteId, model, '#divRDPMSHealthLive');

        if (typeof window.fnBindDeviceHealth === 'function') {
    window.fnBindDeviceHealth(siteId, model);
}

if (typeof window.rdpmsTouchLastUpdated === 'function') {
    window.rdpmsTouchLastUpdated();
}

if (typeof window.__rdpmsWsPulse === 'function') {
            window.__rdpmsWsPulse();
        }
    },
    onError: function (siteId, message) {
        if (window.console) {
            console.warn('[DeviceHealth] site ' + (siteId || '-') + ': ' + message);
        }
    }
});

/*
 * Start sensorHealth AFTER deviceHealth.
 * Otherwise RdpmsHealthLive.connect() -> disconnect() closes it immediately.
 */
if (typeof window.__rdpmsSensorStart === 'function') {
    window.__rdpmsSensorStart();
}
                    };
                    _openSockets();
                }

                /* re-apply whichever view is currently selected */
                var cv = $('#selView').val() || 'Table';
                if (typeof window.fnSwitchView === 'function') window.fnSwitchView(cv);
            },
            error: function (xhr, status, error) {
    $("#loader").hide();

    console.error('[RDPMS Health Live] _List request failed', {
        httpStatus: xhr.status,
        statusText: xhr.statusText,
        error: error,
        responseText: xhr.responseText
    });

    if (typeof window.CommonNotification === 'function') {
        window.CommonNotification("ERROR", "Something went wrong!", "Error");
    }
    else if (window.toastr && typeof window.toastr.error === 'function') {
        window.toastr.error("Something went wrong!");
    }
    else {
        alert("Something went wrong!");
    }
}
        });
    }

    function fnDownloadAlertDetailReport() {
        window.location.href = '@Url.Action("DownloadFRSAlertLiveStatus", "AlertLive")';
    }
</script>
