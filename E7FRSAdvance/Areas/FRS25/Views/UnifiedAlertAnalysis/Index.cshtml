                                        color: #fff
                                        }

                                        #aaBoard .aa-chip b {
                                        font-size: 10.5px;
                                        font-weight: 600;
                                        color: var(--aa-muted);
                                        background: var(--aa-hair2);
                                        padding: 1px 6px;
                                        border-radius: 10px
                                        }

                                        #aaBoard .aa-chip.on b {
                                        background: rgba(255,255,255,.2);
                                        color: #fff
                                        }

                                        /* table */
                                        /* v1.0.55.64: table redesign -- sticky header, per-row severity rail, clearer column rhythm */
                                        #aaBoard .aa-tbl-wrap {
                                        margin-top: 20px;
                                        background: var(--aa-surface);
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 14px;
                                        overflow: hidden;
                                        box-shadow: 0 1px 2px rgba(20,24,31,.04),0 8px 22px rgba(20,24,31,.05)
                                        }

                                        #aaBoard .aa-tbl {
                                        width: 100%;
                                        border-collapse: separate;
                                        border-spacing: 0
                                        }

                                        #aaBoard .aa-tbl thead th {
                                        position: sticky;
                                        top: 0;
                                        z-index: 2;
                                        font-family: var(--aa-mono);
                                        font-size: 10px;
                                        letter-spacing: .14em;
                                        text-transform: uppercase;
                                        color: var(--aa-muted);
                                        text-align: left;
                                        font-weight: 600;
                                        padding: 13px 18px;
                                        background: #fbfcfe;
                                        border-bottom: 1px solid var(--aa-hair);
                                        white-space: nowrap
                                        }

                                        #aaBoard .aa-tbl td {
                                        padding: 13px 18px;
                                        vertical-align: middle;
                                        border-bottom: 1px solid var(--aa-hair2)
                                        }

                                        #aaBoard .aa-tbl tbody tr:last-child td {
                                        border-bottom: 0
                                        }

                                        #aaBoard .aa-grp .aa-grp-in {
                                        display: flex;
                                        align-items: center;
                                        gap: 12px;
                                        padding: 12px 18px;
                                        background: linear-gradient(180deg,#fbfcfe,#f6f8fb);
                                        border-top: 1px solid var(--aa-hair);
                                        border-left: 3px solid var(--aa-indigo)
                                        }

                                        #aaBoard .aa-grp td {
                                        padding: 0;
                                        border-bottom: 0
                                        }

                                        #aaBoard .aa-grp-name {
                                        font-family: var(--aa-disp);
                                        font-weight: 700;
                                        font-size: 13.5px;
                                        letter-spacing: -.01em
                                        }

                                        #aaBoard .aa-grp-meta {
                                        font-size: 11.5px;
                                        color: var(--aa-muted)
                                        }

                                        #aaBoard .aa-grp-meta em {
                                        color: var(--aa-red);
                                        font-style: normal;
                                        font-weight: 600
                                        }

                                        #aaBoard .aa-grp-code {
                                        margin-left: auto;
                                        font-size: 10.5px;
                                        color: var(--aa-muted2);
                                        letter-spacing: .06em
                                        }
                                        /* severity rail: the row itself carries the state, so scanning does not depend on reading the Type cell */
                                        #aaBoard .aa-row td:first-child {
                                        box-shadow: inset 3px 0 0 transparent
                                        }

                                        #aaBoard .aa-row.is-fail td:first-child {
                                        box-shadow: inset 3px 0 0 var(--aa-red)
                                        }

                                        #aaBoard .aa-row.is-pred td:first-child {
                                        box-shadow: inset 3px 0 0 var(--aa-amber)
                                        }

                                        #aaBoard .aa-row {
                                        transition: background .12s ease
                                        }

                                        #aaBoard .aa-row:hover {
                                        background: #f7f9fc
                                        }

                                        #aaBoard .aa-c-sr {
                                        font-size: 11.5px;
                                        color: var(--aa-muted2);
                                        width: 56px
                                        }

                                        #aaBoard .aa-c-asset {
                                        font-weight: 600;
                                        letter-spacing: -.01em
                                        }

                                        #aaBoard .aa-c-time {
                                        font-size: 12px;
                                        color: var(--aa-muted);
                                        white-space: nowrap
                                        }
                                        /* v1.0.55.65: added columns. Zone/Division repeat down the table, so they are muted and narrow --
                                        the site group header already states the station; these two are for export/scan parity with the
                                        FRS alert list, not the primary read. */
                                        #aaBoard .aa-ai {
                                        /* v1.0.1.1: the hard 44px is gone -- it contradicted the colgroup, which is the
                                        single source of column width. The verdict chip and the rating chip sit on ONE
                                        line; at 44px they wrapped onto two and the cell looked broken. */
                                        text-align: center;
                                        white-space: nowrap
                                        }

                                        #aaBoard .aa-vs {
                                        display: inline-flex;
                                        align-items: center;
                                        justify-content: center;
                                        min-width: 26px;
                                        padding: 2px 6px;
                                        border-radius: 6px;
                                        font-family: var(--aa-mono);
                                        font-size: 10px;
                                        font-weight: 700;
                                        letter-spacing: .04em;
                                        /* v1.0.2.8: a transparent border on the BASE, so the two outlined states below
                                        can draw one without growing 2px taller than the two filled ones and knocking
                                        the chip row out of line with the stars beside it. */
                                        border: 1px solid transparent
                                        }

                                        #aaBoard .aa-vs.ok {
                                        background: rgba(15,157,99,.12);
                                        color: var(--aa-green)
                                        }

                                        #aaBoard .aa-vs.old {
                                        background: rgba(194,121,10,.12);
                                        color: var(--aa-amber)
                                        }

                                        /* v1.0.2.8: NO AI, not a dash, and outlined rather than filled. The other two
                                        chips report something that EXISTS; this one reports an absence, and a broken
                                        border says that before the word is read. "NO AI" is the negation of the token
                                        already established two states above it, and it fits the 112px column beside
                                        the rating chip -- "NOT RUN" reads better but needs ~24px more, which would
                                        have to come out of the cause column. */
                                        #aaBoard .aa-vs.none {
                                        background: transparent;
                                        color: var(--aa-muted2);
                                        border-color: var(--aa-hair2);
                                        border-style: dashed;
                                        cursor: help
                                        }

                                        #aaBoard .aa-vs.none:hover {
                                        color: var(--aa-ink);
                                        border-color: var(--aa-muted2)
                                        }

                                        /* The batched read has not answered yet. Deliberately distinct from NO AI:
                                        "not asked yet" and "the answer is no" are different facts, and only one of
                                        them is allowed to grey out the Detail button. */
                                        #aaBoard .aa-vs.wait {
                                        background: transparent;
                                        color: var(--aa-hair2);
                                        border-color: var(--aa-hair);
                                        border-style: dashed;
                                        letter-spacing: .14em
                                        }

                                        /* v1.0.1.1: zone and division WRAP to two lines instead of truncating on one.
                                        The columns were sized for short codes ("NWR", "JAIPUR"), but real data carries
                                        "Test - Zone 1" and "Test - Division 1", which clipped to "Test - Z..." and
                                        "Test - Divis..." -- the part that identifies WHICH zone was the part cut off.
                                        Widths are now sized to the measured text, and the wrap is the safety net for
                                        anything longer, so a new value never truncates the way these did.
                                        max-width is gone: it fought the colgroup, which is the single source of width. */
                                        #aaBoard .aa-c-org {
                                        font-size: 11.5px;
                                        color: var(--aa-muted2);
                                        /* Plain wrapping, NOT a -webkit-box line clamp. A clamp needs display:-webkit-box,
                                        and any non-table display on a <td> removes the cell from the table layout
                                        algorithm -- the same fault that misaligned the cause column. The clamp belongs
                                        on an inner element or nowhere; here the values are short enough that ordinary
                                        wrapping is all that was needed. */
                                        white-space: normal;
                                        line-height: 1.35;
                                        overflow-wrap: anywhere
                                        }

                                        #aaBoard .aa-c-atype {
                                        font-size: 11px;
                                        letter-spacing: .04em;
                                        color: var(--aa-muted);
                                        white-space: normal;
                                        line-height: 1.35;
                                        overflow-wrap: anywhere
                                        }

                                        #aaBoard .aa-c-dur {
                                        font-family: var(--aa-mono);
                                        font-size: 11.5px;
                                        color: var(--aa-ink);
                                        white-space: nowrap
                                        }

                                        #aaBoard .aa-open {
                                        font-family: var(--aa-disp);
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        letter-spacing: .06em;
                                        text-transform: uppercase;
                                        color: var(--aa-amber);
                                        background: rgba(194,121,10,.10);
                                        border-radius: 20px;
                                        padding: 2px 8px
                                        }

                                        #aaBoard .aa-dash {
                                        color: var(--aa-muted2)
                                        }

                                        #aaBoard .aa-row.is-open .aa-c-time {
                                        color: var(--aa-muted2)
                                        }

                                        #aaBoard .aa-th-sub {
                                        display: block;
                                        font-size: 9px;
                                        letter-spacing: .06em;
                                        color: var(--aa-muted2);
                                        text-transform: none;
                                        margin-top: 2px
                                        }

                                        #aaBoard .aa-type {
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 7px;
                                        font-size: 12.5px;
                                        font-weight: 500
                                        }

                                        #aaBoard .aa-type i {
                                        width: 7px;
                                        height: 7px;
                                        border-radius: 50%
                                        }

                                        #aaBoard .aa-type.fail {
                                        color: var(--aa-red)
                                        }

                                        #aaBoard .aa-type.fail i {
                                        background: var(--aa-red)
                                        }

                                        #aaBoard .aa-type.pred {
                                        color: #b5760f
                                        }

                                        #aaBoard .aa-type.pred i {
                                        background: var(--aa-amber)
                                        }

                                        /* v1.0.1.0 -- ALIGNMENT FIX. display:flex on a <td> takes the cell OUT of the table
                                        layout algorithm: it stops participating in column width negotiation, so its column
                                        no longer lines up with its header or with the same column on other rows. This was
                                        the visible misalignment. The cell goes back to being a table-cell and the flex moves
                                        to an inner span, which lays out identically without breaking the column. */
                                        #aaBoard .aa-cause {
                                        /* display is set EXPLICITLY. An earlier unscoped `.aa-cause { display: flex }` rule
                                        still exists further up this file, and the rule below never overrode it because it
                                        never declared display at all -- so the cell stayed a flex container despite the
                                        comment above saying otherwise. Restating it here is what actually returns the
                                        cell to the table layout algorithm. */
                                        display: table-cell;
                                        vertical-align: middle;
                                        overflow: hidden
                                        }

                                        #aaBoard .aa-cause .aa-cause-in {
                                        display: grid;
                                        grid-template-columns: minmax(0,1fr) auto;
                                        align-items: center;
                                        gap: 10px;
                                        min-width: 0
                                        }

                                        /* the code wraps to two lines rather than truncating: the Insight button takes ~90px
                                        of the column, and on one line that left room for about twelve characters --
                                        "TC BALST/SLPR RES LOW" became "TC BALST/SLP...", which is not an identifier. */
                                        #aaBoard .aa-cause a {
                                        display: -webkit-box;
                                        -webkit-line-clamp: 2;
                                        -webkit-box-orient: vertical;
                                        overflow: hidden;
                                        min-width: 0;
                                        line-height: 1.35;
                                        overflow-wrap: anywhere;
                                        font-size: 13px;
                                        color: var(--aa-ink);
                                        cursor: pointer;
                                        text-decoration: none
                                        }

                                        #aaBoard .aa-cause a:hover {
                                        color: var(--aa-indigo);
                                        text-decoration: underline
                                        }

                                        /* v1.0.1.3 -- TABLE SHELL. The card chrome sits on a shell so the filter bar can be
                                        inside the card but OUTSIDE the horizontal scroller; placed within it, the bar would
                                        slide sideways with the table. */
                                        #aaBoard .aa-tblshell {
                                        margin-top: 20px;
                                        background: var(--aa-surface);
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 14px;
                                        overflow: hidden;
                                        box-shadow: 0 1px 2px rgba(20,24,31,.04),0 8px 22px rgba(20,24,31,.05)
                                        }

                                        #aaBoard .aa-tblshell .aa-tbl-wrap {
                                        margin-top: 0;
                                        border: 0;
                                        border-radius: 0;
                                        box-shadow: none;
                                        background: transparent;
                                        overflow: auto;
                                        max-height: 68vh
                                        }

                                        #aaBoard .aa-tbar {
                                        display: flex;
                                        align-items: center;
                                        gap: 10px;
                                        flex-wrap: wrap;
                                        padding: 9px 12px;
                                        background: linear-gradient(180deg,#fbfcfe,#f6f8fb);
                                        border-bottom: 1px solid var(--aa-hair)
                                        }

                                        #aaBoard .aa-tsel-wrap {
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 7px;
                                        margin: 0
                                        }

                                        #aaBoard .aa-tsel-cap {
                                        font-family: var(--aa-mono);
                                        font-size: 9.5px;
                                        letter-spacing: .14em;
                                        text-transform: uppercase;
                                        color: var(--aa-muted);
                                        white-space: nowrap
                                        }

                                        #aaBoard .aa-tsel {
                                        font-family: var(--aa-mono);
                                        font-size: 12px;
                                        color: var(--aa-ink);
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 8px;
                                        padding: 6px 28px 6px 9px;
                                        background: var(--aa-surface);
                                        min-width: 170px;
                                        max-width: 230px;
                                        cursor: pointer;
                                        /* the native arrow renders differently per browser and made the three selects look
                                        mismatched, so it is drawn here and the room for it reserved above. */
                                        -webkit-appearance: none;
                                        -moz-appearance: none;
                                        appearance: none;
                                        background-image: linear-gradient(45deg,transparent 50%,var(--aa-muted) 50%),linear-gradient(135deg,var(--aa-muted) 50%,transparent 50%);
                                        background-position: calc(100% - 15px) 51%,calc(100% - 10px) 51%;
                                        background-size: 5px 5px,5px 5px;
                                        background-repeat: no-repeat
                                        }

                                        #aaBoard .aa-tsel.on {
                                        border-color: var(--aa-indigo);
                                        color: var(--aa-indigo-ink);
                                        font-weight: 600;
                                        background-color: var(--aa-indigo-wash)
                                        }

                                        #aaBoard .aa-tbar-n {
                                        margin-left: auto;
                                        font-family: var(--aa-mono);
                                        font-variant-numeric: tabular-nums;
                                        font-size: 11px;
                                        color: var(--aa-muted)
                                        }

                                        #aaBoard .aa-tbar-clr {
                                        font-family: var(--aa-mono);
                                        font-size: 10.5px;
                                        letter-spacing: .1em;
                                        text-transform: uppercase;
                                        color: var(--aa-muted);
                                        background: var(--aa-surface);
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 8px;
                                        padding: 5px 11px;
                                        cursor: pointer;
                                        /* hidden rather than disabled -- a Reset with nothing to reset is noise */
                                        display: none
                                        }

                                        #aaBoard .aa-tbar-clr.show {
                                        display: inline-block
                                        }

                                        #aaBoard .aa-tbar-clr:hover {
                                        color: var(--aa-indigo-ink);
                                        border-color: var(--aa-indigo)
                                        }

                                        /* Fixed layout is what makes the <colgroup> authoritative -- without it the browser
                                        re-measures every render and the header drifts off the body. */
                                        #aaBoard .aa-tbl {
                                        table-layout: fixed;
                                        min-width: 1174px
                                        }

                                        /* v1.0.1.3 -- COMPACT COLUMN RHYTHM. Thirteen columns came to 1696px, which meant a
                                        horizontal scrollbar on every screen the board is actually used on. Three pairs were
                                        carrying one fact each across two or three columns: station/division/zone, and
                                        incidence/duration/rectification. Merged into one stacked cell apiece, the table is
                                        ten columns and 1174px -- it fits without scrolling, and the row got SHORTER rather
                                        than taller because the stacked lines are smaller than the padding they replaced.
                                        Widths sum to min-width exactly; change one, change the total. */
                                        #aaBoard .aa-w-sr {
                                        width: 52px
                                        }

                                        #aaBoard .aa-w-loc {
                                        width: 150px
                                        }

                                        #aaBoard .aa-w-type {
                                        width: 44px
                                        }

                                        #aaBoard .aa-w-atype {
                                        width: 84px
                                        }

                                        #aaBoard .aa-w-asset {
                                        width: 84px
                                        }

                                        #aaBoard .aa-w-when {
                                        width: 150px
                                        }

                                        #aaBoard .aa-w-ai {
                                        /* v1.0.2.0: 80px held a verdict chip and a star chip on one line. The validity
                                        switch is a third control and goes UNDER them rather than beside them, so the
                                        column grows by the width of the switch, not by the width of three controls in
                                        a row. 112px is measured, not guessed: the widest state is "Not valid" at 92px,
                                        and the cell keeps 8px of padding each side. The 32px comes out of the cause
                                        column, which is the only one on this table with slack. */
                                        width: 112px
                                        }

                                        #aaBoard .aa-w-cause {
                                        width: 230px
                                        }

                                        #aaBoard .aa-w-rem {
                                        /* v1.0.2.5: 150 -> 124px. Two remark columns became four, and holding 150 would
                                        have added 300px to a table already at its width budget. Four narrower columns
                                        read better than two wide ones here anyway: each holds one person's remark,
                                        the cell clamps to two lines, and the full text is on the title. */
                                        width: 124px
                                        }

                                        /* 18px of side padding x 13 columns is most of a column's worth of whitespace. */
                                        /* v1.0.1.2: scoped to DATA rows, deliberately. Written as `.aa-tbl td` this rule sat
                                        LATER in the file than `#aaBoard .aa-grp td { padding: 0 }` at equal specificity, so
                                        it won and re-padded the station band -- the band carries its own 12px/18px padding
                                        and its indigo left rule, so the extra 14px pushed the whole strip inward and it no
                                        longer lined up with the column edges above it. The group row is not a data row and
                                        must keep padding: 0. */
                                        #aaBoard .aa-tbl thead th,
                                        #aaBoard .aa-tbl tbody tr.aa-row td,
                                        #aaBoard .aa-tbl tbody tr.aa-empty td {
                                        padding: 11px 14px
                                        }

                                        /* a header must match the alignment of the cells beneath it, or a right-aligned
                                        number sits under a left-aligned label and the column reads as broken. */
                                        #aaBoard .aa-tbl thead th.aa-th-r {
                                        text-align: right
                                        }

                                        #aaBoard .aa-tbl thead th.aa-th-c {
                                        text-align: center
                                        }

                                        /* Duration carries a unit caption on a second line, so labels align to the bottom;
                                        otherwise every single-line header floats above its column. */
                                        #aaBoard .aa-tbl thead th {
                                        vertical-align: bottom
                                        }

                                        /* hairline column separators -- across 13 columns the eye loses its place without them */
                                        #aaBoard .aa-tbl thead th + th,
                                        #aaBoard .aa-tbl tbody tr.aa-row td + td {
                                        box-shadow: inset 1px 0 0 var(--aa-hair2)
                                        }

                                        /* v1.0.1.0 -- APPROVED / DISCARD REMARK columns. Clamped to two lines with the full
                                        text on the title, so one long remark cannot set the height of every row. */
                                        /* v1.0.1.3 -- COMPACT ROWS. Padding drops from 11/14 to 6/10 and the stacked cells use
                                        small tight-leading lines, so a three-line timing cell is still shorter than the old
                                        single-line row was. */
                                        #aaBoard .aa-tbl thead th,
                                        #aaBoard .aa-tbl tbody tr.aa-row td,
                                        #aaBoard .aa-tbl tbody tr.aa-empty td {
                                        padding: 6px 10px
                                        }

                                        #aaBoard .aa-tbl thead th {
                                        padding-top: 8px;
                                        padding-bottom: 8px;
                                        font-size: 9.5px;
                                        letter-spacing: .1em
                                        }

                                        /* headers are nowrap by default so a label never splits mid-word; this one is
                                        three words long over a 150px column, so it is allowed to wrap rather than be
                                        clipped to "INCIDENCE . DURATION . RE". */
                                        #aaBoard .aa-tbl thead th.aa-th-w {
                                        white-space: normal;
                                        line-height: 1.3
                                        }

                                        /* the station band is not a data row -- it keeps its own padding and its indigo rule */
                                        #aaBoard .aa-grp-in {
                                        padding: 7px 12px
                                        }

                                        #aaBoard .aa-grp-name {
                                        font-size: 12px
                                        }

                                        #aaBoard .aa-grp-meta {
                                        font-size: 10.5px
                                        }

                                        /* ---- stacked LOCATION cell: station over division . zone ---- */
                                        #aaBoard .aa-c-loc {
                                        vertical-align: middle;
                                        overflow: hidden
                                        }

                                        #aaBoard .aa-loc-s,
                                        #aaBoard .aa-loc-m,
                                        #aaBoard .aa-w-i,
                                        #aaBoard .aa-w-d,
                                        #aaBoard .aa-w-r {
                                        /* block, not flex or grid -- these live INSIDE the cell, and any non-table display
                                        on the <td> itself would drop the cell out of the table layout algorithm. */
                                        display: block;
                                        overflow: hidden;
                                        text-overflow: ellipsis;
                                        white-space: nowrap
                                        }

                                        #aaBoard .aa-loc-s {
                                        font-size: 11.5px;
                                        font-weight: 600;
                                        color: var(--aa-ink);
                                        line-height: 1.3
                                        }

                                        #aaBoard .aa-loc-m {
                                        font-size: 10px;
                                        color: var(--aa-muted);
                                        line-height: 1.3
                                        }

                                        /* ---- stacked WHEN cell: incidence, duration, rectification ---- */
                                        #aaBoard .aa-c-when {
                                        vertical-align: middle;
                                        overflow: hidden;
                                        font-family: var(--aa-mono);
                                        font-variant-numeric: tabular-nums
                                        }

                                        #aaBoard .aa-w-i {
                                        font-size: 10.5px;
                                        color: var(--aa-ink);
                                        line-height: 1.35
                                        }

                                        #aaBoard .aa-w-d {
                                        font-size: 10px;
                                        color: var(--aa-muted);
                                        line-height: 1.35
                                        }

                                        /* an open alert has no rectification time, so the cell says so instead of showing a
                                        duration measured against a moment that never arrived. */
                                        #aaBoard .aa-w-d.open {
                                        color: var(--aa-amber);
                                        font-weight: 600
                                        }

                                        #aaBoard .aa-w-r {
                                        font-size: 10.5px;
                                        color: var(--aa-muted2);
                                        line-height: 1.35
                                        }

                                        /* ---- TYPE as a single letter ---- */
                                        #aaBoard .aa-c-t {
                                        text-align: center;
                                        vertical-align: middle
                                        }

                                        #aaBoard .aa-tflag {
                                        display: inline-flex;
                                        align-items: center;
                                        justify-content: center;
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 50%;
                                        font-family: var(--aa-disp);
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        color: #fff
                                        }

                                        #aaBoard .aa-tflag.fail {
                                        background: var(--aa-red)
                                        }

                                        #aaBoard .aa-tflag.pred {
                                        background: var(--aa-amber)
                                        }

                                        #aaBoard .aa-c-rem {
                                        font-size: 11px;
                                        line-height: 1.35;
                                        color: var(--aa-ink);
                                        vertical-align: middle;
                                        overflow: hidden
                                        }

                                        #aaBoard .aa-rem-cell {
                                        display: -webkit-box;
                                        -webkit-line-clamp: 2;
                                        -webkit-box-orient: vertical;
                                        overflow: hidden;
                                        border-left: 2px solid var(--aa-hair);
                                        padding-left: 8px;
                                        /* remarks arrive as unbroken strings often enough that without this one row would
                                        force the whole table wider and shift every column under it. */
                                        overflow-wrap: anywhere
                                        }

                                        /* the accent says WHICH remark this is at a glance -- green for the office's
                                        approval, amber for the field's discard reason. */
                                        #aaBoard .aa-rem-cell.a {
                                        border-left-color: var(--aa-green)
                                        }

                                        /* v1.0.2.5: one accent per SOURCE. With four remark columns side by side the
                                        left border is what tells them apart at a glance when the header has scrolled
                                        out of view -- green approval, indigo railway, slate field, amber discard. */
                                        #aaBoard .aa-rem-cell.r {
                                        border-left-color: var(--aa-indigo)
