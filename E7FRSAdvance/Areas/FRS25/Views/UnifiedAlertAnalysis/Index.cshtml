                                        h += '<div class="rv-sec" style="background:rgba(163,102,26,.06);border-left:3px solid #a3661a;">'
                                        + '<span style="display:inline-block;font-size:10.5px;font-weight:700;letter-spacing:.04em;'
                                        + 'padding:3px 9px;border-radius:11px;background:rgba(163,102,26,.14);color:#7a4d14;'
                                        + 'border:1px solid rgba(163,102,26,.34);margin-bottom:5px;">REUSED</span>'
                                        + '<div style="font-size:12px;color:#7a4d14;">'
                                        + '<b>Previous analysis reused</b> &middot; ' + escapeHtml(fmtCachedAt(v.cached_at))
                                        /* v1.0.55.104: engine segment removed -- badge is REUSED + time only. Old CACHED rows still carry cached_engine in their stored payload, so the view must not render it even when present. */
                                        + ' &middot; no new model call. Press <b>Re-run</b> for a fresh analysis.'
