                                        padding-top: 9px;
                                        border-top: 1px solid var(--aa-hair2);
                                        }

                                        #aaBoard .aa-cmd-sp {
                                        flex: 1 1 auto;
                                        }

                                        #aaBoard .aa-cmd-div {
                                        width: 1px;
                                        height: 20px;
                                        background: var(--aa-hair);
                                        flex: none;
                                        margin: 0 2px;
                                        }
                                        /* one line that scrolls, rather than three lines that push the board down */
                                        #aaBoard .aa-cmd .aa-typechips {
                                        display: flex;
                                        flex-wrap: wrap;
                                        gap: 6px;
                                        }

                                        #aaBoard .aa-cmd .aa-typechips > * {
                                        flex: none;
                                        }

                                        #aaBoard .aa-cmd .aa-typechip {
                                        padding: 4px 10px;
                                        font-size: 11px;
                                        }

                                        #aaBoard .aa-sorttog {
                                        display: flex;
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 9px;
                                        overflow: hidden;
                                        background: #fff;
                                        flex: none;
                                        }

                                        #aaBoard .aa-sorttog button {
                                        border: 0;
                                        background: transparent;
                                        font: inherit;
                                        font-size: 11.5px;
                                        font-weight: 600;
                                        color: var(--aa-muted);
                                        padding: 5px 11px;
                                        cursor: pointer;
                                        }

                                        #aaBoard .aa-sorttog button.on {
                                        background: var(--aa-indigo);
                                        color: #fff;
                                        }

                                        #aaBoard .aa-sorttog button:focus-visible {
                                        outline: 2px solid var(--aa-indigo);
                                        outline-offset: -2px;
                                        }

                                        #aaBoard .aa-railtog {
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 6px;
                                        flex: none;
                                        border: 1px solid var(--aa-hair);
                                        background: #fff;
                                        border-radius: 9px;
                                        font: inherit;
                                        font-size: 11.5px;
                                        font-weight: 600;
                                        color: var(--aa-muted);
                                        padding: 5px 11px;
                                        cursor: pointer;
                                        }

                                        #aaBoard .aa-railtog:hover {
                                        border-color: var(--aa-muted2);
                                        color: var(--aa-ink);
                                        }

                                        #aaBoard .aa-railtog b {
                                        font: 700 10.5px/1 var(--aa-mono);
                                        background: var(--aa-hair2);
                                        color: var(--aa-muted);
                                        border-radius: 20px;
                                        padding: 3px 6px;
                                        }

                                        #aaBoard .aa-railtog-c {
                                        display: inline-block;
                                        transition: transform .14s;
                                        font-size: 10px;
                                        }

                                        #aaBoard .aa-railtog.open .aa-railtog-c {
                                        transform: rotate(90deg);
                                        }

                                        #aaBoard .aa-railtog.open {
                                        border-color: var(--aa-band);
                                        color: var(--aa-ink);
                                        }

                                        /* ---- section headings replace date headings under Priority sort ---- */
                                        #aaBoard .aa-sec {
                                        display: flex;
                                        align-items: center;
                                        gap: 10px;
                                        margin: 22px 0 12px;
                                        }

                                        #aaBoard .aa-sec h2 {
                                        margin: 0;
                                        font-size: 12px;
                                        font-weight: 800;
                                        letter-spacing: .09em;
                                        text-transform: uppercase;
                                        color: var(--aa-muted);
                                        }

                                        #aaBoard .aa-sec.hot h2 {
                                        color: #a32540;
                                        }

                                        #aaBoard .aa-sec i {
                                        flex: 1;
                                        height: 1px;
                                        background: var(--aa-hair);
                                        }

                                        #aaBoard .aa-sec.hot i {
                                        background: rgba(220,47,74,.22);
                                        }

                                        #aaBoard .aa-sec em {
                                        font-style: normal;
                                        font: 600 11px/1 var(--aa-mono);
                                        color: var(--aa-muted2);
                                        }

                                        #aaBoard .aa-sec-dot {
                                        width: 7px;
                                        height: 7px;
                                        border-radius: 50%;
                                        background: var(--aa-red);
                                        flex: none;
                                        }

                                        /* ---- card: open work is louder than closed work ---- */
                                        #aaBoard .aa-ac.is-open {
                                        box-shadow: 0 1px 0 rgba(220,47,74,.10), 0 0 0 1px rgba(220,47,74,.16);
                                        }

                                        #aaBoard .aa-ac.is-open.fail {
                                        border-left-width: 4px;
                                        }

                                        #aaBoard .aa-ac.done {
                                        opacity: .93;
                                        }

                                        #aaBoard .aa-ac.done:hover {
                                        opacity: 1;
                                        }

                                        /* the asset name owns the slack in the header; badges moved off that row */
                                        #aaBoard .aa-ac-hd b {
                                        flex: 1 1 auto;
                                        min-width: 0;
                                        }

                                        #aaBoard .aa-ac-id .aa-rep {
                                        margin-left: auto;
                                        }

                                        #aaBoard .aa-livedot {
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 50%;
                                        background: var(--aa-red);
                                        flex: none;
                                        animation: aaBeat 2s ease-out infinite;
                                        }

                                        #aaBoard .aa-ac.pred .aa-livedot {
                                        background: var(--aa-amber);
                                        }

                                        /* recurrence: the single most actionable signal on this board */
                                        #aaBoard .aa-rep {
                                        flex: none;
                                        display: inline-flex;
                                        align-items: baseline;
                                        gap: 3px;
                                        border: 0;
                                        cursor: pointer;
                                        font: 800 10px/1 var(--aa-mono);
                                        letter-spacing: .04em;
                                        border-radius: 20px;
                                        padding: 4px 8px;
                                        background: rgba(220,47,74,.11);
                                        color: #a32540;
                                        }

                                        #aaBoard .aa-rep:hover {
                                        background: rgba(220,47,74,.18);
                                        }

                                        #aaBoard .aa-rep:focus-visible {
                                        outline: 2px solid var(--aa-indigo);
                                        outline-offset: 2px;
                                        }

                                        #aaBoard .aa-rep em {
                                        font-style: normal;
                                        font-weight: 600;
                                        opacity: .8;
                                        }

                                        #aaBoard .aa-openfor {
                                        font-family: var(--aa-mono);
                                        font-size: 9.5px;
                                        font-weight: 700;
                                        color: #8a570a;
                                        background: rgba(224,150,26,.14);
                                        border-radius: 20px;
                                        padding: 2px 7px;
                                        }

                                        @@media (max-width: 860px) {
                                        #aaBoard .aa-cmd {
                                        position: static;
                                        }
                                        }

                                        @@media (prefers-reduced-motion: reduce) {
                                        #aaBoard .aa-open-now i, #aaBoard .aa-livedot {
                                        animation: none;
                                        }
                                        }

                                        /* ================================================================
                                        v1.0.3.2 -- TABLE: DENSITY AND FINISH.

                                        Measured before touching anything: data rows were 67-75px and the header 55px,
                                        so a 900px viewport held about eight alerts. The height was not padding -- it was
                                        three stacked control rows (the AI cell alone is a two-row column flex) sitting in
                                        cells whose line boxes were set for a roomier layout. Everything below either
                                        tightens a line box or shrinks a control, and nothing changes what a cell says.

                                        EVERY RULE IS SCOPED TO .aa-tbl. The disc, the rating chip, the validity switch,
                                        INSIGHT and Detail are SHARED with the cards and the timeline, where they are the
                                        primary surface and are correctly sized. Restyling them globally would shrink the
                                        cards to fix the table.
                                        ================================================================ */

                                        /* Rows were free to be any height, so the eye had no rhythm to follow across
                                        eleven columns. A height on the row acts as a MINIMUM under table-layout:fixed:
                                        short rows come up to the rhythm, a two-line cause code is still free to grow. */
                                        #aaBoard .aa-tbl tbody tr.aa-row {
                                        height: 46px;
                                        }

                                        #aaBoard .aa-tbl thead th,
                                        #aaBoard .aa-tbl tbody tr.aa-row td,
                                        #aaBoard .aa-tbl tbody tr.aa-empty td {
                                        padding: 4px 10px;
                                        }

                                        /* The header carried a 2-line label in one column and bottom-aligned the rest, so
                                        every single-line heading floated at the foot of 55px with dead space above it.
                                        Centred, the block reads as one band and gives the rows back ~14px. */
                                        #aaBoard .aa-tbl thead th {
                                        vertical-align: middle;
                                        padding-top: 7px;
                                        padding-bottom: 7px;
                                        color: var(--aa-muted);
                                        background: linear-gradient(180deg,#fcfdff,#f4f7fb);
                                        }

                                        /* A sticky header that scrolls over content needs to sit ON it, not blend into
                                        it. Only visible once something has scrolled underneath. */
                                        #aaBoard .aa-tbl thead th {
                                        box-shadow: 0 1px 0 var(--aa-hair), 0 4px 10px -6px rgba(20,24,31,.28);
                                        }

                                        /* The hairline separators stay, but they were the same weight as the row rules
                                        and turned eleven columns into a spreadsheet grid. With the banding below doing
                                        the row tracking, the verticals only need to hint at the column edge. */
                                        #aaBoard .aa-tbl thead th + th,
                                        #aaBoard .aa-tbl tbody tr.aa-row td + td {
                                        box-shadow: inset 1px 0 0 rgba(20,24,31,.045);
                                        }

                                        /* BANDING. The one thing an eleven-column row most needs: something that holds
                                        the line from SR across to the last remark. Faint enough to read as rhythm rather
                                        than as stripes, and it is on the CELL because the severity rail and the column
                                        hairlines are inset shadows on cells -- a row background would sit under them and
                                        lose to the cell's own. Parity flips at each station band, which is correct: the
                                        banding restarts with the group, exactly where the reading does. */
                                        #aaBoard .aa-tbl tbody tr.aa-row:nth-child(even) td {
                                        background: #fafbfd;
                                        }

                                        /* Hover has to beat the banding, so it is on the cell too. Stronger than the old
                                        #f7f9fc: on a table this wide the hovered row is the main scanning aid, and a wash
                                        that can be mistaken for a band is not one. */
                                        #aaBoard .aa-tbl tbody tr.aa-row:hover td {
                                        background: var(--aa-indigo-wash, #eef1fd);
                                        }

                                        #aaBoard .aa-tbl tbody tr.aa-row:hover td:first-child {
                                        box-shadow: inset 3px 0 0 currentColor;
                                        }

                                        #aaBoard .aa-tbl tbody tr.aa-row.is-fail:hover td:first-child {
                                        box-shadow: inset 3px 0 0 var(--aa-red);
                                        }

                                        #aaBoard .aa-tbl tbody tr.aa-row.is-pred:hover td:first-child {
                                        box-shadow: inset 3px 0 0 var(--aa-amber);
                                        }

                                        /* Lining figures. Without them the serial column and the three timestamps wander
                                        by a pixel or two per digit, which is exactly the wobble that makes a column of
                                        numbers hard to read down. */
                                        #aaBoard .aa-tbl .aa-c-sr,
                                        #aaBoard .aa-tbl .aa-c-when,
                                        #aaBoard .aa-tbl .aa-c-dur,
                                        #aaBoard .aa-tbl .aa-grp-meta,
                                        #aaBoard .aa-tbl .aa-w-i,
                                        #aaBoard .aa-tbl .aa-w-d,
                                        #aaBoard .aa-tbl .aa-w-r {
                                        font-variant-numeric: tabular-nums;
                                        font-feature-settings: "tnum" 1;
                                        }

                                        /* The stacked cells are the row's height. Tight leading on lines that are already
                                        short text costs nothing in legibility and takes several pixels off every row. */
                                        #aaBoard .aa-tbl .aa-loc-s,
                                        #aaBoard .aa-tbl .aa-loc-m,
                                        #aaBoard .aa-tbl .aa-w-i,
                                        #aaBoard .aa-tbl .aa-w-d,
                                        #aaBoard .aa-tbl .aa-w-r {
                                        line-height: 1.25;
                                        }

                                        /* ---- controls, inside the table only ---- */

                                        /* 27px in a 52px column beside a serial number. The disc is an indicator here,
                                        not the primary control it is on a card. */
                                        #aaBoard .aa-tbl .aa-disc {
                                        width: 22px;
                                        height: 22px;
                                        font-size: 11px;
                                        border-width: 1.5px;
                                        }

                                        #aaBoard .aa-tbl .aa-ai-in {
                                        gap: 2px;
                                        }

                                        #aaBoard .aa-tbl .aa-rate,
                                        #aaBoard .aa-tbl .aa-vt {
                                        padding-top: 1px;
                                        padding-bottom: 1px;
                                        }

                                        /* INSIGHT was a filled indigo pill repeated on all twenty-five rows, which made
                                        the loudest thing on the table an action rather than the data. It is available on
                                        every row, so it is not a call to action -- it is quiet at rest and takes its fill
                                        back on hover and focus. Unchanged on the cards, where one card is one alert and
                                        the button is the point. */
                                        #aaBoard .aa-tbl .e7ins {
                                        margin-left: 6px;
                                        padding: 3px 9px 3px 5px;
                                        background: #fff;
                                        color: var(--aa-indigo-ink, #3f42c9);
                                        box-shadow: inset 0 0 0 1px var(--aa-hair);
                                        transition: background .13s, color .13s, box-shadow .13s;
                                        }

                                        #aaBoard .aa-tbl .e7ins .e7ins-m {
                                        background: var(--aa-indigo-wash, #eef1fd);
                                        color: var(--aa-indigo-ink, #3f42c9);
                                        }

                                        #aaBoard .aa-tbl .e7ins:hover,
                                        #aaBoard .aa-tbl .e7ins:focus-visible {
                                        background: var(--aa-indigo, #5457e6);
                                        color: #fff;
                                        box-shadow: inset 0 0 0 1px var(--aa-indigo, #5457e6);
                                        }

                                        #aaBoard .aa-tbl .e7ins:hover .e7ins-m,
                                        #aaBoard .aa-tbl .e7ins:focus-visible .e7ins-m {
                                        background: rgba(255,255,255,.22);
                                        color: #fff;
                                        }

                                        /* busy is a STATE and has to stay loud -- it is the only thing telling the
                                        operator the click landed, and quieting it would undo the reason it exists. */
                                        #aaBoard .aa-tbl .e7ins.busy {
                                        background: var(--aa-indigo, #5457e6);
                                        color: #fff;
                                        box-shadow: none;
                                        }

                                        #aaBoard .aa-tbl .aa-dbtn {
                                        padding-top: 1px;
                                        padding-bottom: 1px;
                                        }

                                        /* THE ROW'S REAL HEIGHT WAS HERE. .aa-cause-in is a two-column grid holding THREE
                                        children -- the code, INSIGHT and Detail -- so Detail wrapped onto a second grid
                                        row and every row in the table paid ~25px for it. Measured: the cause cell was
                                        49px against the AI cell's 33px. Flex puts the three on one line; the code keeps
                                        its two-line clamp because it is the only flexible item. */
                                        #aaBoard .aa-tbl .aa-cause .aa-cause-in {
                                        display: flex;
                                        align-items: center;
                                        flex-wrap: nowrap;
                                        gap: 6px;
                                        }

                                        #aaBoard .aa-tbl .aa-cause .aa-cause-in > a {
                                        flex: 1 1 auto;
                                        min-width: 0;
                                        }

                                        #aaBoard .aa-tbl .aa-cause .aa-cause-in > .e7ins,
                                        #aaBoard .aa-tbl .aa-cause .aa-cause-in > .aa-dbtn {
                                        flex: none;
                                        }

                                        /* Putting the two buttons on the code's line takes width from the code, and the
                                        cause code is the row's identifier -- squeezing "SIG LAMP FAIL" onto two lines to
                                        save height would trade the wrong thing. So the buttons give width back (the word
                                        INSIGHT does not need tracking at this size) and the column takes thirty-odd
                                        pixels from the remark columns, which clamp to two lines and carry their full
                                        text on the title either way. The 11-column total is unchanged. */
                                        #aaBoard .aa-tbl .e7ins {
                                        font-size: 9.5px;
                                        letter-spacing: .04em;
                                        gap: 4px;
                                        }

                                        #aaBoard .aa-tbl .aa-dbtn {
                                        font-size: 10px;
                                        padding-left: 6px;
                                        padding-right: 7px;
                                        }

                                        #aaBoard .aa-tbl .aa-w-cause {
                                        width: 264px;
                                        }

                                        #aaBoard .aa-tbl .aa-w-rem {
                                        width: 113px;
                                        }

                                        /* The station band is the table's own heading. Tighter, and its label carries the
                                        weight now that the rows beneath it are banded. */
                                        #aaBoard .aa-tbl .aa-grp-in {
                                        padding: 5px 12px;
                                        }

                                        /* Under ~1300px the shell scrolls the table sideways. The serial column is the
                                        row's anchor -- the decision disc and the number that every other cell is read
                                        against -- so it stays put instead of scrolling away from its own row. */
                                        #aaBoard .aa-tbl tbody tr.aa-row td.aa-c-sr,
                                        #aaBoard .aa-tbl thead th:first-child {
                                        position: sticky;
                                        left: 0;
                                        z-index: 1;
                                        background: var(--aa-surface, #fff);
                                        }

                                        #aaBoard .aa-tbl tbody tr.aa-row:nth-child(even) td.aa-c-sr {
                                        background: #fafbfd;
                                        }

                                        #aaBoard .aa-tbl tbody tr.aa-row:hover td.aa-c-sr {
                                        background: var(--aa-indigo-wash, #eef1fd);
                                        }

                                        #aaBoard .aa-tbl thead th:first-child {
                                        z-index: 3;
                                        }
                                    </style>

                                    <script src="~/assets/js/jquery-3.5.1.min.js"></script>
                                    @* v1.0.52.0: Chart.js served locally (offline servers) -- place chart.umd.min.js in ~/assets/js/. If absent, the verdict trend chart falls back to inline SVG automatically. *@
