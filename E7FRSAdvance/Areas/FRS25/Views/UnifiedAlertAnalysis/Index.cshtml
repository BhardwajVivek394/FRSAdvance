                                        : 'Not analysed yet, nothing to rate')) + '"'
                                        + ' title="' + (can ? 'Click to rate this analysis'
                                        : 'Run Insight first -- a rating attaches to an analysis') + '"'
                                        + ' data-pop="ai" data-id="' + a.id + '"'
                                        + (can ? (' onclick="fnAaOpenRating(' + a.id + ',event)"') : '')
                                        + '>' + aaStar(r > 0) + '<b>' + (r > 0 ? r : '&ndash;') + '</b></span>';
                                        }
                                        /* ==================================================================
                                        v1.0.1.0 -- triage behaviour
                                        ================================================================== */

                                        /* An alert with no reset is still happening. That is the only class of row on this
                                        board that represents WORK rather than history, so it leads. */
                                        function aaIsOpen(a) { return !a.resetText; }

                                        /* Same asset, same cause, more than once in this window. On a signalling board that
                                        is not N alerts -- it is ONE fault that keeps re-presenting, and it is the single
                                        most actionable thing the data says. Keyed on asset+cause because the same point
                                        machine throwing two DIFFERENT causes is two problems. */
                                        function aaRepeatKey(a) {
                                        return String(a.asset || '') + '|' + String(a.code || '');
                                        }
                                        function aaBuildRepeats(list) {
                                        AA_REPEAT = {};
                                        for (var i = 0; i < list.length; i++) {
                                        var k = aaRepeatKey(list[i]);
                                        AA_REPEAT[k] = (AA_REPEAT[k] || 0) + 1;
                                        }
                                        }
                                        function aaRepeatCount(a) { return AA_REPEAT[aaRepeatKey(a)] || 1; }

                                        /* Priority: open failures, open predictive, then cleared, each newest first.
                                        Sorting 344 rows by time alone buries a live failure from 03:00 under forty
                                        cleared predictives from lunchtime. */
                                        function aaSortRows(list) {
                                        var rows = list.slice(0);
                                        rows.sort(function (x, y) {
                                        if (AA_SORT === 'priority') {
                                        var ox = aaIsOpen(x) ? 0 : 1, oy = aaIsOpen(y) ? 0 : 1;
                                        if (ox !== oy) { return ox - oy; }
                                        var fx = (x.type === 'Failure') ? 0 : 1, fy = (y.type === 'Failure') ? 0 : 1;
                                        if (fx !== fy) { return fx - fy; }
                                        }
                                        return (y.timeSort > x.timeSort) ? 1 : ((y.timeSort < x.timeSort) ? -1 : 0);
                                        });
                                        return rows;
                                        }
                                        function fnAaSetSort(mode) {
                                        AA_SORT = (mode === 'newest') ? 'newest' : 'priority';
                                        var bp = document.getElementById('aaSortPri'), bn = document.getElementById('aaSortNew');
                                        if (bp) { bp.className = (AA_SORT === 'priority') ? 'on' : ''; }
                                        if (bn) { bn.className = (AA_SORT === 'newest') ? 'on' : ''; }
                                        aaPopHide();
                                        fnAaRenderTable();
                                        }

                                        /* Clicking the repeat badge narrows to that asset, because the useful next question
                                        is always "show me the other four", never "tell me there were four". */
                                        //function fnAaFocusRepeat(id, ev) {
                                        //    try {
                                        //        if (ev && ev.stopPropagation) { ev.stopPropagation(); }
                                        //        var a = aaRowById(Number(id));
                                        //        if (!a) { return; }
                                        //        aaState.asset = (aaState.asset === a.asset) ? null : a.asset;
                                        //        aaState.cause = aaState.asset ? a.code : null;
                                        //        fnAaRenderAll();
                                        //    } catch (e) { }
                                        //}

                                        function fnAaToggleRail() {
                                        AA_RAIL_OPEN = !AA_RAIL_OPEN;
                                        var rail = document.getElementById('aaRail');
                                        var tog = document.getElementById('aaRailTog');
                                        if (rail) { rail.style.display = AA_RAIL_OPEN ? '' : 'none'; }
                                        if (tog) { tog.className = AA_RAIL_OPEN ? 'aa-railtog open' : 'aa-railtog'; }
                                        }

                                        /* How long an open alert has been open, from now. A set time with no reset is not a
                                        moment, it is a duration that is still growing, and that is the number an operator
                                        is actually weighing. */
                                        function aaOpenFor(a) {
                                        var t = new Date(a.timeSort || a.timeText);
                                        if (isNaN(t.getTime())) { return ''; }
                                        var mins = Math.floor((Date.now() - t.getTime()) / 60000);
                                        if (mins < 0) { return ''; }
                                        if (mins < 60) { return mins + 'm'; }
                                        if (mins < 1440) { return Math.floor(mins / 60) + 'h ' + (mins % 60) + 'm'; }
                                        return Math.floor(mins / 1440) + 'd ' + Math.floor((mins % 1440) / 60) + 'h';
                                        }

                                        /* ==================================================================
                                        v1.0.2.3 -- AI VERDICT vs OUTCOME

                                        Replaces the pulse. The pulse plotted alerts per hour, which the date window and
                                        the timeline already say; this says the thing only this board holds -- when a
                                        human and the AI both judged an alert, did they agree, and when they did not,
                                        WHICH WAY did it go.

                                        GROUND TRUTH, and it is a judgement call the board has to state out loud:
                                        - APPROVED  -> a TRUE alert. The office kept it, so it was real.
                                        - DISCARDED -> a FALSE alert, because that is what discarding one means --
                                        EXCEPT when the field came back and recorded DiscardWasValid = 1, which
                                        outranks the discard: the alert was genuine and throwing it away was the
                                        mistake. That is the closest thing to ground truth this system holds.
                                        A discarded alert with NO field check is still counted false, on the strength
                                        of the discard alone. That is weaker evidence than a field confirmation, so the
                                        panel says how many are resting on it rather than burying the distinction.

                                        THE AI SIDE: a.aiVerdict, the AI's own conclusion. An alert nobody analysed has
                                        NO verdict, and that is NOT "did not confirm" -- silence is not a judgement. Those
                                        are excluded from the four cells and counted separately, or the accuracy figure
                                        would improve every time somebody skipped running Insight.
                                        ================================================================== */

                                        function aaScore(a) {
                                        var dec = aaDecision(a).k;
                                        var vf = aaValidFlag(a);                 // 'yes' / 'no' / null (nothing recorded)

                                        // Approved keeps the alert; discarded throws it away, and only a field check
                                        // that says GENUINE can overturn that.
                                        var truth = (dec === 'A') ? 'T' : ((vf && vf.cls === 'yes') ? 'T' : 'F');

                                        // v1.0.2.9: TWO SOURCES, chosen by which side of the decision the row is on.
                                        // Approved alerts carry a real boolean (AiConfirmed); discarded ones only ever
                                        // had the verdict TEXT. Reading the text on both sides meant parsing a sentence
                                        // to recover an answer that was already stored as a bit.
                                        var ai = (dec === 'A') ? aaAiFromBit(a) : aaAiFromVerdict(a);

                                        return {
                                        truth: truth,
                                        ai: ai,
                                        cell: (ai === '?') ? '?' : (truth + ai),
                                        // Was the FALSE call backed by a field check, or only by the discard?
                                        fieldChecked: !!vf
                                        };
                                        }

                                        /* v1.0.2.9: APPROVED -- the bit. 1 confirmed, 0 not confirmed.

                                        EMPTY IS '?', NOT 'N', and that is the whole care in this function. An approved
                                        alert whose AiConfirmed was never written has no AI answer, and counting it as
                                        "not confirmed" would move every un-backfilled row into the miss column: the
                                        agreement rate collapses on the day this ships and it reads as the model breaking
                                        rather than as a column not being populated yet. Unscored rows are already counted
                                        and named on the panel footnote, which is where they belong.

                                        true/yes/1 and false/no/0 are all accepted because the bit reaches JSON in more
                                        than one shape depending on how it was projected. */
                                        function aaAiFromBit(a) {
                                        var b = String((a && a.aiConfirmed) || '').trim().toLowerCase();
                                        if (b === '1' || b === 'true' || b === 'yes') { return 'C'; }
                                        if (b === '0' || b === 'false' || b === 'no') { return 'N'; }
                                        return '?';
                                        }

                                        /* DISCARDED -- the verdict text, unchanged from 1.0.2.3. PendingAlertApproval has no
                                        confirmed bit, so this side still has to read what the model wrote. */
                                        function aaAiFromVerdict(a) {
                                        var v = String((a && a.aiVerdict) || '').trim().toUpperCase();
                                        if (v.length === 0) { return '?'; }
                                        // Explicit negatives FIRST. "NOT CONFIRMED" and "UNCONFIRMED" both contain
                                        // "CONFIRM", so a bare indexOf test would score them as agreement.
                                        if (/(NOT|UN|DIS)\s*-?\s*CONFIRM/.test(v)
                                        || v.indexOf('REJECT') >= 0 || v.indexOf('INCONCLUS') >= 0) { return 'N'; }
                                        if (v.indexOf('CONFIRM') >= 0) { return 'C'; }
                                        // Unrecognised wording counts as NOT confirmed, never as confirmed: a new verdict
                                        // string introduced upstream should show as a dip in the rate, not inflate it.
                                        return 'N';
                                        }

                                        // Reading order is the 2x2 grouped by what actually happened, not by how bad it is:
                                        // the two misses are already flagged by colour and counted in the header.
                                        var AA_MX_DEFS = [
                                        { k: 'TC', lab: 'True alert',  sub: 'AI confirmed',     cls: 'ok' },
                                        { k: 'TN', lab: 'True alert',  sub: 'AI not confirmed', cls: 'miss' },
                                        { k: 'FC', lab: 'False alert', sub: 'AI confirmed',     cls: 'fp' },
                                        { k: 'FN', lab: 'False alert', sub: 'AI not confirmed', cls: 'ok2' }
                                        ];

                                        /* v1.0.2.4: the same four counts, asked two ways.
                                        OUTCOME   -- the 2x2 over the whole slice. "How often is the AI right here."
                                        CAUSE CODE-- the same four counts split per cause code, worst first. "WHICH
                                        faults is it wrong about." That is the actionable one: a 14%
                                        disagreement rate spread evenly is a tuning problem, and the same
                                        rate concentrated in one cause code is a rule that needs fixing. */
                                        var AA_MX_VIEW = 'outcome';
                                        var AA_MX_CAUSE_CAP = 10;

                                        function fnAaSetMxView(v) {
                                        AA_MX_VIEW = v;
                                        fnAaRenderMatch();
                                        }

                                        function aaMxSegHtml() {
                                        var defs = [['outcome', 'Outcome'], ['cause', 'Cause code'], ['day', 'Day']];
                                        var h = '';
                                        for (var i = 0; i < defs.length; i++) {
                                        h += '<button type="button" class="aa-mx-sgb' + (AA_MX_VIEW === defs[i][0] ? ' on' : '') + '"'
                                        + ' onclick="fnAaSetMxView(\'' + defs[i][0] + '\')">' + defs[i][1] + '</button>';
                                        }
                                        return h;
                                        }

                                        // Tally the four cells over a list. One counter used by both views, so the two can
                                        // never disagree about what the numbers are.
                                        function aaMxTally(list) {
                                        var t = { TC: 0, TN: 0, FC: 0, FN: 0, n: 0, unscored: 0, discardNoField: 0 };
                                        for (var i = 0; i < list.length; i++) {
                                        var s = aaScore(list[i]);
                                        if (s.cell === '?') { t.unscored++; continue; }
                                        t[s.cell]++; t.n++;
                                        if (s.truth === 'F' && !s.fieldChecked) { t.discardNoField++; }
                                        }
                                        return t;
                                        }

                                        function fnAaRenderMatch() {
                                        var bars = document.getElementById('aaMatchBars');
                                        var accEl = document.getElementById('aaMatchAcc');
                                        var noteEl = document.getElementById('aaMatchNote');
                                        var segEl = document.getElementById('aaMatchSeg');
                                        var legEl = document.getElementById('aaMatchLegend');
                                        if (!bars) { return; }

                                        if (segEl) { segEl.innerHTML = aaMxSegHtml(); }

                                        var byCause = (AA_MX_VIEW === 'cause');
                                        var byDay = (AA_MX_VIEW === 'day');

                                        // Everything EXCEPT the panel's own row filter, so clicking a row narrows the
                                        // board without collapsing the chart under the pointer. In CAUSE view the cause
                                        // filter is ignored too, for the same reason -- otherwise picking a cause would
                                        // leave a one-row chart and no way to see the comparison you picked it from.
                                        // v1.0.2.5: the DAY view keeps the cause filter applied -- unlike cause view it is
                                        // not comparing causes, so narrowing to one is a legitimate way to ask "when did
                                        // THIS fault start going wrong". v1.0.3.4 adds per-day cause chips, and that does
                                        // NOT change the rule: the chips describe the day under the current filter, which
                                        // is the question the day view is being asked.
                                        var list = fnAaFiltered(true, byCause);

                                        var t = aaMxTally(list);
                                        var agree = t.TC + t.FN, disagree = t.TN + t.FC;

                                        if (accEl) {
                                        accEl.innerHTML = t.n
                                        ? ('<b>' + Math.round((agree / t.n) * 100) + '%</b> agreement &middot; '
                                        + t.n + ' scored &middot; ' + disagree + ' disagree')
                                        : '';
                                        }
                                        if (noteEl) {
                                        var bits = [];
                                        if (t.unscored) { bits.push(t.unscored + ' not analysed (no verdict to score)'); }
                                        if (t.discardNoField) { bits.push(t.discardNoField + ' false by discard only, no field check'); }
                                        noteEl.textContent = bits.join(' · ');
                                        }

                                        if (!t.n) {
                                        bars.innerHTML = '<div class="aa-mx-empty">'
                                        + (list.length
                                        ? 'No alert in this window has both a review decision and an AI verdict yet.'
                                        : 'No alerts in this window.')
                                        + '</div>';
                                        if (legEl) { legEl.innerHTML = ''; }
                                        return;
                                        }

                                        if (byCause) {
                                        bars.innerHTML = aaMxCauseHtml(list, t.n);
                                        if (legEl) { legEl.innerHTML = aaMxLegendHtml(); }
                                        } else if (byDay) {
                                        bars.innerHTML = aaMxDayHtml(list);
                                        if (legEl) { legEl.innerHTML = aaMxLegendHtml(); }
                                        } else {
                                        bars.innerHTML = aaMxOutcomeHtml(t);
                                        if (legEl) { legEl.innerHTML = ''; }
                                        }
                                        }

                                        function aaMxOutcomeHtml(t) {
                                        // Scale to the biggest bucket, not to the total: with 300 agreements and 3 false
                                        // positives, scaling to the total draws the row that matters as an invisible sliver.
                                        var max = Math.max(t.TC, t.TN, t.FC, t.FN) || 1;
                                        var h = '';
                                        for (var d = 0; d < AA_MX_DEFS.length; d++) {
                                        var def = AA_MX_DEFS[d], n = t[def.k];
                                        var pct = Math.round((n / max) * 100);
                                        var on = (aaState.match === def.k);
                                        var pctOfScored = Math.round((n / t.n) * 100);
                                        var tip = def.lab + ' · ' + def.sub + ' — ' + n + ' of ' + t.n
                                        + ' scored (' + pctOfScored + '%)'
                                        + (n ? (on ? '. Click to clear the filter.' : '. Click to show only these.') : '');
                                        h += '<button type="button" class="aa-mxb ' + def.cls + (on ? ' on' : '') + (n ? '' : ' zero') + '"'
                                        + ' title="' + escapeHtml(tip) + '" aria-label="' + escapeHtml(tip) + '"'
                                        + ' aria-pressed="' + (on ? 'true' : 'false') + '"'
                                        + (n ? (' onclick="fnAaSetMatch(\'' + def.k + '\')"') : ' disabled')
                                        + '>'
                                        + '<span class="aa-mxb-lab"><b>' + def.lab + '</b><span>' + def.sub + '</span></span>'
                                        + '<span class="aa-mxb-track"><span class="aa-mxb-fill" style="width:'
                                        + (n ? pct : 0) + '%"></span></span>'
                                        + '<span class="aa-mxb-n">' + n + '</span>'
                                        + '</button>';
                                        }
                                        return h;
                                        }

                                        /* One row per cause code, the bar STACKED by outcome. Two encodings, deliberately:
                                        bar LENGTH is how many scored alerts that cause produced (volume), the SEGMENTS are
                                        how they split (quality). A short all-red bar and a long mostly-green one are
                                        different problems and this is the only view that separates them. */
                                        function aaMxCauseHtml(list, scoredTotal) {
                                        var by = {}, order = [];
                                        for (var i = 0; i < list.length; i++) {
                                        var a = list[i], s = aaScore(a);
                                        if (s.cell === '?') { continue; }
                                        var code = String(a.code || '').trim() || '(no cause code)';
                                        if (!by[code]) { by[code] = { code: code, TC: 0, TN: 0, FC: 0, FN: 0, n: 0 }; order.push(code); }
                                        by[code][s.cell]++; by[code].n++;
                                        }

                                        var rows = [];
                                        for (var o = 0; o < order.length; o++) { rows.push(by[order[o]]); }

                                        // Worst first: most disagreements, then most alerts, then alphabetical so the
                                        // order is stable between renders rather than shuffling on every reload.
                                        rows.sort(function (x, y) {
                                        var dx = x.TN + x.FC, dy = y.TN + y.FC;
                                        return (dy - dx) || (y.n - x.n) || x.code.localeCompare(y.code);
                                        });

                                        var shown = rows.slice(0, AA_MX_CAUSE_CAP);
                                        var max = 1;
                                        for (var m = 0; m < shown.length; m++) { if (shown[m].n > max) { max = shown[m].n; } }

                                        var h = '';
                                        for (var r = 0; r < shown.length; r++) {
                                        var c = shown[r];
                                        var dis = c.TN + c.FC;
                                        var on = (aaState.cause === c.code);
                                        var w = Math.round((c.n / max) * 100);
                                        var tip = c.code + ' — ' + c.n + ' scored, ' + dis + ' disagree ('
                                        + Math.round((dis / c.n) * 100) + '%)'
                                        + '. True/AI confirmed ' + c.TC + ', true/not confirmed ' + c.TN
                                        + ', false/AI confirmed ' + c.FC + ', false/not confirmed ' + c.FN
                                        + (on ? '. Click to clear the cause filter.' : '. Click to filter the board to this cause.');

                                        var seg = '';
                                        for (var d2 = 0; d2 < AA_MX_DEFS.length; d2++) {
                                        var def = AA_MX_DEFS[d2], nn = c[def.k];
                                        if (!nn) { continue; }
                                        seg += '<span class="aa-mxc-seg ' + def.cls + '" style="width:'
                                        + ((nn / c.n) * 100) + '%"></span>';
                                        }

                                        h += '<button type="button" class="aa-mxc' + (on ? ' on' : '') + '"'
                                        + ' title="' + escapeHtml(tip) + '" aria-label="' + escapeHtml(tip) + '"'
                                        + ' aria-pressed="' + (on ? 'true' : 'false') + '"'
                                        + ' onclick="fnAaSetCause(\'' + escapeHtml(c.code).replace(/'/g, "\\'") + '\')">'
                                        + '<span class="aa-mxc-code" title="' + escapeHtml(c.code) + '">' + escapeHtml(c.code) + '</span>'
                                        + '<span class="aa-mxc-track" style="width:' + w + '%">' + seg + '</span>'
                                        + '<span class="aa-mxc-n">' + c.n
                                        + (dis ? ('<i class="bad">' + dis + '</i>') : '<i class="good">0</i>')
                                        + '</span>'
                                        + '</button>';
                                        }

                                        if (rows.length > shown.length) {
                                        h += '<div class="aa-mx-more">' + (rows.length - shown.length)
                                        + ' more cause code' + ((rows.length - shown.length) === 1 ? '' : 's')
                                        + ' not shown — they have fewer disagreements than those above.</div>';
                                        }
                                        return h;
                                        }

                                        // Only drawn in cause view, where the colours are segments rather than whole rows and
                                        // are no longer self-labelling.
                                        /* v1.0.2.5: DAY, the third cut. Outcome says how often the AI is right, Cause code
                                        says which faults it is wrong about, and Day says WHEN -- which is the one that
                                        catches a regression. A model swap, a prompt change or a threshold edit shows up
                                        as the agreement rate falling on a date, and no amount of staring at the other two
                                        views will surface that, because both average the whole window flat.

                                        Each day row carries the cause codes behind its disagreements on the tooltip, so
                                        "the 14th went bad" leads straight to "...and it was all PT R OBS" without
                                        switching views and re-filtering. */
                                        /* v1.0.3.4 -- EVERY DAY WITH DATA, AND THE CAUSE CODES UNDER EACH ONE.

                                        AA_MX_DAY_CAP kept the newest fourteen and printed "N earlier days not shown --
                                        narrow the date window to reach them", which asks the operator to run a second
                                        query to see data the first one already returned. The cap is gone: a day that has
                                        scored alerts gets a row. A day with none still gets no row, which is the same
                                        rule as before and the right one -- "no alerts" and "no agreement" are different
                                        facts and a zero-height bar would assert the second.

                                        THE CAUSE CODES ARE THE POINT OF THE ROW. The bar says a day went badly; it
                                        never said what went badly, and the only way to find out was to switch to the
                                        cause view, which averages the whole window flat and so cannot tell you it was
                                        that day. ALL the day's codes are chipped, not just the ones behind
                                        disagreements -- a day that is 20 alerts of one code is a story whether the AI
                                        got them right or not. Disagreements are still marked, so the chip that is
                                        costing agreement is findable inside the chip that is merely frequent.

                                        The chips are BUTTONS, like the cause view's rows and unlike the day bar itself:
                                        a cause filter exists on this board, a day filter does not. */
                                        function aaMxDayHtml(list) {
                                        var by = {}, order = [];
                                        for (var i = 0; i < list.length; i++) {
                                        var a = list[i], s = aaScore(a);
                                        if (s.cell === '?') { continue; }
                                        var key = aaDayLabel(a) || 'Undated';
                                        if (!by[key]) {
                                        by[key] = { day: key, TC: 0, TN: 0, FC: 0, FN: 0, n: 0, sort: String(a.timeSort || ''), codes: {} };
                                        order.push(key);
                                        }
                                        var d = by[key];
                                        d[s.cell]++; d.n++;
                                        // Keep the EARLIEST timestamp seen for the day as its sort key: rows arrive in
                                        // no guaranteed order and the label alone ("14 Sep") does not sort.
                                        var ts = String(a.timeSort || '');
                                        if (ts && (!d.sort || ts < d.sort)) { d.sort = ts; }
                                        var cc = String(a.code || '').trim() || '(no cause code)';
                                        if (!d.codes[cc]) { d.codes[cc] = { n: 0, bad: 0 }; }
                                        d.codes[cc].n++;
                                        if (s.cell === 'TN' || s.cell === 'FC') { d.codes[cc].bad++; }
                                        }

                                        var rows = [];
                                        for (var o = 0; o < order.length; o++) { rows.push(by[order[o]]); }
                                        // Chronological, newest first -- the same direction the board reads everywhere else.
                                        rows.sort(function (x, y) { return (y.sort > x.sort) ? 1 : ((y.sort < x.sort) ? -1 : 0); });

                                        var max = 1;
                                        for (var m = 0; m < rows.length; m++) { if (rows[m].n > max) { max = rows[m].n; } }

                                        var h = '';
                                        for (var r = 0; r < rows.length; r++) {
                                        var c = rows[r];
                                        var dis = c.TN + c.FC;
                                        var w = Math.round((c.n / max) * 100);

                                        // Worst first, then busiest, then alphabetical so the order is stable between
                                        // renders instead of shuffling on every reload.
                                        var codes = [];
                                        for (var k in c.codes) {
                                        if (c.codes.hasOwnProperty(k)) { codes.push({ code: k, n: c.codes[k].n, bad: c.codes[k].bad }); }
                                        }
                                        codes.sort(function (x, y) {
                                        return (y.bad - x.bad) || (y.n - x.n) || x.code.localeCompare(y.code);
                                        });

                                        var badTxt = '', nb = 0;
                                        for (var b = 0; b < codes.length && nb < 3; b++) {
                                        if (!codes[b].bad) { continue; }
                                        badTxt += (nb ? ', ' : '') + codes[b].code + ' x' + codes[b].bad;
                                        nb++;
                                        }

                                        var tip = c.day + ' — ' + c.n + ' scored, ' + dis + ' disagree ('
                                        + Math.round((dis / c.n) * 100) + '%)'
                                        + '. True/AI confirmed ' + c.TC + ', true/not confirmed ' + c.TN
                                        + ', false/AI confirmed ' + c.FC + ', false/not confirmed ' + c.FN
                                        + (badTxt ? ('. Disagreements: ' + badTxt) : '')
                                        + '. ' + codes.length + ' cause code' + (codes.length === 1 ? '' : 's') + ' this day.';

                                        var seg = '';
                                        for (var d2 = 0; d2 < AA_MX_DEFS.length; d2++) {
                                        var def = AA_MX_DEFS[d2], nn = c[def.k];
                                        if (!nn) { continue; }
                                        seg += '<span class="aa-mxc-seg ' + def.cls + '" style="width:'
                                        + ((nn / c.n) * 100) + '%"></span>';
                                        }

                                        // Not a button: there is no day FILTER on this board -- the date window is a
                                        // server reload, not a client filter -- so a clickable row would promise
                                        // something it cannot do. Read-only, and it says so by not looking pressable.
                                        h += '<div class="aa-mxd">'
                                        + '<div class="aa-mxc as-row" title="' + escapeHtml(tip) + '">'
                                        + '<span class="aa-mxc-code">' + escapeHtml(c.day) + '</span>'
                                        + '<span class="aa-mxc-track" style="width:' + w + '%">' + seg + '</span>'
                                        + '<span class="aa-mxc-n">' + c.n
                                        + (dis ? ('<i class="bad">' + dis + '</i>') : '<i class="good">0</i>')
                                        + '</span>'
                                        + '</div>'
                                        + aaMxDayCodesHtml(codes)
                                        + '</div>';
                                        }
                                        return h;
                                        }

                                        /* The cause chips under one day. n is the day's count for that code; the
                                        superscript is how many of them the AI got wrong, shown only when there ARE any --
                                        a "0" on every chip would be nine characters of nothing on a busy day. */
                                        function aaMxDayCodesHtml(codes) {
                                        if (!codes.length) { return ''; }
                                        var h = '<div class="aa-mxd-cc">';
                                        for (var i = 0; i < codes.length; i++) {
                                        var c = codes[i], on = (aaState.cause === c.code);
                                        var tip = c.code + ' — ' + c.n + ' on this day'
                                        + (c.bad ? (', ' + c.bad + ' the AI disagreed on') : ', none disputed')
                                        + (on ? '. Click to clear the cause filter.' : '. Click to filter the board to this cause.');
                                        h += '<button type="button" class="aa-mxd-c' + (c.bad ? ' bad' : '') + (on ? ' on' : '') + '"'
                                        + ' title="' + escapeHtml(tip) + '" aria-label="' + escapeHtml(tip) + '"'
                                        + ' aria-pressed="' + (on ? 'true' : 'false') + '"'
                                        + ' onclick="fnAaSetCause(\'' + escapeHtml(c.code).replace(/'/g, "\\'") + '\')">'
                                        + escapeHtml(c.code)
                                        + '<b>' + c.n + '</b>'
                                        + (c.bad ? ('<i>' + c.bad + '</i>') : '')
                                        + '</button>';
                                        }
                                        return h + '</div>';
                                        }

                                        function aaMxLegendHtml() {
                                        var h = '';
                                        for (var i = 0; i < AA_MX_DEFS.length; i++) {
                                        var d = AA_MX_DEFS[i];
                                        h += '<span class="aa-mx-lg"><i class="' + d.cls + '"></i>'
                                        + d.lab + ' · ' + d.sub + '</span>';
                                        }
                                        return h;
                                        }

                                        /* Clicking the active row CLEARS it -- same behaviour as the site and cause chips,
                                        where clicking what is already selected is how you get back to everything. */
                                        function fnAaSetMatch(k) {
                                        aaState.match = (aaState.match === k) ? null : k;
                                        fnAaRenderAll();
                                        }

                                        /* ---- the card ---- */
                                        function aaCard(a) {
                                        var fail = (a.type === 'Failure'), cls = fail ? 'fail' : 'pred', open = !a.resetText;
                                        // v1.0.1.0: open work is louder than closed work. A live failure and a fault
                                        // cleared two days ago should not read at the same weight.
                                        return '<article class="aa-ac ' + cls + (open ? ' is-open' : ' done') + '" data-id="' + a.id + '">'
                                        + '<div class="aa-ac-hd">'
                                        + aaDisc(a)
                                        + '<b>' + escapeHtml(a.asset || '') + '</b>'
                                        + (open ? '<span class="aa-livedot" aria-hidden="true"></span>' : '')
                                        + '<span class="aa-ac-t">' + escapeHtml(aaTimeLabel(a)) + '</span>'
                                        + '<span class="aa-chip ' + cls + '">' + (fail ? 'Failure' : 'Predictive') + '</span>'
                                        + '</div>'
                                        + '<div class="aa-ac-cause"><a onclick="fnShowAlertMessage(' + a.id + ')">'
                                        + escapeHtml(a.code || '') + '</a></div>'
                                        + '<div class="aa-ac-sr">'
                                        + '<span class="aa-sr"><span class="aa-set">'
                                        + escapeHtml(aaTimeLabel(a).substring(0, 5)) + '</span>'
                                        + '<span class="aa-arw">&rarr;</span>'
                                        + (open ? '<span class="aa-rst open">OPEN</span>'
                                        : '<span class="aa-rst">' + escapeHtml(aaResetLabel(a)) + '</span>')
                                        + '</span>'
                                        + (open
                                        ? (aaOpenFor(a)
                                        ? '<span class="aa-openfor" title="Time since this alert was raised">'
                                        + escapeHtml(aaOpenFor(a)) + ' &amp; counting</span>'
                                        : '')
                                        : '<span class="aa-eld">' + escapeHtml(aaElapsed(a.durationText)) + '</span>')
                                        + '</div>'
                                        + '<div class="aa-ac-id">'
                                        + aaTypeBadge(a.assetType)
                                        + '<span class="aa-tcs' + (aaState.site ? '' : ' hi') + '">' + escapeHtml(a.station || '') + '</span>'
                                        + (a.division ? '<span class="aa-tcd">' + escapeHtml(a.division) + '</span>' : '')
                                        + '</div>'
                                        + '<div class="aa-ac-ft">'
                                        + aaVerdictStateCell(a.id)
                                        // v1.0.2.0: the validity switch on the card too, and on the LEFT where the
                                        // decision disc already sits. The card and the table are two views of one
                                        // board -- a judgement recordable in one and not the other would make the
                                        // view toggle change what an operator is allowed to do.
                                        + aaValidToggle(a)
                                        + '<span class="aa-ac-sp"></span>'
                                        + '<span class="aa-rate-lbl">AI rating</span>'
                                        + aaRateChip(a)
                                        + aaInsightBtn(a.id)
                                        + aaDetailBtn(a.id)
                                        + '</div>'
                                        + '</article>';
                                        }

                                        function fnAaRenderCards(list) {
                                        var host = document.getElementById('aaCardsWrap');
                                        if (!host) { return; }
                                        var rows = aaSortRows(list);
                                        var h = '';

                                        if (AA_SORT === 'priority') {
                                        // Two sections, not twenty date headings. Under Priority the question is
                                        // "is it still happening", and the date a cleared alert fell on is detail.
                                        var live = [], done = [];
                                        for (var i = 0; i < rows.length; i++) {
                                        if (aaIsOpen(rows[i])) { live.push(rows[i]); } else { done.push(rows[i]); }
                                        }
                                        var lf = 0;
                                        for (var q = 0; q < live.length; q++) { if (live[q].type === 'Failure') { lf++; } }

                                        if (live.length) {
                                        h += '<div class="aa-sec hot"><span class="aa-sec-dot"></span>'
                                        + '<h2>Still open</h2><i></i><em>' + live.length + ' alert'
                                        + (live.length === 1 ? '' : 's')
                                        + (lf ? ' &middot; ' + lf + ' failure' : '') + '</em></div>'
                                        + '<div class="aa-grid">' + aaCardsHtml(live) + '</div>';
                                        }
                                        if (done.length) {
                                        h += '<div class="aa-sec"><h2>Cleared</h2><i></i><em>' + done.length
                                        + ' alert' + (done.length === 1 ? '' : 's') + '</em></div>'
                                        + '<div class="aa-grid">' + aaCardsHtml(done) + '</div>';
                                        }
                                        } else {
                                        var days = [], map = {};
                                        for (var j = 0; j < rows.length; j++) {
                                        var d = aaDayLabel(rows[j]);
                                        if (!map[d]) { map[d] = []; days.push(d); }
                                        map[d].push(rows[j]);
                                        }
                                        for (var k = 0; k < days.length; k++) {
                                        var g = map[days[k]];
                                        h += '<div class="aa-sec"><h2>' + escapeHtml(days[k]) + '</h2><i></i><em>'
                                        + g.length + ' alert' + (g.length === 1 ? '' : 's') + '</em></div>'
                                        + '<div class="aa-grid">' + aaCardsHtml(g) + '</div>';
                                        }
                                        }
                                        host.innerHTML = h;
                                        }

                                        function aaCardsHtml(rows) {
                                        var out = '';
                                        for (var i = 0; i < rows.length; i++) { out += aaCard(rows[i]); }
                                        return out;
                                        }

                                        /* ---- review-state chips ---- */
                                        function aaDecCounts() {
                                        var c = { ALL: AA_WINDOW.length, A: 0, D: 0 };
                                        for (var i = 0; i < AA_WINDOW.length; i++) { c[aaDecision(AA_WINDOW[i]).k]++; }
                                        return c;
                                        }
                                        function fnAaSetDecision(k) { AA_DEC = k; fnAaRenderAll(); }
                                        function fnAaRenderDecBar() {
                                        var host = document.getElementById('aaDecBar');
                                        if (!host) { return; }
                                        var c = aaDecCounts();
                                        // v1.0.1.6: discarded alerts are sitekeeping-only and the server no longer sends them
                                        // to anyone else. Showing the chip regardless would offer a filter that can only read
                                        // zero -- which says "nothing was discarded today", not "this is not yours to see".
                                        var defs = AA_PRIV
                                        ? [['ALL', 'All', ''], ['A', 'Approved', 'a'], ['D', 'Discarded', 'd']]
                                        : [['ALL', 'All', ''], ['A', 'Approved', 'a']];
                                        var h = '';
                                        for (var i = 0; i < defs.length; i++) {
                                        var on = (AA_DEC === defs[i][0]) ? (' on ' + defs[i][2]) : '';
                                        h += '<button type="button" class="aa-decseg' + on + '"'
                                        + ' onclick="fnAaSetDecision(\'' + defs[i][0] + '\')">'
                                        + defs[i][1] + '<b>' + c[defs[i][0]] + '</b></button>';
                                        }
                                        host.innerHTML = h;
                                        }

                                        /* ==================================================================
                                        v1.0.1.5 -- RATE THIS ANALYSIS
                                        The star chip was display-only because nothing could store a rating. It can now:
                                        SaveAiRating posts to api/AIRating/Upsert, having resolved the AnalysisId from
                                        FRSAlert_AIAnalysis. The rule this has to clear is 1.0.55.101 -- a control that
                                        cannot save is worse than no control, because the operator believes a judgement
                                        was recorded when it was not. So nothing here shows as saved until the server
                                        says the row was written.
                                        ================================================================== */

                                        // Keyed with a PREFIX. Approved ids are FRSAlert ids and discarded ids are
                                        // PendingAlertApproval ids -- 3010 is valid in both spaces and means two different
                                        // alerts, so a bare id as the key would hand one alert's rating to another.
                                        var AA_RATING = {};
                                        function aaRatingKey(a) {
                                        return (aaDecision(a).k === 'A' ? 'F:' : 'P:') + a.id;
                                        }
                                        function aaRatingOf(a) { return AA_RATING[aaRatingKey(a)] || null; }

                                        /* A rating attaches to an ANALYSIS RUN, not to an alert -- the API takes an
                                        AnalysisId, resolved server-side from FRSAlert_AIAnalysis. An alert nobody has
                                        analysed has no run to rate. Saying so on the chip is the point: offering a dialog
                                        that can only fail is the 1.0.55.101 mistake with extra steps. */
                                        function aaCanRate(a) {
                                        var st = aaRatingOf(a);
                                        return !!(st && Number(st.analysisId || 0) > 0);
                                        }

                                        // One batched read per board load, the same shape as fnAaLoadVerdictStates. Called
                                        // from fnAaRenderAll, never from the render itself -- a fetch inside the renderer
                                        // whose success handler re-renders would fetch forever.
                                        function fnAaLoadRatings(list) {
                                        try {
                                        if (!list || !list.length) { return; }
                                        var frs = [], pend = [];
                                        // v1.0.1.9: NO CAP. This one stopped at 400 while the window held 412, so twelve
                                        // alerts never had their ids SENT -- they got no map entry, aaCanRate returned
                                        // false, and their chips read "not analysed" with the rows sitting in
                                        // FRSAlert_AIAnalysis. Alert 3176 was one of them. Truncation was in AA_INRANGE
                                        // order, so which alerts were affected had nothing to do with anything on screen.
                                        // Capping the QUERY is fine; capping the QUESTION changes the answer.
                                        for (var i = 0; i < list.length; i++) {
                                        if (aaDecision(list[i]).k === 'A') { frs.push(list[i].id); } else { pend.push(list[i].id); }
                                        }
                                        if (!frs.length && !pend.length) { return; }
                                        $.ajax({
                                        url: '@Url.Action("AlertRatings", "UnifiedAlertAnalysis")',
                                        type: 'POST', contentType: 'application/json',
                                        data: JSON.stringify({ frsIds: frs, pendingIds: pend }),
                                        success: function (d) {
                                        // v1.0.1.9: a silent return left every chip disabled with no explanation,
                                        // indistinguishable from "nothing has been analysed". Say which it is.
                                        if (!d || !d.ok || !d.ratings) {
                                        try { console.warn('AlertRatings: ' + ((d && d.error) ? d.error : 'no response')); } catch (e) { }
                                        return;
                                        }
                                        AA_RATING = d.ratings;
                                        // v1.0.2.8: the answer is now known for EVERY row in the window --
                                        // this call carries no cap (1.0.1.9) -- so the chips may say "not
                                        // analysed" and Detail may go unavailable. Set before the re-render
                                        // below, or the first repaint still shows every row as unknown.
                                        AA_ANALYSIS_READY = true;
                                        // v1.0.2.0: the validity marks ride back on the SAME response. Defaulted
                                        // to an empty map rather than left undefined -- an older cached copy of
                                        // the controller returns no such field, and every toggle must then read
                                        // "not marked" instead of throwing inside the renderer.
                                        AA_ASSESS = d.assessments || {};
                                        fnAaRenderTable();   // redraw with the stored ratings; no further fetch
                                        },
                                        error: function () { /* the board must render regardless */ }
                                        });
                                        } catch (e) { }
                                        }

                                        /* ==================================================================
                                        v1.0.2.0 -- WAS THE ALERT VALID?

                                        A second judgement, and a different one from the stars. The stars say what a
                                        person thought of the AI's ANALYSIS; this says whether the ALERT was worth
                                        raising at all. Written through api/AIAssessment/Upsert as AssessmentRole
                                        REVIEWER with AssessedBy = the login USER ID (the CLIENT rows that
                                        AlertLiveController writes carry a display name instead; the reviewer record
                                        has to point at an account).

                                        THE STATE IS READ FIRST. AlertRatings returns an `assessments` map beside
                                        `ratings` on the same board-load request, so a toggle opens showing what a
                                        reviewer already recorded. Rendering every switch as unmarked and letting the
                                        operator answer a question that was answered last week is how a review record
                                        fills up with contradictions.
                                        ================================================================== */

                                        // Same "F:"/"P:" keying as AA_RATING, and for the same reason: approved ids are
                                        // FRSAlert ids, discarded ids are PendingAlertApproval ids, and 3010 is a valid
                                        // id in both spaces.
                                        var AA_ASSESS = {};
                                        function aaAssessOf(a) { return AA_ASSESS[aaRatingKey(a)] || null; }

                                        // true | false | null. null is UNMARKED and is not the same as false -- the API
                                        // column is nullable and a REVIEWER row can exist with no answer to this question.
                                        function aaValidOf(a) {
                                        var s = aaAssessOf(a);
                                        if (!s) { return null; }
                                        return (s.useful === true) ? true : ((s.useful === false) ? false : null);
                                        }

                                        // A judgement attaches to an ANALYSIS RUN, exactly as a rating does, so the same
                                        // test applies: no run, nothing to mark. AIAssessment keys on AnalysisId, so a mark
                                        // on an unanalysed alert has no row to land in -- the switch says so instead of
                                        // taking a click it cannot honour. aaCanRate already asks this question of
                                        // AA_RATING, which is populated from the same call.
                                        function aaCanMark(a) { return aaCanRate(a); }

                                        function aaValidToggle(a) {
                                        var v = aaValidOf(a);
                                        var can = aaCanMark(a);
                                        var s = aaAssessOf(a);
                                        var cls = 'aa-vt ' + (v === true ? 'yes' : (v === false ? 'no' : 'unset'))
                                        + (can ? ' can' : ' na');
                                        var word = (v === true) ? 'Valid' : ((v === false) ? 'Not valid' : 'Mark');
                                        // v1.0.2.1: the NAME, with the id as the fallback. AssessedBy stores a user id --
                                        // that is the right thing to store and the wrong thing to show -- so the server
                                        // resolves it through User/GetUserById and sends byName alongside. When the lookup
                                        // found nothing, the id is still shown: "by 1134" is poor, but "by" with nothing
                                        // after it reads as an unattributed judgement, which is worse and untrue.
                                        var whoName = (s && (s.byName || s.by)) ? String(s.byName || s.by) : '';
                                        var who = whoName ? (' by ' + whoName + (s.at ? (' on ' + s.at) : '')) : '';
                                        var tip = !can
                                        ? 'Run Insight first -- a validity mark attaches to an analysis'
                                        : (v === null
                                        ? 'Not marked. Click to record that this alert was valid.'
                                        : ('Marked ' + (v ? 'VALID' : 'NOT VALID') + who + '. Click to change.'));
                                        return '<button type="button" class="' + cls + '" data-vt="' + a.id + '"'
                                        + ' aria-pressed="' + (v === true ? 'true' : 'false') + '"'
                                        + ' aria-label="Alert validity: ' + (v === null ? 'not marked' : (v ? 'valid' : 'not valid')) + '"'
                                        + ' title="' + escapeHtml(tip) + '"'
                                        + (can ? '' : ' disabled')
                                        + (can ? (' onclick="fnAaToggleValid(' + a.id + ',event)"') : '')
                                        + '><span class="aa-vt-tr"><i></i></span><b>' + word + '</b></button>';
                                        }
                                        /* One click, one write. Unmarked goes to VALID first because that is the answer an
                                        operator reaches for -- the alert fired and it was real. A second click says not
                                        valid, a third says valid again: the endpoint is an Upsert, so a mis-click is
                                        correctable rather than permanent.

                                        Nothing on screen moves until the server confirms the row was written. The switch
                                        shows `busy` while the request is out and snaps back with `err` if it fails --
                                        1.0.55.101 removed the previous validity buttons precisely because they LOOKED
                                        like they had recorded a judgement that went nowhere. */
                                        function fnAaToggleValid(id, ev) {
                                        if (ev) { if (ev.stopPropagation) { ev.stopPropagation(); } if (ev.preventDefault) { ev.preventDefault(); } }
                                        var a = aaRowById(Number(id));
                                        if (!a) { return; }
                                        // Belt and braces. The button carries no onclick when it cannot be marked, but a
                                        // re-render can race a click, and this function is reachable from the console.
                                        if (!aaCanMark(a)) { return; }

                                        var key = aaRatingKey(a);
                                        var cur = aaValidOf(a);
                                        var next = (cur === true) ? false : true;

                                        // Re-queried by data-vt rather than held as a handle, here and on the failure
                                        // path: the board re-renders on its own timer, so the element that was clicked
                                        // may already have been replaced by the time the response lands.
                                        var b0 = document.querySelector('#aaBoard .aa-vt[data-vt="' + id + '"]');
                                        if (b0) {
                                        if (b0.disabled) { return; }   // a second click while the first is in flight
                                        b0.disabled = true;
                                        b0.className += ' busy';
                                        }

                                        $.ajax({
                                        url: '@Url.Action("SaveAlertValidity", "UnifiedAlertAnalysis")',
                                        type: 'POST', contentType: 'application/json',
                                        data: JSON.stringify({
                                        id: Number(id),
                                        // The same discriminator the rating save uses. Approved ids are FRSAlert
                                        // ids; everything else is a PendingAlertApproval id.
                                        source: (aaDecision(a).k === 'A') ? 'frs' : 'pending',
                                        useful: next
                                        // No analysisId. The controller resolves it from FRSAlert_AIAnalysis, so
                                        // the browser cannot aim a judgement at another alert's run.
                                        }),
                                        success: function (d) {
                                        if (!d || !d.ok) {
                                        aaValidFail(id, (d && d.error) ? d.error : 'Save failed.');
                                        return;
                                        }
                                        var prev = AA_ASSESS[key] || {};
                                        AA_ASSESS[key] = {
                                        analysisId: Number(d.analysisId || prev.analysisId || 0),
                                        useful: (d.useful === true),
                                        by: d.by || '',
                                        // v1.0.2.1: the server resolves the saver's name and returns it, so the
                                        // tooltip reads "by <name>" immediately instead of showing the raw id
                                        // until the next board load fills it in.
                                        byName: d.byName || '',
                                        at: d.at || aaNowStamp(),
                                        revised: !!d.revised
                                        };
                                        fnAaRenderTable();
                                        },
                                        error: function (xhr) {
                                        aaValidFail(id, 'Save failed (HTTP ' + (xhr ? xhr.status : 0) + ').');
                                        }
                                        });
                                        }

                                        /* The save did not happen. Say so ON the control -- there is no toast on this board,
                                        and a console warning is not a thing an operator sees. The switch keeps the value
                                        the SERVER still holds; clicking again retries. */
                                        function aaValidFail(id, msg) {
                                        try { console.warn('SaveAlertValidity: ' + msg); } catch (e) { }
                                        var b = document.querySelector('#aaBoard .aa-vt[data-vt="' + id + '"]');
                                        if (!b) { return; }
                                        b.disabled = false;
                                        b.className = b.className.replace(/\s*busy/g, '') + ' err';
                                        b.title = msg;
                                        var lbl = b.querySelector('b');
                                        if (lbl) { lbl.textContent = 'Failed'; }
                                        // Back to the true state after a moment, so a stale "Failed" does not sit on a
                                        // row the next board reload has already refreshed.
                                        setTimeout(function () { try { fnAaRenderTable(); } catch (e) { } }, 4000);
                                        }

                                        var AA_RDLG = null, AA_RVAL = 0, AA_RID = 0;
                                        var AA_RWORDS = ['', 'Wrong', 'Weak', 'Partly right', 'Good', 'Exactly right'];

                                        function fnAaOpenRating(id, ev) {
                                        try {
                                        // The chip also carries data-pop="ai", so without this the hover flyout and the
                                        // dialog both react to the same click.
                                        if (ev) { if (ev.stopPropagation) { ev.stopPropagation(); } if (ev.preventDefault) { ev.preventDefault(); } }
                                        aaPopHide();
                                        fnAaCloseRating();
                                        var a = aaRowById(Number(id));
                                        if (!a) { return; }
                                        var st = aaRatingOf(a);
                                        AA_RID = Number(id);
                                        AA_RVAL = st ? Number(st.rating || 0) : 0;
                                        // v1.0.1.0: RATINGS ARE EDITABLE. 1.0.1.8 made the dialog a read-only receipt
                                        // once a rating existed, so a mis-click was permanent and a reviewer who learned
                                        // more later could not correct the record. The form is always a form now; an
                                        // existing rating pre-fills it and is shown as "current" so the operator can see
                                        // what they are changing before they change it.
                                        var _ro = false;
                                        var _hadRating = (AA_RVAL > 0);

                                        var ov = document.createElement('div');
                                        ov.className = 'aa-rdlg-ov';
                                        ov.innerHTML =
                                        '<div class="aa-rdlg" role="dialog" aria-modal="true" aria-label="Rate this analysis">'
                                        + '<div class="aa-rdlg-h"><b>Rate this analysis</b><span>'
                                        + escapeHtml((a.asset || '') + ' \u00b7 ' + (a.station || '') + ' \u00b7 ' + (a.code || ''))
                                        + '</span></div>'
                                        + '<div class="aa-rdlg-b">'
                                        // v1.0.1.0: the CURRENT rating is shown above the form when one exists, so
                                        // an edit starts from a visible baseline rather than silently overwriting a
                                        // value the operator never saw. The stars below are pre-filled with it.
                                        + (_hadRating
                                        ? ('<div class="aa-rcur">Current: <b>' + AA_RVAL + ' / 5</b> \u00b7 '
                                        + escapeHtml(AA_RWORDS[AA_RVAL])
                                        + ((st && st.by) ? (' \u00b7 by ' + escapeHtml(st.by)
                                        + (st.at ? (' on ' + escapeHtml(st.at)) : '')) : '')
                                        + '</div>')
                                        : '')
                                        + '<div class="aa-rdlg-q">How good was the AI analysis?</div>'
                                        + '<div class="aa-rstars" id="aaRStars"></div>'
                                        + '<div class="aa-rword" id="aaRWord"></div>'
                                        + '<div class="aa-rdlg-q">Remark (optional)</div>'
                                        + '<textarea id="aaRRem" maxlength="2000" placeholder="What did it get right or wrong?"></textarea>'
                                        + '<div class="aa-rcount" id="aaRCount">0 / 2000</div>'
                                        + '</div>'
                                        + '<div class="aa-rdlg-f"><span class="aa-rmsg" id="aaRMsg">'
                                        + (_hadRating ? 'Saving will replace the current rating.' : '') + '</span>'
                                        + '<button type="button" class="aa-rbtn" onclick="fnAaCloseRating()">Cancel</button>'
                                        + '<button type="button" class="aa-rbtn pri" id="aaRSave" onclick="fnAaSaveRating()">'
                                        + (_hadRating ? 'Update' : 'Save') + '</button>'
                                        + '</div></div>';
                                        ov.onclick = function (e) { if (e.target === ov) { fnAaCloseRating(); } };
                                        document.body.appendChild(ov);
                                        AA_RDLG = ov;

                                        var ta = document.getElementById('aaRRem');
                                        if (ta) {
                                        ta.value = st ? String(st.remark || '') : '';
                                        ta.oninput = function () {
                                        var c = document.getElementById('aaRCount');
                                        if (c) { c.textContent = ta.value.length + ' / 2000'; }
                                        };
                                        ta.oninput();
                                        }
                                        fnAaPaintStars();
                                        // Focus the remark only when a rating already exists; on a fresh rating the
                                        // stars are the first thing to answer.
                                        if (ta && AA_RVAL > 0) { ta.focus(); }
                                        } catch (e) { }
                                        }

                                        function fnAaPaintStars() {
                                        var host = document.getElementById('aaRStars');
                                        if (!host) { return; }
                                        var h = '';
                                        // v1.0.1.8: read-only means plain glyphs, not disabled buttons -- a disabled control
                                        // still reads as something that ought to work.
                                        if (host.className.indexOf('arp-ro') >= 0) {
                                        for (var k = 1; k <= 5; k++) { h += aaStar(k <= AA_RVAL); }
                                        host.innerHTML = h;
                                        var w0 = document.getElementById('aaRWord');
                                        if (w0) { w0.textContent = AA_RVAL + ' / 5 \u00b7 ' + AA_RWORDS[AA_RVAL]; }
                                        return;
                                        }
                                        for (var i = 1; i <= 5; i++) {
                                        h += '<button type="button" aria-label="' + i + ' of 5" title="' + AA_RWORDS[i] + '"'
                                        + ' onclick="fnAaSetRating(' + i + ')">' + aaStar(i <= AA_RVAL) + '</button>';
                                        }
                                        host.innerHTML = h;
                                        var w = document.getElementById('aaRWord');
                                        if (w) { w.textContent = AA_RVAL > 0 ? (AA_RVAL + ' / 5 \u00b7 ' + AA_RWORDS[AA_RVAL]) : 'Pick a rating to enable Save.'; }
                                        var b = document.getElementById('aaRSave');
                                        if (b) { b.disabled = !(AA_RVAL > 0); }
                                        }

                                        function fnAaSetRating(n) {
                                        AA_RVAL = Number(n) || 0;
                                        var m = document.getElementById('aaRMsg');
                                        if (m) { m.className = 'aa-rmsg'; m.textContent = ''; }
                                        fnAaPaintStars();
                                        }

                                        function fnAaCloseRating() {
                                        if (AA_RDLG && AA_RDLG.parentNode) { AA_RDLG.parentNode.removeChild(AA_RDLG); }
                                        AA_RDLG = null; AA_RVAL = 0; AA_RID = 0;
                                        }

                                        function fnAaSaveRating() {
                                        var a = aaRowById(AA_RID);
                                        if (!a || !(AA_RVAL > 0)) { return; }
                                        var btn = document.getElementById('aaRSave');
                                        var msg = document.getElementById('aaRMsg');
                                        var ta = document.getElementById('aaRRem');
                                        var remark = ta ? ta.value : '';
                                        var id = AA_RID, val = AA_RVAL;
                                        if (btn) { btn.disabled = true; btn.textContent = 'Saving...'; }
                                        if (msg) { msg.className = 'aa-rmsg'; msg.textContent = ''; }

                                        $.ajax({
                                        url: '@Url.Action("SaveAiRating", "UnifiedAlertAnalysis")',
                                        type: 'POST', contentType: 'application/json',
                                        data: JSON.stringify({
                                        id: id,
                                        // The SAME discriminator the popup and the analysis link use. Approved ids
                                        // are FRSAlert ids; everything else is a PendingAlertApproval id.
                                        source: (aaDecision(a).k === 'A') ? 'frs' : 'pending',
                                        rating: val,
                                        remark: remark
                                        // No analysisId here on purpose. The controller resolves it from
                                        // FRSAlert_AIAnalysis -- by FRSAlertId or PendingAlertApprovalId -- so the
                                        // browser cannot send a run id that belongs to a different alert.
                                        }),
                                        success: function (d) {
                                        if (!d || !d.ok) {
                                        // Stay open and say so. A dialog that closes on failure is how an
                                        // operator ends up believing a judgement was stored when it was not.
                                        if (msg) { msg.className = 'aa-rmsg err'; msg.textContent = (d && d.error) ? d.error : 'Save failed.'; }
                                        // "Never analysed" is not a transient failure -- pressing Save again
                                        // cannot help, so the button stays down and the wording says what will.
                                        if (btn) {
                                        btn.disabled = !!(d && d.notAnalysed);
                                        btn.textContent = 'Save';
                                        }
                                        return;
                                        }
                                        var _prev = AA_RATING[aaRatingKey(a)] || {};
                                        AA_RATING[aaRatingKey(a)] = {
                                        analysisId: Number(d.analysisId || _prev.analysisId || 0),
                                        // v1.0.1.0: stamp the edit locally so the panel can say WHEN the latest
                                        // value was set without waiting for the next board reload.
                                        rating: d.rating, remark: d.remark || '', by: d.ratedBy || '',
                                        at: aaNowStamp(),
                                        revised: !!(d && d.revised),
                                        previousRating: Number((d && d.previousRating) || 0),
                                        previousRemark: (d && d.previousRemark) || ''
                                        };
                                        // v1.0.1.0: says which of the two happened. "Saved" on an edit hides the
                                        // fact that a previous judgement was replaced.
                                        if (msg) {
                                        msg.className = 'aa-rmsg ok';
                                        msg.textContent = (d && d.revised)
                                        ? ('Updated' + (Number(d.previousRating) > 0
                                        ? (' (was ' + Number(d.previousRating) + '/5).') : '.'))
                                        : 'Saved.';
                                        }
                                        fnAaRenderTable();
                                        setTimeout(fnAaCloseRating, (d && d.revised) ? 900 : 450);
                                        },
                                        error: function (xhr) {
                                        if (btn) { btn.disabled = false; btn.textContent = 'Save'; }
                                        if (msg) {
                                        msg.className = 'aa-rmsg err';
                                        msg.textContent = 'Save failed (HTTP ' + (xhr ? xhr.status : 0) + ').';
                                        }
                                        }
                                        });
                                        }

                                        /* v1.0.1.7: RATE FROM INSIDE THE POPUP.
                                        Same store, same endpoint, same rules as the board chip -- this is a second way in,
                                        not a second implementation. AA_RATING is updated on save so the chip behind the
                                        popup already shows the new number when you close it. */
                                        var AI_RVAL = 0;

                                        function fnAiRenderRatePanel() {
                                        var host = document.getElementById('aiRatePanel');
                                        if (!host) { return; }
                                        var a = aaRowById(Number(_aiCurrentAlertId));
                                        if (!a) { host.style.display = 'none'; return; }

                                        // No analysis row means no AnalysisId, and the API keys on that. Nothing to attach
                                        // a rating to, so the panel stays away rather than offering a save that cannot work.
                                        if (!aaCanRate(a)) { host.style.display = 'none'; return; }

                                        var st = aaRatingOf(a) || {};
                                        AI_RVAL = Number(st.rating || 0);
                                        host.style.display = '';

                                        /* v1.0.1.0: EDITABLE. 1.0.1.8 stopped here for an already-rated analysis and showed
                                        a receipt instead of a form. The panel is now always a form: an existing rating
                                        pre-fills the stars and the remark, and the current value is stated above so the
                                        operator can see what they are about to replace. */
                                        var _aiHad = (AI_RVAL > 0);

                                        host.innerHTML =
                                        '<div class="arp-h"><b>' + (_aiHad ? 'Your rating' : 'Rate this analysis') + '</b><span id="aiRBy">'
                                        + escapeHtml((st && st.by) ? (st.by + (st.at ? (' \u00b7 ' + st.at) : '')) : '') + '</span></div>'
                                        + (_aiHad
                                        ? ('<div class="aa-rcur">Current: <b>' + AI_RVAL + ' / 5</b> \u00b7 '
                                        + escapeHtml(AA_RWORDS[AI_RVAL]) + '</div>')
                                        : '')
                                        + '<div class="aa-rstars" id="aiRStars"></div>'
                                        + '<div class="aa-rword" id="aiRWord" style="margin-bottom:0"></div>'
                                        + '<textarea id="aiRRem" maxlength="2000" placeholder="What did it get right or wrong?"></textarea>'
                                        + '<div class="arp-f"><span class="aa-rmsg" id="aiRMsg">'
                                        + (_aiHad ? 'Saving will replace the current rating.' : '') + '</span>'
                                        + '<button type="button" class="aa-rbtn pri" id="aiRSave" onclick="fnAiSaveRate()">'
                                        + (_aiHad ? 'Update' : 'Save') + '</button></div>';
                                        // Pre-fill the remark with what is already stored -- an edit that starts from an
                                        // empty box invites the operator to wipe a remark they meant to keep.
                                        var _aiTa = document.getElementById('aiRRem');
                                        if (_aiTa && st && st.remark) { _aiTa.value = String(st.remark); }
                                        fnAiPaintRate();
                                        }

                                        function fnAiPaintRate() {
                                        var host = document.getElementById('aiRStars');
                                        if (!host) { return; }
                                        var h = '';
                                        for (var i = 1; i <= 5; i++) {
                                        h += '<button type="button" aria-label="' + i + ' of 5" title="' + AA_RWORDS[i] + '"'
                                        + ' onclick="fnAiSetRate(' + i + ')">' + aaStar(i <= AI_RVAL) + '</button>';
                                        }
                                        host.innerHTML = h;
                                        var w = document.getElementById('aiRWord');
                                        if (w) { w.textContent = AI_RVAL > 0 ? (AI_RVAL + ' / 5 \u00b7 ' + AA_RWORDS[AI_RVAL]) : 'Pick a rating to enable Save.'; }
                                        var b = document.getElementById('aiRSave');
                                        if (b) { b.disabled = !(AI_RVAL > 0); }
                                        }

                                        function fnAiSetRate(n) {
                                        AI_RVAL = Number(n) || 0;
                                        var m = document.getElementById('aiRMsg');
                                        if (m) { m.className = 'aa-rmsg'; m.textContent = ''; }
                                        fnAiPaintRate();
                                        }

                                        function fnAiSaveRate() {
                                        var a = aaRowById(Number(_aiCurrentAlertId));
                                        if (!a || !(AI_RVAL > 0)) { return; }
                                        var btn = document.getElementById('aiRSave');
                                        var msg = document.getElementById('aiRMsg');
                                        var ta = document.getElementById('aiRRem');
                                        var remark = ta ? ta.value : '';
                                        var val = AI_RVAL;
                                        if (btn) { btn.disabled = true; btn.textContent = 'Saving...'; }
                                        if (msg) { msg.className = 'aa-rmsg'; msg.textContent = ''; }

                                        $.ajax({
                                        url: '@Url.Action("SaveAiRating", "UnifiedAlertAnalysis")',
                                        type: 'POST', contentType: 'application/json',
                                        data: JSON.stringify({
                                        id: a.id,
                                        source: (aaDecision(a).k === 'A') ? 'frs' : 'pending',
                                        rating: val,
                                        remark: remark,
                                        // v1.0.1.9: the run ON SCREEN, from the analysis_id SSE event. Rating from
                                        // inside the popup means rating this analysis, not whichever one the table
                                        // currently points at. 0 falls back to the lookup server-side.
                                        analysisId: Number(window._aiAnalysisId || 0)
                                        }),
                                        success: function (d) {
                                        if (!d || !d.ok) {
                                        // Same rule as the dialog: never report a save that did not happen.
                                        if (msg) { msg.className = 'aa-rmsg err'; msg.textContent = (d && d.error) ? d.error : 'Save failed.'; }
                                        if (btn) { btn.disabled = !!(d && d.notAnalysed); btn.textContent = 'Save'; }
                                        return;
                                        }
                                        var prev = AA_RATING[aaRatingKey(a)] || {};
                                        AA_RATING[aaRatingKey(a)] = {
                                        analysisId: Number(d.analysisId || prev.analysisId || 0),
                                        // v1.0.1.0: stamp the edit locally so the panel can say WHEN the latest
                                        // value was set without waiting for the next board reload.
                                        rating: d.rating, remark: d.remark || '', by: d.ratedBy || '',
                                        at: aaNowStamp(),
                                        revised: !!(d && d.revised),
                                        previousRating: Number((d && d.previousRating) || 0),
                                        previousRemark: (d && d.previousRemark) || ''
                                        };
                                        // v1.0.1.0: re-render the panel as a form again, now pre-filled with what
                                        // was just stored. Ratings are editable, so leaving it open is correct --
                                        // the operator may want to adjust the remark they just wrote.
                                        if (msg) {
                                        msg.className = 'aa-rmsg ok';
                                        msg.textContent = (d && d.revised) ? 'Updated.' : 'Saved.';
                                        }
                                        try { fnAiRenderRatePanel(); } catch (e) { }
                                        // Repaint the board behind the popup so the chip agrees before it is seen.
                                        try { fnAaRenderTable(); } catch (e) { }
                                        },
                                        error: function (xhr) {
                                        if (btn) { btn.disabled = false; btn.textContent = 'Save'; }
                                        if (msg) { msg.className = 'aa-rmsg err'; msg.textContent = 'Save failed (HTTP ' + (xhr ? xhr.status : 0) + ').'; }
                                        }
                                        });
                                        }

                                        /* ---- hover flyouts ---- */
                                        var AA_POP = null, AA_POPT = null;

                                        function aaPopDecHtml(a) {
                                        var d = aaDecision(a);
                                        var hasAudit = aaHasAudit(a);

                                        var h = '<div class="aa-pop-hd"><span class="' + d.cls + '">' + d.word + '</span>'
                                        + (a.decisionAt ? '<em>' + escapeHtml(a.decisionAt) + '</em>' : '') + '</div>';

                                        if (d.k === 'A') {
                                        // v1.0.2.7: two remark slots for approved alerts. This label said "Field
                                        // remark" while the table called the SAME field (a.approvalRemark) "Approved
                                        // Remark" -- one field, two names, both on screen. Now it is Approved remark
                                        // in both places.
                                        // Railway remark = what the office recorded, from AlertAudit via a.railwayRemark.
                                        var apprRem = String(a.approvalRemark || '');
                                        var railRem = String(a.railwayRemark || a.remark || a.maintRemark || '');
                                        h += '<div class="aa-pop-q">Approved remark</div>';
                                        h += apprRem
                                        ? '<div class="aa-pop-txt">' + escapeHtml(apprRem) + '</div>'
                                        : '<div class="aa-pop-txt none">No approved remark was recorded.</div>';
                                        if (railRem || hasAudit) {
                                        h += '<div class="aa-pop-q" style="margin-top:8px;">Railway remark</div>';
                                        h += railRem
                                        ? '<div class="aa-pop-txt">' + escapeHtml(railRem) + '</div>'
                                        : '<div class="aa-pop-txt none">No railway remark was recorded.</div>';
                                        }
                                        } else {
                                        var discardTxt = String(a.discardRemark || a.remark || '');
                                        h += '<div class="aa-pop-q">' + d.q + '</div>';
                                        h += discardTxt
                                        ? '<div class="aa-pop-txt">' + escapeHtml(discardTxt) + '</div>'
                                        : '<div class="aa-pop-txt none">No remark was recorded.</div>';
                                        }
                                        /* v1.0.0.4: DiscardWasValid. An alert discarded but judged GENUINE is worth
                                        seeing -- it is the closest thing to ground truth here, and it is the case
                                        where the discard itself deserves a second look. */
                                        var wasValid = aaValidFlag(a);
                                        if (d.k === 'D' && wasValid) {
                                        h += '<div class="aa-pop-vf ' + wasValid.cls + '">' + wasValid.label + '</div>';
                                        }
                                        if (a.decisionBy) {
                                        h += '<div class="aa-pop-by"><span>' + escapeHtml(a.decisionBy) + '</span>'
                                        + '<span>#' + a.id + '</span></div>';
                                        }
                                        return h;
                                        }
                                        function aaPopAiHtml(a) {
                                        var _st = aaRatingOf(a);
                                        var r = _st ? Number(_st.rating || 0) : Number(a.aiRating || 0);
                                        var h = '<div class="aa-pop-hd"><span class="ai">AI analysis</span><em>#' + a.id + '</em></div>';
                                        h += '<div class="aa-pop-stars">';
                                        for (var i = 1; i <= 5; i++) { h += aaStar(i <= r); }
                                        h += (r > 0) ? '<u>' + r + ' / 5</u>' : '<u>not rated</u>';
                                        h += '</div>';
                                        /* v1.0.0.4: the AI's own conclusion, above the human rating and visibly separate
                                        from it. The verdict is what the AI decided; the stars are what a person made
                                        of that decision. Collapsing the two would make the AI appear to rate itself. */
                                        if (a.aiVerdict) {
                                        h += '<div class="aa-pop-q">Verdict</div>'
                                        + '<div class="aa-pop-txt" style="margin-bottom:8px;font-weight:600;">'
                                        + escapeHtml(a.aiVerdict) + '</div>';
                                        }
                                        h += '<div class="aa-pop-q">Reviewer remark</div>';
                                        var _rem = _st ? String(_st.remark || '') : String(a.aiRemark || '');
                                        h += _rem
                                        ? '<div class="aa-pop-txt">' + escapeHtml(_rem) + '</div>'
                                        : '<div class="aa-pop-txt none">'
                                        + (r > 0 ? 'Rated without a remark.' : 'This analysis has not been rated. Click the chip to rate it.') + '</div>';
                                        if (_st && (_st.by || _st.at)) {
                                        h += '<div class="aa-pop-by"><span>' + escapeHtml(_st.by || '') + '</span>'
                                        + '<span>' + escapeHtml(_st.at || '') + '</span></div>';
                                        }
                                        return h;
                                        }
                                        function aaPopShow(el) {
                                        var kind = el.getAttribute('data-pop');
                                        // aaRowById compares with ===, and getAttribute returns a string.
                                        var a = aaRowById(Number(el.getAttribute('data-id')));
                                        if (!a) { return; }
                                        aaPopHide();
                                        var p = document.createElement('div');
                                        p.className = 'aa-pop';
                                        p.innerHTML = (kind === 'ai') ? aaPopAiHtml(a) : aaPopDecHtml(a);
                                        document.body.appendChild(p);
                                        AA_POP = p;

                                        var r = el.getBoundingClientRect(), w = p.offsetWidth, h = p.offsetHeight, gap = 10;
                                        /* the disc opens LEFT, the rating chip opens RIGHT -- each away from its own edge */
                                        var left = (kind === 'ai') ? (r.right + gap) : (r.left - w - gap);
                                        var top = r.top + (r.height / 2) - (h / 2);
                                        /* No room on the preferred side: drop BELOW the anchor rather than flipping across
                                        it. A flipped popover lands on top of the very card it is describing. */
                                        if (left < 8 || left + w > window.innerWidth - 8) {
                                        left = Math.min(Math.max(8, r.left), window.innerWidth - w - 8);
                                        top = r.bottom + gap;
                                        }
                                        if (top < 8) { top = 8; }
                                        if (top + h > window.innerHeight - 8) { top = Math.max(8, window.innerHeight - h - 8); }
                                        p.style.left = Math.round(left) + 'px';
                                        p.style.top = Math.round(top) + 'px';
                                        requestAnimationFrame(function () { if (AA_POP === p) { p.className = 'aa-pop in'; } });
                                        }
                                        function aaPopHide() {
                                        if (AA_POPT) { clearTimeout(AA_POPT); AA_POPT = null; }
                                        if (AA_POP && AA_POP.parentNode) { AA_POP.parentNode.removeChild(AA_POP); }
                                        AA_POP = null;
                                        }
                                        /* Delegated, so cards re-rendered by a filter change or a silent reload keep working
                                        with no rebinding. Focus mirrors hover: the remark is reachable from the keyboard.
                                        Scroll and resize hide it, because a position:fixed panel does not follow its anchor. */
                                        function aaPopBind() {
                                        document.addEventListener('mouseover', function (e) {
                                        var t = (e.target && e.target.closest) ? e.target.closest('[data-pop]') : null;
                                        if (!t) { return; }
                                        if (AA_POPT) { clearTimeout(AA_POPT); }
                                        AA_POPT = setTimeout(function () { aaPopShow(t); }, 110);
                                        });
                                        document.addEventListener('mouseout', function (e) {
                                        var t = (e.target && e.target.closest) ? e.target.closest('[data-pop]') : null;
                                        if (t) { aaPopHide(); }
                                        });
                                        document.addEventListener('focusin', function (e) {
                                        var t = (e.target && e.target.closest) ? e.target.closest('[data-pop]') : null;
                                        if (t) { aaPopShow(t); }
                                        });
                                        document.addEventListener('focusout', function (e) {
                                        var t = (e.target && e.target.closest) ? e.target.closest('[data-pop]') : null;
                                        if (t) { aaPopHide(); }
                                        });
                                        document.addEventListener('keydown', function (e) {
                                        if (e.key === 'Escape') { fnAaCloseDetail(); fnAaCloseRating(); aaPopHide(); }
                                        });
                                        window.addEventListener('scroll', aaPopHide, true);
                                        window.addEventListener('resize', aaPopHide);
                                        }
                                        aaPopBind();

                                        /* v1.0.1.0: the command bar earns its shadow only once it is actually stuck, so a
                                        board that fits on one screen has no floating panel over nothing. */
                                        (function aaStickyShadow() {
                                        var cmd = document.getElementById('aaCmd');
                                        if (!cmd || !window.IntersectionObserver) { return; }
                                        var probe = document.createElement('div');
                                        probe.style.cssText = 'height:1px;margin-bottom:-1px;';
                                        cmd.parentNode.insertBefore(probe, cmd);
                                        new IntersectionObserver(function (entries) {
                                        cmd.className = entries[0].isIntersecting ? 'aa-cmd' : 'aa-cmd stuck';
                                        }, { threshold: [1] }).observe(probe);
                                        })();

                                        /* ---- alert modal (compact card) ---- */

                                        /* v1.0.1.1: WHICH TABLE this alert lives in. An approved card's id is an FRSAlert id;
                                        a discarded card's id is a PendingAlertApproval id. They are unrelated sequences, so
                                        asking the wrong endpoint does not fail cleanly -- it can return a real alert that is
                                        not this one. Resolved in ONE place because there are two callers (the popup and the
                                        dry run) and they must never diverge. */
                                        function aaAlertEndpoint(id) {
                                        var row = aaRowById(Number(id));
                                        var pending = !(row && aaDecision(row).k === 'A');
                                        return {
                                        url: pending
                                        ? '@Url.Action("GetPendingAlertById", "PendingAlertAnalysis")'
                                        : '@Url.Action("GetFRSAlertById", "AlertLive")',
                                        // The pending service is a paged, date-windowed query with no by-id filter, so
                                        // it needs the alert's own time to bound the search. Harmless for the FRS side,
                                        // which ignores it.
                                        body: pending
                                        ? { id: Number(id), ts: (row && row.timeSort) ? row.timeSort : '' }
                                        : { id: Number(id) },
                                        pending: pending
                                        };
                                        }
                                        function aaPickCard(data) {
                                        if (!data) { return null; }
                                        return data.CloudAlertCardJson || data.LocalAlertCardJson || data.AlertCardJson || null;
                                        }

                                        /* A discarded alert has no rendered reset CARD. ResetRawJsonData is the raw reset
                                        payload -- Timestamp, ResetReason, Relays, Attributes -- so it is a fallback, not
                                        an equivalent: it gives the model the reset evidence, but it will not render as a
                                        rectification card, and r.resetTimestamp will be undefined on it. */
                                        function aaPickResetCard(data) {
                                        if (!data) { return null; }
                                        return data.ResetAlertCardJson || data.ResetRawJsonData || null;
                                        }
                                        function fnShowAlertMessage(id, autoAnalyze) {
                                        $('#loader, #e7-loader').show();
                                        var ep = aaAlertEndpoint(id);
                                        $.ajax({
                                        url: ep.url,
                                        type: 'POST',
                                        data: JSON.stringify(ep.body),
                                        contentType: 'application/json',
                                        success: function (data) {
                                        $('#loader, #e7-loader').hide();
                                        // v1.0.1.1: the pending endpoint answers NotFound rather than throwing, so
                                        // without this an out-of-window row would open an EMPTY popup that looks
                                        // like a rendering fault instead of a missing record.
                                        if (data && data.NotFound) {
                                        if (window.CommonNotification) {
                                        CommonNotification('ERROR', 'This alert is no longer in the pending table.', 'Not found');
                                        }
                                        return;
                                        }
                                        //var alertCardJson = (data && data.CloudAlertCardJson) ? data.CloudAlertCardJson : ((data && data.LocalAlertCardJson) ? data.LocalAlertCardJson : null);
                                        //var rectCardJson = (data && data.ResetAlertCardJson) ? data.ResetAlertCardJson : null;
                                        // v1.0.1.3: two sources, two field names. FRSAlert carries a Cloud/Local
                                        // pair; PendingAlertApproval carries a single AlertCardJson. Checked in that
                                        // order, so the FRS path is untouched and the pending one stops arriving
                                        // empty -- which is why a discarded alert was analysed with no thresholds
                                        // and no measured values at all.
                                        var alertCardJson = aaPickCard(data);
                                        var rectCardJson = aaPickResetCard(data);
                                        fnSetAiAlertContext(id, data, alertCardJson, rectCardJson);
                                        fnRenderAlertCard(id, data, alertCardJson);
                                        $('#aiVerdictView').hide();
                                        $('#aaCardView').show();
                                        $('#aaAlertModal').modal('show');
                                        if (autoAnalyze) { fnShowAiVerdictView(); }   // v1.0.39.0: show model picker + Analyze button, do not auto-run
                                        },
                                        error: function () {
                                        $('#loader, #e7-loader').hide();
                                        if (window.CommonNotification) { CommonNotification('ERROR', 'Failed to load alert.', 'Error'); }
                                        }
                                        });
                                        }

                                        function fnRenderAlertCard(id, data, alertCardJson) {
                                        var a = _cacParseJson(alertCardJson);
                                        var row = aaRowById(id);
                                        var code = a ? (a.alertCode || '') : ((data && data.CauseCode) ? data.CauseCode : (row ? row.code : ''));
                                        var asset = a ? (a.assetName || '') : (row ? row.asset : '');
                                        var station = a ? (a.station || '') : (row ? row.station : '');
                                        var time = a ? (a.time || '') : (row ? row.timeText : '');
                                        var typeStr = a ? (a.alertType || '') : (row ? row.type : '');
                                        var pred = (typeStr || '').toUpperCase().indexOf('PRED') === 0;
                                        var desc = '';
                                        if (a && a.description) { desc = a.description; }
                                        else if (data && data.SetAlertMessage) { desc = data.SetAlertMessage; }
                                        else if (data && data.Description) { desc = data.Description; }
                                        $('#aaCardCode').text(code);
                                        $('#aaCardMeta').text(asset + '  \u00b7  ' + station + '  \u00b7  ' + time);
                                        $('#aaCardBadge').text(pred ? 'PREDICTIVE' : 'FAILURE');
                                        $('#aaCardBadge').attr('class', 'aa-card-badge ' + (pred ? 'aa-b-pred' : 'aa-b-fail'));
                                        $('#aaCardBody').text(desc || 'No description available.');
                                        }

                                        /* ================= AI ALERT DIAGNOSTIC ================= */
                                        /* DEBUG: MCP tool dry-run button inside the AI verdict pop-up. v1.0.30.0: the client flag is
                                        now RENDERED server-side from the SAME Web.config appSetting that enables the endpoint
                                        (EnableDryRunTools), so a SINGLE switch controls both the button visibility AND the
                                        /AiChat/DryRunTools endpoint - no JS edit or page redeploy to toggle. It POSTs to the
                                        read-only endpoint (no verdict, no model, no writes) to check whether the AI's TOOLS are
                                        healthy for this alert's site/asset, isolating a tool-layer problem from a reasoning one.
                                        Keep EnableDryRunTools=false in production (the endpoint still has no [Authorize]). */
                                        var AA_DEBUG_TOOLS = @(System.Configuration.ConfigurationManager.AppSettings["EnableDryRunTools"] == "true" ? "true" : "false");
                                        var AA_DEBUG_CTRL_BASE = '';   // blank = same origin; set if the AiChat controller is elsewhere
                                        var _aiCurrentAlertId = null;
                                        var _currentAlertContext = null;
                                        var _aiVerdictCache = {};
                                        // v1.0.55.37: THINK toggle (QUANTUM engines only). Part of the cache key -- a THINK verdict
                                        // and a fast verdict are different answers and must not overwrite each other.
                                        var _aiThink = false;
                                        // keyed by alert AND provider: switching models must not return the
                                        // other model's cached verdict, which would silently ruin a comparison
                                        function aiCacheKey(id) { return String(id) + "|" + _aiProvider + (_aiThink ? "|think" : ""); }
                                        var _aiPrevDesign = null;
                                        var _aiInFlight = false;
                                        var _AI_REDUCE = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                                        // LIVE PROGRESS TRAIL.
                                        // The old fixed 4-row checklist showed the same plan for every alert, ticked
                                        // rows that were never called, listed a tool name that does not exist
                                        // (get_limited_history) and hid where the time actually went. This records
                                        // what really happened, in order, with elapsed time.
                                        var _aiTrail = [];        // {label, sub, t, ms, state}
                                        var _aiT0 = 0;

                                        // Operator-facing names. Raw tool names stay in the logs.
                                        var _AI_TOOL_LABEL = {
                                        search_sites: 'Locating station',
                                        search_assets: 'Locating asset',
                                        search_tags: 'Matching sensor names',
                                        get_asset_tags: 'Reading sensor list',
                                        get_timestamps: 'Checking data coverage',
                                        get_attribute_range: 'Loading safe limits',
                                        get_frs_alerts: 'Checking alert record',
                                        fetch_alert_details_frs: 'Checking alert record',
                                        history_get: 'Pulling value history',
                                        live_get: 'Reading live values',
                                        get_tag_current: 'Reading live value',
                                        analyse_alert: 'Running fault audit',
                                        get_hist_realtime: 'Reading telemetry at incidence',
                                        predict_track_health: 'Track leakage analysis',
                                        predict_pm_operation: 'Point machine operation analysis',
                                        predict_pm_cluster: 'Point machine waveform clustering'
                                        };

                                        // Rotating phrasing for the thinking steps, so a long wait still reads as
                                        // work in progress rather than a stall.
                                        var _AI_THINK = [
                                        'Correlating telemetry',
                                        'Weighing evidence against thresholds',
                                        'Testing sustained vs transient',
                                        'Cross-checking coupled attributes',
                                        'Assessing data coherence',
                                        'Re-checking against baseline',
                                        'Narrowing the fault window',
                                        'Consolidating findings'
                                        ];

                                        function aiTrailPush(label, sub, state) {
                                        _aiTrail.push({ label: label, sub: sub || '', t: Date.now(), ms: 0, state: state || 'run' });
                                        }
                                        function aiTrailDone(ms, sub) {
                                        for (var i = _aiTrail.length - 1; i >= 0; i--) {
                                        if (_aiTrail[i].state === 'run') {
                                        _aiTrail[i].state = 'done';
                                        _aiTrail[i].ms = ms || (Date.now() - _aiTrail[i].t);
                                        if (sub) { _aiTrail[i].sub = sub; }
                                        return;
                                        }
                                        }
                                        }

                                        // Called from _List fnShowAlertMessage after the alert record loads.
                                        // The alert record already carries the numeric ids -- the board could not have

                                        // rendered the row otherwise. Passing them removes the whole resolution chain:

                                        // the station is a CODE ("SK") which search_sites cannot match (it matches the

                                        // NAME, "SAKHUN"), and without a SiteId an asset-name search is ambiguous

                                        // because names repeat across stations. Observed: 5 failed "Locating asset"

                                        // calls in one run, then the analysis gave up.

                                        // Field names vary by source, so check the usual spellings on both the alert

                                        // record and the parsed card.

                                        function aiFindNum(src, names){

                                        if (!src) { return null; }

                                        for (var i = 0; i < names.length; i++) {

                                        var v = src[names[i]];

                                        if (v === undefined || v === null || v === '') { continue; }

                                        var n = Number(v);

                                        if (!isNaN(n) && n > 0) { return n; }

                                        }

                                        return null;

                                        }

                                        function aiAttachIds(ctx, data, card){

                                        var siteId  = aiFindNum(data, ['SiteId','SiteID','siteId','siteid'])

                                        || aiFindNum(card, ['siteId','SiteId','site_id']);

                                        var assetId = aiFindNum(data, ['AssetId','AssetID','assetId','assetid'])

                                        || aiFindNum(card, ['assetId','AssetId','asset_id']);

                                        if (siteId)  { ctx.siteId = siteId; }

                                        if (assetId) { ctx.assetId = assetId; }

                                        return ctx;

                                        }

                                        function fnSetAiAlertContext(id, data, alertCardJson, rectCardJson) {
                                        _aiCurrentAlertId = id;
                                        var a = _cacParseJson(alertCardJson);
                                        var r = _cacParseJson(rectCardJson);

                                        /* v1.0.1.2: ONE lookup, function scope. Previously `row` was declared with var
                                        inside the else branch below and then read after it, outside the branch. That
                                        works only because var hoists -- when a card JSON parsed, row was undefined and
                                        the later `row && row.resetText` short-circuited by luck rather than intent.
                                        It is needed in three places now, so it is resolved once, at the top. */
                                        var row = aaRowById(Number(id));

                                        var ctx = { alertId: id };
                                        if (a) {
                                        ctx.causeCode = a.alertCode || '';
                                        ctx.assetName = a.assetName || '';
                                        ctx.station = a.station || '';
                                        ctx.time = a.time || '';
                                        ctx.alertType = a.alertType || '';
                                        ctx.description = a.description || '';
                                        ctx.assetType = a.assetType || a.AssetType || '';   // v1.0.51.1: feed BuildAssetChecklist
                                        ctx.alertCard = a;
                                        } else {
                                        ctx.causeCode = (data && data.CauseCode) ? data.CauseCode : '';
                                        ctx.rawMessage = ((data && data.SetAlertMessage) ? data.SetAlertMessage : '') + ' ' + ((data && data.Description) ? data.Description : '');
                                        if (row) {
                                        ctx.station = row.station;
                                        ctx.assetName = row.asset;
                                        ctx.alertType = row.type;
                                        ctx.time = row.timeText;
                                        ctx.assetType = row.assetType || '';   // v1.0.51.1: Signal alerts w/o SIG cause still get the checklist
                                        }
                                        }
                                        if (r) { ctx.resetTime = r.resetTimestamp || ''; ctx.resetCard = r; }
                                        // v1.0.55.88: the reset card is OPTIONAL; the alert row always carries resetText. Without
                                        // this the panel announced "Still active" on an alert the same page showed as cleared.
                                        if (!ctx.resetTime && row && row.resetText) { ctx.resetTime = row.resetText; }

                                        aiAttachIds(ctx, data, a);

                                        /* v1.0.1.2: TELL AnalyzeAlert WHICH TABLE THIS ID BELONGS TO.
                                        The controller writes dbo.FRSAlert_AIAnalysis immediately after AuditStartAnalysis
                                        and picks the column from a discriminator on THIS context -- ctx.source ==
                                        "pending", ctx.isPending, or an explicit ctx.pendingAlertApprovalId. With none of
                                        them set it defaults to FRSAlertId.

                                        So a DISCARDED card, whose id is a PendingAlertApproval id, was linking its
                                        analysis to whatever FRSAlert happened to carry that number. Pending ids and
                                        FRSAlert ids are unrelated sequences and 3010 is a valid id in both, so this does
                                        not error -- it writes a row that looks correct and points at a different alert.
                                        Permanently, because FirstAnalysisId is write-once and every re-run of that alert
                                        updates the same wrong row.

