                                        h += '<div class="vd-vd"><span class="vd-badge ' + escapeHtml(String(vd.verdict || '').toLowerCase()) + '">' + escapeHtml(vd.verdict || '-') + '</span>';
                                        h += '<span class="vd-conf">' + escapeHtml(String(vd.confidence)) + '% confidence</span>';
                                        h += '<span class="vd-cat">' + escapeHtml(vd.category || '-') + '</span></div>';
