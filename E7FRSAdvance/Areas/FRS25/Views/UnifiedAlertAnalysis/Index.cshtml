                                        transform: none
                                        }
                                        }

                                        #aaBoard .aa-ev-head .e7ins {
                                        margin-left: 8px
                                        }

                                        /* v1.0.55.73: TIMELINE MODE. Chronological rail; a cluster bracket marks alerts that are one event. */
                                        #aaBoard .aa-viewtog {
