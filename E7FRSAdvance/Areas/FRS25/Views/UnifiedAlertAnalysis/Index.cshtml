                                        ctx.station = row.station;
                                        ctx.assetName = row.asset;
                                        ctx.alertType = row.type;
                                        ctx.time = row.timeText;
                                        }
                                        }
                                        if (r) { ctx.resetTime = r.resetTimestamp || ''; ctx.resetCard = r; }
                                        // v1.0.55.88: the reset card is OPTIONAL; the alert row always carries resetText. Without
                                        // this the panel announced "Still active" on an alert the same page showed as cleared.
                                        if (!ctx.resetTime && row && row.resetText) { ctx.resetTime = row.resetText; }
                                        aiAttachIds(ctx, data, a);
