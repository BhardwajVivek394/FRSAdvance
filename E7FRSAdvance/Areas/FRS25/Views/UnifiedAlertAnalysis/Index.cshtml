                                        /* v1.0.55.72: follow-up "working" indicator. The 7 is the ENERGY7 mark, not a spinner glyph --
                                        it pulses rather than spins, so it reads as a heartbeat instead of a loading throbber. */
                                        .e7work {
                                        display: flex;
                                        align-items: center;
                                        gap: 9px;
                                        padding: 9px 12px;
                                        margin: 6px 0 2px;
                                        border: 1px solid rgba(63,66,201,.18);
                                        background: rgba(63,66,201,.04);
                                        border-radius: 12px;
                                        max-width: 260px
                                        }

                                        .e7work-mark {
                                        display: inline-grid;
                                        place-items: center;
                                        width: 24px;
                                        height: 24px;
                                        border-radius: 7px;
                                        background: var(--aa-indigo,#3f42c9);
                                        color: #fff;
                                        font-weight: 800;
                                        font-size: 14px;
                                        line-height: 1;
                                        font-family: var(--aa-mono,ui-monospace,Menlo,monospace);
                                        animation: e7pulse 1.25s ease-in-out infinite
                                        }

                                        @@keyframes e7pulse {
                                        0%, 100% {
                                        transform: scale(1);
                                        box-shadow: 0 0 0 0 rgba(63,66,201,.42)
                                        }

                                        50% {
                                        transform: scale(1.07);
                                        box-shadow: 0 0 0 6px rgba(63,66,201,0)
