                                        for(var i=0;i<series.length;i++){ var p=series[i].pts; if(p[0][0]<t0)t0=p[0][0]; if(p[p.length-1][0]>t1)t1=p[p.length-1][0]; totalN+=p.length; }
                                        if(!(t1>t0)){ return renderAiTrendSvg(z, TR); }
                                        // train-free reference from the controller (preferred) else model viz
                                        // v1.0.55.1: on a deterministic masked frame (schema 2 / TR.mask) do NOT fall back to
                                        // the model's UNMASKED threshold/baseline -- omit the line instead. rvNumber keeps a
                                        // server null from becoming 0.
                                        var _maskFrame = !!(TR && (TR.schema===2 || TR.mask));
                                        var refVal = (TR.refValue!==undefined&&TR.refValue!==null)?rvNumber(TR.refValue):(_maskFrame?NaN:rvNumber(z.baseline));
                                        var refThr = (TR.refThreshold!==undefined&&TR.refThreshold!==null)?rvNumber(TR.refThreshold):(_maskFrame?NaN:rvNumber(z.threshold));
                                        var hasRefVal=!isNaN(refVal), hasRefThr=!isNaN(refThr);
                                        var trigUnit=''; for(var u=0;u<series.length;u++){ if(series[u].isTrigger){ trigUnit=series[u].unit; break; } }
                                        if(!trigUnit && series.length){ trigUnit=series[0].unit; }
                                        var cid='rvChart'+(++_rvChartSeq);
                                        // chips (all ON by default per user choice)
                                        var chips='<div class="rvz-chips" id="'+cid+'_chips">';
                                        for(var c=0;c<series.length;c++){
                                        var col=series[c].isTrigger?RV_PAL[0]:RV_PAL[(c%(RV_PAL.length-1))+1];
                                        series[c]._col=col;
                                        chips+='<button type="button" class="rvz-chip on" data-ci="'+c+'" data-cid="'+cid+'" style="--rc:'+col+'">'
                                        + '<span class="rvz-dot" style="background:'+col+'"></span>'+escapeHtml(series[c].attr)
                                        + (series[c].isTrigger?' <span class="rvz-trig">trigger</span>':'')+'</button>';
                                        }
                                        chips+='</div>';
