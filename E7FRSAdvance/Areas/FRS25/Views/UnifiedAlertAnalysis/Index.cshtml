                                        }

                                        /* v1.0.1.3: title case, matching Alert History's ToTitleCase. The service returns these
                                        upper-cased ("TEST - DIVISION"), which reads as shouting in a dense table and is wider
                                        than the same text in mixed case. Acronyms of three letters or fewer are LEFT ALONE --
                                        "NWR" is a zone code, and "Nwr" would be wrong rather than merely different. */
                                        function aaTitleCase(v) {
                                        var t = String(v || '').trim();
                                        if (!t.length) { return ''; }
                                        return t.replace(/[A-Za-z0-9]+/g, function (w) {
                                        if (w.length <= 3 && w === w.toUpperCase() && /[A-Z]/.test(w)) { return w; }
