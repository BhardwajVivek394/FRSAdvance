                                        }

                                        /* v1.0.55.76: DAY LANES. One row per day, 24 h wide; chips sit at their real time of day so a
                                        burst reads as a cluster. Chips are deliberately small -- position carries the meaning, detail
                                        opens below on click. */
                                        #aaBoard .aa-vflag {
                                        font-style: normal;
                                        font-family: var(--aa-mono);
                                        font-size: 8.5px;
                                        font-weight: 800;
                                        border-radius: 3px;
                                        padding: 0 3px;
                                        line-height: 1.5
                                        }
                                        /* detail opens under the lane -- the chip is too small for cause + remark + action */
                                        #aaBoard .aa-lane-det {
                                        margin-top: 9px;
                                        border: 1px solid var(--aa-hair);
                                        border-left: 3px solid var(--aa-hair);
                                        border-radius: 11px;
                                        padding: 10px 13px;
                                        background: #fff
                                        }

                                        #aaBoard .aa-lane-det.fail {
                                        border-left-color: var(--aa-red)
                                        }

