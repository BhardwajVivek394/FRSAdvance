                                        if(TR.refNote){ maskMsg=escapeHtml(String(TR.refNote)); }
                                        else if(TR.mask && TR.mask.status==='partial'){ maskMsg='Train mask partial \u2014 TPR does not cover the full telemetry window; reference lines are withheld where coverage is incomplete.'; }
                                        else if(TR.mask && TR.mask.status==='unavailable'){ maskMsg='Train mask unavailable \u2014 no digital TPR state series; reference lines are withheld.'; }
                                        // v1.0.55.5: derived line omitted stale-driver spans (freshness bound) -- say so.
                                        if(TR.synthGapped){ var _ga=(TR.synthGapMaxAgeSec||TR.synthMaxDriverAgeSec); var _ah = _ga ? (' (a component was '+(Math.round(_ga/360)/10)+'h stale)') : ''; maskMsg = (maskMsg? (maskMsg+' \u00b7 ') : '') + 'Derived line breaks where a component exceeded the freshness bound'+_ah+'.'; }
