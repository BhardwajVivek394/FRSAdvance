                                        align-items: center;
                                        gap: 8px
                                        }
                                        /* v1.0.55.19: STACKED STORY cards -- the verdict retold as short, plain cards. Card art is INLINE
                                        SVG (data URI) generated per cause: offline servers have no CDN and no image assets to deploy. */
                                        .rvs-sec {
                                        grid-column: 1 / -1;
                                        }
                                        /* v1.0.55.21: story spans the FULL row, not one column */
                                        /* v1.0.55.26: the deck floated on the same white as the rest of the verdict, so a card read as part
                                        of the page rather than one chapter of a distinct section. Give it its own recessed stage, and
                                        name the chapters instead of showing anonymous dots. */
                                        .rvs-stage {
                                        background: #f1f5f9;
                                        border: 1px solid #e2e8f0;
                                        border-radius: 14px;
                                        padding: 12px;
                                        }
                                        /* v1.0.55.27: MOVEMENT panel replaces the chart. The question is "how did the value move and, if it
                                        is derived, which input moved it" -- that is three numbers per row, not a plot. */
                                        .rvm-hero {
                                        background: #fff;
                                        border: 1px solid #e6e9ef;
                                        border-radius: 12px;
                                        padding: 14px 16px;
                                        margin-bottom: 10px;
                                        }

