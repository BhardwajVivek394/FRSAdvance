                                        opacity: 1
                                        }

                                        50% {
                                        opacity: .55
                                        }
                                        }

                                        @@media (prefers-reduced-motion: reduce) {
                                        #aaBoard .e7ins.busy .e7ins-m, #aaBoard .e7ins.busy .e7ins-t {
                                        animation: none
                                        }

