                                        if (AA_DEC === 'D') { return ['D']; }
                                        return ['A', 'R', 'D'];
                                        }

                                        function aaColCount() { return AA_FIXED_COLS + aaRemarkCols().length; }

                                        /* Rewrites the colgroup and the header to match. Called from fnAaRenderTable, so the
                                        head can never be a render behind the body. */
                                        function fnAaRenderTableHead() {
                                        var cg = document.getElementById('aaColgroup');
                                        var th = document.getElementById('aaThead');
                                        var cols = aaRemarkCols();

                                        if (cg) {
                                        var c = '<col class="aa-w-sr" /><col class="aa-w-loc" /><col class="aa-w-type" />'
                                        + '<col class="aa-w-atype" /><col class="aa-w-asset" /><col class="aa-w-when" />'
                                        + '<col class="aa-w-ai" /><col class="aa-w-cause" />';
                                        for (var i = 0; i < cols.length; i++) { c += '<col class="aa-w-rem" />'; }
                                        cg.innerHTML = c;
                                        }

                                        if (th) {
                                        var h = '<tr><th>SR</th>'
                                        + '<th>Station<span class="aa-th-sub">division &middot; zone</span></th>'
                                        + '<th class="aa-th-c">T</th><th>Asset Type</th><th>Asset</th>'
                                        + '<th class="aa-th-w">Incidence &middot; Duration &middot; Rectification'
                                        + '<span class="aa-th-sub">IST &middot; d-hh:mm:ss</span></th>'
                                        + '<th class="aa-th-c">AI<span class="aa-th-sub">rating &middot; valid</span></th>'
                                        + '<th>Cause of Asset Failure</th>';
                                        for (var j = 0; j < cols.length; j++) {
                                        h += '<th>' + AA_REM_HEAD[cols[j]] + '</th>';
                                        }
                                        th.innerHTML = h + '</tr>';
                                        }
                                        }

                                        // The remark cells for one row, in the same order the header just wrote.
                                        function aaRemarkCells(a) {
                                        var cols = aaRemarkCols(), h = '';
                                        for (var i = 0; i < cols.length; i++) {
                                        h += '<td class="aa-c-rem">' + aaRemarkCell(a, cols[i]) + '</td>';
                                        }
                                        return h;
                                        }

                                        var AA_REM_SRC = {
                                        A: { side: 'A', cls: 'a', get: function (a) { return String(a.approvalRemark || ''); } },
                                        R: { side: 'A', cls: 'r', get: function (a) { return String(a.railwayRemark || ''); } },
                                        D: { side: 'D', cls: 'd', get: function (a) { return String(a.discardRemark || a.remark || ''); } }
                                        };

                                        function aaRemarkCell(a, col) {
                                        var def = AA_REM_SRC[col];
                                        if (!def) { return '<span class="aa-rem-na">&ndash;</span>'; }
                                        // Wrong side of the decision -- an em dash, which reads as "does not apply", not
                                        // as "empty". The "no remark" wording below is reserved for the cells that DO
                                        // apply and simply have nothing in them; the two are different facts.
                                        if (aaDecision(a).k !== def.side) { return '<span class="aa-rem-na">&ndash;</span>'; }

                                        var txt = def.get(a).replace(/^\s+|\s+$/g, '');
                                        if (!txt.length) { return '<span class="aa-rem-na">no remark</span>'; }
                                        return '<span class="aa-rem-cell ' + def.cls + '" title="'
                                        + escapeHtml(txt) + '">' + escapeHtml(txt) + '</span>';
                                        }

                                        function aaDisc(a) {
                                        var d = aaDecision(a);
                                        return '<span class="aa-disc ' + d.cls + '" tabindex="0" role="button"'
                                        + ' aria-label="' + d.word + ' -- ' + d.q + '"'
                                        + ' data-pop="dec" data-id="' + a.id + '">' + d.k + '</span>';
                                        }

                                        /* ---- AI analysis rating. DISPLAY ONLY -- nothing writes it yet, deliberately.
                                        v1.0.55.101 removed the validity buttons because they posted to an endpoint that no
                                        longer existed: a control that cannot save is worse than no control, because the
                                        operator believes a judgement was recorded when it was not. ---- */
                                        function aaStar(filled) {
                                        var c = filled ? '#d99616' : '#dfe3ea';
                                        return '<svg viewBox="0 0 20 20" aria-hidden="true"><path fill="' + c
                                        + '" d="M10 1.6l2.5 5.2 5.7.8-4.1 4 1 5.7L10 14.6 4.9 17.3l1-5.7-4.1-4 5.7-.8z"/></svg>';
                                        }
                                        function aaRateChip(a) {
                                        // v1.0.1.5: the stored rating wins over anything the row projection carried.
                                        // a.aiRating was a by-name read off AlertAudit that never populated; kept only so
                                        // an older payload still renders.
