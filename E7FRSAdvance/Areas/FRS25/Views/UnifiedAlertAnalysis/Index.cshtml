                                    <script>
                                        /* ================= ALERT ANALYSIS TRIAGE BOARD ================= */
                                        var AA_ALERTS = [];
                                        var AA_INRANGE = [];
                                        // v1.0.0.0: everything in the date window, BEFORE the review-state filter. The state
                                        // chips count from this; AA_INRANGE is the same list after the state has been applied.
                                        var AA_WINDOW = [];
                                        // Resolved server-side in the Razor block at the top of this view.
                                        var AA_DEC = '@aaInitState';
                                        // v1.0.1.6: server-resolved, BOOLEAN ONLY. The override email list and the user's own
                                        // address must never reach JavaScript -- same rule as v1.0.55.63.
                                        var AA_PRIV = @(__aaPrivileged ? "true" : "false");
                                        // ?state=D from the retired pending route must not strand a non-privileged user on an
                                        // empty filter they cannot leave by any visible control.
                                        if (!AA_PRIV && AA_DEC === 'D') { AA_DEC = 'ALL'; }

                                        // v1.0.1.0
                                        var AA_SORT = 'priority';        // priority | newest
                                        var AA_RAIL_OPEN = false;
                                        var AA_REPEAT = {};              // "asset|cause" -> count within the window
                                        var AA_SITES = [];
                                        var AA_CAUSES = [];
                                        var AA_TOTF = 0;
                                        var AA_TOTP = 0;
                                        var aaState = { site: null, type: null, cause: null, assetClass: null, asset: null, assetType: null, match: null };
                                        var aaDate = { fromMs: null, toMs: null, days: 1 };   // v1.0.55.55: default 24h (was 7d)

                                        // ================= v1.0.55.109: LIVE ALERT EVENTS =================
                                        // Subscribes to the broadcaster's alert feed for every site currently on the board and
                                        // raises a toast the moment an alert fires, then silently refreshes the board so the new
                                        // alert appears in place. One socket per site, opened/closed by reconciliation against
                                        // AA_SITES -- filters change the board constantly, so aeSync() must be idempotent.
                                        // DELIBERATELY NOT AUTO-ANALYSING: a just-fired alert has not settled (no reset, telemetry
                                        // still arriving), and an automatic verdict on every event would both cost model calls per
                                        // alert and cache a verdict formed on incomplete evidence -- the .153 lesson. The toast
                                        // offers Analyze; the human decides.
                                        // The message SHAPE is not contractually known here, so the parser is tolerant: it accepts
                                        // a bare object, an array, or a {data|payload|alert|body} envelope, and finds each field by
                                        // trying the plausible names. An unparseable frame still refreshes the board and logs the
                                        // raw payload to the console (aeLog) so the real shape can be read off one live event.
                                        var AE_BASE = '@(System.Configuration.ConfigurationManager.AppSettings["AlertEventsWsBase"] ?? "wss://energy7.in:58081")';
                                        var AE_MAXSITES = 12;          // a board showing 40 sites must not open 40 sockets
                                        var AE_SOCKS = {};             // siteId -> { ws, tries, timer, closed }
                                        var AE_SEEN = {};              // dedupe key -> ts (the same event can arrive twice)
                                        var AE_RELOAD_T = null;

                                        function aeLog(msg, extra) {
                                        try { if (window.console && console.debug) { console.debug('[alertEvents] ' + msg, extra === undefined ? '' : extra); } } catch (e) { }
                                        }
                                        function aeDesiredSites() {
                                        var out = [];
                                        for (var i = 0; i < AA_SITES.length && out.length < AE_MAXSITES; i++) {
                                        var s = AA_SITES[i] ? AA_SITES[i].siteId : null;
                                        if (s === null || s === undefined || String(s) === '') { continue; }
                                        s = String(s);
                                        if (out.indexOf(s) < 0) { out.push(s); }
                                        }
                                        return out;
                                        }
                                        function aeSync() {
                                        if (!AE_BASE || typeof WebSocket === 'undefined') { return; }
                                        var want = aeDesiredSites();
                                        for (var i = 0; i < want.length; i++) {
                                        if (!AE_SOCKS[want[i]]) { aeConnect(want[i], { tries: 0 }); }
                                        }
                                        for (var k in AE_SOCKS) {
                                        if (!AE_SOCKS.hasOwnProperty(k)) { continue; }
                                        if (want.indexOf(k) < 0) { aeClose(k); }
                                        }
                                        }
                                        function aeConnect(siteId, seed) {
                                        var st = AE_SOCKS[siteId];
                                        if (!st) { st = { ws: null, tries: (seed && seed.tries) || 0, timer: null, closed: false }; AE_SOCKS[siteId] = st; }
                                        if (st.closed) { return; }
                                        var url = String(AE_BASE).replace(/\/+$/, '') + '/subscribe/alertEvents/' + encodeURIComponent(siteId);
                                        var ws;
                                        try { ws = new WebSocket(url); } catch (e) { aeRetry(siteId); return; }
                                        st.ws = ws;
                                        ws.onopen = function () { st.tries = 0; aeLog('subscribed site ' + siteId); };
                                        ws.onmessage = function (ev) { aeOnEvent(siteId, ev.data); };
                                        ws.onerror = function () { };
                                        ws.onclose = function () { st.ws = null; if (!st.closed) { aeRetry(siteId); } };
                                        }
                                        function aeRetry(siteId) {
                                        var st = AE_SOCKS[siteId];
                                        if (!st || st.closed) { return; }
                                        st.tries++;
                                        var wait = Math.min(30000, 3000 * st.tries);   // 3s, 6s, 9s ... capped at 30s
                                        if (st.timer) { clearTimeout(st.timer); }
                                        st.timer = setTimeout(function () { st.timer = null; aeConnect(siteId); }, wait);
                                        }
                                        function aeClose(siteId) {
                                        var st = AE_SOCKS[siteId];
                                        if (!st) { return; }
                                        st.closed = true;
                                        if (st.timer) { clearTimeout(st.timer); st.timer = null; }
                                        try { if (st.ws) { st.ws.close(); } } catch (e) { }
                                        delete AE_SOCKS[siteId];
                                        }
                                        function aeField(o, names) {
                                        for (var i = 0; i < names.length; i++) {
                                        var v = o[names[i]];
                                        if (v !== undefined && v !== null && String(v).length > 0) { return String(v); }
                                        }
                                        return '';
                                        }
                                        function aeUnwrap(o) {
                                        // {type:'alert', data:{...}} / {payload:{...}} / {alert:{...}} / {body:{...}}
                                        var keys = ['data', 'payload', 'alert', 'body', 'Alert', 'Data'];
                                        for (var i = 0; i < keys.length; i++) {
                                        var v = o[keys[i]];
                                        if (v && typeof v === 'object' && !(v instanceof Array)) { return v; }
                                        }
                                        return o;
                                        }
                                        function aeOnEvent(siteId, raw) {
                                        var parsed = null;
                                        try { parsed = JSON.parse(raw); } catch (e) { parsed = null; }
                                        if (!parsed || typeof parsed !== 'object') {
                                        aeLog('unparseable frame -- refreshing board anyway', raw);
                                        aeReloadSoon();
                                        return;
                                        }
                                        var list = (parsed instanceof Array) ? parsed : [parsed];
                                        for (var i = 0; i < list.length; i++) {
                                        if (!list[i] || typeof list[i] !== 'object') { continue; }
                                        aeShow(siteId, aeUnwrap(list[i]));
                                        }
                                        aeReloadSoon();
                                        }
                                        function aeShow(siteId, a) {
                                        var id = aeField(a, ['alertId', 'AlertId', 'Id', 'id', 'alert_id']);
                                        var asset = aeField(a, ['assetName', 'AssetName', 'asset', 'Asset', 'assetname']);
                                        var cause = aeField(a, ['causeCode', 'CauseCode', 'alertCode', 'AlertCode', 'cause', 'Cause', 'description', 'Description']);
                                        var site = aeField(a, ['stationName', 'StationName', 'siteName', 'SiteName', 'station', 'Station']);
                                        var type = aeField(a, ['alertType', 'AlertType', 'type', 'Type', 'category', 'Category']);
                                        if (!site) { site = aeSiteName(siteId); }
                                        var key = id ? ('id:' + id) : ('k:' + siteId + '|' + asset + '|' + cause);
                                        var nowMs = Date.now();
                                        for (var k in AE_SEEN) { if (AE_SEEN.hasOwnProperty(k) && nowMs - AE_SEEN[k] > 90000) { delete AE_SEEN[k]; } }
                                        if (AE_SEEN[key]) { return; }
                                        AE_SEEN[key] = nowMs;
                                        if (!id && !asset && !cause) { aeLog('event with no recognised fields -- shape check needed', a); }
                                        aeToast(id, site, asset, cause, type);
                                        }
                                        function aeSiteName(siteId) {
                                        for (var i = 0; i < AA_SITES.length; i++) {
                                        if (AA_SITES[i] && String(AA_SITES[i].siteId) === String(siteId)) { return AA_SITES[i].name || String(siteId); }
                                        }
                                        return String(siteId);
                                        }
                                        function aeReloadSoon() {
                                        if (AE_RELOAD_T) { clearTimeout(AE_RELOAD_T); }
                                        // A burst of events at one site must produce ONE reload, not one per event.
                                        AE_RELOAD_T = setTimeout(function () {
                                        AE_RELOAD_T = null;
                                        try { if (typeof fnLoadAlerts === 'function') { fnLoadAlerts(true); } } catch (e) { }
                                        }, 4000);
                                        }
                                        function aeToast(id, site, asset, cause, type) {
                                        var box = document.getElementById('aeToasts');
                                        if (!box) {
                                        box = document.createElement('div');
                                        box.id = 'aeToasts';
                                        document.body.appendChild(box);
                                        }
                                        var isFail = /fail/i.test(type || '') || /fail/i.test(cause || '');
                                        var el = document.createElement('div');
                                        el.className = 'ae-toast' + (isFail ? ' fail' : '');
                                        var canAnalyze = !!id;
                                        el.innerHTML = '<div class="ae-h"><span class="ae-dot"></span>Alert triggered'
                                        + (type ? (' &middot; ' + escapeHtml(type)) : '')
                                        + '<span class="ae-x" title="Dismiss">&times;</span></div>'
                                        + '<div class="ae-body"><span class="ae-asset">' + escapeHtml(asset || 'asset') + '</span>'
                                        + ' at ' + escapeHtml(site || 'site')
                                        + (cause ? ('<br><span class="ae-cause">' + escapeHtml(cause) + '</span>') : '') + '</div>'
                                        + '<div class="ae-acts">'
                                        + (canAnalyze ? '<button class="pri" data-ae-go="1">Analyze</button>' : '')
                                        + '<button data-ae-x="1">Dismiss</button></div>';
                                        var kill = function () { try { if (el.parentNode) { el.parentNode.removeChild(el); } } catch (e) { } };
                                        var x = el.querySelector('.ae-x'); if (x) { x.onclick = kill; }
                                        var dz = el.querySelector('[data-ae-x]'); if (dz) { dz.onclick = kill; }
                                        var go = el.querySelector('[data-ae-go]');
                                        if (go) { go.onclick = function () { kill(); aeAnalyze(id); }; }
                                        box.appendChild(el);
                                        // Long enough to notice from across a control room, short enough not to stack up.
                                        setTimeout(kill, 45000);
                                        while (box.children.length > 4) { box.removeChild(box.firstChild); }
                                        }
                                        function aeAnalyze(id) {
                                        var n = parseInt(id, 10);
                                        if (!n) { return; }
                                        var open = function () {
                                        try {
                                        if (typeof aaInsightGo === 'function') { aaInsightGo(n); return true; }
                                        if (typeof fnRowAnalyze === 'function') { fnRowAnalyze(n); return true; }
                                        } catch (e) { }
                                        return false;
                                        };
                                        var have = true;
                                        try { have = (typeof aaRowById !== 'function') || !!aaRowById(n); } catch (e) { have = true; }
                                        if (have) { open(); return; }
                                        // The event beat the board refresh: pull the list, then open.
                                        try { if (typeof fnLoadAlerts === 'function') { fnLoadAlerts(true); } } catch (e) { }
                                        setTimeout(open, 2500);
                                        }
                                        try {
                                        document.addEventListener('visibilitychange', function () {
                                        // A laptop resumed from sleep has dead sockets; reconcile on return.
                                        if (!document.hidden) { try { aeSync(); } catch (e) { } }
                                        });
                                        } catch (e) { }
                                        // ================= end live alert events =================
                                        var aaPieType = null;
                                        var AA_PIE_COLORS = ['#5457e6','#17976a','#e0961a','#dc2f4a','#7c3aed','#0ea5a4','#64748b','#c026d3'];
                                        var _aaRefreshPaused = false;
                                        var _aaRefreshPending = false;

                                        $(document).ready(function () {
                                        // v1.0.55.31: SITE-KEEPING ROLE GATE (merged from the other team's Index_21).
                                        // Null-safe on purpose: their Razor dereferences LoginUser directly, which throws if the
                                        // view renders without a session. A missing LoginUser is treated as NOT site-keeping, which
                                        // is also what their server-side SafeIsSiteKeeping() does.
                                        // NOTE: their file also hard-codes a test-user email override -- deliberately NOT copied.
                                        // v1.0.55.54: display name for the exported record, read in RAZOR (synchronous -- LoginUser
                                        // is available here; the controller cannot read it after its first await).
                                        var _aiUserName = '@(E7FRSAdvance.Utility.ClsHttpContent.LoginUser != null
                                        ? ((E7FRSAdvance.Utility.ClsHttpContent.LoginUser.FirstName ?? "") + " " +
                                        (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.LastName ?? "")).Trim()
                                        : "Operator")';
                                        if (!_aiUserName) { _aiUserName = 'Operator'; }
                                        window._aiUserName = _aiUserName;
                                        // v1.0.55.63: the override list and the user's email are NO LONGER emitted into JavaScript.
                                        // The match runs server-side in the Razor block at the top of this view; only the resolved
                                        // boolean reaches the browser.
                                        var AA_SITEKEEP = @(__aaPrivileged ? "true" : "false");
                                        // v1.0.55.55: publish on window AFTER the email override has run. The other team's gate fix
                                        // tests `window.AA_SITEKEEP === true`, but here AA_SITEKEEP is a plain `var` in this script
                                        // block -- window.AA_SITEKEEP would be undefined and the Debug button would never appear,
                                        // even for a site-keeping user. Set it here, after the override, so both the gate and the
                                        // re-show read the same resolved value.
                                        window.AA_SITEKEEP = (AA_SITEKEEP === true);
                                        if (!AA_SITEKEEP) { try { aaApplySiteKeepGate(); } catch (e) { } }
                                        // v1.0.53.0: trend chart chip toggles (delegated -- chips are injected with the verdict)
                                        $(document).on('click', '.rvz-chip[data-ci]', function () {
                                        var ci = parseInt($(this).attr('data-ci'), 10);
                                        var cid = $(this).attr('data-cid');
                                        var C = _rvCharts[cid]; if (!C) { return; }
                                        C._hidden = C._hidden || {};
