                                        color: #dc2626;
                                        }

                                        .rvm-v.ok {
                                        color: #059669;
                                        }

                                        .rvm-v.was {
                                        color: #94a3b8;
                                        font-size: 20px;
                                        }

                                        .rvm-arrow {
                                        font-size: 18px;
                                        color: #94a3b8;
                                        }

                                        .rvm-unit {
                                        font-size: 12px;
                                        color: #94a3b8;
                                        font-weight: 600;
                                        }

                                        .rvm-cap {
                                        font-size: 11px;
                                        color: #94a3b8;
                                        margin-top: 2px;
                                        }

                                        .rvm-thr {
                                        margin-top: 10px;
                                        padding-top: 10px;
                                        border-top: 1px dashed #e2e8f0;
                                        font-size: 13px;
                                        color: #334155;
                                        }

                                        .rvm-pill {
                                        display: inline-block;
                                        font-size: 11px;
                                        font-weight: 700;
                                        border-radius: 999px;
                                        padding: 2px 9px;
                                        margin-left: 6px;
                                        }

                                        .rvm-pill.bad {
                                        background: #fee2e2;
                                        color: #b91c1c;
                                        }

                                        .rvm-pill.ok {
                                        background: #dcfce7;
                                        color: #047857;
                                        }

                                        .rvm-row {
                                        display: flex;
                                        align-items: center;
                                        gap: 10px;
                                        padding: 8px 10px;
                                        border-radius: 9px;
                                        background: #fff;
                                        border: 1px solid #eef1f6;
                                        margin-bottom: 6px;
                                        }

                                        .rvm-row.main {
                                        border-color: #fbbf24;
                                        background: #fffbeb;
                                        }

                                        .rvm-nm {
                                        flex: 0 0 150px;
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: #334155;
                                        }

                                        .rvm-nums {
                                        flex: 1 1 auto;
                                        font-size: 12.5px;
                                        color: #475569;
                                        font-family: ui-monospace,monospace;
                                        }

                                        .rvm-chg {
                                        flex: 0 0 88px;
                                        text-align: right;
                                        font-size: 12.5px;
                                        font-weight: 700;
                                        font-family: ui-monospace,monospace;
                                        }

                                        .rvm-chg.up {
                                        color: #b91c1c;
                                        }

                                        .rvm-chg.dn {
                                        color: #1d4ed8;
                                        }

                                        .rvm-chg.flat {
                                        color: #94a3b8;
                                        }

                                        .rvm-tag {
                                        flex: 0 0 auto;
                                        font-size: 9.5px;
                                        font-weight: 700;
                                        text-transform: uppercase;
                                        letter-spacing: .04em;
                                        color: #b45309;
                                        background: #fef3c7;
                                        border: 1px solid #fde68a;
                                        border-radius: 5px;
                                        padding: 1px 6px;
                                        }

                                        .rvm-why {
                                        font-size: 12.5px;
                                        color: #475569;
                                        line-height: 1.55;
                                        margin-top: 8px;
                                        }

                                        .rvm-note {
                                        font-size: 11px;
                                        color: #94a3b8;
                                        margin-top: 8px;
                                        }
                                        /* v1.0.55.28: Speak now reads the STORY, and asks which language first. */
                                        /* v1.0.55.29: the trace was a floating box pinned beside the footer -- it overlapped the action
                                        row, wrapped its own header and squeezed 12 payloads into a narrow column. It is now a proper
                                        modal over the alert popup, which is what reading tool payloads actually needs. */
                                        .rvk-ov {
                                        position: fixed;
                                        inset: 0;
                                        background: rgba(15,23,42,.55);
                                        z-index: 2000;
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        padding: 24px;
                                        }

                                        .rvk-md {
                                        background: #fff;
                                        border-radius: 14px;
                                        width: 100%;
                                        max-width: 960px;
                                        max-height: 86vh;
                                        display: flex;
                                        flex-direction: column;
                                        overflow: hidden;
                                        box-shadow: 0 24px 64px rgba(15,23,42,.35);
                                        }

                                        .rvk-md-id {
                                        padding: 7px 16px;
                                        background: #0f172a;
                                        color: #cbd5e1;
                                        font-size: 11px;
                                        font-family: ui-monospace,monospace;
                                        letter-spacing: .02em;
                                        }

