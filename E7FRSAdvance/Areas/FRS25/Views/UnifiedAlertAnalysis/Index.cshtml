                                        if(TR.series && TR.series.length){ series=rvParseSeries(TR.series); }
                                        else { var one=rvParsePts(TR); if(one.length<5){ return ''; } series=[{attr:(TR.attr||z.metric||'value'),unit:(z.unit||''),isTrigger:true,isTpr:false,pts:one}]; }
