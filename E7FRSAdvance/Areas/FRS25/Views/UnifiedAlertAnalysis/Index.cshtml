                                        ctx.think = _aiThink;   // v1.0.55.37
                                        return ctx;
                                        }

                                        function fnVdPost(ctx){
                                        $.ajax({
                                        url: '@Url.Action("VerdictDryRun", "UnifiedAlertAnalysis")',
                                        type: 'POST', contentType: 'application/json',
                                        data: JSON.stringify(ctx), dataType: 'json'
                                        }).done(function (res) {
                                        fnVdRender(res, ctx);
                                        }).fail(function (xhr) {
                                        // Report what actually happened. A generic message here hides the
                                        // usual cause: the controller action is not deployed yet.
                                        var code = xhr ? xhr.status : 0;
                                        var srv = null;
                                        try { srv = JSON.parse(xhr.responseText); } catch (e) { srv = null; }
