                                        + '</div>';
                                        return head + '<div class="rvl-grid">' + body + '</div>';
                                        }

                                        // "15/08 11:44" -> minutes old. A snapshot is only as current as its stalest channel, so the
                                        // card has to be able to say which one that is.
                                        function aiAgeMinutes(at) {
                                        try {
                                        var m = String(at || '').match(/^(\d{2})\/(\d{2})\s+(\d{2}):(\d{2})$/);
                                        if (!m) { return null; }
                                        var now = new Date();
                                        var d = new Date(now.getFullYear(), +m[2] - 1, +m[1], +m[3], +m[4], 0);
                                        if (d > now) { d.setFullYear(now.getFullYear() - 1); }   // year rollover
                                        return Math.max(0, Math.round((now - d) / 60000));
                                        } catch (e) { return null; }
                                        }
                                        function aiAgeLabel(mins) {
                                        if (mins == null) { return ''; }
                                        if (mins < 60) { return mins + 'm old'; }
                                        if (mins < 1440) { return Math.round(mins / 60) + 'h old'; }
                                        return Math.round(mins / 1440) + 'd old';
                                        }

                                        // Re-fetch on demand. The snapshot is taken at ANALYSIS time; on an alert two days old that is
                                        // two days stale, and the reader has no way to tell without asking for it again.
                                        function aiRefreshLive(ev) {
                                        try { if (ev && ev.stopPropagation) { ev.stopPropagation(); } } catch (e) { }
                                        var host = document.getElementById('aiLiveBody');
                                        var btn = ev && ev.target ? ev.target.closest('.rvl-rf') : null;
                                        if (!host) { return; }
                                        if (btn) { btn.className = 'rvl-rf busy'; }
