                                        font-size: 12.5px;
                                        font-weight: 600
                                        }

                                        #aaBoard .aa-det-rem {
                                        margin-top: 7px;
                                        display: flex;
                                        align-items: flex-start;
                                        gap: 8px;
                                        flex-wrap: wrap
                                        }

                                        #aaBoard .aa-rem-flag {
                                        font-family: var(--aa-mono);
                                        font-size: 9.5px;
                                        font-weight: 800;
                                        letter-spacing: .06em;
                                        border-radius: 5px;
                                        padding: 2px 7px
                                        }

                                        #aaBoard .aa-rem-flag.true {
                                        background: rgba(15,157,99,.13);
                                        color: #0b7a4d
                                        }

                                        #aaBoard .aa-rem-flag.false {
                                        background: rgba(107,116,130,.14);
                                        color: #4b5563
                                        }

                                        #aaBoard .aa-rem-lbl {
                                        font-family: var(--aa-mono);
                                        font-size: 9.5px;
                                        letter-spacing: .06em;
                                        text-transform: uppercase;
                                        color: var(--aa-muted2)
                                        }

                                        #aaBoard .aa-rem-lbl.none {
                                        opacity: .7
                                        }

                                        #aaBoard .aa-rem-txt {
                                        font-size: 12.5px;
                                        color: var(--aa-ink)
                                        }

                                        #aaBoard .aa-det-foot {
                                        margin-top: 6px;
                                        font-size: 11px;
                                        color: var(--aa-muted)
                                        }

                                        /* v1.0.55.75: ENERGY7 INSIGHT action. Solid, not a ghost -- the previous chip sat at 28% opacity
                                        and read as a disabled control, which is why nobody pressed it. Gradient + inner highlight give it
                                        a raised, glossy feel without a drop shadow that would fight the flat table. */
                                        #aaBoard .e7ins {
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 6px;
                                        margin-left: 10px;
                                        padding: 5px 11px 5px 6px;
                                        border: 0;
                                        border-radius: 999px;
                                        cursor: pointer;
                                        font: inherit;
                                        font-size: 10.5px;
                                        font-weight: 800;
                                        letter-spacing: .08em;
                                        color: #fff;
                                        vertical-align: middle;
                                        background: linear-gradient(180deg,#5457e0 0%,#3f42c9 55%,#3538ad 100%);
                                        box-shadow: inset 0 1px 0 rgba(255,255,255,.34), 0 1px 2px rgba(20,24,31,.22);
                                        transition: transform .12s ease, box-shadow .15s ease, filter .15s ease
                                        }

                                        #aaBoard .e7ins:hover {
                                        filter: brightness(1.09);
                                        transform: translateY(-1px);
                                        box-shadow: inset 0 1px 0 rgba(255,255,255,.4), 0 3px 10px rgba(63,66,201,.42)
                                        }

                                        #aaBoard .e7ins:active {
                                        transform: translateY(0);
                                        filter: brightness(.96)
                                        }

                                        #aaBoard .e7ins-m {
                                        display: grid;
                                        place-items: center;
                                        width: 18px;
                                        height: 18px;
                                        border-radius: 50%;
                                        background: rgba(255,255,255,.20);
                                        font-family: var(--aa-mono);
                                        font-size: 11px;
                                        font-weight: 800;
                                        line-height: 1
                                        }

                                        #aaBoard .e7ins-t {
                                        padding-right: 1px
                                        }
                                        /* working: the mark spins, the pill breathes -- distinct from hover so a pressed button is obvious */
                                        #aaBoard .e7ins.busy {
                                        background: linear-gradient(180deg,#6b6ee8 0%,#5457e0 55%,#3f42c9 100%);
                                        cursor: default
                                        }

                                        #aaBoard .e7ins.busy .e7ins-m {
                                        animation: e7insSpin 1.1s linear infinite
                                        }

                                        #aaBoard .e7ins.busy .e7ins-t {
                                        animation: e7insPulse 1.3s ease-in-out infinite
                                        }

