                                        return '<div class="rv-res done"><div class="rv-res-ic"></div><div class="rv-res-tx">'
                                        + '<b>Already reset.</b> Condition cleared at <b class="rv-chip t">' + escapeHtml(reset) + '</b>' + durTxt
                                        + ' &#8212; this is a record of what happened, not a live fault.'
                                        + '</div></div>';
                                        }

                                        // Pull "HH:mm:ss" out of the alert-context time formats so the chart can be
                                        // anchored to real clock times instead of a bare "healthy -> now" axis.
                                        function aiClock(str){
                                        if (!str) { return ''; }
                                        var m = String(str).match(/(\d{1,2}:\d{2}:\d{2})/);
                                        return m ? m[1] : '';
                                        }

                                        // v1.0.52.0: real chart via Chart.js (local lib). Parses the same TR frame, draws a
                                        // proper time axis (date + time), threshold/healthy-avg reference lines, and ALERT/RESET
                                        // markers. Falls back to the inline-SVG renderer if Chart.js is not loaded on the server.
                                        function rvParsePts(TR){
                                        function rvTs(sv){
                                        if(sv===null||sv===undefined){ return NaN; }
                                        var str=String(sv);
                                        var t=Date.parse(str.replace(/(\d{2}):(\d{2}):(\d{2})\/(\d{2})\.(\d{2})\.(\d{4})/, '$6-$5-$4T$1:$2:$3'));
                                        if(isNaN(t)){ t=Date.parse(str); }
                                        if(isNaN(t)&&/^\d{12,}$/.test(str)){ t=Number(str); }
                                        return t;
                                        }
                                        var pts=[];
                                        for(var i=0;i<TR.points.length;i++){
                                        var t=rvTs(TR.points[i][0]); var vv=Number(TR.points[i][1]);
                                        if(!isNaN(t)&&!isNaN(vv)){ pts.push([t,vv]); }
                                        }
                                        pts.sort(function(a,b){return a[0]-b[0];});
                                        pts._ts=rvTs; return pts;
                                        }
                                        function rvFmtDT(t){
                                        var d=new Date(t); function z2(n){return (n<10?'0':'')+n;}
                                        var mon=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
                                        return z2(d.getDate())+' '+mon[d.getMonth()]+' '+z2(d.getHours())+':'+z2(d.getMinutes());
                                        }
                                        var _rvChartSeq=0, _rvCharts={};
                                        // v1.0.53.0: palette for multi-line series (trigger gets index 0 emphasis colour).
                                        var RV_PAL=['#4f7bf0','#22b07d','#f0a326','#e5544b','#8b5cf6','#0ea5e9'];
                                        // v1.0.55.1: STRICT numeric -- null/''/undefined -> NaN (never 0). Number(null)===0 would
                                        // otherwise paint a phantom 0 threshold/baseline line.
                                        function rvNumber(v){ if(v===null||v===undefined||v==='') return NaN; var n=Number(v); return isNaN(n)?NaN:n; }
                                        function rvParseSeries(sarr){
                                        // returns [{attr,unit,isTrigger,isTpr,pts:[[epochMs,v]..]}]
                                        var out=[];
                                        for(var i=0;i<sarr.length;i++){
                                        var so=sarr[i]; var raw=so.points||[]; var pp=[];
                                        for(var j=0;j<raw.length;j++){ var t=rvParsePts({points:[raw[j]]}); if(t.length){ pp.push(t[0]); } }
                                        // rvParsePts sorts single arrays fine; but do a direct parse for speed:
                                        pp=[];
                                        for(var k=0;k<raw.length;k++){
                                        var tt=(function(sv){ var str=String(sv);
                                        var x=Date.parse(str.replace(/(\d{2}):(\d{2}):(\d{2})\/(\d{2})\.(\d{2})\.(\d{4})/,'$6-$5-$4T$1:$2:$3'));
                                        if(isNaN(x)){ x=Date.parse(str); } if(isNaN(x)&&/^\d{12,}$/.test(str)){ x=Number(str); }
                                        if(isNaN(x)&&/^\d{9,11}$/.test(str)){ x=Number(str)*1000; } return x; })(raw[k][0]);
                                        var rv=raw[k][1];
                                        if(rv===null||rv===undefined){ if(!isNaN(tt)){ pp.push([tt,null]); } continue; }   // v1.0.55.7: preserve gap marker; Number(null) would fake a 0
                                        var vv=Number(rv);
                                        if(!isNaN(tt)&&!isNaN(vv)){ pp.push([tt,vv]); }
                                        }
                                        pp.sort(function(a,b){return a[0]-b[0];});
                                        if(pp.length>=3){ out.push({ attr:(so.attr||('series'+(i+1))), unit:(so.unit||''), isTrigger:!!so.isTrigger, isTpr:!!so.isTpr, isDerived:!!so.isDerived, reference:(so.reference||null), maskStatus:(so.maskStatus||null), pts:pp }); }
                                        }
                                        return out;
                                        }
                                        function renderAiTrendReal(z, TR){
                                        try{
                                        if(typeof window.Chart!=='function'){ return renderAiTrendSvg(z, TR); }   // offline fallback
