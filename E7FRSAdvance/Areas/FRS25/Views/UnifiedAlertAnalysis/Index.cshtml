                                        font-size: 9.5px;
                                        text-transform: uppercase;
                                        letter-spacing: .04em;
                                        color: #4338ca;
                                        background: #eef2ff;
                                        border: 1px solid #c7d2fe;
                                        border-radius: 4px;
                                        padding: 1px 5px;
                                        }

                                        .rvk-errline {
                                        grid-column: 2 / -1;
                                        color: #b91c1c;
                                        font-size: 11.5px;
                                        }

                                        .rvk-body {
                                        display: none;
                                        padding: 10px 14px 14px;
                                        background: #f8fafc;
                                        border-top: 1px dashed #e2e8f0;
                                        }

                                        .rvk-lbl {
                                        display: flex;
                                        justify-content: space-between;
                                        align-items: center;
                                        margin: 0 0 5px;
                                        color: #475569;
                                        font-size: 12px;
                                        }

                                        .rvk-pre {
                                        margin: 0 0 10px;
                                        white-space: pre-wrap;
                                        word-break: break-all;
                                        background: #fff;
                                        border: 1px solid #e2e8f0;
                                        border-radius: 6px;
                                        padding: 8px;
                                        color: #0f172a;
                                        font-family: ui-monospace,monospace;
                                        font-size: 11.5px;
                                        line-height: 1.5;
                                        max-height: 220px;
                                        overflow: auto;
                                        }

                                        @@media (max-width:640px) {
                                        .rvk-hd {
                                        grid-template-columns: 20px 1fr auto 56px;
                                        }

