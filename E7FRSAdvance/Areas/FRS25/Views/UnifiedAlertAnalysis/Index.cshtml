                                        merged.push(out);
                                        }
                                        if (!merged.length) { host.innerHTML = '<div class="rvl-none">No readings returned.</div>'; if (btn) { btn.className = 'rvl-rf'; } return; }
                                        _aiSnapshot = _aiSnapshot || {};
