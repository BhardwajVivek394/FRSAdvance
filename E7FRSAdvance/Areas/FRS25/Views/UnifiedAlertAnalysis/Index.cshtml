                                        + "<line x1='260' y1='142' x2='260' y2='184'/><line x1='350' y1='142' x2='350' y2='184'/></g>"
                                        + "<circle cx='330' cy='70' r='30' fill='#60a5fa' fill-opacity='.16'/>";
                                        }
                                        return "url(\"data:image/svg+xml;charset=utf-8," + encodeURIComponent(wrap(a)) + "\")";
                                        }
                                        // v1.0.55.19: STACKED STORY -- built entirely from verdict JSON already on the client
                                        // (headline, likely_cause, viz, evidence, recommended_action, caveats). No controller change.
                                        function renderAiStory(v, c){
                                        try{
                                        if(!v || !v.headline){ return ''; }
                                        var vk = String(v.verdict||'').toUpperCase();
                                        var tone = (vk==='NOT_CONFIRMED') ? 'ok' : ((vk==='INCONCLUSIVE') ? 'warn' : '');
                                        var who = [ (c&&c.assetName)||'', (c&&c.station)||'' ].filter(function(x){ return !!x; }).join(' \u00b7 ');
                                        var h = '<div class="rv-sec sec-story rvs-sec '+tone+'"><div class="rv-eyebrow">The story</div>'
                                        + '<div class="rvs-stage"><div class="rvs-chaps" id="rvsChaps"></div>'
                                        + '<div class="rvs-deck" id="rvsDeck"><div class="rvs-track" id="rvsTrack">';
                                        h += '<div class="rvs-card rvs-hero '+tone+'" data-lbl="What happened" style="background-image:'+rvStoryArt(c&&c.causeCode)+';">'
                                        + '<div class="rvs-eyebrow">What happened'+(who?(' \u00b7 '+escapeHtml(who)):'')+'</div>'
                                        + '<div class="rvs-h">'+escapeHtml(v.headline)+'</div>'
                                        + (v.likely_cause?('<div class="rvs-p">'+escapeHtml(v.likely_cause)+'</div>'):'') + '</div>';
                                        var z = v.viz||{};
                                        if(z.value!=null && !isNaN(Number(z.value))){
                                        var u = z.unit?(' '+escapeHtml(z.unit)):'';
                                        var pc = (z.pct_change!=null && !isNaN(Number(z.pct_change))) ? (Math.round(Number(z.pct_change)*10)/10) : null;
                                        h += '<div class="rvs-card rvs-c2 '+tone+'" data-lbl="The numbers"><div class="rvs-eyebrow">The numbers</div>'
                                        + '<div class="rvs-h">'+(pc!=null ? (Math.abs(pc)+'% '+(pc<0?'below':'above')+' the usual level') : escapeHtml(String(z.metric||'Measured value')))+'</div>'
                                        + '<div class="rvs-nums"><div><div class="rvs-num">'+escapeHtml(String(z.value))+'</div><div class="rvs-cap">'+escapeHtml(String(z.metric||'measured'))+u+'</div></div>'
                                        + ((z.threshold!=null&&!isNaN(Number(z.threshold)))?('<div><div class="rvs-num sub">'+escapeHtml(String(z.threshold))+'</div><div class="rvs-cap">threshold'+u+'</div></div>'):'')
                                        + ((z.baseline!=null&&!isNaN(Number(z.baseline)))?('<div><div class="rvs-num sub">'+escapeHtml(String(z.baseline))+'</div><div class="rvs-cap">normal'+u+'</div></div>'):'')
                                        + '</div>' + (z.phase_note?('<div class="rvs-p">'+escapeHtml(String(z.phase_note))+'</div>'):'') + '</div>';
                                        }
                                        var ev = v.evidence||[];
                                        if(ev.length){
                                        h += '<div class="rvs-card rvs-c3 '+tone+'" data-lbl="Why"><div class="rvs-eyebrow">Why we think so</div>'
                                        + '<div class="rvs-h">'+ev.length+' thing'+(ev.length>1?'s':'')+' line up</div>';
                                        for(var i=0;i<ev.length;i++){ h += '<div class="rvs-li">'+escapeHtml(String(ev[i]))+'</div>'; }
                                        h += '</div>';
                                        }
                                        if(v.recommended_action){
                                        var acts = String(v.recommended_action).split(';').map(function(x){ return x.trim(); }).filter(function(x){ return x.length>1; });
                                        h += '<div class="rvs-card rvs-c4 '+tone+'" data-lbl="What to do"><div class="rvs-eyebrow">What to do</div>'
                                        + '<div class="rvs-h">'+escapeHtml(acts.length?(acts[0].charAt(0).toUpperCase()+acts[0].slice(1)):'Recommended action')+'</div>';
                                        for(var k=(acts.length>1?1:0);k<acts.length;k++){ h += '<div class="rvs-li">'+escapeHtml(acts[k])+'</div>'; }
                                        h += '</div>';
                                        }
                                        var cf = (v.confidence!=null&&!isNaN(Number(v.confidence)))?Math.round(Number(v.confidence)):null;
                                        if(cf!=null || v.caveats){
                                        h += '<div class="rvs-card rvs-c5 '+tone+'" data-lbl="How sure"><div class="rvs-eyebrow">How sure</div>'
                                        + (cf!=null?('<div class="rvs-h">'+cf+'% confident</div>'):'<div class="rvs-h">Confidence</div>')
                                        + (v.caveats?('<div class="rvs-p">'+escapeHtml(String(v.caveats))+'</div>'):'') + '</div>';
                                        }
                                        // v1.0.55.99: ASSET HEALTH as a story chapter. This is where a reader looks for context
                                        // about the asset, rather than being met by it before the verdict.
                                        try {
                                        var acHtml = renderAssetCondition(false);
                                        if (acHtml) {
                                        h += '<div class="rvs-card rvs-health '+tone+'" data-lbl="Asset health">'
                                        + '<div class="rvs-eyebrow">Asset health</div>' + acHtml + '</div>';
                                        }
                                        } catch (e) { }

                                        // v1.0.55.103: ASSET HISTORY chapter -- the cause-code spread of THIS asset over the
                                        // controller's lookback window (AiChat .154 Layer A), drawn as a pie so the asset's
                                        // symptom mix in the past reads at a glance. Field record (FRS), not AI opinion;
                                        // absent when the controller flag is off or the fetch failed.
                                        try {
                                        var ah = v.asset_history;
                                        if (ah && ah.byCause && Number(ah.total) > 0) {
                                        h += '<div class="rvs-card rvs-ahist '+tone+'" data-lbl="Asset history">'
                                        + '<div class="rvs-eyebrow">Asset history &middot; '+Number(ah.windowDays||30)+'d</div>'
                                        + rvhPieHtml(ah) + '</div>';
                                        }
                                        } catch (e) { }

                                        // v1.0.55.89: Live data as its own chapter, refreshable in place.
                                        h += '<div class="rvs-card rvs-live '+tone+'" data-lbl="Live data">'
                                        + '<div class="rvs-eyebrow">Live data'
                                        + '<button type="button" class="rvl-rf" onclick="aiRefreshLive(event)" title="Fetch current values now">'
                                        + '<span class="rvl-rfi">&#8635;</span>Refresh</button></div>'
                                        + '<div id="aiLiveBody">' + aiLiveGrid() + '</div></div>';
                                        return h + '</div></div>'
                                        + '<div class="rvs-prog" id="rvsProg"><i id="rvsProgBar"></i></div>'
                                        + '<div class="rvs-nav"><button type="button" class="rvs-arw" id="rvsPrev" onclick="rvsGo(-1)" title="Previous card">&#8592;</button>'
                                        + '<div class="rvs-dots" id="rvsDots"></div>'
                                        + '<div style="display:flex;align-items:center;gap:8px;"><span class="rvs-step" id="rvsStep"></span>'
                                        + '<button type="button" class="rvs-arw" id="rvsNext" onclick="rvsGo(1)" title="Next card">&#8594;</button></div></div>'
                                        + '</div></div>';
                                        }catch(e){ return ''; }
                                        }
                                        // v1.0.55.27: MOVEMENT, not a plot. Owner: "just compute explanation -- last health value,
                                        // threshold violation and driver attribute movement; how the value moved at a glance, and if
                                        // derived, which value caused it." Everything here is computed from data already on the client:
                                        // the verdict's viz/derived_inputs plus the real trend frame when one arrived.
                                        // v1.0.55.27: formulas are written in ALIAS names (ITC FEED END) while inputs arrive as
                                        // attribute names (IF MA). From RDPMS_Attributes in the master cause-code workbook.
                                        var RVM_ALIAS = { 'IF MA':'ITC FEED END', 'IR MA':'ITC RELAY END', 'VF':'VTC FEED END',
                                        'VR':'VTC RELAY END', 'CHOKE V':'VTC CH FEED END', 'CHARGER MA':'ITC TFC O/P',
                                        'CHARGER OP V':'VTC TFC O/P', 'CHARGER V':'VTC TFC I/P', 'TPR V':'VTC 24 DC TPR I/P',
                                        'TPR V (LOC)':'VTC 24 DC LOC' };
                                        function rvmDivisor(formula){
                                        var f=String(formula||'').replace(/\s+/g,' ');
                                        var i=f.indexOf('/'); if(i<0){ return ''; }
                                        var tail=f.substring(i+1);
                                        var stop=tail.search(/,|\bwhere\b/i);
                                        return (stop>0? tail.substring(0,stop) : tail).toUpperCase();
                                        }
                                        function rvmIsDivisor(name, formula){
                                        var div=rvmDivisor(formula); if(!div){ return false; }
                                        var n=String(name||'').toUpperCase().trim(); if(!n){ return false; }
                                        if(div.indexOf(n)>=0){ return true; }
                                        var al=RVM_ALIAS[n]; return !!(al && div.indexOf(al)>=0);
                                        }
                                        // v1.0.55.30: name matching for the hero series, and a digital-series guard. A 0/1 state line
                                        // (TPR) has no baseline and no "worst value" -- treating it as the metric produced nonsense.
                                        function rvmNorm(x){ return String(x||'').toUpperCase().replace(/\(.*?\)/g,' ').replace(/[^A-Z0-9]+/g,' ').trim(); }
                                        function rvmDigital(sr){
                                        try{
                                        if(!sr || !sr.pts || !sr.pts.length){ return false; }
                                        var seen=0, n=0;
                                        for(var i=0;i<sr.pts.length && n<40;i++){
                                        var val=sr.pts[i][1]; if(val==null||isNaN(val)){ continue; }
                                        n++; if(val!==0 && val!==1){ return false; } seen++;
                                        }
                                        return seen>0;
                                        }catch(e){ return false; }
                                        }
                                        function rvmFmt(x){ if(x==null||isNaN(Number(x))){ return '-'; }
                                        var n=Number(x), a=Math.abs(n);
                                        return (a>=100? n.toFixed(0) : (a>=10? n.toFixed(1) : n.toFixed(3))).replace(/\.0+$/,''); }
                                        function rvmPct(from,to){ if(from==null||to==null||isNaN(from)||isNaN(to)||Math.abs(from)<1e-9){ return null; }
                                        return ((to-from)/Math.abs(from))*100; }
                                        // last sample at or before the incidence, and the last sample still on the SAFE side of the limit
                                        function rvmAtAndHealthy(pts, incMs, thr, rising){
                                        var at=null, healthy=null, healthyT=null, peak=null;
                                        for(var i=0;i<pts.length;i++){
                                        var t=pts[i][0], val=pts[i][1];
                                        if(val==null||isNaN(val)){ continue; }
                                        if(incMs==null || t<=incMs){
                                        at=val;
                                        if(thr==null || (rising? (val<thr) : (val>thr))){ healthy=val; healthyT=t; }
                                        }
                                        if(peak==null){ peak=val; } else { peak = rising ? Math.max(peak,val) : Math.min(peak,val); }
                                        }
                                        return { at:at, healthy:healthy, healthyT:healthyT, peak:peak };
                                        }
                                        function renderAiMovement(v, c){
                                        try{
                                        var z = v && v.viz; if(!z){ return ''; }
                                        // v1.0.55.58: for a DERIVED alert the hero headlines alert value-vs-limit (the limit line
                                        // below), NOT a was->now movement pill -- a window-relative move can be large and
                                        // misleading on marginal drift (e.g. 541980). Suppress the pill in the derived case.
                                        var isDerivedAlert = !!(v.derived_inputs && v.derived_inputs.inputs && v.derived_inputs.inputs.length);
                                        var unit = z.unit? (' '+escapeHtml(z.unit)) : '';
                                        var thr = (z.threshold!=null && !isNaN(Number(z.threshold))) ? Number(z.threshold) : null;
                                        var base = (z.baseline!=null && !isNaN(Number(z.baseline))) ? Number(z.baseline) : null;
                                        var val = (z.value!=null && !isNaN(Number(z.value))) ? Number(z.value) : null;
                                        var rising = String(z.direction||'').toLowerCase().indexOf('declin')<0 && String(z.direction||'').toLowerCase().indexOf('fall')<0;
                                        if(thr!=null && base!=null){ rising = (thr>=base); }
                                        // prefer REAL telemetry for the "was" value when a trend frame arrived
                                        var TR = window._aiLastTrend, hero=null, incMs=null;
                                        try{
                                        if(TR && TR.series && TR.series.length){
                                        var ss=rvParseSeries(TR.series);
                                        // v1.0.55.30 BUGFIX: this used to fall back to ss[0] when no derived/trigger
                                        // series was present. ss[0] is TPR -- a DIGITAL 0/1 state line -- so "was" came
                                        // out as 1 and the move read +736%. A series may only stand in for the metric
                                        // if its NAME matches, and a digital series can never be the hero.
                                        var wantNm = rvmNorm((z.metric||'') + ' ' + ((v.derived_inputs&&v.derived_inputs.param)||''));
                                        for(var i=0;i<ss.length;i++){
                                        if(rvmDigital(ss[i])){ continue; }
                                        var an=rvmNorm(ss[i].attr||'');
                                        if(an && wantNm && (wantNm.indexOf(an)>=0 || an.indexOf(wantNm)>=0)){ hero=ss[i]; break; }
                                        }
                                        if(!hero){
                                        for(var j=0;j<ss.length;j++){
                                        if(rvmDigital(ss[j])){ continue; }
                                        if(ss[j].isDerived||ss[j].isTrigger){ hero=ss[j]; break; }
                                        }
                                        }
                                        // no confident match -> use NO telemetry rather than the wrong series
                                        incMs = rvEvTs((c&&c.time)||'');
                                        if(isNaN(incMs)){ incMs=null; }
                                        }
                                        }catch(e){}
                                        var meas=null;
                                        if(hero && hero.pts && hero.pts.length){ meas = rvmAtAndHealthy(hero.pts, incMs, thr, rising); }

                                        var h = '<div class="rv-sec sec-moved rvm-sec" style="grid-column:1 / -1;"><div class="rv-eyebrow">How the value moved</div>';

                                        // v1.0.55.58: for a DERIVED alert the hero is ALERT VALUE vs LIMIT, using the AUTHORITATIVE
                                        // card value emitted as derived_inputs.value -- NOT a baseline/last-healthy movement and NOT
                                        // the model's z.value. The per-component movement is shown correctly in the input rows below,
                                        // so the resting-level flow (which can headline a misleading window-relative move) is not
                                        // rendered on the derived path. Non-derived alerts keep the was->now telemetry flow.
                                        if(isDerivedAlert){
                                        var diH = v.derived_inputs;
                                        // v1.0.55.60: FAIL CLOSED. Render the derived hero ONLY when the authoritative card
                                        // value, its own limit, and a breach direction are all present. NEVER fall back to the
                                        // model z.value/z.threshold/z.unit/direction -- those can belong to a different metric
                                        // (527969: viz=ITC RELAY END while the derived param is IBALST).
                                        var haveCardVal = !!(diH && diH.value!=null && !isNaN(Number(diH.value)));
                                        var haveLimit = !!(diH && diH.limit!=null && !isNaN(Number(diH.limit)));
                                        var haveDir = !!(diH && diH.breachAbove!=null);
                                        if(!(haveCardVal && haveLimit && haveDir)){
                                        // v1.0.55.71 SL6: only a CACHED verdict can be improved by re-running. On a fresh
                                        // run the card itself lacks the value/limit, so "re-run required" sent the user
                                        // to repeat what they had just done.
                                        var fromCache = !!(v && v.served_from_cache);
                                        h += '<div class="rvm-hero"><div class="rvm-cap">'
                                        + (fromCache
                                        ? 'Alert value/limit unavailable in this stored analysis - re-run to rebuild it.'
                                        : 'Alert card does not carry the value and limit for this parameter - re-running will not change this.')
                                        + '</div></div>';
                                        } else {
                                        var cardVal = Number(diH.value);
                                        var limD = Number(diH.limit);
                                        var limUnit = diH.limitUnit ? (' '+escapeHtml(String(diH.limitUnit))) : '';
                                        var upD = (diH.breachAbove!==false);
                                        var overD = upD ? (cardVal-limD) : (limD-cardVal);
                                        var overPctD = (Math.abs(limD)>1e-9) ? (overD/Math.abs(limD)*100) : null;
                                        h += '<div class="rvm-hero"><div class="rvm-flow">'
                                        + '<span class="rvm-v was">limit '+rvmFmt(limD)+'</span>'
                                        + '<span class="rvm-arrow">&#8594;</span>'
                                        + '<span class="rvm-v '+((overD>0)?'bad':'ok')+'">'+rvmFmt(cardVal)+'</span>'
                                        + '<span class="rvm-unit">'+escapeHtml(String(diH.param||'value'))+limUnit+'</span>'
                                        + ((overPctD!=null&&overD>0)? ('<span class="rvm-pill bad">'+overPctD.toFixed(1)+'% past limit</span>') : '')
                                        + '</div>'
                                        + '<div class="rvm-cap">alert value vs its limit</div>';
                                        h += '<div class="rvm-thr">'
                                        + (overD>0 ? ('breached by <b>'+rvmFmt(overD)+limUnit+'</b>')
                                        : ('<b>'+rvmFmt(Math.abs(overD))+limUnit+'</b> inside the limit'))
                                        + '</div>';
                                        h += '</div>';
                                        }
                                        } else {
                                        var wasVal = (meas && meas.healthy!=null) ? meas.healthy : base;
                                        var nowVal = (val!=null) ? val : (meas? meas.at : null);
                                        // never fall back to the model's pct_change: with no real was/now telemetry the limit
                                        // line (below) is the headline rather than an invented %.
                                        var movePct = rvmPct(wasVal, nowVal);
                                        h += '<div class="rvm-hero"><div class="rvm-flow">'
                                        + '<span class="rvm-v was">'+rvmFmt(wasVal)+'</span>'
                                        + '<span class="rvm-arrow">&#8594;</span>'
                                        + '<span class="rvm-v '+((thr!=null&&nowVal!=null&&(rising? nowVal>thr : nowVal<thr))?'bad':'ok')+'">'+rvmFmt(nowVal)+'</span>'
                                        + '<span class="rvm-unit">'+escapeHtml(String(z.metric||'value'))+unit+'</span>'
                                        + (movePct!=null? ('<span class="rvm-pill '+(Math.abs(movePct)<1?'ok':'bad')+'">'+(movePct>0?'+':'')+movePct.toFixed(1)+'%</span>') : '')
                                        + '</div>'
                                        + '<div class="rvm-cap">'
                                        + ((meas&&meas.healthy!=null&&meas.healthyT)? ('last healthy reading '+rvFmtDT(meas.healthyT)) : 'normal (resting) level')
                                        + ' &rarr; value at the alert</div>';
                                        if(thr!=null && nowVal!=null){
                                        var over = rising ? (nowVal-thr) : (thr-nowVal);
                                        var overPct = (Math.abs(thr)>1e-9)? (over/Math.abs(thr)*100) : null;
                                        h += '<div class="rvm-thr">Limit <b>'+rvmFmt(thr)+unit+'</b> &middot; '
                                        + (over>0 ? ('breached by <b>'+rvmFmt(over)+unit+'</b>'+(overPct!=null?(' ('+overPct.toFixed(1)+'% past the limit)'):''))
                                        : ('still <b>'+rvmFmt(Math.abs(over))+unit+'</b> inside the limit'))
                                        + (meas&&meas.peak!=null? (' &middot; worst in window <b>'+rvmFmt(meas.peak)+unit+'</b>') : '')
                                        + '</div>';
                                        }
                                        h += '</div>';
                                        }

                                        // ---- which input moved it (derived only) ----
                                        // v1.0.55.57: inputs now carry a PREVIOUS-IN-ENVELOPE comparison (referenceValue/deltaPct/
                                        // comparisonKind/currentOutsideEnvelope), not a window-statistic drift. Read those. Fail
                                        // CLOSED on a legacy/older-cache payload (inputs present but none of referenceValue/
                                        // deltaPct/reason) -- never reinterpret the old driftPct.
                                        var di = v.derived_inputs, ins = (di && di.inputs) ? di.inputs : null;
                                        if(ins && ins.length){
                                        var hasCompare=false;
                                        for(var c0=0;c0<ins.length;c0++){
                                        var i0=ins[c0];
                                        if(i0.referenceValue!=null || i0.deltaPct!=null || i0.reason!=null){ hasCompare=true; break; }
                                        }
                                        if(!hasCompare){
                                        h += '<div class="rvm-why">'
                                        + ((v && v.served_from_cache)
                                        ? 'Previous-comparison data unavailable from this stored analysis - re-run to rebuild it.'
                                        : 'Previous-comparison data unavailable for this run - no comparable earlier reading was found.')
                                        + '</div>';
                                        } else {
                                        var formula = String(di.formula||'');
                                        var worst=null;
                                        for(var k=0;k<ins.length;k++){
                                        var d=ins[k], dp=(d.deltaPct!=null&&!isNaN(Number(d.deltaPct)))?Number(d.deltaPct):null;
                                        if(dp==null){ continue; }
                                        if(d.largestDeviation){ worst=d; break; }
                                        if(worst==null || Math.abs(dp)>Math.abs(Number(worst.deltaPct))){ worst=d; }
                                        }
                                        for(var m=0;m<ins.length;m++){
                                        var it=ins[m];
                                        var p=(it.deltaPct!=null&&!isNaN(Number(it.deltaPct)))?Number(it.deltaPct):null;
                                        var cls = (p==null||Math.abs(p)<2)?'flat':(p>0?'up':'dn');
                                        var isMain = (worst && it.name===worst.name);
                                        var refTxt = (it.referenceValue!=null) ? rvmFmt(it.referenceValue)
                                        : (it.reason? escapeHtml(String(it.reason)) : '-');
                                        var outFlag = it.currentOutsideEnvelope? ' <span class="rvm-tag">outside limits</span>' : '';
                                        h += '<div class="rvm-row'+(isMain?' main':'')+'">'
                                        + '<span class="rvm-nm">'+escapeHtml(String(it.name||'input'))+outFlag+'</span>'
                                        + '<span class="rvm-nums">'+refTxt+' &#8594; '+rvmFmt(it.value)+'</span>'
                                        + '<span class="rvm-chg '+cls+'">'+(p==null?'-':((p>0?'+':'')+p.toFixed(1)+'%'))+'</span>'
                                        + (isMain? '<span class="rvm-tag">biggest move</span>':'')
                                        + '</div>';
                                        }
                                        if(worst){
                                        var nm=String(worst.name||''), wp=Number(worst.deltaPct);
                                        h += '<div class="rvm-why"><b>Biggest move:</b> '+escapeHtml(nm+' '+(wp>0?'up':'down')+' '
                                        + Math.abs(wp).toFixed(1)+'% since its last comparable reading.')+'</div>';
                                        }
                                        // The DIVISOR is what actually drives a derived value, and it is not always the
                                        // biggest mover -- so name it separately and compute how much it alone lifts the
                                        // result: value is proportional to 1/divisor, so a fall of p% multiplies by 1/(1-p).
                                        for(var q=0;q<ins.length;q++){
                                        var dv=ins[q];
                                        if(!rvmIsDivisor(dv.name, formula)){ continue; }
                                        var dp2=(dv.deltaPct!=null&&!isNaN(Number(dv.deltaPct)))?Number(dv.deltaPct):null;
                                        if(dp2==null || Math.abs(dp2)<1){ break; }
                                        var factor=(1/(1+dp2/100)-1)*100;
                                        h += '<div class="rvm-why"><b>Why the derived value moved:</b> '
                                        + escapeHtml(String(dv.name)+' is the DIVISOR in this formula. It '
                                        + (dp2<0?'fell':'rose')+' '+Math.abs(dp2).toFixed(1)+'%, which on its own '
                                        + (factor>0?'raises':'lowers')+' the computed value by about '
                                        + Math.abs(factor).toFixed(0)+'% - even with everything else unchanged.')
                                        + '</div>';
                                        break;
                                        }
                                        if(formula){ h += '<div class="rvm-note">'+escapeHtml(formula)+'</div>'; }
                                        }
                                        }
                                        // The model sometimes makes a DRIVER the hero metric and parks the breaching parameter
                                        // in viz.secondary. Never hide the thing that actually crossed its limit.
                                        try{
                                        var sc=z.secondary;
                                        if(sc && sc.value!=null && !isNaN(Number(sc.value))){
                                        var su=sc.unit?(' '+escapeHtml(sc.unit)):'';
                                        var st=(sc.x_threshold!=null&&!isNaN(Number(sc.x_threshold)))?Number(sc.x_threshold):null;
                                        var sOver=(st!=null)?(Number(sc.value)-st):null;
