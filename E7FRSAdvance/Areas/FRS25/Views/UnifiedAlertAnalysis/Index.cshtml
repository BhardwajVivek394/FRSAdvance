                                        if (res && res.rawBody) { h += '<div class="vd-sec"><div class="vd-eyebrow">Server response (first 400 chars)</div><pre class="vd-json">' + escapeHtml(String(res.rawBody)) + '</pre></div>'; }

                                        var vd = env && env.verdict ? env.verdict : null;
