                                        h += '<ul class="vd-ev">';
                                        for (var i = 0; i < vd.evidence.length; i++) { h += '<li>' + aiChipValues(escapeHtml(vd.evidence[i])) + '</li>'; }
                                        h += '</ul>';
                                        }
                                        h += '</div>';
                                        } else {
                                        h += '<div class="vd-sec"><div class="vd-none">No verdict returned &#8212; consumers must fail open and treat this alert as un-analysed.</div></div>';
                                        }

                                        var meta = env && env.meta ? env.meta : null;
                                        if (meta) {
                                        h += '<div class="vd-sec"><div class="vd-eyebrow">Meta</div><div class="vd-meta">';
                                        var keys = ['componentVersion','promptVersion','model','turns','modelMs','toolMs','discoveryMs','durationMs','toolCalls','toolSucceeded','requestId','evidenceArgs','diagnostics','error'];
                                        for (var m = 0; m < keys.length; m++) {
                                        if (typeof meta[keys[m]] === 'undefined' || meta[keys[m]] === null) { continue; }
                                        h += '<div class="vd-mrow"><span>' + escapeHtml(keys[m]) + '</span><code>' + escapeHtml(String(meta[keys[m]])) + '</code></div>';
                                        }
                                        h += '</div></div>';
                                        }

                                        h += '<div class="vd-sec"><div class="vd-eyebrow">Exact payload sent <button class="vd-copy" onclick="fnVdCopy(\'vdReq\')">copy</button></div>';
                                        h += '<pre class="vd-json" id="vdReq">' + escapeHtml(JSON.stringify(ctx, null, 2)) + '</pre></div>';
                                        h += '<div class="vd-sec" style="border-bottom:none"><div class="vd-eyebrow">Exact envelope returned <button class="vd-copy" onclick="fnVdCopy(\'vdRes\')">copy</button></div>';
                                        h += '<pre class="vd-json" id="vdRes">' + escapeHtml(JSON.stringify(env !== null ? env : res, null, 2)) + '</pre></div>';

                                        $('#vdBody').html(h);
                                        }

                                        function fnVdCopy(id){
                                        var el = document.getElementById(id);
                                        if (!el) { return; }
                                        var r = document.createRange(); r.selectNodeContents(el);
                                        var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(r);
                                        try { document.execCommand('copy'); } catch (e) { }
                                        sel.removeAllRanges();
                                        }

                                        // Wrap measured values in chips so the eye lands on numbers, not prose.
                                        // Operates on ALREADY-ESCAPED text, so it cannot introduce model markup.
                                        function aiChipValues(escaped){
                                        var out = escaped;
                                        out = out.replace(/\b(\d{1,2}:\d{2}(?::\d{2})?)\b/g, '<b class="rv-chip t">$1</b>');
                                        out = out.replace(/(~?-?\d+(?:\.\d+)?)\s?(&#937;|\u03a9|mA|mV|kV|ms|min|Hz|[AVsh%])(?![A-Za-z0-9])/g,
                                        '<b class="rv-chip v">$1&#8202;$2</b>');
                                        out = out.replace(/(\d+(?:\.\d+)?)\s?(x|\u00d7)(?![A-Za-z0-9])/g, '<b class="rv-chip v">$1$2</b>');
                                        return out;
                                        }

                                        function aiParseAlertTime(str){
                                        if (!str) { return null; }
                                        var t = String(str).trim(), m;
                                        m = t.match(/^(\d{1,2}):(\d{2}):(\d{2})\s*[\/ ]\s*(\d{1,2})\.(\d{1,2})\.(\d{4})$/);
                                        if (m) { return new Date(+m[6], +m[5]-1, +m[4], +m[1], +m[2], +m[3]); }
                                        m = t.match(/^(\d{1,2})\.(\d{1,2})\.(\d{4})\s*[\/ ]\s*(\d{1,2}):(\d{2}):(\d{2})$/);
                                        if (m) { return new Date(+m[3], +m[2]-1, +m[1], +m[4], +m[5], +m[6]); }
                                        m = t.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})\s+(\d{1,2}):(\d{2}):(\d{2})$/);
                                        if (m) { return new Date(+m[3], +m[2]-1, +m[1], +m[4], +m[5], +m[6]); }
                                        var d = new Date(t);
                                        return isNaN(d.getTime()) ? null : d;
                                        }

                                        function aiHumanDur(sec){
                                        sec = Math.max(0, Math.round(sec));
