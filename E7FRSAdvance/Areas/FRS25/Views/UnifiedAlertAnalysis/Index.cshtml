                                        // exercises a real payload. The card JSON lives under CloudAlertCardJson /
                                        // LocalAlertCardJson / ResetAlertCardJson -- the names I guessed before
                                        // (AlertConditionJson etc.) do not exist, which is why alertCard was always
                                        // absent and the model had no threshold to judge against.
                                        function fnVdBuildCtx(id, row, data){
                                        //var alertCardJson = (data && data.CloudAlertCardJson) ? data.CloudAlertCardJson
                                        //                  : ((data && data.LocalAlertCardJson) ? data.LocalAlertCardJson : null);
                                        //var rectCardJson = (data && data.ResetAlertCardJson) ? data.ResetAlertCardJson : null;
                                        // v1.0.1.3: same pick as the popup, via the same two helpers. These were separate
                                        // copies of one expression and drifted before -- the dry run once looked for field
                                        // names that did not exist, so alertCard never reached the model.
                                        var alertCardJson = aaPickCard(data);
                                        var rectCardJson = aaPickResetCard(data);


                                        var a = _cacParseJson(alertCardJson);
                                        var r = _cacParseJson(rectCardJson);

                                        var ctx = { alertId: id };
                                        if (a) {
                                        ctx.causeCode = a.alertCode || '';
                                        ctx.assetName = a.assetName || '';
                                        ctx.station = a.station || '';
                                        ctx.time = a.time || '';
                                        ctx.alertType = a.alertType || '';
                                        ctx.description = a.description || '';
                                        ctx.alertCard = a;                 // threshold + input snapshot
                                        } else {
                                        ctx.causeCode = (data && data.CauseCode) ? data.CauseCode : (row ? row.code : '');
                                        ctx.rawMessage = ((data && data.SetAlertMessage) ? data.SetAlertMessage : '')
                                        + ' ' + ((data && data.Description) ? data.Description : '');
