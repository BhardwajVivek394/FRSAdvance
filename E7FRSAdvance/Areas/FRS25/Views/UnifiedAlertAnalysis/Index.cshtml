                                        .rv-load-cap {
                                        margin-top: 18px;
                                        font-weight: 600;
                                        font-size: 10.5px;
                                        letter-spacing: .14em;
                                        text-transform: uppercase;
                                        color: #a3abb6;
                                        }

                                        .rv-error {
                                        margin: 20px;
                                        padding: 14px;
                                        background: #fdecef;
                                        border: 1px solid #f6ccd4;
                                        border-radius: 8px;
                                        color: #a3213a;
                                        font-size: 13px;
                                        }

                                        .rv-raw {
                                        margin: 18px;
                                        padding: 14px;
                                        background: #f6f8fa;
                                        border: 1px solid #e4e8ee;
                                        border-radius: 8px;
                                        white-space: pre-wrap;
                                        font: 500 12.5px/1.55 var(--mono);
                                        color: #39424f;
                                        }

                                        /* verdict */
                                        .rv {
                                        --accent: #6b7482;
                                        --soft: #eef1f5;
                                        /* v1.0.50.0: 3D card surface -- layered elevation instead of flat white board */
                                        background: linear-gradient(180deg, #ffffff 0%, #fafbfd 55%, #f3f6fa 100%);
                                        border: 1px solid #e6eaf1;
                                        border-radius: 16px;
                                        box-shadow: 0 1px 2px rgba(16,24,40,.05), 0 6px 16px rgba(16,24,40,.08), 0 18px 44px rgba(16,24,40,.10);
                                        position: relative;
                                        overflow: hidden;
                                        margin: 4px 2px 10px;
                                        }

                                        .rv::before {
                                        content: '';
                                        position: absolute;
                                        top: 0;
                                        left: 0;
                                        right: 0;
                                        height: 4px;
                                        background: linear-gradient(90deg, var(--accent), color-mix(in srgb, var(--accent) 35%, #ffffff));
                                        opacity: .9;
                                        }

                                        .rv[data-state="confirmed"] {
                                        --accent: #d1435b;
                                        --soft: #fdecef;
                                        }

                                        .rv[data-state="unconfirmed"] {
                                        --accent: #1f9d6b;
                                        --soft: #e7f6ef;
                                        }

                                        .rv[data-state="analyzing"] {
                                        --accent: #5457e6;
                                        --soft: #eef0fe;
                                        }

                                        .rv[data-state="inconclusive"] {
                                        --accent: #d99616;
                                        --soft: #fdf3e2;
                                        }

                                        .rv-band {
                                        background: #1b2027;
                                        color: #fff;
                                        display: flex;
                                        align-items: center;
                                        gap: 15px;
                                        padding: 16px 18px;
                                        }

                                        .rv-lamp {
                                        width: 14px;
                                        height: 14px;
                                        border-radius: 50%;
                                        flex: none;
                                        background: radial-gradient(circle at 34% 30%, rgba(255,255,255,.9), var(--accent) 62%);
                                        box-shadow: 0 0 0 3px rgba(255,255,255,.05), 0 0 13px 1px var(--accent);
                                        animation: airvlampon .5s ease-out;
                                        }

                                        @@keyframes airvlampon {
                                        from {
                                        box-shadow: 0 0 0 3px rgba(255,255,255,0), 0 0 0 0 var(--accent);
                                        }
                                        }

                                        .rv-band-main {
                                        flex: 1;
                                        min-width: 0;
                                        }

                                        .rv-verdict {
                                        font-weight: 800;
                                        font-size: 16px;
                                        letter-spacing: .05em;
                                        text-transform: uppercase;
                                        color: var(--accent);
                                        line-height: 1;
                                        }

                                        .rv-headline {
                                        margin-top: 6px;
                                        font-size: 13.5px;
                                        line-height: 1.45;
                                        color: #c9d1da;
                                        display: -webkit-box;
                                        -webkit-line-clamp: 2;
                                        -webkit-box-orient: vertical;
                                        overflow: hidden;
                                        }

                                        .rv-gauge {
                                        text-align: center;
                                        flex: none;
                                        }

                                        .rv-ring {
                                        position: relative;
                                        width: 64px;
                                        height: 64px;
                                        border-radius: 50%;
                                        margin: 0 auto;
                                        background: conic-gradient(var(--accent) calc(var(--p,0) * 1%), rgba(255,255,255,.13) 0);
                                        display: grid;
                                        place-items: center;
                                        }

                                        .rv-ring::after {
                                        content: '';
                                        position: absolute;
                                        inset: 6px;
                                        border-radius: 50%;
                                        background: #1b2027;
                                        }

                                        .rv-ring-num {
                                        position: relative;
                                        z-index: 1;
                                        font: 700 18px/1 var(--mono);
                                        color: #fff;
                                        }

                                        .rv-ring-num span {
                                        font-size: 10px;
                                        color: #9aa4b1;
                                        margin-left: 1px;
                                        }

                                        .rv-gauge-cap {
                                        margin-top: 6px;
                                        font-size: 9.5px;
                                        letter-spacing: .12em;
                                        text-transform: uppercase;
                                        color: #8a93a1;
                                        }

                                        .rv-id {
                                        display: flex;
                                        flex-wrap: wrap;
                                        gap: 4px 22px;
                                        padding: 13px 18px;
                                        background: #f6f8fa;
                                        border-bottom: 1px solid #e4e8ee;
                                        }

                                        .rv-id-k {
                                        font-size: 9.5px;
                                        letter-spacing: .12em;
                                        text-transform: uppercase;
                                        color: #6b7482;
                                        margin-bottom: 2px;
                                        }

                                        .rv-id-v {
                                        font: 500 13px/1.3 var(--mono);
                                        color: #161a20;
                                        }

                                        .rv-sec {
                                        padding: 15px 18px;
                                        border-bottom: 1px solid #e4e8ee;
                                        box-shadow: inset 0 1px 0 rgba(255,255,255,.85);
                                        --sec: #64748b; /* v1.0.55.42: per-section accent, defaults to slate */
                                        --secbg: rgba(100,116,139,.035);
                                        --secrail: #cbd5e1; /* explicit, not color-mix: that needs Chrome 111+ and an ops
                                        box may be older, where the rail would vanish entirely */
                                        background: var(--secbg);
                                        }
                                        /* v1.0.55.42: quiet per-section identity. The washes are 3-5% on white -- enough to tell the
                                        sections apart at a glance, not enough to compete with the verdict band or the status lamp. */
                                        .rv-sec.sec-story {
                                        --sec: #5b6b8c;
                                        --secbg: rgba(91,107,140,.035);
                                        --secrail: #c3cbdb;
                                        }

                                        .rv-sec.sec-moved {
                                        --sec: #0f766e;
                                        --secbg: rgba(15,118,110,.04);
                                        --secrail: #a8d5cf;
                                        }

                                        .rv-sec.sec-assess {
                                        --sec: #a3661a;
                                        --secbg: rgba(163,102,26,.045);
                                        --secrail: #e3c79a;
                                        }

                                        .rv-sec.sec-evid {
                                        --sec: #4c51bf;
                                        --secbg: rgba(76,81,191,.035);
                                        --secrail: #bcbee6;
                                        }

                                        .rv-sec.sec-hi {
                                        --sec: #7c3aed;
                                        --secbg: rgba(124,58,237,.035);
                                        --secrail: #cdb8f5;
                                        }
                                        /* v1.0.54.0: RECTANGULAR verdict -- at wide widths lay sections across a 2-col grid so the
                                        whole verdict is visible at a glance instead of a tall vertical strip. The chart and the
                                        derived-inputs sections span the full width; the text sections (Assessment / Evidence /
                                        Mukhya / Caveat) tile two-up. Narrow screens keep the single-column stack. */
                                        @@media (min-width: 900px) {
                                        .rv {
                                        display: grid;
                                        grid-template-columns: 1fr 1fr;
                                        align-items: start;
                                        }

                                        .rv > .rv-sec {
                                        border-bottom: none;
                                        border-right: 1px solid rgba(228,232,238,.7);
                                        border-top: 1px solid rgba(228,232,238,.7);
                                        }

                                        .rv > .rv-sec:nth-child(odd) {
                                        border-right: 1px solid rgba(228,232,238,.7);
                                        }

                                        .rv > .rv-sec:nth-child(even) {
                                        border-right: none;
                                        }
                                        /* full-width sections: the chart, the derived-inputs, and anything marked rv-span */
                                        .rv > .rvz-sec,
                                        .rv > .di-sec,
                                        .rv > .rv-span {
                                        grid-column: 1 / -1;
                                        border-right: none;
                                        }
                                        /* v1.0.55.3: the band (gauge), id row, Hinglish block, resolution/triage and the weather
                                        slot are NOT tiling text sections -- span them full width so they never leave a blank
                                        half-column (was: gauge in col 1, col 2 blank; Hindi block mis-oriented). */
                                        .rv > *:not(.rv-sec) {
                                        grid-column: 1 / -1;
                                        border-right: none;
                                        }
                                        /* first row shouldn't show a top hairline */
                                        .rv > .rv-sec:nth-child(1),
                                        .rv > .rv-sec:nth-child(2) {
                                        border-top: none;
                                        }
                                        /* the accent top edge (::before) must stay across the full grid width */
                                        .rv::before {
                                        grid-column: 1 / -1;
                                        }
                                        }

                                        .rv-sec:last-of-type {
                                        border-bottom: none;
                                        }

                                        .rv-eyebrow {
                                        display: flex;
                                        align-items: center;
                                        gap: 8px;
                                        font-weight: 700;
                                        font-size: 10px;
                                        letter-spacing: .14em;
                                        text-transform: uppercase;
                                        color: #6b7482;
                                        margin-bottom: 11px;
                                        }

                                        .rv-eyebrow::before {
                                        content: '';
                                        width: 14px;
                                        height: 2px;
                                        background: var(--sec, var(--accent));
                                        border-radius: 1px;
                                        }

                                        .rv-eyebrow {
                                        color: var(--sec, #6b7482);
                                        }

                                        .rv-eyebrow .rv-count {
                                        margin-left: auto;
                                        font-family: var(--mono);
                                        font-size: 11px;
                                        letter-spacing: 0;
                                        color: #9aa4b1;
                                        }

                                        .rv-fields {
                                        display: grid;
                                        grid-template-columns: 1fr;
                                        gap: 12px;
                                        }

                                        .rv-field {
                                        display: grid;
                                        grid-template-columns: 118px 1fr;
                                        gap: 14px;
                                        align-items: start;
                                        }

                                        .rv-fk {
                                        font-size: 10.5px;
                                        letter-spacing: .08em;
                                        text-transform: uppercase;
                                        color: #6b7482;
                                        padding-top: 1px;
                                        }

                                        .rv-fv {
                                        font-size: 13.5px;
                                        line-height: 1.5;
                                        color: #2b3440;
                                        }

                                        .rv-cat {
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 7px;
                                        }

                                        .rv-cat i {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 50%;
                                        background: var(--accent);
                                        }

                                        .rv-ev {
                                        list-style: none;
                                        margin: 0;
                                        padding: 0 0 0 2px;
                                        border-left: 2px solid var(--secrail, #cbd5e1);
                                        }

                                        .rv-ev li {
                                        position: relative;
                                        padding: 7px 0 7px 18px;
                                        font: 500 12.5px/1.55 var(--mono);
                                        color: #39424f;
                                        }

                                        .rv-ev li::before {
                                        content: '';
                                        position: absolute;
                                        left: -4px;
                                        top: 12px;
                                        width: 6px;
                                        height: 6px;
                                        background: var(--sec, var(--accent));
                                        border-radius: 1px;
                                        }

                                        /* v1.0.25.0: derived-value inputs table + cause-chain diagram + weather slot */
                                        .di-sec {
                                        }

                                        .di-note {
                                        font-size: 12px;
                                        color: #6b7482;
                                        line-height: 1.5;
                                        margin-bottom: 10px;
                                        }

                                        .di-note b {
                                        color: #c2410c;
                                        font-weight: 700;
                                        }

                                        .di-table {
                                        width: 100%;
                                        border-collapse: collapse;
                                        font-size: 12.5px;
                                        margin-bottom: 14px;
                                        }

                                        .di-table th {
                                        text-align: left;
                                        font-size: 10px;
                                        letter-spacing: .08em;
                                        text-transform: uppercase;
                                        color: #9aa4b1;
                                        font-weight: 700;
                                        padding: 4px 8px;
                                        border-bottom: 1px solid #e4e8ee;
                                        }

                                        .di-table td {
                                        padding: 6px 8px;
                                        border-bottom: 1px solid #f0f2f5;
                                        }
                                        /* v1.0.55.35: numeric column headers align with their right-aligned values */
                                        .di-table th:nth-child(n+2) {
                                        text-align: right;
                                        }

                                        .di-table .di-nm {
                                        color: #2b3440;
                                        font-weight: 600;
                                        }

                                        .di-table .di-num {
                                        text-align: right;
                                        font-variant-numeric: tabular-nums;
                                        color: #3a424e;
                                        }

                                        .di-table .di-base {
                                        color: #9aa4b1;
                                        }

                                        .di-table tr.di-drove {
                                        background: #fff7ed;
                                        }

                                        .di-tag {
                                        display: inline-block;
                                        font-size: 9px;
                                        font-weight: 700;
                                        letter-spacing: .06em;
                                        text-transform: uppercase;
                                        color: #fff;
                                        background: #c2410c;
                                        border-radius: 4px;
                                        padding: 1px 5px;
                                        vertical-align: middle;
                                        margin-left: 4px;
                                        }
                                        /* v1.0.28.0: null-reading + staleness + suspect-value styling in the derived panel */
                                        .di-table tr.di-nulled {
                                        background: #f6f8fa;
                                        }

                                        .di-table tr.di-nulled .di-nm {
                                        color: #6b7482;
                                        }

                                        .di-age {
                                        display: inline-block;
                                        font-size: 9px;
                                        color: #9aa4b1;
                                        margin-left: 5px;
                                        font-variant-numeric: tabular-nums;
                                        }

                                        .di-age-old {
                                        color: #b0730a;
                                        font-weight: 700;
                                        }

                                        .di-warn {
                                        margin: 8px 0 4px;
                                        padding: 7px 10px;
                                        background: #fdf6e9;
                                        border: 1px solid #f0e0bd;
                                        border-radius: 7px;
                                        font-size: 11.5px;
                                        color: #7a5a12;
                                        line-height: 1.45;
                                        }

                                        .di-warn b {
                                        color: #b0730a;
                                        font-weight: 700;
                                        }
                                        /* v1.0.27.0: cause-chain (.cc-*) CSS removed - the derived panel no longer draws a causal
                                        chain; it shows component inputs as an observation only. */
                                        .rv-weather {
                                        margin: 12px 18px 0;
                                        padding: 9px 12px;
                                        background: #f6f8fa;
                                        border: 1px solid #e4e8ee;
                                        border-radius: 7px;
                                        font-size: 12.5px;
                                        color: #3a424e;
                                        }

                                        .rv-weather-cap {
                                        font-size: 10px;
                                        letter-spacing: .08em;
                                        text-transform: uppercase;
                                        color: #9aa4b1;
                                        font-weight: 700;
                                        margin-right: 6px;
                                        }

                                        .rv-weather-na {
                                        color: #9aa4b1;
                                        }

                                        .rv-weather-sub {
                                        color: #b8c0cb;
                                        font-size: 11px;
                                        }
                                        /* v1.0.55.34: weather CARD - animated scene tile + big temp + condition tint (Option 2).
                                        Inline SVG + CSS keyframes only: nothing to download, nothing to 404 on plain http. */
                                        .rvwx-card {
                                        display: flex;
                                        align-items: center;
                                        gap: 12px;
                                        padding: 10px 14px;
                                        border-radius: 11px;
                                        }

                                        .rvwx-scene {
                                        flex: none;
                                        width: 48px;
                                        height: 48px;
                                        border-radius: 12px;
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        box-shadow: inset 0 0 0 1px rgba(0,0,0,.04);
                                        }

                                        .rvwx-body {
                                        min-width: 0;
                                        }

                                        .rvwx-card .rv-weather-cap {
                                        display: block;
                                        margin: 0 0 1px;
                                        }

                                        .rvwx-big {
                                        font-size: 21px;
                                        font-weight: 800;
                                        line-height: 1.15;
                                        color: #253041;
                                        letter-spacing: -.01em;
                                        }

                                        .rvwx-sub {
                                        font-size: 12px;
                                        color: #5b6572;
                                        margin-top: 1px;
                                        }
                                        /* v1.0.55.39: weather + train share one row; stack again when the panel is narrow. */
                                        .rv-ctxrow {
                                        display: flex;
                                        gap: 10px;
                                        align-items: stretch;
                                        margin-top: 8px;
                                        flex-wrap: wrap;
                                        }

                                        .rv-ctxrow > * {
                                        flex: 1 1 260px;
                                        min-width: 0;
                                        margin-top: 0 !important;
                                        }
                                        /* v1.0.55.39: the moving train. Decorative -- it carries no data. */
                                        .rvtr-anim {
                                        position: relative;
                                        height: 26px;
                                        margin-top: 6px;
                                        overflow: hidden;
                                        }

                                        .rvtr-rail {
                                        position: absolute;
                                        left: 0;
                                        right: 0;
                                        bottom: 5px;
                                        height: 2px;
                                        background: repeating-linear-gradient(90deg,#9fc7b4 0 7px,transparent 7px 14px);
                                        }

                                        .rvtr-loco {
                                        position: absolute;
                                        bottom: 6px;
                                        left: -70px;
                                        }

                                        @@media (prefers-reduced-motion: no-preference) {
                                        .rvtr-loco {
                                        animation: rvtrRun 7s linear infinite;
                                        }

                                        .rvtr-rail {
                                        animation: rvtrRail 1.4s linear infinite;
                                        }
                                        }

                                        @@keyframes rvtrRun {
                                        from {
                                        transform: translateX(0);
                                        }

                                        to {
                                        transform: translateX(390px);
                                        }
                                        }

                                        @@keyframes rvtrRail {
                                        from {
                                        background-position-x: 0;
                                        }

                                        to {
                                        background-position-x: -14px;
                                        }
                                        }
                                        /* v1.0.55.38: TRAIN card - same shape as the weather card so the pair reads as one row. */
                                        /* v1.0.55.41: the cards previously sat on a near-invisible hairline and merged into the panel.
                                        Stronger border + soft shadow + a top glass highlight so each reads as its own surface. */
                                        .rvtr-card {
                                        position: relative;
                                        overflow: hidden;
                                        display: flex;
                                        align-items: flex-start;
                                        gap: 12px;
                                        padding: 11px 14px;
                                        border-radius: 12px;
                                        background: linear-gradient(160deg,#f2faf5 0%,#ffffff 62%);
                                        border: 1px solid #b6dcc6;
                                        box-shadow: 0 1px 2px rgba(16,64,44,.07), 0 4px 12px rgba(16,64,44,.05);
                                        }

                                        .rvtr-card::before {
                                        content: "";
                                        position: absolute;
                                        inset: 0 0 auto 0;
                                        height: 42%;
                                        background: linear-gradient(180deg,rgba(255,255,255,.85),rgba(255,255,255,0));
                                        pointer-events: none;
                                        }

                                        .rvtr-card > * {
                                        position: relative;
                                        }

                                        .rvtr-body {
                                        flex: 1 1 auto;
                                        }

                                        .rvtr-scene {
                                        flex: none;
                                        width: 48px;
                                        height: 48px;
                                        border-radius: 12px;
                                        background: #d8efe2;
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        box-shadow: inset 0 0 0 1px rgba(0,0,0,.04);
                                        }

                                        .rvtr-body {
                                        min-width: 0;
                                        }

                                        .rvtr-big {
                                        font-size: 15px;
                                        font-weight: 800;
                                        line-height: 1.2;
                                        color: #253041;
                                        letter-spacing: -.01em;
                                        }

                                        .rvtr-sub {
                                        font-size: 12px;
                                        color: #5b6572;
                                        margin-top: 2px;
                                        }

                                        .rvtr-row {
                                        font-size: 12px;
                                        color: #41505f;
                                        margin-top: 3px;
                                        }

                                        .rvtr-row b {
                                        font-weight: 700;
                                        color: #253041;
                                        }

                                        .rvtr-note {
                                        font-size: 11px;
                                        color: #7b8794;
                                        margin-top: 5px;
                                        font-style: italic;
                                        }

                                        .rvtr-none {
                                        background: linear-gradient(135deg,#f4f6f8,#fbfcfd);
                                        border-color: #dde3ea;
                                        }

                                        .rvtr-none .rvtr-scene {
                                        background: #e9eef3;
                                        }

                                        .rvwx-sun {
                                        background: linear-gradient(135deg,#fff6e0,#fffdf6);
                                        border-color: #f1ddad;
                                        }

                                        .rvwx-sun .rvwx-scene {
                                        background: #ffedc2;
                                        }

                                        .rvwx-rain {
                                        background: linear-gradient(135deg,#eaf3ff,#f7fbff);
                                        border-color: #c9ddf6;
                                        }

                                        .rvwx-rain .rvwx-scene {
                                        background: #dbeafe;
                                        }

                                        .rvwx-cloud {
                                        background: linear-gradient(135deg,#f1f4f9,#fafbfd);
                                        border-color: #dbe2eb;
                                        }

                                        .rvwx-cloud .rvwx-scene {
                                        background: #e7edf4;
                                        }

                                        .rvwx-storm {
                                        background: linear-gradient(135deg,#e9edf4,#f5f7fb);
                                        border-color: #c8d2e0;
                                        }

                                        .rvwx-storm .rvwx-scene {
                                        background: #d9e1ec;
                                        }

                                        .rvwx-snow {
                                        background: linear-gradient(135deg,#eef8ff,#fbfeff);
                                        border-color: #d2ebf8;
                                        }

                                        .rvwx-snow .rvwx-scene {
                                        background: #e0f2fe;
                                        }

                                        .rvwx-fog {
                                        background: linear-gradient(135deg,#f3f4f5,#fbfbfc);
                                        border-color: #dfe2e5;
                                        }

                                        .rvwx-fog .rvwx-scene {
                                        background: #eceef0;
                                        }

                                        .rvwx-wind {
                                        background: linear-gradient(135deg,#ecf9f6,#f9fdfc);
                                        border-color: #cbe8e0;
                                        }

                                        .rvwx-wind .rvwx-scene {
                                        background: #d9f2ec;
                                        }

                                        .rvwx-def {
                                        background: linear-gradient(135deg,#f3f5f8,#fbfcfd);
                                        border-color: #dfe4ea;
                                        }

                                        .rvwx-def .rvwx-scene {
                                        background: #e9edf2;
                                        }

                                        @@keyframes rvwxSpin {
                                        to {
                                        transform: rotate(360deg);
                                        }
                                        }

                                        @@keyframes rvwxDrift {
                                        50% {
                                        transform: translateX(2.5px);
                                        }
                                        }

                                        @@keyframes rvwxDrop {
                                        0% {
                                        transform: translateY(-1px);
                                        opacity: 0;
                                        }

                                        25% {
                                        opacity: 1;
                                        }

                                        78% {
                                        opacity: 1;
                                        }

                                        100% {
                                        transform: translateY(5px);
                                        opacity: 0;
                                        }
                                        }

                                        @@keyframes rvwxFlake {
                                        0% {
                                        transform: translate(0,-1px);
                                        opacity: 0;
                                        }

                                        30% {
                                        opacity: 1;
