                                        font-weight: 600;
                                        color: #0f172a;
                                        }

                                        .rvk-tool {
                                        color: #64748b;
                                        font-family: ui-monospace,monospace;
                                        font-size: 11.5px;
                                        }

                                        .rvk-ms {
                                        color: #94a3b8;
                                        font-size: 11.5px;
                                        text-align: right;
                                        font-family: ui-monospace,monospace;
                                        }

                                        .rvk-sz {
                                        font-size: 11.5px;
                                        text-align: right;
                                        font-family: ui-monospace,monospace;
                                        }

