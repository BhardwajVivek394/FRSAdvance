                                        if (sec < 3600) { var m1 = Math.floor(sec/60), s1 = sec%60; return m1 + ' min' + (s1 ? (' ' + s1 + ' s') : ''); }
                                        var h1 = Math.floor(sec/3600), m2 = Math.round((sec%3600)/60);
