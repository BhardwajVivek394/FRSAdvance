                                        padding: 8px 14px;
                                        cursor: pointer;
                                        display: grid;
                                        align-items: center;
                                        gap: 10px;
                                        grid-template-columns: 22px minmax(150px,1.4fr) auto minmax(120px,1fr) 52px 66px;
                                        }

                                        .rvk-hd:hover {
                                        background: #f8fafc;
                                        }

