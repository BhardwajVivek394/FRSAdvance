                                        /* ==================================================================
                                        v1.0.0.0 -- UNIFIED BOARD: review state, cards, hover flyouts
                                        ================================================================== */

                                        /* Two states, not three. 'A' approved, 'D' discarded. An alert awaiting review IS
                                        discarded as far as this board is concerned, which is why the pending page folded
                                        in here rather than becoming a state of its own. */
                                        function aaDecision(a) {
                                        var k = String((a && a.decision) || 'D').toUpperCase();
                                        if (k === 'A') { return { k: 'A', cls: 'a', word: 'Approved', q: 'Railway remark' }; }
                                        return { k: 'D', cls: 'd', word: 'Discarded', q: 'Discard remark' };
                                        }
                                        /* v1.0.0.2: whether an AlertAudit row was found for this alert. It does NOT decide the
                                        state any more -- the source does -- so this only governs what the flyout says when
                                        there is no remark to show. "No remark was recorded" and "there is no audit record at
                                        all" are different facts, and only the second one is a data problem worth chasing. */
                                        function aaHasAudit(a) { return a && a.auditMatched === true; }

                                        /* v1.0.0.4: DiscardWasValid arrives as whatever the column serialises to -- true /
                                        false / 1 / 0 / "" -- so normalise here rather than trusting one shape. An empty
                                        value means nobody recorded a judgement, which is not the same as "not valid". */
                                        function aaValidFlag(a) {
                                        var v = String((a && a.discardWasValid) || '').trim().toLowerCase();
                                        if (v === 'true' || v === '1' || v === 'yes') {
                                        return { cls: 'yes', label: 'Field found the alert GENUINE' };
                                        }
                                        if (v === 'false' || v === '0' || v === 'no') {
                                        return { cls: 'no', label: 'Field found the alert not genuine' };
                                        }
                                        return null;
                                        }
                                        function aaDecFilter(list) {
                                        if (AA_DEC === 'ALL') { return list; }
                                        var out = [];
                                        for (var i = 0; i < list.length; i++) {
                                        if (aaDecision(list[i]).k === AA_DEC) { out.push(list[i]); }
                                        }
                                        return out;
                                        }
                                        /* Approved shows the railway remark, discarded shows the discard remark. They are
                                        different fields because they answer different questions: what the maintainer found
                                        in the field, versus why the alert was thrown away. */
                                        function aaDecisionRemark(a) {
                                        // v1.0.1.4: the discard side reads one field and stops, while the approved side falls
                                        // back through three -- an asymmetry with no reason behind it. The pending row's reason
                                        // has arrived under both DiscardRemark and Remark at different times, so try both.
                                        if (aaDecision(a).k === 'D') { return String(a.discardRemark || a.remark || ''); }
                                        return String(a.approvalRemark || '');
                                        }
                                        /* v1.0.1.0: one side of the decision, for the table's two remark columns.
                                        side 'A' = the office's approved remark, side 'D' = the field's discard reason.
                                        A row is one or the other, never both, so the column that does not apply renders a
                                        dash rather than borrowing the other's text. The full remark goes in the title so a
                                        clamped cell is still readable on hover without opening the flyout. */
                                        /* v1.0.1.0: a local stamp for a rating that was just saved. The board's own reload will
                                        replace it with the server's value; this only fills the gap so an edit does not read
                                        as undated until the next fetch. Same dd/MM/yyyy HH:mm:ss shape the rest of the board
                                        uses, so the two are not visibly different formats sitting next to each other. */
                                        function aaNowStamp() {
                                        var d = new Date();
                                        return aaPad(d.getDate()) + '/' + aaPad(d.getMonth() + 1) + '/' + d.getFullYear()
