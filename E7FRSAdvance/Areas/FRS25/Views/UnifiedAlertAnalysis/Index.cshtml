                                    <div id="vdModal" class="vd-modal" onclick="if(event.target===this)fnVdClose()">
                                        <div class="vd-card">
                                            <div class="vd-head-bar">
                                                <div><div class="vd-tag">SERVICE VERDICT &#183; DRY RUN</div><div class="vd-title" id="vdTitle"></div></div>
                                                <button class="vd-x" onclick="fnVdClose()">Close</button>
