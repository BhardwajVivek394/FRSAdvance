                                        });
                                        }

                                        /* Station on its own line, division and zone beneath it. The station is what an operator
                                        navigates by, so it carries the weight; the other two are context. */
                                        function aaLocCell(a) {
                                        var st = aaTitleCase(a.station);
                                        var dv = aaTitleCase(a.division);
                                        var zn = aaTitleCase(a.zone);
                                        var sub = [];
                                        if (dv) { sub.push(dv); }
                                        if (zn) { sub.push(zn); }
                                        return '<span class="aa-loc-s" title="' + escapeHtml(st || '') + '">'
                                        + escapeHtml(st || '-') + '</span>'
                                        + (sub.length
                                        ? '<span class="aa-loc-m" title="' + escapeHtml(sub.join(' \u00b7 ')) + '">'
                                        + escapeHtml(sub.join(' \u00b7 ')) + '</span>'
                                        : '');
                                        }

                                        /* Incidence, duration, rectification -- one cell, three lines, read top to bottom as the
                                        life of the alert. An OPEN alert has no rectification time and no meaningful duration,
                                        so it says so rather than showing a computed value against a time that never came. */
                                        function aaWhenCell(a, openAlert) {
                                        var h = '<span class="aa-w-i">' + escapeHtml(a.timeText || '-') + '</span>';
                                        if (openAlert) {
                                        return h + '<span class="aa-w-d open">&darr; still open</span>';
                                        }
                                        h += '<span class="aa-w-d">&darr; ' + escapeHtml(a.durationText || '-') + '</span>';
                                        h += '<span class="aa-w-r">' + escapeHtml(a.resetText || '-') + '</span>';
                                        return h;
                                        }

                                        /* v1.0.2.5: FOUR remark columns, and a row only ever fills the ones that apply to it.
                                        APPROVED  -> Approved, Railway, Field. Three different people wrote them and they
                                        answer three different questions; merging them was hiding two.
                                        DISCARDED -> Discard reason, and nothing else. A discarded alert has no approval
                                        and no railway remark, so those cells say so rather than borrowing.

                                        Each column reads ONE field. The pre-1.0.1.5 chain fell through
                                        railwayRemark/remark/maintRemark, so a blank approval remark silently rendered a
                                        DIFFERENT field's text with nothing on screen to say so. "no remark" is the honest
                                        answer when there isn't one, and it is kept here for all four. */
                                        /* ==================================================================
                                        v1.0.2.6 -- THE REMARK COLUMNS APPEAR AND DISAPPEAR WITH THE REVIEW STATE.

                                        1.0.2.5 showed all four remark columns always and put an em dash in the ones that
                                        did not apply. On an Approved-only board that is a permanently empty Discard column
                                        taking 124px, and on a Discarded-only board it is three of them taking 372px -- a
                                        third of the table's width spent on cells that CANNOT have content.

                                        So the columns themselves follow the Approved/Discarded filter:
                                        APPROVED  -> Approved, Railway, Field
                                        DISCARDED -> Discard
                                        ALL       -> all four, because both kinds of row are on screen and each still
                                        needs its own column. The em dash earns its place only here.

                                        ONE definition drives the colgroup, the header, the cells and the colspan. That is
                                        the whole point of this block: a table whose head says 12 columns and whose body
                                        writes 10 does not look like a filter bug, it looks like the board is broken, and
                                        it is the single easiest thing to get wrong when four places have to agree.
                                        ================================================================== */
                                        var AA_REM_HEAD = {
                                        A: 'Approved Remark',
                                        R: 'Railway Remark',
                                        D: 'Discard Remark'
                                        };

                                        // The fixed columns, which never vary: SR, Station, T, Asset Type, Asset, When, AI,
