                                        opacity: .35;
                                        animation: e7dot 1.05s ease-in-out infinite
                                        }

                                        .e7work-dots i:nth-child(2) {
                                        animation-delay: .15s
                                        }

                                        .e7work-dots i:nth-child(3) {
                                        animation-delay: .3s
                                        }

                                        @@keyframes e7dot {
                                        0%, 100% {
                                        opacity: .25;
                                        transform: translateY(0)
                                        }

                                        50% {
                                        opacity: 1;
                                        transform: translateY(-2px)
