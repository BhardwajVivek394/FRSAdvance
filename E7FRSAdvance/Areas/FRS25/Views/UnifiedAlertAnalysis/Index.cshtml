                                        padding: 11px 16px;
                                        background: #f1f5f9;
                                        border-bottom: 1px solid #e2e8f0;
                                        display: flex;
                                        align-items: center;
                                        justify-content: space-between;
                                        gap: 14px;
                                        font-weight: 600;
                                        color: #334155;
                                        font-size: 13px;
                                        flex: 0 0 auto;
                                        }

                                        .rvk-md-b {
                                        overflow: auto;
                                        -webkit-overflow-scrolling: touch;
                                        font-size: 12px;
                                        }

                                        .rvk-x {
                                        background: #fff;
                                        border: 1px solid #cbd5e1;
                                        border-radius: 7px;
                                        padding: 4px 12px;
                                        cursor: pointer;
                                        font-size: 12px;
                                        color: #334155;
                                        font-weight: 600;
                                        }

                                        .rvk-x:hover {
                                        background: #e2e8f0;
                                        }
                                        /* v1.0.55.30: trace rows on a grid so the columns line up, and failures are visible without
                                        expanding anything -- previously an errored call looked like any other row. */
                                        .rvk-row {
                                        border-top: 1px solid #e8edf3;
                                        }

                                        .rvk-row.err {
                                        background: #fff5f5;
                                        border-left: 3px solid #dc2626;
                                        }

                                        .rvk-row.warn {
                                        background: #fffbeb;
                                        border-left: 3px solid #d97706;
                                        }

                                        .rvk-warnline {
                                        grid-column: 2 / -1;
                                        color: #b45309;
                                        font-size: 11.5px;
                                        }

