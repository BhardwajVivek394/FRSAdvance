                                        if (!v) { aiShowRaw(text); return; }
                                        // toggling mid-run must not file this verdict under the other model
                                        _aiVerdictCache[String(id) + '|' + (runProv || _aiProvider)] = v;
                                        _aiVerdictProvider = runProv || _aiProvider;
                                        renderAiVerdict(v);
                                        }
                                        function extractJson(text) {
                                        if (!text) { return null; }
                                        var t = text.replace(/```json/gi, '').replace(/```/g, '').trim();
                                        var s = t.indexOf('{'); var e = t.lastIndexOf('}');
                                        if (s < 0 || e < 0 || e <= s) { return null; }
