                                        }
                                        var head = '<div class="rv-snap">Current values read ' + escapeHtml(s.retrievedAt) + age + '</div>';
                                        // v1.0.55.78: the caption used to stand alone. A reader was told WHEN something was read and
                                        // never shown WHAT -- which is worse than omitting the line.
                                        var vals = s.values || [];
                                        if (!vals.length) { return '<div class="rv-snapblk">' + head + '</div>'; }
                                        var body = '', oldest = 0;
                                        for (var i = 0; i < vals.length; i++) {
                                        var r = vals[i], st = String(r.state || '').toLowerCase();
                                        var cls = (st === 'low' || st === 'high') ? ' out' : '';
