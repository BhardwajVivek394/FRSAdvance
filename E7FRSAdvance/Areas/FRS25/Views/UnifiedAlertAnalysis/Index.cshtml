                                        which cannot work from inside a position:fixed overlay -- three identical pages. The export
                                        now builds its own document and carries its own print rules, so keeping this would leave
                                        two competing definitions of how the page prints. */

                                        /* ================= v1.0.0.0 UNIFIED BOARD ================================
                                        Review-state bar, alert cards, decision disc, AI-rating chip, hover flyouts.
                                        Additive: nothing above is overridden, so Table and Timeline are unchanged.
                                        ========================================================================= */
                                        #aaBoard .aa-decbar {
                                        display: flex;
                                        align-items: center;
                                        gap: 8px;
                                        flex-wrap: wrap;
                                        margin: 16px 2px 0
                                        }

                                        #aaBoard .aa-dec-cap {
                                        font: 600 10px/1 var(--aa-mono);
                                        letter-spacing: .12em;
                                        text-transform: uppercase;
                                        color: var(--aa-muted);
                                        margin-right: 2px
                                        }

                                        #aaBoard .aa-decbar-inline {
                                        display: inline-flex;
                                        align-items: center;
                                        padding: 3px;
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 10px;
                                        background: #fff;
                                        box-shadow: 0 1px 2px rgba(20,24,31,.04);
                                        flex: none;
                                        }

                                        #aaBoard .aa-decseg {
                                        border: 0;
                                        background: transparent;
                                        border-radius: 7px;
                                        color: var(--aa-muted);
                                        font: inherit;
                                        font-size: 12px;
                                        font-weight: 650;
                                        padding: 6px 11px;
                                        cursor: pointer;
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 7px;
                                        white-space: nowrap;
                                        transition: color .13s,background .13s,box-shadow .13s;
                                        }

                                        #aaBoard .aa-decseg:hover {
                                        color: var(--aa-ink);
                                        background: var(--aa-hair2);
                                        }

                                        #aaBoard .aa-decseg:focus-visible {
                                        outline: 2px solid var(--aa-indigo,#3f42c9);
                                        outline-offset: -1px;
                                        }

                                        #aaBoard .aa-decseg b {
                                        font: 700 10.5px/1 var(--aa-mono);
                                        background: var(--aa-hair2);
                                        color: var(--aa-muted);
                                        border-radius: 20px;
                                        padding: 3px 7px;
                                        }

                                        #aaBoard .aa-decseg.on {
                                        background: var(--aa-ink);
                                        color: #fff;
                                        box-shadow: 0 1px 2px rgba(20,24,31,.14);
                                        }

                                        #aaBoard .aa-decseg.on b {
                                        background: rgba(255,255,255,.16);
                                        color: #fff;
                                        }

                                        #aaBoard .aa-decseg.on.a {
                                        background: var(--aa-green);
                                        color: #fff;
                                        }

                                        #aaBoard .aa-decseg.on.d {
                                        background: #667085;
                                        color: #fff;
                                        }
                                        background: rgba(107,116,130,.16);
                                        color: #4b5563
                                        }

                                        #aaBoard .aa-dayhd {
                                        display: flex;
                                        align-items: center;
                                        gap: 10px;
                                        margin: 24px 0 12px
                                        }

                                        #aaBoard .aa-dayhd h2 {
                                        margin: 0;
                                        font-size: 12px;
                                        font-weight: 700;
                                        letter-spacing: .09em;
                                        text-transform: uppercase;
                                        color: var(--aa-muted)
                                        }

                                        #aaBoard .aa-dayhd i {
                                        flex: 1;
                                        height: 1px;
                                        background: var(--aa-hair)
                                        }

                                        #aaBoard .aa-dayhd em {
                                        font-style: normal;
                                        font: 600 11px/1 var(--aa-mono);
                                        color: var(--aa-muted2)
                                        }

                                        #aaBoard .aa-grid {
                                        display: grid;
                                        gap: 13px;
                                        grid-template-columns: repeat(auto-fill,minmax(322px,1fr))
                                        }

                                        #aaBoard .aa-ac {
                                        position: relative;
                                        background: #fff;
                                        border: 1px solid var(--aa-hair);
                                        border-left: 3px solid var(--aa-hair);
                                        border-radius: 12px;
                                        padding: 11px 13px 10px;
                                        transition: box-shadow .14s,transform .12s
                                        }

                                        #aaBoard .aa-ac:hover {
                                        transform: translateY(-2px);
                                        box-shadow: 0 5px 15px rgba(20,24,31,.10)
                                        }

                                        #aaBoard .aa-ac.fail {
                                        border-left-color: var(--aa-red)
                                        }

                                        #aaBoard .aa-ac.pred {
                                        border-left-color: var(--aa-amber)
                                        }

                                        #aaBoard .aa-ac-hd {
                                        display: flex;
                                        align-items: center;
                                        gap: 9px
                                        }

                                        #aaBoard .aa-ac-hd b {
                                        font-size: 14px;
                                        font-weight: 700;
                                        letter-spacing: -.01em;
                                        white-space: nowrap;
                                        overflow: hidden;
                                        text-overflow: ellipsis
                                        }

                                        #aaBoard .aa-ac-t {
                                        font-family: var(--aa-mono);
                                        font-size: 11px;
                                        color: var(--aa-muted2);
                                        flex: none
                                        }

                                        #aaBoard .aa-ac-sp {
                                        flex: 1
                                        }

                                        #aaBoard .aa-ac-cause {
                                        margin-top: 8px;
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        line-height: 1.35;
                                        min-height: 34px
                                        }

                                        #aaBoard .aa-ac-cause a {
                                        color: inherit;
                                        cursor: pointer;
                                        text-decoration: none
                                        }

                                        #aaBoard .aa-ac-cause a:hover {
                                        text-decoration: underline
                                        }

                                        #aaBoard .aa-ac-sr {
                                        display: flex;
                                        align-items: center;
                                        gap: 7px;
                                        margin-top: 9px;
                                        flex-wrap: wrap
                                        }

                                        #aaBoard .aa-ac-id {
                                        display: flex;
                                        align-items: center;
                                        gap: 6px;
                                        margin-top: 9px;
                                        padding-top: 8px;
                                        border-top: 1px solid var(--aa-hair2);
                                        font-size: 10.5px;
                                        color: var(--aa-muted);
                                        min-height: 22px
                                        }

                                        #aaBoard .aa-ac-ft {
                                        display: flex;
                                        align-items: center;
                                        gap: 7px;
                                        margin-top: 7px;
                                        font-size: 10.5px;
                                        color: var(--aa-muted);
                                        min-height: 26px
                                        }

                                        #aaBoard .aa-rate-lbl {
                                        font-size: 10px;
                                        font-weight: 600;
                                        letter-spacing: .07em;
                                        text-transform: uppercase;
                                        color: var(--aa-muted2)
                                        }

                                        /* SIGNATURE -- the decision disc. Severity is the left border, decision is the disc. */
                                        #aaBoard .aa-disc {
                                        flex: none;
                                        width: 27px;
                                        height: 27px;
                                        border-radius: 50%;
                                        display: grid;
                                        place-items: center;
                                        font: 800 13px/1 var(--aa-mono);
                                        cursor: help;
                                        border: 2px solid;
                                        background: #fff;
                                        transition: transform .12s,box-shadow .12s
                                        }

                                        #aaBoard .aa-disc:focus-visible {
                                        outline: 2px solid var(--aa-indigo,#3f42c9);
                                        outline-offset: 3px
                                        }

                                        #aaBoard .aa-disc.a {
                                        color: #0b7a4d;
                                        border-color: var(--aa-green);
                                        background: rgba(31,157,107,.09)
                                        }

                                        #aaBoard .aa-disc.d {
                                        color: #4b5563;
                                        border-color: var(--aa-muted2);
                                        background: rgba(107,116,130,.09)
                                        }

                                        #aaBoard .aa-disc:hover {
                                        transform: scale(1.1)
                                        }

                                        #aaBoard .aa-disc.a:hover {
                                        box-shadow: 0 0 0 4px rgba(31,157,107,.14)
                                        }

                                        /* ===== v1.0.1.5: RATE THIS ANALYSIS -- a control that can save ===============
                                        The star chip was display-only from 1.0.0.0 because there was nowhere to write.
                                        There is now (POST api/AIRating/Upsert via SaveAiRating), so it becomes a button.
                                        A real dialog, not the hover flyout: the flyout is pointer-events:none and
                                        disappears on mouseout, which is exactly wrong for something you type into. */
                                        #aaBoard .aa-rate.can {
                                        cursor: pointer;
                                        }

                                        #aaBoard .aa-rate.can:hover {
                                        border-color: var(--aa-indigo);
                                        box-shadow: 0 0 0 3px rgba(63,66,201,.12);
                                        }

                                        /* ===== v1.0.2.0: WAS THE ALERT VALID? -- the reviewer toggle ==================
                                        A switch, not a chip, because this one WRITES on a single click: POST
                                        AIAssessment/Upsert as AssessmentRole REVIEWER, AssessedBy = the login user id.

                                        THREE visual states, not two. A switch normally carries a boolean, but the
                                        underlying WasAlertUseful is nullable and "nobody has judged this yet" is a
                                        different fact from "a reviewer said no". Collapsing the two would show every
                                        unjudged alert as an explicit rejection nobody made -- the 1.0.55.101 mistake in
                                        reverse. So: dashed track = unmarked, green = valid, red = not valid, and the
                                        label says which in words rather than relying on colour alone. */
                                        #aaBoard .aa-vt {
                                        flex: none;
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 5px;
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 20px;
                                        background: #fff;
                                        padding: 2px 8px 2px 4px;
                                        /* Separate properties, not the `font` shorthand. The shorthand REQUIRES a family,
                                        and `inherit` is not a legal value in that position -- `font: 600 10px/1 inherit`
                                        makes the browser drop the WHOLE declaration, so the label renders at the table's
                                        own size and the switch outgrows its column. (Two older chips in this file carry
                                        the same mistake; they are not mine to change in this revision.) */
                                        font-size: 10px;
                                        font-weight: 600;
                                        line-height: 1;
                                        letter-spacing: .02em;
                                        color: var(--aa-muted);
                                        cursor: default;
                                        transition: border-color .13s,box-shadow .13s,background .13s;
                                        }

                                        /* The track and its knob. 22px wide: the smallest that still reads as a switch
                                        rather than a dot, inside a table cell that has 104px for three controls. */
                                        #aaBoard .aa-vt .aa-vt-tr {
                                        position: relative;
                                        flex: none;
                                        width: 22px;
                                        height: 12px;
                                        border-radius: 8px;
                                        background: #eef0f4;
                                        border: 1px dashed var(--aa-muted2);
                                        transition: background .13s,border-color .13s;
                                        }

                                        #aaBoard .aa-vt .aa-vt-tr i {
                                        position: absolute;
                                        top: 1px;
                                        left: 1px;
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 50%;
                                        background: var(--aa-muted2);
                                        transition: transform .15s,background .13s;
                                        }

                                        #aaBoard .aa-vt.can {
                                        cursor: pointer;
                                        }

                                        #aaBoard .aa-vt.can:hover {
                                        border-color: var(--aa-indigo);
                                        box-shadow: 0 0 0 3px rgba(63,66,201,.12);
                                        }

                                        #aaBoard .aa-vt:focus-visible {
                                        outline: 2px solid var(--aa-indigo,#3f42c9);
                                        outline-offset: 2px;
                                        }

                                        /* VALID -- knob right, solid green. */
                                        #aaBoard .aa-vt.yes {
                                        color: #0b7a4d;
                                        border-color: var(--aa-green);
                                        background: rgba(31,157,107,.08);
                                        }

                                        #aaBoard .aa-vt.yes .aa-vt-tr {
                                        background: rgba(31,157,107,.22);
                                        border: 1px solid var(--aa-green);
                                        }

                                        #aaBoard .aa-vt.yes .aa-vt-tr i {
                                        background: var(--aa-green);
                                        transform: translateX(10px);
                                        }

                                        /* NOT VALID -- knob left, solid red. Deliberately NOT the same grey as unmarked:
                                        a recorded "no" is a judgement and has to look like one. */
                                        #aaBoard .aa-vt.no {
                                        color: #a3272c;
                                        border-color: var(--aa-red,#c0392b);
                                        background: rgba(192,57,43,.07);
                                        }

                                        #aaBoard .aa-vt.no .aa-vt-tr {
                                        background: rgba(192,57,43,.16);
                                        border: 1px solid var(--aa-red,#c0392b);
                                        }

                                        #aaBoard .aa-vt.no .aa-vt-tr i {
                                        background: var(--aa-red,#c0392b);
                                        }

                                        /* Mid-flight. The click is not a judgement until the server says the row was
                                        written, so the switch shows it is still asking rather than moving early. */
                                        #aaBoard .aa-vt.busy {
                                        opacity: .6;
                                        cursor: progress;
                                        }

                                        /* The save FAILED. The switch snaps back to what the server still holds and says
                                        so in the label, because the one thing this control must never do is look
                                        settled over a judgement that was never stored. */
                                        #aaBoard .aa-vt.err {
                                        color: #a3272c;
                                        border-color: var(--aa-red,#c0392b);
                                        background: rgba(192,57,43,.1);
                                        }

                                        /* Nothing to judge -- no analysis run exists for this alert, so AIAssessment has
                                        no AnalysisId to key a row on. Same reasoning as the disabled star chip:
                                        offering a control that can only fail is worse than a control that explains
                                        why it is off. */
                                        #aaBoard .aa-vt.na {
                                        opacity: .45;
                                        }

                                        /* The AI cell holds three things now -- verdict state, star rating, validity switch.
                                        Stacked, because side by side they need ~190px and the column has 112px; the table
                                        is already at its width budget and a fourth column would come out of the cause. */
                                        #aaBoard .aa-ai-in {
                                        display: inline-flex;
                                        flex-direction: column;
                                        align-items: center;
                                        gap: 3px;
                                        }

                                        #aaBoard .aa-ai-in .aa-ai-r {
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 4px;
                                        }

                                        /* ===== v1.0.2.2: ANALYSIS DETAIL -- the button and the modal =================
                                        The button sits beside Insight on the table row and the card. Quiet by default
                                        (this is reference, not the primary action) and it brightens on hover. */
                                        #aaBoard .aa-dbtn {
                                        flex: none;
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 4px;
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 16px;
                                        background: #fff;
                                        padding: 2px 9px 2px 7px;
                                        font-size: 10.5px;
                                        font-weight: 600;
                                        color: var(--aa-muted);
                                        cursor: pointer;
                                        white-space: nowrap;
                                        transition: border-color .13s,box-shadow .13s,color .13s;
                                        }

                                        #aaBoard .aa-dbtn:hover {
                                        color: var(--aa-indigo,#5457e6);
                                        border-color: var(--aa-indigo,#5457e6);
                                        box-shadow: 0 0 0 3px rgba(84,87,230,.1);
                                        }

                                        #aaBoard .aa-dbtn:focus-visible {
                                        outline: 2px solid var(--aa-indigo,#5457e6);
                                        outline-offset: 2px;
                                        }

                                        /* v1.0.2.8: nothing to show. Flat, muted and not-allowed, and it keeps its
                                        hover rule suppressed so it cannot brighten under the pointer and promise a
                                        click it will not take. It is NOT the disabled attribute -- see 1.0.2.8. */
                                        #aaBoard .aa-dbtn.na {
                                        background: var(--aa-hair2);
                                        border-color: transparent;
                                        color: var(--aa-muted2);
                                        cursor: not-allowed;
                                        }

                                        #aaBoard .aa-dbtn.na:hover {
                                        color: var(--aa-muted2);
                                        border-color: transparent;
                                        box-shadow: none;
                                        }

                                        #aaBoard .aa-dbtn .aa-dbtn-i {
                                        font-size: 12px;
                                        line-height: 1;
                                        }

                                        /* The modal lives on <body>, OUTSIDE #aaBoard, so its rules are not scoped to the
                                        board -- a board-scoped selector would not reach it. High z-index to clear the
                                        sticky command bar (z 2000) and the hover flyouts. */
                                        .aa-dm {
                                        position: fixed;
                                        inset: 0;
                                        z-index: 6000;
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        padding: 24px 16px;
                                        box-sizing: border-box;
                                        font: 13px/1.45 "Segoe UI", system-ui, -apple-system, sans-serif;
                                        color: #1f2430;
                                        }

                                        .aa-dm-bd {
                                        position: absolute;
                                        inset: 0;
                                        background: rgba(16,20,29,.52);
                                        backdrop-filter: blur(1.5px);
                                        }

                                        .aa-dm-panel {
                                        position: relative;
                                        width: 100%;
                                        /* v1.0.3.4: 720 -> 880. The panel used to hold a verdict and a key/value grid;
                                        it now holds a measurement row, the fired conditions with their limits, the
                                        relay pairs and a five-column readings table, and 720px was folding all of
                                        them onto extra lines. */
                                        max-width: 880px;
                                        max-height: 88vh;
                                        display: flex;
                                        flex-direction: column;
                                        background: #fff;
                                        border-radius: 14px;
                                        box-shadow: 0 24px 64px rgba(16,20,29,.34);
                                        overflow: hidden;
                                        }

                                        .aa-dm-hd {
                                        flex: none;
                                        display: flex;
                                        align-items: center;
                                        gap: 12px;
                                        padding: 14px 16px;
                                        border-bottom: 1px solid #e6e9ef;
                                        background: #fbfcfe;
                                        }

                                        .aa-dm-ttl {
                                        flex: 1;
                                        min-width: 0;
                                        font-size: 15px;
                                        font-weight: 700;
                                        letter-spacing: -.01em;
                                        overflow: hidden;
                                        text-overflow: ellipsis;
                                        white-space: nowrap;
                                        }

                                        .aa-dm-ttl .aa-dm-sub {
                                        font-size: 12px;
                                        font-weight: 500;
                                        color: #6b7482;
                                        }

                                        .aa-dm-x {
                                        flex: none;
                                        width: 30px;
                                        height: 30px;
                                        border: 1px solid #e2e6ec;
                                        border-radius: 8px;
                                        background: #fff;
                                        font-size: 20px;
                                        line-height: 1;
                                        color: #6b7482;
                                        cursor: pointer;
                                        }

                                        .aa-dm-x:hover {
                                        background: #f1f3f7;
                                        color: #1f2430;
                                        }

                                        .aa-dm-body {
                                        flex: 1;
                                        overflow-y: auto;
                                        padding: 14px 16px 18px;
                                        background: #f6f7f9;
                                        }

                                        .aa-dm-load, .aa-dm-err, .aa-dm-empty {
                                        padding: 28px 12px;
                                        text-align: center;
                                        color: #6b7482;
                                        }

                                        .aa-dm-err { color: #a3272c; }

                                        .aa-dt-summary {
                                        font-size: 12px;
                                        color: #6b7482;
                                        margin-bottom: 10px;
                                        }

                                        .aa-dt-summary b { color: #1f2430; }

                                        .aa-dt-summary .aa-dt-trunc { color: #a06a00; }

                                        /* One run = one card. The latest gets a coloured spine so the run on screen is
                                        distinguishable from the history behind it. */
                                        .aa-dt-card {
                                        background: #fff;
                                        border: 1px solid #e6e9ef;
                                        border-left: 3px solid #d6dae2;
                                        border-radius: 10px;
                                        padding: 12px 14px;
                                        margin-bottom: 12px;
                                        }

                                        .aa-dt-card.latest {
                                        border-left-color: var(--aa-indigo,#5457e6);
                                        }

                                        .aa-dt-top {
                                        display: flex;
                                        align-items: center;
                                        flex-wrap: wrap;
                                        gap: 8px;
                                        margin-bottom: 8px;
                                        }

                                        .aa-dt-vd {
                                        display: inline-flex;
                                        align-items: center;
                                        padding: 2px 9px;
                                        border-radius: 6px;
                                        font-family: ui-monospace, Consolas, monospace;
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: .03em;
                                        }

                                        .aa-dt-vd.ok   { background: rgba(23,151,106,.12); color: #0b7a4d; }
                                        .aa-dt-vd.no   { background: rgba(192,57,43,.12);  color: #a3272c; }
                                        .aa-dt-vd.warn { background: rgba(214,158,0,.15);  color: #8a6400; }
                                        .aa-dt-vd.neut { background: #eef0f4;              color: #4b5563; }

                                        .aa-dt-conf {
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: #4b5563;
                                        }

                                        .aa-dt-badge {
                                        font-size: 9.5px;
                                        font-weight: 700;
                                        letter-spacing: .05em;
                                        padding: 2px 6px;
                                        border-radius: 5px;
                                        }

                                        .aa-dt-badge.latest { background: rgba(84,87,230,.14); color: #4145c0; }
                                        .aa-dt-badge.stale  { background: rgba(192,57,43,.12); color: #a3272c; }
                                        .aa-dt-badge.cache  { background: #eef0f4; color: #6b7482; }

                                        /* v1.0.2.0: WHICH REVIEW STAGE A RUN WAS MADE IN. Only drawn when the panel
                                        actually holds runs from both stages -- on an ordinary alert every run carries
                                        the same stage and a badge repeating it on each card is noise. The two colours
                                        are the board's own approved/discarded pair, so the chip reads as the same
                                        distinction the cards already make rather than as a new vocabulary. */
                                        .aa-dt-stg {
                                        font: 700 9.5px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        letter-spacing: .06em;
                                        padding: 3px 7px;
                                        border-radius: 5px;
                                        white-space: nowrap;
                                        }

                                        .aa-dt-stg.pend { background: #f2f5f8; color: #5a6478; border: 1px solid #e0e5ec; }
                                        .aa-dt-stg.appr { background: rgba(28,138,92,.12); color: #1c7a53; border: 1px solid rgba(28,138,92,.22); }

                                        /* The banner that explains the merge. Deliberately quiet: it is context for
                                        the list below it, not a warning about it. */
                                        .aa-dt-merge {
                                        display: flex;
                                        gap: 8px;
                                        align-items: flex-start;
                                        background: #f7f9fc;
                                        border: 1px solid #e3e8f0;
                                        border-left: 3px solid #9aa7bd;
                                        border-radius: 8px;
                                        padding: 9px 11px;
                                        margin-bottom: 11px;
                                        font-size: 12px;
                                        color: #4b5563;
                                        line-height: 1.5;
                                        }

                                        .aa-dt-merge b { color: #1f2430; }
                                        .aa-dt-merge .aa-dt-mi { font-size: 13px; line-height: 1.2; color: #6b7482; }
                                        .aa-dt-merge.warn { background: #fff9ef; border-color: #f0e2c6; border-left-color: #d79a2b; color: #7a5a14; }
                                        .aa-dt-merge.warn b { color: #6a4c0d; }

                                        .aa-dt-when {
                                        margin-left: auto;
                                        font-size: 11.5px;
                                        color: #6b7482;
                                        white-space: nowrap;
                                        }

                                        .aa-dt-head {
                                        font-size: 13.5px;
                                        font-weight: 700;
                                        line-height: 1.35;
                                        margin-bottom: 4px;
                                        }

                                        .aa-dt-cause {
                                        font-size: 12.5px;
                                        color: #374151;
                                        margin-bottom: 4px;
                                        }

                                        .aa-dt-lbl {
                                        font-size: 10px;
                                        font-weight: 700;
                                        letter-spacing: .05em;
                                        text-transform: uppercase;
                                        color: #8b94a1;
                                        margin-right: 4px;
                                        }

                                        .aa-dt-sec { margin-top: 10px; }

                                        .aa-dt-sh {
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        letter-spacing: .05em;
                                        text-transform: uppercase;
                                        color: #8b94a1;
                                        margin-bottom: 4px;
                                        }

                                        .aa-dt-ev {
                                        margin: 0;
                                        padding-left: 18px;
                                        }

                                        .aa-dt-ev li {
                                        font-size: 12.5px;
                                        line-height: 1.5;
                                        color: #2b3240;
                                        margin-bottom: 2px;
                                        }

                                        .aa-dt-act {
                                        font-size: 12.5px;
                                        line-height: 1.5;
                                        color: #2b3240;
                                        background: #f3faf6;
                                        border: 1px solid #d6ecdf;
                                        border-radius: 8px;
                                        padding: 8px 10px;
                                        }

                                        .aa-dt-cav {
                                        font-size: 12px;
                                        line-height: 1.5;
                                        color: #6b5a30;
                                        background: #fdf9ef;
                                        border: 1px solid #efe3c4;
                                        border-radius: 8px;
                                        padding: 8px 10px;
                                        }

                                        /* ================================================================
                                        v1.0.3.3 -- DETAIL PANEL, the case rather than the build.
                                        The .aa-dt-meta / .aa-dt-kv key-value grid that used to close every card is
                                        gone with the build metadata it existed to print.
                                        ================================================================ */

                                        .aa-dt-sub { color: #8b94a1; font-weight: 500; }

                                        /* Two real analyses reached different verdicts. Amber, not red: the panel is
                                        reporting a split it can usually explain, not an error. */
                                        .aa-dt-split {
                                        display: flex;
                                        flex-direction: column;
                                        gap: 3px;
                                        margin: 0 0 12px;
                                        padding: 9px 12px;
                                        background: #fffaf0;
                                        border: 1px solid #efe3c4;
                                        border-left: 3px solid #d99616;
                                        border-radius: 8px;
                                        }

                                        .aa-dt-split-t {
                                        font-size: 11px;
                                        font-weight: 800;
                                        letter-spacing: .06em;
                                        text-transform: uppercase;
                                        color: #8a6212;
                                        }

                                        .aa-dt-split-b { font-size: 12.5px; line-height: 1.45; color: #5f4a1c; }

                                        .aa-dt-card.lead { border-color: #dfe3ea; }

                                        .aa-dt-cat {
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        letter-spacing: .04em;
                                        color: #5a6478;
                                        background: #eef1f5;
                                        border-radius: 20px;
                                        padding: 2px 9px;
                                        }

                                        /* fired -> reset, and whether it had reset at all. */
                                        .aa-dt-when-row {
                                        display: flex;
                                        flex-wrap: wrap;
                                        align-items: center;
                                        gap: 6px 14px;
                                        margin: 10px 0 2px;
                                        padding: 8px 10px;
                                        background: #f8fafc;
                                        border-radius: 8px;
                                        }

                                        .aa-dt-wh {
                                        display: inline-flex;
                                        flex-direction: column;
                                        gap: 1px;
                                        font: 600 12.5px/1.2 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        color: #1f2430;
                                        }

                                        .aa-dt-wh i {
                                        font: 600 9.5px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        letter-spacing: .12em;
                                        text-transform: uppercase;
                                        color: #8b94a1;
                                        font-style: normal;
                                        }

                                        .aa-dt-wh.open { color: #d1435b; }
                                        .aa-dt-arw { color: #8b94a1; font-size: 15px; }

                                        /* THE MEASUREMENT. The reading is set large because it is the number the whole
                                        verdict rests on; the limits beside it are what make it mean anything. */
                                        .aa-dt-viz {
                                        display: flex;
                                        flex-wrap: wrap;
                                        gap: 8px;
                                        }

                                        .aa-dt-vz {
                                        display: inline-flex;
                                        flex-direction: column;
                                        gap: 2px;
                                        min-width: 78px;
                                        padding: 7px 11px;
                                        background: #f6f8fa;
                                        border: 1px solid #eef1f5;
                                        border-radius: 9px;
                                        }

                                        .aa-dt-vz i {
                                        font: 600 9.5px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        letter-spacing: .1em;
                                        text-transform: uppercase;
                                        color: #8b94a1;
                                        font-style: normal;
                                        }

                                        .aa-dt-vz b {
                                        font: 700 14px/1.15 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        color: #1f2430;
                                        }

                                        .aa-dt-vz.big {
                                        background: #fff;
                                        border-color: #dfe3ea;
                                        }

                                        .aa-dt-vz.big b { font-size: 20px; }
                                        .aa-dt-vz.dn b { color: #d1435b; }
                                        .aa-dt-vz.up b { color: #1f9d6b; }
                                        .aa-dt-vz.side { margin-left: auto; }

                                        .aa-dt-note { margin-top: 6px; font-size: 12px; color: #6b7482; }

                                        /* What fired, and against which limits. */
                                        .aa-dt-conds { display: flex; flex-direction: column; gap: 6px; }

                                        .aa-dt-cond {
                                        display: flex;
                                        flex-wrap: wrap;
                                        align-items: center;
                                        gap: 5px 9px;
                                        padding: 7px 10px;
                                        background: #f8fafc;
                                        border-radius: 8px;
                                        }

                                        .aa-dt-cn { font-size: 12.5px; font-weight: 700; color: #1f2430; }

                                        .aa-dt-cv {
                                        font: 700 13px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        color: #1f2430;
                                        background: #fff;
                                        border: 1px solid #dfe3ea;
                                        border-radius: 6px;
                                        padding: 3px 7px;
                                        }

                                        .aa-dt-cths { display: inline-flex; flex-wrap: wrap; gap: 5px; }

                                        .aa-dt-th {
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 5px;
                                        font: 600 11px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        border-radius: 20px;
                                        padding: 3px 8px;
                                        }

                                        .aa-dt-th b { font-weight: 800; font-size: 9.5px; letter-spacing: .06em; }
                                        .aa-dt-th.fail { background: #fdeef1; color: #a3223a; }
                                        .aa-dt-th.pass { background: #eaf7f1; color: #12704e; }

                                        .aa-dt-ct {
                                        margin-left: auto;
                                        font: 500 11px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        color: #8b94a1;
                                        }

                                        /* Relays. The pair is the information -- a relay that changed carries an arrow
                                        and the one that did not is left flat, so the change is found without reading. */
                                        .aa-dt-relays { display: flex; flex-wrap: wrap; gap: 6px; }

                                        .aa-dt-relay {
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 6px;
                                        padding: 5px 10px;
                                        background: #f6f8fa;
                                        border: 1px solid #eef1f5;
                                        border-radius: 20px;
                                        }

                                        .aa-dt-relay.changed { background: #fff; border-color: #bcd9c9; }

                                        .aa-dt-rl {
                                        font: 700 11px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        letter-spacing: .04em;
                                        color: #5a6478;
                                        }

                                        .aa-dt-rv {
                                        font: 600 11px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        color: #1f2430;
                                        }

                                        .aa-dt-rv.to { color: #12704e; font-weight: 800; }
                                        .aa-dt-rarw { color: #8b94a1; font-size: 12px; }

                                        /* Provenance as a chip. [record] came off the alert, [fetched] was pulled from
                                        history during the analysis -- that difference is why the tag exists. */
                                        .aa-dt-src {
                                        display: inline-block;
                                        margin-right: 7px;
                                        font: 700 9.5px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        letter-spacing: .08em;
                                        text-transform: uppercase;
                                        border-radius: 4px;
                                        padding: 2px 5px;
                                        vertical-align: 1px;
                                        }

                                        .aa-dt-src.record { background: #eef1f5; color: #5a6478; }
                                        .aa-dt-src.fetched { background: #eaf0fd; color: #3a3dc0; }

                                        /* Asset history. sameCause is the question, so it gets the colour. */
                                        .aa-dt-hist { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 12px; }

                                        .aa-dt-hn {
                                        font-size: 12px;
                                        color: #5a6478;
                                        background: #f6f8fa;
                                        border-radius: 20px;
                                        padding: 4px 11px;
                                        }

                                        .aa-dt-hn b { font-weight: 800; color: #1f2430; }
                                        .aa-dt-hn.warn { background: #fdeef1; color: #a3223a; }
                                        .aa-dt-hn.warn b { color: #a3223a; }
                                        .aa-dt-hn.ok { background: #eaf7f1; color: #12704e; }
                                        .aa-dt-hn.ok b { color: #12704e; }

                                        .aa-dt-hspan {
                                        font: 500 11px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        color: #8b94a1;
                                        }

                                        .aa-dt-causes { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 7px; }

                                        /* v1.0.3.4: the same asset by DATE, derived from the board's own window. Kept
                                        visually separate from the 30-day figures above it, and captioned, because two
                                        different windows on one panel must say which is which. */
                                        .aa-dt-dates {
                                        margin-top: 10px;
                                        padding-top: 9px;
                                        border-top: 1px dashed #e4e8ee;
                                        }

                                        .aa-dt-dh {
                                        display: flex;
                                        flex-wrap: wrap;
                                        align-items: baseline;
                                        gap: 3px 9px;
                                        margin-bottom: 5px;
                                        font: 700 10.5px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        letter-spacing: .1em;
                                        text-transform: uppercase;
                                        color: #8b94a1;
                                        }

                                        .aa-dt-dhn {
                                        font-weight: 500;
                                        letter-spacing: 0;
                                        text-transform: none;
                                        font-size: 11px;
                                        color: #8b94a1;
                                        }

                                        .aa-dt-drow {
                                        display: grid;
                                        grid-template-columns: 116px 1fr 54px;
                                        align-items: center;
                                        gap: 8px;
                                        padding: 2px 0;
                                        }

                                        .aa-dt-dd {
                                        font: 600 11px/1.2 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        color: #1f2430;
                                        overflow: hidden;
                                        text-overflow: ellipsis;
                                        white-space: nowrap;
                                        }

                                        .aa-dt-dbar {
                                        display: block;
                                        height: 9px;
                                        background: #f2f5f8;
                                        border-radius: 5px;
                                        overflow: hidden;
                                        }

                                        .aa-dt-dbar i {
                                        display: block;
                                        height: 100%;
                                        border-radius: 5px;
                                        background: #c3c8d4;
                                        }

                                        /* A date that carried THIS alert's cause code is the one worth finding. */
                                        .aa-dt-dbar i.same { background: var(--aa-indigo, #5457e6); }

                                        .aa-dt-dn {
                                        display: flex;
                                        align-items: center;
                                        justify-content: flex-end;
                                        gap: 5px;
                                        font: 700 11.5px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        font-variant-numeric: tabular-nums;
                                        color: #1f2430;
                                        }

                                        .aa-dt-dn b {
                                        font-size: 9.5px;
                                        font-weight: 800;
                                        color: #fff;
                                        background: var(--aa-indigo, #5457e6);
                                        border-radius: 20px;
                                        padding: 1px 5px;
                                        }

                                        .aa-dt-cc {
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 5px;
                                        font: 600 10.5px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        color: #5a6478;
                                        background: #f6f8fa;
                                        border: 1px solid #eef1f5;
                                        border-radius: 5px;
                                        padding: 3px 7px;
                                        }

                                        .aa-dt-cc b { color: #1f2430; font-weight: 800; }

                                        /* The readings table. Collapsed: twenty values is the least urgent thing here,
                                        and the summary already carries the part that is not (how many are out of band). */
                                        .aa-dt-snap {
                                        margin-top: 14px;
                                        padding-top: 12px;
                                        border-top: 1px solid #eef1f5;
                                        }

                                        .aa-dt-snap > summary {
                                        display: flex;
                                        flex-wrap: wrap;
                                        align-items: baseline;
                                        gap: 4px 10px;
                                        cursor: pointer;
                                        list-style: none;
                                        }

                                        .aa-dt-snap > summary::-webkit-details-marker { display: none; }

                                        .aa-dt-snap > summary::before {
                                        content: "\25B8";
                                        color: #8b94a1;
                                        font-size: 11px;
                                        transition: transform .12s ease;
                                        }

                                        .aa-dt-snap[open] > summary::before { transform: rotate(90deg); }

                                        .aa-dt-snn {
                                        font: 500 11.5px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        color: #8b94a1;
                                        }

                                        .aa-dt-snn b { color: #a3223a; font-weight: 800; }

                                        .aa-dt-tbl {
                                        width: 100%;
                                        margin-top: 9px;
                                        border-collapse: collapse;
                                        font-size: 11.5px;
                                        }

                                        .aa-dt-tbl td {
                                        padding: 5px 8px;
                                        border-bottom: 1px solid #f2f5f8;
                                        vertical-align: middle;
                                        }

                                        .aa-dt-tbl tr.bad td { background: #fffafb; }
                                        .aa-dt-tbl td.a { color: #1f2430; font-weight: 600; }

                                        .aa-dt-tbl td.v {
                                        font: 700 12px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        font-variant-numeric: tabular-nums;
                                        text-align: right;
                                        white-space: nowrap;
                                        }

                                        .aa-dt-tbl td.s { width: 54px; }

                                        .aa-dt-tbl td.b,
                                        .aa-dt-tbl td.t {
                                        font: 500 10.5px/1.3 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        color: #8b94a1;
                                        white-space: nowrap;
                                        }

                                        .aa-dt-st {
                                        display: inline-block;
                                        font: 700 9.5px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        letter-spacing: .06em;
                                        text-transform: uppercase;
                                        border-radius: 4px;
                                        padding: 2px 6px;
                                        }

                                        .aa-dt-st.ok { background: #eaf7f1; color: #12704e; }
                                        .aa-dt-st.low,
                                        .aa-dt-st.high { background: #fdeef1; color: #a3223a; }

                                        /* Every run on one line. A reuse is labelled a reuse -- it is the same verdict
                                        handed out again, not a second analysis. */
                                        .aa-dt-runs {
                                        margin-top: 14px;
                                        padding-top: 12px;
                                        border-top: 1px solid #eef1f5;
                                        }

                                        .aa-dt-run {
                                        display: flex;
                                        flex-wrap: wrap;
                                        align-items: center;
                                        gap: 8px;
                                        padding: 6px 8px;
                                        border-radius: 7px;
                                        }

                                        .aa-dt-run.on { background: #f6f8fa; }

                                        .aa-dt-rvd {
                                        font: 800 10px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        letter-spacing: .05em;
                                        border-radius: 5px;
                                        padding: 3px 7px;
                                        }

                                        .aa-dt-rvd.ok { background: #eaf7f1; color: #12704e; }
                                        .aa-dt-rvd.no { background: #fdeef1; color: #a3223a; }
                                        .aa-dt-rvd.warn { background: #fffaf0; color: #8a6212; }
                                        .aa-dt-rvd.neut { background: #eef1f5; color: #5a6478; }

                                        .aa-dt-rcf {
                                        font: 600 11px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        font-variant-numeric: tabular-nums;
                                        color: #5a6478;
                                        min-width: 34px;
                                        }

                                        .aa-dt-rkind {
                                        font: 700 9.5px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        letter-spacing: .07em;
                                        text-transform: uppercase;
                                        border-radius: 20px;
                                        padding: 3px 8px;
                                        }

                                        .aa-dt-rkind.real { background: #eaf0fd; color: #3a3dc0; }
                                        .aa-dt-rkind.reuse { background: #f2f5f8; color: #8b94a1; }

                                        .aa-dt-rwhen {
                                        font: 500 11px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        color: #8b94a1;
                                        }

                                        .aa-dt-rshown {
                                        margin-left: auto;
                                        font: 600 10px/1 ui-monospace,"Cascadia Mono","Consolas",monospace;
                                        letter-spacing: .05em;
                                        text-transform: uppercase;
                                        color: #8b94a1;
                                        }

                                        @@media (max-width: 560px) {
                                        .aa-dm-panel { max-height: 92vh; }
                                        .aa-dt-vz.side { margin-left: 0; }
                                        .aa-dt-ct { margin-left: 0; }
                                        .aa-dt-tbl td.b { display: none; }
                                        }

                                        /* v1.0.1.7: the in-popup rating panel. Reuses .aa-rstars and .aa-rbtn from the dialog
                                        rather than a second set of star styles that would drift from it. */
                                        #aiRatePanel {
                                        margin-top: 10px;
                                        border: 1px solid #e4e8ee;
                                        border-radius: 12px;
                                        background: #fcfdff;
                                        padding: 12px 14px;
                                        }

                                        #aiRatePanel .arp-h {
                                        display: flex;
                                        align-items: baseline;
                                        gap: 8px;
                                        margin-bottom: 8px;
                                        }

                                        #aiRatePanel .arp-h b {
                                        font-size: 12px;
                                        color: #161a20;
                                        }

                                        #aiRatePanel .arp-h span {
                                        font: 500 10.5px/1 ui-monospace, Consolas, monospace;
                                        color: #98a1ad;
                                        margin-left: auto;
                                        }

                                        #aiRatePanel textarea {
                                        width: 100%;
                                        box-sizing: border-box;
                                        min-height: 56px;
                                        resize: vertical;
                                        border: 1px solid #dfe4ea;
                                        border-radius: 9px;
                                        padding: 7px 9px;
                                        font: inherit;
                                        font-size: 12.5px;
                                        margin-top: 8px;
                                        outline: none;
                                        }

                                        #aiRatePanel textarea:focus {
                                        border-color: #3f42c9;
                                        box-shadow: 0 0 0 3px rgba(63,66,201,.10);
                                        }

                                        #aiRatePanel .arp-f {
                                        display: flex;
                                        align-items: center;
                                        gap: 8px;
                                        margin-top: 9px;
                                        }

                                        .aa-rstars.arp-ro {
                                        align-items: center;
                                        gap: 3px;
                                        }

                                        .aa-rstars.arp-ro svg {
                                        width: 22px;
                                        height: 22px;
                                        }

                                        .aa-rstars.arp-ro u {
                                        text-decoration: none;
                                        font: 700 11px/1 ui-monospace, Consolas, monospace;
                                        color: #6b7482;
                                        margin-left: 7px;
                                        }

                                        .arp-ro-rem {
                                        margin-top: 8px;
                                        font-size: 12.5px;
                                        color: #2c3138;
                                        line-height: 1.5;
                                        }

                                        .arp-ro-rem.none {
                                        color: #98a1ad;
                                        font-style: italic;
                                        }

                                        /* v1.0.1.0: the CURRENT rating, shown above an edit form so the operator can see the
                                        value they are about to replace. Deliberately quiet -- it is context for the control
                                        below it, not a second control. */
                                        #aaBoard .aa-rcur,
                                        .aa-rdlg .aa-rcur,
                                        .aa-rcur {
                                        font-family: var(--aa-mono);
                                        font-size: 11px;
                                        color: var(--aa-muted);
                                        background: var(--aa-indigo-wash);
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 8px;
                                        padding: 7px 10px;
                                        margin-bottom: 10px
                                        }

                                        .arp-lock {
                                        margin-top: 10px;
                                        padding-top: 8px;
                                        border-top: 1px solid #eef1f5;
                                        font-size: 11px;
                                        color: #98a1ad;
                                        }

                                        .aa-rdlg-ov {
                                        position: fixed;
                                        inset: 0;
                                        z-index: 9500;
                                        background: rgba(20,24,31,.42);
                                        display: flex;
                                        align-items: center;
                                        justify-content: center;
                                        padding: 20px;
                                        }

                                        .aa-rdlg {
                                        width: 100%;
                                        max-width: 420px;
                                        background: #fff;
                                        border-radius: 14px;
                                        box-shadow: 0 20px 56px rgba(20,24,31,.32);
                                        overflow: hidden;
                                        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
                                        }

                                        .aa-rdlg-h {
                                        padding: 13px 16px;
                                        background: #f6f8fa;
                                        border-bottom: 1px solid #e4e8ee;
                                        }

                                        .aa-rdlg-h b {
                                        display: block;
                                        font-size: 14px;
                                        color: #161a20;
                                        }

                                        .aa-rdlg-h span {
                                        display: block;
                                        margin-top: 3px;
                                        font: 500 11.5px/1.4 ui-monospace, Consolas, monospace;
                                        color: #6b7482;
                                        }

                                        .aa-rdlg-b {
                                        padding: 15px 16px;
                                        }

                                        .aa-rdlg-q {
                                        font-size: 10px;
                                        font-weight: 700;
                                        letter-spacing: .09em;
                                        text-transform: uppercase;
                                        color: #98a1ad;
                                        margin-bottom: 7px;
                                        }

                                        .aa-rstars {
                                        display: flex;
                                        gap: 5px;
                                        margin-bottom: 4px;
                                        }

                                        .aa-rstars button {
                                        border: 0;
                                        background: transparent;
                                        padding: 2px;
                                        cursor: pointer;
                                        line-height: 0;
                                        border-radius: 5px;
                                        }

                                        .aa-rstars button:focus-visible {
                                        outline: 2px solid #3f42c9;
                                        outline-offset: 1px;
                                        }

                                        .aa-rstars button svg {
                                        width: 27px;
                                        height: 27px;
                                        }

                                        .aa-rword {
                                        font-size: 12px;
                                        color: #6b7482;
                                        min-height: 17px;
                                        margin-bottom: 12px;
                                        }

                                        .aa-rdlg textarea {
                                        width: 100%;
                                        box-sizing: border-box;
                                        min-height: 74px;
                                        resize: vertical;
                                        border: 1px solid #dfe4ea;
                                        border-radius: 9px;
                                        padding: 8px 10px;
                                        font: inherit;
                                        font-size: 13px;
                                        color: #161a20;
                                        outline: none;
                                        }

                                        .aa-rdlg textarea:focus {
                                        border-color: #3f42c9;
                                        box-shadow: 0 0 0 3px rgba(63,66,201,.10);
                                        }

                                        .aa-rcount {
                                        text-align: right;
                                        font: 500 10px/1 ui-monospace, Consolas, monospace;
                                        color: #98a1ad;
                                        margin-top: 4px;
                                        }

                                        .aa-rdlg-f {
                                        display: flex;
                                        align-items: center;
                                        gap: 8px;
                                        padding: 12px 16px;
                                        border-top: 1px solid #e4e8ee;
                                        background: #fcfdff;
                                        }

                                        .aa-rmsg {
                                        flex: 1;
                                        font-size: 11.5px;
                                        color: #98a1ad;
                                        min-height: 16px;
                                        }

                                        .aa-rmsg.err {
                                        color: #a32540;
                                        font-weight: 600;
                                        }

                                        .aa-rmsg.ok {
                                        color: #0b7a4d;
                                        font-weight: 600;
                                        }

                                        .aa-rbtn {
                                        border: 1px solid #dfe4ea;
                                        background: #fff;
                                        border-radius: 9px;
                                        font: inherit;
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: #4b5563;
                                        padding: 7px 14px;
                                        cursor: pointer;
                                        }

                                        .aa-rbtn.pri {
                                        border-color: #3f42c9;
                                        background: #3f42c9;
                                        color: #fff;
                                        }

                                        .aa-rbtn.pri:disabled {
                                        opacity: .55;
                                        cursor: default;
                                        }

                                        #aaBoard .aa-disc.d:hover {
                                        box-shadow: 0 0 0 4px rgba(107,116,130,.14)
                                        }



                                        #aaBoard .aa-rate {
                                        flex: none;
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 4px;
                                        cursor: help;
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 20px;
                                        padding: 2px 8px 2px 6px;
                                        background: #fff;
                                        transition: border-color .13s,box-shadow .13s
                                        }

                                        #aaBoard .aa-rate:hover {
                                        border-color: var(--aa-indigo,#3f42c9);
                                        box-shadow: 0 0 0 3px rgba(63,66,201,.10)
                                        }

                                        #aaBoard .aa-rate:focus-visible {
                                        outline: 2px solid var(--aa-indigo,#3f42c9);
                                        outline-offset: 2px
                                        }

                                        #aaBoard .aa-rate svg {
                                        width: 11px;
                                        height: 11px;
                                        flex: none
                                        }

                                        #aaBoard .aa-rate b {
                                        font: 700 10.5px/1 var(--aa-mono);
                                        color: var(--aa-ink)
                                        }

                                        #aaBoard .aa-rate.none {
                                        border-style: dashed
                                        }

                                        #aaBoard .aa-rate.none b {
                                        color: var(--aa-muted2);
                                        font-weight: 600
                                        }

                                        /* Hover flyout. position:fixed on <body> on purpose: the card grid, the day sections
                                        and the lane's overflow-x container would each clip a popover drawn inside a card. */
                                        .aa-pop {
                                        position: fixed;
                                        z-index: 9000;
                                        width: 272px;
                                        background: #fff;
                                        color: #161a20;
                                        border: 1px solid #e4e8ee;
                                        border-radius: 12px;
                                        padding: 11px 13px;
                                        box-shadow: 0 10px 30px rgba(20,24,31,.16);
                                        font-size: 12px;
                                        line-height: 1.5;
                                        opacity: 0;
                                        transform: translateY(4px);
                                        transition: opacity .12s,transform .12s;
                                        pointer-events: none
                                        }

                                        .aa-pop.in {
                                        opacity: 1;
                                        transform: translateY(0)
                                        }

                                        .aa-pop-hd {
                                        display: flex;
                                        align-items: center;
                                        gap: 7px;
                                        margin-bottom: 7px
                                        }

                                        .aa-pop-hd span {
                                        font: 700 9.5px/1 ui-monospace,Consolas,monospace;
                                        letter-spacing: .1em;
                                        text-transform: uppercase;
                                        border-radius: 4px;
                                        padding: 4px 6px
                                        }

                                        .aa-pop-hd span.a {
                                        background: rgba(31,157,107,.13);
                                        color: #0b7a4d
                                        }

                                        .aa-pop-hd span.d {
                                        background: rgba(107,116,130,.14);
                                        color: #4b5563
                                        }

                                        .aa-pop-hd span.ai {
                                        background: rgba(63,66,201,.12);
                                        color: #3f42c9
                                        }

                                        .aa-pop-hd em {
                                        font-style: normal;
                                        font-family: ui-monospace,Consolas,monospace;
                                        font-size: 10px;
                                        color: #98a1ad;
                                        margin-left: auto
                                        }

                                        .aa-pop-q {
                                        font-size: 10px;
                                        font-weight: 700;
                                        letter-spacing: .09em;
                                        text-transform: uppercase;
                                        color: #98a1ad;
                                        margin-bottom: 3px
                                        }

                                        .aa-pop-txt {
                                        color: #2c3138
                                        }

                                        .aa-pop-txt.none {
                                        color: #98a1ad;
                                        font-style: italic
                                        }

                                        .aa-pop-by {
                                        margin-top: 8px;
                                        padding-top: 7px;
                                        border-top: 1px solid #eef1f5;
                                        font-family: ui-monospace,Consolas,monospace;
                                        font-size: 10px;
                                        color: #98a1ad;
                                        display: flex;
                                        justify-content: space-between;
                                        gap: 8px
                                        }

                                        .aa-pop-stars {
                                        display: flex;
                                        align-items: center;
                                        gap: 3px;
                                        margin-bottom: 8px
                                        }

                                        .aa-pop-stars svg {
                                        width: 15px;
                                        height: 15px
                                        }

                                        .aa-pop-stars u {
                                        text-decoration: none;
                                        font: 700 11px/1 ui-monospace,Consolas,monospace;
                                        color: #6b7482;
                                        margin-left: 5px
                                        }

                                        .aa-pop-vf {
                                        margin-top: 8px;
                                        font-size: 10px;
                                        font-weight: 700;
                                        letter-spacing: .08em;
                                        text-transform: uppercase;
                                        border-radius: 5px;
                                        padding: 5px 7px;
                                        }

                                        .aa-pop-vf.yes {
                                        background: rgba(209,67,91,.10);
                                        color: #a32540;
                                        }

                                        .aa-pop-vf.no {
                                        background: rgba(107,116,130,.12);
                                        color: #4b5563;
                                        }

                                        @@media (max-width:640px) {
                                        #aaBoard .aa-grid {
                                        grid-template-columns: 1fr
                                        }
                                        }

                                        @@media (prefers-reduced-motion:reduce) {
                                        #aaBoard .aa-ac, #aaBoard .aa-disc, .aa-pop {
                                        transition: none
                                        }

                                        #aaBoard .aa-ac:hover {
                                        transform: none
                                        }
                                        }

                                        /* =====================================================================
                                        v1.0.1.0 UNIFIED BOARD -- triage layout
                                        The board's job is "what needs me next", not "here are 344 rows sorted
                                        by time". Everything below serves that: the pulse gives 344 alerts a
                                        shape, the command bar stays reachable at card 300, open work is
                                        visually louder than closed work, and a repeating asset is one problem
                                        rather than N rows.
                                        ===================================================================== */

                                        /* ---- open-now counter: the only number that means "act" ---- */
                                        #aaBoard .aa-open-now {
                                        display: inline-flex;
                                        align-items: baseline;
                                        gap: 7px;
                                        border: 1px solid rgba(220,47,74,.28);
                                        background: rgba(220,47,74,.06);
                                        border-radius: 20px;
                                        padding: 5px 13px 5px 11px;
                                        }

                                        #aaBoard .aa-open-now i {
                                        width: 7px;
                                        height: 7px;
                                        border-radius: 50%;
                                        background: var(--aa-red);
                                        align-self: center;
                                        flex: none;
                                        box-shadow: 0 0 0 0 rgba(220,47,74,.55);
                                        animation: aaBeat 2s ease-out infinite;
                                        }

                                        #aaBoard .aa-open-now b {
                                        font-size: 15px;
                                        font-weight: 800;
                                        color: var(--aa-red);
                                        }

                                        #aaBoard .aa-open-now em {
                                        font-style: normal;
                                        font-size: 10.5px;
                                        font-weight: 600;
                                        letter-spacing: .06em;
                                        text-transform: uppercase;
                                        color: #a32540;
                                        }

                                        #aaBoard .aa-open-now.calm {
                                        border-color: rgba(31,157,107,.30);
                                        background: rgba(31,157,107,.06);
                                        }

                                        #aaBoard .aa-open-now.calm i {
                                        background: var(--aa-green);
                                        animation: none;
                                        }

                                        #aaBoard .aa-open-now.calm b {
                                        color: #0b7a4d;
                                        }

                                        #aaBoard .aa-open-now.calm em {
                                        color: #0b7a4d;
                                        }

                                        @@keyframes aaBeat {
                                        0% {
                                        box-shadow: 0 0 0 0 rgba(220,47,74,.50);
                                        }

                                        70% {
                                        box-shadow: 0 0 0 7px rgba(220,47,74,0);
                                        }

                                        100% {
                                        box-shadow: 0 0 0 0 rgba(220,47,74,0);
                                        }
                                        }

                                        /* ---- SIGNATURE: AI verdict vs outcome ----
                                        v1.0.2.3: replaces the pulse. The pulse answered "when did alerts happen", which
                                        the date window and the timeline already answer twice over. This answers the one
                                        question this board exists for and nothing else on it shows: when a human and the
                                        AI both judged an alert, did they AGREE -- and when they did not, which way did it
                                        go. A false alert the AI confirmed and a true alert the AI missed are different
                                        failures with different fixes, so they are counted separately, never as one
                                        "wrong" number. */
                                        #aaBoard .aa-mx-wrap {
                                        margin: 16px 0 0;
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 12px;
                                        background: #fff;
                                        padding: 11px 14px 12px;
                                        }

                                        #aaBoard .aa-mx-hd {
                                        display: flex;
                                        align-items: baseline;
                                        flex-wrap: wrap;
                                        gap: 10px;
                                        margin-bottom: 10px;
                                        }

                                        #aaBoard .aa-mx-ttl {
                                        font-size: 11px;
                                        font-weight: 700;
                                        letter-spacing: .07em;
                                        text-transform: uppercase;
                                        color: var(--aa-muted2);
                                        }

                                        #aaBoard .aa-mx-acc {
                                        font-size: 12.5px;
                                        font-weight: 600;
                                        color: var(--aa-muted);
                                        }

                                        #aaBoard .aa-mx-acc b {
                                        font-size: 15px;
                                        font-weight: 800;
                                        color: #1f2430;
                                        letter-spacing: -.01em;
                                        }

                                        #aaBoard .aa-mx-sp {
                                        flex: 1;
                                        }

                                        #aaBoard .aa-mx-note {
                                        font-size: 10.5px;
                                        color: var(--aa-muted2);
                                        text-align: right;
                                        }

                                        #aaBoard .aa-mx-bars {
                                        display: grid;
                                        gap: 5px;
                                        }

                                        /* One row per cell of the 2x2. A BUTTON, because each row is also a filter: the whole
                                        point of seeing "3 false alerts the AI confirmed" is being able to read those three. */
                                        #aaBoard .aa-mxb {
                                        -webkit-appearance: none;
                                        appearance: none;
                                        border: 1px solid transparent;
                                        box-shadow: none;
                                        font: inherit;
                                        color: inherit;
                                        text-align: left;
                                        background: transparent;
                                        display: grid;
                                        grid-template-columns: 190px minmax(0,1fr) 42px;
                                        align-items: center;
                                        gap: 10px;
                                        padding: 3px 6px;
                                        border-radius: 8px;
                                        cursor: pointer;
                                        transition: background .12s,border-color .12s;
                                        }

                                        #aaBoard .aa-mxb:hover {
                                        background: rgba(84,87,230,.05);
                                        border-color: rgba(84,87,230,.22);
                                        }

                                        #aaBoard .aa-mxb:focus-visible {
                                        outline: 2px solid var(--aa-indigo);
                                        outline-offset: 1px;
                                        }

                                        #aaBoard .aa-mxb.on {
                                        background: rgba(84,87,230,.09);
                                        border-color: var(--aa-indigo);
                                        }

                                        /* Nothing in this bucket. Kept VISIBLE and dimmed rather than hidden: "no false
                                        alert was ever confirmed" is a result, and a row that disappears reads as a
                                        chart that is still loading. */
                                        #aaBoard .aa-mxb.zero {
                                        opacity: .5;
                                        cursor: default;
                                        }

                                        #aaBoard .aa-mxb.zero:hover {
                                        background: transparent;
                                        border-color: transparent;
                                        }

                                        #aaBoard .aa-mxb-lab {
                                        display: flex;
                                        align-items: baseline;
                                        gap: 6px;
                                        min-width: 0;
                                        font-size: 11.5px;
                                        }

                                        #aaBoard .aa-mxb-lab b {
                                        font-weight: 700;
                                        color: #2b3240;
                                        white-space: nowrap;
                                        }

                                        #aaBoard .aa-mxb-lab span {
                                        color: var(--aa-muted2);
                                        white-space: nowrap;
                                        overflow: hidden;
                                        text-overflow: ellipsis;
                                        }

                                        #aaBoard .aa-mxb-track {
                                        height: 15px;
                                        border-radius: 4px;
                                        background: #f1f3f7;
                                        overflow: hidden;
                                        min-width: 0;
                                        }

                                        #aaBoard .aa-mxb-fill {
                                        /* display:block is LOAD-BEARING. This is a <span> inside the track, and unlike
                                        the track (a grid item, which the browser blockifies for us) nothing here
                                        blockifies it -- left inline, width and height are ignored outright and every
                                        bar renders as an empty groove. */
                                        display: block;
                                        height: 100%;
                                        border-radius: 4px;
                                        min-width: 2px;
                                        transition: width .22s ease-out;
                                        }

                                        /* Agreement is green; the two disagreements are NOT the same colour, because
                                        they are not the same problem. Amber = the AI missed a real alert. Red = the
                                        AI backed an alert the outcome says was false. */
                                        #aaBoard .aa-mxb.ok   .aa-mxb-fill { background: var(--aa-green); }
                                        #aaBoard .aa-mxb.ok2  .aa-mxb-fill { background: rgba(23,151,106,.5); }
                                        #aaBoard .aa-mxb.miss .aa-mxb-fill { background: var(--aa-amber,#d99616); }
                                        #aaBoard .aa-mxb.fp   .aa-mxb-fill { background: var(--aa-red); }

                                        #aaBoard .aa-mxb-n {
                                        font-family: var(--aa-mono);
                                        font-size: 12px;
                                        font-weight: 700;
                                        text-align: right;
                                        color: #1f2430;
                                        }

                                        #aaBoard .aa-mx-empty {
                                        font-size: 12px;
                                        color: var(--aa-muted2);
                                        padding: 10px 2px 4px;
                                        }

                                        /* v1.0.2.4: OUTCOME / CAUSE CODE toggle. A segmented control, not a dropdown --
                                        there are two options and a dropdown would hide one of them behind a click. */
                                        #aaBoard .aa-mx-seg {
                                        display: inline-flex;
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 7px;
                                        overflow: hidden;
                                        background: #f6f7f9;
                                        }

                                        #aaBoard .aa-mx-sgb {
                                        -webkit-appearance: none;
                                        appearance: none;
                                        border: 0;
                                        box-shadow: none;
                                        background: transparent;
                                        font: inherit;
                                        font-size: 10.5px;
                                        font-weight: 700;
                                        letter-spacing: .03em;
                                        color: var(--aa-muted);
                                        padding: 3px 10px;
                                        cursor: pointer;
                                        transition: background .12s,color .12s;
                                        }

                                        #aaBoard .aa-mx-sgb:hover {
                                        color: #1f2430;
                                        }

                                        #aaBoard .aa-mx-sgb.on {
                                        background: #fff;
                                        color: var(--aa-indigo);
                                        box-shadow: 0 1px 2px rgba(16,20,29,.1);
                                        }

                                        #aaBoard .aa-mx-sgb:focus-visible {
                                        outline: 2px solid var(--aa-indigo);
                                        outline-offset: -2px;
                                        }

                                        /* ---- cause-code rows ----
                                        Bar LENGTH is volume (scored alerts for that cause), the SEGMENTS are the outcome
                                        split. Two encodings on one row because a short all-red bar and a long mostly-green
                                        one are different problems, and a single number cannot tell them apart. */
                                        #aaBoard .aa-mxc {
                                        -webkit-appearance: none;
                                        appearance: none;
                                        border: 1px solid transparent;
                                        box-shadow: none;
                                        font: inherit;
                                        color: inherit;
                                        text-align: left;
                                        background: transparent;
                                        display: grid;
                                        grid-template-columns: 150px minmax(0,1fr) 62px;
                                        align-items: center;
                                        gap: 10px;
                                        padding: 3px 6px;
                                        border-radius: 8px;
                                        cursor: pointer;
                                        transition: background .12s,border-color .12s;
                                        }

                                        #aaBoard .aa-mxc:hover {
                                        background: rgba(84,87,230,.05);
                                        border-color: rgba(84,87,230,.22);
                                        }

                                        #aaBoard .aa-mxc:focus-visible {
                                        outline: 2px solid var(--aa-indigo);
                                        outline-offset: 1px;
                                        }

                                        #aaBoard .aa-mxc.on {
                                        background: rgba(84,87,230,.09);
                                        border-color: var(--aa-indigo);
                                        }

                                        #aaBoard .aa-mxc-code {
                                        font-size: 11.5px;
                                        font-weight: 700;
                                        color: #2b3240;
                                        white-space: nowrap;
                                        overflow: hidden;
                                        text-overflow: ellipsis;
                                        min-width: 0;
                                        }

                                        /* The track IS the bar here -- its width is the volume, so there is no empty groove
                                        behind it. display:flex both blockifies it (it is a span) and lays the segments out. */
                                        #aaBoard .aa-mxc-track {
                                        display: flex;
                                        height: 15px;
                                        border-radius: 4px;
                                        overflow: hidden;
                                        background: #f1f3f7;
                                        min-width: 2px;
                                        transition: width .22s ease-out;
                                        }

                                        #aaBoard .aa-mxc-seg {
                                        display: block;
                                        height: 100%;
                                        min-width: 2px;
                                        }

                                        #aaBoard .aa-mxc-seg.ok   { background: var(--aa-green); }
                                        #aaBoard .aa-mxc-seg.ok2  { background: rgba(23,151,106,.5); }
                                        #aaBoard .aa-mxc-seg.miss { background: var(--aa-amber,#d99616); }
                                        #aaBoard .aa-mxc-seg.fp   { background: var(--aa-red); }

                                        #aaBoard .aa-mxc-n {
                                        display: flex;
                                        align-items: baseline;
                                        justify-content: flex-end;
                                        gap: 5px;
                                        font-family: var(--aa-mono);
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #1f2430;
                                        }

                                        #aaBoard .aa-mxc-n i {
                                        font-style: normal;
                                        font-size: 10px;
                                        font-weight: 700;
                                        padding: 1px 5px;
                                        border-radius: 4px;
                                        }

                                        /* The disagreement count, carried on every row. Zero is shown in green rather
                                        than hidden: "this cause never disagreed" is the answer you came for. */
                                        #aaBoard .aa-mxc-n i.bad  { background: rgba(220,47,74,.13); color: #a3272c; }
                                        #aaBoard .aa-mxc-n i.good { background: rgba(23,151,106,.13); color: #0b7a4d; }


                                        /* v1.0.2.5: the DAY rows are read-only. The board has no day filter -- the date
                                        window is a server reload, not a client filter -- so these must not look pressable
                                        or they promise something that cannot happen. Same geometry as a cause row, none
                                        of the affordances. */
                                        #aaBoard .aa-mxc.as-row {
                                        cursor: default;
                                        }

                                        #aaBoard .aa-mxc.as-row:hover {
                                        background: transparent;
                                        border-color: transparent;
                                        }

                                        #aaBoard .aa-mx-more {
                                        font-size: 10.5px;
                                        color: var(--aa-muted2);
                                        padding: 5px 6px 0;
                                        }

                                        /* Only drawn in cause view, where the colours became segments and stopped labelling
                                        themselves. */
                                        #aaBoard .aa-mx-legend:empty {
                                        display: none;
                                        }

                                        #aaBoard .aa-mx-legend {
                                        display: flex;
                                        flex-wrap: wrap;
                                        gap: 4px 14px;
                                        margin-top: 9px;
                                        padding-top: 8px;
                                        border-top: 1px solid var(--aa-hair2);
                                        }

                                        #aaBoard .aa-mx-lg {
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 5px;
                                        font-size: 10.5px;
                                        color: var(--aa-muted);
                                        }

                                        #aaBoard .aa-mx-lg i {
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 3px;
                                        flex: none;
                                        }

                                        #aaBoard .aa-mx-lg i.ok   { background: var(--aa-green); }
                                        #aaBoard .aa-mx-lg i.ok2  { background: rgba(23,151,106,.5); }
                                        #aaBoard .aa-mx-lg i.miss { background: var(--aa-amber,#d99616); }
                                        #aaBoard .aa-mx-lg i.fp   { background: var(--aa-red); }

                                        /* ---- v1.0.3.4: DAY VIEW, cause codes under each day ----------------------
                                        The bar said a day went badly and never said what went badly. These chips do,
                                        and they are the filter surface the day bar deliberately is not: a cause filter
                                        exists on this board, a day filter does not. */
                                        #aaBoard .aa-mxd {
                                        padding: 2px 0 6px;
                                        border-bottom: 1px solid var(--aa-hair2);
                                        }

                                        #aaBoard .aa-mxd:last-child { border-bottom: 0; }

                                        /* Indented to the width of the day label, so the chips read as belonging to the
                                        row above rather than as a list of their own. */
                                        #aaBoard .aa-mxd-cc {
                                        display: flex;
                                        flex-wrap: wrap;
                                        gap: 3px;
                                        padding: 3px 0 0 106px;
                                        }

                                        #aaBoard .aa-mxd-c {
                                        display: inline-flex;
                                        align-items: center;
                                        gap: 5px;
                                        max-width: 100%;
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 5px;
                                        background: var(--aa-surface, #fff);
                                        padding: 2px 6px;
                                        font: 600 10.5px/1.25 var(--aa-mono);
                                        color: var(--aa-muted);
                                        cursor: pointer;
                                        overflow: hidden;
                                        text-overflow: ellipsis;
                                        white-space: nowrap;
                                        transition: border-color .12s, color .12s, background .12s;
                                        }

                                        #aaBoard .aa-mxd-c:hover {
                                        border-color: var(--aa-indigo);
                                        color: var(--aa-indigo-ink, #3f42c9);
                                        }

                                        #aaBoard .aa-mxd-c.on {
                                        border-color: var(--aa-indigo);
                                        background: var(--aa-indigo-wash, #eef1fd);
                                        color: var(--aa-indigo-ink, #3f42c9);
                                        }

                                        /* the day's count for this code */
                                        #aaBoard .aa-mxd-c b {
                                        font-weight: 800;
                                        color: var(--aa-ink);
                                        }

                                        /* how many of them the AI got wrong. Only rendered when there are any, so it
                                        never prints a zero on every chip of a clean day. */
                                        #aaBoard .aa-mxd-c i {
                                        font-style: normal;
                                        font-weight: 800;
                                        font-size: 9px;
                                        color: #fff;
                                        background: var(--aa-red);
                                        border-radius: 20px;
                                        padding: 1px 5px;
                                        }

                                        #aaBoard .aa-mxd-c.bad { border-color: #f2cdd5; }

                                        @@media (max-width: 720px) {
                                        #aaBoard .aa-mxd-cc { padding-left: 0; }
                                        }

                                        /* ---- sticky command bar ---- */
                                        #aaBoard .aa-cmd {
                                        position: sticky;
                                        top: 0;
                                        z-index: 40;
                                        margin: 14px 0 0;
                                        background: rgba(246,248,250,.94);
                                        backdrop-filter: saturate(180%) blur(8px);
                                        -webkit-backdrop-filter: saturate(180%) blur(8px);
                                        border: 1px solid var(--aa-hair);
                                        border-radius: 12px;
                                        padding: 9px 12px;
                                        }

                                        #aaBoard .aa-cmd.stuck {
                                        border-radius: 0 0 12px 12px;
                                        box-shadow: 0 6px 18px rgba(20,24,31,.10);
                                        }

                                        #aaBoard .aa-cmd-row {
                                        display: flex;
                                        align-items: center;
                                        gap: 8px;
                                        flex-wrap: wrap;
                                        }

                                        #aaBoard .aa-cmd-row.sub {
