                                        function fnAaRenderRail() {
                                        var maxF = 1;   // v1.0.55.62: max SITE failure (per design) -- the worst site reads ~100%
                                        for (var j = 0; j < AA_SITES.length; j++) { if (AA_SITES[j].f > maxF) { maxF = AA_SITES[j].f; } }
                                        // v1.0.55.82: ALL SITES needs its own OPEN totals, or the summary tile would keep the old
                                        // window-count behaviour while every site tile beside it reported live status.
                                        var allOF = 0, allOP = 0;
                                        for (var z = 0; z < AA_SITES.length; z++) { allOF += (AA_SITES[z].of || 0); allOP += (AA_SITES[z].op || 0); }
                                        var h = aaSiteCard(null, 'ALL SITES', '', AA_TOTF, AA_TOTP, maxF, allOF, allOP);
                                        for (var i = 0; i < AA_SITES.length; i++) {
                                        var s = AA_SITES[i];
                                        h += aaSiteCard(s.name, s.name, 'SITE ' + s.siteId, s.f, s.p, maxF, s.of, s.op);
                                        }
                                        $('#aaRail').html(h);
                                        }
                                        function aaSiteCard(key, name, code, f, p, maxF, of, op) {
                                        var on = (aaState.site === key) ? ' on' : '';
                                        var kArg = key ? "'" + key.replace(/'/g, "\\'") + "'" : 'null';
                                        var isAll = !key;
                                        of = of || 0; op = op || 0;
                                        // v1.0.55.82: the pill answers "what is wrong NOW", so it reads OPEN alerts only. It sits
                                        // beside a LIVE dot; computing it from a 7-day failure COUNT meant a site whose every alert
                                        // had cleared still read ATTENTION, which is a history statistic wearing a live label.
                                        var FCRIT = 3;    // open failures at/above which a site reads CRITICAL rather than ATTENTION
                                        var status, cls, bc, pct;
                                        if (of === 0 && op === 0) { status = 'OPERATIONAL'; cls = 'ok'; bc = 'var(--aa-green)'; pct = (f + p > 0 ? 10 : 5); }
                                        else if (of >= FCRIT) { status = 'CRITICAL'; cls = 'crit'; bc = 'var(--aa-red)'; pct = Math.max(60, Math.min(100, Math.round(100 * of / Math.max(1, FCRIT * 2)))); }
                                        else if (of > 0) { status = 'ATTENTION'; cls = 'warn'; bc = 'var(--aa-amber)'; pct = Math.max(30, Math.min(58, Math.round(100 * of / Math.max(1, FCRIT)))); }
                                        else { status = 'ATTENTION'; cls = 'warn'; bc = 'var(--aa-amber)'; pct = Math.max(15, Math.min(40, Math.round(100 * op / Math.max(1, FCRIT * 2)))); }
                                        // An unexplained status is a status nobody trusts -- say what is driving it.
                                        var why = (of + op) === 0 ? 'nothing open'
                                        : ((of ? of + ' open failure' + (of > 1 ? 's' : '') : '')
                                        + (of && op ? ' , ' : '')
                                        + (op ? op + ' open predictive' : ''));
                                        var icon = isAll ? AA_ICON_GRID : AA_ICON_SITE;
                                        return '<button class="aa-site-card' + on + (isAll ? ' all' : '') + '" onclick="fnAaSetSite(' + kArg + ')">' +
                                        '<div class="aa-sc-top"><span class="aa-sc-idi">' + icon + '</span>' +
                                        '<span class="aa-sc-name">' + escapeHtml(name) + '</span>' +
                                        (code ? '<span class="aa-sc-code">' + escapeHtml(code) + '</span>' : '') + '</div>' +
                                        '<span class="aa-sc-pill ' + cls + '"><i></i>' + status + '</span>' +
                                        '<span class="aa-sc-why">' + escapeHtml(why) + '</span>' +
                                        '<div class="aa-sc-stats">' +
                                        '<span class="aa-sc-stat f' + (f ? '' : ' z') + '"><b>' + f + '</b><em>Failure</em></span>' +
                                        '<span class="aa-sc-stat p' + (p ? '' : ' z') + '"><b>' + p + '</b><em>Predictive</em></span>' +
                                        '</div>' +
                                        '<div class="aa-sc-foot"><span class="aa-sc-live"><i></i>LIVE</span><span>' + (f + p) + ' alerts</span></div>' +
                                        '<div class="aa-sc-bar"><i style="width:' + pct + '%;background:' + bc + '"></i></div>' +
                                        '</button>';
                                        }
                                        function fnAaRenderSeg() {
                                        var h = aaSeg(null, 'All', AA_INRANGE.length) + aaSeg('Failure', 'Failure', AA_TOTF) + aaSeg('Predictive', 'Predictive', AA_TOTP);
                                        $('#aaSegType').html(h);
                                        }
                                        function aaSeg(key, label, n) {
                                        var on = (aaState.type === key) ? ' class="on"' : '';
                                        var kArg = key ? "'" + key + "'" : 'null';
                                        return '<button' + on + ' onclick="fnAaSetType(' + kArg + ')">' + label + '<b>' + n + '</b></button>';
                                        }
                                        // v1.0.55.64: fnAaRenderChips (cause-by-asset lanes) REMOVED with its markup. The asset-type
                                        // segment above filters the same data; the lanes repeated it down a full screen. fnAaSetCause /
                                        // fnAaSetClass are kept -- they are one-liners that Clear-filters state still resets -- and the
                                        // .aa-lane / .aa-chip / .aa-chips-cap-row rules are left inert so the block can be restored.
                                        // v1.0.55.69 (SL 18 / G3): stored-verdict state per alert id. Display only -- this NEVER causes
                                        // an analysis to run. An absent entry renders "not analysed" explicitly, because a blank cell
                                        // reads as "nothing wrong", which is the opposite of what it means.
                                        var AA_VSTATE = {};

                                        // v1.0.2.8: false until the batched analysis read has ANSWERED. While it is false no
                                        // row is called unanalysed and nothing is greyed out. Set only from fnAaLoadRatings,
                                        // never from fnAaLoadVerdictStates: that call sends at most 200 ids, so on a longer
                                        // window it returns a confident-looking blank for rows it was never asked about.
                                        // If AlertRatings fails it stays false forever -- Detail then stays clickable on
                                        // every row, which is the right way round to be wrong.
                                        var AA_ANALYSIS_READY = false;

                                        // The chips below are called with a bare id from every current call site. Taking the
                                        // row object as well means a future call site can pass one and skip the scan, and a
                                        // missed one degrades to a lookup rather than throwing.
                                        function aaRowArg(x) {
                                        if (x && typeof x === 'object') { return x; }
                                        return aaRowById(Number(x));
                                        }

                                        // ANALYSED means "a run exists", and TWO independent reads can say so:
                                        //   AA_VSTATE  from AiChat/VerdictStates -- keyed by BARE id, capped at 200 ids
                                        //   AA_RATING  from AlertRatings, read through aaCanRate -- keyed 'F:'/'P:' + id
                                        // The union is deliberate, not belt-and-braces. VerdictStates still truncates at 200
                                        // the way ratings did before 1.0.1.9, so past that point "no entry" carries no
                                        // information at all -- and aaCanRate is the same map the rating chip and the
                                        // validity switch already trust, so Detail cannot end up dead on a row where those
                                        // two are live. That inconsistency would look like the board, not like a cap.
                                        function aaAnalysed(a, id) {
                                        var st = AA_VSTATE[String(id)];
                                        if (st === 'valid' || st === 'outdated') { return true; }
                                        return !!(a && aaCanRate(a));
                                        }

                                        function aaVerdictStateCell(x) {
                                        var a = aaRowArg(x);
                                        var id = a ? a.id : x;
                                        var st = AA_VSTATE[String(id)];
                                        if (st === 'valid') {
                                        return '<span class="aa-vs ok" title="ANALYSED&#10;A stored ENERGY7 Insight analysis is available. Press Detail to read it.">AI</span>';
                                        }
                                        if (st === 'outdated') {
                                        return '<span class="aa-vs old" title="ANALYSED, BUT SUPERSEDED&#10;An analysis is stored and is no longer current. Press Detail to read it, or INSIGHT to run a fresh one.">AI</span>';
                                        }
                                        // Past the VerdictStates cap the freshness is unknown but the RUN is not -- say
                                        // analysed and say nothing about how current it is, rather than claiming either.
                                        if (a && aaCanRate(a)) {
                                        return '<span class="aa-vs ok" title="ANALYSED&#10;An analysis run is recorded for this alert. Press Detail to read it.">AI</span>';
                                        }
                                        if (!AA_ANALYSIS_READY) {
                                        return '<span class="aa-vs wait" title="Checking whether this alert has been analysed\u2026">&hellip;</span>';
                                        }
                                        return '<span class="aa-vs none" tabindex="0" role="img"'
                                        + ' aria-label="Not analysed. ENERGY7 Insight has never been run on this alert."'
                                        + ' title="NOT ANALYSED&#10;ENERGY7 Insight has never been run on this alert, so there is nothing to open, rate or mark.&#10;Press INSIGHT on this row to run one.">NO AI</span>';
                                        }
                                        function fnAaLoadVerdictStates(list) {
                                        try {
                                        if (!list || !list.length) { return; }
                                        var ids = [];
                                        for (var i = 0; i < list.length && ids.length < 200; i++) { ids.push(list[i].id); }
                                        if (!ids.length) { return; }
                                        $.ajax({
                                        url: '@Url.Action("VerdictStates", "AiChat")',
                                        type: 'POST', contentType: 'application/json',
                                        data: JSON.stringify({ alertIds: ids, engine: _aiProvider }),
                                        success: function (d) {
                                        if (!d || !d.ok || !d.states) { return; }
                                        AA_VSTATE = d.states;
                                        fnAaRenderTable();   // re-render with states; no further fetch (guarded below)
                                        },
                                        error: function () { /* board must render regardless */ }
                                        });
                                        } catch (e) { }
                                        }

                                        // v1.0.55.73: list presentation only. Filters, tiles and the date window are untouched.
                                        var AA_VIEW = 'cards';   // v1.0.0.0: the board opens on the unified cards
                                        function fnAaSetView(v) {
                                        AA_VIEW = (v === 'timeline' || v === 'table') ? v : 'cards';
                                        var bc = document.getElementById('aaViewCards');
                                        var bt = document.getElementById('aaViewTable'), bl = document.getElementById('aaViewTime');
                                        if (bc) { bc.className = (AA_VIEW === 'cards') ? 'on' : ''; }
                                        if (bt) { bt.className = (AA_VIEW === 'table') ? 'on' : ''; }
                                        if (bl) { bl.className = (AA_VIEW === 'timeline') ? 'on' : ''; }
                                        aaPopHide();
                                        var cw = document.getElementById('aaCardsWrap');
                                        if (cw) { cw.style.display = (AA_VIEW === 'cards') ? '' : 'none'; }
                                        // v1.0.55.79: swap CONTAINERS. A colspan cell in an auto-layout table is only as wide as its
                                        // content, and the lane positions content as a percentage of that width -- so it collapsed.
                                        var tw = document.getElementById('aaTblWrap'), lw = document.getElementById('aaTimelineWrap');
                                        if (tw) { tw.style.display = (AA_VIEW === 'table') ? '' : 'none'; }
                                        if (lw) { lw.style.display = (AA_VIEW === 'timeline') ? '' : 'none'; }
                                        fnAaRenderTable();
                                        }

                                        // Alerts at ONE site within 15 min are one EVENT, not N rows. On the sample data five JIG-1
                                        // alerts across four assets inside five minutes are five unrelated table rows and one cluster
                                        // here -- that difference is the reason this view exists.
                                        function fnAaClusterWindowMs() { return 15 * 60 * 1000; }

                                        // v1.0.55.75: one Analyze control for BOTH views. Solid and legible -- the previous chip sat at
                                        // 28% opacity and read as disabled. "ENERGY7 INSIGHT" rather than a bare "AI": it names what the
                                        // operator gets, not the technology, and matches the engine branding used elsewhere.
                                        function aaInsightBtn(id) {
                                        return '<button type="button" class="e7ins" id="e7ins-' + id + '" title="Run ENERGY7 Insight on this alert"'
                                        + ' onclick="aaInsightGo(' + id + ',event)">'
                                        + '<span class="e7ins-m">7</span><span class="e7ins-t">INSIGHT</span></button>';
                                        }
                                        // The click-to-modal gap is long enough to read as a dead button. Mark the one pressed.
                                        function aaInsightGo(id, ev) {
                                        try {
                                        if (ev && ev.stopPropagation) { ev.stopPropagation(); }
                                        var b = document.getElementById('e7ins-' + id);
                                        if (b) {
                                        b.className = 'e7ins busy';
                                        var t = b.querySelector('.e7ins-t');
                                        if (t) { t.textContent = 'WORKING'; }
                                        setTimeout(function () {
                                        var b2 = document.getElementById('e7ins-' + id);
                                        if (!b2) { return; }
                                        b2.className = 'e7ins';
                                        var t2 = b2.querySelector('.e7ins-t');
                                        if (t2) { t2.textContent = 'INSIGHT'; }
                                        }, 12000);
                                        }
                                        } catch (e) { }
                                        try { fnRowAnalyze(id); } catch (e) { }
                                        }

                                        /* ==================================================================
                                        v1.0.2.2 -- ANALYSIS DETAIL

                                        A "Detail" button on every alert, in the table and on the cards. It opens a
                                        modal listing every AI analysis run recorded for that alert -- when it was
                                        analysed, the verdict and its evidence, which engine/model produced it, who ran
                                        it, how long it took and what it cost -- read from AIAnalysis/Get?AlertId={id}
                                        via the SaveAlertValidity/AlertAnalysisDetail server proxy.

                                        This is READ-ONLY history, distinct from the star rating (a judgement of the
                                        analysis) and the validity switch (a judgement of the alert). It answers a third
                                        question -- "what did the AI actually say, and when" -- which neither of those
                                        shows, because both collapse a whole run to one number.
                                        ================================================================== */

                                        function aaDetailBtn(x) {
                                        var a = aaRowArg(x);
                                        var id = a ? a.id : x;
                                        // v1.0.2.8: an alert nobody has analysed has no history to show, so the button
                                        // is visibly unavailable and says why on hover -- the same answer the rating
                                        // chip and the validity switch already give for the same condition.
                                        //
                                        // aria-disabled and no onclick, NOT the disabled attribute. A disabled button
                                        // does not reliably raise a title tooltip, and the tooltip is the whole reason
                                        // this state exists: the operator must be able to learn why it is dead without
                                        // clicking it. It also stays in the tab order, so the explanation is reachable
                                        // from the keyboard instead of being a purely visual grey-out.
                                        var off = AA_ANALYSIS_READY && !aaAnalysed(a, id);
                                        return '<button type="button" class="aa-dbtn' + (off ? ' na' : '') + '"'
                                        + ' aria-disabled="' + (off ? 'true' : 'false') + '"'
                                        + ' title="' + (off
                                        ? 'NO ANALYSIS TO SHOW&#10;ENERGY7 Insight has never been run on this alert, so there is no analysis history to open.&#10;Press INSIGHT on this row first.'
                                        : 'Show analysis detail for this alert') + '"'
                                        + (off ? '' : ' onclick="fnAaOpenDetail(' + id + ',event)"') + '>'
                                        + '<span class="aa-dbtn-i" aria-hidden="true">&#9432;</span>'
                                        + '<span class="aa-dbtn-t">Detail</span></button>';
                                        }

                                        var AA_DET_EL = null, AA_DET_KEY = null;

                                        // Built once and reused. Appended to <body>, not inside #aaBoard: a modal drawn inside
                                        // the scrolling board would be clipped by it and would move when the board scrolled.
                                        function aaDetailEl() {
                                        if (AA_DET_EL) { return AA_DET_EL; }
                                        var wrap = document.createElement('div');
                                        wrap.id = 'aaDetailModal';
                                        wrap.className = 'aa-dm';
                                        wrap.hidden = true;
                                        wrap.innerHTML =
                                        '<div class="aa-dm-bd" onclick="fnAaCloseDetail()"></div>'
                                        + '<div class="aa-dm-panel" role="dialog" aria-modal="true" aria-label="Analysis detail">'
                                        + '  <div class="aa-dm-hd">'
                                        + '    <div class="aa-dm-ttl" id="aaDetTtl">Analysis detail</div>'
                                        + '    <button type="button" class="aa-dm-x" title="Close" aria-label="Close" onclick="fnAaCloseDetail()">&times;</button>'
                                        + '  </div>'
                                        + '  <div class="aa-dm-body" id="aaDetBody"></div>'
                                        + '</div>';
                                        document.body.appendChild(wrap);
                                        AA_DET_EL = wrap;
                                        return wrap;
                                        }

                                        function fnAaCloseDetail() {
                                        if (AA_DET_EL) { AA_DET_EL.hidden = true; }
                                        AA_DET_KEY = null;
                                        }

                                        function fnAaOpenDetail(id, ev) {
                                        if (ev) { if (ev.stopPropagation) { ev.stopPropagation(); } if (ev.preventDefault) { ev.preventDefault(); } }
                                        var a = aaRowById(Number(id));
                                        var el = aaDetailEl();
                                        el.hidden = false;

                                        var ttl = document.getElementById('aaDetTtl');
                                        var body = document.getElementById('aaDetBody');
                                        // The alert's own identity in the header, so the modal says WHICH alert without
                                        // the operator having to remember which row they clicked.
                                        if (ttl) {
                                        ttl.innerHTML = a
                                        ? (escapeHtml(a.asset || 'Alert') + ' <span class="aa-dm-sub">'
                                        + escapeHtml(a.code || '') + (a.station ? (' · ' + escapeHtml(a.station)) : '')
                                        + ' · #' + id + '</span>')
                                        : ('Alert #' + id);
                                        }
                                        if (body) { body.innerHTML = '<div class="aa-dm-load">Loading analysis history…</div>'; }

                                        AA_DET_KEY = String(id);

                                        /* v1.0.2.0: SAY WHICH ID SPACE THIS IS, AND HAND OVER THE OTHER ID.
                                        An alert that was discarded and later approved has its pre-approval analyses
                                        stored under its PendingAlertApproval id and anything since under its FRSAlert
                                        id. Asking for one id returned half the history -- and where the analysis was
                                        what informed the approval and nobody re-ran it afterwards, none of it: the
                                        panel said "no analysis has been run" over an alert that had been analysed.

                                        `source` is not optional in spirit. The server refuses to guess which table an
                                        id belongs to, because the sequences overlap and a wrong guess would attach a
                                        different alert's analyses to this panel. `linkedId` is the id the board
                                        already holds on the row; the server prefers its own lookup and falls back to
                                        this, so the merge still happens on a host that cannot reach the database. */
                                        /* Sent EMPTY when the row is not in hand, never guessed. The board is the only
                                        thing that knows which table this id came from; with no row there is nothing to
                                        know it from, and 'pending' as a default would tell the server to read a
                                        PendingAlertApproval id that may be an FRSAlert id. The server then resolves it
                                        itself and merges only if the answer is unambiguous, which is the right
                                        behaviour for a caller that genuinely cannot say. */
                                        var _dSrc = a ? ((aaDecision(a).k === 'A') ? 'frs' : 'pending') : '';
                                        var _dLink = 0;
                                        if (a) {
                                        _dLink = (_dSrc === 'frs')
                                        ? Number(a.pendingAlertApprovalId || 0)
                                        : Number(a.frsAlertId || 0);
                                        }
                                        $.ajax({
                                        url: '@Url.Action("AlertAnalysisDetail", "UnifiedAlertAnalysis")',
                                        type: 'GET',
                                        data: { alertId: id, source: _dSrc, linkedId: _dLink },
                                        success: function (d) {
                                        // A slow response can land after the operator has opened a DIFFERENT alert;
                                        // drop it rather than overwrite the panel they are now looking at.
                                        if (AA_DET_KEY !== String(id)) { return; }
                                        var body2 = document.getElementById('aaDetBody');
                                        if (!body2) { return; }
                                        if (!d || !d.ok) {
                                        body2.innerHTML = '<div class="aa-dm-err">'
                                        + escapeHtml((d && d.error) ? d.error : 'Could not load analysis.') + '</div>';
                                        return;
                                        }
                                        if (!d.analyses || !d.analyses.length) {
                                        /* v1.0.2.0: "nothing was ever run" and "we could not ask" are different
                                        facts, and only the first one should send an operator off to run Insight.
                                        Before the merge this panel asked one id and any failure came back as an
                                        error box; now a partial failure can leave an EMPTY list, and saying "no
                                        analysis has been run" there would be a statement the panel cannot support. */
                                        var _unread = (d.unreachableIds && d.unreachableIds.length) ? d.unreachableIds : [];
                                        body2.innerHTML = _unread.length
                                        ? ('<div class="aa-dm-err">The analysis service did not answer for alert id '
                                        + escapeHtml(_unread.join(', ')) + ', so whether this alert has been analysed '
                                        + 'is not known. Close and reopen to try again.</div>')
                                        : ('<div class="aa-dm-empty">No analysis has been run on this alert yet'
                                        + ((d.linkedAlertIds && d.linkedAlertIds.length)
                                        ? ', under either the id it carries now or the one it had while in review'
                                        : '')
                                        + '. Run Insight to create one.</div>');
                                        return;
                                        }
                                        body2.innerHTML = aaDetailRender(d);
                                        },
                                        error: function (xhr) {
                                        if (AA_DET_KEY !== String(id)) { return; }
                                        var body2 = document.getElementById('aaDetBody');
                                        if (body2) {
                                        body2.innerHTML = '<div class="aa-dm-err">Could not load analysis (HTTP '
                                        + (xhr ? xhr.status : 0) + ').</div>';
                                        }
                                        }
                                        });
                                        }

                                        /* ==================================================================
                                        v1.0.2.0 -- THE PANEL SAYS WHEN IN THE ALERT'S LIFE EACH RUN WAS MADE.

                                        An alert that was reviewed, discarded and later approved was analysed under two
                                        different ids, and the controller now merges both. That merge is invisible
                                        unless the panel says so, and invisible is the wrong answer here: a verdict
                                        reached while the alert was still in review was reached without the approval,
                                        usually without the maintainer's remark, and sometimes before the alert had
                                        even reset. A later run saw all three. Presented as one undated list, two
                                        verdicts that disagree for that reason read as the model contradicting itself.

                                        So: a banner naming the split, and a stage chip on each run -- but ONLY on an
                                        alert that actually has both. Adding "AFTER APPROVAL" to every run of an alert
                                        that never went through review is a label with no alternative, which is noise.
                                        ================================================================== */
                                        var AA_DET_MIX = false;

                                        function aaDetStageChip(x) {
                                        if (!AA_DET_MIX || !x || !x.stage) { return ''; }
                                        var pend = (String(x.stage) === 'pending');
                                        var tip = pend
                                        ? 'RUN MADE WHILE THE ALERT WAS IN REVIEW&#10;Recorded against the pending-approval record, before this alert was approved. It was judged without the approval decision, and possibly before the alert reset or the maintainer commented.'
                                        : 'RUN MADE AFTER APPROVAL&#10;Recorded against the approved alert record.';
                                        return '<span class="aa-dt-stg ' + (pend ? 'pend' : 'appr') + '" title="' + tip + '">'
                                        + (pend ? 'IN REVIEW' : 'AFTER APPROVAL') + '</span>';
                                        }

                                        /* The banner. Three things can be true and each changes what the list below
                                        means, so each is stated rather than summarised away:
                                        - the history spans both stages (the case this was built for);
                                        - the whole history predates the approval -- worth saying plainly, because the
                                        panel is then showing runs made about an alert nobody had approved yet;
                                        - part of the history could not be read. A partial list presented as the whole
                                        record is the one outcome here that could mislead someone into a decision. */
                                        function aaDetMergeHtml(d) {
                                        var np = Number(d.pendingStageCount || 0), na = Number(d.approvedStageCount || 0);
                                        var linked = (d.linkedAlertIds && d.linkedAlertIds.length) ? d.linkedAlertIds : [];
                                        var unreachable = (d.unreachableIds && d.unreachableIds.length) ? d.unreachableIds : [];
                                        var out = '';

                                        if (unreachable.length) {
                                        out += '<div class="aa-dt-merge warn"><span class="aa-dt-mi">&#9888;</span><span>'
                                        + '<b>This is part of the history, not all of it.</b> The analysis service did not '
                                        + 'answer for alert id ' + escapeHtml(unreachable.join(', ')) + ', so any run stored '
                                        + 'under that id is missing here. Close and reopen to try again.'
                                        + '</span></div>';
                                        }

                                        if (np > 0 && na > 0) {
                                        out += '<div class="aa-dt-merge"><span class="aa-dt-mi">&#8646;</span><span>'
                                        + '<b>This alert was analysed both before and after it was approved.</b> '
                                        + np + ' run' + (np === 1 ? '' : 's') + ' while it was in review'
                                        + (linked.length ? (' (id ' + escapeHtml(String(linked.join(', '))) + ')') : '')
                                        + ' and ' + na + ' after approval (id ' + escapeHtml(String(d.alertId)) + '). '
                                        + 'They are listed together, newest first, and each is marked with the stage it '
                                        + 'was made in &mdash; a run made in review did not see the approval decision.'
                                        + '</span></div>';
                                        }
                                        else if (np > 0 && na === 0 && String(d.stage) === 'approved') {
                                        out += '<div class="aa-dt-merge"><span class="aa-dt-mi">&#8646;</span><span>'
                                        + '<b>Every analysis here was made while the alert was still in review</b>'
                                        + (linked.length ? (' (id ' + escapeHtml(String(linked.join(', '))) + ')') : '')
                                        + '. Nothing has been analysed since it was approved, so no run has seen the '
                                        + 'approval decision or anything recorded with it. Press INSIGHT to analyse it as it stands now.'
                                        + '</span></div>';
                                        }

                                        return out;
                                        }

                                        // verdict word -> a colour class. Kept small: the API's verdict vocabulary is
                                        // CONFIRMED / REJECTED / INCONCLUSIVE and anything else falls to neutral rather than
                                        // being coloured by guesswork.
                                        function aaDetVerdictClass(v) {
                                        var s = String(v || '').toUpperCase();
                                        if (s.indexOf('CONFIRM') >= 0) { return 'ok'; }
                                        if (s.indexOf('REJECT') >= 0 || s.indexOf('FALSE') >= 0 || s.indexOf('NOT') >= 0) { return 'no'; }
                                        if (s.indexOf('INCON') >= 0 || s.indexOf('UNCERT') >= 0) { return 'warn'; }
                                        return 'neut';
                                        }

                                        /* ==================================================================
                                        v1.0.3.3 -- THE DETAIL PANEL SHOWS THE CASE, NOT THE BUILD.

                                        It used to render one full card per analysis row and finish each with eleven
                                        lines of build metadata -- engine, provider, model, turns, tokens, est. cost,
                                        model time, verification tier, server node, controller version. On a real alert
                                        that is six identical cards and sixty-six lines of it, and not one of those
                                        lines changes what an operator does. They are gone, and gone at the PROJECTION
                                        (controller 1.0.1.4) so the model names never reach the browser at all.

                                        MOST ROWS ARE NOT ANALYSES. A row with served_from_cache is a REPLAY of an
                                        earlier verdict -- no model call, no new evidence, the same text. On the sample
                                        alert four of the six rows are replays. Rendering six equal cards told the
                                        reader this alert had been analysed six times, which is false. The panel now
                                        leads with the newest REAL analysis in full and puts every run, replays
                                        included, in one compact strip underneath.

                                        WHEN TWO REAL ANALYSES DISAGREE, SAY SO. The sample alert has a NOT_CONFIRMED
                                        ("transient, no action") and a later CONFIRMED ("Field HW, inspect the
                                        circuit"). Showing the newest and hiding the other would bury a reversal;
                                        showing both silently leaves the operator to pick. The banner names the split,
                                        and where the earlier run was made before the alert reset -- which is the case
                                        here, and is visible in the payload as a run whose input carried no reset -- it
                                        says that too, because that is the whole explanation for the disagreement.
                                        ================================================================== */
                                        function aaDetailRender(d) {
                                        var list = (d && d.analyses) ? d.analyses : [];
                                        if (!list.length) { return ''; }

                                        // A replay is not an analysis. Split them before anything is counted.
                                        var real = [], replays = 0;
                                        for (var i = 0; i < list.length; i++) {
                                        if (list[i].servedFromCache) { replays++; } else { real.push(list[i]); }
                                        }
                                        // The controller sorts newest first, so [0] is the most recent of each kind.
                                        var lead = real.length ? real[0] : list[0];

                                        /* v1.0.2.0: set for THIS render, read by the stage chips below. The chips are
                                        drawn only when the panel actually holds both stages -- on an alert that never
                                        went through review every run carries the same stage and a badge repeating it
                                        on every card would be noise the reader has to learn to ignore. */
                                        AA_DET_MIX = (Number(d.pendingStageCount || 0) > 0 && Number(d.approvedStageCount || 0) > 0);

                                        var h = '<div class="aa-dt-summary">'
                                        + '<b>' + real.length + '</b> analys' + (real.length === 1 ? 'is' : 'es')
                                        + (replays ? (' <span class="aa-dt-sub">&middot; ' + replays + ' reuse'
                                        + (replays === 1 ? '' : 's') + ' of a stored verdict</span>') : '')
                                        + (d.truncated ? ' <span class="aa-dt-trunc">(most recent 100)</span>' : '')
                                        + '</div>';

                                        h += aaDetMergeHtml(d);
                                        h += aaDetDisagreeHtml(real);
                                        h += aaDetLeadHtml(lead, d.alertId);
                                        h += aaDetRunsHtml(list, lead);
                                        return h;
                                        }

                                        /* v1.0.3.4 -- THE ASSET'S ALERTS BY DATE.

                                        asset_history carries a 30-day TOTAL and a per-cause split and no dates at all,
                                        so "9 alerts" could be nine in one afternoon or nine spread over a month, and
                                        those are opposite findings. The dates are not in the payload, but the board
                                        already holds every alert in its own window -- so they are derived from
                                        AA_ALERTS and labelled as THE BOARD'S WINDOW, never merged into the 30-day
                                        figure above them. Two different windows on one panel have to say which is
                                        which or the smaller one reads as a correction of the larger.

                                        MATCHED ON ASSET **AND** STATION. Asset names are only unique within a station
                                        -- there is a PT-1 at most of them -- so matching on name alone would fold every
                                        station's PT-1 into this asset's history and inflate every count on the strip. */
                                        function aaDetDatesHtml(alertId) {
                                        var self = aaRowById(Number(alertId));
                                        if (!self || typeof AA_ALERTS === 'undefined' || !AA_ALERTS.length) { return ''; }
                                        var mine = String(self.code || '').trim();
                                        var by = {}, order = [], total = 0;
                                        for (var i = 0; i < AA_ALERTS.length; i++) {
                                        var a = AA_ALERTS[i];
                                        if (a.asset !== self.asset || a.station !== self.station) { continue; }
                                        var key = aaDayLabel(a) || 'Undated';
                                        if (!by[key]) { by[key] = { day: key, n: 0, same: 0, fail: 0, sort: '' }; order.push(key); }
                                        var r = by[key];
                                        r.n++; total++;
                                        if (String(a.code || '').trim() === mine) { r.same++; }
                                        if (a.type === 'Failure') { r.fail++; }
                                        var ts = String(a.timeSort || '');
                                        if (ts && (!r.sort || ts < r.sort)) { r.sort = ts; }
                                        }
                                        if (order.length < 1) { return ''; }

                                        var rows = [];
                                        for (var o = 0; o < order.length; o++) { rows.push(by[order[o]]); }
                                        rows.sort(function (x, y) { return (y.sort > x.sort) ? 1 : ((y.sort < x.sort) ? -1 : 0); });
                                        var max = 1;
                                        for (var m = 0; m < rows.length; m++) { if (rows[m].n > max) { max = rows[m].n; } }

                                        var h = '<div class="aa-dt-dates"><div class="aa-dt-dh">By date'
                                        + '<span class="aa-dt-dhn">' + total + ' on this asset across '
                                        + rows.length + ' date' + (rows.length === 1 ? '' : 's')
                                        + ', in the board’s current window</span></div>';
                                        for (var r2 = 0; r2 < rows.length; r2++) {
                                        var c = rows[r2];
                                        var tip = c.day + ' — ' + c.n + ' alert' + (c.n === 1 ? '' : 's') + ' on '
                                        + (self.asset || 'this asset')
                                        + (c.same ? (', ' + c.same + ' on this same cause code') : ', none on this cause code')
                                        + (c.fail ? ('. ' + c.fail + ' failure' + (c.fail === 1 ? '' : 's')) : '') + '.';
                                        h += '<div class="aa-dt-drow" title="' + escapeHtml(tip) + '">'
                                        + '<span class="aa-dt-dd">' + escapeHtml(c.day) + '</span>'
                                        + '<span class="aa-dt-dbar"><i style="width:' + Math.round((c.n / max) * 100) + '%"'
                                        + (c.same ? ' class="same"' : '') + '></i></span>'
                                        + '<span class="aa-dt-dn">' + c.n
                                        + (c.same ? ('<b title="on this cause code">' + c.same + '</b>') : '')
                                        + '</span>'
                                        + '</div>';
                                        }
                                        return h + '</div>';
                                        }

                                        /* Two real analyses that reached different verdicts. Only ever shown for REAL
                                        runs -- a replay carrying the same verdict as its source is not a second opinion. */
                                        function aaDetDisagreeHtml(real) {
                                        if (real.length < 2) { return ''; }
                                        var seen = {}, words = [];
                                        for (var i = 0; i < real.length; i++) {
                                        var v = String(real[i].verdict || '').toUpperCase();
                                        if (!v || seen[v]) { continue; }
                                        seen[v] = true; words.push(v);
                                        }
                                        if (words.length < 2) { return ''; }

                                        /* The reason, when the payload actually shows one. An analysis run before the
                                        alert reset judged it without knowing it recovered, so its verdict is not a
                                        competing opinion -- it is an earlier one made on less. Asserted only when a run
                                        that saw no reset is genuinely older than one that did. */
                                        var blind = null, sighted = null;
                                        for (var j = real.length - 1; j >= 0; j--) {
                                        var c = real[j].card;
                                        if (!c) { continue; }
                                        if (c.hadReset) { sighted = real[j]; } else if (!blind) { blind = real[j]; }
                                        }
                                        var why = '';
                                        if (blind && sighted && blind !== sighted) {
                                        // Two DIFFERENT clocks, and mixing them is how this sentence goes wrong: when the
                                        // blind run FINISHED, versus when the alert actually reset. The first comes off
                                        // the run, the second only off the run that saw it.
                                        var rst = (sighted.card && sighted.card.resetAt) ? sighted.card.resetAt : '';
                                        why = ' The ' + escapeHtml(String(blind.verdict || 'earlier').toUpperCase())
                                        + ' reading was taken'
                                        + (blind.completedAt ? (' at ' + escapeHtml(blind.completedAt)) : '')
                                        + ', while the alert was still open.'
                                        + (rst ? (' It reset at ' + escapeHtml(rst) + ', which only the later analysis could see.')
                                        : ' Only the later analysis saw it recover.');
                                        }

                                        return '<div class="aa-dt-split">'
                                        + '<span class="aa-dt-split-t">Verdicts disagree</span>'
                                        + '<span class="aa-dt-split-b">' + escapeHtml(words.join(' vs ')) + '.' + why
                                        + ' The most recent analysis is shown in full below.</span>'
                                        + '</div>';
                                        }

                                        function aaDetLeadHtml(x, alertId) {
                                        var conf = (x.confidence !== '' && x.confidence != null) ? (x.confidence + '%') : '';
                                        var h = '<div class="aa-dt-card lead">';

                                        h += '<div class="aa-dt-top">'
                                        + '<span class="aa-dt-vd ' + aaDetVerdictClass(x.verdict) + '">'
                                        + escapeHtml(x.verdict || 'No verdict') + '</span>'
                                        + (conf ? ('<span class="aa-dt-conf">' + escapeHtml(conf) + ' confidence</span>') : '')
                                        + (x.category ? ('<span class="aa-dt-cat">' + escapeHtml(x.category) + '</span>') : '')
                                        + (x.isStale ? '<span class="aa-dt-badge stale">SUPERSEDED</span>' : '')
                                        + aaDetStageChip(x)   // v1.0.2.0: only when this alert has runs from both stages
                                        + '<span class="aa-dt-when">' + escapeHtml(x.completedAt || x.createdAt || '') + '</span>'
                                        + '</div>';

                                        if (x.headline) { h += '<div class="aa-dt-head">' + escapeHtml(x.headline) + '</div>'; }
                                        if (x.likelyCause) {
                                        h += '<div class="aa-dt-cause"><span class="aa-dt-lbl">Likely cause</span> '
                                        + escapeHtml(x.likelyCause) + '</div>';
                                        }

                                        h += aaDetWhenHtml(x);
                                        h += aaDetVizHtml(x.viz);
                                        h += aaDetCondHtml(x.card);
                                        h += aaDetRelayHtml(x.card);
                                        h += aaDetEvidenceHtml(x.evidence);

                                        if (x.recommendedAction) {
                                        h += '<div class="aa-dt-sec"><div class="aa-dt-sh">Recommended action</div>'
                                        + '<div class="aa-dt-act">' + escapeHtml(x.recommendedAction) + '</div></div>';
                                        }
                                        if (x.caveats) {
                                        h += '<div class="aa-dt-sec"><div class="aa-dt-sh">Caveats</div>'
                                        + '<div class="aa-dt-cav">' + escapeHtml(x.caveats) + '</div></div>';
                                        }

                                        h += aaDetHistHtml(x.assetHistory);
                                        h += aaDetDatesHtml(alertId);
                                        h += aaDetSnapHtml(x.snapshot);
                                        h += '</div>';
                                        return h;
                                        }

                                        /* Fired -> reset, and how long it ran. The duration is the first thing asked
                                        about a cleared fault and it was nowhere on this panel. */
                                        function aaDetWhenHtml(x) {
                                        var c = x.card;
                                        if (!c || (!c.firedAt && !x.triggeredAt)) { return ''; }
                                        var fired = c.firedAt || x.triggeredAt;
                                        return '<div class="aa-dt-when-row">'
                                        + '<span class="aa-dt-wh"><i>Fired</i>' + escapeHtml(fired) + '</span>'
                                        + (c.resetAt
                                        ? ('<span class="aa-dt-arw">&rarr;</span>'
                                        + '<span class="aa-dt-wh"><i>Reset</i>' + escapeHtml(c.resetAt) + '</span>')
                                        : '<span class="aa-dt-wh open"><i>State</i>still open when analysed</span>')
                                        + (c.station ? ('<span class="aa-dt-wh"><i>Station</i>' + escapeHtml(c.station) + '</span>') : '')
                                        + '</div>';
                                        }

                                        /* THE NUMBER THE VERDICT RESTS ON. The panel asserted a conclusion and never
                                        showed the reading that produced it; this is the one section whose absence made
                                        the rest unverifiable. */
                                        function aaDetVizHtml(z) {
                                        if (!z || (!z.value && z.value !== 0)) { return ''; }
                                        var u = z.unit ? (' ' + z.unit) : '';
                                        var h = '<div class="aa-dt-sec"><div class="aa-dt-sh">Measurement</div>'
                                        + '<div class="aa-dt-viz">'
                                        + '<div class="aa-dt-vz big"><i>' + escapeHtml(z.metric || 'measured') + '</i>'
                                        + '<b>' + escapeHtml(z.value) + escapeHtml(u) + '</b></div>';
                                        if (z.threshold) {
                                        h += '<div class="aa-dt-vz"><i>threshold</i><b>' + escapeHtml(z.threshold) + escapeHtml(u) + '</b></div>';
                                        }
                                        if (z.baseline) {
                                        h += '<div class="aa-dt-vz"><i>normal</i><b>' + escapeHtml(z.baseline) + escapeHtml(u) + '</b></div>';
                                        }
                                        if (z.pctChange) {
                                        var neg = String(z.pctChange).indexOf('-') === 0;
                                        h += '<div class="aa-dt-vz ' + (neg ? 'dn' : 'up') + '"><i>change</i><b>'
                                        + escapeHtml(z.pctChange) + '%</b></div>';
                                        }
                                        if (z.secondary && z.secondary.label) {
                                        h += '<div class="aa-dt-vz side"><i>' + escapeHtml(z.secondary.label) + '</i><b>'
                                        + escapeHtml(z.secondary.value)
                                        + escapeHtml(z.secondary.unit ? (' ' + z.secondary.unit) : '') + '</b></div>';
                                        }
                                        h += '</div>';
                                        if (z.phaseNote) { h += '<div class="aa-dt-note">' + escapeHtml(z.phaseNote) + '</div>'; }
                                        return h + '</div>';
                                        }

                                        /* What the rule actually tested, and against which limits. PASS/FAIL per
                                        threshold, because a condition that fired on one limit and passed another is a
                                        different fact from one that failed both. */
                                        function aaDetCondHtml(c) {
                                        if (!c || !c.trigger || !c.trigger.length) { return ''; }
                                        var h = '<div class="aa-dt-sec"><div class="aa-dt-sh">What fired</div><div class="aa-dt-conds">';
                                        for (var i = 0; i < c.trigger.length; i++) {
                                        var t = c.trigger[i], u = t.unit ? (' ' + t.unit) : '';
                                        h += '<div class="aa-dt-cond">'
                                        + '<span class="aa-dt-cn">' + escapeHtml(t.label || '') + '</span>'
                                        + '<span class="aa-dt-cv">' + escapeHtml(t.measured) + escapeHtml(u) + '</span>'
                                        + '<span class="aa-dt-cths">';
                                        for (var j = 0; j < t.thresholds.length; j++) {
                                        var th = t.thresholds[j];
                                        var bad = String(th.status || '').toUpperCase() === 'FAIL';
                                        h += '<span class="aa-dt-th ' + (bad ? 'fail' : 'pass') + '">'
                                        + escapeHtml(th.label || '') + ' ' + escapeHtml(th.value)
                                        + escapeHtml(th.unit ? (' ' + th.unit) : '')
                                        + '<b>' + escapeHtml(th.status || '') + '</b></span>';
                                        }
                                        h += '</span>'
                                        + (t.at ? ('<span class="aa-dt-ct">' + escapeHtml(t.at) + '</span>') : '')
                                        + '</div>';
                                        }
                                        return h + '</div></div>';
                                        }

                                        /* Relay states at the alert and, where there was one, at the reset. Side by side
                                        because the PAIR is the information -- on this alert NWKR DROP -> PICKUP is the
                                        entire story of the recovery, and neither column says it alone. */
                                        function aaDetRelayHtml(c) {
                                        if (!c || !c.relays || !c.relays.length) { return ''; }
                                        var after = {};
                                        if (c.relaysAtReset) {
                                        for (var k = 0; k < c.relaysAtReset.length; k++) {
                                        after[c.relaysAtReset[k].label] = c.relaysAtReset[k].value;
                                        }
                                        }
                                        var h = '<div class="aa-dt-sec"><div class="aa-dt-sh">Relays</div><div class="aa-dt-relays">';
                                        for (var i = 0; i < c.relays.length; i++) {
                                        var r = c.relays[i], to = after[r.label];
                                        var changed = (to && to !== r.value);
                                        h += '<div class="aa-dt-relay' + (changed ? ' changed' : '') + '">'
                                        + '<span class="aa-dt-rl">' + escapeHtml(r.label) + '</span>'
                                        + '<span class="aa-dt-rv">' + escapeHtml(r.value || '-') + '</span>'
                                        + (changed ? ('<span class="aa-dt-rarw">&rarr;</span>'
                                        + '<span class="aa-dt-rv to">' + escapeHtml(to) + '</span>') : '')
                                        + '</div>';
                                        }
                                        return h + '</div></div>';
                                        }

                                        /* Evidence keeps its provenance tag as a CHIP rather than as four literal
                                        characters at the head of the sentence. [record] came off the alert itself,
                                        [fetched] was pulled from history during the analysis -- the distinction is the
                                        reason the tag exists, and inline it read as noise. */
                                        function aaDetEvidenceHtml(ev) {
                                        if (!ev || !ev.length) { return ''; }
                                        var h = '<div class="aa-dt-sec"><div class="aa-dt-sh">Evidence</div><ul class="aa-dt-ev">';
                                        for (var i = 0; i < ev.length; i++) {
                                        var s = String(ev[i] || ''), m = s.match(/^\s*\[([a-z]+)\]\s*/i);
                                        if (m) {
                                        h += '<li><span class="aa-dt-src ' + escapeHtml(m[1].toLowerCase()) + '">'
                                        + escapeHtml(m[1]) + '</span>' + escapeHtml(s.substring(m[0].length)) + '</li>';
                                        } else {
                                        h += '<li>' + escapeHtml(s) + '</li>';
                                        }
                                        }
                                        return h + '</ul></div>';
                                        }

                                        /* sameCause leads, because it is the question. Nine alerts under nine different
                                        cause codes is an asset having a bad month; nine under the SAME code is one fault
                                        nobody has fixed, and the two need to read differently at a glance. */
                                        function aaDetHistHtml(a) {
                                        if (!a || !a.total) { return ''; }
                                        var same = Number(a.sameCause || 0);
                                        var h = '<div class="aa-dt-sec"><div class="aa-dt-sh">This asset, last '
                                        + escapeHtml(a.windowDays || '30') + ' days</div>'
                                        + '<div class="aa-dt-hist">'
                                        + '<span class="aa-dt-hn"><b>' + escapeHtml(a.total) + '</b> alerts</span>'
                                        + '<span class="aa-dt-hn ' + (same > 0 ? 'warn' : 'ok') + '"><b>' + same
                                        + '</b> on this cause code</span>'
                                        + (a.span ? ('<span class="aa-dt-hspan">' + escapeHtml(a.span) + '</span>') : '')
                                        + '</div>';
                                        if (a.byCause && a.byCause.length) {
                                        h += '<div class="aa-dt-causes">';
                                        for (var i = 0; i < a.byCause.length; i++) {
                                        h += '<span class="aa-dt-cc">' + escapeHtml(a.byCause[i].code)
                                        + '<b>' + escapeHtml(a.byCause[i].n) + '</b></span>';
                                        }
                                        h += '</div>';
                                        }
                                        return h + '</div>';
                                        }

                                        /* Twenty readings is a table, not a paragraph, and it is the least urgent thing
                                        on the panel -- so it is collapsed, and the summary carries the only part that
                                        cannot wait: how many were out of band. Readings outside their safe band sort to
                                        the top; the rest keep source order, which groups the ends together. */
                                        function aaDetSnapHtml(s) {
                                        if (!s || !s.values || !s.values.length) { return ''; }
                                        var v = s.values.slice(), bad = 0;
                                        for (var i = 0; i < v.length; i++) {
                                        var st = String(v[i].state || '').toLowerCase();
                                        v[i]._bad = (st && st !== 'ok');
                                        if (v[i]._bad) { bad++; }
                                        }
                                        v.sort(function (a, b) { return (b._bad ? 1 : 0) - (a._bad ? 1 : 0); });

                                        var h = '<details class="aa-dt-snap"><summary>'
                                        + '<span class="aa-dt-sh">Readings when analysed</span>'
                                        + '<span class="aa-dt-snn">' + v.length + ' values'
                                        + (bad ? (' &middot; <b>' + bad + '</b> out of band') : ' &middot; all in band')
                                        + (s.retrievedAt ? (' &middot; ' + escapeHtml(s.retrievedAt)) : '') + '</span>'
                                        + '</summary><table class="aa-dt-tbl"><tbody>';
                                        for (var j = 0; j < v.length; j++) {
                                        var r = v[j], band = [];
                                        if (r.minFail) { band.push('fail ' + r.minFail); }
                                        if (r.minSafe) { band.push('safe ' + r.minSafe); }
                                        if (r.maxSafe) { band.push('max ' + r.maxSafe); }
                                        if (r.avg) { band.push('avg ' + r.avg); }
                                        h += '<tr' + (r._bad ? ' class="bad"' : '') + '>'
                                        + '<td class="a">' + escapeHtml(r.attr) + '</td>'
                                        + '<td class="v">' + escapeHtml(r.value) + '</td>'
                                        + '<td class="s">' + (r.state ? ('<span class="aa-dt-st ' + escapeHtml(String(r.state).toLowerCase())
                                        + '">' + escapeHtml(r.state) + '</span>') : '') + '</td>'
                                        + '<td class="b">' + escapeHtml(band.join(' &middot; ')).replace(/&amp;middot;/g, '&middot;') + '</td>'
                                        + '<td class="t">' + escapeHtml(r.at || '') + '</td>'
                                        + '</tr>';
                                        }
                                        return h + '</tbody></table></details>';
                                        }

                                        /* Every run on one line each, replays included and labelled as replays. This is
                                        the only place a reuse appears, and it appears as what it is: the same verdict
                                        handed out again, not another analysis. */
                                        function aaDetRunsHtml(list, lead) {
                                        if (list.length < 2) { return ''; }
                                        var h = '<div class="aa-dt-runs"><div class="aa-dt-sh">All runs</div>';
                                        for (var i = 0; i < list.length; i++) {
                                        var x = list[i], cached = !!x.servedFromCache;
                                        h += '<div class="aa-dt-run' + (x === lead ? ' on' : '') + '">'
                                        + '<span class="aa-dt-rvd ' + aaDetVerdictClass(x.verdict) + '">'
                                        + escapeHtml(x.verdict || '-') + '</span>'
                                        + '<span class="aa-dt-rcf">' + escapeHtml(x.confidence ? (x.confidence + '%') : '') + '</span>'
                                        + '<span class="aa-dt-rkind ' + (cached ? 'reuse' : 'real') + '">'
                                        + (cached ? 'reused' : 'analysed') + '</span>'
                                        + aaDetStageChip(x)   // v1.0.2.0: silent unless the runs span both stages
                                        + '<span class="aa-dt-rwhen">' + escapeHtml(x.completedAt || x.createdAt || '') + '</span>'
                                        + (x === lead ? '<span class="aa-dt-rshown">shown above</span>' : '')
                                        + '</div>';
                                        }
                                        return h + '</div>';
                                        }

                                        // v1.0.55.76: ONE DAY PER ROW. A vertical list of 200 alerts is a scroll; a 24 h lane shows
                                        // WHEN they happened relative to each other, which is the only thing a timeline adds over a table.
                                        function fnAaRenderTimeline(list) {
                                        // v1.0.55.85: cards in FLOW along a SEQUENTIAL axis. The four previous revisions positioned
                                        // cards at a time coordinate on a 24 h scale and then fought the overlaps that creates --
                                        // alerts minutes apart cannot be drawn side by side at true position, so the lane could only
                                        // ever stack, spill or hide them. Sequential ordering removes the problem at its source: two
                                        // alerts a minute apart get two ADJACENT nodes. The axis labels carry the real times, and a
                                        // burst collapses to one card, so the timeline reading (order, clustering, gaps) survives.
                                        var rows = list.slice().sort(function (x, y) {
                                        return (x.timeSort > y.timeSort) ? 1 : ((x.timeSort < y.timeSort) ? -1 : 0);   // chronological
                                        });
                                        var byDay = {}, order = [];
                                        for (var i = 0; i < rows.length; i++) {
                                        var k = aaDayLabel(rows[i]);
                                        if (!byDay[k]) { byDay[k] = []; order.push(k); }
                                        byDay[k].push(rows[i]);
                                        }
                                        order.reverse();   // newest DAY first, chronological within the day
                                        var h = '<div class="aa-tl">';
                                        for (var d = 0; d < order.length; d++) {
                                        var day = order[d], items = byDay[day], nf = 0;
                                        for (var q = 0; q < items.length; q++) { if (items[q].type === 'Failure') { nf++; } }

                                        // A burst is ONE card. Same rule as before, but now expressed in MINUTES rather than as a
                                        // fraction of a pixel width -- there is no pixel scale any more.
                                        var CLUSTER_MIN = 20;
                                        var groups = [], cur = [];
                                        for (var j = 0; j < items.length; j++) {
                                        if (!cur.length) { cur = [items[j]]; continue; }
                                        if ((aaMs(items[j]) - aaMs(cur[0])) <= CLUSTER_MIN * 60000
                                        && items[j].station === cur[0].station) { cur.push(items[j]); }
                                        else { groups.push(cur); cur = [items[j]]; }
                                        }
                                        if (cur.length) { groups.push(cur); }

                                        h += '<div class="aa-dayrow">'
                                        + '<div class="aa-dayhd"><b>' + escapeHtml(day) + '</b>'
                                        + '<span class="aa-dn">' + items.length + '</span>'
                                        + (nf ? '<span class="aa-df">' + nf + ' failure</span>' : '')
                                        + '<span class="aa-ev-sp"></span>'
                                        + (groups.length > 5 ? '<span class="aa-hint">scroll &rarr;</span>' : '')
                                        + '</div>'
                                        + '<div class="aa-trackwrap"><div class="aa-track"><div class="aa-axis"></div>';
                                        for (var g = 0; g < groups.length; g++) { h += fnAaTlCard(groups[g]); }
                                        h += '</div></div></div>';
                                        }
                                        h += '</div>';
                                        return h;
                                        }

                                        // Short coded badge rather than the full type string: "POINT MACHINE" is 13 characters and
                                        // would dominate a 236px card, while the operator only needs to distinguish four kinds.
                                        // resetText is "dd/MM/yyyy HH:mm:ss" -- the card only needs the clock part, and the date only
                                        // when the alert cleared on a LATER day than it was raised.
                                        function aaResetLabel(a) {
                                        var r = String(a.resetText || '');
                                        if (!r) { return ''; }
                                        var sp = r.split(' ');
                                        if (sp.length < 2) { return r.substring(0, 5); }
                                        var hhmm = sp[1].substring(0, 5);
                                        var sameDay = String(a.timeText || '').indexOf(sp[0]) === 0;
                                        return sameDay ? hhmm : (hhmm + ' +' + sp[0].substring(0, 5));
                                        }

                                        // "0-02:24:33" is days-HH:mm:ss. The leading day count is printed even when zero, which is most
                                        // of the time -- so say it in units a person reads instead.
                                        function aaElapsed(dt) {
                                        var v = String(dt || '');
                                        var m = v.match(/^(\d+)-(\d{2}):(\d{2}):(\d{2})$/);
                                        if (!m) { return v; }
                                        var d = +m[1], h = +m[2], mi = +m[3], se = +m[4];
                                        if (d > 0) { return d + 'd ' + h + 'h'; }
                                        if (h > 0) { return h + 'h ' + mi + 'm'; }
                                        if (mi > 0) { return mi + 'm ' + se + 's'; }
                                        return se + 's';
                                        }

                                        function aaTypeBadge(t) {
                                        var v = String(t || '').toUpperCase(), code = '', cls = 'oth';
                                        if (v.indexOf('TRACK') >= 0) { code = 'TRK'; cls = 'trk'; }
                                        else if (v.indexOf('POINT') >= 0) { code = 'PM'; cls = 'pm'; }
                                        else if (v.indexOf('SIGNAL') >= 0) { code = 'SIG'; cls = 'sig'; }
                                        else if (v.indexOf('IPS') >= 0) { code = 'IPS'; cls = 'ips'; }
                                        else if (v.length) { code = v.substring(0, 3); }
                                        return code ? '<span class="aa-tb ' + cls + '">' + escapeHtml(code) + '</span>' : '';
                                        }

                                        function aaMs(a) { var d = new Date(a.timeSort || a.time); return isNaN(d.getTime()) ? 0 : d.getTime(); }

                                        // One card per alert, or per BURST. Severity follows the worst member: a group containing a
                                        // failure must not read as predictive because most of it is.
                                        function fnAaTlCard(grp) {
                                        var a = grp[0], n = grp.length, nf = 0;
                                        for (var i = 0; i < n; i++) { if (grp[i].type === 'Failure') { nf++; } }
                                        var cls = nf ? 'fail' : 'pred';
                                        var isOpen = !a.resetText;
                                        var v = aaRemarkVerdict(a);
                                        var span = n > 1 ? Math.max(1, Math.round((aaMs(grp[n - 1]) - aaMs(a)) / 60000)) : 0;
                                        var tip = n > 1
                                        ? (n + ' alerts in ' + span + ' min at ' + (a.station || '') + '\n'
                                        + nf + ' failure, ' + (n - nf) + ' predictive')
                                        : ((a.code || '') + '\n' + aaTimeLabel(a) + (a.resetText ? '\ncleared ' + a.resetText : '\nOPEN')
                                        + (v.text ? '\nremark: ' + v.text : ''));
                                        return '<div class="aa-ti ' + cls + '" onclick="aaLanePick(' + a.id + ',event)" title="' + escapeHtml(tip) + '">'
                                        + '<div class="aa-tc">'
                                        + '<div class="aa-tch"><span class="aa-tct">' + escapeHtml(aaTimeLabel(a)) + '</span>'
                                        + '<b>' + escapeHtml(a.asset || '') + '</b>'
                                        + (n > 1 ? '<span class="aa-cl">' + n + '</span>' : '')
                                        + (v.flag ? '<span class="aa-vflag ' + v.flag + '">' + (v.flag === 'true' ? 'T' : 'F') + '</span>' : '')
                                        + '<span class="aa-ev-sp"></span>'
                                        + '<span class="aa-chip ' + cls + '">' + (nf ? 'Failure' : 'Predictive') + '</span></div>'
                                        + '<div class="aa-tcc">' + escapeHtml(a.code || '') + '</div>'
                                        + '<div class="aa-tcf">'
                                        + '<span class="aa-sr"><span class="aa-set">' + escapeHtml(aaTimeLabel(a).substring(0, 5)) + '</span>'
                                        + '<span class="aa-arw">&rarr;</span>'
                                        + (isOpen ? '<span class="aa-rst open">OPEN</span>'
                                        : '<span class="aa-rst">' + escapeHtml(aaResetLabel(a)) + '</span>')
                                        + '</span>'
                                        + (isOpen ? '' : '<span class="aa-eld">' + escapeHtml(aaElapsed(a.durationText)) + '</span>')
                                        + '<span class="aa-ev-sp"></span>' + aaVerdictStateCell(a.id) + aaInsightBtn(a.id)
                                        + '</div>'
                                        + '<div class="aa-tcm">' + aaTypeBadge(a.assetType)
                                        + '<span class="aa-tcs' + (aaState.site ? '' : ' hi') + '">' + escapeHtml(a.station || '') + '</span>'
                                        + (a.division ? '<span class="aa-tcd">' + escapeHtml(a.division) + '</span>' : '')
                                        + '</div></div>'
                                        + '<span class="aa-stem"></span><span class="aa-node"></span>'
                                        + '<span class="aa-axlbl">' + escapeHtml(aaTimeLabel(a).substring(0, 5)) + '</span>'
                                        + '</div>';
                                        }

                                        function aaRemarkVerdict(a) {
                                        var r = (a.remark || a.maintRemark || '').trim();
                                        var low = r.toLowerCase();
                                        if (low === 'true' || low === 'yes') { return { flag: 'true', text: r }; }
                                        if (low === 'false' || low === 'no') { return { flag: 'false', text: r }; }
                                        return { flag: '', text: r };
                                        }

                                        // Clicking a chip opens the detail row beneath its lane -- the chip is too small for the cause,
                                        // the remark and an action, and cramming them in would defeat the point of the lane.
                                        function aaLanePick(id, ev) {
                                        try {
                                        if (ev && ev.stopPropagation) { ev.stopPropagation(); }
                                        var list = fnAaFiltered(), a = null;
                                        for (var i = 0; i < list.length; i++) { if (list[i].id === id) { a = list[i]; break; } }
                                        if (!a) { return; }
                                        var old = document.getElementById('aaLaneDet');
                                        if (old && old.parentNode) { old.parentNode.removeChild(old); }
                                        // v1.0.55.85: the detail opens beneath the DAY ROW -- .aa-lane no longer exists.
                                        var host = ev && ev.target ? ev.target.closest('.aa-dayrow') : null;
                                        if (!host) { return; }
                                        var v = aaRemarkVerdict(a);
                                        var d = document.createElement('div');
                                        d.id = 'aaLaneDet';
                                        d.className = 'aa-lane-det ' + ((a.type === 'Failure') ? 'fail' : 'pred');
                                        d.innerHTML = '<div class="aa-det-hd"><b>' + escapeHtml(a.asset || '') + '</b>'
                                        + '<span class="aa-chip ghost">' + escapeHtml(a.assetType || '') + '</span>'
                                        + '<span class="aa-chip sev ' + ((a.type === 'Failure') ? 'fail' : 'pred') + '">'
                                        + (a.type === 'Failure' ? 'Failure' : 'Predictive') + '</span>'
                                        + '<span class="aa-chip">' + escapeHtml(aaTimeLabel(a)) + '</span>'
                                        + '<span class="aa-sr"><span class="aa-set">' + escapeHtml(aaTimeLabel(a).substring(0, 5)) + '</span>'
                                        + '<span class="aa-arw">&rarr;</span>'
                                        + (a.resetText ? '<span class="aa-rst">' + escapeHtml(aaResetLabel(a)) + '</span>'
                                        : '<span class="aa-rst open">OPEN</span>')
                                        + '</span>'
                                        + (a.resetText ? '<span class="aa-eld">' + escapeHtml(aaElapsed(a.durationText)) + '</span>' : '')
                                        + '<span class="aa-det-sp"></span>'
                                        + aaVerdictStateCell(a.id) + aaInsightBtn(a.id) + aaDetailBtn(a.id) + '</div>'
                                        + '<div class="aa-det-cause">' + escapeHtml(a.code || '') + '</div>'
                                        + (v.text
                                        ? '<div class="aa-det-rem">' + (v.flag
                                        ? '<span class="aa-rem-flag ' + v.flag + '">' + (v.flag === 'true' ? 'CONFIRMED TRUE' : 'CONFIRMED FALSE') + '</span>'
                                        : '<span class="aa-rem-lbl">Maintainer</span>')
                                        + '<span class="aa-rem-txt">' + escapeHtml(v.text) + '</span></div>'
                                        : '<div class="aa-det-rem"><span class="aa-rem-lbl none">No maintainer remark</span></div>')
                                        + '<div class="aa-det-foot">' + escapeHtml(a.station || '')
                                        + (a.division ? ' &middot; ' + escapeHtml(a.division) : '') + '</div>';
                                        host.appendChild(d);
                                        } catch (e) { }
                                        }


                                        // Helpers kept tiny and local: the row objects already carry what these need.
                                        function aaTs(a) { var d = new Date(a.timeSort || a.time); return isNaN(d.getTime()) ? 0 : d.getTime(); }
                                        function aaDayLabel(a) { var d = new Date(a.timeSort || a.timeText); return isNaN(d.getTime()) ? 'Undated' : d.toDateString(); }
                                        function aaTimeLabel(a) {
                                        var d = new Date(a.timeSort || a.timeText);
                                        if (isNaN(d.getTime())) { return String(a.timeText || 'no timestamp'); }
                                        function p(n) { return (n < 10 ? '0' : '') + n; }
                                        return p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds());
                                        }
                                        function aaAttr(v) { return String(v || '').replace(/\\/g, '').replace(/'/g, ""); }
                                        // Site selection goes through fnAaSetSite(id) -- the same call the site tiles use.
                                        // (fnAaPickSite does not exist; it was my invention.)
                                        function fnAaFocusSite(name) {
                                        try {
                                        for (var i = 0; i < AA_SITES.length; i++) {
                                        if (AA_SITES[i].name === name) { fnAaSetSite(AA_SITES[i].id); return; }
                                        }
                                        } catch (e) { }
                                        }

                                        function fnAaRenderTable() {
                                        // v1.0.2.6: head FIRST, every render. The remark columns follow the review-state
                                        // filter, so the colgroup and the header have to be rewritten before the body is
                                        // built or the two disagree about how many columns there are for one frame -- and
                                        // on the empty-list path below, which returns early, forever.
                                        fnAaRenderTableHead();
                                        var list = fnAaFiltered();
                                        if (!list.length) {
                                        // v1.0.55.81: the empty state must land in the VISIBLE container. With timeline as the
                                        // default, writing it into the table body left the board looking blank rather than
                                        // saying why it was blank.
                                        var msg = AA_INRANGE.length ? 'No alerts match the current filters.' : 'No alerts in this date window.';
                                        if (AA_VIEW === 'cards') { $('#aaCardsWrap').html('<div class="aa-tl-empty">' + msg + '</div>'); }
                                        else if (AA_VIEW === 'timeline') { $('#aaTimelineWrap').html('<div class="aa-tl-empty">' + msg + '</div>'); }
                                        else { $('#aaRows').html('<tr class="aa-empty"><td colspan="' + aaColCount() + '">' + msg + '</td></tr>'); }
                                        fnAaUpdateCount(list);
                                        return;
                                        }
                                        if (AA_VIEW === 'cards') {
                                        fnAaRenderCards(list);
                                        fnAaUpdateCount(list);
                                        return;
                                        }
                                        if (AA_VIEW === 'timeline') {
                                        $('#aaTimelineWrap').html(fnAaRenderTimeline(list));
                                        fnAaUpdateCount(list);
                                        return;
                                        }
                                        var bySite = {};
                                        for (var i = 0; i < list.length; i++) { (bySite[list[i].station] = bySite[list[i].station] || []).push(list[i]); }
                                        var h = '';
                                        var sr = 0;
                                        for (var s = 0; s < AA_SITES.length; s++) {
                                        var site = AA_SITES[s];
                                        var g = bySite[site.name];
                                        if (!g) { continue; }
                                        g.sort(function (x, y) { return (y.timeSort > x.timeSort) ? 1 : ((y.timeSort < x.timeSort) ? -1 : 0); });
                                        var f = 0;
                                        for (var q = 0; q < g.length; q++) { if (g[q].type === 'Failure') { f++; } }
                                        var p = g.length - f;
                                        h += '<tr class="aa-grp"><td colspan="' + aaColCount() + '"><div class="aa-grp-in">' +
                                        '<span class="aa-grp-name">' + escapeHtml(site.name) + '</span>' +
                                        '<span class="aa-grp-meta">' + g.length + ' alert' + (g.length > 1 ? 's' : '') +
                                        (f ? ' &middot; <em>' + f + ' failure</em>' : '') + (p ? ' &middot; ' + p + ' predictive' : '') + '</span>' +
                                        '<span class="aa-grp-code">SITE ' + site.siteId + '</span>' +
                                        '</div></td></tr>';
                                        for (var r = 0; r < g.length; r++) {
                                        var a = g[r];
                                        sr++;
                                        var pred = a.type !== 'Failure';
                                        // v1.0.55.65: an alert with no reset is still OPEN -- dash in both the duration and
                                        // rectification cells rather than a computed or zero value.
                                        var openAlert = !a.resetText;
                                        h += '<tr class="aa-row ' + (pred ? 'is-pred' : 'is-fail') + (openAlert ? ' is-open' : '') + '"><td class="aa-c-sr">' + sr + ' ' + aaDisc(a) + '</td>' +
                                        // v1.0.1.3: STATION / DIVISION / ZONE in one stacked cell. Three separate
                                        // columns cost ~290px to show three short values, and the station -- the
                                        // one an operator actually navigates by -- was not among them at all: it
                                        // lived only in the group band, so a filtered or sorted view lost it.
                                        '<td class="aa-c-loc">' + aaLocCell(a) + '</td>' +
                                        // Type collapses to a single letter. The word cost a 112px column to say
                                        // what the colour already says; the full word stays on the title.
                                        '<td class="aa-c-t"><span class="aa-tflag ' + (pred ? 'pred' : 'fail') + '" title="'
                                        + escapeHtml(a.type || '') + '">' + (pred ? 'P' : 'F') + '</span></td>' +
                                        '<td class="aa-c-atype">' + escapeHtml(a.assetType || '-') + '</td>' +
                                        '<td class="aa-c-asset">' + escapeHtml(a.asset) + '</td>' +
                                        // Incidence, duration and rectification stacked in one cell: they are one
                                        // fact -- when it started, how long it ran, when it cleared -- and as three
                                        // columns they took 432px to say it.
                                        '<td class="aa-c-when">' + aaWhenCell(a, openAlert) + '</td>' +
                                        '<td class="aa-ai"><span class="aa-ai-in"><span class="aa-ai-r">'
                                        + aaVerdictStateCell(a.id) + ' ' + aaRateChip(a) + '</span>'
                                        // v1.0.2.0: the validity switch, stacked under the verdict and the stars.
                                        // Same cell because it is the same question area -- what the AI said, what
                                        // a person thought of it, and whether the alert was worth raising.
                                        + aaValidToggle(a) + '</span></td>' +
                                        '<td class="aa-cause"><span class="aa-cause-in">'
                                        + '<a onclick="fnShowAlertMessage(' + a.id + ')">' + escapeHtml(a.code) + '</a>'
                                        + aaInsightBtn(a.id) + aaDetailBtn(a.id) + '</span></td>' +
                                        // v1.0.1.0: the two remarks in their OWN columns. They were only
                                        // reachable through the decision flyout before, so comparing what
                                        // the office recorded against what the field found meant opening
                                        // one alert at a time. Each cell shows only its own side: an
                                        // approved alert has no discard remark and vice versa, and filling
                                        // the empty one with the other's text would invent a record.
                                        aaRemarkCells(a) +
                                        '</tr>';
                                        }
                                        }
                                        $('#aaRows').html(h);
                                        fnAaUpdateCount(list);
                                        }
                                        /* v1.0.1.2: the two table filters. They SET the value rather than toggling it, because a
                                        <select> already reports its own state -- toggling would make picking the currently
                                        selected option silently clear it. fnAaSetSite/fnAaSetCause keep their toggle
                                        behaviour because those are chips, where clicking the active one is how you clear it. */
                                        /* v1.0.1.3 -- STATION -> ASSET TYPE -> CAUSE, the Alert History chain.
                                        Selecting a station re-asks which asset types that station has; selecting an asset
                                        type re-asks which cause codes belong to it. Chained rather than fired together,
                                        because the cause request needs the asset type ids the first call returns.
                                        Both feeds are advisory: on failure the lists fall back to what the loaded alerts can
                                        tell us, so a filter service that is down narrows the choices rather than emptying
                                        the board. */
                                        var AA_ASSETTYPES = [];        // [{id,name}] for the selected station
                                        var AA_CAUSE_MASTER = [];      // [{id,name}] for the selected asset type
                                        var AA_FEED_SEQ = 0;           // guards against an older response landing last

                                        function aaSelectedSiteIds() {
                                        if (!aaState.site) { return []; }
                                        for (var i = 0; i < AA_SITES.length; i++) {
                                        if (AA_SITES[i].name === aaState.site) {
                                        var n = parseInt(AA_SITES[i].siteId, 10);
                                        return isNaN(n) ? [] : [n];
                                        }
                                        }
                                        return [];
                                        }

                                        function aaAssetTypeIds() {
                                        var ids = [];
                                        for (var i = 0; i < AA_ASSETTYPES.length; i++) {
                                        if (!aaState.assetType || AA_ASSETTYPES[i].name === aaState.assetType) {
                                        var n = parseInt(AA_ASSETTYPES[i].id, 10);
                                        if (!isNaN(n)) { ids.push(n); }
                                        }
                                        }
                                        return ids;
                                        }

                                        // Asset types actually present in the loaded alerts -- the fallback, and the only source
                                        // before a station is picked.
                                        function aaDerivedAssetTypes() {
                                        var seen = {}, out = [];
                                        for (var i = 0; i < AA_INRANGE.length; i++) {
                                        var t = AA_INRANGE[i].assetType;
                                        if (t && !seen[t]) { seen[t] = 1; out.push({ id: '', name: t }); }
                                        }
                                        out.sort(function (x, y) { return x.name.localeCompare(y.name); });
                                        return out;
                                        }

                                        function fnAaLoadAssetTypes(done) {
                                        var siteIds = aaSelectedSiteIds();
                                        if (siteIds.length === 0) {
                                        AA_ASSETTYPES = aaDerivedAssetTypes();
                                        if (done) { done(); }
                                        return;
                                        }
                                        $.ajax({
                                        url: '@Url.Action("GetAssetTypeBySiteIds", "UnifiedAlertAnalysis")',
                                        type: 'POST', contentType: 'application/json',
                                        data: JSON.stringify({ siteIds: siteIds }),
                                        success: function (d) {
                                        var out = [];
                                        if (d && d.length) {
                                        for (var i = 0; i < d.length; i++) {
                                        out.push({ id: String(d[i].Id), name: d[i].Name || '' });
                                        }
                                        }
                                        AA_ASSETTYPES = out.length ? out : aaDerivedAssetTypes();
                                        // A selection that the new station does not have is dropped, or the board
                                        // would sit empty with a filter the user cannot see the cause of.
                                        if (aaState.assetType) {
                                        var still = false;
                                        for (var k = 0; k < AA_ASSETTYPES.length; k++) {
                                        if (AA_ASSETTYPES[k].name === aaState.assetType) { still = true; break; }
                                        }
                                        if (!still) { aaState.assetType = null; }
                                        }
                                        if (done) { done(); }
                                        },
                                        error: function () { AA_ASSETTYPES = aaDerivedAssetTypes(); if (done) { done(); } }
                                        });
                                        }

                                        function fnAaLoadCauses(done) {
                                        var seq = ++AA_FEED_SEQ;
                                        $.ajax({
                                        url: '@Url.Action("GetAlertInfoByFilter", "UnifiedAlertAnalysis")',
                                        type: 'POST', contentType: 'application/json',
                                        data: JSON.stringify({ AssetTypeIds: aaAssetTypeIds() }),
                                        success: function (d) {
                                        if (seq !== AA_FEED_SEQ) { return; }
                                        var out = [];
                                        if (d && d.length) {
                                        for (var i = 0; i < d.length; i++) {
                                        out.push({ id: String(d[i].Id), name: d[i].Name || '' });
                                        }
                                        }
                                        AA_CAUSE_MASTER = out;
                                        if (aaState.cause) {
                                        var ok = false;
                                        for (var k = 0; k < out.length; k++) {
                                        if (out[k].name === aaState.cause) { ok = true; break; }
                                        }
                                        if (!ok && out.length) { aaState.cause = null; }
                                        }
                                        if (done) { done(); } else { fnAaRenderAll(); }
                                        },
                                        error: function () {
                                        if (seq !== AA_FEED_SEQ) { return; }
                                        AA_CAUSE_MASTER = [];
                                        if (done) { done(); } else { fnAaRenderAll(); }
                                        }
                                        });
                                        }

                                        function fnAaReloadFilterFeeds() {
                                        fnAaLoadAssetTypes(function () {
                                        fnAaLoadCauses(function () { fnAaRenderAll(); });
                                        });
                                        }

                                        function fnAaSelAssetType(v) {
                                        aaState.assetType = v || null;
                                        // Cause codes hang off asset type, so they are re-asked whenever it moves.
                                        fnAaLoadCauses(function () { fnAaRenderAll(); });
                                        }

                                        function fnAaSelSite(v) { aaState.site = v || null; fnAaReloadFilterFeeds(); }

                                        function fnAaSelCause(v) {
                                        aaState.cause = v || null;
                                        // the same mutual exclusion fnAaSetCause enforces: a cause and an asset class are
                                        // two ways of narrowing the same axis, and holding both shows nothing.
                                        if (aaState.cause) { aaState.assetClass = null; }
                                        fnAaRenderAll();
                                        }

                                        function fnAaClearTableFilters() {
                                        aaState.site = null;
                                        aaState.cause = null;
                                        aaState.assetType = null;
                                        // clearing the station widens what asset types and causes are on offer, so the
                                        // feeds are re-asked rather than left showing the narrowed set.
                                        fnAaReloadFilterFeeds();
                                        }

                                        /* Options are rebuilt from AA_SITES / AA_CAUSES on every render, which fnAaDerive builds
                                        from the date window BEFORE the site and cause filters are applied. Building them from
                                        the filtered list instead would leave a one-option dropdown with no way back out. */
                                        function fnAaFillSel(id, html, val) {
                                        var el = document.getElementById(id);
                                        if (!el) { return; }
                                        el.innerHTML = html;
                                        el.value = val || '';
                                        el.className = val ? 'aa-tsel on' : 'aa-tsel';
                                        }

                                        function fnAaSyncTableFilters(list) {
                                        var names = [];
                                        for (var i = 0; i < AA_SITES.length; i++) {
                                        if (AA_SITES[i].name) { names.push(AA_SITES[i].name); }
                                        }
                                        names.sort(function (x, y) { return String(x).localeCompare(String(y)); });
                                        var hs = '<option value="">All stations (' + names.length + ')</option>';
                                        for (var j = 0; j < names.length; j++) {
                                        hs += '<option value="' + escapeHtml(names[j]) + '">' + escapeHtml(names[j]) + '</option>';
                                        }
                                        fnAaFillSel('aaTblSelSite', hs, aaState.site);

