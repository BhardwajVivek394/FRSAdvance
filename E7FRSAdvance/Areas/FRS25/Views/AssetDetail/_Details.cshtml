@model Domain.AssetLister


@{
    var assetReport = new List<dynamic>();
    int totalAssetCount = 0;

    if (Model != null && Model.mAssets != null && Model.mAssets.Count > 0)
    {
        assetReport = Model.mAssets
            .GroupBy(c => new
            {
                c.Zone,
                c.Division,
                c.SiteName,
                c.AssetTypeName,
                c.RailwayAssetMake
            })
            .Select(gcs => new
            {
                gcs.Key.Zone,
                gcs.Key.Division,
                gcs.Key.SiteName,
                gcs.Key.AssetTypeName,
                gcs.Key.RailwayAssetMake,
                Count = gcs.Count()
            }).ToList<dynamic>();

        totalAssetCount = assetReport.Sum(x => (int)x.Count);
    }
}

<div class="col">
    <div id="listView">
        <div class="table-responsive">
            <table class="table table-hover" id="tblAssetDetail">
                <thead class="thead-light2">
                    <tr>
                        <th>Sr.No</th>
                        <th>Zone</th>
                        <th>Division</th>
                        <th>Station</th>
                        <th>Asset Type</th>
                        <th>Asset Make</th>
                        <th class="text-center">Count of Asset</th>
                    </tr>
                </thead>
                <tbody>
                    @if (assetReport.Count > 0)
                    {
                        int counter = 0;
                        foreach (var asset in assetReport)
                        {
                            counter++;
                            <tr>
                                <td>@counter</td>
                                <td>@asset.Zone</td>
                                <td>@asset.Division</td>
                                <td>@asset.SiteName</td>
                                <td>@asset.AssetTypeName</td>
                                <td>@asset.RailwayAssetMake</td>
                                <td class="text-center">@asset.Count</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                No records found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="px-md-4 px-2">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div class="showing-records text-muted" id="showingRecords"></div>
                <nav>
                    <ul class="pagination justify-content-end mt-3" id="pager"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var rowsPerPage = 20;
        var $rows = $('#tblAssetDetail tbody tr').filter(function () {
            return !$(this).find('td[colspan]').length;
        });
        var totalRows = $rows.length;
        var totalPages = Math.ceil(totalRows / rowsPerPage);
        var currentPage = 1;
        var $pager = $('#pager');

        function showPage(page) {
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            var start = (page - 1) * rowsPerPage;
            var end = start + rowsPerPage;
            $rows.hide().slice(start, end).show();

            // Update "Showing x to y of z records"
            var fromRec = totalRows === 0 ? 0 : start + 1;
            var toRec = Math.min(end, totalRows);
            $('#showingRecords').text('Showing ' + fromRec + ' to ' + toRec + ' of ' + totalRows + ' records');

            renderPager();
        }

        function renderPager() {
            $pager.empty();
            if (totalPages <= 1 && totalRows <= 0) return;

            // Previous
            $pager.append(
                '<li class="page-item ' + (currentPage === 1 ? 'disabled' : '') + '" data-page="prev">' +
                '<a class="page-link" href="#"><i class="fas fa-chevron-left"></i><span class="d-none d-sm-inline"> Previous</span></a></li>'
            );

            // Page numbers
            var pages = [];
            if (totalPages <= 7) {
                for (var i = 1; i <= totalPages; i++) pages.push(i);
            } else {
                for (var i = 1; i <= Math.min(3, totalPages); i++) pages.push(i);
                if (currentPage > 5) pages.push('...');
                for (var i = currentPage - 1; i <= currentPage + 1; i++) {
                    if (i > 3 && i < totalPages - 2) pages.push(i);
                }
                if (currentPage < totalPages - 4) pages.push('...');
                for (var i = Math.max(totalPages - 2, 4); i <= totalPages; i++) pages.push(i);
            }

            pages.forEach(function (p) {
                if (p === '...') {
                    $pager.append('<li class="page-item disabled"><span class="page-link">...</span></li>');
                } else {
                    $pager.append(
                        '<li class="page-item ' + (p === currentPage ? 'active' : '') + '">' +
                        '<a class="page-link" href="#">' + p + '</a></li>'
                    );
                }
            });

            // Next
            $pager.append(
                '<li class="page-item ' + (currentPage >= totalPages ? 'disabled' : '') + '" data-page="next">' +
                '<a class="page-link" href="#"><span class="d-none d-sm-inline">Next </span><i class="fas fa-chevron-right"></i></a></li>'
            );
        }

        $pager.on('click', '.page-link', function (e) {
            e.preventDefault();
            var $li = $(this).parent();
            if ($li.hasClass('disabled') || $li.hasClass('active')) return;
            if ($li.data('page') === 'prev') showPage(currentPage - 1);
            else if ($li.data('page') === 'next') showPage(currentPage + 1);
            else showPage(parseInt($(this).text()));
        });

        window.goToPage = function (p) { showPage(p); };

        if (totalRows > 0) showPage(1);
    })();
</script>
