<script>
    var _totalRecords = @totalRecords;
    var _pageSize = @pageSize;

    function fnPrevPage() {
        var skip = parseInt($('#hdnSkip').val()) || 0;
        if (skip >= _pageSize) {
            $('#hdnSkip').val(skip - _pageSize);
            fnGetAssetDetailReport();
        }
    }

    function fnNextPage() {
        var skip = parseInt($('#hdnSkip').val()) || 0;
        if (skip + _pageSize < _totalRecords) {
            $('#hdnSkip').val(skip + _pageSize);
            fnGetAssetDetailReport();
        }
    }

    function fnGoToPage(page) {
        $('#hdnSkip').val((page - 1) * _pageSize);
        fnGetAssetDetailReport();
    }
</script>
