@model Domain.AssetLister

@Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
@Html.HiddenFor(model => model.Pager.PageSize, new { id = "hdnPageSize" })

@{ // Group the data
    var assetReport = new List<dynamic>();
    int totalAssetCount = 0;

    if (Model != null && Model.mAssets != null && Model.mAssets.Count > 0)
    {
        assetReport = Model.mAssets
            .GroupBy(c => new
            {
                c.Zone,
                c.Division,
                c.SiteName,
                c.AssetTypeName,
                c.RailwayAssetMake
            })
            .Select(gcs => new
            {
                gcs.Key.Zone,
                gcs.Key.Division,
                gcs.Key.SiteName,
                gcs.Key.AssetTypeName,
                gcs.Key.RailwayAssetMake,
                Count = gcs.Count()
            }).ToList<dynamic>();

        totalAssetCount = assetReport.Sum(x => (int)x.Count);
    }

    // Pagination calculations
    int pageSize = Model.Pager != null && Model.Pager.PageSize > 0 ? Model.Pager.PageSize : 10;
    int skip = Model.Pager != null ? Model.Pager.Skip : 0;
    int totalRecords = assetReport.Count;
    int totalPages = totalRecords > 0 ? (int)Math.Ceiling((double)totalRecords / pageSize) : 1;
    int currentPage = (skip / pageSize) + 1;

    // Apply pagination
    var pagedData = assetReport.Skip(skip).Take(pageSize).ToList();
    int startIndex = skip; }

<div class="col">
    <!-- List View -->
    <div id="listView">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="thead-light2">
                    <tr>
                        <th>Sr.No</th>
                        <th>Zone</th>
                        <th>Division</th>
                        <th>Station</th>
                        <th>Asset Type</th>
                        <th>Asset Make</th>
                        <th class="text-center">Count of Asset</th>
                    </tr>
                </thead>
                <tbody>
                    @if (pagedData.Count > 0)
                    {
                        int counter = startIndex;
                        foreach (var asset in pagedData)
                        {
                            counter++;
                            <tr>
                                <td>@counter</td>
                                <td>@asset.Zone</td>
                                <td>@asset.Division</td>
                                <td>@asset.SiteName</td>
                                <td>@asset.AssetTypeName</td>
                                <td>@asset.RailwayAssetMake</td>
                                <td class="text-center">@asset.Count</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
