        // Asset Type line
        _auLineAtKeys = Object.keys(data.assetTypeGroups).sort(function (a, b) { return data.assetTypeGroups[b].totalOps - data.assetTypeGroups[a].totalOps; });
        _auLineAtOps = {};
        _auLineAtKeys.forEach(function (at) { _auLineAtOps[at] = data.assetTypeGroups[at].totalOps; });

