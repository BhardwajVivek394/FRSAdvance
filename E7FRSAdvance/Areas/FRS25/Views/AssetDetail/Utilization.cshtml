    function auDestroyAllCharts() {
        auChartList.forEach(function (c) { if (c) c.destroy(); });
        auChartList = [];
        if (auChart) { auChart.destroy(); auChart = null; }
    }

    // ==========================================================================
    // EXTRACT DATA FROM #tblUtilization
    // Cols: 0=Sr 1=Zone 2=Division 3=Station 4=AssetType 5=AssetNumber 6=Ops
    // ==========================================================================
    function extractAuData() {
        var data = {
            rows: [], assetGroups: {}, assetNumOrder: [],
            stationGroups: {}, stationOrder: [],
            assetTypeGroups: {}, totalOps: 0, assetCount: 0,
            // Per-station asset breakdown (grouped by station name only)
            stationOnly: {}, stationOnlyOrder: [],
            // Per-assetType asset breakdown
            assetTypeOnly: {}, assetTypeOnlyOrder: []
        };
        var stSet = {}, assetSet = {}, stOnlySet = {}, atOnlySet = {};

        $('#tblUtilization tbody tr').each(function () {
            var $tds = $(this).find('td');
            if ($tds.length < 7 || $(this).find('td[colspan]').length) return;
            var zone = $.trim($tds.eq(1).text());
            var division = $.trim($tds.eq(2).text());
            var station = $.trim($tds.eq(3).text());
            var assetType = $.trim($tds.eq(4).text());
            var assetNum = $.trim($tds.eq(5).text());
            var ops = parseInt($.trim($tds.eq(6).text())) || 0;

            data.rows.push({ zone: zone, division: division, station: station, assetType: assetType, assetNumber: assetNum, ops: ops });

            // Asset groups (for line graph)
            if (!data.assetGroups[assetNum]) {
                data.assetGroups[assetNum] = { ops: 0, station: station, assetType: assetType, zone: zone, division: division };
            }
            data.assetGroups[assetNum].ops += ops;
            if (!assetSet[assetNum]) { assetSet[assetNum] = true; data.assetNumOrder.push(assetNum); }

            // Station groups (station+assetType key — for line graph)
            var stKey = station + ' (' + assetType + ')';
            if (!stSet[stKey]) {
                stSet[stKey] = true;
                data.stationOrder.push(stKey);
                data.stationGroups[stKey] = { totalOps: 0, station: station, assetType: assetType, zone: zone, division: division, assets: [] };
            }
            data.stationGroups[stKey].totalOps += ops;
            if (data.stationGroups[stKey].assets.indexOf(assetNum) === -1) data.stationGroups[stKey].assets.push(assetNum);

            // Asset type groups (for line graph)
            if (!data.assetTypeGroups[assetType]) data.assetTypeGroups[assetType] = { totalOps: 0, assets: [] };
            data.assetTypeGroups[assetType].totalOps += ops;
            if (data.assetTypeGroups[assetType].assets.indexOf(assetNum) === -1) data.assetTypeGroups[assetType].assets.push(assetNum);

            // ── Station-only grouping (for pie: one chart per station) ──
            if (!stOnlySet[station]) {
                stOnlySet[station] = true;
                data.stationOnlyOrder.push(station);
                data.stationOnly[station] = { totalOps: 0, zone: zone, division: division, assetOps: {}, assetOrder: [] };
            }
            var so = data.stationOnly[station];
            so.totalOps += ops;
            if (!so.assetOps[assetNum]) { so.assetOps[assetNum] = 0; so.assetOrder.push(assetNum); }
            so.assetOps[assetNum] += ops;

            // ── AssetType-only grouping (for pie: one chart per asset type) ──
            if (!atOnlySet[assetType]) {
                atOnlySet[assetType] = true;
                data.assetTypeOnlyOrder.push(assetType);
                data.assetTypeOnly[assetType] = { totalOps: 0, assetOps: {}, assetOrder: [] };
            }
            var ao = data.assetTypeOnly[assetType];
            ao.totalOps += ops;
            if (!ao.assetOps[assetNum]) { ao.assetOps[assetNum] = 0; ao.assetOrder.push(assetNum); }
            ao.assetOps[assetNum] += ops;

            data.totalOps += ops;
            data.assetCount++;
        });
        return data;
    }

    // ==========================================================================
    // MAIN DISPATCHER
    // ==========================================================================
    function renderAuView(view) {
        auDestroyAllCharts();
        if (!view || view === 'Table') {
            $('#listView').show(); $('#auChartContainer').hide().empty(); return;
        }
        $('#listView').hide(); $('#auChartContainer').show().empty();
        var data = extractAuData();
        if (!data.rows.length) { auNoData(); return; }
        if (view === 'Bar') renderAuBar(data);
        else if (view === 'Pie') renderAuPie(data);
        else if (view === 'Graph') renderAuGraph(data);
    }

    function auHexToRgba(hex, alpha) {
        hex = hex.replace('#', '');
        return 'rgba(' + parseInt(hex.substring(0, 2), 16) + ',' + parseInt(hex.substring(2, 4), 16) + ',' + parseInt(hex.substring(4, 6), 16) + ',' + alpha + ')';
    }
    function auNoData() {
        $('#auChartContainer').html('<div style="height:280px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#94a3b8;font-size:15px;"><i class="fas fa-chart-pie" style="font-size:44px;margin-bottom:14px;color:#cbd5e1;"></i><p style="margin:0;">No data available for visualization.</p></div>');
    }
    function auCreateBox(title, iconClass, height, canvasId) {
        var $box = $('<div></div>').css({ padding: '20px', background: '#fff', borderRadius: '12px', boxShadow: '0 2px 14px rgba(0,0,0,0.07)', marginBottom: '16px' });
        $box.append('<h5 style="margin:0 0 14px;font-size:15px;font-weight:600;color:#1e293b;"><i class="' + iconClass + ' mr-2" style="color:#6366f1;font-size:14px;"></i>' + title + '</h5>');
        var $wrap = $('<div></div>').css({ position: 'relative', height: height + 'px', width: '100%' });
        var $canvas = $('<canvas id="' + canvasId + '"></canvas>');
        $wrap.append($canvas); $box.append($wrap); $('#auChartContainer').append($box);
        return $canvas[0].getContext('2d');
    }

    // ==========================================================================
    // PIE VIEW
    // Station-wise   : one chart per station, paginated (3 per page)
    // Asset Type-wise: one chart per asset type, paginated (3 per page)
    // Asset Number   : all assets combined in ONE chart (no pagination)
    // ==========================================================================
    var _auPieData = null;
    var auStPiePg = 1, AU_ST_PER_PG = 3;
    var auAtPiePg = 1, AU_AT_PER_PG = 3;

    function renderAuPie(data) {
        if (!data.rows.length) { auNoData(); return; }
        _auPieData = data;
        auStPiePg = 1;
        auAtPiePg = 1;

        var $c = $('#auChartContainer').empty();

        // ── Section heading ──
        function secHd(icon, color, text) {
            return $('<div></div>').css({
                fontSize: '13px', fontWeight: '600', color: color,
                textTransform: 'uppercase', letterSpacing: '0.06em',
                margin: '4px 0 14px', display: 'flex', alignItems: 'center', gap: '8px'
            }).html('<i class="' + icon + '" style="font-size:11px;"></i> ' + text);
        }

        // ── SECTION 1: Station-wise (paginated) ──
        if (data.stationOnlyOrder.length > 0) {
            $c.append(secHd('fas fa-map-marker-alt', '#6366f1', 'Station-wise'));
            $c.append('<div id="auStChartArea"></div>');
            $c.append('<div id="auStPagerArea"></div>');
            drawAuStPiePage();
        }

        // ── SECTION 2: Asset Type-wise (paginated) ──
        if (data.assetTypeOnlyOrder.length > 0) {
            $c.append(secHd('fas fa-layer-group', '#3b82f6', 'Asset Type-wise'));
            $c.append('<div id="auAtChartArea"></div>');
            $c.append('<div id="auAtPagerArea"></div>');
            drawAuAtPiePage();
        }

        // ── SECTION 3: Asset Number-wise — ONE combined chart ──
        var anLabels = data.assetNumOrder;
        var anVals = anLabels.map(function (k) { return data.assetGroups[k].ops; });
        if (anLabels.length > 0) {
            $c.append(secHd('fas fa-hashtag', '#f59e0b', 'Asset Number-wise (All)'));
            auRenderBarDonut($c,
                'All Assets — Operations', anLabels, anVals,
                [{ label: 'Total Operations', val: data.totalOps },
                { label: 'Asset Numbers', val: anLabels.length },
                { label: 'Avg per Asset', val: (data.totalOps / Math.max(anLabels.length, 1)).toFixed(1) }],
                'auPieAn', false);
        }
    }

    // ── Draw one page of station charts ──────────────────────────────────────
    function drawAuStPiePage() {
        auDestroyAllCharts();
        var data = _auPieData;
        var all = data.stationOnlyOrder;
        var total = all.length;
        var start = (auStPiePg - 1) * AU_ST_PER_PG;
        var page = all.slice(start, start + AU_ST_PER_PG);
        var $area = $('#auStChartArea').empty();

        page.forEach(function (station, idx) {
            var so = data.stationOnly[station];
            var anKeys = so.assetOrder;
            var anVals = anKeys.map(function (k) { return so.assetOps[k]; });
            auRenderBarDonut($area,
                station + ' — Operations by Asset Number',
                anKeys, anVals,
                [{ label: 'Station', val: station },
                { label: 'Total Ops', val: so.totalOps },
                { label: 'Assets', val: anKeys.length }],
                'auPieSt' + (start + idx), true);
        });

        buildAuSectionPager('auStPagerArea', auStPiePg,
            Math.ceil(total / AU_ST_PER_PG), total,
            start + 1, Math.min(start + AU_ST_PER_PG, total),
            function (pg) { auStPiePg = pg; drawAuStPiePage(); });
    }

    // ── Draw one page of asset-type charts ───────────────────────────────────
    function drawAuAtPiePage() {
        var data = _auPieData;
        var all = data.assetTypeOnlyOrder;
        var total = all.length;
        var start = (auAtPiePg - 1) * AU_AT_PER_PG;
        var page = all.slice(start, start + AU_AT_PER_PG);
        var $area = $('#auAtChartArea').empty();

        page.forEach(function (assetType, idx) {
            var ao = data.assetTypeOnly[assetType];
            var anKeys = ao.assetOrder;
            var anVals = anKeys.map(function (k) { return ao.assetOps[k]; });
            auRenderBarDonut($area,
                assetType + ' — Operations by Asset Number',
                anKeys, anVals,
                [{ label: 'Asset Type', val: assetType },
                { label: 'Total Ops', val: ao.totalOps },
                { label: 'Assets', val: anKeys.length }],
                'auPieAt' + (start + idx), true);
        });

        buildAuSectionPager('auAtPagerArea', auAtPiePg,
            Math.ceil(total / AU_AT_PER_PG), total,
            start + 1, Math.min(start + AU_AT_PER_PG, total),
            function (pg) { auAtPiePg = pg; drawAuAtPiePage(); });
    }

    // ── Bootstrap pager (matches table pager style) ──────────────────────────
    function buildAuSectionPager(wrapperId, currentPg, totalPgs, totalRec, showFrom, showTo, onPageClick) {
        var $wrap = $('#' + wrapperId).empty();
        if (totalPgs <= 1 && totalRec <= 0) return;

        var $row = $('<div></div>').css({
            display: 'flex', justifyContent: 'space-between', alignItems: 'center',
            padding: '12px 4px', borderTop: '1px solid #e5e7eb', marginBottom: '20px'
        });
        $row.append('<div style="font-size:13px;color:#6c757d;">Showing <strong>' + showFrom + '</strong> to <strong>' + showTo + '</strong> of <strong>' + totalRec + '</strong> records</div>');

        if (totalPgs > 1) {
            var $ul = $('<ul class="pagination mb-0"></ul>');

            // Previous
            var $prev = $('<li class="page-item' + (currentPg <= 1 ? ' disabled' : '') + '"><a class="page-link" href="javascript:void(0);">&#8592; Previous</a></li>');
            if (currentPg > 1) $prev.find('a').on('click', function () { onPageClick(currentPg - 1); });
            $ul.append($prev);

            // Page numbers
            var pages = [];
            if (totalPgs <= 7) { for (var i = 1; i <= totalPgs; i++) pages.push(i); }
            else {
                pages.push(1);
                if (currentPg > 3) pages.push('...');
                for (var i = Math.max(2, currentPg - 1); i <= Math.min(totalPgs - 1, currentPg + 1); i++) { if (pages.indexOf(i) === -1) pages.push(i); }
                if (currentPg < totalPgs - 2) pages.push('...');
                if (pages.indexOf(totalPgs) === -1) pages.push(totalPgs);
            }
            pages.forEach(function (p) {
                if (p === '...') { $ul.append('<li class="page-item disabled"><span class="page-link">...</span></li>'); }
                else {
                    var $li = $('<li class="page-item' + (p === currentPg ? ' active' : '') + '"><a class="page-link" href="javascript:void(0);">' + p + '</a></li>');
                    if (p !== currentPg) { (function (pg) { $li.find('a').on('click', function () { onPageClick(pg); }); })(p); }
                    $ul.append($li);
                }
            });

            // Next
            var $next = $('<li class="page-item' + (currentPg >= totalPgs ? ' disabled' : '') + '"><a class="page-link" href="javascript:void(0);">Next &#8594;</a></li>');
            if (currentPg < totalPgs) $next.find('a').on('click', function () { onPageClick(currentPg + 1); });
            $ul.append($next);

            $row.append($('<nav></nav>').append($ul));
        }
        $wrap.append($row);
    }

    // Build one panel: Summary cards + Bar chart + Legend strip + Doughnut
    // addToGlobal=true → push charts to auChartList so they are destroyed on next render
    function auRenderBarDonut($container, sectionTitle, labels, values, summaryCards, idPrefix, addToGlobal) {
        var colors = labels.map(function (_, i) { return auChartColors[i % auChartColors.length]; });
        var total = values.reduce(function (a, b) { return a + b; }, 0) || 1;

        var $panel = $('<div></div>').css({
            padding: '24px', background: '#fff', borderRadius: '12px',
            boxShadow: '0 2px 12px rgba(0,0,0,0.08)', marginBottom: '20px'
        });

        // ── Section heading ──
        $panel.append(
            '<div style="font-size:15px;font-weight:600;color:#1e293b;border-bottom:2px solid #e5e7eb;padding-bottom:10px;margin-bottom:20px;">' +
            '<i class="fas fa-chart-bar mr-2" style="color:#6366f1;font-size:13px;"></i>' + sectionTitle + '</div>'
        );

        // ── Summary cards ──
        var cardHtml = '<div style="display:grid;grid-template-columns:repeat(' + summaryCards.length + ',1fr);gap:12px;margin-bottom:24px;">';
        summaryCards.forEach(function (card) {
            cardHtml += '<div style="background:#f8fafc;border-radius:8px;padding:14px 16px;border:1px solid #e5e7eb;">' +
                '<div style="font-size:11px;color:#64748b;text-transform:uppercase;letter-spacing:0.04em;margin-bottom:6px;">' + card.label + '</div>' +
                '<div style="font-size:22px;font-weight:600;color:#1e293b;">' + (typeof card.val === 'number' ? card.val.toLocaleString() : card.val) + '</div>' +
                '</div>';
        });
