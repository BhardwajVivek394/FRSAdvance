    // Generic Canvas line renderer (single line, generic X labels)
    function drawAuLineCanvas(canvas, wrapper, xKeys, valFn, lineColor, metaFn, xLabelFn, hoverIdx) {
        var PAD_L = 58, PAD_R = 24, PAD_T = 28, PAD_B = 120, INNER_H = 260;
        var colW = Math.min(120, Math.max(60, Math.floor(900 / Math.max(xKeys.length, 1))));
        var INNER_W = colW * xKeys.length;
        var CW = INNER_W + PAD_L + PAD_R, CH = INNER_H + PAD_T + PAD_B;
        canvas.width = CW; canvas.height = CH;
        canvas.style.width = CW + 'px'; canvas.style.height = CH + 'px';
        wrapper.style.height = CH + 'px';
        canvas._layout = { PAD_L: PAD_L, PAD_T: PAD_T, INNER_W: INNER_W, INNER_H: INNER_H, colW: colW };
        canvas._xKeys = xKeys; canvas._valFn = valFn; canvas._lineColor = lineColor; canvas._xLabelFn = xLabelFn; canvas._metaFn = metaFn;
        redrawAuLine(canvas, hoverIdx);
    }

    function redrawAuLine(canvas, hoverIdx) {
        if (!canvas._layout) return;
        var L = canvas._layout, PAD_L = L.PAD_L, PAD_T = L.PAD_T, INNER_W = L.INNER_W, INNER_H = L.INNER_H, colW = L.colW;
        var xKeys = canvas._xKeys, valFn = canvas._valFn, lineColor = canvas._lineColor, xLabelFn = canvas._xLabelFn;
        var ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, canvas.width, canvas.height);

        var maxVal = 1;
        xKeys.forEach(function (k) { var v = valFn(k); if (v > maxVal) maxVal = v; });
        var yMax = maxVal + Math.max(1, Math.ceil(maxVal * 0.12));
        var yStep = yMax <= 10 ? 1 : Math.ceil(yMax / 8);
        canvas._yMax = yMax;

        var xPos = xKeys.map(function (k, i) { return PAD_L + i * colW + colW / 2; });
        canvas._xPos = xPos;

        // Grid + Y ticks
        ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
        ctx.font = '11px Segoe UI,Arial,sans-serif';
        for (var yv = 0; yv <= yMax; yv += yStep) {
            var gy = PAD_T + INNER_H - (yv / yMax) * INNER_H;
            ctx.strokeStyle = '#e5e7eb'; ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(PAD_L, gy); ctx.lineTo(PAD_L + INNER_W, gy); ctx.stroke();
            ctx.fillStyle = '#64748b'; ctx.fillText(yv, PAD_L - 6, gy);
        }
        // Y label
        ctx.save(); ctx.translate(14, PAD_T + INNER_H / 2); ctx.rotate(-Math.PI / 2);
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.font = '12px Segoe UI,Arial,sans-serif'; ctx.fillStyle = '#475569';
        ctx.fillText('Operations', 0, 0); ctx.restore();
        // Axes
        ctx.strokeStyle = '#94a3b8'; ctx.lineWidth = 1.5;
        ctx.beginPath(); ctx.moveTo(PAD_L, PAD_T); ctx.lineTo(PAD_L, PAD_T + INNER_H); ctx.lineTo(PAD_L + INNER_W, PAD_T + INNER_H); ctx.stroke();

        // Hover highlight
        if (hoverIdx !== undefined && hoverIdx >= 0 && hoverIdx < xKeys.length) {
            var hx = xPos[hoverIdx];
            ctx.fillStyle = 'rgba(99,102,241,0.07)'; ctx.fillRect(hx - colW / 2, PAD_T, colW, INNER_H);
            ctx.strokeStyle = 'rgba(99,102,241,0.3)'; ctx.lineWidth = 1; ctx.setLineDash([4, 4]);
            ctx.beginPath(); ctx.moveTo(hx, PAD_T); ctx.lineTo(hx, PAD_T + INNER_H); ctx.stroke();
            ctx.setLineDash([]);
        }

        // X tick marks
        xPos.forEach(function (x) { ctx.strokeStyle = '#94a3b8'; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(x, PAD_T + INNER_H); ctx.lineTo(x, PAD_T + INNER_H + 5); ctx.stroke(); });

        // Line + dots
        var pts = xKeys.map(function (k, i) { var v = valFn(k); return { x: xPos[i], y: PAD_T + INNER_H - (v / yMax) * INNER_H, val: v }; });
        ctx.strokeStyle = lineColor; ctx.lineWidth = 2.2; ctx.lineJoin = 'round'; ctx.lineCap = 'round';
        ctx.beginPath(); pts.forEach(function (p, i) { i === 0 ? ctx.moveTo(p.x, p.y) : ctx.lineTo(p.x, p.y); }); ctx.stroke();
        pts.forEach(function (p) {
            ctx.beginPath(); ctx.arc(p.x, p.y, 5, 0, 2 * Math.PI);
            ctx.fillStyle = '#fff'; ctx.fill();
            ctx.strokeStyle = lineColor; ctx.lineWidth = 2.5; ctx.stroke();
            if (p.val > 0) { ctx.fillStyle = lineColor; ctx.font = 'bold 10px Segoe UI,Arial,sans-serif'; ctx.textAlign = 'center'; ctx.textBaseline = 'bottom'; ctx.fillText(p.val, p.x, p.y - 8); }
        });

        // X labels rotated
        xKeys.forEach(function (k, i) {
            var x = xPos[i], yBase = PAD_T + INNER_H + 10;
            var lines = (xLabelFn(k) || '').split('\n');
            ctx.save(); ctx.translate(x, yBase); ctx.rotate(Math.PI / 4);
            ctx.textAlign = 'left'; ctx.textBaseline = 'top';
            ctx.font = 'bold 10px Segoe UI,Arial,sans-serif'; ctx.fillStyle = '#1e293b';
            ctx.fillText(lines[0] || '', 0, 0);
            if (lines[1]) { ctx.font = '9px Segoe UI,Arial,sans-serif'; ctx.fillStyle = '#94a3b8'; ctx.fillText(lines[1], 0, 13); }
            ctx.restore();
        });
    }

    function handleAuLineHover(e, canvas, xKeys, valFn, lineColor, tooltipFn) {
        if (!canvas._layout || !canvas._xPos) return;
        var L = canvas._layout; var rect = canvas.getBoundingClientRect();
        var mx = e.clientX - rect.left, my = e.clientY - rect.top;
        var closest = -1, minDist = L.colW;
        canvas._xPos.forEach(function (x, i) { var d = Math.abs(mx - x); if (d < minDist) { minDist = d; closest = i; } });
        if (closest === -1 || my < L.PAD_T || my > L.PAD_T + L.INNER_H) { $('#auPieTooltip').removeClass('show'); redrawAuLine(canvas); return; }
        redrawAuLine(canvas, closest);
        var $tt = $('#auPieTooltip');
        $tt.html(tooltipFn(xKeys[closest])).addClass('show');
        var x = e.clientX + 16, y = e.clientY + 16;
        if (x + 220 > window.innerWidth) x = e.clientX - 230;
        if (y + $tt.outerHeight() > window.innerHeight) y = e.clientY - $tt.outerHeight() - 8;
        $tt.css({ left: x + 'px', top: y + 'px' });
    }

    // ==========================================================================
    // EXCEL DOWNLOAD
    // ==========================================================================
    function fnDownloadExcel() {
        var table = document.querySelector('#tblUtilization');
        if (!table) { alert('No data available to download'); return; }
        try {
            $("#loader").show();
            var workbook = new ExcelJS.Workbook(); workbook.creator = 'RDPMS'; workbook.created = new Date();
            var worksheet = workbook.addWorksheet('Asset Utilization'); var colCount = 7;
            var fd = $('#txtFromDate').val() || '', td = $('#txtToDate').val() || '';

            var titleRow = worksheet.addRow(['Asset Utilization Report']); titleRow.height = 30;
            worksheet.mergeCells(1, 1, 1, colCount);
            titleRow.getCell(1).fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF4F46E5' } };
            titleRow.getCell(1).font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 16, name: 'Calibri' };
            titleRow.getCell(1).alignment = { vertical: 'middle', horizontal: 'center' };

            var dateRow = worksheet.addRow(['Period: ' + fd + ' to ' + td + ' | Generated: ' + new Date().toLocaleString()]); dateRow.height = 20;
            worksheet.mergeCells(2, 1, 2, colCount);
            dateRow.getCell(1).font = { italic: true, size: 10, color: { argb: 'FF64748B' } };
            dateRow.getCell(1).alignment = { horizontal: 'center' };
            worksheet.addRow([]);

            var headers = ['Sr.No', 'Zone', 'Division', 'Station', 'Asset Type', 'Asset Number', 'Number of Operations'];
            var headerRow = worksheet.addRow(headers); headerRow.height = 30;
            headerRow.eachCell(function (cell) {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1E3A5F' } };
                cell.font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11, name: 'Calibri' };
                cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
                cell.border = { top: { style: 'medium', color: { argb: 'FF1E3A5F' } }, left: { style: 'medium', color: { argb: 'FF1E3A5F' } }, bottom: { style: 'medium', color: { argb: 'FF1E3A5F' } }, right: { style: 'medium', color: { argb: 'FF1E3A5F' } } };
            });

            var $allRows = $('#tblUtilization tbody tr'); $allRows.show(); var dataIdx = 0;
            $allRows.each(function () {
                var $tr = $(this); if ($tr.find('td[colspan]').length) return; dataIdx++;
                var rowData = []; $tr.find('td').each(function (i) { if (i < 7) rowData.push($(this).text().replace(/(\r\n|\n|\r)/gm, ' ').trim()); });
                var excelRow = worksheet.addRow(rowData); excelRow.height = 22;
                excelRow.eachCell(function (cell, col) {
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: dataIdx % 2 === 0 ? 'FFF1F5F9' : 'FFFFFFFF' } };
                    cell.font = { size: 10, name: 'Calibri' };
                    cell.alignment = { vertical: 'middle', horizontal: col <= 4 ? (col === 1 ? 'center' : 'left') : 'center' };
                    cell.border = { top: { style: 'thin', color: { argb: 'FFE2E8F0' } }, left: { style: 'thin', color: { argb: 'FFE2E8F0' } }, bottom: { style: 'thin', color: { argb: 'FFE2E8F0' } }, right: { style: 'thin', color: { argb: 'FFE2E8F0' } } };
                });
            });
            if (typeof goToPage === 'function') goToPage(1);
            [8, 14, 16, 20, 20, 20, 22].forEach(function (w, i) { worksheet.getColumn(i + 1).width = w; });

            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), getFileName('xlsx'));
                $("#loader").hide(); CommonNotification("SUCCESS", "Excel downloaded successfully!", "Success");
            });
        } catch (err) { $("#loader").hide(); console.error('Excel Error:', err); CommonNotification("ERROR", "Error downloading Excel", "Error"); }
    }

    // ==========================================================================
    // CSV DOWNLOAD
    // ==========================================================================
    function fnDownloadCSV() {
        var table = document.querySelector('#tblUtilization');
        if (!table) { alert('No data available to download'); return; }
        try {
            $("#loader").show();
            var headers = ['Sr.No', 'Zone', 'Division', 'Station', 'Asset Type', 'Asset Number', 'Number of Operations'];
            var csv = [headers.map(function (h) { return '"' + h + '"'; }).join(',')];
            var $allRows = $('#tblUtilization tbody tr'); $allRows.show();
            $allRows.each(function () {
                var $tr = $(this); if ($tr.find('td[colspan]').length) return;
                var rowData = []; $tr.find('td').each(function (i) { if (i < 7) rowData.push('"' + $(this).text().replace(/(\r\n|\n|\r)/gm, ' ').trim().replace(/"/g, '""') + '"'); });
                csv.push(rowData.join(','));
            });
            if (typeof goToPage === 'function') goToPage(1);
            saveAs(new Blob(['\uFEFF' + csv.join('\n')], { type: 'text/csv;charset=utf-8;' }), getFileName('csv'));
            $("#loader").hide(); CommonNotification("SUCCESS", "CSV downloaded successfully!", "Success");
        } catch (err) { $("#loader").hide(); console.error('CSV Error:', err); CommonNotification("ERROR", "Error downloading CSV", "Error"); }
    }

    function getFileName(ext) {
        var now = new Date();
        return 'AssetUtilization_' + now.getFullYear() + String(now.getMonth() + 1).padStart(2, '0') + String(now.getDate()).padStart(2, '0') + '_' + String(now.getHours()).padStart(2, '0') + String(now.getMinutes()).padStart(2, '0') + '.' + ext;
    }
</script>
