@model Domain.AssetLister
@{ ViewBag.Title = "Asset Utilization";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml"; }

<style>
    .search-section {
        padding: 20px 25px;
        position: relative;
        z-index: 100;
    }

    .search-title {
        font-size: 18px;
        font-weight: 600;
        color: #333;
        margin-bottom: 20px;
    }

    .filter-row {
        display: flex;
        align-items: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        position: relative;
        z-index: 100;
    }

    .filter-item {
        flex-shrink: 0;
        position: relative;
        z-index: 100;
    }

        .filter-item label {
            display: block;
            font-size: 13px;
            color: #555;
            margin-bottom: 6px;
            font-weight: 500;
        }

    .select-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        color: #333;
        cursor: pointer;
        min-width: 170px;
        height: 40px;
    }

        .select-btn:hover {
            border-color: #999;
        }

        .select-btn.active {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59,130,246,0.2);
        }

        .select-btn .text {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: left;
        }

        .select-btn i {
            margin-left: 8px;
            font-size: 12px;
            color: #666;
        }

    .filter-dropdown {
        position: fixed;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 6px 24px rgba(0,0,0,0.18);
        min-width: 260px;
        max-width: 320px;
        z-index: 9999;
        display: none;
    }

        .filter-dropdown.open {
            display: block;
        }

    .dropdown-search {
        padding: 10px 12px;
        border-bottom: 1px solid #e0e0e0;
    }

        .dropdown-search input {
            width: 100%;
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 13px;
            outline: none;
        }

            .dropdown-search input:focus {
                border-color: #3b82f6;
            }

            .dropdown-search input::placeholder {
                color: #aaa;
            }

    .dropdown-header {
        padding: 10px 14px;
        background: #f5f5f5;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .dropdown-header input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #3b82f6;
        }

        .dropdown-header label {
            font-size: 14px;
            font-weight: 600;
            color: #333;
            cursor: pointer;
            margin: 0;
        }

    .dropdown-list {
        max-height: 250px;
        overflow-y: auto;
    }

    .dropdown-item {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.15s;
    }

        .dropdown-item:last-child {
            border-bottom: none;
        }

        .dropdown-item:hover {
            background: #f5f7fa;
        }

        .dropdown-item.checked {
            background: #e8f2ff;
        }

        .dropdown-item.hidden {
            display: none;
        }

        .dropdown-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #3b82f6;
            flex-shrink: 0;
        }

        .dropdown-item span {
            font-size: 14px;
            color: #333;
        }

        .dropdown-item.checked span {
            color: #1d4ed8;
            font-weight: 500;
        }

        .dropdown-item span mark {
            background: #fef08a;
            color: #333;
            padding: 0;
            border-radius: 2px;
        }

    .dropdown-empty {
        padding: 25px;
        text-align: center;
        color: #888;
        font-size: 14px;
    }

    .dropdown-no-results {
        padding: 20px;
        text-align: center;
        color: #999;
        font-size: 13px;
        display: none;
    }

        .dropdown-no-results.show {
            display: block;
        }

    .filter-input {
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        height: 40px;
        width: 120px;
        outline: none;
        background: #fff;
    }

        .filter-input:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59,130,246,0.2);
        }

    .btn-search {
        background: var(--primary);
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        color: #fff;
        font-size: 14px;
        font-weight: 500;
    }

    .dropdown-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9998;
        display: none;
    }

        .dropdown-backdrop.show {
            display: block;
        }

    .table-border {
        position: relative;
        z-index: 1;
    }

    /* ===== STATION-WISE PIE CHART STYLES ===== */
    .au-pie-panel {
        padding: 24px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        margin: 15px;
    }

    .au-pie-section-title {
        font-size: 15px;
        font-weight: 600;
        color: #1e293b;
        margin: 0 0 16px;
        padding-bottom: 10px;
        border-bottom: 2px solid #e5e7eb;
    }

    .au-pie-chart-title {
        text-align: center;
        margin-bottom: 18px;
        font-size: 13px;
        color: #555;
        font-style: italic;
    }

    /* Pie Grid — 3 columns */
    .au-pie-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 32px 20px;
        margin-bottom: 16px;
    }

    /* Individual Pie Item */
    .au-pie-item {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .au-pie-ops-label {
        font-size: 13px;
        color: #444;
        font-weight: 500;
        margin-bottom: 8px;
        text-align: center;
    }

    .au-pie-container {
        position: relative;
        width: 160px;
        height: 160px;
        cursor: pointer;
    }

    .au-pie-svg {
        width: 100%;
        height: 100%;
    }

    .au-pie-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
        text-align: center;
        pointer-events: none;
    }

    .au-pie-pct-val {
        font-size: 22px;
        font-weight: 700;
        color: #1e293b;
        line-height: 1;
    }

    .au-pie-pct-sub {
        font-size: 9px;
        color: #888;
        margin-top: 2px;
    }

    .au-pie-info {
        text-align: center;
        margin-top: 10px;
    }

    .au-pie-station-name {
        font-size: 12px;
        font-weight: 600;
        color: #1e293b;
        max-width: 160px;
        word-break: break-word;
    }

    .au-pie-asset-type {
        font-size: 10px;
        color: #64748b;
    }

    /* Pager (matches table pager) */
    .au-pie-pager-wrap {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 16px;
        border-top: 1px solid #e5e7eb;
        margin-top: 12px;
    }

    .au-pie-pager-info {
        font-size: 13px;
        color: #6c757d;
    }

    /* No data */
    .au-pie-no-data {
        height: 260px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        font-size: 15px;
    }

        .au-pie-no-data i {
            font-size: 48px;
            margin-bottom: 15px;
            color: #cbd5e1;
        }

    /* Line Canvas */
    #auLineCanvasSt, #auLineCanvasAt {
        cursor: crosshair;
        display: block;
    }

    .au-line-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 18px;
        margin-top: 12px;
        padding: 0 4px;
    }

    .au-line-panel {
        padding: 24px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        margin: 0 0 20px;
    }

    .au-line-section-title {
        font-size: 15px;
        font-weight: 600;
        color: #1e293b;
        margin: 0 0 14px;
        padding-bottom: 10px;
        border-bottom: 2px solid #e5e7eb;
    }

    /* Tooltip */
    .au-pie-tooltip {
        display: none;
        position: fixed;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 12px 16px;
        box-shadow: 0 4px 16px rgba(0,0,0,0.15);
        font-size: 12px;
        min-width: 190px;
        max-height: 260px;
        overflow-y: auto;
        z-index: 99999;
        pointer-events: none;
    }

        .au-pie-tooltip.show {
            display: block;
        }

    .au-tt-title {
        font-weight: 700;
        font-size: 13px;
        color: #1e293b;
        margin-bottom: 2px;
    }

    .au-tt-sub {
        font-size: 11px;
        color: #64748b;
        margin-bottom: 8px;
    }

    .au-tt-divider {
        border-top: 1px solid #f0f0f0;
        padding-top: 8px;
    }

    .au-tt-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 4px;
        font-size: 12px;
    }
</style>

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="row">
                        <div class="col-12 col-sm-5">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">Asset</li>
                                    <li class="breadcrumb-item active" aria-current="page"><a href="#">Asset Utilization</a></li>
                                </ol>
                            </nav>
                        </div>
                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                            <h2 class="page-name">Asset Utilization</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="search-section">
                        <div class="search-title">Search</div>
                        <div class="dropdown-backdrop" id="backdrop"></div>
                        <div class="filter-row">
                            <div class="filter-item">
                                <label>Zone</label>
                                <div class="select-btn" id="btnZone" data-target="ddZone">
                                    <span class="text" id="txtZone">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>
                            <div class="filter-item">
                                <label>Division</label>
                                <div class="select-btn" id="btnDivision" data-target="ddDivision">
                                    <span class="text" id="txtDivision">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>
                            <div class="filter-item">
                                <label>Station</label>
                                <div class="select-btn" id="btnSite" data-target="ddSite">
                                    <span class="text" id="txtSite">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>
                            <div class="filter-item">
                                <label>Asset Type</label>
                                <div class="select-btn" id="btnAssetType" data-target="ddAssetType">
                                    <span class="text" id="txtAssetType">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>
                            <div class="filter-item">
                                <label>Asset Number</label>
                                <div class="select-btn" id="btnAssetNumber" data-target="ddAssetNumber">
                                    <span class="text" id="txtAssetNumber">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>
                            <div class="filter-item">
                                <label>From Date</label>
                                <input type="text" class="filter-input" id="txtFromDate" placeholder="MM/DD/YYYY">
                            </div>
                            <div class="filter-item">
                                <label>To Date</label>
                                <input type="text" class="filter-input" id="txtToDate" placeholder="MM/DD/YYYY">
                            </div>
                            <div class="filter-item">
                                <label>View</label>
                                <div class="select-btn" id="btnViewType" data-target="ddViewType">
                                    <span class="text" id="txtViewType">Table</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>
                            <div class="filter-item">
                                <label>&nbsp;</label>
                                <button type="button" class="btn-search" onclick="fnGetAssetUtilizationReport()">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Zone Dropdown -->
                    <div class="filter-dropdown" id="ddZone">
                        <div class="dropdown-search"><input type="text" placeholder="Search zone..." onkeyup="filterDropdown('zone', this.value)"></div>
                        <div class="dropdown-header"><input type="checkbox" id="chkAllZone"><label for="chkAllZone">Select All</label></div>
                        <div class="dropdown-list" id="listZone">
                            @if (ViewBag.Zones != null)
                            {
                                foreach (var zone in (IEnumerable<SelectListItem>)ViewBag.Zones)
                                {
                                    <div class="dropdown-item" data-value="@zone.Value" data-text="@zone.Text">
                                        <input type="checkbox" class="cb-zone" value="@zone.Value">
                                        <span>@zone.Text</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>
                    <!-- Division Dropdown -->
                    <div class="filter-dropdown" id="ddDivision">
                        <div class="dropdown-search"><input type="text" placeholder="Search division..." onkeyup="filterDropdown('division', this.value)"></div>
                        <div class="dropdown-header"><input type="checkbox" id="chkAllDivision"><label for="chkAllDivision">Select All</label></div>
                        <div class="dropdown-list" id="listDivision">
                            @if (ViewBag.Divisions != null)
                            {
                                foreach (var division in (IEnumerable<SelectListItem>)ViewBag.Divisions)
                                {
                                    <div class="dropdown-item" data-value="@division.Value" data-text="@division.Text">
                                        <input type="checkbox" class="cb-division" value="@division.Value">
                                        <span>@division.Text</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>
                    <!-- Site Dropdown -->
                    <div class="filter-dropdown" id="ddSite">
                        <div class="dropdown-search"><input type="text" placeholder="Search station..." onkeyup="filterDropdown('site', this.value)"></div>
                        <div class="dropdown-header"><input type="checkbox" id="chkAllSite"><label for="chkAllSite">Select All</label></div>
                        <div class="dropdown-list" id="listSite">
                            @if (ViewBag.Sites != null)
                            {
                                foreach (var site in (IEnumerable<SelectListItem>)ViewBag.Sites)
                                {
                                    <div class="dropdown-item" data-value="@site.Value" data-text="@site.Text">
                                        <input type="checkbox" class="cb-site" value="@site.Value">
                                        <span>@site.Text</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>
                    <!-- Asset Type Dropdown -->
                    <div class="filter-dropdown" id="ddAssetType">
                        <div class="dropdown-search"><input type="text" placeholder="Search asset type..." onkeyup="filterDropdown('assetType', this.value)"></div>
                        <div class="dropdown-header"><input type="checkbox" id="chkAllAssetType"><label for="chkAllAssetType">Select All</label></div>
                        <div class="dropdown-list" id="listAssetType">
                            @if (ViewBag.AssetTypes != null)
                            {
                                foreach (var assettype in (IEnumerable<SelectListItem>)ViewBag.AssetTypes)
                                {
                                    <div class="dropdown-item" data-value="@assettype.Value" data-text="@assettype.Text">
                                        <input type="checkbox" class="cb-assetType" value="@assettype.Value">
                                        <span>@assettype.Text</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>
                    <!-- Asset Number Dropdown -->
                    <div class="filter-dropdown" id="ddAssetNumber">
                        <div class="dropdown-search"><input type="text" placeholder="Search asset number..." onkeyup="filterDropdown('assetNumber', this.value)"></div>
                        <div class="dropdown-header"><input type="checkbox" id="chkAllAssetNumber"><label for="chkAllAssetNumber">Select All</label></div>
                        <div class="dropdown-list" id="listAssetNumber">
                            <div class="dropdown-empty">Select Station &amp; Asset Type</div>
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>
                    <!-- View Type Dropdown -->
                    <div class="filter-dropdown" id="ddViewType">
                        <div class="dropdown-list" id="listViewType">
                            <div class="dropdown-item checked" data-value="Table" data-text="Table"><span>Table</span></div>
                            <div class="dropdown-item" data-value="Pie" data-text="Pie"><span>Pie</span></div>
                            <div class="dropdown-item" data-value="Bar" data-text="Bar"><span>Bar</span></div>
                            <div class="dropdown-item" data-value="Graph" data-text="Graph"><span>Graph</span></div>
                        </div>
                    </div>

                    <div class="table-border" id="divAlertDetailReport"></div>

                    <!-- Shared Pie Tooltip -->
                    <div class="au-pie-tooltip" id="auPieTooltip"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // ==========================================================================
    // GLOBALS
    // ==========================================================================
    var openDropdown = null;
    var debounceTimer = null;
    var auChart = null;
    var auChartList = [];
    var selectedViewType = 'Table';

    // Chart.js colors (Bar / Graph)
    var auChartColors = [
        '#6366f1', '#3b82f6', '#22c55e', '#f43f5e', '#f97316',
        '#eab308', '#14b8a6', '#8b5cf6', '#ec4899', '#06b6d4',
        '#a855f7', '#d946ef', '#f59e0b', '#84cc16', '#0ea5e9',
        '#e11d48', '#7c3aed', '#059669', '#dc2626', '#2563eb'
    ];

    // Pie state — station-wise
    var _auStPieItems = [], auStPiePage = 1;
    // Pie state — asset-type-wise
    var _auAtPieItems = [], auAtPiePage = 1;
    // Pie state — asset-number-wise
    var _auAnPieItems = [], auAnPiePage = 1;
    var AU_PIE_PER_PAGE = 6;
    var auTotalOps = 0;

    // Line/Graph Canvas state
    var _auLineSites = [], _auLineSiteMeta = {}, _auLineMatrix = {};
    var _auLineAtKeys = [], _auLineAtOps = {};
    var AU_LINE_COLORS = [
        '#6366f1', '#3b82f6', '#22c55e', '#f43f5e', '#f97316',
        '#eab308', '#14b8a6', '#8b5cf6', '#ec4899', '#06b6d4',
        '#a855f7', '#d946ef', '#f59e0b', '#84cc16', '#0ea5e9',
        '#e11d48', '#7c3aed', '#059669', '#dc2626', '#2563eb'
    ];

    // ==========================================================================
    // DOCUMENT READY
    // ==========================================================================
    $(document).ready(function () {
        $('#txtFromDate').datepicker({ dateFormat: 'mm/dd/yy', changeMonth: true, changeYear: true, onSelect: function (d) { $(this).val(d); } });
        $('#txtToDate').datepicker({ dateFormat: 'mm/dd/yy', changeMonth: true, changeYear: true, onSelect: function (d) { $(this).val(d); } });
        setDefaultDates();

        $('.select-btn').on('click', function (e) { e.stopPropagation(); toggleDD($(this).data('target'), this); });
        $('#backdrop').on('click', closeDD);

        $(document).on('click', '#ddZone .dropdown-item, #ddDivision .dropdown-item, #ddSite .dropdown-item, #ddAssetType .dropdown-item, #ddAssetNumber .dropdown-item', function (e) {
            e.stopPropagation();
            var $cb = $(this).find('input[type="checkbox"]');
            if (!$(e.target).is('input[type="checkbox"]')) $cb.prop('checked', !$cb.prop('checked'));
            $(this).toggleClass('checked', $cb.prop('checked'));
            var type = ($cb.attr('class') || '').replace('cb-', '');
            updateSelectAllState(type); updateText(type); onFilterChange(type);
        });

        $(document).on('click', '.dropdown-header', function (e) {
            e.stopPropagation();
            var $chk = $(this).find('input[type="checkbox"]');
            if ($(e.target).is('input[type="checkbox"]') || $(e.target).is('label')) {
                var id = $chk.attr('id') || '';
                var type = id.replace('chkAll', '').charAt(0).toLowerCase() + id.replace('chkAll', '').slice(1);
                selectAll(type, $chk.prop('checked')); return;
            }
            var newState = !$chk.prop('checked'); $chk.prop('checked', newState);
            var id2 = $chk.attr('id') || '';
            var type2 = id2.replace('chkAll', '').charAt(0).toLowerCase() + id2.replace('chkAll', '').slice(1);
            selectAll(type2, newState);
        });

        $(document).on('click', '#ddViewType .dropdown-item', function (e) {
            e.stopPropagation();
            $('#ddViewType .dropdown-item').removeClass('checked');
            $(this).addClass('checked');
            selectedViewType = $(this).data('value');
            $('#txtViewType').text($(this).data('text'));
            closeDD();
            if ($('#tblUtilization tbody tr').length > 0) renderAuView(selectedViewType);
        });

        $(document).on('click', '.dropdown-search', function (e) { e.stopPropagation(); });
    });

    // ==========================================================================
    // DATE HELPERS
    // ==========================================================================
    function setDefaultDates() {
        var today = new Date();
        $('#txtFromDate').datepicker('setDate', today); $('#txtToDate').datepicker('setDate', today);
        $('#txtFromDate').val(formatDate(today)); $('#txtToDate').val(formatDate(today));
    }
    function formatDate(date) {
        return String(date.getMonth() + 1).padStart(2, '0') + '/' + String(date.getDate()).padStart(2, '0') + '/' + date.getFullYear();
    }
    function updateRangeBar() {
        $('#dispFromDate').text($('#txtFromDate').val() || '—');
        $('#dispToDate').text($('#txtToDate').val() || '—');
    }

    // ==========================================================================
    // DROPDOWN HELPERS
    // ==========================================================================
    function filterDropdown(type, searchText) {
        var $dd = $('#dd' + capitalize(type));
        var $items = $dd.find('.dropdown-item');
        var $noRes = $dd.find('.dropdown-no-results');
        var search = searchText.toLowerCase().trim(); var visible = 0;
        $items.each(function () {
            var $item = $(this); var text = ($item.data('text') || $item.find('span').text()).toLowerCase();
            if (search === '' || text.indexOf(search) > -1) {
                $item.removeClass('hidden'); visible++;
                if (search !== '') {
                    var orig = $item.data('text') || $item.find('span').text();
                    $item.find('span').html(orig.replace(new RegExp('(' + escapeRegex(searchText) + ')', 'gi'), '<mark>$1</mark>'));
                } else { var ot = $item.data('text'); if (ot) $item.find('span').text(ot); }
            } else { $item.addClass('hidden'); }
        });
        $noRes.toggleClass('show', visible === 0 && search !== '');
    }
    function escapeRegex(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

    function toggleDD(id, btn) {
        if (openDropdown === id) { closeDD(); return; }
        closeDD();
        var $dd = $('#' + id); $('body').append($dd);
        var rect = btn.getBoundingClientRect();
        $dd.css({ position: 'absolute', visibility: 'hidden', display: 'block', top: '-9999px', left: '-9999px' });
        var ddH = $dd.outerHeight(), ddW = $dd.outerWidth();
        var top = rect.bottom + 4, left = rect.left;
        if (top + ddH > window.innerHeight) top = rect.top - ddH - 4;
        if (left + ddW > window.innerWidth) left = window.innerWidth - ddW - 8;
        $dd.css({ visibility: '', display: '', top: top + 'px', left: left + 'px' }).addClass('open');
        $(btn).addClass('active'); $('#backdrop').addClass('show'); openDropdown = id;
        setTimeout(function () { $dd.find('.dropdown-search input').focus(); }, 100);
    }
    function closeDD() {
        if (!openDropdown) return;
        var $dd = $('#' + openDropdown);
        $dd.find('.dropdown-search input').val('');
        $dd.find('.dropdown-item').removeClass('hidden');
        $dd.find('.dropdown-no-results').removeClass('show');
        $dd.find('.dropdown-item').each(function () { var t = $(this).data('text'); if (t) $(this).find('span').text(t); });
        $dd.removeClass('open'); $('.select-btn').removeClass('active'); $('#backdrop').removeClass('show'); openDropdown = null;
    }
    function selectAll(type, checked) {
        $('.cb-' + type).each(function () {
            var $item = $(this).closest('.dropdown-item');
            if (!$item.hasClass('hidden')) { $(this).prop('checked', checked); $item.toggleClass('checked', checked); }
        });
        updateText(type); onFilterChange(type);
    }
    function updateSelectAllState(type) {
        var $vis = $('#list' + capitalize(type) + ' .dropdown-item:not(.hidden)');
        $('#chkAll' + capitalize(type)).prop('checked', $vis.length > 0 && $vis.length === $vis.find('.cb-' + type + ':checked').length);
    }
    function updateText(type) {
        var $checked = $('.cb-' + type + ':checked'); var count = $checked.length;
        var text = count === 0 ? 'All' : count === 1
            ? ($checked.first().closest('.dropdown-item').data('text') || $checked.first().closest('.dropdown-item').find('span').text())
            : count + ' selected';
        $('#txt' + capitalize(type)).text(text);
    }
    function getValues(type) { var v = []; $('.cb-' + type + ':checked').each(function () { v.push($(this).val()); }); return v; }
    function capitalize(str) { return str.charAt(0).toUpperCase() + str.slice(1); }

    // ==========================================================================
    // CASCADING DROPDOWNS
    // ==========================================================================
    function onFilterChange(type) {
        if (type === 'zone') loadDivisions();
        else if (type === 'division') loadSites();
        else if (type === 'site' || type === 'assetType') debounceAssetNumbers();
    }
    function loadDivisions() {
        var zoneIds = getValues('zone');
        $('#listDivision').html('<div class="dropdown-empty">Loading...</div>');
        $('#chkAllDivision').prop('checked', false); $('#txtDivision').text('All');
        $('#listSite').html('<div class="dropdown-empty">Select Division first</div>');
        $('#chkAllSite').prop('checked', false); $('#txtSite').text('All');
        $('#listAssetNumber').html('<div class="dropdown-empty">Select Station &amp; Asset Type</div>');
        $('#chkAllAssetNumber').prop('checked', false); $('#txtAssetNumber').text('All');
        if (!zoneIds.length) { $('#listDivision').html('<div class="dropdown-empty">Select Zone first</div>'); return; }
        $.ajax({
            url: '/FRS25/AlertLive/GetDivisionByZoneId', type: 'POST', data: JSON.stringify({ SearchCriteria: { ZoneIds: zoneIds } }), contentType: 'application/json',
            success: function (data) {
                if (data && data.length) {
                    $('#listDivision').html(data.map(function (v) { return '<div class="dropdown-item" data-value="' + v.Id + '" data-text="' + v.Name + '"><input type="checkbox" class="cb-division" value="' + v.Id + '"><span>' + v.Name + '</span></div>'; }).join(''));
                } else $('#listDivision').html('<div class="dropdown-empty">No divisions found</div>');
            }, error: function () { $('#listDivision').html('<div class="dropdown-empty">Error loading divisions</div>'); }
        });
    }
    function loadSites() {
        var divIds = getValues('division');
        $('#listSite').html('<div class="dropdown-empty">Loading...</div>');
        $('#chkAllSite').prop('checked', false); $('#txtSite').text('All');
        $('#listAssetNumber').html('<div class="dropdown-empty">Select Station &amp; Asset Type</div>');
        $('#chkAllAssetNumber').prop('checked', false); $('#txtAssetNumber').text('All');
        if (!divIds.length) { $('#listSite').html('<div class="dropdown-empty">Select Division first</div>'); return; }
        $.ajax({
            url: '/FRS25/AlertLive/GetSiteByDivisionId', type: 'POST', data: JSON.stringify({ SearchCriteria: { DivisionIds: divIds } }), contentType: 'application/json',
            success: function (data) {
                if (data && data.length) {
                    $('#listSite').html(data.map(function (v) { return '<div class="dropdown-item" data-value="' + v.Id + '" data-text="' + v.Name + '"><input type="checkbox" class="cb-site" value="' + v.Id + '"><span>' + v.Name + '</span></div>'; }).join(''));
                } else $('#listSite').html('<div class="dropdown-empty">No stations found</div>');
            }, error: function () { $('#listSite').html('<div class="dropdown-empty">Error loading stations</div>'); }
        });
    }
    function debounceAssetNumbers() { if (debounceTimer) clearTimeout(debounceTimer); debounceTimer = setTimeout(loadAssetNumbers, 300); }
    function loadAssetNumbers() {
        var siteIds = getValues('site').filter(function (id) { return id && id !== '0'; });
        var typeIds = getValues('assetType').filter(function (id) { return id && id !== '0'; });
        $('#listAssetNumber').html('<div class="dropdown-empty">Select Station &amp; Asset Type</div>');
        $('#chkAllAssetNumber').prop('checked', false); $('#txtAssetNumber').text('All');
        if (!siteIds.length || !typeIds.length) return;
        $('#listAssetNumber').html('<div class="dropdown-empty">Loading...</div>');
        var allAssets = [], seen = {}, done = 0, total = siteIds.length * typeIds.length;
        siteIds.forEach(function (sid) {
            typeIds.forEach(function (tid) {
                $.ajax({
                    url: '/FRS25/AlertLive/GetAssestBy', type: 'POST', data: '{siteId:' + sid + ',assetTypeId:' + tid + '}', contentType: 'application/json', dataType: 'json',
                    success: function (data) {
                        if (data && data.length) data.forEach(function (item) { if (item && item.Id && !seen[item.Id]) { seen[item.Id] = true; allAssets.push({ Id: item.Id, Name: item.Name || item.AssetName || '' }); } });
                        if (++done >= total) renderAssetNumbers(allAssets);
                    }, error: function () { if (++done >= total) renderAssetNumbers(allAssets); }
                });
            });
        });
    }
    function renderAssetNumbers(assets) {
        assets.sort(function (a, b) { return (a.Name || '').localeCompare(b.Name || ''); });
        $('#listAssetNumber').html(assets.length
            ? assets.map(function (a) { return '<div class="dropdown-item" data-value="' + a.Id + '" data-text="' + a.Name + '"><input type="checkbox" class="cb-assetNumber" value="' + a.Id + '"><span>' + a.Name + '</span></div>'; }).join('')
            : '<div class="dropdown-empty">No assets found</div>');
    }

