            function (stKey) { var m = _auLineSiteMeta[stKey] || {}; return (m.station || stKey) + '\n' + (m.assetType || ''); });

        // ── Section 2: Asset Type-wise Line ──
        var $p2 = $('<div class="au-line-panel"></div>');
        $p2.append('<div class="au-line-section-title"><i class="fas fa-layer-group mr-2" style="color:#3b82f6;"></i>Asset Type-wise — Number of Operations (Line)</div>');
        var $w2 = $('<div style="overflow-x:auto;overflow-y:hidden;position:relative;"></div>');
        var $cv2 = $('<canvas id="auLineCanvasAt"></canvas>');
        $w2.append($cv2); $p2.append($w2); $c.append($p2);
        drawAuLineCanvas($cv2[0], $w2[0], _auLineAtKeys,
            function (at) { return _auLineAtOps[at] || 0; }, '#3b82f6',
            function (at) { return { title: at, sub: '' }; },
            function (at) { return at; });

        // ── Section 3: Asset Number-wise Line ──
        var $p3 = $('<div class="au-line-panel"></div>');
        $p3.append('<div class="au-line-section-title"><i class="fas fa-hashtag mr-2" style="color:#f59e0b;"></i>Asset Number-wise — Number of Operations (Line)</div>');
        var $w3 = $('<div style="overflow-x:auto;overflow-y:hidden;position:relative;"></div>');
        var $cv3 = $('<canvas id="auLineCanvasAn"></canvas>');
        $w3.append($cv3); $p3.append($w3); $c.append($p3);
        drawAuLineCanvas($cv3[0], $w3[0], _auLineAnKeys,
            function (an) { return _auLineAnOps[an] || 0; }, '#f59e0b',
            function (an) { var g = data.assetGroups[an] || {}; return { title: an, sub: (g.assetType || '') + (g.station ? ' | ' + g.station : '') }; },
            function (an) { var g = data.assetGroups[an] || {}; return an + '\n' + (g.station || ''); });

        // Mouse hover events — Section 1
        $cv1[0].addEventListener('mousemove', function (e) {
            handleAuLineHover(e, $cv1[0], _auLineSites,
                function (stKey) { return _auLineMatrix.stOps[stKey] || 0; }, '#6366f1',
                function (stKey) {
                    var m = _auLineSiteMeta[stKey] || {};
                    return '<div class="au-tt-title">' + (m.station || stKey) + '</div>' +
                        '<div class="au-tt-sub">' + (m.assetType || '') + (m.division ? ' | ' + m.division + ', ' + m.zone : '') + '</div>' +
                        '<div class="au-tt-divider"><div class="au-tt-row">Operations: <strong>' + (_auLineMatrix.stOps[stKey] || 0) + '</strong></div></div>';
                });
