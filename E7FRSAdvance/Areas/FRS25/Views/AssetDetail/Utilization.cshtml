        var fromDate = $('#txtFromDate').val(), toDate = $('#txtToDate').val();
        if (!siteIds.length) { alert('Station is required'); return; }
        if (!assetTypeIds.length) { alert('Asset Type is required'); return; }
        if (!fromDate || !toDate) { alert('From Date and To Date are required'); return; }

        var mAssetLister = {
            SearchCriteria: {
                ZoneIds: getValues('zone'), DivisionIds: getValues('division'),
                SiteIds: siteIds, AssetTypeIds: assetTypeIds,
                AssetIds: getValues('assetNumber'), StartDate: fromDate, EndDate: toDate
            }
        };

        auDestroyAllCharts();
        $("#loader").show();
        $('#divAlertDetailReport').html('<div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i><br/><small class="text-muted mt-2">Loading data...</small></div>');

        $.ajax({
            url: '/FRS25/AssetDetail/_Utilization', type: 'POST',
