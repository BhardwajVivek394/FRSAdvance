@model Domain.AssetLister

<div class="col">
    <div class="row">

        <!-- Date Range Bar + Download -->
        <div class="col-12 col-md-6">
            <div id="selectedRangeBar" style="
                display:flex; align-items:center; flex-wrap:wrap; gap:10px;
                background:linear-gradient(135deg,var(--e7-p-blue-2,#f0f4ff) 0%,var(--e7-p-blue,#e8f2ff) 100%);
                border:1.5px solid var(--e7-border-2,#c7d8f8); border-radius:10px;
                padding:10px 20px; margin-top:10px; margin-bottom:10px;
                box-shadow:var(--e7-shadow-soft,0 2px 8px rgba(59,130,246,0.08));
                width:100%; max-width:420px;
                position:relative; margin-left:10px;">

                <div style="position:absolute;left:0;top:0;bottom:0;width:4px;
                    background:linear-gradient(180deg,var(--e7-rail-from,#3b82f6),var(--e7-rail-to,#6366f1));
                    border-radius:10px 0 0 10px;"></div>

                <!-- FROM -->
                <div class="au-range-block" style="display:flex;align-items:center;gap:10px;padding-left:8px;">
                    <span style="font-size:11px;font-weight:700;letter-spacing:0.08em;
                        color:var(--e7-text-3,#6b7280);text-transform:uppercase;">From</span>
                    <div style="display:flex;align-items:center;gap:6px;background:var(--e7-surface,#fff);
                        border:1px solid var(--e7-border-2,#cbd5e1);border-radius:6px;padding:5px 12px;
                        box-shadow:var(--e7-shadow-soft,0 1px 3px rgba(0,0,0,0.06));">
                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
                            <rect x="1" y="3" width="14" height="12" rx="2" style="stroke:var(--e7-accent,#3b82f6)" stroke="#3b82f6" stroke-width="1.4" />
                            <path d="M1 7h14" style="stroke:var(--e7-accent,#3b82f6)" stroke="#3b82f6" stroke-width="1.2" />
                            <path d="M5 1v3M11 1v3" style="stroke:var(--e7-accent,#3b82f6)" stroke="#3b82f6" stroke-width="1.4" stroke-linecap="round" />
                        </svg>
                        <span id="dispFromDate" style="font-size:13px;font-weight:600;color:var(--e7-text,#1e293b);
                            min-width:75px;letter-spacing:0.01em;">—</span>
                    </div>
                </div>

                <!-- Arrow (hidden on mobile via CSS class) -->
                <div class="au-range-arrow" style="margin:0 4px;display:flex;align-items:center;color:var(--e7-text-4,#94a3b8);">
                    <svg width="22" height="12" viewBox="0 0 22 12" fill="none">
                        <path d="M1 6h18M14 1l5 5-5 5" stroke="currentColor"
                              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>

                <!-- TO -->
                <div class="au-range-block" style="display:flex;align-items:center;gap:10px;">
                    <span style="font-size:11px;font-weight:700;letter-spacing:0.08em;
                        color:var(--e7-text-3,#6b7280);text-transform:uppercase;">To</span>
                    <div style="display:flex;align-items:center;gap:6px;background:var(--e7-surface,#fff);
                        border:1px solid var(--e7-border-2,#cbd5e1);border-radius:6px;padding:5px 12px;
                        box-shadow:var(--e7-shadow-soft,0 1px 3px rgba(0,0,0,0.06));">
                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
                            <rect x="1" y="3" width="14" height="12" rx="2" style="stroke:var(--e7-accent,#3b82f6)" stroke="#3b82f6" stroke-width="1.4" />
                            <path d="M1 7h14" style="stroke:var(--e7-accent,#3b82f6)" stroke="#3b82f6" stroke-width="1.2" />
                            <path d="M5 1v3M11 1v3" style="stroke:var(--e7-accent,#3b82f6)" stroke="#3b82f6" stroke-width="1.4" stroke-linecap="round" />
                        </svg>
                        <span id="dispToDate" style="font-size:13px;font-weight:600;color:var(--e7-text,#1e293b);
                            min-width:75px;letter-spacing:0.01em;">—</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6">
            <div class="my-4 px-lg-4 px-2 w-100">
                <div class="d-md-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center badge-cl gap-10"></div>
                    @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.UserClassId != E7FRSAdvance.Utility.Utility.UserClass.Guest.GetHashCode())
                    {
                        <div class="d-flex justify-content-between align-items-center btn-icon-size">
                            <div class="d-flex gap-10 my-lg-0 my-3" id="buttonGroupLeft">
                                <div class="dropdown">
                                    <button class="btn btn-inactive" id="btnDownload"
                                            data-toggle="dropdown" aria-haspopup="true"
                                            aria-expanded="false" title="Download">
                                        <svg fill="none" stroke="currentColor" stroke-width="1.5"
                                             viewBox="0 0 24 24" stroke-linecap="round"
                                             stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                                            <path d='M4 16.004V17a3 3 0 0 0 3 3h10a3 3 0 0
                                                 0 3-3v-1M12 4.5v11m3.5-3.5L12 15.5 8.5 12' />
                                        </svg>
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right"
                                         aria-labelledby="btnDownload">
                                        <a class="dropdown-item" href="javascript:void(0);"
                                           onclick="fnDownloadExcel()">
                                            <i class="fa fa-file-excel mr-2" style="color:var(--e7-green,#22c55e);"></i> Excel
                                        </a>
                                        <a class="dropdown-item" href="javascript:void(0);"
                                           onclick="fnDownloadCSV()">
                                            <i class="fa fa-file-alt mr-2" style="color:var(--e7-accent,#3b82f6);"></i> CSV
                                        </a>
                                        <a class="dropdown-item" href="javascript:void(0);"
                                           onclick="fnDownloadPDF()">
                                            <i class="fa fa-file-pdf mr-2" style="color:var(--e7-red,#ef4444);"></i> PDF
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    </div>
            </div>
        </div>

        <!-- Table -->
        <div class="col-12">
            <div id="listView">
                <div class="table-responsive">
                    <table class="table table-hover" id="tblUtilization">
                        <thead class="thead-light2">
                            <tr>
                                <th>Sr.No</th>
                                <th>Zone</th>
                                <th>Division</th>
                                <th>Station</th>
                                <th>Asset Type</th>
                                <th class="text-center">Asset Number</th>
                                <th class="text-center">Number of operations</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.mAssets != null && Model.mAssets.Count > 0)
                            {
                                int counter = 0;
                                foreach (var asset in Model.mAssets)
                                {
                                    counter++;
                                    // RowKey comes from the API (e.g. "1234-CO", "1234-RO", "1234-S") and is what
                                    // uniquely identifies THIS row, since several rows can share the same asset.Id
                                    // (CO-/RO-/S- are all synthesized from one physical signal). Fall back to a
                                    // positional key only if an older API response hasn't set RowKey yet.
                                    var rowKey = string.IsNullOrEmpty(asset.RowKey) ? ("row_" + counter) : asset.RowKey;
                                    <tr>
                                        <td>@counter</td>
                                        <td>@asset.Zone</td>
                                        <td>@asset.Division</td>
                                        <td>@asset.SiteName</td>
                                        <td>@asset.AssetTypeName</td>
                                        <!-- Asset Number -->
                                        <td class="text-center">
                                            @if (asset.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL)
                                            {
                                                <span style="
            color:var(--e7-accent,#4361ee); font-weight:600; cursor:pointer;
            text-decoration:underline; text-decoration-style:dotted;
            text-underline-offset:3px; transition:all 0.2s ease;"
                                                      onmouseover="this.style.color='var(--e7-accent-ink,#2541b2)'; this.style.textDecorationStyle='solid';"
                                                      onmouseout="this.style.color='var(--e7-accent,#4361ee)'; this.style.textDecorationStyle='dotted';"
                                                      onclick="fnShowRelayPopup('@rowKey', '@asset.Name')"
                                                      title="Click to view relay details">
                                                    @asset.Name
                                                </span>
                                            }
                                            else
                                            {
                                                @asset.Name
                                            }
                                        </td>

                                        <!-- Number of operations -->
                                        <td class="text-center"
                                            data-rowkey="@rowKey"
                                            data-raw="@(asset.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL ? Math.Round(asset.TotalHour, 2).ToString(System.Globalization.CultureInfo.InvariantCulture) : asset.NoOfOpration.ToString())"
                                            data-signal="@(asset.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL ? "1" : "0")"
                                            data-asset-type="@asset.AssetTypeName">
                                            <div style="display:inline-flex; align-items:center; gap:8px; justify-content:center;">
                                                @if (asset.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL)
                                                {
                                                    <span style="
                display:inline-flex; align-items:center; gap:4px;
                background:var(--e7-accent-soft,#f0f4ff); color:var(--e7-accent,#4361ee);
                font-size:13px; font-weight:700;
                padding:4px 12px; border-radius:20px;
                border:1px solid var(--e7-border,#dbe4ff);">
                                                        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" style="flex-shrink:0;">
                                                            <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.3" />
                                                            <path d="M8 4.5V8l2.5 1.5" stroke="currentColor" stroke-width="1.3"
                                                                  stroke-linecap="round" stroke-linejoin="round" />
                                                        </svg>
                                                        @(Math.Round(asset.TotalHour, 2)) hrs
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span style="font-weight:700; font-size:14px; color:var(--e7-text,#1e293b);">
                                                        @asset.NoOfOpration
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-4">
                                        <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                        No records found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="px-md-4 px-2">
                    <nav>
                        <ul class="pagination justify-content-end mt-3" id="pager">
                            <li class="page-item" data-page="prev">
                                <a class="page-link" href="#">Previous</a>
                            </li>
                            <li class="page-item" data-page="next">
                                <a class="page-link" href="#">Next</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>

            <!-- Chart Container — shown when Bar / Pie / Graph selected -->
            <div id="auChartContainer" style="display:none; padding:10px 0;"></div>

        </div>
    </div>
</div>

<!-- Relay Detail Popup -->
<div id="relayModal" style="
    display:none; position:fixed; top:0; left:0; width:100vw; height:100vh;
    background:rgba(15,23,42,0.45); backdrop-filter:blur(4px);
    z-index:999999; justify-content:center; align-items:center;">
    <div style="
        background:var(--e7-surface,#fff); color:var(--e7-text,#1e293b); border-radius:14px; width:90%; max-width:780px;
        box-shadow:var(--e7-shadow-pop,0 25px 60px rgba(0,0,0,0.18)); overflow:hidden;
        animation:modalSlideIn 0.25s ease-out;">

        <!-- Header -->
        <div style="
            background:linear-gradient(135deg,#1e3a5f 0%,#2c5282 100%);
            padding:18px 24px; display:flex; align-items:center; justify-content:space-between;">
            <div style="display:flex; align-items:center; gap:10px;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="9" stroke="#fff" stroke-width="1.8" />
                    <path d="M12 7v5l3 2" stroke="#fff" stroke-width="1.8"
                          stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span style="color:#fff; font-size:16px; font-weight:700; letter-spacing:0.02em;">
                    Relay Duration Details
                </span>
                <span id="relayModalAssetName" style="
                    color:#93c5fd; font-size:13px; font-weight:500;
                    background:rgba(255,255,255,0.12); padding:2px 12px;
                    border-radius:20px;"></span>
            </div>
            <button onclick="fnCloseRelayPopup()" style="
                background:rgba(255,255,255,0.15); border:none; border-radius:8px;
                width:32px; height:32px; cursor:pointer; display:flex;
                align-items:center; justify-content:center; transition:background 0.2s;"
                    onmouseover="this.style.background='rgba(255,255,255,0.3)'"
                    onmouseout="this.style.background='rgba(255,255,255,0.15)'">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M4 4l8 8M12 4l-8 8" stroke="#fff" stroke-width="2"
                          stroke-linecap="round" />
                </svg>
            </button>
        </div>

        <!-- Table -->
        <div style="padding:20px 24px; max-height:420px; overflow-y:auto;">
            <table style="width:100%; border-collapse:separate; border-spacing:0;">
                <thead>
                    <tr>
                        <th style="background:#1e3a5f; color:#fff; font-size:12px; font-weight:700;
                            letter-spacing:0.05em; padding:12px 16px; text-align:left;
                            border-radius:8px 0 0 0;">Relay</th>
                        <th style="background:#1e3a5f; color:#fff; font-size:12px; font-weight:700;
                            letter-spacing:0.05em; padding:12px 16px; text-align:center;">
                            Up Time<br><span style="font-weight:400;font-size:10px;opacity:0.7;">(hh:mm:ss)</span>
                        </th>
                        <th style="background:#1e3a5f; color:#fff; font-size:12px; font-weight:700;
                            letter-spacing:0.05em; padding:12px 16px; text-align:center;">
                            Down Time<br><span style="font-weight:400;font-size:10px;opacity:0.7;">(hh:mm:ss)</span>
                        </th>
                        <th style="background:#1e3a5f; color:#fff; font-size:12px; font-weight:700;
                            letter-spacing:0.05em; padding:12px 16px; text-align:center;">
                            Pickup / Drop Events
                        </th>
                        <th style="background:#1e3a5f; color:#fff; font-size:12px; font-weight:700;
                            letter-spacing:0.05em; padding:12px 16px; text-align:center;
                            border-radius:0 8px 0 0;">
                            Total Duration<br><span style="font-weight:400;font-size:10px;opacity:0.7;">(hh:mm:ss)</span>
                        </th>
                    </tr>
                </thead>
                <tbody id="relayModalBody">
                    <!-- Populated via JS -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    @@keyframes modalSlideIn {
        from {
            opacity: 0;
            transform: translateY(-20px) scale(0.97);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
</style>

@functions {
    string ToTitleCase(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var info = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
        return info.ToTitleCase(input.ToLower());
    }

    string ToTitleUpperCase(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var info = System.Globalization.CultureInfo.CurrentCulture.TextInfo;
        return info.ToTitleCase(input.ToUpper());
    }


    string FormatDateTime(DateTime? dt)
    {
        if (dt == null || dt.Value == DateTime.MinValue) return "-";
        return dt.Value.ToString("dd/MM/yyyy") + "\n" + dt.Value.ToString("HH:mm:ss");
    }

    string FormatDateTimeNonNull(DateTime dt)
    {
        if (dt == DateTime.MinValue) return "-";
        return dt.ToString("dd/MM/yyyy") + "\n" + dt.ToString("HH:mm:ss");
    }

}

<script>
    // ==========================================================================
    // PAGINATION
    // ==========================================================================
    (function () {
        var rowsPerPage = 10;
        var $rows = $('#tblUtilization tbody tr').filter(function () {
            return !$(this).find('td[colspan]').length;
        });
        var totalRows = $rows.length;
        var totalPages = Math.ceil(totalRows / rowsPerPage);
        var currentPage = 1;
        var $pager = $('#pager');

        function showPage(page) {
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            var start = (page - 1) * rowsPerPage;
            var end = start + rowsPerPage;
            $rows.hide().slice(start, end).show();
            renderPager();
        }

        function renderPager() {
            $pager.find('.page-number, .ellipsis').remove();

            function addPage(p) {
                $('<li class="page-item page-number ' + (p === currentPage ? 'active' : '') + '">' +
                    '<a class="page-link" href="#">' + p + '</a></li>')
                    .insertBefore($pager.find('[data-page="next"]'));
            }

            function addEllipsis() {
                $('<li class="page-item disabled ellipsis">' +
                    '<span class="page-link">...</span></li>')
                    .insertBefore($pager.find('[data-page="next"]'));
            }

            for (var i = 1; i <= Math.min(3, totalPages); i++) addPage(i);
            if (currentPage > 5) addEllipsis();
            for (var i = currentPage - 1; i <= currentPage + 1; i++) {
                if (i > 3 && i < totalPages - 2) addPage(i);
            }
            if (currentPage < totalPages - 4) addEllipsis();
            for (var i = Math.max(totalPages - 2, 4); i <= totalPages; i++) addPage(i);

            $pager.find('[data-page="prev"]').toggleClass('disabled', currentPage === 1);
            $pager.find('[data-page="next"]').toggleClass('disabled', currentPage === totalPages);
        }

        $pager.on('click', '.page-link', function (e) {
            e.preventDefault();
            var $li = $(this).parent();
            if ($li.hasClass('disabled') || $li.hasClass('active')) return;
            if ($li.data('page') === 'prev') showPage(currentPage - 1);
            else if ($li.data('page') === 'next') showPage(currentPage + 1);
            else showPage(parseInt($(this).text()));
        });

        window.goToPage = function (p) { showPage(p); };

        if (totalRows > 0) showPage(1);
    })();
</script>

<script>
// ======================================================================
// RELAY POPUP
// ======================================================================
var relayDataMap = {};
var _relayModalMoved = false;

@{
    int relayRowCounter = 0;
}
@if (Model != null && Model.mAssets != null)
{
    foreach (var asset in Model.mAssets)
    {
        relayRowCounter++;
        // Must use the SAME rowKey derivation as the table-rendering loop above,
        // so a click on a given row looks up its own relay data and not another
        // row that happens to share the same underlying asset.Id (CO-/RO-/S-).
        var rowKey = string.IsNullOrEmpty(asset.RowKey) ? ("row_" + relayRowCounter) : asset.RowKey;
        if (asset.AssetTypeId == (int)E7FRSAdvance.Utility.Utility.AssetType.SIGNAL
            && asset.mAssetInfoDataloggers != null && asset.mAssetInfoDataloggers.Count > 0)
        {
            @:relayDataMap['@rowKey'] = [
                foreach (var relay in asset.mAssetInfoDataloggers)
                {
                    @:{ attr: '@Html.Raw(relay.DataloggerAttribute)', upHour: '@Html.Raw(relay.UpHour ?? "-")', downHour: '@Html.Raw(relay.DownHour ?? "-")', pickup: @relay.PickupCount, drop: @relay.DropCount },
                }
            @:];
        }
    }
}

    function fnShowRelayPopup(rowKey, assetName) {
        var data = relayDataMap[rowKey];
        if (!data || data.length === 0) {
            alert('No relay data available.');
            return;
        }

        // Move modal to <body> on first open so it escapes all parent containers
        if (!_relayModalMoved) {
            document.body.appendChild(document.getElementById('relayModal'));
            _relayModalMoved = true;
        }

        // Close any open filter dropdowns
        $('.filter-dropdown').removeClass('open');
        $('.select-btn').removeClass('active');

        document.getElementById('relayModalAssetName').innerText = assetName;

        var html = '';
        for (var i = 0; i < data.length; i++) {
            var r = data[i];
            var totalDuration = fnCalcTotalDuration(r.upHour, r.downHour);
            var bgColor = i % 2 === 0 ? 'var(--e7-surface-2,#f8fafc)' : 'var(--e7-surface,#ffffff)';

            html += '<tr style="background:' + bgColor + ';">'
                + '<td style="padding:11px 16px; font-weight:600; color:var(--e7-text,#1e293b); font-size:13px; border-bottom:1px solid var(--e7-border,#e2e8f0);">'
                + r.attr + '</td>'
                + '<td style="padding:11px 16px; text-align:center; font-size:13px; color:var(--e7-green,#059669); font-weight:600; border-bottom:1px solid var(--e7-border,#e2e8f0);">'
                + r.upHour + '</td>'
                + '<td style="padding:11px 16px; text-align:center; font-size:13px; color:var(--e7-red,#dc2626); font-weight:600; border-bottom:1px solid var(--e7-border,#e2e8f0);">'
                + r.downHour + '</td>'
                + '<td style="padding:11px 16px; text-align:center; font-size:13px; color:var(--e7-text,#1e293b); font-weight:500; border-bottom:1px solid var(--e7-border,#e2e8f0);">'
                + r.pickup + ' / ' + r.drop + '</td>'
                + '<td style="padding:11px 16px; text-align:center; font-size:13px; color:var(--e7-heading,#1e3a5f); font-weight:700; border-bottom:1px solid var(--e7-border,#e2e8f0);">'
                + totalDuration + '</td>'
                + '</tr>';
        }

        document.getElementById('relayModalBody').innerHTML = html;
        var modal = document.getElementById('relayModal');
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';  // Prevent background scroll
    }

    function fnCloseRelayPopup() {
        document.getElementById('relayModal').style.display = 'none';
        document.body.style.overflow = '';  // Restore scroll
    }

// Close on backdrop click
    $(document).on('click', '#relayModal', function (e) {
        if (e.target === this) fnCloseRelayPopup();
    });

// Close on Escape key
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') fnCloseRelayPopup();
    });

    // Calculate total duration from UpHour + DownHour (hh:mm:ss format)
    function fnCalcTotalDuration(up, down) {
        try {
            var upSec = fnTimeToSeconds(up);
            var downSec = fnTimeToSeconds(down);
            return fnSecondsToTime(upSec + downSec);
        } catch (e) {
            return '-';
        }
    }

    function fnTimeToSeconds(t) {
        if (!t || t === '-') return 0;
        var parts = t.split(':');
        return (parseInt(parts[0]) || 0) * 3600
             + (parseInt(parts[1]) || 0) * 60
             + (parseInt(parts[2]) || 0);
    }

    function fnSecondsToTime(sec) {
        var h = Math.floor(sec / 3600);
        var m = Math.floor((sec % 3600) / 60);
        var s = sec % 60;
        return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    }
</script>