@model Domain.AssetLister
@{ ViewBag.Title = "Asset Detail";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml"; }

<style>
    .search-section {
        padding: 20px 0px;
        position: relative;
        z-index: 100;
    }

    .search-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--e7-text);
        margin-bottom: 20px;
    }

    .filter-row {
        display: flex;
        align-items: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        position: relative;
        z-index: 100;
    }

    .filter-item {
        flex-shrink: 0;
        position: relative;
        z-index: 100;
    }

        .filter-item label {
            display: block;
            font-size: 13px;
            color: var(--e7-text-2);
            margin-bottom: 6px;
            font-weight: 500;
        }

    .select-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--e7-surface);
        border: 1px solid var(--e7-border-2);
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        color: var(--e7-text);
        cursor: pointer;
        min-width: 160px;
        height: 40px;
    }

        .select-btn:hover {
            border-color: var(--e7-text-4);
        }

        .select-btn.active {
            border-color: var(--e7-accent);
            box-shadow: 0 0 0 2px var(--e7-accent-soft);
        }

        .select-btn .text {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: left;
        }

        .select-btn i {
            margin-left: 8px;
            font-size: 12px;
            color: var(--e7-text-3);
        }

    .filter-input {
        border: 1px solid var(--e7-border-2);
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        height: 40px;
        width: 120px;
        outline: none;
        background: var(--e7-surface);
        color: var(--e7-text);
    }

        .filter-input:focus {
            border-color: var(--e7-accent);
            box-shadow: 0 0 0 2px var(--e7-accent-soft);
        }

    .filter-dropdown {
        position: fixed;
        background: var(--e7-surface);
        border: 1px solid var(--e7-border);
        border-radius: 8px;
        box-shadow: var(--e7-shadow-pop);
        min-width: 260px;
        max-width: 320px;
        z-index: 9999;
        display: none;
    }

        .filter-dropdown.open {
            display: block;
        }

    .dropdown-search {
        padding: 10px 12px;
        border-bottom: 1px solid var(--e7-border);
    }

        .dropdown-search input {
            width: 100%;
            border: 1px solid var(--e7-border);
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s;
            background: var(--e7-surface);
            color: var(--e7-text);
        }

            .dropdown-search input:focus {
                border-color: var(--e7-accent);
            }

            .dropdown-search input::placeholder {
                color: var(--e7-text-4);
            }

    .dropdown-header {
        padding: 10px 14px;
        background: var(--e7-surface-2);
        border-bottom: 1px solid var(--e7-border);
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .dropdown-header input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--e7-accent);
        }

        .dropdown-header label {
            font-size: 14px;
            font-weight: 600;
            color: var(--e7-text);
            cursor: pointer;
            margin: 0;
        }

    .dropdown-list {
        max-height: 250px;
        overflow-y: auto;
    }

    .dropdown-item {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid var(--e7-border);
        transition: background 0.15s;
    }

        .dropdown-item:last-child {
            border-bottom: none;
        }

        .dropdown-item:hover {
            background: var(--e7-surface-3);
        }

        .dropdown-item.checked {
            background: var(--e7-accent-soft);
        }

        .dropdown-item.hidden {
            display: none;
        }

        .dropdown-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--e7-accent);
            flex-shrink: 0;
        }

        .dropdown-item span {
            font-size: 14px;
            color: var(--e7-text);
        }

        .dropdown-item.checked span {
            color: var(--e7-accent-ink);
            font-weight: 500;
        }

        .dropdown-item span mark {
            background: var(--e7-amber-soft);
            color: var(--e7-text);
            padding: 0;
            border-radius: 2px;
        }

    .dropdown-empty {
        padding: 25px;
        text-align: center;
        color: var(--e7-text-3);
        font-size: 14px;
    }

    .dropdown-no-results {
        padding: 20px;
        text-align: center;
        color: var(--e7-text-3);
        font-size: 13px;
        display: none;
    }

        .dropdown-no-results.show {
            display: block;
        }

    .btn-search {
        background: var(--primary);
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        color: #fff;
        font-size: 14px;
        font-weight: 500;
        transition: background 0.2s;
    }

        .btn-search:hover {
            background: var(--primary);
        }

        .btn-search i {
            font-size: 14px;
        }

    .dropdown-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9998;
        display: none;
    }

        .dropdown-backdrop.show {
            display: block;
        }

    .table-border {
        position: relative;
        z-index: 1;
    }

    /* ===== CHART STYLES ===== */
    .chart-summary-row {
        display: flex;
        gap: 16px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .summary-card {
        flex: 1;
        min-width: 140px;
        padding: 16px 18px;
        border-radius: 8px;
        border: 1px solid var(--e7-border);
        background: var(--e7-surface);
        transition: box-shadow 0.2s ease;
    }

        .summary-card:hover {
            box-shadow: var(--e7-shadow-hover);
        }

        .summary-card .card-icon {
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
            font-size: 16px;
        }

        .summary-card .card-value {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 2px;
            color: var(--e7-heading);
        }

        .summary-card .card-label {
            font-size: 11px;
            color: var(--e7-text-3);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 500;
        }

        .summary-card.total-assets {
            border-left: 3px solid var(--e7-accent);
        }

            .summary-card.total-assets .card-icon {
                background: var(--e7-accent-soft);
                color: var(--e7-accent-ink);
            }

        .summary-card.total-makes {
            border-left: 3px solid var(--e7-dot-green);
        }

            .summary-card.total-makes .card-icon {
                background: var(--e7-green-soft);
                color: var(--e7-green);
            }

        .summary-card.top-make {
            border-left: 3px solid var(--e7-dot-amber);
        }

            .summary-card.top-make .card-icon {
                background: var(--e7-amber-soft);
                color: var(--e7-amber);
            }

        .summary-card.avg-count {
            border-left: 3px solid var(--e7-c6);
        }

            .summary-card.avg-count .card-icon {
                background: var(--e7-p-blue);
                color: var(--e7-c6);
            }

    .ad-chart-wrapper {
        position: relative;
        height: 380px;
        width: 100%;
        padding: 16px;
        background: var(--e7-surface-2);
        border-radius: 8px;
        border: 1px solid var(--e7-border);
    }

    .chart-title-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--e7-border);
    }

    .chart-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--e7-heading);
        margin: 0;
    }

    .chart-subtitle {
        font-size: 12px;
        color: var(--e7-text-3);
        margin-top: 3px;
    }

    .chart-type-badge {
        padding: 5px 12px;
        border-radius: 4px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background: var(--e7-surface-2);
        color: var(--e7-text-2);
        border: 1px solid var(--e7-border);
    }

    .chart-data-table {
        margin-top: 20px;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--e7-border);
    }

        .chart-data-table table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }

        .chart-data-table th {
            background: var(--e7-surface-2);
            color: var(--e7-text-2);
            padding: 10px 16px;
            text-align: left;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid var(--e7-border);
        }

        .chart-data-table td {
            padding: 10px 16px;
            border-bottom: 1px solid var(--e7-border);
            font-size: 13px;
            color: var(--e7-text);
        }

        .chart-data-table tr:last-child td {
            border-bottom: none;
        }

        .chart-data-table tr:hover td {
            background: var(--e7-surface-3);
        }

        .chart-data-table .color-indicator {
            width: 10px;
            height: 10px;
            border-radius: 2px;
            display: inline-block;
            margin-right: 8px;
            vertical-align: middle;
        }

        .chart-data-table .percentage-bar {
            height: 6px;
            border-radius: 3px;
            background: var(--e7-surface-3);
            overflow: hidden;
            min-width: 80px;
        }

        .chart-data-table .percentage-bar-fill {
            height: 100%;
            border-radius: 3px;
            transition: width 0.5s ease;
        }

        .chart-data-table .rank-badge {
            width: 24px;
            height: 24px;
            border-radius: 4px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 11px;
        }

            .chart-data-table .rank-badge.gold {
                background: var(--e7-amber-soft);
                color: var(--e7-amber);
            }

            .chart-data-table .rank-badge.silver {
                background: var(--e7-surface-3);
                color: var(--e7-text-2);
            }

            .chart-data-table .rank-badge.bronze {
                background: #fed7aa;
                color: #9a3412;
            }

            .chart-data-table .rank-badge.normal {
                background: var(--e7-surface-2);
                color: var(--e7-text-3);
            }

    .no-data-container {
        height: 350px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: var(--e7-surface-2);
        border-radius: 8px;
        border: 1px dashed var(--e7-border-2);
    }

        .no-data-container i {
            font-size: 48px;
            color: var(--e7-text-4);
            margin-bottom: 16px;
        }

        .no-data-container p {
            color: var(--e7-text-3);
            font-size: 14px;
            margin: 0;
        }

    /* bronze rank badge — dark scheme tint (light keeps its orange pastel) */
    html:not([data-aurora="light"]) .chart-data-table .rank-badge.bronze {
        background: rgba(251, 146, 60, .16);
        color: #fdba74;
    }

    /* ===== ASSET DETAIL PAGER — RESPONSIVE ===== */
    #pager.pagination {
        flex-wrap: wrap;
        row-gap: 6px;
        justify-content: flex-end;
    }

    @@media (max-width: 767.98px) {
        #tblAssetDetail ~ .px-md-4.px-2 .d-flex.justify-content-between.align-items-center.flex-wrap,
        .showing-records {
            text-align: center;
            justify-content: center !important;
        }

        #pager.pagination {
            justify-content: center;
            width: 100%;
        }

        #pager .page-link {
            padding: 6px 10px;
            font-size: 13px;
        }
    }

    @@media (max-width: 480px) {
        #pager .page-link {
            padding: 5px 8px;
            font-size: 12px;
        }
    }
</style>

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.0.0"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="row">
                        <div class="col-12 col-sm-5">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">Asset</li>
                                    <li class="breadcrumb-item active" aria-current="page">
                                        <a href="#">Asset Detail</a>
                                    </li>
                                </ol>
                            </nav>
                        </div>
                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                            <h2 class="page-name">Asset Detail</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="search-section">
                        <div class="search-title">Search</div>

                        <div class="dropdown-backdrop" id="backdrop"></div>

                        <div class="filter-row">

                            <div class="filter-item">
                                <label>Zone</label>
                                <div class="select-btn" id="btnZone" data-target="ddZone">
                                    <span class="text" id="txtZone">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>

                            <div class="filter-item">
                                <label>Division</label>
                                <div class="select-btn" id="btnDivision" data-target="ddDivision">
                                    <span class="text" id="txtDivision">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>

                            <div class="filter-item">
                                <label>Station</label>
                                <div class="select-btn" id="btnSite" data-target="ddSite">
                                    <span class="text" id="txtSite">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>

                            <div class="filter-item">
                                <label>Asset Type</label>
                                <div class="select-btn" id="btnAssetType" data-target="ddAssetType">
                                    <span class="text" id="txtAssetType">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>

                            <div class="filter-item">
                                <label>Asset Make</label>
                                <div class="select-btn" id="btnAssetMake" data-target="ddAssetMake">
                                    <span class="text" id="txtAssetMake">All</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>

                            <div class="filter-item">
                                <label>View</label>
                                <div class="select-btn" id="btnViewType" data-target="ddViewType">
                                    <span class="text" id="txtViewType">Table</span>
                                    <i class="fas fa-chevron-down"></i>
                                </div>
                            </div>

                            <div class="filter-item">
                                <label>&nbsp;</label>
                                <button type="button" class="btn-search" onclick="fnSearch()">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </button>
                            </div>

                        </div>
                    </div>

                    <!-- Zone Dropdown -->
                    <div class="filter-dropdown" id="ddZone">
                        <div class="dropdown-search">
                            <input type="text" placeholder="Search zone..."
                                   onkeyup="filterDropdown('zone', this.value)">
                        </div>
                        <div class="dropdown-header">
                            <input type="checkbox" id="chkAllZone">
                            <label for="chkAllZone">Select All</label>
                        </div>
                        <div class="dropdown-list" id="listZone">
                            @if (ViewBag.Zones != null)
                            {
                                foreach (var zone in (IEnumerable<SelectListItem>)ViewBag.Zones)
                                {
                                    <div class="dropdown-item"
                                         data-value="@zone.Value" data-text="@zone.Text">
                                        <input type="checkbox" class="cb-zone" value="@zone.Value">
                                        <span>@zone.Text</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>

                    <!-- Division Dropdown -->
                    <div class="filter-dropdown" id="ddDivision">
                        <div class="dropdown-search">
                            <input type="text" placeholder="Search division..."
                                   onkeyup="filterDropdown('division', this.value)">
                        </div>
                        <div class="dropdown-header">
                            <input type="checkbox" id="chkAllDivision">
                            <label for="chkAllDivision">Select All</label>
                        </div>
                        <div class="dropdown-list" id="listDivision">
                            @if (ViewBag.Divisions != null)
                            {
                                foreach (var division in (IEnumerable<SelectListItem>)ViewBag.Divisions)
                                {
                                    <div class="dropdown-item"
                                         data-value="@division.Value" data-text="@division.Text">
                                        <input type="checkbox" class="cb-division" value="@division.Value">
                                        <span>@division.Text</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>

                    <!-- Site Dropdown -->
                    <div class="filter-dropdown" id="ddSite">
                        <div class="dropdown-search">
                            <input type="text" placeholder="Search station..."
                                   onkeyup="filterDropdown('site', this.value)">
                        </div>
                        <div class="dropdown-header">
                            <input type="checkbox" id="chkAllSite">
                            <label for="chkAllSite">Select All</label>
                        </div>
                        <div class="dropdown-list" id="listSite">
                            @if (ViewBag.Sites != null)
                            {
                                foreach (var site in (IEnumerable<SelectListItem>)ViewBag.Sites)
                                {
                                    <div class="dropdown-item"
                                         data-value="@site.Value" data-text="@site.Text">
                                        <input type="checkbox" class="cb-site" value="@site.Value">
                                        <span>@site.Text</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>

                    <!-- Asset Type Dropdown -->
                    <div class="filter-dropdown" id="ddAssetType">
                        <div class="dropdown-search">
                            <input type="text" placeholder="Search asset type..."
                                   onkeyup="filterDropdown('assetType', this.value)">
                        </div>
                        <div class="dropdown-header">
                            <input type="checkbox" id="chkAllAssetType">
                            <label for="chkAllAssetType">Select All</label>
                        </div>
                        <div class="dropdown-list" id="listAssetType">
                            @if (ViewBag.AssetTypes != null)
                            {
                                foreach (var assettype in (IEnumerable<SelectListItem>)ViewBag.AssetTypes)
                                {
                                    <div class="dropdown-item"
                                         data-value="@assettype.Value" data-text="@assettype.Text">
                                        <input type="checkbox" class="cb-assetType" value="@assettype.Value">
                                        <span>@assettype.Text</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>

                    <!-- Asset Make Dropdown -->
                    <div class="filter-dropdown" id="ddAssetMake">
                        <div class="dropdown-search">
                            <input type="text" placeholder="Search asset make..."
                                   onkeyup="filterDropdown('assetMake', this.value)">
                        </div>
                        <div class="dropdown-header">
                            <input type="checkbox" id="chkAllAssetMake">
                            <label for="chkAllAssetMake">Select All</label>
                        </div>
                        <div class="dropdown-list" id="listAssetMake">
                            @if (ViewBag.RailwayAssetMake != null)
                            {
                                foreach (var item in ViewBag.RailwayAssetMake as List<string>)
                                {
                                    <div class="dropdown-item"
                                         data-value="@item" data-text="@item">
                                        <input type="checkbox" class="cb-assetMake" value="@item">
                                        <span>@item</span>
                                    </div>
                                }
                            }
                        </div>
                        <div class="dropdown-no-results">No results found</div>
                    </div>

                    <!-- View Type Dropdown (Single Select) -->
                    <div class="filter-dropdown" id="ddViewType">
                        <div class="dropdown-list" id="listViewType">
                            <div class="dropdown-item selected checked"
                                 data-value="Table" data-text="Table">
                                <i class="fas fa-table"
                                   style="color:var(--e7-accent,#6366f1);width:20px;"></i>
                                <span>Table</span>
                            </div>
                            <div class="dropdown-item" data-value="Pie" data-text="Pie">
                                <i class="fas fa-chart-pie"
                                   style="color:var(--e7-green,#10b981);width:20px;"></i>
                                <span>Pie</span>
                            </div>
                            <div class="dropdown-item" data-value="Bar" data-text="Bar">
                                <i class="fas fa-chart-bar"
                                   style="color:var(--e7-amber,#f59e0b);width:20px;"></i>
                                <span>Bar</span>
                            </div>
                            <div class="dropdown-item" data-value="Graph" data-text="Graph">
                                <i class="fas fa-chart-line"
                                   style="color:var(--e7-c6,#3b82f6);width:20px;"></i>
                                <span>Graph</span>
                            </div>
                        </div>
                    </div>

                    <div class="table-border">
                        <div class="my-4 px-lg-4 px-2 w-100">
                            <div class="d-md-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center badge-cl gap-10">
                                    <label id="lblcurrentDate" style="font-weight:bold;"></label>
                                </div>
                                @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.UserClassId != E7FRSAdvance.Utility.Utility.UserClass.Guest.GetHashCode())
                                {
                                    <div class="d-flex justify-content-between align-items-center btn-icon-size">
                                        <div class="d-flex gap-10 my-lg-0 my-3" id="buttonGroupLeft">
                                            <div class="dropdown">
                                                <button class="btn btn-inactive" id="btn2"
                                                        data-toggle="dropdown" aria-haspopup="true"
                                                        aria-expanded="false" title="Download">
                                                    <svg fill="none" stroke="currentColor"
                                                         stroke-width="1.5" viewBox="0 0 24 24"
                                                         stroke-linecap="round" stroke-linejoin="round"
                                                         xmlns="http://www.w3.org/2000/svg">
                                                        <path d='M4 16.004V17a3 3 0 0 0 3 3h10a3
                                                             3 0 0 0 3-3v-1M12 4.5v11m3.5-3.5
                                                             L12 15.5 8.5 12' />
                                                    </svg>
                                                </button>
                                                <div class="dropdown-menu dropdown-menu-right"
                                                     aria-labelledby="btn2">
                                                    <a class="dropdown-item" href="javascript:void(0);"
                                                       onclick="fnDownloadExcel()">
                                                        <i class="fa fa-file-excel mr-2"
                                                           style="color:var(--e7-green,#22c55e);"></i> Excel
                                                    </a>
                                                    <a class="dropdown-item" href="javascript:void(0);"
                                                       onclick="fnDownloadCSV()">
                                                        <i class="fa fa-file-alt mr-2"
                                                           style="color:var(--e7-accent,#3b82f6);"></i> CSV
                                                    </a>
                                                    <a class="dropdown-item" href="javascript:void(0);"
                                                       onclick="fnDownloadPDF()">
                                                        <i class="fa fa-file-pdf mr-2" style="color:var(--e7-red,#ef4444);"></i> PDF
                                                    </a>
