    // ==========================================================================
    // EXCEL DOWNLOAD
    // ==========================================================================
    function fnDownloadExcel() {
        if (selectedViewType !== 'Table') { alert('Please switch to Table view to download'); return; }
        var table = document.querySelector('#divAlertDetailReport table');
        if (!table) { alert('No data available to download'); return; }

        try {
            $("#loader").show();
            var workbook = new ExcelJS.Workbook();
            workbook.creator = 'RDPMS'; workbook.created = new Date();
            var worksheet = workbook.addWorksheet('Asset Detail');

            var headers = ['Sr.No', 'Zone', 'Division', 'Station', 'Vendor Name', 'Asset Type', 'Make of Asset', 'Count'];
            var colCount = headers.length;

            var titleRow = worksheet.addRow(['Asset Detail Report']);
            titleRow.height = 30;
            worksheet.mergeCells(1, 1, 1, colCount);
            titleRow.getCell(1).fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF4F46E5' } };
            titleRow.getCell(1).font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 16, name: 'Calibri' };
            titleRow.getCell(1).alignment = { vertical: 'middle', horizontal: 'center' };

            var generatedText = 'Generated: ' + (function () {
                var now = new Date();
                return String(now.getDate()).padStart(2, '0') + '/' +
                    String(now.getMonth() + 1).padStart(2, '0') + '/' +
                    now.getFullYear() + '  ' +
                    String(now.getHours()).padStart(2, '0') + ':' +
                    String(now.getMinutes()).padStart(2, '0') + ':' +
                    String(now.getSeconds()).padStart(2, '0');
            })() + '   |   Total Records: ' + (function () {
                var count = 0;
                document.querySelector('#divAlertDetailReport table').querySelectorAll('tbody tr').forEach(function (tr) {
                    if (!tr.querySelector('td[colspan]')) count++;
                });
                return count;
            })();

            var genRow = worksheet.addRow([generatedText]);
            genRow.height = 18;
            worksheet.mergeCells(2, 1, 2, colCount);
            genRow.getCell(1).font = { italic: true, size: 10, color: { argb: 'FF64748B' } };
            genRow.getCell(1).alignment = { horizontal: 'center' };

            worksheet.addRow([]);

            var headerRow = worksheet.addRow(headers);
            headerRow.height = 28;
            headerRow.eachCell(function (cell) {
                cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1E3A5F' } };
                cell.font = { bold: true, color: { argb: 'FFFFFFFF' }, size: 11, name: 'Calibri' };
                cell.alignment = { vertical: 'middle', horizontal: 'center', wrapText: true };
                cell.border = { top: { style: 'medium', color: { argb: 'FF1E3A5F' } }, left: { style: 'medium', color: { argb: 'FF1E3A5F' } }, bottom: { style: 'medium', color: { argb: 'FF1E3A5F' } }, right: { style: 'medium', color: { argb: 'FF1E3A5F' } } };
            });

            var rowIndex = 0;
            $('#tblAssetDetail tbody tr').show();
            table.querySelectorAll('tbody tr').forEach(function (tr) {
                if (tr.querySelector('td[colspan]')) return;
                rowIndex++;
                var rowData = [];
                tr.querySelectorAll('td').forEach(function (td) { rowData.push(td.innerText.trim()); });
                rowData.splice(4, 0, '');

                var excelRow = worksheet.addRow(rowData);
                excelRow.height = 22;
                excelRow.eachCell(function (cell) {
                    cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: rowIndex % 2 === 0 ? 'FFF1F5F9' : 'FFFFFFFF' } };
                    cell.font = { size: 10, name: 'Calibri' };
                    cell.alignment = { vertical: 'middle', horizontal: 'center' };
                    cell.border = { top: { style: 'thin', color: { argb: 'FFE2E8F0' } }, left: { style: 'thin', color: { argb: 'FFE2E8F0' } }, bottom: { style: 'thin', color: { argb: 'FFE2E8F0' } }, right: { style: 'thin', color: { argb: 'FFE2E8F0' } } };
                });
            });
            if (typeof goToPage === 'function') goToPage(1);

            [8, 12, 15, 18, 15, 15, 15, 15].forEach(function (w, i) {
                worksheet.getColumn(i + 1).width = w;
            });

            worksheet.addRow([]);
            var footerRow = worksheet.addRow(['Total Records: ' + rowIndex]);
            footerRow.getCell(1).font = { bold: true, size: 10, color: { argb: 'FF64748B' } };

            workbook.xlsx.writeBuffer().then(function (buffer) {
                saveAs(new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }), getDownloadFileName('xlsx'));
                $("#loader").hide();
                CommonNotification("SUCCESS", "Excel downloaded successfully!", "Success");
            });

        } catch (err) {
            $("#loader").hide();
            console.error('Excel Error:', err);
            CommonNotification("ERROR", "Error downloading Excel", "Error");
        }
    }

