                        },
                        y: {
                            beginAtZero: true, grid: { color: th.grid },
                            ticks: { font: { size: 11 }, stepSize: 1, color: th.text3 }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });
            adChartList.push(c);
            $('#adChartContainer').append(adDataTableHtml(labels, values, total));
