    function adRenderGraph(data) {
        var stationKeys = Object.keys(data.stationOnlyGroups);
        if (stationKeys.length === 0) { adNoData(); return; }
        var th = adTheme();

        Chart.register(ChartDataLabels);

        // Build station → make → count AND station → type → count
        var stationMakeMap = {};
        var stationTypeMap = {};
        data.rows.forEach(function (r) {
            if (!stationMakeMap[r.station]) stationMakeMap[r.station] = {};
            if (!stationMakeMap[r.station][r.assetMake]) stationMakeMap[r.station][r.assetMake] = 0;
            stationMakeMap[r.station][r.assetMake] += r.count;

            if (!stationTypeMap[r.station]) stationTypeMap[r.station] = {};
            if (!stationTypeMap[r.station][r.assetType]) stationTypeMap[r.station][r.assetType] = 0;
            stationTypeMap[r.station][r.assetType] += r.count;
        });

        function buildStationLine(station, groupMap, groupLabel, canvasId, colorIdx) {
            var labels = Object.keys(groupMap);
            var values = labels.map(function (m) { return groupMap[m]; });
            var total = values.reduce(function (a, b) { return a + b; }, 0);
