                            font: { weight: '600', size: thinPoints ? 0 : 11 },
                            display: function (ctx) { return ctx.dataset.data[ctx.dataIndex] > 0; }
                        },
                        tooltip: {
                            backgroundColor: th.surface, titleColor: th.heading, bodyColor: th.text, borderColor: th.border, borderWidth: 1, padding: 12, cornerRadius: 8,
