@model Domain.AssetLister
@{ ViewBag.Title = "Asset";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
    bool isGuest = E7FRSAdvance.Utility.ClsHttpContent.LoginUser.UserClassId == E7FRSAdvance.Utility.Utility.UserClass.Guest.GetHashCode();
}

@*
    ============================================================================
    UNIFIED ASSET PAGE  —  Equipment Room model (interactive dashboard)
    ----------------------------------------------------------------------------
    One search loads BOTH inventory (_Details) and utilization (_Utilization,
    last 7/30/90 days) and merges them per station + asset type. The merged
    model drives three views like Equipment Room: Ranked, Cards, Table. A rich
    right drawer drills into one station + asset type: tiles, range chips,
    operations chart, top assets, make breakdown and the full utilization
    table (reusing the _Utilization partial, so the relay popup keeps working).
    ============================================================================
*@

<style>
    .search-section { padding: 18px 0; position: relative; z-index: 100; }
    .search-title { font-size: 18px; font-weight: 600; color: var(--e7-text); margin-bottom: 16px; }
    .filter-row { display: flex; align-items: flex-end; gap: 12px; flex-wrap: wrap; position: relative; z-index: 100; }
    .filter-item { flex-shrink: 0; position: relative; z-index: 100; }
    .filter-item label { display: block; font-size: 13px; color: var(--e7-text-2); margin-bottom: 6px; font-weight: 500; }
    .select-btn { display: flex; align-items: center; justify-content: space-between; background: var(--e7-surface); border: 1px solid var(--e7-border-2); border-radius: 6px; padding: 8px 12px; font-size: 14px; color: var(--e7-text); cursor: pointer; min-width: 150px; height: 40px; }
    .select-btn:hover { border-color: var(--e7-text-4); }
    .select-btn.active { border-color: var(--e7-accent); box-shadow: 0 0 0 2px var(--e7-accent-soft); }
    .select-btn .text { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: left; }
    .select-btn i { margin-left: 8px; font-size: 12px; color: var(--e7-text-3); }
    .filter-input { border: 1px solid var(--e7-border-2); border-radius: 6px; padding: 8px 12px; font-size: 14px; height: 40px; width: 130px; outline: none; background: var(--e7-surface); color: var(--e7-text); }
    .filter-input:focus { border-color: var(--e7-accent); box-shadow: 0 0 0 2px var(--e7-accent-soft); }
    .filter-dropdown { position: fixed; background: var(--e7-surface); border: 1px solid var(--e7-border); border-radius: 8px; box-shadow: var(--e7-shadow-pop); min-width: 240px; max-width: 320px; z-index: 11050; display: none; }
    .filter-dropdown.open { display: block; }
    .dropdown-search { padding: 10px 12px; border-bottom: 1px solid var(--e7-border); }
    .dropdown-search input { width: 100%; border: 1px solid var(--e7-border); border-radius: 6px; padding: 8px 12px; font-size: 13px; outline: none; background: var(--e7-surface); color: var(--e7-text); }
    .dropdown-header { padding: 10px 14px; background: var(--e7-surface-2); border-bottom: 1px solid var(--e7-border); display: flex; align-items: center; gap: 10px; }
    .dropdown-header input[type="checkbox"] { width: 18px; height: 18px; cursor: pointer; accent-color: var(--e7-accent); }
    .dropdown-header label { font-size: 14px; font-weight: 600; color: var(--e7-text); cursor: pointer; margin: 0; }
    .dropdown-list { max-height: 250px; overflow-y: auto; }
    .dropdown-item { display: flex; align-items: center; padding: 10px 14px; gap: 10px; cursor: pointer; border-bottom: 1px solid var(--e7-border); }
    .dropdown-item:last-child { border-bottom: none; }
    .dropdown-item:hover { background: var(--e7-surface-3); }
    .dropdown-item.checked { background: var(--e7-accent-soft); }
    .dropdown-item.hidden { display: none; }
    .dropdown-item input[type="checkbox"] { width: 18px; height: 18px; cursor: pointer; accent-color: var(--e7-accent); flex-shrink: 0; }
    .dropdown-item span { font-size: 14px; color: var(--e7-text); }
    .dropdown-item.checked span { color: var(--e7-accent-ink); font-weight: 500; }
    .dropdown-item span mark { background: var(--e7-amber-soft); color: var(--e7-text); padding: 0; }
    .dropdown-empty { padding: 25px; text-align: center; color: var(--e7-text-3); font-size: 14px; }
    .dropdown-no-results { padding: 20px; text-align: center; color: var(--e7-text-3); font-size: 13px; display: none; }
    .dropdown-no-results.show { display: block; }
    .btn-search { background: var(--primary); border: none; border-radius: 6px; padding: 8px 16px; height: 40px; display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer; color: #fff; font-size: 14px; font-weight: 500; }
    .dropdown-backdrop { position: fixed; inset: 0; z-index: 11040; display: none; }
    .dropdown-backdrop.show { display: block; }

    /* ---- shell ---- */
    .asx-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding: 2px 2px 14px; }
    .asx-head h4 { margin: 0; font-size: 17px; font-weight: 600; color: var(--e7-heading); display: inline-flex; align-items: center; gap: 10px; }
    .asx-meta { font-size: 12px; color: var(--e7-text-3); font-weight: 500; }
    .asx-seg { display: inline-flex; background: var(--e7-surface-2); border: 1px solid var(--e7-border); border-radius: 8px; padding: 3px; gap: 2px; }
    .asx-seg button { border: none; background: transparent; color: var(--e7-text-2); font-size: 13px; font-weight: 600; padding: 7px 14px; border-radius: 6px; cursor: pointer; display: inline-flex; align-items: center; gap: 7px; }
    .asx-seg button:hover { color: var(--e7-text); }
    .asx-seg button.active { background: var(--e7-surface); color: var(--e7-accent-ink); box-shadow: var(--e7-shadow-card, 0 1px 2px rgba(0,0,0,.08)); }
    .asx-seg.sm button { padding: 5px 11px; font-size: 12px; }
    .asx-pill { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; color: var(--e7-text-2); background: var(--e7-surface-2); border: 1px solid var(--e7-border); border-radius: 999px; padding: 5px 12px; }
    .asx-pill .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--e7-green, #16a34a); }

    .asx-kpis { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 14px; margin: 2px 0 18px; }
    .asx-kpi { background: var(--e7-surface); border: 1px solid var(--e7-border); border-radius: 10px; padding: 14px 16px; }
    .asx-kpi .k-label { font-size: 11px; text-transform: uppercase; letter-spacing: .5px; color: var(--e7-text-3); font-weight: 600; }
    .asx-kpi .k-val { font-size: 24px; font-weight: 700; color: var(--e7-heading); margin-top: 4px; line-height: 1.1; }
    .asx-kpi .k-val small { font-size: 13px; font-weight: 500; color: var(--e7-text-3); margin-left: 4px; }
    .asx-kpi .k-sub { font-size: 12px; color: var(--e7-text-3); margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    @@media (max-width: 991.98px) { .asx-kpis { grid-template-columns: repeat(2,1fr); } }
    @@media (max-width: 560px) { .asx-kpis { grid-template-columns: 1fr; } }

    .asx-empty { padding: 46px 18px; text-align: center; color: var(--e7-text-3); font-size: 13px; }
    .asx-skel { height: 64px; border-radius: 10px; background: linear-gradient(90deg, var(--e7-surface-2) 25%, var(--e7-surface-3) 37%, var(--e7-surface-2) 63%); background-size: 400% 100%; animation: asxShimmer 1.2s ease infinite; margin-bottom: 10px; }
    @@keyframes asxShimmer { 0% { background-position: 100% 0; } 100% { background-position: 0 0; } }

    /* ranked */
    .asx-rank-head { display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: var(--e7-text-3); padding: 2px 4px 10px; }
    .asx-rank-row { display: grid; grid-template-columns: 34px minmax(160px,1.4fr) 90px minmax(140px,1.6fr) 110px 36px; align-items: center; gap: 12px; padding: 11px 12px; border: 1px solid var(--e7-border); border-radius: 10px; margin-bottom: 8px; background: var(--e7-surface); cursor: pointer; transition: border-color .15s, box-shadow .15s; }
    .asx-rank-row:hover { border-color: var(--e7-accent); box-shadow: 0 0 0 2px var(--e7-accent-soft); }
    .asx-rank-row .rk-no { width: 28px; height: 28px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; background: var(--e7-surface-2); color: var(--e7-text-2); }
    .asx-rank-row.top .rk-no { background: var(--e7-amber-soft); color: var(--e7-amber, #b45309); }
    .asx-rank-row .rk-name { font-weight: 600; color: var(--e7-heading); font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .asx-rank-row .rk-sub { font-size: 12px; color: var(--e7-text-3); }
    .asx-rank-row .rk-count { font-size: 13px; color: var(--e7-text-2); }
    .asx-rank-row .rk-count b { color: var(--e7-heading); font-size: 15px; }
    .asx-bar { height: 8px; border-radius: 999px; background: var(--e7-surface-3); overflow: hidden; }
    .asx-bar > i { display: block; height: 100%; border-radius: 999px; background: var(--e7-accent, #2563eb); }
    .asx-rank-row .rk-val { text-align: right; font-weight: 700; color: var(--e7-heading); font-size: 15px; }
    .asx-rank-row .rk-val small { display: block; font-size: 11px; font-weight: 500; color: var(--e7-text-3); }
    .asx-rank-row .rk-go { color: var(--e7-text-4); text-align: right; }
    @@media (max-width: 767.98px) { .asx-rank-row { grid-template-columns: 30px 1fr 90px 30px; } .asx-rank-row .rk-count, .asx-rank-row .asx-bar { display: none; } }

    /* cards */
    .asx-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
    .asx-card { background: var(--e7-surface); border: 1px solid var(--e7-border); border-radius: 12px; padding: 14px 16px; cursor: pointer; transition: border-color .15s, box-shadow .15s; display: flex; flex-direction: column; gap: 10px; }
    .asx-card:hover { border-color: var(--e7-accent); box-shadow: 0 0 0 2px var(--e7-accent-soft); }
    .asx-card .c-head { display: flex; align-items: center; gap: 12px; }
    .asx-card .c-ico { width: 42px; height: 42px; border-radius: 10px; background: var(--e7-accent-soft); color: var(--e7-accent-ink); display: inline-flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
    .asx-card .c-title { font-weight: 600; color: var(--e7-heading); font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .asx-card .c-sub { font-size: 12px; color: var(--e7-text-3); }
    .asx-card .c-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .asx-card .c-stat { background: var(--e7-surface-2); border-radius: 8px; padding: 8px 10px; }
    .asx-card .c-stat .l { font-size: 10px; text-transform: uppercase; letter-spacing: .4px; color: var(--e7-text-3); font-weight: 600; }
    .asx-card .c-stat .v { font-size: 18px; font-weight: 700; color: var(--e7-heading); }
    .asx-card .c-stat .v small { font-size: 11px; color: var(--e7-text-3); font-weight: 500; }
    .asx-card .c-gauge { display: flex; align-items: center; gap: 10px; font-size: 11px; color: var(--e7-text-3); }
    .asx-card .c-gauge .asx-bar { flex: 1; }
    .asx-card .c-foot { display: flex; align-items: center; justify-content: space-between; font-size: 12px; color: var(--e7-text-3); border-top: 1px solid var(--e7-border); padding-top: 8px; }
    .asx-card .c-foot b { color: var(--e7-accent-ink); font-weight: 600; }
    .asx-chip { display: inline-block; font-size: 11px; background: var(--e7-surface-2); border: 1px solid var(--e7-border); border-radius: 999px; padding: 2px 8px; color: var(--e7-text-2); margin: 2px 4px 2px 0; }

    /* table */
    .asx-table tbody tr { cursor: pointer; }
    .asx-table td .asx-bar { min-width: 90px; }
    .asx-pager { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding: 10px 4px 0; font-size: 12px; color: var(--e7-text-3); }
    .asx-pager .pagination { margin: 0; }

    /* drawer */
    .asx-drawer { position: fixed; top: 0; right: 0; height: 100vh; width: 720px; max-width: 96vw; background: var(--e7-surface); border-left: 1px solid var(--e7-border); box-shadow: -14px 0 40px rgba(0,0,0,.16); z-index: 11000; transform: translateX(100%); transition: transform .28s ease; display: flex; flex-direction: column; }
    .asx-drawer.is-open { transform: translateX(0); }
    .asx-dr-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 18px; border-bottom: 1px solid var(--e7-border); }
    .asx-dr-head h4 { margin: 0; font-size: 16px; font-weight: 700; color: var(--e7-heading); }
    .asx-dr-btn { width: 34px; height: 34px; border: 1px solid var(--e7-border); background: var(--e7-surface-2); border-radius: 8px; cursor: pointer; color: var(--e7-text-2); font-size: 13px; }
    .asx-dr-btn:hover { color: var(--e7-text); border-color: var(--e7-text-4); }
    .asx-dr-body { padding: 16px 18px; overflow-y: auto; flex: 1; }
    .asx-dr-tiles { display: grid; grid-template-columns: repeat(4,1fr); gap: 10px; margin-bottom: 14px; }
    .asx-tile { background: var(--e7-surface-2); border: 1px solid var(--e7-border); border-radius: 10px; padding: 10px 12px; }
    .asx-tile .t-l { font-size: 10px; color: var(--e7-text-3); text-transform: uppercase; letter-spacing: .4px; font-weight: 600; }
    .asx-tile .t-v { font-size: 20px; font-weight: 700; color: var(--e7-heading); margin-top: 2px; }
    .asx-tile .t-v small { font-size: 11px; color: var(--e7-text-3); font-weight: 500; }
    .asx-dr-tools { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 14px; }
    .asx-dr-title { font-size: 12px; text-transform: uppercase; letter-spacing: .6px; color: var(--e7-text-3); font-weight: 700; margin: 16px 0 8px; display: flex; align-items: center; gap: 7px; }
    .asx-dr-chart { position: relative; height: 230px; background: var(--e7-surface-2); border: 1px solid var(--e7-border); border-radius: 10px; padding: 10px; }
    .asx-list { border: 1px solid var(--e7-border); border-radius: 10px; overflow: hidden; }
    .asx-list-row { display: grid; grid-template-columns: 28px 1fr 120px 80px; align-items: center; gap: 10px; padding: 9px 12px; border-bottom: 1px solid var(--e7-border); font-size: 13px; }
    .asx-list-row:last-child { border-bottom: none; }
    .asx-list-row .n { font-weight: 600; color: var(--e7-heading); }
    .asx-list-row .n small { color: var(--e7-text-3); font-weight: 400; margin-left: 6px; }
    .asx-list-row .v { text-align: right; font-weight: 700; color: var(--e7-heading); }
    .asx-link { background: none; border: 1px solid var(--e7-border); border-radius: 8px; color: var(--e7-accent-ink); font-weight: 600; font-size: 12px; padding: 7px 12px; cursor: pointer; width: 100%; margin-top: 12px; }
    .asx-link:hover { background: var(--e7-surface-2); }
    .asx-dr-msg { padding: 24px 18px; text-align: center; color: var(--e7-text-3); font-size: 13px; }
    .asx-dr-backdrop { position: fixed; inset: 0; background: rgba(15,23,42,.28); z-index: 10900; display: none; }
    .asx-dr-backdrop.show { display: block; }
    #asDrFull #selectedRangeBar, #asDrFull #btnDownload { display: none !important; }
    #asDrFull .my-4 { margin: 0 !important; }
</style>

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<section class="section" id="assetPage">
    <div class="row"><div class="col-lg-12"><div class="card"><div class="card-body p-0"><div class="row">
        <div class="col-12 col-sm-6"><nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item">Asset</li><li class="breadcrumb-item active" aria-current="page"><a href="#">Inventory &amp; Utilization</a></li></ol></nav></div>
        <div class="col-12 col-sm-6 d-flex flex-sm-row-reverse align-items-center"><h2 class="page-name">Asset</h2></div>
    </div></div></div></div></div>

    <div class="row"><div class="col-lg-12"><div class="card"><div class="card-body p-0">
        <div class="search-section">
            <div class="search-title">Search</div>
            <div class="dropdown-backdrop" id="backdrop"></div>
            <div class="filter-row">
                <div class="filter-item"><label>Zone</label><div class="select-btn" id="btnZone" data-target="ddZone"><span class="text" id="txtZone">All</span><i class="fas fa-chevron-down"></i></div></div>
                <div class="filter-item"><label>Division</label><div class="select-btn" id="btnDivision" data-target="ddDivision"><span class="text" id="txtDivision">All</span><i class="fas fa-chevron-down"></i></div></div>
                <div class="filter-item"><label>Station</label><div class="select-btn" id="btnSite" data-target="ddSite"><span class="text" id="txtSite">All</span><i class="fas fa-chevron-down"></i></div></div>
                <div class="filter-item"><label>Asset Type</label><div class="select-btn" id="btnAssetType" data-target="ddAssetType"><span class="text" id="txtAssetType">All</span><i class="fas fa-chevron-down"></i></div></div>
                <div class="filter-item"><label>Asset Make</label><div class="select-btn" id="btnAssetMake" data-target="ddAssetMake"><span class="text" id="txtAssetMake">All</span><i class="fas fa-chevron-down"></i></div></div>
                <div class="filter-item"><label>Asset Number</label><div class="select-btn" id="btnAssetNumber" data-target="ddAssetNumber"><span class="text" id="txtAssetNumber">All</span><i class="fas fa-chevron-down"></i></div></div>
                <div class="filter-item"><label>&nbsp;</label><button type="button" class="btn-search" id="btnSearch" onclick="asSearch()"><i class="fa-solid fa-magnifying-glass"></i></button></div>
            </div>
        </div>
        <div class="filter-dropdown" id="ddZone">
            <div class="dropdown-search"><input type="text" placeholder="Search zone..." onkeyup="asFilterDropdown('zone', this.value)"></div>
            <div class="dropdown-header"><input type="checkbox" id="chkAllZone"><label for="chkAllZone">Select All</label></div>
            <div class="dropdown-list" id="listZone">
                @if (ViewBag.Zones != null) { foreach (var z in (IEnumerable<SelectListItem>)ViewBag.Zones) {
                    <div class="dropdown-item" data-value="@z.Value" data-text="@z.Text"><input type="checkbox" class="cb-zone" value="@z.Value"><span>@z.Text</span></div>
                } }
            </div><div class="dropdown-no-results">No results found</div>
        </div>
        <div class="filter-dropdown" id="ddDivision">
            <div class="dropdown-search"><input type="text" placeholder="Search division..." onkeyup="asFilterDropdown('division', this.value)"></div>
            <div class="dropdown-header"><input type="checkbox" id="chkAllDivision"><label for="chkAllDivision">Select All</label></div>
            <div class="dropdown-list" id="listDivision">
                @if (ViewBag.Divisions != null) { foreach (var d in (IEnumerable<SelectListItem>)ViewBag.Divisions) {
                    <div class="dropdown-item" data-value="@d.Value" data-text="@d.Text"><input type="checkbox" class="cb-division" value="@d.Value"><span>@d.Text</span></div>
                } }
            </div><div class="dropdown-no-results">No results found</div>
        </div>
        <div class="filter-dropdown" id="ddSite">
            <div class="dropdown-search"><input type="text" placeholder="Search station..." onkeyup="asFilterDropdown('site', this.value)"></div>
            <div class="dropdown-header"><input type="checkbox" id="chkAllSite"><label for="chkAllSite">Select All</label></div>
            <div class="dropdown-list" id="listSite">
                @if (ViewBag.Sites != null) { foreach (var s in (IEnumerable<SelectListItem>)ViewBag.Sites) {
                    <div class="dropdown-item" data-value="@s.Value" data-text="@s.Text"><input type="checkbox" class="cb-site" value="@s.Value"><span>@s.Text</span></div>
                } }
            </div><div class="dropdown-no-results">No results found</div>
        </div>
        <div class="filter-dropdown" id="ddAssetType">
            <div class="dropdown-search"><input type="text" placeholder="Search asset type..." onkeyup="asFilterDropdown('assetType', this.value)"></div>
            <div class="dropdown-header"><input type="checkbox" id="chkAllAssetType"><label for="chkAllAssetType">Select All</label></div>
            <div class="dropdown-list" id="listAssetType"><div class="dropdown-empty">Select a station first</div></div><div class="dropdown-no-results">No results found</div>
        </div>
        <div class="filter-dropdown" id="ddAssetMake">
            <div class="dropdown-search"><input type="text" placeholder="Search asset make..." onkeyup="asFilterDropdown('assetMake', this.value)"></div>
            <div class="dropdown-header"><input type="checkbox" id="chkAllAssetMake"><label for="chkAllAssetMake">Select All</label></div>
            <div class="dropdown-list" id="listAssetMake"><div class="dropdown-empty">Select a station first</div></div><div class="dropdown-no-results">No results found</div>
        </div>
        <div class="filter-dropdown" id="ddAssetNumber">
            <div class="dropdown-search"><input type="text" placeholder="Search asset number..." onkeyup="asFilterDropdown('assetNumber', this.value)"></div>
            <div class="dropdown-header"><input type="checkbox" id="chkAllAssetNumber"><label for="chkAllAssetNumber">Select All</label></div>
            <div class="dropdown-list" id="listAssetNumber"><div class="dropdown-empty">Select Station &amp; Asset Type</div></div><div class="dropdown-no-results">No results found</div>
        </div>
    </div></div></div></div>

    <!-- Status card -->
    <div class="row"><div class="col-lg-12"><div class="card"><div class="card-body">
        <div class="asx-head">
            <div>
                <h4>Asset Status <span class="asx-meta" id="asMeta"></span></h4>
            </div>
            <div class="d-flex align-items-center flex-wrap" style="gap:10px;">
                <span class="asx-pill" id="asRangePill" style="display:none;"><span class="dot"></span><span id="asRangeText">Today</span></span>
                <div class="asx-seg sm" id="asRangeChips" style="display:none;">
                    <button type="button" class="active" data-days="0">Today</button>
                    <button type="button" data-days="7">7d</button>
                    <button type="button" data-days="30">30d</button>
                    <button type="button" data-days="90">90d</button>
                </div>
                <div class="asx-seg" id="asViewToggle" style="display:none;">
                    <button type="button" class="active" data-view="rank"><i class="fas fa-ranking-star"></i> Ranked</button>
                    <button type="button" data-view="cards"><i class="fas fa-grip"></i> Cards</button>
                    <button type="button" data-view="table"><i class="fas fa-table"></i> Table</button>
                </div>
                @if (!isGuest)
                {
                    <div class="dropdown" id="asDownloadWrap" style="display:none;">
                        <button class="btn btn-inactive" id="asDownloadBtn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Download">
                            <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d='M4 16.004V17a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1M12 4.5v11m3.5-3.5L12 15.5 8.5 12' /></svg>
                        </button>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="asDownloadBtn">
                            <a class="dropdown-item" href="javascript:void(0);" onclick="asDownload('excel')"><i class="fa fa-file-excel mr-2" style="color:var(--e7-green,#22c55e);"></i> Excel</a>
                            <a class="dropdown-item" href="javascript:void(0);" onclick="asDownload('csv')"><i class="fa fa-file-alt mr-2" style="color:var(--e7-accent,#3b82f6);"></i> CSV</a>
                            <a class="dropdown-item" href="javascript:void(0);" onclick="asDownload('pdf')"><i class="fa fa-file-pdf mr-2" style="color:var(--e7-red,#ef4444);"></i> PDF</a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="asx-kpis" id="asKpis" style="display:none;">
            <div class="asx-kpi"><div class="k-label">Total assets</div><div class="k-val" id="asK1"></div><div class="k-sub" id="asK1S"></div></div>
            <div class="asx-kpi"><div class="k-label">Stations</div><div class="k-val" id="asK2"></div><div class="k-sub" id="asK2S"></div></div>
            <div class="asx-kpi"><div class="k-label">Most utilized</div><div class="k-val" id="asK3"></div><div class="k-sub" id="asK3S"></div></div>
            <div class="asx-kpi"><div class="k-label">Avg operations / asset</div><div class="k-val" id="asK4"></div><div class="k-sub" id="asK4S"></div></div>
        </div>

        <div id="asEmpty" class="asx-empty">
            <i class="fas fa-magnifying-glass fa-2x d-block mb-3" style="color:var(--e7-text-4);"></i>
            Choose a station and press search. Rows and cards open the asset's utilization.
        </div>
        <div id="asLoading" style="display:none;"><div class="asx-skel"></div><div class="asx-skel"></div><div class="asx-skel"></div></div>

        <div id="asRank" style="display:none;">
            <div class="asx-rank-head"><span id="asRankInfo"></span>
                <div class="asx-seg sm" id="asRankSort"><button type="button" class="active" data-sort="ops">By utilization</button><button type="button" data-sort="count">By asset count</button><button type="button" data-sort="name">By name</button></div>
            </div>
            <div id="asRankList"></div>
        </div>
        <div id="asCards" class="asx-grid" style="display:none;"></div>
        <div id="asTable" style="display:none;">
            <div class="table-responsive">
                <table class="table table-hover asx-table" id="asMergedTable">
                    <thead class="thead-light2"><tr><th>Sr.No</th><th>Zone</th><th>Division</th><th>Station</th><th>Asset Type</th><th>Makes</th><th class="text-center">Assets</th><th>Utilization</th><th class="text-right">Operations</th><th class="text-right">Signal hrs</th></tr></thead>
                    <tbody id="asTableBody"></tbody>
                </table>
            </div>
            <div class="asx-pager"><span id="asTableInfo"></span><ul class="pagination" id="asTablePager"></ul></div>
        </div>
    </div></div></div></div>
</section>

<!-- Drawer -->
<div class="asx-dr-backdrop" id="asDrBackdrop" onclick="asCloseDrawer()"></div>
<aside class="asx-drawer" id="asDrawer" aria-hidden="true">
    <div class="asx-dr-head">
        <div><h4 id="asDrTitle">Asset</h4><div class="asx-meta" id="asDrSub"></div></div>
        <div style="display:flex; gap:6px;">
            <button type="button" class="asx-dr-btn" onclick="asDrStep(-1)" title="Previous"><i class="fas fa-chevron-up"></i></button>
            <button type="button" class="asx-dr-btn" onclick="asDrStep(1)" title="Next"><i class="fas fa-chevron-down"></i></button>
            <button type="button" class="asx-dr-btn" onclick="asCloseDrawer()" title="Close"><i class="fas fa-times"></i></button>
        </div>
    </div>
    <div class="asx-dr-body">
        <div class="asx-dr-tiles">
            <div class="asx-tile"><div class="t-l">Assets</div><div class="t-v" id="asDrTAssets">—</div></div>
            <div class="asx-tile"><div class="t-l">Operations</div><div class="t-v" id="asDrTOps">—</div></div>
            <div class="asx-tile"><div class="t-l">Signal hours</div><div class="t-v" id="asDrTHours">—</div></div>
            <div class="asx-tile"><div class="t-l">Makes</div><div class="t-v" id="asDrTMakes">—</div></div>
        </div>
        <div class="asx-dr-tools">
            <div class="asx-seg sm" id="asDrChips">
                <button type="button" class="active" data-days="0">Today</button><button type="button" data-days="7">7d</button><button type="button" data-days="30">30d</button><button type="button" data-days="90">90d</button>
            </div>
            <input type="text" class="filter-input" id="asDrFrom" readonly style="width:118px;height:34px;padding:4px 10px;font-size:13px;">
            <span style="color:var(--e7-text-4);">&rarr;</span>
            <input type="text" class="filter-input" id="asDrTo" readonly style="width:118px;height:34px;padding:4px 10px;font-size:13px;">
            <button type="button" class="btn-search" id="asDrSearchBtn" onclick="asDrSearch(true)" style="height:34px;padding:4px 12px;"><i class="fa-solid fa-magnifying-glass"></i></button>
            <div style="flex:1;"></div>
            @if (!isGuest)
            {
                <div class="dropdown" id="asDrDownloadWrap" style="display:none;">
                    <button class="btn btn-inactive" data-toggle="dropdown" title="Download" style="height:34px;">
                        <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d='M4 16.004V17a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1M12 4.5v11m3.5-3.5L12 15.5 8.5 12' /></svg>
                    </button>
                    <div class="dropdown-menu dropdown-menu-right">
                        <a class="dropdown-item" href="javascript:void(0);" onclick="asDrDownload('excel')"><i class="fa fa-file-excel mr-2" style="color:var(--e7-green,#22c55e);"></i> Excel</a>
                        <a class="dropdown-item" href="javascript:void(0);" onclick="asDrDownload('csv')"><i class="fa fa-file-alt mr-2" style="color:var(--e7-accent,#3b82f6);"></i> CSV</a>
                        <a class="dropdown-item" href="javascript:void(0);" onclick="asDrDownload('pdf')"><i class="fa fa-file-pdf mr-2" style="color:var(--e7-red,#ef4444);"></i> PDF</a>
                    </div>
                </div>
            }
        </div>

        <div class="asx-dr-title"><i class="fas fa-chart-bar"></i> Operations by asset</div>
        <div class="asx-dr-chart"><canvas id="asDrChart"></canvas><div id="asDrChartMsg" class="asx-dr-msg" style="display:none;position:absolute;inset:0;align-items:center;justify-content:center;"></div></div>

        <div class="asx-dr-title"><i class="fas fa-trophy"></i> Top assets</div>
        <div class="asx-list" id="asDrTop"></div>

        <div class="asx-dr-title"><i class="fas fa-industry"></i> Make breakdown</div>
        <div class="asx-list" id="asDrMakes"></div>

        <button type="button" class="asx-link" id="asDrFullBtn" onclick="asDrToggleFull()"><i class="fas fa-table"></i> Show full utilization table</button>
        <div id="asDrFull" style="display:none; margin-top:10px;"></div>
    </div>
</aside>

<script>
    // =====================================================================
    //  STATE
    // =====================================================================
    var asView = 'rank', asRankSortKey = 'ops', asDays = 0;   // 0 = today only: the range 616's Utilization page sends by default
    var asOpenDropdown = null, asTypeMap = {};
    var asGroups = [];               // merged model: [{key, zone, division, station, type, siteId, typeId, count, makes:{}, ops, hours, assets, items}]
    var asGroupIdx = {};             // key -> group
    var asDrKey = null, asDrDays = 0, asDrPts = [], asDrChartObj = null, asDrFullOpen = false;
    var _asInvXhr = null, _asUtilXhr = null, _asDrXhr = null, _asMakeXhr = null, _asTypesXhr = null, _asSearchQueued = false, asUtilState = 'idle';   // idle | loading | ok | failed
    var asInvState = 'idle', asInvHtml = '', asUtilHtml = '';             // latest responses; the model is rebuilt from both
    var AS_FETCH_TIMEOUT_MS = 180000;   // never leave the loading skeleton up forever
    var _asOrigDivision = null, _asOrigSite = null;
    var asTablePage = 1, AS_TABLE_PAGE = 15;

    // =====================================================================
    //  UTILS
    // =====================================================================
    function asCap(s) { if (s === 'assetType') return 'AssetType'; if (s === 'assetMake') return 'AssetMake'; if (s === 'assetNumber') return 'AssetNumber'; return s.charAt(0).toUpperCase() + s.slice(1); }
    function asEsc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
    function asEscRegex(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
    function asGetValues(type) { var v = []; $('.cb-' + type + ':checked').each(function () { v.push($(this).val()); }); return v; }
    function asNotify(m) { if (typeof CommonNotification === 'function') CommonNotification('ERROR', m, 'Error'); else alert(m); }
    function asFmtDMY(d) { return String(d.getDate()).padStart(2, '0') + '/' + String(d.getMonth() + 1).padStart(2, '0') + '/' + d.getFullYear(); }
    function asToServerDate(s) { if (!s) return ''; var p = s.split('/'); if (p.length !== 3) return s; return p[1] + '/' + p[0] + '/' + p[2]; }
    function asRange(days) { var to = new Date(), from = new Date(); from.setDate(from.getDate() - days); return { from: asFmtDMY(from), to: asFmtDMY(to) }; }
    function asRangeLabel(d) { return d > 0 ? 'Last ' + d + ' days' : 'Today'; }
    function asRangeShort(d) { return d > 0 ? d + 'd' : 'today'; }
    function asNum(n, d) { return (Math.round((n + Number.EPSILON) * Math.pow(10, d || 0)) / Math.pow(10, d || 0)).toLocaleString(); }
    function asTypeIcon(t) {
        t = (t || '').toLowerCase();
        if (t.indexOf('point') > -1) return 'fa-arrows-left-right';
        if (t.indexOf('signal') > -1) return 'fa-traffic-light';
        if (t.indexOf('track') > -1) return 'fa-road';
        if (t.indexOf('axle') > -1) return 'fa-train';
        if (t.indexOf('ips') > -1 || t.indexOf('power') > -1 || t.indexOf('battery') > -1) return 'fa-bolt';
        if (t.indexOf('relay') > -1) return 'fa-microchip';
        if (t.indexOf('gate') > -1 || t.indexOf('lc') > -1) return 'fa-door-closed';
        return 'fa-cube';
    }

    // =====================================================================
    //  DROPDOWNS + CASCADES
    // =====================================================================
    function asToggleDD(id, btn) {
        if (asOpenDropdown === id) { asCloseDD(); return; }
        asCloseDD();
        var $dd = $('#' + id); $('body').append($dd);
        var r = btn.getBoundingClientRect();
        $dd.css({ position: 'absolute', visibility: 'hidden', display: 'block', top: '-9999px', left: '-9999px' });
        var h = $dd.outerHeight(), w = $dd.outerWidth(), top = r.bottom + 4, left = r.left;
        if (top + h > window.innerHeight) top = r.top - h - 4;
        if (left + w > window.innerWidth) left = window.innerWidth - w - 8;
        $dd.css({ visibility: '', display: '', top: top + 'px', left: left + 'px' }).addClass('open');
        $(btn).addClass('active'); $('#backdrop').addClass('show'); asOpenDropdown = id;
        setTimeout(function () { $dd.find('.dropdown-search input').focus(); }, 80);
    }
    function asCloseDD() {
        if (!asOpenDropdown) return;
        var $dd = $('#' + asOpenDropdown);
        $dd.find('.dropdown-search input').val('');
        $dd.find('.dropdown-item').removeClass('hidden').each(function () { var t = $(this).data('text'); if (t) $(this).find('span').text(t); });
        $dd.find('.dropdown-no-results').removeClass('show'); $dd.removeClass('open');
        $('.select-btn').removeClass('active'); $('#backdrop').removeClass('show'); asOpenDropdown = null;
    }
    function asFilterDropdown(type, txt) {
        var $dd = $('#dd' + asCap(type)), $items = $dd.find('.dropdown-list .dropdown-item'), $nr = $dd.find('.dropdown-no-results');
        var s = (txt || '').toLowerCase().trim(), vis = 0;
        $items.each(function () {
            var $i = $(this), t = ($i.data('text') || $i.find('span').text()).toLowerCase();
            if (s === '' || t.indexOf(s) > -1) {
                $i.removeClass('hidden'); vis++;
                var orig = $i.data('text') || $i.find('span').text();
                if (s !== '') $i.find('span').html(String(orig).replace(new RegExp('(' + asEscRegex(txt) + ')', 'gi'), '<mark>$1</mark>')); else $i.find('span').text(orig);
            } else $i.addClass('hidden');
        });
        $nr.toggleClass('show', vis === 0 && s !== '');
    }
    function asUpdateText(type) {
        var $all = $('.cb-' + type), $ck = $('.cb-' + type + ':checked'), c = $ck.length, t = $all.length, text = 'All';
        if (c === 1) text = $ck.first().closest('.dropdown-item').data('text') || $ck.first().closest('.dropdown-item').find('span').text();
        else if (c > 1 && c === t) text = 'All (' + c + ')'; else if (c > 1) text = c + ' selected';
        $('#txt' + asCap(type)).text(text);
    }
    function asUpdateAllState(type) { var $all = $('#list' + asCap(type) + ' .cb-' + type); $('#chkAll' + asCap(type)).prop('checked', $all.length > 0 && $all.length === $all.filter(':checked').length); }
    function asSelectAll(type, checked) {
        $('#list' + asCap(type) + ' .dropdown-item').each(function () { if (!$(this).hasClass('hidden')) { $(this).find('input[type="checkbox"]').prop('checked', checked); $(this).toggleClass('checked', checked); } });
        asUpdateText(type);
    }
    function asClear(type) { $('#list' + asCap(type)).empty(); $('#chkAll' + asCap(type)).prop('checked', false); $('#txt' + asCap(type)).text('All'); }
    function asMsg(type, m) { $('#list' + asCap(type)).html('<div class="dropdown-empty">' + m + '</div>'); $('#chkAll' + asCap(type)).prop('checked', false); $('#txt' + asCap(type)).text('All'); }
    function asResetText(type) { $('#chkAll' + asCap(type)).prop('checked', false); $('#txt' + asCap(type)).text('All'); }
    function asBuildList(type, items, valKey, nameKey) {
        var html = '';
        $.each(items, function (i, it) { html += '<div class="dropdown-item" data-value="' + it[valKey] + '" data-text="' + asEsc(it[nameKey]) + '"><input type="checkbox" class="cb-' + type + '" value="' + it[valKey] + '"><span>' + asEsc(it[nameKey]) + '</span></div>'; });
        $('#list' + asCap(type)).html(html || '<div class="dropdown-empty">None found</div>');
        $('#chkAll' + asCap(type)).prop('checked', false); $('#txt' + asCap(type)).text('All');
    }
    function asResetDownstream(changed) {
        var order = ['zone', 'division', 'site', 'assetType', 'assetMake', 'assetNumber'], idx = order.indexOf(changed);
        for (var i = idx + 1; i < order.length; i++) { var t = order[i]; if (t === 'assetNumber') asMsg(t, 'Select Station &amp; Asset Type'); else if (t === 'assetMake' || t === 'assetType') asMsg(t, 'Select a station first'); else asClear(t); }
    }
    function asLoadDivisions() {
        var zoneIds = asGetValues('zone').map(Number); asResetDownstream('division');
        if (!zoneIds.length) { $('#listDivision').html(_asOrigDivision); $('#listSite').html(_asOrigSite); asResetText('division'); asResetText('site'); return; }
        $.ajax({ url: '/FRS25/AssetDetail/GetDivisionByZoneId', type: 'POST', contentType: 'application/json', data: JSON.stringify({ SearchCriteria: { ZoneIds: zoneIds } }),
            success: function (d) { asBuildList('division', d, 'Id', 'Name'); asClear('site'); }, error: function () { asNotify('Failed to load divisions.'); } });
    }
    function asLoadSites() {
        var divIds = asGetValues('division').map(Number); asResetDownstream('site');
        if (!divIds.length) { $('#listSite').html(_asOrigSite); asResetText('site'); return; }
        $.ajax({ url: '/FRS25/AssetDetail/GetSiteByDivisionId', type: 'POST', contentType: 'application/json', data: JSON.stringify({ SearchCriteria: { DivisionIds: divIds } }),
            success: function (d) { asBuildList('site', d, 'Id', 'Name'); }, error: function () { asNotify('Failed to load sites.'); } });
    }
    function asLoadAssetTypes() {
        var siteIds = asGetValues('site'); asResetDownstream('assetType'); asTypeMap = {};
        if (!siteIds.length) { asMsg('assetType', 'Select a station first'); return; }
        $('#listAssetType').html('<div class="dropdown-empty">Loading...</div>');
        if (_asTypesXhr) _asTypesXhr.abort();
        _asTypesXhr = $.ajax({ url: '/FRS25/AssetDetail/GetAssetTypeBySiteIds', type: 'POST', contentType: 'application/json', data: JSON.stringify(siteIds),
            complete: function () { _asTypesXhr = null; },
            success: function (d) {
                if (d && d.length) {
                    var html = '';
                    $.each(d, function (i, it) { asTypeMap[it.Name] = it.Id; html += '<div class="dropdown-item" data-value="' + it.Id + '" data-name="' + asEsc(it.Name) + '" data-text="' + asEsc(it.Name) + '"><input type="checkbox" class="cb-assetType" value="' + it.Id + '"><span>' + asEsc(it.Name) + '</span></div>'; });
                    $('#listAssetType').html(html);
                } else asMsg('assetType', 'No asset types found');
            }, error: function () { asMsg('assetType', 'Failed to load asset types'); } });
        asLoadMakes();   // 616: makes load as soon as a station is selected (all types)
    }
    // 616 Utilization: Asset Number list for the selected stations + asset types (sent as AssetIds)
    var _asNumXhr = null;
    function asLoadAssetNumbers() {
        var siteIds = asGetValues('site').filter(function (id) { return id && id !== '0'; });
        var typeIds = asGetValues('assetType').filter(function (id) { return id && id !== '0'; });
        if (_asNumXhr) { _asNumXhr.abort(); _asNumXhr = null; }
        if (!siteIds.length || !typeIds.length) { asMsg('assetNumber', 'Select Station &amp; Asset Type'); return; }
        $('#listAssetNumber').html('<div class="dropdown-empty">Loading...</div>'); asResetText('assetNumber');
        _asNumXhr = $.ajax({ url: '/FRS25/AssetDetail/GetUtilizationAssestBy', type: 'POST', contentType: 'application/json', dataType: 'json',
            data: JSON.stringify({ assetTypeIds: typeIds, siteIds: siteIds }),
            success: function (data) {
                var seen = {}, list = [];
                if (data && data.length) data.forEach(function (it) { if (it && it.Id && !seen[it.Id]) { seen[it.Id] = true; list.push({ Id: it.Id, Name: it.Name || it.AssetName || '' }); } });
                list.sort(function (a, b) { return (a.Name || '').localeCompare(b.Name || ''); });
                if (list.length) asBuildList('assetNumber', list, 'Id', 'Name'); else asMsg('assetNumber', 'No assets found');
            },
            error: function (x, s) { if (s === 'abort') return; asMsg('assetNumber', 'No assets found'); },
            complete: function () { _asNumXhr = null; } });
    }
    function asLoadMakes() {
        var siteIds = asGetValues('site').map(Number);
        if (!siteIds.length) { asMsg('assetMake', 'Select a station first'); return; }
        var typeNames = $('.cb-assetType:checked').map(function () { return $(this).closest('.dropdown-item').data('name'); }).get(), prev = asGetValues('assetMake');
        if (_asMakeXhr) _asMakeXhr.abort();
        $('#listAssetMake').html('<div class="dropdown-empty">Loading...</div>');
        _asMakeXhr = $.ajax({ url: '/FRS25/AssetDetail/GetAssetFilters', type: 'POST', contentType: 'application/json',
            data: JSON.stringify({ SearchCriteria: { ZoneIds: asGetValues('zone'), DivisionIds: asGetValues('division'), SiteIds: siteIds, AssetTypes: typeNames, siteAttributeDatasList: [] } }),
            success: function (data) {
                if (data.AssetMakes && data.AssetMakes.length) {
                    var html = '';
                    $.each(data.AssetMakes, function (i, m) { var ck = prev.indexOf(m) > -1; html += '<div class="dropdown-item' + (ck ? ' checked' : '') + '" data-value="' + asEsc(m) + '" data-text="' + asEsc(m) + '"><input type="checkbox" class="cb-assetMake" value="' + asEsc(m) + '"' + (ck ? ' checked' : '') + '><span>' + asEsc(m) + '</span></div>'; });
                    $('#listAssetMake').html(html);
                } else asMsg('assetMake', 'No asset makes found');
                asUpdateAllState('assetMake'); asUpdateText('assetMake');
            }, error: function (x, s) { if (s === 'abort') return; asMsg('assetMake', 'Failed to load makes'); }, complete: function () { _asMakeXhr = null; } });
    }

    // =====================================================================
    //  SEARCH: inventory + utilization in parallel, merged per station+type
    // =====================================================================
    function asParse(html) { return $('<div>').append($.parseHTML(html, document, false)); }  // keepScripts=false
    function asFetchInventory(siteIds) {
        var payload = { SearchCriteria: { ZoneIds: asGetValues('zone'), DivisionIds: asGetValues('division'), SiteIds: siteIds,
            AssetTypes: $('.cb-assetType:checked').map(function () { return $(this).closest('.dropdown-item').data('name'); }).get(), siteAttributeDatasList: asGetValues('assetMake') } };
        return $.ajax({ url: '/FRS25/AssetDetail/_Details', type: 'POST', contentType: 'application/json', data: JSON.stringify(payload), dataType: 'html', timeout: AS_FETCH_TIMEOUT_MS });
    }
    function asFetchUtil(siteIds, typeIds, days) {
        var r = asRange(days);
        var payload = { SearchCriteria: { ZoneIds: asGetValues('zone'), DivisionIds: asGetValues('division'), SiteIds: siteIds, AssetTypeIds: typeIds, AssetIds: asGetValues('assetNumber'), StartDate: asToServerDate(r.from), EndDate: asToServerDate(r.to) } };
        return $.ajax({ url: '/FRS25/AssetDetail/_Utilization', type: 'POST', contentType: 'application/json', data: JSON.stringify(payload), dataType: 'html', timeout: AS_FETCH_TIMEOUT_MS });
    }
    function asSearch() {
        var siteIds = asGetValues('site');
        if (!siteIds.length) { asNotify('Station is required.'); return; }
        // The station's asset types are still loading (e.g. the favourite station was
        // just ticked and Search clicked right after). Utilization needs those type ids,
        // so wait for them instead of searching with none and silently skipping it.
        if (_asTypesXhr) {
            if (!_asSearchQueued) {
                _asSearchQueued = true;
                asShowLoading(); $('#btnSearch').prop('disabled', true);
                _asTypesXhr.always(function () { _asSearchQueued = false; $('#btnSearch').prop('disabled', false); setTimeout(asSearch, 0); });
            }
            return;
        }
        if (_asInvXhr) _asInvXhr.abort(); if (_asUtilXhr) _asUtilXhr.abort();
        asShowLoading(); $('#btnSearch').prop('disabled', true);
        // In 616 Asset Detail (inventory) and Asset Utilization were separate pages with
        // separate requests. Keep them independent here: both requests run in parallel and
        // the view is rebuilt from whatever has arrived, so either one can show data even
        // when the other is empty, slow or failed.
        asGroups = []; asGroupIdx = {}; asInvHtml = ''; asUtilHtml = ''; asInvState = 'loading'; asUtilState = 'idle';
        var invX = _asInvXhr = asFetchInventory(siteIds).done(function (html) { asInvHtml = html; asInvState = 'ok'; })
            .fail(function (x, s) {
                if (s === 'abort') return;
                asInvState = 'failed';
