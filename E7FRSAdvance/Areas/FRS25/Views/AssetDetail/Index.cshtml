        var table = document.querySelector('#divAlertDetailReport table');
        if (!table) { alert('No data available to download'); return; }

        try {
            $("#loader").show();
            var headers = ['Sr.No', 'Zone', 'Division', 'Station', 'Vendor Name', 'Asset Type', 'Make of Asset', 'Count'];

            var generatedNow = (function () {
                var now = new Date();
                return String(now.getDate()).padStart(2, '0') + '/' +
                    String(now.getMonth() + 1).padStart(2, '0') + '/' +
                    now.getFullYear() + '  ' +
                    String(now.getHours()).padStart(2, '0') + ':' +
                    String(now.getMinutes()).padStart(2, '0') + ':' +
                    String(now.getSeconds()).padStart(2, '0');
            })();

            var csv = [];
            csv.push('"Asset Detail Report"');
            csv.push('"Generated: ' + generatedNow + '"');
            csv.push('');
            csv.push(headers.map(function (h) { return '"' + h + '"'; }).join(','));

            $('#tblAssetDetail tbody tr').show();
            table.querySelectorAll('tbody tr').forEach(function (row) {
                if (row.querySelector('td[colspan]')) return;
                var rowData = [];
                row.querySelectorAll('td').forEach(function (col) {
                    var text = col.innerText.replace(/(\r\n|\n|\r)/gm, ' ').trim().replace(/"/g, '""');
                    rowData.push('"' + text + '"');
                });
                rowData.splice(4, 0, '""');

                csv.push(rowData.join(','));
            });
            if (typeof goToPage === 'function') goToPage(1);

            saveAs(new Blob(['\uFEFF' + csv.join('\n')], { type: 'text/csv;charset=utf-8;' }), getDownloadFileName('csv'));
            $("#loader").hide();
            CommonNotification("SUCCESS", "CSV downloaded successfully!", "Success");
        } catch (err) {
            $("#loader").hide();
            console.error('CSV Error:', err);
            CommonNotification("ERROR", "Error downloading CSV", "Error");
        }
    }

    // ==========================================================================
    // PDF DOWNLOAD
    // ==========================================================================
    function fnDownloadPDF() {
        if (selectedViewType !== 'Table') { alert('Please switch to Table view to download'); return; }
        var table = document.querySelector('#divAlertDetailReport table');
        if (!table) { alert('No data available to download'); return; }

        try {
            $("#loader").show();

            var { jsPDF } = window.jspdf;
            var doc = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });
            var pageW = doc.internal.pageSize.getWidth();

            var tableBody = [];
            var rowIndex = 0;

            $('#tblAssetDetail tbody tr').show();
            table.querySelectorAll('tbody tr').forEach(function (tr) {
                if (tr.querySelector('td[colspan]')) return;
                rowIndex++;
                var row = [];
                tr.querySelectorAll('td').forEach(function (td) {
                    row.push(td.innerText.replace(/(\r\n|\n|\r)/gm, ' ').trim());
                });
                row.splice(4, 0, '');
                tableBody.push(row);
            });
            if (typeof goToPage === 'function') goToPage(1);

            if (tableBody.length === 0) {
                $("#loader").hide();
                alert('No data available to download');
                return;
            }

            var metaText = 'Generated: ' + (function () {
                var now = new Date();
                return String(now.getDate()).padStart(2, '0') + '/' +
                    String(now.getMonth() + 1).padStart(2, '0') + '/' +
                    now.getFullYear() + '  ' +
                    String(now.getHours()).padStart(2, '0') + ':' +
                    String(now.getMinutes()).padStart(2, '0') + ':' +
                    String(now.getSeconds()).padStart(2, '0');
            })() + '   |   Total Records: ' + rowIndex;

            var headers = [
                'Sr.No', 'Zone', 'Division', 'Station', 'Vendor Name',
                'Asset Type', 'Make of Asset', 'Count'
            ];

            doc.autoTable({
                startY: 58,
                head: [headers],
                body: tableBody,
                theme: 'grid',
                tableWidth: 'auto',
                styles: {
                    fontSize: 8,
                    cellPadding: 4,
                    valign: 'middle',
                    halign: 'center',
                    lineColor: [226, 232, 240],
                    lineWidth: 0.4,
                    overflow: 'linebreak'
                },
                headStyles: {
                    fillColor: [30, 58, 95],
                    textColor: [255, 255, 255],
                    fontStyle: 'bold',
                    fontSize: 8,
                    halign: 'center',
                    valign: 'middle',
                    minCellHeight: 28,
                    cellPadding: { top: 5, bottom: 5, left: 3, right: 3 }
                },
                alternateRowStyles: {
                    fillColor: [241, 245, 249]
                },
                bodyStyles: {
                    textColor: [51, 51, 51]
                },
                columnStyles: {
                    0: { cellWidth: 'auto' },
                    1: { cellWidth: 'auto' },
                    2: { cellWidth: 'auto' },
                    3: { cellWidth: 'auto' },
                    4: { cellWidth: 'auto' },
                    5: { cellWidth: 'auto' },
                    6: { cellWidth: 'auto' },
                    7: { cellWidth: 'auto' }
                },
                margin: { top: 58, left: 14, right: 14 },
                didParseCell: function (data) {
                    if (data.section === 'body' && data.column.index === 7) {
                        data.cell.styles.fontStyle = 'bold';
                        data.cell.styles.textColor = [30, 58, 95];
                    }
                },
                didDrawPage: function (data) {
                    doc.setFillColor(79, 70, 229);
                    doc.rect(0, 0, pageW, 36, 'F');
                    doc.setFont('helvetica', 'bold');
                    doc.setFontSize(15);
                    doc.setTextColor(255, 255, 255);
                    doc.text('Asset Detail Report', pageW / 2, 23, { align: 'center' });

                    doc.setFillColor(240, 244, 255);
                    doc.rect(0, 36, pageW, 18, 'F');
                    doc.setFont('helvetica', 'italic');
                    doc.setFontSize(8);
                    doc.setTextColor(71, 85, 105);
                    doc.text(metaText, pageW / 2, 47, { align: 'center' });

                    var pageNum = doc.internal.getCurrentPageInfo().pageNumber;
                    var totalPg = doc.internal.getNumberOfPages();
                    doc.setFont('helvetica', 'normal');
                    doc.setFontSize(7);
                    doc.setTextColor(148, 163, 184);
                    doc.text(
                        'Page ' + pageNum + ' of ' + totalPg,
                        pageW - 14,
                        doc.internal.pageSize.getHeight() - 8,
                        { align: 'right' }
                    );
                }
            });

            doc.save(getDownloadFileName('pdf'));
            $("#loader").hide();
            CommonNotification("SUCCESS", "PDF downloaded successfully!", "Success");

        } catch (err) {
            $("#loader").hide();
            console.error('PDF Error:', err);
            CommonNotification("ERROR", "Error downloading PDF", "Error");
        }
    }

    function getDownloadFileName(ext) {
        var now = new Date();
        return 'AssetDetail_' +
            now.getFullYear() +
            String(now.getMonth() + 1).padStart(2, '0') +
            String(now.getDate()).padStart(2, '0') + '_' +
            String(now.getHours()).padStart(2, '0') +
            String(now.getMinutes()).padStart(2, '0') +
            '.' + ext;
    }
</script>
