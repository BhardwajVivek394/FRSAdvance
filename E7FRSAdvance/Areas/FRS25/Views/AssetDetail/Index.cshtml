                        </div>

                        <div class="row">
                            <div id="divAlertDetailReport" class="col-12"></div>

                            <!-- Chart Container -->
                            <div id="adChartContainer" class="col-12"
                                 style="display:none; padding:10px 15px;"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- Hidden div to hold full data for charts -->
<div id="divChartDataHolder" style="display:none !important;"></div>

<script>
    var openDropdown = null;
    var adChartList = [];
    var selectedViewType = 'Table';
    var _defaultAssetTypeHtml = null;
    var _defaultAssetMakeHtml = null;
    var _adChartData = null;       // Cached chart data (ALL records)
    var _chartDataDirty = true;    // Flag: true = need fresh AJAX for charts

    var adChartColors = [
        '#6366f1', '#8b5cf6', '#a78bfa', '#818cf8', '#6d28d9',
        '#7c3aed', '#5b21b6', '#4f46e5', '#4338ca', '#3730a3',
        '#3b82f6', '#22c55e', '#f59e0b', '#ec4899', '#f43f5e',
        '#14b8a6', '#f97316', '#06b6d4', '#84cc16', '#e11d48'
    ];

    // ======================================================================
    // CENTER TEXT PLUGIN FOR DOUGHNUT CHARTS
    // ======================================================================
    var adCenterTextPlugin = {
        id: 'adCenterText',
        afterDraw: function (chart) {
            if (chart.config.type !== 'doughnut') return;
            var opts = (chart.options.plugins && chart.options.plugins.adCenterText)
                ? chart.options.plugins.adCenterText : null;
            if (!opts || !opts.text) return;

            var ctx = chart.ctx;
            var th = adTheme();
            var cx = (chart.chartArea.left + chart.chartArea.right) / 2;
            var cy = (chart.chartArea.top + chart.chartArea.bottom) / 2;

            ctx.save();
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';

            ctx.font = 'bold 26px sans-serif';
            ctx.fillStyle = th.heading;
            ctx.fillText(opts.text, cx, cy - 10);

            ctx.font = '11px sans-serif';
            ctx.fillStyle = th.text3;
            ctx.fillText(opts.label || 'Total Assets', cx, cy + 14);

            ctx.restore();
        }
    };
    Chart.register(adCenterTextPlugin);

    // Energy7 theme palette — Chart.js draws on canvas and cannot read var(), so read the tokens at render time
    function adTheme() {
        var cs = getComputedStyle(document.documentElement);
        var v = function (n, fb) { var x = cs.getPropertyValue(n); return x && x.trim() ? x.trim() : fb; };
        return {
            surface: v('--e7-surface', '#fff'), border: v('--e7-border', '#e7ebf1'),
            grid: v('--e7-grid-line', '#eef2f7'), heading: v('--e7-heading', '#1b3c55'),
            text: v('--e7-text', '#22303f'), text2: v('--e7-text-2', '#55657a'), text3: v('--e7-text-3', '#627186')
        };
    }
    // Redraw the open chart view when the scheme toggles (re-runs the dispatcher with the current view)
    if (window.MutationObserver) {
        new MutationObserver(function () {
            if (selectedViewType && selectedViewType !== 'Table' && $('#adChartContainer').is(':visible') && typeof adRenderView === 'function') {
                adRenderView(selectedViewType);
            }
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-aurora'] });
    }

    $(document).ready(function () {
        _defaultAssetTypeHtml = $('#listAssetType').html();
        _defaultAssetMakeHtml = $('#listAssetMake').html();

        setDefaultDates();

        window._originalItems = {
            division: $('#listDivision').html(),
            site: $('#listSite').html()
        };

        $('.select-btn').on('click', function (e) {
            e.stopPropagation();
            toggleDD($(this).data('target'), this);
        });

        $('#backdrop').on('click', closeDD);

        // Handle dropdown item click
        $(document).on('click', '#ddZone .dropdown-item, #ddDivision .dropdown-item, #ddSite .dropdown-item, #ddAssetType .dropdown-item, #ddAssetMake .dropdown-item', function (e) {
            e.stopPropagation();

            var $item = $(this);
            var $cb = $item.find('input[type="checkbox"]');

            if (!$(e.target).is('input[type="checkbox"]')) {
                $cb.prop('checked', !$cb.prop('checked'));
            }
            $item.toggleClass('checked', $cb.prop('checked'));

            var cbClass = $cb.attr('class') || '';
            var type = cbClass.replace('cb-', '');

            updateSelectAllState(type);
            updateText(type);

            if (type === 'zone') {
                loadDivisionsByZone();
            } else if (type === 'division') {
                loadSitesByDivision();
            }
            else if (type === 'site') {
                loadAssetFilters();
            }
            else if (type === 'assetType') {
                loadAssetMakesByType();
            }
        });

        // Handle Select All header
        $(document).on('click', '.dropdown-header', function (e) {
            e.stopPropagation();
            var $chk = $(this).find('input[type="checkbox"]');
            var type = $chk.attr('id').replace('chkAll', '').charAt(0).toLowerCase()
                + $chk.attr('id').replace('chkAll', '').slice(1);
            if ($(e.target).is('input[type="checkbox"]') || $(e.target).is('label')) {
                setTimeout(function () {
                    selectAll(type, $chk.prop('checked'));
                    if (type === 'assetType') loadAssetMakesByType();
                }, 0);
            } else {
                var newState = !$chk.prop('checked');
                $chk.prop('checked', newState);
                selectAll(type, newState);
                if (type === 'assetType') loadAssetMakesByType();
            }
        });

        // Single select — View Type
        $(document).on('click', '#ddViewType .dropdown-item', function (e) {
            e.stopPropagation();
            $('#ddViewType .dropdown-item').removeClass('selected checked');
            $(this).addClass('selected checked');
            selectedViewType = $(this).data('value');
            $('#txtViewType').text($(this).data('text'));
            closeDD();
            // Re-render if data is already loaded
            if ($('#divAlertDetailReport table').length > 0 ||
                $('#adChartContainer').children().length > 0) {
                adRenderView(selectedViewType);
            }
        });

        $(document).on('click', '.dropdown-search', function (e) { e.stopPropagation(); });
    });

    // ==========================================================================
    // DATE HELPERS
    // ==========================================================================
    function setDefaultDates() {
        var today = new Date();
        var fd = formatDate(today);
        $('#txtFromDate').val(fd);
        $('#txtToDate').val(fd);
    }

    function formatDate(date) {
        var day = String(date.getDate()).padStart(2, '0');
        var month = String(date.getMonth() + 1).padStart(2, '0');
        var year = date.getFullYear();
        return day + '/' + month + '/' + year;
    }

    function formatDateDDMMYYYY(date) {
        var day = String(date.getDate()).padStart(2, '0');
        var month = String(date.getMonth() + 1).padStart(2, '0');
        var year = date.getFullYear();
        var h = date.getHours();
        var mi = String(date.getMinutes()).padStart(2, '0');
        var ss = String(date.getSeconds()).padStart(2, '0');
        var ampm = h >= 12 ? 'PM' : 'AM';
        h = h % 12; h = h ? h : 12;
        return day + '/' + month + '/' + year + ' ';
    }

    function ensureddmmyyyy(dateStr) {
        if (!dateStr) return '';
        var parts = dateStr.split('/');
        if (parts.length === 3) {
            var d = parts[0], m = parts[1], y = parts[2];
            if (y.length === 2) y = '20' + y;
            return String(d).padStart(2, '0') + '/' + String(m).padStart(2, '0') + '/' + y;
        }
        return dateStr;
    }

    // ==========================================================================
    // DROPDOWN HELPERS
    // ==========================================================================
    function filterDropdown(type, searchText) {
        var $dropdown = $('#dd' + capitalize(type));
        var $items = $dropdown.find('.dropdown-list .dropdown-item');
        var $noResults = $dropdown.find('.dropdown-no-results');
        var search = searchText.toLowerCase().trim();
        var visible = 0;

        $items.each(function () {
            var $item = $(this);
            var text = ($item.data('text') || $item.find('span').text()).toLowerCase();
            if (search === '' || text.indexOf(search) > -1) {
                $item.removeClass('hidden');
                visible++;
                if (search !== '') {
                    var orig = $item.data('text') || $item.find('span').text();
                    var regex = new RegExp('(' + escapeRegex(searchText) + ')', 'gi');
                    $item.find('span').html(orig.replace(regex, '<mark>$1</mark>'));
                } else {
                    var origText = $item.data('text');
                    if (origText) $item.find('span').text(origText);
                }
            } else {
                $item.addClass('hidden');
            }
        });

        $noResults.toggleClass('show', visible === 0 && search !== '');
        updateSelectAllState(type);
    }

    function escapeRegex(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

    function toggleDD(id, btn) {
        if (openDropdown === id) { closeDD(); return; }
        closeDD();

        var $dd = $('#' + id);
        $('body').append($dd);

        var rect = btn.getBoundingClientRect();
        $dd.css({ position: 'absolute', visibility: 'hidden', display: 'block', top: '-9999px', left: '-9999px' });

        var ddH = $dd.outerHeight();
        var ddW = $dd.outerWidth();
        var top = rect.bottom + 4;
        var left = rect.left;

        if (top + ddH > window.innerHeight) top = rect.top - ddH - 4;
        if (left + ddW > window.innerWidth) left = window.innerWidth - ddW - 8;

        $dd.css({ visibility: '', display: '', top: top + 'px', left: left + 'px' });
        $dd.addClass('open');
        $(btn).addClass('active');
        $('#backdrop').addClass('show');
        openDropdown = id;

        setTimeout(function () {
            var $s = $dd.find('.dropdown-search input');
            if ($s.length) $s.focus();
        }, 100);
    }

    function closeDD() {
        if (openDropdown) {
            var $dd = $('#' + openDropdown);
            $dd.find('.dropdown-search input').val('');
            $dd.find('.dropdown-item').removeClass('hidden');
            $dd.find('.dropdown-no-results').removeClass('show');
            $dd.find('.dropdown-item').each(function () {
                var origText = $(this).data('text');
                if (origText) $(this).find('span').text(origText);
            });
            $dd.removeClass('open');
            $('.select-btn').removeClass('active');
            $('#backdrop').removeClass('show');

            var ddId = openDropdown;
            var type = ddId.replace('dd', '').toLowerCase();
            if (type === 'assettype') type = 'assetType';
            if (type === 'assetmake') type = 'assetMake';
            updateSelectAllState(type);

            openDropdown = null;
        }
    }

    function onSelectAllClick(type, checked) {
        event.stopPropagation();
        selectAll(type, checked);
        if (type === 'zone') loadDivisionsByZone();
        else if (type === 'division') loadSitesByDivision();
        else if (type === 'site') loadAssetFilters();
    }

    function selectAll(type, checked) {
        $('#list' + capitalize(type) + ' .dropdown-item').each(function () {
            var $item = $(this);
            if (!$item.hasClass('hidden')) {
                var $cb = $item.find('input[type="checkbox"]');
                $cb.prop('checked', checked);
                $item.toggleClass('checked', checked);
            }
        });
        updateText(type);
    }

    function updateSelectAllState(type) {
        var $list = $('#list' + capitalize(type));
        var $all = $list.find('.dropdown-item');
        var total = $all.length;
        var checked = $all.find('.cb-' + type + ':checked').length;
        $('#chkAll' + capitalize(type)).prop('checked', total > 0 && total === checked);
    }

    function updateText(type) {
        var $all = $('.cb-' + type);
        var $checked = $('.cb-' + type + ':checked');
        var count = $checked.length;
        var total = $all.length;
        var text = 'All';
        if (count === 0) text = 'All';
        else if (count === 1) text = $checked.first().closest('.dropdown-item').data('text') || $checked.first().closest('.dropdown-item').find('span').text();
        else if (count === total && total > 0) text = 'All (' + count + ')';
        else text = count + ' selected';
        $('#txt' + capitalize(type)).text(text);
    }

    function getValues(type) {
        var vals = [];
        $('.cb-' + type + ':checked').each(function () { vals.push($(this).val()); });
        return vals;
    }

    function capitalize(str) {
        if (str === 'assetType') return 'AssetType';
        if (str === 'assetMake') return 'AssetMake';
        return str.charAt(0).toUpperCase() + str.slice(1);
    }

    // ==========================================================================
    // CASCADING
    // ==========================================================================
    function loadDivisionsByZone() {
        var zoneIds = getValues('zone').map(Number);
        clearDropdown('division'); clearDropdown('site');
        resetAssetFilters();
        if (zoneIds.length === 0) {
            reloadOriginal('division'); reloadOriginal('site'); return;
        }
        $.ajax({
            url: '/FRS25/AssetDetail/GetDivisionByZoneId',
            type: 'POST', contentType: 'application/json',
            data: JSON.stringify({ SearchCriteria: { ZoneIds: zoneIds } }),
            success: function (data) { rebuildDropdown('division', data); clearDropdown('site'); },
            error: function () { CommonNotification("ERROR", "Failed to load divisions!", "Error"); }
        });
    }

    function loadSitesByDivision() {
        var divIds = getValues('division').map(Number);
        clearDropdown('site');
        resetAssetFilters();
        if (divIds.length === 0) { reloadOriginal('site'); return; }
        $.ajax({
            url: '/FRS25/AssetDetail/GetSiteByDivisionId',
            type: 'POST', contentType: 'application/json',
            data: JSON.stringify({ SearchCriteria: { DivisionIds: divIds } }),
            success: function (data) { rebuildDropdown('site', data); },
            error: function () { CommonNotification("ERROR", "Failed to load sites!", "Error"); }
        });
    }

    // ==========================================================================
    // ASSET FILTER LOADING (Asset Type + Asset Make from Asset/GetDetails API)
    // ==========================================================================
    function resetAssetFilters() {
        $('#listAssetType').html(_defaultAssetTypeHtml);
        $('#chkAllAssetType').prop('checked', false);
        $('#txtAssetType').text('All');

        $('#listAssetMake').html(_defaultAssetMakeHtml);
        $('#chkAllAssetMake').prop('checked', false);
        $('#txtAssetMake').text('All');
    }

    function loadAssetFilters() {
        var siteIds = getValues('site').map(Number);

        // Reset both dropdowns
        resetAssetFilters();

        if (siteIds.length === 0) return;

        // Show loading state
        $('#listAssetType').html('<div class="dropdown-empty">Loading...</div>');
        $('#listAssetMake').html('<div class="dropdown-empty">Loading...</div>');

        var mAssetLister = {
            SearchCriteria: {
                ZoneIds: getValues('zone'),
                DivisionIds: getValues('division'),
                SiteIds: siteIds,
                AssetTypeIds: [],
                siteAttributeDatasList: []
            }
        };

        $.ajax({
            url: '/FRS25/AssetDetail/GetAssetFilters',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            success: function (data) {
                // ── Rebuild Asset Type dropdown ──
                if (data.AssetTypes && data.AssetTypes.length > 0) {
                    var atHtml = '';
                    $.each(data.AssetTypes, function (i, item) {
                        var name = item.Name || '';
                        atHtml += '<div class="dropdown-item" data-value="' + name +
                            '" data-text="' + name + '">' +
                            '<input type="checkbox" class="cb-assetType" value="' + name + '">' +
                            '<span>' + name + '</span></div>';
                    });
                    $('#listAssetType').html(atHtml);
                } else {
                    $('#listAssetType').html('<div class="dropdown-empty">No asset types found</div>');
                }

                // ── Rebuild Asset Make dropdown ──
                if (data.AssetMakes && data.AssetMakes.length > 0) {
                    var amHtml = '';
                    $.each(data.AssetMakes, function (i, make) {
                        amHtml += '<div class="dropdown-item" data-value="' + make +
                            '" data-text="' + make + '">' +
                            '<input type="checkbox" class="cb-assetMake" value="' + make + '">' +
                            '<span>' + make + '</span></div>';
                    });
                    $('#listAssetMake').html(amHtml);
                } else {
                    $('#listAssetMake').html('<div class="dropdown-empty">No asset makes found</div>');
                }
            },
            error: function () {
                // Fallback to defaults
                $('#listAssetType').html(_defaultAssetTypeHtml);
                $('#listAssetMake').html(_defaultAssetMakeHtml);
            }
        });
    }

    // Asset Type select -> call GetAssetFilters with selected types -> rebuild Asset Make only
    var _assetMakeXhr = null;
    function loadAssetMakesByType() {
        var siteIds = getValues('site').map(Number);
        if (siteIds.length === 0) return;

        var selectedTypes = getValues('assetType');
        var prevChecked = getValues('assetMake');

        // cancel previous pending request (fast clicking)
        if (_assetMakeXhr) { _assetMakeXhr.abort(); }

        $('#listAssetMake').html('<div class="dropdown-empty">Loading...</div>');
        $('#chkAllAssetMake').prop('checked', false);
        $('#txtAssetMake').text('All');

        var mAssetLister = {
            SearchCriteria: {
                ZoneIds: getValues('zone'),
                DivisionIds: getValues('division'),
                SiteIds: siteIds,
                AssetTypes: selectedTypes,
                siteAttributeDatasList: []
            }
        };

        _assetMakeXhr = $.ajax({
            url: '/FRS25/AssetDetail/GetAssetFilters',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            success: function (data) {
                if (data.AssetMakes && data.AssetMakes.length > 0) {
                    var amHtml = '';
                    $.each(data.AssetMakes, function (i, make) {
                        var isChecked = prevChecked.indexOf(make) > -1;
                        amHtml += '<div class="dropdown-item' + (isChecked ? ' checked' : '') +
                            '" data-value="' + make + '" data-text="' + make + '">' +
                            '<input type="checkbox" class="cb-assetMake" value="' + make + '"' +
                            (isChecked ? ' checked' : '') + '>' +
                            '<span>' + make + '</span></div>';
                    });
                    $('#listAssetMake').html(amHtml);
                } else {
                    $('#listAssetMake').html('<div class="dropdown-empty">No asset makes found</div>');
                }
                updateSelectAllState('assetMake');
                updateText('assetMake');
            },
            error: function (xhr, status) {
                if (status === 'abort') return;
                $('#listAssetMake').html(_defaultAssetMakeHtml);
            },
            complete: function () { _assetMakeXhr = null; }
        });
    }

    function clearDropdown(type) {
        $('#list' + capitalize(type)).empty();
        $('#chkAll' + capitalize(type)).prop('checked', false);
        $('#txt' + capitalize(type)).text('All');
    }

    function rebuildDropdown(type, items) {
        var $list = $('#list' + capitalize(type));
        $list.empty();
        $.each(items, function (i, item) {
            var val = item.Id || item.id;
            var name = item.Name || item.name;
            $list.append(
                '<div class="dropdown-item" data-value="' + val + '" data-text="' + name + '">' +
                '<input type="checkbox" class="cb-' + type + '" value="' + val + '">' +
                '<span>' + name + '</span></div>'
            );
        });
        $('#chkAll' + capitalize(type)).prop('checked', false);
        $('#txt' + capitalize(type)).text('All');
    }

    function reloadOriginal(type) {
        if (window._originalItems && window._originalItems[type]) {
            var $list = $('#list' + capitalize(type));
            $list.html(window._originalItems[type]);
            $list.find('input[type="checkbox"]').prop('checked', false);
            $list.find('.dropdown-item').removeClass('checked');
            $('#chkAll' + capitalize(type)).prop('checked', false);
            $('#txt' + capitalize(type)).text('All');
        }
    }

    // ==========================================================================
    // SEARCH — marks chart cache as dirty
    // ==========================================================================
    function fnSearch() {
        _chartDataDirty = true;
        _adChartData = null;
        fnLoadData();
    }

    function fnGetAssetDetailReport() { fnSearch(); }

    function fnLoadData() {
        var mAssetLister = { SearchCriteria: {} };
        mAssetLister.SearchCriteria.ZoneIds = getValues('zone');
        mAssetLister.SearchCriteria.DivisionIds = getValues('division');
        mAssetLister.SearchCriteria.SiteIds = getValues('site');
        mAssetLister.SearchCriteria.AssetTypes = getValues('assetType');
        mAssetLister.SearchCriteria.siteAttributeDatasList = getValues('assetMake');

        if (!mAssetLister.SearchCriteria.SiteIds.length) { alert('Station is required'); return; }

        adDestroyAllCharts();

        $('#divAlertDetailReport').html(
            '<div class="text-center p-5">' +
            '<i class="fas fa-spinner fa-spin fa-2x text-primary"></i>' +
            '<br/><small class="text-muted mt-2">Loading data...</small></div>'
        );

        $.ajax({
            url: '/FRS25/AssetDetail/_Details',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            dataType: 'html',
            success: function (data) {
                $("#divAlertDetailReport").empty().append(data);
                $("#lblcurrentDate").text("As on " + " " + formatDateDDMMYYYY(new Date()));
                adRenderView(selectedViewType);
            },
            error: function () {
                CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    // ==========================================================================
    // DESTROY ALL CHARTS
    // ==========================================================================
    function adDestroyAllCharts() {
        adChartList.forEach(function (c) { if (c) c.destroy(); });
        adChartList = [];
    }

    // ==========================================================================
    // EXTRACT DATA FROM A TABLE ELEMENT
    // $container = jQuery element that contains the table
    // Columns: 0=Sr.No 1=Zone 2=Division 3=Station
    //          4=AssetType 5=AssetMake 6=CountOfAsset
    // ==========================================================================
    function extractAdDataFromElement($container) {
        var data = {
            rows: [],
            makeGroups: {},
            assetTypeGroups: {},
            stationGroups: {},
            stationOnlyGroups: {},
            totalCount: 0
        };

        $container.find('table tbody tr').each(function () {
            var $tds = $(this).find('td');
            if ($tds.length < 7) return;
            if ($(this).find('td[colspan]').length > 0) return;

            var zone = $.trim($tds.eq(1).text());
            var division = $.trim($tds.eq(2).text());
            var station = $.trim($tds.eq(3).text());
            var assetType = $.trim($tds.eq(4).text());
            var assetMake = $.trim($tds.eq(5).text());
            var count = parseInt($.trim($tds.eq(6).text())) || 0;

            data.rows.push({
                zone: zone, division: division, station: station,
                assetType: assetType, assetMake: assetMake, count: count
            });

            // Group by Asset Make
            if (!data.makeGroups[assetMake]) data.makeGroups[assetMake] = 0;
            data.makeGroups[assetMake] += count;

            // Group by Asset Type
            if (!data.assetTypeGroups[assetType]) data.assetTypeGroups[assetType] = 0;
            data.assetTypeGroups[assetType] += count;

            // Group by Station + AssetType
            var stKey = station + ' (' + assetType + ')';
            if (!data.stationGroups[stKey]) data.stationGroups[stKey] = 0;
            data.stationGroups[stKey] += count;

            // Group by Station only
            if (!data.stationOnlyGroups[station]) data.stationOnlyGroups[station] = 0;
            data.stationOnlyGroups[station] += count;

            data.totalCount += count;
        });

        return data;
    }

    // Shortcut: extract from the visible report div
    function extractAdData() {
        return extractAdDataFromElement($('#divAlertDetailReport'));
    }

    // ==========================================================================
    // CHART HELPERS
    // ==========================================================================
    function adHexToRgba(hex, alpha) {
        hex = hex.replace('#', '');
        return 'rgba(' +
            parseInt(hex.substring(0, 2), 16) + ',' +
            parseInt(hex.substring(2, 4), 16) + ',' +
            parseInt(hex.substring(4, 6), 16) + ',' + alpha + ')';
    }

    function adNoData() {
        $('#adChartContainer').html(
            '<div class="no-data-container">' +
            '<i class="fas fa-chart-pie"></i>' +
            '<p>No data available for visualization.</p>' +
            '<p class="mt-2" style="font-size:12px;color:var(--e7-text-4,#cbd5e1);">Try adjusting your search filters</p>' +
            '</div>'
        );
    }

    // Creates a titled chart box, returns canvas 2D context
    function adCreateBox(title, subtitle, typeBadge, height, canvasId) {
        var $box = $('<div></div>').css({
            padding: '20px', background: 'var(--e7-surface, #fff)', borderRadius: '12px',
            boxShadow: 'var(--e7-shadow-card, 0 2px 14px rgba(0,0,0,0.07))', marginBottom: '16px'
        });

        $box.append(
            '<div class="chart-title-section">' +
            '<div><h3 class="chart-title">' + title + '</h3>' +
            (subtitle ? '<p class="chart-subtitle">' + subtitle + '</p>' : '') +
            '</div><span class="chart-type-badge">' + typeBadge + '</span></div>'
        );

        var $wrap = $('<div class="ad-chart-wrapper" style="position:relative;height:' + height + 'px;"></div>');
        var $canvas = $('<canvas id="' + canvasId + '"></canvas>');
        $wrap.append($canvas);
        $box.append($wrap);
        $('#adChartContainer').append($box);
        return $canvas[0].getContext('2d');
    }

    // Builds the summary cards row HTML
    function adSummaryHtml(data) {
        var makeKeys = Object.keys(data.makeGroups);
        var stationKeys = Object.keys(data.stationOnlyGroups);
        var topMake = makeKeys.reduce(function (a, b) {
            return data.makeGroups[a] >= data.makeGroups[b] ? a : b;
        }, makeKeys[0] || '—');
        var topCount = topMake !== '—' ? data.makeGroups[topMake] : 0;

        return '<div class="chart-summary-row">' +
            '<div class="summary-card total-assets"><div class="card-icon"><i class="fa fa-cubes"></i></div>' +
            '<div class="card-value">' + data.totalCount.toLocaleString() + '</div>' +
            '<div class="card-label">Total Assets</div></div>' +

            '<div class="summary-card total-makes"><div class="card-icon"><i class="fa fa-industry"></i></div>' +
            '<div class="card-value">' + makeKeys.length + '</div>' +
            '<div class="card-label">Unique Makes</div></div>' +

            '<div class="summary-card top-make"><div class="card-icon"><i class="fa fa-trophy"></i></div>' +
            '<div class="card-value">' + topMake + '</div>' +
            '<div class="card-label">Top Make (' + topCount + ')</div></div>' +

            '<div class="summary-card avg-count"><div class="card-icon"><i class="fa fa-map-marker-alt"></i></div>' +
            '<div class="card-value">' + stationKeys.length + '</div>' +
            '<div class="card-label">Total Stations</div></div>' +
            '</div>';
    }

    // Builds the data summary table below a chart
    function adDataTableHtml(labels, values, total, unit) {
        unit = unit || '';
        var sorted = labels.map(function (l, i) {
            return { label: l, value: values[i], pct: total > 0 ? ((values[i] / total) * 100).toFixed(1) : '0.0', color: adChartColors[i % adChartColors.length] };
        }).sort(function (a, b) { return b.value - a.value; });

        var rows = '';
        sorted.forEach(function (item, idx) {
            var rankClass = idx === 0 ? 'gold' : idx === 1 ? 'silver' : idx === 2 ? 'bronze' : 'normal';
            rows += '<tr>' +
                '<td><span class="rank-badge ' + rankClass + '">' + (idx + 1) + '</span></td>' +
                '<td><span class="color-indicator" style="background:' + item.color + ';"></span>' + item.label + '</td>' +
                '<td><strong>' + item.value.toLocaleString() + '</strong>' + (unit ? ' ' + unit : '') + '</td>' +
                '<td>' + item.pct + '%</td>' +
                '<td><div class="percentage-bar"><div class="percentage-bar-fill" style="width:' + item.pct + '%;background:' + item.color + ';"></div></div></td>' +
                '</tr>';
        });

        return '<div class="chart-data-table"><table>' +
            '<thead><tr><th style="width:50px;">#</th><th>Label</th>' +
            '<th style="width:80px;">Count</th><th style="width:90px;">Share</th>' +
            '<th style="width:180px;">Distribution</th></tr></thead>' +
            '<tbody>' + rows + '</tbody></table></div>';
    }

    // ==========================================================================
    // BUILD SEARCH CRITERIA (reusable)
    // ==========================================================================
    function buildSearchCriteria() {
        return {
            ZoneIds: getValues('zone'),
            DivisionIds: getValues('division'),
            SiteIds: getValues('site'),
            AssetTypes: getValues('assetType'),
            siteAttributeDatasList: getValues('assetMake')
        };
    }

    // ==========================================================================
    // MAIN DISPATCHER
    // For chart views: loads ALL records via AJAX (PageSize=100000),
    // parses the returned HTML in a hidden div, then renders charts.
    // ==========================================================================
    function adRenderView(view) {
        adDestroyAllCharts();

        // ── TABLE VIEW ─────────────────────────────────────────────────────
        if (!view || view === 'Table') {
            $('#divAlertDetailReport').show();
            $('#adChartContainer').hide().empty();
            return;
        }

        // ── CHART VIEW ─────────────────────────────────────────────────────
        $('#divAlertDetailReport').hide();
        $('#adChartContainer').show().empty();

        // If we already have cached chart data (same search), use it
        if (!_chartDataDirty && _adChartData && _adChartData.rows.length > 0) {
            adBuildCharts(view, _adChartData);
            return;
        }

        // Show loading spinner in chart area
        $('#adChartContainer').html(
            '<div class="text-center p-5">' +
            '<i class="fas fa-spinner fa-spin fa-2x text-primary"></i>' +
            '<br/><small class="text-muted mt-2">Loading chart data...</small></div>'
        );

        // Load ALL data for charts
        var mAssetLister = {
            SearchCriteria: buildSearchCriteria()
        };

        if (!mAssetLister.SearchCriteria.SiteIds.length) { alert('Station is required'); return; }

        $.ajax({
            url: '/FRS25/AssetDetail/_Details',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(mAssetLister),
            dataType: 'html',
            success: function (html) {
                // Parse the returned HTML in a hidden holder
                var $holder = $('#divChartDataHolder');
                $holder.html(html);

                // Extract data from the full (unpaginated) table
                var data = extractAdDataFromElement($holder);

                console.log('Chart data loaded — rows:', data.rows.length,
                    '| stations:', Object.keys(data.stationOnlyGroups).length,
                    '| makes:', Object.keys(data.makeGroups).length,
                    '| types:', Object.keys(data.assetTypeGroups).length);

                // Cache it
                _adChartData = data;
                _chartDataDirty = false;

                // Clear holder
                $holder.empty();

                // Render
                $('#adChartContainer').empty();
                adBuildCharts(view, data);
            },
            error: function () {
                // Fallback: use whatever is in the visible table (paginated)
                console.warn('Chart AJAX failed, falling back to paginated table data');
                var data = extractAdData();
                $('#adChartContainer').empty();
                adBuildCharts(view, data);
            }
        });
    }

    // Central chart builder — called after data is ready
    function adBuildCharts(view, data) {
        if (!data || data.rows.length === 0) { adNoData(); return; }

        // Inject summary cards
        $('#adChartContainer').append(adSummaryHtml(data));

        if (view === 'Bar') adRenderBar(data);
        else if (view === 'Pie') adRenderPie(data);
        else if (view === 'Graph') adRenderGraph(data);
    }

    // ==========================================================================
    // BAR CHART
    // Chart 1 — Count per Asset Make
    // Chart 2 — Count per Asset Type
    // Chart 3 — Count per Station
    // ==========================================================================
    function adRenderBar(data) {
        var stationKeys = Object.keys(data.stationOnlyGroups);
        if (stationKeys.length === 0) { adNoData(); return; }
        var th = adTheme();

        Chart.register(ChartDataLabels);

        // Build station → make → count AND station → type → count
        var stationMakeMap = {};
        var stationTypeMap = {};
        data.rows.forEach(function (r) {
            if (!stationMakeMap[r.station]) stationMakeMap[r.station] = {};
            if (!stationMakeMap[r.station][r.assetMake]) stationMakeMap[r.station][r.assetMake] = 0;
            stationMakeMap[r.station][r.assetMake] += r.count;

            if (!stationTypeMap[r.station]) stationTypeMap[r.station] = {};
            if (!stationTypeMap[r.station][r.assetType]) stationTypeMap[r.station][r.assetType] = 0;
            stationTypeMap[r.station][r.assetType] += r.count;
        });

        function buildStationBar(station, groupMap, groupLabel, canvasId) {
            var labels = Object.keys(groupMap);
            var values = labels.map(function (m) { return groupMap[m]; });
            var total = values.reduce(function (a, b) { return a + b; }, 0);
            if (total === 0) return;

            var colors = labels.map(function (_, i) { return adChartColors[i % adChartColors.length]; });
            var thick = labels.length > 12 ? 'flex' : 36;

            var ctx = adCreateBox(station + ' — ' + groupLabel,
                groupLabel + ' distribution — Total: ' + total,
                'Bar Chart', Math.max(280, labels.length * 40), canvasId);

            var c = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Asset Count',
                        data: values,
                        backgroundColor: colors.map(function (c) { return c + 'cc'; }),
                        borderColor: colors,
                        borderWidth: 1,
                        borderRadius: 5,
                        barThickness: thick
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        datalabels: {
                            anchor: 'end', align: 'end', color: th.text2,
                            font: { weight: '600', size: 11 },
                            display: function (ctx) { return ctx.dataset.data[ctx.dataIndex] > 0; }
                        },
                        tooltip: {
                            backgroundColor: th.surface, titleColor: th.heading, bodyColor: th.text, borderColor: th.border, borderWidth: 1, padding: 12, cornerRadius: 8,
                            callbacks: { label: function (c) { return ' ' + c.label + ': ' + c.parsed.y; } }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 11 }, maxRotation: 40, minRotation: 20, autoSkip: false, color: th.text2 }
                        },
                        y: {
                            beginAtZero: true, grid: { color: th.grid },
                            ticks: { font: { size: 11 }, stepSize: 1, color: th.text3 }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });
            adChartList.push(c);
            $('#adChartContainer').append(adDataTableHtml(labels, values, total));
        }

        stationKeys.forEach(function (station, sIdx) {
            // Asset Make bar
            if (stationMakeMap[station]) {
                buildStationBar(station, stationMakeMap[station], 'Asset Make', 'adBarMake_' + sIdx);
            }
            // Asset Type bar
            if (stationTypeMap[station]) {
                buildStationBar(station, stationTypeMap[station], 'Asset Type', 'adBarType_' + sIdx);
            }
        });
    }

    // ==========================================================================
    // PIE / DOUGHNUT CHART
    // Doughnut 1 — Count per Asset Make   (center = total)
    // Doughnut 2 — Count per Asset Type   (center = total)
    // Doughnut 3 — Count per Station      (center = total)
    // ==========================================================================
    function adRenderPie(data) {
        var stationKeys = Object.keys(data.stationOnlyGroups);
        if (stationKeys.length === 0) { adNoData(); return; }
        var th = adTheme();

        Chart.register(ChartDataLabels);

        // Build station → make → count AND station → type → count
        var stationMakeMap = {};
        var stationTypeMap = {};
        data.rows.forEach(function (r) {
            if (!stationMakeMap[r.station]) stationMakeMap[r.station] = {};
            if (!stationMakeMap[r.station][r.assetMake]) stationMakeMap[r.station][r.assetMake] = 0;
            stationMakeMap[r.station][r.assetMake] += r.count;

            if (!stationTypeMap[r.station]) stationTypeMap[r.station] = {};
            if (!stationTypeMap[r.station][r.assetType]) stationTypeMap[r.station][r.assetType] = 0;
            stationTypeMap[r.station][r.assetType] += r.count;
        });

        function buildStationDoughnut(station, groupMap, groupLabel, canvasId) {
            var labels = Object.keys(groupMap);
            var values = labels.map(function (m) { return groupMap[m]; });
            var total = values.reduce(function (a, b) { return a + b; }, 0);
            if (total === 0) return;

            var colors = labels.map(function (_, i) { return adChartColors[i % adChartColors.length]; });

            var ctx = adCreateBox(station + ' — ' + groupLabel,
                groupLabel + ' distribution — Total: ' + total,
                'Doughnut', 360, canvasId);

            var c = new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: labels,
                    datasets: [{
                        data: values,
                        backgroundColor: colors,
                        borderColor: th.surface, borderWidth: 2, hoverOffset: 8
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false, cutout: '68%',
                    plugins: {
                        adCenterText: {
                            text: total.toLocaleString(),
                            label: 'Total Assets'
                        },
                        legend: {
                            position: labels.length > 10 ? 'bottom' : 'right',
                            labels: { padding: 14, usePointStyle: true, font: { size: 12 }, color: th.text2 }
                        },
                        datalabels: {
                            color: '#fff', font: { weight: '600', size: 11 },
                            formatter: function (value) {
                                var pct = ((value / total) * 100).toFixed(0);
                                return pct > 5 ? pct + '%' : '';
                            }
                        },
                        tooltip: {
                            backgroundColor: th.surface, titleColor: th.heading, bodyColor: th.text, borderColor: th.border, borderWidth: 1, padding: 12, cornerRadius: 8,
                            callbacks: {
                                label: function (c) {
                                    var pct = total > 0 ? ((c.parsed / total) * 100).toFixed(1) : '0.0';
                                    return ' ' + c.label + ': ' + c.parsed + ' (' + pct + '%)';
                                }
                            }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });
            adChartList.push(c);
            $('#adChartContainer').append(adDataTableHtml(labels, values, total));
        }

        stationKeys.forEach(function (station, sIdx) {
            // Asset Make doughnut
            if (stationMakeMap[station]) {
                buildStationDoughnut(station, stationMakeMap[station], 'Asset Make', 'adPieMake_' + sIdx);
            }
            // Asset Type doughnut
            if (stationTypeMap[station]) {
                buildStationDoughnut(station, stationTypeMap[station], 'Asset Type', 'adPieType_' + sIdx);
            }
        });
    }

    // ==========================================================================
    // LINE GRAPH
    // Graph 1 — Count per Asset Make
    // Graph 2 — Count per Asset Type
    // Graph 3 — Count per Station
