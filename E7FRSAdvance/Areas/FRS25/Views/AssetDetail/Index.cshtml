    function asDrDrawChart() {
        asEnsureChart(function () {
            if (asDrChartObj) { try { asDrChartObj.destroy(); } catch (e) { } asDrChartObj = null; }
            var pts = asDrPts.slice().sort(function (a, b) { return b.value - a.value; }).slice(0, 20);
            var $msg = $('#asDrChartMsg');
            if (!window.Chart || !pts.length) { $msg.text(pts.length ? 'Chart unavailable.' : 'No operation data in this range.').css('display', 'flex'); return; }
            $msg.hide();
            var cs = getComputedStyle(document.documentElement), v = function (n, fb) { var x = cs.getPropertyValue(n); return x && x.trim() ? x.trim() : fb; };
            asDrChartObj = new Chart(document.getElementById('asDrChart'), {
                type: 'bar',
                data: { labels: pts.map(function (p) { return p.name; }), datasets: [{ data: pts.map(function (p) { return Math.round(p.value * 100) / 100; }), backgroundColor: pts.map(function (p) { return p.signal ? v('--e7-amber', '#f59e0b') : v('--e7-accent', '#2563eb'); }), borderRadius: 4, maxBarThickness: 40 }] },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: function (c) { return ' ' + c.formattedValue + (pts[c.dataIndex].signal ? ' hrs' : ' operations'); } } } },
                    scales: { y: { beginAtZero: true, grid: { color: v('--e7-grid-line', '#eef2f7') }, ticks: { color: v('--e7-text-3', '#64748b'), precision: 0 } }, x: { grid: { display: false }, ticks: { color: v('--e7-text-3', '#64748b'), autoSkip: true, maxRotation: 45 } } } }
            });
        });
    }
    function asDrToggleFull() {
        var g = asGroupIdx[asDrKey]; if (!g) return;
        asDrFullOpen = !asDrFullOpen;
        if (!asDrFullOpen) { $('#asDrFull').hide().empty(); $('#asDrFullBtn').html('<i class="fas fa-table"></i> Show full utilization table'); return; }
        $('#asDrFullBtn').html('<i class="fas fa-table"></i> Hide full utilization table');
        asDrShowFull(g);
    }
    function asDrShowFull(g) {
        if (!g._drHtml) { $('#asDrFull').show().html('<div class="asx-dr-msg"><i class="fas fa-spinner fa-spin"></i> Loading…</div>'); return; }
        // inject WITH scripts so the partial's pagination + relay popup work; its range bar / download are hidden by CSS
        $('#asDrFull').show().html(g._drHtml);
    }

    // =====================================================================
    //  WIRE-UP
    // =====================================================================
    $(document).ready(function () {
        _asOrigDivision = $('#listDivision').html(); _asOrigSite = $('#listSite').html();
        try { var sv = localStorage.getItem('asView'); if (sv === 'rank' || sv === 'cards' || sv === 'table') asView = sv; } catch (e) { }
        if ($.fn.datepicker) $('#asDrFrom, #asDrTo').datepicker({ dateFormat: 'dd/mm/yyyy', autoClose: true });

        $('.select-btn').on('click', function (e) { e.stopPropagation(); asToggleDD($(this).data('target'), this); });
        $('#backdrop').on('click', asCloseDD);
        $(document).on('click', '.dropdown-search', function (e) { e.stopPropagation(); });
        $(document).on('click', '#ddZone .dropdown-item, #ddDivision .dropdown-item, #ddSite .dropdown-item, #ddAssetType .dropdown-item, #ddAssetMake .dropdown-item, #ddAssetNumber .dropdown-item', function (e) {
            e.stopPropagation();
            var $cb = $(this).find('input[type="checkbox"]');
            if (!$(e.target).is('input[type="checkbox"]')) $cb.prop('checked', !$cb.prop('checked'));
            $(this).toggleClass('checked', $cb.prop('checked'));
            var type = ($cb.attr('class') || '').replace('cb-', '');
            asUpdateAllState(type); asUpdateText(type);
            if (type === 'zone') asLoadDivisions(); else if (type === 'division') asLoadSites(); else if (type === 'site') asLoadAssetTypes(); else if (type === 'assetType') { asLoadMakes(); asLoadAssetNumbers(); }
        });
        $(document).on('click', '.dropdown-header', function (e) {
            e.stopPropagation();
            var $chk = $(this).find('input[type="checkbox"]'), raw = $chk.attr('id').replace('chkAll', ''), type = raw.charAt(0).toLowerCase() + raw.slice(1);
            var apply = function (st) { asSelectAll(type, st); if (type === 'zone') asLoadDivisions(); else if (type === 'division') asLoadSites(); else if (type === 'site') asLoadAssetTypes(); else if (type === 'assetType') { asLoadMakes(); asLoadAssetNumbers(); } };
            if ($(e.target).is('input[type="checkbox"]') || $(e.target).is('label')) setTimeout(function () { apply($chk.prop('checked')); }, 0); else { var ns = !$chk.prop('checked'); $chk.prop('checked', ns); apply(ns); }
        });

        $('#asViewToggle').on('click', 'button', function () { asSetView($(this).data('view')); });
        $('#asRankSort').on('click', 'button', function () { asRankSortKey = $(this).data('sort'); $('#asRankSort button').removeClass('active'); $(this).addClass('active'); asRenderRank(); asRenderCards(); asRenderTable(); });
        $('#asRangeChips').on('click', 'button', function () { asDays = parseInt($(this).data('days')); $('#asRangeChips button').removeClass('active'); $(this).addClass('active'); asRefreshUtil(); });
        $('#asTablePager').on('click', 'a', function (e) { e.preventDefault(); var p = parseInt($(this).data('p')); if (p >= 1 && !$(this).parent().hasClass('disabled')) { asTablePage = p; asRenderTable(); } });

        // open drawer from any view
        $(document).on('click', '#asRankList .asx-rank-row, #asCards .asx-card, #asTableBody tr[data-key]', function () { asOpenDrawer($(this).data('key')); });
        $('#asDrChips').on('click', 'button', function () { asDrDays = parseInt($(this).data('days')); $('#asDrChips button').removeClass('active'); $(this).addClass('active'); var r = asRange(asDrDays); $('#asDrFrom').val(r.from); $('#asDrTo').val(r.to); asDrSearch(false); });

        $(document).on('keydown', function (e) { if (e.key === 'Escape') { asCloseDD(); asCloseDrawer(); } });
        if (window.MutationObserver) new MutationObserver(function () { if ($('#asDrawer').hasClass('is-open')) asDrDrawChart(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-aurora'] });
    });
</script>
