                        borderColor: color,
                        backgroundColor: adHexToRgba(color, 0.06),
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.4,
                        pointRadius: thinPoints ? 0 : 5,
                        pointBackgroundColor: th.surface,
                        pointBorderColor: color,
                        pointBorderWidth: 2,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
