@{
    ViewBag.Title = "Equipment Room";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}
@*
    ==========================================================================
    EQUIPMENT ROOM — UNIFIED (LIVE + HISTORY)
    Replaces the separate "Equipment Room Live" (Index) and
    "Equipment Room History" (History) screens with one page.

    Uses the SAME controller endpoints as before — no backend change needed:
      POST /FRS25/EquipmentRoom/_List               -> live partial (_List.cshtml, redesigned)
      POST /FRS25/EquipmentRoom/_HistoryList        -> history partial (_HistoryList.cshtml, unchanged)
      POST /FRS25/EquipmentRoom/GetDivisionByZoneId
      POST /FRS25/EquipmentRoom/GetSiteByDivisionId
      GET  /FRS25/EquipmentRoom/GetEquipmentRoom?siteId=
    ViewBag needed: Zones, Divisions, Sites (same as the old Index/History actions).
    ==========================================================================
*@

<style>
    /* ======================================================================
       STYLES CARRIED OVER FROM History.cshtml
       (_HistoryList.cshtml depends on these: charts, pagers, view dropdown,
       time picker, download menu)
       ====================================================================== */
    @@keyframes progressShrink {
        from {
            width: 100%;
        }

        to {
            width: 0%;
        }
    }

    /* ===== 24-HOUR TIME INPUT WITH CUSTOM PICKER ===== */
    .time-24-wrapper {
        position: relative;
        display: inline-block;
        width: 100%;
    }

    input.time-24 {
        font-variant-numeric: tabular-nums;
        font-family: inherit;
        letter-spacing: 0.5px;
        text-align: center;
        padding-right: 30px !important;
        cursor: pointer;
    }

        input.time-24::placeholder {
            color: var(--e7-text-4);
            letter-spacing: 1px;
        }

    .time-24-icon {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--e7-text-3);
        font-size: 13px;
        pointer-events: none;
    }

    .time-picker-popup {
        position: absolute;
        background: var(--e7-surface);
        border: 1px solid var(--e7-border-2);
        border-radius: 8px;
        box-shadow: var(--e7-shadow-pop);
        z-index: 99999;
        display: none;
        width: 220px;
        overflow: hidden;
    }

        .time-picker-popup.open {
            display: block;
        }

    .time-picker-header {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
        background: var(--e7-surface-2);
        border-bottom: 1px solid var(--e7-border);
        gap: 4px;
    }

    .time-picker-display {
        font-size: 20px;
        font-weight: 600;
        color: var(--e7-heading);
        font-variant-numeric: tabular-nums;
        letter-spacing: 1px;
    }

    .time-picker-body {
        display: flex;
        height: 200px;
    }

    .time-picker-col {
        flex: 1;
        overflow-y: auto;
        border-right: 1px solid var(--e7-border);
        scroll-behavior: smooth;
    }

        .time-picker-col:last-child {
            border-right: none;
        }

        .time-picker-col::-webkit-scrollbar {
            width: 6px;
        }

        .time-picker-col::-webkit-scrollbar-thumb {
            background: var(--e7-border-2);
            border-radius: 3px;
        }

        .time-picker-col::-webkit-scrollbar-track {
            background: var(--e7-surface-2);
        }

    .time-picker-item {
        padding: 8px 0;
        text-align: center;
        font-size: 14px;
        color: var(--e7-text);
        cursor: pointer;
        font-variant-numeric: tabular-nums;
        transition: background 0.12s;
    }

        .time-picker-item:hover {
            background: var(--e7-accent-soft);
            color: var(--e7-accent-ink);
        }

        .time-picker-item.selected {
            background: var(--e7-accent);
            color: #fff;
            font-weight: 600;
        }

    .time-picker-footer {
        display: flex;
        border-top: 1px solid var(--e7-border);
        background: var(--e7-surface-2);
    }

    .time-picker-btn {
        flex: 1;
        border: none;
        background: transparent;
        padding: 8px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        color: var(--e7-text-3);
        transition: background 0.15s;
    }

        .time-picker-btn:hover {
            background: var(--e7-surface-3);
        }

        .time-picker-btn.primary {
            color: var(--e7-accent-ink);
            font-weight: 600;
        }

            .time-picker-btn.primary:hover {
                background: var(--e7-accent-soft);
            }

    /* ===== FILTER & BUTTON STYLES ===== */
    .btn-search {
        background: linear-gradient(120deg, var(--e7-ask-from), var(--e7-ask-to));
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        color: #fff;
        font-size: 14px;
        font-weight: 500;
        transition: background 0.2s;
    }

        .btn-search:hover {
            background: var(--e7-accent);
        }

    .dropdown-menu.dropdown-menu-right .dropdown-item {
        padding: 10px 15px;
        font-size: 14px;
        display: flex;
        align-items: center;
        background: transparent;
    }

        .dropdown-menu.dropdown-menu-right .dropdown-item:hover {
            background: var(--e7-surface-3);
        }

    #btnDownload + .dropdown-menu {
        min-width: 130px;
        padding: 8px 0;
        border-radius: 8px;
        box-shadow: var(--e7-shadow-pop);
        border: 1px solid var(--e7-border);
    }

    /* ===== HISTORY TABLE ===== */
    .history-table-wrapper {
        max-height: 600px;
        overflow: auto;
        border: 1px solid var(--e7-border);
        border-radius: 8px;
    }

    .history-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .history-table thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background: var(--e7-surface-2);
            color: var(--e7-heading);
            padding: 10px 12px;
            text-align: center;
            font-weight: 600;
            font-size: 12px;
            border: 1px solid var(--e7-border);
            white-space: nowrap;
        }

        .history-table thead tr:first-child th {
            position: sticky;
            top: 0;
            z-index: 12;
        }

        .history-table thead tr:nth-child(2) th {
            position: sticky;
            top: 38px;
            z-index: 11;
        }

        .history-table thead th:first-child {
            position: sticky;
            left: 0;
            z-index: 20;
            background: var(--e7-surface-2);
            min-width: 160px;
        }

        .history-table tbody td {
            padding: 8px 10px;
            text-align: center;
            border: 1px solid var(--e7-border);
            white-space: nowrap;
        }

            .history-table tbody td:first-child {
                position: sticky;
                left: 0;
                z-index: 5;
                background: var(--e7-surface);
                font-weight: 600;
                color: var(--e7-heading);
                text-align: left;
                min-width: 160px;
            }

        .history-table tbody tr:nth-child(even) td {
            background: var(--e7-surface-2);
        }

            .history-table tbody tr:nth-child(even) td:first-child {
                background: var(--e7-surface-2);
            }

        .history-table tbody tr:hover td {
            background: var(--e7-surface-3);
        }

            .history-table tbody tr:hover td:first-child {
                background: var(--e7-surface-3);
            }

    .datetime-input {
        display: flex;
        gap: 6px;
        align-items: center;
    }

        .datetime-input input {
            border: 1px solid var(--e7-border-2);
            border-radius: 6px;
            padding: 6px 10px;
            font-size: 13px;
            height: 38px;
        }

            .datetime-input input:focus {
                border-color: var(--e7-focus);
                outline: none;
                box-shadow: 0 0 0 2px var(--e7-accent-soft);
            }

    /* ===== MULTI-SELECT DROPDOWN STYLES ===== */
    .select-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--e7-surface-2);
        border: 1px solid var(--e7-border-2);
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        color: var(--e7-text);
        cursor: pointer;
        min-width: 170px;
        height: 40px;
    }

        .select-btn:hover {
            border-color: var(--e7-accent);
        }

        .select-btn.active {
            border-color: var(--e7-focus);
            box-shadow: 0 0 0 2px var(--e7-accent-soft);
        }

        .select-btn .text {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: left;
        }

        .select-btn i {
            margin-left: 8px;
            font-size: 12px;
            color: var(--e7-text-3);
        }

    .filter-dropdown {
        position: fixed;
        background: var(--e7-surface);
        border: 1px solid var(--e7-border);
        border-radius: 8px;
        box-shadow: var(--e7-shadow-pop);
        min-width: 260px;
        max-width: 320px;
        z-index: 9999;
        display: none;
    }

        .filter-dropdown.open {
            display: block;
        }

    .ms-dropdown-search {
        padding: 10px 12px;
        border-bottom: 1px solid var(--e7-border);
    }

        .ms-dropdown-search input {
            width: 100%;
            border: 1px solid var(--e7-border);
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s;
        }

            .ms-dropdown-search input:focus {
                border-color: var(--e7-focus);
            }

            .ms-dropdown-search input::placeholder {
                color: var(--e7-text-4);
            }

    .ms-dropdown-header {
        padding: 10px 14px;
        background: var(--e7-surface-2);
        border-bottom: 1px solid var(--e7-border);
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .ms-dropdown-header input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--e7-accent);
        }

        .ms-dropdown-header label {
            font-size: 14px;
            font-weight: 600;
            color: var(--e7-text);
            cursor: pointer;
            margin: 0;
        }

    .ms-dropdown-list {
        max-height: 250px;
        overflow-y: auto;
    }

    .ms-dropdown-item {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid var(--e7-border);
        transition: background 0.15s;
    }

        .ms-dropdown-item:last-child {
            border-bottom: none;
        }

        .ms-dropdown-item:hover {
            background: var(--e7-surface-3);
        }

        .ms-dropdown-item.checked {
            background: var(--e7-accent-soft);
        }

        .ms-dropdown-item.hidden {
            display: none;
        }

        .ms-dropdown-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--e7-accent);
            flex-shrink: 0;
        }

        .ms-dropdown-item span {
            font-size: 14px;
            color: var(--e7-text);
        }

        .ms-dropdown-item.checked span {
            color: var(--e7-accent-ink);
            font-weight: 500;
        }

        .ms-dropdown-item span mark {
            background: var(--e7-amber-soft);
            color: var(--e7-text);
            padding: 0;
            border-radius: 2px;
        }

    .ms-dropdown-empty {
        padding: 25px;
        text-align: center;
        color: var(--e7-text-3);
        font-size: 14px;
    }

    .ms-dropdown-no-results {
        padding: 20px;
        text-align: center;
        color: var(--e7-text-3);
        font-size: 13px;
        display: none;
    }

        .ms-dropdown-no-results.show {
            display: block;
        }

    .dropdown-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9998;
        display: none;
    }

        .dropdown-backdrop.show {
            display: block;
        }

    /* ===== CHART STYLES ===== */
    .chart-container {
        padding: 20px;
        background: var(--e7-surface);
        border-radius: 16px;
        box-shadow: var(--e7-shadow-card);
        margin: 15px 0;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .chart-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--e7-heading);
        margin: 0;
    }

    .chart-wrapper {
        position: relative;
        height: 450px;
        width: 100%;
    }

    .no-data-box {
        height: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--e7-text-3);
        font-size: 16px;
    }

        .no-data-box i {
            font-size: 50px;
            margin-bottom: 15px;
            color: var(--e7-text-4);
        }

    /* View Type single-select items */
    .ms-dropdown-item-single {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid var(--e7-border);
        transition: background 0.15s;
    }

        .ms-dropdown-item-single:last-child {
            border-bottom: none;
        }

        .ms-dropdown-item-single:hover {
            background: var(--e7-surface-3);
        }

        .ms-dropdown-item-single.checked {
            background: var(--e7-accent-soft);
        }

            .ms-dropdown-item-single.checked span {
                color: var(--e7-accent-ink);
                font-weight: 500;
            }

        .ms-dropdown-item-single span {
            font-size: 14px;
            color: var(--e7-text);
        }

        .ms-dropdown-item-single i {
            width: 20px;
            text-align: center;
            font-size: 14px;
            color: var(--e7-text-3);
        }

        .ms-dropdown-item-single.checked i {
            color: var(--e7-accent-ink);
        }

    /* ===== CHANGED VALUE HIGHLIGHT (green) ===== */
    .history-table tbody td.val-changed {
        color: var(--e7-green) !important;
        background: var(--e7-green-soft) !important;
        font-weight: 600;
    }

    .history-table tbody tr:nth-child(even) td.val-changed {
        background: var(--e7-green-soft) !important;
    }

    .history-table tbody tr:hover td.val-changed {
        background: var(--e7-green-soft) !important;
    }

    /* ===== UNCHANGED VALUE HIGHLIGHT (soft muted) ===== */
    .history-table tbody td.val-unchanged {
        color: var(--e7-text-3) !important;
        background: var(--e7-surface-2) !important;
    }

    .history-table tbody tr:nth-child(even) td.val-unchanged {
        background: var(--e7-surface-3) !important;
    }

    .history-table tbody tr:hover td.val-unchanged {
        background: var(--e7-surface-3) !important;
    }

    /* ===== DATALOGGER PICKUP / DROP ===== */
    .dl-pickup {
        color: var(--e7-green) !important;
        font-weight: 700;
    }

    .dl-drop {
        color: var(--e7-red) !important;
        font-weight: 700;
    }

    .attr-sub {
        display: block;
        font-size: 9px;
        font-weight: 400;
        opacity: 0.75;
        margin-top: 1px;
        letter-spacing: 0.5px;
    }

    /* Subscript-style for alias names: ITC → I<sub>TC</sub> (small lowered text) */
    .history-table thead th .alias-tc {
        font-size: 65%;
        vertical-align: sub;
        font-weight: inherit;
        letter-spacing: 0.2px;
    }

    /* ===== SINGLE-LINE FILTERS ===== */
    #filterContainer {
        display: flex !important;
        flex-wrap: nowrap !important;
        align-items: flex-end !important;
        gap: 8px;
        padding-bottom: 4px;
    }

        #filterContainer > div {
            flex: 0 0 auto;
            width: auto !important;
            min-width: 0;
            max-width: none;
            margin-top: 0 !important;
            padding: 0 2px;
        }

            #filterContainer > div > span {
                font-size: 12px;
                font-weight: 500;
                color: var(--e7-text-2);
                white-space: nowrap;
                display: block;
                margin-bottom: 4px;
            }

        #filterContainer .form-control,
        #filterContainer .select-btn {
            font-size: 13px;
            padding: 5px 10px;
            height: 36px;
            min-width: 90px;
        }

        #filterContainer input[type="date"] {
            min-width: 130px;
        }

        #filterContainer input.time-24 {
            min-width: 95px;
            max-width: 115px;
        }

        #filterContainer .time-24-wrapper {
            min-width: 95px;
            max-width: 115px;
        }

        #filterContainer .select-btn {
            min-width: 120px;
        }

        #filterContainer .btn-search {
            height: 36px;
            padding: 6px 14px;
        }

    /* ===== RESPONSIVE FILTER BAR ===== */
    @@media (max-width: 991.98px) {
        #filterContainer > div {
            flex: 1 1 calc(33.333% - 8px) !important;
            width: auto !important;
            max-width: none;
        }

        #filterContainer .select-btn,
        #filterContainer input[type="text"],
        #filterContainer select.form-control {
            min-width: 100%;
            width: 100% !important;
        }
    }

    @@media (max-width: 767.98px) {
        #filterContainer {
            flex-direction: column !important;
            align-items: stretch !important;
        }

            #filterContainer > div {
                width: 100% !important;
                flex: 1 1 100% !important;
                max-width: none;
            }

            #filterContainer .select-btn,
            #filterContainer input[type="text"],
            #filterContainer input[type="date"],
            #filterContainer .time-24-wrapper,
            #filterContainer select.form-control,
            #filterContainer .er-view-selector,
            #filterContainer .er-view-btn {
                min-width: 100% !important;
                max-width: 100% !important;
                width: 100% !important;
            }

            #filterContainer .btn-search {
                width: 100%;
            }

        .filter-dropdown {
            left: 12px !important;
            right: 12px !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
        }

        .er-view-dropdown {
            left: 0;
            right: 0;
            width: 100%;
            min-width: 0;
        }
    }

    @@media (max-width: 575.98px) {
        .time-picker-popup {
            width: calc(100vw - 24px);
            max-width: 260px;
        }
    }

    /* ===== CHART STYLES ===== */
    .chart-container {
        padding: 20px;
        background: var(--e7-surface);
        border-radius: 16px;
        box-shadow: var(--e7-shadow-card);
        margin: 15px 0;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .chart-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--e7-heading);
        margin: 0;
    }

    .chart-wrapper {
        position: relative;
        height: 450px;
        width: 100%;
    }

    .no-data-box {
        height: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--e7-text-3);
        font-size: 16px;
    }

        .no-data-box i {
            font-size: 50px;
            margin-bottom: 15px;
            color: var(--e7-text-4);
        }

    /* ===== VIEW TYPE DROPDOWN ===== */
    .er-view-selector {
        position: relative;
        display: inline-block;
    }

    .er-view-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--e7-surface-2);
        border: 1px solid var(--e7-border-2);
        border-radius: 6px;
        padding: 6px 12px;
        font-size: 13px;
        color: var(--e7-text);
        cursor: pointer;
        min-width: 140px;
        height: 36px;
        gap: 8px;
    }

        .er-view-btn:hover {
            border-color: var(--e7-accent);
        }

        .er-view-btn.active {
            border-color: var(--e7-focus);
            box-shadow: 0 0 0 2px var(--e7-accent-soft);
        }

    .er-view-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 4px;
        background: var(--e7-surface);
        border: 1px solid var(--e7-border);
        border-radius: 8px;
        box-shadow: var(--e7-shadow-pop);
        min-width: 180px;
        z-index: 9999;
        display: none;
    }

        .er-view-dropdown.open {
            display: block;
        }

    .er-view-item {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid var(--e7-border);
        transition: background 0.15s;
    }

        .er-view-item:last-child {
            border-bottom: none;
        }

        .er-view-item:hover {
            background: var(--e7-surface-3);
        }

        .er-view-item.checked {
            background: var(--e7-accent-soft);
        }

            .er-view-item.checked span {
                color: var(--e7-accent-ink);
                font-weight: 500;
            }

        .er-view-item span {
            font-size: 14px;
            color: var(--e7-text);
        }

        .er-view-item i {
            width: 20px;
            text-align: center;
            font-size: 14px;
            color: var(--e7-text-3);
        }

        .er-view-item.checked i {
            color: var(--e7-accent-ink);
        }
    /* ===== BAR CHART PAGER (table-style) ===== */
    .er-pg-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 14px;
        font-size: 13px;
        font-weight: 500;
        color: var(--e7-text-2);
        background: var(--e7-surface-2);
        border: 1px solid var(--e7-border-2);
        cursor: pointer;
        user-select: none;
        transition: background 0.15s, color 0.15s;
        margin-left: -1px;
    }

        .er-pg-btn:first-child {
            border-radius: 6px 0 0 6px;
            margin-left: 0;
        }

        .er-pg-btn:last-child {
            border-radius: 0 6px 6px 0;
        }

        .er-pg-btn:hover:not(.disabled):not(.active) {
            background: var(--e7-surface-3);
            color: var(--e7-heading);
            z-index: 1;
        }

    .er-pg-num.active {
        background: var(--e7-accent);
        color: #fff;
        border-color: var(--e7-accent);
        z-index: 2;
        font-weight: 600;
    }

    .er-pg-btn.disabled {
        color: var(--e7-text-4);
        cursor: default;
        pointer-events: none;
    }

    /* ===== FORCE selectedRangeBar RESPONSIVE (overrides inline styles) ===== */
    @@media (max-width: 767.98px) {
        #selectedRangeBar {
            min-width: 0 !important;
            width: 100% !important;
            flex-wrap: wrap !important;
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 12px !important;
            margin-left: 0 !important;
            padding: 14px 16px 14px 20px !important;
        }

            #selectedRangeBar > div:nth-child(2),
            #selectedRangeBar > div:nth-child(4) {
                width: 100% !important;
                flex-wrap: wrap !important;
                padding-left: 0 !important;
            }

            #selectedRangeBar > div:nth-child(3) {
                margin: 4px 0 !important;
                align-self: center !important;
                transform: rotate(90deg) !important;
            }

            #selectedRangeBar > div:nth-child(2) > div,
            #selectedRangeBar > div:nth-child(4) > div {
                flex: 1 1 auto !important;
                min-width: 0 !important;
            }

        #dispFromDate, #dispFromTime, #dispToDate, #dispToTime {
            min-width: 0 !important;
        }
    }

    @@media (max-width: 480px) {
        #selectedRangeBar > div:nth-child(2),
        #selectedRangeBar > div:nth-child(4) {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 6px !important;
        }

            #selectedRangeBar > div:nth-child(2) > div,
            #selectedRangeBar > div:nth-child(4) > div {
                width: 100% !important;
            }
    }

    /* ===== EQUIPMENT ROOM HISTORY PAGER — RESPONSIVE ===== */
    #pager.pagination {
        flex-wrap: wrap;
        row-gap: 6px;
        justify-content: center;
    }

    @@media (max-width: 767.98px) {
        .table-border > .row > .col-12 .d-flex.justify-content-between.align-items-center.px-4.py-3.border-top,
        #pager.pagination {
            justify-content: center !important;
        }

        #pager .page-link {
            padding: 6px 10px;
            font-size: 13px;
        }
    }

    @@media (max-width: 480px) {
        #pager .page-link {
            padding: 5px 8px;
            font-size: 12px;
        }
    }
    /* ===== LIVE PICTORIAL CARD STYLES (from the old Live page) ===== */
    .pictorial-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 16px;
        padding: 16px;
    }

    .room-card-pictorial {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px 18px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-height: 160px;
        color: var(--text-secondary);
    }

    .rcp-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 4px;
    }

    .rcp-title {
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary);
        flex: 1;
        min-width: 0;
        word-break: break-word;
    }

    .rcp-badges {
        display: flex;
        gap: 6px;
        align-items: center;
        flex-shrink: 0;
        font-size: 12px;
        color: var(--text-muted);
    }

    .dl-badge-wrap .badge-success,
    .dl-badge-wrap .badge-warning {
        font-size: 12px;
        padding: 3px 8px;
        border-radius: 4px;
    }

    .rcp-body {
        display: flex;
        gap: 16px;
        align-items: center;
        min-width: 0;
    }

    .rcp-icon {
        width: 70px;
        height: 70px;
        border-radius: 10px;
        background: var(--blue-dim);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .rcp-icon img {
            width: 48px;
            height: 48px;
        }

    .rcp-metrics {
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
        min-width: 0;
    }

    .rcp-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--text-secondary);
        flex-wrap: nowrap;
    }

    .rcp-chip {
        background-color: var(--blue);
        width: 28px;
        height: 28px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .rcp-chip img {
            width: 18px;
            height: 18px;
        }

    .rcp-row-inner {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 0;
    }

    .rcp-row-top {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .rcp-row-top .label-text {
            min-width: 65px;
            flex-shrink: 0;
        }

    .rcp-meta-time {
        font-size: 11px;
        color: var(--text-muted);
        white-space: nowrap;
        margin-top: 2px;
    }

    .val-temp {
        color: var(--red);
        font-weight: 600;
        font-size: 14px;
        flex-shrink: 0;
    }

    .val-hum {
        color: var(--blue);
        font-weight: 600;
        font-size: 14px;
        flex-shrink: 0;
    }

    /* ======================================================================
       UNIFIED EQUIPMENT ROOM PAGE
       Built only from the app's own patterns (card / card-header / breadcrumb /
       #filterContainer / select-btn / ms-dropdown / table thead-light2 /
       badge-success / badge-warning / room-card-pictorial) so it matches
       the other FRS25 screens in light and dark mode.
       ====================================================================== */

    /* keep the page from jumping sideways when content height changes */
    html { scrollbar-gutter: stable; }

    .erx-card-head {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
    }

        .erx-card-head h4 { margin: 0; display: flex; align-items: center; gap: 10px; }

    .erx-meta { font-size: 12px; font-weight: 400; color: var(--e7-text-3, #64748b); }

    /* segmented switch — same look as the view dropdown button */
    .erx-seg {
        display: inline-flex;
        background: var(--e7-surface-2, #f8fafc);
        border: 1px solid var(--e7-border-2, #cbd5e1);
        border-radius: 6px;
        padding: 3px;
        gap: 2px;
    }

        .erx-seg button {
            border: none;
            background: transparent;
            color: var(--e7-text-3, #64748b);
            font-size: 13px;
            font-weight: 500;
            height: 30px;
            padding: 0 12px;
            border-radius: 4px;
            cursor: pointer;
            white-space: nowrap;
        }

            .erx-seg button:hover { color: var(--e7-text, #0f172a); }

            .erx-seg button.active {
                background: var(--e7-accent, #2563eb);
                color: #fff;
            }

        .erx-seg.sm button { height: 26px; padding: 0 10px; font-size: 12px; }

    .erx-presets {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        color: var(--e7-text-3, #64748b);
        margin-top: 4px;
    }

    /* equipment-room multi-select: wrapper for the shared .select-btn */
    #ddEquipmentRoom .ms-dropdown-list { max-height: 260px; overflow-y: auto; }

    /* ---- KPI tiles ---- */
    .erx-kpis {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
        padding: 0 16px 16px;
    }

    .erx-kpi {
        background: var(--e7-surface-2, #f8fafc);
        border: 1px solid var(--e7-border, #e2e8f0);
        border-radius: 10px;
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

        .erx-kpi .k-label { font-size: 12px; color: var(--e7-text-3, #64748b); }
        .erx-kpi .k-val { font-size: 20px; font-weight: 700; color: var(--e7-heading, #0f172a); line-height: 1.3; font-variant-numeric: tabular-nums; }
        .erx-kpi .k-val small { font-size: 13px; font-weight: 500; color: var(--e7-text-3, #64748b); }
        .erx-kpi .k-sub { font-size: 11px; color: var(--e7-text-3, #64748b); min-height: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .erx-kpi.is-warn { border-color: var(--e7-amber, #f59e0b); }
        .erx-kpi.is-warn .k-val { color: var(--e7-amber, #b45309); }

    /* ---- live status pill (filled by the _List partial) ---- */
    #wsStatusBar { display: none; min-width: 150px; }
    .ws-status-bar {
        display: inline-flex; align-items: center; gap: 8px; height: 32px; padding: 0 12px;
        border-radius: 6px; font-size: 12px; white-space: nowrap;
        border: 1px solid var(--e7-border, #e2e8f0); background: var(--e7-surface-2, #f8fafc); color: var(--e7-text, #0f172a);
    }
    .ws-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
        .ws-dot.live { background: var(--e7-green, #16a34a); }
        .ws-dot.orange { background: var(--e7-amber, #f59e0b); }
        .ws-dot.red { background: var(--e7-red, #dc2626); }

    /* ---- room cards (extends the existing pictorial card) ---- */
    .erx-grid { padding: 0 16px 16px; }

    .room-card-pictorial.erx-room { transition: border-color .15s, box-shadow .15s; }
        .room-card-pictorial.erx-room:hover { border-color: var(--e7-accent, #2563eb); }
        .room-card-pictorial.erx-room.is-warn { border-color: var(--e7-amber, #f59e0b); }
        .room-card-pictorial.erx-room.is-selected { border-color: var(--e7-accent, #2563eb); box-shadow: 0 0 0 3px var(--e7-accent-soft, rgba(37,99,235,.15)); }

    .erx-sub { display: block; font-size: 12px; font-weight: 400; color: var(--e7-text-3, #64748b); margin-top: 2px; }

    .erx-val-wrap { display: flex; align-items: center; gap: 6px; min-width: 0; }
    .erx-est {
        font-size: 10px; font-weight: 600; padding: 1px 6px; border-radius: 4px; cursor: help;
        background: var(--e7-amber-soft, #fef3c7); color: var(--e7-amber, #92400e);
    }
    .val-temp.is-est, .val-hum.is-est { color: var(--e7-amber, #b45309); }

    .erx-gauge { display: block; height: 4px; border-radius: 2px; background: var(--e7-surface-3, #e2e8f0); overflow: hidden; margin-top: 5px; }
    .erx-gauge > span { display: block; height: 100%; width: 0; border-radius: 2px; }
    .erx-gauge.g-temp > span { background: var(--red, #ef4444); }
    .erx-gauge.g-hum > span { background: var(--blue, #2563eb); }
    .erx-gauge.g-est > span { background: var(--e7-amber, #f59e0b); }

    .erx-foot {
        display: flex; align-items: center; justify-content: space-between; gap: 10px;
        border-top: 1px solid var(--e7-border, #e2e8f0); padding-top: 12px; margin-top: auto;
    }

    .erx-door { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--e7-text-3, #64748b); min-width: 0; }
        .erx-door .badge { font-size: 11px; }

    .erx-btn-link {
        border: 1px solid var(--e7-border-2, #cbd5e1); background: var(--e7-surface, #fff);
        color: var(--e7-accent-ink, #1d4ed8); border-radius: 6px; height: 30px; padding: 0 10px;
        font-size: 12px; font-weight: 500; cursor: pointer; white-space: nowrap;
    }
        .erx-btn-link:hover { border-color: var(--e7-accent, #2563eb); background: var(--e7-accent-soft, #eff6ff); }

    .erx-empty { padding: 48px 16px; text-align: center; color: var(--e7-text-3, #64748b); font-size: 14px; }
        .erx-empty i { font-size: 32px; display: block; margin-bottom: 10px; color: var(--e7-text-4, #94a3b8); }

    /* skeleton while loading (no full-page loader → no scrollbar flicker) */
    .erx-skel {
        height: 168px; border-radius: 12px; border: 1px solid var(--e7-border, #e2e8f0);
        background: linear-gradient(90deg, var(--e7-surface-2, #f1f5f9) 25%, var(--e7-surface-3, #e2e8f0) 50%, var(--e7-surface-2, #f1f5f9) 75%);
        background-size: 200% 100%; animation: erxShimmer 1.4s linear infinite;
    }
    @@keyframes erxShimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    .erx-busy { opacity: .6; pointer-events: none; }

    .erx-live-table tr.is-warn td { background: var(--e7-amber-soft, #fffbeb); }

    /* the original _List partial stays off-screen; its WebSocket code feeds the cards */
    #erLiveRaw { display: none; }

    .erx-hist-only.is-hidden { display: none !important; }
</style>

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<!-- 24-hour Time Picker Popup (shared for From/To) -->
<div class="time-picker-popup" id="timePickerPopup">
    <div class="time-picker-header">
        <span class="time-picker-display" id="tpHour">00</span>
        <span class="time-picker-display">:</span>
        <span class="time-picker-display" id="tpMinute">00</span>
    </div>
    <div class="time-picker-body">
        <div class="time-picker-col" id="tpHourCol"></div>
        <div class="time-picker-col" id="tpMinuteCol"></div>
    </div>
    <div class="time-picker-footer">
        <button type="button" class="time-picker-btn" onclick="return tpNow(event);">Now</button>
        <button type="button" class="time-picker-btn" onclick="return tpClear(event);">Clear</button>
        <button type="button" class="time-picker-btn primary" onclick="return tpApply(event);">OK</button>
    </div>
</div>

<!-- Equipment Room multi-select panel (positioned under its button) -->
<div class="filter-dropdown" id="ddEquipmentRoom">
    <div class="ms-dropdown-search">
        <input type="text" placeholder="Search equipment room..." aria-label="Search equipment room" onkeyup="erFilterRoomList(this.value)">
    </div>
    <div class="ms-dropdown-header">
        <input type="checkbox" id="chkAllEquipmentRoom">
        <label for="chkAllEquipmentRoom">Select All</label>
    </div>
    <div class="ms-dropdown-list" id="listEquipmentRoom"><div class="ms-dropdown-empty">Select Station first</div></div>
</div>

<section class="section">

    <!-- ================= PAGE HEADER (same pattern as every FRS25 page) ================= -->
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="row">
                        <div class="col-12 col-sm-5">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">Equipment Room</li>
                                    <li class="breadcrumb-item active" aria-current="page"><a href="#">Live &amp; History</a></li>
                                </ol>
                            </nav>
                        </div>
                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                            <h2 class="page-name">Equipment Room</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= SEARCH (same filter bar as the History page) ================= -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header mb-2">
                    <div class="erx-card-head">
                        <h4>Search</h4>
                        <div class="erx-seg" role="group" aria-label="Show">
                            <button type="button" id="erModeBoth" class="active" onclick="erSetMode('both')">Live + History</button>
                            <button type="button" id="erModeLive" onclick="erSetMode('live')">Live</button>
                            <button type="button" id="erModeHistory" onclick="erSetMode('history')">History</button>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-2" id="filterContainer">
                        <div class="filter-item">
                            <span>Zone</span>
                            @Html.DropDownList("drpZone", (IEnumerable<SelectListItem>)ViewBag.Zones, "Select", new { @class = "form-control", tabindex = 1 })
                        </div>
                        <div class="filter-item">
                            <span>Division</span>
                            @Html.DropDownList("drpDivision", (IEnumerable<SelectListItem>)ViewBag.Divisions, "Select", new { @class = "form-control", tabindex = 2 })
                        </div>
                        <div class="filter-item">
                            <span>Station</span>
                            @Html.DropDownList("drpSite", (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 3 })
                        </div>
                        <div class="filter-item">
                            <span>Equipment Room</span>
                            <div class="select-btn" id="btnEquipmentRoom" role="button" tabindex="4" aria-haspopup="true" aria-expanded="false">
                                <span class="text" id="txtEquipmentRoom">All</span>
                                <i class="fas fa-chevron-down"></i>
                            </div>
                        </div>
                        <div class="filter-item erx-hist-only">
                            <span>From Date</span>
                            <input type="text" class="form-control" id="txtFromDate" placeholder="Select" readonly />
                        </div>
                        <div class="filter-item erx-hist-only">
                            <span>From Time</span>
                            <div class="time-24-wrapper">
                                <input type="text" class="form-control time-24" id="txtFromTime" placeholder="HH:MM" maxlength="5" autocomplete="off" readonly />
                                <i class="fas fa-clock time-24-icon"></i>
                            </div>
                        </div>
                        <div class="filter-item erx-hist-only">
                            <span>To Date</span>
                            <input type="text" class="form-control" id="txtToDate" placeholder="Select" readonly />
                        </div>
                        <div class="filter-item erx-hist-only">
                            <span>To Time</span>
                            <div class="time-24-wrapper">
                                <input type="text" class="form-control time-24" id="txtToTime" placeholder="HH:MM" maxlength="5" autocomplete="off" readonly />
                                <i class="fas fa-clock time-24-icon"></i>
                            </div>
                        </div>
                        <div class="filter-item erx-hist-only" style="position:relative; z-index:100;">
                            <span>History View</span>
                            <div class="er-view-selector">
                                <div class="er-view-btn" id="erViewBtn" onclick="toggleErViewDropdown()">
                                    <span><i class="fas fa-table mr-1"></i> Table</span>
                                    <i class="fas fa-chevron-down" style="font-size:11px; color:var(--e7-text-3, #999);"></i>
                                </div>
                                <div class="er-view-dropdown" id="erViewDropdown">
                                    <div class="er-view-item checked" data-value="Table" onclick="selectErView(this)"><i class="fas fa-table"></i><span>Table</span></div>
                                    <div class="er-view-item" data-value="Pie" onclick="selectErView(this)"><i class="fas fa-chart-pie"></i><span>Pie</span></div>
                                    <div class="er-view-item" data-value="Bar" onclick="selectErView(this)"><i class="fas fa-chart-bar"></i><span>Bar</span></div>
                                    <div class="er-view-item" data-value="Graph" onclick="selectErView(this)"><i class="fas fa-chart-line"></i><span>Graph</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="filter-item">
                            <span>&nbsp;</span>
                            <button type="button" class="btn-search" id="btnErSearch" onclick="erApply()" title="Search" aria-label="Search">
                                <img src="~/Areas/FRS25/assets/img/search.svg" alt="">
                            </button>
                        </div>
                    </div>
                    <div class="erx-presets erx-hist-only">
                        <span>Quick range</span>
                        <div class="erx-seg sm" role="group" aria-label="Quick range" id="erPresets">
                            <button type="button" data-preset="1h">Last 1h</button>
                            <button type="button" data-preset="6h">Last 6h</button>
                            <button type="button" data-preset="today" class="active">Today</button>
                            <button type="button" data-preset="24h">Last 24h</button>
                            <button type="button" data-preset="7d">Last 7 days</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= LIVE ================= -->
    <div class="row" id="erLiveSection">
        <div class="col-12">
            <div class="card">
                <div class="card-header mb-3">
                    <div class="erx-card-head">
                        <h4>Live Status <span class="erx-meta" id="erLiveMeta">Select a station and press search</span></h4>
                        <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:center;">
                            <div id="wsStatusBar"></div>
                            <div class="erx-seg" role="group" aria-label="Live view">
                                <button type="button" id="erLiveViewCards" class="active" onclick="erSetLiveView('cards')"><i class="fas fa-th-large mr-1"></i> Pictorial</button>
                                <button type="button" id="erLiveViewTable" onclick="erSetLiveView('table')"><i class="fas fa-table mr-1"></i> Table</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="erx-kpis" id="erKpis" style="display:none;">
                        <div class="erx-kpi"><span class="k-label">Rooms reporting</span><span class="k-val" id="kpiRooms">0 <small>/ 0</small></span><span class="k-sub" id="kpiRoomsSub"></span></div>
                        <div class="erx-kpi"><span class="k-label">Avg temperature</span><span class="k-val" id="kpiAvgTemp">--</span><span class="k-sub">Valid readings only</span></div>
                        <div class="erx-kpi"><span class="k-label">Highest temperature</span><span class="k-val" id="kpiMaxTemp">--</span><span class="k-sub" id="kpiMaxTempRoom"></span></div>
                        <div class="erx-kpi"><span class="k-label">Avg humidity</span><span class="k-val" id="kpiAvgHum">--</span><span class="k-sub" id="kpiMaxHum"></span></div>
                        <div class="erx-kpi" id="kpiEstCard"><span class="k-label">Out-of-range sensors</span><span class="k-val" id="kpiEst">0</span><span class="k-sub" id="kpiEstSub"></span></div>
                        <div class="erx-kpi"><span class="k-label">Doors</span><span class="k-val" id="kpiDoors">--</span><span class="k-sub" id="kpiDoorsSub"></span></div>
                    </div>

                    <div id="erLiveEmpty" class="erx-empty"><i class="fas fa-broadcast-tower"></i>Live readings appear here once a station is selected.</div>
                    <div id="erLiveCards" class="pictorial-grid erx-grid" style="display:none;"></div>
                    <div id="erLiveTableWrap" class="table-border" style="display:none;">
                        <div class="table-responsive">
                            <table class="table table-hover erx-live-table">
                                <thead class="thead-light2">
                                    <tr>
                                        <th>Sr.No</th><th>Zone</th><th>Division</th><th>Station</th><th>Equipment Room Type</th>
                                        <th class="text-center">Temperature(°C)</th><th class="text-center">Humidity(%)</th>
                                        <th class="text-center">Open/Close</th><th class="text-center">Status</th><th class="text-center">History</th>
                                    </tr>
                                </thead>
                                <tbody id="erLiveTbody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div id="erLiveRaw" aria-hidden="true"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= HISTORY ================= -->
    <div class="row" id="erHistorySection">
        <div class="col-12">
            <div class="card">
                <div class="card-header mb-3">
                    <div class="erx-card-head">
                        <h4>History <span class="erx-meta" id="erHistMeta">All rooms</span></h4>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div id="divEquipmentRoomHistory">
                        <div class="erx-empty"><i class="fas fa-chart-line"></i>Choose a range and press search, or click <b>History</b> on any room above.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    // ==========================================================================
    // GLOBALS
    // ==========================================================================
    var erMode = 'both';               // both | live | history
    var erLiveView = 'cards';          // cards | table
    var erLiveLoadedSite = null;
    var erHistoryLoaded = false;
    var erSelectedView = 'Table';      // read by _HistoryList (Table / Pie / Bar / Graph)
    var erLiveObserver = null;
    var erRecalcTimer = null;
    var erLastLiveUpdate = null;
    var erLiveXhr = null, erHistXhr = null;

    var tpCurrentInputId = null, tpSelectedHour = 0, tpSelectedMinute = 0;

    var ER_IMG = {
        doorClose: '@Url.Content("~/Areas/FRS25/assets/img/icon_close_door.svg")',
        temp: '@Url.Content("~/Areas/FRS25/assets/img/temperature.svg")',
        hum: '@Url.Content("~/Areas/FRS25/assets/img/humidity.svg")'
    };

    function erEscHtml(v) {
        if (v === null || v === undefined) return '';
        return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function erWarn(msg) { if (typeof showWarning === 'function') showWarning(msg, 'Validation'); else alert(msg); }
    function erError(msg) {
        if (typeof showError === 'function') showError(msg, 'Error');
        else if (typeof CommonNotification === 'function') CommonNotification('ERROR', msg, 'Error');
        else alert(msg);
    }
    function erPad(n) { return ('0' + n).slice(-2); }
    function erNowHMS() { var d = new Date(); return erPad(d.getHours()) + ':' + erPad(d.getMinutes()) + ':' + erPad(d.getSeconds()); }

    // write to the DOM only when the value actually changes (prevents repaint loops)
    function erSetText($el, txt) { if ($el.length && $el.text() !== txt) $el.text(txt); }
    function erSetHtml($el, html) { if ($el.length && $el.html() !== html) $el.html(html); }
    function erSetClass($el, cls) { if ($el.length && $el.attr('class') !== cls) $el.attr('class', cls); }

    // ==========================================================================
    // MODE
    // ==========================================================================
    function erSetMode(mode) {
        erMode = mode;
        $('#erModeBoth').toggleClass('active', mode === 'both');
        $('#erModeLive').toggleClass('active', mode === 'live');
        $('#erModeHistory').toggleClass('active', mode === 'history');
        $('#erLiveSection').toggle(mode !== 'history');
        $('#erHistorySection').toggle(mode !== 'live');
        $('.erx-hist-only').toggleClass('is-hidden', mode === 'live');
        try { localStorage.setItem('erMode', mode); } catch (e) { }

        var site = $('#drpSite').val();
        if (site && site !== '0') {
            if (mode !== 'history' && erLiveLoadedSite !== site) erLoadLive();
            if (mode !== 'live' && !erHistoryLoaded) fnSearchHistory();
        }
    }

    function erSetLiveView(view) {
        erLiveView = view;
        $('#erLiveViewCards').toggleClass('active', view === 'cards');
        $('#erLiveViewTable').toggleClass('active', view === 'table');
        try { localStorage.setItem('erLiveView', view); } catch (e) { }
        if (!erLiveLoadedSite) return;
        $('#erLiveCards').toggle(view === 'cards');
        $('#erLiveTableWrap').toggle(view === 'table');
    }

    // ==========================================================================
    // SEARCH
    // ==========================================================================
    function erApply() {
        var site = $('#drpSite').val();
        if (!site || site === '0') { erWarn('Please select station.'); return; }
        if (erMode !== 'history') erLoadLive();
        if (erMode !== 'live') fnSearchHistory();
    }

    // ==========================================================================
    // LIVE — the original _List partial is loaded off-screen; its WebSocket code
    // writes into every element with its hook classes, and the cards below carry
    // the same hook classes, so they update live.
    // ==========================================================================
    function erLoadLive() {
        var site = $('#drpSite').val();
        if (!site || site === '0') return;
        if (erLiveXhr) erLiveXhr.abort();

        // section skeleton instead of the full-page loader
        $('#erLiveEmpty, #erLiveTableWrap').hide();
        $('#erLiveCards').html('<div class="erx-skel"></div><div class="erx-skel"></div><div class="erx-skel"></div>').show();
        erSetText($('#erLiveMeta'), 'Loading…');

        var m = { SearchCriteria: { SiteId: site, ZoneId: $('#drpZone').val(), DivisionId: $('#drpDivision').val() } };
        erLiveXhr = $.ajax({
            url: '/FRS25/EquipmentRoom/_List',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(m),
            dataType: 'html',
            success: function (html) {
                erStopLive();
                // _List uses ids that _HistoryList also uses — rename the live copies
                html = html
                    .replace(/listView/g, 'erLiveRawList')
                    .replace(/pictorialView/g, 'erLiveRawPictorial')
                    .replace(/tblEquipmentRoom/g, 'erLiveRawTable');
                $('#erLiveRaw').empty().append(html);
                erLiveLoadedSite = site;
                erWaitForLiveModel(0);
            },
            error: function (xhr, status) {
                if (status === 'abort') return;
                $('#erLiveCards').hide().empty();
                $('#erLiveEmpty').html('<i class="fas fa-exclamation-triangle"></i>Could not load live data. Please try again.').show();
                erSetText($('#erLiveMeta'), '');
                erError('Something went wrong while loading live data!');
            },
            complete: function () { erLiveXhr = null; }
        });
    }

    // _List assigns its model (window.json) inside $(document).ready, which runs a tick later
    function erWaitForLiveModel(tries) {
        if (window.json && window.json.mAssets) { erBuildLive(window.json); return; }
        if (tries > 40) { erBuildLive(null); return; }
        setTimeout(function () { erWaitForLiveModel(tries + 1); }, 50);
    }

    function erStopLive() {
        if (typeof window.disconnectWebSocket === 'function') { try { window.disconnectWebSocket(); } catch (e) { } }
        if (erLiveObserver) { erLiveObserver.disconnect(); erLiveObserver = null; }
        clearTimeout(erRecalcTimer);
    }

    function erFindRoomParts(item, room) {
        var attrs = item.assetAttributes || [], temp = null, hum = null, dl = null;
        for (var i = 0; i < attrs.length; i++) {
            var t = attrs[i].Title || '';
            if (!(t.length >= room.length && t.substr(t.length - room.length) === room)) continue;
            var tl = t.toLowerCase();
            if (!temp && tl.indexOf('temperature') > -1) temp = attrs[i];
            if (!hum && tl.indexOf('humidity') > -1) hum = attrs[i];
        }
        var dls = item.mAssetInfoDataloggers || [];
        for (var j = 0; j < dls.length; j++) {
            if ((dls[j].DataloggerAttribute || '').indexOf(room) === 0 && dls[j].DataloggerAttributeId > 0) { dl = dls[j]; break; }
        }
        return {
            tempHook: (temp && temp.Id > 0) ? 'hdnAttributeData' + temp.Id + item.Id : null,
            humHook: (hum && hum.Id > 0) ? 'hdnAttributeData' + hum.Id + item.Id : null,
            doorHook: dl ? 'DLAttribute' + item.Id + dl.DataloggerAttributeId : null,
            doorImgHook: dl ? 'hdnImgRelayRoom' + item.Id + dl.DataloggerAttributeId : null,
            doorTimeHook: dl ? 'rcptime' + item.Id + dl.DataloggerAttributeId : null
        };
    }

    function erValueEl(hook, kind) {
        var cls = kind === 'temp' ? 'val-temp' : 'val-hum';
        return hook
            ? '<strong class="erx-v ' + cls + ' ' + hook + '" data-kind="' + kind + '" data-hook="' + hook + '">--</strong>'
            : '<strong class="erx-v ' + cls + '" data-kind="' + kind + '">—</strong>';
    }

    function erBuildLive(model) {
        var cards = '', rows = '', n = 0;
        var assets = (model && model.mAssets) ? model.mAssets : [];
        var estTip = 'Sensor reading was outside the valid range — showing the configured default value';

        assets.forEach(function (item) {
            (item.siteAttributeDatasList || []).forEach(function (room) {
                n++;
                var p = erFindRoomParts(item, room), r = erEscHtml(room);
                var histBtn = '<button type="button" class="erx-btn-link" data-room="' + r + '" onclick="erOpenRoomHistory(this.getAttribute(\'data-room\'))">History</button>';

                cards +=
                    '<div class="room-card-pictorial erx-room" data-room="' + r + '">' +
                      '<div class="rcp-header">' +
                        '<span class="rcp-title">' + r + '<span class="erx-sub">' + erEscHtml(item.SiteName) + '</span></span>' +
                        '<div class="rcp-badges"><span class="badge badge-secondary erx-status">Waiting</span></div>' +
                      '</div>' +
                      '<div class="rcp-body">' +
                        '<div class="rcp-icon"><img class="' + (p.doorImgHook || '') + '" src="' + ER_IMG.doorClose + '" alt="" /></div>' +
                        '<div class="rcp-metrics">' +
                          '<div class="rcp-row"><span class="rcp-chip"><img src="' + ER_IMG.temp + '" alt="" /></span>' +
                            '<div class="rcp-row-inner"><div class="rcp-row-top"><span class="label-text">Temp :</span>' +
                              '<span class="erx-val-wrap">' + erValueEl(p.tempHook, 'temp') + '<span class="erx-est" style="display:none" title="' + estTip + '">Est.</span></span></div>' +
                              '<span class="erx-gauge g-temp"><span></span></span></div></div>' +
                          '<div class="rcp-row"><span class="rcp-chip"><img src="' + ER_IMG.hum + '" alt="" /></span>' +
                            '<div class="rcp-row-inner"><div class="rcp-row-top"><span class="label-text">Humidity :</span>' +
                              '<span class="erx-val-wrap">' + erValueEl(p.humHook, 'hum') + '<span class="erx-est" style="display:none" title="' + estTip + '">Est.</span></span></div>' +
                              '<span class="erx-gauge g-hum"><span></span></span></div></div>' +
                        '</div>' +
                      '</div>' +
                      '<div class="erx-foot">' +
                        '<div class="erx-door">' +
                          (p.doorHook
                            ? '<span>Door</span><a class="dl-badge-wrap erx-door-badge ' + p.doorHook + '" data-hook="' + p.doorHook + '"></a><span class="rcp-meta-time ' + p.doorTimeHook + '" data-hook="' + p.doorTimeHook + '"></span>'
                            : '<span>No door sensor</span>') +
                        '</div>' +
                        histBtn +
                      '</div>' +
                    '</div>';

                rows +=
                    '<tr data-room="' + r + '">' +
                      '<td>' + n + '</td><td>' + erEscHtml(item.Zone) + '</td><td>' + erEscHtml(item.Division) + '</td>' +
                      '<td>' + erEscHtml(item.SiteName) + '</td><td>' + r + '</td>' +
                      '<td class="text-center">' + (p.tempHook ? '<span class="' + p.tempHook + '" data-hook="' + p.tempHook + '"></span>' : '') + '</td>' +
                      '<td class="text-center">' + (p.humHook ? '<span class="' + p.humHook + '" data-hook="' + p.humHook + '"></span>' : '') + '</td>' +
                      '<td class="text-center">' + (p.doorHook ? '<a class="' + p.doorHook + '" data-hook="' + p.doorHook + '"></a>' : '') + '</td>' +
                      '<td class="text-center"><span class="badge badge-secondary erx-status">Waiting</span></td>' +
                      '<td class="text-center">' + histBtn + '</td>' +
                    '</tr>';
            });
        });

        if (n === 0) {
            $('#erLiveCards').hide().empty();
            $('#erLiveTbody').empty();
            $('#erLiveTableWrap, #erKpis').hide();
            $('#erLiveEmpty').html('<i class="fas fa-inbox"></i>No equipment rooms are configured for this station.').show();
            erSetText($('#erLiveMeta'), '');
            return;
        }

        $('#erLiveCards').html(cards);
        $('#erLiveTbody').html(rows);
        $('#erLiveEmpty').hide();
        $('#erLiveCards').toggle(erLiveView === 'cards');
        $('#erLiveTableWrap').toggle(erLiveView === 'table');
        $('#erKpis').show();

        // copy values that arrived before the cards existed
        $('#erLiveCards [data-hook], #erLiveTbody [data-hook]').each(function () {
            var $src = $('#erLiveRaw .' + this.getAttribute('data-hook')).first();
            if ($src.length && $src.html()) $(this).html($src.html());
        });

        // React ONLY to WebSocket writes into hook elements. (The previous
        // version also reacted to its own status/gauge updates, which made it
        // recalculate forever and caused the flicker.)
        if (window.MutationObserver) {
            erLiveObserver = new MutationObserver(function (muts) {
                for (var i = 0; i < muts.length; i++) {
                    var node = muts[i].target;
                    if (node.nodeType === 3) node = node.parentNode;
                    if (node && node.closest && node.closest('[data-hook]')) {
                        erLastLiveUpdate = erNowHMS();
                        clearTimeout(erRecalcTimer);
                        erRecalcTimer = setTimeout(erRecalcLive, 250);
                        return;
                    }
                }
            });
            erLiveObserver.observe(document.getElementById('erLiveCards'), { childList: true, subtree: true, characterData: true });
        }
        erApplyRoomFilter();
    }

    // The partial adds a trailing "." when it substituted a configured default
    function erReadValue($el) {
        var txt = ($el.text() || '').trim(), num = parseFloat(txt);
        return { has: !isNaN(num), num: num, est: /\.\s*$/.test(txt) };
    }

    function erStatusMeta(st) {
        if (st === 'warn') return { cls: 'badge badge-warning text-white erx-status', txt: 'Out of range' };
        if (st === 'ok') return { cls: 'badge badge-success erx-status', txt: 'Normal' };
        return { cls: 'badge badge-secondary erx-status', txt: 'Waiting' };
    }

    function erRecalcLive() {
        var visible = 0, reporting = 0, estRooms = [];
        var tSum = 0, tN = 0, tMax = null, tMaxRoom = '', hSum = 0, hN = 0, hMax = null, hMaxRoom = '';
        var open = 0, closed = 0, doorRooms = [], statusByRoom = {};

        $('#erLiveCards .erx-room').each(function () {
            var $c = $(this), room = $c.attr('data-room');
            var $t = $c.find('.erx-v[data-kind=temp]'), $h = $c.find('.erx-v[data-kind=hum]');
            var t = erReadValue($t), h = erReadValue($h);
            var tEst = t.has && t.est, hEst = h.has && h.est;

            $t.toggleClass('is-est', tEst); $t.next('.erx-est').toggle(tEst);
            $h.toggleClass('is-est', hEst); $h.next('.erx-est').toggle(hEst);
            $c.find('.g-temp').toggleClass('g-est', tEst).children().css('width', t.has ? Math.max(0, Math.min(100, t.num * 2)) + '%' : '0');
            $c.find('.g-hum').toggleClass('g-est', hEst).children().css('width', h.has ? Math.max(0, Math.min(100, h.num)) + '%' : '0');

            var st = (!t.has && !h.has) ? 'wait' : ((tEst || hEst) ? 'warn' : 'ok');
            statusByRoom[room] = st;
            var meta = erStatusMeta(st), $badge = $c.find('.erx-status');
            erSetClass($badge, meta.cls); erSetText($badge, meta.txt);
            $c.toggleClass('is-warn', st === 'warn');

            if ($c.css('display') === 'none') return;          // KPIs follow the room filter
            visible++;
            if (st !== 'wait') reporting++;
            if (tEst || hEst) estRooms.push(room);
            if (t.has && !tEst) { tSum += t.num; tN++; if (tMax === null || t.num > tMax) { tMax = t.num; tMaxRoom = room; } }
            if (h.has && !hEst) { hSum += h.num; hN++; if (hMax === null || h.num > hMax) { hMax = h.num; hMaxRoom = room; } }
            var door = ($c.find('.erx-door-badge').text() || '').trim().toLowerCase();
            if (door === 'open') { open++; doorRooms.push(room + ': open'); }
            else if (door === 'close') { closed++; doorRooms.push(room + ': closed'); }
        });

        $('#erLiveTbody tr').each(function () {
            var st = statusByRoom[$(this).attr('data-room')] || 'wait', meta = erStatusMeta(st), $b = $(this).find('.erx-status');
            $(this).toggleClass('is-warn', st === 'warn');
            erSetClass($b, meta.cls); erSetText($b, meta.txt);
        });

        erSetHtml($('#kpiRooms'), reporting + ' <small>/ ' + visible + '</small>');
        erSetText($('#kpiRoomsSub'), visible === 0 ? '' : (reporting === visible ? 'All sensors reporting' : (visible - reporting) + ' waiting for data'));
        erSetText($('#kpiAvgTemp'), tN ? (tSum / tN).toFixed(1) + ' °C' : '--');
        erSetText($('#kpiMaxTemp'), tMax !== null ? tMax.toFixed(1) + ' °C' : '--');
        erSetText($('#kpiMaxTempRoom'), tMaxRoom);
        erSetText($('#kpiAvgHum'), hN ? (hSum / hN).toFixed(1) + ' %' : '--');
        erSetText($('#kpiMaxHum'), hMax !== null ? 'Peak ' + hMax.toFixed(1) + ' % · ' + hMaxRoom : '');
        erSetText($('#kpiEst'), String(estRooms.length));
        $('#kpiEstCard').toggleClass('is-warn', estRooms.length > 0);
        erSetText($('#kpiEstSub'), estRooms.length ? estRooms.join(', ') : 'All readings in range');
        erSetHtml($('#kpiDoors'), open + closed === 0 ? '--' : open + ' <small>open</small> · ' + closed + ' <small>closed</small>');
        erSetText($('#kpiDoorsSub'), doorRooms.join(', '));
        erSetText($('#erLiveMeta'), $('#drpSite option:selected').text() + (erLastLiveUpdate ? ' · updated ' + erLastLiveUpdate : ' · waiting for first reading'));
    }

    // ==========================================================================
    // EQUIPMENT ROOM MULTI-SELECT (uses the History page's dropdown styles)
    // ==========================================================================
    function erOpenRoomDD() {
        var $btn = $('#btnEquipmentRoom'), $dd = $('#ddEquipmentRoom'), rect = $btn[0].getBoundingClientRect();
        var w = Math.max(rect.width, 260), left = Math.min(rect.left, window.innerWidth - w - 8);
        $dd.css({ top: (rect.bottom + 4) + 'px', left: Math.max(8, left) + 'px', width: w + 'px' }).addClass('open');
        $btn.addClass('active').attr('aria-expanded', 'true');
    }
    function erCloseRoomDD() {
        $('#ddEquipmentRoom').removeClass('open');
        $('#btnEquipmentRoom').removeClass('active').attr('aria-expanded', 'false');
    }

    function erLoadRooms(siteId) {
        $('#chkAllEquipmentRoom').prop('checked', false);
        if (!siteId || siteId === '0') {
            $('#listEquipmentRoom').html('<div class="ms-dropdown-empty">Select Station first</div>');
            erUpdateRoomText();
            return;
        }
        $('#listEquipmentRoom').html('<div class="ms-dropdown-empty">Loading...</div>');
        erUpdateRoomText();
        $.ajax({
            url: '/FRS25/EquipmentRoom/GetEquipmentRoom',
            type: 'GET',
            data: { siteId: siteId },
            success: function (data) {
                if (data && data.length > 0) {
                    var html = '';
                    $.each(data, function (k, v) {
                        var name = erEscHtml(v.Name);
                        html += '<div class="ms-dropdown-item" data-value="' + name + '" data-text="' + name + '">' +
                                '<input type="checkbox" class="cb-equipmentRoom" value="' + name + '"><span>' + name + '</span></div>';
                    });
                    $('#listEquipmentRoom').html(html);
                } else {
                    $('#listEquipmentRoom').html('<div class="ms-dropdown-empty">No equipment found</div>');
                }
                erUpdateRoomText();
            },
            error: function () { $('#listEquipmentRoom').html('<div class="ms-dropdown-empty">Failed to load</div>'); }
        });
    }

    function erGetSelectedRooms() {
        var vals = [];
        $('.cb-equipmentRoom:checked').each(function () { vals.push($(this).val()); });
        return vals;
    }

    function erUpdateRoomText() {
        var sel = erGetSelectedRooms(), total = $('.cb-equipmentRoom').length;
        $('#txtEquipmentRoom').text((sel.length === 0 || sel.length === total) ? 'All' : (sel.length === 1 ? sel[0] : sel.length + ' selected'));
        $('#chkAllEquipmentRoom').prop('checked', total > 0 && sel.length === total);
        $('#listEquipmentRoom .ms-dropdown-item').each(function () {
            $(this).toggleClass('checked', $(this).find('input').prop('checked'));
        });
    }

    function erFilterRoomList(q) {
        q = (q || '').toLowerCase();
        $('#listEquipmentRoom .ms-dropdown-item').each(function () {
            $(this).toggleClass('hidden', ($(this).attr('data-text') || '').toLowerCase().indexOf(q) === -1);
        });
    }

    function erApplyRoomFilter() {
        var sel = erGetSelectedRooms();
        $('#erLiveCards .erx-room, #erLiveTbody tr').each(function () {
            var show = sel.length === 0 || sel.indexOf($(this).attr('data-room')) > -1;
            $(this).toggle(show);
            if ($(this).hasClass('erx-room')) $(this).toggleClass('is-selected', sel.length === 1 && show);
        });
        if (erLiveLoadedSite) erRecalcLive();
    }

    function erOpenRoomHistory(room) {
        var found = false;
        $('.cb-equipmentRoom').each(function () { var on = $(this).val() === room; $(this).prop('checked', on); if (on) found = true; });
        if (!found) {
            $('#listEquipmentRoom .ms-dropdown-empty').remove();
            $('#listEquipmentRoom').append('<div class="ms-dropdown-item" data-value="' + erEscHtml(room) + '" data-text="' + erEscHtml(room) + '">' +
                '<input type="checkbox" class="cb-equipmentRoom" value="' + erEscHtml(room) + '" checked><span>' + erEscHtml(room) + '</span></div>');
        }
        erUpdateRoomText();
        erApplyRoomFilter();
        if (erMode === 'live') erSetMode('both');
        fnSearchHistory();
        $('html, body').animate({ scrollTop: $('#erHistorySection').offset().top - 80 }, 300);
    }

    // ==========================================================================
    // HISTORY (same request as the old History page → _HistoryList partial)
    // ==========================================================================
    function erParseDT(dateStr, timeStr) {
        var d = (dateStr || '').split('/'), t = (timeStr || '00:00').split(':');
        return new Date(parseInt(d[2], 10), parseInt(d[1], 10) - 1, parseInt(d[0], 10), parseInt(t[0] || 0, 10), parseInt(t[1] || 0, 10), 0);
    }

    function fnSearchHistory() {
        var fromDate = $('#txtFromDate').val(), toDate = $('#txtToDate').val();
        if (!fromDate) { erWarn('Please select From Date.'); return; }
        if (!toDate) { erWarn('Please select To Date.'); return; }
        var now = new Date(), fromDT = erParseDT(fromDate, $('#txtFromTime').val()), toDT = erParseDT(toDate, $('#txtToTime').val());
        if (fromDT > now) { erWarn('From Date & Time cannot be a future date and time.'); return; }
        if (toDT > now) { erWarn('To Date & Time cannot be a future date and time.'); return; }
        if (fromDT > toDT) { erWarn('From Date & Time must be less than or equal to To Date & Time.'); return; }
        var site = $('#drpSite').val();
        if (!site || site === '0') { erWarn('Station is required.'); return; }
        if (erHistXhr) erHistXhr.abort();

        var rooms = erGetSelectedRooms();
        erSetText($('#erHistMeta'), (rooms.length === 0 ? 'All rooms' : rooms.join(', ')) + ' · ' +
            fromDate + ' ' + ($('#txtFromTime').val() || '00:00') + ' → ' + toDate + ' ' + ($('#txtToTime').val() || '00:00'));

        // keep the current height while loading so the page does not jump
        var $box = $('#divEquipmentRoomHistory');
        $box.css('min-height', Math.max($box.outerHeight(), 200) + 'px')
            .html('<div class="erx-empty"><i class="fas fa-spinner fa-spin"></i>Loading history data...</div>');

        var m = { SearchCriteria: {}, Pager: {} };
        m.SearchCriteria.ZoneIds = [];
        m.SearchCriteria.DivisionIds = [];
        m.SearchCriteria.SiteIds = [site];
        m.SearchCriteria.AssetIds = [];
        m.SearchCriteria.AlertInfoIds = [];
        m.SearchCriteria.AcknowledgemenStatusIds = [];
        m.SearchCriteria.StartDate = toServerDate(fromDate);
        m.SearchCriteria.EndDate = toServerDate(toDate);
        m.SearchCriteria.StartTime = $('#txtFromTime').val();
        m.SearchCriteria.EndTime = $('#txtToTime').val();
        m.SearchCriteria.siteAttributeDatasList = rooms;

        erHistXhr = $.ajax({
            url: '/FRS25/EquipmentRoom/_HistoryList',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(m),
            dataType: 'html',
            success: function (data) {
                $box.empty().append(data).css('min-height', '');
                erHistoryLoaded = true;
                if (typeof updateRangeBar === 'function') updateRangeBar();
                if (typeof renderErView === 'function') renderErView();
            },
            error: function (xhr, status) {
                if (status === 'abort') return;
                $box.css('min-height', '').html('<div class="erx-empty"><i class="fas fa-exclamation-triangle"></i>Failed to load history. Please try again.</div>');
                erError('Something went wrong!');
            },
            complete: function () { erHistXhr = null; }
        });
    }

    // ==========================================================================
    // QUICK RANGE + DATE HELPERS
    // ==========================================================================
    function erApplyPreset(preset) {
        var to = new Date(), from = new Date(to.getTime());
        if (preset === '1h') from.setHours(to.getHours() - 1);
        else if (preset === '6h') from.setHours(to.getHours() - 6);
        else if (preset === '24h') from.setDate(to.getDate() - 1);
        else if (preset === '7d') from.setDate(to.getDate() - 7);
        else from.setHours(0, 0, 0, 0);
        $('#txtFromDate').val(formatDateForInput(from));
        $('#txtFromTime').val(formatTimeForInput(from));
        $('#txtToDate').val(formatDateForInput(to));
        $('#txtToTime').val(formatTimeForInput(to));
        $('#erPresets button').removeClass('active');
        $('#erPresets button[data-preset="' + preset + '"]').addClass('active');
    }
    function formatDateForInput(date) { return erPad(date.getDate()) + '/' + erPad(date.getMonth() + 1) + '/' + date.getFullYear(); }
    function formatTimeForInput(date) { return erPad(date.getHours()) + ':' + erPad(date.getMinutes()); }
    function toServerDate(ddmmyyyy) {
        if (!ddmmyyyy) return '';
        var p = ddmmyyyy.split('/');
        return p.length === 3 ? p[1] + '/' + p[0] + '/' + p[2] : ddmmyyyy;   // MM/DD/YYYY
    }

    // ==========================================================================
    // CASCADING DROPDOWNS — no full-page loader; the select itself shows "Loading..."
    // ==========================================================================
    function erLoadOptions($sel, url, payload, errMsg) {
        $sel.prop('disabled', true).empty().append($('<option></option>').val('0').text('Loading...'));
        $.ajax({
            url: url,
            type: 'POST',
            data: JSON.stringify(payload),
            contentType: 'application/json',
            success: function (data) {
                $sel.empty().append($('<option></option>').val('0').text('Select'));
                $.each(data || [], function (k, v) { $sel.append($('<option></option>').val(v.Id).text(v.Name)); });
            },
            error: function () { $sel.empty().append($('<option></option>').val('0').text('Select')); erError(errMsg); },
            complete: function () { $sel.prop('disabled', false); }
        });
    }

    function erResetResults() {
        erStopLive();
        if (erLiveXhr) erLiveXhr.abort();
        if (erHistXhr) erHistXhr.abort();
        erLiveLoadedSite = null;
        erHistoryLoaded = false;
        erLastLiveUpdate = null;
        $('#erLiveRaw, #erLiveCards, #erLiveTbody').empty();
        $('#erLiveCards, #erLiveTableWrap, #erKpis').hide();
        $('#erLiveEmpty').html('<i class="fas fa-broadcast-tower"></i>Press search to start live readings for this station.').show();
        erSetText($('#erLiveMeta'), '');
        $('#wsStatusBar').hide().empty();
        $('#divEquipmentRoomHistory').css('min-height', '').html('<div class="erx-empty"><i class="fas fa-chart-line"></i>Choose a range and press search, or click <b>History</b> on any room above.</div>');
        erSetText($('#erHistMeta'), 'All rooms');
    }

    // ==========================================================================
    // HISTORY VIEW DROPDOWN (Table / Pie / Bar / Graph)
    // ==========================================================================
    function selectErView(el) {
        var $el = $(el);
        $('#erViewDropdown .er-view-item').removeClass('checked');
        $el.addClass('checked');
        erSelectedView = $el.data('value');
        $('#erViewBtn > span').html($el.find('i').prop('outerHTML') + ' ' + $el.find('span').text());
        $('#erViewDropdown').removeClass('open');
        $('#erViewBtn').removeClass('active');
        if (typeof renderErView === 'function' && $('#tblEquipmentRoom').length) renderErView();
    }
    function toggleErViewDropdown() {
        var $dd = $('#erViewDropdown'), isOpen = $dd.hasClass('open');
        $dd.toggleClass('open', !isOpen);
        $('#erViewBtn').toggleClass('active', !isOpen);
        if (!isOpen) setTimeout(function () { $(document).one('click', function () { $dd.removeClass('open'); $('#erViewBtn').removeClass('active'); }); }, 10);
    }

    // ==========================================================================
    // 24-HOUR TIME PICKER (from the History page)
    // ==========================================================================
    function tpBuildLists() {
        var hr = '', mn = '';
        for (var h = 0; h < 24; h++) hr += '<div class="time-picker-item" data-hour="' + h + '">' + erPad(h) + '</div>';
        for (var m = 0; m < 60; m++) mn += '<div class="time-picker-item" data-minute="' + m + '">' + erPad(m) + '</div>';
        $('#tpHourCol').html(hr);
        $('#tpMinuteCol').html(mn);
    }
    function tpOpen(inputId) {
        tpCurrentInputId = inputId;
        var parts = $('#' + inputId).val().trim().split(':');
        tpSelectedHour = (parts.length === 2 && !isNaN(parseInt(parts[0]))) ? parseInt(parts[0], 10) : 0;
        tpSelectedMinute = (parts.length === 2 && !isNaN(parseInt(parts[1]))) ? parseInt(parts[1], 10) : 0;
        tpUpdateSelection();
        var $input = $('#' + inputId), $popup = $('#timePickerPopup');
        $('body').append($popup);
        var rect = $input[0].getBoundingClientRect();
        $popup.css({ position: 'absolute', visibility: 'hidden', display: 'block', top: '-9999px', left: '-9999px', 'z-index': 99999 });
        var popupH = $popup.outerHeight(), popupW = $popup.outerWidth();
        var top = rect.bottom + window.scrollY + 4, left = rect.left + window.scrollX;
        if (top + popupH > window.innerHeight + window.scrollY) top = rect.top + window.scrollY - popupH - 4;
        if (left + popupW > window.innerWidth + window.scrollX) left = window.innerWidth + window.scrollX - popupW - 8;
        if (left < 4) left = 4;
        $popup.css({ visibility: '', display: '', top: top + 'px', left: left + 'px' }).addClass('open');
        setTimeout(function () {
            var $h = $('#tpHourCol .time-picker-item.selected'), $m = $('#tpMinuteCol .time-picker-item.selected');
            if ($h.length) $('#tpHourCol').scrollTop($h[0].offsetTop - 70);
            if ($m.length) $('#tpMinuteCol').scrollTop($m[0].offsetTop - 70);
        }, 20);
    }
    function tpClose() {
        $('#timePickerPopup').removeClass('open').css({ display: 'none', top: '-9999px', left: '-9999px', visibility: 'hidden' });
        tpCurrentInputId = null;
    }
    function tpUpdateSelection() {
        $('#tpHourCol .time-picker-item, #tpMinuteCol .time-picker-item').removeClass('selected');
        $('#tpHourCol .time-picker-item[data-hour="' + tpSelectedHour + '"]').addClass('selected');
        $('#tpMinuteCol .time-picker-item[data-minute="' + tpSelectedMinute + '"]').addClass('selected');
        $('#tpHour').text(erPad(tpSelectedHour));
        $('#tpMinute').text(erPad(tpSelectedMinute));
    }
    function tpNow(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        var now = new Date(); tpSelectedHour = now.getHours(); tpSelectedMinute = now.getMinutes(); tpUpdateSelection();
        return false;
    }
    function tpClear(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        if (tpCurrentInputId) $('#' + tpCurrentInputId).val('');
        tpClose(); return false;
    }
    function tpApply(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        if (tpCurrentInputId) $('#' + tpCurrentInputId).val(erPad(tpSelectedHour) + ':' + erPad(tpSelectedMinute));
        $('#erPresets button').removeClass('active');
        tpClose(); return false;
    }

    // ==========================================================================
    // INIT
    // ==========================================================================
    $(document).ready(function () {
        tpBuildLists();
        erApplyPreset('today');
        if ($.fn.datepicker) {
            var clearPreset = function () { $('#erPresets button').removeClass('active'); };
            $('#txtFromDate').datepicker({ dateFormat: 'dd/mm/yyyy', autoClose: true, onSelect: clearPreset });
            $('#txtToDate').datepicker({ dateFormat: 'dd/mm/yyyy', autoClose: true, onSelect: clearPreset });
        }

        try {
            var v = localStorage.getItem('erLiveView'); if (v === 'table' || v === 'cards') erSetLiveView(v);
            var md = localStorage.getItem('erMode'); if (md === 'both' || md === 'live' || md === 'history') erSetMode(md);
        } catch (e) { }

        $('#drpZone').on('change', function () {
            var id = $(this).val(); if (!id || id === '0') return;
            erLoadOptions($('#drpDivision'), '/FRS25/EquipmentRoom/GetDivisionByZoneId', { zoneId: id }, 'Failed to load divisions.');
        });
        $('#drpDivision').on('change', function () {
            var id = $(this).val(); if (!id || id === '0') return;
            erLoadOptions($('#drpSite'), '/FRS25/EquipmentRoom/GetSiteByDivisionId', { divisionId: id }, 'Failed to load stations.');
        });
        $('#drpSite').on('change', function () { erResetResults(); erLoadRooms($(this).val()); });

        $('#erPresets').on('click', 'button', function () { erApplyPreset($(this).attr('data-preset')); });

        // equipment room multi-select
        $('#btnEquipmentRoom').on('click keydown', function (e) {
            if (e.type === 'keydown' && e.key !== 'Enter' && e.key !== ' ') return;
            e.preventDefault(); e.stopPropagation();
            $('#ddEquipmentRoom').hasClass('open') ? erCloseRoomDD() : erOpenRoomDD();
        });
        $('#ddEquipmentRoom').on('click', function (e) { e.stopPropagation(); });
        $(document).on('click', '#listEquipmentRoom .ms-dropdown-item', function (e) {
            if (e.target.tagName !== 'INPUT') { var $cb = $(this).find('input'); $cb.prop('checked', !$cb.prop('checked')); }
            erUpdateRoomText(); erApplyRoomFilter();
        });
        $('#chkAllEquipmentRoom').on('change', function () {
            $('.cb-equipmentRoom').prop('checked', this.checked);
            erUpdateRoomText(); erApplyRoomFilter();
        });
        $(document).on('click', erCloseRoomDD);
        $(window).on('scroll', function () { if ($('#ddEquipmentRoom').hasClass('open')) erCloseRoomDD(); });

        // time picker
        $(document).on('click', '.time-24', function (e) { e.stopPropagation(); tpOpen(this.id); });
        $(document).on('click', '#tpHourCol .time-picker-item', function (e) { e.stopPropagation(); tpSelectedHour = parseInt($(this).data('hour'), 10); tpUpdateSelection(); });
        $(document).on('click', '#tpMinuteCol .time-picker-item', function (e) { e.stopPropagation(); tpSelectedMinute = parseInt($(this).data('minute'), 10); tpUpdateSelection(); });
        $(document).on('mousedown', function (e) {
            if (!$('#timePickerPopup').hasClass('open')) return;
            var $t = $(e.target);
            if ($t.closest('#timePickerPopup').length === 0 && !$t.hasClass('time-24') && $t.closest('.time-24-wrapper').length === 0) tpClose();
        });
        $(document).on('keydown', function (e) {
            if (e.key !== 'Escape') return;
            if ($('#timePickerPopup').hasClass('open')) tpClose();
            erCloseRoomDD();
        });
        $(window).on('resize', function () {
            if ($('#timePickerPopup').hasClass('open')) tpClose();
            erCloseRoomDD();
            $('#erViewDropdown').removeClass('open');
            $('#erViewBtn').removeClass('active');
        });

        $(window).on('beforeunload', erStopLive);

        var site = $('#drpSite').val();
        if (site && site !== '0') { erLoadRooms(site); erApply(); }
    });
</script>
