                            <rect x="1" y="3" width="14" height="12" rx="2"
                                  stroke="#3b82f6" style="stroke:var(--e7-accent, #3b82f6)" stroke-width="1.4" />
                            <path d="M1 7h14" stroke="#3b82f6" style="stroke:var(--e7-accent, #3b82f6)" stroke-width="1.2" />
                            <path d="M5 1v3M11 1v3" stroke="#3b82f6" style="stroke:var(--e7-accent, #3b82f6)" stroke-width="1.4"
                                  stroke-linecap="round" />
                        </svg>
                        <span id="dispFromDate" style="
                font-size:13px;font-weight:600;color:var(--e7-heading, #1e293b);
                min-width:75px;letter-spacing:0.01em;
            ">—</span>
                    </div>

                    <!-- Time pill -->
                    <div style="
            display:flex;align-items:center;gap:6px;
            background:var(--e7-surface, #fff);border:1px solid var(--e7-border-2, #cbd5e1);
            border-radius:6px;padding:5px 12px;
            box-shadow:var(--e7-shadow-soft, 0 1px 3px rgba(0,0,0,0.06));
        ">
                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none"
                             style="flex-shrink:0">
                            <circle cx="8" cy="8" r="6.5" stroke="#6366f1" style="stroke:var(--e7-accent-2, #6366f1)" stroke-width="1.4" />
                            <path d="M8 4.5V8l2.5 2" stroke="#6366f1" style="stroke:var(--e7-accent-2, #6366f1)" stroke-width="1.4"
                                  stroke-linecap="round" />
                        </svg>
                        <span id="dispFromTime" style="
                font-size:13px;font-weight:600;color:var(--e7-heading, #1e293b);
                min-width:42px;letter-spacing:0.01em;
            ">—</span>
                    </div>
                </div>

                <!-- Arrow separator -->
                <div style="
        margin:0 14px;display:flex;align-items:center;
        color:var(--e7-text-3, #94a3b8);font-size:18px;font-weight:300;
    ">
                    <svg width="22" height="12" viewBox="0 0 22 12" fill="none">
                        <path d="M1 6h18M14 1l5 5-5 5" stroke="#94a3b8" style="stroke:var(--e7-text-3, #94a3b8)"
                              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>

                <!-- TO block -->
                <div style="display:flex;align-items:center;gap:10px;">
                    <span style="
            font-size:11px;font-weight:700;letter-spacing:0.08em;
            color:var(--e7-text-3, #6b7280);text-transform:uppercase;
        ">To</span>

                    <!-- Date pill -->
                    <div style="
            display:flex;align-items:center;gap:6px;
            background:var(--e7-surface, #fff);border:1px solid var(--e7-border-2, #cbd5e1);
            border-radius:6px;padding:5px 12px;
            box-shadow:var(--e7-shadow-soft, 0 1px 3px rgba(0,0,0,0.06));
        ">
                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
                            <rect x="1" y="3" width="14" height="12" rx="2"
                                  stroke="#3b82f6" style="stroke:var(--e7-accent, #3b82f6)" stroke-width="1.4" />
                            <path d="M1 7h14" stroke="#3b82f6" style="stroke:var(--e7-accent, #3b82f6)" stroke-width="1.2" />
                            <path d="M5 1v3M11 1v3" stroke="#3b82f6" style="stroke:var(--e7-accent, #3b82f6)" stroke-width="1.4"
                                  stroke-linecap="round" />
                        </svg>
                        <span id="dispToDate" style="
                font-size:13px;font-weight:600;color:var(--e7-heading, #1e293b);
                min-width:75px;letter-spacing:0.01em;
            ">—</span>
                    </div>

                    <!-- Time pill -->
                    <div style="
            display:flex;align-items:center;gap:6px;
            background:var(--e7-surface, #fff);border:1px solid var(--e7-border-2, #cbd5e1);
            border-radius:6px;padding:5px 12px;
            box-shadow:var(--e7-shadow-soft, 0 1px 3px rgba(0,0,0,0.06));
        ">
                        <svg width="13" height="13" viewBox="0 0 16 16" fill="none">
                            <circle cx="8" cy="8" r="6.5" stroke="#6366f1" style="stroke:var(--e7-accent-2, #6366f1)" stroke-width="1.4" />
                            <path d="M8 4.5V8l2.5 2" stroke="#6366f1" style="stroke:var(--e7-accent-2, #6366f1)" stroke-width="1.4"
                                  stroke-linecap="round" />
                        </svg>
                        <span id="dispToTime" style="
                font-size:13px;font-weight:600;color:var(--e7-heading, #1e293b);
                min-width:42px;letter-spacing:0.01em;
            ">—</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6">
            <div class="d-md-flex justify-content-between align-items-center" style="padding:8px 0;">
                <div class="d-flex align-items-center badge-cl gap-10">
                    <span id="dataInfo" class="text-muted" style="font-size: 12px;"></span>
                </div>
                @if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.UserClassId != E7FRSAdvance.Utility.Utility.UserClass.Guest.GetHashCode())
                {
                    <div class="d-flex justify-content-between align-items-center btn-icon-size">
                        <div class="d-flex justify-content-end px-md-3 px-2 py-2">
                            <!-- Download Dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-inactive" id="btnDownload" data-toggle="dropdown"
                                        aria-haspopup="true" aria-expanded="false" title="Download">
                                    <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"
                                         stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M4 16.004V17a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1M12 4.5v11m3.5-3.5L12 15.5 8.5 12"></path>
                                    </svg>
                                </button>
                                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="btnDownload">
                                    <a class="dropdown-item" href="javascript:void(0);" onclick="fnDownloadExcel()">
                                        <i class="fa fa-file-excel mr-2" style="color:var(--e7-dot-green, #22c55e);"></i> Excel
                                    </a>
                                    <a class="dropdown-item" href="javascript:void(0);" onclick="fnDownloadCSV()">
                                        <i class="fa fa-file-alt mr-2" style="color:var(--e7-accent, #3b82f6);"></i> CSV
                                    </a>
                                    <a class="dropdown-item" href="javascript:void(0);" onclick="fnDownloadPDF()">
                                        <i class="fa fa-file-pdf mr-2" style="color:var(--e7-red, #ef4444);"></i> PDF
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-12">

            <!-- Table View -->
            <div class="row">
                <div class="col">

                    <!-- Table View -->
                    <div id="listView">
                        <div class="table-responsive">
                            <table class="table table-hover" id="tblEquipmentRoom">
                                <thead class="thead-light2">
                                    <tr>
                                        <th>Sr.No</th>
                                        <th>Zone</th>
                                        <th>Division</th>
                                        <th>Station</th>
                                        <th>Date &amp; Time</th>
                                        <th>Equipment Room Type</th>
                                        <th class="text-center">Temperature(°C)</th>
                                        <th class="text-center">Humidity(%)</th>
                                        <th class="text-center">(Open/Close)</th>
                                    </tr>
                                </thead>
                                <tbody id="erTbody"></tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div id="erPagerWrap" class="d-flex justify-content-between align-items-center px-4 py-3 border-top">
                            <nav>
                                <ul class="pagination mb-0" id="pager">
                                    <li class="page-item" id="prevBtn">
                                        <a class="page-link" href="javascript:void(0);" onclick="changePage('prev')">
                                            <i class="fas fa-chevron-left"></i><span class="d-none d-sm-inline"> Previous</span>
                                        </a>
                                    </li>
                                    <li class="page-item" id="nextBtn">
                                        <a class="page-link" href="javascript:void(0);" onclick="changePage('next')">
                                            <span class="d-none d-sm-inline">Next </span><i class="fas fa-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>

                    <!-- Chart View -->
                    <div id="erChartContainer" style="display:none;"></div>

                </div>
            </div>
        </div>
    </div>

</div>

<script>
    // ==========================================================================
    // DATA + CLIENT-SIDE PAGINATION
    // Data arrives once as a compact JSON array; only the CURRENT page (10 rows)
    // is ever turned into DOM. 1 lakh+ rows stay in memory as plain arrays.
    // ==========================================================================
    var erRows = @Html.Raw(erRowsJson);

    function erEsc(v) {
        if (v === null || v === undefined) return '';
        return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function erDoorBadge(v) {
        if (v === 'Open') return '<span class="badge badge-success">Open</span>';
        if (v === 'Close') return '<span class="badge badge-warning text-white">Close</span>';
        return '';
    }

    (function () {
        var rowsPerPage = 10;
        var totalRows = erRows.length;
        var totalPages = Math.max(1, Math.ceil(totalRows / rowsPerPage));
        var currentPage = 1;
        var tbody = document.getElementById('erTbody');

        if (totalRows === 0) {
            tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-4">No history data found for the selected criteria.</td></tr>';
            $('#erPagerWrap').hide();
        } else {
            showPage(1);
        }

        function showPage(page) {
            if (page < 1) page = 1;
            if (page > totalPages) page = totalPages;
            currentPage = page;
            var start = (page - 1) * rowsPerPage;
            var end = Math.min(start + rowsPerPage, totalRows);

            var html = '';
            for (var i = start; i < end; i++) {
                var r = erRows[i];
                html += '<tr>' +
                    '<td>' + (i + 1) + '</td>' +
                    '<td>' + erEsc(r[0]) + '</td>' +
                    '<td>' + erEsc(r[1]) + '</td>' +
                    '<td>' + erEsc(r[2]) + '</td>' +
                    '<td>' + erEsc(r[3]) + '</td>' +
                    '<td>' + erEsc(r[4]) + '</td>' +
                    '<td class="text-center">' + erEsc(r[5]) + ' °C</td>' +
                    '<td class="text-center">' + erEsc(r[6]) + ' %</td>' +
                    '<td class="text-center">' + erDoorBadge(r[7]) + '</td>' +
                    '</tr>';
            }
            tbody.innerHTML = html;          // one DOM write per page

            $('#showingFrom').text(totalRows > 0 ? start + 1 : 0);
            $('#showingTo').text(end);
            renderPagination();
        }

        function renderPagination() {
            var $pager = $('#pager');
            $pager.find('.page-number').remove();
            $('#prevBtn').toggleClass('disabled', currentPage <= 1);
            $('#nextBtn').toggleClass('disabled', currentPage >= totalPages);

            var $nextBtn = $('#nextBtn');
            var pagesToShow = [];
            if (totalPages <= 7) {
                for (var i = 1; i <= totalPages; i++) pagesToShow.push(i);
            } else {
                pagesToShow.push(1);
                if (currentPage > 3) pagesToShow.push('...');
                for (var i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
                    if (pagesToShow.indexOf(i) === -1) pagesToShow.push(i);
                }
                if (currentPage < totalPages - 2) pagesToShow.push('...');
                if (pagesToShow.indexOf(totalPages) === -1) pagesToShow.push(totalPages);
            }
            var html = '';
            for (var j = 0; j < pagesToShow.length; j++) {
                var p = pagesToShow[j];
                if (p === '...') {
                    html += '<li class="page-item page-number disabled"><span class="page-link">...</span></li>';
                } else {
                    html += '<li class="page-item page-number ' + (p === currentPage ? 'active' : '') + '">' +
                        '<a class="page-link" href="javascript:void(0);" onclick="goToPage(' + p + ')">' + p + '</a></li>';
                }
            }
            $(html).insertBefore($nextBtn);
        }

        window.changePage = function (direction) {
            if (direction === 'prev' && currentPage > 1) showPage(currentPage - 1);
            else if (direction === 'next' && currentPage < totalPages) showPage(currentPage + 1);
        };
        window.goToPage = function (page) { showPage(page); };
    })();

    // Math.min.apply / Math.max.apply crash ("Maximum call stack size exceeded")
    // when an array has ~1 lakh+ values, so use a simple loop instead.
    function erArrMin(a) { var m = Infinity; for (var i = 0; i < a.length; i++) if (a[i] < m) m = a[i]; return m; }
    function erArrMax(a) { var m = -Infinity; for (var i = 0; i < a.length; i++) if (a[i] > m) m = a[i]; return m; }

    // Rows for Excel / CSV / PDF — built from the in-memory array, not the DOM
    function erGetExportRows() {
        var out = new Array(erRows.length);
        for (var i = 0; i < erRows.length; i++) {
            var r = erRows[i];
            out[i] = [
                String(i + 1), r[0] || '', r[1] || '', r[2] || '', r[3] || '', r[4] || '',
                ((r[5] || '') + ' °C').trim(), ((r[6] || '') + ' %').trim(), r[7] || ''
            ];
        }
        return out;
    }

    var erExportHeaders = ['Sr.No', 'Zone', 'Division', 'Station', 'Date & Time',
        'Equipment Room Type', 'Temperature(°C)', 'Humidity(%)', '(Open/Close)'];

    // ==========================================================================
    // CHART COLORS & GLOBALS
    // ==========================================================================
    var erChartColors = [
        '#6366f1', '#8b5cf6', '#ec4899', '#f43f5e', '#f97316',
        '#eab308', '#22c55e', '#14b8a6', '#06b6d4', '#3b82f6',
        '#a855f7', '#d946ef', '#f59e0b', '#84cc16', '#0ea5e9',
        '#e11d48', '#7c3aed', '#059669', '#dc2626', '#2563eb'
    ];
    var erChart = null;
    if (typeof erSelectedView === 'undefined') erSelectedView = 'Table';



    function selectErView(el) {
        var $el = $(el);
        $('#erViewDropdown .er-view-item').removeClass('checked');
        $el.addClass('checked');

        erSelectedView = $el.data('value');
        var icon = $el.find('i').prop('outerHTML');
        var label = $el.find('span').text();
        $('#erViewBtn > span').html(icon + ' ' + label);
        $('#erViewDropdown').removeClass('open');
        $('#erViewBtn').removeClass('active');

        renderErView();
    }

    // ==========================================================================
    // EXTRACT TABLE DATA — reads from #tblEquipmentRoom
    // Columns: 0=Sr.No, 1=Zone, 2=Division, 3=Station, 4=DateTime,
    //          5=RoomType, 6=Temperature, 7=Humidity, 8=Relay
    // ==========================================================================
    function extractEquipmentRoomData() {
        var data = {
            rows: [],
            stationGroups: {},
            roomGroups: {},
            totalTemp: 0, totalHum: 0,
            tempCount: 0, humCount: 0,
            openCount: 0, closeCount: 0
        };

        for (var i = 0; i < erRows.length; i++) {
            var src = erRows[i];
            var station = src[2] || '';
            var dateTime = src[3] || '';
            var room = src[4] || '';

            var tempRaw = String(src[5] || '').replace(/,/g, '').trim();
            var temp = parseFloat(tempRaw);
            var hasTemp = !isNaN(temp) && tempRaw !== '' && tempRaw !== '-';

            var humRaw = String(src[6] || '').replace(/,/g, '').trim();
            var hum = parseFloat(humRaw);
            var hasHum = !isNaN(hum) && humRaw !== '' && humRaw !== '-';

            var relayText = String(src[7] || '').toLowerCase();

            data.rows.push({
                station: station,
                dateTime: dateTime,
                room: room,
                temperature: hasTemp ? temp : null,
                humidity: hasHum ? hum : null,
                relay: relayText
            });

            // --- Aggregate by Station ---
            if (!data.stationGroups[station]) {
                data.stationGroups[station] = { tempValues: [], humValues: [], dates: [], rooms: [] };
            }
            var sg = data.stationGroups[station];
            if (hasTemp) { sg.tempValues.push(temp); data.totalTemp += temp; data.tempCount++; }
            if (hasHum) { sg.humValues.push(hum); data.totalHum += hum; data.humCount++; }
            sg.dates.push(dateTime);
            if (sg.rooms.indexOf(room) === -1) sg.rooms.push(room);

            // --- Aggregate by Station + Room ---
            var roomKey = station + ' — ' + room;
            if (!data.roomGroups[roomKey]) {
                data.roomGroups[roomKey] = { tempValues: [], humValues: [], dates: [] };
            }
            var rg = data.roomGroups[roomKey];
            if (hasTemp) rg.tempValues.push(temp);
            if (hasHum) rg.humValues.push(hum);
            rg.dates.push(dateTime);

            // --- Relay counts ---
            if (relayText.indexOf('open') > -1) data.openCount++;
            else if (relayText.indexOf('close') > -1) data.closeCount++;
        }

        return data;
    }

    // ==========================================================================
    // SHARED HELPERS
    // ==========================================================================
    var erChartColors = [
        '#6366f1', '#3b82f6', '#22c55e', '#f43f5e', '#f97316',
        '#eab308', '#14b8a6', '#8b5cf6', '#ec4899', '#06b6d4',
        '#a855f7', '#d946ef', '#f59e0b', '#84cc16', '#0ea5e9',
        '#e11d48', '#7c3aed', '#059669', '#dc2626', '#2563eb'
    ];
    var erChart = null;

    function erHexToRgba(hex, alpha) {
        hex = hex.replace('#', '');
        return 'rgba(' +
            parseInt(hex.substring(0, 2), 16) + ',' +
            parseInt(hex.substring(2, 4), 16) + ',' +
            parseInt(hex.substring(4, 6), 16) + ',' + alpha + ')';
    }

    // Theme palette from Energy7 tokens (canvas charts cannot read var())
    function erTheme() {
        var cs = getComputedStyle(document.documentElement);
        var v = function (n, fb) { var x = cs.getPropertyValue(n); return x && x.trim() ? x.trim() : fb; };
        return {
            surface: v('--e7-surface', '#fff'), surface2: v('--e7-surface-2', '#f6f8fa'), border: v('--e7-border', '#e7ebf1'),
            grid: v('--e7-grid-line', '#eef2f7'), text: v('--e7-text', '#22303f'), text2: v('--e7-text-2', '#55657a'),
            text3: v('--e7-text-3', '#627186'), heading: v('--e7-heading', '#1b3c55')
        };
    }

    // Creates a titled canvas inside #erChartContainer and returns the 2D context
    function erCreateCanvas(title, iconClass, height) {
        height = height || 400;
        var $container = $('#erChartContainer').empty();
        var $box = $('<div></div>').css({
            padding: '20px', background: 'var(--e7-surface, #fff)', border: '1px solid var(--e7-border, transparent)',
            borderRadius: '12px', boxShadow: 'var(--e7-shadow-card, 0 2px 12px rgba(0,0,0,0.07))', margin: '10px 0'
        });
        $box.append(
            '<h5 style="margin:0 0 16px; font-size:15px; font-weight:600; color:var(--e7-heading, #1e293b);">' +
            '<i class="' + iconClass + ' mr-2" style="color:var(--e7-accent, #6366f1);"></i>' + title + '</h5>'
        );
        var $wrapper = $('<div></div>').css({ position: 'relative', height: height + 'px', width: '100%' });
        var $canvas = $('<canvas id="erCanvas"></canvas>');
        $wrapper.append($canvas);
        $box.append($wrapper);
        $container.append($box);
        return $canvas[0].getContext('2d');
    }

    function renderErNoData() {
        $('#erChartContainer').html(
            '<div style="height:300px;display:flex;flex-direction:column;align-items:center;' +
            'justify-content:center;color:var(--e7-text-3, #94a3b8);font-size:15px;">' +
            '<i class="fas fa-chart-pie" style="font-size:44px;margin-bottom:12px;color:var(--e7-text-4, #cbd5e1);"></i>' +
            '<p style="margin:0;">No data available for visualization.</p></div>'
        );
    }

    // ==========================================================================
    // BAR CHART — Station-wise: separate bar chart per station with pagination
    // ==========================================================================
    var erBarPageSize = 6;
    var erBarStationState = {};   // { stationName: { page, rows, chartInstance } }
    var erBarStationCharts = [];  // all chart instances for cleanup

    function renderErBarChart(data) {
        // Destroy previous charts
        erBarStationCharts.forEach(function (c) { try { c.destroy(); } catch (e) { } });
        erBarStationCharts = [];
        erBarStationState = {};
        if (erChart) { erChart.destroy(); erChart = null; }

        if (data.rows.length === 0) { renderErNoData(); return; }

        // Group rows by station
        var stationOrder = [];
        var stationRows = {};
        data.rows.forEach(function (r) {
            if (!stationRows[r.station]) { stationRows[r.station] = []; stationOrder.push(r.station); }
            stationRows[r.station].push(r);
        });

        var $container = $('#erChartContainer').empty();

        // Build a section for each station
        stationOrder.forEach(function (station, sIdx) {
            var rows = stationRows[station];
            var stKey = 'barSt_' + sIdx;
            erBarStationState[stKey] = { page: 1, rows: rows, chart: null };

            var stColor = erChartColors[sIdx % erChartColors.length];

            var $box = $('<div></div>').attr('id', 'barBox_' + stKey).css({
                padding: '20px', background: 'var(--e7-surface, #fff)', border: '1px solid var(--e7-border, transparent)',
                borderRadius: '12px', boxShadow: 'var(--e7-shadow-card, 0 2px 12px rgba(0,0,0,0.07))',
                margin: '10px 0', borderLeft: '4px solid ' + stColor
            });

            $box.append(
                '<h5 style="margin:0 0 4px;font-size:15px;font-weight:600;color:var(--e7-heading, #1e293b);">' +
                '<i class="fas fa-chart-bar mr-2" style="color:' + stColor + ';"></i>' +
                '<span style="color:' + stColor + ';">' + station + '</span>' +
                ' <span style="font-size:12px;font-weight:400;color:var(--e7-text-3, #64748b);">(' + rows.length + ' records)</span></h5>'
            );

            // Legend
            var $legendRow = $('<div></div>').css({
                display: 'flex', justifyContent: 'center',
                alignItems: 'center', margin: '10px 0 14px'
            });
            var $legend = $('<div></div>').css({ display: 'flex', gap: '18px', alignItems: 'center', flexWrap: 'wrap' });
            $legend.append(legendDot('#f9a8b8', 'Temperature'));
            $legend.append(legendDot('#a7e8c1', 'Humidity'));
            $legend.append(legendDot('#fcd9a8', 'Open/Close'));
            $legendRow.append($legend);
            $box.append($legendRow);

            // Canvas
            var canvasId = 'erCanvas_' + stKey;
            var $wrapper = $('<div></div>').css({ position: 'relative', height: '380px', width: '100%' });
            var $canvas = $('<canvas id="' + canvasId + '"></canvas>');
            $wrapper.append($canvas);
            $box.append($wrapper);

            // Pager
            var totalPages = Math.ceil(rows.length / erBarPageSize);
            if (totalPages > 1) {
                var $pagerRow = $('<div></div>').css({
                    display: 'flex', justifyContent: 'flex-end',
                    alignItems: 'center', marginTop: '16px',
                    paddingTop: '12px', borderTop: '1px solid var(--e7-border, #e2e8f0)'
                });
                $pagerRow.append(buildBarPagerForStation(stKey, totalPages));
                $box.append($pagerRow);
            }

            $container.append($box);

            // Draw first page
            drawBarPageForStation(stKey);
        });

        $('#dataInfo').html(
            '<i class="fas fa-chart-bar text-primary"></i> ' +
            stationOrder.length + ' station(s) · ' + data.rows.length + ' total record(s)'
        );
    }

    function legendDot(color, label) {
        return '<div style="display:flex;align-items:center;gap:6px;">' +
            '<span style="display:inline-block;width:14px;height:14px;border-radius:3px;background:' + color + ';"></span>' +
            '<span style="font-size:13px;color:var(--e7-text-2, #334155);">' + label + '</span></div>';
    }

    function buildBarPagerForStation(stKey, totalPages) {
        var state = erBarStationState[stKey];
        var $pager = $('<div></div>').attr('id', 'erBarPager_' + stKey).css({
            display: 'flex', alignItems: 'center', gap: '0', flexWrap: 'wrap'
        });

        $pager.append(
            '<div class="er-pg-btn er-pg-prev" onclick="erBarStPrev(\'' + stKey + '\')">' +
            '<i class="fas fa-chevron-left" style="font-size:10px;margin-right:4px;"></i> Prev</div>'
        );

        var pages = buildPageNumbers(state.page, totalPages);
        pages.forEach(function (p) {
            if (p === '...') {
                $pager.append('<div class="er-pg-btn disabled" style="cursor:default;min-width:36px;">…</div>');
            } else {
                $pager.append(
                    '<div class="er-pg-btn er-pg-num' + (p === state.page ? ' active' : '') + '" ' +
                    'onclick="erBarStGoTo(\'' + stKey + '\',' + p + ')">' + p + '</div>'
                );
            }
        });

        $pager.append(
            '<div class="er-pg-btn er-pg-next" onclick="erBarStNext(\'' + stKey + '\')">' +
            'Next <i class="fas fa-chevron-right" style="font-size:10px;margin-left:4px;"></i></div>'
        );

        return $pager;
    }

    function buildPageNumbers(currentPage, totalPages) {
        var pages = [];
        if (totalPages <= 7) {
            for (var i = 1; i <= totalPages; i++) pages.push(i);
            return pages;
        }
        pages.push(1);
        if (totalPages > 1) pages.push(2);
        if (currentPage > 4) pages.push('...');
        var start = Math.max(3, currentPage - 1);
        var end = Math.min(totalPages - 2, currentPage + 1);
        for (var i = start; i <= end; i++) {
            if (pages.indexOf(i) === -1) pages.push(i);
        }
        if (currentPage < totalPages - 3) pages.push('...');
        if (totalPages - 1 > 2 && pages.indexOf(totalPages - 1) === -1) pages.push(totalPages - 1);
        if (pages.indexOf(totalPages) === -1) pages.push(totalPages);
        return pages;
    }

    function erBarStPrev(stKey) {
        var st = erBarStationState[stKey];
        if (st.page > 1) { st.page--; drawBarPageForStation(stKey); }
    }
    function erBarStNext(stKey) {
        var st = erBarStationState[stKey];
        var totalPages = Math.ceil(st.rows.length / erBarPageSize);
        if (st.page < totalPages) { st.page++; drawBarPageForStation(stKey); }
    }
    function erBarStGoTo(stKey, page) {
        erBarStationState[stKey].page = page;
        drawBarPageForStation(stKey);
    }

    function drawBarPageForStation(stKey) {
        var _t = erTheme();
        var state = erBarStationState[stKey];
        if (state.chart) { state.chart.destroy(); state.chart = null; }

        var rows = state.rows;
        var totalPages = Math.ceil(rows.length / erBarPageSize);
        var startIdx = (state.page - 1) * erBarPageSize;
        var pageRows = rows.slice(startIdx, startIdx + erBarPageSize);

        // Rebuild pager UI
        var $pagerContainer = $('#erBarPager_' + stKey);
        if ($pagerContainer.length) {
            $pagerContainer.replaceWith(buildBarPagerForStation(stKey, totalPages));
        }

        var labels = [];
        var tempValues = [], humValues = [], relayValues = [];
        var relayLabels = [];

        pageRows.forEach(function (row) {
            labels.push([row.dateTime, row.room]);

            tempValues.push(row.temperature !== null ? row.temperature : 0);
            humValues.push(row.humidity !== null ? row.humidity : 0);

            var relayText = (row.relay || '').toLowerCase();
            if (relayText.indexOf('open') > -1) {
                relayValues.push(5);
                relayLabels.push('Open');
            } else if (relayText.indexOf('close') > -1) {
                relayValues.push(5);
                relayLabels.push('Close');
            } else {
                relayValues.push(0);
                relayLabels.push('');
            }
        });

        // Per-bar colors for Open/Close
        var relayBgColors = [];
        var relayBorderColors = [];
        relayLabels.forEach(function (lbl) {
            if (lbl === 'Open') {
                relayBgColors.push('rgba(134,239,172,0.75)');
                relayBorderColors.push('#22c55e');
            } else if (lbl === 'Close') {
                relayBgColors.push('rgba(252,217,168,0.75)');
                relayBorderColors.push('#fbbf24');
            } else {
                relayBgColors.push('rgba(226,232,240,0.5)');
                relayBorderColors.push('#cbd5e1');
            }
        });

        var canvasId = 'erCanvas_' + stKey;
        var ctx = document.getElementById(canvasId).getContext('2d');

        // ── Custom plugin: data labels on top of bars ──
        var dataLabelPlugin = {
            id: 'erBarDataLabels',
            afterDatasetsDraw: function (chart) {
                var ctx2 = chart.ctx;
                ctx2.save();
                ctx2.font = '600 10px "Segoe UI", sans-serif';
                ctx2.textAlign = 'center';
                ctx2.textBaseline = 'bottom';

                chart.data.datasets.forEach(function (dataset, dsIndex) {
                    var meta = chart.getDatasetMeta(dsIndex);
                    meta.data.forEach(function (bar, index) {
                        var value = dataset.data[index];
                        if (value === 0 || value === null) return;

                        var label = '';
                        if (dsIndex === 0) {
                            // Temperature
                            label = value.toFixed(1) + '°C';
                            ctx2.fillStyle = '#dc2626';
                        } else if (dsIndex === 1) {
                            // Humidity
                            label = value.toFixed(1) + '%';
                            ctx2.fillStyle = '#047857';
                        } else if (dsIndex === 2) {
                            // Relay — show Open/Close text
                            label = relayLabels[index] || '';
                            ctx2.fillStyle = relayLabels[index] === 'Open' ? '#15803d' : '#92400e';
                        }

                        if (label) {
                            ctx2.fillText(label, bar.x, bar.y - 4);
                        }
                    });
                });
                ctx2.restore();
            }
        };

        state.chart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Temperature (°C)',
                        data: tempValues,
                        backgroundColor: 'rgba(249,168,184,0.7)',
                        borderColor: '#f472b6',
                        borderWidth: 1,
                        borderRadius: 4,
                        barPercentage: 0.8,
                        categoryPercentage: 0.65
                    },
                    {
                        label: 'Humidity (%)',
                        data: humValues,
                        backgroundColor: 'rgba(167,232,193,0.7)',
                        borderColor: '#4ade80',
                        borderWidth: 1,
                        borderRadius: 4,
                        barPercentage: 0.8,
                        categoryPercentage: 0.65
                    },
                    {
                        label: 'Open/Close',
                        data: relayValues,
                        backgroundColor: relayBgColors,
                        borderColor: relayBorderColors,
                        borderWidth: 1,
                        borderRadius: 4,
                        barPercentage: 0.8,
                        categoryPercentage: 0.65
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                layout: { padding: { top: 24 } },
                plugins: {
                    legend: { display: false },    // we use custom legend above
                    tooltip: {
                        backgroundColor: _t.surface,
                        titleColor: _t.heading,
                        bodyColor: _t.text,
                        borderColor: _t.border,
                        borderWidth: 1,
                        padding: 14,
                        cornerRadius: 8,
                        boxShadow: '0 4px 12px rgba(0,0,0,0.12)',
                        titleFont: { size: 13, weight: '700' },
                        bodyFont: { size: 12 },
                        displayColors: false,
                        callbacks: {
                            title: function (items) {
                                if (!items.length) return '';
                                var idx = items[0].dataIndex;
                                var row = pageRows[idx];
                                return row.dateTime + '\n' + row.station + '\n' + row.room;
                            },
                            label: function () { return ''; },   // suppress default
                            afterBody: function (items) {
                                if (!items.length) return [];
                                var idx = items[0].dataIndex;
                                var row = pageRows[idx];
                                var lines = [];
                                lines.push('───────────────────');
                                lines.push('Temp     : ' + (row.temperature !== null ? row.temperature.toFixed(2) + ' °C' : '—'));
                                lines.push('Humidity : ' + (row.humidity !== null ? row.humidity.toFixed(2) + ' %' : '—'));

                                var doorVal = '—';
                                if (row.relay.indexOf('open') > -1) doorVal = 'Open';
                                else if (row.relay.indexOf('close') > -1) doorVal = 'Close';
                                lines.push('Door     : ' + doorVal);
                                lines.push('Room     : ' + row.room);
                                return lines;
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: {
                            font: { size: 10, weight: '500' },
                            color: _t.text2,
                            maxRotation: 0,
                            minRotation: 0,
                            autoSkip: false
                        }
                    },
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Value',
                            font: { size: 12, weight: '600' },
                            color: _t.text3
                        },
                        grid: { color: _t.grid },
                        ticks: { font: { size: 11 }, color: _t.text3 }
                    }
                }
            },
            plugins: [dataLabelPlugin]
        });

        erBarStationCharts.push(state.chart);
    }

    // ==========================================================================
    // PIE CHART — Multi-day bucketed pies with rich popup detail
    // ==========================================================================
    var erPieCharts = [];   // hold chart instances so we can destroy on re-render
    var erPieTipEl = null;  // floating popup element

    function ensureErPieTip() {
        if (erPieTipEl) return;
        erPieTipEl = document.createElement('div');
        erPieTipEl.id = 'erPieTip';
        erPieTipEl.style.cssText =
            'position:fixed;display:none;z-index:99999;background:var(--e7-surface, #fff);' +
            'border:0.5px solid var(--e7-border-2, #cbd5e1);border-radius:10px;padding:0;' +
            'min-width:265px;max-width:310px;box-shadow:var(--e7-shadow-pop, 0 4px 20px rgba(0,0,0,0.14));' +
            'pointer-events:none;font-family:inherit;';
        erPieTipEl.innerHTML =
            '<div id="erPieTipHead" style="padding:10px 14px 8px;border-bottom:0.5px solid var(--e7-border, #e2e8f0);">' +
            '<p id="erPieTipTitle" style="font-size:13px;font-weight:500;color:var(--e7-heading, #0f172a);margin:0 0 2px;">—</p>' +
            '<p id="erPieTipSub" style="font-size:10.5px;color:var(--e7-text-3, #64748b);margin:0;">—</p>' +
            '</div>' +
            '<div id="erPieTipBody" style="padding:8px 14px;"></div>' +
            '<div id="erPieTipFoot" style="padding:5px 14px 9px;border-top:0.5px solid var(--e7-border, #e2e8f0);font-size:10px;color:var(--e7-text-3, #64748b);line-height:1.4;"></div>';
        document.body.appendChild(erPieTipEl);

        document.addEventListener('mousemove', function (e) {
            if (erPieTipEl.style.display !== 'block') return;
            var left = e.clientX + 16, top = e.clientY - 160;
            if (left + 310 > window.innerWidth - 10) left = e.clientX - 320;
            if (top < 10) top = 10;
            erPieTipEl.style.left = left + 'px';
            erPieTipEl.style.top = top + 'px';
        });
    }

    function showErPieTip(slice, type, x, y) {
        ensureErPieTip();
        document.getElementById('erPieTipTitle').textContent = slice.label;
        document.getElementById('erPieTipSub').textContent = slice.count + ' readings · ' + slice.pct + ' of total';
        var rowFn = function (k, v) {
            return '<div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:0.5px solid var(--e7-border, #e2e8f0);">' +
                '<span style="color:var(--e7-text-3, #64748b);font-size:10.5px;">' + k + '</span>' +
                '<span style="font-weight:500;color:var(--e7-heading, #0f172a);font-size:11px;text-align:right;max-width:60%;word-break:break-word;">' + v + '</span></div>';
        };
        var html = rowFn('Count', slice.count) + rowFn('Share', slice.pct);
        if (type === 'temp') {
            html += rowFn('Avg value', slice.avg || '—');
            html += rowFn('Range', slice.range || '—');
            html += rowFn('Time window', slice.time || '—');
            html += rowFn('Humidity', slice.hum || '—');
            html += rowFn('Door status', slice.door || '—');
        } else if (type === 'hum') {
            html += rowFn('Avg value', slice.avg || '—');
            html += rowFn('Time window', slice.time || '—');
            html += rowFn('Temperature', slice.temp || '—');
            html += rowFn('Door status', slice.door || '—');
        } else {
            html += rowFn('Time window', slice.time || '—');
            html += rowFn('Temperature', slice.temp || '—');
            html += rowFn('Humidity', slice.hum || '—');
        }
        document.getElementById('erPieTipBody').innerHTML = html;
        document.getElementById('erPieTipFoot').textContent = slice.ts || '';

        var left = x + 16, top = y - 160;
        if (left + 310 > window.innerWidth - 10) left = x - 320;
        if (top < 10) top = 10;
        erPieTipEl.style.left = left + 'px';
        erPieTipEl.style.top = top + 'px';
        erPieTipEl.style.display = 'block';
    }

    function hideErPieTip() {
        if (erPieTipEl) erPieTipEl.style.display = 'none';
    }

    // ---- Bucket helpers ---------------------------------------------------
    function bucketTemp(t) {
        if (t === 0) return { key: '0', label: '0°C (Sensor / Init)', color: '#888780', order: 0 };
        if (t < 10) return { key: '4-5', label: '< 10°C (Very low)', color: '#7f77dd', order: 1 };
        if (t < 30) return { key: '20', label: '10–30°C (Low)', color: '#378add', order: 2 };
        if (t < 44) return { key: '43', label: '30–44°C (Moderate)', color: '#fac775', order: 3 };
        if (t < 50) return { key: '45', label: '44–50°C (Warm)', color: '#f09565', order: 4 };
        return { key: '52', label: '50°C+ (Hot)', color: '#e24b4a', order: 5 };
    }
    function bucketHum(h) {
        // Accept 0.25 / 25 / 0.5237 etc. Normalize to 0–100 %.
        var v = h > 1.5 ? h : h * 100;
        if (v < 30) return { key: 'low', label: '< 30% (Low)', color: '#fac775', order: 0 };
        if (v < 60) return { key: 'mid', label: '30–60% (Medium)', color: '#1d9e75', order: 1 };
        return { key: 'high', label: '60%+ (High)', color: '#378add', order: 2 };
    }
    function fmtTime(dt) {
        // dt is a string like '09/06/2026 15:18:16'
        var parts = String(dt).split(' ');
        return parts.length > 1 ? parts[1] : dt;
    }
    function dateOf(dt) {
        var parts = String(dt).split(' ');
        return parts[0] || dt;
    }
    function fmtNum(n, d) { return (n === null || isNaN(n)) ? '—' : (+n).toFixed(d == null ? 2 : d); }

    // ---- Build slices from a list of rows for one room type --------------
    function buildSlicesForRoom(rows) {
        // TEMPERATURE
        var tempMap = {};
        rows.forEach(function (r) {
            if (r.temperature === null) return;
            var b = bucketTemp(r.temperature);
            if (!tempMap[b.key]) tempMap[b.key] = { label: b.label, color: b.color, order: b.order, count: 0, values: [], hums: {}, doors: {}, times: [] };
            var s = tempMap[b.key];
            s.count++;
            s.values.push(r.temperature);
            s.times.push(fmtTime(r.dateTime));
            if (r.humidity !== null) {
                var hb = bucketHum(r.humidity);
                s.hums[hb.label] = (s.hums[hb.label] || 0) + 1;
            }
            var dk = r.relay && r.relay.indexOf('open') > -1 ? 'Open' : (r.relay && r.relay.indexOf('close') > -1 ? 'Close' : 'Unknown');
            s.doors[dk] = (s.doors[dk] || 0) + 1;
        });
        var tempSlices = Object.keys(tempMap).map(function (k) {
            var s = tempMap[k];
            var minV = erArrMin(s.values);
            var maxV = erArrMax(s.values);
            var avgV = s.values.reduce(function (a, b) { return a + b; }, 0) / s.values.length;
            return {
                _order: s.order, label: s.label, count: s.count, color: s.color,
                avg: fmtNum(avgV) + '°C',
                range: fmtNum(minV) + ' – ' + fmtNum(maxV) + '°C',
                time: s.times[s.times.length - 1] + ' – ' + s.times[0],
                hum: Object.keys(s.hums).map(function (k) { return k + ' (' + s.hums[k] + ')'; }).join(', ') || '—',
                door: Object.keys(s.doors).map(function (k) { return k + ' (' + s.doors[k] + ')'; }).join(', ') || '—',
                ts: s.times.slice(0, 12).join(', ') + (s.times.length > 12 ? ' …+' + (s.times.length - 12) + ' more' : '')
            };
        });
        tempSlices.sort(function (a, b) { return b._order - a._order; });

        // HUMIDITY
        var humMap = {};
        rows.forEach(function (r) {
            if (r.humidity === null) return;
            var b = bucketHum(r.humidity);
            if (!humMap[b.key]) humMap[b.key] = { label: b.label, color: b.color, order: b.order, count: 0, values: [], temps: [], doors: {}, times: [] };
            var s = humMap[b.key];
            s.count++;
            s.values.push(r.humidity);
            s.times.push(fmtTime(r.dateTime));
            if (r.temperature !== null) s.temps.push(r.temperature);
            var dk = r.relay && r.relay.indexOf('open') > -1 ? 'Open' : (r.relay && r.relay.indexOf('close') > -1 ? 'Close' : 'Unknown');
            s.doors[dk] = (s.doors[dk] || 0) + 1;
        });
        var humSlices = Object.keys(humMap).map(function (k) {
            var s = humMap[k];
            var avgV = s.values.reduce(function (a, b) { return a + b; }, 0) / s.values.length;
            var displayAvg = avgV > 1.5 ? fmtNum(avgV) + '%' : fmtNum(avgV * 100) + '%';
            var tempRange = '—';
            if (s.temps.length) {
                tempRange = fmtNum(erArrMin(s.temps)) + ' – ' + fmtNum(erArrMax(s.temps)) + '°C';
            }
            return {
                _order: s.order, label: s.label, count: s.count, color: s.color,
                avg: displayAvg,
                time: s.times[s.times.length - 1] + ' – ' + s.times[0],
                temp: tempRange,
                door: Object.keys(s.doors).map(function (k) { return k + ' (' + s.doors[k] + ')'; }).join(', ') || '—',
                ts: s.times.slice(0, 12).join(', ') + (s.times.length > 12 ? ' …+' + (s.times.length - 12) + ' more' : '')
            };
        });
        humSlices.sort(function (a, b) { return a._order - b._order; });

        // DOOR (Open / Close)
        var doorMap = { Open: { count: 0, temps: [], hums: [], times: [] }, Close: { count: 0, temps: [], hums: [], times: [] } };
        rows.forEach(function (r) {
            var dk = r.relay && r.relay.indexOf('open') > -1 ? 'Open' : (r.relay && r.relay.indexOf('close') > -1 ? 'Close' : null);
            if (!dk) return;
            doorMap[dk].count++;
            doorMap[dk].times.push(fmtTime(r.dateTime));
            if (r.temperature !== null) doorMap[dk].temps.push(r.temperature);
            if (r.humidity !== null) doorMap[dk].hums.push(r.humidity);
        });
        var doorSlices = [];
        ['Close', 'Open'].forEach(function (k) {
            var d = doorMap[k];
            if (d.count === 0) return;
            var color = k === 'Close' ? '#1d9e75' : '#e24b4a';
            var tempRange = d.temps.length ? fmtNum(erArrMin(d.temps)) + '–' + fmtNum(erArrMax(d.temps)) + '°C' : '—';
            var humRange = '—';
            if (d.hums.length) {
                var mn = erArrMin(d.hums), mx = erArrMax(d.hums);
                var fmtH = function (v) { return v > 1.5 ? fmtNum(v) + '%' : fmtNum(v * 100) + '%'; };
                humRange = fmtH(mn) + ' – ' + fmtH(mx);
            }
            doorSlices.push({
                label: k, count: d.count, color: color,
                time: d.times[d.times.length - 1] + ' – ' + d.times[0],
                temp: tempRange, hum: humRange,
                ts: d.times.slice(0, 12).join(', ') + (d.times.length > 12 ? ' …+' + (d.times.length - 12) + ' more' : '')
            });
        });

        // Calculate percentages
        var totalT = tempSlices.reduce(function (a, s) { return a + s.count; }, 0);
        var totalH = humSlices.reduce(function (a, s) { return a + s.count; }, 0);
        var totalD = doorSlices.reduce(function (a, s) { return a + s.count; }, 0);
        tempSlices.forEach(function (s) { s.pct = totalT > 0 ? (s.count / totalT * 100).toFixed(1) + '%' : '0%'; });
        humSlices.forEach(function (s) { s.pct = totalH > 0 ? (s.count / totalH * 100).toFixed(1) + '%' : '0%'; });
        doorSlices.forEach(function (s) { s.pct = totalD > 0 ? (s.count / totalD * 100).toFixed(1) + '%' : '0%'; });

        return { temp: tempSlices, hum: humSlices, oc: doorSlices };
    }

    // ---- Render a single day's content (all room types) ------------------
    function renderErPieDay(dayKey, dayData, $container) {
        var _t = erTheme();
        $container.empty();

        // ── Temperature → heatmap color (matches relay_room_temperature_pie.html) ──
        function tempToColor(t) {
            var stops = [
                { v: 0, r: 136, g: 135, b: 128 },  // grey for 0 / sensor init
                { v: 10, r: 127, g: 119, b: 221 },
                { v: 18, r: 13, g: 71, b: 161 },
                { v: 22, r: 0, g: 131, b: 143 },
                { v: 25, r: 46, g: 125, b: 50 },
                { v: 28, r: 156, g: 204, b: 101 },
                { v: 30, r: 255, g: 235, b: 59 },
                { v: 32, r: 255, g: 152, b: 0 },
                { v: 35, r: 244, g: 67, b: 54 },
                { v: 40, r: 211, g: 47, b: 47 },
                { v: 45, r: 183, g: 28, b: 28 }
            ];
            if (t <= stops[0].v) return 'rgb(' + stops[0].r + ',' + stops[0].g + ',' + stops[0].b + ')';
            if (t >= stops[stops.length - 1].v) return 'rgb(' + stops[stops.length - 1].r + ',' + stops[stops.length - 1].g + ',' + stops[stops.length - 1].b + ')';
            for (var i = 0; i < stops.length - 1; i++) {
                if (t >= stops[i].v && t <= stops[i + 1].v) {
                    var f = (t - stops[i].v) / (stops[i + 1].v - stops[i].v);
                    return 'rgb(' +
                        Math.round(stops[i].r + f * (stops[i + 1].r - stops[i].r)) + ',' +
                        Math.round(stops[i].g + f * (stops[i + 1].g - stops[i].g)) + ',' +
                        Math.round(stops[i].b + f * (stops[i + 1].b - stops[i].b)) + ')';
                }
            }
            return '#888';
        }

        // ── Humidity → blue gradient ──
        function humToColor(h) {
            var v = h > 1.5 ? h : h * 100;
            if (v < 20) return 'rgb(255,245,157)';
            if (v < 40) return 'rgb(129,212,250)';
            if (v < 60) return 'rgb(30,136,229)';
            if (v < 80) return 'rgb(13,71,161)';
            return 'rgb(1,35,100)';
        }

        Object.keys(dayData.rooms).forEach(function (roomType, rtIdx) {
            var rows = dayData.rooms[roomType];

            // Stats
            var tempVals = rows.map(function (r) { return r.temperature; }).filter(function (v) { return v !== null && v > 0; });
            var humVals = rows.map(function (r) { return r.humidity; }).filter(function (v) { return v !== null; });
            var openCount = rows.filter(function (r) { return r.relay && r.relay.indexOf('open') > -1; }).length;
            var closeCount = rows.filter(function (r) { return r.relay && r.relay.indexOf('close') > -1; }).length;
            // Door section (stat cards + pie) is shown ONLY when door data exists
            var hasDoorData = (openCount + closeCount) > 0;
            var avgT = tempVals.length ? (tempVals.reduce(function (a, b) { return a + b; }, 0) / tempVals.length).toFixed(2) + '°C' : '—';
            var avgH = humVals.length
                ? ((humVals.reduce(function (a, b) { return a + b; }, 0) / humVals.length) > 1.5
                    ? (humVals.reduce(function (a, b) { return a + b; }, 0) / humVals.length).toFixed(2) + '%'
                    : ((humVals.reduce(function (a, b) { return a + b; }, 0) / humVals.length) * 100).toFixed(2) + '%')
                : '—';

            var $box = $('<div></div>').css({
                padding: '20px', background: 'var(--e7-surface, #fff)', border: '1px solid var(--e7-border, transparent)', borderRadius: '12px',
                boxShadow: 'var(--e7-shadow-card, 0 2px 12px rgba(0,0,0,0.08))', marginBottom: '20px'
            });

            // Section title
            $box.append(
                '<div style="font-size:15px;font-weight:600;color:var(--e7-heading, #1e293b);border-bottom:2px solid var(--e7-border, #e5e7eb);' +
                'padding-bottom:10px;margin-bottom:16px;">' +
                '<i class="fas fa-door-open mr-2" style="color:var(--e7-accent, #6366f1);font-size:13px;"></i>' +
                roomType + '</div>'
            );

            // Stat cards
            var $stats = $('<div></div>').css({
                display: 'grid', gridTemplateColumns: 'repeat(auto-fit,minmax(110px,1fr))',
                gap: '8px', marginBottom: '18px'
            });
            var statCards = [
                { label: 'Total records', val: rows.length, color: '#185fa5', bg: '#e6f1fb' },
                { label: 'Avg temp (valid)', val: avgT, color: '#a32d2d', bg: '#fcebeb' },
                { label: 'Avg humidity', val: avgH, color: '#185fa5', bg: '#e6f1fb' }
            ];
            if (hasDoorData) {
                statCards.push({ label: 'Close', val: closeCount, color: '#3b6d11', bg: '#eaf3de' });
                statCards.push({ label: 'Open', val: openCount, color: '#854f0b', bg: '#faeeda' });
            }
            statCards.forEach(function (c) {
                $stats.append(
                    '<div style="background:' + erHexToRgba(c.color, 0.12) + ';border-radius:8px;padding:8px 12px;text-align:center;">' +
                    '<div style="font-size:17px;font-weight:500;color:' + c.color + ';">' + c.val + '</div>' +
                    '<div style="font-size:10px;color:var(--e7-text-3, #64748b);margin-top:1px;">' + c.label + '</div>' +
                    '</div>'
                );
            });
            $box.append($stats);

            // ── 3 pie charts side by side ──
            var $row = $('<div></div>').css({
