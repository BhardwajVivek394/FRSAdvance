            var idHum = 'erPieH_' + dayKey + '_' + rtIdx;
            var idOC = 'erPieD_' + dayKey + '_' + rtIdx;

            // ── Temperature pie: one slice per reading, colored by heat gradient ──
            function makePieCard(title, icon, iconColor, canvasId, subtitle) {
                var $c = $('<div></div>').css({
                    background: 'var(--e7-surface-2, #f8fafc)', borderRadius: '10px', padding: '16px',
                    border: '1px solid var(--e7-border, #e5e7eb)'
                });
                $c.append(
                    '<div style="font-size:13px;font-weight:600;color:var(--e7-heading, #1e293b);margin-bottom:4px;text-align:center;">' +
                    '<i class="' + icon + ' mr-1" style="color:' + iconColor + ';"></i>' + title + '</div>'
                );
                if (subtitle) {
                    $c.append('<div style="font-size:11px;color:var(--e7-text-3, #94a3b8);text-align:center;margin-bottom:10px;">' + subtitle + '</div>');
                }
                $c.append('<div style="position:relative;width:100%;height:220px;"><canvas id="' + canvasId + '"></canvas></div>');
                return $c;
            }

            // Temperature card — gradient bar
            var minTemp = tempVals.length ? erArrMin(tempVals).toFixed(1) : '—';
            var maxTemp = tempVals.length ? erArrMax(tempVals).toFixed(1) : '—';
            var $tempCard = makePieCard('Temperature', 'fas fa-thermometer-half', '#f43f5e', idTemp, rows.length + ' readings · ' + minTemp + '°C – ' + maxTemp + '°C');

            // Add gradient scale bar below title
            var $gradBar = $('<div></div>').css({
                display: 'flex', alignItems: 'center', justifyContent: 'center',
                gap: '6px', marginBottom: '10px', marginTop: '-4px'
            });
            $gradBar.append('<span style="font-size:10px;color:var(--e7-text-3, #888);">' + (minTemp !== '—' ? minTemp + '°C' : '—') + '</span>');
            $gradBar.append('<div style="margin-top:10px;width:120px;height:10px;border-radius:5px;background:linear-gradient(to right,#0d47a1,#00838f,#2e7d32,#9ccc65,#ffeb3b,#ff9800,#f44336,#b71c1c);"></div>');
            $gradBar.append('<span style="font-size:10px;color:var(--e7-text-3, #888);">' + (maxTemp !== '—' ? maxTemp + '°C' : '—') + '</span>');
            $tempCard.append($gradBar);

            $row.append($tempCard);

            // Humidity card
            var $humCard = makePieCard('Humidity', 'fas fa-tint', '#3b82f6', idHum,
                rows.length + ' readings · avg ' + avgH);
            $row.append($humCard);

            // Door status card — append ONLY when door data exists
            // (grid is auto-fit, so Temperature & Humidity expand to fill the row)
            if (hasDoorData) {
                var $ocCard = makePieCard('Door Status', 'fas fa-door-open', '#22c55e', idOC,
                    'Open: ' + openCount + ' · Close: ' + closeCount);
                $row.append($ocCard);
            }

            $box.append($row);
            $container.append($box);

            // ── Draw Temperature pie: one slice per row, color = heatmap(temp) ──
            if (tempVals.length > 0) {
                var tempReadings = rows.filter(function (r) { return r.temperature !== null; });
                var ch1 = new Chart(document.getElementById(idTemp), {
                    type: 'pie',
                    data: {
                        labels: tempReadings.map(function (r) { return r.dateTime; }),
                        datasets: [{
                            data: tempReadings.map(function () { return 1; }),
                            backgroundColor: tempReadings.map(function (r) { return tempToColor(r.temperature); }),
                            borderWidth: 0,
                            hoverOffset: 10
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: 'rgba(0,0,0,0.85)',
                                padding: 10, cornerRadius: 8,
                                titleFont: { size: 13, weight: '500' },
                                bodyFont: { size: 12 },
                                callbacks: {
                                    title: function (items) { return tempReadings[items[0].dataIndex].dateTime; },
                                    label: function (c) {
                                        var r = tempReadings[c.dataIndex];
                                        return [
                                            'Temperature: ' + r.temperature + '°C',
                                            'Door: ' + (r.relay && r.relay.indexOf('open') > -1 ? 'Open' : r.relay && r.relay.indexOf('close') > -1 ? 'Close' : '—')
                                        ];
                                    }
                                }
                            }
                        }
                    }
                });
                erPieCharts.push(ch1);
            } else {
                $('#' + idTemp).parent().html('<div style="text-align:center;color:var(--e7-text-3, #94a3b8);padding-top:70px;font-size:13px;">No temperature data</div>');
            }

            // ── Draw Humidity pie: one slice per row, color = blue gradient ──
            var humReadings = rows.filter(function (r) { return r.humidity !== null; });
            if (humReadings.length > 0) {
                var ch2 = new Chart(document.getElementById(idHum), {
                    type: 'pie',
                    data: {
                        labels: humReadings.map(function (r) { return r.dateTime; }),
                        datasets: [{
                            data: humReadings.map(function () { return 1; }),
                            backgroundColor: humReadings.map(function (r) { return humToColor(r.humidity); }),
                            borderWidth: 0,
                            hoverOffset: 10
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: 'rgba(0,0,0,0.85)',
                                padding: 10, cornerRadius: 8,
                                callbacks: {
                                    title: function (items) { return humReadings[items[0].dataIndex].dateTime; },
                                    label: function (c) {
                                        var r = humReadings[c.dataIndex];
                                        var hv = r.humidity > 1.5 ? r.humidity.toFixed(2) + '%' : (r.humidity * 100).toFixed(2) + '%';
                                        return [
                                            'Humidity: ' + hv,
                                            'Door: ' + (r.relay && r.relay.indexOf('open') > -1 ? 'Open' : r.relay && r.relay.indexOf('close') > -1 ? 'Close' : '—')
                                        ];
                                    }
                                }
                            }
                        }
                    }
                });
                erPieCharts.push(ch2);
            } else {
                $('#' + idHum).parent().html('<div style="text-align:center;color:var(--e7-text-3, #94a3b8);padding-top:70px;font-size:13px;">No humidity data</div>');
            }

            // ── Draw Door pie: Open/Close with green/orange ──
            var doorData = [
                { label: 'Open', count: openCount, color: 'rgba(34,197,94,0.8)' },
                { label: 'Close', count: closeCount, color: 'rgba(245,158,11,0.8)' }
            ].filter(function (d) { return d.count > 0; });

            if (hasDoorData && doorData.length > 0) {
                var ch3 = new Chart(document.getElementById(idOC), {
                    type: 'pie',
                    data: {
                        labels: doorData.map(function (d) { return d.label; }),
                        datasets: [{
                            data: doorData.map(function (d) { return d.count; }),
                            backgroundColor: doorData.map(function (d) { return d.color; }),
                            borderWidth: 0,
                            hoverOffset: 10
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: true, position: 'bottom',
                                labels: { color: _t.text2, padding: 12, usePointStyle: true, font: { size: 11 } }
                            },
                            tooltip: {
                                backgroundColor: 'rgba(0,0,0,0.85)',
                                padding: 10, cornerRadius: 8,
                                callbacks: {
                                    label: function (c) {
