                            left: { style: 'thin', color: { argb: 'FFE2E8F0' } },
                            bottom: { style: 'thin', color: { argb: 'FFE2E8F0' } },
                            right: { style: 'thin', color: { argb: 'FFE2E8F0' } }
                        };
                    });
                    excelRow.height = 20;
                }
            });

            // Auto-fit columns (one pass over the array, not over ExcelJS cells)
            var colW = erExportHeaders.map(function (h) { return Math.max(12, h.length); });
            for (var ri = 1; ri < tableData.length; ri++) {
                for (var ci = 0; ci < columnCount; ci++) {
                    var len = (tableData[ri][ci] || '').length;
                    if (len > colW[ci]) colW[ci] = len;
                }
            }
            colW.forEach(function (w, ci) { worksheet.getColumn(ci + 1).width = Math.min(w + 2, 40); });

            // Footer
            worksheet.addRow([]);
            var footerRow = worksheet.addRow(['Total Records: ' + (tableData.length - 1)]);
            footerRow.getCell(1).font = { bold: true, size: 10, color: { argb: 'FF64748B' } };

            var fileName = getDownloadFileName('xlsx');

            workbook.xlsx.writeBuffer().then(function (buffer) {
                var blob = new Blob([buffer], {
                    type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                });
                saveAs(blob, fileName);
                $("#loader").hide();
                showSuccess('Excel downloaded successfully!', 'Success');
            });

        } catch (error) {
            $("#loader").hide();
            console.error('Excel Error:', error);
            showError('Error generating Excel', 'Download Error');
        }
    }

    // ===== CSV DOWNLOAD =====
    function fnDownloadCSV() {
        var table = document.querySelector('#tblEquipmentRoom');

        if (!table) {
            showError('No data available to download', 'Download Error');
            return;
        }

        try {
            $("#loader").show();

            var csv = [];

            // ===== Add From/To Date Header =====
            var fromDisplay = formatDateTimeForExport($('#txtFromDate').val(), $('#txtFromTime').val());
            var toDisplay = formatDateTimeForExport($('#txtToDate').val(), $('#txtToTime').val());

            csv.push('"Equipment Room History Report"');
            csv.push('"From: ' + fromDisplay + '","To: ' + toDisplay + '"');
            csv.push('"Generated: ' + formatNowForExport() + '"');
            csv.push(''); // blank separator row

            // ===== Table Data (from the in-memory array) =====
            function csvCell(t) { return '"' + String(t).replace(/"/g, '""') + '"'; }
            csv.push(erExportHeaders.map(csvCell).join(','));
            var exportRows = erGetExportRows();
            for (var ri = 0; ri < exportRows.length; ri++) {
                csv.push(exportRows[ri].map(csvCell).join(','));
            }

            // Add BOM for Excel UTF-8 compatibility
            var BOM = '\uFEFF';
            var csvString = BOM + csv.join('\n');
            var fileName = getDownloadFileName('csv');

            var blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
            saveAs(blob, fileName);

            $("#loader").hide();
            showSuccess('CSV downloaded successfully!', 'Success');

        } catch (error) {
            $("#loader").hide();
            console.error('CSV Error:', error);
            showError('Error generating CSV', 'Download Error');
        }
    }

    // ===== PDF DOWNLOAD (chunked, safe for large data) =====
    var _erPdfBusy = false;

    function fnDownloadPDF() {
        var table = document.querySelector('#tblEquipmentRoom');
        if (!table) { showError('No data available to download', 'Download Error'); return; }
        if (_erPdfBusy) return;               // double-click protection
        _erPdfBusy = true;

        $("#loader").show();

        // Let the loader paint first, then start the work
        setTimeout(function () {
            try {
                erBuildPdf(table);
            } catch (err) {
                erPdfFail(err);
            }
        }, 50);
    }

    function erPdfFail(err) {
        _erPdfBusy = false;
        $("#loader").hide();
        if (window.console) { window.console.error("PDF Error:", err); }
        showError('Error generating PDF', 'Download Error');
    }

    function erBuildPdf(table) {
        // ---- TABLE DATA from the in-memory array ----
        var tableBody = erGetExportRows();

        if (tableBody.length === 0) {
            _erPdfBusy = false;
            $("#loader").hide();
            showError('No data available to download', 'Download Error');
            return;
        }

        var jsPDF = window.jspdf.jsPDF;
        var doc = new jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4', compress: true });
        var pageW = doc.internal.pageSize.getWidth();
        var pageH = doc.internal.pageSize.getHeight();

        var fromDisplay = formatDateTimeForExport($('#txtFromDate').val(), $('#txtFromTime').val());
        var toDisplay = formatDateTimeForExport($('#txtToDate').val(), $('#txtToTime').val());
        var metaText = 'Period: ' + fromDisplay + '   to   ' + toDisplay +
            '   |   Records: ' + tableBody.length +
            '   |   Generated: ' + formatNowForExport();

        var headers = [
            'Sr.No', 'Zone', 'Division', 'Station',
            'Date & Time', 'Equipment Room Type',
            'Temperature\n(\u00B0C)', 'Humidity\n(%)', 'Open/Close'
        ];

        // ---- FIXED LAYOUT (same column width / row height in every chunk) ----
        var TOP = 58, BOTTOM = 22, SIDE = 14;
        var ROW_H = 18, HEAD_H = 30;
        var rowsPerPage = Math.floor((pageH - TOP - BOTTOM - HEAD_H) / ROW_H);   // ~27
        var PAGES_PER_CHUNK = 20;                                                 // ~540 rows/chunk
        var chunkSize = rowsPerPage * PAGES_PER_CHUNK;

        var usableW = pageW - SIDE * 2;                                           // ~814pt
        var widths = [45, 70, 90, 90, 115, 150, 80, 80, 94];
        var sumW = widths.reduce(function (a, b) { return a + b; }, 0);
        var colStyles = {};
        widths.forEach(function (w, idx) { colStyles[idx] = { cellWidth: w * usableW / sumW }; });

        var OPEN_CLR = [4, 120, 87], CLOSE_CLR = [180, 83, 9];

        function drawBanner() {
            doc.setFillColor(79, 70, 229);
            doc.rect(0, 0, pageW, 36, 'F');
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(14);
            doc.setTextColor(255, 255, 255);
            doc.text('Equipment Room History Report', pageW / 2, 23, { align: 'center' });

            doc.setFillColor(240, 244, 255);
            doc.rect(0, 36, pageW, 18, 'F');
            doc.setFont('helvetica', 'italic');
            doc.setFontSize(8);
            doc.setTextColor(71, 85, 105);
            doc.text(metaText, pageW / 2, 47, { align: 'center' });
        }

        var offset = 0;

        function renderChunk() {
            try {
                var chunk = tableBody.slice(offset, offset + chunkSize);
                if (offset > 0) doc.addPage();

                doc.autoTable({
                    startY: TOP,
                    head: [headers],
                    body: chunk,
                    theme: 'grid',
                    showHead: 'everyPage',
                    rowPageBreak: 'avoid',
                    margin: { top: TOP, bottom: BOTTOM, left: SIDE, right: SIDE },
                    styles: {
                        fontSize: 8,
                        cellPadding: 4,
                        valign: 'middle',
                        halign: 'center',
                        lineColor: [226, 232, 240],
                        lineWidth: 0.4,
                        overflow: 'ellipsize',     // no wrap = fixed row height, fast
                        minCellHeight: ROW_H
                    },
                    headStyles: {
                        fillColor: [30, 58, 95],
                        textColor: [255, 255, 255],
                        fontStyle: 'bold',
                        overflow: 'linebreak',
                        minCellHeight: HEAD_H,
                        cellPadding: { top: 5, bottom: 5, left: 3, right: 3 }
                    },
                    bodyStyles: { textColor: [0, 0, 0] },          // Temperature & Humidity black
                    alternateRowStyles: { fillColor: [241, 245, 249] },
                    columnStyles: colStyles,
                    didParseCell: function (data) {
                        // Only Open/Close is colored; Temperature/Humidity stay black
                        if (data.section === 'body' && data.column.index === 8) {
                            var val = String(data.cell.raw || '').toLowerCase();
                            if (val === 'open') {
                                data.cell.styles.textColor = OPEN_CLR;
                                data.cell.styles.fontStyle = 'bold';
                            } else if (val === 'close') {
                                data.cell.styles.textColor = CLOSE_CLR;
                                data.cell.styles.fontStyle = 'bold';
                            }
                        }
                    },
                    didDrawPage: drawBanner
                });

                offset += chunkSize;

                if (offset < tableBody.length) {
                    setTimeout(renderChunk, 0);     // yield to the browser between chunks
                } else {
                    finishPdf();
                }
            } catch (err) {
                erPdfFail(err);
            }
        }

        function finishPdf() {
            // Correct Page X of Y, drawn after all pages exist
            var total = doc.internal.getNumberOfPages();
            doc.setFont('helvetica', 'normal');
            doc.setFontSize(7);
            doc.setTextColor(148, 163, 184);
            for (var p = 1; p <= total; p++) {
                doc.setPage(p);
                doc.text('Page ' + p + ' of ' + total, pageW - SIDE, pageH - 8, { align: 'right' });
            }

            doc.save(getDownloadFileName('pdf'));
            _erPdfBusy = false;
            $("#loader").hide();
            showSuccess('PDF downloaded successfully!', 'Success');
        }

        renderChunk();
    }

    // Format current date as DD/MM/YYYY HH:MM:SS (same as From Date)
    function formatNowForExport() {
        var now = new Date();
        var dd = ('0' + now.getDate()).slice(-2);
        var mm = ('0' + (now.getMonth() + 1)).slice(-2);
        var yyyy = now.getFullYear();
        var hh = ('0' + now.getHours()).slice(-2);
        var mi = ('0' + now.getMinutes()).slice(-2);
        var ss = ('0' + now.getSeconds()).slice(-2);
        return dd + '/' + mm + '/' + yyyy + ' ' + hh + ':' + mi + ':' + ss;
    }

    // ===== GET FILENAME =====
    function getDownloadFileName(extension) {
        var now = new Date();
        var timestamp = now.getFullYear() +
            String(now.getMonth() + 1).padStart(2, '0') +
            String(now.getDate()).padStart(2, '0') + '_' +
            String(now.getHours()).padStart(2, '0') +
            String(now.getMinutes()).padStart(2, '0');
        return 'EquipmentRoom_' + timestamp + '.' + extension;
    }

    function updateRangeBar() {
        var fd = $('#txtFromDate').val();
        var ft = $('#txtFromTime').val();
        var td = $('#txtToDate').val();
        var tt = $('#txtToTime').val();

        $('#dispFromDate').text(fd || '—');
        $('#dispFromTime').text(ft || '—');
        $('#dispToDate').text(td || '—');
        $('#dispToTime').text(tt || '—');
    }

    function formatDisplayDate(val) {
        // val is yyyy-mm-dd, convert to dd/mm/yyyy
        var parts = val.split('-');
        if (parts.length === 3) return parts[2] + '/' + parts[1] + '/' + parts[0];
        return val;
    }

    function formatDateTimeForExport(dateVal, timeVal) {
        if (!dateVal) return '—';
        // dateVal is now DD/MM/YYYY
        var timePart = timeVal || '00:00:00';
        if (timePart.split(':').length === 2) timePart += ':00';
        return dateVal + ' ' + timePart;
    }
</script>
