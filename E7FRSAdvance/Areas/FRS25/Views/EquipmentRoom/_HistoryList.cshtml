                                        var pct = total > 0 ? ((c.parsed / total) * 100).toFixed(1) : '0';
                                        return ' ' + c.label + ': ' + c.parsed + ' (' + pct + '%)';
                                    }
                                }
                            }
                        }
                    }
                });
                erPieCharts.push(ch3);
            }
            // No door data → card was never added, so nothing to render (no "No door data" message)
        });
    }

    // ---- Main entry point -------------------------------------------------
    function renderErPieChart(data) {
        if (erChart) { erChart.destroy(); erChart = null; }
        erPieCharts.forEach(function (c) { try { c.destroy(); } catch (e) { } });
        erPieCharts = [];
        hideErPieTip();

        var $container = $('#erChartContainer').empty();

        if (!data.rows || data.rows.length === 0) { renderErNoData(); return; }

        // ── Group rows by Station first ──
        var stationOrder = [];
        var stationRows = {};
        data.rows.forEach(function (r) {
            if (!stationRows[r.station]) { stationRows[r.station] = []; stationOrder.push(r.station); }
            stationRows[r.station].push(r);
        });

        // ── Build a section per station ──
        stationOrder.forEach(function (station, sIdx) {
            var rows = stationRows[station];
            var stColor = erChartColors[sIdx % erChartColors.length];

            var $stationBox = $('<div></div>').css({
                padding: '20px', background: 'var(--e7-surface, #fff)', border: '1px solid var(--e7-border, transparent)', borderRadius: '12px',
                boxShadow: 'var(--e7-shadow-card, 0 2px 12px rgba(0,0,0,0.07))', margin: '10px 0',
                borderLeft: '4px solid ' + stColor
            });

            $stationBox.append(
                '<h5 style="margin:0 0 12px;font-size:15px;font-weight:600;color:var(--e7-heading, #1e293b);">' +
                '<i class="fas fa-chart-pie mr-2" style="color:' + stColor + ';"></i>' +
                '<span style="color:' + stColor + ';">' + station + '</span>' +
                ' <span style="font-size:12px;font-weight:400;color:var(--e7-text-3, #64748b);">(' + rows.length + ' records)</span></h5>'
            );

            // Group this station's rows by date → room type
            var byDay = {};
            var dayOrder = [];
            rows.forEach(function (r) {
                var d = dateOf(r.dateTime);
                if (!byDay[d]) { byDay[d] = { rooms: {} }; dayOrder.push(d); }
                if (!byDay[d].rooms[r.room]) byDay[d].rooms[r.room] = [];
                byDay[d].rooms[r.room].push(r);
            });

            dayOrder.sort(function (a, b) {
                var pa = a.split('/'), pb = b.split('/');
                var da = pa.length === 3 ? new Date(pa[2], +pa[1] - 1, +pa[0]) : new Date(a);
                var db = pb.length === 3 ? new Date(pb[2], +pb[1] - 1, +pb[0]) : new Date(b);
                return db - da;
            });

            var isMultiDay = dayOrder.length > 1;
            var stKeyBase = 'pieSt_' + sIdx;

            if (isMultiDay) {
                byDay['__all__'] = { rooms: {} };
                rows.forEach(function (r) {
                    if (!byDay['__all__'].rooms[r.room]) byDay['__all__'].rooms[r.room] = [];
                    byDay['__all__'].rooms[r.room].push(r);
                });

                var $tabs = $('<div></div>').css({
                    display: 'flex', gap: '8px', marginBottom: '14px', flexWrap: 'wrap', alignItems: 'center'
                });
                var tabColors = ['#3266ad', '#1d7a5f', '#854f0b', '#6f42c1', '#c2410c'];

                dayOrder.forEach(function (d, idx) {
                    var rc = Object.keys(byDay[d].rooms).reduce(function (a, k) { return a + byDay[d].rooms[k].length; }, 0);
                    var $btn = $('<button type="button">📅 ' + d + ' (' + rc + ')</button>').addClass('erPieTab_' + stKeyBase).css({
                        fontSize: '12px', fontWeight: '500', border: '0.5px solid var(--e7-border-2, #cbd5e1)',
                        background: idx === 0 ? tabColors[idx % tabColors.length] : 'var(--e7-surface-2, #fff)',
                        color: idx === 0 ? '#fff' : 'var(--e7-text-3, #64748b)',
                        borderColor: idx === 0 ? 'transparent' : 'var(--e7-border-2, #cbd5e1)',
                        borderRadius: '20px', padding: '5px 16px', cursor: 'pointer'
                    }).data('day', d).data('color', tabColors[idx % tabColors.length]);
                    $tabs.append($btn);
                });

                var $btnAll = $('<button type="button">📅 All days (' + rows.length + ')</button>').addClass('erPieTab_' + stKeyBase).css({
                    fontSize: '12px', fontWeight: '500', border: '0.5px solid var(--e7-border-2, #cbd5e1)',
                    background: 'var(--e7-surface-2, #fff)', color: 'var(--e7-text-3, #64748b)', borderRadius: '20px',
                    padding: '5px 16px', cursor: 'pointer'
                }).data('day', '__all__').data('color', '#0f172a');
                $tabs.append($btnAll);

                $stationBox.append($tabs);

                var $tabContent = $('<div></div>');
                $stationBox.append($tabContent);

                // ── MUST append to DOM before drawing charts (getElementById needs it) ──
                $container.append($stationBox);

                // Track this station's chart instances
                var stationPieCharts = [];

                $tabs.find('.erPieTab_' + stKeyBase).on('click', function () {
                    var $b = $(this);
                    $tabs.find('.erPieTab_' + stKeyBase).css({ background: 'var(--e7-surface-2, #fff)', color: 'var(--e7-text-3, #64748b)', borderColor: 'var(--e7-border-2, #cbd5e1)' });
                    $b.css({ background: $b.data('color'), color: '#fff', borderColor: 'transparent' });
                    // Destroy only THIS station's pie charts
                    stationPieCharts.forEach(function (c) { try { c.destroy(); } catch (e) { } });
                    stationPieCharts = [];
                    hideErPieTip();
                    renderErPieDay(stKeyBase + '_' + $b.data('day').replace(/[^a-zA-Z0-9]/g, '_'), byDay[$b.data('day')], $tabContent);
                });

                renderErPieDay(stKeyBase + '_' + dayOrder[0].replace(/[^a-zA-Z0-9]/g, '_'), byDay[dayOrder[0]], $tabContent);
            } else {
                var $tabContent = $('<div></div>');
                $stationBox.append($tabContent);

                // ── MUST append to DOM before drawing charts ──
                $container.append($stationBox);

                renderErPieDay(stKeyBase + '_' + dayOrder[0].replace(/[^a-zA-Z0-9]/g, '_'), byDay[dayOrder[0]], $tabContent);
            }
        });

        $('#dataInfo').html(
            '<i class="fas fa-chart-pie text-primary"></i> ' +
            stationOrder.length + ' station(s) · ' + data.rows.length + ' record(s)'
        );
    }


    // ==========================================================================
    // LINE CHART — Separate line chart per Station
    // ==========================================================================
    // ==========================================================================
    // LINE CHART — Separate line chart per Station + Equipment Room Type
    // ==========================================================================
    // ==========================================================================
    // LINE CHART — Separate line chart per Station + Equipment Room Type
    // ==========================================================================
    var erLineStationCharts = [];

    // ==========================================================================
    // HORIZONTAL SCROLLBAR for line charts (no zoom)
    // The chart shows a fixed window of points (erGetWindowSize); the scrollbar
    // moves that window left / right. Y-axes stay fixed while scrolling.
    // Thumb width  = visible points / total points
    // Thumb left   = first visible point / total points
    // ==========================================================================
    var erHScrollPlugin = {
        id: 'erHScroll',
        afterDraw: function (chart) {
            var o = chart.config.options.plugins && chart.config.options.plugins.erHScroll;
            if (o) erSyncHScroll(chart, o.track, o.thumb);
        }
    };

    function erGetXWindow(chart) {
        var total = (chart.data.labels || []).length;
        var xs = chart.scales.x;
        var min = Math.max(0, Math.round(xs.min));
        var max = Math.min(total - 1, Math.round(xs.max));
        return { total: total, min: min, max: max, visible: Math.max(1, max - min + 1) };
    }

    function erSyncHScroll(chart, track, thumb) {
        if (!track || !thumb || !chart.scales || !chart.scales.x) return;
        var w = erGetXWindow(chart);
        if (w.total <= 1 || w.visible >= w.total) {           // full view → no scrollbar
            if (track.style.display !== 'none') track.style.display = 'none';
            return;
        }
        if (track.style.display !== 'block') track.style.display = 'block';
        var widthPct = Math.max(4, (w.visible / w.total) * 100);
        var leftPct = Math.min(100 - widthPct, (w.min / w.total) * 100);
        thumb.style.width = widthPct + '%';
        thumb.style.left = leftPct + '%';
    }

    // How many time points fit in the visible window (~22px per point, min 15)
    function erGetWindowSize(wrapperEl, total) {
        var width = (wrapperEl && wrapperEl.clientWidth) || 900;
        return Math.min(total, Math.max(15, Math.floor(width / 22)));
    }

    // Moves the visible window so it starts at index newMin (window size unchanged)
    function erScrollTo(chart, newMin) {
        var w = erGetXWindow(chart);
        newMin = Math.max(0, Math.min(w.total - w.visible, Math.round(newMin)));
        if (newMin === w.min) return;
        chart.options.scales.x.min = newMin;
        chart.options.scales.x.max = newMin + w.visible - 1;
        chart.update('none');
    }

    function erBindHScroll(chart, track, thumb) {
        if (!track || !thumb) return;
        var dragging = false, startX = 0, startMin = 0;

        // Drag thumb → scroll left / right
        thumb.addEventListener('pointerdown', function (e) {
            e.preventDefault(); e.stopPropagation();
            dragging = true;
            startX = e.clientX;
            startMin = erGetXWindow(chart).min;
            thumb.style.cursor = 'grabbing';
            if (thumb.setPointerCapture) thumb.setPointerCapture(e.pointerId);
        });
        thumb.addEventListener('pointermove', function (e) {
            if (!dragging) return;
            var w = erGetXWindow(chart);
            var trackW = track.getBoundingClientRect().width || 1;
            var dIdx = ((e.clientX - startX) / trackW) * w.total;
            erScrollTo(chart, startMin + dIdx);
        });
        function endDrag(e) {
            if (!dragging) return;
            dragging = false;
            thumb.style.cursor = 'grab';
            if (thumb.releasePointerCapture && e && e.pointerId !== undefined) {
                try { thumb.releasePointerCapture(e.pointerId); } catch (x) { }
            }
        }
        thumb.addEventListener('pointerup', endDrag);
        thumb.addEventListener('pointercancel', endDrag);

        // Click on empty track → centre the window at the clicked position
        track.addEventListener('pointerdown', function (e) {
            if (e.target === thumb) return;
            var w = erGetXWindow(chart);
            var rect = track.getBoundingClientRect();
            var clickIdx = ((e.clientX - rect.left) / (rect.width || 1)) * w.total;
            erScrollTo(chart, clickIdx - w.visible / 2);
        });
    }

    function renderErLineChart(data) {
        var _t = erTheme();
        if (erChart) { erChart.destroy(); erChart = null; }
        erLineStationCharts.forEach(function (c) { try { c.destroy(); } catch (e) { } });
        erLineStationCharts = [];

        if (data.rows.length === 0) { renderErNoData(); return; }

        var $container = $('#erChartContainer').empty();

        // ── Group rows by Station → then by Room Type ──
        var stationOrder = [];
        var stationRoomMap = {};  // { station: { roomType: [rows] } }

        data.rows.forEach(function (r) {
            if (!stationRoomMap[r.station]) {
                stationRoomMap[r.station] = {};
                stationOrder.push(r.station);
            }
            if (!stationRoomMap[r.station][r.room]) {
                stationRoomMap[r.station][r.room] = [];
            }
            stationRoomMap[r.station][r.room].push(r);
        });

        var chartIndex = 0;
        var totalCharts = 0;

        // ── Build a separate chart card for each Station + Room Type ──
        stationOrder.forEach(function (station, sIdx) {
            var stColor = erChartColors[sIdx % erChartColors.length];
            var roomTypes = stationRoomMap[station];
            var roomNames = Object.keys(roomTypes);

            roomNames.forEach(function (room, rIdx) {
                var roomRows = roomTypes[room];

                // Build ordered unique datetime labels for this room
                var dateTimes = [], dateSet = {};
                roomRows.forEach(function (r) {
                    if (!dateSet[r.dateTime]) {
                        dateSet[r.dateTime] = true;
                        dateTimes.push(r.dateTime);
                    }
                });

                // ── Sort chronologically (oldest → newest) for proper X-axis scaling ──
                // DateTime format from table: "dd/MM/yyyy HH:mm:ss"
                dateTimes.sort(function (a, b) {
                    return parseDT(a) - parseDT(b);
                });

                var shortLabels = dateTimes.map(function (d) {
                    return d.length > 16 ? d.substring(0, 16) : d;
                });

                // Points are ALWAYS shown. The chart shows a fixed scroll window
                // (~22px per point), so circles never overlap even with many records.
                var erPointR = 4;

                // ── Temperature dataset ──
                var tempByDate = {}, hasTemp = false;
                roomRows.forEach(function (r) {
                    if (r.temperature !== null) {
                        tempByDate[r.dateTime] = r.temperature;
                        hasTemp = true;
                    }
                });

                // ── Humidity dataset ──
                var humByDate = {}, hasHum = false;
                roomRows.forEach(function (r) {
                    if (r.humidity !== null) {
                        humByDate[r.dateTime] = r.humidity;
                        hasHum = true;
                    }
                });

                // ── Door relay dataset ──
                var relayByDate = {};
                roomRows.forEach(function (r) {
                    var relay = (r.relay || '').toLowerCase();
                    if (relay.indexOf('open') > -1) relayByDate[r.dateTime] = 1;
                    else if (relay.indexOf('close') > -1) relayByDate[r.dateTime] = 0;
                });
                var hasRelay = Object.keys(relayByDate).length > 0;

                var datasets = [];

                if (hasTemp) {
                    datasets.push({
                        label: 'Temperature (°C)',
                        data: dateTimes.map(function (d) { return tempByDate[d] !== undefined ? tempByDate[d] : null; }),
                        borderColor: '#f43f5e',
                        backgroundColor: 'rgba(244,63,94,0.07)',
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.3,
                        pointBackgroundColor: _t.surface,
                        pointBorderColor: '#f43f5e',
                        pointBorderWidth: 2,
                        pointRadius: erPointR,
                        pointHoverRadius: 6,
                        spanGaps: true,
                        yAxisID: 'yLeft'
                    });
                }

                if (hasHum) {
                    datasets.push({
                        label: 'Humidity (%)',
                        data: dateTimes.map(function (d) { return humByDate[d] !== undefined ? humByDate[d] : null; }),
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59,130,246,0.07)',
                        borderWidth: 2,
                        borderDash: [5, 4],
                        fill: true,
                        tension: 0.3,
                        pointBackgroundColor: _t.surface,
                        pointBorderColor: '#3b82f6',
                        pointBorderWidth: 2,
                        pointRadius: erPointR,
                        pointHoverRadius: 6,
                        spanGaps: true,
                        yAxisID: 'yLeft'
                    });
                }

                if (hasRelay) {
                    // ── Door Status = ONE continuous square-wave line, ONE colour ──
                    // Open  → line goes UP (1), Close → line goes DOWN (0).
                    // A timestamp without a door reading keeps the last known state,
                    // so the line never breaks into separate pieces.
                    var lastDoor = null;
                    var doorSeries = dateTimes.map(function (d) {
                        if (relayByDate[d] !== undefined) lastDoor = relayByDate[d];
                        return lastDoor;
                    });
                    // Circle on every ACTUAL door reading (carried-forward points stay plain line)
                    var doorPointR = dateTimes.map(function (d) {
                        return relayByDate[d] !== undefined ? erPointR : 0;
                    });

                    datasets.push({
                        label: 'Door Status',
                        data: doorSeries,
                        borderColor: '#a855f7',
                        backgroundColor: '#a855f7',
                        borderWidth: 2.5,
                        fill: false,
                        tension: 0,
                        stepped: 'after',          // hold state until the next reading, then jump up/down
                        pointBackgroundColor: _t.surface,
                        pointBorderColor: '#a855f7',
                        pointBorderWidth: 2,
                        pointRadius: doorPointR,
                        pointHoverRadius: 6,
                        spanGaps: true,
                        order: -1,                 // draw on top of Temperature / Humidity
                        yAxisID: 'yRight'
                    });
                }

                if (datasets.length === 0) return;

                // ── Compute stats for the summary strip ──
                var tempVals = roomRows.map(function (r) { return r.temperature; }).filter(function (v) { return v !== null; });
                var humVals = roomRows.map(function (r) { return r.humidity; }).filter(function (v) { return v !== null; });
                var openCnt = roomRows.filter(function (r) { return r.relay && r.relay.indexOf('open') > -1; }).length;
                var closeCnt = roomRows.filter(function (r) { return r.relay && r.relay.indexOf('close') > -1; }).length;

                var avgTemp = tempVals.length
                    ? (tempVals.reduce(function (a, b) { return a + b; }, 0) / tempVals.length).toFixed(1) + '°C'
                    : '—';
                var minTemp = tempVals.length ? erArrMin(tempVals).toFixed(1) + '°C' : '—';
                var maxTemp = tempVals.length ? erArrMax(tempVals).toFixed(1) + '°C' : '—';
                var avgHum = humVals.length
                    ? (humVals.reduce(function (a, b) { return a + b; }, 0) / humVals.length).toFixed(1) + '%'
                    : '—';

                // ── Build card ──
                var canvasId = 'erLineCanvas_' + chartIndex;
                var roomColor = erChartColors[(sIdx + rIdx) % erChartColors.length];

                var $box = $('<div></div>').css({
                    padding: '20px', background: 'var(--e7-surface, #fff)', border: '1px solid var(--e7-border, transparent)',
                    borderRadius: '12px', boxShadow: 'var(--e7-shadow-card, 0 2px 12px rgba(0,0,0,0.07))',
                    margin: '10px 0', borderLeft: '4px solid ' + stColor
                });

                // Title: Station — Room Type
                $box.append(
                    '<h5 style="margin:0 0 4px; font-size:15px; font-weight:600; color:var(--e7-heading, #1e293b);">' +
                    '<i class="fas fa-chart-line mr-2" style="color:' + stColor + ';"></i>' +
                    '<span style="color:' + stColor + ';">' + station + '</span>' +
                    ' <span style="color:var(--e7-text-3, #64748b);font-weight:400;font-size:13px;">—</span> ' +
                    '<span style="color:' + roomColor + ';">' + room + '</span>' +
                    ' <span style="font-size:12px;font-weight:400;color:var(--e7-text-3, #64748b);">(' + roomRows.length + ' records · ' + dateTimes.length + ' time points)</span>' +
                    '</h5>'
                );

                // ── Stats strip ──
                var $stats = $('<div></div>').css({
                    display: 'flex', gap: '12px', flexWrap: 'wrap',
                    margin: '10px 0 16px', alignItems: 'center'
                });

                function statPill(icon, label, value, color) {
                    return '<div style="display:flex;align-items:center;gap:6px;background:var(--e7-surface-2, #f8fafc);' +
                        'border:1px solid var(--e7-border, #e5e7eb);border-radius:8px;padding:6px 14px;">' +
                        '<i class="' + icon + '" style="font-size:12px;color:' + color + ';"></i>' +
                        '<span style="font-size:11px;color:var(--e7-text-3, #64748b);">' + label + ':</span>' +
                        '<span style="font-size:12px;font-weight:600;color:' + color + ';">' + value + '</span></div>';
                }

                $stats.append(statPill('fas fa-thermometer-half', 'Avg Temp', avgTemp, '#f43f5e'));
                $stats.append(statPill('fas fa-arrow-down', 'Min', minTemp, '#3b82f6'));
                $stats.append(statPill('fas fa-arrow-up', 'Max', maxTemp, '#dc2626'));
                $stats.append(statPill('fas fa-tint', 'Avg Humidity', avgHum, '#3b82f6'));
                if (hasRelay) {
                    $stats.append(statPill('fas fa-door-open', 'Open', openCnt, '#22c55e'));
                    $stats.append(statPill('fas fa-door-closed', 'Close', closeCnt, '#f97316'));
                }
                $box.append($stats);

                // ── Custom legend ──
                var $legendRow = $('<div></div>').css({
                    display: 'flex', justifyContent: 'center',
                    alignItems: 'center', margin: '0 0 12px'
                });
                var $legend = $('<div></div>').css({ display: 'flex', gap: '18px', alignItems: 'center', flexWrap: 'wrap' });
                if (hasTemp) $legend.append(legendDotLine('#f43f5e', 'solid', 'Temperature (°C)'));
                if (hasHum) $legend.append(legendDotLine('#3b82f6', 'dashed', 'Humidity (%)'));
                if (hasRelay) $legend.append(legendDotLine('#a855f7', 'solid', 'Door Status (Open/Close)'));
                $legendRow.append($legend);
                $box.append($legendRow);

                // ── Scroll hint ──
                $box.append(
                    '<div style="text-align:right;font-size:11px;color:var(--e7-text-3, #94a3b8);margin:0 0 6px;">' +
                    'Scrollbar / Horizontal scroll / Shift + Scroll = Move left – right' +
                    '</div>'
                );

                // Canvas
                var $wrapper = $('<div></div>').css({ position: 'relative', height: '400px', width: '100%' });
                var $canvas = $('<canvas id="' + canvasId + '"></canvas>');
                $wrapper.append($canvas);
                $box.append($wrapper);

                // ── Horizontal scrollbar (shown when points exceed the visible window) ──
                var $hTrack = $('<div class="er-hscroll-track"></div>').css({
                    position: 'relative', height: '12px', margin: '10px 0 2px',
                    background: 'var(--e7-surface-3, #f1f5f9)', border: '1px solid var(--e7-border, #e2e8f0)', borderRadius: '6px',
                    cursor: 'pointer', display: 'none', userSelect: 'none', touchAction: 'none'
                });
                var $hThumb = $('<div class="er-hscroll-thumb"></div>').css({
                    position: 'absolute', top: '1px', bottom: '1px', left: '0', width: '100%',
                    background: 'rgba(168,85,247,0.55)', borderRadius: '5px', cursor: 'grab'
                });
                $hTrack.append($hThumb);
                $box.append($hTrack);
                $container.append($box);

                // ── Draw chart ──
                var ctx = document.getElementById(canvasId).getContext('2d');

                // Initial visible window: latest points, scroll left for older data
                var erWin = erGetWindowSize($wrapper[0], shortLabels.length);
                var erXMax = shortLabels.length - 1;
                var erXMin = Math.max(0, shortLabels.length - erWin);

                var lineChart = new Chart(ctx, {
                    type: 'line',
                    plugins: [erHScrollPlugin],
                    data: { labels: shortLabels, datasets: datasets },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { display: false },
                            // keeps the scrollbar thumb in sync with the visible window
                            erHScroll: { track: $hTrack[0], thumb: $hThumb[0] },
                            tooltip: {
                                backgroundColor: _t.surface,
                                titleColor: _t.heading,
                                bodyColor: _t.text,
                                borderColor: _t.border,
                                borderWidth: 1,
                                padding: 14,
                                cornerRadius: 8,
                                titleFont: { size: 13, weight: '700' },
                                bodyFont: { size: 12 },
                                displayColors: true,
                                callbacks: {
                                    title: function (items) {
                                        if (!items.length) return '';
                                        var idx = items[0].dataIndex;
                                        return dateTimes[idx] + '\n' + station + ' — ' + room;
                                    },
                                    label: function (c) {
                                        if (c.parsed.y === null) return null;
                                        if (c.dataset.yAxisID === 'yRight') {
                                            var status = c.parsed.y === 1 ? 'Open' : 'Close';
                                            var actual = relayByDate[dateTimes[c.dataIndex]] !== undefined;
                                            return ' Door: ' + status + (actual ? '' : ' (last known)');
                                        }
                                        var unit = c.dataset.label.indexOf('Temp') > -1 ? ' °C' : ' %';
                                        return ' ' + c.dataset.label + ': ' + c.parsed.y.toFixed(2) + unit;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                min: erXMin,
                                max: erXMax,
                                grid: { color: _t.grid },
                                ticks: {
                                    font: { size: 10 }, color: _t.text3,
                                    maxRotation: 40, minRotation: 20,
                                    maxTicksLimit: 25
                                }
                            },
                            yLeft: {
                                type: 'linear',
                                position: 'left',
                                beginAtZero: false,
                                grid: { color: _t.grid },
                                title: {
                                    display: true,
                                    text: 'Temp (°C) / Humidity (%)',
                                    font: { size: 11, weight: '600' },
                                    color: _t.text3
                                },
                                ticks: { font: { size: 11 }, color: _t.text3 }
                            },
                            yRight: {
                                type: 'linear',
                                position: 'right',
                                display: hasRelay,
                                min: -0.2,
                                max: 1.2,
                                grid: { drawOnChartArea: false },
                                title: {
                                    display: true,
                                    text: 'Door Status',
                                    font: { size: 11, weight: '600' },
                                    color: '#a855f7'
                                },
                                ticks: {
                                    font: { size: 11 }, color: '#a855f7',
                                    stepSize: 1,
                                    callback: function (v) {
                                        if (v === 1) return 'Open';
                                        if (v === 0) return 'Close';
                                        return '';
                                    }
                                }
                            }
                        }
                    }
                });

                // ── Trackpad horizontal swipe / Shift + mouse wheel → scroll left / right ──
                // (plain vertical wheel is NOT captured, so the page scrolls normally)
                (function (chart, canvas) {
                    canvas.addEventListener('wheel', function (e) {
                        var dx = e.deltaX, dy = e.deltaY;
                        if (e.shiftKey && Math.abs(dx) < Math.abs(dy)) { dx = dy; dy = 0; }
                        if (Math.abs(dx) <= Math.abs(dy)) return;   // vertical → let page scroll

                        var w = erGetXWindow(chart);
                        if (w.visible >= w.total) return;           // nothing to scroll
                        e.preventDefault();

                        var pxPerPoint = (chart.chartArea.right - chart.chartArea.left) / w.visible || 20;
                        chart._erScrollAcc = (chart._erScrollAcc || 0) + dx / pxPerPoint;
                        var step = chart._erScrollAcc > 0 ? Math.floor(chart._erScrollAcc) : Math.ceil(chart._erScrollAcc);
                        if (step !== 0) {
                            chart._erScrollAcc -= step;
                            erScrollTo(chart, w.min + step);
                        }
                    }, { passive: false });
                })(lineChart, document.getElementById(canvasId));

                erBindHScroll(lineChart, $hTrack[0], $hThumb[0]);

                erLineStationCharts.push(lineChart);
                chartIndex++;
                totalCharts++;
            });
        });

        $('#dataInfo').html(
            '<i class="fas fa-chart-line text-primary"></i> ' +
            stationOrder.length + ' station(s) · ' + totalCharts + ' chart(s) · ' + data.rows.length + ' total record(s)'
        );
    }

    // Helper: parse "dd/MM/yyyy HH:mm:ss" into a Date for chronological sorting
    function parseDT(dtStr) {
        // Supports: "dd/MM/yyyy HH:mm:ss", "dd/MM/yyyy HH:mm", "dd-MM-yyyy HH:mm:ss"
        var parts = String(dtStr).split(/[\s]+/);
        var datePart = parts[0] || '';
        var timePart = parts[1] || '00:00:00';

        var dp = datePart.split(/[\/\-]/);
        var tp = timePart.split(':');

        var day = parseInt(dp[0], 10) || 1;
        var month = parseInt(dp[1], 10) || 1;
        var year = parseInt(dp[2], 10) || 2000;
        var hh = parseInt(tp[0], 10) || 0;
        var mm = parseInt(tp[1], 10) || 0;
        var ss = parseInt(tp[2], 10) || 0;

        return new Date(year, month - 1, day, hh, mm, ss).getTime();
    }

    // Helper: legend dot with line style indicator
    function legendDotLine(color, style, label) {
        var lineStyle = style === 'dashed'
            ? 'border-top:2px dashed ' + color
            : 'border-top:2px solid ' + color;
        return '<div style="display:flex;align-items:center;gap:6px;">' +
            '<span style="display:inline-block;width:20px;height:0;' + lineStyle + ';"></span>' +
            '<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:' + color + ';"></span>' +
            '<span style="font-size:12px;color:var(--e7-text-2, #334155);">' + label + '</span></div>';
    }


    // ==========================================================================
    // RENDER DISPATCHER — called by selectErView()
    // ==========================================================================
    function renderErView() {
        if (erChart) { erChart.destroy(); erChart = null; }
        // Clean up station-wise charts
        if (typeof erBarStationCharts !== 'undefined') {
            erBarStationCharts.forEach(function (c) { try { c.destroy(); } catch (e) { } });
            erBarStationCharts = [];
        }
        if (typeof erLineStationCharts !== 'undefined') {
            erLineStationCharts.forEach(function (c) { try { c.destroy(); } catch (e) { } });
            erLineStationCharts = [];
        }
        if (typeof erPieCharts !== 'undefined') {
            erPieCharts.forEach(function (c) { try { c.destroy(); } catch (e) { } });
            erPieCharts = [];
        }

        if (erSelectedView === 'Table') {
            $('#listView').show();
            $('#erChartContainer').hide();
            $('#dataInfo').html('');
            return;
        }

        $('#listView').hide();
        $('#erChartContainer').show();

        var data = extractEquipmentRoomData();

        if (data.rows.length === 0) { renderErNoData(); return; }

        if (erSelectedView === 'Bar') renderErBarChart(data);
        else if (erSelectedView === 'Pie') renderErPieChart(data);
        else if (erSelectedView === 'Graph') renderErLineChart(data);
    }

    // Re-draw the visible chart when the light/dark theme is toggled
    if (window.MutationObserver && !window.__erThemeObs) {
        window.__erThemeObs = new MutationObserver(function () {
            if (erSelectedView !== 'Table' && $('#erChartContainer').is(':visible')) renderErView();
        });
        window.__erThemeObs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-aurora'] });
    }



