@model Domain.AssetLister
@{
    // Rows are pre-computed in the controller (EquipmentRoomController.BuildHistoryRows).
    // Row format: [Zone, Division, Station, DateTime, RoomType, Temperature, Humidity, Door("Open"/"Close"/"")]
    string erRowsJson = (ViewBag.ErRowsJson as string) ?? "[]";
}
<!-- chart.js is already loaded once in History.cshtml - do not load it again on every search -->

<div class="table-border">
    <div class="row">
        <div class="col-12 col-md-6">
            <div id="selectedRangeBar" style="
    display: flex;
    align-items: center;
    gap: 0;
    background: linear-gradient(135deg, var(--e7-p-aqua-2, #f0f4ff) 0%, var(--e7-p-blue-2, #e8f2ff) 100%);
