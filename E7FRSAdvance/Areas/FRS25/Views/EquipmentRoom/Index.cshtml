@{
    ViewBag.Title = "Equipment Room";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}
@*
    ==========================================================================
    EQUIPMENT ROOM — UNIFIED (LIVE + HISTORY)
    Replaces the separate "Equipment Room Live" (Index) and
    "Equipment Room History" (History) screens with one page.

    Uses the SAME controller endpoints as before — no backend change needed:
      POST /FRS25/EquipmentRoom/_List               -> live partial (_List.cshtml, redesigned)
      POST /FRS25/EquipmentRoom/_HistoryList        -> history partial (_HistoryList.cshtml, unchanged)
      POST /FRS25/EquipmentRoom/GetDivisionByZoneId
      POST /FRS25/EquipmentRoom/GetSiteByDivisionId
      GET  /FRS25/EquipmentRoom/GetEquipmentRoom?siteId=
    ViewBag needed: Zones, Divisions, Sites (same as the old Index/History actions).
    ==========================================================================
*@

<style>
    /* ======================================================================
       STYLES CARRIED OVER FROM History.cshtml
       (_HistoryList.cshtml depends on these: charts, pagers, view dropdown,
       time picker, download menu)
       ====================================================================== */
    @@keyframes progressShrink {
        from {
            width: 100%;
        }

        to {
            width: 0%;
        }
    }

    /* ===== 24-HOUR TIME INPUT WITH CUSTOM PICKER ===== */
    .time-24-wrapper {
        position: relative;
        display: inline-block;
        width: 100%;
    }

    input.time-24 {
        font-variant-numeric: tabular-nums;
        font-family: inherit;
        letter-spacing: 0.5px;
        text-align: center;
        padding-right: 30px !important;
        cursor: pointer;
    }

        input.time-24::placeholder {
            color: var(--e7-text-4);
            letter-spacing: 1px;
        }

    .time-24-icon {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--e7-text-3);
        font-size: 13px;
        pointer-events: none;
    }

    .time-picker-popup {
        position: absolute;
        background: var(--e7-surface);
        border: 1px solid var(--e7-border-2);
        border-radius: 8px;
        box-shadow: var(--e7-shadow-pop);
        z-index: 99999;
        display: none;
        width: 220px;
        overflow: hidden;
    }

        .time-picker-popup.open {
            display: block;
        }

    .time-picker-header {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 12px;
        background: var(--e7-surface-2);
        border-bottom: 1px solid var(--e7-border);
        gap: 4px;
    }

    .time-picker-display {
        font-size: 20px;
        font-weight: 600;
        color: var(--e7-heading);
        font-variant-numeric: tabular-nums;
        letter-spacing: 1px;
    }

    .time-picker-body {
        display: flex;
        height: 200px;
    }

    .time-picker-col {
        flex: 1;
        overflow-y: auto;
        border-right: 1px solid var(--e7-border);
        scroll-behavior: smooth;
    }

        .time-picker-col:last-child {
            border-right: none;
        }

        .time-picker-col::-webkit-scrollbar {
            width: 6px;
        }

        .time-picker-col::-webkit-scrollbar-thumb {
            background: var(--e7-border-2);
            border-radius: 3px;
        }

        .time-picker-col::-webkit-scrollbar-track {
            background: var(--e7-surface-2);
        }

    .time-picker-item {
        padding: 8px 0;
        text-align: center;
        font-size: 14px;
        color: var(--e7-text);
        cursor: pointer;
        font-variant-numeric: tabular-nums;
        transition: background 0.12s;
    }

        .time-picker-item:hover {
            background: var(--e7-accent-soft);
            color: var(--e7-accent-ink);
        }

        .time-picker-item.selected {
            background: var(--e7-accent);
            color: #fff;
            font-weight: 600;
        }

    .time-picker-footer {
        display: flex;
        border-top: 1px solid var(--e7-border);
        background: var(--e7-surface-2);
    }

    .time-picker-btn {
        flex: 1;
        border: none;
        background: transparent;
        padding: 8px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        color: var(--e7-text-3);
        transition: background 0.15s;
    }

        .time-picker-btn:hover {
            background: var(--e7-surface-3);
        }

        .time-picker-btn.primary {
            color: var(--e7-accent-ink);
            font-weight: 600;
        }

            .time-picker-btn.primary:hover {
                background: var(--e7-accent-soft);
            }

    /* ===== FILTER & BUTTON STYLES ===== */
    .btn-search {
        background: linear-gradient(120deg, var(--e7-ask-from), var(--e7-ask-to));
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        color: #fff;
        font-size: 14px;
        font-weight: 500;
        transition: background 0.2s;
    }

        .btn-search:hover {
            background: var(--e7-accent);
        }

    .dropdown-menu.dropdown-menu-right .dropdown-item {
        padding: 10px 15px;
        font-size: 14px;
        display: flex;
        align-items: center;
        background: transparent;
    }

        .dropdown-menu.dropdown-menu-right .dropdown-item:hover {
            background: var(--e7-surface-3);
        }

    #btnDownload + .dropdown-menu {
        min-width: 130px;
        padding: 8px 0;
        border-radius: 8px;
        box-shadow: var(--e7-shadow-pop);
        border: 1px solid var(--e7-border);
    }

    /* ===== HISTORY TABLE ===== */
    .history-table-wrapper {
        max-height: 600px;
        overflow: auto;
        border: 1px solid var(--e7-border);
        border-radius: 8px;
    }

    .history-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .history-table thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background: var(--e7-surface-2);
            color: var(--e7-heading);
            padding: 10px 12px;
            text-align: center;
            font-weight: 600;
            font-size: 12px;
            border: 1px solid var(--e7-border);
            white-space: nowrap;
        }

        .history-table thead tr:first-child th {
            position: sticky;
            top: 0;
            z-index: 12;
        }

        .history-table thead tr:nth-child(2) th {
            position: sticky;
            top: 38px;
            z-index: 11;
        }

        .history-table thead th:first-child {
            position: sticky;
            left: 0;
            z-index: 20;
            background: var(--e7-surface-2);
            min-width: 160px;
        }

        .history-table tbody td {
            padding: 8px 10px;
            text-align: center;
            border: 1px solid var(--e7-border);
            white-space: nowrap;
        }

            .history-table tbody td:first-child {
                position: sticky;
                left: 0;
                z-index: 5;
                background: var(--e7-surface);
                font-weight: 600;
                color: var(--e7-heading);
                text-align: left;
                min-width: 160px;
            }

        .history-table tbody tr:nth-child(even) td {
            background: var(--e7-surface-2);
        }

            .history-table tbody tr:nth-child(even) td:first-child {
                background: var(--e7-surface-2);
            }

        .history-table tbody tr:hover td {
            background: var(--e7-surface-3);
        }

            .history-table tbody tr:hover td:first-child {
                background: var(--e7-surface-3);
            }

    .datetime-input {
        display: flex;
        gap: 6px;
        align-items: center;
    }

        .datetime-input input {
            border: 1px solid var(--e7-border-2);
            border-radius: 6px;
            padding: 6px 10px;
            font-size: 13px;
            height: 38px;
        }

            .datetime-input input:focus {
                border-color: var(--e7-focus);
                outline: none;
                box-shadow: 0 0 0 2px var(--e7-accent-soft);
            }

    /* ===== MULTI-SELECT DROPDOWN STYLES ===== */
    .select-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--e7-surface-2);
        border: 1px solid var(--e7-border-2);
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        color: var(--e7-text);
        cursor: pointer;
        min-width: 170px;
        height: 40px;
    }

        .select-btn:hover {
            border-color: var(--e7-accent);
        }

        .select-btn.active {
            border-color: var(--e7-focus);
            box-shadow: 0 0 0 2px var(--e7-accent-soft);
        }

        .select-btn .text {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: left;
        }

        .select-btn i {
            margin-left: 8px;
            font-size: 12px;
            color: var(--e7-text-3);
        }

    .filter-dropdown {
        position: fixed;
        background: var(--e7-surface);
        border: 1px solid var(--e7-border);
        border-radius: 8px;
        box-shadow: var(--e7-shadow-pop);
        min-width: 260px;
        max-width: 320px;
        z-index: 9999;
        display: none;
    }

        .filter-dropdown.open {
            display: block;
        }

    .ms-dropdown-search {
        padding: 10px 12px;
        border-bottom: 1px solid var(--e7-border);
    }

        .ms-dropdown-search input {
            width: 100%;
            border: 1px solid var(--e7-border);
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s;
        }

            .ms-dropdown-search input:focus {
                border-color: var(--e7-focus);
            }

            .ms-dropdown-search input::placeholder {
                color: var(--e7-text-4);
            }

    .ms-dropdown-header {
        padding: 10px 14px;
        background: var(--e7-surface-2);
        border-bottom: 1px solid var(--e7-border);
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .ms-dropdown-header input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--e7-accent);
        }

        .ms-dropdown-header label {
            font-size: 14px;
            font-weight: 600;
            color: var(--e7-text);
            cursor: pointer;
            margin: 0;
        }

    .ms-dropdown-list {
        max-height: 250px;
        overflow-y: auto;
    }

    .ms-dropdown-item {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid var(--e7-border);
        transition: background 0.15s;
    }

        .ms-dropdown-item:last-child {
            border-bottom: none;
        }

        .ms-dropdown-item:hover {
            background: var(--e7-surface-3);
        }

        .ms-dropdown-item.checked {
            background: var(--e7-accent-soft);
        }

        .ms-dropdown-item.hidden {
            display: none;
        }

        .ms-dropdown-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--e7-accent);
            flex-shrink: 0;
        }

        .ms-dropdown-item span {
            font-size: 14px;
            color: var(--e7-text);
        }

        .ms-dropdown-item.checked span {
            color: var(--e7-accent-ink);
            font-weight: 500;
        }

        .ms-dropdown-item span mark {
            background: var(--e7-amber-soft);
            color: var(--e7-text);
            padding: 0;
            border-radius: 2px;
        }

    .ms-dropdown-empty {
        padding: 25px;
        text-align: center;
        color: var(--e7-text-3);
        font-size: 14px;
    }

    .ms-dropdown-no-results {
        padding: 20px;
        text-align: center;
        color: var(--e7-text-3);
        font-size: 13px;
        display: none;
    }

        .ms-dropdown-no-results.show {
            display: block;
        }

    .dropdown-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9998;
        display: none;
    }

        .dropdown-backdrop.show {
            display: block;
        }

    /* ===== CHART STYLES ===== */
    .chart-container {
        padding: 20px;
        background: var(--e7-surface);
        border-radius: 16px;
        box-shadow: var(--e7-shadow-card);
        margin: 15px 0;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .chart-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--e7-heading);
        margin: 0;
    }

    .chart-wrapper {
        position: relative;
        height: 450px;
        width: 100%;
    }

    .no-data-box {
        height: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--e7-text-3);
        font-size: 16px;
    }

        .no-data-box i {
            font-size: 50px;
            margin-bottom: 15px;
            color: var(--e7-text-4);
        }

    /* View Type single-select items */
    .ms-dropdown-item-single {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid var(--e7-border);
        transition: background 0.15s;
    }

        .ms-dropdown-item-single:last-child {
            border-bottom: none;
        }

        .ms-dropdown-item-single:hover {
            background: var(--e7-surface-3);
        }

        .ms-dropdown-item-single.checked {
            background: var(--e7-accent-soft);
        }

            .ms-dropdown-item-single.checked span {
                color: var(--e7-accent-ink);
                font-weight: 500;
            }

        .ms-dropdown-item-single span {
            font-size: 14px;
            color: var(--e7-text);
        }

        .ms-dropdown-item-single i {
            width: 20px;
            text-align: center;
            font-size: 14px;
            color: var(--e7-text-3);
        }

        .ms-dropdown-item-single.checked i {
            color: var(--e7-accent-ink);
        }

    /* ===== CHANGED VALUE HIGHLIGHT (green) ===== */
    .history-table tbody td.val-changed {
        color: var(--e7-green) !important;
        background: var(--e7-green-soft) !important;
        font-weight: 600;
    }

    .history-table tbody tr:nth-child(even) td.val-changed {
        background: var(--e7-green-soft) !important;
    }

    .history-table tbody tr:hover td.val-changed {
        background: var(--e7-green-soft) !important;
    }

    /* ===== UNCHANGED VALUE HIGHLIGHT (soft muted) ===== */
    .history-table tbody td.val-unchanged {
        color: var(--e7-text-3) !important;
        background: var(--e7-surface-2) !important;
    }

    .history-table tbody tr:nth-child(even) td.val-unchanged {
        background: var(--e7-surface-3) !important;
    }

    .history-table tbody tr:hover td.val-unchanged {
        background: var(--e7-surface-3) !important;
    }

    /* ===== DATALOGGER PICKUP / DROP ===== */
    .dl-pickup {
        color: var(--e7-green) !important;
        font-weight: 700;
    }

    .dl-drop {
        color: var(--e7-red) !important;
        font-weight: 700;
    }

    .attr-sub {
        display: block;
        font-size: 9px;
        font-weight: 400;
        opacity: 0.75;
        margin-top: 1px;
        letter-spacing: 0.5px;
    }

    /* Subscript-style for alias names: ITC → I<sub>TC</sub> (small lowered text) */
    .history-table thead th .alias-tc {
        font-size: 65%;
        vertical-align: sub;
        font-weight: inherit;
        letter-spacing: 0.2px;
    }

    /* ===== SINGLE-LINE FILTERS ===== */
    #filterContainer {
        display: flex !important;
        flex-wrap: nowrap !important;
        align-items: flex-end !important;
        gap: 8px;
        padding-bottom: 4px;
    }

        #filterContainer > div {
            flex: 0 0 auto;
            width: auto !important;
            min-width: 0;
            max-width: none;
            margin-top: 0 !important;
            padding: 0 2px;
        }

            #filterContainer > div > span {
                font-size: 12px;
                font-weight: 500;
                color: var(--e7-text-2);
                white-space: nowrap;
                display: block;
                margin-bottom: 4px;
            }

        #filterContainer .form-control,
        #filterContainer .select-btn {
            font-size: 13px;
            padding: 5px 10px;
            height: 36px;
            min-width: 90px;
        }

        #filterContainer input[type="date"] {
            min-width: 130px;
        }

        #filterContainer input.time-24 {
            min-width: 95px;
            max-width: 115px;
        }

        #filterContainer .time-24-wrapper {
            min-width: 95px;
            max-width: 115px;
        }

        #filterContainer .select-btn {
            min-width: 120px;
        }

        #filterContainer .btn-search {
            height: 36px;
            padding: 6px 14px;
        }

    /* ===== RESPONSIVE FILTER BAR ===== */
    @@media (max-width: 991.98px) {
        #filterContainer > div {
            flex: 1 1 calc(33.333% - 8px) !important;
            width: auto !important;
            max-width: none;
        }

        #filterContainer .select-btn,
        #filterContainer input[type="text"],
        #filterContainer select.form-control {
            min-width: 100%;
            width: 100% !important;
        }
    }

    @@media (max-width: 767.98px) {
        #filterContainer {
            flex-direction: column !important;
            align-items: stretch !important;
        }

            #filterContainer > div {
                width: 100% !important;
                flex: 1 1 100% !important;
                max-width: none;
            }

            #filterContainer .select-btn,
            #filterContainer input[type="text"],
            #filterContainer input[type="date"],
            #filterContainer .time-24-wrapper,
            #filterContainer select.form-control,
            #filterContainer .er-view-selector,
            #filterContainer .er-view-btn {
                min-width: 100% !important;
                max-width: 100% !important;
                width: 100% !important;
            }

            #filterContainer .btn-search {
                width: 100%;
            }

        .filter-dropdown {
            left: 12px !important;
            right: 12px !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
        }

        .er-view-dropdown {
            left: 0;
            right: 0;
            width: 100%;
            min-width: 0;
        }
    }

    @@media (max-width: 575.98px) {
        .time-picker-popup {
            width: calc(100vw - 24px);
            max-width: 260px;
        }
    }

    /* ===== CHART STYLES ===== */
    .chart-container {
        padding: 20px;
        background: var(--e7-surface);
        border-radius: 16px;
        box-shadow: var(--e7-shadow-card);
        margin: 15px 0;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .chart-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--e7-heading);
        margin: 0;
    }

    .chart-wrapper {
        position: relative;
        height: 450px;
        width: 100%;
    }

    .no-data-box {
        height: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--e7-text-3);
        font-size: 16px;
    }

        .no-data-box i {
            font-size: 50px;
            margin-bottom: 15px;
            color: var(--e7-text-4);
        }

    /* ===== VIEW TYPE DROPDOWN ===== */
    .er-view-selector {
        position: relative;
        display: inline-block;
    }

    .er-view-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--e7-surface-2);
        border: 1px solid var(--e7-border-2);
        border-radius: 6px;
        padding: 6px 12px;
        font-size: 13px;
        color: var(--e7-text);
        cursor: pointer;
        min-width: 140px;
        height: 36px;
        gap: 8px;
    }

        .er-view-btn:hover {
            border-color: var(--e7-accent);
        }

        .er-view-btn.active {
            border-color: var(--e7-focus);
            box-shadow: 0 0 0 2px var(--e7-accent-soft);
        }

    .er-view-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 4px;
        background: var(--e7-surface);
        border: 1px solid var(--e7-border);
        border-radius: 8px;
        box-shadow: var(--e7-shadow-pop);
        min-width: 180px;
        z-index: 9999;
        display: none;
    }

        .er-view-dropdown.open {
            display: block;
        }

    .er-view-item {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid var(--e7-border);
        transition: background 0.15s;
    }

        .er-view-item:last-child {
            border-bottom: none;
        }

        .er-view-item:hover {
            background: var(--e7-surface-3);
        }

        .er-view-item.checked {
            background: var(--e7-accent-soft);
        }

            .er-view-item.checked span {
                color: var(--e7-accent-ink);
                font-weight: 500;
            }

        .er-view-item span {
            font-size: 14px;
            color: var(--e7-text);
        }

        .er-view-item i {
            width: 20px;
            text-align: center;
            font-size: 14px;
            color: var(--e7-text-3);
        }

        .er-view-item.checked i {
            color: var(--e7-accent-ink);
        }
    /* ===== BAR CHART PAGER (table-style) ===== */
    .er-pg-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 14px;
        font-size: 13px;
        font-weight: 500;
        color: var(--e7-text-2);
        background: var(--e7-surface-2);
        border: 1px solid var(--e7-border-2);
        cursor: pointer;
        user-select: none;
        transition: background 0.15s, color 0.15s;
        margin-left: -1px;
    }

        .er-pg-btn:first-child {
            border-radius: 6px 0 0 6px;
            margin-left: 0;
        }

        .er-pg-btn:last-child {
            border-radius: 0 6px 6px 0;
        }

        .er-pg-btn:hover:not(.disabled):not(.active) {
            background: var(--e7-surface-3);
            color: var(--e7-heading);
            z-index: 1;
        }

    .er-pg-num.active {
        background: var(--e7-accent);
