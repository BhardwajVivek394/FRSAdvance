    // ---- 7-day hourly heatmap (its own request, independent of the selected range) ----
    function erLoadHeat(room) {
        if (erHeatXhr) erHeatXhr.abort();
        erHeat = null;
        $('#erDrHeat').empty();
        $('#erDrHeatInfo').text('· loading…');
        var to = new Date(), from = new Date(to.getTime());
        from.setDate(to.getDate() - 6);
        from.setHours(0, 0, 0, 0);
        erHeatXhr = erFetchRows([room], from, to, function (rows) {
            if (room !== erDrawerRoom) return;
            var days = [], idx = {};
            for (var d = 0; d < 7; d++) {
                var dt = new Date(from.getTime()); dt.setDate(from.getDate() + d);
                idx[dt.toDateString()] = d;
                days.push({ date: dt, t: { mn: Infinity, mx: -Infinity, sum: 0, n: 0 }, h: { mn: Infinity, mx: -Infinity, sum: 0, n: 0 } });
            }
            var add = function (s, v) { if (v < s.mn) s.mn = v; if (v > s.mx) s.mx = v; s.sum += v; s.n++; };
            for (var i = 0; i < rows.length; i++) {
                if (rows[i][4] !== room) continue;
                var when = erDrParse(rows[i][3]);
                if (!when) continue;
                var di = idx[when.toDateString()];
                if (di === undefined) continue;
                var tv = erDrNum(rows[i][5]), hv = erDrNum(rows[i][6]);
                if (tv !== null) add(days[di].t, tv);
                if (hv !== null) add(days[di].h, hv);
            }
            erHeat = days;
            erRenderHeat();
        }, function () {
            if (room === erDrawerRoom) $('#erDrHeatInfo').text('· could not load the 7-day pattern');
        });
    }

    function erRenderHeat() {
        if (!erHeat) return;
        var key = erDrMetric === 'hum' ? 'h' : 't', unit = erDrMetric === 'hum' ? ' %' : ' °C';
        // One row per day, like a weekly weather forecast: lowest reading on the
        // left, highest on the right, and a bar between them on a shared scale.
        var L = erLimits(), safeLo = erDrMetric === 'hum' ? L.hMin : L.tMin, safeHi = erDrMetric === 'hum' ? L.hMax : L.tMax;
        var names = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
        var lo = Infinity, hi = -Infinity, hot = null, cool = null;
        erHeat.forEach(function (d) {
            var s = d[key];
            if (!s.n) return;
            if (s.mn < lo) { lo = s.mn; cool = d; }
            if (s.mx > hi) { hi = s.mx; hot = d; }
        });
        if (lo === Infinity) { $('#erDrHeat').html('<div class="wk-none">No readings in the last 7 days.</div>'); $('#erDrHeatInfo').text(''); return; }

        // scale covers the week's readings and the safe range, with a little padding
        var sMin = Math.min(lo, safeLo), sMax = Math.max(hi, safeHi), pad = (sMax - sMin) * 0.06 || 1;
        sMin -= pad; sMax += pad;
        var pos = function (v) { return Math.max(0, Math.min(100, (v - sMin) / (sMax - sMin) * 100)); };
        var label = function (d) { return names[d.date.getDay()] + ' ' + erPad(d.date.getDate()); };
        var today = new Date().toDateString(), html = '';

        for (var i = erHeat.length - 1; i >= 0; i--) {             // today first
            var d = erHeat[i], s = d[key], isToday = d.date.toDateString() === today;
            html += '<div class="wk-row' + (isToday ? ' is-today' : '') + '"><span class="wk-day">' + (isToday ? 'Today' : label(d)) + '</span>';
            if (!s.n) { html += '<span class="wk-lo"></span><span class="wk-track"></span><span class="wk-hi wk-nodata">No data</span></div>'; continue; }
            var bad = s.mn < safeLo || s.mx > safeHi, left = pos(s.mn), width = Math.max(1.5, pos(s.mx) - left);
            html += '<span class="wk-lo">' + s.mn.toFixed(1) + '</span>' +
                '<span class="wk-track" title="Average ' + (s.sum / s.n).toFixed(1) + unit + ' from ' + s.n + ' readings">' +
                  '<i class="wk-safe" style="left:' + pos(safeLo) + '%;width:' + (pos(safeHi) - pos(safeLo)) + '%"></i>' +
                  '<i class="wk-bar' + (bad ? ' is-bad' : '') + '" style="left:' + left + '%;width:' + width + '%"></i>' +
                  '<i class="wk-avg" style="left:' + pos(s.sum / s.n) + '%"></i>' +
                '</span>' +
                '<span class="wk-hi">' + s.mx.toFixed(1) + unit + (bad ? ' <i class="fas fa-exclamation-triangle" title="Outside the safe range on this day"></i>' : '') + '</span></div>';
        }
        html += '<div class="wk-foot"><span><i class="k-bar"></i>Lowest to highest of the day</span><span><i class="k-avg"></i>Average</span><span><i class="k-safe"></i>Safe range</span></div>';
        $('#erDrHeat').html(html);

        var what = erDrMetric === 'hum' ? 'Most humid' : 'Hottest', low = erDrMetric === 'hum' ? 'Driest' : 'Coolest';
        $('#erDrHeatInfo').text('· ' + what + ' ' + label(hot) + ' (' + hi.toFixed(1) + unit + '), ' + low.toLowerCase() + ' ' + label(cool) + ' (' + lo.toFixed(1) + unit + ')');
    }

    function erToggleFullHistory(force) {
        erDrFullOpen = (typeof force === 'boolean') ? force : !erDrFullOpen;
        $('#erDrFull').toggle(erDrFullOpen);
        $('#erDrawer').toggleClass('is-wide', erDrFullOpen);
        $('#erPage').toggleClass('erx-open-wide', erDrFullOpen);
        $('#erDrFullBtn span').text(erDrFullOpen ? 'Hide full history' : 'Full history, charts and export');
        // charts drawn while hidden have no size; draw them now that the block is visible
        if (erDrFullOpen && erHistoryLoaded && typeof renderErView === 'function' && $('#tblEquipmentRoom').length) {
            setTimeout(renderErView, 260);
        }
    }

    function erDrSetMsg(msg) {
        var $m = $('#erDrChartMsg');
        if (msg) $m.text(msg).show(); else $m.hide();
    }

    function erDrResetSummary(msg) {
        if (erDrChartObj) { erDrChartObj.destroy(); erDrChartObj = null; }
        erDrSetMsg(msg);
        $('#erDrMin, #erDrAvg, #erDrMax, #erDrCount').text('--');
        $('#erDrDoorWrap, #erDrInsight').hide();
        $('#erDrEvents').empty();
        erDrDoorOpens = [];
        $('#erDrLatest').html('<tr><td colspan="4" class="text-center text-muted">--</td></tr>');
    }

    // "dd/MM/yyyy HH:mm:ss" -> Date
    function erDrParse(s) {
        var m = /^(\d{2})\/(\d{2})\/(\d{4}) (\d{2}):(\d{2}):(\d{2})$/.exec(s || '');
        return m ? new Date(+m[3], +m[2] - 1, +m[1], +m[4], +m[5], +m[6]) : null;
    }

    function erDrNum(v) {
        var s = String(v === null || v === undefined ? '' : v).replace(/,/g, '').trim();
        if (s === '' || s === '-') return null;
        var n = parseFloat(s);
        return isNaN(n) ? null : n;
    }

    // Draws the panel summary from the rows the _HistoryList partial just loaded
    // (window.erRows: [Zone, Division, Station, DateTime, Room, Temp, Hum, Door], newest first).
    function erDrawerRender() {
        var all = (typeof erRows !== 'undefined' && erRows) ? erRows : [];
        var pts = [];
        for (var i = all.length - 1; i >= 0; i--) {             // oldest -> newest
            var r = all[i];
            if (erDrawerRoom && r[4] !== erDrawerRoom) continue;
            var d = erDrParse(r[3]);
            if (!d) continue;
            pts.push({ d: d, label: r[3], t: erDrNum(r[5]), h: erDrNum(r[6]), door: r[7] || '' });
        }
        erDrPts = pts;
        if (pts.length === 0) { erDrResetSummary('No history found for this range.'); $('#erDrCount').text('0'); return; }

        // ---- latest readings ----
        var latest = '';
        for (var k = pts.length - 1; k >= Math.max(0, pts.length - 6); k--) {
            var p = pts[k];
            latest += '<tr><td>' + erEscHtml(p.label) + '</td>' +
                '<td class="text-center">' + (p.t === null ? '--' : p.t.toFixed(1) + ' °C') + '</td>' +
                '<td class="text-center">' + (p.h === null ? '--' : p.h.toFixed(1) + ' %') + '</td>' +
                '<td class="text-center">' + (p.door === 'Open' ? '<span class="badge badge-success">Open</span>' : (p.door === 'Close' ? '<span class="badge badge-warning text-white">Close</span>' : '')) + '</td></tr>';
        }
        $('#erDrLatest').html(latest);

        // ---- door strip ----
        var segs = [], openings = 0;
        erDrDoorOpens = [];
        for (var j = 0; j < pts.length; j++) {
            var st = pts[j].door;
            if (!st) continue;
            if (segs.length && segs[segs.length - 1].st === st) { segs[segs.length - 1].to = pts[j].d; }
            else {
                if (segs.length) segs[segs.length - 1].to = pts[j].d;
                segs.push({ st: st, from: pts[j].d, to: pts[j].d });
                if (st === 'Open') { openings++; erDrDoorOpens.push(pts[j].d); }
            }
        }
        if (segs.length) {
            segs[segs.length - 1].to = pts[pts.length - 1].d;
            var strip = '';
            segs.forEach(function (s) {
                var w = Math.max(1, (s.to - s.from) / 1000);
                strip += '<span title="' + (s.st === 'Open' ? 'Open' : 'Closed') + ' from ' + erPad(s.from.getHours()) + ':' + erPad(s.from.getMinutes()) +
                    '" style="flex:' + w + ' 1 0; background:var(' + (s.st === 'Open' ? '--e7-green, #16a34a' : '--e7-amber, #f59e0b') + ')"></span>';
            });
            $('#erDrDoorStrip').html(strip);
            $('#erDrDoorInfo').text('· opened ' + openings + ' time' + (openings === 1 ? '' : 's') + ' in this range');
            $('#erDrDoorWrap').show();
        } else {
            $('#erDrDoorWrap').hide();
        }

        erDrDrawChart(pts);
    }

    function erDrStamp(d, withDate) {
        var hm = erPad(d.getHours()) + ':' + erPad(d.getMinutes());
        return withDate ? erPad(d.getDate()) + '/' + erPad(d.getMonth() + 1) + ' ' + hm : hm;
    }

    // One-sentence summary + a timeline of door and safe-range changes,
    // both derived from the rows already loaded for the panel.
    function erDrInsightAndEvents(pts) {
        var L = erLimits(), multiDay = pts[0].d.toDateString() !== pts[pts.length - 1].d.toDateString();

        // ---- insight ----
        var tp = pts.filter(function (p) { return p.t !== null; }), msg = '';
        if (tp.length >= 2) {
            var last = tp[tp.length - 1], lo = tp[0], hi = tp[0];
            tp.forEach(function (p) { if (p.t < lo.t) lo = p; if (p.t > hi.t) hi = p; });
            if (last.t - lo.t >= 2 && lo.d < last.d) msg = 'Temperature rose ' + (last.t - lo.t).toFixed(1) + ' °C since ' + erDrStamp(lo.d, multiDay) + '.';
            else if (hi.t - last.t >= 2 && hi.d < last.d) msg = 'Temperature fell ' + (hi.t - last.t).toFixed(1) + ' °C since ' + erDrStamp(hi.d, multiDay) + '.';
            else msg = 'Temperature is steady, within ' + (hi.t - lo.t).toFixed(1) + ' °C over this range.';
            if (last.t < L.tMin || last.t > L.tMax) msg += ' The latest reading (' + last.t.toFixed(1) + ' °C) is ' + (last.t < L.tMin ? 'below' : 'above') + ' the safe range.';
        }
        var hp = pts.filter(function (p) { return p.h !== null; });
        if (hp.length) {
            var lh = hp[hp.length - 1].h;
            if (lh < L.hMin || lh > L.hMax) msg += ' Humidity (' + lh.toFixed(1) + ' %) is ' + (lh < L.hMin ? 'below' : 'above') + ' the safe range.';
        }
        if (msg) $('#erDrInsight').html('<i class="fas fa-lightbulb"></i>' + erEscHtml(msg)).show(); else $('#erDrInsight').hide();

        // ---- events ----
        var ev = [], tState = null, hState = null, door = null, doorAt = null;
        var zone = function (v, lo, hi) { return v < lo ? 'low' : (v > hi ? 'high' : 'ok'); };
        pts.forEach(function (p) {
            if (p.t !== null) {
                var z = zone(p.t, L.tMin, L.tMax);
                if (tState !== null && z !== tState) {
                    ev.push(z === 'ok' ? { d: p.d, cls: 'is-ok', icon: 'fa-check-circle', txt: 'Temperature back in the safe range (' + p.t.toFixed(1) + ' °C)' }
                                       : { d: p.d, cls: 'is-warn', icon: 'fa-exclamation-triangle', txt: 'Temperature went ' + (z === 'low' ? 'below' : 'above') + ' the safe range (' + p.t.toFixed(1) + ' °C)' });
                }
                tState = z;
            }
            if (p.h !== null) {
                var y = zone(p.h, L.hMin, L.hMax);
                if (hState !== null && y !== hState) {
                    ev.push(y === 'ok' ? { d: p.d, cls: 'is-ok', icon: 'fa-check-circle', txt: 'Humidity back in the safe range (' + p.h.toFixed(1) + ' %)' }
                                       : { d: p.d, cls: 'is-warn', icon: 'fa-exclamation-triangle', txt: 'Humidity went ' + (y === 'low' ? 'below' : 'above') + ' the safe range (' + p.h.toFixed(1) + ' %)' });
                }
                hState = y;
            }
            if (p.door && p.door !== door) {
                if (p.door === 'Open') ev.push({ d: p.d, cls: 'is-warn', icon: 'fa-door-open', txt: 'Door opened' });
                else if (door === 'Open') {
                    var mins = Math.max(1, Math.round((p.d - doorAt) / 60000));
                    ev.push({ d: p.d, cls: '', icon: 'fa-door-closed', txt: 'Door closed after ' + mins + ' min' });
                }
                door = p.door; doorAt = p.d;
            }
        });
        if (!ev.length) {
            $('#erDrEvents').html('<div class="erx-ev"><span class="text-muted">No door activity or safe-range changes in this range.</span></div>');
            return;
        }
        var html = '', total = ev.length;
        ev = ev.slice(-12).reverse();                              // newest first
        ev.forEach(function (e) {
            html += '<div class="erx-ev ' + e.cls + '"><span class="ev-time">' + erDrStamp(e.d, true) + '</span><i class="fas ' + e.icon + '"></i><span>' + erEscHtml(e.txt) + '</span></div>';
        });
        if (total > 12) html += '<div class="erx-ev"><span class="text-muted">' + (total - 12) + ' earlier events not shown. Open the full history for all records.</span></div>';
        $('#erDrEvents').html(html);
    }

    function erDrDrawChart(pts) {
        var key = erDrMetric === 'hum' ? 'h' : 't', unit = erDrMetric === 'hum' ? ' %' : ' °C';
        var series = pts.filter(function (p) { return p[key] !== null; });
        if (erDrChartObj) { erDrChartObj.destroy(); erDrChartObj = null; }
        if (series.length === 0) {
            erDrSetMsg('No ' + (erDrMetric === 'hum' ? 'humidity' : 'temperature') + ' readings in this range.');
            $('#erDrMin, #erDrAvg, #erDrMax').text('--');
            $('#erDrCount').text(String(pts.length));
            return;
        }
        var mn = Infinity, mx = -Infinity, sum = 0;
        for (var i = 0; i < series.length; i++) { var v = series[i][key]; if (v < mn) mn = v; if (v > mx) mx = v; sum += v; }
        $('#erDrMin').text(mn.toFixed(1) + unit);
        $('#erDrMax').text(mx.toFixed(1) + unit);
        $('#erDrAvg').text((sum / series.length).toFixed(1) + unit);
        $('#erDrCount').text(String(pts.length));

        // keep the canvas light: at most ~400 points
        var step = Math.max(1, Math.ceil(series.length / 400)), shown = [];
        for (var s = 0; s < series.length; s += step) shown.push(series[s]);
        if (shown[shown.length - 1] !== series[series.length - 1]) shown.push(series[series.length - 1]);

        var sameDay = shown[0].d.toDateString() === shown[shown.length - 1].d.toDateString();
        var labels = shown.map(function (p) {
            var hm = erPad(p.d.getHours()) + ':' + erPad(p.d.getMinutes());
            return sameDay ? hm : erPad(p.d.getDate()) + '/' + erPad(p.d.getMonth() + 1) + ' ' + hm;
        });

        if (typeof Chart === 'undefined') { erDrSetMsg('Chart library could not be loaded.'); return; }
        var cs = getComputedStyle(document.documentElement);
        var cv = function (n, fb) { var x = cs.getPropertyValue(n); return x && x.trim() ? x.trim() : fb; };
        var line = erDrMetric === 'hum' ? cv('--blue', '#2563eb') : cv('--red', '#ef4444');
        var grid = cv('--e7-grid-line', '#eef2f7'), tick = cv('--e7-text-3', '#64748b');

        // shaded safe range + a vertical line at every door opening
        var L = erLimits(), bandLo = erDrMetric === 'hum' ? L.hMin : L.tMin, bandHi = erDrMetric === 'hum' ? L.hMax : L.tMax;
        var doorIdx = erDrDoorOpens.map(function (when) {
            var best = 0, bd = Infinity;
            for (var q = 0; q < shown.length; q++) { var df = Math.abs(shown[q].d - when); if (df < bd) { bd = df; best = q; } }
            return best;
        });
        var overlay = {
            id: 'erSafeBand',
            beforeDatasetsDraw: function (chart) {
                var a = chart.chartArea, y = chart.scales.y, x = chart.scales.x, g = chart.ctx;
                g.save();
                var top = Math.max(a.top, y.getPixelForValue(bandHi)), bot = Math.min(a.bottom, y.getPixelForValue(bandLo));
                if (bot > top) { g.fillStyle = 'rgba(22,163,74,0.13)'; g.fillRect(a.left, top, a.right - a.left, bot - top); }
                g.strokeStyle = cv('--e7-amber', '#f59e0b'); g.lineWidth = 2;
                doorIdx.forEach(function (ix) {
                    var px = x.getPixelForValue(ix);
                    g.beginPath(); g.moveTo(px, a.top); g.lineTo(px, a.bottom); g.stroke();
                });
                g.restore();
            }
        };

        erDrSetMsg('');
        erDrChartObj = new Chart(document.getElementById('erDrChart').getContext('2d'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    data: shown.map(function (p) { return p[key]; }),
                    borderColor: line, borderWidth: 2, pointRadius: shown.length > 60 ? 0 : 2, pointHoverRadius: 4,
                    tension: 0.25, fill: false
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false, animation: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            title: function (items) { return items.length ? shown[items[0].dataIndex].label : ''; },
                            label: function (c) { return c.parsed.y.toFixed(1) + unit; }
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false }, ticks: { color: tick, maxTicksLimit: 6, maxRotation: 0, font: { size: 11 } } },
                    y: { grid: { color: grid }, ticks: { color: tick, maxTicksLimit: 5, font: { size: 11 }, callback: function (v) { return v + unit; } } }
                }
            }
        });
    }

    // ==========================================================================
    // HISTORY (same request as the old History page → _HistoryList partial)
    // ==========================================================================
    function erParseDT(dateStr, timeStr) {
        var d = (dateStr || '').split('/'), t = (timeStr || '00:00').split(':');
        return new Date(parseInt(d[2], 10), parseInt(d[1], 10) - 1, parseInt(d[0], 10), parseInt(t[0] || 0, 10), parseInt(t[1] || 0, 10), 0);
    }

    function fnSearchHistory() {
        var fromDate = $('#txtFromDate').val(), toDate = $('#txtToDate').val();
        if (!fromDate) { erWarn('Please select From Date.'); return; }
        if (!toDate) { erWarn('Please select To Date.'); return; }
        var now = new Date(), fromDT = erParseDT(fromDate, $('#txtFromTime').val()), toDT = erParseDT(toDate, $('#txtToTime').val());
        if (fromDT > now) { erWarn('From Date & Time cannot be a future date and time.'); return; }
        if (toDT > now) { erWarn('To Date & Time cannot be a future date and time.'); return; }
        if (fromDT > toDT) { erWarn('From Date & Time must be less than or equal to To Date & Time.'); return; }
        var site = $('#drpSite').val();
        if (!site || site === '0') { erWarn('Station is required.'); return; }
        if (erHistXhr) erHistXhr.abort();

        // the panel shows one room; without a panel room fall back to the filter selection
        var rooms = erDrawerRoom ? [erDrawerRoom] : erGetSelectedRooms();
        erSetText($('#erHistMeta'), $('#drpSite option:selected').text() + ' · ' +
            fromDate + ' ' + ($('#txtFromTime').val() || '00:00') + ' → ' + toDate + ' ' + ($('#txtToTime').val() || '00:00'));

        erHistoryLoaded = false;
        erDrResetSummary('Loading history…');
        var reqRoom = erDrawerRoom;

        // keep the current height while loading so the panel does not jump
        var $box = $('#divEquipmentRoomHistory');
        $box.css('min-height', Math.max($box.outerHeight(), 200) + 'px')
            .html('<div class="erx-empty"><i class="fas fa-spinner fa-spin"></i>Loading history data...</div>');

        var m = { SearchCriteria: {}, Pager: {} };
        m.SearchCriteria.ZoneIds = [];
        m.SearchCriteria.DivisionIds = [];
        m.SearchCriteria.SiteIds = [site];
        m.SearchCriteria.AssetIds = [];
        m.SearchCriteria.AlertInfoIds = [];
        m.SearchCriteria.AcknowledgemenStatusIds = [];
        m.SearchCriteria.StartDate = toServerDate(fromDate);
        m.SearchCriteria.EndDate = toServerDate(toDate);
        m.SearchCriteria.StartTime = $('#txtFromTime').val();
        m.SearchCriteria.EndTime = $('#txtToTime').val();
        m.SearchCriteria.siteAttributeDatasList = rooms;

        erHistXhr = $.ajax({
            url: '/FRS25/EquipmentRoom/_HistoryList',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(m),
            dataType: 'html',
            success: function (data) {
                if (reqRoom !== erDrawerRoom) return;          // panel moved to another room meanwhile
                $box.empty().append(data).css('min-height', '');
                erHistoryLoaded = true;
                if (typeof updateRangeBar === 'function') updateRangeBar();
                // charts need a visible container; the table view is safe to draw hidden
                if (typeof renderErView === 'function' && (erDrFullOpen || erSelectedView === 'Table')) renderErView();
                erDrawerRender();
            },
            error: function (xhr, status) {
                if (status === 'abort') return;
                erDrResetSummary('Failed to load history.');
                $box.css('min-height', '').html('<div class="erx-empty"><i class="fas fa-exclamation-triangle"></i>Failed to load history. Please try again.</div>');
                erError('Something went wrong!');
            },
            complete: function () { erHistXhr = null; }
        });
    }

    // ==========================================================================
    // QUICK RANGE + DATE HELPERS
    // ==========================================================================
    function erApplyPreset(preset) {
        var to = new Date(), from = new Date(to.getTime());
        if (preset === '1h') from.setHours(to.getHours() - 1);
        else if (preset === '6h') from.setHours(to.getHours() - 6);
        else if (preset === '24h') from.setDate(to.getDate() - 1);
        else if (preset === '7d') from.setDate(to.getDate() - 7);
        else from.setHours(0, 0, 0, 0);
        $('#txtFromDate').val(formatDateForInput(from));
        $('#txtFromTime').val(formatTimeForInput(from));
        $('#txtToDate').val(formatDateForInput(to));
        $('#txtToTime').val(formatTimeForInput(to));
        $('#erPresets button').removeClass('active');
        $('#erPresets button[data-preset="' + preset + '"]').addClass('active');
    }
    function formatDateForInput(date) { return erPad(date.getDate()) + '/' + erPad(date.getMonth() + 1) + '/' + date.getFullYear(); }
    function formatTimeForInput(date) { return erPad(date.getHours()) + ':' + erPad(date.getMinutes()); }
    function toServerDate(ddmmyyyy) {
        if (!ddmmyyyy) return '';
        var p = ddmmyyyy.split('/');
        return p.length === 3 ? p[1] + '/' + p[0] + '/' + p[2] : ddmmyyyy;   // MM/DD/YYYY
    }

    // ==========================================================================
    // CASCADING DROPDOWNS — no full-page loader; the select itself shows "Loading..."
    // ==========================================================================
    function erLoadOptions($sel, url, payload, errMsg) {
        $sel.prop('disabled', true).empty().append($('<option></option>').val('0').text('Loading...'));
        $.ajax({
            url: url,
            type: 'POST',
            data: JSON.stringify(payload),
            contentType: 'application/json',
            success: function (data) {
                $sel.empty().append($('<option></option>').val('0').text('Select'));
                $.each(data || [], function (k, v) { $sel.append($('<option></option>').val(v.Id).text(v.Name)); });
            },
            error: function () { $sel.empty().append($('<option></option>').val('0').text('Select')); erError(errMsg); },
            complete: function () { $sel.prop('disabled', false); }
        });
    }

    function erResetResults() {
        erStopLive();
        if (erLiveXhr) erLiveXhr.abort();
        if (erHistXhr) erHistXhr.abort();
        erLiveLoadedSite = null;
        erHistoryLoaded = false;
        erLastLiveUpdate = null;
        if (erSparkXhr) erSparkXhr.abort();
        $('#erLiveRaw, #erLiveCards, #erLiveTbody, #erRankList').empty();
        $('#erLiveCards, #erLiveTableWrap, #erKpis, #erLiveRank').hide();
        $('#erLiveEmpty').html('<i class="fas fa-broadcast-tower"></i>Press search to start live readings for this station.').show();
        erSetText($('#erLiveMeta'), '');
        $('#wsStatusBar').hide().empty();
        erCloseDrawer();
        erDrResetSummary('');
        $('#divEquipmentRoomHistory').css('min-height', '').empty();
        erSetText($('#erHistMeta'), '');
    }

    // ==========================================================================
    // HISTORY VIEW DROPDOWN (Table / Pie / Bar / Graph)
    // ==========================================================================
    function selectErView(el) {
        var $el = $(el);
        $('#erViewDropdown .er-view-item').removeClass('checked');
        $el.addClass('checked');
        erSelectedView = $el.data('value');
        $('#erViewBtn > span').html($el.find('i').prop('outerHTML') + ' ' + $el.find('span').text());
        $('#erViewDropdown').removeClass('open');
        $('#erViewBtn').removeClass('active');
        if (typeof renderErView === 'function' && $('#tblEquipmentRoom').length) renderErView();
    }
    function toggleErViewDropdown() {
        var $dd = $('#erViewDropdown'), isOpen = $dd.hasClass('open');
        $dd.toggleClass('open', !isOpen);
        $('#erViewBtn').toggleClass('active', !isOpen);
        if (!isOpen) setTimeout(function () { $(document).one('click', function () { $dd.removeClass('open'); $('#erViewBtn').removeClass('active'); }); }, 10);
    }

    // ==========================================================================
    // 24-HOUR TIME PICKER (from the History page)
    // ==========================================================================
    function tpBuildLists() {
        var hr = '', mn = '';
        for (var h = 0; h < 24; h++) hr += '<div class="time-picker-item" data-hour="' + h + '">' + erPad(h) + '</div>';
        for (var m = 0; m < 60; m++) mn += '<div class="time-picker-item" data-minute="' + m + '">' + erPad(m) + '</div>';
        $('#tpHourCol').html(hr);
        $('#tpMinuteCol').html(mn);
    }
    function tpOpen(inputId) {
        tpCurrentInputId = inputId;
        var parts = $('#' + inputId).val().trim().split(':');
        tpSelectedHour = (parts.length === 2 && !isNaN(parseInt(parts[0]))) ? parseInt(parts[0], 10) : 0;
        tpSelectedMinute = (parts.length === 2 && !isNaN(parseInt(parts[1]))) ? parseInt(parts[1], 10) : 0;
        tpUpdateSelection();
        var $input = $('#' + inputId), $popup = $('#timePickerPopup');
        $('body').append($popup);
        var rect = $input[0].getBoundingClientRect();
        $popup.css({ position: 'absolute', visibility: 'hidden', display: 'block', top: '-9999px', left: '-9999px', 'z-index': 99999 });
        var popupH = $popup.outerHeight(), popupW = $popup.outerWidth();
        var top = rect.bottom + window.scrollY + 4, left = rect.left + window.scrollX;
        if (top + popupH > window.innerHeight + window.scrollY) top = rect.top + window.scrollY - popupH - 4;
        if (left + popupW > window.innerWidth + window.scrollX) left = window.innerWidth + window.scrollX - popupW - 8;
        if (left < 4) left = 4;
        $popup.css({ visibility: '', display: '', top: top + 'px', left: left + 'px' }).addClass('open');
        setTimeout(function () {
            var $h = $('#tpHourCol .time-picker-item.selected'), $m = $('#tpMinuteCol .time-picker-item.selected');
            if ($h.length) $('#tpHourCol').scrollTop($h[0].offsetTop - 70);
            if ($m.length) $('#tpMinuteCol').scrollTop($m[0].offsetTop - 70);
        }, 20);
    }
    function tpClose() {
        $('#timePickerPopup').removeClass('open').css({ display: 'none', top: '-9999px', left: '-9999px', visibility: 'hidden' });
        tpCurrentInputId = null;
    }
    function tpUpdateSelection() {
        $('#tpHourCol .time-picker-item, #tpMinuteCol .time-picker-item').removeClass('selected');
        $('#tpHourCol .time-picker-item[data-hour="' + tpSelectedHour + '"]').addClass('selected');
        $('#tpMinuteCol .time-picker-item[data-minute="' + tpSelectedMinute + '"]').addClass('selected');
        $('#tpHour').text(erPad(tpSelectedHour));
        $('#tpMinute').text(erPad(tpSelectedMinute));
    }
    function tpNow(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        var now = new Date(); tpSelectedHour = now.getHours(); tpSelectedMinute = now.getMinutes(); tpUpdateSelection();
        return false;
    }
    function tpClear(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        if (tpCurrentInputId) $('#' + tpCurrentInputId).val('');
        tpClose(); return false;
    }
    function tpApply(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        if (tpCurrentInputId) $('#' + tpCurrentInputId).val(erPad(tpSelectedHour) + ':' + erPad(tpSelectedMinute));
        $('#erPresets button').removeClass('active');
        tpClose(); return false;
    }

    // ==========================================================================
    // INIT
    // ==========================================================================
    $(document).ready(function () {
        tpBuildLists();
        erApplyPreset('today');
        if ($.fn.datepicker) {
            var clearPreset = function () { $('#erPresets button').removeClass('active'); };
            $('#txtFromDate').datepicker({ dateFormat: 'dd/mm/yyyy', autoClose: true, onSelect: clearPreset });
            $('#txtToDate').datepicker({ dateFormat: 'dd/mm/yyyy', autoClose: true, onSelect: clearPreset });
        }

        try {
            var v = localStorage.getItem('erLiveView2'); if (v === 'rank' || v === 'table' || v === 'cards') erSetLiveView(v);
        } catch (e) { }

        // out of the page's stacking context, so it covers the full height above the top bar
        $('body').append($('#erDrawer'));

        // room card / ranked row -> slide-in panel (buttons inside keep their own handlers)
        $(document).on('click', '#erLiveCards .erx-room, #erRankList .erx-rank-row', function (e) {
            if ($(e.target).closest('button, a').length) return;
            erOpenRoomHistory($(this).attr('data-room'));
        });
        $(document).on('keydown', '#erRankList .erx-rank-row', function (e) {
            if (e.key !== 'Enter' && e.key !== ' ') return;
            e.preventDefault();
            erOpenRoomHistory($(this).attr('data-room'));
        });
        $('#erRankSort').on('click', 'button', function () {
            erRankSort = $(this).attr('data-sort');
            $('#erRankSort button').removeClass('active');
            $(this).addClass('active');
            $('#erRankInfo').text(erRankSort === 'risk' ? 'Rooms with the biggest temperature rise today are listed first' : 'Rooms in alphabetical order');
            if (erLiveLoadedSite) erRecalcLive();
        });
        $('#erDrMetric').on('click', 'button', function () {
            erDrMetric = $(this).attr('data-metric');
            $('#erDrMetric button').removeClass('active');
            $(this).addClass('active');
            if (erHistoryLoaded && erDrPts.length) erDrDrawChart(erDrPts);
            erRenderHeat();
        });

        $('#drpZone').on('change', function () {
            var id = $(this).val(); if (!id || id === '0') return;
            erLoadOptions($('#drpDivision'), '/FRS25/EquipmentRoom/GetDivisionByZoneId', { zoneId: id }, 'Failed to load divisions.');
        });
        $('#drpDivision').on('change', function () {
            var id = $(this).val(); if (!id || id === '0') return;
            erLoadOptions($('#drpSite'), '/FRS25/EquipmentRoom/GetSiteByDivisionId', { divisionId: id }, 'Failed to load stations.');
        });
        $('#drpSite').on('change', function () { erResetResults(); erLoadRooms($(this).val()); });

        $('#erPresets').on('click', 'button', function () {
            erApplyPreset($(this).attr('data-preset'));
            if (erDrawerRoom) fnSearchHistory();
        });

        // equipment room multi-select
        $('#btnEquipmentRoom').on('click keydown', function (e) {
            if (e.type === 'keydown' && e.key !== 'Enter' && e.key !== ' ') return;
            e.preventDefault(); e.stopPropagation();
            $('#ddEquipmentRoom').hasClass('open') ? erCloseRoomDD() : erOpenRoomDD();
        });
        $('#ddEquipmentRoom').on('click', function (e) { e.stopPropagation(); });
        $(document).on('click', '#listEquipmentRoom .ms-dropdown-item', function (e) {
            if (e.target.tagName !== 'INPUT') { var $cb = $(this).find('input'); $cb.prop('checked', !$cb.prop('checked')); }
            erUpdateRoomText(); erApplyRoomFilter();
        });
        $('#chkAllEquipmentRoom').on('change', function () {
            $('.cb-equipmentRoom').prop('checked', this.checked);
            erUpdateRoomText(); erApplyRoomFilter();
        });
        $(document).on('click', erCloseRoomDD);
        $(window).on('scroll', function () { if ($('#ddEquipmentRoom').hasClass('open')) erCloseRoomDD(); });

        // time picker
        $(document).on('click', '.time-24', function (e) { e.stopPropagation(); tpOpen(this.id); });
        $(document).on('click', '#tpHourCol .time-picker-item', function (e) { e.stopPropagation(); tpSelectedHour = parseInt($(this).data('hour'), 10); tpUpdateSelection(); });
        $(document).on('click', '#tpMinuteCol .time-picker-item', function (e) { e.stopPropagation(); tpSelectedMinute = parseInt($(this).data('minute'), 10); tpUpdateSelection(); });
        $(document).on('mousedown', function (e) {
            if (!$('#timePickerPopup').hasClass('open')) return;
            var $t = $(e.target);
            if ($t.closest('#timePickerPopup').length === 0 && !$t.hasClass('time-24') && $t.closest('.time-24-wrapper').length === 0) tpClose();
        });
        $(document).on('keydown', function (e) {
            if (e.key !== 'Escape') return;
            if ($('#timePickerPopup').hasClass('open')) { tpClose(); return; }
            if ($('#ddEquipmentRoom').hasClass('open')) { erCloseRoomDD(); return; }
            if (erDrawerRoom && !erPinned) erCloseDrawer();
        });
        $(window).on('resize', function () {
            if ($('#timePickerPopup').hasClass('open')) tpClose();
            erCloseRoomDD();
            $('#erViewDropdown').removeClass('open');
            $('#erViewBtn').removeClass('active');
        });

        $(window).on('beforeunload', erStopLive);

        var site = $('#drpSite').val();
        if (site && site !== '0') { erLoadRooms(site); erApply(); }
    });
</script>
