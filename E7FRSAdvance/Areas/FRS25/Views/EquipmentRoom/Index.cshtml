        flex-shrink: 0;
    }

        .rcp-icon img {
            width: 48px;
            height: 48px;
        }

    .rcp-metrics {
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
        min-width: 0;
    }

    .rcp-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--text-secondary);
        flex-wrap: nowrap;
