
@{
    ViewBag.Title = "Equipment Room Live";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<style>
    .pictorial-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 16px;
        padding: 16px;
    }

    .room-card-pictorial {
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 16px 18px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-height: 160px;
        color: var(--text-secondary);
    }

    .rcp-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
        margin-bottom: 4px;
    }

    .rcp-title {
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary);
        flex: 1;
        min-width: 0;
        word-break: break-word;
    }

    .rcp-badges {
        display: flex;
        gap: 6px;
        align-items: center;
        flex-shrink: 0;
        font-size: 12px;
        color: var(--text-muted);
    }

    .dl-badge-wrap .badge-success,
    .dl-badge-wrap .badge-warning {
        font-size: 12px;
        padding: 3px 8px;
        border-radius: 4px;
    }

    .rcp-body {
        display: flex;
        gap: 16px;
        align-items: center;
        min-width: 0;
    }

    .rcp-icon {
        width: 70px;
        height: 70px;
        border-radius: 10px;
        background: var(--blue-dim);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .rcp-icon img {
            width: 48px;
            height: 48px;
        }

    .rcp-metrics {
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
        min-width: 0;
    }

    .rcp-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: var(--text-secondary);
        flex-wrap: nowrap;
    }

    .rcp-chip {
        background-color: var(--blue);
        width: 28px;
        height: 28px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .rcp-chip img {
            width: 18px;
            height: 18px;
        }

    .rcp-row-inner {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 0;
    }

    .rcp-row-top {
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .rcp-row-top .label-text {
            min-width: 65px;
            flex-shrink: 0;
        }

    .rcp-meta-time {
        font-size: 11px;
        color: var(--text-muted);
        white-space: nowrap;
        margin-top: 2px;
    }

    .val-temp {
        color: var(--red);
        font-weight: 600;
        font-size: 14px;
        flex-shrink: 0;
    }

    .val-hum {
        color: var(--blue);
        font-weight: 600;
        font-size: 14px;
        flex-shrink: 0;
    }
</style>
<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">

                    <div class="row">
                        <div class="col-12 col-sm-5">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item ">
                                        Equipment Room

                                    </li>
                                    <li class="breadcrumb-item active" aria-current="page"><a href="#">Equipment Room Live</a></li>
                                </ol>
                            </nav>
                        </div>
                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                            <h2 class="page-name">Equipment Room Live</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header mb-4">

                    <div class="d-flex justify-content-between">
                        <h4 class="m-0">Search</h4>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div class="row mb-lg-5 mb-3">
                        <div class="col">
                            <div class="d-lg-flex d-md-flex d-flex flex-md-nowrap flex-wrap alertsearchform gap-10">
                                <div class="form-group  w-100 w-sm-48">
                                    <label for="sel1">Zone</label>
                                    @Html.DropDownList("drpZone", (IEnumerable<SelectListItem>)ViewBag.Zones, "Select", new { @class = "form-control", tabindex = 1 })
                                </div>

                                <div class="form-group  w-100 w-sm-48">
                                    <label for="sel1">Division</label>
                                    @Html.DropDownList("drpDivision", (IEnumerable<SelectListItem>)ViewBag.Divisions, "Select", new { @class = "form-control", tabindex = 2 })

                                </div>

                                <div class="form-group  w-100 w-sm-48">
                                    <label for="sel1">Station</label>
                                    @Html.DropDownList("drpSite", (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 3 })

                                </div>
                                <div class="form-group w-100 w-sm-48">
                                    <label for="sel1">View</label>
                                    <select class="form-control" name="drpView">
                                        <option>Table</option>
                                        <option>Pictorial</option>
                                    </select>
                                </div>


                                <div class="form-group w-sm-100">
                                    <label class="d-none d-md-block" for="exampleInputEmail1">&nbsp;</label>
                                    <button type="button" class="btn btn-primary-search" onclick="fnEquipmentRoomLive()">
                                        <img src="~/Areas/FRS25/assets/img/search.svg" />
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="table-border" id="divEquipmentRoomLive">


                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<script>

    $(document).ready(function () {

        $("#drpZone").change(function () {
            GetDivisionByZone($(this).val(), $('#drpDivision'));
        });

        $("#drpDivision").change(function () {
            GetSiteByDivisionId($(this).val(), $('#drpSite'));
        });

        //fnEquipmentRoomLive();
    });

    function fnEquipmentRoomLive() {
        var mAssetLister = {};
        var mSearchCriteria = {};
        mSearchCriteria.SiteId = $('#drpSite').val();
        mSearchCriteria.ZoneId = $('#drpZone').val();
        mSearchCriteria.DivisionId = $('#drpDivision').val();
        mSearchCriteria.AssetTypeId = $('#drpAssetTypes').val();

        if (mSearchCriteria.SiteId != null && mSearchCriteria.SiteId != undefined && mSearchCriteria.SiteId != '') {
            mAssetLister.SearchCriteria = mSearchCriteria;
            $("#loader").show();
            $.ajax({
                url: '/FRS25/EquipmentRoom/_List',
                type: 'Post',
                contentType: 'application/json',
                data: JSON.stringify(mAssetLister),
                dataType: 'html',
                success: function (data) {
                    $("#loader").hide();
                    $("#divEquipmentRoomLive").empty().append(data);
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            })
        } else {
            alert('Please select station');
        }
       
    }

    function GetDivisionByZone(zoneId, $division, $seldivid) {
        if (zoneId != null && zoneId != undefined && zoneId != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRS25/EquipmentRoom/GetDivisionByZoneId',
                type: 'POST',
                data: '{zoneId:' + zoneId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $($division).empty();
                    $($division).append($("<option></option>").val('0').html('Select'));
                    $.each(data, function (key, value) {
                        if ($($seldivid).val() != '0' && $($seldivid).val() == value.Id) {
                            $($division).append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $($division).append($("<option></option>").val(value.Id).html(value.Name));
                        }
                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function GetSiteByDivisionId(divisionId, $drpSiteId, $selsiteid) {
        if (divisionId != null && divisionId != undefined && divisionId != '') {
            $("#loader").show();
            $.ajax({
                url: '/FRS25/EquipmentRoom/GetSiteByDivisionId',
                type: 'POST',
                data: '{divisionId:' + divisionId + '}',
                contentType: 'application/json',
                success: function (data) {
                    $("#loader").hide();
                    $($drpSiteId).empty();
                    $($drpSiteId).append($("<option></option>").val('0').html('Select'));
                    $.each(data, function (key, value) {

                        if ($($selsiteid).val() != '0' && $($selsiteid).val() == value.Id) {
                            $($drpSiteId).append($("<option selected></option>").val(value.Id).html(value.Name));
                        } else {
                            $($drpSiteId).append($("<option></option>").val(value.Id).html(value.Name));
                        }

                    });
                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            });
        }

    }

    function fnDownloadAlertDetailReport() {

        window.location.href = '@Url.Action("DownloadFRSAlertLiveStatus", "AlertLive")';
    }
</script>


