    /* ======================================================================
       UNIFIED EQUIPMENT ROOM PAGE
       Built only from the app's own patterns (card / card-header / breadcrumb /
       #filterContainer / select-btn / ms-dropdown / table thead-light2 /
       badge-success / badge-warning / room-card-pictorial) so it matches
       the other FRS25 screens in light and dark mode.
       ====================================================================== */

    /* keep the page from jumping sideways when content height changes */
    html { scrollbar-gutter: stable; }

    .erx-card-head {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: center;
        justify-content: space-between;
    }

        .erx-card-head h4 { margin: 0; display: flex; align-items: center; gap: 10px; }

    .erx-meta { font-size: 12px; font-weight: 400; color: var(--e7-text-3, #64748b); }

    /* segmented switch — same look as the view dropdown button */
    .erx-seg {
        display: inline-flex;
        background: var(--e7-surface-2, #f8fafc);
        border: 1px solid var(--e7-border-2, #cbd5e1);
        border-radius: 6px;
        padding: 3px;
        gap: 2px;
    }

        .erx-seg button {
            border: none;
            background: transparent;
            color: var(--e7-text-3, #64748b);
            font-size: 13px;
            font-weight: 500;
            height: 30px;
            padding: 0 12px;
            border-radius: 4px;
            cursor: pointer;
            white-space: nowrap;
        }

            .erx-seg button:hover { color: var(--e7-text, #0f172a); }

            .erx-seg button.active {
                background: var(--e7-accent, #2563eb);
                color: #fff;
            }

        .erx-seg.sm button { height: 26px; padding: 0 10px; font-size: 12px; }

    .erx-presets {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        color: var(--e7-text-3, #64748b);
        margin-top: 4px;
    }

    /* equipment-room multi-select: wrapper for the shared .select-btn */
    #ddEquipmentRoom .ms-dropdown-list { max-height: 260px; overflow-y: auto; }

    /* ---- KPI tiles ---- */
    .erx-kpis {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
        padding: 0 16px 16px;
    }

    .erx-kpi {
        background: var(--e7-surface-2, #f8fafc);
        border: 1px solid var(--e7-border, #e2e8f0);
        border-radius: 10px;
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

        .erx-kpi .k-label { font-size: 12px; color: var(--e7-text-3, #64748b); }
        .erx-kpi .k-val { font-size: 20px; font-weight: 700; color: var(--e7-heading, #0f172a); line-height: 1.3; font-variant-numeric: tabular-nums; }
        .erx-kpi .k-val small { font-size: 13px; font-weight: 500; color: var(--e7-text-3, #64748b); }
        .erx-kpi .k-sub { font-size: 11px; color: var(--e7-text-3, #64748b); min-height: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .erx-kpi.is-warn { border-color: var(--e7-amber, #f59e0b); }
        .erx-kpi.is-warn .k-val { color: var(--e7-amber, #b45309); }

    /* ---- live status pill (filled by the _List partial) ---- */
    #wsStatusBar { display: none; min-width: 150px; }
    .ws-status-bar {
        display: inline-flex; align-items: center; gap: 8px; height: 32px; padding: 0 12px;
        border-radius: 6px; font-size: 12px; white-space: nowrap;
        border: 1px solid var(--e7-border, #e2e8f0); background: var(--e7-surface-2, #f8fafc); color: var(--e7-text, #0f172a);
    }
    .ws-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
        .ws-dot.live { background: var(--e7-green, #16a34a); }
        .ws-dot.orange { background: var(--e7-amber, #f59e0b); }
        .ws-dot.red { background: var(--e7-red, #dc2626); }

    /* ---- room cards (extends the existing pictorial card) ---- */
    .erx-grid { padding: 0 16px 16px; }

    .room-card-pictorial.erx-room { transition: border-color .15s, box-shadow .15s; }
        .room-card-pictorial.erx-room:hover { border-color: var(--e7-accent, #2563eb); }
        .room-card-pictorial.erx-room.is-warn { border-color: var(--e7-amber, #f59e0b); }
        .room-card-pictorial.erx-room.is-selected { border-color: var(--e7-accent, #2563eb); box-shadow: 0 0 0 3px var(--e7-accent-soft, rgba(37,99,235,.15)); }

    .erx-sub { display: block; font-size: 12px; font-weight: 400; color: var(--e7-text-3, #64748b); margin-top: 2px; }

    .erx-val-wrap { display: flex; align-items: center; gap: 6px; min-width: 0; }
    .erx-est {
        font-size: 10px; font-weight: 600; padding: 1px 6px; border-radius: 4px; cursor: help;
        background: var(--e7-amber-soft, #fef3c7); color: var(--e7-amber, #92400e);
    }
    .val-temp.is-est, .val-hum.is-est { color: var(--e7-amber, #b45309); }

    .erx-gauge { display: block; height: 4px; border-radius: 2px; background: var(--e7-surface-3, #e2e8f0); overflow: hidden; margin-top: 5px; }
    .erx-gauge > span { display: block; height: 100%; width: 0; border-radius: 2px; }
    .erx-gauge.g-temp > span { background: var(--red, #ef4444); }
    .erx-gauge.g-hum > span { background: var(--blue, #2563eb); }
    .erx-gauge.g-est > span { background: var(--e7-amber, #f59e0b); }

    .erx-foot {
        display: flex; align-items: center; justify-content: space-between; gap: 10px;
        border-top: 1px solid var(--e7-border, #e2e8f0); padding-top: 12px; margin-top: auto;
    }

    .erx-door { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--e7-text-3, #64748b); min-width: 0; }
        .erx-door .badge { font-size: 11px; }

    .erx-btn-link {
        border: 1px solid var(--e7-border-2, #cbd5e1); background: var(--e7-surface, #fff);
        color: var(--e7-accent-ink, #1d4ed8); border-radius: 6px; height: 30px; padding: 0 10px;
        font-size: 12px; font-weight: 500; cursor: pointer; white-space: nowrap;
    }
        .erx-btn-link:hover { border-color: var(--e7-accent, #2563eb); background: var(--e7-accent-soft, #eff6ff); }

    .erx-empty { padding: 48px 16px; text-align: center; color: var(--e7-text-3, #64748b); font-size: 14px; }
        .erx-empty i { font-size: 32px; display: block; margin-bottom: 10px; color: var(--e7-text-4, #94a3b8); }

    /* skeleton while loading (no full-page loader → no scrollbar flicker) */
    .erx-skel {
        height: 168px; border-radius: 12px; border: 1px solid var(--e7-border, #e2e8f0);
        background: linear-gradient(90deg, var(--e7-surface-2, #f1f5f9) 25%, var(--e7-surface-3, #e2e8f0) 50%, var(--e7-surface-2, #f1f5f9) 75%);
        background-size: 200% 100%; animation: erxShimmer 1.4s linear infinite;
    }
    @@keyframes erxShimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    .erx-busy { opacity: .6; pointer-events: none; }

    /* ---- compact top of page: less padding in the title and search cards ---- */
    #erPage .card { margin-bottom: 14px !important; }
    #erPage .breadcrumb { margin: 0 !important; padding: 12px 20px !important; }
    #erPage .page-name { margin: 0 !important; padding: 8px 20px !important; font-size: 22px; }
    #erPage .card-header { padding-top: 14px !important; padding-bottom: 6px !important; margin-bottom: 0 !important; }
    #erPage .card-body:not(.p-0) { padding-top: 10px !important; padding-bottom: 14px !important; }
    #erPage #filterContainer { margin-bottom: 0 !important; padding-bottom: 0; }
    #erPage .erx-kpis { padding-top: 12px; }

    /* the original _List partial stays off-screen; its WebSocket code feeds the cards */
    #erLiveRaw { display: none; }

    .erx-hist-only.is-hidden { display: none !important; }

    /* ---- slide-in room history panel ---- */
    .room-card-pictorial.erx-room { cursor: pointer; }

    .erx-drawer {
        /* full page height. The panel is moved to <body> on load so it stacks
           above the sticky top bar instead of being covered by it. */
        position: fixed; top: 0; right: 0; bottom: 0; z-index: 1100;
        width: 520px; max-width: 100vw;
        display: flex; flex-direction: column;
        background: var(--e7-surface, #fff);
        border-left: 1px solid var(--e7-border, #e2e8f0);
        box-shadow: var(--e7-shadow-pop, -8px 0 24px rgba(15,23,42,.14));
        transform: translateX(105%);
        visibility: hidden;
        transition: transform .25s ease, width .25s ease, visibility 0s linear .25s;
    }
        .erx-drawer.is-open { transform: none; visibility: visible; transition: transform .25s ease, width .25s ease; }
        .erx-drawer.is-wide { width: 1100px; }

    .erx-dr-head {
        display: flex; align-items: center; justify-content: space-between; gap: 12px;
        padding: 14px 18px; border-bottom: 1px solid var(--e7-border, #e2e8f0);
        background: var(--e7-surface-2, #f8fafc);
    }
        .erx-dr-head h4 { margin: 0; font-size: 17px; color: var(--e7-heading, #0f172a); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .erx-dr-close {
        border: 1px solid var(--e7-border-2, #cbd5e1); background: var(--e7-surface, #fff); color: var(--e7-text-2, #475569);
        width: 34px; height: 34px; border-radius: 6px; cursor: pointer; flex-shrink: 0;
    }
        .erx-dr-close:hover { border-color: var(--e7-accent, #2563eb); color: var(--e7-accent-ink, #1d4ed8); }

    .erx-dr-body { flex: 1; overflow-y: auto; padding: 16px 18px 24px; }

    .erx-dr-live, .erx-dr-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 10px; }
        .erx-dr-live > div, .erx-dr-stats > div {
            background: var(--e7-surface-2, #f8fafc); border: 1px solid var(--e7-border, #e2e8f0);
            border-radius: 10px; padding: 10px 12px; display: flex; flex-direction: column; gap: 2px; min-width: 0;
        }
        .erx-dr-live .k-label, .erx-dr-stats .k-label { font-size: 12px; color: var(--e7-text-3, #64748b); }
        .erx-dr-live .k-val { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }
        .erx-dr-stats .k-val { font-size: 15px; font-weight: 600; color: var(--e7-heading, #0f172a); font-variant-numeric: tabular-nums; }

    .erx-dr-tools { display: flex; flex-wrap: wrap; gap: 8px; justify-content: space-between; margin: 14px 0 10px; }

    .erx-dr-chart { position: relative; height: 220px; margin-bottom: 12px; }
    .erx-dr-msg {
        position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
        font-size: 13px; color: var(--e7-text-3, #64748b); background: var(--e7-surface, #fff);
    }

    .erx-dr-title { font-size: 13px; font-weight: 600; color: var(--e7-heading, #0f172a); margin: 16px 0 8px; }

    .erx-dr-doorstrip { display: flex; gap: 2px; height: 12px; border-radius: 4px; overflow: hidden; background: var(--e7-surface-3, #e2e8f0); }
        .erx-dr-doorstrip > span { min-width: 2px; }
    .erx-dr-doorlegend { display: flex; gap: 14px; font-size: 11px; color: var(--e7-text-3, #64748b); margin-top: 6px; }
        .erx-dr-doorlegend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 5px; }

    .erx-dr-latest { font-size: 13px; margin-bottom: 14px; }
        .erx-dr-latest th { font-size: 12px; font-weight: 600; color: var(--e7-text-3, #64748b); border-top: none; }
        .erx-dr-latest td { font-variant-numeric: tabular-nums; }

    .erx-dr-fullbtn { width: 100%; height: 36px; }

    .erx-dr-filter { display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-end; margin: 16px 0 8px; }
        .erx-dr-filter .filter-item > span { display: block; font-size: 12px; font-weight: 500; color: var(--e7-text-2, #475569); margin-bottom: 4px; }
        .erx-dr-filter .form-control { height: 36px; font-size: 13px; width: 118px; }
        .erx-dr-filter .btn-search { height: 36px; padding: 6px 14px; }

    #erDrFull #selectedRangeBar { min-width: 0 !important; flex-wrap: wrap; margin-left: 0 !important; }

    /* ---- ranked room list ---- */
    .erx-rank { padding: 0 16px 16px; }
    .erx-rank-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; font-size: 12px; color: var(--e7-text-3, #64748b); }
    .erx-rank-row {
        display: grid; align-items: center; gap: 12px;
        grid-template-columns: minmax(140px, 1.5fr) 120px 96px 96px 90px 96px 14px;
        padding: 10px 14px; cursor: pointer;
        border: 1px solid var(--e7-border, #e2e8f0); border-radius: 10px; margin-bottom: 8px;
        background: var(--e7-surface, #fff); color: var(--e7-text, #0f172a);
    }
        .erx-rank-row:hover { border-color: var(--e7-accent, #2563eb); }
        .erx-rank-row.is-warn { border-color: var(--e7-amber, #f59e0b); }
        .erx-rank-row.is-selected { border-color: var(--e7-accent, #2563eb); box-shadow: 0 0 0 3px var(--e7-accent-soft, rgba(37,99,235,.15)); }
        .erx-rank-row .rk-name { font-size: 14px; font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .erx-rank-row .rk-val { font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
        .erx-rank-row .rk-trend { font-size: 12px; color: var(--e7-text-3, #64748b); font-variant-numeric: tabular-nums; white-space: nowrap; }
            .erx-rank-row .rk-trend.is-up { color: var(--e7-amber, #b45309); font-weight: 600; }
        .erx-rank-row .rk-spark svg { display: block; }
        .erx-rank-row .rk-go { color: var(--e7-text-4, #94a3b8); font-size: 11px; }
    @@media (max-width: 991.98px) {
        .erx-rank-row { grid-template-columns: minmax(110px, 1fr) 84px 84px 14px; }
            .erx-rank-row .rk-spark, .erx-rank-row .rk-door, .erx-rank-row .rk-trend { display: none; }
    }

    /* ---- panel: head buttons, safe-range gauges, insight, heatmap, timeline ---- */
    .erx-dr-btns { display: flex; gap: 6px; flex-shrink: 0; }
    .erx-dr-close.is-on { background: var(--e7-accent, #2563eb); border-color: var(--e7-accent, #2563eb); color: #fff; }

    .erx-dr-gauges { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 10px; }
    .erx-dr-g { background: var(--e7-surface-2, #f8fafc); border: 1px solid var(--e7-border, #e2e8f0); border-radius: 10px; padding: 10px 12px; }
        .erx-dr-g .g-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10px; }
        .erx-dr-g .k-label { font-size: 12px; color: var(--e7-text-3, #64748b); }
        .erx-dr-g .k-val { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }
        .erx-dr-g .g-scale { display: flex; justify-content: space-between; font-size: 11px; color: var(--e7-text-3, #64748b); margin-top: 6px; }
    .erx-band { position: relative; height: 8px; border-radius: 4px; background: var(--e7-surface-3, #e2e8f0); }
        .erx-band > i { position: absolute; top: 0; bottom: 0; border-radius: 4px; background: var(--e7-green, #16a34a); opacity: .35; }
        .erx-band > b { position: absolute; top: -4px; width: 4px; height: 16px; margin-left: -2px; border-radius: 2px; background: var(--e7-green, #16a34a); display: none; }
            .erx-band > b.is-bad { background: var(--e7-amber, #f59e0b); }

    .erx-dr-insight {
        margin: 10px 0 0; padding: 9px 12px; border-radius: 8px; font-size: 13px;
        background: var(--e7-accent-soft, #eff6ff); color: var(--e7-text, #0f172a);
    }
        .erx-dr-insight i { color: var(--e7-accent-ink, #1d4ed8); margin-right: 6px; }

    .erx-dr-legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 11px; color: var(--e7-text-3, #64748b); margin-bottom: 6px; }
        .erx-dr-legend i { display: inline-block; vertical-align: -1px; margin-right: 5px; }

    .erx-heat { display: grid; grid-template-columns: 44px repeat(24, minmax(0, 1fr)); gap: 2px; align-items: center; font-size: 10px; color: var(--e7-text-3, #64748b); }
        .erx-heat .hc { height: 14px; border-radius: 2px; background: var(--e7-surface-3, #e2e8f0); }
        .erx-heat .hx { text-align: center; }

    .erx-ev { display: flex; gap: 10px; align-items: baseline; padding: 7px 0; font-size: 13px; border-bottom: 1px solid var(--e7-border, #e2e8f0); color: var(--e7-text, #0f172a); }
        .erx-ev:last-child { border-bottom: none; }
        .erx-ev .ev-time { flex: 0 0 92px; font-size: 12px; color: var(--e7-text-3, #64748b); font-variant-numeric: tabular-nums; }
        .erx-ev i { width: 16px; text-align: center; color: var(--e7-text-3, #64748b); }
        .erx-ev.is-warn i { color: var(--e7-amber, #f59e0b); }
        .erx-ev.is-ok i { color: var(--e7-green, #16a34a); }

    /* pinned: the panel sits beside the page instead of over it */
    @@media (min-width: 1200px) {
        #erPage.erx-open.erx-pinned { margin-right: 520px; transition: margin-right .25s ease; }
        #erPage.erx-open.erx-pinned.erx-open-wide { margin-right: 0; }
    }

    /* ---- panel polish ---- */
    .erx-dr-head { padding: 16px 20px; background: var(--e7-surface, #fff); }
    .erx-dr-titleline { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .erx-dr-titleline h4 { font-size: 18px; font-weight: 700; }
        .erx-dr-titleline .badge { font-size: 11px; }
    .erx-dr-body { padding: 18px 20px 28px; }
    .erx-dr-g { background: var(--e7-surface, #fff); border-radius: 12px; padding: 12px 14px; }
    .erx-dr-insight { margin: 0 0 4px; border-left: 3px solid var(--e7-accent, #2563eb); border-radius: 0 8px 8px 0; }
    .erx-dr-chart { height: 230px; margin-bottom: 12px; }
    .erx-dr-statline { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: 12px; color: var(--e7-text-3, #64748b); }
        .erx-dr-statline b { color: var(--e7-heading, #0f172a); font-weight: 600; font-variant-numeric: tabular-nums; margin-left: 2px; }
        .erx-dr-statline i { display: inline-block; vertical-align: -1px; margin-right: 5px; }
        .erx-dr-statline .erx-dr-key:first-of-type { margin-left: auto; }
    .erx-dr-events { border: 1px solid var(--e7-border, #e2e8f0); border-radius: 12px; padding: 2px 14px; }
    .erx-dr-fullbtn { margin-top: 22px; height: 40px; border-radius: 8px; font-size: 13px; }
    .erx-kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    @@media (max-width: 767.98px) { .erx-kpis { grid-template-columns: 1fr; } }

    /* ---- last 7 days: one low-to-high bar per day ---- */
    .erx-week { border: 1px solid var(--e7-border, #e2e8f0); border-radius: 12px; padding: 6px 14px 10px; }
    .wk-row { display: grid; grid-template-columns: 62px 44px minmax(0, 1fr) 84px; align-items: center; gap: 10px; padding: 9px 0; border-bottom: 1px solid var(--e7-border, #e2e8f0); font-size: 13px; }
        .wk-row.is-today .wk-day { font-weight: 700; color: var(--e7-heading, #0f172a); }
    .wk-day { color: var(--e7-text-2, #475569); white-space: nowrap; }
    .wk-lo { text-align: right; color: var(--e7-text-3, #64748b); font-variant-numeric: tabular-nums; }
    .wk-hi { font-weight: 600; color: var(--e7-heading, #0f172a); font-variant-numeric: tabular-nums; white-space: nowrap; }
        .wk-hi .fa-exclamation-triangle { color: var(--e7-amber, #f59e0b); font-size: 11px; margin-left: 2px; }
        .wk-hi.wk-nodata { font-weight: 400; color: var(--e7-text-4, #94a3b8); }
    .wk-track { position: relative; height: 10px; border-radius: 5px; background: var(--e7-surface-3, #e2e8f0); }
        .wk-track > i { position: absolute; top: 0; bottom: 0; border-radius: 5px; }
        .wk-safe { background: var(--e7-green, #16a34a); opacity: .22; }
        .wk-bar { background: var(--e7-accent, #2563eb); }
            .wk-bar.is-bad { background: var(--e7-amber, #f59e0b); }
        .wk-track > i.wk-avg { top: -3px; bottom: -3px; width: 3px; margin-left: -1px; border-radius: 2px; background: var(--e7-heading, #0f172a); }
    .wk-foot { display: flex; flex-wrap: wrap; gap: 6px 16px; padding-top: 10px; font-size: 11px; color: var(--e7-text-3, #64748b); }
        .wk-foot i { display: inline-block; vertical-align: -1px; margin-right: 5px; }
        .wk-foot .k-bar { width: 16px; height: 8px; border-radius: 4px; background: var(--e7-accent, #2563eb); }
        .wk-foot .k-avg { width: 3px; height: 12px; border-radius: 2px; background: var(--e7-heading, #0f172a); vertical-align: -2px; }
        .wk-foot .k-safe { width: 16px; height: 8px; border-radius: 4px; background: var(--e7-green, #16a34a); opacity: .3; }
    .wk-none { padding: 14px 0 8px; font-size: 13px; color: var(--e7-text-3, #64748b); }

    /* date picker / time picker must sit above the panel */
    .datepickers-container { z-index: 100000 !important; }

    /* on wide screens the tiles stay visible beside the panel */
    @@media (min-width: 1500px) {
        #erPage.erx-open { margin-right: 520px; transition: margin-right .25s ease; }
        #erPage.erx-open.erx-open-wide { margin-right: 0; }
    }
</style>

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<!-- 24-hour Time Picker Popup (shared for From/To) -->
<div class="time-picker-popup" id="timePickerPopup">
    <div class="time-picker-header">
        <span class="time-picker-display" id="tpHour">00</span>
        <span class="time-picker-display">:</span>
        <span class="time-picker-display" id="tpMinute">00</span>
    </div>
    <div class="time-picker-body">
        <div class="time-picker-col" id="tpHourCol"></div>
        <div class="time-picker-col" id="tpMinuteCol"></div>
    </div>
    <div class="time-picker-footer">
        <button type="button" class="time-picker-btn" onclick="return tpNow(event);">Now</button>
        <button type="button" class="time-picker-btn" onclick="return tpClear(event);">Clear</button>
        <button type="button" class="time-picker-btn primary" onclick="return tpApply(event);">OK</button>
    </div>
</div>

<!-- Equipment Room multi-select panel (positioned under its button) -->
<div class="filter-dropdown" id="ddEquipmentRoom">
    <div class="ms-dropdown-search">
        <input type="text" placeholder="Search equipment room..." aria-label="Search equipment room" onkeyup="erFilterRoomList(this.value)">
    </div>
    <div class="ms-dropdown-header">
        <input type="checkbox" id="chkAllEquipmentRoom">
        <label for="chkAllEquipmentRoom">Select All</label>
    </div>
    <div class="ms-dropdown-list" id="listEquipmentRoom"><div class="ms-dropdown-empty">Select Station first</div></div>
</div>

<section class="section" id="erPage">

    <!-- ================= PAGE HEADER (same pattern as every FRS25 page) ================= -->
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="row">
                        <div class="col-12 col-sm-5">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item">Equipment Room</li>
                                    <li class="breadcrumb-item active" aria-current="page"><a href="#">Live &amp; History</a></li>
                                </ol>
                            </nav>
                        </div>
                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                            <h2 class="page-name">Equipment Room</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= SEARCH (same filter bar as the History page) ================= -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header mb-2">
                    <div class="erx-card-head">
                        <h4>Search</h4>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-2" id="filterContainer">
                        <div class="filter-item">
                            <span>Zone</span>
                            @Html.DropDownList("drpZone", (IEnumerable<SelectListItem>)ViewBag.Zones, "Select", new { @class = "form-control", tabindex = 1 })
                        </div>
                        <div class="filter-item">
                            <span>Division</span>
                            @Html.DropDownList("drpDivision", (IEnumerable<SelectListItem>)ViewBag.Divisions, "Select", new { @class = "form-control", tabindex = 2 })
                        </div>
                        <div class="filter-item">
                            <span>Station</span>
                            @Html.DropDownList("drpSite", (IEnumerable<SelectListItem>)ViewBag.Sites, "Select", new { @class = "form-control", tabindex = 3 })
                        </div>
                        <div class="filter-item">
                            <span>Equipment Room</span>
                            <div class="select-btn" id="btnEquipmentRoom" role="button" tabindex="4" aria-haspopup="true" aria-expanded="false">
                                <span class="text" id="txtEquipmentRoom">All</span>
                                <i class="fas fa-chevron-down"></i>
                            </div>
                        </div>
                        <div class="filter-item">
                            <span>&nbsp;</span>
                            <button type="button" class="btn-search" id="btnErSearch" onclick="erApply()" title="Search" aria-label="Search">
                                <img src="~/Areas/FRS25/assets/img/search.svg" alt="">
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= LIVE ================= -->
    <div class="row" id="erLiveSection">
        <div class="col-12">
            <div class="card">
                <div class="card-header mb-3">
                    <div class="erx-card-head">
                        <h4>Live Status <span class="erx-meta" id="erLiveMeta">Select a station and press search</span></h4>
                        <div style="display:flex; flex-wrap:wrap; gap:10px; align-items:center;">
                            <div id="wsStatusBar"></div>
                            <div class="erx-seg" role="group" aria-label="Live view">
                                <button type="button" id="erLiveViewRank" class="active" onclick="erSetLiveView('rank')"><i class="fas fa-sort-amount-down mr-1"></i> Ranked</button>
                                <button type="button" id="erLiveViewCards" onclick="erSetLiveView('cards')"><i class="fas fa-th-large mr-1"></i> Pictorial</button>
                                <button type="button" id="erLiveViewTable" onclick="erSetLiveView('table')"><i class="fas fa-table mr-1"></i> Table</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="erx-kpis" id="erKpis" style="display:none;">
                        <div class="erx-kpi"><span class="k-label">Rooms reporting</span><span class="k-val" id="kpiRooms">0 <small>/ 0</small></span><span class="k-sub" id="kpiRoomsSub"></span></div>
                        <div class="erx-kpi"><span class="k-label">Avg temperature</span><span class="k-val" id="kpiAvgTemp">--</span><span class="k-sub">Across rooms shown</span></div>
                        <div class="erx-kpi"><span class="k-label">Highest temperature</span><span class="k-val" id="kpiMaxTemp">--</span><span class="k-sub" id="kpiMaxTempRoom"></span></div>                    </div>

                    <div id="erLiveEmpty" class="erx-empty"><i class="fas fa-broadcast-tower"></i>Live readings appear here once a station is selected.</div>
                    <div id="erLiveRank" class="erx-rank" style="display:none;">
                        <div class="erx-rank-head">
                            <span id="erRankInfo">Rooms with the biggest temperature rise today are listed first</span>
                            <div class="erx-seg sm" role="group" aria-label="Sort rooms" id="erRankSort">
                                <button type="button" data-sort="risk" class="active">By rise</button>
                                <button type="button" data-sort="name">A-Z</button>
                            </div>
                        </div>
                        <div id="erRankList"></div>
                    </div>
                    <div id="erLiveCards" class="pictorial-grid erx-grid" style="display:none;"></div>
                    <div id="erLiveTableWrap" class="table-border" style="display:none;">
                        <div class="table-responsive">
                            <table class="table table-hover erx-live-table">
                                <thead class="thead-light2">
                                    <tr>
                                        <th>Sr.No</th><th>Zone</th><th>Division</th><th>Station</th><th>Equipment Room Type</th>
                                        <th class="text-center">Temperature(°C)</th><th class="text-center">Humidity(%)</th>
                                        <th class="text-center">Open/Close</th><th class="text-center">History</th>
                                    </tr>
                                </thead>
                                <tbody id="erLiveTbody"></tbody>
                            </table>
                        </div>
                    </div>
                    <div id="erLiveRaw" aria-hidden="true"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- ================= HISTORY ================= -->
    <!-- Slide-in panel: opens when a room is clicked. Summary (trend, min/avg/max,
         door strip, latest readings) is drawn from the same _HistoryList response
         that feeds the full table/charts below it. -->
    <aside id="erDrawer" class="erx-drawer" aria-hidden="true" aria-label="Room history">
        <div class="erx-dr-head">
            <div style="min-width:0;">
                <div class="erx-dr-titleline">
                    <h4 id="erDrName">Room</h4>
                </div>
                <span class="erx-meta" id="erHistMeta"></span>
            </div>
            <div class="erx-dr-btns">
                <button type="button" class="erx-dr-close" onclick="erStepRoom(-1)" title="Previous room" aria-label="Previous room"><i class="fas fa-chevron-up"></i></button>
                <button type="button" class="erx-dr-close" onclick="erStepRoom(1)" title="Next room" aria-label="Next room"><i class="fas fa-chevron-down"></i></button>
                <button type="button" class="erx-dr-close" onclick="erCloseDrawer()" title="Close" aria-label="Close panel"><i class="fas fa-times"></i></button>
            </div>
        </div>
        <div class="erx-dr-body">
            <div class="erx-dr-live">
                <div><span class="k-label">Temperature</span><span class="k-val val-temp" id="erDrTemp">--</span></div>
                <div><span class="k-label">Humidity</span><span class="k-val val-hum" id="erDrHum">--</span></div>
                <div id="erDrDoorNow" style="display:none;"><span class="k-label">Door</span><span id="erDrDoorBadge"></span></div>
            </div>

            <div class="erx-dr-tools">
                <div class="erx-seg sm" role="group" aria-label="Metric" id="erDrMetric">
                    <button type="button" data-metric="temp" class="active">Temperature</button>
                    <button type="button" data-metric="hum">Humidity</button>
                </div>
                <div class="erx-seg sm" role="group" aria-label="Quick range" id="erPresets">
                    <button type="button" data-preset="1h">1h</button>
                    <button type="button" data-preset="6h">6h</button>
                    <button type="button" data-preset="today" class="active">Today</button>
                    <button type="button" data-preset="24h">24h</button>
                    <button type="button" data-preset="7d">7 days</button>
                </div>
            </div>

            <div class="erx-dr-chart"><canvas id="erDrChart" role="img" aria-label="Trend of the selected room for the chosen range"></canvas><div id="erDrChartMsg" class="erx-dr-msg">Loading…</div></div>

            <div class="erx-dr-stats">
                <div><span class="k-label">Min</span><span class="k-val" id="erDrMin">--</span></div>
                <div><span class="k-label">Average</span><span class="k-val" id="erDrAvg">--</span></div>
                <div><span class="k-label">Max</span><span class="k-val" id="erDrMax">--</span></div>
                <div><span class="k-label">Records</span><span class="k-val" id="erDrCount">--</span></div>
            </div>

            <div id="erDrDoorWrap" style="display:none;">
                <div class="erx-dr-title">Door activity <span class="erx-meta" id="erDrDoorInfo"></span></div>
                <div class="erx-dr-doorstrip" id="erDrDoorStrip"></div>
                <div class="erx-dr-doorlegend"><span><i style="background:var(--e7-green, #16a34a)"></i>Open</span><span><i style="background:var(--e7-amber, #f59e0b)"></i>Closed</span></div>
            </div>

            <div class="erx-dr-title">Latest readings</div>
            <table class="table table-sm erx-dr-latest">
                <thead><tr><th>Date &amp; Time</th><th class="text-center">Temp</th><th class="text-center">Humidity</th><th class="text-center">Door</th></tr></thead>
                <tbody id="erDrLatest"><tr><td colspan="4" class="text-center text-muted">--</td></tr></tbody>
            </table>

            <button type="button" class="erx-btn-link erx-dr-fullbtn" id="erDrFullBtn" onclick="erToggleFullHistory()"><i class="fas fa-table mr-1"></i> <span>Full history, charts and export</span></button>

            <div id="erDrFull" style="display:none;">
                <div class="erx-dr-filter">
                    <div class="filter-item">
                        <span>From Date</span>
                        <input type="text" class="form-control" id="txtFromDate" placeholder="Select" readonly />
                    </div>
                    <div class="filter-item">
                        <span>From Time</span>
                        <div class="time-24-wrapper">
                            <input type="text" class="form-control time-24" id="txtFromTime" placeholder="HH:MM" maxlength="5" autocomplete="off" readonly />
                            <i class="fas fa-clock time-24-icon"></i>
                        </div>
                    </div>
                    <div class="filter-item">
                        <span>To Date</span>
                        <input type="text" class="form-control" id="txtToDate" placeholder="Select" readonly />
                    </div>
                    <div class="filter-item">
                        <span>To Time</span>
                        <div class="time-24-wrapper">
                            <input type="text" class="form-control time-24" id="txtToTime" placeholder="HH:MM" maxlength="5" autocomplete="off" readonly />
                            <i class="fas fa-clock time-24-icon"></i>
                        </div>
                    </div>
                    <div class="filter-item" style="position:relative; z-index:100;">
                        <span>History View</span>
                        <div class="er-view-selector">
                            <div class="er-view-btn" id="erViewBtn" onclick="toggleErViewDropdown()">
                                <span><i class="fas fa-table mr-1"></i> Table</span>
                                <i class="fas fa-chevron-down" style="font-size:11px; color:var(--e7-text-3, #999);"></i>
                            </div>
                            <div class="er-view-dropdown" id="erViewDropdown">
                                <div class="er-view-item checked" data-value="Table" onclick="selectErView(this)"><i class="fas fa-table"></i><span>Table</span></div>
                                <div class="er-view-item" data-value="Pie" onclick="selectErView(this)"><i class="fas fa-chart-pie"></i><span>Pie</span></div>
                                <div class="er-view-item" data-value="Bar" onclick="selectErView(this)"><i class="fas fa-chart-bar"></i><span>Bar</span></div>
                                <div class="er-view-item" data-value="Graph" onclick="selectErView(this)"><i class="fas fa-chart-line"></i><span>Graph</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="filter-item">
                        <span>&nbsp;</span>
                        <button type="button" class="btn-search" onclick="fnSearchHistory()" title="Apply range" aria-label="Apply range">
                            <img src="~/Areas/FRS25/assets/img/search.svg" alt="">
                        </button>
                    </div>
                </div>
                <div id="divEquipmentRoomHistory"></div>
            </div>
        </div>
    </aside>
</section>

<script>
    // ==========================================================================
    // GLOBALS
    // ==========================================================================
    var erMode = 'both';               // both | live | history
    var erLiveView = 'rank';           // rank | cards | table
    var erRankSort = 'risk';           // risk | name
    var erRise = {};                   // room -> temperature rise today (°C), from the sparkline data
    var erSparkXhr = null, erHeatXhr = null;
    var erHeat = null;                 // 7-day hourly averages of the panel's room
    var erPinned = false;
    var erDrDoorOpens = [];            // Date of every door-open transition in the loaded range
    var erLiveLoadedSite = null;
    var erHistoryLoaded = false;
    var erSelectedView = 'Table';      // read by _HistoryList (Table / Pie / Bar / Graph)
    var erLiveObserver = null;
    var erRecalcTimer = null;
    var erLastLiveUpdate = null;
    var erLiveXhr = null, erHistXhr = null;

    var tpCurrentInputId = null, tpSelectedHour = 0, tpSelectedMinute = 0;

    var ER_IMG = {
        doorClose: '@Url.Content("~/Areas/FRS25/assets/img/icon_close_door.svg")',
        temp: '@Url.Content("~/Areas/FRS25/assets/img/temperature.svg")',
        hum: '@Url.Content("~/Areas/FRS25/assets/img/humidity.svg")'
    };

    function erEscHtml(v) {
        if (v === null || v === undefined) return '';
        return String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function erWarn(msg) { if (typeof showWarning === 'function') showWarning(msg, 'Validation'); else alert(msg); }
    function erError(msg) {
        if (typeof showError === 'function') showError(msg, 'Error');
        else if (typeof CommonNotification === 'function') CommonNotification('ERROR', msg, 'Error');
        else alert(msg);
    }
    function erPad(n) { return ('0' + n).slice(-2); }
    function erNowHMS() { var d = new Date(); return erPad(d.getHours()) + ':' + erPad(d.getMinutes()) + ':' + erPad(d.getSeconds()); }

    // write to the DOM only when the value actually changes (prevents repaint loops)
    function erSetText($el, txt) { if ($el.length && $el.text() !== txt) $el.text(txt); }
    function erSetHtml($el, html) { if ($el.length && $el.html() !== html) $el.html(html); }
    function erSetClass($el, cls) { if ($el.length && $el.attr('class') !== cls) $el.attr('class', cls); }

    // ==========================================================================
    // MODE
    // ==========================================================================
    // History no longer has its own page section: it opens in the slide-in
    // panel (#erDrawer) for one room at a time.
    var erDrawerRoom = null;           // room shown in the panel
    var erDrMetric = 'temp';           // temp | hum
    var erDrChartObj = null;
    var erDrFullOpen = false;
    var erDrPts = [];                  // parsed history points of the panel's room, oldest first

    function erSetLiveView(view) {
        erLiveView = view;
        $('#erLiveViewRank').toggleClass('active', view === 'rank');
        $('#erLiveViewCards').toggleClass('active', view === 'cards');
        $('#erLiveViewTable').toggleClass('active', view === 'table');
        try { localStorage.setItem('erLiveView2', view); } catch (e) { }
        if (!erLiveLoadedSite) return;
        erShowLiveView();
    }

    function erShowLiveView() {
        $('#erLiveRank').toggle(erLiveView === 'rank');
        $('#erLiveCards').toggle(erLiveView === 'cards');
        $('#erLiveTableWrap').toggle(erLiveView === 'table');
    }

    // Safe limits come from the live partial (_List) when it is loaded
    function erLimits() {
        return {
            tMin: typeof TEMP_MIN === 'number' ? TEMP_MIN : 25, tMax: typeof TEMP_MAX === 'number' ? TEMP_MAX : 45,
            hMin: typeof HUM_MIN === 'number' ? HUM_MIN : 40, hMax: typeof HUM_MAX === 'number' ? HUM_MAX : 70
        };
    }

    // History rows without touching the page: the _HistoryList response carries
    // them as "var erRows = [...]", which is read out of the returned markup.
    // Row: [Zone, Division, Station, "dd/MM/yyyy HH:mm:ss", Room, Temp, Hum, Door], newest first.
    function erFetchRows(rooms, from, to, done, fail) {
        var m = { SearchCriteria: {}, Pager: {} };
        m.SearchCriteria.ZoneIds = [];
        m.SearchCriteria.DivisionIds = [];
        m.SearchCriteria.SiteIds = [$('#drpSite').val()];
        m.SearchCriteria.AssetIds = [];
        m.SearchCriteria.AlertInfoIds = [];
        m.SearchCriteria.AcknowledgemenStatusIds = [];
        m.SearchCriteria.StartDate = toServerDate(formatDateForInput(from));
        m.SearchCriteria.EndDate = toServerDate(formatDateForInput(to));
        m.SearchCriteria.StartTime = formatTimeForInput(from);
        m.SearchCriteria.EndTime = formatTimeForInput(to);
        m.SearchCriteria.siteAttributeDatasList = rooms;
        return $.ajax({
            url: '/FRS25/EquipmentRoom/_HistoryList',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(m),
            dataType: 'text',
            success: function (html) {
                var rows = null;
                try {
                    var mt = /var erRows = (\[[\s\S]*?\]);\s*[\r\n]/.exec(html);
                    if (mt) rows = JSON.parse(mt[1]);
                } catch (e) { rows = null; }
                if (rows) done(rows); else if (fail) fail();
            },
            error: function (xhr, status) { if (status !== 'abort' && fail) fail(); }
        });
    }

    // ==========================================================================
    // RANKED LIST — sparklines (today's temperature) + risk ordering
    // ==========================================================================
    function erLoadSparks() {
        if (erSparkXhr) erSparkXhr.abort();
        erRise = {};
        var to = new Date(), from = new Date(to.getTime());
        from.setHours(0, 0, 0, 0);
        var site = $('#drpSite').val();
        erSparkXhr = erFetchRows([], from, to, function (rows) {
            if (site !== $('#drpSite').val()) return;
            var byRoom = {};
            for (var i = rows.length - 1; i >= 0; i--) {          // oldest -> newest
                var v = erDrNum(rows[i][5]);
                if (v === null) continue;
                (byRoom[rows[i][4]] = byRoom[rows[i][4]] || []).push(v);
            }
            $('#erRankList .erx-rank-row').each(function () {
                var room = $(this).attr('data-room'), vals = byRoom[room] || [];
                var $sp = $(this).find('.rk-spark'), $tr = $(this).find('.rk-trend');
                if (vals.length < 2) { $sp.empty(); $tr.text('').removeClass('is-up'); return; }
                var step = Math.max(1, Math.ceil(vals.length / 40)), pts = [];
                for (var k = 0; k < vals.length; k += step) pts.push(vals[k]);
                pts.push(vals[vals.length - 1]);
                var mn = Infinity, mx = -Infinity;
                for (var a = 0; a < vals.length; a++) { if (vals[a] < mn) mn = vals[a]; if (vals[a] > mx) mx = vals[a]; }
                var span = (mx - mn) || 1, d = '';
                for (var p = 0; p < pts.length; p++) {
                    d += (p ? 'L' : 'M') + (p * 108 / (pts.length - 1) + 1).toFixed(1) + ' ' + (25 - (pts[p] - mn) / span * 22).toFixed(1) + ' ';
                }
                $sp.html('<svg width="110" height="28" viewBox="0 0 110 28" aria-hidden="true"><path d="' + d + '" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" style="color:var(--e7-accent, #2563eb)"/></svg>');
                var rise = vals[vals.length - 1] - mn, fall = mx - vals[vals.length - 1];
                erRise[room] = rise;
                if (rise >= 1) $tr.text('▲ ' + rise.toFixed(1) + ' °C').toggleClass('is-up', rise >= 5).attr('title', 'Rise since today\'s lowest reading');
                else if (fall >= 1) $tr.text('▼ ' + fall.toFixed(1) + ' °C').removeClass('is-up').attr('title', 'Drop since today\'s highest reading');
                else $tr.text('Steady').removeClass('is-up').attr('title', '');
            });
            if (erLiveLoadedSite) erRecalcLive();
        });
    }

    function erRankUpdate(statusByRoom) {
        var $list = $('#erRankList'), rows = $list.children('.erx-rank-row').get();
        if (!rows.length) return;
        var score = function (el) {
            var room = el.getAttribute('data-room'), st = statusByRoom[room] || 'wait';
            return (st === 'warn' ? 1000 : 0) + (erRise[room] || 0);
        };
        var sorted = rows.slice().sort(function (a, b) {
            if (erRankSort === 'risk') { var d = score(b) - score(a); if (d !== 0) return d; }
            var x = a.getAttribute('data-room'), y = b.getAttribute('data-room');
            return x < y ? -1 : (x > y ? 1 : 0);
        });
        for (var i = 0; i < rows.length; i++) {
            if (rows[i] !== sorted[i]) { $list.append(sorted); break; }   // reorder only when the order changed
        }
    }

    function erStepRoom(dir) {
        var sel = erLiveView === 'cards' ? '#erLiveCards .erx-room' : (erLiveView === 'table' ? '#erLiveTbody tr' : '#erRankList .erx-rank-row');
        var rooms = [];
        $(sel).each(function () { if ($(this).css('display') !== 'none') rooms.push($(this).attr('data-room')); });
        if (!rooms.length) return;
        var i = rooms.indexOf(erDrawerRoom);
        erOpenRoomHistory(rooms[(i + dir + rooms.length) % rooms.length]);
    }

    function erTogglePin(force) {
        erPinned = (typeof force === 'boolean') ? force : !erPinned;
        $('#erDrPin').toggleClass('is-on', erPinned).attr('aria-pressed', erPinned ? 'true' : 'false');
        $('#erPage').toggleClass('erx-pinned', erPinned);
        try { localStorage.setItem('erPinned', erPinned ? '1' : '0'); } catch (e) { }
    }

    function erMarkSelected() {
        $('#erLiveCards .erx-room, #erRankList .erx-rank-row').each(function () {
            $(this).toggleClass('is-selected', !!erDrawerRoom && $(this).attr('data-room') === erDrawerRoom);
        });
    }

    // ==========================================================================
    // SEARCH
    // ==========================================================================
    function erApply() {
        var site = $('#drpSite').val();
        if (!site || site === '0') { erWarn('Please select station.'); return; }
        erLoadLive();
        if (erDrawerRoom) fnSearchHistory();
    }

    // ==========================================================================
    // LIVE — the original _List partial is loaded off-screen; its WebSocket code
    // writes into every element with its hook classes, and the cards below carry
    // the same hook classes, so they update live.
    // ==========================================================================
    function erLoadLive() {
        var site = $('#drpSite').val();
        if (!site || site === '0') return;
        if (erLiveXhr) erLiveXhr.abort();

        // section skeleton instead of the full-page loader
        $('#erLiveEmpty, #erLiveTableWrap, #erLiveRank').hide();
        $('#erLiveCards').html('<div class="erx-skel"></div><div class="erx-skel"></div><div class="erx-skel"></div>').show();
        erSetText($('#erLiveMeta'), 'Loading…');

        var m = { SearchCriteria: { SiteId: site, ZoneId: $('#drpZone').val(), DivisionId: $('#drpDivision').val() } };
        erLiveXhr = $.ajax({
            url: '/FRS25/EquipmentRoom/_List',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(m),
            dataType: 'html',
            success: function (html) {
                erStopLive();
                // _List uses ids that _HistoryList also uses — rename the live copies
                html = html
                    .replace(/listView/g, 'erLiveRawList')
                    .replace(/pictorialView/g, 'erLiveRawPictorial')
                    .replace(/tblEquipmentRoom/g, 'erLiveRawTable');
                $('#erLiveRaw').empty().append(html);
                erLiveLoadedSite = site;
                erWaitForLiveModel(0);
            },
            error: function (xhr, status) {
                if (status === 'abort') return;
                $('#erLiveCards').hide().empty();
                $('#erLiveEmpty').html('<i class="fas fa-exclamation-triangle"></i>Could not load live data. Please try again.').show();
                erSetText($('#erLiveMeta'), '');
                erError('Something went wrong while loading live data!');
            },
            complete: function () { erLiveXhr = null; }
        });
    }

    // _List assigns its model (window.json) inside $(document).ready, which runs a tick later
    function erWaitForLiveModel(tries) {
        if (window.json && window.json.mAssets) { erBuildLive(window.json); return; }
        if (tries > 40) { erBuildLive(null); return; }
        setTimeout(function () { erWaitForLiveModel(tries + 1); }, 50);
    }

    function erStopLive() {
        if (typeof window.disconnectWebSocket === 'function') { try { window.disconnectWebSocket(); } catch (e) { } }
        if (erLiveObserver) { erLiveObserver.disconnect(); erLiveObserver = null; }
        clearTimeout(erRecalcTimer);
    }

    function erFindRoomParts(item, room) {
        var attrs = item.assetAttributes || [], temp = null, hum = null, dl = null;
        for (var i = 0; i < attrs.length; i++) {
            var t = attrs[i].Title || '';
            if (!(t.length >= room.length && t.substr(t.length - room.length) === room)) continue;
            var tl = t.toLowerCase();
            if (!temp && tl.indexOf('temperature') > -1) temp = attrs[i];
            if (!hum && tl.indexOf('humidity') > -1) hum = attrs[i];
        }
        var dls = item.mAssetInfoDataloggers || [];
        for (var j = 0; j < dls.length; j++) {
            if ((dls[j].DataloggerAttribute || '').indexOf(room) === 0 && dls[j].DataloggerAttributeId > 0) { dl = dls[j]; break; }
        }
        return {
            tempHook: (temp && temp.Id > 0) ? 'hdnAttributeData' + temp.Id + item.Id : null,
            humHook: (hum && hum.Id > 0) ? 'hdnAttributeData' + hum.Id + item.Id : null,
            doorHook: dl ? 'DLAttribute' + item.Id + dl.DataloggerAttributeId : null,
            doorImgHook: dl ? 'hdnImgRelayRoom' + item.Id + dl.DataloggerAttributeId : null,
            doorTimeHook: dl ? 'rcptime' + item.Id + dl.DataloggerAttributeId : null
        };
    }

    function erValueEl(hook, kind) {
        var cls = kind === 'temp' ? 'val-temp' : 'val-hum';
        return hook
            ? '<strong class="erx-v ' + cls + ' ' + hook + '" data-kind="' + kind + '" data-hook="' + hook + '">--</strong>'
            : '<strong class="erx-v ' + cls + '" data-kind="' + kind + '">—</strong>';
    }

    function erBuildLive(model) {
        var cards = '', rows = '', rank = '', n = 0;
        var assets = (model && model.mAssets) ? model.mAssets : [];
        var estTip = 'Sensor reading was outside the valid range — showing the configured default value';

        assets.forEach(function (item) {
            (item.siteAttributeDatasList || []).forEach(function (room) {
                n++;
                var p = erFindRoomParts(item, room), r = erEscHtml(room);
                var histBtn = '<button type="button" class="erx-btn-link" data-room="' + r + '" onclick="erOpenRoomHistory(this.getAttribute(\'data-room\'))">History</button>';

                cards +=
                    '<div class="room-card-pictorial erx-room" data-room="' + r + '">' +
                      '<div class="rcp-header">' +
                        '<span class="rcp-title">' + r + '<span class="erx-sub">' + erEscHtml(item.SiteName) + '</span></span>' +
                      '</div>' +
                      '<div class="rcp-body">' +
                        '<div class="rcp-icon"><img class="' + (p.doorImgHook || '') + '" src="' + ER_IMG.doorClose + '" alt="" /></div>' +
                        '<div class="rcp-metrics">' +
                          '<div class="rcp-row"><span class="rcp-chip"><img src="' + ER_IMG.temp + '" alt="" /></span>' +
                            '<div class="rcp-row-inner"><div class="rcp-row-top"><span class="label-text">Temp :</span>' +
                              '<span class="erx-val-wrap">' + erValueEl(p.tempHook, 'temp') + '<span class="erx-est" style="display:none" title="' + estTip + '">Est.</span></span></div>' +
                              '<span class="erx-gauge g-temp"><span></span></span></div></div>' +
                          '<div class="rcp-row"><span class="rcp-chip"><img src="' + ER_IMG.hum + '" alt="" /></span>' +
                            '<div class="rcp-row-inner"><div class="rcp-row-top"><span class="label-text">Humidity :</span>' +
                              '<span class="erx-val-wrap">' + erValueEl(p.humHook, 'hum') + '<span class="erx-est" style="display:none" title="' + estTip + '">Est.</span></span></div>' +
                              '<span class="erx-gauge g-hum"><span></span></span></div></div>' +
                        '</div>' +
                      '</div>' +
                      '<div class="erx-foot">' +
                        '<div class="erx-door">' +
                          (p.doorHook
                            ? '<span>Door</span><a class="dl-badge-wrap erx-door-badge ' + p.doorHook + '" data-hook="' + p.doorHook + '"></a><span class="rcp-meta-time ' + p.doorTimeHook + '" data-hook="' + p.doorTimeHook + '"></span>'
                            : '<span>No door sensor</span>') +
                        '</div>' +
                        histBtn +
                      '</div>' +
                    '</div>';

                rank +=
                    '<div class="erx-rank-row" data-room="' + r + '" tabindex="0" role="button">' +
                      '<div class="rk-name" title="' + r + '">' + r + '</div>' +
                      '<div class="rk-spark"></div>' +
                      '<div class="rk-val">' + (p.tempHook ? '<strong class="val-temp ' + p.tempHook + '" data-hook="' + p.tempHook + '">--</strong>' : '—') + '</div>' +
                      '<div class="rk-val">' + (p.humHook ? '<strong class="val-hum ' + p.humHook + '" data-hook="' + p.humHook + '">--</strong>' : '—') + '</div>' +
                      '<div class="rk-door">' + (p.doorHook ? '<a class="' + p.doorHook + '" data-hook="' + p.doorHook + '"></a>' : '') + '</div>' +
                      '<div class="rk-trend"></div>' +
                      '<i class="fas fa-chevron-right rk-go" aria-hidden="true"></i>' +
                    '</div>';

                rows +=
                    '<tr data-room="' + r + '">' +
                      '<td>' + n + '</td><td>' + erEscHtml(item.Zone) + '</td><td>' + erEscHtml(item.Division) + '</td>' +
                      '<td>' + erEscHtml(item.SiteName) + '</td><td>' + r + '</td>' +
                      '<td class="text-center">' + (p.tempHook ? '<span class="' + p.tempHook + '" data-hook="' + p.tempHook + '"></span>' : '') + '</td>' +
                      '<td class="text-center">' + (p.humHook ? '<span class="' + p.humHook + '" data-hook="' + p.humHook + '"></span>' : '') + '</td>' +
                      '<td class="text-center">' + (p.doorHook ? '<a class="' + p.doorHook + '" data-hook="' + p.doorHook + '"></a>' : '') + '</td>' +
                      '<td class="text-center">' + histBtn + '</td>' +
                    '</tr>';
            });
        });

        if (n === 0) {
            $('#erLiveCards').hide().empty();
            $('#erLiveTbody, #erRankList').empty();
            $('#erLiveTableWrap, #erKpis, #erLiveRank').hide();
            $('#erLiveEmpty').html('<i class="fas fa-inbox"></i>No equipment rooms are configured for this station.').show();
            erSetText($('#erLiveMeta'), '');
            return;
        }

        $('#erLiveCards').html(cards);
        $('#erLiveTbody').html(rows);
        $('#erRankList').html(rank);
        $('#erLiveEmpty').hide();
        erShowLiveView();
        $('#erKpis').show();
        erLoadSparks();

        // copy values that arrived before the cards existed
        $('#erLiveCards [data-hook], #erLiveTbody [data-hook], #erRankList [data-hook]').each(function () {
            var $src = $('#erLiveRaw .' + this.getAttribute('data-hook')).first();
            if ($src.length && $src.html()) $(this).html($src.html());
        });

        // React ONLY to WebSocket writes into hook elements. (The previous
        // version also reacted to its own status/gauge updates, which made it
        // recalculate forever and caused the flicker.)
        if (window.MutationObserver) {
            erLiveObserver = new MutationObserver(function (muts) {
                for (var i = 0; i < muts.length; i++) {
                    var node = muts[i].target;
                    if (node.nodeType === 3) node = node.parentNode;
                    if (node && node.closest && node.closest('[data-hook]')) {
                        erLastLiveUpdate = erNowHMS();
                        clearTimeout(erRecalcTimer);
                        erRecalcTimer = setTimeout(erRecalcLive, 250);
                        return;
                    }
                }
            });
            erLiveObserver.observe(document.getElementById('erLiveCards'), { childList: true, subtree: true, characterData: true });
        }
        erApplyRoomFilter();
    }

    // The partial adds a trailing "." when it substituted a configured default
    function erReadValue($el) {
        var txt = ($el.text() || '').trim(), num = parseFloat(txt);
        return { has: !isNaN(num), num: num, est: /\.\s*$/.test(txt) };
    }

    function erStatusMeta(st) {
        if (st === 'warn') return { cls: 'badge badge-warning text-white erx-status', txt: 'Out of range' };
        if (st === 'ok') return { cls: 'badge badge-success erx-status', txt: 'Normal' };
        return { cls: 'badge badge-secondary erx-status', txt: 'Waiting' };
    }

    function erRecalcLive() {
        var visible = 0, reporting = 0, estRooms = [];
        var tSum = 0, tN = 0, tMax = null, tMaxRoom = '', hSum = 0, hN = 0, hMax = null, hMaxRoom = '';
        var open = 0, closed = 0, doorRooms = [], statusByRoom = {};

        $('#erLiveCards .erx-room').each(function () {
            var $c = $(this), room = $c.attr('data-room');
            var $t = $c.find('.erx-v[data-kind=temp]'), $h = $c.find('.erx-v[data-kind=hum]');
            var t = erReadValue($t), h = erReadValue($h);
            var tEst = t.has && t.est, hEst = h.has && h.est;

            $c.find('.g-temp').children().css('width', t.has ? Math.max(0, Math.min(100, t.num * 2)) + '%' : '0');
            $c.find('.g-hum').children().css('width', h.has ? Math.max(0, Math.min(100, h.num)) + '%' : '0');

            // no status of our own: a room is only "reporting" or still waiting for its first value
            var st = (!t.has && !h.has) ? 'wait' : 'ok';
            statusByRoom[room] = st;
            var meta = erStatusMeta(st), $badge = $c.find('.erx-status');
            erSetClass($badge, meta.cls); erSetText($badge, meta.txt);
            $c.toggleClass('is-warn', st === 'warn');

            if ($c.css('display') === 'none') return;          // KPIs follow the room filter
            visible++;
            if (st !== 'wait') reporting++;
            if (tEst || hEst) estRooms.push(room);
            if (t.has) { tSum += t.num; tN++; if (tMax === null || t.num > tMax) { tMax = t.num; tMaxRoom = room; } }
            if (h.has) { hSum += h.num; hN++; if (hMax === null || h.num > hMax) { hMax = h.num; hMaxRoom = room; } }
            var door = ($c.find('.erx-door-badge').text() || '').trim().toLowerCase();
            if (door === 'open') { open++; doorRooms.push(room + ': open'); }
            else if (door === 'close') { closed++; doorRooms.push(room + ': closed'); }
        });

        $('#erLiveTbody tr, #erRankList .erx-rank-row').each(function () {
            var st = statusByRoom[$(this).attr('data-room')] || 'wait', meta = erStatusMeta(st), $b = $(this).find('.erx-status');
            $(this).toggleClass('is-warn', st === 'warn');
            erSetClass($b, meta.cls); erSetText($b, meta.txt);
        });
        erRankUpdate(statusByRoom);

        erSetHtml($('#kpiRooms'), reporting + ' <small>/ ' + visible + '</small>');
        erSetText($('#kpiRoomsSub'), visible === 0 ? '' : (reporting === visible ? 'All sensors reporting' : (visible - reporting) + ' waiting for data'));
        erSetText($('#kpiAvgTemp'), tN ? (tSum / tN).toFixed(1) + ' °C' : '--');
        erSetText($('#kpiMaxTemp'), tMax !== null ? tMax.toFixed(1) + ' °C' : '--');
        erSetText($('#kpiMaxTempRoom'), tMaxRoom);
        erSetText($('#kpiAvgHum'), hN ? (hSum / hN).toFixed(1) + ' %' : '--');
        erSetText($('#kpiMaxHum'), hMax !== null ? 'Peak ' + hMax.toFixed(1) + ' % · ' + hMaxRoom : '');
        erSetText($('#kpiEst'), String(estRooms.length));
        $('#kpiEstCard').toggleClass('is-warn', estRooms.length > 0);
        erSetText($('#kpiEstSub'), estRooms.length ? estRooms.join(', ') : 'All readings in range');
        erSetHtml($('#kpiDoors'), open + closed === 0 ? '--' : open + ' <small>open</small> · ' + closed + ' <small>closed</small>');
        erSetText($('#kpiDoorsSub'), doorRooms.join(', '));
        erSetText($('#erLiveMeta'), $('#drpSite option:selected').text() + (erLastLiveUpdate ? ' · updated ' + erLastLiveUpdate : ' · waiting for first reading'));
        erSyncDrawerLive();
    }

    function erFindCard(room) {
        return $('#erLiveCards .erx-room').filter(function () { return $(this).attr('data-room') === room; }).first();
    }

    // live values in the panel header are mirrored from the room's card
    function erSyncDrawerLive() {
        if (!erDrawerRoom) return;
        var $c = erFindCard(erDrawerRoom);
        if (!$c.length) return;
        erSetText($('#erDrTemp'), ($c.find('.erx-v[data-kind=temp]').text() || '--').replace(/\.\s*$/, ''));
        erSetText($('#erDrHum'), ($c.find('.erx-v[data-kind=hum]').text() || '--').replace(/\.\s*$/, ''));

        // safe-range gauges: temperature scale 15..55 °C, humidity 0..100 %
        var L = erLimits(), pct = function (v, lo, hi) { return Math.max(0, Math.min(100, (v - lo) / (hi - lo) * 100)); };
        $('#erDrTBand').css({ left: pct(L.tMin, 15, 55) + '%', width: (pct(L.tMax, 15, 55) - pct(L.tMin, 15, 55)) + '%' });
        $('#erDrHBand').css({ left: L.hMin + '%', width: (L.hMax - L.hMin) + '%' });
        erSetText($('#erDrTSafe'), 'safe ' + L.tMin + ' to ' + L.tMax + ' °C');
        erSetText($('#erDrHSafe'), 'safe ' + L.hMin + ' to ' + L.hMax + ' %');
        var t = erReadValue($c.find('.erx-v[data-kind=temp]')), h = erReadValue($c.find('.erx-v[data-kind=hum]'));
        // a trailing "." means the sensor value was out of range and a default is shown
        $('#erDrTMark').toggle(t.has).toggleClass('is-bad', t.est || t.num < L.tMin || t.num > L.tMax).css('left', t.has ? pct(t.num, 15, 55) + '%' : '0')
            .attr('title', t.est ? 'Sensor reading was out of range; a default value is shown' : '');
        $('#erDrHMark').toggle(h.has).toggleClass('is-bad', h.est || h.num < L.hMin || h.num > L.hMax).css('left', h.has ? pct(h.num, 0, 100) + '%' : '0')
            .attr('title', h.est ? 'Sensor reading was out of range; a default value is shown' : '');
        var $b = $c.find('.erx-status');
        erSetHtml($('#erDrStatus'), '<span class="' + ($b.attr('class') || '').replace('erx-status', '') + '">' + erEscHtml($b.text()) + '</span>');
