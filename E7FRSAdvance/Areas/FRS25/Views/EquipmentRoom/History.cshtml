@{ ViewBag.Title = "Equipment Room History";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml"; }

<style>
    @@keyframes progressShrink {
        from {
            width: 100%;
        }

        to {
            width: 0%;
        }
    }

    /* ===== FILTER & BUTTON STYLES ===== */
    .btn-search {
        background: var(--primary);
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        color: #fff;
        font-size: 14px;
        font-weight: 500;
        transition: background 0.2s;
    }

        .btn-search:hover {
            background: #3c3ebf;
        }

    .dropdown-menu.dropdown-menu-right .dropdown-item {
        padding: 10px 15px;
        font-size: 14px;
        display: flex;
        align-items: center;
        background: transparent;
    }

        .dropdown-menu.dropdown-menu-right .dropdown-item:hover {
            background: #f1f5f9;
        }

    #btnDownload + .dropdown-menu {
        min-width: 130px;
        padding: 8px 0;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
        border: 1px solid #e2e8f0;
    }

    /* ===== HISTORY TABLE ===== */
    .history-table-wrapper {
        max-height: 600px;
        overflow: auto;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
    }

    .history-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .history-table thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background: #1e3a5f;
            color: #fff;
            padding: 10px 12px;
            text-align: center;
            font-weight: 600;
            font-size: 12px;
            border: 1px solid #163050;
            white-space: nowrap;
        }

        .history-table thead tr:first-child th {
            position: sticky;
            top: 0;
            z-index: 12;
        }

        .history-table thead tr:nth-child(2) th {
            position: sticky;
            top: 38px;
            z-index: 11;
        }

        .history-table thead th:first-child {
            position: sticky;
            left: 0;
            z-index: 20;
            background: #162d4a;
            min-width: 160px;
        }

        .history-table tbody td {
            padding: 8px 10px;
            text-align: center;
            border: 1px solid #e2e8f0;
            white-space: nowrap;
        }

            .history-table tbody td:first-child {
                position: sticky;
                left: 0;
                z-index: 5;
                background: #f8fafc;
                font-weight: 600;
                color: #1e3a5f;
                text-align: left;
                min-width: 160px;
            }

        .history-table tbody tr:nth-child(even) td {
            background: #f1f5f9;
        }

            .history-table tbody tr:nth-child(even) td:first-child {
                background: #e8edf3;
            }

        .history-table tbody tr:hover td {
            background: #dbeafe;
        }

            .history-table tbody tr:hover td:first-child {
                background: #bfdbfe;
            }

    .datetime-input {
        display: flex;
        gap: 6px;
        align-items: center;
    }

        .datetime-input input {
            border: 1px solid #d1d5db;
            border-radius: 6px;
            padding: 6px 10px;
            font-size: 13px;
            height: 38px;
        }

            .datetime-input input:focus {
                border-color: #3b82f6;
                outline: none;
                box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
            }

    /* ===== MULTI-SELECT DROPDOWN STYLES ===== */
    .select-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 14px;
        color: #333;
        cursor: pointer;
        min-width: 170px;
        height: 40px;
    }

        .select-btn:hover {
            border-color: #999;
        }

        .select-btn.active {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

        .select-btn .text {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            text-align: left;
        }

        .select-btn i {
            margin-left: 8px;
            font-size: 12px;
            color: #666;
        }

    .filter-dropdown {
        position: fixed;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
        min-width: 260px;
        max-width: 320px;
        z-index: 9999;
        display: none;
    }

        .filter-dropdown.open {
            display: block;
        }

    .ms-dropdown-search {
        padding: 10px 12px;
        border-bottom: 1px solid #e0e0e0;
    }

        .ms-dropdown-search input {
            width: 100%;
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s;
        }

            .ms-dropdown-search input:focus {
                border-color: #3b82f6;
            }

            .ms-dropdown-search input::placeholder {
                color: #aaa;
            }

    .ms-dropdown-header {
        padding: 10px 14px;
        background: #f5f5f5;
        border-bottom: 1px solid #e0e0e0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .ms-dropdown-header input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #3b82f6;
        }

        .ms-dropdown-header label {
            font-size: 14px;
            font-weight: 600;
            color: #333;
            cursor: pointer;
            margin: 0;
        }

    .ms-dropdown-list {
        max-height: 250px;
        overflow-y: auto;
    }

    .ms-dropdown-item {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.15s;
    }

        .ms-dropdown-item:last-child {
            border-bottom: none;
        }

        .ms-dropdown-item:hover {
            background: #f5f7fa;
        }

        .ms-dropdown-item.checked {
            background: #e8f2ff;
        }

        .ms-dropdown-item.hidden {
            display: none;
        }

        .ms-dropdown-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #3b82f6;
            flex-shrink: 0;
        }

        .ms-dropdown-item span {
            font-size: 14px;
            color: #333;
        }

        .ms-dropdown-item.checked span {
            color: #1d4ed8;
            font-weight: 500;
        }

        .ms-dropdown-item span mark {
            background: #fef08a;
            color: #333;
            padding: 0;
            border-radius: 2px;
        }

    .ms-dropdown-empty {
        padding: 25px;
        text-align: center;
        color: #888;
        font-size: 14px;
    }

    .ms-dropdown-no-results {
        padding: 20px;
        text-align: center;
        color: #999;
        font-size: 13px;
        display: none;
    }

        .ms-dropdown-no-results.show {
            display: block;
        }

    .dropdown-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 9998;
        display: none;
    }

        .dropdown-backdrop.show {
            display: block;
        }

    /* ===== CHART STYLES ===== */
    .chart-container {
        padding: 20px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        margin: 15px 0;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .chart-title {
        font-size: 18px;
        font-weight: 600;
        color: #1e293b;
        margin: 0;
    }

    .chart-wrapper {
        position: relative;
        height: 450px;
        width: 100%;
    }

    .no-data-box {
        height: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        font-size: 16px;
    }

        .no-data-box i {
            font-size: 50px;
            margin-bottom: 15px;
            color: #cbd5e1;
        }

    /* View Type single-select items */
    .ms-dropdown-item-single {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.15s;
    }

        .ms-dropdown-item-single:last-child {
            border-bottom: none;
        }

        .ms-dropdown-item-single:hover {
            background: #f5f7fa;
        }

        .ms-dropdown-item-single.checked {
            background: #e8f2ff;
        }

            .ms-dropdown-item-single.checked span {
                color: #1d4ed8;
                font-weight: 500;
            }

        .ms-dropdown-item-single span {
            font-size: 14px;
            color: #333;
        }

        .ms-dropdown-item-single i {
            width: 20px;
            text-align: center;
            font-size: 14px;
            color: #64748b;
        }

        .ms-dropdown-item-single.checked i {
            color: #1d4ed8;
        }

    /* ===== CHANGED VALUE HIGHLIGHT (green) ===== */
    .history-table tbody td.val-changed {
        color: #047857 !important;
        background: #ecfdf5 !important;
        font-weight: 600;
    }

    .history-table tbody tr:nth-child(even) td.val-changed {
        background: #d1fae5 !important;
    }

    .history-table tbody tr:hover td.val-changed {
        background: #a7f3d0 !important;
    }

    /* ===== UNCHANGED VALUE HIGHLIGHT (soft muted) ===== */
    .history-table tbody td.val-unchanged {
        color: #78716c !important;
        background: #f5f5f4 !important;
    }

    .history-table tbody tr:nth-child(even) td.val-unchanged {
        background: #eeeceb !important;
    }

    .history-table tbody tr:hover td.val-unchanged {
        background: #e7e5e4 !important;
    }

    /* ===== DATALOGGER PICKUP / DROP ===== */
    .dl-pickup {
        color: #059669 !important;
        font-weight: 700;
    }

    .dl-drop {
        color: #dc2626 !important;
        font-weight: 700;
    }

    .attr-sub {
        display: block;
        font-size: 9px;
        font-weight: 400;
        opacity: 0.75;
        margin-top: 1px;
        letter-spacing: 0.5px;
    }

    /* Subscript-style for alias names: ITC → I<sub>TC</sub> (small lowered text) */
    .history-table thead th .alias-tc {
        font-size: 65%;
        vertical-align: sub;
        font-weight: inherit;
        letter-spacing: 0.2px;
    }

    /* ===== SINGLE-LINE FILTERS ===== */
    #filterContainer {
        display: flex !important;
        flex-wrap: nowrap !important;
        align-items: flex-end !important;
        gap: 8px;
        padding-bottom: 4px;
    }

        #filterContainer > div {
            flex: 0 0 auto;
            width: auto !important;
            min-width: 0;
            max-width: none;
            margin-top: 0 !important;
            padding: 0 2px;
        }

            #filterContainer > div > span {
                font-size: 12px;
                font-weight: 500;
                color: #475569;
                white-space: nowrap;
                display: block;
                margin-bottom: 4px;
            }

        #filterContainer .form-control,
        #filterContainer .select-btn {
            font-size: 13px;
            padding: 5px 10px;
            height: 36px;
            min-width: 90px;
        }

        #filterContainer input[type="date"] {
            min-width: 130px;
        }

        #filterContainer input[type="time"] {
            min-width: 100px;
        }

        #filterContainer .select-btn {
            min-width: 120px;
        }

        #filterContainer .btn-search {
            height: 36px;
            padding: 6px 14px;
        }



    /* ===== CHART STYLES ===== */
    .chart-container {
        padding: 20px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        margin: 15px 0;
    }

    .chart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .chart-title {
        font-size: 18px;
        font-weight: 600;
        color: #1e293b;
        margin: 0;
    }

    .chart-wrapper {
        position: relative;
        height: 450px;
        width: 100%;
    }

    .no-data-box {
        height: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        font-size: 16px;
    }

        .no-data-box i {
            font-size: 50px;
            margin-bottom: 15px;
            color: #cbd5e1;
        }

    /* ===== VIEW TYPE DROPDOWN ===== */
    .er-view-selector {
        position: relative;
        display: inline-block;
    }

    .er-view-btn {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        padding: 6px 12px;
        font-size: 13px;
        color: #333;
        cursor: pointer;
        min-width: 140px;
        height: 36px;
        gap: 8px;
    }

        .er-view-btn:hover {
            border-color: #999;
        }

        .er-view-btn.active {
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
        }

    .er-view-dropdown {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 4px;
        background: #fff;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
        min-width: 180px;
        z-index: 9999;
        display: none;
    }

        .er-view-dropdown.open {
            display: block;
        }

    .er-view-item {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        gap: 10px;
        cursor: pointer;
        border-bottom: 1px solid #f0f0f0;
        transition: background 0.15s;
    }

        .er-view-item:last-child {
            border-bottom: none;
        }

        .er-view-item:hover {
            background: #f5f7fa;
        }

        .er-view-item.checked {
            background: #e8f2ff;
        }

            .er-view-item.checked span {
                color: #1d4ed8;
                font-weight: 500;
            }

        .er-view-item span {
            font-size: 14px;
            color: #333;
        }

        .er-view-item i {
            width: 20px;
            text-align: center;
            font-size: 14px;
            color: #64748b;
        }

        .er-view-item.checked i {
            color: #1d4ed8;
        }
</style>

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

<!-- Backdrop for closing dropdowns -->
<div class="dropdown-backdrop" id="backdrop"></div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body p-0">
                <div class="row">
                    <div class="col-12 col-sm-5">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">EquipmentRoom</li>
                                <li class="breadcrumb-item active" aria-current="page"><a href="#">EquipmentRoom History</a></li>
                            </ol>
                        </nav>
                    </div>
                    <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                        <h2 class="page-name">EquipmentRoom History</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header mb-2">
                <h4 class="m-0">Search</h4>
            </div>
            <div class="card-body">
                <div class="mb-3" id="filterContainer">

                    <!-- Zone -->
                    <div class="filter-item">
                        <span>Zone</span>
                        @Html.DropDownList("ZoneId", (IEnumerable<SelectListItem>)ViewBag.Zones, "All", new { @class = "form-control", @id = "drpZones", tabindex = 1 })
                    </div>

                    <!-- Division -->
                    <div class="filter-item">
                        <span>Division</span>
                        @Html.DropDownList("DivisionId", (IEnumerable<SelectListItem>)ViewBag.Divisions, "All", new { @class = "form-control", @id = "drpDivisions", tabindex = 2 })
                    </div>

                    <!-- Station/Site — MULTI-SELECT -->
                    <div class="filter-item" style="position:relative; z-index:100;">
                        <span>Station</span>
                        <div class="select-btn" id="btnSite" data-target="ddSite">
                            <span class="text" id="txtSite">All</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </div>

                    <div class="filter-item" style="position:relative; z-index:100;">
                        <span>Equipment Room</span>
                        <div class="select-btn" id="btnEquipmentRoom" data-target="ddEquipmentRoom">
                            <span class="text" id="txtEquipmentRoom">All</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </div>

                    <!-- From Date -->
                    <div class="filter-item">
                        <span>From Date</span>
                        <input type="date" class="form-control" id="txtFromDate" />
                    </div>

                    <!-- From Time -->
                    <div class="filter-item">
                        <span>From Time</span>
                        <input type="time" class="form-control" id="txtFromTime" />
                    </div>

                    <!-- To Date -->
                    <div class="filter-item">
                        <span>To Date</span>
                        <input type="date" class="form-control" id="txtToDate" />
                    </div>

                    <!-- To Time -->
                    <div class="filter-item">
                        <span>To Time</span>
                        <input type="time" class="form-control" id="txtToTime" />
                    </div>

                    <!-- View Type — SINGLE-SELECT -->
                    <div class="filter-item" style="position:relative; z-index:100;">
                        <!-- View Type Dropdown (Single Select) -->
                        <div class="er-view-selector">
                            <div class="er-view-btn" id="erViewBtn" onclick="toggleErViewDropdown()">
                                <span><i class="fas fa-table mr-1"></i> Table</span>
                                <i class="fas fa-chevron-down" style="font-size:11px; color:#999;"></i>
                            </div>
                            <div class="er-view-dropdown" id="erViewDropdown">
                                <div class="er-view-item checked" data-value="Table" onclick="selectErView(this)">
                                    <i class="fas fa-table"></i>
                                    <span>Table</span>
                                </div>
                                <div class="er-view-item" data-value="Bar" onclick="selectErView(this)">
                                    <i class="fas fa-chart-bar"></i>
                                    <span>Bar Chart</span>
                                </div>
                                <div class="er-view-item" data-value="Pie" onclick="selectErView(this)">
                                    <i class="fas fa-chart-pie"></i>
                                    <span>Pie Chart</span>
                                </div>
                                <div class="er-view-item" data-value="Graph" onclick="selectErView(this)">
                                    <i class="fas fa-chart-line"></i>
                                    <span>Line Graph</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Search Button -->
                    <div class="filter-item">
                        <button type="button" class="btn-search" onclick="fnSearchHistory()">
                            <img src="~/Areas/FRS25/assets/img/search.svg">
                        </button>
                    </div>
                </div>

                <!-- ===== MULTI-SELECT DROPDOWNS ===== -->
                <!-- Site Dropdown -->
                <div class="filter-dropdown" id="ddSite">
                    <div class="ms-dropdown-search">
                        <input type="text" placeholder="Search station..." onkeyup="filterMsDropdown('site', this.value)">
                    </div>
                    <div class="ms-dropdown-header">
                        <input type="checkbox" id="chkAllSite">
                        <label for="chkAllSite">Select All</label>
                    </div>
                    <div class="ms-dropdown-list" id="listSite">
                        @if (ViewBag.Sites != null)
                        {
                            foreach (var site in (IEnumerable<SelectListItem>)ViewBag.Sites)
                            {
                                <div class="ms-dropdown-item" data-value="@site.Value" data-text="@site.Text">
                                    <input type="checkbox" class="cb-site" value="@site.Value">
                                    <span>@site.Text</span>
                                </div>}
                        }
                    </div>
                    <div class="ms-dropdown-no-results">No results found</div>
                </div>

                <!-- Equipment Room Dropdown -->
                <div class="filter-dropdown" id="ddEquipmentRoom">
                    <div class="ms-dropdown-search">
                        <input type="text" placeholder="Search equipment room..." onkeyup="filterMsDropdown('equipmentRoom', this.value)">
                    </div>
                    <div class="ms-dropdown-header">
                        <input type="checkbox" id="chkAllEquipmentRoom">
                        <label for="chkAllEquipmentRoom">Select All</label>
                    </div>
                    <div class="ms-dropdown-list" id="listEquipmentRoom">

                    </div>
                    <div class="ms-dropdown-no-results">No results found</div>
                </div>

                <div id="divEquipmentRoomHistory"></div>

              
            </div>
        </div>
    </div>
</div>

<script>
   
    // ==========================================================================
    // GLOBALS
    // ==========================================================================
    var openDropdown = null;
    var debounceTimer = null;
    var selectedViewType = 'Table';
    var telemetryChart = null;
    var lastAssetResults = null;
    var chartColors = [
        '#6366f1', '#8b5cf6', '#ec4899', '#f43f5e', '#f97316',
        '#eab308', '#22c55e', '#14b8a6', '#06b6d4', '#3b82f6',
        '#a855f7', '#d946ef', '#f59e0b', '#84cc16', '#0ea5e9',
        '#e11d48', '#7c3aed', '#059669', '#dc2626', '#2563eb'
    ];

    // ==========================================================================
    // ASSET ATTRIBUTE MAP: Id → Title (loaded from api/AssetAttribute/GetAll)
    // ==========================================================================
    var assetAttributeMap = {};       // { 1: "Vr", 2: "If mA", 3: "Ir mA", ... }
    var assetAttributeLoaded = false;

    // Fetch all asset attribute definitions and build Id → AliasName lookup
    function loadAssetAttributes(callback) {
        $.ajax({
            url: '/FRS25/EquipmentRoomHistory/GetAssetAttributes',
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                var data = response;
                if (response && !Array.isArray(response)) {
                    data = response.Data || response.data || response.Result || response.result || response;
                }
                if (data && Array.isArray(data) && data.length > 0) {
                    data.forEach(function (item) {
                        var id = item.Id || item.id || item.AttributeId || item.attributeId;
                        // Prefer AliasName over Title
                        var title = item.AliasName || item.aliasName || item.Alias || item.alias
                            || item.Title || item.title || item.Name || item.name
                            || item.AttributeName || item.attributeName;
                        if (id !== undefined && id !== null && title) {
                            assetAttributeMap[id] = title;
                        }
                    });
                    assetAttributeLoaded = true;
                    console.log('[AssetAttr] Loaded ' + Object.keys(assetAttributeMap).length + ' attribute AliasName(s)', assetAttributeMap);
                }
                if (callback) callback();
            },
            error: function (xhr, status, error) {
                console.warn('[AssetAttr] Failed to load attribute names:', status, error, '. Will show Attr IDs as fallback.');
                if (callback) callback();
            }
        });
    }

    // Get display title for an attribute ID — returns AliasName from API, falls back to "Attr {id}"
    function getAttrTitle(attrId) {
        if (assetAttributeMap[attrId]) return assetAttributeMap[attrId];
        // Try string key (in case API returned string IDs)
        if (assetAttributeMap[String(attrId)]) return assetAttributeMap[String(attrId)];
        return 'Attr ' + attrId;
    }

    // Format alias name: first character normal, rest as subscript
    // "VTC TFC I/P(V)" → "V<span class='alias-tc'>TC TFC I/P(V)</span>"
    // "ITC RELAY END(mA)" → "I<span class='alias-tc'>TC RELAY END(mA)</span>"
    function formatAliasName(name) {
        if (!name || name.length < 2) return name;
        return name.charAt(0) + '<span class="alias-tc">' + name.substring(1) + '</span>';
    }

