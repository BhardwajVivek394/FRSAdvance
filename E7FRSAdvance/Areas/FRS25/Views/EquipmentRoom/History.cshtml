    @@media (max-width: 480px) {
        #pager .page-link {
            padding: 5px 8px;
            font-size: 12px;
        }
    }
</style>

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.3.0/exceljs.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>

<!-- Backdrop for closing dropdowns -->
<div class="dropdown-backdrop" id="backdrop"></div>

<!-- 24-hour Time Picker Popup (shared for both From/To) -->
<div class="time-picker-popup" id="timePickerPopup">
    <div class="time-picker-header">
        <span class="time-picker-display" id="tpHour">00</span>
        <span class="time-picker-display">:</span>
        <span class="time-picker-display" id="tpMinute">00</span>
    </div>
    <div class="time-picker-body">
        <div class="time-picker-col" id="tpHourCol"></div>
        <div class="time-picker-col" id="tpMinuteCol"></div>
    </div>
    <div class="time-picker-footer">
        <button type="button" class="time-picker-btn" onclick="return tpNow(event);">Now</button>
        <button type="button" class="time-picker-btn" onclick="return tpClear(event);">Clear</button>
        <button type="button" class="time-picker-btn primary" onclick="return tpApply(event);">OK</button>
    </div>
</div>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body p-0">
                <div class="row">
                    <div class="col-12 col-sm-5">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">Equipment Room</li>
                                <li class="breadcrumb-item active" aria-current="page"><a href="#">Equipment Room History</a></li>
                            </ol>
                        </nav>
                    </div>
                    <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                        <h2 class="page-name">Equipment Room History</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header mb-2">
                <h4 class="m-0">Search</h4>
            </div>
            <div class="card-body">
                <div class="mb-3" id="filterContainer">

                    <!-- Zone -->
                    <div class="filter-item">
                        <span>Zone</span>
                        @Html.DropDownList("ZoneId", (IEnumerable<SelectListItem>)ViewBag.Zones, "All", new { @class = "form-control", @id = "drpZones", tabindex = 1 })
                    </div>

                    <!-- Division -->
                    <div class="filter-item">
                        <span>Division</span>
                        @Html.DropDownList("DivisionId", (IEnumerable<SelectListItem>)ViewBag.Divisions, "All", new { @class = "form-control", @id = "drpDivisions", tabindex = 2 })
                    </div>

                    <!-- Station/Site -->
                    <div class="filter-item" style="position:relative; z-index:100;">
                        <span>Station</span>
                        <div class="select-btn" id="btnSite" data-target="ddSite">
                            <span class="text" id="txtSite">All</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </div>

                    <div class="filter-item" style="position:relative; z-index:100;">
                        <span>Equipment Room</span>
                        <div class="select-btn" id="btnEquipmentRoom" data-target="ddEquipmentRoom">
                            <span class="text" id="txtEquipmentRoom">All</span>
                            <i class="fas fa-chevron-down"></i>
                        </div>
                    </div>

                    <!-- From Date -->
                    <div class="filter-item">
                        <span>From Date</span>
                        <input type="text" class="form-control" id="txtFromDate" placeholder="Select" readonly />
                    </div>

                    <!-- From Time (24-hour with custom picker) -->
                    <div class="filter-item">
                        <span>From Time</span>
                        <div class="time-24-wrapper">
                            <input type="text" class="form-control time-24" id="txtFromTime"
                                   placeholder="HH:MM" maxlength="5" autocomplete="off" readonly />
                            <i class="fas fa-clock time-24-icon"></i>
                        </div>
                    </div>

                    <!-- To Date -->
                    <div class="filter-item">
                        <span>To Date</span>
                        <input type="text" class="form-control" id="txtToDate" placeholder="Select" readonly />
                    </div>

                    <!-- To Time (24-hour with custom picker) -->
                    <div class="filter-item">
                        <span>To Time</span>
                        <div class="time-24-wrapper">
                            <input type="text" class="form-control time-24" id="txtToTime"
                                   placeholder="HH:MM" maxlength="5" autocomplete="off" readonly />
                            <i class="fas fa-clock time-24-icon"></i>
                        </div>
                    </div>

                    <!-- View Type -->
                    <div class="filter-item" style="position:relative; z-index:100;">
                        <div class="er-view-selector">
                            <div class="er-view-btn" id="erViewBtn" onclick="toggleErViewDropdown()">
                                <span><i class="fas fa-table mr-1"></i> Table</span>
                                <i class="fas fa-chevron-down" style="font-size:11px; color:var(--e7-text-3, #999);"></i>
                            </div>
                            <div class="er-view-dropdown" id="erViewDropdown">
                                <div class="er-view-item checked" data-value="Table" onclick="selectErView(this)">
                                    <i class="fas fa-table"></i>
                                    <span>Table</span>
                                </div>
                                <div class="er-view-item" data-value="Pie" onclick="selectErView(this)">
                                    <i class="fas fa-chart-pie"></i>
                                    <span>Pie</span>
                                </div>
                                <div class="er-view-item" data-value="Bar" onclick="selectErView(this)">
                                    <i class="fas fa-chart-bar"></i>
                                    <span>Bar</span>
                                </div>
                                <div class="er-view-item" data-value="Graph" onclick="selectErView(this)">
                                    <i class="fas fa-chart-line"></i>
                                    <span>Graph</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Search Button -->
                    <div class="filter-item">
                        <button type="button" class="btn-search" onclick="fnSearchHistory()">
                            <img src="~/Areas/FRS25/assets/img/search.svg">
                        </button>
                    </div>
                </div>

                <!-- Multi-select dropdowns -->
                <div class="filter-dropdown" id="ddSite">
                    <div class="ms-dropdown-search">
                        <input type="text" placeholder="Search station..." onkeyup="filterMsDropdown('site', this.value)">
                    </div>
                    <div class="ms-dropdown-header">
                        <input type="checkbox" id="chkAllSite">
                        <label for="chkAllSite">Select All</label>
                    </div>
                    <div class="ms-dropdown-list" id="listSite">
                        @if (ViewBag.Sites != null)
                        {
                            foreach (var site in (IEnumerable<SelectListItem>)ViewBag.Sites)
                            {
                                <div class="ms-dropdown-item" data-value="@site.Value" data-text="@site.Text">
                                    <input type="checkbox" class="cb-site" value="@site.Value">
                                    <span>@site.Text</span>
                                </div>}
                        }
                    </div>
                    <div class="ms-dropdown-no-results">No results found</div>
                </div>

                <div class="filter-dropdown" id="ddEquipmentRoom">
                    <div class="ms-dropdown-search">
                        <input type="text" placeholder="Search equipment room..." onkeyup="filterMsDropdown('equipmentRoom', this.value)">
                    </div>
                    <div class="ms-dropdown-header">
                        <input type="checkbox" id="chkAllEquipmentRoom">
                        <label for="chkAllEquipmentRoom">Select All</label>
                    </div>
                    <div class="ms-dropdown-list" id="listEquipmentRoom"></div>
                    <div class="ms-dropdown-no-results">No results found</div>
                </div>

                <div id="divEquipmentRoomHistory"></div>

            </div>
        </div>
    </div>
</div>

<script>
    // ==========================================================================
    // GLOBALS
    // ==========================================================================
    var openDropdown = null;
    var debounceTimer = null;
    var selectedViewType = 'Table';
    var telemetryChart = null;
    var lastAssetResults = null;
    var chartColors = [
        '#6366f1', '#8b5cf6', '#ec4899', '#f43f5e', '#f97316',
        '#eab308', '#22c55e', '#14b8a6', '#06b6d4', '#3b82f6',
        '#a855f7', '#d946ef', '#f59e0b', '#84cc16', '#0ea5e9',
        '#e11d48', '#7c3aed', '#059669', '#dc2626', '#2563eb'
    ];

    // Time Picker state
    var tpCurrentInputId = null;   // which input opened the picker
    var tpSelectedHour = 0;
    var tpSelectedMinute = 0;

    // ==========================================================================
    // ASSET ATTRIBUTE MAP
    // ==========================================================================
    var assetAttributeMap = {};
    var assetAttributeLoaded = false;

    function loadAssetAttributes(callback) {
        $.ajax({
            url: '/FRS25/EquipmentRoomHistory/GetAssetAttributes',
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                var data = response;
                if (response && !Array.isArray(response)) {
                    data = response.Data || response.data || response.Result || response.result || response;
                }
                if (data && Array.isArray(data) && data.length > 0) {
                    data.forEach(function (item) {
                        var id = item.Id || item.id || item.AttributeId || item.attributeId;
                        var title = item.AliasName || item.aliasName || item.Alias || item.alias
                            || item.Title || item.title || item.Name || item.name
                            || item.AttributeName || item.attributeName;
                        if (id !== undefined && id !== null && title) {
                            assetAttributeMap[id] = title;
                        }
                    });
                    assetAttributeLoaded = true;
                }
                if (callback) callback();
            },
            error: function () { if (callback) callback(); }
        });
    }

    function getAttrTitle(attrId) {
        if (assetAttributeMap[attrId]) return assetAttributeMap[attrId];
        if (assetAttributeMap[String(attrId)]) return assetAttributeMap[String(attrId)];
        return 'Attr ' + attrId;
    }

    function formatAliasName(name) {
        if (!name || name.length < 2) return name;
        return name.charAt(0) + '<span class="alias-tc">' + name.substring(1) + '</span>';
    }

    // ==========================================================================
    // TIME PICKER (24-HOUR)
    // ==========================================================================

    // Build the hour and minute scroll lists (run once)
    function tpBuildLists() {
        var hrHtml = '';
        for (var h = 0; h < 24; h++) {
            var hh = ('0' + h).slice(-2);
            hrHtml += '<div class="time-picker-item" data-hour="' + h + '">' + hh + '</div>';
        }
        $('#tpHourCol').html(hrHtml);

        var mnHtml = '';
        for (var m = 0; m < 60; m++) {
            var mm = ('0' + m).slice(-2);
            mnHtml += '<div class="time-picker-item" data-minute="' + m + '">' + mm + '</div>';
        }
        $('#tpMinuteCol').html(mnHtml);
    }

    function tpOpen(inputId) {
        tpCurrentInputId = inputId;

        var cur = $('#' + inputId).val().trim();
        var parts = cur.split(':');
        tpSelectedHour = (parts.length === 2 && !isNaN(parseInt(parts[0]))) ? parseInt(parts[0], 10) : 0;
        tpSelectedMinute = (parts.length === 2 && !isNaN(parseInt(parts[1]))) ? parseInt(parts[1], 10) : 0;

        tpUpdateSelection();

        var $input = $('#' + inputId);
        var $popup = $('#timePickerPopup');

        // ✅ Move to body — exact same as toggleDD
        $('body').append($popup);

        var rect = $input[0].getBoundingClientRect();

        // ✅ Use position:absolute exactly like toggleDD
        $popup.css({
            position: 'absolute',
            visibility: 'hidden',
            display: 'block',
            top: '-9999px',
            left: '-9999px',
            'z-index': 99999
        });

        var popupH = $popup.outerHeight();
        var popupW = $popup.outerWidth();

        // ✅ Add scroll offset because position is absolute, not fixed
        var top = rect.bottom + window.scrollY + 4;
        var left = rect.left + window.scrollX;

        if (top + popupH > window.innerHeight + window.scrollY) {
            top = rect.top + window.scrollY - popupH - 4;
        }
        if (left + popupW > window.innerWidth + window.scrollX) {
            left = window.innerWidth + window.scrollX - popupW - 8;
        }
        if (left < 4) left = 4;

        // ✅ Same pattern as toggleDD — set visibility and display together
        $popup.css({
            visibility: '',
            display: '',
            top: top + 'px',
            left: left + 'px'
        }).addClass('open');

        setTimeout(function () {
            var $selHr = $('#tpHourCol .time-picker-item.selected');
            var $selMn = $('#tpMinuteCol .time-picker-item.selected');
            if ($selHr.length) $('#tpHourCol').scrollTop($selHr[0].offsetTop - 70);
            if ($selMn.length) $('#tpMinuteCol').scrollTop($selMn[0].offsetTop - 70);
        }, 20);
    }

    function tpClose() {
        var $popup = $('#timePickerPopup');
        $popup.removeClass('open');
        // ✅ Same pattern as closeDD
        $popup.css({
            display: 'none',
            top: '-9999px',
            left: '-9999px',
            visibility: 'hidden'
        });
        tpCurrentInputId = null;
    }

    function tpUpdateSelection() {
        $('#tpHourCol .time-picker-item').removeClass('selected');
        $('#tpMinuteCol .time-picker-item').removeClass('selected');
        $('#tpHourCol .time-picker-item[data-hour="' + tpSelectedHour + '"]').addClass('selected');
        $('#tpMinuteCol .time-picker-item[data-minute="' + tpSelectedMinute + '"]').addClass('selected');
        $('#tpHour').text(('0' + tpSelectedHour).slice(-2));
        $('#tpMinute').text(('0' + tpSelectedMinute).slice(-2));
    }

    function tpNow(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        var now = new Date();
        tpSelectedHour = now.getHours();
        tpSelectedMinute = now.getMinutes();
        tpUpdateSelection();

        var $selHr = $('#tpHourCol .time-picker-item.selected');
        var $selMn = $('#tpMinuteCol .time-picker-item.selected');
        if ($selHr.length) $('#tpHourCol').scrollTop($selHr[0].offsetTop - 70);
        if ($selMn.length) $('#tpMinuteCol').scrollTop($selMn[0].offsetTop - 70);
        return false;
    }

    function tpClear(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        if (tpCurrentInputId) {
            $('#' + tpCurrentInputId).val('');
        }
        tpClose();
        return false;
    }

    function tpApply(e) {
        if (e) { e.stopPropagation(); e.preventDefault(); }
        if (tpCurrentInputId) {
            var timeStr = ('0' + tpSelectedHour).slice(-2) + ':' + ('0' + tpSelectedMinute).slice(-2);
            $('#' + tpCurrentInputId).val(timeStr);
        }
        tpClose();
        return false;
    }

    // ==========================================================================
    // DOCUMENT READY
    // ==========================================================================
    $(document).ready(function () {

       // loadAssetAttributes();
        tpBuildLists();

        // Default dates/times
        var today = new Date();
        $('#txtFromDate').val(formatDateForInput(today));
        $('#txtToDate').val(formatDateForInput(today));
        $('#txtFromTime').val('00:00');
        $('#txtToTime').val(formatTimeForInput(today));

        $('#txtFromDate').datepicker({ dateFormat: 'dd/mm/yyyy', autoClose: true });
        $('#txtToDate').datepicker({ dateFormat: 'dd/mm/yyyy', autoClose: true });

        // Cascading dropdowns
        $('#drpZones').change(function () { GetDivisionByZone($(this).val()); });
        $('#drpDivisions').change(function () { GetSitesByDivision($(this).val()); });

        // Multi-select button clicks
        $('.select-btn').on('click', function (e) {
            e.stopPropagation();
            toggleDD($(this).data('target'), this);
        });

        // Backdrop click to close
        $('#backdrop').on('click', closeDD);

        // Site dropdown handlers
        $(document).on('click', '#ddSite .ms-dropdown-header', function (e) {
            e.stopPropagation();
            var $cb = $('#chkAllSite');
            if ($(e.target).is('input[type="checkbox"]') || $(e.target).is('label')) {
                setTimeout(function () { msSelectAll('site', $cb.prop('checked')); }, 0);
            } else {
                var newState = !$cb.prop('checked');
                $cb.prop('checked', newState);
                msSelectAll('site', newState);
            }
        });

        $(document).on('click', '#ddSite .ms-dropdown-item', function (e) {
            e.stopPropagation();
            var $cb = $(this).find('input[type="checkbox"]');
            if (!$(e.target).is('input[type="checkbox"]')) {
                $cb.prop('checked', !$cb.prop('checked'));
            }
            $(this).toggleClass('checked', $cb.prop('checked'));
            msUpdateSelectAllState('site');
            msUpdateText('site');
            debounceEquipmentRooms();
        });

        // Equipment Room dropdown handlers
        $(document).on('click', '#ddEquipmentRoom .ms-dropdown-header', function (e) {
            e.stopPropagation();
            var $cb = $('#chkAllEquipmentRoom');
            if ($(e.target).is('input[type="checkbox"]') || $(e.target).is('label')) {
                setTimeout(function () { msSelectAll('equipmentRoom', $cb.prop('checked')); }, 0);
            } else {
                var newState = !$cb.prop('checked');
                $cb.prop('checked', newState);
                msSelectAll('equipmentRoom', newState);
            }
        });

        $(document).on('click', '#ddEquipmentRoom .ms-dropdown-item', function (e) {
            e.stopPropagation();
            var $cb = $(this).find('input[type="checkbox"]');
            if (!$(e.target).is('input[type="checkbox"]')) {
                $cb.prop('checked', !$cb.prop('checked'));
            }
            $(this).toggleClass('checked', $cb.prop('checked'));
            msUpdateSelectAllState('equipmentRoom');
            msUpdateText('equipmentRoom');
        });

        $(document).on('click', '.ms-dropdown-search', function (e) { e.stopPropagation(); });

        // ==========================================================================
        // TIME PICKER EVENT WIRING
        // ==========================================================================

        // Open picker when clicking the time input
        $(document).on('click', '.time-24', function (e) {
            e.stopPropagation();
            tpOpen(this.id);
        });

        // Click an hour item
        $(document).on('click', '#tpHourCol .time-picker-item', function (e) {
            e.stopPropagation();
            tpSelectedHour = parseInt($(this).data('hour'), 10);
            tpUpdateSelection();
        });

        // Click a minute item
        $(document).on('click', '#tpMinuteCol .time-picker-item', function (e) {
            e.stopPropagation();
            tpSelectedMinute = parseInt($(this).data('minute'), 10);
            tpUpdateSelection();
        });

        // Close on outside click
        // Close on outside click (use mousedown to fire before button click)
        $(document).on('mousedown', function (e) {
            if ($('#timePickerPopup').hasClass('open')) {
                var $target = $(e.target);
                // Don't close if clicking inside popup or on a time-24 input
                if ($target.closest('#timePickerPopup').length === 0 &&
                    !$target.hasClass('time-24') &&
                    $target.closest('.time-24-wrapper').length === 0) {
                    tpClose();
                }
            }
        });

        // Close on Escape
        $(document).on('keydown', function (e) {
            if (e.key === 'Escape' && $('#timePickerPopup').hasClass('open')) {
                tpClose();
            }
        });

        $(window).on('resize', function () {
            if (openDropdown) closeDD();
            if ($('#timePickerPopup').hasClass('open')) tpClose();
            $('#erViewDropdown').removeClass('open');
            $('#erViewBtn').removeClass('active');
        });
    });

    // ===== MULTI-SELECT HELPERS =====
    function toggleDD(id, btn) {
        if (openDropdown === id) {
            closeDD();
            return;
        }
        closeDD();

        var $dd = $('#' + id);
        $('body').append($dd);

        var rect = btn.getBoundingClientRect();

        $dd.css({
            position: 'absolute',
            visibility: 'hidden',
            display: 'block',
            top: '-9999px',
            left: '-9999px'
        });

        var ddHeight = $dd.outerHeight();
        var ddWidth = $dd.outerWidth();

        var top = rect.bottom + 4;
        var left = rect.left;

        if (top + ddHeight > window.innerHeight) top = rect.top - ddHeight - 4;
        if (left + ddWidth > window.innerWidth) left = window.innerWidth - ddWidth - 8;

        $dd.css({ visibility: '', display: '', top: top + 'px', left: left + 'px' });
        $dd.addClass('open');
        $(btn).addClass('active');
        $('#backdrop').addClass('show');
        openDropdown = id;

        setTimeout(function () {
            var $searchInput = $dd.find('.dropdown-search input');
            if ($searchInput.length) $searchInput.focus();
        }, 100);
    }

    function closeDD() {
        if (openDropdown) {
            var $dd = $('#' + openDropdown);
            $dd.find('.ms-dropdown-search input').val('');
            $dd.find('.ms-dropdown-item').removeClass('hidden');
            $dd.find('.ms-dropdown-no-results').removeClass('show');
            $dd.find('.ms-dropdown-item').each(function () {
                var origText = $(this).data('text');
                if (origText) $(this).find('span').text(origText);
            });
            $dd.removeClass('open');
            $('.select-btn').removeClass('active');
            $('#backdrop').removeClass('show');
            openDropdown = null;
        }
    }

    function msSelectAll(type, checked) {
        $('.cb-' + type).each(function () {
            var $item = $(this).closest('.ms-dropdown-item');
            if (!$item.hasClass('hidden')) {
                $(this).prop('checked', checked);
                $item.toggleClass('checked', checked);
            }
        });
        msUpdateText(type);
        if (type === 'site') debounceEquipmentRooms();
    }

    function msUpdateSelectAllState(type) {
        var listId = (type === 'site') ? 'listSite' : 'listEquipmentRoom';
        var $visible = $('#' + listId + ' .ms-dropdown-item:not(.hidden)');
        var total = $visible.length;
        var checked = $visible.find('.cb-' + type + ':checked').length;
        var chkAllId = (type === 'site') ? 'chkAllSite' : 'chkAllEquipmentRoom';
        $('#' + chkAllId).prop('checked', total > 0 && total === checked);
    }

    function msUpdateText(type) {
        var $checked = $('.cb-' + type + ':checked');
        var count = $checked.length;
        var text = 'All';
        if (count === 1) {
            text = $checked.first().closest('.ms-dropdown-item').data('text') ||
                $checked.first().closest('.ms-dropdown-item').find('span').text();
        } else if (count > 1) {
            text = count + ' selected';
        }
        var txtId = (type === 'site') ? 'txtSite' : 'txtEquipmentRoom';
        $('#' + txtId).text(text);
    }

    function msGetValues(type) {
        var vals = [];
        $('.cb-' + type + ':checked').each(function () { vals.push($(this).val()); });
        return vals;
    }

    function filterMsDropdown(type, searchText) {
        var ddId = (type === 'site') ? 'ddSite' : 'ddEquipmentRoom';
        var $dropdown = $('#' + ddId);
        var $items = $dropdown.find('.ms-dropdown-item');
        var $noResults = $dropdown.find('.ms-dropdown-no-results');
        var search = searchText.toLowerCase().trim();
        var visibleCount = 0;

        $items.each(function () {
            var $item = $(this);
            var text = ($item.data('text') || $item.find('span').text()).toLowerCase();

            if (search === '' || text.indexOf(search) > -1) {
                $item.removeClass('hidden');
                visibleCount++;
                if (search !== '') {
                    var originalText = $item.data('text') || $item.find('span').text();
                    var regex = new RegExp('(' + escapeRegex(searchText) + ')', 'gi');
                    $item.find('span').html(originalText.replace(regex, '<mark>$1</mark>'));
                } else {
                    var origText = $item.data('text');
                    if (origText) $item.find('span').text(origText);
                }
            } else {
                $item.addClass('hidden');
            }
        });

        $noResults.toggleClass('show', visibleCount === 0 && search !== '');
    }

    function escapeRegex(string) {
        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    // ==========================================================================
    // DATE HELPERS
    // ==========================================================================
    function formatDateForInput(date) {
        var d = ('0' + date.getDate()).slice(-2);
        var m = ('0' + (date.getMonth() + 1)).slice(-2);
        var y = date.getFullYear();
        return d + '/' + m + '/' + y;
    }

    function toServerDate(ddmmyyyy) {
        if (!ddmmyyyy) return '';
        var parts = ddmmyyyy.split('/');
        if (parts.length !== 3) return ddmmyyyy;
        return parts[1] + '/' + parts[0] + '/' + parts[2]; // MM/DD/YYYY
    }

    function formatTimeForInput(date) {
        return ('0' + date.getHours()).slice(-2) + ':' + ('0' + date.getMinutes()).slice(-2);
    }

    function formatDateTimeForAPI(dateStr, timeStr) {
        if (!dateStr) return '';
        var parts = dateStr.split('/'); // DD/MM/YYYY
        var timeParts = (timeStr || '00:00').split(':');
        return parts[0] + parts[1] + parts[2] + '_' + ('0' + timeParts[0]).slice(-2) + ('0' + timeParts[1]).slice(-2) + ('0' + new Date().getSeconds()).slice(-2);
    }

    function formatTimestamp(date) {
        var dd = ('0' + date.getDate()).slice(-2);
        var mm = ('0' + (date.getMonth() + 1)).slice(-2);
        var yyyy = date.getFullYear();
        var hh = ('0' + date.getHours()).slice(-2);
        var mi = ('0' + date.getMinutes()).slice(-2);
        var ss = ('0' + date.getSeconds()).slice(-2);
        return dd + '-' + mm + '-' + yyyy + ' ' + hh + ':' + mi + ':' + ss;
    }

    function formatTimestampShort(date) {
        return ('0' + date.getDate()).slice(-2) + '/' + ('0' + (date.getMonth() + 1)).slice(-2) + ' ' + ('0' + date.getHours()).slice(-2) + ':' + ('0' + date.getMinutes()).slice(-2);
    }

    // ==========================================================================
    // CASCADING DROPDOWNS
    // ==========================================================================
    function GetDivisionByZone(zoneId) {
        // Clear Station
        $('#listSite').html('<div class="ms-dropdown-empty">Select Division first</div>');
        $('#chkAllSite').prop('checked', false);
        $('#txtSite').text('All');

        // Clear Equipment Room
        $('#listEquipmentRoom').html('<div class="ms-dropdown-empty">Select Station</div>');
        $('#chkAllEquipmentRoom').prop('checked', false);
        $('#txtEquipmentRoom').text('All');

        if (zoneId != null && zoneId != undefined && zoneId != '' && zoneId != '0') {
            $("#loader").show();
            $.ajax({
                url: '/FRS25/EquipmentRoom/GetDivisionByZoneId',
                type: 'GET',
                data: { zoneId: zoneId },
                success: function (data) {
                    $("#loader").hide();
                    $("#drpDivisions").empty().append($("<option></option>").val('0').html('All'));
                    $.each(data, function (key, value) {
                        $("#drpDivisions").append($("<option></option>").val(value.Id).html(value.Name));
                    });
                },
                error: function () { $("#loader").hide(); showError('Failed to load divisions.', 'Error'); }
            });
        }
    }

    function GetSitesByDivision(divisionId) {
        $('#listSite').html('<div class="ms-dropdown-empty">Loading...</div>');
        $('#chkAllSite').prop('checked', false);
        $('#txtSite').text('All');
        $('#listEquipmentRoom').html('<div class="ms-dropdown-empty">Select Station</div>');
        $('#chkAllEquipmentRoom').prop('checked', false);
        $('#txtEquipmentRoom').text('All');

        if (!divisionId || divisionId === '0' || divisionId === '') {
            $('#listSite').html('<div class="ms-dropdown-empty">Select Division first</div>');
            return;
        }

        $("#loader").show();
        $.ajax({
            url: '/FRS25/EquipmentRoom/GetSiteByDivisionId',
            type: 'GET',
            data: { divisionId: divisionId },
            success: function (data) {
                $("#loader").hide();
                if (data && data.length > 0) {
                    var html = '';
                    $.each(data, function (key, value) {
                        html += '<div class="ms-dropdown-item" data-value="' + value.Id + '" data-text="' + value.Name + '">';
                        html += '<input type="checkbox" class="cb-site" value="' + value.Id + '">';
                        html += '<span>' + value.Name + '</span></div>';
                    });
                    $('#listSite').html(html);
                } else {
                    $('#listSite').html('<div class="ms-dropdown-empty">No stations found</div>');
                }
            },
            error: function () { $("#loader").hide(); showError('Failed to load sites.', 'Error'); }
        });
    }

    function debounceEquipmentRooms() {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(loadEquipmentRooms, 300);
    }

    function loadEquipmentRooms() {
        var siteIds = msGetValues('site');

        $('#listEquipmentRoom').html('<div class="ms-dropdown-empty">Select Station first</div>');
        $('#chkAllEquipmentRoom').prop('checked', false);
        $('#txtEquipmentRoom').text('All');

        var validSiteIds = siteIds.filter(function (id) { return id && id !== '0'; });
        if (validSiteIds.length === 0) return;

        $('#listEquipmentRoom').html('<div class="ms-dropdown-empty">Loading...</div>');

        for (var s = 0; s < validSiteIds.length; s++) {
            (function (siteId) {
                $.ajax({
                    url: '/FRS25/EquipmentRoom/GetEquipmentRoom',
                    type: 'GET',
                    data: { siteId: siteId },
                    success: function (data) {
                        if (data && data.length > 0) {
                            var html = '';
                            $.each(data, function (key, value) {
                                html += '<div class="ms-dropdown-item" data-value="' + value.Name + '" data-text="' + value.Name + '">';
                                html += '<input type="checkbox" class="cb-equipmentRoom" value="' + value.Name + '">';
                                html += '<span>' + value.Name + '</span></div>';
                            });
                            $('#listEquipmentRoom').html(html);
                        } else {
                            $('#listEquipmentRoom').html('<div class="ms-dropdown-empty">No equipment found</div>');
                        }
                    },
                    error: function () { $("#loader").hide(); showError('Failed to load equipments.', 'Error'); }
                });
            })(validSiteIds[s]);
        }
    }

    // ==========================================================================
    // SEARCH HISTORY
    // ==========================================================================
    function fnSearchHistory() {
        var fromDate = $('#txtFromDate').val();
        var fromTime = $('#txtFromTime').val();
        var toDate = $('#txtToDate').val();
        var toTime = $('#txtToTime').val();

        if (!fromDate) { showWarning('Please select From Date.', 'Validation'); return; }
        if (!toDate) { showWarning('Please select To Date.', 'Validation'); return; }

        // ── Future date/time validation ──
        var now = new Date();

        // Build From datetime
        var fromTimeParts = ($('#txtFromTime').val() || '00:00').split(':');
        var fromParts = fromDate.split('/'); // DD/MM/YYYY
        var fromDateTime = new Date(
            parseInt(fromParts[2]),
            parseInt(fromParts[1]) - 1,
            parseInt(fromParts[0]),
            parseInt(fromTimeParts[0] || 0),
            parseInt(fromTimeParts[1] || 0),
            0
        );

        // Build To datetime
        var toTimeParts = ($('#txtToTime').val() || '00:00').split(':');
        var toParts = $('#txtToDate').val().split('/'); // DD/MM/YYYY
        var toDateTime = new Date(
            parseInt(toParts[2]),
            parseInt(toParts[1]) - 1,
            parseInt(toParts[0]),
            parseInt(toTimeParts[0] || 0),
            parseInt(toTimeParts[1] || 0),
            0
        );

        if (fromDateTime > now) {
            showWarning('From Date & Time cannot be a future date and time.', 'Validation');
            $('#txtFromDate').focus();
            return;
        }

        if (toDateTime > now) {
            showWarning('To Date & Time cannot be a future date and time.', 'Validation');
            $('#txtToDate').focus();
            return;
        }

        if (fromDateTime > toDateTime) {
            showWarning('From Date & Time must be less than or equal to To Date & Time.', 'Validation');
            $('#txtFromDate').focus();
            return;
        }

        var sites = getValues('site');
        if (sites == null || sites == undefined || sites.length <= 0) {
            showWarning('Station is required.', 'Validation');
            return;
        }

        $('#divEquipmentRoomHistory').html('<div class="text-center p-5"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i><br/><small class="text-muted mt-2">Loading history data...</small></div>');

   
        var m = { SearchCriteria: {}, Pager: {} };
        m.SearchCriteria.ZoneIds = getValues('zone');
        m.SearchCriteria.DivisionIds = getValues('division');
        m.SearchCriteria.SiteIds = getValues('site');
        m.SearchCriteria.AssetIds = getValues('assetNumber');
        m.SearchCriteria.AlertInfoIds = getValues('cause');
        m.SearchCriteria.AcknowledgemenStatusIds = getValues('feedback');
        m.SearchCriteria.StartDate = toServerDate($('#txtFromDate').val());
        m.SearchCriteria.EndDate = toServerDate($('#txtToDate').val());
        m.SearchCriteria.StartTime = $('#txtFromTime').val();
        m.SearchCriteria.EndTime = $('#txtToTime').val();
        m.SearchCriteria.siteAttributeDatasList = getValues('equipmentRoom');

        $.ajax({
            url: '/FRS25/EquipmentRoom/_HistoryList',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(m),
            dataType: 'html',
            success: function (data) {
                $("#divEquipmentRoomHistory").empty().append(data);
                updateRangeBar();
                renderErView();
            },
            error: function () {
                showError('Something went wrong!', 'Error');
            }
        });
    }

    function onAllHistoryLoaded(assetResults, hasError) {
        $("#loader").hide();

        if (hasError && assetResults.length === 0) {
            $('#divEquipmentRoomHistory').html('<div class="text-center text-danger p-5"><i class="fas fa-exclamation-triangle fa-3x mb-3"></i><br/>Failed to load data. Please try again.</div>');
            $('#divChartContainer').hide();
            showError('Failed to fetch history data.', 'API Error');
            lastAssetResults = null;
            return;
        }

        if (assetResults.length > 0) {
            lastAssetResults = assetResults;
            renderByViewType(assetResults);
            $('#downloadContainer').show();
            var totalAttrs = 0;
            assetResults.forEach(function (a) { totalAttrs += a.attributes.length; });
            showSuccess('History data loaded.', 'Data Loaded');
        } else {
            lastAssetResults = null;
            $('#divEquipmentRoomHistory').html('<div class="text-center text-muted p-5"><i class="fas fa-inbox fa-3x mb-3"></i><br/>No history data found for the selected criteria.</div>');
            $('#divChartContainer').hide();
            $('#downloadContainer').hide();
            showWarning('No data found for the selected date range.', 'No Data');
        }
    }

    function renderByViewType(assetResults) {
        if (telemetryChart != null) { telemetryChart.destroy(); telemetryChart = null; }

        if (selectedViewType === 'Table') {
            $('#divEquipmentRoomHistory').show();
            $('#divChartContainer').hide();
            renderHistoryTable(assetResults);
        } else {
            $('#divEquipmentRoomHistory').hide();
            $('#divChartContainer').show();
            renderChart(assetResults, selectedViewType);
        }
    }

    function getValues(type) {
        var vals = [];
        $('.cb-' + type + ':checked').each(function () { vals.push($(this).val()); });
        return vals;
    }

    // ==========================================================================
    // VIEW TYPE DROPDOWN
    // ==========================================================================
    // Selected view (Table / Pie / Bar / Graph) lives on the PAGE, so it can be
    // chosen BEFORE the first search. _HistoryList keeps this value
    // (it only sets 'Table' when the variable does not exist yet).
    var erSelectedView = 'Table';

    // Page-level selectErView — works before any data is loaded.
    // After a search, the partial (_HistoryList) defines its own selectErView
    // with the same behaviour, which replaces this one.
    function selectErView(el) {
        var $el = $(el);
        $('#erViewDropdown .er-view-item').removeClass('checked');
        $el.addClass('checked');

        erSelectedView = $el.data('value');
        var icon = $el.find('i').prop('outerHTML');
        var label = $el.find('span').text();
        $('#erViewBtn > span').html(icon + ' ' + label);
        $('#erViewDropdown').removeClass('open');
        $('#erViewBtn').removeClass('active');

        // Data already on screen → re-render in the new view right away.
        // No data yet → the chosen view is applied when Search loads the data.
        if (typeof renderErView === 'function' && $('#tblEquipmentRoom').length) {
            renderErView();
        }
    }

    function toggleErViewDropdown() {
        var $dd = $('#erViewDropdown');
        var isOpen = $dd.hasClass('open');
        $dd.toggleClass('open', !isOpen);
        $('#erViewBtn').toggleClass('active', !isOpen);

        if (!isOpen) {
            setTimeout(function () {
                $(document).one('click', function () {
                    $dd.removeClass('open');
                    $('#erViewBtn').removeClass('active');
                });
            }, 10);
        }
    }
</script>