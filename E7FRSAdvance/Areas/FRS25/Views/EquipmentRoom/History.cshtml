        #dispFromDate, #dispFromTime, #dispToDate, #dispToTime {
            min-width: 0 !important;
        }
    }

    @@media (max-width: 480px) {
        #selectedRangeBar > div:nth-child(2),
        #selectedRangeBar > div:nth-child(4) {
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 6px !important;
        }

            #selectedRangeBar > div:nth-child(2) > div,
            #selectedRangeBar > div:nth-child(4) > div {
