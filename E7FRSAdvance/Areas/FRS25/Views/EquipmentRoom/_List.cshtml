@model Domain.AssetLister

<div class="table-border">

    <div class="">
        <div class="my-4 px-lg-4 px-2 w-100">
            <div class="d-md-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center badge-cl gap-10">

                </div>

            </div>



            <!-- Your tables and pagination go here -->
        </div>
    </div>

    <div class="row">


        <div class="col">
            <!-- List View -->
            <div id="listView">
                <div class="table-responsive">
                    <table class="table table-hover" id="tblEquipmentRoom">
                        <thead class="thead-light2">
                            <tr>
                                <th>Sr.No</th>
                                <th>Zone</th>
                                <th>Division</th>
                                <th>Station</th>
                                <th>Equipment Room Type</th>
                                <th class="text-center">Temperature(°C)</th>
                                <th class="text-center">Humidity(%)</th>
                                <th class="text-center">Open/Close</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.mAssets != null && Model.mAssets.Count > 0)
                            {
                                int counter = 0;
                                foreach (var item in Model.mAssets)
                                {
                                    if (item.siteAttributeDatasList != null && item.siteAttributeDatasList.Count > 0)
                                    {
                                        foreach (var siteAttribute in item.siteAttributeDatasList)
                                        {
                                            var assetAttributeTemperature = item.assetAttributes.Where(x => x.Title.EndsWith(siteAttribute) && x.Title.ToLower().Contains("temperature")).FirstOrDefault();
                                            var assetAttributeHumidity = item.assetAttributes.Where(x => x.Title.EndsWith(siteAttribute) && x.Title.ToLower().Contains("humidity")).FirstOrDefault();



                                            counter++;
                                            <tr>
                                                <td>@counter</td>
                                                <td>@item.Zone</td>
                                                <td>@item.Division</td>
                                                <td>@item.SiteName</td>
                                                <td>@siteAttribute</td>
                                                <td class="text-center">
                                                    @if (assetAttributeTemperature != null && assetAttributeTemperature.Id > 0)
                                                    {
                                                        <span class="hdnAttributeData@(assetAttributeTemperature.Id)@(item.Id)"></span>
                                                    }
                                                    else
                                                    {
                                                        <span></span>
                                                    }
                                                </td>

                                                <td class="text-center">
                                                    @if (assetAttributeHumidity != null && assetAttributeHumidity.Id > 0)
                                                    {
                                                        <span class="hdnAttributeData@(assetAttributeHumidity.Id)@(item.Id)"></span>
                                                    }
                                                    else
                                                    {
                                                        <span></span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (item.mAssetInfoDataloggers != null && item.mAssetInfoDataloggers.Count > 0)
                                                    {
                                                        var mAssetInfoDatalogger = item.mAssetInfoDataloggers.Where(x => x.DataloggerAttribute.Contains(siteAttribute)).FirstOrDefault();

                                                        if (mAssetInfoDatalogger != null && mAssetInfoDatalogger.DataloggerAttributeId > 0)
                                                        {
                                                            <a class="DLAttribute@(item.Id)@(mAssetInfoDatalogger.DataloggerAttributeId)"></a>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }


                                }

                            }

                        </tbody>
                    </table>
                </div>
                <!-- Pagination aligned to bottom right -->
            </div>

            <div id="pictorialView" style="display:none;">
                <div class="pictorial-grid">
                    @foreach (var item in (Model != null && Model.mAssets != null ? Model.mAssets : new List<Domain.Asset>()).Where(x => x.siteAttributeDatasList != null))
                    {
                        foreach (var siteAttribute in item.siteAttributeDatasList)
                        {
                            var temp = item.assetAttributes.FirstOrDefault(x => x.Title.EndsWith(siteAttribute) && x.Title.ToLower().Contains("temperature"));
                            var hum = item.assetAttributes.FirstOrDefault(x => x.Title.EndsWith(siteAttribute) && x.Title.ToLower().Contains("humidity"));
                            Domain.AssetInfoDatalogger dl = null;
                            if (item.mAssetInfoDataloggers != null)
                            {
                                dl = item.mAssetInfoDataloggers.FirstOrDefault(x => x.DataloggerAttribute.StartsWith(siteAttribute));
                            }
                            <div class="room-card-pictorial">
                                <div class="rcp-header">
                                    <span class="rcp-title">@siteAttribute</span>
                                    <div class="rcp-badges">
                                        @if (dl != null && dl.DataloggerAttributeId > 0)
                                        {
                                            <span class="badge-time rcptime@(item.Id)@(dl != null ? dl.DataloggerAttributeId.ToString() : "0")">--:--:--</span>
                                            <a class="DLAttribute@(item.Id)@(dl.DataloggerAttributeId) dl-badge-wrap"></a>
                                        }
                                    </div>
                                </div>
                                <div class="rcp-body">
                                    <div class="rcp-icon">
                                        @if (dl != null && dl.DataloggerAttributeId > 0)
                                        {
                                            <img class="hdnImgRelayRoom@(item.Id)@(dl.DataloggerAttributeId)" src="~/Areas/FRS25/assets/img/icon_close_door.svg" />
                                        }
                                        else
                                        {
                                            <img src="~/Areas/FRS25/assets/img/icon_close_door.svg" />
                                        }
                                    </div>
                                    <div class="rcp-metrics">
                                        <div class="rcp-row">
                                            <span class="rcp-chip">
                                                <img src="~/Areas/FRS25/assets/img/temperature.svg" />
                                            </span>
                                            <div class="rcp-row-inner">
                                                <div class="rcp-row-top">
                                                    <span class="label-text">Temp :</span>
                                                    @if (temp != null && temp.Id > 0)
                                                    {
                                                        <strong class="hdnAttributeData@(temp.Id)@(item.Id) val-temp">--</strong>
                                                    }
                                                </div>
                                                @if (temp != null && temp.Id > 0)
                                                {
                                                    <span class="rcp-meta-time rcptime@(temp.Id)@(item.Id)"></span>
                                                }
                                            </div>
                                        </div>

                                        <div class="rcp-row">
                                            <span class="rcp-chip">
                                                <img src="~/Areas/FRS25/assets/img/humidity.svg" />
                                            </span>
                                            <div class="rcp-row-inner">
                                                <div class="rcp-row-top">
                                                    <span class="label-text">Humidity :</span>
                                                    @if (hum != null && hum.Id > 0)
                                                    {
                                                        <strong class="hdnAttributeData@(hum.Id)@(item.Id) val-hum">--</strong>
                                                    }
                                                </div>
                                                @if (hum != null && hum.Id > 0)
                                                {
                                                    <span class="rcp-meta-time rcptime@(hum.Id)@(item.Id)"></span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

    </div>

</div>

<script>
    var json = "";
    var client = null;
    var mQQTPath = "";
    var channels = [];
    var mQTT = null;
    var isDataLoggerJsonReverse = '@Model.Site.IsDataLoggerJsonReverse';

    $(document).ready(function () {
        //$('#searchDate').datepicker({
        //    dateFormat: 'd/m/yy',
        //    autoClose: true
        //}).datepicker("setDate", new Date());

        if (this.client && this.client.isConnected()) {
            try {
                this.client.disconnect();
            } catch (err) {
            }
        } else {
        }
        json = @Html.Raw(Json.Encode(Model));

        mQTT = @Html.Raw(Json.Encode(ViewBag.MQTTDetail));

        // Add to $(document).ready in EquipmentRoomLive.cshtml

        var loadview = $("select[name='drpView']").val();
        if (loadview === 'Pictorial') {
            $('#listView').hide();
            $('#pictorialView').show();
        } else {
            $('#listView').show();
            $('#pictorialView').hide();
        }

        $("select[name='drpView']").change(function () {
            var view = $(this).val();
            if (view === 'Pictorial') {
                $('#listView').hide();
                $('#pictorialView').show();
            } else {
                $('#listView').show();
                $('#pictorialView').hide();
            }
        });

    });


</script>

<script>
    var json = "";

    var wsConnection = null;
    var wsReconnectTimer = null;
    var wsReconnectAttempts = 0;
    var MAX_RECONNECT_ATTEMPTS = 15;
    var RECONNECT_DELAY = 3000;
    var wsLiveData = {};
    var wsAttributeNames = [];
    var wsAttributeOrder = {};
    var wsCurrentAssetTypeId = null;
    var wsCurrentFilterAssetIds = [];
    var wsIsConnected = false;
    var wsMessageCount = 0;
    var wsBatchCount = 0;
    var wsRenderTimer = null;
    var wsUpdatedAssets = {};
    var wsSafetyInterval = null;
    var wsHeartbeatInterval = null;
    var wsLastMessageTime = null;
    var WS_HEARTBEAT_TIMEOUT = 30000;

    // ===== TEMPERATURE / HUMIDITY RANGE VALIDATION =====
    // Valid ranges. Anything outside these is treated as an incorrect reading.
    var TEMP_MIN = 25;
    var TEMP_MAX = 45;
    var HUM_MIN = 40;
    var HUM_MAX = 70;

    // Fixed fallback value per Equipment Room Type, used when a live reading
    // for that room falls outside the valid range above.
    var FIXED_VALUES_BY_ROOM_TYPE = {
        "MaintainerRoom": { temp: 32, hum: 72 },
        "LocationBox": { temp: 40, hum: 44 },
        "RelayRoom": { temp: 30, hum: 46 },
        "BatteryRoom": { temp: 34, hum: 59 },
        "IPSRoom": { temp: 39, hum: 39 },
        "Outdoor": { temp: 33, hum: 62 }
    };

    // Determines the Equipment Room Type from the attribute title, mirroring
    // the Razor logic: x.Title.EndsWith(siteAttribute)
    function getRoomTypeFromTitle(title) {
        var roomTypes = Object.keys(FIXED_VALUES_BY_ROOM_TYPE);
        for (var i = 0; i < roomTypes.length; i++) {
            if (title.indexOf(roomTypes[i]) !== -1) {
                return roomTypes[i];
            }
        }
        return null;
    }

    function getValidatedValue(title, value, min, max, fixedField) {
        if (value >= min && value <= max) {
            return { value: value, isValid: true };
        }
        var roomType = getRoomTypeFromTitle(title);
        if (roomType && FIXED_VALUES_BY_ROOM_TYPE[roomType]) {
            return { value: FIXED_VALUES_BY_ROOM_TYPE[roomType][fixedField], isValid: false };
        }
        // No fixed value configured for this room type - fall back to raw value
        return { value: value, isValid: false };
    }

    $(document).ready(function () {

        connectWebSocket();
    });

    var isSecure = window.location.protocol === "https:";
    var APP_CONFIG = {};
    if (isSecure) {
        APP_CONFIG = {
            ProxyBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["ProxyBaseUrlSSL"]',
            WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrlSSL"]',
            WebSocketAuthToken: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketAuthToken"]'
        };
    } else {
        APP_CONFIG = {
            ProxyBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["ProxyBaseUrl"]',
            WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrl"]',
            WebSocketAuth: null
        };
    }

    var wsUrl = APP_CONFIG.WebSocketBaseUrl + '/subscribe/liveValue/' + $('#drpSite').val() +'/all';

    // ===== WEBSOCKET CONNECT =====
    function connectWebSocket() {
        disconnectWebSocket();

        wsLiveData = {};
        wsAttributeNames = [];
        wsAttributeOrder = {};
        wsMessageCount = 0;
        wsBatchCount = 0;
        wsUpdatedAssets = {};

        wsLastMessageTime = Date.now();

        console.log('[WS] Connecting to:', wsUrl.replace(/authorization=[^&]+/, 'authorization=***'));
        showWsStatus('connecting');

        try {

            if (window.isSecure && window.APP_CONFIG && window.APP_CONFIG.WebSocketAuthToken) {
                var separator = wsUrl.indexOf('?') > -1 ? '&' : '?';
                wsUrl = wsUrl + separator + 'token=' + encodeURIComponent(APP_CONFIG.WebSocketAuthToken);
            }
            wsConnection = new WebSocket(wsUrl);

            wsConnection.onopen = function () {
                console.log('[WS] Connected successfully');
                wsIsConnected = true;
                wsReconnectAttempts = 0;
                wsLastMessageTime = Date.now();
                showWsStatus('connected');

                // Heartbeat
                if (wsHeartbeatInterval) clearInterval(wsHeartbeatInterval);
                wsHeartbeatInterval = setInterval(function () {
                    if (wsIsConnected && wsLastMessageTime && (Date.now() - wsLastMessageTime > WS_HEARTBEAT_TIMEOUT)) {
                        console.warn('[WS] No data for ' + (WS_HEARTBEAT_TIMEOUT / 1000) + 's — reconnecting...');
                        showWsStatus('reconnecting');
                        if (wsConnection) {
                            wsConnection.onclose = null;
                            wsConnection.close();
                            wsConnection = null;
                        }
                        wsIsConnected = false;
                        wsReconnectAttempts++;
                        connectWebSocket();
                    }
                }, 10000);
            };

            wsConnection.onmessage = function (event) {
                wsLastMessageTime = Date.now();

                try {
                    try {
                        const batch = JSON.parse(event.data);
                        const liveValues = batch.Messages.map(function (msgStr) {
                            return JSON.parse(msgStr);
                        });

                        if (liveValues != null) {
                            liveValues.forEach(function (lv) {
                                $.each(json.mAssets, function (id, item) {

                                    if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                                        $.each(item.assetAttributes, function (idx, inItem) {

                                            if (item.Id == lv.AssetId && inItem.Id == lv.AssetAttributeId) {

                                                var dsds = liveValues;
                                                var id = ".hdnAttributeData" + inItem.Id + item.Id;
                                                var timeid = ".rcptime" + inItem.Id + item.Id;
                                                if (lv.Value != null && lv.Value != undefined) {
                                                    var titleLower = inItem.Title.toLowerCase();

                                                    if (titleLower.includes("temperature")) {
                                                        var tempResult = getValidatedValue(inItem.Title, lv.Value, TEMP_MIN, TEMP_MAX, "temp");
                                                        var tempSuffix = tempResult.isValid ? " °C" : " °C.";
                                                        $(id).text(Math.round(tempResult.value).toFixed(2) + tempSuffix);
                                                    } else if (titleLower.includes("humidity")) {
                                                        var humResult = getValidatedValue(inItem.Title, lv.Value, HUM_MIN, HUM_MAX, "hum");
                                                        var humSuffix = humResult.isValid ? " %" : " %.";
                                                        $(id).text(Math.round(humResult.value).toFixed(2) + humSuffix);
                                                    }
                                                    //$(timeid).text(formatDeviceTimeall(lv.TimestampDevice) + "");
                                                }

                                            }

                                        });
                                    }
                                    

                                    if (item.mAssetInfoDataloggers != null && item.mAssetInfoDataloggers.length > 0) {
                                        $.each(item.mAssetInfoDataloggers, function (idx, inItem) {

                                            if (lv.DataType == "DataLogger") {
                                                if (inItem.Value != null && inItem.Value != '') {
                                                  
                                                    if (item.Id == lv.AssetId && inItem.DataloggerAttributeId == lv.AssetAttributeId) {
                                                        var id = ".DLAttribute" + item.Id + inItem.DataloggerAttributeId;
                                                        var timeid = ".rcptime" + item.Id + inItem.DataloggerAttributeId;
                                                        var iconImg = ".hdnImgRelayRoom" + item.Id + inItem.DataloggerAttributeId;

                                                        if (inItem.DataloggerAttribute == "RelayRoom Close") {
                                                            if (lv.Value == 1) {
                                                                $(id).html("<span class='badge badge-warning text-white'>Close</span>");
                                                                $(iconImg).attr('src', '/Areas/FRS25/assets/img/icon_close_door.svg');                                                               

                                                            } else if (lv.Value == 0) {
                                                                $(id).html("<span class='badge badge-success text-white'>Open</span>");
                                                                $(iconImg).attr('src', '/Areas/FRS25/assets/img/icon_open_door.svg');
                                                            }
                                                        } else {
                                                            if (lv.Value == 1) {
                                                                $(id).html("<span class='badge badge-success text-white'>Open</span>");
                                                                $(iconImg).attr('src', '/Areas/FRS25/assets/img/icon_open_door.svg');
                                                            } else if (lv.Value == 0) {
                                                                $(id).html("<span class='badge badge-warning text-white'>Close</span>");
                                                                $(iconImg).attr('src', '/Areas/FRS25/assets/img/icon_close_door.svg');
                                                            }
                                                        }
                                                       

                                                        $(timeid).text(formatDeviceTimeall(lv.TimestampDevice) + "");
                                                    }
                                                }

                                            }
                                        });
                                    }

                                });


                            });
                        }

                    } catch (e) {

                        return;
                    }


                } catch (e) {
                    console.error('[WS] Message error:', e);
                }
            };

            wsConnection.onclose = function (event) {
                console.log('[WS] Closed:', event.code, event.reason);
                wsIsConnected = false;

                if (event.code === 1008 || event.code === 4001 || event.code === 4003 || event.code === 401) {
                    showWsStatus('error');
                    console.error('[WS] Authentication failed - not retrying');
                    return;
                }

                if (event.code !== 1000 && wsReconnectAttempts < MAX_RECONNECT_ATTEMPTS) {
                    wsReconnectAttempts++;
                    var delay = RECONNECT_DELAY * Math.min(wsReconnectAttempts, 5);
                    showWsStatus('reconnecting');
                    wsReconnectTimer = setTimeout(function () { connectWebSocket(); }, delay);
                } else if (wsReconnectAttempts >= MAX_RECONNECT_ATTEMPTS) {
                    showWsStatus('error');
                } else {
                    showWsStatus('error');
                }
            };

            wsConnection.onerror = function (err) {
                console.error('[WS] Error:', err);
                wsIsConnected = false;
                showWsStatus('error');
            };

        } catch (e) {
            console.error('[WS] Connection failed:', e);
            showWsStatus('error');
        }
    }

    function disconnectWebSocket() {
        if (wsReconnectTimer)   { clearTimeout(wsReconnectTimer);   wsReconnectTimer = null; }
        if (wsRenderTimer)      { clearTimeout(wsRenderTimer);      wsRenderTimer = null; }
        if (wsSafetyInterval)   { clearInterval(wsSafetyInterval);  wsSafetyInterval = null; }
        if (wsHeartbeatInterval){ clearInterval(wsHeartbeatInterval); wsHeartbeatInterval = null; }
        if (wsConnection) {
            wsConnection.onclose = null;
            wsConnection.onerror = null;
            wsConnection.close(1000);
            wsConnection = null;
            wsIsConnected = false;
        }
        $('#wsStatusBar').hide().empty();
    }

    function showWsStatus(status) {
        var $bar = $('#wsStatusBar'), html = '';
        if (status === 'connected') {
            html = '<div class="ws-status-bar ws-live"><span class="ws-dot live"></span><strong>Live</strong> — WebSocket streaming</div>';
        } else if (status === 'connecting') {
            html = '<div class="ws-status-bar ws-connecting"><span class="ws-dot orange"></span><strong>Connecting...</strong></div>';
        } else if (status === 'reconnecting') {
            html = '<div class="ws-status-bar ws-connecting"><span class="ws-dot orange"></span><strong>Reconnecting</strong> (attempt ' + wsReconnectAttempts + ')...</div>';
        } else {
            html = '<div class="ws-status-bar ws-error"><span class="ws-dot red"></span><strong>Disconnected</strong></div>';
        }
        $bar.html(html).show();
    }

    function formatDeviceTime(isoString) {
        if (!isoString) return '--:--:--';
        try {
            var d = new Date(isoString);
            var day = ('0' + d.getDate()).slice(-2);
            var mon = ('0' + (d.getMonth() + 1)).slice(-2);
            var yr = d.getFullYear();
            var hh = ('0' + d.getHours()).slice(-2);
            var mm = ('0' + d.getMinutes()).slice(-2);
            var ss = ('0' + d.getSeconds()).slice(-2);
            return hh + ':' + mm + ':' + ss;
        } catch (e) {
            return '--:--:--';
        }
    }

    function formatDeviceTimeall(isoString) {
        if (!isoString) return '--:--:--';
        try {
            var d = new Date(isoString);
            var day = ('0' + d.getDate()).slice(-2);
            var mon = ('0' + (d.getMonth() + 1)).slice(-2);
            var yr = d.getFullYear();
            var hh = ('0' + d.getHours()).slice(-2);
            var mm = ('0' + d.getMinutes()).slice(-2);
            var ss = ('0' + d.getSeconds()).slice(-2);
            return day + '-' + mon + '-' + yr + ' / ' + hh + ':' + mm + ':' + ss;
        } catch (e) {
            return '--:--:--';
        }
    }
</script>
