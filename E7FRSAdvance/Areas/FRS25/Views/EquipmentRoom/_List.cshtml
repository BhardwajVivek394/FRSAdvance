@model Domain.AssetLister

<div class="table-border">

    <div class="">
        <div class="my-4 px-lg-4 px-2 w-100">
            <div class="d-md-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center badge-cl gap-10">

                </div>

            </div>



            <!-- Your tables and pagination go here -->
        </div>
    </div>

    <div class="row">


        <div class="col">
            <!-- List View -->
            <div id="listView">
                <div class="table-responsive">
                    <table class="table table-hover" id="tblEquipmentRoom">
                        <thead class="thead-light2">
                            <tr>
                                <th>Sr.No</th>
                                <th>Zone</th>
                                <th>Division</th>
                                <th>Station</th>
                                <th>Equipment Room Type</th>
                                <th class="text-center">Temperature</th>
                                <th class="text-center">Humidity</th>
                                <th class="text-center">Open/Close</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.mAssets != null && Model.mAssets.Count > 0)
                            {
                                int counter = 0;
                                foreach (var item in Model.mAssets)
                                {
                                    if (item.siteAttributeDatasList != null && item.siteAttributeDatasList.Count > 0)
                                    {
                                        foreach (var siteAttribute in item.siteAttributeDatasList)
                                        {
                                            var assetAttributeTemperature = item.assetAttributes.Where(x => x.Title.EndsWith(siteAttribute) && x.Title.ToLower().Contains("temperature")).FirstOrDefault();
                                            var assetAttributeHumidity = item.assetAttributes.Where(x => x.Title.EndsWith(siteAttribute) && x.Title.ToLower().Contains("humidity")).FirstOrDefault();



                                            counter++;
                                            <tr>
                                                <td>@counter</td>
                                                <td>@item.Zone</td>
                                                <td>@item.Division</td>
                                                <td>@item.SiteName</td>
                                                <td>@siteAttribute</td>
                                                <td class="text-center">
                                                    @if (assetAttributeTemperature != null && assetAttributeTemperature.Id > 0)
                                                    {
                                                        <span class="hdnAttributeData@(assetAttributeTemperature.Id)@(item.Id)"></span>
                                                    }
                                                    else
                                                    {
                                                        <span></span>
                                                    }
                                                </td>

                                                <td class="text-center">
                                                    @if (assetAttributeHumidity != null && assetAttributeHumidity.Id > 0)
                                                    {
                                                        <span class="hdnAttributeData@(assetAttributeHumidity.Id)@(item.Id)"></span>
                                                    }
                                                    else
                                                    {
                                                        <span></span>
                                                    }
                                                </td>
                                                <td class="text-center">
                                                    @if (item.mAssetInfoDataloggers != null && item.mAssetInfoDataloggers.Count > 0)
                                                    {
                                                        var mAssetInfoDatalogger = item.mAssetInfoDataloggers.Where(x => x.DataloggerAttribute.EndsWith(siteAttribute)).FirstOrDefault();

                                                        if (mAssetInfoDatalogger != null && mAssetInfoDatalogger.DataloggerAttributeId > 0)
                                                        {
                                                            <a class="DLAttribute@(item.Id)@(mAssetInfoDatalogger.DataloggerAttributeId)"></a>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }

                                    @*if (item.mAssetInfoDataloggers != null && item.mAssetInfoDataloggers.Count > 0)
                                    {
                                        foreach (var dl in item.mAssetInfoDataloggers)
                                        {
                                            counter++;
                                            <tr>
                                                <td>@counter</td>
                                                <td>@item.Zone</td>
                                                <td>@item.Division</td>
                                                <td>@item.SiteName</td>
                                                <td>
                                                    <span>@dl.DataloggerAttribute</span>
                                                </td>
                                                <td class="text-center">-</td>
                                                <td class="text-center">-</td>
                                                <td class="text-center">
                                                    <a class="DLAttribute@(item.Id)@(dl.DataloggerAttributeId)"></a>
                                                </td>
                                            </tr>
                                        }
                                    }*@

                                }

                            }

                        </tbody>
                    </table>
                </div>
                <!-- Pagination aligned to bottom right -->
                @*<nav>
                        <ul class="pagination mb-0" id="pager">
                            <li class="page-item" id="prevBtn">
                                <a class="page-link" href="javascript:void(0);" onclick="changePage('prev')">
                                    <i class="fas fa-chevron-left"></i> Previous
                                </a>
                            </li>
                            <li class="page-item" id="nextBtn">
                                <a class="page-link" href="javascript:void(0);" onclick="changePage('next')">
                                    Next <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>*@
            </div>

        </div>

    </div>

</div>

<script>
    var json = "";
    var client = null;
    var mQQTPath = "";
    var channels = [];
    var mQTT = null;
    var isDataLoggerJsonReverse = '@Model.Site.IsDataLoggerJsonReverse';

    $(document).ready(function () {
        //$('#searchDate').datepicker({
        //    dateFormat: 'd/m/yy',
        //    autoClose: true
        //}).datepicker("setDate", new Date());

        if (this.client && this.client.isConnected()) {
            try {
                this.client.disconnect();
            } catch (err) {
            }
        } else {
        }
        json = @Html.Raw(Json.Encode(Model));

        mQTT = @Html.Raw(Json.Encode(ViewBag.MQTTDetail));


    });



    (function () {
        var rowsPerPage = 10;
        var $table = $('#tblEquipmentRoom');
        var $rows = $table.find('tbody tr');
        var totalRows = $rows.length;
        var totalPages = Math.ceil(totalRows / rowsPerPage);
        var currentPage = 1;

        // Check if we have data rows (not "no data" row)
        if (totalRows === 1 && $rows.first().find('td[colspan]').length > 0) {
            // No data row - hide pagination
            $('#paginationInfo').parent().hide();
        } else if (totalRows > 0) {
            showPage(1);
        }

        function showPage(page) {
            if (page < 1) page = 1;
            if (page > totalPages) page = totalPages;
            currentPage = page;

            var start = (page - 1) * rowsPerPage;
            var end = start + rowsPerPage;

            $rows.hide();
            $rows.slice(start, end).show();

            var showEnd = Math.min(end, totalRows);
            $('#showingFrom').text(totalRows > 0 ? start + 1 : 0);
            $('#showingTo').text(showEnd);

            renderPagination();
        }

        function renderPagination() {
            var $pager = $('#pager');
            $pager.find('.page-number').remove();

            if (currentPage <= 1) {
                $('#prevBtn').addClass('disabled');
            } else {
                $('#prevBtn').removeClass('disabled');
            }

            if (currentPage >= totalPages) {
                $('#nextBtn').addClass('disabled');
            } else {
                $('#nextBtn').removeClass('disabled');
            }

            var $nextBtn = $('#nextBtn');
            var pagesToShow = [];

            if (totalPages <= 7) {
                for (var i = 1; i <= totalPages; i++) {
                    pagesToShow.push(i);
                }
            } else {
                pagesToShow.push(1);
                if (currentPage > 3) pagesToShow.push('...');
                for (var i = Math.max(2, currentPage - 1); i <= Math.min(totalPages - 1, currentPage + 1); i++) {
                    if (pagesToShow.indexOf(i) === -1 && i !== '...') pagesToShow.push(i);
                }
                if (currentPage < totalPages - 2) pagesToShow.push('...');
                if (pagesToShow.indexOf(totalPages) === -1) pagesToShow.push(totalPages);
            }

            for (var j = 0; j < pagesToShow.length; j++) {
                var p = pagesToShow[j];
                var $li;
                if (p === '...') {
                    $li = $('<li class="page-item page-number disabled"><span class="page-link">...</span></li>');
                } else {
                    var activeClass = (p === currentPage) ? 'active' : '';
                    $li = $('<li class="page-item page-number ' + activeClass + '">' +
                        '<a class="page-link" href="javascript:void(0);" onclick="goToPage(' + p + ')">' + p + '</a></li>');
                }
                $li.insertBefore($nextBtn);
            }
        }

        window.changePage = function (direction) {
            if (direction === 'prev' && currentPage > 1) {
                showPage(currentPage - 1);
            } else if (direction === 'next' && currentPage < totalPages) {
                showPage(currentPage + 1);
            }
        };

        window.goToPage = function (page) {
            showPage(page);
        };
    })();


    function onMessageArrived(message) {


        if (message.destinationName.includes("/dl/")) {

            var parseJson = JSON.parse(message.payloadString);
            if (parseJson != null && parseJson != undefined && parseJson != '') {
                var jsonData = parseJson['bits'];
                var tsTime = parseJson['ts'];

                if (jsonData != null && jsonData != undefined && jsonData.length > 0) {
                    var jsonArrayString = '';
                    for (var i = 0; i < jsonData.length; i++) {
                        var decimalNumber = decimalToBinary(jsonData[i]);
                        if (decimalNumber != null) {
                            if (decimalNumber.length != 8) {
                                decimalNumber = ("00000000" + decimalNumber.toString(2)).substr(-8);
                            }
                            const reversedString = decimalNumber.split("").reduce((acc, char) => char + acc, "");

                            jsonArrayString += reversedString;
                        }
                    }
                    var jsonArray = jsonArrayString.split('');
                    if (jsonArray != null && jsonArray != undefined && jsonArray.length > 0) {
                        try {
                            BindDataLoggerAttribute(jsonArray);
                        }
                        catch (err) {

                        }
                    }
                }
            }
        }
        else {
            if (message.payloadString.includes("roles") && message.payloadString.includes("ts")) {
                var parseJson = JSON.parse(message.payloadString);
                if (parseJson != null && parseJson != undefined && parseJson != '') {

                    var roletsArray = parseJson['role_ts'];
                    var array = parseJson['roles'];
                    var tsarray = parseJson['ts'];
                    if (array != null && array != undefined && array.length > 0) {
                        BindData(message.destinationName, array, tsarray, roletsArray);

                    }
                }
            }
            else {
                var channeldata = message.payloadString.split(',');
                BindData(message.destinationName, channeldata);
            }

            for (var i = 0; i < channels.length; i++) {
                if (channels[i] != null && channels[i] != "null" && channels[i] != "") {
                    var name = mQQTPath.toLowerCase() + channels[i].toLowerCase();
                    if (message.destinationName.toLowerCase() == name.toLowerCase()) {
                        var d = new Date();
                        var time = d.getHours() + ":" + d.getMinutes() + ":" + d.getSeconds();
                        $("#c" + i).html(time);
                    }
                }
            }
        }

    }


    function BindData(basePath, data, tsarray, roletsArray) {
        $.each(json.mAssets, function (id, item) {

            if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                $.each(item.assetAttributes, function (idx, inItem) {
                    var str1 = basePath.toLowerCase();
                    if (inItem.AssetInfoChannel != null) {
                        var str2 = inItem.AssetInfoChannel.toLowerCase();
                        if (str1.indexOf(str2) != -1) {
                            var infoValue = inItem.AssetInfoValue;
                            var infoMultiplication = inItem.Multiplication;
                            if (infoValue != null) {
                                var dataValue = data[infoValue];
                                var id = ".hdnAttributeData" + inItem.Id + item.Id;

                                if (infoMultiplication != null) {

                                    var mainData = parseFloat(infoMultiplication) * parseFloat(dataValue);
                                    var v = (Math.round(mainData * 100) / 100).toFixed(1);
                                    if (parseFloat(v) <= 0) {
                                        v = '0.0';
                                    }
                                    if (inItem.Title.toLowerCase().includes("temperature")) {
                                        $(id).text(v + " °C");
                                    } else if (inItem.Title.toLowerCase().includes("humidity")) {
                                        $(id).text(v + " %");
                                    }

                                }

                            }
                            else {
                                var id = ".hdnAttributeData" + inItem.Id + item.Id;
                                var v = (Math.round(dataValue * 100) / 100).toFixed(1);

                                if (inItem.Title.toLowerCase().includes("temperature")) {
                                    $(id).text(v + " °C");
                                } else if (inItem.Title.toLowerCase().includes("humidity")) {
                                    $(id).text(v + " %");
                                }

                            }
                        }
                    }
                });
            }




        });


        $('[data-bs-toggle="popover"]').popover({
            trigger: 'hover',  // or 'click'
            html: true
        });
    }

    function BindDataLoggerAttribute(data) {

        //Bind Datalogger Attribute
        $.each(json.mAssets, function (id, item) {
            if (item.mAssetInfoDataloggers != null && item.mAssetInfoDataloggers.length > 0) {
                $.each(item.mAssetInfoDataloggers, function (idx, inItem) {
                    if (inItem.Value != null && inItem.Value != '') {
                        var dataValue = data[inItem.Value - 1];
                        if (dataValue != null) {
                            var id = ".DLAttribute" + item.Id + inItem.DataloggerAttributeId;

                            //if (isDataLoggerJsonReverse == "True") {

                            //    if (parseInt(dataValue) == 0)
                            //        dataValue = 1;
                            //    else if (parseInt(dataValue) == 1)
                            //        dataValue = 0;
                            //}
                            if (parseInt(dataValue) == 0)
                                dataValue = 1;
                            else if (parseInt(dataValue) == 1)
                                dataValue = 0;

                            if (inItem.ContactType != null && inItem.ContactType != undefined && inItem.ContactType.toLowerCase() == 'front') {
                                if (parseInt(dataValue) == 1) {
                                    $(id).html("<span class='badge badge-success'>Open</span>");
                                }
                                else if (parseInt(dataValue) == 0) {
                                    $(id).html("<span class='badge badge-warning text-white'>Close</span>");
                                }
                            } else if (inItem.ContactType != null && inItem.ContactType != undefined && inItem.ContactType.toLowerCase() == 'back') {
                                if (parseInt(dataValue) == 1) {
                                    $(id).html("<span class='badge badge-warning text-white'>Close</span>");

                                }
                                else if (parseInt(dataValue) == 0) {

                                    $(id).html("<span class='badge badge-success'>Open</span>");
                                }
                            }
                        }
                    }
                });
            }
        });

    }

    function decimalToBinary(num) {
        let binary = "";
        while (num > 0) {
            let digit = num % 2;
            binary = "" + digit + binary;
            num = parseInt(num / 2);
        }
        return binary.padStart(8, '0');
    }
</script>

<script>
    var json = "";

    var wsConnection = null;
    var wsReconnectTimer = null;
    var wsReconnectAttempts = 0;
    var MAX_RECONNECT_ATTEMPTS = 15;
    var RECONNECT_DELAY = 3000;
    var wsLiveData = {};
    var wsAttributeNames = [];
    var wsAttributeOrder = {};
    var wsCurrentAssetTypeId = null;
    var wsCurrentFilterAssetIds = [];
    var wsIsConnected = false;
    var wsMessageCount = 0;
    var wsBatchCount = 0;
    var wsRenderTimer = null;
    var wsUpdatedAssets = {};
    var wsSafetyInterval = null;
    var wsHeartbeatInterval = null;
    var wsLastMessageTime = null;
    var WS_HEARTBEAT_TIMEOUT = 30000;

    $(document).ready(function () {

        connectWebSocket();
    });

    var isSecure = window.location.protocol === "https:";
    var APP_CONFIG = {};
    if (isSecure) {
        APP_CONFIG = {
            ProxyBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["ProxyBaseUrlSSL"]',
            WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrlSSL"]',
            WebSocketAuthToken: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketAuthToken"]'
        };
    } else {
        APP_CONFIG = {
            ProxyBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["ProxyBaseUrl"]',
            WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrl"]',
            WebSocketAuth: null
        };
    }

    var wsUrl = APP_CONFIG.WebSocketBaseUrl + '/subscribe/liveValue/' + $('#drpSite').val() +'/all';

    // ===== WEBSOCKET CONNECT =====
    function connectWebSocket() {
        disconnectWebSocket();

        wsLiveData = {};
        wsAttributeNames = [];
        wsAttributeOrder = {};
        wsMessageCount = 0;
        wsBatchCount = 0;
        wsUpdatedAssets = {};

        wsLastMessageTime = Date.now();

        console.log('[WS] Connecting to:', wsUrl.replace(/authorization=[^&]+/, 'authorization=***'));
        showWsStatus('connecting');

        try {
            debugger;

            if (window.isSecure && window.APP_CONFIG && window.APP_CONFIG.WebSocketAuthToken) {
                var separator = wsUrl.indexOf('?') > -1 ? '&' : '?';
                wsUrl = wsUrl + separator + 'token=' + encodeURIComponent(APP_CONFIG.WebSocketAuthToken);
            }
            wsConnection = new WebSocket(wsUrl);

            wsConnection.onopen = function () {
                console.log('[WS] Connected successfully');
                wsIsConnected = true;
                wsReconnectAttempts = 0;
                wsLastMessageTime = Date.now();
                showWsStatus('connected');

                // Heartbeat
                if (wsHeartbeatInterval) clearInterval(wsHeartbeatInterval);
                wsHeartbeatInterval = setInterval(function () {
                    if (wsIsConnected && wsLastMessageTime && (Date.now() - wsLastMessageTime > WS_HEARTBEAT_TIMEOUT)) {
                        console.warn('[WS] No data for ' + (WS_HEARTBEAT_TIMEOUT / 1000) + 's — reconnecting...');
                        showWsStatus('reconnecting');
                        if (wsConnection) {
                            wsConnection.onclose = null;
                            wsConnection.close();
                            wsConnection = null;
                        }
                        wsIsConnected = false;
                        wsReconnectAttempts++;
                        connectWebSocket();
                    }
                }, 10000);
            };

            wsConnection.onmessage = function (event) {
                wsLastMessageTime = Date.now();

                try {
                    try {
                        // Step 1: Parse outer batch
                        const batch = JSON.parse(event.data);

                        // Step 2: Each item in Messages[] is itself a JSON string — parse again
                        const liveValues = batch.Messages.map(function (msgStr) {
                            return JSON.parse(msgStr);
                        });

                        if (liveValues != null) {
                            // Step 3: Access fields
                            liveValues.forEach(function (lv) {
                                //console.log("Asset     :", lv.AssetName);
                                //console.log("Attribute :", lv.AssetAttributeName);
                                //console.log("Value     :", lv.Value);
                                //console.log("Local Time:", lv.TimestampLocal);
                                //console.log("Change    :", lv.TimestampChange);
                                //console.log("Source    :", lv.DataSource);

                                $.each(json.mAssets, function (id, item) {

                                    if (item.assetAttributes != null && item.assetAttributes.length > 0) {
                                        $.each(item.assetAttributes, function (idx, inItem) {

                                            if (item.Id == lv.AssetId && inItem.Id == lv.AssetAttributeId) {

                                                var dsds = liveValues;
                                                var id = ".hdnAttributeData" + inItem.Id + item.Id;

                                                if (lv.Value != null && lv.Value != undefined) {
                                                    if (inItem.Title.toLowerCase().includes("temperature")) {
                                                        $(id).text(lv.Value + " °C");
                                                    } else if (inItem.Title.toLowerCase().includes("humidity")) {
                                                        $(id).text(lv.Value + " %");
                                                    }
                                                }

                                            }

                                        });
                                    }


                                    if (item.mAssetInfoDataloggers != null && item.mAssetInfoDataloggers.length > 0) {
                                        $.each(item.mAssetInfoDataloggers, function (idx, inItem) {

                                            if (lv.DataType == "DataLogger") {
                                                if (inItem.Value != null && inItem.Value != '') {
                                                    if (item.Id == lv.AssetId && parseInt(inItem.Value) == lv.AssetAttributeId) {
                                                        var id = ".DLAttribute" + item.Id + inItem.DataloggerAttributeId;
                                                        if (lv.Value == 1) {
                                                            $(id).html("<span class='badge badge-success text-white'>Open</span>");
                                                        } else if (lv.Value == 0) {
                                                            $(id).html("<span class='badge badge-warning text-white'>Close</span>");
                                                        }
                                                    }
                                                }

                                            }


                                            //if (inItem.Value != null && inItem.Value != '') {
                                            //    var dataValue = data[inItem.Value - 1];
                                            //    if (dataValue != null) {
                                            //        var id = ".DLAttribute" + item.Id + inItem.DataloggerAttributeId;

                                            //        if (parseInt(dataValue) == 0)
                                            //            dataValue = 1;
                                            //        else if (parseInt(dataValue) == 1)
                                            //            dataValue = 0;

                                            //        if (inItem.ContactType != null && inItem.ContactType != undefined && inItem.ContactType.toLowerCase() == 'front') {
                                            //            if (parseInt(dataValue) == 1) {
                                            //                $(id).html("<span class='badge badge-success'>Open</span>");
                                            //            }
                                            //            else if (parseInt(dataValue) == 0) {
                                            //                $(id).html("<span class='badge badge-warning'>Close</span>");
                                            //            }
                                            //        } else if (inItem.ContactType != null && inItem.ContactType != undefined && inItem.ContactType.toLowerCase() == 'back') {
                                            //            if (parseInt(dataValue) == 1) {
                                            //                $(id).html("<span class='badge badge-warning'>Close</span>");

                                            //            }
                                            //            else if (parseInt(dataValue) == 0) {

                                            //                $(id).html("<span class='badge badge-success'>Open</span>");
                                            //            }
                                            //        }
                                            //    }
                                            //}
                                        });
                                    }

                                });


                            });
                        }

                    } catch (e) {

                        return;
                    }


                } catch (e) {
                    console.error('[WS] Message error:', e);
                }
            };

            wsConnection.onclose = function (event) {
                console.log('[WS] Closed:', event.code, event.reason);
                wsIsConnected = false;

                if (event.code === 1008 || event.code === 4001 || event.code === 4003 || event.code === 401) {
                    showWsStatus('error');
                    console.error('[WS] Authentication failed - not retrying');
                    return;
                }

                if (event.code !== 1000 && wsReconnectAttempts < MAX_RECONNECT_ATTEMPTS) {
                    wsReconnectAttempts++;
                    var delay = RECONNECT_DELAY * Math.min(wsReconnectAttempts, 5);
                    showWsStatus('reconnecting');
                    wsReconnectTimer = setTimeout(function () { connectWebSocket(); }, delay);
                } else if (wsReconnectAttempts >= MAX_RECONNECT_ATTEMPTS) {
                    showWsStatus('error');
                } else {
                    showWsStatus('error');
                }
            };

            wsConnection.onerror = function (err) {
                console.error('[WS] Error:', err);
                wsIsConnected = false;
                showWsStatus('error');
            };

        } catch (e) {
            console.error('[WS] Connection failed:', e);
            showWsStatus('error');
        }
    }

    function disconnectWebSocket() {
        if (wsReconnectTimer)   { clearTimeout(wsReconnectTimer);   wsReconnectTimer = null; }
        if (wsRenderTimer)      { clearTimeout(wsRenderTimer);      wsRenderTimer = null; }
        if (wsSafetyInterval)   { clearInterval(wsSafetyInterval);  wsSafetyInterval = null; }
        if (wsHeartbeatInterval){ clearInterval(wsHeartbeatInterval); wsHeartbeatInterval = null; }
        if (wsConnection) {
            wsConnection.onclose = null;
            wsConnection.onerror = null;
            wsConnection.close(1000);
            wsConnection = null;
            wsIsConnected = false;
        }
        $('#wsStatusBar').hide().empty();
    }

    function showWsStatus(status) {
        var $bar = $('#wsStatusBar'), html = '';
        if (status === 'connected') {
            html = '<div class="ws-status-bar ws-live"><span class="ws-dot live"></span><strong>Live</strong> — WebSocket streaming</div>';
        } else if (status === 'connecting') {
            html = '<div class="ws-status-bar ws-connecting"><span class="ws-dot orange"></span><strong>Connecting...</strong></div>';
        } else if (status === 'reconnecting') {
            html = '<div class="ws-status-bar ws-connecting"><span class="ws-dot orange"></span><strong>Reconnecting</strong> (attempt ' + wsReconnectAttempts + ')...</div>';
        } else {
            html = '<div class="ws-status-bar ws-error"><span class="ws-dot red"></span><strong>Disconnected</strong></div>';
        }
        $bar.html(html).show();
    }

</script>