@model Domain.User
@{
    ViewBag.Title = "Admin";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>
<style>
    .card-header button {
        width: 100%;
        text-align: left;
        text-decoration: none;
    }

    .toggle-icon {
        float: right;
    }


</style>
<section class="section">

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">

                    <div class="row">
                        <div class="col-12 col-sm-5">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item active" aria-current="page"><a href="#">Admin</a></li>
                                </ol>
                            </nav>
                        </div>


                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                            <h2 class="page-name">Admin</h2>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col">


            <div class="row">
                <!-- Sidebar -->
                <div class="col-lg-4">
                    <div class="card mb-4">
                        <div class="card-body p-5 text-center position-relative">
                            <img src="~/Areas/FRS25/assets/img/user.svg" class="rounded-circle avatar mx-auto mb-3" alt="Profile Picture">
                            <div>
                                <label class="btn btn-light">
                                    Upload Photo
                                    <input type="file" hidden>
                                </label>
                            </div>


                            <h2 class="user-name mb-1">@Model.FirstName @Model.LastName</h2>
                            <p class="user-name-text mb-4 lead">@Model.FirstName @Model.LastName • @Model.Designation</p>

                        </div>
                    </div>
                </div>
                <!-- Main Profile Card -->
                <div class="col-lg-8">
                    <div class="card mb-4">
                        <div class="card-body p-4">
                            <h5 class="card-title chang-pass"><i class="fa-solid fa-address-card mr-2"></i> About Me</h5>
                            <p class="card-text">
                                Passionate frontend developer with 5+ years of experience creating responsive, accessible web
                                applications.
                                Specializing in React, Vue.js, and modern CSS. Love mentoring and contributing to open source
                                projects.
                            </p>

                            <div class="row mt-4">
                                <div class="col-md-6 mb-3">
                                    <strong><i class="fas fa-user mr-2 text-muted"></i>Full Name</strong><br>
                                    <span class="text-muted">@Model.FirstName @Model.LastName</span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <strong><i class="fa-solid fa-phone mr-2 text-muted"></i>Phone Number</strong><br>
                                    <span class="text-muted">@Model.PhoneNumber</span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <strong><i class="fa-solid fa-envelope mr-2 text-muted"></i>Email Address</strong><br>
                                    <span class="text-muted">@Model.EmailAddress</span>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <strong><i class="fas fa-map-marker-alt mr-2 text-muted"></i>Location</strong><br>
                                    @*<span class="text-muted">San Francisco, CA</span>*@
                                </div>
                                <div class="col-md-6 mb-3">
                                    <strong><i class="fas fa-briefcase mr-2 text-muted"></i>Job Title</strong><br>
                                    <span class="text-muted">@Model.Designation</span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <strong><i class="fas fa-calendar mr-2 text-muted"></i>Joined</strong><br>
                                    <span class="text-muted">@Model.CreatedDate.ToString("MMMM yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>


            </div>

            <!-- Profile Header -->


            <div id="accordion">

                <!-- Item 1 -->
                <div class="card">
                    <div class="card-header">
                        <button class="btn btn-link-text" data-toggle="collapse" data-target="#collapseOne"
                                aria-expanded="true">
                            Change Password
                            <i class="fas fa-chevron-down toggle-icon"></i>
                        </button>
                    </div>

                    <div id="collapseOne" class="collapse" data-parent="#accordion">
                        <div class="card-body p-0">
                            <div class="bg-light rounded h-100 p-4">
                                <form>
                                    <div class="mb-3">
                                        <label for="exampleInputPassword1" class="form-label">Old Password</label>
                                        <input type="password" class="form-control" id="exampleInputPassword1">
                                    </div>
                                    <div class="mb-3">
                                        <label for="exampleInputPassword1" class="form-label">New Password</label>
                                        <input type="password" class="form-control" id="exampleInputPassword1">
                                    </div>
                                    <div class="mb-3">
                                        <label for="exampleInputPassword1" class="form-label">Re-Enter Password</label>
                                        <input type="password" class="form-control" id="exampleInputPassword1">
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-pass">Change</button>
                                    <button type="submit" class="btn btn-secondary">Cancel</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Item 2 -->
                <div class="card">
                    <div class="card-header">
                        <button class="btn btn-link-text collapsed" data-toggle="collapse" data-target="#collapseTwo"
                                aria-expanded="false">
                            Create User
                            <i class="fas fa-chevron-down toggle-icon"></i>
                        </button>
                    </div>

                    <div id="collapseTwo" class="collapse" data-parent="#accordion">
                        <div class="card-body p-0">
                            <div class="bg-light rounded h-100 p-4">
                                <div>
                                    <div class="mb-3">
                                        <label class="form-label">First Name</label>
                                        <input class="form-control" id="txtFirstName">
                                        <span class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Last Name</label>
                                        <input class="form-control" id="txtLastName">
                                        <span class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Email</label>
                                        <input class="form-control" id="txtEmail">
                                        <span class="text-danger"></span>
                                    </div>
                                    <div class="mb-3 password-container">
                                        <label class="form-label">Password</label>
                                        <input class="form-control" id="txtPassword" type="password">

                                        <div id="strength-bar">
                                            <div id="strength-level"></div>
                                        </div>
                                        <ul id="password-suggestions"></ul>

                                        <span class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Mobile</label>
                                        <input class="form-control" id="txtMobile" name="Mobile">
                                        <span class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">User Class</label>
                                        @Html.DropDownList("drpUserClassId", (IEnumerable<SelectListItem>)ViewBag.UserClass, "Select", new { @class = "form-control", style = "width:100%", tabindex = 9 })
                                        <span class="text-danger"></span>
                                    </div>
                                    <button type="button" class="btn btn-primary btn-pass" onclick="fnCreateUser()">Create</button>
                                    <button type="button" class="btn btn-secondary">Cancel</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>


    </div>

</section>
<script>

    $(document).ready(function () {
        //$('#txtPassword').val('');
    });

    function fnCreateUser() {
        if (Validate()) {

            var mUser = {};
            mUser.FirstName = $('#txtFirstName').val();
            mUser.LastName = $('#txtLastName').val();
            mUser.PhoneNumber = $('#txtMobile').val();
            mUser.EmailAddress = $('#txtEmail').val();
            mUser.Password = $('#txtPassword').val();
            mUser.UserClassId = $('#drpUserClassId').val();
            mUser.RoleId = '@E7FRSAdvance.Utility.Utility.Role.User.GetHashCode()';

            $("#loader").show();
            $.ajax({
                url: '/FRS25/Admin/SaveUser',
                type: 'Post',
                contentType: 'application/json',
                data: JSON.stringify(mUser),
                success: function (data) {
                    $("#loader").hide();
                    if (data != null && data != undefined && data.result != null) {
                        alert(data.result);
                        window.location.href = "@Url.Action("Index")";
                    }

                },
                error: function (response) {
                    $("#loader").hide();
                    CommonNotification("ERROR", "Something went wrong!", "Error");
                }
            })

        }
    }

    function Validate() {
        var result = true;
        var email = /^[A-Z0-9._%+-]+@@([A-Z0-9-]+\.)+[A-Z]{2,4}$/i;
        if ($.trim($("#txtFirstName").val()).length == 0) {
            $("#txtFirstName").next("span").html("First Name is required");
            result = false;
        }
        else {
            $("#txtFirstName").next("span").html("");
        }
        if ($.trim($("#txtLastName").val()).length == 0) {
            $("#txtLastName").next("span").html("Last Name is required");
            result = false;
        }
        else {
            $("#txtLastName").next("span").html("");
        }

        if ($.trim($("#txtMobile").val()).length == 0) {
            $("#txtMobile").next("span").html("Phone number is required");
            result = false;
        }
        else {
            $("#txtMobile").next("span").html("");
        }

        if ($.trim($("#txtEmail").val()).length == 0) {
            $("#txtEmail").next("span").html("Email address is required");
            result = false;
        }
        else {
            var emailValue = $("#txtEmail").val()
                .trim()
                .replace(/[\u200E\u200F\u202A-\u202E]/g, "");

            var email = email.test(emailValue)
            if (!email) {
                $("#txtEmail").next("span").html("Please enter valid email address");
                result = false;
            }
            else if ($.trim($("#txtEmail").val()).length > 50) {
                $("#txtEmail").next("span").html("Only 50 characters allow");
                result = false;
            }
            else {
                $("#txtEmail").next("span").html("");
            }
        }


        if ($.trim($("#txtPassword").val()).length == 0) {
            $("#txtPassword").next("span").html("Password is required");
            result = false;
        }
        else {
            $("#txtPassword").next("span").html("");
        }

        if ($.trim($("#drpUserClassId").val()).length == 0) {
            $("#drpUserClassId").next("span").html("UserClass is required");
            result = false;
        }
        else {
            $("#drpUserClassId").next("span").html("");
        }

        return result;
    }




</script>

<script>
    $(document).ready(function () {

        $("#txtPassword").on("keyup", function () {
            let password = $(this).val();
            let strength = 0;
            let suggestions = [];

            if (password.length >= 8) strength++;
            else suggestions.push("Use at least 8 characters");

            if (/[A-Z]/.test(password)) strength++;
            else suggestions.push("Add at least one uppercase letter");

            if (/[a-z]/.test(password)) strength++;
            else suggestions.push("Add at least one lowercase letter");

            if (/[0-9]/.test(password)) strength++;
            else suggestions.push("Add at least one number");

            if (/[^A-Za-z0-9]/.test(password)) strength++;
            else suggestions.push("Add at least one special character");

            updateStrengthUI(strength, suggestions);
        });

        function updateStrengthUI(strength, suggestions) {
            let bar = $("#strength-level");
            let suggestionBox = $("#password-suggestions");

            bar.removeClass("weak medium strong");
            suggestionBox.empty();

            if (strength <= 2) {
                bar.addClass("weak").css("width", "30%");
            }
            else if (strength <= 4) {
                bar.addClass("medium").css("width", "60%");
            }
            else {
                bar.addClass("strong").css("width", "100%");
            }

            suggestions.forEach(item => {
                suggestionBox.append("<li>" + item + "</li>");
            });
        }

    });
</script>
