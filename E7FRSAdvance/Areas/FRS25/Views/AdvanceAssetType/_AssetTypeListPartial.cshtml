@model Domain.AssetTypeLister

<style>
    /* Asset Types: themed from Energy7 tokens so it follows light/dark. */
    .assettype-aurora {
        padding: 12px 12px 22px;
        color: var(--e7-text, #22303f);
        background: transparent;
        max-width: 100%;
        overflow-x: hidden;
    }

        .assettype-aurora > .row > [class*="col-"] {
            min-width: 0;
        }

        .assettype-aurora .card {
            overflow: hidden;
            border: 1px solid var(--e7-border, #dde5ee);
            border-radius: 16px;
            background: var(--e7-surface, #fff);
            color: var(--e7-text, #22303f);
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        }

        .assettype-aurora .card-header {
            border-bottom: 1px solid var(--e7-border, #dde5ee);
            background: var(--e7-surface-2, #f5f8fb);
            color: var(--e7-text, #22303f);
        }

        .assettype-aurora .card-body {
            background: var(--e7-surface, #fff);
            color: var(--e7-text, #22303f);
        }

        .assettype-aurora .people-options {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px 12px;
        }

            .assettype-aurora .people-options > * {
                float: none !important;
                margin: 0 !important;
            }

        .assettype-aurora .aurora-title-block {
            padding: 4px 0;
            margin-right: auto !important;
            min-width: 0;
        }

        .assettype-aurora .aurora-page-title {
            margin: 0;
            color: var(--e7-heading, var(--e7-text, #22303f));
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .assettype-aurora .people-count {
            color: var(--e7-text-2, #55657a);
        }

            .assettype-aurora .people-count strong {
                color: var(--e7-accent-ink, #1d6f8d);
            }

        .assettype-aurora .form-control,
        .assettype-aurora .drpSearch {
            border: 1px solid var(--e7-border-2, #c9d4e0) !important;
            border-radius: 10px !important;
            background: var(--e7-surface, #fff) !important;
            color: var(--e7-text, #22303f) !important;
            box-shadow: none !important;
        }

            .assettype-aurora .form-control:focus,
            .assettype-aurora .drpSearch:focus {
                border-color: var(--e7-accent, #2f9ec4) !important;
                box-shadow: 0 0 0 3px rgba(47, 158, 196, 0.18) !important;
            }

        .assettype-aurora .btn-outline-dark,
        .assettype-aurora .btn-default {
            border: 1px solid var(--e7-border-2, #c9d4e0) !important;
            border-radius: 10px !important;
            color: var(--e7-text, #22303f) !important;
            background: var(--e7-surface-2, #f5f8fb) !important;
            box-shadow: none;
        }

        /* Hard-coded pair: white on dark teal (>= 5.3:1 in both themes). */
        .assettype-aurora .btn-success {
            border: 1px solid transparent !important;
            border-radius: 10px !important;
            background: linear-gradient(135deg, #0f766e, #0e7490) !important;
            color: #fff !important;
            font-weight: 800;
        }

            .assettype-aurora .btn-outline-dark:hover,
            .assettype-aurora .btn-default:hover,
            .assettype-aurora .btn-success:hover {
                transform: translateY(-1px);
                box-shadow: 0 6px 16px rgba(15, 23, 42, 0.14);
            }

        .assettype-aurora .aurora-search-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

            .assettype-aurora .aurora-search-actions .btn {
                flex: 1 1 90px;
                min-width: 0;
                white-space: nowrap;
                text-align: center;
            }

        .assettype-aurora .table-responsive {
            border: 1px solid var(--e7-border, #dde5ee);
            border-radius: 14px;
            background: var(--e7-surface-2, #f5f8fb);
            padding: 0 8px;
        }

        .assettype-aurora table.table {
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0 8px;
            color: var(--e7-text, #22303f);
            background: transparent;
        }

        .assettype-aurora thead.bg-primary {
            background: transparent !important;
        }

        .assettype-aurora thead th {
            border: 0 !important;
            padding: 12px 16px !important;
            background: var(--e7-surface-3, #eaf0f6) !important;
            color: var(--e7-accent-ink, #1d6f8d) !important;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .assettype-aurora thead th:first-child {
                border-top-left-radius: 12px;
                border-bottom-left-radius: 12px;
            }

            .assettype-aurora thead th:last-child {
                border-top-right-radius: 12px;
                border-bottom-right-radius: 12px;
            }

        .assettype-aurora tbody tr.aurora-row td {
            border-top: 1px solid var(--e7-border, #dde5ee) !important;
            border-bottom: 1px solid var(--e7-border, #dde5ee) !important;
            padding: 12px 16px !important;
            background: var(--e7-surface, #fff) !important;
            color: var(--e7-text, #22303f) !important;
            vertical-align: middle;
        }

            .assettype-aurora tbody tr.aurora-row td:first-child {
                border-left: 1px solid var(--e7-border, #dde5ee) !important;
                border-top-left-radius: 12px;
                border-bottom-left-radius: 12px;
            }

            .assettype-aurora tbody tr.aurora-row td:last-child {
                border-right: 1px solid var(--e7-border, #dde5ee) !important;
                border-top-right-radius: 12px;
                border-bottom-right-radius: 12px;
            }

        .assettype-aurora tbody tr.aurora-row:hover td {
            background: var(--e7-surface-3, #eaf0f6) !important;
        }

        .assettype-aurora .aurora-action-cell {
            width: 160px;
            text-align: center;
        }

        /* CIRCUIT chip: hard-coded pair, white on deep teal -> violet (>= 5.3:1). */
        .assettype-aurora .aurora-circuit-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-width: 126px;
            padding: 9px 14px;
            border: 1px solid rgba(255, 255, 255, 0.18);
            border-radius: 999px;
            color: #fff !important;
            background: linear-gradient(135deg, #0e7490 0%, #5b21b6 100%);
            box-shadow: 0 6px 16px rgba(15, 23, 42, 0.18);
            font-size: 12px;
            font-weight: 900;
            letter-spacing: 0.03em;
            text-decoration: none !important;
            text-transform: uppercase;
            transition: all 0.18s ease;
        }

            .assettype-aurora .aurora-circuit-btn i,
            .assettype-aurora .aurora-circuit-btn span {
                color: #fff !important;
            }

            .assettype-aurora .aurora-circuit-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 22px rgba(91, 33, 182, 0.30);
            }

        /* Status pills: hard-coded per theme. */
        .assettype-aurora .pill-badge-success {
            border: 1px solid #6ee7b7;
            background: #d1fae5 !important;
            color: #065f46 !important;
            font-weight: 800;
        }

        .assettype-aurora .pill-badge-yellow {
            border: 1px solid #fcd34d;
            background: #fef3c7 !important;
            color: #92400e !important;
            font-weight: 800;
        }

    html[data-aurora="dark"] .assettype-aurora .pill-badge-success {
        border-color: rgba(16, 185, 129, 0.45);
        background: #0b3b2e !important;
        color: #6ee7b7 !important;
    }

    html[data-aurora="dark"] .assettype-aurora .pill-badge-yellow {
        border-color: rgba(251, 191, 36, 0.45);
        background: #3d2e07 !important;
        color: #fde68a !important;
    }

        .assettype-aurora .faq-accordion .card-header h5 a,
        .assettype-aurora label.control-label {
            color: var(--e7-text, #22303f) !important;
            font-weight: 800;
        }

        .assettype-aurora .table-empty td {
            border-radius: 12px;
            background: var(--e7-surface, #fff) !important;
            color: var(--e7-text-2, #55657a) !important;
            padding: 28px !important;
        }
</style>

@Html.HiddenFor(m => m.SearchCriteria.ColumnName, new { id = "hdnColumnName" })
@Html.HiddenFor(m => m.SearchCriteria.SortDirection, new { id = "hdnSortDirection" })

<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />

<div class="container-fluid assettype-aurora">
    <div class="row">
        <div class="col-xl-9 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <div class="people-options clearfix">
                        <div class="pull-left aurora-title-block">
                            <h4 class="aurora-page-title">Asset Type Circuit Creator</h4>
                        </div>
                        <div class="btn-group pull-right people-pager" style="order:3;">
                            @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
                            @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
                        </div>
                        <div class="btn-group pull-right people-pager" style="order:2;">
                            <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left "></i></button>
                            <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>
                        </div>
                        @{
                            int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
                            if (Model.mAssetTypes.Count == 0)
                            {
                                start = 0;
                            }
                            decimal end = Math.Floor(Model.Pager.TotalRecord);
                            if (Model.Pager.PageSize < Model.Pager.TotalRecord)
                            {
                                if (Model.Pager.PageSize == -1)
                                {
                                    end = Model.Pager.TotalRecord;
                                }
                                else
                                {
                                    end = Model.Pager.PageSize * Model.Pager.CurrentPage;
                                    if (end > Model.Pager.TotalRecord)
                                    {
                                        end = Model.Pager.TotalRecord;
                                    }
                                }
                            }
                        }
                        <span class="people-count pull-right" style="order:1;">Showing <strong>@start - @Math.Floor(end)</strong> of <strong>@Math.Floor(Model.Pager.TotalRecord)</strong> Asset Types</span>
                    </div>

                </div>
                <div class="card-body" style="padding:15px;">
                    <div class="table-responsive vh-100">
                        <table class="table">
                            <thead class="bg-primary">
                                <tr>
                                    <th class="text-center">Circuit Creator</th>
                                    <th data-sortcolumn="Name" class="sorting" id="thName" onclick="SortList('Name');">Name</th>
                                    <th data-sortcolumn="IsActive" class="sorting" id="thIsActive" onclick="SortList('IsActive');" style="width:100px">Active?</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.mAssetTypes != null && Model.mAssetTypes.Count > 0)
                                {
                                    foreach (var item in Model.mAssetTypes)
                                    {
                                        <tr class="aurora-row">
                                            <td class="aurora-action-cell">
                                                <a href="@Url.Action("CircuitDiagramCreator", new { assetTypeId = item.Id })" data-placement="top" data-toggle="tooltip" class="tooltips aurora-circuit-btn" data-original-title="Circuit Creator">
                                                    <i class="fa fa-diamond"></i>
                                                    <span>Circuit</span>
                                                </a>
                                            </td>
                                            <td>@item.Name</td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="span badge rounded-pill pill-badge-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="span badge rounded-pill pill-badge-yellow">In Active</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="table-empty">
                                        <td colspan="3" class="text-center">
                                            No record found
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-lg-4">
            <div class="row">
                <div class="col-xl-12 default-according style-1 faq-accordion job-accordion">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <a class="btn btn-link">Search Asset Type</a>
                            </h5>
                        </div>
                        <div class="card-body filter-cards-view animate-chk">
                            <div class="form-group mb-4">
                                <label class="control-label center-block">Name:</label>
                                @Html.TextBoxFor(m => m.SearchCriteria.Name, new { @class = "form-control", type = "text", id = "txtSearchName" })
                            </div>
                            <div class="form-group">
                                <div class="aurora-search-actions">
                                    <a class="btn btn-success" onclick="Search()">Search</a>
                                    <a class="btn btn-default btn-quirk" onclick="Clear()">Clear</a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/PageJS/AssetType/AssetTypeList.js"></script>
<script>
    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmGetAssetTypeList").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize)
            {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmGetAssetTypeList").submit();
            }
        }
    }
</script>
