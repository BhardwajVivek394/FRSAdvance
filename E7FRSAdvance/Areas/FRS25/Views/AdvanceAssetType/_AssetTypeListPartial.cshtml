@model Domain.AssetTypeLister

<style>
    .assettype-aurora {
        min-height: 100vh;
        padding: 22px;
        color: #e5f7ff;
        background: radial-gradient(circle at 12% 8%, rgba(45, 212, 191, 0.20), transparent 34%), radial-gradient(circle at 88% 18%, rgba(168, 85, 247, 0.24), transparent 32%), radial-gradient(circle at 50% 92%, rgba(34, 211, 238, 0.18), transparent 38%), linear-gradient(135deg, #020617 0%, #08111f 45%, #0f172a 100%);
    }

        .assettype-aurora .card {
            overflow: hidden;
            border: 1px solid rgba(125, 211, 252, 0.18);
            border-radius: 20px;
            background: rgba(15, 23, 42, 0.74);
            box-shadow: 0 24px 70px rgba(0, 0, 0, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(18px);
        }

        .assettype-aurora .card-header {
            border-bottom: 1px solid rgba(125, 211, 252, 0.16);
            background: linear-gradient(135deg, rgba(8, 47, 73, 0.78), rgba(30, 41, 59, 0.72));
        }

        .assettype-aurora .card-body {
            background: rgba(2, 6, 23, 0.20);
        }

        .assettype-aurora .aurora-title-block {
            padding: 4px 0;
        }

        .assettype-aurora .aurora-page-kicker {
            display: block;
            margin-bottom: 3px;
            color: #67e8f9;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .assettype-aurora .aurora-page-title {
            margin: 0;
            color: #f8fafc;
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .assettype-aurora .people-count {
            color: #cbd5e1;
        }

            .assettype-aurora .people-count strong {
                color: #a7f3d0;
            }

        .assettype-aurora .form-control,
        .assettype-aurora .drpSearch {
            border: 1px solid rgba(125, 211, 252, 0.22) !important;
            border-radius: 12px !important;
            background: rgba(2, 6, 23, 0.66) !important;
            color: #e0f2fe !important;
            box-shadow: none !important;
        }

            .assettype-aurora .form-control:focus,
            .assettype-aurora .drpSearch:focus {
                border-color: rgba(45, 212, 191, 0.70) !important;
                box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.14) !important;
            }

        .assettype-aurora .btn-outline-dark,
        .assettype-aurora .btn-default,
        .assettype-aurora .btn-success {
            border: 1px solid rgba(125, 211, 252, 0.24) !important;
            border-radius: 12px !important;
            color: #e0f2fe !important;
            background: rgba(15, 23, 42, 0.72) !important;
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
        }

        .assettype-aurora .btn-success {
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.92), rgba(14, 165, 233, 0.82)) !important;
            color: #02111f !important;
            font-weight: 800;
        }

            .assettype-aurora .btn-outline-dark:hover,
            .assettype-aurora .btn-default:hover,
            .assettype-aurora .btn-success:hover {
                transform: translateY(-1px);
                box-shadow: 0 0 22px rgba(34, 211, 238, 0.20);
            }

        .assettype-aurora .table-responsive {
            border: 1px solid rgba(125, 211, 252, 0.12);
            border-radius: 18px;
            background: rgba(2, 6, 23, 0.28);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
        }

        .assettype-aurora table.table {
            margin-bottom: 0;
            border-collapse: separate;
            border-spacing: 0 10px;
            color: #e2e8f0;
        }

        .assettype-aurora thead.bg-primary {
            background: transparent !important;
        }

        .assettype-aurora thead th {
            border: 0 !important;
            padding: 14px 16px !important;
            background: rgba(14, 165, 233, 0.14) !important;
            color: #67e8f9 !important;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .assettype-aurora thead th:first-child {
                border-top-left-radius: 14px;
                border-bottom-left-radius: 14px;
            }

            .assettype-aurora thead th:last-child {
                border-top-right-radius: 14px;
                border-bottom-right-radius: 14px;
            }

        .assettype-aurora tbody tr.aurora-row td {
            border-top: 1px solid rgba(125, 211, 252, 0.12) !important;
            border-bottom: 1px solid rgba(125, 211, 252, 0.12) !important;
            padding: 14px 16px !important;
            background: rgba(15, 23, 42, 0.78) !important;
            color: #e2e8f0 !important;
            vertical-align: middle;
        }

            .assettype-aurora tbody tr.aurora-row td:first-child {
                border-left: 1px solid rgba(125, 211, 252, 0.12) !important;
                border-top-left-radius: 16px;
                border-bottom-left-radius: 16px;
            }

            .assettype-aurora tbody tr.aurora-row td:last-child {
                border-right: 1px solid rgba(125, 211, 252, 0.12) !important;
                border-top-right-radius: 16px;
                border-bottom-right-radius: 16px;
            }

        .assettype-aurora tbody tr.aurora-row:hover td {
            background: rgba(8, 47, 73, 0.68) !important;
            box-shadow: 0 0 26px rgba(34, 211, 238, 0.08);
        }

        .assettype-aurora .aurora-action-cell {
            width: 160px;
            text-align: center;
        }

        .assettype-aurora .aurora-circuit-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-width: 126px;
            padding: 9px 14px;
            border: 1px solid rgba(255, 255, 255, 0.22);
            border-radius: 999px;
            color: #020617 !important;
            background: linear-gradient(135deg, #22d3ee 0%, #a78bfa 48%, #34d399 100%);
            box-shadow: 0 0 18px rgba(34, 211, 238, 0.26), 0 12px 26px rgba(0, 0, 0, 0.24);
            font-size: 12px;
            font-weight: 900;
            letter-spacing: 0.03em;
            text-decoration: none !important;
            text-transform: uppercase;
            transition: all 0.18s ease;
        }

            .assettype-aurora .aurora-circuit-btn:hover {
                transform: translateY(-2px) scale(1.02);
                box-shadow: 0 0 28px rgba(167, 139, 250, 0.38), 0 14px 34px rgba(0, 0, 0, 0.30);
            }

        .assettype-aurora .pill-badge-success {
            border: 1px solid rgba(16, 185, 129, 0.40);
            background: rgba(16, 185, 129, 0.16) !important;
            color: #6ee7b7 !important;
            font-weight: 800;
        }

        .assettype-aurora .pill-badge-yellow {
            border: 1px solid rgba(251, 191, 36, 0.40);
            background: rgba(251, 191, 36, 0.15) !important;
            color: #fde68a !important;
            font-weight: 800;
        }

        .assettype-aurora .faq-accordion .card-header h5 a,
        .assettype-aurora label.control-label {
            color: #e0f2fe !important;
            font-weight: 800;
        }

        .assettype-aurora .table-empty td {
            border-radius: 16px;
            background: rgba(15, 23, 42, 0.74) !important;
            color: #94a3b8 !important;
            padding: 28px !important;
        }
</style>

@Html.HiddenFor(m => m.SearchCriteria.ColumnName, new { id = "hdnColumnName" })
@Html.HiddenFor(m => m.SearchCriteria.SortDirection, new { id = "hdnSortDirection" })

<input type="hidden" id="hdnCatListType" value="@ViewBag.Type" />
<input type="hidden" id="hdnCatListMessage" value="@ViewBag.Message" />

<div class="container-fluid assettype-aurora">
    <div class="row">
        <div class="col-xl-10">
            <div class="card">
                <div class="card-header">
                    <div class="people-options clearfix">
                        <div class="pull-left aurora-title-block">
                            <span class="aurora-page-kicker">Aurora Dark</span>
                            <h4 class="aurora-page-title">Asset Type Circuit Creator</h4>
                        </div>
                        <div class="btn-group pull-right people-pager">
                            @Html.HiddenFor(model => model.Pager.Skip, new { id = "hdnSkip" })
                            @Html.DropDownListFor(model => model.Pager.PageSize, new List<SelectListItem> { new SelectListItem { Text = "5", Value = "5" }, new SelectListItem { Text = "10", Value = "10" }, new SelectListItem { Text = "20", Value = "20" }, new SelectListItem { Text = "50", Value = "50" }, new SelectListItem { Text = "100", Value = "100" }, new SelectListItem { Text = "All", Value = "-1" } }, new { @class = "drpSearch form-control", id = "drpPageSize" })
                        </div>
                        <div class="btn-group pull-right people-pager">
                            <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Previous')"><i class="fa fa-chevron-left "></i></button>
                            <button type="button" class="btn btn-outline-dark" onclick="GetPagerButtonClick('Next')"><i class="fa fa-chevron-right"></i></button>
                        </div>
                        @{
                            int start = Convert.ToInt32(Model.Pager.CurrentPage - 1) * Model.Pager.PageSize + 1;
                            if (Model.mAssetTypes.Count == 0)
                            {
                                start = 0;
                            }
                            decimal end = Math.Floor(Model.Pager.TotalRecord);
                            if (Model.Pager.PageSize < Model.Pager.TotalRecord)
                            {
                                if (Model.Pager.PageSize == -1)
                                {
                                    end = Model.Pager.TotalRecord;
                                }
                                else
                                {
                                    end = Model.Pager.PageSize * Model.Pager.CurrentPage;
                                    if (end > Model.Pager.TotalRecord)
                                    {
                                        end = Model.Pager.TotalRecord;
                                    }
                                }
                            }
                        }
                        <span class="people-count pull-right" style="margin-top:10px;">Showing <strong>@start - @Math.Floor(end)</strong> of <strong>@Math.Floor(Model.Pager.TotalRecord)</strong> Asset Types</span>
                    </div>

                </div>
                <div class="card-body" style="padding:15px;">
                    <div class="table-responsive vh-100">
                        <table class="table">
                            <thead class="bg-primary">
                                <tr>
                                    <th class="text-center">Circuit Creator</th>
                                    <th data-sortcolumn="Name" class="sorting" id="thName" onclick="SortList('Name');">Name</th>
                                    <th data-sortcolumn="IsActive" class="sorting" id="thIsActive" onclick="SortList('IsActive');" style="width:100px">Active?</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.mAssetTypes != null && Model.mAssetTypes.Count > 0)
                                {
                                    foreach (var item in Model.mAssetTypes)
                                    {
                                        <tr class="aurora-row">
                                            <td class="aurora-action-cell">
                                                <a href="@Url.Action("CircuitDiagramCreator", new { assetTypeId = item.Id })" data-placement="top" data-toggle="tooltip" class="tooltips aurora-circuit-btn" data-original-title="Circuit Creator">
                                                    <i class="fa fa-diamond"></i>
                                                    <span>Circuit</span>
                                                </a>
                                            </td>
                                            <td>@item.Name</td>
                                            <td>
                                                @if (item.IsActive)
                                                {
                                                    <span class="span badge rounded-pill pill-badge-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="span badge rounded-pill pill-badge-yellow">In Active</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="table-empty">
                                        <td colspan="3" class="text-center">
                                            No record found
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 xl-40">
            <div class="row">
                <div class="col-xl-12 default-according style-1 faq-accordion job-accordion">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">
                                <a class="btn btn-link">Search Asset Type</a>
                            </h5>
                        </div>
                        <div class="card-body filter-cards-view animate-chk">
                            <div class="form-group mb-4">
                                <label class="control-label center-block">Name:</label>
                                @Html.TextBoxFor(m => m.SearchCriteria.Name, new { @class = "form-control", type = "text", id = "txtSearchName" })
                            </div>
                            <div class="form-group">
                                <div class="row">
                                    <div class="col-sm-6">
                                        <a class="btn btn-success" onclick="Search()">Search</a>
                                    </div>
                                    <div class="col-sm-6">
                                        <a class="btn btn-default btn-quirk btn-block" onclick="Clear()">Clear</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/Content/PageJS/AssetType/AssetTypeList.js"></script>
<script>
    function GetPagerButtonClick(btn) {
        if (btn == "Next") {
            if (@Model.Pager.TotalPage != @Model.Pager.CurrentPage) {
                var hdnSkip = $("#hdnSkip").val();
                var pageSize = @Model.Pager.PageSize;
                var skip = parseInt(hdnSkip) + parseInt(pageSize);
                $("#hdnSkip").val(skip);
                $("#frmGetAssetTypeList").submit();
            }
        }
        else if (btn == "Previous") {
            if (@Model.Pager.Skip >= @Model.Pager.PageSize)
            {
                var skip =@Model.Pager.Skip;
                skip = skip - @Model.Pager.PageSize;
                $("#hdnSkip").val(skip);
                $("#frmGetAssetTypeList").submit();
            }
        }
    }
</script>
