@model Domain.AssetTypeLister

@{
    ViewBag.Title = "Asset Types";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml"; }
}

<script src="~/assets/js/jquery-3.5.1.min.js"></script>

<div class="container-fluid">
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="#"> <i data-feather="home"></i></a></li>
                    <li class="breadcrumb-item active">Asset type</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="">
    <div class="">

        @using (Ajax.BeginForm("AssetTypeList", "AssetType", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divAssetTypeList",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "AssetTypeRefreshed"
        }, new { id = "frmGetAssetTypeList" }))
        {
            { HtmlHelper.ClientValidationEnabled = false; }
            <div id="divAssetTypeList">
                @Html.Action("AssetTypeList")
            </div>
        }


        @using (Ajax.BeginForm("SaveAssetType", "AssetType", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveAssetType",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",
            OnSuccess = "AssetTypeSaved"
        }, new { id = "frmSaveAssetType" }))
        {
            <div id="divSaveAssetType">
                @Html.Partial("_AddAssetTypePartial", new Domain.AssetType())
            </div>
        }

        @using (Ajax.BeginForm("SaveAttributes", "AssetType", new AjaxOptions()
        {
            HttpMethod = "POST",
            UpdateTargetId = "divSaveAttributes",
            InsertionMode = InsertionMode.Replace,
            LoadingElementId = "loader",

        }, new { id = "frmSaveAttributes" }))
        {
            <div id="divSaveAttributes">
                @Html.Partial("_AddAttributesPartial", new Domain.AssetAttribute())
            </div>
        }

    </div>
</div>
<script src="~/Content/PageJS/AssetType/AssetTypeIndex.js"></script>