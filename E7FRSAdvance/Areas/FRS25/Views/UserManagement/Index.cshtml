    function umLoadUserClasses(callback) {

        var typeId = $('#umDdlRole').val();
        var $dd = $('#umDdlUserClass').html('<option value="">— Select User Class —</option>').trigger('change.select2');

        // Show Is Admin checkbox only for Division Level or Headquarter Level user types
        var DIVISION_LEVEL_ID = 2; // UserClassType.DivisionLevelUser
        var HEADQUARTER_LEVEL_ID = 3; // UserClassType.HeadquarterLevelUser
        var tid = parseInt(typeId, 10);
        if (tid === DIVISION_LEVEL_ID || tid === HEADQUARTER_LEVEL_ID) {
            $('#umIsAdminWrapper').show();
        } else {
            $('#umIsAdminWrapper').hide();
            $('#umChkIsAdmin').prop('checked', false);
        }

        if (!typeId) { if (typeof callback === 'function') callback(); return; }
    $.ajax({
        url: '@Url.Action("GetAllUserClassByTypeId", "UserManagement", new { Area = "FRS25" })',
        type: 'POST',
        data: { userClassTypeId: parseInt(typeId, 10) },
        success: function (data) {
            if (data && data.length > 0) {
                $.each(data, function (i, uc) {
                    $dd.append('<option value="' + uc.Id + '">' + uc.ClassName + '</option>');
                });
            }
            $dd.trigger('change.select2');
            if (typeof callback === 'function') callback();
        },
        error: function () {
            $dd.trigger('change.select2');
            if (typeof callback === 'function') callback();
        }
    });
}

    function umLoadUserList() {
        umShowLoad();
        var pgSizeVal = parseInt($('#umPageSize').val(), 10);
        if (pgSizeVal > 0) umPager.Take = pgSizeVal;
        if (!umPager.Take || umPager.Take <= 0) umPager.Take = 10;
        var cleanDivIds = [], cleanSiteIds = [];
        if (umSearch.DivisionIds) for (var i = 0; i < umSearch.DivisionIds.length; i++) { var p = parseInt(umSearch.DivisionIds[i], 10); if (!isNaN(p) && p > 0) cleanDivIds.push(p); }
        if (umSearch.SiteIds) for (var i = 0; i < umSearch.SiteIds.length; i++) { var p = parseInt(umSearch.SiteIds[i], 10); if (!isNaN(p) && p > 0) cleanSiteIds.push(p); }
        $.ajax({
            url: '@Url.Action("GetUserListJson", "UserManagement", new { Area = "FRS25" })',
            type: 'POST', contentType: 'application/json; charset=utf-8', dataType: 'json',
            timeout: 15000,
            data: JSON.stringify({
                SearchCriteria: {Id:@E7FRSAdvance.Utility.ClsHttpContent.LoginUser.Id, FirstName: umSearch.FirstName || '', LastName: umSearch.LastName || '', PhoneNumber: umSearch.PhoneNumber || '', EmailAddress: umSearch.EmailAddress || '', ZoneId: UM_ZONE_ID, ZoneIds: [UM_ZONE_ID], DivisionId: umSearch.DivisionId || 0, DivisionIds: cleanDivIds, SiteId: umSearch.SiteId || 0, SiteIds: cleanSiteIds, Designations: umSearch.Designations || [], StatusList: umSearch.StatusList || [], ColumnName: umSearch.ColumnName || 'Id', SortDirection: umSearch.SortDirection || 'DESC', RoleId: @E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId },
                Pager: { Skip: parseInt(umPager.Skip) || 0, Take: parseInt(umPager.Take) || 10, PageSize: parseInt(umPager.Take) || 10, TotalRecord: 0, CurrentPage: 1, TotalPage: "1" }
            }),
            success: function (r) {
                umHideLoad();
                //if (r && r.IsSuccess !== false) {
                //    umPager.TotalRecord = r.Pager ? r.Pager.TotalRecord : 0;
                //    var totalPages = umPager.Take > 0 ? Math.ceil(umPager.TotalRecord / umPager.Take) : 1;
                //    if (totalPages < 1) totalPages = 1;
                //    umPager.TotalPage = String(totalPages);
                //    umPager.CurrentPage = umPager.Take > 0 ? Math.floor(umPager.Skip / umPager.Take) + 1 : 1;
                //    if (umPager.CurrentPage > totalPages) umPager.CurrentPage = totalPages;
                //    umRenderTable(r.Users || []);
                //} else { umRenderTable([]); }
                //umRenderPagination();
                if (r && r.IsSuccess !== false) {
                    // ✅ FIX 1: Force integer — server returns 32.0 (float) not 32
                    umPager.TotalRecord = r.Pager ? parseInt(r.Pager.TotalRecord, 10) : 0;

                    var totalPages = umPager.Take > 0 ? Math.ceil(umPager.TotalRecord / umPager.Take) : 1;
                    if (totalPages < 1) totalPages = 1;
                    umPager.TotalPage = String(totalPages);
                    umPager.CurrentPage = umPager.Take > 0 ? Math.floor(umPager.Skip / umPager.Take) + 1 : 1;
                    if (umPager.CurrentPage > totalPages) umPager.CurrentPage = totalPages;

                    // ✅ FIX 2: Confirm users array exists before rendering
                    var users = r.Users || r.users || [];
                    console.log('Users received:', users.length, users[0]); // ← remove after confirming
                    umRenderTable(users);
                } else {
                    umRenderTable([]);
                }
                umRenderPagination();
            },
            error: function () { umHideLoad(); umRenderTable([]); umRenderPagination(); umToast('Error loading users.', 'danger'); }
        });
    }

    function umRenderTable(users) {

