    function umEsc(s) { return (s || '').replace(/'/g, "\\'").replace(/"/g, '&quot;'); }

    function umRenderPagination() {
        var tot = umPager.TotalRecord || 0, take = umPager.Take || 10;
        var tp = take > 0 ? Math.ceil(tot / take) : 1;
        if (tp < 1) tp = 1;
        var cp = umPager.CurrentPage || 1;
        if (cp > tp) cp = tp;
        var from = tot > 0 ? umPager.Skip + 1 : 0;
        var to = Math.min(umPager.Skip + take, tot);
        $('#umPgFrom').text(from); $('#umPgTo').text(to); $('#umPgTotal').text(tot);
        $('#umPageSize').val(String(take));
        var $pg = $('#umPagination').empty();
        if (tp <= 1) return;
        $pg.append('<li class="page-item ' + (cp === 1 ? 'disabled' : '') + '"><a class="page-link" href="javascript:void(0)" onclick="umGoPage(1)" title="First"><i class="fas fa-angle-double-left"></i></a></li>');
        $pg.append('<li class="page-item ' + (cp === 1 ? 'disabled' : '') + '"><a class="page-link" href="javascript:void(0)" onclick="umGoPage(' + (cp - 1) + ')" title="Previous"><i class="fas fa-chevron-left"></i></a></li>');
        var maxVisible = 7, half = Math.floor(maxVisible / 2);
        var sp = Math.max(1, cp - half), ep = Math.min(tp, sp + maxVisible - 1);
        if (ep - sp < maxVisible - 1) sp = Math.max(1, ep - maxVisible + 1);
        if (sp > 1) { $pg.append('<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="umGoPage(1)">1</a></li>'); if (sp > 2) $pg.append('<li class="page-item disabled"><span class="page-link">…</span></li>'); }
        for (var p = sp; p <= ep; p++) { $pg.append('<li class="page-item ' + (p === cp ? 'active' : '') + '"><a class="page-link" href="javascript:void(0)" onclick="umGoPage(' + p + ')">' + p + '</a></li>'); }
        if (ep < tp) { if (ep < tp - 1) $pg.append('<li class="page-item disabled"><span class="page-link">…</span></li>'); $pg.append('<li class="page-item"><a class="page-link" href="javascript:void(0)" onclick="umGoPage(' + tp + ')">' + tp + '</a></li>'); }
        $pg.append('<li class="page-item ' + (cp >= tp ? 'disabled' : '') + '"><a class="page-link" href="javascript:void(0)" onclick="umGoPage(' + (cp + 1) + ')" title="Next"><i class="fas fa-chevron-right"></i></a></li>');
        $pg.append('<li class="page-item ' + (cp >= tp ? 'disabled' : '') + '"><a class="page-link" href="javascript:void(0)" onclick="umGoPage(' + tp + ')" title="Last"><i class="fas fa-angle-double-right"></i></a></li>');
    }

    function umGoPage(p) {
        var take = umPager.Take || 10, tp = take > 0 ? Math.ceil((umPager.TotalRecord || 0) / take) : 1;
        if (tp < 1) tp = 1; if (p < 1 || p > tp) return;
        umPager.Skip = (p - 1) * take; umPager.CurrentPage = p; umLoadUserList();
    }

