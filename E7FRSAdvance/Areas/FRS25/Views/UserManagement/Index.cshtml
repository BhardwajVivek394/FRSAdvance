@{ ViewBag.Title = "User Management";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml"; }
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet">
<style>
    :root {
        --um-primary: #1a56db;
        --um-success: #059669;
        --um-warning: #d97706;
        --um-danger: #dc2626;
        --um-bg: #f1f5f9;
        --um-card: #fff;
        --um-border: #e2e8f0;
        --um-text: #0f172a;
        --um-muted: #94a3b8;
        --um-railway: #01579b
    }

    /* ── Page Header ── */
    .um-page-header {
        background: var(--primary);
        padding: 20px 28px;
        color: #fff;
        border-radius: 10px;
        margin-bottom: 20px
    }

        .um-page-header h1 {
            font-size: 1.5rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0
        }

        .um-page-header .subtitle {
            font-size: .85rem;
            opacity: .9;
            margin-top: 4px
        }

        .um-page-header .zone-badge {
            background: rgba(255,255,255,.15);
            padding: 5px 12px;
            border-radius: 16px;
            font-size: .8rem;
            display: inline-flex;
            align-items: center;
            gap: 5px;
            margin-top: 8px
        }

    .um-content {
        padding: 0
    }

    /* ── Card Panel ── */
    .card-panel {
        background: var(--um-card);
        border: 1px solid var(--um-border);
        border-radius: 10px;
        margin-bottom: 16px
    }

    .card-panel-header {
        padding: 14px 18px;
        border-bottom: 1px solid var(--um-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #f8fafc;
        border-radius: 10px 10px 0 0;
        flex-wrap: wrap;
        gap: 10px
    }

        .card-panel-header h5 {
            margin: 0;
            font-weight: 600;
            font-size: .95rem;
            display: flex;
            align-items: center;
            gap: 8px
        }

    .card-panel-body {
        padding: 18px
    }

    /* ── Form Labels ── */
    .form-label {
        font-weight: 600;
        font-size: .78rem;
        color: #475569;
        margin-bottom: 5px;
        letter-spacing: .2px
    }

        .form-label .req {
            color: var(--um-danger)
        }

        .form-label .opt {
            color: var(--um-muted);
            font-weight: 400;
            font-size: .72rem
        }

    /* ── Buttons ── */
    .btn-primary-c {
        background: var(--primary);
        border: none;
        color: #fff;
        padding: 8px 20px;
        border-radius: 6px;
        font-weight: 600;
        font-size: .85rem;
        cursor: pointer;
        transition: all .2s
    }

        .btn-primary-c:hover {
            background: #1e40af;
            color: #fff
        }

    .btn-secondary-c {
        background: #fff;
        border: 1px solid var(--um-border);
        color: #64748b;
        padding: 8px 20px;
        border-radius: 6px;
        font-weight: 500;
        font-size: .85rem;
        cursor: pointer
    }

    .btn-warning-c {
        background: var(--um-warning);
        border: none;
        color: #fff;
        padding: 8px 20px;
        border-radius: 6px;
        font-weight: 600;
        font-size: .85rem;
        cursor: pointer
    }

        .btn-warning-c:hover {
            background: #b45309;
            color: #fff
        }

    .btn-icon {
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        cursor: pointer;
        border: none;
        font-size: .85rem;
        transition: all .2s
    }

    .btn-icon-edit {
        background: rgba(26,86,219,.1);
        color: var(--um-primary)
    }

        .btn-icon-edit:hover {
            background: var(--um-primary);
            color: #fff
        }

    .btn-icon-delete {
        background: rgba(220,38,38,.1);
        color: var(--um-danger)
    }

        .btn-icon-delete:hover {
            background: var(--um-danger);
            color: #fff
        }

    .btn-icon-toggle {
        background: rgba(5,150,105,.1);
        color: var(--um-success)
    }

        .btn-icon-toggle:hover {
            background: var(--um-success);
            color: #fff
        }

    .btn-icon-reset {
        background: rgba(217,119,6,.1);
        color: var(--um-warning)
    }

        .btn-icon-reset:hover {
            background: var(--um-warning);
            color: #fff
        }

    .btn-icon-user {
        background: rgba(99,102,241,.1);
        color: #6366f1
    }

        .btn-icon-user:hover {
            background: #6366f1;
            color: #fff
        }

    /* ── Badges ── */
    .badge-d {
        padding: 3px 9px;
        border-radius: 12px;
        font-size: .7rem;
        font-weight: 600;
        display: inline-block
    }

    .badge-cste {
        background: #dbeafe;
        color: #1e40af
    }

    .badge-aste {
        background: #e0e7ff;
        color: #3730a3
    }

    .badge-dste {
        background: #ede9fe;
        color: #5b21b6
    }

    .badge-sse {
        background: #d1fae5;
        color: #065f46
    }

    .badge-je {
        background: #ccfbf1;
        color: #0f766e
    }

    .badge-se {
        background: #fce7f3;
        color: #9d174d
    }

    .badge-esm {
        background: #f3e8ff;
        color: #7c3aed
    }

    .badge-r {
        padding: 2px 6px;
        border-radius: 4px;
        font-size: .65rem;
        font-weight: 600;
        margin-left: 5px
    }

    .badge-r-officer {
        background: #dbeafe;
        color: #1e40af
    }

    .badge-r-supervisor {
        background: #fef3c7;
        color: #92400e
    }

    .badge-r-maintainer {
        background: #d1fae5;
        color: #065f46
    }

    /* ── Status ── */
    .status-on {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 9px;
        background: #d1fae5;
        color: #065f46;
        border-radius: 12px;
        font-size: .7rem;
        font-weight: 600
    }

        .status-on::before {
            content: '';
            width: 5px;
            height: 5px;
            background: #059669;
            border-radius: 50%
        }

    .status-off {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 9px;
        background: #fee2e2;
        color: #991b1b;
        border-radius: 12px;
        font-size: .7rem;
        font-weight: 600
    }

        .status-off::before {
            content: '';
            width: 5px;
            height: 5px;
            background: #dc2626;
            border-radius: 50%
        }

    /* ── Stats Row ── */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 14px;
        margin-bottom: 20px
    }

    .stat-card {
        background: #fff;
        border: 1px solid var(--um-border);
        border-radius: 8px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: transform .2s, box-shadow .2s
    }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0,0,0,.08)
        }

    .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem
    }

    .stat-icon-blue {
        background: rgba(26,86,219,.1);
        color: var(--um-primary)
    }

    .stat-icon-green {
        background: rgba(5,150,105,.1);
        color: var(--um-success)
    }

    .stat-icon-amber {
        background: rgba(217,119,6,.1);
        color: var(--um-warning)
    }

    .stat-icon-purple {
        background: rgba(124,58,237,.1);
        color: #7c3aed
    }

    .stat-icon-red {
        background: rgba(220,38,38,.1);
        color: var(--um-danger)
    }

    .stat-info h3 {
        font-size: 1.3rem;
        font-weight: 700;
        margin: 0
    }

    .stat-info p {
        font-size: .75rem;
        color: var(--um-muted);
        margin: 0
    }

    /* ── Data Table ── */
    .data-table thead th {
        background: #f8fafc;
        font-weight: 600;
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #64748b;
        padding: 10px 12px;
        border-bottom: 2px solid var(--um-border);
        white-space: nowrap
    }

    .data-table tbody td {
        padding: 10px 12px;
        font-size: .85rem;
        vertical-align: middle;
        border-bottom: 1px solid #f1f5f9
    }

    .data-table tbody tr:hover {
        background: #f8fafc
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 8px
    }

    .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: var(--primary);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: .8rem;
        flex-shrink: 0
    }

        .user-avatar.no-name {
            background: linear-gradient(135deg, #64748b, #94a3b8)
        }

    .user-details h6 {
        margin: 0;
        font-weight: 600;
        font-size: .85rem
    }

    .user-details .no-name {
        color: var(--um-muted);
        font-style: italic
    }

    .user-details small {
        color: var(--um-muted);
        font-size: .7rem
    }

    .loc-info {
        font-size: .8rem
    }

        .loc-info .div {
            font-weight: 600
        }

        .loc-info .stn {
            color: #64748b
        }

    /* ── Filter Row ── */
    .filter-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 16px;
        align-items: flex-end
    }

        .filter-row .form-group {
            flex: 1;
            min-width: 170px
        }

            .filter-row .form-group.fg-search {
                min-width: 200px
            }

    /* ── Select2 Shared Styles ── */
    .select2-container--bootstrap-5 .select2-selection {
        border-radius: 6px !important;
        border: 1px solid var(--um-border) !important;
        min-height: 38px !important;
        font-size: .85rem !important;
        background: #fff !important
    }

    .select2-container--bootstrap-5 .select2-selection--multiple {
        padding: 2px 4px !important;
        min-height: 38px !important
    }

        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice {
            background: var(--primary);
            color: #fff !important;
            border: none !important;
            border-radius: 4px !important;
            font-size: .72rem !important;
            padding: 2px 6px !important;
            margin: 2px 3px 2px 0 !important;
            line-height: 1.4 !important
        }

        .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice__remove {
            color: rgba(255,255,255,.7) !important;
            border-right: 1px solid rgba(255,255,255,.25) !important;
            padding: 0 4px 0 2px !important;
            margin-right: 4px !important
        }

            .select2-container--bootstrap-5 .select2-selection--multiple .select2-selection__choice__remove:hover {
                color: #fff !important;
                background: transparent !important
            }

        .select2-container--bootstrap-5 .select2-selection--multiple .select2-search__field {
            font-size: .8rem !important;
            margin-top: 2px !important
        }

            .select2-container--bootstrap-5 .select2-selection--multiple .select2-search__field::placeholder {
                color: var(--um-muted) !important;
                font-size: .8rem !important
            }

    /* ── Select2 Dropdown ── */
    .select2-container--bootstrap-5 .select2-dropdown {
        border: 1px solid var(--um-border) !important;
        border-radius: 6px !important;
        box-shadow: 0 6px 16px rgba(0,0,0,.1) !important;
        margin-top: 2px !important
    }

    .select2-container--bootstrap-5 .select2-results__option {
        font-size: .82rem !important;
        padding: 7px 12px !important
    }

    .select2-container--bootstrap-5 .select2-results__option--highlighted {
        background: rgba(26,86,219,.08) !important;
        color: var(--um-text) !important
    }

    .select2-container--bootstrap-5 .select2-results__option--selected {
        background: rgba(26,86,219,.12) !important;
        color: var(--um-primary) !important;
        font-weight: 600 !important
    }

    .select2-container--bootstrap-5 .select2-search--dropdown .select2-search__field {
        border: 1px solid var(--um-border) !important;
        border-radius: 4px !important;
        font-size: .82rem !important;
        padding: 6px 8px !important
    }

    /* ── Clear Filters ── */
    .btn-clear-filters {
        background: none;
        border: 1px dashed var(--um-border);
        color: var(--um-muted);
        padding: 7px 14px;
        border-radius: 6px;
        font-size: .78rem;
        cursor: pointer;
        white-space: nowrap;
        height: 38px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all .2s
    }

        .btn-clear-filters:hover {
            border-color: var(--um-danger);
            color: var(--um-danger);
            background: rgba(220,38,38,.04)
        }

    /* ══════════════════════════════════════════════
       MODAL STYLES
       ══════════════════════════════════════════════ */
    .modal-header {
        padding: 16px 24px;
        border-bottom: 1px solid var(--um-border);
        background: var(--primary);
        border-radius: 12px 12px 0 0
    }

        .modal-header .modal-title {
            color: #fff;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 1.05rem
        }

        .modal-header .btn-close {
            display: none
        }

        .modal-header .um-close-btn {
            background: rgba(255,255,255,.2);
            border: none;
            color: #fff;
            width: 30px;
            height: 30px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background .2s;
            line-height: 1;
            padding: 0
        }

            .modal-header .um-close-btn:hover {
                background: rgba(255,255,255,.35)
            }

    .modal-body {
        padding: 24px;
        max-height: 70vh;
        overflow-y: auto;
        background: #fafbfc
    }

    .modal-footer {
        padding: 14px 24px;
        border-top: 1px solid var(--um-border);
        background: #f8fafc;
        border-radius: 0 0 12px 12px
    }

    .modal-content {
        border: none;
        border-radius: 12px;
        box-shadow: 0 20px 60px rgba(0,0,0,.15)
    }

    /* ── Modal Section Dividers ── */
    .section-divider {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 22px 0 14px 0;
        padding-bottom: 0
    }

        .section-divider:first-child {
            margin-top: 0
        }

        .section-divider span {
            font-size: .72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .8px;
            color: var(--primary);
            white-space: nowrap
        }

        .section-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: linear-gradient(90deg, var(--um-border), transparent)
        }

    /* ── Modal Form Fields ── */
    .modal .form-control,
    .modal .form-select {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: .85rem;
        padding: 8px 12px;
        transition: border-color .2s, box-shadow .2s;
        background: #fff
    }

        .modal .form-control:focus,
        .modal .form-select:focus {
            border-color: var(--um-primary);
            box-shadow: 0 0 0 3px rgba(26,86,219,.1)
        }

    .modal .input-group-text {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px 0 0 8px;
        color: #64748b;
        font-size: .85rem
    }

    .modal .input-group .form-control {
        border-radius: 0 8px 8px 0
    }

    .modal-section-card {
        background: #fff;
        border: 1px solid #e8ecf1;
        border-radius: 10px;
        padding: 16px 18px;
        margin-bottom: 16px
    }

    .cug-info {
        background: linear-gradient(135deg, #fefce8, #fef9c3);
        border: 1px solid #fcd34d;
        border-left: 4px solid #f59e0b;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: .8rem;
        color: #92400e;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 8px
    }

        .cug-info i {
            font-size: 1rem;
            color: #d97706
        }

    .select-all-info {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: .78rem;
        color: #1e40af;
        margin-top: 6px;
        display: none;
        align-items: center;
        gap: 6px
    }

        .select-all-info.show {
            display: flex
        }

        .select-all-info i {
            color: #3b82f6
        }

    .select2-container--disabled .select2-selection {
        background: #f1f5f9 !important;
        opacity: .65;
        cursor: not-allowed !important
    }

    /* Frozen Division Indicator for Divisional Admin */
    .division-frozen-indicator {
        background: linear-gradient(135deg, #fef3c7, #fde68a);
        border: 1px solid #f59e0b;
        border-left: 4px solid #d97706;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: .8rem;
        color: #92400e;
        margin-bottom: 12px;
        display: flex;
        align-items: center;
        gap: 8px
    }

        .division-frozen-indicator i {
            font-size: 1rem;
            color: #d97706
        }

    .select2-container--disabled .select2-selection--single,
    .select2-container--disabled .select2-selection--multiple {
        background: linear-gradient(135deg, #e0f2fe, #bae6fd) !important;
        border: 1px solid #0284c7 !important;
        opacity: 1 !important
    }

    /* ── Password Strength ── */
    .pwd-strength {
        height: 4px;
        border-radius: 2px;
        margin-top: 6px;
        background: #e2e8f0;
        overflow: hidden
    }

    .pwd-bar {
        height: 100%;
        border-radius: 2px;
        width: 0;
        transition: width .3s, background .3s
    }

        .pwd-bar.weak {
            width: 25%;
            background: var(--um-danger)
        }

        .pwd-bar.fair {
            width: 50%;
            background: var(--um-warning)
        }

        .pwd-bar.good {
            width: 75%;
            background: #84cc16
        }

        .pwd-bar.strong {
            width: 100%;
            background: var(--um-success)
        }

    .pwd-label {
        font-size: .68rem;
        font-weight: 600;
        margin-top: 3px;
        display: block
    }

    /* ── Shimmer ── */
    .stat-shimmer {
        background: linear-gradient(90deg, #e2e8f0 25%, #f1f5f9 50%, #e2e8f0 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
        border-radius: 4px;
        height: 24px;
        width: 40px;
        display: inline-block
    }

    @@keyframes shimmer {
        0% {
            background-position: 200% 0
        }

        100% {
            background-position: -200% 0
        }
    }

    /* ── Loading Overlay ── */
    .um-loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15,23,42,.45);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        transition: opacity .2s
    }

        .um-loading-overlay.show {
            display: flex
        }

    .um-loader-box {
        background: #fff;
        border-radius: 16px;
        padding: 32px 44px;
        box-shadow: 0 20px 60px rgba(0,0,0,.18), 0 0 0 1px rgba(255,255,255,.1);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
        min-width: 200px
    }

    .um-loader-dots {
        display: flex;
        gap: 8px;
        align-items: center
    }

        .um-loader-dots span {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--primary, #1a56db);
            animation: umDotBounce 1.4s ease-in-out infinite both
        }

            .um-loader-dots span:nth-child(1) {
                animation-delay: -0.32s
            }

            .um-loader-dots span:nth-child(2) {
                animation-delay: -0.16s
            }

            .um-loader-dots span:nth-child(3) {
                animation-delay: 0s
            }

    @@keyframes umDotBounce {
        0%, 80%, 100% {
            transform: scale(0.4);
            opacity: .4
        }

        40% {
            transform: scale(1);
            opacity: 1
        }
    }

    .um-loader-text {
        font-size: .88rem;
        font-weight: 600;
        color: #334155;
        letter-spacing: .3px
    }

    .um-loader-sub {
        font-size: .72rem;
        color: #94a3b8;
        margin-top: -10px
    }

    .toast-container-um {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 10000
    }

    /* ── Jurisdiction Panel ── */
    .jurisdiction-panel {
        background: #f8fafc;
        border: 1px solid var(--um-border);
        border-radius: 8px;
        padding: 14px 16px;
        min-height: 48px;
        font-size: .85rem;
        color: #475569
    }

