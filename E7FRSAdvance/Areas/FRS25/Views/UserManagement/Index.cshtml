        for (var i = 0; i < users.length; i++) {
            var u = users[i];
            u.DivisionNames = (u.DivisionNames && u.DivisionNames.length > 0) ? u.DivisionNames : (u.divisionNames || []);
            u.SiteNames = (u.SiteNames && u.SiteNames.length > 0) ? u.SiteNames : (u.siteNames || []);
            u.SectionNames = (u.SectionNames && u.SectionNames.length > 0) ? u.SectionNames : (u.sectionNames || []);
