                            if (secIdsToSelect.length > 0) { _umModalSecBusy = true; $('#umDdlSection').val(secIdsToSelect).trigger('change.select2'); _umModalSecBusy = false; }
                            umLoadModalSitesByDivision(intDivIds, function () {
