                //umLoadRoles(function () {
                //    if (u.UserClassId) { $('#umDdlRole').val(String(u.UserClassId)).trigger('change.select2'); $('#umDdlRole').data('prevRoleVal', String(u.UserClassId)); }
                //    umLoadUserClasses(function () {
                //        if (u.UserClassId) $('#umDdlUserClass').val(String(u.UserClassId)).trigger('change.select2');
                //        // Set IsAdmin checkbox after wrapper is visible
                //        $('#umChkIsAdmin').prop('checked', u.IsConfiguration == 1 || u.IsConfiguration === true);
                //    });
                //});
                umLoadRoles(function () {
                    var userClassTypeId = umGetUserClassTypeId(u.UserClassId);
                    if (userClassTypeId) { $('#umDdlRole').val(String(userClassTypeId)).trigger('change.select2'); $('#umDdlRole').data('prevRoleVal', String(userClassTypeId)); }
                    umLoadUserClasses(function () {
                        if (u.UserClassId) $('#umDdlUserClass').val(String(u.UserClassId)).trigger('change.select2');
                        $('#umChkIsAdmin').prop('checked', u.IsConfiguration == 1 || u.IsConfiguration === true);
                    });
                });
                umLoadModalDivisions(function () {
                    var divIdsToSelect = [];

                    // For Divisional Admin: Use their fixed division
                    if (UM_IS_DIVISIONAL_ADMIN && UM_USER_DIVISION_ID > 0) {
                        divIdsToSelect = [String(UM_USER_DIVISION_ID)];
                    } else {
                        if (u.DivisionIds && u.DivisionIds.length > 0) { divIdsToSelect = u.DivisionIds.map(function(v) { return String(v); }); }
                        else if (u.DivisionId) { divIdsToSelect = [String(u.DivisionId)]; }
                    }

                    if (divIdsToSelect.length > 0) {
                        _umModalDivBusy = true; $('#umDdlDiv').val(divIdsToSelect).trigger('change.select2'); _umModalDivBusy = false;
                        var intDivIds = divIdsToSelect.map(function(v) { return parseInt(v, 10); }).filter(function(v) { return !isNaN(v) && v > 0; });
                        umLoadModalSectionsByDivision(intDivIds, function () {
                            var secIdsToSelect = [];
