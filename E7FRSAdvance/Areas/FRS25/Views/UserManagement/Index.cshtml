        JE:   { role: 'Supervisor', scope: 'Site',     desc: 'Site Level Access' },
        SE:   { role: 'Maintainer', scope: 'Site',     desc: 'Site Level Access' },
        ESM:  { role: 'Maintainer', scope: 'Site',     desc: 'Site Level Access' }
    };
    // UserClass enum values
    var UM_USER_CLASS = { ESM: 1, SSECSI: 2, SRDSTECONTROL: 3, ENERGY7CONTROL: 4, Supervisor: 9, ASTEDSTE: 10, JE: 11, Guest: 14, OtherOfficer:15 };
    // UserClassType enum values
    var UM_USER_CLASS_TYPE = { StationLevelUser: 1, DivisionLevelUser: 2, HeadquarterLevelUser: 3, GuestUser: 4, VendorUser: 5 };

    function umGetUserClassTypeId(userClassId) {
        var id = parseInt(userClassId, 10);
        if (id === UM_USER_CLASS.ESM || id === UM_USER_CLASS.SSECSI || id === UM_USER_CLASS.JE)
            return UM_USER_CLASS_TYPE.StationLevelUser;
        if (id === UM_USER_CLASS.ASTEDSTE || id === UM_USER_CLASS.SRDSTECONTROL)
            return UM_USER_CLASS_TYPE.DivisionLevelUser;
