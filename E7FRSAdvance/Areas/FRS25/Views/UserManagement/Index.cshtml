<script>
    (function () {
        var CDN_TIMEOUT = 8000;
        function loadScript(src, cb) {
            var done = false;
            function finish() { if (!done) { done = true; cb(); } }
            var s = document.createElement('script');
            s.src = src; s.onload = finish;
            s.onerror = function () { console.warn('Script failed (skipped): ' + src); finish(); };
            setTimeout(finish, CDN_TIMEOUT);
            document.head.appendChild(s);
        }
        function loadParallel(srcs, cb) {
            if (!srcs.length) { cb(); return; }
            var remaining = srcs.length;
            function done() { if (--remaining === 0) cb(); }
            srcs.forEach(function (src) { loadScript(src, done); });
        }
        function runInit() { if (typeof umInit === 'function') umInit(); }
        var afterJq = function () {
            var parallel = [];
            if (typeof bootstrap === 'undefined') parallel.push('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js');
            parallel.push('https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js');
            parallel.push('https://cdn.jsdelivr.net/npm/jquery.nicescroll@3.7.6/dist/jquery.nicescroll.min.js');
            loadParallel(parallel, runInit);
        };
        if (typeof jQuery !== 'undefined') { afterJq(); }
        else { loadScript('https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js', afterJq); }
    })();
</script>

