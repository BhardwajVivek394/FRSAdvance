            umBindEvents();

            // Safety net: force-hide overlay after 20s no matter what
            setTimeout(function () { umHideLoad(); }, 20000);

            // Fire immediately — don't wait for role check
            umLoadDashboardCounts();
            umLoadUserList();

            // Role check only controls filter dropdowns (non-blocking)
            umCheckDivisionalAdminRole(function () {
                umLoadDivisions('#umFltDiv', function () {
                    if (UM_IS_DIVISIONAL_ADMIN && UM_USER_DIVISION_ID > 0) {
                        umApplyDivisionalAdminFilterRestrictions();
                    } else {
                        umLoadAllSitesForFilter();
                    }
                });
            });
        });
    }

    // Function to check if current user is Divisional Admin and get their division info
    function umCheckDivisionalAdminRole(callback) {
          $.ajax({
            url: '@Url.Action("GetAllRoles", "UserManagement", new { Area = "FRS25" })',
            type: 'POST', contentType: 'application/json',
            timeout: 10000,
            success: function (data) {
                if (data && data.length > 0) {
                    $.each(data, function (i, r) {
                        // Check if current logged-in user's role is Divisional Admin
                        if (r.Id === UM_USER_ROLE_ID && r.Title && r.Title.toLowerCase().indexOf('divisional') !== -1 && r.Title.toLowerCase().indexOf('admin') !== -1) {
                            UM_IS_DIVISIONAL_ADMIN = true;
                        }
                    });
                }

                // If user is Divisional Admin, fetch their division info
                if (UM_IS_DIVISIONAL_ADMIN) {
                    umFetchLoggedInUserDivision(callback);
                } else {
                    if (typeof callback === 'function') callback();
                }
            },
            error: function () {
                if (typeof callback === 'function') callback();
            }
        });
    }

    // Function to fetch the logged-in user's division information
    function umFetchLoggedInUserDivision(callback) {
        $.ajax({
            url: '@Url.Action("GetLoggedInUserDivision", "UserManagement", new { Area = "FRS25" })',
            type: 'POST',
            contentType: 'application/json',
            timeout: 10000,
            data: JSON.stringify({ UserId: UM_USER_ID }),
            success: function (data) {
                if (data && data.IsSuccess && data.DivisionId > 0) {
                    UM_USER_DIVISION_ID = data.DivisionId;
                    UM_USER_DIVISION_NAME = data.DivisionName || ('Division ' + data.DivisionId);
                } else {
                    // If no division found, disable divisional admin mode
                    UM_IS_DIVISIONAL_ADMIN = false;
                }
                if (typeof callback === 'function') callback();
            },
            error: function () {
                // If API fails, disable divisional admin mode
                UM_IS_DIVISIONAL_ADMIN = false;
                if (typeof callback === 'function') callback();
            }
        });
    }

    // Apply filter restrictions for Divisional Admin
    function umApplyDivisionalAdminFilterRestrictions() {
        var $fltDiv = $('#umFltDiv');
        // Clear and set only the divisional admin's division
        $fltDiv.html('');
        $fltDiv.append('<option value="' + UM_USER_DIVISION_ID + '">' + (UM_USER_DIVISION_NAME || 'Division ' + UM_USER_DIVISION_ID) + '</option>');
        _umFltDivBusy = true;
        $fltDiv.val([String(UM_USER_DIVISION_ID)]).trigger('change.select2');
        $fltDiv.prop('disabled', true).trigger('change.select2');
        _umFltDivBusy = false;

        // Update search criteria to only show users from this division
        umSearch.DivisionIds = [UM_USER_DIVISION_ID];

        // Load sites only for this division in the filter
        umLoadSitesByDivision('#umFltSite', [UM_USER_DIVISION_ID]);
        umLoadFilterSectionsByDivision([UM_USER_DIVISION_ID]);
    }

    // Load sections for filter by division (for Divisional Admin)
    function umLoadFilterSectionsByDivision(divisionIds) {
        var $dd = $('#umFltSection').html('');
        var cleanIds = divisionIds.map(function(v) { return parseInt(v, 10); }).filter(function(v) { return !isNaN(v) && v > 0; });
        if (cleanIds.length === 0) { $dd.trigger('change.select2'); return; }
        $.ajax({
            url: '@Url.Action("GetSectionByDivisionId", "UserManagement", new { Area = "FRS25" })',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ SearchCriteria: { DivisionIds: cleanIds } }),
            success: function (data) {
                $dd.html('');
                if (data && data.length > 0) {
                    $dd.append('<option value="ALL">— Select All —</option>');
                    $.each(data, function (i, s) {
                        $dd.append('<option value="' + s.Id + '">' + (s.Name || s.SectionName || '--') + '</option>');
                    });
                }
                $dd.trigger('change.select2');
            },
            error: function () { $dd.html('').trigger('change.select2'); }
        });
    }

    function umHandleSelectAll(selectId, busyFlagName, prevValKey) {
        var $dd = $('#' + selectId);
        var currentVal = $dd.val() || [];
        var prevVal = $dd.data(prevValKey) || [];
        var allOptionIds = [];
        $('#' + selectId + ' option').each(function () { if ($(this).val() !== 'ALL') allOptionIds.push($(this).val()); });
        if (currentVal.indexOf('ALL') !== -1 && prevVal.indexOf('ALL') === -1) {
            window[busyFlagName] = true;
            $dd.val(allOptionIds).trigger('change.select2');
            window[busyFlagName] = false;
            $dd.data(prevValKey, allOptionIds);
            return allOptionIds;
        }
        if (currentVal.indexOf('ALL') === -1 && prevVal.indexOf('ALL') !== -1) {
            window[busyFlagName] = true;
            $dd.val(null).trigger('change.select2');
            window[busyFlagName] = false;
            $dd.data(prevValKey, []);
            return [];
        }
        var cleanVal = currentVal.filter(function(v) { return v !== 'ALL'; });
        $dd.data(prevValKey, currentVal);
        return cleanVal;
    }

