    function umLoadDashboardCounts() {
        $.ajax({
            url: '@Url.Action("GetFRSUserDashboardCount", "UserManagement", new { Area = "FRS25" })',
            type: 'POST', contentType: 'application/json',
            timeout: 10000,
            data: JSON.stringify({ UserId: @E7FRSAdvance.Utility.ClsHttpContent.LoginUser.Id }),
            success: function (r) {
                if (r && r.IsSuccess) {
                    if (r.ZoneId && r.ZoneId > 0) UM_ZONE_ID = r.ZoneId;
                    $('#headerZoneName').text(r.ZoneName || 'Railway Zone');
                    umAnimateCount('#statTotal', r.TotalUsers);
                    umAnimateCount('#statActive', r.ActiveUsers);
                    umAnimateCount('#statInactive', r.InActiveUsers);
                    umAnimateCount('#statDivisions', r.TotalDivisions);
                    umAnimateCount('#statSites', r.TotalStations || r.TotalSites || 0);
                } else { umSetStatsFallback(); }
            },
            error: function () { umSetStatsFallback(); }
        });
    }

    function umAnimateCount(sel, val) {
        var $el = $(sel); $el.text('0');
        if (val === 0) { $el.text('0').css('color', '#94a3b8'); return; }
        $({ c: 0 }).animate({ c: val }, { duration: 600, easing: 'swing', step: function () { $el.text(Math.floor(this.c)); }, complete: function () { $el.text(val).css('color', ''); } });
    }

    function umSetStatsFallback() {
        $('#statTotal,#statActive,#statInactive,#statDivisions,#statSites').text('--');
        $('#headerZoneName').text('Railway Zone');
    }

    function umLoadRoles(callback) {
    $.ajax({
        url: '@Url.Action("GetAllUserClassTypes", "UserManagement", new { Area = "FRS25" })',
        type: 'POST', contentType: 'application/json',
        success: function (data) {
            var $dd = $('#umDdlRole').html('<option value="">— Select User Type —</option>');
            var defaultId = '';
            if (data && data.length > 0) {
                $.each(data, function (i, r) {
                    $dd.append('<option value="' + r.Id + '">' + r.Name + '</option>');
                    if (r.Name && r.Name.toLowerCase() === 'user') defaultId = String(r.Id);
                    if (r.Id === UM_USER_ROLE_ID && r.Name && r.Name.toLowerCase().indexOf('divisional') !== -1 && r.Name.toLowerCase().indexOf('admin') !== -1) {
                        UM_IS_DIVISIONAL_ADMIN = true;
                    }
                });
            }
            if (defaultId && parseInt($('#umHdnUserId').val()) === 0) {
                $dd.val(defaultId).trigger('change.select2');
                $dd.data('prevRoleVal', defaultId);
            } else { $dd.trigger('change.select2'); }
            if (typeof callback === 'function') callback();
        },
        error: function () {
            var $dd = $('#umDdlRole').html('<option value="">— Select User Type —</option>');
            $dd.append('<option value="1">Admin</option><option value="2">User</option>');
            if (parseInt($('#umHdnUserId').val()) === 0) { $dd.val('2').trigger('change.select2'); $dd.data('prevRoleVal', '2'); }
            else { $dd.trigger('change.select2'); }
            if (typeof callback === 'function') callback();
        }
    });
}

