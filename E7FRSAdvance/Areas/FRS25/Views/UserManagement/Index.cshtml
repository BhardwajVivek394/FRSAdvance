    function umSaveUser() {

        var username = $('#umTxtUsername').val().trim(), mob = $('#umTxtMobile').val().trim(), firstName = $('#umTxtFirstName').val().trim();
        var dsg = $('#umTxtDesg').val().trim(), roleId = 2, userClassId = $('#umDdlUserClass').val();
        if (!username) { umToast('Enter username (employee code).', 'warning'); $('#umTxtUsername').focus(); return; }
        if (!mob || !/^\d{10}$/.test(mob)) { umToast('Enter valid 10-digit CUG mobile number.', 'warning'); $('#umTxtMobile').focus(); return; }
        if (!firstName) { umToast('Enter first name.', 'warning'); $('#umTxtFirstName').focus(); return; }
        var lastName = $('#umTxtLastName').val().trim();
        if (!lastName) { umToast('Enter last name.', 'warning'); $('#umTxtLastName').focus(); return; }
        var email = $('#umTxtEmail').val().trim();
        if (!email) { umToast('Enter email address.', 'warning'); $('#umTxtEmail').focus(); return; }
        if (!dsg) { umToast('Enter designation.', 'warning'); $('#umTxtDesg').focus(); return; }
        // Get device limits
        var maxDesktop = parseInt($('#umTxtMaxDesktop').val(), 10);
        var maxMobile = parseInt($('#umTxtMaxMobile').val(), 10);

        // Ensure valid numbers (default to 1 if NaN)
        if (isNaN(maxDesktop)) maxDesktop = 1;
        if (isNaN(maxMobile)) maxMobile = 1;
        if (!roleId) { umToast('Select a user type.', 'warning'); $('#umDdlRole').focus(); return; }
        if (!userClassId) { umToast('Select a user class.', 'warning'); $('#umDdlUserClass').focus(); return; }

        var selectedDivIds = ($('#umDdlDiv').val() || []).filter(function(v) { return v !== 'ALL'; });

        // For Divisional Admin: Division is already fixed, use the admin's division
        if (UM_IS_DIVISIONAL_ADMIN && UM_USER_DIVISION_ID > 0) {
            selectedDivIds = [String(UM_USER_DIVISION_ID)];
        }

        if (selectedDivIds.length === 0) { umToast('Select at least one division.', 'warning'); return; }
        var secDisabled = $('#umDdlSection').prop('disabled'), selectedSecIds = ($('#umDdlSection').val() || []).filter(function(v) { return v !== 'ALL'; });
        var siteDisabled = $('#umDdlSite').prop('disabled'), selectedSiteIds = ($('#umDdlSite').val() || []).filter(function(v) { return v !== 'ALL'; });

        // For Divisional Admin: Site selection is mandatory (User-Site mapping only)
        if (UM_IS_DIVISIONAL_ADMIN) {
            if (selectedSiteIds.length === 0) {
                umToast('Select at least one site for user mapping.', 'warning');
                return;
            }
        } else {
            if (!siteDisabled && !secDisabled && selectedSiteIds.length === 0) { umToast('Select at least one site.', 'warning'); return; }
        }
        var uid = parseInt($('#umHdnUserId').val()), isNew = uid === 0;
        if (isNew) { var pwd = $('#umTxtPwd').val(); if (!pwd || pwd.length < 6) { umToast('Password must be at least 6 characters.', 'warning'); $('#umTxtPwd').focus(); return; } if (pwd !== $('#umTxtCPwd').val()) { umToast('Passwords do not match.', 'warning'); $('#umTxtCPwd').focus(); return; } }
        var cleanDivIds = selectedDivIds.map(function(v) { return parseInt(v, 10); }).filter(function(v) { return !isNaN(v) && v > 0; });
        var cleanSecIds = secDisabled ? [] : selectedSecIds.map(function(v) { return parseInt(v, 10); }).filter(function(v) { return !isNaN(v) && v > 0; });
        var cleanSiteIds = siteDisabled ? [] : selectedSiteIds.map(function(v) { return parseInt(v, 10); }).filter(function(v) { return !isNaN(v) && v > 0; });
        umShowLoad(); $('#umBtnSave').prop('disabled', true);
        if (isNew) {
            var saveData = { Id: 0, UserName: username, FirstName: firstName, LastName: lastName, PhoneNumber: mob, EmailAddress: email, Password: $('#umTxtPwd').val() || '', Designation: dsg, MaxDesktopDevice: maxDesktop, MaxMobileDevice: maxMobile, Title: dsg, RoleId: parseInt(roleId, 10), UserClassId: parseInt(userClassId, 10), DivisionId: cleanDivIds.length > 0 ? cleanDivIds[0] : 0, DivisionIds: cleanDivIds, SiteId: cleanSiteIds.length > 0 ? cleanSiteIds[0] : 0, SiteIds: cleanSiteIds, IsActive: true, CreatedBy: @E7FRSAdvance.Utility.ClsHttpContent.LoginUser.Id, IsConfiguration: $('#umChkIsAdmin').is(':checked') };
            $.ajax({ url: '@Url.Action("SaveUser", "UserManagement", new { Area = "FRS25" })', type: 'POST', contentType: 'application/json; charset=utf-8', dataType: 'json', data: JSON.stringify(saveData),
                success: function (r) {
                    if (r && r.IsSuccess) {
                        var savedUserId = r.Id || r.UserId;
                        if (!savedUserId || savedUserId <= 0) { umHideLoad(); $('#umBtnSave').prop('disabled', false); umUserModal.hide(); umToast('User created but could not map divisions (no Id returned).', 'warning'); umLoadUserList(); umLoadDashboardCounts(); return; }
                        umSaveMappings(savedUserId, cleanDivIds, cleanSecIds, cleanSiteIds, true);
                    } else { umHideLoad(); $('#umBtnSave').prop('disabled', false); umToast((r && r.Message) || 'Failed to save user.', 'danger'); }
                },
                error: function (xhr) { umHideLoad(); $('#umBtnSave').prop('disabled', false); var msg = 'Error saving user.'; try { if (xhr.responseText) { var d = JSON.parse(xhr.responseText); if (d.Message) msg = d.Message; } } catch (e) {} umToast(msg, 'danger'); }
            });
        } else {
            var updateData = { Id: uid, UserName: username, FirstName: firstName, LastName: lastName, PhoneNumber: mob, EmailAddress: email, Designation: dsg, Title: dsg, RoleId: parseInt(roleId, 10), MaxDesktopDevice: maxDesktop, MaxMobileDevice: maxMobile, UserClassId: parseInt(userClassId, 10), DivisionId: cleanDivIds.length > 0 ? cleanDivIds[0] : 0, DivisionIds: cleanDivIds, SiteId: cleanSiteIds.length > 0 ? cleanSiteIds[0] : 0, SiteIds: cleanSiteIds, IsActive: true, CreatedBy: @E7FRSAdvance.Utility.ClsHttpContent.LoginUser.Id, IsConfiguration: $('#umChkIsAdmin').is(':checked') };
            $.ajax({ url: '@Url.Action("UpdateUser", "UserManagement", new { Area = "FRS25" })', type: 'POST', contentType: 'application/json; charset=utf-8', dataType: 'json', data: JSON.stringify(updateData),
                success: function (r) {
                    if (r && r.IsSuccess) {
                        umSaveMappings(uid, cleanDivIds, cleanSecIds, cleanSiteIds, false);
                    } else { umHideLoad(); $('#umBtnSave').prop('disabled', false); umToast((r && r.Message) || 'Failed to update user.', 'danger'); }
                },
                error: function (xhr) { umHideLoad(); $('#umBtnSave').prop('disabled', false); var msg = 'Error updating user.'; try { if (xhr.responseText) { var d = JSON.parse(xhr.responseText); if (d.Message) msg = d.Message; } } catch (e) {} umToast(msg, 'danger'); }
            });
        }
    }

    function umSaveMappings(userId, divIds, secIds, siteIds, isNew) {

        $.ajax({ url: '@Url.Action("SaveUserDivisionSiteMapping", "UserManagement", new { Area = "FRS25" })', type: 'POST', contentType: 'application/json; charset=utf-8', dataType: 'json', data: JSON.stringify({ UserId: userId, DivisionIds: divIds, SiteIds: siteIds }),
            success: function (mr) {
                $.ajax({ url: '@Url.Action("SaveUserSectionMapping", "UserManagement", new { Area = "FRS25" })', type: 'POST', contentType: 'application/json; charset=utf-8', dataType: 'json', data: JSON.stringify({ UserId: userId, SectionIds: secIds }), success: function () {}, error: function () {} });
                umHideLoad(); $('#umBtnSave').prop('disabled', false); umUserModal.hide();
                if (mr && mr.IsSuccess) { umToast(isNew ? 'User created & mapped successfully!' : 'User updated & mapped successfully!', 'success'); }
                else { umToast(isNew ? 'User created but mapping failed: ' + (mr.Message || '') : 'User updated but mapping failed: ' + (mr.Message || ''), 'warning'); }
                umLoadUserList(); umLoadDashboardCounts();
            },
            error: function () { umHideLoad(); $('#umBtnSave').prop('disabled', false); umUserModal.hide(); umToast(isNew ? 'User created but mapping request failed.' : 'User updated but mapping request failed.', 'warning'); umLoadUserList(); umLoadDashboardCounts(); }
        });
    }

    function umUpdateName(id, fn, ln, mob, uname, email) { $('#umHdnNameId').val(id); $('#umNameCUG').text(mob); $('#umTxtNewUsername').val(uname || ''); $('#umTxtNewFirstName').val(fn); $('#umTxtNewLastName').val(ln); $('#umTxtNewEmail').val(email || ''); umNameModal.show(); }
    function umConfirmName() {
        var username = $('#umTxtNewUsername').val().trim();
        var firstName = $('#umTxtNewFirstName').val().trim();
        var lastName = $('#umTxtNewLastName').val().trim();
        var email = $('#umTxtNewEmail').val().trim();
        if (!username) { umToast('Enter username (employee code).', 'warning'); $('#umTxtNewUsername').focus(); return; }
        if (!firstName) { umToast('Enter first name.', 'warning'); $('#umTxtNewFirstName').focus(); return; }
        if (!lastName) { umToast('Enter last name.', 'warning'); $('#umTxtNewLastName').focus(); return; }
        if (!email) { umToast('Enter email address.', 'warning'); $('#umTxtNewEmail').focus(); return; }
        umShowLoad();
        $.ajax({
            url: '@Url.Action("UpdateUserName","UserManagement",new{Area="FRS25"})',
            type: 'POST', contentType: 'application/json',
            data: JSON.stringify({ Id: parseInt($('#umHdnNameId').val()), UserName: username, FirstName: firstName, LastName: lastName, EmailAddress: email }),
            success: function (r) {
                umHideLoad();
                if (r && r.IsSuccess) { umNameModal.hide(); umToast('Holder updated successfully.', 'success'); umLoadUserList(); }
                else { umToast((r && r.Message) || 'Failed to update holder.', 'danger'); }
            },
            error: function () { umHideLoad(); umToast('Error updating holder.', 'danger'); }
        });
    }
    function umResetPwd(id, mob, name) { $('#umHdnResetId').val(id); $('#umResetInfo').text(mob + (name ? ' (' + name + ')' : '')); $('#umTxtNewPwd,#umTxtCNewPwd').val(''); umResetModal.show(); }
    function umConfirmReset() { var np = $('#umTxtNewPwd').val(), cp = $('#umTxtCNewPwd').val(); if (!np || np.length < 6) { umToast('Min 6 characters required.', 'warning'); return; } if (np !== cp) { umToast('Passwords do not match.', 'warning'); return; } umShowLoad(); $.ajax({ url: '@Url.Action("ResetPassword", "UserManagement", new { Area = "FRS25" })', type: 'POST', contentType: 'application/json', data: JSON.stringify({ Id: parseInt($('#umHdnResetId').val()), NewPassword: np, ConfirmPassword: cp }), success: function (r) { umHideLoad(); umResetModal.hide(); if (r && r.IsSuccess) { umToast('Password reset successfully.', 'success'); } else { umToast((r && r.Message) || 'Failed to reset password.', 'danger'); } }, error: function () { umHideLoad(); umToast('Error resetting password.', 'danger'); } }); }
    function umDelItem(id) { $('#umHdnDelId').val(id); umDelModal.show(); }
    function umConfirmDel() { umShowLoad(); $.ajax({ url: '@Url.Action("DeleteUser","UserManagement",new{Area="FRS25"})', type: 'POST', contentType: 'application/json', data: JSON.stringify({ Id: parseInt($('#umHdnDelId').val()) }), success: function () { umHideLoad(); umDelModal.hide(); umToast('User deleted.', 'success'); umLoadUserList(); umLoadDashboardCounts(); }, error: function () { umHideLoad(); umToast('Error deleting.', 'danger'); } }); }
    function umToggleSt(id, newSt) { umShowLoad(); $.ajax({ url: '@Url.Action("ToggleUserStatus","UserManagement",new{Area="FRS25"})', type: 'POST', contentType: 'application/json', data: JSON.stringify({ Id: id, IsActive: newSt }), success: function () { umHideLoad(); umToast('Status updated.', 'success'); umLoadUserList(); umLoadDashboardCounts(); }, error: function () { umHideLoad(); umToast('Error.', 'danger'); } }); }

    function umGetInit(n) { if (!n) return '?'; var p = n.trim().split(' '); return p.length >= 2 ? (p[0][0] + p[p.length - 1][0]).toUpperCase() : n.substring(0, 2).toUpperCase(); }
    function umTogglePwd(inp, icon) { var i = $('#' + inp), ic = $('#' + icon); if (i.attr('type') === 'password') { i.attr('type', 'text'); ic.removeClass('fa-eye').addClass('fa-eye-slash'); } else { i.attr('type', 'password'); ic.removeClass('fa-eye-slash').addClass('fa-eye'); } }
    function umCheckPwd(p) { var s = 0, b = $('#umPwdBar'), l = $('#umPwdLabel'); if (p.length >= 8) s++; if (/[a-z]/.test(p)) s++; if (/[A-Z]/.test(p)) s++; if (/[0-9]/.test(p)) s++; if (/[^a-zA-Z0-9]/.test(p)) s++; b.removeClass('weak fair good strong'); if (p.length === 0) { b.css('width', '0'); l.text(''); } else if (s <= 2) { b.addClass('weak'); l.text('Weak').css('color', '#dc2626'); } else if (s === 3) { b.addClass('fair'); l.text('Fair').css('color', '#ca8a04'); } else if (s === 4) { b.addClass('good'); l.text('Good').css('color', '#65a30d'); } else { b.addClass('strong'); l.text('Strong').css('color', '#16a34a'); } }
    function umGenPwd() { var c = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@@#$', p = ''; for (var i = 0; i < 10; i++) p += c.charAt(Math.floor(Math.random() * c.length)); $('#umTxtPwd').val(p); $('#umTxtCPwd').val(p); umCheckPwd(p); umToast('Password generated.', 'success'); }
    function umGenResetPwd() { var c = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@@#$', p = ''; for (var i = 0; i < 10; i++) p += c.charAt(Math.floor(Math.random() * c.length)); $('#umTxtNewPwd').val(p); $('#umTxtCNewPwd').val(p); umToast('Password generated.', 'success'); }
    function umShowLoad() { $('#umLoadingOverlay').addClass('show'); }
    function umHideLoad() { $('#umLoadingOverlay').removeClass('show'); }
    function umToast(msg, type) { var bg = type === 'success' ? 'bg-success' : type === 'warning' ? 'bg-warning' : 'bg-danger'; var icon = type === 'success' ? 'fa-check-circle' : type === 'warning' ? 'fa-exclamation-triangle' : 'fa-times-circle'; if (typeof CommonNotification === 'function') { CommonNotification(type.toUpperCase(), msg, type.charAt(0).toUpperCase() + type.slice(1)); return; } var h = '<div class="toast align-items-center text-white ' + bg + ' border-0" role="alert"><div class="d-flex"><div class="toast-body"><i class="fas ' + icon + ' me-2"></i>' + msg + '</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button></div></div>'; var $t = $(h); $('#umToastContainer').append($t); var t = new bootstrap.Toast($t[0], { autohide: true, delay: 3000 }); t.show(); $t.on('hidden.bs.toast', function () { $(this).remove(); }); }
</script>
