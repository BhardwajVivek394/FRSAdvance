                                else if (u.SiteId) { siteIdsToSelect = [String(u.SiteId)]; }
                                if (siteIdsToSelect.length > 0) { _umModalSiteBusy = true; $('#umDdlSite').val(siteIdsToSelect).trigger('change.select2'); _umModalSiteBusy = false; }
                                umUpdateJurisdiction();
                            });
                        });
                    } else {
                        umLoadModalAllSections();
                        umLoadModalAllSites(function () { if (u.SiteId) { _umModalSiteBusy = true; $('#umDdlSite').val([String(u.SiteId)]).trigger('change.select2'); _umModalSiteBusy = false; } umUpdateJurisdiction(); });
                    }
                });

                // For Divisional Admin: Update modal title
                if (UM_IS_DIVISIONAL_ADMIN) {
                    $('#umUserModalTitle').text('Edit User (Site Mapping)');
