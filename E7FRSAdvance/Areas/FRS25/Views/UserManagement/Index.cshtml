    function umShowLocDetail(userName, type, items) {
        var isDiv = type === 'division';
        var isSec = type === 'section';
        var label = isDiv ? 'Divisions' : (isSec ? 'Sections' : 'Sites');
        var icon = isDiv ? 'fa-building' : (isSec ? 'fa-th-large' : 'fa-map-pin');
        var color = '#64748b';
        var itemCls = isDiv ? 'div' : (isSec ? 'sec' : 'site');
        var title = (userName || 'User') + ' — ' + label;
        $('#umLocDetailTitle').text(title);
        var h = '<div class="loc-detail-header"><i class="fas ' + icon + '" style="color:' + color + ';"></i><h6>Assigned ' + label + '</h6><span class="loc-count">' + items.length + ' Total</span></div>';
        h += '<div class="loc-detail-list">';
        for (var i = 0; i < items.length; i++) {
            h += '<span class="loc-detail-item loc-detail-item-' + itemCls + '"><i class="fas ' + icon + '"></i> ' + $('<span>').text(items[i]).html() + '</span>';
        }
        h += '</div>';
        $('#umLocDetailBody').html(h);
        umLocDetailModal.show();
    }

    function umApplyRoleChange() {
        var pendingVal = $('#umDdlRole').data('pendingRoleVal');
        if (pendingVal) {
            $('#umDdlRole').data('prevRoleVal', pendingVal);
            $('#umDdlRole').val(pendingVal).trigger('change.select2');
        }
        umRoleConfirmModal.hide();
    }

    function umUpdateJurisdiction() {
        var $p = $('#umJurisdictionPanel'), divN = [], secN = [], siteN = [];
        $('#umDdlDiv option:selected').each(function () { if ($(this).val() !== 'ALL') divN.push($(this).text()); });
        if (!$('#umDdlSection').prop('disabled')) {
            $('#umDdlSection option:selected').each(function () { if ($(this).val() !== 'ALL') secN.push($(this).text()); });
        }
        if (!$('#umDdlSite').prop('disabled')) {
            $('#umDdlSite option:selected').each(function () { if ($(this).val() !== 'ALL') siteN.push($(this).text()); });
        }
        if (divN.length === 0 && secN.length === 0 && siteN.length === 0) {
            // For Divisional Admin: Show info about fixed division
            if (UM_IS_DIVISIONAL_ADMIN && UM_USER_DIVISION_NAME) {
                $p.html('<span class="text-muted"><i class="fas fa-lock me-1"></i>Division: <strong>' + UM_USER_DIVISION_NAME + '</strong> (Fixed) - Select sections and sites for user mapping</span>');
            } else {
                $p.html('<span class="text-muted"><i class="fas fa-info-circle me-1"></i>Select divisions, sections, and sites above to see jurisdiction</span>');
            }
            return;
        }
        var h = '';
        if (divN.length > 0) {
            h += '<div class="jur-division-row"><span class="jur-label"><i class="fas fa-building me-1" style="color:#64748b;"></i>Division(s):</span><div class="jur-badges">';
            for (var i = 0; i < divN.length; i++) {
                // For Divisional Admin: Show lock icon next to fixed division
                var lockIcon = (UM_IS_DIVISIONAL_ADMIN) ? '<i class="fas fa-lock me-1" style="font-size:.65rem;"></i>' : '';
                h += '<span class="jur-badge jur-badge-div">' + lockIcon + divN[i] + '</span>';
            }
            h += '</div></div>';
        }
        h += '<div class="jur-site-row"><span class="jur-label"><i class="fas fa-th-large me-1" style="color:#64748b;"></i>Section(s):</span><div class="jur-badges">';
        if ($('#umDdlSection').prop('disabled')) {
            h += '<span class="jur-badge jur-badge-all"><i class="fas fa-check-double me-1"></i>All Sections</span>';
        } else if (secN.length > 0) {
            for (var k = 0; k < secN.length; k++) h += '<span class="jur-badge" style="background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;">' + secN[k] + '</span>';
        } else {
            h += '<span class="text-muted" style="font-size:.78rem;">No sections selected yet</span>';
        }
        h += '</div></div>';
        h += '<div class="jur-site-row"><span class="jur-label"><i class="fas fa-map-pin me-1" style="color:#64748b;"></i>Site(s):</span><div class="jur-badges">';
        if ($('#umDdlSite').prop('disabled')) {
            h += '<span class="jur-badge jur-badge-all"><i class="fas fa-check-double me-1"></i>All Sites</span>';
        } else if (siteN.length > 0) {
            for (var j = 0; j < siteN.length; j++) h += '<span class="jur-badge jur-badge-site">' + siteN[j] + '</span>';
        } else {
            h += '<span class="text-muted" style="font-size:.78rem;">No sites selected yet</span>';
        }
        h += '</div></div>';
        $p.html(h);
    }

