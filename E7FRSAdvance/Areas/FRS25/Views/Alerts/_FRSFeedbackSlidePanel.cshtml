@* ═══════════════════════════════════════════════════════════════════════
    _FRSFeedbackSlidePanel.cshtml
    RDPMS Annexure-D style slide-in feedback panel.
    Include ONCE in the parent page (Index.cshtml) via:
        @Html.Partial("_FRSFeedbackSlidePanel")
    Place it AFTER @Html.Partial("_FRSAlertModals") and OUTSIDE
    #divAlertDetailReport so it survives AJAX reloads of _List.
   ═══════════════════════════════════════════════════════════════════════ *@

<!-- Backdrop -->
<div id="fbSlideBdrop" class="fb-slide-bdrop"></div>

<!-- Slide Panel -->
<div id="fbSlidePanel" class="fb-slide-panel">
    <!-- Header -->
    <div class="fb-panel-header">
        <div class="fb-panel-title-group">
            <h2 class="fb-panel-title">Provide Alert Feedback</h2>
        </div>
        <button class="fb-panel-close" onclick="closeFeedbackSlidePanel()">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <!-- Body -->
    <div class="fb-panel-body">
        <!-- Alert Summary Card -->
        <div class="fb-alert-summary">
            <div class="fb-summary-header">
                <div>
                    <div class="fb-alert-id" id="fbPanelAlertId">#—</div>
                    <div class="fb-alert-asset" id="fbPanelAssetName">—</div>
                </div>
                <span class="fb-alert-type" id="fbPanelAlertType">
                    <i class="fas fa-exclamation-circle"></i> —
                </span>
            </div>
            <div class="fb-summary-grid">
                <div class="fb-summary-item">
                    <span class="fb-summary-label">Station</span>
                    <span class="fb-summary-value" id="fbPanelStation">—</span>
                </div>
                <div class="fb-summary-item">
                    <span class="fb-summary-label">Division / Zone</span>
                    <span class="fb-summary-value" id="fbPanelDivZone">—</span>
                </div>
                <div class="fb-summary-item">
                    <span class="fb-summary-label">Cause Code</span>
                    <span class="fb-summary-value fb-mono" id="fbPanelCause">—</span>
                </div>
                <div class="fb-summary-item">
                    <span class="fb-summary-label">Incidence Time</span>
                    <span class="fb-summary-value" id="fbPanelIncTime">—</span>
                </div>
                <div class="fb-summary-item">
                    <span class="fb-summary-label">Duration</span>
                    <span class="fb-summary-value" id="fbPanelDuration" style="color:var(--e7-red, #ef4444);">—</span>
                </div>
            </div>
        </div>

        <!-- ═══ FULL FEEDBACK MODE ═══ -->
        <div id="fbFullMode" style="display:none;">
            <!-- Feedback type selection (PT / T / F / M) -->
            <div class="fb-section">
                <div class="fb-section-title">
                    <i class="fas fa-check-circle"></i>
                    Select Feedback Type <span class="fb-req">*</span>
                </div>
                <div class="fb-options" id="fbOptions">
                    <div class="fb-option fb-opt-pt" data-status="@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT.GetHashCode()" onclick="selectFbOption(this)">
                        <div class="fb-option-icon">PT</div>
                        <div class="fb-option-label">Partially True</div>
                        <div class="fb-option-desc">Failure occurred BUT cause differs</div>
                    </div>
                    <div class="fb-option fb-opt-t" data-status="@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True.GetHashCode()" onclick="selectFbOption(this)">
                        <div class="fb-option-icon">T</div>
                        <div class="fb-option-label">True</div>
                        <div class="fb-option-desc">Failure occurred AND cause matches</div>
                    </div>
                    <div class="fb-option fb-opt-f" data-status="@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False.GetHashCode()" onclick="selectFbOption(this)">
                        <div class="fb-option-icon">F</div>
                        <div class="fb-option-label">False</div>
                        <div class="fb-option-desc">No actual failure at site</div>
                    </div>
                    <div class="fb-option fb-opt-m" data-status="@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.Maintenace.GetHashCode()" onclick="selectFbOptionM(this)">
                        <div class="fb-option-icon">M</div>
                        <div class="fb-option-label">Maintenance</div>
                        <div class="fb-option-desc">Alert during maintenance</div>
                    </div>
                </div>
            </div>

            <!-- Cause Code dropdown (shown for PT) -->
            <div class="fb-section" id="fbDivRemarkAlertInfo" style="display:none;">
                <div class="fb-section-title">
                    <i class="fas fa-tag"></i>
                    Cause Code <span class="fb-req">*</span>
                </div>
                <select class="fb-form-select" id="fbDrpRemarkAlertInfo">
                    <option value="">Select</option>
                </select>
            </div>

            <!-- Rectification Date/Time -->
            <div class="fb-section">
                <div class="fb-section-title">
                    <i class="fas fa-calendar-check"></i>
                    Rectification Date &amp; Time
                </div>
                <input type="datetime-local" class="fb-form-input" id="fbTxtRectificationDateTime" />
            </div>

            <!-- Remark -->
            <div class="fb-section">
                <div class="fb-section-title">
                    <i class="fas fa-comment-alt"></i>
                    Remark <span class="fb-req">*</span>
                </div>
                <textarea class="fb-form-textarea" id="fbTxtAlertRemark" placeholder="Describe action taken, root cause analysis, observations..."></textarea>
            </div>

            <!-- Hidden fields -->
            <input type="hidden" id="fbHdnAlertRemarkId" />
            <input type="hidden" id="fbHdnAlertAlertStatusId" />
        </div>

        <!-- ═══ REMARK-ONLY MODE ═══ -->
        <div id="fbRemarkOnlyMode" style="display:none;">
            <div class="fb-section">
                <div class="fb-section-title">
                    <i class="fas fa-comment-alt"></i>
                    Remark <span class="fb-req">*</span>
                </div>
                <textarea class="fb-form-textarea" id="fbTxtAlertRemarkWithOutFeedback" placeholder="Enter your remark..."></textarea>
            </div>
            <input type="hidden" id="fbHdnAlertRemarkWithOutFeedbackId" />
            <input type="hidden" id="fbHdnAlertAlertStatusWithOutFeedbackId" />
        </div>
    </div>

    <!-- Footer -->
    <div class="fb-panel-footer">
        <button class="fb-btn-cancel" onclick="closeFeedbackSlidePanel()">Cancel</button>
        <button class="fb-btn-save" id="fbBtnSubmit" onclick="submitFeedbackSlidePanel()">
            <i class="fas fa-paper-plane"></i>
            Submit Feedback
        </button>
    </div>
</div>


@* ═══════════════════════════════════════════════════════════════
   SLIDE PANEL JAVASCRIPT
   ═══════════════════════════════════════════════════════════════ *@
<script>
/* ── Rectification Date & Time rule (every Alerts feedback / remark form):
      must be AFTER the Incidence Date & Time and can not be in the future.
      Shared by this panel, the _List slide panel and the remark modal. ── */
(function () {
    function pad(n) { return (n < 10 ? '0' : '') + n; }
    function toInputValue(d) {
        return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }
    function toDisplay(d) {
        return pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + '/' + d.getFullYear() + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
    }
    /* Incidence time as rendered ("dd/MM/yyyy HH:mm:ss"), MVC JSON ("/Date(ms)/"), epoch ms or ISO */
    window.e7ParseIncidence = function (v) {
        if (v === null || v === undefined || v === '') return null;
        if (v instanceof Date) return isNaN(v.getTime()) ? null : v;
        var s = String(v).trim(), m;
        if (/^\d+$/.test(s)) return new Date(+s);
        if ((m = /\/Date\((-?\d+)/.exec(s))) return new Date(+m[1]);
        if ((m = /^(\d{1,2})\/(\d{1,2})\/(\d{4})[ T](\d{1,2}):(\d{2})(?::(\d{2}))?/.exec(s)))
            return new Date(+m[3], +m[2] - 1, +m[1], +m[4], +m[5], +(m[6] || 0));
        var d = new Date(s);
        return isNaN(d.getTime()) ? null : d;
    };
    /* Remember the incidence on the input and bound its picker: min = first whole minute after it, max = now */
    window.e7SetRectLimits = function (input, incTime) {
        if (!input) return;
        var inc = window.e7ParseIncidence(incTime);
        input.setAttribute('data-inc', inc ? String(inc.getTime()) : '');
        if (inc) {
            var min = new Date(inc.getTime());
            min.setSeconds(0, 0);
            min.setMinutes(min.getMinutes() + 1);
            input.min = toInputValue(min);
        } else {
            input.removeAttribute('min');
        }
        input.max = toInputValue(new Date());
    };
    /* '' when valid (or left empty), otherwise the message to show */
    window.e7RectificationError = function (rectVal, incTime) {
        if (!rectVal) return '';
        var rd = new Date(rectVal);
        if (isNaN(rd.getTime())) return 'Please enter a valid Rectification Date & Time.';
        if (rd > new Date()) return 'Rectification Date & Time can not be a future date & time.';
        var inc = window.e7ParseIncidence(incTime);
        if (inc && rd <= inc) return 'Rectification Date & Time must be greater than the Incidence Date & Time (' + toDisplay(inc) + ').';
        return '';
    };
})();

(function () {
    var _fbMode = ''; // 'full' or 'remarkOnly'

    /* ───────────────── OPEN ───────────────── */
    var _fbViewOnly = false; // 616: T/PT/M/F disabled for this user / Alert Feedback Time over

    window.openFeedbackSlidePanel = function (alertId, mode, statusId, asset, station, cause, incTime, duration, typeLbl, division, zone, canGiveFeedback) {
        _fbMode = mode;
        _fbViewOnly = (mode === 'full' && canGiveFeedback === false);
        document.getElementById('fbBtnSubmit').style.display = _fbViewOnly ? 'none' : '';
        var optsLock = document.querySelectorAll('#fbOptions .fb-option');
        for (var j = 0; j < optsLock.length; j++) {
            optsLock[j].style.opacity = _fbViewOnly ? '.45' : '';
            optsLock[j].style.cursor = _fbViewOnly ? 'not-allowed' : '';
        }

        /* Populate summary */
        document.getElementById('fbPanelAlertId').textContent = '#' + alertId;
        document.getElementById('fbPanelAssetName').textContent = asset || '—';
        document.getElementById('fbPanelStation').textContent = station || '—';
        document.getElementById('fbPanelDivZone').textContent =
            ((division || '') + (division && zone ? ' / ' : '') + (zone || '')) || '—';
        document.getElementById('fbPanelCause').textContent = cause || '—';
        document.getElementById('fbPanelIncTime').textContent = incTime || '—';
        document.getElementById('fbPanelDuration').textContent = duration || '—';

        /* Type badge */
        var typeBadge = document.getElementById('fbPanelAlertType');
        var tl = (typeLbl || '').toLowerCase();
        var ico = tl.indexOf('predict') >= 0 ? 'chart-line' : tl.indexOf('health') >= 0 ? 'heartbeat' : 'exclamation-circle';
        var cls = tl.indexOf('predict') >= 0 ? 'predictive' : tl.indexOf('fail') >= 0 ? 'failure' : 'unknown';
        typeBadge.className = 'fb-alert-type ' + cls;
        typeBadge.innerHTML = '<i class="fas fa-' + ico + '"></i> ' + (typeLbl || '—');

        /* Toggle mode */
        if (mode === 'full') {
            document.getElementById('fbFullMode').style.display = 'block';
            document.getElementById('fbRemarkOnlyMode').style.display = 'none';
            document.getElementById('fbBtnSubmit').innerHTML = '<i class="fas fa-paper-plane"></i> Submit Feedback';

            /* Reset */
            var opts = document.querySelectorAll('#fbOptions .fb-option');
            for (var i = 0; i < opts.length; i++) opts[i].classList.remove('selected');
            document.getElementById('fbTxtAlertRemark').value = '';
            document.getElementById('fbTxtRectificationDateTime').value = '';
            window.e7SetRectLimits(document.getElementById('fbTxtRectificationDateTime'), incTime);
            document.getElementById('fbDivRemarkAlertInfo').style.display = 'none';
            document.getElementById('fbHdnAlertAlertStatusId').value = '';

            /* Pre-select if current status already set */
            if (statusId) {
                for (var i = 0; i < opts.length; i++) {
                    if (opts[i].getAttribute('data-status') === String(statusId)) {
                        opts[i].classList.add('selected');
                    }
                }
                document.getElementById('fbHdnAlertAlertStatusId').value = statusId;
            }

            /* Load alert data (remark, cause code list) */
            _loadAlertDataForPanel(alertId, statusId);
        } else {
            document.getElementById('fbFullMode').style.display = 'none';
            document.getElementById('fbRemarkOnlyMode').style.display = 'block';
            document.getElementById('fbBtnSubmit').innerHTML = '<i class="fas fa-paper-plane"></i> Submit Remark';
            document.getElementById('fbTxtAlertRemarkWithOutFeedback').value = '';
            document.getElementById('fbHdnAlertRemarkWithOutFeedbackId').value = alertId;
            document.getElementById('fbHdnAlertAlertStatusWithOutFeedbackId').value = statusId;
        }

        /* Slide open */
        document.getElementById('fbSlidePanel').classList.add('active');
        document.getElementById('fbSlideBdrop').classList.add('show');
    };

    /* ── Load alert detail for full mode ── */
    function _loadAlertDataForPanel(id, statusId) {
        $("#loader,#e7-loader").filter(':first').show();
        $.ajax({
            url: '/FRS25/Alerts/GetBy',
            type: 'POST',
            data: '{id:' + id + '}',
            contentType: 'application/json',
            success: function (data) {
                $("#loader,#e7-loader").hide();
                if (data != null && data.Id > 0) {
                    document.getElementById('fbHdnAlertRemarkId').value = id;
                    document.getElementById('fbTxtAlertRemark').value = data.Remark || '';
                    document.getElementById('fbHdnAlertAlertStatusId').value = statusId;
                }
                /* Populate cause code dropdown for PT */
                if (data.mAlertInfos != null && data.mAlertInfos.length > 0
                    && statusId == '@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT.GetHashCode()') {
                    document.getElementById('fbDivRemarkAlertInfo').style.display = 'block';
                    var drp = document.getElementById('fbDrpRemarkAlertInfo');
                    drp.innerHTML = '<option value="">Select</option>';
                    for (var i = 0; i < data.mAlertInfos.length; i++) {
                        var opt = document.createElement('option');
                        opt.value = data.mAlertInfos[i].Id;
                        opt.textContent = data.mAlertInfos[i].Name;
                        drp.appendChild(opt);
                    }
                } else {
                    document.getElementById('fbDrpRemarkAlertInfo').innerHTML = '';
                    document.getElementById('fbDivRemarkAlertInfo').style.display = 'none';
                }
            },
            error: function () {
                $("#loader,#e7-loader").hide();
                if (typeof CommonNotification === 'function')
                    CommonNotification("ERROR", "Something went wrong!", "Error");
            }
        });
    }

    /* ───────────────── FEEDBACK OPTION SELECT ───────────────── */
    window.selectFbOption = function (el) {
        if (_fbViewOnly) return;
        var opts = document.querySelectorAll('#fbOptions .fb-option');
        for (var i = 0; i < opts.length; i++) opts[i].classList.remove('selected');
        el.classList.add('selected');
        var statusId = el.getAttribute('data-status');
        document.getElementById('fbHdnAlertAlertStatusId').value = statusId;

        /* Show/hide cause code dropdown for PT */
        var ptId = '@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT.GetHashCode()';
        if (statusId === ptId) {
            document.getElementById('fbDivRemarkAlertInfo').style.display = 'block';
            /* Reload cause codes if not yet loaded */
            var drp = document.getElementById('fbDrpRemarkAlertInfo');
            if (drp.options.length <= 1) {
                var alertId = document.getElementById('fbHdnAlertRemarkId').value;
                _loadAlertDataForPanel(alertId, ptId);
            }
        } else {
            document.getElementById('fbDivRemarkAlertInfo').style.display = 'none';
        }
    };

    /* ── Maintenance — direct status update, no remark needed ── */
    window.selectFbOptionM = function (el) {
        if (_fbViewOnly) return;
        var alertId = document.getElementById('fbHdnAlertRemarkId').value;
        var statusId = el.getAttribute('data-status');
        closeFeedbackSlidePanel();
        if (typeof fnUpdateAckStatus === 'function') {
            fnUpdateAckStatus(alertId, statusId);
        }
    };

    /* ───────────────── SUBMIT ───────────────── */
    window.submitFeedbackSlidePanel = function () {
        var currentSkip = window._alertCurrentSkip || 0;

        if (_fbMode === 'full') {
            if (_fbViewOnly) return;
            var remarkVal = document.getElementById('fbTxtAlertRemark').value;
            if (!remarkVal) { showWarning('Remark is required.', 'Validation'); return; }

            var statusId = document.getElementById('fbHdnAlertAlertStatusId').value;
            if (!statusId) { showWarning('Please select a feedback type.', 'Validation'); return; }

            var mFRSAlert = {
                Id: document.getElementById('fbHdnAlertRemarkId').value,
                Remark: remarkVal,
                AcknowledgemenStatusId: statusId
            };

            var rectInput = document.getElementById('fbTxtRectificationDateTime');
            var rectVal = rectInput.value;
            if (rectVal) {
                var rectErr = window.e7RectificationError(rectVal, rectInput.getAttribute('data-inc'));
                if (rectErr) { showWarning(rectErr, 'Validation'); rectInput.focus(); return; }
                mFRSAlert.RectificationDateTime = new Date(rectVal).toISOString();
            }

            var ptId = '@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT.GetHashCode()';
            if (statusId === ptId) {
                mFRSAlert.PTAlertInfoId = document.getElementById('fbDrpRemarkAlertInfo').value;
                if (!mFRSAlert.PTAlertInfoId) { showWarning('Cause Code is required.', 'Validation'); return; }
            }

            $("#loader,#e7-loader").filter(':first').show();
            $.ajax({
                url: '/FRS25/Alerts/UpdateRemark',
                type: 'POST', contentType: 'application/json',
                data: JSON.stringify(mFRSAlert), dataType: 'json',
                success: function (data) {
                    $("#loader,#e7-loader").hide();
                    closeFeedbackSlidePanel();
                    _refreshList(currentSkip);
                    _showResult(data);
                },
                error: function () {
                    $("#loader,#e7-loader").hide();
                    closeFeedbackSlidePanel();
                    showError('Something went wrong! Please try again.', 'Error');
                }
            });

        } else {
            /* remarkOnly mode */
            var remarkVal = document.getElementById('fbTxtAlertRemarkWithOutFeedback').value;
            if (!remarkVal) { showWarning('Remark is required.', 'Validation'); return; }

            var mFRSAlert = {
                Id: document.getElementById('fbHdnAlertRemarkWithOutFeedbackId').value,
                Remark: remarkVal,
                AcknowledgemenStatusId: document.getElementById('fbHdnAlertAlertStatusWithOutFeedbackId').value
            };

            $("#loader,#e7-loader").filter(':first').show();
            $.ajax({
                url: '/FRS25/Alerts/UpdateRemark',
                type: 'POST', contentType: 'application/json',
                data: JSON.stringify(mFRSAlert), dataType: 'json',
                success: function (data) {
                    $("#loader,#e7-loader").hide();
                    closeFeedbackSlidePanel();
                    _refreshList(currentSkip);
                    _showResult(data);
                },
                error: function () {
                    $("#loader,#e7-loader").hide();
                    closeFeedbackSlidePanel();
                    showError('Something went wrong! Please try again.', 'Error');
                }
            });
        }
    };

    /* ───────────────── CLOSE ───────────────── */
    window.closeFeedbackSlidePanel = function () {
        document.getElementById('fbSlidePanel').classList.remove('active');
        document.getElementById('fbSlideBdrop').classList.remove('show');
    };
    document.getElementById('fbSlideBdrop').addEventListener('click', closeFeedbackSlidePanel);

    /* ── Helpers ── */
    function _refreshList(skip) {
        if (typeof fnGetAlertDetailReport === 'function') fnGetAlertDetailReport(skip);
        else if (typeof fnGetAlertList === 'function') fnGetAlertList(skip);
        else location.reload();
    }
    function _showResult(data) {
        if (data == null) return;
        var msg = data.result || '';
        if (typeof CommonNotification === 'function') {
            if (data.type === 'success') CommonNotification("SUCCESS", msg, "success");
            else if (data.type === 'error') CommonNotification("ERROR", msg, "error");
        }
    }
})();
</script>


@* ═══════════════════════════════════════════════════════════════
   SLIDE PANEL CSS
   ═══════════════════════════════════════════════════════════════ *@
<style>
/* ── Feedback display badge (in _List table) ──
   Energy7 theme: --frs-* status tokens come from _FRSAlertModals.cshtml
   (included just before this partial); --e7-* from e7-energy7-theme.css. */
.feedback-display-wrap { display:flex; flex-direction:column; align-items:center; gap:6px; }
.alrt-fb-badge {
    display:inline-flex; align-items:center; justify-content:center;
    min-width:32px; padding:4px 10px; border-radius:8px;
    font-size:12px; font-weight:700; letter-spacing:.04em;
}
.alrt-fb-badge.fb-true   { background:var(--frs-t-bg);  color:var(--frs-t-fg);  border:1px solid var(--frs-t-bd); }
.alrt-fb-badge.fb-partial{ background:var(--frs-pt-bg); color:var(--frs-pt-fg); border:1px solid var(--frs-pt-bd); }
.alrt-fb-badge.fb-false  { background:var(--frs-f-bg);  color:var(--frs-f-fg);  border:1px solid var(--frs-f-bd); }
.alrt-fb-badge.fb-maint  { background:var(--frs-m-bg);  color:var(--frs-m-fg);  border:1px solid var(--frs-m-bd); }
.alrt-fb-badge.fb-none   { background:var(--e7-surface-2); color:var(--e7-text-3); border:1px solid var(--e7-border); }
.alrt-fb-remark-link {
    font-size:11px; color:var(--e7-accent-ink); cursor:pointer; transition:color .18s;
}
.alrt-fb-remark-link:hover { color:var(--e7-accent); text-decoration:underline; }

/* ── Feedback action button (accent, in Actions column) ── */
.alrt-act-btn.alrt-act-feedback {
    background:linear-gradient(120deg,var(--e7-ask-from),var(--e7-ask-to)) !important;
    color:#fff !important; border-color:transparent !important;
    box-shadow:var(--e7-shadow-soft);
}
.alrt-act-btn.alrt-act-feedback:hover {
    background:linear-gradient(120deg,var(--e7-ask-from),var(--e7-ask-to)) !important;
    filter:brightness(1.05);
    box-shadow:var(--e7-shadow-hover); transform:translateY(-1px);
}

/* ══════════════════════════════════════════════
   SLIDE PANEL SHELL
   ══════════════════════════════════════════════ */
.fb-slide-bdrop {
    position:fixed; inset:0; background:var(--frs-backdrop, rgba(0,0,0,.55));
    backdrop-filter:blur(3px); -webkit-backdrop-filter:blur(3px);
    z-index:1065; opacity:0; pointer-events:none; transition:opacity .3s;
}
.fb-slide-bdrop.show { opacity:1; pointer-events:auto; }

.fb-slide-panel {
    position:fixed; top:0; right:-560px;
    width:540px; max-width:100vw; height:100vh;
    background:var(--e7-surface);
    color:var(--e7-text);
    z-index:1070; transition:right .4s cubic-bezier(.22,1,.36,1);
    display:flex; flex-direction:column;
    box-shadow:var(--e7-shadow-pop);
    border-left:1px solid var(--e7-border);
}
.fb-slide-panel.active { right:0; }

/* Top gradient bar */
.fb-slide-panel::before {
    content:""; display:block; position:absolute; top:0; left:0; right:0;
    height:3px; z-index:2;
    background:linear-gradient(90deg,var(--e7-rail-from) 0%,var(--e7-rail-mid) 50%,var(--e7-rail-to) 100%);
    box-shadow:none;
}

/* ── Header ── */
.fb-panel-header {
    flex-shrink:0; padding:22px 24px 18px;
    background:var(--e7-surface);
    border-bottom:1px solid var(--e7-border);
    display:flex; justify-content:space-between; align-items:flex-start;
    margin-top:3px;
}
.fb-panel-title-group { display:flex; flex-direction:column; gap:4px; }
.fb-panel-title { font-size:17px; font-weight:700; color:var(--e7-heading); margin:0; letter-spacing:-.025em; }
.fb-panel-subtitle { font-size:13px; color:var(--e7-text-3); margin:0; }
.fb-panel-close {
    width:34px; height:34px; border-radius:8px;
    background:var(--e7-surface-2); border:1px solid var(--e7-border-2);
    color:var(--e7-text-3); font-size:14px; cursor:pointer;
