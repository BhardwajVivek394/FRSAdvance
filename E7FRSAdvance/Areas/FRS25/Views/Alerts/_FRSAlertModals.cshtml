@* ═══════════════════════════════════════════════════════════════
    FRS ALERT MODALS
    Include once: @Html.Partial("_FRSAlertModals")
    Requires: Bootstrap 4 modal JS + FontAwesome
    ═══════════════════════════════════════════════════════════════ *@

<style>
    /* =================================================================
       Alert popups — themed with the Energy7 tokens (e7-energy7-theme.css)
       Light / dark follow html[data-aurora]. The --frs-* status tokens
       below are shared by the feedback panel, the side drawer and the
       remarks-history partial (_List.cshtml / _FRSRemark.cshtml).
       ================================================================= */
    :root,
    html[data-aurora="light"] {
        --frs-pt-fg: #b45309; --frs-pt-bg: rgba(245,158,11,.12); --frs-pt-bd: rgba(180,83,9,.30);   --frs-pt-dot: #f59e0b;
        --frs-t-fg:  #047857; --frs-t-bg:  rgba(16,185,129,.12); --frs-t-bd:  rgba(4,120,87,.28);   --frs-t-dot:  #10b981;
        --frs-f-fg:  #b91c1c; --frs-f-bg:  rgba(239,68,68,.10);  --frs-f-bd:  rgba(185,28,28,.28);  --frs-f-dot:  #ef4444;
        --frs-m-fg:  #6d28d9; --frs-m-bg:  rgba(139,92,246,.12); --frs-m-bd:  rgba(109,40,217,.28); --frs-m-dot:  #8b5cf6;
        --frs-req: #d1394f;
        --frs-backdrop: rgba(20,44,74,.35);
        --frs-btn-grad: linear-gradient(135deg, var(--e7-rail-from, #54c9c8), var(--e7-rail-to, #5ba0e2));
    }

    html[data-aurora="dark"],
    html:not([data-aurora="light"]) {
        --frs-pt-fg: #fcd34d; --frs-pt-bg: rgba(245,158,11,.16); --frs-pt-bd: rgba(252,211,77,.40);  --frs-pt-dot: #fbbf24;
        --frs-t-fg:  #6ee7b7; --frs-t-bg:  rgba(16,185,129,.16); --frs-t-bd:  rgba(110,231,183,.40); --frs-t-dot:  #34d399;
        --frs-f-fg:  #fca5a5; --frs-f-bg:  rgba(239,68,68,.16);  --frs-f-bd:  rgba(252,165,165,.40); --frs-f-dot:  #f87171;
        --frs-m-fg:  #c4b5fd; --frs-m-bg:  rgba(139,92,246,.18); --frs-m-bd:  rgba(196,181,253,.40); --frs-m-dot:  #a78bfa;
        --frs-req: #ff7a90;
        --frs-backdrop: rgba(0,0,0,.55);
    }

    .frs-modal .modal-content {
        border: 1px solid var(--e7-border, #e7ebf1);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: var(--e7-shadow-pop, 0 18px 40px rgba(20,44,74,.14));
        background: var(--e7-surface, #fff);
    }

    .frs-modal .modal-header {
        background: var(--e7-surface-2, #f6f8fa);
        color: var(--e7-heading, #1b3c55);
        padding: 13px 20px;
        border-bottom: 1px solid var(--e7-border, #e7ebf1);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .frs-modal .modal-title {
        font-size: 13.5px;
        font-weight: 600;
        color: var(--e7-heading, #1b3c55);
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }

        .frs-modal .modal-title i {
            font-size: 13px;
            color: var(--e7-accent, #2f9ec4);
        }

    .frs-modal .btn-close-frs {
        background: none;
        border: none;
        color: var(--e7-text-3, #627186);
        font-size: 16px;
        cursor: pointer;
        padding: 2px 6px;
        border-radius: 6px;
        transition: background .15s, color .15s;
        line-height: 1;
    }

        .frs-modal .btn-close-frs:hover {
            background: var(--frs-f-bg);
            color: var(--frs-f-fg);
        }

    .frs-modal .modal-body {
        padding: 20px 22px 16px;
        background: var(--e7-surface, #fff);
        color: var(--e7-text, #22303f);
    }

    .frs-modal .modal-footer {
        padding: 11px 22px;
        background: var(--e7-surface-2, #f6f8fa);
        border-top: 1px solid var(--e7-border, #e7ebf1);
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .frs-modal .frs-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        color: var(--e7-text-2, #55657a);
        text-transform: uppercase;
        letter-spacing: .07em;
        margin-bottom: 6px;
    }

        .frs-modal .frs-label .req {
            color: var(--frs-req);
            margin-left: 2px;
        }

    .frs-modal .frs-input,
    .frs-modal .frs-select,
    .frs-modal .frs-textarea {
        width: 100%;
        background: var(--e7-surface, #fff);
        border: 1px solid var(--e7-border-2, #dde3ec);
        border-radius: 8px;
        padding: 9px 12px;
        font-size: 13px;
        color: var(--e7-text, #22303f);
        outline: none;
        box-sizing: border-box;
        transition: border-color .15s, box-shadow .15s;
        font-family: inherit;
    }

    html:not([data-aurora="light"]) .frs-modal .frs-input,
    html:not([data-aurora="light"]) .frs-modal .frs-select,
    html:not([data-aurora="light"]) .frs-modal .frs-textarea { color-scheme: dark; }

        .frs-modal .frs-input::placeholder,
        .frs-modal .frs-textarea::placeholder {
            color: var(--e7-text-3, #627186);
        }

        .frs-modal .frs-input:focus,
        .frs-modal .frs-select:focus,
        .frs-modal .frs-textarea:focus {
            border-color: var(--e7-accent, #2f9ec4);
            box-shadow: 0 0 0 3px var(--e7-accent-soft, rgba(47,158,196,.12));
        }

        .frs-modal .frs-select option {
            background: var(--e7-surface, #fff);
            color: var(--e7-text, #22303f);
        }

    .frs-modal .frs-textarea {
        resize: vertical;
        min-height: 90px;
    }

    .frs-modal .frs-field {
        margin-bottom: 14px;
    }

        .frs-modal .frs-field:last-child {
            margin-bottom: 0;
        }
    /* pill legend strip */
    .frs-pills-strip {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        margin-bottom: 16px;
        padding: 10px 12px;
        background: var(--e7-surface-2, #f6f8fa);
        border: 1px solid var(--e7-border, #e7ebf1);
        border-radius: 10px;
    }

    .frs-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 700;
        white-space: nowrap;
    }

        .frs-pill .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
        }

    .frs-pill-pt { background: var(--frs-pt-bg); color: var(--frs-pt-fg); border: 1px solid var(--frs-pt-bd); }
    .frs-pill-pt .dot { background: var(--frs-pt-dot); }
    .frs-pill-t  { background: var(--frs-t-bg);  color: var(--frs-t-fg);  border: 1px solid var(--frs-t-bd); }
    .frs-pill-t .dot  { background: var(--frs-t-dot); }
    .frs-pill-f  { background: var(--frs-f-bg);  color: var(--frs-f-fg);  border: 1px solid var(--frs-f-bd); }
    .frs-pill-f .dot  { background: var(--frs-f-dot); }
    .frs-pill-m  { background: var(--frs-m-bg);  color: var(--frs-m-fg);  border: 1px solid var(--frs-m-bd); }
    .frs-pill-m .dot  { background: var(--frs-m-dot); }

    /* buttons */
    .frs-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 18px;
        border-radius: 8px;
        font-size: 12.5px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: opacity .15s, transform .1s, background .15s, color .15s;
        font-family: inherit;
    }

        .frs-btn:active {
            transform: scale(.97);
        }

    .frs-btn-cancel {
        background: var(--e7-surface, #fff);
        color: var(--e7-text-2, #55657a);
        border: 1px solid var(--e7-border-2, #dde3ec);
    }

        .frs-btn-cancel:hover {
            background: var(--e7-surface-3, #eef2f6);
            color: var(--e7-text, #22303f);
        }

    .frs-btn-save {
        background: var(--frs-btn-grad);
        color: #fff;
    }

        .frs-btn-save:hover {
            opacity: .9;
        }

    /* ── MODAL 3b: scope image modal to content area; no sidebar/panel bleed ── */
    #modalRemarkImage.modal {
        left: 230px;
        right: 340px;
        width: auto;
    }

    /* scoped dim — pseudo-element replaces Bootstrap backdrop for this modal */
    #modalRemarkImage.modal.show::before {
        content: '';
        position: fixed;
        top: 0; bottom: 0;
        left: 230px;
        right: 340px;
        background: var(--frs-backdrop);
        z-index: -1;
    }

    /* history panel stays above image modal */
    #modalFRSAlertRemark {
        z-index: 1065 !important;
    }

    /* hide Bootstrap's full-screen backdrop when image modal is open */
    body.frs-image-modal-open > .modal-backdrop {
        display: none !important;
    }

    /* ── MODAL 3: history legend strip ── */
    .frs-history-legend {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        padding: 10px 20px;
        background: var(--e7-surface-2, #f6f8fa);
        border-bottom: 1px solid var(--e7-border, #e7ebf1);
    }

    /* ── MODAL 3: scrollable history body ── */
    .frs-history-body {
        max-height: 460px;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 16px 18px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        /* hide scrollbar track until hovered */
        scrollbar-width: thin;
        scrollbar-color: transparent transparent;
        transition: scrollbar-color .2s;
    }

        .frs-history-body:hover {
            scrollbar-color: var(--e7-border-2, #dde3ec) transparent;
        }

        .frs-history-body::-webkit-scrollbar { width: 4px; }
        .frs-history-body::-webkit-scrollbar-track { background: transparent; }
        .frs-history-body::-webkit-scrollbar-thumb {
            background: transparent;
            border-radius: 4px;
            transition: background .2s;
        }
        .frs-history-body:hover::-webkit-scrollbar-thumb { background: var(--e7-border-2, #dde3ec); }

    .frs-history-loading {
        text-align: center;
        padding: 40px 20px;
        color: var(--e7-text-3, #627186);
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

        .frs-history-loading i { font-size: 18px; color: var(--e7-accent, #2f9ec4); }

    /* ── MODAL 3: remark card — image-first layout ── */
    .frs-remark-card {
        background: var(--e7-surface, #fff);
        border: 1px solid var(--e7-border, #e7ebf1);
        border-radius: 12px;
        overflow: hidden;
        transition: border-color .18s, box-shadow .18s;
        display: flex;
        flex-direction: column;
    }

        .frs-remark-card:hover {
            border-color: var(--e7-border-2, #dde3ec);
            box-shadow: var(--e7-shadow-hover, 0 10px 24px rgba(20,44,74,.12));
        }

    /* top bar: seq + pill + meta */
    .frs-remark-card-head {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 10px 14px;
        background: var(--e7-surface-2, #f6f8fa);
        border-bottom: 1px solid var(--e7-border, #e7ebf1);
    }

    .frs-remark-seq {
        width: 20px; height: 20px;
        background: var(--e7-surface-3, #eef2f6);
        border: 1px solid var(--e7-border-2, #dde3ec);
        border-radius: 50%;
        font-size: 9.5px;
        font-weight: 700;
        color: var(--e7-text-2, #55657a);
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }

    .frs-remark-card-head .frs-pill { font-size: 10px; padding: 2px 8px; }

    .frs-remark-card-head-right {
        margin-left: auto;
        display: flex; align-items: center; gap: 12px;
    }

    .frs-remark-meta {
        display: flex; align-items: center; gap: 4px;
        font-size: 10.5px; color: var(--e7-text-3, #627186); white-space: nowrap;
    }
        .frs-remark-meta i { font-size: 10px; color: var(--e7-text-3, #627186); }
        .frs-remark-meta strong { color: var(--e7-text-2, #55657a); font-weight: 600; }

    /* main row: image panel on left, content on right */
    .frs-remark-card-main {
        display: flex;
        gap: 0;
    }

    /* ── image panel ── */
    .frs-remark-img-col {
        flex-shrink: 0;
        width: 110px;
        min-height: 90px;
        background: var(--e7-surface-3, #eef2f6);
        border-right: 1px solid var(--e7-border, #e7ebf1);
        display: flex;
        flex-direction: column;
        align-items: stretch;
        justify-content: stretch;
        position: relative;
        cursor: pointer;
        overflow: hidden;
        transition: width .22s cubic-bezier(.4,0,.2,1);
    }

        .frs-remark-img-col:hover:not(.no-image) { width: 130px; }

        .frs-remark-img-col.no-image {
            cursor: default;
            width: 80px;
        }

    /* full-bleed background preview */
    .frs-remark-img-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        filter: blur(6px) brightness(.45);
        transform: scale(1.08);
        transition: filter .25s, transform .25s;
    }

        .frs-remark-img-col:hover:not(.no-image) .frs-remark-img-bg {
            filter: blur(3px) brightness(.55);
            transform: scale(1.12);
        }

    /* sharp thumbnail on top of blurred bg */
    .frs-remark-img-thumb {
        position: relative;
        z-index: 1;
        margin: 10px auto 0;
        width: 76px;
        height: 60px;
        border-radius: 8px;
        overflow: hidden;
        border: 1.5px solid var(--e7-border-2, #dde3ec);
        box-shadow: var(--e7-shadow-soft, 0 1px 2px rgba(20,44,74,.05));
        transition: transform .22s, border-color .22s, box-shadow .22s;
        flex-shrink: 0;
    }

        .frs-remark-img-col:hover:not(.no-image) .frs-remark-img-thumb {
            transform: translateY(-2px) scale(1.05);
            border-color: var(--e7-accent, #2f9ec4);
            box-shadow: 0 0 0 3px var(--e7-accent-soft, rgba(47,158,196,.12));
        }

    .frs-remark-img-thumb img {
        width: 100%; height: 100%;
        object-fit: cover;
        display: block;
    }

    /* placeholder when no real thumb */
    .frs-remark-img-thumb-icon {
        width: 100%; height: 100%;
        display: flex; align-items: center; justify-content: center;
        background: var(--e7-surface-2, #f6f8fa);
        font-size: 22px;
        color: var(--e7-text-4, #b3bdc9);
    }

    /* VIEW label + icon below thumb */
    .frs-remark-img-badge {
        position: relative;
        z-index: 1;
        margin: 6px auto 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        background: var(--e7-accent-soft, rgba(47,158,196,.12));
        border: 1px solid var(--e7-accent-soft, rgba(47,158,196,.12));
        border-radius: 20px;
        padding: 3px 10px;
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: .05em;
        color: var(--e7-accent-ink, #1d6f8d);
        text-transform: uppercase;
        transition: background .2s, border-color .2s, color .2s;
        white-space: nowrap;
    }

        .frs-remark-img-col:hover:not(.no-image) .frs-remark-img-badge {
            border-color: var(--e7-accent, #2f9ec4);
        }

    /* ripple effect on click */
    .frs-remark-img-col .frs-ripple {
        position: absolute;
        border-radius: 50%;
        background: var(--e7-accent-soft, rgba(47,158,196,.12));
        transform: scale(0);
        animation: frsRipple .5s linear;
        pointer-events: none;
        z-index: 10;
    }

    @@keyframes frsRipple {
        to { transform: scale(4); opacity: 0; }
    }

    /* no-image state */
    .frs-remark-img-col.no-image .frs-remark-img-thumb {
        border-color: var(--e7-border, #e7ebf1);
        opacity: .5;
    }

    .frs-remark-img-col.no-image .frs-remark-img-badge {
        color: var(--e7-text-3, #627186);
        border-color: var(--e7-border, #e7ebf1);
        background: transparent;
    }

    /* content column */
    .frs-remark-content-col {
        flex: 1;
        padding: 12px 14px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
    }

    .frs-remark-cause {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 10px;
        font-weight: 700;
        color: var(--e7-accent-ink, #1d6f8d);
        background: var(--e7-accent-soft, rgba(47,158,196,.12));
        border: 1px solid var(--e7-accent-soft, rgba(47,158,196,.12));
        border-radius: 6px;
        padding: 2px 8px;
        width: fit-content;
    }

    .frs-remark-text {
        font-size: 12.5px;
        color: var(--e7-text, #22303f);
        line-height: 1.6;
        word-break: break-word;
        margin: 0;
    }

    .frs-remark-card-foot {
        padding: 7px 14px;
        background: var(--e7-surface-2, #f6f8fa);
        border-top: 1px solid var(--e7-border, #e7ebf1);
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .frs-remark-foot-item {
        display: flex; align-items: center; gap: 4px;
        font-size: 10.5px; color: var(--e7-text-3, #627186);
    }
        .frs-remark-foot-item i { font-size: 10px; }
        .frs-remark-foot-item span { color: var(--e7-text-2, #55657a); }

    /* ── MODAL 3: remarks history table (legacy fallback) ── */
    .frs-remark-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12.5px;
    }

        .frs-remark-table thead tr {
            background: var(--e7-surface-2, #f6f8fa);
        }

        .frs-remark-table thead th {
            padding: 8px 12px;
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: var(--e7-text-2, #55657a);
            border-bottom: 1px solid var(--e7-border, #e7ebf1);
            white-space: nowrap;
        }

        .frs-remark-table tbody tr {
            border-bottom: 1px solid var(--e7-border, #e7ebf1);
            transition: background .12s;
        }

        .frs-remark-table tbody tr:last-child {
            border-bottom: none;
        }

        .frs-remark-table tbody tr:hover {
            background: var(--e7-surface-2, #f6f8fa);
        }

        .frs-remark-table td {
            padding: 10px 12px;
            color: var(--e7-text, #22303f);
            vertical-align: middle;
        }

        .frs-remark-table .td-date {
            font-weight: 600;
            color: var(--e7-text, #22303f);
            white-space: nowrap;
        }

        .frs-remark-table .td-time {
            font-weight: 600;
            color: var(--e7-text, #22303f);
            white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }

        .frs-remark-table .td-img {
            text-align: center;
        }

    .frs-img-thumb-btn {
        background: var(--e7-accent-soft, rgba(47,158,196,.12));
        border: 1px solid var(--e7-accent-soft, rgba(47,158,196,.12));
        border-radius: 7px;
        color: var(--e7-accent-ink, #1d6f8d);
        font-size: 15px;
        width: 30px;
        height: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background .15s, border-color .15s, transform .1s;
        padding: 0;
    }

        .frs-img-thumb-btn:hover {
            border-color: var(--e7-accent, #2f9ec4);
            transform: scale(1.08);
        }

    /* ── MODAL 3b: image viewer zoom ── */
    .frs-img-viewer-wrap {
        position: relative;
        background: var(--e7-surface-3, #eef2f6);
        border-radius: 8px;
        overflow: hidden;
        line-height: 0;
        user-select: none;
        cursor: zoom-in;
    }

        .frs-img-viewer-wrap.is-zoomed {
            cursor: grab;
        }

        .frs-img-viewer-wrap.is-dragging {
            cursor: grabbing;
        }

    #remarkImageEl {
        display: block;
        width: 100%;
        max-width: 100%;
        max-height: 580px;
        object-fit: contain;
        border-radius: 8px;
        border: 1px solid var(--e7-border, #e7ebf1);
        transform-origin: center center;
        transition: transform .2s ease;
        pointer-events: none;
    }

    .frs-zoom-controls {
        position: absolute;
        bottom: 10px;
        right: 10px;
        display: flex;
        align-items: center;
        gap: 4px;
        background: var(--e7-surface, #fff);
        border: 1px solid var(--e7-border, #e7ebf1);
        box-shadow: var(--e7-shadow-card, 0 6px 16px rgba(20,44,74,.045));
        border-radius: 8px;
        padding: 4px 6px;
    }

    .frs-zoom-btn {
        background: var(--e7-surface-2, #f6f8fa);
        border: 1px solid var(--e7-border-2, #dde3ec);
        border-radius: 5px;
