@* ══════════════════════════════════════
    IMAGE ZOOM JS — for Modal 3b
    ══════════════════════════════════════ *@
<script>
    (function () {
        var _scale = 1, _panX = 0, _panY = 0, _dragging = false, _lx = 0, _ly = 0;

        function _apply() {
            var img = document.getElementById('remarkImageEl');
            if (!img) return;
            img.style.transform = 'scale(' + _scale + ') translate(' + (_panX / _scale) + 'px, ' + (_panY / _scale) + 'px)';
            var lvl = document.getElementById('frsZoomLevel');
            if (lvl) lvl.textContent = Math.round(_scale * 100) + '%';
            var wrap = document.getElementById('frsImgViewerWrap');
            if (wrap) wrap.classList.toggle('is-zoomed', _scale > 1);
        }

        window.frsZoomIn = function () { _scale = Math.min(_scale + 0.25, 4); _apply(); };
        window.frsZoomOut = function () { _scale = Math.max(_scale - 0.25, 0.5); if (_scale <= 1) { _panX = 0; _panY = 0; } _apply(); };
        window.frsResetZoom = function () { _scale = 1; _panX = 0; _panY = 0; _apply(); };

        window.frsHandleWheel = function (e) {
            e.preventDefault();
            var d = e.deltaY > 0 ? -0.15 : 0.15;
            _scale = Math.min(Math.max(_scale + d, 0.5), 4);
            if (_scale <= 1) { _panX = 0; _panY = 0; }
            _apply();
        };
        window.frsStartDrag = function (e) {
            if (_scale <= 1) return;
            _dragging = true; _lx = e.clientX; _ly = e.clientY;
            var wrap = document.getElementById('frsImgViewerWrap');
            if (wrap) wrap.classList.add('is-dragging');
        };
        window.frsDoDrag = function (e) {
            if (!_dragging) return;
            _panX += (e.clientX - _lx); _panY += (e.clientY - _ly);
            _lx = e.clientX; _ly = e.clientY;
            _apply();
        };
        window.frsEndDrag = function () {
            _dragging = false;
            var wrap = document.getElementById('frsImgViewerWrap');
            if (wrap) wrap.classList.remove('is-dragging');
        };

        /* ─────────────────────────────────────────────────────────
           frsRenderRemarkCards(items)
           Call this from your AJAX success handler to render
           timeline cards inside #divFRSAlertRemark.

           Each item should have:
             seq        – row number
             ackType    – "PT" | "T" | "F" | "M"
             causeCode  – string (optional)
             remark     – string
             maintainer – string
             dept       – string (optional)
             rectDate   – string (date portion)
             rectTime   – string (time portion)
             remarkId   – id passed to fnShowRemarkImage (optional)
             hasImage   – boolean
        ─────────────────────────────────────────────────────────── */
        var _pillMap = {
            'PT': 'frs-pill-pt',
            'T': 'frs-pill-t',
            'F': 'frs-pill-f',
            'M': 'frs-pill-m'
        };
        var _pillLabel = { 'PT': 'PT &ndash; Partially True', 'T': 'T &ndash; True', 'F': 'F &ndash; False', 'M': 'M &ndash; Maintenance' };

        window.frsRenderRemarkCards = function (items) {
            var container = document.getElementById('divFRSAlertRemark');
            if (!container) return;
            if (!items || !items.length) {
                container.innerHTML = '<div class="frs-history-loading"><i class="fas fa-inbox"></i> No remarks found.</div>';
                return;
            }
            var html = '';
            items.forEach(function (r, idx) {
                var pillClass = _pillMap[r.ackType] || 'frs-pill-m';
                var pillLbl = _pillLabel[r.ackType] || r.ackType;
                var src = r.thumbSrc || '';

                /* blurred background style (only when image available) */
                var bgStyle = src ? ' style="background-image:url(\'' + src + '\')"' : '';

                /* sharp thumb inner */
                var thumbInner = src
                    ? '<img src="' + src + '" alt="Remark image" />'
                    : '<div class="frs-remark-img-thumb-icon"><i class="fas fa-image"></i></div>';

                /* image panel */
                var imgColClass = r.hasImage ? 'frs-remark-img-col' : 'frs-remark-img-col no-image';
                var imgColClick = r.hasImage ? ' onclick="frsImgColClick(this,' + r.remarkId + ')"' : '';
                var badgeText = r.hasImage ? '<i class="fas fa-expand-alt" style="font-size:8px"></i> View' : '<i class="fas fa-ban" style="font-size:8px"></i> None';

                var imgCol = '<div class="' + imgColClass + '"' + imgColClick + '>'
                    + '<div class="frs-remark-img-bg"' + bgStyle + '></div>'
                    + '<div class="frs-remark-img-thumb">' + thumbInner + '</div>'
                    + '<div class="frs-remark-img-badge">' + badgeText + '</div>'
                    + '</div>';

                var causeHtml = r.causeCode
                    ? '<span class="frs-remark-cause"><i class="fas fa-tag"></i>' + r.causeCode + '</span>'
                    : '';

                html += '<div class="frs-remark-card">'
                    + '<div class="frs-remark-card-head">'
                    + '<span class="frs-remark-seq">' + (idx + 1) + '</span>'
                    + '<span class="frs-pill ' + pillClass + '"><span class="dot"></span>' + pillLbl + '</span>'
                    + '<div class="frs-remark-card-head-right">'
                    + '<span class="frs-remark-meta"><i class="fas fa-user"></i><strong>' + (r.maintainer || '—') + '</strong>' + (r.dept ? ' &middot; ' + r.dept : '') + '</span>'
                    + '<span class="frs-remark-meta"><i class="fas fa-clock"></i>' + (r.rectTime || '—') + '</span>'
                    + '</div>'
                    + '</div>'
                    + '<div class="frs-remark-card-main">'
                    + imgCol
                    + '<div class="frs-remark-content-col">' + causeHtml + '<p class="frs-remark-text">' + (r.remark || '') + '</p></div>'
                    + '</div>'
                    + '<div class="frs-remark-card-foot">'
                    + '<span class="frs-remark-foot-item"><i class="fas fa-calendar-alt"></i><span>' + (r.rectDate || '—') + '</span></span>'
                    + (r.dept ? '<span class="frs-remark-foot-item"><i class="fas fa-building"></i><span>' + r.dept + '</span></span>' : '')
                    + '</div>'
                    + '</div>';
            });
            container.innerHTML = html;
        };

        /* ripple + open image */
        window.frsImgColClick = function (el, remarkId) {
            var rect = el.getBoundingClientRect();
            var ripple = document.createElement('span');
            ripple.className = 'frs-ripple';
            var size = Math.max(el.offsetWidth, el.offsetHeight);
            ripple.style.cssText = 'width:' + size + 'px;height:' + size + 'px;'
                + 'left:' + (event.clientX - rect.left - size / 2) + 'px;'
                + 'top:' + (event.clientY - rect.top - size / 2) + 'px;';
            el.appendChild(ripple);
            ripple.addEventListener('animationend', function () { ripple.remove(); });
            setTimeout(function () { fnShowRemarkImage(remarkId); }, 180);
        }

        document.addEventListener('DOMContentLoaded', function () {
            var modal = document.getElementById('modalRemarkImage');
            if (modal) {
                /* suppress Bootstrap backdrop; use our scoped pseudo-element instead */
                $(modal).data('bs.modal') && ($(modal).data('bs.modal')._config.backdrop = false);
                $(modal).on('show.bs.modal', function () {
                    /* re-apply backdrop:false each time in case modal was re-initialised */
                    var instance = $(modal).data('bs.modal');
                    if (instance) instance._config.backdrop = false;
                    document.body.classList.add('frs-image-modal-open');
                });
                $(modal).on('hidden.bs.modal', function () {
                    window.frsResetZoom();
                    document.body.classList.remove('frs-image-modal-open');
                });
            }
        });
    })();
</script>
