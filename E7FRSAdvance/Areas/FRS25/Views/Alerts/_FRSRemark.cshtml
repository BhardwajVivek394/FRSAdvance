@model List<Domain.FRSAlertRemark>

@* ══════════════════════════════════════════════════════════════
    _FRSRemark.cshtml  — injected via AJAX into #divFRSAlertRemark
    DO NOT wrap in a modal here. The parent modal shell is in
    _FRSAlertModals.cshtml (#modalFRSAlertRemark).
    ══════════════════════════════════════════════════════════════ *@

<style>
    .frsr-wrap {
        overflow-x: auto;
    }

    .frsr-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12.5px;
        color: var(--e7-text, #22303f);
    }

        .frsr-table thead tr {
            background: var(--e7-surface-2, #f6f8fa);
            border-bottom: 1px solid var(--e7-border, #e7ebf1);
        }

        .frsr-table thead th {
            padding: 9px 12px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: var(--e7-text-3, #627186);
            white-space: nowrap;
            text-align: left;
        }

        .frsr-table tbody tr {
            border-bottom: 1px solid var(--e7-border, #e7ebf1);
            transition: background .12s;
        }

            .frsr-table tbody tr:last-child {
                border-bottom: none;
            }

            .frsr-table tbody tr:hover {
                background: var(--e7-surface-2, #f6f8fa);
            }

        .frsr-table tbody td {
            padding: 10px 12px;
            vertical-align: top;
            color: var(--e7-text, #22303f);
            font-size: 12.5px;
            line-height: 1.55;
        }

    /* ── sr no cell ── */
    .frsr-srno {
        color: var(--e7-text-3, #627186);
        font-size: 11px;
        font-weight: 600;
        text-align: center;
        min-width: 36px;
    }

    /* ── ack status badge ── */
    .frsr-ack {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .frsr-ack-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        display: inline-block;
    }

    .frsr-ack-pt {
        background: var(--frs-pt-bg);
        color: var(--frs-pt-fg);
        border: 1px solid var(--frs-pt-bd);
    }

        .frsr-ack-pt .frsr-ack-dot {
            background: var(--frs-pt-dot);
        }

    .frsr-ack-true {
        background: var(--frs-t-bg);
        color: var(--frs-t-fg);
        border: 1px solid var(--frs-t-bd);
    }

        .frsr-ack-true .frsr-ack-dot {
            background: var(--frs-t-dot);
        }

    .frsr-ack-false {
        background: var(--frs-f-bg);
        color: var(--frs-f-fg);
        border: 1px solid var(--frs-f-bd);
    }

        .frsr-ack-false .frsr-ack-dot {
            background: var(--frs-f-dot);
        }

    .frsr-ack-maint {
        background: var(--frs-m-bg);
        color: var(--frs-m-fg);
        border: 1px solid var(--frs-m-bd);
    }

        .frsr-ack-maint .frsr-ack-dot {
            background: var(--frs-m-dot);
        }

    /* ── cause code pill ── */
    .frsr-cause {
        display: inline-block;
        background: var(--e7-accent-soft, rgba(47,158,196,.12));
        color: var(--e7-accent-ink, #1d6f8d);
        border: 1px solid var(--e7-accent-soft, rgba(47,158,196,.12));
        border-radius: 5px;
        padding: 2px 7px;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 4px;
        word-break: break-all;
    }

    /* ── remark text ── */
    .frsr-remark {
        color: var(--e7-text, #22303f);
        line-height: 1.6;
    }

    /* ── datetime cells ── */
    .frsr-dt {
        font-size: 11.5px;
        color: var(--e7-text-3, #627186);
        white-space: nowrap;
    }

    /* ── maintainer cell ── */
    .frsr-maint-name {
        color: var(--e7-text, #22303f);
        font-weight: 600;
        font-size: 12.5px;
    }

    .frsr-maint-desig {
        color: var(--e7-text-3, #627186);
        font-size: 11px;
        margin-top: 2px;
    }

    /* ── remark row (616 layout: one row under each feedback) ── */
    .frsr-table tbody tr.frsr-row-main {
        border-bottom: 1px dashed var(--e7-border, #e7ebf1);
    }

    .frsr-table tbody tr.frsr-row-remark td {
        padding-top: 8px;
        padding-bottom: 12px;
    }

    .frsr-remark-lbl {
        padding: 8px 12px 12px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: var(--e7-text-3, #627186);
        text-align: center;
        vertical-align: top;
        white-space: nowrap;
    }

    .frsr-remark-body {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
    }

    /* ── empty state ── */
    .frsr-empty {
        text-align: center;
        padding: 40px 20px;
        color: var(--e7-text-3, #627186);
    }

        .frsr-empty i {
            font-size: 28px;
            display: block;
            margin-bottom: 10px;
            opacity: .4;
        }

    /* ── image button ── */
    .frsr-img-btn {
        background: var(--e7-accent-soft, rgba(47,158,196,.12));
        border: 1px solid var(--e7-accent-soft, rgba(47,158,196,.12));
        color: var(--e7-accent-ink, #1d6f8d);
        border-radius: 6px;
        padding: 5px 9px;
        font-size: 13px;
        cursor: pointer;
        transition: background .15s, color .15s;
        line-height: 1;
    }

        .frsr-img-btn:hover {
            background: var(--e7-accent, #2f9ec4);
            color: #fff;
        }
</style>

@if (Model == null || !Model.Any())
{
    <div class="frsr-empty">
        <i class="fas fa-comment-slash"></i>
        No feedback or remarks recorded yet.
    </div>
}
else
{
    <div class="frsr-wrap">
        <table class="frsr-table">
            <thead>
                <tr>
                    <th style="width:56px;text-align:center;">Sr no.</th>
                    <th style="min-width:110px;">Alert Feedback Type</th>
                    <th style="min-width:130px;">Incidence Date &amp; Time</th>
                    <th style="min-width:130px;">Rectification Date &amp; Time</th>
                    <th style="min-width:120px;">Maintainer Name</th>
                    <th style="min-width:120px;">Maintainer Designation</th>
                    <th style="min-width:100px;">Timestamp</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int srNo = 1;
                    var mFRSAlert = ViewBag.FRSAlert as Domain.FRSAlert;
                }
                @foreach (var item in Model)
                {
                    @* ── determine ack badge ── *@
                    string ackCss, ackLbl;
                    if (item.AcknowledgementStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True)
                    { ackCss = "frsr-ack-true"; ackLbl = "True"; }
                    else if (item.AcknowledgementStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False)
                    { ackCss = "frsr-ack-false"; ackLbl = "False"; }
                    else if (item.AcknowledgementStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.Maintenace)
                    { ackCss = "frsr-ack-maint"; ackLbl = "Maintenance"; }
                    else if (item.AcknowledgementStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT)
                    { ackCss = "frsr-ack-pt"; ackLbl = "PT"; }
                    else
                    { ackCss = "frsr-ack-maint"; ackLbl = "—"; }

                    <tr class="frsr-row-main">
                        <td class="frsr-srno">@srNo</td>

                        <td>
                            <span class="frsr-ack @ackCss">
                                <span class="frsr-ack-dot"></span>@ackLbl
                            </span>
                        </td>

                        <td class="frsr-dt">
                            @if (mFRSAlert != null && mFRSAlert.Id > 0 && mFRSAlert.SetTimeStamp != DateTime.MinValue)
                            {
                                @mFRSAlert.SetTimeStamp.ToString("dd/MM/yyyy")<br />
                                <span style="color:var(--e7-text-3, #627186);">@mFRSAlert.SetTimeStamp.ToString("HH:mm:ss")</span>
                            }
                            else
                            {
                                <span style="color:var(--e7-text-4, #b3bdc9);">—</span>
                            }
                        </td>

                        <td class="frsr-dt">
                            @if (item.RectificationDateTime != null && item.RectificationDateTime.Value != DateTime.MinValue)
                            {
                                @item.RectificationDateTime.Value.ToString("dd/MM/yyyy")<br />
                                <span style="color:var(--e7-text-3, #627186);">@item.RectificationDateTime.Value.ToString("HH:mm:ss")</span>
                            }
                            else
                            {
                                <span style="color:var(--e7-text-4, #b3bdc9);">—</span>
                            }
                        </td>

                        <td>
                            <div class="frsr-maint-name">@(string.IsNullOrEmpty(item.MaintainerName) ? "—" : item.MaintainerName)</div>
                        </td>

                        <td>
                            <div class="frsr-maint-desig">@(string.IsNullOrEmpty(item.MaintainerDesignation) ? "—" : item.MaintainerDesignation)</div>
                        </td>

                        <td class="frsr-dt">
                            @if (item.CreatedDate != null && item.CreatedDate != DateTime.MinValue)
                            {
                                @item.CreatedDate.ToString("dd/MM/yyyy")<br />
                                <span style="color:var(--e7-text-3, #627186);">@item.CreatedDate.ToString("HH:mm:ss")</span>
                            }
                            else
                            {
                                <span style="color:var(--e7-text-4, #b3bdc9);">—</span>
                            }
                        </td>

                    </tr>

                    @* 616 layout: the remark sits on its own row under each feedback *@
                    <tr class="frsr-row-remark">
                        <th class="frsr-remark-lbl">Remark</th>
                        <td colspan="6">
                            <div class="frsr-remark-body">
                                <div>
                                    @if (item.AcknowledgementStatusId == (int)E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT
                                         && !string.IsNullOrEmpty(item.PTAlertInfo))
                                    {
                                        <span class="frsr-cause">Updated Cause Code: @item.PTAlertInfo</span><br />
                                    }
                                    <span class="frsr-remark">@(string.IsNullOrEmpty(item.Remark) ? "—" : item.Remark)</span>
                                </div>
                                <button onclick="fnShowRemarkImage(@item.Id)"
                                        class="frsr-img-btn"
                                        title="View Image">
                                    <i class="fas fa-image"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    srNo++;
                }
            </tbody>
        </table>
    </div>
}
