                        <div class="alrt-dbg-reset-lbl"><i class="fas fa-undo" style="margin-right:4px"></i>Reset Alert Message</div>
                        <div class="alrt-dbg-reset-val" id="alrtDbgReset"></div>
                    </div>
                </div>

                <!-- TELEMETRY LIVE -->
                <div class="alrt-dbg-panel" id="alrtDbgPanel_telemetry">
                    <div id="alrtDbgTelemetryContent">
                        <div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading telemetry data…</p></div>
                    </div>
                </div>

                <!-- MQTT GRAPH -->
                <div class="alrt-dbg-panel" id="alrtDbgPanel_mqtt">
                    <div id="alrtDbgMqttContent">
                        <div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading MQTT graph…</p></div>
                    </div>
                </div>

                <!-- DATALOGGER LOG -->
                <div class="alrt-dbg-panel" id="alrtDbgPanel_datalogger">
                    <div id="alrtDbgDataloggerContent">
                        <div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading datalogger log…</p></div>
                    </div>
                </div>

                <!-- ALERT JSON -->
                <div class="alrt-dbg-panel" id="alrtDbgPanel_alertjson">
                    <div id="alrtDbgAlertJsonContent">
                        <div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading alert JSON…</p></div>
                    </div>
                </div>

                <!-- DEBUG TPR -->
                <div class="alrt-dbg-panel" id="alrtDbgPanel_debugtpr">
                    <div id="alrtDbgDebugtprContent">
                        <div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading TPR data…</p></div>
                    </div>
                </div>

                <!-- NETWORK -->
                <div class="alrt-dbg-panel" id="alrtDbgPanel_network">
                    <div id="alrtDbgNetworkContent">
                        <div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading network data…</p></div>
                    </div>
                </div>

                <!-- LOGS -->
                <div class="alrt-dbg-panel" id="alrtDbgPanel_logs">
                    <div id="alrtDbgLogsContent">
                        <div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading logs…</p></div>
                    </div>
                </div>

            </div><!-- /.alrt-dbg-body -->

            <div class="alrt-dbg-foot">
                <button class="alrt-dbg-btn-close" onclick="alrtDbgClose()">
                    <i class="fas fa-times"></i> Close
                </button>
            </div>

        </div>
    </div>



    <div class="alrt-filter-dropdown" id="alrtDdZone">
        <div class="alrt-dropdown-search">
            <input type="text" placeholder="Search zone..." onkeyup="alrtFilterDropdown('zone', this.value)">
        </div>
        <div class="alrt-dropdown-header">
            <input type="checkbox" id="alrtChkAllZone">
            <label for="alrtChkAllZone">Select All</label>
        </div>
        <div class="alrt-dropdown-list" id="alrtListZone">
            @if (ViewBag.Zones != null)
            {
                foreach (var zone in (IEnumerable<SelectListItem>)ViewBag.Zones)
                {
                    <div class="alrt-dropdown-item" data-value="@zone.Value" data-text="@zone.Text">
                        <input type="checkbox" class="alrt-cb-zone" value="@zone.Value">
                        <span>@zone.Text</span>
                    </div>}
            }
        </div>
        <div class="alrt-dropdown-no-results">No results found</div>
    </div>

    <div class="alrt-filter-dropdown" id="alrtDdDivision">
        <div class="alrt-dropdown-search">
            <input type="text" placeholder="Search division..." onkeyup="alrtFilterDropdown('division', this.value)">
        </div>
        <div class="alrt-dropdown-header">
            <input type="checkbox" id="alrtChkAllDivision">
            <label for="alrtChkAllDivision">Select All</label>
        </div>
        <div class="alrt-dropdown-list" id="alrtListDivision">
            <div class="alrt-dropdown-empty">Select Zone first</div>
        </div>
        <div class="alrt-dropdown-no-results">No results found</div>
    </div>

    <div class="alrt-filter-dropdown" id="alrtDdSite">
        <div class="alrt-dropdown-search">
            <input type="text" placeholder="Search station..." onkeyup="alrtFilterDropdown('site', this.value)">
        </div>
        <div class="alrt-dropdown-header">
            <input type="checkbox" id="alrtChkAllSite">
            <label for="alrtChkAllSite">Select All</label>
        </div>
        <div class="alrt-dropdown-list" id="alrtListSite">
            <div class="alrt-dropdown-empty">Select Division first</div>
        </div>
        <div class="alrt-dropdown-no-results">No results found</div>
    </div>

    <!-- Stats Cards -->
    <div class="alrt-stats-grid">
        <div class="alrt-stat-card sc-failure">
            <div class="alrt-stat-hdr">
                <div class="alrt-stat-icon"><i class="fas fa-exclamation-triangle"></i></div>
                <div class="alrt-stat-trend up"><i class="fas fa-arrow-up"></i> 12%</div>
            </div>
            <div class="alrt-stat-value" id="statValFailure">-</div>
            <div class="alrt-stat-label">Failure Alerts</div>
            <div class="alrt-stat-breakdown">
                <div><div class="alrt-stat-item-label">Pending</div><div class="alrt-stat-item-value" id="statFailurePending"></div></div>
                <div><div class="alrt-stat-item-label">Cleared</div><div class="alrt-stat-item-value" id="statFailureCleared"></div></div>
            </div>
        </div>
        <div class="alrt-stat-card sc-predict">
            <div class="alrt-stat-hdr">
                <div class="alrt-stat-icon"><i class="fas fa-chart-line"></i></div>
                <div class="alrt-stat-trend down"><i class="fas fa-arrow-down"></i> 8%</div>
            </div>
            <div class="alrt-stat-value" id="statValPredictive">-</div>
            <div class="alrt-stat-label">Predictive Alerts</div>
            <div class="alrt-stat-breakdown">
                <div><div class="alrt-stat-item-label">Pending</div><div class="alrt-stat-item-value" id="statPredictivePending"></div></div>
                <div><div class="alrt-stat-item-label">Cleared</div><div class="alrt-stat-item-value" id="statPredictiveCleared"></div></div>
            </div>
        </div>
        <div class="alrt-stat-card sc-cleared">
            <div class="alrt-stat-hdr">
                <div class="alrt-stat-icon"><i class="fas fa-check-circle"></i></div>
            </div>
            <div class="alrt-stat-value" id="statValCleared">-</div>
            <div class="alrt-stat-label">Cleared Today</div>
            <div class="alrt-stat-breakdown">
                <div><div class="alrt-stat-item-label">True</div><div class="alrt-stat-item-value" id="statClearedTrue">-</div></div>
                <div><div class="alrt-stat-item-label">PT/F/M</div><div class="alrt-stat-item-value" id="statClearedPTFM">-</div></div>
            </div>
        </div>
    </div>

    <!-- Content Grid -->
    <div class="alrt-content-grid">

        <!-- Alert Table Card -->
        <div class="alrt-card">
            <div class="alrt-card-hdr">
                <h2 class="alrt-card-title"><i class="fas fa-list"></i> Alert List</h2>
                <div class="alrt-card-actions">
                    <button class="alrt-btn btn-sm" id="alrtFilterToggleBtn" onclick="alrtToggleFilterBar()">
                        <i class="fas fa-filter"></i> Filter
                        <span id="alrtFilterActiveBadge" style="display:none;background:#dc2626;color:#fff;border-radius:10px;font-size:9px;padding:1px 6px;margin-left:4px;font-weight:700;">ON</span>
                    </button>
                    <div style="position:relative;display:inline-block;" id="alrtExportWrap">
                        <button class="alrt-btn btn-sm" id="alrtExportBtn" onclick="alrtToggleExportMenu(event)">
                            <i class="fas fa-download"></i> Export
                            <i class="fas fa-chevron-down" class="arrow"></i>
                        </button>

                        <div id="alrtExportMenu" class="alrt-export-menu">
                            <button class="alrt-export-item" onclick="alrtExportAlerts('csv')">
                                <i class="fas fa-file-csv csv-icon"></i>
                                Export as CSV
                            </button>

                            <div class="alrt-divider"></div>

                            <button class="alrt-export-item" onclick="alrtExportAlerts('excel')">
                                <i class="fas fa-file-excel excel-icon"></i>
                                Export as Excel
                            </button>
                        </div>
                    </div>
                    <button class="alrt-btn btn-primary btn-sm" id="alrtRefreshBtn" onclick="alrtRefresh()">
                        <i class="fas fa-sync-alt" id="alrtRefreshIcon"></i> Refresh
                    </button>
                </div>
            </div>

            <!-- Tabs -->
            <div class="alrt-tabs">
                <button class="alrt-tab active" onclick="alrtFilter('all', this)">
                    All Alerts <span class="alrt-tab-badge" id="tabBadgeAll" style="background:var(--border);color:var(--text-secondary);"></span>
                </button>
                <button class="alrt-tab failure" onclick="alrtFilter('Failure', this)">
                    Failure <span class="alrt-tab-badge" id="tabBadgeFailure"></span>
                </button>
                <button class="alrt-tab predictive" onclick="alrtFilter('Predictive', this)">
                    Predictive <span class="alrt-tab-badge" id="tabBadgePredictive"></span>
                </button>
            </div>

            <!-- Filter Bar -->
            <div class="alrt-filters-bar" id="alrtFilterBar">
                <div class="alrt-filter-group">
                    <label class="alrt-filter-label">Asset Type</label>
                    <select class="alrt-filter-inp" id="fltAssetType">
                        <option value="">All Types</option>
                    </select>
                </div>
                <div class="alrt-filter-group">
                    <label class="alrt-filter-label">Status</label>
                    <select class="alrt-filter-inp" id="fltStatus">
                        <option value="">All Status</option>
                        <option value="2">Pending</option>
                        <option value="1">Cleared</option>
                    </select>
                </div>
                <div class="alrt-filter-group">
                    <label class="alrt-filter-label">From Date</label>
                    <input type="date" class="alrt-filter-inp" id="fltFrom">
                </div>
                <div class="alrt-filter-group">
                    <label class="alrt-filter-label">To Date</label>
                    <input type="date" class="alrt-filter-inp" id="fltTo">
                </div>
                <div class="alrt-filter-group" style="justify-content:flex-end;gap:6px;flex-direction:row;align-items:flex-end;">
                    <label class="alrt-filter-label" style="display:none;">&nbsp;</label>
                    <button class="alrt-btn btn-sm" onclick="alrtClearFilters()" title="Clear all filters"
                            style="border-color:#d1d5db;color:#6b7280;">
                        <i class="fas fa-times"></i> Clear
                    </button>
                    <button class="alrt-btn btn-primary btn-sm" onclick="alrtApplyFilters()">
                        <i class="fas fa-search"></i> Apply
                    </button>
                </div>
            </div>

            <!-- Table — populated by /FRS25/Alerts/_List partial view -->
            <div id="divAlertDetailReport">
                <div style="text-align:center;padding:40px;color:#94a3b8;">
                    <i class="fas fa-search" style="font-size:28px;margin-bottom:12px;display:block;opacity:.4;"></i>
                    Select filters and click <strong>Search</strong> to load alerts.
                </div>
            </div>
        </div>

        <!-- Side Panel -->
        <div class="alrt-side-panel">

            <!-- Escalation Timeline -->
            <div class="alrt-esc-card">
                <div class="alrt-esc-hdr">
                    <h3 class="alrt-esc-title"><i class="fas fa-arrow-up-right-dots"></i> Escalation Timeline</h3>
                </div>
                <div class="alrt-esc-body">
                    <div class="alrt-esc-info" id="alrtEscInfo">
                        Select an alert to view its escalation history
                    </div>
                    <div class="alrt-timeline" id="alrtTimeline">
                        <div class="alrt-tl-empty">
                            <i class="fas fa-bell"></i>
                            <div>No alert selected</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Maintenance Mode -->
            <div class="alrt-maint-card">
                <div class="alrt-maint-hdr">
                    <h3 class="alrt-maint-title"><i class="fas fa-wrench"></i> Maintenance Mode</h3>
                    <span class="alrt-maint-count" id="alrtMaintCountBadge">—</span>
                </div>
                <div class="alrt-maint-body">
                    <div class="alrt-maint-list" id="alrtMaintList"></div>
                    <button class="alrt-add-maint" onclick="alrtOpenMaintModal()">
                        <i class="fas fa-plus"></i> Add Maintenance Mode
                    </button>
                </div>
            </div>

            <!-- Performance Metrics -->
            <div class="alrt-metrics-card">
                <div class="alrt-metrics-hdr">
                    <h3 class="alrt-metrics-title"><i class="fas fa-chart-pie"></i> Performance</h3>
                </div>
                <div class="alrt-metric-item">
                    <span class="alrt-metric-label">Failure Alert Accuracy</span>
                    <span class="alrt-metric-value" id="perfFailureAccuracy">—</span>
                </div>
                <div class="alrt-metric-item">
                    <span class="alrt-metric-label">Predictive Alert Accuracy</span>
                    <span class="alrt-metric-value" id="perfPredictiveAccuracy">—</span>
                </div>
                <div class="alrt-metric-item">
                    <span class="alrt-metric-label">Actual Failure Detection</span>
                    <span class="alrt-metric-value" id="perfActualDetection">—</span>
                </div>
            </div>
        </div>
    </div><!-- /content-grid -->
</div><!-- /alrt-page -->
<!-- ============================================================
     MODAL OVERLAY
============================================================ -->
<div class="alrt-overlay" id="alrtOverlay" onclick="alrtCloseAll()"></div>

<!-- ============================================================
     MAINTENANCE MODAL
============================================================ -->
<div class="alrt-modal" id="alrtMaintModal" style="width:560px;max-width:95vw;">
    <div class="alrt-modal-hdr">
        <div>
            <div class="alrt-modal-title" id="mntModalTitle">Activate Maintenance Window</div>
            <div class="alrt-modal-sub">Para 5 — Suppress alerts during planned maintenance</div>
        </div>
        <button class="alrt-modal-close" onclick="alrtCloseMaintModal()">
            <i class="fas fa-times"></i>
        </button>
    </div>
    <div class="alrt-modal-body">

        <input type="hidden" id="mntEditId" value="0">

        <!-- EDIT MODE: frozen summary (hidden in add mode) -->
        <div id="mntEditSummary" style="display:none;margin-bottom:16px;
             padding:14px 16px;background:var(--maint-light);border-radius:var(--radius);
             border-left:4px solid var(--maint);">
            <div style="font-size:12px;font-weight:700;color:var(--maint);
                        text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px;">
                <i class="fas fa-lock" style="margin-right:6px;"></i>Frozen — Edit To Date &amp; Time only
            </div>
            <div style="font-size:13px;font-weight:600;color:var(--text-primary)"
                 id="mntEditAsset"></div>
            <div style="font-size:12px;color:var(--text-muted);margin-top:4px">
                <i class="fas fa-map-marker-alt" style="margin-right:4px;"></i>
                <span id="mntEditStation"></span>
            </div>
            <div style="font-size:12px;color:var(--maint);margin-top:4px;font-family:monospace;">
                <i class="fas fa-clock" style="margin-right:4px;"></i>From:&nbsp;
                <span id="mntEditFrom"></span>
            </div>
        </div>

        <!-- ADD MODE: all dropdowns (hidden in edit mode) -->
        <div id="mntAddFields">
            <div class="alrt-form-group">
                <label class="alrt-form-label">Zone <span class="req">*</span></label>
                <select class="alrt-form-sel" id="mntZone" onchange="mntLoadDivisions()">
                    <option value="">— Select Zone —</option>
                    @if (ViewBag.Zones != null)
                    {
                        foreach (var z in (IEnumerable<SelectListItem>)ViewBag.Zones)
                        {
                            <option value="@z.Value">@z.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="alrt-form-row">
                <div class="alrt-form-group">
                    <label class="alrt-form-label">Division <span class="req">*</span></label>
                    <select class="alrt-form-sel" id="mntDivision" disabled onchange="mntLoadSites()">
                        <option value="">— Select Division —</option>
                    </select>
                </div>
                <div class="alrt-form-group">
                    <label class="alrt-form-label">Station <span class="req">*</span></label>
                    <select class="alrt-form-sel" id="mntSite" disabled onchange="mntLoadAssetTypes()">
                        <option value="">— Select Station —</option>
                    </select>
                </div>
            </div>

            <div class="alrt-form-group">
                <label class="alrt-form-label">Asset Type <span class="req">*</span></label>
                <select class="alrt-form-sel" id="mntAssetType" disabled onchange="mntLoadAssets()">
                    <option value="">— Select Asset Type —</option>
                </select>
            </div>

            <div class="alrt-form-group">
                <label class="alrt-form-label">Asset Number <span class="req">*</span></label>
                <select class="alrt-form-sel" id="mntAsset" disabled>
                    <option value="">— Select Asset —</option>
                </select>
            </div>

            <div class="alrt-form-row">
                <div class="alrt-form-group">
                    <label class="alrt-form-label">From Date <span class="req">*</span></label>
                    <input type="date" class="alrt-form-inp" id="mntFromDate">
                </div>
                <div class="alrt-form-group">
                    <label class="alrt-form-label">From Time <span class="req">*</span></label>
                    <input type="time" class="alrt-form-inp" id="mntFromTime" step="60">
                </div>
            </div>
        </div>

        <!-- TO DATE/TIME — always editable (both add and edit modes) -->
        <div class="alrt-form-row">
            <div class="alrt-form-group">
                <label class="alrt-form-label">To Date <span class="req">*</span></label>
                <input type="date" class="alrt-form-inp" id="mntToDate">
            </div>
            <div class="alrt-form-group">
                <label class="alrt-form-label">To Time <span class="req">*</span></label>
                <input type="time" class="alrt-form-inp" id="mntToTime" step="60">
            </div>
        </div>

        <div class="alrt-form-group">
            <label class="alrt-form-label">Remark</label>
            <textarea class="alrt-form-ta" id="mntRemark"
                      placeholder="Describe the planned maintenance activity..."></textarea>
        </div>

        <div id="mntValidMsg" style="display:none;padding:8px 12px;background:var(--failure-light);
             color:var(--failure);font-size:13px;border-radius:var(--radius-sm);margin-top:-4px;">
            <i class="fas fa-exclamation-circle"></i>
            <span id="mntValidText"></span>
        </div>

    </div>
    <div class="alrt-modal-ftr">
        <button class="alrt-btn" onclick="alrtCloseMaintModal()">Cancel</button>
        <button class="alrt-btn btn-primary" id="mntSaveBtn" onclick="alrtActivateMaint()">
            <i class="fas fa-check"></i> <span id="mntSaveLbl">Activate</span>
        </button>
    </div>
</div>
<!-- ============================================================
     FEEDBACK SLIDE PANEL
============================================================ -->
<div class="alrt-slide-panel" id="alrtFeedbackPanel">
    <div class="alrt-panel-hdr">
        <div>
            <div class="alrt-panel-title">Provide Alert Feedback</div>
            <div class="alrt-panel-sub">Annexure D — Section 6 &amp; 7</div>
        </div>
        <button class="alrt-panel-close" onclick="alrtCloseFeedback()"><i class="fas fa-times"></i></button>
    </div>
    <div class="alrt-panel-body">

        <!-- Alert Summary -->
        <div class="alrt-summary-block">
            <div class="alrt-summary-hdr">
                <div>
                    <div class="alrt-summary-id" id="panelAlertId">#ALT-0000</div>
                    <div class="alrt-summary-name" id="panelAssetName">—</div>
                </div>
                <span class="alrt-type-badge failure" id="panelAlertType"><i class="fas fa-exclamation-circle"></i> Failure</span>
            </div>
            <div class="alrt-summary-grid">
                <div><div class="alrt-summary-lbl">Station</div><div class="alrt-summary-val" id="panelStation">—</div></div>
                <div><div class="alrt-summary-lbl">Division / Zone</div><div class="alrt-summary-val">DLI / NR</div></div>
                <div><div class="alrt-summary-lbl">Cause Code</div><div class="alrt-summary-val" id="panelCause" style="font-family:monospace;color:var(--primary-600);">—</div></div>
                <div><div class="alrt-summary-lbl">Incidence Time</div><div class="alrt-summary-val" id="panelTime">—</div></div>
                <div><div class="alrt-summary-lbl">Duration</div><div class="alrt-summary-val" id="panelDuration" style="color:var(--failure);">—</div></div>
                <div><div class="alrt-summary-lbl">Rectification Time</div><div class="alrt-summary-val" id="panelRectTime">—</div></div>
            </div>
        </div>

        <!-- Locked notice -->
        <div class="alrt-locked-notice" id="alrtLockedNotice" style="display:none;">
            <i class="fas fa-lock"></i>
            <span>Feedback already submitted. Only JE/SSE can modify.</span>
        </div>

        <!-- Feedback Options -->
        <div class="alrt-section-title"><i class="fas fa-check-circle"></i> Select Feedback Type <span class="req">*</span></div>
        <div class="alrt-fb-options" id="alrtFbOptions">
            <div class="alrt-fb-opt fbt" onclick="alrtSelectFb(this,'T')">
                <div class="alrt-fb-icon">T</div>
                <div class="alrt-fb-label">True</div>
                <div class="alrt-fb-desc">Failure occurred AND cause matches</div>
            </div>
            <div class="alrt-fb-opt fbpt" onclick="alrtSelectFb(this,'PT')">
                <div class="alrt-fb-icon">PT</div>
                <div class="alrt-fb-label">Partially True</div>
                <div class="alrt-fb-desc">Failure occurred BUT cause differs</div>
            </div>
            <div class="alrt-fb-opt fbf" onclick="alrtSelectFb(this,'F')">
                <div class="alrt-fb-icon">F</div>
                <div class="alrt-fb-label">False</div>
                <div class="alrt-fb-desc">No actual failure at site</div>
            </div>
            <div class="alrt-fb-opt fbm" onclick="alrtSelectFb(this,'M')">
                <div class="alrt-fb-icon">M</div>
                <div class="alrt-fb-label">Maintenance</div>
                <div class="alrt-fb-desc">Alert during maintenance</div>
            </div>
        </div>

        <!-- Rectification Details -->
        <div class="alrt-form-section">
            <div class="alrt-section-title"><i class="fas fa-calendar-check"></i> Rectification Details</div>
            <div class="alrt-form-row">
                <div class="alrt-form-group">
                    <label class="alrt-form-label">Rectification Date <span class="req">*</span></label>
                    <input type="date" class="alrt-form-inp" id="alrtRectDate">
                </div>
                <div class="alrt-form-group">
                    <label class="alrt-form-label">Rectification Time <span class="req">*</span></label>
                    <input type="time" class="alrt-form-inp" id="alrtRectTime">
                </div>
            </div>
        </div>

        <!-- Remarks -->
        <div class="alrt-form-section">
            <div class="alrt-section-title"><i class="fas fa-comment-alt"></i> Remarks <span class="req">*</span></div>
            <textarea class="alrt-form-ta" id="alrtRemarks" placeholder="Describe action taken, root cause, observations..."></textarea>
        </div>

        <!-- Vendor Review (shown for PT/F) -->
        <div class="alrt-vendor-review" id="alrtVendorReview" style="display:none;">
            <div class="alrt-vendor-title"><i class="fas fa-building"></i> Vendor Remarks (Para 6.1)</div>
            <div class="alrt-vendor-remarks" id="alrtVendorRemarks">Awaiting vendor response...</div>
            <div class="alrt-vendor-meta">Response due: 24 hours &nbsp;|&nbsp; Vendor: M/s XYZ Technologies</div>
        </div>

        <!-- Authority Review (JE/SSE only) -->
        <div class="alrt-auth-review" id="alrtAuthReview" style="display:none;">
            <div class="alrt-auth-review-title"><i class="fas fa-user-tie"></i> JE/SSE Final Decision (Para 6.1/6.2)</div>
            <div class="alrt-form-group">
                <label class="alrt-form-label">Final Feedback</label>
                <select class="alrt-form-sel" id="alrtFinalFb">
                    <option value="">-- Select --</option>
                    <option value="T">True (T)</option>
                    <option value="PT">Partially True (PT)</option>
                    <option value="F">False (F)</option>
                    <option value="M">Maintenance (M)</option>
                </select>
            </div>
            <div class="alrt-form-group">
                <label class="alrt-form-label">Authority Remarks</label>
                <textarea class="alrt-form-ta" id="alrtAuthRemarks" placeholder="Enter final remarks after examining maintainer and vendor feedback..."></textarea>
            </div>
        </div>
    </div>
    <div class="alrt-panel-ftr">
        <button class="alrt-btn" onclick="alrtCloseFeedback()">Cancel</button>
        <button class="alrt-btn btn-primary" id="alrtSubmitFbBtn" onclick="alrtSubmitFeedback()">
            <i class="fas fa-paper-plane"></i> Submit Feedback
        </button>
    </div>
</div>
@Html.Partial("_FRSAlertModals")
@Html.Partial("_FRSFeedbackSlidePanel")

<script>
    // ── AlertWS state — initialised immediately so alrtConnectAlertWS
    //    can safely reference it even if called before line 5765 ──────
    //window._alertWsState = window._alertWsState || {
    //    ws: null,
    //    url: null,
    //    reconnTimer: null,
    //    refreshTimer: null,
    //    reconnDelay: 3000,
    //    maxDelay: 30000,
    //    destroyed: false,
    //    BASE: 'ws://proxy.energy7.org:8081/subscribe/alertEvents'
    //};

    // ── APP_CONFIG — picks SSL or plain based on current protocol ──────
var isSecure = window.location.protocol === "https:";
var ALERT_WS_CONFIG = {};
if (isSecure) {
    ALERT_WS_CONFIG = {
        WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrlSSL"]',
        WebSocketAuthToken: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketAuthToken"]'
    };
} else {
    ALERT_WS_CONFIG = {
        WebSocketBaseUrl: '@System.Configuration.ConfigurationManager.AppSettings["WebSocketBaseUrl"]',
        WebSocketAuthToken: null
    };
}
var ALERT_WS_BASE = ALERT_WS_CONFIG.WebSocketBaseUrl + '/subscribe/alertEvents';

window._alertWsState = window._alertWsState || {
    ws: null,
    url: null,
    reconnTimer: null,
    refreshTimer: null,
    reconnDelay: 3000,
    maxDelay: 30000,
    destroyed: false
    // BASE is no longer hardcoded here — built from ALERT_WS_BASE above
};

    // ============================================================
    // DATA
    // ============================================================


    // ── Page / filter state ──
    var alrtCurrentPage = 1;
    var alrtCurrentFilter = 'all';
    var alrtSelectedFb = null;
    var alrtCurrentAlert = null;
    window._alertPageSize = 10;
    window._alertCurrentSkip = 0;

    // ============================================================
    // fnGetAlertList — same pattern as Alerts / fnGetAlertDetailReport
    // ============================================================
    // ============================================================
    // fnGetAlertList — calls Alerts/_List, renders JSON into new UI
    // ============================================================
    function fnGetAlertList(skip) {
        var m = { SearchCriteria: {}, Pager: {} };
        var fltStatusVal = $('#fltStatus').val();
        m.SearchCriteria.AlertStatus = (fltStatusVal !== '' && fltStatusVal != null)
            ? parseInt(fltStatusVal)
            : 0;
        // Zone / Division / Site from header dropdowns
        m.SearchCriteria.ZoneIds = alrtGetValues('zone');
        m.SearchCriteria.DivisionIds = alrtGetValues('division');
        m.SearchCriteria.SiteIds = alrtGetValues('site');
        var alertTypeMap = { 'Predictive': 1, 'Failure': 2 };
        var alertTypeVal = alertTypeMap[alrtCurrentFilter];
        m.SearchCriteria.AlertTypeId = (alrtCurrentFilter !== 'all' && alertTypeVal != null)
            ? alertTypeVal
            : 0;

        // Asset Type from table filter bar (dynamic, loaded per site)
        m.SearchCriteria.AssetTypeIds = $('#fltAssetType').val() ? [$('#fltAssetType').val()] : [];

        // Alert Type from tab (Failure / Predictive / Health)
        //m.SearchCriteria.AlertTypeIds = (alrtCurrentFilter !== 'all') ? [alrtCurrentFilter] : [];

        // Date from table filter bar
        m.SearchCriteria.FromDate = $('#fltFrom').val() || null;
        m.SearchCriteria.ToDate = $('#fltTo').val() || null;
        // NOTE: AlertStatus is intentionally NOT sent — controller sets it to Active
        // Pager
        m.Pager.Skip = (skip != null && skip !== undefined && skip !== '') ? parseInt(skip) : 0;
        m.Pager.PageSize = window._alertPageSize || 10;

        window._alertCurrentSkip = m.Pager.Skip;

        $("#e7-loader").show();
        $.ajax({
            url: '/FRS25/Alerts/GetAlertList',
            type: 'POST',
            contentType: 'application/x-www-form-urlencoded',
            data: $.param(m),
            dataType: 'html',
            success: function (data) {
                $("#e7-loader").hide();
                var $target = $("#divAlertDetailReport");
                if ($target.length === 0) {
                    console.error("divAlertDetailReport not found in DOM");
                    return;
                }
                $target.empty().append(data);
                console.log("Injected " + data.length + " chars into divAlertDetailReport");
            },
            error: function () {
                $("#e7-loader").hide();
                $("#divAlertDetailReport").html(
                    '<div style="text-align:center;padding:40px;color:#94a3b8;">' +
                    '<i class="fas fa-exclamation-circle" style="font-size:24px;margin-bottom:10px;display:block;"></i>' +
                    'Something went wrong. Please try again.</div>'
                );
            }
        });
    }

    // ============================================================
    // DEFAULT DATE RANGE — 1 month back from today
    // ============================================================
    (function alrtSetDefaultDates() {
        var today = new Date();
        var oneMonthAgo = new Date(today);
        oneMonthAgo.setMonth(oneMonthAgo.getMonth() - 1);

        function fmtDate(d) {
            var y = d.getFullYear();
            var m = ('0' + (d.getMonth() + 1)).slice(-2);
            var dd = ('0' + d.getDate()).slice(-2);
            return y + '-' + m + '-' + dd;
        }

        var fltFrom = document.getElementById('fltFrom');
        var fltTo = document.getElementById('fltTo');
        if (fltFrom && !fltFrom.value) fltFrom.value = fmtDate(oneMonthAgo);
        if (fltTo && !fltTo.value) fltTo.value = fmtDate(today);
    })();

    document.addEventListener('DOMContentLoaded', function () {
        // Ensure dates are set (also run here in case elements weren't ready above)
        (function () {
            var today = new Date();
            var oneMonthAgo = new Date(today);
            oneMonthAgo.setMonth(oneMonthAgo.getMonth() - 1);
            function fmtDate(d) {
                var y = d.getFullYear();
                var m = ('0' + (d.getMonth() + 1)).slice(-2);
                var dd = ('0' + d.getDate()).slice(-2);
                return y + '-' + m + '-' + dd;
            }
            var fltFrom = document.getElementById('fltFrom');
            var fltTo = document.getElementById('fltTo');
            if (fltFrom && !fltFrom.value) fltFrom.value = fmtDate(oneMonthAgo);
            if (fltTo && !fltTo.value) fltTo.value = fmtDate(today);
        })();

        alrtLoadMaintList();        // load maintenance sidebar
        fnGetAlertList(0);          // load list (now with 1-month dates)
        fnGetAlertCounts();         // load tile + badge counts
        fnLoadPerformanceMetrics();
        alrtConnectAlertWS();       // start WebSocket for alertEvents
    });

    function fnGetFirstValue(type) {
        var vals = alrtGetValues(type);
        return vals.length > 0 ? vals[0] : '';
    }

    // ============================================================
    // alrtRenderAlertTable — renders JSON response into the new UI
    // ============================================================
    function alrtRenderAlertTable(response) {
        var alerts = (response && response.alerts) || [];
        var totalCount = (response && response.totalCount) || 0;
        var pageSize = (response && response.pageSize) || window._alertPageSize || 10;
        var skip = (response && response.skip) || 0;

        var typeIcon = { Failure: 'exclamation-circle', Predictive: 'chart-line', Health: 'heartbeat' };
        var typeMap = { 1: 'Failure', 2: 'Predictive', 3: 'Health' };

        if (alerts.length === 0) {
            $('#divAlertDetailReport').html(
                '<div style="text-align:center;padding:40px;color:#94a3b8;">' +
                '<i class="fas fa-bell-slash" style="font-size:28px;margin-bottom:12px;display:block;opacity:.4;"></i>' +
                'No alerts found for the selected filters.</div>'
            );
            return;
        }

        var rows = '';
        $.each(alerts, function (i, a) {
            var alertTypeName = a.AlertType || typeMap[a.AlertTypeId] || 'Failure';
            var alertTypeCls = alertTypeName.toLowerCase();
            var icon = typeIcon[alertTypeName] || 'exclamation-circle';
            var statusCls = (a.AlertStatusId === 1 || a.AlertStatus === 'Active') ? 'pending' : 'cleared';
            var statusLabel = (statusCls === 'pending') ? 'Active' : 'Cleared';
            var statusIcon = (statusCls === 'pending') ? 'clock' : 'check-circle';
            var fbCode = a.FeedbackCode || a.Feedback || '';
            var fbCls = fbCode ? ({ T: 'fb-true', PT: 'fb-partial', F: 'fb-false', M: 'fb-maint' }[fbCode] || 'fb-none') : 'fb-none';
            var assetName = a.AssetName || a.AssetNumber || '';
            var assetType = a.AssetType || '';
            var station = a.StationName || a.SiteName || '';
            var causeCode = a.CauseCode || a.AlertDescription || a.Description || '';
            var incTime = a.IncidenceTime || a.AlertTime || a.CreatedOn || '';
            var duration = a.Duration || '';
            var maintName = a.MaintainerName || a.AssignedTo || '';
            var maintRole = a.MaintainerRole || a.Role || '';
            var maintMobile = a.Mobile || a.MobileNo || '';
            var initials = maintName ? maintName.split(' ').map(function (w) { return w[0]; }).join('').toUpperCase().substring(0, 2) : '—';

            rows += '<tr>' +
                '<td><span class="alrt-type-badge ' + alertTypeCls + '">' +
                '<i class="fas fa-' + icon + '"></i> ' + alertTypeName + '</span></td>' +
                '<td><div class="alrt-asset-info">' +
                '<span class="alrt-asset-name">' + assetName + (assetType ? ' (' + assetType + ')' : '') + '</span>' +
                '<span class="alrt-asset-loc"><i class="fas fa-map-marker-alt"></i> ' + station + '</span>' +
                (causeCode ? '<span class="alrt-cause-code">' + causeCode + '</span>' : '') +
                '</div></td>' +
                '<td><div class="alrt-time-cell"><span class="alrt-time-main">' + incTime + '</span></div></td>' +
                '<td><span class="alrt-dur">' + (duration || '—') + '</span></td>' +
                '<td><span class="alrt-status ' + statusCls + '"><i class="fas fa-' + statusIcon + '"></i> ' + statusLabel + '</span></td>' +
                '<td><span class="alrt-fb-badge ' + fbCls + '">' + (fbCode || '—') + '</span></td>' +
                '<td><div class="alrt-maintainer-cell">' +
                '<div class="alrt-maint-avatar">' + initials + '</div>' +
                '<div><div class="alrt-maint-name">' + maintName + '</div>' +
                '<div class="alrt-maint-role">' + maintRole + '</div>' +
                '<div class="alrt-maint-mob">' + maintMobile + '</div></div>' +
                '</div></td>' +
                '<td><div class="alrt-action-btns">' +
                '<button class="alrt-act-btn ' + (statusCls === 'pending' ? 'btn-primary' : '') + '" ' +
                'title="' + (statusCls === 'pending' ? 'Give Feedback' : 'View Feedback') + '" ' +
                'onclick="alrtOpenFeedback(' + a.Id + ', ' + JSON.stringify(a).replace(/'/g, "\\'") + ')"><i class="fas fa-comment-dots"></i></button>' +
                '<button class="alrt-act-btn" title="Alert History"><i class="fas fa-history"></i></button>' +
                '</div></td>' +
                '</tr>';
        });

        // Build full table with thead + pagination
        var totalPages = Math.ceil(totalCount / pageSize);
        var currentPage = Math.floor(skip / pageSize) + 1;
        var from = skip + 1;
        var to = Math.min(skip + pageSize, totalCount);

        var pagination = '<button class="alrt-page-btn" onclick="alrtGoPage(' + (currentPage - 1) + ')"><i class="fas fa-chevron-left"></i></button>';
        for (var p = 1; p <= totalPages; p++) {
            pagination += '<button class="alrt-page-btn ' + (p === currentPage ? 'active' : '') + '" onclick="alrtGoPage(' + p + ')">' + p + '</button>';
        }
        pagination += '<button class="alrt-page-btn" onclick="alrtGoPage(' + (currentPage + 1) + ')"><i class="fas fa-chevron-right"></i></button>';

        $('#divAlertDetailReport').html(
            '<div class="alrt-table-wrap">' +
            '<table class="alrt-table">' +
            '<thead><tr>' +
            '<th>Type</th>' +
            '<th>Asset / Cause</th>' +
            '<th>Incidence Time</th>' +
            '<th>Duration</th>' +
            '<th>Status</th>' +
            '<th>Feedback</th>' +
            '<th>Maintainer</th>' +
            '<th>Actions</th>' +
            '</tr></thead>' +
            '<tbody>' + rows + '</tbody>' +
            '</table></div>' +
            '<div class="alrt-table-footer">' +
            '<div class="alrt-table-info">Showing <strong>' + from + '</strong>–<strong>' + to + '</strong> of <strong>' + totalCount + '</strong> alerts</div>' +
            '<div class="alrt-pagination">' + pagination + '</div>' +
            '</div>'
        );
    }

    // delegates to fnGetAlertList
    function alrtRenderTable() { fnGetAlertList(window._alertCurrentSkip || 0); }

    function alrtGoPage(p) {
        if (p < 1) return;
        alrtCurrentPage = p;
        fnGetAlertList((p - 1) * (window._alertPageSize || 10));
    }

    // ============================================================
    // FILTER + TABS
    // ============================================================
    function alrtFilter(type, el) {
        alrtCurrentFilter = type;
        alrtCurrentPage = 1;
        document.querySelectorAll('.alrt-tab').forEach(function (t) { t.classList.remove('active'); });
        el.classList.add('active');
        fnGetAlertList(0);
    }

    function alrtApplyFilters() {
        alrtCurrentPage = 1;
        alrtCurrentFilter = 'all';
        document.querySelectorAll('.alrt-tab').forEach(function (t) { t.classList.remove('active'); });
        var allTab = document.querySelector('.alrt-tab');
        if (allTab) allTab.classList.add('active');
        fnGetAlertList(0);
        fnLoadPerformanceMetrics();
    }

    function alrtRefresh() { fnGetAlertList(window._alertCurrentSkip || 0); }

    // ============================================================
    // FEEDBACK PANEL
    // — alrtOpenFeedback is called from the _List partial view
    //   with data attributes on the button, or directly with an object
    // ============================================================
    function alrtOpenFeedback(id) {
        // Read data from the button's data-* attributes (set by _List.cshtml)
        var btn = document.querySelector('[data-id="' + id + '"]');
        var a = {
            id: id,
            asset: btn ? btn.dataset.asset : '',
            station: btn ? btn.dataset.station : '',
            cause: btn ? btn.dataset.cause : '',
            time: btn ? btn.dataset.time : '',
            duration: btn ? btn.dataset.duration : '',
            type: btn ? btn.dataset.type : 'Failure',
            fb: btn ? btn.dataset.feedback : '',
            locked: btn ? btn.dataset.locked === 'true' : false,
            siteId: btn ? btn.dataset.siteId : '',
        };
        alrtCurrentAlert = a;
        alrtSelectedFb = null;

        if (a.siteId) fnLoadPerformanceMetrics([a.siteId]);
        else fnLoadPerformanceMetrics();

        document.getElementById('panelAlertId').textContent = '#' + id;
        document.getElementById('panelAssetName').textContent = a.asset;
        document.getElementById('panelStation').textContent = a.station;
        document.getElementById('panelCause').textContent = a.cause;
        document.getElementById('panelTime').textContent = a.time;
        document.getElementById('panelDuration').textContent = a.duration;
        document.getElementById('panelRectTime').textContent = '—';

        var typeIcon = { Failure: 'exclamation-circle', Predictive: 'chart-line', Health: 'heartbeat' };
        var tb = document.getElementById('panelAlertType');
        tb.className = 'alrt-type-badge ' + a.type.toLowerCase();
        tb.innerHTML = '<i class="fas fa-' + (typeIcon[a.type] || 'exclamation-circle') + '"></i> ' + a.type;

        var locked = document.getElementById('alrtLockedNotice');
        var opts = document.getElementById('alrtFbOptions');
        locked.style.display = a.locked ? 'flex' : 'none';
        document.getElementById('alrtAuthReview').style.display = 'none';
        document.getElementById('alrtVendorReview').style.display = 'none';
        opts.querySelectorAll('.alrt-fb-opt').forEach(function (o) { o.classList.remove('selected', 'disabled'); });
        document.getElementById('alrtRemarks').disabled = false;
        document.getElementById('alrtRectDate').disabled = false;
        document.getElementById('alrtRectTime').disabled = false;
        document.getElementById('alrtSubmitFbBtn').style.display = 'flex';
        document.getElementById('alrtSubmitFbBtn').innerHTML = '<i class="fas fa-paper-plane"></i> Submit Feedback';

        if (a.locked) {
            opts.querySelectorAll('.alrt-fb-opt').forEach(function (o) { o.classList.add('disabled'); });
            document.getElementById('alrtRemarks').disabled = true;
            document.getElementById('alrtRectDate').disabled = true;
            document.getElementById('alrtRectTime').disabled = true;
            document.getElementById('alrtSubmitFbBtn').style.display = 'none';
            if (a.fb === 'PT' || a.fb === 'F') {
                document.getElementById('alrtVendorReview').style.display = 'block';
                document.getElementById('alrtVendorRemarks').textContent = 'Awaiting vendor response...';
            }
            var fbMap = { T: 'fbt', PT: 'fbpt', F: 'fbf', M: 'fbm' };
            if (a.fb && fbMap[a.fb]) {
                var sel = opts.querySelector('.' + fbMap[a.fb]);
                if (sel) sel.classList.add('selected');
                alrtSelectedFb = a.fb;
            }
        }

        document.getElementById('alrtOverlay').classList.add('active');
        document.getElementById('alrtFeedbackPanel').classList.add('active');
    }
    function alrtShowHistory(id) {
        alrtToast('info', 'Alert History', 'Loading history for alert #' + id + '...');
    }
    function alrtSelectFb(el, code) {
        document.querySelectorAll('.alrt-fb-opt').forEach(function (o) { o.classList.remove('selected'); });
        el.classList.add('selected');
        alrtSelectedFb = code;
        document.getElementById('alrtVendorReview').style.display = (code === 'PT' || code === 'F') ? 'block' : 'none';
        if (code === 'PT' || code === 'F') document.getElementById('alrtVendorRemarks').textContent = 'Will be sent to vendor for remarks after submission.';
    }

    function alrtSubmitFeedback() {
        if (!alrtSelectedFb) {
            alrtToast('warning', 'Selection Required', 'Please select a feedback type (T/PT/F/M)');
            return;
        }

        var rectDate = document.getElementById('alrtRectDate').value.trim();
        var rectTime = document.getElementById('alrtRectTime').value.trim();
        if (!rectDate) {
            alrtToast('error', 'Required', 'Rectification Date is required');
            document.getElementById('alrtRectDate').focus();
            return;
        }
        if (!rectTime) {
            alrtToast('error', 'Required', 'Rectification Time is required');
            document.getElementById('alrtRectTime').focus();
            return;
        }

        var remarks = document.getElementById('alrtRemarks').value.trim();
        if (!remarks) {
            alrtToast('error', 'Remarks Required', 'Please enter remarks about the action taken');
            return;
        }

        alrtToast('success', 'Feedback Submitted', 'Alert marked as ' + alrtSelectedFb);
        // Refresh the table from server to reflect updated status
        fnGetAlertList(window._alertCurrentSkip || 0);
        setTimeout(alrtCloseFeedback, 800);
    }

    function alrtCloseFeedback() {
        document.getElementById('alrtOverlay').classList.remove('active');
        document.getElementById('alrtFeedbackPanel').classList.remove('active');
        alrtSelectedFb = null; alrtCurrentAlert = null;
        document.getElementById('alrtRemarks').value = '';
        document.getElementById('alrtRectDate').value = '';
        document.getElementById('alrtRectTime').value = '';
    }


    function alrtCloseAll() { alrtCloseFeedback(); alrtCloseMaintModal(); }

    // ============================================================
    // TOAST
    // ============================================================
    function alrtToast(type, title, msg) {
        if (typeof showToast === 'function') { showToast(type, title, msg); return; }
        var c = document.getElementById('toastContainer');
        if (!c) return;
        var icons = { success: 'check', error: 'times', warning: 'exclamation-triangle', info: 'info-circle' };
        var id = 'at_' + Date.now();
        var el = document.createElement('div');
        el.id = id; el.className = 'toast-notification toast-' + type;
        el.innerHTML = '<div class="toast-icon"><i class="fas fa-' + (icons[type] || 'info-circle') + '"></i></div>' +
            '<div class="toast-body"><div class="toast-title">' + title + '</div><div class="toast-message">' + msg + '</div></div>' +
            '<button class="toast-close" onclick="document.getElementById(\'' + id + '\').remove()">×</button>' +
            '<div class="toast-progress"></div>';
        c.appendChild(el);
        setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 4500);
    }

    // ============================================================
    // INIT — merged into single DOMContentLoaded above (line ~3207)
    // ============================================================
    // (placeholder message now set via document.getElementById in the
    //  main DOMContentLoaded block to avoid $ not-defined errors)

    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { alrtCloseAll(); alrtCloseDD(); } });

    // ============================================================
    // ZONE / DIVISION / STATION DROPDOWNS
    // — exact same pattern as Alerts/Index.cshtml —
    // ============================================================
    var alrtOpenDropdown = null;

    document.addEventListener('DOMContentLoaded', function () {

        // ── Toggle on select-btn click ──
        document.querySelectorAll('.alrt-select-btn').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                alrtToggleDD(btn.dataset.target, btn);
            });
        });

        // ── Backdrop closes dropdown ──
        var alrtBd = document.getElementById('alrtBackdrop');
        if (alrtBd) alrtBd.addEventListener('click', alrtCloseDD);

        // ── Select All checkboxes ──
        var czAll = document.getElementById('alrtChkAllZone');
        var cdAll = document.getElementById('alrtChkAllDivision');
        var csAll = document.getElementById('alrtChkAllSite');
        if (czAll) czAll.addEventListener('change', function () { alrtSelectAll('zone', this.checked); });
        if (cdAll) cdAll.addEventListener('change', function () { alrtSelectAll('division', this.checked); });
        if (csAll) csAll.addEventListener('change', function () { alrtSelectAll('site', this.checked); });

        // ── Item click (checkbox toggle) — delegated on document ──
        document.addEventListener('click', function (e) {
            var item = e.target.closest('.alrt-dropdown-item');
            if (item) {
                e.stopPropagation();
                var cb = item.querySelector('input[type="checkbox"]');
                if (cb && e.target !== cb) cb.checked = !cb.checked;
                if (cb) item.classList.toggle('checked', cb.checked);
                var type = ((cb && cb.className) || '').replace('alrt-cb-', '');
                alrtUpdateSelectAllState(type);
                alrtUpdateText(type);
                alrtOnFilterChange(type);
            }

            // ── Header row click ──
            var hdr = e.target.closest('.alrt-dropdown-header');
            if (hdr) {
                e.stopPropagation();
                var chk = hdr.querySelector('input[type="checkbox"]');
                if (chk) {
                    if (e.target === chk || e.target.tagName === 'LABEL') {
                        var id = chk.id || '';
                        var type = id.replace('alrtChkAll', '').charAt(0).toLowerCase() + id.replace('alrtChkAll', '').slice(1);
                        alrtSelectAll(type, chk.checked);
                    } else {
                        chk.checked = !chk.checked;
                        var id2 = chk.id || '';
                        var type2 = id2.replace('alrtChkAll', '').charAt(0).toLowerCase() + id2.replace('alrtChkAll', '').slice(1);
                        alrtSelectAll(type2, chk.checked);
                    }
                }
            }

            // ── Stop search box from closing dropdown ──
            if (e.target.closest('.alrt-dropdown-search')) {
                e.stopPropagation();
            }
        });
    });

    // ----- Dropdown open/close (appends to body like AlertLive) -----
    function alrtToggleDD(id, btn) {
        if (alrtOpenDropdown === id) { alrtCloseDD(); return; }
        alrtCloseDD();

        var dd = document.getElementById(id);
        if (!dd) return;

        // Move to body to escape parent stacking contexts
        document.body.appendChild(dd);

        var rect = btn.getBoundingClientRect();

        // Measure height invisibly
        dd.style.cssText = 'position:fixed;visibility:hidden;display:block;top:-9999px;left:-9999px;';
        var ddHeight = dd.offsetHeight;
        var ddWidth = dd.offsetWidth;

        var top = rect.bottom + 4;
        var left = rect.left;

        if (top + ddHeight > window.innerHeight) top = rect.top - ddHeight - 4;
        if (left + ddWidth > window.innerWidth) left = window.innerWidth - ddWidth - 8;

        dd.style.cssText = 'position:fixed;top:' + top + 'px;left:' + left + 'px;';
        dd.classList.add('open');
        btn.classList.add('active');
        var bd = document.getElementById('alrtBackdrop');
        if (bd) bd.classList.add('show');
        alrtOpenDropdown = id;

        setTimeout(function () {
            var inp = dd.querySelector('.alrt-dropdown-search input');
            if (inp) inp.focus();
        }, 100);
    }

    function alrtCloseDD() {
        if (alrtOpenDropdown) {
            var dd = document.getElementById(alrtOpenDropdown);
            if (dd) {
                var inp = dd.querySelector('.alrt-dropdown-search input');
                if (inp) inp.value = '';
                dd.querySelectorAll('.alrt-dropdown-item').forEach(function (item) {
                    item.classList.remove('hidden');
                    var origText = item.dataset.text;
                    var span = item.querySelector('span');
                    if (origText && span) span.textContent = origText;
                });
                dd.querySelectorAll('.alrt-dropdown-no-results').forEach(function (el) { el.classList.remove('show'); });
                dd.classList.remove('open');
            }
            document.querySelectorAll('.alrt-select-btn').forEach(function (b) { b.classList.remove('active'); });
            var bd = document.getElementById('alrtBackdrop');
            if (bd) bd.classList.remove('show');
            alrtOpenDropdown = null;
        }
    }

    // ----- Search / filter -----
    function alrtFilterDropdown(type, searchText) {
        var $dd = $('#alrtDd' + alrtCapitalize(type));
        var search = searchText.toLowerCase().trim();
        var visible = 0;

        $dd.find('.alrt-dropdown-item').each(function () {
            var $item = $(this);
            var text = ($item.data('text') || $item.find('span').text()).toLowerCase();
            if (search === '' || text.indexOf(search) > -1) {
                $item.removeClass('hidden');
                visible++;
                if (search !== '') {
                    var orig = $item.data('text') || $item.find('span').text();
                    var regex = new RegExp('(' + alrtEscapeRegex(searchText) + ')', 'gi');
                    $item.find('span').html(orig.replace(regex, '<mark>$1</mark>'));
                } else {
                    var origText = $item.data('text');
                    if (origText) $item.find('span').text(origText);
                }
            } else {
                $item.addClass('hidden');
            }
        });
        if (visible === 0 && search !== '') $dd.find('.alrt-dropdown-no-results').addClass('show');
        else $dd.find('.alrt-dropdown-no-results').removeClass('show');
    }

    function alrtEscapeRegex(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

    function alrtSelectAll(type, checked) {
        document.querySelectorAll('.alrt-cb-' + type).forEach(function (cb) {
            var item = cb.closest('.alrt-dropdown-item');
            if (item && !item.classList.contains('hidden')) {
                cb.checked = checked;
                item.classList.toggle('checked', checked);
            }
        });
        alrtUpdateText(type);
        alrtOnFilterChange(type);
    }

    function alrtUpdateSelectAllState(type) {
        var list = document.getElementById('alrtList' + alrtCapitalize(type));
        if (!list) return;
        var items = list.querySelectorAll('.alrt-dropdown-item:not(.hidden)');
        var total = items.length;
        var checked = list.querySelectorAll('.alrt-cb-' + type + ':checked:not(.hidden ~ *)').length;
        // count only visible checked
        var visibleChecked = 0;
        items.forEach(function (item) { if (item.querySelector('.alrt-cb-' + type + ':checked')) visibleChecked++; });
        var chkAll = document.getElementById('alrtChkAll' + alrtCapitalize(type));
        if (chkAll) chkAll.checked = total > 0 && total === visibleChecked;
    }

    function alrtUpdateText(type) {
        var cbs = document.querySelectorAll('.alrt-cb-' + type + ':checked');
        var count = cbs.length;
        var text = 'All';
        if (count === 1) {
            var item = cbs[0].closest('.alrt-dropdown-item');
            text = (item && item.dataset.text) || (item && item.querySelector('span') && item.querySelector('span').textContent) || 'All';
        } else if (count > 1) {
            text = count + ' selected';
        }
        var txtEl = document.getElementById('alrtTxt' + alrtCapitalize(type));
        if (txtEl) txtEl.textContent = text;
    }

    function alrtGetValues(type) {
        var vals = [];
        document.querySelectorAll('.alrt-cb-' + type + ':checked').forEach(function (cb) { vals.push(cb.value); });
        return vals;
    }

    function alrtCapitalize(s) { return s.charAt(0).toUpperCase() + s.slice(1); }

    // ----- Cascade -----
    function alrtOnFilterChange(type) {
        if (type === 'zone') alrtLoadDivisions();
        if (type === 'division') alrtLoadSites();
        if (type === 'site') {
            alrtLoadAssetTypes();
            alrtConnectAlertWS();  // reconnect WS whenever site selection changes
        }
        alrtLoadMaintList();   // refresh maintenance sidebar on any filter change
    }

