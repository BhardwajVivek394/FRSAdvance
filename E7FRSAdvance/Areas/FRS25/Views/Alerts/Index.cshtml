    // OPEN modal (id = 0 for new, existing id for edit)
    function alrtOpenMaintModal(id, assetDisp, station, fromDisplay, toDate, toTime) {
        alrtCloseDD(); // close any open header dropdown & hide backdrop first

        id = id || 0;
        var isEdit = id > 0;

        $('#mntEditId').val(id);
        $('#mntModalTitle').text(isEdit ? 'Edit Maintenance Window' : 'Activate Maintenance Window');
        $('#mntSaveLbl').text(isEdit ? 'Update' : 'Activate');
        $('#mntValidMsg').hide();

        if (isEdit) {
            // EDIT MODE — show frozen summary, hide all add dropdowns
            $('#mntAddFields').hide();
            $('#mntEditSummary').show();

            // Fill frozen summary card
            $('#mntEditAsset').text(assetDisp || '');
            $('#mntEditStation').text(station || '');
            $('#mntEditFrom').text(fromDisplay || '');

            // Prefill only To Date and To Time (editable)
            $('#mntToDate').val(toDate || '');
            $('#mntToTime').val(toTime || '');
            $('#mntRemark').val('');

        } else {
            // ADD MODE — show all dropdowns, hide summary
            $('#mntEditSummary').hide();
            $('#mntAddFields').show();

            // Reset Zone to blank (triggers no cascade — downstream cleared manually below)
            $('#mntZone').val('');

            // Reset all downstream dropdowns to blank + disabled state
            $('#mntDivision').prop('disabled', true).html('<option value="">— Select Division —</option>');
            $('#mntSite').prop('disabled', true).html('<option value="">— Select Station —</option>');
            $('#mntAssetType').prop('disabled', true).html('<option value="">— Select Asset Type —</option>');
            $('#mntAsset').prop('disabled', true).html('<option value="">— Select Asset —</option>');

            // Clear date/time/remark fields
            $('#mntFromDate,#mntFromTime,#mntToDate,#mntToTime,#mntRemark').val('');
        }

        // Open modal
        document.getElementById('alrtOverlay').classList.add('active');
        document.getElementById('alrtMaintModal').classList.add('active');
    }
    function mntPad2(n) { return (n < 10 ? '0' : '') + n; }

    function alrtCloseMaintModal() {
        document.getElementById('alrtOverlay').classList.remove('active');
        document.getElementById('alrtMaintModal').classList.remove('active');
    }

    // MODAL CASCADE — reuses the alerts endpoints
    function mntLoadDivisions(preselectDivId, preselectSiteId, preselectAssetTypeId, preselectAssetId) {
        var zoneId = $('#mntZone').val();

        // Reset downstream dropdowns
        $('#mntDivision').prop('disabled', true).html('<option value="">— Loading… —</option>');
        $('#mntSite').prop('disabled', true).html('<option value="">— Select Station —</option>');
        $('#mntAssetType').prop('disabled', true).html('<option value="">— Select Asset Type —</option>');
        $('#mntAsset').prop('disabled', true).html('<option value="">— Select Asset —</option>');

        if (!zoneId) {
            $('#mntDivision').html('<option value="">— Select Division —</option>');
            return;
        }

        $.ajax({
            url: '/FRS25/Alerts/GetDivisionByZoneId',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ SearchCriteria: { ZoneIds: [parseInt(zoneId, 10)] } }),
            success: function (data) {
                var html = '<option value="">— Select Division —</option>';
                $.each(data || [], function (_, v) {
                    html += '<option value="' + v.Id + '">' + v.Name + '</option>';
                });
                $('#mntDivision').html(html).prop('disabled', false);   // ← enable after load
                if (preselectDivId) {
                    $('#mntDivision').val(preselectDivId);
                    mntLoadSites(preselectSiteId, preselectAssetTypeId, preselectAssetId);
                }
            },
            error: function () {
                $('#mntDivision').html('<option value="">— Failed to load —</option>').prop('disabled', false);
            }
        });
    }

    function mntLoadSites(preselectSiteId, preselectAssetTypeId, preselectAssetId) {
        var divId = $('#mntDivision').val();

        // Reset downstream only — leave Division enabled
        $('#mntSite').prop('disabled', true).html('<option value="">— Loading… —</option>');
        $('#mntAssetType').prop('disabled', true).html('<option value="">— Select Asset Type —</option>');
        $('#mntAsset').prop('disabled', true).html('<option value="">— Select Asset —</option>');

        if (!divId) {
            $('#mntSite').html('<option value="">— Select Station —</option>');
            return;
        }

        $.ajax({
            url: '/FRS25/Alerts/GetSiteByDivisionId',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ SearchCriteria: { DivisionIds: [parseInt(divId, 10)] } }),
            success: function (data) {
                var html = '<option value="">— Select Station —</option>';
                $.each(data || [], function (_, v) {
                    html += '<option value="' + v.Id + '">' + v.Name + '</option>';
                });
                $('#mntSite').html(html).prop('disabled', false);   // ← enable after load
                if (preselectSiteId) {
                    $('#mntSite').val(preselectSiteId);
                    mntLoadAssetTypes(preselectAssetTypeId, preselectAssetId);
                }
            },
            error: function () {
                $('#mntSite').html('<option value="">— Failed to load —</option>').prop('disabled', false);
            }
        });
    }

    // Step 1: Load Asset Types after Station selected
    function mntLoadAssetTypes(preselectAssetTypeId, preselectAssetId) {
        var siteId = $('#mntSite').val();

        $('#mntAssetType').prop('disabled', true).html('<option value="">— Loading… —</option>');
        $('#mntAsset').prop('disabled', true).html('<option value="">— Select Asset —</option>');

        if (!siteId) {
            $('#mntAssetType').html('<option value="">— Select Asset Type —</option>');
            return;
        }

        $.get('/FRS25/Alerts/GetAssetTypeBySiteId', { siteId: siteId }, function (data) {
            var html = '<option value="">— Select Asset Type —</option>';
            $.each(data || [], function (_, v) {
                html += '<option value="' + v.Id + '">' + v.Name + '</option>';
            });
            $('#mntAssetType').html(html).prop('disabled', false);   // ← enable after load
            if (preselectAssetTypeId) {
                $('#mntAssetType').val(preselectAssetTypeId);
                mntLoadAssets(preselectAssetId);
            }
        }).fail(function () {
            $('#mntAssetType').html('<option value="">— Failed to load —</option>').prop('disabled', false);
        });
    }

    // Step 2: Load Assets after Asset Type selected
    function mntLoadAssets(preselectAssetId) {
        var siteId = $('#mntSite').val();
        var assetTypeId = $('#mntAssetType').val();

        $('#mntAsset').prop('disabled', true).html('<option value="">— Loading… —</option>');

        if (!siteId || !assetTypeId) {
            $('#mntAsset').html('<option value="">— Select Asset —</option>');
            return;
        }

        $.ajax({
            url: '/FRS25/Alerts/GetAssetById',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ siteId: parseInt(siteId, 10), assetTypeId: parseInt(assetTypeId, 10) }),
            dataType: 'json',
            success: function (data) {
                if (!data || data.length === 0) {
                    $('#mntAsset').html('<option value="">— No assets found —</option>');
                    return;
                }
                var html = '<option value="">— Select Asset —</option>';
                $.each(data, function (_, v) {
                    html += '<option value="' + v.Id + '">' + (v.Name || v.AssetName || '') + '</option>';
                });
                $('#mntAsset').html(html).prop('disabled', false);   // ← enable after load
                if (preselectAssetId) $('#mntAsset').val(preselectAssetId);
            },
            error: function () {
                $('#mntAsset').html('<option value="">— Failed to load —</option>');
            }
        });
    }
    // SAVE — Add mode: full payload | Edit mode: only Id + ToDate + ToTime
    function alrtActivateMaint() {
        var id = parseInt($('#mntEditId').val()) || 0;
        var isEdit = id > 0;
        var td = $('#mntToDate').val(), tt = $('#mntToTime').val();

        function bad(msg) { $('#mntValidText').text(msg); $('#mntValidMsg').show(); }

        if (!td || !tt) return bad('To Date and To Time are required.');

        // ── EDIT MODE: only update the end time ──
        if (isEdit) {
            $('#mntValidMsg').hide();
            $('#mntSaveBtn').prop('disabled', true);
            $.ajax({
                url: '/FRS25/Alerts/UpdateMaintenanceEndTime',
                type: 'POST',
                data: { Id: id, ToDate: td, ToTime: tt },   // form-encoded — matches controller model binding
                dataType: 'json',
                success: function (r) {
                    if (r && r.type === 'success') {
                        alrtToast('success', 'Maintenance Updated', r.result || 'End time updated successfully');
                        alrtCloseMaintModal();
                        alrtLoadMaintList();
                    } else {
                        bad((r && r.result) || 'Server rejected the request.');
                    }
                },
                error: function () { bad('Save failed. Please try again.'); },
                complete: function () { $('#mntSaveBtn').prop('disabled', false); }
            });
            return;
        }

        // ── ADD MODE: full validation and payload ──
        var zone = $('#mntZone').val();
        var divsn = $('#mntDivision').val();
        var site = $('#mntSite').val();
        var assetType = $('#mntAssetType').val();
        var asset = $('#mntAsset').val();
        var fd = $('#mntFromDate').val(), ft = $('#mntFromTime').val();
        var remark = $('#mntRemark').val();

        if (!zone || !divsn || !site || !assetType || !asset)
            return bad('Zone, Division, Station, Asset Type and Asset are all required.');
        if (!fd || !ft) return bad('Start and end date/time are required.');
        if (new Date(td + 'T' + tt) <= new Date(fd + 'T' + ft))
            return bad('To time must be after From time.');

        $('#mntValidMsg').hide();

        var payload = {
            Id: 0,
            AssetId: parseInt(asset),
            AssetTypeId: parseInt(assetType),
            SiteId: parseInt(site),
            DivisionId: parseInt(divsn),
            ZoneId: parseInt(zone),
            FromDate: fd,
            FromTime: ft,
            ToDate: td,
            ToTime: tt,
            Remark: remark
        };

        $('#mntSaveBtn').prop('disabled', true);
        $.ajax({
            url: '/FRS25/Alerts/UpdateMaintenanceActiveMode',
            type: 'POST',
            data: payload,
            success: function (r) {
                if (r && r.type === 'success') {
                    alrtToast('success', 'Maintenance Activated', r.result || 'Saved successfully');
                    alrtCloseMaintModal();
                    alrtLoadMaintList();
                } else {
                    bad((r && r.result) || 'Server rejected the request.');
                }
            },
            error: function () { bad('Save failed. Check console.'); },
            complete: function () { $('#mntSaveBtn').prop('disabled', false); }
        });
    }

    // CLEAR — calls UpdateMaintenanceInActiveMode
    function alrtClearMaint(id) {
        if (!confirm('Clear this maintenance window now? Alerts will resume immediately.')) return;
        var mMaintenanceMode = { AssetId: id };

        $("#loader").show();
        $.ajax({
            url: '/FRS25/Alerts/UpdateMaintenanceInActiveMode',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(mMaintenanceMode),
            dataType: 'json',
            success: function (data) {
                $("#loader").hide();
                if (data && data.type === 'success') {
                    alrtToast('success', 'Maintenance Cleared', data.result || 'Alerts have resumed');
                    alrtLoadMaintList();
                } else {
                    alrtToast('error', 'Clear Failed', (data && data.result) || 'Server error');
                }
            },
            error: function () {
                $("#loader").hide();
                alrtToast('error', 'Clear Failed', 'Network error. Please try again.');
            }
        });
    }

    function alrtUpdateCounts(counts) {
        var tab = alrtCurrentFilter || 'all';
        var t = counts.total || 0;
        var f = counts.failure || 0;
        var p = counts.predictive || 0;
        if (tab === 'all') {
            $('#tabBadgeAll').text(t);
            $('#tabBadgeFailure').text(f);
            $('#tabBadgePredictive').text(p);
            $('#statValFailure').text(f);
            $('#statValPredictive').text(p);
            $('#statFailurePending').text(counts.failurePending || 0);
            $('#statFailureCleared').text(counts.failureCleared || 0);
            $('#statPredictivePending').text(counts.predictivePending || 0);
            $('#statPredictiveCleared').text(counts.predictiveCleared || 0);
        } else if (tab === 'Failure') {
            $('#tabBadgeFailure').text(t);
            $('#statValFailure').text(t);
            $('#statFailurePending').text(counts.failurePending || 0);
            $('#statFailureCleared').text(counts.failureCleared || 0);
        } else if (tab === 'Predictive') {
            $('#tabBadgePredictive').text(t);
            $('#statValPredictive').text(t);
            $('#statPredictivePending').text(counts.predictivePending || 0);
            $('#statPredictiveCleared').text(counts.predictiveCleared || 0);
        }
        fnGetAlertCounts();
    }
    // ============================================================
    // PERFORMANCE METRICS (Para 15)
    // ============================================================
    function fnLoadPerformanceMetrics(overrideSiteIds) {
        var siteIds = overrideSiteIds || alrtGetValues('site');
        var zoneIds = alrtGetValues('zone');
        var divIds = alrtGetValues('division');
        var fromDate = $('#fltFrom').val() || null;
        var toDate = $('#fltTo').val() || null;

        $('#perfFailureAccuracy,#perfPredictiveAccuracy,#perfActualDetection')
            .text('…').removeClass('good warning bad');

        $.ajax({
            url: '/FRS25/Alerts/GetPerformanceMetrics',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                SearchCriteria: {
                    ZoneIds: zoneIds, DivisionIds: divIds, SiteIds: siteIds,
                    FromDate: fromDate, ToDate: toDate, IsAcknowledgement: true
                },
                Pager: { Take: -1, Skip: 0 }
            }),
            dataType: 'json',
            success: function (d) {
                if (!d) return;
                function setMetric(id, val) {
                    var $el = $('#' + id);
                    $el.text(val !== null ? val + '%' : '—');
                    $el.removeClass('good warning bad')
                        .addClass(val >= 80 ? 'good' : val >= 50 ? 'warning' : 'bad');
                }
                setMetric('perfFailureAccuracy', d.FailureAccuracy);
                setMetric('perfPredictiveAccuracy', d.PredictiveAccuracy);
                setMetric('perfActualDetection', d.ActualDetection);
            },
            error: function () {
                $('#perfFailureAccuracy,#perfPredictiveAccuracy,#perfActualDetection')
                    .text('—').removeClass('good warning bad');
            }
        });
    }


    // ════════════════════════════════════════════════════════════
    //  ALERT ANALYSIS DEBUG POPUP
    //  Exact same logic as __AlertAnalysis.cshtml openDebugPopup
    // ════════════════════════════════════════════════════════════
    var _alrtDbgCurrent = null;
    var _alrtDbgLoaded = {};
    var _alrtDbgMqttChart = null;

    // ── Entry point — called by Analysis button in _List.cshtml ──
    function alrtOpenAnalysis(alertId) {
        var r = (window._alrtAnalysisRows || {})[alertId];
        if (!r) {
            alert('Debug data not found for alert #' + alertId +
                '.\nPlease refresh the alert list and try again.');
            return;
        }

        _alrtDbgCurrent = r;
        _alrtDbgLoaded = {};

        var overlay = document.getElementById('alrtDebugOverlay');

        // Move to body so z-index works above everything
        if (overlay.parentNode !== document.body) {
            document.body.appendChild(overlay);
            if (!overlay._closeAdded) {
                overlay.addEventListener('click', function (e) {
                    if (e.target === overlay) alrtDbgClose();
                });
                overlay._closeAdded = true;
            }
        }

        // ── Populate Info tab ─────────────────────────────────────
        document.getElementById('alrtDbgSub').textContent =
            r.assetNo + '  ·  ' + r.assetType + '  ·  ' + r.causeCode;

        document.getElementById('alrtDbgGrid').innerHTML =
            alrtDbgCard('Zone', r.zone) +
            alrtDbgCard('Division', r.division) +
            alrtDbgCard('Station', r.station) +
            alrtDbgCard('Alert Type', r.alertType) +
            alrtDbgCard('Asset Type', r.assetType) +
            alrtDbgCard('Asset No.', r.assetNo) +
            alrtDbgCard('Cause Code', r.causeCode) +
            alrtDbgCard('Incidence', r.incDate) +
            alrtDbgCard('Duration', r.duration) +
            alrtDbgCard('Rectification', r.rectDate);

        var msgBox = document.getElementById('alrtDbgMsgBox');
        if (r.setMsg) {
            document.getElementById('alrtDbgMsg').innerHTML = alrtDbgSanitize(r.setMsg);
            msgBox.style.display = 'block';
        } else { msgBox.style.display = 'none'; }

        var descBox = document.getElementById('alrtDbgDescBox');
        if (r.desc) {
            document.getElementById('alrtDbgDesc').innerHTML = alrtDbgSanitize(r.desc);
            descBox.style.display = 'block';
        } else { descBox.style.display = 'none'; }

        var resetBox = document.getElementById('alrtDbgResetBox');
        if (r.resetMsg) {
            document.getElementById('alrtDbgReset').innerHTML = alrtDbgSanitize(r.resetMsg);
            resetBox.style.display = 'block';
        } else { resetBox.style.display = 'none'; }

        // ── Reset other tab panels ────────────────────────────────
        var loadingHtml = '<div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading\u2026</p></div>';
        ['telemetry', 'mqtt', 'datalogger', 'alertjson', 'debugtpr', 'network', 'logs'].forEach(function (k) {
            var el = document.getElementById('alrtDbg' + k.charAt(0).toUpperCase() + k.slice(1) + 'Content');
            if (el) el.innerHTML = loadingHtml;
        });

        // ── Switch to Info tab ────────────────────────────────────
        alrtDbgSwitchTab('info', document.querySelector('.alrt-dbg-tab[data-tab="info"]'));

        overlay.classList.add('open');
    }

    // ── Tab switcher ─────────────────────────────────────────────
    function alrtDbgSwitchTab(key, btnEl) {
        document.querySelectorAll('.alrt-dbg-tab').forEach(function (b) { b.classList.remove('active'); });
        if (btnEl) btnEl.classList.add('active');
        document.querySelectorAll('.alrt-dbg-panel').forEach(function (p) { p.classList.remove('active'); });
        var panel = document.getElementById('alrtDbgPanel_' + key);
        if (panel) panel.classList.add('active');

        // Lazy-load — only fetch data the first time each tab is opened
        if (key !== 'info' && !_alrtDbgLoaded[key] && _alrtDbgCurrent) {
            _alrtDbgLoaded[key] = true;
            alrtDbgLoadTab(key, _alrtDbgCurrent);
        }
    }

    function alrtDbgLoadTab(key, r) {
        var map = {
            telemetry: alrtDbgLoadTelemetry,
            mqtt: alrtDbgLoadMqtt,
            datalogger: alrtDbgLoadDatalogger,
            alertjson: alrtDbgLoadAlertJson,
            debugtpr: alrtDbgLoadTpr,
            network: alrtDbgLoadNetwork,
            logs: alrtDbgLoadLogs
        };
        if (map[key]) map[key](r);
    }

    // ── Close ─────────────────────────────────────────────────────
    function alrtDbgClose() {
        var ov = document.getElementById('alrtDebugOverlay');
        if (!ov) return;
        ov.classList.remove('open');
        ov.classList.remove('fullscreen');
        var ic = document.getElementById('alrtDbgFsIcon');
        if (ic) { ic.classList.remove('fa-compress'); ic.classList.add('fa-expand'); }
        if (_alrtDbgMqttChart) {
            try { _alrtDbgMqttChart.dispose(); } catch (e) { }
            _alrtDbgMqttChart = null;
        }
        if (window._alrtDbgNetChart) {
            try { window._alrtDbgNetChart.dispose(); } catch (e) { }
            window._alrtDbgNetChart = null;
        }
    }

    // ── Fullscreen ────────────────────────────────────────────────
    function alrtDbgToggleFullscreen() {
        var ov = document.getElementById('alrtDebugOverlay');
        var ic = document.getElementById('alrtDbgFsIcon');
        var fs = ov.classList.contains('fullscreen');
        ov.classList.toggle('fullscreen', !fs);
        if (ic) {
            ic.classList.toggle('fa-expand', fs);
            ic.classList.toggle('fa-compress', !fs);
        }
        setTimeout(function () {
            if (_alrtDbgMqttChart) try { _alrtDbgMqttChart.resize(); } catch (e) { }
            if (window._alrtDbgNetChart) try { window._alrtDbgNetChart.resize(); } catch (e) { }
            // expand telemetry/TPR body if visible
            var teleBody = document.getElementById('alrtDbgTeleBodyScroll');
            var tprBody = document.getElementById('alrtDbgTprBodyScroll');
            if (!fs) {
                var h = (window.innerHeight - 240) + 'px';
                if (teleBody) teleBody.style.maxHeight = h;
                if (tprBody) tprBody.style.maxHeight = h;
            } else {
                if (teleBody) teleBody.style.maxHeight = '390px';
                if (tprBody) tprBody.style.maxHeight = '390px';
            }
        }, 100);
    }

    // ════════════════════════════════════════════════════════════
    //  HELPERS
    // ════════════════════════════════════════════════════════════
    function alrtDbgCard(lbl, val) {
        return '<div class="alrt-dbg-card">' +
            '<div class="alrt-dbg-card-lbl">' + lbl + '</div>' +
            '<div class="alrt-dbg-card-val">' + alrtDbgEsc(val || '-') + '</div>' +
            '</div>';
    }
    function alrtDbgEsc(s) {
        if (!s) return '';
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }
    function alrtDbgSanitize(s) {
        if (!s) return '';
        return alrtDbgEsc(s)
            .replace(/&lt;b&gt;/gi, '<b>')
            .replace(/&lt;\/b&gt;/gi, '</b>');
    }
    function alrtDbgPad2(n) { return n < 10 ? '0' + n : '' + n; }
    function alrtDbgTryJson(s) {
        try { return JSON.parse(s); } catch (e) { return { raw: s }; }
    }
    function alrtDbgHlJson(json) {
        if (!json) return '';
        json = json.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        return json.replace(
            /("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g,
            function (m) {
                var c = 'alrt-json-num';
                if (/^"/.test(m)) c = (/:$/.test(m)) ? 'alrt-json-key' : 'alrt-json-str';
                else if (/true|false/.test(m)) c = 'alrt-json-bool';
                else if (/null/.test(m)) c = 'alrt-json-null';
                return '<span class="' + c + '">' + m + '</span>';
            }
        );
    }
    function alrtDbgDateMinus(input, mins) {
        try {
            var dp = input.trim().split(' ');
            var d = dp[0].split('/');
            var t = (dp[1] || '00:00:00').split(':');
            if (d.length < 3) return new Date();
            var dt = new Date(+d[2], +d[1] - 1, +d[0], +t[0] || 0, +t[1] || 0, +t[2] || 0);
            if (isNaN(dt.getTime())) return new Date();
            dt.setMinutes(dt.getMinutes() - mins);
            return dt;
        } catch (e) { return new Date(); }
    }
    function alrtDbgDatePlus(input, mins) {
        try {
            var dp = input.trim().split(' ');
            var d = dp[0].split('/');
            var t = (dp[1] || '00:00:00').split(':');
            if (d.length < 3) return new Date();
            var dt = new Date(+d[2], +d[1] - 1, +d[0], +t[0] || 0, +t[1] || 0, +t[2] || 0);
            if (isNaN(dt.getTime())) return new Date();
            dt.setMinutes(dt.getMinutes() + mins);
            return dt;
        } catch (e) { return new Date(); }
    }
    function alrtDbgSyncScroll(bodyEl, headerId) {
        var hdr = document.getElementById(headerId);
        if (hdr) hdr.scrollLeft = bodyEl.scrollLeft;
    }

    // ════════════════════════════════════════════════════════════
    //  TAB 1 — TELEMETRY LIVE
    //  Endpoint: POST /FRS25/AlertLive/GetTelemetryHistoryData
    // ════════════════════════════════════════════════════════════
    function alrtDbgLoadTelemetry(r) {
        var cid = 'alrtDbgTelemetryContent';
        var s = alrtDbgDateMinus(r.incDate, 30);
        var e = alrtDbgDatePlus(r.incDate, 30);

        document.getElementById(cid).innerHTML =
            '<div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading telemetry data…</p></div>';

        $.ajax({
            url: '/FRS25/Alerts/GetTelemetryHistoryData',
            type: 'POST',
            data: {
                frsAlertId: r.id,
                siteId: r.siteId,
                assetId: r.assetId,
                startDate: s.toISOString(),
                endDate: e.toISOString()
            },
            success: function (csv) {
                // Normalise — endpoint may return JSON-encoded string
                if (!csv) {
                    document.getElementById(cid).innerHTML =
                        '<div class="alrt-dbg-empty"><i class="fas fa-satellite-dish" style="font-size:28px;display:block;margin-bottom:8px;color:#cbd5e1"></i>No telemetry data available.</div>';
                    return;
                }
                if (typeof csv !== 'string') csv = JSON.stringify(csv);
                if (csv.trim() === '') {
                    document.getElementById(cid).innerHTML =
                        '<div class="alrt-dbg-empty">No telemetry data available.</div>';
                    return;
                }

                var lines = csv.trim().split('\n').filter(function (l) { return l.trim() !== ''; });
                if (lines.length < 2) {
                    document.getElementById(cid).innerHTML = '<div class="alrt-dbg-empty">No rows in telemetry data.</div>';
                    return;
                }

                var headers = lines[0].split(',').map(function (h) { return h.trim(); });
                if (headers[headers.length - 1] === '') headers.pop();

                // Parse body rows
                var dataRows = [];
                for (var i = 1; i < lines.length; i++) {
                    var cols = lines[i].split(',');
                    if (cols[cols.length - 1].trim() === '') cols.pop();
                    dataRows.push(cols);
                }

                // Sort DESCENDING by date column (index 1)
                dataRows.sort(function (a, b) {
                    return new Date((b[1] || '').trim()) - new Date((a[1] || '').trim());
                });

                // Col widths — same as Alert Analysis
                var colWidths = headers.map(function (h, ci) {
                    if (ci === 1) return 170;
                    if (ci === 0) return 90;
                    if (ci === 2) return 140;
                    return 90;
                });
                var totalW = colWidths.reduce(function (a, b) { return a + b; }, 0);

                var colGroup = '<colgroup>' +
                    colWidths.map(function (w) {
                        return '<col style="width:' + w + 'px;min-width:' + w + 'px">';
                    }).join('') + '</colgroup>';

                var thStyle = [
                    'background:#1e3a5f', 'color:#fff', 'padding:9px 10px',
                    'font-size:10px', 'font-weight:700', 'letter-spacing:.06em',
                    'text-transform:uppercase', 'white-space:normal', 'overflow:hidden',
                    'text-overflow:ellipsis', 'max-width:140px', 'word-break:break-word',
                    'border-right:1px solid #2d5a8e', 'border-bottom:2px solid #0077cc',
                    'text-align:left'
                ].join(';');

                var thead = '<thead><tr>' +
                    headers.map(function (h) {
                        var label = h.replace(r.assetNo, '');
                        return '<th style="' + thStyle + '" title="' + alrtDbgEsc(label.trim()) + '">' +
                            alrtDbgEsc(label) + '</th>';
                    }).join('') + '</tr></thead>';

                var tbody = '<tbody>' +
                    dataRows.map(function (cols, ri) {
                        return '<tr style="background:' + (ri % 2 === 0 ? '#fff' : '#f8fafc') + '">' +
                            cols.map(function (col, ci) {
                                var val = col.trim();
                                var vLow = val.toLowerCase();
                                var tdSt = 'padding:7px 10px;border-bottom:1px solid #e5edf5;border-right:1px solid #f1f5f9;font-size:11px;white-space:nowrap;';
                                var cell = '';
                                if (vLow === 'pickup') {
                                    cell = '<span style="display:inline-block;padding:3px 10px;border-radius:4px;font-size:11px;font-weight:700;background:#16a34a;color:#fff;">Pickup</span>';
                                } else if (vLow === 'drop') {
                                    cell = '<span style="display:inline-block;padding:3px 10px;border-radius:4px;font-size:11px;font-weight:700;background:#f59e0b;color:#fff;">DROP</span>';
                                } else {
                                    if (ci >= 3) {
                                        var num = parseFloat(val);
                                        if (!isNaN(num)) {
                                            tdSt += num === 0
                                                ? 'color:#94a3b8;font-family:monospace;'
                                                : 'font-family:monospace;font-weight:500;color:#1e293b;';
                                        }
                                    } else if (ci === 1) {
                                        tdSt += 'font-family:monospace;font-size:10px;color:#475569;';
                                    } else if (ci === 0 || ci === 2) {
                                        tdSt += 'color:#6b7280;font-size:10px;';
                                    }
                                    cell = alrtDbgEsc(val);
                                }
                                return '<td style="' + tdSt + '">' + cell + '</td>';
                            }).join('') + '</tr>';
                    }).join('') + '</tbody>';

                var infoBar =
                    '<div style="font-size:11px;color:#64748b;margin-bottom:8px;padding:4px 0;">' +
                    '<i class="fas fa-satellite-dish" style="margin-right:4px;color:#0077cc"></i>' +
                    'Asset: <b>' + alrtDbgEsc(r.assetNo) + '</b>' +
                    ' &nbsp;|&nbsp; Station: <b>' + alrtDbgEsc(r.station) + '</b>' +
                    ' &nbsp;|&nbsp; <b>' + dataRows.length + '</b> records' +
                    ' &nbsp;|&nbsp; <span style="color:#16a34a;font-weight:600">' +
                    '<i class="fas fa-sort-amount-down" style="margin-right:3px"></i>Latest first</span>' +
                    '</div>';

                var html = infoBar +
                    '<div class="alrt-dbg-tbl-wrap">' +
                    '<div class="alrt-dbg-tbl-head" id="alrtDbgTeleHeaderTable">' +
                    '<table style="width:' + totalW + 'px;border-collapse:collapse;table-layout:fixed;">' +
                    colGroup + thead + '</table></div>' +
                    '<div class="alrt-dbg-tbl-body" id="alrtDbgTeleBodyScroll"' +
                    ' onscroll="alrtDbgSyncScroll(this,\'alrtDbgTeleHeaderTable\')">' +
                    '<table style="width:' + totalW + 'px;border-collapse:collapse;table-layout:fixed;">' +
                    colGroup + tbody + '</table></div></div>';

                document.getElementById(cid).innerHTML = html;

                // Expand if already fullscreen
                var ov = document.getElementById('alrtDebugOverlay');
                if (ov && ov.classList.contains('fullscreen')) {
                    var tb = document.getElementById('alrtDbgTeleBodyScroll');
                    if (tb) tb.style.maxHeight = (window.innerHeight - 240) + 'px';
                }
            },
            error: function (xhr) {
                document.getElementById(cid).innerHTML =
                    '<div class="alrt-dbg-error"><i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>' +
                    'Failed to load telemetry data (HTTP ' + xhr.status + ').</div>';
            }
        });
    }

    // ════════════════════════════════════════════════════════════
    //  TAB 2 — MQTT GRAPH
    //  Endpoint: POST /FRS25/AlertLive/GetMQTTHistoryGraphData
    // ════════════════════════════════════════════════════════════
    function alrtDbgLoadMqtt(r) {
        var cid = 'alrtDbgMqttContent';
        var s = alrtDbgDateMinus(r.incDate, 30);
        var e = alrtDbgDatePlus(r.incDate, 30);

        document.getElementById(cid).innerHTML =
            '<div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading MQTT graph…</p></div>';

        $.ajax({
            url: '/FRS25/Alerts/GetMQTTHistoryGraphData',
            type: 'POST',
            data: {
                siteId: r.siteId,
                assetId: r.assetId,
                startDate: s.toISOString(),
                endDate: e.toISOString()
            },
            success: function (csv) {
                if (!csv) {
                    document.getElementById(cid).innerHTML =
                        '<div class="alrt-dbg-empty"><i class="fas fa-chart-line" style="font-size:28px;display:block;margin-bottom:8px;color:#cbd5e1"></i>No MQTT graph data available.</div>';
                    return;
                }
                if (typeof csv !== 'string') csv = JSON.stringify(csv);
                if (csv.trim() === '') {
                    document.getElementById(cid).innerHTML =
                        '<div class="alrt-dbg-empty">No MQTT graph data available.</div>';
                    return;
                }

                // ── Parse CSV same way as Alert Analysis ──────────────
                var lines = csv.trim().split('\n').filter(function (l) { return l.trim() !== ''; });
                if (lines.length < 2) {
                    document.getElementById(cid).innerHTML = '<div class="alrt-dbg-empty">No rows in MQTT data.</div>';
                    return;
                }

                var headers = lines[0].split(',').map(function (h) { return h.trim(); });
                if (headers[headers.length - 1] === '') headers.pop();

                var dataStartIdx = 3; // skip Site Name, Date, Asset Type
                var xValues = [];
                var seriesMap = {};
                headers.slice(dataStartIdx).forEach(function (h) { seriesMap[h] = []; });

                for (var i = 1; i < lines.length; i++) {
                    var cols = lines[i].split(',');
                    if (cols[cols.length - 1].trim() === '') cols.pop();
                    var rawDate = (cols[1] || '').trim();
                    var parts = rawDate.split(' ');
                    var timeLabel = parts.length >= 2 ? parts[1] + (parts[2] ? ' ' + parts[2] : '') : rawDate;
                    xValues.push(timeLabel);
                    headers.slice(dataStartIdx).forEach(function (h, hi) {
                        var val = parseFloat((cols[dataStartIdx + hi] || '').trim());
                        seriesMap[h].push(isNaN(val) ? null : val);
                    });
                }

                // Build ECharts series — dual axis (mA left, V right)
                var colors = ['#4bacc6', '#e74c3c', '#2ecc71', '#f39c12', '#9b59b6', '#1abc9c', '#e67e22', '#3498db', '#e91e63', '#00bcd4', '#ff5722'];
                var series = [];
                var legends = [];
                var laryMax = 0;
                var raryMax = 0;
                var colorIdx = 0;

                headers.slice(dataStartIdx).forEach(function (colName) {
                    var values = seriesMap[colName];
                    var hasV = colName.indexOf('V') > -1;
                    var axisIdx = hasV ? 1 : 0;
                    var colMax = Math.max.apply(null, values.filter(function (v) { return v !== null; }).concat([0]));
                    if (axisIdx === 0 && colMax > laryMax) laryMax = colMax;
                    if (axisIdx === 1 && colMax > raryMax) raryMax = colMax;
                    legends.push(colName);
                    series.push({
                        name: colName, type: 'line', smooth: false, symbol: 'none',
                        connectNulls: true, yAxisIndex: axisIdx,
                        lineStyle: { width: 1.5 },
                        itemStyle: { color: colors[colorIdx % colors.length] },
                        color: colors[colorIdx % colors.length],
                        data: values
                    });
                    colorIdx++;
                });

                // Build container
                document.getElementById(cid).innerHTML =
                    '<div style="padding:4px 0 8px;">' +
                    '<div style="font-size:11px;color:#64748b;margin-bottom:6px;">' +
                    '<i class="fas fa-chart-line" style="margin-right:4px;color:#0077cc"></i>' +
                    'Asset: <b>' + alrtDbgEsc(r.assetNo) + '</b>' +
                    ' &nbsp;|&nbsp; Station: <b>' + alrtDbgEsc(r.station) + '</b>' +
                    ' &nbsp;|&nbsp; ' + xValues.length + ' data points</div>' +
                    '<div id="alrtDbgMqttChart" style="width:100%;height:340px;"></div>' +
                    '<div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap;">' +
                    '<button class="alrt-dbg-filter-btn active" id="alrtMqttBtnAll" onclick="alrtDbgMqttFilter(\'all\')">All Series</button>' +
                    '<button class="alrt-dbg-filter-btn" id="alrtMqttBtnMA" onclick="alrtDbgMqttFilter(\'ma\')"><i class="fas fa-bolt"></i> mA Only</button>' +
                    '<button class="alrt-dbg-filter-btn" id="alrtMqttBtnV" onclick="alrtDbgMqttFilter(\'v\')"><i class="fas fa-wave-square"></i> Voltage Only</button>' +
                    '</div></div>';

                // Init ECharts
                if (_alrtDbgMqttChart) {
                    try { _alrtDbgMqttChart.dispose(); } catch (ex) { }
                    _alrtDbgMqttChart = null;
                }

                function initChart() {
                    var dom = document.getElementById('alrtDbgMqttChart');
                    if (!dom) return;
                    _alrtDbgMqttChart = echarts.init(dom, null, { renderer: 'canvas' });
                    window._alrtDbgMqttSeriesAll = series;
                    _alrtDbgMqttChart.setOption({
                        backgroundColor: 'transparent',
                        tooltip: {
                            trigger: 'axis', confine: true,
                            axisPointer: { type: 'cross', label: { backgroundColor: '#1e293b' } },
                            formatter: function (params) {
                                var html = '<div style="font-size:11px;min-width:180px;"><div style="font-weight:700;color:#1e293b;margin-bottom:5px;padding-bottom:4px;border-bottom:1px solid #e2e8f0">' + params[0].axisValue + '</div>';
                                params.forEach(function (p) {
                                    if (p.value === null) return;
                                    html += '<div style="display:flex;justify-content:space-between;gap:16px;margin:2px 0"><span>' + p.marker + p.seriesName + '</span><span style="font-weight:700;font-family:monospace">' + p.value + '</span></div>';
                                });
                                return html + '</div>';
                            }
                        },
                        legend: { data: legends, type: 'scroll', top: 0, left: 0, right: 40, textStyle: { fontSize: 10, color: '#475569' }, itemWidth: 12, itemHeight: 8 },
                        toolbox: { right: 4, top: 0, feature: { dataZoom: { yAxisIndex: 'none', title: { zoom: 'Zoom', back: 'Undo' } }, restore: { title: 'Restore' }, saveAsImage: { title: 'Save PNG' } } },
                        grid: { top: 50, left: 60, right: 60, bottom: 60, containLabel: false },
                        xAxis: [{ type: 'category', boundaryGap: false, data: xValues, axisLine: { lineStyle: { color: '#d1dce8' } }, axisLabel: { fontSize: 9, color: '#6b7280', rotate: 30, interval: Math.max(0, Math.floor(xValues.length / 12) - 1) }, splitLine: { show: false } }],
                        yAxis: [
                            { type: 'value', name: 'mA', nameTextStyle: { fontSize: 10, color: '#475569' }, min: 0, max: Math.ceil(laryMax * 1.05) || 1500, axisLine: { lineStyle: { color: '#d1dce8' } }, axisLabel: { fontSize: 9, color: '#475569' }, splitLine: { lineStyle: { color: '#f1f5f9', type: 'dashed' } } },
                            { type: 'value', name: 'V', nameTextStyle: { fontSize: 10, color: '#475569' }, min: 0, max: Math.ceil(raryMax * 1.1) || 120, axisLine: { lineStyle: { color: '#d1dce8' } }, axisLabel: { fontSize: 9, color: '#475569' }, splitLine: { show: false } }
                        ],
                        dataZoom: [
                            { type: 'slider', bottom: 4, height: 22, start: 0, end: 100, fillerColor: 'rgba(0,119,204,0.08)', borderColor: '#d1dce8', handleStyle: { color: '#0077cc' }, textStyle: { color: '#6b7280', fontSize: 9 } },
                            { type: 'inside', start: 0, end: 100 }
                        ],
                        color: colors,
                        series: series
                    });
                    setTimeout(function () { if (_alrtDbgMqttChart) _alrtDbgMqttChart.resize(); }, 100);
                }

                if (typeof echarts !== 'undefined') {
                    initChart();
                } else {
                    var sc = document.createElement('script');
                    sc.src = 'https://cdnjs.cloudflare.com/ajax/libs/echarts/5.4.3/echarts.min.js';
                    sc.onload = function () { initChart(); };
                    document.head.appendChild(sc);
                }
            },
            error: function (xhr) {
                document.getElementById(cid).innerHTML =
                    '<div class="alrt-dbg-error"><i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>' +
                    'Failed to load MQTT graph data (HTTP ' + xhr.status + ').</div>';
            }
        });
    }

    function alrtDbgMqttFilter(type) {
        if (!_alrtDbgMqttChart || !window._alrtDbgMqttSeriesAll) return;
        ['All', 'MA', 'V'].forEach(function (k) {
            var btn = document.getElementById('alrtMqttBtn' + k);
            var isActive = (k.toLowerCase() === type || (type === 'all' && k === 'All'));
            if (btn) {
                btn.classList.toggle('active', isActive);
            }
        });
        var filtered = window._alrtDbgMqttSeriesAll.filter(function (s) {
            if (type === 'all') return true;
            var hasV = s.name.indexOf('V') > -1;
            return type === 'v' ? hasV : !hasV;
        });
        _alrtDbgMqttChart.setOption({ series: filtered }, { replaceMerge: ['series'] });
    }

    // ════════════════════════════════════════════════════════════
    //  TAB 3 — DATALOGGER LOG
    //  Endpoint: POST /FRS25/AlertLive/GeDataLoggerJSONData
    // ════════════════════════════════════════════════════════════
    function alrtDbgLoadDatalogger(r) {
        var cid = 'alrtDbgDataloggerContent';
        var s = alrtDbgDateMinus(r.incDate, 30);
        var e = alrtDbgDatePlus(r.incDate, 30);

        document.getElementById(cid).innerHTML =
            '<div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading datalogger log…</p></div>';

        $.ajax({
            url: '/FRS25/Alerts/GeDataLoggerJSONData',
            type: 'POST',
            data: { siteId: r.siteId, assetId: r.assetId, startDate: s.toISOString(), endDate: e.toISOString() },
            success: function (data) {
                if (!data || (Array.isArray(data) && data.length === 0)) {
                    document.getElementById(cid).innerHTML =
                        '<div class="alrt-dbg-empty"><i class="fas fa-database" style="font-size:28px;display:block;margin-bottom:8px;color:#cbd5e1"></i>No datalogger log entries.</div>';
                    return;
                }

                var rows = Array.isArray(data) ? data : (data.logs || data.Logs || data.data || [data]);
                rows.sort(function (a, b) {
                    return new Date(b.Timestamp || b.timestamp || 0) - new Date(a.Timestamp || a.timestamp || 0);
                });

                if (!rows || rows.length === 0) {
                    document.getElementById(cid).innerHTML =
                        '<div class="alrt-dbg-empty">No datalogger log entries.</div>';
                    return;
                }

                var html =
                    '<div style="overflow-x:auto;">' +
                    '<div style="font-size:11px;color:#64748b;margin-bottom:8px;padding:4px 0;">' +
                    '<i class="fas fa-database" style="margin-right:4px;color:#0077cc"></i>' +
                    'Asset: <b>' + alrtDbgEsc(r.assetNo) + '</b>' +
                    ' &nbsp;|&nbsp; Station: <b>' + alrtDbgEsc(r.station) + '</b>' +
                    ' &nbsp;|&nbsp; <b>' + rows.length + '</b> records</div>' +
                    '<style>' +
                    '#alrtDlTable{width:100%;border-collapse:collapse;font-size:12px;}' +
                    '#alrtDlTable thead tr{background:#1a6b64;}' +
                    '#alrtDlTable thead th{padding:10px 12px;text-align:left;font-size:11px;font-weight:700;color:#fff;white-space:nowrap;letter-spacing:.04em;}' +
                    '#alrtDlTable tbody tr{border-bottom:1px solid #e5edf5;transition:background .12s;}' +
                    '#alrtDlTable tbody tr:hover{background:#f0f7ff;}' +
                    '#alrtDlTable tbody td{padding:9px 12px;white-space:nowrap;color:#1e293b;font-size:12px;}' +
                    '.alrt-dl-pickup{background:#16a34a;color:#fff;padding:3px 10px;border-radius:4px;font-size:11px;font-weight:700;display:inline-block;}' +
                    '.alrt-dl-drop{background:#f59e0b;color:#fff;padding:3px 10px;border-radius:4px;font-size:11px;font-weight:700;display:inline-block;}' +
                    '.alrt-dl-other{background:#64748b;color:#fff;padding:3px 10px;border-radius:4px;font-size:11px;font-weight:700;display:inline-block;}' +
                    '</style>' +
                    '<table id="alrtDlTable"><thead><tr>' +
                    '<th>SR No.</th><th>Asset</th><th>Attribute</th><th>Current Value</th><th>Time Stamp</th><th>Update Time</th>' +
                    '</tr></thead><tbody>';

                rows.forEach(function (row) {
                    var rawVal = (row.CurrentValue || row.currentValue || '').toString().trim();
                    var vLow = rawVal.toLowerCase();
                    var badge =
                        vLow === '1' || vLow === 'pickup' ? '<span class="alrt-dl-pickup">Pickup</span>' :
                            vLow === '0' || vLow === 'drop' ? '<span class="alrt-dl-drop">DROP</span>' :
                                rawVal !== '' ? '<span class="alrt-dl-other">' + alrtDbgEsc(rawVal) + '</span>' :
                                    '<span style="color:#94a3b8">—</span>';

                    var updTime = row.CurrentDate || row.currentDate || row.Date || row.date || '';
                    if (updTime && typeof updTime === 'string' && updTime.indexOf('/Date(') > -1) {
                        var ms = parseInt(updTime.replace('/Date(', '').replace(')/', ''));
                        if (!isNaN(ms)) updTime = new Date(ms);
                    }
                    var updFmt = '';
                    if (updTime) {
                        try {
                            var dv = new Date(updTime);
                            if (!isNaN(dv.getTime())) {
                                updFmt = alrtDbgPad2(dv.getDate()) + '/' + alrtDbgPad2(dv.getMonth() + 1) + '/' + dv.getFullYear() +
                                    ' ' + alrtDbgPad2(dv.getHours()) + ':' + alrtDbgPad2(dv.getMinutes()) + ':' + alrtDbgPad2(dv.getSeconds());
                            } else { updFmt = alrtDbgEsc(String(updTime)); }
                        } catch (ex) { updFmt = alrtDbgEsc(String(updTime)); }
                    }

                    html +=
                        '<tr>' +
                        '<td style="font-family:monospace;color:#6b7280">' + alrtDbgEsc(String(row.SrNo || row.srNo || '')) + '</td>' +
                        '<td style="font-weight:600">' + alrtDbgEsc(row.AssetName || row.assetName || '-') + '</td>' +
                        '<td style="color:#475569">' + alrtDbgEsc(row.AttributeName || row.attributeName || '-') + '</td>' +
                        '<td>' + badge + '</td>' +
                        '<td style="font-family:monospace;font-size:11px;color:#475569">' + alrtDbgEsc(String(row.Timestamp || row.timestamp || '')) + '</td>' +
                        '<td style="font-family:monospace;font-size:11px;color:#475569">' + updFmt + '</td>' +
                        '</tr>';
                });

                html += '</tbody></table></div>';
                document.getElementById(cid).innerHTML = html;
            },
            error: function (xhr) {
                document.getElementById(cid).innerHTML =
                    '<div class="alrt-dbg-error"><i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>' +
                    'Failed to load datalogger log (HTTP ' + xhr.status + ').</div>';
            }
        });
    }

    // ════════════════════════════════════════════════════════════
    //  TAB 4 — ALERT JSON
    //  Endpoint: POST /FRS25/AlertLive/GetFRSAlertById
    // ════════════════════════════════════════════════════════════
    function alrtDbgLoadAlertJson(r) {
        var cid = 'alrtDbgAlertJsonContent';
        document.getElementById(cid).innerHTML =
            '<div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading alert JSON…</p></div>';

        $.ajax({
            url: '/FRS25/Alerts/GetFRSAlertById',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ id: r.id }),
            success: function (data) {
                var obj = typeof data === 'string' ? alrtDbgTryJson(data) : data;
                var rawJson = obj.RawJsonData || obj.rawJsonData || null;
                var rstJson = obj.ResetRawJsonData || obj.resetRawJsonData || null;
                var rawObj = rawJson ? alrtDbgTryJson(rawJson) : null;
                var rstObj = rstJson ? alrtDbgTryJson(rstJson) : null;
                var rawStr = rawObj ? JSON.stringify(rawObj, null, 2) : null;
                var rstStr = rstObj ? JSON.stringify(rstObj, null, 2) : null;

                document.getElementById(cid).innerHTML =
                    '<div style="display:flex;flex-direction:column;gap:20px;">' +
                    '<div>' +
                    '<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">' +
                    '<span style="background:#fee2e2;border:1px solid #fca5a5;color:#991b1b;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:3px 10px;border-radius:5px;">' +
                    '<i class="fas fa-bell" style="margin-right:4px"></i>SET — Raw JSON Data</span></div>' +
                    (rawStr
                        ? '<div class="alrt-dbg-json-wrap"><pre>' + alrtDbgHlJson(rawStr) + '</pre></div>'
                        : '<div class="alrt-dbg-empty" style="padding:16px">No RawJsonData available.</div>') +
                    '</div>' +
                    '<div>' +
                    '<div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">' +
                    '<span style="background:#f0fdf4;border:1px solid #86efac;color:#166534;font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:3px 10px;border-radius:5px;">' +
                    '<i class="fas fa-undo" style="margin-right:4px"></i>RESET — Raw JSON Data</span></div>' +
                    (rstStr
                        ? '<div class="alrt-dbg-json-wrap"><pre>' + alrtDbgHlJson(rstStr) + '</pre></div>'
                        : '<div class="alrt-dbg-empty" style="padding:16px">No ResetRawJsonData available.</div>') +
                    '</div></div>';
            },
            error: function (xhr) {
                document.getElementById(cid).innerHTML =
                    '<div class="alrt-dbg-error" style="margin-bottom:10px"><i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>' +
                    'Could not load from server (HTTP ' + xhr.status + '). Showing local row data:</div>' +
                    '<div class="alrt-dbg-json-wrap"><pre>' + alrtDbgHlJson(JSON.stringify(r, null, 2)) + '</pre></div>';
            }
        });
    }

    // ════════════════════════════════════════════════════════════
    //  TAB 5 — DEBUG TPR
    //  Endpoint: POST /FRS25/AlertLive/GetTPRJSONData
    //  Guard: AssetTypeId=1 AND AlertType=Failure only
    // ════════════════════════════════════════════════════════════
    function alrtDbgLoadTpr(r) {
        var cid = 'alrtDbgDebugtprContent';
        var assetTypeId = parseInt(r.assetTypeId || 0);
        var alertType = (r.alertType || '').trim();

        if (assetTypeId !== 1 || alertType !== 'Failure') {
            document.getElementById(cid).innerHTML =
                '<div class="alrt-dbg-empty">' +
                '<i class="fas fa-broadcast-tower" style="font-size:28px;display:block;margin-bottom:10px;color:#cbd5e1"></i>' +
                '<div style="font-weight:600;color:#94a3b8;margin-bottom:6px;">Not Applicable</div>' +
                '<div style="font-size:11px;color:#b0bec5">Debug TPR is only available for<br>' +
                '<b>Asset Type ID = 1</b> and <b>Alert Type = Failure</b>.<br><br>' +
                'Current record: AssetTypeId = <b>' + (r.assetTypeId || '-') + '</b>' +
                ' &nbsp;|&nbsp; Alert Type = <b>' + alrtDbgEsc(alertType) + '</b></div></div>';
            return;
        }

        var s = alrtDbgDateMinus(r.incDate, 30);
        var e = alrtDbgDatePlus(r.incDate, 30);

        document.getElementById(cid).innerHTML =
            '<div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading TPR telemetry data…</p></div>';

        $.ajax({
            url: '/FRS25/Alerts/GetTPRJSONData',
            type: 'POST',
            data: { siteId: r.siteId, assetId: r.assetId, startDate: s.toISOString(), endDate: e.toISOString() },
            success: function (csv) {
                if (!csv) {
                    document.getElementById(cid).innerHTML =
                        '<div class="alrt-dbg-empty"><i class="fas fa-broadcast-tower" style="font-size:28px;display:block;margin-bottom:8px;color:#cbd5e1"></i>No TPR telemetry data available.</div>';
                    return;
                }
                if (typeof csv !== 'string') csv = JSON.stringify(csv);
                if (csv.trim() === '') {
                    document.getElementById(cid).innerHTML = '<div class="alrt-dbg-empty">No TPR telemetry data available.</div>';
                    return;
                }

                var lines = csv.trim().split('\n').filter(function (l) { return l.trim() !== ''; });
                if (lines.length < 2) { document.getElementById(cid).innerHTML = '<div class="alrt-dbg-empty">No rows in TPR data.</div>'; return; }

                var headers = lines[0].split(',').map(function (h) { return h.trim(); });
                if (headers[headers.length - 1] === '') headers.pop();

                var dataRows = [];
                for (var i = 1; i < lines.length; i++) {
                    var cols = lines[i].split(',');
                    if (cols[cols.length - 1].trim() === '') cols.pop();
                    dataRows.push(cols);
                }
                dataRows.sort(function (a, b) {
                    return new Date((b[1] || '').trim()) - new Date((a[1] || '').trim());
                });

                var colWidths = headers.map(function (h, ci) {
                    if (ci === 1) return 165;
                    if (ci === 0 || ci === 2) return 85;
                    return 90;
                });
                var totalW = colWidths.reduce(function (a, b) { return a + b; }, 0);

                var colGroup = '<colgroup>' + colWidths.map(function (w) {
                    return '<col style="width:' + w + 'px;min-width:' + w + 'px">';
                }).join('') + '</colgroup>';

                var thStyle = [
                    'background:#1e3a5f', 'color:#fff', 'padding:9px 10px',
                    'font-size:10px', 'font-weight:700', 'letter-spacing:.06em',
                    'text-transform:uppercase', 'white-space:normal', 'overflow:hidden',
                    'text-overflow:ellipsis', 'max-width:140px', 'word-break:break-word',
                    'border-right:1px solid #2d5a8e', 'border-bottom:2px solid #dc2626',
                    'text-align:left'
                ].join(';');

                var thead = '<thead><tr>' +
                    headers.map(function (h) {
                        return '<th style="' + thStyle + '" title="' + alrtDbgEsc(h.trim()) + '">' + alrtDbgEsc(h) + '</th>';
                    }).join('') + '</tr></thead>';

                var tbody = '<tbody>' +
                    dataRows.map(function (cols, ri) {
                        return '<tr style="background:' + (ri % 2 === 0 ? '#fff' : '#f8fafc') + '">' +
                            cols.map(function (col, ci) {
                                var val = col.trim();
                                var vLow = val.toLowerCase();
                                var tdSt = 'padding:7px 10px;border-bottom:1px solid #e5edf5;border-right:1px solid #f1f5f9;font-size:11px;white-space:nowrap;';
                                var cell = '';
                                if (vLow === 'pickup') {
                                    cell = '<span style="display:inline-block;padding:3px 10px;border-radius:4px;font-size:11px;font-weight:700;background:#16a34a;color:#fff;">Pickup</span>';
                                } else if (vLow === 'drop') {
                                    cell = '<span style="display:inline-block;padding:3px 10px;border-radius:4px;font-size:11px;font-weight:700;background:#f59e0b;color:#fff;">DROP</span>';
                                } else {
                                    if (ci >= 3) { var num = parseFloat(val); if (!isNaN(num)) tdSt += num === 0 ? 'color:#94a3b8;font-family:monospace;' : 'font-family:monospace;font-weight:500;color:#1e293b;'; }
                                    else if (ci === 1) tdSt += 'font-family:monospace;font-size:10px;color:#475569;';
                                    else if (ci === 0 || ci === 2) tdSt += 'color:#6b7280;font-size:10px;';
                                    cell = alrtDbgEsc(val);
                                }
                                return '<td style="' + tdSt + '">' + cell + '</td>';
                            }).join('') + '</tr>';
                    }).join('') + '</tbody>';

                var html =
                    '<div style="font-size:11px;color:#64748b;margin-bottom:8px;padding:4px 0;">' +
                    '<i class="fas fa-broadcast-tower" style="margin-right:4px;color:#0077cc"></i>' +
                    'Asset: <b>' + alrtDbgEsc(r.assetNo) + '</b>' +
                    ' &nbsp;|&nbsp; Station: <b>' + alrtDbgEsc(r.station) + '</b>' +
                    ' &nbsp;|&nbsp; <b>' + dataRows.length + '</b> records' +
                    ' &nbsp;|&nbsp; <span style="color:#16a34a;font-weight:600"><i class="fas fa-sort-amount-down" style="margin-right:3px"></i>Latest first</span>' +
                    ' &nbsp;|&nbsp; <span style="background:#fee2e2;border:1px solid #fca5a5;border-radius:4px;padding:2px 8px;color:#991b1b;font-weight:700;font-size:10px;">TPR · FAILURE</span>' +
                    '</div>' +
                    '<div class="alrt-dbg-tbl-wrap">' +
                    '<div class="alrt-dbg-tbl-head" id="alrtDbgTprHeaderTable">' +
                    '<table style="width:' + totalW + 'px;border-collapse:collapse;table-layout:fixed;">' + colGroup + thead + '</table></div>' +
                    '<div class="alrt-dbg-tbl-body" id="alrtDbgTprBodyScroll" onscroll="alrtDbgSyncScroll(this,\'alrtDbgTprHeaderTable\')">' +
                    '<table style="width:' + totalW + 'px;border-collapse:collapse;table-layout:fixed;">' + colGroup + tbody + '</table></div></div>';

                document.getElementById(cid).innerHTML = html;

                var ov = document.getElementById('alrtDebugOverlay');
                if (ov && ov.classList.contains('fullscreen')) {
                    var tb = document.getElementById('alrtDbgTprBodyScroll');
                    if (tb) tb.style.maxHeight = (window.innerHeight - 240) + 'px';
                }
            },
            error: function (xhr) {
                document.getElementById(cid).innerHTML =
                    '<div class="alrt-dbg-error"><i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>' +
                    'Failed to load TPR telemetry data (HTTP ' + xhr.status + ').</div>';
            }
        });
    }

    // ════════════════════════════════════════════════════════════
    //  TAB 6 — NETWORK
    //  Endpoints: POST /FRS25/AlertLive/GetNetworkNumberList
    //             POST /FRS25/AlertLive/GetNetworkGraphData
    // ════════════════════════════════════════════════════════════
    function alrtDbgLoadNetwork(r) {
        var cid = 'alrtDbgNetworkContent';
        window._alrtDbgNetRow = r;

        document.getElementById(cid).innerHTML =
            '<div style="padding:4px 0;">' +
            '<div style="font-size:11px;color:#64748b;margin-bottom:12px;">' +
            '<i class="fas fa-network-wired" style="margin-right:4px;color:#0077cc"></i>' +
            'Asset: <b>' + alrtDbgEsc(r.assetNo) + '</b> &nbsp;|&nbsp; Station: <b>' + alrtDbgEsc(r.station) + '</b></div>' +

            '<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:16px;' +
            'padding:12px 14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;">' +

            '<div style="display:flex;flex-direction:column;gap:4px;">' +
            '<label style="font-size:10px;font-weight:700;color:#64748b;letter-spacing:.06em;text-transform:uppercase;">Type</label>' +
            '<select id="alrtDbgNetType" onchange="alrtDbgNetTypeChange(this)" ' +
            'style="border:1px solid #d1dce8;border-radius:6px;padding:6px 12px;font-size:12px;color:#1e293b;background:#fff;min-width:120px;cursor:pointer;">' +
            '<option value="">-- Select --</option><option value="A10">A10</option><option value="Modem">Modem</option></select></div>' +

            '<div id="alrtDbgNetProtocolWrap" style="display:none;flex-direction:column;gap:4px;">' +
            '<label style="font-size:10px;font-weight:700;color:#64748b;letter-spacing:.06em;text-transform:uppercase;">Protocol</label>' +
            '<select id="alrtDbgNetProtocol" onchange="alrtDbgNetProtocolChange(this)" ' +
            'style="border:1px solid #d1dce8;border-radius:6px;padding:6px 12px;font-size:12px;color:#1e293b;background:#fff;min-width:120px;cursor:pointer;">' +
            '<option value="">-- Select --</option><option value="TCP">TCP</option><option value="MQTT">MQTT</option></select></div>' +

            '<div id="alrtDbgNetSpinner" style="display:none;align-items:center;gap:6px;font-size:12px;color:#64748b;">' +
            '<i class="fas fa-circle-notch fa-spin" style="color:#0077cc"></i> Loading...</div></div>' +

            '<div id="alrtDbgNetNumberList" style="margin-bottom:16px;"></div>' +
            '<div id="alrtDbgNetGraphArea"></div></div>';
    }

    function alrtDbgNetTypeChange(sel) {
        var wrap = document.getElementById('alrtDbgNetProtocolWrap');
        if (wrap) wrap.style.display = sel.value ? 'flex' : 'none';
        var nl = document.getElementById('alrtDbgNetNumberList');
        var ga = document.getElementById('alrtDbgNetGraphArea');
        if (nl) nl.innerHTML = '';
        if (ga) ga.innerHTML = '';
        var ps = document.getElementById('alrtDbgNetProtocol');
        if (ps) ps.value = '';
    }

    function alrtDbgNetProtocolChange(sel) {
        var protocol = sel.value;
        var typeVal = document.getElementById('alrtDbgNetType') ? document.getElementById('alrtDbgNetType').value : '';
        var r = window._alrtDbgNetRow;
        var nl = document.getElementById('alrtDbgNetNumberList');
        var ga = document.getElementById('alrtDbgNetGraphArea');
        var spinner = document.getElementById('alrtDbgNetSpinner');

        if (ga) ga.innerHTML = '';
        if (nl) nl.innerHTML = '';
        if (!protocol || !typeVal || !r) return;
        if (spinner) spinner.style.display = 'flex';

        $.ajax({
            url: '/FRS25/Alerts/GetNetworkNumberList', type: 'POST',
            data: { siteId: r.siteId, assetId: r.assetId, type: typeVal, protocol: protocol },
            success: function (data) {
                if (spinner) spinner.style.display = 'none';
                var items = Array.isArray(data) ? data : (data.items || data.data || data.list || []);
                if (!items || items.length === 0) {
                    if (nl) nl.innerHTML = '<div class="alrt-dbg-empty" style="padding:20px;">No ' + alrtDbgEsc(typeVal) + ' numbers found for <b>' + alrtDbgEsc(protocol) + '</b>.</div>';
                    return;
                }
                var listHtml = '<div style="margin-bottom:8px;font-size:10px;font-weight:700;color:#64748b;letter-spacing:.08em;text-transform:uppercase;">' +
                    '<i class="fas fa-list" style="margin-right:4px;color:#0077cc"></i>' +
                    alrtDbgEsc(typeVal) + ' Numbers · ' + alrtDbgEsc(protocol) +
                    ' <span style="color:#94a3b8;font-weight:400">(' + items.length + ' found)</span></div>' +
                    '<div style="display:flex;flex-wrap:wrap;gap:8px;">';
                items.forEach(function (item) {
                    var num = typeof item === 'object' ? (item.Number || item.number || item.Name || item.name || item.Id || item.id || JSON.stringify(item)) : String(item);
                    var display = typeof item === 'object' ? (item.DisplayName || item.displayName || num) : num;
                    var cid2 = typeof item === 'object' ? (item.ClusterId || '') : '';
                    listHtml +=
                        '<div style="display:inline-flex;align-items:center;background:#fff;border:1px solid #d1dce8;border-radius:7px;' +
                        'padding:7px 14px;cursor:pointer;font-size:12px;font-weight:600;color:#1e293b;transition:all .15s;" ' +
                        'onclick="alrtDbgNetNumberClick(this,\'' + alrtDbgEsc(String(num)) + '\',\'' + alrtDbgEsc(typeVal) + '\',\'' + alrtDbgEsc(protocol) + '\',\'' + alrtDbgEsc(String(cid2)) + '\')">' +
                        alrtDbgEsc(String(display)) + '</div>';
                });
                listHtml += '</div>';
                if (nl) nl.innerHTML = listHtml;
            },
            error: function (xhr) {
                if (spinner) spinner.style.display = 'none';
                if (nl) nl.innerHTML = '<div class="alrt-dbg-error"><i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>Failed to load numbers (HTTP ' + xhr.status + ').</div>';
            }
        });
    }

    function alrtDbgNetNumberClick(cardEl, number, type, protocol, clusterId) {
        var ga = document.getElementById('alrtDbgNetGraphArea');
        var r = window._alrtDbgNetRow;
        if (!ga || !r) return;

        document.querySelectorAll('#alrtDbgNetNumberList div[onclick]').forEach(function (c) {
            c.style.background = '#fff'; c.style.borderColor = '#d1dce8'; c.style.color = '#1e293b'; c.style.boxShadow = '';
        });
        cardEl.style.background = '#0077cc'; cardEl.style.borderColor = '#0077cc'; cardEl.style.color = '#fff'; cardEl.style.boxShadow = '0 2px 8px rgba(0,119,204,.3)';

