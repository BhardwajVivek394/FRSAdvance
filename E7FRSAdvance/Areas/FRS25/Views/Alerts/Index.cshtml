    function fnGetAlertCounts() {
        var m = { SearchCriteria: {}, Pager: {} };
        m.SearchCriteria.ZoneIds = alrtGetValues('zone');
        m.SearchCriteria.DivisionIds = alrtGetValues('division');
        m.SearchCriteria.SiteIds = alrtGetValues('site');
        m.SearchCriteria.FromDate = $('#fltFrom').val() || null;
        m.SearchCriteria.ToDate = $('#fltTo').val() || null;
        $.ajax({
            url: '/FRS25/Alerts/GetAlertCounts',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(m),
            success: function (data) {
                var f = data.failCount || 0;
                var p = data.predictiveCount || 0;
                var t = f + p;
                $('#tabBadgeAll').text(t);
                $('#tabBadgeFailure').text(f);
                $('#tabBadgePredictive').text(p);
                $('#statValFailure').text(f);
                $('#statValPredictive').text(p);
                $('#statFailurePending').text(data.failurePending || 0);
                $('#statFailureCleared').text(data.failureCleared || 0);
                $('#statPredictivePending').text(data.predictivePending || 0);
                $('#statPredictiveCleared').text(data.predictiveCleared || 0);

                // Cleared Today tile  ← ADD THESE 3 LINES
                $('#statValCleared').text(data.clearedToday || 0);
                $('#statClearedTrue').text(data.trueCount || 0);
                $('#statClearedPTFM').text(data.ptfmCount || 0);
            }
        });
