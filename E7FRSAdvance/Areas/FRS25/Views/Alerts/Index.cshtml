    function alrtToggleExportMenu(e) {
        e.stopPropagation();
        var menu = document.getElementById('alrtExportMenu');
        if (!menu) return;
        var isOpen = menu.style.display === 'block';
        // Close all other dropdowns first
        document.querySelectorAll('#alrtExportMenu').forEach(function (m) { m.style.display = 'none'; });
        menu.style.display = isOpen ? 'none' : 'block';
    }

    // Close export menu when clicking outside
    document.addEventListener('click', function (e) {
        var wrap = document.getElementById('alrtExportWrap');
        var menu = document.getElementById('alrtExportMenu');
        if (menu && wrap && !wrap.contains(e.target)) {
            menu.style.display = 'none';
        }
    });

    function alrtExportAlerts(format) {
        // Close the dropdown menu
        var menu = document.getElementById('alrtExportMenu');
        if (menu) menu.style.display = 'none';

        if (typeof jQuery === 'undefined') {
            alert('jQuery not loaded. Cannot export.');
            return;
        }

        var btn = document.getElementById('alrtExportBtn');
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Exporting\u2026';
        }

        // Build same params as fnGetAlertList
        var m = { SearchCriteria: {}, Pager: {} };
        var fltStatusEl = document.getElementById('fltStatus');
        var fltAssetEl = document.getElementById('fltAssetType');
        var fltFromEl = document.getElementById('fltFrom');
        var fltToEl = document.getElementById('fltTo');
        var fltStatusVal = fltStatusEl ? fltStatusEl.value : '';
        m.SearchCriteria.AlertStatus = (fltStatusVal !== '' && fltStatusVal != null) ? parseInt(fltStatusVal) : 0;
        m.SearchCriteria.ZoneIds = alrtGetValues('zone');
        m.SearchCriteria.DivisionIds = alrtGetValues('division');
        m.SearchCriteria.SiteIds = alrtGetValues('site');
        var alertTypeMap = { 'Predictive': 1, 'Failure': 2 };
        var alertTypeVal = alertTypeMap[alrtCurrentFilter];
        m.SearchCriteria.AlertTypeId = (alrtCurrentFilter !== 'all' && alertTypeVal != null) ? alertTypeVal : 0;
        var assetTypeVal = fltAssetEl ? fltAssetEl.value : '';
        m.SearchCriteria.AssetTypeIds = assetTypeVal ? [assetTypeVal] : [];
        m.SearchCriteria.FromDate = fltFromEl ? (fltFromEl.value || null) : null;
        m.SearchCriteria.ToDate = fltToEl ? (fltToEl.value || null) : null;
        m.Pager.Skip = 0;
        m.Pager.PageSize = 99999;

        $.ajax({
            url: '/FRS25/Alerts/GetAlertList',
            type: 'POST',
            contentType: 'application/x-www-form-urlencoded',
            data: $.param(m),
            dataType: 'html',
            success: function (html) {
                // Parse HTML and extract table rows
                var $parsed = $('<div>').html(html);
                var headers = [
                    'Type', 'Asset', 'Station', 'Division', 'Zone',
                    'Cause Code', 'Incidence Time', 'Duration',
                    'Status', 'Feedback', 'Maintainer', 'Role', 'Mobile'
                ];
                var dataRows = [];

                $parsed.find('.alrt-table tbody tr').each(function () {
                    var $tds = $(this).find('td');
                    var row = [];
                    row.push($tds.eq(0).find('.alrt-type-badge').text().trim().replace(/\s+/g, ' '));

                    var assetInfo = $tds.eq(1);
                    row.push(assetInfo.find('.alrt-asset-name').text().trim());
                    var locText = assetInfo.find('.alrt-asset-loc').text().trim().replace(/\s+/g, ' ');
                    var locParts = locText.split('•').map(function (s) { return s.trim(); });
                    row.push(locParts[0] || '');  // station
                    row.push(locParts[1] || '');  // division
                    row.push(locParts[2] || '');  // zone
                    row.push(assetInfo.find('.alrt-cause-code').text().trim());

                    row.push($tds.eq(2).find('.alrt-time-main').text().trim());
                    row.push($tds.eq(3).text().trim().replace(/\s+/g, ' '));
                    row.push($tds.eq(4).find('.alrt-status').text().trim().replace(/\s+/g, ' '));
                    row.push($tds.eq(5).text().trim());
                    row.push($tds.eq(6).find('.alrt-maint-name').text().trim());
                    row.push($tds.eq(6).find('.alrt-maint-role').text().trim());
                    row.push($tds.eq(6).find('.alrt-maint-mob').text().trim());
                    dataRows.push(row);
                });

                if (dataRows.length === 0) {
                    alrtToast('warning', 'No Data', 'No alerts to export for the current filters.');
                    alrtResetExportBtn(btn);
                    return;
                }

                var now = new Date();
                var pad = function (n) { return n < 10 ? '0' + n : '' + n; };
                var ts = now.getFullYear() + pad(now.getMonth() + 1) + pad(now.getDate()) +
                    '_' + pad(now.getHours()) + pad(now.getMinutes());

                if (format === 'excel') {
                    alrtExportToExcel(headers, dataRows, 'Alerts_' + ts);
                } else {
                    alrtExportToCsv(headers, dataRows, 'Alerts_' + ts + '.csv');
                }

                alrtToast('success', 'Export Complete',
                    dataRows.length + ' alerts exported as ' + format.toUpperCase() + '.');
                alrtResetExportBtn(btn);
            },
            error: function () {
                alrtToast('error', 'Export Failed', 'Could not export alerts. Please try again.');
                alrtResetExportBtn(btn);
            }
        });
    }

    // ── CSV Export ────────────────────────────────────────────────
    function alrtExportToCsv(headers, rows, fileName) {
        var allRows = [headers].concat(rows);
        var csv = allRows.map(function (row) {
            return row.map(function (cell) {
                var val = (cell || '').toString().replace(/"/g, '""');
                return '"' + val + '"';
            }).join(',');
        }).join('\r\n');

        var bom = '\uFEFF'; // UTF-8 BOM for Excel compatibility
        var blob = new Blob([bom + csv], { type: 'text/csv;charset=utf-8;' });
        alrtDownloadBlob(blob, fileName);
    }

    // ── Excel Export (native .xlsx via SheetJS) ───────────────────
    function alrtExportToExcel(headers, rows, fileName) {
        function doExcel() {
            var XLSX = window.XLSX;
            var wsData = [headers].concat(rows);

            var wb = XLSX.utils.book_new();
            var ws = XLSX.utils.aoa_to_sheet(wsData);

            // ── Column widths ──────────────────────────────────────
            var colWidths = headers.map(function (h, i) {
                var max = h.length;
                rows.forEach(function (r) {
                    var len = (r[i] || '').toString().length;
                    if (len > max) max = len;
                });
                return { wch: Math.min(max + 2, 40) };
            });
            ws['!cols'] = colWidths;

            // ── Style header row (bold + background) ───────────────
            var range = XLSX.utils.decode_range(ws['!ref']);
            for (var C = range.s.c; C <= range.e.c; C++) {
                var cellAddr = XLSX.utils.encode_cell({ r: 0, c: C });
                if (!ws[cellAddr]) continue;
                ws[cellAddr].s = {
                    font: { bold: true, color: { rgb: 'FFFFFF' } },
                    fill: { fgColor: { rgb: '0077CC' } },
                    alignment: { horizontal: 'center', vertical: 'center', wrapText: true },
                    border: {
                        bottom: { style: 'thin', color: { rgb: 'CCCCCC' } },
                        right: { style: 'thin', color: { rgb: 'CCCCCC' } }
                    }
                };
            }

            // ── Alternate row colours ──────────────────────────────
            for (var R = 1; R <= range.e.r; R++) {
                var fillColor = R % 2 === 0 ? 'F0F7FF' : 'FFFFFF';
                for (var CC = range.s.c; CC <= range.e.c; CC++) {
                    var ca = XLSX.utils.encode_cell({ r: R, c: CC });
                    if (!ws[ca]) ws[ca] = { t: 's', v: '' };
                    ws[ca].s = {
                        fill: { fgColor: { rgb: fillColor } },
                        alignment: { vertical: 'center', wrapText: false },
                        border: {
                            bottom: { style: 'thin', color: { rgb: 'E2E8F0' } },
                            right: { style: 'thin', color: { rgb: 'E2E8F0' } }
                        }
                    };
                }
            }

            // ── Freeze top row ─────────────────────────────────────
            ws['!freeze'] = { xSplit: 0, ySplit: 1 };

            XLSX.utils.book_append_sheet(wb, ws, 'Alerts');
            XLSX.writeFile(wb, fileName + '.xlsx');
        }

        // Load SheetJS if not already loaded
        if (typeof window.XLSX !== 'undefined') {
            doExcel();
        } else {
            var script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
            script.onload = function () { doExcel(); };
            script.onerror = function () {
                alrtToast('error', 'Library Error', 'Could not load Excel library. Falling back to CSV.');
                alrtExportToCsv(
                    headers.length ? headers : [],
                    typeof rows !== 'undefined' ? rows : [],
                    fileName + '.csv'
                );
            };
            document.head.appendChild(script);
        }
    }

    // ── Trigger browser download ──────────────────────────────────
    function alrtDownloadBlob(blob, fileName) {
        var url = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.href = url;
        link.download = fileName;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
    }

    function alrtResetExportBtn(btn) {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-download"></i> Export <i class="fas fa-chevron-down" style="font-size:9px;margin-left:3px;"></i>';
        }
    }

    // ============================================================
    // ALERT EVENTS WEBSOCKET
    // Single site  → ws://proxy.energy7.org:8081/subscribe/alertEvents/{siteId}
    // No/multi site → ws://proxy.energy7.org:8081/subscribe/alertEvents
    // ============================================================

    function alrtConnectAlertWS() {
        var S = window._alertWsState;

        S.destroyed = false;
        if (S.reconnTimer) { clearTimeout(S.reconnTimer); S.reconnTimer = null; }

        // ── Build URL: single site gets filtered endpoint, multi/none gets all ──
        var siteIds = alrtGetValues('site');
        var newUrl = (siteIds.length === 1)
            ? ALERT_WS_BASE + '/' + siteIds[0]
            : ALERT_WS_BASE;

        // ── Append auth token when on HTTPS (same pattern as telemetrylive.js) ──
        if (isSecure && ALERT_WS_CONFIG.WebSocketAuthToken) {
            var sep = newUrl.indexOf('?') >= 0 ? '&' : '?';
            newUrl = newUrl + sep + 'token=' + encodeURIComponent(ALERT_WS_CONFIG.WebSocketAuthToken);
        }

        // ── Already on the right URL — do nothing ──
        if (S.ws && S.ws.readyState === WebSocket.OPEN && S.url === newUrl) {
            console.log('[AlertWS] Already connected to', newUrl);
            return;
        }

        // ── Cleanly tear down existing socket ──
        S.destroyed = true;
        if (S.ws) {
            S.ws.onclose = null;
            S.ws.onerror = null;
            try { S.ws.close(); } catch (e) { }
            S.ws = null;
        }
        S.destroyed = false;
        S.url = newUrl;

        console.log('[AlertWS] Connecting to:', newUrl);

        try {
            S.ws = new WebSocket(newUrl);

            S.ws.onopen = function () {
                S.reconnDelay = 3000;
                console.log('[AlertWS] Connected:', newUrl);
            };

            S.ws.onmessage = function (event) {
                alrtHandleAlertWsMessage(event.data);
            };

            S.ws.onerror = function () {
                console.warn('[AlertWS] Connection error on', newUrl);
            };

            S.ws.onclose = function () {
                S.ws = null;
                if (!S.destroyed) {
                    console.log('[AlertWS] Closed — reconnecting in ' + (S.reconnDelay / 1000) + 's');
                    S.reconnTimer = setTimeout(alrtConnectAlertWS, S.reconnDelay);
                    S.reconnDelay = Math.min(S.reconnDelay * 2, S.maxDelay);
                }
            };
        } catch (e) {
            console.error('[AlertWS] Could not create WebSocket:', e);
        }
    }
    function alrtHandleAlertWsMessage(raw) {
        var S = window._alertWsState;
        var batch;
        try { batch = (typeof raw === 'string') ? JSON.parse(raw) : raw; }
        catch (e) { console.warn('[AlertWS] JSON parse error:', e.message); return; }

        // Unwrap Batch envelope or handle plain message
        var messages = [];
        if (batch && batch.MessageType === 'Batch' && Array.isArray(batch.Messages)) {
            messages = batch.Messages;
        } else if (Array.isArray(batch)) {
            messages = batch;
        } else if (batch && batch.SiteId !== undefined) {
            messages = [batch];
        }

        var shouldRefresh = false;
        messages.forEach(function (msgRaw) {
            var msg;
            try { msg = (typeof msgRaw === 'string') ? JSON.parse(msgRaw) : msgRaw; }
            catch (e) { return; }

            if (!msg || msg.SiteId === undefined) return;

            // Check if this SiteId is in scope for the current filter
            var sel = alrtGetValues('site');
            var matches = (sel.length === 0) ||
                (sel.indexOf(String(msg.SiteId)) > -1) ||
                (sel.indexOf(parseInt(msg.SiteId)) > -1);

            if (matches) {
                console.log('[AlertWS] Event — SiteId=' + msg.SiteId +
                    ' | Asset=' + (msg.AssetName || '') +
                    ' | Action=' + (msg.AlertAction || '') +
                    ' | Type=' + (msg.AlertType || ''));
                shouldRefresh = true;
            }
        });

        if (shouldRefresh) {
            if (S.refreshTimer) clearTimeout(S.refreshTimer);
            S.refreshTimer = setTimeout(function () {
                console.log('[AlertWS] Refreshing alert list…');
                fnGetAlertList(window._alertCurrentSkip || 0);
                fnGetAlertCounts();
            }, 800);
        }
    }

    function alrtLoadEscalation(alertId, station, cause) {
        // Update sidebar header info
        var infoEl = document.querySelector('.alrt-esc-info');
        if (infoEl) {
            infoEl.innerHTML = 'Alert: <strong>' + (cause || '#' + alertId) + '</strong>'
                + (station ? ' &bull; ' + station : '');
        }

        // Show loading state in timeline
        var tlEl = document.querySelector('.alrt-timeline');
        if (tlEl) {
            tlEl.innerHTML =
                '<div style="text-align:center;padding:20px;color:#94a3b8;font-size:12px;">' +
                '<i class="fas fa-circle-notch fa-spin" style="color:#4f46e5;font-size:18px;display:block;margin-bottom:8px;"></i>' +
                'Loading escalation data…</div>';
        }

        $.ajax({
            url: '/FRS25/Alerts/GetNotificationDetail',
            type: 'GET',
            data: { frsAlertId: alertId },
            dataType: 'json',
            success: function (data) {
                alrtRenderEscalationTimeline(data);
            },
            error: function () {
                if (tlEl) {
                    tlEl.innerHTML =
                        '<div style="text-align:center;padding:16px;color:var(--failure);font-size:12px;">' +
                        '<i class="fas fa-exclamation-circle" style="margin-right:6px;"></i>' +
                        'Failed to load escalation data.</div>';
                }
            }
        });
    }

    function alrtRenderEscalationTimeline(data) {
        var tlEl = document.getElementById('alrtTimeline')
            || document.querySelector('.alrt-timeline');
        if (!tlEl) return;

        // The CSS now drives the layout (flex inside card body).
        tlEl.style.minHeight = '';
        tlEl.style.maxHeight = '';
        tlEl.style.overflowY = '';
        tlEl.style.overflowX = '';
        tlEl.style.paddingRight = '';

        var normalized = Array.isArray(data) ? data : (data ? [data] : []);

        if (normalized.length === 0) {
            tlEl.innerHTML =
                '<div class="alrt-tl-empty">' +
                '<i class="fas fa-bell-slash"></i>' +
                '<div>No notifications sent yet.</div>' +
                '</div>';
            var oldSummary = document.querySelector('.alrt-esc-reminder-summary');
            if (oldSummary) oldSummary.remove();
            // also clear any reminder popup left over
            var oldPopup = document.getElementById('alrtReminderPopup');
            if (oldPopup) oldPopup.remove();
            return;
        }

        // Sort ASC by timestamp so escalation reads top → bottom
        normalized.sort(function (a, b) {
            return alrtEscParseTime(a.Timestamp || a.timestamp || 0).getTime()
                - alrtEscParseTime(b.Timestamp || b.timestamp || 0).getTime();
        });

        // ── Filter out ENERGY7 CONTROL up-front, so reminder grouping works
        //    on the same set we render. ──
        var filtered = normalized.filter(function (item) {
            var role = (item.UserClassName || item.userClassName
                || item.Role || item.role || '').toString().trim();
            return role !== 'ENERGY7 CONTROL';
        });

        // ── Group reminders under their parent notification ──
        // Scope is the FrsAlertId on each record: reminders only attach to
        // a parent that belongs to the SAME alert. Within an alert, the
        // parent is matched by Role + PersonName + Phone.
        //
        // The API call is already filtered by frsAlertId, so in practice
        // every record shares the same alert id — but we still key on it
        // defensively so reminders can never leak across alerts if the
        // response ever contains more than one.
        var groups = [];          // ordered list of parent items rendered in timeline
        var parentByKey = {};     // key -> reference to group object

        filtered.forEach(function (item) {
            var msg = item.Message || item.message || '';
            var isReminder = /(^|\s)Reminder\b/i.test(msg);

            var alertId = (item.FrsAlertId || item.frsAlertId
                || item.AlertId || item.alertId || '').toString().trim();

            var role = (item.UserClassName || item.userClassName
                || item.Role || item.role || '').toString().trim();
            var personName = (item.PersonName || item.personName
                || item.UserName || item.userName
                || item.Name || item.name || '').toString().trim();
            var rawPhone = item.PhoneNumber || item.phoneNumber
                || item.Mobile || item.mobile || '';
            var phoneKey = String(rawPhone || '').replace(/\D/g, '');

            // FrsAlertId comes first in the key so reminders cannot bind to
            // a parent from a different alert, even if Role+Person+Phone match.
            var key = (alertId + '|' + role + '|' + personName + '|' + phoneKey)
                .toLowerCase();

            if (isReminder && parentByKey[key]) {
                // attach to parent (same alert + same person)
                parentByKey[key].reminders.push(item);
            } else {
                // start a new group (either a fresh notification, or a reminder
                // with no preceding parent in this alert — render it standalone)
                var g = {
                    parent: item,
                    reminders: [],
                    isOrphanReminder: isReminder // true only if no parent existed
                };
                groups.push(g);
                // Only non-reminder entries become the anchor for future reminders
                if (!isReminder) {
                    parentByKey[key] = g;
                }
            }
        });

        if (groups.length === 0) {
            tlEl.innerHTML =
                '<div class="alrt-tl-empty">' +
                '<i class="fas fa-bell-slash"></i>' +
                '<div>No notifications sent yet.</div>' +
                '</div>';
            var oldSummary2 = document.querySelector('.alrt-esc-reminder-summary');
            if (oldSummary2) oldSummary2.remove();
            return;
        }

        var html = '';
        var totalReminderCount = 0;
        var lastIdx = groups.length - 1;

        // Store reminder data globally so popup can read it on demand.
        window.__alrtReminderStore = {};

        groups.forEach(function (g, i) {
            var item = g.parent;
            var msg = item.Message || item.message || '';
            var isOrphan = g.isOrphanReminder;

            // Status: last group = current stage, earlier = done.
            var statusCls = (i === lastIdx) ? 'tl-current' : 'tl-done';
            if (isOrphan) statusCls += ' tl-reminder';

            // Role label from UserClassName — no fabricated names
            var role = (item.UserClassName || item.userClassName
                || item.Role || item.role || '').toString().trim();

            if (!role) role = 'Level ' + (i + 1);
            role = role.replace(/\/+$/, '');

            var roleLabel = role + (
                role.toLowerCase().indexOf('notif') === -1
                    ? ' Notified'
                    : ''
            );

            // PersonName — display under the role
            var personName = (item.PersonName || item.personName
                || item.UserName || item.userName
                || item.Name || item.name || '').toString().trim();

            // Phone — show full number (operations contacts, no privacy masking)
            var rawPhone = item.PhoneNumber || item.phoneNumber
                || item.Mobile || item.mobile || '';
            var phoneDisplay = String(rawPhone || '').replace(/\D/g, '');

            // Timestamp DD/MM/YYYY HH:MM:SS
            var timeFmt = alrtEscFormatTime(item.Timestamp || item.timestamp || '');

            // Badges
            var badges = '';
            if (isOrphan) {
                badges += '<span class="alrt-tl-badge bdg-reminder">' +
                    '<i class="fas fa-bell"></i> Reminder</span>';
            }

            // Reminder-count badge (only when there are attached reminders)
            var reminderCount = g.reminders.length;
            if (reminderCount > 0) {
                totalReminderCount += reminderCount;
                var storeKey = 'g_' + i;
                window.__alrtReminderStore[storeKey] = g.reminders;

                badges +=
                    '<span class="alrt-tl-reminder-count" ' +
                    'data-store-key="' + storeKey + '" ' +
                    'data-role="' + alrtEsc(roleLabel) + '" ' +
                    'data-person="' + alrtEsc(personName) + '" ' +
                    'onmouseenter="alrtShowReminderPopup(this)" ' +
                    'onmouseleave="alrtHideReminderPopupDelayed()" ' +
                    'onclick="alrtToggleReminderPopup(this, event)" ' +
                    'title="Click to view all reminders">' +
                    '<i class="fas fa-bell"></i> ' + reminderCount +
                    ' reminder' + (reminderCount === 1 ? '' : 's') +
                    '</span>';
            }

            // Collapsible message
            var msgBlock = '';
            if (msg) {
                var needsToggle = msg.length > 80 || (msg.match(/\n/g) || []).length > 1;
                var msgId = 'esc_msg_' + i + '_' + Math.random().toString(36).slice(2, 7);
                if (needsToggle) {
                    msgBlock =
                        '<div class="alrt-tl-msg" id="' + msgId + '">' +
                        alrtEsc(msg) +
                        '</div>' +
                        '<button class="alrt-tl-msg-toggle" type="button" ' +
                        'onclick="alrtToggleEscMsg(\'' + msgId + '\', this)">' +
                        '<i class="fas fa-chevron-down"></i> Show full message' +
                        '</button>';
                } else {
                    msgBlock =
                        '<div class="alrt-tl-msg expanded" style="max-height:none;">' +
                        alrtEsc(msg) +
                        '</div>';
                }
            }

            // PersonName block — rendered under the role/header
            var personBlock = personName
                ? '<div class="alrt-tl-person"><i class="fas fa-user"></i>' +
                alrtEsc(personName) + '</div>'
                : '';

            html +=
                '<div class="alrt-tl-item ' + statusCls + '">' +
                '<div class="alrt-tl-dot"></div>' +
                '<div class="alrt-tl-content">' +
                '<div class="alrt-tl-hdr">' +
                '<span class="alrt-tl-role">' + alrtEsc(roleLabel) + '</span>' +
                '<span class="alrt-tl-badges">' + badges +
                (timeFmt ? '<span class="alrt-tl-time">' + alrtEsc(timeFmt) + '</span>' : '') +
                '</span>' +
                '</div>' +
                personBlock +
                (phoneDisplay
                    ? '<div class="alrt-tl-mob"><i class="fas fa-phone"></i>' + alrtEsc(phoneDisplay) + '</div>'
                    : '') +
                msgBlock +
                '</div>' +
                '</div>';
        });

        tlEl.innerHTML = html;

        // Reminder summary — pinned at the bottom of the card body
        var oldSummary = document.querySelector('.alrt-esc-reminder-summary');
        if (oldSummary) oldSummary.remove();

        if (totalReminderCount > 0) {
            var summary = document.createElement('div');
            summary.className = 'alrt-esc-reminder-summary';
            summary.innerHTML =
                '<i class="fas fa-bell"></i>' +
                '<span><strong>' + totalReminderCount + '</strong> reminder' +
                (totalReminderCount === 1 ? '' : 's') + ' issued \u2014 escalation in progress</span>';
            if (tlEl.parentNode) tlEl.parentNode.appendChild(summary);
        }
    }

    // ── Reminder popup: show all reminders for a notification ──
    function alrtBuildReminderPopup(badgeEl) {
        var storeKey = badgeEl.getAttribute('data-store-key');
        var role = badgeEl.getAttribute('data-role') || '';
        var person = badgeEl.getAttribute('data-person') || '';
        var reminders = (window.__alrtReminderStore || {})[storeKey] || [];

        // Remove any existing popup
        var existing = document.getElementById('alrtReminderPopup');
        if (existing) existing.remove();

        var pop = document.createElement('div');
        pop.id = 'alrtReminderPopup';
        pop.className = 'alrt-reminder-popup';
        pop.setAttribute('data-owner', storeKey);

        var headerHtml =
            '<div class="alrt-rpop-hdr">' +
            '<div class="alrt-rpop-title">' +
            '<i class="fas fa-bell"></i> Reminders (' + reminders.length + ')' +
            '</div>' +
            '<button class="alrt-rpop-close" type="button" ' +
            'onclick="alrtHideReminderPopup()" aria-label="Close">' +
            '<i class="fas fa-times"></i></button>' +
            '</div>' +
            '<div class="alrt-rpop-sub">' +
            alrtEsc(role) + (person ? ' &bull; ' + alrtEsc(person) : '') +
            '</div>';

        var listHtml = '<div class="alrt-rpop-list">';
        if (reminders.length === 0) {
            listHtml += '<div class="alrt-rpop-empty">No reminders.</div>';
        } else {
            reminders.forEach(function (r, idx) {
                var t = alrtEscFormatTime(r.Timestamp || r.timestamp || '');
                var m = r.Message || r.message || '';
                listHtml +=
                    '<div class="alrt-rpop-item">' +
                    '<div class="alrt-rpop-item-hdr">' +
                    '<span class="alrt-rpop-num">#' + (idx + 1) + '</span>' +
                    (t ? '<span class="alrt-rpop-time">' + alrtEsc(t) + '</span>' : '') +
                    '</div>' +
                    '<div class="alrt-rpop-msg">' + alrtEsc(m) + '</div>' +
                    '</div>';
            });
        }
        listHtml += '</div>';

        pop.innerHTML = headerHtml + listHtml;

        // Keep popup open if user hovers it
        pop.addEventListener('mouseenter', function () {
            if (window.__alrtReminderPopupHideTimer) {
                clearTimeout(window.__alrtReminderPopupHideTimer);
                window.__alrtReminderPopupHideTimer = null;
            }
        });
        pop.addEventListener('mouseleave', alrtHideReminderPopupDelayed);

        document.body.appendChild(pop);

        // Position near the badge
        var rect = badgeEl.getBoundingClientRect();
        var popRect = pop.getBoundingClientRect();
        var top = rect.bottom + window.scrollY + 6;
        var left = rect.left + window.scrollX;

        // Keep within viewport horizontally
        var maxLeft = window.scrollX + document.documentElement.clientWidth - popRect.width - 12;
        if (left > maxLeft) left = Math.max(window.scrollX + 8, maxLeft);

        // If popup would overflow bottom, flip above the badge
        var viewportBottom = window.scrollY + window.innerHeight;
        if (top + popRect.height > viewportBottom - 8) {
            var flipped = rect.top + window.scrollY - popRect.height - 6;
            if (flipped > window.scrollY + 8) top = flipped;
        }

        pop.style.top = top + 'px';
        pop.style.left = left + 'px';

        return pop;
    }

    function alrtShowReminderPopup(badgeEl) {
        if (window.__alrtReminderPopupHideTimer) {
            clearTimeout(window.__alrtReminderPopupHideTimer);
            window.__alrtReminderPopupHideTimer = null;
        }
        // If popup for this badge is already open, do nothing
        var existing = document.getElementById('alrtReminderPopup');
        if (existing && existing.getAttribute('data-owner') ===
            badgeEl.getAttribute('data-store-key')) {
            return;
        }
        alrtBuildReminderPopup(badgeEl);
    }

    function alrtToggleReminderPopup(badgeEl, ev) {
        if (ev) ev.stopPropagation();
        var existing = document.getElementById('alrtReminderPopup');
        if (existing && existing.getAttribute('data-owner') ===
            badgeEl.getAttribute('data-store-key')) {
            alrtHideReminderPopup();
            return;
        }
        alrtBuildReminderPopup(badgeEl);
        // Mark as "pinned" by click so it won't auto-hide on mouseleave
        var pop = document.getElementById('alrtReminderPopup');
        if (pop) pop.setAttribute('data-pinned', '1');
    }

    function alrtHideReminderPopup() {
        var pop = document.getElementById('alrtReminderPopup');
        if (pop) pop.remove();
    }

    function alrtHideReminderPopupDelayed() {
        if (window.__alrtReminderPopupHideTimer) {
            clearTimeout(window.__alrtReminderPopupHideTimer);
        }
        window.__alrtReminderPopupHideTimer = setTimeout(function () {
            var pop = document.getElementById('alrtReminderPopup');
            if (!pop) return;
            // If pinned by click, don't auto-hide
            if (pop.getAttribute('data-pinned') === '1') return;
            pop.remove();
        }, 250);
    }

    // Close pinned popup when clicking outside it
    document.addEventListener('click', function (e) {
        var pop = document.getElementById('alrtReminderPopup');
        if (!pop) return;
        if (pop.getAttribute('data-pinned') !== '1') return;
        if (pop.contains(e.target)) return;
        // Clicking the badge that opened it is handled by toggle
        if (e.target.closest && e.target.closest('.alrt-tl-reminder-count')) return;
        pop.remove();
    });

    function alrtEsc(s) {
        return String(s || '')
            .replace(/&/g, '&amp;').replace(/</g, '&lt;')
            .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ── Helper: parse timestamp (handles /Date(ticks)/ + ISO + plain) ──
    function alrtEscParseTime(ts) {
        if (!ts) return new Date(0);
        if (ts instanceof Date) return ts;
        var s = String(ts);
        var m = /\/Date\((-?\d+)([+-]\d{4})?\)\//.exec(s);
        if (m) return new Date(parseInt(m[1], 10));
        var d = new Date(s);
        return isNaN(d.getTime()) ? new Date(0) : d;
    }

    // ── Helper: format timestamp as DD/MM/YYYY HH:MM:SS ──
    function alrtEscFormatTime(ts) {
        if (!ts) return '';
        var d = alrtEscParseTime(ts);
        if (d.getTime() === 0) return String(ts);
        var pad = function (n) { return ('0' + n).slice(-2); };
        return pad(d.getDate()) + '/' + pad(d.getMonth() + 1) + '/' + d.getFullYear() +
            ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
    }

    // ── Helper: toggle message expansion ──
    function alrtToggleEscMsg(id, btnEl) {
        var el = document.getElementById(id);
        if (!el) return;
        var expanded = el.classList.toggle('expanded');
        if (btnEl) {
            btnEl.innerHTML = expanded
                ? '<i class="fas fa-chevron-up"></i> Show less'
                : '<i class="fas fa-chevron-down"></i> Show full message';
        }
    }


    function fnShowRemarkImage(remarkId) {
        // Reset state
        $('#remarkImageLoader').show();
        $('#remarkImageWrap').hide();
        $('#remarkImageError').hide();
        $('#remarkImageEl').attr('src', '');
        $('#modalRemarkImage .modal-title').html('<i class="fas fa-image"></i> Remark Image');

        // Open modal immediately — loader shows while fetching
        $('#modalRemarkImage').modal('show');

        $.ajax({
            url: '/FRS25/Alerts/GetFRSRemarkImage/' + remarkId,
            type: 'GET',
            dataType: 'json',
            success: function (response) {
                $('#remarkImageLoader').hide();

                var base64 = response.PhotoEvidenceBase64 || null;
                var fileName = response.PhotoEvidence || '';

                // Update title with actual filename
                $('#modalRemarkImage .modal-title').html(
                    '<i class="fas fa-image"></i> ' + (fileName || 'Remark Image')
                );

                if (base64 && base64.length > 0) {
                    // Detect MIME type from filename extension
                    var mime = 'image/jpeg';
                    if (fileName) {
                        var ext = fileName.split('.').pop().toLowerCase();
                        if (ext === 'png') mime = 'image/png';
                        else if (ext === 'gif') mime = 'image/gif';
                        else if (ext === 'bmp') mime = 'image/bmp';
                        else if (ext === 'webp') mime = 'image/webp';
                    }
                    var src = base64.indexOf('data:image') === 0
                        ? base64
                        : 'data:' + mime + ';base64,' + base64;
                    $('#remarkImageEl').attr('src', src);
                    $('#remarkImageWrap').show();
                } else {
                    $('#remarkImageError').show();
                }
            },
            error: function () {
                $('#remarkImageLoader').hide();
                $('#remarkImageError').show();
            }
        });
    }



