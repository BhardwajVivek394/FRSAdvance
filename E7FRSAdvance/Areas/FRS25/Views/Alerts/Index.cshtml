    function alrtDbgLoadLogs(r) {
        var cid = 'alrtDbgLogsContent';

        // Parse date and hour from incDate (dd/MM/yyyy HH:mm:ss)
        var parts = (r.incDate || '').split(' ');
        var datePart = parts[0] || '';
        var timePart = parts[1] || '';
        var dateSplit = datePart.split('/');
        var hourPart = (timePart.split(':')[0] || '').padStart ? timePart.split(':')[0].padStart(2, '0') : ('0' + timePart.split(':')[0]).slice(-2);

        var folderDate = '';
        if (dateSplit.length === 3) {
            folderDate = dateSplit[2] + '-' + ('0' + dateSplit[1]).slice(-2) + '-' + ('0' + dateSplit[0]).slice(-2);
        }

        document.getElementById(cid).innerHTML =
            '<div style="padding:4px 0;">' +
            '<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:12px 14px;margin-bottom:14px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;font-size:11px;">' +
            '<span><i class="fas fa-map-marker-alt" style="color:#0369a1;margin-right:4px"></i>Station: <b>' + alrtDbgEsc(r.station || '-') + '</b></span>' +
            '<span><i class="fas fa-calendar" style="color:#0369a1;margin-right:4px"></i>Date: <b>' + alrtDbgEsc(folderDate || '-') + '</b></span>' +
            '<span><i class="fas fa-clock" style="color:#0369a1;margin-right:4px"></i>Alert Hour: <b>' + alrtDbgEsc(hourPart + ':00') + '</b></span>' +
            '</div>' +
            '<div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px;">' +
            '<div style="display:flex;flex-direction:column;gap:4px;">' +
            '<label style="font-size:10px;font-weight:700;color:#64748b;letter-spacing:.06em;text-transform:uppercase;">Log Type</label>' +
            '<select id="alrtDbgLogType" onchange="alrtDbgLogsFilterChange()" style="border:1px solid #d1dce8;border-radius:6px;padding:6px 10px;font-size:12px;color:#1e293b;background:#fff;min-width:160px;cursor:pointer;">' +
            '<option value="">-- Loading... --</option></select></div>' +
            '<div style="display:flex;flex-direction:column;gap:4px;padding-top:14px;">' +
            '<label style="display:flex;align-items:center;gap:5px;cursor:pointer;font-size:11px;color:#475569;">' +
            '<input type="checkbox" id="alrtDbgLogsShowAll" onchange="alrtDbgLogsFilterChange()"> Show all hours</label></div></div>' +
            '<div id="alrtDbgLogsFilesArea"><div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading log types…</p></div></div>' +
            '</div>';

        window._alrtDbgLogsCtx = {
            station: r.station,
            siteId: r.siteId,
            machine: r.station + '_' + r.siteId,
            date: folderDate,
            hour: hourPart,
            allFiles: []
        };

        // Load log types
        $.ajax({
            url: '/FRS25/Alerts/GetRedaLogTypes', type: 'GET',
            success: function (resp) {
                var sel = document.getElementById('alrtDbgLogType');
                if (!sel) return;
                if (resp.success && resp.data && resp.data.length > 0) {
                    sel.innerHTML = '<option value="">-- Select Log Type --</option>';
                    resp.data.forEach(function (item) {
                        sel.innerHTML += '<option value="' + alrtDbgEsc(item.Name) + '">' + alrtDbgEsc(item.Name) + '</option>';
                    });
                    // Auto-select first
                    sel.value = resp.data[0].Name;
                    alrtDbgLogsFilterChange();
                } else {
                    sel.innerHTML = '<option value="">-- No Log Types --</option>';
                    document.getElementById('alrtDbgLogsFilesArea').innerHTML =
                        '<div class="alrt-dbg-empty">No log types available.</div>';
                }
            },
            error: function () {
                document.getElementById('alrtDbgLogsFilesArea').innerHTML =
                    '<div class="alrt-dbg-error"><i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>Failed to load log types.</div>';
            }
        });
    }

    function alrtDbgLogsFilterChange() {
        var sel = document.getElementById('alrtDbgLogType');
        var showAll = document.getElementById('alrtDbgLogsShowAll');
        var area = document.getElementById('alrtDbgLogsFilesArea');
        var ctx = window._alrtDbgLogsCtx;

        if (!sel || !ctx) return;
        var logType = sel.value;

        if (!logType) { area.innerHTML = '<div class="alrt-dbg-empty">Please select a Log Type.</div>'; return; }
        if (!ctx.station) { area.innerHTML = '<div class="alrt-dbg-empty">Station not available for this alert.</div>'; return; }
        if (!ctx.date) { area.innerHTML = '<div class="alrt-dbg-empty">Date not available for this alert.</div>'; return; }

        area.innerHTML = '<div class="alrt-dbg-loading"><i class="fas fa-circle-notch spin"></i><p>Loading files…</p></div>';

        $.ajax({
            url: '/FRS25/Alerts/GetRedaFiles', type: 'GET',
            data: { logType: logType, machine: ctx.machine, date: ctx.date },
            success: function (resp) {
                if (!resp.success || !resp.data || resp.data.length === 0) {
                    area.innerHTML = '<div class="alrt-dbg-empty"><i class="fas fa-file-alt" style="font-size:28px;display:block;margin-bottom:8px;color:#cbd5e1"></i>No files found for <b>' + alrtDbgEsc(ctx.station) + '</b> on <b>' + alrtDbgEsc(ctx.date) + '</b>.</div>';
                    return;
                }
                ctx.allFiles = resp.data;
                alrtDbgLogsRenderFiles(logType, ctx, showAll ? showAll.checked : false);
            },
            error: function (xhr) {
                area.innerHTML = '<div class="alrt-dbg-error"><i class="fas fa-exclamation-triangle" style="margin-right:6px"></i>Failed to load files (HTTP ' + xhr.status + ').</div>';
            }
        });
    }

    function alrtDbgLogsRenderFiles(logType, ctx, showAll) {
        var area = document.getElementById('alrtDbgLogsFilesArea');
        var hour = parseInt(ctx.hour, 10);
        var filtered = [];
        var matchCount = 0;

        ctx.allFiles.forEach(function (f) {
            var range = alrtDbgExtractHourRange(f.FileName);
            f._range = range;
            f._match = range ? alrtDbgHourInRange(ctx.hour, range) : false;
            if (f._match) matchCount++;
            if (showAll || f._match) filtered.push(f);
        });

        if (filtered.length === 0) {
            area.innerHTML = '<div class="alrt-dbg-empty"><i class="fas fa-filter" style="font-size:28px;display:block;margin-bottom:8px;color:#cbd5e1"></i>No files contain alert hour <b>' + ctx.hour + ':00</b>.<br><span style="font-size:11px;color:#94a3b8">Total: ' + ctx.allFiles.length + ' files. Try "Show all hours".</span></div>';
            return;
        }

        filtered.sort(function (a, b) { return (a._range ? a._range.start : 99) - (b._range ? b._range.start : 99); });

        var html =
            '<div style="font-size:11px;color:#64748b;margin-bottom:8px;">' +
            'Showing <b>' + filtered.length + '</b> of ' + ctx.allFiles.length + ' files' +
            (showAll ? '' : ' (hour ' + ctx.hour + ')') +
            ' &nbsp;·&nbsp; <b>' + matchCount + '</b> file(s) cover alert time</div>' +
            '<div style="border:1px solid #d1dce8;border-radius:8px;overflow:hidden;">' +
            '<div style="max-height:400px;overflow-y:auto;">' +
            '<table class="alrt-dbg-logs-tbl"><thead><tr>' +
            '<th>#</th><th>File Name</th><th>Time Range</th><th>Size</th><th>Modified</th><th>Action</th>' +
            '</tr></thead><tbody>';

        filtered.forEach(function (f, i) {
            var rowCls = f._match ? 'log-match' : '';
            var rangeDisplay = f._range ? (alrtDbgPad2(f._range.start) + ':00 → ' + alrtDbgPad2(f._range.end) + ':00') : '-';
            var badge = f._match
                ? '<span style="background:#fbbf24;color:#78350f;font-size:9px;padding:2px 6px;border-radius:3px;font-weight:700;margin-left:6px;">CONTAINS ' + ctx.hour + ':00</span>'
                : '';
            var dlUrl = '/FRS25/Alerts/DownloadRedaFile' +
                '?logType=' + encodeURIComponent(logType) +
                '&machine=' + encodeURIComponent(ctx.machine) +
                '&date=' + encodeURIComponent(ctx.date) +
                '&fileName=' + encodeURIComponent(f.FileName);

            html +=
                '<tr class="' + rowCls + '">' +
                '<td style="font-family:monospace;color:#6b7280">' + (i + 1) + '</td>' +
                '<td style="font-weight:600"><i class="fas fa-file-alt" style="color:#64748b;margin-right:5px"></i>' + alrtDbgEsc(f.FileName) + badge + '</td>' +
                '<td style="font-family:monospace;font-size:11px;' + (f._match ? 'color:#166534;font-weight:700;' : 'color:#64748b;') + '">' + rangeDisplay + '</td>' +
                '<td style="font-family:monospace;color:#64748b">' + Number(f.SizeInKB).toLocaleString() + ' KB</td>' +
                '<td style="font-family:monospace;color:#64748b;font-size:10px">' + alrtDbgEsc(f.LastModified) + '</td>' +
                '<td><a href="' + dlUrl + '" target="_blank" style="display:inline-flex;align-items:center;gap:4px;background:#0369a1;border:none;border-radius:5px;padding:4px 9px;font-size:10px;font-weight:600;color:#fff;text-decoration:none;"><i class="fas fa-download"></i> Download</a></td>' +
                '</tr>';
        });

        html += '</tbody></table></div></div>';
        area.innerHTML = html;
    }

    function alrtDbgExtractHourRange(fileName) {
        if (!fileName) return null;
        var name = fileName.replace(/\.[^.]+$/, '');
        var match = name.match(/-(\d{1,2})-(\d{1,2})$/);
        if (match) {
            var h1 = parseInt(match[1], 10), h2 = parseInt(match[2], 10);
            if (h1 >= 0 && h1 <= 23 && h2 >= 0 && h2 <= 24) return { start: h1, end: h2 };
        }
        match = name.match(/[_](\d{1,2})[_\-](\d{1,2})$/);
        if (match) {
            var h3 = parseInt(match[1], 10), h4 = parseInt(match[2], 10);
            if (h3 >= 0 && h3 <= 23 && h4 >= 0 && h4 <= 24) return { start: h3, end: h4 };
        }
        return null;
    }

    function alrtDbgHourInRange(hour, range) {
        if (!range) return false;
        var h = parseInt(hour, 10);
        if (isNaN(h)) return false;
        if (range.end <= range.start) return h >= range.start || h < range.end;
        return h >= range.start && h < range.end;
    }


