﻿﻿@{ ViewBag.Title = "Alerts";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml"; }

<style>
        /* ============================================================
           CSS VARIABLES (Alert page theme — green accent)
        ============================================================ */
        :root {
            --done: #10b981;
            --done-light: #d1fae5;
            --done-text: #065f46;
            --pending: #f59e0b;
            --pending-light: #fef3c7;
            --pending-text: #92400e;
            --failure: #ef4444;
            --failure-light: #fee2e2;
            --failure-text: #991b1b;
            --predictive: #f59e0b;
            --predictive-light: #fef3c7;
            --predictive-text: #92400e;
            --health: #3b82f6;
            --health-light: #dbeafe;
            --health-text: #1e40af;
            --maint: #8b5cf6;
            --maint-light: #ede9fe;
            --maint-text: #5b21b6;
            --primary-600: #059669;
            --primary-500: #10b981;
            --primary-400: #34d399;
            --primary-100: #d1fae5;
            --primary-50: #ecfdf5;
            --sidebar-bg: #1e1b4b;
            --sidebar-hover: #312e81;
            --sidebar-active: #4f46e5;
            --bg-page: #f8fafc;
            --bg-card: #ffffff;
            --border: #e2e8f0;
            --border-light: #f1f5f9;
            --text-primary: #1e293b;
            --text-secondary: #475569;
            --text-muted: #64748b;
            --text-light: #94a3b8;
            --radius-sm: 6px;
            --radius: 8px;
            --radius-lg: 12px;
            --shadow: 0 1px 3px 0 rgba(0,0,0,.1), 0 1px 2px 0 rgba(0,0,0,.06);
            --shadow-xl: 0 20px 25px -5px rgba(0,0,0,.1), 0 10px 10px -5px rgba(0,0,0,.04);
        }

        body.dark-theme {
            --primary: #38bdf8;
            --card-bg: #1e293b;
            --text-color: #e2e8f0;
            --border-color: #334155;
        }

        /* ============================================================
           PAGE WRAPPER
        ============================================================ */
        .alrt-page {
            padding: 0;
        }

        /* ============================================================
           PAGE HEADER
        ============================================================ */
        .alrt-page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .alrt-page-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .alrt-breadcrumb {
            font-size: 13px;
            color: var(--text-muted);
        }

            .alrt-breadcrumb a {
                color: var(--primary-600);
                text-decoration: none;
            }

        /* ===== HEADER FILTER ROW ===== */
        .alrt-hdr-filters {
            display: flex;
            align-items: flex-end;
            gap: 12px;
            flex-wrap: wrap;
        }

        .alrt-filter-item {
            flex-shrink: 0;
            position: relative;
        }

            .alrt-filter-item label {
                display: block;
                font-size: 13px;
                color: #555;
                margin-bottom: 6px;
                font-weight: 500;
            }

        /* ===== SELECT BUTTON ===== */
        .alrt-select-btn {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fff;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            padding: 8px 12px;
            font-size: 14px;
            color: #333;
            cursor: pointer;
            min-width: 180px;
            height: 40px;
        }

            .alrt-select-btn:hover {
                border-color: #999;
            }

            .alrt-select-btn.active {
                border-color: #3b82f6;
                box-shadow: 0 0 0 2px rgba(59,130,246,0.2);
            }

            .alrt-select-btn .text {
                flex: 1;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                text-align: left;
            }

            .alrt-select-btn i {
                margin-left: 8px;
                font-size: 12px;
                color: #666;
            }

        /* ===== DROPDOWN ===== */
        .alrt-filter-dropdown {
            position: fixed;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 8px;
            box-shadow: 0 6px 24px rgba(0,0,0,0.18);
            min-width: 260px;
            max-width: 320px;
            z-index: 9999;
            display: none;
        }

            .alrt-filter-dropdown.open {
                display: block;
            }

        .alrt-dropdown-search {
            padding: 10px 12px;
            border-bottom: 1px solid #e0e0e0;
        }

            .alrt-dropdown-search input {
                width: 100%;
                border: 1px solid #ddd;
                border-radius: 6px;
                padding: 8px 12px;
                font-size: 13px;
                outline: none;
                transition: border-color 0.2s;
            }

                .alrt-dropdown-search input:focus {
                    border-color: #3b82f6;
                }

                .alrt-dropdown-search input::placeholder {
                    color: #aaa;
                }

        .alrt-dropdown-header {
            padding: 10px 14px;
            background: #f5f5f5;
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .alrt-dropdown-header input[type="checkbox"] {
                width: 18px;
                height: 18px;
                cursor: pointer;
                accent-color: #3b82f6;
            }

            .alrt-dropdown-header label {
                font-size: 14px;
                font-weight: 600;
                color: #333;
                cursor: pointer;
                margin: 0;
            }

        .alrt-dropdown-list {
            max-height: 250px;
            overflow-y: auto;
        }

        .alrt-dropdown-item {
            display: flex;
            align-items: center;
            padding: 10px 14px;
            gap: 10px;
            cursor: pointer;
            border-bottom: 1px solid #f0f0f0;
            transition: background 0.15s;
        }

            .alrt-dropdown-item:last-child {
                border-bottom: none;
            }

            .alrt-dropdown-item:hover {
                background: #f5f7fa;
            }

            .alrt-dropdown-item.checked {
                background: #e8f2ff;
            }

            .alrt-dropdown-item.hidden {
                display: none;
            }

            .alrt-dropdown-item input[type="checkbox"] {
                width: 18px;
                height: 18px;
                cursor: pointer;
                accent-color: #3b82f6;
                flex-shrink: 0;
            }

            .alrt-dropdown-item span {
                font-size: 14px;
                color: #333;
            }

            .alrt-dropdown-item.checked span {
                color: #1d4ed8;
                font-weight: 500;
            }

            .alrt-dropdown-item span mark {
                background: #fef08a;
                color: #333;
                padding: 0;
                border-radius: 2px;
            }

        .alrt-dropdown-empty {
            padding: 25px;
            text-align: center;
            color: #888;
            font-size: 14px;
        }

        .alrt-dropdown-no-results {
            padding: 20px;
            text-align: center;
            color: #999;
            font-size: 13px;
            display: none;
        }

            .alrt-dropdown-no-results.show {
                display: block;
            }

        /* ===== BACKDROP ===== */
        .alrt-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 9998;
            display: none;
        }

            .alrt-backdrop.show {
                display: block;
            }

        /* ===== SEARCH BUTTON ===== */
        .alrt-search-btn {
            background: var(--primary, #4f46e5);
            border: none;
            border-radius: 6px;
            padding: 8px 16px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            color: #fff;
            font-size: 14px;
            font-weight: 500;
            transition: background 0.2s;
        }

            .alrt-search-btn:hover {
                opacity: 0.9;
            }

        /* ============================================================
           STATS GRID
        ============================================================ */
        .alrt-stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 24px;
        }

        .alrt-stat-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            padding: 20px;
            border: 1px solid var(--border);
            position: relative;
            overflow: hidden;
        }

            .alrt-stat-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
            }

            .alrt-stat-card.sc-failure::before {
                background: var(--failure);
            }

            .alrt-stat-card.sc-predict::before {
                background: var(--predictive);
            }

            .alrt-stat-card.sc-health::before {
                background: var(--health);
            }

            .alrt-stat-card.sc-cleared::before {
                background: var(--done);
            }

        .alrt-stat-hdr {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 12px;
        }

        .alrt-stat-icon {
            width: 40px;
            height: 40px;
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .sc-failure .alrt-stat-icon {
            background: var(--failure-light);
            color: var(--failure);
        }

        .sc-predict .alrt-stat-icon {
            background: var(--predictive-light);
            color: var(--predictive);
        }

        .sc-health .alrt-stat-icon {
            background: var(--health-light);
            color: var(--health);
        }

        .sc-cleared .alrt-stat-icon {
            background: var(--done-light);
            color: var(--done);
        }

        .alrt-stat-trend {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 12px;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 12px;
        }

            .alrt-stat-trend.up {
                background: var(--failure-light);
                color: var(--failure);
            }

            .alrt-stat-trend.down {
                background: var(--done-light);
                color: var(--done);
            }

        .alrt-stat-value {
            font-size: 32px;
            font-weight: 800;
            line-height: 1;
            color: var(--text-primary);
        }

        .alrt-stat-label {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .alrt-stat-breakdown {
            display: flex;
            gap: 16px;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid var(--border-light);
        }

        .alrt-stat-item-label {
            font-size: 12px;
            color: var(--text-muted);
        }

        .alrt-stat-item-value {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
        }

        /* ============================================================
           CONTENT GRID
        ============================================================ */
        .alrt-content-grid {
            display: grid;
            grid-template-columns: 1fr 360px;
            gap: 24px;
        }

        /* ============================================================
           CARD
        ============================================================ */
        .alrt-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            overflow: visible;
        }

        .alrt-card-hdr {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
        }

        .alrt-card-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .alrt-card-title i {
                color: var(--primary-500);
            }

        .alrt-card-actions {
            display: flex;
            gap: 8px;
        }

        /* ============================================================
           BUTTONS
        ============================================================ */
        .alrt-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: var(--radius);
            font-size: 13px;
            font-weight: 500;
            font-family: inherit;
            cursor: pointer;
            transition: all .2s;
            border: 1px solid var(--border);
            background: var(--bg-card);
            color: var(--text-secondary);
        }

            .alrt-btn:hover {
                border-color: var(--primary-500);
                color: var(--primary-600);
            }

            .alrt-btn.btn-sm {
                padding: 6px 12px;
                font-size: 12px;
            }

            .alrt-btn.btn-primary {
                background: var(--primary-500);
                border-color: var(--primary-500);
                color: #fff;
            }

                .alrt-btn.btn-primary:hover {
                    background: var(--primary-600);
                    border-color: var(--primary-600);
                    color: #fff;
                }

        /* ============================================================
           TABS
        ============================================================ */
        .alrt-tabs {
            display: flex;
            border-bottom: 1px solid var(--border);
            background: var(--bg-page);
            padding: 0 16px;
        }

        .alrt-tab {
            padding: 12px 16px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-muted);
            background: transparent;
            border: none;
            cursor: pointer;
            position: relative;
            transition: color .2s;
        }

            .alrt-tab:hover {
                color: var(--text-primary);
            }

            .alrt-tab.active {
                color: var(--primary-600);
            }

                .alrt-tab.active::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    right: 0;
                    height: 2px;
                    background: var(--primary-500);
                }

        .alrt-tab-badge {
            margin-left: 6px;
            padding: 2px 8px;
            border-radius: 10px;
            font-size: 11px;
            font-weight: 600;
        }

        .alrt-tab.failure .alrt-tab-badge {
            background: var(--failure-light);
            color: var(--failure-text);
        }

        .alrt-tab.predictive .alrt-tab-badge {
            background: var(--predictive-light);
            color: var(--predictive-text);
        }

        .alrt-tab.health .alrt-tab-badge {
            background: var(--health-light);
            color: var(--health-text);
        }

        /* ============================================================
           FILTER BAR
        ============================================================ */
        .alrt-filters-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            padding: 14px 20px;
            background: linear-gradient(180deg, var(--bg-page) 0%, var(--bg-card) 100%);
            border-bottom: 1px solid var(--border);
            align-items: flex-end;
        }

        .alrt-filter-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .alrt-filter-label {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
        }

        .alrt-filter-inp {
            padding: 7px 12px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            font-size: 13px;
            font-family: inherit;
            background: var(--bg-card);
            color: var(--text-primary);
            min-width: 140px;
        }

            .alrt-filter-inp:focus {
                outline: none;
                border-color: var(--primary-500);
            }

        /* ============================================================
           TABLE
        ============================================================ */
        .alrt-table-wrap {
            overflow-x: auto;
        }

        .alrt-table {
            width: 100%;
            border-collapse: collapse;
        }

            .alrt-table thead th {
                text-align: left;
                padding: 12px 16px;
                font-size: 11px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: .5px;
                color: var(--text-muted);
                background: var(--bg-page);
                border-bottom: 1px solid var(--border);
                white-space: nowrap;
                cursor: pointer;
            }

                .alrt-table thead th:hover {
                    color: var(--primary-600);
                }

            .alrt-table tbody td {
                padding: 14px 16px;
                border-bottom: 1px solid var(--border-light);
                font-size: 13px;
                vertical-align: middle;
            }

            .alrt-table tbody tr:hover td {
                background: var(--primary-50);
            }

            .alrt-table tbody tr.urgent td {
                background: var(--failure-light);
            }

            .alrt-table tbody tr.urgent:hover td {
                background: #fecaca;
            }

        /* ── badges inside table ── */
        .alrt-type-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 10px;
            border-radius: var(--radius);
            font-size: 12px;
            font-weight: 600;
        }

            .alrt-type-badge.failure {
                background: var(--failure-light);
                color: var(--failure-text);
            }

            .alrt-type-badge.predictive {
                background: var(--predictive-light);
                color: var(--predictive-text);
            }

            .alrt-type-badge.health {
                background: var(--health-light);
                color: var(--health-text);
            }

        .alrt-asset-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .alrt-asset-name {
            font-weight: 600;
            color: var(--text-primary);
        }

        .alrt-asset-loc {
            font-size: 12px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .alrt-cause-code {
            display: inline-block;
            margin-top: 4px;
            font-family: 'SF Mono','Monaco',monospace;
            font-size: 11px;
            font-weight: 600;
            color: var(--primary-600);
            background: var(--primary-50);
            padding: 3px 8px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--primary-100);
        }

        .alrt-time-cell {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .alrt-time-main {
            font-weight: 500;
            color: var(--text-primary);
            font-size: 13px;
        }

        .alrt-time-rel {
            font-size: 11px;
            color: var(--text-muted);
        }

        .alrt-dur {
            font-family: 'SF Mono','Monaco',monospace;
            font-size: 12px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: var(--radius-sm);
        }

            .alrt-dur.critical {
                background: var(--failure-light);
                color: var(--failure);
            }

            .alrt-dur.warning {
                background: var(--predictive-light);
                color: var(--predictive);
            }

            .alrt-dur.ok {
                background: var(--done-light);
                color: var(--done);
            }

        .alrt-status {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
        }

            .alrt-status.pending {
                background: var(--pending-light);
                color: var(--pending-text);
            }

            .alrt-status.cleared {
                background: var(--done-light);
                color: var(--done-text);
            }

        .alrt-fb-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: var(--radius);
            font-size: 12px;
            font-weight: 800;
        }

            .alrt-fb-badge.fb-true {
                background: var(--done-light);
                color: var(--done);
            }

            .alrt-fb-badge.fb-partial {
                background: var(--predictive-light);
                color: var(--predictive);
            }

            .alrt-fb-badge.fb-false {
                background: var(--failure-light);
                color: var(--failure);
            }

            .alrt-fb-badge.fb-maint {
                background: var(--maint-light);
                color: var(--maint);
            }

            .alrt-fb-badge.fb-none {
                background: var(--bg-page);
                color: var(--text-light);
                border: 2px dashed var(--border);
            }

        .alrt-maintainer-cell {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alrt-maint-avatar {
            width: 32px;
            height: 32px;
            border-radius: var(--radius);
            background: linear-gradient(135deg, #4f46e5, #1e1b4b);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .alrt-maint-name {
            font-weight: 600;
            font-size: 13px;
            color: var(--text-primary);
        }

        .alrt-maint-role {
            font-size: 11px;
            color: var(--text-muted);
        }

        .alrt-maint-mob {
            font-size: 11px;
            color: var(--primary-600);
            font-family: monospace;
        }

        .alrt-repeat-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 6px;
            background: var(--predictive-light);
            color: var(--predictive);
            font-size: 10px;
            font-weight: 700;
            border-radius: 10px;
            margin-left: 6px;
        }

        .alrt-dedup-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 2px 6px;
            background: var(--health-light);
            color: var(--health);
            font-size: 10px;
            font-weight: 700;
            border-radius: 10px;
            margin-left: 6px;
        }

        .alrt-action-btns {
            display: flex;
            gap: 6px;
        }

        .alrt-act-btn {
            width: 32px;
            height: 32px;
            border-radius: var(--radius);
            border: 1px solid var(--border);
            background: var(--bg-card);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all .2s;
            color: var(--text-muted);
            font-size: 14px;
        }

            .alrt-act-btn:hover {
                border-color: var(--primary-500);
                color: var(--primary-600);
                background: var(--primary-50);
            }

            .alrt-act-btn.btn-primary {
                background: var(--primary-500);
                border-color: var(--primary-500);
                color: #fff;
            }

                .alrt-act-btn.btn-primary:hover {
                    background: var(--primary-600);
                }

        /* Table footer + pagination */
        .alrt-table-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 20px;
            border-top: 1px solid var(--border);
            background: var(--bg-page);
        }

        .alrt-table-info {
            font-size: 13px;
            color: var(--text-muted);
        }

        .alrt-pagination {
            display: flex;
            gap: 4px;
        }

        .alrt-page-btn {
            width: 32px;
            height: 32px;
            border: 1px solid var(--border);
            background: var(--bg-card);
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-secondary);
            cursor: pointer;
        }

            .alrt-page-btn:hover {
                border-color: var(--primary-500);
                color: var(--primary-600);
            }

            .alrt-page-btn.active {
                background: var(--primary-500);
                border-color: var(--primary-500);
                color: #fff;
            }

        /* ============================================================
           SIDE PANEL — Escalation / Maintenance / Metrics
        ============================================================ */
        .alrt-side-panel {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Escalation */
        .alrt-esc-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .alrt-esc-hdr {
            padding: 16px 20px;
            background: linear-gradient(135deg, var(--sidebar-bg) 0%, var(--sidebar-hover) 100%);
            color: #fff;
        }

        .alrt-esc-title {
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .alrt-esc-title i {
                color: var(--primary-400);
            }

        .alrt-esc-body {
            padding: 20px;
        }

        .alrt-esc-info {
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border-light);
        }

        /* Timeline */
        .alrt-timeline {
            position: relative;
            padding-left: 24px;
        }

            .alrt-timeline::before {
                content: '';
                position: absolute;
                left: 6px;
                top: 6px;
                bottom: 6px;
                width: 2px;
                background: var(--border);
            }

        .alrt-tl-item {
            position: relative;
            padding-bottom: 16px;
        }

            .alrt-tl-item:last-child {
                padding-bottom: 0;
            }

        .alrt-tl-dot {
            position: absolute;
            left: -20px;
            top: 4px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--border);
            border: 2px solid var(--bg-card);
        }

        .alrt-tl-item.tl-done .alrt-tl-dot {
            background: var(--done);
        }

        .alrt-tl-item.tl-current .alrt-tl-dot {
            background: var(--predictive);
            box-shadow: 0 0 0 4px rgba(245,158,11,.2);
            animation: tlpulse 2s infinite;
        }

        .alrt-tl-item.tl-pending .alrt-tl-dot {
            background: var(--text-light);
        }

        @@keyframes tlpulse {
            0%, 100% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: .5;
                transform: scale(1.2);
            }
        }

        .alrt-tl-content {
            background: var(--bg-page);
            padding: 12px;
            border-radius: var(--radius);
            border-left: 3px solid transparent;
        }

        .alrt-tl-item.tl-done .alrt-tl-content {
            border-left-color: var(--done);
        }

        .alrt-tl-item.tl-current .alrt-tl-content {
            border-left-color: var(--predictive);
            background: var(--predictive-light);
        }

        .alrt-tl-hdr {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 4px;
        }

        .alrt-tl-role {
            font-weight: 600;
            font-size: 13px;
            color: var(--text-primary);
        }

        .alrt-tl-time {
            font-family: monospace;
            font-size: 11px;
            color: var(--text-muted);
        }

        .alrt-tl-person {
            font-size: 12px;
            color: var(--text-secondary);
        }
        /* Maintenance card */
        .alrt-maint-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .alrt-maint-hdr {
            padding: 16px 20px;
            background: linear-gradient(135deg, var(--maint) 0%, #7c3aed 100%);
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .alrt-maint-title {
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alrt-maint-count {
            background: rgba(255,255,255,.2);
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
        }

        .alrt-maint-body {
            padding: 16px;
        }

        .alrt-maint-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-height: 360px; /* caps the card height */
            overflow-y: auto; /* scrolls when items exceed cap */
            padding-right: 4px; /* breathing room for scrollbar */
        }

            /* Subtle scrollbar to match the maint-light palette */
            .alrt-maint-list::-webkit-scrollbar {
                width: 6px;
            }

            .alrt-maint-list::-webkit-scrollbar-track {
                background: transparent;
            }

            .alrt-maint-list::-webkit-scrollbar-thumb {
                background: var(--border);
                border-radius: 3px;
            }

                .alrt-maint-list::-webkit-scrollbar-thumb:hover {
                    background: var(--maint);
                }

        /* Firefox */
        .alrt-maint-list {
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }

        .alrt-maint-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px;
            background: var(--maint-light);
            border-radius: var(--radius);
            border-left: 4px solid var(--maint);
        }

            .alrt-maint-item.expiring {
                border-left-color: var(--predictive);
                background: var(--predictive-light);
            }

        .alrt-maint-item-info {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .alrt-maint-item-asset {
            font-weight: 600;
            font-size: 13px;
            color: var(--text-primary);
        }

        .alrt-maint-item-time {
            font-family: monospace;
            font-size: 11px;
            color: var(--maint);
        }

        .alrt-maint-item-by {
            font-size: 11px;
            color: var(--text-muted);
        }

        .alrt-maint-item-acts {
            display: flex;
            gap: 6px;
        }

        .alrt-maint-btn {
            padding: 6px 10px;
            border-radius: var(--radius-sm);
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all .2s;
        }

            .alrt-maint-btn.edit {
                background: var(--bg-card);
                color: var(--text-secondary);
                border: 1px solid var(--border);
            }

            .alrt-maint-btn.clear {
                background: transparent;
                color: var(--maint);
                border: 1px solid var(--maint);
            }

                .alrt-maint-btn.clear:hover {
                    background: var(--maint);
                    color: #fff;
                }

            .alrt-maint-btn.expiring {
                background: var(--predictive);
                color: #fff;
                border: none;
            }

        .alrt-add-maint {
            width: 100%;
            margin-top: 12px;
            padding: 12px;
            border-radius: var(--radius);
            border: 2px dashed var(--border);
            background: transparent;
            color: var(--text-muted);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all .2s;
        }

            .alrt-add-maint:hover {
                border-color: var(--maint);
                color: var(--maint);
                background: var(--maint-light);
            }

        /* Metrics card */
        .alrt-metrics-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border);
            overflow: hidden;
        }

        .alrt-metrics-hdr {
            padding: 16px 20px;
            background: linear-gradient(135deg, var(--done) 0%, #047857 100%);
            color: #fff;
        }

        .alrt-metrics-title {
            font-size: 14px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .alrt-metrics-body {
            padding: 16px;
        }

        .alrt-metric-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 12px;
            border-bottom: 1px solid var(--border-light);
        }

            .alrt-metric-item:last-child {
                border-bottom: none;
            }

        .alrt-metric-label {
            font-size: 13px;
            color: var(--text-secondary);
        }

        .alrt-metric-value {
            font-size: 16px;
            font-weight: 700;
        }

            .alrt-metric-value.good {
                color: var(--done);
            }

            .alrt-metric-value.warning {
                color: var(--predictive);
            }

            .alrt-metric-value.bad {
                color: var(--failure);
            }

        /* ============================================================
           MODAL OVERLAY
        ============================================================ */
        .alrt-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.5);
            z-index: 10040;
            opacity: 0;
            visibility: hidden;
            transition: all .3s ease;
        }

            .alrt-overlay.active {
                opacity: 1;
                visibility: visible;
            }

        /* Maintenance Modal */
        .alrt-modal {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%) scale(.9);
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            width: 520px;
            max-width: 95vw;
            max-height: 90vh;
            overflow-y: auto;
            z-index: 10050;
            opacity: 0;
            visibility: hidden;
            transition: all .3s ease;
            box-shadow: var(--shadow-xl);
        }

            .alrt-modal.active {
                opacity: 1;
                visibility: visible;
                transform: translate(-50%,-50%) scale(1);
            }

        .alrt-modal-hdr {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 24px 24px 16px;
            border-bottom: 1px solid var(--border);
        }

        .alrt-modal-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .alrt-modal-sub {
            font-size: 13px;
            color: var(--text-muted);
            margin-top: 4px;
        }

        .alrt-modal-close {
            width: 36px;
            height: 36px;
            border-radius: var(--radius);
            background: var(--bg-page);
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            font-size: 16px;
            transition: all .2s;
        }

            .alrt-modal-close:hover {
                background: var(--failure-light);
                color: var(--failure);
            }

        .alrt-modal-body {
            padding: 20px 24px;
        }

        .alrt-modal-ftr {
            padding: 16px 24px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            background: var(--bg-page);
        }

        /* ============================================================
           FEEDBACK SLIDE PANEL
        ============================================================ */
        .alrt-slide-panel {
            position: fixed;
            top: 0;
            right: -560px;
            width: 560px;
            height: 100vh;
            background: var(--bg-card);
            z-index: 10050;
            transition: right .4s ease;
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow-xl);
        }

            .alrt-slide-panel.active {
                right: 0;
            }

        .alrt-panel-hdr {
            padding: 20px 24px;
            background: linear-gradient(135deg, var(--sidebar-bg) 0%, var(--sidebar-hover) 100%);
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            flex-shrink: 0;
        }

        .alrt-panel-title {
            font-size: 18px;
            font-weight: 700;
        }

        .alrt-panel-sub {
            font-size: 13px;
            opacity: .8;
            margin-top: 4px;
        }

        .alrt-panel-close {
            width: 36px;
            height: 36px;
            border-radius: var(--radius);
            background: rgba(255,255,255,.1);
            border: none;
            color: #fff;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
        }

        .alrt-panel-body {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
        }

        .alrt-panel-ftr {
            padding: 16px 24px;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            background: var(--bg-page);
            flex-shrink: 0;
        }

        /* Alert summary block inside panel */
        .alrt-summary-block {
            background: var(--bg-page);
            border-radius: var(--radius-lg);
            padding: 20px;
            margin-bottom: 24px;
            border: 1px solid var(--border);
        }

        .alrt-summary-hdr {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 16px;
        }

        .alrt-summary-id {
            font-family: monospace;
            font-size: 12px;
            color: var(--text-muted);
            margin-bottom: 4px;
        }

        .alrt-summary-name {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .alrt-summary-grid {
            display: grid;
            grid-template-columns: repeat(2,1fr);
            gap: 12px;
        }

        .alrt-summary-lbl {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            color: var(--text-muted);
        }

        .alrt-summary-val {
            font-size: 14px;
            font-weight: 600;
            color: var(--text-primary);
        }

        /* Feedback options */
        .alrt-section-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .alrt-section-title i {
                color: var(--primary-500);
            }

            .alrt-section-title .req {
                color: var(--failure);
            }

        .alrt-fb-options {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 12px;
            margin-bottom: 24px;
        }

        .alrt-fb-opt {
            padding: 16px 12px;
            border-radius: var(--radius-lg);
            border: 2px solid var(--border);
            background: var(--bg-card);
            cursor: pointer;
            transition: all .2s;
            text-align: center;
        }

            .alrt-fb-opt:hover {
                transform: translateY(-2px);
                box-shadow: var(--shadow);
            }

            .alrt-fb-opt.selected {
                border-width: 2px;
            }

            .alrt-fb-opt.fbt.selected {
                border-color: var(--done);
                background: var(--done-light);
            }

            .alrt-fb-opt.fbpt.selected {
                border-color: var(--predictive);
                background: var(--predictive-light);
            }

            .alrt-fb-opt.fbf.selected {
                border-color: var(--failure);
                background: var(--failure-light);
            }

            .alrt-fb-opt.fbm.selected {
                border-color: var(--maint);
                background: var(--maint-light);
            }

            .alrt-fb-opt.disabled {
                opacity: .5;
                cursor: not-allowed;
                pointer-events: none;
            }

        .alrt-fb-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin: 0 auto 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            font-weight: 800;
        }

        .alrt-fb-opt.fbt .alrt-fb-icon {
            background: var(--done-light);
            color: var(--done);
        }

        .alrt-fb-opt.fbpt .alrt-fb-icon {
            background: var(--predictive-light);
            color: var(--predictive);
        }

        .alrt-fb-opt.fbf .alrt-fb-icon {
            background: var(--failure-light);
            color: var(--failure);
        }

        .alrt-fb-opt.fbm .alrt-fb-icon {
            background: var(--maint-light);
            color: var(--maint);
        }

        .alrt-fb-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .alrt-fb-desc {
            font-size: 10px;
            color: var(--text-muted);
            line-height: 1.4;
        }

        /* Form helpers */
        .alrt-form-section {
            margin-bottom: 20px;
        }

        .alrt-form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .alrt-form-group {
            margin-bottom: 16px;
        }

        .alrt-form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 6px;
        }

            .alrt-form-label .req {
                color: var(--failure);
            }

        .alrt-form-inp, .alrt-form-sel, .alrt-form-ta {
            width: 100%;
            padding: 10px 14px;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            font-size: 14px;
            font-family: inherit;
            background: var(--bg-card);
            color: var(--text-primary);
            transition: all .2s;
        }

            .alrt-form-inp:focus, .alrt-form-sel:focus, .alrt-form-ta:focus {
                outline: none;
                border-color: var(--primary-500);
                box-shadow: 0 0 0 3px rgba(16,185,129,.1);
            }

            .alrt-form-inp:disabled, .alrt-form-sel:disabled, .alrt-form-ta:disabled {
                background: var(--bg-page);
                cursor: not-allowed;
            }

        .alrt-form-ta {
            min-height: 100px;
            resize: vertical;
        }

        .alrt-file-upload {
            border: 2px dashed var(--border);
            border-radius: var(--radius);
            padding: 24px;
            text-align: center;
            cursor: pointer;
            transition: all .2s;
        }

            .alrt-file-upload:hover {
                border-color: var(--primary-500);
                background: var(--primary-50);
            }

            .alrt-file-upload i {
                font-size: 28px;
                color: var(--text-light);
                display: block;
                margin-bottom: 10px;
            }

        .alrt-file-upload-txt {
            font-size: 13px;
            color: var(--text-muted);
        }

            .alrt-file-upload-txt span {
                color: var(--primary-600);
                font-weight: 600;
            }

        /* Locked notice */
        .alrt-locked-notice {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            background: var(--predictive-light);
            border-radius: var(--radius);
            margin-bottom: 16px;
            font-size: 13px;
            color: var(--predictive-text);
        }
        /* Authority review */
        .alrt-auth-review {
            background: var(--health-light);
            border-radius: var(--radius);
            padding: 16px;
            margin-top: 20px;
            border: 1px solid var(--health);
        }

        .alrt-auth-review-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--health-text);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        /* Vendor review */
        .alrt-vendor-review {
            background: var(--maint-light);
            border-radius: var(--radius);
            padding: 16px;
            margin-top: 16px;
            border: 1px solid var(--maint);
        }

        .alrt-vendor-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--maint-text);
            margin-bottom: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .alrt-vendor-remarks {
            background: var(--bg-card);
            padding: 12px;
            border-radius: var(--radius);
            font-size: 13px;
            color: var(--text-secondary);
            font-style: italic;
        }

        .alrt-vendor-meta {
            margin-top: 8px;
            font-size: 11px;
            color: var(--text-muted);
        }

        /* ============================================================
           RESPONSIVE
        ============================================================ */
        @@media (max-width: 1400px) {
            .alrt-content-grid {
                grid-template-columns: 1fr;
            }

            .alrt-side-panel {
                display: grid;
                grid-template-columns: repeat(3,1fr);
            }
        }

        @@media (max-width: 1200px) {
            .alrt-stats-grid {
                grid-template-columns: repeat(2,1fr);
            }

            .alrt-side-panel {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media (max-width: 768px) {
            .alrt-stats-grid {
                grid-template-columns: 1fr;
            }

            .alrt-side-panel {
                grid-template-columns: 1fr;
            }

            .alrt-fb-options {
                grid-template-columns: repeat(2,1fr);
            }

            .alrt-slide-panel {
                width: 100%;
                right: -100%;
            }
        }





        /* Reminder accent — overrides the default tl-* state styles */
        .alrt-tl-item.tl-reminder .alrt-tl-content {
            border-left-color: var(--predictive) !important;
            background: linear-gradient(135deg, var(--predictive-light), #fff7ed) !important;
            box-shadow: 0 0 0 1px rgba(245,158,11,.15);
        }

        .alrt-tl-item.tl-reminder .alrt-tl-dot {
            background: var(--predictive) !important;
            box-shadow: 0 0 0 3px rgba(245,158,11,.25), 0 0 0 7px rgba(245,158,11,.08) !important;
            animation: tlReminderPulse 1.4s ease-in-out infinite;
        }

        @@keyframes tlReminderPulse {
            0%, 100% {
                box-shadow: 0 0 0 3px rgba(245,158,11,.30), 0 0 0 7px rgba(245,158,11,.08);
            }

            50% {
                box-shadow: 0 0 0 3px rgba(245,158,11,.55), 0 0 0 12px rgba(245,158,11,.04);
            }
        }

        /* Reminder badge */
        .alrt-tl-badges {
            display: inline-flex;
            gap: 5px;
            align-items: center;
            flex-wrap: wrap;
        }

        .alrt-tl-badge {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            padding: 2px 7px;
            border-radius: 4px;
            font-size: 9.5px;
            font-weight: 700;
            letter-spacing: .03em;
            text-transform: uppercase;
            font-family: 'SF Mono', 'Monaco', monospace;
        }

            .alrt-tl-badge.bdg-reminder {
                background: var(--predictive);
                color: #fff;
            }

                .alrt-tl-badge.bdg-reminder i {
