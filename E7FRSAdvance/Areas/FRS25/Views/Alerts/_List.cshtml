function fnUpdateAckStatus(alertId, acknowledgemenStatusId) {
    if (!confirm('Are you sure you want to update acknowledgement?')) return;
    var mFRSAlert = { Id: alertId, AcknowledgemenStatusId: acknowledgemenStatusId };
    $("#loader").show();
    $.ajax({
        url: '/FRS25/Alerts/UpdateAcknowledgementStatus',
        type: 'POST', contentType: 'application/json',
        data: JSON.stringify(mFRSAlert), dataType: 'json',
        success: function (data) {
            $("#loader").hide();
            if (typeof fnGetAlertDetailReport === 'function') fnGetAlertDetailReport(@skip);
            else location.reload();
            if (data != null) {
                if (data.type === 'success') CommonNotification("SUCCESS", data.result, "success");
                else if (data.type === 'error') CommonNotification("ERROR", data.result, "error");
            }
        },
        error: function () { $("#loader").hide(); CommonNotification("ERROR", "Something went wrong!", "Error"); }
    });
}

function AddRemark(id, statusId) {
    if (id == null || id === '') return;
    $("#loader").show();
    $.ajax({
        url: '/FRS25/Alerts/GetBy',
        type: 'POST', data: '{id:' + id + '}', contentType: 'application/json',
        success: function (data) {
            $("#loader").hide();
            if (data != null && data.Id > 0) {
                $('#hdnAlertRemarkId').val(id);
                $('#txtAlertRemark').val(data.Remark);
                $('#hdnAlertAlertStatusId').val(statusId);
            }
            if (data.mAlertInfos != null && data.mAlertInfos.length > 0
                && statusId == '@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT.GetHashCode()') {
                $('#divRemarkAlertInfo').show();
                $('#drpRemarkAlertInfo').empty().append($("<option></option>").val('').html('Select'));
                $(data.mAlertInfos).each(function (d, value) {
                    $('#drpRemarkAlertInfo').append($("<option></option>").val(value.Id).html(value.Name));
                });
            } else {
                $('#drpRemarkAlertInfo').empty();
                $('#divRemarkAlertInfo').hide();
            }
            $('#modelAddRemark').modal('show');
        },
        error: function () { $("#loader").hide(); CommonNotification("ERROR", "Something went wrong!", "Error"); }
    });
}

function fnUpdateRemark() {
    var remarkVal = $('#txtAlertRemark').val();
    if (!remarkVal) { alert('Remark is required.'); return; }
    var mFRSAlert = {};
    mFRSAlert.Id = $('#hdnAlertRemarkId').val();
    mFRSAlert.Remark = remarkVal;
    mFRSAlert.AcknowledgemenStatusId = $('#hdnAlertAlertStatusId').val();
    var rectificationValue = $('#txtRectificationDateTime').val();
    if (rectificationValue) {
        var rectDate = new Date(rectificationValue);
        if (rectDate > new Date()) { alert("Future date & time is not allowed."); return; }
        mFRSAlert.RectificationDateTime = rectDate.toISOString();
    }
    if (mFRSAlert.AcknowledgemenStatusId == '@E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT.GetHashCode()') {
        mFRSAlert.PTAlertInfoId = $('#drpRemarkAlertInfo').val();
        if (!mFRSAlert.PTAlertInfoId) { alert('Cause Code is required.'); return; }
    }
    $("#loader").show();
    $.ajax({
        url: '/FRS25/Alerts/UpdateRemark',
        type: 'POST', contentType: 'application/json',
        data: JSON.stringify(mFRSAlert), dataType: 'json',
        success: function (data) {
            $("#loader").hide();
            $('#modelAddRemark').modal('hide');
            if (typeof fnGetAlertDetailReport === 'function') fnGetAlertDetailReport(@skip);
            else location.reload();
            if (data != null) {
                var msg = data.result || '';
                if (data.type === 'success') CommonNotification("SUCCESS", msg, "success");
                else if (data.type === 'error') CommonNotification("ERROR", msg, "error");
            }
        },
        error: function () { $('#modelAddRemark').modal('hide'); $("#loader").hide(); alert("Something went wrong!"); }
    });
}

function AddRemarkWithoutFeedback(id, statusId) {
    if (id == null || id === '') return;
    $('#hdnAlertRemarkWithOutFeedbackId').val(id);
    $('#hdnAlertAlertStatusWithOutFeedbackId').val(statusId);
    $('#modelAddRemarkWithOutFeedback').modal('show');
}

function fnUpdateRemarkWithoutFeedback() {
    var remarkVal = $('#txtAlertRemarkWithOutFeedback').val();
    if (!remarkVal) { alert('Remark is required.'); return; }
    var mFRSAlert = {};
    mFRSAlert.Id = $('#hdnAlertRemarkWithOutFeedbackId').val();
    mFRSAlert.Remark = remarkVal;
    mFRSAlert.AcknowledgemenStatusId = $('#hdnAlertAlertStatusWithOutFeedbackId').val();
    $("#loader").show();
    $.ajax({
        url: '/FRS25/Alerts/UpdateRemark',
        type: 'POST', contentType: 'application/json',
        data: JSON.stringify(mFRSAlert), dataType: 'json',
        success: function (data) {
            $("#loader").hide();
            $('#modelAddRemarkWithOutFeedback').modal('hide');
            if (typeof fnGetAlertDetailReport === 'function') fnGetAlertDetailReport(@skip);
            else location.reload();
            if (data != null) {
                var msg = data.result || '';
                if (data.type === 'success') CommonNotification("SUCCESS", msg, "success");
                else if (data.type === 'error') CommonNotification("ERROR", msg, "error");
            }
        },
        error: function () { $('#modelAddRemarkWithOutFeedback').modal('hide'); $("#loader").hide(); alert("Something went wrong!"); }
    });
}

function fnShowRemark(id) {
    $("#loader").show();
    $.ajax({
        url: '/FRS25/Alerts/_FRSRemark',
        type: 'POST', dataType: 'html',
        data: '{id:' + id + '}', contentType: 'application/json',
        success: function (data) {
            $("#loader").hide();
            $("#divFRSAlertRemark").empty().append(data);
            $('#modalFRSAlertRemark').modal('show');
        },
        error: function () { $("#loader").hide(); CommonNotification("ERROR", "Something went wrong!", "Error"); }
    });
}

function fnShowAlertMessage(id) {
    var alertmsg  = $('#spnAlertmsg'         + id).text();
    var alertDesc = $('#spnAlertDescription' + id).text();
    var resetDesc = $('#spnResetAlertmsg'    + id).text();
    var msg = alertmsg.replace(/\n/g, '') + '<br>' + alertDesc.replace(/\n/g, '');
    if (resetDesc) { msg += '<br><b>Reset Message</b><br>' + resetDesc.replace(/\n/g, ''); }
    $('#spnAlertMessage').html(msg.replace(/\n/g, '<br>'));
    $('#modelShowAlertMessage').modal('show');
}

function fnUpdateMaintenanceInActiveMode(assetId) {
    if (!confirm('Clear this maintenance window now? Alerts will resume immediately.')) return;
    $("#loader").show();
    $.ajax({
        url: '/FRS25/MaintenanceMode/UpdateMaintenanceInActiveMode',
        type: 'POST', contentType: 'application/json',
        data: JSON.stringify({ AssetId: assetId }), dataType: 'json',
        success: function (data) {
            $("#loader").hide();
            if (data && data.type === 'success') {
                showSuccess(data.result || 'Maintenance cleared. Alerts have resumed.', 'Cleared');
                setTimeout(function () { location.reload(); }, 800);
            } else {
                showError((data && data.result) || 'Server rejected the request.', 'Clear Failed');
            }
        },
        error: function () { $("#loader").hide(); showError('Network error. Please try again.', 'Error'); }
    });
}
</script>


