            '#fbBody::-webkit-scrollbar-thumb{background:rgba(34,211,238,.18);border-radius:2px;}' +
            '@@media(max-width:600px){#fbPanel{width:100%;right:-100%;}}';
        document.head.appendChild(s);

        /* Backdrop click closes panel */
        document.getElementById('fbBdrop').addEventListener('click', window.closeFbPanel);
    }

}(jQuery));

    // ── Photo Evidence helpers ──
    window._fbPhotos = []; // holds { file, dataUrl } objects

    window.fbHandlePhotos = function (input) {
        var files = Array.prototype.slice.call(input.files);
        files.forEach(function (file) {
            if (window._fbPhotos.length >= 5) {
                alert('Maximum 5 photos allowed.');
                return;
            }
            if (file.size > 5 * 1024 * 1024) {
                alert(file.name + ' exceeds 5MB limit.');
                return;
            }
            var reader = new FileReader();
            reader.onload = function (e) {
                window._fbPhotos.push({ file: file, dataUrl: e.target.result });
                fbRenderPhotoPreview();
            };
            reader.readAsDataURL(file);
        });
        // Reset input so same file can be re-added after removal
        input.value = '';
    };

    window.fbRemovePhoto = function (idx) {
        window._fbPhotos.splice(idx, 1);
        fbRenderPhotoPreview();
    };

    function fbRenderPhotoPreview() {
        var preview = document.getElementById('fbPhotoPreview');
        var count = document.getElementById('fbPhotoCount');
        if (!preview) return;
        preview.innerHTML = '';
        window._fbPhotos.forEach(function (p, i) {
            var isImage = p.file.type.indexOf('image') === 0;
            var thumb = document.createElement('div');
            thumb.className = 'fb-photo-thumb';
            thumb.innerHTML = isImage
                ? '<img src="' + p.dataUrl + '" alt="photo-' + i + '" />'
                : '<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:rgba(139,92,246,.15);color:#a78bfa;font-size:10px;font-weight:700;text-align:center;padding:4px;">PDF</div>';
            var btn = document.createElement('button');
            btn.className = 'fb-photo-remove';
            btn.innerHTML = '&#x2715;';
            btn.setAttribute('type', 'button');
            btn.onclick = (function (idx) {
                return function (e) { e.stopPropagation(); fbRemovePhoto(idx); };
            }(i));
            thumb.appendChild(btn);
            preview.appendChild(thumb);
        });
        if (count) {
            count.textContent = window._fbPhotos.length > 0
                ? window._fbPhotos.length + ' / 5 photo(s) attached'
                : '';
        }
    }

    // Drag and drop support
    document.addEventListener('DOMContentLoaded', function () {
        fbBindPhotoDrop();
    });
    // Also bind after panel first opens (panel injected dynamically)
    var _fbDropBound = false;
    var _fbDropInterval = setInterval(function () {
        if (document.getElementById('fbPhotoZone') && !_fbDropBound) {
            fbBindPhotoDrop();
            clearInterval(_fbDropInterval);
        }
    }, 300);

    function fbBindPhotoDrop() {
        var zone = document.getElementById('fbPhotoZone');
        if (!zone || _fbDropBound) return;
        _fbDropBound = true;
        zone.addEventListener('dragover', function (e) {
            e.preventDefault();
            zone.style.borderColor = 'rgba(34,211,238,.80)';
            zone.style.background = 'rgba(34,211,238,.08)';
        });
        zone.addEventListener('dragleave', function () {
            zone.style.borderColor = 'rgba(34,211,238,.30)';
            zone.style.background = 'rgba(34,211,238,.03)';
        });
        zone.addEventListener('drop', function (e) {
            e.preventDefault();
            zone.style.borderColor = 'rgba(34,211,238,.30)';
            zone.style.background = 'rgba(34,211,238,.03)';
            var dt = e.dataTransfer;
            var files = Array.prototype.slice.call(dt.files);
            files.forEach(function (file) {
                if (window._fbPhotos.length >= 5) return;
                if (file.size > 5 * 1024 * 1024) { alert(file.name + ' exceeds 5MB.'); return; }
                var reader = new FileReader();
                reader.onload = function (ev) {
                    window._fbPhotos.push({ file: file, dataUrl: ev.target.result });
                    fbRenderPhotoPreview();
                };
                reader.readAsDataURL(file);
            });
        });
    }

</script>


