            var modal = document.getElementById(modalId);
            if (!modal) return;
            var mc = modal.querySelector('.modal-content');
            if (!mc) return;
            var dc = document.getElementById('frsDrawerContent');
            dc.innerHTML = '';
            while (mc.firstChild) dc.appendChild(mc.firstChild);
            _activeId = modalId;
            document.getElementById('frsCustomDrawer').classList.add('open');
            document.getElementById('frsDrawerBdrop').classList.add('show');
        }

        function closeDrawer() {
            document.getElementById('frsCustomDrawer').classList.remove('open');
            document.getElementById('frsDrawerBdrop').classList.remove('show');
            if (_activeId) {
                var modal = document.getElementById(_activeId);
                var mc = modal && modal.querySelector('.modal-content');
                var dc = document.getElementById('frsDrawerContent');
                if (mc && dc) while (dc.firstChild) mc.appendChild(dc.firstChild);
                _activeId = null;
            }
        }

        /* ── 4. Override $.fn.modal ──────────────────────────────── */
        var _orig = $.fn.modal;
        $.fn.modal = function (opt) {
            var id = this[0] && this[0].id;
            if (IDS.indexOf(id) !== -1) {
                if (opt === 'show') { openDrawer(id); return this; }
                if (opt === 'hide') { closeDrawer(); return this; }
                return this;
            }
            return _orig.apply(this, arguments);
        };

        /* ── 5. Close triggers ───────────────────────────────────── */
        document.getElementById('frsDrawerBdrop').addEventListener('click', closeDrawer);
        $(document).on('click', '#frsDrawerContent [data-dismiss="modal"]', function (e) {
            e.stopPropagation();
            closeDrawer();
        });

    }(jQuery));
</script>

