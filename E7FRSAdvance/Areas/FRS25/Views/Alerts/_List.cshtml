            document.getElementById('fbFullMode').style.display = 'none';
            document.getElementById('fbRemarkOnlyMode').style.display = 'block';
            document.getElementById('fbSubmitBtn').querySelector('span').textContent = 'Submit Remark';
            document.getElementById('fbRemarkOnly').value = '';
            document.getElementById('fbHdnROAlertId').value = alertId;
            document.getElementById('fbHdnROStatusId').value = statusId;
