@model Domain.FRSAlertLister
@{
    var alerts = (Model != null && Model.mFRSAlerts != null) ? Model.mFRSAlerts : new List<Domain.FRSAlert>();
    var totalCount = (Model != null && Model.Pager != null) ? Model.Pager.TotalRecord : 0;
    var pageSize = (Model != null && Model.Pager != null && Model.Pager.PageSize > 0) ? Model.Pager.PageSize : 10;
    var skip = (Model != null && Model.Pager != null) ? Model.Pager.Skip : 0;
    var currentPage = (skip / pageSize) + 1;
    var totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
    var fromRec = totalCount > 0 ? skip + 1 : 0;
    var toRec = Math.Min(skip + pageSize, totalCount);
    int winSize = 5;
    int startPg = Math.Max(1, currentPage - winSize / 2);
    int endPg = Math.Min(totalPages, startPg + winSize - 1);
    if (endPg - startPg < winSize - 1) { startPg = Math.Max(1, endPg - winSize + 1); }
}

@if (!alerts.Any())
{
    <div style="text-align:center;padding:48px;color:#94a3b8;">
        <i class="fas fa-bell-slash" style="font-size:32px;margin-bottom:12px;display:block;opacity:.35;"></i>
        No active alerts found for the selected filters.
    </div>
}
else
{
    <div class="alrt-table-wrap">
        <table class="alrt-table">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Asset / Cause</th>
                    <th>Incidence Time</th>
                    <th>Duration</th>
                    <th>Status</th>
                    <th>Feedback</th>
                    <th>Maintainer</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in alerts)
                {
                    var alertTypeStr = a.AlertType ?? "";
                    var typeLbl = !string.IsNullOrEmpty(alertTypeStr)
                                    ? alertTypeStr
                                    : a.AlertTypeId == 1 ? "Predictive"
                                    : a.AlertTypeId == 2 ? "Failure"
                                    : "Unknown";
                    var alertTypeLow = typeLbl.ToLower();
                    var typeCss = a.AlertTypeId == 1 ? "predictive"
                                : a.AlertTypeId == 2 ? "failure"
                                : "unknown";
                    var typeIco = alertTypeLow.Contains("predict") ? "chart-line" : alertTypeLow.Contains("health") ? "heartbeat" : "exclamation-circle";

                    var isCleared = a.ResetTimeStamp.HasValue;
                    var stLbl = isCleared ? "Cleared" : "Active";
                    var stCss = isCleared ? "cleared" : "pending";
                    var stIco = isCleared ? "check-circle" : "clock";

                    var endTime = a.ResetTimeStamp.HasValue ? a.ResetTimeStamp.Value : DateTime.Now;
                    var diff = endTime - a.SetTimeStamp;
                    if (diff.TotalSeconds < 0) { diff = TimeSpan.Zero; }
                    var totalHrs = (int)diff.TotalHours;
                    var dur = string.Format("{0:D2}:{1:D2}:{2:D2}", totalHrs, diff.Minutes, diff.Seconds);
                    var durSecs = diff.TotalSeconds;
                    var dCss = durSecs > 10800 ? "critical" : durSecs > 3600 ? "warning" : "ok";
                    var isUrgent = !isCleared && durSecs > 10800;

                    var fb = a.TempRemark ?? "";
                    var fbUp = fb.Trim().ToUpper();
                    var fbCss = (fbUp == "T") ? "fb-true" : (fbUp == "PT") ? "fb-partial" : (fbUp == "F") ? "fb-false" : (fbUp == "M") ? "fb-maint" : "fb-none";
                    var fbLbl = string.IsNullOrEmpty(fb) ? "—" : fb;

                    var assetName = a.AssetName ?? "";
                    var assetType = a.AssetType ?? "";
                    var assetDisp = string.IsNullOrEmpty(assetType) ? assetName : assetName + " (" + assetType + ")";
                    var cause = !string.IsNullOrEmpty(a.CauseCode) ? a.CauseCode : (a.PossibleCause ?? "");
                    var station = !string.IsNullOrEmpty(a.StationCode) ? a.StationCode : (a.SiteName ?? "");

                    var mName = a.MaintainerName ?? "";
                    var mDesig = a.MaintainerDesignation ?? "";
                    var mMob = a.MaintainerMobileNumber ?? "";
                    var mParts = mName.Trim().Split(new char[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                    var mIni = mParts.Length == 0 ? "?" : mParts.Length == 1
                                    ? mParts[0][0].ToString().ToUpper()
                                    : mParts[0][0].ToString().ToUpper() + mParts[1][0].ToString().ToUpper();

                    var incTime = a.SetTimeStamp.ToString("dd/MM/yyyy HH:mm:ss");
                    var isLocked = !string.IsNullOrEmpty(fb);

                    <tr class>

                        @* TYPE *@
                        <td>
                            <span class="alrt-type-badge @typeCss">
                                <i class="fas fa-@typeIco"></i>&nbsp;@typeLbl
                            </span>
                        </td>

                        @* ASSET / CAUSE *@
                        <td>
                            <div class="alrt-asset-info">
                                <span class="alrt-asset-name">@assetDisp</span>
                                <span class="alrt-asset-loc">
                                    <i class="fas fa-map-marker-alt"></i>&nbsp;@station
                                    @if (!string.IsNullOrEmpty(a.DivisionName))
                                    {
                                        <text>&nbsp;&bull;&nbsp;@a.DivisionName</text>
                                    }
                                    @if (!string.IsNullOrEmpty(a.ZoneName))
                                    {
                                        <text>&nbsp;&bull;&nbsp;@a.ZoneName</text>
                                    }
                                </span>
                                @if (!string.IsNullOrEmpty(cause))
                                {
                                    <span class="alrt-cause-code">
                                        <a href="javascript:void(0)" onclick="fnShowAlertMessage('@a.Id')" style="color:inherit;text-decoration:underline dotted;">@cause</a>
                                    </span>
                                }
                                <span id="spnAlertmsg@(a.Id)" style="display:none">@a.SetAlertMessage</span>
                                <span id="spnAlertDescription@(a.Id)" style="display:none">@Html.Raw(a.Description)</span>
                                <span id="spnResetAlertmsg@(a.Id)" style="display:none">@Html.Raw(a.ResetAlertMessage)</span>
                            </div>
                        </td>

                        @* INCIDENCE TIME *@
                        <td>
                            <div class="alrt-time-cell">
                                <span class="alrt-time-main">@incTime</span>
                                @if (a.ResetTimeStamp.HasValue)
                                {
                                    <span class="alrt-time-rel" style="color:var(--done);">
                                        Reset: @a.ResetTimeStamp.Value.ToString("HH:mm:ss")
                                    </span>
                                }
                            </div>
                        </td>

                        @* DURATION *@
                        <td>
                            <span class="alrt-dur @dCss">@dur</span>
                        </td>

                        @* STATUS *@
                        <td>
                            <span class="alrt-status @stCss">
                                <i class="fas fa-@stIco"></i>&nbsp;@stLbl
                            </span>
                        </td>
                        @* FEEDBACK *@
                        <td>
                            @{
                                bool isDisable = false;
                                bool isShowbtn = true;

                                var mAppConfigs = ViewBag.AppConfigs as List<Domain.AppConfig> ?? new List<Domain.AppConfig>();
                                var mFRSAlertRemarks = ViewBag.FRSAlertRemarks as List<Domain.FRSAlertRemark> ?? new List<Domain.FRSAlertRemark>();

                                if (E7FRSAdvance.Utility.ClsHttpContent.LoginUser.RoleId ==
                                    E7FRSAdvance.Utility.Utility.Role.User.GetHashCode())
                                {
                                    var userClassId = E7FRSAdvance.Utility.ClsHttpContent.LoginUser.UserClassId;

                                    bool isEligible =
                                        userClassId == E7FRSAdvance.Utility.Utility.UserClass.ENERGY7CONTROL.GetHashCode()
                                     || userClassId == E7FRSAdvance.Utility.Utility.UserClass.ESM.GetHashCode()
                                     || userClassId == E7FRSAdvance.Utility.Utility.UserClass.JE.GetHashCode()
                                     || userClassId == E7FRSAdvance.Utility.Utility.UserClass.SSECSI.GetHashCode();

                                    if (isEligible)
                                    {
                                        // Check AppConfig time window
                                        if (mAppConfigs.Any())
                                        {
                                            var mAppConfig = mAppConfigs.FirstOrDefault(x =>
                                                x.ZoneId == a.ZoneId &&
                                                x.AssetTypeId == a.AssetTypeId &&
                                                x.UserClassId == userClassId &&
                                                x.AlertInfoId == a.AlertTypeId);

                                            if (mAppConfig != null && mAppConfig.Id > 0)
                                            {
                                                try
                                                {
                                                    var ackSetTimeStamp = a.SetTimeStamp.AddHours(Convert.ToInt32(mAppConfig.AppValue));
                                                    if (ackSetTimeStamp < DateTime.Now) { isShowbtn = false; }
                                                }
                                                catch { isShowbtn = false; }
                                            }
                                        }

                                        // Already submitted by this user class
                                        if (mFRSAlertRemarks.Any(x => x.FRSAlertId == a.Id && x.MaintainerId == userClassId))
                                        {
                                            isShowbtn = false;
                                        }

                                        // Determine role action
                                        if (isShowbtn)
                                        {
                                            if (userClassId != E7FRSAdvance.Utility.Utility.UserClass.ENERGY7CONTROL.GetHashCode())
                                            {
                                                isDisable = true;   // ESM / JE / SSECSI → show pill row
                                            }
                                        }
                                    }
                                }

                                // ── Resolve badge state from AcknowledgemenStatusId ──
                                var displayStatusId = a.AcknowledgemenStatusId;
                                string displayFbText = "";
                                string displayFbClass = "fb-none";

                                if (displayStatusId == E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.True.GetHashCode())
                                { displayFbText = "T"; displayFbClass = "fb-true"; }
                                else if (displayStatusId == E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT.GetHashCode())
                                { displayFbText = "PT"; displayFbClass = "fb-partial"; }
                                else if (displayStatusId == E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False.GetHashCode())
                                { displayFbText = "F"; displayFbClass = "fb-false"; }
                                else if (displayStatusId == E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.Maintenace.GetHashCode())
                                { displayFbText = "M"; displayFbClass = "fb-maint"; }

                                bool hasFeedback = !string.IsNullOrEmpty(displayFbText);
                                bool hasRemark = !string.IsNullOrEmpty(a.Remark);
                            }

                            <div class="fb-cell">

                                @* ── 1. Primary feedback badge ── *@
                                @if (hasFeedback)
                                {
                                    if (hasRemark)
                                    {
                                        @* Has extra remarks → dot indicator + hover tooltip + click to view all *@
                                        <span class="fb-badge @displayFbClass has-more"
                                              onclick="fnShowRemark('@a.Id')">
                                            @displayFbText
                                            <span class="fb-dot"></span>
                                        </span>
                                    }
                                    else
                                    {
                                        @* Single feedback, no further remarks → static badge *@
                                        <span class="fb-badge @displayFbClass">
                                            @displayFbText
                                        </span>
                                    }
                                }
                                else
                                {
                                    @* No feedback submitted yet → dashed dash badge *@
                                    <span class="fb-badge fb-none">—</span>
                                }

                                @* ── 2. Add Remark link — ENERGY7CONTROL only, when ESM/JE gave PT or F ── *@
                                @if (isShowbtn && !isDisable)
                                {
                                    var ctrlId = E7FRSAdvance.Utility.ClsHttpContent.LoginUser.UserClassId;

                                    if (ctrlId == E7FRSAdvance.Utility.Utility.UserClass.ENERGY7CONTROL.GetHashCode())
                                    {
                                        var esmRemark = mFRSAlertRemarks.FirstOrDefault(x =>
                                            x.FRSAlertId == a.Id &&
                                            (x.MaintainerId == E7FRSAdvance.Utility.Utility.UserClass.ESM.GetHashCode()
                                          || x.MaintainerId == E7FRSAdvance.Utility.Utility.UserClass.JE.GetHashCode()
                                          || x.MaintainerId == E7FRSAdvance.Utility.Utility.UserClass.SSECSI.GetHashCode()));

                                        if (esmRemark != null &&
                                           (esmRemark.AcknowledgementStatusId == E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.PT.GetHashCode()
                                         || esmRemark.AcknowledgementStatusId == E7FRSAdvance.Utility.Utility.AcknowledgemenStatus.False.GetHashCode()))
                                        {
                                            <span class="fb-add-remark"
                                                  onclick="openFeedbackSlidePanel('@a.Id','remarkOnly','@esmRemark.AcknowledgementStatusId','@Html.AttributeEncode(assetDisp)','@Html.AttributeEncode(station)','@Html.AttributeEncode(cause)','@Html.AttributeEncode(incTime)','@Html.AttributeEncode(dur)','@Html.AttributeEncode(typeLbl)','@Html.AttributeEncode(a.DivisionName)','@Html.AttributeEncode(a.ZoneName)')">
                                                + Remark
                                            </span>
                                        }
                                    }
                                }

                                @* ── 3. Pill row — ESM / JE / SSECSI (field users who can still submit) ── *@
                                

                            </div>
                        </td>
                        @* FEEDBACK *@
