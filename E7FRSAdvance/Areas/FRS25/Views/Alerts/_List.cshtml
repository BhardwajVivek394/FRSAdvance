    window.submitFbPanel = async function () {
        const skip = window._alertCurrentSkip || 0;
        const isFullMode = document.getElementById('fbFullMode').style.display !== 'none';
        let payload;

        if (isFullMode) {
            const remark = document.getElementById('fbRemark').value.trim();
            const statusId = document.getElementById('fbHdnStatusId').value;
            if (!remark) { alert('Remark is required.'); return; }
            if (!statusId) { alert('Please select a feedback type.'); return; }

            payload = {
                Id: document.getElementById('fbHdnAlertId').value,
                Remark: remark,
                AcknowledgemenStatusId: statusId,
                PhotoEvidenceBase64: null
            };

            const rectVal = document.getElementById('fbRectDate').value;
            if (rectVal) {
                const rd = new Date(rectVal);
                if (rd > new Date()) { alert('Future date & time is not allowed.'); return; }
                payload.RectificationDateTime = rd.toISOString();
            }

            if (statusId === ptId) {
                payload.PTAlertInfoId = document.getElementById('fbDrpCause').value;
                if (!payload.PTAlertInfoId) { alert('Cause Code is required.'); return; }
            }
        } else {
            const remark = document.getElementById('fbRemarkOnly').value.trim();
            if (!remark) { alert('Remark is required.'); return; }
            payload = {
                Id: document.getElementById('fbHdnROAlertId').value,
                Remark: remark,
                AcknowledgemenStatusId: document.getElementById('fbHdnROStatusId').value,
                PhotoEvidenceBase64: null
            };
        }

        // ── Convert photos to base64 (if any) ──
        if (window._fbPhotos && window._fbPhotos.length > 0) {
            try {
                const base64List = await Promise.all(window._fbPhotos.map(p => fileToBase64(p.file)));
                // Send as comma-separated base64 strings, or as JSON array – match your backend expectation
                payload.PhotoEvidenceBase64 = base64List.join(','); // adjust separator as needed
            } catch (err) {
                alert('Failed to encode images: ' + err.message);
                return;
            }
        }

        // ── Single AJAX call to UpdateRemark ──
        $("#loader").show();
        $.ajax({
            url: '/FRS25/Alerts/UpdateRemark',
            type: 'POST',
            contentType: 'application/json',
            dataType: 'json',
            data: JSON.stringify(payload),
            success: function (data) {
                $("#loader").hide();
                window.closeFbPanel();
                if (typeof fnGetAlertDetailReport === 'function') fnGetAlertDetailReport(skip);
                else location.reload();
                if (data != null) {
                    if (data.type === 'success') CommonNotification("SUCCESS", data.result || '', "success");
                    else if (data.type === 'error') CommonNotification("ERROR", data.result || '', "error");
                }
            },
            error: function () {
                $("#loader").hide();
                window.closeFbPanel();
                alert("Something went wrong!");
            }
        });
    };

