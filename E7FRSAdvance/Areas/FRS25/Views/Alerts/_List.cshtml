    @* PAGINATION *@
    <div class="alrt-table-footer">
        <div class="alrt-table-info">
            Showing <strong>@fromRec</strong>&ndash;<strong>@toRec</strong>
            of <strong>@Convert.ToInt32(totalCount)</strong> alerts
        </div>
        <div class="alrt-pagination">
            @if (currentPage > 1)
            {
                <button class="alrt-page-btn" onclick="alrtGoPage(@(currentPage - 1))">
                    <i class="fas fa-chevron-left"></i>
                </button>
            }
            else
            {
                <button class="alrt-page-btn disabled" disabled="disabled">
                    <i class="fas fa-chevron-left"></i>
                </button>
            }

            @if (startPg > 1)
            {
                <button class="alrt-page-btn" onclick="alrtGoPage(1)">1</button>
                if (startPg > 2)
                {
                    <span style="padding:0 4px;line-height:28px;color:var(--text-muted);">...</span>
                }
            }

            @for (int pg = startPg; pg <= endPg; pg++)
            {
                <button class="alrt-page-btn @(pg == currentPage ? "active" : "")"
                        onclick="alrtGoPage(@pg)">
                    @pg
                </button>
            }

            @if (endPg < totalPages)
            {
                if (endPg < totalPages - 1)
                {
                    <span style="padding:0 4px;line-height:28px;color:var(--text-muted);">...</span>
                }
                <button class="alrt-page-btn" onclick="alrtGoPage(@totalPages)">@totalPages</button>
            }

            @if (currentPage < totalPages)
            {
                <button class="alrt-page-btn" onclick="alrtGoPage(@(currentPage + 1))">
                    <i class="fas fa-chevron-right"></i>
                </button>
            }
            else
            {
                <button class="alrt-page-btn disabled" disabled="disabled">
                    <i class="fas fa-chevron-right"></i>
                </button>
            }
        </div>
    </div>
}

@* ── ANALYSIS ROW DATA ── *@
<script>
    window._alrtAnalysisRows = {};
@foreach (var dbgA in alerts)
{
    var dbgTypeLbl = !string.IsNullOrEmpty(dbgA.AlertType) ? dbgA.AlertType
                   : dbgA.AlertTypeId == 1 ? "Predictive"
                   : dbgA.AlertTypeId == 2 ? "Failure" : "Unknown";

    string dbgRectDate = "-";
    if (dbgA.ResetTimeStamp.HasValue)
    {
        dbgRectDate = dbgA.ResetTimeStamp.Value.ToString("dd/MM/yyyy HH:mm:ss");
    }

    var dbgEndTime = dbgA.ResetTimeStamp.HasValue ? dbgA.ResetTimeStamp.Value : DateTime.Now;
    var dbgDiff    = dbgEndTime - dbgA.SetTimeStamp;
    if (dbgDiff.TotalSeconds < 0) { dbgDiff = TimeSpan.Zero; }
    var dbgDurStr  = string.Format("{0:D2}:{1:D2}:{2:D2}", (int)dbgDiff.TotalHours, dbgDiff.Minutes, dbgDiff.Seconds);
    var dbgStation = !string.IsNullOrEmpty(dbgA.StationCode) ? dbgA.StationCode : (dbgA.SiteName ?? "");
    var dbgCause   = !string.IsNullOrEmpty(dbgA.CauseCode)   ? dbgA.CauseCode   : (dbgA.PossibleCause ?? "");

    <text>
_alrtAnalysisRows[@dbgA.Id] = {
    id:          @dbgA.Id,
    assetId:     @(dbgA.AssetId),
