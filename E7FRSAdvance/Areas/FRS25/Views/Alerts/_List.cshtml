        if (isFullMode) {
            var remark   = document.getElementById('fbRemark').value.trim();
            var statusId = document.getElementById('fbHdnStatusId').value;
            if (!remark)   { alert('Remark is required.'); return; }
            if (!statusId) { alert('Please select a feedback type.'); return; }

            var payload = {
                Id: document.getElementById('fbHdnAlertId').value,
                Remark: remark,
