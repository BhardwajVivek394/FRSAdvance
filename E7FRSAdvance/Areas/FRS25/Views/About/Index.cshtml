@model Domain.User
@{
    ViewBag.Title = "About";
    Layout = "~/Areas/FRS25/Views/Shared/_Layout.cshtml";

    var u = Model ?? new Domain.User();
    var fullName = ((u.FirstName ?? "") + " " + (u.LastName ?? "")).Trim();
    var hasName = !string.IsNullOrWhiteSpace(fullName);
    var initials = hasName
        ? string.Concat(fullName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])))
        : "";
    var hasDesignation = !string.IsNullOrWhiteSpace(u.Designation);
    var hasRole = !string.IsNullOrWhiteSpace(u.RoleName);
    var hasPhone = !string.IsNullOrWhiteSpace(u.PhoneNumber);
    var hasEmail = !string.IsNullOrWhiteSpace(u.EmailAddress);
    var hasUserName = !string.IsNullOrWhiteSpace(u.UserName);
    var hasJoined = u.CreatedDate > new DateTime(1900, 1, 1);
    var subtitle = string.Join(" • ", new[] { hasDesignation ? u.Designation : null, hasRole ? u.RoleName : null }.Where(s => s != null));
    var hasAnyDetail = hasName || hasPhone || hasEmail || hasDesignation || hasRole || hasJoined || hasUserName;
    var loadError = (ViewBag.Type as string) == "Error";
}

<style>
    .about-page .about-card {
        background: var(--e7-surface, #fff);
        border: 1px solid var(--e7-border, #e2e8f0);
        border-radius: 12px;
        color: var(--e7-text, #0f172a);
    }

    .about-page .about-avatar {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        margin: 0 auto 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 700;
        background: var(--e7-surface-2, #f1f5f9);
        border: 1px solid var(--e7-border, #e2e8f0);
        color: var(--e7-accent, #1a56db);
    }

    .about-page .about-name {
        font-size: 1.35rem;
        font-weight: 700;
        margin: 0 0 4px;
        color: var(--e7-heading, var(--e7-text, #0f172a));
    }

    .about-page .about-sub {
        margin: 0;
        color: var(--e7-text-2, #475569);
    }

    .about-page .about-title {
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 18px;
        color: var(--e7-heading, var(--e7-text, #0f172a));
    }

    .about-page .about-field-label {
        display: block;
        font-weight: 600;
        font-size: .85rem;
        color: var(--e7-text, #0f172a);
    }

        .about-page .about-field-label i {
            width: 18px;
            margin-right: 6px;
            color: var(--e7-text-3, #94a3b8);
        }

    .about-page .about-field-value {
        color: var(--e7-text-2, #475569);
        word-break: break-word;
    }

    .about-page .about-empty {
        color: var(--e7-text-3, #94a3b8);
        margin: 0;
    }

    .about-page .about-alert {
        border-radius: 10px;
        padding: 12px 16px;
        margin-bottom: 16px;
        background: var(--e7-surface-2, #fef2f2);
        border: 1px solid var(--e7-border, #fecaca);
        color: var(--e7-text, #7f1d1d);
    }

        .about-page .about-alert i {
            color: #dc2626;
            margin-right: 8px;
        }
</style>

<section class="section about-page">

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body p-0">
                    <div class="row">
                        <div class="col-12 col-sm-5">
                            <nav aria-label="breadcrumb">
                                <ol class="breadcrumb">
                                    <li class="breadcrumb-item active" aria-current="page"><a href="#">About</a></li>
                                </ol>
                            </nav>
                        </div>
                        <div class="col-12 col-sm-7 d-flex flex-sm-row-reverse align-items-center">
                            <h2 class="page-name">About</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (loadError)
    {
        <div class="about-alert" role="alert">
            <i class="fas fa-triangle-exclamation" aria-hidden="true"></i>
            Couldn't load your profile details. @(ViewBag.Message as string)
        </div>
    }

    <div class="row">
        <!-- Identity -->
        <div class="col-lg-4">
            <div class="about-card mb-4">
                <div class="p-5 text-center">
                    <div class="about-avatar" aria-hidden="true">
                        @if (hasName)
                        {
                            @initials
                        }
                        else
                        {
                            <i class="fas fa-user"></i>
                        }
                    </div>
                    <h2 class="about-name">@(hasName ? fullName : "Your profile")</h2>
                    @if (!string.IsNullOrEmpty(subtitle))
                    {
                        <p class="about-sub">@subtitle</p>
                    }
                </div>
            </div>
        </div>

        <!-- Details -->
        <div class="col-lg-8">
            <div class="about-card mb-4">
                <div class="p-4">
                    <h5 class="about-title"><i class="fa-solid fa-address-card me-2"></i> Profile details</h5>

                    @if (!hasAnyDetail)
                    {
                        <p class="about-empty">No profile details are available for your account.</p>
                    }
                    else
                    {
                        <div class="row">
                            @if (hasName)
                            {
                                <div class="col-md-6 mb-3">
                                    <span class="about-field-label"><i class="fas fa-user"></i>Full Name</span>
                                    <span class="about-field-value">@fullName</span>
                                </div>
                            }
                            @if (hasUserName)
                            {
                                <div class="col-md-6 mb-3">
                                    <span class="about-field-label"><i class="fas fa-id-badge"></i>Username</span>
                                    <span class="about-field-value">@u.UserName</span>
                                </div>
                            }
                            @if (hasPhone)
                            {
                                <div class="col-md-6 mb-3">
                                    <span class="about-field-label"><i class="fa-solid fa-phone"></i>Phone Number</span>
                                    <span class="about-field-value">@u.PhoneNumber</span>
                                </div>
                            }
                            @if (hasEmail)
                            {
                                <div class="col-md-6 mb-3">
                                    <span class="about-field-label"><i class="fa-solid fa-envelope"></i>Email Address</span>
                                    <span class="about-field-value">@u.EmailAddress</span>
                                </div>
                            }
                            @if (hasDesignation)
                            {
                                <div class="col-md-6 mb-3">
                                    <span class="about-field-label"><i class="fas fa-briefcase"></i>Designation</span>
                                    <span class="about-field-value">@u.Designation</span>
                                </div>
                            }
                            @if (hasRole)
                            {
                                <div class="col-md-6 mb-3">
                                    <span class="about-field-label"><i class="fas fa-user-shield"></i>Role</span>
                                    <span class="about-field-value">@u.RoleName</span>
                                </div>
                            }
                            @if (hasJoined)
                            {
                                <div class="col-md-6 mb-3">
                                    <span class="about-field-label"><i class="fas fa-calendar"></i>Joined</span>
                                    <span class="about-field-value">@u.CreatedDate.ToString("MMMM yyyy")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

</section>
